        ],
        "dialogs": {
          "765010101": {
            "id": "765010101",
            "speakerId": 1000,
            "speakerName": "菈乌玛",
            "text": "#是你们啊，{NICKNAME}和派蒙。林间的飞鸟刚刚就在谈论你们的到来。今日前来，可是有什么要事，或是…需要我稍作指引？",

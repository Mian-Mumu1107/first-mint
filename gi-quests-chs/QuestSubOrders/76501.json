              "765010104"
            ]
          },
          "765010104": {
            "id": "765010104",
            "speakerId": 1000,
            "speakerName": "菈乌玛",
            "text": "这里深受月华浸润，无论是植被还是栖息于此的生灵，都与外界不尽相同。",
            "nextDialogs": [
              "765010105"
            ]
          },
          "765010105": {
            "id": "765010105",
            "speakerId": 1000,
            "speakerName": "菈乌玛",
            "text": "的确是个能留下许多珍贵画片的地方。",
            "nextDialogs": [
              "765010106"
            ]
          },
          "765010106": {
            "id": "765010106",
            "speakerId": 1000,
            "speakerName": "菈乌玛",
            "text": "二位请随意徜徉，若有任何好奇之处，随时可以问我，我会尽我所能解答。"
          }
        }
      }
    },

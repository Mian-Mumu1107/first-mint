    {
      "subId": "102101",
      "subQuestName": "寻找派蒙想要的材料",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "10210201"
        ],
        "dialogs": {
          "10210201": {
            "id": "10210201",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "嗯？空气里有强烈的甜香味…",
            "nextDialogs": [
              "10210202"
            ]
          },
          "10210202": {
            "id": "10210202",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "而且…你有没有听到什么声音？",
            "nextDialogs": [
              "10210204",
              "10210206"
            ]
          },
          "10210204": {
            "id": "10210204",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "听起来，是从那个遗迹里发出的声音…",
            "nextDialogs": [
              "10210207"
            ]
          },
          "10210207": {
            "id": "10210207",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "…啊，是那些盗宝团把什么人关起来了吗？"
          },
          "10210206": {
            "id": "10210206",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "不对，是呼救声！是从那个遗迹里发出来的…"
          }
        }
      }
    },

    {
      "subId": "7614203",
      "subQuestName": "(test)废弃",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "761420301"
        ],
        "dialogs": {
          "761420301": {
            "id": "761420301",
            "speakerId": 1000,
            "speakerName": "？？？",
            "text": "嘿，契诺夫，你还好吧。",
            "nextDialogs": [
              "761420302"
            ]
          },
          "761420302": {
            "id": "761420302",
            "speakerId": 1001,
            "speakerName": "契诺夫",
            "text": "还拿得动刀…队长。",
            "nextDialogs": [
              "761420303"
            ]
          },
          "761420303": {
            "id": "761420303",
            "speakerId": 1000,
            "speakerName": "？？？",
            "text": "肖诺科维奇…菲拉耶夫…你们没事吧。",
            "nextDialogs": [
              "761420304"
            ]
          },
          "761420304": {
            "id": "761420304",
            "speakerId": 1002,
            "speakerName": "肖诺科维奇",
            "text": "呃啊…我的腿好像断了，万幸我还活着，你计数了吗？我杀了几个了？",
            "nextDialogs": [
              "761420305"
            ]
          },
          "761420305": {
            "id": "761420305",
            "speakerId": 1003,
            "speakerName": "菲拉耶夫",
            "text": "到…到底有多少魔物啊，我们…我们不会要死在这里了吧，队长。",
            "nextDialogs": [
              "761420306"
            ]
          },
          "761420306": {
            "id": "761420306",
            "speakerId": 1000,
            "speakerName": "？？？",
            "text": "你个混小子在说啥呢？我们肯定能安全出去的！别担心，斥候肯定已经回城告诉老爷子了，我们的增援已经在路上了！",
            "nextDialogs": [
              "761420307"
            ]
          },
          "761420307": {
            "id": "761420307",
            "speakerId": 1000,
            "speakerName": "？？？",
            "text": "又来了，这群狂猎真是没完没了。",
            "nextDialogs": [
              "761420308"
            ]
          },
          "761420308": {
            "id": "761420308",
            "speakerId": 1000,
            "speakerName": "？？？",
            "text": "嘿！拿好你们的武器和灯，我们还有一场硬仗要打呢。"
          }
        }
      }
    },

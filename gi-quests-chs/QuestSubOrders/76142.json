    {
      "subId": "7614211",
      "subQuestName": "继续向前探索",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "761420401"
        ],
        "dialogs": {
          "761420401": {
            "id": "761420401",
            "speakerId": 1000,
            "speakerName": "？？？",
            "text": "菲拉耶夫，别怕，我和帕托利会带你一起出去的。精神点，像个合格的执灯人一样，把剑拿稳了！",
            "nextDialogs": [
              "761420402"
            ]
          },
          "761420402": {
            "id": "761420402",
            "speakerId": 1003,
            "speakerName": "菲拉耶夫",
            "text": "我…我…",
            "nextDialogs": [
              "761420403"
            ]
          },
          "761420403": {
            "id": "761420403",
            "speakerId": 1000,
            "speakerName": "？？？",
            "text": "有什么计划？能有什么计划，帕托利。如果这就是结局，那我会在这里战斗到底。",
            "nextDialogs": [
              "761420404"
            ]
          },
          "761420404": {
            "id": "761420404",
            "speakerId": 1000,
            "speakerName": "？？？",
            "text": "你们是最棒的小队，不论结果会如何，曾与你们一同并肩是我的荣幸。",
            "nextDialogs": [
              "761420405"
            ]
          },
          "761420405": {
            "id": "761420405",
            "speakerId": 1003,
            "speakerName": "菲拉耶夫",
            "text": "……",
            "nextDialogs": [
              "761420406"
            ]
          },
          "761420406": {
            "id": "761420406",
            "speakerId": 1003,
            "speakerName": "菲拉耶夫",
            "text": "这也是我们的荣幸，队长。",
            "nextDialogs": [
              "761420407"
            ]
          },
          "761420407": {
            "id": "761420407",
            "speakerId": 1000,
            "speakerName": "？？？",
            "text": "来吧，准备防守！让这群狗东西见识一下「凛风之马」的厉害！"
          }
        }
      }

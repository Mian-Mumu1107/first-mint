{
  "lineCounts": {
    "Player": 40,
    "「寝子」": 41,
    "大祐": 5,
    "悦子": 10,
    "木南杏奈": 42,
    "派蒙": 23
  },
  "subQuests": [
    {
      "subId": "7221101",
      "subQuestName": "test 与寝子对话 隐藏$HIDDEN",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "722110801"
        ],
        "dialogs": {
          "722110801": {
            "id": "722110801",
            "speakerId": 3189,
            "speakerName": "「寝子」",
            "text": "是汝啊，来得正好。正好奴家有事情要人帮忙。",
            "nextDialogs": [
              "722110802"
            ]
          },
          "722110802": {
            "id": "722110802",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "怎么了？",
            "nextDialogs": [
              "722110803"
            ]
          },
          "722110803": {
            "id": "722110803",
            "speakerId": 3189,
            "speakerName": "「寝子」",
            "text": "多亏了汝，现在神社也比以前好了。很快很快就会有很多很多人来神社了。",
            "nextDialogs": [
              "722110804"
            ]
          },
          "722110804": {
            "id": "722110804",
            "speakerId": 3189,
            "speakerName": "「寝子」",
            "text": "奴家叮嘱小家伙们，到时候可不能像现在这样，一定要在人类面前保持风度。",
            "nextDialogs": [
              "722110805"
            ]
          },
          "722110805": {
            "id": "722110805",
            "speakerId": 3189,
            "speakerName": "「寝子」",
            "text": "但它们已经疯惯了，不爱听奴家的话。",
            "nextDialogs": [
              "722110806"
            ]
          },
          "722110806": {
            "id": "722110806",
            "speakerId": 3189,
            "speakerName": "「寝子」",
            "text": "不过奴家想到了一个办法。",
            "nextDialogs": [
              "722110807"
            ]
          },
          "722110807": {
            "id": "722110807",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "办法？",
            "nextDialogs": [
              "722110808"
            ]
          },
          "722110808": {
            "id": "722110808",
            "speakerId": 3189,
            "speakerName": "「寝子」",
            "text": "奴家还很小很小的时候，也喜欢到处玩。那时候，阿响为了让奴家和别的猫乖乖听话，会做很好吃的饭。",
            "nextDialogs": [
              "722110809"
            ]
          },
          "722110809": {
            "id": "722110809",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "好、好吃的！",
            "nextDialogs": [
              "722110810"
            ]
          },
          "722110810": {
            "id": "722110810",
            "speakerId": 3189,
            "speakerName": "「寝子」",
            "text": "那时候呀，只要那锅饭一端出来，猫们马上就会从树上、屋顶上下来。就算饭好烫好烫、舌头好热好热，也忍不住。",
            "nextDialogs": [
              "722110811"
            ]
          },
          "722110811": {
            "id": "722110811",
            "speakerId": 3189,
            "speakerName": "「寝子」",
            "text": "阿响每次都会做好大一锅，分给猫和人类一起吃，来神社的人也有份。",
            "nextDialogs": [
              "722110812"
            ]
          },
          "722110812": {
            "id": "722110812",
            "speakerId": 3189,
            "speakerName": "「寝子」",
            "text": "不过，百目鬼的食量可大了，每次吃好多好多。不像奴家这样有风度。",
            "nextDialogs": [
              "722110815"
            ]
          },
          "722110815": {
            "id": "722110815",
            "speakerId": 3189,
            "speakerName": "「寝子」",
            "text": "不错，很有悟性嘛。奴家要请汝等做饭。",
            "nextDialogs": [
              "722110816"
            ]
          },
          "722110816": {
            "id": "722110816",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "我不是怀疑寝子的智慧…",
            "nextDialogs": [
              "722110817"
            ]
          },
          "722110817": {
            "id": "722110817",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "不过寝子真的知道饭要怎么做吗？",
            "nextDialogs": [
              "722110818"
            ]
          },
          "722110818": {
            "id": "722110818",
            "speakerId": 3189,
            "speakerName": "「寝子」",
            "text": "喵喵？",
            "nextDialogs": [
              "722110819"
            ]
          },
          "722110819": {
            "id": "722110819",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "……",
            "nextDialogs": [
              "722110820"
            ]
          },
          "722110820": {
            "id": "722110820",
            "speakerId": 3189,
            "speakerName": "「寝子」",
            "text": "这、这种东西，就交给汝等想办法了！难道什么都要奴家自己做吗？",
            "nextDialogs": [
              "722110821"
            ]
          },
          "722110821": {
            "id": "722110821",
            "speakerId": 3189,
            "speakerName": "「寝子」",
            "text": "哎呀，不过那个饭，真是太好吃了哪。那个味道，就算走了好远好远、过了好久好久，都可以闻到…",
            "nextDialogs": [
              "722110822"
            ]
          },
          "722110822": {
            "id": "722110822",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "#{NICKNAME}，我觉得我们还是应该努力一下！毕竟，为了神社嘛！"
          }
        }
      }
    },
    {
      "subId": "7221102",
      "subQuestName": "与大祐和悦子对话",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "722110101"
        ],
        "dialogs": {
          "722110101": {
            "id": "722110101",
            "speakerId": 3181,
            "speakerName": "大祐",
            "text": "悦子小姐，我们接着去哪里探索？",
            "nextDialogs": [
              "722110102"
            ]
          },
          "722110102": {
            "id": "722110102",
            "speakerId": 3180,
            "speakerName": "悦子",
            "text": "呼…先歇一歇吧…",
            "nextDialogs": [
              "722110103"
            ]
          },
          "722110103": {
            "id": "722110103",
            "speakerId": 3180,
            "speakerName": "悦子",
            "text": "嗯？是你们啊，你们找我们有事吗？",
            "nextDialogs": [
              "722110104"
            ]
          },
          "722110104": {
            "id": "722110104",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "关于可靠的厨师…",
            "nextDialogs": [
              "722110105"
            ]
          },
          "722110105": {
            "id": "722110105",
            "speakerId": 3181,
            "speakerName": "大祐",
            "text": "在清籁岛的地方找厨师？",
            "nextDialogs": [
              "722110106"
            ]
          },
          "722110106": {
            "id": "722110106",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "事情是这样的。寝子她…",
            "nextDialogs": [
              "722110107"
            ]
          },
          "722110107": {
            "id": "722110107",
            "speakerId": 3181,
            "speakerName": "大祐",
            "text": "你说…寝子大人拜托你们帮忙准备食物吗？",
            "nextDialogs": [
              "722110108"
            ]
          },
          "722110108": {
            "id": "722110108",
            "speakerId": 3181,
            "speakerName": "大祐",
            "text": "啊…可恶！要是我有烹饪的才能就好了！",
            "nextDialogs": [
              "722110109"
            ]
          },
          "722110109": {
            "id": "722110109",
            "speakerId": 3180,
            "speakerName": "悦子",
            "text": "这么说，你们是想要找一个能帮你们搞明白…「怎么用这些食材，做出猫会喜欢的饭」的厨师，对吧？",
            "nextDialogs": [
              "722110110"
            ]
          },
          "722110110": {
            "id": "722110110",
            "speakerId": 3180,
            "speakerName": "悦子",
            "text": "我想想…厨师…厨师…",
            "nextDialogs": [
              "722110111"
            ]
          },
          "722110111": {
            "id": "722110111",
            "speakerId": 3180,
            "speakerName": "悦子",
            "text": "喔，你们不如去稻妻城，去找「木南料亭」的木南杏奈小姐吧。",
            "nextDialogs": [
              "722110112"
            ]
          },
          "722110112": {
            "id": "722110112",
            "speakerId": 3180,
            "speakerName": "悦子",
            "text": "木南小姐人很好，厨艺也很不错，应该能帮你们这个忙。",
            "nextDialogs": [
              "722110113"
            ]
          },
          "722110113": {
            "id": "722110113",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "谢谢，我们这就去看看。",
            "nextDialogs": [
              "722110114"
            ]
          },
          "722110114": {
            "id": "722110114",
            "speakerId": 3180,
            "speakerName": "悦子",
            "text": "不用谢，快点去吧，我和大祐还要继续制订探索计划。",
            "nextDialogs": [
              "722110115"
            ]
          },
          "722110115": {
            "id": "722110115",
            "speakerId": 3180,
            "speakerName": "悦子",
            "text": "呵呵，希望这个神社真的可以热闹起来。",
            "nextDialogs": [
              "722110116"
            ]
          },
          "722110116": {
            "id": "722110116",
            "speakerId": 3180,
            "speakerName": "悦子",
            "text": "这样，也不枉你和那位寝子忙前忙后这么长时间。"
          }
        }
      }
    },
    {
      "subId": "7221103",
      "subQuestName": "向木南杏奈请教",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "722110201"
        ],
        "dialogs": {
          "722110201": {
            "id": "722110201",
            "speakerId": 3044,
            "speakerName": "木南杏奈",
            "text": "你好，欢迎光临「木南料亭」，请问你们有什么需要的吗？",
            "nextDialogs": [
              "722110203"
            ]
          },
          "722110203": {
            "id": "722110203",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "关于寝子的饭…",
            "nextDialogs": [
              "722110204"
            ]
          },
          "722110204": {
            "id": "722110204",
            "speakerId": 3044,
            "speakerName": "木南杏奈",
            "text": "「寝子」？这个名字，难不成是猫吗？",
            "nextDialogs": [
              "722110205"
            ]
          },
          "722110205": {
            "id": "722110205",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "你认识寝子吗？",
            "nextDialogs": [
              "722110206"
            ]
          },
          "722110206": {
            "id": "722110206",
            "speakerId": 3044,
            "speakerName": "木南杏奈",
            "text": "哎呀，不是。我只是觉得，这个名字很适合猫呢。",
            "nextDialogs": [
              "722110207"
            ]
          },
          "722110207": {
            "id": "722110207",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "真是强大的直觉…",
            "nextDialogs": [
              "722110208"
            ]
          },
          "722110208": {
            "id": "722110208",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "先不说这些，事情是这样的…",
            "nextDialogs": [
              "722110209"
            ]
          },
          "722110209": {
            "id": "722110209",
            "speakerId": 3044,
            "speakerName": "木南杏奈",
            "text": "清籁岛上…有一座浅濑神社，神社里有一只会说话的猫？！那只猫还拜托你们做一道菜给它？",
            "nextDialogs": [
              "722110210"
            ]
          },
          "722110210": {
            "id": "722110210",
            "speakerId": 3044,
            "speakerName": "木南杏奈",
            "text": "欸？欸！真的吗？我从来都没听说过！",
            "nextDialogs": [
              "722110213"
            ]
          },
          "722110213": {
            "id": "722110213",
            "speakerId": 3044,
            "speakerName": "木南杏奈",
            "text": "在清籁岛上对吧？等有机会，我一定要自己去看看…",
            "nextDialogs": [
              "722110214"
            ]
          },
          "722110214": {
            "id": "722110214",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "那个…寝子的饭…",
            "nextDialogs": [
              "722110215"
            ]
          },
          "722110215": {
            "id": "722110215",
            "speakerId": 3044,
            "speakerName": "木南杏奈",
            "text": "啊…对哦，差点忘了正事…我想想。",
            "nextDialogs": [
              "722110216"
            ]
          },
          "722110216": {
            "id": "722110216",
            "speakerId": 3044,
            "speakerName": "木南杏奈",
            "text": "唔…猫也会喜欢的饭吗…",
            "nextDialogs": [
              "722110217"
            ]
          },
          "722110217": {
            "id": "722110217",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "很难吗？",
            "nextDialogs": [
              "722110218"
            ]
          },
          "722110218": {
            "id": "722110218",
            "speakerId": 3044,
            "speakerName": "木南杏奈",
            "text": "……",
            "nextDialogs": [
              "722110219"
            ]
          },
          "722110219": {
            "id": "722110219",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "很、很难吗？",
            "nextDialogs": [
              "722110220"
            ]
          },
          "722110220": {
            "id": "722110220",
            "speakerId": 3044,
            "speakerName": "木南杏奈",
            "text": "这是对「木南」家名的挑战！我一定要克服！",
            "nextDialogs": [
              "722110221"
            ]
          },
          "722110221": {
            "id": "722110221",
            "speakerId": 3044,
            "speakerName": "木南杏奈",
            "text": "用鱼肉、兽肉、海草、稻米做出能让猫趋之若鹜的美食，就交给我吧。",
            "nextDialogs": [
              "722110222"
            ]
          },
          "722110222": {
            "id": "722110222",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "我、我也想吃！"
          }
        }
      }
    },
    {
      "subId": "7221104",
      "subQuestName": "将三份海草带给木南杏奈",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "722110401"
        ],
        "dialogs": {
          "722110401": {
            "id": "722110401",
            "speakerId": 3189,
            "speakerName": "「寝子」",
            "text": "好香…汝等，做好饭了吗？",
            "nextDialogs": [
              "722110402"
            ]
          },
          "722110402": {
            "id": "722110402",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "做好了。",
            "nextDialogs": [
              "722110403"
            ]
          },
          "722110403": {
            "id": "722110403",
            "speakerId": 3189,
            "speakerName": "「寝子」",
            "text": "喵喵！真厉害，快给奴家尝尝看。",
            "nextDialogs": [
              "722110404"
            ]
          },
          "722110404": {
            "id": "722110404",
            "speakerId": 3189,
            "speakerName": "「寝子」",
            "text": "……",
            "nextDialogs": [
              "722110405"
            ]
          },
          "722110405": {
            "id": "722110405",
            "speakerId": 3189,
            "speakerName": "「寝子」",
            "text": "看起来，和阿响做的饭有些不一样…",
            "nextDialogs": [
              "722110406"
            ]
          },
          "722110406": {
            "id": "722110406",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "应、应该很好吃的，我们先一起尝尝看吧！",
            "nextDialogs": [
              "722110407"
            ]
          },
          "722110407": {
            "id": "722110407",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "真好吃！",
            "nextDialogs": [
              "722110408"
            ]
          },
          "722110408": {
            "id": "722110408",
            "speakerId": 3189,
            "speakerName": "「寝子」",
            "text": "……喵。",
            "nextDialogs": [
              "722110409"
            ]
          },
          "722110409": {
            "id": "722110409",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "（寝子是因为饭和「阿响」做得不一样，不开心吗…）",
            "nextDialogs": [
              "722110410"
            ]
          },
          "722110410": {
            "id": "722110410",
            "speakerId": 3189,
            "speakerName": "「寝子」",
            "text": "很好吃，汝等，很可靠呢。",
            "nextDialogs": [
              "722110411"
            ]
          },
          "722110411": {
            "id": "722110411",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "那就好。",
            "nextDialogs": [
              "722110412"
            ]
          },
          "722110412": {
            "id": "722110412",
            "speakerId": 3189,
            "speakerName": "「寝子」",
            "text": "虽然，汝等做的饭，和阿响做的饭味道不一样。",
            "nextDialogs": [
              "722110413"
            ]
          },
          "722110413": {
            "id": "722110413",
            "speakerId": 3189,
            "speakerName": "「寝子」",
            "text": "但是，和汝等一起吃饭时的感觉，和之前奴家和阿响一起吃饭时的感觉，一模一样。",
            "nextDialogs": [
              "722110414"
            ]
          },
          "722110414": {
            "id": "722110414",
            "speakerId": 3189,
            "speakerName": "「寝子」",
            "text": "人类啊，这是为什么呢？汝等人类，难道会什么妖法不成？",
            "nextDialogs": [
              "722110417"
            ]
          },
          "722110417": {
            "id": "722110417",
            "speakerId": 3189,
            "speakerName": "「寝子」",
            "text": "…无论如何，谢谢汝等。好久没吃过这样好吃的饭了。",
            "nextDialogs": [
              "722110418"
            ]
          },
          "722110418": {
            "id": "722110418",
            "speakerId": 3189,
            "speakerName": "「寝子」",
            "text": "小家伙们肯定会喜欢的。汝再跑一趟，把这饭带给它们。",
            "nextDialogs": [
              "722110419"
            ]
          },
          "722110419": {
            "id": "722110419",
            "speakerId": 3189,
            "speakerName": "「寝子」",
            "text": "既然奴家喜欢，那它们肯定会喜欢。然后，吃了这么好吃的饭，一定也会愿意听奴家的了。"
          }
        }
      }
    },
    {
      "subId": "7221108",
      "subQuestName": "将三份海草带给木南杏奈",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "722110702"
        ],
        "dialogs": {
          "722110702": {
            "id": "722110702",
            "speakerId": 3044,
            "speakerName": "木南杏奈",
            "text": "太好了，你们稍等一下，我对于怎么做这道菜…已经有思路了！",
            "nextDialogs": [
              "722110703"
            ]
          },
          "722110703": {
            "id": "722110703",
            "speakerId": 3044,
            "speakerName": "木南杏奈",
            "text": "完成了！",
            "nextDialogs": [
              "722110704"
            ]
          },
          "722110704": {
            "id": "722110704",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "闻着好香啊！唔唔，好想尝尝看…",
            "nextDialogs": [
              "722110705"
            ]
          },
          "722110705": {
            "id": "722110705",
            "speakerId": 3044,
            "speakerName": "木南杏奈",
            "text": "名字就叫做…嗯…既然这道饭是给一只会说话的猫做的，那这道饭就叫做「活力喵饭」吧！",
            "nextDialogs": [
              "722110706"
            ]
          },
          "722110706": {
            "id": "722110706",
            "speakerId": 3044,
            "speakerName": "木南杏奈",
            "text": "总之，这份饭你们拿好。",
            "nextDialogs": [
              "722110707"
            ]
          },
          "722110707": {
            "id": "722110707",
            "speakerId": 3044,
            "speakerName": "木南杏奈",
            "text": "对了，食谱我也抄一份给你。",
            "nextDialogs": [
              "722110708"
            ]
          },
          "722110708": {
            "id": "722110708",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "#太好了，那{NICKNAME}也能随时给我做…做「喵饭」了！",
            "nextDialogs": [
              "722110710"
            ]
          },
          "722110710": {
            "id": "722110710",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "真没礼貌！美食是全世界共通的，是我和寝子的共同语言。",
            "nextDialogs": [
              "722110711"
            ]
          },
          "722110711": {
            "id": "722110711",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "对了！要感谢木南小姐才行。",
            "nextDialogs": [
              "722110713"
            ]
          },
          "722110713": {
            "id": "722110713",
            "speakerId": 3044,
            "speakerName": "木南杏奈",
            "text": "不用谢啦，这道饭和食谱，就当做给那位寝子的礼物啦。",
            "nextDialogs": [
              "722110714"
            ]
          },
          "722110714": {
            "id": "722110714",
            "speakerId": 3044,
            "speakerName": "木南杏奈",
            "text": "等我有空了，一定会去那座「浅濑神社」拜访的。",
            "nextDialogs": [
              "722110715"
            ]
          },
          "722110715": {
            "id": "722110715",
            "speakerId": 3044,
            "speakerName": "木南杏奈",
            "text": "好了，你们快回去吧，别让寝子等急啦。"
          }
        }
      }
    },
    {
      "subId": "7221105",

    {
      "subId": "7221106",
      "subQuestName": "将「美味的活力喵饭」带给小猫们",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "722110601"
        ],
        "dialogs": {
          "722110601": {
            "id": "722110601",
            "speakerId": 3189,
            "speakerName": "「寝子」",
            "text": "做饭的事就交给汝等了。",
            "nextDialogs": [
              "722110602"
            ]
          },
          "722110602": {
            "id": "722110602",
            "speakerId": 3189,
            "speakerName": "「寝子」",
            "text": "然后，做好了以后，和奴家、还有小家伙们一起吃吧。"
          }
        }
      }
    },
    {
      "subId": "7221109",
      "subQuestName": "将「美味的活力喵饭」带给小猫们",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "722110901"
        ],
        "dialogs": {
          "722110901": {
            "id": "722110901",
            "speakerId": 3180,
            "speakerName": "悦子",
            "text": "怎么了？快去城里找木南杏奈小姐吧。"
          }
        }
      }
    },
    {
      "subId": "7221110",
      "subQuestName": "将「美味的活力喵饭」带给小猫们",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "722111001"
        ],
        "dialogs": {
          "722111001": {
            "id": "722111001",
            "speakerId": 3181,
            "speakerName": "大祐",
            "text": "唉，要是我有烹饪的才能就好了…"
          }
        }
      }
    },
    {
      "subId": "7221111",
      "subQuestName": "test 回滚隔离$HIDDEN",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "722111101"
        ],
        "dialogs": {
          "722111101": {
            "id": "722111101",
            "speakerId": 3044,
            "speakerName": "木南杏奈",
            "text": "你好，欢迎光临「木南料亭」，请问你们有什么需要的吗？",
            "nextDialogs": [
              "722111102"
            ]
          },
          "722111102": {
            "id": "722111102",
            "speakerId": 3044,
            "speakerName": "木南杏奈",
            "text": "你好…哎呀，是神里小姐的朋友！快请进，有什么我可以帮你们的吗？",
            "nextDialogs": [
              "722111103"
            ]
          },
          "722111103": {
            "id": "722111103",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "关于寝子的饭…",
            "nextDialogs": [
              "722111104"
            ]
          },
          "722111104": {
            "id": "722111104",
            "speakerId": 3044,
            "speakerName": "木南杏奈",
            "text": "「寝子」？这个名字，难不成是猫吗？",
            "nextDialogs": [
              "722111105"
            ]
          },
          "722111105": {
            "id": "722111105",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "你认识寝子吗？",
            "nextDialogs": [
              "722111106"
            ]
          },
          "722111106": {
            "id": "722111106",
            "speakerId": 3044,
            "speakerName": "木南杏奈",
            "text": "哎呀，不是。我只是觉得，这个名字很适合猫呢。",
            "nextDialogs": [
              "722111107"
            ]
          },
          "722111107": {
            "id": "722111107",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "真是强大的直觉…",
            "nextDialogs": [
              "722111108"
            ]
          },
          "722111108": {
            "id": "722111108",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "先不说这些，事情是这样的…",
            "nextDialogs": [
              "722111109"
            ]
          },
          "722111109": {
            "id": "722111109",
            "speakerId": 3044,
            "speakerName": "木南杏奈",
            "text": "清籁岛上…有一座浅濑神社，神社里有一只会说话的猫？！那只猫还拜托你们做一道菜给它？",
            "nextDialogs": [
              "722111110"
            ]
          },
          "722111110": {
            "id": "722111110",
            "speakerId": 3044,
            "speakerName": "木南杏奈",
            "text": "欸？欸！真的吗？我从来都没听说过！",
            "nextDialogs": [
              "722111111"
            ]
          },
          "722111111": {
            "id": "722111111",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "是、是真的…",
            "nextDialogs": [
              "722111113"
            ]
          },
          "722111113": {
            "id": "722111113",
            "speakerId": 3044,
            "speakerName": "木南杏奈",
            "text": "在清籁岛上对吧？等有机会，我一定要自己去看看…",
            "nextDialogs": [
              "722111114"
            ]
          },
          "722111114": {
            "id": "722111114",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "那个…寝子的饭…",
            "nextDialogs": [
              "722111115"
            ]
          },
          "722111115": {
            "id": "722111115",
            "speakerId": 3044,
            "speakerName": "木南杏奈",
            "text": "啊…对哦，差点忘了正事…我想想。",
            "nextDialogs": [
              "722111116"
            ]
          },
          "722111116": {
            "id": "722111116",
            "speakerId": 3044,
            "speakerName": "木南杏奈",
            "text": "唔…猫也会喜欢的饭吗…",
            "nextDialogs": [
              "722111117"
            ]
          },
          "722111117": {
            "id": "722111117",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "很难吗？",
            "nextDialogs": [
              "722111118"
            ]
          },
          "722111118": {
            "id": "722111118",
            "speakerId": 3044,
            "speakerName": "木南杏奈",
            "text": "……",
            "nextDialogs": [
              "722111119"
            ]
          },
          "722111119": {
            "id": "722111119",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "很、很难吗？",
            "nextDialogs": [
              "722111120"
            ]
          },
          "722111120": {
            "id": "722111120",
            "speakerId": 3044,
            "speakerName": "木南杏奈",
            "text": "这是对「木南」家名的挑战！我一定要克服！",
            "nextDialogs": [
              "722111121"
            ]
          },
          "722111121": {
            "id": "722111121",
            "speakerId": 3044,
            "speakerName": "木南杏奈",
            "text": "用鱼肉、兽肉、海草、稻米做出能让猫趋之若鹜的美食，就交给我吧。",
            "nextDialogs": [
              "722111122"
            ]
          },
          "722111122": {
            "id": "722111122",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "我、我也想吃！",
            "nextDialogs": [
              "722111125"
            ]
          },
          "722111125": {
            "id": "722111125",
            "speakerId": 3044,
            "speakerName": "木南杏奈",
            "text": "没问题！",
            "nextDialogs": [
              "722111126"
            ]
          },
          "722111126": {
            "id": "722111126",
            "speakerId": 3044,
            "speakerName": "木南杏奈",
            "text": "我先构思一下食谱，你们先帮我准备三份海草。"
          }
        }
      }
    },

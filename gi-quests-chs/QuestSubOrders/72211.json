    {
      "subId": "7221107",
      "subQuestName": "向寝子回报",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "722110501"
        ],
        "dialogs": {
          "722110501": {
            "id": "722110501",
            "speakerId": 3189,
            "speakerName": "「寝子」",
            "text": "汝等已经把饭带给那些小家伙了吗？",
            "nextDialogs": [
              "722110502"
            ]
          },
          "722110502": {
            "id": "722110502",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "都吃得很开心。",
            "nextDialogs": [
              "722110503"
            ]
          },
          "722110503": {
            "id": "722110503",
            "speakerId": 3189,
            "speakerName": "「寝子」",
            "text": "是吗？那样就好了，喵喵…",
            "nextDialogs": [
              "722110504"
            ]
          },
          "722110504": {
            "id": "722110504",
            "speakerId": 3189,
            "speakerName": "「寝子」",
            "text": "奴家已经很久没有吃过这样好吃的饭了。",
            "nextDialogs": [
              "722110505"
            ]
          },
          "722110505": {
            "id": "722110505",
            "speakerId": 3189,
            "speakerName": "「寝子」",
            "text": "喵喵喵…虽然奴家现在也不需要吃饭、不需要喝水了，但饭的滋味，真是让奴家欲罢不能呢…",
            "nextDialogs": [
              "722110506"
            ]
          },
          "722110506": {
            "id": "722110506",
            "speakerId": 3189,
            "speakerName": "「寝子」",
            "text": "有个小家伙叫「阿饭」，就是因为奴家想要用世界上最好的东西给她起名。",
            "nextDialogs": [
              "722110507"
            ]
          },
          "722110507": {
            "id": "722110507",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "阿响做的饭叫什么名字？",
            "nextDialogs": [
              "722110508"
            ]
          },
          "722110508": {
            "id": "722110508",
            "speakerId": 3189,
            "speakerName": "「寝子」",
            "text": "名字？饭还能有名字？",
            "nextDialogs": [
              "722110509"
            ]
          },
          "722110509": {
            "id": "722110509",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "这个饭叫「活力喵饭」。",
            "nextDialogs": [
              "722110510"
            ]
          },
          "722110510": {
            "id": "722110510",
            "speakerId": 3189,
            "speakerName": "「寝子」",
            "text": "名字好复杂。不过奴家不讨厌。",
            "nextDialogs": [
              "722110511"
            ]
          },
          "722110511": {
            "id": "722110511",
            "speakerId": 3189,
            "speakerName": "「寝子」",
            "text": "…汝说得也对。毕竟，饭是好东西。好东西都应该有名字才对。",
            "nextDialogs": [
              "722110512"
            ]
          },
          "722110512": {
            "id": "722110512",
            "speakerId": 3189,
            "speakerName": "「寝子」",
            "text": "喵喵，等阿响回来了，奴家再问她吧。然后，汝也可以做汝的饭给她吃…",
            "nextDialogs": [
              "722110513"
            ]
          },
          "722110513": {
            "id": "722110513",
            "speakerId": 3189,
            "speakerName": "「寝子」",
            "text": "然后，她再做她的饭给汝吃。然后，奴家可以吃两种不同的，又都很好吃的饭。",
            "nextDialogs": [
              "722110514"
            ]
          },
          "722110514": {
            "id": "722110514",
            "speakerId": 3189,
            "speakerName": "「寝子」",
            "text": "所以说，奴家得把神社打理得更好。等她回来了，就一起吃饭。",
            "nextDialogs": [
              "722110515"
            ]
          },
          "722110515": {
            "id": "722110515",
            "speakerId": 3189,
            "speakerName": "「寝子」",
            "text": "谢谢。很好吃。喵喵。"
          }
        }
      }
    },
    {
      "subId": "7221103",

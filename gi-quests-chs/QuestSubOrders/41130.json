        ],
        "dialogs": {
          "411300301": {
            "id": "411300301",
            "speakerId": 1000,
            "speakerName": "经纶",
            "text": "那只魔物就拜托你了，旅行者。",
            "nextDialogs": [
              "411300302"
            ]
          },
          "411300302": {
            "id": "411300302",
            "speakerId": 1000,
            "speakerName": "经纶",
            "text": "唉，要是我能再警觉一点的话…"
          }
        }
      }
    }

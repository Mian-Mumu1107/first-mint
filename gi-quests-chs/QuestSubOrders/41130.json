  "subQuests": [
    {
      "subId": "4113005",
      "subQuestName": "",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "411300501"
        ],
        "dialogs": {
          "411300501": {
            "id": "411300501",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "还有别的事。",
            "nextDialogs": [
              "411300502"
            ]
          },
          "411300502": {
            "id": "411300502",
            "speakerId": 1000,
            "speakerName": "经纶",
            "text": "哦…好吧。没关系，我再寻思一下怎么对付那些魔物…"
          }
        }
      }
    },
    {
      "subId": "4113001",
      "subQuestName": "与经纶对话",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "411300401"
        ],
        "dialogs": {
          "411300401": {
            "id": "411300401",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "没问题。",
            "nextDialogs": [
              "411300402"
            ]
          },
          "411300402": {
            "id": "411300402",
            "speakerId": 1000,
            "speakerName": "经纶",
            "text": "太好了。那我先去叫上其他人，我们马上出发，速战速决。",
            "nextDialogs": [
              "411300403"
            ]
          },
          "411300403": {
            "id": "411300403",
            "speakerId": 1000,
            "speakerName": "经纶",
            "text": "把魔物营地清理干净之后，我们再回来这里碰头。"
          }
        }
      }
    },
    {
      "subId": "4113002",
      "subQuestName": "打倒所有魔物，并清理所有障碍物",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "411300201"
        ],
        "dialogs": {
          "411300201": {
            "id": "411300201",
            "speakerId": 1000,
            "speakerName": "经纶",
            "text": "不行…必须得要人来支援…",
            "nextDialogs": [
              "411300202"
            ]
          },
          "411300202": {
            "id": "411300202",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "魔物营地已经清理干净了。",
            "nextDialogs": [
              "411300203"
            ]
          },
          "411300203": {
            "id": "411300203",
            "speakerId": 1000,
            "speakerName": "经纶",
            "text": "好的，谢谢你。但是刚才又出现了意外情况。",
            "nextDialogs": [
              "411300204"
            ]
          },
          "411300204": {
            "id": "411300204",
            "speakerId": 1000,
            "speakerName": "经纶",
            "text": "我本来以为，在轻策庄外围徘徊的只有一些普通的魔物…",
            "nextDialogs": [
              "411300205"
            ]
          },
          "411300205": {
            "id": "411300205",
            "speakerId": 1000,
            "speakerName": "经纶",
            "text": "我领着几个人，刚清理完了一个魔物营地，正准备休息一下之后再继续前进。",
            "nextDialogs": [
              "411300206"
            ]
          },
          "411300206": {
            "id": "411300206",
            "speakerId": 1000,
            "speakerName": "经纶",
            "text": "但是旁边的树林里，突然出现了一只丘丘岩盔王…",
            "nextDialogs": [
              "411300207"
            ]
          },
          "411300207": {
            "id": "411300207",
            "speakerId": 1000,
            "speakerName": "经纶",
            "text": "我们还没来得及做出反应，它就袭击了我们，很多人受了伤…我们只能暂时撤退。",
            "nextDialogs": [
              "411300208"
            ]
          },
          "411300208": {
            "id": "411300208",
            "speakerId": 1000,
            "speakerName": "经纶",
            "text": "那只魔物的威胁太大了，绝不能坐视不管。但去其他地方清理魔物营地的人还没回来…",
            "nextDialogs": [
              "411300209"
            ]
          },
          "411300209": {
            "id": "411300209",
            "speakerId": 1000,
            "speakerName": "经纶",
            "text": "旅行者，你愿意帮忙去打倒那个魔物吗？",
            "nextDialogs": [
              "411300211",
              "411300213"
            ]
          },
          "411300211": {
            "id": "411300211",
            "speakerId": 1000,
            "speakerName": "经纶",
            "text": "那就拜托你了，真是不好意思…这本来是我们的职责。"
          },
          "411300213": {
            "id": "411300213",
            "speakerId": 1000,
            "speakerName": "经纶",
            "text": "还好治疗及时，都没什么大碍…但一时半会是没法自如行动了。",
            "nextDialogs": [
              "411300214"
            ]
          },
          "411300214": {
            "id": "411300214",
            "speakerId": 1000,
            "speakerName": "经纶",
            "text": "所以，只能拜托你去打倒那个魔物了，旅行者。",
            "nextDialogs": [
              "411300215"
            ]
          },
          "411300215": {
            "id": "411300215",
            "speakerId": 1000,
            "speakerName": "经纶",
            "text": "真是不好意思…这本来是我们的职责…"
          }
        }
      }
    },
    {
      "subId": "4113006",
      "subQuestName": "清扫路障$HIDDEN",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "411300601"
        ],
        "dialogs": {
          "411300601": {
            "id": "411300601",
            "speakerId": 1000,
            "speakerName": "经纶",
            "text": "怎么样，你把那只魔物打倒了吗？",
            "nextDialogs": [
              "411300602"
            ]
          },
          "411300602": {
            "id": "411300602",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "已经打倒了。",
            "nextDialogs": [
              "411300603"
            ]
          },
          "411300603": {
            "id": "411300603",
            "speakerId": 1000,
            "speakerName": "经纶",
            "text": "太好了…这样子总算能缓口气了。",
            "nextDialogs": [
              "411300604"
            ]
          },
          "411300604": {
            "id": "411300604",
            "speakerId": 1000,
            "speakerName": "经纶",
            "text": "谢谢你帮忙，旅行者，这些东西请收下吧，就当是谢礼了。",
            "nextDialogs": [
              "411300605"
            ]
          },
          "411300605": {
            "id": "411300605",
            "speakerId": 1000,
            "speakerName": "经纶",
            "text": "但轻策庄周围为什么会突然出现这种魔物，真是奇怪…",
            "nextDialogs": [
              "411300606"
            ]
          },
          "411300606": {
            "id": "411300606",
            "speakerId": 1000,
            "speakerName": "经纶",
            "text": "算了，不管怎么样，我都得向总务司报告一下这件事。",
            "nextDialogs": [
              "411300607"
            ]
          },
          "411300607": {
            "id": "411300607",
            "speakerId": 1000,
            "speakerName": "经纶",
            "text": "希望总务司能再调一些人过来支援…"
          }
        }
      }
    },

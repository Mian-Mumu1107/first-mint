          },
          "700140108": {
            "id": "700140108",
            "speakerId": 1000,
            "speakerName": "困惑的丘丘人",
            "text": "Mi!",
            "nextDialogs": [
              "700140109"
            ]
          },
          "700140109": {
            "id": "700140109",
            "speakerId": 1565,
            "speakerName": "艾拉·马斯克",
            "text": "经过这些天的考察，我想你也知道它的要求了，辛苦你再跑一趟了。",
            "nextDialogs": [
              "700140110"
            ]
          },
          "700140110": {
            "id": "700140110",
            "speakerId": 1565,
            "speakerName": "艾拉·马斯克",
            "text": "那家伙的位置已经标在地图上了，接下来希望你能找到一直搜寻的目标吧！",
            "nextDialogs": [
              "700140111"
            ]
          },
          "700140111": {
            "id": "700140111",
            "speakerId": 1000,
            "speakerName": "困惑的丘丘人",
            "text": "Dada, Valo!"
          }
        }

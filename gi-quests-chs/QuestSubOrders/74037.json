    {
      "subId": "7403702",
      "subQuestName": "与勒莫迪埃对话",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "740370101"
        ],
        "dialogs": {
          "740370101": {
            "id": "740370101",
            "speakerId": 5109,
            "speakerName": "勒莫迪埃",
            "text": "唉，厄代尔怎么还没修好这个喷泉啊…",
            "nextDialogs": [
              "740370102"
            ]
          },
          "740370102": {
            "id": "740370102",
            "speakerId": 5109,
            "speakerName": "勒莫迪埃",
            "text": "再修不好，柯蕾特莉一定会让全世界的人都知道这个消息…",
            "nextDialogs": [
              "740370103"
            ]
          },
          "740370103": {
            "id": "740370103",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "这个喷泉坏掉了吗？",
            "nextDialogs": [
              "740370104"
            ]
          },
          "740370104": {
            "id": "740370104",
            "speakerId": 5109,
            "speakerName": "勒莫迪埃",
            "text": "唉，明明前段时间它还是好好的，突然就不再喷水了。",
            "nextDialogs": [
              "740370105"
            ]
          },
          "740370105": {
            "id": "740370105",
            "speakerId": 5109,
            "speakerName": "勒莫迪埃",
            "text": "而且…它还是刚好在我给柯蕾特莉变魔术的时候坏掉的！",
            "nextDialogs": [
              "740370106"
            ]
          },
          "740370106": {
            "id": "740370106",
            "speakerId": 5109,
            "speakerName": "勒莫迪埃",
            "text": "当时爸妈正好去歌剧院看歌剧了，就叮嘱我在家里带着妹妹看书玩游戏…",
            "nextDialogs": [
              "740370107"
            ]
          },
          "740370107": {
            "id": "740370107",
            "speakerId": 5109,
            "speakerName": "勒莫迪埃",
            "text": "但柯蕾特莉一个劲地嚷着要出去玩。我拗不过柯蕾特莉，只能陪着她出去闲逛。",
            "nextDialogs": [
              "740370108"
            ]
          },
          "740370108": {
            "id": "740370108",
            "speakerId": 5109,
            "speakerName": "勒莫迪埃",
            "text": "等我们逛到喷泉这里的时候，柯蕾特莉突然说要在这里等爸妈看完歌剧出来，然后和爸妈一起回家。",
            "nextDialogs": [
              "740370109"
            ]
          },
          "740370109": {
            "id": "740370109",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "感觉也没什么不好。",
            "nextDialogs": [
              "740370110"
            ]
          },
          "740370110": {
            "id": "740370110",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "对啊，反正都逛到这边了。等你们爸妈出来，说不定还能带你们去吃好吃的呢。",
            "nextDialogs": [
              "740370111"
            ]
          },
          "740370111": {
            "id": "740370111",
            "speakerId": 5109,
            "speakerName": "勒莫迪埃",
            "text": "当时夜很深了…要是爸妈知道我偷偷带妹妹出门，在外面晃到这个时候，非骂我不可！",
            "nextDialogs": [
              "740370112"
            ]
          },
          "740370112": {
            "id": "740370112",
            "speakerId": 5109,
            "speakerName": "勒莫迪埃",
            "text": "所以，我就骗柯蕾特莉说，我会一种魔术，能让正在喷水的喷泉停下来。",
            "nextDialogs": [
              "740370113"
            ]
          },
          "740370113": {
            "id": "740370113",
            "speakerId": 5109,
            "speakerName": "勒莫迪埃",
            "text": "其实我只是算好了喷泉的涌水间隔，想要逗柯蕾特莉开心，然后哄她回家罢了。",
            "nextDialogs": [
              "740370114"
            ]
          },
          "740370114": {
            "id": "740370114",
            "speakerId": 5109,
            "speakerName": "勒莫迪埃",
            "text": "喷泉确实按照我算的时间停了下来，柯蕾特莉也被我的「魔术」骗到了，一个劲地要我回家教她怎么变这个魔术。",
            "nextDialogs": [
              "740370115"
            ]
          },
          "740370115": {
            "id": "740370115",
            "speakerId": 5109,
            "speakerName": "勒莫迪埃",
            "text": "于是我就带着她回到家，搪塞了她几句，哄她去床上睡下，我也回了房间，爸妈过了一会之后也回了家，一切看上去都很正常…",
            "nextDialogs": [
              "740370116"
            ]
          },
          "740370116": {
            "id": "740370116",
            "speakerId": 5109,
            "speakerName": "勒莫迪埃",
            "text": "但第二天，在我出门帮老爸买报纸的时候，却发现这个喷泉还是没有工作…它直接坏掉了！",
            "nextDialogs": [
              "740370119",
              "740370133"
            ]
          },
          "740370119": {
            "id": "740370119",
            "speakerId": 5109,
            "speakerName": "勒莫迪埃",
            "text": "拜托，不要笑我了！要是柯蕾特莉向爸妈提起这件事，我就彻底完蛋了！",
            "nextDialogs": [
              "740370120"
            ]
          },
          "740370120": {
            "id": "740370120",
            "speakerId": 5109,
            "speakerName": "勒莫迪埃",
            "text": "「欸呀？广场上的喷泉突然坏掉了，老公，这是怎么回事？」",
            "nextDialogs": [
              "740370121"
            ]
          },
          "740370121": {
            "id": "740370121",
            "speakerId": 5109,
            "speakerName": "勒莫迪埃",
            "text": "「真的…怪了，我们那天晚上去看歌剧的时候，这喷泉还是好好的呀。」",
            "nextDialogs": [
              "740370122"
            ]
          },
          "740370122": {
            "id": "740370122",
            "speakerId": 5109,
            "speakerName": "勒莫迪埃",
            "text": "「我知道！是哥哥用魔术把喷泉停下了！是吧？哥哥！」"
          },
          "740370133": {
            "id": "740370133",
            "speakerId": 1003,
            "speakerName": "Black Screen",
            "text": "在观察喷泉时，似乎有另外一个人来到了喷泉旁边…"
          }
        }
      }
    },
    {
      "subId": "7403703",
      "subQuestName": "与厄代尔对话",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "740370301"
        ],
        "dialogs": {
          "740370301": {
            "id": "740370301",
            "speakerId": 13556,
            "speakerName": "厄代尔",
            "text": "这里的管道需要更换…阀门…还有清洁问题…真是问题一大堆。",
            "nextDialogs": [
              "740370302"
            ]
          },
          "740370302": {
            "id": "740370302",
            "speakerId": 13556,
            "speakerName": "厄代尔",
            "text": "咦？你们找我有事吗？看样子…你们也不像伊丝黛莱派过来修喷泉的人啊…",
            "nextDialogs": [
              "740370303"
            ]
          },
          "740370303": {
            "id": "740370303",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "关于勒莫迪埃的事…",
            "nextDialogs": [
              "740370304"
            ]
          },
          "740370304": {
            "id": "740370304",
            "speakerId": 13556,
            "speakerName": "厄代尔",
            "text": "你说他啊。嘿…他的魔术可太厉害啦，直接把那座喷泉底层管道的一个阀门给变废了，还顺便把喷口给弄坏了。",
            "nextDialogs": [
              "740370305"
            ]
          },
          "740370305": {
            "id": "740370305",
            "speakerId": 13556,
            "speakerName": "厄代尔",
            "text": "哈哈哈，开个玩笑。其实是那个变形的阀门卡住了整个出水系统，为了安全起见，我们只能暂时把整座喷泉给关上了。",
            "nextDialogs": [
              "740370306"
            ]
          },
          "740370306": {
            "id": "740370306",
            "speakerId": 13556,
            "speakerName": "厄代尔",
            "text": "不过喷口为什么会坏掉，我还真不清楚…真奇怪。",
            "nextDialogs": [
              "740370307"
            ]
          },
          "740370307": {
            "id": "740370307",
            "speakerId": 13556,
            "speakerName": "厄代尔",
            "text": "勒莫迪埃一直说，如果喷泉修不好，他就要挨骂…但我之前实在是顾不过来。",
            "nextDialogs": [
              "740370308"
            ]
          },
          "740370308": {
            "id": "740370308",
            "speakerId": 13556,
            "speakerName": "厄代尔",
            "text": "今天我总算有了点空，找伊丝黛莱订了一个新阀门和新喷口，正准备去城里拿过来呢。",
            "nextDialogs": [
              "740370309"
            ]
          },
          "740370309": {
            "id": "740370309",
            "speakerId": 13556,
            "speakerName": "厄代尔",
            "text": "要是你愿意的话，就和我一起去吧，东西还挺多的，我都有点担心我一个人拿不动了。"
          }
        }
      }
    },
    {
      "subId": "7403704",
      "subQuestName": "与伊丝黛莱对话",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "740370501"
        ],
        "dialogs": {
          "740370501": {
            "id": "740370501",
            "speakerId": 5033,
            "speakerName": "伊丝黛莱",
            "text": "你好，请问有什么…欸，厄代尔？",
            "nextDialogs": [
              "740370502"
            ]
          },
          "740370502": {
            "id": "740370502",
            "speakerId": 13556,
            "speakerName": "厄代尔",
            "text": "我来拿阀门和喷口了，再不修好那个喷泉，勒莫迪埃那小子非得急死不可。",
            "nextDialogs": [
              "740370503"
            ]
          },
          "740370503": {
            "id": "740370503",
            "speakerId": 5033,
            "speakerName": "伊丝黛莱",
            "text": "阀…阀门啊…",
            "nextDialogs": [
              "740370504"
            ]
          },
          "740370504": {
            "id": "740370504",
            "speakerId": 13556,
            "speakerName": "厄代尔",
            "text": "你…怎么支支吾吾的？伊丝黛莱…你不会压根就没做吧。",
            "nextDialogs": [
              "740370505"
            ]
          },
          "740370505": {
            "id": "740370505",
            "speakerId": 5033,
            "speakerName": "伊丝黛莱",
            "text": "不是！我已经做好了，只不过…因为之前一位客人需要紧急维修另外一些东西…",
            "nextDialogs": [
              "740370506"
            ]
          },
          "740370506": {
            "id": "740370506",
            "speakerId": 5033,
            "speakerName": "伊丝黛莱",
            "text": "我就…我就把一些通用的附属部件给了她…",
            "nextDialogs": [
              "740370507"
            ]
          },
          "740370507": {
            "id": "740370507",
            "speakerId": 5033,
            "speakerName": "伊丝黛莱",
            "text": "别急！我现在正在打造新的，马上就好！",
            "nextDialogs": [
              "740370508"
            ]
          },
          "740370508": {
            "id": "740370508",
            "speakerId": 13556,
            "speakerName": "厄代尔",
            "text": "伊丝黛莱小姐，我可是提前了很久订做的。",
            "nextDialogs": [
              "740370509"
            ]
          },
          "740370509": {
            "id": "740370509",
            "speakerId": 5033,
            "speakerName": "伊丝黛莱",
            "text": "我知道啦！但是那位客人也很急，说是要拿去修污水阀门什么的，我禁不住她求…",
            "nextDialogs": [
              "740370510"
            ]
          },
          "740370510": {
            "id": "740370510",
            "speakerId": 5033,
            "speakerName": "伊丝黛莱",
            "text": "没关系，等我…等我买的铁块到了，就能打造好！应该马上就到了！",
            "nextDialogs": [
              "740370511"
            ]
          },
          "740370511": {
            "id": "740370511",
            "speakerId": 13556,
            "speakerName": "厄代尔",
            "text": "你什么时候订的？",
            "nextDialogs": [
              "740370512"
            ]
          },
          "740370512": {
            "id": "740370512",
            "speakerId": 5033,
            "speakerName": "伊丝黛莱",
            "text": "今…今天早上…",
            "nextDialogs": [
              "740370515"
            ]
          },
          "740370515": {
            "id": "740370515",
            "speakerId": 5033,
            "speakerName": "伊丝黛莱",
            "text": "真的吗？太好了！那就拜托你了，旅行者。",
            "nextDialogs": [
              "740370516"
            ]
          },
          "740370516": {
            "id": "740370516",
            "speakerId": 5033,
            "speakerName": "伊丝黛莱",
            "text": "对不起，对不起！真的非常不好意思，只要三块铁块就好。",
            "nextDialogs": [
              "740370517"
            ]
          },
          "740370517": {
            "id": "740370517",
            "speakerId": 13556,
            "speakerName": "厄代尔",
            "text": "唉，也只能交给你了，旅行者。放心吧，我会付报酬给你的，不会让你白跑。"
          }
        }
      }
    },
    {
      "subId": "7403707",
      "subQuestName": "将铁块交给伊丝黛莱",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "740370701"
        ],
        "dialogs": {
          "740370701": {
            "id": "740370701",
            "speakerId": 5033,
            "speakerName": "伊丝黛莱",
            "text": "这些就足够了！请稍等一下，马上就好。",
            "nextDialogs": [
              "740370702"
            ]
          },
          "740370702": {
            "id": "740370702",
            "speakerId": 1003,
            "speakerName": "Black Screen",
            "text": "伊丝黛莱热火朝天地工作了起来…",
            "nextDialogs": [
              "740370703"
            ]
          },
          "740370703": {
            "id": "740370703",
            "speakerId": 5033,
            "speakerName": "伊丝黛莱",
            "text": "这样就好了，喷泉阀门和喷口，还有附属的通用机关零件，全都准备好了。",
            "nextDialogs": [
              "740370704"
            ]
          },
          "740370704": {
            "id": "740370704",
            "speakerId": 5033,
            "speakerName": "伊丝黛莱",
            "text": "厄代尔，旅行者，我们出发去伊黎耶岛吧，有我在，那座喷泉一定能很快修好的！",
            "nextDialogs": [
              "740370705"
            ]
          },
          "740370705": {
            "id": "740370705",
            "speakerId": 13556,
            "speakerName": "厄代尔",
            "text": "那我真是要拜托你了…这些东西我拿着，旅行者，我们快点出发吧。"
          }
        }
      }
    },
    {
      "subId": "7403705",
      "subQuestName": "与伊丝黛莱对话",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [],
        "dialogs": {}
      }
    },
    {
      "subId": "7403706",
      "subQuestName": "前往伊黎耶岛",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "740370801"
        ],
        "dialogs": {
          "740370801": {
            "id": "740370801",
            "speakerId": 13556,
            "speakerName": "厄代尔",
            "text": "就是这个喷泉了，咱们赶紧开始吧，这座喷泉停工了这么久，也该让它重新开始工作了。",
            "nextDialogs": [
              "740370802"
            ]
          },
          "740370802": {
            "id": "740370802",
            "speakerId": 1003,
            "speakerName": "Black Screen",
            "text": "两人开始热火朝天地工作了起来…",
            "nextDialogs": [
              "740370803"
            ]
          },
          "740370803": {
            "id": "740370803",
            "speakerId": 5033,
            "speakerName": "伊丝黛莱",
            "text": "阀门安装完了。我刚才也做了整体检查，没什么问题。",
            "nextDialogs": [
              "740370804"
            ]
          },
          "740370804": {
            "id": "740370804",
            "speakerId": 13556,
            "speakerName": "厄代尔",
            "text": "行，那我们先离远点，我等会打开水闸就行了。",
            "nextDialogs": [
              "740370805"
            ]
          },
          "740370805": {
            "id": "740370805",
            "speakerId": 13556,
            "speakerName": "厄代尔",
            "text": "我看看…总闸在那边，副闸也要操作…",
            "nextDialogs": [
              "740370806"
            ]
          },
          "740370806": {
            "id": "740370806",
            "speakerId": 13556,
            "speakerName": "厄代尔",
            "text": "你们稍等一下，我这就去把闸门打开。",
            "nextDialogs": [
              "740370807"
            ]
          },
          "740370807": {
            "id": "740370807",
            "speakerId": 13556,
            "speakerName": "厄代尔",
            "text": "到底是谁设计的这个系统，为什么把闸门放得这么远…",
            "nextDialogs": [
              "740370808"
            ]
          },
          "740370808": {
            "id": "740370808",
            "speakerId": 1003,
            "speakerName": "Black Screen",
            "text": "厄代尔风风火火地跑向了闸门的位置，过了一段时间后才回来…",
            "nextDialogs": [
              "740370809"
            ]
          },
          "740370809": {
            "id": "740370809",
            "speakerId": 13556,
            "speakerName": "厄代尔",
            "text": "哎哟，这些闸门开得真费劲，累死我了…",
            "nextDialogs": [
              "740370810"
            ]
          },
          "740370810": {
            "id": "740370810",
            "speakerId": 13556,
            "speakerName": "厄代尔",
            "text": "我们稍等一会吧，水马上就会输过来了。",
            "nextDialogs": [
              "740370811"
            ]
          },
          "740370811": {
            "id": "740370811",
            "speakerId": 1003,
            "speakerName": "Black Screen",
            "text": "在一阵沉闷的轰鸣声后，喷泉重新正常工作了起来…",
            "nextDialogs": [
              "740370812"
            ]
          },
          "740370812": {
            "id": "740370812",
            "speakerId": 5109,
            "speakerName": "勒莫迪埃",
            "text": "太好了，喷泉总算正常了…就算是柯蕾特莉提起那天晚上的事，我也可以装作不知道了…",
            "nextDialogs": [
              "740370815"
            ]
          },
          "740370815": {
            "id": "740370815",
            "speakerId": 5109,
            "speakerName": "勒莫迪埃",
            "text": "这根本就不是魔术的问题吧…总之，谢谢你了，这是我的一点心意，请你收下吧。",
            "nextDialogs": [
              "740370816"
            ]
          },
          "740370816": {
            "id": "740370816",
            "speakerId": 5109,
            "speakerName": "勒莫迪埃",
            "text": "还有我之前说要付给你的那份报酬，也放在里面了，多谢你帮忙。",
            "nextDialogs": [
              "740370817"
            ]
          },
          "740370817": {
            "id": "740370817",
            "speakerId": 5109,
            "speakerName": "勒莫迪埃",
            "text": "还有…厄代尔和伊丝黛莱小姐，也谢谢你们！",
            "nextDialogs": [
              "740370818"
            ]
          },
          "740370818": {
            "id": "740370818",
            "speakerId": 13556,
            "speakerName": "厄代尔",
            "text": "这是我分内的事，不用谢我。下次你也别深夜带着你家妹妹出来…呃…",
            "nextDialogs": [
              "740370819"
            ]
          },
          "740370819": {
            "id": "740370819",
            "speakerId": 5108,
            "speakerName": "柯蕾特莉",
            "text": "哥哥，你怎么也在这里？",
            "nextDialogs": [
              "740370820"
            ]
          },
          "740370820": {
            "id": "740370820",
            "speakerId": 5109,
            "speakerName": "勒莫迪埃",
            "text": "柯蕾特莉？！你怎么在这里，你不是…不是跟着爸妈出去散步了吗？",
            "nextDialogs": [
              "740370821"
            ]
          },
          "740370821": {
            "id": "740370821",
            "speakerId": 5108,
            "speakerName": "柯蕾特莉",
            "text": "嘿嘿…我趁着爸妈不注意跑出来啦，想看看这个喷泉怎么样了。",
            "nextDialogs": [
              "740370822"
            ]
          },
          "740370822": {
            "id": "740370822",
            "speakerId": 5108,
            "speakerName": "柯蕾特莉",
            "text": "哥哥之前不是用魔术把这个喷泉变停下来了吗？我还以为它今天还会停着呢…",
            "nextDialogs": [
              "740370823"
            ]
          },
          "740370823": {
            "id": "740370823",
            "speakerId": 5109,
            "speakerName": "勒莫迪埃",
            "text": "哈哈…那个…哈哈…魔术是有时限的，你知道吧？只能在一定的时间内派上用场…",
            "nextDialogs": [
              "740370824"
            ]
          },
          "740370824": {
            "id": "740370824",
            "speakerId": 5108,
            "speakerName": "柯蕾特莉",
            "text": "喔…那我要再看一次魔术！哥哥，你能现在把这个喷泉再变停下来吗？",
            "nextDialogs": [
              "740370825"
            ]
          },
          "740370825": {
            "id": "740370825",
            "speakerId": 5109,
            "speakerName": "勒莫迪埃",
            "text": "这…咳，柯蕾特莉，现在这附近还有许多行人。",
            "nextDialogs": [
              "740370826"
            ]
          },
          "740370826": {
            "id": "740370826",
            "speakerId": 5109,
            "speakerName": "勒莫迪埃",
            "text": "要是我把喷泉再停下来，会让其他想看喷泉的人不开心的…",
            "nextDialogs": [
              "740370827"
            ]
          },
          "740370827": {
            "id": "740370827",
            "speakerId": 5108,
            "speakerName": "柯蕾特莉",
            "text": "那…我们就晚点再出来吧！把爸爸妈妈也带上，他们一定也很想看哥哥变魔术的！",
            "nextDialogs": [
              "740370828"
            ]
          },
          "740370828": {
            "id": "740370828",
            "speakerId": 5109,
            "speakerName": "勒莫迪埃",
            "text": "啊？！不，那个…亲爱的小妹，这个喷泉的魔术我还没有…完全研究透。",
            "nextDialogs": [
              "740370829"
            ]
          },
          "740370829": {
            "id": "740370829",
            "speakerId": 5109,
            "speakerName": "勒莫迪埃",
            "text": "我相信爸妈不会想看到一个拙劣的半成品魔术的。",
            "nextDialogs": [
              "740370830"
            ]
          },
          "740370830": {
            "id": "740370830",
            "speakerId": 5109,
            "speakerName": "勒莫迪埃",
            "text": "所以，柯蕾特莉，你可千万不要现在就把我的「喷泉魔术」告诉爸妈。",
            "nextDialogs": [
              "740370831"
            ]
          },
          "740370831": {
            "id": "740370831",
            "speakerId": 5109,
            "speakerName": "勒莫迪埃",
            "text": "我准备把这个魔术完全研究透彻，然后给他们一个惊喜。",
            "nextDialogs": [
              "740370832"
            ]
          },
          "740370832": {
            "id": "740370832",
            "speakerId": 5108,
            "speakerName": "柯蕾特莉",
            "text": "好欸！爸爸妈妈一定会很喜欢的！",
            "nextDialogs": [
              "740370833"
            ]
          },
          "740370833": {
            "id": "740370833",
            "speakerId": 5109,
            "speakerName": "勒莫迪埃",
            "text": "没错，他们一定会很喜欢的。现在我们先回家去吧，我…我可以向你展示一个新魔术…"
          }
        }
      }
    },

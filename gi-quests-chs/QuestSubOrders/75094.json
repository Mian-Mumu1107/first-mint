    {
      "subId": "7509406",
      "subQuestName": "启动孵化器",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "750940601"
        ],
        "dialogs": {
          "750940601": {
            "id": "750940601",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "呼——吓死我了，突然就有怪物袭击过来了，还好我们足够厉害！",
            "nextDialogs": [
              "750940603",
              "750940605"
            ]
          },
          "750940603": {
            "id": "750940603",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "啊？不行不行不行，我不行的！我才不要跟那么可怕的怪物战斗呢！",
            "nextDialogs": [
              "750940606"
            ]
          },
          "750940606": {
            "id": "750940606",
            "speakerId": 1001,
            "speakerName": "#{REALNAME[ID(2)|SHOWHOST(true)]}",
            "text": "呀！呀！",
            "nextDialogs": [
              "750940607"
            ]
          },
          "750940607": {
            "id": "750940607",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "#{NICKNAME}，你看小家伙都着急了。我们还是先想办法孵化龙蛋吧！",
            "nextDialogs": [
              "750940608"
            ]
          },
          "750940608": {
            "id": "750940608",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "启动孵化器。",
            "nextDialogs": [
              "750940609"
            ]
          },
          "750940609": {
            "id": "750940609",
            "speakerId": 1002,
            "speakerName": "Black Screen",
            "text": "孵化器恢复了工作…\\n接下来需要做的，似乎只有等待…\\n然而，时间过去了很久…龙蛋没有发生任何的变化，一丝一毫都没有…",
            "nextDialogs": [
              "750940610"
            ]
          },
          "750940610": {
            "id": "750940610",
            "speakerId": 1001,
            "speakerName": "#{REALNAME[ID(2)|SHOWHOST(true)]}",
            "text": "嗯…嗯？",
            "nextDialogs": [
              "750940611"
            ]
          },
          "750940611": {
            "id": "750940611",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "好奇怪，感觉好像没有任何反应欸？难道是我们的操作有问题吗？我们要不再试一遍吧！"
          },
          "750940605": {
            "id": "750940605",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "就是！张牙舞爪的，我还以为是什么特别厉害的角色呢！结果就这，这样的攻击还不如小家伙撞人痛呢！"
          }
        }
      }
    },

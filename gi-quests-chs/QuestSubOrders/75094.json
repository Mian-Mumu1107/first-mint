      "subId": "7509402",
      "subQuestName": "调查隐藏房间",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "751260601"
        ],
        "dialogs": {
          "751260601": {
            "id": "751260601",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "没想到还发生过这样的事…密力奇，还有留下这篇笔记的人，大家真的都好勇敢…",
            "nextDialogs": [
              "751260602"
            ]
          },
          "751260602": {
            "id": "751260602",
            "speakerId": 1001,
            "speakerName": "#{REALNAME[ID(2)|SHOWHOST(true)]}",
            "text": "呀！",
            "nextDialogs": [
              "751260603"
            ]
          },
          "751260603": {
            "id": "751260603",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "这个是…是刚才手记里提到的，那颗休眠的龙蛋！",
            "nextDialogs": [
              "751260604"
            ]
          },
          "751260604": {
            "id": "751260604",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "#{REALNAME[ID(2)|SHOWHOST(true)]}，你是想让我们用孵化器把它孵出来吗？",
            "nextDialogs": [
              "751260605"
            ]
          },
          "751260605": {
            "id": "751260605",
            "speakerId": 1001,
            "speakerName": "#{REALNAME[ID(2)|SHOWHOST(true)]}",
            "text": "呀！呀！",
            "nextDialogs": [
              "751260606"
            ]
          },
          "751260606": {
            "id": "751260606",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "#——唔，龙蛋看起来状态蛮不错的，孵化器上正好也有操作指南。{NICKNAME}，要不我们就试试吧！",
            "nextDialogs": [
              "751260609"
            ]
          },
          "751260609": {
            "id": "751260609",
            "speakerId": 1001,
            "speakerName": "#{REALNAME[ID(2)|SHOWHOST(true)]}",
            "text": "呀！"
          }
        }
      }

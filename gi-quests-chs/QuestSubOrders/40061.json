    "派蒙": 6,
    "露子": 7
  },
  "subQuests": [
    {
      "subId": "4006101",
      "subQuestName": "前往珊瑚宫，与露子对话",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "400610101"
        ],
        "dialogs": {
          "400610101": {
            "id": "400610101",
            "speakerId": 3193,
            "speakerName": "露子",
            "text": "今天海祇岛刮起了南来风，我就料想会有好友来拜访。",
            "nextDialogs": [
              "400610102"
            ]
          },
          "400610102": {
            "id": "400610102",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "#每次你这么一说话，我和{NICKNAME}就要奔波大半天。",
            "nextDialogs": [
              "400610103"
            ]
          },
          "400610103": {
            "id": "400610103",
            "speakerId": 3193,
            "speakerName": "露子",
            "text": "不要这么说嘛。我们不是，好搭档吗？最好的那种。",
            "nextDialogs": [
              "400610104"
            ]
          },
          "400610104": {
            "id": "400610104",
            "speakerId": 3193,
            "speakerName": "露子",
            "text": "不过今天，我确实有件事想要拜托你们。",
            "nextDialogs": [
              "400610105"
            ]
          },
          "400610105": {
            "id": "400610105",
            "speakerId": 3193,
            "speakerName": "露子",
            "text": "相传，我家先祖在珊瑚宫海祇御灵祭之事外，还追加了另一套试炼。和海祇岛存亡无关，和真相有关。",
            "nextDialogs": [
              "400610106"
            ]
          },
          "400610106": {
            "id": "400610106",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "另一套…试炼？",
            "nextDialogs": [
              "400610107"
            ]
          },
          "400610107": {
            "id": "400610107",
            "speakerId": 3193,
            "speakerName": "露子",
            "text": "现在海祇岛的存亡危机既然已经解除了，那我就出于祖传的义务与责任提醒你们一下吧。",
            "nextDialogs": [
              "400610108"
            ]
          },
          "400610108": {
            "id": "400610108",
            "speakerId": 3193,
            "speakerName": "露子",
            "text": "你们可以去那个所谓的「蛇心之地」的某处，寻找第二试炼的线索。",
            "nextDialogs": [
              "400610109"
            ]
          },
          "400610109": {
            "id": "400610109",
            "speakerId": 3193,
            "speakerName": "露子",
            "text": "哎呀，解脱了，轻松了。这份沉重的责任可以传给我未来的女儿了。",
            "nextDialogs": [
              "400610110"
            ]
          },
          "400610110": {
            "id": "400610110",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "祖传的任务就是说这么简单的一句话吗！？",
            "nextDialogs": [
              "400610111"
            ]
          },
          "400610111": {
            "id": "400610111",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "…我至今还是有点跟不上露子的思维…"
          }
        }
      }
    },
    {
      "subId": "4006102",
      "subQuestName": "在「常夜」状态下调查蛇心之地",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [],
        "dialogs": {}
      }
    },
    {
      "subId": "4006103",
      "subQuestName": "在「常夜」状态下调查蛇心之地",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "722750101"
        ],
        "dialogs": {
          "722750101": {
            "id": "722750101",
            "speakerId": 20341,
            "speakerName": "乌帽子",
            "text": "此身既然已经显现，那血枝珊瑚应该已入海祇之手。让人欣慰。",
            "nextDialogs": [
              "722750102"
            ]
          },
          "722750102": {
            "id": "722750102",
            "speakerId": 20341,
            "speakerName": "乌帽子",
            "text": "我名厄伯斯，稻妻式名字是乌帽子。乃是珊瑚宫之辅弼，渊下宫巫女中的一位。",
            "nextDialogs": [
              "722750103"
            ]
          },
          "722750103": {
            "id": "722750103",
            "speakerId": 20341,
            "speakerName": "乌帽子",
            "text": "您应该就是取得珊瑚枝的勇者吧？",
            "nextDialogs": [
              "722750104"
            ]
          },
          "722750104": {
            "id": "722750104",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "是我没错。",
            "nextDialogs": [
              "722750105"
            ]
          },
          "722750105": {
            "id": "722750105",
            "speakerId": 20341,
            "speakerName": "乌帽子",
            "text": "实在抱歉，我要讲述之事可能过于复杂，不知应该如何说起。",
            "nextDialogs": [
              "722750106"
            ]
          },
          "722750106": {
            "id": "722750106",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "你可以从头开始说，我们会听的。",
            "nextDialogs": [
              "722750107"
            ]
          },
          "722750107": {
            "id": "722750107",
            "speakerId": 20341,
            "speakerName": "乌帽子",
            "text": "非常感谢。那么，就请容我为您稍事介绍吧。这要从海祇大御神打通海渊之门说起。",
            "nextDialogs": [
              "722750108"
            ]
          },
          "722750108": {
            "id": "722750108",
            "speakerId": 20341,
            "speakerName": "乌帽子",
            "text": "渊下宫的深处有一处天然溶洞，便是通往海祇岛之路。也是海祇所许诺的地上乐土。",
            "nextDialogs": [
              "722750109"
            ]
          },
          "722750109": {
            "id": "722750109",
            "speakerId": 20341,
            "speakerName": "乌帽子",
            "text": "我们在大御神的授意下，学习了鸣神文化，并且曾与诸方土地建立了外交。",
            "nextDialogs": [
              "722750110"
            ]
          },
          "722750110": {
            "id": "722750110",
            "speakerId": 20341,
            "speakerName": "乌帽子",
            "text": "鸣神岛还称赞我们的「海祇美人」呢。因为我们海祇人肤质细嫩，可以令七种难隐的污痕都不再显眼。",
            "nextDialogs": [
              "722750111"
            ]
          },
          "722750111": {
            "id": "722750111",
            "speakerId": 20341,
            "speakerName": "乌帽子",
            "text": "这种说法的来由呢，是因为我们和祖先都在渊下宫生活得不到日照…",
            "nextDialogs": [
              "722750114"
            ]
          },
          "722750114": {
            "id": "722750114",
            "speakerId": 20341,
            "speakerName": "乌帽子",
            "text": "啊，抱歉。以前日子与诸国外交，我作为珊瑚宫之辅弼，经常担任向导。一不小心就…",
            "nextDialogs": [
              "722750115"
            ]
          },
          "722750115": {
            "id": "722750115",
            "speakerId": 20341,
            "speakerName": "乌帽子",
            "text": "话说回来吧。我与珊瑚宫大人产生了分歧，在海祇大御神的调停之下，我们有了现在的这个方案。",
            "nextDialogs": [
              "722750116"
            ]
          },
          "722750116": {
            "id": "722750116",
            "speakerId": 20341,
            "speakerName": "乌帽子",
            "text": "因为渊下宫有「罪影」这种现象，「过去」、「历史」、「真相」这种东西，放着不管也会永世长存。",
            "nextDialogs": [
              "722750117"
            ]
          },
          "722750117": {
            "id": "722750117",
            "speakerId": 20341,
            "speakerName": "乌帽子",
            "text": "所以我们费心尽力，并不是为了铭记，而是为了「遗忘」。很明显，珊瑚宫大人就是这么想的。",
            "nextDialogs": [
              "722750118"
            ]
          },
          "722750118": {
            "id": "722750118",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "（她说的珊瑚宫，应该是很久以前的珊瑚宫巫女吧…）",
            "nextDialogs": [
              "722750119"
            ]
          },
          "722750119": {
            "id": "722750119",
            "speakerId": 20341,
            "speakerName": "乌帽子",
            "text": "取珊瑚枝的试炼，就是尽可能少地让后人接触事件全貌的设计。",
            "nextDialogs": [
              "722750120"
            ]
          },
          "722750120": {
            "id": "722750120",
            "speakerId": 20341,
            "speakerName": "乌帽子",
            "text": "而我则支持留下真相。因此海祇大御神许可我在此追加一道试炼，通过的话，就可以知晓秘密。",
            "nextDialogs": [
              "722750121"
            ]
          },
          "722750121": {
            "id": "722750121",
            "speakerId": 20341,
            "speakerName": "乌帽子",
            "text": "请您接受这个挑战吧。"
          }
        }
      }
    }
  ]
}
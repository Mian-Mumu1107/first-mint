        }
      }
    },
    {
      "subId": "7450006",
      "subQuestName": "",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "745000601"
        ],
        "dialogs": {
          "745000601": {
            "id": "745000601",
            "speakerId": 1003,
            "speakerName": "卡隆",
            "text": "这不是刚刚见过的两位客人吗？请问有什么需要吗？",
            "nextDialogs": [
              "745000602"
            ]
          },
          "745000602": {
            "id": "745000602",
            "speakerId": 1002,
            "speakerName": "派蒙",
            "text": "嘿嘿，是我们哦。我们刚才听说老板你那个玩具超级厉害，想要来了解一下啦。"
          }
        }
      }
    },
    {
      "subId": "7450005",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "745000501"
        ],
        "dialogs": {
          "745000501": {
            "id": "745000501",
            "speakerId": 1000,
            "speakerName": "阿尔邦",
            "text": "我得去和老板说一下，他请来的两位老爷上门了。",
            "nextDialogs": [
              "745000502"
            ]
          },
          "745000502": {
            "id": "745000502",
            "speakerId": 1001,
            "speakerName": "阿尔贝",
            "text": "快点去快点回啦，我一个人看店会很无聊。"
          }
        }
      }
    },
    {
      "subId": "7450099",

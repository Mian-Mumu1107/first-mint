{
  "lineCounts": {
    "Player": 18,
    "利弗": 13,
    "卡隆": 17,
    "派蒙": 41,
    "阿尔芒": 1,
    "阿尔贝": 22,
    "阿尔邦": 36,
    "阿尔邦&阿尔贝": 1
  },
  "subQuests": [
    {
      "subId": "7450003",
      "subQuestName": "",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "745000101"
        ],
        "dialogs": {
          "745000101": {
            "id": "745000101",
            "speakerId": 1000,
            "speakerName": "阿尔邦",
            "text": "真讨厌啊。",
            "nextDialogs": [
              "745000102"
            ]
          },
          "745000102": {
            "id": "745000102",
            "speakerId": 1001,
            "speakerName": "阿尔贝",
            "text": "就是，太讨厌了。",
            "nextDialogs": [
              "745000103"
            ]
          },
          "745000103": {
            "id": "745000103",
            "speakerId": 1000,
            "speakerName": "阿尔邦",
            "text": "这岂不是芙宁娜大人坐审判桌？",
            "nextDialogs": [
              "745000104"
            ]
          },
          "745000104": {
            "id": "745000104",
            "speakerId": 1001,
            "speakerName": "阿尔贝",
            "text": "一点都没错。",
            "nextDialogs": [
              "745000105"
            ]
          },
          "745000105": {
            "id": "745000105",
            "speakerId": 1002,
            "speakerName": "派蒙",
            "text": "芙宁娜大人坐审判桌？那是什么意思呀？",
            "nextDialogs": [
              "745000106"
            ]
          },
          "745000106": {
            "id": "745000106",
            "speakerId": 1000,
            "speakerName": "阿尔邦",
            "text": "哦！来客人了，看打扮，两位老爷是外地人吧？听不懂枫丹俗语很正常，且听小人问一句，审判桌该是给谁坐的？",
            "nextDialogs": [
              "745000107"
            ]
          },
          "745000107": {
            "id": "745000107",
            "speakerId": 1001,
            "speakerName": "阿尔贝",
            "text": "当然是审判官大人咯。",
            "nextDialogs": [
              "745000108"
            ]
          },
          "745000108": {
            "id": "745000108",
            "speakerId": 1000,
            "speakerName": "阿尔邦",
            "text": "那咱们的最高审判官是谁呢？",
            "nextDialogs": [
              "745000109"
            ]
          },
          "745000109": {
            "id": "745000109",
            "speakerId": 1001,
            "speakerName": "阿尔贝",
            "text": "当然是那维莱特大人咯。",
            "nextDialogs": [
              "745000110"
            ]
          },
          "745000110": {
            "id": "745000110",
            "speakerId": 1000,
            "speakerName": "阿尔邦",
            "text": "哎呀，那维莱特大人的位置，怎么被水神芙宁娜大人坐了去啊？两位老爷，这让堂下被审判的可怜人该作何感想啊。",
            "nextDialogs": [
              "745000111"
            ]
          },
          "745000111": {
            "id": "745000111",
            "speakerId": 1001,
            "speakerName": "阿尔贝",
            "text": "要是我绝对会感到被欺骗了啊，水神大人哪里懂审判嘛！",
            "nextDialogs": [
              "745000112"
            ]
          },
          "745000112": {
            "id": "745000112",
            "speakerId": 1002,
            "speakerName": "派蒙",
            "text": "呃…这样说，好像有种挂羊头卖狗肉的感觉…",
            "nextDialogs": [
              "745000113"
            ]
          },
          "745000113": {
            "id": "745000113",
            "speakerId": 1001,
            "speakerName": "阿尔贝",
            "text": "一点都没错！挂羊头卖狗肉，就是这个意思。",
            "nextDialogs": [
              "745000114"
            ]
          },
          "745000114": {
            "id": "745000114",
            "speakerId": 1002,
            "speakerName": "派蒙",
            "text": "原来那句话是这个意思啊。欸？！等等，你们拿自己的神明这样开玩笑没关系吗？！",
            "nextDialogs": [
              "745000115"
            ]
          },
          "745000115": {
            "id": "745000115",
            "speakerId": 1000,
            "speakerName": "阿尔邦",
            "text": "当然有关系啊，水神大人最喜欢这样的玩笑了。",
            "nextDialogs": [
              "745000116"
            ]
          },
          "745000116": {
            "id": "745000116",
            "speakerId": 1000,
            "speakerName": "阿尔邦",
            "text": "如果被她听见，一定会把小人绑上石头沉入深湖，然后兴致勃勃地在旁边观赏。",
            "nextDialogs": [
              "745000117"
            ]
          },
          "745000117": {
            "id": "745000117",
            "speakerId": 1001,
            "speakerName": "阿尔贝",
            "text": "但两位老爷，你们猜怎么着，原来阿尔邦这下人的嘴皮子太油滑，最后根本沉不下去嘛。",
            "nextDialogs": [
              "745000118"
            ]
          },
          "745000118": {
            "id": "745000118",
            "speakerId": 1001,
            "speakerName": "阿尔贝",
            "text": "「得救了！」水神大人肯定会激动地鼓起掌，兴许还会流下几滴眼泪，「真是太浪漫了！」",
            "nextDialogs": [
              "745000119"
            ]
          },
          "745000119": {
            "id": "745000119",
            "speakerId": 1000,
            "speakerName": "阿尔邦",
            "text": "搞不好还给小人颁发「枫丹浪漫市民」的勋章呢。",
            "nextDialogs": [
              "745000122"
            ]
          },
          "745000122": {
            "id": "745000122",
            "speakerId": 1002,
            "speakerName": "派蒙",
            "text": "我、我有点不知道该说什么…",
            "nextDialogs": [
              "745000123"
            ]
          },
          "745000123": {
            "id": "745000123",
            "speakerId": 1000,
            "speakerName": "阿尔邦",
            "text": "那么言归正传，两位老爷今天来小店有什么需要呢？",
            "nextDialogs": [
              "745000124"
            ]
          },
          "745000124": {
            "id": "745000124",
            "speakerId": 1001,
            "speakerName": "阿尔贝",
            "text": "话说回来，阿尔邦，你有没有觉得两位老爷的打扮…有点像是老板之前交代的著名冒险家啊？",
            "nextDialogs": [
              "745000125"
            ]
          },
          "745000125": {
            "id": "745000125",
            "speakerId": 1000,
            "speakerName": "阿尔邦",
            "text": "#哦！确实有点，如同金子和银子般耀眼的头发…哦哦哦哦——所以两位老爷是…{NICKNAME}{M#先生}{F#女士}，和派蒙女士？",
            "nextDialogs": [
              "745000126"
            ]
          },
          "745000126": {
            "id": "745000126",
            "speakerId": 1002,
            "speakerName": "派蒙",
            "text": "呜哇，你们认识我们吗？",
            "nextDialogs": [
              "745000127"
            ]
          },
          "745000127": {
            "id": "745000127",
            "speakerId": 1000,
            "speakerName": "阿尔邦",
            "text": "老板先前在冒险家协会打听了最近在枫丹活动的冒险家，协会告知了两位老爷的信息，言称是一对十分厉害的搭档。",
            "nextDialogs": [
              "745000128"
            ]
          },
          "745000128": {
            "id": "745000128",
            "speakerId": 1002,
            "speakerName": "派蒙",
            "text": "#嘿嘿，{NICKNAME}{M#先生}{F#女士}，看来我们名气越来越大了呢！"
          }
        }
      }
    },
    {
      "subId": "7450001",

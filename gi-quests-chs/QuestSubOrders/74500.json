    {
      "subId": "7450002",
      "subQuestName": "与发条工坊店员交谈",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [],
        "dialogs": {}
      }
    },
    {
      "subId": "7450004",
      "subQuestName": "前往勒波特钟表店",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "745000401"
        ],
        "dialogs": {
          "745000401": {
            "id": "745000401",
            "speakerId": 1003,
            "speakerName": "卡隆",
            "text": "两位客人你们好啊，我是小店店主卡隆，请问有什么需要吗？",
            "nextDialogs": [
              "745000402"
            ]
          },
          "745000402": {
            "id": "745000402",
            "speakerId": 1002,
            "speakerName": "派蒙",
            "text": "老板你们这里好多人哦，是在办什么活动吗？",
            "nextDialogs": [
              "745000403"
            ]
          },
          "745000403": {
            "id": "745000403",
            "speakerId": 1003,
            "speakerName": "卡隆",
            "text": "呵呵，算不上什么活动，只是小店最近新推出了一款新品玩具。就是店门口那个。两位如果有兴趣，可以随时过来体验。"
          }
        }
      }
    },
    {
      "subId": "7450005",
      "subQuestName": "与店主卡隆交谈",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "745000201"
        ],
        "dialogs": {
          "745000201": {
            "id": "745000201",
            "speakerId": 1003,
            "speakerName": "卡隆",
            "text": "两位客人你们好啊，我是小店店主卡隆，请问有什么需要吗？",
            "nextDialogs": [
              "745000202"
            ]
          },
          "745000202": {
            "id": "745000202",
            "speakerId": 1002,
            "speakerName": "派蒙",
            "text": "卡隆老板你好，我们听说这里有一个超级厉害的玩具，想要来了解一下啦。",
            "nextDialogs": [
              "745000203"
            ]
          },
          "745000203": {
            "id": "745000203",
            "speakerId": 1003,
            "speakerName": "卡隆",
            "text": "呵呵，当然可以，不过…两位是大哥请来打探情报的吧？",
            "nextDialogs": [
              "745000204"
            ]
          },
          "745000204": {
            "id": "745000204",
            "speakerId": 1002,
            "speakerName": "派蒙",
            "text": "欸？大哥？不对不对…你怎么一下就知道我们是来打探情报的？！",
            "nextDialogs": [
              "745000205"
            ]
          },
          "745000205": {
            "id": "745000205",
            "speakerId": 1003,
            "speakerName": "卡隆",
            "text": "我刚才看到，你们从发条工坊那边过来，那家店的店主是我大哥，所以我立刻就知道怎么回事了，这完全是他会做的事。",
            "nextDialogs": [
              "745000206"
            ]
          },
          "745000206": {
            "id": "745000206",
            "speakerId": 1002,
            "speakerName": "派蒙",
            "text": "怎么…一下就露馅了，这算什么，出师未捷什么来着…",
            "nextDialogs": [
              "745000207"
            ]
          },
          "745000207": {
            "id": "745000207",
            "speakerId": 1002,
            "speakerName": "派蒙",
            "text": "哎呀，我们应该做更多准备再来的，谁知道你们是兄弟啊，原本以为是同行相争，没想到是…是…是手足相残！",
            "nextDialogs": [
              "745000208"
            ]
          },
          "745000208": {
            "id": "745000208",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "派蒙，不要乱用词语。",
            "nextDialogs": [
              "745000209"
            ]
          },
          "745000209": {
            "id": "745000209",
            "speakerId": 1002,
            "speakerName": "派蒙",
            "text": "不好意思老板…我卡脑壳了。",
            "nextDialogs": [
              "745000210"
            ]
          },
          "745000210": {
            "id": "745000210",
            "speakerId": 1003,
            "speakerName": "卡隆",
            "text": "别在意，再好的玩具，零件偶尔也会卡住，人也是一样，所以要好好保养。",
            "nextDialogs": [
              "745000211"
            ]
          },
          "745000211": {
            "id": "745000211",
            "speakerId": 1003,
            "speakerName": "卡隆",
            "text": "而且…在大哥眼里，我们大概就是那种情况吧。算了，不说这个耽误两位时间了，我来介绍一下玩具吧。",
            "nextDialogs": [
              "745000212"
            ]
          },
          "745000212": {
            "id": "745000212",
            "speakerId": 1002,
            "speakerName": "派蒙",
            "text": "欸，老板不介意吗？我们…我们可算是商业间谍哦！",
            "nextDialogs": [
              "745000213"
            ]
          },
          "745000213": {
            "id": "745000213",
            "speakerId": 1003,
            "speakerName": "卡隆",
            "text": "哈哈，商业间谍，客人真有意思，小店真正的商品是那些钟表，是祖上传下来的手艺。",
            "nextDialogs": [
              "745000214"
            ]
          },
          "745000214": {
            "id": "745000214",
            "speakerId": 1003,
            "speakerName": "卡隆",
            "text": "但玩具只是我个人的爱好，这是带来快乐的东西，让更多人知道，不就相当于把快乐传递到更远的地方吗？",
            "nextDialogs": [
              "745000215"
            ]
          },
          "745000215": {
            "id": "745000215",
            "speakerId": 1002,
            "speakerName": "派蒙",
            "text": "哇，老板的说法很温柔呢！",
            "nextDialogs": [
              "745000216"
            ]
          },
          "745000216": {
            "id": "745000216",
            "speakerId": 1003,
            "speakerName": "卡隆",
            "text": "哈哈，如果是我大哥，他一定会说这是缺乏冒险精神…言归正传，两位不如试试玩具吧，希望你们喜欢。",
            "nextDialogs": [
              "745000217"
            ]
          },
          "745000217": {
            "id": "745000217",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "我听说老板是在蒙德得到的灵感？",
            "nextDialogs": [
              "745000218"
            ]
          },
          "745000218": {
            "id": "745000218",
            "speakerId": 1003,
            "speakerName": "卡隆",
            "text": "没错，我从小就向往蒙德，直到前段时间有机会过去旅游，果然收获不少。",
            "nextDialogs": [
              "745000219"
            ]
          },
          "745000219": {
            "id": "745000219",
            "speakerId": 1003,
            "speakerName": "卡隆",
            "text": "我把在蒙德遇见的一位冒险家的故事融入了里面。不过两位也不要有太高期待，说到底它也只是个简单的发条玩具而已。",
            "nextDialogs": [
              "745000220"
            ]
          },
          "745000220": {
            "id": "745000220",
            "speakerId": 1002,
            "speakerName": "派蒙",
            "text": "冒险家？原来不是什么炼金术玩具啊。",
            "nextDialogs": [
              "745000221"
            ]
          },
          "745000221": {
            "id": "745000221",
            "speakerId": 1003,
            "speakerName": "卡隆",
            "text": "炼金术玩具？听起来很有意思。不过这位冒险家，也是一位让人印象深刻的朋友，有机会我再好好讲讲他的故事吧。",
            "nextDialogs": [
              "745000222"
            ]
          },
          "745000222": {
            "id": "745000222",
            "speakerId": 1003,
            "speakerName": "卡隆",
            "text": "现在两位不如先试试这个玩具？说一千句不如亲手试一局。",
            "nextDialogs": [
              "745000223"
            ]
          },
          "745000223": {
            "id": "745000223",
            "speakerId": 1002,
            "speakerName": "派蒙",
            "text": "#虽然很想，但是那边还等着我们回复呢，{NICKNAME}，要不我们快去快回吧！好想立刻体验到这个冒险家玩具！",
            "nextDialogs": [
              "745000224"
            ]
          },
          "745000224": {
            "id": "745000224",
            "speakerId": 1003,
            "speakerName": "卡隆",
            "text": "那也好，小店随时欢迎二位。"
          }
        }
      }
    },
    {
      "subId": "7450011",
      "subQuestName": "返回莱舒的发条工坊",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "745000301"
        ],
        "dialogs": {
          "745000301": {
            "id": "745000301",
            "speakerId": 1000,
            "speakerName": "阿尔邦",
            "text": "老板，两位老爷回来了。",
            "nextDialogs": [
              "745000302"
            ]
          },
          "745000302": {
            "id": "745000302",
            "speakerId": 1004,
            "speakerName": "利弗",
            "text": "不愧是冒险家协会大力推荐的人，二位办事果然迅速。我是店主利弗，欢迎欢迎。",
            "nextDialogs": [
              "745000303"
            ]
          },
          "745000303": {
            "id": "745000303",
            "speakerId": 1002,
            "speakerName": "派蒙",
            "text": "利弗老板，你好你好，原来那边的卡隆老板和你是兄弟啊，我们都不知道这个事，一下就被他认出来了。",
            "nextDialogs": [
              "745000304"
            ]
          },
          "745000304": {
            "id": "745000304",
            "speakerId": 1000,
            "speakerName": "阿尔邦",
            "text": "阿尔贝，你怎么回事？这么重要的事情都忘记和贵客交代了。",
            "nextDialogs": [
              "745000305"
            ]
          },
          "745000305": {
            "id": "745000305",
            "speakerId": 1001,
            "speakerName": "阿尔贝",
            "text": "好你个阿尔邦！不是说你来说的吗？老板你要扣就扣这家伙的工资。",
            "nextDialogs": [
              "745000306"
            ]
          },
          "745000306": {
            "id": "745000306",
            "speakerId": 1002,
            "speakerName": "派蒙",
            "text": "喂，你们俩不会也是兄弟吧？",
            "nextDialogs": [
              "745000307"
            ]
          },
          "745000307": {
            "id": "745000307",
            "speakerId": 1005,
            "speakerName": "阿尔邦&阿尔贝",
            "text": "我没有这样的兄弟！",
            "nextDialogs": [
              "745000308"
            ]
          },
          "745000308": {
            "id": "745000308",
            "speakerId": 1004,
            "speakerName": "利弗",
            "text": "咳咳…两位的意思是…任务失败了？什么也没打探到？",
            "nextDialogs": [
              "745000309"
            ]
          },
          "745000309": {
            "id": "745000309",
            "speakerId": 1002,
            "speakerName": "派蒙",
            "text": "没有没有，卡隆老板是个很温柔的人，即使知道了也不介意，还欢迎我们随时去试玩呢。",
            "nextDialogs": [
              "745000310"
            ]
          },
          "745000310": {
            "id": "745000310",
            "speakerId": 1004,
            "speakerName": "利弗",
            "text": "呵呵，那小子…所以那真是炼金术玩具？",
            "nextDialogs": [
              "745000311"
            ]
          },
          "745000311": {
            "id": "745000311",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "不是，是一个冒险家玩具。",
            "nextDialogs": [
              "745000312"
            ]
          },
          "745000312": {
            "id": "745000312",
            "speakerId": 1004,
            "speakerName": "利弗",
            "text": "哼，原来还是老掉牙的冒险家玩具。他是不是还说，把什么冒险家的故事融入了里面？",
            "nextDialogs": [
              "745000313"
            ]
          },
          "745000313": {
            "id": "745000313",
            "speakerId": 1002,
            "speakerName": "派蒙",
            "text": "对对对，老板你怎么知道？你不会已经偷偷调查过吧？",
            "nextDialogs": [
              "745000314"
            ]
          },
          "745000314": {
            "id": "745000314",
            "speakerId": 1004,
            "speakerName": "利弗",
            "text": "那小子我太了解了，他总是把一些感性的东西放进玩具里，一点都不考虑市场。冒险家故事已经不适合这个时代了。",
            "nextDialogs": [
              "745000315"
            ]
          },
          "745000315": {
            "id": "745000315",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "可是他们店人气很旺。",
            "nextDialogs": [
              "745000316"
            ]
          },
          "745000316": {
            "id": "745000316",
            "speakerId": 1004,
            "speakerName": "利弗",
            "text": "正常的经营波动而已，等我们的「决斗代理人」企划完成，绝对会打得他们人仰马翻。",
            "nextDialogs": [
              "745000317"
            ]
          },
          "745000317": {
            "id": "745000317",
            "speakerId": 1002,
            "speakerName": "派蒙",
            "text": "又不是真的「决斗代理人」，是我们这种「过时」的冒险家假扮的啦。",
            "nextDialogs": [
              "745000318"
            ]
          },
          "745000318": {
            "id": "745000318",
            "speakerId": 1004,
            "speakerName": "利弗",
            "text": "这就是两位不懂了，这叫包装，市场就吃这套，没人管你们到底怎么做的。",
            "nextDialogs": [
              "745000319"
            ]
          },
          "745000319": {
            "id": "745000319",
            "speakerId": 1004,
            "speakerName": "利弗",
            "text": "只要拿到数据，再把它放进一些热门的玩具原型，再宣称这是一段关于「决斗代理人」成长的故事，事情就成了。",
            "nextDialogs": [
              "745000320"
            ]
          },
          "745000320": {
            "id": "745000320",
            "speakerId": 1002,
            "speakerName": "派蒙",
            "text": "就这样吗？总觉得这种故事会有问题…",
            "nextDialogs": [
              "745000321"
            ]
          },
          "745000321": {
            "id": "745000321",
            "speakerId": 1004,
            "speakerName": "利弗",
            "text": "故事有问题不重要，有噱头就可以了。",
            "nextDialogs": [
              "745000332"
            ]
          },
          "745000332": {
            "id": "745000332",
            "speakerId": 1004,
            "speakerName": "利弗",
            "text": "如果我说，阿尔邦和阿尔贝其实就是以「双人喜剧」为题材制作的仿真玩具魔偶，您怎么想？",
            "nextDialogs": [
              "745000322"
            ]
          },
          "745000322": {
            "id": "745000322",
            "speakerId": 1002,
            "speakerName": "派蒙",
            "text": "什么？！玩具魔偶？！真的…真的有这么逼真的玩具魔偶吗？",
            "nextDialogs": [
              "745000323"
            ]
          },
          "745000323": {
            "id": "745000323",
            "speakerId": 1000,
            "speakerName": "阿尔邦",
            "text": "当然，就是这么逼真。",
            "nextDialogs": [
              "745000324"
            ]
          },
          "745000324": {
            "id": "745000324",
            "speakerId": 1001,
            "speakerName": "阿尔贝",
            "text": "「双人喜剧」的世界，骗人也能骗得这么逼真哦！",
            "nextDialogs": [
              "745000325"
            ]
          },
          "745000325": {
            "id": "745000325",
            "speakerId": 1004,
            "speakerName": "利弗",
            "text": "看到了吧？这就是包装的力量，即使是噱头，但只要这样说了，就会有人产生兴趣。",
            "nextDialogs": [
              "745000326"
            ]
          },
          "745000326": {
            "id": "745000326",
            "speakerId": 1002,
            "speakerName": "派蒙",
            "text": "呜哇！原来是骗人的，你也太狡猾了吧…跟你弟弟之间的差别真大！",
            "nextDialogs": [
              "745000327"
            ]
          },
          "745000327": {
            "id": "745000327",
            "speakerId": 1004,
            "speakerName": "利弗",
            "text": "那小子不好好经营自己的发条钟表，非要插手玩具这个行当，我这个当大哥的，当然要好好教育他。",
            "nextDialogs": [
              "745000330"
            ]
          },
          "745000330": {
            "id": "745000330",
            "speakerId": 1004,
            "speakerName": "利弗",
            "text": "承蒙夸奖。那么，接下来就请二位贵客多多上心了，数据收集的事，由阿尔邦和阿尔贝具体负责。",
            "nextDialogs": [
              "745000331"
            ]
          },
          "745000331": {
            "id": "745000331",
            "speakerId": 1002,
            "speakerName": "派蒙",
            "text": "哼哼，你们的兄弟之争我们才管不着啦，不要少了我们的摩拉哦。"
          }
        }
      }
    },

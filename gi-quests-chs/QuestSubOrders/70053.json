      "dialogue": {
        "startDialogs": [
          "700530101"
        ],
        "dialogs": {
          "700530101": {
            "id": "700530101",
            "speakerId": 1035,
            "speakerName": "宵宫",
            "text": "#啊，是{NICKNAME}！好久没见你了，有好多话想和你讲。",
            "nextDialogs": [
              "700530102"
            ]
          },
          "700530102": {
            "id": "700530102",
            "speakerId": 1035,
            "speakerName": "宵宫",
            "text": "昨天老爹又做了一批新的烟花，我也一起帮忙了，是一对新婚夫妇订购的。",
            "nextDialogs": [
              "700530103"
            ]
          },
          "700530103": {
            "id": "700530103",
            "speakerId": 1035,
            "speakerName": "宵宫",
            "text": "我特地叮嘱老爹用了不同颜色的烟花，希望这些色彩能成为他们美好回忆的一部分。",
            "nextDialogs": [
              "700530104"
            ]
          },
          "700530104": {
            "id": "700530104",
            "speakerId": 1035,
            "speakerName": "宵宫",
            "text": "还有还有…昨天早柚来我们店里玩了哦，我们还聊起你呢。",
            "nextDialogs": [
              "700530105"
            ]
          },
          "700530105": {
            "id": "700530105",
            "speakerId": 1035,
            "speakerName": "宵宫",
            "text": "哎呀，你不在这里的时候，发生了好多事，好想全部分享给你！",
            "nextDialogs": [
              "700530106"
            ]
          },
          "700530106": {
            "id": "700530106",
            "speakerId": 1035,
            "speakerName": "宵宫",
            "text": "结果一高兴就说得没完没了，都没好好问候你、听你说话。",
            "nextDialogs": [
              "700530108",
              "700530110"
            ]
          },
          "700530108": {
            "id": "700530108",
            "speakerId": 1035,
            "speakerName": "宵宫",
            "text": "在这里遇见你真巧，一定是好运的预兆。对了，今天来这里是有什么特别的事情吗？"
          },
          "700530110": {
            "id": "700530110",
            "speakerId": 1035,
            "speakerName": "宵宫",
            "text": "好哦，今天来这里是有什么特别的事情吗？我会好好听你说的。"
          }
        }
      }
    }
  ]

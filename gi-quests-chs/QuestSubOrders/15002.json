  },
  "subQuests": [
    {
      "subId": "1500202",
      "subQuestName": "前往悬木人部族",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "150020201"
        ],
        "dialogs": {
          "150020201": {
            "id": "150020201",
            "speakerId": 1000,
            "speakerName": "基尼奇",
            "text": "#{NICKNAME}，派蒙。",
            "nextDialogs": [
              "150020202"
            ]
          },
          "150020202": {
            "id": "150020202",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "基尼奇！居然在这里见到你！我们先前还想找找你呢。",
            "nextDialogs": [
              "150020203"
            ]
          },
          "150020203": {
            "id": "150020203",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "你好，又见面了。",
            "nextDialogs": [
              "150020204"
            ]
          },
          "150020204": {
            "id": "150020204",
            "speakerId": 1000,
            "speakerName": "基尼奇",
            "text": "我就开门见山了。我听说，你们接受了特立尼达长老的邀请？",
            "nextDialogs": [
              "150020205"
            ]
          },
          "150020205": {
            "id": "150020205",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "啊！那个…你是说回火夜吗？呃…长老说本来是要请你去的…但是…哎呀…该怎么说…",
            "nextDialogs": [
              "150020206"
            ]
          },
          "150020206": {
            "id": "150020206",
            "speakerId": 1000,
            "speakerName": "基尼奇",
            "text": "别紧张，我是有重要的事告诉你们：特立尼达长老可能隐瞒了他的真正目的，他想一次性解决山王的问题。",
            "nextDialogs": [
              "150020207"
            ]
          },
          "150020207": {
            "id": "150020207",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "一次性解决？以后不办回火夜啦？",
            "nextDialogs": [
              "150020208"
            ]
          },
          "150020208": {
            "id": "150020208",
            "speakerId": 1000,
            "speakerName": "基尼奇",
            "text": "对，他希望借你们之手，让山王回归夜神的国度。",
            "nextDialogs": [
              "150020209"
            ]
          },
          "150020209": {
            "id": "150020209",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "回归夜神的国度…？",
            "nextDialogs": [
              "150020210"
            ]
          },
          "150020210": {
            "id": "150020210",
            "speakerId": 1000,
            "speakerName": "基尼奇",
            "text": "就是送山王去死。",
            "nextDialogs": [
              "150020211"
            ]
          },
          "150020211": {
            "id": "150020211",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "等一下！等一下！你能不能别这么直接…我有点不敢相信…这是真的吗？",
            "nextDialogs": [
              "150020212"
            ]
          },
          "150020212": {
            "id": "150020212",
            "speakerId": 1000,
            "speakerName": "基尼奇",
            "text": "你想要我委婉一点？嗯…",
            "nextDialogs": [
              "150020213"
            ]
          },
          "150020213": {
            "id": "150020213",
            "speakerId": 1000,
            "speakerName": "基尼奇",
            "text": "可能也许说不定是这样…特立尼达长老希望你们杀了山王。",
            "nextDialogs": [
              "150020214"
            ]
          },
          "150020214": {
            "id": "150020214",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "怎么会这样…山王不是你们活着的荣耀吗？！",
            "nextDialogs": [
              "150020215"
            ]
          },
          "150020215": {
            "id": "150020215",
            "speakerId": 1000,
            "speakerName": "基尼奇",
            "text": "荣耀背后也有代价。",
            "nextDialogs": [
              "150020216"
            ]
          },
          "150020216": {
            "id": "150020216",
            "speakerId": 1002,
            "speakerName": "特立尼达",
            "text": "没错，山王是我们活着的荣耀，但这荣耀也伴随代价。",
            "nextDialogs": [
              "150020217"
            ]
          },
          "150020217": {
            "id": "150020217",
            "speakerId": 1002,
            "speakerName": "特立尼达",
            "text": "唉…南娜已经不是第一个了…",
            "nextDialogs": [
              "150020218"
            ]
          },
          "150020218": {
            "id": "150020218",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "是因为他的龙伙伴南娜吗？",
            "nextDialogs": [
              "150020219"
            ]
          },
          "150020219": {
            "id": "150020219",
            "speakerId": 1000,
            "speakerName": "基尼奇",
            "text": "嗯，南娜大概也不是最后一个。",
            "nextDialogs": [
              "150020220"
            ]
          },
          "150020220": {
            "id": "150020220",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "但…就直接要杀死山王吗？这好像也太极端了点…",
            "nextDialogs": [
              "150020221"
            ]
          },
          "150020221": {
            "id": "150020221",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "那他要怎么杀死山王？",
            "nextDialogs": [
              "150020222"
            ]
          },
          "150020222": {
            "id": "150020222",
            "speakerId": 1000,
            "speakerName": "基尼奇",
            "text": "山王身上的深渊污染与普通灾害不同，数百年来被邪恶力量侵蚀，它的身体已经不可逆地深渊化了。",
            "nextDialogs": [
              "150020223"
            ]
          },
          "150020223": {
            "id": "150020223",
            "speakerId": 1000,
            "speakerName": "基尼奇",
            "text": "可以说既是深渊力量使它疯狂，也是深渊力量维持了它的生命。换言之，如果进行彻底的驱散，山王将安息。",
            "nextDialogs": [
              "150020224"
            ]
          },
          "150020224": {
            "id": "150020224",
            "speakerId": 1000,
            "speakerName": "基尼奇",
            "text": "往年的仪式只会驱散近半的深渊力量，这是一个使它既不会死亡又不会醒来的平衡线。",
            "nextDialogs": [
              "150020225"
            ]
          },
          "150020225": {
            "id": "150020225",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "长老好像没和我们说过具体要驱散多少…但他说今天要聊一聊细节…",
            "nextDialogs": [
              "150020226"
            ]
          },
          "150020226": {
            "id": "150020226",
            "speakerId": 1000,
            "speakerName": "基尼奇",
            "text": "那你们很快就能确认了。",
            "nextDialogs": [
              "150020227"
            ]
          },
          "150020227": {
            "id": "150020227",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "…如果长老真的想要杀死山王，我们可怎么办啊？",
            "nextDialogs": [
              "150020230"
            ]
          },
          "150020230": {
            "id": "150020230",
            "speakerId": 1000,
            "speakerName": "基尼奇",
            "text": "这个消息可能有些冲击，你们可以先当作不知道。稍后你们和特立尼达长老聊完后，方便来首领这边一趟吗？",
            "nextDialogs": [
              "150020231"
            ]
          },
          "150020231": {
            "id": "150020231",
            "speakerId": 1000,
            "speakerName": "基尼奇",
            "text": "我想和你们谈个交易。",
            "nextDialogs": [
              "150020232"
            ]
          },
          "150020232": {
            "id": "150020232",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "交易？",
            "nextDialogs": [
              "150020233"
            ]
          },
          "150020233": {
            "id": "150020233",
            "speakerId": 1000,
            "speakerName": "基尼奇",
            "text": "我准备了还不错的价格。你们应该也还有不少问题，等会是个好时候。",
            "nextDialogs": [
              "150020234"
            ]
          },
          "150020234": {
            "id": "150020234",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "我们一会就过去。",
            "nextDialogs": [
              "150020235"
            ]
          },
          "150020235": {
            "id": "150020235",
            "speakerId": 1000,
            "speakerName": "基尼奇",
            "text": "那稍后见。"
          }
        }
      }
    },
    {
      "subId": "1500201",
      "subQuestName": "前往特立尼达长老家",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "150020101"
        ],
        "dialogs": {
          "150020101": {
            "id": "150020101",
            "speakerId": 1002,
            "speakerName": "特立尼达",
            "text": "异邦的强者，你们来了，休息得还好吗？",
            "nextDialogs": [
              "150020102"
            ]
          },
          "150020102": {
            "id": "150020102",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "还…还不错哦！",
            "nextDialogs": [
              "150020103"
            ]
          },
          "150020103": {
            "id": "150020103",
            "speakerId": 1002,
            "speakerName": "特立尼达",
            "text": "那就好。我这边的进展也很顺利，不少长老都听说过您的事迹，包括首领在内，都对您表示了认可。",
            "nextDialogs": [
              "150020104"
            ]
          },
          "150020104": {
            "id": "150020104",
            "speakerId": 1002,
            "speakerName": "特立尼达",
            "text": "虽然也还有人坚持仪式应由「马{RUBY#[D]回火}力卜」的继承者来主持，但这种想法实在陈旧，我们得与时俱进。",
            "nextDialogs": [
              "150020105"
            ]
          },
          "150020105": {
            "id": "150020105",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "基尼奇好像自己也不想来…",
            "nextDialogs": [
              "150020106"
            ]
          },
          "150020106": {
            "id": "150020106",
            "speakerId": 1002,
            "speakerName": "特立尼达",
            "text": "没错，所以现在我们可以说一下仪式的细节了。",
            "nextDialogs": [
              "150020107"
            ]
          },
          "150020107": {
            "id": "150020107",
            "speakerId": 1002,
            "speakerName": "特立尼达",
            "text": "昨天我已经告知过您传火仪式的部分，在这之后，就是净化山王的部分。",
            "nextDialogs": [
              "150020108"
            ]
          },
          "150020108": {
            "id": "150020108",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "要怎么净化？",
            "nextDialogs": [
              "150020109"
            ]
          },
          "150020109": {
            "id": "150020109",
            "speakerId": 1002,
            "speakerName": "特立尼达",
            "text": "很简单，用圣火就行。这么多年的仪式，我们对这项工作都已经非常熟悉。对您肯定也没什么难度。",
            "nextDialogs": [
              "150020110"
            ]
          },
          "150020110": {
            "id": "150020110",
            "speakerId": 1002,
            "speakerName": "特立尼达",
            "text": "而我要说的关键在于，希望您可以用圣火驱散尽可能多的深渊能量，这样可以最大化维持山王的沉睡。",
            "nextDialogs": [
              "150020111"
            ]
          },
          "150020111": {
            "id": "150020111",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "就只是维持沉睡么…",
            "nextDialogs": [
              "150020112"
            ]
          },
          "150020112": {
            "id": "150020112",
            "speakerId": 1002,
            "speakerName": "特立尼达",
            "text": "没错。往年的仪式里，游火人往往无法驱散足够多的深渊能量，所以我们才需要定期重复这一仪式。",
            "nextDialogs": [
              "150020113"
            ]
          },
          "150020113": {
            "id": "150020113",
            "speakerId": 1002,
            "speakerName": "特立尼达",
            "text": "但我知道，您在对抗深渊方面很有经验。昨天您对圣火的使用也十分老道。",
            "nextDialogs": [
              "150020114"
            ]
          },
          "150020114": {
            "id": "150020114",
            "speakerId": 1002,
            "speakerName": "特立尼达",
            "text": "我想，如果是您的话，或许能够将山王体内的深渊能量全部驱散。这样就能保护我们在很长时间内免遭威胁。",
            "nextDialogs": [
              "150020115"
            ]
          },
          "150020115": {
            "id": "150020115",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "#{NICKNAME}…",
            "nextDialogs": [
              "150020116"
            ]
          },
          "150020116": {
            "id": "150020116",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "知道了。还有别的要注意的吗？",
            "nextDialogs": [
              "150020117"
            ]
          },
          "150020117": {
            "id": "150020117",
            "speakerId": 1002,
            "speakerName": "特立尼达",
            "text": "您听到这个要求居然一点也不担忧，看来是对自己很有信心了，哈哈。",
            "nextDialogs": [
              "150020118"
            ]
          },
          "150020118": {
            "id": "150020118",
            "speakerId": 1002,
            "speakerName": "特立尼达",
            "text": "其他就没有特别需要注意的了，仪式定在三天之后，届时我会再来通知您。",
            "nextDialogs": [
              "150020119"
            ]
          },
          "150020119": {
            "id": "150020119",
            "speakerId": 1002,
            "speakerName": "特立尼达",
            "text": "这段时间如果您有空，可以在部族里转一转。长老们也希望您能多在族人面前露露脸。",
            "nextDialogs": [
              "150020120"
            ]
          },
          "150020120": {
            "id": "150020120",
            "speakerId": 1002,
            "speakerName": "特立尼达",
            "text": "要是您还愿意顺手解决一些族人们的麻烦，那就再好不过了。",
            "nextDialogs": [
              "150020121"
            ]
          },
          "150020121": {
            "id": "150020121",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "还要帮别人解决麻烦啊？这算不算额外的价格…",
            "nextDialogs": [
              "150020122"
            ]
          },
          "150020122": {
            "id": "150020122",
            "speakerId": 1002,
            "speakerName": "特立尼达",
            "text": "哈哈，这只是小小的建议。我真心认为您这样的英雄，值得在部族里获得更多声望。",
            "nextDialogs": [
              "150020123"
            ]
          },
          "150020123": {
            "id": "150020123",
            "speakerId": 1002,
            "speakerName": "特立尼达",
            "text": "这几天我都会待在族内，如果有什么问题，可以随时找我解决。"
          }
        }
      }
    },
    {
      "subId": "1500203",
      "subQuestName": "与基尼奇会合",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "150020301"
        ],
        "dialogs": {
          "150020301": {
            "id": "150020301",
            "speakerId": 1000,
            "speakerName": "基尼奇",
            "text": "你们来了。",
            "nextDialogs": [
              "150020302"
            ]
          },
          "150020302": {
            "id": "150020302",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "基尼奇！特立尼达长老他说…",
            "nextDialogs": [
              "150020303"
            ]
          },
          "150020303": {
            "id": "150020303",
            "speakerId": 1000,
            "speakerName": "基尼奇",
            "text": "嗯，你们脸上已经写了答案。",
            "nextDialogs": [
              "150020304"
            ]
          },
          "150020304": {
            "id": "150020304",
            "speakerId": 1003,
            "speakerName": "瓦伊纳",
            "text": "#{NICKNAME}和派蒙？没有迎接两位的到访，是我作为一族首领的失职。",
            "nextDialogs": [
              "150020305"
            ]
          },
          "150020305": {
            "id": "150020305",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "瓦伊纳首领，你好…",
            "nextDialogs": [
              "150020306"
            ]
          },
          "150020306": {
            "id": "150020306",
            "speakerId": 1003,
            "speakerName": "瓦伊纳",
            "text": "我昨天才从特立尼达那里得知消息，所以托基尼奇请两位过来一叙。",
            "nextDialogs": [
              "150020307"
            ]
          },
          "150020307": {
            "id": "150020307",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "不用这么客气。",
            "nextDialogs": [
              "150020308"
            ]
          },
          "150020308": {
            "id": "150020308",
            "speakerId": 1003,
            "speakerName": "瓦伊纳",
            "text": "呵呵，基尼奇应该已经告诉了你们情况，那闲话我也不多说了。我很赞同两位来主持回火夜的仪式。",
            "nextDialogs": [
              "150020309"
            ]
          },
          "150020309": {
            "id": "150020309",
            "speakerId": 1003,
            "speakerName": "瓦伊纳",
            "text": "但我有一个请求：希望两位能确保山王的安全。",
            "nextDialogs": [
              "150020310"
            ]
          },
          "150020310": {
            "id": "150020310",
            "speakerId": 1003,
            "speakerName": "瓦伊纳",
            "text": "悬木人的孩子都是听着部族的英雄传说长大的，从窃火的尤潘基，到征战深渊的布基纳和山王…",
            "nextDialogs": [
              "150020311"
            ]
          },
          "150020311": {
            "id": "150020311",
            "speakerId": 1003,
            "speakerName": "瓦伊纳",
            "text": "那是给予我们骄傲与信念的宝贵历史。",
            "nextDialogs": [
              "150020312"
            ]
          },
          "150020312": {
            "id": "150020312",
            "speakerId": 1003,
            "speakerName": "瓦伊纳",
            "text": "现在要杀死山王，无异于要杀死我们自己的精神。如果发生这样的事，我将无颜面对夜神之国的祖先。",
            "nextDialogs": [
              "150020313"
            ]
          },
          "150020313": {
            "id": "150020313",
            "speakerId": 1003,
            "speakerName": "瓦伊纳",
            "text": "我为南娜的事悲伤，所以我不会苛责特立尼达。但为了部族，绝不能让山王有生命危险，这是悬木人的立身之根。",
            "nextDialogs": [
              "150020314"
            ]
          },
          "150020314": {
            "id": "150020314",
            "speakerId": 1003,
            "speakerName": "瓦伊纳",
            "text": "希望两位贵客能慎重考虑这件事。",
            "nextDialogs": [
              "150020315"
            ]
          },
          "150020315": {
            "id": "150020315",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "就没有两全其美的办法吗？",
            "nextDialogs": [
              "150020316"
            ]
          },
          "150020316": {
            "id": "150020316",
            "speakerId": 1003,
            "speakerName": "瓦伊纳",
            "text": "或许有，但还没显现出来。我们已经做过许多尝试。现在，我希望能听见两位的态度。",
            "nextDialogs": [
              "150020318",
              "150020320",
              "150020322",
              "150020324"
            ]
          },
          "150020318": {
            "id": "150020318",
            "speakerId": 1003,
            "speakerName": "瓦伊纳",
            "text": "虽然知道您可能还没有完全想好，但听见您这样说，我还是放心了许多。离仪式还有三天，到时候希望您能确定自己的心意。",
            "nextDialogs": [
              "150020326"
            ]
          },
          "150020326": {
            "id": "150020326",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "对了基尼奇，你刚刚不是说…",
            "nextDialogs": [
              "150020327"
            ]
          },
          "150020327": {
            "id": "150020327",
            "speakerId": 1000,
            "speakerName": "基尼奇",
            "text": "#{NICKNAME}，派蒙，我带你们去族里走走吧，顺便聊一聊。",
            "nextDialogs": [
              "150020328"
            ]
          },
          "150020328": {
            "id": "150020328",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "也好…我们可能是需要暂时换换脑子。"
          },
          "150020320": {
            "id": "150020320",
            "speakerId": 1003,
            "speakerName": "瓦伊纳",
            "text": "您的想法令人担忧，但我知道您肯定还在考虑中，没关系。离仪式还有三天，到时候希望您能确定自己的心意。"
          },
          "150020322": {
            "id": "150020322",
            "speakerId": 1003,
            "speakerName": "瓦伊纳",
            "text": "我明白，离仪式还有三天，到时候希望您能确定自己的心意。"
          },
          "150020324": {
            "id": "150020324",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "但是事情放在这里，它也不会自己解决的…我知道你肯定也没想好要怎么办，没关系，我们可以一起来想办法！",
            "nextDialogs": [
              "150020325"
            ]
          },
          "150020325": {
            "id": "150020325",
            "speakerId": 1004,
            "speakerName": "首领",
            "text": "感谢您，离仪式还有三天，到时候希望您能确定自己的心意。"
          }
        }
      }
    },
    {
      "subId": "1500204",
      "subQuestName": "与基尼奇到一边走走",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "150020401"
        ],
        "dialogs": {
          "150020401": {
            "id": "150020401",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "基尼奇，我知道特立尼达长老找你的时候你为什么没答应了。",
            "nextDialogs": [
              "150020402"
            ]
          },
          "150020402": {
            "id": "150020402",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "其实你早就知道这是个烫手山芋吧？还说什么额外的价格，你的借口好狡猾。",
            "nextDialogs": [
              "150020403"
            ]
          },
          "150020403": {
            "id": "150020403",
            "speakerId": 1000,
            "speakerName": "基尼奇",
            "text": "烫手山芋是真的，但借口也不假。要解决这件事，确实要付额外的代价。",
            "nextDialogs": [
              "150020404"
            ]
          },
          "150020404": {
            "id": "150020404",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "你有办法？",
            "nextDialogs": [
              "150020405"
            ]
          },
          "150020405": {
            "id": "150020405",
            "speakerId": 1000,
            "speakerName": "基尼奇",
            "text": "我在尝试。",
            "nextDialogs": [
              "150020406"
            ]
          },
          "150020406": {
            "id": "150020406",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "真的吗？快说出来让我们听听！",
            "nextDialogs": [
              "150020407"
            ]
          },
          "150020407": {
            "id": "150020407",
            "speakerId": 1000,
            "speakerName": "基尼奇",
            "text": "派蒙，我记得你之前说有事想找我？",
            "nextDialogs": [
              "150020408"
            ]
          },
          "150020408": {
            "id": "150020408",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "对哦，是什么来着？我想想…噢！我要跟你投诉阿乔，因为它实在是太没礼貌了！",
            "nextDialogs": [
              "150020409"
            ]
          },
          "150020409": {
            "id": "150020409",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "它今天怎么不在？",
            "nextDialogs": [
              "150020410"
            ]
          },
          "150020410": {
            "id": "150020410",
            "speakerId": 1000,
            "speakerName": "基尼奇",
            "text": "它的性格确实是问题。所以我请了一位老师教育它。",
            "nextDialogs": [
              "150020411"
            ]
          },
          "150020411": {
            "id": "150020411",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "教育？有点想看它被老师狠狠教训的样子！",
            "nextDialogs": [
              "150020412"
            ]
          },
          "150020412": {
            "id": "150020412",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "不过我们遇见阿乔的时候，它说你们在调查什么深渊气息…和这件事有关吗？",
            "nextDialogs": [
              "150020413"
            ]
          },
          "150020413": {
            "id": "150020413",
            "speakerId": 1000,
            "speakerName": "基尼奇",
            "text": "嗯，那就是我在尝试的办法。",
            "nextDialogs": [
              "150020414"
            ]
          },
          "150020414": {
            "id": "150020414",
            "speakerId": 1000,
            "speakerName": "基尼奇",
            "text": "我是个猎龙人，偶尔也猎深渊。有一次，我在追捕一种紫色魔犬时，曾误入了一处隐秘的空间。",
            "nextDialogs": [
              "150020415"
            ]
          },
          "150020415": {
            "id": "150020415",
            "speakerId": 1000,
            "speakerName": "基尼奇",
            "text": "后来我查了一些资料，才知道那里叫做兽境。兽境有大大小小很多个，那种紫色魔犬就是从那里面跑出来的。",
            "nextDialogs": [
              "150020416"
            ]
          },
          "150020416": {
            "id": "150020416",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "所以…？",
            "nextDialogs": [
              "150020417"
            ]
          },
          "150020417": {
            "id": "150020417",
            "speakerId": 1000,
            "speakerName": "基尼奇",
            "text": "如果我们能找到一处兽境并清空它，然后把山王安放在其中…它就既能活着，也无法威胁到部族了。",
            "nextDialogs": [
              "150020418"
            ]
          },
          "150020418": {
            "id": "150020418",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "天呢！听起来有点疯狂…这能行吗？",
            "nextDialogs": [
              "150020419"
            ]
          },
          "150020419": {
            "id": "150020419",
            "speakerId": 1000,
            "speakerName": "基尼奇",
            "text": "当然还有不少问题，比如山王在兽境待久了状况会不会变得更糟。",
            "nextDialogs": [
              "150020420"
            ]
          },
          "150020420": {
            "id": "150020420",
            "speakerId": 1000,
            "speakerName": "基尼奇",
            "text": "但即使是权宜之计，也是我们急需的。族内的矛盾不是一两天了。",
            "nextDialogs": [
              "150020421"
            ]
          },
          "150020421": {
            "id": "150020421",
            "speakerId": 1000,
            "speakerName": "基尼奇",
            "text": "首领认为无论如何都要保住山王。",
            "nextDialogs": [
              "150020422"
            ]
          },
          "150020422": {
            "id": "150020422",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "我明白…他不是要保住山王，其实是要保住你们的文化和荣耀。",
            "nextDialogs": [
              "150020423"
            ]
          },
          "150020423": {
            "id": "150020423",
            "speakerId": 1000,
            "speakerName": "基尼奇",
            "text": "嗯，但另一方，像特立尼达长老这样的，他更在乎当下、未来、还有身边的人们。",
            "nextDialogs": [
              "150020424"
            ]
          },
          "150020424": {
            "id": "150020424",
            "speakerId": 1000,
            "speakerName": "基尼奇",
            "text": "这也很好理解，为了守住一份过去的荣光，却用亲友的生命来支付代价…",
            "nextDialogs": [
              "150020425"
            ]
          },
          "150020425": {
            "id": "150020425",
            "speakerId": 1000,
            "speakerName": "基尼奇",
            "text": "谁也不能替他们说，这很划算。",
            "nextDialogs": [
              "150020426"
            ]
          },
          "150020426": {
            "id": "150020426",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "真是个难题…先把这个放一边吧，就算按照你的计划来，你又打算去哪里找兽境呢？",
            "nextDialogs": [
              "150020427"
            ]
          },
          "150020427": {
            "id": "150020427",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "从来都是那些猎犬突然从兽境裂隙钻出来凶我们，可没有我们钻过去凶它们的时候。",
            "nextDialogs": [
              "150020428"
            ]
          },
          "150020428": {
            "id": "150020428",
            "speakerId": 1000,
            "speakerName": "基尼奇",
            "text": "我已经有了眉目。",
            "nextDialogs": [
              "150020429"
            ]
          },
          "150020429": {
            "id": "150020429",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "你真打算这么干？",
            "nextDialogs": [
              "150020430"
            ]
          },
          "150020430": {
            "id": "150020430",
            "speakerId": 1000,
            "speakerName": "基尼奇",
            "text": "你们有第二个办法吗？",
            "nextDialogs": [
              "150020431"
            ]
          },
          "150020431": {
            "id": "150020431",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "暂时也没有…只是觉得，利用深渊力量会变得不幸…",
            "nextDialogs": [
              "150020432"
            ]
          },
          "150020432": {
            "id": "150020432",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "这可是害山王变成这样的深渊力量欸，其他人肯定不能理解你的…",
            "nextDialogs": [
              "150020433"
            ]
          },
          "150020433": {
            "id": "150020433",
            "speakerId": 1000,
            "speakerName": "基尼奇",
            "text": "如果真有什么不幸，那就是代价吧。世上所有事情都被标了价，窃火的尤潘基大人也没能「免费」。",
            "nextDialogs": [
              "150020434"
            ]
          },
          "150020434": {
            "id": "150020434",
            "speakerId": 1000,
            "speakerName": "基尼奇",
            "text": "这次山王的突然暴动，让族里的矛盾变得更加尖利，如果不能尽快化解，谁也无法往前走的。",
            "nextDialogs": [
              "150020435"
            ]
          },
          "150020435": {
            "id": "150020435",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "好吧…那你想和我们谈什么交易啊？我们对深渊力量也没有什么研究…",
            "nextDialogs": [
              "150020436"
            ]
          },
          "150020436": {
            "id": "150020436",
            "speakerId": 1000,
            "speakerName": "基尼奇",
            "text": "你们只要能帮我争取一些空间就好。",
            "nextDialogs": [
              "150020437"
            ]
          },
          "150020437": {
            "id": "150020437",
            "speakerId": 1000,
            "speakerName": "基尼奇",
            "text": "每天都有不少人来劝我，希望我能担任这次的游火人。我不想把精力浪费在应付他们身上。",
            "nextDialogs": [
              "150020438"
            ]
          },
          "150020438": {
            "id": "150020438",
            "speakerId": 1000,
            "speakerName": "基尼奇",
            "text": "如果你们能帮我，我可以送你们一件礼物。",
            "nextDialogs": [
              "150020439"
            ]
          },
          "150020439": {
            "id": "150020439",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "什么礼物？",
            "nextDialogs": [
              "150020440"
            ]
          },
          "150020440": {
            "id": "150020440",
            "speakerId": 1000,
            "speakerName": "基尼奇",
            "text": "应该能值回票价的礼物。",
            "nextDialogs": [
              "150020441"
            ]
          },
          "150020441": {
            "id": "150020441",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "那你想我们怎么做？",
            "nextDialogs": [
              "150020442"
            ]
          },
          "150020442": {
            "id": "150020442",
            "speakerId": 1000,
            "speakerName": "基尼奇",
            "text": "和现在一样，在族里混个脸熟，让大家都知道我们要有一位新的游火人了。",
            "nextDialogs": [
              "150020443"
            ]
          },
          "150020443": {
            "id": "150020443",
            "speakerId": 1000,
            "speakerName": "基尼奇",
            "text": "这样我就可以避开无尽的要我去主持仪式的请求，去搞定召唤兽境的办法。",
            "nextDialogs": [
              "150020444"
            ]
          },
          "150020444": {
            "id": "150020444",
            "speakerId": 1000,
            "speakerName": "基尼奇",
            "text": "等到仪式那天，我们来给山王搬个家。",
            "nextDialogs": [
              "150020445"
            ]
          },
          "150020445": {
            "id": "150020445",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "好疯狂…基尼奇，你身上的冒险精神是不是有点过头了…",
            "nextDialogs": [
              "150020446"
            ]
          },
          "150020446": {
            "id": "150020446",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "你有想过，万一首领和特立尼达长老他们都不喜欢这个结果会怎么样吗？",
            "nextDialogs": [
              "150020447"
            ]
          },
          "150020447": {
            "id": "150020447",
            "speakerId": 1000,
            "speakerName": "基尼奇",
            "text": "那他们至少又站上同一阵线，对立面变成我而已。",
            "nextDialogs": [
              "150020448"
            ]
          },
          "150020448": {
            "id": "150020448",
            "speakerId": 1000,
            "speakerName": "基尼奇",
            "text": "部族需要的正是他们这种领袖，不是我这种拿钱办事的猎龙人。",
            "nextDialogs": [
              "150020449"
            ]
          },
          "150020449": {
            "id": "150020449",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "这次可没人付钱给你了。",
            "nextDialogs": [
              "150020450"
            ]
          },
          "150020450": {
            "id": "150020450",
            "speakerId": 1000,
            "speakerName": "基尼奇",
            "text": "哈，我可以理解为你同意了？",
            "nextDialogs": [
              "150020451"
            ]
          },
          "150020451": {
            "id": "150020451",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "我们可以先试试。",
            "nextDialogs": [
              "150020452"
            ]
          },
          "150020452": {
            "id": "150020452",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "没错，说不定这几天又想到更好的办法了呢！",
            "nextDialogs": [
              "150020453"
            ]
          },
          "150020453": {
            "id": "150020453",
            "speakerId": 1000,
            "speakerName": "基尼奇",
            "text": "嗯，接下来几天，希望你们多在族内逛一逛，帮帮忙，相信大家肯定会为你这位游火人的魅力倾倒。",
            "nextDialogs": [
              "150020454"
            ]
          },
          "150020454": {
            "id": "150020454",
            "speakerId": 1000,
            "speakerName": "基尼奇",
            "text": "祝我们顺利。"
          }
        }
      }
    }
  ]
}
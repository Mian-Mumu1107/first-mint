  "subQuests": [
    {
      "subId": "1501701",
      "subQuestName": "与夏温对话",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "150170101"
        ],
        "dialogs": {
          "150170101": {
            "id": "150170101",
            "speakerId": 1000,
            "speakerName": "夏温",
            "text": "喔！你们来得挺早啊，看来很期待那份礼物嘛。",
            "nextDialogs": [
              "150170103",
              "150170106"
            ]
          },
          "150170103": {
            "id": "150170103",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "对呀。妮赫佳生了那么一场大病，特拉佐莉女士还失去了那么重要的工作…",
            "nextDialogs": [
              "150170104"
            ]
          },
          "150170104": {
            "id": "150170104",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "虽然情况好转了，但不知道她们能不能打起精神来。",
            "nextDialogs": [
              "150170109"
            ]
          },
          "150170109": {
            "id": "150170109",
            "speakerId": 1000,
            "speakerName": "夏温",
            "text": "哈哈哈，我已经托人去给特拉佐莉打过招呼了，她应该已经做好了所有准备。",
            "nextDialogs": [
              "150170110"
            ]
          },
          "150170110": {
            "id": "150170110",
            "speakerId": 1000,
            "speakerName": "夏温",
            "text": "我们赶紧出发吧，伊蜜，麻烦你照顾好店，等会我就回来。"
          },
          "150170106": {
            "id": "150170106",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "我也很在意…不过，我们也是想去看看妮赫佳的情况啦。",
            "nextDialogs": [
              "150170107"
            ]
          },
          "150170107": {
            "id": "150170107",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "她生了那么重的病，不知道恢复得怎么样了，还有特拉佐莉女士…",
            "nextDialogs": [
              "150170108"
            ]
          },
          "150170108": {
            "id": "150170108",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "失去了那么重要的工作，也不知道她能不能重新打起精神来。"
          }
        }
      }
    },
    {
      "subId": "1501702",
      "subQuestName": "与夏温一同去拜访特拉佐莉",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "150170201"
        ],
        "dialogs": {
          "150170201": {
            "id": "150170201",
            "speakerId": 1000,
            "speakerName": "夏温",
            "text": "就是这里了。这屋子看着还挺气派的吧？稍等，我过去敲门。",
            "nextDialogs": [
              "150170202"
            ]
          },
          "150170202": {
            "id": "150170202",
            "speakerId": 1000,
            "speakerName": "夏温",
            "text": "特拉佐莉，开门吧，我把那两位带来啦。",
            "nextDialogs": [
              "150170203"
            ]
          },
          "150170203": {
            "id": "150170203",
            "speakerId": 1000,
            "speakerName": "夏温",
            "text": "…特拉佐莉？你在吗？开开门啊。",
            "nextDialogs": [
              "150170204"
            ]
          },
          "150170204": {
            "id": "150170204",
            "speakerId": 1000,
            "speakerName": "夏温",
            "text": "怪了，这门…呃，怎么是锁死的。这个时间她应该不会出去啊。",
            "nextDialogs": [
              "150170205"
            ]
          },
          "150170205": {
            "id": "150170205",
            "speakerId": 1000,
            "speakerName": "夏温",
            "text": "妮赫佳，妮赫佳？我是夏温姐姐，给我们开开门吧。",
            "nextDialogs": [
              "150170210",
              "150170208"
            ]
          },
          "150170210": {
            "id": "150170210",
            "speakerId": 1000,
            "speakerName": "夏温",
            "text": "真奇怪，我都和特拉佐莉说好了…难道是她临时带着小妮赫佳出去拿药了？",
            "nextDialogs": [
              "150170211"
            ]
          },
          "150170211": {
            "id": "150170211",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "咦？这旁边是什么地方，看着像是小嵴锋龙的窝。",
            "nextDialogs": [
              "150170212"
            ]
          },
          "150170212": {
            "id": "150170212",
            "speakerId": 1000,
            "speakerName": "夏温",
            "text": "没错，特拉佐莉有一只嵴锋龙伙伴，我记得名字好像是叫…「延古」来着。",
            "nextDialogs": [
              "150170213"
            ]
          },
          "150170213": {
            "id": "150170213",
            "speakerId": 1000,
            "speakerName": "夏温",
            "text": "之前她还在做锻造工作时，经常让延古帮忙做些挖掘工作。",
            "nextDialogs": [
              "150170214"
            ]
          },
          "150170214": {
            "id": "150170214",
            "speakerId": 1000,
            "speakerName": "夏温",
            "text": "但自从妮赫佳生病之后，特拉佐莉就再也没让延古挖掘过什么…",
            "nextDialogs": [
              "150170215"
            ]
          },
          "150170215": {
            "id": "150170215",
            "speakerId": 1000,
            "speakerName": "夏温",
            "text": "等等，这周围怎么乱七八糟的？延古也不见了。",
            "nextDialogs": [
              "150170216"
            ]
          },
          "150170216": {
            "id": "150170216",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "呜哇！还有好多箱子碎掉了，不会是遇见了什么坏事吧？"
          },
          "150170208": {
            "id": "150170208",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "难道特拉佐莉女士和妮赫佳又出事了？还是妮赫佳的病情又…呜…我不敢想了…",
            "nextDialogs": [
              "150170209"
            ]
          },
          "150170209": {
            "id": "150170209",
            "speakerId": 1000,
            "speakerName": "夏温",
            "text": "你别瞎想，昨天我来的时候，她们母女俩的情况很好，妮赫佳在自己的屋里睡得可安稳了。"
          }
        }
      }
    },
    {

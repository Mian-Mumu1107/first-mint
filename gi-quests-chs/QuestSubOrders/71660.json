  },
  "subQuests": [
    {
      "subId": "7166001",
      "subQuestName": "向蒂玛乌斯回报「烟霰魔药」的效果",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "716600101"
        ],
        "dialogs": {
          "716600101": {
            "id": "716600101",
            "speakerId": 1587,
            "speakerName": "蒂玛乌斯",
            "text": "你们回来了！「烟霰魔药」的效果如何？",
            "nextDialogs": [
              "716600103",
              "716600106"
            ]
          },
          "716600103": {
            "id": "716600103",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "对对对！那样就锦上添花了！",
            "nextDialogs": [
              "716600104"
            ]
          },
          "716600104": {
            "id": "716600104",
            "speakerId": 1587,
            "speakerName": "蒂玛乌斯",
            "text": "哦？感觉你们的评价还不错嘛，请展开说说！",
            "nextDialogs": [
              "716600108"
            ]
          },
          "716600108": {
            "id": "716600108",
            "speakerId": 1002,
            "speakerName": "Black Screen",
            "text": "向蒂玛乌斯详细说明了试验中的细节。",
            "nextDialogs": [
              "716600109"
            ]
          },
          "716600109": {
            "id": "716600109",
            "speakerId": 1587,
            "speakerName": "蒂玛乌斯",
            "text": "和你的预测完全相符啊，莺儿小姐！",
            "nextDialogs": [
              "716600110"
            ]
          },
          "716600110": {
            "id": "716600110",
            "speakerId": 1587,
            "speakerName": "蒂玛乌斯",
            "text": "完善「烟霰魔药」的方向确定了——我们需要将升华后的药剂约束在一定范围内。",
            "nextDialogs": [
              "716600111"
            ]
          },
          "716600111": {
            "id": "716600111",
            "speakerId": 1587,
            "speakerName": "蒂玛乌斯",
            "text": "或许…反向利用蒲公英的特性，制作特殊的辅料，就能让药剂免受空气流动的影响。",
            "nextDialogs": [
              "716600112"
            ]
          },
          "716600112": {
            "id": "716600112",
            "speakerId": 1587,
            "speakerName": "蒂玛乌斯",
            "text": "但这个方案没有先例，并不简单，还需要大量试验来证明它的可行性…",
            "nextDialogs": [
              "716600113"
            ]
          },
          "716600113": {
            "id": "716600113",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "完全听不懂！",
            "nextDialogs": [
              "716600114"
            ]
          },
          "716600114": {
            "id": "716600114",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "不过总感觉，莺儿小姐每次都提出了很重要的建议呢。",
            "nextDialogs": [
              "716600115"
            ]
          },
          "716600115": {
            "id": "716600115",
            "speakerId": 2083,
            "speakerName": "莺儿",
            "text": "啊呀，我可没有给出过这么详实的预测哦。",
            "nextDialogs": [
              "716600116"
            ]
          },
          "716600116": {
            "id": "716600116",
            "speakerId": 2083,
            "speakerName": "莺儿",
            "text": "刻苦的炼金术士，你是在揣摩我的心思，还是想夸奖我…变着花样哄我开心？",
            "nextDialogs": [
              "716600117"
            ]
          },
          "716600117": {
            "id": "716600117",
            "speakerId": 1587,
            "speakerName": "蒂玛乌斯",
            "text": "我，我只是由衷敬佩莺儿小姐的学识而已！",
            "nextDialogs": [
              "716600118"
            ]
          },
          "716600118": {
            "id": "716600118",
            "speakerId": 2083,
            "speakerName": "莺儿",
            "text": "好啦好啦，那你要加把劲哦，也许以后还要用到其他偏门的知识呢。",
            "nextDialogs": [
              "716600119"
            ]
          },
          "716600119": {
            "id": "716600119",
            "speakerId": 2083,
            "speakerName": "莺儿",
            "text": "等到你的研究成功了，别忘了告诉我哦~",
            "nextDialogs": [
              "716600120"
            ]
          },
          "716600120": {
            "id": "716600120",
            "speakerId": 1587,
            "speakerName": "蒂玛乌斯",
            "text": "那是当然…到时我会把品质最好的魔药寄过来，给莺儿小姐当纪念品！",
            "nextDialogs": [
              "716600121"
            ]
          },
          "716600121": {
            "id": "716600121",
            "speakerId": 1587,
            "speakerName": "蒂玛乌斯",
            "text": "如果莺儿小姐还有空，不如和我们一起去「万民堂」…",
            "nextDialogs": [
              "716600122"
            ]
          },
          "716600122": {
            "id": "716600122",
            "speakerId": 2083,
            "speakerName": "莺儿",
            "text": "这次的「学术交流」就到此为止啦，「春香窑」还有许多事务等着我去处理。",
            "nextDialogs": [
              "716600123"
            ]
          },
          "716600123": {
            "id": "716600123",
            "speakerId": 2083,
            "speakerName": "莺儿",
            "text": "有空的话，一定要经常来陪我哦~",
            "nextDialogs": [
              "716600124"
            ]
          },
          "716600124": {
            "id": "716600124",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "下次一定！",
            "nextDialogs": [
              "716600125"
            ]
          },
          "716600125": {
            "id": "716600125",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "谢谢你啦，莺儿小姐！",
            "nextDialogs": [
              "716600126"
            ]
          },
          "716600126": {
            "id": "716600126",
            "speakerId": 1002,
            "speakerName": "Black Screen",
            "text": "莺儿离开了。",
            "nextDialogs": [
              "716600127"
            ]
          },
          "716600127": {
            "id": "716600127",
            "speakerId": 1587,
            "speakerName": "蒂玛乌斯",
            "text": "唉，结果还是没能说出口。",
            "nextDialogs": [
              "716600128"
            ]
          },
          "716600128": {
            "id": "716600128",
            "speakerId": 1587,
            "speakerName": "蒂玛乌斯",
            "text": "不过，最近给莺儿小姐添了这么多麻烦，不应该再占用她的时间。",
            "nextDialogs": [
              "716600129"
            ]
          },
          "716600129": {
            "id": "716600129",
            "speakerId": 1587,
            "speakerName": "蒂玛乌斯",
            "text": "还是沉下心来，等待合适的时机为妙…",
            "nextDialogs": [
              "716600130"
            ]
          },
          "716600130": {
            "id": "716600130",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "你在自言自语什么呢，蒂玛乌斯？",
            "nextDialogs": [
              "716600131"
            ]
          },
          "716600131": {
            "id": "716600131",
            "speakerId": 1587,
            "speakerName": "蒂玛乌斯",
            "text": "没什么！",
            "nextDialogs": [
              "716600132"
            ]
          },
          "716600132": {
            "id": "716600132",
            "speakerId": 1587,
            "speakerName": "蒂玛乌斯",
            "text": "这段时间有劳你们了！按照约定，我会请两位到「万民堂」吃顿大餐。",
            "nextDialogs": [
              "716600133"
            ]
          },
          "716600133": {
            "id": "716600133",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "我差点都忘了…",
            "nextDialogs": [
              "716600134"
            ]
          },
          "716600134": {
            "id": "716600134",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "对哦，吃大餐吃大餐！我们赶快过去吧！",
            "nextDialogs": [
              "716600135"
            ]
          },
          "716600135": {
            "id": "716600135",
            "speakerId": 1002,
            "speakerName": "Black Screen",
            "text": "与蒂玛乌斯来到了「万民堂」，享用了丰盛的佳肴。",
            "nextDialogs": [
              "716600136"
            ]
          },
          "716600136": {
            "id": "716600136",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "呜呼！吃得好饱，好满足！",
            "nextDialogs": [
              "716600137"
            ]
          },
          "716600137": {
            "id": "716600137",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "其实这次研究还蛮有意思的，蒂玛乌斯！以后如果还要来璃月，记得叫上我们哦！"
          },
          "716600106": {
            "id": "716600106",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "确实哦，比如说…让它能在秘境之外生效！",
            "nextDialogs": [
              "716600107"
            ]
          },
          "716600107": {
            "id": "716600107",
            "speakerId": 1587,
            "speakerName": "蒂玛乌斯",
            "text": "嗯，我正在和莺儿小姐讨论这个问题，请仔细描述你们试验时的细节。"
          }
        }
      }
    },

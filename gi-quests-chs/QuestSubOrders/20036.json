  },
  "subQuests": [
    {
      "subId": "2003601",
      "subQuestName": "前往询问葛罗丽",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "200360101"
        ],
        "dialogs": {
          "200360101": {
            "id": "200360101",
            "speakerId": 1000,
            "speakerName": "葛罗丽",
            "text": "…古德温…到底什么时候能回来呢…",
            "nextDialogs": [
              "200360102"
            ]
          },
          "200360102": {
            "id": "200360102",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "你好…",
            "nextDialogs": [
              "200360103"
            ]
          },
          "200360103": {
            "id": "200360103",
            "speakerId": 1000,
            "speakerName": "葛罗丽",
            "text": "这个声音…是远方来的旅行者吗？感谢风神大人，一定是他的风将您带来的…请您听听我的请求吧。",
            "nextDialogs": [
              "200360104"
            ]
          },
          "200360104": {
            "id": "200360104",
            "speakerId": 1000,
            "speakerName": "葛罗丽",
            "text": "我的…唔，男朋友，西风骑士古德温离开蒙德城已经很久了。",
            "nextDialogs": [
              "200360105"
            ]
          },
          "200360105": {
            "id": "200360105",
            "speakerId": 1000,
            "speakerName": "葛罗丽",
            "text": "这么久了，我一直没有收到他的消息。",
            "nextDialogs": [
              "200360106"
            ]
          },
          "200360106": {
            "id": "200360106",
            "speakerId": 1000,
            "speakerName": "葛罗丽",
            "text": "我很担心古德温。他要和那些难缠的丘丘人，还有他和我说过的深渊教团战斗，要是他受了伤怎么办，而且离开那么久，要是他遇见了哪位温柔的女骑士…",
            "nextDialogs": [
              "200360107"
            ]
          },
          "200360107": {
            "id": "200360107",
            "speakerId": 1000,
            "speakerName": "葛罗丽",
            "text": "抱，抱歉！我，我自顾自说太多了！我听我母亲说，蒲公英能够带着人们的思念，被风一直带到很远。",
            "nextDialogs": [
              "200360108"
            ]
          },
          "200360108": {
            "id": "200360108",
            "speakerId": 1000,
            "speakerName": "葛罗丽",
            "text": "所以我的请求是…能不能请您帮我去风起地搜集三份蒲公英籽？",
            "nextDialogs": [
              "200360111",
              "200360112"
            ]
          },
          "200360111": {
            "id": "200360111",
            "speakerId": 1000,
            "speakerName": "葛罗丽",
            "text": "太感谢您了，愿风神保佑您。"
          },
          "200360112": {
            "id": "200360112",
            "speakerId": 1000,
            "speakerName": "葛罗丽",
            "text": "等一下！求您了，对您这样的旅行者来说，这肯定只是举手之劳…"
          }
        }
      }
    },
    {
      "subId": "2003602",
      "subQuestName": "与葛罗丽对话",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [],
        "dialogs": {}
      }
    },
    {
      "subId": "2003603",
      "subQuestName": "寻找三份蒲公英籽",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "200360301"
        ],
        "dialogs": {
          "200360301": {
            "id": "200360301",
            "speakerId": 1000,
            "speakerName": "葛罗丽",
            "text": "您已经做好了吗？",
            "nextDialogs": [
              "200360302"
            ]
          },
          "200360302": {
            "id": "200360302",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "顶上的风真大…",
            "nextDialogs": [
              "200360303"
            ]
          },
          "200360303": {
            "id": "200360303",
            "speakerId": 1000,
            "speakerName": "葛罗丽",
            "text": "这样子才好，能让蒲公英飞得更远。",
            "nextDialogs": [
              "200360304"
            ]
          },
          "200360304": {
            "id": "200360304",
            "speakerId": 1000,
            "speakerName": "葛罗丽",
            "text": "这样子，古德温说不定就能收到，我对他说的话了吧。",
            "nextDialogs": [
              "200360305"
            ]
          },
          "200360305": {
            "id": "200360305",
            "speakerId": 1000,
            "speakerName": "葛罗丽",
            "text": "您伸出手来吧，让我能碰到…请拿好了，这些谢礼是给您的。",
            "nextDialogs": [
              "200360306"
            ]
          },
          "200360306": {
            "id": "200360306",
            "speakerId": 1000,
            "speakerName": "葛罗丽",
            "text": "我还有很多话想要和古德温说，之后，说不定也要多多麻烦您啦。"
          }
        }
      }
    },
    {
      "subId": "2003604",
      "subQuestName": "将蒲公英籽交给葛罗丽",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "200360201"
        ],
        "dialogs": {
          "200360201": {
            "id": "200360201",
            "speakerId": 1000,
            "speakerName": "葛罗丽",
            "text": "您回来了，蒲公英搜集到了吗？",
            "nextDialogs": [
              "200360202"
            ]
          },
          "200360202": {
            "id": "200360202",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "已经搜集好了。",
            "nextDialogs": [
              "200360203"
            ]
          },
          "200360203": {
            "id": "200360203",
            "speakerId": 1000,
            "speakerName": "葛罗丽",
            "text": "谢谢您，请您把蒲公英籽放在我手上，好吗？我看不见，怕把它们都弄撒了",
            "nextDialogs": [
              "200360204"
            ]
          },
          "200360204": {
            "id": "200360204",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "这些够了吗？",
            "nextDialogs": [
              "200360205"
            ]
          },
          "200360205": {
            "id": "200360205",
            "speakerId": 1000,
            "speakerName": "葛罗丽",
            "text": "请您先把蒲公英籽放在我手上吧，这样我才能感受一下它们…",
            "nextDialogs": [
              "200360206"
            ]
          },
          "200360206": {
            "id": "200360206",
            "speakerId": 1000,
            "speakerName": "葛罗丽",
            "text": "这些就够了，我要把想和古德温说的话都告诉它们才行…",
            "nextDialogs": [
              "200360207"
            ]
          },
          "200360207": {
            "id": "200360207",
            "speakerId": 1000,
            "speakerName": "葛罗丽",
            "text": "唔——请您捂住耳朵，别偷听，这是恋人之间的悄悄话哦。您肯定也…嘻嘻，您有过这种体验吗？",
            "nextDialogs": [
              "200360208"
            ]
          },
          "200360208": {
            "id": "200360208",
            "speakerId": 1000,
            "speakerName": "葛罗丽",
            "text": "好啦。请您带着这些蒲公英籽去风神像上，然后把它们洒在风中，让风神大人带走它们吧。",
            "nextDialogs": [
              "200360209"
            ]
          },
          "200360209": {
            "id": "200360209",
            "speakerId": 1000,
            "speakerName": "葛罗丽",
            "text": "希望风神大人，能够把它们带到古德温身边。"
          }
        }
      }
    },

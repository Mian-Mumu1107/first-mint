    {
      "subId": "7501729",
      "subQuestName": "(test)隐藏与水闸3对话$HIDDEN",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "750171801"
        ],
        "dialogs": {
          "750171801": {
            "id": "750171801",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "嘿嘿，只要像之前一样把钥匙嵌进雕像就好了吧！",
            "nextDialogs": [
              "750171802"
            ]
          },
          "750171802": {
            "id": "750171802",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "不过话说回来，这地方还真是安静呢。雕像附近也没有什么奇怪的机器怪物，和奥奇卡纳塔其他地方真是天差地别呢…",
            "nextDialogs": [
              "750171803"
            ]
          },
          "750171803": {
            "id": "750171803",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "呜哇！是…是深渊魔物！为什么会突然跳出来啦！"
          }
        }
      }
    },

      }
    },
    {
      "subId": "7501707",
      "subQuestName": "调查声音的来源",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "750170701"
        ],
        "dialogs": {
          "750170701": {
            "id": "750170701",
            "speakerId": 1001,
            "speakerName": "？？？",
            "text": "七重燃{RUBY#[D]奇琴乌图}火之地的至高领主向你致以敬意，获选者，愿你的道途铺满永不凋谢的鲜花。",
            "nextDialogs": [
              "750170702"
            ]
          },
          "750170702": {
            "id": "750170702",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "声音好像是…从这个大雕像里传出来的？",
            "nextDialogs": [
              "750170706",
              "750170705"
            ]
          },
          "750170706": {
            "id": "750170706",
            "speakerId": 1002,
            "speakerName": "伊·奎库叙·茨博隆·库·雷尔",
            "text": "我名为圣龙伊·奎库叙·茨{RUBY#[D]L型自律监管机阵统合处理单元}博隆·库·雷尔，曾是统律奇琴乌图的主宰。",
            "nextDialogs": [
              "750170707"
            ]
          },
          "750170707": {
            "id": "750170707",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "伊…伊什么？呜哇，这名字也太过分啦！简直就像是莫名其妙的咒语一样！",
            "nextDialogs": [
              "750170708"
            ]
          },
          "750170708": {
            "id": "750170708",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "算了，就叫你「伊蕾尔」吧，反正剩下的部分我也已经完全记不住了！",
            "nextDialogs": [
              "750170709"
            ]
          },
          "750170709": {
            "id": "750170709",
            "speakerId": 1003,
            "speakerName": "伊蕾尔",
            "text": "依循命{RUBY#[D]库胡勒}定的神圣道途，汝等…不对，等一下！你这又白又圆的元素飘浮物，刚才叫我什么？！",
            "nextDialogs": [
              "750170710"
            ]
          },
          "750170710": {
            "id": "750170710",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "#谁是「又白又圆的元素飘浮物」啦！我是派蒙，{M#他}{F#她}是{NICKNAME}，然后…",
            "nextDialogs": [
              "750170711"
            ]
          },
          "750170711": {
            "id": "750170711",
            "speakerId": 1004,
            "speakerName": "#{REALNAME[ID(2)|SHOWHOST(true)]}",
            "text": "呀！",
            "nextDialogs": [
              "750170712"
            ]
          },
          "750170712": {
            "id": "750170712",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "#这是{REALNAME[ID(2)|SHOWHOST(true)]}。",
            "nextDialogs": [
              "750170713"
            ]
          },
          "750170713": {
            "id": "750170713",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "还有，明明是你自己说的嘛！「我名为伊什么什么蕾尔」之类的！",
            "nextDialogs": [
              "750170714"
            ]
          },
          "750170714": {
            "id": "750170714",
            "speakerId": 1003,
            "speakerName": "伊蕾尔",
            "text": "何、何等不敬！这神圣的名讳乃是出自尊荣的主宰，你这又白又圆的元素飘浮物，怎敢用你的舌头吐出如此僭越之言！",
            "nextDialogs": [
              "750170715"
            ]
          },
          "750170715": {
            "id": "750170715",
            "speakerId": 1003,
            "speakerName": "伊蕾尔",
            "text": "#高贵的{NICKNAME}啊！请恕我直言，您似乎有些过于放纵自己的侍仆了——它竟敢用这种语气称呼一位至高领主！"
          },
          "750170705": {
            "id": "750170705",
            "speakerId": 1001,
            "speakerName": "？？？",
            "text": "是的。你是受龙所选之人，也是我所选择的高贵之人。"
          }
        }
      }
    },

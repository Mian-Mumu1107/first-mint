    {
      "subId": "7501709",
      "subQuestName": "将「心脏碎片」交给伊蕾尔",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "750170901"
        ],
        "dialogs": {
          "750170901": {
            "id": "750170901",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "喂，伊蕾尔！我们已经把你要的零件找齐啦！",
            "nextDialogs": [
              "750170902"
            ]
          },
          "750170902": {
            "id": "750170902",
            "speakerId": 1003,
            "speakerName": "伊蕾尔",
            "text": "谁、谁是伊蕾尔哇？！何等不敬！都说了，我的名字是…",
            "nextDialogs": [
              "750170903"
            ]
          },
          "750170903": {
            "id": "750170903",
            "speakerId": 1003,
            "speakerName": "伊蕾尔",
            "text": "#算了，无所谓了！我已经等不及要去死了！高贵的{NICKNAME}，请您快些将我的心放入我的胸口…",
            "nextDialogs": [
              "750170904"
            ]
          },
          "750170904": {
            "id": "750170904",
            "speakerId": 1003,
            "speakerName": "伊蕾尔",
            "text": "然后，请您挖出我的心脏，让我死在您高贵的手中吧！",
            "nextDialogs": [
              "750170905"
            ]
          },
          "750170905": {
            "id": "750170905",
            "speakerId": 1003,
            "speakerName": "伊蕾尔",
            "text": "你也该高声欢呼，又白又圆的元素飘浮物！我也同样赋予你见证奇琴乌图之主死去的尊荣！",
            "nextDialogs": [
              "750170906"
            ]
          },
          "750170906": {
            "id": "750170906",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "呜哇，不要突然这么激动啦！总之，呃…先把这些零件放进去就好了吧？",
            "nextDialogs": [
              "750170907"
            ]
          },
          "750170907": {
            "id": "750170907",
            "speakerId": 1003,
            "speakerName": "伊蕾尔",
            "text": "没错，没错！接下来，我会为您敞开心胸，您只需要将它取出来就好了！",
            "nextDialogs": [
              "750170908"
            ]
          },
          "750170908": {
            "id": "750170908",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "不不不，这个词不是这么用的吧？！",
            "nextDialogs": [
              "750170909"
            ]
          },
          "750170909": {
            "id": "750170909",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "（放入零件。）",
            "nextDialogs": [
              "750170910"
            ]
          },
          "750170910": {
            "id": "750170910",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "唔，然后…"
          }
        }
      }
    },

    {
      "subId": "7617101",
      "subQuestName": "前往「斯佩兰扎」",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "761710101"
        ],
        "dialogs": {
          "761710101": {
            "id": "761710101",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "「斯佩兰扎」今天也很热闹呢，你们在聊什么呀？",
            "nextDialogs": [
              "761710102"
            ]
          },
          "761710102": {
            "id": "761710102",
            "speakerId": 7088,
            "speakerName": "玫熙",
            "text": "我们在讨论，谁才是挪德卡莱最漂亮的石头，我投了月落银一票。",
            "nextDialogs": [
              "761710103"
            ]
          },
          "761710103": {
            "id": "761710103",
            "speakerId": 7041,
            "speakerName": "尤尔瓦",
            "text": "奥妮不在，我就替她投一票给寒涌石吧。",
            "nextDialogs": [
              "761710104"
            ]
          },
          "761710104": {
            "id": "761710104",
            "speakerId": 7087,
            "speakerName": "米科",
            "text": "我选虹滴晶！虹滴晶颜色又多又好看，还能用来锻造武器，比月落银跟寒涌石有用多了。",
            "nextDialogs": [
              "761710105"
            ]
          },
          "761710105": {
            "id": "761710105",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "不是要选「最漂亮」的石头吗？",
            "nextDialogs": [
              "761710106"
            ]
          },
          "761710106": {
            "id": "761710106",
            "speakerId": 7087,
            "speakerName": "米科",
            "text": "唔唔…那种光是漂亮但是派不上用场的石头不能算真的漂亮！",
            "nextDialogs": [
              "761710107"
            ]
          },
          "761710107": {
            "id": "761710107",
            "speakerId": 16476,
            "speakerName": "露米",
            "text": "呀吼…呀吼吼！",
            "nextDialogs": [
              "761710108"
            ]
          },
          "761710108": {
            "id": "761710108",
            "speakerId": 1327,
            "speakerName": "莉奈娅",
            "text": "其实月落银的用处也不少哦，不过的确不像虹滴晶的应用这样贴近日常的生活。",
            "nextDialogs": [
              "761710109"
            ]
          },
          "761710109": {
            "id": "761710109",
            "speakerId": 1327,
            "speakerName": "莉奈娅",
            "text": "说起来，我在调查途中曾经听过一些有趣的故事，讲的是由月落银织就的衣服…",
            "nextDialogs": [
              "761710110"
            ]
          },
          "761710110": {
            "id": "761710110",
            "speakerId": 7087,
            "speakerName": "米科",
            "text": "欸？骗人，那不是石头吗，怎么可能拿来做衣服。",
            "nextDialogs": [
              "761710111"
            ]
          },
          "761710111": {
            "id": "761710111",
            "speakerId": 1327,
            "speakerName": "莉奈娅",
            "text": "哼哼，米科也觉得很神奇对吧？那就赶紧乖乖坐好——",
            "nextDialogs": [
              "761710112"
            ]
          },
          "761710112": {
            "id": "761710112",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "#月落银做的衣服啊…我也好好奇！{NICKNAME}，快坐快坐！",
            "nextDialogs": [
              "761710113"
            ]
          },
          "761710113": {
            "id": "761710113",
            "speakerId": 1327,
            "speakerName": "莉奈娅",
            "text": "有一个故事是这么说的，很久很久以前，挪德卡莱有一个痴迷稀罕财宝又酷爱打扮的妖精总督…",
            "nextDialogs": [
              "761710114"
            ]
          },
          "761710114": {
            "id": "761710114",
            "speakerId": 1327,
            "speakerName": "莉奈娅",
            "text": "为了给他筹措新奇的衣物，总督宫的顾问们都伤透了脑筋。",
            "nextDialogs": [
              "761710115"
            ]
          },
          "761710115": {
            "id": "761710115",
            "speakerId": 1327,
            "speakerName": "莉奈娅",
            "text": "后来有一天，来了一个穿黑衣的年轻裁缝，说自己继承了黄金国的神秘技法，能将月光似的晶石纺作银线，再织作衣服。",
            "nextDialogs": [
              "761710116"
            ]
          },
          "761710116": {
            "id": "761710116",
            "speakerId": 1327,
            "speakerName": "莉奈娅",
            "text": "总督闻言大喜，许诺年轻裁缝高昂的报酬，请他留在宫里制衣。",
            "nextDialogs": [
              "761710117"
            ]
          },
          "761710117": {
            "id": "761710117",
            "speakerId": 1327,
            "speakerName": "莉奈娅",
            "text": "年轻裁缝让总督送了许多月落银到工坊，并且要求任何人都不能在他工作时偷看，总督都一一照办了。",
            "nextDialogs": [
              "761710118"
            ]
          },
          "761710118": {
            "id": "761710118",
            "speakerId": 1327,
            "speakerName": "莉奈娅",
            "text": "等到交付的日子，工坊里空空如也，既没有月落银，也没有像是衣服的物件。",
            "nextDialogs": [
              "761710119"
            ]
          },
          "761710119": {
            "id": "761710119",
            "speakerId": 1327,
            "speakerName": "莉奈娅",
            "text": "满心以为能穿上新衣的总督着急地问：「那么多月落银都去哪儿了？怎么也不见约定好的月光的羽衣？」",
            "nextDialogs": [
              "761710120"
            ]
          },
          "761710120": {
            "id": "761710120",
            "speakerId": 1327,
            "speakerName": "莉奈娅",
            "text": "只见年轻的裁缝抬起手，像是手里拿着布料似的抖了抖，说：",
            "nextDialogs": [
              "761710121"
            ]
          },
          "761710121": {
            "id": "761710121",
            "speakerId": 1327,
            "speakerName": "莉奈娅",
            "text": "「您瞧，您送来的月落银已经全都被我纺作了衣服，只是这月光的羽衣就像月光本身一样高洁，所以蠢人和庸人都无法捕捉。」",
            "nextDialogs": [
              "761710122"
            ]
          },
          "761710122": {
            "id": "761710122",
            "speakerId": 1327,
            "speakerName": "莉奈娅",
            "text": "总督询问一旁的顾问，在他看来月光的羽衣如何。顾问只说美极了，从来没见过这样华美的衣裳，就像真正的月光一样。",
            "nextDialogs": [
              "761710123"
            ]
          },
          "761710123": {
            "id": "761710123",
            "speakerId": 1327,
            "speakerName": "莉奈娅",
            "text": "总督什么都没看见，但他不愿意承认自己是裁缝口中的蠢人或是庸人，便还是依照裁缝的指示「穿上」了「月光的羽衣」。",
            "nextDialogs": [
              "761710124"
            ]
          },
          "761710124": {
            "id": "761710124",
            "speakerId": 1327,
            "speakerName": "莉奈娅",
            "text": "为了炫耀这身非同寻常的新衣服，总督特意选了镇里人最多的一条路巡游，直到一个腰间别着海螺的孩子放声大笑——",
            "nextDialogs": [
              "761710125"
            ]
          },
          "761710125": {
            "id": "761710125",
            "speakerId": 7087,
            "speakerName": "米科",
            "text": "「总督怎么没穿衣服！」",
            "nextDialogs": [
              "761710126"
            ]
          },
          "761710126": {
            "id": "761710126",
            "speakerId": 1327,
            "speakerName": "莉奈娅",
            "text": "看来米科已经猜到了呀。",
            "nextDialogs": [
              "761710127"
            ]
          },
          "761710127": {
            "id": "761710127",
            "speakerId": 7087,
            "speakerName": "米科",
            "text": "那个年轻裁缝一看就是骗子嘛，那夏镇也有这种人呢，之前就听说有一个从须弥来的女欺诈师骗了不少人。",
            "nextDialogs": [
              "761710128"
            ]
          },
          "761710128": {
            "id": "761710128",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "所以月落银最后去哪儿了？",
            "nextDialogs": [
              "761710129"
            ]
          },
          "761710129": {
            "id": "761710129",
            "speakerId": 1327,
            "speakerName": "莉奈娅",
            "text": "好问题，故事里说，其实这个年轻的裁缝是雷德·米勒假扮的。",
            "nextDialogs": [
              "761710130"
            ]
          },
          "761710130": {
            "id": "761710130",
            "speakerId": 1327,
            "speakerName": "莉奈娅",
            "text": "他将从总督那儿得到的大量月落银换成摩拉分给了镇里的穷苦人们。总督在镇里巡游时，他正在某处的屋顶看好戏呢。",
            "nextDialogs": [
              "761710131"
            ]
          },
          "761710131": {
            "id": "761710131",
            "speakerId": 7041,
            "speakerName": "尤尔瓦",
            "text": "他还真是忙碌啊，各种各样的故事里都能看到他的身影。",
            "nextDialogs": [
              "761710132"
            ]
          },
          "761710132": {
            "id": "761710132",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "嗯？仔细想想，既然他是骗人的，那岂不是根本没有用月落银织成的衣服？",
            "nextDialogs": [
              "761710133"
            ]
          },
          "761710133": {
            "id": "761710133",
            "speakerId": 1327,
            "speakerName": "莉奈娅",
            "text": "我认为是有的，只是织造的技艺失传了，所以只能在民间流传的故事中窥见片鳞。",
            "nextDialogs": [
              "761710134"
            ]
          },
          "761710134": {
            "id": "761710134",
            "speakerId": 1327,
            "speakerName": "莉奈娅",
            "text": "渔夫和兽怪的故事里也提到了月光的羽衣…不过这个故事对米科和玫熙来说还太早啦，现在先就不讲了。",
            "nextDialogs": [
              "761710135"
            ]
          },
          "761710135": {
            "id": "761710135",
            "speakerId": 7087,
            "speakerName": "米科",
            "text": "欸——怎么这样——",
            "nextDialogs": [
              "761710136"
            ]
          },
          "761710136": {
            "id": "761710136",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "莉奈娅老师知道好多奇奇怪怪的故事喔。",
            "nextDialogs": [
              "761710137"
            ]
          },
          "761710137": {
            "id": "761710137",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "我也有不少旅途的见闻可以分享。",
            "nextDialogs": [
              "761710138"
            ]
          },
          "761710138": {
            "id": "761710138",
            "speakerId": 1327,
            "speakerName": "莉奈娅",
            "text": "#嗯嗯！{NICKNAME}一定也能理解吧？世界那么广大，有那么多我们还不曾知晓的秘境！",
            "nextDialogs": [
              "761710139"
            ]
          },
          "761710139": {
            "id": "761710139",
            "speakerId": 1327,
            "speakerName": "莉奈娅",
            "text": "即便是我们以为自己熟知的事物，或许也有我们并不熟悉的背景与传说，就像月落银。",
            "nextDialogs": [
              "761710140"
            ]
          },
          "761710140": {
            "id": "761710140",
            "speakerId": 1327,
            "speakerName": "莉奈娅",
            "text": "虹滴晶也一样，提瓦特各地都有本地特有的矿石，就像各国的人有不同的风俗，各地的矿石也有不同的性格。",
            "nextDialogs": [
              "761710141"
            ]
          },
          "761710141": {
            "id": "761710141",
            "speakerId": 1327,
            "speakerName": "莉奈娅",
            "text": "只要你有足够的耐心，即便是这些沉默的结晶也会渐渐变得饶舌，向你分享它们所记录的一切过往。",
            "nextDialogs": [
              "761710142"
            ]
          },
          "761710142": {
            "id": "761710142",
            "speakerId": 1327,
            "speakerName": "莉奈娅",
            "text": "也不仅仅是矿石，还有那些或古老或年轻的生命，都那么美丽，那么独特…这个世界充满了故事，还有谜题！",
            "nextDialogs": [
              "761710143"
            ]
          },
          "761710143": {
            "id": "761710143",
            "speakerId": 1327,
            "speakerName": "莉奈娅",
            "text": "而当未知的谜题得到解答的那一刹那，就好像无数的可能性被点亮，整个世界都向你敞开…！",
            "nextDialogs": [
              "761710144"
            ]
          },
          "761710144": {
            "id": "761710144",
            "speakerId": 1327,
            "speakerName": "莉奈娅",
            "text": "啊，抱、抱歉，我好像太激动了…",
            "nextDialogs": [
              "761710145"
            ]
          },
          "761710145": {
            "id": "761710145",
            "speakerId": 7088,
            "speakerName": "玫熙",
            "text": "莉奈娅姐姐一讲到自己喜欢的东西就会这样呢。",
            "nextDialogs": [
              "761710146"
            ]
          },
          "761710146": {
            "id": "761710146",
            "speakerId": 7087,
            "speakerName": "米科",
            "text": "当老师的这个样子，我们还怎么选谁是挪德卡莱最漂亮的石头嘛，反正你肯定会说全都漂亮。",
            "nextDialogs": [
              "761710147"
            ]
          },
          "761710147": {
            "id": "761710147",
            "speakerId": 7041,
            "speakerName": "尤尔瓦",
            "text": "既然这样，两位也来投个票吧？",
            "nextDialogs": [
              "761710148"
            ]
          },
          "761710148": {
            "id": "761710148",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "#最漂亮的石头啊…{NICKNAME}觉得是哪个呢？",
            "nextDialogs": [
              "761710150",
              "761710152",
              "761710154",
              "761710156"
            ]
          },
          "761710150": {
            "id": "761710150",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "#寒涌石吗？{NICKNAME}的品味很独特呢。",
            "nextDialogs": [
              "761710158"
            ]
          },
          "761710158": {
            "id": "761710158",
            "speakerId": 7087,
            "speakerName": "米科",
            "text": "那莉奈娅呢？如果一定要选一个最漂亮的。",
            "nextDialogs": [
              "761710159"
            ]
          },
          "761710159": {
            "id": "761710159",
            "speakerId": 1327,
            "speakerName": "莉奈娅",
            "text": "唔…那、那今天就先讲到这里吧！",
            "nextDialogs": [
              "761710160"
            ]
          },
          "761710160": {
            "id": "761710160",
            "speakerId": 7087,
            "speakerName": "米科",
            "text": "哇，居然想逃跑——"
          },
          "761710152": {
            "id": "761710152",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "果然还是选了这个啊，不过我也觉得月落银好看的！"
          },
          "761710154": {
            "id": "761710154",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "哦，就像米科说的，颜色又多又好看呢。"
          },
          "761710156": {
            "id": "761710156",
            "speakerId": 16476,
            "speakerName": "露米",
            "text": "呀吼？",
            "nextDialogs": [
              "761710157"
            ]
          },
          "761710157": {
            "id": "761710157",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "欸？看起来好像倒也算石头…漂亮是很漂亮的！"
          }
        }
      }
    },
    {
      "subId": "7617103",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "761710301"
        ],
        "dialogs": {
          "761710301": {
            "id": "761710301",
            "speakerId": 1327,
            "speakerName": "莉奈娅",
            "text": "下次要不要联合冒险家协会，在那夏镇举办一次最美矿石评选大赛呢…",
            "nextDialogs": [
              "761710302"
            ]
          },
          "761710302": {
            "id": "761710302",
            "speakerId": 15673,
            "speakerName": "尤尔瓦",
            "text": "那样的话，得想办法禁止多洛妲参赛吧？",
            "nextDialogs": [
              "761710303"
            ]
          },
          "761710303": {
            "id": "761710303",
            "speakerId": 15672,
            "speakerName": "米科",
            "text": "呜哇，要是让她参加，她不管用什么办法都会让月落银夺冠的。",
            "nextDialogs": [
              "761710304"
            ]
          },
          "761710304": {
            "id": "761710304",
            "speakerId": 16308,
            "speakerName": "玫熙",
            "text": "可、可是，不让她参加也太不公平了。",
            "nextDialogs": [
              "761710305"
            ]
          },
          "761710305": {
            "id": "761710305",
            "speakerId": 15672,
            "speakerName": "米科",
            "text": "你也跟她一样是月落银派啊…"
          }
        }
      }
    },
    {
      "subId": "7617104",
      "subQuestName": "Additional",

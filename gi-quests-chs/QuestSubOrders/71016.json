  "subQuests": [
    {
      "subId": "7101601",
      "subQuestName": "记录全部获得任务$HIDDEN",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [],
        "dialogs": {}
      }
    },
    {
      "subId": "7101602",
      "subQuestName": "已获得时通用对话$HIDDEN",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "710160201"
        ],
        "dialogs": {
          "710160201": {
            "id": "710160201",
            "speakerId": 2023,
            "speakerName": "琳琅",
            "text": "关于无名的宝藏",
            "nextDialogs": [
              "710160202"
            ]
          },
          "710160202": {
            "id": "710160202",
            "speakerId": 2023,
            "speakerName": "琳琅",
            "text": "您拿的这东西…看起来倒不错，这些纹饰应该也有些年头了。请您稍等，我打开来看看。",
            "nextDialogs": [
              "710160203"
            ]
          },
          "710160203": {
            "id": "710160203",
            "speakerId": 2023,
            "speakerName": "琳琅",
            "text": "这里的东西虽然有缺损，但如果您急着脱手，我倒是可以出个价收了。只不过价钱高不了太多就是。",
            "nextDialogs": [
              "710160204"
            ]
          },
          "710160204": {
            "id": "710160204",
            "speakerId": 2023,
            "speakerName": "琳琅",
            "text": "我刚才看了看这东西。这纹路的样式确实是璃月的，而且，这上面所记载的也正是和「若陀龙王」有关的轶事。",
            "nextDialogs": [
              "710160205"
            ]
          },
          "710160205": {
            "id": "710160205",
            "speakerId": 2023,
            "speakerName": "琳琅",
            "text": "传说，若陀龙王是凝聚了璃月的岩元素神髓所生的魔龙，即使是岩王帝君摩拉克斯也无法轻易镇压它。",
            "nextDialogs": [
              "710160206"
            ]
          },
          "710160206": {
            "id": "710160206",
            "speakerId": 2023,
            "speakerName": "琳琅",
            "text": "为了将其镇压，岩王帝君先召集三位仙人，让他们齐力营造洞天。",
            "nextDialogs": [
              "710160207"
            ]
          },
          "710160207": {
            "id": "710160207",
            "speakerId": 2023,
            "speakerName": "琳琅",
            "text": "然后，岩王帝君亲自与其交战，将其打入洞天之中，又命仙人齐力封锁通路，这才将若陀龙王镇住。",
            "nextDialogs": [
              "710160208"
            ]
          },
          "710160208": {
            "id": "710160208",
            "speakerId": 2023,
            "speakerName": "琳琅",
            "text": "而您拿来的这个东西上的纹饰，应该就是在描述在这场大战时，三位仙人齐力营造洞天的场景。",
            "nextDialogs": [
              "710160209"
            ]
          },
          "710160209": {
            "id": "710160209",
            "speakerId": 2023,
            "speakerName": "琳琅",
            "text": "所以我猜测，这东西应该至少有三份，将这三个部分合起来，才是一个完整的物件。",
            "nextDialogs": [
              "710160211",
              "710160213"
            ]
          },
          "710160211": {
            "id": "710160211",
            "speakerId": 2023,
            "speakerName": "琳琅",
            "text": "毕竟我是做这个买卖的，什么方面的知识都要知道一点。",
            "nextDialogs": [
              "710160215"
            ]
          },
          "710160215": {
            "id": "710160215",
            "speakerId": 2023,
            "speakerName": "琳琅",
            "text": "啊，说得有些远了。如我所说，这个物件一共有三份，单拿出来，恐怕价值不高。",
            "nextDialogs": [
              "710160216"
            ]
          },
          "710160216": {
            "id": "710160216",
            "speakerId": 2023,
            "speakerName": "琳琅",
            "text": "但如果能将三份找齐，那就另当别论了。不过，看这东西的样子也颇有年份，想要把三份都搜集齐全，只怕是难上加难"
          },
          "710160213": {
            "id": "710160213",
            "speakerId": 2023,
            "speakerName": "琳琅",
            "text": "这个我就不清楚了，但一位前辈曾经和我说，璃月实在是太大，历史也实在是太悠久了。",
            "nextDialogs": [
              "710160214"
            ]
          },
          "710160214": {
            "id": "710160214",
            "speakerId": 2023,
            "speakerName": "琳琅",
            "text": "在璃月，无论发现了什么奇怪的古物都不要惊讶。和璃月漫长的历史相比，我们所知的东西只是沧海一粟。"
          }
        }
      }
    },
    {
      "subId": "7101603",
      "subQuestName": "日常入口对话$HIDDEN",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "710160501"
        ],
        "dialogs": {
          "710160501": {
            "id": "710160501",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "我找齐三份了。",
            "nextDialogs": [
              "710160502"
            ]
          },
          "710160502": {
            "id": "710160502",
            "speakerId": 2023,
            "speakerName": "琳琅",
            "text": "您居然真的把这个搜集齐了？请让我看一看…确实，这三份的纹饰连在一起，确实是在描述「若陀龙王」的故事。",
            "nextDialogs": [
              "710160503"
            ]
          },
          "710160503": {
            "id": "710160503",
            "speakerId": 2023,
            "speakerName": "琳琅",
            "text": "看起来，这只鹤应该就是「理水叠山真君」了，这只鹿…也许是「削月筑阳真君」，但是剩下的这一个…",
            "nextDialogs": [
              "710160504"
            ]
          },
          "710160504": {
            "id": "710160504",
            "speakerId": 2023,
            "speakerName": "琳琅",
            "text": "咦？最后的这个上面的纹饰好像…被人特意磨掉了形象，一点细节都看不出来。这第三位仙人到底是谁？",
            "nextDialogs": [
              "710160505"
            ]
          },
          "710160505": {
            "id": "710160505",
            "speakerId": 2023,
            "speakerName": "琳琅",
            "text": "算了，这些事已经超出了我的知识范围了。但不管怎么说，这份「宝藏」已经完整了，应该能卖个好价钱了。",
            "nextDialogs": [
              "710160506"
            ]
          },
          "710160506": {
            "id": "710160506",
            "speakerId": 2023,
            "speakerName": "琳琅",
            "text": "怎么样，您是想要留个纪念，还是把这份「宝藏」出给我，卖个好价钱？",
            "nextDialogs": [
              "710160507"
            ]
          },
          "710160507": {
            "id": "710160507",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "卖给你了。",
            "nextDialogs": [
              "710160508"
            ]
          },
          "710160508": {
            "id": "710160508",
            "speakerId": 2023,
            "speakerName": "琳琅",
            "text": "好的，那么这些钱您拿好，东西我就收下了。",
            "nextDialogs": [
              "710160509"
            ]
          },
          "710160509": {
            "id": "710160509",
            "speakerId": 2023,
            "speakerName": "琳琅",
            "text": "但是…为什么纹饰之中的这三位仙人，会有一位被磨去了形象呢？",
            "nextDialogs": [
              "710160510"
            ]
          },
          "710160510": {
            "id": "710160510",
            "speakerId": 2023,
            "speakerName": "琳琅",
            "text": "是谁制作了这个东西，又是谁打碎了它，还擅自磨去了仙人的形象？",
            "nextDialogs": [
              "710160511"
            ]
          },
          "710160511": {
            "id": "710160511",
            "speakerId": 2023,
            "speakerName": "琳琅",
            "text": "对了，索拉雅那家伙好像已经来了璃月，我可以写封信问问她…她也一定会对这个东西感兴趣的。"
          }
        }
      }
    },
    {
      "subId": "7101604",
      "subQuestName": "未找齐分支$HIDDEN",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "710160401"
        ],
        "dialogs": {
          "710160401": {
            "id": "710160401",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "我去试试看。",
            "nextDialogs": [
              "710160402"
            ]
          },
          "710160402": {
            "id": "710160402",
            "speakerId": 2023,
            "speakerName": "琳琅",
            "text": "好吧，如果您真的搜集齐全了，记得一定要拿来我看看。"
          }
        }
      }
    },

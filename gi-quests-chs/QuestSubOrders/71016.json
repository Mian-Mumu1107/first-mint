    {
      "subId": "7101603",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "710160301"
        ],
        "dialogs": {
          "710160301": {
            "id": "710160301",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "关于无名的宝藏",
            "nextDialogs": [
              "710160302"
            ]
          },
          "710160302": {
            "id": "710160302",
            "speakerId": 2023,
            "speakerName": "琳琅",
            "text": "如果我的猜测没错，您上次拿来的那份东西，应该总共有三份。",
            "nextDialogs": [
              "710160303"
            ]
          },
          "710160303": {
            "id": "710160303",
            "speakerId": 2023,
            "speakerName": "琳琅",
            "text": "将三份合起来，才是一个完整的物件。",
            "nextDialogs": [
              "710160304"
            ]
          },
          "710160304": {
            "id": "710160304",
            "speakerId": 2023,
            "speakerName": "琳琅",
            "text": "如果您真能找齐，那我非常愿意出个好价钱收下。",
            "nextDialogs": [
              "710160305"
            ]
          },
          "710160305": {
            "id": "710160305",
            "speakerId": 2023,
            "speakerName": "琳琅",
            "text": "不过这东西年代实在太过久远，想要找齐…还是有些难度的。"
          }
        }
      }
    }

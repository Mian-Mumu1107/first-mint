  },
  "subQuests": [
    {
      "subId": "7051902",
      "subQuestName": "返回店铺",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "705190201"
        ],
        "dialogs": {
          "705190201": {
            "id": "705190201",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "伯恩哈德，我们筹集到足够的资金啦！",
            "nextDialogs": [
              "705190202"
            ]
          },
          "705190202": {
            "id": "705190202",
            "speakerId": 1001,
            "speakerName": "伯恩哈德",
            "text": "居然这么快？你们的效率也太惊人了！",
            "nextDialogs": [
              "705190203"
            ]
          },
          "705190203": {
            "id": "705190203",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "万事俱备，只差开店了。",
            "nextDialogs": [
              "705190204"
            ]
          },
          "705190204": {
            "id": "705190204",
            "speakerId": 1001,
            "speakerName": "伯恩哈德",
            "text": "好，我这边也和供货商们谈好了，请稍等。",
            "nextDialogs": [
              "705190205"
            ]
          },
          "705190205": {
            "id": "705190205",
            "speakerId": 1002,
            "speakerName": "Black Screen",
            "text": "伯恩哈德向供货商交付了「佳酿晶冻」，不久后就将店铺搭建完毕。",
            "nextDialogs": [
              "705190206"
            ]
          },
          "705190206": {
            "id": "705190206",
            "speakerId": 1001,
            "speakerName": "伯恩哈德",
            "text": "怎么样，看起来还不错吧！如果你们有什么灵感，随时可以调整店铺的装潢哦。",
            "nextDialogs": [
              "705190207"
            ]
          },
          "705190207": {
            "id": "705190207",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "有模有样，很有感觉！",
            "nextDialogs": [
              "705190208"
            ]
          },
          "705190208": {
            "id": "705190208",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "我来给店铺起一个名字吧…就叫「西风呼呼义卖铺」好了！",
            "nextDialogs": [
              "705190210",
              "705190212"
            ]
          },
          "705190210": {
            "id": "705190210",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "就当你是在表扬我好了！那，伯恩哈德，还需要我们做点什么？",
            "nextDialogs": [
              "705190213"
            ]
          },
          "705190213": {
            "id": "705190213",
            "speakerId": 1001,
            "speakerName": "伯恩哈德",
            "text": "筹集资金是门苦差事，已经让你们受累了。繁琐的工作不劳你们，全都交给我吧。",
            "nextDialogs": [
              "705190214"
            ]
          },
          "705190214": {
            "id": "705190214",
            "speakerId": 1001,
            "speakerName": "伯恩哈德",
            "text": "你们见多识广，还请你们确定本店的经营方向，比如销售方针、服务特点和品控原则…",
            "nextDialogs": [
              "705190215"
            ]
          },
          "705190215": {
            "id": "705190215",
            "speakerId": 1001,
            "speakerName": "伯恩哈德",
            "text": "这些词是我从其他店主那里听来的，我不太理解，但知道它们很重要，还是由你们来决定为妙。",
            "nextDialogs": [
              "705190216"
            ]
          },
          "705190216": {
            "id": "705190216",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "也就是说，我们两个来当店主，负责店铺的整体策略，而你来当店员，负责具体的工作？",
            "nextDialogs": [
              "705190217"
            ]
          },
          "705190217": {
            "id": "705190217",
            "speakerId": 1001,
            "speakerName": "伯恩哈德",
            "text": "是的，我就擅长执行，请把我当成「工具人」吧！",
            "nextDialogs": [
              "705190218"
            ]
          },
          "705190218": {
            "id": "705190218",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "好强的觉悟…",
            "nextDialogs": [
              "705190219"
            ]
          },
          "705190219": {
            "id": "705190219",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "呃，倒也不用这么夸张啦，我们也不是黑心店长嘛！",
            "nextDialogs": [
              "705190220"
            ]
          },
          "705190220": {
            "id": "705190220",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "#你先去休息一下吧，伯恩哈德，我和{NICKNAME}要好好商量一下策略。",
            "nextDialogs": [
              "705190221"
            ]
          },
          "705190221": {
            "id": "705190221",
            "speakerId": 1002,
            "speakerName": "Black Screen",
            "text": "根据以往的见闻，和派蒙研究了店里的商品，讨论了经营店铺的要点…",
            "nextDialogs": [
              "705190222"
            ]
          },
          "705190222": {
            "id": "705190222",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "好，要点很清楚，目标是做成「集市上最棒的小吃店」！",
            "nextDialogs": [
              "705190223"
            ]
          },
          "705190223": {
            "id": "705190223",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "接下来就拿出最好的状态，迎接第一批顾客吧…",
            "nextDialogs": [
              "705190224"
            ]
          },
          "705190224": {
            "id": "705190224",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "开店开店！",
            "nextDialogs": [
              "705190225"
            ]
          },
          "705190225": {
            "id": "705190225",
            "speakerId": 1003,
            "speakerName": "莫娜",
            "text": "#{NICKNAME}和派蒙？没想到能在这里碰见你们！",
            "nextDialogs": [
              "705190226"
            ]
          },
          "705190226": {
            "id": "705190226",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "莫娜和菲谢尔！你们也来集市玩啦！",
            "nextDialogs": [
              "705190227"
            ]
          },
          "705190227": {
            "id": "705190227",
            "speakerId": 1004,
            "speakerName": "菲谢尔",
            "text": "呵！不枉本皇女采信那冥冥之中的预感，让梅姬斯图斯卿陪同我前来巡视这凡俗的节庆…",
            "nextDialogs": [
              "705190228"
            ]
          },
          "705190228": {
            "id": "705190228",
            "speakerId": 1004,
            "speakerName": "菲谢尔",
            "text": "即便是平平无奇的秋日，也隐伏着常理之外的转机…妙哉！",
            "nextDialogs": [
              "705190229"
            ]
          },
          "705190229": {
            "id": "705190229",
            "speakerId": 1005,
            "speakerName": "奥兹",
            "text": "小姐正按捺着喜悦的嗓音，能见到你们，她的心情好得出奇…",
            "nextDialogs": [
              "705190230"
            ]
          },
          "705190230": {
            "id": "705190230",
            "speakerId": 1004,
            "speakerName": "菲谢尔",
            "text": "奥…奥兹！添油加醋！",
            "nextDialogs": [
              "705190231"
            ]
          },
          "705190231": {
            "id": "705190231",
            "speakerId": 1003,
            "speakerName": "莫娜",
            "text": "哼哼，还是由我来说明吧。",
            "nextDialogs": [
              "705190232"
            ]
          },
          "705190232": {
            "id": "705190232",
            "speakerId": 1003,
            "speakerName": "莫娜",
            "text": "不久前皇女殿下做了个不错的梦，感觉最近会有好事发生，想来找我咨询星象。",
            "nextDialogs": [
              "705190233"
            ]
          },
          "705190233": {
            "id": "705190233",
            "speakerId": 1003,
            "speakerName": "莫娜",
            "text": "另外，她发现佳酿节办得挺热闹的，就问我要不要一起去逛逛。",
            "nextDialogs": [
              "705190234"
            ]
          },
          "705190234": {
            "id": "705190234",
            "speakerId": 1003,
            "speakerName": "莫娜",
            "text": "我当然答应喽。正好可以趁着节日促销采购一大批物资，为赶稿做准备。",
            "nextDialogs": [
              "705190235"
            ]
          },
          "705190235": {
            "id": "705190235",
            "speakerId": 1003,
            "speakerName": "莫娜",
            "text": "其实，也多亏皇女殿下的提醒，我才知道佳酿节已经到了…",
            "nextDialogs": [
              "705190236"
            ]
          },
          "705190236": {
            "id": "705190236",
            "speakerId": 1004,
            "speakerName": "菲谢尔",
            "text": "梅姬斯图斯卿，本皇女必须强调，那个梦是九天前的事了。",
            "nextDialogs": [
              "705190237"
            ]
          },
          "705190237": {
            "id": "705190237",
            "speakerId": 1004,
            "speakerName": "菲谢尔",
            "text": "在此期间，梅姬斯图斯卿一直没有回信，本皇女才莅临你的住所。",
            "nextDialogs": [
              "705190238"
            ]
          },
          "705190238": {
            "id": "705190238",
            "speakerId": 1003,
            "speakerName": "莫娜",
            "text": "等等…已经过去九天了？九天？！怎么这么快！",
            "nextDialogs": [
              "705190239"
            ]
          },
          "705190239": {
            "id": "705190239",
            "speakerId": 1004,
            "speakerName": "菲谢尔",
            "text": "念在这次的文稿对于梅姬斯图斯卿至关重要，本皇女就不计较了。",
            "nextDialogs": [
              "705190240"
            ]
          },
          "705190240": {
            "id": "705190240",
            "speakerId": 1005,
            "speakerName": "奥兹",
            "text": "不过还请梅姬斯图斯卿留意，门口的信箱塞得满满当当，可能有不少人以为您失联了。",
            "nextDialogs": [
              "705190241"
            ]
          },
          "705190241": {
            "id": "705190241",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "莫娜还真是沉浸在学术研究里啊，忘记了时间，忘记给别人回信，也没注意到这么盛大的庆典。"
          },
          "705190212": {
            "id": "705190212",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "喂，不要无视我起的名字呀？至少也点一下头吧！"
          }
        }
      }
    },
    {
      "subId": "7051903",
      "subQuestName": "",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "705190301"
        ],
        "dialogs": {
          "705190301": {
            "id": "705190301",
            "speakerId": 1001,
            "speakerName": "伯恩哈德",
            "text": "大名鼎鼎的荣誉骑士，还有「提瓦特最好的向导」派蒙，请你们帮我主持义卖活动吧！",
            "nextDialogs": [
              "705190302"
            ]
          },
          "705190302": {
            "id": "705190302",
            "speakerId": 1002,
            "speakerName": "Black Screen",
            "text": "帮助伯恩哈德准备了义卖的店铺",
            "nextDialogs": [
              "705190303"
            ]
          },
          "705190303": {
            "id": "705190303",
            "speakerId": 1001,
            "speakerName": "伯恩哈德",
            "text": "辛苦你们了，现在就开始营业吧！"
          }
        }
      }
    }
  ]
}
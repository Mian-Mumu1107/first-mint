    {
      "subId": "7183102",
      "subQuestName": "回到铜雀雕像所在地",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "718310201"
        ],
        "dialogs": {
          "718310201": {
            "id": "718310201",
            "speakerId": 12326,
            "speakerName": "王平安",
            "text": "香炉就在那边，您要敬香的话就过去吧。"
          }
        }
      }
    },
    {
      "subId": "7183103",
      "subQuestName": "与王平安对话",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "718310301"
        ],
        "dialogs": {
          "718310301": {
            "id": "718310301",
            "speakerId": 12326,
            "speakerName": "王平安",
            "text": "这庙看着还算不错…",
            "nextDialogs": [
              "718310302"
            ]
          },
          "718310302": {
            "id": "718310302",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "确实很不错。",
            "nextDialogs": [
              "718310303"
            ]
          },
          "718310303": {
            "id": "718310303",
            "speakerId": 12326,
            "speakerName": "王平安",
            "text": "欸？您来得倒是刚刚好，这庙才修好不久，我刚给工匠们结完钱呢。",
            "nextDialogs": [
              "718310304"
            ]
          },
          "718310304": {
            "id": "718310304",
            "speakerId": 12326,
            "speakerName": "王平安",
            "text": "唉…没想到居然花了这么多钱，我辛苦赚的那些钱，已经全部砸里面了…",
            "nextDialogs": [
              "718310305"
            ]
          },
          "718310305": {
            "id": "718310305",
            "speakerId": 12326,
            "speakerName": "王平安",
            "text": "不过无论如何，这庙建好了就行。",
            "nextDialogs": [
              "718310306"
            ]
          },
          "718310306": {
            "id": "718310306",
            "speakerId": 12326,
            "speakerName": "王平安",
            "text": "您想去庙里敬敬香吗？我还专门托人做了一个新香炉呢。",
            "nextDialogs": [
              "718310310",
              "718310309"
            ]
          },
          "718310310": {
            "id": "718310310",
            "speakerId": 12326,
            "speakerName": "王平安",
            "text": "这几柱香您拿着，香炉就在那边。"
          },
          "718310309": {
            "id": "718310309",
            "speakerId": 12326,
            "speakerName": "王平安",
            "text": "那当然。庙刚建好之后，我可是敬了一柱上好的香，刚刚才烧完了。"
          }
        }
      }
    },
    {
      "subId": "7183104",
      "subQuestName": "向铜雀敬香",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [],
        "dialogs": {}
      }
    },
    {
      "subId": "7183105",
      "subQuestName": "与王平安对话",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "718310501"
        ],
        "dialogs": {
          "718310501": {
            "id": "718310501",
            "speakerId": 12326,
            "speakerName": "王平安",
            "text": "您敬好香了吧，感觉怎么样？",
            "nextDialogs": [
              "718310502"
            ]
          },
          "718310502": {
            "id": "718310502",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "还不错。",
            "nextDialogs": [
              "718310503"
            ]
          },
          "718310503": {
            "id": "718310503",
            "speakerId": 12326,
            "speakerName": "王平安",
            "text": "那就好。希望这座庙以后香火会盛一点…",
            "nextDialogs": [
              "718310504"
            ]
          },
          "718310504": {
            "id": "718310504",
            "speakerId": 12326,
            "speakerName": "王平安",
            "text": "我会暂时待在这里一段时间。这里很清静，是个进行编写工作的好地方。",
            "nextDialogs": [
              "718310505"
            ]
          },
          "718310505": {
            "id": "718310505",
            "speakerId": 12326,
            "speakerName": "王平安",
            "text": "我得尽快整理一下我之前搜集的那些资料，然后继续编写那本有关「护法夜叉」的书。",
            "nextDialogs": [
              "718310506"
            ]
          },
          "718310506": {
            "id": "718310506",
            "speakerId": 12326,
            "speakerName": "王平安",
            "text": "您以后有空的话，也可以多来这庙里看看。",
            "nextDialogs": [
              "718310507"
            ]
          },
          "718310507": {
            "id": "718310507",
            "speakerId": 12326,
            "speakerName": "王平安",
            "text": "想要敬香的话，直接找我拿香就好了。",
            "nextDialogs": [
              "718310508"
            ]
          },
          "718310508": {
            "id": "718310508",
            "speakerId": 12326,
            "speakerName": "王平安",
            "text": "唉，其实我还想把周围也再整修一下…",
            "nextDialogs": [
              "718310509"
            ]
          },
          "718310509": {
            "id": "718310509",
            "speakerId": 12326,
            "speakerName": "王平安",
            "text": "路得重新铺一遍，两边要加上围栏，旁边还要再做个花圃…"
          }
        }
      }
    },
    {
      "subId": "7183003",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "718300301"
        ],
        "dialogs": {
          "718300301": {
            "id": "718300301",
            "speakerId": 12326,
            "speakerName": "王平安",
            "text": "慢点拆，慢点拆！别把雕像给碰坏了！",
            "nextDialogs": [
              "718300302"
            ]
          },
          "718300302": {
            "id": "718300302",
            "speakerId": 12326,
            "speakerName": "王平安",
            "text": "唉，看来还得建一段时间啊…"
          }
        }
      }
    }
  ]

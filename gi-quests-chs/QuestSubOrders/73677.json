{
  "lineCounts": {
    "Player": 6,
    "埃德蒙德": 14,
    "法拉比": 8,
    "派蒙": 6
  },
  "subQuests": [
    {
      "subId": "7367701",
      "subQuestName": "与清泉镇附近的埃德蒙德对话",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "736770101"
        ],
        "dialogs": {
          "736770101": {
            "id": "736770101",
            "speakerId": 30247,
            "speakerName": "法拉比",
            "text": "猎人先生，求你了，你就带上我吧，我一定能帮上忙的！",
            "nextDialogs": [
              "736770102"
            ]
          },
          "736770102": {
            "id": "736770102",
            "speakerId": 30245,
            "speakerName": "埃德蒙德",
            "text": "喂，你先冷静一点！虽说我们正在招募捕猎野林猪的人手，可你之前根本没有狩猎的经验，我们没办法录用你啊。",
            "nextDialogs": [
              "736770103"
            ]
          },
          "736770103": {
            "id": "736770103",
            "speakerId": 30247,
            "speakerName": "法拉比",
            "text": "唉，这可怎么办啊，难道说我的论文…我的论文就要和野林猪一起消失在林子里了吗？",
            "nextDialogs": [
              "736770104"
            ]
          },
          "736770104": {
            "id": "736770104",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "咦，你们两个愁眉苦脸的，发生什么事了？",
            "nextDialogs": [
              "736770105"
            ]
          },
          "736770105": {
            "id": "736770105",
            "speakerId": 30245,
            "speakerName": "埃德蒙德",
            "text": "哎呀，这不是传说中的旅行者吗？学生小哥，打起精神来，遇到这个人说不定就有办法了呢。",
            "nextDialogs": [
              "736770107",
              "736770109"
            ]
          },
          "736770107": {
            "id": "736770107",
            "speakerId": 30245,
            "speakerName": "埃德蒙德",
            "text": "哈哈，别这么说嘛，大家都知道蒙德的荣誉骑士不仅身手了得，而且十分乐于助人。",
            "nextDialogs": [
              "736770110"
            ]
          },
          "736770110": {
            "id": "736770110",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "所以有什么事需要我们帮忙吗？",
            "nextDialogs": [
              "736770111"
            ]
          },
          "736770111": {
            "id": "736770111",
            "speakerId": 30245,
            "speakerName": "埃德蒙德",
            "text": "事情是这样的，最近因为野林猪出没频繁，我们猎人的人手又不太够用，所以正在招募捕捉野林猪的志愿者。",
            "nextDialogs": [
              "736770112"
            ]
          },
          "736770112": {
            "id": "736770112",
            "speakerId": 30245,
            "speakerName": "埃德蒙德",
            "text": "这位从须弥来的学生小哥虽然也想加入，可你看他细胳膊细腿的，身体条件实在不符合我们的招募要求。",
            "nextDialogs": [
              "736770113"
            ]
          },
          "736770113": {
            "id": "736770113",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "是啊，你不是学生吗，为什么也想参加捕猎？",
            "nextDialogs": [
              "736770133"
            ]
          },
          "736770133": {
            "id": "736770133",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "#别看野林猪圆滚滚的，它们横冲直撞起来可是很凶的，如果没有{NICKNAME}这样的身手，还是不要贸然尝试为好。",
            "nextDialogs": [
              "736770114"
            ]
          },
          "736770114": {
            "id": "736770114",
            "speakerId": 30247,
            "speakerName": "法拉比",
            "text": "道理我当然也知道，可这附近毕竟出现传说中的生物了呀！",
            "nextDialogs": [
              "736770115"
            ]
          },
          "736770115": {
            "id": "736770115",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "等等，「传说中的生物」？",
            "nextDialogs": [
              "736770116"
            ]
          },
          "736770116": {
            "id": "736770116",
            "speakerId": 30245,
            "speakerName": "埃德蒙德",
            "text": "唔，应该是指前几天我发现的一种有白鬃的野林猪吧，我刚才跟他闲聊的时候偶然提起的。",
            "nextDialogs": [
              "736770117"
            ]
          },
          "736770117": {
            "id": "736770117",
            "speakerId": 30245,
            "speakerName": "埃德蒙德",
            "text": "不过，虽说那种野林猪我之前的确没见过，可它们真有那么特殊吗？",
            "nextDialogs": [
              "736770118"
            ]
          },
          "736770118": {
            "id": "736770118",
            "speakerId": 30247,
            "speakerName": "法拉比",
            "text": "那当然了！据我所知，你目击到的那种野林猪，可是一百年前就已经绝迹的「雪猪」。",
            "nextDialogs": [
              "736770119"
            ]
          },
          "736770119": {
            "id": "736770119",
            "speakerId": 30247,
            "speakerName": "法拉比",
            "text": "虽然最近有冒险家声称，在龙脊雪山又发现了它们的踪迹，但因为目击报告语焉不详，学界并未采信。",
            "nextDialogs": [
              "736770120"
            ]
          },
          "736770120": {
            "id": "736770120",
            "speakerId": 30247,
            "speakerName": "法拉比",
            "text": "不瞒你们说，我其实是须弥教令院生论派的学生，因为最近毕业论文的方向一直定不下来，所以就来过佳酿节散散心。",
            "nextDialogs": [
              "736770121"
            ]
          },
          "736770121": {
            "id": "736770121",
            "speakerId": 30247,
            "speakerName": "法拉比",
            "text": "如果我能找到雪猪存活的确凿证据，那可是了不得的学术大发现，我的毕业论文也能顺利进行下去了！",
            "nextDialogs": [
              "736770122"
            ]
          },
          "736770122": {
            "id": "736770122",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "#原来是这样。{NICKNAME}，你有没有觉得，我们遇到的教令院的人，好多都有类似的烦恼。",
            "nextDialogs": [
              "736770123"
            ]
          },
          "736770123": {
            "id": "736770123",
            "speakerId": 30245,
            "speakerName": "埃德蒙德",
            "text": "学业固然重要，但身体可是本钱。考虑到学生小哥的人身安全，我们确实不能带他。",
            "nextDialogs": [
              "736770134"
            ]
          },
          "736770134": {
            "id": "736770134",
            "speakerId": 30245,
            "speakerName": "埃德蒙德",
            "text": "旅行者，不知道你愿不愿意代替他，加入捕猎队？",
            "nextDialogs": [
              "736770124"
            ]
          },
          "736770124": {
            "id": "736770124",
            "speakerId": 30245,
            "speakerName": "埃德蒙德",
            "text": "如果能有你这样的好手加入，捕捉野林猪的效率一定能大大提高。而且大家也能腾出手来，帮他搜寻一下雪猪的踪迹。",
            "nextDialogs": [
              "736770125"
            ]
          },
          "736770125": {
            "id": "736770125",
            "speakerId": 30247,
            "speakerName": "法拉比",
            "text": "真、真的吗？请你们放心，我的研究经费还是很充足的，绝对能提供令大家满意的报酬！"
          },
          "736770109": {
            "id": "736770109",
            "speakerId": 30245,
            "speakerName": "埃德蒙德",
            "text": "哈哈，不愧是蒙德的荣誉骑士，不仅身手了得，而且十分乐于助人。"
          }
        }
      }
    },
    {
      "subId": "7367702",
      "subQuestName": "参加清泉镇附近的捕猎",
      "sceneId": null,

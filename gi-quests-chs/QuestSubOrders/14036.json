    {
      "subId": "1403608",
      "subQuestName": "(test)进入游戏$HIDDEN",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "140330601"
        ],
        "dialogs": {
          "140330601": {
            "id": "140330601",
            "speakerId": 1000,
            "speakerName": "主持人",
            "text": "城市依旧被压抑沉闷的灰暗气氛笼罩着，但此刻你们的心情已有所不同。",
            "nextDialogs": [
              "140330602"
            ]
          },
          "140330602": {
            "id": "140330602",
            "speakerId": 1000,
            "speakerName": "主持人",
            "text": "在日光难以渗透之处，你们慷慨地伸出手，将摩拉分给老人与孩童，分给那些衣衫褴褛，亟需帮助之人。",
            "nextDialogs": [
              "140330603"
            ]
          },
          "140330603": {
            "id": "140330603",
            "speakerId": 1007,
            "speakerName": "驼背的老妇人",
            "text": "谢谢您，好心人…",
            "nextDialogs": [
              "140330604"
            ]
          },
          "140330604": {
            "id": "140330604",
            "speakerId": 1000,
            "speakerName": "主持人",
            "text": "一位老妇人不舍地望着你们远去的背影，直到你们回头再也见不到彼此。此时，袋中摩拉尚有不少，你们目前的速度并不乐观。",
            "nextDialogs": [
              "140330605"
            ]
          },
          "140330605": {
            "id": "140330605",
            "speakerId": 1001,
            "speakerName": "芙宁娜",
            "text": "（是不能耽误太久的意思吧？邪恶巫师的问题还没解决…）",
            "nextDialogs": [
              "140330606"
            ]
          },
          "140330606": {
            "id": "140330606",
            "speakerId": 1003,
            "speakerName": "林尼",
            "text": "要不要拜托之前广场上的那位男士帮忙分发？他是个有责任感的人，对居民的了解也比我们更多。",
            "nextDialogs": [
              "140330607"
            ]
          },
          "140330607": {
            "id": "140330607",
            "speakerId": 1006,
            "speakerName": "派蒙",
            "text": "哦，好主意！",
            "nextDialogs": [
              "140330608"
            ]
          },
          "140330608": {
            "id": "140330608",
            "speakerId": 1000,
            "speakerName": "主持人",
            "text": "在你们走向广场，试图寻找那位男士的时候…",
            "nextDialogs": [
              "140330609"
            ]
          },
          "140330609": {
            "id": "140330609",
            "speakerId": 1008,
            "speakerName": "严肃的卫兵",
            "text": "请几位贵客留步。",
            "nextDialogs": [
              "140330610"
            ]
          },
          "140330610": {
            "id": "140330610",
            "speakerId": 1000,
            "speakerName": "主持人",
            "text": "几位陌生的卫兵喊住了你们。他们小跑上前，恭敬而整齐地向你们行礼。",
            "nextDialogs": [
              "140330611"
            ]
          },
          "140330611": {
            "id": "140330611",
            "speakerId": 1004,
            "speakerName": "娜维娅",
            "text": "先生们好呀，你们该不会是来邀请我们喝下午茶的吧？",
            "nextDialogs": [
              "140330612"
            ]
          },
          "140330612": {
            "id": "140330612",
            "speakerId": 1008,
            "speakerName": "严肃的卫兵",
            "text": "您说笑了，我们怎么敢当？是尊贵的国王大人想要亲自接见你们。请几位随我们来。"
          }
        }
      }
    },
    {
      "subId": "1403609",
      "subQuestName": "(test)等待操作台操作后传送$HIDDEN",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [],
        "dialogs": {}
      }
    },
    {
      "subId": "1403299",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "140329909"
        ],
        "dialogs": {
          "140329909": {
            "id": "140329909",
            "speakerId": 1000,
            "speakerName": "主持人",
            "text": "在前进的路上，你们不断看到有卫兵模样的人倒在路旁。",
            "nextDialogs": [
              "140329910"
            ]
          },
          "140329910": {
            "id": "140329910",
            "speakerId": 1000,
            "speakerName": "主持人",
            "text": "他们面容间填满了恐惧与绝望，有人徒劳地叫喊与怒骂着，妄图将不久前的所见之物驱逐出自己内心。",
            "nextDialogs": [
              "140329913"
            ]
          },
          "140329913": {
            "id": "140329913",
            "speakerId": 1000,
            "speakerName": "主持人",
            "text": "开始下一回合战斗——"
          }
        }
      }
    },
    {
      "subId": "1403399",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "140339905"
        ],
        "dialogs": {
          "140339905": {
            "id": "140339905",
            "speakerId": 1003,
            "speakerName": "林尼",
            "text": "我这边也有进展了哦。",
            "nextDialogs": [
              "140339907"
            ]
          },
          "140339907": {
            "id": "140339907",
            "speakerId": 1004,
            "speakerName": "娜维娅",
            "text": "我要对他使用「剑术」！",
            "nextDialogs": [
              "140339908"

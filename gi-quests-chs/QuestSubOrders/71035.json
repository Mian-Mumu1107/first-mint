  "subQuests": [
    {
      "subId": "7103501",
      "subQuestName": "前往万民堂$HIDDEN",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "710350101"
        ],
        "dialogs": {
          "710350101": {
            "id": "710350101",
            "speakerId": 1000,
            "speakerName": "卯师傅",
            "text": "二位，要点什么？",
            "nextDialogs": [
              "710350102"
            ]
          },
          "710350102": {
            "id": "710350102",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "三份烤吃虎鱼，打包。",
            "nextDialogs": [
              "710350103"
            ]
          },
          "710350103": {
            "id": "710350103",
            "speakerId": 1000,
            "speakerName": "卯师傅",
            "text": "好嘞！您在这稍等一会。",
            "nextDialogs": [
              "710350104"
            ]
          },
          "710350104": {
            "id": "710350104",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "三份？你一份，我一份…还有一份是…",
            "nextDialogs": [
              "710350107"
            ]
          },
          "710350107": {
            "id": "710350107",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "你是说之前把七星灯和香炉给我们的那位铜雀先生吗？",
            "nextDialogs": [
              "710350108"
            ]
          },
          "710350108": {
            "id": "710350108",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "对喔，记得铜雀先生说过他很想念烤吃虎鱼…",
            "nextDialogs": [
              "710350109"
            ]
          },
          "710350109": {
            "id": "710350109",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "不过，铜雀先生应该已经走了…",
            "nextDialogs": [
              "710350110"
            ]
          },
          "710350110": {
            "id": "710350110",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "去看看也好。",
            "nextDialogs": [
              "710350111"
            ]
          },
          "710350111": {
            "id": "710350111",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "嗯，那我们就再去看看吧。",
            "nextDialogs": [
              "710350112"
            ]
          },
          "710350112": {
            "id": "710350112",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "之前在那边见到铜雀先生的时候，那间庙又破又旧，旁边好像还有盗宝团的踪迹…",
            "nextDialogs": [
              "710350113"
            ]
          },
          "710350113": {
            "id": "710350113",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "希望，铜雀先生的雕像别被人弄坏了…",
            "nextDialogs": [
              "710350114"
            ]
          },
          "710350114": {
            "id": "710350114",
            "speakerId": 1000,
            "speakerName": "卯师傅",
            "text": "二位，您要的三份烤吃虎鱼打包好了，您拿好。",
            "nextDialogs": [
              "710350115"
            ]
          },
          "710350115": {
            "id": "710350115",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "#好香啊！{NICKNAME}，那我们就快点出发吧。"
          }
        }
      }
    },
    {
      "subId": "7103502",

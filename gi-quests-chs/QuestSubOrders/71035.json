      }
    },
    {
      "subId": "7103508",
      "subQuestName": "与王平安对话",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "710350401"
        ],
        "dialogs": {
          "710350401": {
            "id": "710350401",
            "speakerId": 1002,
            "speakerName": "王平安",
            "text": "这座庙还是这么破败…",
            "nextDialogs": [
              "710350402"
            ]
          },
          "710350402": {
            "id": "710350402",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "赶紧交代，你怎么突然想要来修庙的？",
            "nextDialogs": [
              "710350403"
            ]
          },
          "710350403": {
            "id": "710350403",
            "speakerId": 1002,
            "speakerName": "王平安",
            "text": "咳，那就说来话长了…",
            "nextDialogs": [
              "710350404"
            ]
          },
          "710350404": {
            "id": "710350404",
            "speakerId": 1002,
            "speakerName": "王平安",
            "text": "我之前为了假扮仙人，搜集了很多资料…",
            "nextDialogs": [
              "710350405"
            ]
          },
          "710350405": {
            "id": "710350405",
            "speakerId": 1002,
            "speakerName": "王平安",
            "text": "那次受了仙师教诲之后，我不是立下了从善的誓吗？回去之后，我就准备把那些资料全部毁掉。",
            "nextDialogs": [
              "710350406"
            ]
          },
          "710350406": {
            "id": "710350406",
            "speakerId": 1002,
            "speakerName": "王平安",
            "text": "但我转念一想…与其把这些资料毁掉，不如我把这些资料，还有我行骗时的手段编写成册，散发给其他人。",
            "nextDialogs": [
              "710350407"
            ]
          },
          "710350407": {
            "id": "710350407",
            "speakerId": 1002,
            "speakerName": "王平安",
            "text": "这样，说不定能帮助大家识破一些骗子…",
            "nextDialogs": [
              "710350408"
            ]
          },
          "710350408": {
            "id": "710350408",
            "speakerId": 1002,
            "speakerName": "王平安",
            "text": "没想到，我编写的这本册子还真帮不少人防了骗，连总务司的人都说我这个册子很有用。",
            "nextDialogs": [
              "710350409"
            ]
          },
          "710350409": {
            "id": "710350409",
            "speakerId": 1002,
            "speakerName": "王平安",
            "text": "除了我自己写的那部分内容之外，他们还拜托我加入一些其他的防骗内容…",
            "nextDialogs": [
              "710350410"
            ]
          },
          "710350410": {
            "id": "710350410",
            "speakerId": 1002,
            "speakerName": "王平安",
            "text": "为此，总务司还付了我不少钱呢。",
            "nextDialogs": [
              "710350411"
            ]
          },
          "710350411": {
            "id": "710350411",
            "speakerId": 1002,
            "speakerName": "王平安",
            "text": "除了那本小册子之外，我还在编写另外一本有关「护法夜叉」的书。",
            "nextDialogs": [
              "710350412"
            ]
          },
          "710350412": {
            "id": "710350412",
            "speakerId": 1002,
            "speakerName": "王平安",
            "text": "我想用这本书来向大家宣传一下「护法夜叉」的故事。",
            "nextDialogs": [
              "710350413"
            ]
          },
          "710350413": {
            "id": "710350413",
            "speakerId": 1002,
            "speakerName": "王平安",
            "text": "这样做，我的那些民俗学知识也算是用在了正道上。",
            "nextDialogs": [
              "710350414"
            ]
          },
          "710350414": {
            "id": "710350414",
            "speakerId": 1002,
            "speakerName": "王平安",
            "text": "这位「铜雀」的庙，我也是在编写有关「护法夜叉」的书的时候发现的。",
            "nextDialogs": [
              "710350415"
            ]
          },
          "710350415": {
            "id": "710350415",
            "speakerId": 1002,
            "speakerName": "王平安",
            "text": "上面记载说，那座庙本来是先民们为了纪念夜叉「铜雀」所建。",
            "nextDialogs": [
              "710350416"
            ]
          },
          "710350416": {
            "id": "710350416",
            "speakerId": 1002,
            "speakerName": "王平安",
            "text": "但我找到这座庙的时候，真没想到它居然如此破败…",
            "nextDialogs": [
              "710350417"
            ]
          },
          "710350417": {
            "id": "710350417",
            "speakerId": 1002,
            "speakerName": "王平安",
            "text": "回去之后我左思右想，最后还是决定…自己出钱，把这座庙重修一遍。",
            "nextDialogs": [
              "710350418"
            ]
          },
          "710350418": {
            "id": "710350418",
            "speakerId": 1002,
            "speakerName": "王平安",
            "text": "毕竟，我能重新走回正道，也是多亏了仙师教诲。",
            "nextDialogs": [
              "710350419"
            ]
          },
          "710350419": {
            "id": "710350419",
            "speakerId": 1002,
            "speakerName": "王平安",
            "text": "重修这座庙，也算是为我之前做的那些错事赎一些罪了。",
            "nextDialogs": [
              "710350420"
            ]
          },
          "710350420": {
            "id": "710350420",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "唔…听起来不像是假的…",
            "nextDialogs": [
              "710350421"
            ]
          },
          "710350421": {
            "id": "710350421",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "#{NICKNAME}，你觉得呢？",
            "nextDialogs": [
              "710350423",
              "710350425"
            ]
          },
          "710350423": {
            "id": "710350423",
            "speakerId": 1002,
            "speakerName": "王平安",
            "text": "什么叫感觉挺真的，这就是真的，千真万确！",
            "nextDialogs": [
              "710350426"
            ]
          },
          "710350426": {
            "id": "710350426",
            "speakerId": 1002,
            "speakerName": "王平安",
            "text": "唉，算了，您爱怎么想就怎么想吧…",
            "nextDialogs": [
              "710350427"
            ]
          },
          "710350427": {
            "id": "710350427",
            "speakerId": 1002,
            "speakerName": "王平安",
            "text": "您要是真不信，就等正式开工之后自己过来看看吧。"
          },
          "710350425": {
            "id": "710350425",
            "speakerId": 1002,
            "speakerName": "王平安",
            "text": "我现在不是了啊！我现在可是个正经人，我不都在仙师面前立誓了吗！"
          }
        }
      }

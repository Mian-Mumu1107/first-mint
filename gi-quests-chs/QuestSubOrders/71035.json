    {
      "subId": "7103503",
      "subQuestName": "前往拜祭铜雀",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "710350301"
        ],
        "dialogs": {
          "710350301": {
            "id": "710350301",
            "speakerId": 1002,
            "speakerName": "王平安",
            "text": "谢谢仙师，谢谢英雄…真是巧了，又遇见您了。",
            "nextDialogs": [
              "710350302"
            ]
          },
          "710350302": {
            "id": "710350302",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "你认识我们？",
            "nextDialogs": [
              "710350303"
            ]
          },
          "710350303": {
            "id": "710350303",
            "speakerId": 1002,
            "speakerName": "王平安",
            "text": "我怎么敢忘了仙师的样子呢…",
            "nextDialogs": [
              "710350304"
            ]
          },
          "710350304": {
            "id": "710350304",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "你是…",
            "nextDialogs": [
              "710350305"
            ]
          },
          "710350305": {
            "id": "710350305",
            "speakerId": 1002,
            "speakerName": "王平安",
            "text": "哎呀，我叫王平安！您想起来了吗？",
            "nextDialogs": [
              "710350307",
              "710350309"
            ]
          },
          "710350307": {
            "id": "710350307",
            "speakerId": 1002,
            "speakerName": "王平安",
            "text": "啊？！别别别千万别，什么「掇星攫辰」，您可别损我了，仙师还在这呢…",
            "nextDialogs": [
              "710350310"
            ]
          },
          "710350310": {
            "id": "710350310",
            "speakerId": 1002,
            "speakerName": "王平安",
            "text": "我正准备去山里的一座供奉着夜叉「铜雀」的庙看看呢。",
            "nextDialogs": [
              "710350311"
            ]
          },
          "710350311": {
            "id": "710350311",
            "speakerId": 1002,
            "speakerName": "王平安",
            "text": "但刚进山不久，就被那群盗宝团盯上了…多谢仙师相救。",
            "nextDialogs": [
              "710350312"
            ]
          },
          "710350312": {
            "id": "710350312",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "等一下，你去铜雀先生的庙做什么？",
            "nextDialogs": [
              "710350313"
            ]
          },
          "710350313": {
            "id": "710350313",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "难不成…你在打铜雀先生雕像的主意？",
            "nextDialogs": [
              "710350314"
            ]
          },
          "710350314": {
            "id": "710350314",
            "speakerId": 1002,
            "speakerName": "王平安",
            "text": "没有！我绝不会有这种想法！",
            "nextDialogs": [
              "710350315"
            ]
          },
          "710350315": {
            "id": "710350315",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "那你想做什么？",
            "nextDialogs": [
              "710350316"
            ]
          },
          "710350316": {
            "id": "710350316",
            "speakerId": 1002,
            "speakerName": "王平安",
            "text": "我是…想要重修一下那座庙。",
            "nextDialogs": [
              "710350317"
            ]
          },
          "710350317": {
            "id": "710350317",
            "speakerId": 1002,
            "speakerName": "王平安",
            "text": "我今天过来，本来是准备再仔细看看那座庙的情况，好回去购置材料。",
            "nextDialogs": [
              "710350318"
            ]
          },
          "710350318": {
            "id": "710350318",
            "speakerId": 1002,
            "speakerName": "王平安",
            "text": "没想到，半路上被盗宝团给盯上了，只能逃跑。",
            "nextDialogs": [
              "710350319"
            ]
          },
          "710350319": {
            "id": "710350319",
            "speakerId": 1002,
            "speakerName": "王平安",
            "text": "但我跑着跑着就…迷路了。后面的事，您都知道了。",
            "nextDialogs": [
              "710350320"
            ]
          },
          "710350320": {
            "id": "710350320",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "去庙那边详细说吧。",
            "nextDialogs": [
              "710350321"
            ]
          },
          "710350321": {
            "id": "710350321",
            "speakerId": 1002,
            "speakerName": "王平安",
            "text": "对，这里不是谈话的地方，我们先去庙那边。",
            "nextDialogs": [
              "710350322"
            ]
          },
          "710350322": {
            "id": "710350322",
            "speakerId": 1002,
            "speakerName": "王平安",
            "text": "有什么话，我们到那边再说。",
            "nextDialogs": [
              "710350323"
            ]
          },
          "710350323": {
            "id": "710350323",
            "speakerId": 1003,
            "speakerName": "魈",
            "text": "你们去吧，我还有事。",
            "nextDialogs": [
              "710350324"
            ]
          },
          "710350324": {
            "id": "710350324",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "欸！你要走吗？",
            "nextDialogs": [
              "710350325"
            ]
          },
          "710350325": {
            "id": "710350325",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "已经…走掉了啊…"
          },
          "710350309": {
            "id": "710350309",
            "speakerId": 1002,
            "speakerName": "王平安",
            "text": "多亏您还记着。"
          }
        }
      }
    },
    {
      "subId": "7103504",
      "subQuestName": "与魈对话",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "710350201"
        ],
        "dialogs": {
          "710350201": {
            "id": "710350201",
            "speakerId": 1003,
            "speakerName": "魈",
            "text": "你怎么来了？",
            "nextDialogs": [
              "710350202"
            ]
          },
          "710350202": {
            "id": "710350202",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "你也是来看铜雀的吗？",
            "nextDialogs": [
              "710350203"
            ]
          },
          "710350203": {
            "id": "710350203",
            "speakerId": 1003,
            "speakerName": "魈",
            "text": "只是路过此处，驻足片刻罢了。",
            "nextDialogs": [
              "710350204"
            ]
          },
          "710350204": {
            "id": "710350204",
            "speakerId": 1003,
            "speakerName": "魈",
            "text": "你们来，是有什么事吗？",
            "nextDialogs": [
              "710350205"
            ]
          },
          "710350205": {
            "id": "710350205",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "我们是来看铜雀先生的！",
            "nextDialogs": [
              "710350206"
            ]
          },
          "710350206": {
            "id": "710350206",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "不过，这周围还是和上次一样，简直是一团乱啊…",
            "nextDialogs": [
              "710350207"
            ]
          },
          "710350207": {
            "id": "710350207",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "明明建了庙，也做了雕像…怎么没人过来维护一下呢？",
            "nextDialogs": [
              "710350208"
            ]
          },
          "710350208": {
            "id": "710350208",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "也许是忘了吧。",
            "nextDialogs": [
              "710350209"
            ]
          },
          "710350209": {
            "id": "710350209",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "这也能忘记吗？夜叉明明是保护了璃月港的大英雄…",
            "nextDialogs": [
              "710350210"
            ]
          },
          "710350210": {
            "id": "710350210",
            "speakerId": 1003,
            "speakerName": "魈",
            "text": "……",
            "nextDialogs": [
              "710350211"
            ]
          },
          "710350211": {
            "id": "710350211",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "魈…你、你是不高兴了吗？",
            "nextDialogs": [
              "710350212"
            ]
          },
          "710350212": {
            "id": "710350212",
            "speakerId": 1003,
            "speakerName": "魈",
            "text": "没有，夜叉但行守护之责，本就无意寻求什么后人纪念。",
            "nextDialogs": [
              "710350213"
            ]
          },
          "710350213": {
            "id": "710350213",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "不说这些了，我们快点来吃烤吃虎鱼吧！",
            "nextDialogs": [
              "710350214"
            ]
          },
          "710350214": {
            "id": "710350214",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "唔…要是魈也想吃的话，我们可以各自把烤吃虎鱼切一半给你喔。",
            "nextDialogs": [
              "710350215"
            ]
          },
          "710350215": {
            "id": "710350215",
            "speakerId": 1003,
            "speakerName": "魈",
            "text": "不必了…",
            "nextDialogs": [
              "710350216"
            ]
          },
          "710350216": {
            "id": "710350216",
            "speakerId": 1004,
            "speakerName": "？？？",
            "text": "救命啊！救命啊！",
            "nextDialogs": [
              "710350217"
            ]
          },
          "710350217": {
            "id": "710350217",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "咦？我好像听见了什么声音…",
            "nextDialogs": [
              "710350218"
            ]
          },
          "710350218": {
            "id": "710350218",
            "speakerId": 1003,
            "speakerName": "魈",
            "text": "有人呼救，在那边！",
            "nextDialogs": [
              "710350219"
            ]
          },
          "710350219": {
            "id": "710350219",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "快走！",
            "nextDialogs": [
              "710350220"
            ]
          },
          "710350220": {
            "id": "710350220",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "欸？把烤吃虎鱼收好呀！我还没吃呢！"
          }
        }
      }
    },

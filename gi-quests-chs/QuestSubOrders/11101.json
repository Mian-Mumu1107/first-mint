      }
    },
    {
      "subId": "1110107",
      "subQuestName": "与「掇星攫辰天君」对话，了解情况",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "111010701"
        ],
        "dialogs": {
          "111010701": {
            "id": "111010701",
            "speakerId": 1001,
            "speakerName": "掇星攫辰天君",
            "text": "怎么会的…「百无禁忌箓」怎么会没有效果呢…",
            "nextDialogs": [
              "111010702"
            ]
          },
          "111010702": {
            "id": "111010702",
            "speakerId": 1001,
            "speakerName": "掇星攫辰天君",
            "text": "这些丘丘人身上的邪气又变强了吗…",
            "nextDialogs": [
              "111010703"
            ]
          },
          "111010703": {
            "id": "111010703",
            "speakerId": 1002,
            "speakerName": "派蒙",
            "text": "「百无禁忌箓」…好像有点耳熟？",
            "nextDialogs": [
              "111010706"
            ]
          },
          "111010706": {
            "id": "111010706",
            "speakerId": 1002,
            "speakerName": "派蒙",
            "text": "对了，是那个！仙人的「信物」，上面一定残留着仙人的力量！",
            "nextDialogs": [
              "111010707"
            ]
          },
          "111010707": {
            "id": "111010707",
            "speakerId": 1002,
            "speakerName": "派蒙",
            "text": "怪不得他上次能用这个把怪物吓跑…",
            "nextDialogs": [
              "111010708"
            ]
          },
          "111010708": {
            "id": "111010708",
            "speakerId": 1001,
            "speakerName": "掇星攫辰天君",
            "text": "你、你们在念叨什么呢，这不过是本仙昨晚没睡好…仙力未能通达六脉而已！",
            "nextDialogs": [
              "111010709"
            ]
          },
          "111010709": {
            "id": "111010709",
            "speakerId": 1001,
            "speakerName": "掇星攫辰天君",
            "text": "如果再给我一次机会的话…",
            "nextDialogs": [
              "111010710"
            ]
          },
          "111010710": {
            "id": "111010710",
            "speakerId": 1002,
            "speakerName": "派蒙",
            "text": "又有「邪恶丘丘人」往那边去了，那这次可以交给你么？",
            "nextDialogs": [
              "111010711"
            ]
          },
          "111010711": {
            "id": "111010711",
            "speakerId": 1001,
            "speakerName": "掇星攫辰天君",
            "text": "我…本、本仙忽然觉得身体有恙，定是方才仙力耗损太多所致，不然我必斩尽这些妖邪…",
            "nextDialogs": [
              "111010712"
            ]
          },
          "111010712": {
            "id": "111010712",
            "speakerId": 1002,
            "speakerName": "派蒙",
            "text": "唉…果然是吹牛大王，没有错怪你。",
            "nextDialogs": [
              "111010713"
            ]
          },
          "111010713": {
            "id": "111010713",
            "speakerId": 1002,
            "speakerName": "派蒙",
            "text": "旅行者，还是我们追上去看看吧，用「元素视野」可以方便追踪哦。"
          }
        }
      }
    },
    {
      "subId": "1110020",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "111002001"
        ],
        "dialogs": {
          "111002001": {
            "id": "111002001",
            "speakerId": 1004,
            "speakerName": "男性信众",
            "text": "家里还有些值钱物件，若「天君」不嫌弃，明天也给您拿来。"
          }
        }
      }
    },
    {
      "subId": "1110021",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "111002101"
        ],
        "dialogs": {
          "111002101": {
            "id": "111002101",
            "speakerId": 1005,
            "speakerName": "女性信众",
            "text": "有「星辰天君」在，当然放心…"
          }
        }
      }
    },
    {
      "subId": "1110022",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "111002201"
        ],
        "dialogs": {
          "111002201": {
            "id": "111002201",
            "speakerId": 1006,
            "speakerName": "商人信众",
            "text": "还望「天君」多多照顾…"
          }
        }
      }
    },
    {
      "subId": "1110110",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "111011001"
        ],
        "dialogs": {
          "111011001": {
            "id": "111011001",
            "speakerId": 1002,
            "speakerName": "派蒙",
            "text": "感觉在璃月的史料里属于冷门的一派呢，有什么值得注意的地方吗？"
          }
        }
      }
    },
    {
      "subId": "1110111",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "111011101"
        ],
        "dialogs": {
          "111011101": {
            "id": "111011101",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "关于「妖邪」…",
            "nextDialogs": [
              "111011102"
            ]
          },
          "111011102": {
            "id": "111011102",
            "speakerId": 1002,
            "speakerName": "派蒙",
            "text": "书里讲的是，「魔神战争」时期战败魔神的怨念，可能会产生瘟疫、鬼怪与异变…",
            "nextDialogs": [
              "111011103"
            ]
          },
          "111011103": {
            "id": "111011103",
            "speakerId": 1002,
            "speakerName": "派蒙",
            "text": "都是些不得了的灾难呢——咦？难道说…",
            "nextDialogs": [
              "111011104"
            ]
          },
          "111011104": {
            "id": "111011104",
            "speakerId": 1002,
            "speakerName": "派蒙",
            "text": "之前看到的那些满身邪气的丘丘人，该不会就是这里所说的「异变」吧？"
          }
        }
      }
    },
    {
      "subId": "1110112",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "111011201"
        ],
        "dialogs": {
          "111011201": {
            "id": "111011201",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "关于「业障」…",
            "nextDialogs": [
              "111011202"
            ]
          },
          "111011202": {
            "id": "111011202",
            "speakerId": 1002,
            "speakerName": "派蒙",
            "text": "书中说，与魔神怨念斗争了千年的「夜叉」们，也会被「业障」所困。",
            "nextDialogs": [
              "111011203"
            ]
          },
          "111011203": {
            "id": "111011203",
            "speakerId": 1002,
            "speakerName": "派蒙",
            "text": "被魔神怨念污染的夜叉，常常会陷入难以言喻的恐惧、狂怒和痛苦…",
            "nextDialogs": [
              "111011204"
            ]
          },
          "111011204": {
            "id": "111011204",
            "speakerId": 1002,
            "speakerName": "派蒙",
            "text": "唉…辛苦守护璃月上千年，不仅没有回报，还要忍受这样的折磨，真是太可怜啦。"
          }
        }
      }
    },
    {
      "subId": "1110113",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "111011301"
        ],
        "dialogs": {
          "111011301": {
            "id": "111011301",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "关于「最后一位夜叉」…",
            "nextDialogs": [
              "111011302"
            ]
          },
          "111011302": {
            "id": "111011302",
            "speakerId": 1002,
            "speakerName": "派蒙",
            "text": "嗯，据说一共有五位「夜叉」，如今仅剩一位存活。",
            "nextDialogs": [
              "111011303"
            ]
          },
          "111011303": {
            "id": "111011303",
            "speakerId": 1002,
            "speakerName": "派蒙",
            "text": "该不会…跟那个「天君」有什么瓜葛吧？",
            "nextDialogs": [
              "111011304"
            ]
          },
          "111011304": {
            "id": "111011304",
            "speakerId": 1002,
            "speakerName": "派蒙",
            "text": "但怎么想都不是他本人，毕竟他看起来一点也不像长期忍受折磨的样子…"
          }
        }
      }
    },
    {
      "subId": "1110123",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "111012301"
        ],
        "dialogs": {
          "111012301": {
            "id": "111012301",
            "speakerId": 1001,
            "speakerName": "掇星攫辰天君",
            "text": "各位也都是一样…只要意思到了，愿望定会实现，大可放心。"
          }
        }
      }
    }
  ]
}
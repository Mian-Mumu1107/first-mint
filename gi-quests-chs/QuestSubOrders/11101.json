    {
      "subId": "1110108",
      "subQuestName": "(test)大仙买书$HIDDEN",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "111010201"
        ],
        "dialogs": {
          "111010201": {
            "id": "111010201",
            "speakerId": 1000,
            "speakerName": "纪芳",
            "text": "就要这一本吗，《护法仙众夜叉录》？",
            "nextDialogs": [
              "111010202"
            ]
          },
          "111010202": {
            "id": "111010202",
            "speakerId": 1001,
            "speakerName": "掇星攫辰天君",
            "text": "嗯，这些给你，不用找了。",
            "nextDialogs": [
              "111010203"
            ]
          },
          "111010203": {
            "id": "111010203",
            "speakerId": 1000,
            "speakerName": "纪芳",
            "text": "老板阔气，阔气…谢谢惠顾！",
            "nextDialogs": [
              "111010204"
            ]
          },
          "111010204": {
            "id": "111010204",
            "speakerId": 1002,
            "speakerName": "派蒙",
            "text": "这不是那位「多星缺辰天君」吗？怎么又在这里碰到了。",
            "nextDialogs": [
              "111010207"
            ]
          },
          "111010207": {
            "id": "111010207",
            "speakerId": 1002,
            "speakerName": "派蒙",
            "text": "我好像听到他刚才买的书叫…《护法仙众夜叉录》？",
            "nextDialogs": [
              "111010208"
            ]
          },
          "111010208": {
            "id": "111010208",
            "speakerId": 1002,
            "speakerName": "派蒙",
            "text": "记得好像是一本关于仙人的书来着，仙人为什么会买有关自己的书呢？"
          }
        }
      }
    },
    {
      "subId": "1110102",
      "subQuestName": "与纪芳对话，询问《护法仙众夜叉录》的情况",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "111010222"
        ],
        "dialogs": {
          "111010222": {
            "id": "111010222",
            "speakerId": 1002,
            "speakerName": "派蒙",
            "text": "你好，我们想要一本《护法仙众夜叉录》！",
            "nextDialogs": [
              "111010223"
            ]
          },
          "111010223": {
            "id": "111010223",
            "speakerId": 1000,
            "speakerName": "纪芳",
            "text": "嗯？这种老书什么时候翻身成了畅销书了？",
            "nextDialogs": [
              "111010224"
            ]
          },
          "111010224": {
            "id": "111010224",
            "speakerId": 1000,
            "speakerName": "纪芳",
            "text": "难得有年轻人喜欢，去书架那边自己找找吧。"
          }
        }
      }
    },
    {
      "subId": "1110103",
      "subQuestName": "找到《护法仙众夜叉录》",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "111010301"
        ],
        "dialogs": {
          "111010301": {
            "id": "111010301",
            "speakerId": 1002,
            "speakerName": "派蒙",
            "text": "就是这一本！赶快打开看看讲的是什么吧？",
            "nextDialogs": [
              "111010302"
            ]
          },
          "111010302": {
            "id": "111010302",
            "speakerId": 1002,
            "speakerName": "派蒙",
            "text": "……",
            "nextDialogs": [
              "111010401"
            ]
          },
          "111010401": {
            "id": "111010401",
            "speakerId": 1002,
            "speakerName": "派蒙",
            "text": "读完了吗？派蒙比你先读完的，嘿嘿。",
            "nextDialogs": [
              "111010402"
            ]
          },
          "111010402": {
            "id": "111010402",
            "speakerId": 1002,
            "speakerName": "派蒙",
            "text": "这是一本有关守护着璃月的「仙众夜叉」们的书。"
          }
        }
      }
    },
    {
      "subId": "1110104",
      "subQuestName": "(test)与派蒙对话$HIDDEN",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "111011401"
        ],
        "dialogs": {
          "111011401": {
            "id": "111011401",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "没什么其他值得注意的了…",
            "nextDialogs": [
              "111011402"
            ]
          },
          "111011402": {
            "id": "111011402",
            "speakerId": 1002,
            "speakerName": "派蒙",
            "text": "嗯，书里的关键点，刚才都已经总结出来啦。",
            "nextDialogs": [
              "111011403"
            ]
          },
          "111011403": {
            "id": "111011403",
            "speakerId": 1002,
            "speakerName": "派蒙",
            "text": "这么看，满身邪气的丘丘人的来源，还有「天君」与夜叉的关系，是这次事件的疑点呢！",
            "nextDialogs": [
              "111011404"
            ]
          },
          "111011404": {
            "id": "111011404",
            "speakerId": 1002,
            "speakerName": "派蒙",
            "text": "有必要再回去确认一下现场了！让我们拨开绝云间的迷雾，直达那闪耀的真相吧！",
            "nextDialogs": [
              "111011407"
            ]
          },
          "111011407": {
            "id": "111011407",
            "speakerId": 1002,
            "speakerName": "派蒙",
            "text": "欸嘿嘿，其实我还挺希望他是真正的仙人呀，而且，他驱魔的手艺好像是货真价实的。",
            "nextDialogs": [
              "111011408"
            ]
          },
          "111011408": {
            "id": "111011408",
            "speakerId": 1002,
            "speakerName": "派蒙",
            "text": "但是希望越大就可能失望越大嘛，所以提前调查清楚还是有必要的吧？",
            "nextDialogs": [
              "111011409"
            ]
          },
          "111011409": {
            "id": "111011409",
            "speakerId": 1002,
            "speakerName": "派蒙",
            "text": "我们走吧，再到望舒客栈那边去看看！"
          }
        }
      }
    },
    {
      "subId": "1110105",
      "subQuestName": "回到望舒客栈附近，寻找「掇星攫辰天君」",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "111010501"
        ],
        "dialogs": {
          "111010501": {
            "id": "111010501",
            "speakerId": 1001,
            "speakerName": "掇星攫辰天君",
            "text": "如我敕令，恶鬼退散！",
            "nextDialogs": [
              "111010502"
            ]
          },
          "111010502": {
            "id": "111010502",
            "speakerId": 1001,
            "speakerName": "掇星攫辰天君",
            "text": "退散——！",
            "nextDialogs": [
              "111010503"
            ]
          },
          "111010503": {
            "id": "111010503",
            "speakerId": 1001,
            "speakerName": "掇星攫辰天君",
            "text": "快，快退散哪？！",
            "nextDialogs": [
              "111010504"
            ]
          },
          "111010504": {
            "id": "111010504",
            "speakerId": 1003,
            "speakerName": "丘丘人",
            "text": "Beru nye！Beru nya！Beru nyaaaa！！！",
            "nextDialogs": [
              "111010505"
            ]
          },
          "111010505": {
            "id": "111010505",
            "speakerId": 1002,
            "speakerName": "派蒙",
            "text": "糟了，「天君」好像不管用了！",
            "nextDialogs": [
              "111010506"
            ]
          },
          "111010506": {
            "id": "111010506",
            "speakerId": 1002,
            "speakerName": "派蒙",
            "text": "附近还有普通民众在，不能放手不管了，我们快去帮忙吧！"
          }
        }
      }
    },
    {
      "subId": "1110106",
      "subQuestName": "消灭沾染「邪气」的丘丘人",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [],

    {
      "subId": "7320501",
      "subQuestName": "(test)与阿凡对话$HIDDEN",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "732050101"
        ],
        "dialogs": {
          "732050101": {
            "id": "732050101",
            "speakerId": 1000,
            "speakerName": "阿凡",
            "text": "来，来，看看这些种子。",
            "nextDialogs": [
              "732050102"
            ]
          },
          "732050102": {
            "id": "732050102",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "好像没什么变化。",
            "nextDialogs": [
              "732050103"
            ]
          },
          "732050103": {
            "id": "732050103",
            "speakerId": 1000,
            "speakerName": "阿凡",
            "text": "是啊，虽然我种地种了好多年，但种花跟种地还是不同。",
            "nextDialogs": [
              "732050104"
            ]
          },
          "732050104": {
            "id": "732050104",
            "speakerId": 1000,
            "speakerName": "阿凡",
            "text": "要不然，为什么这么久它们都不长呢？",
            "nextDialogs": [
              "732050105"
            ]
          },
          "732050105": {
            "id": "732050105",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "我看看，唔…",
            "nextDialogs": [
              "732050106"
            ]
          },
          "732050106": {
            "id": "732050106",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "阿凡爷爷，我觉得你的苗圃太干燥了，阿如村附近土地的养分也可能不够。",
            "nextDialogs": [
              "732050107"
            ]
          },
          "732050107": {
            "id": "732050107",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "我们之前在村子里帮人种过花，我们有经验。",
            "nextDialogs": [
              "732050108"
            ]
          },
          "732050108": {
            "id": "732050108",
            "speakerId": 1000,
            "speakerName": "阿凡",
            "text": "哦，是这样吗…",
            "nextDialogs": [
              "732050109"
            ]
          },
          "732050109": {
            "id": "732050109",
            "speakerId": 1000,
            "speakerName": "阿凡",
            "text": "有道理，这么稀有的花种是应该比普通花草娇贵点，我浇水施肥确实不够。",
            "nextDialogs": [
              "732050110"
            ]
          },
          "732050110": {
            "id": "732050110",
            "speakerId": 1000,
            "speakerName": "阿凡",
            "text": "不过这块苗圃离水源有点远，取水不方便。",
            "nextDialogs": [
              "732050111"
            ]
          },
          "732050111": {
            "id": "732050111",
            "speakerId": 1000,
            "speakerName": "阿凡",
            "text": "我自己储存的日常用水也不多，要常给苗圃里的种子浇水还有点麻烦。",
            "nextDialogs": [
              "732050112"
            ]
          },
          "732050112": {
            "id": "732050112",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "我可以帮忙。",
            "nextDialogs": [
              "732050113"
            ]
          },
          "732050113": {
            "id": "732050113",
            "speakerId": 1000,
            "speakerName": "阿凡",
            "text": "好啊，那就先请你们给这三颗种子都浇些水吧。"
          }
        }
      }
    },
    {
      "subId": "7320502",
      "subQuestName": "给花种浇水",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [],
        "dialogs": {}
      }
    },
    {
      "subId": "7320503",
      "subQuestName": "和阿凡聊聊",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "732050301"
        ],
        "dialogs": {
          "732050301": {
            "id": "732050301",
            "speakerId": 1000,
            "speakerName": "阿凡",
            "text": "挺好，挺好，你们两个很有办法啊。",
            "nextDialogs": [
              "732050302"
            ]
          },
          "732050302": {
            "id": "732050302",
            "speakerId": 1000,
            "speakerName": "阿凡",
            "text": "我预感，有专业人士指导，这次应该能长好了。",
            "nextDialogs": [
              "732050303"
            ]
          },
          "732050303": {
            "id": "732050303",
            "speakerId": 1000,
            "speakerName": "阿凡",
            "text": "之前的烤肉卷和米圆塔好吃不好吃？",
            "nextDialogs": [
              "732050305"
            ]
          },
          "732050305": {
            "id": "732050305",
            "speakerId": 1000,
            "speakerName": "阿凡",
            "text": "好吃我再给你们做点。",
            "nextDialogs": [
              "732050307"
            ]
          },
          "732050307": {
            "id": "732050307",
            "speakerId": 1000,
            "speakerName": "阿凡",
            "text": "我的手艺没有我家去世的老太婆好，你们不许嫌弃。拿着吧，这次少了点。",
            "nextDialogs": [
              "732050308"
            ]
          },
          "732050308": {
            "id": "732050308",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "是好吃的！阿凡爷爷，你真好，以后我们也会常来看你的。",
            "nextDialogs": [
              "732050309"
            ]
          },
          "732050309": {
            "id": "732050309",
            "speakerId": 1000,
            "speakerName": "阿凡",
            "text": "哈哈，你们之前不是想问我，这花是什么花吗？",
            "nextDialogs": [
              "732050310"
            ]
          },
          "732050310": {
            "id": "732050310",
            "speakerId": 1000,
            "speakerName": "阿凡",
            "text": "告诉你们也不碍事，我种的都是蔷薇。",
            "nextDialogs": [
              "732050311"
            ]
          },
          "732050311": {
            "id": "732050311",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "跟须弥蔷薇是同一种花吗？",
            "nextDialogs": [
              "732050312"
            ]
          },
          "732050312": {
            "id": "732050312",
            "speakerId": 1000,
            "speakerName": "阿凡",
            "text": "这种花叫作「金蔷薇」，哎呀，可比须弥蔷薇宝贝多了。",
            "nextDialogs": [
              "732050313"
            ]
          },
          "732050313": {
            "id": "732050313",
            "speakerId": 1000,
            "speakerName": "阿凡",
            "text": "我之前说这些花种都是一位朋友留给我的，你们还记得吗？",
            "nextDialogs": [
              "732050314"
            ]
          },
          "732050314": {
            "id": "732050314",
            "speakerId": 1000,
            "speakerName": "阿凡",
            "text": "其实啊，这些种子、我现在住的这间旧屋子都是死掉的鬼老头留给我的。",
            "nextDialogs": [
              "732050315"
            ]
          },
          "732050315": {
            "id": "732050315",
            "speakerId": 1000,
            "speakerName": "阿凡",
            "text": "欸，我给忘了，你们不是阿如村的人，肯定不熟悉这个名字。",
            "nextDialogs": [
              "732050316"
            ]
          },
          "732050316": {
            "id": "732050316",
            "speakerId": 1000,
            "speakerName": "阿凡",
            "text": "不熟悉也好，就把这家伙当成一个会种点花的老头记住，就好了…",
            "nextDialogs": [
              "732050317"
            ]
          },
          "732050317": {
            "id": "732050317",
            "speakerId": 1000,
            "speakerName": "阿凡",
            "text": "……",
            "nextDialogs": [
              "732050318"
            ]
          },
          "732050318": {
            "id": "732050318",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "阿凡爷爷突然发起呆来了呢，阿凡爷爷，阿凡爷爷？",
            "nextDialogs": [
              "732050319"
            ]
          },
          "732050319": {
            "id": "732050319",
            "speakerId": 1000,
            "speakerName": "阿凡",
            "text": "哎哟，我刚才是不是走神了？人年纪大了，注意力不容易集中，叫你们看笑话了。",
            "nextDialogs": [
              "732050320"
            ]
          },
          "732050320": {
            "id": "732050320",
            "speakerId": 1000,
            "speakerName": "阿凡",
            "text": "这次也谢谢你们两个小娃娃，你们要是还有什么想看的，就到处转转好了。",
            "nextDialogs": [
              "732050321"
            ]
          },
          "732050321": {
            "id": "732050321",
            "speakerId": 1000,
            "speakerName": "阿凡",
            "text": "我不会再赶人了，不过当心，别踩到苗圃上去。"
          }
        }
      }
    },
    {
      "subId": "7320504",
      "subQuestName": "给花种浇水",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "732050401"
        ],
        "dialogs": {
          "732050401": {
            "id": "732050401",
            "speakerId": 1000,
            "speakerName": "阿凡",
            "text": "先给这三颗种子浇点水吧，施肥的事情我再想办法。",
            "nextDialogs": [
              "732050402"
            ]
          },
          "732050402": {
            "id": "732050402",
            "speakerId": 1000,
            "speakerName": "阿凡",
            "text": "过了几十年，简单的肥料该怎么做我还是懂的。"
          }
        }
      }
    },
    {
      "subId": "7320505",
      "subQuestName": "给花种浇水",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "732050501"
        ],
        "dialogs": {
          "732050501": {
            "id": "732050501",
            "speakerId": 1000,
            "speakerName": "阿凡",
            "text": "♪蔷薇啊蔷薇，实现我的愿望…",
            "nextDialogs": [
              "732050502"
            ]
          },
          "732050502": {
            "id": "732050502",
            "speakerId": 1000,
            "speakerName": "阿凡",
            "text": "嗯？你们还在啊。",
            "nextDialogs": [
              "732050504",
              "732050514"
            ]
          },
          "732050504": {
            "id": "732050504",
            "speakerId": 1000,
            "speakerName": "阿凡",
            "text": "呵呵，反正我是个怪老头，「怪老头做事哪有为什么」，很少有人像你这样问我。",
            "nextDialogs": [
              "732050505"
            ]
          },
          "732050505": {
            "id": "732050505",
            "speakerId": 1000,
            "speakerName": "阿凡",
            "text": "我啊，这一辈子总想出去闯荡，想抓住机会做点什么。",
            "nextDialogs": [
              "732050506"
            ]
          },
          "732050506": {
            "id": "732050506",
            "speakerId": 1000,
            "speakerName": "阿凡",
            "text": "刚结婚不久的时候差点儿跟着镀金旅团离开，但想想总觉得不能抛下老婆出去漂泊。",
            "nextDialogs": [
              "732050507"
            ]
          },
          "732050507": {
            "id": "732050507",
            "speakerId": 1000,
            "speakerName": "阿凡",
            "text": "后来遇到行脚商，我又想跟着出去跑生意，最终因为本钱不够没走成。",
            "nextDialogs": [
              "732050508"
            ]
          },
          "732050508": {
            "id": "732050508",
            "speakerId": 1000,
            "speakerName": "阿凡",
            "text": "再后来老太婆不在了，我没牵挂了，可是年纪已经太老，没法离开了。",
            "nextDialogs": [
              "732050509"
            ]
          },
          "732050509": {
            "id": "732050509",
            "speakerId": 1000,
            "speakerName": "阿凡",
            "text": "拖拖拉拉混到今天，我错过的事情太多。",
            "nextDialogs": [
              "732050510"
            ]
          },
          "732050510": {
            "id": "732050510",
            "speakerId": 1000,
            "speakerName": "阿凡",
            "text": "回过头发现自己不属于这个村子，也不属于其他任何地方。",
            "nextDialogs": [
              "732050511"
            ]
          },
          "732050511": {
            "id": "732050511",
            "speakerId": 1000,
            "speakerName": "阿凡",
            "text": "最后结果么，就是我一个人搬到村子边上生活才舒服。",
            "nextDialogs": [
              "732050512"
            ]
          },
          "732050512": {
            "id": "732050512",
            "speakerId": 1000,
            "speakerName": "阿凡",
            "text": "几十年也就这么回事，算了。",
            "nextDialogs": [
              "732050525"
            ]
          },
          "732050525": {
            "id": "732050525",
            "speakerId": 1000,
            "speakerName": "阿凡",
            "text": "这些花开了我就叫你们来看，明天或者后天，它们说不定就开了，你有空来看吧？",
            "nextDialogs": [
              "732050526"
            ]
          },
          "732050526": {
            "id": "732050526",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "没问题。",
            "nextDialogs": [
              "732050527"
            ]
          },
          "732050527": {
            "id": "732050527",
            "speakerId": 1000,
            "speakerName": "阿凡",
            "text": "好好好，我知道了…",
            "nextDialogs": [
              "732050528"
            ]
          },
          "732050528": {
            "id": "732050528",
            "speakerId": 1000,
            "speakerName": "阿凡",
            "text": "♪蔷薇啊蔷薇，实现我的愿望…"
          },
          "732050514": {
            "id": "732050514",
            "speakerId": 1000,
            "speakerName": "阿凡",
            "text": "也就只有外来的人会打听鬼老头的事了，我们村里的小孩可都知道这个名字。",
            "nextDialogs": [
              "732050515"
            ]
          },
          "732050515": {
            "id": "732050515",
            "speakerId": 1000,
            "speakerName": "阿凡",
            "text": "哪家孩子不听话，孩子的父母就吓唬他：马上鬼老头要来把你抓走了。",
            "nextDialogs": [
              "732050516"
            ]
          },
          "732050516": {
            "id": "732050516",
            "speakerId": 1000,
            "speakerName": "阿凡",
            "text": "这些年轻人啊，一个都不认识鬼老头，倒挺会把他的名头搬出来吓人。",
            "nextDialogs": [
              "732050517"
            ]
          },
          "732050517": {
            "id": "732050517",
            "speakerId": 1000,
            "speakerName": "阿凡",
            "text": "我小的时候可是见过鬼老头本人的，他是讨厌小孩子没错，但长得也不恐怖。",
            "nextDialogs": [
              "732050518"
            ]
          },
          "732050518": {
            "id": "732050518",
            "speakerId": 1000,
            "speakerName": "阿凡",
            "text": "不知道怎么就被传成了鬼老头，我看都是一帮闲人在背后胡说八道。",
            "nextDialogs": [
              "732050519"
            ]
          },
          "732050519": {
            "id": "732050519",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "你们不是朋友吗？",
            "nextDialogs": [
              "732050520"
            ]
          },
          "732050520": {
            "id": "732050520",
            "speakerId": 1000,
            "speakerName": "阿凡",
            "text": "我还小的时候，经常溜到他的小花园附近玩，他一发现，就会挥着锄头把我赶走。",
            "nextDialogs": [
              "732050521"
            ]
          },
          "732050521": {
            "id": "732050521",
            "speakerId": 1000,
            "speakerName": "阿凡",
            "text": "他八成只把我当成去捣乱的调皮小子，哪里会记得我哟。",
            "nextDialogs": [
              "732050522"
            ]
          },
          "732050522": {
            "id": "732050522",
            "speakerId": 1000,
            "speakerName": "阿凡",
            "text": "虽然他不一定认识我，但我还是一直记得他和他的小花园。",
            "nextDialogs": [
              "732050523"
            ]
          },
          "732050523": {
            "id": "732050523",
            "speakerId": 1000,
            "speakerName": "阿凡",
            "text": "我说他是我的朋友，也不算错，不是吗？",
            "nextDialogs": [
              "732050524"
            ]
          },
          "732050524": {
            "id": "732050524",
            "speakerId": 1000,
            "speakerName": "阿凡",
            "text": "就当是为了还原我记忆里的小花园，我也会把这些花种出来的。"
          }
        }
      }
    },
    {
      "subId": "7320506",

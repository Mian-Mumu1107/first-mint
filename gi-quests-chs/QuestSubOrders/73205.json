{
  "lineCounts": {
    "Player": 13,
    "派蒙": 5,
    "阿凡": 56
  },
  "subQuests": [
    {
      "subId": "7320507",
      "subQuestName": "(test)73204与阿凡闲聊$HIDDEN",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "732040701"
        ],
        "dialogs": {
          "732040701": {
            "id": "732040701",
            "speakerId": 1000,
            "speakerName": "阿凡",
            "text": "哎呀，我还没来得及做饭，没东西招待你们哟。",
            "nextDialogs": [
              "732040704"
            ]
          },
          "732040704": {
            "id": "732040704",
            "speakerId": 1000,
            "speakerName": "阿凡",
            "text": "另外一个小娃娃是你的朋友吧，有点可爱。",
            "nextDialogs": [
              "732040705"
            ]
          },
          "732040705": {
            "id": "732040705",
            "speakerId": 1000,
            "speakerName": "阿凡",
            "text": "我种的花开了之后，你们两个要不要来看？",
            "nextDialogs": [
              "732040706"
            ]
          },
          "732040706": {
            "id": "732040706",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "好。",
            "nextDialogs": [
              "732040707"
            ]
          },
          "732040707": {
            "id": "732040707",
            "speakerId": 1000,
            "speakerName": "阿凡",
            "text": "再过阵子它们大概就能开了，你们以后还能来吧，来看看你们帮忙种出来的花嘛。",
            "nextDialogs": [
              "732040708"
            ]
          },
          "732040708": {
            "id": "732040708",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "可以。",
            "nextDialogs": [
              "732040709"
            ]
          },
          "732040709": {
            "id": "732040709",
            "speakerId": 1000,
            "speakerName": "阿凡",
            "text": "好好好，我知道了。",
            "nextDialogs": [
              "732040710"
            ]
          },
          "732040710": {
            "id": "732040710",
            "speakerId": 1000,
            "speakerName": "阿凡",
            "text": "♪…"
          }
        }
      }
    },

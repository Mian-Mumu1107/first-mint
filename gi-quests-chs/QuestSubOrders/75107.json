    },
    {
      "subId": "7510715",
      "subQuestName": "(test)采到第三个木材$HIDDEN",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "751071501"
        ],
        "dialogs": {
          "751071501": {
            "id": "751071501",
            "speakerId": 1002,
            "speakerName": "派蒙",
            "text": "怎么样，有头绪了吗？",
            "nextDialogs": [
              "751071504"
            ]
          },
          "751071504": {
            "id": "751071504",
            "speakerId": 1002,
            "speakerName": "派蒙",
            "text": "啊？被坏人攻击？那边的山上吗？",
            "nextDialogs": [
              "751071505"
            ]
          },
          "751071505": {
            "id": "751071505",
            "speakerId": 1002,
            "speakerName": "派蒙",
            "text": "#{NICKNAME}，你还记得吗，之前我们也是在这附近…从一群偷猎者的手里解救了许多龙，还有外地的野生动物。",
            "nextDialogs": [
              "751071506"
            ]
          },
          "751071506": {
            "id": "751071506",
            "speakerId": 1002,
            "speakerName": "派蒙",
            "text": "难道又是那群人？他们想要抢夺其他人的龙伙伴…是连龙都倒卖的龙贩子？",
            "nextDialogs": [
              "751071507"
            ]
          },
          "751071507": {
            "id": "751071507",
            "speakerId": 1002,
            "speakerName": "派蒙",
            "text": "不管怎么样…躲在幕后伤害别人的龙伙伴，都太可恶了，我们不能放过那些家伙！"
          }
        }
      }
    },
    {
      "subId": "7510716",
      "subQuestName": "(test)采到第四个木材$HIDDEN",
      "sceneId": null,

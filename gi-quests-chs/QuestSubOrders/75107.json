            "speakerId": 1002,
            "speakerName": "派蒙",
            "text": "「高速飞行的石子」…就是那些龙贩子说的易碎弹头吗？",
            "nextDialogs": [
              "751071917"
            ]
          },
          "751071917": {
            "id": "751071917",
            "speakerId": 1002,
            "speakerName": "派蒙",
            "text": "我又有点生气了…",
            "nextDialogs": [
              "751071918"
            ]
          },
          "751071918": {
            "id": "751071918",
            "speakerId": 1009,
            "speakerName": "Black Screen",
            "text": "联系之前解救动物的经历，和派蒙一起向卡克斯讲述了事情的来龙去脉…",
            "nextDialogs": [
              "751071919"
            ]
          },
          "751071919": {
            "id": "751071919",
            "speakerId": 1004,
            "speakerName": "卡克斯",
            "text": "原来「大椰子」是被那伙坏人偷袭，才受了内伤…还好我回来的早，不然后果不堪设想！",
            "nextDialogs": [
              "751071920"
            ]
          },
          "751071920": {
            "id": "751071920",
            "speakerId": 1004,
            "speakerName": "卡克斯",
            "text": "实在可恶，真想给他们两拳…",
            "nextDialogs": [
              "751071921"
            ]
          },
          "751071921": {
            "id": "751071921",
            "speakerId": 1004,
            "speakerName": "卡克斯",
            "text": "不对，两拳太少，让他们分期赔款，每个被他们抢走过龙伙伴的受害者都该给他们两千拳！",
            "nextDialogs": [
              "751071922"
            ]
          },
          "751071922": {
            "id": "751071922",
            "speakerId": 1005,
            "speakerName": "「大椰子」",
            "text": "嗷！",
            "nextDialogs": [
              "751071923"
            ]
          },
          "751071923": {
            "id": "751071923",
            "speakerId": 1002,
            "speakerName": "派蒙",
            "text": "说得对喔！早知如此，我们应该绑几个坏家伙，带到你和「大椰子」面前，让你们亲手揍他们几顿，出出气。",
            "nextDialogs": [
              "751071924"
            ]
          },
          "751071924": {
            "id": "751071924",
            "speakerId": 1004,
            "speakerName": "卡克斯",
            "text": "不过，我们出气的事先放一边，话说回来…",
            "nextDialogs": [
              "751071925"
            ]
          },
          "751071925": {
            "id": "751071925",
            "speakerId": 1004,
            "speakerName": "卡克斯",
            "text": "两位只用一顿早饭的工夫，就覆灭了这个犯罪团伙，实在了不起！"
          }
        }
      }
    },

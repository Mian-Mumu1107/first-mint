            "speakerId": 1002,
            "speakerName": "派蒙",
            "text": "#嗯…好吓人的动静，{REALNAME[ID(2)|SHOWHOST(true)]}干得漂亮！",
            "nextDialogs": [
              "751079903"
            ]
          },
          "751079903": {
            "id": "751079903",
            "speakerId": 1002,
            "speakerName": "派蒙",
            "text": "看来营地里已经乱成一锅粥了！我们现在就出击，把他们一网打尽！",
            "nextDialogs": [

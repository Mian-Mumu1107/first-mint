    {
      "subId": "7510707",
      "subQuestName": "前往对方的活动区侦察",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "751070701"
        ],
        "dialogs": {
          "751070701": {
            "id": "751070701",
            "speakerId": 1006,
            "speakerName": "上方传来的阴险话音",
            "text": "真可惜，被刚才那只绒翼龙逃走了。以它的品相，肯定能卖个好价钱…",
            "nextDialogs": [
              "751070702"
            ]
          },
          "751070702": {
            "id": "751070702",
            "speakerId": 1007,
            "speakerName": "上方传来的狡诈话音",
            "text": "不急不急，老大强化了易碎弹头的威力，新型号能百分百打昏最强壮的突角龙，还不会留下任何痕迹！",
            "nextDialogs": [
              "751070703"
            ]
          },
          "751070703": {
            "id": "751070703",
            "speakerId": 1007,
            "speakerName": "上方传来的狡诈话音",
            "text": "等到新型易碎弹头在兄弟们手里铺货，我们看上哪只龙，就抓哪只龙，迟早发大财！",
            "nextDialogs": [
              "751070704"
            ]
          },
          "751070704": {
            "id": "751070704",
            "speakerId": 1002,
            "speakerName": "派蒙",
            "text": "听见了吗？那些家伙好像真的想要倒卖龙伙伴…是十恶不赦的龙贩子！",
            "nextDialogs": [
              "751070705"
            ]
          },
          "751070705": {
            "id": "751070705",
            "speakerId": 1003,
            "speakerName": "#{REALNAME[ID(2)|SHOWHOST(true)]}",
            "text": "呀！",
            "nextDialogs": [
              "751070706"
            ]
          },
          "751070706": {
            "id": "751070706",
            "speakerId": 1002,
            "speakerName": "派蒙",
            "text": "#哇，{REALNAME[ID(2)|SHOWHOST(true)]}的声音都有点不一样了！看来你也被那些坏家伙气到了？",
            "nextDialogs": [
              "751070707"
            ]
          },
          "751070707": {
            "id": "751070707",
            "speakerId": 1003,
            "speakerName": "#{REALNAME[ID(2)|SHOWHOST(true)]}",
            "text": "嗯…",
            "nextDialogs": [
              "751070708"
            ]
          },
          "751070708": {
            "id": "751070708",
            "speakerId": 1002,
            "speakerName": "派蒙",
            "text": "#这样说来，{REALNAME[ID(2)|SHOWHOST(true)]}，你可以从地下接近营地，先看看情况？",
            "nextDialogs": [
              "751070709"
            ]
          },
          "751070709": {
            "id": "751070709",
            "speakerId": 1002,
            "speakerName": "派蒙",
            "text": "假如，你在他们的营地里发现了什么重要的道具，就先把它们破坏掉，给那些坏人制造一些混乱！",
            "nextDialogs": [
              "751070710"
            ]
          },
          "751070710": {
            "id": "751070710",
            "speakerId": 1002,
            "speakerName": "派蒙",
            "text": "不过，如果情况不太妙，你就先撤回来，交给我们，一定要注意安全哦！",
            "nextDialogs": [
              "751070711"
            ]
          },
          "751070711": {
            "id": "751070711",
            "speakerId": 1003,
            "speakerName": "#{REALNAME[ID(2)|SHOWHOST(true)]}",
            "text": "嗯！"
          }
        }
      }
    },
    {
      "subId": "7510712",
      "subQuestName": "等待龙伙伴的行动",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "751071201"
        ],
        "dialogs": {
          "751071201": {
            "id": "751071201",
            "speakerId": 1002,
            "speakerName": "派蒙",
            "text": "呼，这个坏家伙的据点已经被我们捣毁了…事情的原委也搞清楚了，先回「大椰子」那边去吧。",
            "nextDialogs": [
              "751071202"
            ]
          },
          "751071202": {
            "id": "751071202",
            "speakerId": 1002,
            "speakerName": "派蒙",
            "text": "之后，我们可以向卡克斯先生解释一下到底发生了什么。"
          }
        }
      }
    },

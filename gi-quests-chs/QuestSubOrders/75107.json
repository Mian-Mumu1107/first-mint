    {
      "subId": "7510709",
      "subQuestName": "返回「大椰子」所在的营地",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "751070901"
        ],
        "dialogs": {
          "751070901": {
            "id": "751070901",
            "speakerId": 1000,
            "speakerName": "？？？",
            "text": "这该怎么办啊…",
            "nextDialogs": [
              "751070902"
            ]
          },
          "751070902": {
            "id": "751070902",
            "speakerId": 1000,
            "speakerName": "？？？",
            "text": "我的伙伴，你吱一声也行，至少让我了解一下状况？",
            "nextDialogs": [
              "751070903"
            ]
          },
          "751070903": {
            "id": "751070903",
            "speakerId": 1001,
            "speakerName": "虚弱的嵴锋龙",
            "text": "…吱？",
            "nextDialogs": [
              "751070904"
            ]
          },
          "751070904": {
            "id": "751070904",
            "speakerId": 1000,
            "speakerName": "？？？",
            "text": "…没听懂。",
            "nextDialogs": [
              "751070905"
            ]
          },
          "751070905": {
            "id": "751070905",
            "speakerId": 1002,
            "speakerName": "派蒙",
            "text": "#只是吱一声而已，就算换成{REALNAME[ID(2)|SHOWHOST(true)]}，也不可能马上明白它的意思吧？",
            "nextDialogs": [
              "751070906"
            ]
          },
          "751070906": {
            "id": "751070906",
            "speakerId": 1003,
            "speakerName": "#{REALNAME[ID(2)|SHOWHOST(true)]}",
            "text": "唔？",
            "nextDialogs": [
              "751070909"
            ]
          },
          "751070909": {
            "id": "751070909",
            "speakerId": 1000,
            "speakerName": "？？？",
            "text": "#啊，居然是尊贵的{NICKNAME}大人和派蒙大人，这下有救了！",
            "nextDialogs": [
              "751070910"
            ]
          },
          "751070910": {
            "id": "751070910",
            "speakerId": 1000,
            "speakerName": "？？？",
            "text": "很荣幸见到你们，两位大人！我长话短说，情况是这样的——",
            "nextDialogs": [
              "751070911"
            ]
          },
          "751070911": {
            "id": "751070911",
            "speakerId": 1004,
            "speakerName": "卡克斯",
            "text": "我叫卡克斯，是个旅行商人，今天去附近打水时，我和我的龙伙伴「大椰子」短暂分开了一会儿。",
            "nextDialogs": [
              "751070912"
            ]
          },
          "751070912": {
            "id": "751070912",
            "speakerId": 1004,
            "speakerName": "卡克斯",
            "text": "结果我回来时，龙伙伴不知怎么受伤了，倒在路边动弹不得…",
            "nextDialogs": [
              "751070913"
            ]
          },
          "751070913": {
            "id": "751070913",
            "speakerId": 1004,
            "speakerName": "卡克斯",
            "text": "我怀疑它踩上了猎人们的陷阱，但检查了一遍，腿上好像没什么伤口，身体也没流血…难不成是扭伤了脚腕？",
            "nextDialogs": [
              "751070914"
            ]
          },
          "751070914": {
            "id": "751070914",
            "speakerId": 1005,
            "speakerName": "「大椰子」",
            "text": "呜呜！呜！呜呜呜！",
            "nextDialogs": [
              "751070915"
            ]
          },
          "751070915": {
            "id": "751070915",
            "speakerId": 1003,
            "speakerName": "#{REALNAME[ID(2)|SHOWHOST(true)]}",
            "text": "呀！",
            "nextDialogs": [
              "751070916"
            ]
          },
          "751070916": {
            "id": "751070916",
            "speakerId": 1002,
            "speakerName": "派蒙",
            "text": "#感觉你的龙伙伴非常痛苦，但我和{NICKNAME}都不是专业的龙医生…"
          }
        }
      }
    },
    {
      "subId": "7510710",
      "subQuestName": "返回「大椰子」所在的营地",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "751071001"
        ],
        "dialogs": {
          "751071001": {
            "id": "751071001",
            "speakerId": 1004,
            "speakerName": "卡克斯",
            "text": "欢迎回来！",
            "nextDialogs": [
              "751071002"
            ]
          },
          "751071002": {
            "id": "751071002",
            "speakerId": 1004,
            "speakerName": "卡克斯",
            "text": "我猜你们是去收集食材，准备早餐了。",
            "nextDialogs": [
              "751071005"
            ]
          },
          "751071005": {
            "id": "751071005",
            "speakerId": 1002,
            "speakerName": "派蒙",
            "text": "卡克斯先生这就请到医生了？动作好快！",
            "nextDialogs": [
              "751071006"
            ]
          },
          "751071006": {
            "id": "751071006",
            "speakerId": 1003,
            "speakerName": "#{REALNAME[ID(2)|SHOWHOST(true)]}",
            "text": "嗯？",
            "nextDialogs": [
              "751071007"
            ]
          },
          "751071007": {
            "id": "751071007",
            "speakerId": 1005,
            "speakerName": "「大椰子」",
            "text": "嗯嗯！",
            "nextDialogs": [
              "751071008"
            ]
          },
          "751071008": {
            "id": "751071008",
            "speakerId": 1002,
            "speakerName": "派蒙",
            "text": "看来「大椰子」恢复得不错，已经能站起来了，恭喜你！",
            "nextDialogs": [
              "751071009"
            ]
          },
          "751071009": {
            "id": "751071009",
            "speakerId": 1002,
            "speakerName": "派蒙",
            "text": "不过，那位医生呢，怎么不见人影？",
            "nextDialogs": [
              "751071010"
            ]
          },
          "751071010": {
            "id": "751071010",
            "speakerId": 1004,
            "speakerName": "卡克斯",
            "text": "我带着医生回到营地时，发现你们都不在，就让医生先为「大椰子」疗伤。",
            "nextDialogs": [
              "751071011"
            ]
          },
          "751071011": {
            "id": "751071011",
            "speakerId": 1004,
            "speakerName": "卡克斯",
            "text": "医生说，「大椰子」像是被高速飞行的石子击中了身体，受了内伤…我没想通，「大椰子」倒下的位置附近根本没有石子。",
            "nextDialogs": [
              "751071012"
            ]
          },
          "751071012": {
            "id": "751071012",
            "speakerId": 1004,
            "speakerName": "卡克斯",
            "text": "好在医生应对这种伤势的经验很丰富，备着特效药，就为「大椰子」处理好了内伤，大大缓解了痛苦…",
            "nextDialogs": [
              "751071013"
            ]
          },
          "751071013": {
            "id": "751071013",
            "speakerId": 1004,
            "speakerName": "卡克斯",
            "text": "现在「大椰子」能慢慢走路了，我们可以挪到医生那边去，用更全面的器材疗伤。",
            "nextDialogs": [
              "751071014"
            ]
          },
          "751071014": {
            "id": "751071014",
            "speakerId": 1004,
            "speakerName": "卡克斯",
            "text": "我们发现营地附近还有一只伤势相近的绒翼龙，是「花羽会」一名成员走失的龙伙伴。",
            "nextDialogs": [
              "751071015"
            ]
          },
          "751071015": {
            "id": "751071015",
            "speakerId": 1004,
            "speakerName": "卡克斯",
            "text": "医生为它治疗后，就领着它先回「花羽会」。",
            "nextDialogs": [
              "751071016"
            ]
          },
          "751071016": {
            "id": "751071016",
            "speakerId": 1002,
            "speakerName": "派蒙",
            "text": "「高速飞行的石子」…就是那些龙贩子说的易碎弹头吗？",
            "nextDialogs": [
              "751071017"
            ]
          },
          "751071017": {
            "id": "751071017",
            "speakerId": 1002,
            "speakerName": "派蒙",
            "text": "我又有点生气了…",
            "nextDialogs": [
              "751071018"
            ]
          },
          "751071018": {
            "id": "751071018",
            "speakerId": 1009,
            "speakerName": "Black Screen",
            "text": "和派蒙一起向卡克斯讲述了事情的来龙去脉…\\n",
            "nextDialogs": [
              "751071019"
            ]
          },
          "751071019": {
            "id": "751071019",
            "speakerId": 1004,
            "speakerName": "卡克斯",
            "text": "原来「大椰子」是被那伙坏人偷袭，才受了内伤…还好我回来的早，不然后果不堪设想！",
            "nextDialogs": [
              "751071020"
            ]
          },
          "751071020": {
            "id": "751071020",
            "speakerId": 1004,
            "speakerName": "卡克斯",
            "text": "实在可恶，真想给他们两拳…",
            "nextDialogs": [
              "751071021"
            ]
          },
          "751071021": {
            "id": "751071021",
            "speakerId": 1004,
            "speakerName": "卡克斯",
            "text": "不对，两拳太少，让他们分期赔款，每个被他们抢走过龙伙伴的受害者都该给他们两千拳！",
            "nextDialogs": [
              "751071022"
            ]
          },
          "751071022": {
            "id": "751071022",
            "speakerId": 1005,
            "speakerName": "「大椰子」",
            "text": "嗷！",
            "nextDialogs": [
              "751071023"
            ]
          },
          "751071023": {
            "id": "751071023",
            "speakerId": 1002,
            "speakerName": "派蒙",
            "text": "说得对喔！早知如此，我们应该绑几个坏家伙，带到你和「大椰子」面前，让你们亲手揍他们几顿，出出气。",
            "nextDialogs": [
              "751071024"
            ]
          },
          "751071024": {
            "id": "751071024",
            "speakerId": 1004,
            "speakerName": "卡克斯",
            "text": "不过，我们出气的事先放一边，话说回来…",
            "nextDialogs": [
              "751071025"
            ]
          },
          "751071025": {
            "id": "751071025",
            "speakerId": 1004,
            "speakerName": "卡克斯",
            "text": "两位只用一顿早饭的工夫，就覆灭了这个犯罪团伙，实在了不起！"
          }
        }
      }
    },

  "subQuests": [
    {
      "subId": "7510701",
      "subQuestName": "与陷入麻烦的部族成员对话$HIDDEN",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "751070101"
        ],
        "dialogs": {
          "751070101": {
            "id": "751070101",
            "speakerId": 1000,
            "speakerName": "？？？",
            "text": "这该怎么办啊…",
            "nextDialogs": [
              "751070102"
            ]
          },
          "751070102": {
            "id": "751070102",
            "speakerId": 1000,
            "speakerName": "？？？",
            "text": "我的伙伴，你随便叫一声就行，至少让我了解一下状况？",
            "nextDialogs": [
              "751070103"
            ]
          },
          "751070103": {
            "id": "751070103",
            "speakerId": 1001,
            "speakerName": "虚弱的嵴锋龙",
            "text": "…唔？",
            "nextDialogs": [
              "751070104"
            ]
          },
          "751070104": {
            "id": "751070104",
            "speakerId": 1000,
            "speakerName": "？？？",
            "text": "…没听懂。",
            "nextDialogs": [
              "751070105"
            ]
          },
          "751070105": {
            "id": "751070105",
            "speakerId": 1002,
            "speakerName": "派蒙",
            "text": "#只是这么简单的一声，就算换成{REALNAME[ID(2)|SHOWHOST(true)]}，也不可能马上明白它的意思吧？",
            "nextDialogs": [
              "751070106"
            ]
          },
          "751070106": {
            "id": "751070106",
            "speakerId": 1003,
            "speakerName": "#{REALNAME[ID(2)|SHOWHOST(true)]}",
            "text": "嗯？",
            "nextDialogs": [
              "751070109"
            ]
          },
          "751070109": {
            "id": "751070109",
            "speakerId": 1000,
            "speakerName": "？？？",
            "text": "啊，是路过的冒险家，这下有救了！",
            "nextDialogs": [
              "751070110"
            ]
          },
          "751070110": {
            "id": "751070110",
            "speakerId": 1000,
            "speakerName": "？？？",
            "text": "多谢你，热心的冒险家！我长话短说，情况是这样的——",
            "nextDialogs": [
              "751070111"
            ]
          },
          "751070111": {
            "id": "751070111",
            "speakerId": 1004,
            "speakerName": "卡克斯",
            "text": "我叫卡克斯，是个旅行商人，今天去附近打水时，我和我的龙「大椰子」短暂分开了一会儿。",
            "nextDialogs": [
              "751070112"
            ]
          },
          "751070112": {
            "id": "751070112",
            "speakerId": 1004,
            "speakerName": "卡克斯",
            "text": "结果我回来时，龙伙伴不知怎么受伤了，倒在路边动弹不得…",
            "nextDialogs": [
              "751070113"
            ]
          },
          "751070113": {
            "id": "751070113",
            "speakerId": 1004,
            "speakerName": "卡克斯",
            "text": "我怀疑它踩上了猎人们的陷阱，但检查了一遍，腿上好像没什么伤口，身体也没流血…难不成是钝伤？",
            "nextDialogs": [
              "751070114"
            ]
          },
          "751070114": {
            "id": "751070114",
            "speakerId": 1005,
            "speakerName": "「大椰子」",
            "text": "呜呜！呜！呜呜呜！",
            "nextDialogs": [
              "751070115"
            ]
          },
          "751070115": {
            "id": "751070115",
            "speakerId": 1003,
            "speakerName": "#{REALNAME[ID(2)|SHOWHOST(true)]}",
            "text": "呀！",
            "nextDialogs": [
              "751070116"
            ]
          },
          "751070116": {
            "id": "751070116",
            "speakerId": 1002,
            "speakerName": "派蒙",
            "text": "#感觉你的龙伙伴非常痛苦，但我和{NICKNAME}都不是专业的龙医生…"
          }
        }
      }
    },

    },
    {
      "subId": "1000806",
      "subQuestName": "与雷泽对话",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "100080601"
        ],
        "dialogs": {
          "100080601": {
            "id": "100080601",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "成功了！",
            "nextDialogs": [
              "100080602"
            ]
          },
          "100080602": {
            "id": "100080602",
            "speakerId": 1001,
            "speakerName": "雷泽",
            "text": "谢谢，谢谢你们…我一直以为，只要我保护「卢皮卡」就够了。",
            "nextDialogs": [
              "100080603"
            ]
          },
          "100080603": {
            "id": "100080603",
            "speakerId": 1001,
            "speakerName": "雷泽",
            "text": "其实「卢皮卡」也…",
            "nextDialogs": [
              "100080604"
            ]
          },
          "100080604": {
            "id": "100080604",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "正是因为心意相通，「卢皮卡」才是「卢皮卡」嘛！",
            "nextDialogs": [
              "100080605"
            ]
          },
          "100080605": {
            "id": "100080605",
            "speakerId": 1001,
            "speakerName": "雷泽",
            "text": "派蒙说得对…这点，永远不会变。",
            "nextDialogs": [
              "100080606"
            ]
          },
          "100080606": {
            "id": "100080606",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "嘿嘿，这下奔狼领就不会出现「外来的狼群」了吧。",
            "nextDialogs": [
              "100080607"
            ]
          },
          "100080607": {
            "id": "100080607",
            "speakerId": 1001,
            "speakerName": "雷泽",
            "text": "不…那些家伙，撕开空间…也许还会来。",
            "nextDialogs": [
              "100080608"
            ]
          },
          "100080608": {
            "id": "100080608",
            "speakerId": 1001,
            "speakerName": "雷泽",
            "text": "不过，有我和「卢皮卡」们，我们会一起…",
            "nextDialogs": [
              "100080609"
            ]
          },
          "100080609": {
            "id": "100080609",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "…还有我和派蒙。",
            "nextDialogs": [
              "100080610"
            ]
          },
          "100080610": {
            "id": "100080610",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "对对，要是需要帮助，一定要告诉我们，我们也会帮忙的！",
            "nextDialogs": [
              "100080611"
            ]
          },
          "100080611": {
            "id": "100080611",
            "speakerId": 1001,
            "speakerName": "雷泽",
            "text": "嗯，有你们，真好。",
            "nextDialogs": [
              "100080612"
            ]
          },
          "100080612": {
            "id": "100080612",
            "speakerId": 1002,
            "speakerName": "远处的狼嚎",
            "text": "啊呜——",
            "nextDialogs": [
              "100080613"
            ]
          },
          "100080613": {
            "id": "100080613",
            "speakerId": 1001,
            "speakerName": "雷泽",
            "text": "他们，在呼唤我。",
            "nextDialogs": [
              "100080614"
            ]
          },
          "100080614": {
            "id": "100080614",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "嘿嘿，看来他们在担心着你的安危呢。",
            "nextDialogs": [
              "100080615"
            ]
          },
          "100080615": {
            "id": "100080615",
            "speakerId": 1001,
            "speakerName": "雷泽",
            "text": "那我，要离开了，谢谢，你们。",
            "nextDialogs": [
              "100080616"
            ]
          },
          "100080616": {
            "id": "100080616",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "不用谢，这是「卢皮卡」该做的。",
            "nextDialogs": [
              "100080617"
            ]
          },
          "100080617": {
            "id": "100080617",
            "speakerId": 1003,
            "speakerName": "Black Screen",
            "text": "奔狼领获得了短暂但久违的平静，雷泽与你作了简单的告别，步入了奔狼领的丛林之中。",
            "nextDialogs": [
              "100080618"
            ]
          },
          "100080618": {
            "id": "100080618",
            "speakerId": 1003,
            "speakerName": "Black Screen",
            "text": "你看到，树叶的薮影之中，那里有许多期待他的，温柔的眼眸。"
          }
        }
      }
    }
  ]
}
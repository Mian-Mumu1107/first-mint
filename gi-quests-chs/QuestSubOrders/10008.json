  "subQuests": [
    {
      "subId": "1000801",
      "subQuestName": "前往奔狼领",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "100080101"
        ],
        "dialogs": {
          "100080101": {
            "id": "100080101",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "雷泽——",
            "nextDialogs": [
              "100080102"
            ]
          },
          "100080102": {
            "id": "100080102",
            "speakerId": 1001,
            "speakerName": "雷泽",
            "text": "闻到了，熟悉的气味，原来是你们。",
            "nextDialogs": [
              "100080103"
            ]
          },
          "100080103": {
            "id": "100080103",
            "speakerId": 1001,
            "speakerName": "雷泽",
            "text": "最近，还好吗？",
            "nextDialogs": [
              "100080104"
            ]
          },
          "100080104": {
            "id": "100080104",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "嘿嘿，一切都好，对了，雷泽，怎么王狼一见到我们就消失了，你们在讨论什么秘密呢？",
            "nextDialogs": [
              "100080105"
            ]
          },
          "100080105": {
            "id": "100080105",
            "speakerId": 1001,
            "speakerName": "雷泽",
            "text": "要开始狩猎，我在说服…领主。",
            "nextDialogs": [
              "100080106"
            ]
          },
          "100080106": {
            "id": "100080106",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "打猎？",
            "nextDialogs": [
              "100080107"
            ]
          },
          "100080107": {
            "id": "100080107",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "#（对了，{NICKNAME}，难道这就是雷泽的「课题」吗？）",
            "nextDialogs": [
              "100080108"
            ]
          },
          "100080108": {
            "id": "100080108",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "雷泽，难道是狼群又没有吃的东西，所以大家要开始打猎…",
            "nextDialogs": [
              "100080111"
            ]
          },
          "100080111": {
            "id": "100080111",
            "speakerId": 1001,
            "speakerName": "雷泽",
            "text": "不，不是…这次的打猎，不是为了填饱肚子。",
            "nextDialogs": [
              "100080112"
            ]
          },
          "100080112": {
            "id": "100080112",
            "speakerId": 1001,
            "speakerName": "雷泽",
            "text": "而是为了，杀死敌人。漆黑的狼群，侵占的领土…发出奇怪的臭味，越来越浓…",
            "nextDialogs": [
              "100080113"
            ]
          },
          "100080113": {
            "id": "100080113",
            "speakerId": 1001,
            "speakerName": "雷泽",
            "text": "要净化森林…狩猎敌人。",
            "nextDialogs": [
              "100080114"
            ]
          },
          "100080114": {
            "id": "100080114",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "所以，王狼答应了吗，我还记得那个时候，王狼还说…",
            "nextDialogs": [
              "100080115"
            ]
          },
          "100080115": {
            "id": "100080115",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "我想想，是怎么说的来着…咳咳，「雷泽，你不准参与讨伐。因为这是狼的问题。」",
            "nextDialogs": [
              "100080116"
            ]
          },
          "100080116": {
            "id": "100080116",
            "speakerId": 1001,
            "speakerName": "雷泽",
            "text": "……",
            "nextDialogs": [
              "100080117"
            ]
          },
          "100080117": {
            "id": "100080117",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "啊，我不是故意的…对不起，雷泽…",
            "nextDialogs": [
              "100080118"
            ]
          },
          "100080118": {
            "id": "100080118",
            "speakerId": 1001,
            "speakerName": "雷泽",
            "text": "没关系，因为我和「卢皮卡」在一起，而且，师父告诉了我，和领主说话的方法。",
            "nextDialogs": [
              "100080119"
            ]
          },
          "100080119": {
            "id": "100080119",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "丽莎说的…和领主说话的方法？",
            "nextDialogs": [
              "100080120"
            ]
          },
          "100080120": {
            "id": "100080120",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "啊，我明白了，是说服王狼的办法吧，所以你刚才已经说服王狼了吗！",
            "nextDialogs": [
              "100080121"
            ]
          },
          "100080121": {
            "id": "100080121",
            "speakerId": 1001,
            "speakerName": "雷泽",
            "text": "嗯，说话很累，可是，成功了。",
            "nextDialogs": [
              "100080122"
            ]
          },
          "100080122": {
            "id": "100080122",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "居然能够说服那个顽固的大家伙，了不起！",
            "nextDialogs": [
              "100080123"
            ]
          },
          "100080123": {
            "id": "100080123",
            "speakerId": 1001,
            "speakerName": "雷泽",
            "text": "漆黑的狼，是世界的敌人。师父说，这不是狼的问题，而是世界的问题…师父是对的，领主也承认了。",
            "nextDialogs": [
              "100080124"
            ]
          },
          "100080124": {
            "id": "100080124",
            "speakerId": 1001,
            "speakerName": "雷泽",
            "text": "不过，因此，狼群不会参与，是「我」与「漆黑狼群」的战争…",
            "nextDialogs": [
              "100080125"
            ]
          },
          "100080125": {
            "id": "100080125",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "嘿嘿，那就让我们也一起帮忙吧！那些奇怪的兽境猎犬，我们也早就看不顺眼啦！",
            "nextDialogs": [
              "100080126"
            ]
          },
          "100080126": {
            "id": "100080126",
            "speakerId": 1001,
            "speakerName": "雷泽",
            "text": "谢、谢谢…如果，有你们的帮助，一定能顺利。",
            "nextDialogs": [
              "100080127"
            ]
          },
          "100080127": {
            "id": "100080127",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "不过，要怎么开始狩猎呢？",
            "nextDialogs": [
              "100080128"
            ]
          },
          "100080128": {
            "id": "100080128",
            "speakerId": 1001,
            "speakerName": "雷泽",
            "text": "我们要，像把猎物赶到陷阱，把漆黑狼群，赶到这里…",
            "nextDialogs": [
              "100080129"
            ]
          },
          "100080129": {
            "id": "100080129",
            "speakerId": 1001,
            "speakerName": "雷泽",
            "text": "领主会，困住他们，我们来…把它们解决掉。",
            "nextDialogs": [
              "100080130"
            ]
          },
          "100080130": {
            "id": "100080130",
            "speakerId": 1001,
            "speakerName": "雷泽",
            "text": "…准备好，跟我说一声，就开始，狩猎。",
            "nextDialogs": [
              "100080401"
            ]
          },
          "100080401": {
            "id": "100080401",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "现在就出发吧！"
          }
        }
      }
    },

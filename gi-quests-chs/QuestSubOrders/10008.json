      }
    },
    {
      "subId": "1000803",
      "subQuestName": "保护狼群",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "100080301"
        ],
        "dialogs": {
          "100080301": {
            "id": "100080301",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "好险！幸好有狼群的帮忙！",
            "nextDialogs": [
              "100080302"
            ]
          },
          "100080302": {
            "id": "100080302",
            "speakerId": 1001,
            "speakerName": "雷泽",
            "text": "嗯…",
            "nextDialogs": [
              "100080303"
            ]
          },
          "100080303": {
            "id": "100080303",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "它们也拖住了很多兽境猎犬…甚至，在帮我们驱赶敌人？",
            "nextDialogs": [
              "100080304"
            ]
          },
          "100080304": {
            "id": "100080304",
            "speakerId": 1001,
            "speakerName": "雷泽",
            "text": "可是，这不是狼的事…",
            "nextDialogs": [
              "100080305"
            ]
          },
          "100080305": {
            "id": "100080305",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "嘿嘿，就像雷泽想要帮助「卢皮卡」，「卢皮卡」又怎么会让你陷入危险呢！",
            "nextDialogs": [
              "100080306"
            ]
          },
          "100080306": {
            "id": "100080306",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "也许它们向北风的王狼说，「哼哼，这不是『卢皮卡』的问题，这是世界的问题！」然后就跑过来帮忙啦。",
            "nextDialogs": [
              "100080307"
            ]
          },
          "100080307": {
            "id": "100080307",
            "speakerId": 1001,
            "speakerName": "雷泽",
            "text": "嗯，「卢皮卡」，就是，「卢皮卡」…",
            "nextDialogs": [
              "100080308"
            ]
          },
          "100080308": {
            "id": "100080308",
            "speakerId": 1001,
            "speakerName": "雷泽",
            "text": "我是人类中的「卢皮卡」，我不用是狼，但是…只要是能够帮到「卢皮卡」，就是好的。",
            "nextDialogs": [
              "100080309"
            ]
          },
          "100080309": {
            "id": "100080309",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "说得对，雷泽！",
            "nextDialogs": [
              "100080310"
            ]
          },
          "100080310": {
            "id": "100080310",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "或许王狼会答应…",
            "nextDialogs": [
              "100080311"
            ]
          },
          "100080311": {
            "id": "100080311",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "是因为雷泽的这份心意。",
            "nextDialogs": [
              "100080312"
            ]
          },
          "100080312": {
            "id": "100080312",
            "speakerId": 1001,
            "speakerName": "雷泽",
            "text": "是吗？",
            "nextDialogs": [
              "100080313"
            ]
          },
          "100080313": {
            "id": "100080313",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "嗯！一定是这样！好，我们就和狼群一鼓作气，把坏蛋们全都赶跑吧！"
          }
        }
      }
    },

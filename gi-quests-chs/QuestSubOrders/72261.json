  "subQuests": [
    {
      "subId": "7226101",
      "subQuestName": "(test)在活动界面接取第4天任务$HIDDEN",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "722610101"
        ],
        "dialogs": {
          "722610101": {
            "id": "722610101",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "喂——理水叠山真君——",
            "nextDialogs": [
              "722610102"
            ]
          },
          "722610102": {
            "id": "722610102",
            "speakerId": 15132,
            "speakerName": "「吉法师」",
            "text": "喂——理理真——",
            "nextDialogs": [
              "722610103"
            ]
          },
          "722610103": {
            "id": "722610103",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "……",
            "nextDialogs": [
              "722610104"
            ]
          },
          "722610104": {
            "id": "722610104",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "伤脑筋，仙人好像不在哪…",
            "nextDialogs": [
              "722610105"
            ]
          },
          "722610105": {
            "id": "722610105",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "对仙人不能无礼。",
            "nextDialogs": [
              "722610106"
            ]
          },
          "722610106": {
            "id": "722610106",
            "speakerId": 15132,
            "speakerName": "「吉法师」",
            "text": "派蒙，仙人是什么？",
            "nextDialogs": [
              "722610107"
            ]
          },
          "722610107": {
            "id": "722610107",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "嗯…应该说是很特别的人，或者是动物吧？",
            "nextDialogs": [
              "722610108"
            ]
          },
          "722610108": {
            "id": "722610108",
            "speakerId": 15132,
            "speakerName": "「吉法师」",
            "text": "就像吉法师？",
            "nextDialogs": [
              "722610109"
            ]
          },
          "722610109": {
            "id": "722610109",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "不对不对！应该说，有神奇的力量…",
            "nextDialogs": [
              "722610110"
            ]
          },
          "722610110": {
            "id": "722610110",
            "speakerId": 15132,
            "speakerName": "「吉法师」",
            "text": "也会砰砰？那，吉法师也是仙人。",
            "nextDialogs": [
              "722610111"
            ]
          },
          "722610111": {
            "id": "722610111",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "唔…仙人，是更加古老、更有威严的…",
            "nextDialogs": [
              "722610112"
            ]
          },
          "722610112": {
            "id": "722610112",
            "speakerId": 15132,
            "speakerName": "「吉法师」",
            "text": "知道了，吉法师不是仙人。五百藏是仙人！",
            "nextDialogs": [
              "722610113"
            ]
          },
          "722610113": {
            "id": "722610113",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "呜哇，要怎么解释…",
            "nextDialogs": [
              "722610114"
            ]
          },
          "722610114": {
            "id": "722610114",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "仙人是守护璃月的古老存在…",
            "nextDialogs": [
              "722610115"
            ]
          },
          "722610115": {
            "id": "722610115",
            "speakerId": 15132,
            "speakerName": "「吉法师」",
            "text": "吉法师知道了。五百藏守护的是镇守之森，所以不是仙人。",
            "nextDialogs": [
              "722610116"
            ]
          },
          "722610116": {
            "id": "722610116",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "虽然道理不是这么一回事，不过能撇清误会就好…",
            "nextDialogs": [
              "722610117"
            ]
          },
          "722610117": {
            "id": "722610117",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "不过难得眼前有仙府，就在这里给吉法师拍照吧！",
            "nextDialogs": [
              "722610118"
            ]
          },
          "722610118": {
            "id": "722610118",
            "speakerId": 15132,
            "speakerName": "「吉法师」",
            "text": "呶！吉法师乖乖站好拍照。",
            "nextDialogs": [
              "722610119"
            ]
          },
          "722610119": {
            "id": "722610119",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "吉法师乖！"
          }
        }
      }
    },

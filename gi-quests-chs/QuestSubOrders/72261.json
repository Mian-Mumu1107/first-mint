    {
      "subId": "7226104",
      "subQuestName": "与吉法师对话",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "722610201"
        ],
        "dialogs": {
          "722610201": {
            "id": "722610201",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "拍得真好！",
            "nextDialogs": [
              "722610202"
            ]
          },
          "722610202": {
            "id": "722610202",
            "speakerId": 3160,
            "speakerName": "「吉法师」",
            "text": "呶哈哈，吉法师帅。",
            "nextDialogs": [
              "722610203"
            ]
          },
          "722610203": {
            "id": "722610203",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "这孩子，一点也不谦虚…",
            "nextDialogs": [
              "722610204"
            ]
          },
          "722610204": {
            "id": "722610204",
            "speakerId": 3160,
            "speakerName": "「吉法师」",
            "text": "对了，派蒙。仙人有什么法术？",
            "nextDialogs": [
              "722610205"
            ]
          },
          "722610205": {
            "id": "722610205",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "仙人的力量很强的！不过要具体举例的话…",
            "nextDialogs": [
              "722610206"
            ]
          },
          "722610206": {
            "id": "722610206",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "这周边的琥珀吧。",
            "nextDialogs": [
              "722610207"
            ]
          },
          "722610207": {
            "id": "722610207",
            "speakerId": 3160,
            "speakerName": "「吉法师」",
            "text": "琥珀，那是什么？",
            "nextDialogs": [
              "722610208"
            ]
          },
          "722610208": {
            "id": "722610208",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "嗯！我记得是说，理水叠山真君有能生出琥珀的花，把入侵的坏东西都困在里面。",
            "nextDialogs": [
              "722610209"
            ]
          },
          "722610209": {
            "id": "722610209",
            "speakerId": 3160,
            "speakerName": "「吉法师」",
            "text": "理理真好厉害。守护璃月，所以把坏东西困住。",
            "nextDialogs": [
              "722610210"
            ]
          },
          "722610210": {
            "id": "722610210",
            "speakerId": 3160,
            "speakerName": "「吉法师」",
            "text": "好久好久以前，有很坏很坏的绪方四鬼，闯到森林里到处打打。欺负狸子。五百藏变成公家大人的样子，给他们吃妖狸饭。",
            "nextDialogs": [
              "722610211"
            ]
          },
          "722610211": {
            "id": "722610211",
            "speakerId": 3160,
            "speakerName": "「吉法师」",
            "text": "后来，和御伽大王一起，把他们丢到画纸里，封印了。",
            "nextDialogs": [
              "722610212"
            ]
          },
          "722610212": {
            "id": "722610212",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "还有这样的故事啊。难怪五百藏看到吉法师相片的时候，吓得不轻。",
            "nextDialogs": [
              "722610213"
            ]
          },
          "722610213": {
            "id": "722610213",
            "speakerId": 3160,
            "speakerName": "「吉法师」",
            "text": "五百藏不是仙人，不保护璃月。但五百藏保护森林，保护狸子。",
            "nextDialogs": [
              "722610214"
            ]
          },
          "722610214": {
            "id": "722610214",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "不同的人，要保护不同的东西。",
            "nextDialogs": [
              "722610215"
            ]
          },
          "722610215": {
            "id": "722610215",
            "speakerId": 3160,
            "speakerName": "「吉法师」",
            "text": "呶？",
            "nextDialogs": [
              "722610216"
            ]
          },
          "722610216": {
            "id": "722610216",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "吉法师长大以后就知道了。",
            "nextDialogs": [
              "722610217"
            ]
          },
          "722610217": {
            "id": "722610217",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "所以，吉法师要努力修行，变成了不起的大妖狸！",
            "nextDialogs": [
              "722610218"
            ]
          },
          "722610218": {
            "id": "722610218",
            "speakerId": 3160,
            "speakerName": "「吉法师」",
            "text": "呶！当然了。名震天下的妖狸吉法师！",
            "nextDialogs": [
              "722610219"
            ]
          },
          "722610219": {
            "id": "722610219",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "很好奇五百藏没被封印的时候的样子呢！感觉应该很好玩。",
            "nextDialogs": [
              "722610220"
            ]
          },
          "722610220": {
            "id": "722610220",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "啊，突然想起，之前也有盗宝团的人被琥珀定身…",
            "nextDialogs": [
              "722610221"
            ]
          },
          "722610221": {
            "id": "722610221",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "我们还被当成了「仙使」。",
            "nextDialogs": [
              "722610222"
            ]
          },
          "722610222": {
            "id": "722610222",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "感觉是好久以前发生的事情了呢…但好像，也没有过多久？",
            "nextDialogs": [
              "722610223"
            ]
          },
          "722610223": {
            "id": "722610223",
            "speakerId": 3160,
            "speakerName": "「吉法师」",
            "text": "呶？",
            "nextDialogs": [
              "722610224"
            ]
          },
          "722610224": {
            "id": "722610224",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "咳咳。我们来到璃月之后…",
            "nextDialogs": [
              "722610225"
            ]
          },
          "722610225": {
            "id": "722610225",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "#「是一年一度的请仙典仪耶。哇哈哈，我{NICKNAME}应该可以吃好多好多好吃的。派蒙，我们走！」",
            "nextDialogs": [
              "722610226"
            ]
          },
          "722610226": {
            "id": "722610226",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "「还有贡品！我派蒙马上飞过去！」",
            "nextDialogs": [
              "722610227"
            ]
          },
          "722610227": {
            "id": "722610227",
            "speakerId": 3160,
            "speakerName": "「吉法师」",
            "text": "？？",
            "nextDialogs": [
              "722610228"
            ]
          },
          "722610228": {
            "id": "722610228",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "别乱说…",
            "nextDialogs": [
              "722610229"
            ]
          },
          "722610229": {
            "id": "722610229",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "好啦…",
            "nextDialogs": [
              "722610230"
            ]
          },
          "722610230": {
            "id": "722610230",
            "speakerId": 1002,
            "speakerName": "Black Screen",
            "text": "以比较简单的语言讲述了一些在璃月的冒险经历，\\n一直讲到在珉林绝云地方寻访众仙为止。",
            "nextDialogs": [
              "722610231"
            ]
          },
          "722610231": {
            "id": "722610231",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "#…接下来的事情，就是我和{NICKNAME}，一起去之前那个「琉璃亭」吃饭啦。",
            "nextDialogs": [
              "722610232"
            ]
          },
          "722610232": {
            "id": "722610232",
            "speakerId": 3160,
            "speakerName": "「吉法师」",
            "text": "理理真好厉害，留留真也好厉害！还能做出会动的房子！",
            "nextDialogs": [
              "722610233"
            ]
          },
          "722610233": {
            "id": "722610233",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "留留真…呸，留云借风真君好像也很喜欢美食呢！当时，做了好多菜才见到她。",
            "nextDialogs": [
              "722610234"
            ]
          },
          "722610234": {
            "id": "722610234",
            "speakerId": 3160,
            "speakerName": "「吉法师」",
            "text": "好贪吃哦，像派蒙。",
            "nextDialogs": [
              "722610237"
            ]
          },
          "722610237": {
            "id": "722610237",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "喂！",
            "nextDialogs": [
              "722610238"
            ]
          },
          "722610238": {
            "id": "722610238",
            "speakerId": 3160,
            "speakerName": "「吉法师」",
            "text": "派蒙是仙人？派蒙好厉害。",
            "nextDialogs": [
              "722610239"
            ]
          },
          "722610239": {
            "id": "722610239",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "呜哇，心情好复杂。虽然被吉法师夸了，但感觉又很不是滋味…",
            "nextDialogs": [
              "722610240"
            ]
          },
          "722610240": {
            "id": "722610240",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "不过，派蒙不是仙人啦！",
            "nextDialogs": [
              "722610241"
            ]
          },
          "722610241": {
            "id": "722610241",
            "speakerId": 3160,
            "speakerName": "「吉法师」",
            "text": "想和仙人玩！",
            "nextDialogs": [
              "722610242"
            ]
          },
          "722610242": {
            "id": "722610242",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "仙人一般不会随意现身…不过，四处看看也挺好的。",
            "nextDialogs": [
              "722610243"
            ]
          },
          "722610243": {
            "id": "722610243",
            "speakerId": 3160,
            "speakerName": "「吉法师」",
            "text": "吉法师出发！"
          }
        }
      }
    },

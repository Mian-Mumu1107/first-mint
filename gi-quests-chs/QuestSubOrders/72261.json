    {
      "subId": "7226107",
      "subQuestName": "与吉法师对话",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "722610401"
        ],
        "dialogs": {
          "722610401": {
            "id": "722610401",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "幸好找到了…吉法师，你没受伤吧？",
            "nextDialogs": [
              "722610402"
            ]
          },
          "722610402": {
            "id": "722610402",
            "speakerId": 3160,
            "speakerName": "「吉法师」",
            "text": "呜呜…",
            "nextDialogs": [
              "722610403"
            ]
          },
          "722610403": {
            "id": "722610403",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "没事就好，没事就好。不过，以后别乱跑啦。",
            "nextDialogs": [
              "722610405",
              "722610409",
              "722610411"
            ]
          },
          "722610405": {
            "id": "722610405",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "派蒙本来就比吉法师大，当然是姐姐啦。",
            "nextDialogs": [
              "722610406"
            ]
          },
          "722610406": {
            "id": "722610406",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "倒不太看得出来…",
            "nextDialogs": [
              "722610407"
            ]
          },
          "722610407": {
            "id": "722610407",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "喂！",
            "nextDialogs": [
              "722610412"
            ]
          },
          "722610412": {
            "id": "722610412",
            "speakerId": 3160,
            "speakerName": "「吉法师」",
            "text": "#呜呶呶。谢谢{NICKNAME}，谢谢派蒙。",
            "nextDialogs": [
              "722610413"
            ]
          },
          "722610413": {
            "id": "722610413",
            "speakerId": 3160,
            "speakerName": "「吉法师」",
            "text": "还以为，吉法师又被封印了哩，很害怕。但是，能听见派蒙在叫吉法师，所以又没那么害怕。",
            "nextDialogs": [
              "722610414"
            ]
          },
          "722610414": {
            "id": "722610414",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "啊，五百藏说过，有的小狸子也曾经被封印过…",
            "nextDialogs": [
              "722610415"
            ]
          },
          "722610415": {
            "id": "722610415",
            "speakerId": 3160,
            "speakerName": "「吉法师」",
            "text": "琥珀里好可怕。都是黑色的，什么都看不见，没办法说话，也不能动、不能砰砰。就像变成石头一样。",
            "nextDialogs": [
              "722610416"
            ]
          },
          "722610416": {
            "id": "722610416",
            "speakerId": 3160,
            "speakerName": "「吉法师」",
            "text": "五百藏就算变成石头，也很厉害，所以可以说话、可以看见。但还是不能动。"
          },

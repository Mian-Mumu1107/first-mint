    {
      "subId": "7422302",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "742230201"
        ],
        "dialogs": {
          "742230201": {
            "id": "742230201",
            "speakerId": 5349,
            "speakerName": "韦尼尔",
            "text": "一百三十六…好，再来十四次，就可以休息了！",
            "nextDialogs": [
              "742230202"
            ]
          },
          "742230202": {
            "id": "742230202",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "需要帮忙吗？",
            "nextDialogs": [
              "742230203"
            ]
          },
          "742230203": {
            "id": "742230203",
            "speakerId": 5349,
            "speakerName": "韦尼尔",
            "text": "帮忙？不不，不用，哪有锻炼还需要别人帮忙的道理。",
            "nextDialogs": [
              "742230204"
            ]
          },
          "742230204": {
            "id": "742230204",
            "speakerId": 5349,
            "speakerName": "韦尼尔",
            "text": "只有锻炼出强悍的体魄，才能像这位长官一样，加入不朽军团成为一名荣耀的士兵啊！",
            "nextDialogs": [
              "742230205"
            ]
          },
          "742230205": {
            "id": "742230205",
            "speakerId": 1001,
            "speakerName": "无名的石像",
            "text": "…………",
            "nextDialogs": [
              "742230206"
            ]
          },
          "742230206": {
            "id": "742230206",
            "speakerId": 5349,
            "speakerName": "韦尼尔",
            "text": "忘了介绍了，这位是我的教官。只有经过了他的考核，才能有获得擢升的资格。",
            "nextDialogs": [
              "742230208",
              "742230211"
            ]
          },
          "742230208": {
            "id": "742230208",
            "speakerId": 5349,
            "speakerName": "韦尼尔",
            "text": "你在说什么呢，公民？雷穆利亚人不都长成这个样子吗？",
            "nextDialogs": [
              "742230209"
            ]
          },
          "742230209": {
            "id": "742230209",
            "speakerId": 5349,
            "speakerName": "韦尼尔",
            "text": "怎么样，你要试试吗，只要能同时打碎这些石柱，就算是通过初步的考核了。",
            "nextDialogs": [
              "742230213"
            ]
          },
          "742230213": {
            "id": "742230213",
            "speakerId": 5349,
            "speakerName": "韦尼尔",
            "text": "可别小看这些石柱，我锻炼了这么久也才勉强能一拳打碎一个呢。"
          },
          "742230211": {
            "id": "742230211",
            "speakerId": 5349,
            "speakerName": "韦尼尔",
            "text": "当然是战斗的考核，就算擢升后能获得不朽的身躯，战斗的技能也是要通过自己的锻炼才能习得的。",
            "nextDialogs": [
              "742230212"
            ]
          },
          "742230212": {
            "id": "742230212",
            "speakerId": 5349,
            "speakerName": "韦尼尔",
            "text": "怎么样，你要试试吗，只要能同时打碎这些石柱，就算是通过初步的考核了。"
          }
        }

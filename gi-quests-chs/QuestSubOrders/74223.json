            ]
          },
          "742230404": {
            "id": "742230404",
            "speakerId": 5349,
            "speakerName": "韦尼尔",
            "text": "长官对你的表现也赞赏有加呢，看来我还是得勤加练习啊！"
          }
        }
      }

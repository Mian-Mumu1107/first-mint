{
  "lineCounts": {
    "另一人的留言": 18,
    "巡林官公告": 2,
    "教令院公共留言板": 2,
    "教令院公告": 1,
    "留言": 44,
    "被涂改的留言": 5,
    "风纪官的留言": 9
  },
  "subQuests": [
    {
      "subId": "7324301",
      "subQuestName": "",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "732430101"
        ],
        "dialogs": {
          "732430101": {
            "id": "732430101",
            "speakerId": 1000,
            "speakerName": "教令院公共留言板",
            "text": "教令院相关通知及内外法令公告现已全面转由虚空内投放，此公告板现仅保留供院内师生课外交流使用，院外人士请勿随意留言！"
          }
        }
      }
    },
    {
      "subId": "7324302",
      "subQuestName": "",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "732430201"
        ],
        "dialogs": {
          "732430201": {
            "id": "732430201",
            "speakerId": 13173,
            "speakerName": "留言",
            "text": "「为了更加宽松的学术环境，为了更加友好的学术交流，为了大家能够笑着写出论文！」",
            "nextDialogs": [
              "732430202"
            ]
          },
          "732430202": {
            "id": "732430202",
            "speakerId": 13173,
            "speakerName": "留言",
            "text": "「我们支持维克拉姆成为下一任大掌书！」",
            "nextDialogs": [
              "732430203"
            ]
          },
          "732430203": {
            "id": "732430203",
            "speakerId": 13173,
            "speakerName": "留言",
            "text": "「欢迎加入『维克拉姆之友联谊会』，我们将会见证一位年轻、亲民、有趣的大掌书的诞生。」"
          }
        }
      }
    },
    {
      "subId": "7324303",
      "subQuestName": "",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "732430301"
        ],
        "dialogs": {
          "732430301": {
            "id": "732430301",
            "speakerId": 13173,
            "speakerName": "留言",
            "text": "「切不可忘记教令院的三善六罪。」",
            "nextDialogs": [
              "732430302"
            ]
          },
          "732430302": {
            "id": "732430302",
            "speakerId": 13173,
            "speakerName": "留言",
            "text": "「诤言、巧思、笃行。是每一位学者都应当追求的美德。」",
            "nextDialogs": [
              "732430303"
            ]
          },
          "732430303": {
            "id": "732430303",
            "speakerId": 13173,
            "speakerName": "留言",
            "text": "「而里法特，数十年来，一直亲身践行着这三点。」",
            "nextDialogs": [
              "732430304"
            ]
          },
          "732430304": {
            "id": "732430304",
            "speakerId": 13173,
            "speakerName": "留言",
            "text": "「欢迎加入『三善书友会』，与智慧同行，与未来的大掌书同行。」"
          }
        }
      }
    },
    {
      "subId": "7324304",
      "subQuestName": "",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "732430401"
        ],
        "dialogs": {
          "732430401": {
            "id": "732430401",
            "speakerId": 13173,
            "speakerName": "留言",
            "text": "「『三善书友会』的成员们，我敬佩你们对于美德的追求。」",
            "nextDialogs": [
              "732430402"
            ]
          },
          "732430402": {
            "id": "732430402",
            "speakerId": 13173,
            "speakerName": "留言",
            "text": "「不过，我可听说，里法特的论文，可有一半以上是代笔之作。」",
            "nextDialogs": [
              "732430403"
            ]
          },
          "732430403": {
            "id": "732430403",
            "speakerId": 13173,
            "speakerName": "留言",
            "text": "「这也是他为什么明明学术成果众多，却还这么低调的原因。」",
            "nextDialogs": [
              "732430404"
            ]
          },
          "732430404": {
            "id": "732430404",
            "speakerId": 1002,
            "speakerName": "另一人的留言",
            "text": "「留言板虽然不像论文那样需要充分的论据，但是也不能恶意攻击他人。」",
            "nextDialogs": [
              "732430405"
            ]
          },
          "732430405": {
            "id": "732430405",
            "speakerId": 1002,
            "speakerName": "另一人的留言",
            "text": "「我看上面的留言只是嫉妒罢了！」",
            "nextDialogs": [
              "732430406"
            ]
          },
          "732430406": {
            "id": "732430406",
            "speakerId": 1002,
            "speakerName": "另一人的留言",
            "text": "「并且，我也有听说，维克拉姆可是借着他的口才，赢得了不少女孩子的芳心。」",
            "nextDialogs": [
              "732430407"
            ]
          },
          "732430407": {
            "id": "732430407",
            "speakerId": 1002,
            "speakerName": "另一人的留言",
            "text": "「这些女孩子，可都不知道他是有妇之夫哦。怎么样，你要不要也嫉妒一下他的艳福？」",
            "nextDialogs": [
              "732430408"
            ]
          },
          "732430408": {
            "id": "732430408",
            "speakerId": 1003,
            "speakerName": "风纪官的留言",
            "text": "「禁止无端恶意攻击教令院学者，如有再犯，风纪官将会追查谣言来源。」"
          }
        }
      }
    },
    {
      "subId": "7324305",
      "subQuestName": "",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "732430501"
        ],
        "dialogs": {
          "732430501": {
            "id": "732430501",
            "speakerId": 1003,
            "speakerName": "风纪官的留言",
            "text": "「此留言板尚未纳入虚空权限系统管辖，无需虚空即可直接阅览。」",
            "nextDialogs": [
              "732430502"
            ]
          },
          "732430502": {
            "id": "732430502",
            "speakerId": 1003,
            "speakerName": "风纪官的留言",
            "text": "「请大家务必提高知识安全意识，严禁通过此留言板进行公共传播领域外的知识资源交流。」"
          }
        }
      }
    },
    {
      "subId": "7324306",
      "subQuestName": "",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "732430601"
        ],
        "dialogs": {
          "732430601": {
            "id": "732430601",
            "speakerId": 1003,
            "speakerName": "风纪官的留言",
            "text": "「温馨提醒，各位同学课余时间在院外也不要忘记谨守院纪。」",
            "nextDialogs": [
              "732430602"
            ]
          },
          "732430602": {
            "id": "732430602",
            "speakerId": 1003,
            "speakerName": "风纪官的留言",
            "text": "「对于知识的统一管理是『智慧之国』赖以存在的基石，不要因为无心之失而失去在教令院学习的机会。」"
          }
        }
      }
    },
    {
      "subId": "7324307",
      "subQuestName": "",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "732430701"
        ],
        "dialogs": {
          "732430701": {
            "id": "732430701",
            "speakerId": 1003,
            "speakerName": "风纪官的留言",
            "text": "「近期连续发生数起罐装知识走私案件。详细情况将在调查完成后在下一次识藏日前通过虚空投放给相关学院的师生。」",
            "nextDialogs": [
              "732430702"
            ]
          },
          "732430702": {
            "id": "732430702",
            "speakerId": 1003,
            "speakerName": "风纪官的留言",
            "text": "「也请各位导师加强与学生的沟通交流，避免学生因论文压力过大而铤而走险。」"
          }
        }
      }
    },
    {
      "subId": "7324308",
      "subQuestName": "",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "732430801"
        ],
        "dialogs": {
          "732430801": {
            "id": "732430801",
            "speakerId": 13173,
            "speakerName": "留言",
            "text": "「现在学院对于虚空的应用推广，与其说是太激进，我看不如说是太保守了。大量教令官的工作冗繁低效，某些方面甚至还不如以前。」",
            "nextDialogs": [
              "732430802"
            ]
          },
          "732430802": {
            "id": "732430802",
            "speakerId": 13173,
            "speakerName": "留言",
            "text": "「试想，如果我们能用虚空直接给大家分配工作，交易所的商品交换也由虚空直接管理。」",
            "nextDialogs": [
              "732430803"
            ]
          },
          "732430803": {
            "id": "732430803",
            "speakerId": 13173,
            "speakerName": "留言",
            "text": "「等到那个时候，我们起码能裁撤掉一半的教令官。」",
            "nextDialogs": [
              "732430804"
            ]
          },
          "732430804": {
            "id": "732430804",
            "speakerId": 1002,
            "speakerName": "另一人的留言",
            "text": "「你说的很有道理，所以我想或许这就是我们没办法这么做的原因。」"
          }
        }
      }
    },
    {
      "subId": "7324309",
      "subQuestName": "",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "732430901"
        ],
        "dialogs": {
          "732430901": {
            "id": "732430901",
            "speakerId": 13173,
            "speakerName": "留言",
            "text": "「众所周知，探求深秘的智慧才是学者的本职。但现在的教令院，实在过多的牵涉到行政事务当中了。」",
            "nextDialogs": [
              "732430902"
            ]
          },
          "732430902": {
            "id": "732430902",
            "speakerId": 13173,
            "speakerName": "留言",
            "text": "「如今很多同学在匆匆完成学业后，就不得不停下手中的研究，被委派去各地负担教令官的工作，这是否已经背离了教令院的初衷呢？」",
            "nextDialogs": [
              "732430903"
            ]
          },
          "732430903": {
            "id": "732430903",
            "speakerId": 1002,
            "speakerName": "另一人的留言",
            "text": "「这个问题不是早在虚空里就已经有结论了吗？」",
            "nextDialogs": [
              "732430904"
            ]
          },
          "732430904": {
            "id": "732430904",
            "speakerId": 1002,
            "speakerName": "另一人的留言",
            "text": "「在百姓还陷于迷信之中，唯有我们最为接近真理的光辉。我们又怎能卸下用火光照亮世人这样的重责呢。我们要是不管的话，须弥还不知道要乱成什么样子呢！」"
          }
        }
      }
    },
    {
      "subId": "7324310",
      "subQuestName": "",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "732431001"
        ],
        "dialogs": {
          "732431001": {
            "id": "732431001",
            "speakerId": 13173,
            "speakerName": "留言",
            "text": "「作为留学生，在教令院学习的每一天都让我更加感受到树王的伟大。」",
            "nextDialogs": [
              "732431002"
            ]
          },
          "732431002": {
            "id": "732431002",
            "speakerId": 13173,
            "speakerName": "留言",
            "text": "「在蒙德的时候，再简单的问题都要翻上十几本书才刚刚能把不同的说法整理出来。」",
            "nextDialogs": [
              "732431003"
            ]
          },
          "732431003": {
            "id": "732431003",
            "speakerId": 13173,
            "speakerName": "留言",
            "text": "「但有了『虚空终端』之后，只要思考特定的内容就能获得正确的知识。我想世上绝不会有比虚空更伟大的造物了。」"
          }
        }
      }
    },
    {
      "subId": "7324311",
      "subQuestName": "",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "732431101"
        ],
        "dialogs": {
          "732431101": {
            "id": "732431101",
            "speakerId": 13173,
            "speakerName": "留言",
            "text": "「自迦毗鸠师之后，教令院每年划拨给刹诃伐罗学院的经费就没有涨过。」",
            "nextDialogs": [
              "732431102"
            ]
          },
          "732431102": {
            "id": "732431102",
            "speakerId": 13173,
            "speakerName": "留言",
            "text": "「上面的人只会说什么为了大家稳定安宁的生活，必须严格控制机械技术的研发和推广。要真按这么说，我看干脆把虚空也关了算了。」",
            "nextDialogs": [
              "732431103"
            ]
          },
          "732431103": {
            "id": "732431103",
            "speakerId": 13173,
            "speakerName": "留言",
            "text": "「如果不是有像桑歌玛哈巴依老爷这样有慧眼的商人长期投资，我们妙论派早就关门大吉了！」"
          }
        }
      }
    },
    {
      "subId": "7324312",
      "subQuestName": "",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "732431201"
        ],
        "dialogs": {
          "732431201": {
            "id": "732431201",
            "speakerId": 13173,
            "speakerName": "留言",
            "text": "「虽然我完全信任贤者和导师们的判断，但如今的教令院是否太依赖虚空了呢。」",
            "nextDialogs": [
              "732431202"
            ]
          },
          "732431202": {
            "id": "732431202",
            "speakerId": 13173,
            "speakerName": "留言",
            "text": "「习惯于通过虚空获取知识后，我们外派出的游学者学术能力的下降是有目共睹的。我认为有必要通过法令限制初入学的学生对虚空的使用。」",
            "nextDialogs": [
              "732431203"
            ]
          },
          "732431203": {
            "id": "732431203",
            "speakerId": 1002,
            "speakerName": "另一人的留言",
            "text": "「怎么能这么说，你不知道那些隐遁沙漠之中，未能接受虚空教导的学派早已陷入无知与迷狂之中，乃至于用生吞毒蛇的愚行来接近智慧了吗？」",
            "nextDialogs": [
              "732431204"
            ]
          },
          "732431204": {
            "id": "732431204",
            "speakerId": 1002,
            "speakerName": "另一人的留言",
            "text": "「在大慈树王身后，恰恰是虚空保证了我们知识的纯洁。」"
          }
        }
      }
    },
    {
      "subId": "7324313",
      "subQuestName": "",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "732431301"
        ],
        "dialogs": {
          "732431301": {
            "id": "732431301",
            "speakerId": 1004,
            "speakerName": "巡林官公告",
            "text": "本周由巡林官提纳里大人主讲的「植物学讲座」将照常于禅那园举办，欢迎大家报名。",
            "nextDialogs": [
              "732431302"
            ]
          },
          "732431302": {
            "id": "732431302",
            "speakerId": 1004,
            "speakerName": "巡林官公告",
            "text": "不管是什么人，只要对植物感兴趣都可以来参加！",
            "nextDialogs": [
              "732431303"
            ]
          },
          "732431303": {
            "id": "732431303",
            "speakerId": 1005,
            "speakerName": "教令院公告",
            "text": "非常抱歉，由于本次讲座报名人数太多，为方便知识管理，经教令院讨论决定，将仅限生论派的同学及巡林工作人员参加，特此公告。"
          }
        }
      }
    },
    {
      "subId": "7324314",
      "subQuestName": "",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "732431401"
        ],
        "dialogs": {
          "732431401": {
            "id": "732431401",
            "speakerId": 13173,
            "speakerName": "留言",
            "text": "「有人看了最新的八重堂小说吗？这次有我们须弥的作者哦，好像是叫…普尔希娜什么的吧，一看就是你们生论派的人。」",
            "nextDialogs": [
              "732431402"
            ]
          },
          "732431402": {
            "id": "732431402",
            "speakerId": 13173,
            "speakerName": "留言",
            "text": "「唉…我要是当初也能考进阿弥利多学院就好了，不仅天天能游山玩水，还有空写小说。结果进了这个室罗婆耽，每天除了读文献就是写论文，连出去考察的机会都没有。」",
            "nextDialogs": [
              "732431403"
            ]
          },
          "732431403": {
            "id": "732431403",
            "speakerId": 1002,
            "speakerName": "另一人的留言",
            "text": "「什么，竟然有人抢在老夫之前在八重堂出版了小说，这下本人轻小说研究权威的身份岂不是…」"
          }
        }
      }
    },
    {
      "subId": "7324315",
      "subQuestName": "",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "732431501"
        ],
        "dialogs": {
          "732431501": {
            "id": "732431501",
            "speakerId": 13173,
            "speakerName": "留言",
            "text": "「果然生意和书本上的事情是两码事，要是当初留在大巴扎好好做生意就好了。」",
            "nextDialogs": [
              "732431502"
            ]
          },
          "732431502": {
            "id": "732431502",
            "speakerId": 13173,
            "speakerName": "留言",
            "text": "「结果现在论文也写不出来，钱也没了。」",
            "nextDialogs": [
              "732431503"
            ]
          },
          "732431503": {
            "id": "732431503",
            "speakerId": 13173,
            "speakerName": "留言",
            "text": "「实在不行，干脆退学去镀金旅团算了。」"
          }
        }
      }
    },
    {
      "subId": "7324316",
      "subQuestName": "",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "732431601"
        ],
        "dialogs": {
          "732431601": {
            "id": "732431601",
            "speakerId": 13173,
            "speakerName": "留言",
            "text": "「不是说我对沙漠来的人有什么意见，但是我看大风纪官还是得德高望重的学者来担任才是，特别是学术的问题可不是靠打架能解决的。」",
            "nextDialogs": [
              "732431602"
            ]
          },
          "732431602": {
            "id": "732431602",
            "speakerId": 1002,
            "speakerName": "另一人的留言",
            "text": "「呵呵，我看至少比你们明论派的人管的时候要好多了，至少不会偏袒哪个学院。真以为没人知道你们以前每年的发表率是怎么回事？」",
            "nextDialogs": [
              "732431603"
            ]
          },
          "732431603": {
            "id": "732431603",
            "speakerId": 13173,
            "speakerName": "留言",
            "text": "「喂！妙论派的家伙，你说话可要拿出证据，不然我可要找风纪官评理了。」"
          }
        }
      }
    },
    {
      "subId": "7324317",
      "subQuestName": "",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "732431701"
        ],
        "dialogs": {
          "732431701": {
            "id": "732431701",
            "speakerId": 13173,
            "speakerName": "留言",
            "text": "「开放其他国家的人来留学也就算了，现在连虚空也要开放给外国人…」",
            "nextDialogs": [
              "732431702"
            ]
          },
          "732431702": {
            "id": "732431702",
            "speakerId": 13173,
            "speakerName": "留言",
            "text": "「且不说外国人的脑袋会不会给虚空造成什么不好的影响，光是不可避免的知识外流问题，就不知道会对须弥的外贸经济造成多大影响。」",
            "nextDialogs": [
              "732431703"
            ]
          },
          "732431703": {
            "id": "732431703",
            "speakerId": 1002,
            "speakerName": "另一人的留言",
            "text": "「竟然有学者会关心经济问题，还真是少见…」",
            "nextDialogs": [
              "732431704"
            ]
          },
          "732431704": {
            "id": "732431704",
            "speakerId": 13173,
            "speakerName": "留言",
            "text": "「所以说你们知论派就是不食人间烟火，要不是为了能合成出更好的漆器涂料，我才不会考来教令院呢！」"
          }
        }
      }
    },
    {
      "subId": "7324318",
      "subQuestName": "",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "732431801"
        ],
        "dialogs": {
          "732431801": {
            "id": "732431801",
            "speakerId": 13173,
            "speakerName": "留言",
            "text": "「最近好久没看到那个沙漠矮子了，看来总算可以放松一会了。」",
            "nextDialogs": [
              "732431802"
            ]
          },
          "732431802": {
            "id": "732431802",
            "speakerId": 13173,
            "speakerName": "留言",
            "text": "「这帮管风纪的家伙也不知道闻了什么香这么积极，害得我上个学年的考核都没过。」",
            "nextDialogs": [
              "732431803"
            ]
          },
          "732431803": {
            "id": "732431803",
            "speakerId": 1002,
            "speakerName": "另一人的留言",
            "text": "「我记得那个考核不是光靠出勤都能过吗，你自己不好好学习还要赖别人。而且虽然最近风纪官人手短缺，不过你这样乱说还是小心被找上门吧。」",
            "nextDialogs": [
              "732431804"
            ]
          },
          "732431804": {
            "id": "732431804",
            "speakerId": 13173,
            "speakerName": "留言",
            "text": "「什么风纪官，说白了还不是上面的人装装样子的。等一下，虚空给我发了个消息…」",
            "nextDialogs": [
              "732431805"
            ]
          },
          "732431805": {
            "id": "732431805",
            "speakerId": 1002,
            "speakerName": "另一人的留言",
            "text": "「看来大家还是谨慎一点比较好。」"
          }
        }
      }
    },
    {
      "subId": "7324319",
      "subQuestName": "",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "732431901"
        ],
        "dialogs": {
          "732431901": {
            "id": "732431901",
            "speakerId": 1006,
            "speakerName": "被涂改的留言",
            "text": "「…关于『赞迪克』其人其事的调查结果…陀裟多…死亡原因…谋害可能…」",
            "nextDialogs": [
              "732431902"
            ]
          },
          "732431902": {
            "id": "732431902",
            "speakerId": 1006,
            "speakerName": "被涂改的留言",
            "text": "「…『赞迪克』…除名后…对于魔鳞症…但缺乏证据…」",
            "nextDialogs": [
              "732431903"
            ]
          },
          "732431903": {
            "id": "732431903",
            "speakerId": 1006,
            "speakerName": "被涂改的留言",
            "text": "「…记录突然消失…不明年份…魔鳞症开始传播…」",
            "nextDialogs": [
              "732431904"
            ]
          },
          "732431904": {
            "id": "732431904",
            "speakerId": 1006,
            "speakerName": "被涂改的留言",
            "text": "「…失踪前…『法留纳传说』…执着于…」",
            "nextDialogs": [
              "732431905"
            ]
          },
          "732431905": {
            "id": "732431905",
            "speakerId": 1006,
            "speakerName": "被涂改的留言",
            "text": "【以下的内容被污损得很彻底，完全看不到有意义的文字了。】"
          }
        }
      }
    },
    {
      "subId": "7324320",
      "subQuestName": "",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "732432001"
        ],
        "dialogs": {
          "732432001": {
            "id": "732432001",
            "speakerId": 13173,
            "speakerName": "留言",
            "text": "「在读过伟大的塔巴里贤者编制的『星表』之后，我才终于意识到，魔神的战争也好，古国的覆灭也罢，不过都是群星运行在大地上的投影。」",
            "nextDialogs": [
              "732432002"
            ]
          },
          "732432002": {
            "id": "732432002",
            "speakerId": 13173,
            "speakerName": "留言",
            "text": "「唯一永恒的只有我们头上的星空。」",
            "nextDialogs": [
              "732432003"
            ]
          },
          "732432003": {
            "id": "732432003",
            "speakerId": 1002,
            "speakerName": "另一人的留言",
            "text": "「唔…抛去在严谨的学术研究中加入不知所谓的抒情元素不谈，原来明论派的研究就是把前后上千年的事情都混为一谈吗？」",
            "nextDialogs": [
              "732432004"
            ]
          },
          "732432004": {
            "id": "732432004",
            "speakerId": 1002,
            "speakerName": "另一人的留言",
            "text": "「真希望你们能学会从历史的角度看问题，而不是整天盯着星星神神叨叨的。」",
            "nextDialogs": [
              "732432005"
            ]
          },
          "732432005": {
            "id": "732432005",
            "speakerId": 13173,
            "speakerName": "留言",
            "text": "「你懂什么！这叫探究世界的法则，怪不得说你们伐护末那都是书呆子。」"
          }
        }
      }
    },
    {
      "subId": "7324321",
      "subQuestName": "",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "732432101"
        ],
        "dialogs": {
          "732432101": {
            "id": "732432101",
            "speakerId": 13173,
            "speakerName": "留言",
            "text": "「作为留学生，在教令院学习的每一天都让我更加感受到草神的伟大。」",
            "nextDialogs": [
              "732432102"
            ]
          },
          "732432102": {
            "id": "732432102",
            "speakerId": 13173,
            "speakerName": "留言",
            "text": "「在蒙德的时候，再简单的问题都要翻上十几本书才刚刚能把不同的说法整理出来。」",
            "nextDialogs": [
              "732432103"
            ]
          },
          "732432103": {
            "id": "732432103",
            "speakerId": 13173,
            "speakerName": "留言",
            "text": "「但有了「虚空终端」之后，只要思考特定的内容就能获得正确的知识。我想世上绝不会有比虚空更伟大的造物了。」"
          }
        }
      }
    },
    {
      "subId": "7324322",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "732432201"
        ],
        "dialogs": {
          "732432201": {
            "id": "732432201",
            "speakerId": 13173,
            "speakerName": "留言",
            "text": "「虽然我完全信任贤者和导师们的判断，但如今的教令院是否太依赖虚空了呢。」",
            "nextDialogs": [
              "732432202"
            ]
          },
          "732432202": {
            "id": "732432202",
            "speakerId": 13173,
            "speakerName": "留言",
            "text": "「习惯于通过虚空获取知识后，我们外派出的游学者学术能力的下降是有目共睹的。我认为有必要通过法令限制初入学的学生对虚空的使用。」",
            "nextDialogs": [
              "732432203"
            ]
          },
          "732432203": {
            "id": "732432203",
            "speakerId": 1002,
            "speakerName": "另一人的留言",
            "text": "「怎么能这么说，你不知道那些隐遁沙漠之中，未能接受虚空教导的学派早已陷入无知与迷狂之中，乃至于用生吞毒蛇的愚行来接近智慧了吗？」",
            "nextDialogs": [
              "732432204"
            ]
          },
          "732432204": {
            "id": "732432204",
            "speakerId": 1002,
            "speakerName": "另一人的留言",
            "text": "「人们没有意识到的是，恰恰是虚空保证了我们知识的纯洁。」"
          }
        }
      }
    },
    {
      "subId": "7324323",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "732432301"
        ],
        "dialogs": {
          "732432301": {
            "id": "732432301",
            "speakerId": 1000,
            "speakerName": "教令院公共留言板",
            "text": "由于「虚空系统」已停止使用，此公告牌现重新启用。教令院相关通知及内外法令公告皆在此公告，院外人士请勿随意留言！"
          }
        }
      }
    },
    {
      "subId": "7324324",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "732432401"
        ],
        "dialogs": {
          "732432401": {
            "id": "732432401",
            "speakerId": 1003,
            "speakerName": "风纪官的留言",
            "text": "「此留言板供教令院内部交流使用，严禁在此传播虚假不实与非法信息。」",
            "nextDialogs": [
              "732432402"
            ]
          },
          "732432402": {
            "id": "732432402",
            "speakerId": 1003,
            "speakerName": "风纪官的留言",
            "text": "「风纪官将持续提醒大家注意身为学者的言行准则！」"
          }
        }
      }
    }
  ]
}
        ],
        "dialogs": {
          "749410101": {
            "id": "749410101",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "你会维修机关？",
            "nextDialogs": [
              "749410102"
            ]
          },
          "749410102": {
            "id": "749410102",
            "speakerId": 5211,
            "speakerName": "德尼谢尔",
            "text": "我之前就在一个制造机关的项目组工作，不过…那个项目组总是频繁更换领头的人。",
            "nextDialogs": [
              "749410103"
            ]
          },
          "749410103": {
            "id": "749410103",
            "speakerId": 5211,
            "speakerName": "德尼谢尔",
            "text": "而且每一位新领头人上任时，都要把之前做过的工作全部重新做一遍。",
            "nextDialogs": [
              "749410104"
            ]
          },
          "749410104": {
            "id": "749410104",
            "speakerId": 5211,
            "speakerName": "德尼谢尔",
            "text": "我实在受不了这种折磨，就和安里商量了一下，在折腾了一段时间后，转去了他所在的枫达项目组。",
            "nextDialogs": [
              "749410105"
            ]
          },
          "749410105": {
            "id": "749410105",
            "speakerId": 5211,
            "speakerName": "德尼谢尔",
            "text": "不过，没想到过了这么长时间，我又得修机关了…",
            "nextDialogs": [
              "749410106"
            ]
          },
          "749410106": {
            "id": "749410106",
            "speakerId": 5211,
            "speakerName": "德尼谢尔",
            "text": "喔，我准备材料时买多了一些零件，我用不上它们，你拿着吧，也许能派上用场。"
          }
        }
      }
    }
  ]
}
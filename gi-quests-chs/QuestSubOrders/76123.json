            ]
          },
          "761230105": {
            "id": "761230105",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "哇，这个好喝欸…",
            "nextDialogs": [
              "761230106"
            ]
          },
          "761230106": {
            "id": "761230106",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "清香爽口的甜果子汤，是在别的地方没喝过的味道！",
            "nextDialogs": [
              "761230107"
            ]
          },
          "761230107": {
            "id": "761230107",
            "speakerId": 1001,
            "speakerName": "哥伦比娅",
            "text": "再来一碗？",
            "nextDialogs": [
              "761230108"
            ]
          },
          "761230108": {
            "id": "761230108",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "两碗！",

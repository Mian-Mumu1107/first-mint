            ]
          },
          "761230109": {
            "id": "761230109",
            "speakerId": 1003,
            "speakerName": "努昂诺塔",
            "text": "……！",
            "nextDialogs": [
              "761230110"
            ]
          },
          "761230110": {
            "id": "761230110",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "哥伦比娅最近在学习烹饪？",
            "nextDialogs": [
              "761230111"
            ]
          },
          "761230111": {
            "id": "761230111",
            "speakerId": 1001,
            "speakerName": "哥伦比娅",
            "text": "嗯，我问伊涅芙要了些基础菜谱，已经尝试了几次。月灵和小动物们的反响都不错。",
            "nextDialogs": [
              "761230112"
            ]
          },
          "761230112": {
            "id": "761230112",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "有遇到什么难点吗？",
            "nextDialogs": [
              "761230113"
            ]
          },
          "761230113": {
            "id": "761230113",
            "speakerId": 1001,
            "speakerName": "哥伦比娅",
            "text": "唔，袖子太宽了，一不小心就会沾到锅边…",
            "nextDialogs": [
              "761230114"
            ]
          },
          "761230114": {
            "id": "761230114",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "（原来不是烹饪本身的困难啊。）",
            "nextDialogs": [
              "761230115"
            ]
          },
          "761230115": {
            "id": "761230115",
            "speakerId": 1001,
            "speakerName": "哥伦比娅",
            "text": "不过，在制作点心类食物的时候，会有些应付不来。",
            "nextDialogs": [
              "761230116"
            ]
          },
          "761230116": {
            "id": "761230116",
            "speakerId": 1001,
            "speakerName": "哥伦比娅",
            "text": "它们对于温度和比例的要求很严格…",
            "nextDialogs": [
              "761230117"
            ]
          },
          "761230117": {
            "id": "761230117",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "（看来她以前很少自己做东西吃。）",
            "nextDialogs": [
              "761230118"
            ]
          },
          "761230118": {
            "id": "761230118",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "（而且点心类的料理，如果只靠自己摸索的话，的确会不容易…）",
            "nextDialogs": [
              "761230119"
            ]
          },
          "761230119": {
            "id": "761230119",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "要我来帮你吗？",
            "nextDialogs": [
              "761230120"
            ]
          },
          "761230120": {
            "id": "761230120",
            "speakerId": 1001,
            "speakerName": "哥伦比娅",
            "text": "好呀。先从蛋卷开始吧。",
            "nextDialogs": [
              "761230121"
            ]
          },
          "761230121": {
            "id": "761230121",
            "speakerId": 1004,
            "speakerName": "Black Screen",
            "text": "一段时间过后…",

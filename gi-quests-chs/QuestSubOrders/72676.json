    {
      "subId": "7267601",
      "subQuestName": "前往蒙德城的「猎鹿人」餐馆",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "726760101"
        ],
        "dialogs": {
          "726760101": {
            "id": "726760101",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "莎拉小姐！你好！",
            "nextDialogs": [
              "726760102"
            ]
          },
          "726760102": {
            "id": "726760102",
            "speakerId": 1419,
            "speakerName": "莎拉",
            "text": "#哎呀，欢迎光临，派蒙和{NICKNAME}！还有这位…是新型兔兔伯爵么…？",
            "nextDialogs": [
              "726760103"
            ]
          },
          "726760103": {
            "id": "726760103",
            "speakerId": 3160,
            "speakerName": "「吉法师」",
            "text": "吉法师！",
            "nextDialogs": [
              "726760105",
              "726760107",
              "726760110"
            ]
          },
          "726760105": {
            "id": "726760105",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "嗯，是我们在稻妻认识的新朋友喔！",
            "nextDialogs": [
              "726760113"
            ]
          },
          "726760113": {
            "id": "726760113",
            "speakerId": 3160,
            "speakerName": "「吉法师」",
            "text": "嗯，好朋友！",
            "nextDialogs": [
              "726760114"
            ]
          },
          "726760114": {
            "id": "726760114",
            "speakerId": 1419,
            "speakerName": "莎拉",
            "text": "原来是这样，真是不好意思。欢迎光临猎鹿人，吉法师。",
            "nextDialogs": [
              "726760115"
            ]
          },
          "726760115": {
            "id": "726760115",
            "speakerId": 1419,
            "speakerName": "莎拉",
            "text": "稻妻呀，真了不起…之前听塞琉斯先生说过，那是雷暴包围的国度，到处都会打雷，有点像丽莎小姐生气时候的天空。非常恐怖。"
          },
          "726760107": {
            "id": "726760107",
            "speakerId": 3160,
            "speakerName": "「吉法师」",
            "text": "臭臭伯爵？",
            "nextDialogs": [
              "726760108"
            ]
          },
          "726760108": {
            "id": "726760108",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "#喂！别听{PLAYERAVATAR#SEXPRO[INFO_MALE_PRONOUN_HE|INFO_FEMALE_PRONOUN_SHE]}的。这位是吉法师，我们在稻妻认识的新朋友！"
          },
          "726760110": {
            "id": "726760110",
            "speakerId": 3160,
            "speakerName": "「吉法师」",
            "text": "锅巴？",
            "nextDialogs": [
              "726760111"
            ]
          },
          "726760111": {
            "id": "726760111",
            "speakerId": 1419,
            "speakerName": "莎拉",
            "text": "「锅巴」？锅巴是指，璃月的名菜「绝云锅巴」么…？",
            "nextDialogs": [
              "726760112"
            ]
          },
          "726760112": {
            "id": "726760112",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "#喂！别听{PLAYERAVATAR#SEXPRO[INFO_MALE_PRONOUN_HE|INFO_FEMALE_PRONOUN_SHE]}的。这位是吉法师，我们在稻妻认识的新朋友！"
          }
        }
      }
    },
    {
      "subId": "7267602",
      "subQuestName": "烹饪「美味的甜甜花酿鸡」",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [],
        "dialogs": {}
      }
    },
    {
      "subId": "7267603",
      "subQuestName": "坐下与派蒙和吉法师一同享用美食",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "726760301"
        ],
        "dialogs": {
          "726760301": {
            "id": "726760301",
            "speakerId": 3160,
            "speakerName": "「吉法师」",
            "text": "没见过的东西。不过，好香。咕噜。",
            "nextDialogs": [
              "726760302"
            ]
          },
          "726760302": {
            "id": "726760302",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "#这就是美味的「甜甜花酿鸡」！应该算是{NICKNAME}的拿手菜吧？",
            "nextDialogs": [
              "726760304",
              "726760306"
            ]
          },
          "726760304": {
            "id": "726760304",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "嗯，毕竟野外材料很充实呢！",
            "nextDialogs": [
              "726760308"
            ]
          },
          "726760308": {
            "id": "726760308",
            "speakerId": 1003,
            "speakerName": "Black Screen",
            "text": "一同开始享用「美味的甜甜花酿鸡」。\\n吉法师似乎有些警惕，但最终还是禁不起香气的诱惑，吃了起来。",
            "nextDialogs": [
              "726760309"
            ]
          },
          "726760309": {
            "id": "726760309",
            "speakerId": 3160,
            "speakerName": "「吉法师」",
            "text": "…咕噜。",
            "nextDialogs": [
              "726760310"
            ]
          },
          "726760310": {
            "id": "726760310",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "吉法师，怎么了？"
          },
          "726760306": {
            "id": "726760306",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "既然刚刚提到凯亚…",
            "nextDialogs": [
              "726760307"
            ]
          },
          "726760307": {
            "id": "726760307",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "#嗯，{NICKNAME}「连骑士般的谦虚品德也已经具备了！」"
          }
        }
      }
    },
    {
      "subId": "7267604",
      "subQuestName": "前往教堂前的风神像",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "726760401"
        ],
        "dialogs": {
          "726760401": {
            "id": "726760401",
            "speakerId": 10002,
            "speakerName": "莎拉",
            "text": "甜甜花酿鸡吗…是一道看似简单，但很考验厨师真材实料的菜呢。"
          }
        }
      }
    },
    {
      "subId": "7267605",
      "subQuestName": "登上神像的掌心",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "726760501"
        ],
        "dialogs": {
          "726760501": {
            "id": "726760501",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "你看，没什么好怕的吧。",
            "nextDialogs": [
              "726760502"
            ]
          },
          "726760502": {
            "id": "726760502",
            "speakerId": 3160,
            "speakerName": "「吉法师」",
            "text": "嗯。风神好高，比五百藏还高。而且，好硬。又高又硬。",
            "nextDialogs": [
              "726760503"
            ]
          },
          "726760503": {
            "id": "726760503",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "…我已经懒得解释石像和本尊的区别了。",
            "nextDialogs": [
              "726760504"
            ]
          },
          "726760504": {
            "id": "726760504",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "风神是很好的人。",
            "nextDialogs": [
              "726760507"
            ]
          },
          "726760507": {
            "id": "726760507",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "这么说来，芭芭拉小姐发现了没有，天空之琴的事情…"
          }
        }
      }
    },
    {
      "subId": "7267606",
      "subQuestName": "为吉法师拍照",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [],
        "dialogs": {}
      }
    },
    {
      "subId": "7267607",
      "subQuestName": "与吉法师对话",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "726760701"
        ],
        "dialogs": {
          "726760701": {
            "id": "726760701",
            "speakerId": 3160,
            "speakerName": "「吉法师」",
            "text": "看看！",
            "nextDialogs": [
              "726760702"
            ]
          },
          "726760702": {
            "id": "726760702",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "别着急啦！",
            "nextDialogs": [
              "726760703"
            ]
          },
          "726760703": {
            "id": "726760703",
            "speakerId": 1003,
            "speakerName": "Black Screen",
            "text": "向吉法师与派蒙展示刚刚拍的相片。",
            "nextDialogs": [
              "726760704"
            ]
          },
          "726760704": {
            "id": "726760704",
            "speakerId": 3160,
            "speakerName": "「吉法师」",
            "text": "好帅，好大的手。",
            "nextDialogs": [
              "726760705"
            ]
          },
          "726760705": {
            "id": "726760705",
            "speakerId": 3160,
            "speakerName": "「吉法师」",
            "text": "回去以后，给五百藏看，风神的手比五百藏还大。",
            "nextDialogs": [
              "726760706"
            ]
          },
          "726760706": {
            "id": "726760706",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "五百藏的尺寸，和这个没办法比吧…",
            "nextDialogs": [
              "726760707"
            ]
          },
          "726760707": {
            "id": "726760707",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "「五百藏，好弱。」",
            "nextDialogs": [
              "726760708"
            ]
          },
          "726760708": {
            "id": "726760708",
            "speakerId": 3160,
            "speakerName": "「吉法师」",
            "text": "五百藏，好弱好弱，呶哈哈。",
            "nextDialogs": [
              "726760709"
            ]
          },
          "726760709": {
            "id": "726760709",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "喂！这样对吉法师影响不好啦！",
            "nextDialogs": [
              "726760710"
            ]
          },
          "726760710": {
            "id": "726760710",
            "speakerId": 3160,
            "speakerName": "「吉法师」",
            "text": "五百藏认真的时候，可以变得好大好大。比一百个八叠还大。",
            "nextDialogs": [
              "726760711"
            ]
          },
          "726760711": {
            "id": "726760711",
            "speakerId": 3160,
            "speakerName": "「吉法师」",
            "text": "五百藏很厉害。不过，吉法师要变得更厉害。",
            "nextDialogs": [
              "726760712"
            ]
          },
          "726760712": {
            "id": "726760712",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "唔…吉法师为什么要变得更厉害呢？",
            "nextDialogs": [
              "726760713"
            ]
          },
          "726760713": {
            "id": "726760713",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "吉法师现在也很厉害呀，还能变出可以滑翔的气囊。差不多有派蒙一半厉害吧！",
            "nextDialogs": [
              "726760714"
            ]
          },
          "726760714": {
            "id": "726760714",
            "speakerId": 3160,
            "speakerName": "「吉法师」",
            "text": "吉法师变得更厉害，就可以用更厉害的法术。",
            "nextDialogs": [
              "726760715"
            ]
          },
          "726760715": {
            "id": "726760715",
            "speakerId": 3160,
            "speakerName": "「吉法师」",
            "text": "可以用更厉害的法术，就可以把五百藏变成不是石头。",
            "nextDialogs": [
              "726760716"
            ]
          },
          "726760716": {
            "id": "726760716",
            "speakerId": 3160,
            "speakerName": "「吉法师」",
            "text": "#所以，吉法师要修行呶，和{NICKNAME}和派蒙一起。",
            "nextDialogs": [
              "726760717"
            ]
          },
          "726760717": {
            "id": "726760717",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "是这样啊…",
            "nextDialogs": [
              "726760718"
            ]
          },
          "726760718": {
            "id": "726760718",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "——欸！记住我的名字了！好开心！",
            "nextDialogs": [
              "726760719"
            ]
          },
          "726760719": {
            "id": "726760719",
            "speakerId": 3160,
            "speakerName": "「吉法师」",
            "text": "开心！呶哈哈。",
            "nextDialogs": [
              "726760720"
            ]
          },
          "726760720": {
            "id": "726760720",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "吉法师要加油。",
            "nextDialogs": [
              "726760721"
            ]
          },
          "726760721": {
            "id": "726760721",
            "speakerId": 3160,
            "speakerName": "「吉法师」",
            "text": "加油！耶！",
            "nextDialogs": [
              "726760722"
            ]
          },
          "726760722": {
            "id": "726760722",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "那么，接下来去什么地方呢？",
            "nextDialogs": [
              "726760723"
            ]
          },
          "726760723": {
            "id": "726760723",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "嗯…既然已经吃过了蒙德的东西，接下来去璃月港吧！",
            "nextDialogs": [
              "726760724"
            ]
          },
          "726760724": {
            "id": "726760724",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "万民堂的美味，也好久没尝过了呢。",
            "nextDialogs": [
              "726760725"
            ]
          },
          "726760725": {
            "id": "726760725",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "刚刚才吃了一顿…",
            "nextDialogs": [
              "726760726"
            ]
          },
          "726760726": {
            "id": "726760726",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "哼哼，蒙德的菜，和璃月的菜，当然是装在不同的胃袋里的。",
            "nextDialogs": [
              "726760727"
            ]
          },
          "726760727": {
            "id": "726760727",
            "speakerId": 3160,
            "speakerName": "「吉法师」",
            "text": "吃！出发！",
            "nextDialogs": [
              "726760728"
            ]
          },
          "726760728": {
            "id": "726760728",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "出发！目标——万民堂！"
          }
        }
      }
    },
    {
      "subId": "7267608",
      "subQuestName": "前往璃月港的「万民堂」餐馆",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "726760801"
        ],
        "dialogs": {
          "726760801": {
            "id": "726760801",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "卯师傅你好！首先，要一份水煮黑背鲈…",
            "nextDialogs": [
              "726760802"
            ]
          },
          "726760802": {
            "id": "726760802",
            "speakerId": 2045,
            "speakerName": "卯师傅",
            "text": "哎，偏偏这时候来客人啊…对不住了，现在暂时不能点单。",
            "nextDialogs": [
              "726760803"
            ]
          },
          "726760803": {
            "id": "726760803",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "欸？怎么会这样…",
            "nextDialogs": [
              "726760804"
            ]
          },
          "726760804": {
            "id": "726760804",
            "speakerId": 2045,
            "speakerName": "卯师傅",
            "text": "早些时候打蒙德来了个骑士，下了老大一笔外带单。要咱们做几十个人分量的吃食，他要带去…什么地方来着？",
            "nextDialogs": [
              "726760805"
            ]
          },
          "726760805": {
            "id": "726760805",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "蒙德城的歌德大酒店？",
            "nextDialogs": [
              "726760806"
            ]
          },
          "726760806": {
            "id": "726760806",
            "speakerId": 2045,
            "speakerName": "卯师傅",
            "text": "哎，没错！你怎么知道？",
            "nextDialogs": [
              "726760807"
            ]
          },
          "726760807": {
            "id": "726760807",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "凯亚这家伙…",
            "nextDialogs": [
              "726760808"
            ]
          },
          "726760808": {
            "id": "726760808",
            "speakerId": 2045,
            "speakerName": "卯师傅",
            "text": "实在是对不住，这单一时半会也没办法做完。你瞧，锅里正烧着菜呢。也不晓得那家伙，带着那么多菜要怎么走…不要浪费才好…",
            "nextDialogs": [
              "726760809"
            ]
          },
          "726760809": {
            "id": "726760809",
            "speakerId": 2045,
            "speakerName": "卯师傅",
            "text": "生意来得太突然，连伙房里的材料都不够了，这会儿我闺女也在外头帮忙找绝云椒椒呢。",
            "nextDialogs": [
              "726760810"
            ]
          },
          "726760810": {
            "id": "726760810",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "呜呜…",
            "nextDialogs": [
              "726760811"
            ]
          },
          "726760811": {
            "id": "726760811",
            "speakerId": 3160,
            "speakerName": "「吉法师」",
            "text": "呜呶呶…",
            "nextDialogs": [
              "726760812"
            ]
          },
          "726760812": {
            "id": "726760812",
            "speakerId": 2045,
            "speakerName": "卯师傅",
            "text": "欸？这位…小朋友是？",
            "nextDialogs": [
              "726760814",
              "726760817",
              "726760821"
            ]
          },
          "726760814": {
            "id": "726760814",
            "speakerId": 3160,
            "speakerName": "「吉法师」",
            "text": "你好！",
            "nextDialogs": [
              "726760815"
            ]
          },
          "726760815": {
            "id": "726760815",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "嗯！他是正在旅行修行的妖狸。",
            "nextDialogs": [
              "726760823"
            ]
          },
          "726760823": {
            "id": "726760823",
            "speakerId": 2045,
            "speakerName": "卯师傅",
            "text": "这样啊，真是对不住了，吉法师。",
            "nextDialogs": [
              "726760824"
            ]
          },
          "726760824": {
            "id": "726760824",
            "speakerId": 2045,
            "speakerName": "卯师傅",
            "text": "这么说来，我闺女也有个爱吃东西的朋友，叫锅巴。看样子，应该能和吉法师交个朋友…",
            "nextDialogs": [
              "726760825"
            ]
          },
          "726760825": {
            "id": "726760825",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "#没办法了，要不还是{NICKNAME}做…",
            "nextDialogs": [
              "726760826"
            ]
          },
          "726760826": {
            "id": "726760826",
            "speakerId": 2046,
            "speakerName": "杰里",
            "text": "…糟糕，完全忘了！",
            "nextDialogs": [
              "726760827"
            ]
          },
          "726760827": {
            "id": "726760827",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "欸？他们怎么了？",
            "nextDialogs": [
              "726760828"
            ]
          },
          "726760828": {
            "id": "726760828",
            "speakerId": 2082,
            "speakerName": "弗莱琪",
            "text": "真是的，当初怎么就没有确认日期…",
            "nextDialogs": [
              "726760829"
            ]
          },
          "726760829": {
            "id": "726760829",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "发生什么事了？",
            "nextDialogs": [
              "726760830"
            ]
          },
          "726760830": {
            "id": "726760830",
            "speakerId": 2046,
            "speakerName": "杰里",
            "text": "我们提前几个月分别预订了「琉璃亭」和「新月轩」的位子…",
            "nextDialogs": [
              "726760831"
            ]
          },
          "726760831": {
            "id": "726760831",
            "speakerId": 2082,
            "speakerName": "弗莱琪",
            "text": "想着，在回蒙德前，我们姐弟一定要将所谓「璃菜」和「月菜」的顶点都品尝过…",
            "nextDialogs": [
              "726760832"
            ]
          },
          "726760832": {
            "id": "726760832",
            "speakerId": 2046,
            "speakerName": "杰里",
            "text": "结果俩家店的位子，都定在了今天！",
            "nextDialogs": [
              "726760833"
            ]
          },
          "726760833": {
            "id": "726760833",
            "speakerId": 2082,
            "speakerName": "弗莱琪",
            "text": "要是当初确认了时间就好了！现在要怎么办才好…"
          },
          "726760817": {
            "id": "726760817",
            "speakerId": 2045,
            "speakerName": "卯师傅",
            "text": "兔什么…？",
            "nextDialogs": [
              "726760818"
            ]
          },
          "726760818": {
            "id": "726760818",
            "speakerId": 3160,
            "speakerName": "「吉法师」",
            "text": "秃秃伯爵？",
            "nextDialogs": [
              "726760819"
            ]
          },
          "726760819": {
            "id": "726760819",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "#喂！别听{PLAYERAVATAR#SEXPRO[INFO_MALE_PRONOUN_HE|INFO_FEMALE_PRONOUN_SHE]}的。这位是吉法师，正在旅行修行的妖狸喔！"
          },
          "726760821": {
            "id": "726760821",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "——「绝云锅巴」爱好者吉法师！他是正在旅行修行的妖狸。哎呀，因为听说万民堂的锅巴很好吃，想来尝尝看。",
            "nextDialogs": [
              "726760822"
            ]
          },
          "726760822": {
            "id": "726760822",
            "speakerId": 3160,
            "speakerName": "「吉法师」",
            "text": "绝云锅巴！"
          }
        }
      }
    },
    {
      "subId": "7267609",
      "subQuestName": "前往琉璃亭，与璃彩对话",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "726760901"
        ],
        "dialogs": {
          "726760901": {
            "id": "726760901",
            "speakerId": 2022,
            "speakerName": "璃彩",
            "text": "欢迎光临「琉璃亭」，请问客官有预订吗？",
            "nextDialogs": [
              "726760902"
            ]
          },
          "726760902": {
            "id": "726760902",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "是杰里替我们定的位。",
            "nextDialogs": [
              "726760903"
            ]
          },
          "726760903": {
            "id": "726760903",
            "speakerId": 2022,
            "speakerName": "璃彩",
            "text": "杰里先生是吗…请稍等片刻，我看看…",
            "nextDialogs": [
              "726760904"
            ]
          },
          "726760904": {
            "id": "726760904",
            "speakerId": 2022,
            "speakerName": "璃彩",
            "text": "确实定了今天的位子没错。久等了，里边请。"
          }
        }
      }
    },
    {
      "subId": "7267613",
      "subQuestName": "与吉法师、派蒙一同在「琉璃亭」内用餐",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "726761301"
        ],
        "dialogs": {
          "726761301": {
            "id": "726761301",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "虽然之前杰里说菜已经订好了…",
            "nextDialogs": [
              "726761302"
            ]
          },
          "726761302": {
            "id": "726761302",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "没想到居然这么丰盛…杰里和弗莱琪，真的打算就凭他们两个人，吃下这么多东西吗？",
            "nextDialogs": [
              "726761303"
            ]
          },
          "726761303": {
            "id": "726761303",
            "speakerId": 3160,
            "speakerName": "「吉法师」",
            "text": "咕噜。好香。",
            "nextDialogs": [
              "726761304"
            ]
          },
          "726761304": {
            "id": "726761304",
            "speakerId": 1003,
            "speakerName": "Black Screen",
            "text": "与派蒙、吉法师一同心怀感激地享用「琉璃亭」的美食…",
            "nextDialogs": [
              "726761305"
            ]
          },
          "726761305": {
            "id": "726761305",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "呜哇，好美味。吉法师觉得如何？",
            "nextDialogs": [
              "726761306"
            ]
          },
          "726761306": {
            "id": "726761306",
            "speakerId": 3160,
            "speakerName": "「吉法师」",
            "text": "呶！好吃！",
            "nextDialogs": [
              "726761308",
              "726761310"
            ]
          },
          "726761308": {
            "id": "726761308",
            "speakerId": 3160,
            "speakerName": "「吉法师」",
            "text": "呶哈哈，美味。真好吃。",
            "nextDialogs": [
              "726761311"
            ]
          },
          "726761311": {
            "id": "726761311",
            "speakerId": 3160,
            "speakerName": "「吉法师」",
            "text": "人类好厉害。能做这么好吃的东西，比妖狸的饭更好吃。",
            "nextDialogs": [
              "726761312"
            ]
          },
          "726761312": {
            "id": "726761312",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "这么说来，妖狸的饭是用什么做的呢？",
            "nextDialogs": [
              "726761313"
            ]
          },
          "726761313": {
            "id": "726761313",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "虽然看起来很美味，吃起来也很不错，但就是感觉有点怪…有点空虚？",
            "nextDialogs": [
              "726761314"
            ]
          },
          "726761314": {
            "id": "726761314",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "我也很好奇。",
            "nextDialogs": [
              "726761315"
            ]
          },
          "726761315": {
            "id": "726761315",
            "speakerId": 3160,
            "speakerName": "「吉法师」",
            "text": "妖狸的饭，是用叶子砰砰做的。",
            "nextDialogs": [
              "726761316"
            ]
          },
          "726761316": {
            "id": "726761316",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "叶子砰砰…是蔬菜的意思吗？",
            "nextDialogs": [
              "726761317"
            ]
          },
          "726761317": {
            "id": "726761317",
            "speakerId": 3160,
            "speakerName": "「吉法师」",
            "text": "叶子砰砰就是叶子砰砰。叶子，砰砰，好吃。"
          },
          "726761310": {
            "id": "726761310",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "喂！这是在夸我吗？"
          }
        }
      }
    },
    {
      "subId": "7267610",
      "subQuestName": "前往指定地点",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "726761001"
        ],
        "dialogs": {
          "726761001": {
            "id": "726761001",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "#吉法师，对着{NICKNAME}站好别动喔！",
            "nextDialogs": [
              "726761002"
            ]
          },
          "726761002": {
            "id": "726761002",
            "speakerId": 3160,
            "speakerName": "「吉法师」",
            "text": "耶！拍照纪念！"
          }
        }
      }
    },
    {
      "subId": "7267611",
      "subQuestName": "为吉法师拍照",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [],
        "dialogs": {}
      }
    },
    {
      "subId": "7267612",
      "subQuestName": "与吉法师对话",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "726761201"
        ],
        "dialogs": {
          "726761201": {
            "id": "726761201",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "#嗯，拍得真不错。{NICKNAME}还挺有天赋的嘛。",
            "nextDialogs": [
              "726761202"
            ]
          },
          "726761202": {
            "id": "726761202",
            "speakerId": 3160,
            "speakerName": "「吉法师」",
            "text": "这里好漂亮。和森林不一样。",
            "nextDialogs": [
              "726761203"
            ]
          },
          "726761203": {
            "id": "726761203",
            "speakerId": 3160,
            "speakerName": "「吉法师」",
            "text": "但是，下面好多船，不会沉到水里？",
            "nextDialogs": [
              "726761204"
            ]
          },
          "726761204": {
            "id": "726761204",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "不会的，不用担心。",
            "nextDialogs": [
              "726761205"
            ]
          },
          "726761205": {
            "id": "726761205",
            "speakerId": 3160,
            "speakerName": "「吉法师」",
            "text": "好耶！好厉害！",
            "nextDialogs": [
              "726761206"
            ]
          },
          "726761206": {
            "id": "726761206",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "吉法师，今天的修行，好玩吗？",
            "nextDialogs": [
              "726761209"
            ]
          },
          "726761209": {
            "id": "726761209",
            "speakerId": 3160,
            "speakerName": "「吉法师」",
            "text": "五百藏说过，玩也是修行。不能偏离狸道。",
            "nextDialogs": [
              "726761210"
            ]
          },
          "726761210": {
            "id": "726761210",
            "speakerId": 3160,
            "speakerName": "「吉法师」",
            "text": "如果忘记玩，就会偏离狸道。",
            "nextDialogs": [
              "726761211"
            ]
          },
          "726761211": {
            "id": "726761211",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "偏离狸道…会怎么样呢？",
            "nextDialogs": [
              "726761212"
            ]
          },
          "726761212": {
            "id": "726761212",
            "speakerId": 3160,
            "speakerName": "「吉法师」",
            "text": "偏离狸道的狸子，就会爆炸。",
            "nextDialogs": [
              "726761213"
            ]
          },
          "726761213": {
            "id": "726761213",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "？",
            "nextDialogs": [
              "726761214"
            ]
          },
          "726761214": {
            "id": "726761214",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "…？",
            "nextDialogs": [
              "726761215"
            ]
          },
          "726761215": {
            "id": "726761215",
            "speakerId": 3160,
            "speakerName": "「吉法师」",
            "text": "八叠会爆炸，叶子也会不见。身上的毛都变成海草，腹鼓变成大茶壶。然后狸子就会变得和鼬一样瘦，没有法力。",
            "nextDialogs": [
              "726761216"
            ]
          },
          "726761216": {
            "id": "726761216",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "…我很确定五百藏是骗人的。",
            "nextDialogs": [
              "726761217"
            ]
          },
          "726761217": {
            "id": "726761217",
            "speakerId": 3160,
            "speakerName": "「吉法师」",
            "text": "修行很好玩、很开心呶！"
          }
        }
      }
    },
    {
      "subId": "7267616",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [

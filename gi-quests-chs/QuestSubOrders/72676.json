            "speakerName": "弗莱琪",
            "text": "比我预期的还美味…"
          }
        }
      }
    },
    {
      "subId": "7267622",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "726762201"
        ],
        "dialogs": {
          "726762201": {
            "id": "726762201",
            "speakerId": 2046,
            "speakerName": "杰里",
            "text": "说起来，真不知道弗朗西斯怎么总是能定到琉璃亭和新月轩的位子…"
          }
        }
      }
    }

{
  "lineCounts": {
    "「三十人团」公告": 3,
    "健康之家公告": 3,
    "兰巴德酒馆公告": 1,
    "回复": 1,
    "教令官公告": 18,
    "教令官公告板": 1,
    "留言": 9,
    "通缉令": 6
  },
  "subQuests": [
    {
      "subId": "7319401",
      "subQuestName": "",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "731940101"
        ],
        "dialogs": {
          "731940101": {
            "id": "731940101",
            "speakerId": 1000,
            "speakerName": "教令官公告板",
            "text": "此为教令官所设公告板，须弥城内重要事务皆在此公示，如有相关问题也可在此留言。"
          }
        }
      }
    },
    {
      "subId": "7319402",
      "subQuestName": "",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "731940201"
        ],
        "dialogs": {
          "731940201": {
            "id": "731940201",
            "speakerId": 1001,
            "speakerName": "留言",
            "text": "「听说了吗？听巡林的人说，北边的森林里不知道什么时候建起了一座华丽的宫殿」",
            "nextDialogs": [
              "731940202"
            ]
          },
          "731940202": {
            "id": "731940202",
            "speakerId": 1001,
            "speakerName": "留言",
            "text": "「不过好像去过那里的人最后都被骗得身无分文，被巡林官发现的时候就剩个裤衩了。」",
            "nextDialogs": [
              "731940203"
            ]
          },
          "731940203": {
            "id": "731940203",
            "speakerId": 1001,
            "speakerName": "留言",
            "text": "「问他们到底怎么回事也不说，就知道在那哭，真是可怕啊。」",
            "nextDialogs": [
              "731940204"
            ]
          },
          "731940204": {
            "id": "731940204",
            "speakerId": 1001,
            "speakerName": "留言",
            "text": "「大家还是不要在森林里乱跑了。」"
          }
        }
      }
    },
    {
      "subId": "7319403",
      "subQuestName": "",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "731940301"
        ],
        "dialogs": {
          "731940301": {
            "id": "731940301",
            "speakerId": 1002,
            "speakerName": "教令官公告",
            "text": "须弥内外大事公告现已转由虚空投放，请大家随时佩戴「虚空终端」，以免错过重要消息。",
            "nextDialogs": [
              "731940302"
            ]
          },
          "731940302": {
            "id": "731940302",
            "speakerId": 1002,
            "speakerName": "教令官公告",
            "text": "为方便异邦商旅与长者小孩，此公告板暂时保留。未来随时可能撤除，大家请勿过分依赖。"
          }
        }
      }
    },
    {
      "subId": "7319404",
      "subQuestName": "",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "731940401"
        ],
        "dialogs": {
          "731940401": {
            "id": "731940401",
            "speakerId": 1002,
            "speakerName": "教令官公告",
            "text": "本年度的「丰沃之惠」已开始发放。",
            "nextDialogs": [
              "731940402"
            ]
          },
          "731940402": {
            "id": "731940402",
            "speakerId": 1002,
            "speakerName": "教令官公告",
            "text": "原则上将继续按照上年的发放政策和要求进行，具体内容已通过虚空投放。",
            "nextDialogs": [
              "731940403"
            ]
          },
          "731940403": {
            "id": "731940403",
            "speakerId": 1002,
            "speakerName": "教令官公告",
            "text": "如有变化请提前联系附近的教令官向教令院提出修改申请。"
          }
        }
      }
    },
    {
      "subId": "7319405",
      "subQuestName": "",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "731940501"
        ],
        "dialogs": {
          "731940501": {
            "id": "731940501",
            "speakerId": 1002,
            "speakerName": "教令官公告",
            "text": "近期城内「魔鳞病」多发，如您出现皮肤麻木、肢体无力等症状，或是观察到身体出现灰黑色的鳞片状组织，请及时前往健康之家接受治疗。",
            "nextDialogs": [
              "731940502"
            ]
          },
          "731940502": {
            "id": "731940502",
            "speakerId": 1002,
            "speakerName": "教令官公告",
            "text": "若错过最佳治疗时间，使病情发展恶化，可能导致丧失行动能力等严重后果，希望大家加以重视。"
          }
        }
      }
    },
    {
      "subId": "7319406",
      "subQuestName": "",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "731940601"
        ],
        "dialogs": {
          "731940601": {
            "id": "731940601",
            "speakerId": 1003,
            "speakerName": "「三十人团」公告",
            "text": "特别提醒，整个须弥的佣兵行业都由「镀金旅团」承接，绝无二家。",
            "nextDialogs": [
              "731940602"
            ]
          },
          "731940602": {
            "id": "731940602",
            "speakerId": 1003,
            "speakerName": "「三十人团」公告",
            "text": "请勿轻信他人，以防被来头不明的人骗取佣金。",
            "nextDialogs": [
              "731940603"
            ]
          },
          "731940603": {
            "id": "731940603",
            "speakerId": 1003,
            "speakerName": "「三十人团」公告",
            "text": "如需雇佣保镖、守卫亦或有其他需求，请联系「三十人团」掌旗官鲁克沙或通过教令院联络员阿芬迪派发委托。"
          }
        }
      }
    },
    {
      "subId": "7319407",
      "subQuestName": "",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "731940701"
        ],
        "dialogs": {
          "731940701": {
            "id": "731940701",
            "speakerId": 1004,
            "speakerName": "健康之家公告",
            "text": "健康之家乃阿弥利多学院下属的医疗服务机构，为须弥内外居民提供免费医疗。",
            "nextDialogs": [
              "731940702"
            ]
          },
          "731940702": {
            "id": "731940702",
            "speakerId": 1004,
            "speakerName": "健康之家公告",
            "text": "该处执业医师皆获得生论派授予的行医许可，诊疗方案提供虚空多次审核，为百姓提供最专业、最安全的服务。",
            "nextDialogs": [
              "731940703"
            ]
          },
          "731940703": {
            "id": "731940703",
            "speakerId": 1004,
            "speakerName": "健康之家公告",
            "text": "请广大居民切勿相信来路不明的医师，以免人财两空。"
          }
        }
      }
    },
    {
      "subId": "7319408",
      "subQuestName": "",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "731940801"
        ],
        "dialogs": {
          "731940801": {
            "id": "731940801",
            "speakerId": 1002,
            "speakerName": "教令官公告",
            "text": "请勿在城里人多的地方携带过多的金钱，以防遭遇偷窃。",
            "nextDialogs": [
              "731940802"
            ]
          },
          "731940802": {
            "id": "731940802",
            "speakerId": 1002,
            "speakerName": "教令官公告",
            "text": "如若发生财物被窃，也请不要向附近巡逻的镀金旅团求助。",
            "nextDialogs": [
              "731940803"
            ]
          },
          "731940803": {
            "id": "731940803",
            "speakerId": 1002,
            "speakerName": "教令官公告",
            "text": "因为很可能正是他们拿走了你的钱财。"
          }
        }
      }
    },
    {
      "subId": "7319409",
      "subQuestName": "",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "731940901"
        ],
        "dialogs": {
          "731940901": {
            "id": "731940901",
            "speakerId": 1005,
            "speakerName": "通缉令",
            "text": "悬赏：卡西姆",
            "nextDialogs": [
              "731940902"
            ]
          },
          "731940902": {
            "id": "731940902",
            "speakerId": 1005,
            "speakerName": "通缉令",
            "text": "此人自称大名鼎鼎、行走诸国的大盗，实则乃是招摇撞骗之徒，在镀金旅团各项实力排行榜上皆榜上无名。",
            "nextDialogs": [
              "731940903"
            ]
          },
          "731940903": {
            "id": "731940903",
            "speakerId": 1005,
            "speakerName": "通缉令",
            "text": "近期已发生多起与其有关的诈骗案件，请大家提高警惕，避免上当受骗。"
          }
        }
      }
    },
    {
      "subId": "7319410",
      "subQuestName": "",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "731941001"
        ],
        "dialogs": {
          "731941001": {
            "id": "731941001",
            "speakerId": 1005,
            "speakerName": "通缉令",
            "text": "悬赏：穆斯塔",
            "nextDialogs": [
              "731941002"
            ]
          },
          "731941002": {
            "id": "731941002",
            "speakerId": 1005,
            "speakerName": "通缉令",
            "text": "此人假扮教令官，游走巴扎港口各处，敲诈勒索，抢劫商队。现已由聚砂厅介入调查。",
            "nextDialogs": [
              "731941003"
            ]
          },
          "731941003": {
            "id": "731941003",
            "speakerId": 1005,
            "speakerName": "通缉令",
            "text": "有消息称此人已藏身密林之中，广大市民如有目击，务必上报。"
          }
        }
      }
    },
    {
      "subId": "7319411",
      "subQuestName": "",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "731941101"
        ],
        "dialogs": {
          "731941101": {
            "id": "731941101",
            "speakerId": 1006,
            "speakerName": "兰巴德酒馆公告",
            "text": "既然教令官以后不用这个地方发公告了，那就正好当作我们兰巴德酒馆的留言板吧，以后有什么事情大家都可以在这留言。",
            "nextDialogs": [
              "731941102"
            ]
          },
          "731941102": {
            "id": "731941102",
            "speakerId": 1001,
            "speakerName": "留言",
            "text": "「老板，我之前订的十箱酒到货了吗，昨天我按约定时间来的结果没拿到。」",
            "nextDialogs": [
              "731941103"
            ]
          },
          "731941103": {
            "id": "731941103",
            "speakerId": 1007,
            "speakerName": "回复",
            "text": "怎会如此！之前有个金发的家伙自称是你的室友，已经把酒全都提走了。我记得你们还一起来过呢，该不会是搞错了吧？",
            "nextDialogs": [
              "731941104"
            ]
          },
          "731941104": {
            "id": "731941104",
            "speakerId": 1001,
            "speakerName": "留言",
            "text": "「…好的，我知道了。」"
          }
        }
      }
    },
    {
      "subId": "7319412",
      "subQuestName": "",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "731941201"
        ],
        "dialogs": {
          "731941201": {
            "id": "731941201",
            "speakerId": 1001,
            "speakerName": "留言",
            "text": "「大家如果要去雨林里面的话千万要小心，上次我被导师派去雨林采集一些草药，结果碰到了长鬓虎，差点就没命了。」",
            "nextDialogs": [
              "731941202"
            ]
          },
          "731941202": {
            "id": "731941202",
            "speakerId": 1001,
            "speakerName": "留言",
            "text": "「多亏附近有巡林员搭救，虽然她自称是见习巡林员，不过看上去经验丰富。最主要的是还给我带了好吃的食物压惊。」",
            "nextDialogs": [
              "731941203"
            ]
          },
          "731941203": {
            "id": "731941203",
            "speakerId": 1001,
            "speakerName": "留言",
            "text": "「听说她还是提纳里前辈的学生，真是名师出高徒啊。」"
          }
        }
      }
    },
    {
      "subId": "7319413",
      "subQuestName": "",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "731941301"
        ],
        "dialogs": {
          "731941301": {
            "id": "731941301",
            "speakerId": 1002,
            "speakerName": "教令官公告",
            "text": "远方的旅人，欢迎来到须弥。为体现树王大人普世的慈爱，「虚空终端」现已向所有旅客开放使用。",
            "nextDialogs": [
              "731941302"
            ]
          },
          "731941302": {
            "id": "731941302",
            "speakerId": 1002,
            "speakerName": "教令官公告",
            "text": "初次进城的旅客可在教令官帕纳处领取。"
          }
        }
      }
    },
    {
      "subId": "7319414",
      "subQuestName": "",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "731941401"
        ],
        "dialogs": {
          "731941401": {
            "id": "731941401",
            "speakerId": 1002,
            "speakerName": "教令官公告",
            "text": "远方的旅人，欢迎来到须弥。为体现草神大人普世的慈爱，「虚空终端」现已向所有旅客开放使用。",
            "nextDialogs": [
              "731941402"
            ]
          },
          "731941402": {
            "id": "731941402",
            "speakerId": 1002,
            "speakerName": "教令官公告",
            "text": "初次进城的旅客可在教令官帕纳处领取。"
          }
        }
      }
    },
    {
      "subId": "7319415",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "731941501"
        ],
        "dialogs": {
          "731941501": {
            "id": "731941501",
            "speakerId": 1002,
            "speakerName": "教令官公告",
            "text": "远方的旅人，欢迎来到须弥。由于「虚空系统」已停止使用，「虚空终端」也将不再发放。",
            "nextDialogs": [
              "731941502"
            ]
          },
          "731941502": {
            "id": "731941502",
            "speakerId": 1002,
            "speakerName": "教令官公告",
            "text": "若您仍持有未被回收的「虚空终端」，请在离开须弥前返还至教令官帕纳处。"
          }
        }
      }
    },
    {
      "subId": "7319416",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "731941601"
        ],
        "dialogs": {
          "731941601": {
            "id": "731941601",
            "speakerId": 1002,
            "speakerName": "教令官公告",
            "text": "由于「虚空系统」现已关闭，为方便本城居民及来往旅客，此公告牌已重新启用。",
            "nextDialogs": [
              "731941602"
            ]
          },
          "731941602": {
            "id": "731941602",
            "speakerId": 1002,
            "speakerName": "教令官公告",
            "text": "须弥近期内外大事将定期在此公告，如有缺漏请与教令院相关负责人联系。"
          }
        }
      }
    }
  ]
}
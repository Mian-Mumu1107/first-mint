            ]
          },
          "706720203": {
            "id": "706720203",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "#{NICKNAME}，快看，这里有好大一只大团雀！",
            "nextDialogs": [
              "706720204"
            ]
          },
          "706720204": {
            "id": "706720204",
            "speakerId": 13276,
            "speakerName": "阿圆",
            "text": "我可不是团雀，我的名字是…",

      }
    },
    {
      "subId": "7351401",
      "subQuestName": "与两位学者对话",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "735140101"
        ],
        "dialogs": {
          "735140101": {
            "id": "735140101",
            "speakerId": 30343,
            "speakerName": "施芮娅",
            "text": "好险…居然连沙虫也来搅局了…",
            "nextDialogs": [
              "735140102"
            ]
          },
          "735140102": {
            "id": "735140102",
            "speakerId": 30342,
            "speakerName": "维纳亚克",
            "text": "唉！要是刚才没有拆除点火装置，我们就可以直接干掉它了！",
            "nextDialogs": [
              "735140103"
            ]
          },
          "735140103": {
            "id": "735140103",
            "speakerId": 30342,
            "speakerName": "维纳亚克",
            "text": "现在放跑了它，少说也得再等上一天，才能让它重新放松警惕。",
            "nextDialogs": [
              "735140104"
            ]
          },
          "735140104": {
            "id": "735140104",
            "speakerId": 30342,
            "speakerName": "维纳亚克",
            "text": "你不会想说，等到明天，我们还要为一点细枝末节而纠结，然后再放跑它一次吧？",
            "nextDialogs": [
              "735140105"
            ]
          },
          "735140105": {
            "id": "735140105",
            "speakerId": 30343,
            "speakerName": "施芮娅",
            "text": "唔…可是，参数问题…",
            "nextDialogs": [
              "735140106"
            ]
          },
          "735140106": {
            "id": "735140106",
            "speakerId": 30342,
            "speakerName": "维纳亚克",
            "text": "我都已经测过了，虽然充能速度比设计值是低了一点，但还不影响使用，也没有什么安全隐患。",
            "nextDialogs": [
              "735140107"
            ]
          },
          "735140107": {
            "id": "735140107",
            "speakerId": 30342,
            "speakerName": "维纳亚克",
            "text": "施芮娅…我明白，你是希望把一切分析完毕才开始动手，可是你也知道，实际情况又不可能总是跟着计划走。",
            "nextDialogs": [
              "735140108"
            ]
          },
          "735140108": {
            "id": "735140108",
            "speakerId": 30342,
            "speakerName": "维纳亚克",
            "text": "为求万无一失，反而错过了时机的话，就会就跟那次中期答辩一样悲惨延期…回头也只会闹出更多麻烦来。",
            "nextDialogs": [
              "735140109"
            ]
          },
          "735140109": {
            "id": "735140109",
            "speakerId": 30343,
            "speakerName": "施芮娅",
            "text": "唉…行吧。拿去吧，点火模块。",
            "nextDialogs": [
              "735140110"
            ]
          },
          "735140110": {
            "id": "735140110",
            "speakerId": 30342,
            "speakerName": "维纳亚克",
            "text": "——好欸！明天总算能让「对沙虫用杀虫炮」威风一把了！",
            "nextDialogs": [
              "735140111"
            ]
          },
          "735140111": {
            "id": "735140111",
            "speakerId": 30342,
            "speakerName": "维纳亚克",
            "text": "我先把它们拉回阿如村再调试调试，「对沙虫用杀虫炮」的第一次正式登台…可得好好准备呀。",
            "nextDialogs": [
              "735140112"
            ]
          },
          "735140112": {
            "id": "735140112",
            "speakerId": 30343,
            "speakerName": "施芮娅",
            "text": "…可是环境参数，究竟为什么会出现偏差呢？说到底，沙虫又为什么会突然作乱？",
            "nextDialogs": [
              "735140113"
            ]
          },
          "735140113": {
            "id": "735140113",
            "speakerId": 30343,
            "speakerName": "施芮娅",
            "text": "#果然不能放着这些问题不管…冒险家{M#先生}{F#小姐}，烦请您明天再来一趟吧。",
            "nextDialogs": [
              "735140114"
            ]
          },
          "735140114": {
            "id": "735140114",
            "speakerId": 30343,
            "speakerName": "施芮娅",
            "text": "到时候我们应该会直接面对沙虫，希望能多少研究出一点端倪。"
          }
        }
      }
    }
  ]
}
  },
  "subQuests": [
    {
      "subId": "7165501",
      "subQuestName": "与阿圆对话",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "716550101"
        ],
        "dialogs": {
          "716550101": {
            "id": "716550101",
            "speakerId": 1000,
            "speakerName": "阿圆",
            "text": "啊呀，你来得很快啊，不错，不错。",
            "nextDialogs": [
              "716550105",
              "716550104"
            ]
          },
          "716550105": {
            "id": "716550105",
            "speakerId": 1000,
            "speakerName": "阿圆",
            "text": "这次找你过来，是要给你个小玩意。",
            "nextDialogs": [
              "716550106"
            ]
          },
          "716550106": {
            "id": "716550106",
            "speakerId": 1000,
            "speakerName": "阿圆",
            "text": "我之前不知道有没有和你说过…「洞天」是仙人为自己化出的一处私人洞府。",
            "nextDialogs": [
              "716550107"
            ]
          },
          "716550107": {
            "id": "716550107",
            "speakerId": 1000,
            "speakerName": "阿圆",
            "text": "为了保证洞府清净，大部分仙人都会使些手段封闭洞天，免得有闲人烦扰。",
            "nextDialogs": [
              "716550108"
            ]
          },
          "716550108": {
            "id": "716550108",
            "speakerId": 1000,
            "speakerName": "阿圆",
            "text": "然后，当仙人们想要邀请某人来自家洞天做客时，则会化出一道「洞天关牒」。",
            "nextDialogs": [
              "716550109"
            ]
          },
          "716550109": {
            "id": "716550109",
            "speakerId": 1000,
            "speakerName": "阿圆",
            "text": "这道「洞天关牒」上附有洞天仙力和仙人自己的一股气息。持有此关牒者，可以在对应洞天里出入无碍。",
            "nextDialogs": [
              "716550110"
            ]
          },
          "716550110": {
            "id": "716550110",
            "speakerId": 1000,
            "speakerName": "阿圆",
            "text": "先前此方洞天初成，尚不完善，即使你邀请客人来访，大多也只能与你共同进出，不能常驻于此。",
            "nextDialogs": [
              "716550111"
            ]
          },
          "716550111": {
            "id": "716550111",
            "speakerId": 1000,
            "speakerName": "阿圆",
            "text": "现在嘛…你拿好这道我帮你化出的「洞天关牒」，握在手里，要握紧喔。"
          },
          "716550104": {
            "id": "716550104",
            "speakerId": 1000,
            "speakerName": "阿圆",
            "text": "唔？当然不是，你为什么第一反应是这个…"
          }
        }
      }
    }
  ]
}
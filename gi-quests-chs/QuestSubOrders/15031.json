  },
  "subQuests": [
    {
      "subId": "1503101",
      "subQuestName": "返回并告知部族众人",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "150310101"
        ],
        "dialogs": {
          "150310101": {
            "id": "150310101",
            "speakerId": 1000,
            "speakerName": "Black Screen",
            "text": "首领阿卡特将「沃陆之邦」的众人召集到了一起，瓦雷莎简要地说明了蘑菇的调查进展。",
            "nextDialogs": [
              "150310102"
            ]
          },
          "150310102": {
            "id": "150310102",
            "speakerId": 6305,
            "speakerName": "阿卡特",
            "text": "……",
            "nextDialogs": [
              "150310103"
            ]
          },
          "150310103": {
            "id": "150310103",
            "speakerId": 6393,
            "speakerName": "阿托力",
            "text": "……",
            "nextDialogs": [
              "150310104"
            ]
          },
          "150310104": {
            "id": "150310104",
            "speakerId": 1091,
            "speakerName": "伊安珊",
            "text": "……",
            "nextDialogs": [
              "150310105"
            ]
          },
          "150310105": {
            "id": "150310105",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "我们在调查的时候感觉还好，现在从旁听者的角度听了一遍，感觉确实有点荒唐。",
            "nextDialogs": [
              "150310106"
            ]
          },
          "150310106": {
            "id": "150310106",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "这种难以言述的沉默…",
            "nextDialogs": [
              "150310107"
            ]
          },
          "150310107": {
            "id": "150310107",
            "speakerId": 6305,
            "speakerName": "阿卡特",
            "text": "原来如此，果园里的蘑菇居然有自己的意识，这可是个不得了的发现啊！",
            "nextDialogs": [
              "150310108"
            ]
          },
          "150310108": {
            "id": "150310108",
            "speakerId": 1091,
            "speakerName": "伊安珊",
            "text": "是啊，要是没有你们调查，说不定会酝酿出很可怕的危机。",
            "nextDialogs": [
              "150310109"
            ]
          },
          "150310109": {
            "id": "150310109",
            "speakerId": 6394,
            "speakerName": "豪特利",
            "text": "幸亏你们察觉到了，还收集了这么多线索！",
            "nextDialogs": [
              "150310110"
            ]
          },
          "150310110": {
            "id": "150310110",
            "speakerId": 1098,
            "speakerName": "瓦雷莎",
            "text": "太好了，你们没觉得我讲的故事很奇怪…",
            "nextDialogs": [
              "150310111"
            ]
          },
          "150310111": {
            "id": "150310111",
            "speakerId": 6305,
            "speakerName": "阿卡特",
            "text": "哈哈哈，奇怪是奇怪，毕竟和蘑菇说话这种事，我们谁都没经历过啊。",
            "nextDialogs": [
              "150310112"
            ]
          },
          "150310112": {
            "id": "150310112",
            "speakerId": 6305,
            "speakerName": "阿卡特",
            "text": "但是瓦雷莎你从来都不是会骗人的孩子，这我们也都知道，再加上绿蘑菇对我们来说本来就是个谜题。",
            "nextDialogs": [
              "150310113"
            ]
          },
          "150310113": {
            "id": "150310113",
            "speakerId": 6305,
            "speakerName": "阿卡特",
            "text": "现在既然发现了不好的苗头，我们大家当然都很愿意支持你们的调查！",
            "nextDialogs": [
              "150310114"
            ]
          },
          "150310114": {
            "id": "150310114",
            "speakerId": 1091,
            "speakerName": "伊安珊",
            "text": "有什么需要帮忙的，尽管说就好了。",
            "nextDialogs": [
              "150310115"
            ]
          },
          "150310115": {
            "id": "150310115",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "你们接受得好快！",
            "nextDialogs": [
              "150310116"
            ]
          },
          "150310116": {
            "id": "150310116",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "太谢谢你们了。",
            "nextDialogs": [
              "150310117"
            ]
          },
          "150310117": {
            "id": "150310117",
            "speakerId": 6393,
            "speakerName": "阿托力",
            "text": "刚刚说，需要用高温烹饪这种蘑菇对吧，稍等，我现在就去准备。",
            "nextDialogs": [
              "150310118"
            ]
          },
          "150310118": {
            "id": "150310118",
            "speakerId": 6393,
            "speakerName": "阿托力",
            "text": "来了来了，我直接用铁盘煎了一下，这个温度应该够高！",
            "nextDialogs": [
              "150310119"
            ]
          },
          "150310119": {
            "id": "150310119",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "哇，果然是很香的味道呢，我的食欲全都回来了。",
            "nextDialogs": [
              "150310120"
            ]
          },
          "150310120": {
            "id": "150310120",
            "speakerId": 1098,
            "speakerName": "瓦雷莎",
            "text": "那、那我们就不客气了。",
            "nextDialogs": [
              "150310121"
            ]
          },
          "150310121": {
            "id": "150310121",
            "speakerId": 1007,
            "speakerName": "「蕈之贤主」",
            "text": "嗯…",
            "nextDialogs": [
              "150310122"
            ]
          },
          "150310122": {
            "id": "150310122",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "听到了吗，是它的声音！",
            "nextDialogs": [
              "150310123"
            ]
          },
          "150310123": {
            "id": "150310123",
            "speakerId": 1007,
            "speakerName": "「蕈之贤主」",
            "text": "哈哈哈哈，看来你们是摸到了一点窍门，可是这种温度完全——展现不出丝毫的诚意。",
            "nextDialogs": [
              "150310124"
            ]
          },
          "150310124": {
            "id": "150310124",
            "speakerId": 1007,
            "speakerName": "「蕈之贤主」",
            "text": "你们以为用家常的火，家常的工具，随便做一做，就能得到「蕈之贤主」的赏识？",
            "nextDialogs": [
              "150310125"
            ]
          },
          "150310125": {
            "id": "150310125",
            "speakerId": 1007,
            "speakerName": "「蕈之贤主」",
            "text": "人类真是让我失望，有提示的时候，还能用智慧解决我留下的难题…",
            "nextDialogs": [
              "150310126"
            ]
          },
          "150310126": {
            "id": "150310126",
            "speakerId": 1007,
            "speakerName": "「蕈之贤主」",
            "text": "结果没有提示，马上就原形毕露，采用的办法真是愚不可及。",
            "nextDialogs": [
              "150310127"
            ]
          },
          "150310127": {
            "id": "150310127",
            "speakerId": 1007,
            "speakerName": "「蕈之贤主」",
            "text": "再去想想办法吧，嘻嘻嘻嘻——",
            "nextDialogs": [
              "150310128"
            ]
          },
          "150310128": {
            "id": "150310128",
            "speakerId": 6393,
            "speakerName": "阿托力",
            "text": "怎、怎么样，听到它的声音了吗？",
            "nextDialogs": [
              "150310129"
            ]
          },
          "150310129": {
            "id": "150310129",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "可恶，这家伙果然很讨厌！",
            "nextDialogs": [
              "150310130"
            ]
          },
          "150310130": {
            "id": "150310130",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "它说温度还不够高，达不到它的要求，太难伺候了吧！",
            "nextDialogs": [
              "150310133"
            ]
          },
          "150310133": {
            "id": "150310133",
            "speakerId": 6305,
            "speakerName": "阿卡特",
            "text": "温度不够高，那看来得用更厉害的手段才行。",
            "nextDialogs": [
              "150310134"
            ]
          },
          "150310134": {
            "id": "150310134",
            "speakerId": 6305,
            "speakerName": "阿卡特",
            "text": "听到了吗，各位，麻烦大家去收集一些高温的东西，什么都行！",
            "nextDialogs": [
              "150310135"
            ]
          },
          "150310135": {
            "id": "150310135",
            "speakerId": 6393,
            "speakerName": "阿托力",
            "text": "我去想想办法！",
            "nextDialogs": [
              "150310136"
            ]
          },
          "150310136": {
            "id": "150310136",
            "speakerId": 1091,
            "speakerName": "伊安珊",
            "text": "交给我吧！",
            "nextDialogs": [
              "150310137"
            ]
          },
          "150310137": {
            "id": "150310137",
            "speakerId": 1098,
            "speakerName": "瓦雷莎",
            "text": "那我们也去找找？",
            "nextDialogs": [
              "150310138"
            ]
          },
          "150310138": {
            "id": "150310138",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "好啊，但这附近我们还不是很熟，你有什么想法吗？",
            "nextDialogs": [
              "150310139"
            ]
          },
          "150310139": {
            "id": "150310139",
            "speakerId": 1098,
            "speakerName": "瓦雷莎",
            "text": "嗯…目前还没有眉目，但我们可以去火山附近看看…",
            "nextDialogs": [
              "150310140"
            ]
          },
          "150310140": {
            "id": "150310140",
            "speakerId": 1098,
            "speakerName": "瓦雷莎",
            "text": "火山总是吐各种各样的东西出来，说不定就会有很好的素材。",
            "nextDialogs": [
              "150310141"
            ]
          },
          "150310141": {
            "id": "150310141",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "没问题，走吧！要是有机会的话，我要把找到的烫烫素材，甩到这个坏蘑菇的脸上！"
          }
        }
      }
    },
    {
      "subId": "1503102",
      "subQuestName": "寻找所需的高温材料",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "150310201"
        ],
        "dialogs": {
          "150310201": {
            "id": "150310201",
            "speakerId": 1098,
            "speakerName": "瓦雷莎",
            "text": "这条路我平时经常走，我记得路边会有正在休息的熔岩游像。",
            "nextDialogs": [
              "150310202"
            ]
          },
          "150310202": {
            "id": "150310202",
            "speakerId": 1098,
            "speakerName": "瓦雷莎",
            "text": "它们的核心很烫，应该能满足我们的要求。",
            "nextDialogs": [
              "150310203"
            ]
          },
          "150310203": {
            "id": "150310203",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "没想到大家会这么配合我们，看来他们其实都对这个蘑菇有所怀疑啊。",
            "nextDialogs": [
              "150310204"
            ]
          },
          "150310204": {
            "id": "150310204",
            "speakerId": 1098,
            "speakerName": "瓦雷莎",
            "text": "嗯，还是多亏了你们来到这里，之前有很多很多人都吃过这种蘑菇，但能和蘑菇说上话，真的还是第一次…",
            "nextDialogs": [
              "150310205"
            ]
          },
          "150310205": {
            "id": "150310205",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "也是，就算想查，也不知道从哪里开始查吧…",
            "nextDialogs": [
              "150310206"
            ]
          },
          "150310206": {
            "id": "150310206",
            "speakerId": 1098,
            "speakerName": "瓦雷莎",
            "text": "所以这次还算是个难得的好机会，再加上那个「蕈之贤主」总是出言不逊，也点燃了大家的胜负欲。",
            "nextDialogs": [
              "150310207"
            ]
          },
          "150310207": {
            "id": "150310207",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "「沃陆之邦」的人好像都热爱竞争。",
            "nextDialogs": [
              "150310208"
            ]
          },
          "150310208": {
            "id": "150310208",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "是哦，不过瓦雷莎看上去是个特别温和的人，可能只有运动和战斗的时候除外…",
            "nextDialogs": [
              "150310209"
            ]
          },
          "150310209": {
            "id": "150310209",
            "speakerId": 1098,
            "speakerName": "瓦雷莎",
            "text": "这个…是的，我并不喜欢战斗，也不争强好胜，我觉得只要能过好每一天的日子就行了。",
            "nextDialogs": [
              "150310210"
            ]
          },
          "150310210": {
            "id": "150310210",
            "speakerId": 1098,
            "speakerName": "瓦雷莎",
            "text": "可是伊安珊老师教了我很多，比如「力量」是手段而不是目的…",
            "nextDialogs": [
              "150310211"
            ]
          },
          "150310211": {
            "id": "150310211",
            "speakerId": 1098,
            "speakerName": "瓦雷莎",
            "text": "在深渊攻进来的时候，要是我没有进行平时的训练，也不擅长掌控元素力量，就只能眼睁睁地看着魔物肆虐。",
            "nextDialogs": [
              "150310212"
            ]
          },
          "150310212": {
            "id": "150310212",
            "speakerId": 1098,
            "speakerName": "瓦雷莎",
            "text": "就算再怎么害怕，我都必须鼓起勇气，不能让这种事发生。",
            "nextDialogs": [
              "150310215"
            ]
          },
          "150310215": {
            "id": "150310215",
            "speakerId": 1098,
            "speakerName": "瓦雷莎",
            "text": "谢谢，我会慢慢变得勇敢，就像菲耶蒂娜一样勇敢。",
            "nextDialogs": [
              "150310216"
            ]
          },
          "150310216": {
            "id": "150310216",
            "speakerId": 1098,
            "speakerName": "瓦雷莎",
            "text": "走吧，我们边走边找。"
          }
        }
      }
    },
    {
      "subId": "1503103",
      "subQuestName": "越过障碍，向上攀登",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "150310301"
        ],
        "dialogs": {
          "150310301": {
            "id": "150310301",
            "speakerId": 1098,
            "speakerName": "瓦雷莎",
            "text": "顺利解决！这个好像很不错，你们看，里面的燃素还很活跃呢。",
            "nextDialogs": [
              "150310302"
            ]
          },
          "150310302": {
            "id": "150310302",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "我摸摸看…哇，好烫！",
            "nextDialogs": [
              "150310303"
            ]
          },
          "150310303": {
            "id": "150310303",
            "speakerId": 1098,
            "speakerName": "瓦雷莎",
            "text": "像这样的再多找上几块应该就够了，走，我们再往上看看。"
          }
        }
      }
    },
    {
      "subId": "1503105",
      "subQuestName": "消灭「熔岩游像」",

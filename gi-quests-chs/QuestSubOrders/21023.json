  "subQuests": [
    {
      "subId": "2102301",
      "subQuestName": "与甄强对话$HIDDEN",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "210230101"
        ],
        "dialogs": {
          "210230101": {
            "id": "210230101",
            "speakerId": 1000,
            "speakerName": "甄强",
            "text": "这样就差不多了，真是费劲…",
            "nextDialogs": [
              "210230102"
            ]
          },
          "210230102": {
            "id": "210230102",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "旁边的楼梯…",
            "nextDialogs": [
              "210230103"
            ]
          },
          "210230103": {
            "id": "210230103",
            "speakerId": 1000,
            "speakerName": "甄强",
            "text": "楼梯？哦，你是要去客栈上面去吗？",
            "nextDialogs": [
              "210230104"
            ]
          },
          "210230104": {
            "id": "210230104",
            "speakerId": 1000,
            "speakerName": "甄强",
            "text": "你来得不巧，上去的楼梯断了两个口子。为了防止有人失足，所以老板干脆把楼梯给封住了。",
            "nextDialogs": [
              "210230105"
            ]
          },
          "210230105": {
            "id": "210230105",
            "speakerId": 1000,
            "speakerName": "甄强",
            "text": "虽然修理的事已经在筹备了，但一时半会也走不了人。",
            "nextDialogs": [
              "210230106"
            ]
          },
          "210230106": {
            "id": "210230106",
            "speakerId": 1000,
            "speakerName": "甄强",
            "text": "你也别着急，虽然楼梯不能走人了，但这架升降机没问题。",
            "nextDialogs": [
              "210230107"
            ]
          },
          "210230107": {
            "id": "210230107",
            "speakerId": 1000,
            "speakerName": "甄强",
            "text": "能运货，运个人自然也不成问题，如果你急着上去，不如就用升降机上去吧。",
            "nextDialogs": [
              "210230108"
            ]
          },
          "210230108": {
            "id": "210230108",
            "speakerId": 1000,
            "speakerName": "甄强",
            "text": "然后，顺便帮我把这个东西给老板，是一个客商送给他的礼物。",
            "nextDialogs": [
              "210230110",
              "210230112"
            ]
          },
          "210230110": {
            "id": "210230110",
            "speakerId": 1000,
            "speakerName": "甄强",
            "text": "行，那就你上去吧，记得站稳了啊，这客栈挺高的，升到一半摔下来可不是开玩笑的。"
          },
          "210230112": {
            "id": "210230112",
            "speakerId": 1000,
            "speakerName": "甄强",
            "text": "我还得在下面接货呢，还有很多货要接，可不敢耽误。",
            "nextDialogs": [
              "210230113"
            ]
          },
          "210230113": {
            "id": "210230113",
            "speakerId": 1000,
            "speakerName": "甄强",
            "text": "好了，你快点上去吧，记得站稳了啊，这客栈挺高的，升到一半摔下来可不是开玩笑的。"
          }
        }
      }
    },
    {
      "subId": "2102302",
      "subQuestName": "乘坐升降机",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "210230201"
        ],
        "dialogs": {
          "210230201": {
            "id": "210230201",
            "speakerId": 1001,
            "speakerName": "淮安",
            "text": "楼梯还是得赶紧修了啊…",
            "nextDialogs": [
              "210230202"
            ]
          },
          "210230202": {
            "id": "210230202",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "你是掌柜的吗？",
            "nextDialogs": [
              "210230203"
            ]
          },
          "210230203": {
            "id": "210230203",
            "speakerId": 1001,
            "speakerName": "淮安",
            "text": "我是，您有什么事吗？",
            "nextDialogs": [
              "210230204"
            ]
          },
          "210230204": {
            "id": "210230204",
            "speakerId": 1002,
            "speakerName": "派蒙",
            "text": "有一份给你的包裹，是楼下的一个人要我们送给你的。",
            "nextDialogs": [
              "210230205"
            ]
          },
          "210230205": {
            "id": "210230205",
            "speakerId": 1001,
            "speakerName": "淮安",
            "text": "哦…这应该是客商给我的包裹…甄强怎么自己不来送？",
            "nextDialogs": [
              "210230206"
            ]
          },
          "210230206": {
            "id": "210230206",
            "speakerId": 1001,
            "speakerName": "淮安",
            "text": "他还有货要接？嗨，他准是嫌上上下下麻烦，懒得上来又下去…",
            "nextDialogs": [
              "210230207"
            ]
          },
          "210230207": {
            "id": "210230207",
            "speakerId": 1001,
            "speakerName": "淮安",
            "text": "您是客人吧，实在对不住，这楼梯坏得太不是时候了，我正寻思着怎么修呢。",
            "nextDialogs": [
              "210230208"
            ]
          },
          "210230208": {
            "id": "210230208",
            "speakerId": 1001,
            "speakerName": "淮安",
            "text": "真是麻烦了，还让您来送这个包裹给我，这样，这份报酬给您，您收好。",
            "nextDialogs": [
              "210230209"
            ]
          },
          "210230209": {
            "id": "210230209",
            "speakerId": 1001,
            "speakerName": "淮安",
            "text": "这本来是给甄强准备的，但既然他让您来送了这个包裹，那这份报酬当然该您收下。",
            "nextDialogs": [
              "210230210"
            ]
          },
          "210230210": {
            "id": "210230210",
            "speakerId": 1001,
            "speakerName": "淮安",
            "text": "好了，我接着去筹备修楼梯的事了，您随意在客栈里逛逛，有什么事您随时找我。"
          }
        }
      }
    },

    {
      "subId": "7102201",
      "subQuestName": "完成对话（隐藏）$HIDDEN",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "710220101"
        ],
        "dialogs": {
          "710220101": {
            "id": "710220101",
            "speakerId": 20217,
            "speakerName": "治平",
            "text": "这次是发生在天遒谷吗…",
            "nextDialogs": [
              "710220102"
            ]
          },
          "710220102": {
            "id": "710220102",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "怎么了？",
            "nextDialogs": [
              "710220103"
            ]
          },
          "710220103": {
            "id": "710220103",
            "speakerId": 20217,
            "speakerName": "治平",
            "text": "#是{NICKNAME}啊，幸会，没想到今天能在这见到你。",
            "nextDialogs": [
              "710220104"
            ]
          },
          "710220104": {
            "id": "710220104",
            "speakerId": 20217,
            "speakerName": "治平",
            "text": "唔…说起来，你最近去过天遒谷、南天门一带吗？",
            "nextDialogs": [
              "710220107"
            ]
          },
          "710220107": {
            "id": "710220107",
            "speakerId": 20217,
            "speakerName": "治平",
            "text": "最近协会里不断接到南天门到天遒谷那一带的地震报告。",
            "nextDialogs": [
              "710220108"
            ]
          },
          "710220108": {
            "id": "710220108",
            "speakerId": 20217,
            "speakerName": "治平",
            "text": "最开始只是轻微的晃动，但最近似乎越来越严重了。",
            "nextDialogs": [
              "710220109"
            ]
          },
          "710220109": {
            "id": "710220109",
            "speakerId": 20217,
            "speakerName": "治平",
            "text": "不久之前，协会里又接到报告，在一次格外强烈的地震后，部分的山体与遗迹发生了坍塌，露出了一片巨大的洞窟。",
            "nextDialogs": [
              "710220110"
            ]
          },
          "710220110": {
            "id": "710220110",
            "speakerId": 20217,
            "speakerName": "治平",
            "text": "报告中还描述说，在那边见到了某种未知的魔物。根据描述，可能是过去曾经作乱的「岩龙蜥」和「古岩龙蜥」…",
            "nextDialogs": [
              "710220111"
            ]
          },
          "710220111": {
            "id": "710220111",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "需要我做什么吗？",
            "nextDialogs": [
              "710220112"
            ]
          },
          "710220112": {
            "id": "710220112",
            "speakerId": 20217,
            "speakerName": "治平",
            "text": "唔，我想拜托你去天遒谷的那个大空洞去搜索一下，看看地震对周围环境造成的影响。",
            "nextDialogs": [
              "710220113"
            ]
          },
          "710220113": {
            "id": "710220113",
            "speakerId": 20217,
            "speakerName": "治平",
            "text": "还有那些魔物的情况，如果真的大规模出现了，肯定也不能放着不管，必须快点制订对策。",
            "nextDialogs": [
              "710220114"
            ]
          },
          "710220114": {
            "id": "710220114",
            "speakerId": 20217,
            "speakerName": "治平",
            "text": "当然，这也算是协会的正式工作。完成以后也会有对应的酬劳，怎么样，你意下如何？",
            "nextDialogs": [
              "710220115"
            ]
          },
          "710220115": {
            "id": "710220115",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "交给我吧。",
            "nextDialogs": [
              "710220116"
            ]
          },
          "710220116": {
            "id": "710220116",
            "speakerId": 20217,
            "speakerName": "治平",
            "text": "那就拜托你了，去那里搜索的时候，请千万注意安全。"
          }
        }
      }
    },

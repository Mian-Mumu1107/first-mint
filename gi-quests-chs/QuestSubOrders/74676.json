{
  "lineCounts": {
    "Player": 8,
    "左右加": 31,
    "派蒙": 16
  },
  "subQuests": [
    {
      "subId": "7467601",
      "subQuestName": "前往蒙德城的花园",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "746760101"
        ],
        "dialogs": {
          "746760101": {
            "id": "746760101",
            "speakerId": 1000,
            "speakerName": "左右加",
            "text": "嗯哼哼，我有一种预感…",
            "nextDialogs": [
              "746760102"
            ]
          },
          "746760102": {
            "id": "746760102",
            "speakerId": 1000,
            "speakerName": "左右加",
            "text": "我历经千辛万苦，来到了两位传奇人物的故事开始的地方，看在我这么努力的份上…",
            "nextDialogs": [
              "746760103"
            ]
          },
          "746760103": {
            "id": "746760103",
            "speakerId": 1000,
            "speakerName": "左右加",
            "text": "#命运也一定会眷顾我！用不了多久，{M#他们}{F#她们}一定会和我再次相遇！",
            "nextDialogs": [
              "746760104"
            ]
          },
          "746760104": {
            "id": "746760104",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "这个人在嘀咕什么呢？看她的衣服，好像不是蒙德本地人…难道是从稻妻来的？",
            "nextDialogs": [
              "746760105"
            ]
          },
          "746760105": {
            "id": "746760105",
            "speakerId": 1000,
            "speakerName": "左右加",
            "text": "果不其然，你们这么快就出现了。来一个重逢的欢呼吧，「智巧勇武双连星」！",
            "nextDialogs": [
              "746760107",
              "746760109"
            ]
          },
          "746760107": {
            "id": "746760107",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "居然是左右加小姐？没想到能在蒙德遇见你，真的是个超大的惊喜！",
            "nextDialogs": [
              "746760111"
            ]
          },
          "746760111": {
            "id": "746760111",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "不过，左右加之前不是一直陪着海妮耶，在筹办之后的赛事吗？怎么一个人跑到蒙德来了？",
            "nextDialogs": [
              "746760112"
            ]
          },
          "746760112": {
            "id": "746760112",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "面前还摆着好多好多书，看起来…好像要给路过的人推荐小说？",
            "nextDialogs": [
              "746760113"
            ]
          },
          "746760113": {
            "id": "746760113",
            "speakerId": 1000,
            "speakerName": "左右加",
            "text": "啊呀，这主要是因为——",
            "nextDialogs": [
              "746760114"
            ]
          },
          "746760114": {
            "id": "746760114",
            "speakerId": 1000,
            "speakerName": "左右加",
            "text": "八重堂的编辑们在追杀我。",
            "nextDialogs": [
              "746760115"
            ]
          },
          "746760115": {
            "id": "746760115",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "追杀？！",
            "nextDialogs": [
              "746760116"
            ]
          },
          "746760116": {
            "id": "746760116",
            "speakerId": 1000,
            "speakerName": "左右加",
            "text": "放心放心，不是真的要干掉我，只是在用一切手段要求我交出稿子而已，编辑们也是为了我着想啦！",
            "nextDialogs": [
              "746760117"
            ]
          },
          "746760117": {
            "id": "746760117",
            "speakerId": 1000,
            "speakerName": "左右加",
            "text": "作为曾经热门的轻小说作者，我需要不断产出作品，满足读者的需求，维持我本人的热度。",
            "nextDialogs": [
              "746760118"
            ]
          },
          "746760118": {
            "id": "746760118",
            "speakerId": 1000,
            "speakerName": "左右加",
            "text": "读者读书的速度是无限快的，如果我写得不够拼命，用不了多久就会被海量新作淹没…",
            "nextDialogs": [
              "746760119"
            ]
          },
          "746760119": {
            "id": "746760119",
            "speakerId": 1000,
            "speakerName": "左右加",
            "text": "但我又不愿意把蕈兽伙伴们的故事草草写完，毕竟一部好的小说需要时间来构思，慢慢打磨。",
            "nextDialogs": [
              "746760120"
            ]
          },
          "746760120": {
            "id": "746760120",
            "speakerId": 1000,
            "speakerName": "左右加",
            "text": "可以的话，我希望能把蕈兽伙伴们的故事整本写完，反复修改后再公开，而不是匆忙连载，赶着每一期的死线去发表。",
            "nextDialogs": [
              "746760121"
            ]
          },
          "746760121": {
            "id": "746760121",
            "speakerId": 1000,
            "speakerName": "左右加",
            "text": "所以我只能新开一部本阶段的主力作品，写个相对简单好把控的故事，让读者们暂且不要忘了我。"
          },
          "746760109": {
            "id": "746760109",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "等等，你好像有点眼熟…难道是左右加小姐？",
            "nextDialogs": [
              "746760110"
            ]
          },
          "746760110": {
            "id": "746760110",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "#{NICKNAME}，你可能有点不记得了，左右加小姐是我们在蕈兽大赛认识的作家，一直在帮海妮耶和我们照料蕈兽伙伴…"
          }
        }
      }
    }
  ]
}
  },
  "subQuests": [
    {
      "subId": "7211901",
      "subQuestName": "",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "721190101"
        ],
        "dialogs": {
          "721190101": {
            "id": "721190101",
            "speakerId": 1000,
            "speakerName": "泽维尔",
            "text": "呃！旅行者，我觉得…事情好像不太妙。",
            "nextDialogs": [
              "721190102"
            ]
          },
          "721190102": {
            "id": "721190102",
            "speakerId": 1000,
            "speakerName": "泽维尔",
            "text": "里面的愚人众们突然把人都聚集到了核心附近，好像是有什么发现。",
            "nextDialogs": [
              "721190103"
            ]
          },
          "721190103": {
            "id": "721190103",
            "speakerId": 1000,
            "speakerName": "泽维尔",
            "text": "他们不会真的能攻破核心的防御吧…不行，我们不能再拖下去了，必须马上开始进行功能性测试。",
            "nextDialogs": [
              "721190104"
            ]
          },
          "721190104": {
            "id": "721190104",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "功能性测试？",
            "nextDialogs": [
              "721190105"
            ]
          },
          "721190105": {
            "id": "721190105",
            "speakerId": 1000,
            "speakerName": "泽维尔",
            "text": "就是测试一下这位新伙计的净化能力，我可不想把它运进去之后再发现它没法干活。",
            "nextDialogs": [
              "721190106"
            ]
          },
          "721190106": {
            "id": "721190106",
            "speakerId": 1000,
            "speakerName": "泽维尔",
            "text": "所以，我想请您帮我去找三只「鬼兜虫」来。",
            "nextDialogs": [
              "721190107"
            ]
          },
          "721190107": {
            "id": "721190107",
            "speakerId": 1000,
            "speakerName": "泽维尔",
            "text": "我想要将这些小家伙们放入现在的「御影炉心」周围，让它们沾染上「祟神」。",
            "nextDialogs": [
              "721190108"
            ]
          },
          "721190108": {
            "id": "721190108",
            "speakerId": 1000,
            "speakerName": "泽维尔",
            "text": "然后再将它们拿出来，用净化装置尝试净化它们所沾染的「祟神」。",
            "nextDialogs": [
              "721190109"
            ]
          },
          "721190109": {
            "id": "721190109",
            "speakerId": 1000,
            "speakerName": "泽维尔",
            "text": "这，就是我所设计的「功能性测试」。",
            "nextDialogs": [
              "721190110"
            ]
          },
          "721190110": {
            "id": "721190110",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "在哪能找到「鬼兜虫」？",
            "nextDialogs": [
              "721190111"
            ]
          },
          "721190111": {
            "id": "721190111",
            "speakerId": 1000,
            "speakerName": "泽维尔",
            "text": "嗯…它们一般都栖息在雷元素富集区域…",
            "nextDialogs": [
              "721190112"
            ]
          },
          "721190112": {
            "id": "721190112",
            "speakerId": 1000,
            "speakerName": "泽维尔",
            "text": "而且我还听说，它们在「御影炉心」附近也能生存…真是一群厉害的小家伙。",
            "nextDialogs": [
              "721190113"
            ]
          },
          "721190113": {
            "id": "721190113",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "那我不如直接去「御影炉心」里抓…",
            "nextDialogs": [
              "721190114"
            ]
          },
          "721190114": {
            "id": "721190114",
            "speakerId": 1000,
            "speakerName": "泽维尔",
            "text": "虽然这样也可以…但是，如果直接从「御影炉心」里面抓「鬼兜虫」来测试的话…",
            "nextDialogs": [
              "721190115"
            ]
          },
          "721190115": {
            "id": "721190115",
            "speakerId": 1000,
            "speakerName": "泽维尔",
            "text": "说实话，我真有些担心我们这位新伙计的…可靠性。",
            "nextDialogs": [
              "721190116"
            ]
          },
          "721190116": {
            "id": "721190116",
            "speakerId": 1000,
            "speakerName": "泽维尔",
            "text": "做测试，最好还是讲一个「循序渐进」嘛。",
            "nextDialogs": [
              "721190117"
            ]
          },
          "721190117": {
            "id": "721190117",
            "speakerId": 1000,
            "speakerName": "泽维尔",
            "text": "咳，总之，请您拿三只「鬼兜虫」过来吧，我就在这等着您。",
            "nextDialogs": [
              "721190119",
              "721190121"
            ]
          },
          "721190119": {
            "id": "721190119",
            "speakerId": 1000,
            "speakerName": "泽维尔",
            "text": "那就拜托您了，只要三只「鬼兜虫」就好。"
          },
          "721190121": {
            "id": "721190121",
            "speakerId": 1000,
            "speakerName": "泽维尔",
            "text": "呃…就测试本身而言，您直接进去转一圈，沾满「祟神」再出来，确实也可以作为测试对象。",
            "nextDialogs": [
              "721190122"
            ]
          },
          "721190122": {
            "id": "721190122",
            "speakerId": 1000,
            "speakerName": "泽维尔",
            "text": "但我之前也说了，这个装置的可靠性有些…不达预期。",
            "nextDialogs": [
              "721190123"
            ]
          },
          "721190123": {
            "id": "721190123",
            "speakerId": 1000,
            "speakerName": "泽维尔",
            "text": "如果在净化过程中，真的发生了什么预期之外的情况，您可能也会…呃，面临一些预期之外的问题…",
            "nextDialogs": [
              "721190124"
            ]
          },
          "721190124": {
            "id": "721190124",
            "speakerId": 1000,
            "speakerName": "泽维尔",
            "text": "咳，总之，我们还是就用「鬼兜虫」来测试吧。",
            "nextDialogs": [
              "721190125"
            ]
          },
          "721190125": {
            "id": "721190125",
            "speakerId": 1000,
            "speakerName": "泽维尔",
            "text": "只要三只「鬼兜虫」就好，您抓到了之后，就拿回来给我吧。"
          }
        }
      }
    },

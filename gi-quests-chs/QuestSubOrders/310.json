        "dialogs": {
          "310010101": {
            "id": "310010101",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "关于猫……",
            "nextDialogs": [
              "310010102"
            ]
          },
          "310010102": {
            "id": "310010102",
            "speakerId": 2002,
            "speakerName": "永安",
            "text": "说起来早上我巡逻时，发现居然有个女孩要给它们喂牛奶…阿嚏！",
            "nextDialogs": [
              "310010103"
            ]
          },
          "310010103": {
            "id": "310010103",
            "speakerId": 2002,
            "speakerName": "永安",
            "text": "幸亏我赶紧拦住了她…虽说是出于好心吧，可猫喝牛奶是会闹肚子的！",
            "nextDialogs": [
              "310010104"
            ]
          },
          "310010104": {
            "id": "310010104",
            "speakerId": 2002,
            "speakerName": "永安",
            "text": "…可能是跟猫待久了，我也变得不爱喝牛奶了，这些牛奶就送给你好…阿嚏！"
          }
        }
      }
    },

    {
      "subId": "4014892",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "401489201"
        ],
        "dialogs": {
          "401489201": {
            "id": "401489201",
            "speakerId": 1000,
            "speakerName": "言笑",
            "text": "油、盐、酱、醋…嗯，储备都很充足，够用过这阵了。"
          }
        }
      }
    },
    {
      "subId": "4014893",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "401489301"
        ],
        "dialogs": {
          "401489301": {
            "id": "401489301",
            "speakerId": 1007,
            "speakerName": "淮安",
            "text": "#哟，{NICKNAME}，今年算是开了个好头呀。"
          }
        }
      }
    },
    {
      "subId": "4014894",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "401489401"
        ],
        "dialogs": {
          "401489401": {
            "id": "401489401",
            "speakerId": 1005,
            "speakerName": "久岐忍",
            "text": "那边的空气太令人窒息了，所以我找借口溜了出来…总之刚才多谢你配合，具体情况回头再说吧。"
          }
        }
      }
    },
    {
      "subId": "4014895",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "401489501"
        ],
        "dialogs": {
          "401489501": {
            "id": "401489501",
            "speakerId": 1000,
            "speakerName": "言笑",
            "text": "没想到世上还有吃不了豆腐的人…下酒菜我来解决，你去做「知足常乐」吧。",
            "nextDialogs": [
              "401489502"
            ]
          },
          "401489502": {
            "id": "401489502",
            "speakerId": 1005,
            "speakerName": "久岐忍",
            "text": "我也会帮忙的。放心，璃月的「高级烹饪师」证书，我还是考过的。"
          }
        }
      }
    },
    {
      "subId": "4014896",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "401489601"
        ],
        "dialogs": {
          "401489601": {
            "id": "401489601",
            "speakerId": 1004,
            "speakerName": "荒泷一斗",
            "text": "…说时迟那时快！「赤红一杵」顶天踏地，直冲「花羽叶月机关」而去！",
            "nextDialogs": [
              "401489602"
            ]
          },
          "401489602": {
            "id": "401489602",
            "speakerId": 1006,
            "speakerName": "神里绫人",
            "text": "不愧是「真剑斗虫大鬼王」，真是一场精彩绝伦的战斗。"
          }
        }
      }
    },
    {
      "subId": "4014897",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "401489701"
        ],
        "dialogs": {
          "401489701": {
            "id": "401489701",
            "speakerId": 1006,
            "speakerName": "神里绫人",
            "text": "「天崩石裂」、「不如一刀」…没想到璃月也有这么多斗虫强者。",
            "nextDialogs": [
              "401489702"
            ]
          },
          "401489702": {
            "id": "401489702",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "你不会真是来看斗虫大会的吧…",
            "nextDialogs": [
              "401489703"
            ]
          },
          "401489703": {
            "id": "401489703",
            "speakerId": 1006,
            "speakerName": "神里绫人",
            "text": "呵呵，那我这迟到得也未免太久了。只是在公事访问之余，出来散散心而已。",
            "nextDialogs": [
              "401489704"
            ]
          },
          "401489704": {
            "id": "401489704",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "海灯节的时候怎么没见着你…",
            "nextDialogs": [
              "401489705"
            ]
          },
          "401489705": {
            "id": "401489705",
            "speakerId": 1006,
            "speakerName": "神里绫人",
            "text": "各种访问都有各自的讲究，有人喜欢借节日之由，那当然也会有人避开人群。",
            "nextDialogs": [
              "401489706"
            ]
          },
          "401489706": {
            "id": "401489706",
            "speakerId": 1006,
            "speakerName": "神里绫人",
            "text": "何况正是挑了这个时间，才有缘遇上如此趣事。至于打包好的豆腐…嗯，回头就交给托马解决吧。"
          }
        }
      }
    },
    {
      "subId": "4014898",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "401489801"
        ],
        "dialogs": {
          "401489801": {
            "id": "401489801",
            "speakerId": 1004,
            "speakerName": "荒泷一斗",
            "text": "吃完这顿饭，就得回港口上工了…",
            "nextDialogs": [
              "401489802"
            ]
          },
          "401489802": {
            "id": "401489802",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "所以你们是为什么来璃月？",
            "nextDialogs": [
              "401489803"
            ]
          },
          "401489803": {
            "id": "401489803",
            "speakerId": 1004,
            "speakerName": "荒泷一斗",
            "text": "这个嘛…",
            "nextDialogs": [
              "401489804"
            ]
          },
          "401489804": {
            "id": "401489804",
            "speakerId": 1005,
            "speakerName": "久岐忍",
            "text": "…还是我来说吧。老大最近特意找了一份水手的差事，能够跟船来璃月。",
            "nextDialogs": [
              "401489805"
            ]
          },
          "401489805": {
            "id": "401489805",
            "speakerId": 1005,
            "speakerName": "久岐忍",
            "text": "船只靠岸以后，有一段时间可以自由行动，就能去看望「花角玉将」了。",
            "nextDialogs": [
              "401489806"
            ]
          },
          "401489806": {
            "id": "401489806",
            "speakerId": 1004,
            "speakerName": "荒泷一斗",
            "text": "顺、顺便！只是顺便而已！"
          }
        }
      }
    }
  ]
}
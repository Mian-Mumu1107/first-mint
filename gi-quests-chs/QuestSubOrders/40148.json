  },
  "subQuests": [
    {
      "subId": "4014801",
      "subQuestName": "等待至次日的6时至8时",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "401480101"
        ],
        "dialogs": {
          "401480101": {
            "id": "401480101",
            "speakerId": 1000,
            "speakerName": "言笑",
            "text": "#早，今天也有劳你咯，{NICKNAME}。",
            "nextDialogs": [
              "401480102"
            ]
          },
          "401480102": {
            "id": "401480102",
            "speakerId": 1001,
            "speakerName": "Black Screen",
            "text": "有了前几次的经验，你们越发得心应手…",
            "nextDialogs": [
              "401480103"
            ]
          },
          "401480103": {
            "id": "401480103",
            "speakerId": 1000,
            "speakerName": "言笑",
            "text": "嗯…你越来越适应在店里掌勺了嘛，这下不管来再怎么麻烦的客人，都不成问题…",
            "nextDialogs": [
              "401480104"
            ]
          },
          "401480104": {
            "id": "401480104",
            "speakerId": 1002,
            "speakerName": "派蒙",
            "text": "——打住！我总感觉每次你一说这话，就会出现麻烦的事情！",
            "nextDialogs": [
              "401480105"
            ]
          },
          "401480105": {
            "id": "401480105",
            "speakerId": 1000,
            "speakerName": "言笑",
            "text": "嘿，哪有这回事儿！我又不是…",
            "nextDialogs": [
              "401480106"
            ]
          },
          "401480106": {
            "id": "401480106",
            "speakerId": 1003,
            "speakerName": "？？？",
            "text": "——啊哈哈哈哈！",
            "nextDialogs": [
              "401480107"
            ]
          },
          "401480107": {
            "id": "401480107",
            "speakerId": 1004,
            "speakerName": "荒泷一斗",
            "text": "哎呀，没想到能在璃月见到兄弟你啊！欸，那句俗话是怎么说的来着…",
            "nextDialogs": [
              "401480108"
            ]
          },
          "401480108": {
            "id": "401480108",
            "speakerId": 1005,
            "speakerName": "久岐忍",
            "text": "「他乡遇故知」，老大。",
            "nextDialogs": [
              "401480109"
            ]
          },
          "401480109": {
            "id": "401480109",
            "speakerId": 1004,
            "speakerName": "荒泷一斗",
            "text": "对对对，就是这个！你说是吧——绫人兄！",
            "nextDialogs": [
              "401480110"
            ]
          },
          "401480110": {
            "id": "401480110",
            "speakerId": 1006,
            "speakerName": "神里绫人",
            "text": "呵呵…",
            "nextDialogs": [
              "401480111"
            ]
          },
          "401480111": {
            "id": "401480111",
            "speakerId": 1002,
            "speakerName": "派蒙",
            "text": "——放牛的？怎么又是你！",
            "nextDialogs": [
              "401480112"
            ]
          },
          "401480112": {
            "id": "401480112",
            "speakerId": 1004,
            "speakerName": "荒泷一斗",
            "text": "嗯？飞行…「破空白铁小堇瓜」？还有挚友！怎么今天这么走运，能遇上这么多老朋友？",
            "nextDialogs": [
              "401480113"
            ]
          },
          "401480113": {
            "id": "401480113",
            "speakerId": 1002,
            "speakerName": "派蒙",
            "text": "你前阵子不是还说要回去好好攒钱吗…怎么又跑来了？",
            "nextDialogs": [
              "401480114"
            ]
          },
          "401480114": {
            "id": "401480114",
            "speakerId": 1004,
            "speakerName": "荒泷一斗",
            "text": "哈哈，以本大爷的身手，想赚钱还不是手到擒来的事？这趟出来，当然是吃香的喝辣的了！",
            "nextDialogs": [
              "401480115"
            ]
          },
          "401480115": {
            "id": "401480115",
            "speakerId": 1004,
            "speakerName": "荒泷一斗",
            "text": "咳…顺便再看看玉将在璃月过得怎么样…",
            "nextDialogs": [
              "401480116"
            ]
          },
          "401480116": {
            "id": "401480116",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "（阿忍在用眼神示意…现在先不要深究吧…）",
            "nextDialogs": [
              "401480117"
            ]
          },
          "401480117": {
            "id": "401480117",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "那绫人你又是？",
            "nextDialogs": [
              "401480118"
            ]
          },
          "401480118": {
            "id": "401480118",
            "speakerId": 1006,
            "speakerName": "神里绫人",
            "text": "…我听说前阵子有人在璃月举办「斗虫试合」，所以特意赶来看看。只可惜，似乎错过了时间。",
            "nextDialogs": [
              "401480119"
            ]
          },
          "401480119": {
            "id": "401480119",
            "speakerId": 1004,
            "speakerName": "荒泷一斗",
            "text": "什么？居然错过了那场大会！哎，那真是太可惜了…",
            "nextDialogs": [
              "401480120"
            ]
          },
          "401480120": {
            "id": "401480120",
            "speakerId": 1006,
            "speakerName": "神里绫人",
            "text": "是啊，幸好这趟出行遇见了一斗兄弟，可以听你讲讲那时的盛况。",
            "nextDialogs": [
              "401480121"
            ]
          },
          "401480121": {
            "id": "401480121",
            "speakerId": 1004,
            "speakerName": "荒泷一斗",
            "text": "哈哈，好说好说，我们边吃边聊。这店里的厨师呢？快喊厨师出来，我要给挚友们整顿硬菜！",
            "nextDialogs": [
              "401480122"
            ]
          },
          "401480122": {
            "id": "401480122",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "我就是厨师。",
            "nextDialogs": [
              "401480123"
            ]
          },
          "401480123": {
            "id": "401480123",
            "speakerId": 1004,
            "speakerName": "荒泷一斗",
            "text": "…啊？",
            "nextDialogs": [
              "401480124"
            ]
          },
          "401480124": {
            "id": "401480124",
            "speakerId": 1002,
            "speakerName": "派蒙",
            "text": "喂，放牛的是在学书里的情节啦，那种大手一挥，就有人跑出来的桥段…这里还是给他点面子吧！",
            "nextDialogs": [
              "401480125"
            ]
          },
          "401480125": {
            "id": "401480125",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "…不过还有主厨。",
            "nextDialogs": [
              "401480126"
            ]
          },
          "401480126": {
            "id": "401480126",
            "speakerId": 1004,
            "speakerName": "荒泷一斗",
            "text": "啊…哈哈，挚友真会开玩笑，那就快请那位主厨出来吧！",
            "nextDialogs": [
              "401480127"
            ]
          },
          "401480127": {
            "id": "401480127",
            "speakerId": 1001,
            "speakerName": "Black Screen",
            "text": "你与派蒙回到后厨，向言笑说明原委，请他出面圆场…",
            "nextDialogs": [
              "401480128"
            ]
          },
          "401480128": {
            "id": "401480128",
            "speakerId": 1000,
            "speakerName": "言笑",
            "text": "呃…那客官是要点什么？要宴请贵客的话，我们这儿有「金玉满堂」、「繁弦急管」…",
            "nextDialogs": [
              "401480129"
            ]
          },
          "401480129": {
            "id": "401480129",
            "speakerId": 1005,
            "speakerName": "久岐忍",
            "text": "…老大，注意预算。",
            "nextDialogs": [
              "401480130"
            ]
          },
          "401480130": {
            "id": "401480130",
            "speakerId": 1004,
            "speakerName": "荒泷一斗",
            "text": "嗯…嗯…那个…有没有更…实在一点儿的？",
            "nextDialogs": [
              "401480131"
            ]
          },
          "401480131": {
            "id": "401480131",
            "speakerId": 1000,
            "speakerName": "言笑",
            "text": "实在？呃…倒是有一道「知足常乐」，卤香四溢，回味无穷，是大快朵颐，物美价廉的首选…",
            "nextDialogs": [
              "401480132"
            ]
          },
          "401480132": {
            "id": "401480132",
            "speakerId": 1004,
            "speakerName": "荒泷一斗",
            "text": "「知足常乐」？好名字！一听就知道是道硬菜，就选它了！在座的都是朋友，就不整那些花里胡哨的了！",
            "nextDialogs": [
              "401480133"
            ]
          },
          "401480133": {
            "id": "401480133",
            "speakerId": 1006,
            "speakerName": "神里绫人",
            "text": "一斗兄好眼光，我也向来不喜欢过于精致的菜。嗯…这就是知己吧？",
            "nextDialogs": [
              "401480134"
            ]
          },
          "401480134": {
            "id": "401480134",
            "speakerId": 1004,
            "speakerName": "荒泷一斗",
            "text": "知己？哈哈，对，就是知己！",
            "nextDialogs": [
              "401480135"
            ]
          },
          "401480135": {
            "id": "401480135",
            "speakerId": 1002,
            "speakerName": "派蒙",
            "text": "真的假的…算了，你们俩开心就好…"
          }
        }
      }
    },
    {
      "subId": "4014802",
      "subQuestName": "与言笑对话",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [],
        "dialogs": {}
      }
    },
    {
      "subId": "4014806",
      "subQuestName": "与言笑对话",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "401480401"
        ],
        "dialogs": {
          "401480401": {
            "id": "401480401",
            "speakerId": 1000,
            "speakerName": "言笑",
            "text": "你的朋友，还真有个性…不过这道「知足常乐」也不算难做，这回应该没啥问题。",
            "nextDialogs": [
              "401480402"
            ]
          },
          "401480402": {
            "id": "401480402",
            "speakerId": 1002,
            "speakerName": "派蒙",
            "text": "说起来，为什么要叫「知足常乐」呢？大快朵颐、大口吃肉…听起来完全不知足嘛！",
            "nextDialogs": [
              "401480403"
            ]
          },
          "401480403": {
            "id": "401480403",
            "speakerId": 1000,
            "speakerName": "言笑",
            "text": "我也没说大口吃肉吧…这菜只是看起来像肉而已，其实是用豆腐做出肉的色香味来，所以才叫「知足常乐」嘛。",
            "nextDialogs": [
              "401480404"
            ]
          },
          "401480404": {
            "id": "401480404",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "豆腐？！",
            "nextDialogs": [
              "401480405"
            ]
          },
          "401480405": {
            "id": "401480405",
            "speakerId": 1002,
            "speakerName": "派蒙",
            "text": "啊！我记得放牛的…好像吃不了豆制品吧？怎么办，是不是该找他们换一样…",
            "nextDialogs": [
              "401480406"
            ]
          },
          "401480406": {
            "id": "401480406",
            "speakerId": 1005,
            "speakerName": "久岐忍",
            "text": "…你们遇上什么麻烦了吗？我刚刚好像听见「豆腐」什么的…",
            "nextDialogs": [
              "401480407"
            ]
          },
          "401480407": {
            "id": "401480407",
            "speakerId": 1000,
            "speakerName": "言笑",
            "text": "等等，厨房重地，闲人…唉，现在也不是计较这个的时候…能请你们老大换道菜吗？",
            "nextDialogs": [
              "401480408"
            ]
          },
          "401480408": {
            "id": "401480408",
            "speakerId": 1004,
            "speakerName": "荒泷一斗",
            "text": "…哈哈！知绫人兄者，本大爷也！这道「知足常乐」，就是我们友情的证明！",
            "nextDialogs": [
              "401480409"
            ]
          },
          "401480409": {
            "id": "401480409",
            "speakerId": 1004,
            "speakerName": "荒泷一斗",
            "text": "…喂！还没好吗！快点儿快点儿，我的「赤红一杵冒险谭」都要讲完了！",
            "nextDialogs": [
              "401480410"
            ]
          },
          "401480410": {
            "id": "401480410",
            "speakerId": 1005,
            "speakerName": "久岐忍",
            "text": "…如你们所见，恐怕有难度。",
            "nextDialogs": [
              "401480411"
            ]
          },
          "401480411": {
            "id": "401480411",
            "speakerId": 1002,
            "speakerName": "派蒙",
            "text": "完蛋，这家伙上头了。在面子和肚子之间，他多半会选面子…",
            "nextDialogs": [
              "401480414"
            ]
          },
          "401480414": {
            "id": "401480414",
            "speakerId": 1005,
            "speakerName": "久岐忍",
            "text": "嗯，我先让老大多吃点下酒菜填饱肚子…到时候再见机行事吧。"
          }
        }
      }
    },
    {
      "subId": "4014803",
      "subQuestName": "烹制「知足常乐」",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "401480301"
        ],
        "dialogs": {
          "401480301": {
            "id": "401480301",
            "speakerId": 1000,
            "speakerName": "言笑",
            "text": "看起来算是安全度过了？好，整理一下精神，应付下一波客人吧。",
            "nextDialogs": [
              "401480302"
            ]
          },
          "401480302": {
            "id": "401480302",
            "speakerId": 1001,
            "speakerName": "Black Screen",
            "text": "一天过去，安然无事…"
          }
        }
      }
    },
    {
      "subId": "4014804",
      "subQuestName": "为等待已久的稻妻一行人上菜",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "401480201"
        ],
        "dialogs": {
          "401480201": {
            "id": "401480201",
            "speakerId": 1002,
            "speakerName": "派蒙",
            "text": "菜…菜来咯…",
            "nextDialogs": [
              "401480202"
            ]
          },
          "401480202": {
            "id": "401480202",
            "speakerId": 1004,
            "speakerName": "荒泷一斗",
            "text": "嚯嚯，这就是「知足常乐」？果然量大管饱，很不错！",
            "nextDialogs": [
              "401480203"
            ]
          },
          "401480203": {
            "id": "401480203",
            "speakerId": 1004,
            "speakerName": "荒泷一斗",
            "text": "来来来，挚友你也坐。在座的都是朋友，谁都不要跟谁客气！我先来一块…",
            "nextDialogs": [
              "401480204"
            ]
          },
          "401480204": {
            "id": "401480204",
            "speakerId": 1005,
            "speakerName": "久岐忍",
            "text": "咳！老大，所谓「入乡随俗」，根据璃月的餐桌礼仪，这里应该让客人先尝。",
            "nextDialogs": [
              "401480205"
            ]
          },
          "401480205": {
            "id": "401480205",
            "speakerId": 1004,
            "speakerName": "荒泷一斗",
            "text": "嗯？阿忍你不是最讨厌这些条条框框吗…",
            "nextDialogs": [
              "401480208"
            ]
          },
          "401480208": {
            "id": "401480208",
            "speakerId": 1004,
            "speakerName": "荒泷一斗",
            "text": "哦？连挚友也…哦哦，一定是太香了对不对？行，既然你们都这么说的话，本大爷就最后一个吃吧！",
            "nextDialogs": [
              "401480209"
            ]
          },
          "401480209": {
            "id": "401480209",
            "speakerId": 1006,
            "speakerName": "神里绫人",
            "text": "……",
            "nextDialogs": [
              "401480210"
            ]
          },
          "401480210": {
            "id": "401480210",
            "speakerId": 1001,
            "speakerName": "Black Screen",
            "text": "你与派蒙、绫人、阿忍依次吃了一圈，盘中的「肉块」也少了许多…",
            "nextDialogs": [
              "401480211"
            ]
          },
          "401480211": {
            "id": "401480211",
            "speakerId": 1006,
            "speakerName": "神里绫人",
            "text": "…呵，原来如此。",
            "nextDialogs": [
              "401480212"
            ]
          },
          "401480212": {
            "id": "401480212",
            "speakerId": 1004,
            "speakerName": "荒泷一斗",
            "text": "——可算轮到本大爷啦，现在就来一块最大的！",
            "nextDialogs": [
              "401480213"
            ]
          },
          "401480213": {
            "id": "401480213",
            "speakerId": 1002,
            "speakerName": "派蒙",
            "text": "等、等一下！",
            "nextDialogs": [
              "401480214"
            ]
          },
          "401480214": {
            "id": "401480214",
            "speakerId": 1004,
            "speakerName": "荒泷一斗",
            "text": "嗯？又有什么事啊。"
          }
        }
      }
    },
    {

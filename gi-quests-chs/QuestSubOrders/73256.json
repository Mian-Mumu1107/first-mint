    {
      "subId": "7325603",
      "subQuestName": "前往地下遗迹入口",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "732560301"
        ],
        "dialogs": {
          "732560301": {
            "id": "732560301",
            "speakerId": 4283,
            "speakerName": "那先朱那",
            "text": "<color=#00E1FFFF>「转动齿轮使之显现全部三种符号，在不改变底部三角符号的同时，使矩形与之相连」</color>，总之你们按照我说的试一下就好了。"
          }

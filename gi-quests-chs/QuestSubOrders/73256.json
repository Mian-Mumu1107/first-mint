    {
      "subId": "7325628",
      "subQuestName": "(test)CS隐藏任务$HIDDEN",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "732562801"
        ],
        "dialogs": {
          "732562801": {
            "id": "732562801",
            "speakerId": 4283,
            "speakerName": "那先朱那",
            "text": "我如果一起去的话也只会碍手碍脚，不如就在此静候佳音了。",
            "nextDialogs": [
              "732562802"
            ]
          },
          "732562802": {
            "id": "732562802",
            "speakerId": 4283,
            "speakerName": "那先朱那",
            "text": "不管是荼诃的机关还是迪弗的魔物，对于尊使大人和你们来说，应该都是小菜一碟吧。"
          }

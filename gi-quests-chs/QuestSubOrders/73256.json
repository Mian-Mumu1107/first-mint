        "dialogs": {}
      }
    },
    {
      "subId": "7325623",
      "subQuestName": "与那先朱那对话",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "732562301"
        ],
        "dialogs": {
          "732562301": {
            "id": "732562301",
            "speakerId": 4283,
            "speakerName": "那先朱那",
            "text": "尊使大人，还有尊使的谒颂主，恐怕我只能陪你们到这里了。",
            "nextDialogs": [
              "732562302"
            ]
          },
          "732562302": {
            "id": "732562302",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "又怎么了。",
            "nextDialogs": [
              "732562303"
            ]
          },
          "732562303": {
            "id": "732562303",
            "speakerId": 4283,
            "speakerName": "那先朱那",
            "text": "按照文献中的记载，接下来的路途充满凶险，并非本人的凡人之躯所能承受。",
            "nextDialogs": [
              "732562304"
            ]
          },
          "732562304": {
            "id": "732562304",
            "speakerId": 4283,
            "speakerName": "那先朱那",
            "text": "从这里进去便是古时荼诃人用来试验机关性能的试验场，其中还有一架未完成的实验型的巨型机关。",
            "nextDialogs": [
              "732562305"
            ]
          },
          "732562305": {
            "id": "732562305",
            "speakerId": 4283,
            "speakerName": "那先朱那",
            "text": "根据笔记中所抄录的荼诃人的记录，虽然没有发挥什么作用，但这里曾被改造为狙击魔物的防御工事。",
            "nextDialogs": [
              "732562306"
            ]
          },
          "732562306": {
            "id": "732562306",
            "speakerId": 4283,
            "speakerName": "那先朱那",
            "text": "很奇怪不是吗，明明是引发了污秽灾厄的荼诃人，却建造了对抗魔物的机关。",
            "nextDialogs": [
              "732562307"
            ]
          },
          "732562307": {
            "id": "732562307",
            "speakerId": 4283,
            "speakerName": "那先朱那",
            "text": "不过既然我们现在已经启动了整座遗迹的控制系统，想必这个试验场里面的防御机关也被启动了。",
            "nextDialogs": [
              "732562308"
            ]
          },
          "732562308": {
            "id": "732562308",
            "speakerId": 4283,
            "speakerName": "那先朱那",
            "text": "而我们要找的灵光绝唱，应该就藏在里面的巨像当中。虽然使我望而却步，但对于诸位来说，必定是小菜一碟。",
            "nextDialogs": [
              "732562309"
            ]
          },
          "732562309": {
            "id": "732562309",
            "speakerId": 4283,
            "speakerName": "那先朱那",
            "text": "为了能够集齐全部的灵光绝唱，请允许我暂且在此等候诸位。",
            "nextDialogs": [
              "732562310"
            ]
          },
          "732562310": {
            "id": "732562310",
            "speakerId": 13210,
            "speakerName": "斯露莎",
            "text": "毕竟你也不过是区区人类，这样的请求也算是合情合理。",
            "nextDialogs": [
              "732562311"
            ]
          },
          "732562311": {
            "id": "732562311",
            "speakerId": 4283,
            "speakerName": "那先朱那",
            "text": "蒙您恩许。",
            "nextDialogs": [
              "732562312"
            ]
          },
          "732562312": {
            "id": "732562312",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "虽然那先朱那又临阵脱逃了，不过反正你们两个不凑在一块我也感觉轻松很多啦…"
          }
        }
      }
    },

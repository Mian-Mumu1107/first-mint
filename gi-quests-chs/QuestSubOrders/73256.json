      }
    },
    {
      "subId": "7325607",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "732560701"
        ],
        "dialogs": {
          "732560701": {
            "id": "732560701",
            "speakerId": 4283,
            "speakerName": "那先朱那",
            "text": "看来我们终于到达这个遗迹的中心了，那么就由对荼诃遗迹颇有研究的本人来为你们进行说明吧。",
            "nextDialogs": [
              "732560702"
            ]
          },
          "732560702": {
            "id": "732560702",
            "speakerId": 4283,
            "speakerName": "那先朱那",
            "text": "根据笔记中的说法，这里原本是荼诃人研究与试验机关性能的试验基地，而灵光绝唱就位于最深处的试验场。",
            "nextDialogs": [
              "732560703"
            ]
          },
          "732560703": {
            "id": "732560703",
            "speakerId": 4283,
            "speakerName": "那先朱那",
            "text": "想要去到那里的话，首先…",
            "nextDialogs": [
              "732560704"
            ]
          },
          "732560704": {
            "id": "732560704",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "刚刚还说自己有研究，现在就开始明目张胆地翻书了！",
            "nextDialogs": [
              "732560705"
            ]
          },
          "732560705": {
            "id": "732560705",
            "speakerId": 4283,
            "speakerName": "那先朱那",
            "text": "毕竟此处遗迹的结构实在太复杂了。这些荼诃人所设置的神秘装置，我想没人能不看说明就搞清楚它们的运作原理。",
            "nextDialogs": [
              "732560706"
            ]
          },
          "732560706": {
            "id": "732560706",
            "speakerId": 4283,
            "speakerName": "那先朱那",
            "text": "让我看看…嗯，我知道了。看来我们所在的位置就是整座试验基地的控制中心。",
            "nextDialogs": [
              "732560707"
            ]
          },
          "732560707": {
            "id": "732560707",
            "speakerId": 4283,
            "speakerName": "那先朱那",
            "text": "想要到达灵光绝唱所在的位置，必须先启动整座遗迹的控制系统才行。而为了启动控制系统，还得先解决能源问题。",
            "nextDialogs": [
              "732560708"
            ]
          },
          "732560708": {
            "id": "732560708",
            "speakerId": 4283,
            "speakerName": "那先朱那",
            "text": "虽然据说荼诃人会利用污秽的力量驱使机关和魔物，但这座遗迹似乎并没有使用污秽作为能源。",
            "nextDialogs": [
              "732560709"
            ]
          },
          "732560709": {
            "id": "732560709",
            "speakerId": 4283,
            "speakerName": "那先朱那",
            "text": "相反是依靠一种被称为「阿索斯物质」的能源运作的。它们是从纯粹的元素能量中提取出来，然后凝练成块状。",
            "nextDialogs": [
              "732560710"
            ]
          },
          "732560710": {
            "id": "732560710",
            "speakerId": 4283,
            "speakerName": "那先朱那",
            "text": "也就是说只要能找到这种能量块，便可以为这些能量核心供能，剩下的问题应该也能迎刃而解了。",
            "nextDialogs": [
              "732560711"
            ]
          },
          "732560711": {
            "id": "732560711",
            "speakerId": 13210,
            "speakerName": "斯露莎",
            "text": "听上去还真是麻烦，要是能靠战斗解决就好了。",
            "nextDialogs": [
              "732560713",
              "732560715"
            ]
          },
          "732560713": {
            "id": "732560713",
            "speakerId": 4283,
            "speakerName": "那先朱那",
            "text": "哦哦，干劲满满啊，不愧是尊使的谒颂主。",
            "nextDialogs": [
              "732560717"
            ]
          },
          "732560717": {
            "id": "732560717",
            "speakerId": 4283,
            "speakerName": "那先朱那",
            "text": "既然这样，寻找能量块的工作就交给你们了。这张是描绘了这座试验基地结构的示意图，我想你们一定会用得上。",
            "nextDialogs": [
              "732560718"
            ]
          },
          "732560718": {
            "id": "732560718",
            "speakerId": 4283,
            "speakerName": "那先朱那",
            "text": "那么我还有些事情需要研究，就在这里等你们回来了。有尊使和你们一同前往，想必一定是所向披靡。",
            "nextDialogs": [
              "732560719"
            ]
          },
          "732560719": {
            "id": "732560719",
            "speakerId": 4283,
            "speakerName": "那先朱那",
            "text": "有什么问题，就多研究一下这张示意图吧。"
          },
          "732560715": {
            "id": "732560715",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "对哦，之前在须弥我们操控过的大机器人，里面不是也有类似的装置吗？",
            "nextDialogs": [
              "732560716"
            ]
          },
          "732560716": {
            "id": "732560716",
            "speakerId": 4283,
            "speakerName": "那先朱那",
            "text": "哦哦，没想到你们竟然接触过这种装置，那么问题就简单了。"
          }
        }
      }
    }
  ]
}
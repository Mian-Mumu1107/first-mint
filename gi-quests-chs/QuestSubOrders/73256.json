      }
    },
    {
      "subId": "7325624",
      "subQuestName": "与那先朱那对话",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "732562401"
        ],
        "dialogs": {
          "732562401": {
            "id": "732562401",
            "speakerId": 4283,
            "speakerName": "那先朱那",
            "text": "不愧是尊使大人和谒颂主，不管是荼诃的机关还是迪弗的魔物都无法阻止你们前进的步伐。",
            "nextDialogs": [
              "732562402"
            ]
          },
          "732562402": {
            "id": "732562402",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "欸？那先朱那你是什么时候进到这里来的？",
            "nextDialogs": [
              "732562403"
            ]
          },
          "732562403": {
            "id": "732562403",
            "speakerId": 4283,
            "speakerName": "那先朱那",
            "text": "我可是一直在外面欣赏你们战斗的英姿呢！看到你们已经取得了灵光绝唱，我就赶紧跟上来了啊。",
            "nextDialogs": [
              "732562404"
            ]
          },
          "732562404": {
            "id": "732562404",
            "speakerId": 4283,
            "speakerName": "那先朱那",
            "text": "真是辛苦你们了，那么不如就先把灵光绝唱交由我来保管吧，这样的话，怎么说呢，会让我比较有参与感？",
            "nextDialogs": [
              "732562405"
            ]
          },
          "732562405": {
            "id": "732562405",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "不过那先朱那根本就没怎么出力吧，而且祖尔宛也说不能把灵光绝唱随便交给别人。",
            "nextDialogs": [
              "732562406"
            ]
          },
          "732562406": {
            "id": "732562406",
            "speakerId": 4283,
            "speakerName": "那先朱那",
            "text": "话可不能这样说。况且我对灵光绝唱可是很有研究的，先让我研究一下对于后面的事情也会很有帮助吧。",
            "nextDialogs": [
              "732562407"
            ]
          },
          "732562407": {
            "id": "732562407",
            "speakerId": 4283,
            "speakerName": "那先朱那",
            "text": "比如这些灵光绝唱究竟为什么会被藏在这些遗迹之下…",
            "nextDialogs": [
              "732562408"
            ]
          },
          "732562408": {
            "id": "732562408",
            "speakerId": 13210,
            "speakerName": "斯露莎",
            "text": "现在不是讲故事的时候，纳苏勒阿。",
            "nextDialogs": [
              "732562409"
            ]
          },
          "732562409": {
            "id": "732562409",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "对哦，我们还是赶紧前往下一处藏有大灵光的地点吧。",
            "nextDialogs": [
              "732562410"
            ]
          },
          "732562410": {
            "id": "732562410",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "等到集齐了全部的大灵光，再听那先朱那讲故事也不迟。",
            "nextDialogs": [
              "732562411"
            ]
          },
          "732562411": {
            "id": "732562411",
            "speakerId": 4283,
            "speakerName": "那先朱那",
            "text": "这样…也好。"
          }
        }
      }
    },
    {
      "subId": "7325631",
      "subQuestName": "(test)解除齿轮结晶（防回滚）$HIDDEN",
      "sceneId": null,
      "locations": [],

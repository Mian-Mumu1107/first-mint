        "dialogs": {}
      }
    },
    {
      "subId": "7401115",
      "subQuestName": "寻找夏诺蒂拉",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "740111501"
        ],
        "dialogs": {
          "740111501": {
            "id": "740111501",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "咦！夏诺蒂拉跑到哪去了，明明刚才还在这里…",
            "nextDialogs": [
              "740111502"
            ]
          },
          "740111502": {
            "id": "740111502",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "等等地上好像有什么东西…捡起来看看吧。",
            "nextDialogs": [
              "740111503"
            ]
          },
          "740111503": {
            "id": "740111503",
            "speakerId": 1003,
            "speakerName": "Black Screen",
            "text": "从地上捡起了一张书页…",
            "nextDialogs": [
              "740111504"
            ]
          },
          "740111504": {
            "id": "740111504",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "这个书页不是和我们之前找到过的那些一样吗？怎么会出现在这里呢。",
            "nextDialogs": [
              "740111505"
            ]
          },
          "740111505": {
            "id": "740111505",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "让我看看…",
            "nextDialogs": [
              "740111506"
            ]
          },
          "740111506": {
            "id": "740111506",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "竟然直接就能读懂，是因为在这个奇怪的空间里的关系吗？",
            "nextDialogs": [
              "740111507"
            ]
          },
          "740111507": {
            "id": "740111507",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "灾祸？毁灭？末日？什么嘛，就算能读懂也完全不知道他想说什么啦。",
            "nextDialogs": [
              "740111509",
              "740111511"
            ]
          },
          "740111509": {
            "id": "740111509",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "唔…确实之前也看到过「计算」之类的话。",
            "nextDialogs": [
              "740111512"
            ]
          },
          "740111512": {
            "id": "740111512",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "也就是说，这里就是书的作者想要让我们看到的未来景象吗？",
            "nextDialogs": [
              "740111513"
            ]
          },
          "740111513": {
            "id": "740111513",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "连甜甜花和薄荷都长不出来的世界，不管怎么说也太可怕了！",
            "nextDialogs": [
              "740111514"
            ]
          },
          "740111514": {
            "id": "740111514",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "但如果真的未来会变成这样的话，不是应该告诉大家，然后想办法一起解决吗？为什么要弄出这样的地方呢？"
          },
          "740111511": {
            "id": "740111511",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "唔…和我们之前猜的一样呢。"
          }
        }
      }
    },

        "dialogs": {
          "740110301": {
            "id": "740110301",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "……",
            "nextDialogs": [
              "740110302"
            ]
          },
          "740110302": {
            "id": "740110302",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "唔，果然你也看不懂吗？",
            "nextDialogs": [
              "740110304"
            ]
          },
          "740110304": {
            "id": "740110304",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "说不定是什么密码呢，再仔细研究看看吧！",
            "nextDialogs": [
              "740110306"
            ]
          },
          "740110306": {
            "id": "740110306",
            "speakerId": 1003,
            "speakerName": "Black Screen",
            "text": "你盯着书页上未知的符文看了一会，这些符文似乎慢慢开始分解重组，形成新的文字。\\n与此同时周围的一切也渐渐远去，你好像来到了一个陌生的地方。",
            "nextDialogs": [
              "740110307"
            ]
          },
          "740110307": {
            "id": "740110307",
            "speakerId": 1003,
            "speakerName": "Black Screen",
            "text": "「原来如此。这可是连甜甜花和薄荷都长不出来的世界。你也能看到吗？」",
            "nextDialogs": [
              "740110308"
            ]
          },
          "740110308": {
            "id": "740110308",
            "speakerId": 1003,
            "speakerName": "Black Screen",
            "text": "你回过头寻找声音的来源，却猛地清醒过来。再看书上的那些符文，却还是原来那样，好像什么事情也没有发生。",
            "nextDialogs": [
              "740110309"
            ]
          },
          "740110309": {
            "id": "740110309",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "#嗯…所以{NICKNAME}你看出些什么了吗？"
          }
        }
      }
    },

    {
      "subId": "101104",
      "subQuestName": "（test）开始鉴定前的对话$HIDDEN",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "10110401"
        ],
        "dialogs": {
          "10110401": {
            "id": "10110401",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "哇…里面还有汤呢，丘丘人的胃口可真大。",
            "nextDialogs": [
              "10110404"
            ]
          },
          "10110404": {
            "id": "10110404",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "这锅汤刚好可以作为「水」元素力的保护，那就开始点火，进行试验吧？",
            "nextDialogs": [
              "10110405"
            ]
          },
          "10110405": {
            "id": "10110405",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "【表现备注，伸手放置的动作or投石的视觉表现】",
            "nextDialogs": [
              "10110406"
            ]
          },
          "10110406": {
            "id": "10110406",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "这样应该就可以了吧？派蒙也会帮忙记着三块样品的编号和位置的。",
            "nextDialogs": [
              "10110407"
            ]
          },
          "10110407": {
            "id": "10110407",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "那么现在开始！用<color=#00E1FFFF>「火」的元素力</color>不断加热大锅，直到结果出现为止——",
            "nextDialogs": [
              "10110408"
            ]
          },
          "10110408": {
            "id": "10110408",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "钟离先生说，<color=#00E1FFFF>光泽越亮越蓝</color>的矿石品质越好，要注意观察哦。"
          }
        }
      }
    },

  "subQuests": [
    {
      "subId": "101101",
      "subQuestName": "前往购买夜泊石",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "10110101"
        ],
        "dialogs": {
          "10110101": {
            "id": "10110101",
            "speakerId": 2054,
            "speakerName": "石头",
            "text": "哟，客官，欢迎光临「解翠行」。今天要不要来开两块「璞石」试试手气？",
            "nextDialogs": [
              "10110102"
            ]
          },
          "10110102": {
            "id": "10110102",
            "speakerId": 2054,
            "speakerName": "石头",
            "text": "便宜又好玩，也许一不留神就发家致富了呢？",
            "nextDialogs": [
              "10110103"
            ]
          },
          "10110103": {
            "id": "10110103",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "「璞石」？不要不要，我们是来挑…什么石头来着？",
            "nextDialogs": [
              "10110104"
            ]
          },
          "10110104": {
            "id": "10110104",
            "speakerId": 10232,
            "speakerName": "钟离",
            "text": "夜泊石，品相至少要「烛照」级。",
            "nextDialogs": [
              "10110105"
            ]
          },
          "10110105": {
            "id": "10110105",
            "speakerId": 2054,
            "speakerName": "石头",
            "text": "「烛照」级的夜泊石…？嗯，原来不是游客。失礼了，我这就拿货，请看…",
            "nextDialogs": [
              "10110106"
            ]
          },
          "10110106": {
            "id": "10110106",
            "speakerId": 2054,
            "speakerName": "石头",
            "text": "（黑屏，拿来了货）",
            "nextDialogs": [
              "10110107"
            ]
          },
          "10110107": {
            "id": "10110107",
            "speakerId": 2054,
            "speakerName": "石头",
            "text": "您看这怎么样？我们「解翠行」可是玉石老字号。瞧瞧这品相！绝对上佳，简直是岩王爷也难得降下的恩赐。您就放心随便选吧。",
            "nextDialogs": [
              "10110108"
            ]
          },
          "10110108": {
            "id": "10110108",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "这三块「夜泊石」看上去确实都很漂亮，不像是平时挖出来的那种…",
            "nextDialogs": [
              "10110109"
            ]
          },
          "10110109": {
            "id": "10110109",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "但，到底该怎么选啊，要不我们就随便选一种回去？",
            "nextDialogs": [
              "10110111"
            ]
          },
          "10110111": {
            "id": "10110111",
            "speakerId": 10232,
            "speakerName": "钟离",
            "text": "很好。贸易之都的生存法则，看来你已经悟到了几分。",
            "nextDialogs": [
              "10110112"
            ]
          },
          "10110112": {
            "id": "10110112",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "那钟离先生的意见呢？这些「夜泊石」该怎么选？",
            "nextDialogs": [
              "10110114"
            ]
          },
          "10110114": {
            "id": "10110114",
            "speakerId": 10232,
            "speakerName": "钟离",
            "text": "哦？想要我来决定么。也好。",
            "nextDialogs": [
              "10110115"
            ]
          },
          "10110115": {
            "id": "10110115",
            "speakerId": 10232,
            "speakerName": "钟离",
            "text": "要我说的话，答案其实很简单…",
            "nextDialogs": [
              "10110116"
            ]
          },
          "10110116": {
            "id": "10110116",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "嗯？答案是…？",
            "nextDialogs": [
              "10110117"
            ]
          },
          "10110117": {
            "id": "10110117",
            "speakerId": 10232,
            "speakerName": "钟离",
            "text": "老板，我全要了。",
            "nextDialogs": [
              "10110118"
            ]
          },
          "10110118": {
            "id": "10110118",
            "speakerId": 2054,
            "speakerName": "石头",
            "text": "好！这位老爷，我早看出您气宇不凡，出手果真阔气——",
            "nextDialogs": [
              "10110119"
            ]
          },
          "10110119": {
            "id": "10110119",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "等等！等一下，老板，刚才他说的不算，我们再商量下！",
            "nextDialogs": [
              "10110120"
            ]
          },
          "10110120": {
            "id": "10110120",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "（黑屏遮盖，和石头稍微拉开距离，变成钟离主角派蒙三人对话）",
            "nextDialogs": [
              "10110121"
            ]
          },
          "10110121": {
            "id": "10110121",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "喂！如果仪式只需要一种的话，全买下来不就白白浪费三倍的摩拉了吗？！"
          }
        }
      }
    },

          "10110721": {
            "id": "10110721",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "我要「二号夜泊石」。"
          }
        }
      }
    },
    {
      "subId": "101107",
      "subQuestName": "回璃月港找石头",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "10110731"
        ],
        "dialogs": {
          "10110731": {
            "id": "10110731",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "我要「三号夜泊石」。",
            "nextDialogs": [
              "10110732"
            ]
          },
          "10110732": {
            "id": "10110732",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "没错！我也记得是这块！",
            "nextDialogs": [
              "10110733"
            ]
          },
          "10110733": {
            "id": "10110733",
            "speakerId": 2054,
            "speakerName": "石头",
            "text": "没问题，既然看中了，老爷们就拿去吧。",
            "nextDialogs": [
              "10110771"
            ]
          },
          "10110771": {
            "id": "10110771",
            "speakerId": 10232,
            "speakerName": "钟离",
            "text": "嗯。「三号夜泊石」这个种类的，来一箱。",
            "nextDialogs": [
              "10110772"
            ]
          },
          "10110772": {
            "id": "10110772",
            "speakerId": 2054,
            "speakerName": "石头",
            "text": "好嘞！",
            "nextDialogs": [
              "10110734"
            ]
          },
          "10110734": {
            "id": "10110734",
            "speakerId": 2054,
            "speakerName": "石头",
            "text": "话说…别怪我多嘴，纯粹是好奇，各位老爷要这么多极品「夜泊石」，是有何贵干呐？",
            "nextDialogs": [
              "10110735"
            ]
          },
          "10110735": {
            "id": "10110735",
            "speakerId": 10232,
            "speakerName": "钟离",
            "text": "嗯…说也无妨。是制作「送仙典仪」的器具所用。",
            "nextDialogs": [
              "10110736"
            ]
          },
          "10110736": {
            "id": "10110736",
            "speakerId": 2054,
            "speakerName": "石头",
            "text": "「送仙」…？！呃，最近我也听过不少小道消息，可一直没敢太多过问。那，那就是，岩王爷他，确实…",
            "nextDialogs": [
              "10110737"
            ]
          },
          "10110737": {
            "id": "10110737",
            "speakerId": 2054,
            "speakerName": "石头",
            "text": "…唉，难以置信。虽然如今「解翠行」有些没落，但祖祖辈辈一直多亏岩王爷护佑。",
            "nextDialogs": [
              "10110738"
            ]
          },
          "10110738": {
            "id": "10110738",
            "speakerId": 2054,
            "speakerName": "石头",
            "text": "据说两百年前岩王爷微服下城南，迷路时品尝民间小吃，就是用「解翠行」的玉勺…",
            "nextDialogs": [
              "10110739"
            ]
          },
          "10110739": {
            "id": "10110739",
            "speakerId": 2054,
            "speakerName": "石头",
            "text": "俱往矣…俱往矣…唉，既然是跟岩王爷道别所用，那这箱「夜泊石」就只收半价吧。",
            "nextDialogs": [
              "10110740"
            ]
          },
          "10110740": {
            "id": "10110740",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "啊，这真的可以吗…明明老板之前还是一毛不拔的样子…",
            "nextDialogs": [
              "10110741"
            ]
          },
          "10110741": {
            "id": "10110741",
            "speakerId": 2054,
            "speakerName": "石头",
            "text": "没有岩王爷的保佑，就没有这「贸易之都」如今的模样。作为一个生意人，怎么能去赚这种钱…",
            "nextDialogs": [
              "10110742"
            ]
          },
          "10110742": {
            "id": "10110742",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "呜…老板，你的心意一定会传达给岩王爷的。",
            "nextDialogs": [
              "10110743"
            ]
          },
          "10110743": {
            "id": "10110743",
            "speakerId": 10232,
            "speakerName": "钟离",
            "text": "在「璃月七星」与各位脚踏实地的商人共同努力之下，想必璃月也会一如既往地繁荣下去。",
            "nextDialogs": [
              "10110744"
            ]
          },
          "10110744": {
            "id": "10110744",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "所以，打起精神来吧。",
            "nextDialogs": [
              "10110745"
            ]
          },
          "10110745": {
            "id": "10110745",
            "speakerId": 2054,
            "speakerName": "石头",
            "text": "好…好，谢谢几位老爷了。嗯，我这是怎么了，哭哭啼啼的，财运都要溜走了，哈哈。",
            "nextDialogs": [
              "10110746"
            ]
          },
          "10110746": {
            "id": "10110746",
            "speakerId": 10232,
            "speakerName": "钟离",
            "text": "既然挑选完毕，我们就带着「夜泊石」去…",
            "nextDialogs": [
              "10110747"
            ]
          },
          "10110747": {
            "id": "10110747",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "喂！等等，虽说是半价，但也不代表可以不付钱呀！",
            "nextDialogs": [
              "10110748"
            ]
          },
          "10110748": {
            "id": "10110748",
            "speakerId": 10232,
            "speakerName": "钟离",
            "text": "哦，不好意思，我又把付钱的事给忘了。让我看看…",
            "nextDialogs": [
              "10110749"
            ]
          },
          "10110749": {
            "id": "10110749",
            "speakerId": 10232,
            "speakerName": "钟离",
            "text": "…嗯…果然没带。",
            "nextDialogs": [
              "10110750"
            ]
          },
          "10110750": {
            "id": "10110750",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "没带什么？",
            "nextDialogs": [
              "10110751"
            ]
          },
          "10110751": {
            "id": "10110751",
            "speakerId": 10232,
            "speakerName": "钟离",
            "text": "没带摩拉。真是惭愧，又疏漏了。",
            "nextDialogs": [
              "10110754"
            ]
          },
          "10110754": {
            "id": "10110754",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "那可怎么办，这不是一笔小数目…啊，对了，「公子」似乎给过我们一笔垫付资金来着。",
            "nextDialogs": [
              "10110755"
            ]
          },
          "10110755": {
            "id": "10110755",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "在我身上。",
            "nextDialogs": [
              "10110756"
            ]
          },
          "10110756": {
            "id": "10110756",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "好在有这些钱，老板看看，够不够？",
            "nextDialogs": [
              "10110757"
            ]
          },
          "10110757": {
            "id": "10110757",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "【表现备注：主角递给老板钱】",
            "nextDialogs": [
              "10110758"
            ]
          },
          "10110758": {
            "id": "10110758",
            "speakerId": 2054,
            "speakerName": "石头",
            "text": "够了够了，半价的话，差不多正好…其实就算不够也没关系的。",
            "nextDialogs": [
              "10110759"
            ]
          },
          "10110759": {
            "id": "10110759",
            "speakerId": 10232,

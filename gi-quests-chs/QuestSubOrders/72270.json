    {
      "subId": "7227001",
      "subQuestName": "和封印前的残魂对话",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "722700101"
        ],
        "dialogs": {
          "722700101": {
            "id": "722700101",
            "speakerId": 20496,
            "speakerName": "大门",
            "text": "我乃末代地走官·大门。珊瑚宫之勇者，我认可你挑战的荣誉。",
            "nextDialogs": [
              "722700102"
            ]
          },
          "722700102": {
            "id": "722700102",
            "speakerId": 20496,
            "speakerName": "大门",
            "text": "勇武即是不择手段战胜一切敌人的能力。你只要打败所有敌人解放「高门之火」就可以了。",
            "nextDialogs": [
              "722700103"
            ]
          },
          "722700103": {
            "id": "722700103",
            "speakerId": 20496,
            "speakerName": "大门",
            "text": "顺带一提，此处的敌人皆是虚像。乃是阳炎幻法与你自己内心所知晓的强敌之印象互摄而成的。",
            "nextDialogs": [
              "722700104"
            ]
          },
          "722700104": {
            "id": "722700104",
            "speakerId": 20496,
            "speakerName": "大门",
            "text": "尽管如此，稍有不慎还是会受伤甚至被打垮的。",
            "nextDialogs": [
              "722700105"
            ]
          },
          "722700105": {
            "id": "722700105",
            "speakerId": 20496,
            "speakerName": "大门",
            "text": "我将在上方三界塔处等候你完成挑战。"
          }
        }
      }
    },
    {
      "subId": "7227002",
      "subQuestName": "解放所有「高门之火」",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "722700201"
        ],
        "dialogs": {
          "722700201": {
            "id": "722700201",
            "speakerId": 20496,
            "speakerName": "大门",
            "text": "珊瑚宫之勇者，已经完成了挑战吗？",
            "nextDialogs": [
              "722700202"
            ]
          },
          "722700202": {
            "id": "722700202",
            "speakerId": 20496,
            "speakerName": "大门",
            "text": "追求勇武，那就用尽一切手段打倒所有挡在面前的敌人就可以了。"
          }
        }
      }
    },
    {
      "subId": "7227003",
      "subQuestName": "解放所有「高门之火」",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "722700301"
        ],
        "dialogs": {
          "722700301": {
            "id": "722700301",
            "speakerId": 20496,
            "speakerName": "大门",
            "text": "漂亮漂亮！把一切强敌都粉碎了！",
            "nextDialogs": [
              "722700302"
            ]
          },
          "722700302": {
            "id": "722700302",
            "speakerId": 20496,
            "speakerName": "大门",
            "text": "如此威武，可称「常世无双」！我，末代地走官·大门，于此认可你的勇武。"
          }
        }
      }
    },
    {
      "subId": "7227004",
      "subQuestName": "解放所有「高门之火」",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "722700401"
        ],
        "dialogs": {
          "722700401": {
            "id": "722700401",
            "speakerId": 20495,
            "speakerName": "宇陀",
            "text": "我乃末代地走官·大门。虽然不知道你怎么来的，请回吧。"
          }
        }
      }
    },

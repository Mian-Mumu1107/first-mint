  "subQuests": [
    {
      "subId": "7167101",
      "subQuestName": "与刻晴和夜兰对话",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "716710101"
        ],
        "dialogs": {
          "716710101": {
            "id": "716710101",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "呃啊，不愧是夜兰都评价棘手的秘境，真的不一般呢…",
            "nextDialogs": [
              "716710102"
            ]
          },
          "716710102": {
            "id": "716710102",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "也不知道这个地脉紊乱点记录的都是什么战局…一般士兵真的能应付过来吗！",
            "nextDialogs": [
              "716710105"
            ]
          },
          "716710105": {
            "id": "716710105",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "唔…我猜，大概也没到…那么吓人的程度吧？",
            "nextDialogs": [
              "716710106"
            ]
          },
          "716710106": {
            "id": "716710106",
            "speakerId": 1016,
            "speakerName": "刻晴",
            "text": "你们回来了。",
            "nextDialogs": [
              "716710107"
            ]
          },
          "716710107": {
            "id": "716710107",
            "speakerId": 1048,
            "speakerName": "夜兰",
            "text": "嗯，神色从容，应该取得了不错的战果。",
            "nextDialogs": [
              "716710108"
            ]
          },
          "716710108": {
            "id": "716710108",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "也确实遇见了非常惊险的情况！",
            "nextDialogs": [
              "716710109"
            ]
          },
          "716710109": {
            "id": "716710109",
            "speakerId": 1003,
            "speakerName": "Black Screen",
            "text": "向刻晴和夜兰描述了其中的战况…",
            "nextDialogs": [
              "716710110"
            ]
          },
          "716710110": {
            "id": "716710110",
            "speakerId": 1016,
            "speakerName": "刻晴",
            "text": "原来如此…实在有劳你们了，干得漂亮！",
            "nextDialogs": [
              "716710111"
            ]
          },
          "716710111": {
            "id": "716710111",
            "speakerId": 1048,
            "speakerName": "夜兰",
            "text": "你们通过紊乱点造访秘境后，外溢的魔物显著减少了。",
            "nextDialogs": [
              "716710112"
            ]
          },
          "716710112": {
            "id": "716710112",
            "speakerId": 1048,
            "speakerName": "夜兰",
            "text": "虽然没能直接清除紊乱点，但的确有效削弱了它的活性。",
            "nextDialogs": [
              "716710113"
            ]
          },
          "716710113": {
            "id": "716710113",
            "speakerId": 1016,
            "speakerName": "刻晴",
            "text": "得益于此，魔物们的棘手程度大大降低，普通的千岩军战士也能将它们击退。"
          }
        }
      }
    }
  ]

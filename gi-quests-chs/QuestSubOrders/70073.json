  "subQuests": [
    {
      "subId": "7007302",
      "subQuestName": "(test)隐藏$HIDDEN",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "700730101"
        ],
        "dialogs": {
          "700730101": {
            "id": "700730101",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "我想和这个大家伙切磋。",
            "nextDialogs": [
              "700730102"
            ]
          },
          "700730102": {
            "id": "700730102",
            "speakerId": 1000,
            "speakerName": "摩答伐",
            "text": "善哉！吾主亦须时刻舒展神躯，落下的蕈片口感才会更美味！还请全力以赴，切莫手下留情！"
          }
        }
      }
    },
    {
      "subId": "7007303",
      "subQuestName": "(test)隐藏$HIDDEN",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "700730301"
        ],
        "dialogs": {
          "700730301": {
            "id": "700730301",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "这是什么玩意儿…？",
            "nextDialogs": [
              "700730302"
            ]
          },
          "700730302": {
            "id": "700730302",
            "speakerId": 1000,
            "speakerName": "摩答伐",
            "text": "善哉斯问！此为吾等所供奉的赐生世{RUBY#[S]比夫茏}尊神之嗣，道成正味之蕈子！",
            "nextDialogs": [
              "700730303"
            ]
          },
          "700730303": {
            "id": "700730303",
            "speakerId": 1000,
            "speakerName": "摩答伐",
            "text": "龙呼常念草木之主与花{RUBY#[D]浮槃婆梨袈}圃之主，玛卡尼哈冈总向赤砂之神祷告——汝可问问他们，那三位尊神，有哪一位比吾主更美味？",
            "nextDialogs": [
              "700730304"
            ]
          },
          "700730304": {
            "id": "700730304",
            "speakerId": 1000,
            "speakerName": "摩答伐",
            "text": "须知不害即是正业。若非吾主的神躯，吾等亦要取鸟兽草木之命以维生…呜呼，何等可哀！",
            "nextDialogs": [
              "700730305"
            ]
          },
          "700730305": {
            "id": "700730305",
            "speakerId": 1000,
            "speakerName": "摩答伐",
            "text": "所幸，空之主将吾带离大地时，吾主的耆{RUBY#[D]孢子}婆亦与吾同行。如是汝观，今已生长至此，赐吾等无上妙味。"
          }
        }
      }
    },
    {
      "subId": "7007301",
      "subQuestName": "(test)隐藏$HIDDEN",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [],
        "dialogs": {}
      }
    },
    {
      "subId": "7007302",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "700730201"
        ],
        "dialogs": {
          "700730201": {
            "id": "700730201",
            "speakerId": 1000,
            "speakerName": "摩答伐",
            "text": "吾主摩诃婆苏{RUBY#[D]赐生世尊之嗣}提婆耶弗啊，愿汝的耆婆{RUBY#[D]命根}提耶深入这岩地的基石，愿汝的美味胜过世间一切神明…"
          }
        }
      }
    },
    {
      "subId": "7007304",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "700730401"
        ],
        "dialogs": {
          "700730401": {
            "id": "700730401",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "不打扰了。",
            "nextDialogs": [
              "700730402"
            ]
          },
          "700730402": {
            "id": "700730402",
            "speakerId": 1000,
            "speakerName": "摩答伐",
            "text": "随意所往，蕈自护持。"
          }
        }
      }
    },

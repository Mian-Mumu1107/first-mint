    {
      "subId": "7302004",
      "subQuestName": "解除死域，采摘「一头菇」",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "730200401"
        ],
        "dialogs": {
          "730200401": {
            "id": "730200401",
            "speakerId": 1001,
            "speakerName": "兰茶荼",
            "text": "采到了「一头菇」，完成了烹饪修行，认识了高大又可靠的那菈。真是开心。",
            "nextDialogs": [
              "730200402"
            ]
          },
          "730200402": {
            "id": "730200402",
            "speakerId": 1001,
            "speakerName": "兰茶荼",
            "text": "#兰帕卡提、兰萨卡、兰阿帕斯、兰非拉一定也会感谢你的。那菈{NICKNAME}，你是个好那菈。",
            "nextDialogs": [
              "730200403"
            ]
          },
          "730200403": {
            "id": "730200403",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "感谢我？为什么？",
            "nextDialogs": [
              "730200404"
            ]
          },
          "730200404": {
            "id": "730200404",
            "speakerId": 1001,
            "speakerName": "兰茶荼",
            "text": "当然是因为，通过帮助我，给了他们品尝「一头菇」的机会。"
          }
        }
      }
    },

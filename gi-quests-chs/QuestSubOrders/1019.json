    {
      "subId": "101902",
      "subQuestName": "与烟绯对话",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "10190201"
        ],
        "dialogs": {
          "10190201": {
            "id": "10190201",
            "speakerId": 1030,
            "speakerName": "烟绯",
            "text": "#{NICKNAME}和派蒙？真没想到会在这种地方遇到你们。",
            "nextDialogs": [
              "10190202"
            ]
          },
          "10190202": {
            "id": "10190202",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "竟然是烟绯？你一般不是在璃月港里工作吗？怎么跑到这种鸟不拉屎的地方来了。",
            "nextDialogs": [
              "10190203"
            ]
          },
          "10190203": {
            "id": "10190203",
            "speakerId": 1030,
            "speakerName": "烟绯",
            "text": "嗯，说实话，这趟工作确实有点特别…层岩巨渊最下面原来长这样，我也是第一次见。",
            "nextDialogs": [
              "10190204"
            ]
          },
          "10190204": {
            "id": "10190204",
            "speakerId": 1030,
            "speakerName": "烟绯",
            "text": "啊不对！两位帮我个忙吧，有人在找我，如果他们问起，你就说没见过我！",
            "nextDialogs": [
              "10190205"
            ]
          },
          "10190205": {
            "id": "10190205",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "哎？什么意思？",
            "nextDialogs": [
              "10190208"
            ]
          },
          "10190208": {
            "id": "10190208",
            "speakerId": 1030,
            "speakerName": "烟绯",
            "text": "那可不是，这件事说来话长了。",
            "nextDialogs": [
              "10190209"
            ]
          },
          "10190209": {
            "id": "10190209",
            "speakerId": 1030,
            "speakerName": "烟绯",
            "text": "总之，搪塞的事就交给你们啦，一会儿见。",
            "nextDialogs": [
              "10190210"
            ]
          },
          "10190210": {
            "id": "10190210",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "喂，烟绯她真的走了…怎么办呀，我突然好害怕…",
            "nextDialogs": [
              "10190211"
            ]
          },
          "10190211": {
            "id": "10190211",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "你说，她该不会是犯了什么法，才逃到这里来的吧？会不会是…什么很恐怖的事情…",
            "nextDialogs": [
              "10190212"
            ]
          },
          "10190212": {
            "id": "10190212",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "不会吧，烟绯可是律法咨询师。",
            "nextDialogs": [
              "10190213"
            ]
          },
          "10190213": {
            "id": "10190213",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "不要太天真哦！这个社会可是很复杂的，先做好最坏打算，万一真有什么事，我们就成她的共犯了！",
            "nextDialogs": [
              "10190214"
            ]
          },
          "10190214": {
            "id": "10190214",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "唔唔，要不要袒护她呢…好纠结…",
            "nextDialogs": [
              "10190215"
            ]
          },
          "10190215": {
            "id": "10190215",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "派蒙，真是又复杂又天真。",
            "nextDialogs": [
              "10190216"
            ]
          },
          "10190216": {
            "id": "10190216",
            "speakerId": 1044,
            "speakerName": "荒泷一斗",
            "text": "喂！喂那边的家伙！",
            "nextDialogs": [
              "10190217"
            ]
          },
          "10190217": {
            "id": "10190217",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "啊！来了，有人来了！",
            "nextDialogs": [
              "10190218"
            ]
          },
          "10190218": {
            "id": "10190218",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "不过这个声音，好像在哪里听过…",
            "nextDialogs": [
              "10190219"
            ]
          },
          "10190219": {
            "id": "10190219",
            "speakerId": 1044,
            "speakerName": "荒泷一斗",
            "text": "哈哈，居然是你们俩，跑到这种地方来度假吗？",
            "nextDialogs": [
              "10190220"
            ]
          },
          "10190220": {
            "id": "10190220",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "居然是一斗。",
            "nextDialogs": [
              "10190221"
            ]
          },
          "10190221": {
            "id": "10190221",
            "speakerId": 1044,
            "speakerName": "荒泷一斗",
            "text": "噢！看你们的样子，最近应该过得不错吧？我也是哦，哈哈哈哈。",
            "nextDialogs": [
              "10190222"
            ]
          },
          "10190222": {
            "id": "10190222",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "你后面那个人是…？",
            "nextDialogs": [
              "10190223"
            ]
          },
          "10190223": {
            "id": "10190223",
            "speakerId": 1049,
            "speakerName": "久岐忍",
            "text": "你们好啊，我是荒泷派成员久岐忍。",
            "nextDialogs": [
              "10190224"
            ]
          },
          "10190224": {
            "id": "10190224",
            "speakerId": 1044,
            "speakerName": "荒泷一斗",
            "text": "啊哈哈，差点忘了，来来给你们介绍一下，这位是我们荒泷派最厉害的人，阿忍！",
            "nextDialogs": [
              "10190225"
            ]
          },
          "10190225": {
            "id": "10190225",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "哦哦！原来也是荒泷派的人呀！",
            "nextDialogs": [
              "10190226"
            ]
          },
          "10190226": {
            "id": "10190226",
            "speakerId": 1044,
            "speakerName": "荒泷一斗",
            "text": "在花见坂混的厉害人物，肯定要加入我们荒泷派啊。平时帮里的事都是阿忍摆平，也让她罩着你们好了。",
            "nextDialogs": [
              "10190227"
            ]
          },
          "10190227": {
            "id": "10190227",
            "speakerId": 1049,
            "speakerName": "久岐忍",
            "text": "#老大的朋友就是我的朋友，很高兴认识二位，{NICKNAME}，派蒙。",
            "nextDialogs": [
              "10190228"
            ]
          },
          "10190228": {
            "id": "10190228",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "很上道嘛！那我就叫你阿忍啦！",
            "nextDialogs": [
              "10190229"
            ]
          },
          "10190229": {
            "id": "10190229",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "很高兴认识你，阿忍。",
            "nextDialogs": [
              "10190230"
            ]
          },
          "10190230": {
            "id": "10190230",
            "speakerId": 1049,
            "speakerName": "久岐忍",
            "text": "嗯，以后请多关照。其实我有预感…说不定最近就要你们关照了。",
            "nextDialogs": [
              "10190231"
            ]
          },
          "10190231": {
            "id": "10190231",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "不过一斗，你刚才说，你们帮派的事都是她在摆平？那其实她才是老大吧？",
            "nextDialogs": [
              "10190232"
            ]
          },
          "10190232": {
            "id": "10190232",
            "speakerId": 1044,
            "speakerName": "荒泷一斗",
            "text": "派蒙，你在说什么傻话，老大是我啊。天上地下花见坂荒泷派，从来只有我一个老大！",
            "nextDialogs": [
              "10190233"
            ]
          },
          "10190233": {
            "id": "10190233",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "我懂了，是没用的老大和厉害的部下…",
            "nextDialogs": [
              "10190234"
            ]
          },
          "10190234": {
            "id": "10190234",
            "speakerId": 1044,
            "speakerName": "荒泷一斗",
            "text": "喂！唉，算了，凭你这个小脑瓜想不明白也正常，本大爷不跟你一般见识。",
            "nextDialogs": [
              "10190235"
            ]
          },
          "10190235": {
            "id": "10190235",
            "speakerId": 1044,
            "speakerName": "荒泷一斗",
            "text": "言归正传，你们有没有见过一个粉色的律…律什么什么法师？反正就是个懂很多的人，个子不高，戴着顶怪帽子。",
            "nextDialogs": [
              "10190236"
            ]
          },
          "10190236": {
            "id": "10190236",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "咿…！",
            "nextDialogs": [
              "10190237"
            ]
          },
          "10190237": {
            "id": "10190237",
            "speakerId": 1049,
            "speakerName": "久岐忍",
            "text": "是一位来自璃月的律法咨询师，名叫烟绯。我猜，二位或许认识。",
            "nextDialogs": [
              "10190238"
            ]
          },
          "10190238": {
            "id": "10190238",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "没、没见过哦！也从来不认识！"
          }
        }
      }
    },
    {
      "subId": "101903",
      "subQuestName": "前往层岩巨渊深处",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "10190301"
        ],
        "dialogs": {
          "10190301": {
            "id": "10190301",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "你看，烟绯正好也在那里！",
            "nextDialogs": [
              "10190302"
            ]
          },
          "10190302": {
            "id": "10190302",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "烟绯，那些追你的人被我们支开了哦。",
            "nextDialogs": [
              "10190303"
            ]
          },
          "10190303": {
            "id": "10190303",
            "speakerId": 1030,
            "speakerName": "烟绯",
            "text": "太好了，多亏你们。那位打扮花哨的大哥可真热情，要是平时应该能交个朋友，可惜我今天有正事要办。",
            "nextDialogs": [
              "10190304"
            ]
          },
          "10190304": {
            "id": "10190304",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "唔…什么正事需要在这种怪地方办啊，该不会你也想转行当冒险家了吧？",
            "nextDialogs": [
              "10190305"
            ]
          },
          "10190305": {
            "id": "10190305",
            "speakerId": 1030,
            "speakerName": "烟绯",
            "text": "我是律法咨询师，偶尔也会遇到这种不得不亲自出远门的情况。这次来层岩巨渊，是因为一份「遗嘱」。",
            "nextDialogs": [
              "10190306"
            ]
          },
          "10190306": {
            "id": "10190306",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "遗嘱…？",
            "nextDialogs": [
              "10190307"
            ]
          },
          "10190307": {
            "id": "10190307",
            "speakerId": 1030,
            "speakerName": "烟绯",
            "text": "嗯。我在一本古书中找到一份遗嘱，应该是从前的某位高人所留。他有一件法宝失踪了，想找回来。",
            "nextDialogs": [
              "10190308"
            ]
          },
          "10190308": {
            "id": "10190308",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "这种事竟然也要律法咨询师做啊，真辛苦呢。",
            "nextDialogs": [
              "10190309"
            ]
          },
          "10190309": {
            "id": "10190309",
            "speakerId": 1030,
            "speakerName": "烟绯",
            "text": "代为执行遗嘱也是律法咨询师工作的一环，当然啦，像这样的情况确实不多见。层岩巨渊也不是想来就来的。",
            "nextDialogs": [
              "10190310"
            ]
          },
          "10190310": {
            "id": "10190310",
            "speakerId": 10205,
            "speakerName": "？？？",
            "text": "哦？原来你知道啊。",
            "nextDialogs": [
              "10190311"
            ]
          },
          "10190311": {
            "id": "10190311",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "噫！谁呀！",
            "nextDialogs": [
              "10190312"
            ]
          },
          "10190312": {
            "id": "10190312",
            "speakerId": 1030,
            "speakerName": "烟绯",
            "text": "哎呀，你在啊？果然被我猜对了。",
            "nextDialogs": [
              "10190313"
            ]
          },
          "10190313": {
            "id": "10190313",
            "speakerId": 10205,
            "speakerName": "？？？",
            "text": "大律法咨询师到层岩巨渊来办事，哪里需要请示我的意见。",
            "nextDialogs": [
              "10190314"
            ]
          },
          "10190314": {
            "id": "10190314",
            "speakerId": 1030,
            "speakerName": "烟绯",
            "text": "有夜兰在的地方，我说话可不算数，对吧？",
            "nextDialogs": [
              "10190315"
            ]
          },
          "10190315": {
            "id": "10190315",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "她、她是谁啊！",
            "nextDialogs": [
              "10190316"
            ]
          },
          "10190316": {
            "id": "10190316",
            "speakerId": 1030,
            "speakerName": "烟绯",
            "text": "这位是夜兰，璃月的…唔，我能说你就职于总务司吗？总之，是我的一位朋友。",
            "nextDialogs": [
              "10190317"
            ]
          },
          "10190317": {
            "id": "10190317",
            "speakerId": 1048,
            "speakerName": "夜兰",
            "text": "可以啊。刚巧，最近我也在这一带有事要办，与各位算是小有缘分。",
            "nextDialogs": [
              "10190318"
            ]
          },
          "10190318": {
            "id": "10190318",
            "speakerId": 1048,
            "speakerName": "夜兰",
            "text": "旅行者和派蒙或许不认识我，我对你们倒是有所耳闻。",
            "nextDialogs": [
              "10190319"
            ]
          },
          "10190319": {
            "id": "10190319",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "见笑了，我在璃月朋友太多…",
            "nextDialogs": [
              "10190320"
            ]
          },
          "10190320": {
            "id": "10190320",
            "speakerId": 1048,
            "speakerName": "夜兰",
            "text": "几位来这里办事，我的工作则是监察层岩巨渊。依照规章，我理应陪同。",
            "nextDialogs": [
              "10190321"
            ]
          },
          "10190321": {
            "id": "10190321",
            "speakerId": 1048,
            "speakerName": "夜兰",
            "text": "但这次我另有要务在身，怕是无法全程跟随了，几位自便，不要搞出什么大动作就好。",
            "nextDialogs": [
              "10190322"
            ]
          },
          "10190322": {
            "id": "10190322",
            "speakerId": 1030,
            "speakerName": "烟绯",
            "text": "糟糕，我还想请你帮忙的呢…",
            "nextDialogs": [
              "10190323"
            ]
          },
          "10190323": {
            "id": "10190323",
            "speakerId": 1030,
            "speakerName": "烟绯",
            "text": "看在往日交情的份上，你能不能稍微抽点时间帮我搞定这份遗嘱？",
            "nextDialogs": [
              "10190324"
            ]
          },
          "10190324": {
            "id": "10190324",
            "speakerId": 1048,
            "speakerName": "夜兰",
            "text": "求我可是要拿出诚意的。",
            "nextDialogs": [
              "10190325"
            ]
          },
          "10190325": {
            "id": "10190325",
            "speakerId": 1030,
            "speakerName": "烟绯",
            "text": "好说，请导游也要付钱的嘛，刚巧萍姥姥给了我一些好茶叶，不嫌弃的话，让我请你喝杯茶吧。",
            "nextDialogs": [
              "10190326"
            ]
          },
          "10190326": {
            "id": "10190326",
            "speakerId": 1048,
            "speakerName": "夜兰",
            "text": "呵呵，不如先说说你来此地的详情，我才…",
            "nextDialogs": [
              "10190327"
            ]
          },
          "10190327": {
            "id": "10190327",
            "speakerId": 10205,
            "speakerName": "？？？",
            "text": "喂！你们！",
            "nextDialogs": [
              "10190328"
            ]
          },
          "10190328": {
            "id": "10190328",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "一斗怎么回来了啊！",
            "nextDialogs": [
              "10190329"
            ]
          },
          "10190329": {
            "id": "10190329",
            "speakerId": 1044,
            "speakerName": "荒泷一斗",
            "text": "#好啊你们，故意支开我是吧！我说{NICKNAME}，你怎么不向着你的兄弟我了？",
            "nextDialogs": [
              "10190330"
            ]
          },
          "10190330": {
            "id": "10190330",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "因为这边也是我的朋友嘛…",
            "nextDialogs": [
              "10190331"
            ]
          },
          "10190331": {
            "id": "10190331",
            "speakerId": 1048,
            "speakerName": "夜兰",
            "text": "留步。",
            "nextDialogs": [
              "10190332"
            ]
          },
          "10190332": {
            "id": "10190332",
            "speakerId": 1044,
            "speakerName": "荒泷一斗",
            "text": "嗯？你谁啊？",
            "nextDialogs": [
              "10190333"
            ]
          },
          "10190333": {
            "id": "10190333",
            "speakerId": 1048,
            "speakerName": "夜兰",
            "text": "抱歉，这一带都属于层岩重地，外人还请止步。",
            "nextDialogs": [
              "10190334"
            ]
          },
          "10190334": {
            "id": "10190334",
            "speakerId": 1044,
            "speakerName": "荒泷一斗",
            "text": "开什么玩笑，你这里又没个告示围栏，还不让人走路了？",
            "nextDialogs": [
              "10190335"
            ]
          },
          "10190335": {
            "id": "10190335",
            "speakerId": 1048,
            "speakerName": "夜兰",
            "text": "真正危险的地方，不会有任何引起注意的告示。",
            "nextDialogs": [
              "10190336"
            ]
          },
          "10190336": {
            "id": "10190336",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "原来这里是这么重要的地方啊！",
            "nextDialogs": [
              "10190337"
            ]
          },
          "10190337": {
            "id": "10190337",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "的确是个特殊的地方…",
            "nextDialogs": [
              "10190338"
            ]
          },
          "10190338": {
            "id": "10190338",
            "speakerId": 1030,
            "speakerName": "烟绯",
            "text": "这里确实不是能随便出入的地方，我也是因为这一点，才不想让两位跟着。只可惜，我的拒绝没什么用…",
            "nextDialogs": [
              "10190339"
            ]
          },
          "10190339": {
            "id": "10190339",
            "speakerId": 1048,
            "speakerName": "夜兰",
            "text": "旅行者帮过璃月许多，烟绯是璃月知名的律法咨询师，我信得过二位的立场和行为，没有阻拦你们在这一带活动。至于这两位…",
            "nextDialogs": [
              "10190340"
            ]
          },
          "10190340": {
            "id": "10190340",
            "speakerId": 1044,
            "speakerName": "荒泷一斗",
            "text": "你什么意思？觉得我没名气，还是觉得我不怀好意？",
            "nextDialogs": [
              "10190341"
            ]
          },
          "10190341": {
            "id": "10190341",
            "speakerId": 1048,
            "speakerName": "夜兰",
            "text": "正因为不清楚你的底细，才不能让你随便行动。再说烟绯的态度怎么看都不像是需要你帮忙，对吧？",
            "nextDialogs": [
              "10190342"
            ]
          },
          "10190342": {
            "id": "10190342",
            "speakerId": 1044,
            "speakerName": "荒泷一斗",
            "text": "哈！你怎么知道？你是她肚子里的蛔虫？",
            "nextDialogs": [
              "10190343"
            ]
          },
          "10190343": {
            "id": "10190343",
            "speakerId": 1048,
            "speakerName": "夜兰",
            "text": "哦？这不是一目了然的事吗？倒是你，身为稻妻来客，还是入乡随俗，按当地规矩办事比较好哦。",
            "nextDialogs": [
              "10190344"
            ]
          },
          "10190344": {
            "id": "10190344",
            "speakerId": 1044,
            "speakerName": "荒泷一斗",
            "text": "你…！",
            "nextDialogs": [
              "10190345"
            ]
          },
          "10190345": {
            "id": "10190345",
            "speakerId": 1049,
            "speakerName": "久岐忍",
            "text": "别冲动，她说的是实话。",
            "nextDialogs": [
              "10190346"
            ]
          },
          "10190346": {
            "id": "10190346",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "呃啊，怎么吵起来了…",
            "nextDialogs": [
              "10190347"
            ]
          },
          "10190347": {
            "id": "10190347",
            "speakerId": 1030,
            "speakerName": "烟绯",
            "text": "麻烦了…他不该跟夜兰硬碰硬的。",
            "nextDialogs": [
              "10190348"
            ]
          },
          "10190348": {
            "id": "10190348",
            "speakerId": 1049,
            "speakerName": "久岐忍",
            "text": "我们不知道这里性质特殊，既然您这么说，我们会尽快离开。不过要真是危险地区，最好还是立个告示牌吧。",
            "nextDialogs": [
              "10190349"
            ]
          },
          "10190349": {
            "id": "10190349",
            "speakerId": 1048,
            "speakerName": "夜兰",
            "text": "感谢你的意见，我会考虑的。",
            "nextDialogs": [
              "10190350"
            ]
          },
          "10190350": {
            "id": "10190350",
            "speakerId": 1044,
            "speakerName": "荒泷一斗",
            "text": "如果我们不打算马上就走呢？",
            "nextDialogs": [
              "10190351"
            ]
          },
          "10190351": {
            "id": "10190351",
            "speakerId": 1049,
            "speakerName": "久岐忍",
            "text": "老大！",
            "nextDialogs": [
              "10190352"
            ]
          },
          "10190352": {
            "id": "10190352",
            "speakerId": 1048,
            "speakerName": "夜兰",
            "text": "那恐怕就会发生不愉快的事了。",
            "nextDialogs": [
              "10190353"
            ]
          },
          "10190353": {
            "id": "10190353",
            "speakerId": 1044,
            "speakerName": "荒泷一斗",
            "text": "啊？意思是你能打赢我们两个？你很自信嘛。",
            "nextDialogs": [
              "10190354"
            ]
          },
          "10190354": {
            "id": "10190354",
            "speakerId": 1048,
            "speakerName": "夜兰",
            "text": "二位虽是旅行者和烟绯的朋友，最好也能听懂我的警告。",
            "nextDialogs": [
              "10190355"
            ]
          },
          "10190355": {
            "id": "10190355",
            "speakerId": 1044,
            "speakerName": "荒泷一斗",
            "text": "哈哈…有意思，只可惜本大爷不服管。既然你这么厉害，就让本大爷见识见识你的本事啊！",
            "nextDialogs": [
              "10190356"
            ]
          },
          "10190356": {
            "id": "10190356",
            "speakerId": 1049,
            "speakerName": "久岐忍",
            "text": "等等，没必要在这里起冲突！",
            "nextDialogs": [
              "10190357"
            ]
          },
          "10190357": {
            "id": "10190357",
            "speakerId": 1044,
            "speakerName": "荒泷一斗",
            "text": "不，我就是要往里走，她能把我怎么样？",
            "nextDialogs": [
              "10190358"
            ]
          },
          "10190358": {
            "id": "10190358",
            "speakerId": 1048,
            "speakerName": "夜兰",
            "text": "呵呵…觉得我喜欢开玩笑？",
            "nextDialogs": [
              "10190359"
            ]
          },
          "10190359": {
            "id": "10190359",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "糟了，他们两个要打起来了！",
            "nextDialogs": [
              "10190360"
            ]
          },
          "10190360": {
            "id": "10190360",
            "speakerId": 1030,
            "speakerName": "烟绯",
            "text": "二位稍等一下。此事因我而起，不如给我一个面子…哎？",
            "nextDialogs": [
              "10190361"
            ]
          },
          "10190361": {
            "id": "10190361",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "（地面…在摇晃？！）",
            "nextDialogs": [
              "10190362"
            ]
          },
          "10190362": {
            "id": "10190362",
            "speakerId": 1030,
            "speakerName": "烟绯",
            "text": "不好，这里似乎…啊！",
            "nextDialogs": [
              "10190363"
            ]
          },
          "10190363": {
            "id": "10190363",
            "speakerId": 1044,
            "speakerName": "荒泷一斗",
            "text": "别扯开话题！我可是…嗯？"
          }
        }
      }
    },
    {
      "subId": "101904",
      "subQuestName": "与大家一起讨论",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "10190401"
        ],
        "dialogs": {
          "10190401": {
            "id": "10190401",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "痛痛痛…",
            "nextDialogs": [
              "10190402"
            ]
          },
          "10190402": {
            "id": "10190402",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "#怎么搞的啊！喂，{NICKNAME}，你没事吧？",
            "nextDialogs": [
              "10190405"
            ]
          },
          "10190405": {
            "id": "10190405",
            "speakerId": 1030,
            "speakerName": "烟绯",
            "text": "呃…把书垫在屁股底下也不抗摔呀…",
            "nextDialogs": [
              "10190406"
            ]
          },
          "10190406": {
            "id": "10190406",
            "speakerId": 1048,
            "speakerName": "夜兰",
            "text": "这是…",
            "nextDialogs": [
              "10190407"
            ]
          },
          "10190407": {
            "id": "10190407",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "这、这是什么地方啊…",
            "nextDialogs": [
              "10190408"
            ]
          },
          "10190408": {
            "id": "10190408",
            "speakerId": 1044,
            "speakerName": "荒泷一斗",
            "text": "疼疼疼…喂阿忍！还有我的兄弟！恩人！没事吧！",
            "nextDialogs": [
              "10190409"
            ]
          },
          "10190409": {
            "id": "10190409",
            "speakerId": 1049,
            "speakerName": "久岐忍",
            "text": "呼…真是飞来横祸。",
            "nextDialogs": [
              "10190410"
            ]
          },
          "10190410": {
            "id": "10190410",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "喂，我们到底是掉到多深的地方来了？",
            "nextDialogs": [
              "10190411"
            ]
          },
          "10190411": {
            "id": "10190411",
            "speakerId": 1048,
            "speakerName": "夜兰",
            "text": "……",
            "nextDialogs": [
              "10190412"
            ]
          },
          "10190412": {
            "id": "10190412",
            "speakerId": 1048,
            "speakerName": "夜兰",
            "text": "看来在刚才的对峙中，地面坍塌了。难道是因为催动了元素力…",
            "nextDialogs": [
              "10190413"
            ]
          },
          "10190413": {
            "id": "10190413",
            "speakerId": 1044,
            "speakerName": "荒泷一斗",
            "text": "可不是本大爷的错啊。你说话这么不客气，谁听了都会发火。",
            "nextDialogs": [
              "10190414"
            ]
          },
          "10190414": {
            "id": "10190414",
            "speakerId": 1048,
            "speakerName": "夜兰",
            "text": "我的工作就是阻止外人乱闯重地。假如实话实说也算不客气…你的心智未免有些脆弱了。",
            "nextDialogs": [
              "10190415"
            ]
          },
          "10190415": {
            "id": "10190415",
            "speakerId": 1044,
            "speakerName": "荒泷一斗",
            "text": "你…人活一口气，我就是不喜欢让步！",
            "nextDialogs": [
              "10190416"
            ]
          },
          "10190416": {
            "id": "10190416",
            "speakerId": 1049,
            "speakerName": "久岐忍",
            "text": "老大，你根本说不过她，干嘛非要跟她吵？",
            "nextDialogs": [
              "10190417"
            ]
          },
          "10190417": {
            "id": "10190417",
            "speakerId": 1044,
            "speakerName": "荒泷一斗",
            "text": "阿忍，你帮哪头的啊？",
            "nextDialogs": [
              "10190418"
            ]
          },
          "10190418": {
            "id": "10190418",
            "speakerId": 1049,
            "speakerName": "久岐忍",
            "text": "点明现状而已。虽然理解你的心情，但你没事就跟人起冲突也是在给我添麻烦。",
            "nextDialogs": [
              "10190419"
            ]
          },
          "10190419": {
            "id": "10190419",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "我发现了，一斗既吵不过夜兰，也说不过阿忍，他在这里很弱势…",
            "nextDialogs": [
              "10190420"
            ]
          },
          "10190420": {
            "id": "10190420",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "一斗和阿忍就像你和我。",
            "nextDialogs": [
              "10190421"
            ]
          },
          "10190421": {
            "id": "10190421",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "呜哇好生气啊！不要把我跟一斗相提并论！",
            "nextDialogs": [
              "10190422"
            ]
          },
          "10190422": {
            "id": "10190422",
            "speakerId": 1044,
            "speakerName": "荒泷一斗",
            "text": "喂喂喂这话是什么意思啊，找茬是吧你！",
            "nextDialogs": [
              "10190423"
            ]
          },
          "10190423": {
            "id": "10190423",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "我、我说的可是实话，你是笨蛋大家都知道。",
            "nextDialogs": [
              "10190424"
            ]
          },
          "10190424": {
            "id": "10190424",
            "speakerId": 1044,
            "speakerName": "荒泷一斗",
            "text": "我是笨蛋？那你是飞行矮堇瓜。",
            "nextDialogs": [
              "10190425"
            ]
          },
          "10190425": {
            "id": "10190425",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "飞行矮堇瓜？！呜，气死我了…我要给你起个难听的外号…就叫你放牛的！哼，放牛的，你很狂嘛。",
            "nextDialogs": [
              "10190426"
            ]
          },
          "10190426": {
            "id": "10190426",
            "speakerId": 1030,
            "speakerName": "烟绯",
            "text": "我们离掉下来的破洞似乎很远，根本看不到顶上的情况。",
            "nextDialogs": [
              "10190427"
            ]
          },
          "10190427": {
            "id": "10190427",
            "speakerId": 1048,
            "speakerName": "夜兰",
            "text": "这种距离，看来是没法直接上去了，得另外找出路。",
            "nextDialogs": [
              "10190428"
            ]
          },
          "10190428": {
            "id": "10190428",
            "speakerId": 1048,
            "speakerName": "夜兰",
            "text": "各位，抱歉打扰你们聊天的雅兴，有些事你们或许得知道一下。",
            "nextDialogs": [
              "10190429"
            ]
          },
          "10190429": {
            "id": "10190429",
            "speakerId": 1048,
            "speakerName": "夜兰",
            "text": "层岩巨渊在璃月算得上神秘地区，前些年因矿区事故而被封锁。在这里行动，最好学会不看、不听，不问，以免涉及太多各位不该了解的秘密。",
            "nextDialogs": [
              "10190430"
            ]
          },
          "10190430": {
            "id": "10190430",
            "speakerId": 1048,
            "speakerName": "夜兰",
            "text": "原则上我不会与大家为敌，也希望大家别在保密问题上为难我。至于出路，我会尽力。",
            "nextDialogs": [
              "10190431"
            ]
          },
          "10190431": {
            "id": "10190431",
            "speakerId": 1044,
            "speakerName": "荒泷一斗",
            "text": "欸？她怎么走了？",
            "nextDialogs": [
              "10190432"
            ]
          },
          "10190432": {
            "id": "10190432",
            "speakerId": 1030,
            "speakerName": "烟绯",
            "text": "是去找出口了吧。夜兰她可能是我们之中最懂得应对危机的人，就让她去吧。",
            "nextDialogs": [
              "10190433"
            ]
          },
          "10190433": {
            "id": "10190433",
            "speakerId": 1030,
            "speakerName": "烟绯",
            "text": "非常抱歉，一般来说我不会向无关人士透露委托人遗嘱的内容，所以没能跟二位说实话…对不起。",
            "nextDialogs": [
              "10190434"
            ]
          },
          "10190434": {
            "id": "10190434",
            "speakerId": 1030,
            "speakerName": "烟绯",
            "text": "我来层岩巨渊，是想找回遗嘱中提到的太威仪盘。许多年前，我的委托人将这一法宝交给有志之士，希望这件宝贝能在需要它的地方发挥作用。",
            "nextDialogs": [
              "10190435"
            ]
          },
          "10190435": {
            "id": "10190435",
            "speakerId": 1030,
            "speakerName": "烟绯",
            "text": "而据目击者说，那个接收法宝的人带着它往层岩巨渊去了，此后便下落不明。",
            "nextDialogs": [
              "10190436"
            ]
          },
          "10190436": {
            "id": "10190436",
            "speakerId": 1030,
            "speakerName": "烟绯",
            "text": "历史上，层岩巨渊一带曾发生过多次战争，可就算那个人在战争中死去，我也希望能竭我所能寻回法宝，圆委托人一个心愿。",
            "nextDialogs": [
              "10190437"
            ]
          },
          "10190437": {
            "id": "10190437",
            "speakerId": 1030,
            "speakerName": "烟绯",
            "text": "至于先前夜兰说的，也都是实话，层岩巨渊暗藏危机…你们应该也体会到了。现在遇到这种麻烦，我想，我们就一起想办法出去吧。",
            "nextDialogs": [
              "10190438"
            ]
          },
          "10190438": {
            "id": "10190438",
            "speakerId": 1044,
            "speakerName": "荒泷一斗",
            "text": "既然恩人这么说…好，这个面子我卖了。现在开始大家都是同伴，至于那个臭屁的家伙…哼，也算上好了。",
            "nextDialogs": [
              "10190439"
            ]
          },
          "10190439": {
            "id": "10190439",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "夜兰不是在总务司工作吗？总觉得她是个很厉害的人…没想到做这行需要这么大本事。",
            "nextDialogs": [
              "10190440"
            ]
          },
          "10190440": {
            "id": "10190440",
            "speakerId": 1030,
            "speakerName": "烟绯",
            "text": "唔，对外好像是这么说没错…关于她的身份，我不便透露太多，只能说，这份工作非她莫属。",
            "nextDialogs": [
              "10190441"
            ]
          },
          "10190441": {
            "id": "10190441",
            "speakerId": 1044,
            "speakerName": "荒泷一斗",
            "text": "什么工作啊，竟然要在这种鸟不拉屎的地方上班？",
            "nextDialogs": [
              "10190442"
            ]
          },
          "10190442": {
            "id": "10190442",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "这个我熟！冒险家呀！",
            "nextDialogs": [
              "10190443"
            ]
          },
          "10190443": {
            "id": "10190443",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "？",
            "nextDialogs": [
              "10190444"
            ]
          },
          "10190444": {
            "id": "10190444",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "怎么了那副表情？我又没说错，你我不就是这样的吗？",
            "nextDialogs": [
              "10190445"
            ]
          },
          "10190445": {
            "id": "10190445",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "冒险家是我，不是派蒙。",
            "nextDialogs": [
              "10190446"
            ]
          },
          "10190446": {
            "id": "10190446",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "你最近变得小气了呢，让我蹭蹭名头怎么了嘛。",
            "nextDialogs": [
              "10190447"
            ]
          },
          "10190447": {
            "id": "10190447",
            "speakerId": 1044,
            "speakerName": "荒泷一斗",
            "text": "#对啊{NICKNAME}，你是派蒙的老大，老大要有气量，应该多让小弟沾光。",
            "nextDialogs": [
              "10190448"
            ]
          },
          "10190448": {
            "id": "10190448",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "我们不是这种关系！",
            "nextDialogs": [
              "10190449"
            ]
          },
          "10190449": {
            "id": "10190449",
            "speakerId": 1049,
            "speakerName": "久岐忍",
            "text": "派蒙，老大说的话听听就好，不用往心里去哦。",
            "nextDialogs": [
              "10190450"
            ]
          },
          "10190450": {
            "id": "10190450",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "哼，看在阿忍的份上…好吧。",
            "nextDialogs": [
              "10190451"
            ]
          },
          "10190451": {
            "id": "10190451",
            "speakerId": 1044,
            "speakerName": "荒泷一斗",
            "text": "我…唉，我是老大，我让着你们。",
            "nextDialogs": [
              "10190452"
            ]
          },
          "10190452": {
            "id": "10190452",
            "speakerId": 1048,
            "speakerName": "夜兰",
            "text": "……",
            "nextDialogs": [
              "10190453"
            ]
          },
          "10190453": {
            "id": "10190453",
            "speakerId": 1048,
            "speakerName": "夜兰",
            "text": "我们所在的，难道是没有卷宗记录的另一处封印……这里会有什么呢？",
            "nextDialogs": [
              "10190454"
            ]
          },
          "10190454": {
            "id": "10190454",
            "speakerId": 1049,
            "speakerName": "久岐忍",
            "text": "我这里带了些食物和饮用水，各位需要就说。",
            "nextDialogs": [
              "10190455"
            ]
          },
          "10190455": {
            "id": "10190455",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "真好！放牛的，虽然你不太聪明，但你的下属好能干好可靠呀！",
            "nextDialogs": [
              "10190456"
            ]
          },
          "10190456": {
            "id": "10190456",
            "speakerId": 1044,
            "speakerName": "荒泷一斗",
            "text": "嘿嘿，我也觉……不是！本大爷也很聪明啊！",
            "nextDialogs": [
              "10190457"
            ]
          },
          "10190457": {
            "id": "10190457",
            "speakerId": 1048,
            "speakerName": "夜兰",
            "text": "前方有个入口，里面似乎有路。",
            "nextDialogs": [
              "10190458"
            ]
          },
          "10190458": {
            "id": "10190458",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "会是什么呢？去看看吧。"
          }
        }
      }
    },
    {
      "subId": "101905",
      "subQuestName": "前往夜兰所在处",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "10190501"
        ],
        "dialogs": {
          "10190501": {
            "id": "10190501",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "这种地方竟然有秘境入口，不可思议…",
            "nextDialogs": [
              "10190502"
            ]
          },
          "10190502": {
            "id": "10190502",
            "speakerId": 1044,
            "speakerName": "荒泷一斗",
            "text": "有进路，应该也有出路，进去看看。",
            "nextDialogs": [
              "10190503"
            ]
          },
          "10190503": {
            "id": "10190503",
            "speakerId": 1030,
            "speakerName": "烟绯",
            "text": "周围这些似乎是有点年头的璃月山岩，跟我在书上看到的类似。这里的秘境应该已经存在很久了。",
            "nextDialogs": [
              "10190504"
            ]
          },
          "10190504": {
            "id": "10190504",
            "speakerId": 1048,
            "speakerName": "夜兰",
            "text": "……！",
            "nextDialogs": [
              "10190505"
            ]
          },
          "10190505": {
            "id": "10190505",
            "speakerId": 1048,
            "speakerName": "夜兰",
            "text": "（有声音？）",
            "nextDialogs": [
              "10190506"
            ]
          },
          "10190506": {
            "id": "10190506",
            "speakerId": 10205,
            "speakerName": "？？？",
            "text": "……",
            "nextDialogs": [
              "10190507"
            ]
          },
          "10190507": {
            "id": "10190507",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "……！",
            "nextDialogs": [
              "10190508"
            ]
          },
          "10190508": {
            "id": "10190508",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "呀！是魈！",
            "nextDialogs": [
              "10190509"
            ]
          },
          "10190509": {
            "id": "10190509",
            "speakerId": 1030,
            "speakerName": "烟绯",
            "text": "降魔大圣？你怎么会在这里？",
            "nextDialogs": [
              "10190510"
            ]
          },
          "10190510": {
            "id": "10190510",
            "speakerId": 1048,
            "speakerName": "夜兰",
            "text": "……",
            "nextDialogs": [
              "10190511"
            ]
          },
          "10190511": {
            "id": "10190511",
            "speakerId": 10204,
            "speakerName": "魈",
            "text": "我也刚从上面下来。听见有响声，一路追至此地。",
            "nextDialogs": [
              "10190512"
            ]
          },
          "10190512": {
            "id": "10190512",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "是不小心掉下来的吗？要不要跟我们一起走？",
            "nextDialogs": [
              "10190513"
            ]
          },
          "10190513": {
            "id": "10190513",
            "speakerId": 10204,
            "speakerName": "魈",
            "text": "不必，我另有要事在身。",
            "nextDialogs": [
              "10190514"
            ]
          },
          "10190514": {
            "id": "10190514",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "是什么重要的事吗？",
            "nextDialogs": [
              "10190515"
            ]
          },
          "10190515": {
            "id": "10190515",
            "speakerId": 10204,
            "speakerName": "魈",
            "text": "…找人。",
            "nextDialogs": [
              "10190516"
            ]
          },
          "10190516": {
            "id": "10190516",
            "speakerId": 10204,
            "speakerName": "魈",
            "text": "这里不是你们该来的地方，尽快回去。",
            "nextDialogs": [
              "10190517"
            ]
          },
          "10190517": {
            "id": "10190517",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "还是那么来无影去无踪呢…",
            "nextDialogs": [
              "10190518"
            ]
          },
          "10190518": {
            "id": "10190518",
            "speakerId": 1044,
            "speakerName": "荒泷一斗",
            "text": "刚刚那位小哥很有气势嘛，跟本大爷有得一拼，看来是个厉害角色啊。",
            "nextDialogs": [
              "10190519"
            ]
          },
          "10190519": {
            "id": "10190519",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "放牛的，你哪来的自信呀…",
            "nextDialogs": [
              "10190520"
            ]
          },
          "10190520": {
            "id": "10190520",
            "speakerId": 1049,
            "speakerName": "久岐忍",
            "text": "放那位先生单独行动，真的好吗？",
            "nextDialogs": [
              "10190521"
            ]
          },
          "10190521": {
            "id": "10190521",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "那个人啊，就算你不让他单独行动，他也不会听别人的…不过他很厉害，所以随他去吧。",
            "nextDialogs": [
              "10190522"
            ]
          },
          "10190522": {
            "id": "10190522",
            "speakerId": 1048,
            "speakerName": "夜兰",
            "text": "各位，从这里开始请你们多留意四周。谁都不知道前面的路上会有什么，随时做好准备。",
            "nextDialogs": [
              "10190523"
            ]
          },
          "10190523": {
            "id": "10190523",
            "speakerId": 1044,
            "speakerName": "荒泷一斗",
            "text": "虽然已经承认你们为同伴，可是…凭本大爷的战斗天赋，不需要她提醒，也不需要她带队。",
            "nextDialogs": [
              "10190524"
            ]
          },
          "10190524": {
            "id": "10190524",
            "speakerId": 1049,
            "speakerName": "久岐忍",
            "text": "老大。",
            "nextDialogs": [
              "10190525"
            ]
          },
          "10190525": {
            "id": "10190525",
            "speakerId": 1044,
            "speakerName": "荒泷一斗",
            "text": "啊——知道了知道了啦！",
            "nextDialogs": [
              "10190526"
            ]
          },
          "10190526": {
            "id": "10190526",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "我倒是觉得夜兰给人一种安全感呢。放牛的，你这外宾要好好跟大家相处哦。",
            "nextDialogs": [
              "10190527"
            ]
          },
          "10190527": {
            "id": "10190527",
            "speakerId": 1044,
            "speakerName": "荒泷一斗",
            "text": "飞行堇瓜，不要把自己当本地人行不行。"
          }
        }
      }
    },
    {
      "subId": "101999",

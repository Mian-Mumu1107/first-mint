{
  "lineCounts": {
    "Player": 1,
    "梵米尔": 11
  },
  "subQuests": [
    {
      "subId": "7100701",
      "subQuestName": "（test）和钙化池附近的画家对话$HIDDEN",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "710070101"
        ],
        "dialogs": {
          "710070101": {
            "id": "710070101",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "你画得怎么样了？",
            "nextDialogs": [
              "710070102"
            ]
          },
          "710070102": {
            "id": "710070102",
            "speakerId": 17174,
            "speakerName": "梵米尔",
            "text": "从雕像眼睛发光开始，我就一直在那两个雕像旁边画画。",
            "nextDialogs": [
              "710070103"
            ]
          },
          "710070103": {
            "id": "710070103",
            "speakerId": 17174,
            "speakerName": "梵米尔",
            "text": "不过，怎么说呢…总感觉，我一直没画出最完美的那一幅画。",
            "nextDialogs": [
              "710070104"
            ]
          },
          "710070104": {
            "id": "710070104",
            "speakerId": 17174,
            "speakerName": "梵米尔",
            "text": "我总感觉我的画里缺了什么东西…你能理解吗？",
            "nextDialogs": [
              "710070105"
            ]
          },
          "710070105": {
            "id": "710070105",
            "speakerId": 17174,
            "speakerName": "梵米尔",
            "text": "就像是一道菜，无论是用料还是做法，一切都很好，但是…但是就感觉缺点什么…",
            "nextDialogs": [
              "710070106"
            ]
          },
          "710070106": {
            "id": "710070106",
            "speakerId": 17174,
            "speakerName": "梵米尔",
            "text": "哎呀，我也不知道怎么表达，而且也抓不住那个感觉，所以我只能不停地画下去。",
            "nextDialogs": [
              "710070107"
            ]
          },
          "710070107": {
            "id": "710070107",
            "speakerId": 17174,
            "speakerName": "梵米尔",
            "text": "哈哈哈，不怕你笑我，我画得头都有点晕了，就想要闭眼休息一下…",
            "nextDialogs": [
              "710070108"
            ]
          },
          "710070108": {
            "id": "710070108",
            "speakerId": 17174,
            "speakerName": "梵米尔",
            "text": "但不知道为什么，我闭眼的时候，突然又看见那两个雕像亮起来的眼睛…就在我眼前。就和那两个雕像活了似的，直直地盯着我。",
            "nextDialogs": [
              "710070109"
            ]
          },
          "710070109": {
            "id": "710070109",
            "speakerId": 17174,
            "speakerName": "梵米尔",
            "text": "我，我就回来这里，想要休息一下，这里应该看不见那两个雕像的眼睛了…",
            "nextDialogs": [
              "710070110"
            ]
          },
          "710070110": {
            "id": "710070110",
            "speakerId": 17174,
            "speakerName": "梵米尔",
            "text": "对了，请你收下这幅画吧，这是目前为止，我觉得最好的一幅画。",
            "nextDialogs": [
              "710070111"
            ]
          },
          "710070111": {
            "id": "710070111",
            "speakerId": 17174,
            "speakerName": "梵米尔",
            "text": "你别在意我说的话，我肯定是太累了，休息一下就好了。",
            "nextDialogs": [
              "710070112"
            ]
          },
          "710070112": {
            "id": "710070112",
            "speakerId": 17174,
            "speakerName": "梵米尔",
            "text": "但是我的画，到底缺了什么呢，缺了什么呢…"
          }
        }
      }
    }
  ]
}
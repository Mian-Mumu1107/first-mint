    },
    {
      "subId": "7614503",
      "subQuestName": "(test)隐藏$HIDDEN",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "761450301"
        ],
        "dialogs": {
          "761450301": {
            "id": "761450301",
            "speakerId": 7656,
            "speakerName": "库济米奇",
            "text": "哎呀呀，没想到真的卖完了，看来我还是有一些商业眼光的嘛。",
            "nextDialogs": [
              "761450302"
            ]
          },
          "761450302": {
            "id": "761450302",
            "speakerId": 7656,
            "speakerName": "库济米奇",
            "text": "接下来我会拜托执灯人送我穿过噩影泽地，之后再往北应该就是通途了。",
            "nextDialogs": [
              "761450303"
            ]
          },
          "761450303": {
            "id": "761450303",
            "speakerId": 7656,
            "speakerName": "库济米奇",
            "text": "说不定回去的路上还能碰到什么商机呢…那么就此别过吧，我们有缘再见。"
          }
        }
      }
    },
    {
      "subId": "7614504",
      "subQuestName": "(test)隐藏$HIDDEN",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "761450401"
        ],
        "dialogs": {
          "761450401": {
            "id": "761450401",
            "speakerId": 7656,
            "speakerName": "库济米奇",
            "text": "这么巧，我们又见面了。您要买点什么吗？新货滞销，帮帮我。",
            "nextDialogs": [
              "761450408",
              "761450403",
              "761450410"
            ]
          },
          "761450408": {
            "id": "761450408",
            "speakerId": 7656,
            "speakerName": "库济米奇",
            "text": "都是些本地的特产，放心，一定给您最优惠的价格。"
          },
          "761450403": {
            "id": "761450403",
            "speakerId": 7656,
            "speakerName": "库济米奇",
            "text": "哎，怎么说呢。商业嘛，正所谓该出手时就出手…我在皮拉米达城碰到了个好机会，一批急着出手的货物，给了我优惠价。",
            "nextDialogs": [
              "761450404"
            ]
          },
          "761450404": {
            "id": "761450404",
            "speakerId": 7656,
            "speakerName": "库济米奇",
            "text": "我当时一激动，就忘了我这次是要回家了，全给买了下来。结果就…",
            "nextDialogs": [
              "761450405"
            ]
          },
          "761450405": {
            "id": "761450405",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "你猜他为什么急着出手。",
            "nextDialogs": [
              "761450406"
            ]
          },
          "761450406": {
            "id": "761450406",
            "speakerId": 7656,
            "speakerName": "库济米奇",
            "text": "哎，您就别挖苦我了，要不您看看有什么用得上的东西？"
          },
          "761450410": {
            "id": "761450410",
            "speakerId": 7656,
            "speakerName": "库济米奇",
            "text": "不再看看吗，一定有您需要的东西！"
          }
        }
      }
    },
    {
      "subId": "7614506",
      "subQuestName": "(test)隐藏$HIDDEN",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "761450601"
        ],
        "dialogs": {
          "761450601": {
            "id": "761450601",
            "speakerId": 7656,
            "speakerName": "库济米奇",
            "text": "太好了，终于把货都卖完了，果然薄利多销的策略是正确的。",
            "nextDialogs": [
              "761450602"
            ]
          },
          "761450602": {
            "id": "761450602",
            "speakerId": 7656,
            "speakerName": "库济米奇",
            "text": "按理来说我也该启程回至冬了，只是现在顶多也就赚回了路费…我光脚出来，可不想再光脚回去啊。",
            "nextDialogs": [
              "761450603"
            ]
          },
          "761450603": {
            "id": "761450603",
            "speakerId": 7656,
            "speakerName": "库济米奇",
            "text": "哎，总之多谢你照顾生意了。"
          }
        }
      }
    },
    {
      "subId": "7614507",
      "subQuestName": "(test)隐藏$HIDDEN",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "761450701"
        ],
        "dialogs": {
          "761450701": {
            "id": "761450701",
            "speakerId": 7656,
            "speakerName": "库济米奇",
            "text": "哎哟，缘分真是奇妙，居然在这又碰上了。怎么样，要看看吗？这次有不少好东西哦。",
            "nextDialogs": [
              "761450710",
              "761450703",
              "761450707",
              "761450712"
            ]
          },
          "761450710": {
            "id": "761450710",
            "speakerId": 7656,
            "speakerName": "库济米奇",
            "text": "嘿，都是愚人众淘汰下来的老旧装备，在别处可买不到，有想要的就一起拿走吧！"
          },
          "761450703": {
            "id": "761450703",
            "speakerId": 7656,
            "speakerName": "库济米奇",
            "text": "不瞒您说，我的家在新基捷城，全家都是采矿工人。他们啊，一个个比矮灵还顽固，我说要出门经商，他们坚决不同意。",
            "nextDialogs": [
              "761450704"
            ]
          },
          "761450704": {
            "id": "761450704",
            "speakerId": 7656,
            "speakerName": "库济米奇",
            "text": "于是出门前我夸下海口，要赚一大笔钱回去…结果没想到，到头来会差点连路费都凑不上。",
            "nextDialogs": [
              "761450705"
            ]
          },
          "761450705": {
            "id": "761450705",
            "speakerId": 7656,
            "speakerName": "库济米奇",
            "text": "现在赚大钱是没戏了，至少最后让我能赚点小钱吧，起码回去也有个交待。"
          },
          "761450707": {
            "id": "761450707",
            "speakerId": 7656,
            "speakerName": "库济米奇",
            "text": "瞧您说的，我可是遵纪守法的至冬公民，看到愚人众就跟回家了一样。",
            "nextDialogs": [
              "761450708"
            ]
          },
          "761450708": {
            "id": "761450708",
            "speakerId": 7656,
            "speakerName": "库济米奇",
            "text": "现在我这里的货都是愚人众淘汰下来的老旧装备，是他们特别托我处理的。你在别处可买不到，独此一家。"
          },
          "761450712": {
            "id": "761450712",
            "speakerId": 7656,
            "speakerName": "库济米奇",
            "text": "那可真是遗憾…"
          }
        }
      }
    },
    {
      "subId": "7614509",
      "subQuestName": "(test)隐藏$HIDDEN",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "761450901"
        ],
        "dialogs": {
          "761450901": {
            "id": "761450901",
            "speakerId": 7656,
            "speakerName": "库济米奇",
            "text": "真是太感谢了，多亏了你，我可以不用那么灰头土脸地回去了。",
            "nextDialogs": [
              "761450902"
            ]
          },
          "761450902": {
            "id": "761450902",
            "speakerId": 7656,
            "speakerName": "库济米奇",
            "text": "这次真的要告别了。你买了我这么多东西，我们怎么说也算是朋友了吧。",
            "nextDialogs": [
              "761450903"
            ]
          },
          "761450903": {
            "id": "761450903",
            "speakerId": 7656,
            "speakerName": "库济米奇",
            "text": "你若是有机会来至冬的话，就到新基捷城来找我吧。"
          }
        }
      }
    },
    {
      "subId": "7614501",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "761450101"
        ],
        "dialogs": {
          "761450101": {
            "id": "761450101",
            "speakerId": 7656,
            "speakerName": "库济米奇",
            "text": "行情还真是差啊…要不我还是再凑笔钱，想办法去那夏镇租个摊位吧…",
            "nextDialogs": [
              "761450114",
              "761450103",
              "761450116"
            ]
          },
          "761450114": {
            "id": "761450114",
            "speakerId": 7656,
            "speakerName": "库济米奇",
            "text": "都是些从纳塔淘来的小玩意，有什么感兴趣的您尽管挑。"
          },
          "761450103": {
            "id": "761450103",
            "speakerId": 7656,
            "speakerName": "库济米奇",
            "text": "哎呀，有顾客来了！您好，我叫库济米奇，是来自至冬的旅行商人。",
            "nextDialogs": [
              "761450104"
            ]
          },
          "761450104": {
            "id": "761450104",
            "speakerId": 7656,
            "speakerName": "库济米奇",
            "text": "话是这么说，其实只是在旅行的路上顺便做些小本生意，赚点路费罢了。",
            "nextDialogs": [
              "761450105"
            ]
          },
          "761450105": {
            "id": "761450105",
            "speakerId": 7656,
            "speakerName": "库济米奇",
            "text": "结果路过纳塔的时候，那里的人实在太热情了，我一时脑热就…现在我要是不把这些货卖光，连回去的车票钱都要没有啦。"
          },
          "761450116": {
            "id": "761450116",
            "speakerId": 7656,
            "speakerName": "库济米奇",
            "text": "哎，你怎么就走了，不看看吗…"
          }
        }
      }
    }
  ]
}
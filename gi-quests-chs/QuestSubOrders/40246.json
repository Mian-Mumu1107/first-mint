    {
      "subId": "4024607",
      "subQuestName": "等待茜特菈莉的仪式",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "402460701"
        ],
        "dialogs": {
          "402460701": {
            "id": "402460701",
            "speakerId": 1004,
            "speakerName": "茜特菈莉",
            "text": "准备好了吗？",
            "nextDialogs": [
              "402460702"
            ]
          },
          "402460702": {
            "id": "402460702",
            "speakerId": 1005,
            "speakerName": "「木偶」",
            "text": "嗯。我会先尝试着和他们沟通两句。",
            "nextDialogs": [
              "402460703"
            ]
          },
          "402460703": {
            "id": "402460703",
            "speakerId": 1005,
            "speakerName": "「木偶」",
            "text": "但这些灵魂的聚合体恐怕已经失去了理智，如果无法沟通，事态很可能演变为一场战斗。",
            "nextDialogs": [
              "402460704"
            ]
          },
          "402460704": {
            "id": "402460704",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "好，假如变成了最坏的情况，我会找个地方好好躲着的。",
            "nextDialogs": [
              "402460705"
            ]
          },
          "402460705": {
            "id": "402460705",
            "speakerId": 1005,
            "speakerName": "「木偶」",
            "text": "嗯，真打起来的话，最后一击让我来，你们不要出手。相信我。",
            "nextDialogs": [
              "402460706"
            ]
          },
          "402460706": {
            "id": "402460706",
            "speakerId": 1004,
            "speakerName": "茜特菈莉",
            "text": "明白了。",
            "nextDialogs": [
              "402460707"
            ]
          },
          "402460707": {
            "id": "402460707",
            "speakerId": 1004,
            "speakerName": "茜特菈莉",
            "text": "好了，你们安静点。",
            "nextDialogs": [
              "402460708"
            ]
          },
          "402460708": {
            "id": "402460708",
            "speakerId": 1004,
            "speakerName": "茜特菈莉",
            "text": "…随潮汐飘摇的游魂，我呼唤你们。被分离、被遗弃、被迫沉默的碎魂啊，循着旧日的气息归来吧。",
            "nextDialogs": [
              "402460709"
            ]
          },
          "402460709": {
            "id": "402460709",
            "speakerId": 1004,
            "speakerName": "茜特菈莉",
            "text": "…让失名的怨恨彼此识别，让禁秽的恶质相互吸引，在此，重新聚合成形！",
            "nextDialogs": [
              "402460710"
            ]
          },
          "402460710": {
            "id": "402460710",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "……",
            "nextDialogs": [
              "402460711"
            ]
          },
          "402460711": {
            "id": "402460711",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "……",
            "nextDialogs": [
              "402460712"
            ]
          },
          "402460712": {
            "id": "402460712",
            "speakerId": 1005,
            "speakerName": "「木偶」",
            "text": "（…然后呢？这就结束了？）",
            "nextDialogs": [
              "402460713"
            ]
          },
          "402460713": {
            "id": "402460713",
            "speakerId": 1005,
            "speakerName": "「木偶」",
            "text": "（啊…所以我才对付不来这些魔法秘术什么的…根本不知道算法进展到了哪一步，术式逻辑也看不通透。）",
            "nextDialogs": [
              "402460714"
            ]
          },
          "402460714": {
            "id": "402460714",
            "speakerId": 1005,
            "speakerName": "「木偶」",
            "text": "（和我熟知的机械科学完全…）",
            "nextDialogs": [
              "402460715"
            ]
          },
          "402460715": {
            "id": "402460715",
            "speakerId": 1005,
            "speakerName": "「木偶」",
            "text": "……！",
            "nextDialogs": [
              "402460716"
            ]
          },
          "402460716": {
            "id": "402460716",
            "speakerId": 1004,
            "speakerName": "茜特菈莉",
            "text": "当心！",
            "nextDialogs": [
              "402460717"
            ]
          },
          "402460717": {
            "id": "402460717",
            "speakerId": 1006,
            "speakerName": "「游魂的怨意」",
            "text": "——！",
            "nextDialogs": [
              "402460718"
            ]
          },
          "402460718": {
            "id": "402460718",
            "speakerId": 1005,
            "speakerName": "「木偶」",
            "text": "那边的人，或者说里面的人，能听懂我说话吗？",
            "nextDialogs": [
              "402460719"
            ]
          },
          "402460719": {
            "id": "402460719",
            "speakerId": 1005,
            "speakerName": "「木偶」",
            "text": "我是枫丹「奇械公」，阿兰·吉约丹的后人。我有办法帮你们恢复原样，回归地脉。只需要你们稍微配合…",
            "nextDialogs": [
              "402460720"
            ]
          },
          "402460720": {
            "id": "402460720",
            "speakerId": 1006,
            "speakerName": "「游魂的怨意」",
            "text": "——！",
            "nextDialogs": [
              "402460721"
            ]
          },
          "402460721": {
            "id": "402460721",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "桑多涅！",
            "nextDialogs": [
              "402460722"
            ]
          },
          "402460722": {
            "id": "402460722",
            "speakerId": 1005,
            "speakerName": "「木偶」",
            "text": "嘁…这架势，看来是怎么都劝不动了啊。",
            "nextDialogs": [
              "402460723"
            ]
          },
          "402460723": {
            "id": "402460723",
            "speakerId": 1005,
            "speakerName": "「木偶」",
            "text": "好吧。那就陪你们发泄发泄。"
          }
        }
      }
    },
    {
      "subId": "4024608",
      "subQuestName": "击败敌人",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [],
        "dialogs": {}
      }
    },
    {
      "subId": "4024609",
      "subQuestName": "击败敌人",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "402460901"
        ],
        "dialogs": {
          "402460901": {
            "id": "402460901",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "这样就…结束了吗？",
            "nextDialogs": [
              "402460902"
            ]
          },
          "402460902": {
            "id": "402460902",
            "speakerId": 1005,
            "speakerName": "「木偶」",
            "text": "结束了。说了这是很简单的事。",
            "nextDialogs": [
              "402460903"
            ]
          },
          "402460903": {
            "id": "402460903",
            "speakerId": 1004,
            "speakerName": "茜特菈莉",
            "text": "你是怎么做到的？",
            "nextDialogs": [
              "402460904"
            ]
          },
          "402460904": {
            "id": "402460904",
            "speakerId": 1005,
            "speakerName": "「木偶」",
            "text": "那个怨意的集合体，不过是众多无家灵魂聚合在一起的产物。其中混杂着许多污秽与邪念。",
            "nextDialogs": [
              "402460905"
            ]
          },
          "402460905": {
            "id": "402460905",
            "speakerId": 1005,
            "speakerName": "「木偶」",
            "text": "我不过是将它们最原本的灵魂与污秽分离，让它们得以被现在的世界规则容纳罢了。",
            "nextDialogs": [
              "402460906"
            ]
          },
          "402460906": {
            "id": "402460906",
            "speakerId": 1005,
            "speakerName": "「木偶」",
            "text": "「世界式」的原理是「发散」。从一个原点出发，解构与重组世界的可能性，从中寻找答案。",
            "nextDialogs": [
              "402460907"
            ]
          },
          "402460907": {
            "id": "402460907",
            "speakerId": 1005,
            "speakerName": "「木偶」",
            "text": "而利用「数秘阵列」反向运算「世界式」，就能达到归拢收束与还原的功能。即术式的反转。",
            "nextDialogs": [
              "402460908"
            ]
          },
          "402460908": {
            "id": "402460908",
            "speakerId": 1005,
            "speakerName": "「木偶」",
            "text": "这类似数理中的同调归约，在不改变群体本质的情况下，将他们还原为更简单和实质性的存在。",
            "nextDialogs": [
              "402460909"
            ]
          },
          "402460909": {
            "id": "402460909",
            "speakerId": 1005,
            "speakerName": "「木偶」",
            "text": "所以…呃，算了。看你们的样子也不是真的想搞明白这些…",
            "nextDialogs": [
              "402460910"
            ]
          },
          "402460910": {
            "id": "402460910",
            "speakerId": 1004,
            "speakerName": "茜特菈莉",
            "text": "我好像理解外地人听烟谜主萨满讲东西是什么感觉了。",
            "nextDialogs": [
              "402460911"
            ]
          },
          "402460911": {
            "id": "402460911",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "总…总之我知道很了不起就对了！你果然很厉害呢！桑多涅。",
            "nextDialogs": [
              "402460912"
            ]
          },
          "402460912": {
            "id": "402460912",
            "speakerId": 1005,
            "speakerName": "「木偶」",
            "text": "笑话，我一直很厉害！哈哈哈。",
            "nextDialogs": [
              "402460913"
            ]
          },
          "402460913": {
            "id": "402460913",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "不愧是析构万理的…",
            "nextDialogs": [
              "402460914"
            ]
          },
          "402460914": {
            "id": "402460914",
            "speakerId": 1005,
            "speakerName": "「木偶」",
            "text": "这个就算了！！",
            "nextDialogs": [
              "402460915"
            ]
          },
          "402460915": {
            "id": "402460915",
            "speakerId": 1005,
            "speakerName": "「木偶」",
            "text": "差…差不多该走了！我去把格式塔内部的机关还原一下。我们岸上见！"
          }
        }
      }
    },
    {
      "subId": "4024610",
      "subQuestName": "离开格式塔",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "402461001"
        ],
        "dialogs": {
          "402461001": {
            "id": "402461001",
            "speakerId": 1005,
            "speakerName": "「木偶」",
            "text": "好了好了！过去的烂摊子总算收拾完了。真是浑身都轻松了不少。",
            "nextDialogs": [
              "402461002"
            ]
          },
          "402461002": {
            "id": "402461002",
            "speakerId": 1005,
            "speakerName": "「木偶」",
            "text": "偶尔这么做一件好事，还挺开心的嘛。",
            "nextDialogs": [
              "402461003"
            ]
          },
          "402461003": {
            "id": "402461003",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "你在挪德卡莱也帮了朋友们很多忙啦，明明一直都很好！",
            "nextDialogs": [
              "402461004"
            ]
          },
          "402461004": {
            "id": "402461004",
            "speakerId": 1005,
            "speakerName": "「木偶」",
            "text": "呵，这可说不好。我之后可是要回愚人众的，你们这么相信别人真的好吗？",
            "nextDialogs": [
              "402461005"
            ]
          },
          "402461005": {
            "id": "402461005",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "至少桑多涅可以相信。",
            "nextDialogs": [
              "402461006"
            ]
          },
          "402461006": {
            "id": "402461006",
            "speakerId": 1005,
            "speakerName": "「木偶」",
            "text": "哼，到时候吃了苦头可别怪我没提醒过你们。",
            "nextDialogs": [
              "402461007"
            ]
          },
          "402461007": {
            "id": "402461007",
            "speakerId": 1004,
            "speakerName": "茜特菈莉",
            "text": "我们接下来去哪儿？回船上吗？",
            "nextDialogs": [
              "402461008"
            ]
          },
          "402461008": {
            "id": "402461008",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "对啊，桑多涅你自己的事也解决完了，过去的事也解决完了。是时候让朋友们知道你没事了吧。",
            "nextDialogs": [
              "402461009"
            ]
          },
          "402461009": {
            "id": "402461009",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "大家见你回来，一定会很高兴的！",
            "nextDialogs": [
              "402461010"
            ]
          },
          "402461010": {
            "id": "402461010",
            "speakerId": 1005,
            "speakerName": "「木偶」",
            "text": "哈…换作以前，我恐怕绝对不会承认，不过…嗯，我的确也想大家了。",
            "nextDialogs": [
              "402461011"
            ]
          },
          "402461011": {
            "id": "402461011",
            "speakerId": 1005,
            "speakerName": "「木偶」",
            "text": "但哥伦比娅是个例外！这次我一定要把她老是来烦我的仇给报了！"
          }
        }
      }
    },
    {
      "subId": "4024611",
      "subQuestName": "离开格式塔",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "402461101"
        ],
        "dialogs": {
          "402461101": {
            "id": "402461101",
            "speakerId": 1001,
            "speakerName": "哥伦比娅",
            "text": "……",
            "nextDialogs": [
              "402461102"
            ]
          },
          "402461102": {
            "id": "402461102",
            "speakerId": 1001,
            "speakerName": "哥伦比娅",
            "text": "唔，桑多涅…",
            "nextDialogs": [
              "402461103"
            ]
          },
          "402461103": {
            "id": "402461103",
            "speakerId": 1005,
            "speakerName": "「木偶」",
            "text": "闭嘴。早就说过不许把我随便传到奇奇怪怪的地方。",
            "nextDialogs": [
              "402461104"
            ]
          },
          "402461104": {
            "id": "402461104",
            "speakerId": 1001,
            "speakerName": "哥伦比娅",
            "text": "可…可是…",
            "nextDialogs": [
              "402461105"
            ]
          },
          "402461105": {
            "id": "402461105",
            "speakerId": 1007,
            "speakerName": "泽维尔",
            "text": "哦！太棒了！简直太棒了！这就是我想要的结局！我想要的画面！",
            "nextDialogs": [
              "402461106"
            ]
          },
          "402461106": {
            "id": "402461106",
            "speakerId": 1005,
            "speakerName": "「木偶」",
            "text": "…哈？！！",
            "nextDialogs": [
              "402461107"
            ]
          },
          "402461107": {
            "id": "402461107",
            "speakerId": 1002,
            "speakerName": "芙宁娜",
            "text": "你刚才去哪儿了？哥伦比娅小姐。怎么一转眼就从片场消失，又突然…呃，和这位小姐一起出现。拥抱着。",
            "nextDialogs": [
              "402461108"
            ]
          },
          "402461108": {
            "id": "402461108",
            "speakerId": 1005,
            "speakerName": "「木偶」",
            "text": "你…你们刚才…在拍…拍…",
            "nextDialogs": [
              "402461109"
            ]
          },
          "402461109": {
            "id": "402461109",
            "speakerId": 1003,
            "speakerName": "千织",
            "text": "事情发生得太突然，留影机一直在运转，刚才的画面也拍下了。",
            "nextDialogs": [
              "402461110"
            ]
          },
          "402461110": {
            "id": "402461110",
            "speakerId": 1002,
            "speakerName": "芙宁娜",
            "text": "这位难道就是…",
            "nextDialogs": [
              "402461111"
            ]
          },
          "402461111": {
            "id": "402461111",
            "speakerId": 1001,
            "speakerName": "哥伦比娅",
            "text": "嗯，她就是我最好的朋友。没想到真的能和她再次相见。我好高兴。",
            "nextDialogs": [
              "402461112"
            ]
          },
          "402461112": {
            "id": "402461112",
            "speakerId": 1001,
            "speakerName": "哥伦比娅",
            "text": "看来，这部映影有了个好结局呢。桑多涅。",
            "nextDialogs": [
              "402461113"
            ]
          },
          "402461113": {
            "id": "402461113",
            "speakerId": 1001,
            "speakerName": "哥伦比娅",
            "text": "…桑多涅？",
            "nextDialogs": [
              "402461114"
            ]
          },
          "402461114": {
            "id": "402461114",
            "speakerId": 1005,
            "speakerName": "「木偶」",
            "text": "果然…果然我还是觉得你好烦人啊！！哥·伦·比·娅！！！"
          }
        }
      }
    }
  ]
}
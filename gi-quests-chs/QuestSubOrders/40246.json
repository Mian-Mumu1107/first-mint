    {
      "subId": "4024605",
      "subQuestName": "检查格式塔内的空间",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "402460501"
        ],
        "dialogs": {
          "402460501": {
            "id": "402460501",
            "speakerId": 1005,
            "speakerName": "「木偶」",
            "text": "看来是不在呢…",
            "nextDialogs": [
              "402460502"
            ]
          },
          "402460502": {
            "id": "402460502",
            "speakerId": 1004,
            "speakerName": "茜特菈莉",
            "text": "要我现在开始举行仪式吗？",
            "nextDialogs": [
              "402460503"
            ]
          },
          "402460503": {
            "id": "402460503",
            "speakerId": 1005,
            "speakerName": "「木偶」",
            "text": "先等等，我们把这层格式塔的水排空吧。这样更容易行动。",
            "nextDialogs": [
              "402460504"
            ]
          },
          "402460504": {
            "id": "402460504",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "这水还能排走？",
            "nextDialogs": [
              "402460505"
            ]
          },
          "402460505": {
            "id": "402460505",
            "speakerId": 1005,
            "speakerName": "「木偶」",
            "text": "当然可以。在阿兰和雷内不约而同观测到枫丹命运之后，二人就曾分享过一些建筑防水的方法。原理是…",
            "nextDialogs": [
              "402460506"
            ]
          },
          "402460506": {
            "id": "402460506",
            "speakerId": 1005,
            "speakerName": "「木偶」",
            "text": "咳咳，跑题了。总之你们照我说的，按顺序解开几个机关就行。"
          }
        }
      }
    },

    {
      "subId": "4024602",
      "subQuestName": "前往维恩歌莱号甲板",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "402460201"
        ],
        "dialogs": {
          "402460201": {
            "id": "402460201",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "昨天茜特菈莉喝得还挺多，也不知道她现在醒没醒…",
            "nextDialogs": [
              "402460202"
            ]
          },
          "402460202": {
            "id": "402460202",
            "speakerId": 1001,
            "speakerName": "哥伦比娅",
            "text": "早上好。",
            "nextDialogs": [
              "402460203"
            ]
          },
          "402460203": {
            "id": "402460203",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "呃啊！哥伦比娅！你…你怎么在这里？不对，你怎么老是喜欢从人背后出现啦！",
            "nextDialogs": [
              "402460204"
            ]
          },
          "402460204": {
            "id": "402460204",
            "speakerId": 1001,
            "speakerName": "哥伦比娅",
            "text": "今早和大家一起来这边补个镜头，刚刚拍完。我就先到甲板上来透透气。",
            "nextDialogs": [
              "402460205"
            ]
          },
          "402460205": {
            "id": "402460205",
            "speakerId": 1001,
            "speakerName": "哥伦比娅",
            "text": "其他人好像还在下面讨论有关「最后一幕」的事情。",
            "nextDialogs": [
              "402460206"
            ]
          },
          "402460206": {
            "id": "402460206",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "最后一幕？",
            "nextDialogs": [
              "402460207"
            ]
          },
          "402460207": {
            "id": "402460207",
            "speakerId": 1001,
            "speakerName": "哥伦比娅",
            "text": "嗯，就是这部映影的结尾。大家在烦恼故事中的女主角最终有没有找到自己曾经的朋友。",
            "nextDialogs": [
              "402460208"
            ]
          },
          "402460208": {
            "id": "402460208",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "啊…这两天做别的事情都快忙忘了，这部艺术片的确是以主角发现友人不见了，所以回到她故乡为背景的呢。",
            "nextDialogs": [
              "402460209"
            ]
          },
          "402460209": {
            "id": "402460209",
            "speakerId": 1001,
            "speakerName": "哥伦比娅",
            "text": "嗯，芙宁娜导演和千织小姐认为，从故事韵味上来说，最终二人没有相见的悲剧式结尾会更加令人惋惜。",
            "nextDialogs": [
              "402460210"
            ]
          },
          "402460210": {
            "id": "402460210",
            "speakerId": 1001,
            "speakerName": "哥伦比娅",
            "text": "泽维尔导演则认为，相见的结局更加令人感动，治愈人心。",
            "nextDialogs": [
              "402460211"
            ]
          },
          "402460211": {
            "id": "402460211",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "哥伦比娅怎么想？",
            "nextDialogs": [
              "402460212"
            ]
          },
          "402460212": {
            "id": "402460212",
            "speakerId": 1001,
            "speakerName": "哥伦比娅",
            "text": "我吗？我…我不知道…",
            "nextDialogs": [
              "402460213"
            ]
          },
          "402460213": {
            "id": "402460213",
            "speakerId": 1001,
            "speakerName": "哥伦比娅",
            "text": "如果是「我」的话，我当然想和她见面…多希望她真的还能和我见面…哪怕是在映影中。",
            "nextDialogs": [
              "402460214"
            ]
          },
          "402460214": {
            "id": "402460214",
            "speakerId": 1001,
            "speakerName": "哥伦比娅",
            "text": "但想到这样意味着要让另一个人来演绎她，我心中又有些…",
            "nextDialogs": [
              "402460215"
            ]
          },
          "402460215": {
            "id": "402460215",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "……",
            "nextDialogs": [
              "402460216"
            ]
          },
          "402460216": {
            "id": "402460216",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "先别担心这些。",
            "nextDialogs": [
              "402460217"
            ]
          },
          "402460217": {
            "id": "402460217",
            "speakerId": 1001,
            "speakerName": "哥伦比娅",
            "text": "嗯？",
            "nextDialogs": [
              "402460218"
            ]
          },
          "402460218": {
            "id": "402460218",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "对啊对啊，别因为这个就愁眉苦脸的。映影就应该享受地去拍才对！",
            "nextDialogs": [
              "402460219"
            ]
          },
          "402460219": {
            "id": "402460219",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "而且…我，我敢向哥伦比娅保证！事情一定会顺利的！",
            "nextDialogs": [
              "402460220"
            ]
          },
          "402460220": {
            "id": "402460220",
            "speakerId": 1001,
            "speakerName": "哥伦比娅",
            "text": "顺利？指的是…？",
            "nextDialogs": [
              "402460221"
            ]
          },
          "402460221": {
            "id": "402460221",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "呃，就…就是…",
            "nextDialogs": [
              "402460222"
            ]
          },
          "402460222": {
            "id": "402460222",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "一定会是个好结局。",
            "nextDialogs": [
              "402460223"
            ]
          },
          "402460223": {
            "id": "402460223",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "嗯！就是这个意思！",
            "nextDialogs": [
              "402460224"
            ]
          },
          "402460224": {
            "id": "402460224",
            "speakerId": 1001,
            "speakerName": "哥伦比娅",
            "text": "哈…好吧。我相信你们。",
            "nextDialogs": [
              "402460225"
            ]
          },
          "402460225": {
            "id": "402460225",
            "speakerId": 1001,
            "speakerName": "哥伦比娅",
            "text": "那就像你们说的，先享受拍戏的过程吧。",
            "nextDialogs": [
              "402460226"
            ]
          },
          "402460226": {
            "id": "402460226",
            "speakerId": 1002,
            "speakerName": "芙宁娜",
            "text": "#哟？这不是{NICKNAME}和派蒙吗？",
            "nextDialogs": [
              "402460227"
            ]
          },
          "402460227": {
            "id": "402460227",
            "speakerId": 1003,
            "speakerName": "千织",
            "text": "哟？这不是翘班的灯光师和场记吗？",
            "nextDialogs": [
              "402460228"
            ]
          },
          "402460228": {
            "id": "402460228",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "呃…抱歉…这次拍摄我们请假是有些频繁。",
            "nextDialogs": [
              "402460229"
            ]
          },
          "402460229": {
            "id": "402460229",
            "speakerId": 1003,
            "speakerName": "千织",
            "text": "呵呵，开个玩笑。别往心里去。我们这次拍摄挺顺利的，你们先安心忙自己的事就好。",
            "nextDialogs": [
              "402460232"
            ]
          },
          "402460232": {
            "id": "402460232",
            "speakerId": 1002,
            "speakerName": "芙宁娜",
            "text": "咦？哥伦比娅小姐似乎心情好了不少。啊，抱歉，是我们刚才讨论结局的话题让你为难了吧…",
            "nextDialogs": [
              "402460233"
            ]
          },
          "402460233": {
            "id": "402460233",
            "speakerId": 1001,
            "speakerName": "哥伦比娅",
            "text": "#没关系，我现在没事了。{NICKNAME}和派蒙已经帮我想通了。",
            "nextDialogs": [
              "402460234"
            ]
          },
          "402460234": {
            "id": "402460234",
            "speakerId": 1002,
            "speakerName": "芙宁娜",
            "text": "哦？那是想拍个相见的结局还是不相见的结局？",
            "nextDialogs": [
              "402460235"
            ]
          },
          "402460235": {
            "id": "402460235",
            "speakerId": 1001,
            "speakerName": "哥伦比娅",
            "text": "拍个好结局。",
            "nextDialogs": [
              "402460236"
            ]
          },
          "402460236": {
            "id": "402460236",
            "speakerId": 1002,
            "speakerName": "芙宁娜",
            "text": "…啊？"
          }
        }
      }
    },
    {
      "subId": "4024612",
      "subQuestName": "与茜特菈莉对话",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "402461201"
        ],
        "dialogs": {
          "402461201": {
            "id": "402461201",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "茜特菈莉，我们来啦！",
            "nextDialogs": [
              "402461202"
            ]
          },
          "402461202": {
            "id": "402461202",
            "speakerId": 1004,
            "speakerName": "茜特菈莉",
            "text": "哟。挺准时嘛。",
            "nextDialogs": [
              "402461203"
            ]
          },
          "402461203": {
            "id": "402461203",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "你才是…昨天喝那么多没关系吗？",
            "nextDialogs": [
              "402461204"
            ]
          },
          "402461204": {
            "id": "402461204",
            "speakerId": 1004,
            "speakerName": "茜特菈莉",
            "text": "呵？你是小瞧奶奶我了？就那点可醉不倒我。",
            "nextDialogs": [
              "402461205"
            ]
          },
          "402461205": {
            "id": "402461205",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "可你后来都开始说胡话了…",
            "nextDialogs": [
              "402461206"
            ]
          },
          "402461206": {
            "id": "402461206",
            "speakerId": 1004,
            "speakerName": "茜特菈莉",
            "text": "有…有吗？我怎么不记得？我没说什么…了不得的事吧？",
            "nextDialogs": [
              "402461207"
            ]
          },
          "402461207": {
            "id": "402461207",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "骂孙子骂了半小时、抱怨烟谜主工作抱怨了半小时、分享轻小说分享了一小时…还有…呃，好像后面我也睡着了。",
            "nextDialogs": [
              "402461208"
            ]
          },
          "402461208": {
            "id": "402461208",
            "speakerId": 1005,
            "speakerName": "「木偶」",
            "text": "…她们走了吗？",
            "nextDialogs": [
              "402461209"
            ]
          },
          "402461209": {
            "id": "402461209",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "她们？哦，是说剧组吧。已经走了，我们刚好在甲板碰上。",
            "nextDialogs": [
              "402461210"
            ]
          },
          "402461210": {
            "id": "402461210",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "不过，既然你都解决了自己的问题，为什么还不去见哥伦比娅呢？她明明很想见你。",
            "nextDialogs": [
              "402461211"
            ]
          },
          "402461211": {
            "id": "402461211",
            "speakerId": 1005,
            "speakerName": "「木偶」",
            "text": "我…我想先处理完手上这烂摊子再去见她。再说了，这么好一个吓她一跳的机会，我肯定得多计划计划呀！",
            "nextDialogs": [
              "402461212"
            ]
          },
          "402461212": {
            "id": "402461212",
            "speakerId": 1005,
            "speakerName": "「木偶」",
            "text": "不说这个了。那个污秽聚合体的位置找到了吗？",
            "nextDialogs": [
              "402461213"
            ]
          },
          "402461213": {
            "id": "402461213",
            "speakerId": 1004,
            "speakerName": "茜特菈莉",
            "text": "当然，黑曜石奶奶我说办得到就办得到。",
            "nextDialogs": [
              "402461214"
            ]
          },
          "402461214": {
            "id": "402461214",
            "speakerId": 1005,
            "speakerName": "「木偶」",
            "text": "辛苦了。我看看…",
            "nextDialogs": [
              "402461215"
            ]
          },
          "402461215": {
            "id": "402461215",
            "speakerId": 1005,
            "speakerName": "「木偶」",
            "text": "莫尔泰区…嗯？这不是格式塔吗？",
            "nextDialogs": [
              "402461216"
            ]
          },
          "402461216": {
            "id": "402461216",
            "speakerId": 1005,
            "speakerName": "「木偶」",
            "text": "果然还是对自己灵魂被切割时的地方怨意最深吗？还是说，这是对「水仙十字」的怨意…",
            "nextDialogs": [
              "402461217"
            ]
          },
          "402461217": {
            "id": "402461217",
            "speakerId": 1004,
            "speakerName": "茜特菈莉",
            "text": "我陪你们一起去吧，这东西的出现地点其实不算很固定，如果它不在那儿的话，我也有办法用某种仪式把它招过来。",
            "nextDialogs": [
              "402461218"
            ]
          },
          "402461218": {
            "id": "402461218",
            "speakerId": 1005,
            "speakerName": "「木偶」",
            "text": "真的吗？但这件事已经给你添了很多麻烦…",
            "nextDialogs": [
              "402461219"
            ]
          },
          "402461219": {
            "id": "402461219",
            "speakerId": 1004,
            "speakerName": "茜特菈莉",
            "text": "别客气，这老骨头闲着也是闲着，帮小年轻招个魂什么的还累不到我。",
            "nextDialogs": [
              "402461220"
            ]
          },
          "402461220": {
            "id": "402461220",
            "speakerId": 1004,
            "speakerName": "茜特菈莉",
            "text": "（我不去的话谁知道你们又会聊出什么我参与不了的话题？！）",
            "nextDialogs": [
              "402461221"
            ]
          },
          "402461221": {
            "id": "402461221",
            "speakerId": 1005,
            "speakerName": "「木偶」",
            "text": "好吧，那就辛苦你了。谢谢。",
            "nextDialogs": [
              "402461222"
            ]
          },
          "402461222": {
            "id": "402461222",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "嘿嘿，那么事不宜迟，我们这就出发吧！"
          }
        }
      }
    },

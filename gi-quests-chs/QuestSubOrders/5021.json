      }
    },
    {
      "subId": "502113",
      "subQuestName": "(test)闲置平民（如果没去过流泉之众）$HIDDEN",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "50211301"
        ],
        "dialogs": {
          "50211301": {
            "id": "50211301",
            "speakerId": 1009,
            "speakerName": "卡马加",
            "text": "眼前这不安定的状态，要持续到什么时候啊…",
            "nextDialogs": [
              "50211302"
            ]
          },
          "50211302": {
            "id": "50211302",
            "speakerId": 1009,
            "speakerName": "卡马加",
            "text": "本来要去流泉之众做生意的，这下钱可没得赚了，不过没出事算是不幸中的万幸吧。",
            "nextDialogs": [
              "50211303"
            ]
          },
          "50211303": {
            "id": "50211303",
            "speakerId": 1002,
            "speakerName": "派蒙",
            "text": "路上遇到危险了吗？",
            "nextDialogs": [
              "50211304"
            ]
          },
          "50211304": {
            "id": "50211304",
            "speakerId": 1009,
            "speakerName": "卡马加",
            "text": "嗯，被深渊魔物袭击，我还以为没救了呢，结果你们猜怎么，居然是愚人众出手救了我们。",
            "nextDialogs": [
              "50211305"
            ]
          },
          "50211305": {
            "id": "50211305",
            "speakerId": 1009,
            "speakerName": "卡马加",
            "text": "他们说他们是「队长」的部下，眼下也正在四处救援…深渊确实是人类共同的敌人没错，但…还是觉得有点奇妙。",
            "nextDialogs": [
              "50211306"
            ]
          },
          "50211306": {
            "id": "50211306",
            "speakerId": 1009,
            "speakerName": "卡马加",
            "text": "他们又去其他地方了，希望没事才好。"
          }
        }
      }
    },
    {
      "subId": "502114",
      "subQuestName": "(test)闲置平民（如果去过流泉之众）$HIDDEN",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "50211401"
        ],
        "dialogs": {
          "50211401": {
            "id": "50211401",
            "speakerId": 1009,
            "speakerName": "卡马加",
            "text": "啊，是你们！我们平安抵达了！",
            "nextDialogs": [
              "50211402"
            ]
          },
          "50211402": {
            "id": "50211402",
            "speakerId": 1009,
            "speakerName": "卡马加",
            "text": "幸好有你们一起帮忙，不然我们会怎么样还很难说啊。",
            "nextDialogs": [
              "50211403"
            ]
          },
          "50211403": {
            "id": "50211403",
            "speakerId": 1009,
            "speakerName": "卡马加",
            "text": "那些帮忙的愚人众现在又去其他地方战斗了，希望他们没事才好。"
          }
        }
      }
    },
    {
      "subId": "502115",
      "subQuestName": "(test)主城哨站-只有医生$HIDDEN",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "50212401"
        ],
        "dialogs": {
          "50212401": {
            "id": "50212401",
            "speakerId": 1003,
            "speakerName": "玛亚薇",
            "text": "欸，没想到会在这里又遇到你们。",
            "nextDialogs": [
              "50212402"
            ]
          },
          "50212402": {
            "id": "50212402",
            "speakerId": 1003,
            "speakerName": "玛亚薇",
            "text": "听说竞技场很缺医生，我就跟着一支队伍过来了。",
            "nextDialogs": [
              "50212403"
            ]
          },
          "50212403": {
            "id": "50212403",
            "speakerId": 1003,
            "speakerName": "玛亚薇",
            "text": "我也上年纪了，没办法再冲到最前面去拼杀，但后方交给我们吧，一切都会好起来的。"
          }
        }
      }
    },
    {
      "subId": "502116",
      "subQuestName": "(test)只有卖药的$HIDDEN",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "50211601"
        ],
        "dialogs": {
          "50211601": {
            "id": "50211601",
            "speakerId": 1008,
            "speakerName": "奥希娜",
            "text": "我打算把这批物资送去竞技场，现在什么地方都缺药，这些还远远不够。",
            "nextDialogs": [
              "50211602"
            ]
          },
          "50211602": {
            "id": "50211602",
            "speakerId": 1008,
            "speakerName": "奥希娜",
            "text": "除了药，食物和水这类东西虽然有应急储备，但谁也不知道接下来会怎么样…",
            "nextDialogs": [
              "50211603"
            ]
          },
          "50211603": {
            "id": "50211603",
            "speakerId": 1008,
            "speakerName": "奥希娜",
            "text": "我联系一下我的商会，看看能不能再运一些过来吧。"
          }
        }
      }
    },
    {
      "subId": "502132",
      "subQuestName": "(test)完成了主城哨站熟人对话$HIDDEN",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "50117001"
        ],
        "dialogs": {
          "50117001": {
            "id": "50117001",
            "speakerId": 1010,
            "speakerName": "阿尔妲",
            "text": "原来是你们！看到你们没事，我们也安心了。",
            "nextDialogs": [
              "50117002"
            ]
          },
          "50117002": {
            "id": "50117002",
            "speakerId": 1002,
            "speakerName": "派蒙",
            "text": "哦，你们平安回来了啊！",
            "nextDialogs": [
              "50117003"
            ]
          },
          "50117003": {
            "id": "50117003",
            "speakerId": 1011,
            "speakerName": "科科庞",
            "text": "是的，达尔戈把我们送回来之后，马不停蹄地又去了其他地方。",
            "nextDialogs": [
              "50117004"
            ]
          },
          "50117004": {
            "id": "50117004",
            "speakerId": 1010,
            "speakerName": "阿尔妲",
            "text": "多亏有你们帮忙，我们运送的医疗用品才能及时送达竞技场，真是太好了。"
          }
        }
      }
    },
    {
      "subId": "502133",
      "subQuestName": "(test)完成了主城哨站龙对话$HIDDEN",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "50117101"
        ],
        "dialogs": {
          "50117101": {
            "id": "50117101",
            "speakerId": 1012,
            "speakerName": "细心的匿叶龙",
            "text": "外面好危险，不能出去。你们最好也别出去哦。"
          }
        }
      }
    },
    {
      "subId": "502117",
      "subQuestName": "(test)医生和卖药的都在$HIDDEN",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "50211701"
        ],
        "dialogs": {
          "50211701": {
            "id": "50211701",
            "speakerId": 1003,
            "speakerName": "玛亚薇",
            "text": "欸，是你们，来得正好！听说她也是被你们救下来的？",
            "nextDialogs": [
              "50211702"
            ]
          },
          "50211702": {
            "id": "50211702",
            "speakerId": 1008,
            "speakerName": "奥希娜",
            "text": "没错，正因为有他们，才保下了我的这批药剂。",
            "nextDialogs": [
              "50211703"
            ]
          },
          "50211703": {
            "id": "50211703",
            "speakerId": 1003,
            "speakerName": "玛亚薇",
            "text": "太好了，我是医生，这些药剂正好能解燃眉之急。至于价格，肯定不会亏待你。",
            "nextDialogs": [
              "50211704"
            ]
          },
          "50211704": {
            "id": "50211704",
            "speakerId": 1008,
            "speakerName": "奥希娜",
            "text": "这个没事，按照平时的价格来结算就好了，现在更宝贵的是时间。",
            "nextDialogs": [
              "50211705"
            ]
          },
          "50211705": {
            "id": "50211705",
            "speakerId": 1003,
            "speakerName": "玛亚薇",
            "text": "太感谢了，太感谢了，那我们等下就出发吧。",
            "nextDialogs": [
              "50211706"
            ]
          },
          "50211706": {
            "id": "50211706",
            "speakerId": 1008,
            "speakerName": "奥希娜",
            "text": "嗯，没问题。"
          }
        }
      }
    },
    {
      "subId": "502120",
      "subQuestName": "(test)遇见胆怯的战士（如果之前鼓励过他）$HIDDEN",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [

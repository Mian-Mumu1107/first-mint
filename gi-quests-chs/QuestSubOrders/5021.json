            ]
          },
          "50211802": {
            "id": "50211802",
            "speakerId": 1008,
            "speakerName": "奥希娜",
            "text": "欸，这不太可能吧。",
            "nextDialogs": [
              "50211803"
            ]
          },
          "50211803": {
            "id": "50211803",
            "speakerId": 1006,
            "speakerName": "斯塔杜欣",
            "text": "可以把你送到相对较近的地方，正好也比较顺路。",
            "nextDialogs": [
              "50211804"
            ]
          },
          "50211804": {
            "id": "50211804",
            "speakerId": 1008,
            "speakerName": "奥希娜",

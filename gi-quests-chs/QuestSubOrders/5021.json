    {
      "subId": "502106",
      "subQuestName": "(test)寻找湿地的信差$HIDDEN",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "50210801"
        ],
        "dialogs": {
          "50210801": {
            "id": "50210801",
            "speakerId": 1004,
            "speakerName": "拉曼",
            "text": "呃…呃…",
            "nextDialogs": [
              "50210802"
            ]
          },
          "50210802": {
            "id": "50210802",
            "speakerId": 1002,
            "speakerName": "派蒙",
            "text": "果然有受伤的人！喂，你还好吗？还能走吗？",
            "nextDialogs": [
              "50210803"
            ]
          },
          "50210803": {
            "id": "50210803",
            "speakerId": 1004,
            "speakerName": "拉曼",
            "text": "战报…战报掉了，那个东西很重要…",
            "nextDialogs": [
              "50210804"
            ]
          },
          "50210804": {
            "id": "50210804",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "我们已经找到了。",
            "nextDialogs": [
              "50210805"
            ]
          },
          "50210805": {
            "id": "50210805",
            "speakerId": 1002,
            "speakerName": "派蒙",
            "text": "别着急，来，给你。",
            "nextDialogs": [
              "50210806"
            ]
          },
          "50210806": {
            "id": "50210806",
            "speakerId": 1004,
            "speakerName": "拉曼",
            "text": "谢谢，唉，希望我没有耽误太多时间…",
            "nextDialogs": [
              "50210807"
            ]
          },
          "50210807": {
            "id": "50210807",
            "speakerId": 1004,
            "speakerName": "拉曼",
            "text": "时效性，在这种时候，就等于生命。",
            "nextDialogs": [
              "50210808"
            ]
          },
          "50210808": {
            "id": "50210808",
            "speakerId": 1002,
            "speakerName": "派蒙",
            "text": "放心，接下来的事我们会处理的！现在就不要勉强自己了吧，最好直接回竞技场去养伤。",
            "nextDialogs": [
              "50210809"
            ]
          },
          "50210809": {
            "id": "50210809",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "相信你的部族同伴吧。",
            "nextDialogs": [
              "50210810"
            ]
          },
          "50210810": {
            "id": "50210810",
            "speakerId": 1004,
            "speakerName": "拉曼",
            "text": "嗯，也是，我现在也没有这个能力了。",
            "nextDialogs": [
              "50210811"
            ]
          },
          "50210811": {
            "id": "50210811",
            "speakerId": 1002,
            "speakerName": "派蒙",
            "text": "但现在要怎么办，其他地方的情况也很紧急，可他似乎没办法一个人回去…",
            "nextDialogs": [
              "50210812"
            ]
          },
          "50210812": {
            "id": "50210812",
            "speakerId": 1005,
            "speakerName": "勇敢的匿叶龙",
            "text": "呜——呜呜——",
            "nextDialogs": [
              "50210813"
            ]
          },
          "50210813": {
            "id": "50210813",
            "speakerId": 1004,
            "speakerName": "拉曼",
            "text": "欸、欸？",
            "nextDialogs": [
              "50210814"
            ]
          },
          "50210814": {
            "id": "50210814",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "它想送你回去？",
            "nextDialogs": [
              "50210815"
            ]
          },
          "50210815": {
            "id": "50210815",
            "speakerId": 1002,
            "speakerName": "派蒙",
            "text": "呜哇，你们几个没问题吗？我可担心你们了。",
            "nextDialogs": [
              "50210816"
            ]
          },
          "50210816": {
            "id": "50210816",
            "speakerId": 1005,
            "speakerName": "勇敢的匿叶龙",
            "text": "呜呜——",
            "nextDialogs": [
              "50210817"
            ]
          },
          "50210817": {
            "id": "50210817",
            "speakerId": 1004,
            "speakerName": "拉曼",
            "text": "好吧，真是谢谢你们，太好了。",
            "nextDialogs": [
              "50210818"
            ]
          },
          "50210818": {
            "id": "50210818",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "那你们路上小心。",
            "nextDialogs": [
              "50210819"
            ]
          },
          "50210819": {
            "id": "50210819",
            "speakerId": 1002,
            "speakerName": "派蒙",
            "text": "有这些龙能帮忙，真是不幸中的万幸…",
            "nextDialogs": [
              "50210821",
              "50210823"
            ]
          },
          "50210821": {
            "id": "50210821",
            "speakerId": 1002,
            "speakerName": "派蒙",
            "text": "怪不得说龙是纳塔人的好伙伴呢。"
          },
          "50210823": {
            "id": "50210823",
            "speakerId": 1002,
            "speakerName": "派蒙",
            "text": "你在意的是这个吗！"
          }
        }
      }
    },

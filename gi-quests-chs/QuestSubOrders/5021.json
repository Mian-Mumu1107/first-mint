    {
      "subId": "502102",
      "subQuestName": "(test)和找妈妈的孩子对话$HIDDEN",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "50210201"
        ],
        "dialogs": {
          "50210201": {
            "id": "50210201",
            "speakerId": 1001,
            "speakerName": "特波兹",
            "text": "你好，旅行者，可以帮我个忙吗？",
            "nextDialogs": [
              "50210202"
            ]
          },
          "50210202": {
            "id": "50210202",
            "speakerId": 1001,
            "speakerName": "特波兹",
            "text": "我的母亲她是个医生，当时听说野外有人受到袭击，她就赶去了，现在都没有消息。",
            "nextDialogs": [
              "50210203"
            ]
          },
          "50210203": {
            "id": "50210203",
            "speakerId": 1001,
            "speakerName": "特波兹",
            "text": "她不擅长战斗，我很担心她，可惜现在我也没办法离开，能不能麻烦你们看到她的话，让她不要到处乱跑了，快去避难。",
            "nextDialogs": [
              "50210204"
            ]
          },
          "50210204": {
            "id": "50210204",
            "speakerId": 1002,
            "speakerName": "派蒙",
            "text": "好，我们会留意的！",
            "nextDialogs": [
              "50210205"
            ]
          },
          "50210205": {
            "id": "50210205",
            "speakerId": 1001,
            "speakerName": "特波兹",
            "text": "谢谢，这样我在战斗的时候也不会分心了。"
          }
        }
      }
    },
    {
      "subId": "502103",
      "subQuestName": "(test)第一个事件的存档隔离$HIDDEN",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "50210301"
        ],
        "dialogs": {
          "50210301": {
            "id": "50210301",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "害怕也是人之常情。",
            "nextDialogs": [
              "50210302"
            ]
          },
          "50210302": {
            "id": "50210302",
            "speakerId": 1000,
            "speakerName": "乌图伦库",
            "text": "人之常情，你是说，害怕并不可耻？",
            "nextDialogs": [
              "50210303"
            ]
          },
          "50210303": {
            "id": "50210303",
            "speakerId": 1002,
            "speakerName": "派蒙",
            "text": "没错啊，就算害怕，你还是站在了这里，拿起了武器，是很了不起的！",
            "nextDialogs": [
              "50210304"
            ]
          },
          "50210304": {
            "id": "50210304",
            "speakerId": 1000,
            "speakerName": "乌图伦库",
            "text": "这、这样啊，我懂了，嗯，谢谢你们能鼓励我！"
          }
        }
      }
    },
    {
      "subId": "502104",
      "subQuestName": "(test)遇见医生$HIDDEN",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "50210401"
        ],
        "dialogs": {
          "50210401": {
            "id": "50210401",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "不会。",
            "nextDialogs": [
              "50210402"
            ]
          },
          "50210402": {
            "id": "50210402",
            "speakerId": 1000,
            "speakerName": "乌图伦库",
            "text": "知、知道了，一看你就很强…",
            "nextDialogs": [
              "50210403"
            ]
          },
          "50210403": {
            "id": "50210403",
            "speakerId": 1000,
            "speakerName": "乌图伦库",
            "text": "唉…"
          }
        }
      }
    },
    {
      "subId": "502105",
      "subQuestName": "(test)战斗后和医生对话$HIDDEN",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "50210601"
        ],
        "dialogs": {
          "50210601": {
            "id": "50210601",
            "speakerId": 1002,
            "speakerName": "派蒙",
            "text": "医生…等等，请问你认识特波兹吗？",
            "nextDialogs": [
              "50210602"
            ]
          },
          "50210602": {
            "id": "50210602",
            "speakerId": 1003,
            "speakerName": "玛亚薇",
            "text": "啊，你们怎么知道他，他是我的儿子，怎么了，他没事吧？",
            "nextDialogs": [
              "50210603"
            ]
          },
          "50210603": {
            "id": "50210603",
            "speakerId": 1002,
            "speakerName": "派蒙",
            "text": "哦，没事没事，他只是很担心你，希望你去避难。",
            "nextDialogs": [
              "50210604"
            ]
          },
          "50210604": {
            "id": "50210604",
            "speakerId": 1003,
            "speakerName": "玛亚薇",
            "text": "嗯，我知道，现在外面变得很危险，我不应该乱跑，但我也不能什么事都不做…",
            "nextDialogs": [
              "50210605"
            ]
          },
          "50210605": {
            "id": "50210605",
            "speakerId": 1003,
            "speakerName": "玛亚薇",
            "text": "这样吧，我写封信给他，然后等有战士小队路过的时候，我跟他们一起走，这样我也能安全一些。",
            "nextDialogs": [
              "50210606"
            ]
          },
          "50210606": {
            "id": "50210606",
            "speakerId": 1002,
            "speakerName": "派蒙",
            "text": "嗯，这样也好，总之他需要知道你还平安！",
            "nextDialogs": [
              "50210607"
            ]
          },
          "50210607": {
            "id": "50210607",
            "speakerId": 1003,
            "speakerName": "玛亚薇",
            "text": "好的，谢谢你们能把消息带来。"
          }
        }
      }
    },
    {
      "subId": "502122",

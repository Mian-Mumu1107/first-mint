    {
      "subId": "502107",
      "subQuestName": "(test)卖药的去竞技场-闲置处理$HIDDEN",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "50210701"
        ],
        "dialogs": {
          "50210701": {
            "id": "50210701",
            "speakerId": 1003,
            "speakerName": "玛亚薇",
            "text": "看来现在也不能到处乱跑，要和战士小队一起行动才更安全…",
            "nextDialogs": [
              "50210702"
            ]
          },
          "50210702": {
            "id": "50210702",
            "speakerId": 1003,
            "speakerName": "玛亚薇",
            "text": "总之，我还有其他地方要去，先走了！",
            "nextDialogs": [
              "50210703"
            ]
          },
          "50210703": {
            "id": "50210703",
            "speakerId": 1002,
            "speakerName": "派蒙",
            "text": "看她这么着急，形势应该很不乐观吧…"
          }
        }
      }
    },
    {
      "subId": "502118",
      "subQuestName": "(test)卖药的去流泉之众-闲置处理$HIDDEN",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "50211801"
        ],
        "dialogs": {
          "50211801": {
            "id": "50211801",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "让愚人众送你一程？",
            "nextDialogs": [

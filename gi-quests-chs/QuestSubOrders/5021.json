    {
      "subId": "502110",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "50211001"
        ],
        "dialogs": {
          "50211001": {
            "id": "50211001",
            "speakerId": 1007,
            "speakerName": "奇马利",
            "text": "对了，这附近还有一个地方比较可疑，我怀疑有深渊魔物。",
            "nextDialogs": [
              "50211002"
            ]
          },
          "50211002": {
            "id": "50211002",
            "speakerId": 1007,
            "speakerName": "奇马利",
            "text": "你们如果有空的话，愿意和我一起来吗？",
            "nextDialogs": [
              "50211004",
              "50211006"
            ]
          },
          "50211004": {
            "id": "50211004",
            "speakerId": 1007,
            "speakerName": "奇马利",
            "text": "好的，那我们这就行动。"
          },
          "50211006": {
            "id": "50211006",
            "speakerId": 1007,
            "speakerName": "奇马利",
            "text": "没问题，那待会儿我叫几个伙伴一起去。"
          }
        }
      }
    },
    {
      "subId": "502115",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "50211501"
        ],
        "dialogs": {
          "50211501": {
            "id": "50211501",
            "speakerId": 1003,
            "speakerName": "玛亚薇",
            "text": "欸，没想到会在这里又遇到你们。",
            "nextDialogs": [
              "50211502"
            ]
          },
          "50211502": {
            "id": "50211502",
            "speakerId": 1003,
            "speakerName": "玛亚薇",
            "text": "儿子给我回信了，告诉我那边的情况暂时不用担心。",
            "nextDialogs": [
              "50211503"
            ]
          },
          "50211503": {
            "id": "50211503",
            "speakerId": 1003,
            "speakerName": "玛亚薇",
            "text": "听说竞技场很缺医生，我就跟着一支队伍过来了。",
            "nextDialogs": [
              "50211504"
            ]
          },
          "50211504": {
            "id": "50211504",
            "speakerId": 1003,
            "speakerName": "玛亚薇",
            "text": "我也上年纪了，没办法再冲到最前面去拼杀，但后方交给我们吧，一切都会好起来的。"
          }
        }
      }
    },
    {
      "subId": "502144",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [

          }
        }
      }
    },
    {
      "subId": "502119",
      "subQuestName": "(test)流泉之众部分回滚隔离$HIDDEN",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "50211901"
        ],
        "dialogs": {
          "50211901": {
            "id": "50211901",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "还是别冒险了吧。",
            "nextDialogs": [

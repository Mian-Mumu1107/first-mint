  "subQuests": [
    {
      "subId": "7407401",
      "subQuestName": "",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "740740101"
        ],
        "dialogs": {
          "740740101": {
            "id": "740740101",
            "speakerId": 16922,
            "speakerName": "安",
            "text": "…不是，比起这个，你不更应该关注视野内还躺着一个人吗？",
            "nextDialogs": [
              "740740102"
            ]
          },
          "740740102": {
            "id": "740740102",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "欸？哇！怎么回事…",
            "nextDialogs": [
              "740740103"
            ]
          },
          "740740103": {
            "id": "740740103",
            "speakerId": 16924,
            "speakerName": "西摩尔",
            "text": "抱歉小姐，刚才把寻找石碑的优先级提到最高了。现在请让我来进行扫描…",
            "nextDialogs": [
              "740740104"
            ]
          },
          "740740104": {
            "id": "740740104",
            "speakerId": 16924,
            "speakerName": "西摩尔",
            "text": "…很抱歉，小姐。",
            "nextDialogs": [
              "740740105"
            ]
          },
          "740740105": {
            "id": "740740105",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "什么？！",
            "nextDialogs": [
              "740740106"
            ]
          },
          "740740106": {
            "id": "740740106",
            "speakerId": 21048,
            "speakerName": "卡特皮拉",
            "text": "他虽然还活着，但是生命的气息已经从他的孔窍中溜走了。我认识这个手段…",
            "nextDialogs": [
              "740740107"
            ]
          },
          "740740107": {
            "id": "740740107",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "呜呜，我不敢看了。",
            "nextDialogs": [
              "740740108"
            ]
          },
          "740740108": {
            "id": "740740108",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "赶紧去找人帮忙吧！可不能就这样放着不管！",
            "nextDialogs": [
              "740740109"
            ]
          },
          "740740109": {
            "id": "740740109",
            "speakerId": 1004,
            "speakerName": "Black Screen",
            "text": "一同将失去意识的人送到了柔灯港。\\n柔灯港的人立刻出发，将他送去救治。\\n随后才放下心来，与众人回到了原来的位置。",
            "nextDialogs": [
              "740740110"
            ]
          },
          "740740110": {
            "id": "740740110",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "好啦，我们看看石碑吧。",
            "nextDialogs": [
              "740740111"
            ]
          },
          "740740111": {
            "id": "740740111",
            "speakerId": 16924,
            "speakerName": "西摩尔",
            "text": "「此处乃愿望之象限，愿望之神殿，愿望之间。」",
            "nextDialogs": [
              "740740112"
            ]
          },
          "740740112": {
            "id": "740740112",
            "speakerId": 16924,
            "speakerName": "西摩尔",
            "text": "「常与相违」…「生于一瞬，伴你长眠，从不分离」…「有染罪果」…",
            "nextDialogs": [
              "740740113"
            ]
          },
          "740740113": {
            "id": "740740113",
            "speakerId": 21048,
            "speakerName": "卡特皮拉",
            "text": "又是谜语。",
            "nextDialogs": [
              "740740114"
            ]
          },
          "740740114": {
            "id": "740740114",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "为什么要在这里做这么可怕的事情…和谜底难道有关吗？",
            "nextDialogs": [
              "740740115"
            ]
          },
          "740740115": {
            "id": "740740115",
            "speakerId": 21048,
            "speakerName": "卡特皮拉",
            "text": "因为枫丹人是「罪人」，是「有染原罪」的生命。",
            "nextDialogs": [
              "740740116"
            ]
          },
          "740740116": {
            "id": "740740116",
            "speakerId": 21048,
            "speakerName": "卡特皮拉",
            "text": "因此答案是「生命」。我已经猜出来了。",
            "nextDialogs": [
              "740740117"
            ]
          },
          "740740117": {
            "id": "740740117",
            "speakerId": 16922,
            "speakerName": "安",
            "text": "你能确定是这个答案吗？",
            "nextDialogs": [
              "740740118"
            ]
          },
          "740740118": {
            "id": "740740118",
            "speakerId": 21048,
            "speakerName": "卡特皮拉",
            "text": "我太熟悉水仙十字结社的那套语言符号系统了。不出意外就是这个答案。",
            "nextDialogs": [
              "740740119"
            ]
          },
          "740740119": {
            "id": "740740119",
            "speakerId": 21048,
            "speakerName": "卡特皮拉",
            "text": "好了，让我们开始争分夺秒吧。"
          }
        }
      }
    },
    {

    {
      "subId": "7407410",
      "subQuestName": "",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "740743001"
        ],
        "dialogs": {
          "740743001": {
            "id": "740743001",
            "speakerId": 1004,
            "speakerName": "Black Screen",
            "text": "仔细检查了机关顶部的空间，什么都没有发现。",
            "nextDialogs": [
              "740743002"
            ]
          },
          "740743002": {
            "id": "740743002",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "结果最后这里什么都没有吗？",
            "nextDialogs": [
              "740743003"
            ]
          },
          "740743003": {
            "id": "740743003",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "不对，好像是东西已经被人拿走了。",
            "nextDialogs": [
              "740743004"
            ]
          },
          "740743004": {
            "id": "740743004",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "究竟是谁呢？"
          }
        }
      }
    },
    {
      "subId": "7407405",
      "subQuestName": "获取「愿望」之块",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "740741901"
        ],
        "dialogs": {
          "740741901": {
            "id": "740741901",
            "speakerId": 1004,
            "speakerName": "Black Screen",
            "text": "仔细检查了机关顶部的空间，什么都没有发现。",
            "nextDialogs": [
              "740741902"
            ]
          },
          "740741902": {
            "id": "740741902",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "结果最后这里什么都没有吗？",
            "nextDialogs": [
              "740741903"
            ]
          },
          "740741903": {
            "id": "740741903",
            "speakerId": 21048,
            "speakerName": "卡特皮拉",
            "text": "并不是，看起来是已经被人拿走了。",
            "nextDialogs": [
              "740741904"
            ]
          },
          "740741904": {
            "id": "740741904",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "那岂不是我们的计划已经失败了？",
            "nextDialogs": [
              "740741905"
            ]
          },
          "740741905": {
            "id": "740741905",
            "speakerId": 21048,
            "speakerName": "卡特皮拉",
            "text": "「理性」的诞生需要四个象限合一。只要我们能拿到剩下的几个，我们就还有机会。",
            "nextDialogs": [
              "740741906"
            ]
          },
          "740741906": {
            "id": "740741906",
            "speakerId": 16922,
            "speakerName": "安",
            "text": "既然如此，我们就快点去接下来的地方吧。"
          }
        }
      }
    },
    {
      "subId": "7407403",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "740740301"
        ],
        "dialogs": {
          "740740301": {
            "id": "740740301",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "梦？",
            "nextDialogs": [

        ],
        "dialogs": {
          "740742101": {
            "id": "740742101",
            "speakerId": 1004,
            "speakerName": "Black Screen",
            "text": "仔细检查了机关顶部的空间，什么都没有发现。",
            "nextDialogs": [
              "740742102"
            ]
          },
          "740742102": {
            "id": "740742102",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "这里的东西…也被人拿走了吗？",
            "nextDialogs": [
              "740742103"
            ]
          },
          "740742103": {
            "id": "740742103",
            "speakerId": 21048,
            "speakerName": "卡特皮拉",
            "text": "看起来是这样。",
            "nextDialogs": [
              "740742104"
            ]
          },
          "740742104": {
            "id": "740742104",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "究竟是谁会…",
            "nextDialogs": [
              "740742105"
            ]
          },
          "740742105": {
            "id": "740742105",
            "speakerId": 21048,
            "speakerName": "卡特皮拉",
            "text": "是雅各布。",
            "nextDialogs": [
              "740742106"
            ]
          },
          "740742106": {
            "id": "740742106",
            "speakerId": 16924,
            "speakerName": "西摩尔",
            "text": "我们之前在厄里那斯曾经与其发生冲突。补充订正，是最近一段时间的厄里那斯。",
            "nextDialogs": [
              "740742107"
            ]
          },
          "740742107": {
            "id": "740742107",
            "speakerId": 21048,
            "speakerName": "卡特皮拉",
            "text": "之前看到大门口那个悲剧的受害者我就知道是他的手笔了。他果然还在活动啊。",
            "nextDialogs": [
              "740742108"
            ]
          },
          "740742108": {
            "id": "740742108",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "那他拿走这里的东西是想要干什么呢？",
            "nextDialogs": [
              "740742109"
            ]
          },
          "740742109": {
            "id": "740742109",
            "speakerId": 21048,
            "speakerName": "卡特皮拉",
            "text": "很简单啊。他也想要重铸水仙十字的圣剑。因为水仙十字结社的事业还未竟呢。",
            "nextDialogs": [
              "740742110"
            ]
          },
          "740742110": {
            "id": "740742110",
            "speakerId": 21048,
            "speakerName": "卡特皮拉",
            "text": "我们还是赶紧去最后一处地方吧。"
          }
        }
      }
    },

          },
          "740740204": {
            "id": "740740204",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "还活着，但是没有意识了。",
            "nextDialogs": [
              "740740205"
            ]
          },
          "740740205": {
            "id": "740740205",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "呼，还好还好。",
            "nextDialogs": [
              "740740206"
            ]
          },
          "740740206": {
            "id": "740740206",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "赶紧去找人帮忙吧！可不能就这样放着不管！",
            "nextDialogs": [
              "740740207"
            ]
          },
          "740740207": {
            "id": "740740207",
            "speakerId": 1004,
            "speakerName": "Black Screen",
            "text": "与派蒙一同，将失去意识的人送到了柔灯港。\\n柔灯港的人立刻出发，将他送去救治。\\n随后才放下心来，与派蒙回到了原来的位置。",
            "nextDialogs": [
              "740740208"
            ]
          },
          "740740208": {
            "id": "740740208",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "好啦，我们看看石碑吧。",
            "nextDialogs": [
              "740740209"
            ]
          },
          "740740209": {
            "id": "740740209",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "「此处乃愿望之象限，愿望之神殿，愿望之间。」",
            "nextDialogs": [
              "740740210"
            ]
          },
          "740740210": {
            "id": "740740210",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "「常与相违」…「生于一瞬，伴你长眠，从不分离」…「有染罪果」…",
            "nextDialogs": [
              "740740211"
            ]
          },
          "740740211": {
            "id": "740740211",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "好像是个谜语！",
            "nextDialogs": [
              "740740212"
            ]
          },
          "740740212": {
            "id": "740740212",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "#唔，{NICKNAME}，那么谜底是什么呢？"
          }
        }
      }
    },

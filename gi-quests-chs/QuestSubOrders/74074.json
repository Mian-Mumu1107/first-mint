            ]
          },
          "740740302": {
            "id": "740740302",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "不太对吧。梦到什么奇怪的东西才算是有罪啊。",
            "nextDialogs": [
              "740740303"
            ]
          },
          "740740303": {
            "id": "740740303",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "#唔，{NICKNAME}，那么谜底是什么呢？"
          }
        }
      }
    },
    {
      "subId": "7407420",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "740742001"
        ],
        "dialogs": {
          "740742001": {
            "id": "740742001",
            "speakerId": 1004,
            "speakerName": "Black Screen",
            "text": "仔细检查了机关顶部的空间，什么都没有发现。",
            "nextDialogs": [
              "740742002"
            ]
          },
          "740742002": {
            "id": "740742002",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "这里依旧什么都没有欸…",
            "nextDialogs": [
              "740742003"
            ]
          },
          "740742003": {
            "id": "740742003",
            "speakerId": 16922,
            "speakerName": "安",
            "text": "所以卡特皮拉你能告诉我们，我们究竟要找什么吗？",
            "nextDialogs": [
              "740742004"
            ]
          },
          "740742004": {
            "id": "740742004",
            "speakerId": 21048,
            "speakerName": "卡特皮拉",
            "text": "我们是在寻找锻铸水仙十字圣剑的材料。",
            "nextDialogs": [
              "740742005"
            ]
          },
          "740742005": {
            "id": "740742005",
            "speakerId": 21048,
            "speakerName": "卡特皮拉",
            "text": "水仙十字结社依据地下之国与古枫丹的神秘哲学，在物质世界重现了必要的四种架空物质。",
            "nextDialogs": [
              "740742006"
            ]
          },
          "740742006": {
            "id": "740742006",
            "speakerId": 16924,
            "speakerName": "西摩尔",
            "text": "无法理解。",
            "nextDialogs": [
              "740742007"
            ]
          },
          "740742007": {
            "id": "740742007",
            "speakerId": 21048,
            "speakerName": "卡特皮拉",
            "text": "神秘的东西本身只作用于体验，可以说比元素力还要跳脱常理呢。",
            "nextDialogs": [
              "740742008"
            ]
          },
          "740742008": {
            "id": "740742008",
            "speakerId": 16924,
            "speakerName": "西摩尔",
            "text": "几十年前我录入过教令院的素论派入门至中级教材，元素力也没有那么神奇。",
            "nextDialogs": [
              "740742009"
            ]
          },
          "740742009": {
            "id": "740742009",
            "speakerId": 21048,
            "speakerName": "卡特皮拉",
            "text": "是吗。那反正结论上来说，这是枫丹古法与地下古国技术的交汇。",
            "nextDialogs": [
              "740742010"
            ]
          },
          "740742010": {
            "id": "740742010",
            "speakerId": 21048,
            "speakerName": "卡特皮拉",
            "text": "世界上出现了「记忆」、「愿望」、「灵魂」与「人格」这四种物质。",
            "nextDialogs": [
              "740742011"
            ]
          },
          "740742011": {
            "id": "740742011",
            "speakerId": 21048,
            "speakerName": "卡特皮拉",
            "text": "为了防止歧义，我们把它们叫做「记忆」之块、「愿望」之块、「灵魂」之块与「人格」之块好了。",
            "nextDialogs": [
              "740742012"
            ]
          },
          "740742012": {
            "id": "740742012",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "为什么这些东西会用来打造圣剑啊？",
            "nextDialogs": [
              "740742013"
            ]
          },
          "740742013": {
            "id": "740742013",
            "speakerId": 21048,
            "speakerName": "卡特皮拉",
            "text": "水仙十字结社的神秘哲学里，神殿是宇宙的缩影，社员是众神的代行，圣油是锤炼的意志。",
            "nextDialogs": [
              "740742014"
            ]
          },
          "740742014": {
            "id": "740742014",
            "speakerId": 21048,
            "speakerName": "卡特皮拉",
            "text": "圣剑，则是破开一切的「理性」。它需由完整的人之意志诞生而出。",
            "nextDialogs": [
              "740742015"
            ]
          },
          "740742015": {
            "id": "740742015",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "好玄乎。",
            "nextDialogs": [
              "740742016"
            ]
          },
          "740742016": {
            "id": "740742016",
            "speakerId": 21048,
            "speakerName": "卡特皮拉",
            "text": "哎呀，神秘哲学是这样的。看着相似就可以攀附。当这种东西变成魔法了就假成真的了。",
            "nextDialogs": [
              "740742017"
            ]
          },
          "740742017": {
            "id": "740742017",
            "speakerId": 21048,
            "speakerName": "卡特皮拉",
            "text": "总之我们赶紧去下一处地方吧。"
          }
        }
      }
    },
    {
      "subId": "7407421",

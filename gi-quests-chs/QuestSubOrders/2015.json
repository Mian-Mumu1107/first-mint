    {
      "subId": "201504",
      "subQuestName": "找出工厂内的幕后黑手",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "20150401"
        ],
        "dialogs": {
          "20150401": {
            "id": "20150401",
            "speakerId": 10013,
            "speakerName": "「散兵」",
            "text": "没想到你们能找到这里来，做得不错嘛。",
            "nextDialogs": [
              "20150402"
            ]
          },
          "20150402": {
            "id": "20150402",
            "speakerId": 10013,
            "speakerName": "「散兵」",
            "text": "有趣。才见面，就是一副要找我拼命的样子了。",
            "nextDialogs": [
              "20150405"
            ]
          },
          "20150405": {
            "id": "20150405",
            "speakerId": 10013,
            "speakerName": "「散兵」",
            "text": "噢，原来是说这件事。",
            "nextDialogs": [
              "20150406"
            ]
          },
          "20150406": {
            "id": "20150406",
            "speakerId": 10013,
            "speakerName": "「散兵」",
            "text": "你们似乎搞错了一点。我虽然站在这里，但也只是代为执行计划而已。",
            "nextDialogs": [
              "20150407"
            ]
          },
          "20150407": {
            "id": "20150407",
            "speakerId": 10013,
            "speakerName": "「散兵」",
            "text": "主谋当然另有其人了。不是很能干吗？尽情去找吧！",
            "nextDialogs": [
              "20150408"
            ]
          },
          "20150408": {
            "id": "20150408",
            "speakerId": 10013,
            "speakerName": "「散兵」",
            "text": "才这点「小事」就被激怒了？你好像变了嘛…变得不堪一击。",
            "nextDialogs": [
              "20150409"
            ]
          },
          "20150409": {
            "id": "20150409",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "你竟然说这是小事…",
            "nextDialogs": [
              "20150410"
            ]
          },
          "20150410": {
            "id": "20150410",
            "speakerId": 10013,
            "speakerName": "「散兵」",
            "text": "难道不是吗？在这浮世之中，人命如同草芥一般。",
            "nextDialogs": [
              "20150411"
            ]
          },
          "20150411": {
            "id": "20150411",
            "speakerId": 10013,
            "speakerName": "「散兵」",
            "text": "没有邪眼，他们也一样会死。至少，邪眼还给了他们实现「愿望」的机会。",
            "nextDialogs": [
              "20150412"
            ]
          },
          "20150412": {
            "id": "20150412",
            "speakerId": 10013,
            "speakerName": "「散兵」",
            "text": "眼狩令的价值，你们真的了解吗？当初促成这件事花了不小的力气，自然是因为它有利于我们。",
            "nextDialogs": [
              "20150413"
            ]
          },
          "20150413": {
            "id": "20150413",
            "speakerId": 10013,
            "speakerName": "「散兵」",
            "text": "不过现在看来，一切都很值得。制造纷争，为推广邪眼铺路，让力量自行吸引追寻它的弱者…",
            "nextDialogs": [
              "20150414"
            ]
          },
          "20150414": {
            "id": "20150414",
            "speakerId": 10013,
            "speakerName": "「散兵」",
            "text": "只需要一点点代价，就能得到掌握世界的感觉。用性命换取无上之力，挺划算的不是吗？",
            "nextDialogs": [
              "20150415"
            ]
          },
          "20150415": {
            "id": "20150415",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "眼狩令是你们促成的？难道说，你们从一开始就…",
            "nextDialogs": [
              "20150416"
            ]
          },
          "20150416": {
            "id": "20150416",
            "speakerId": 10013,
            "speakerName": "「散兵」",
            "text": "稻妻的外侧看起来十分稳固，但内侧…充满了留给我们的机会。稍加力气，就能从内部攻破。",
            "nextDialogs": [
              "20150417"
            ]
          },
          "20150417": {
            "id": "20150417",
            "speakerId": 10013,
            "speakerName": "「散兵」",
            "text": "永恒可以把时间拉得很长，然而，其间每一个节点都会变得无比脆弱。",
            "nextDialogs": [
              "20150418"
            ]
          },
          "20150418": {
            "id": "20150418",
            "speakerId": 10013,
            "speakerName": "「散兵」",
            "text": "就像你在反抗军的朋友一样，无论怎么努力，都不过是徒劳。",
            "nextDialogs": [
              "20150419"
            ]
          },
          "20150419": {
            "id": "20150419",
            "speakerId": 10013,
            "speakerName": "「散兵」",
            "text": "如同水中泡影，绚烂的同时，便会迎来毁灭。",
            "nextDialogs": [
              "20150420"
            ]
          },
          "20150420": {
            "id": "20150420",
            "speakerId": 10013,
            "speakerName": "「散兵」",
            "text": "越是失去就越想得到，越是无能就越要挣扎！哈哈哈，这种闹剧真让人开心啊。"
          }
        }
      }
    },

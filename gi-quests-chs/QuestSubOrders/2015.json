  "subQuests": [
    {
      "subId": "201501",
      "subQuestName": "与珊瑚宫心海对话",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "20150101"
        ],
        "dialogs": {
          "20150101": {
            "id": "20150101",
            "speakerId": 1037,
            "speakerName": "珊瑚宫心海",
            "text": "#{NICKNAME}，哲平的情况还好吗？",
            "nextDialogs": [
              "20150104"
            ]
          },
          "20150104": {
            "id": "20150104",
            "speakerId": 1037,
            "speakerName": "珊瑚宫心海",
            "text": "…我已经下令，在军队中收缴所有邪眼。",
            "nextDialogs": [
              "20150105"
            ]
          },
          "20150105": {
            "id": "20150105",
            "speakerId": 1037,
            "speakerName": "珊瑚宫心海",
            "text": "绝大部分的人，虽然出现了生命力流失的现象，但情况还不严重。",
            "nextDialogs": [
              "20150106"
            ]
          },
          "20150106": {
            "id": "20150106",
            "speakerId": 1037,
            "speakerName": "珊瑚宫心海",
            "text": "但也有少部分人…",
            "nextDialogs": [
              "20150107"
            ]
          },
          "20150107": {
            "id": "20150107",
            "speakerId": 1039,
            "speakerName": "五郎",
            "text": "珊瑚宫大人，我打算单独开一个伤兵营，观察他们的情况。",
            "nextDialogs": [
              "20150108"
            ]
          },
          "20150108": {
            "id": "20150108",
            "speakerId": 1039,
            "speakerName": "五郎",
            "text": "将士们闹得很厉害，明知是邪眼，他们也打算用下去。",
            "nextDialogs": [
              "20150109"
            ]
          },
          "20150109": {
            "id": "20150109",
            "speakerId": 1037,
            "speakerName": "珊瑚宫心海",
            "text": "此事交给你来负责，我必须要去一趟前线。",
            "nextDialogs": [
              "20150110"
            ]
          },
          "20150110": {
            "id": "20150110",
            "speakerId": 1037,
            "speakerName": "珊瑚宫心海",
            "text": "出了这么大的事情，军心一定会有所动摇。如果幕府军趁乱进攻，就功亏一篑了。",
            "nextDialogs": [
              "20150111"
            ]
          },
          "20150111": {
            "id": "20150111",
            "speakerId": 1037,
            "speakerName": "珊瑚宫心海",
            "text": "#{NICKNAME}，你有什么打算吗？",
            "nextDialogs": [
              "20150112"
            ]
          },
          "20150112": {
            "id": "20150112",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "去阻止愚人众的计划。",
            "nextDialogs": [
              "20150113"
            ]
          },
          "20150113": {
            "id": "20150113",
            "speakerId": 1037,
            "speakerName": "珊瑚宫心海",
            "text": "不行，太危险了！",
            "nextDialogs": [
              "20150114"
            ]
          },
          "20150114": {
            "id": "20150114",
            "speakerId": 1037,
            "speakerName": "珊瑚宫心海",
            "text": "锁国令还在继续，他们的邪眼应该是在稻妻生产的。",
            "nextDialogs": [
              "20150115"
            ]
          },
          "20150115": {
            "id": "20150115",
            "speakerId": 1037,
            "speakerName": "珊瑚宫心海",
            "text": "能够调动如此庞大的人力物力，背后必有本土势力支持。",
            "nextDialogs": [
              "20150116"
            ]
          },
          "20150116": {
            "id": "20150116",
            "speakerId": 1037,
            "speakerName": "珊瑚宫心海",
            "text": "想要阻止他们，就只能捣毁他们生产邪眼的工厂。但那里一定有重兵把守…",
            "nextDialogs": [
              "20150117"
            ]
          },
          "20150117": {
            "id": "20150117",
            "speakerId": 1037,
            "speakerName": "珊瑚宫心海",
            "text": "不能让你冒这样的风险，至少带着军队一起…",
            "nextDialogs": [
              "20150118"
            ]
          },
          "20150118": {
            "id": "20150118",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "没时间了。",
            "nextDialogs": [
              "20150119"
            ]
          },
          "20150119": {
            "id": "20150119",
            "speakerId": 1039,
            "speakerName": "五郎",
            "text": "珊瑚宫大人，我们收缴邪眼的时候很匆忙，应该瞒不过愚人众的眼线。",
            "nextDialogs": [
              "20150120"
            ]
          },
          "20150120": {
            "id": "20150120",
            "speakerId": 1039,
            "speakerName": "五郎",
            "text": "如果我们再花时间整顿军队，他们听到风声，一定会提前逃走。",
            "nextDialogs": [
              "20150121"
            ]
          },
          "20150121": {
            "id": "20150121",
            "speakerId": 1037,
            "speakerName": "珊瑚宫心海",
            "text": "我知道…让我想想…",
            "nextDialogs": [
              "20150122"
            ]
          },
          "20150122": {
            "id": "20150122",
            "speakerId": 1037,
            "speakerName": "珊瑚宫心海",
            "text": "在收缴邪眼的时候，我确实想过。工厂既要庞大，又必须隐蔽，还要邻近交通要道，保证原材料供应…",
            "nextDialogs": [
              "20150123"
            ]
          },
          "20150123": {
            "id": "20150123",
            "speakerId": 1037,
            "speakerName": "珊瑚宫心海",
            "text": "符合这些条件的地方不多，再结合士兵们收到邪眼的地点推断，工厂很可能是在<color=#00E1FFFF>八酝岛</color>西南部的临海山崖。",
            "nextDialogs": [
              "20150124"
            ]
          },
          "20150124": {
            "id": "20150124",
            "speakerId": 1037,
            "speakerName": "珊瑚宫心海",
            "text": "我不会阻止你，但你一定要小心。",
            "nextDialogs": [
              "20150125"
            ]
          },
          "20150125": {
            "id": "20150125",
            "speakerId": 1037,
            "speakerName": "珊瑚宫心海",
            "text": "我们失去了很多曾并肩作战的人，不想再失去你了。",
            "nextDialogs": [
              "20150126"
            ]
          },
          "20150126": {
            "id": "20150126",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "我们也走吧。",
            "nextDialogs": [
              "20150127"
            ]
          },
          "20150127": {
            "id": "20150127",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "欸？要去那个<color=#00E1FFFF>邪眼工厂</color>吗？",
            "nextDialogs": [
              "20150128"
            ]
          },
          "20150128": {
            "id": "20150128",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "……",
            "nextDialogs": [
              "20150129"
            ]
          },
          "20150129": {
            "id": "20150129",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "真的吗？真的不再考虑一下吗？好吧…"
          }
        }
      }
    },

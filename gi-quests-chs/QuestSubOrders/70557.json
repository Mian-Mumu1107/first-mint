  "subQuests": [
    {
      "subId": "7055701",
      "subQuestName": "(test)隐藏$HIDDEN",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "705570101"
        ],
        "dialogs": {
          "705570101": {
            "id": "705570101",
            "speakerId": 30977,
            "speakerName": "赫得蔚格",
            "text": "我还是有点遗憾！应该让代理团长的「剑压」更有威势一点，最好一剑直接劈开山峦，这才符合「狮牙骑士」的威名！",
            "nextDialogs": [
              "705570102"
            ]
          },
          "705570102": {
            "id": "705570102",
            "speakerId": 1004,
            "speakerName": "凯亚",
            "text": "嗯，从士气的角度，我支持，从演出效果的角度，我觉得目前的艺术加工程度，已经完全达标了。",
            "nextDialogs": [
              "705570103"
            ]
          },
          "705570103": {
            "id": "705570103",
            "speakerId": 30974,
            "speakerName": "霍肯",
            "text": "代理团长同意我们适当让她的形象来小游戏里客串的时候，应该没想到我们会办得这么夸张。",
            "nextDialogs": [
              "705570104"
            ]
          },
          "705570104": {
            "id": "705570104",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "这是在聊什么呢？",
            "nextDialogs": [
              "705570105"
            ]
          },
          "705570105": {
            "id": "705570105",
            "speakerId": 1004,
            "speakerName": "凯亚",
            "text": "哎呀，正好！荣誉骑士和派蒙，要不要来体验一下骑兵小队准备的「骑士话剧」？",
            "nextDialogs": [
              "705570108"
            ]
          },
          "705570108": {
            "id": "705570108",
            "speakerId": 30977,
            "speakerName": "赫得蔚格",
            "text": "本质上，它是一种结合了蒙德服化道与枫丹映影技术的「实景战斗体验游戏」…",
            "nextDialogs": [
              "705570109"
            ]
          },
          "705570109": {
            "id": "705570109",
            "speakerId": 30977,
            "speakerName": "赫得蔚格",
            "text": "进入我们搭建的影棚后，与强敌尽情战斗，体验各种故事中英雄般的豪情。",
            "nextDialogs": [
              "705570110"
            ]
          },
          "705570110": {
            "id": "705570110",
            "speakerId": 30977,
            "speakerName": "赫得蔚格",
            "text": "而骑士一词，指的是，在战斗中，一旦你的「信念」达到强烈的水准，就能唤来「狮牙骑士」的幻影…",
            "nextDialogs": [
              "705570111"
            ]
          },
          "705570111": {
            "id": "705570111",
            "speakerId": 30977,
            "speakerName": "赫得蔚格",
            "text": "进而用「蒲公英剑压」风卷落叶般成片击倒邪恶势力！",
            "nextDialogs": [
              "705570112"
            ]
          },
          "705570112": {
            "id": "705570112",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "哦？狮牙骑士，那不就是琴吗…",
            "nextDialogs": [
              "705570113"
            ]
          },
          "705570113": {
            "id": "705570113",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "听起来，这两位骑士好像特别敬重琴？",
            "nextDialogs": [
              "705570114"
            ]
          },
          "705570114": {
            "id": "705570114",
            "speakerId": 1004,
            "speakerName": "凯亚",
            "text": "哈哈，是啊。这个项目本来只有适度的切磋——归来的骑士需要好好放松，但如果只顾着休息，丢了实战的手感也不太好。",
            "nextDialogs": [
              "705570115"
            ]
          },
          "705570115": {
            "id": "705570115",
            "speakerId": 1004,
            "speakerName": "凯亚",
            "text": "后来，赫得蔚格提议引入「狮牙骑士之影」，丰富切磋的表现力。打得花哨点倒也不错，我就帮忙旁侧敲击了两句。",
            "nextDialogs": [
              "705570116"
            ]
          },
          "705570116": {
            "id": "705570116",
            "speakerId": 30977,
            "speakerName": "赫得蔚格",
            "text": "多谢凯亚队长…毕竟，远征队离开了好几年，我想让大家知道，代理团长这些年来也在不断变强…",
            "nextDialogs": [
              "705570117"
            ]
          },
          "705570117": {
            "id": "705570117",
            "speakerId": 30977,
            "speakerName": "赫得蔚格",
            "text": "文职工作上，代理团长已经达到了无可挑剔的境界，而战斗的技巧，也抵达了我们这些骑士一辈子都仰望的高峰…",
            "nextDialogs": [
              "705570118"
            ]
          },
          "705570118": {
            "id": "705570118",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "原来如此！赫得蔚格小姐真是有心了！",
            "nextDialogs": [
              "705570119"
            ]
          },
          "705570119": {
            "id": "705570119",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "听你这么一说，我马上就想试试看，蒲公英剑压会是什么样的呢…"
          }
        }
      }
    }
  ]
}
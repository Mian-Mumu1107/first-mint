    {
      "subId": "7351901",
      "subQuestName": "与维纳亚克对话",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "735190101"
        ],
        "dialogs": {
          "735190101": {
            "id": "735190101",
            "speakerId": 1000,
            "speakerName": "维纳亚克",
            "text": "真是难懂啊…明明是她说要去咖啡馆写报告的…",
            "nextDialogs": [
              "735190104"
            ]
          },
          "735190104": {
            "id": "735190104",
            "speakerId": 1000,
            "speakerName": "维纳亚克",
            "text": "嗨，别提了，她一个人写报告去了。",
            "nextDialogs": [
              "735190105"
            ]
          },
          "735190105": {
            "id": "735190105",
            "speakerId": 1000,
            "speakerName": "维纳亚克",
            "text": "昨天我们俩约在咖啡馆见面，可她花了好长时间才出现，甚至连写报告用的材料跟纸笔都没带！",
            "nextDialogs": [
              "735190106"
            ]
          },
          "735190106": {
            "id": "735190106",
            "speakerId": 1000,
            "speakerName": "维纳亚克",
            "text": "我批评了她不该浪费写报告的时间，结果她突然就又生气了！说什么报告她一个人写就完事，还把我给赶了出来！",
            "nextDialogs": [
              "735190107"
            ]
          },
          "735190107": {
            "id": "735190107",
            "speakerId": 1000,
            "speakerName": "维纳亚克",
            "text": "——真是岂有此理！你说对不对！",
            "nextDialogs": [
              "735190108"
            ]
          },
          "735190108": {
            "id": "735190108",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "……",
            "nextDialogs": [
              "735190109"
            ]
          },
          "735190109": {
            "id": "735190109",
            "speakerId": 1000,
            "speakerName": "维纳亚克",
            "text": "唉，不过她这反反复复生气的性子，我也早就已经习惯啦，过几天就会正常的。",
            "nextDialogs": [
              "735190110"
            ]
          },
          "735190110": {
            "id": "735190110",
            "speakerId": 1000,
            "speakerName": "维纳亚克",
            "text": "——要是她的心情，也像机关那么简单就好了。"
          }
        }
      }
    }
  ]
}
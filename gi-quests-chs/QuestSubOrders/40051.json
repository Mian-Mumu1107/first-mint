    {
      "subId": "4005111",
      "subQuestName": "打开通往大日御舆地下的通路",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "400511101"
        ],
        "dialogs": {
          "400511101": {
            "id": "400511101",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "震惊，居然真的能解决问题！",
            "nextDialogs": [
              "400511102"
            ]
          },
          "400511102": {
            "id": "400511102",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "这一次那个家伙没有骗我们呢。",
            "nextDialogs": [
              "400511103"
            ]
          },
          "400511103": {
            "id": "400511103",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "严格来说，他没怎么骗过我们。",
            "nextDialogs": [
              "400511104"
            ]
          },
          "400511104": {
            "id": "400511104",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "按照他那套诡辩来说是这样啦，你怎么感觉有点和他互相理解了！这可不行啊！",
            "nextDialogs": [
              "400511105"
            ]
          },
          "400511105": {
            "id": "400511105",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "现在大日御舆的通路应该被再次打开了，我们赶紧下去看看吧。"
          }
        }
      }
    },

    {
      "subId": "4005119",
      "subQuestName": "在大日御舆的地下寻找阿祇",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "400511901"
        ],
        "dialogs": {
          "400511901": {
            "id": "400511901",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "仔细数了一下，似乎年幼的小龙蜥已经不见了。应该是被救走了吧…",
            "nextDialogs": [
              "400511902"
            ]
          },
          "400511902": {
            "id": "400511902",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "这下面真的进来了深海龙蜥。那个家伙说的是真的…",
            "nextDialogs": [
              "400511903"
            ]
          },
          "400511903": {
            "id": "400511903",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "阿祇她难道真的是龙蜥人吗？",
            "nextDialogs": [
              "400511904"
            ]
          },
          "400511904": {
            "id": "400511904",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "不过到处都没有看到她，她究竟在哪里呢？",
            "nextDialogs": [
              "400511905"
            ]
          },
          "400511905": {
            "id": "400511905",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "唉，不想这么多了，我们返回上面吧。"
          }
        }
      }
    },
    {
      "subId": "4005114",
      "subQuestName": "返回大日御舆，调查情况",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [],
        "dialogs": {}
      }
    },
    {
      "subId": "4005115",
      "subQuestName": "与阿祇对话",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "400511501"
        ],
        "dialogs": {
          "400511501": {
            "id": "400511501",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "是，是阿祇！她在大日御舆面前想干什么？",
            "nextDialogs": [
              "400511502"
            ]
          },
          "400511502": {
            "id": "400511502",
            "speakerId": 1001,
            "speakerName": "阿祇",
            "text": "既然你们返回了这里，那我想问问，我们的营救成功了吗？",
            "nextDialogs": [
              "400511503"
            ]
          },
          "400511503": {
            "id": "400511503",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "有一些年幼的龙蜥已经被救走了。但是老弱的龙蜥在我们打败精英之后，躲回了水里。",
            "nextDialogs": [
              "400511504"
            ]
          },
          "400511504": {
            "id": "400511504",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "阿祇，你真的是龙蜥吗？",
            "nextDialogs": [
              "400511505"
            ]
          },
          "400511505": {
            "id": "400511505",
            "speakerId": 1001,
            "speakerName": "阿祇",
            "text": "我不准备和你多解释什么。虽然我有和你们沟通的能力，但是我已经明白了，和人的交流只能以背叛作结。",
            "nextDialogs": [
              "400511506"
            ]
          },
          "400511506": {
            "id": "400511506",
            "speakerId": 1001,
            "speakerName": "阿祇",
            "text": "我们两个物种，只能够一直厮杀下去。",
            "nextDialogs": [
              "400511507"
            ]
          },
          "400511507": {
            "id": "400511507",
            "speakerId": 1001,
            "speakerName": "阿祇",
            "text": "在我离开之前，我要摧毁这个灯塔。",
            "nextDialogs": [
              "400511508"
            ]
          },
          "400511508": {
            "id": "400511508",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "凭你做得到吗？",
            "nextDialogs": [
              "400511509"
            ]
          },
          "400511509": {
            "id": "400511509",
            "speakerId": 1001,
            "speakerName": "阿祇",
            "text": "你不要靠近了，也不要妄图偷袭我。",
            "nextDialogs": [
              "400511510"
            ]
          },
          "400511510": {
            "id": "400511510",
            "speakerId": 1001,
            "speakerName": "阿祇",
            "text": "这座高塔…似乎能听到我的愿望。只要我想，它就可以为了我变化光暗。",
            "nextDialogs": [
              "400511511"
            ]
          },
          "400511511": {
            "id": "400511511",
            "speakerId": 1001,
            "speakerName": "阿祇",
            "text": "甚至，只要我想，它就可以在我面前崩毁。",
            "nextDialogs": [
              "400511512"
            ]
          },
          "400511512": {
            "id": "400511512",
            "speakerId": 1001,
            "speakerName": "阿祇",
            "text": "只需要差不多捏紧拳头程度的念想，我就可以摧毁这个给龙蜥带来痛苦的东西。",
            "nextDialogs": [
              "400511513"
            ]
          },
          "400511513": {
            "id": "400511513",
            "speakerId": 1001,
            "speakerName": "阿祇",
            "text": "但是，为什么…无法动手…",
            "nextDialogs": [
              "400511514"
            ]
          },
          "400511514": {
            "id": "400511514",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "#呜啊，这可比失去血枝珊瑚要严重多了！{NICKNAME}，你有什么办法吗？",
            "nextDialogs": [
              "400511517"
            ]
          },
          "400511517": {
            "id": "400511517",
            "speakerId": 1001,
            "speakerName": "阿祇",
            "text": "这是…啊！",
            "nextDialogs": [
              "400511518"
            ]
          },
          "400511518": {
            "id": "400511518",
            "speakerId": 1003,
            "speakerName": "Black Screen",
            "text": "阿祇想到了自己的挂坠，并将其与碎片拼合在了一起。",
            "nextDialogs": [
              "400511519"
            ]
          },
          "400511519": {
            "id": "400511519",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "这是，三条蛇纠缠在一起样式的…挂坠？",
            "nextDialogs": [
              "400511520"
            ]
          },
          "400511520": {
            "id": "400511520",
            "speakerId": 1001,
            "speakerName": "阿祇",
            "text": "这条挂坠，自我记事起就在我的身边。为什么能和你的两块挂坠拼合？",
            "nextDialogs": [
              "400511521"
            ]
          },
          "400511521": {
            "id": "400511521",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "你心里应该有自己的答案了。",
            "nextDialogs": [
              "400511522"
            ]
          },
          "400511522": {
            "id": "400511522",
            "speakerId": 1001,
            "speakerName": "阿祇",
            "text": "笑话，你是想说…想说…",
            "nextDialogs": [
              "400511523"
            ]
          },
          "400511523": {
            "id": "400511523",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "我不太明白…这块是心海的挂坠，这一块来自大日御舆，阿祇的那块从小就伴在身边…",
            "nextDialogs": [
              "400511524"
            ]
          },
          "400511524": {
            "id": "400511524",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "你属于海祇岛。",
            "nextDialogs": [
              "400511525"
            ]
          },
          "400511525": {
            "id": "400511525",
            "speakerId": 1001,
            "speakerName": "阿祇",
            "text": "……",
            "nextDialogs": [
              "400511526"
            ]
          },
          "400511526": {
            "id": "400511526",
            "speakerId": 1001,
            "speakerName": "阿祇",
            "text": "我从小就和龙蜥一起长大。除了这个挂坠伴身之外，还有几箱子书卷。我通过它们学习了人类语言和文字。",
            "nextDialogs": [
              "400511527"
            ]
          },
          "400511527": {
            "id": "400511527",
            "speakerId": 1001,
            "speakerName": "阿祇",
            "text": "但是渊下宫在不久之后，就一个人类都没有了。空空如也。",
            "nextDialogs": [
              "400511528"
            ]
          },
          "400511528": {
            "id": "400511528",
            "speakerId": 1001,
            "speakerName": "阿祇",
            "text": "直到最近，我才有机会和人类接触。直到最近，我才知道书卷里的内容和意义。",
            "nextDialogs": [
              "400511529"
            ]
          },
          "400511529": {
            "id": "400511529",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "阿祇…",
            "nextDialogs": [
              "400511530"
            ]
          },
          "400511530": {
            "id": "400511530",
            "speakerId": 1001,
            "speakerName": "阿祇",
            "text": "你们人类书上有句俗话，我一直不明白。不过我刚才理解了。",
            "nextDialogs": [
              "400511531"
            ]
          },
          "400511531": {
            "id": "400511531",
            "speakerId": 1001,
            "speakerName": "阿祇",
            "text": "「人属于他出生的地方，畜生属于它吃饱的地方。」我是龙蜥，我不是人。所以我要回去了。",
            "nextDialogs": [
              "400511532"
            ]
          },
          "400511532": {
            "id": "400511532",
            "speakerId": 1001,
            "speakerName": "阿祇",
            "text": "大日御舆，就随便了吧。总有一天，我们还会回来的。",
            "nextDialogs": [
              "400511534"
            ]
          },
          "400511534": {
            "id": "400511534",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "阿祇，走掉了。",
            "nextDialogs": [
              "400511535"
            ]
          },
          "400511535": {
            "id": "400511535",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "所以最后为什么她突然改变心意了啊？",
            "nextDialogs": [
              "400511536"
            ]
          },
          "400511536": {
            "id": "400511536",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "或许心海能明白。",
            "nextDialogs": [
              "400511537"
            ]
          },
          "400511537": {
            "id": "400511537",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "嗯嗯，没错。如果是那个心海的话，应该预料到了这个情况，才会把碎片挂坠给我们吧。",
            "nextDialogs": [
              "400511538"
            ]
          },
          "400511538": {
            "id": "400511538",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "现在问题也算是圆满解决了。我们回去告诉她吧。"
          }
        }
      }
    },
    {
      "subId": "4005116",
      "subQuestName": "离开渊下宫，与心海对话",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "400511601"
        ],
        "dialogs": {
          "400511601": {
            "id": "400511601",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "喂，心海！",
            "nextDialogs": [
              "400511602"
            ]
          },
          "400511602": {
            "id": "400511602",
            "speakerId": 1004,
            "speakerName": "珊瑚宫心海",
            "text": "啊，你们回来了。刚才撤回的军士们和我说了一下前情。",
            "nextDialogs": [
              "400511603"
            ]
          },
          "400511603": {
            "id": "400511603",
            "speakerId": 1004,
            "speakerName": "珊瑚宫心海",
            "text": "你和那个名叫阿祇的巫女合作，成功清除了黑雾，但是大日御舆却突发了异变。是吗？",
            "nextDialogs": [
              "400511604"
            ]
          },
          "400511604": {
            "id": "400511604",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "是这样的。后面发生了一些很离奇的事情哦。",
            "nextDialogs": [
              "400511605"
            ]
          },
          "400511605": {
            "id": "400511605",
            "speakerId": 1003,
            "speakerName": "Black Screen",
            "text": "和心海讲述了之后发生的事情。",
            "nextDialogs": [
              "400511606"
            ]
          },
          "400511606": {
            "id": "400511606",
            "speakerId": 1004,
            "speakerName": "珊瑚宫心海",
            "text": "这样吗？",
            "nextDialogs": [
              "400511607"
            ]
          },
          "400511607": {
            "id": "400511607",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "唔，有点对不起心海。我们把你给我们的挂坠送出去了。",
            "nextDialogs": [
              "400511608"
            ]
          },
          "400511608": {
            "id": "400511608",
            "speakerId": 1004,
            "speakerName": "珊瑚宫心海",
            "text": "不用介意。就像我之前说的，海祇岛已经不再需要它了。",
            "nextDialogs": [
              "400511609"
            ]
          },
          "400511609": {
            "id": "400511609",
            "speakerId": 1004,
            "speakerName": "珊瑚宫心海",
            "text": "它是最初海祇大御神在渊下宫整顿朝官，改革制度时留下的东西。三枚挂坠分别留给大日御舆、珊瑚宫一脉和海祇御使。",
            "nextDialogs": [
              "400511610"
            ]
          },
          "400511610": {
            "id": "400511610",
            "speakerId": 1004,
            "speakerName": "珊瑚宫心海",
            "text": "本意也是想让乡人、地走官和神使之间能互相监督。但是如今除去乡人后代兴旺，其他两系凋敝。这个挂坠也没什么用处了。",
            "nextDialogs": [
              "400511611"
            ]
          },
          "400511611": {
            "id": "400511611",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "你说海祇御使…似乎也有士兵认为阿祇是海祇神的使者来着？可惜竖眼瞳其实是蜥蜴的特征，我们都被骗了。",
            "nextDialogs": [
              "400511612"
            ]
          },
          "400511612": {
            "id": "400511612",
            "speakerId": 1004,
            "speakerName": "珊瑚宫心海",
            "text": "并不是哦。海祇御使的造像通常半人半蛇，用以象征他们乃是蛇神的眷属。但是后期海祇御使除去瞳孔，确实与人无异。",
            "nextDialogs": [
              "400511613"
            ]
          },
          "400511613": {
            "id": "400511613",
            "speakerId": 1004,
            "speakerName": "珊瑚宫心海",
            "text": "反而龙蜥人、地底蜥蜴人的故事…从来就是小说里才会有的设定吧。珊瑚宫的机密文件里都没有这种东西存在的证据哦。",
            "nextDialogs": [
              "400511614"
            ]
          },
          "400511614": {
            "id": "400511614",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "啊，所以说，阿祇其实不是龙蜥？",
            "nextDialogs": [
              "400511615"
            ]
          },
          "400511615": {
            "id": "400511615",
            "speakerId": 1004,
            "speakerName": "珊瑚宫心海",
            "text": "海祇大御神耗尽力量创造海祇岛之后，力量逐渐衰弱。因此海祇御使不再诞生了。最后有记录的一位御使…",
            "nextDialogs": [
              "400511616"
            ]
          },
          "400511616": {
            "id": "400511616",
            "speakerId": 1004,
            "speakerName": "珊瑚宫心海",
            "text": "被寄予厚望，能沟通龙蜥与人类的御使——她在婴孩时代，随同其监护巫女，在渊下宫边陲被龙蜥袭击，自此下落不明。",
            "nextDialogs": [
              "400511617"
            ]
          },
          "400511617": {
            "id": "400511617",
            "speakerId": 1004,
            "speakerName": "珊瑚宫心海",
            "text": "很多人都认为她死了，不过也有一部分人认为她被龙蜥们抚养长大了。",
            "nextDialogs": [
              "400511618"
            ]
          },
          "400511618": {
            "id": "400511618",
            "speakerId": 1004,
            "speakerName": "珊瑚宫心海",
            "text": "御使一族对海祇民恩重如山。如今龙蜥和海祇岛不再有生存领土的争端，我真心地祝愿那位能找到自己的归处。",
            "nextDialogs": [
              "400511619"
            ]
          },
          "400511619": {
            "id": "400511619",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "原来阿祇的身世是这样的啊…",
            "nextDialogs": [

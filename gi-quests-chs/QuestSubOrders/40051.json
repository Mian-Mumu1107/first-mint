  "subQuests": [
    {
      "subId": "4005101",
      "subQuestName": "返回大日御舆处，寻找阿祇",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "400510101"
        ],
        "dialogs": {
          "400510101": {
            "id": "400510101",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "阿祇，我们做到了哦！",
            "nextDialogs": [
              "400510102"
            ]
          },
          "400510102": {
            "id": "400510102",
            "speakerId": 1001,
            "speakerName": "阿祇",
            "text": "我已经看到你们的成果了。三座塔确实都处理完了。",
            "nextDialogs": [
              "400510103"
            ]
          },
          "400510103": {
            "id": "400510103",
            "speakerId": 1001,
            "speakerName": "阿祇",
            "text": "伤员和军士们因为渊下宫环境的恢复，都已经加速撤离了。呃，大部分都撤离了…",
            "nextDialogs": [
              "400510104"
            ]
          },
          "400510104": {
            "id": "400510104",
            "speakerId": 1001,
            "speakerName": "阿祇",
            "text": "不过似乎发生了一些没有预料到的事情。两位请随我来。"
          }
        }
      }
    },
    {
      "subId": "4005102",
      "subQuestName": "前往大日御舆入口处",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "400510201"
        ],
        "dialogs": {
          "400510201": {
            "id": "400510201",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "大日御舆内部出现了翻涌的黑暗！",
            "nextDialogs": [
              "400510202"
            ]
          },
          "400510202": {
            "id": "400510202",
            "speakerId": 1001,
            "speakerName": "阿祇",
            "text": "本来按照常理，现在渊下宫应该全境都恢复如初了才对…",
            "nextDialogs": [
              "400510203"
            ]
          },
          "400510203": {
            "id": "400510203",
            "speakerId": 1001,
            "speakerName": "阿祇",
            "text": "很遗憾，现在这里变成了最危险的地方。我也不知道为什么会这样，应该怎么办了。",
            "nextDialogs": [
              "400510204"
            ]
          },
          "400510204": {
            "id": "400510204",
            "speakerId": 1001,
            "speakerName": "阿祇",
            "text": "不过我能告诉你幕后黑手现在正在何处。只能麻烦你前去对付那个幕后黑手，让他把计划全盘托出了。",
            "nextDialogs": [
              "400510205"
            ]
          },
          "400510205": {
            "id": "400510205",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "这是怎么办到的？",
            "nextDialogs": [
              "400510206"
            ]
          },
          "400510206": {
            "id": "400510206",
            "speakerId": 1001,
            "speakerName": "阿祇",
            "text": "我一直在观察黑雾的流动，大概还是能看出一些异样的。",
            "nextDialogs": [
              "400510207"
            ]
          },
          "400510207": {
            "id": "400510207",
            "speakerId": 1001,
            "speakerName": "阿祇",
            "text": "有一个微弱的涡旋，之前在持续吸引黑雾。应该是他对深渊之力有所需求引发的微弱流动。",
            "nextDialogs": [
              "400510208"
            ]
          },
          "400510208": {
            "id": "400510208",
            "speakerId": 1001,
            "speakerName": "阿祇",
            "text": "那个家伙很危险，一般龙蜥可能都不是他的对手…",
            "nextDialogs": [
              "400510211"
            ]
          },
          "400510211": {
            "id": "400510211",
            "speakerId": 1001,
            "speakerName": "阿祇",
            "text": "如此甚好，那么就麻烦你了。",
            "nextDialogs": [
              "400510212"
            ]
          },
          "400510212": {
            "id": "400510212",
            "speakerId": 1001,
            "speakerName": "阿祇",
            "text": "如果推测没错的话，他应该就在<color=#00E1FFFF>图书馆</color>一带。"
          }
        }
      }
    },
    {
      "subId": "4005103",
      "subQuestName": "前往寻找深渊咏者",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "400510301"
        ],
        "dialogs": {
          "400510301": {
            "id": "400510301",
            "speakerId": 1002,
            "speakerName": "自称「渊上」之物",
            "text": "嚯，该说意外呢，还是说毫不意外呢。在这种黑暗之中，仍然要执意前行，破开雾霾，来到我的面前。",
            "nextDialogs": [
              "400510302"
            ]
          },
          "400510302": {
            "id": "400510302",
            "speakerId": 1002,
            "speakerName": "自称「渊上」之物",
            "text": "如果还有人能做到这点，那恐怕就只有你了。但是，你居然会和它们联手？",
            "nextDialogs": [
              "400510303"
            ]
          },
          "400510303": {
            "id": "400510303",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "你又想靠着聊天拖延时间了吧！",
            "nextDialogs": [
              "400510304"
            ]
          },
          "400510304": {
            "id": "400510304",
            "speakerId": 1002,
            "speakerName": "自称「渊上」之物",
            "text": "…这样啊，看起来你们是真的不知道啊。",
            "nextDialogs": [
              "400510305"
            ]
          },
          "400510305": {
            "id": "400510305",
            "speakerId": 1002,
            "speakerName": "自称「渊上」之物",
            "text": "见到我血气上涌可以理解，但是跑了这么久还这么精力充沛，还真的有点麻烦。",
            "nextDialogs": [
              "400510306"
            ]
          },
          "400510306": {
            "id": "400510306",
            "speakerId": 1002,
            "speakerName": "自称「渊上」之物",
            "text": "陪你们运动一下吧。直到你能停下来听我说话为止。"
          }
        }
      }
    },
    {
      "subId": "4005104",
      "subQuestName": "击败深渊咏者",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [],
        "dialogs": {}
      }
    },
    {
      "subId": "4005105",
      "subQuestName": "与深渊咏者对话",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "400510501"
        ],
        "dialogs": {
          "400510501": {
            "id": "400510501",
            "speakerId": 1002,
            "speakerName": "自称「渊上」之物",
            "text": "停一下停一下！再打我要死了！",
            "nextDialogs": [
              "400510502"
            ]
          },
          "400510502": {
            "id": "400510502",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "冲着这个来的！",
            "nextDialogs": [
              "400510503"
            ]
          },
          "400510503": {
            "id": "400510503",
            "speakerId": 1002,
            "speakerName": "自称「渊上」之物",
            "text": "那个女人，细长瞳孔的女人，她自称的名字是什么？",
            "nextDialogs": [
              "400510504"
            ]
          },
          "400510504": {
            "id": "400510504",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "欸，你为什么知道？",
            "nextDialogs": [
              "400510505"
            ]
          },
          "400510505": {
            "id": "400510505",
            "speakerId": 1002,
            "speakerName": "自称「渊上」之物",
            "text": "她叫什么名字？",
            "nextDialogs": [
              "400510506"
            ]
          },
          "400510506": {
            "id": "400510506",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "她自称，阿祇。",
            "nextDialogs": [
              "400510507"
            ]
          },
          "400510507": {
            "id": "400510507",
            "speakerId": 1002,
            "speakerName": "自称「渊上」之物",
            "text": "哼，明明只是条蜥蜴，学人学得有模有样。",
            "nextDialogs": [
              "400510508"
            ]
          },
          "400510508": {
            "id": "400510508",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "蜥蜴…",
            "nextDialogs": [
              "400510509"
            ]
          },
          "400510509": {
            "id": "400510509",
            "speakerId": 1002,
            "speakerName": "自称「渊上」之物",
            "text": "你也想到了，对吧。深海龙蜥可是很聪明，而且进化很快的族群。早在千年之前，就有过这种传说了。",
            "nextDialogs": [
              "400510510"
            ]
          },
          "400510510": {
            "id": "400510510",
            "speakerId": 1002,
            "speakerName": "自称「渊上」之物",
            "text": "——龙蜥人。",
            "nextDialogs": [
              "400510511"
            ]
          },
          "400510511": {
            "id": "400510511",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "龙蜥…人？听起来像是我会取的外号。",
            "nextDialogs": [
              "400510512"
            ]
          },
          "400510512": {
            "id": "400510512",
            "speakerId": 1002,
            "speakerName": "自称「渊上」之物",
            "text": "很久以前，渊下宫就有这样的传说了。深海龙蜥被击退之后，为了生存开始了新的进化。他们开始模仿胜者的姿态。",
            "nextDialogs": [
              "400510513"
            ]
          },
          "400510513": {
            "id": "400510513",
            "speakerId": 1002,
            "speakerName": "自称「渊上」之物",
            "text": "最后出现了除了瞳孔之外，和人类别无二致的龙蜥族群——龙蜥人。传说他们渗透进了渊下宫，替换掉了要人们的位置。",
            "nextDialogs": [
              "400510514"
            ]
          },
          "400510514": {
            "id": "400510514",
            "speakerId": 1002,
            "speakerName": "自称「渊上」之物",
            "text": "怎么样，有想起谁吗？",
            "nextDialogs": [
              "400510515"
            ]
          },
          "400510515": {
            "id": "400510515",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "阿祇的瞳孔，好像听说确实是竖着的…",
            "nextDialogs": [
              "400510516"
            ]
          },
          "400510516": {
            "id": "400510516",
            "speakerId": 1002,
            "speakerName": "自称「渊上」之物",
            "text": "蜥蜴在光线充足的地方，眼瞳就是细长的一条竖线哦。这个可是她背叛你们的铁证。",
            "nextDialogs": [
              "400510517"
            ]
          },
          "400510517": {
            "id": "400510517",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "但是她一直在帮助我们啊。",
            "nextDialogs": [
              "400510518"
            ]
          },
          "400510518": {
            "id": "400510518",
            "speakerId": 1002,
            "speakerName": "自称「渊上」之物",
            "text": "她只是在利用你们对我复仇罢了，毕竟我也背叛了它们啊。",
            "nextDialogs": [
              "400510519"
            ]
          },
          "400510519": {
            "id": "400510519",
            "speakerId": 1002,
            "speakerName": "自称「渊上」之物",
            "text": "我之前与龙蜥结成过同盟。我可以用黑雾笼罩整个渊下宫，方便它们的精锐潜下大日御舆，拯救被囚禁的同族。",
            "nextDialogs": [
              "400510520"
            ]
          },
          "400510520": {
            "id": "400510520",
            "speakerId": 1002,
            "speakerName": "自称「渊上」之物",
            "text": "作为协助，它们许可深渊教团在它们领地上通行，并且出功出力同我一起改造了三塔。",
            "nextDialogs": [
              "400510521"
            ]
          },
          "400510521": {
            "id": "400510521",
            "speakerId": 1002,
            "speakerName": "自称「渊上」之物",
            "text": "但是它们没有预料到，深渊的黑雾对元素生物来说是更加可怕的剧毒。",
            "nextDialogs": [
              "400510522"
            ]
          },
          "400510522": {
            "id": "400510522",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "所以，龙蜥们认为这是背叛？",
            "nextDialogs": [
              "400510523"
            ]
          },
          "400510523": {
            "id": "400510523",
            "speakerId": 1002,
            "speakerName": "自称「渊上」之物",
            "text": "我自己都认为这个是背叛啊。毕竟要是龙蜥能在深渊力量下活蹦乱跳，深渊教团岂不是很没面子。",
            "nextDialogs": [
              "400510524"
            ]
          },
          "400510524": {
            "id": "400510524",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "你这家伙！",
            "nextDialogs": [
              "400510525"
            ]
          },
          "400510525": {
            "id": "400510525",
            "speakerId": 1002,
            "speakerName": "自称「渊上」之物",
            "text": "现在的情况就是那个女人利用完你们，转手就自己利用大日御舆的力量压制珊瑚虫，制造黑暗掩护龙蜥。",
            "nextDialogs": [
              "400510526"
            ]
          },
          "400510526": {
            "id": "400510526",
            "speakerId": 1002,
            "speakerName": "自称「渊上」之物",
            "text": "它们估计现在正在潜下深处，准备拯救那些被囚禁的同伴吧。如此一来，血枝珊瑚的来源就断绝了。",
            "nextDialogs": [
              "400510527"
            ]
          },
          "400510527": {
            "id": "400510527",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "虽然那些深海龙蜥确实很可怜，但是…",
            "nextDialogs": [
              "400510528"
            ]
          },
          "400510528": {
            "id": "400510528",
            "speakerId": 1002,
            "speakerName": "自称「渊上」之物",
            "text": "如果你们还打算保护海祇岛的未来，就得赶快咯。",
            "nextDialogs": [
              "400510529"
            ]
          },
          "400510529": {
            "id": "400510529",
            "speakerId": 1002,
            "speakerName": "自称「渊上」之物",
            "text": "使用我之前留下的机关，引导光路去驱散大日御舆的黑暗。",
            "nextDialogs": [
              "400510530"
            ]
          },
          "400510530": {
            "id": "400510530",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "你这个人说话我们再也不会相信了！",
            "nextDialogs": [
              "400510531"
            ]
          },
          "400510531": {
            "id": "400510531",
            "speakerId": 1002,
            "speakerName": "自称「渊上」之物",
            "text": "真是的，现在难道你们还有的选吗？",
            "nextDialogs": [
              "400510532"
            ]
          },
          "400510532": {
            "id": "400510532",
            "speakerId": 1002,
            "speakerName": "自称「渊上」之物",
            "text": "反正我这次来依旧是一无所获。不过无所谓了，我在教团之中也不过是边缘人物。",
            "nextDialogs": [
              "400510533"
            ]
          },
          "400510533": {
            "id": "400510533",
            "speakerId": 1002,
            "speakerName": "自称「渊上」之物",
            "text": "和那些围着殿下团团转的家伙不同，我总是执着于一些无所谓的事情。",
            "nextDialogs": [
              "400510534"
            ]
          },
          "400510534": {
            "id": "400510534",
            "speakerId": 1002,
            "speakerName": "自称「渊上」之物",
            "text": "啊，时间差不多拖延到位了。这次我也先走一步了，应该不会再见了吧。这个东西就作为临别赠礼给你吧，我之前在大日御舆拿到的。",
            "nextDialogs": [
              "400510535"
            ]
          },
          "400510535": {
            "id": "400510535",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "这个东西，似乎和心海给我们的是一套欸。不对，不是在意这个的时候了…",
            "nextDialogs": [
              "400510536"
            ]
          },
          "400510536": {
            "id": "400510536",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "真是生气啊，这家伙又跑了！",
            "nextDialogs": [
              "400510537"
            ]
          },
          "400510537": {
            "id": "400510537",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "我觉得他说的再有道理我们也不能相信，先回去找阿祇问问吧。"
          }
        }
      }
    },
    {
      "subId": "4005117",
      "subQuestName": "返回大日御舆处，寻找阿祇",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "400511701"
        ],
        "dialogs": {
          "400511701": {
            "id": "400511701",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "阿祇似乎真的不见了…",
            "nextDialogs": [
              "400511702"
            ]
          },
          "400511702": {
            "id": "400511702",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "刚才一路走来，应该没有看漏吧。",
            "nextDialogs": [
              "400511703"
            ]
          },
          "400511703": {
            "id": "400511703",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "…又是这个情节。",
            "nextDialogs": [
              "400511704"
            ]
          },
          "400511704": {
            "id": "400511704",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "唔，好了好了别消沉了。",
            "nextDialogs": [
              "400511705"
            ]
          },
          "400511705": {
            "id": "400511705",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "往好里想，海祇岛的军士大部分都撤走了。如果刚才真的有龙蜥来过这里，至少没人因此受伤。",
            "nextDialogs": [
              "400511706"
            ]
          },
          "400511706": {
            "id": "400511706",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "虽然想到那个家伙就生气，但是我们只能试一试了。去把光路引导到这里吧。"
          }
        }
      }
    },

  "subQuests": [
    {
      "subId": "7517801",
      "subQuestName": "",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "751780101"
        ],
        "dialogs": {
          "751780101": {
            "id": "751780101",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "你好啊！请问…",
            "nextDialogs": [
              "751780102"
            ]
          },
          "751780102": {
            "id": "751780102",
            "speakerId": 1001,
            "speakerName": "卢施",
            "text": "#如此强大的「烈度」！不愧是传说的{NICKNAME}和派蒙！你们远道而来，莫不是来竞争这「沃陆之邦最强」名号的？",
            "nextDialogs": [
              "751780103"
            ]
          },
          "751780103": {
            "id": "751780103",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "「沃陆之邦最强」？这里不就是普通的「勇士挑战」吗？那边明明有那么多人在排队呢！",
            "nextDialogs": [
              "751780104"
            ]
          },
          "751780104": {
            "id": "751780104",
            "speakerId": 1001,
            "speakerName": "卢施",
            "text": "哈哈哈，他们可没办法跟你们相提并论。要知道，想要获得「最强」之名，只有战胜「最强」一途，寻常人可没这个资格。",
            "nextDialogs": [
              "751780105"
            ]
          },
          "751780105": {
            "id": "751780105",
            "speakerId": 1001,
            "speakerName": "卢施",
            "text": "你们来得好啊！不过可惜啊，甚是可惜，你们来得不是时候。大师他现在无暇顾及这世上的俗务，恐怕暂时没有直面他的机会。",
            "nextDialogs": [
              "751780108",
              "751780109"
            ]
          },
          "751780108": {
            "id": "751780108",
            "speakerId": 1001,
            "speakerName": "卢施",
            "text": "哦——？你是准备上门一战吗？好胆色，那我把大师的行踪告诉你也无妨。",
            "nextDialogs": [
              "751780110"
            ]
          },
          "751780110": {
            "id": "751780110",
            "speakerId": 1001,
            "speakerName": "卢施",
            "text": "沿着那条崎岖的修行之路寻找，你们会发现一片充满「烈度之水」的山地。在那里，你们或许能找到「最强」的身影…"
          },
          "751780109": {
            "id": "751780109",
            "speakerId": 1001,
            "speakerName": "卢施",
            "text": "甚是，甚是，「烈度」与「烈度」终会相互吸引，「最强」与「最强」定会相遇，等待也不失为一种选择。"
          }
        }
      }
    },
    {
      "subId": "7517812",
      "subQuestName": "工作人员常驻对话$HIDDEN",
      "sceneId": null,
      "locations": [],

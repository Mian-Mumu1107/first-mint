    {
      "subId": "7517803",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "751780301"
        ],
        "dialogs": {
          "751780301": {
            "id": "751780301",
            "speakerId": 1006,
            "speakerName": "？？？",
            "text": "奇欧奇欧，你们到底在哪啊…"
          }
        }
      }
    },
    {
      "subId": "7517809",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "751780901"
        ],
        "dialogs": {
          "751780901": {
            "id": "751780901",
            "speakerId": 1006,
            "speakerName": "？？？",
            "text": "#{NICKNAME}{M#哥哥}{F#姐姐}，你们好啊…",
            "nextDialogs": [
              "751780904",
              "751780907"
            ]
          },
          "751780904": {
            "id": "751780904",
            "speakerId": 1006,
            "speakerName": "？？？",
            "text": "其实…相比之前，温泉的水温好像还是有点冷…这次我闯了好大的祸，回去以后该怎么办啊…",
            "nextDialogs": [
              "751780905"
            ]
          },
          "751780905": {
            "id": "751780905",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "别担心，再等等看。",
            "nextDialogs": [
              "751780906"
            ]
          },
          "751780906": {
            "id": "751780906",
            "speakerId": 1006,
            "speakerName": "？？？",
            "text": "嗯，我知道了…"
          },
          "751780907": {
            "id": "751780907",
            "speakerId": 1006,
            "speakerName": "？？？",
            "text": "#唔…路上小心，{NICKNAME}{M#哥哥}{F#姐姐}。"
          }
        }
      }
    },
    {
      "subId": "7517810",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "751781001"
        ],
        "dialogs": {
          "751781001": {
            "id": "751781001",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "——唔，虽然先答应下来帮忙了。但…应该从哪里开始呢？",
            "nextDialogs": [
              "751781003",
              "751781006"
            ]
          },
          "751781003": {
            "id": "751781003",
            "speakerId": 1004,
            "speakerName": "#{REALNAME[ID(2)|SHOWHOST(true)]}",
            "text": "呀？",
            "nextDialogs": [
              "751781004"
            ]
          },
          "751781004": {
            "id": "751781004",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "这范围太大了！怎么想都不可能吧！",
            "nextDialogs": [
              "751781009"
            ]
          },
          "751781009": {
            "id": "751781009",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "唉…就没有什么更实际的办法吗…",
            "nextDialogs": [
              "751781010"
            ]
          },
          "751781010": {
            "id": "751781010",
            "speakerId": 1004,
            "speakerName": "#{REALNAME[ID(2)|SHOWHOST(true)]}",
            "text": "呀？",
            "nextDialogs": [
              "751781011"
            ]
          },
          "751781011": {
            "id": "751781011",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "#等等！{REALNAME[ID(2)|SHOWHOST(true)]}，不要乱跑啦！"
          },
          "751781006": {
            "id": "751781006",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "哦！我懂了，让小家伙帮忙挖个洞，然后用火山的熔岩来加热温泉对不？是个不错的办法呢…",
            "nextDialogs": [
              "751781007"
            ]
          },
          "751781007": {
            "id": "751781007",
            "speakerId": 1004,
            "speakerName": "#{REALNAME[ID(2)|SHOWHOST(true)]}",
            "text": "呀！呀！呀！",
            "nextDialogs": [
              "751781008"
            ]
          },
          "751781008": {
            "id": "751781008",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "#才怪呢！用熔岩是会闹出人命来的！认真一点啦！你看{REALNAME[ID(2)|SHOWHOST(true)]}都信了啊！"
          }
        }
      }
    },

    {
      "subId": "7517806",
      "subQuestName": "与莉娜夏对话",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "751781501"
        ],
        "dialogs": {
          "751781501": {
            "id": "751781501",
            "speakerId": 1006,
            "speakerName": "？？？",
            "text": "太好了！你们都回来啦！我差一点以为今天要闯大祸了！",
            "nextDialogs": [
              "751781502"
            ]
          },
          "751781502": {
            "id": "751781502",
            "speakerId": 1005,
            "speakerName": "马范",
            "text": "嗯？这是…好热！「烈度」正在聚集！噫！我成了！我真的成了！",
            "nextDialogs": [
              "751781503"
            ]
          },
          "751781503": {
            "id": "751781503",
            "speakerId": 1005,
            "speakerName": "马范",
            "text": "哈哈！何等的「烈度」！这是何等的「烈度」啊！",
            "nextDialogs": [
              "751781504"
            ]
          },
          "751781504": {
            "id": "751781504",
            "speakerId": 1005,
            "speakerName": "马范",
            "text": "——呃啊！"
          }
        }
      }
    },
    {
      "subId": "7517807",
      "subQuestName": "(test)大师热晕,黑屏$HIDDEN",

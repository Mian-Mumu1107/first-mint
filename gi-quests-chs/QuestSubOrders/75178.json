        "dialogs": {
          "751781701": {
            "id": "751781701",
            "speakerId": 1006,
            "speakerName": "？？？",
            "text": "#是{NICKNAME}{M#哥哥}{F#姐姐}！嘿嘿，好久不见啊！你们还好吗？",
            "nextDialogs": [
              "751781704",
              "751781708"
            ]
          },
          "751781704": {
            "id": "751781704",
            "speakerId": 1006,
            "speakerName": "？？？",
            "text": "嘿嘿，偷偷告诉你哦，我发现温泉的水温恢复正常了！这下好啦，小鳍游龙们可以开心地玩耍，我也不用提心吊胆了！",
            "nextDialogs": [
              "751781705"
            ]
          },
          "751781705": {
            "id": "751781705",
            "speakerId": 1006,
            "speakerName": "？？？",
            "text": "接下来我要开开心心地玩！好好享受温泉和火山！",
            "nextDialogs": [
              "751781706"
            ]
          },
          "751781706": {
            "id": "751781706",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "祝你开心！",
            "nextDialogs": [
              "751781707"
            ]
          },
          "751781707": {
            "id": "751781707",
            "speakerId": 1006,
            "speakerName": "？？？",
            "text": "#嗯嗯，{NICKNAME}{M#哥哥}{F#姐姐}也要开心哦！"
          },
          "751781708": {
            "id": "751781708",
            "speakerId": 1006,
            "speakerName": "？？？",
            "text": "#{NICKNAME}{M#哥哥}{F#姐姐}，一路顺风！"
          }
        }
      }
    },

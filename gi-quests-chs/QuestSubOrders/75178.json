        "dialogs": {}
      }
    },
    {
      "subId": "7517802",
      "subQuestName": "(test)没问位置$HIDDEN",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "751780201"
        ],
        "dialogs": {
          "751780201": {
            "id": "751780201",
            "speakerId": 1002,
            "speakerName": "尤鲁赫",
            "text": "有、有没有人帮忙搭把手！有人晕过去了！",
            "nextDialogs": [
              "751780202"
            ]
          },
          "751780202": {
            "id": "751780202",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "#完、完蛋了！大师好像晕过去了！我们也快去帮忙吧，{NICKNAME}！",
            "nextDialogs": [
              "751780203"
            ]
          },
          "751780203": {
            "id": "751780203",
            "speakerId": 1003,
            "speakerName": "Black Screen",
            "text": "大师似乎只是热晕了过去，身体并没有大碍。在你们的帮助下，晕倒的大师被尤鲁赫接走了…\\n看起来，大师本人的「烈度」，或许还有待进一步的提升…"
          }
        }
      }
    },
    {
      "subId": "7517811",
      "subQuestName": "(test)问了位置$HIDDEN",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "751781101"
        ],
        "dialogs": {
          "751781101": {
            "id": "751781101",
            "speakerId": 1004,
            "speakerName": "#{REALNAME[ID(2)|SHOWHOST(true)]}",
            "text": "呀？",
            "nextDialogs": [
              "751781102"
            ]
          },
          "751781102": {
            "id": "751781102",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "#等等！{REALNAME[ID(2)|SHOWHOST(true)]}，不要乱跑啦！"
          }
        }
      }
    },
    {
      "subId": "7517803",
      "subQuestName": "",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "751780701"
        ],
        "dialogs": {
          "751780701": {
            "id": "751780701",
            "speakerId": 1005,
            "speakerName": "马范",
            "text": "何等「冰冷」！这是何等的「冰冷」啊！",
            "nextDialogs": [
              "751780702"
            ]
          },
          "751780702": {
            "id": "751780702",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "欸、欸？！冷？哪里冷了？你不是在温泉里吗？",
            "nextDialogs": [
              "751780703"
            ]
          },
          "751780703": {
            "id": "751780703",
            "speakerId": 1005,
            "speakerName": "马范",
            "text": "不够！还不够！如此冰冷，如何堪称「最强」！要成为「沃陆之邦」，不对「纳塔最强」，这「烈度」还远远不够！",
            "nextDialogs": [
              "751780704"
            ]
          },
          "751780704": {
            "id": "751780704",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "欸？为什么又坐下了？为什么啊？",
            "nextDialogs": [
              "751780706",
              "751780708"
            ]
          },
          "751780706": {
            "id": "751780706",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "「烈度」到底是什么啊？怎么你说的话我也听不懂了啊！",
            "nextDialogs": [
              "751780709"
            ]
          },
          "751780709": {
            "id": "751780709",
            "speakerId": 1002,
            "speakerName": "尤鲁赫",
            "text": "#太棒了，想必两位就是著名的冒险家{NICKNAME}和派蒙了，这下有救了。",
            "nextDialogs": [
              "751780710"
            ]
          },
          "751780710": {
            "id": "751780710",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "什、什么？发生了什么？",
            "nextDialogs": [
              "751780711"
            ]
          },
          "751780711": {
            "id": "751780711",
            "speakerId": 1002,
            "speakerName": "尤鲁赫",
            "text": "实不相瞒两位，按照大师本人的话来说，他正在向着「最强」之路前进，沉浸在温泉修行之中。",
            "nextDialogs": [
              "751780712"
            ]
          },
          "751780712": {
            "id": "751780712",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "修、修行？在温泉里吗？",
            "nextDialogs": [
              "751780713"
            ]
          },
          "751780713": {
            "id": "751780713",
            "speakerId": 1002,
            "speakerName": "尤鲁赫",
            "text": "对、对啊…虽、虽然我也不是很敢相信。但这方法，是大师从一本名为《烈泉道》的武道书上看来的。",
            "nextDialogs": [
              "751780714"
            ]
          },
          "751780714": {
            "id": "751780714",
            "speakerId": 1002,
            "speakerName": "尤鲁赫",
            "text": "书上说，如果按照烈泉之道修炼，有朝一日可以只凭自己的「烈度」，让<color=#00E1FFFF>冷水沸腾</color>！",
            "nextDialogs": [
              "751780715"
            ]
          },
          "751780715": {
            "id": "751780715",
            "speakerId": 1002,
            "speakerName": "尤鲁赫",
            "text": "不仅如此，这书上还记录了好多强者，有的人可以一夜徒手打穿山体，还有的人可以空手将石头捏成宝石！",
            "nextDialogs": [
              "751780716"
            ]
          },
          "751780716": {
            "id": "751780716",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "#没想到世界上还有这么神奇的武道！要是{NICKNAME}也能学会的话…"
          },
          "751780708": {
            "id": "751780708",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "原来是这样，怪不得他全身正在发抖呢！"
          }
        }
      }
    },
    {
      "subId": "7517804",
      "subQuestName": "",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "751780401"
        ],
        "dialogs": {
          "751780401": {
            "id": "751780401",
            "speakerId": 1002,
            "speakerName": "尤鲁赫",
            "text": "该不会，《烈泉道》里说的都是真的吧…"
          }
        }
      }
    },
    {
      "subId": "7517814",
      "subQuestName": "",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "751781401"
        ],
        "dialogs": {
          "751781401": {
            "id": "751781401",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "咦，小鳍游龙？怎么会在这里？",
            "nextDialogs": [
              "751781402"
            ]
          },
          "751781402": {
            "id": "751781402",
            "speakerId": 1006,
            "speakerName": "？？？",
            "text": "——奇欧奇欧！你果然在这里…如、如果你们再不出来的话，我、我…",
            "nextDialogs": [
              "751781403"
            ]
          },
          "751781403": {
            "id": "751781403",
            "speakerId": 1006,
            "speakerName": "？？？",
            "text": "万一受伤了怎么办？下次可不许乱跑了，呜呜…",
            "nextDialogs": [
              "751781404"
            ]
          },
          "751781404": {
            "id": "751781404",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "别、别哭了，你看，小龙不是好好的吗？很有精神的！",
            "nextDialogs": [
              "751781405"
            ]
          },
          "751781405": {
            "id": "751781405",
            "speakerId": 1004,
            "speakerName": "#{REALNAME[ID(2)|SHOWHOST(true)]}",
            "text": "呀！呀！",
            "nextDialogs": [
              "751781406"
            ]
          },
          "751781406": {
            "id": "751781406",
            "speakerId": 1006,
            "speakerName": "？？？",
            "text": "嗯，没、没问题的。我、我叫莉娜夏，是「流泉之众」那边的…平时都是我负责照看小鳍游龙的…",
            "nextDialogs": [
              "751781407"
            ]
          },
          "751781407": {
            "id": "751781407",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "负责照看小鳍游龙？真了不起！",
            "nextDialogs": [
              "751781408"
            ]
          },
          "751781408": {
            "id": "751781408",
            "speakerId": 1006,
            "speakerName": "？？？",
            "text": "没、没有啦…我要是能像派蒙姐姐一样的话，它们肯定就不会跑丢了。",
            "nextDialogs": [
              "751781409"
            ]
          },
          "751781409": {
            "id": "751781409",
            "speakerId": 1006,
            "speakerName": "？？？",
            "text": "刚刚我就在想，是不是大家都跑去喷口玩了，所以才找不到。现在来看，果然是这样的…",
            "nextDialogs": [
              "751781410"
            ]
          },
          "751781410": {
            "id": "751781410",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "原来温泉变冷，是因为小鳍游龙们把燃素喷口堵住了啊。怪不得管理员都没发现呢！",
            "nextDialogs": [
              "751781411"
            ]
          },
          "751781411": {
            "id": "751781411",
            "speakerId": 1006,
            "speakerName": "？？？",
            "text": "派、派蒙姐姐！其实…我还有两只龙伙伴没找到，估计它们也是躲在燃素喷口里玩了…",
            "nextDialogs": [
              "751781412"
            ]
          },
          "751781412": {
            "id": "751781412",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "没问题，你放心吧！我们在调节水温的时候，会顺便把小鳍游龙们帮你找回来的！",
            "nextDialogs": [
              "751781413"
            ]
          },
          "751781413": {
            "id": "751781413",
            "speakerId": 1006,
            "speakerName": "？？？",
            "text": "嗯，有派蒙姐姐在，我就放心啦！",
            "nextDialogs": [
              "751781414"
            ]
          },
          "751781414": {
            "id": "751781414",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "啊哈哈，那当然，我可是传说中的冒险家，这等小事肯定是手到擒来！",
            "nextDialogs": [
              "751781415"
            ]
          },
          "751781415": {
            "id": "751781415",
            "speakerId": 1006,
            "speakerName": "？？？",
            "text": "哇！派蒙姐姐好厉害！我也要成为跟派蒙姐姐一样的人！",
            "nextDialogs": [
              "751781418"
            ]
          },
          "751781418": {
            "id": "751781418",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "（在外人面前，你给我一点面子嘛。要不，今天晚上我把最好吃的菜让给你，好不好？）",
            "nextDialogs": [
              "751781419"
            ]
          },
          "751781419": {
            "id": "751781419",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "咳咳，总而言之，我们出发吧！"
          }
        }
      }
    },

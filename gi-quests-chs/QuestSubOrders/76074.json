  "subQuests": [
    {
      "subId": "7607401",
      "subQuestName": "(test)隐藏$HIDDEN",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "760740101"
        ],
        "dialogs": {
          "760740101": {
            "id": "760740101",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "好奇怪的琴，不管怎么拨，都完全发不出声音…该不会是坏掉了吧？",
            "nextDialogs": [
              "760740103",
              "760740105"
            ]
          },
          "760740103": {
            "id": "760740103",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "嗯嗯，先不管琴了，只要跟着仙灵的指引到上面去，应该就能找到宝藏啦！"
          },
          "760740105": {
            "id": "760740105",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "真…真的吗？唔，除了风声，我什么也没听到，难道是那种「只有拨琴的人自己才能听到」的情况吗？",
            "nextDialogs": [
              "760740106"
            ]
          },
          "760740106": {
            "id": "760740106",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "好，让我也来弹一下试试看…",
            "nextDialogs": [
              "760740107"
            ]
          },
          "760740107": {
            "id": "760740107",
            "speakerId": 1001,
            "speakerName": "Black Screen",
            "text": "派蒙用力拨动了琴弦…\\n",
            "nextDialogs": [
              "760740108"
            ]
          },
          "760740108": {
            "id": "760740108",
            "speakerId": 1001,
            "speakerName": "Black Screen",
            "text": "同刚才一样，苍凉悲哀的旋律如清晨的微风般扬起，伴随着轻浅的歌——\\n",
            "nextDialogs": [
              "760740109"
            ]
          },
          "760740109": {
            "id": "760740109",
            "speakerId": 1001,
            "speakerName": "Black Screen",
            "text": "你听得懂那首歌中的每一句话、每一个字，甚至每一个音符，尽管你从未听过那种语言。"
          }
        }
      }
    },

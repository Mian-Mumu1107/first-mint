        "dialogs": {
          "760010401": {
            "id": "760010401",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "说起来，看他的打扮应该是执灯人…曾经是执灯人吧。",
            "nextDialogs": [
              "760010402"
            ]
          },
          "760010402": {
            "id": "760010402",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "那夏镇也有执灯人呢，要不找他们问问？说不定他们会知道些什么。"
          }
        }
      }

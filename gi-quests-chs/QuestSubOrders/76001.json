        ],
        "dialogs": {
          "760010801": {
            "id": "760010801",
            "speakerId": 1003,
            "speakerName": "苏霍维赫",
            "text": "劳烦两位将遗物带去伦波岛东的战场遗址，带去他的墓前吧。愿他的灵魂得以安息的那一日尽早到来…"
          }

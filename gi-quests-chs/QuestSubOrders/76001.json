    {
      "subId": "7600101",
      "subQuestName": "(test)隐藏$HIDDEN",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "760010101"
        ],
        "dialogs": {
          "760010101": {
            "id": "760010101",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "打扰一下！有件事想问问两位…",
            "nextDialogs": [
              "760010102"
            ]
          },
          "760010102": {
            "id": "760010102",
            "speakerId": 1002,
            "speakerName": "Black Screen",
            "text": "向两位执灯士出示了此前得到的物件，并讲述了与身着执灯人服饰的怪人并肩作战，击退狂猎的事…",
            "nextDialogs": [
              "760010103"
            ]
          },
          "760010103": {
            "id": "760010103",
            "speakerId": 1000,
            "speakerName": "卢什涅",
            "text": "难道是西格德？他…直到现在也无法安息啊，要是我能更加…",
            "nextDialogs": [
              "760010104"
            ]
          },
          "760010104": {
            "id": "760010104",
            "speakerId": 1003,
            "speakerName": "苏霍维赫",
            "text": "别这么说，这不是你一个人的责任。只要狂猎尚存，他就不会停止战斗…我们所能做的，只有尽力完成自己的使命而已。",
            "nextDialogs": [
              "760010105"
            ]
          },
          "760010105": {
            "id": "760010105",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "所以西格德他也曾经是执灯人的一员，对吧？",
            "nextDialogs": [
              "760010106"
            ]
          },
          "760010106": {
            "id": "760010106",
            "speakerId": 1003,
            "speakerName": "苏霍维赫",
            "text": "是的，他是了不起的执灯长。在狂猎的大军席卷挪德卡莱时，他英勇地战斗到了最后一刻。",
            "nextDialogs": [
              "760010107"
            ]
          },
          "760010107": {
            "id": "760010107",
            "speakerId": 1003,
            "speakerName": "苏霍维赫",
            "text": "据说警铃响起时，失却了心智的魔物就像是为之胆寒一样，不敢贸然向前…没想到他的遗物会被两位找到。",
            "nextDialogs": [
              "760010108"
            ]
          },
          "760010108": {
            "id": "760010108",
            "speakerId": 1003,
            "speakerName": "苏霍维赫",
            "text": "如果可以的话，请两位将遗物带去伦波岛东的战场遗址，带去他的墓前。",
            "nextDialogs": [
              "760010109"
            ]
          },
          "760010109": {
            "id": "760010109",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "放心交给我们吧。",
            "nextDialogs": [
              "760010110"
            ]
          },
          "760010110": {
            "id": "760010110",
            "speakerId": 1003,
            "speakerName": "苏霍维赫",
            "text": "感谢。愿他的灵魂得以安息的那一日尽早到来…"
          }
        }
      }
    },
    {
      "subId": "7600107",
      "subQuestName": "(test)隐藏$HIDDEN",

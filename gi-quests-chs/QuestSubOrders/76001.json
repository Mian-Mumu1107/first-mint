        "startDialogs": [
          "760019901"
        ],
        "dialogs": {
          "760019901": {
            "id": "760019901",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "看起来是属于那个奇怪的人的东西…",
            "nextDialogs": [
              "760019902"
            ]
          },
          "760019902": {
            "id": "760019902",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "这就是西格德的墓了吧，只有他一个在这里…",
            "nextDialogs": [
              "760019903"
            ]
          },
          "760019903": {
            "id": "760019903",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "总之，我们先把这些装备交还给他吧。"
          }

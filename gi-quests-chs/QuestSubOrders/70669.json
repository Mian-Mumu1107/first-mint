            ]
          },
          "706690204": {
            "id": "706690204",
            "speakerId": 1000,
            "speakerName": "「小王子」",
            "text": "「事到如今再说或许有点多余了，但是…」",
            "nextDialogs": [
              "706690205"
            ]
          },
          "706690205": {
            "id": "706690205",
            "speakerId": 1000,
            "speakerName": "「小王子」",
            "text": "#「{NICKNAME}，希望你能感受到『七圣召唤』的乐趣！」"
          }
        }

            ]
          },
          "706690203": {
            "id": "706690203",
            "speakerId": 1000,
            "speakerName": "「小王子」",
            "text": "#「希望{NICKNAME}以后也能继续精进自己的牌技！要成为不辜负传说牌手这一头衔的了不起的牌手！」",
            "nextDialogs": [

    {
      "subId": "1903104",
      "subQuestName": "与工作人员交谈",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "1903102101"
        ],
        "dialogs": {
          "1903102101": {
            "id": "1903102101",
            "speakerId": 10905,
            "speakerName": "傅三儿",
            "text": "一个人走在这里，很危险的哦？",
            "nextDialogs": [
              "1903102102"
            ]
          },
          "1903102102": {
            "id": "1903102102",
            "speakerId": 10905,
            "speakerName": "傅三儿",
            "text": "因为，你根本不知道会遇到什么人，或者说，是不是人？",
            "nextDialogs": [
              "1903102105"
            ]
          },
          "1903102105": {
            "id": "1903102105",
            "speakerId": 10905,
            "speakerName": "傅三儿",
            "text": "哼哼，没想到你还挺冷静的。有句俗话说，常在河边走，哪有不湿鞋。",
            "nextDialogs": [
              "1903102106"
            ]
          },
          "1903102106": {
            "id": "1903102106",
            "speakerId": 10905,
            "speakerName": "傅三儿",
            "text": "行走在这种阴森诡异的地方，说不定就会看到什么不该看到的东西。",
            "nextDialogs": [
              "1903102107"
            ]
          },
          "1903102107": {
            "id": "1903102107",
            "speakerId": 10905,
            "speakerName": "傅三儿",
            "text": "只要看到了，它就会化作噩梦，纠缠你一生一世！"
          }
        }
      }
    },

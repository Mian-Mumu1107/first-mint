  "subQuests": [
    {
      "subId": "7470601",
      "subQuestName": "前往水族箱附近…",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "747060101"
        ],
        "dialogs": {
          "747060101": {
            "id": "747060101",
            "speakerId": 1000,
            "speakerName": "哥伦比娅",
            "text": "…这条呢？",
            "nextDialogs": [
              "747060102"
            ]
          },
          "747060102": {
            "id": "747060102",
            "speakerId": 1001,
            "speakerName": "芙宁娜",
            "text": "好像还是差一点…",
            "nextDialogs": [
              "747060103"
            ]
          },
          "747060103": {
            "id": "747060103",
            "speakerId": 1002,
            "speakerName": "派蒙",
            "text": "哥伦比娅，还有芙宁娜？你们在干嘛呢？",
            "nextDialogs": [
              "747060104"
            ]
          },
          "747060104": {
            "id": "747060104",
            "speakerId": 1000,
            "speakerName": "哥伦比娅",
            "text": "在和芙宁娜导演一起…「选角」？",
            "nextDialogs": [
              "747060105"
            ]
          },
          "747060105": {
            "id": "747060105",
            "speakerId": 1001,
            "speakerName": "芙宁娜",
            "text": "这么说倒也没错，只不过我们准备选的演员，是水族箱里的鱼。",
            "nextDialogs": [
              "747060106"
            ]
          },
          "747060106": {
            "id": "747060106",
            "speakerId": 1002,
            "speakerName": "派蒙",
            "text": "鱼都能演戏了？",
            "nextDialogs": [
              "747060107"
            ]
          },
          "747060107": {
            "id": "747060107",
            "speakerId": 1001,
            "speakerName": "芙宁娜",
            "text": "现在动物演员也不少见嘛。我们想选一条气质比较符合的鱼，拍摄一些映影中用来烘托氛围的空镜。",
            "nextDialogs": [
              "747060108"
            ]
          },
          "747060108": {
            "id": "747060108",
            "speakerId": 1001,
            "speakerName": "芙宁娜",
            "text": "只不过看了一圈下来，还没有找到太合适的。",
            "nextDialogs": [
              "747060109"
            ]
          },
          "747060109": {
            "id": "747060109",
            "speakerId": 1000,
            "speakerName": "哥伦比娅",
            "text": "#要试着拜托{NICKNAME}和派蒙吗？很多问题{M#他}{F#她}们都能解决。",
            "nextDialogs": [
              "747060110"
            ]
          },
          "747060110": {
            "id": "747060110",
            "speakerId": 1002,
            "speakerName": "派蒙",
            "text": "你这么信任我们倒是很高兴啦…但这个问题上…",
            "nextDialogs": [
              "747060113"
            ]
          },
          "747060113": {
            "id": "747060113",
            "speakerId": 1001,
            "speakerName": "芙宁娜",
            "text": "对哦！这水族馆就是你们负责经营的。",
            "nextDialogs": [
              "747060114"
            ]
          },
          "747060114": {
            "id": "747060114",
            "speakerId": 1002,
            "speakerName": "派蒙",
            "text": "也就是说，我们以后在下水的时候多留个心就行了？好像的确不难。",
            "nextDialogs": [
              "747060115"
            ]
          },
          "747060115": {
            "id": "747060115",
            "speakerId": 1001,
            "speakerName": "芙宁娜",
            "text": "那就这么说定了！我稍后将想象中符合气质的鱼告诉你们。",
            "nextDialogs": [
              "747060116"
            ]
          },
          "747060116": {
            "id": "747060116",
            "speakerId": 1000,
            "speakerName": "哥伦比娅",
            "text": "那你们现在就是「星探」了？",
            "nextDialogs": [
              "747060117"
            ]
          },
          "747060117": {
            "id": "747060117",
            "speakerId": 1002,
            "speakerName": "派蒙",
            "text": "你跟着芙宁娜还真是学到好多新词…"
          }
        }
      }
    }
  ]
}
    },
    {
      "subId": "7408602",
      "subQuestName": "(test)废弃$UNRELEASED$HIDDEN",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "740860201"
        ],
        "dialogs": {
          "740860201": {
            "id": "740860201",
            "speakerId": 1000,
            "speakerName": "纳克",
            "text": "我们到了。这就是一枚「勘测桩锚」的所在地。$UNRELEASED",
            "nextDialogs": [
              "740860202"
            ]
          },
          "740860202": {
            "id": "740860202",
            "speakerId": 1000,
            "speakerName": "纳克",
            "text": "这里原本是杜艾里小姐所领导的「深水勘测研究院」，她们的研究项目是「超深水常驻式监测锚点」。$UNRELEASED",
            "nextDialogs": [
              "740860203"
            ]
          },
          "740860203": {
            "id": "740860203",
            "speakerId": 1000,
            "speakerName": "纳克",
            "text": "在爆炸后，整片湖里的水先是被逆转的重力全部掀到了天上，在刹那之后，又全部坠落了下来。$UNRELEASED",
            "nextDialogs": [
              "740860204"
            ]
          },
          "740860204": {
            "id": "740860204",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "整片湖里的湖水从天上掉下来…那，那她们…$UNRELEASED",
            "nextDialogs": [
              "740860205"
            ]
          },
          "740860205": {
            "id": "740860205",
            "speakerId": 1000,
            "speakerName": "纳克",
            "text": "全部下落不明。院里没有找到和她们有关的任何线索。$UNRELEASED",
            "nextDialogs": [
              "740860206"
            ]
          },
          "740860206": {
            "id": "740860206",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "怎么会这样…$UNRELEASED",
            "nextDialogs": [
              "740860207"
            ]
          },
          "740860207": {
            "id": "740860207",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "只是失踪，应该还有希望。$UNRELEASED",
            "nextDialogs": [
              "740860208"
            ]
          },
          "740860208": {
            "id": "740860208",
            "speakerId": 1000,
            "speakerName": "纳克",
            "text": "谢谢你能这么想。但说实话，考虑到当时杜艾里小姐应该正在水里工作…$UNRELEASED",
            "nextDialogs": [
              "740860209"
            ]
          },
          "740860209": {
            "id": "740860209",
            "speakerId": 1000,
            "speakerName": "纳克",
            "text": "在我个人看来，「失踪」这种说法，还是掺杂了太多情绪成分。$UNRELEASED",
            "nextDialogs": [
              "740860210"
            ]
          },
          "740860210": {
            "id": "740860210",
            "speakerId": 1000,
            "speakerName": "纳克",
            "text": "克洛妮艾小姐，出来吧，您的耳朵都要伸出草丛了。$UNRELEASED",
            "nextDialogs": [
              "740860211"
            ]
          },
          "740860211": {
            "id": "740860211",
            "speakerId": 1002,
            "speakerName": "克洛妮艾",
            "text": "您是怎么发现我…呸！这些叶子真讨厌，都飘我嘴里了。$UNRELEASED",
            "nextDialogs": [
              "740860212"
            ]
          },
          "740860212": {
            "id": "740860212",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "出现了！哪里都在的克洛妮艾小姐！$UNRELEASED",
            "nextDialogs": [
              "740860213"
            ]
          },
          "740860213": {
            "id": "740860213",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "你不是在采访舒瓦瑟尔吗？$UNRELEASED",
            "nextDialogs": [
              "740860214"
            ]
          },
          "740860214": {
            "id": "740860214",
            "speakerId": 1002,
            "speakerName": "克洛妮艾",
            "text": "呸…呸，呸！舒瓦瑟尔和之前一样，只是一尊只会回放留音的人偶。$UNRELEASED",
            "nextDialogs": [
              "740860215"
            ]
          },
          "740860215": {
            "id": "740860215",
            "speakerId": 1002,
            "speakerName": "克洛妮艾",
            "text": "他永远只会重复那么几个单词。比如「坚决保障」、「力求迅速」、「安全为上」什么的。$UNRELEASED",
            "nextDialogs": [
              "740860216"
            ]
          },
          "740860216": {
            "id": "740860216",
            "speakerId": 1002,
            "speakerName": "克洛妮艾",
            "text": "还有那些…莫名其妙的排比句子和短语。比如…$UNRELEASED",
            "nextDialogs": [
              "740860217"
            ]
          },
          "740860217": {
            "id": "740860217",
            "speakerId": 1000,
            "speakerName": "纳克",
            "text": "「方方面面睁大眼，时时刻刻敲警钟」、「高扬前进帆，稳把方向舵，常备安全锚」…$UNRELEASED",
            "nextDialogs": [
              "740860218"
            ]
          },
          "740860218": {
            "id": "740860218",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "语气都一模一样！$UNRELEASED",
            "nextDialogs": [
              "740860219"
            ]
          },
          "740860219": {
            "id": "740860219",
            "speakerId": 1002,
            "speakerName": "克洛妮艾",
            "text": "比起听他说一无是处的废话，我还不如跟着你们到处跑跑呢！$UNRELEASED",
            "nextDialogs": [
              "740860220"
            ]
          },
          "740860220": {
            "id": "740860220",
            "speakerId": 1000,
            "speakerName": "纳克",
            "text": "好吧，希望您身上的止吐药剂还够用。$UNRELEASED",
            "nextDialogs": [
              "740860221"
            ]
          },
          "740860221": {
            "id": "740860221",
            "speakerId": 1000,
            "speakerName": "纳克",
            "text": "#{NICKNAME}，请你去把那枚「勘测桩锚」取出来吧，然后我们就去下一个地点。$UNRELEASED"
          }
        }
      }
    },
    {
      "subId": "7408603",

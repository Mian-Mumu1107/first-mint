    },
    {
      "subId": "7408650",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "740865001"
        ],
        "dialogs": {
          "740865001": {
            "id": "740865001",
            "speakerId": 1000,
            "speakerName": "纳克",
            "text": "很好。这里的桩锚状态很不错，没有太多的能量流外泄。$UNRELEASED",
            "nextDialogs": [
              "740865002"
            ]
          },
          "740865002": {
            "id": "740865002",
            "speakerId": 1000,
            "speakerName": "纳克",
            "text": "您的身体怎么样？有什么异常感觉吗？$UNRELEASED",
            "nextDialogs": [
              "740865003"
            ]
          },
          "740865003": {
            "id": "740865003",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "#没有喔，我和{NICKNAME}什么感觉都没有。$UNRELEASED",
            "nextDialogs": [
              "740865004"
            ]
          },
          "740865004": {
            "id": "740865004",
            "speakerId": 1000,
            "speakerName": "纳克",
            "text": "那就好，如果有任何异常感，请您立刻说出来。$UNRELEASED",
            "nextDialogs": [
              "740865005"
            ]
          },
          "740865005": {
            "id": "740865005",
            "speakerId": 1000,
            "speakerName": "纳克",
            "text": "我们去下一个地点吧，离这里稍微有些远…我们得加快点脚步了。$UNRELEASED",
            "nextDialogs": [
              "740865006"
            ]
          },
          "740865006": {
            "id": "740865006",
            "speakerId": 1002,
            "speakerName": "克洛妮艾",
            "text": "嘿！等等，我…我的鞋里进了几块小石头！等我先把它们弄出来…$UNRELEASED"
          }
        }
      }
    }
  ]
}
    {
      "subId": "2300307",
      "subQuestName": "与哈特姆交谈",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "230030701"
        ],
        "dialogs": {
          "230030701": {
            "id": "230030701",
            "speakerId": 4004,
            "speakerName": "哈特姆",
            "text": "明明是在「蓄财之地」吃下的「吞金料理」…",
            "nextDialogs": [
              "230030702"
            ]
          },
          "230030702": {
            "id": "230030702",
            "speakerId": 4004,
            "speakerName": "哈特姆",
            "text": "最后居然跌成这样…不讲道理！这个市场还有规律可言吗，有规则可讲吗！？",
            "nextDialogs": [
              "230030703"
            ]
          },
          "230030703": {
            "id": "230030703",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "哈特姆，我们找你半天呢，你没事吧？",
            "nextDialogs": [
              "230030704"
            ]
          },
          "230030704": {
            "id": "230030704",
            "speakerId": 4004,
            "speakerName": "哈特姆",
            "text": "是你们啊…我我…没事，我好着呢…你们看，我也没缺条胳膊少条腿的。",
            "nextDialogs": [
              "230030705"
            ]
          },
          "230030705": {
            "id": "230030705",
            "speakerId": 4004,
            "speakerName": "哈特姆",
            "text": "不过就是亏走了保证金而已…咳咳…",
            "nextDialogs": [
              "230030706"
            ]
          },
          "230030706": {
            "id": "230030706",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "抱。抱歉…",
            "nextDialogs": [
              "230030707"
            ]
          },
          "230030707": {
            "id": "230030707",
            "speakerId": 4004,
            "speakerName": "哈特姆",
            "text": "不！这不是你的问题，不用放在心上。",
            "nextDialogs": [
              "230030708"
            ]
          },
          "230030708": {
            "id": "230030708",
            "speakerId": 4004,
            "speakerName": "哈特姆",
            "text": "当然，这肯定也不是我的问题，真要怪就怪这个市场太烂了。",
            "nextDialogs": [
              "230030709"
            ]
          },
          "230030709": {
            "id": "230030709",
            "speakerId": 4004,
            "speakerName": "哈特姆",
            "text": "没有道理！不讲规律！说跌就跌，说涨就…他也一直就不涨…",
            "nextDialogs": [
              "230030710"
            ]
          },
          "230030710": {
            "id": "230030710",
            "speakerId": 4004,
            "speakerName": "哈特姆",
            "text": "真是，哎哟，我真是…",
            "nextDialogs": [
              "230030711"
            ]
          },
          "230030711": {
            "id": "230030711",
            "speakerId": 4004,
            "speakerName": "哈特姆",
            "text": "算了算了，我还就不信了…我卡里米的不凡富翁哈特姆，还征服不了期货交易！",
            "nextDialogs": [
              "230030712"
            ]
          },
          "230030712": {
            "id": "230030712",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "你不都亏了吗…",
            "nextDialogs": [
              "230030713"
            ]
          },
          "230030713": {
            "id": "230030713",
            "speakerId": 4004,
            "speakerName": "哈特姆",
            "text": "哼，没关系，我还有充足的后备资金。",
            "nextDialogs": [
              "230030714"
            ]
          },
          "230030714": {
            "id": "230030714",
            "speakerId": 4004,
            "speakerName": "哈特姆",
            "text": "就算手头分文不剩了，在别处我还有周转的资金和资产呢。",
            "nextDialogs": [
              "230030715"
            ]
          },
          "230030715": {
            "id": "230030715",
            "speakerId": 4004,
            "speakerName": "哈特姆",
            "text": "等着吧，卡里米交易所，我哈特姆还会回来的！"
          }
        }
      }
    }
  ]
}
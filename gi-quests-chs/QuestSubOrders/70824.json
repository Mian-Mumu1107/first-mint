    {
      "subId": "7082403",
      "subQuestName": "打扫所有污渍",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "708240301"
        ],
        "dialogs": {
          "708240301": {
            "id": "708240301",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "我很擅长打扫。",
            "nextDialogs": [
              "708240302"
            ]
          },
          "708240302": {
            "id": "708240302",
            "speakerId": 1531,
            "speakerName": "爱德琳",
            "text": "是吗？那正好，如果您愿意的话，就来帮一下忙吧。",
            "nextDialogs": [
              "708240303"
            ]
          },
          "708240303": {
            "id": "708240303",
            "speakerId": 1531,
            "speakerName": "爱德琳",
            "text": "请您跟我进屋里去吧，里面有很多需要打扫的地方。"
          }
        }
      }
    },
    {
      "subId": "7082404",
      "subQuestName": "与爱德琳对话",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "708240401"
        ],
        "dialogs": {
          "708240401": {
            "id": "708240401",
            "speakerId": 1531,
            "speakerName": "爱德琳",
            "text": "您打扫完了吗？",
            "nextDialogs": [
              "708240402"
            ]
          },
          "708240402": {
            "id": "708240402",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "打扫干净了。",
            "nextDialogs": [
              "708240403"
            ]
          },
          "708240403": {
            "id": "708240403",
            "speakerId": 1531,
            "speakerName": "爱德琳",
            "text": "太好了，实在是帮大忙了，如果就我一个人的话，不知道要扫到什么时候去。",
            "nextDialogs": [
              "708240404"
            ]
          },
          "708240404": {
            "id": "708240404",
            "speakerId": 1531,
            "speakerName": "爱德琳",
            "text": "如果让摩可和海莉来打扫…那就不知道她们又要打翻多少东西了…",
            "nextDialogs": [
              "708240405"
            ]
          },
          "708240405": {
            "id": "708240405",
            "speakerId": 1531,
            "speakerName": "爱德琳",
            "text": "谢谢您，这些请您收下吧，您本来是客人，让您帮忙打扫实在是不好意思。",
            "nextDialogs": [
              "708240406"
            ]
          },
          "708240406": {
            "id": "708240406",
            "speakerId": 1531,
            "speakerName": "爱德琳",
            "text": "您下次光临酒庄的时候，这里一定会整洁如新的。"
          }
        }
      }
    },
    {
      "subId": "7082401",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "708240101"
        ],
        "dialogs": {
          "708240101": {
            "id": "708240101",
            "speakerId": 1531,
            "speakerName": "爱德琳",
            "text": "打扫得细心一点！这可是客人们对酒庄的第一印象！",
            "nextDialogs": [
              "708240102"
            ]
          },
          "708240102": {
            "id": "708240102",
            "speakerId": 1596,
            "speakerName": "摩可",
            "text": "对不起！",
            "nextDialogs": [
              "708240103"
            ]
          },
          "708240103": {
            "id": "708240103",
            "speakerId": 1595,
            "speakerName": "海莉",
            "text": "我们会再细心点！",
            "nextDialogs": [
              "708240104"
            ]
          },
          "708240104": {
            "id": "708240104",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "怎么了？",
            "nextDialogs": [
              "708240105"
            ]
          },
          "708240105": {
            "id": "708240105",
            "speakerId": 1531,
            "speakerName": "爱德琳",
            "text": "是您啊，欢迎光临晨曦酒庄，暴风虽然平息了，但被暴风弄得乱七八糟的酒庄还要收拾。",
            "nextDialogs": [
              "708240106"
            ]
          },
          "708240106": {
            "id": "708240106",
            "speakerId": 1531,
            "speakerName": "爱德琳",
            "text": "我正在安排打扫的事，但是摩可和海莉，实在是…",
            "nextDialogs": [
              "708240107"
            ]
          },
          "708240107": {
            "id": "708240107",
            "speakerId": 1596,
            "speakerName": "摩可",
            "text": "对不起！",
            "nextDialogs": [
              "708240108"
            ]
          },
          "708240108": {
            "id": "708240108",
            "speakerId": 1595,
            "speakerName": "海莉",
            "text": "我们会再细心点！",
            "nextDialogs": [
              "708240109"
            ]
          },
          "708240109": {
            "id": "708240109",
            "speakerId": 1531,
            "speakerName": "爱德琳",
            "text": "你们已经说过一次了！有道歉的功夫，还不如去再细心打扫一遍，还不快去！",
            "nextDialogs": [
              "708240110"
            ]
          },
          "708240110": {
            "id": "708240110",
            "speakerId": 1531,
            "speakerName": "爱德琳",
            "text": "唉，这两个孩子，怎么老是这么粗心，用这种工作效率，什么时候才能收拾完，屋子里面可还要打扫呢。"
          }
        }
      }
    },
    {
      "subId": "7082406",

              "708240602"
            ]
          },
          "708240602": {
            "id": "708240602",
            "speakerId": 1596,
            "speakerName": "摩可",
            "text": "扫完了屋子外面还有屋子里面，什么时候才能完全扫干净啊…"
          }
        }
      }
    },

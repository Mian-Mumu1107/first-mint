        ],
        "dialogs": {
          "708240201": {
            "id": "708240201",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "我来帮忙。",
            "nextDialogs": [
              "708240202"
            ]
          },
          "708240202": {
            "id": "708240202",
            "speakerId": 1531,
            "speakerName": "爱德琳",
            "text": "您知道如何打扫吗？算了…现在正是缺人手的时候，您愿意帮忙再好不过了。",
            "nextDialogs": [
              "708240203"
            ]
          },
          "708240203": {
            "id": "708240203",
            "speakerId": 1531,
            "speakerName": "爱德琳",
            "text": "请您跟我进屋里去吧，里面有很多需要打扫的地方。"
          }
        }
      }
    },

        "dialogs": {
          "710390101": {
            "id": "710390101",
            "speakerId": 1000,
            "speakerName": "瑾武",
            "text": "……",
            "nextDialogs": [
              "710390104"
            ]
          },
          "710390104": {
            "id": "710390104",
            "speakerId": 1000,
            "speakerName": "瑾武",
            "text": "…？！",
            "nextDialogs": [
              "710390105"
            ]
          },
          "710390105": {
            "id": "710390105",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "哇啊，吓我一跳！",
            "nextDialogs": [
              "710390106"
            ]
          },
          "710390106": {
            "id": "710390106",
            "speakerId": 1000,
            "speakerName": "瑾武",
            "text": "抱…抱歉。那个，如果你们要找志琼的话…她离队了。"
          }
        }
      }
    },
    {
      "subId": "7103902",
      "subQuestName": "与瑾武对话$HIDDEN",
      "sceneId": null,

    {
      "subId": "7103903",
      "subQuestName": "向沐宁说明志琼离开之事",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "710390201"
        ],
        "dialogs": {
          "710390201": {
            "id": "710390201",
            "speakerId": 1002,
            "speakerName": "沐宁",
            "text": "嗯？志琼没和你一起上来吗？总务司的荐书下来了。",
            "nextDialogs": [
              "710390202"
            ]
          },
          "710390202": {
            "id": "710390202",
            "speakerId": 1002,
            "speakerName": "沐宁",
            "text": "因为她绘制的地图给辉山厅帮了大忙，总务司破格聘任她为…嗯，我看看…顾问向导，享受正式职位待遇。",
            "nextDialogs": [
              "710390203"
            ]
          },
          "710390203": {
            "id": "710390203",
            "speakerId": 1002,
            "speakerName": "沐宁",
            "text": "恭喜志琼啦，先前那样四处乱跑果然不是白做工的。",
            "nextDialogs": [
              "710390204"
            ]
          },
          "710390204": {
            "id": "710390204",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "她退出了。",
            "nextDialogs": [
              "710390205"
            ]
          },
          "710390205": {
            "id": "710390205",
            "speakerId": 1002,
            "speakerName": "沐宁",
            "text": "退出了？什么意思…？她先离开了吗？可是千岩军没有和我说有人离开过层岩巨渊啊…",
            "nextDialogs": [
              "710390206"
            ]
          },
          "710390206": {
            "id": "710390206",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "志琼退出了勘探队。",
            "nextDialogs": [
              "710390207"
            ]
          },
          "710390207": {
            "id": "710390207",
            "speakerId": 1002,
            "speakerName": "沐宁",
            "text": "啊？哦…",
            "nextDialogs": [
              "710390208"
            ]
          },
          "710390208": {
            "id": "710390208",
            "speakerId": 1002,
            "speakerName": "沐宁",
            "text": "等等！等等！",
            "nextDialogs": [
              "710390209"
            ]
          },
          "710390209": {
            "id": "710390209",
            "speakerId": 1002,
            "speakerName": "沐宁",
            "text": "不对不对…你说，她，退出了勘探队？",
            "nextDialogs": [
              "710390210"
            ]
          },
          "710390210": {
            "id": "710390210",
            "speakerId": 1002,
            "speakerName": "沐宁",
            "text": "志琼，退出了？",
            "nextDialogs": [
              "710390211"
            ]
          },
          "710390211": {
            "id": "710390211",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "对呀！你是哪个部分听不懂呀！",
            "nextDialogs": [
              "710390212"
            ]
          },
          "710390212": {
            "id": "710390212",
            "speakerId": 1002,
            "speakerName": "沐宁",
            "text": "…我明白了，我会即刻组织起一支搜救队。如果她还留在层岩巨渊，我们应该还能找到她。",
            "nextDialogs": [
              "710390213"
            ]
          },
          "710390213": {
            "id": "710390213",
            "speakerId": 1002,
            "speakerName": "沐宁",
            "text": "不管她是又一次自己犯傻，还是别的什么原因…要找到她才行。",
            "nextDialogs": [
              "710390214"
            ]
          },
          "710390214": {
            "id": "710390214",
            "speakerId": 1002,
            "speakerName": "沐宁",
            "text": "以她现在的状态，脱离队伍擅自行动完全是在胡闹…",
            "nextDialogs": [
              "710390216",
              "710390218"
            ]
          },
          "710390216": {
            "id": "710390216",
            "speakerId": 1002,
            "speakerName": "沐宁",
            "text": "抱歉，这次就不需要劳烦你帮忙了…我也总得派上点用场嘛。",
            "nextDialogs": [
              "710390233"
            ]
          },
          "710390233": {
            "id": "710390233",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "如果需要我帮忙，我一定尽快赶到。",
            "nextDialogs": [
              "710390234"
            ]
          },
          "710390234": {
            "id": "710390234",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "嗯嗯，我也是！不能放着后辈不管呀！",
            "nextDialogs": [
              "710390235"
            ]
          },
          "710390235": {
            "id": "710390235",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "我们也在路上多多注意吧，说不定什么时候就能遇见她了呢！"
          },
          "710390218": {
            "id": "710390218",
            "speakerId": 1002,
            "speakerName": "沐宁",
            "text": "她是个不安分的家伙，但我们再怎么说也算是朋友。我知道我不讨人喜欢…但我可不能随随便便就把朋友忘了。",
            "nextDialogs": [
              "710390219"
            ]
          },
          "710390219": {
            "id": "710390219",
            "speakerId": 1002,
            "speakerName": "沐宁",
            "text": "这家伙总是在做什么冒险家的大梦，之前受过几次重伤…还差点把命也搭进去。后来好不容易才安生了一段时间…",
            "nextDialogs": [
              "710390220"
            ]
          },
          "710390220": {
            "id": "710390220",
            "speakerId": 1002,
            "speakerName": "沐宁",
            "text": "本来以为她已经把不切实际的美梦抛之脑后了…罗尔德、斯坦利，哪有那么好当！",
            "nextDialogs": [
              "710390221"
            ]
          },
          "710390221": {
            "id": "710390221",
            "speakerId": 1002,
            "speakerName": "沐宁",
            "text": "唉…可是没想到…或许这次我不应该推荐请你来探索层岩巨渊才是，不然也不至于引起志琼的这把火…"
          }
        }
      }
    }
  ]
}
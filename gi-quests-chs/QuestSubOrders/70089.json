      "dialogue": {
        "startDialogs": [
          "700890101"
        ],
        "dialogs": {
          "700890101": {
            "id": "700890101",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "咦，这里怎么有个人？",
            "nextDialogs": [
              "700890102"
            ]
          },
          "700890102": {
            "id": "700890102",
            "speakerId": 10205,
            "speakerName": "？？？",
            "text": "也不是这个风神像…",
            "nextDialogs": [
              "700890103"
            ]
          },
          "700890103": {
            "id": "700890103",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "喂，你在干什么啊？",
            "nextDialogs": [
              "700890104"
            ]
          },
          "700890104": {
            "id": "700890104",
            "speakerId": 10205,
            "speakerName": "？？？",
            "text": "我在找回去的路。我只记得要找风神像。",
            "nextDialogs": [
              "700890105"
            ]
          },
          "700890105": {
            "id": "700890105",
            "speakerId": 10205,
            "speakerName": "？？？",
            "text": "其他的我也什么都不记得了。",
            "nextDialogs": [
              "700890106"
            ]
          },
          "700890106": {
            "id": "700890106",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "回去的路？",
            "nextDialogs": [
              "700890107"
            ]
          },
          "700890107": {
            "id": "700890107",
            "speakerId": 10205,
            "speakerName": "？？？",
            "text": "隐隐约约的一种乡愁，但是我什么都不记得。",
            "nextDialogs": [
              "700890108"
            ]
          },
          "700890108": {
            "id": "700890108",
            "speakerId": 10205,
            "speakerName": "？？？",
            "text": "我醒来的时候，手里只有一张写了「你是『莫基』」的纸条。",
            "nextDialogs": [
              "700890109"
            ]
          },
          "700890109": {
            "id": "700890109",
            "speakerId": 22277,
            "speakerName": "「莫基」",
            "text": "所以我想我名字应该就是「莫基」。",
            "nextDialogs": [
              "700890110"
            ]
          },
          "700890110": {
            "id": "700890110",
            "speakerId": 22277,
            "speakerName": "「莫基」",
            "text": "不打扰你们了。再见。",
            "nextDialogs": [
              "700890111"
            ]
          },
          "700890111": {
            "id": "700890111",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "好奇怪的人。不过应该不是坏人吧。",
            "nextDialogs": [
              "700890112"
            ]
          },
          "700890112": {
            "id": "700890112",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "你怎么了？",
            "nextDialogs": [
              "700890113"
            ]
          },
          "700890113": {
            "id": "700890113",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "看到了奇怪的景象。",
            "nextDialogs": [
              "700890114"
            ]
          },
          "700890114": {
            "id": "700890114",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "奇怪的景象？难道是因为刚才那个人碰了神像吗？"
          }
        }
      }
    },

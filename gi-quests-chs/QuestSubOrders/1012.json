      }
    },
    {
      "subId": "101214",
      "subQuestName": "与莺儿对话",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "10121201"
        ],
        "dialogs": {
          "10121201": {
            "id": "10121201",
            "speakerId": 2083,
            "speakerName": "莺儿",
            "text": "嗯，水质还不错。",
            "nextDialogs": [
              "10121202"
            ]
          },
          "10121202": {
            "id": "10121202",
            "speakerId": 2083,
            "speakerName": "莺儿",
            "text": "接下来就要请你帮忙，去合成台，从霓裳花里提炼出精油了。",
            "nextDialogs": [
              "10121203"
            ]
          },
          "10121203": {
            "id": "10121203",
            "speakerId": 2083,
            "speakerName": "莺儿",
            "text": "制造香膏的手法，和炼金的手法大不相同，我来教你吧。要像这样，轻轻地…温柔地握住臼杵…",
            "nextDialogs": [
              "10121204"
            ]
          },
          "10121204": {
            "id": "10121204",
            "speakerId": 2083,
            "speakerName": "莺儿",
            "text": "手掌也要注意紧贴，这样才不容易滑脱…",
            "nextDialogs": [
              "10121205"
            ]
          },
          "10121205": {
            "id": "10121205",
            "speakerId": 2083,
            "speakerName": "莺儿",
            "text": "然后用你最顺手的节奏搅动…直到霓裳花的汁水…",
            "nextDialogs": [
              "10121208"
            ]
          },
          "10121208": {
            "id": "10121208",
            "speakerId": 2083,
            "speakerName": "莺儿",
            "text": "嗯~果然有这方面的天赋，一说就懂。",
            "nextDialogs": [
              "10121209"
            ]
          },
          "10121209": {
            "id": "10121209",
            "speakerId": 2083,
            "speakerName": "莺儿",
            "text": "带上这些，到附近的<color=#00E1FFFF>合成台</color>去试试吧？",
            "nextDialogs": [
              "10121210"
            ]
          },
          "10121210": {
            "id": "10121210",
            "speakerId": 2083,
            "speakerName": "莺儿",
            "text": "记得，三种都要制作哦。虽然在精油阶段的外形很相似，但制成香膏以后，我会用不同的盒子帮你装好的。"
          }
        }
      }
    },
    {
      "subId": "101210",
      "subQuestName": "研磨霓裳花精油",
      "sceneId": null,
      "locations": [],
      "dialogue": {

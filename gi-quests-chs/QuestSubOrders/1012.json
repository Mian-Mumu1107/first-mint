    {
      "subId": "101215",
      "subQuestName": "把精油带给莺儿",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "10121301"
        ],
        "dialogs": {
          "10121301": {
            "id": "10121301",
            "speakerId": 2083,
            "speakerName": "莺儿",
            "text": "唔，真是不错的霓裳花精油。那么，剩下的就是最关键的部分…",
            "nextDialogs": [
              "10121302"
            ]
          },
          "10121302": {
            "id": "10121302",
            "speakerId": 2083,
            "speakerName": "莺儿",
            "text": "我会把它放入水中，用慢火熬煮，直到水分几乎蒸干为止。",
            "nextDialogs": [
              "10121303"
            ]
          },
          "10121303": {
            "id": "10121303",
            "speakerId": 2083,
            "speakerName": "莺儿",
            "text": "这里的火候很有讲究，火太大的话，会让香味受到影响。",
            "nextDialogs": [
              "10121304"
            ]
          },
          "10121304": {
            "id": "10121304",
            "speakerId": 2083,
            "speakerName": "莺儿",
            "text": "请你注意控制炉火的火力，这是最后一步了。",
            "nextDialogs": [
              "10121305"
            ]
          },
          "10121305": {
            "id": "10121305",
            "speakerId": 2083,
            "speakerName": "莺儿",
            "text": "那些霓裳花的汁水，要好好地做到一滴不剩哦。",
            "nextDialogs": [
              "10121306"
            ]
          },
          "10121306": {
            "id": "10121306",
            "speakerId": 2083,
            "speakerName": "莺儿",
            "text": "嗯~三种香膏都顺利完成了。助手，你的工作完成得不错。",
            "nextDialogs": [
              "10121307"
            ]
          },
          "10121307": {
            "id": "10121307",
            "speakerId": 2083,
            "speakerName": "莺儿",
            "text": "这也说明…你是个愿意为了感情而努力的人呀，真是难得。",
            "nextDialogs": [
              "10121312",
              "10121310"
            ]
          },
          "10121312": {
            "id": "10121312",
            "speakerId": 2083,
            "speakerName": "莺儿",
            "text": "好了好了，要我帮你介绍下这几种香膏吗？可以方便你对症下药…",
            "nextDialogs": [
              "10121313"
            ]
          },
          "10121313": {
            "id": "10121313",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "派蒙也要听！",
            "nextDialogs": [
              "10121314"
            ]
          },
          "10121314": {
            "id": "10121314",
            "speakerId": 2083,
            "speakerName": "莺儿",
            "text": "这第一种香膏呢，甜蜜而梦幻的感觉…是小女孩们最喜欢的。",
            "nextDialogs": [
              "10121315"
            ]
          },
          "10121315": {
            "id": "10121315",
            "speakerId": 2083,
            "speakerName": "莺儿",
            "text": "第二种闻上去贵气凌人，是富家千金们的最爱。",
            "nextDialogs": [
              "10121316"
            ]
          },
          "10121316": {
            "id": "10121316",
            "speakerId": 2083,
            "speakerName": "莺儿",
            "text": "最后一种香气轻柔却久久不散，如天光昏暗雾色朦胧，最受成熟女性们的欢迎。",
            "nextDialogs": [
              "10121317"
            ]
          },
          "10121317": {
            "id": "10121317",
            "speakerId": 2083,
            "speakerName": "莺儿",
            "text": "记住了吗？可别用错场合呀。",
            "nextDialogs": [
              "10121318"
            ]
          },
          "10121318": {
            "id": "10121318",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "记，记住了…",
            "nextDialogs": [
              "10121319"
            ]
          },
          "10121319": {
            "id": "10121319",
            "speakerId": 2083,
            "speakerName": "莺儿",
            "text": "好，那需要我帮忙的地方，就到这里了吗？",
            "nextDialogs": [
              "10121320"
            ]
          },
          "10121320": {
            "id": "10121320",
            "speakerId": 2083,
            "speakerName": "莺儿",
            "text": "那么，最后再送你一句话吧。",
            "nextDialogs": [
              "10121321"
            ]
          },
          "10121321": {
            "id": "10121321",
            "speakerId": 2083,
            "speakerName": "莺儿",
            "text": "想脚踏三条船，可要想好先抬哪只脚…",
            "nextDialogs": [
              "10121322"
            ]
          },
          "10121322": {
            "id": "10121322",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "……",
            "nextDialogs": [
              "10121323"
            ]
          },
          "10121323": {
            "id": "10121323",
            "speakerId": 2083,
            "speakerName": "莺儿",
            "text": "呵呵，有空再来「春香窑」陪陪我吧？"
          },
          "10121310": {
            "id": "10121310",
            "speakerId": 2083,
            "speakerName": "莺儿",
            "text": "欸呀，你居然还记得我随口一提的约定吗？",
            "nextDialogs": [
              "10121311"
            ]
          },
          "10121311": {
            "id": "10121311",
            "speakerId": 2083,
            "speakerName": "莺儿",
            "text": "你比预想中更讨人喜欢呢，若是不当心的话…连我都可能会动心了，呵呵。"
          }
        }
      }
    },

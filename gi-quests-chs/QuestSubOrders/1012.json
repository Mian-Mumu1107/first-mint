{
  "lineCounts": {
    "Player": 31,
    "博来": 15,
    "岚姐": 11,
    "派蒙": 47,
    "绮命": 11,
    "莺儿": 51,
    "钟离": 28
  },
  "subQuests": [
    {
      "subId": "101202",
      "subQuestName": "前往购买霓裳花",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "10120201"
        ],
        "dialogs": {
          "10120201": {
            "id": "10120201",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "老板，你们这里有霓裳花吗？",
            "nextDialogs": [
              "10120202"
            ]
          },
          "10120202": {
            "id": "10120202",
            "speakerId": 2013,
            "speakerName": "博来",
            "text": "霓裳花？当然有，要哪一种？",
            "nextDialogs": [
              "10120203"
            ]
          },
          "10120203": {
            "id": "10120203",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "唔…哪一种？就、就是，最好的那种？原来霓裳花还有很多种的吗？",
            "nextDialogs": [
              "10120204"
            ]
          },
          "10120204": {
            "id": "10120204",
            "speakerId": 2013,
            "speakerName": "博来",
            "text": "哼，没见过世面的外国人，还问这种问题…",
            "nextDialogs": [
              "10120205"
            ]
          },
          "10120205": {
            "id": "10120205",
            "speakerId": 10232,
            "speakerName": "钟离",
            "text": "「金屋藏娇」、「山阴锦簇」、「缥缈仙缘」，这三种霓裳花，麻烦老板各拿一株来看。",
            "nextDialogs": [
              "10120206"
            ]
          },
          "10120206": {
            "id": "10120206",
            "speakerId": 2013,
            "speakerName": "博来",
            "text": "——喔！这位老爷，是大行家啊！",
            "nextDialogs": [
              "10120207"
            ]
          },
          "10120207": {
            "id": "10120207",
            "speakerId": 2013,
            "speakerName": "博来",
            "text": "身边两个，是仆人吧。仆人就别抢在老爷之前开口了。",
            "nextDialogs": [
              "10120212",
              "10120211"
            ]
          },
          "10120212": {
            "id": "10120212",
            "speakerId": 2013,
            "speakerName": "博来",
            "text": "请，请，贵客看看吧，还有什么想法，也请说道说道。",
            "nextDialogs": [
              "10120213"
            ]
          },
          "10120213": {
            "id": "10120213",
            "speakerId": 10232,
            "speakerName": "钟离",
            "text": "嗯，根据生长环境与祖先亲族的不同，霓裳花会呈现出不同的性状…老板这几株都不错，保存得很新鲜。",
            "nextDialogs": [
              "10120214"
            ]
          },
          "10120214": {
            "id": "10120214",
            "speakerId": 10232,
            "speakerName": "钟离",
            "text": "比如这种，枝繁叶茂，花蕊如金屋藏娇。绿叶长存，多生于有复杂水文条件之地。",
            "nextDialogs": [
              "10120215"
            ]
          },
          "10120215": {
            "id": "10120215",
            "speakerId": 10232,
            "speakerName": "钟离",
            "text": "而山阴或者潮湿之地，霓裳花多生得瓣大而蕊密，香气扑鼻，堪称花团锦簇。",
            "nextDialogs": [
              "10120216"
            ]
          },
          "10120216": {
            "id": "10120216",
            "speakerId": 10232,
            "speakerName": "钟离",
            "text": "最后这类则是孤傲清冷，枝、叶、花排布极疏，开花时香气寡淡，却极为持久，是古人登山访仙时偶然发现。",
            "nextDialogs": [
              "10120217"
            ]
          },
          "10120217": {
            "id": "10120217",
            "speakerId": 10232,
            "speakerName": "钟离",
            "text": "不过时至今日，大多野生的霓裳花都在璃月地理变迁的过程中绝迹了，现在多是依靠人工培育…",
            "nextDialogs": [
              "10120218"
            ]
          },
          "10120218": {
            "id": "10120218",
            "speakerId": 2013,
            "speakerName": "博来",
            "text": "哎，先生确实是行家，连我自己都不知道有这么多讲究…",
            "nextDialogs": [
              "10120219"
            ]
          },
          "10120219": {
            "id": "10120219",
            "speakerId": 10232,
            "speakerName": "钟离",
            "text": "略通一二而已。我这位旅行家朋友才是不容小觑，是终将踏遍大陆各处之人。"
          },
          "10120211": {
            "id": "10120211",
            "speakerId": 2013,
            "speakerName": "博来",
            "text": "嗯？我们好像见过…哦，是旅者吧，不好意思了，刚才语气不太好。"
          }
        }
      }
    },
    {
      "subId": "101212",
      "subQuestName": "(test)与钟离对话$HIDDEN",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "10120601"
        ],
        "dialogs": {
          "10120601": {
            "id": "10120601",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "花已经到手了，可香膏要怎么做呀？",
            "nextDialogs": [
              "10120602"
            ]
          },
          "10120602": {
            "id": "10120602",
            "speakerId": 10232,
            "speakerName": "钟离",
            "text": "最好能找一个有过制香经验的熟手。不过我认识的人里，几乎没有会亲自动手熬制香膏的…",
            "nextDialogs": [
              "10120603"
            ]
          },
          "10120603": {
            "id": "10120603",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "嗯，一听就知道都是有钱人。",
            "nextDialogs": [
              "10120604"
            ]
          },
          "10120604": {
            "id": "10120604",
            "speakerId": 10232,
            "speakerName": "钟离",
            "text": "所以，要麻烦你们到城里问问看了，比如普通人家的小姐之类的。",
            "nextDialogs": [
              "10120605"
            ]
          },
          "10120605": {
            "id": "10120605",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "好吧，尤其是那种…身上香香的，对吧？感觉还算不错的差事呢。",
            "nextDialogs": [
              "10120606"
            ]
          },
          "10120606": {
            "id": "10120606",
            "speakerId": 10232,
            "speakerName": "钟离",
            "text": "我去七天神像附近等你们，做好香膏以后，就在那里汇合吧。"
          }
        }
      }
    },
    {
      "subId": "101203",
      "subQuestName": "向岚姐请教",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "10120301"
        ],
        "dialogs": {
          "10120301": {
            "id": "10120301",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "岚姐，我们想请你帮个忙…",
            "nextDialogs": [
              "10120302"
            ]
          },
          "10120302": {
            "id": "10120302",
            "speakerId": 2016,
            "speakerName": "岚姐",
            "text": "我已经很长时间不接委托了，不好意思二位，请找其他冒险家吧。",
            "nextDialogs": [
              "10120303"
            ]
          },
          "10120303": {
            "id": "10120303",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "不用挂委托啦，只是很小很小的一件事…",
            "nextDialogs": [
              "10120305",
              "10120308"
            ]
          },
          "10120305": {
            "id": "10120305",
            "speakerId": 2016,
            "speakerName": "岚姐",
            "text": "…唔。",
            "nextDialogs": [
              "10120306"
            ]
          },
          "10120306": {
            "id": "10120306",
            "speakerId": 2016,
            "speakerName": "岚姐",
            "text": "我看上去像是会用那种东西的人吗，总感觉被你小瞧了…",
            "nextDialogs": [
              "10120311"
            ]
          },
          "10120311": {
            "id": "10120311",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "可是岚姐身上确实很香呀，不是香膏的话，会是什么呢？",
            "nextDialogs": [
              "10120312"
            ]
          },
          "10120312": {
            "id": "10120312",
            "speakerId": 2016,
            "speakerName": "岚姐",
            "text": "这么说来，确实好像有一股香味，我想想…",
            "nextDialogs": [
              "10120313"
            ]
          },
          "10120313": {
            "id": "10120313",
            "speakerId": 2016,
            "speakerName": "岚姐",
            "text": "哦，莫非是我上次回来时采摘的「清心」？原来我一直带在身上…",
            "nextDialogs": [
              "10120314"
            ]
          },
          "10120314": {
            "id": "10120314",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "欸，原来是这样啊…岚姐竟然还有在路边摘花的雅兴。",
            "nextDialogs": [
              "10120315"
            ]
          },
          "10120315": {
            "id": "10120315",
            "speakerId": 2016,
            "speakerName": "岚姐",
            "text": "…唔，不过是药用而已。",
            "nextDialogs": [
              "10120316"
            ]
          },
          "10120316": {
            "id": "10120316",
            "speakerId": 2016,
            "speakerName": "岚姐",
            "text": "不要继续这种无意义的话题了，香膏的话…你们不如去找<color=#00E1FFFF>绮命</color>问问。",
            "nextDialogs": [
              "10120317"
            ]
          },
          "10120317": {
            "id": "10120317",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "是那位占卜师姐姐吧？嗯，确实给人香香的印象…",
            "nextDialogs": [
              "10120318"
            ]
          },
          "10120318": {
            "id": "10120318",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "那我们先走啦，谢谢岚姐！"
          },
          "10120308": {
            "id": "10120308",
            "speakerId": 2016,
            "speakerName": "岚姐",
            "text": "…唔。",
            "nextDialogs": [
              "10120309"
            ]
          },
          "10120309": {
            "id": "10120309",
            "speakerId": 2016,
            "speakerName": "岚姐",
            "text": "让我确定一下你们是不是在捉弄我，或者说什么反话…",
            "nextDialogs": [
              "10120310"
            ]
          },
          "10120310": {
            "id": "10120310",
            "speakerId": 2016,
            "speakerName": "岚姐",
            "text": "我常年在外奔走，虽然也很注意打理自己，但要说「闻起来很香」…"
          }
        }
      }
    },
    {
      "subId": "101204",
      "subQuestName": "向绮命请教",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "10120401"
        ],
        "dialogs": {
          "10120401": {
            "id": "10120401",
            "speakerId": 2015,
            "speakerName": "绮命",
            "text": "嗯？有什么事吗，二位。",
            "nextDialogs": [
              "10120402"
            ]
          },
          "10120402": {
            "id": "10120402",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "绮命小姐有空的话，想问你件事…",
            "nextDialogs": [
              "10120404",
              "10120406"
            ]
          },
          "10120404": {
            "id": "10120404",
            "speakerId": 2015,
            "speakerName": "绮命",
            "text": "香膏啊…我平时不用的，也没想过自己去熬制。",
            "nextDialogs": [
              "10120411"
            ]
          },
          "10120411": {
            "id": "10120411",
            "speakerId": 2015,
            "speakerName": "绮命",
            "text": "不过我的身上应该会有一些脂粉的味道，可能让你们误会了吧。",
            "nextDialogs": [
              "10120412"
            ]
          },
          "10120412": {
            "id": "10120412",
            "speakerId": 2015,
            "speakerName": "绮命",
            "text": "我平常在码头附近摆摊，可不希望香膏引来更多色眯眯的水手…",
            "nextDialogs": [
              "10120413"
            ]
          },
          "10120413": {
            "id": "10120413",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "这样呀，好遗憾哦。",
            "nextDialogs": [
              "10120414"
            ]
          },
          "10120414": {
            "id": "10120414",
            "speakerId": 2015,
            "speakerName": "绮命",
            "text": "不过，说起香膏，你们居然没听说过「莺儿的手工香膏」吗？",
            "nextDialogs": [
              "10120415"
            ]
          },
          "10120415": {
            "id": "10120415",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "莺儿，是…「春香窑」的那位<color=#00E1FFFF>莺儿</color>？",
            "nextDialogs": [
              "10120416"
            ]
          },
          "10120416": {
            "id": "10120416",
            "speakerId": 2015,
            "speakerName": "绮命",
            "text": "是的，许多人家的千金小姐，都会拜托她熬香膏来用。据说她手工自制的品质，比市面上贩卖的还要好。",
            "nextDialogs": [
              "10120417"
            ]
          },
          "10120417": {
            "id": "10120417",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "太好了，谢谢你的情报！这下应该不会再扑个空啦。"
          },
          "10120406": {
            "id": "10120406",
            "speakerId": 2015,
            "speakerName": "绮命",
            "text": "啊…唔…",
            "nextDialogs": [
              "10120407"
            ]
          },
          "10120407": {
            "id": "10120407",
            "speakerId": 2015,
            "speakerName": "绮命",
            "text": "…抱歉，没想到你会这么直白。",
            "nextDialogs": [
              "10120408"
            ]
          },
          "10120408": {
            "id": "10120408",
            "speakerId": 2015,
            "speakerName": "绮命",
            "text": "不过我对你其实还不是十分了解…",
            "nextDialogs": [
              "10120409"
            ]
          },
          "10120409": {
            "id": "10120409",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "嗯？我们的意思是想问你平时用不用香膏。",
            "nextDialogs": [
              "10120410"
            ]
          },
          "10120410": {
            "id": "10120410",
            "speakerId": 2015,
            "speakerName": "绮命",
            "text": "啊，咳咳…香膏的话，我没有在用哦。"
          }
        }
      }
    },
    {
      "subId": "101205",
      "subQuestName": "向莺儿请教",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "10120501"
        ],
        "dialogs": {
          "10120501": {
            "id": "10120501",
            "speakerId": 2083,
            "speakerName": "莺儿",
            "text": "欸，终于找到我了么？我可是等你们好久了。",
            "nextDialogs": [
              "10120502"
            ]
          },
          "10120502": {
            "id": "10120502",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "嗯？你怎么会知道我们要过来？",
            "nextDialogs": [
              "10120503"
            ]
          },
          "10120503": {
            "id": "10120503",
            "speakerId": 2083,
            "speakerName": "莺儿",
            "text": "我刚听说有两个人在满城找身上很香的人下手…",
            "nextDialogs": [
              "10120504"
            ]
          },
          "10120504": {
            "id": "10120504",
            "speakerId": 2083,
            "speakerName": "莺儿",
            "text": "我还担心你们不会来呢，某种意义上讲，这也是对我魅力的考验呀…",
            "nextDialogs": [
              "10120505"
            ]
          },
          "10120505": {
            "id": "10120505",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "「下手」？怎么说得我们好像是危险人物的样子！",
            "nextDialogs": [
              "10120506"
            ]
          },
          "10120506": {
            "id": "10120506",
            "speakerId": 2083,
            "speakerName": "莺儿",
            "text": "以讹传讹，三人成虎，言行最好谨慎一些哦。",
            "nextDialogs": [
              "10120507"
            ]
          },
          "10120507": {
            "id": "10120507",
            "speakerId": 2083,
            "speakerName": "莺儿",
            "text": "放心，我知道你们的来意，是想我帮忙做香膏吧？需要什么样的呢？",
            "nextDialogs": [
              "10120513",
              "10120510"
            ]
          },
          "10120513": {
            "id": "10120513",
            "speakerId": 2083,
            "speakerName": "莺儿",
            "text": "欸~居然要同时做三份…",
            "nextDialogs": [
              "10120514"
            ]
          },
          "10120514": {
            "id": "10120514",
            "speakerId": 2083,
            "speakerName": "莺儿",
            "text": "想不到明明这么年轻，胃口却不小呢，呵呵。该不会之前的传言是真的吧？是在物色可以送香膏的目标吗？"
          },
          "10120510": {
            "id": "10120510",
            "speakerId": 2083,
            "speakerName": "莺儿",
            "text": "呵呵，我根本没用什么香膏哦。",
            "nextDialogs": [
              "10120511"
            ]
          },
          "10120511": {
            "id": "10120511",
            "speakerId": 2083,
            "speakerName": "莺儿",
            "text": "莫非你迷上我的体香了？那可就让人为难了呀…",
            "nextDialogs": [
              "10120512"
            ]
          },
          "10120512": {
            "id": "10120512",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "#欸…你们在说什么奇怪的话？{NICKNAME}，快把那三种霓裳花拿出来吧！"
          }
        }
      }
    },
    {
      "subId": "101213",
      "subQuestName": "与莺儿汇合",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "10121101"
        ],
        "dialogs": {
          "10121101": {
            "id": "10121101",
            "speakerId": 2083,
            "speakerName": "莺儿",
            "text": "我已经跟卯师傅打过招呼了，现在要准备开工了哦。",
            "nextDialogs": [
              "10121102"
            ]
          },
          "10121102": {
            "id": "10121102",
            "speakerId": 2083,
            "speakerName": "莺儿",
            "text": "你做好准备，对我负责了吧？",
            "nextDialogs": [
              "10121103"
            ]
          },
          "10121103": {
            "id": "10121103",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "嗯？",
            "nextDialogs": [
              "10121104"
            ]
          },
          "10121104": {
            "id": "10121104",
            "speakerId": 2083,
            "speakerName": "莺儿",
            "text": "我是说负担起「助手」的责任，呵呵呵…",
            "nextDialogs": [
              "10121105"
            ]
          },
          "10121105": {
            "id": "10121105",
            "speakerId": 2083,
            "speakerName": "莺儿",
            "text": "在我准备制作工序的时候，你就先帮我取些水来吧。"
          }
        }
      }
    },
    {
      "subId": "101206",
      "subQuestName": "前往取水",
      "sceneId": null,
      "locations": [],
      "dialogue": {

    },
    {
      "subId": "101208",
      "subQuestName": "(test)合成霓裳花精油$HIDDEN",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "10120801"
        ],
        "dialogs": {
          "10120801": {
            "id": "10120801",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "钟离先生！我们把香膏带过来啦。",
            "nextDialogs": [
              "10120802"
            ]
          },
          "10120802": {
            "id": "10120802",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "钟离先生…刚才好像在对着神像发呆呢，是不是让你等得太久啦…",
            "nextDialogs": [
              "10120803"
            ]
          },
          "10120803": {
            "id": "10120803",
            "speakerId": 10232,
            "speakerName": "钟离",
            "text": "哦，你们回来了，我也没有等很久。",
            "nextDialogs": [
              "10120804"
            ]
          },
          "10120804": {
            "id": "10120804",
            "speakerId": 10232,
            "speakerName": "钟离",
            "text": "比起神像所刻的岩王帝君的守望，不过是短短一瞬而已。",
            "nextDialogs": [
              "10120805"
            ]
          },
          "10120805": {
            "id": "10120805",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "哈哈，人怎么能跟雕像比呀。",
            "nextDialogs": [
              "10120806"
            ]
          },
          "10120806": {
            "id": "10120806",
            "speakerId": 10232,
            "speakerName": "钟离",
            "text": "说得也是。如何，你们把香膏带来了吗？",
            "nextDialogs": [
              "10120807"
            ]
          },
          "10120807": {
            "id": "10120807",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "三份香膏，一份不少！",
            "nextDialogs": [
              "10120808"
            ]
          },
          "10120808": {
            "id": "10120808",
            "speakerId": 10232,
            "speakerName": "钟离",
            "text": "辛苦二位了，我们试着依次供奉上去吧。",
            "nextDialogs": [
              "10120809"
            ]
          },
          "10120809": {
            "id": "10120809",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "（供奉「金屋藏娇」）",
            "nextDialogs": [
              "10120810"
            ]
          },
          "10120810": {
            "id": "10120810",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "这是第一种香膏，莺儿小姐说它甜蜜梦幻，是小女孩们最喜欢的。",
            "nextDialogs": [
              "10120811"
            ]
          },
          "10120811": {
            "id": "10120811",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "（供奉「山阴锦簇」）",
            "nextDialogs": [
              "10120812"
            ]
          },
          "10120812": {
            "id": "10120812",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "这是第二种香膏，说是贵气凌人，富家千金的最爱。",
            "nextDialogs": [
              "10120813"
            ]
          },
          "10120813": {
            "id": "10120813",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "（供奉「缥缈仙缘」）",
            "nextDialogs": [
              "10120814"
            ]
          },
          "10120814": {
            "id": "10120814",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "第三种香膏，香气轻柔却久久不散，如雾色朦胧…什么什么的，最受成熟女性的欢迎。",
            "nextDialogs": [
              "10120815"
            ]
          },
          "10120815": {
            "id": "10120815",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "欸…刚才那是？",
            "nextDialogs": [
              "10120818"
            ]
          },
          "10120818": {
            "id": "10120818",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "那是成熟的大姐姐喜欢用的款式吧？",
            "nextDialogs": [
              "10120819"
            ]
          },
          "10120819": {
            "id": "10120819",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "难道说…「岩王帝君」其实是一位大姐姐？",
            "nextDialogs": [
              "10120820"
            ]
          },
          "10120820": {
            "id": "10120820",
            "speakerId": 10232,
            "speakerName": "钟离",
            "text": "哈哈哈…说不定呢。",
            "nextDialogs": [
              "10120821"
            ]
          },
          "10120821": {
            "id": "10120821",
            "speakerId": 10232,
            "speakerName": "钟离",
            "text": "「岩王帝君」的化身有万万千千，或许真有这么一个形象存在。",
            "nextDialogs": [
              "10120822"
            ]
          },
          "10120822": {
            "id": "10120822",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "可惜我们只见过那个特别巨大的龙形，而且…",
            "nextDialogs": [
              "10120823"
            ]
          },
          "10120823": {
            "id": "10120823",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "希望「璃月七星」能抓到真正的凶手。",
            "nextDialogs": [
              "10120824"
            ]
          },
          "10120824": {
            "id": "10120824",
            "speakerId": 10232,
            "speakerName": "钟离",
            "text": "那些就留给位高权重之人去苦恼吧，我们只需做好与「岩王帝君」的饯别之礼。"
          }
        }
      }
    },

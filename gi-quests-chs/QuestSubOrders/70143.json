  "subQuests": [
    {
      "subId": "7014302",
      "subQuestName": "与凯瑟琳对话",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "701430201"
        ],
        "dialogs": {
          "701430201": {
            "id": "701430201",
            "speakerId": 1512,
            "speakerName": "凯瑟琳",
            "text": "你好，旅行者，最近的冒险行动还顺利吗？",
            "nextDialogs": [
              "701430202"
            ]
          },
          "701430202": {
            "id": "701430202",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "还算是顺利。",
            "nextDialogs": [
              "701430203"
            ]
          },
          "701430203": {
            "id": "701430203",
            "speakerId": 1512,
            "speakerName": "凯瑟琳",
            "text": "嗯，你的那些冒险事迹我都听说了，以这个势头继续冒险的话，你肯定能成为一名优秀的冒险家。",
            "nextDialogs": [
              "701430204"
            ]
          },
          "701430204": {
            "id": "701430204",
            "speakerId": 1512,
            "speakerName": "凯瑟琳",
            "text": "然后…关于冒险行动，我这里有一份「冒险情报」，不知道你有没有兴趣。",
            "nextDialogs": [
              "701430205"
            ]
          },
          "701430205": {
            "id": "701430205",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "又有什么新委托吗…",
            "nextDialogs": [
              "701430206"
            ]
          },
          "701430206": {
            "id": "701430206",
            "speakerId": 1512,
            "speakerName": "凯瑟琳",
            "text": "看来你对于协会里的这些事务已经很熟练了呢。",
            "nextDialogs": [
              "701430207"
            ]
          },
          "701430207": {
            "id": "701430207",
            "speakerId": 1512,
            "speakerName": "凯瑟琳",
            "text": "不过，这次不是委托，而是一份「冒险情报」。",
            "nextDialogs": [
              "701430208"
            ]
          },
          "701430208": {
            "id": "701430208",
            "speakerId": 1512,
            "speakerName": "凯瑟琳",
            "text": "这份「冒险情报」，是关于蒙德旁边那座「龙脊雪山」的。",
            "nextDialogs": [
              "701430209"
            ]
          },
          "701430209": {
            "id": "701430209",
            "speakerId": 1512,
            "speakerName": "凯瑟琳",
            "text": "在那里，协会已经设置好了营地，还驻扎了不少冒险家。",
            "nextDialogs": [
              "701430210"
            ]
          },
          "701430210": {
            "id": "701430210",
            "speakerId": 1512,
            "speakerName": "凯瑟琳",
            "text": "地点我给你标注在地图上了，到达那片营地之后，你可以先去找一位叫做「玉霞」的冒险家了解一下周围的情况。",
            "nextDialogs": [
              "701430211"
            ]
          },
          "701430211": {
            "id": "701430211",
            "speakerId": 1512,
            "speakerName": "凯瑟琳",
            "text": "那么，继续冒险吧，向着星辰与深渊！"
          }
        }
      }
    },
    {
      "subId": "7014301",
      "subQuestName": "与玉霞对话",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "701430101"
        ],
        "dialogs": {
          "701430101": {
            "id": "701430101",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "关于进入雪山冒险…",
            "nextDialogs": [
              "701430102"
            ]
          },
          "701430102": {
            "id": "701430102",
            "speakerId": 1665,
            "speakerName": "玉霞",
            "text": "如果你真想去雪山里冒险，那可要先做好万全的准备再进山，绝不能掉以轻心。",
            "nextDialogs": [
              "701430103"
            ]
          },
          "701430103": {
            "id": "701430103",
            "speakerId": 1665,
            "speakerName": "玉霞",
            "text": "对于粗心大意的冒险家，雪山可不会留任何情面。"
          }
        }
      }
    }
  ]
}
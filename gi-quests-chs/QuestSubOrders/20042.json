  "subQuests": [
    {
      "subId": "2004201",
      "subQuestName": "与维多利亚对话",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "200420201"
        ],
        "dialogs": {
          "200420201": {
            "id": "200420201",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "我知道了。",
            "nextDialogs": [
              "200420202"
            ]
          },
          "200420202": {
            "id": "200420202",
            "speakerId": 1471,
            "speakerName": "维多利亚",
            "text": "风神保佑您。"
          }
        }
      }
    },
    {
      "subId": "2004202",
      "subQuestName": "在教堂附近找到艾伯特",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "200421101"
        ],
        "dialogs": {
          "200421101": {
            "id": "200421101",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "好吧…",
            "nextDialogs": [
              "200421102"
            ]
          },
          "200421102": {
            "id": "200421102",
            "speakerId": 1602,
            "speakerName": "艾伯特",
            "text": "那就拜托你了，冲吧！"
          }
        }
      }
    },
    {
      "subId": "2004203",
      "subQuestName": "清扫落叶堆",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "200420301"
        ],
        "dialogs": {
          "200420301": {
            "id": "200420301",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "要直接找西风骑士团吗？",
            "nextDialogs": [
              "200420302"
            ]
          },
          "200420302": {
            "id": "200420302",
            "speakerId": 1471,
            "speakerName": "维多利亚",
            "text": "我也想过这样做。",
            "nextDialogs": [
              "200420303"
            ]
          },
          "200420303": {
            "id": "200420303",
            "speakerId": 1471,
            "speakerName": "维多利亚",
            "text": "但我没有他什么直接的把柄，西风骑士团也介入不了…",
            "nextDialogs": [
              "200420304"
            ]
          },
          "200420304": {
            "id": "200420304",
            "speakerId": 1471,
            "speakerName": "维多利亚",
            "text": "风神在上，请你快点去把他赶走吧。"
          }
        }
      }
    },
    {
      "subId": "2004204",
      "subQuestName": "与艾伯特对话",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "200420601"
        ],
        "dialogs": {
          "200420601": {
            "id": "200420601",
            "speakerId": 1602,
            "speakerName": "艾伯特",
            "text": "落叶都扫除掉了吗？",
            "nextDialogs": [
              "200420602"
            ]
          },
          "200420602": {
            "id": "200420602",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "全部扫除了。",
            "nextDialogs": [
              "200420603"
            ]
          },
          "200420603": {
            "id": "200420603",
            "speakerId": 1602,
            "speakerName": "艾伯特",
            "text": "辛苦了，教堂一下子就干净了很多，这样子芭芭拉小姐也会轻松不少吧…",
            "nextDialogs": [
              "200420604"
            ]
          },
          "200420604": {
            "id": "200420604",
            "speakerId": 1602,
            "speakerName": "艾伯特",
            "text": "对了，你可别告诉芭芭拉小姐啊。",
            "nextDialogs": [
              "200420605"
            ]
          },
          "200420605": {
            "id": "200420605",
            "speakerId": 1602,
            "speakerName": "艾伯特",
            "text": "本来我是想帮她分忧的，可别反而让她困扰了。",
            "nextDialogs": [
              "200420606"
            ]
          },
          "200420606": {
            "id": "200420606",
            "speakerId": 1602,
            "speakerName": "艾伯特",
            "text": "放心啦，按照我们说好的，我现在就离开。",
            "nextDialogs": [
              "200420607"
            ]
          },
          "200420607": {
            "id": "200420607",
            "speakerId": 1602,
            "speakerName": "艾伯特",
            "text": "再见了…不对，我们下次再见。"
          }
        }
      }
    },
    {
      "subId": "2004205",
      "subQuestName": "到教堂内向维多利亚报告",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "200420701"
        ],
        "dialogs": {
          "200420701": {
            "id": "200420701",
            "speakerId": 1471,
            "speakerName": "维多利亚",
            "text": "关于艾伯特先生…",
            "nextDialogs": [
              "200420702"
            ]
          },
          "200420702": {
            "id": "200420702",
            "speakerId": 1471,
            "speakerName": "维多利亚",
            "text": "艾伯特离开了吗？",
            "nextDialogs": [
              "200420703"
            ]
          },
          "200420703": {
            "id": "200420703",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "已经走了。",
            "nextDialogs": [
              "200420704"
            ]
          },
          "200420704": {
            "id": "200420704",
            "speakerId": 1471,
            "speakerName": "维多利亚",
            "text": "总算解决了…你刚才为什么去清除落叶了？",
            "nextDialogs": [
              "200420705"
            ]
          },
          "200420705": {
            "id": "200420705",
            "speakerId": 1471,
            "speakerName": "维多利亚",
            "text": "算了，这样也好，免得那个艾伯特又找到了借口，借着清除落叶来接近教堂。",
            "nextDialogs": [
              "200420706"
            ]
          },
          "200420706": {
            "id": "200420706",
            "speakerId": 1471,
            "speakerName": "维多利亚",
            "text": "这些是给你的谢礼，收下吧，愿风神保佑你。",
            "nextDialogs": [
              "200420707"
            ]
          },
          "200420707": {
            "id": "200420707",
            "speakerId": 1471,
            "speakerName": "维多利亚",
            "text": "没什么事的话，我要继续工作了，你也去忙自己的吧。"
          }
        }
      }
    },
    {
      "subId": "2004201",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "200420101"
        ],
        "dialogs": {
          "200420101": {
            "id": "200420101",
            "speakerId": 1471,
            "speakerName": "维多利亚",
            "text": "…真是麻烦，到底躲哪去了？",
            "nextDialogs": [
              "200420102"
            ]
          },
          "200420102": {
            "id": "200420102",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "你在找什么？",
            "nextDialogs": [
              "200420103"
            ]
          },
          "200420103": {
            "id": "200420103",
            "speakerId": 1471,
            "speakerName": "维多利亚",
            "text": "找？哦…我正在找一个可疑的家伙。",
            "nextDialogs": [
              "200420104"
            ]
          },
          "200420104": {
            "id": "200420104",
            "speakerId": 1471,
            "speakerName": "维多利亚",
            "text": "那个叫艾伯特的男人，白天一直鬼鬼祟祟地在教堂边上打转。",
            "nextDialogs": [
              "200420105"
            ]
          },
          "200420105": {
            "id": "200420105",
            "speakerId": 1471,
            "speakerName": "维多利亚",
            "text": "看着就不怀好意，我担心他在预谋什么可怕的事。",
            "nextDialogs": [
              "200420106"
            ]
          },
          "200420106": {
            "id": "200420106",
            "speakerId": 1471,
            "speakerName": "维多利亚",
            "text": "你能去把艾伯特赶走吗？"
          }
        }
      }
    },
    {
      "subId": "2004204",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "200420401"
        ],
        "dialogs": {
          "200420401": {
            "id": "200420401",
            "speakerId": 1602,
            "speakerName": "艾伯特",
            "text": "芭芭拉冲呀！",
            "nextDialogs": [
              "200420402"
            ]
          },
          "200420402": {
            "id": "200420402",
            "speakerId": 1602,
            "speakerName": "艾伯特",
            "text": "咳，你找我有事情吗？"
          }
        }
      }
    },
    {
      "subId": "2004205",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "200420501"
        ],
        "dialogs": {
          "200420501": {
            "id": "200420501",
            "speakerId": 1602,
            "speakerName": "艾伯特",
            "text": "为了蒙德城，和芭芭拉小姐，要认真打扫落叶！"
          }
        }
      }
    },
    {
      "subId": "2004208",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "200420801"
        ],
        "dialogs": {
          "200420801": {
            "id": "200420801",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "修女请你马上离开这里。",
            "nextDialogs": [
              "200420802"
            ]
          },
          "200420802": {
            "id": "200420802",
            "speakerId": 1602,
            "speakerName": "艾伯特",
            "text": "离开…我做了什么吗？"
          }
        }
      }
    },
    {
      "subId": "2004209",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "200420901"
        ],
        "dialogs": {
          "200420901": {
            "id": "200420901",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "你做的事情，我已经通知西风骑士团了。",
            "nextDialogs": [
              "200420902"
            ]
          },
          "200420902": {
            "id": "200420902",
            "speakerId": 1602,
            "speakerName": "艾伯特",
            "text": "喂，我做了什么事啊！？"
          }
        }
      }
    },
    {
      "subId": "2004210",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "200421001"
        ],
        "dialogs": {
          "200421001": {
            "id": "200421001",
            "speakerId": 1602,
            "speakerName": "艾伯特",
            "text": "什么？鬼鬼祟祟、不怀好意、不良预谋…你们完全误会我了…",
            "nextDialogs": [
              "200421002"
            ]
          },
          "200421002": {
            "id": "200421002",
            "speakerId": 1602,
            "speakerName": "艾伯特",
            "text": "呼…你知道芭芭拉小姐吗？就是那位蒙德城的天使。",
            "nextDialogs": [
              "200421003"
            ]
          },
          "200421003": {
            "id": "200421003",
            "speakerId": 1602,
            "speakerName": "艾伯特",
            "text": "很多蒙德人都尊敬着她，我也是其中的一员。",
            "nextDialogs": [
              "200421004"
            ]
          },
          "200421004": {
            "id": "200421004",
            "speakerId": 1602,
            "speakerName": "艾伯特",
            "text": "蒙德城的芭芭拉粉丝团，我就是团长。",
            "nextDialogs": [
              "200421005"
            ]
          },
          "200421005": {
            "id": "200421005",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "西风骑士马上就到。",
            "nextDialogs": [
              "200421006"
            ]
          },
          "200421006": {
            "id": "200421006",
            "speakerId": 1602,
            "speakerName": "艾伯特",
            "text": "你听我把话说完啊！因为很尊敬芭芭拉小姐，我也想和芭芭拉小姐一样，为这座蒙德城做点贡献。",
            "nextDialogs": [
              "200421007"
            ]
          },
          "200421007": {
            "id": "200421007",
            "speakerId": 1602,
            "speakerName": "艾伯特",
            "text": "我是个普通人，只能做一些力所能及的事。比如为教堂做清洁…",
            "nextDialogs": [
              "200421008"
            ]
          },
          "200421008": {
            "id": "200421008",
            "speakerId": 1602,
            "speakerName": "艾伯特",
            "text": "但每次维多利亚修女都不听我解释，直接把我赶走了…",
            "nextDialogs": [
              "200421009"
            ]
          },
          "200421009": {
            "id": "200421009",
            "speakerId": 1602,
            "speakerName": "艾伯特",
            "text": "我最近发现，教堂周围的枯叶很久没扫了，但维多利亚修女肯定不会让我解决。",
            "nextDialogs": [
              "200421010"
            ]
          },
          "200421010": {
            "id": "200421010",
            "speakerId": 1602,
            "speakerName": "艾伯特",
            "text": "为了蒙德城和芭芭拉小姐，你们愿意帮我扫走那些落叶吗？"
          }
        }
      }
    },
    {
      "subId": "2004212",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "200421201"
        ],
        "dialogs": {
          "200421201": {
            "id": "200421201",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "为了让你赶紧离开…",
            "nextDialogs": [
              "200421202"
            ]
          },
          "200421202": {
            "id": "200421202",
            "speakerId": 1602,
            "speakerName": "艾伯特",
            "text": "喂，都说了我做的不是坏事啊！",
            "nextDialogs": [
              "200421203"
            ]
          },
          "200421203": {
            "id": "200421203",
            "speakerId": 1602,
            "speakerName": "艾伯特",
            "text": "好了，等落叶打扫完之后，我就会离开了。"
          }
        }
      }
    },
    {
      "subId": "2004213",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "200421301"
        ],
        "dialogs": {
          "200421301": {
            "id": "200421301",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "西风骑士团会来打扫一切的。",
            "nextDialogs": [
              "200421302"
            ]
          },
          "200421302": {
            "id": "200421302",
            "speakerId": 1602,
            "speakerName": "艾伯特",
            "text": "这是在做好事！别动不动通知骑士团啊！",
            "nextDialogs": [
              "200421303"
            ]
          },
          "200421303": {
            "id": "200421303",
            "speakerId": 1602,
            "speakerName": "艾伯特",
            "text": "怕了你了，好啦好啦我知道了，打扫完落叶之后我就会走了…"
          }
        }
      }
    }
  ]
}
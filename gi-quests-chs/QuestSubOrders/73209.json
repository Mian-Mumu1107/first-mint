      }
    },
    {
      "subId": "7320903",
      "subQuestName": "用草元素的力量「唤醒」金蔷薇",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "732090426"
        ],
        "dialogs": {
          "732090426": {
            "id": "732090426",
            "speakerId": 1003,
            "speakerName": "Black Screen",
            "text": "「蔷薇啊蔷薇，实现我的愿望。」",
            "nextDialogs": [
              "732090427"
            ]
          },
          "732090427": {
            "id": "732090427",
            "speakerId": 1003,
            "speakerName": "Black Screen",
            "text": "「花从石头中绽放，金蔷薇对我歌唱。」",
            "nextDialogs": [
              "732090401"
            ]
          },
          "732090401": {
            "id": "732090401",
            "speakerId": 1002,
            "speakerName": "派蒙",
            "text": "金色的蔷薇花果然很漂亮，看到它们开放，感觉心情也明亮起来了。",
            "nextDialogs": [
              "732090402"
            ]
          },
          "732090402": {
            "id": "732090402",
            "speakerId": 1002,
            "speakerName": "派蒙",
            "text": "这些天的辛苦没有白费，好开心！",
            "nextDialogs": [
              "732090405"
            ]
          },
          "732090405": {
            "id": "732090405",
            "speakerId": 1000,
            "speakerName": "阿凡",
            "text": "到最后，我终于有一件能做好的事了。沙法卡特叔叔，你的心愿我替你达成了。",
            "nextDialogs": [
              "732090406"
            ]
          },
          "732090406": {
            "id": "732090406",
            "speakerId": 1001,
            "speakerName": "赛芭",
            "text": "遗憾的是，他看不到了。",
            "nextDialogs": [
              "732090407"
            ]
          },
          "732090407": {
            "id": "732090407",
            "speakerId": 1000,
            "speakerName": "阿凡",
            "text": "赛芭，不能这样说啊。你记得蔷薇歌谣最后的那段吗？",
            "nextDialogs": [
              "732090408"
            ]
          },
          "732090408": {
            "id": "732090408",
            "speakerId": 1000,
            "speakerName": "阿凡",
            "text": "「没有土地承载我，唯有歌谣承载我。」",
            "nextDialogs": [
              "732090409"
            ]
          },
          "732090409": {
            "id": "732090409",
            "speakerId": 1000,
            "speakerName": "阿凡",
            "text": "「歌谣战胜敌视我的命运，战胜我的结局。」",
            "nextDialogs": [
              "732090410"
            ]
          },
          "732090410": {
            "id": "732090410",
            "speakerId": 1000,
            "speakerName": "阿凡",
            "text": "「战胜我战胜时间，战胜永不消逝的消逝。」",
            "nextDialogs": [
              "732090411"
            ]
          },
          "732090411": {
            "id": "732090411",
            "speakerId": 1000,
            "speakerName": "阿凡",
            "text": "沙法卡特叔叔的生命和金蔷薇还有他亲自编写的歌谣一起，都留在了我们身边。",
            "nextDialogs": [
              "732090412"
            ]
          },
          "732090412": {
            "id": "732090412",
            "speakerId": 1001,
            "speakerName": "赛芭",
            "text": "嗯，说的没错，他是战胜了消逝的人。",
            "nextDialogs": [
              "732090413"
            ]
          },
          "732090413": {
            "id": "732090413",
            "speakerId": 1001,
            "speakerName": "赛芭",
            "text": "谢谢你们让我知道沙法卡特先生的事，这对我来说很重要。",
            "nextDialogs": [
              "732090414"
            ]
          },
          "732090414": {
            "id": "732090414",
            "speakerId": 1001,
            "speakerName": "赛芭",
            "text": "他是在我之前的流放者，看到他的那些生活痕迹，总让我觉得自己好像跨越了时空…",
            "nextDialogs": [
              "732090415"
            ]
          },
          "732090415": {
            "id": "732090415",
            "speakerId": 1001,
            "speakerName": "赛芭",
            "text": "我看着的不仅是沙法卡特先生，还有我自己。",
            "nextDialogs": [
              "732090416"
            ]
          },
          "732090416": {
            "id": "732090416",
            "speakerId": 1001,
            "speakerName": "赛芭",
            "text": "虽然我不能对他说些什么，但我可以带着他的遗憾生活下去。",
            "nextDialogs": [
              "732090417"
            ]
          },
          "732090417": {
            "id": "732090417",
            "speakerId": 1001,
            "speakerName": "赛芭",
            "text": "如果我连带着他的份一起努力生活下去，那最终我一定能救赎自己。"
          }
        }
      }
    },
    {
      "subId": "7320905",
      "subQuestName": "（test）苗圃变化$HIDDEN",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [

    {
      "subId": "7320907",
      "subQuestName": "(test)计时$HIDDEN",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "732090701"
        ],
        "dialogs": {
          "732090701": {
            "id": "732090701",
            "speakerId": 1000,
            "speakerName": "阿凡",
            "text": "老头子我都快不抱希望了，没想到这花最后还是种出来了，果然活着就能有奇妙的事发生。",
            "nextDialogs": [
              "732090702"
            ]
          },
          "732090702": {
            "id": "732090702",
            "speakerId": 1000,
            "speakerName": "阿凡",
            "text": "小姑娘，还在为沙法卡特叔叔的事难过吗？别愁啦，活着的人要带着死去的人那些心愿活下去才算对得起他们哩。",
            "nextDialogs": [
              "732090703"
            ]
          },
          "732090703": {
            "id": "732090703",
            "speakerId": 1001,
            "speakerName": "赛芭",
            "text": "老先生…我已经不小了，那些和我一起长大的朋友们，说不定她们的孩子都会去店里买香料了。",
            "nextDialogs": [
              "732090704"
            ]
          },
          "732090704": {
            "id": "732090704",
            "speakerId": 1001,
            "speakerName": "赛芭",
            "text": "但无论如何你说得对，既然活着总要开开心心地活下去才行。"
          }
        }
      }
    },
    {
      "subId": "7320901",
      "subQuestName": "(test)再次与阿凡和赛芭对话$HIDDEN",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "732090101"
        ],
        "dialogs": {
          "732090101": {
            "id": "732090101",
            "speakerId": 1000,
            "speakerName": "阿凡",
            "text": "是你们啊，蔷薇还有我们都在等着。",
            "nextDialogs": [
              "732090102"
            ]
          },
          "732090102": {
            "id": "732090102",
            "speakerId": 1002,
            "speakerName": "派蒙",
            "text": "赛芭也早早地来了啊。",
            "nextDialogs": [
              "732090103"
            ]
          },
          "732090103": {
            "id": "732090103",
            "speakerId": 1001,
            "speakerName": "赛芭",
            "text": "我最近常来这里，沙法卡特先生留下的手记都看了个遍。",
            "nextDialogs": [
              "732090104"
            ]
          },
          "732090104": {
            "id": "732090104",
            "speakerId": 1001,
            "speakerName": "赛芭",
            "text": "以前我一直觉得呆在阿如村生活很寂寞，但现在感觉不同了。",
            "nextDialogs": [
              "732090105"
            ]
          },
          "732090105": {
            "id": "732090105",
            "speakerId": 1001,
            "speakerName": "赛芭",
            "text": "至少我不完全是一个人，还有这些蔷薇，和你们一起的记忆，还有阿凡先生一起。",
            "nextDialogs": [
              "732090106"
            ]
          },
          "732090106": {
            "id": "732090106",
            "speakerId": 1001,
            "speakerName": "赛芭",
            "text": "我的生活里还有些美好的念想，这样一想就觉得自己没有那么寂寞了。",
            "nextDialogs": [
              "732090107"
            ]
          },
          "732090107": {
            "id": "732090107",
            "speakerId": 1001,
            "speakerName": "赛芭",
            "text": "我和阿凡老先生商量好了，以后我就帮他一起照看金蔷薇。",
            "nextDialogs": [
              "732090108"
            ]
          },
          "732090108": {
            "id": "732090108",
            "speakerId": 1001,
            "speakerName": "赛芭",
            "text": "让它们越开越多，开满整个苗圃。至于现在，先让这几株开出花来吧。",
            "nextDialogs": [
              "732090109"
            ]
          },
          "732090109": {
            "id": "732090109",
            "speakerId": 1001,
            "speakerName": "赛芭",
            "text": "你还记得之前是怎么让我的须弥蔷薇开花的吗？用同样的方法就好。",
            "nextDialogs": [
              "732090110"
            ]
          },
          "732090110": {
            "id": "732090110",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "交给我吧。",
            "nextDialogs": [
              "732090111"
            ]
          },
          "732090111": {
            "id": "732090111",
            "speakerId": 1001,
            "speakerName": "赛芭",
            "text": "来，看你的了。"
          }
        }
      }
    },
    {
      "subId": "7320902",
      "subQuestName": "用草元素的力量「唤醒」金蔷薇",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [],

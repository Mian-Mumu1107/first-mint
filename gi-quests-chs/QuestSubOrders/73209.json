    {
      "subId": "7320906",
      "subQuestName": "（test）用草元素的力量「唤醒」金蔷薇",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "732090601"
        ],
        "dialogs": {
          "732090601": {
            "id": "732090601",
            "speakerId": 1000,
            "speakerName": "阿凡",
            "text": "只要这几株能健康地生长，我们以后一定能培育出更多的金蔷薇。",
            "nextDialogs": [
              "732090602"
            ]
          },
          "732090602": {
            "id": "732090602",
            "speakerId": 1000,
            "speakerName": "阿凡",
            "text": "不过在这之前，还是得先看到这几株金蔷薇开花我才放心啊。"
          }
        }
      }
    },

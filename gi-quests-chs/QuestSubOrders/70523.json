  "subQuests": [
    {
      "subId": "7052301",
      "subQuestName": "",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "705230101"
        ],
        "dialogs": {
          "705230101": {
            "id": "705230101",
            "speakerId": 1000,
            "speakerName": "关垂",
            "text": "外地来的客人？欢迎来到轻策庄…",
            "nextDialogs": [
              "705230104"
            ]
          },
          "705230104": {
            "id": "705230104",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "我先说我先说，我们先自我介绍！",
            "nextDialogs": [
              "705230105"
            ]
          },
          "705230105": {
            "id": "705230105",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "#这是无所不能的旅行者{NICKNAME}，我是旅行者最好的伙伴派蒙。",
            "nextDialogs": [
              "705230106"
            ]
          },
          "705230106": {
            "id": "705230106",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "我们正在帮外地的客人订购佳酿节的特色饮品，看到了你的委托，所以就来直接和你商量了。",
            "nextDialogs": [
              "705230107"
            ]
          },
          "705230107": {
            "id": "705230107",
            "speakerId": 1000,
            "speakerName": "关垂",
            "text": "原来如此，真是爽快人！那我也不废话了。",
            "nextDialogs": [
              "705230109"
            ]
          },
          "705230109": {
            "id": "705230109",
            "speakerId": 1000,
            "speakerName": "关垂",
            "text": "我是厨师关垂，需要采购<color=#00E1FFFF>100箱「假日果酿」</color>，用来兑茶水，给干体力活的兄弟们喝个痛快。",
            "nextDialogs": [
              "705230110"
            ]
          },
          "705230110": {
            "id": "705230110",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "好！那我们就开工了，请提供采购资金吧。",
            "nextDialogs": [
              "705230111"
            ]
          },
          "705230111": {
            "id": "705230111",
            "speakerId": 1000,
            "speakerName": "关垂",
            "text": "早就准备好了，请收下这些「佳酿晶冻」！下单后想必还会有盈余，不管还剩多少，都是两位劳苦功高的报酬！",
            "nextDialogs": [
              "705230112"
            ]
          },
          "705230112": {
            "id": "705230112",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "我们都收下了，待会儿就出发！",
            "nextDialogs": [
              "705230113"
            ]
          },
          "705230113": {
            "id": "705230113",
            "speakerId": 1000,
            "speakerName": "关垂",
            "text": "好极了！等着你们两位的好消息！"
          }
        }
      }
    },

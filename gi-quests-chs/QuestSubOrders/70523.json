    {
      "subId": "7052302",
      "subQuestName": "返回清泉镇，向格奥尔格提出采购订单",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "705230201"
        ],
        "dialogs": {
          "705230201": {
            "id": "705230201",
            "speakerId": 1002,
            "speakerName": "格奥尔格",
            "text": "哦！你们又来了？",
            "nextDialogs": [
              "705230202"
            ]
          },
          "705230202": {
            "id": "705230202",
            "speakerId": 1002,
            "speakerName": "格奥尔格",
            "text": "这次还是帮别国的客人下单吗？",
            "nextDialogs": [
              "705230203"
            ]
          },
          "705230203": {
            "id": "705230203",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "没错哦，这次我们需要100箱「假日果酿」，委托人是轻策庄的厨师关垂。",
            "nextDialogs": [
              "705230204"
            ]
          },
          "705230204": {
            "id": "705230204",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "我们准备好出价了，格奥尔格先生！",
            "nextDialogs": [
              "705230207"
            ]
          },
          "705230207": {
            "id": "705230207",
            "speakerId": 1002,
            "speakerName": "格奥尔格",
            "text": "喔！气势很强嘛！那就让我看看你们这次的觉悟吧！"
          }
        }
      }
    },
    {
      "subId": "7052306",
      "subQuestName": "与格奥尔格交涉",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "705232601"
        ],
        "dialogs": {
          "705232601": {
            "id": "705232601",
            "speakerId": 1002,
            "speakerName": "格奥尔格",
            "text": "好了，和上次一样，单据给你们，运输工作由我来安排。",
            "nextDialogs": [
              "705232602"
            ]
          },
          "705232602": {
            "id": "705232602",
            "speakerId": 1002,
            "speakerName": "格奥尔格",
            "text": "因为是新顾客，你们还是把单据交给他比较好，这样能让他安心。",
            "nextDialogs": [
              "705232603"
            ]
          },
          "705232603": {
            "id": "705232603",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "格奥尔格先生说得有道理，我们正有此意！",
            "nextDialogs": [
              "705232604"
            ]
          },
          "705232604": {
            "id": "705232604",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "#走吧，{NICKNAME}，我们回轻策庄去交差。"
          }
        }
      }
    },
    {
      "subId": "7052303",
      "subQuestName": "前往轻策庄，答复关垂",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "705230301"
        ],
        "dialogs": {
          "705230301": {
            "id": "705230301",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "关垂先生，我们回来了！",
            "nextDialogs": [
              "705230302"
            ]
          },
          "705230302": {
            "id": "705230302",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "你需要的100箱「假日果酿」已经订好了，这是给你的单据，请收下。",
            "nextDialogs": [
              "705230303"
            ]
          },
          "705230303": {
            "id": "705230303",
            "speakerId": 1000,
            "speakerName": "关垂",
            "text": "好好好！两位真是帮大忙了！",
            "nextDialogs": [
              "705230304"
            ]
          },
          "705230304": {
            "id": "705230304",
            "speakerId": 1000,
            "speakerName": "关垂",
            "text": "我要好好研究一下「假日果酿」，把这种新鲜饮料和茶水按特定的比例混合，调出最好的口感，让兄弟们下地干活时更有干劲！",
            "nextDialogs": [
              "705230305"
            ]
          },
          "705230305": {
            "id": "705230305",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "呃，听起来有点像调酒，不过用茶水来兑…真的能做到吗？",
            "nextDialogs": [
              "705230306"
            ]
          },
          "705230306": {
            "id": "705230306",
            "speakerId": 1000,
            "speakerName": "关垂",
            "text": "放心吧，我以前在外边当过一段时间厨师。这种做法能在成本和口味之间取得最好的平衡，我已经调配过很多次了！",
            "nextDialogs": [
              "705230307"
            ]
          },
          "705230307": {
            "id": "705230307",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "有点想试试看…",
            "nextDialogs": [
              "705230308"
            ]
          },
          "705230308": {
            "id": "705230308",
            "speakerId": 1000,
            "speakerName": "关垂",
            "text": "下次你们来轻策庄玩的时候，我就用成品来招待你们。",
            "nextDialogs": [
              "705230309"
            ]
          },
          "705230309": {
            "id": "705230309",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "#好哦！到时候就让{NICKNAME}先尝尝！",
            "nextDialogs": [
              "705230310"
            ]
          },
          "705230310": {
            "id": "705230310",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "加油啊，调配饮品的厨师！",
            "nextDialogs": [
              "705230311"
            ]
          },
          "705230311": {
            "id": "705230311",
            "speakerId": 1000,
            "speakerName": "关垂",
            "text": "谢谢你们！有空常来啊！"
          }
        }
      }
    },
    {
      "subId": "7052304",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "705230401"
        ],
        "dialogs": {
          "705230401": {
            "id": "705230401",
            "speakerId": 1000,
            "speakerName": "关垂",
            "text": "这次佳酿节的特色饮品，想来就和轻策庄的山泉茶水很般配！",
            "nextDialogs": [
              "705230402"
            ]
          },
          "705230402": {
            "id": "705230402",
            "speakerId": 1000,
            "speakerName": "关垂",
            "text": "有劳你们两位了！",
            "nextDialogs": [
              "705230404",
              "705230408",
              "705230416"
            ]
          },
          "705230404": {
            "id": "705230404",
            "speakerId": 1000,
            "speakerName": "关垂",
            "text": "我和几个兄弟搬回庄里还没多久。平时我负责给下地干活的兄弟们做点饭菜，送到田里去。",
            "nextDialogs": [
              "705230405"
            ]
          },
          "705230405": {
            "id": "705230405",
            "speakerId": 1000,
            "speakerName": "关垂",
            "text": "不过我做的大多是些简单管饱的菜式，拿出来招待外地的客人还是有点寒碜了…",
            "nextDialogs": [
              "705230406"
            ]
          },
          "705230406": {
            "id": "705230406",
            "speakerId": 1000,
            "speakerName": "关垂",
            "text": "轻策庄虽不热闹，但美食可一点都不少，你在庄里逛逛就能见识到了！"
          },
          "705230408": {
            "id": "705230408",
            "speakerId": 1000,
            "speakerName": "关垂",
            "text": "下地干活的兄弟们口渴得厉害，经常半天就喝掉一大缸茶。",
            "nextDialogs": [
              "705230409"
            ]
          },
          "705230409": {
            "id": "705230409",
            "speakerId": 1000,
            "speakerName": "关垂",
            "text": "田地和庄里的茶水摊隔着一段距离，来来回回不太方便。",
            "nextDialogs": [
              "705230410"
            ]
          },
          "705230410": {
            "id": "705230410",
            "speakerId": 1000,
            "speakerName": "关垂",
            "text": "凯叔一把年纪了，可不能麻烦他给兄弟们送茶，这个活儿就由我包揽了。",
            "nextDialogs": [
              "705230411"
            ]
          },
          "705230411": {
            "id": "705230411",
            "speakerId": 1000,
            "speakerName": "关垂",
            "text": "我和几个兄弟在外地闯荡过一段时间，大缸的茶水对我们来说有点清淡，有时兄弟们想喝些味道重的东西。",
            "nextDialogs": [
              "705230412"
            ]
          },
          "705230412": {
            "id": "705230412",
            "speakerId": 1000,
            "speakerName": "关垂",
            "text": "所以我会往茶水里加些饮品，调出新鲜的风味，让兄弟们乐呵乐呵。",
            "nextDialogs": [
              "705230413"
            ]
          },
          "705230413": {
            "id": "705230413",
            "speakerId": 1000,
            "speakerName": "关垂",
            "text": "当然，我做的茶水只提供给几个兄弟，可不能抢凯叔的生意啊！",
            "nextDialogs": [
              "705230414"
            ]
          },
          "705230414": {
            "id": "705230414",
            "speakerId": 1000,
            "speakerName": "关垂",
            "text": "闲下来以后，我们也会去凯叔的茶水摊品茶，帮他干些杂活。"
          },
          "705230416": {
            "id": "705230416",
            "speakerId": 1000,
            "speakerName": "关垂",
            "text": "好啊！等着你们的好消息！"
          }
        }
      }
    },
    {
      "subId": "7052321",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "705232101"
        ],
        "dialogs": {
          "705232101": {
            "id": "705232101",
            "speakerId": 1002,
            "speakerName": "格奥尔格",
            "text": "不行不行，太少了！就算订货的总量变多了，每箱的单价也不至于降到这种水平！"
          }
        }
      }
    },
    {
      "subId": "7052322",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "705232201"
        ],
        "dialogs": {
          "705232201": {
            "id": "705232201",
            "speakerId": 1002,
            "speakerName": "格奥尔格",
            "text": "嗯，这个出价还算不错，但考虑到去轻策庄的运输难度，还是够呛啊。"
          }
        }
      }
    },
    {
      "subId": "7052323",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "705232301"
        ],
        "dialogs": {
          "705232301": {
            "id": "705232301",
            "speakerId": 1002,
            "speakerName": "格奥尔格",
            "text": "成交！你们俩的悟性很好嘛，第二回和我讲价，就找到了一个让大家都满意的价钱！"
          }
        }
      }
    },
    {
      "subId": "7052324",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "705232401"
        ],
        "dialogs": {
          "705232401": {
            "id": "705232401",
            "speakerId": 1002,
            "speakerName": "格奥尔格",
            "text": "不错啊，刚好卡在我能接受的最低价上，算你们机灵！"
          }
        }
      }
    },
    {
      "subId": "7052325",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "705232501"
        ],
        "dialogs": {
          "705232501": {
            "id": "705232501",
            "speakerId": 1002,
            "speakerName": "格奥尔格",
            "text": "啊哈，看来我被小瞧了啊！这次就用我说的价钱成交吧，就当是你们交了一笔砍价技巧的学费。"
          }
        }
      }
    }
  ]
}
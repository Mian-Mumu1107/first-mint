  "subQuests": [
    {
      "subId": "7524301",
      "subQuestName": "(test)隐藏$HIDDEN",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "752430101"
        ],
        "dialogs": {
          "752430101": {
            "id": "752430101",
            "speakerId": 6588,
            "speakerName": "阿罗哈",
            "text": "哎呀！客人，多亏您赶走了那些不讲理的愚人众啊！",
            "nextDialogs": [
              "752430102"
            ]
          },
          "752430102": {
            "id": "752430102",
            "speakerId": 6588,
            "speakerName": "阿罗哈",
            "text": "那帮家伙不知道从哪来的，一句话不说，手就直接往我口袋里伸！简直是强盗！",
            "nextDialogs": [
              "752430103"
            ]
          },
          "752430103": {
            "id": "752430103",
            "speakerId": 6588,
            "speakerName": "阿罗哈",
            "text": "还好有您阻止了他们！不然今天一定会损失惨重了…请一定要收下我的感谢。",
            "nextDialogs": [
              "752430104"
            ]
          },
          "752430104": {
            "id": "752430104",
            "speakerId": 6588,
            "speakerName": "阿罗哈",
            "text": "对了，差点忘了跟您介绍，这里是阳光五彩绵驮园，专门给客人们展出温顺的绵驮兽，当然，还有很多相关玩具售卖。",
            "nextDialogs": [
              "752430105"
            ]
          },
          "752430105": {
            "id": "752430105",
            "speakerId": 6588,
            "speakerName": "阿罗哈",
            "text": "不过刚才那些人把我的员工和客人们都吓跑了，我要赶紧去处理一下。",
            "nextDialogs": [
              "752430106"
            ]
          },
          "752430106": {
            "id": "752430106",
            "speakerId": 6588,
            "speakerName": "阿罗哈",
            "text": "要是您也想来参观绵驮园，请明天再来看看吧。"
          }
        }
      }
    },

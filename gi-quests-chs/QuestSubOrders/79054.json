    },
    {
      "subId": "7905404",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "790540401"
        ],
        "dialogs": {
          "790540401": {
            "id": "790540401",
            "speakerId": 1000,
            "speakerName": "杰洛尼",
            "text": "画片啊…现在居然有这么神奇的东西，这样应该也能轻松记录沿途的风景吧。",
            "nextDialogs": [
              "790540402"
            ]
          },
          "790540402": {
            "id": "790540402",
            "speakerId": 1000,
            "speakerName": "杰洛尼",
            "text": "#怎么了，{NICKNAME}，拍下画片了吗？我可是很期待你在那里拍出的星空呢。"
          }
        }
      }
    }

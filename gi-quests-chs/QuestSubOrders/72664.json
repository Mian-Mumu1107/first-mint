  },
  "subQuests": [
    {
      "subId": "7266401",
      "subQuestName": "与琳阳对话",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "726640101"
        ],
        "dialogs": {
          "726640101": {
            "id": "726640101",
            "speakerId": 30066,
            "speakerName": "琳阳",
            "text": "唔…还得再去布置一批宝箱才行…",
            "nextDialogs": [
              "726640102"
            ]
          },
          "726640102": {
            "id": "726640102",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "什么宝箱？",
            "nextDialogs": [
              "726640103"
            ]
          },
          "726640103": {
            "id": "726640103",
            "speakerId": 30066,
            "speakerName": "琳阳",
            "text": "欸？！你是…旅行者吗？你也是来参加「逐月节」的？",
            "nextDialogs": [
              "726640104"
            ]
          },
          "726640104": {
            "id": "726640104",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "算是吧。",
            "nextDialogs": [
              "726640105"
            ]
          },
          "726640105": {
            "id": "726640105",
            "speakerId": 30066,
            "speakerName": "琳阳",
            "text": "那你来得刚好。为了庆祝逐月节，我们冒险家协会正在举办活动呢。",
            "nextDialogs": [
              "726640106"
            ]
          },
          "726640106": {
            "id": "726640106",
            "speakerId": 30066,
            "speakerName": "琳阳",
            "text": "怎么样，你想要了解一下吗？",
            "nextDialogs": [
              "726640110",
              "726640109"
            ]
          },
          "726640110": {
            "id": "726640110",
            "speakerId": 30066,
            "speakerName": "琳阳",
            "text": "逐月节期间，我们冒险家协会在各地布置了一种叫做「逐月符」的东西。",
            "nextDialogs": [
              "726640111"
            ]
          },
          "726640111": {
            "id": "726640111",
            "speakerId": 30066,
            "speakerName": "琳阳",
            "text": "找到这些逐月符的人，可以将它们带回协会，兑换各种奖励。",
            "nextDialogs": [
              "726640112"
            ]
          },
          "726640112": {
            "id": "726640112",
            "speakerId": 30066,
            "speakerName": "琳阳",
            "text": "另外，协会还派遣了一批冒险家，在野外布置了一大批特别宝箱。",
            "nextDialogs": [
              "726640113"
            ]
          },
          "726640113": {
            "id": "726640113",
            "speakerId": 30066,
            "speakerName": "琳阳",
            "text": "这些特别宝箱里面，都装着协会专门准备好的各种宝物哦。",
            "nextDialogs": [
              "726640114"
            ]
          },
          "726640114": {
            "id": "726640114",
            "speakerId": 30066,
            "speakerName": "琳阳",
            "text": "除了这两项活动之外，协会还为那些想要挑战自我的精英冒险家们，设置了一连串的高难度挑战！",
            "nextDialogs": [
              "726640115"
            ]
          },
          "726640115": {
            "id": "726640115",
            "speakerId": 30066,
            "speakerName": "琳阳",
            "text": "具体来说…就是一连串的魔物营地啦…"
          },
          "726640109": {
            "id": "726640109",
            "speakerId": 30066,
            "speakerName": "琳阳",
            "text": "不会啦！这次的活动可都是很有冒险感的！"
          }
        }
      }
    }
  ]
}
  "subQuests": [
    {
      "subId": "4022701",
      "subQuestName": "前往叮铃哐啷蛋卷工坊",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "402270101"
        ],
        "dialogs": {
          "402270101": {
            "id": "402270101",
            "speakerId": 1000,
            "speakerName": "爱诺",
            "text": "嗯…",
            "nextDialogs": [
              "402270102"
            ]
          },
          "402270102": {
            "id": "402270102",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "你们好啊，爱诺，伊涅芙。",
            "nextDialogs": [
              "402270103"
            ]
          },
          "402270103": {
            "id": "402270103",
            "speakerId": 1002,
            "speakerName": "伊涅芙",
            "text": "#你们好，{NICKNAME}，派蒙。",
            "nextDialogs": [
              "402270104"
            ]
          },
          "402270104": {
            "id": "402270104",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "我们接了奈芙尔的委托，负责与参展方接洽，叮铃哐啷蛋卷工坊也参加了这次展会吧？",
            "nextDialogs": [
              "402270105"
            ]
          },
          "402270105": {
            "id": "402270105",
            "speakerId": 1002,
            "speakerName": "伊涅芙",
            "text": "是的，爱诺正在对「噼里啪啦守卫团」进行最后一次调试。",
            "nextDialogs": [
              "402270106"
            ]
          },
          "402270106": {
            "id": "402270106",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "噼里啪啦…哦，这就是工坊准备的参展货物吧？",
            "nextDialogs": [
              "402270107"
            ]
          },
          "402270107": {
            "id": "402270107",
            "speakerId": 1002,
            "speakerName": "伊涅芙",
            "text": "总有鼹鼠之类的动物来工坊偷东西，爱诺就仿照它们的形象制作了一套防卫机关，用来保护工坊的资产。",
            "nextDialogs": [
              "402270108"
            ]
          },
          "402270108": {
            "id": "402270108",
            "speakerId": 1002,
            "speakerName": "伊涅芙",
            "text": "爱诺之前进行过一次测试，测试结果为「非常有效」，于是爱诺将它们全面升级，准备用来参展。",
            "nextDialogs": [
              "402270109"
            ]
          },
          "402270109": {
            "id": "402270109",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "爱诺准备交易自己的作品？",
            "nextDialogs": [
              "402270110"
            ]
          },
          "402270110": {
            "id": "402270110",
            "speakerId": 1002,
            "speakerName": "伊涅芙",
            "text": "除了直接来自工坊外的订单，爱诺极少直接出售自己的作品，她准备在展会上交易的是设计图纸。",
            "nextDialogs": [
              "402270111"
            ]
          },
          "402270111": {
            "id": "402270111",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "原来是这样…对了，你们准备好去展会那边了吗？",
            "nextDialogs": [
              "402270112"
            ]
          },
          "402270112": {
            "id": "402270112",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "#雅珂达专门拜托我和{NICKNAME}来催你们，她给你们预留了一个很好的展位，一直空着的话会出问题。",
            "nextDialogs": [
              "402270113"
            ]
          },
          "402270113": {
            "id": "402270113",
            "speakerId": 1000,
            "speakerName": "爱诺",
            "text": "不是已经跟她说过了吗？必须全部调试好才能搬过去！再着急也没有用。",
            "nextDialogs": [
              "402270114"
            ]
          },
          "402270114": {
            "id": "402270114",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "哇，难得见到爱诺这么认真。",
            "nextDialogs": [
              "402270115"
            ]
          },
          "402270115": {
            "id": "402270115",
            "speakerId": 1002,
            "speakerName": "伊涅芙",
            "text": "最近工坊确实遭遇了重大的资金短缺问题，爱诺希望能通过这次展会改善经济状况，这种谨慎是合乎逻辑的。",
            "nextDialogs": [
              "402270116"
            ]
          },
          "402270116": {
            "id": "402270116",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "资金短缺？难道爱诺在搞什么耗资巨大的研究？",
            "nextDialogs": [
              "402270117"
            ]
          },
          "402270117": {
            "id": "402270117",
            "speakerId": 1002,
            "speakerName": "伊涅芙",
            "text": "短缺的并不是「研究资金」，是「甜品资金」。在过往的记录中，共有47次因超额采购甜品而导致研究资金出现缺口的情况。",
            "nextDialogs": [
              "402270118"
            ]
          },
          "402270118": {
            "id": "402270118",
            "speakerId": 1002,
            "speakerName": "伊涅芙",
            "text": "后来，从工坊运营的角度考虑，我将「研究资金」与「甜品资金」进行了区分，并禁止爱诺随意挪用。",
            "nextDialogs": [
              "402270119"
            ]
          },
          "402270119": {
            "id": "402270119",
            "speakerId": 1002,
            "speakerName": "伊涅芙",
            "text": "而就在不久前，爱诺把整整一个月份额的「甜品资金」都用完了。",
            "nextDialogs": [
              "402270122"
            ]
          },
          "402270122": {
            "id": "402270122",
            "speakerId": 1000,
            "speakerName": "爱诺",
            "text": "完工！噼里啪啦守卫团，好好表现！",
            "nextDialogs": [
              "402270123"
            ]
          },
          "402270123": {
            "id": "402270123",
            "speakerId": 1002,
            "speakerName": "伊涅芙",
            "text": "请带我们去会场吧。"
          }
        }
      }
    },
    {
      "subId": "4022702",
      "subQuestName": "带领爱诺和伊涅芙前往会场",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "402270201"
        ],
        "dialogs": {
          "402270201": {
            "id": "402270201",
            "speakerId": 1003,
            "speakerName": "Black Screen",
            "text": "爱诺和伊涅芙在你们的带领下来到展会现场。",
            "nextDialogs": [
              "402270202"
            ]
          },
          "402270202": {
            "id": "402270202",
            "speakerId": 1000,
            "speakerName": "爱诺",
            "text": "唔…演示平台就放在这里吧。",
            "nextDialogs": [
              "402270203"
            ]
          },
          "402270203": {
            "id": "402270203",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "爱诺新设计的防卫机关…说实话，我挺好奇的。",
            "nextDialogs": [
              "402270204"
            ]
          },
          "402270204": {
            "id": "402270204",
            "speakerId": 1000,
            "speakerName": "爱诺",
            "text": "#{NICKNAME}和派蒙随时都可以过来玩，我的作品绝不会让你们失望的。",
            "nextDialogs": [
              "402270205"
            ]
          },
          "402270205": {
            "id": "402270205",
            "speakerId": 1002,
            "speakerName": "伊涅芙",
            "text": "辛苦你们了。",
            "nextDialogs": [
              "402270206"
            ]
          },
          "402270206": {
            "id": "402270206",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "不客气！对了，工坊这边的参展人员就登记爱诺和伊涅芙喽？",
            "nextDialogs": [
              "402270207"
            ]
          },
          "402270207": {
            "id": "402270207",
            "speakerId": 1002,
            "speakerName": "伊涅芙",
            "text": "嗯…爱诺并不能被界定为参展人员，她不喜欢太热闹的氛围，等展会正式开始后就会返回工坊，我会在这里帮她盯着展位。",
            "nextDialogs": [
              "402270208"
            ]
          },
          "402270208": {
            "id": "402270208",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "想来也是呢…"
          }
        }
      }
    }
  ]
}
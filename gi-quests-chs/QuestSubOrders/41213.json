    {
      "subId": "4121311",
      "subQuestName": "阿贝多开车$HIDDEN",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [],
        "dialogs": {}
      }
    },
    {
      "subId": "4121310",
      "subQuestName": "与阿贝多对话",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "412130501"
        ],
        "dialogs": {
          "412130501": {
            "id": "412130501",
            "speakerId": 1006,
            "speakerName": "阿贝多",
            "text": "听到声音过来一看，居然是你们几个。",
            "nextDialogs": [
              "412130502"
            ]
          },
          "412130502": {
            "id": "412130502",
            "speakerId": 1006,
            "speakerName": "阿贝多",
            "text": "怎么回事，你们跟人打架了？",
            "nextDialogs": [
              "412130503"
            ]
          },
          "412130503": {
            "id": "412130503",
            "speakerId": 1001,
            "speakerName": "砂糖",
            "text": "阿、阿贝多先生…我不是故意的…",
            "nextDialogs": [
              "412130504"
            ]
          },
          "412130504": {
            "id": "412130504",
            "speakerId": 1006,
            "speakerName": "阿贝多",
            "text": "砂糖，你不是在整理资料吗？怎么突然跑到这种地方来了。",
            "nextDialogs": [
              "412130505"
            ]
          },
          "412130505": {
            "id": "412130505",
            "speakerId": 1006,
            "speakerName": "阿贝多",
            "text": "而且还在冰天雪地里和这么危险的对手作战…",
            "nextDialogs": [
              "412130506"
            ]
          },
          "412130506": {
            "id": "412130506",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "我、我也作战了，对不起…",
            "nextDialogs": [
              "412130507"
            ]
          },
          "412130507": {
            "id": "412130507",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "为什么连我也跟着心虚起来了呀…",
            "nextDialogs": [
              "412130508"
            ]
          },
          "412130508": {
            "id": "412130508",
            "speakerId": 1001,
            "speakerName": "砂糖",
            "text": "呜啊啊我、我只是…对不起对不起，我就是路过…",
            "nextDialogs": [
              "412130509"
            ]
          },
          "412130509": {
            "id": "412130509",
            "speakerId": 1006,
            "speakerName": "阿贝多",
            "text": "唉，我猜，一定又有什么让你感兴趣的东西出现了。",
            "nextDialogs": [
              "412130510"
            ]
          },
          "412130510": {
            "id": "412130510",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "我把剑的事告诉砂糖了，抱歉。",
            "nextDialogs": [
              "412130511"
            ]
          },
          "412130511": {
            "id": "412130511",
            "speakerId": 1006,
            "speakerName": "阿贝多",
            "text": "你都告诉她了？",
            "nextDialogs": [
              "412130512"
            ]
          },
          "412130512": {
            "id": "412130512",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "只是说了剑的属性和来历，没有让她触摸本体！这点意识我们还是有的嘛~",
            "nextDialogs": [
              "412130513"
            ]
          },
          "412130513": {
            "id": "412130513",
            "speakerId": 1006,
            "speakerName": "阿贝多",
            "text": "算了，本来也不可能瞒她多久。",
            "nextDialogs": [
              "412130514"
            ]
          },
          "412130514": {
            "id": "412130514",
            "speakerId": 1006,
            "speakerName": "阿贝多",
            "text": "砂糖对知识和秘密很有探究精神，确实适合做炼金术研究。",
            "nextDialogs": [
              "412130515"
            ]
          },
          "412130515": {
            "id": "412130515",
            "speakerId": 1001,
            "speakerName": "砂糖",
            "text": "啊呜呜…我再也不敢乱惹麻烦了！用我新研究的四倍大种子甜甜花发誓！",
            "nextDialogs": [
              "412130516"
            ]
          },
          "412130516": {
            "id": "412130516",
            "speakerId": 1006,
            "speakerName": "阿贝多",
            "text": "我不怕麻烦，只是担心你们的安全。下次千万注意。",
            "nextDialogs": [
              "412130517"
            ]
          },
          "412130517": {
            "id": "412130517",
            "speakerId": 1006,
            "speakerName": "阿贝多",
            "text": "对了，那个蹲在那里的冒险家是怎么回事？",
            "nextDialogs": [
              "412130518"
            ]
          },
          "412130518": {
            "id": "412130518",
            "speakerId": 1001,
            "speakerName": "砂糖",
            "text": "刚才战斗中我负责保护帕拉德先生，我想，他应该没有受伤。",
            "nextDialogs": [
              "412130519"
            ]
          },
          "412130519": {
            "id": "412130519",
            "speakerId": 1002,
            "speakerName": "冒失的帕拉德",
            "text": "冷…冷死我了…",
            "nextDialogs": [
              "412130520"
            ]
          },
          "412130520": {
            "id": "412130520",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "好像是在刚才的战斗中着凉了。",
            "nextDialogs": [
              "412130521"
            ]
          },
          "412130521": {
            "id": "412130521",
            "speakerId": 1001,
            "speakerName": "砂糖",
            "text": "啊啊，这倒是没想到…是我疏忽了，非常抱歉！",
            "nextDialogs": [
              "412130522"
            ]
          },
          "412130522": {
            "id": "412130522",
            "speakerId": 1001,
            "speakerName": "砂糖",
            "text": "阿贝多先生，我去看看他的情况！",
            "nextDialogs": [
              "412130523"
            ]
          },
          "412130523": {
            "id": "412130523",
            "speakerId": 1006,
            "speakerName": "阿贝多",
            "text": "嗯。",
            "nextDialogs": [
              "412130524"
            ]
          },
          "412130524": {
            "id": "412130524",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "砂糖看起来有些死板，居然是个很有爱心的好孩子呢。",
            "nextDialogs": [
              "412130525"
            ]
          },
          "412130525": {
            "id": "412130525",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "不要叫比你大的人孩子哦。",
            "nextDialogs": [
              "412130526"
            ]
          },
          "412130526": {
            "id": "412130526",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "说得也是呢。",
            "nextDialogs": [
              "412130527"
            ]
          },
          "412130527": {
            "id": "412130527",
            "speakerId": 1006,
            "speakerName": "阿贝多",
            "text": "砂糖这家伙，一不小心就会跑到奇怪的地方去…",
            "nextDialogs": [
              "412130528"
            ]
          },
          "412130528": {
            "id": "412130528",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "年轻人都这样。",
            "nextDialogs": [
              "412130529"
            ]
          },
          "412130529": {
            "id": "412130529",
            "speakerId": 1006,
            "speakerName": "阿贝多",
            "text": "也是。",
            "nextDialogs": [
              "412130530"
            ]
          },
          "412130530": {
            "id": "412130530",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "砂糖不是故意的，请不要生气。",
            "nextDialogs": [
              "412130531"
            ]
          },
          "412130531": {
            "id": "412130531",
            "speakerId": 1006,
            "speakerName": "阿贝多",
            "text": "放心吧，我没生气。",
            "nextDialogs": [
              "412130532"
            ]
          },
          "412130532": {
            "id": "412130532",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "哎？剑上面好像有什么东西在闪烁呢。",
            "nextDialogs": [
              "412130533"
            ]
          },
          "412130533": {
            "id": "412130533",
            "speakerId": 1006,
            "speakerName": "阿贝多",
            "text": "嗯？又有变化…",
            "nextDialogs": [
              "412130534"
            ]
          },
          "412130534": {
            "id": "412130534",
            "speakerId": 1006,
            "speakerName": "阿贝多",
            "text": "剑上的力量比之前强大了不少。怎么回事？",
            "nextDialogs": [
              "412130535"
            ]
          },
          "412130535": {
            "id": "412130535",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "我们和愚人众发生了战斗。",
            "nextDialogs": [
              "412130536"
            ]
          },
          "412130536": {
            "id": "412130536",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "这一带的愚人众士兵里有些我们没见过的狠角色哦。",
            "nextDialogs": [
              "412130537"
            ]
          },
          "412130537": {
            "id": "412130537",
            "speakerId": 1006,
            "speakerName": "阿贝多",
            "text": "是之前没有遇到过的力量吗…",
            "nextDialogs": [
              "412130538"
            ]
          },
          "412130538": {
            "id": "412130538",
            "speakerId": 1006,
            "speakerName": "阿贝多",
            "text": "所以，剑也大幅成长了。"
          }
        }
      }
    },

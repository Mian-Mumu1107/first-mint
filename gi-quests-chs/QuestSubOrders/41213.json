  "subQuests": [
    {
      "subId": "4121301",
      "subQuestName": "寻找阿贝多",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "412130101"
        ],
        "dialogs": {
          "412130101": {
            "id": "412130101",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "阿贝多！我们又——来啦！",
            "nextDialogs": [
              "412130102"
            ]
          },
          "412130102": {
            "id": "412130102",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "嗯？阿贝多好像不在？",
            "nextDialogs": [
              "412130103"
            ]
          },
          "412130103": {
            "id": "412130103",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "是出去调查了吗，还是又去画神秘写生了呢…",
            "nextDialogs": [
              "412130104"
            ]
          },
          "412130104": {
            "id": "412130104",
            "speakerId": 1001,
            "speakerName": "砂糖",
            "text": "啊！是你们！",
            "nextDialogs": [
              "412130105"
            ]
          },
          "412130105": {
            "id": "412130105",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "这不是砂糖吗，你怎么在这里？",
            "nextDialogs": [
              "412130106"
            ]
          },
          "412130106": {
            "id": "412130106",
            "speakerId": 1001,
            "speakerName": "砂糖",
            "text": "我的研究刚告一段落，今天有五小时二十六分左右的空闲时间。",
            "nextDialogs": [
              "412130107"
            ]
          },
          "412130107": {
            "id": "412130107",
            "speakerId": 1001,
            "speakerName": "砂糖",
            "text": "所以，就来找你们打听之前委托的事了！",
            "nextDialogs": [
              "412130108"
            ]
          },
          "412130108": {
            "id": "412130108",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "好精确的时间，你是人型钟表吗？",
            "nextDialogs": [
              "412130109"
            ]
          },
          "412130109": {
            "id": "412130109",
            "speakerId": 1001,
            "speakerName": "砂糖",
            "text": "不不不，这没什么值得夸奖的，你太客气了…",
            "nextDialogs": [
              "412130110"
            ]
          },
          "412130110": {
            "id": "412130110",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "人家没有在夸你啦！",
            "nextDialogs": [
              "412130111"
            ]
          },
          "412130111": {
            "id": "412130111",
            "speakerId": 1001,
            "speakerName": "砂糖",
            "text": "旅行者，我、我可以问吗？之前拜托你去调查阿贝多先生隐瞒的事，进展得还顺利吗？",
            "nextDialogs": [
              "412130112"
            ]
          },
          "412130112": {
            "id": "412130112",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "如果我的感官没有出问题，那已经是一个多星期前的事了哦。",
            "nextDialogs": [
              "412130113"
            ]
          },
          "412130113": {
            "id": "412130113",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "还以为你已经忘了。",
            "nextDialogs": [
              "412130114"
            ]
          },
          "412130114": {
            "id": "412130114",
            "speakerId": 1001,
            "speakerName": "砂糖",
            "text": "什么…！！",
            "nextDialogs": [
              "412130115"
            ]
          },
          "412130115": {
            "id": "412130115",
            "speakerId": 1001,
            "speakerName": "砂糖",
            "text": "一、一个多星期？！我明明…啊！",
            "nextDialogs": [
              "412130116"
            ]
          },
          "412130116": {
            "id": "412130116",
            "speakerId": 1001,
            "speakerName": "砂糖",
            "text": "呜，我太沉迷实验，完全忽略了这件事…",
            "nextDialogs": [
              "412130117"
            ]
          },
          "412130117": {
            "id": "412130117",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "该说她的时间观念太强呢，还是太弱呢…",
            "nextDialogs": [
              "412130118"
            ]
          },
          "412130118": {
            "id": "412130118",
            "speakerId": 1001,
            "speakerName": "砂糖",
            "text": "所、所以！你已经知道答案了对吗？",
            "nextDialogs": [
              "412130121"
            ]
          },
          "412130121": {
            "id": "412130121",
            "speakerId": 1001,
            "speakerName": "砂糖",
            "text": "太好了，能说给我听吗？",
            "nextDialogs": [
              "412130122"
            ]
          },
          "412130122": {
            "id": "412130122",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "派蒙，你觉得呢？",
            "nextDialogs": [
              "412130123"
            ]
          },
          "412130123": {
            "id": "412130123",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "唔…告诉她应该不要紧吧？",
            "nextDialogs": [
              "412130124"
            ]
          },
          "412130124": {
            "id": "412130124",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "看看也行，只要不是触摸…",
            "nextDialogs": [
              "412130125"
            ]
          },
          "412130125": {
            "id": "412130125",
            "speakerId": 1001,
            "speakerName": "砂糖",
            "text": "等一下，你们在说什么呀？",
            "nextDialogs": [
              "412130126"
            ]
          },
          "412130126": {
            "id": "412130126",
            "speakerId": 1001,
            "speakerName": "砂糖",
            "text": "这是…？"
          }
        }
      }
    },

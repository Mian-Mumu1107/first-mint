    {
      "subId": "4121303",
      "subQuestName": "前往怪物栖息地试剑",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "412130301"
        ],
        "dialogs": {
          "412130301": {
            "id": "412130301",
            "speakerId": 1002,
            "speakerName": "冒失的帕拉德",
            "text": "呜呜…呜啊啊嗷嗷呜…",
            "nextDialogs": [
              "412130302"
            ]
          },
          "412130302": {
            "id": "412130302",
            "speakerId": 1001,
            "speakerName": "砂糖",
            "text": "帕拉德先生？！",
            "nextDialogs": [
              "412130303"
            ]
          },
          "412130303": {
            "id": "412130303",
            "speakerId": 1001,
            "speakerName": "砂糖",
            "text": "你、你还没回去吗？",
            "nextDialogs": [
              "412130304"
            ]
          },
          "412130304": {
            "id": "412130304",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "这不是蒙德那个冒失鬼冒险家吗？他也跟着塞琉斯来雪山探险啊？",
            "nextDialogs": [
              "412130305"
            ]
          },
          "412130305": {
            "id": "412130305",
            "speakerId": 1002,
            "speakerName": "冒失的帕拉德",
            "text": "冷冷冷死我了，阿嚏！",
            "nextDialogs": [
              "412130306"
            ]
          },
          "412130306": {
            "id": "412130306",
            "speakerId": 1001,
            "speakerName": "砂糖",
            "text": "我把你从雪坑里救出来以后，你就一直在这里吗？！",
            "nextDialogs": [
              "412130307"
            ]
          },
          "412130307": {
            "id": "412130307",
            "speakerId": 1002,
            "speakerName": "冒失的帕拉德",
            "text": "我也不想的，可是、可是我迷路了！抱歉…",
            "nextDialogs": [
              "412130308"
            ]
          },
          "412130308": {
            "id": "412130308",
            "speakerId": 1002,
            "speakerName": "冒失的帕拉德",
            "text": "呜噗噗噗…冷死了，一步也走不动啦…",
            "nextDialogs": [
              "412130309"
            ]
          },
          "412130309": {
            "id": "412130309",
            "speakerId": 1001,
            "speakerName": "砂糖",
            "text": "唉，帕拉德先生，你对雪山之旅太掉以轻心啦。",
            "nextDialogs": [
              "412130310"
            ]
          },
          "412130310": {
            "id": "412130310",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "我们带他一起回去吧。",
            "nextDialogs": [
              "412130311"
            ]
          },
          "412130311": {
            "id": "412130311",
            "speakerId": 1001,
            "speakerName": "砂糖",
            "text": "可以吗？他现在这样，恐怕要我们扶着才能走路了…",
            "nextDialogs": [
              "412130312"
            ]
          },
          "412130312": {
            "id": "412130312",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "就算不可以，也不能把他丢在这里吧？",
            "nextDialogs": [
              "412130313"
            ]
          },
          "412130313": {
            "id": "412130313",
            "speakerId": 1001,
            "speakerName": "砂糖",
            "text": "说得也是…抱歉呀旅行者，我、我替他向你道歉。",
            "nextDialogs": [
              "412130314"
            ]
          },
          "412130314": {
            "id": "412130314",
            "speakerId": 1003,
            "speakerName": "？？？",
            "text": "还有心思考虑别人？先担心你自己吧！",
            "nextDialogs": [
              "412130315"
            ]
          },
          "412130315": {
            "id": "412130315",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "啊！又是愚人众！",
            "nextDialogs": [
              "412130316"
            ]
          },
          "412130316": {
            "id": "412130316",
            "speakerId": 1004,
            "speakerName": "瓦京",
            "text": "我们的来意，你们想必已经知道了。",
            "nextDialogs": [
              "412130317"
            ]
          },
          "412130317": {
            "id": "412130317",
            "speakerId": 1004,
            "speakerName": "瓦京",
            "text": "交出那把剑，否则谁也别想离开这里！",
            "nextDialogs": [
              "412130318"
            ]
          },
          "412130318": {
            "id": "412130318",
            "speakerId": 1001,
            "speakerName": "砂糖",
            "text": "不行，请不要把剑交给他们！",
            "nextDialogs": [
              "412130321"
            ]
          },
          "412130321": {
            "id": "412130321",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "好有气势！一鼓作气把他们打翻！",
            "nextDialogs": [
              "412130322"
            ]
          },
          "412130322": {
            "id": "412130322",
            "speakerId": 1001,
            "speakerName": "砂糖",
            "text": "帕拉德先生，我带你到安全的地方去！快来！",
            "nextDialogs": [
              "412130323"
            ]
          },
          "412130323": {
            "id": "412130323",
            "speakerId": 1004,
            "speakerName": "瓦京",
            "text": "天真，所有知情人一个都别想跑！",
            "nextDialogs": [
              "412130324"
            ]
          },
          "412130324": {
            "id": "412130324",
            "speakerId": 1004,
            "speakerName": "瓦京",
            "text": "这把剑将被作为礼物，献给尊贵的执行官「女士」大人！"
          }
        }
      }
    },
    {
      "subId": "4121304",
      "subQuestName": "击败周边的怪物",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "412130401"
        ],
        "dialogs": {
          "412130401": {
            "id": "412130401",
            "speakerId": 1005,
            "speakerName": "雷萤术士",
            "text": "（test）看来就是你们了",
            "nextDialogs": [
              "412130402"
            ]
          },
          "412130402": {
            "id": "412130402",
            "speakerId": 1005,
            "speakerName": "雷萤术士",
            "text": "（test）快把那把剑交出来吧",
            "nextDialogs": [
              "412130403"
            ]
          },
          "412130403": {
            "id": "412130403",
            "speakerId": 1005,
            "speakerName": "雷萤术士",
            "text": "（test）不然，我可无法保证你们能安然无恙地离开雪山",
            "nextDialogs": [
              "412130404"
            ]
          },
          "412130404": {
            "id": "412130404",
            "speakerId": 1002,
            "speakerName": "冒失的帕拉德",
            "text": "（test）呜哇！是什么东西啊，快给他们吧",
            "nextDialogs": [
              "412130405"
            ]
          },
          "412130405": {
            "id": "412130405",
            "speakerId": 1002,
            "speakerName": "冒失的帕拉德",
            "text": "（test）我怎么这么倒霉啊，冻得快死了，还被半路打劫",
            "nextDialogs": [
              "412130406"
            ]
          },
          "412130406": {
            "id": "412130406",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "（test）别在这说风凉话了",
            "nextDialogs": [
              "412130408",
              "412130410"
            ]
          },
          "412130408": {
            "id": "412130408",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "（test）对！你想得美",
            "nextDialogs": [
              "412130412"
            ]
          },
          "412130412": {
            "id": "412130412",
            "speakerId": 1005,
            "speakerName": "雷萤术士",
            "text": "（test）你们可真是敬酒不吃吃罚酒",
            "nextDialogs": [
              "412130413"
            ]
          },
          "412130413": {
            "id": "412130413",
            "speakerId": 1001,
            "speakerName": "砂糖",
            "text": "（test）旅行者，帕拉德由我来保护，你就安心地去打败他吧"
          },
          "412130410": {
            "id": "412130410",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "（test）喂！你在想什么！",
            "nextDialogs": [
              "412130411"
            ]
          },
          "412130411": {
            "id": "412130411",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "（test）我们是绝对不会交给你的！"
          }
        }
      }
    },
    {
      "subId": "4121305",
      "subQuestName": "与砂糖对话",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "412130201"
        ],
        "dialogs": {
          "412130201": {
            "id": "412130201",
            "speakerId": 1001,
            "speakerName": "砂糖",
            "text": "太厉害了，这样的武器我还是第一次看到…",
            "nextDialogs": [
              "412130202"
            ]
          },
          "412130202": {
            "id": "412130202",
            "speakerId": 1001,
            "speakerName": "砂糖",
            "text": "你也好厉害，无论是战斗的姿势还是挥剑的气势都非常完美。",
            "nextDialogs": [
              "412130203"
            ]
          },
          "412130203": {
            "id": "412130203",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "你过奖了。",
            "nextDialogs": [
              "412130204"
            ]
          },
          "412130204": {
            "id": "412130204",
            "speakerId": 1001,
            "speakerName": "砂糖",
            "text": "这把剑好特别，明明没有想要深入研究，眼神却不知不觉就被吸引了过去…",
            "nextDialogs": [
              "412130205"
            ]
          },
          "412130205": {
            "id": "412130205",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "我倒觉得比起剑的属性，这个更像是你自己的属性呢…",
            "nextDialogs": [
              "412130206"
            ]
          },
          "412130206": {
            "id": "412130206",
            "speakerId": 1001,
            "speakerName": "砂糖",
            "text": "危险诱人的神秘单手剑，嗯，不会错的。",
            "nextDialogs": [
              "412130207"
            ]
          },
          "412130207": {
            "id": "412130207",
            "speakerId": 1001,
            "speakerName": "砂糖",
            "text": "把这么重要的东西交给你，阿贝多先生果然非常信任你呢！",
            "nextDialogs": [
              "412130210"
            ]
          },
          "412130210": {
            "id": "412130210",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "哼哼，这也是凭本事换来的信任吧。",
            "nextDialogs": [
              "412130211"
            ]
          },
          "412130211": {
            "id": "412130211",
            "speakerId": 1001,
            "speakerName": "砂糖",
            "text": "我也这么觉得。",
            "nextDialogs": [
              "412130212"
            ]
          },
          "412130212": {
            "id": "412130212",
            "speakerId": 1001,
            "speakerName": "砂糖",
            "text": "不过在交给你之前，剑还没有吸收多少能量…阿贝多先生是怎么从一堆杂物中发觉它与众不同的呢？",
            "nextDialogs": [
              "412130213"
            ]
          },
          "412130213": {
            "id": "412130213",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "灵光一闪通常是没有道理的。比如我想吃蜜酱胡萝卜煎肉！",
            "nextDialogs": [
              "412130214"
            ]
          },
          "412130214": {
            "id": "412130214",
            "speakerId": 1001,
            "speakerName": "砂糖",
            "text": "啊…这么一说，我今天还没吃过多少东西呢。",
            "nextDialogs": [
              "412130215"
            ]
          },
          "412130215": {
            "id": "412130215",
            "speakerId": 1001,
            "speakerName": "砂糖",
            "text": "忙完实验赶来找你们，却在路上遇到被困在雪地里的冒险家，为了救他又花了不少时间…",
            "nextDialogs": [
              "412130216"
            ]
          },
          "412130216": {
            "id": "412130216",
            "speakerId": 1001,
            "speakerName": "砂糖",
            "text": "（咕…咕…）",
            "nextDialogs": [
              "412130217"
            ]
          },
          "412130217": {
            "id": "412130217",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "刚才那是肚子饿了的声音吗？",
            "nextDialogs": [
              "412130218"
            ]
          },
          "412130218": {
            "id": "412130218",
            "speakerId": 1001,
            "speakerName": "砂糖",
            "text": "啊、啊啊啊！不、不是这样的…",
            "nextDialogs": [
              "412130219"
            ]
          },
          "412130219": {
            "id": "412130219",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "别害羞别害羞，大胆地说出你的想法嘛！",
            "nextDialogs": [
              "412130220"
            ]
          },
          "412130220": {
            "id": "412130220",
            "speakerId": 1001,
            "speakerName": "砂糖",
            "text": "呃、呃…",
            "nextDialogs": [
              "412130221"
            ]
          },
          "412130221": {
            "id": "412130221",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "那我先说：肚子饿了！我想吃饭！"
          }
        }
      }
    },
    {
      "subId": "4121306",
      "subQuestName": "跟随砂糖前往冒险家营地",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "412130601"
        ],
        "dialogs": {
          "412130601": {
            "id": "412130601",
            "speakerId": 1006,
            "speakerName": "阿贝多",
            "text": "龙的力量…龙的生命力，能让枯死的植物复活到这种地步…",
            "nextDialogs": [
              "412130602"
            ]
          },
          "412130602": {
            "id": "412130602",
            "speakerId": 1006,
            "speakerName": "阿贝多",
            "text": "不可思议。",
            "nextDialogs": [
              "412130603"
            ]
          },
          "412130603": {
            "id": "412130603",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "还以为是一截枯树桩，没想到是这种怪物呀！",
            "nextDialogs": [
              "412130604"
            ]
          },
          "412130604": {
            "id": "412130604",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "差一点就被吞下去了！",
            "nextDialogs": [
              "412130605"
            ]
          },
          "412130605": {
            "id": "412130605",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "不过，为什么只有今天发生了这种情况呢？",
            "nextDialogs": [
              "412130606"
            ]
          },
          "412130606": {
            "id": "412130606",
            "speakerId": 1006,
            "speakerName": "阿贝多",
            "text": "多半是因为剑落到地上遭受了撞击，导致力量外泄。",
            "nextDialogs": [
              "412130607"
            ]
          },
          "412130607": {
            "id": "412130607",
            "speakerId": 1002,
            "speakerName": "冒失的帕拉德",
            "text": "我错了，不要赶我走，千万不要赶我走啊！",
            "nextDialogs": [
              "412130608"
            ]
          },
          "412130608": {
            "id": "412130608",
            "speakerId": 1002,
            "speakerName": "冒失的帕拉德",
            "text": "我保证绝不乱动！",
            "nextDialogs": [
              "412130609"
            ]
          },
          "412130609": {
            "id": "412130609",
            "speakerId": 1001,
            "speakerName": "砂糖",
            "text": "啊，帕拉德先生…也不用抱着膝盖蹲到地上变成蘑菇呀…",
            "nextDialogs": [
              "412130610"
            ]
          },
          "412130610": {
            "id": "412130610",
            "speakerId": 1006,
            "speakerName": "阿贝多",
            "text": "唉。",
            "nextDialogs": [
              "412130611"
            ]
          },
          "412130611": {
            "id": "412130611",
            "speakerId": 1006,
            "speakerName": "阿贝多",
            "text": "这棵急冻树会枯死在这种地方，难道是因为它无法吸收被污染过的力量？",
            "nextDialogs": [
              "412130612"
            ]
          },
          "412130612": {
            "id": "412130612",
            "speakerId": 1006,
            "speakerName": "阿贝多",
            "text": "旅行者能够净化污秽，净化后的纯净元素力不仅能让它复活，甚至强化了它。",
            "nextDialogs": [
              "412130613"
            ]
          },
          "412130613": {
            "id": "412130613",
            "speakerId": 1006,
            "speakerName": "阿贝多",
            "text": "纯粹的生命之力会迫使它不断重生…看来，之后还会有持续不断的战斗。",
            "nextDialogs": [
              "412130616"
            ]
          },
          "412130616": {
            "id": "412130616",
            "speakerId": 1006,
            "speakerName": "阿贝多",
            "text": "我也从没遇到过类似事件。",
            "nextDialogs": [
              "412130617"
            ]
          },
          "412130617": {
            "id": "412130617",
            "speakerId": 1006,
            "speakerName": "阿贝多",
            "text": "如此罕见的情况，不得不说，也是一种意外收获。",
            "nextDialogs": [
              "412130618"
            ]
          },
          "412130618": {
            "id": "412130618",
            "speakerId": 1006,
            "speakerName": "阿贝多",
            "text": "砂糖。",
            "nextDialogs": [
              "412130619"
            ]
          },
          "412130619": {
            "id": "412130619",
            "speakerId": 1001,
            "speakerName": "砂糖",
            "text": "啊、是！",
            "nextDialogs": [
              "412130620"
            ]
          },
          "412130620": {
            "id": "412130620",
            "speakerId": 1006,
            "speakerName": "阿贝多",
            "text": "看好那个冒险家，把他送回营地去。",
            "nextDialogs": [
              "412130621"
            ]
          },
          "412130621": {
            "id": "412130621",
            "speakerId": 1001,
            "speakerName": "砂糖",
            "text": "好的先生！",
            "nextDialogs": [
              "412130622"
            ]
          },
          "412130622": {
            "id": "412130622",
            "speakerId": 1006,
            "speakerName": "阿贝多",
            "text": "至于这里，虽然很不好意思…但还是要麻烦你了，旅行者。",
            "nextDialogs": [
              "412130623"
            ]
          },
          "412130623": {
            "id": "412130623",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "我会尽力解决它。",
            "nextDialogs": [
              "412130624"
            ]
          },
          "412130624": {
            "id": "412130624",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "预料之外的麻烦事，却只有我们能解决。果然还是因为我们越来越厉害了！"
          }
        }
      }
    },

        ],
        "dialogs": {
          "210340401": {
            "id": "210340401",
            "speakerId": 2016,
            "speakerName": "岚姐",
            "text": "怎么？你已经把那边的魔物清理完了吗？",
            "nextDialogs": [
              "210340402"
            ]
          },
          "210340402": {
            "id": "210340402",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "这里的魔物…你已经全部打倒了？",
            "nextDialogs": [
              "210340403"
            ]
          },
          "210340403": {
            "id": "210340403",
            "speakerId": 2016,
            "speakerName": "岚姐",
            "text": "嗯？那是自然。",
            "nextDialogs": [
              "210340404"
            ]
          },
          "210340404": {
            "id": "210340404",
            "speakerId": 2016,
            "speakerName": "岚姐",
            "text": "我好歹也是璃月冒险家协会的会长。对付这群寻常的魔物，也没费多大力气。"
          }
        }
      }
    },

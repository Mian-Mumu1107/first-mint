    {
      "subId": "2103404",
      "subQuestName": "和岚姐对话",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "210340501"
        ],
        "dialogs": {
          "210340501": {
            "id": "210340501",
            "speakerId": 2016,
            "speakerName": "岚姐",
            "text": "旅行者，你已经把那片营地里的魔物都清理掉了吗？",
            "nextDialogs": [
              "210340504"
            ]
          },
          "210340504": {
            "id": "210340504",
            "speakerId": 2016,
            "speakerName": "岚姐",
            "text": "只是一些寻常魔物，没有费太多力气。而且我的运气不错，找到了一枚颇有价值的长剑碎片。",
            "nextDialogs": [
              "210340505"
            ]
          },
          "210340505": {
            "id": "210340505",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "我那边没有发现…",
            "nextDialogs": [
              "210340506"
            ]
          },
          "210340506": {
            "id": "210340506",
            "speakerId": 2016,
            "speakerName": "岚姐",
            "text": "无需挂怀，你也算是帮我排除了一处错误地点，多谢了。",
            "nextDialogs": [
              "210340507"
            ]
          },
          "210340507": {
            "id": "210340507",
            "speakerId": 2016,
            "speakerName": "岚姐",
            "text": "这些报酬是给你的，请收下吧。"
          }
        }
      }
    },
    {
      "subId": "2103405",
      "subQuestName": "和岚姐对话",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "210340601"
        ],
        "dialogs": {
          "210340601": {
            "id": "210340601",
            "speakerId": 2016,
            "speakerName": "岚姐",
            "text": "旅行者，你已经把那片营地里的魔物都清理掉了吗？",
            "nextDialogs": [
              "210340604"
            ]
          },
          "210340604": {
            "id": "210340604",
            "speakerId": 2016,
            "speakerName": "岚姐",
            "text": "只是一些寻常魔物，没有费太多力气…可惜没找到什么有价值的东西，都是一些破铜烂铁。",
            "nextDialogs": [
              "210340605"
            ]
          },
          "210340605": {
            "id": "210340605",
            "speakerId": 2016,
            "speakerName": "岚姐",
            "text": "你那边呢？有什么发现吗？",
            "nextDialogs": [
              "210340606"
            ]
          },
          "210340606": {
            "id": "210340606",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "找到了这个。",
            "nextDialogs": [
              "210340607"
            ]
          },
          "210340607": {
            "id": "210340607",
            "speakerId": 2016,
            "speakerName": "岚姐",
            "text": "唔…这确实是一把剑的碎片…多谢，我会拿回去好好看一下的。",
            "nextDialogs": [
              "210340608"
            ]
          },
          "210340608": {
            "id": "210340608",
            "speakerId": 2016,
            "speakerName": "岚姐",
            "text": "多谢你了，旅行者，这些报酬是给你的，请收下吧。"
          }
        }
      }
    },
    {
      "subId": "2103401",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "210340101"
        ],
        "dialogs": {
          "210340101": {
            "id": "210340101",
            "speakerId": 2016,
            "speakerName": "岚姐",
            "text": "哼，看来这家伙就在这里了。",
            "nextDialogs": [
              "210340104"
            ]
          },
          "210340104": {
            "id": "210340104",
            "speakerId": 2016,
            "speakerName": "岚姐",
            "text": "旅行者，没想到能在这里遇见你…",
            "nextDialogs": [
              "210340105"
            ]
          },
          "210340105": {
            "id": "210340105",
            "speakerId": 2016,
            "speakerName": "岚姐",
            "text": "你还记得上次你们帮我找到的那个剑柄吗？它确实是「藏锋」的一部分…",
            "nextDialogs": [
              "210340106"
            ]
          },
          "210340106": {
            "id": "210340106",
            "speakerId": 2016,
            "speakerName": "岚姐",
            "text": "说来好笑，我之所以能把它分辨出来，是因为我小时候偷偷拿刀在上面刻了记号…",
            "nextDialogs": [
              "210340107"
            ]
          },
          "210340107": {
            "id": "210340107",
            "speakerId": 2016,
            "speakerName": "岚姐",
            "text": "那时我和兄长说，如果他之后换了其他的剑，那一定要把「藏锋」送给我。",
            "nextDialogs": [
              "210340108"
            ]
          },
          "210340108": {
            "id": "210340108",
            "speakerId": 2016,
            "speakerName": "岚姐",
            "text": "呵呵，我们两个那时候应该都没想到…我居然是以这种形式拿到的「藏锋」。看来，这柄剑…真的已经碎了。",
            "nextDialogs": [
              "210340109"
            ]
          },
          "210340109": {
            "id": "210340109",
            "speakerId": 2016,
            "speakerName": "岚姐",
            "text": "好了，闲话就不说了。既然在这里遇见了你，那我还要请你再帮我一个忙。",
            "nextDialogs": [
              "210340110"
            ]
          },
          "210340110": {
            "id": "210340110",
            "speakerId": 2016,
            "speakerName": "岚姐",
            "text": "前面是两处魔物聚集地，这群魔物四处搜集了不少破损的武器，放在营地里不知作何用途。",
            "nextDialogs": [
              "210340111"
            ]
          },
          "210340111": {
            "id": "210340111",
            "speakerId": 2016,
            "speakerName": "岚姐",
            "text": "协会担心它们扰乱周边，本来打算挂出委托，但我看见之后就自己揽了下来…也许，我能从这里再找到一些「藏锋」的碎片…",
            "nextDialogs": [
              "210340112"
            ]
          },
          "210340112": {
            "id": "210340112",
            "speakerId": 2016,
            "speakerName": "岚姐",
            "text": "旅行者，我们就各去扫清一片营地吧。",
            "nextDialogs": [
              "210340113"
            ]
          },
          "210340113": {
            "id": "210340113",
            "speakerId": 2016,
            "speakerName": "岚姐",
            "text": "左边的营地聚集着一群丘丘人，虽然对你来说，单个丘丘人并不难对付…",
            "nextDialogs": [
              "210340114"
            ]
          },
          "210340114": {
            "id": "210340114",
            "speakerId": 2016,
            "speakerName": "岚姐",
            "text": "但这里丘丘人的数量不少，如果它们一拥而上，只怕你也需要费一番手脚。",
            "nextDialogs": [
              "210340115"
            ]
          },
          "210340115": {
            "id": "210340115",
            "speakerId": 2016,
            "speakerName": "岚姐",
            "text": "右边是一个「丘丘岩盔王」，它的危险程度…我应该也不用解释了。",
            "nextDialogs": [
              "210340116"
            ]
          },
          "210340116": {
            "id": "210340116",
            "speakerId": 2016,
            "speakerName": "岚姐",
            "text": "是我请你帮的忙，就由你先选一片营地吧。"
          }
        }
      }
    },
    {
      "subId": "2103404",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [

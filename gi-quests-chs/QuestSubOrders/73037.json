    {
      "subId": "7303712",
      "subQuestName": "与兰拉娜对话",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "730370301"
        ],
        "dialogs": {
          "730370301": {
            "id": "730370301",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "兰罗摩…",
            "nextDialogs": [
              "730370302"
            ]
          },
          "730370302": {
            "id": "730370302",
            "speakerId": 20647,
            "speakerName": "兰拉娜",
            "text": "兰罗摩已经长成了新的觉王树。虽然现在还很小，但根扎得很深，很强壮。过很多很多个月亮，一定会变得又大、又漂亮。",
            "nextDialogs": [
              "730370303"
            ]
          },
          "730370303": {
            "id": "730370303",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "兰拉娜说过，回忆和梦是兰那罗的力量，是最珍贵的东西。放弃记忆，就会忘记拉娜吧？还有维摩庄的孩子们…",
            "nextDialogs": [
              "730370304"
            ]
          },
          "730370304": {
            "id": "730370304",
            "speakerId": 20647,
            "speakerName": "兰拉娜",
            "text": "嗯。但朋友比回忆更珍贵。无论失去多少记忆，都能再累积。如果失去了朋友，就回不来了。",
            "nextDialogs": [
              "730370305"
            ]
          },
          "730370305": {
            "id": "730370305",
            "speakerId": 20647,
            "speakerName": "兰拉娜",
            "text": "我想要帮助那菈拉娜。她的名字和兰拉娜一样，是兰拉娜的朋友。",
            "nextDialogs": [
              "730370306"
            ]
          },
          "730370306": {
            "id": "730370306",
            "speakerId": 20647,
            "speakerName": "兰拉娜",

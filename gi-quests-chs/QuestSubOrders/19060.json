    {
      "subId": "1906013",
      "subQuestName": "",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "190603701"
        ],
        "dialogs": {
          "190603701": {
            "id": "190603701",
            "speakerId": 1000,
            "speakerName": "城山的遗书",
            "text": "「鹰司勇是我毒死的，我在他的风寒汤剂里下了毒。」",
            "nextDialogs": [
              "190603702"
            ]
          },
          "190603702": {
            "id": "190603702",
            "speakerId": 1000,
            "speakerName": "城山的遗书",
            "text": "「这家伙表面上道貌岸然，暗地却要我替他寻找新型毒药，用来秘密除掉与他作对的人。」",
            "nextDialogs": [
              "190603703"
            ]
          },
          "190603703": {
            "id": "190603703",
            "speakerId": 1000,
            "speakerName": "城山的遗书",
            "text": "「还恐吓我若不替他办事，就捏造罪名把我送去大牢，甚至还用我的家人做要挟。」",
            "nextDialogs": [
              "190603704"
            ]
          },
          "190603704": {
            "id": "190603704",
            "speakerId": 1000,
            "speakerName": "城山的遗书",
            "text": "「我实在没有办法，只好出此下策，用托人在万国商会买到的新型毒药将他…事后为求自保，我还将毒药栽赃给了同事龙二。」",
            "nextDialogs": [
              "190603705"
            ]
          },
          "190603705": {
            "id": "190603705",
            "speakerId": 1000,
            "speakerName": "城山的遗书",
            "text": "「如今那位侦探查明一切只是时间问题，我自知铸成大错，避无可避，只好一死了之，只求不要殃及我的家人。」",
            "nextDialogs": [
              "190603706"
            ]
          },
          "190603706": {
            "id": "190603706",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "呀，这个就是证明凶手是城山的关键吧？只要他说的是真的。"
          }
        }
      }
    },
    {
      "subId": "1906014",
      "subQuestName": "",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "190603401"
        ],
        "dialogs": {
          "190603401": {
            "id": "190603401",
            "speakerId": 1002,
            "speakerName": "嫌疑人城山的定罪书",
            "text": "嫌疑人城山，年龄二十二，奉行所法医，系死者鹰司勇下属。",
            "nextDialogs": [
              "190603402"
            ]
          },
          "190603402": {
            "id": "190603402",
            "speakerId": 1002,
            "speakerName": "嫌疑人城山的定罪书",
            "text": "因与上司鹰司勇的工作冲突，心生怨恨，秘密购置特殊毒药一瓶，仇恨杀人。",
            "nextDialogs": [
              "190603403"
            ]
          },
          "190603403": {
            "id": "190603403",
            "speakerId": 1002,
            "speakerName": "嫌疑人城山的定罪书",
            "text": "后在嫌疑人城山办公室中搜出未使用完的毒药，其在遗书中坦白，龙二家中所发现的毒药系栽赃。",
            "nextDialogs": [
              "190603404"
            ]
          },
          "190603404": {
            "id": "190603404",
            "speakerId": 1002,
            "speakerName": "嫌疑人城山的定罪书",
            "text": "嫌疑人城山恶意杀害他人，宣判死刑。因其已畏罪自尽，无法执刑，留档为证。",
            "nextDialogs": [
              "190603405"
            ]
          },
          "190603405": {
            "id": "190603405",
            "speakerId": 1002,
            "speakerName": "嫌疑人城山的定罪书",
            "text": "签署人：九条裟罗。",
            "nextDialogs": [
              "190603406"
            ]
          },
          "190603406": {
            "id": "190603406",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "咦？城山的定罪书也是九条裟罗签的…和龙二的一样吗？"
          }
        }
      }
    },
    {
      "subId": "1906024",
      "subQuestName": "",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "190603201"
        ],
        "dialogs": {
          "190603201": {
            "id": "190603201",
            "speakerId": 1003,
            "speakerName": "鹰司勇的尸检报告",
            "text": "死者鹰司勇，年龄四十一，奉行所管理人。",
            "nextDialogs": [
              "190603202"
            ]
          },
          "190603202": {
            "id": "190603202",
            "speakerId": 1003,
            "speakerName": "鹰司勇的尸检报告",
            "text": "死时衣着完整，体表无外伤，无打斗痕迹，喉部充血红肿，系生前风寒所致。",
            "nextDialogs": [
              "190603203"
            ]
          },
          "190603203": {
            "id": "190603203",
            "speakerId": 1003,
            "speakerName": "鹰司勇的尸检报告",
            "text": "胃肠有局部溃烂，系腹中内容物里发现的新型毒药所致。腹中内容物包括：未消化完全的软米饭残留；…",
            "nextDialogs": [
              "190603204"
            ]
          },
          "190603204": {
            "id": "190603204",
            "speakerId": 1003,
            "speakerName": "鹰司勇的尸检报告",
            "text": "…少量鱼肝清膏残留，主要成分为高浓度的鱼肝提取物，名贵营养补品；…",
            "nextDialogs": [
              "190603205"
            ]
          },
          "190603205": {
            "id": "190603205",
            "speakerId": 1003,
            "speakerName": "鹰司勇的尸检报告",
            "text": "…少量风寒汤剂残留，含有大量酸性果蔬提取物， 系法医室调配的特制药物；…",
            "nextDialogs": [
              "190603206"
            ]
          },
          "190603206": {
            "id": "190603206",
            "speakerId": 1003,
            "speakerName": "鹰司勇的尸检报告",
            "text": "…少量新型毒药残留，提取后比对发现，与龙二、城山家中搜出的毒药一致。致死原因：新型毒药引发的腹部粘膜病变与呼吸循环衰竭。",
            "nextDialogs": [
              "190603207"
            ]
          },
          "190603207": {
            "id": "190603207",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "噫…他吃了好多东西！"
          }
        }
      }
    },
    {
      "subId": "1906025",
      "subQuestName": "",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "190603301"
        ],
        "dialogs": {
          "190603301": {
            "id": "190603301",
            "speakerId": 1004,
            "speakerName": "嫌疑人龙二的定罪书",
            "text": "嫌疑人龙二，年龄二十，奉行所同心，系死者鹰司勇下属。",
            "nextDialogs": [
              "190603302"
            ]
          },
          "190603302": {
            "id": "190603302",
            "speakerId": 1004,
            "speakerName": "嫌疑人龙二的定罪书",
            "text": "因与上司鹰司勇的工作冲突，心生怨恨，秘密购置特殊毒药一瓶。仇恨杀人。",
            "nextDialogs": [
              "190603303"
            ]
          },
          "190603303": {
            "id": "190603303",
            "speakerId": 1004,
            "speakerName": "嫌疑人龙二的定罪书",
            "text": "后在嫌疑人龙二家中搜出未使用完的毒药。嫌疑人龙二恶意杀害他人，暂押入狱，听候发落，留档为证。",
            "nextDialogs": [
              "190603304"
            ]
          },
          "190603304": {
            "id": "190603304",
            "speakerId": 1004,
            "speakerName": "嫌疑人龙二的定罪书",
            "text": "签署人：九条裟罗。",
            "nextDialogs": [
              "190603305"
            ]
          },
          "190603305": {
            "id": "190603305",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "呜哇，龙二的定罪书真的是九条裟罗签的…不过现在看，这里面的内容应该是错误的吧。"
          }
        }
      }
    },
    {
      "subId": "1906026",
      "subQuestName": "",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "190603501"
        ],
        "dialogs": {
          "190603501": {
            "id": "190603501",
            "speakerId": 1005,
            "speakerName": "毒药的调查报告",
            "text": "关于致鹰司勇死亡的毒药研究如下：",
            "nextDialogs": [
              "190603502"
            ]
          },
          "190603502": {
            "id": "190603502",
            "speakerId": 1005,
            "speakerName": "毒药的调查报告",
            "text": "无气无味，性质稳定，可溶于水，不溶于其他物，具备合成毒药的特征，常态呈白色霜状粉末，暂名「白霜」。",
            "nextDialogs": [
              "190603503"
            ]
          },
          "190603503": {
            "id": "190603503",
            "speakerId": 1005,
            "speakerName": "毒药的调查报告",
            "text": "所内调查了境内所有商会的账簿，暂未发现此类物品的流通记录。",
            "nextDialogs": [
              "190603504"
            ]
          },
          "190603504": {
            "id": "190603504",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "合成毒药是什么意思？"
          }
        }
      }
    },
    {
      "subId": "1906027",
      "subQuestName": "",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "190603601"
        ],
        "dialogs": {
          "190603601": {
            "id": "190603601",
            "speakerId": 1006,
            "speakerName": "龙二的口供",
            "text": "「案发前一周，鹰司勇大人染上风寒，食欲不振，只吃得下一些软白米饭，也一直在服用特制风寒汤剂。」",
            "nextDialogs": [
              "190603602"
            ]
          },
          "190603602": {
            "id": "190603602",
            "speakerId": 1006,
            "speakerName": "龙二的口供",
            "text": "「案发前一晚，大人风寒仍未好转，却依旧忙于工作，我担心大人身体，在城山医生过来送汤剂时，顺便咨询了一些补品事宜。」",
            "nextDialogs": [
              "190603603"
            ]
          },
          "190603603": {
            "id": "190603603",
            "speakerId": 1006,
            "speakerName": "龙二的口供",
            "text": "「城山医生建议了鱼肝清膏，说是能够提高抵抗力，我便去法医室取来一些送给大人服下…」",
            "nextDialogs": [
              "190603604"
            ]
          },
          "190603604": {
            "id": "190603604",
            "speakerId": 1006,
            "speakerName": "龙二的口供",
            "text": "「可结果第二天就…鹰司大人对我恩重如山，我发誓绝对不会对他做出这种事！」",
            "nextDialogs": [
              "190603605"
            ]
          },
          "190603605": {
            "id": "190603605",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "说起来，这个城山是法医呀，想要下手确实很有机会呢。"
          }
        }
      }
    },
    {
      "subId": "1906029",
      "subQuestName": "",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "190603801"
        ],
        "dialogs": {
          "190603801": {
            "id": "190603801",
            "speakerId": 1007,
            "speakerName": "法医室的研究日志",
            "text": "（一片空白，中间有大片被撕下的痕迹。）",
            "nextDialogs": [
              "190603802"
            ]
          },
          "190603802": {
            "id": "190603802",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "咦？好奇怪，怎么什么都没有？！这个应该就是平藏说的无效信息吧！"
          }
        }
      }
    },
    {
      "subId": "1906030",
      "subQuestName": "",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "190603901"
        ],
        "dialogs": {
          "190603901": {
            "id": "190603901",
            "speakerId": 1008,
            "speakerName": "鹰司勇的留言",
            "text": "与城山的遗书摆放在一起的纸条，比对笔迹后发现系死者鹰司勇所留。",
            "nextDialogs": [
              "190603902"
            ]
          },
          "190603902": {
            "id": "190603902",
            "speakerId": 1008,
            "speakerName": "鹰司勇的留言",
            "text": "「城山，好久没见你，我需要的东西准备的如何了？」",
            "nextDialogs": [
              "190603903"
            ]
          },
          "190603903": {
            "id": "190603903",
            "speakerId": 1008,
            "speakerName": "鹰司勇的留言",
            "text": "「今天登门贵府，你不在家，但令正热情地招待了我，她是个好女人，与你也十分般配。」",
            "nextDialogs": [
              "190603904"
            ]
          },
          "190603904": {
            "id": "190603904",
            "speakerId": 1008,
            "speakerName": "鹰司勇的留言",
            "text": "「说起来真巧，令正腹中的孩子应该有四五个月吧？与我家孩子一般大。」",
            "nextDialogs": [
              "190603905"
            ]
          },
          "190603905": {
            "id": "190603905",
            "speakerId": 1008,
            "speakerName": "鹰司勇的留言",
            "text": "「我特地回去取来了一些滋补物什，亲自喂她服下了，她很感谢。」",
            "nextDialogs": [
              "190603906"
            ]
          },
          "190603906": {
            "id": "190603906",
            "speakerId": 1008,
            "speakerName": "鹰司勇的留言",
            "text": "「你也想感谢我吗？那就不要让我等太久。」",
            "nextDialogs": [
              "190603907"
            ]
          },
          "190603907": {
            "id": "190603907",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "看起来，好像这个鹰司勇是个挺和善的人呢，就是感觉这个口气怪怪的…"
          }
        }
      }
    },

    {
      "subId": "7226208",
      "subQuestName": "前往目的地",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "722620401"
        ],
        "dialogs": {
          "722620401": {
            "id": "722620401",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "嗯，这边应该不错！",
            "nextDialogs": [
              "722620402"
            ]
          },
          "722620402": {
            "id": "722620402",
            "speakerId": 1000,
            "speakerName": "「吉法师」",
            "text": "吉法师想玩水！",
            "nextDialogs": [
              "722620403"
            ]
          },
          "722620403": {
            "id": "722620403",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "喂，现在不行！会把鱼儿吓跑的！",
            "nextDialogs": [
              "722620404"
            ]
          },
          "722620404": {
            "id": "722620404",
            "speakerId": 1002,
            "speakerName": "Black Screen",
            "text": "简单扼要地教了教钓鱼的基础。\\n虽说教学尽量简明扼要，但究竟能听懂多少呢…",
            "nextDialogs": [
              "722620405"
            ]
          },
          "722620405": {
            "id": "722620405",
            "speakerId": 1000,
            "speakerName": "「吉法师」",
            "text": "鱼儿！",
            "nextDialogs": [
              "722620406"
            ]
          },
          "722620406": {
            "id": "722620406",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "听明白了吗？",
            "nextDialogs": [
              "722620407"
            ]
          },
          "722620407": {
            "id": "722620407",
            "speakerId": 1000,
            "speakerName": "「吉法师」",
            "text": "呶哈哈，鱼儿好笨哦。会被吃的东西骗。",
            "nextDialogs": [
              "722620409",
              "722620411"
            ]
          },
          "722620409": {
            "id": "722620409",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "喂！",
            "nextDialogs": [
              "722620413"
            ]
          },
          "722620413": {
            "id": "722620413",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "毕竟，追求美食的心谁都有嘛！",
            "nextDialogs": [
              "722620414"
            ]
          },
          "722620414": {
            "id": "722620414",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "#那么，{NICKNAME}，就拜托你给吉法师露一手啦！"
          },
          "722620411": {
            "id": "722620411",
            "speakerId": 1000,
            "speakerName": "「吉法师」",
            "text": "呶？"
          }
        }
      }
    },

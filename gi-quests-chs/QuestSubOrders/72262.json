    {
      "subId": "7226203",
      "subQuestName": "为吉法师拍照",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "722620301"
        ],
        "dialogs": {
          "722620301": {
            "id": "722620301",
            "speakerId": 1000,
            "speakerName": "「吉法师」",
            "text": "呜呶呶…为什么…",
            "nextDialogs": [
              "722620302"
            ]
          },
          "722620302": {
            "id": "722620302",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "吉法师真是的！怎么就冲进丘丘人的据点里了呢？",
            "nextDialogs": [
              "722620303"
            ]
          },
          "722620303": {
            "id": "722620303",
            "speakerId": 1000,
            "speakerName": "「吉法师」",
            "text": "本来以为…能和丘丘人一起玩…",
            "nextDialogs": [
              "722620304"
            ]
          },
          "722620304": {
            "id": "722620304",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "欸？为什么这么想？丘丘人是很危险的魔物…",
            "nextDialogs": [
              "722620306",
              "722620308"
            ]
          },
          "722620306": {
            "id": "722620306",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "喂！吉法师可不是像你这样身经百战的旅行者啦！",
            "nextDialogs": [
              "722620309"
            ]
          },
          "722620309": {
            "id": "722620309",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "在镇守之森第一次见面的时候…",
            "nextDialogs": [
              "722620310"
            ]
          },
          "722620310": {
            "id": "722620310",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "对呀，当时吉法师不是被丘丘人包围着，变成了什么东西躲起来了吗？",
            "nextDialogs": [
              "722620311"
            ]
          },
          "722620311": {
            "id": "722620311",
            "speakerId": 1000,
            "speakerName": "「吉法师」",
            "text": "刚刚见到你们的时候…我想想…我想想…啊，对了。",
            "nextDialogs": [
              "722620312"
            ]
          },
          "722620312": {
            "id": "722620312",
            "speakerId": 1000,
            "speakerName": "「吉法师」",
            "text": "那时候，是在和丘丘人捉迷藏。森林里的丘丘人，是不会攻击妖狸的。而且，经常陪我们玩。",
            "nextDialogs": [
              "722620313"
            ]
          },
          "722620313": {
            "id": "722620313",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "欸？是形成了什么和谐共生的关系吗…",
            "nextDialogs": [
              "722620314"
            ]
          },
          "722620314": {
            "id": "722620314",
            "speakerId": 1000,
            "speakerName": "「吉法师」",
            "text": "不知道为什么，这里的丘丘人会这样。呜呶呶…",
            "nextDialogs": [
              "722620315"
            ]
          },
          "722620315": {
            "id": "722620315",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "总之，在外面要多加小心啦！即使是丘丘人…不对，应该说，正因为是丘丘人…",
            "nextDialogs": [
              "722620316"
            ]
          },
          "722620316": {
            "id": "722620316",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "#呜哇，好复杂…{NICKNAME}，你来帮我说！",
            "nextDialogs": [
              "722620317"
            ]
          },
          "722620317": {
            "id": "722620317",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "要学会分辨好人和坏人。",
            "nextDialogs": [
              "722620318"
            ]
          },
          "722620318": {
            "id": "722620318",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "嗯！这样才能在外面，保护好自己。",
            "nextDialogs": [
              "722620319"
            ]
          },
          "722620319": {
            "id": "722620319",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "但是也不要忘了善良和开放的心。",
            "nextDialogs": [
              "722620320"
            ]
          },
          "722620320": {
            "id": "722620320",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "嗯嗯，没错！这样才能容纳美好的事物。",
            "nextDialogs": [
              "722620321"
            ]
          },
          "722620321": {
            "id": "722620321",
            "speakerId": 1000,
            "speakerName": "「吉法师」",
            "text": "呶…",
            "nextDialogs": [
              "722620322"
            ]
          },
          "722620322": {
            "id": "722620322",
            "speakerId": 1000,
            "speakerName": "「吉法师」",
            "text": "#{NICKNAME}和派蒙说得好复杂，吉法师听不懂。",
            "nextDialogs": [
              "722620323"
            ]
          },
          "722620323": {
            "id": "722620323",
            "speakerId": 1000,
            "speakerName": "「吉法师」",
            "text": "但是，吉法师知道，你们是好人。所以，吉法师要学你们。",
            "nextDialogs": [
              "722620324"
            ]
          },
          "722620324": {
            "id": "722620324",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "#好啦，不说这个了。先跟{NICKNAME}学习钓鱼吧！",
            "nextDialogs": [
              "722620325"
            ]
          },
          "722620325": {
            "id": "722620325",
            "speakerId": 1000,
            "speakerName": "「吉法师」",
            "text": "嗯！钓鱼！"
          },
          "722620308": {
            "id": "722620308",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "也不用这样吓唬他啦！"
          }
        }
      }
    },
    {
      "subId": "7226204",
      "subQuestName": "与吉法师对话",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "722620201"
        ],
        "dialogs": {
          "722620201": {
            "id": "722620201",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "拍好了！",
            "nextDialogs": [
              "722620202"
            ]
          },
          "722620202": {
            "id": "722620202",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "接下来的话…",
            "nextDialogs": [
              "722620203"
            ]
          },
          "722620203": {
            "id": "722620203",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "嗯，就这么办吧！吉法师，钓过鱼吗？",
            "nextDialogs": [
              "722620204"
            ]
          },
          "722620204": {
            "id": "722620204",
            "speakerId": 1000,
            "speakerName": "「吉法师」",
            "text": "钓鱼？",
            "nextDialogs": [
              "722620205"
            ]
          },
          "722620205": {
            "id": "722620205",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "看来没试过呢！走，我们到水边去吧！",
            "nextDialogs": [
              "722620206"
            ]
          },
          "722620206": {
            "id": "722620206",
            "speakerId": 1000,
            "speakerName": "「吉法师」",
            "text": "好！"
          }
        }
      }
    },
    {
      "subId": "7226205",
      "subQuestName": "跟上吉法师",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "722620501"
        ],
        "dialogs": {
          "722620501": {
            "id": "722620501",
            "speakerId": 1000,
            "speakerName": "「吉法师」",
            "text": "好想玩水呶。",
            "nextDialogs": [
              "722620502"
            ]
          },
          "722620502": {
            "id": "722620502",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "现在不可以，会把鱼儿吓跑的。",
            "nextDialogs": [
              "722620503"
            ]
          },
          "722620503": {
            "id": "722620503",
            "speakerId": 1000,
            "speakerName": "「吉法师」",
            "text": "嗯。知道了。"
          }
        }
      }
    },
    {
      "subId": "7226206",
      "subQuestName": "打败丘丘人",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "722620601"
        ],
        "dialogs": {
          "722620601": {
            "id": "722620601",
            "speakerId": 1000,
            "speakerName": "「吉法师」",
            "text": "呶，为什么不能直接到水里去抓鱼呢？",
            "nextDialogs": [
              "722620605"
            ]
          },
          "722620605": {
            "id": "722620605",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "嗯，钓鱼也是一种很好的修行方式喔！"
          }
        }
      }
    },
    {
      "subId": "7226207",

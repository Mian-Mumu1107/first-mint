        "dialogs": {
          "400230101": {
            "id": "400230101",
            "speakerId": 1000,
            "speakerName": "「式大将」",
            "text": "旅行者，你们来了！",
            "nextDialogs": [
              "400230102"
            ]
          },
          "400230102": {
            "id": "400230102",
            "speakerId": 1000,
            "speakerName": "「式大将」",
            "text": "我向天领奉行说明了情况，出示了当年的公文。他们总算相信了——我和「诀箓阴阳寮」是清白的。",
            "nextDialogs": [
              "400230103"
            ]
          },
          "400230103": {
            "id": "400230103",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "太好了，这样一来，「式大将」就能专注于自己的使命了。",
            "nextDialogs": [
              "400230104"
            ]
          },
          "400230104": {
            "id": "400230104",
            "speakerId": 1000,
            "speakerName": "「式大将」",
            "text": "没错，现在「诀箓阴阳寮」被我复原成了最初的模样，修炼武艺的纯粹秘境。",
            "nextDialogs": [
              "400230105"
            ]
          },
          "400230105": {
            "id": "400230105",
            "speakerId": 1000,
            "speakerName": "「式大将」",
            "text": "这座秘境运转一段时间后，可能再次耗尽符法之力。到时我会将它封闭，让它慢慢积攒力量。",
            "nextDialogs": [
              "400230109"
            ]
          },
          "400230109": {
            "id": "400230109",
            "speakerId": 1000,
            "speakerName": "「式大将」",
            "text": "机会难得，想来挑战一下吗？",
            "nextDialogs": [
              "400230108"
            ]
          },
          "400230108": {
            "id": "400230108",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "嗯！我也很想见识一下！"
          }
        }
      }
    }
  ]

    {
      "subId": "7106308",
      "subQuestName": "将老臭的事告知唐无仇",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "710630701"
        ],
        "dialogs": {
          "710630701": {
            "id": "710630701",
            "speakerId": 1003,
            "speakerName": "自称「唐无仇」者",
            "text": "哎呀，这块宝石明明有鸟蛋大小，入手却如此轻盈。",
            "nextDialogs": [
              "710630702"
            ]
          },
          "710630702": {
            "id": "710630702",
            "speakerId": 1003,
            "speakerName": "自称「唐无仇」者",
            "text": "对光而照，居然隐约能看到中间夹层的影子，真是不可思议，不可思议啊…",
            "nextDialogs": [
              "710630703"
            ]
          },
          "710630703": {
            "id": "710630703",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "他居然还在看那个蛋…",
            "nextDialogs": [
              "710630704"
            ]
          },
          "710630704": {
            "id": "710630704",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "古华派大侠！",
            "nextDialogs": [
              "710630705"
            ]
          },
          "710630705": {
            "id": "710630705",
            "speakerId": 1003,
            "speakerName": "自称「唐无仇」者",
            "text": "嗯？啊！古华派三百二十代传人唐无仇，正是本人，诸位肯定是听闻我的事迹前来…",
            "nextDialogs": [
              "710630706"
            ]
          },
          "710630706": {
            "id": "710630706",
            "speakerId": 1003,
            "speakerName": "自称「唐无仇」者",
            "text": "唉，原来是你们啊，怎么样，你们找到老臭了吗？",
            "nextDialogs": [
              "710630709"
            ]
          },
          "710630709": {
            "id": "710630709",
            "speakerId": 1002,
            "speakerName": "Black Screen",
            "text": "说明了「翠珏岩」一事，将老臭的赔礼递给唐无仇。",
            "nextDialogs": [
              "710630710"
            ]
          },
          "710630710": {
            "id": "710630710",
            "speakerId": 1003,
            "speakerName": "自称「唐无仇」者",
            "text": "这么一大袋呢…我看看里面都有些啥。",
            "nextDialogs": [
              "710630711"
            ]
          },
          "710630711": {
            "id": "710630711",
            "speakerId": 1003,
            "speakerName": "自称「唐无仇」者",
            "text": "我的天，这么多首饰，而且这些首饰真是…",
            "nextDialogs": [
              "710630712"
            ]
          },
          "710630712": {
            "id": "710630712",
            "speakerId": 1003,
            "speakerName": "自称「唐无仇」者",
            "text": "好丑。",
            "nextDialogs": [
              "710630713"
            ]
          },
          "710630713": {
            "id": "710630713",
            "speakerId": 1003,
            "speakerName": "自称「唐无仇」者",
            "text": "拿这些东西就糊弄我了啊，这个老臭！",
            "nextDialogs": [
              "710630714"
            ]
          },
          "710630714": {
            "id": "710630714",
            "speakerId": 1003,
            "speakerName": "自称「唐无仇」者",
            "text": "当初买那个「翠珏岩」做的玉佩，可花了我好多摩拉呢！而且这老臭在金盆洗手之后，还行那些跟盗宝团沾边的偷鸡摸狗之事！",
            "nextDialogs": [
              "710630715"
            ]
          },
          "710630715": {
            "id": "710630715",
            "speakerId": 1003,
            "speakerName": "自称「唐无仇」者",
            "text": "真是新仇旧恨，哼，看我不一刀切了他。",
            "nextDialogs": [
              "710630716"
            ]
          },
          "710630716": {
            "id": "710630716",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "你还以为自己是大侠呢。",
            "nextDialogs": [
              "710630717"
            ]
          },
          "710630717": {
            "id": "710630717",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "更何况，那块玉佩，当初不是你自己想要买的嘛。",
            "nextDialogs": [
              "710630718"
            ]
          },
          "710630718": {
            "id": "710630718",
            "speakerId": 1003,
            "speakerName": "自称「唐无仇」者",
            "text": "……",
            "nextDialogs": [
              "710630719"
            ]
          },
          "710630719": {
            "id": "710630719",
            "speakerId": 1003,
            "speakerName": "自称「唐无仇」者",
            "text": "…哼哼哼哼哼，哈哈哈哈哈。",
            "nextDialogs": [
              "710630720"
            ]
          },
          "710630720": {
            "id": "710630720",
            "speakerId": 1003,
            "speakerName": "自称「唐无仇」者",
            "text": "你说的有道理。",
            "nextDialogs": [
              "710630721"
            ]
          },
          "710630721": {
            "id": "710630721",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "而且老臭已经不跟盗宝团有关系了，现在正摆摊子让人挖宝玩呢。",
            "nextDialogs": [
              "710630722"
            ]
          },
          "710630722": {
            "id": "710630722",
            "speakerId": 1003,
            "speakerName": "自称「唐无仇」者",
            "text": "挖宝？哼，他又在搞那一套…以前就搞这套来骗买酒的钱。",
            "nextDialogs": [
              "710630723"
            ]
          },
          "710630723": {
            "id": "710630723",
            "speakerId": 1003,
            "speakerName": "自称「唐无仇」者",
            "text": "我跟你说啊…他那个挖宝，<color=#00E1FFFF>越是好东西，周围炸药桶就越多。东西越差，周围就越安全。</color>",
            "nextDialogs": [
              "710630724"
            ]
          },
          "710630724": {
            "id": "710630724",
            "speakerId": 1003,
            "speakerName": "自称「唐无仇」者",
            "text": "比如那种空空如也的格子，周围必是一个炸药桶都没有，而最好的东西呢，周围四格里肯定全放着炸药桶。",
            "nextDialogs": [
              "710630725"
            ]
          },
          "710630725": {
            "id": "710630725",
            "speakerId": 1003,
            "speakerName": "自称「唐无仇」者",
            "text": "真是特别抠门，只要一挖出炸药桶就大喊游戏结束游戏结束，生怕被人把好东西挖走。",
            "nextDialogs": [
              "710630726"
            ]
          },
          "710630726": {
            "id": "710630726",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "可是这次就算我们挖到了炸药桶，他也让我们继续挖呢…",
            "nextDialogs": [
              "710630727"
            ]
          },
          "710630727": {
            "id": "710630727",
            "speakerId": 1003,
            "speakerName": "自称「唐无仇」者",
            "text": "是、是嘛…看来他还是有点良心的。",
            "nextDialogs": [
              "710630728"
            ]
          },
          "710630728": {
            "id": "710630728",
            "speakerId": 1003,
            "speakerName": "自称「唐无仇」者",
            "text": "唉，也是。当初要是我在他身边，凭我的武功，他也不会被那群盗宝团的拿捏成那样。"
          }
        }
      }
    },
    {
      "subId": "7106304",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "710630401"
        ],
        "dialogs": {
          "710630401": {
            "id": "710630401",
            "speakerId": 1000,
            "speakerName": "唐无仇",
            "text": "怎么样，要是能拿出等价的事物，我要换给你，也不是不行。",
            "nextDialogs": [
              "710630402"
            ]
          },
          "710630402": {
            "id": "710630402",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "（那就给他一枚鸟蛋吧……）"
          }
        }
      }
    },
    {
      "subId": "7106309",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "710630901"
        ],
        "dialogs": {
          "710630901": {
            "id": "710630901",
            "speakerId": 1003,
            "speakerName": "自称「唐无仇」者",
            "text": "这块玉佩你们就拿去吧，这么看来，你们也与我古华派有缘，得此至宝，也须小心珍重啊。",
            "nextDialogs": [
              "710630902"
            ]
          },
          "710630902": {
            "id": "710630902",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "刚才一脸不乐意的表情一瞬间就消失了。",
            "nextDialogs": [
              "710630903"
            ]
          },
          "710630903": {
            "id": "710630903",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "唔，这上面有很浓厚的岩元素之力…",
            "nextDialogs": [
              "710630904"
            ]
          },
          "710630904": {
            "id": "710630904",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "普通人日常并不会接触元素之力，要是有这么浓厚的元素之力长时间放在身边，肯定会产生不适。",
            "nextDialogs": [
              "710630905"
            ]
          },
          "710630905": {
            "id": "710630905",
            "speakerId": 1003,
            "speakerName": "自称「唐无仇」者",
            "text": "那不可能，这是我的朋友卖我的，我铁打的兄弟，啊，还能害我吗！",
            "nextDialogs": [
              "710630906"
            ]
          },
          "710630906": {
            "id": "710630906",
            "speakerId": 1003,
            "speakerName": "自称「唐无仇」者",
            "text": "而且我那朋友还有很多玉石打制的首饰…",
            "nextDialogs": [
              "710630907"
            ]
          },
          "710630907": {
            "id": "710630907",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "你的朋友？",
            "nextDialogs": [
              "710630908"
            ]
          },
          "710630908": {
            "id": "710630908",
            "speakerId": 1003,
            "speakerName": "自称「唐无仇」者",
            "text": "对啊，他叫老臭，一个做玉石生意的。",
            "nextDialogs": [
              "710630910",
              "710630912"
            ]
          },
          "710630910": {
            "id": "710630910",
            "speakerId": 1003,
            "speakerName": "自称「唐无仇」者",
            "text": "他就在层岩巨渊这附近，听说最近也还帮着卖宝石呢…",
            "nextDialogs": [
              "710630913"
            ]
          },
          "710630913": {
            "id": "710630913",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "#{NICKNAME}，如果那个人还在卖这样的玉石制品，肯定会有很多人都受到影响的。",
            "nextDialogs": [
              "710630914"
            ]
          },
          "710630914": {
            "id": "710630914",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "我们还是去看一下吧！"
          },
          "710630912": {
            "id": "710630912",
            "speakerId": 1003,
            "speakerName": "自称「唐无仇」者",
            "text": "我不知道他是不是还在卖，但是他就在这层岩巨渊附近…"
          }
        }
      }
    },
    {
      "subId": "7106311",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "710631101"
        ],
        "dialogs": {
          "710631101": {
            "id": "710631101",
            "speakerId": 1004,
            "speakerName": "老臭",
            "text": "来，让我看看你们都挖出了点啥？",
            "nextDialogs": [
              "710631102"
            ]
          },
          "710631102": {
            "id": "710631102",
            "speakerId": 1004,
            "speakerName": "老臭",
            "text": "哦，你们居然把这袋东西挖出来了…",
            "nextDialogs": [
              "710631103"
            ]
          },
          "710631103": {
            "id": "710631103",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "里面是什么呀…",
            "nextDialogs": [
              "710631104"
            ]
          },
          "710631104": {
            "id": "710631104",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "啊这些首饰，看上去真是…",
            "nextDialogs": [
              "710631105"
            ]
          },
          "710631105": {
            "id": "710631105",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "好丑。",
            "nextDialogs": [
              "710631106"
            ]
          },
          "710631106": {
            "id": "710631106",
            "speakerId": 1004,
            "speakerName": "老臭",
            "text": "就是盗宝团之前那些人做出来的，根本卖不出去。",
            "nextDialogs": [
              "710631107"
            ]
          },
          "710631107": {
            "id": "710631107",
            "speakerId": 1004,
            "speakerName": "老臭",
            "text": "不过好歹算是真材实料，把那上面的宝石抠下来也能值点钱…哎…",
            "nextDialogs": [
              "710631108"
            ]
          },
          "710631108": {
            "id": "710631108",
            "speakerId": 1004,
            "speakerName": "老臭",
            "text": "你们就把这个送给老唐吧。",
            "nextDialogs": [
              "710631109"
            ]
          },
          "710631109": {
            "id": "710631109",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "那我们就先走了！",
            "nextDialogs": [
              "710631110"
            ]
          },
          "710631110": {
            "id": "710631110",
            "speakerId": 1004,
            "speakerName": "老臭",
            "text": "嘿，要是有空的话，再来我这玩挖宝啊。",
            "nextDialogs": [
              "710631111"
            ]
          },
          "710631111": {
            "id": "710631111",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "#{NICKNAME}，我们现在就回去吗？"
          }
        }
      }
    },
    {
      "subId": "7106313",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "710631301"
        ],
        "dialogs": {
          "710631301": {
            "id": "710631301",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "待会儿再交给他吧…"
          }
        }
      }
    },
    {
      "subId": "7106314",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "710631401"
        ],
        "dialogs": {
          "710631401": {
            "id": "710631401",
            "speakerId": 1003,
            "speakerName": "自称「唐无仇」者",
            "text": "想不到啊，想不到啊，世间居然还有如鸟蛋大的宝石…"
          }
        }
      }
    },
    {
      "subId": "7106315",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "710631501"
        ],
        "dialogs": {
          "710631501": {
            "id": "710631501",
            "speakerId": 1004,
            "speakerName": "老臭",
            "text": "怎么样，不如现在来一局挖宝吧。你挖出的东西，就当给唐无仇作赔礼了。"
          }
        }
      }
    }
  ]
}
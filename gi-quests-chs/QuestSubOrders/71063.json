    {
      "subId": "7106305",
      "subQuestName": "将鸟蛋交给唐无仇以交换玉佩",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "710630501"
        ],
        "dialogs": {
          "710630501": {
            "id": "710630501",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "这个给你，换你那枚玉佩。",
            "nextDialogs": [
              "710630502"
            ]
          },
          "710630502": {
            "id": "710630502",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "这可是…这可是鸟蛋大小的宝石。",
            "nextDialogs": [
              "710630503"
            ]
          },
          "710630503": {
            "id": "710630503",
            "speakerId": 1000,
            "speakerName": "唐无仇",
            "text": "鸟蛋大小？我原本以为鸽子蛋大小的宝石已是登峰造极，没想到还有鸟蛋大小的宝石呢？",
            "nextDialogs": [
              "710630504"
            ]
          },
          "710630504": {
            "id": "710630504",
            "speakerId": 1000,
            "speakerName": "唐无仇",
            "text": "嘿嘿，拿一个玉佩换回如此大的一枚宝石，真是稳赚不赔啊！",
            "nextDialogs": [
              "710630505"
            ]
          },
          "710630505": {
            "id": "710630505",
            "speakerId": 1000,
            "speakerName": "唐无仇",
            "text": "这也多亏我古华派素有仁义之心…咳咳，看你们求宝心切，才愿意做这样的交易。",
            "nextDialogs": [
              "710630506"
            ]
          },
          "710630506": {
            "id": "710630506",
            "speakerId": 1002,
            "speakerName": "Black Screen",
            "text": "唐无仇将玉佩取下，递了过来…"
          }
        }
      }
    },
    {
      "subId": "7106306",
      "subQuestName": "与唐无仇对话",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [],

      }
    },
    {
      "subId": "7106312",
      "subQuestName": "与唐无仇对话",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "710630801"
        ],
        "dialogs": {
          "710630801": {
            "id": "710630801",
            "speakerId": 1003,
            "speakerName": "自称「唐无仇」者",
            "text": "这块玉佩你们就拿去吧，这么看来，你们也与我古华派有缘，得此至宝，也须小心珍重啊。",
            "nextDialogs": [
              "710630802"
            ]
          },
          "710630802": {
            "id": "710630802",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "刚才一脸不乐意的表情一瞬间就消失了。",
            "nextDialogs": [
              "710630803"
            ]
          },
          "710630803": {
            "id": "710630803",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "唔，这上面有很浓厚的岩元素之力…这不是「翠珏岩」吗！",
            "nextDialogs": [
              "710630804"
            ]
          },
          "710630804": {
            "id": "710630804",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "「翠珏岩」…我记得白术说过，说过，反正我原话记不住，总之就是说，会对人产生不好的影响。",
            "nextDialogs": [
              "710630805"
            ]
          },
          "710630805": {
            "id": "710630805",
            "speakerId": 1003,
            "speakerName": "自称「唐无仇」者",
            "text": "那不可能，这是我的朋友卖我的，我铁打的兄弟，啊，还能害我吗！",
            "nextDialogs": [
              "710630806"
            ]
          },
          "710630806": {
            "id": "710630806",
            "speakerId": 1003,
            "speakerName": "自称「唐无仇」者",
            "text": "而且我那朋友还有很多玉石打制的首饰…",
            "nextDialogs": [
              "710630807"
            ]
          },
          "710630807": {
            "id": "710630807",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "你的朋友？",
            "nextDialogs": [
              "710630808"
            ]
          },
          "710630808": {
            "id": "710630808",
            "speakerId": 1003,
            "speakerName": "自称「唐无仇」者",
            "text": "对啊，他叫老臭，一个做玉石生意的。",
            "nextDialogs": [
              "710630810",
              "710630812"
            ]
          },
          "710630810": {
            "id": "710630810",
            "speakerId": 1003,
            "speakerName": "自称「唐无仇」者",
            "text": "他就在层岩巨渊这附近，最近据说也还帮着卖玉石打制的首饰呢…",
            "nextDialogs": [
              "710630813"
            ]
          },
          "710630813": {
            "id": "710630813",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "#{NICKNAME}，如果那个人还在卖用「翠珏岩」做的首饰之类的话，肯定会有很多人都受到影响的。",
            "nextDialogs": [
              "710630814"
            ]
          },
          "710630814": {
            "id": "710630814",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "我们还是去看一下吧！"
          },
          "710630812": {
            "id": "710630812",
            "speakerId": 1003,
            "speakerName": "自称「唐无仇」者",
            "text": "我不知道他是不是还在卖，但是他就在层岩巨渊附近…"
          }
        }
      }
    },
    {
      "subId": "7106307",
      "subQuestName": "前去寻找老臭",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "710630601"
        ],
        "dialogs": {
          "710630601": {
            "id": "710630601",
            "speakerId": 1004,
            "speakerName": "老臭",
            "text": "哎呀，两位，找我有什么事吗？",
            "nextDialogs": [
              "710630602"
            ]
          },
          "710630602": {
            "id": "710630602",
            "speakerId": 1004,
            "speakerName": "老臭",
            "text": "你们是不是也想来玩挖宝的游戏…",
            "nextDialogs": [
              "710630603"
            ]
          },
          "710630603": {
            "id": "710630603",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "哼，今天我们俩过来，是有别的事要找你。",
            "nextDialogs": [
              "710630606"
            ]
          },
          "710630606": {
            "id": "710630606",
            "speakerId": 1004,
            "speakerName": "老臭",
            "text": "啊，这枚玉佩…",
            "nextDialogs": [
              "710630607"
            ]
          },
          "710630607": {
            "id": "710630607",
            "speakerId": 1004,
            "speakerName": "老臭",
            "text": "确确实实是从我这里脱手卖出去的…来，让我仔细看，这质地，这水润，这透亮，这不是我卖给唐无仇的那一枚嘛！",
            "nextDialogs": [
              "710630608"
            ]
          },
          "710630608": {
            "id": "710630608",
            "speakerId": 1004,
            "speakerName": "老臭",
            "text": "这枚玉佩的材质，看上去就和别的货不一样。",
            "nextDialogs": [
              "710630609"
            ]
          },
          "710630609": {
            "id": "710630609",
            "speakerId": 1004,
            "speakerName": "老臭",
            "text": "我当时还想靠着这个大赚一笔呢，结果被唐无仇一眼看中，赖死赖活的，就便宜卖给他了。",
            "nextDialogs": [
              "710630610"
            ]
          },
          "710630610": {
            "id": "710630610",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "这种材质的只有这一个？",
            "nextDialogs": [
              "710630611"
            ]
          },
          "710630611": {
            "id": "710630611",
            "speakerId": 1004,
            "speakerName": "老臭",
            "text": "我倒是还想再翻出来第二个呢。",
            "nextDialogs": [
              "710630612"
            ]
          },
          "710630612": {
            "id": "710630612",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "唉…幸好只有这一个，这个材质的矿石富含元素力，如果是没有「神之眼」的人接触了，就会性格大变，满嘴胡话…",
            "nextDialogs": [
              "710630613"
            ]
          },
          "710630613": {
            "id": "710630613",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "唐无仇现在以为自己是古华派的大侠，每天疯疯癫癫的。",
            "nextDialogs": [
              "710630614"
            ]
          },
          "710630614": {
            "id": "710630614",
            "speakerId": 1004,
            "speakerName": "老臭",
            "text": "啊？怎、怎么会这样。",
            "nextDialogs": [
              "710630615"
            ]
          },
          "710630615": {
            "id": "710630615",
            "speakerId": 1004,
            "speakerName": "老臭",
            "text": "仔细一看，这确实和传说中会让佩戴之人产生不适的「翠珏岩」十分相像。",
            "nextDialogs": [
              "710630616"
            ]
          },
          "710630616": {
            "id": "710630616",
            "speakerId": 1004,
            "speakerName": "老臭",
            "text": "以前就曾听老一辈人说过，说是「翠珏岩」虽然宝贵，但要是长时间贴身携带，往往携带者都会遭受厄运，邪门的很。",
            "nextDialogs": [
              "710630617"
            ]
          },
          "710630617": {
            "id": "710630617",
            "speakerId": 1004,
            "speakerName": "老臭",
            "text": "是我害了老唐啊！",
            "nextDialogs": [
              "710630618"
            ]
          },
          "710630618": {
            "id": "710630618",
            "speakerId": 1004,
            "speakerName": "老臭",
            "text": "唉，我和唐无仇以前都是盗宝团的，之前在层岩巨渊干了一票，大家决定分道扬镳。",
            "nextDialogs": [
              "710630619"
            ]
          },
          "710630619": {
            "id": "710630619",
            "speakerId": 1004,
            "speakerName": "老臭",
            "text": "唐无仇不知道跑哪去了，可是我…唉，我被以前盗宝团的人找到，受他们胁迫，买他们在这做的劣质首饰在璃月转手卖出。",
            "nextDialogs": [
              "710630620"
            ]
          },
          "710630620": {
            "id": "710630620",
            "speakerId": 1004,
            "speakerName": "老臭",
            "text": "美其名曰帮忙销售，可是他们做的…是材料比得上「盛露厅」啊，还是造型打制比得上「明星斋」？",
            "nextDialogs": [
              "710630621"
            ]
          },
          "710630621": {
            "id": "710630621",
            "speakerId": 1004,
            "speakerName": "老臭",
            "text": "还不是要我给他们做出来的玩意儿兜底。",
            "nextDialogs": [
              "710630622"
            ]
          },
          "710630622": {
            "id": "710630622",
            "speakerId": 1004,
            "speakerName": "老臭",
            "text": "可怜我是低价再低价，赔了本，才卖得出去。",
            "nextDialogs": [
              "710630623"
            ]
          },
          "710630623": {
            "id": "710630623",
            "speakerId": 1004,
            "speakerName": "老臭",
            "text": "之前赚的钱全都赔了进去…好在那群爷可能醒悟过来，直接卖材料还卖得贵些，最近终于不来找我了。",
            "nextDialogs": [
              "710630624"
            ]
          },
          "710630624": {
            "id": "710630624",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "他们都被潜入的千岩军剿了。",
            "nextDialogs": [
              "710630625"
            ]
          },
          "710630625": {
            "id": "710630625",
            "speakerId": 1002,
            "speakerName": "Black Screen",
            "text": "向老臭告知千岩军捣毁走私窝点的始末…",
            "nextDialogs": [
              "710630626"
            ]
          },
          "710630626": {
            "id": "710630626",
            "speakerId": 1004,
            "speakerName": "老臭",
            "text": "剿得好啊！",
            "nextDialogs": [
              "710630627"
            ]
          },
          "710630627": {
            "id": "710630627",
            "speakerId": 1004,
            "speakerName": "老臭",
            "text": "说要向千岩军告我的案底，哼，这下自己进去了吧。",
            "nextDialogs": [
              "710630628"
            ]
          },
          "710630628": {
            "id": "710630628",
            "speakerId": 1004,
            "speakerName": "老臭",
            "text": "唉，说远了…唐无仇的事我也很抱歉，但是我现在值钱的东西，都、都被我埋在土堆里了，好做些小生意赚点钱。",
            "nextDialogs": [
              "710630629"
            ]
          },
          "710630629": {
            "id": "710630629",
            "speakerId": 1004,
            "speakerName": "老臭",
            "text": "不如这样，这次就让你们挖一次宝，挖出什么，就带给唐无仇算作赔礼吧。",
            "nextDialogs": [
              "710630630"
            ]
          },
          "710630630": {
            "id": "710630630",
            "speakerId": 1004,
            "speakerName": "老臭",
            "text": "怎么样，要不要听一下这个挖宝怎么玩？"
          }
        }
      }
    },

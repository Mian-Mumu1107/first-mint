        "dialogs": {
          "200391201": {
            "id": "200391201",
            "speakerId": 1587,
            "speakerName": "蒂玛乌斯",
            "text": "已经制作好了。",
            "nextDialogs": [
              "200391202"
            ]
          },
          "200391202": {
            "id": "200391202",
            "speakerId": 1587,
            "speakerName": "蒂玛乌斯",
            "text": "这个味道，确实是烈火精油！光是拿着就能感受到灼热。",
            "nextDialogs": [
              "200391203"
            ]
          },
          "200391203": {
            "id": "200391203",
            "speakerId": 1587,
            "speakerName": "蒂玛乌斯",
            "text": "但是，只要将「烈火精油」配方中的青蛙变为蝴蝶翅膀…",
            "nextDialogs": [
              "200391204"
            ]
          },
          "200391204": {
            "id": "200391204",
            "speakerId": 1587,
            "speakerName": "蒂玛乌斯",
            "text": "你看，一份可靠的「耐热药剂」，如果想在高温中行动自如，可全指望它了。",
            "nextDialogs": [
              "200391205"
            ]
          },
          "200391205": {
            "id": "200391205",
            "speakerId": 1587,
            "speakerName": "蒂玛乌斯",
            "text": "同样是烈焰花花蕊，在炼金术下，却能展现出这样截然相反的两面。",
            "nextDialogs": [
              "200391206"
            ]
          },
          "200391206": {
            "id": "200391206",
            "speakerId": 1587,
            "speakerName": "蒂玛乌斯",
            "text": "「耐热药剂」给你，拿去感受一下炼金术的魅力吧。"
          }
        }
      }
    },

  "subQuests": [
    {
      "subId": "2003901",
      "subQuestName": "与蒂玛乌斯对话",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "200390101"
        ],
        "dialogs": {
          "200390101": {
            "id": "200390101",
            "speakerId": 1587,
            "speakerName": "蒂玛乌斯",
            "text": "想感受一下炼金术。",
            "nextDialogs": [
              "200390102"
            ]
          },
          "200390102": {
            "id": "200390102",
            "speakerId": 1587,
            "speakerName": "蒂玛乌斯",
            "text": "古代的炼金术真是奇妙…真希望能让更多人了解。",
            "nextDialogs": [
              "200390103"
            ]
          },
          "200390103": {
            "id": "200390103",
            "speakerId": 1587,
            "speakerName": "蒂玛乌斯",
            "text": "嗯？你也对炼金术感兴趣吗？",
            "nextDialogs": [
              "200390104"
            ]
          },
          "200390104": {
            "id": "200390104",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "很感兴趣。",
            "nextDialogs": [
              "200390105"
            ]
          },
          "200390105": {
            "id": "200390105",
            "speakerId": 1587,
            "speakerName": "蒂玛乌斯",
            "text": "那么你就来亲手尝试一下炼金术吧。",
            "nextDialogs": [
              "200390106"
            ]
          },
          "200390106": {
            "id": "200390106",
            "speakerId": 1587,
            "speakerName": "蒂玛乌斯",
            "text": "任何伟大的成就，都是从扎实的基础中生发而出。"
          }
        }
      }
    },
    {
      "subId": "2003904",
      "subQuestName": "(test)巩固-惊雷精油$HIDDEN",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "200390401"
        ],
        "dialogs": {
          "200390401": {
            "id": "200390401",
            "speakerId": 1587,
            "speakerName": "蒂玛乌斯",
            "text": "你先试试制作一份「惊雷精油」吧。",
            "nextDialogs": [
              "200390402"
            ]
          },
          "200390402": {
            "id": "200390402",
            "speakerId": 1587,
            "speakerName": "蒂玛乌斯",
            "text": "它是最基础的炼金产物。最适合入门练手了。",
            "nextDialogs": [
              "200390403"
            ]
          },
          "200390403": {
            "id": "200390403",
            "speakerId": 1587,
            "speakerName": "蒂玛乌斯",
            "text": "想要炼成「惊雷精油」，需要的原料是电气水晶和青蛙。",
            "nextDialogs": [
              "200390404"
            ]
          },
          "200390404": {
            "id": "200390404",
            "speakerId": 1587,
            "speakerName": "蒂玛乌斯",
            "text": "这两种材料都能在城外找到…什么？「水晶」听起来和「精油」没关系？",
            "nextDialogs": [
              "200390405"
            ]
          },
          "200390405": {
            "id": "200390405",
            "speakerId": 1587,
            "speakerName": "蒂玛乌斯",
            "text": "哈哈哈，当然，因为电气水晶负责「惊雷」，「精油」的关键是青蛙啊。",
            "nextDialogs": [
              "200390406"
            ]
          },
          "200390406": {
            "id": "200390406",
            "speakerId": 1587,
            "speakerName": "蒂玛乌斯",
            "text": "找齐材料之后，你就开始尝试炼制「惊雷精油」吧。大胆地尝试，我会在旁边看着你的。",
            "nextDialogs": [
              "200390407"
            ]
          },
          "200390407": {
            "id": "200390407",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "我知道了。"
          }
        }
      }
    },
    {

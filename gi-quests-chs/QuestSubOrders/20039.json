        "dialogs": {
          "200391001": {
            "id": "200391001",
            "speakerId": 1587,
            "speakerName": "蒂玛乌斯",
            "text": "已经制作好了。",
            "nextDialogs": [
              "200391002"
            ]
          },
          "200391002": {
            "id": "200391002",
            "speakerId": 1587,
            "speakerName": "蒂玛乌斯",
            "text": "做得好，这确实是惊雷精油，能帮助人们更轻松地导出雷元素。",
            "nextDialogs": [
              "200391003"
            ]
          },
          "200391003": {
            "id": "200391003",
            "speakerId": 1587,
            "speakerName": "蒂玛乌斯",
            "text": "但是，只要将「惊雷精油」配方中的青蛙变为蝴蝶翅膀…",
            "nextDialogs": [
              "200391004"
            ]
          },
          "200391004": {

            ]
          },
          "200391005": {
            "id": "200391005",
            "speakerId": 1587,
            "speakerName": "蒂玛乌斯",
            "text": "同样是电气水晶，在炼金术下，却能展现出这样截然相反的两面。",
            "nextDialogs": [
              "200391006"
            ]
          },
          "200391006": {
            "id": "200391006",
            "speakerId": 1587,
            "speakerName": "蒂玛乌斯",
            "text": "「绝缘药剂」给你，拿去感受一下炼金术的魅力吧。"
          }

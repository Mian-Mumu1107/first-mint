  "subQuests": [
    {
      "subId": "35301",
      "subQuestName": "与派蒙对话",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "3532801"
        ],
        "dialogs": {
          "3532801": {
            "id": "3532801",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "呀，是不是感受到这个世界的「元素」了？",
            "nextDialogs": [
              "3532802"
            ]
          },
          "3532802": {
            "id": "3532802",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "看起来，你只要触碰神像，就能获得「风」的元素力呢。",
            "nextDialogs": [
              "3532803"
            ]
          },
          "3532803": {
            "id": "3532803",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "这个世界的人想要获得力量，绝对不可能像你这样轻松…",
            "nextDialogs": [
              "3532805",
              "3532808"
            ]
          },
          "3532805": {
            "id": "3532805",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "嗯，因为你本来就不是这个世界的人嘛。",
            "nextDialogs": [
              "3532809"
            ]
          },
          "3532809": {
            "id": "3532809",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "从这里向西走，就可以抵达自由城邦「蒙德」。",
            "nextDialogs": [
              "3532817"
            ]
          },
          "3532817": {
            "id": "3532817",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "蒙德是「风」的城市，在七神中供奉的正是风神。",
            "nextDialogs": [
              "3532810"
            ]
          },
          "3532810": {
            "id": "3532810",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "能从神像获得力量的你，会不会在那里找到神的线索呢…？",
            "nextDialogs": [
              "3532811"
            ]
          },
          "3532811": {
            "id": "3532811",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "#而且，蒙德有很多吟游诗人，说不定能打听到你{MATEAVATAR#SEXPRO[INFO_MALE_PRONOUN_BROTHER|INFO_FEMALE_PRONOUN_SISTER]}的消息。",
            "nextDialogs": [
              "3532812"
            ]
          },
          "3532812": {
            "id": "3532812",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "好，那就出发吧！",
            "nextDialogs": [
              "3532813"
            ]
          },
          "3532813": {
            "id": "3532813",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "这个世界的「元素」回应了祈愿，我觉得这算是一个好兆头哦。"
          },
          "3532808": {
            "id": "3532808",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "「邪门」这种词对神灵真是太不尊重了！"
          }
        }
      }
    },

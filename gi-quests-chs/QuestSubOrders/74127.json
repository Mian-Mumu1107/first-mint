      }
    },
    {
      "subId": "7412707",
      "subQuestName": "打倒所有失控的机关",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [],
        "dialogs": {}
      }
    },
    {
      "subId": "7412702",
      "subQuestName": "与艾尤恩对话",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "741270201"
        ],
        "dialogs": {
          "741270201": {
            "id": "741270201",
            "speakerId": 5084,
            "speakerName": "艾尤恩",
            "text": "呃…这里就是「玛丽安纪念公园」吗？完全看不出来公园的样子…",
            "nextDialogs": [
              "741270202"
            ]
          },
          "741270202": {
            "id": "741270202",
            "speakerId": 5084,
            "speakerName": "艾尤恩",
            "text": "洛耶茨先生肯定要失望了，他还打算请人来这里做个演讲呢。",
            "nextDialogs": [
              "741270203"
            ]
          },
          "741270203": {
            "id": "741270203",
            "speakerId": 5084,
            "speakerName": "艾尤恩",
            "text": "看看这环境，演讲应该是做不成了…而且连标志性建筑都没有，合影也合不成。",
            "nextDialogs": [
              "741270204"
            ]
          },
          "741270204": {
            "id": "741270204",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "可以抓点机关回去做纪念品。",
            "nextDialogs": [
              "741270205"
            ]
          },
          "741270205": {
            "id": "741270205",
            "speakerId": 5084,
            "speakerName": "艾尤恩",
            "text": "哈哈哈，您真幽默。但复律庭里可没地方放这种东西。",
            "nextDialogs": [
              "741270206"
            ]
          },
          "741270206": {
            "id": "741270206",
            "speakerId": 5084,
            "speakerName": "艾尤恩",
            "text": "而且就算抓回去了，我还得把这机关拿去估价、备案、分类、然后再封存…",
            "nextDialogs": [
              "741270207"
            ]
          },
          "741270207": {
            "id": "741270207",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "喂！我们就是开个玩笑，不要突然这么认真地开始思考工作的事啊！",
            "nextDialogs": [
              "741270208"
            ]
          },
          "741270208": {
            "id": "741270208",
            "speakerId": 5084,
            "speakerName": "艾尤恩",
            "text": "说起备案…我还是没把那份文件拿到，洛耶茨先生肯定又要叹气了…",
            "nextDialogs": [
              "741270210"
            ]
          },
          "741270210": {
            "id": "741270210",
            "speakerId": 5084,
            "speakerName": "艾尤恩",
            "text": "也谈不上为难，我…我的请求确实有些违反规定了，他不答应是很正常的事。",
            "nextDialogs": [
              "741270212"
            ]
          },
          "741270212": {
            "id": "741270212",
            "speakerId": 5084,
            "speakerName": "艾尤恩",
            "text": "事情是这样的。枫丹科学院不是正在筹划重建工作吗？一些物资和人员调配需要通过复律庭来沟通…",
            "nextDialogs": [
              "741270213"
            ]
          },
          "741270213": {
            "id": "741270213",
            "speakerId": 5084,
            "speakerName": "艾尤恩",
            "text": "复律庭很重视这件事，于是就让洛耶茨先生组织一支考察队，准备来科学院附近实地考察一下。",
            "nextDialogs": [
              "741270214"
            ]
          },
          "741270214": {
            "id": "741270214",
            "speakerId": 5084,
            "speakerName": "艾尤恩",
            "text": "于是，洛耶茨先生留在复律庭里统计人员，我则来科学院协调接待事宜。",
            "nextDialogs": [
              "741270215"
            ]
          },
          "741270215": {
            "id": "741270215",
            "speakerId": 5084,
            "speakerName": "艾尤恩",
            "text": "正好科学院要寄一份信函回复律庭，我就想着，既然我都来这边了，就顺便把信带回去吧…",
            "nextDialogs": [
              "741270216"
            ]
          },
          "741270216": {
            "id": "741270216",
            "speakerId": 5084,
            "speakerName": "艾尤恩",
            "text": "但舒瓦瑟尔先生却说，这种行为不符合规定，怎么说都不给我。",
            "nextDialogs": [
              "741270217"
            ]
          },
          "741270217": {
            "id": "741270217",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "不符合规定？又是不符合哪一条规定呀？",
            "nextDialogs": [
              "741270218"
            ]
          },
          "741270218": {
            "id": "741270218",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "取一个文件都有规定？",
            "nextDialogs": [
              "741270219"
            ]
          },
          "741270219": {
            "id": "741270219",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "呜哇，难道又是那些跑来跑去盖章、到处签字、最后听人啰啰嗦嗦之类的事情吗？",
            "nextDialogs": [
              "741270220"
            ]
          },
          "741270220": {
            "id": "741270220",
            "speakerId": 5084,
            "speakerName": "艾尤恩",
            "text": "简单来说，复律庭内大部分的公务信函往来，都必须要使用「信件投递」的模式。",
            "nextDialogs": [
              "741270221"
            ]
          },
          "741270221": {
            "id": "741270221",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "欸？那…那假如要寄信的部门，相距就一条街，或者干脆就是对门呢？",
            "nextDialogs": [
              "741270222"
            ]
          },
          "741270222": {
            "id": "741270222",
            "speakerId": 5084,
            "speakerName": "艾尤恩",
            "text": "…那也要用信件投递。这是为了保证复律庭内所有公务函件的「可追溯性」。",
            "nextDialogs": [
              "741270223"
            ]
          },
          "741270223": {
            "id": "741270223",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "他们是真不嫌麻烦。",
            "nextDialogs": [
              "741270224"
            ]
          },
          "741270224": {
            "id": "741270224",
            "speakerId": 5084,
            "speakerName": "艾尤恩",
            "text": "我猜想，大家应该已经麻烦惯了吧…",
            "nextDialogs": [
              "741270225"
            ]
          },
          "741270225": {
            "id": "741270225",
            "speakerId": 5084,
            "speakerName": "艾尤恩",
            "text": "算了，先不谈这些。我们去下一个地方吧，让我看看洛耶茨先生写给我的备忘录…呃…",
            "nextDialogs": [
              "741270226"
            ]
          },
          "741270226": {
            "id": "741270226",
            "speakerId": 5084,
            "speakerName": "艾尤恩",
            "text": "这个地方叫…枫丹科学院的「学术会堂」。真奇怪，我来的时候没见到挂这牌子的建筑啊。",
            "nextDialogs": [
              "741270227"
            ]
          },
          "741270227": {
            "id": "741270227",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "我知道在哪，你跟着我走吧。",
            "nextDialogs": [
              "741270228"
            ]
          },
          "741270228": {
            "id": "741270228",
            "speakerId": 5084,
            "speakerName": "艾尤恩",
            "text": "您真是可靠！一如既往的可靠，没了您我还怎么工作呀。",
            "nextDialogs": [
              "741270229"
            ]
          },
          "741270229": {
            "id": "741270229",
            "speakerId": 5084,
            "speakerName": "艾尤恩",
            "text": "那咱们就快点出发吧，说不定这周围还有更多失控的机关呢…"
          }
        }
      }
    },
    {
      "subId": "7412703",
      "subQuestName": "前往「学术会堂」",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "741270301"
        ],
        "dialogs": {
          "741270301": {
            "id": "741270301",
            "speakerId": 5084,
            "speakerName": "艾尤恩",
            "text": "这就是枫丹科学院的「学术会堂」？",
            "nextDialogs": [
              "741270302"
            ]
          },
          "741270302": {
            "id": "741270302",
            "speakerId": 5084,
            "speakerName": "艾尤恩",
            "text": "我承认，这建筑看上去确实挺像「会堂」的，但学术在哪里？",
            "nextDialogs": [
              "741270305"
            ]
          },
          "741270305": {
            "id": "741270305",
            "speakerId": 5084,
            "speakerName": "艾尤恩",
            "text": "好吧，幸好我今天不是为了学术而来的。无论如何，这个建筑看着还挺…完整。",
            "nextDialogs": [
              "741270306"
            ]
          },
          "741270306": {
            "id": "741270306",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "也就剩下完整了。",
            "nextDialogs": [
              "741270307"
            ]
          },
          "741270307": {
            "id": "741270307",
            "speakerId": 5084,
            "speakerName": "艾尤恩",
            "text": "咳！来吧，咱们去周围逛逛，我觉得这里肯定很适合来一张合影。",
            "nextDialogs": [
              "741270308"
            ]
          },
          "741270308": {
            "id": "741270308",
            "speakerId": 5084,
            "speakerName": "艾尤恩",
            "text": "我得先去找个好角度，免得到时候洛耶茨先生问起来，我又手忙脚乱。",
            "nextDialogs": [
              "741270309"
            ]
          },
          "741270309": {
            "id": "741270309",
            "speakerId": 5084,
            "speakerName": "艾尤恩",
            "text": "#{NICKNAME}，请您也帮我去拍几张画片吧。我听说您很擅长留影，拍得肯定比我好！",
            "nextDialogs": [
              "741270310"
            ]
          },
          "741270310": {
            "id": "741270310",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "交给我了。"
          }
        }
      }
    },
    {
      "subId": "7412708",
      "subQuestName": "去周围拍摄画片，并交给艾尤恩",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [],
        "dialogs": {}
      }
    },
    {
      "subId": "7412709",
      "subQuestName": "去周围拍摄画片，并交给艾尤恩",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "741270901"
        ],
        "dialogs": {
          "741270901": {
            "id": "741270901",
            "speakerId": 5084,
            "speakerName": "艾尤恩",
            "text": "这张还行…欸，您已经拍好画片了吗？",
            "nextDialogs": [
              "741270904"
            ]
          },
          "741270904": {
            "id": "741270904",
            "speakerId": 5084,
            "speakerName": "艾尤恩",
            "text": "您拍好画片之后，就请拿来给我吧。"
          }
        }
      }
    },
    {
      "subId": "7412704",
      "subQuestName": "和艾尤恩对话",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "741270401"
        ],
        "dialogs": {
          "741270401": {
            "id": "741270401",
            "speakerId": 5084,
            "speakerName": "艾尤恩",
            "text": "天哪…真是太高了，太高了！",
            "nextDialogs": [
              "741270402"
            ]
          },
          "741270402": {
            "id": "741270402",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "你是在描述科学院的学术水平吗？",
            "nextDialogs": [
              "741270403"
            ]
          },
          "741270403": {
            "id": "741270403",
            "speakerId": 5084,
            "speakerName": "艾尤恩",
            "text": "不，我就是在说这里的高度，虽然之前科学院的学术水平确实也不低啦…",
            "nextDialogs": [
              "741270404"
            ]
          },
          "741270404": {
            "id": "741270404",
            "speakerId": 5084,
            "speakerName": "艾尤恩",
            "text": "至于现在…唉，谁又想得到科学院会遭那么多罪呢？也不知道重建工作能不能顺利进行…",
            "nextDialogs": [
              "741270405"
            ]
          },
          "741270405": {
            "id": "741270405",
            "speakerId": 5084,
            "speakerName": "艾尤恩",
            "text": "最后一站是…「枫丹科学院驻外资质审核办公室」。",
            "nextDialogs": [
              "741270406"
            ]
          },
          "741270406": {
            "id": "741270406",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "亏你能一口气念下来…",
            "nextDialogs": [
              "741270407"
            ]
          },
          "741270407": {
            "id": "741270407",
            "speakerId": 5084,
            "speakerName": "艾尤恩",
            "text": "多谢您的夸奖。但是这地方在哪？我在科学院里并没有发现这个办公室啊？",
            "nextDialogs": [
              "741270408"
            ]
          },
          "741270408": {
            "id": "741270408",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "办公室的负责人是德斯诺斯吗？",
            "nextDialogs": [
              "741270409"
            ]
          },
          "741270409": {
            "id": "741270409",
            "speakerId": 5084,
            "speakerName": "艾尤恩",
            "text": "对！没错，这地方您也知道？果然不愧是科学院的荣誉高级研究员，简直是科学院万事通啊。",
            "nextDialogs": [
              "741270410"
            ]
          },
          "741270410": {
            "id": "741270410",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "喔…我也记起来了！是那个在废墟里的办公室？如果…那也算办公室的话…",
            "nextDialogs": [
              "741270411"
            ]
          },
          "741270411": {
            "id": "741270411",
            "speakerId": 5084,
            "speakerName": "艾尤恩",
            "text": "也许是德斯诺斯先生为了方便您理解，将前面的前缀都暂时省略了。",
            "nextDialogs": [
              "741270412"
            ]
          },
          "741270412": {
            "id": "741270412",
            "speakerId": 5084,
            "speakerName": "艾尤恩",
            "text": "请您带路吧，我得去那边找德斯诺斯先生拿一些文件，拿完文件后，我就可以回复律庭了。",
            "nextDialogs": [
              "741270413"
            ]
          },
          "741270413": {
            "id": "741270413",
            "speakerId": 5084,
            "speakerName": "艾尤恩",
            "text": "今天可真是顺利，我马上就可以回去歇着了。枫丹科学院的作风果然不同于…咳，我、我什么都没说…"
          }
        }
      }
    },
    {
      "subId": "7412705",
      "subQuestName": "前往「驻外资质审核办公室」",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "741270501"
        ],
        "dialogs": {
          "741270501": {
            "id": "741270501",
            "speakerId": 5253,
            "speakerName": "德斯诺斯",
            "text": "老天保佑，那些机关可别再来捣乱了…艾尤恩，你怎么来这里了？",
            "nextDialogs": [
              "741270502"
            ]
          },
          "741270502": {
            "id": "741270502",
            "speakerId": 5084,
            "speakerName": "艾尤恩",
            "text": "洛耶茨先生让我来这里考察，我就顺便过来看看您，再给您带些咖啡过来。",
            "nextDialogs": [
              "741270503"
            ]
          },
          "741270503": {
            "id": "741270503",
            "speakerId": 5084,
            "speakerName": "艾尤恩",
            "text": "但不得不说，您工作的环境确实…颇为艰苦，我还以为这「办事处」至少有一间正经屋子呢。",
            "nextDialogs": [
              "741270504"
            ]
          },
          "741270504": {
            "id": "741270504",
            "speakerId": 5253,
            "speakerName": "德斯诺斯",
            "text": "亲爱的艾尤恩，谢谢你的咖啡，至于工作环境…我已经知足了。你看看这周围，我至少找到了一个完整的天花板嘛。",
            "nextDialogs": [
              "741270505"
            ]
          },
          "741270505": {
            "id": "741270505",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "你还在这里负责资质审核的工作吗？",
            "nextDialogs": [
              "741270506"
            ]
          },
          "741270506": {
            "id": "741270506",
            "speakerId": 5253,
            "speakerName": "德斯诺斯",
            "text": "#{NICKNAME}！不…应该叫您，荣誉高级研究员，真高兴见到您。",
            "nextDialogs": [
              "741270507"
            ]
          },
          "741270507": {
            "id": "741270507",
            "speakerId": 5253,
            "speakerName": "德斯诺斯",
            "text": "艾尤恩，你怎么满脸愁容，发生什么了？",
            "nextDialogs": [
              "741270508"
            ]
          },
          "741270508": {
            "id": "741270508",
            "speakerId": 5084,
            "speakerName": "艾尤恩",
            "text": "唉…事情是这样的…",
            "nextDialogs": [
              "741270509"
            ]
          },
          "741270509": {
            "id": "741270509",
            "speakerId": 1004,
            "speakerName": "Black Screen",
            "text": "艾尤恩满脸愁容地讲述了之前的事…",
            "nextDialogs": [
              "741270510"
            ]
          },
          "741270510": {
            "id": "741270510",
            "speakerId": 5253,
            "speakerName": "德斯诺斯",
            "text": "咦？这信函…是什么重要的秘密文件吗？",
            "nextDialogs": [
              "741270511"
            ]
          },
          "741270511": {
            "id": "741270511",
            "speakerId": 5084,
            "speakerName": "艾尤恩",
            "text": "不会呀，这种回函里信件的信息一般也就是说一些「我知道了」、「我没问题」、「我不知道」之类的话…",
            "nextDialogs": [
              "741270512"
            ]
          },
          "741270512": {
            "id": "741270512",
            "speakerId": 5084,
            "speakerName": "艾尤恩",
            "text": "最多抄送给其他部门，告诉大家有这么一件事值得在意。",
            "nextDialogs": [
              "741270513"
            ]
          },
          "741270513": {
            "id": "741270513",
            "speakerId": 5253,
            "speakerName": "德斯诺斯",
            "text": "喔，那怪不得我也接到了这封信…你看看，是这个吗？",
            "nextDialogs": [
              "741270514"
            ]
          },
          "741270514": {
            "id": "741270514",
            "speakerId": 5084,
            "speakerName": "艾尤恩",
            "text": "什、什么？！舒瓦瑟尔先生明明和我说，他还没寄出去！",
            "nextDialogs": [
              "741270515"
            ]
          },
          "741270515": {
            "id": "741270515",
            "speakerId": 5084,
            "speakerName": "艾尤恩",
            "text": "…喔，他说的是「对外的信件」还没寄出去。",
            "nextDialogs": [
              "741270516"
            ]
          },
          "741270516": {
            "id": "741270516",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "这家伙又没把话说全。",
            "nextDialogs": [
              "741270517"
            ]
          },
          "741270517": {
            "id": "741270517",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "枫丹科学院的人…还是这么擅长让人不开心…",
            "nextDialogs": [
              "741270518"
            ]
          },
          "741270518": {
            "id": "741270518",
            "speakerId": 5253,
            "speakerName": "德斯诺斯",
            "text": "看你的脸色，这一定就是你要的那份文件，而且我都看完了好几遍了。",
            "nextDialogs": [
              "741270519"
            ]
          },
          "741270519": {
            "id": "741270519",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "这和你要的那份文件一模一样。",
            "nextDialogs": [
              "741270520"
            ]
          },
          "741270520": {
            "id": "741270520",
            "speakerId": 5253,
            "speakerName": "德斯诺斯",
            "text": "#啊哈，{NICKNAME}非常敏锐。艾尤恩，舒瓦瑟尔寄出去的所有信件，肯定全都是一模一样。",
            "nextDialogs": [
              "741270521"
            ]
          },
          "741270521": {
            "id": "741270521",
            "speakerId": 5253,
            "speakerName": "德斯诺斯",
            "text": "你为什么不直接把我的这份文件拿回去呢？",
            "nextDialogs": [
              "741270522"
            ]
          },
          "741270522": {
            "id": "741270522",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "欸？等一下，要是艾尤恩拿走了文件，你不就没有了吗？",
            "nextDialogs": [
              "741270523"
            ]
          },
          "741270523": {
            "id": "741270523",
            "speakerId": 5253,
            "speakerName": "德斯诺斯",
            "text": "哈哈哈哈哈，你瞧瞧我这位置，没人会在意我不小心弄丢了一封可有可无的信函的。",
            "nextDialogs": [
              "741270526"
            ]
          },
          "741270526": {
            "id": "741270526",
            "speakerId": 5253,
            "speakerName": "德斯诺斯",
            "text": "你瞧，我可不会白喝你的咖啡啊，艾尤恩。",
            "nextDialogs": [
              "741270527"
            ]
          },
          "741270527": {
            "id": "741270527",
            "speakerId": 5084,
            "speakerName": "艾尤恩",
            "text": "不，先生，我不会这么做，这不符合规定。我会回去等着正式信件送到手里的。",
            "nextDialogs": [
              "741270528"
            ]
          },
          "741270528": {
            "id": "741270528",
            "speakerId": 5253,
            "speakerName": "德斯诺斯",
            "text": "天哪…艾尤恩！脑筋灵活点，别做傻瓜。你为什么非得折腾自己呢？",
            "nextDialogs": [
              "741270529"
            ]
          },
          "741270529": {
            "id": "741270529",
            "speakerId": 5253,
            "speakerName": "德斯诺斯",
            "text": "那封信天知道什么时候才能送到你手里。早一天拿到信件，你就可以早一天开工，尽快了结那些麻烦事。",
            "nextDialogs": [
              "741270530"
            ]
          },
          "741270530": {
            "id": "741270530",
            "speakerId": 5084,
            "speakerName": "艾尤恩",
            "text": "不，先生，谢谢您的好意，但我不会违反规定的。我的职责要求我这么做。",
            "nextDialogs": [
              "741270531"
            ]
          },
          "741270531": {
            "id": "741270531",
            "speakerId": 5084,
            "speakerName": "艾尤恩",
            "text": "#{NICKNAME}，德斯诺斯先生，还有派蒙。我就先告辞了，洛耶茨先生还在等着我回报呢。",
            "nextDialogs": [
              "741270532"
            ]
          },
          "741270532": {
            "id": "741270532",
            "speakerId": 1004,
            "speakerName": "Black Screen",
            "text": "艾尤恩迈着沉重的步伐离开了…",
            "nextDialogs": [
              "741270533"
            ]
          },
          "741270533": {
            "id": "741270533",
            "speakerId": 5253,
            "speakerName": "德斯诺斯",
            "text": "…唉，艾尤恩这傻瓜，满脑子都是死脑筋。",
            "nextDialogs": [
              "741270534"
            ]
          },
          "741270534": {
            "id": "741270534",
            "speakerId": 5253,
            "speakerName": "德斯诺斯",
            "text": "大家都想着法让自己好过一些，他为什么非得这么折腾自己呢？这又不是什么大事。"
          }
        }
      }
    },
    {
      "subId": "7412751",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "741275101"
        ],
        "dialogs": {
          "741275101": {
            "id": "741275101",
            "speakerId": 5258,
            "speakerName": "舒瓦瑟尔",
            "text": "雷蒙多还没有回来…这人到底去做什么了…"
          }
        }
      }
    },
    {
      "subId": "7412799",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "741279901"
        ],
        "dialogs": {
          "741279901": {
            "id": "741279901",
            "speakerId": 5084,
            "speakerName": "艾尤恩",
            "text": "那一堆机关看起来像是失控了，我来的时候就注意到了。",
            "nextDialogs": [
              "741279902"
            ]
          },
          "741279902": {
            "id": "741279902",
            "speakerId": 5084,
            "speakerName": "艾尤恩",
            "text": "为了绕开它们，我还专门选了一条远路…",
            "nextDialogs": [
              "741279903"
            ]
          },
          "741279903": {
            "id": "741279903",
            "speakerId": 5084,
            "speakerName": "艾尤恩",
            "text": "唉，枫丹科学院就放任它们在这里失控，也不去管管…"
          }
        }
      }
    }
  ]
}
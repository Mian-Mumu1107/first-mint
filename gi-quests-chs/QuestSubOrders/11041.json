        "startDialogs": [],
        "dialogs": {}
      }
    },
    {
      "subId": "1104106",
      "subQuestName": "与阿贝多交谈",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "110410601"
        ],
        "dialogs": {
          "110410601": {
            "id": "110410601",
            "speakerId": 1002,
            "speakerName": "阿贝多",
            "text": "你们是谁？为什么要惊扰它们？",
            "nextDialogs": [
              "110410602"
            ]
          },
          "110410602": {
            "id": "110410602",
            "speakerId": 1002,
            "speakerName": "阿贝多",
            "text": "幸好我的画已经完成，要是没能为特别的丘丘人收尾，就太可惜了。",
            "nextDialogs": [
              "110410605"
            ]
          },
          "110410605": {
            "id": "110410605",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "不过，丘丘人有什么好画的，不都长得差不多吗？",
            "nextDialogs": [
              "110410606"
            ]
          },
          "110410606": {
            "id": "110410606",
            "speakerId": 1002,
            "speakerName": "阿贝多",
            "text": "嗯…这个问题解释起来比较复杂，不如请你们直接看看我的画吧。"
          }
        }
      }
    }
  ]

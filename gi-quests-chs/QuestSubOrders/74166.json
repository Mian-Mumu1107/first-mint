      }
    },
    {
      "subId": "7416602",
      "subQuestName": "与奇怪的人对话$HIDDEN",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "741660201"
        ],
        "dialogs": {
          "741660201": {
            "id": "741660201",
            "speakerId": 1000,
            "speakerName": "奇怪的人",
            "text": "#那边的{M#小哥}{F#小妹}，对对，就是你，就是你，来来来。",
            "nextDialogs": [
              "741660202"
            ]
          },
          "741660202": {
            "id": "741660202",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "嗯？你在叫我们吗？",
            "nextDialogs": [
              "741660203"
            ]
          },
          "741660203": {
            "id": "741660203",
            "speakerId": 1000,
            "speakerName": "奇怪的人",
            "text": "哦，两位朋友，我一看就知道你们是新来的，对梅洛彼得堡还不太熟悉对吧？",
            "nextDialogs": [
              "741660204"
            ]
          },
          "741660204": {
            "id": "741660204",
            "speakerId": 1000,
            "speakerName": "奇怪的人",
            "text": "恭喜你们今天能遇到我，我是梅洛彼得堡里心地最善良的「住民」。",
            "nextDialogs": [
              "741660205"
            ]
          },
          "741660205": {
            "id": "741660205",
            "speakerId": 1000,
            "speakerName": "奇怪的人",
            "text": "今天就让我来带领你们熟悉一下梅洛彼得堡吧。当然，这一切都是「免费」的。",
            "nextDialogs": [
              "741660206"
            ]
          },
          "741660206": {
            "id": "741660206",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "其实我很熟悉这里了。",
            "nextDialogs": [
              "741660207"
            ]
          },
          "741660207": {
            "id": "741660207",
            "speakerId": 1000,
            "speakerName": "奇怪的人",
            "text": "哎，别这么说嘛。",
            "nextDialogs": [
              "741660208"
            ]
          },
          "741660208": {
            "id": "741660208",
            "speakerId": 1000,
            "speakerName": "奇怪的人",
            "text": "或许你觉得你很熟悉这里，但是在我的导览下，我相信你能发现不一样的景色。",
            "nextDialogs": [
              "741660209"
            ]
          },
          "741660209": {
            "id": "741660209",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "天下竟然有免费的午餐？",
            "nextDialogs": [
              "741660210"
            ]
          },
          "741660210": {
            "id": "741660210",
            "speakerId": 1000,
            "speakerName": "奇怪的人",
            "text": "当然当然，我说了，我可是梅洛彼得堡里心地最善良的「住民」。",
            "nextDialogs": [
              "741660211"
            ]
          },
          "741660211": {
            "id": "741660211",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "唔，总觉得这个人怪怪的，怎么一见面就这么热情？",
            "nextDialogs": [
              "741660212"
            ]
          },
          "741660212": {
            "id": "741660212",
            "speakerId": 1000,
            "speakerName": "奇怪的人",
            "text": "哈哈，我的朋友，不要多想。这样，要不然你们先商量一下，我就这里，等你们做决定。",
            "nextDialogs": [
              "741660213"
            ]
          },
          "741660213": {
            "id": "741660213",
            "speakerId": 1000,
            "speakerName": "奇怪的人",
            "text": "等你们商量好了，就来找我吧。"
          }
        }
      }
    },
    {
      "subId": "7416603",
      "subQuestName": "接受奇怪的人的邀请",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "741660301"
        ],
        "dialogs": {
          "741660301": {
            "id": "741660301",
            "speakerId": 1000,
            "speakerName": "奇怪的人",
            "text": "怎么样，两位商量好了吗？",
            "nextDialogs": [
              "741660302"
            ]
          },
          "741660302": {
            "id": "741660302",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "说好了，一定是免费的哦！",
            "nextDialogs": [
              "741660303"
            ]
          },
          "741660303": {
            "id": "741660303",
            "speakerId": 1000,
            "speakerName": "奇怪的人",
            "text": "那当然，那当然，肯定是「免费」的。",
            "nextDialogs": [
              "741660304"
            ]
          },
          "741660304": {
            "id": "741660304",
            "speakerId": 1000,
            "speakerName": "奇怪的人",
            "text": "来来来，接下来就跟着我一起熟悉梅洛彼得堡吧。"
          }
        }
      }
    },
    {
      "subId": "7416604",
      "subQuestName": "参观特许食堂",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "741660401"
        ],
        "dialogs": {
          "741660401": {
            "id": "741660401",
            "speakerId": 1000,
            "speakerName": "奇怪的人",
            "text": "这里是梅洛彼得堡的特许食堂，每人每天都能在这里领到一份免费的福利餐。",
            "nextDialogs": [
              "741660402"
            ]
          },
          "741660402": {
            "id": "741660402",
            "speakerId": 1000,
            "speakerName": "奇怪的人",
            "text": "唯一的问题在于吃到什么可就听天由命了。",
            "nextDialogs": [
              "741660403"
            ]
          },
          "741660403": {
            "id": "741660403",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "唔，就这些内容吗？总觉得在这里第一天就能很轻松了解到这种信息。",
            "nextDialogs": [
              "741660404"
            ]
          },
          "741660404": {
            "id": "741660404",
            "speakerId": 1000,
            "speakerName": "奇怪的人",
            "text": "别急，我这边还有一个隐秘的情报。据说在领取福利餐的时候，只要对着布兰说某一句暗语，就能获得传说中的神秘美食！",
            "nextDialogs": [
              "741660405"
            ]
          },
          "741660405": {
            "id": "741660405",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "啊，真的吗？是什么暗语啊？",
            "nextDialogs": [
              "741660406"
            ]
          },
          "741660406": {
            "id": "741660406",
            "speakerId": 1000,
            "speakerName": "奇怪的人",
            "text": "很可惜，我不知道。有关暗语的内容，就等待你们以后来探索了。",
            "nextDialogs": [
              "741660407"
            ]
          },
          "741660407": {
            "id": "741660407",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "这明明是我的台词！",
            "nextDialogs": [
              "741660408"
            ]
          },
          "741660408": {
            "id": "741660408",
            "speakerId": 1000,
            "speakerName": "奇怪的人",
            "text": "别在意这些细节啦，总之我们下一站，三枚券剧团！"
          }
        }
      }
    },
    {
      "subId": "7416605",
      "subQuestName": "参观三枚券剧团",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "741660501"
        ],
        "dialogs": {
          "741660501": {
            "id": "741660501",
            "speakerId": 1000,
            "speakerName": "奇怪的人",
            "text": "这里是三枚券剧团的所在地。",
            "nextDialogs": [
              "741660502"
            ]
          },
          "741660502": {
            "id": "741660502",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "嗯？这就介绍完了？",
            "nextDialogs": [
              "741660503"
            ]
          },
          "741660503": {
            "id": "741660503",
            "speakerId": 1000,
            "speakerName": "奇怪的人",
            "text": "你们难道没有联想到什么吗？说到剧团那就是戏剧！说到戏剧那就是浪漫！说到浪漫那就是爱情！",
            "nextDialogs": [
              "741660504"
            ]
          },
          "741660504": {
            "id": "741660504",
            "speakerId": 1000,
            "speakerName": "奇怪的人",
            "text": "有传闻说，只要每天都来这里观看表演，就能找到此生的挚爱。",
            "nextDialogs": [
              "741660505"
            ]
          },
          "741660505": {
            "id": "741660505",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "还有这种传闻？那大家不是应该都聚在这里么？",
            "nextDialogs": [
              "741660506"
            ]
          },
          "741660506": {
            "id": "741660506",
            "speakerId": 1000,
            "speakerName": "奇怪的人",
            "text": "话是这么说没错，但前提要求你既不能是梅洛彼得堡的犯人，也不能是梅洛彼得堡的看守。",
            "nextDialogs": [
              "741660507"
            ]
          },
          "741660507": {
            "id": "741660507",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "那根本就没有人能遇到挚爱了吧！",
            "nextDialogs": [
              "741660508"
            ]
          },
          "741660508": {
            "id": "741660508",
            "speakerId": 1000,
            "speakerName": "奇怪的人",
            "text": "或许这就是问题所在了。不管怎样，我们先向下一个目标进发吧。"
          }
        }
      }
    },
    {
      "subId": "7416606",
      "subQuestName": "参观升降机",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "741660601"
        ],
        "dialogs": {
          "741660601": {
            "id": "741660601",
            "speakerId": 1000,
            "speakerName": "奇怪的人",
            "text": "这里是...前往梅洛彼得堡生产区的升降机。",
            "nextDialogs": [
              "741660602"
            ]
          },
          "741660602": {
            "id": "741660602",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "这里不会也有什么奇怪的传闻吧？",
            "nextDialogs": [
              "741660603"
            ]
          },
          "741660603": {
            "id": "741660603",
            "speakerId": 1000,
            "speakerName": "奇怪的人",
            "text": "不，这倒没有。只是我非常不喜欢这个地方。",
            "nextDialogs": [
              "741660604"
            ]
          },
          "741660604": {
            "id": "741660604",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "嗯？为什么呀？",
            "nextDialogs": [
              "741660605"
            ]
          },
          "741660605": {
            "id": "741660605",
            "speakerId": 1000,
            "speakerName": "奇怪的人",
            "text": "因为...",
            "nextDialogs": [
              "741660606"
            ]
          },
          "741660606": {
            "id": "741660606",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "因为？",
            "nextDialogs": [
              "741660607"
            ]
          },
          "741660607": {
            "id": "741660607",
            "speakerId": 1000,
            "speakerName": "奇怪的人",
            "text": "因为我不想工作！",
            "nextDialogs": [
              "741660608"
            ]
          },
          "741660608": {
            "id": "741660608",
            "speakerId": 1000,
            "speakerName": "奇怪的人",
            "text": "我只是因为不想工作，所以在饿肚子的时候偷了一块面包被判了罪，来到这里。",
            "nextDialogs": [
              "741660609"
            ]
          },
          "741660609": {
            "id": "741660609",
            "speakerId": 1000,
            "speakerName": "奇怪的人",
            "text": "但是为什么来了梅洛彼得堡也要工作啊！",
            "nextDialogs": [
              "741660610"
            ]
          },
          "741660610": {
            "id": "741660610",
            "speakerId": 1000,
            "speakerName": "奇怪的人",
            "text": "「一切的工作都可以击倒我！」这可是我的人生格言。",
            "nextDialogs": [
              "741660611"
            ]
          },
          "741660611": {
            "id": "741660611",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "呜哇，感觉他在这里的时候整个人都有点不太对劲，我们还是快离开这里去下个地方吧。"
          }
        }
      }
    },
    {
      "subId": "7416607",
      "subQuestName": "参观拳力斗技场",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "741660701"
        ],
        "dialogs": {
          "741660701": {
            "id": "741660701",
            "speakerId": 1000,
            "speakerName": "奇怪的人",
            "text": "好了，朋友们，终于来到了我最喜欢的设施——拳力斗技场！这里可是只属于我们的天堂！",
            "nextDialogs": [
              "741660702"
            ]
          },
          "741660702": {
            "id": "741660702",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "这边...真的是这么好的地方吗？总觉得和我听说的很不一样…",
            "nextDialogs": [
              "741660703"
            ]
          },
          "741660703": {
            "id": "741660703",
            "speakerId": 1000,
            "speakerName": "奇怪的人",
            "text": "那当然，不要在意外面的传言，那不过是避人耳目的表象罢了。来来来，我这边有一个同意书，只要你们签...",
            "nextDialogs": [
              "741660704"
            ]
          },
          "741660704": {
            "id": "741660704",
            "speakerId": 1002,
            "speakerName": "看守",
            "text": "喂，又是你，又来骗人签参赛同意书。这次你可跑不了了！",
            "nextDialogs": [
              "741660705"
            ]
          },
          "741660705": {
            "id": "741660705",
            "speakerId": 1002,
            "speakerName": "看守",
            "text": "你们运气真好，正好在被迫签同意书的前一刻被我发现了。",
            "nextDialogs": [
              "741660706"
            ]
          },
          "741660706": {
            "id": "741660706",
            "speakerId": 1002,
            "speakerName": "看守",
            "text": "总之，不要理会这个家伙。他和他背后的组织专挑不知情的人，用话术欺骗这些可怜人参加危险的比赛并借此获利。",
            "nextDialogs": [
              "741660707"
            ]
          },
          "741660707": {
            "id": "741660707",
            "speakerId": 1000,
            "speakerName": "奇怪的人",
            "text": "不要乱讲话，我可没有骗任何人。大家都是我的朋友，是在我的推荐下自愿参加比赛的！",
            "nextDialogs": [
              "741660708"
            ]
          },
          "741660708": {
            "id": "741660708",
            "speakerId": 1002,
            "speakerName": "看守",
            "text": "好好好，我们有更合适的地方让你说这些胡话。走吧。",
            "nextDialogs": [
              "741660709"
            ]
          },
          "741660709": {
            "id": "741660709",
            "speakerId": 1003,
            "speakerName": "Black Screen",
            "text": "奇怪的人被看守押走了...",
            "nextDialogs": [
              "741660710"
            ]
          },
          "741660710": {
            "id": "741660710",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "唔——天下果然没有免费的午餐呢…"
          }
        }
      }
    }
  ]
}
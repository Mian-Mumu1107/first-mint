            ]
          },
          "750080117": {
            "id": "750080117",
            "speakerId": 21481,
            "speakerName": "曼科",
            "text": "我知道…不过，信物的线索，我也只知道这枚，另外一枚究竟在何处，我就实在不清楚。",
            "nextDialogs": [
              "750080118"
            ]
          },
          "750080118": {
            "id": "750080118",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "奥奇卡纳塔…",
            "nextDialogs": [
              "750080119"
            ]
          },
          "750080119": {
            "id": "750080119",
            "speakerId": 21481,
            "speakerName": "曼科",
            "text": "#咦，恕我直言，{NICKNAME}，你是说奥奇卡纳塔吗…",
            "nextDialogs": [
              "750080120"
            ]
          },
          "750080120": {
            "id": "750080120",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "（述说触摸石碑时看到的…）",
            "nextDialogs": [
              "750080121"
            ]
          },
          "750080121": {
            "id": "750080121",
            "speakerId": 21481,
            "speakerName": "曼科",
            "text": "唔，居然在奥奇卡纳塔…那是花羽会北边，隔海相望的一座古城遗址…",
            "nextDialogs": [
              "750080122"
            ]
          },
          "750080122": {
            "id": "750080122",
            "speakerId": 21481,
            "speakerName": "曼科",
            "text": "如果是奥奇卡纳塔，恕我抱歉，我爱莫能助。那里不仅仅是部族人的禁地，更是龙遗物研究协会的禁地…",
            "nextDialogs": [
              "750080123"
            ]
          },
          "750080123": {
            "id": "750080123",
            "speakerId": 21481,
            "speakerName": "曼科",
            "text": "据说许多年前，曾经有龙遗物研究协会的组织成员受人委托前去调查，结果就像石头沉入水中那样，再无半点消息。",
            "nextDialogs": [
              "750080124"
            ]
          },
          "750080124": {
            "id": "750080124",
            "speakerId": 21481,
            "speakerName": "曼科",
            "text": "自那以后，我们协会就不再插手任何和奥奇卡纳塔相关的事。",
            "nextDialogs": [
              "750080125"
            ]
          },
          "750080125": {
            "id": "750080125",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "没关系，知道这些已经很足够啦！",
            "nextDialogs": [
              "750080126"
            ]
          },
          "750080126": {
            "id": "750080126",
            "speakerId": 14662,
            "speakerName": "#{REALNAME[ID(2)|SHOWHOST(true)]}",
            "text": "呀！",
            "nextDialogs": [
              "750080127"
            ]
          },
          "750080127": {
            "id": "750080127",
            "speakerId": 21481,
            "speakerName": "曼科",
            "text": "嗯，我要再度感谢你们，能够看到「通牒金盘」，对我真的十分重要，不行，我得快点回去将这些记录下来…",
            "nextDialogs": [

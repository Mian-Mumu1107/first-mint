    {
      "subId": "7112091",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "711209101"
        ],
        "dialogs": {
          "711209101": {
            "id": "711209101",
            "speakerId": 21397,
            "speakerName": "坐地虎",
            "text": "怎么又是你们！",
            "nextDialogs": [
              "711209102"
            ]
          },
          "711209102": {
            "id": "711209102",
            "speakerId": 21413,
            "speakerName": "盘枝蛇",
            "text": "收收好奇心，朋友。你们就当没看见我们，我们也当没看见你们。",
            "nextDialogs": [
              "711209104",
              "711209112"
            ]
          },
          "711209104": {
            "id": "711209104",
            "speakerId": 21413,
            "speakerName": "盘枝蛇",
            "text": "朋友，你猜我们领工钱为了什么？",
            "nextDialogs": [
              "711209105"
            ]
          },
          "711209105": {
            "id": "711209105",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "为什么呀！",
            "nextDialogs": [
              "711209106"
            ]
          },
          "711209106": {
            "id": "711209106",
            "speakerId": 21413,
            "speakerName": "盘枝蛇",
            "text": "咳咳…！",
            "nextDialogs": [
              "711209107"
            ]
          },
          "711209107": {
            "id": "711209107",
            "speakerId": 21413,
            "speakerName": "盘枝蛇",
            "text": "（我只告诉你两个，别让别人知道哦…来来，我告诉你…）",
            "nextDialogs": [
              "711209108"
            ]
          },
          "711209108": {
            "id": "711209108",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "（嗯嗯！我听着呢！）",
            "nextDialogs": [
              "711209109"
            ]
          },
          "711209109": {
            "id": "711209109",
            "speakerId": 21413,
            "speakerName": "盘枝蛇",
            "text": "为了让你们这种闲人滚蛋！！",
            "nextDialogs": [
              "711209110"
            ]
          },
          "711209110": {
            "id": "711209110",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "哇啊！！"
          },
          "711209112": {
            "id": "711209112",
            "speakerId": 21397,
            "speakerName": "坐地虎",
            "text": "我放屁了！",
            "nextDialogs": [
              "711209113"
            ]
          },
          "711209113": {
            "id": "711209113",
            "speakerId": 21413,
            "speakerName": "盘枝蛇",
            "text": "呃…对，他放屁了。",
            "nextDialogs": [
              "711209114"
            ]
          },
          "711209114": {
            "id": "711209114",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "那、那没事了…"
          }
        }
      }
    },

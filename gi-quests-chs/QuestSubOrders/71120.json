    {
      "subId": "7112001",
      "subQuestName": "(test)打怪给电源$HIDDEN",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "711200101"
        ],
        "dialogs": {
          "711200101": {
            "id": "711200101",
            "speakerId": 21397,
            "speakerName": "坐地虎",
            "text": "喂，离远点！这是老爷的地盘！",
            "nextDialogs": [
              "711200102"
            ]
          },
          "711200102": {
            "id": "711200102",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "哇啊，好凶！",
            "nextDialogs": [
              "711200104",
              "711200107"
            ]
          },
          "711200104": {
            "id": "711200104",
            "speakerId": 21413,
            "speakerName": "盘枝蛇",
            "text": "看你咯。你若客客气气的，我们便是朋友！你若打探太多，便别怪我们不客气啦。",
            "nextDialogs": [
              "711200105"
            ]
          },
          "711200105": {
            "id": "711200105",
            "speakerId": 21397,
            "speakerName": "坐地虎",
            "text": "劝你有点眼力见儿，哪里来的回哪里去！",
            "nextDialogs": [
              "711200109"
            ]
          },
          "711200109": {
            "id": "711200109",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "你们也太可疑了！",
            "nextDialogs": [
              "711200110"
            ]
          },
          "711200110": {
            "id": "711200110",
            "speakerId": 21413,
            "speakerName": "盘枝蛇",
            "text": "可疑？唉哟…我们就是看门的而已，你们这幅探头探脑的样子才更可疑吧！",
            "nextDialogs": [
              "711200111"
            ]
          },
          "711200111": {
            "id": "711200111",
            "speakerId": 21397,
            "speakerName": "坐地虎",
            "text": "行了，有什么好说！别打扰我们了！"
          },
          "711200107": {
            "id": "711200107",
            "speakerId": 21397,
            "speakerName": "坐地虎",
            "text": "哪位「老爷」？哼…说出来吓死你！",
            "nextDialogs": [
              "711200108"
            ]
          },
          "711200108": {
            "id": "711200108",
            "speakerId": 21413,
            "speakerName": "盘枝蛇",
            "text": "为你自己好，朋友！不该知道的东西就别乱打听了。"
          }
        }
      }
    },

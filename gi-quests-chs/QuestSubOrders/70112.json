    },
    {
      "subId": "7011203",
      "subQuestName": "(test)隐藏$HIDDEN",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "701120301"
        ],
        "dialogs": {
          "701120301": {
            "id": "701120301",
            "speakerId": 1000,
            "speakerName": "乔瑟夫斯",
            "text": "我想学伊斯托利亚的语气说一句「真棒！」，但是我拉不下这个脸。",
            "nextDialogs": [
              "701120302"
            ]
          },
          "701120302": {
            "id": "701120302",
            "speakerId": 1000,
            "speakerName": "乔瑟夫斯",
            "text": "我已经没有什么可以教你的了。最后一课到此结束。",
            "nextDialogs": [
              "701120303"
            ]
          },
          "701120303": {
            "id": "701120303",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "#你教了什么啊。这不是{NICKNAME}教的吗！"
          }
        }
      }
    },
    {
      "subId": "7011204",
      "subQuestName": "(test)隐藏$HIDDEN",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "701120201"
        ],
        "dialogs": {
          "701120201": {
            "id": "701120201",
            "speakerId": 1000,
            "speakerName": "乔瑟夫斯",
            "text": "做得不错。",
            "nextDialogs": [
              "701120202"
            ]
          },
          "701120202": {
            "id": "701120202",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "不知道你是在夸哪一边。",
            "nextDialogs": [
              "701120203"
            ]
          },
          "701120203": {
            "id": "701120203",
            "speakerId": 1000,
            "speakerName": "乔瑟夫斯",
            "text": "那么接下来，考虑一下事物之间的相互作用吧。",
            "nextDialogs": [
              "701120204"
            ]
          },
          "701120204": {
            "id": "701120204",
            "speakerId": 1000,
            "speakerName": "乔瑟夫斯",
            "text": "注意元素的反应、长程力和短程力。要记得避开扰动。",
            "nextDialogs": [
              "701120205"
            ]
          },
          "701120205": {
            "id": "701120205",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "你在说什么啊！"
          }
        }
      }
    },

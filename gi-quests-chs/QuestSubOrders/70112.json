  "subQuests": [
    {
      "subId": "7011201",
      "subQuestName": "(test)隐藏$HIDDEN",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "701120101"
        ],
        "dialogs": {
          "701120101": {
            "id": "701120101",
            "speakerId": 1000,
            "speakerName": "乔瑟夫斯",
            "text": "对了，德克斯特，今时不同往日。你也应该迎接童年的终结了。",
            "nextDialogs": [
              "701120102"
            ]
          },
          "701120102": {
            "id": "701120102",
            "speakerId": 1000,
            "speakerName": "乔瑟夫斯",
            "text": "你也要接受成年的洗礼，学习大人才知道的事情。看好了，小右，我只教这一次。",
            "nextDialogs": [
              "701120103"
            ]
          },
          "701120103": {
            "id": "701120103",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "听起来像是在交代后事一样。",
            "nextDialogs": [
              "701120104"
            ]
          },
          "701120104": {
            "id": "701120104",
            "speakerId": 1000,
            "speakerName": "乔瑟夫斯",
            "text": "最后一课，先和我一起读：「元素的分类」。你来试试吧。"
          }
        }
      }
    },
    {
      "subId": "7011202",
      "subQuestName": "(test)隐藏$HIDDEN",
      "sceneId": null,
      "locations": [],

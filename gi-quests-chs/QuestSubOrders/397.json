    {
      "subId": "39702",
      "subQuestName": "与迪卢克对话",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "3970201"
        ],
        "dialogs": {
          "3970201": {
            "id": "3970201",
            "speakerId": 1000,
            "speakerName": "迪卢克",
            "text": "深渊教团…这些与人类为敌的怪物，地下情报网也很少出现它们的消息。",
            "nextDialogs": [
              "3970202"
            ]
          },
          "3970202": {
            "id": "3970202",
            "speakerId": 1000,
            "speakerName": "迪卢克",
            "text": "但虽然麻烦，终归也还是被我找出一些线索了。",
            "nextDialogs": [
              "3970203"
            ]
          },
          "3970203": {
            "id": "3970203",
            "speakerId": 1001,
            "speakerName": "温迪",
            "text": "这么快就有线索了吗？不愧是消息灵通的迪卢克老爷。",
            "nextDialogs": [
              "3970204"
            ]
          },
          "3970204": {
            "id": "3970204",
            "speakerId": 1002,
            "speakerName": "派蒙",
            "text": "不过说起来，风神巴巴托斯大人，为什么要借助人类的力量…",
            "nextDialogs": [
              "3970205"
            ]
          },
          "3970205": {
            "id": "3970205",
            "speakerId": 1001,
            "speakerName": "温迪",
            "text": "哈哈，怎么说呢？",
            "nextDialogs": [
              "3970206"
            ]
          },
          "3970206": {
            "id": "3970206",
            "speakerId": 1001,
            "speakerName": "温迪",
            "text": "人们所说的七神，更本源的称谓是「尘世七执政」。",
            "nextDialogs": [
              "3970207"
            ]
          },
          "3970207": {
            "id": "3970207",
            "speakerId": 1001,
            "speakerName": "温迪",
            "text": "划分尘世、各自统治七分之一，这是我们作为神明的责任。",
            "nextDialogs": [
              "3970208"
            ]
          },
          "3970208": {
            "id": "3970208",
            "speakerId": 1001,
            "speakerName": "温迪",
            "text": "履行神职，才能积累神力。但我不喜欢统治…我觉得蒙德也不会喜欢的。",
            "nextDialogs": [
              "3970209"
            ]
          },
          "3970209": {
            "id": "3970209",
            "speakerId": 1003,
            "speakerName": "琴",
            "text": "「你们建立无人称王的自由城邦罢」——巴巴托斯大人的理念，我们牢记于心。",
            "nextDialogs": [
              "3970210"
            ]
          },
          "3970210": {
            "id": "3970210",
            "speakerId": 1002,
            "speakerName": "派蒙",
            "text": "真虔诚啊，琴团长！",
            "nextDialogs": [
              "3970211"
            ]
          },
          "3970211": {
            "id": "3970211",
            "speakerId": 1002,
            "speakerName": "派蒙",
            "text": "完全没有想过可能是某人太过自由散漫、不想管事的原因呢。",
            "nextDialogs": [
              "3970212"
            ]
          },
          "3970212": {
            "id": "3970212",
            "speakerId": 1001,
            "speakerName": "温迪",
            "text": "咳咳。总之你们看，我都这么久没有回过蒙德了…",
            "nextDialogs": [
              "3970213"
            ]
          },
          "3970213": {
            "id": "3970213",
            "speakerId": 1001,
            "speakerName": "温迪",
            "text": "所以现在的我，毫无疑问，正是七神中最弱的一个！",
            "nextDialogs": [
              "3970216"
            ]
          },
          "3970216": {
            "id": "3970216",
            "speakerId": 1001,
            "speakerName": "温迪",
            "text": "过奖过奖。",
            "nextDialogs": [
              "3970217"
            ]
          },
          "3970217": {
            "id": "3970217",
            "speakerId": 1000,
            "speakerName": "迪卢克",
            "text": "呵…我们有这样一位风神大人，该说是好还是坏呢。",
            "nextDialogs": [
              "3970218"
            ]
          },
          "3970218": {
            "id": "3970218",
            "speakerId": 1000,
            "speakerName": "迪卢克",
            "text": "不过现在就先抛开七国与七神的话题，重新关注一下人类共同的敌人吧。",
            "nextDialogs": [
              "3970219"
            ]
          },
          "3970219": {
            "id": "3970219",
            "speakerId": 1000,
            "speakerName": "迪卢克",
            "text": "这一次查出的<color=#00E1FFFF>深渊法师踪迹</color>，就在<color=#00E1FFFF>酒庄</color>附近。",
            "nextDialogs": [
              "3970220"
            ]
          },
          "3970220": {
            "id": "3970220",
            "speakerId": 1003,
            "speakerName": "琴",
            "text": "不能让它全身而退。",
            "nextDialogs": [
              "3970221"
            ]
          },
          "3970221": {
            "id": "3970221",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "开始追猎吧。"
          }
        }
      }
    },
    {

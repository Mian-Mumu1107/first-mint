    {
      "subId": "39703",
      "subQuestName": "击败来袭的敌人",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "3970301"
        ],
        "dialogs": {
          "3970301": {
            "id": "3970301",
            "speakerId": 1002,
            "speakerName": "派蒙",
            "text": "在那里了！"
          }
        }
      }
    },
    {
      "subId": "39704",
      "subQuestName": "与温迪对话",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "3970401"
        ],
        "dialogs": {
          "3970401": {
            "id": "3970401",
            "speakerId": 1001,
            "speakerName": "温迪",
            "text": "咦？这是什么…",
            "nextDialogs": [
              "3970402"
            ]
          },
          "3970402": {
            "id": "3970402",
            "speakerId": 1001,
            "speakerName": "温迪",
            "text": "深渊法师被击败以后，散逸出了某种能量…",
            "nextDialogs": [
              "3970403"
            ]
          },
          "3970403": {
            "id": "3970403",
            "speakerId": 1001,
            "speakerName": "温迪",
            "text": "它原本的用途，似乎是隔绝我和特瓦林之间的联系。",
            "nextDialogs": [
              "3970404"
            ]
          },
          "3970404": {
            "id": "3970404",
            "speakerId": 1001,
            "speakerName": "温迪",
            "text": "……",
            "nextDialogs": [
              "3970405"
            ]
          },
          "3970405": {
            "id": "3970405",
            "speakerId": 1001,
            "speakerName": "温迪",
            "text": "#{NICKNAME}，你知道<color=#00E1FFFF>「风龙废墟」</color>吗？",
            "nextDialogs": [
              "3970407",
              "3970409"
            ]
          },
          "3970407": {
            "id": "3970407",
            "speakerId": 1001,
            "speakerName": "温迪",
            "text": "嗯，但琴团长和迪卢克老爷想必都是知道的。",
            "nextDialogs": [
              "3970410"
            ]
          },
          "3970410": {
            "id": "3970410",
            "speakerId": 1001,
            "speakerName": "温迪",
            "text": "特瓦林苏醒以后，把一片远古的废墟当作了它的巢穴。",
            "nextDialogs": [
              "3970411"
            ]
          },
          "3970411": {
            "id": "3970411",
            "speakerId": 1001,
            "speakerName": "温迪",
            "text": "与先前封锁蒙德四方的暴风一样，废墟的入口也有特殊的障壁。",
            "nextDialogs": [
              "3970412"
            ]
          },
          "3970412": {
            "id": "3970412",
            "speakerId": 1001,
            "speakerName": "温迪",
            "text": "但现在，从深渊法师散逸的能量里，我能读出编织魔力的韵律。",
            "nextDialogs": [
              "3970413"
            ]
          },
          "3970413": {
            "id": "3970413",
            "speakerId": 1001,
            "speakerName": "温迪",
            "text": "虽然那种韵律比丘丘人的合唱还要难听，但…",
            "nextDialogs": [
              "3970414"
            ]
          },
          "3970414": {
            "id": "3970414",
            "speakerId": 1001,
            "speakerName": "温迪",
            "text": "也足够让我们破除暴风障壁、抵达<color=#00E1FFFF>「风龙废墟」</color>内部了。",
            "nextDialogs": [
              "3970415"
            ]
          },
          "3970415": {
            "id": "3970415",
            "speakerId": 1000,
            "speakerName": "迪卢克",
            "text": "那，就是要正面挑战风龙了么？",
            "nextDialogs": [
              "3970416"
            ]
          },
          "3970416": {
            "id": "3970416",
            "speakerId": 1000,
            "speakerName": "迪卢克",
            "text": "我倒是没有意见…话说回来，琴才是那个想要避免开战的人。",
            "nextDialogs": [
              "3970417"
            ]
          },
          "3970417": {
            "id": "3970417",
            "speakerId": 1003,
            "speakerName": "琴",
            "text": "不。在没有更好的选择时，就由我承担改变方针的责任。",
            "nextDialogs": [
              "3970418"
            ]
          },
          "3970418": {
            "id": "3970418",
            "speakerId": 1003,
            "speakerName": "琴",
            "text": "如果讨伐风龙是唯一的方案，那我就会成为冲锋在前的骑士。",
            "nextDialogs": [
              "3970419"
            ]
          },
          "3970419": {
            "id": "3970419",
            "speakerId": 1001,
            "speakerName": "温迪",
            "text": "——现在还没到那一步喔。",
            "nextDialogs": [
              "3970420"
            ]
          },
          "3970420": {
            "id": "3970420",
            "speakerId": 1000,
            "speakerName": "迪卢克",
            "text": "嗯？",
            "nextDialogs": [
              "3970421"
            ]
          },
          "3970421": {
            "id": "3970421",
            "speakerId": 1003,
            "speakerName": "琴",
            "text": "温迪阁下的意思是…",
            "nextDialogs": [
              "3970422"
            ]
          },
          "3970422": {
            "id": "3970422",
            "speakerId": 1001,
            "speakerName": "温迪",
            "text": "我的意思是，天空之琴不是我们的底牌。",
            "nextDialogs": [
              "3970423"
            ]
          },
          "3970423": {
            "id": "3970423",
            "speakerId": 1001,
            "speakerName": "温迪",
            "text": "#真正的底牌——是{NICKNAME}呀。",
            "nextDialogs": [
              "3970424"
            ]
          },
          "3970424": {
            "id": "3970424",
            "speakerId": 1002,
            "speakerName": "派蒙",
            "text": "#{NICKNAME}？"
          },
          "3970409": {
            "id": "3970409",
            "speakerId": 1001,
            "speakerName": "温迪",
            "text": "嗯，同样来自蒙德的各位，想必都是知道的。"
          }
        }
      }
    }
  ]
}
  "subQuests": [
    {
      "subId": "7550301",
      "subQuestName": "(test游猎龙彩蛋任务$HIDDEN",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "755030201"
        ],
        "dialogs": {
          "755030201": {
            "id": "755030201",
            "speakerId": 30609,
            "speakerName": "「炫彩呆子」",
            "text": "不错嘛，你们也来到「流泉之众」最好的取景点了。这一带有着大家公认的，纳塔南部数一数二的风光。",
            "nextDialogs": [
              "755030202"
            ]
          },
          "755030202": {
            "id": "755030202",
            "speakerId": 30609,
            "speakerName": "「炫彩呆子」",
            "text": "大片水域的青蓝、山体植被的苍绿，与燃素那炽烈火焰的色彩交织，真是一绝，大概能给你们带来「撞色」的启蒙。",
            "nextDialogs": [
              "755030203"
            ]
          },
          "755030203": {
            "id": "755030203",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "「炫彩呆子」！你的速度挺快的嘛！",
            "nextDialogs": [
              "755030204"
            ]
          },
          "755030204": {
            "id": "755030204",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "不过现在和我们讲这种色彩的理论，我们暂时还听不懂啦…",
            "nextDialogs": [
              "755030207"
            ]
          },
          "755030207": {
            "id": "755030207",
            "speakerId": 30609,
            "speakerName": "「炫彩呆子」",
            "text": "确切地说，「涂鸦联盟」的核心成员力求走遍纳塔的每个角落，熟悉每个部族的风土人情。",
            "nextDialogs": [
              "755030208"
            ]
          },
          "755030208": {
            "id": "755030208",
            "speakerId": 30609,
            "speakerName": "「炫彩呆子」",
            "text": "以前「流泉之众」曾雇佣我们，为水上用品喷涂彩绘。为了这个大订单，我在这边暂住过一段时间。",
            "nextDialogs": [
              "755030209"
            ]
          },
          "755030209": {
            "id": "755030209",
            "speakerId": 30609,
            "speakerName": "「炫彩呆子」",
            "text": "「流泉之众」开出的报酬非常丰厚，我觉得，为了报答这些朋友，必须给每件水上用品设计独一无二的涂鸦图案。",
            "nextDialogs": [
              "755030210"
            ]
          },
          "755030210": {
            "id": "755030210",
            "speakerId": 30609,
            "speakerName": "「炫彩呆子」",
            "text": "结果埋头苦干了两个月，只完成了不到百分之五的工作量…手要画断了，脑子也要转不动了…",
            "nextDialogs": [
              "755030211"
            ]
          },
          "755030211": {
            "id": "755030211",
            "speakerId": 30609,
            "speakerName": "「炫彩呆子」",
            "text": "而且，新的商品在不断被生产出来，这样下去永远都画不完…",
            "nextDialogs": [
              "755030212"
            ]
          },
          "755030212": {
            "id": "755030212",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "为每件水上用品单独设计涂鸦？",
            "nextDialogs": [
              "755030213"
            ]
          },
          "755030213": {
            "id": "755030213",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "我记得「流泉之众」里的水上用品多得…数都数不过来，你这个目标未免也太夸张了！"
          }
        }
      }
    }
  ]
}
  "subQuests": [
    {
      "subId": "1302001",
      "subQuestName": "前往教令院",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "130200101"
        ],
        "dialogs": {
          "130200101": {
            "id": "130200101",
            "speakerId": 13030,
            "speakerName": "兰丘",
            "text": "你那个课题，最近还顺利吗？",
            "nextDialogs": [
              "130200102"
            ]
          },
          "130200102": {
            "id": "130200102",
            "speakerId": 13031,
            "speakerName": "皮雅",
            "text": "下个月应该就能见刊了。呼…前几天还以为要被叫停了，好在是虚惊一场。",
            "nextDialogs": [
              "130200103"
            ]
          },
          "130200103": {
            "id": "130200103",
            "speakerId": 13030,
            "speakerName": "兰丘",
            "text": "毕竟你课题的导师中有阿扎尔挂名，原来还以为会被牵连。后来是怎么解决的？",
            "nextDialogs": [
              "130200104"
            ]
          },
          "130200104": {
            "id": "130200104",
            "speakerId": 13031,
            "speakerName": "皮雅",
            "text": "不是新来了一位代理贤者吗？他重新审阅了我们的项目，允许我们继续研究。",
            "nextDialogs": [
              "130200105"
            ]
          },
          "130200105": {
            "id": "130200105",
            "speakerId": 13030,
            "speakerName": "兰丘",
            "text": "代理贤者？以前有过这种职位吗？",
            "nextDialogs": [
              "130200106"
            ]
          },
          "130200106": {
            "id": "130200106",
            "speakerId": 13031,
            "speakerName": "皮雅",
            "text": "我听人说，其实是因为新贤者还在选拔，但暂时没有结果…就让那个人暂代一下。",
            "nextDialogs": [
              "130200107"
            ]
          },
          "130200107": {
            "id": "130200107",
            "speakerId": 13031,
            "speakerName": "皮雅",
            "text": "也多亏他帮我们说了话，大家的研究成果才能保住。",
            "nextDialogs": [
              "130200108"
            ]
          },
          "130200108": {
            "id": "130200108",
            "speakerId": 13031,
            "speakerName": "皮雅",
            "text": "等论文见刊后，我一定要给自己放个长假，好好休息一下。到时候我想去蒙德旅游…",
            "nextDialogs": [
              "130200109"
            ]
          },
          "130200109": {
            "id": "130200109",
            "speakerId": 13032,
            "speakerName": "拉库马尔",
            "text": "那些人真是昏了头，竟然会请艾尔海森做代理贤者。",
            "nextDialogs": [
              "130200110"
            ]
          },
          "130200110": {
            "id": "130200110",
            "speakerId": 13033,
            "speakerName": "雷汉",
            "text": "消消气，老师。我也纳闷，按资历您才是学术泰斗，怎么轮得到他一个毛头小子…",
            "nextDialogs": [
              "130200111"
            ]
          },
          "130200111": {
            "id": "130200111",
            "speakerId": 13032,
            "speakerName": "拉库马尔",
            "text": "愚蠢！你以为我是气自己没当上贤者？我是不理解为何偏偏是艾尔海森。",
            "nextDialogs": [
              "130200112"
            ]
          },
          "130200112": {
            "id": "130200112",
            "speakerId": 13032,
            "speakerName": "拉库马尔",
            "text": "当初他选修我的课，一学期我就没见过他几次。问他，他居然敢顶撞我，说听我讲课还不如自己在家看书——",
            "nextDialogs": [
              "130200113"
            ]
          },
          "130200113": {
            "id": "130200113",
            "speakerId": 13032,
            "speakerName": "拉库马尔",
            "text": "狂妄！刺头！这样的人竟然成了代理贤者，简直就是教令院的不幸！咳咳咳…",
            "nextDialogs": [
              "130200114"
            ]
          },
          "130200114": {
            "id": "130200114",
            "speakerId": 13033,
            "speakerName": "雷汉",
            "text": "冷静啊老师，我、我去给您接点水！",
            "nextDialogs": [
              "130200115"
            ]
          },
          "130200115": {
            "id": "130200115",
            "speakerId": 13034,
            "speakerName": "雷萨哈尼",
            "text": "嘘…告诉你们一个秘密。听说新的代理贤者，是我们知论派的学长！",
            "nextDialogs": [
              "130200116"
            ]
          },
          "130200116": {
            "id": "130200116",
            "speakerId": 13035,
            "speakerName": "法莉巴",
            "text": "真的吗？是谁啊？",
            "nextDialogs": [
              "130200117"
            ]
          },
          "130200117": {
            "id": "130200117",
            "speakerId": 13036,
            "speakerName": "罗珊",
            "text": "他叫艾尔海森，我是没见过啦，最近有关他的说法不少，也不知道哪些是真的。",
            "nextDialogs": [
              "130200118"
            ]
          },
          "130200118": {
            "id": "130200118",
            "speakerId": 13036,
            "speakerName": "罗珊",
            "text": "比起这个，最近因论派有个风头正盛的学者，听人说他很可能是下任贤者之一。",
            "nextDialogs": [
              "130200119"
            ]
          },
          "130200119": {
            "id": "130200119",
            "speakerId": 13035,
            "speakerName": "法莉巴",
            "text": "哦？他有开课吗，我们要不要早点去拜访一下…",
            "nextDialogs": [
              "130200120"
            ]
          },
          "130200120": {
            "id": "130200120",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "唔…看来艾尔海森要当代理贤者这件事传得很广呢。不过居然也有人不认识他，他似乎不是那么有名？",
            "nextDialogs": [
              "130200121"
            ]
          },
          "130200121": {
            "id": "130200121",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "关于他的评价也是有好有坏，特别是刚刚那个老人，看上去对他很不满…",
            "nextDialogs": [
              "130200122"
            ]
          },
          "130200122": {
            "id": "130200122",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "咦，你怎么了，身体不舒服吗？",
            "nextDialogs": [
              "130200123"
            ]
          },
          "130200123": {
            "id": "130200123",
            "speakerId": 10205,
            "speakerName": "？？？",
            "text": "风纪官…",
            "nextDialogs": [
              "130200124"
            ]
          },
          "130200124": {
            "id": "130200124",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "风纪官？",
            "nextDialogs": [
              "130200125"
            ]
          },
          "130200125": {
            "id": "130200125",
            "speakerId": 13003,
            "speakerName": "伊利亚斯",
            "text": "我是伊利亚斯。我要见风纪官，我有很重要的事情…",
            "nextDialogs": [
              "130200126"
            ]
          },
          "130200126": {
            "id": "130200126",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "呜哇，你都这样了，还是不要勉强自己了吧？",
            "nextDialogs": [
              "130200127"
            ]
          },
          "130200127": {
            "id": "130200127",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "要不你把事情告诉我们，我们帮你转告给风纪官怎么样？",
            "nextDialogs": [
              "130200128"
            ]
          },
          "130200128": {
            "id": "130200128",
            "speakerId": 13003,
            "speakerName": "伊利亚斯",
            "text": "不行。我必须亲自见到风纪官，只有风纪官可以信任…",
            "nextDialogs": [
              "130200129"
            ]
          },
          "130200129": {
            "id": "130200129",
            "speakerId": 13003,
            "speakerName": "伊利亚斯",
            "text": "拜托你们扶我一把，这件事很重要，绝对不能出差错。",
            "nextDialogs": [
              "130200130"
            ]
          },
          "130200130": {
            "id": "130200130",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "既然你都这么说了…好吧，我们带你去找风纪官！"
          }
        }
      }
    },
    {
      "subId": "1302002",
      "subQuestName": "前往寻找风纪官",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [],
        "dialogs": {}
      }
    },
    {
      "subId": "1302003",
      "subQuestName": "与风纪官对话",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "130200301"
        ],
        "dialogs": {
          "130200301": {
            "id": "130200301",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "你好！我们想打听一下，赛诺在教令院吗？",
            "nextDialogs": [
              "130200302"
            ]
          },
          "130200302": {
            "id": "130200302",
            "speakerId": 13091,
            "speakerName": "阿拉夫",
            "text": "两位看着眼熟，莫非是赛诺大人的朋友？赛诺大人正在外面执行任务。",
            "nextDialogs": [
              "130200303"
            ]
          },
          "130200303": {
            "id": "130200303",
            "speakerId": 13091,
            "speakerName": "阿拉夫",
            "text": "有什么事可以先和我说，我会帮你们转告赛诺大人。",
            "nextDialogs": [
              "130200304"
            ]
          },
          "130200304": {
            "id": "130200304",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "我们在教令院门口遇到了这家伙，他吵着要见风纪官，好像有什么要紧的事情。",
            "nextDialogs": [
              "130200305"
            ]
          },
          "130200305": {
            "id": "130200305",
            "speakerId": 13091,
            "speakerName": "阿拉夫",
            "text": "哦？不介意的话，可否先跟我聊一聊？",
            "nextDialogs": [
              "130200306"
            ]
          },
          "130200306": {
            "id": "130200306",
            "speakerId": 13003,
            "speakerName": "伊利亚斯",
            "text": "……",
            "nextDialogs": [
              "130200307"
            ]
          },
          "130200307": {
            "id": "130200307",
            "speakerId": 13003,
            "speakerName": "伊利亚斯",
            "text": "西拉杰…",
            "nextDialogs": [
              "130200308"
            ]
          },
          "130200308": {
            "id": "130200308",
            "speakerId": 13091,
            "speakerName": "阿拉夫",
            "text": "西拉杰？这个名字听上去很耳熟，是因论派那位学者吗？",
            "nextDialogs": [
              "130200309"
            ]
          },
          "130200309": {
            "id": "130200309",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "因论派的学者？",
            "nextDialogs": [
              "130200310"
            ]
          },
          "130200310": {
            "id": "130200310",
            "speakerId": 13091,
            "speakerName": "阿拉夫",
            "text": "嗯。因论派风头鼎盛的学者，听说是一位敢想敢做的天才。",
            "nextDialogs": [
              "130200311"
            ]
          },
          "130200311": {
            "id": "130200311",
            "speakerId": 13091,
            "speakerName": "阿拉夫",
            "text": "也有消息说他可能会代表因论派成为下任贤者之一…你接着说，西拉杰怎么了？",
            "nextDialogs": [
              "130200312"
            ]
          },
          "130200312": {
            "id": "130200312",
            "speakerId": 13003,
            "speakerName": "伊利亚斯",
            "text": "我要揭发…西拉杰正在做一个危险的实验。",
            "nextDialogs": [
              "130200313"
            ]
          },
          "130200313": {
            "id": "130200313",
            "speakerId": 13003,
            "speakerName": "伊利亚斯",
            "text": "他绑架了我。把我绑到那个可怕的山洞里…到处都是实验器材…",
            "nextDialogs": [
              "130200314"
            ]
          },
          "130200314": {
            "id": "130200314",
            "speakerId": 13003,
            "speakerName": "伊利亚斯",
            "text": "我拼命地跑…只差一点，我就被他抓住了…",
            "nextDialogs": [
              "130200315"
            ]
          },
          "130200315": {
            "id": "130200315",
            "speakerId": 13091,
            "speakerName": "阿拉夫",
            "text": "别紧张，慢慢说。",
            "nextDialogs": [
              "130200316"
            ]
          },
          "130200316": {
            "id": "130200316",
            "speakerId": 13091,
            "speakerName": "阿拉夫",
            "text": "他在做什么实验？那个山洞在哪里？",
            "nextDialogs": [
              "130200317"
            ]
          },
          "130200317": {
            "id": "130200317",
            "speakerId": 13003,
            "speakerName": "伊利亚斯",
            "text": "我不记得了…",
            "nextDialogs": [
              "130200318"
            ]
          },
          "130200318": {
            "id": "130200318",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "欸？这么重要的事，你竟然不记得了？",
            "nextDialogs": [
              "130200319"
            ]
          },
          "130200319": {
            "id": "130200319",
            "speakerId": 13003,
            "speakerName": "伊利亚斯",
            "text": "我只记得西拉杰朝我走来，之后我的脑袋就开始变得不正常。",
            "nextDialogs": [
              "130200320"
            ]
          },
          "130200320": {
            "id": "130200320",
            "speakerId": 13003,
            "speakerName": "伊利亚斯",
            "text": "我忘了很多东西，就像做了一场噩梦。但我知道那里很危险，必须立刻阻止他们！",
            "nextDialogs": [
              "130200321"
            ]
          },
          "130200321": {
            "id": "130200321",
            "speakerId": 13003,
            "speakerName": "伊利亚斯",
            "text": "对了，我还听说他们会在酒馆做交易，得快一点…",
            "nextDialogs": [
              "130200322"
            ]
          },
          "130200322": {
            "id": "130200322",
            "speakerId": 13091,
            "speakerName": "阿拉夫",
            "text": "就算你这么说…好吧，我会让我的同事去查西拉杰的情况。",
            "nextDialogs": [
              "130200323"
            ]
          },
          "130200323": {
            "id": "130200323",
            "speakerId": 13091,
            "speakerName": "阿拉夫",
            "text": "不过在那之前，我希望你接受风纪官的「测谎」调查。",
            "nextDialogs": [
              "130200324"
            ]
          },
          "130200324": {
            "id": "130200324",
            "speakerId": 13003,
            "speakerName": "伊利亚斯",
            "text": "你在怀疑我？",
            "nextDialogs": [
              "130200325"
            ]
          },
          "130200325": {
            "id": "130200325",
            "speakerId": 13091,
            "speakerName": "阿拉夫",
            "text": "不要误会，只是惯例而已。",
            "nextDialogs": [
              "130200326"
            ]
          },
          "130200326": {
            "id": "130200326",
            "speakerId": 13091,
            "speakerName": "阿拉夫",
            "text": "劳烦两位在这稍等一会儿，我们很快就会回来。",
            "nextDialogs": [
              "130200327"
            ]
          },
          "130200327": {
            "id": "130200327",
            "speakerId": 1011,
            "speakerName": "Black Screen",
            "text": "等待的时间似乎比预期中更长一些…",
            "nextDialogs": [
              "130200328"
            ]
          },
          "130200328": {
            "id": "130200328",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "咦，艾尔海森？你怎么在这？",
            "nextDialogs": [
              "130200329"
            ]
          },
          "130200329": {
            "id": "130200329",
            "speakerId": 13091,
            "speakerName": "阿拉夫",
            "text": "我来解释一下吧，刚刚我带伊利亚斯去测谎，他顺利通过了。",
            "nextDialogs": [
              "130200330"
            ]
          },
          "130200330": {
            "id": "130200330",
            "speakerId": 13091,
            "speakerName": "阿拉夫",
            "text": "这意味着他说的话有很高的可信度，我们决定围绕他提供的线索展开调查。",
            "nextDialogs": [
              "130200331"
            ]
          },
          "130200331": {
            "id": "130200331",
            "speakerId": 13091,
            "speakerName": "阿拉夫",
            "text": "这件事按惯例汇报给了艾尔海森大人，他听完之后先是给赛诺大人留了封信，然后提出要和我们一起行动。",
            "nextDialogs": [
              "130200332"
            ]
          },
          "130200332": {
            "id": "130200332",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "奇怪，艾尔海森居然会和风纪官一起行动，莫非有什么特别的原因？",
            "nextDialogs": [
              "130200333"
            ]
          },
          "130200333": {
            "id": "130200333",
            "speakerId": 1053,
            "speakerName": "艾尔海森",
            "text": "想多了，只是有点兴趣而已。",
            "nextDialogs": [
              "130200334"
            ]
          },
          "130200334": {
            "id": "130200334",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "是吗？你还有这种闲暇呢…",
            "nextDialogs": [
              "130200335"
            ]
          },
          "130200335": {
            "id": "130200335",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "#{NICKNAME}，不如我们也一起去看看吧？",
            "nextDialogs": [
              "130200336"
            ]
          },
          "130200336": {
            "id": "130200336",
            "speakerId": 13091,
            "speakerName": "阿拉夫",
            "text": "艾尔海森大人参与我们的行动已经是违规情况了，你们…",
            "nextDialogs": [
              "130200337"
            ]
          },
          "130200337": {
            "id": "130200337",
            "speakerId": 13091,
            "speakerName": "阿拉夫",
            "text": "算了，毕竟伊利亚斯是你们带来的。我可以允许你们一起来，前提是你们必须对一切计划保密。",
            "nextDialogs": [
              "130200338"
            ]
          },
          "130200338": {
            "id": "130200338",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "放心，我们的嘴巴可是很严的！",
            "nextDialogs": [
              "130200339"
            ]
          },
          "130200339": {
            "id": "130200339",
            "speakerId": 13091,
            "speakerName": "阿拉夫",
            "text": "那我先说一下目前掌握的线索吧。",
            "nextDialogs": [
              "130200340"
            ]
          },
          "130200340": {
            "id": "130200340",
            "speakerId": 13091,
            "speakerName": "阿拉夫",
            "text": "伊利亚斯声称西拉杰会与某位妙论派学者在酒馆进行交易。这是他为数不多的清醒回忆，似乎是在逃跑的时候偶然听到的。",
            "nextDialogs": [
              "130200341"
            ]
          },
          "130200341": {
            "id": "130200341",
            "speakerId": 13091,
            "speakerName": "阿拉夫",
            "text": "顺便一提，西拉杰目前并不在教令院，他在一个月前就申请了长期外出调研。",
            "nextDialogs": [
              "130200342"
            ]
          },
          "130200342": {
            "id": "130200342",
            "speakerId": 13091,
            "speakerName": "阿拉夫",
            "text": "距离伊利亚斯提供的交易时间很近了，我们决定立刻赶往酒馆，搜查可疑人员。",
            "nextDialogs": [
              "130200343"
            ]
          },
          "130200343": {
            "id": "130200343",
            "speakerId": 1053,
            "speakerName": "艾尔海森",
            "text": "就是这样。准备出发，你们随意。",
            "nextDialogs": [
              "130200344"
            ]
          },
          "130200344": {
            "id": "130200344",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "都说了我们要一起去啦！"
          }
        }
      }
    },
    {
      "subId": "1302004",
      "subQuestName": "前往酒馆",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [],
        "dialogs": {}
      }
    },
    {
      "subId": "1302005",
      "subQuestName": "搜捕嫌疑人",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "130200501"
        ],
        "dialogs": {
          "130200501": {
            "id": "130200501",
            "speakerId": 13091,
            "speakerName": "阿拉夫",
            "text": "我们到了，艾尔海森大人。接下来该怎么做？",
            "nextDialogs": [
              "130200502"
            ]
          },
          "130200502": {
            "id": "130200502",
            "speakerId": 1053,
            "speakerName": "艾尔海森",
            "text": "……",
            "nextDialogs": [
              "130200503"
            ]
          },
          "130200503": {
            "id": "130200503",
            "speakerId": 13091,
            "speakerName": "阿拉夫",
            "text": "艾尔海森大人？",
            "nextDialogs": [
              "130200504"
            ]
          },
          "130200504": {
            "id": "130200504",
            "speakerId": 1053,
            "speakerName": "艾尔海森",
            "text": "看来你最近没看任何文书。",
            "nextDialogs": [
              "130200505"
            ]
          },
          "130200505": {
            "id": "130200505",
            "speakerId": 1053,
            "speakerName": "艾尔海森",
            "text": "新颁布的教令明确提出，对于已经确立的调查案，即便是贤者出面也无权干预风纪官行动。",
            "nextDialogs": [
              "130200506"
            ]
          },
          "130200506": {
            "id": "130200506",
            "speakerId": 1053,
            "speakerName": "艾尔海森",
            "text": "如果你们的上司在，他不会问我该做什么，反而会警告我「不要指手画脚」。",
            "nextDialogs": [
              "130200507"
            ]
          },
          "130200507": {
            "id": "130200507",
            "speakerId": 13091,
            "speakerName": "阿拉夫",
            "text": "…您说得没错，我明白了。那请您在这里稍等，我们立刻封锁周边区域，搜查可疑人员！",
            "nextDialogs": [
              "130200508"
            ]
          },
          "130200508": {
            "id": "130200508",
            "speakerId": 13091,
            "speakerName": "阿拉夫",
            "text": "伊利亚斯就留在这里吧，也劳烦艾尔海森大人保护主要证人了。",
            "nextDialogs": [
              "130200509"
            ]
          },
          "130200509": {
            "id": "130200509",
            "speakerId": 1053,
            "speakerName": "艾尔海森",
            "text": "可以。他要是能保护好自己就更好了。",
            "nextDialogs": [
              "130200510"
            ]
          },
          "130200510": {
            "id": "130200510",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "果然还是老样子…之前在阿如村的时候就是这样，动不动就不理人！",
            "nextDialogs": [
              "130200511"
            ]
          },
          "130200511": {
            "id": "130200511",
            "speakerId": 1053,
            "speakerName": "艾尔海森",
            "text": "回答没水平的问题，是对发问者的纵容，而且我需要让他清楚地明白我的态度。",
            "nextDialogs": [
              "130200512"
            ]
          },
          "130200512": {
            "id": "130200512",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "什么意思？",
            "nextDialogs": [
              "130200513"
            ]
          },
          "130200513": {
            "id": "130200513",
            "speakerId": 1053,
            "speakerName": "艾尔海森",
            "text": "和你们一样，阿拉夫也疑惑我为什么会跟来。",
            "nextDialogs": [
              "130200514"
            ]
          },
          "130200514": {
            "id": "130200514",
            "speakerId": 1053,
            "speakerName": "艾尔海森",
            "text": "但和你们不同的是，他把这个问题想得更复杂，比如「代理贤者想要染指风纪官的权力 」。",
            "nextDialogs": [
              "130200515"
            ]
          },
          "130200515": {
            "id": "130200515",
            "speakerId": 1053,
            "speakerName": "艾尔海森",
            "text": "他向我提问，明显是在试探。风纪官早先受到贤者影响，难免被卷入这种官僚陷阱。",
            "nextDialogs": [
              "130200516"
            ]
          },
          "130200516": {
            "id": "130200516",
            "speakerId": 1053,
            "speakerName": "艾尔海森",
            "text": "但他根本不需要那样说，我希望他了解，这一次我不会插手他们的工作。",
            "nextDialogs": [
              "130200517"
            ]
          },
          "130200517": {
            "id": "130200517",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "好复杂！",
            "nextDialogs": [
              "130200518"
            ]
          },
          "130200518": {
            "id": "130200518",
            "speakerId": 1053,
            "speakerName": "艾尔海森",
            "text": "所以我起初一直反对当什么代理贤者。头衔会让很多事变得麻烦，在所难免。",
            "nextDialogs": [
              "130200519"
            ]
          },
          "130200519": {
            "id": "130200519",
            "speakerId": 13003,
            "speakerName": "伊利亚斯",
            "text": "打扰一下…艾尔海森大人。",
            "nextDialogs": [
              "130200520"
            ]
          },
          "130200520": {
            "id": "130200520",
            "speakerId": 13003,
            "speakerName": "伊利亚斯",
            "text": "我有个问题，无论如何都想问——我们以前，见过面吗？",
            "nextDialogs": [
              "130200521"
            ]
          },
          "130200521": {
            "id": "130200521",
            "speakerId": 1053,
            "speakerName": "艾尔海森",
            "text": "没有，我对你毫无印象。",
            "nextDialogs": [
              "130200522"
            ]
          },
          "130200522": {
            "id": "130200522",
            "speakerId": 13003,
            "speakerName": "伊利亚斯",
            "text": "哈哈…我想也是，我跟您这样的人应该没什么交集才对。",
            "nextDialogs": [
              "130200523"
            ]
          },
          "130200523": {
            "id": "130200523",
            "speakerId": 1053,
            "speakerName": "艾尔海森",
            "text": "那又为什么要问？",
            "nextDialogs": [
              "130200524"
            ]
          },
          "130200524": {
            "id": "130200524",
            "speakerId": 13003,
            "speakerName": "伊利亚斯",
            "text": "因为第一次见到您时，不知道为什么总有一种…熟悉的感觉。",
            "nextDialogs": [
              "130200525"
            ]
          },
          "130200525": {
            "id": "130200525",
            "speakerId": 1053,
            "speakerName": "艾尔海森",
            "text": "是吗？",
            "nextDialogs": [
              "130200526"
            ]
          },
          "130200526": {
            "id": "130200526",
            "speakerId": 1053,
            "speakerName": "艾尔海森",
            "text": "错觉？或者是…",
            "nextDialogs": [
              "130200527"
            ]
          },
          "130200527": {
            "id": "130200527",
            "speakerId": 13091,
            "speakerName": "阿拉夫",
            "text": "艾尔海森大人，我们抓到嫌疑人了！",
            "nextDialogs": [
              "130200528"
            ]
          },
          "130200528": {
            "id": "130200528",
            "speakerId": 1053,
            "speakerName": "艾尔海森",
            "text": "西拉杰？",
            "nextDialogs": [
              "130200529"
            ]
          },
          "130200529": {
            "id": "130200529",
            "speakerId": 13091,
            "speakerName": "阿拉夫",
            "text": "不，是和他做交易的妙论派学者，名叫纳兰德拉。",
            "nextDialogs": [
              "130200530"
            ]
          },
          "130200530": {
            "id": "130200530",
            "speakerId": 13008,
            "speakerName": "纳兰德拉",
            "text": "艾、艾尔海森大人？",
            "nextDialogs": [
              "130200531"
            ]
          },
          "130200531": {
            "id": "130200531",
            "speakerId": 13008,
            "speakerName": "纳兰德拉",
            "text": "等等，有人能跟我解释一下吗？我承认我确实从实验室偷了些机械零件往外卖，这是需要代理贤者亲自过问的案件吗？",
            "nextDialogs": [
              "130200532"
            ]
          },
          "130200532": {
            "id": "130200532",
            "speakerId": 13008,
            "speakerName": "纳兰德拉",
            "text": "我的天，我该不会卷入什么大麻烦里了吧？我，我只是一时利欲熏心，还请各位手下留情…",
            "nextDialogs": [
              "130200533"
            ]
          },
          "130200533": {
            "id": "130200533",
            "speakerId": 1053,
            "speakerName": "艾尔海森",
            "text": "我想问他几个问题。",
            "nextDialogs": [
              "130200534"
            ]
          },
          "130200534": {
            "id": "130200534",
            "speakerId": 13091,
            "speakerName": "阿拉夫",
            "text": "当然可以。",
            "nextDialogs": [
              "130200535"
            ]
          },
          "130200535": {
            "id": "130200535",
            "speakerId": 1053,
            "speakerName": "艾尔海森",
            "text": "你认识西拉杰？",
            "nextDialogs": [
              "130200536"
            ]
          },
          "130200536": {
            "id": "130200536",
            "speakerId": 13008,
            "speakerName": "纳兰德拉",
            "text": "听过，买家的名字。他约我在酒馆做交易，不过迟迟未到…",
            "nextDialogs": [
              "130200537"
            ]
          },
          "130200537": {
            "id": "130200537",
            "speakerId": 1053,
            "speakerName": "艾尔海森",
            "text": "交易的内容是什么？",
            "nextDialogs": [
              "130200538"
            ]
          },
          "130200538": {
            "id": "130200538",
            "speakerId": 13008,
            "speakerName": "纳兰德拉",
            "text": "他不知道在做什么实验，好像需要很多能源与电路元件，只有我们项目有。",
            "nextDialogs": [
              "130200539"
            ]
          },
          "130200539": {
            "id": "130200539",
            "speakerId": 13008,
            "speakerName": "纳兰德拉",
            "text": "他私下联系我，让我假借「淘汰损毁」之名昧下来一些，他会高价收购。",
            "nextDialogs": [
              "130200540"
            ]
          },
          "130200540": {
            "id": "130200540",
            "speakerId": 13008,
            "speakerName": "纳兰德拉",
            "text": "本来我们约好今天在酒馆交易，谁想到我先是被放了鸽子，又遇到了你们…",
            "nextDialogs": [
              "130200541"
            ]
          },
          "130200541": {
            "id": "130200541",
            "speakerId": 13091,
            "speakerName": "阿拉夫",
            "text": "也许是西拉杰察觉到伊利亚斯有可能会透露消息，所以故意没来赴约？不管怎么说，线索到这里似乎就断掉了。",
            "nextDialogs": [
              "130200542"
            ]
          },
          "130200542": {
            "id": "130200542",
            "speakerId": 13091,
            "speakerName": "阿拉夫",
            "text": "好消息是不管西拉杰想做什么，没有这批能源与电路，他的进度肯定会受到阻碍。我们还有时间慢慢调查。",
            "nextDialogs": [
              "130200543"
            ]
          },
          "130200543": {
            "id": "130200543",
            "speakerId": 13091,
            "speakerName": "阿拉夫",
            "text": "您还有什么问题吗？",
            "nextDialogs": [
              "130200544"
            ]
          },
          "130200544": {
            "id": "130200544",
            "speakerId": 1053,
            "speakerName": "艾尔海森",
            "text": "没有了，纳兰德拉交给你们带走。另外，我还想再「借」伊利亚斯一段时间。",
            "nextDialogs": [
              "130200545"
            ]
          },
          "130200545": {
            "id": "130200545",
            "speakerId": 13091,
            "speakerName": "阿拉夫",
            "text": "哦，这个没关系。",
            "nextDialogs": [
              "130200546"
            ]
          },
          "130200546": {
            "id": "130200546",
            "speakerId": 13091,
            "speakerName": "阿拉夫",
            "text": "我们对伊利亚斯进行了全方位的测谎，他确实不记得更多事情，我们也不打算从他这里寻找突破。",
            "nextDialogs": [
              "130200547"
            ]
          },
          "130200547": {
            "id": "130200547",
            "speakerId": 13091,
            "speakerName": "阿拉夫",
            "text": "不过顺便问下，您留下他的理由是？",
            "nextDialogs": [
              "130200548"
            ]
          },
          "130200548": {
            "id": "130200548",
            "speakerId": 1053,
            "speakerName": "艾尔海森",
            "text": "我以前看过一些关于失忆的论文，想尝试引导他恢复记忆。",
            "nextDialogs": [
              "130200549"
            ]
          },
          "130200549": {
            "id": "130200549",
            "speakerId": 13091,
            "speakerName": "阿拉夫",
            "text": "原来如此…那我们先回教令院，伊利亚斯就拜托您了。",
            "nextDialogs": [
              "130200550"
            ]
          },
          "130200550": {
            "id": "130200550",
            "speakerId": 1053,
            "speakerName": "艾尔海森",
            "text": "跟我来。"
          }
        }
      }
    },
    {
      "subId": "1302011",
      "subQuestName": "寻找一个安静的地方",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [],
        "dialogs": {}
      }
    },
    {
      "subId": "1302012",
      "subQuestName": "与艾尔海森对话",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "130201201"
        ],
        "dialogs": {
          "130201201": {
            "id": "130201201",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "结果西拉杰根本没来酒馆，纳兰德拉也没有什么线索…好像陷入僵局了。",
            "nextDialogs": [
              "130201202"
            ]
          },
          "130201202": {
            "id": "130201202",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "艾尔海森，你真的打算管到底吗？总觉得你对这件事格外有兴趣，我都有点意外了…",
            "nextDialogs": [
              "130201203"
            ]
          },
          "130201203": {
            "id": "130201203",
            "speakerId": 1053,
            "speakerName": "艾尔海森",
            "text": "我还以为你已经猜到原因了。",
            "nextDialogs": [
              "130201204"
            ]
          },
          "130201204": {
            "id": "130201204",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "#欸？我没猜到呀，{NICKNAME}，你猜到了吗？",
            "nextDialogs": [
              "130201205"
            ]
          },
          "130201205": {
            "id": "130201205",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "你认识西拉杰？",
            "nextDialogs": [
              "130201206"
            ]
          },
          "130201206": {
            "id": "130201206",
            "speakerId": 1053,
            "speakerName": "艾尔海森",
            "text": "嗯，同届的同学。",
            "nextDialogs": [
              "130201207"
            ]
          },
          "130201207": {
            "id": "130201207",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "原来是这样！所以阿拉夫跟你汇报的时候，你才提出要跟来看看！",
            "nextDialogs": [
              "130201208"
            ]
          },
          "130201208": {
            "id": "130201208",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "你对这个案子感兴趣不是因为内容，而是因为嫌疑犯是认识的人？",
            "nextDialogs": [
              "130201209"
            ]
          },
          "130201209": {
            "id": "130201209",
            "speakerId": 1053,
            "speakerName": "艾尔海森",
            "text": "你的描述跟事实相差甚远，不过我并没有寄希望于你能得出更准确的答案。",
            "nextDialogs": [
              "130201210"
            ]
          },
          "130201210": {
            "id": "130201210",
            "speakerId": 1053,
            "speakerName": "艾尔海森",
            "text": "你暂时这么理解就可以了。我跟他是同届入学，后来我当了书记官，而他继续在学术上深造。",
            "nextDialogs": [
              "130201211"
            ]
          },
          "130201211": {
            "id": "130201211",
            "speakerId": 1053,
            "speakerName": "艾尔海森",
            "text": "一年前，他提交了一份课题申请。当时的大贤者看后问我意见，我并不怎么看好，因为从结果来说，它触及了六宗根源之罪中的「人类进化之事」。",
            "nextDialogs": [
              "130201212"
            ]
          },
          "130201212": {
            "id": "130201212",
            "speakerId": 1053,
            "speakerName": "艾尔海森",
            "text": "从「人类进化之事」到「慢言奥秘而心无惧怕之事」，六宗根源之罪是此世万般罪责的开端，也是贤者们制定和修正教令的参照。",
            "nextDialogs": [
              "130201213"
            ]
          },
          "130201213": {
            "id": "130201213",
            "speakerId": 1053,
            "speakerName": "艾尔海森",
            "text": "西拉杰的研究在我看来过于天真，但结果上他确实触犯了底线。大贤者参考了各种意见，那份报告最终被驳回。",
            "nextDialogs": [
              "130201214"
            ]
          },
          "130201214": {
            "id": "130201214",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "所以他购买能源和电路元件…",
            "nextDialogs": [
              "130201215"
            ]
          },
          "130201215": {
            "id": "130201215",
            "speakerId": 1053,
            "speakerName": "艾尔海森",
            "text": "多半是想在不被允许的情况下，私自进行实验。",
            "nextDialogs": [
              "130201216"
            ]
          },
          "130201216": {
            "id": "130201216",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "听上去好可疑，还是阻止他比较好吧。",
            "nextDialogs": [
              "130201217"
            ]
          },
          "130201217": {
            "id": "130201217",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "伊利亚斯，你再努力想想，看看会不会有什么新发现？",
            "nextDialogs": [
              "130201218"
            ]
          },
          "130201218": {
            "id": "130201218",
            "speakerId": 13003,
            "speakerName": "伊利亚斯",
            "text": "抱歉。我试过很多次，但无论我怎么回忆，那些事都像是隔着厚厚的迷雾。",
            "nextDialogs": [
              "130201219"
            ]
          },
          "130201219": {
            "id": "130201219",
            "speakerId": 1053,
            "speakerName": "艾尔海森",
            "text": "人在受到强烈的刺激后，可能会下意识割舍部分记忆，以此达到自我保护的目的。",
            "nextDialogs": [
              "130201220"
            ]
          },
          "130201220": {
            "id": "130201220",
            "speakerId": 1053,
            "speakerName": "艾尔海森",
            "text": "但这些记忆并不是真的消失，只是暂时被封存了。给予适当刺激，仍然有恢复的可能。",
            "nextDialogs": [
              "130201221"
            ]
          },
          "130201221": {
            "id": "130201221",
            "speakerId": 1053,
            "speakerName": "艾尔海森",
            "text": "试着回忆一下你在意的事情吧，不必非要和案件有关。",
            "nextDialogs": [
              "130201222"
            ]
          },
          "130201222": {
            "id": "130201222",
            "speakerId": 13003,
            "speakerName": "伊利亚斯",
            "text": "其实，我感觉我忘掉的事情有很多，不仅仅只有被抓去做实验的部分。",
            "nextDialogs": [
              "130201223"
            ]
          },
          "130201223": {
            "id": "130201223",
            "speakerId": 13003,
            "speakerName": "伊利亚斯",
            "text": "我是一个什么样的人、做过些什么事，有些我能记起来，有些不管怎么想都没有头绪。",
            "nextDialogs": [
              "130201224"
            ]
          },
          "130201224": {
            "id": "130201224",
            "speakerId": 13003,
            "speakerName": "伊利亚斯",
            "text": "不过我隐约记得，自己有两件「不得不做的事」。",
            "nextDialogs": [
              "130201225"
            ]
          },
          "130201225": {
            "id": "130201225",
            "speakerId": 1053,
            "speakerName": "艾尔海森",
            "text": "说来听听。",
            "nextDialogs": [
              "130201226"
            ]
          },
          "130201226": {
            "id": "130201226",
            "speakerId": 13003,
            "speakerName": "伊利亚斯",
            "text": "第一件事是「从教令院领取薪水，送给在化城郭的妹妹」。",
            "nextDialogs": [
              "130201227"
            ]
          },
          "130201227": {
            "id": "130201227",
            "speakerId": 13003,
            "speakerName": "伊利亚斯",
            "text": "我不清楚详情…只记得以前我似乎每个月都会把钱给妹妹，让她补贴家用。",
            "nextDialogs": [
              "130201228"
            ]
          },
          "130201228": {
            "id": "130201228",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "那第二件呢？第二件事是什么？",
            "nextDialogs": [
              "130201229"
            ]
          },
          "130201229": {
            "id": "130201229",
            "speakerId": 13003,
            "speakerName": "伊利亚斯",
            "text": "想不起来。抱歉，我真的忘了太多东西。",
            "nextDialogs": [
              "130201230"
            ]
          },
          "130201230": {
            "id": "130201230",
            "speakerId": 1053,
            "speakerName": "艾尔海森",
            "text": "不意外。",
            "nextDialogs": [
              "130201231"
            ]
          },
          "130201231": {
            "id": "130201231",
            "speakerId": 1053,
            "speakerName": "艾尔海森",
            "text": "目前只有你见过西拉杰，只有你知道那个山洞的具体位置。所以，我们会提供一切必要支持，帮助你恢复记忆。",
            "nextDialogs": [
              "130201232"
            ]
          },
          "130201232": {
            "id": "130201232",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "失去记忆…一定很痛苦吧，不过我们会帮你想起来的！",
            "nextDialogs": [
              "130201233"
            ]
          },
          "130201233": {
            "id": "130201233",
            "speakerId": 13003,
            "speakerName": "伊利亚斯",
            "text": "多谢。不仅仅是「痛苦」，我不知道该如何形容这种感觉…",
            "nextDialogs": [
              "130201234"
            ]
          },
          "130201234": {
            "id": "130201234",
            "speakerId": 13003,
            "speakerName": "伊利亚斯",
            "text": "丢失了太多记忆，让我对自己的认知都变得模糊。脑袋嗡嗡作响，好像下一刻就要失去意识。",
            "nextDialogs": [
              "130201235"
            ]
          },
          "130201235": {
            "id": "130201235",
            "speakerId": 13003,
            "speakerName": "伊利亚斯",
            "text": "但在这种令人作呕的感觉中，我又像是得到了解脱…",
            "nextDialogs": [
              "130201236"
            ]
          },
          "130201236": {
            "id": "130201236",
            "speakerId": 13003,
            "speakerName": "伊利亚斯",
            "text": "不管怎么说，多亏了你们，我变得稍微清醒一些了。",
            "nextDialogs": [
              "130201237"
            ]
          },
          "130201237": {
            "id": "130201237",
            "speakerId": 13003,
            "speakerName": "伊利亚斯",
            "text": "我记得我在教令院中一个叫做「调研筹备处」的地方兼职，每个月也是在那里领取薪水的。",
            "nextDialogs": [
              "130201238"
            ]
          },
          "130201238": {
            "id": "130201238",
            "speakerId": 1053,
            "speakerName": "艾尔海森",
            "text": "我明白了。那就先去找那边的负责人，走吧。"
          }
        }
      }
    },

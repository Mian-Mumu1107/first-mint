    {
      "subId": "1302010",
      "subQuestName": "(test)逮捕嫌疑人",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "130201001"
        ],
        "dialogs": {
          "130201001": {
            "id": "130201001",
            "speakerId": 12772,
            "speakerName": "纳比尔",
            "text": "(test)在风纪官的压力下，学者坦白说自己确实是从教令院偷了些器材往外卖，不过买家迟迟未到，他正准备溜的时候被抓了。\\n艾尔海森询问对方是否认识西拉杰，对方说听过，是买家的名字。艾尔海森又问你卖的是什么，对方说是一些妙论派最新的研制成果，主要是用于搭建复杂机械的电路元件与能源。艾尔海森听完摆摆手，让风纪官去处理这个人。"
          }
        }
      }
    },
    {
      "subId": "1302014",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "130201401"
        ],
        "dialogs": {
          "130201401": {
            "id": "130201401",
            "speakerId": 13030,
            "speakerName": "兰丘",
            "text": "说起来，我有个老朋友也在蒙德，不如我们一起去？还能拜托他当导游，领我们到处逛逛。",
            "nextDialogs": [
              "130201402"
            ]
          },
          "130201402": {
            "id": "130201402",
            "speakerId": 13031,
            "speakerName": "皮雅",
            "text": "好呀，谢谢前辈。"
          }
        }
      }
    },
    {
      "subId": "1302099",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "130209901"
        ],
        "dialogs": {
          "130209901": {
            "id": "130209901",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "说起来，听说艾尔海森当上了代理贤者…以那家伙的性格，真的没问题吗？",
            "nextDialogs": [
              "130209902"
            ]
          },
          "130209902": {
            "id": "130209902",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "不如我们去教令院打听一下吧！",
            "nextDialogs": [
              "130209905"
            ]
          },
          "130209905": {
            "id": "130209905",
            "speakerId": 13030,
            "speakerName": "兰丘",
            "text": "（不知道学妹的课题还顺利吗？）",
            "nextDialogs": [
              "130209906"
            ]
          },
          "130209906": {
            "id": "130209906",
            "speakerId": 13031,
            "speakerName": "皮雅",
            "text": "（松了口气…）",
            "nextDialogs": [
              "130209907"
            ]
          },
          "130209907": {
            "id": "130209907",
            "speakerId": 13030,
            "speakerName": "兰丘",
            "text": "（好想跟学妹一起去蒙德玩啊。）",
            "nextDialogs": [
              "130209908"
            ]
          },
          "130209908": {
            "id": "130209908",
            "speakerId": 13031,
            "speakerName": "皮雅",
            "text": "（难得的休息…）",
            "nextDialogs": [
              "130209909"
            ]
          },
          "130209909": {
            "id": "130209909",
            "speakerId": 13091,
            "speakerName": "阿拉夫",
            "text": "（维护风纪，不能有丝毫懈怠。）"
          }
        }
      }
    }
  ]

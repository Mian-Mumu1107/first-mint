    {
      "subId": "7607611",
      "subQuestName": "(test)隐藏任务——结算流程",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "760761101"
        ],
        "dialogs": {
          "760761101": {
            "id": "760761101",
            "speakerId": 1314,
            "speakerName": "菲林斯",
            "text": "你好，我的朋友，很高兴与你墓里再会。",
            "nextDialogs": [
              "760761102"
            ]
          },
          "760761102": {
            "id": "760761102",
            "speakerId": 1001,
            "speakerName": "Black Screen",
            "text": "向菲林斯描述了你所见到的「誓言之灯」与灯上不明意义的话语。",
            "nextDialogs": [
              "760761103"
            ]
          },
          "760761103": {
            "id": "760761103",
            "speakerId": 1314,
            "speakerName": "菲林斯",
            "text": "「风已醒来，落叶飞旋」…这是人们在加入执灯人时立下的誓言。",
            "nextDialogs": [
              "760761104"
            ]
          },
          "760761104": {
            "id": "760761104",
            "speakerId": 1314,
            "speakerName": "菲林斯",
            "text": "平时每一个执灯人成员都会随身携带自己的灯，只有在最无奈的情况下，他们才会放弃照看自己的灯。",
            "nextDialogs": [
              "760761105"
            ]
          },
          "760761105": {
            "id": "760761105",
            "speakerId": 1314,
            "speakerName": "菲林斯",
            "text": "每一盏无主的灯恐怕都意味着一桩不幸，我很遗憾。",
            "nextDialogs": [
              "760761106"
            ]
          },
          "760761106": {
            "id": "760761106",
            "speakerId": 1314,
            "speakerName": "菲林斯",
            "text": "不过早在立誓之时，他们就已经明白这种命运无可避免。",
            "nextDialogs": [
              "760761107"
            ]
          },
          "760761107": {
            "id": "760761107",
            "speakerId": 1314,
            "speakerName": "菲林斯",
            "text": "如果说还有什么我们能为他们做的事，那就只有铭记了，铭记他们的誓言吧。",
            "nextDialogs": [
              "760761108"
            ]
          },
          "760761108": {
            "id": "760761108",
            "speakerId": 1314,
            "speakerName": "菲林斯",
            "text": "「守护永燃的希望」…这是他们最大的愿望。"
          }
        }
      }
    },

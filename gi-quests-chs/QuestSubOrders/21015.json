  "subQuests": [
    {
      "subId": "2101501",
      "subQuestName": "任务开启$HIDDEN",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "210120601"
        ],
        "dialogs": {
          "210120601": {
            "id": "210120601",
            "speakerId": 2311,
            "speakerName": "小九九",
            "text": "我记得，我顺着河漂了很久，水很凉…手都冻僵了…",
            "nextDialogs": [
              "210120602"
            ]
          },
          "210120602": {
            "id": "210120602",
            "speakerId": 2311,
            "speakerName": "小九九",
            "text": "但是小九九没有把书放开喔！抓得很紧很紧，因为九哥说那本书很重要…",
            "nextDialogs": [
              "210120603"
            ]
          },
          "210120603": {
            "id": "210120603",
            "speakerId": 2311,
            "speakerName": "小九九",
            "text": "之后，我好不容易爬上了岸，想要把书找个地方晒一晒。",
            "nextDialogs": [
              "210120604"
            ]
          },
          "210120604": {
            "id": "210120604",
            "speakerId": 2311,
            "speakerName": "小九九",
            "text": "而且我好累，就躺在旁边睡了一会，醒过来的时候，书就不见了。",
            "nextDialogs": [
              "210120605"
            ]
          },
          "210120605": {
            "id": "210120605",
            "speakerId": 2311,
            "speakerName": "小九九",
            "text": "我记得很清楚，我就是在旁边的林子里面晒书的…请你帮我去林子里找找吧。"
          }
        }
      }
    },

        ],
        "dialogs": {
          "210120301": {
            "id": "210120301",
            "speakerId": 2311,
            "speakerName": "小九九",
            "text": "#{NICKNAME}，你找到了吗，那本书对九哥来说很重要…",
            "nextDialogs": [
              "210120302"
            ]
          },
          "210120302": {
            "id": "210120302",
            "speakerId": 2311,
            "speakerName": "小九九",
            "text": "如果找不到的话，九哥会难过的。",
            "nextDialogs": [
              "210120303"
            ]
          },
          "210120303": {
            "id": "210120303",
            "speakerId": 2311,
            "speakerName": "小九九",
            "text": "而且，要是他知道我把书弄丢了，说不定他会讨厌我的…"
          }
        }
      }
    }

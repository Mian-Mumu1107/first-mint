    {
      "subId": "7400228",
      "subQuestName": "与安对话",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [],
        "dialogs": {}
      }
    },
    {
      "subId": "7400225",
      "subQuestName": "与安对话",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "740030101"
        ],
        "dialogs": {
          "740030101": {
            "id": "740030101",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "感觉晕乎乎的…这里是…这里有很多书…",
            "nextDialogs": [
              "740030105",
              "740030104"
            ]
          },
          "740030105": {
            "id": "740030105",
            "speakerId": 20995,
            "speakerName": "安",
            "text": "这里…在我们来之前很久很久，就已经有这间藏书室了。",
            "nextDialogs": [
              "740030106"
            ]
          },
          "740030106": {
            "id": "740030106",
            "speakerId": 20995,
            "speakerName": "安",
            "text": "书中的内容似乎是很古老的戏剧剧本。孩子们很喜欢看书，但有很多东西看不懂，经常缠着大人给他们讲。",
            "nextDialogs": [
              "740030107"
            ]
          },
          "740030107": {
            "id": "740030107",
            "speakerId": 20995,
            "speakerName": "安",
            "text": "在故事当中，如果有恶龙，就会有征讨恶龙的勇者。如果有巫师，就会有流浪而来的骑士。国土总会光复，公主总会获救。",
            "nextDialogs": [
              "740030108"
            ]
          },
          "740030108": {
            "id": "740030108",
            "speakerId": 20995,
            "speakerName": "安",
            "text": "…当然，最后自鸣钟总会响起，冒险故事于是告一段落。",
            "nextDialogs": [
              "740030109"
            ]
          },
          "740030109": {
            "id": "740030109",
            "speakerId": 20995,
            "speakerName": "安",
            "text": "但冒险故事永远也不会结束，总会有下一场冒险、下一场冒险、下一场冒险，直到孩子们长大，将故事留下，离开这里。",
            "nextDialogs": [
              "740030110"
            ]
          },
          "740030110": {
            "id": "740030110",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "安？",
            "nextDialogs": [
              "740030111"
            ]
          },
          "740030111": {
            "id": "740030111",
            "speakerId": 20995,
            "speakerName": "安",
            "text": "啊？抱歉…刚刚感觉有一些记忆和感情，像潮水一样冲了过来。真奇怪…",
            "nextDialogs": [
              "740030112"
            ]
          },
          "740030112": {
            "id": "740030112",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "是喔…你没事就好，看你突然说这些，我还以为是中了什么纳西索斯的邪恶幻术呢！",
            "nextDialogs": [
              "740030113"
            ]
          },
          "740030113": {
            "id": "740030113",
            "speakerId": 20995,
            "speakerName": "安",
            "text": "哇！搞不好真的是这样！",
            "nextDialogs": [
              "740030114"
            ]
          },
          "740030114": {
            "id": "740030114",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "唔…接下来，我们应该怎么办呢？",
            "nextDialogs": [
              "740030115"
            ]
          },
          "740030115": {
            "id": "740030115",
            "speakerId": 20995,
            "speakerName": "安",
            "text": "我也不知道…",
            "nextDialogs": [
              "740030116"
            ]
          },
          "740030116": {
            "id": "740030116",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "总之，先观察一下吧…",
            "nextDialogs": [
              "740030117"
            ]
          },
          "740030117": {
            "id": "740030117",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "嗯！首先…那边有个门。不过，看起来没办法通过。",
            "nextDialogs": [
              "740030118"
            ]
          },
          "740030118": {
            "id": "740030118",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "你们应该能过去…",
            "nextDialogs": [
              "740030119"
            ]
          },
          "740030119": {
            "id": "740030119",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "#喂！现在你可是安的{NICKNAME}骑士，你要是不一起来就没意义了！",
            "nextDialogs": [
              "740030120"
            ]
          },
          "740030120": {
            "id": "740030120",
            "speakerId": 20995,
            "speakerName": "安",
            "text": "嗯！",
            "nextDialogs": [
              "740030121"
            ]
          },
          "740030121": {
            "id": "740030121",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "这一块地板看上去也很让人在意…"
          },
          "740030104": {
            "id": "740030104",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "哪来的枫丹的地下秘密书店遗迹啊！"
          }
        }
      }
    },
    {
      "subId": "7400299",

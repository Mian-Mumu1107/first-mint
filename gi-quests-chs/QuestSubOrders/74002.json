    {
      "subId": "7400223",
      "subQuestName": "抵达「高塔」的顶层",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [],
        "dialogs": {}
      }
    },
    {
      "subId": "7400216",
      "subQuestName": "抵达「高塔」的顶层",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "740021601"
        ],
        "dialogs": {
          "740021601": {
            "id": "740021601",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "欸？只有一个传送门…这个传送门，会通向什么地方呀？",
            "nextDialogs": [
              "740021602"
            ]
          },
          "740021602": {
            "id": "740021602",
            "speakerId": 20995,
            "speakerName": "安",
            "text": "嗯…我也不清楚耶。进入高塔之后的事情，我都没想过…不清楚会发生什么事情。",
            "nextDialogs": [
              "740021603"
            ]
          },
          "740021603": {
            "id": "740021603",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "是喔…那我们谨慎地前进吧。",
            "nextDialogs": [
              "740021605"
            ]
          },
          "740021605": {
            "id": "740021605",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "都要啦！",
            "nextDialogs": [
              "740021607"
            ]
          },
          "740021607": {
            "id": "740021607",
            "speakerId": 20995,
            "speakerName": "安",
            "text": "#嗯。{NICKNAME}骑士、派蒙，我们要小心。莉利丝公主只能靠我们了。"
          }
        }
      }
    },
    {
      "subId": "7400217",

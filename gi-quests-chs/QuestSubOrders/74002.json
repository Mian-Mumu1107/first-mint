    {
      "subId": "7400208",
      "subQuestName": "与安对话",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "740020801"
        ],
        "dialogs": {
          "740020801": {
            "id": "740020801",
            "speakerId": 20995,
            "speakerName": "安",
            "text": "终于找到了…最珍贵的宝物…",
            "nextDialogs": [
              "740020802"
            ]
          },
          "740020802": {
            "id": "740020802",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "看起来是一块怀表…",
            "nextDialogs": [
              "740020803"
            ]
          },
          "740020803": {
            "id": "740020803",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "似乎不会走了…",
            "nextDialogs": [
              "740020804"
            ]
          },
          "740020804": {
            "id": "740020804",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "唔，一直泡在水里，应该早就坏了吧？",
            "nextDialogs": [
              "740020805"
            ]
          },
          "740020805": {
            "id": "740020805",
            "speakerId": 20995,
            "speakerName": "安",
            "text": "在这里面，满满地装着莉利丝公主所有珍贵的时间。",
            "nextDialogs": [
              "740020806"
            ]
          },
          "740020806": {
            "id": "740020806",
            "speakerId": 20995,
            "speakerName": "安",
            "text": "……",
            "nextDialogs": [
              "740020807"
            ]
          },
          "740020807": {
            "id": "740020807",
            "speakerId": 20995,
            "speakerName": "安",
            "text": "我们回去吧。回到高塔下，与朋友们再会。"
          }
        }
      }
    },
    {
      "subId": "7400219",
      "subQuestName": "解除「高塔」的封印",
      "sceneId": null,
      "locations": [],
      "dialogue": {

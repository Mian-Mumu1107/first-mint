      }
    },
    {
      "subId": "7400210",
      "subQuestName": "解除「高塔」的封印",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "740021001"
        ],
        "dialogs": {
          "740021001": {
            "id": "740021001",
            "speakerId": 20996,
            "speakerName": "小卷心菜",
            "text": "你们回来了！",
            "nextDialogs": [
              "740021002"
            ]
          },
          "740021002": {
            "id": "740021002",
            "speakerId": 20997,
            "speakerName": "阿尔",
            "text": "凯特上校和莫里在你们行动的期间，也来和我们会合了。",
            "nextDialogs": [
              "740021003"
            ]
          },
          "740021003": {
            "id": "740021003",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "哼哼，我们已经拿到莉利丝公主的宝物啦！",
            "nextDialogs": [
              "740021004"
            ]
          },
          "740021004": {
            "id": "740021004",
            "speakerId": 21000,
            "speakerName": "凯特上校",
            "text": "干得好，士兵！这可是大功一件。抵抗阵线为你们骄傲！",
            "nextDialogs": [
              "740021005"
            ]
          },
          "740021005": {
            "id": "740021005",
            "speakerId": 20997,
            "speakerName": "阿尔",
            "text": "凯特，别…",
            "nextDialogs": [
              "740021006"
            ]
          },
          "740021006": {
            "id": "740021006",
            "speakerId": 20998,
            "speakerName": "雅克",
            "text": "#等等，「上校」。{NICKNAME}是我们管弦乐团的联络人，可不是什么杂牌军炮灰小兵。",
            "nextDialogs": [
              "740021007"
            ]
          },
          "740021007": {
            "id": "740021007",
            "speakerId": 21000,
            "speakerName": "凯特上校",
            "text": "#哈！如果你们组织容得下{NICKNAME}，那怕不是要改名叫{NICKNAME}管弦乐团才对！",
            "nextDialogs": [
              "740021008"
            ]
          },
          "740021008": {
            "id": "740021008",
            "speakerId": 20998,
            "speakerName": "雅克",
            "text": "#哼！你上校的头衔应该让给{NICKNAME}才对吧？",
            "nextDialogs": [
              "740021009"
            ]
          },
          "740021009": {
            "id": "740021009",
            "speakerId": 20998,
            "speakerName": "雅克",
            "text": "让士兵流血，自己居功的长官常见，但「上校」您这样不但一事无成，连风头都让士兵抢走的将校，那可真是珍稀动物！",
            "nextDialogs": [
              "740021010"
            ]
          },
          "740021010": {
            "id": "740021010",
            "speakerId": 21000,
            "speakerName": "凯特上校",
            "text": "#你…！你蹲在这里无所事事的时候，我可是把穹顶水中的水泡阵地给拿下了，{NICKNAME}{M#他们}{F#她们}才能顺利拿到宝物！",
            "nextDialogs": [
              "740021012"
            ]
          },
          "740021012": {
            "id": "740021012",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "呜哇，好有女主角气势的发言！那个，要不…要不这么办吧！就叫「派蒙上校抵抗阵线」和「派蒙管弦乐团」怎么样！",
            "nextDialogs": [
              "740021013"
            ]
          },
          "740021013": {
            "id": "740021013",
            "speakerId": 1006,
            "speakerName": "雅克&凯特上校",
            "text": "？",
            "nextDialogs": [
              "740021016"
            ]
          },
          "740021016": {
            "id": "740021016",
            "speakerId": 20995,
            "speakerName": "安",
            "text": "啊啊，烦死了！莫里，上！",
            "nextDialogs": [
              "740021017"
            ]
          },
          "740021017": {
            "id": "740021017",
            "speakerId": 20999,
            "speakerName": "莫里",
            "text": "汪汪！坏家伙！",
            "nextDialogs": [
              "740021018"
            ]
          },
          "740021018": {
            "id": "740021018",
            "speakerId": 1008,
            "speakerName": "Black Screen",
            "text": "莫里将雅克拱翻在地。\\n\\n",
            "nextDialogs": [
              "740021019"
            ]
          },
          "740021019": {
            "id": "740021019",
            "speakerId": 1008,
            "speakerName": "Black Screen",
            "text": "莫里将雅克拱翻在地。\\n凯特上校幸灾乐祸地笑了。\\n随后莫里转身又将凯特拱翻在地。",
            "nextDialogs": [
              "740021020"
            ]
          },
          "740021020": {
            "id": "740021020",
            "speakerId": 1008,
            "speakerName": "Black Screen",
            "text": "最后在阿尔与小卷心菜的调解下，骚动平息下来。",
            "nextDialogs": [
              "740021021"
            ]
          },
          "740021021": {
            "id": "740021021",
            "speakerId": 20995,
            "speakerName": "安",
            "text": "真是的…",
            "nextDialogs": [
              "740021022"
            ]
          },
          "740021022": {
            "id": "740021022",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "莫里在这种时候很可靠呢…在某种意义上…",
            "nextDialogs": [
              "740021023"
            ]
          },
          "740021023": {
            "id": "740021023",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "该干正事了。",
            "nextDialogs": [
              "740021024"
            ]
          },
          "740021024": {
            "id": "740021024",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "嗯！总这样也不是办法，而且，如果不继续行动，大家又会吵起来吧…",
            "nextDialogs": [
              "740021025"
            ]
          },
          "740021025": {
            "id": "740021025",
            "speakerId": 20995,
            "speakerName": "安",
            "text": "#嗯…{NICKNAME}骑士、派蒙，你们说得对。",
            "nextDialogs": [
              "740021026"
            ]
          },
          "740021026": {
            "id": "740021026",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "那么，安来一段演讲吧！振奋人心的那种！",
            "nextDialogs": [
              "740021027"
            ]
          },
          "740021027": {
            "id": "740021027",
            "speakerId": 20995,
            "speakerName": "安",
            "text": "欸？但是…",
            "nextDialogs": [
              "740021028"
            ]
          },
          "740021028": {
            "id": "740021028",
            "speakerId": 20997,
            "speakerName": "阿尔",
            "text": "我很赞同派蒙的说法。在这种时刻，冒险团的「团长」才更应该站出来，不是吗？",
            "nextDialogs": [
              "740021029"
            ]
          },
          "740021029": {
            "id": "740021029",
            "speakerId": 20995,
            "speakerName": "安",
            "text": "我不擅长这种事情…而且，说我是「团长」也实在…",
            "nextDialogs": [
              "740021030"
            ]
          },
          "740021030": {
            "id": "740021030",
            "speakerId": 21000,
            "speakerName": "凯特上校",
            "text": "我以上校的名誉担保，如果水仙十字冒险团需要一个军官的话，你是最合适的人选。",
            "nextDialogs": [
              "740021031"
            ]
          },
          "740021031": {
            "id": "740021031",
            "speakerId": 20998,
            "speakerName": "雅克",
            "text": "且不提上校的名誉一文不值，我们的看法是一致的。",
            "nextDialogs": [
              "740021032"
            ]
          },
          "740021032": {
            "id": "740021032",
            "speakerId": 20996,
            "speakerName": "小卷心菜",
            "text": "#那个，我不懂什么团长、什么名誉的事情喔，不过，如果没有安、没有安带来的{NICKNAME}骑士和派蒙，现在我都不知道怎么样了…",
            "nextDialogs": [
              "740021033"
            ]
          },
          "740021033": {
            "id": "740021033",
            "speakerId": 20995,
            "speakerName": "安",
            "text": "……",
            "nextDialogs": [
              "740021034"
            ]
          },
          "740021034": {
            "id": "740021034",
            "speakerId": 20995,
            "speakerName": "安",
            "text": "#{NICKNAME}骑士、派蒙，你们觉得呢？"
          }
        }
      }
    },

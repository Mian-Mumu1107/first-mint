          "705371401": {
            "id": "705371401",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "呜哇！超可怕！我们快逃！",
            "nextDialogs": [
              "705371402"
            ]
          },
          "705371402": {
            "id": "705371402",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "连你都觉得很危险吗！难道是箱子里透露出了一股杀气…我们快逃！"

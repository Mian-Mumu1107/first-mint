    {
      "subId": "4014701",
      "subQuestName": "与言笑对话",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "401470101"
        ],
        "dialogs": {
          "401470101": {
            "id": "401470101",
            "speakerId": 1000,
            "speakerName": "言笑",
            "text": "#早啊，{NICKNAME}！掌柜的跟我说了，上回来的新老顾客，对你的评价都非常好！",
            "nextDialogs": [
              "401470102"
            ]
          },
          "401470102": {
            "id": "401470102",
            "speakerId": 1000,
            "speakerName": "言笑",
            "text": "我之前还担心你适应不了呢，现在看起来以你的本事，日常工作是足够应付了。",
            "nextDialogs": [
              "401470103"
            ]
          },
          "401470103": {
            "id": "401470103",
            "speakerId": 1000,
            "speakerName": "言笑",
            "text": "除非来位口味又挑剔，要求又严苛的客人，否则还真难不倒你…",
            "nextDialogs": [
              "401470104"
            ]
          },
          "401470104": {
            "id": "401470104",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "哇，还会有这种客人吗？",
            "nextDialogs": [
              "401470105"
            ]
          },
          "401470105": {
            "id": "401470105",
            "speakerId": 1000,
            "speakerName": "言笑",
            "text": "那可不，尤其是那些菜没做几道，书读了一堆的老学究！",
            "nextDialogs": [
              "401470106"
            ]
          },
          "401470106": {
            "id": "401470106",
            "speakerId": 1000,
            "speakerName": "言笑",
            "text": "没事就来挑你哪里做的不合古法、哪里做的跟几百年前的老味道有区别…",
            "nextDialogs": [
              "401470107"
            ]
          },
          "401470107": {
            "id": "401470107",
            "speakerId": 1002,
            "speakerName": "？？？",
            "text": "——这里就是望舒客栈？也算是一家老字号了吧…",
            "nextDialogs": [
              "401470108"
            ]
          },
          "401470108": {
            "id": "401470108",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "这声音是…",
            "nextDialogs": [
              "401470109"
            ]
          },
          "401470109": {
            "id": "401470109",
            "speakerId": 1003,
            "speakerName": "珐露珊",
            "text": "店家！有什么招牌名菜，就快点招待上来吧！要最贵的！",
            "nextDialogs": [
              "401470110"
            ]
          },
          "401470110": {
            "id": "401470110",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "珐露珊！…前！前辈好…",
            "nextDialogs": [
              "401470111"
            ]
          },
          "401470111": {
            "id": "401470111",
            "speakerId": 1003,
            "speakerName": "珐露珊",
            "text": "#呀！{NICKNAME}，派蒙？你们怎么在这儿？",
            "nextDialogs": [
              "401470112"
            ]
          },
          "401470112": {
            "id": "401470112",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "我们还想问呢，你怎么突然就有经费来旅游了？还直接点了最贵的菜…",
            "nextDialogs": [
              "401470113"
            ]
          },
          "401470113": {
            "id": "401470113",
            "speakerId": 1003,
            "speakerName": "珐露珊",
            "text": "哼哼，这可不是旅游哦。像我这样的学者，受邀成为「随船顾问」满世界出差，也只是家常便饭而已…",
            "nextDialogs": [
              "401470114"
            ]
          },
          "401470114": {
            "id": "401470114",
            "speakerId": 1004,
            "speakerName": "莱依拉",
            "text": "珐露珊前辈…请…请慢一点…呼…明明昨晚大家都在熬夜，怎么就前辈还这么精神？她真有一百来岁了吗…",
            "nextDialogs": [
              "401470115"
            ]
          },
          "401470115": {
            "id": "401470115",
            "speakerId": 1005,
            "speakerName": "多莉",
            "text": "哈…哈…从我说要请客开始，她就一直这样了…真是失策…",
            "nextDialogs": [
              "401470116"
            ]
          },
          "401470116": {
            "id": "401470116",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "莱依拉！还有多莉？真是少见的组合…",
            "nextDialogs": [
              "401470117"
            ]
          },
          "401470117": {
            "id": "401470117",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "总之先歇一会儿吧…",
            "nextDialogs": [
              "401470118"
            ]
          },
          "401470118": {
            "id": "401470118",
            "speakerId": 1006,
            "speakerName": "Black Screen",
            "text": "你们招待三人入座，并说明了自己正在望舒客栈帮忙的事情…",
            "nextDialogs": [
              "401470119"
            ]
          },
          "401470119": {
            "id": "401470119",
            "speakerId": 1003,
            "speakerName": "珐露珊",
            "text": "原来是这样…你还真是个大忙人呢。",
            "nextDialogs": [
              "401470120"
            ]
          },
          "401470120": {
            "id": "401470120",
            "speakerId": 1003,
            "speakerName": "珐露珊",
            "text": "不过既然连这里的主厨都认可你的话，也不用担心吃不上正宗的招牌菜了吧！",
            "nextDialogs": [
              "401470121"
            ]
          },
          "401470121": {
            "id": "401470121",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "所以你们又是为什么来璃月的啊？刚才好像听到了什么「随船顾问」…",
            "nextDialogs": [
              "401470122"
            ]
          },
          "401470122": {
            "id": "401470122",
            "speakerId": 1005,
            "speakerName": "多莉",
            "text": "嚯嚯，我前阵子从枫丹弄了一条新船，上面装了最先进的导航机关！如果能推广出去，那可是大大的商机！",
            "nextDialogs": [
              "401470123"
            ]
          },
          "401470123": {
            "id": "401470123",
            "speakerId": 1005,
            "speakerName": "多莉",
            "text": "最近几天正在试行呢：从奥摩斯港到离岛，从离岛到璃月港，后面还打算去荆夫港…",
            "nextDialogs": [
              "401470124"
            ]
          },
          "401470124": {
            "id": "401470124",
            "speakerId": 1004,
            "speakerName": "莱依拉",
            "text": "我跟前辈就是受雇来帮忙调试罗盘、调整机关的。昨晚为了压力测试，还在云来海上漂了一整夜…",
            "nextDialogs": [
              "401470125"
            ]
          },
          "401470125": {
            "id": "401470125",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "这是非法加班吗…",
            "nextDialogs": [
              "401470126"
            ]
          },
          "401470126": {
            "id": "401470126",
            "speakerId": 1005,
            "speakerName": "多莉",
            "text": "会…会有加班补贴的！两位也都是自愿的，签合同的时候特意提过的！",
            "nextDialogs": [
              "401470127"
            ]
          },
          "401470127": {
            "id": "401470127",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "你还真是滴水不漏…所以「请客」也算是补贴之一吗？难怪一上来就点贵的。",
            "nextDialogs": [
              "401470128"
            ]
          },
          "401470128": {
            "id": "401470128",
            "speakerId": 1003,
            "speakerName": "珐露珊",
            "text": "哼哼，「想吃什么就吃什么！」——这种机会可不多见！那就先来一份…",
            "nextDialogs": [
              "401470129"
            ]
          },
          "401470129": {
            "id": "401470129",
            "speakerId": 1005,
            "speakerName": "多莉",
            "text": "咳！珐露珊…前辈，我当然也很想用最~贵的菜慰劳你们啦，但贵，不一定就是好嘛！",
            "nextDialogs": [
              "401470130"
            ]
          },
          "401470130": {
            "id": "401470130",
            "speakerId": 1005,
            "speakerName": "多莉",
            "text": "我听说璃月菜里最贵的几样，不是要用很多海鲜，就是要费很长的功夫…",
            "nextDialogs": [
              "401470131"
            ]
          },
          "401470131": {
            "id": "401470131",
            "speakerId": 1005,
            "speakerName": "多莉",
            "text": "可是我们都在海上晃了这么多天，再吃什么鱼啊虾啊，也尝不出好味道来吧？",
            "nextDialogs": [
              "401470132"
            ]
          },
          "401470132": {
            "id": "401470132",
            "speakerId": 1003,
            "speakerName": "珐露珊",
            "text": "呃，你这么一说，还真是这样…",
            "nextDialogs": [
              "401470133"
            ]
          },
          "401470133": {
            "id": "401470133",
            "speakerId": 1005,
            "speakerName": "多莉",
            "text": "——而且莱依拉小姐，看着都快饿晕了！",
            "nextDialogs": [
              "401470134"
            ]
          },
          "401470134": {
            "id": "401470134",
            "speakerId": 1004,
            "speakerName": "莱依拉",
            "text": "欸？我不是因为饿…",
            "nextDialogs": [
              "401470135"
            ]
          },
          "401470135": {
            "id": "401470135",
            "speakerId": 1005,
            "speakerName": "多莉",
            "text": "…想必年高德劭的珐露珊前辈，一定不忍心让后辈继续饿着肚子等吧！",
            "nextDialogs": [
              "401470136"
            ]
          },
          "401470136": {
            "id": "401470136",
            "speakerId": 1003,
            "speakerName": "珐露珊",
            "text": "唔，要照顾后辈的话，我是没意见…不过怎么总觉得上套了…",
            "nextDialogs": [
              "401470137"
            ]
          },
          "401470137": {
            "id": "401470137",
            "speakerId": 1005,
            "speakerName": "多莉",
            "text": "#所以，需要花大把时间来熬的菜也别上了！除此以外，有什么贵就上什么吧。交给你咯，{NICKNAME}！"
          }
        }
      }
    },
    {
      "subId": "4014706",
      "subQuestName": "与言笑对话",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "401470401"
        ],
        "dialogs": {
          "401470401": {
            "id": "401470401",
            "speakerId": 1000,
            "speakerName": "言笑",
            "text": "…既要贵，又不能见海鲜，还不能花时间…这大半的老菜就都被排除了吧？究竟是谁提的要求，居然这么刁钻？",
            "nextDialogs": [
              "401470402"
            ]
          },
          "401470402": {
            "id": "401470402",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "多莉这家伙！该不会是故意的吧？",
            "nextDialogs": [
              "401470403"
            ]
          },
          "401470403": {
            "id": "401470403",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "估计就是故意的…",
            "nextDialogs": [
              "401470404"
            ]
          },
          "401470404": {
            "id": "401470404",
            "speakerId": 1000,
            "speakerName": "言笑",
            "text": "我们客栈跟琉璃亭、新月轩也不一样，不会常备什么名贵的食材，一般都是有客人预定才会去准备。",
            "nextDialogs": [
              "401470405"
            ]
          },
          "401470405": {
            "id": "401470405",
            "speakerId": 1000,
            "speakerName": "言笑",
            "text": "要用寻常食材，在短时间内做一道货真价实的高价菜…那贵的就只能是厨师的「功夫」跟菜肴的「创意」了。",
            "nextDialogs": [
              "401470406"
            ]
          },
          "401470406": {
            "id": "401470406",
            "speakerId": 1000,
            "speakerName": "言笑",
            "text": "#{NICKNAME}，我知道一道叫做「繁弦急管」的菜，用现成的食材就能做，出菜也不费时，一盘售价…三万摩拉！",
            "nextDialogs": [
              "401470407"
            ]
          },
          "401470407": {
            "id": "401470407",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "——三万！不是说用料普通，也不费时间吗？为什么会那么贵？",
            "nextDialogs": [
              "401470408"
            ]
          },
          "401470408": {
            "id": "401470408",
            "speakerId": 1000,
            "speakerName": "言笑",
            "text": "这道菜的「功夫」不在于时间，而在于厨师对刀工跟火候的把控。",
            "nextDialogs": [
              "401470409"
            ]
          },
          "401470409": {
            "id": "401470409",
            "speakerId": 1000,
            "speakerName": "言笑",
            "text": "要用多种不同的肉类切作细丝，揉制成条，最后再下锅煎炒，主打口味多变，层层递进。",
            "nextDialogs": [
              "401470410"
            ]
          },
          "401470410": {
            "id": "401470410",
            "speakerId": 1000,
            "speakerName": "言笑",
            "text": "如何令几种不同的肉凝而不散，一起达到各自合适的熟度，味道又不相互冲突，才是这道菜真正可贵的地方！",
            "nextDialogs": [
              "401470411"
            ]
          },
          "401470411": {
            "id": "401470411",
            "speakerId": 1000,
            "speakerName": "言笑",
            "text": "做好了，就是一等一的名菜；做糟了，可就成一盘肉末了。",
            "nextDialogs": [
              "401470412"
            ]
          },
          "401470412": {
            "id": "401470412",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "哦——我懂了，所以这道菜贵的不是菜，而是你的出场费啊！",
            "nextDialogs": [
              "401470413"
            ]
          },
          "401470413": {
            "id": "401470413",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "说得我都不太自信了…",
            "nextDialogs": [
              "401470414"
            ]
          },
          "401470414": {
            "id": "401470414",
            "speakerId": 1000,
            "speakerName": "言笑",
            "text": "没事，揉条之类的琐碎工序，我可以帮你搞定。你专心对付最紧要的环节就好。",
            "nextDialogs": [
              "401470415"
            ]
          },
          "401470415": {
            "id": "401470415",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "放心大胆地去试吧，就算做糟了，你做的肉末我也喜欢吃！"
          }
        }
      }
    },
    {
      "subId": "4014702",
      "subQuestName": "烹制「繁弦急管」",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "401470201"
        ],
        "dialogs": {
          "401470201": {
            "id": "401470201",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "菜来咯！各位慢用——",
            "nextDialogs": [
              "401470202"
            ]
          },
          "401470202": {
            "id": "401470202",
            "speakerId": 1003,
            "speakerName": "珐露珊",
            "text": "哦哦，闻着很香呀！",
            "nextDialogs": [
              "401470203"
            ]
          },
          "401470203": {
            "id": "401470203",
            "speakerId": 1005,
            "speakerName": "多莉",
            "text": "#…啊，对了对了，派蒙跟{NICKNAME}也没吃早餐吧，干脆一块坐下？",
            "nextDialogs": [
              "401470204"
            ]
          },
          "401470204": {
            "id": "401470204",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "咦，多莉什么时候这么好心了…居然会有免费的早餐…",
            "nextDialogs": [
              "401470205"
            ]
          },
          "401470205": {
            "id": "401470205",
            "speakerId": 1005,
            "speakerName": "多莉",
            "text": "嚯嚯，大生意都是在宴席上谈成的嘛…来来来坐坐坐！大家都不用客气！",
            "nextDialogs": [
              "401470206"
            ]
          },
          "401470206": {
            "id": "401470206",
            "speakerId": 1005,
            "speakerName": "多莉",
            "text": "（这道菜看起来平平无奇，我又事先做过调查，应该不会花很多摩拉吧！不怕一万，就怕三万…）",
            "nextDialogs": [
              "401470207"
            ]
          },
          "401470207": {
            "id": "401470207",
            "speakerId": 1003,
            "speakerName": "珐露珊",
            "text": "#（这道菜，能抵得过一晚上的熬夜吗？…能不能吃回本，可就看你了啊，{NICKNAME}！）",
            "nextDialogs": [
              "401470208"
            ]
          },
          "401470208": {
            "id": "401470208",
            "speakerId": 1004,
            "speakerName": "莱依拉",
            "text": "（好累…好困…好想睡…快点吃完回去睡…）",
            "nextDialogs": [
              "401470209"
            ]
          },
          "401470209": {
            "id": "401470209",
            "speakerId": 1006,
            "speakerName": "Black Screen",
            "text": "几人各怀心事，各自动筷…",
            "nextDialogs": [
              "401470210"
            ]
          },
          "401470210": {
            "id": "401470210",
            "speakerId": 1004,
            "speakerName": "莱依拉",
            "text": "这是…鸡腿肉？不对，又好像是蕈猪的口感…",
            "nextDialogs": [
              "401470211"
            ]
          },
          "401470211": {
            "id": "401470211",
            "speakerId": 1003,
            "speakerName": "珐露珊",
            "text": "每嚼一口都是不同的滋味…仔细尝起来，还有点烟熏的风味…真是不可思议，到底是怎么做出来的？",
            "nextDialogs": [
              "401470212"
            ]
          },
          "401470212": {
            "id": "401470212",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "是火腿，我加了火腿。",
            "nextDialogs": [
              "401470213"
            ]
          },
          "401470213": {
            "id": "401470213",
            "speakerId": 1003,
            "speakerName": "珐露珊",
            "text": "火腿？可是这盘菜里哪里有——啊！",
            "nextDialogs": [
              "401470214"
            ]
          },
          "401470214": {
            "id": "401470214",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "嘿嘿，已经有人发现了？没错，每根肉条都是用不同的肉丝揉成的！费了我跟言笑好大的劲呢！",
            "nextDialogs": [
              "401470215"
            ]
          },
          "401470215": {
            "id": "401470215",
            "speakerId": 1004,
            "speakerName": "莱依拉",
            "text": "可是，虽然我也不太清楚…不同的肉类，熟透的时间应该也不一样吧？可这道菜搭配得却很和谐…",
            "nextDialogs": [
              "401470216"
            ]
          },
          "401470216": {
            "id": "401470216",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "#呃…呃…这就是{NICKNAME}的商业机密了！",
            "nextDialogs": [
              "401470219"
            ]
          },
          "401470219": {
            "id": "401470219",
            "speakerId": 1003,
            "speakerName": "珐露珊",
            "text": "没想到这还是你的独门菜式呢，算是没白来一趟。对了，这道菜有名字吗？",
            "nextDialogs": [
              "401470220"
            ]
          },
          "401470220": {
            "id": "401470220",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "啊，我都忘了介绍了，这道菜的名字叫「繁弦急管」——既是在描述丝条交错的外观，也是在…",
            "nextDialogs": [
              "401470221"
            ]
          },
          "401470221": {
            "id": "401470221",
            "speakerId": 1003,
            "speakerName": "珐露珊",
            "text": "…描述复杂多变的口感？是从璃月的俗语里起的吧？",
            "nextDialogs": [
              "401470222"
            ]
          },
          "401470222": {
            "id": "401470222",
            "speakerId": 1003,
            "speakerName": "珐露珊",
            "text": "原意应该是多种乐器同时演奏，热闹纷呈…嗯，放到这里也算贴切。",
            "nextDialogs": [
              "401470223"
            ]
          },
          "401470223": {
            "id": "401470223",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "欸…原来你知道啊…",
            "nextDialogs": [
              "401470224"
            ]
          },
          "401470224": {
            "id": "401470224",
            "speakerId": 1003,
            "speakerName": "珐露珊",
            "text": "每个年轻人在毕业前都该学会至少二十种语言吧。咦…难道现在没这要求了？",
            "nextDialogs": [
              "401470225"
            ]
          },
          "401470225": {
            "id": "401470225",
            "speakerId": 1004,
            "speakerName": "莱依拉",
            "text": "——欸？以前有过的吗！",
            "nextDialogs": [
              "401470226"
            ]
          },
          "401470226": {
            "id": "401470226",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "差点忘了你也是知论派的…",
            "nextDialogs": [
              "401470227"
            ]
          },
          "401470227": {
            "id": "401470227",
            "speakerId": 1005,
            "speakerName": "多莉",
            "text": "那…那个…这道菜的价格是…",
            "nextDialogs": [
              "401470228"
            ]
          },
          "401470228": {
            "id": "401470228",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "嘿嘿——不多不多，承惠摩拉三万！",
            "nextDialogs": [
              "401470229"
            ]
          },
          "401470229": {
            "id": "401470229",
            "speakerId": 1005,
            "speakerName": "多莉",
            "text": "三…三万！哈…哈哈…",
            "nextDialogs": [
              "401470230"
            ]
          },
          "401470230": {
            "id": "401470230",
            "speakerId": 1005,
            "speakerName": "多莉",
            "text": "#话说回来…派蒙、{NICKNAME}，我之前是让你们「一块坐下」…没说要连你们一起请客吧？",
            "nextDialogs": [
              "401470231"
            ]
          },
          "401470231": {
            "id": "401470231",
            "speakerId": 1005,
            "speakerName": "多莉",
            "text": "…所以这是不是得算…拼桌？",
            "nextDialogs": [
              "401470232"
            ]
          },
          "401470232": {
            "id": "401470232",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "——果然没有免费的早餐啊！"
          }
        }
      }
    },
    {
      "subId": "4014703",
      "subQuestName": "为等待已久的须弥一行人上菜",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [],
        "dialogs": {}
      }
    },
    {
      "subId": "4014704",
      "subQuestName": "与言笑对话",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "401470301"
        ],
        "dialogs": {
          "401470301": {
            "id": "401470301",
            "speakerId": 1000,
            "speakerName": "言笑",
            "text": "今早算是开了个好头啊，接下来也拜托你们了！",
            "nextDialogs": [
              "401470302"
            ]
          },
          "401470302": {
            "id": "401470302",
            "speakerId": 1006,
            "speakerName": "Black Screen",
            "text": "你与派蒙忙里忙外，直到打烊。来客纷纭，口味众多，留下的好评却出奇一致。"
          }
        }
      }
    },
    {
      "subId": "4014792",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "401479201"
        ],
        "dialogs": {
          "401479201": {
            "id": "401479201",
            "speakerId": 1000,
            "speakerName": "言笑",
            "text": "油、盐、酱、醋…嗯，储备都很充足，够用过这阵了。"
          }
        }
      }
    },
    {
      "subId": "4014793",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "401479301"
        ],
        "dialogs": {
          "401479301": {
            "id": "401479301",
            "speakerId": 1007,
            "speakerName": "淮安",
            "text": "#哟，{NICKNAME}，今年算是开了个好头呀。"
          }
        }
      }
    },
    {
      "subId": "4014794",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "401479401"
        ],
        "dialogs": {
          "401479401": {
            "id": "401479401",
            "speakerId": 1003,
            "speakerName": "珐露珊",
            "text": "虽然没吃上仙跳墙跟腌笃鲜…不过「繁弦急管」也很不赖嘛，多谢你啦。",
            "nextDialogs": [
              "401479402"
            ]
          },
          "401479402": {
            "id": "401479402",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "没想到你会接跟遗迹无关的委托…",
            "nextDialogs": [
              "401479403"
            ]
          },
          "401479403": {
            "id": "401479403",
            "speakerId": 1003,
            "speakerName": "珐露珊",
            "text": "这个嘛…虽然新式机关确实不在我的专业范畴之内，不过多莉提出的报酬也很诱人…",
            "nextDialogs": [
              "401479404"
            ]
          },
          "401479404": {
            "id": "401479404",
            "speakerId": 1003,
            "speakerName": "珐露珊",
            "text": "——每到一个新港口，都能上街淘点古籍带回去研究！",
            "nextDialogs": [
              "401479405"
            ]
          },
          "401479405": {
            "id": "401479405",
            "speakerId": 1003,
            "speakerName": "珐露珊",
            "text": "呵，不枉我用最低的报价，吓跑了所有妙论派的竞争者！"
          }
        }
      }
    },
    {
      "subId": "4014795",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "401479501"
        ],
        "dialogs": {
          "401479501": {
            "id": "401479501",
            "speakerId": 1000,
            "speakerName": "言笑",
            "text": "据说当年曾有高人可以调和整整五种肉类，而我这道菜才只用到三种，实在惭愧。"
          }
        }
      }
    },
    {
      "subId": "4014796",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "401479601"
        ],
        "dialogs": {
          "401479601": {
            "id": "401479601",
            "speakerId": 1005,
            "speakerName": "多莉",
            "text": "不要海鲜、不要费时。别的就都交给你啦，嘿嘿！",
            "nextDialogs": [
              "401479602"
            ]
          },
          "401479602": {
            "id": "401479602",
            "speakerId": 1003,
            "speakerName": "珐露珊",
            "text": "唔…仙跳墙腌笃鲜金丝虾球黄金蟹…都只能下次再试了吗？下次还得等多少年呢…",
            "nextDialogs": [
              "401479603"
            ]
          },
          "401479603": {
            "id": "401479603",
            "speakerId": 1004,
            "speakerName": "莱依拉",
            "text": "#珐露珊前辈一下子变得好消沉…{NICKNAME}，能麻烦你尽量选贵点的菜吗？"
          }
        }
      }
    },
    {
      "subId": "4014797",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "401479701"
        ],
        "dialogs": {
          "401479701": {
            "id": "401479701",
            "speakerId": 1005,
            "speakerName": "多莉",
            "text": "该怎么把便宜的食材做成高价的菜呢…先从起一个好名字开始吗…",
            "nextDialogs": [
              "401479704"
            ]
          },
          "401479704": {
            "id": "401479704",
            "speakerId": 1005,
            "speakerName": "多莉",
            "text": "啊…哈哈——果然被你发现了。",
            "nextDialogs": [
              "401479705"
            ]
          },
          "401479705": {
            "id": "401479705",
            "speakerId": 1005,
            "speakerName": "多莉",
            "text": "唉，昨晚答应下来的时候，看大家又熬夜又晕船，我就想着第二天也吃不了多少…结果嘛，你也看见了。",
            "nextDialogs": [
              "401479706"
            ]
          },
          "401479706": {
            "id": "401479706",
            "speakerId": 1005,
            "speakerName": "多莉",
            "text": "后来又加了那么多限制，没想到照样难不倒你！唉，不事先做好市场调查，就是会变成这样啦。",
            "nextDialogs": [
              "401479707"
            ]
          },
          "401479707": {
            "id": "401479707",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "明明她们俩的咨询费都不高，说到底还是你贪小便宜嘛！下次可别这样咯！",
            "nextDialogs": [
              "401479708"
            ]
          },
          "401479708": {
            "id": "401479708",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "论贪小便宜…你也没好多少吧。",
            "nextDialogs": [
              "401479709"
            ]
          },
          "401479709": {
            "id": "401479709",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "我…我…所以我才有那么多经验教训嘛！"
          }
        }
      }
    },
    {
      "subId": "4014798",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "401479801"
        ],
        "dialogs": {
          "401479801": {
            "id": "401479801",
            "speakerId": 1004,
            "speakerName": "莱依拉",
            "text": "吃完饭感觉精神多了，好吃的东西确实可以提神呢。",
            "nextDialogs": [
              "401479802"
            ]
          },
          "401479802": {
            "id": "401479802",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "没想到你会接这么费神的委托…",
            "nextDialogs": [
              "401479803"
            ]
          },
          "401479803": {
            "id": "401479803",
            "speakerId": 1004,
            "speakerName": "莱依拉",
            "text": "哈哈…导师说，年轻人不该一直埋在论文和书本里，让我抓住机会出来，看看各地的星空。",
            "nextDialogs": [
              "401479804"
            ]
          },
          "401479804": {
            "id": "401479804",
            "speakerId": 1004,
            "speakerName": "莱依拉",
            "text": "嗯…就当作「提前实习」了？不过还真是累人啊…呼…"
          }
        }
      }
    }
  ]
}
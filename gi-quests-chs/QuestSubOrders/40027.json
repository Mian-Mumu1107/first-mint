  },
  "subQuests": [
    {
      "subId": "4002701",
      "subQuestName": "前往阿贝多的营地",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "400270101"
        ],
        "dialogs": {
          "400270101": {
            "id": "400270101",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "阿贝多，我们来啦！",
            "nextDialogs": [
              "400270102"
            ]
          },
          "400270102": {
            "id": "400270102",
            "speakerId": 1001,
            "speakerName": "阿贝多",
            "text": "旅行者，派蒙。",
            "nextDialogs": [
              "400270103"
            ]
          },
          "400270103": {
            "id": "400270103",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "调查还顺利吗？",
            "nextDialogs": [
              "400270104"
            ]
          },
          "400270104": {
            "id": "400270104",
            "speakerId": 1001,
            "speakerName": "阿贝多",
            "text": "看你们俩的表情，莫非没有收获？",
            "nextDialogs": [
              "400270105"
            ]
          },
          "400270105": {
            "id": "400270105",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "查是查了，也有注意雪山各个地点，但没看到和你很像的人，也没听说有人遇到你…",
            "nextDialogs": [
              "400270106"
            ]
          },
          "400270106": {
            "id": "400270106",
            "speakerId": 1001,
            "speakerName": "阿贝多",
            "text": "不意外。我这里进展也不大，对方似乎意识到我们在侦查，不再有那么明显的举动了。",
            "nextDialogs": [
              "400270107"
            ]
          },
          "400270107": {
            "id": "400270107",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "（或者，没有明显的行动才是对方的一贯思路吗？）",
            "nextDialogs": [
              "400270108"
            ]
          },
          "400270108": {
            "id": "400270108",
            "speakerId": 1001,
            "speakerName": "阿贝多",
            "text": "但不是完全没有收获。我从山上一些地方找到了脚印，虽说被积雪盖去了一部分，也依然能看出来是与我体型相似的人所留。",
            "nextDialogs": [
              "400270109"
            ]
          },
          "400270109": {
            "id": "400270109",
            "speakerId": 1001,
            "speakerName": "阿贝多",
            "text": "脚印数量不少，接下来恐怕要逐个排除在雪山上活动的冒险家…",
            "nextDialogs": [
              "400270110"
            ]
          },
          "400270110": {
            "id": "400270110",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "跟冒险家打交道的话，我们也许能帮上些忙。",
            "nextDialogs": [
              "400270111"
            ]
          },
          "400270111": {
            "id": "400270111",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "那现在我们是…",
            "nextDialogs": [
              "400270112"
            ]
          },
          "400270112": {
            "id": "400270112",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "哇？！什么声音那么响！",
            "nextDialogs": [
              "400270113"
            ]
          },
          "400270113": {
            "id": "400270113",
            "speakerId": 1001,
            "speakerName": "阿贝多",
            "text": "似乎是从那边传来的。",
            "nextDialogs": [
              "400270114"
            ]
          },
          "400270114": {
            "id": "400270114",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "难道是那个冒牌货出现了？",
            "nextDialogs": [
              "400270115"
            ]
          },
          "400270115": {
            "id": "400270115",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "我们去看看吧。",
            "nextDialogs": [
              "400270116"
            ]
          },
          "400270116": {
            "id": "400270116",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "嗯，快走！"
          }
        }
      }
    },
    {
      "subId": "4002702",
      "subQuestName": "追查声音的来源",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "400270201"
        ],
        "dialogs": {
          "400270201": {
            "id": "400270201",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "喂，刚才石头好像动了一下？是摇晃了一下吗？",
            "nextDialogs": [
              "400270202"
            ]
          },
          "400270202": {
            "id": "400270202",
            "speakerId": 1002,
            "speakerName": "优菈",
            "text": "呼。真是无妄之灾。",
            "nextDialogs": [
              "400270203"
            ]
          },
          "400270203": {
            "id": "400270203",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "怎么还是你们啊！",
            "nextDialogs": [
              "400270204"
            ]
          },
          "400270204": {
            "id": "400270204",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "你们的运气未免太差了。",
            "nextDialogs": [
              "400270205"
            ]
          },
          "400270205": {
            "id": "400270205",
            "speakerId": 1003,
            "speakerName": "安柏",
            "text": "没法否认呢，毕竟我们可是在这一带转了好几天…",
            "nextDialogs": [
              "400270206"
            ]
          },
          "400270206": {
            "id": "400270206",
            "speakerId": 1004,
            "speakerName": "班尼特",
            "text": "刚才还遇到了帕拉德，就是那个，那个有些冒失的家伙，你认识的吧？他说自己倒霉，我就教了他一些冒险家生存须知…",
            "nextDialogs": [
              "400270207"
            ]
          },
          "400270207": {
            "id": "400270207",
            "speakerId": 1002,
            "speakerName": "优菈",
            "text": "然后他一溜烟地继续参加活动去了。",
            "nextDialogs": [
              "400270208"
            ]
          },
          "400270208": {
            "id": "400270208",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "你们不会到现在为止都没抵达山脚营地吧？",
            "nextDialogs": [
              "400270209"
            ]
          },
          "400270209": {
            "id": "400270209",
            "speakerId": 1003,
            "speakerName": "安柏",
            "text": "啊哈哈…如你所见…",
            "nextDialogs": [
              "400270210"
            ]
          },
          "400270210": {
            "id": "400270210",
            "speakerId": 1004,
            "speakerName": "班尼特",
            "text": "也就是一些山崩、积雪崩塌、跌下斜坡之类的事而已啦。",
            "nextDialogs": [
              "400270211"
            ]
          },
          "400270211": {
            "id": "400270211",
            "speakerId": 1001,
            "speakerName": "阿贝多",
            "text": "值得铭记的人生经历。",
            "nextDialogs": [
              "400270212"
            ]
          },
          "400270212": {
            "id": "400270212",
            "speakerId": 1002,
            "speakerName": "优菈",
            "text": "总之…确实还没到过营地。这几天太倒霉了，就像冥冥之中有股力量在阻挠我们。",
            "nextDialogs": [
              "400270251"
            ]
          },
          "400270251": {
            "id": "400270251",
            "speakerId": 1002,
            "speakerName": "优菈",
            "text": "幸好我事先把杰拉德安排在了安全地带让他进行一些基础体能训练。",
            "nextDialogs": [
              "400270213"
            ]
          },
          "400270213": {
            "id": "400270213",
            "speakerId": 1004,
            "speakerName": "班尼特",
            "text": "对不起…这些事得怪我。我的运气一向很差，留在我身边也会被我传染…",
            "nextDialogs": [
              "400270214"
            ]
          },
          "400270214": {
            "id": "400270214",
            "speakerId": 1004,
            "speakerName": "班尼特",
            "text": "抱歉让你们遭受这么多额外的麻烦和委屈…唉。",
            "nextDialogs": [
              "400270215"
            ]
          },
          "400270215": {
            "id": "400270215",
            "speakerId": 1004,
            "speakerName": "班尼特",
            "text": "我都不知该怎么说了，也许这就是命运的力量吧，还是大家都很害怕的那种。",
            "nextDialogs": [
              "400270218"
            ]
          },
          "400270218": {
            "id": "400270218",
            "speakerId": 1001,
            "speakerName": "阿贝多",
            "text": "嗯，确实。",
            "nextDialogs": [
              "400270219"
            ]
          },
          "400270219": {
            "id": "400270219",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "我就不怕班尼特呢。",
            "nextDialogs": [
              "400270220"
            ]
          },
          "400270220": {
            "id": "400270220",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "对呀，早就习惯你这个样子啦！再说，我们自己的运气也谈不上多好…",
            "nextDialogs": [
              "400270221"
            ]
          },
          "400270221": {
            "id": "400270221",
            "speakerId": 1004,
            "speakerName": "班尼特",
            "text": "真的吗？我觉得你们运气比我好多了！",
            "nextDialogs": [
              "400270222"
            ]
          },
          "400270222": {
            "id": "400270222",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "那…那怎么办，要不这样吧，我把我的运气分一点给你！",
            "nextDialogs": [
              "400270223"
            ]
          },
          "400270223": {
            "id": "400270223",
            "speakerId": 1003,
            "speakerName": "安柏",
            "text": "我的也可以分一点给你！虽然这几天好像也不太多…",
            "nextDialogs": [
              "400270224"
            ]
          },
          "400270224": {
            "id": "400270224",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "我的也可以哦。",
            "nextDialogs": [
              "400270225"
            ]
          },
          "400270225": {
            "id": "400270225",
            "speakerId": 1004,
            "speakerName": "班尼特",
            "text": "…大家…",
            "nextDialogs": [
              "400270226"
            ]
          },
          "400270226": {
            "id": "400270226",
            "speakerId": 1004,
            "speakerName": "班尼特",
            "text": "呜…好，有了大家的运气，我们一定能走下山的！",
            "nextDialogs": [
              "400270227"
            ]
          },
          "400270227": {
            "id": "400270227",
            "speakerId": 1003,
            "speakerName": "安柏",
            "text": "对，一定没问题！",
            "nextDialogs": [
              "400270228"
            ]
          },
          "400270228": {
            "id": "400270228",
            "speakerId": 1004,
            "speakerName": "班尼特",
            "text": "丢个寻宝鸦印测试一下…嗯！反面，跟我猜的刚好相反！",
            "nextDialogs": [
              "400270229"
            ]
          },
          "400270229": {
            "id": "400270229",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "这个东西，能用来预测运势吗？而且你猜错了为什么还那么高兴啊？",
            "nextDialogs": [
              "400270230"
            ]
          },
          "400270230": {
            "id": "400270230",
            "speakerId": 1004,
            "speakerName": "班尼特",
            "text": "它有正反之分，每次都有一半的概率猜对正反。",
            "nextDialogs": [
              "400270231"
            ]
          },
          "400270231": {
            "id": "400270231",
            "speakerId": 1004,
            "speakerName": "班尼特",
            "text": "运气的本质是概率，也就是说，只要把不幸的部分用完，剩下的就都是好运的部分啦！",
            "nextDialogs": [
              "400270232"
            ]
          },
          "400270232": {
            "id": "400270232",
            "speakerId": 1004,
            "speakerName": "班尼特",
            "text": "举例来说，只要扔鸦印失败，就等于是消耗掉了不幸，接下来遇到好事的概率就会上升。",
            "nextDialogs": [
              "400270233"
            ]
          },
          "400270233": {
            "id": "400270233",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "……",
            "nextDialogs": [
              "400270234"
            ]
          },
          "400270234": {
            "id": "400270234",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "喂！他说的话完全没有道理吧，你为什么不批评他啊！"
          }
        }
      }
    },

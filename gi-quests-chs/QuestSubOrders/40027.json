    {
      "subId": "4002705",
      "subQuestName": "返回阿贝多的营地",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "400270301"
        ],
        "dialogs": {
          "400270301": {
            "id": "400270301",
            "speakerId": 1001,
            "speakerName": "阿贝多",
            "text": "到了。各位请自便。",
            "nextDialogs": [
              "400270302"
            ]
          },
          "400270302": {
            "id": "400270302",
            "speakerId": 1001,
            "speakerName": "阿贝多",
            "text": "噢…对，忘了营地里没有那么多把椅子。请稍等。",
            "nextDialogs": [
              "400270303"
            ]
          },
          "400270303": {
            "id": "400270303",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "他在干什么？画画吗？",
            "nextDialogs": [
              "400270304"
            ]
          },
          "400270304": {
            "id": "400270304",
            "speakerId": 1003,
            "speakerName": "安柏",
            "text": "是在画画呢！",
            "nextDialogs": [
              "400270305"
            ]
          },
          "400270305": {
            "id": "400270305",
            "speakerId": 1002,
            "speakerName": "优菈",
            "text": "画椅子…等等，画完用炼金术变出实物吗？！还能这样？",
            "nextDialogs": [
              "400270306"
            ]
          },
          "400270306": {
            "id": "400270306",
            "speakerId": 1001,
            "speakerName": "阿贝多",
            "text": "我的作画可以视为一种蓝图，然后用炼金术将制造过程省去，只是一种很低级的技巧。",
            "nextDialogs": [
              "400270307"
            ]
          },
          "400270307": {
            "id": "400270307",
            "speakerId": 1001,
            "speakerName": "阿贝多",
            "text": "历经足够多的研究与试验，这类技巧甚至可以拓展到生物的创生上。",
            "nextDialogs": [
              "400270308"
            ]
          },
          "400270308": {
            "id": "400270308",
            "speakerId": 1004,
            "speakerName": "班尼特",
            "text": "唔…既然能变出椅子来，那我想要靠背椅可以吗？",
            "nextDialogs": [
              "400270309"
            ]
          },
          "400270309": {
            "id": "400270309",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "那我要板凳。",
            "nextDialogs": [
              "400270310"
            ]
          },
          "400270310": {
            "id": "400270310",
            "speakerId": 1001,
            "speakerName": "阿贝多",
            "text": "可以。有多少人要靠背椅？",
            "nextDialogs": [
              "400270311"
            ]
          },
          "400270311": {
            "id": "400270311",
            "speakerId": 1004,
            "speakerName": "班尼特",
            "text": "我！",
            "nextDialogs": [
              "400270312"
            ]
          },
          "400270312": {
            "id": "400270312",
            "speakerId": 1003,
            "speakerName": "安柏",
            "text": "我要我要！",
            "nextDialogs": [
              "400270313"
            ]
          },
          "400270313": {
            "id": "400270313",
            "speakerId": 1002,
            "speakerName": "优菈",
            "text": "…我也要一张靠背椅吧。",
            "nextDialogs": [
              "400270314"
            ]
          },
          "400270314": {
            "id": "400270314",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "那我也要！",
            "nextDialogs": [
              "400270315"
            ]
          },
          "400270315": {
            "id": "400270315",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "你坐不满一张椅子吧。",
            "nextDialogs": [
              "400270316"
            ]
          },
          "400270316": {
            "id": "400270316",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "那也比跟你挤板凳好吧！哼！",
            "nextDialogs": [
              "400270317"
            ]
          },
          "400270317": {
            "id": "400270317",
            "speakerId": 1004,
            "speakerName": "班尼特",
            "text": "真的有椅子了，天哪！好方便，我都想住在这里了！",
            "nextDialogs": [
              "400270318"
            ]
          },
          "400270318": {
            "id": "400270318",
            "speakerId": 1001,
            "speakerName": "阿贝多",
            "text": "如果你需要的话，今晚住下来也没关系。",
            "nextDialogs": [
              "400270319"
            ]
          },
          "400270319": {
            "id": "400270319",
            "speakerId": 1001,
            "speakerName": "阿贝多",
            "text": "离吃晚饭还有些时间，各位先休息吧，我去照看炉火。",
            "nextDialogs": [
              "400270320"
            ]
          },
          "400270320": {
            "id": "400270320",
            "speakerId": 1003,
            "speakerName": "安柏",
            "text": "怎么能让阿贝多你一个人忙碌呢！我可以帮忙，请让我帮忙吧！"
          }
        }
      }
    },
    {
      "subId": "4002703",

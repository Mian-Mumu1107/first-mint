    {
      "subId": "4002707",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "400270701"
        ],
        "dialogs": {
          "400270701": {
            "id": "400270701",
            "speakerId": 1003,
            "speakerName": "安柏",
            "text": "营地里真暖和呀…",
            "nextDialogs": [
              "400270703"
            ]
          },
          "400270703": {
            "id": "400270703",
            "speakerId": 1003,
            "speakerName": "安柏",
            "text": "乔尔他呀，有人陪他玩可开心了。",
            "nextDialogs": [
              "400270704"
            ]
          },
          "400270704": {
            "id": "400270704",
            "speakerId": 1003,
            "speakerName": "安柏",
            "text": "我甚至觉得自己的体力都不如他呢。",
            "nextDialogs": [
              "400270705"
            ]
          },
          "400270705": {
            "id": "400270705",
            "speakerId": 1003,
            "speakerName": "安柏",
            "text": "孩童的时候，总是在「玩」这件事上有用不完的精力嘛。"
          }
        }
      }
    },
    {
      "subId": "4002709",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "400270901"
        ],
        "dialogs": {
          "400270901": {
            "id": "400270901",
            "speakerId": 1002,
            "speakerName": "优菈",
            "text": "没想到雪山上，也会有那么温馨的时刻…",
            "nextDialogs": [
              "400270903"
            ]
          },
          "400270903": {
            "id": "400270903",
            "speakerId": 1002,
            "speakerName": "优菈",
            "text": "堆雪人啊，我试了一下，感觉还不错。",
            "nextDialogs": [
              "400270904"
            ]
          },
          "400270904": {
            "id": "400270904",
            "speakerId": 1002,
            "speakerName": "优菈",
            "text": "……",
            "nextDialogs": [
              "400270905"
            ]
          },
          "400270905": {
            "id": "400270905",
            "speakerId": 1002,
            "speakerName": "优菈",
            "text": "但安柏却说什么，我摆出来的雪人姿势太有艺术感，已经不是传统的圆滚滚雪人了。",
            "nextDialogs": [
              "400270906"
            ]
          },
          "400270906": {
            "id": "400270906",
            "speakerId": 1002,
            "speakerName": "优菈",
            "text": "不知道这家伙是在夸我还是在嘲笑我，总之这仇我记下了。"
          }
        }
      }
    },
    {
      "subId": "4002710",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "400271001"
        ],
        "dialogs": {
          "400271001": {
            "id": "400271001",
            "speakerId": 1001,
            "speakerName": "阿贝多",
            "text": "再耐心等等吧，晚餐前还需要做一些准备…"
          }
        }
      }
    },
    {
      "subId": "4002711",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "400271101"
        ],
        "dialogs": {
          "400271101": {
            "id": "400271101",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "关于颜料…",
            "nextDialogs": [
              "400271102"
            ]
          },
          "400271102": {
            "id": "400271102",
            "speakerId": 1001,
            "speakerName": "阿贝多",
            "text": "没想到你对颜料真的很感兴趣。",
            "nextDialogs": [
              "400271103"
            ]
          },
          "400271103": {
            "id": "400271103",
            "speakerId": 1001,
            "speakerName": "阿贝多",
            "text": "此前，为了模拟雪花晶莹的质感，我尝试将冰雾花磨成粉末，混入白色颜料之中。",
            "nextDialogs": [
              "400271104"
            ]
          },
          "400271104": {
            "id": "400271104",
            "speakerId": 1001,
            "speakerName": "阿贝多",
            "text": "画面的效果称得上令人满意。不过存放起来就要小心一些了。",
            "nextDialogs": [
              "400271105"
            ]
          },
          "400271105": {
            "id": "400271105",
            "speakerId": 1001,
            "speakerName": "阿贝多",
            "text": "如果你想亲自试试的话，我可以陪你一起。"
          }
        }
      }
    },

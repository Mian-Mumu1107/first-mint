    {
      "subId": "4002717",
      "subQuestName": "(test)废弃$HIDDEN",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "400271701"
        ],
        "dialogs": {
          "400271701": {
            "id": "400271701",
            "speakerId": 1004,
            "speakerName": "班尼特",
            "text": "呼…呼…",
            "nextDialogs": [
              "400271703",
              "400271705"
            ]
          },
          "400271703": {
            "id": "400271703",
            "speakerId": 1005,
            "speakerName": "观察班尼特的样子",
            "text": "班尼特双眼紧闭，睡得正熟…"
          },
          "400271705": {
            "id": "400271705",
            "speakerId": 1004,
            "speakerName": "班尼特",
            "text": "唔…啊！派蒙，别摸！",
            "nextDialogs": [
              "400271706"
            ]
          },
          "400271706": {
            "id": "400271706",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "呃？啊？",
            "nextDialogs": [
              "400271707"
            ]
          },
          "400271707": {
            "id": "400271707",
            "speakerId": 1004,
            "speakerName": "班尼特",
            "text": "别摸那个机关！否则会…掉下去的…唔…算了…",
            "nextDialogs": [
              "400271708"
            ]
          },
          "400271708": {
            "id": "400271708",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "……",
            "nextDialogs": [
              "400271709"
            ]
          },
          "400271709": {
            "id": "400271709",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "啊——！这个人到底在做什么梦啊，真是的！"
          }
        }
      }
    },

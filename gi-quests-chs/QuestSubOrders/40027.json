    {
      "subId": "4002706",
      "subQuestName": "等到夜晚(18:00-次日6:00)",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "400270601"
        ],
        "dialogs": {
          "400270601": {
            "id": "400270601",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "#那么，先从头部开始画吧！在{NICKNAME}心里我一般是什么表情呀？",
            "nextDialogs": [
              "400270605"
            ]
          },
          "400270605": {
            "id": "400270605",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "欸？我在你心里是这样啊？唔…",
            "nextDialogs": [
              "400270606"
            ]
          },
          "400270606": {
            "id": "400270606",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "算了，先把之后的部分画完吧！下一步画身体吧，快快！画出你心里的我的样子！"
          }
        }
      }
    },
    {
      "subId": "4002707",
      "subQuestName": "与阿贝多对话",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "400271501"
        ],
        "dialogs": {
          "400271501": {
            "id": "400271501",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "什么时候可以吃晚餐？",
            "nextDialogs": [
              "400271502"
            ]
          },
          "400271502": {
            "id": "400271502",
            "speakerId": 1001,
            "speakerName": "阿贝多",
            "text": "差不多了。旅行者，请把篝火点起来，叫大家过来集合准备用餐。"
          }
        }
      }
    },
    {
      "subId": "4002708",
      "subQuestName": "点燃篝火",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "400270801"
        ],
        "dialogs": {
          "400270801": {
            "id": "400270801",
            "speakerId": 1004,
            "speakerName": "班尼特",
            "text": "是不是该去帮帮忙呢…",
            "nextDialogs": [
              "400270803"
            ]
          },
          "400270803": {
            "id": "400270803",
            "speakerId": 1004,
            "speakerName": "班尼特",
            "text": "哦，你是在问杰拉德的事情吗？听说优菈小姐已经为他制定好了一整套训练计划。",
            "nextDialogs": [
              "400270804"
            ]
          },
          "400270804": {
            "id": "400270804",
            "speakerId": 1004,
            "speakerName": "班尼特",
            "text": "虽然是新人，但有这样可靠的前辈带领，一定会很快成长起来吧。"
          }
        }
      }
    },
    {
      "subId": "4002720",
      "subQuestName": "(test)调整时间到9点$HIDDEN",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [],
        "dialogs": {}
      }
    },
    {
      "subId": "4002709",
      "subQuestName": "与众人对话",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "400270401"
        ],
        "dialogs": {
          "400270401": {
            "id": "400270401",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "嗯，好了！",
            "nextDialogs": [
              "400270402"
            ]
          },
          "400270402": {
            "id": "400270402",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "晚饭好像都差不多了，大家，过来吃饭吧！",
            "nextDialogs": [
              "400270403"
            ]
          },
          "400270403": {
            "id": "400270403",
            "speakerId": 1001,
            "speakerName": "阿贝多",
            "text": "我照蒙德城里受欢迎的食谱做了几道菜。虽说没法跟「猎鹿人」的手艺相比，只是填饱肚子倒也足够了。",
            "nextDialogs": [
              "400270404"
            ]
          },
          "400270404": {
            "id": "400270404",
            "speakerId": 1001,
            "speakerName": "阿贝多",
            "text": "各位千万不要客气。",
            "nextDialogs": [
              "400270405"
            ]
          },
          "400270405": {
            "id": "400270405",
            "speakerId": 1004,
            "speakerName": "班尼特",
            "text": "哇，太香了！那我就不客气啦！",
            "nextDialogs": [
              "400270406"
            ]
          },
          "400270406": {
            "id": "400270406",
            "speakerId": 1002,
            "speakerName": "优菈",
            "text": "等等，请不要抢那个煎蔬菜，给我留一点…喂！",
            "nextDialogs": [
              "400270407"
            ]
          },
          "400270407": {
            "id": "400270407",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "啊——吃饱了，好好吃呀！",
            "nextDialogs": [
              "400270408"
            ]
          },
          "400270408": {
            "id": "400270408",
            "speakerId": 1004,
            "speakerName": "班尼特",
            "text": "阿贝多太谦虚了，这些菜一点不比餐馆里的美食逊色啊，炼金术士都这么会做饭吗？",
            "nextDialogs": [
              "400270409"
            ]
          },
          "400270409": {
            "id": "400270409",
            "speakerId": 1002,
            "speakerName": "优菈",
            "text": "说不定就是这个道理。",
            "nextDialogs": [
              "400270410"
            ]
          },
          "400270410": {
            "id": "400270410",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "对吧？我也觉得是这样哦！你看他拿烧瓶的手那么稳，就知道他做菜也不会乱放盐和胡椒啦。",
            "nextDialogs": [
              "400270411"
            ]
          },
          "400270411": {
            "id": "400270411",
            "speakerId": 1003,
            "speakerName": "安柏",
            "text": "很有道理呢！",
            "nextDialogs": [
              "400270412"
            ]
          },
          "400270412": {
            "id": "400270412",
            "speakerId": 1004,
            "speakerName": "班尼特",
            "text": "吃饱了就困了…呼啊…",
            "nextDialogs": [
              "400270413"
            ]
          },
          "400270413": {
            "id": "400270413",
            "speakerId": 1003,
            "speakerName": "安柏",
            "text": "班尼特是保持着坐姿睡着了吗？肯定是累坏了吧。",
            "nextDialogs": [
              "400270414"
            ]
          },
          "400270414": {
            "id": "400270414",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "每天都很不容易啊。",
            "nextDialogs": [
              "400270415"
            ]
          },
          "400270415": {
            "id": "400270415",
            "speakerId": 1002,
            "speakerName": "优菈",
            "text": "睡姿也很…有警惕性，不赖。",
            "nextDialogs": [
              "400270416"
            ]
          },
          "400270416": {
            "id": "400270416",
            "speakerId": 1004,
            "speakerName": "班尼特",
            "text": "呼…呼…",
            "nextDialogs": [
              "400270417"
            ]
          },
          "400270417": {
            "id": "400270417",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "睡得很香呢，不知道他会不会说梦话？",
            "nextDialogs": [
              "400270418"
            ]
          },
          "400270418": {
            "id": "400270418",
            "speakerId": 1004,
            "speakerName": "班尼特",
            "text": "唔…唔老爹，我不要吃苹果啦…我要吃蜜酱胡萝卜煎肉和渔人吐司…",
            "nextDialogs": [
              "400270419"
            ]
          },
          "400270419": {
            "id": "400270419",
            "speakerId": 1002,
            "speakerName": "优菈",
            "text": "蜜酱胡萝卜煎肉…安柏，是你喜欢的菜吧？",
            "nextDialogs": [
              "400270420"
            ]
          },
          "400270420": {
            "id": "400270420",
            "speakerId": 1003,
            "speakerName": "安柏",
            "text": "嘿嘿，是呀，我最喜欢「猎鹿人」的蜜酱胡萝卜煎肉啦！",
            "nextDialogs": [
              "400270421"
            ]
          },
          "400270421": {
            "id": "400270421",
            "speakerId": 1003,
            "speakerName": "安柏",
            "text": "旅行者你知道吗，我刚认识优菈那会儿经常带她去猎鹿人吃饭，后来莎拉一看到我们的脸，就会直接把我们常点的菜下锅。",
            "nextDialogs": [
              "400270422"
            ]
          },
          "400270422": {
            "id": "400270422",
            "speakerId": 1003,
            "speakerName": "安柏",
            "text": "她说，我们老是点一样的菜，她都背下来了！",
            "nextDialogs": [
              "400270423"
            ]
          },
          "400270423": {
            "id": "400270423",
            "speakerId": 1003,
            "speakerName": "安柏",
            "text": "然后还说，要是蒙德城里每个人都能像我们一样点菜，她的工作会好做得多，只要把大家爱吃的菜背下来就行…",
            "nextDialogs": [
              "400270424"
            ]
          },
          "400270424": {
            "id": "400270424",
            "speakerId": 1002,
            "speakerName": "优菈",
            "text": "咳咳！",
            "nextDialogs": [
              "400270425"
            ]
          },
          "400270425": {
            "id": "400270425",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "你们总是一起吃饭，感情可真好呀。",
            "nextDialogs": [
              "400270426"
            ]
          },
          "400270426": {
            "id": "400270426",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "#我和{NICKNAME}这家伙也总是一起吃饭，大概这就是友情的象征吧！",
            "nextDialogs": [
              "400270427"
            ]
          },
          "400270427": {
            "id": "400270427",
            "speakerId": 1002,
            "speakerName": "优菈",
            "text": "不过是一起进餐而已，不能说明什么感情问题。",
            "nextDialogs": [
              "400270428"
            ]
          },
          "400270428": {
            "id": "400270428",
            "speakerId": 1001,
            "speakerName": "阿贝多",
            "text": "一顿和很多顿，还是有区别的吧。",
            "nextDialogs": [
              "400270429"
            ]
          },
          "400270429": {
            "id": "400270429",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "同意。",
            "nextDialogs": [
              "400270430"
            ]
          },
          "400270430": {
            "id": "400270430",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "我发现了哦！优菈每次不想承认什么事的时候，就会把下巴扬起来，或者两手叉腰呢。",
            "nextDialogs": [
              "400270431"
            ]
          },
          "400270431": {
            "id": "400270431",
            "speakerId": 1002,
            "speakerName": "优菈",
            "text": "…哼。",
            "nextDialogs": [
              "400270432"
            ]
          },
          "400270432": {
            "id": "400270432",
            "speakerId": 1003,
            "speakerName": "安柏",
            "text": "原来大家都发现了啊，优菈的特点果然很容易捕捉呢。",
            "nextDialogs": [
              "400270433"
            ]
          },
          "400270433": {
            "id": "400270433",
            "speakerId": 1002,
            "speakerName": "优菈",
            "text": "既然已经是休息时间，我可以自由活动了吧？",
            "nextDialogs": [
              "400270434"
            ]
          },
          "400270434": {
            "id": "400270434",
            "speakerId": 1002,
            "speakerName": "优菈",
            "text": "那么各位，我还要去冰湖一趟，恕我先失陪了。",
            "nextDialogs": [
              "400270435"
            ]
          },
          "400270435": {
            "id": "400270435",
            "speakerId": 1003,
            "speakerName": "安柏",
            "text": "这么晚还要去泡冰水澡吗？等、等等我呀！",
            "nextDialogs": [
              "400270436"
            ]
          },
          "400270436": {
            "id": "400270436",
            "speakerId": 1002,
            "speakerName": "优菈",
            "text": "你不是要睡觉吗？留下休息吧。",
            "nextDialogs": [
              "400270437"
            ]
          },
          "400270437": {
            "id": "400270437",
            "speakerId": 1003,
            "speakerName": "安柏",
            "text": "还是陪你吧，这么晚了，周围又黑，你认路的本事没我强，我们一起比较好。",
            "nextDialogs": [
              "400270438"
            ]
          },
          "400270438": {
            "id": "400270438",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "冰水澡…真厉害啊…",
            "nextDialogs": [
              "400270439"
            ]
          },
          "400270439": {
            "id": "400270439",
            "speakerId": 1004,
            "speakerName": "班尼特",
            "text": "呼…烤肉，这么大一块…呼…呼…",
            "nextDialogs": [
              "400270440"
            ]
          },
          "400270440": {
            "id": "400270440",
            "speakerId": 1004,
            "speakerName": "班尼特",
            "text": "唔…老爹，我没问题的啦，我已经是冒险团团长了…呼…",
            "nextDialogs": [
              "400270441"
            ]
          },
          "400270441": {
            "id": "400270441",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "班尼特这家伙，梦话可真不少。",
            "nextDialogs": [
              "400270442"
            ]
          },
          "400270442": {
            "id": "400270442",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "好了，接下来是我们的自由时间啦！",
            "nextDialogs": [
              "400270443"
            ]
          },
          "400270443": {
            "id": "400270443",
            "speakerId": 1001,
            "speakerName": "阿贝多",
            "text": "到绘画时间了，二位。",
            "nextDialogs": [
              "400270446"
            ]
          },
          "400270446": {
            "id": "400270446",
            "speakerId": 1001,
            "speakerName": "阿贝多",
            "text": "想好画什么了吗？",
            "nextDialogs": [
              "400270447"
            ]
          },
          "400270447": {
            "id": "400270447",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "不用问，肯定是最好的伙伴我啦。",
            "nextDialogs": [
              "400270448"
            ]
          },
          "400270448": {
            "id": "400270448",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "那就画派蒙吧。",
            "nextDialogs": [
              "400270449"
            ]
          },
          "400270449": {
            "id": "400270449",
            "speakerId": 1001,
            "speakerName": "阿贝多",
            "text": "嗯，不过最好换个地方。留在这里可能会打扰到正在休息的班尼特，我们到外面去吧。",
            "nextDialogs": [
              "400270450"
            ]
          },
          "400270450": {
            "id": "400270450",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "好好好，画板画纸画笔颜料，通通带上别漏了！"
          }
        }
      }
    },
    {
      "subId": "4002710",
      "subQuestName": "前往作画地点",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "400270501"
        ],
        "dialogs": {
          "400270501": {
            "id": "400270501",
            "speakerId": 1001,
            "speakerName": "阿贝多",
            "text": "就在这里画吧。",
            "nextDialogs": [
              "400270502"
            ]
          },
          "400270502": {
            "id": "400270502",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "我来摆一个优雅的姿势供你参考好了！",
            "nextDialogs": [
              "400270503"
            ]
          },
          "400270503": {
            "id": "400270503",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "？",
            "nextDialogs": [
              "400270504"
            ]
          },
          "400270504": {
            "id": "400270504",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "喂——！你那是什么表情？不要质疑我，快点捕捉我的精髓画成画！画完我还想拿去挂在家里呢！",
            "nextDialogs": [
              "400270506"
            ]
          },
          "400270506": {
            "id": "400270506",
            "speakerId": 1001,
            "speakerName": "阿贝多",
            "text": "有气势是件好事，我很期待你的作品。"
          }
        }
      }
    },
    {
      "subId": "4002711",
      "subQuestName": "开始绘画",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [],
        "dialogs": {}
      }
    },
    {
      "subId": "4002712",
      "subQuestName": "(test)废弃$HIDDEN",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "400271201"
        ],
        "dialogs": {
          "400271201": {
            "id": "400271201",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "关于雪山…",
            "nextDialogs": [
              "400271202"
            ]
          },
          "400271202": {
            "id": "400271202",
            "speakerId": 1001,
            "speakerName": "阿贝多",
            "text": "即使到现在，我也无法完全掌握雪山上的威胁。",
            "nextDialogs": [
              "400271203"
            ]
          },
          "400271203": {
            "id": "400271203",
            "speakerId": 1001,
            "speakerName": "阿贝多",
            "text": "但我会努力保护你的，请你相信这一点。"
          }
        }
      }
    },
    {
      "subId": "4002713",
      "subQuestName": "(test)废弃$HIDDEN",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "400271301"
        ],
        "dialogs": {
          "400271301": {
            "id": "400271301",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "关于阿贝多自己…",
            "nextDialogs": [
              "400271302"
            ]
          },
          "400271302": {
            "id": "400271302",
            "speakerId": 1001,
            "speakerName": "阿贝多",
            "text": "哈，真想回答你一句「我很好」啊。",
            "nextDialogs": [
              "400271303"
            ]
          },
          "400271303": {
            "id": "400271303",
            "speakerId": 1001,
            "speakerName": "阿贝多",
            "text": "但你是我重要的朋友，我应该坦诚。",
            "nextDialogs": [
              "400271304"
            ]
          },
          "400271304": {
            "id": "400271304",
            "speakerId": 1001,
            "speakerName": "阿贝多",
            "text": "最近，我在思考一些问题，比如生命与创造。",
            "nextDialogs": [
              "400271305"
            ]
          },
          "400271305": {
            "id": "400271305",
            "speakerId": 1001,
            "speakerName": "阿贝多",
            "text": "我认为，在得出基本结论前就贸然与你讨论，给你带来的困扰会远多于好处。",
            "nextDialogs": [
              "400271306"
            ]
          },
          "400271306": {
            "id": "400271306",
            "speakerId": 1001,
            "speakerName": "阿贝多",
            "text": "等我厘清自己之后，我会和你说的。这段时间里，只能请你谅解了。"
          }
        }
      }
    },
    {
      "subId": "4002714",
      "subQuestName": "(test)废弃$HIDDEN",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "400271401"
        ],
        "dialogs": {
          "400271401": {
            "id": "400271401",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "关于今天发生的事…",
            "nextDialogs": [
              "400271402"
            ]
          },
          "400271402": {
            "id": "400271402",
            "speakerId": 1001,
            "speakerName": "阿贝多",
            "text": "不用担心，能有像这样围炉夜谈的机会，对我来说也很难能可贵。",
            "nextDialogs": [
              "400271403"
            ]
          },
          "400271403": {
            "id": "400271403",
            "speakerId": 1001,
            "speakerName": "阿贝多",
            "text": "不深入参与对话，只是我的个人习惯使然。",
            "nextDialogs": [
              "400271404"
            ]
          },
          "400271404": {
            "id": "400271404",
            "speakerId": 1001,
            "speakerName": "阿贝多",
            "text": "准确地说，你明白我享受这个氛围就可以了。",
            "nextDialogs": [
              "400271405"
            ]
          },
          "400271405": {
            "id": "400271405",
            "speakerId": 1001,
            "speakerName": "阿贝多",
            "text": "当然，如果你想和我多聊几句也不是不行。"
          }
        }
      }
    },

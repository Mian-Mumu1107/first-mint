  },
  "subQuests": [
    {
      "subId": "4022501",
      "subQuestName": "前往海面上的巨舰",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "402250101"
        ],
        "dialogs": {
          "402250101": {
            "id": "402250101",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "这艘船…",
            "nextDialogs": [
              "402250102"
            ]
          },
          "402250102": {
            "id": "402250102",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "死兆星号？",
            "nextDialogs": [
              "402250103"
            ]
          },
          "402250103": {
            "id": "402250103",
            "speakerId": 1031,
            "speakerName": "北斗",
            "text": "这是舰队里的二号舰，死兆星号还在孤云阁巡逻呢。",
            "nextDialogs": [
              "402250104"
            ]
          },
          "402250104": {
            "id": "402250104",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "是北斗！嗯…是纵横远海的佣兵巨头！",
            "nextDialogs": [
              "402250105"
            ]
          },
          "402250105": {
            "id": "402250105",
            "speakerId": 1031,
            "speakerName": "北斗",
            "text": "哈哈，又不是第一次见面，用这么恭维的称呼，生分了。",
            "nextDialogs": [
              "402250106"
            ]
          },
          "402250106": {
            "id": "402250106",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "说来话长…",
            "nextDialogs": [
              "402250107"
            ]
          },
          "402250107": {
            "id": "402250107",
            "speakerId": 1031,
            "speakerName": "北斗",
            "text": "别干站着，坐下谈吧，我让兄弟们招待一下客人。",
            "nextDialogs": [
              "402250108"
            ]
          },
          "402250108": {
            "id": "402250108",
            "speakerId": 1031,
            "speakerName": "北斗",
            "text": "原来是这样，没想到你和那位秘闻馆的主人也有交情。足迹遍及提瓦特的人，果然会攒下不得了的人脉啊。",
            "nextDialogs": [
              "402250109"
            ]
          },
          "402250109": {
            "id": "402250109",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "嘿嘿…",
            "nextDialogs": [
              "402250110"
            ]
          },
          "402250110": {
            "id": "402250110",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "对了，登记的事…",
            "nextDialogs": [
              "402250111"
            ]
          },
          "402250111": {
            "id": "402250111",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "差点忘了，我们需要登记你这边的参展人员，还有你准备交易什么货物？",
            "nextDialogs": [
              "402250112"
            ]
          },
          "402250112": {
            "id": "402250112",
            "speakerId": 1031,
            "speakerName": "北斗",
            "text": "参展人员的话，记上我和几名看管货柜的兄弟就行，其他人都会留在船上。至于用来交易的货物…喏。",
            "nextDialogs": [
              "402250113"
            ]
          },
          "402250113": {
            "id": "402250113",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "这是…",
            "nextDialogs": [
              "402250114"
            ]
          },
          "402250114": {
            "id": "402250114",
            "speakerId": 1031,
            "speakerName": "北斗",
            "text": "很早之前，凝光就着手改良归终机，我这二号舰上装备的就是她改良后的一种型号。",
            "nextDialogs": [
              "402250115"
            ]
          },
          "402250115": {
            "id": "402250115",
            "speakerId": 1031,
            "speakerName": "北斗",
            "text": "这种型号的归终机可以通过远程引导精准攻击目标，威力也十分惊人，在这个展会上肯定会很抢手。",
            "nextDialogs": [
              "402250116"
            ]
          },
          "402250116": {
            "id": "402250116",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "这种东西可以拿来卖吗？",
            "nextDialogs": [
              "402250117"
            ]
          },
          "402250117": {
            "id": "402250117",
            "speakerId": 1031,
            "speakerName": "北斗",
            "text": "哈哈，不用担心，千岩军现在装备的最新型号比这个先进多了，这已经算是被淘汰下来的。",
            "nextDialogs": [
              "402250118"
            ]
          },
          "402250118": {
            "id": "402250118",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "…算了，就像奈芙尔说的那样，这里的交易「无所禁忌」。",
            "nextDialogs": [
              "402250119"
            ]
          },
          "402250119": {
            "id": "402250119",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "不过，谁会买这个？",
            "nextDialogs": [
              "402250120"
            ]
          },
          "402250120": {
            "id": "402250120",
            "speakerId": 1048,
            "speakerName": "夜兰",
            "text": "不用担心，挪德卡莱贸易展会汇聚了来自提瓦特各地的买家，肯定能钓到大客户的。",
            "nextDialogs": [
              "402250121"
            ]
          },
          "402250121": {
            "id": "402250121",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "夜兰？",
            "nextDialogs": [
              "402250122"
            ]
          },
          "402250122": {
            "id": "402250122",
            "speakerId": 1031,
            "speakerName": "北斗",
            "text": "怪我，一直忙着卸货的事，忘了告诉你们她也在船上。",
            "nextDialogs": [
              "402250123"
            ]
          },
          "402250123": {
            "id": "402250123",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "没关系啦，话说夜兰也是参展人员吗？",
            "nextDialogs": [
              "402250124"
            ]
          },
          "402250124": {
            "id": "402250124",
            "speakerId": 1048,
            "speakerName": "夜兰",
            "text": "我只是搭顺风船来挪德卡莱处理一些情报工作，就不用登记我的名字了。",
            "nextDialogs": [
              "402250125"
            ]
          },
          "402250125": {
            "id": "402250125",
            "speakerId": 1048,
            "speakerName": "夜兰",
            "text": "#有段时间没见了，{NICKNAME}。如果有机会的话，请代我向秘闻馆的主人问好。",
            "nextDialogs": [
              "402250126"
            ]
          },
          "402250126": {
            "id": "402250126",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "你这次来准备做什么？",
            "nextDialogs": [
              "402250127"
            ]
          },
          "402250127": {
            "id": "402250127",
            "speakerId": 1048,
            "speakerName": "夜兰",
            "text": "工作需要，不便多讲。",
            "nextDialogs": [
              "402250128"
            ]
          },
          "402250128": {
            "id": "402250128",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "那是「不要继续问了」的表情吧？",
            "nextDialogs": [
              "402250129"
            ]
          },
          "402250129": {
            "id": "402250129",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "我也这么认为…",
            "nextDialogs": [
              "402250130"
            ]
          },
          "402250130": {
            "id": "402250130",
            "speakerId": 1048,
            "speakerName": "夜兰",
            "text": "那我就先下船了，等事情办完后，我请大家喝一杯。",
            "nextDialogs": [
              "402250131"
            ]
          },
          "402250131": {
            "id": "402250131",
            "speakerId": 1031,
            "speakerName": "北斗",
            "text": "哈哈，那我可要好好尝尝挪德卡莱的味道。",
            "nextDialogs": [
              "402250132"
            ]
          },
          "402250132": {
            "id": "402250132",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "这边已经帮你们登记好了，跟我们走吧，接下来带大家去会场。"
          }
        }
      }
    },
    {
      "subId": "4022502",
      "subQuestName": "带领北斗前往会场",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "402250201"
        ],
        "dialogs": {
          "402250201": {
            "id": "402250201",
            "speakerId": 1003,
            "speakerName": "Black Screen",
            "text": "北斗指挥船员卸下了货物，并跟随你们来到了展会现场",
            "nextDialogs": [
              "402250202"
            ]
          },
          "402250202": {
            "id": "402250202",
            "speakerId": 1031,
            "speakerName": "北斗",
            "text": "就是这里了吧？好位置！",
            "nextDialogs": [
              "402250203"
            ]
          },
          "402250203": {
            "id": "402250203",
            "speakerId": 1031,
            "speakerName": "北斗",
            "text": "#{NICKNAME}，你有空的时候来帮我测试一下远程引导吧。很刺激的，你肯定喜欢。"
          }
        }
      }
    }
  ]
}
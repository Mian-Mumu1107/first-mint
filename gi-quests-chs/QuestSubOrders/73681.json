  "subQuests": [
    {
      "subId": "7368101",
      "subQuestName": "与伯恩哈德对话",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "736810101"
        ],
        "dialogs": {
          "736810101": {
            "id": "736810101",
            "speakerId": 1000,
            "speakerName": "伯恩哈德",
            "text": "旅行者，派蒙，你们来了。我听说你们参加了寻找「丰饶之箱」的活动，怎么样，有趣吗？",
            "nextDialogs": [
              "736810102"
            ]
          },
          "736810102": {
            "id": "736810102",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "挺有意思的！而且不知道是不是因为佳酿节期间开设了美酒集市的关系，我们还获得了各式各样的装饰品呢。",
            "nextDialogs": [
              "736810103"
            ]
          },
          "736810103": {
            "id": "736810103",
            "speakerId": 1000,
            "speakerName": "伯恩哈德",
            "text": "哈哈，确实会有人准备这些东西作为礼物呢。对了，既然我们就在经营小吃店，要不要把那些装饰品摆在这里？",
            "nextDialogs": [
              "736810104"
            ]
          },
          "736810104": {
            "id": "736810104",
            "speakerId": 1000,
            "speakerName": "伯恩哈德",
            "text": "把店铺布置得漂亮一点，应该能吸引更多客人前来光顾。",
            "nextDialogs": [
              "736810105"
            ]
          },
          "736810105": {
            "id": "736810105",
            "speakerId": 1000,
            "speakerName": "伯恩哈德",
            "text": "而且，送礼的人如果看到自己的心意出现在旅行者的店铺这里，也一定会非常开心的。",
            "nextDialogs": [
              "736810106"
            ]
          },
          "736810106": {
            "id": "736810106",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "#你说得有道理！{NICKNAME}，那我们就好好装饰一下我们的店面吧！"
          }
        }
      }
    }
  ]
}
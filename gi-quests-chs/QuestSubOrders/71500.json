    {
      "subId": "7150006",
      "subQuestName": "协助留云借风真君完成烹饪",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "715000601"
        ],
        "dialogs": {
          "715000601": {
            "id": "715000601",
            "speakerId": 10258,
            "speakerName": "留云借风真君",
            "text": "旅行者，本仙已启动机关，你且循着气息，去把本仙的竹笋拿回来吧。"
          }
        }
      }
    },
    {
      "subId": "7150007",

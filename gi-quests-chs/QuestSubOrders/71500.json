      "locations": [],
      "dialogue": {
        "startDialogs": [
          "715000401"
        ],
        "dialogs": {
          "715000401": {
            "id": "715000401",
            "speakerId": 10258,
            "speakerName": "留云借风真君",
            "text": "火候似乎控制得不太成功…",
            "nextDialogs": [
              "715000402"
            ]
          },
          "715000402": {
            "id": "715000402",
            "speakerId": 10258,
            "speakerName": "留云借风真君",
            "text": "无妨。还有备用食材，随我再试一次吧。"
          }
        }
      }

  "subQuests": [
    {
      "subId": "7150012",
      "subQuestName": "(test)领取任务前置$HIDDEN",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "715001201"
        ],
        "dialogs": {
          "715001201": {
            "id": "715001201",
            "speakerId": 10258,
            "speakerName": "留云借风真君",
            "text": "嗯，不错，这正是甘雨帮本仙置办的竹笋。",
            "nextDialogs": [
              "715001202"
            ]
          },
          "715001202": {
            "id": "715001202",
            "speakerId": 10258,
            "speakerName": "留云借风真君",
            "text": "食材已经备齐了，那我们等一下就可以开始烹饪了。"
          }
        }
      }
    },
    {
      "subId": "7150001",
      "subQuestName": "与留云借风真君对话",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "715000101"
        ],
        "dialogs": {
          "715000101": {
            "id": "715000101",
            "speakerId": 10258,
            "speakerName": "留云借风真君",
            "text": "唔…如此便好…",
            "nextDialogs": [
              "715000102"
            ]
          },
          "715000102": {
            "id": "715000102",
            "speakerId": 10258,
            "speakerName": "留云借风真君",
            "text": "旅行者，你来得正巧，本仙刚把这机关给安置周全。",
            "nextDialogs": [
              "715000104",
              "715000106"
            ]
          },
          "715000104": {
            "id": "715000104",
            "speakerId": 10258,
            "speakerName": "留云借风真君",
            "text": "正是。这机关由本仙亲自设计安置，妙用无穷。",
            "nextDialogs": [
              "715000107"
            ]
          },
          "715000107": {
            "id": "715000107",
            "speakerId": 10258,
            "speakerName": "留云借风真君",
            "text": "为了制作这烹饪用机关，本仙查阅无数古籍。须知，在「烹饪」这一事中，有几件最重要的事。",
            "nextDialogs": [
              "715000108"
            ]
          },
          "715000108": {
            "id": "715000108",
            "speakerId": 10258,
            "speakerName": "留云借风真君",
            "text": "其一，寻觅食材。烹饪一事中，食材至关重要。为了搜罗珍奇的食材，无数厨师劳心劳力，四处奔波…",
            "nextDialogs": [
              "715000109"
            ]
          },
          "715000109": {
            "id": "715000109",
            "speakerId": 10258,
            "speakerName": "留云借风真君",
            "text": "本仙的机关，首先便能解决这一难题。",
            "nextDialogs": [
              "715000110"
            ]
          },
          "715000110": {
            "id": "715000110",
            "speakerId": 10258,
            "speakerName": "留云借风真君",
            "text": "只需启动这机关，它便会自动寻找周边最适合烹饪的食材，并且沿途标识出该食材的气息，厨师只需要循路前往即可。",
            "nextDialogs": [
              "715000111"
            ]
          },
          "715000111": {
            "id": "715000111",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "它不能自己去拿吗？",
            "nextDialogs": [
              "715000112"
            ]
          },
          "715000112": {
            "id": "715000112",
            "speakerId": 10258,
            "speakerName": "留云借风真君",
            "text": "咳，这个嘛…本仙研究时间尚短，暂时无法解决…锅怎么在崎岖山路上自动寻路这个问题。",
            "nextDialogs": [
              "715000113"
            ]
          },
          "715000113": {
            "id": "715000113",
            "speakerId": 10258,
            "speakerName": "留云借风真君",
            "text": "其二，即是烹煮一事。本仙在机关内设置了无数机巧物件，只需投入食材，它便会自动处理妥当。",
            "nextDialogs": [
              "715000114"
            ]
          },
          "715000114": {
            "id": "715000114",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "它怎么知道要怎样处理食材？",
            "nextDialogs": [
              "715000115"
            ]
          },
          "715000115": {
            "id": "715000115",
            "speakerId": 10258,
            "speakerName": "留云借风真君",
            "text": "这个嘛…自然是要按照对应的菜谱细细设置各项参数，将每种食材所需的处理方法都设置好。",
            "nextDialogs": [
              "715000116"
            ]
          },
          "715000116": {
            "id": "715000116",
            "speakerId": 10258,
            "speakerName": "留云借风真君",
            "text": "个中奥妙，三言两语难说清，本仙不作赘述，你们只要明白这事挺麻烦就行。",
            "nextDialogs": [
              "715000117"
            ]
          },
          "715000117": {
            "id": "715000117",
            "speakerId": 10258,
            "speakerName": "留云借风真君",
            "text": "此外，结合本仙心得，烹饪期间最令厨师们烦躁的杂事，乃是「清理锅灶」。",
            "nextDialogs": [
              "715000118"
            ]
          },
          "715000118": {
            "id": "715000118",
            "speakerId": 10258,
            "speakerName": "留云借风真君",
            "text": "否则，大快朵颐之后，还得清理锅中的残羹冷炙，实在有些煞风景…"
          },
          "715000106": {
            "id": "715000106",
            "speakerId": 10258,
            "speakerName": "留云借风真君",
            "text": "哼，你倒是心急。稍安勿躁，待本仙慢慢为你道来。"
          }
        }
      }
    },
    {
      "subId": "7150002",
      "subQuestName": "跟随气息的踪迹，寻找食材",
      "sceneId": null,

          "715000901"
        ],
        "dialogs": {
          "715000901": {
            "id": "715000901",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "准备好了。",
            "nextDialogs": [
              "715000902"
            ]
          },
          "715000902": {
            "id": "715000902",
            "speakerId": 10258,
            "speakerName": "留云借风真君",
            "text": "那我们就开始吧。",
            "nextDialogs": [
              "715000903"
            ]
          },
          "715000903": {
            "id": "715000903",
            "speakerId": 10258,
            "speakerName": "留云借风真君",
            "text": "机关烹饪神机…启！"
          }
        }
      }
    },
    {
      "subId": "7150009",

    {
      "subId": "7335501",
      "subQuestName": "前往拜达港",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "733550101"
        ],
        "dialogs": {
          "733550101": {
            "id": "733550101",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "咦，那边有只蕈兽飘过去了欸，没问题吗？",
            "nextDialogs": [
              "733550102"
            ]
          },
          "733550102": {
            "id": "733550102",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "一般来说，蕈兽在城区活动，还是有点危险的吧！除非是特别听话，受过训练的特例…",
            "nextDialogs": [
              "733550103"
            ]
          },
          "733550103": {
            "id": "733550103",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "不对呀，怎么好像有点熟悉，以前我们是不是经历过类似的情景。",
            "nextDialogs": [
              "733550105",
              "733550108"
            ]
          },
          "733550105": {
            "id": "733550105",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "对！「咚咚小圆帽」！我们在须弥结识的蕈兽伙伴！",
            "nextDialogs": [
              "733550106"
            ]
          },
          "733550106": {
            "id": "733550106",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "呜啊啊啊啊啊，上次见面都好久好久了！我们快过去看看吧！"
          },
          "733550108": {
            "id": "733550108",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "好像是…「咚咚小圆帽」？我们在须弥结识的蕈兽伙伴！",
            "nextDialogs": [
              "733550109"
            ]
          },
          "733550109": {
            "id": "733550109",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "呜啊啊啊啊啊，上次见面都好久好久了！我们快过去看看吧！"
          }
        }
      }
    },
    {
      "subId": "7335502",
      "subQuestName": "与海妮耶对话",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "733550201"
        ],
        "dialogs": {
          "733550201": {
            "id": "733550201",
            "speakerId": 1001,
            "speakerName": "海妮耶",
            "text": "嗯？看来不需要在冒险家协会留言，奇妙的缘分就会指引着我们重逢…",
            "nextDialogs": [
              "733550202"
            ]
          },
          "733550202": {
            "id": "733550202",
            "speakerId": 1001,
            "speakerName": "海妮耶",
            "text": "终于又见面了，「黄金流星」和「白银伴星」。",
            "nextDialogs": [
              "733550203"
            ]
          },
          "733550203": {
            "id": "733550203",
            "speakerId": 1001,
            "speakerName": "海妮耶",
            "text": "你们容光焕发的模样，让我有种时间停滞的美好感觉。",
            "nextDialogs": [
              "733550205",
              "733550209"
            ]
          },
          "733550205": {
            "id": "733550205",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "真的是你们啊，海妮耶和「咚咚小圆帽」！",
            "nextDialogs": [
              "733550206"
            ]
          },
          "733550206": {
            "id": "733550206",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "难怪看过留言，我就有种奇妙的熟悉感…说明我和「咚咚小圆帽」的默契还在！",
            "nextDialogs": [
              "733550207"
            ]
          },
          "733550207": {
            "id": "733550207",
            "speakerId": 1002,
            "speakerName": "咚咚小圆帽",
            "text": "♪~",
            "nextDialogs": [
              "733550212"
            ]
          },
          "733550212": {
            "id": "733550212",
            "speakerId": 1001,
            "speakerName": "海妮耶",
            "text": "我设想过许多重逢的情景，比如举办丰盛的宴会，或是富有创意的欢迎仪式，给你个巨大的惊喜。",
            "nextDialogs": [
              "733550213"
            ]
          },
          "733550213": {
            "id": "733550213",
            "speakerId": 1001,
            "speakerName": "海妮耶",
            "text": "但感觉都有些见外，考虑到你们一直很忙，说不定占用太长时间，反而会让你们觉得麻烦。",
            "nextDialogs": [
              "733550214"
            ]
          },
          "733550214": {
            "id": "733550214",
            "speakerId": 1001,
            "speakerName": "海妮耶",
            "text": "而且，现在的蕈兽伙伴们也喜欢宁静的环境，所以，就让我们以松弛自然的方式重逢吧。",
            "nextDialogs": [
              "733550215"
            ]
          },
          "733550215": {
            "id": "733550215",
            "speakerId": 1003,
            "speakerName": "左右加",
            "text": "没错没错，海妮耶读的散文派上用场啦，平静的心态对生活有益！",
            "nextDialogs": [
              "733550216"
            ]
          },
          "733550216": {
            "id": "733550216",
            "speakerId": 1003,
            "speakerName": "左右加",
            "text": "还是像这样，轻轻松松聊天最开心。",
            "nextDialogs": [
              "733550217"
            ]
          },
          "733550217": {
            "id": "733550217",
            "speakerId": 1004,
            "speakerName": "欢腾之火",
            "text": "♫~",
            "nextDialogs": [
              "733550218"
            ]
          },
          "733550218": {
            "id": "733550218",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "左右加小姐也在，还有「欢腾之火」和…这位是？",
            "nextDialogs": [
              "733550219"
            ]
          },
          "733550219": {
            "id": "733550219",
            "speakerId": 1003,
            "speakerName": "左右加",
            "text": "是我自己的蕈兽伙伴「信风舞姬」哦，当时在三十二强赛上，被你们和「咚咚小圆帽」一下就打败了！",
            "nextDialogs": [
              "733550220"
            ]
          },
          "733550220": {
            "id": "733550220",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "哎呀，还是你记得清楚！"
          },
          "733550209": {
            "id": "733550209",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "确实是海妮耶和「咚咚小圆帽」！我们好久之前在「月莲杯驯兽师大赛」认识的朋友！",
            "nextDialogs": [
              "733550210"
            ]
          },
          "733550210": {
            "id": "733550210",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "印象里，之后我们还在奥摩斯港附近，还有枫丹廷见过面！不知不觉，已经过去这么长时间了…",
            "nextDialogs": [
              "733550211"
            ]
          },
          "733550211": {
            "id": "733550211",
            "speakerId": 1002,
            "speakerName": "咚咚小圆帽",
            "text": "♪~"
          }
        }
      }
    }
  ]

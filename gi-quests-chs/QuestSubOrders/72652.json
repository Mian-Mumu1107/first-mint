        ],
        "dialogs": {
          "726520101": {
            "id": "726520101",
            "speakerId": 3005501,
            "speakerName": "？？？",
            "text": "旅行者，你好！最近过得怎样？有没有兴趣给南十字船队帮忙呀？",
            "nextDialogs": [
              "726520104"
            ]
          },
          "726520104": {
            "id": "726520104",
            "speakerId": 3005501,
            "speakerName": "？？？",
            "text": "欸…啊哈哈哈哈，抱歉抱歉！",
            "nextDialogs": [
              "726520105"
            ]
          },
          "726520105": {
            "id": "726520105",
            "speakerId": 30055,
            "speakerName": "慕珍",
            "text": "我是「死兆星号」的首席技术官慕珍。以往一直呆在船舱里不怎么出来，你不认识我也正常。",
            "nextDialogs": [
              "726520106"
            ]
          },
          "726520106": {
            "id": "726520106",
            "speakerId": 30055,
            "speakerName": "慕珍",
            "text": "结果这不是被海龙大哥一脚踢出来了，哈哈。",
            "nextDialogs": [
              "726520107"
            ]
          },
          "726520107": {
            "id": "726520107",
            "speakerId": 30055,
            "speakerName": "慕珍",
            "text": "「动动你的懒骨头吧！晒晒太阳又没坏处！」这么说着就把我赶到岸上来了…",
            "nextDialogs": [
              "726520108"
            ]
          },
          "726520108": {
            "id": "726520108",
            "speakerId": 30055,
            "speakerName": "慕珍",
            "text": "可是他自己连下船都不敢，一站在陆地上就晕。"
          }
        }
      }
    },

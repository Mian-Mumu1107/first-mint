    {
      "subId": "1200208",
      "subQuestName": "与石壮对话",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "120020801"
        ],
        "dialogs": {
          "120020801": {
            "id": "120020801",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "请问，你就是开采石珀的负责人吗？",
            "nextDialogs": [
              "120020802"
            ]
          },
          "120020802": {
            "id": "120020802",
            "speakerId": 1005,
            "speakerName": "石壮",
            "text": "哦哦，终于来了。听说「飞云商会」在璃月港大批购买石珀，我就想你们会来的。",
            "nextDialogs": [
              "120020803"
            ]
          },
          "120020803": {
            "id": "120020803",
            "speakerId": 1005,
            "speakerName": "石壮",
            "text": "我这里确实还有一批暂时还没有被运走的石珀，只要你们开价够高就可以卖给你们。",
            "nextDialogs": [
              "120020806"
            ]
          },
          "120020806": {
            "id": "120020806",
            "speakerId": 1005,
            "speakerName": "石壮",
            "text": "因为对方的开价也高，现在这一批…要七百万摩拉才行。",
            "nextDialogs": [
              "120020807"
            ]
          },
          "120020807": {
            "id": "120020807",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "啊？！明明在璃月港一共才花掉了不到两百万摩拉！",
            "nextDialogs": [
              "120020808"
            ]
          },
          "120020808": {
            "id": "120020808",
            "speakerId": 1005,
            "speakerName": "石壮",
            "text": "没办法，价高者得，我卖给你们其实也是毁约了，价格不高可不行。"
          }
        }
      }
    },
    {
      "subId": "1200209",

    {
      "subId": "1200203",
      "subQuestName": "与「飞云商会」的家丁对话",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "120020301"
        ],
        "dialogs": {
          "120020301": {
            "id": "120020301",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "打扰了，我们有一事相求。请先读一下这封信吧。",
            "nextDialogs": [
              "120020302"
            ]
          },
          "120020302": {
            "id": "120020302",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "你说话也有他的味道了。",
            "nextDialogs": [
              "120020303"
            ]
          },
          "120020303": {
            "id": "120020303",
            "speakerId": 1001,
            "speakerName": "阿旭",
            "text": "信？哦哦，原来又是这么一回事啊…",
            "nextDialogs": [
              "120020306"
            ]
          },
          "120020306": {
            "id": "120020306",
            "speakerId": 1001,
            "speakerName": "阿旭",
            "text": "没事没事，只是我的凭空猜测，待我读一下信中的内容。",
            "nextDialogs": [
              "120020307"
            ]
          },
          "120020307": {
            "id": "120020307",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "他读得懂吗…话说这个真的是提瓦特通用语吗…",
            "nextDialogs": [
              "120020308"
            ]
          },
          "120020308": {
            "id": "120020308",
            "speakerId": 1001,
            "speakerName": "阿旭",
            "text": "嗯…没错，这字确实不是别人能模仿的。",
            "nextDialogs": [
              "120020309"
            ]
          },
          "120020309": {
            "id": "120020309",
            "speakerId": 1001,
            "speakerName": "阿旭",
            "text": "两位贵客旅途劳顿，实在辛苦，就由我们「飞云商会」为你们接风洗尘。"
          }
        }
      }
    },
    {
      "subId": "1200202",
      "subQuestName": "进入琉璃亭",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "120020201"
        ],
        "dialogs": {
          "120020201": {
            "id": "120020201",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "这里就是「飞云商会」，璃月港阔绰的地方真是不少啊。",
            "nextDialogs": [
              "120020202"
            ]
          },
          "120020202": {
            "id": "120020202",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "我们快把信送进去吧。"
          }
        }
      }
    },
    {
      "subId": "1200221",
      "subQuestName": "与家丁对话",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "120020317"
        ],
        "dialogs": {
          "120020317": {
            "id": "120020317",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "还以为会被粗暴对待或者直接被轰走呢…",
            "nextDialogs": [
              "120020318"
            ]
          },
          "120020318": {
            "id": "120020318",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "想不到书呆子的面子这么大。",
            "nextDialogs": [
              "120020319"
            ]
          },
          "120020319": {
            "id": "120020319",
            "speakerId": 1001,
            "speakerName": "阿旭",
            "text": "二位久等了，「飞云商会」已经安排妥当。",
            "nextDialogs": [
              "120020320"
            ]
          },
          "120020320": {
            "id": "120020320",
            "speakerId": 1001,
            "speakerName": "阿旭",
            "text": "茂才公有钱有势，普通的教训对他来说不疼不痒。",
            "nextDialogs": [
              "120020321"
            ]
          },
          "120020321": {
            "id": "120020321",
            "speakerId": 1001,
            "speakerName": "阿旭",
            "text": "要让他不再做同样的事，只能让他切身感受到和常九爷同样的痛苦。",
            "nextDialogs": [
              "120020322"
            ]
          },
          "120020322": {
            "id": "120020322",
            "speakerId": 1001,
            "speakerName": "阿旭",
            "text": "茂才公的生意和石珀有关，那只要能买下整个璃月的石珀，就能让茂才公陷入绝境。",
            "nextDialogs": [
              "120020323"
            ]
          },
          "120020323": {
            "id": "120020323",
            "speakerId": 1001,
            "speakerName": "阿旭",
            "text": "要是没有原料，再厉害的工匠也做不出商品吧。",
            "nextDialogs": [
              "120020324"
            ]
          },
          "120020324": {
            "id": "120020324",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "原来如此！这样他就没法给「愚人众」交差了！",
            "nextDialogs": [
              "120020325"
            ]
          },
          "120020325": {
            "id": "120020325",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "不过，璃月这么大，要买下所有的石珀也很麻烦吧？",
            "nextDialogs": [
              "120020326"
            ]
          },
          "120020326": {
            "id": "120020326",
            "speakerId": 1001,
            "speakerName": "阿旭",
            "text": "嗯，一时间确实难以全部收购，所以按照信中安排，还要劳烦二位客人帮帮忙。",
            "nextDialogs": [
              "120020327"
            ]
          },
          "120020327": {
            "id": "120020327",
            "speakerId": 1001,
            "speakerName": "阿旭",
            "text": "首先是璃月城中的几家店铺，我会在地图上为你们标出位置。",
            "nextDialogs": [
              "120020328"
            ]
          },
          "120020328": {
            "id": "120020328",
            "speakerId": 1001,
            "speakerName": "阿旭",
            "text": "然后在层岩巨渊还有一些暂时没被收购的石珀，也需要买下来。",
            "nextDialogs": [
              "120020329"
            ]
          },
          "120020329": {
            "id": "120020329",
            "speakerId": 1001,
            "speakerName": "阿旭",
            "text": "最后，就是常九爷手上的那一批了。",
            "nextDialogs": [
              "120020330"
            ]
          },
          "120020330": {
            "id": "120020330",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "嗯嗯，城里三家店，层岩巨渊，常九爷，我记住了！",
            "nextDialogs": [
              "120020331"
            ]
          },
          "120020331": {
            "id": "120020331",
            "speakerId": 1001,
            "speakerName": "阿旭",
            "text": "当然，采购的开销请完全不用担心。",
            "nextDialogs": [
              "120020332"
            ]
          },
          "120020332": {
            "id": "120020332",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "哇，这么多摩拉？！都、都能把琉璃亭包下来吃一个月了吧！",
            "nextDialogs": [
              "120020333"
            ]
          },
          "120020333": {
            "id": "120020333",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "「飞云商会」还真是舍得。",
            "nextDialogs": [
              "120020334"
            ]
          },
          "120020334": {
            "id": "120020334",
            "speakerId": 1001,
            "speakerName": "阿旭",
            "text": "呵呵，这样的事以前也有过几次，已经习惯了。",
            "nextDialogs": [
              "120020335"
            ]
          },
          "120020335": {
            "id": "120020335",
            "speakerId": 1001,
            "speakerName": "阿旭",
            "text": "两位只需要谈成交易即可，余下运输之类的琐事都交给「飞云商会」来打点。",
            "nextDialogs": [
              "120020336"
            ]
          },
          "120020336": {
            "id": "120020336",
            "speakerId": 1001,
            "speakerName": "阿旭",
            "text": "等两位全部收购完成之后，就可以去「飞云商会」的仓库看好戏了。"
          }
        }
      }
    },
    {
      "subId": "1200204",
      "subQuestName": "前往商铺购买石珀",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "120020401"
        ],
        "dialogs": {
          "120020401": {
            "id": "120020401",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "想买下你所有的石珀。",
            "nextDialogs": [
              "120020402"
            ]
          },
          "120020402": {
            "id": "120020402",
            "speakerId": 1002,
            "speakerName": "博来",
            "text": "所有？我先说啊，别看我的铺子不大，货源可是有明有暗，加起来广得很。",
            "nextDialogs": [
              "120020403"
            ]
          },
          "120020403": {
            "id": "120020403",
            "speakerId": 1002,
            "speakerName": "博来",
            "text": "你就告诉我个数吧，真把所有货都调来了，怕你吃不下。",
            "nextDialogs": [
              "120020405",
              "120020407"
            ]
          },
          "120020405": {
            "id": "120020405",
            "speakerId": 1002,
            "speakerName": "博来",
            "text": "飞…「飞云商会」！那…那早说啊。",
            "nextDialogs": [
              "120020408"
            ]
          },
          "120020408": {
            "id": "120020408",
            "speakerId": 1002,
            "speakerName": "博来",
            "text": "既然是「飞云商会」那就没问题了，来签契约吧，我马上帮你调货！"
          },
          "120020407": {
            "id": "120020407",
            "speakerId": 1002,
            "speakerName": "博来",
            "text": "说什么呢，我的货当然都是合法的。不过，「飞云商会」啊…"
          }
        }
      }
    },
    {
      "subId": "1200205",
      "subQuestName": "前往商铺购买石珀",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "120020501"
        ],
        "dialogs": {
          "120020501": {
            "id": "120020501",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "想买下你所有的石珀。",
            "nextDialogs": [
              "120020502"
            ]
          },
          "120020502": {
            "id": "120020502",
            "speakerId": 1003,
            "speakerName": "长顺",
            "text": "所有的石珀？唔，其实我已经接了好几单石珀的生意了。",
            "nextDialogs": [
              "120020503"
            ]
          },
          "120020503": {
            "id": "120020503",
            "speakerId": 1003,
            "speakerName": "长顺",
            "text": "不过都是口头约定，暂时还没签契约…买家感觉很精明，一直没有决定下来。",
            "nextDialogs": [
              "120020504"
            ]
          },
          "120020504": {
            "id": "120020504",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "「飞云商会」全包了。",
            "nextDialogs": [
              "120020505"
            ]
          },
          "120020505": {
            "id": "120020505",
            "speakerId": 1003,
            "speakerName": "长顺",
            "text": "原来是「飞云商会」！嗯，原来如此，看来璃月的商界又有动向了…",
            "nextDialogs": [
              "120020506"
            ]
          },
          "120020506": {
            "id": "120020506",
            "speakerId": 1003,
            "speakerName": "长顺",
            "text": "啊，没事，不用在意！我只是在自言自语，我们来签契约吧。",
            "nextDialogs": [
              "120020507"
            ]
          },
          "120020507": {
            "id": "120020507",
            "speakerId": 1003,
            "speakerName": "长顺",
            "text": "不用担心约定的事，对方也没付定金，这在生意场上是很正常的事。",
            "nextDialogs": [
              "120020508"
            ]
          },
          "120020508": {
            "id": "120020508",
            "speakerId": 1003,
            "speakerName": "长顺",
            "text": "谢谢您的惠顾，还望「飞云商会」多来照顾我家生意啊！"
          }
        }
      }
    },
    {
      "subId": "1200206",
      "subQuestName": "前往商铺购买石珀",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "120020601"
        ],
        "dialogs": {
          "120020601": {
            "id": "120020601",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "石珀也没有了吗？",
            "nextDialogs": [
              "120020602"
            ]
          },
          "120020602": {
            "id": "120020602",
            "speakerId": 1004,
            "speakerName": "伊凡诺维奇",
            "text": "哦哦，我还以为是来买至冬国的商品的。",
            "nextDialogs": [
              "120020603"
            ]
          },
          "120020603": {
            "id": "120020603",
            "speakerId": 1004,
            "speakerName": "伊凡诺维奇",
            "text": "石珀倒是有…只不过我的石珀都是发给至冬国工厂的，不做零星的生意。",
            "nextDialogs": [
              "120020604"
            ]
          },
          "120020604": {
            "id": "120020604",
            "speakerId": 1004,
            "speakerName": "伊凡诺维奇",
            "text": "需求少，管理起来又麻烦，所以，抱歉啦。",
            "nextDialogs": [
              "120020607"
            ]
          },
          "120020607": {
            "id": "120020607",
            "speakerId": 1004,
            "speakerName": "伊凡诺维奇",
            "text": "原、原来是这样…那我考虑一下，稍等。",
            "nextDialogs": [
              "120020608"
            ]
          },
          "120020608": {
            "id": "120020608",
            "speakerId": 1004,
            "speakerName": "伊凡诺维奇",
            "text": "好吧，那只需要在契约上签个字就行了。",
            "nextDialogs": [
              "120020609"
            ]
          },
          "120020609": {
            "id": "120020609",
            "speakerId": 1004,
            "speakerName": "伊凡诺维奇",
            "text": "（唉，璃月人可真是有钱啊…）"
          }
        }
      }
    },

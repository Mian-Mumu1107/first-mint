      }
    },
    {
      "subId": "2003703",
      "subQuestName": "将信送给葛罗丽",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "200370301"
        ],
        "dialogs": {
          "200370301": {
            "id": "200370301",
            "speakerId": 1521,
            "speakerName": "葛罗丽",
            "text": "您好…啊，这个声音，是之前的那位旅行者吧。",
            "nextDialogs": [
              "200370302"
            ]
          },
          "200370302": {
            "id": "200370302",
            "speakerId": 1521,
            "speakerName": "葛罗丽",
            "text": "请问您找我有什么事吗？",
            "nextDialogs": [
              "200370303"
            ]
          },
          "200370303": {
            "id": "200370303",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "有人托我带给你一封信。",
            "nextDialogs": [
              "200370304"
            ]
          },
          "200370304": {
            "id": "200370304",
            "speakerId": 1521,
            "speakerName": "葛罗丽",
            "text": "信？谁会给我写信…",
            "nextDialogs": [
              "200370305"
            ]
          },
          "200370305": {
            "id": "200370305",
            "speakerId": 1521,
            "speakerName": "葛罗丽",
            "text": "难道是古德温？",
            "nextDialogs": [
              "200370306"
            ]
          },
          "200370306": {
            "id": "200370306",
            "speakerId": 1521,
            "speakerName": "葛罗丽",
            "text": "您遇见他了吗？他还好吧，他说过自己会什么时候回来…",
            "nextDialogs": [
              "200370307"
            ]
          },
          "200370307": {
            "id": "200370307",
            "speakerId": 1521,
            "speakerName": "葛罗丽",
            "text": "抱歉，他现在一定很忙，请您忘了我刚说的话吧，不要再给他压力了。",
            "nextDialogs": [
              "200370308"
            ]
          },
          "200370308": {
            "id": "200370308",
            "speakerId": 1521,
            "speakerName": "葛罗丽",
            "text": "能请您现在就帮我念念这封信吗？",
            "nextDialogs": [
              "200370309"
            ]
          },
          "200370309": {
            "id": "200370309",
            "speakerId": 1521,
            "speakerName": "葛罗丽",
            "text": "请小声一点，我们两个人听得到就好啦…",
            "nextDialogs": [
              "200370310"
            ]
          },
          "200370310": {
            "id": "200370310",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "好的。",
            "nextDialogs": [
              "200370311"
            ]
          },
          "200370311": {
            "id": "200370311",
            "speakerId": 1521,
            "speakerName": "葛罗丽",
            "text": "您念得真不错…难道，您经常给人念信吗？",
            "nextDialogs": [
              "200370312"
            ]
          },
          "200370312": {
            "id": "200370312",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "信就写到这里了。",
            "nextDialogs": [
              "200370313"
            ]
          },
          "200370313": {
            "id": "200370313",
            "speakerId": 1521,
            "speakerName": "葛罗丽",
            "text": "璃月港…古德温真的去了很远的地方啊。",
            "nextDialogs": [
              "200370314"
            ]
          },
          "200370314": {
            "id": "200370314",
            "speakerId": 1521,
            "speakerName": "葛罗丽",
            "text": "谢谢你，我会珍藏这封信的，再见到<color=#00E1FFFF>古德温</color>的时候，记得替我向他问声好。"
          }
        }
      }
    },
    {
      "subId": "2003706",
      "subQuestName": "向古德温回报",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "200370501"
        ],
        "dialogs": {
          "200370501": {
            "id": "200370501",
            "speakerId": 1553,
            "speakerName": "古德温",
            "text": "信送到了吗？",
            "nextDialogs": [
              "200370502"
            ]
          },
          "200370502": {
            "id": "200370502",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "葛罗丽向你问好。",
            "nextDialogs": [
              "200370503"
            ]
          },
          "200370503": {
            "id": "200370503",
            "speakerId": 1553,
            "speakerName": "古德温",
            "text": "呼…我这么久没联系她，还好她没生气。",
            "nextDialogs": [
              "200370504"
            ]
          },
          "200370504": {
            "id": "200370504",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "你一直在蒙德周围，为什么会知道璃月港的事？",
            "nextDialogs": [
              "200370505"
            ]
          },
          "200370505": {
            "id": "200370505",
            "speakerId": 1553,
            "speakerName": "古德温",
            "text": "那个啊，呃…这些故事我都是听大团长说的，他去过很多地方。",
            "nextDialogs": [
              "200370506"
            ]
          },
          "200370506": {
            "id": "200370506",
            "speakerId": 1553,
            "speakerName": "古德温",
            "text": "好了，谢谢你，帮了我这么大的忙。",
            "nextDialogs": [
              "200370507"
            ]
          },
          "200370507": {
            "id": "200370507",
            "speakerId": 1553,
            "speakerName": "古德温",
            "text": "这些蒲公英籽给你们，都是我采的…",
            "nextDialogs": [
              "200370508"
            ]
          },
          "200370508": {
            "id": "200370508",
            "speakerId": 1553,
            "speakerName": "古德温",
            "text": "下次葛罗丽还想搜集蒲公英的话，请你们继续照顾她吧，麻烦你们了。"
          }
        }
      }
    },
    {
      "subId": "2003702",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "200370201"
        ],
        "dialogs": {
          "200370201": {
            "id": "200370201",
            "speakerId": 1553,
            "speakerName": "古德温",
            "text": "信就拜托你了。唉，我真想回蒙德城去见见葛罗丽，但是…"
          }
        }
      }
    },
    {
      "subId": "2003704",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "200370401"
        ],
        "dialogs": {
          "200370401": {
            "id": "200370401",
            "speakerId": 1521,
            "speakerName": "葛罗丽",
            "text": "怎么？您还有什么事没告诉我吗？"
          }
        }
      }
    }
  ]
}
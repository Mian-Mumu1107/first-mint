{
  "lineCounts": {
    "Player": 9,
    "古德温": 26,
    "派蒙": 5,
    "葛罗丽": 12
  },
  "subQuests": [
    {
      "subId": "2003701",
      "subQuestName": "古德温先生好像有烦恼",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "200370101"
        ],
        "dialogs": {
          "200370101": {
            "id": "200370101",
            "speakerId": 1553,
            "speakerName": "古德温",
            "text": "…唉，真想直接回蒙德城算了…",
            "nextDialogs": [
              "200370102"
            ]
          },
          "200370102": {
            "id": "200370102",
            "speakerId": 1553,
            "speakerName": "古德温",
            "text": "呃，旅行者！那个，你能帮我个忙吗？",
            "nextDialogs": [
              "200370103"
            ]
          },
          "200370103": {
            "id": "200370103",
            "speakerId": 1553,
            "speakerName": "古德温",
            "text": "如你所见，我是一名西风骑士，正在野外执行巡逻任务。",
            "nextDialogs": [
              "200370104"
            ]
          },
          "200370104": {
            "id": "200370104",
            "speakerId": 1553,
            "speakerName": "古德温",
            "text": "我和我的女朋友说好，隔段时间就会寄封信给她报平安。",
            "nextDialogs": [
              "200370105"
            ]
          },
          "200370105": {
            "id": "200370105",
            "speakerId": 1553,
            "speakerName": "古德温",
            "text": "结果我居然忙到忘记了，哈哈哈…请你把这封<color=#00E1FFFF>信</color>帮我送给她吧，她叫<color=#00E1FFFF>葛罗丽</color>…",
            "nextDialogs": [
              "200370106"
            ]
          },
          "200370106": {
            "id": "200370106",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "等等，葛罗丽？",
            "nextDialogs": [
              "200370107"
            ]
          },
          "200370107": {
            "id": "200370107",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "那位盲眼的…收集蒲公英的…",
            "nextDialogs": [
              "200370108"
            ]
          },
          "200370108": {
            "id": "200370108",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "喂！葛罗丽小姐说的古德温，原来就是你吗？！",
            "nextDialogs": [
              "200370109"
            ]
          },
          "200370109": {
            "id": "200370109",
            "speakerId": 1553,
            "speakerName": "古德温",
            "text": "咦，为什么你们会认识葛罗丽？",
            "nextDialogs": [
              "200370110"
            ]
          },
          "200370110": {
            "id": "200370110",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "我们帮过她的忙。",
            "nextDialogs": [
              "200370111"
            ]
          },
          "200370111": {
            "id": "200370111",
            "speakerId": 1553,
            "speakerName": "古德温",
            "text": "她、她找你们帮忙？是要做什么危险的事吗？你们…",
            "nextDialogs": [
              "200370112"
            ]
          },
          "200370112": {
            "id": "200370112",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "葛罗丽小姐只是拜托我们帮她搜集蒲公英啦。说是撒在空中的话，可以把心愿传达给你。",
            "nextDialogs": [
              "200370113"
            ]
          },
          "200370113": {
            "id": "200370113",
            "speakerId": 1553,
            "speakerName": "古德温",
            "text": "啊，蒲公英…确实像是葛罗丽会做的事。",
            "nextDialogs": [
              "200370114"
            ]
          },
          "200370114": {
            "id": "200370114",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "你不是离开蒙德城很久了吗？",
            "nextDialogs": [
              "200370115"
            ]
          },
          "200370115": {
            "id": "200370115",
            "speakerId": 1553,
            "speakerName": "古德温",
            "text": "本来应该是这样。算了…我就说了吧。",
            "nextDialogs": [
              "200370116"
            ]
          },
          "200370116": {
            "id": "200370116",
            "speakerId": 1553,
            "speakerName": "古德温",
            "text": "你有没有听说，大团长把五分之四骑士带出蒙德的事？",
            "nextDialogs": [
              "200370117"
            ]
          },
          "200370117": {
            "id": "200370117",
            "speakerId": 1553,
            "speakerName": "古德温",
            "text": "是的，我也是骑士团远征队的一员…但在出征之前，我因为弄丢了葛罗丽的信物，想要寻找，却掉了队…",
            "nextDialogs": [
              "200370118"
            ]
          },
          "200370118": {
            "id": "200370118",
            "speakerId": 1553,
            "speakerName": "古德温",
            "text": "到现在也没找到归队的方法，只能一直在这附近转悠…",
            "nextDialogs": [
              "200370119"
            ]
          },
          "200370119": {
            "id": "200370119",
            "speakerId": 1553,
            "speakerName": "古德温",
            "text": "我也不好意思回蒙德城，就这么灰溜溜地回去，西风骑士们都会怎么看我啊！",
            "nextDialogs": [
              "200370120"
            ]
          },
          "200370120": {
            "id": "200370120",
            "speakerId": 1553,
            "speakerName": "古德温",
            "text": "还有葛罗丽，我答应她，会在世界各地给她寄信和礼物，把「全世界」都带给她。",
            "nextDialogs": [
              "200370121"
            ]
          },
          "200370121": {
            "id": "200370121",
            "speakerId": 1553,
            "speakerName": "古德温",
            "text": "要是她知道我连蒙德都没走出去…的…话…",
            "nextDialogs": [
              "200370122"
            ]
          },
          "200370122": {
            "id": "200370122",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "原来是面子问题呀",
            "nextDialogs": [
              "200370123"
            ]
          },
          "200370123": {
            "id": "200370123",
            "speakerId": 1553,
            "speakerName": "古德温",
            "text": "拜托了，你能帮我把这封<color=#00E1FFFF>信</color>送给<color=#00E1FFFF>葛罗丽</color>吗？说不定，她还在为我担心…",
            "nextDialogs": [
              "200370125",
              "200370127"
            ]
          },
          "200370125": {
            "id": "200370125",
            "speakerId": 1553,
            "speakerName": "古德温",
            "text": "那就拜托你了，旅行者，千万帮我保密啊！"
          },
          "200370127": {
            "id": "200370127",
            "speakerId": 1553,
            "speakerName": "古德温",
            "text": "我想对葛罗丽说的话太多了，蒲公英怎么可能载得动嘛。",
            "nextDialogs": [
              "200370128"
            ]
          },
          "200370128": {
            "id": "200370128",
            "speakerId": 1553,
            "speakerName": "古德温",
            "text": "信就拜托你了，千万帮我保密！"
          }
        }
      }
    },
    {
      "subId": "2003702",
      "subQuestName": "和古德温对话",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [],

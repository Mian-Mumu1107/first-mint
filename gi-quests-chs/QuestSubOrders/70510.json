  "subQuests": [
    {
      "subId": "7051001",
      "subQuestName": "与卢卡对话",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "705100401"
        ],
        "dialogs": {
          "705100401": {
            "id": "705100401",
            "speakerId": 30112,
            "speakerName": "卢卡",
            "text": "哎呀呀…这几天，酒馆里的人可以说是络绎不绝啊。",
            "nextDialogs": [
              "705100402"
            ]
          },
          "705100402": {
            "id": "705100402",
            "speakerId": 30112,
            "speakerName": "卢卡",
            "text": "有冲着酒来的，更多的还是冲着你来的。",
            "nextDialogs": [
              "705100403"
            ]
          },
          "705100403": {
            "id": "705100403",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "这话…听着怎么那么奇怪。",
            "nextDialogs": [
              "705100404"
            ]
          },
          "705100404": {
            "id": "705100404",
            "speakerId": 30112,
            "speakerName": "卢卡",
            "text": "我还没见过那么成功的「酒保体验周」活动，这下生意和口碑都有了。",
            "nextDialogs": [
              "705100405"
            ]
          },
          "705100405": {
            "id": "705100405",
            "speakerId": 30112,
            "speakerName": "卢卡",
            "text": "总之…干得漂亮，伙计。",
            "nextDialogs": [
              "705100406"
            ]
          },
          "705100406": {
            "id": "705100406",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "才几天，怎么就变成伙计了啦！",
            "nextDialogs": [
              "705100409"
            ]
          },
          "705100409": {
            "id": "705100409",
            "speakerId": 30112,
            "speakerName": "卢卡",
            "text": "我说，要不要留下来接着干？",
            "nextDialogs": [
              "705100410"
            ]
          },
          "705100410": {
            "id": "705100410",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "#这可不行。虽然无限畅饮的诱惑力很大，但我可是答应过，要陪{M#他}{F#她}一直旅行下去的。",
            "nextDialogs": [
              "705100411"
            ]
          },
          "705100411": {
            "id": "705100411",
            "speakerId": 30112,
            "speakerName": "卢卡",
            "text": "好吧，那就不勉强啦，毕竟查尔斯也跟我说过这一点…",
            "nextDialogs": [
              "705100412"
            ]
          },
          "705100412": {
            "id": "705100412",
            "speakerId": 30112,
            "speakerName": "卢卡",
            "text": "总之，有机会的话，常来「天使的馈赠」坐坐，带上朋友一起！",
            "nextDialogs": [
              "705100413"
            ]
          },
          "705100413": {
            "id": "705100413",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "没问题。",
            "nextDialogs": [
              "705100414"
            ]
          },
          "705100414": {
            "id": "705100414",
            "speakerId": 30112,
            "speakerName": "卢卡",
            "text": "再见啦，祝你们一路顺利。"
          }
        }
      }
    },

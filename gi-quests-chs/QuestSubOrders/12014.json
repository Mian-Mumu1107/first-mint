  "subQuests": [
    {
      "subId": "1201401",
      "subQuestName": "",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "120140101"
        ],
        "dialogs": {
          "120140101": {
            "id": "120140101",
            "speakerId": 1035,
            "speakerName": "宵宫",
            "text": "我打算再待一会儿，我心中的烟花会还没有结束呢。",
            "nextDialogs": [
              "120140102"
            ]
          },
          "120140102": {
            "id": "120140102",
            "speakerId": 1035,
            "speakerName": "宵宫",
            "text": "啊，不过如果想聊天的话，也没问题哦。",
            "nextDialogs": [
              "120140104",
              "120140109",
              "120140116"
            ]
          },
          "120140104": {
            "id": "120140104",
            "speakerId": 1035,
            "speakerName": "宵宫",
            "text": "松坂他们还在等我和他们一起去找「大貉妖」呢，宵宫姐姐可不能言而无信。",
            "nextDialogs": [
              "120140105"
            ]
          },
          "120140105": {
            "id": "120140105",
            "speakerId": 1035,
            "speakerName": "宵宫",
            "text": "还有各家各户放完烟花之后的感想，我也要去了解。",
            "nextDialogs": [
              "120140106"
            ]
          },
          "120140106": {
            "id": "120140106",
            "speakerId": 1035,
            "speakerName": "宵宫",
            "text": "接下来的日子，还要承蒙大家关照。",
            "nextDialogs": [
              "120140107"
            ]
          },
          "120140107": {
            "id": "120140107",
            "speakerId": 1035,
            "speakerName": "宵宫",
            "text": "你和派蒙的关照当然也少不了啦。"
          },
          "120140109": {
            "id": "120140109",
            "speakerId": 1035,
            "speakerName": "宵宫",
            "text": "你们的话…",
            "nextDialogs": [
              "120140110"
            ]
          },
          "120140110": {
            "id": "120140110",
            "speakerId": 1035,
            "speakerName": "宵宫",
            "text": "免费吧！",
            "nextDialogs": [
              "120140111"
            ]
          },
          "120140111": {
            "id": "120140111",
            "speakerId": 1035,
            "speakerName": "宵宫",
            "text": "毕竟是我硬要送给你们的，一路上还给你们添了很多麻烦，嘿嘿，再收费我会不好意思的。",
            "nextDialogs": [
              "120140112"
            ]
          },
          "120140112": {
            "id": "120140112",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "那有点过意不去。",
            "nextDialogs": [
              "120140113"
            ]
          },
          "120140113": {
            "id": "120140113",
            "speakerId": 1035,
            "speakerName": "宵宫",
            "text": "#别在意，不用这么客气。那这样吧，作为交换，等你找到了亲人，你要把「长野原烟花店」介绍给{PLAYERAVATAR#SEXPRO[INFO_MALE_PRONOUN_SHE|INFO_MALE_PRONOUN_HE]}，这样我又能多一个客人了。",
            "nextDialogs": [
              "120140114"
            ]
          },
          "120140114": {
            "id": "120140114",
            "speakerId": 1035,
            "speakerName": "宵宫",
            "text": "#我也想见{PLAYERAVATAR#SEXPRO[INFO_MALE_PRONOUN_SHE|INFO_MALE_PRONOUN_HE]}一面啊。"
          },
          "120140116": {
            "id": "120140116",
            "speakerId": 1035,
            "speakerName": "宵宫",
            "text": "那就再打一顿！",
            "nextDialogs": [
              "120140117"
            ]
          },
          "120140117": {
            "id": "120140117",
            "speakerId": 1035,
            "speakerName": "宵宫",
            "text": "——哈哈哈，开玩笑，开玩笑啦。我不是说了，我家经常会和奉行众打交道。",
            "nextDialogs": [
              "120140118"
            ]
          },
          "120140118": {
            "id": "120140118",
            "speakerId": 1035,
            "speakerName": "宵宫",
            "text": "无非是认错，赔笑脸，交些罚款，要混过去很容易。",
            "nextDialogs": [
              "120140119"
            ]
          },
          "120140119": {
            "id": "120140119",
            "speakerId": 1035,
            "speakerName": "宵宫",
            "text": "倒是你们要更小心一点，遇到事情，可不要像我一样鲁莽，嘿嘿。"
          }
        }
      }
    }
  ]
}
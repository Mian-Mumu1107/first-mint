{
  "lineCounts": {
    "Player": 6,
    "勒拉": 7,
    "欧洛伦": 22,
    "派蒙": 16,
    "茜特菈莉": 45,
    "谷中": 5
  },
  "subQuests": [
    {
      "subId": "4017201",
      "subQuestName": "等待至第二天（7点-11点）",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "401720101"
        ],
        "dialogs": {
          "401720101": {
            "id": "401720101",
            "speakerId": 1000,
            "speakerName": "茜特菈莉",
            "text": "嗨！各位。",
            "nextDialogs": [
              "401720102"
            ]
          },
          "401720102": {
            "id": "401720102",
            "speakerId": 1001,
            "speakerName": "欧洛伦",
            "text": "奶奶，你来了。",
            "nextDialogs": [
              "401720103"
            ]
          },
          "401720103": {
            "id": "401720103",
            "speakerId": 1000,
            "speakerName": "茜特菈莉",
            "text": "你这里没有好消息吧？",
            "nextDialogs": [
              "401720104"
            ]
          },
          "401720104": {
            "id": "401720104",
            "speakerId": 1001,
            "speakerName": "欧洛伦",
            "text": "#一眼就被奶奶看出来了啊。{NICKNAME}收集了很多游灵，我一一分辨了，都没有勒拉的特征。",
            "nextDialogs": [
              "401720105"
            ]
          },
          "401720105": {
            "id": "401720105",
            "speakerId": 1000,
            "speakerName": "茜特菈莉",
            "text": "看你的样子就知道了。没关系，大海捞针本来就是很难的。",
            "nextDialogs": [
              "401720106"
            ]
          },
          "401720106": {
            "id": "401720106",
            "speakerId": 1001,
            "speakerName": "欧洛伦",
            "text": "虽然勒拉的情况还比较稳定，可这样下去也不是办法。",
            "nextDialogs": [
              "401720107"
            ]
          },
          "401720107": {
            "id": "401720107",
            "speakerId": 1000,
            "speakerName": "茜特菈莉",
            "text": "我倒是有些进展，勒拉的父母告诉我，勒拉前阵子认识了一个朋友，经常一出门就好几天不回来。",
            "nextDialogs": [
              "401720108"
            ]
          },
          "401720108": {
            "id": "401720108",
            "speakerId": 1000,
            "speakerName": "茜特菈莉",
            "text": "他们有次悄悄跟了过去，发现勒拉和那个朋友在一个营地里鼓捣什么。",
            "nextDialogs": [
              "401720109"
            ]
          },
          "401720109": {
            "id": "401720109",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "他们见到了那个人？",
            "nextDialogs": [
              "401720110"
            ]
          },
          "401720110": {
            "id": "401720110",
            "speakerId": 1000,
            "speakerName": "茜特菈莉",
            "text": "嗯，是个男人，名叫谷中，穿着似乎是稻妻的款式。",
            "nextDialogs": [
              "401720111"
            ]
          },
          "401720111": {
            "id": "401720111",
            "speakerId": 1002,
            "speakerName": "勒拉",
            "text": "谷中先生，用这个就可以了吗？",
            "nextDialogs": [
              "401720112"
            ]
          },
          "401720112": {
            "id": "401720112",
            "speakerId": 1003,
            "speakerName": "谷中",
            "text": "据我从古籍里学习的知识，大多数过敏的症状会使用相应的脱敏疗法，我想反过来也一样。",
            "nextDialogs": [
              "401720113"
            ]
          },
          "401720113": {
            "id": "401720113",
            "speakerId": 1003,
            "speakerName": "谷中",
            "text": "您是对灵性完全脱敏的可怜人，只能完全将自己浸泡在充满灵性的物质中。这样的方法，我称为过敏疗法…",
            "nextDialogs": [
              "401720114"
            ]
          },
          "401720114": {
            "id": "401720114",
            "speakerId": 1002,
            "speakerName": "勒拉",
            "text": "…会有问题吗？",
            "nextDialogs": [
              "401720115"
            ]
          },
          "401720115": {
            "id": "401720115",
            "speakerId": 1003,
            "speakerName": "谷中",
            "text": "您才是灵性白痴，强行施法会怎么样，您应该比我更清楚。如何决定，还是看您自己了。",
            "nextDialogs": [
              "401720116"
            ]
          },
          "401720116": {
            "id": "401720116",
            "speakerId": 1002,
            "speakerName": "勒拉",
            "text": "好吧…但我还有一个问题，谷中先生为什么要帮助我？",
            "nextDialogs": [
              "401720117"
            ]
          },
          "401720117": {
            "id": "401720117",
            "speakerId": 1002,
            "speakerName": "勒拉",
            "text": "毕竟像我这样的家伙，在族里根本说不上什么话，没有什么能回报的。",
            "nextDialogs": [
              "401720118"
            ]
          },
          "401720118": {
            "id": "401720118",
            "speakerId": 1003,
            "speakerName": "谷中",
            "text": "回报？请您好好看看我的脸吧，看看上面写了什么？",
            "nextDialogs": [
              "401720119"
            ]
          },
          "401720119": {
            "id": "401720119",
            "speakerId": 1002,
            "speakerName": "勒拉",
            "text": "呃，写了什么？",
            "nextDialogs": [
              "401720120"
            ]
          },
          "401720120": {
            "id": "401720120",
            "speakerId": 1003,
            "speakerName": "谷中",
            "text": "「乐于助人」。",
            "nextDialogs": [
              "401720121"
            ]
          },
          "401720121": {
            "id": "401720121",
            "speakerId": 1004,
            "speakerName": "派蒙",
            "text": "呜哇！没想到是个稻妻人，居然还是为了给勒拉治病？",
            "nextDialogs": [
              "401720122"
            ]
          },
          "401720122": {
            "id": "401720122",
            "speakerId": 1001,
            "speakerName": "欧洛伦",
            "text": "过敏疗法，真是天马行空的点子啊，真的有用吗？",
            "nextDialogs": [
              "401720123"
            ]
          },
          "401720123": {
            "id": "401720123",
            "speakerId": 1004,
            "speakerName": "派蒙",
            "text": "看勒拉现在的样子，结果应该是失败了。",
            "nextDialogs": [
              "401720124"
            ]
          },
          "401720124": {
            "id": "401720124",
            "speakerId": 1000,
            "speakerName": "茜特菈莉",
            "text": "哼，很久以前，族内是有过这种办法，但成功率很低，又太过冒险，渐渐就被禁止了。",
            "nextDialogs": [
              "401720125"
            ]
          },
          "401720125": {
            "id": "401720125",
            "speakerId": 1000,
            "speakerName": "茜特菈莉",
            "text": "至于这个谷中的目的，我看也没那么简单，在勒拉出事后，他就消失了。",
            "nextDialogs": [
              "401720126"
            ]
          },
          "401720126": {
            "id": "401720126",
            "speakerId": 1000,
            "speakerName": "茜特菈莉",
            "text": "我按照勒拉父母给的地址去了营地，那有明显的灵性残留，另外，我还发现了这个。",
            "nextDialogs": [
              "401720127"
            ]
          },
          "401720127": {
            "id": "401720127",
            "speakerId": 1001,
            "speakerName": "欧洛伦",
            "text": "这是…？",
            "nextDialogs": [
              "401720128"
            ]
          },
          "401720128": {
            "id": "401720128",
            "speakerId": 1000,
            "speakerName": "茜特菈莉",
            "text": "某种碎片…似乎是武器或者仪具上的。",
            "nextDialogs": [
              "401720129"
            ]
          },
          "401720129": {
            "id": "401720129",
            "speakerId": 1000,
            "speakerName": "茜特菈莉",
            "text": "你也感觉到了吧，虽然看起来上了年份，但上面还是有很强大的灵性残留。",
            "nextDialogs": [
              "401720130"
            ]
          },
          "401720130": {
            "id": "401720130",
            "speakerId": 1000,
            "speakerName": "茜特菈莉",
            "text": "勒拉应该就是用这个东西做的媒介，这能解释他这个灵性白痴是怎么开始的暝视。",
            "nextDialogs": [
              "401720131"
            ]
          },
          "401720131": {
            "id": "401720131",
            "speakerId": 1001,
            "speakerName": "欧洛伦",
            "text": "等等，我还有一种熟悉的感觉，它似乎与我的古名有关系…",
            "nextDialogs": [
              "401720132"
            ]
          },
          "401720132": {
            "id": "401720132",
            "speakerId": 1004,
            "speakerName": "派蒙",
            "text": "欧洛伦的古名？难道这是古名碎片吗？",
            "nextDialogs": [
              "401720133"
            ]
          },
          "401720133": {
            "id": "401720133",
            "speakerId": 1001,
            "speakerName": "欧洛伦",
            "text": "不…我觉得它可能是古名的前主人留下的。",
            "nextDialogs": [
              "401720134"
            ]
          },
          "401720134": {
            "id": "401720134",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "难道是桑哈杰的遗物？",
            "nextDialogs": [
              "401720135"
            ]
          },
          "401720135": {
            "id": "401720135",
            "speakerId": 1000,
            "speakerName": "茜特菈莉",
            "text": "奶奶我开始手痒了，这次的暝视就用这个来做媒介。",
            "nextDialogs": [
              "401720136"
            ]
          },
          "401720136": {
            "id": "401720136",
            "speakerId": 1004,
            "speakerName": "派蒙",
            "text": "#那还是和上次一样吧？让{NICKNAME}用灵性织机把茜特菈莉看到的画面织下来。",
            "nextDialogs": [
              "401720137"
            ]
          },
          "401720137": {
            "id": "401720137",
            "speakerId": 1000,
            "speakerName": "茜特菈莉",
            "text": "不，这次让欧洛伦来。",
            "nextDialogs": [
              "401720138"
            ]
          },
          "401720138": {
            "id": "401720138",
            "speakerId": 1001,
            "speakerName": "欧洛伦",
            "text": "为什么？",
            "nextDialogs": [
              "401720139"
            ]
          },
          "401720139": {
            "id": "401720139",
            "speakerId": 1000,
            "speakerName": "茜特菈莉",
            "text": "这是安全措施。",
            "nextDialogs": [
              "401720140"
            ]
          },
          "401720140": {
            "id": "401720140",
            "speakerId": 1000,
            "speakerName": "茜特菈莉",
            "text": "#你对灵性领域的认知比{NICKNAME}强，如果这是桑哈杰的遗物，万一出现意外状况，你能更好地应对。",
            "nextDialogs": [
              "401720141"
            ]
          },
          "401720141": {
            "id": "401720141",
            "speakerId": 1001,
            "speakerName": "欧洛伦",
            "text": "#噢…看见了吧，派蒙，我说奶奶很关注{NICKNAME}吧，一点都不肯让{M#他}{F#她}冒险。",
            "nextDialogs": [
              "401720142"
            ]
          },
          "401720142": {
            "id": "401720142",
            "speakerId": 1001,
            "speakerName": "欧洛伦",
            "text": "我这样的孙子就无所谓了。",
            "nextDialogs": [
              "401720143"
            ]
          },
          "401720143": {
            "id": "401720143",
            "speakerId": 1000,
            "speakerName": "茜特菈莉",
            "text": "喂！你在说什么啊！",
            "nextDialogs": [
              "401720144"
            ]
          },
          "401720144": {
            "id": "401720144",
            "speakerId": 1001,
            "speakerName": "欧洛伦",
            "text": "不好意思，奶奶，我准备好了。",
            "nextDialogs": [
              "401720145"
            ]
          },
          "401720145": {
            "id": "401720145",
            "speakerId": 1000,
            "speakerName": "茜特菈莉",
            "text": "那我们就开始吧。",
            "nextDialogs": [
              "401720149"
            ]
          },
          "401720149": {
            "id": "401720149",
            "speakerId": 1004,
            "speakerName": "派蒙",
            "text": "出来了！这次的织物…好像是一张碎掉的弓，在火焰里燃烧着…",
            "nextDialogs": [
              "401720150"
            ]
          },
          "401720150": {
            "id": "401720150",
            "speakerId": 1001,
            "speakerName": "欧洛伦",
            "text": "你们看，其中一块是不是和这个碎片有点像啊？",
            "nextDialogs": [
              "401720151"
            ]
          },
          "401720151": {
            "id": "401720151",
            "speakerId": 1004,
            "speakerName": "派蒙",
            "text": "真的！好像是弓身的位置…",
            "nextDialogs": [
              "401720152"
            ]
          },
          "401720152": {
            "id": "401720152",
            "speakerId": 1001,
            "speakerName": "欧洛伦",
            "text": "我在奶奶家里的织卷上看到过跟这把弓很像的东西…",
            "nextDialogs": [
              "401720153"
            ]
          },
          "401720153": {
            "id": "401720153",
            "speakerId": 1000,
            "speakerName": "茜特菈莉",
            "text": "…没错，它是桑哈杰征战烬寂海时使用的武器。看来这块碎片，是货真价实的桑哈杰遗物。",
            "nextDialogs": [
              "401720154"
            ]
          },
          "401720154": {
            "id": "401720154",
            "speakerId": 1001,
            "speakerName": "欧洛伦",
            "text": "#不愧是桑哈杰前辈，虽然遗物的灵性波动很强，但刚才并没有什么危险，如果是{NICKNAME}来的话，应该也没问题。",
            "nextDialogs": [
              "401720155"
            ]
          },
          "401720155": {
            "id": "401720155",
            "speakerId": 1004,
            "speakerName": "派蒙",
            "text": "果然这就是英雄！留下来的东西都可以拿给后人治疗。",
            "nextDialogs": [
              "401720156"
            ]
          },
          "401720156": {
            "id": "401720156",
            "speakerId": 1000,
            "speakerName": "茜特菈莉",
            "text": "仅仅是治疗吗？我总觉得，那个谷中还别有目的。",
            "nextDialogs": [
              "401720157"
            ]
          },
          "401720157": {
            "id": "401720157",
            "speakerId": 1004,
            "speakerName": "派蒙",
            "text": "让我想想，刚刚我们看见了完整的弓的样子…难道是…他想找到其他碎片的下落？",
            "nextDialogs": [
              "401720158"
            ]
          },
          "401720158": {
            "id": "401720158",
            "speakerId": 1001,
            "speakerName": "欧洛伦",
            "text": "虽说是桑哈杰前辈的东西，但既然都已经碎掉了，就算找齐了也派不上什么用场了吧。",
            "nextDialogs": [
              "401720159"
            ]
          },
          "401720159": {
            "id": "401720159",
            "speakerId": 1000,
            "speakerName": "茜特菈莉",
            "text": "而且为什么要找一个灵性白痴来做这件事？这只会什么也得不到。",
            "nextDialogs": [
              "401720160"
            ]
          },
          "401720160": {
            "id": "401720160",
            "speakerId": 1002,
            "speakerName": "勒拉",
            "text": "……",
            "nextDialogs": [
              "401720161"
            ]
          },
          "401720161": {
            "id": "401720161",
            "speakerId": 1004,
            "speakerName": "派蒙",
            "text": "欸？勒拉的身体好像有反应了！",
            "nextDialogs": [
              "401720162"
            ]
          },
          "401720162": {
            "id": "401720162",
            "speakerId": 1000,
            "speakerName": "茜特菈莉",
            "text": "让我看看。我感觉到有灵性在向碎片附着…",
            "nextDialogs": [
              "401720163"
            ]
          },
          "401720163": {
            "id": "401720163",
            "speakerId": 1001,
            "speakerName": "欧洛伦",
            "text": "那就是说，奶奶的方向是正确的。勒拉的游离灵性正在被吸引过来。",
            "nextDialogs": [
              "401720164"
            ]
          },
          "401720164": {
            "id": "401720164",
            "speakerId": 1000,
            "speakerName": "茜特菈莉",
            "text": "既然如此，我要再试一次，用勒拉的身体与这块碎片一起当作媒介。",
            "nextDialogs": [
              "401720165"
            ]
          },
          "401720165": {
            "id": "401720165",
            "speakerId": 1001,
            "speakerName": "欧洛伦",
            "text": "加油，奶奶。我也会加油的。",
            "nextDialogs": [
              "401720166"
            ]
          },
          "401720166": {
            "id": "401720166",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "这次让我来操纵灵性织机吧。",
            "nextDialogs": [
              "401720167"
            ]
          },
          "401720167": {
            "id": "401720167",
            "speakerId": 1000,
            "speakerName": "茜特菈莉",
            "text": "你也手痒了吗？",
            "nextDialogs": [
              "401720168"
            ]
          },
          "401720168": {
            "id": "401720168",
            "speakerId": 1004,
            "speakerName": "派蒙",
            "text": "一人一次，这样比较公平嘛。",
            "nextDialogs": [
              "401720169"
            ]
          },
          "401720169": {
            "id": "401720169",
            "speakerId": 1001,
            "speakerName": "欧洛伦",
            "text": "安全性我也确认过了，应该不会有危险。",
            "nextDialogs": [
              "401720170"
            ]
          },
          "401720170": {
            "id": "401720170",
            "speakerId": 1000,
            "speakerName": "茜特菈莉",
            "text": "嗯…",
            "nextDialogs": [
              "401720171"
            ]
          },
          "401720171": {
            "id": "401720171",
            "speakerId": 1000,
            "speakerName": "茜特菈莉",
            "text": "#好，既然{NICKNAME}有这个想法，就这么来吧。准备好了就告诉我一声。"
          }
        }
      }
    },
    {

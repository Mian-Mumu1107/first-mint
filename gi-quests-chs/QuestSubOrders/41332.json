        "dialogs": {
          "413321601": {
            "id": "413321601",
            "speakerId": 1001,
            "speakerName": "卯师傅",
            "text": "这霄灯，看着真好。哎呀…我等会就把愿望写上，等那丫头回来了之后，我们父女俩一起把霄灯放了。",
            "nextDialogs": [
              "413321602"
            ]
          },
          "413321602": {
            "id": "413321602",
            "speakerId": 1001,
            "speakerName": "卯师傅",
            "text": "谢谢你旅行者，这些东西请收下，就当做是谢礼了。"
          }
        }
      }
    },
    {
      "subId": "4133205",

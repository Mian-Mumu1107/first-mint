    {
      "subId": "4133202",
      "subQuestName": "与卯师傅对话",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "413320201"
        ],
        "dialogs": {
          "413320201": {
            "id": "413320201",
            "speakerId": 1001,
            "speakerName": "卯师傅",
            "text": "还有几份来着…",
            "nextDialogs": [
              "413320202"
            ]
          },
          "413320202": {
            "id": "413320202",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "在忙些什么？",
            "nextDialogs": [
              "413320203"
            ]
          },
          "413320203": {
            "id": "413320203",
            "speakerId": 1001,
            "speakerName": "卯师傅",
            "text": "哈哈，我还能忙些什么，当然是「万民堂」的生意嘛。",
            "nextDialogs": [
              "413320204"
            ]
          },
          "413320204": {
            "id": "413320204",
            "speakerId": 1001,
            "speakerName": "卯师傅",
            "text": "最近赶上海灯节，出来下馆子的人特别多，还有不少凑热闹的外国游客。",
            "nextDialogs": [
              "413320205"
            ]
          },
          "413320205": {
            "id": "413320205",
            "speakerId": 1001,
            "speakerName": "卯师傅",
            "text": "虽然我闺女香菱也回来帮忙了，但她也是忙得脚后跟不沾地，这不，刚刚出去送菜去了…",
            "nextDialogs": [
              "413320206"
            ]
          },
          "413320206": {
            "id": "413320206",
            "speakerId": 1001,
            "speakerName": "卯师傅",
            "text": "别人家早挂上霄灯过节去了，咱家「万民堂」可是忙得连霄灯都没空编啊。",
            "nextDialogs": [
              "413320207"
            ]
          },
          "413320207": {
            "id": "413320207",
            "speakerId": 1001,
            "speakerName": "卯师傅",
            "text": "对了旅行者，如果你愿意的话，能帮我个忙吗？",
            "nextDialogs": [
              "413320208"
            ]
          },
          "413320208": {
            "id": "413320208",
            "speakerId": 1001,
            "speakerName": "卯师傅",
            "text": "你认识竺子吧？就是那个在码头上的小姑娘，从稻妻来的那个。",
            "nextDialogs": [
              "413320209"
            ]
          },
          "413320209": {
            "id": "413320209",
            "speakerId": 1001,
            "speakerName": "卯师傅",
            "text": "她在我们这里订了份吃的，请你帮我送过去吧，大过节的，我特意给她做的分量大了些。",
            "nextDialogs": [
              "413320210"
            ]
          },
          "413320210": {
            "id": "413320210",
            "speakerId": 1001,
            "speakerName": "卯师傅",
            "text": "还有总是在码头上忙的那几位，<color=#00E1FFFF>王扳子、李锤子、观海、志华…</color>",
            "nextDialogs": [
              "413320211"
            ]
          },
          "413320211": {
            "id": "413320211",
            "speakerId": 1001,
            "speakerName": "卯师傅",
            "text": "这几位总是照顾我们店的生意，这大过节的他们也还在码头上，估计也是因为工作吧。",
            "nextDialogs": [
              "413320212"
            ]
          },
          "413320212": {
            "id": "413320212",
            "speakerId": 1001,
            "speakerName": "卯师傅",
            "text": "我也想给他们几位都准备点好吃的，也算是过个节。但我这店里太忙了，实在是抽不开身…",
            "nextDialogs": [
              "413320213"
            ]
          },
          "413320213": {
            "id": "413320213",
            "speakerId": 1001,
            "speakerName": "卯师傅",
            "text": "旅行者，你就顺便帮我去问问他们最想吃什么吧，我好给他们准备菜。",
            "nextDialogs": [
              "413320214"
            ]
          },
          "413320214": {
            "id": "413320214",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "交给我吧。",
            "nextDialogs": [
              "413320215"
            ]
          },
          "413320215": {
            "id": "413320215",
            "speakerId": 1001,
            "speakerName": "卯师傅",
            "text": "那就拜托你了，问到了之后就赶紧回来告诉我吧。"
          }
        }
      }
    },
    {
      "subId": "4133203",
      "subQuestName": "把食物送给竺子",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "413320301"
        ],
        "dialogs": {
          "413320301": {
            "id": "413320301",
            "speakerId": 1000,
            "speakerName": "竺子",
            "text": "「万民堂」的餐怎么还没送来…",
            "nextDialogs": [
              "413320302"
            ]
          },
          "413320302": {
            "id": "413320302",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "你的餐到了。",
            "nextDialogs": [
              "413320303"
            ]
          },
          "413320303": {
            "id": "413320303",
            "speakerId": 1000,
            "speakerName": "竺子",
            "text": "啊！谢谢你，我还以为再过一会才能送到呢。",
            "nextDialogs": [
              "413320304"
            ]
          },
          "413320304": {
            "id": "413320304",
            "speakerId": 1000,
            "speakerName": "竺子",
            "text": "璃月这个海灯节的氛围，我都有点想家了，但是…稻妻我应该暂时回不去了吧…",
            "nextDialogs": [
              "413320305"
            ]
          },
          "413320305": {
            "id": "413320305",
            "speakerId": 1000,
            "speakerName": "竺子",
            "text": "不知道，稻妻那边现在是什么情况…"
          }
        }
      }
    },
    {
      "subId": "4133204",

    },
    {
      "subId": "4133210",
      "subQuestName": "询问大家的口味（0/3）",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "413320651"
        ],
        "dialogs": {
          "413320651": {
            "id": "413320651",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "我推荐<color=#00E1FFFF>松鼠鱼</color>。",
            "nextDialogs": [
              "413320652"
            ]
          },
          "413320652": {
            "id": "413320652",
            "speakerId": 1003,
            "speakerName": "观海",
            "text": "哦，对对对，我怎么没想到松鼠鱼呢。",
            "nextDialogs": [
              "413320653"
            ]
          },
          "413320653": {
            "id": "413320653",
            "speakerId": 1003,
            "speakerName": "观海",
            "text": "酸甜酥脆，想着就觉得饿了，我等着品品卯师傅的手艺了。"
          }
        }
      }
    },
    {
      "subId": "4133211",
      "subQuestName": "(test)玩家选错北地苹果焖肉$HIDDEN",
      "sceneId": null,

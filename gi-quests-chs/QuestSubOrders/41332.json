    {
      "subId": "4133212",
      "subQuestName": "(test)玩家选错香嫩椒椒鸡$HIDDEN",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "413320721"
        ],
        "dialogs": {
          "413320721": {
            "id": "413320721",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "我推荐<color=#00E1FFFF>烤吃虎鱼</color>。",
            "nextDialogs": [
              "413320722"
            ]
          },
          "413320722": {
            "id": "413320722",
            "speakerId": 1004,
            "speakerName": "志华",
            "text": "这道菜好吃是好吃，但就是味道有点太重了，吃完之后身上总是有一股散不去的烤吃虎鱼味…"
          }
        }
      }

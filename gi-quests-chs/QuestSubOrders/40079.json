    {
      "subId": "4007951",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "400795101"
        ],
        "dialogs": {
          "400795101": {
            "id": "400795101",
            "speakerId": 1001,
            "speakerName": "雷泽",
            "text": "心里，像坏掉的树莓，酸酸的。",
            "nextDialogs": [
              "400795102"
            ]
          },
          "400795102": {
            "id": "400795102",
            "speakerId": 1001,
            "speakerName": "雷泽",
            "text": "我不太明白，该做的事…",
            "nextDialogs": [
              "400795103"
            ]
          },
          "400795103": {
            "id": "400795103",
            "speakerId": 1003,
            "speakerName": "丽莎",
            "text": "嗯，我会教你神奇的「困扰归零术」。",
            "nextDialogs": [
              "400795104"
            ]
          },
          "400795104": {
            "id": "400795104",
            "speakerId": 1003,
            "speakerName": "丽莎",
            "text": "但在此之前，先从简单的、雷泽做得到的事做起如何？我们来练习说话吧。",
            "nextDialogs": [
              "400795105"
            ]
          },
          "400795105": {
            "id": "400795105",
            "speakerId": 1003,
            "speakerName": "丽莎",
            "text": "无论下次你是接受了别人的帮助，还是对大家的观点抱有不同意见，都可以通过精确的表达来传达你的想法。",
            "nextDialogs": [
              "400795106"
            ]
          },
          "400795106": {
            "id": "400795106",
            "speakerId": 1001,
            "speakerName": "雷泽",
            "text": "好！",
            "nextDialogs": [
              "400795107"
            ]
          },
          "400795107": {
            "id": "400795107",
            "speakerId": 1001,
            "speakerName": "雷泽",
            "text": "我，会努力。"
          }
        }
      }
    },
    {

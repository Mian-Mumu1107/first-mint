    {
      "subId": "4007902",
      "subQuestName": "与雷泽会合",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "400790201"
        ],
        "dialogs": {
          "400790201": {
            "id": "400790201",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "欸，怎么连一根雷泽毛都看不到，他还没来吗？",
            "nextDialogs": [
              "400790202"
            ]
          },
          "400790202": {
            "id": "400790202",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "难道是之前太辛苦，他回去之后就呼呼大睡…睡过头了！",
            "nextDialogs": [
              "400790205"
            ]
          },
          "400790205": {
            "id": "400790205",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "好吧，你说得对…那我们多等一下。",
            "nextDialogs": [
              "400790206"
            ]
          },
          "400790206": {
            "id": "400790206",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "趁这个时间，我们先交流交流吧！卖唱的提到的酿酒原料，听着都很抽象…",
            "nextDialogs": [
              "400790207"
            ]
          },
          "400790207": {
            "id": "400790207",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "「探索的勇气，慈爱的温柔，守护的执着，千风…祝颂…」",
            "nextDialogs": [
              "400790208"
            ]
          },
          "400790208": {
            "id": "400790208",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "你有什么头绪吗？"
          }
        }
      }
    },
    {
      "subId": "4007903",
      "subQuestName": "在野外搜寻迟到的货车",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "400790301"
        ],
        "dialogs": {
          "400790301": {
            "id": "400790301",
            "speakerId": 1001,
            "speakerName": "雷泽",
            "text": "味道，在这边。",
            "nextDialogs": [
              "400790302"
            ]
          },
          "400790302": {
            "id": "400790302",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "哦！看见货车了，怎么还有丘丘人！哇，难道它们是被水果的香味吸引来的？",
            "nextDialogs": [
              "400790303"
            ]
          },
          "400790303": {
            "id": "400790303",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "#上吧，{NICKNAME}，救人要紧！"
          }
        }
      }
    },
    {
      "subId": "4007904",
      "subQuestName": "赶走丘丘人，解救货车",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [],
        "dialogs": {}
      }
    },
    {
      "subId": "4007905",
      "subQuestName": "与雷泽对话",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "400790501"
        ],
        "dialogs": {
          "400790501": {
            "id": "400790501",
            "speakerId": 1001,
            "speakerName": "雷泽",
            "text": "……",
            "nextDialogs": [
              "400790502"
            ]
          },
          "400790502": {
            "id": "400790502",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "总算搞定了，这些丘丘人对吃的也太执着了吧。话说，你还好吗？没事吧？",
            "nextDialogs": [
              "400790503"
            ]
          },
          "400790503": {
            "id": "400790503",
            "speakerId": 1002,
            "speakerName": "罗福",
            "text": "呼…幸亏有你们出手相助，不然怕不是连人带货全都要栽在它们手里了。",
            "nextDialogs": [
              "400790506"
            ]
          },
          "400790506": {
            "id": "400790506",
            "speakerId": 1002,
            "speakerName": "罗福",
            "text": "嗯，实在是多谢几位！我也不能在这耽误时间了。先走一步，大家佳酿节快乐！",
            "nextDialogs": [
              "400790507"
            ]
          },
          "400790507": {
            "id": "400790507",
            "speakerId": 1002,
            "speakerName": "罗福",
            "text": "小哥，也谢谢你啊。",
            "nextDialogs": [
              "400790508"
            ]
          },
          "400790508": {
            "id": "400790508",
            "speakerId": 1001,
            "speakerName": "雷泽",
            "text": "嗯。"
          }
        }
      }
    },
    {
      "subId": "4007906",
      "subQuestName": "前往西风骑士团",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "400790601"
        ],
        "dialogs": {
          "400790601": {
            "id": "400790601",
            "speakerId": 1003,
            "speakerName": "丽莎",
            "text": "…所以，你是最合适的人选嘛。",
            "nextDialogs": [
              "400790602"
            ]
          },
          "400790602": {
            "id": "400790602",
            "speakerId": 1004,
            "speakerName": "凯亚",
            "text": "哟，你们来得正好。丽莎正在和我聊雷泽的事呢。",
            "nextDialogs": [
              "400790603"
            ]
          },
          "400790603": {
            "id": "400790603",
            "speakerId": 1004,
            "speakerName": "凯亚",
            "text": "说到哪里来着…哦，酒桶！",
            "nextDialogs": [
              "400790604"
            ]
          },
          "400790604": {
            "id": "400790604",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "欸？！需要的明明是「守护的执着」，骑士团准备的材料…居然是酒桶吗？",
            "nextDialogs": [
              "400790606",
              "400790608"
            ]
          },
          "400790606": {
            "id": "400790606",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "也，也对…",
            "nextDialogs": [
              "400790609"
            ]
          },
          "400790609": {
            "id": "400790609",
            "speakerId": 1003,
            "speakerName": "丽莎",
            "text": "呵呵…小派蒙提到的那种材料，我已经安排好人去准备了哦。",
            "nextDialogs": [
              "400790610"
            ]
          },
          "400790610": {
            "id": "400790610",
            "speakerId": 1003,
            "speakerName": "丽莎",
            "text": "只不过那个孩子也很认真，想多钻研一阵子，请你们耐心等待。",
            "nextDialogs": [
              "400790611"
            ]
          },
          "400790611": {
            "id": "400790611",
            "speakerId": 1003,
            "speakerName": "丽莎",
            "text": "至于酒桶嘛…你们收集了种种原材料，该不会想用达达乌帕谷的大锅把它们搅在一起吧。"
          },
          "400790608": {
            "id": "400790608",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "你清醒一点啊！完全不合理！"
          }
        }
      }
    },
    {
      "subId": "4007907",
      "subQuestName": "前往晨曦酒庄",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [],
        "dialogs": {}
      }
    },
    {
      "subId": "4007908",
      "subQuestName": "进入晨曦酒庄",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "400790801"
        ],
        "dialogs": {
          "400790801": {
            "id": "400790801",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "你好呀，迪卢克老爷！",
            "nextDialogs": [
              "400790802"
            ]
          },
          "400790802": {
            "id": "400790802",
            "speakerId": 1005,
            "speakerName": "迪卢克",
            "text": "哦？我还在想佳酿节期间有谁会登门来访，原来是你们。",
            "nextDialogs": [
              "400790803"
            ]
          },
          "400790803": {
            "id": "400790803",
            "speakerId": 1005,
            "speakerName": "迪卢克",
            "text": "…还有你。",
            "nextDialogs": [
              "400790804"
            ]
          },
          "400790804": {
            "id": "400790804",
            "speakerId": 1004,
            "speakerName": "凯亚",
            "text": "哎呀哎呀，好冷淡的反应，迪卢克老爷似乎不怎么欢迎我。",
            "nextDialogs": [
              "400790805"
            ]
          },
          "400790805": {
            "id": "400790805",
            "speakerId": 1004,
            "speakerName": "凯亚",
            "text": "再怎么说这里也算我的家。节庆期间回家一趟，无论在哪个国家都算得上是习俗吧。",
            "nextDialogs": [
              "400790806"
            ]
          },
          "400790806": {
            "id": "400790806",
            "speakerId": 1005,
            "speakerName": "迪卢克",
            "text": "有事直说。",
            "nextDialogs": [
              "400790807"
            ]
          },
          "400790807": {
            "id": "400790807",
            "speakerId": 1004,
            "speakerName": "凯亚",
            "text": "事情嘛，就是你提到的「佳酿节」喽。",
            "nextDialogs": [
              "400790808"
            ]
          },
          "400790808": {
            "id": "400790808",
            "speakerId": 1004,
            "speakerName": "凯亚",
            "text": "为了欢度久违的佳酿节，代理团长特意联络了教会和冒险家协会，共同筹办了一些节庆活动。",
            "nextDialogs": [
              "400790809"
            ]
          },
          "400790809": {
            "id": "400790809",
            "speakerId": 1004,
            "speakerName": "凯亚",
            "text": "但骑士团的财政状况，不用我说你也想象得出来…",
            "nextDialogs": [
              "400790810"
            ]
          },
          "400790810": {
            "id": "400790810",
            "speakerId": 1005,
            "speakerName": "迪卢克",
            "text": "骑士团的麻烦，和我有什么关系？",
            "nextDialogs": [
              "400790811"
            ]
          },
          "400790811": {
            "id": "400790811",
            "speakerId": 1004,
            "speakerName": "凯亚",
            "text": "喂，这话好无情，连我都听不下去了。大家的努力，不都是为了蒙德嘛。",
            "nextDialogs": [
              "400790812"
            ]
          },
          "400790812": {
            "id": "400790812",
            "speakerId": 1004,
            "speakerName": "凯亚",
            "text": "我都记不清有多久没喝到过晨曦酒庄专供给佳酿节的限定葡萄酒了…蒙德人肯定也是一样。",
            "nextDialogs": [
              "400790813"
            ]
          },
          "400790813": {
            "id": "400790813",
            "speakerId": 1004,
            "speakerName": "凯亚",
            "text": "你是因为自己不爱喝酒，就不给别人痛快畅饮的机会吗？",
            "nextDialogs": [
              "400790814"
            ]
          },
          "400790814": {
            "id": "400790814",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "快看，凯亚这家伙正在明目张胆地要求各种东西呢…",
            "nextDialogs": [
              "400790815"
            ]
          },
          "400790815": {
            "id": "400790815",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "真是厉害！",
            "nextDialogs": [
              "400790816"
            ]
          },
          "400790816": {
            "id": "400790816",
            "speakerId": 1004,
            "speakerName": "凯亚",
            "text": "话说回来，你知道吗？骑士团的人，都盼望着迪卢克前辈能重回我们这个温暖大家庭呢。",
            "nextDialogs": [
              "400790817"
            ]
          },
          "400790817": {
            "id": "400790817",
            "speakerId": 1004,
            "speakerName": "凯亚",
            "text": "要是有迪卢克前辈的人望，我们义卖摊位的队伍，能一路排到鹰翔海滩吧…",
            "nextDialogs": [
              "400790818"
            ]
          },
          "400790818": {
            "id": "400790818",
            "speakerId": 1005,
            "speakerName": "迪卢克",
            "text": "…哈。",
            "nextDialogs": [
              "400790819"
            ]
          },
          "400790819": {
            "id": "400790819",
            "speakerId": 1005,
            "speakerName": "迪卢克",
            "text": "油嘴滑舌对我没用，你那条舌头还是留着维护节日秩序吧。",
            "nextDialogs": [
              "400790820"
            ]
          },
          "400790820": {
            "id": "400790820",
            "speakerId": 1005,
            "speakerName": "迪卢克",
            "text": "经费的事我记下了。稍后我会让埃泽约赫塔小姐详谈。",
            "nextDialogs": [
              "400790821"
            ]
          },
          "400790821": {
            "id": "400790821",
            "speakerId": 1005,
            "speakerName": "迪卢克",
            "text": "最近倒是有一批酒，刚好可以拿去慰劳辛苦了很久的劳动者。",
            "nextDialogs": [
              "400790822"
            ]
          },
          "400790822": {
            "id": "400790822",
            "speakerId": 1005,
            "speakerName": "迪卢克",
            "text": "你希望署你的名字吗？",
            "nextDialogs": [
              "400790823"
            ]
          },
          "400790823": {
            "id": "400790823",
            "speakerId": 1004,
            "speakerName": "凯亚",
            "text": "可别把我想得这么离谱啊。晨曦酒庄出去的东西，怎么能署现任骑兵队长的名字？",
            "nextDialogs": [
              "400790824"
            ]
          },
          "400790824": {
            "id": "400790824",
            "speakerId": 1005,
            "speakerName": "迪卢克",
            "text": "原来你也知道啊。那这件事交给爱德琳办，我会让她以匿名形式把东西送出去。",
            "nextDialogs": [
              "400790825"
            ]
          },
          "400790825": {
            "id": "400790825",
            "speakerId": 1004,
            "speakerName": "凯亚",
            "text": "真是谢谢你喽。",
            "nextDialogs": [
              "400790826"
            ]
          },
          "400790826": {
            "id": "400790826",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "哇，迪卢克老爷好慷慨。就算我喝不上，听着都很开心！",
            "nextDialogs": [
              "400790827"
            ]
          },
          "400790827": {
            "id": "400790827",
            "speakerId": 1005,
            "speakerName": "迪卢克",
            "text": "你们两位过来找我，也是为了佳酿节吗？",
            "nextDialogs": [
              "400790830"
            ]
          },
          "400790830": {
            "id": "400790830",
            "speakerId": 1006,
            "speakerName": "Black Screen",
            "text": "将协助雷泽调制「千风佳酿」的事情告诉了迪卢克…",
            "nextDialogs": [
              "400790831"
            ]
          },
          "400790831": {
            "id": "400790831",
            "speakerId": 1004,
            "speakerName": "凯亚",
            "text": "雷泽这孩子真不容易，一转眼都这么大了，还在找爸爸。迪卢克老爷，不如就帮帮他吧。",
            "nextDialogs": [
              "400790832"
            ]
          },
          "400790832": {
            "id": "400790832",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "为什么在可莉眼里是找妈妈，到了凯亚这边就是找爸爸…虽然这样说是比较方便啦，但听的人肯定会误会！",
            "nextDialogs": [
              "400790833"
            ]
          },
          "400790833": {
            "id": "400790833",
            "speakerId": 1005,
            "speakerName": "迪卢克",
            "text": "没关系，能听懂。",
            "nextDialogs": [
              "400790834"
            ]
          },
          "400790834": {
            "id": "400790834",
            "speakerId": 1005,
            "speakerName": "迪卢克",
            "text": "庄园里有个酒桶，年份有些长了，但材质经过特殊加工，放在烈焰花边烤半天都不要紧。我猜，这个应该能满足你们的需要。",
            "nextDialogs": [
              "400790835"
            ]
          },
          "400790835": {
            "id": "400790835",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "可以可以！我们什么时候去搬？",
            "nextDialogs": [
              "400790836"
            ]
          },
          "400790836": {
            "id": "400790836",
            "speakerId": 1005,
            "speakerName": "迪卢克",
            "text": "不用，我会差人送去集市。你们到「天使的馈赠」摊位附近领取就行。",
            "nextDialogs": [
              "400790837"
            ]
          },
          "400790837": {
            "id": "400790837",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "跟迪卢克老爷打交道就是轻松舒心！嘿嘿，那我们就替雷泽谢谢你啦。",
            "nextDialogs": [
              "400790838"
            ]
          },
          "400790838": {
            "id": "400790838",
            "speakerId": 1005,
            "speakerName": "迪卢克",
            "text": "不必客气。朋友之间，有来有往很正常。",
            "nextDialogs": [
              "400790839"
            ]
          },
          "400790839": {
            "id": "400790839",
            "speakerId": 1004,
            "speakerName": "凯亚",
            "text": "迪卢克老爷个性好积极呢，有恩必报，真不错。",
            "nextDialogs": [
              "400790840"
            ]
          },
          "400790840": {
            "id": "400790840",
            "speakerId": 1005,
            "speakerName": "迪卢克",
            "text": "…差不多到用餐时间了。几位，要一起吃个饭吗？",
            "nextDialogs": [
              "400790841"
            ]
          },
          "400790841": {
            "id": "400790841",
            "speakerId": 1004,
            "speakerName": "凯亚",
            "text": "既然这样，我就先不打扰…",
            "nextDialogs": [
              "400790842"
            ]
          },
          "400790842": {
            "id": "400790842",
            "speakerId": 1005,
            "speakerName": "迪卢克",
            "text": "哼。",
            "nextDialogs": [
              "400790843"
            ]
          },
          "400790843": {
            "id": "400790843",
            "speakerId": 1007,
            "speakerName": "爱德琳",
            "text": "「节庆期间回家一趟，无论在哪个国家都算得上是习俗。」凯亚…少爷都这么说了，不如也留下一起用餐。",
            "nextDialogs": [
              "400790844"
            ]
          },
          "400790844": {
            "id": "400790844",
            "speakerId": 1004,
            "speakerName": "凯亚",
            "text": "爱德琳小姐，我怎么好意思再麻烦你呢。",
            "nextDialogs": [
              "400790845"
            ]
          },
          "400790845": {
            "id": "400790845",
            "speakerId": 1007,
            "speakerName": "爱德琳",
            "text": "您客气了。您每次回来都是以骑兵队长的身份，想想这段日子我只给「骑兵队长」泡过茶，却没有为「少爷」准备过晚餐。",
            "nextDialogs": [
              "400790846"
            ]
          },
          "400790846": {
            "id": "400790846",
            "speakerId": 1004,
            "speakerName": "凯亚",
            "text": "呃…",
            "nextDialogs": [
              "400790847"
            ]
          },
          "400790847": {
            "id": "400790847",
            "speakerId": 1005,
            "speakerName": "迪卢克",
            "text": "刚才的气势呢？不是很能说吗。",
            "nextDialogs": [
              "400790848"
            ]
          },
          "400790848": {
            "id": "400790848",
            "speakerId": 1004,
            "speakerName": "凯亚",
            "text": "…啊哈哈，迪卢克，你…",
            "nextDialogs": [
              "400790849"
            ]
          },
          "400790849": {
            "id": "400790849",
            "speakerId": 1005,
            "speakerName": "迪卢克",
            "text": "你也不想扫了爱德琳的兴致吧。",
            "nextDialogs": [
              "400790850"
            ]
          },
          "400790850": {
            "id": "400790850",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "人多热闹哦。",
            "nextDialogs": [
              "400790851"
            ]
          },
          "400790851": {
            "id": "400790851",
            "speakerId": 1004,
            "speakerName": "凯亚",
            "text": "…也好。那我就不客气了，麻烦爱德琳小姐多加一份刀叉。",
            "nextDialogs": [
              "400790852"
            ]
          },
          "400790852": {
            "id": "400790852",
            "speakerId": 1006,
            "speakerName": "Black Screen",
            "text": "在凯亚的笑声与迪卢克的「哼」声中，众人共进了晚餐…",
            "nextDialogs": [
              "400790853"
            ]
          },
          "400790853": {
            "id": "400790853",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "啊，好饱好饱…爱德琳小姐的手艺真棒，眼睛和肚子都得到了满足。"
          }
        }
      }
    },

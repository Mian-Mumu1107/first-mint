        ],
        "dialogs": {
          "762100401": {
            "id": "762100401",
            "speakerId": 1000,
            "speakerName": "长孙继璟",
            "text": "#{M#郎君}{F#女侠}，可曾准备好？"
          }
        }
      }
    },
    {
      "subId": "7621003",
      "subQuestName": "以纵跃之法，在屋檐上大展身手",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [],
        "dialogs": {}
      }
    },
    {
      "subId": "7621005",
      "subQuestName": "和长孙对话",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "762100201"
        ],
        "dialogs": {
          "762100201": {
            "id": "762100201",
            "speakerId": 1000,
            "speakerName": "长孙继璟",
            "text": "令人仰止。晚生叹服。",
            "nextDialogs": [
              "762100202"
            ]
          },
          "762100202": {
            "id": "762100202",
            "speakerId": 1000,
            "speakerName": "长孙继璟",
            "text": "#既是如此…在下还有一个不情之请。不知{M#郎君}{F#女侠}可曾听说过<color=#00E1FFFF>纵云之法</color>？",
            "nextDialogs": [
              "762100203"
            ]
          },
          "762100203": {
            "id": "762100203",
            "speakerId": 1000,
            "speakerName": "长孙继璟",
            "text": "传闻我等先师古华，曾在华光紫气中登临高天，踏空而行，如履平地，正是靠这传说中的秘法…",
            "nextDialogs": [
              "762100205"
            ]
          },
          "762100205": {
            "id": "762100205",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "是啊，听着就像是假的…不过这么说来，要是能用风之翼的话，说不定也可以做到类似的效果？",
            "nextDialogs": [
              "762100207"
            ]
          },
          "762100207": {
            "id": "762100207",
            "speakerId": 1000,
            "speakerName": "长孙继璟",
            "text": "#哦？那便请{M#郎君}{F#女侠}示范一二了！"
          }
        }
      }
    },
    {
      "subId": "7621006",
      "subQuestName": "总之就是想办法在半空中大展身手",
      "sceneId": null,
      "locations": [],
      "dialogue": {

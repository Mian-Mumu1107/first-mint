      }
    },
    {
      "subId": "7621004",
      "subQuestName": "和长孙对话",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "762100501"
        ],
        "dialogs": {
          "762100501": {
            "id": "762100501",
            "speakerId": 1000,
            "speakerName": "长孙继璟",
            "text": "原来如此…",
            "nextDialogs": [
              "762100502"
            ]
          },
          "762100502": {
            "id": "762100502",
            "speakerId": 1000,
            "speakerName": "长孙继璟",
            "text": "#虽说不算是踏空而行，但亦对在下颇有启发。多谢{M#郎君}{F#女侠}提点。"
          }
        }
      }
    }
  ]
}
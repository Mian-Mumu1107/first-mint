{
  "lineCounts": {
    "Black Screen": 1,
    "Player": 10,
    "派蒙": 9,
    "长孙继璟": 21
  },
  "subQuests": [
    {
      "subId": "7621001",
      "subQuestName": "(test)隐藏$HIDDEN",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "762100101"
        ],
        "dialogs": {
          "762100101": {
            "id": "762100101",
            "speakerId": 1000,
            "speakerName": "长孙继璟",
            "text": "#{M#郎君}{F#女侠}果然好身法。",
            "nextDialogs": [
              "762100102"
            ]
          },
          "762100102": {
            "id": "762100102",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "#嘿嘿，那是当然！{NICKNAME}可是很强的！",
            "nextDialogs": [
              "762100103"
            ]
          },
          "762100103": {
            "id": "762100103",
            "speakerId": 1000,
            "speakerName": "长孙继璟",
            "text": "#接下来，不知{M#郎君}{F#女侠}可否向在下展现<color=#00E1FFFF>纵跃法</color>的精髓？",
            "nextDialogs": [
              "762100104"
            ]
          },
          "762100104": {
            "id": "762100104",
            "speakerId": 1000,
            "speakerName": "长孙继璟",
            "text": "据书中记载，我古华先师跳墙越城，如登平地，真有飞檐走壁之能，是为纵跃之法——",
            "nextDialogs": [
              "762100108",
              "762100107"
            ]
          },
          "762100108": {
            "id": "762100108",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "#嗯…要不然试试看？毕竟{NICKNAME}平时到处翻宝箱，也爬过很多地方了…"
          },
          "762100107": {
            "id": "762100107",
            "speakerId": 1000,
            "speakerName": "长孙继璟",
            "text": "#呵呵，{M#郎君}{F#女侠}请想，若是飞贼能逾墙而走，我等锄恶扶正之人却不能，岂不是要被那奸邪之徒轻易走脱？"
          }
        }
      }
    },
    {
      "subId": "7621009",
      "subQuestName": "和画中人对话",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "762100617"
        ],
        "dialogs": {
          "762100617": {
            "id": "762100617",
            "speakerId": 1002,
            "speakerName": "Black Screen",
            "text": "画中人纵身一跃，来到了你们面前…",
            "nextDialogs": [
              "762100601"
            ]
          },
          "762100601": {
            "id": "762100601",
            "speakerId": 1000,
            "speakerName": "长孙继璟",
            "text": "#在下长孙继璟，见过{M#郎君}{F#女侠}当面。不知{M#郎君}{F#女侠}唤住在下，有何要事相商？",
            "nextDialogs": [
              "762100602"
            ]
          },
          "762100602": {
            "id": "762100602",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "呃，也没什么要事啦。只是看你在画里跳来跳去的，稍微有点好奇…",
            "nextDialogs": [
              "762100603"
            ]
          },
          "762100603": {
            "id": "762100603",
            "speakerId": 1000,
            "speakerName": "长孙继璟",
            "text": "原是这般。在下方才正苦砺轻身之法，只是技法愚拙，让二位见笑了。",
            "nextDialogs": [
              "762100604"
            ]
          },
          "762100604": {
            "id": "762100604",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "轻身之法？",
            "nextDialogs": [
              "762100605"
            ]
          },
          "762100605": {
            "id": "762100605",
            "speakerId": 1000,
            "speakerName": "长孙继璟",
            "text": "不错。此地从未有雨点落下，在下难以修习恩师所传「裁雨」之法，然窃思不可荒废武技，故而只得这般修习。",
            "nextDialogs": [
              "762100606"
            ]
          },
          "762100606": {
            "id": "762100606",
            "speakerId": 1000,
            "speakerName": "长孙继璟",
            "text": "遥想当年，先师古华正是在石桩上修习身法，终臻大成。我等晚生无能，却仍愿拟仿先师皮毛，只求些微寸进。",
            "nextDialogs": [
              "762100607"
            ]
          },
          "762100607": {
            "id": "762100607",
            "speakerId": 1000,
            "speakerName": "长孙继璟",
            "text": "#既然今日有缘相会，我观{M#郎君}{F#女侠}又同为习武之人，可否请{M#郎君}{F#女侠}不吝赐教一二？",
            "nextDialogs": [
              "762100610",
              "762100612"
            ]
          },
          "762100610": {
            "id": "762100610",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "呜哇，语气突然变得好奇怪！呃，所以我们要做什么？",
            "nextDialogs": [
              "762100614"
            ]
          },
          "762100614": {
            "id": "762100614",
            "speakerId": 1000,
            "speakerName": "长孙继璟",
            "text": "多谢。那么，还请二位观瞧。"
          },
          "762100612": {
            "id": "762100612",
            "speakerId": 1000,
            "speakerName": "长孙继璟",
            "text": "原来是派蒙派派蒙派掌门。晚生失敬。",
            "nextDialogs": [
              "762100613"
            ]
          },
          "762100613": {
            "id": "762100613",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "已经完全听不懂你在说什么了！而且就算是行秋的武侠小说里也没有让掌门先上的道理吧！"
          }
        }
      }
    },
    {
      "subId": "7621011",
      "subQuestName": "和长孙对话",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "762100301"
        ],
        "dialogs": {
          "762100301": {
            "id": "762100301",
            "speakerId": 1000,
            "speakerName": "长孙继璟",
            "text": "二位请看。这便是我古华堂的「望梅之阵」。",
            "nextDialogs": [
              "762100302"
            ]
          },
          "762100302": {
            "id": "762100302",
            "speakerId": 1000,
            "speakerName": "长孙继璟",
            "text": "#可否请{M#郎君}{F#女侠}在规定时间内依次踏过由在下指出的石桩，向在下展示身法？",
            "nextDialogs": [
              "762100304",
              "762100306"
            ]
          },
          "762100304": {
            "id": "762100304",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "虽然其实有好多好多桩就是了…呃，没什么。",
            "nextDialogs": [
              "762100307"
            ]
          },
          "762100307": {
            "id": "762100307",
            "speakerId": 1000,
            "speakerName": "长孙继璟",
            "text": "#那么，便请{M#郎君}{F#女侠}一展身手吧。"
          },
          "762100306": {
            "id": "762100306",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "做不到！不管怎么想都——咦？仔细想想好像还真能做到…不过，用飞的应该算犯规吧？"
          }
        }
      }
    },

  "subQuests": [
    {
      "subId": "7601301",
      "subQuestName": "(test)隐藏$HIDDEN",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "760130101"
        ],
        "dialogs": {
          "760130101": {
            "id": "760130101",
            "speakerId": 21842,
            "speakerName": "维娜",
            "text": "#啊，是可靠的{NICKNAME}！又见面啦！果然，这就是月光连接的「命运」吧？",
            "nextDialogs": [
              "760130103",
              "760130107",
              "760130142"
            ]
          },
          "760130103": {
            "id": "760130103",
            "speakerId": 21842,
            "speakerName": "维娜",
            "text": "哼哼，菈乌玛可比莱赫妲尔阿姨讲理多啦！我把事情的缘由跟她说清楚以后，她先是沉默了一分钟左右…",
            "nextDialogs": [
              "760130104"
            ]
          },
          "760130104": {
            "id": "760130104",
            "speakerId": 21842,
            "speakerName": "维娜",
            "text": "随后就让我来书库帮安洛丝整理文献、抄写祷歌，说是在我端正心念之前，不用再去那夏镇工作啦！还有比这更棒的奖赏吗？",
            "nextDialogs": [
              "760130105"
            ]
          },
          "760130105": {
            "id": "760130105",
            "speakerId": 21842,
            "speakerName": "维娜",
            "text": "#对了对了！我这几天抄写祷歌的时候，也理解爱依菈大人之前说的一些话是什么意思了！果然，{NICKNAME}就是我的幸运符呢！"
          },
          "760130107": {
            "id": "760130107",
            "speakerId": 21842,
            "speakerName": "维娜",
            "text": "#嗯嗯！{NICKNAME}想要问什么呢？"
          },
          "760130142": {
            "id": "760130142",
            "speakerId": 21842,
            "speakerName": "维娜",
            "text": "#嗯嗯，那就下次再见啦！一路顺——咳，不对，愿月光照亮你的前路，{NICKNAME}。"
          }
        }
      }
    },

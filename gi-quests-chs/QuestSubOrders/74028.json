  },
  "subQuests": [
    {
      "subId": "7402807",
      "subQuestName": "(test)传送完播开车$HIDDEN",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "740280701"
        ],
        "dialogs": {
          "740280701": {
            "id": "740280701",
            "speakerId": 1000,
            "speakerName": "恩肖",
            "text": "#你们是...{NICKNAME}和派蒙吧。",
            "nextDialogs": [
              "740280702"
            ]
          },
          "740280702": {
            "id": "740280702",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "是的！我们有很重要的消息要告诉恩肖爷爷，但是...还是待会儿再说吧！",
            "nextDialogs": [
              "740280703"
            ]
          },
          "740280703": {
            "id": "740280703",
            "speakerId": 1000,
            "speakerName": "恩肖",
            "text": "什么消息这么神神秘秘的。好，我等你们。"
          }
        }
      }
    },
    {
      "subId": "7402801",
      "subQuestName": "与莉诺尔和卡特皮拉会合",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "740280101"
        ],
        "dialogs": {
          "740280101": {
            "id": "740280101",
            "speakerId": 1002,
            "speakerName": "卡特皮拉",
            "text": "看，那边就是你真正该回的家了。就和艾格妮丝说的一样，柔风拂过的山麓，在开满鲜花的草地上。",
            "nextDialogs": [
              "740280102"
            ]
          },
          "740280102": {
            "id": "740280102",
            "speakerId": 1003,
            "speakerName": "莉诺尔",
            "text": "那边就是…？就和妈妈说的一样…",
            "nextDialogs": [
              "740280103"
            ]
          },
          "740280103": {
            "id": "740280103",
            "speakerId": 1002,
            "speakerName": "卡特皮拉",
            "text": "#{NICKNAME}，派蒙，就由你们带莉诺尔过去吧。",
            "nextDialogs": [
              "740280104"
            ]
          },
          "740280104": {
            "id": "740280104",
            "speakerId": 1003,
            "speakerName": "莉诺尔",
            "text": "那卡特哥哥呢？卡特哥哥不和我一起吗？",
            "nextDialogs": [
              "740280105"
            ]
          },
          "740280105": {
            "id": "740280105",
            "speakerId": 1002,
            "speakerName": "卡特皮拉",
            "text": "我累了，我先在这里休息一下，一会儿就赶上你们。",
            "nextDialogs": [
              "740280106"
            ]
          },
          "740280106": {
            "id": "740280106",
            "speakerId": 1003,
            "speakerName": "莉诺尔",
            "text": "那我也休息一下，等卡特哥哥休息好了，我们再一起走。",
            "nextDialogs": [
              "740280107"
            ]
          },
          "740280107": {
            "id": "740280107",
            "speakerId": 1003,
            "speakerName": "莉诺尔",
            "text": "#{NICKNAME}{M#哥哥}{F#姐姐}和派蒙姐姐应该也累了才对，可惜这里没有布兰，也没有韦尔赛叔叔…",
            "nextDialogs": [
              "740280108"
            ]
          },
          "740280108": {
            "id": "740280108",
            "speakerId": 1003,
            "speakerName": "莉诺尔",
            "text": "…我有点想回去了。",
            "nextDialogs": [
              "740280109"
            ]
          },
          "740280109": {
            "id": "740280109",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "回哪里？",
            "nextDialogs": [
              "740280110"
            ]
          },
          "740280110": {
            "id": "740280110",
            "speakerId": 1003,
            "speakerName": "莉诺尔",
            "text": "当然是回梅洛彼得堡呀。",
            "nextDialogs": [
              "740280114",
              "740280113"
            ]
          },
          "740280114": {
            "id": "740280114",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "莉诺尔不想回自己真正的家吗？你瞧，终点就在眼前了，只要走到那里，探险就结束啦。",
            "nextDialogs": [
              "740280115"
            ]
          },
          "740280115": {
            "id": "740280115",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "而且说起来，我们应该之前就认识莉诺尔的亲人了。现在想想，很多细节都能对上呢。",
            "nextDialogs": [
              "740280116"
            ]
          },
          "740280116": {
            "id": "740280116",
            "speakerId": 1004,
            "speakerName": "Black Screen",
            "text": "讲述了此前帮助恩肖爷爷找回王子、公主，还有勇士的事…",
            "nextDialogs": [
              "740280117"
            ]
          },
          "740280117": {
            "id": "740280117",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "恩肖爷爷做的塔塞斯杂烩可好吃了，莉诺尔一定会喜欢的！",
            "nextDialogs": [
              "740280118"
            ]
          },
          "740280118": {
            "id": "740280118",
            "speakerId": 1002,
            "speakerName": "卡特皮拉",
            "text": "就和艾格妮丝说的一样…莉诺尔，你瞧，没什么可担心的，回家吧，恩肖爷爷一定会照顾好你的。",
            "nextDialogs": [
              "740280119"
            ]
          },
          "740280119": {
            "id": "740280119",
            "speakerId": 1003,
            "speakerName": "莉诺尔",
            "text": "那卡特哥哥也跟我一起回去吗？等休息好了以后？",
            "nextDialogs": [
              "740280120"
            ]
          },
          "740280120": {
            "id": "740280120",
            "speakerId": 1002,
            "speakerName": "卡特皮拉",
            "text": "莉诺尔…",
            "nextDialogs": [
              "740280121"
            ]
          },
          "740280121": {
            "id": "740280121",
            "speakerId": 1002,
            "speakerName": "卡特皮拉",
            "text": "莉诺尔，每个人都有自己该回的地方，你该回真正的家，我也有自己该去的地方。",
            "nextDialogs": [
              "740280122"
            ]
          },
          "740280122": {
            "id": "740280122",
            "speakerId": 1003,
            "speakerName": "莉诺尔",
            "text": "那…那之后我们还会再见吗？故事结束的话，故事里的那些角色就都不见啦…我想，他们一定是再也见不到对方了…",
            "nextDialogs": [
              "740280123"
            ]
          },
          "740280123": {
            "id": "740280123",
            "speakerId": 1002,
            "speakerName": "卡特皮拉",
            "text": "怎么会呢，你的冒险故事才刚刚开始，还有广阔世界等你去探索。",
            "nextDialogs": [
              "740280124"
            ]
          },
          "740280124": {
            "id": "740280124",
            "speakerId": 1002,
            "speakerName": "卡特皮拉",
            "text": "现在只是暂时的分别，我们还会再见的。",
            "nextDialogs": [
              "740280125"
            ]
          },
          "740280125": {
            "id": "740280125",
            "speakerId": 1003,
            "speakerName": "莉诺尔",
            "text": "真的吗？真的是真的吗？虽然卡特哥哥从来没骗过我，但是…",
            "nextDialogs": [
              "740280126"
            ]
          },
          "740280126": {
            "id": "740280126",
            "speakerId": 1002,
            "speakerName": "卡特皮拉",
            "text": "莉诺尔，我来给你讲个故事吧。",
            "nextDialogs": [
              "740280127"
            ]
          },
          "740280127": {
            "id": "740280127",
            "speakerId": 1002,
            "speakerName": "卡特皮拉",
            "text": "很久很久以前…有一个魔法师学徒，他是个愚笨的学徒，为了学会魔法的语言，花费了比其他人多上几倍的时间。",
            "nextDialogs": [
              "740280128"
            ]
          },
          "740280128": {
            "id": "740280128",
            "speakerId": 1002,
            "speakerName": "卡特皮拉",
            "text": "他的老师，了不起的大魔法师，并不为此忧心，反而对他的进步大加赞赏，甚至将重要的工作交付给他…",
            "nextDialogs": [
              "740280129"
            ]
          },
          "740280129": {
            "id": "740280129",
            "speakerId": 1002,
            "speakerName": "卡特皮拉",
            "text": "他也从不怀疑老师的指示，毕竟正是大魔法师教会了他魔法的语言。",
            "nextDialogs": [
              "740280130"
            ]
          },
          "740280130": {
            "id": "740280130",
            "speakerId": 1002,
            "speakerName": "卡特皮拉",
            "text": "大魔法师的工坊里有一个水槽，或者可以叫它鱼缸吧，里面养了一尾小鱼。",
            "nextDialogs": [
              "740280131"
            ]
          },
          "740280131": {
            "id": "740280131",
            "speakerId": 1002,
            "speakerName": "卡特皮拉",
            "text": "有一天，那尾小鱼向学徒搭话，「喂，那边的，笨东西，帮帮我。」",
            "nextDialogs": [
              "740280132"
            ]
          },
          "740280132": {
            "id": "740280132",
            "speakerId": 1002,
            "speakerName": "卡特皮拉",
            "text": "学徒很惊讶，因为在这里，除了大魔法师，没有人，或者生命，像这样同他搭话。于是他好奇地询问，有什么他可以效劳的。",
            "nextDialogs": [
              "740280133"
            ]
          },
          "740280133": {
            "id": "740280133",
            "speakerId": 1002,
            "speakerName": "卡特皮拉",
            "text": "原来这尾小鱼，原本生活在广袤无际的海中。被带到这里之后，就同自己的亲族分散了。它向其他人发出请求，却无人回应。",
            "nextDialogs": [
              "740280134"
            ]
          },
          "740280134": {
            "id": "740280134",
            "speakerId": 1002,
            "speakerName": "卡特皮拉",
            "text": "「我很想送你回家。可是我的老师禁止我外出…」学徒说。小鱼听罢，失望地游到水槽的另一边，不再和学徒说话。",
            "nextDialogs": [
              "740280135"
            ]
          },
          "740280135": {
            "id": "740280135",
            "speakerId": 1002,
            "speakerName": "卡特皮拉",
            "text": "后来有一天，学徒发现，水槽中的那尾小鱼不见了。是谁将它带走了？是谁把它送回家了？学徒不禁好奇。",
            "nextDialogs": [
              "740280136"
            ]
          },
          "740280136": {
            "id": "740280136",
            "speakerId": 1002,
            "speakerName": "卡特皮拉",
            "text": "没有了小鱼的水槽空荡荡的。所谓广袤无际的海，究竟是什么模样呢？学徒的思绪，不知不觉间已经飘到了工坊之外的世界…",
            "nextDialogs": [
              "740280137"
            ]
          },
          "740280137": {
            "id": "740280137",
            "speakerId": 1003,
            "speakerName": "莉诺尔",
            "text": "之后呢之后呢？我猜，魔法师学徒之后一定离开了工坊！",
            "nextDialogs": [
              "740280138"
            ]
          },
          "740280138": {
            "id": "740280138",
            "speakerId": 1003,
            "speakerName": "莉诺尔",
            "text": "可是小鱼…小鱼它回到自己的家了吗？海…就是很多很多水的地方吧？学徒还能找到它吗？",
            "nextDialogs": [
              "740280139"
            ]
          },
          "740280139": {
            "id": "740280139",
            "speakerId": 1002,
            "speakerName": "卡特皮拉",
            "text": "剩下的故事，就下次再讲吧。",
            "nextDialogs": [
              "740280140"
            ]
          },
          "740280140": {
            "id": "740280140",
            "speakerId": 1003,
            "speakerName": "莉诺尔",
            "text": "欸——",
            "nextDialogs": [
              "740280141"
            ]
          },
          "740280141": {
            "id": "740280141",
            "speakerId": 1002,
            "speakerName": "卡特皮拉",
            "text": "光是听我讲故事，也很没趣吧。",
            "nextDialogs": [
              "740280142"
            ]
          },
          "740280142": {
            "id": "740280142",
            "speakerId": 1002,
            "speakerName": "卡特皮拉",
            "text": "下次见面的时候，如果莉诺尔不喜欢我的故事，也可以给我讲一些你从恩肖爷爷那里听来的故事。",
            "nextDialogs": [
              "740280143"
            ]
          },
          "740280143": {
            "id": "740280143",
            "speakerId": 1002,
            "speakerName": "卡特皮拉",
            "text": "我相信，他一定也有很多故事想要和你分享。",
            "nextDialogs": [
              "740280144"
            ]
          },
          "740280144": {
            "id": "740280144",
            "speakerId": 1003,
            "speakerName": "莉诺尔",
            "text": "唔…那…下次见面的时候，我一定会准备很多很多精彩的故事…",
            "nextDialogs": [
              "740280145"
            ]
          },
          "740280145": {
            "id": "740280145",
            "speakerId": 1002,
            "speakerName": "卡特皮拉",
            "text": "我也很期待莉诺尔的故事。",
            "nextDialogs": [
              "740280146"
            ]
          },
          "740280146": {
            "id": "740280146",
            "speakerId": 1002,
            "speakerName": "卡特皮拉",
            "text": "现在，该回家了，莉诺尔。分别是暂时的，我们还会再见的。",
            "nextDialogs": [
              "740280147"
            ]
          },
          "740280147": {
            "id": "740280147",
            "speakerId": 1003,
            "speakerName": "莉诺尔",
            "text": "嗯…卡特哥哥，那就…下次见！",
            "nextDialogs": [
              "740280148"
            ]
          },
          "740280148": {
            "id": "740280148",
            "speakerId": 1003,
            "speakerName": "莉诺尔",
            "text": "#{NICKNAME}{M#哥哥}{F#姐姐}，派蒙姐姐，我们走吧！"
          },
          "740280113": {
            "id": "740280113",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "对呀，我们好不容易才出来…现在回去，恐怕会给艾蒂安他们添麻烦吧？"
          }
        }
      }
    },
    {
      "subId": "7402802",
      "subQuestName": "与莉诺尔和卡特皮拉会合",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [],
        "dialogs": {}
      }
    },
    {
      "subId": "7402809",
      "subQuestName": "将莉诺尔送回亲人身边",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "740280301"
        ],
        "dialogs": {
          "740280301": {
            "id": "740280301",
            "speakerId": 1000,
            "speakerName": "恩肖",
            "text": "哦！好孩子，你们怎么来了？还有这个小姑娘是…",
            "nextDialogs": [
              "740280302"
            ]
          },
          "740280302": {
            "id": "740280302",
            "speakerId": 1000,
            "speakerName": "恩肖",
            "text": "怪事…她看起来有些像…",
            "nextDialogs": [
              "740280303"
            ]
          },
          "740280303": {
            "id": "740280303",
            "speakerId": 1004,
            "speakerName": "Black Screen",
            "text": "和派蒙一起，向恩肖讲述了从卡特皮拉那里听来的关于艾格妮丝的事，其间，莉诺尔也用稚嫩的话语做了一些补足…",
            "nextDialogs": [
              "740280304"
            ]
          },
          "740280304": {
            "id": "740280304",
            "speakerId": 1000,
            "speakerName": "恩肖",
            "text": "原来是这样…傻丫头…原来她已经…",
            "nextDialogs": [
              "740280305"
            ]
          },
          "740280305": {
            "id": "740280305",
            "speakerId": 1003,
            "speakerName": "莉诺尔",
            "text": "妈妈不在梅洛彼得堡了，她也不在这里吗？",
            "nextDialogs": [
              "740280306"
            ]
          },
          "740280306": {
            "id": "740280306",
            "speakerId": 1000,
            "speakerName": "恩肖",
            "text": "是啊，她不喜欢这里，所以离开后再也没回来过。",
            "nextDialogs": [
              "740280307"
            ]
          },
          "740280307": {
            "id": "740280307",
            "speakerId": 1003,
            "speakerName": "莉诺尔",
            "text": "为什么呢？这里全都是她喜欢的东西呀。",
            "nextDialogs": [
              "740280308"
            ]
          },
          "740280308": {
            "id": "740280308",
            "speakerId": 1003,
            "speakerName": "莉诺尔",
            "text": "王子和公主，还有勇士，我一看到它们就认出来啦。",
            "nextDialogs": [
              "740280309"
            ]
          },
          "740280309": {
            "id": "740280309",
            "speakerId": 1003,
            "speakerName": "莉诺尔",
            "text": "妈妈说过，她总是变心变得很快，缠着爸爸…哦，是外公，讨了好久，才答应养的小狗，虽然很喜欢给它们打扮…",
            "nextDialogs": [
              "740280310"
            ]
          },
          "740280310": {
            "id": "740280310",
            "speakerId": 1003,
            "speakerName": "莉诺尔",
            "text": "但是很快就有了更喜欢的东西，所以没能看到小狗长大。",
            "nextDialogs": [
              "740280311"
            ]
          },
          "740280311": {
            "id": "740280311",
            "speakerId": 1003,
            "speakerName": "莉诺尔",
            "text": "她为什么不回来呢？再不回来，我也要长大了。",
            "nextDialogs": [
              "740280313"
            ]
          },
          "740280313": {
            "id": "740280313",
            "speakerId": 1003,
            "speakerName": "莉诺尔",
            "text": "真的吗？不是因为她有了更喜欢的东西，所以才不回来了…",
            "nextDialogs": [
              "740280315"
            ]
          },
          "740280315": {
            "id": "740280315",
            "speakerId": 1003,
            "speakerName": "莉诺尔",
            "text": "那这里以后会是我的家吗？",
            "nextDialogs": [
              "740280316"
            ]
          },
          "740280316": {
            "id": "740280316",
            "speakerId": 1000,
            "speakerName": "恩肖",
            "text": "是的，好孩子，这里以后就是你的家了…",
            "nextDialogs": [
              "740280317"
            ]
          },
          "740280317": {
            "id": "740280317",
            "speakerId": 1003,
            "speakerName": "莉诺尔",
            "text": "嗯…我闻到塔塞斯杂烩的香气了！",
            "nextDialogs": [
              "740280318"
            ]
          },
          "740280318": {
            "id": "740280318",
            "speakerId": 1000,
            "speakerName": "恩肖",
            "text": "想吃多少都可以。",
            "nextDialogs": [
              "740280319"
            ]
          },
          "740280319": {
            "id": "740280319",
            "speakerId": 1003,
            "speakerName": "莉诺尔",
            "text": "…我回到自己的家啦，这样卡特哥哥也会高兴的吧。",
            "nextDialogs": [
              "740280320"
            ]
          },
          "740280320": {
            "id": "740280320",
            "speakerId": 1000,
            "speakerName": "恩肖",
            "text": "卡特哥哥…是刚才说的一直照顾这孩子的人？如果方便的话，请他也来屋里歇会儿吧。"
          }
        }
      }
    },
    {
      "subId": "7402803",
      "subQuestName": "与卡特皮拉对话",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "740280501"
        ],
        "dialogs": {
          "740280501": {
            "id": "740280501",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "卡特皮拉...以现在的样子去见恩肖爷爷和莉诺尔不也很好吗？真的这样就可以了吗？",
            "nextDialogs": [
              "740280502"
            ]
          },
          "740280502": {
            "id": "740280502",
            "speakerId": 1002,
            "speakerName": "卡特皮拉",
            "text": "她回到了正常的世界，有真正的家人陪伴。这对她来说，就是故事的好结局了吧。",
            "nextDialogs": [
              "740280503"
            ]
          },
          "740280503": {
            "id": "740280503",
            "speakerId": 1002,
            "speakerName": "卡特皮拉",
            "text": "至于我…她很快就会忘记我的。",
            "nextDialogs": [
              "740280504"
            ]
          },
          "740280504": {
            "id": "740280504",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "别这么说嘛！你明明知道，你对她来说也是很重要的。她一定不会忘记你们的约定的。",
            "nextDialogs": [
              "740280505"
            ]
          },
          "740280505": {
            "id": "740280505",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "如果你真的再也不见她了，她肯定会很伤心的…",
            "nextDialogs": [
              "740280506"
            ]
          },
          "740280506": {
            "id": "740280506",
            "speakerId": 1002,
            "speakerName": "卡特皮拉",
            "text": "不会的。对小孩子来说，无论是相遇还是别离，都会很快遗忘。这样他们才会成长。",
            "nextDialogs": [
              "740280507"
            ]
          },
          "740280507": {
            "id": "740280507",
            "speakerId": 1002,
            "speakerName": "卡特皮拉",
            "text": "我只是一个故事里的角色，有时是勇者，有时是邪恶的怪物…",
            "nextDialogs": [
              "740280508"
            ]
          },
          "740280508": {
            "id": "740280508",
            "speakerId": 1002,
            "speakerName": "卡特皮拉",
            "text": "就让幻想故事留在过去的回忆中吧。现在她拥有真实的世界，比幻想故事好上百倍千倍。",
            "nextDialogs": [
              "740280509"
            ]
          },
          "740280509": {
            "id": "740280509",
            "speakerId": 1002,
            "speakerName": "卡特皮拉",
            "text": "#{NICKNAME}，派蒙，谢谢你们。",
            "nextDialogs": [
              "740280513",
              "740280512"
            ]
          },
          "740280513": {
            "id": "740280513",
            "speakerId": 1002,
            "speakerName": "卡特皮拉",
            "text": "之前说过，有更适合讲述历史故事的地方，<color=#00E1FFFF>水仙十字结社</color>…",
            "nextDialogs": [
              "740280514"
            ]
          },
          "740280514": {
            "id": "740280514",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "听起来是很神秘的地方呢…它在哪里，我们该怎么去呢？",
            "nextDialogs": [
              "740280515"
            ]
          },
          "740280515": {
            "id": "740280515",
            "speakerId": 1002,
            "speakerName": "卡特皮拉",
            "text": "的确是很神秘的地方，这几百年来，外面的世界也发生了许多变化…或许得重新寻找前往水仙十字结社的道路。",
            "nextDialogs": [
              "740280516"
            ]
          },
          "740280516": {
            "id": "740280516",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "怎么会这样…不过，我们再怎么说也是经验丰富的冒险家，什么历史遗迹、秘密地点，根本难不倒我们。",
            "nextDialogs": [
              "740280517"
            ]
          },
          "740280517": {
            "id": "740280517",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "肯定能找到的！"
          },
          "740280512": {
            "id": "740280512",
            "speakerId": 1002,
            "speakerName": "卡特皮拉",
            "text": "当然，我会尽我所能。"
          }
        }
      }
    },
    {
      "subId": "7402800",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "740280003"
        ],
        "dialogs": {
          "740280003": {
            "id": "740280003",
            "speakerId": 1004,
            "speakerName": "Black Screen",
            "text": "跟随卡特皮拉的指引，通过隐藏通路离开了梅洛彼得堡…"
          }
        }
      }
    },
    {
      "subId": "7402802",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "740280201"
        ],
        "dialogs": {
          "740280201": {
            "id": "740280201",
            "speakerId": 1002,
            "speakerName": "卡特皮拉",
            "text": "看，那边就是你真正该回的家了。就和艾格妮丝说的一样，柔风拂过的山麓，在开满鲜花的草地上。",
            "nextDialogs": [
              "740280202"
            ]
          },
          "740280202": {
            "id": "740280202",
            "speakerId": 1003,
            "speakerName": "莉诺尔",
            "text": "那边就是…？就和妈妈说的一样…",
            "nextDialogs": [
              "740280203"
            ]
          },
          "740280203": {
            "id": "740280203",
            "speakerId": 1002,
            "speakerName": "卡特皮拉",
            "text": "#{NICKNAME}，派蒙，就由你们带莉诺尔过去吧。",
            "nextDialogs": [
              "740280204"
            ]
          },
          "740280204": {
            "id": "740280204",
            "speakerId": 1003,
            "speakerName": "莉诺尔",
            "text": "那卡特哥哥呢？卡特哥哥不和我一起吗？",
            "nextDialogs": [
              "740280205"
            ]
          },
          "740280205": {
            "id": "740280205",
            "speakerId": 1002,
            "speakerName": "卡特皮拉",
            "text": "我累了，我先在这里休息一下，一会儿就赶上你们。",
            "nextDialogs": [
              "740280206"
            ]
          },
          "740280206": {
            "id": "740280206",
            "speakerId": 1003,
            "speakerName": "莉诺尔",
            "text": "那我也休息一下，等卡特哥哥休息好了，我们再一起走。",
            "nextDialogs": [
              "740280207"
            ]
          },
          "740280207": {
            "id": "740280207",
            "speakerId": 1003,
            "speakerName": "莉诺尔",
            "text": "#{NICKNAME}{M#哥哥}{F#姐姐}和派蒙姐姐应该也累了才对，可惜这里没有布兰，也没有韦尔赛叔叔…",
            "nextDialogs": [
              "740280208"
            ]
          },
          "740280208": {
            "id": "740280208",
            "speakerId": 1003,
            "speakerName": "莉诺尔",
            "text": "…我有点想回去了。",
            "nextDialogs": [
              "740280209"
            ]
          },
          "740280209": {
            "id": "740280209",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "回哪里？",
            "nextDialogs": [
              "740280210"
            ]
          },
          "740280210": {
            "id": "740280210",
            "speakerId": 1003,
            "speakerName": "莉诺尔",
            "text": "当然是回梅洛彼得堡呀。",
            "nextDialogs": [
              "740280214",
              "740280213"
            ]
          },
          "740280214": {
            "id": "740280214",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "莉诺尔不想回自己真正的家吗？你瞧，终点就在眼前了，只要走到那里，探险就结束啦。",
            "nextDialogs": [
              "740280215"
            ]
          },
          "740280215": {
            "id": "740280215",
            "speakerId": 1002,
            "speakerName": "卡特皮拉",
            "text": "那座小屋的主人叫做恩肖，是个善良的人。他就是莉诺尔的亲人了。",
            "nextDialogs": [
              "740280216"
            ]
          },
          "740280216": {
            "id": "740280216",
            "speakerId": 1002,
            "speakerName": "卡特皮拉",
            "text": "莉诺尔，你瞧，没什么可担心的，回家吧，恩肖爷爷一定会照顾好你的。",
            "nextDialogs": [
              "740280217"
            ]
          },
          "740280217": {
            "id": "740280217",
            "speakerId": 1003,
            "speakerName": "莉诺尔",
            "text": "那卡特哥哥也跟我一起回去吗？等休息好了以后？",
            "nextDialogs": [
              "740280218"
            ]
          },
          "740280218": {
            "id": "740280218",
            "speakerId": 1002,
            "speakerName": "卡特皮拉",
            "text": "莉诺尔…",
            "nextDialogs": [
              "740280219"
            ]
          },
          "740280219": {
            "id": "740280219",
            "speakerId": 1002,
            "speakerName": "卡特皮拉",
            "text": "莉诺尔，每个人都有自己该回的地方，你该回真正的家，我也有自己该去的地方。",
            "nextDialogs": [
              "740280220"
            ]
          },
          "740280220": {
            "id": "740280220",
            "speakerId": 1003,
            "speakerName": "莉诺尔",
            "text": "那…那之后我们还会再见吗？故事结束的话，故事里的那些角色就都不见啦…我想，他们一定是再也见不到对方了…",
            "nextDialogs": [
              "740280221"
            ]
          },
          "740280221": {
            "id": "740280221",
            "speakerId": 1002,
            "speakerName": "卡特皮拉",
            "text": "怎么会呢，你的冒险故事才刚刚开始，还有广阔世界等你去探索。",
            "nextDialogs": [
              "740280222"
            ]
          },
          "740280222": {
            "id": "740280222",
            "speakerId": 1002,
            "speakerName": "卡特皮拉",
            "text": "现在只是暂时的分别，我们还会再见的。",
            "nextDialogs": [
              "740280223"
            ]
          },
          "740280223": {
            "id": "740280223",
            "speakerId": 1003,
            "speakerName": "莉诺尔",
            "text": "真的吗？真的是真的吗？虽然卡特哥哥从来没骗过我，但是…",
            "nextDialogs": [
              "740280224"
            ]
          },
          "740280224": {
            "id": "740280224",
            "speakerId": 1002,
            "speakerName": "卡特皮拉",
            "text": "莉诺尔，我来给你讲个故事吧。",
            "nextDialogs": [
              "740280225"
            ]
          },
          "740280225": {
            "id": "740280225",
            "speakerId": 1002,
            "speakerName": "卡特皮拉",
            "text": "很久很久以前…有一个魔法师学徒，他是个愚笨的学徒，为了学会魔法的语言，花费了比其他人多上几倍的时间。",
            "nextDialogs": [
              "740280226"
            ]
          },
          "740280226": {
            "id": "740280226",
            "speakerId": 1002,
            "speakerName": "卡特皮拉",
            "text": "他的老师，了不起的大魔法师，并不为此忧心，反而对他的进步大加赞赏，甚至将重要的工作交付给他…",
            "nextDialogs": [
              "740280227"
            ]
          },
          "740280227": {
            "id": "740280227",
            "speakerId": 1002,
            "speakerName": "卡特皮拉",
            "text": "他也从不怀疑老师的指示，毕竟正是大魔法师教会了他魔法的语言。",
            "nextDialogs": [
              "740280228"
            ]
          },
          "740280228": {
            "id": "740280228",
            "speakerId": 1002,
            "speakerName": "卡特皮拉",
            "text": "大魔法师的工坊里有一个水槽，或者可以叫它鱼缸吧，里面养了一尾小鱼。",
            "nextDialogs": [
              "740280229"
            ]
          },
          "740280229": {
            "id": "740280229",
            "speakerId": 1002,
            "speakerName": "卡特皮拉",
            "text": "有一天，那尾小鱼向学徒搭话，「喂，那边的，笨东西，帮帮我。」",
            "nextDialogs": [
              "740280230"
            ]
          },
          "740280230": {
            "id": "740280230",
            "speakerId": 1002,
            "speakerName": "卡特皮拉",
            "text": "学徒很惊讶，因为在这里，除了大魔法师，没有人，或者生命，像这样同他搭话。于是他好奇地询问，有什么他可以效劳的。",
            "nextDialogs": [
              "740280231"
            ]
          },
          "740280231": {
            "id": "740280231",
            "speakerId": 1002,
            "speakerName": "卡特皮拉",
            "text": "原来这尾小鱼，原本生活在广袤无际的海中。被带到这里之后，就同自己的亲族分散了。它向其他人发出请求，却无人回应。",
            "nextDialogs": [
              "740280232"
            ]
          },
          "740280232": {
            "id": "740280232",
            "speakerId": 1002,
            "speakerName": "卡特皮拉",
            "text": "「我很想送你回家。可是我的老师禁止我外出…」学徒说。小鱼听罢，失望地游到水槽的另一边，不再和学徒说话。",
            "nextDialogs": [
              "740280233"
            ]
          },
          "740280233": {
            "id": "740280233",
            "speakerId": 1002,
            "speakerName": "卡特皮拉",
            "text": "后来有一天，学徒发现，水槽中的那尾小鱼不见了。是谁将它带走了？是谁把它送回家了？学徒不由地好奇。",
            "nextDialogs": [
              "740280234"
            ]
          },
          "740280234": {
            "id": "740280234",
            "speakerId": 1002,
            "speakerName": "卡特皮拉",
            "text": "没有了小鱼的水槽空荡荡的。所谓广袤无际的海，究竟是什么模样呢？学徒的思绪，不知不觉间已经飘到了工坊之外的世界…",
            "nextDialogs": [
              "740280235"
            ]
          },
          "740280235": {
            "id": "740280235",
            "speakerId": 1003,
            "speakerName": "莉诺尔",
            "text": "之后呢之后呢？我猜，魔法师学徒之后一定离开了工坊！",
            "nextDialogs": [
              "740280236"
            ]
          },
          "740280236": {
            "id": "740280236",
            "speakerId": 1003,
            "speakerName": "莉诺尔",
            "text": "可是小鱼…小鱼它回到自己的家了吗？海…就是很多很多水的地方吧？学徒还能找到它吗？",
            "nextDialogs": [
              "740280237"
            ]
          },
          "740280237": {
            "id": "740280237",
            "speakerId": 1002,
            "speakerName": "卡特皮拉",
            "text": "剩下的故事，就下次再讲吧。",
            "nextDialogs": [
              "740280238"
            ]
          },
          "740280238": {
            "id": "740280238",
            "speakerId": 1003,
            "speakerName": "莉诺尔",
            "text": "欸——",
            "nextDialogs": [
              "740280239"
            ]
          },
          "740280239": {
            "id": "740280239",
            "speakerId": 1002,
            "speakerName": "卡特皮拉",
            "text": "光是听我讲故事，也很没趣吧。",
            "nextDialogs": [
              "740280240"
            ]
          },
          "740280240": {
            "id": "740280240",
            "speakerId": 1002,
            "speakerName": "卡特皮拉",
            "text": "下次见面的时候，如果莉诺尔不喜欢我的故事，也可以给我讲一些你从恩肖爷爷那里听来的故事。",
            "nextDialogs": [
              "740280241"
            ]
          },
          "740280241": {
            "id": "740280241",
            "speakerId": 1002,
            "speakerName": "卡特皮拉",
            "text": "我相信，他一定也有很多故事想要和你分享。",
            "nextDialogs": [
              "740280242"
            ]
          },
          "740280242": {
            "id": "740280242",
            "speakerId": 1003,
            "speakerName": "莉诺尔",
            "text": "唔…那…下次见面的时候，我一定会准备很多很多精彩的故事…",
            "nextDialogs": [
              "740280243"
            ]
          },
          "740280243": {
            "id": "740280243",
            "speakerId": 1002,
            "speakerName": "卡特皮拉",
            "text": "我也很期待莉诺尔的故事。",
            "nextDialogs": [
              "740280244"
            ]
          },
          "740280244": {
            "id": "740280244",
            "speakerId": 1002,
            "speakerName": "卡特皮拉",
            "text": "现在，该回家了，莉诺尔。分别是暂时的，我们还会再见的。",
            "nextDialogs": [
              "740280245"
            ]
          },
          "740280245": {
            "id": "740280245",
            "speakerId": 1003,
            "speakerName": "莉诺尔",
            "text": "嗯…卡特哥哥，那就…下次见！",
            "nextDialogs": [
              "740280246"
            ]
          },
          "740280246": {
            "id": "740280246",
            "speakerId": 1003,
            "speakerName": "莉诺尔",
            "text": "#{NICKNAME}{M#哥哥}{F#姐姐}，派蒙姐姐，我们走吧！"
          },
          "740280213": {
            "id": "740280213",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "对呀，我们好不容易才出来…现在回去，恐怕会给艾蒂安他们添麻烦吧？"
          }
        }
      }
    },
    {
      "subId": "7402804",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "740280401"
        ],
        "dialogs": {
          "740280401": {
            "id": "740280401",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "应该就是这里了吧？请问…",
            "nextDialogs": [
              "740280402"
            ]
          },
          "740280402": {
            "id": "740280402",
            "speakerId": 1000,
            "speakerName": "恩肖",
            "text": "怎么了，是登山客吗？有什么事？",
            "nextDialogs": [
              "740280403"
            ]
          },
          "740280403": {
            "id": "740280403",
            "speakerId": 1000,
            "speakerName": "恩肖",
            "text": "怪事…这孩子看起来有些像…",
            "nextDialogs": [
              "740280404"
            ]
          },
          "740280404": {
            "id": "740280404",
            "speakerId": 1000,
            "speakerName": "恩肖",
            "text": "唔…没什么，肯定是我人老了，眼花了。",
            "nextDialogs": [
              "740280405"
            ]
          },
          "740280405": {
            "id": "740280405",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "虽然说来有些离奇，但是事情是这样的…",
            "nextDialogs": [
              "740280406"
            ]
          },
          "740280406": {
            "id": "740280406",
            "speakerId": 1004,
            "speakerName": "Black Screen",
            "text": "和派蒙一起，向老人讲述了从卡特皮拉那里听来的关于艾格妮丝的事，其间，莉诺尔也用稚嫩的话语做了一些补足…",
            "nextDialogs": [
              "740280407"
            ]
          },
          "740280407": {
            "id": "740280407",
            "speakerId": 1000,
            "speakerName": "恩肖",
            "text": "原来是这样…傻丫头…原来她已经…",
            "nextDialogs": [
              "740280408"
            ]
          },
          "740280408": {
            "id": "740280408",
            "speakerId": 1003,
            "speakerName": "莉诺尔",
            "text": "妈妈不在梅洛彼得堡了，她也不在这里吗？",
            "nextDialogs": [
              "740280409"
            ]
          },
          "740280409": {
            "id": "740280409",
            "speakerId": 1000,
            "speakerName": "恩肖",
            "text": "是啊，她不喜欢这里，所以离开后再也没回来过。",
            "nextDialogs": [
              "740280410"
            ]
          },
          "740280410": {
            "id": "740280410",
            "speakerId": 1003,
            "speakerName": "莉诺尔",
            "text": "为什么呢？这里全都是她喜欢的东西呀。",
            "nextDialogs": [
              "740280411"
            ]
          },
          "740280411": {
            "id": "740280411",
            "speakerId": 1003,
            "speakerName": "莉诺尔",
            "text": "王子和公主，还有勇士，我一看到它们就认出来啦。",
            "nextDialogs": [
              "740280412"
            ]
          },
          "740280412": {
            "id": "740280412",
            "speakerId": 1003,
            "speakerName": "莉诺尔",
            "text": "妈妈说过，她总是变心变得很快，缠着爸爸…哦，是外公，讨了好久，才答应养的小狗，虽然很喜欢给它们打扮…",
            "nextDialogs": [
              "740280413"
            ]
          },
          "740280413": {
            "id": "740280413",
            "speakerId": 1003,
            "speakerName": "莉诺尔",
            "text": "但是很快就有了更喜欢的东西，所以没能看到小狗长大。",
            "nextDialogs": [
              "740280414"
            ]
          },
          "740280414": {
            "id": "740280414",
            "speakerId": 1003,
            "speakerName": "莉诺尔",
            "text": "她为什么不回来呢？再不回来，我也要长大了。",
            "nextDialogs": [
              "740280416"
            ]
          },
          "740280416": {
            "id": "740280416",
            "speakerId": 1003,
            "speakerName": "莉诺尔",
            "text": "真的吗？不是因为她有了更喜欢的东西，所以才不回来了…",
            "nextDialogs": [
              "740280418"
            ]
          },
          "740280418": {
            "id": "740280418",
            "speakerId": 1003,
            "speakerName": "莉诺尔",
            "text": "那这里以后会是我的家吗？",
            "nextDialogs": [
              "740280419"
            ]
          },
          "740280419": {
            "id": "740280419",
            "speakerId": 1000,
            "speakerName": "恩肖",
            "text": "是的，好孩子，这里以后就是你的家了…",
            "nextDialogs": [
              "740280420"
            ]
          },
          "740280420": {
            "id": "740280420",
            "speakerId": 1003,
            "speakerName": "莉诺尔",
            "text": "嗯…我闻到塔塞斯杂烩的香气了！",
            "nextDialogs": [
              "740280421"
            ]
          },
          "740280421": {
            "id": "740280421",
            "speakerId": 1000,
            "speakerName": "恩肖",
            "text": "想吃多少都可以。",
            "nextDialogs": [
              "740280422"
            ]
          },
          "740280422": {
            "id": "740280422",
            "speakerId": 1003,
            "speakerName": "莉诺尔",
            "text": "…我回到自己的家啦，这样卡特哥哥也会高兴的吧。",
            "nextDialogs": [
              "740280423"
            ]
          },
          "740280423": {
            "id": "740280423",
            "speakerId": 1000,
            "speakerName": "恩肖",
            "text": "卡特哥哥…是刚才说的一直照顾这孩子的人？如果方便的话，请他也来屋里歇会儿吧。"
          }
        }
      }
    },
    {
      "subId": "7402806",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "740280601"
        ],
        "dialogs": {
          "740280601": {
            "id": "740280601",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "卡特皮拉...以现在的样子去见恩肖爷爷和莉诺尔不也很好吗？真的这样就可以了吗？",
            "nextDialogs": [
              "740280602"
            ]
          },
          "740280602": {
            "id": "740280602",
            "speakerId": 1002,
            "speakerName": "卡特皮拉",
            "text": "她回到了正常的世界，有真正的家人陪伴。这对她来说，就是故事的好结局了吧。",
            "nextDialogs": [
              "740280603"
            ]
          },
          "740280603": {
            "id": "740280603",
            "speakerId": 1002,
            "speakerName": "卡特皮拉",
            "text": "至于我…她很快就会忘记我的。",
            "nextDialogs": [
              "740280604"
            ]
          },
          "740280604": {
            "id": "740280604",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "别这么说嘛！你明明知道，你对她来说也是很重要的。她一定不会忘记你们的约定的。",
            "nextDialogs": [
              "740280605"
            ]
          },
          "740280605": {
            "id": "740280605",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "如果你真的再也不见她了，她肯定会很伤心的…",
            "nextDialogs": [
              "740280606"
            ]
          },
          "740280606": {
            "id": "740280606",
            "speakerId": 1002,
            "speakerName": "卡特皮拉",
            "text": "不会的。对小孩子来说，无论是相遇还是别离，都会很快遗忘。这样他们才会成长。",
            "nextDialogs": [
              "740280607"
            ]
          },
          "740280607": {
            "id": "740280607",
            "speakerId": 1002,
            "speakerName": "卡特皮拉",
            "text": "我只是一个故事里的角色，有时是勇者，有时是邪恶的怪物…",
            "nextDialogs": [
              "740280608"
            ]
          },
          "740280608": {
            "id": "740280608",
            "speakerId": 1002,
            "speakerName": "卡特皮拉",
            "text": "就让幻想故事留在过去的回忆中吧。现在她拥有真实的世界，比幻想故事好上百倍千倍。",
            "nextDialogs": [
              "740280609"
            ]
          },
          "740280609": {
            "id": "740280609",
            "speakerId": 1002,
            "speakerName": "卡特皮拉",
            "text": "#{NICKNAME}，派蒙，谢谢你们。",
            "nextDialogs": [
              "740280613",
              "740280612"
            ]
          },
          "740280613": {
            "id": "740280613",
            "speakerId": 1002,
            "speakerName": "卡特皮拉",
            "text": "之前说过，有更适合讲述历史故事的地方，<color=#00E1FFFF>水仙十字结社</color>…",
            "nextDialogs": [
              "740280614"
            ]
          },
          "740280614": {
            "id": "740280614",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "哦，我们之前也去过呢！",
            "nextDialogs": [
              "740280615"
            ]
          },
          "740280615": {
            "id": "740280615",
            "speakerId": 1002,
            "speakerName": "卡特皮拉",
            "text": "既然如此，那就省去了寻找道路的麻烦，我们现在就走吧。",
            "nextDialogs": [
              "740280616"
            ]
          },
          "740280616": {
            "id": "740280616",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "嗯！"
          },
          "740280612": {
            "id": "740280612",
            "speakerId": 1002,
            "speakerName": "卡特皮拉",
            "text": "当然，我会尽我所能。"
          }
        }
      }
    },
    {
      "subId": "7402808",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "740280801"
        ],
        "dialogs": {
          "740280801": {
            "id": "740280801",
            "speakerId": 1000,
            "speakerName": "恩肖",
            "text": "你们是登山客？需要帮助吗？",
            "nextDialogs": [
              "740280802"
            ]
          },
          "740280802": {
            "id": "740280802",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "呃…我们是…还是待会儿再说吧！",
            "nextDialogs": [
              "740280803"
            ]
          },
          "740280803": {
            "id": "740280803",
            "speakerId": 1000,
            "speakerName": "恩肖",
            "text": "需要帮助的话就不要硬撑。"
          }
        }
      }
    },
    {
      "subId": "7402809",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "740280901"
        ],
        "dialogs": {
          "740280901": {
            "id": "740280901",
            "speakerId": 1002,
            "speakerName": "卡特皮拉",
            "text": "就麻烦你们把莉诺尔带回家了。"
          }
        }
      }
    }
  ]
}
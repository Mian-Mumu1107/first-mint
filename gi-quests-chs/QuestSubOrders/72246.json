{
  "lineCounts": {
    "Player": 7,
    "墨田": 34,
    "阿釜": 13
  },
  "subQuests": [
    {
      "subId": "7224601",
      "subQuestName": "自然日刷新（test）$HIDDEN",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "722460101"
        ],
        "dialogs": {
          "722460101": {
            "id": "722460101",
            "speakerId": 1000,
            "speakerName": "墨田",
            "text": "好漂亮的镯子！好漂亮的花瓶！璃月的东西真漂亮！",
            "nextDialogs": [
              "722460102"
            ]
          },
          "722460102": {
            "id": "722460102",
            "speakerId": 1000,
            "speakerName": "墨田",
            "text": "…啊，不行。这么匮乏的用词，实在是愧对小说家的身份哪。",
            "nextDialogs": [
              "722460103"
            ]
          },
          "722460103": {
            "id": "722460103",
            "speakerId": 1000,
            "speakerName": "墨田",
            "text": "买个巧夺天工的瓷瓶，用来当做下一部小说的参考好了…",
            "nextDialogs": [
              "722460104"
            ]
          },
          "722460104": {
            "id": "722460104",
            "speakerId": 1000,
            "speakerName": "墨田",
            "text": "嗯…写个这样的情节吧！",
            "nextDialogs": [
              "722460105"
            ]
          },
          "722460105": {
            "id": "722460105",
            "speakerId": 1000,
            "speakerName": "墨田",
            "text": "「扭转局面的关键，竟然是藏在花瓶里的神之眼…！」",
            "nextDialogs": [
              "722460106"
            ]
          },
          "722460106": {
            "id": "722460106",
            "speakerId": 1000,
            "speakerName": "墨田",
            "text": "感觉很有意思呢！你觉得呢，阿釜？",
            "nextDialogs": [
              "722460107"
            ]
          },
          "722460107": {
            "id": "722460107",
            "speakerId": 1001,
            "speakerName": "阿釜",
            "text": "我没什么所…",
            "nextDialogs": [
              "722460108"
            ]
          },
          "722460108": {
            "id": "722460108",
            "speakerId": 1001,
            "speakerName": "阿釜",
            "text": "……",
            "nextDialogs": [
              "722460109"
            ]
          },
          "722460109": {
            "id": "722460109",
            "speakerId": 1001,
            "speakerName": "阿釜",
            "text": "…我个人觉得，给「花瓶」的笔墨要控制好。描写过度的话，意图会被察觉到。但描写有所欠缺的话，最后又会显得太过突兀。",
            "nextDialogs": [
              "722460110"
            ]
          },
          "722460110": {
            "id": "722460110",
            "speakerId": 1000,
            "speakerName": "墨田",
            "text": "哦哦，你说得很对！我记一下…",
            "nextDialogs": [
              "722460111"
            ]
          },
          "722460111": {
            "id": "722460111",
            "speakerId": 1000,
            "speakerName": "墨田",
            "text": "啊，抱歉抱歉！我们换个地方吧。",
            "nextDialogs": [
              "722460112"
            ]
          },
          "722460112": {
            "id": "722460112",
            "speakerId": 1000,
            "speakerName": "墨田",
            "text": "还有，说了多少次了，别叫我大人了——",
            "nextDialogs": [
              "722460113"
            ]
          },
          "722460113": {
            "id": "722460113",
            "speakerId": 1000,
            "speakerName": "墨田",
            "text": "嗯？仔细一想，看起来很普通的两名旅人，其中一位将另一位称为「大人」，也是常见的情节…"
          }
        }
      }
    },
    {
      "subId": "7224602",
      "subQuestName": "璃月纪念品商店（test）$HIDDEN",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [],
        "dialogs": {}
      }
    },
    {
      "subId": "7224604",
      "subQuestName": "（test'）闲置对话$HIDDEN",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "722460401"
        ],
        "dialogs": {
          "722460401": {
            "id": "722460401",
            "speakerId": 1000,
            "speakerName": "墨田",
            "text": "「世界如此宽广…」",
            "nextDialogs": [
              "722460402"
            ]
          },
          "722460402": {
            "id": "722460402",
            "speakerId": 1001,
            "speakerName": "阿釜",
            "text": "是《净琉璃机动队》吗？",
            "nextDialogs": [
              "722460403"
            ]
          },
          "722460403": {
            "id": "722460403",
            "speakerId": 1000,
            "speakerName": "墨田",
            "text": "嗯。阿釜你的记性，很不错嘛。",
            "nextDialogs": [
              "722460404"
            ]
          },
          "722460404": {
            "id": "722460404",
            "speakerId": 1001,
            "speakerName": "阿釜",
            "text": "是您跟我说过的故事。"
          }
        }
      }
    },
    {
      "subId": "7224603",
      "subQuestName": "蒙德图书馆（test）$HIDDEN",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "722460201"
        ],
        "dialogs": {
          "722460201": {
            "id": "722460201",
            "speakerId": 1000,
            "speakerName": "墨田",
            "text": "呼啊——真是太愉快了——",
            "nextDialogs": [
              "722460202"
            ]
          },
          "722460202": {
            "id": "722460202",
            "speakerId": 1000,
            "speakerName": "墨田",
            "text": "该说真不愧是北陆最大的图书馆吗！竟然能有机会一口气把《少女薇拉的忧郁》看完！痛快痛快！",
            "nextDialogs": [
              "722460203"
            ]
          },
          "722460203": {
            "id": "722460203",
            "speakerId": 1001,
            "speakerName": "阿釜",
            "text": "墨田大人，小声一点。",
            "nextDialogs": [
              "722460204"
            ]
          },
          "722460204": {
            "id": "722460204",
            "speakerId": 1000,
            "speakerName": "墨田",
            "text": "啊，不好意思。实在是太让人激动了嘛…",
            "nextDialogs": [
              "722460205"
            ]
          },
          "722460205": {
            "id": "722460205",
            "speakerId": 1001,
            "speakerName": "阿釜",
            "text": "不，我是怕您受伤。那个司书小姐有着强者的威压感…",
            "nextDialogs": [
              "722460206"
            ]
          },
          "722460206": {
            "id": "722460206",
            "speakerId": 1000,
            "speakerName": "墨田",
            "text": "欸？是吗？我倒觉得是个有些懒散的，典型的魔女…",
            "nextDialogs": [
              "722460207"
            ]
          },
          "722460207": {
            "id": "722460207",
            "speakerId": 1000,
            "speakerName": "墨田",
            "text": "…仔细想想，一般这样的角色才是最强的。不好不好，绝对不能激怒她…",
            "nextDialogs": [
              "722460208"
            ]
          },
          "722460208": {
            "id": "722460208",
            "speakerId": 1000,
            "speakerName": "墨田",
            "text": "啊，对了。有道理。下次就以这样的角色为中心，写一篇作品好了。《大图书馆的魔法师》…",
            "nextDialogs": [
              "722460209"
            ]
          },
          "722460209": {
            "id": "722460209",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "你们的旅行如何了？",
            "nextDialogs": [
              "722460210"
            ]
          },
          "722460210": {
            "id": "722460210",
            "speakerId": 1001,
            "speakerName": "阿釜",
            "text": "好久不见。",
            "nextDialogs": [
              "722460211"
            ]
          },
          "722460211": {
            "id": "722460211",
            "speakerId": 1000,
            "speakerName": "墨田",
            "text": "#欸，是传说中的{NICKNAME}…",
            "nextDialogs": [
              "722460212"
            ]
          },
          "722460212": {
            "id": "722460212",
            "speakerId": 1000,
            "speakerName": "墨田",
            "text": "旅行啊…以前我也常常外出旅行取材。",
            "nextDialogs": [
              "722460213"
            ]
          },
          "722460213": {
            "id": "722460213",
            "speakerId": 1000,
            "speakerName": "墨田",
            "text": "「为了描写雷灾而前往无想刃狭间」、「为了描写蛇妖而去蛇神之首」、「为了描写逐电者的生活而请阿釜参军」…",
            "nextDialogs": [
              "722460214"
            ]
          },
          "722460214": {
            "id": "722460214",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "阿釜真不容易…",
            "nextDialogs": [
              "722460215"
            ]
          },
          "722460215": {
            "id": "722460215",
            "speakerId": 1001,
            "speakerName": "阿釜",
            "text": "没什么大不了的。",
            "nextDialogs": [
              "722460216"
            ]
          },
          "722460216": {
            "id": "722460216",
            "speakerId": 1000,
            "speakerName": "墨田",
            "text": "但是，这次是真正的旅行，漫无目的的远游。",
            "nextDialogs": [
              "722460217"
            ]
          },
          "722460217": {
            "id": "722460217",
            "speakerId": 1000,
            "speakerName": "墨田",
            "text": "我才发现，值得写的、有趣的故事，真是太多了。就像《纪野之旅》一样。",
            "nextDialogs": [
              "722460218"
            ]
          },
          "722460218": {
            "id": "722460218",
            "speakerId": 1000,
            "speakerName": "墨田",
            "text": "我和阿釜一起寻访本地人推荐的景点与店铺。然后，在野外露营时，与陌生的旅人分享篝火与故事…",
            "nextDialogs": [
              "722460219"
            ]
          },
          "722460219": {
            "id": "722460219",
            "speakerId": 1000,
            "speakerName": "墨田",
            "text": "醒来的时候，发现旅资都被偷走了…",
            "nextDialogs": [
              "722460220"
            ]
          },
          "722460220": {
            "id": "722460220",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "…没问题吗？",
            "nextDialogs": [
              "722460221"
            ]
          },
          "722460221": {
            "id": "722460221",
            "speakerId": 1000,
            "speakerName": "墨田",
            "text": "没问题的。找到那些盗贼，发现他们有十几个人的时候，我还以为没办法拿回来了。",
            "nextDialogs": [
              "722460222"
            ]
          },
          "722460222": {
            "id": "722460222",
            "speakerId": 1000,
            "speakerName": "墨田",
            "text": "但阿釜竟然设法说服了他们，把钱全都拿回来了，还附带了很多有乌鸦纹样的纪念币！",
            "nextDialogs": [
              "722460223"
            ]
          },
          "722460223": {
            "id": "722460223",
            "speakerId": 1000,
            "speakerName": "墨田",
            "text": "明明感觉可以写成有趣的情节，但阿釜就是不愿意告诉我过程。",
            "nextDialogs": [
              "722460226"
            ]
          },
          "722460226": {
            "id": "722460226",
            "speakerId": 1001,
            "speakerName": "阿釜",
            "text": "是我应该做的。墨田大人不必挂心。",
            "nextDialogs": [
              "722460227"
            ]
          },
          "722460227": {
            "id": "722460227",
            "speakerId": 1000,
            "speakerName": "墨田",
            "text": "不，阿釜真的很可靠！",
            "nextDialogs": [
              "722460228"
            ]
          },
          "722460228": {
            "id": "722460228",
            "speakerId": 1000,
            "speakerName": "墨田",
            "text": "和你在一起，就算旅行到世界尽头也不会有什么问题吧！",
            "nextDialogs": [
              "722460229"
            ]
          },
          "722460229": {
            "id": "722460229",
            "speakerId": 1000,
            "speakerName": "墨田",
            "text": "而且，总感觉，自从鹤观以来，你变了很多呢。会有想做的事了，也会提出质疑与观点…",
            "nextDialogs": [
              "722460230"
            ]
          },
          "722460230": {
            "id": "722460230",
            "speakerId": 1001,
            "speakerName": "阿釜",
            "text": "如果墨田大人觉得不妥当的话…",
            "nextDialogs": [
              "722460231"
            ]
          },
          "722460231": {
            "id": "722460231",
            "speakerId": 1000,
            "speakerName": "墨田",
            "text": "我觉得很好喔！你的看法，都相当值得参考。"
          }
        }
      }
    },
    {
      "subId": "7224603",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "722460301"
        ],
        "dialogs": {
          "722460301": {
            "id": "722460301",
            "speakerId": 1001,
            "speakerName": "阿釜",
            "text": "墨田大人对之后的目的地，有计划吗？",
            "nextDialogs": [
              "722460302"
            ]
          },
          "722460302": {
            "id": "722460302",
            "speakerId": 1000,
            "speakerName": "墨田",
            "text": "嗯——这么说来，听说蒙德城里有一座很大的图书馆…"
          }
        }
      }
    }
  ]
}
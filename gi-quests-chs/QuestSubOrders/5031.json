  },
  "subQuests": [
    {
      "subId": "503102",
      "subQuestName": "",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "50290701"
        ],
        "dialogs": {
          "50290701": {
            "id": "50290701",
            "speakerId": 6028,
            "speakerName": "帕兰",
            "text": "#英雄大人来到了祝福之路的终点，让我们把掌声与祝福都送给{M#他}{F#她}，要比路上任何一次都要响亮！",
            "nextDialogs": [
              "50290702"
            ]
          },
          "50290702": {
            "id": "50290702",
            "speakerId": 10266,
            "speakerName": "众人",
            "text": "噢噢噢噢——",
            "nextDialogs": [
              "50290703"
            ]
          },
          "50290703": {
            "id": "50290703",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "谢谢大家。",
            "nextDialogs": [
              "50290704"
            ]
          },
          "50290704": {
            "id": "50290704",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "哇，你真的是大英雄了啊。",
            "nextDialogs": [
              "50290705"
            ]
          },
          "50290705": {
            "id": "50290705",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "不过你冒了这么大的险，得到这样的荣誉和嘉奖也是理所应当的。",
            "nextDialogs": [
              "50290706"
            ]
          },
          "50290706": {
            "id": "50290706",
            "speakerId": 1096,
            "speakerName": "茜特菈莉",
            "text": "#{NICKNAME}，派蒙，你们在这里！终于找到你们了！",
            "nextDialogs": [
              "50290707"
            ]
          },
          "50290707": {
            "id": "50290707",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "茜特菈莉！刚刚都没有看见你，你去哪里了啊？",
            "nextDialogs": [
              "50290708"
            ]
          },
          "50290708": {
            "id": "50290708",
            "speakerId": 1096,
            "speakerName": "茜特菈莉",
            "text": "很重要的事！总之，先跟我去一个没人的地方！",
            "nextDialogs": [
              "50290709"
            ]
          },
          "50290709": {
            "id": "50290709",
            "speakerId": 1096,
            "speakerName": "茜特菈莉",
            "text": "在看到你成功归来之后，我马上想要再次确认梦境中的暗示。",
            "nextDialogs": [
              "50290710"
            ]
          },
          "50290710": {
            "id": "50290710",
            "speakerId": 1096,
            "speakerName": "茜特菈莉",
            "text": "但我又不能倒头就睡，必须找个私密一点的场所。谁知道睡着之后我会不会做出怪异的动作，或者说梦话…",
            "nextDialogs": [
              "50290711"
            ]
          },
          "50290711": {
            "id": "50290711",
            "speakerId": 1096,
            "speakerName": "茜特菈莉",
            "text": "哎，这种事不重要！重要的是关于玛薇卡的死，梦中的暗示还是没有变化。",
            "nextDialogs": [
              "50290712"
            ]
          },
          "50290712": {
            "id": "50290712",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "欸——？",
            "nextDialogs": [
              "50290713"
            ]
          },
          "50290713": {
            "id": "50290713",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "我已经和她成功返回了啊？",
            "nextDialogs": [
              "50290714"
            ]
          },
          "50290714": {
            "id": "50290714",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "难、难道说深渊的灾难还没有结束？明明你们已经干掉了罪魁祸首了啊。",
            "nextDialogs": [
              "50290715"
            ]
          },
          "50290715": {
            "id": "50290715",
            "speakerId": 1096,
            "speakerName": "茜特菈莉",
            "text": "没错，灾难已经结束了，可是梦中的暗示非常明确，这也不会出错…",
            "nextDialogs": [
              "50290716"
            ]
          },
          "50290716": {
            "id": "50290716",
            "speakerId": 1096,
            "speakerName": "茜特菈莉",
            "text": "所以我急忙来找你，想知道我们究竟还遗漏了什么。",
            "nextDialogs": [
              "50290717"
            ]
          },
          "50290717": {
            "id": "50290717",
            "speakerId": 1096,
            "speakerName": "茜特菈莉",
            "text": "玛薇卡现在人在哪儿，她说她要去干什么了吗？",
            "nextDialogs": [
              "50290718"
            ]
          },
          "50290718": {
            "id": "50290718",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "我记得她说，要去把夜神之国彻底修好，和对抗深渊相比，修复地脉应该只是收尾工作了吧？",
            "nextDialogs": [
              "50290719"
            ]
          },
          "50290719": {
            "id": "50290719",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "毕竟深渊对地脉的侵蚀也消失了。",
            "nextDialogs": [
              "50290720"
            ]
          },
          "50290720": {
            "id": "50290720",
            "speakerId": 1096,
            "speakerName": "茜特菈莉",
            "text": "不，不太对，虽然是收尾工作，但这件事仍然要依靠夜神的力量，我不确定以她现在的状态可以做到这件事。",
            "nextDialogs": [
              "50290721"
            ]
          },
          "50290721": {
            "id": "50290721",
            "speakerId": 1096,
            "speakerName": "茜特菈莉",
            "text": "还记得吗，夜神说过她很虚弱。即便修复地脉这件事要比重构简单得多，也绝对不是什么小工程。",
            "nextDialogs": [
              "50290724"
            ]
          },
          "50290724": {
            "id": "50290724",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "对啊，要是夜神自己就可以做，那直接把消息告诉她就行了啊。",
            "nextDialogs": [
              "50290725"
            ]
          },
          "50290725": {
            "id": "50290725",
            "speakerId": 1096,
            "speakerName": "茜特菈莉",
            "text": "甚至都不需要，夜神最清楚地脉里发生的情况，你们凯旋的消息她应该早就知道了。",
            "nextDialogs": [
              "50290726"
            ]
          },
          "50290726": {
            "id": "50290726",
            "speakerId": 1096,
            "speakerName": "茜特菈莉",
            "text": "总而言之，这件事绝对没有火神大人嘴上说的那么轻描淡写，我们要赶紧去搞清楚状况。",
            "nextDialogs": [
              "50290727"
            ]
          },
          "50290727": {
            "id": "50290727",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "可她为什么要隐瞒？",
            "nextDialogs": [
              "50290728"
            ]
          },
          "50290728": {
            "id": "50290728",
            "speakerId": 1096,
            "speakerName": "茜特菈莉",
            "text": "我曾经告诉过你，玛薇卡已经知晓并接受了她的死，这不符合她的性格。",
            "nextDialogs": [
              "50290729"
            ]
          },
          "50290729": {
            "id": "50290729",
            "speakerId": 1096,
            "speakerName": "茜特菈莉",
            "text": "唯一可能的例外是，这个「死」具有充足的价值。",
            "nextDialogs": [
              "50290730"
            ]
          },
          "50290730": {
            "id": "50290730",
            "speakerId": 1096,
            "speakerName": "茜特菈莉",
            "text": "在玛薇卡使用了「死之执政」留下来的力量之后，死亡就必须发生。这并不是一种征收，而是要履行所谓的规则。",
            "nextDialogs": [
              "50290731"
            ]
          },
          "50290731": {
            "id": "50290731",
            "speakerId": 1096,
            "speakerName": "茜特菈莉",
            "text": "所以这份死亡并非是献给死之执政的祭品，而是可以用来实现某种效果的道具。",
            "nextDialogs": [
              "50290732"
            ]
          },
          "50290732": {
            "id": "50290732",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "死得其所的意思吗？",
            "nextDialogs": [
              "50290733"
            ]
          },
          "50290733": {
            "id": "50290733",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "那、那我们赶紧出发吧，她现在去哪里了呢？是之前存放「秘源机关」的地方吗？",
            "nextDialogs": [
              "50290734"
            ]
          },
          "50290734": {
            "id": "50290734",
            "speakerId": 1096,
            "speakerName": "茜特菈莉",
            "text": "现在的夜神，应该能在纳塔的任何地方出现，更关键的或许是能够呼唤「死之执政」降临的地方吧。",
            "nextDialogs": [
              "50290735"
            ]
          },
          "50290735": {
            "id": "50290735",
            "speakerId": 1096,
            "speakerName": "茜特菈莉",
            "text": "夜神说，「死之执政」是天理的影子，若无必要，并不会直接现身。纳塔流传上千年的织物中也几乎没有和她有关的记载。"
          }
        }
      }
    },
    {
      "subId": "503104",
      "subQuestName": "",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "50290901"
        ],
        "dialogs": {
          "50290901": {
            "id": "50290901",
            "speakerId": 14520,
            "speakerName": "若娜瓦",
            "text": "漫长的等待已经让我心生厌倦，此地会迎来怎样的结果，我毫无兴趣。",
            "nextDialogs": [
              "50290902"
            ]
          },
          "50290902": {
            "id": "50290902",
            "speakerId": 14520,
            "speakerName": "若娜瓦",
            "text": "但你们人类没有辜负天理的期望…从结果上说，值得褒奖。",
            "nextDialogs": [
              "50290903"
            ]
          },
          "50290903": {
            "id": "50290903",
            "speakerId": 14520,
            "speakerName": "若娜瓦",
            "text": "玛薇卡，我将在此见证你的死亡，作为使用我的力量的代价。",
            "nextDialogs": [
              "50290904"
            ]
          },
          "50290904": {
            "id": "50290904",
            "speakerId": 14520,
            "speakerName": "若娜瓦",
            "text": "延续千年的战争，也算是画上了句号。",
            "nextDialogs": [
              "50290905"
            ]
          },
          "50290905": {
            "id": "50290905",
            "speakerId": 1096,
            "speakerName": "茜特菈莉",
            "text": "玛薇卡！",
            "nextDialogs": [
              "50290906"
            ]
          },
          "50290906": {
            "id": "50290906",
            "speakerId": 1089,
            "speakerName": "玛薇卡",
            "text": "嗯，是你们。你们来得比我想象中要快。",
            "nextDialogs": [
              "50290907"
            ]
          },
          "50290907": {
            "id": "50290907",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "你、你要干什么！",
            "nextDialogs": [
              "50290908"
            ]
          },
          "50290908": {
            "id": "50290908",
            "speakerId": 1089,
            "speakerName": "玛薇卡",
            "text": "当然是为这贯穿五百年…哦，不，应该是贯穿整个纳塔历史的大计划，做最后的收尾。",
            "nextDialogs": [
              "50290909"
            ]
          },
          "50290909": {
            "id": "50290909",
            "speakerId": 1089,
            "speakerName": "玛薇卡",
            "text": "虽然深渊已经被清除，但它的力量依然存在于提瓦特之外，无比强大，无穷无尽。",
            "nextDialogs": [
              "50290910"
            ]
          },
          "50290910": {
            "id": "50290910",
            "speakerId": 1089,
            "speakerName": "玛薇卡",
            "text": "只有完全修复的夜神之国，能够长久地抵御这种力量的侵蚀…",
            "nextDialogs": [
              "50290911"
            ]
          },
          "50290911": {
            "id": "50290911",
            "speakerId": 1089,
            "speakerName": "玛薇卡",
            "text": "但夜神之国的构建者，她的生命即将走到尽头，已经无力进行修复。",
            "nextDialogs": [
              "50290912"
            ]
          },
          "50290912": {
            "id": "50290912",
            "speakerId": 1089,
            "speakerName": "玛薇卡",
            "text": "别说修复了，当夜神的生命耗尽的那一刻，纳塔的规则也会随之消亡。",
            "nextDialogs": [
              "50290913"
            ]
          },
          "50290913": {
            "id": "50290913",
            "speakerId": 1089,
            "speakerName": "玛薇卡",
            "text": "现在的纳塔暂时不需要「还魂诗」了，但长久来看，若深渊再一次袭来，「还魂诗」依然是守护这片土地最强而有力的武器。",
            "nextDialogs": [
              "50290914"
            ]
          },
          "50290914": {
            "id": "50290914",
            "speakerId": 1096,
            "speakerName": "茜特菈莉",
            "text": "为此，你是打算…",
            "nextDialogs": [
              "50290915"
            ]
          },
          "50290915": {
            "id": "50290915",
            "speakerId": 1089,
            "speakerName": "玛薇卡",
            "text": "嗯，我打算再度将我的生命融入圣火。",
            "nextDialogs": [
              "50290916"
            ]
          },
          "50290916": {
            "id": "50290916",
            "speakerId": 1089,
            "speakerName": "玛薇卡",
            "text": "五百年前，我就这样做了一次，让我能够在这个时代重新诞生。",
            "nextDialogs": [
              "50290917"
            ]
          },
          "50290917": {
            "id": "50290917",
            "speakerId": 1089,
            "speakerName": "玛薇卡",
            "text": "此时此刻，我已经利用我的生命完成了所有计划，是时候将它交出去，用以维系夜神的生命。",
            "nextDialogs": [
              "50290918"
            ]
          },
          "50290918": {
            "id": "50290918",
            "speakerId": 14383,
            "speakerName": "夜神",
            "text": "我尊重你的决定，玛薇卡，但这种方式需要巨大的牺牲。",
            "nextDialogs": [
              "50290919"
            ]
          },
          "50290919": {
            "id": "50290919",
            "speakerId": 14383,
            "speakerName": "夜神",
            "text": "你的生命之火很强大，但由火焰维系的生命总有燃尽的一天，未来又如何是好。",
            "nextDialogs": [
              "50290920"
            ]
          },
          "50290920": {
            "id": "50290920",
            "speakerId": 1089,
            "speakerName": "玛薇卡",
            "text": "嗯，我考虑过这件事，深渊的威胁暂时消失，圣火的消耗不会像之前那样剧烈，由我便可维系两三百年的时间。",
            "nextDialogs": [
              "50290921"
            ]
          },
          "50290921": {
            "id": "50290921",
            "speakerId": 1089,
            "speakerName": "玛薇卡",
            "text": "继任的火神将会寻找新的火源，只要纳塔的传承不灭，夜神之国就能永远延续下去，深渊将再无可乘之机。",
            "nextDialogs": [
              "50290922"
            ]
          },
          "50290922": {
            "id": "50290922",
            "speakerId": 14520,
            "speakerName": "若娜瓦",
            "text": "又将希望托付给未来吗…",
            "nextDialogs": [
              "50290923"
            ]
          },
          "50290923": {
            "id": "50290923",
            "speakerId": 1096,
            "speakerName": "茜特菈莉",
            "text": "等下，「归火圣夜巡礼」就可以补充圣火的力量啊，为什么不能赋予「归火圣夜巡礼」新的意义，而要由你独自承受这件事呢？",
            "nextDialogs": [
              "50290924"
            ]
          },
          "50290924": {
            "id": "50290924",
            "speakerId": 1089,
            "speakerName": "玛薇卡",
            "text": "因为我的愿望，就是要修正它。",
            "nextDialogs": [
              "50290925"
            ]
          },
          "50290925": {
            "id": "50290925",
            "speakerId": 1089,
            "speakerName": "玛薇卡",
            "text": "「归火圣夜巡礼」曾是对抗深渊不可缺少的关键一环，它是伟大而充满荣耀的比赛，但换种说法，也是纳塔所有人的枷锁。",
            "nextDialogs": [
              "50290926"
            ]
          },
          "50290926": {
            "id": "50290926",
            "speakerId": 1089,
            "speakerName": "玛薇卡",
            "text": "我们生活在对深渊的恐惧和未来的隐忧之下，如果不拿起武器，可能就会招致严重的后果，或是道德的谴责。",
            "nextDialogs": [
              "50290927"
            ]
          },
          "50290927": {
            "id": "50290927",
            "speakerId": 1089,
            "speakerName": "玛薇卡",
            "text": "——这让纳塔成为了「战争」的国度。",
            "nextDialogs": [
              "50290928"
            ]
          },
          "50290928": {
            "id": "50290928",
            "speakerId": 1089,
            "speakerName": "玛薇卡",
            "text": "希巴拉克曾在此地战胜了龙，赐予人类肉体的解放，而现在最好的机会又一次到来，纳塔人将获得精神的解放。",
            "nextDialogs": [
              "50290929"
            ]
          },
          "50290929": {
            "id": "50290929",
            "speakerId": 1089,
            "speakerName": "玛薇卡",
            "text": "「战争」将成为单纯的「竞技」，不再是对灾难的抵抗，而是对未来的畅想。",
            "nextDialogs": [
              "50290930"
            ]
          },
          "50290930": {
            "id": "50290930",
            "speakerId": 1089,
            "speakerName": "玛薇卡",
            "text": "既然我们已经创造了新的未来，就该让这个未来拥有新的意义，而并非原地踏步。",
            "nextDialogs": [
              "50290931"
            ]
          },
          "50290931": {
            "id": "50290931",
            "speakerId": 1096,
            "speakerName": "茜特菈莉",
            "text": "……",
            "nextDialogs": [
              "50290932"
            ]
          },
          "50290932": {
            "id": "50290932",
            "speakerId": 14383,
            "speakerName": "夜神",
            "text": "你很伟大，玛薇卡。但是，有关你个人的事呢？我听不到「你」的愿望。",
            "nextDialogs": [
              "50290933"
            ]
          },
          "50290933": {
            "id": "50290933",
            "speakerId": 14383,
            "speakerName": "夜神",
            "text": "你也是纳塔的万千子民之一，在我眼中你也没有那么特殊。",
            "nextDialogs": [
              "50290934"
            ]
          },
          "50290934": {
            "id": "50290934",
            "speakerId": 14383,
            "speakerName": "夜神",
            "text": "虽说事态紧急，修复地脉刻不容缓，但由你独自背负这份责任，实在太沉重了。",
            "nextDialogs": [
              "50290935"
            ]
          },
          "50290935": {
            "id": "50290935",
            "speakerId": 1089,
            "speakerName": "玛薇卡",
            "text": "这就是你我的不同了，你将所有人类一视同仁，而我深知「领袖」的含义。",
            "nextDialogs": [
              "50290936"
            ]
          },
          "50290936": {
            "id": "50290936",
            "speakerId": 1089,
            "speakerName": "玛薇卡",
            "text": "「领袖」就应该洞见事实的真相，并迅速做出「最合适」的判断。",
            "nextDialogs": [
              "50290937"
            ]
          },
          "50290937": {
            "id": "50290937",
            "speakerId": 1089,
            "speakerName": "玛薇卡",
            "text": "更多的时候，并不是选出更好的那一种，而是选出不那么坏的一种。",
            "nextDialogs": [
              "50290938"
            ]
          },
          "50290938": {
            "id": "50290938",
            "speakerId": 1089,
            "speakerName": "玛薇卡",
            "text": "——献出我剩余的生命，渡过眼前的危机，就是我认为「最合适」的选择。",
            "nextDialogs": [
              "50290939"
            ]
          },
          "50290939": {
            "id": "50290939",
            "speakerId": 1089,
            "speakerName": "玛薇卡",
            "text": "毕竟，「领袖」是在普通人的信任基础上诞生的概念，无人之地，亦无「领袖」。",
            "nextDialogs": [
              "50290940"
            ]
          },
          "50290940": {
            "id": "50290940",
            "speakerId": 1089,
            "speakerName": "玛薇卡",
            "text": "人们会信任「领袖」，是因为他们相信这个人能让世界变得更好，能在关键的时刻挺身而出。",
            "nextDialogs": [
              "50290941"
            ]
          },
          "50290941": {
            "id": "50290941",
            "speakerId": 1089,
            "speakerName": "玛薇卡",
            "text": "我当然要践行这份职责，直到最后一刻。",
            "nextDialogs": [
              "50290942"
            ]
          },
          "50290942": {
            "id": "50290942",
            "speakerId": 1096,
            "speakerName": "茜特菈莉",
            "text": "你还是没有讨论你自己的事…",
            "nextDialogs": [
              "50290943"
            ]
          },
          "50290943": {
            "id": "50290943",
            "speakerId": 1096,
            "speakerName": "茜特菈莉",
            "text": "是因为你觉得根本就不重要吗？",
            "nextDialogs": [
              "50290944"
            ]
          },
          "50290944": {
            "id": "50290944",
            "speakerId": 1089,
            "speakerName": "玛薇卡",
            "text": "是啊，根本就不重要。",
            "nextDialogs": [
              "50290945"
            ]
          },
          "50290945": {
            "id": "50290945",
            "speakerId": 1089,
            "speakerName": "玛薇卡",
            "text": "有什么比我们携手创造的未来更加重要的呢？",
            "nextDialogs": [
              "50290946"
            ]
          },
          "50290946": {
            "id": "50290946",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "（她的话确实无法反驳，可能她连我们会赶来都预料到了，才准备了这样的话。）",
            "nextDialogs": [
              "50290947"
            ]
          },
          "50290947": {
            "id": "50290947",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "（纳塔确实应该走进新的时代，她想做出符合「领袖」身份的表率，但…）",
            "nextDialogs": [
              "50290948"
            ]
          },
          "50290948": {
            "id": "50290948",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "（「我们携手创造的未来」，同样应该有她的位置啊…）",
            "nextDialogs": [
              "50290949"
            ]
          },
          "50290949": {
            "id": "50290949",
            "speakerId": 14520,
            "speakerName": "若娜瓦",
            "text": "玛薇卡即将把生命献给夜神，这算作玛薇卡的死亡，我会全程见证这个过程。",
            "nextDialogs": [
              "50290950"
            ]
          },
          "50290950": {
            "id": "50290950",
            "speakerId": 14520,
            "speakerName": "若娜瓦",
            "text": "我和希巴拉克几千年前定下的交易，也就在此刻完成了。",
            "nextDialogs": [
              "50290951"
            ]
          },
          "50290951": {
            "id": "50290951",
            "speakerId": 14520,
            "speakerName": "若娜瓦",
            "text": "可以开始了，夜神。",
            "nextDialogs": [
              "50290952"
            ]
          },
          "50290952": {
            "id": "50290952",
            "speakerId": 14383,
            "speakerName": "夜神",
            "text": "……",
            "nextDialogs": [
              "50290953"
            ]
          },
          "50290953": {
            "id": "50290953",
            "speakerId": 14520,
            "speakerName": "若娜瓦",
            "text": "你还在等什么？",
            "nextDialogs": [
              "50290954"
            ]
          },
          "50290954": {
            "id": "50290954",
            "speakerId": 14383,
            "speakerName": "夜神",
            "text": "想要参与这场仪式的人还没有到齐，我不能不尊重另一人的意见。",
            "nextDialogs": [
              "50290955"
            ]
          },
          "50290955": {
            "id": "50290955",
            "speakerId": 1089,
            "speakerName": "玛薇卡",
            "text": "另一人…？",
            "nextDialogs": [
              "50290956"
            ]
          },
          "50290956": {
            "id": "50290956",
            "speakerId": 14520,
            "speakerName": "若娜瓦",
            "text": "唉，不过是简单的「见证代价」，却频生变数。",
            "nextDialogs": [
              "50290957"
            ]
          },
          "50290957": {
            "id": "50290957",
            "speakerId": 14520,
            "speakerName": "若娜瓦",
            "text": "如果来者的「生命」不足以满足要求，我恐怕就要失去耐心了。",
            "nextDialogs": [
              "50290958"
            ]
          },
          "50290958": {
            "id": "50290958",
            "speakerId": 14383,
            "speakerName": "夜神",
            "text": "我保证，他同样拥有足够的价值。我是人类的协助者，无论何时，我都要把人类的诉求放在第一位，无论那个人是谁。",
            "nextDialogs": [
              "50290959"
            ]
          },
          "50290959": {
            "id": "50290959",
            "speakerId": 14520,
            "speakerName": "若娜瓦",
            "text": "好吧，真是死板，但也没办法，这就是天使与生俱来的使命。",
            "nextDialogs": [
              "50290960"
            ]
          },
          "50290960": {
            "id": "50290960",
            "speakerId": 1096,
            "speakerName": "茜特菈莉",
            "text": "等下，这种感觉，难道是…",
            "nextDialogs": [
              "50290961"
            ]
          },
          "50290961": {
            "id": "50290961",
            "speakerId": 1094,
            "speakerName": "欧洛伦",
            "text": "哈啊，哈啊…到了，我们赶上了。",
            "nextDialogs": [
              "50290962"
            ]
          },
          "50290962": {
            "id": "50290962",
            "speakerId": 14235,
            "speakerName": "「队长」",
            "text": "谢谢你引路。",
            "nextDialogs": [
              "50290963"
            ]
          },
          "50290963": {
            "id": "50290963",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "「队长」？！",
            "nextDialogs": [
              "50290964"
            ]
          },
          "50290964": {
            "id": "50290964",
            "speakerId": 1089,
            "speakerName": "玛薇卡",
            "text": "你所说的另一人，难道是他？",
            "nextDialogs": [
              "50290965"
            ]
          },
          "50290965": {
            "id": "50290965",
            "speakerId": 14383,
            "speakerName": "夜神",
            "text": "正是，他和你相似，都怀揣崇高的理想。",
            "nextDialogs": [
              "50290966"
            ]
          },
          "50290966": {
            "id": "50290966",
            "speakerId": 14235,
            "speakerName": "「队长」",
            "text": "玛薇卡，我理解你的想法，如果我只是一个普通人，我也没有阻止你的理由。",
            "nextDialogs": [
              "50290967"
            ]
          },
          "50290967": {
            "id": "50290967",
            "speakerId": 14235,
            "speakerName": "「队长」",
            "text": "可是我和你一样，都等了这一天太久，现在我们拥有更好的解决方法。",
            "nextDialogs": [
              "50290968"
            ]
          },
          "50290968": {
            "id": "50290968",
            "speakerId": 14235,
            "speakerName": "「队长」",
            "text": "这是你开创的未来，它要走向何方，还需要你去引导和定义，你的生命不该绝于此处。",
            "nextDialogs": [
              "50290969"
            ]
          },
          "50290969": {
            "id": "50290969",
            "speakerId": 14235,
            "speakerName": "「队长」",
            "text": "而「死亡」就是我想要抵达的终点，我一路走来，就是希望以我的「死亡」，为他们叩开地脉的大门。",
            "nextDialogs": [
              "50290970"
            ]
          },
          "50290970": {
            "id": "50290970",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "他、他们…？",
            "nextDialogs": [
              "50290971"
            ]
          },
          "50290971": {
            "id": "50290971",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "难道是我在梦里看到的灵魂？",
            "nextDialogs": [
              "50290972"
            ]
          },
          "50290972": {
            "id": "50290972",
            "speakerId": 14235,
            "speakerName": "「队长」",
            "text": "没错，五百年以来，他们都在我的身上。",
            "nextDialogs": [
              "50290973"
            ]
          },
          "50290973": {
            "id": "50290973",
            "speakerId": 1094,
            "speakerName": "欧洛伦",
            "text": "这怎么可能，人类身体里如果容纳那么多灵魂，意识早就四分五裂了…",
            "nextDialogs": [
              "50290974"
            ]
          },
          "50290974": {
            "id": "50290974",
            "speakerId": 1094,
            "speakerName": "欧洛伦",
            "text": "而且，在「秘源机关」那里的时候，你也没像我一样受到影响啊。",
            "nextDialogs": [
              "50290975"
            ]
          },
          "50290975": {
            "id": "50290975",
            "speakerId": 14235,
            "speakerName": "「队长」",
            "text": "还记得你曾经听到的声音吗？",
            "nextDialogs": [
              "50290976"
            ]
          },
          "50290976": {
            "id": "50290976",
            "speakerId": 14235,
            "speakerName": "「队长」",
            "text": "那来源于我的心脏，它经由坎瑞亚技术改造而成，可以将地脉中的记忆与灵魂转化为知识。",
            "nextDialogs": [
              "50290977"
            ]
          },
          "50290977": {
            "id": "50290977",
            "speakerId": 14235,
            "speakerName": "「队长」",
            "text": "但副作用就是我变得和你一样，对灵魂很敏感，能够意识到周围灵魂的存在…",
            "nextDialogs": [
              "50290978"
            ]
          },
          "50290978": {
            "id": "50290978",
            "speakerId": 14235,
            "speakerName": "「队长」",
            "text": "后来，在五百年前的灾难中，无家可归的灵魂实在太多，所以我放弃了心脏的学习功能，将它当作了容器。",
            "nextDialogs": [
              "50290979"
            ]
          },
          "50290979": {
            "id": "50290979",
            "speakerId": 14235,
            "speakerName": "「队长」",
            "text": "我的战友，还有许许多多纳塔人的「生命」，都在这里。",
            "nextDialogs": [
              "50290980"
            ]
          },
          "50290980": {
            "id": "50290980",
            "speakerId": 1089,
            "speakerName": "玛薇卡",
            "text": "你想把他们…送回去？",
            "nextDialogs": [
              "50290981"
            ]
          },
          "50290981": {
            "id": "50290981",
            "speakerId": 14235,
            "speakerName": "「队长」",
            "text": "没错，地脉无法接纳他们。但如果我成为地脉的主人，和夜神融为一体，然后修改这一切的规则呢？",
            "nextDialogs": [
              "50290982"
            ]
          },
          "50290982": {
            "id": "50290982",
            "speakerId": 14383,
            "speakerName": "夜神",
            "text": "他表达了这种意志，而我给出了肯定的答复。",
            "nextDialogs": [
              "50290983"
            ]
          },
          "50290983": {
            "id": "50290983",
            "speakerId": 14383,
            "speakerName": "夜神",
            "text": "这样的规则对人类更加友善和公平。此外，「队长」还有另一个目的…挑战「死之执政」的权威，或者说，「复仇」。",
            "nextDialogs": [
              "50290984"
            ]
          },
          "50290984": {
            "id": "50290984",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "复、复仇？",
            "nextDialogs": [
              "50290985"
            ]
          },
          "50290985": {
            "id": "50290985",
            "speakerId": 14235,
            "speakerName": "「队长」",
            "text": "多亏了这位死之执政的力量，我拥有「不死诅咒」，也就是绝对的生命。",
            "nextDialogs": [
              "50290986"
            ]
          },
          "50290986": {
            "id": "50290986",
            "speakerId": 14520,
            "speakerName": "若娜瓦",
            "text": "我知道你的用意了…",
            "nextDialogs": [
              "50290987"
            ]
          },
          "50290987": {
            "id": "50290987",
            "speakerId": 14235,
            "speakerName": "「队长」",
            "text": "你能感受到我的决心与恨意吗？",
            "nextDialogs": [
              "50290988"
            ]
          },
          "50290988": {
            "id": "50290988",
            "speakerId": 14235,
            "speakerName": "「队长」",
            "text": "坎瑞亚人犯了重罪，这种诅咒的目的在于让我们亲眼见证所爱之物的消亡，以及经受肉体的无尽折磨。",
            "nextDialogs": [
              "50290989"
            ]
          },
          "50290989": {
            "id": "50290989",
            "speakerId": 14235,
            "speakerName": "「队长」",
            "text": "可是有更多人是无辜的，大家对于五大罪人利用深渊力量这件事毫不知情，我也是其中之一。",
            "nextDialogs": [
              "50290990"
            ]
          },
          "50290990": {
            "id": "50290990",
            "speakerId": 14235,
            "speakerName": "「队长」",
            "text": "当我把生命献给夜神，你就见证了死亡的发生，但死亡又会被你的「不死诅咒」撤销…",
            "nextDialogs": [
              "50290991"
            ]
          },
          "50290991": {
            "id": "50290991",
            "speakerId": 14235,
            "speakerName": "「队长」",
            "text": "如果不解决这个悖论，它甚至可能动摇这个世界的「理」之根基…就算是崇高的「死之执政」，也无法承担这种后果。",
            "nextDialogs": [
              "50290992"
            ]
          },
          "50290992": {
            "id": "50290992",
            "speakerId": 14235,
            "speakerName": "「队长」",
            "text": "你的诅咒，现在就是我逆转人神之位的力量，也是我对你下达的战书。",
            "nextDialogs": [
              "50290993"
            ]
          },
          "50290993": {
            "id": "50290993",
            "speakerId": 14235,
            "speakerName": "「队长」",
            "text": "你必须放弃一个，做出选择吧。"
          }
        }
      }
    },
    {
      "subId": "503105",
      "subQuestName": "",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "50291001"
        ],
        "dialogs": {
          "50291001": {
            "id": "50291001",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "「队长」他…",
            "nextDialogs": [
              "50291002"
            ]
          },
          "50291002": {
            "id": "50291002",
            "speakerId": 1094,
            "speakerName": "欧洛伦",
            "text": "不死诅咒依然存在，也就是说…他会永远坐在这里？",
            "nextDialogs": [
              "50291003"
            ]
          },
          "50291003": {
            "id": "50291003",
            "speakerId": 1089,
            "speakerName": "玛薇卡",
            "text": "夜神，「队长」还在吗？",
            "nextDialogs": [
              "50291004"
            ]
          },
          "50291004": {
            "id": "50291004",
            "speakerId": 14383,
            "speakerName": "夜神",
            "text": "无须再追逐他的踪迹，对于不死之人来说，摆脱尘世便是最大的安宁。",
            "nextDialogs": [
              "50291005"
            ]
          },
          "50291005": {
            "id": "50291005",
            "speakerId": 1089,
            "speakerName": "玛薇卡",
            "text": "即便如此，还请转达我最真挚的谢意。",
            "nextDialogs": [
              "50291006"
            ]
          },
          "50291006": {
            "id": "50291006",
            "speakerId": 1089,
            "speakerName": "玛薇卡",
            "text": "漫长的旅途终于走到终点，对他来说，这种结局应该是圆满的吧。",
            "nextDialogs": [
              "50291007"
            ]
          },
          "50291007": {
            "id": "50291007",
            "speakerId": 1089,
            "speakerName": "玛薇卡",
            "text": "我难以想象五百年间他究竟经受了多少煎熬，又是以如何强大的意志力才坚守住了心中的目标。",
            "nextDialogs": [
              "50291008"
            ]
          },
          "50291008": {
            "id": "50291008",
            "speakerId": 1094,
            "speakerName": "欧洛伦",
            "text": "我有个无论如何都想知道的事…在我的记忆中，我似乎从来没见过「队长」睡觉。",
            "nextDialogs": [
              "50291009"
            ]
          },
          "50291009": {
            "id": "50291009",
            "speakerId": 1094,
            "speakerName": "欧洛伦",
            "text": "在来的路上，我数次追问，他也不肯告诉我是为什么…还是老样子，涉及个人的事，他都一概不提。",
            "nextDialogs": [
              "50291010"
            ]
          },
          "50291010": {
            "id": "50291010",
            "speakerId": 14383,
            "speakerName": "夜神",
            "text": "因为难以入眠吧。",
            "nextDialogs": [
              "50291011"
            ]
          },
          "50291011": {
            "id": "50291011",
            "speakerId": 14383,
            "speakerName": "夜神",
            "text": "灵魂相融之后，其他灵魂的声音就会在脑海中回响，一刻不停。",
            "nextDialogs": [
              "50291012"
            ]
          },
          "50291012": {
            "id": "50291012",
            "speakerId": 14383,
            "speakerName": "夜神",
            "text": "保持生命最后记忆的灵魂会不停地惨叫，哀嚎，发出绝望的呼喊…更别说他容纳的灵魂数量有如此之多。",
            "nextDialogs": [
              "50291013"
            ]
          },
          "50291013": {
            "id": "50291013",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "五百年…都、都没睡过觉？",
            "nextDialogs": [
              "50291016"
            ]
          },
          "50291016": {
            "id": "50291016",
            "speakerId": 1096,
            "speakerName": "茜特菈莉",
            "text": "若非亲历者，一定无法体会「不死诅咒」给他带去多少折磨。",
            "nextDialogs": [
              "50291017"
            ]
          },
          "50291017": {
            "id": "50291017",
            "speakerId": 1096,
            "speakerName": "茜特菈莉",
            "text": "所以他对死之执政的恨才如此强烈吧。",
            "nextDialogs": [
              "50291018"
            ]
          },
          "50291018": {
            "id": "50291018",
            "speakerId": 1096,
            "speakerName": "茜特菈莉",
            "text": "但在最后，借由和夜神合二为一的做法，夜神也获得了永恒的生命…",
            "nextDialogs": [
              "50291019"
            ]
          },
          "50291019": {
            "id": "50291019",
            "speakerId": 1096,
            "speakerName": "茜特菈莉",
            "text": "这一仗，他打得真漂亮啊。",
            "nextDialogs": [
              "50291020"
            ]
          },
          "50291020": {
            "id": "50291020",
            "speakerId": 14383,
            "speakerName": "夜神",
            "text": "你们可能会想，夜神之国到处都是灵魂，为何地面上流散的灵魂难以被接纳…",
            "nextDialogs": [
              "50291021"
            ]
          },
          "50291021": {
            "id": "50291021",
            "speakerId": 14383,
            "speakerName": "夜神",
            "text": "因为天理当初改造地脉的目的，就是为了对抗深渊，所以它的稳定性至关重要。",
            "nextDialogs": [
              "50291022"
            ]
          },
          "50291022": {
            "id": "50291022",
            "speakerId": 14383,
            "speakerName": "夜神",
            "text": "然而纳塔的地脉曾经毁坏过一次，夜神之国重建之后，因为要创造「还魂诗」的规则，也没有重新与其他国家连通。",
            "nextDialogs": [
              "50291023"
            ]
          },
          "50291023": {
            "id": "50291023",
            "speakerId": 14383,
            "speakerName": "夜神",
            "text": "这个特殊性，就让「队长」看到了机会。",
            "nextDialogs": [
              "50291024"
            ]
          },
          "50291024": {
            "id": "50291024",
            "speakerId": 1089,
            "speakerName": "玛薇卡",
            "text": "他之前去其他国家尝试过？",
            "nextDialogs": [
              "50291025"
            ]
          },
          "50291025": {
            "id": "50291025",
            "speakerId": 14383,
            "speakerName": "夜神",
            "text": "没错，但无一例外都失败了。",
            "nextDialogs": [
              "50291026"
            ]
          },
          "50291026": {
            "id": "50291026",
            "speakerId": 14383,
            "speakerName": "夜神",
            "text": "他想要拯救纳塔，除了想要从深渊威胁中挽救尽可能多的人，也是因为只有这里可能给体内的灵魂一个安息之处。",
            "nextDialogs": [
              "50291027"
            ]
          },
          "50291027": {
            "id": "50291027",
            "speakerId": 14383,
            "speakerName": "夜神",
            "text": "不久之前，他和我进行了一次「商谈」，确认了计划的可行性。",
            "nextDialogs": [
              "50291028"
            ]
          },
          "50291028": {
            "id": "50291028",
            "speakerId": 14383,
            "speakerName": "夜神",
            "text": "我确实认为，改变地脉的规则有它的价值——纳塔有太多的灵魂无家可归，未来也可能有外来者在此地离逝…",
            "nextDialogs": [
              "50291029"
            ]
          },
          "50291029": {
            "id": "50291029",
            "speakerId": 14383,
            "speakerName": "夜神",
            "text": "在天理看来，这种改变的风险很高，或许难以容忍…但我是「天使」，我只是履行了为人类着想的使命而已。",
            "nextDialogs": [
              "50291030"
            ]
          },
          "50291030": {
            "id": "50291030",
            "speakerId": 1096,
            "speakerName": "茜特菈莉",
            "text": "感谢你为我们做了这么多。",
            "nextDialogs": [
              "50291031"
            ]
          },
          "50291031": {
            "id": "50291031",
            "speakerId": 14383,
            "speakerName": "夜神",
            "text": "茜特菈莉。还记得我把「圣夜旅织」给你和希诺宁的时候，对你说了些扫兴的话吗？",
            "nextDialogs": [
              "50291032"
            ]
          },
          "50291032": {
            "id": "50291032",
            "speakerId": 14383,
            "speakerName": "夜神",
            "text": "活下去是活多久呢，在我的眼中，十年或者一百年都是没有分别的。",
            "nextDialogs": [
              "50291033"
            ]
          },
          "50291033": {
            "id": "50291033",
            "speakerId": 14383,
            "speakerName": "夜神",
            "text": "但现在的我，会永远活下去——我十分感谢来自人类的馈赠，也为我的轻视而道歉。",
            "nextDialogs": [
              "50291034"
            ]
          },
          "50291034": {
            "id": "50291034",
            "speakerId": 1096,
            "speakerName": "茜特菈莉",
            "text": "不必这样说，对你来说这也是很沉重的责任。",
            "nextDialogs": [
              "50291035"
            ]
          },
          "50291035": {
            "id": "50291035",
            "speakerId": 14383,
            "speakerName": "夜神",
            "text": "沉重？并不会，我就是为此而生的。",
            "nextDialogs": [
              "50291036"
            ]
          },
          "50291036": {
            "id": "50291036",
            "speakerId": 14383,
            "speakerName": "夜神",
            "text": "再见了，创造奇迹的人类，新的时代在等着你们。",
            "nextDialogs": [
              "50291037"
            ]
          },
          "50291037": {
            "id": "50291037",
            "speakerId": 1096,
            "speakerName": "茜特菈莉",
            "text": "她也消失了，应该是回夜神之国了吧。",
            "nextDialogs": [
              "50291038"
            ]
          },
          "50291038": {
            "id": "50291038",
            "speakerId": 1094,
            "speakerName": "欧洛伦",
            "text": "「队长」最后的目的竟然是这件事…",
            "nextDialogs": [
              "50291039"
            ]
          },
          "50291039": {
            "id": "50291039",
            "speakerId": 1094,
            "speakerName": "欧洛伦",
            "text": "为了一群逝去的灵魂，战斗到最后，甚至撼动了世界的法则。",
            "nextDialogs": [
              "50291040"
            ]
          },
          "50291040": {
            "id": "50291040",
            "speakerId": 1089,
            "speakerName": "玛薇卡",
            "text": "他是一位了不起的战士。",
            "nextDialogs": [
              "50291041"
            ]
          },
          "50291041": {
            "id": "50291041",
            "speakerId": 1089,
            "speakerName": "玛薇卡",
            "text": "他做了本该是由我去做的事，还比我的原计划带来了更好的结果…这场对决，看来是我输了。",
            "nextDialogs": [
              "50291042"
            ]
          },
          "50291042": {
            "id": "50291042",
            "speakerId": 1089,
            "speakerName": "玛薇卡",
            "text": "他说的没错。战争之后的纳塔该走向何处，原本这是我想交给下一任火神思考的问题，现在看来，就由我继续来做吧。",
            "nextDialogs": [
              "50291043"
            ]
          },
          "50291043": {
            "id": "50291043",
            "speakerId": 1089,
            "speakerName": "玛薇卡",
            "text": "但在那之前，我想再次向英雄致以敬意。",
            "nextDialogs": [
              "50291044"
            ]
          },
          "50291044": {
            "id": "50291044",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "……",
            "nextDialogs": [
              "50291045"
            ]
          },
          "50291045": {
            "id": "50291045",
            "speakerId": 1096,
            "speakerName": "茜特菈莉",
            "text": "……",
            "nextDialogs": [
              "50291046"
            ]
          },
          "50291046": {
            "id": "50291046",
            "speakerId": 1094,
            "speakerName": "欧洛伦",
            "text": "……",
            "nextDialogs": [
              "50291047"
            ]
          },
          "50291047": {
            "id": "50291047",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "……"
          }
        }
      }
    },

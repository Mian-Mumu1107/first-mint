{
  "lineCounts": {
    "Player": 16,
    "「队长」": 20,
    "众人": 1,
    "夜神": 29,
    "希涅琪娅": 1,
    "帕兰": 1,
    "库阿勒": 1,
    "欧洛伦": 9,
    "派蒙": 18,
    "玛拉妮": 1,
    "玛薇卡": 40,
    "若娜瓦": 13,

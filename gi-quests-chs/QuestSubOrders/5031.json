            "speakerName": "希涅琪娅",
            "text": "太阳照亮了大地——",
            "nextDialogs": [
              "50299916"
            ]
          },
          "50299916": {
            "id": "50299916",
            "speakerId": 1087,
            "speakerName": "玛拉妮",
            "text": "纳塔又获得了胜利！",
            "nextDialogs": [
              "50299918"
            ]
          },
          "50299918": {
            "id": "50299918",
            "speakerId": 14766,
            "speakerName": "雅塔",
            "text": "这边也有很多人在等你！",
            "nextDialogs": [
              "50299919"
            ]
          },
          "50299919": {

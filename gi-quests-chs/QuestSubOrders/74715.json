{
  "lineCounts": {
    "Player": 2,
    "派蒙": 7,
    "菲米尼": 15
  },
  "subQuests": [
    {
      "subId": "7471501",
      "subQuestName": "与菲米尼对话",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "747150101"
        ],
        "dialogs": {
          "747150101": {
            "id": "747150101",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "菲米尼，你怎么看起来那么疲惫？是这阵子打捞得太累了吗？",
            "nextDialogs": [
              "747150102"
            ]
          },
          "747150102": {
            "id": "747150102",
            "speakerId": 1074,
            "speakerName": "菲米尼",
            "text": "唔…",
            "nextDialogs": [
              "747150103"
            ]
          },
          "747150103": {
            "id": "747150103",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "也不要躲进潜水头盔里啦！我们都是好朋友，比起憋进心里，说出来会更好哦。",
            "nextDialogs": [
              "747150104"
            ]
          },
          "747150104": {
            "id": "747150104",
            "speakerId": 1074,
            "speakerName": "菲米尼",
            "text": "…嗯，我知道了。",
            "nextDialogs": [
              "747150105"
            ]
          },
          "747150105": {
            "id": "747150105",
            "speakerId": 1074,
            "speakerName": "菲米尼",
            "text": "刚才下水打捞的时候，我见到了一个有些讨厌的人。",
            "nextDialogs": [
              "747150106"
            ]
          },
          "747150106": {
            "id": "747150106",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "讨厌的人？",
            "nextDialogs": [
              "747150107"
            ]
          },
          "747150107": {
            "id": "747150107",
            "speakerId": 1074,
            "speakerName": "菲米尼",
            "text": "呃…要从哪里讲起呢。按照枫丹法规，对于沉入水下的货物，如果原主获得了保险赔款，它们就会变成自由财产。",
            "nextDialogs": [
              "747150108"
            ]
          },
          "747150108": {
            "id": "747150108",
            "speakerId": 1074,
            "speakerName": "菲米尼",
            "text": "基于这种规则，有些人将潜水视为发财的手段。通过打捞别人遗失的东西，在上岸后卖出摩拉…",
            "nextDialogs": [
              "747150109"
            ]
          },
          "747150109": {
            "id": "747150109",
            "speakerId": 1074,
            "speakerName": "菲米尼",
            "text": "这么做并没有太高门槛，导致潜水员中混入了不少…一心只想获得财富的人。",
            "nextDialogs": [
              "747150110"
            ]
          },
          "747150110": {
            "id": "747150110",
            "speakerId": 1074,
            "speakerName": "菲米尼",
            "text": "有时候，他们会粗暴地赶走鱼群和膨膨兽，只因它们碍了自己的生意…我不接某些委托，也与这样的人有一点关系。",
            "nextDialogs": [
              "747150111"
            ]
          },
          "747150111": {
            "id": "747150111",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "原来是这样…可以理解菲米尼的心情。",
            "nextDialogs": [
              "747150112"
            ]
          },
          "747150112": {
            "id": "747150112",
            "speakerId": 1074,
            "speakerName": "菲米尼",
            "text": "刚才在水下，我又遇到了这样的情况。我鼓起勇气，制止了对方的行为。尽管最后还是…被骂了。",
            "nextDialogs": [
              "747150113"
            ]
          },
          "747150113": {
            "id": "747150113",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "怎么这样…",
            "nextDialogs": [
              "747150116"
            ]
          },
          "747150116": {
            "id": "747150116",
            "speakerId": 1074,
            "speakerName": "菲米尼",
            "text": "#谢谢{NICKNAME}和派蒙的好意，不过…虽然对我来说很难也很累，但我还是想靠自己的努力，去改变些什么。",
            "nextDialogs": [
              "747150117"
            ]
          },
          "747150117": {
            "id": "747150117",
            "speakerId": 1074,
            "speakerName": "菲米尼",
            "text": "我喜欢在水下遨游的感觉，观察苍晶螺的纹路，感受海露花的呼吸…",
            "nextDialogs": [
              "747150118"
            ]
          },
          "747150118": {
            "id": "747150118",
            "speakerId": 1074,
            "speakerName": "菲米尼",
            "text": "当水下的世界认可你时，它会给你善意的回应。",
            "nextDialogs": [
              "747150119"
            ]
          },
          "747150119": {
            "id": "747150119",
            "speakerId": 1074,
            "speakerName": "菲米尼",
            "text": "我认为这才是我们应该选择的，与世界相处的方式，而不是一味自私地夺取。",
            "nextDialogs": [
              "747150120"
            ]
          },
          "747150120": {
            "id": "747150120",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "我觉得菲米尼说的这些也很好噢！你看，当你真的有什么想做的、想说的时候，表达出来其实更畅快吧！",
            "nextDialogs": [
              "747150121"
            ]
          },
          "747150121": {
            "id": "747150121",
            "speakerId": 1074,
            "speakerName": "菲米尼",
            "text": "唔…",
            "nextDialogs": [
              "747150122"
            ]
          },
          "747150122": {
            "id": "747150122",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "菲米尼？",
            "nextDialogs": [
              "747150123"
            ]
          },
          "747150123": {
            "id": "747150123",
            "speakerId": 1074,
            "speakerName": "菲米尼",
            "text": "抱歉…我有点害羞。总之…我、我会继续努力的。",
            "nextDialogs": [
              "747150124"
            ]
          },
          "747150124": {
            "id": "747150124",
            "speakerId": 1074,
            "speakerName": "菲米尼",
            "text": "差点忘了…这些是最新的水底勘测情报，请收下，它们应该能对你们派上用场。"
          }
        }
      }
    }
  ]
}
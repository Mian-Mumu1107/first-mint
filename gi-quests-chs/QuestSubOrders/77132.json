    {
      "subId": "7713207",
      "subQuestName": "与派蒙对话",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "771320114"
        ],
        "dialogs": {
          "771320114": {
            "id": "771320114",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "…那个大家伙，被锁链捆在那里，但是其实一直想要到这个灯塔这儿来吧。",
            "nextDialogs": [
              "771320117"
            ]
          },
          "771320117": {
            "id": "771320117",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "可是那个少女，那个影子，她只是个人类，应该没有办法活这么久…",
            "nextDialogs": [
              "771320118"
            ]
          },
          "771320118": {
            "id": "771320118",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "那个影子到底是什么呢？",
            "nextDialogs": [
              "771320108"
            ]
          },
          "771320108": {
            "id": "771320108",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "是大家伙的愿望？你是说…少女最后其实没有等到，他也没有见到少女…",
            "nextDialogs": [
              "771320109"
            ]
          },
          "771320109": {
            "id": "771320109",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "那个影子只是他的一缕想象？",
            "nextDialogs": [
              "771320110"
            ]
          },
          "771320110": {
            "id": "771320110",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "唔…不过，即使如此，在他的想象中，他最后也…拥有了一切，对吧？"
          }
        }
      }
    }
  ]

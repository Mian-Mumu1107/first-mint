    {
      "subId": "7713201",
      "subQuestName": "前往灯塔附近",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "771320101"
        ],
        "dialogs": {
          "771320101": {
            "id": "771320101",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "嗯，说不定呢…只要一直想做某件事，想得非常努力，也许身体也会在不经意间往愿望行动。",
            "nextDialogs": [
              "771320106"
            ]
          },
          "771320106": {
            "id": "771320106",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "那个影子可能…也是想要怀抱着再见一次大家伙的想法，才能够留下来的吧…",
            "nextDialogs": [
              "771320111"
            ]
          },
          "771320111": {
            "id": "771320111",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "大家伙…他走入了海面之下…总觉得以后再也见不到他了。",
            "nextDialogs": [
              "771320112"
            ]
          },
          "771320112": {
            "id": "771320112",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "再见啊！大家伙！",
            "nextDialogs": [
              "771320113"
            ]
          },
          "771320113": {
            "id": "771320113",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "…虽然也不知道他能不能听见。",
            "nextDialogs": [
              "771320115"
            ]
          },
          "771320115": {
            "id": "771320115",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "他会听见的。",
            "nextDialogs": [
              "771320116"
            ]
          },
          "771320116": {
            "id": "771320116",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "嗯嗯，希望如此吧！"
          }
        }
      }
    },

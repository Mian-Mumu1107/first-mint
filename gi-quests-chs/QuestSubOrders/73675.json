{
  "lineCounts": {
    "Black Screen": 2,
    "Player": 10,
    "派蒙": 5,
    "芭努": 30
  },
  "subQuests": [
    {
      "subId": "7367501",
      "subQuestName": "与芭努对话",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "736750101"
        ],
        "dialogs": {
          "736750101": {
            "id": "736750101",
            "speakerId": 12760,
            "speakerName": "芭努",
            "text": "哇，太好了！不是镀金旅团不是盗宝团，是衣着正经的陌生人，得赶快抓住机会。",
            "nextDialogs": [
              "736750102"
            ]
          },
          "736750102": {
            "id": "736750102",
            "speakerId": 12760,
            "speakerName": "芭努",
            "text": "嗯，那个…「这位行路的朋友，请停下你的脚步！」",
            "nextDialogs": [
              "736750105"
            ]
          },
          "736750105": {
            "id": "736750105",
            "speakerId": 12760,
            "speakerName": "芭努",
            "text": "「您好！括号，根据对方性别选择称呼先生或者女士，括号。唐突打扰非常抱歉，烦请您在百忙之际抽空…嗯…听取我的请求。」",
            "nextDialogs": [
              "736750106"
            ]
          },
          "736750106": {
            "id": "736750106",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "括、括号？",
            "nextDialogs": [
              "736750107"
            ]
          },
          "736750107": {
            "id": "736750107",
            "speakerId": 12760,
            "speakerName": "芭努",
            "text": "不行不行，不能打断，要不然我就记不得下一句了。下一句是——",
            "nextDialogs": [
              "736750108"
            ]
          },
          "736750108": {
            "id": "736750108",
            "speakerId": 12760,
            "speakerName": "芭努",
            "text": "「括号，用简要的语言描述你遇到的困难…并礼貌地请求对方协助，然后郑重向对方表示感谢，括号。」",
            "nextDialogs": [
              "736750109"
            ]
          },
          "736750109": {
            "id": "736750109",
            "speakerId": 12760,
            "speakerName": "芭努",
            "text": "最后一句是——「括号，范例，括号。感谢您的慷慨大度，我将永远把它记在心上。」",
            "nextDialogs": [
              "736750110"
            ]
          },
          "736750110": {
            "id": "736750110",
            "speakerId": 12760,
            "speakerName": "芭努",
            "text": "「同时，我愿意为您的不辞辛苦支付可观的报酬，因此我恳请您稍稍考虑这一请求。」",
            "nextDialogs": [
              "736750111"
            ]
          },
          "736750111": {
            "id": "736750111",
            "speakerId": 12760,
            "speakerName": "芭努",
            "text": "呼，这遍一个字都没背落，肯定没问题。那么，找未来星的事就靠你帮忙了。",
            "nextDialogs": [
              "736750112"
            ]
          },
          "736750112": {
            "id": "736750112",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "听起来像是有事要委托我们，但我怎么听不懂你说的话…",
            "nextDialogs": [
              "736750113"
            ]
          },
          "736750113": {
            "id": "736750113",
            "speakerId": 12760,
            "speakerName": "芭努",
            "text": "哪里有问题呢？《游学者不可不知的五十件事》上说，要找人帮忙的话就这么说，不该有问题啊。"
          }
        }
      }
    }
  ]
}
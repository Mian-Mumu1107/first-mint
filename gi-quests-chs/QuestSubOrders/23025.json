    {
      "subId": "2302510",
      "subQuestName": "与法伽尼对话",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "230251001"
        ],
        "dialogs": {
          "230251001": {
            "id": "230251001",
            "speakerId": 1000,
            "speakerName": "法伽尼",
            "text": "什么？居然有魔物出现？这不应该呀，那片区域的环境参数明明…",
            "nextDialogs": [
              "230251002"
            ]
          },
          "230251002": {
            "id": "230251002",
            "speakerId": 1000,
            "speakerName": "法伽尼",
            "text": "难不成是信标本身也构成了变量？如果是运作时的轻微震动和声光吸引了魔物…",
            "nextDialogs": [
              "230251003"
            ]
          },
          "230251003": {
            "id": "230251003",
            "speakerId": 1000,
            "speakerName": "法伽尼",
            "text": "不会影响到采集的数据吧…啊，实在抱歉，我又自顾自地说话了。",
            "nextDialogs": [
              "230251004"
            ]
          },
          "230251004": {
            "id": "230251004",
            "speakerId": 1000,
            "speakerName": "法伽尼",
            "text": "我也没想到，居然会给您添额外的麻烦…这些报酬还请务必收下。",
            "nextDialogs": [
              "230251005"
            ]
          },
          "230251005": {
            "id": "230251005",
            "speakerId": 1000,
            "speakerName": "法伽尼",
            "text": "下次测量，一定要考虑得更谨慎些…"
          }
        }
      }

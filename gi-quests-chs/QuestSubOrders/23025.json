    {
      "subId": "2302507",
      "subQuestName": "与法伽尼对话",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "230250701"
        ],
        "dialogs": {
          "230250701": {
            "id": "230250701",
            "speakerId": 1000,
            "speakerName": "法伽尼",
            "text": "嗯？信标都已经设置完了吗？",
            "nextDialogs": [
              "230250702"
            ]
          },
          "230250702": {
            "id": "230250702",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "都设置好了。",
            "nextDialogs": [
              "230250703"
            ]
          },
          "230250703": {
            "id": "230250703",
            "speakerId": 1000,
            "speakerName": "法伽尼",
            "text": "真是太谢谢了，来，这是说好的报酬。",
            "nextDialogs": [
              "230250704"
            ]
          },
          "230250704": {
            "id": "230250704",
            "speakerId": 1000,
            "speakerName": "法伽尼",
            "text": "这下只要等它们采集完数据，就能证实之前的推论了！",
            "nextDialogs": [
              "230250705"
            ]
          },
          "230250705": {
            "id": "230250705",
            "speakerId": 1000,
            "speakerName": "法伽尼",
            "text": "不过话又说回来，我该怎么上去回收这些信标呢…"
          }
        }
      }
    },
    {
      "subId": "2302508",
      "subQuestName": "与法伽尼对话",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "230250801"
        ],
        "dialogs": {
          "230250801": {
            "id": "230250801",
            "speakerId": 1000,
            "speakerName": "法伽尼",
            "text": "哦！旅行者，您可终于来了！",
            "nextDialogs": [
              "230250802"
            ]
          },
          "230250802": {
            "id": "230250802",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "研究还顺利吗？",
            "nextDialogs": [
              "230250803"
            ]
          },
          "230250803": {
            "id": "230250803",
            "speakerId": 1000,
            "speakerName": "法伽尼",
            "text": "托您的福，这几天的进展可不小，那些信标应该有在好好收集数据吧。",
            "nextDialogs": [
              "230250804"
            ]
          },
          "230250804": {
            "id": "230250804",
            "speakerId": 1000,
            "speakerName": "法伽尼",
            "text": "现在只要把那些数据回收，就能验证这几天提出的新猜想了！",
            "nextDialogs": [
              "230250807"
            ]
          },
          "230250807": {
            "id": "230250807",
            "speakerId": 1000,
            "speakerName": "法伽尼",
            "text": "咳咳，也有对计算公式的优化、测量仪器的校准之类的，毕竟您看…",
            "nextDialogs": [
              "230250808"
            ]
          },
          "230250808": {
            "id": "230250808",
            "speakerId": 1000,
            "speakerName": "法伽尼",
            "text": "凭我这副身板，也没办法爬到您设置信标的地方去回收啊。",
            "nextDialogs": [
              "230250809"
            ]
          },
          "230250809": {
            "id": "230250809",
            "speakerId": 1000,
            "speakerName": "法伽尼",
            "text": "这回恐怕还是要麻烦您一趟，去收回那些信标了。"
          }
        }
      }
    },

    {
      "subId": "2302502",
      "subQuestName": "与法伽尼对话",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "230250201"
        ],
        "dialogs": {
          "230250201": {
            "id": "230250201",
            "speakerId": 1000,
            "speakerName": "法伽尼",
            "text": "嘿——这位朋友，请问能否占用您一些时间？",
            "nextDialogs": [
              "230250208",
              "230250204"
            ]
          },
          "230250208": {
            "id": "230250208",
            "speakerId": 1000,
            "speakerName": "法伽尼",
            "text": "您有没有想过这么一个问题：要是天塌下来该怎么办？"
          },
          "230250204": {
            "id": "230250204",
            "speakerId": 1000,
            "speakerName": "法伽尼",
            "text": "哦！请别这么说，有什么事情能比自己的居所坍圮在即还要严重？",
            "nextDialogs": [
              "230250205"
            ]
          },
          "230250205": {
            "id": "230250205",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "你家屋子…要塌了？",
            "nextDialogs": [
              "230250206"
            ]
          },
          "230250206": {
            "id": "230250206",
            "speakerId": 1000,
            "speakerName": "法伽尼",
            "text": "咳咳，那当然不是。但如果您住在一座屋子里，却从没见过这屋子的全貌，也没人保证过屋子的结构强度…",
            "nextDialogs": [
              "230250207"
            ]
          },
          "230250207": {
            "id": "230250207",
            "speakerId": 1000,
            "speakerName": "法伽尼",
            "text": "那每天生活在这屋子里，也是会有不安的吧？那么住在这个世界里也是一个道理。"
          }
        }
      }
    },
    {
      "subId": "2302503",
      "subQuestName": "击败目的地附近的魔物",

    {
      "subId": "2302504",
      "subQuestName": "与法伽尼对话",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "230250401"
        ],
        "dialogs": {
          "230250401": {
            "id": "230250401",
            "speakerId": 1000,
            "speakerName": "法伽尼",
            "text": "嗯嗯…原来是这样吗？只要再引入这个变量，就能解释之前的误差…",
            "nextDialogs": [
              "230250402"
            ]
          },
          "230250402": {
            "id": "230250402",
            "speakerId": 1000,
            "speakerName": "法伽尼",
            "text": "不过这么一来，别的推论会不会也跟着改变呢…",
            "nextDialogs": [
              "230250403"
            ]
          },
          "230250403": {
            "id": "230250403",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "有进展了吗？",
            "nextDialogs": [
              "230250404"
            ]
          },
          "230250404": {
            "id": "230250404",
            "speakerId": 1000,
            "speakerName": "法伽尼",
            "text": "啊，不好意思，都忘了你还在这里…来，这是说好的报酬。",
            "nextDialogs": [
              "230250405"
            ]
          },
          "230250405": {
            "id": "230250405",
            "speakerId": 1000,
            "speakerName": "法伽尼",
            "text": "至于进展嘛…虽然解决了一些问题，但又好像出现了不少新问题…大概这就是做研究吧。",
            "nextDialogs": [
              "230250406"
            ]
          },
          "230250406": {
            "id": "230250406",
            "speakerId": 1000,
            "speakerName": "法伽尼",
            "text": "在得出最终的结论之前，可能还是得继续麻烦你了，旅行者。"
          }
        }
      }
    },

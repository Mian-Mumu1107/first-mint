    {
      "subId": "201013",
      "subQuestName": "与「剑鱼二番队」成员对话",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "20101301"
        ],
        "dialogs": {
          "20101301": {
            "id": "20101301",
            "speakerId": 1004,
            "speakerName": "剑鱼二番队代理队长",
            "text": "你就是新任的剑鱼二番队队长吧，珊瑚宫大人已经跟我们说了。",
            "nextDialogs": [
              "20101302"
            ]
          },
          "20101302": {
            "id": "20101302",
            "speakerId": 1004,
            "speakerName": "剑鱼二番队代理队长",
            "text": "军队中早有关于你的传闻，委任书也确认完毕。不过我尚有一个疑虑…",
            "nextDialogs": [
              "20101303"
            ]
          },
          "20101303": {
            "id": "20101303",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "嗯？还有什么问题吗？",
            "nextDialogs": [
              "20101304"
            ]
          },
          "20101304": {
            "id": "20101304",
            "speakerId": 1004,
            "speakerName": "剑鱼二番队代理队长",
            "text": "简单来说，就是你是否值得我们追随。",
            "nextDialogs": [
              "20101305"
            ]
          },
          "20101305": {
            "id": "20101305",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "你们的意思是…",
            "nextDialogs": [
              "20101306"
            ]
          },
          "20101306": {
            "id": "20101306",
            "speakerId": 1005,
            "speakerName": "剑鱼二番队老兵",
            "text": "放在平时，最直接的做法就是痛痛快快地打一场。不过现在嘛，这里有更好的靶子。",
            "nextDialogs": [
              "20101307"
            ]
          },
          "20101307": {
            "id": "20101307",
            "speakerId": 1005,
            "speakerName": "剑鱼二番队老兵",
            "text": "我们驻扎在这里，是因为最近很多<color=#00E1FFFF>流浪武士</color>闹事。如果你能把这些<color=#00E1FFFF>流浪武士</color>干掉，我们就认可你的实力。",
            "nextDialogs": [
              "20101308"
            ]
          },
          "20101308": {
            "id": "20101308",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "没问题。",
            "nextDialogs": [
              "20101309"
            ]
          },
          "20101309": {
            "id": "20101309",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "嗯嗯，就让他们心服口服吧！"
          }
        }
      }
    },
    {
      "subId": "201017",

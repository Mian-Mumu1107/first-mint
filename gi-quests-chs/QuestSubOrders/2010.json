    {
      "subId": "201015",
      "subQuestName": "与「剑鱼二番队」成员对话",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "20101501"
        ],
        "dialogs": {
          "20101501": {
            "id": "20101501",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "#这样应该就可以了…{NICKNAME}，你没受伤吧？",
            "nextDialogs": [
              "20101504"
            ]
          },
          "20101504": {
            "id": "20101504",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "嗯嗯…也不知道幸德和嘉久那边怎么样了。要不要过去看看呢？",
            "nextDialogs": [
              "20101505"
            ]
          },
          "20101505": {
            "id": "20101505",
            "speakerId": 1007,
            "speakerName": "嘉久",
            "text": "队长——",
            "nextDialogs": [
              "20101506"
            ]
          },
          "20101506": {
            "id": "20101506",
            "speakerId": 1006,
            "speakerName": "幸德",
            "text": "报告队长，其他两个营地清剿完毕，这样整个海祇岛的后方就暂时安全了。",
            "nextDialogs": [
              "20101507"
            ]
          },
          "20101507": {
            "id": "20101507",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "太好了！嘿嘿，既解决了流浪武士的麻烦，又得到了大家的认可…",
            "nextDialogs": [
              "20101508"
            ]
          },
          "20101508": {
            "id": "20101508",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "不过之后应该做些什么呢？还是回去问问心海吧。",
            "nextDialogs": [
              "20101509"
            ]
          },
          "20101509": {
            "id": "20101509",
            "speakerId": 1007,
            "speakerName": "嘉久",
            "text": "这次终于出了口恶气，早就看这帮流浪武士不顺眼了，不过幸德以前一直不让打。",
            "nextDialogs": [
              "20101510"
            ]
          },
          "20101510": {
            "id": "20101510",
            "speakerId": 1006,
            "speakerName": "幸德",
            "text": "啊？说得好像没有队长在，你们打得过一样。我不是为了你们好吗？",
            "nextDialogs": [
              "20101511"
            ]
          },
          "20101511": {
            "id": "20101511",
            "speakerId": 1007,
            "speakerName": "嘉久",
            "text": "明明是你比较胆小…",
            "nextDialogs": [
              "20101512"
            ]
          },
          "20101512": {
            "id": "20101512",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "喂喂，不可以吵架哦！",
            "nextDialogs": [
              "20101513"
            ]
          },
          "20101513": {
            "id": "20101513",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "#真是的…{NICKNAME}，我们还是先去跟<color=#00E1FFFF>心海</color>复命吧。"
          }
        }
      }
    },
    {
      "subId": "201011",
      "subQuestName": "回到本部，与珊瑚宫心海对话",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "20101101"
        ],
        "dialogs": {
          "20101101": {
            "id": "20101101",
            "speakerId": 1002,
            "speakerName": "珊瑚宫心海",
            "text": "#怎么样，{NICKNAME}，上任的过程还顺利吗？",
            "nextDialogs": [
              "20101103",
              "20101105"
            ]
          },
          "20101103": {
            "id": "20101103",
            "speakerId": 1002,
            "speakerName": "珊瑚宫心海",
            "text": "呵呵…虽然这么说，但幸德他们应该还是稍微考验了你一下吧？",
            "nextDialogs": [
              "20101106"
            ]
          },
          "20101106": {
            "id": "20101106",
            "speakerId": 1002,
            "speakerName": "珊瑚宫心海",
            "text": "不过，相信以你的能力，通过这种考验还是很轻松的。",
            "nextDialogs": [
              "20101107"
            ]
          },
          "20101107": {
            "id": "20101107",
            "speakerId": 1002,
            "speakerName": "珊瑚宫心海",
            "text": "你回来复命，说明登陆海祇岛的流浪武士已经被赶跑了吧？",
            "nextDialogs": [
              "20101122"
            ]
          },
          "20101122": {
            "id": "20101122",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "当然啦，我们可是把他们揍得落花流水呢！",
            "nextDialogs": [
              "20101108"
            ]
          },
          "20101108": {
            "id": "20101108",
            "speakerId": 1002,
            "speakerName": "珊瑚宫心海",
            "text": "这样就可以了，接下来只要让大久保派人严加看守，就可以避免他们再次闹事。",
            "nextDialogs": [
              "20101109"
            ]
          },
          "20101109": {
            "id": "20101109",
            "speakerId": 1002,
            "speakerName": "珊瑚宫心海",
            "text": "辛苦了。有功当赏，必须要给你奖励才行。让我想想…升职不行，太快了。增加军饷…",
            "nextDialogs": [
              "20101110"
            ]
          },
          "20101110": {
            "id": "20101110",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "怎么没看见哲平？",
            "nextDialogs": [
              "20101111"
            ]
          },
          "20101111": {
            "id": "20101111",
            "speakerId": 1002,
            "speakerName": "珊瑚宫心海",
            "text": "我给哲平也安排了任务，是一个奇袭幕府海军的作战。",
            "nextDialogs": [
              "20101112"
            ]
          },
          "20101112": {
            "id": "20101112",
            "speakerId": 1002,
            "speakerName": "珊瑚宫心海",
            "text": "他不愿意呆在后方，我也尊重他的选择。",
            "nextDialogs": [
              "20101113"
            ]
          },
          "20101113": {
            "id": "20101113",
            "speakerId": 1002,
            "speakerName": "珊瑚宫心海",
            "text": "#言归正传，{NICKNAME}，有一项特殊的任务，我想要交给你。",
            "nextDialogs": [
              "20101114"
            ]
          },
          "20101114": {
            "id": "20101114",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "「特殊的任务」？",
            "nextDialogs": [
              "20101115"
            ]
          },
          "20101115": {
            "id": "20101115",
            "speakerId": 1002,
            "speakerName": "珊瑚宫心海",
            "text": "是的。在海祇岛和踏鞴砂之间，有一处<color=#00E1FFFF>魔神遗迹</color>。那里有几个小岛，经常被当做运送物资的中转站。",
            "nextDialogs": [
              "20101116"
            ]
          },
          "20101116": {
            "id": "20101116",
            "speakerId": 1002,
            "speakerName": "珊瑚宫心海",
            "text": "不过这段时间，存放在那里的粮草经常会莫名其妙地消失。",
            "nextDialogs": [
              "20101117"
            ]
          },
          "20101117": {
            "id": "20101117",
            "speakerId": 1002,
            "speakerName": "珊瑚宫心海",
            "text": "但是，军队路过的时候，却又说没有发现危险…我想委托你帮忙查证一下真相。",
            "nextDialogs": [
              "20101118"
            ]
          },
          "20101118": {
            "id": "20101118",
            "speakerId": 1002,
            "speakerName": "珊瑚宫心海",
            "text": "此事并不急迫，不必太过匆忙。这几天，你们不妨先熟悉一下军队，也可以在海祇岛各处转转。",
            "nextDialogs": [
              "20101119"
            ]
          },
          "20101119": {
            "id": "20101119",
            "speakerId": 1002,
            "speakerName": "珊瑚宫心海",
            "text": "等哲平回来之后，你可以跟他聊聊天，然后找个天气晴朗的日子出海。",
            "nextDialogs": [
              "20101120"
            ]
          },
          "20101120": {
            "id": "20101120",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "哲平他真的没事吗…",
            "nextDialogs": [
              "20101121"
            ]
          },
          "20101121": {
            "id": "20101121",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "#一想到他以前冒失的样子，就有点担心。对了，{NICKNAME}，我们去<color=#00E1FFFF>训练营</color>等他吧！"
          },
          "20101105": {
            "id": "20101105",
            "speakerId": 1002,
            "speakerName": "珊瑚宫心海",
            "text": "嗯，确实是他们的性格。"
          }
        }
      }
    },
    {
      "subId": "201009",
      "subQuestName": "与哲平对话",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "20100901"
        ],
        "dialogs": {
          "20100901": {
            "id": "20100901",
            "speakerId": 1000,
            "speakerName": "哲平",
            "text": "#好久不见啦，{NICKNAME}。",
            "nextDialogs": [
              "20100902"
            ]
          },
          "20100902": {
            "id": "20100902",
            "speakerId": 1000,
            "speakerName": "哲平",
            "text": "怎么样，和剑鱼二番队那些人还合得来吗？",
            "nextDialogs": [
              "20100905"
            ]
          },
          "20100905": {
            "id": "20100905",
            "speakerId": 1000,
            "speakerName": "哲平",
            "text": "嘿嘿，就让我这个前辈教你一些统兵之道吧！",
            "nextDialogs": [
              "20100906"
            ]
          },
          "20100906": {
            "id": "20100906",
            "speakerId": 1000,
            "speakerName": "哲平",
            "text": "你要给他们增加军饷，还要设置一些悬赏，要让他们遵守纪律…还有什么来着？",
            "nextDialogs": [
              "20100907"
            ]
          },
          "20100907": {
            "id": "20100907",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "哇哦…哲平，你是从哪听来的啊？",
            "nextDialogs": [
              "20100908"
            ]
          },
          "20100908": {
            "id": "20100908",
            "speakerId": 1000,
            "speakerName": "哲平",
            "text": "从一本八重堂出版的小说…那是好久以前的事了。当时我用好几个团子当贿赂，那个朋友才答应借我看。",
            "nextDialogs": [
              "20100909"
            ]
          },
          "20100909": {
            "id": "20100909",
            "speakerId": 1001,
            "speakerName": "派蒙",

    {
      "subId": "201014",
      "subQuestName": "与「剑鱼二番队」成员对话",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "20101401"
        ],
        "dialogs": {
          "20101401": {
            "id": "20101401",
            "speakerId": 1004,
            "speakerName": "剑鱼二番队代理队长",
            "text": "有两下子嘛…虽然不如传闻中那么夸张，但确实很厉害。",
            "nextDialogs": [
              "20101402"
            ]
          },
          "20101402": {
            "id": "20101402",
            "speakerId": 1006,
            "speakerName": "幸德",
            "text": "介绍一下，我叫幸德，剑鱼二番队的代理队长。这位是嘉久，也是队伍中的老兵了。",
            "nextDialogs": [
              "20101403"
            ]
          },
          "20101403": {
            "id": "20101403",
            "speakerId": 1006,
            "speakerName": "幸德",
            "text": "现在，我正式把「队长」一职交给你。剑鱼二番队，随时待命。",
            "nextDialogs": [
              "20101404"
            ]
          },
          "20101404": {
            "id": "20101404",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "还有别的流浪武士闹事吗？",
            "nextDialogs": [
              "20101405"
            ]
          },
          "20101405": {
            "id": "20101405",
            "speakerId": 1007,
            "speakerName": "嘉久",
            "text": "遭到袭击的重灾区有两处，这里的流浪武士已经被队长干掉，他们的据点就只剩下<color=#00E1FFFF>本岛东部</color>的浅滩了。",
            "nextDialogs": [
              "20101406"
            ]
          },
          "20101406": {
            "id": "20101406",
            "speakerId": 1007,
            "speakerName": "嘉久",
            "text": "不过那里的流浪武士数量更多，战斗力也更强。",
            "nextDialogs": [
              "20101409"
            ]
          },
          "20101409": {
            "id": "20101409",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "是呀，海祇岛还在和幕府军打仗呢，不能让这些坏家伙在后面捣乱！"
          }
        }
      }
    },
    {
      "subId": "201010",
      "subQuestName": "前往有魔物威胁的地点",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [],
        "dialogs": {}
      }
    },
    {
      "subId": "201016",
      "subQuestName": "与「剑鱼二番队」成员对话",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "20101601"
        ],
        "dialogs": {
          "20101601": {
            "id": "20101601",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "好多流浪武士…",
            "nextDialogs": [
              "20101602"
            ]
          },
          "20101602": {
            "id": "20101602",
            "speakerId": 1006,
            "speakerName": "幸德",
            "text": "这还只是其中的一部分，他们在附近还有两个营地。",
            "nextDialogs": [
              "20101603"
            ]
          },
          "20101603": {
            "id": "20101603",
            "speakerId": 1006,
            "speakerName": "幸德",
            "text": "不管我们进攻哪个营地，其他两个营地的流浪武士都会成为隐患。他们可以自由选择支援或逃走。",
            "nextDialogs": [
              "20101604"
            ]
          },
          "20101604": {
            "id": "20101604",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "那就同时进攻…",
            "nextDialogs": [
              "20101605"
            ]
          },
          "20101605": {
            "id": "20101605",
            "speakerId": 1006,
            "speakerName": "幸德",
            "text": "可是这样的话，队长有可能遇到危险…",
            "nextDialogs": [
              "20101606"
            ]
          },
          "20101606": {
            "id": "20101606",
            "speakerId": 1006,
            "speakerName": "幸德",
            "text": "分兵之后，保护队长的人数太少，我有点不放心。",
            "nextDialogs": [
              "20101607"
            ]
          },
          "20101607": {
            "id": "20101607",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "没事。",
            "nextDialogs": [
              "20101608"
            ]
          },
          "20101608": {
            "id": "20101608",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "没错没错，这点人还伤不到我们哦！",
            "nextDialogs": [
              "20101609"
            ]
          },
          "20101609": {
            "id": "20101609",
            "speakerId": 1006,
            "speakerName": "幸德",
            "text": "好吧。那我们将他们一网打尽，之后再回来与队长会合！"
          }
        }
      }
    },

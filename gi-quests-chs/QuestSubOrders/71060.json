    {
      "subId": "7105911",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "710591101"
        ],
        "dialogs": {
          "710591101": {
            "id": "710591101",
            "speakerId": 20535,
            "speakerName": "卡塔琳娜",
            "text": "怎么？专门来打扰我休息吗？",
            "nextDialogs": [
              "710591102"
            ]
          },
          "710591102": {
            "id": "710591102",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "没有啦，我们就是看你一个人在这里怪孤单的，想跟你聊聊天而已！",
            "nextDialogs": [
              "710591105"
            ]
          },
          "710591105": {
            "id": "710591105",
            "speakerId": 20535,
            "speakerName": "卡塔琳娜",
            "text": "…这样吗？谢谢你们。你们这副样子呀…让我想起柳达希卡那家伙。",
            "nextDialogs": [
              "710591106"
            ]
          },
          "710591106": {
            "id": "710591106",
            "speakerId": 20535,
            "speakerName": "卡塔琳娜",
            "text": "她也是个热心人…那时候总是缠在我身边，什么话都愿意和我说…很多时候只愿意和我说。",
            "nextDialogs": [
              "710591107"
            ]
          },
          "710591107": {
            "id": "710591107",
            "speakerId": 20535,
            "speakerName": "卡塔琳娜",
            "text": "唉，如果柳达希卡也在就好咯…她是个很有趣的人，你一定会喜欢她的。"
          }
        }
      }
    },

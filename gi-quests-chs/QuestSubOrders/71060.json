          },
          "710591205": {
            "id": "710591205",
            "speakerId": 20535,
            "speakerName": "卡塔琳娜",
            "text": "…这样吗？谢谢你们。你们这副样子呀…让我想起柳达希卡那家伙。",
            "nextDialogs": [
              "710591206"
            ]
          },
          "710591206": {
            "id": "710591206",
            "speakerId": 20535,
            "speakerName": "卡塔琳娜",
            "text": "她也是个热心人…那时候总是缠在我身边，什么话都愿意和我说…很多时候只愿意和我说。",
            "nextDialogs": [
              "710591207"
            ]
          },
          "710591207": {
            "id": "710591207",
            "speakerId": 20535,
            "speakerName": "卡塔琳娜",
            "text": "唉，如果柳达希卡也在就好咯…她是个很有趣的人，你一定会喜欢她的。",
            "nextDialogs": [
              "710591208"
            ]
          },
          "710591208": {
            "id": "710591208",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "柳达希卡？那是谁？",
            "nextDialogs": [
              "710591209"
            ]
          },
          "710591209": {
            "id": "710591209",
            "speakerId": 20535,
            "speakerName": "卡塔琳娜",
            "text": "她呀…我的一个朋友，看起来很严肃的样子，其实是个有趣的笨蛋。",
            "nextDialogs": [
              "710591210"
            ]
          },
          "710591210": {
            "id": "710591210",
            "speakerId": 20535,
            "speakerName": "卡塔琳娜",
            "text": "曾经在「壁炉之家」的时候我们就像姐妹一样要好…可能更胜姐妹吧。她很喜欢我的捉弄…我也很受她照顾。",
            "nextDialogs": [
              "710591211"
            ]
          },
          "710591211": {
            "id": "710591211",
            "speakerId": 20535,
            "speakerName": "卡塔琳娜",
            "text": "哈哈，总之，我预感她在外面过得还不错。每每想到这点，我在这个鬼地方受的伤就都不算什么啦。",
            "nextDialogs": [
              "710591212"
            ]
          },
          "710591212": {
            "id": "710591212",
            "speakerId": 20535,
            "speakerName": "卡塔琳娜",
            "text": "希望她也有在好好执行任务吧…希望她不要想起我。"
          }
        }
      }
    }
  ]

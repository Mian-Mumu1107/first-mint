  "subQuests": [
    {
      "subId": "2051101",
      "subQuestName": "与安东尼对话",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "205110101"
        ],
        "dialogs": {
          "205110101": {
            "id": "205110101",
            "speakerId": 1408,
            "speakerName": "安东尼",
            "text": "这药方，真会管用吗…",
            "nextDialogs": [
              "205110102"
            ]
          },
          "205110102": {
            "id": "205110102",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "怎么了？",
            "nextDialogs": [
              "205110103"
            ]
          },
          "205110103": {
            "id": "205110103",
            "speakerId": 1408,
            "speakerName": "安东尼",
            "text": "旅行者！你来得正好，我正发愁呢，",
            "nextDialogs": [
              "205110104"
            ]
          },
          "205110104": {
            "id": "205110104",
            "speakerId": 1408,
            "speakerName": "安东尼",
            "text": "是这样，你还记得我妹妹安娜吧，她一直生着病，之前怎么治也没起色…",
            "nextDialogs": [
              "205110105"
            ]
          },
          "205110105": {
            "id": "205110105",
            "speakerId": 1408,
            "speakerName": "安东尼",
            "text": "但是我听说璃月港里有一位神医，很擅长解决疑难杂症，就托人去求他开药方。",
            "nextDialogs": [
              "205110106"
            ]
          },
          "205110106": {
            "id": "205110106",
            "speakerId": 1408,
            "speakerName": "安东尼",
            "text": "虽然药方里的材料都很奇怪…但也只有试一试了…",
            "nextDialogs": [
              "205110107"
            ]
          },
          "205110107": {
            "id": "205110107",
            "speakerId": 1408,
            "speakerName": "安东尼",
            "text": "呃，我看看…你能帮我去找一份「被草史莱姆吞下去过的树莓」吗？",
            "nextDialogs": [
              "205110109",
              "205110113",
              "205110117"
            ]
          },
          "205110109": {
            "id": "205110109",
            "speakerId": 1408,
            "speakerName": "安东尼",
            "text": "我也不知道啊！草史莱姆真的会吃树莓吗…",
            "nextDialogs": [
              "205110110"
            ]
          },
          "205110110": {
            "id": "205110110",
            "speakerId": 1408,
            "speakerName": "安东尼",
            "text": "就，就拜托你了！我知道一个地方有草史莱姆出没，也长着树莓。",
            "nextDialogs": [
              "205110111"
            ]
          },
          "205110111": {
            "id": "205110111",
            "speakerId": 1408,
            "speakerName": "安东尼",
            "text": "拜托你去看看吧，希望能找到…"
          },
          "205110113": {
            "id": "205110113",
            "speakerId": 1408,
            "speakerName": "安东尼",
            "text": "果然你也这么觉得吗？但是，我也是真的没办法了。",
            "nextDialogs": [
              "205110114"
            ]
          },
          "205110114": {
            "id": "205110114",
            "speakerId": 1408,
            "speakerName": "安东尼",
            "text": "我知道一个地方有很多草史莱姆，也长着树莓，拜托你去看看吧。",
            "nextDialogs": [
              "205110115"
            ]
          },
          "205110115": {
            "id": "205110115",
            "speakerId": 1408,
            "speakerName": "安东尼",
            "text": "然后，做出来的药我会先吃下去试试。无论如何，不能让安娜的身体再坏下去了…"
          },
          "205110117": {
            "id": "205110117",
            "speakerId": 1408,
            "speakerName": "安东尼",
            "text": "咦…咦？你是要我亲手把树莓塞给草史莱姆吃吗…",
            "nextDialogs": [
              "205110118"
            ]
          },
          "205110118": {
            "id": "205110118",
            "speakerId": 1408,
            "speakerName": "安东尼",
            "text": "你就饶了我吧，我上次给安娜采药的时候，被一群草史莱姆一直追到了清泉镇里…",
            "nextDialogs": [
              "205110119"
            ]
          },
          "205110119": {
            "id": "205110119",
            "speakerId": 1408,
            "speakerName": "安东尼",
            "text": "我知道一个地方有很多草史莱姆，也长着树莓，拜托你去看看吧，希望会有发现…",
            "nextDialogs": [
              "205110120"
            ]
          },
          "205110120": {
            "id": "205110120",
            "speakerId": 1408,
            "speakerName": "安东尼",
            "text": "但是…如，如果实在不行，为了安娜…你，你就抓个草史莱姆回来吧！我能行！我一定能行…"
          }
        }
      }
    },
    {

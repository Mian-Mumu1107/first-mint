        "dialogs": {
          "205110401": {
            "id": "205110401",
            "speakerId": 1408,
            "speakerName": "安东尼",
            "text": "你找到东西了吗？",
            "nextDialogs": [
              "205110402"
            ]
          },
          "205110402": {
            "id": "205110402",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "找到了。",
            "nextDialogs": [
              "205110403"
            ]
          },
          "205110403": {
            "id": "205110403",
            "speakerId": 1408,
            "speakerName": "安东尼",
            "text": "这就是吗？怎么看起来，没什么不一样…",
            "nextDialogs": [
              "205110404"
            ]
          },
          "205110404": {
            "id": "205110404",
            "speakerId": 1408,
            "speakerName": "安东尼",
            "text": "无论怎么看，这都是普通的树莓啊…",
            "nextDialogs": [
              "205110405"
            ]
          },
          "205110405": {
            "id": "205110405",
            "speakerId": 1408,
            "speakerName": "安东尼",
            "text": "算了，既然人家医生都这么开方子了，我就按照药方上面写的来做吧。",
            "nextDialogs": [
              "205110406"
            ]
          },
          "205110406": {
            "id": "205110406",
            "speakerId": 1408,
            "speakerName": "安东尼",
            "text": "谢谢你，这些是给你的辛苦费。",
            "nextDialogs": [
              "205110407"
            ]
          },
          "205110407": {
            "id": "205110407",
            "speakerId": 1408,
            "speakerName": "安东尼",
            "text": "以后说不定还会麻烦你，你可千万别推辞啊。"
          }
        }
      }
    }
  ]

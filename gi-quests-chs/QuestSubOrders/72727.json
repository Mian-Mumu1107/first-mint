  "subQuests": [
    {
      "subId": "7272701",
      "subQuestName": "与茅葺对话",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "727270101"
        ],
        "dialogs": {
          "727270101": {
            "id": "727270101",
            "speakerId": 1000,
            "speakerName": "茅葺一庆",
            "text": "嗨！那边那位异乡的武者！",
            "nextDialogs": [
              "727270103",
              "727270105"
            ]
          },
          "727270103": {
            "id": "727270103",
            "speakerId": 1000,
            "speakerName": "茅葺一庆",
            "text": "是啊，又见面了！你的身影，果然还是像从前一样耀眼…",
            "nextDialogs": [
              "727270106"
            ]
          },
          "727270106": {
            "id": "727270106",
            "speakerId": 1000,
            "speakerName": "茅葺一庆",
            "text": "…咳，总而言之，这几天，似乎又有人在秘密举办「百人一揆」了。"
          },
          "727270105": {
            "id": "727270105",
            "speakerId": 1000,
            "speakerName": "茅葺一庆",
            "text": "不记得我了吗？…啊，抱歉，上次「百人一揆」的时候，我可能光顾着记录你战斗时的英姿了，没怎么大声喝彩…"
          }
        }
      }
    },
    {
      "subId": "7272702",
      "subQuestName": "与茅葺对话",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "727270201"
        ],
        "dialogs": {
          "727270201": {
            "id": "727270201",
            "speakerId": 1000,
            "speakerName": "茅葺一庆",
            "text": "到了，就是这里。",
            "nextDialogs": [
              "727270202"
            ]
          },
          "727270202": {
            "id": "727270202",
            "speakerId": 1000,
            "speakerName": "茅葺一庆",
            "text": "还是老规矩，只要踏入这扇看起来十分可疑的大门，就能进入这回的战斗场馆。",
            "nextDialogs": [
              "727270207",
              "727270205"
            ]
          },
          "727270207": {
            "id": "727270207",
            "speakerId": 1000,
            "speakerName": "茅葺一庆",
            "text": "总之，这次我也会记录下你战斗时的英姿、为你高声喝彩的。"
          },
          "727270205": {
            "id": "727270205",
            "speakerId": 1000,
            "speakerName": "茅葺一庆",
            "text": "这次的规则和上次差不多。渴求争斗的魔物、冒险者与武者，会从提瓦特各地赶来，在祭典的舞台上，酣畅淋漓地大打出手。",
            "nextDialogs": [
              "727270206"
            ]
          },
          "727270206": {
            "id": "727270206",
            "speakerId": 1000,
            "speakerName": "茅葺一庆",
            "text": "当然，与之前一样，你可以和志同道合的伙伴或战友一起参战。毕竟，所谓「百人」一揆，自然是人数越多越好啦。"
          }
        }
      }
    }
  ]
}
  "subQuests": [
    {
      "subId": "7052801",
      "subQuestName": "前往蒙德城侧门，寻找卜劳恩",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [],
        "dialogs": {}
      }
    },
    {
      "subId": "7052802",
      "subQuestName": "与卜劳恩对话",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "705280401"
        ],
        "dialogs": {
          "705280401": {
            "id": "705280401",
            "speakerId": 30047,
            "speakerName": "卜劳恩",
            "text": "协会到底忙不忙得过来，唉…",
            "nextDialogs": [
              "705280402"
            ]
          },
          "705280402": {
            "id": "705280402",
            "speakerId": 30047,
            "speakerName": "卜劳恩",
            "text": "旅行者！不好意思，我刚才在想一些协会里的事务，走了一会神…",
            "nextDialogs": [
              "705280403"
            ]
          },
          "705280403": {
            "id": "705280403",
            "speakerId": 30047,
            "speakerName": "卜劳恩",
            "text": "你来蒙德城，应该是来参加风花节的吧。",
            "nextDialogs": [
              "705280404"
            ]
          },
          "705280404": {
            "id": "705280404",
            "speakerId": 30047,
            "speakerName": "卜劳恩",
            "text": "我们冒险家协会正好推出了一个小游戏，保证轻松有趣，参与就有奖励！",
            "nextDialogs": [
              "705280405"
            ]
          },
          "705280405": {
            "id": "705280405",
            "speakerId": 30047,
            "speakerName": "卜劳恩",
            "text": "怎么样，你要不要来试试看啊？",
            "nextDialogs": [
              "705280406"
            ]
          },
          "705280406": {
            "id": "705280406",
            "speakerId": 30047,
            "speakerName": "卜劳恩",
            "text": "我先为你介绍一下这个小游戏。协会里设计这个游戏的人，把它取名叫做「逐花棋」。",
            "nextDialogs": [
              "705280407"
            ]
          },
          "705280407": {
            "id": "705280407",
            "speakerId": 30047,
            "speakerName": "卜劳恩",
            "text": "他说自己的灵感是来自于飘飞的花瓣，还有追逐着花瓣的风…",
            "nextDialogs": [
              "705280408"
            ]
          },
          "705280408": {
            "id": "705280408",
            "speakerId": 30047,
            "speakerName": "卜劳恩",
            "text": "整个游戏的感觉，也是想要模拟那种追逐花瓣的…浪漫感…",
            "nextDialogs": [
              "705280411"
            ]
          },
          "705280411": {
            "id": "705280411",
            "speakerId": 30047,
            "speakerName": "卜劳恩",
            "text": "这老兄是个吟游诗人…比较富有那个…想象力…",
            "nextDialogs": [
              "705280412"
            ]
          },
          "705280412": {
            "id": "705280412",
            "speakerId": 30047,
            "speakerName": "卜劳恩",
            "text": "简单来说，玩这种棋的时候，玩家需要去尽可能多地搜集棋盘内分布的「风花球」。",
            "nextDialogs": [
              "705280413"
            ]
          },
          "705280413": {
            "id": "705280413",
            "speakerId": 30047,
            "speakerName": "卜劳恩",
            "text": "在搜集的同时，还要规避各种阻碍…当然啦，棋盘里还有各种辅助性的道具…",
            "nextDialogs": [
              "705280414"
            ]
          },
          "705280414": {
            "id": "705280414",
            "speakerId": 30047,
            "speakerName": "卜劳恩",
            "text": "那位老兄可是专门写了一整本详细的游玩手册，等会你可以看看。",
            "nextDialogs": [
              "705280415"
            ]
          },
          "705280415": {
            "id": "705280415",
            "speakerId": 30047,
            "speakerName": "卜劳恩",
            "text": "如果有兴趣的话，欢迎你来试玩啊，参与就有奖励！"
          }
        }
      }
    }
  ]
}
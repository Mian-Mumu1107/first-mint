    {
      "subId": "2402006",
      "subQuestName": "与伊维斯对话",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [],
        "dialogs": {}
      }
    },
    {
      "subId": "2402005",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "240200501"
        ],
        "dialogs": {
          "240200501": {
            "id": "240200501",
            "speakerId": 1000,
            "speakerName": "伊维斯",
            "text": "那个吝啬鬼，呸！",
            "nextDialogs": [
              "240200503",
              "240200509",
              "240200513"
            ]
          },
          "240200503": {
            "id": "240200503",
            "speakerId": 1000,
            "speakerName": "伊维斯",
            "text": "戈尔德曼是我老板，雇了一群像我这样没什么本事，只能卖自个力气赚钱糊口的人为他工作。",
            "nextDialogs": [
              "240200504"
            ]
          },
          "240200504": {
            "id": "240200504",
            "speakerId": 1000,
            "speakerName": "伊维斯",
            "text": "这个脑子里只有枫达的家伙既苛刻，又吝啬！他要求我们在工作时绝对遵守那本厚厚的工作准则…",
            "nextDialogs": [
              "240200514"
            ]
          },
          "240200514": {
            "id": "240200514",
            "speakerId": 1000,
            "speakerName": "伊维斯",
            "text": "而且，就连我们工作时用的潜水服也是他「租」给我们的。",
            "nextDialogs": [
              "240200505"
            ]
          },
          "240200505": {
            "id": "240200505",
            "speakerId": 1000,
            "speakerName": "伊维斯",
            "text": "只要我们违反了工作条例，或者潜水服破损，我们就得反过来赔他一笔钱…",
            "nextDialogs": [
              "240200515"
            ]
          },
          "240200515": {
            "id": "240200515",
            "speakerId": 1000,
            "speakerName": "伊维斯",
            "text": "也就是说，假如我工作时一个不小心，我甚至要付一笔钱给这吝啬鬼，央求他继续雇我！呸！",
            "nextDialogs": [
              "240200506"
            ]
          },
          "240200506": {
            "id": "240200506",
            "speakerId": 1000,
            "speakerName": "伊维斯",
            "text": "您了解他做什么，难道是想去见见他吗？我求您，就算是为了您的名声着想，也一定要离戈尔德曼远一些。",
            "nextDialogs": [
              "240200516"
            ]
          },
          "240200516": {
            "id": "240200516",
            "speakerId": 1000,
            "speakerName": "伊维斯",
            "text": "他是个无耻的人，身边总聚着一群和他臭味相投的坏种…",
            "nextDialogs": [
              "240200507"
            ]
          },
          "240200507": {
            "id": "240200507",
            "speakerId": 1000,
            "speakerName": "伊维斯",
            "text": "您可千万不要和他交往，想把一个烂泥坑清理干净，再倒满清水绝不是一件容易的事。",
            "nextDialogs": [
              "240200517"
            ]
          },
          "240200517": {
            "id": "240200517",
            "speakerId": 1000,
            "speakerName": "伊维斯",
            "text": "但用臭泥巴污染一个清白的池塘，是根本不费一点工夫的。"
          },
          "240200509": {
            "id": "240200509",
            "speakerId": 1000,
            "speakerName": "伊维斯",
            "text": "哈，您说得没错，但这也是我唯一能谋生的路子了。我不聪明，没其他的本事，但也绝不愿意做不好的事。",
            "nextDialogs": [
              "240200518"
            ]
          },
          "240200518": {
            "id": "240200518",
            "speakerId": 1000,
            "speakerName": "伊维斯",
            "text": "如果我非得做坏事才能换来面包，那我宁愿饿着肚子！",
            "nextDialogs": [
              "240200510"
            ]
          },
          "240200510": {
            "id": "240200510",
            "speakerId": 1000,
            "speakerName": "伊维斯",
            "text": "现在的活虽然辛苦得很，但我每天晚上睡觉至少合得上眼，不必担心有人恨透了我，想趁我睡着后拿刀刺我的眼睛。",
            "nextDialogs": [
              "240200511"
            ]
          },
          "240200511": {
            "id": "240200511",
            "speakerId": 1000,
            "speakerName": "伊维斯",
            "text": "在这一点上，我可比戈尔德曼好上太多了。"
          },
          "240200513": {
            "id": "240200513",
            "speakerId": 1000,
            "speakerName": "伊维斯",
            "text": "#行，打捞的事就倚仗您了，好心的{M#先生}{F#女士}，我得休息一会…"
          }
        }
      }
    },
    {
      "subId": "2402006",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "240200601"
        ],
        "dialogs": {
          "240200601": {
            "id": "240200601",
            "speakerId": 1000,
            "speakerName": "伊维斯",
            "text": "唉…真是坏运气…",
            "nextDialogs": [
              "240200602"
            ]
          },
          "240200602": {
            "id": "240200602",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "你把东西卖出去了吗？",
            "nextDialogs": [
              "240200603"
            ]
          },
          "240200603": {
            "id": "240200603",
            "speakerId": 1000,
            "speakerName": "伊维斯",
            "text": "是您啊。别提了，我本来都悄悄地找好了卖家，但戈尔德曼突然闯进了我屋子，把那盒首饰都拿走了！",
            "nextDialogs": [
              "240200604"
            ]
          },
          "240200604": {
            "id": "240200604",
            "speakerId": 1000,
            "speakerName": "伊维斯",
            "text": "如果不是他还需要我干活，那我肯定要挨一顿狠揍了…但我还是被他扣下了两个月的工资…",
            "nextDialogs": [
              "240200616"
            ]
          },
          "240200616": {
            "id": "240200616",
            "speakerId": 1000,
            "speakerName": "伊维斯",
            "text": "要等我做完了今年所有的活计，再把钱给我。",
            "nextDialogs": [
              "240200605"
            ]
          },
          "240200605": {
            "id": "240200605",
            "speakerId": 1000,
            "speakerName": "伊维斯",
            "text": "唉…算了，算了。好运气总是不愿意搭理我这类蠢蛋的…戈尔德曼没有找您吧？",
            "nextDialogs": [
              "240200607",
              "240200610"
            ]
          },
          "240200607": {
            "id": "240200607",
            "speakerId": 1000,
            "speakerName": "伊维斯",
            "text": "那就好，我就算挨揍了也不要紧，就是不愿这家伙去找您的麻烦。",
            "nextDialogs": [
              "240200608"
            ]
          },
          "240200608": {
            "id": "240200608",
            "speakerId": 1000,
            "speakerName": "伊维斯",
            "text": "我没有把您帮忙打捞的事说出来，但我总觉着，是有其他人知道了这件事，向那吝啬鬼告了密…",
            "nextDialogs": [
              "240200611"
            ]
          },
          "240200611": {
            "id": "240200611",
            "speakerId": 1000,
            "speakerName": "伊维斯",
            "text": "不过，今天我必须得再请您帮帮忙了，我的潜水服还没补好，但戈尔德曼却一个劲地催我工作，把前几天没干完的活全补上。",
            "nextDialogs": [
              "240200612"
            ]
          },
          "240200612": {
            "id": "240200612",
            "speakerId": 1000,
            "speakerName": "伊维斯",
            "text": "我只能找人家借了一套潜水服，赶紧来捞东西了…但这样还是捞不完，只能再请您发发好心，帮我一把了。"
          },
          "240200610": {
            "id": "240200610",
            "speakerId": 1000,
            "speakerName": "伊维斯",
            "text": "您可千万不要和那胖子沾上关系。他是个卑劣无耻的家伙！您这样值得敬佩的好人根本就不该结识他。"
          }
        }
      }
    }
  ]
}
    {
      "subId": "7621899",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "762189901"
        ],
        "dialogs": {
          "762189901": {
            "id": "762189901",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "咦？我们收到了一封邀请函。看这信封的样子…哦！是桑多涅吧！",
            "nextDialogs": [
              "762189902"
            ]
          },
          "762189902": {
            "id": "762189902",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "好像是邀请我们去参加茶会呢！嘿嘿，你别说我还挺期待的。一起去看看吧！"
          }
        }
      }
    }

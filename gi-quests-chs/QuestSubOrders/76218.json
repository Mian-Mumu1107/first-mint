  },
  "subQuests": [
    {
      "subId": "7621801",
      "subQuestName": "开车$HIDDEN",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "762180101"
        ],
        "dialogs": {
          "762180101": {
            "id": "762180101",
            "speakerId": 1319,
            "speakerName": "「木偶」",
            "text": "嗯？你们来了。",
            "nextDialogs": [
              "762180102"
            ]
          },
          "762180102": {
            "id": "762180102",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "你好呀！桑多涅。",
            "nextDialogs": [
              "762180105"
            ]
          },
          "762180105": {
            "id": "762180105",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "咦？你信里不是说要开茶会吗？怎么这里什么都没有，你该不会没准备好茶点吧？",
            "nextDialogs": [
              "762180106"
            ]
          },
          "762180106": {
            "id": "762180106",
            "speakerId": 1319,
            "speakerName": "「木偶」",
            "text": "哈，笑话。你还真是小看我了。",
            "nextDialogs": [
              "762180107"
            ]
          },
          "762180107": {
            "id": "762180107",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "哇！这…这桌子是怎么突然变出来的？！",
            "nextDialogs": [
              "762180108"
            ]
          },
          "762180108": {
            "id": "762180108",
            "speakerId": 1319,
            "speakerName": "「木偶」",
            "text": "哼哼，厉害吧？这是我新研制的便携式茶桌。",
            "nextDialogs": [
              "762180109"
            ]
          },
          "762180109": {
            "id": "762180109",
            "speakerId": 1319,
            "speakerName": "「木偶」",
            "text": "它不仅方便携带、易于收纳，甚至还加装了和法洁欧一样的悬浮装置。",
            "nextDialogs": [
              "762180110"
            ]
          },
          "762180110": {
            "id": "762180110",
            "speakerId": 1319,
            "speakerName": "「木偶」",
            "text": "更厉害的是…呃，算了，我就不自夸了，搞得像我在推销一样。你们自己感受吧。",
            "nextDialogs": [
              "762180111"
            ]
          },
          "762180111": {
            "id": "762180111",
            "speakerId": 1319,
            "speakerName": "「木偶」",
            "text": "来，这是我准备的茶和点心。",
            "nextDialogs": [
              "762180112"
            ]
          },
          "762180112": {
            "id": "762180112",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "那我不客气了。",
            "nextDialogs": [
              "762180113"
            ]
          },
          "762180113": {
            "id": "762180113",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "唔…！真好吃！你手艺果然很好！",
            "nextDialogs": [
              "762180114"
            ]
          },
          "762180114": {
            "id": "762180114",
            "speakerId": 1319,
            "speakerName": "「木偶」",
            "text": "那是当然。",
            "nextDialogs": [
              "762180115"
            ]
          },
          "762180115": {
            "id": "762180115",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "不过，你怎么会想到要做这么一个装置呀？",
            "nextDialogs": [
              "762180116"
            ]
          },
          "762180116": {
            "id": "762180116",
            "speakerId": 1319,
            "speakerName": "「木偶」",
            "text": "当然是为了和朋友们在任何地方都能度过一段愉快的茶会时光啊。",
            "nextDialogs": [
              "762180117"
            ]
          },
          "762180117": {
            "id": "762180117",
            "speakerId": 1319,
            "speakerName": "「木偶」",
            "text": "之前我也说过。留住珍贵之物的方法并不只有坚守你已有的东西。",
            "nextDialogs": [
              "762180118"
            ]
          },
          "762180118": {
            "id": "762180118",
            "speakerId": 1319,
            "speakerName": "「木偶」",
            "text": "现在的我，变得想多出去走，多去见见朋友们了。",
            "nextDialogs": [
              "762180119"
            ]
          },
          "762180119": {
            "id": "762180119",
            "speakerId": 1319,
            "speakerName": "「木偶」",
            "text": "但让收到邀请的人准备茶点收拾茶桌，未免太不符合淑女的礼仪。",
            "nextDialogs": [
              "762180120"
            ]
          },
          "762180120": {
            "id": "762180120",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "嘿嘿，我倒是觉得朋友们不会在意啦。",
            "nextDialogs": [
              "762180121"
            ]
          },
          "762180121": {
            "id": "762180121",
            "speakerId": 1319,
            "speakerName": "「木偶」",
            "text": "我在意。而且这种简单的发明对我来说也不费力。",
            "nextDialogs": [
              "762180122"
            ]
          },
          "762180122": {
            "id": "762180122",
            "speakerId": 1319,
            "speakerName": "「木偶」",
            "text": "看你们这么喜欢，干脆就送你们一个好了。",
            "nextDialogs": [
              "762180123"
            ]
          },
          "762180123": {
            "id": "762180123",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "欸？！这怎么行？",
            "nextDialogs": [
              "762180124"
            ]
          },
          "762180124": {
            "id": "762180124",
            "speakerId": 1319,
            "speakerName": "「木偶」",
            "text": "没什么不行的。说了我很会做这些东西。",
            "nextDialogs": [
              "762180125"
            ]
          },
          "762180125": {
            "id": "762180125",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "那就谢谢了…",
            "nextDialogs": [
              "762180126"
            ]
          },
          "762180126": {
            "id": "762180126",
            "speakerId": 1319,
            "speakerName": "「木偶」",
            "text": "别客气，你们千灵节的时候也帮了我不少忙，就当是淑女的回礼吧。"
          }
        }
      }
    },

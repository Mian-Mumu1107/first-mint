        ],
        "dialogs": {
          "741220201": {
            "id": "741220201",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "这里的东西…被人拿走了吗？$UNRELEASED",
            "nextDialogs": [
              "741220202"
            ]
          },
          "741220202": {
            "id": "741220202",
            "speakerId": 21048,
            "speakerName": "卡特皮拉",
            "text": "看起来是这样。$UNRELEASED",
            "nextDialogs": [
              "741220203"
            ]
          },
          "741220203": {
            "id": "741220203",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "究竟是谁会…$UNRELEASED",
            "nextDialogs": [
              "741220204"
            ]
          },
          "741220204": {
            "id": "741220204",
            "speakerId": 21048,
            "speakerName": "卡特皮拉",
            "text": "是雅各布。$UNRELEASED",
            "nextDialogs": [
              "741220205"
            ]
          },
          "741220205": {
            "id": "741220205",
            "speakerId": 16924,
            "speakerName": "西摩尔",
            "text": "我们之前在厄里那斯曾经与其发生冲突。补充订正，是最近一段时间的厄里那斯。$UNRELEASED",
            "nextDialogs": [
              "741220206"
            ]
          },
          "741220206": {
            "id": "741220206",
            "speakerId": 21048,
            "speakerName": "卡特皮拉",
            "text": "看到大门口那个悲剧的受害者我就知道是他的手笔了。他果然还在活动啊。$UNRELEASED",
            "nextDialogs": [
              "741220207"
            ]
          },
          "741220207": {
            "id": "741220207",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "那他拿走这里的东西是想要干什么呢？$UNRELEASED",
            "nextDialogs": [
              "741220208"
            ]
          },
          "741220208": {
            "id": "741220208",
            "speakerId": 21048,
            "speakerName": "卡特皮拉",
            "text": "很简单啊。他也想要重铸水仙十字的圣剑。因为水仙十字的事业还未竟呢。$UNRELEASED",
            "nextDialogs": [
              "741220209"
            ]
          },
          "741220209": {
            "id": "741220209",
            "speakerId": 21048,
            "speakerName": "卡特皮拉",
            "text": "我们还是赶紧去下一处吧。$UNRELEASED"
          }
        }
      }
    },

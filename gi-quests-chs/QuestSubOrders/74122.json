            ]
          },
          "741229903": {
            "id": "741229903",
            "speakerId": 16924,
            "speakerName": "西摩尔",
            "text": "是这里吗？视野内确认也有石碑。",
            "nextDialogs": [
              "741229904"
            ]
          },
          "741229904": {
            "id": "741229904",

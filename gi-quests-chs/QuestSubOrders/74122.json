  "subQuests": [
    {
      "subId": "7412203",
      "subQuestName": "(test)靠近第2个封印$UNRELEASED$HIDDEN",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "741220301"
        ],
        "dialogs": {
          "741220301": {
            "id": "741220301",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "这里依旧什么都没有欸…$UNRELEASED",
            "nextDialogs": [
              "741220302"
            ]
          },
          "741220302": {
            "id": "741220302",
            "speakerId": 16922,
            "speakerName": "安",
            "text": "所以卡特皮拉你能告诉我们，我们究竟要找什么吗？$UNRELEASED",
            "nextDialogs": [
              "741220303"
            ]
          },
          "741220303": {
            "id": "741220303",
            "speakerId": 21048,
            "speakerName": "卡特皮拉",
            "text": "我们是在寻找锻铸水仙十字圣剑的材料。$UNRELEASED",
            "nextDialogs": [
              "741220304"
            ]
          },
          "741220304": {
            "id": "741220304",
            "speakerId": 21048,
            "speakerName": "卡特皮拉",
            "text": "水仙十字结社依据地下之国与古枫丹的神秘哲学，在物质世界重现了必要的四种架空物质。$UNRELEASED",
            "nextDialogs": [
              "741220305"
            ]
          },
          "741220305": {
            "id": "741220305",
            "speakerId": 16924,
            "speakerName": "西摩尔",
            "text": "无法理解。$UNRELEASED",
            "nextDialogs": [
              "741220306"
            ]
          },
          "741220306": {
            "id": "741220306",
            "speakerId": 21048,
            "speakerName": "卡特皮拉",
            "text": "神秘的东西本身只作用于体验，可以说比元素力还要跳脱常理呢。$UNRELEASED",
            "nextDialogs": [
              "741220307"
            ]
          },
          "741220307": {
            "id": "741220307",
            "speakerId": 16924,
            "speakerName": "西摩尔",
            "text": "几十年前我录入过教令院的素论派入门至中级教材，元素力也没有那么神奇。$UNRELEASED",
            "nextDialogs": [
              "741220308"
            ]
          },
          "741220308": {
            "id": "741220308",
            "speakerId": 21048,
            "speakerName": "卡特皮拉",
            "text": "是吗。那反正结论上来说，这是枫丹古法与地下古国技术的交汇。$UNRELEASED",
            "nextDialogs": [
              "741220309"
            ]
          },
          "741220309": {
            "id": "741220309",
            "speakerId": 21048,
            "speakerName": "卡特皮拉",
            "text": "世界上出现了「记忆」、「愿望」、「灵魂」与「人格」这四种物质。$UNRELEASED",
            "nextDialogs": [
              "741220310"
            ]
          },
          "741220310": {
            "id": "741220310",
            "speakerId": 21048,
            "speakerName": "卡特皮拉",
            "text": "为了防止歧义，我们把它们叫做「记忆」之块、「愿望」之块、「灵魂」之块与「人格」之块好了。$UNRELEASED",
            "nextDialogs": [
              "741220311"
            ]
          },
          "741220311": {
            "id": "741220311",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "为什么这些东西会用来打造圣剑啊？$UNRELEASED",
            "nextDialogs": [
              "741220312"
            ]
          },
          "741220312": {
            "id": "741220312",
            "speakerId": 21048,
            "speakerName": "卡特皮拉",
            "text": "水仙十字的神秘哲学里，神殿是宇宙的缩影，社员是众神的代行，圣油是锤炼的意志。$UNRELEASED",
            "nextDialogs": [
              "741220313"
            ]
          },
          "741220313": {
            "id": "741220313",
            "speakerId": 21048,
            "speakerName": "卡特皮拉",
            "text": "圣剑，则是破开一切的「理性」。它需由完整的人之意志诞生而出。$UNRELEASED",
            "nextDialogs": [
              "741220314"
            ]
          },
          "741220314": {
            "id": "741220314",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "好玄乎。$UNRELEASED",
            "nextDialogs": [
              "741220315"
            ]
          },
          "741220315": {
            "id": "741220315",
            "speakerId": 21048,
            "speakerName": "卡特皮拉",
            "text": "哎呀，神秘哲学是这样的。看着相似就可以攀附。当这种东西变成魔法了就假成真的了。$UNRELEASED",
            "nextDialogs": [
              "741220316"
            ]
          },
          "741220316": {
            "id": "741220316",
            "speakerId": 21048,
            "speakerName": "卡特皮拉",
            "text": "总之我们赶紧去最后一处地方吧。$UNRELEASED"
          }
        }
      }
    },
    {
      "subId": "7412205",
      "subQuestName": "(test)靠近第3个封印$UNRELEASED$HIDDEN",
      "sceneId": null,

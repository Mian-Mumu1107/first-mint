    {
      "subId": "45101",
      "subQuestName": "前往奔狼领",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "4510101"
        ],
        "dialogs": {
          "4510101": {
            "id": "4510101",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "这里叫做「奔狼领」，据说蒙德的人很少涉足这里…",
            "nextDialogs": [
              "4510102"
            ]
          },
          "4510102": {
            "id": "4510102",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "虽然就在蒙德城附近，但这里生态原始，是一个自然法则至上的地方。",
            "nextDialogs": [
              "4510103"
            ]
          },
          "4510103": {
            "id": "4510103",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "正所谓弱肉强食，连史莱姆都能长得很巨大哦！",
            "nextDialogs": [
              "4510104"
            ]
          },
          "4510104": {
            "id": "4510104",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "看，就是这——么巨大。",
            "nextDialogs": [
              "4510105"
            ]
          },
          "4510105": {
            "id": "4510105",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "…它们进攻过来了！做好准备！"
          }
        }
      }
    },

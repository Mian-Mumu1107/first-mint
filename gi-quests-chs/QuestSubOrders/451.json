    {
      "subId": "45105",
      "subQuestName": "获取足够的兽肉",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "4510501"
        ],
        "dialogs": {
          "4510501": {
            "id": "4510501",
            "speakerId": 1002,
            "speakerName": "雷泽",
            "text": "啊，你们真的要帮忙吗…",
            "nextDialogs": [
              "4510502"
            ]
          },
          "4510502": {
            "id": "4510502",
            "speakerId": 1002,
            "speakerName": "雷泽",
            "text": "狼群有自己的方法，更有效。不过陷阱，很新鲜。",
            "nextDialogs": [
              "4510503"
            ]
          },
          "4510503": {
            "id": "4510503",
            "speakerId": 1002,
            "speakerName": "雷泽",
            "text": "放置好以后，把野猪赶过去，对吧。",
            "nextDialogs": [
              "4510504"
            ]
          },
          "4510504": {
            "id": "4510504",
            "speakerId": 1002,
            "speakerName": "雷泽",
            "text": "不会爆炸吧…"
          }
        }
      }
    },
    {
      "subId": "45108",
      "subQuestName": "狩猎提示$HIDDEN",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "4510801"
        ],
        "dialogs": {
          "4510801": {
            "id": "4510801",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "哼哼，那么是时候拿出真正的本事了。"
          }
        }
      }
    },
    {
      "subId": "45106",
      "subQuestName": "将三块兽肉带给雷泽",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "4510601"
        ],
        "dialogs": {
          "4510601": {
            "id": "4510601",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "你看，我们弄到了！",
            "nextDialogs": [
              "4510602"
            ]
          },
          "4510602": {
            "id": "4510602",
            "speakerId": 1002,
            "speakerName": "雷泽",
            "text": "谢谢你们。不过…",
            "nextDialogs": [
              "4510603"
            ]
          },
          "4510603": {
            "id": "4510603",
            "speakerId": 1002,
            "speakerName": "雷泽",
            "text": "不过要是我们自己来，能抓五六头。有狼今晚要空肚子了…",
            "nextDialogs": [
              "4510604"
            ]
          },
          "4510604": {
            "id": "4510604",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "呜啊…",
            "nextDialogs": [
              "4510605"
            ]
          },
          "4510605": {
            "id": "4510605",
            "speakerId": 1002,
            "speakerName": "雷泽",
            "text": "不要在意，谢谢你们。",
            "nextDialogs": [
              "4510606"
            ]
          },
          "4510606": {
            "id": "4510606",
            "speakerId": 1002,
            "speakerName": "雷泽",
            "text": "你们比起骑士团那个红色，看起来很烫的女孩子——朋友，要厉害多了。",
            "nextDialogs": [
              "4510607"
            ]
          },
          "4510607": {
            "id": "4510607",
            "speakerId": 1002,
            "speakerName": "雷泽",
            "text": "她出手的话，估计山会烧起来。猪，一头也抓不到。",
            "nextDialogs": [
              "4510608"
            ]
          },
          "4510608": {
            "id": "4510608",
            "speakerId": 1002,
            "speakerName": "雷泽",
            "text": "我该走了。",
            "nextDialogs": [
              "4510609"
            ]
          },
          "4510609": {
            "id": "4510609",
            "speakerId": 1002,
            "speakerName": "雷泽",
            "text": "最近这里不安全。你们小心，保护好自己。",
            "nextDialogs": [
              "4510610"
            ]
          },
          "4510610": {
            "id": "4510610",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "真是奇特的人啊。",
            "nextDialogs": [
              "4510611"
            ]
          },
          "4510611": {
            "id": "4510611",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "他提到的骑士团那个朋友。红色，很烫的女孩子——",
            "nextDialogs": [
              "4510612"
            ]
          },
          "4510612": {
            "id": "4510612",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "#{NICKNAME}，你想到了谁？"
          }
        }
      }
    }
  ]
}
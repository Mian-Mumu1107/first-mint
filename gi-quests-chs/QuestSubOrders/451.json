    {
      "subId": "45103",
      "subQuestName": "消灭史莱姆",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "4510301"
        ],
        "dialogs": {
          "4510301": {
            "id": "4510301",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "谢…谢谢你——奔狼领的狼群来了！快逃吧！",
            "nextDialogs": [
              "4510303"
            ]
          },
          "4510303": {
            "id": "4510303",
            "speakerId": 1001,
            "speakerName": "？？？",
            "text": "不用担心。 狼是朋友。 可，你们是谁？",
            "nextDialogs": [
              "4510304"
            ]
          },
          "4510304": {
            "id": "4510304",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "我们只是普通的旅行者……",
            "nextDialogs": [
              "4510305"
            ]
          },
          "4510305": {
            "id": "4510305",
            "speakerId": 1001,
            "speakerName": "？？？",
            "text": "不普通，你们。 不过，有熟悉的气味。",
            "nextDialogs": [
              "4510306"
            ]
          },
          "4510306": {
            "id": "4510306",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "熟悉的气味？",
            "nextDialogs": [
              "4510307"
            ]
          },
          "4510307": {
            "id": "4510307",
            "speakerId": 1001,
            "speakerName": "？？？",
            "text": "骑士团，对吧？骑士团里有朋友。",
            "nextDialogs": [
              "4510310",
              "4510313"
            ]
          },
          "4510310": {
            "id": "4510310",
            "speakerId": 1002,
            "speakerName": "雷泽",
            "text": "我是雷泽。",
            "nextDialogs": [
              "4510311"
            ]
          },
          "4510311": {
            "id": "4510311",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "你也是西风骑士团的人吗？",
            "nextDialogs": [
              "4510312"
            ]
          },
          "4510312": {
            "id": "4510312",
            "speakerId": 1002,
            "speakerName": "雷泽",
            "text": "和骑士团没关系。",
            "nextDialogs": [
              "4510314"
            ]
          },
          "4510314": {
            "id": "4510314",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "呜啊…",
            "nextDialogs": [
              "4510315"
            ]
          },
          "4510315": {
            "id": "4510315",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "狼群…是怎么回事？",
            "nextDialogs": [
              "4510316"
            ]
          },
          "4510316": {
            "id": "4510316",
            "speakerId": 1002,
            "speakerName": "雷泽",
            "text": "啊……狼群，是家人。",
            "nextDialogs": [
              "4510317"
            ]
          },
          "4510317": {
            "id": "4510317",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "家人？",
            "nextDialogs": [
              "4510318"
            ]
          },
          "4510318": {
            "id": "4510318",
            "speakerId": 1002,
            "speakerName": "雷泽",
            "text": "家人。将我养大，和我一起生活的家人。",
            "nextDialogs": [
              "4510319"
            ]
          },
          "4510319": {
            "id": "4510319",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "好像这中间有很复杂的故事……",
            "nextDialogs": [
              "4510320"
            ]
          },
          "4510320": {
            "id": "4510320",
            "speakerId": 1002,
            "speakerName": "雷泽",
            "text": "他们在责怪我。为了帮助你们，埋伏暴露了。没有抓到野猪。",
            "nextDialogs": [
              "4510321"
            ]
          },
          "4510321": {
            "id": "4510321",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "#这样吗…那就让{NICKNAME}来帮忙抓野猪吧。",
            "nextDialogs": [
              "4510322"
            ]
          },
          "4510322": {
            "id": "4510322",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "#{NICKNAME}也是很厉害的。",
            "nextDialogs": [
              "4510323"
            ]
          },
          "4510323": {
            "id": "4510323",
            "speakerId": 1002,
            "speakerName": "雷泽",
            "text": "我，我觉得不必了。骑士团的朋友每次动手，狼群都要饿肚子…",
            "nextDialogs": [
              "4510324"
            ]
          },
          "4510324": {
            "id": "4510324",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "不用和我们客气啦。你们就等着我们的好消息吧。"
          },
          "4510313": {
            "id": "4510313",
            "speakerId": 1002,
            "speakerName": "雷泽",
            "text": "我是雷泽。 和骑士团没有关系。"
          }
        }
      }
    },
    {
      "subId": "45104",

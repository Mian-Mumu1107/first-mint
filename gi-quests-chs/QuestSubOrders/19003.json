    {
      "subId": "1900303",
      "subQuestName": "向维多利亚修女回报",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "190030301"
        ],
        "dialogs": {
          "190030301": {
            "id": "190030301",
            "speakerId": 1471,
            "speakerName": "维多利亚",
            "text": "你怎么又回来了，如果你还是来找芭芭拉小姐的话，她还没回来。",
            "nextDialogs": [
              "190030304"
            ]
          },
          "190030304": {
            "id": "190030304",
            "speakerId": 1471,
            "speakerName": "维多利亚",
            "text": "是这样吗…她没什么事就好。",
            "nextDialogs": [
              "190030305"
            ]
          },
          "190030305": {
            "id": "190030305",
            "speakerId": 1471,
            "speakerName": "维多利亚",
            "text": "但一时半会她应该也回不来了吧，看来我得把教会的事情拜托给其他人做了…",
            "nextDialogs": [
              "190030306"
            ]
          },
          "190030306": {
            "id": "190030306",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "我来帮忙吧。",
            "nextDialogs": [
              "190030307"
            ]
          },
          "190030307": {
            "id": "190030307",
            "speakerId": 1471,
            "speakerName": "维多利亚",
            "text": "你愿意帮忙的话那就最好了，真是不好意思，还要麻烦你…",
            "nextDialogs": [
              "190030308"
            ]
          },
          "190030308": {
            "id": "190030308",
            "speakerId": 1471,
            "speakerName": "维多利亚",
            "text": "我想想…那请你帮我去教会周围打扫一下吧。",
            "nextDialogs": [
              "190030309"
            ]
          },
          "190030309": {
            "id": "190030309",
            "speakerId": 1471,
            "speakerName": "维多利亚",
            "text": "教会周围人来人往，地面总是很脏。",
            "nextDialogs": [
              "190030310"
            ]
          },
          "190030310": {
            "id": "190030310",
            "speakerId": 1471,
            "speakerName": "维多利亚",
            "text": "这些事之前一直是芭芭拉小姐一个人负责，她一不在，周围就…",
            "nextDialogs": [
              "190030311"
            ]
          },
          "190030311": {
            "id": "190030311",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "这么大的地方，都是芭芭拉小姐一个人打扫吗？",
            "nextDialogs": [
              "190030312"
            ]
          },
          "190030312": {
            "id": "190030312",
            "speakerId": 1471,
            "speakerName": "维多利亚",
            "text": "是的，芭芭拉小姐一直说自己没问题，也不让其他人帮忙。",
            "nextDialogs": [
              "190030313"
            ]
          },
          "190030313": {
            "id": "190030313",
            "speakerId": 1471,
            "speakerName": "维多利亚",
            "text": "但每次打扫结束后，她的样子都很疲惫。",
            "nextDialogs": [
              "190030314"
            ]
          },
          "190030314": {
            "id": "190030314",
            "speakerId": 1471,
            "speakerName": "维多利亚",
            "text": "说实话，你愿意帮忙，或者说…芭芭拉小姐愿意让你来帮忙，还让我挺意外的。",
            "nextDialogs": [
              "190030315"
            ]
          },
          "190030315": {
            "id": "190030315",
            "speakerId": 1471,
            "speakerName": "维多利亚",
            "text": "不过，这样她的负担也许会小一些吧…",
            "nextDialogs": [
              "190030316"
            ]
          },
          "190030316": {
            "id": "190030316",
            "speakerId": 1471,
            "speakerName": "维多利亚",
            "text": "总之，那清扫的事就拜托你了，「荣誉骑士」。"
          }
        }
      }
    },
    {
      "subId": "1900304",
      "subQuestName": "打扫教堂的周围",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [

    {
      "subId": "1900306",
      "subQuestName": "与维多利亚修女对话",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "190030601"
        ],
        "dialogs": {
          "190030601": {
            "id": "190030601",
            "speakerId": 1471,
            "speakerName": "维多利亚",
            "text": "咦？你好，还有什么事吗？",
            "nextDialogs": [
              "190030602"
            ]
          },
          "190030602": {
            "id": "190030602",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "关于芭芭拉的假期…",
            "nextDialogs": [
              "190030603"
            ]
          },
          "190030603": {
            "id": "190030603",
            "speakerId": 1471,
            "speakerName": "维多利亚",
            "text": "你说这个啊，没错，芭芭拉小姐刚才是向我请了半天假，说是要陪陪一位朋友。",
            "nextDialogs": [
              "190030604"
            ]
          },
          "190030604": {
            "id": "190030604",
            "speakerId": 1471,
            "speakerName": "维多利亚",
            "text": "不过，这还真是罕见…芭芭拉小姐居然会专门为了一位朋友请假…",
            "nextDialogs": [
              "190030605"
            ]
          },
          "190030605": {
            "id": "190030605",
            "speakerId": 1471,
            "speakerName": "维多利亚",
            "text": "好了，还是先说正事吧，你找我有什么事吗？",
            "nextDialogs": [
              "190030606"
            ]
          },
          "190030606": {
            "id": "190030606",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "关于「了不起的梦幻忧郁珊瑚气泡茶」…",
            "nextDialogs": [
              "190030607"
            ]
          },
          "190030607": {
            "id": "190030607",
            "speakerId": 1471,
            "speakerName": "维多利亚",
            "text": "欸？芭芭拉小姐要陪你去买这个…特别饮品？",
            "nextDialogs": [
              "190030608"
            ]
          },
          "190030608": {
            "id": "190030608",
            "speakerId": 1471,
            "speakerName": "维多利亚",
            "text": "难道芭芭拉小姐之前说的朋友就是你吗？",
            "nextDialogs": [
              "190030609"
            ]
          },
          "190030609": {
            "id": "190030609",
            "speakerId": 1471,
            "speakerName": "维多利亚",
            "text": "啊…如果是你这位「荣誉骑士」的话，倒也说得过去…",
            "nextDialogs": [
              "190030610"
            ]
          },
          "190030610": {
            "id": "190030610",
            "speakerId": 1471,
            "speakerName": "维多利亚",
            "text": "好吧，情况我了解了。那芭芭拉小姐就麻烦你多多照顾了，「荣誉骑士」。",
            "nextDialogs": [
              "190030611"
            ]
          },
          "190030611": {
            "id": "190030611",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "为什么芭芭拉的假期要报备行程？",
            "nextDialogs": [
              "190030612"
            ]
          },
          "190030612": {
            "id": "190030612",
            "speakerId": 1471,
            "speakerName": "维多利亚",
            "text": "这个啊…你也知道，因为各种原因，芭芭拉小姐在蒙德城里很受欢迎。",
            "nextDialogs": [
              "190030613"
            ]
          },
          "190030613": {
            "id": "190030613",
            "speakerId": 1471,
            "speakerName": "维多利亚",
            "text": "虽然居民们都是出于好意，但好意太多了，芭芭拉小姐有时候也实在忙不过来。",
            "nextDialogs": [
              "190030614"
            ]
          },
          "190030614": {
            "id": "190030614",
            "speakerId": 1471,
            "speakerName": "维多利亚",
            "text": "如果是在工作中，教会里的人可以及时出来为她解围。",
            "nextDialogs": [
              "190030615"
            ]
          },
          "190030615": {
            "id": "190030615",
            "speakerId": 1471,
            "speakerName": "维多利亚",
            "text": "但要是在假期中…那就只能靠芭芭拉小姐自己了。",
            "nextDialogs": [
              "190030616"
            ]
          },
          "190030616": {
            "id": "190030616",
            "speakerId": 1471,
            "speakerName": "维多利亚",
            "text": "但她又太…温柔，对居民们的请求向来都会尽量满足，甚至会把自己弄得比工作日还疲惫。",
            "nextDialogs": [
              "190030617"
            ]
          },
          "190030617": {
            "id": "190030617",
            "speakerId": 1471,
            "speakerName": "维多利亚",
            "text": "我们就想，让芭芭拉小姐把自己的假期行程报备一下，要真的需要我们出面解围，那我们也好及时赶过去。",
            "nextDialogs": [
              "190030618"
            ]
          },
          "190030618": {
            "id": "190030618",
            "speakerId": 1471,
            "speakerName": "维多利亚",
            "text": "真希望芭芭拉小姐不要再勉强自己了…"
          }
        }
      }
    },

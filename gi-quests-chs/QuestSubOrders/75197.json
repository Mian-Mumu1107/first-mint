              "751970502"
            ]
          },
          "751970502": {
            "id": "751970502",
            "speakerId": 1002,
            "speakerName": "玩家",
            "text": "我要付多少钱？",
            "nextDialogs": [
              "751970503"
            ]
          },
          "751970503": {
            "id": "751970503",
            "speakerId": 1667,
            "speakerName": "乌尔班",
            "text": "钱？不需要，你能拿来这些材料让我制作武器，我就已经很满足了，你不需要再付钱给我。",
            "nextDialogs": [
              "751970504"
            ]
          },
          "751970504": {
            "id": "751970504",
            "speakerId": 1667,
            "speakerName": "乌尔班",
            "text": "好了，拿着这把武器去冒险吧，你可要好好珍惜它啊。"
          }
        }
      }
    },

  "subQuests": [
    {
      "subId": "7519701",
      "subQuestName": "与乌尔班对话",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "751970102"
        ],
        "dialogs": {
          "751970102": {
            "id": "751970102",
            "speakerId": 1667,
            "speakerName": "乌尔班",
            "text": "你回来了，那些「牙齿」…哦，你已经找齐了啊。",
            "nextDialogs": [
              "751970103"
            ]
          },
          "751970103": {
            "id": "751970103",
            "speakerId": 1667,
            "speakerName": "乌尔班",
            "text": "你们去冒险的时候，我这边遇到了点问题，无论我用什么方法，都没办法从这枚「牙齿」上敲下来一点碎屑。",
            "nextDialogs": [
              "751970104"
            ]
          },
          "751970104": {
            "id": "751970104",
            "speakerId": 1667,
            "speakerName": "乌尔班",
            "text": "我还从没遇到过这样的奇事，于是就托人去问了阿贝多先生，该怎么处理这样的材料。",
            "nextDialogs": [
              "751970105"
            ]
          },
          "751970105": {
            "id": "751970105",
            "speakerId": 1667,
            "speakerName": "乌尔班",
            "text": "于是——喏，你看，阿贝多先生托砂糖小姐送来了一块符石，就摆在那边的炼金合成台上了。",
            "nextDialogs": [
              "751970106"
            ]
          },
          "751970106": {
            "id": "751970106",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "欸，符石？这和我们找到的「龙牙」有什么关系吗？",
            "nextDialogs": [
              "751970107"
            ]
          },
          "751970107": {
            "id": "751970107",
            "speakerId": 1667,
            "speakerName": "乌尔班",
            "text": "这个嘛，按照砂糖小姐转述阿贝多先生的说法，要想用这种材料来锻造武器，必须先进行一些特殊处理。",
            "nextDialogs": [
              "751970108"
            ]
          },
          "751970108": {
            "id": "751970108",
            "speakerId": 1667,
            "speakerName": "乌尔班",
            "text": "其中一种处理方法，就是让一枚龙牙汲取到某种和龙有关的「生命力」，再用它来处理其他龙牙。",
            "nextDialogs": [
              "751970109"
            ]
          },
          "751970109": {
            "id": "751970109",
            "speakerId": 1667,
            "speakerName": "乌尔班",
            "text": "这枚符石——我想想砂糖小姐是怎么说的——哦对，据说是「一千年前帮助蒙德反抗旧贵族的某支流浪乐团留给骑士团的遗物」。",
            "nextDialogs": [
              "751970110"
            ]
          },
          "751970110": {
            "id": "751970110",
            "speakerId": 1667,
            "speakerName": "乌尔班",
            "text": "那支乐团的笛手，曾在烬寂海与当地人称作「巴窟纳瓦」的可怖魔兽交战，从它身上斩下了这块符石…",
            "nextDialogs": [
              "751970111"
            ]
          },
          "751970111": {
            "id": "751970111",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "咦？等一下喔，如果我没记错的话，茜特菈莉好像说过，烬寂海是在五百年前，因为桑哈杰的战斗，才成为烬寂海的…",
            "nextDialogs": [
              "751970112"
            ]
          },
          "751970112": {
            "id": "751970112",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "那支乐团真的是一千年前的人吗？",
            "nextDialogs": [
              "751970113"
            ]
          },
          "751970113": {
            "id": "751970113",
            "speakerId": 1667,
            "speakerName": "乌尔班",
            "text": "哈哈，这怎么可能有错呢？那支流浪的乐团可是活跃在旧贵族时代的英雄，《列王与宗室史》中就有记载。",
            "nextDialogs": [
              "751970114"
            ]
          },
          "751970114": {
            "id": "751970114",
            "speakerId": 1667,
            "speakerName": "乌尔班",
            "text": "总之，阿贝多先生说，这块符石中就蕴藏着与龙的力量相近的「无限的生命力」。",
            "nextDialogs": [
              "751970115"
            ]
          },
          "751970115": {
            "id": "751970115",
            "speakerId": 1667,
            "speakerName": "乌尔班",
            "text": "只要借助炼金合成台，用龙牙汲取符石中的生命力，就能用它来锻造武器了。",
            "nextDialogs": [
              "751970116"
            ]
          },
          "751970116": {
            "id": "751970116",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "听、听起来好像很厉害…该说不愧是阿贝多吗…",
            "nextDialogs": [
              "751970118"
            ]
          },
          "751970118": {
            "id": "751970118",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "#是呀是呀！否则真不知道要怎么办才好…总之，{NICKNAME}，我们接下来就试试汲取符石的力量吧！",
            "nextDialogs": [
              "751970120"
            ]
          },
          "751970120": {
            "id": "751970120",
            "speakerId": 1667,
            "speakerName": "乌尔班",
            "text": "哈哈，那就太好了。来，这枚「牙齿」给你，这件事就拜托你了。",
            "nextDialogs": [
              "751970121"
            ]
          },
          "751970121": {
            "id": "751970121",
            "speakerId": 1667,
            "speakerName": "乌尔班",
            "text": "不过，炼金术的力量还真神奇啊，居然能从千年前的石头里提取出「生命力」…究竟是怎么做到的呢？"
          }
        }
      }
    },

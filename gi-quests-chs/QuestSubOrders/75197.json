            "speakerName": "Player",
            "text": "放置龙牙"
          }
        }
      }
    },
    {
      "subId": "7519704",
      "subQuestName": "与乌尔班对话",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "751970505"
        ],
        "dialogs": {
          "751970505": {
            "id": "751970505",
            "speakerId": 1003,
            "speakerName": "Black Screen",
            "text": "乌尔班开始制作武器…"
          }
        }
      }
    },
    {
      "subId": "7519704",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "751970401"
        ],
        "dialogs": {
          "751970401": {
            "id": "751970401",
            "speakerId": 1667,
            "speakerName": "乌尔班",
            "text": "哦！怎么样了，旅行者？龙牙能从<color=#00E1FFFF>那边的炼金合成台</color>汲取到力量吗？",
            "nextDialogs": [
              "751970402"
            ]
          },
          "751970402": {
            "id": "751970402",
            "speakerId": 1667,
            "speakerName": "乌尔班",
            "text": "没错，没错！这个光泽，这个质感…",
            "nextDialogs": [
              "751970403"
            ]
          },
          "751970403": {
            "id": "751970403",
            "speakerId": 1667,
            "speakerName": "乌尔班",
            "text": "哈哈哈，真没想到炼金术还能办到这种不得了的神奇事情，真不愧是阿贝多先生！",
            "nextDialogs": [
              "751970404"
            ]
          },
          "751970404": {
            "id": "751970404",
            "speakerId": 1667,
            "speakerName": "乌尔班",
            "text": "辛苦你们帮忙了，我对炼金可是一点头绪都没有。好，这样一来材料就备齐了，你在这稍微等一下，我马上就能把那柄武器做好！"
          }
        }
      }
    },
    {
      "subId": "7519707",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "751970701"
        ],
        "dialogs": {
          "751970701": {
            "id": "751970701",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "关于「龙牙」…",
            "nextDialogs": [
              "751970702"
            ]
          },
          "751970702": {
            "id": "751970702",
            "speakerId": 1667,
            "speakerName": "乌尔班",
            "text": "哦，你们回来了啊！怎么样了？",
            "nextDialogs": [
              "751970703"
            ]
          },
          "751970703": {
            "id": "751970703",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "呃，我们还没来得及汲取「生命力」，就…",
            "nextDialogs": [
              "751970704"
            ]
          },
          "751970704": {
            "id": "751970704",
            "speakerId": 1003,
            "speakerName": "Black Screen",
            "text": "向乌尔班讲述了之前发生的事情…",
            "nextDialogs": [
              "751970705"
            ]
          },
          "751970705": {
            "id": "751970705",
            "speakerId": 1667,
            "speakerName": "乌尔班",
            "text": "没想到还会发生这种事啊…唉，人没事就好，平平安安回来比什么都重要。",
            "nextDialogs": [
              "751970706"
            ]
          },
          "751970706": {
            "id": "751970706",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "呜呜，可是可是，这样一来，这些「龙牙」就彻底没法锻造了…",
            "nextDialogs": [
              "751970707"
            ]
          },
          "751970707": {
            "id": "751970707",
            "speakerId": 1667,
            "speakerName": "乌尔班",
            "text": "啊，这倒是不必担心。",
            "nextDialogs": [
              "751970708"
            ]
          },
          "751970708": {
            "id": "751970708",
            "speakerId": 1667,
            "speakerName": "乌尔班",
            "text": "你们去冒险的时候，我专门托人去问了阿贝多先生，该怎么处理这样的材料。",
            "nextDialogs": [
              "751970709"
            ]
          },
          "751970709": {
            "id": "751970709",
            "speakerId": 1667,
            "speakerName": "乌尔班",
            "text": "于是——喏，你看，阿贝多先生托砂糖小姐送来了一块符石，就摆在那边的炼金合成台上了。",
            "nextDialogs": [
              "751970710"
            ]
          },
          "751970710": {
            "id": "751970710",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "符石？",
            "nextDialogs": [
              "751970711"
            ]
          },
          "751970711": {
            "id": "751970711",
            "speakerId": 1667,
            "speakerName": "乌尔班",
            "text": "是呀，我想想砂糖小姐是怎么说的…哦对，这据说是「一千年前帮助蒙德反抗旧贵族的某支流浪乐团留给骑士团的遗物」。",
            "nextDialogs": [
              "751970712"
            ]
          },
          "751970712": {
            "id": "751970712",
            "speakerId": 1667,
            "speakerName": "乌尔班",
            "text": "那支乐团的笛手，曾在烬寂海与当地人称作「巴窟纳瓦」的可怖魔兽交战，从它身上斩下了这块符石…",
            "nextDialogs": [
              "751970713"
            ]
          },
          "751970713": {
            "id": "751970713",
            "speakerId": 1667,
            "speakerName": "乌尔班",
            "text": "总之，阿贝多先生说，这块符石中就蕴藏着与龙的力量相近的「无限的生命力」。",
            "nextDialogs": [
              "751970714"
            ]
          },
          "751970714": {
            "id": "751970714",
            "speakerId": 1667,
            "speakerName": "乌尔班",
            "text": "只要借助炼金合成台，用龙牙汲取符石中的生命力，就能用它来锻造武器了。",
            "nextDialogs": [
              "751970715"
            ]
          },
          "751970715": {
            "id": "751970715",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "听、听起来好像很厉害…该说不愧是阿贝多吗…",
            "nextDialogs": [
              "751970717"
            ]
          },
          "751970717": {
            "id": "751970717",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "#是呀是呀！否则真不知道要怎么办才好…总之，{NICKNAME}，我们接下来就试试汲取符石的力量吧！",
            "nextDialogs": [
              "751970719"
            ]
          },
          "751970719": {
            "id": "751970719",
            "speakerId": 1667,
            "speakerName": "乌尔班",
            "text": "哈哈，那就太好了。来，这枚「牙齿」给你，这件事就拜托你了。",
            "nextDialogs": [
              "751970720"
            ]
          },
          "751970720": {
            "id": "751970720",
            "speakerId": 1667,
            "speakerName": "乌尔班",
            "text": "不过，炼金术的力量还真神奇啊，居然能从千年前的石头里提取出「生命力」…究竟是怎么做到的呢？"
          }
        }
      }
    }
  ]
}
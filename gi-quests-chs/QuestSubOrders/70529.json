      }
    },
    {
      "subId": "7052902",
      "subQuestName": "与莉兹对话",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "705290201"
        ],
        "dialogs": {
          "705290201": {
            "id": "705290201",
            "speakerId": 30046,
            "speakerName": "莉兹",
            "text": "您好！欢迎来到风花节，您来得可真是时候，我这里正在举办一项叫做「风物之歌」的小游戏。",
            "nextDialogs": [
              "705290202"
            ]
          },
          "705290202": {
            "id": "705290202",
            "speakerId": 30046,
            "speakerName": "莉兹",
            "text": "在这项小游戏里，您能够像蒙德城里的吟游诗人一样，弹奏出动听的曲子…",
            "nextDialogs": [
              "705290205"
            ]
          },
          "705290205": {
            "id": "705290205",
            "speakerId": 30046,
            "speakerName": "莉兹",
            "text": "放心吧！这项小游戏我可是…那个…找了很多人试玩过的！",
            "nextDialogs": [
              "705290206"
            ]
          },
          "705290206": {
            "id": "705290206",
            "speakerId": 30046,
            "speakerName": "莉兹",
            "text": "就算是最不会弹奏乐器的人，也至少能弹出一首…呃…至少不难听的曲子…",
            "nextDialogs": [
              "705290207"
            ]
          },
          "705290207": {
            "id": "705290207",
            "speakerId": 30046,
            "speakerName": "莉兹",
            "text": "相信我！相信西风骑士团！",
            "nextDialogs": [
              "705290208"
            ]
          },
          "705290208": {
            "id": "705290208",
            "speakerId": 30046,
            "speakerName": "莉兹",
            "text": "只要集中注意力跟上节拍和节奏，肯定能轻松弹奏出一首像样的旋律。",
            "nextDialogs": [
              "705290209"
            ]
          },
          "705290209": {
            "id": "705290209",
            "speakerId": 30046,
            "speakerName": "莉兹",
            "text": "在风中全神贯注地弹奏着优美动听的旋律…这样，您肯定能把烦心事都忘掉。",
            "nextDialogs": [
              "705290210"
            ]
          },
          "705290210": {
            "id": "705290210",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "那吟游诗人肯定最没烦心事。",
            "nextDialogs": [
              "705290211"
            ]
          },
          "705290211": {
            "id": "705290211",
            "speakerId": 30046,
            "speakerName": "莉兹",
            "text": "哈哈哈，那可不一定，毕竟他们会本能地担心，这首曲子是不是优美到让人愿意付钱呢。",
            "nextDialogs": [
              "705290212"
            ]
          },
          "705290212": {
            "id": "705290212",
            "speakerId": 30046,
            "speakerName": "莉兹",
            "text": "而您嘛…只需要弹得让自己开心就好。",
            "nextDialogs": [
              "705290213"
            ]
          },
          "705290213": {
            "id": "705290213",
            "speakerId": 30046,
            "speakerName": "莉兹",
            "text": "咳！我…我刚才啥都没说！您应该了解这个小游戏的玩法了吧？如果有兴趣的话，请您来试试看吧。",
            "nextDialogs": [
              "705290214"
            ]
          },
          "705290214": {
            "id": "705290214",
            "speakerId": 30046,
            "speakerName": "莉兹",
            "text": "您可以用自己的乐器来弹奏曲子，如果您没带乐器的话，我们这边也可以借您一些…",
            "nextDialogs": [
              "705290215"
            ]
          },
          "705290215": {
            "id": "705290215",
            "speakerId": 30046,
            "speakerName": "莉兹",
            "text": "嘿嘿…我们这里可是有很多乐器的，每一种乐器弹奏时的手感都不一样。",
            "nextDialogs": [
              "705290216"
            ]
          },
          "705290216": {
            "id": "705290216",
            "speakerId": 30046,
            "speakerName": "莉兹",
            "text": "您想先用哪一把乐器来弹奏呢？"
          }
        }
      }
    }
  ]
}
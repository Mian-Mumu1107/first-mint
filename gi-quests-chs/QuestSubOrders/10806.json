  },
  "subQuests": [
    {
      "subId": "1080601",
      "subQuestName": "",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "698220101"
        ],
        "dialogs": {
          "698220101": {
            "id": "698220101",
            "speakerId": 1000,
            "speakerName": "迪卢克",
            "text": "…嗯，最大的问题是定价。",
            "nextDialogs": [
              "698220102"
            ]
          },
          "698220102": {
            "id": "698220102",
            "speakerId": 1000,
            "speakerName": "迪卢克",
            "text": "哦，你来了，坐吧。",
            "nextDialogs": [
              "698220105"
            ]
          },
          "698220105": {
            "id": "698220105",
            "speakerId": 1000,
            "speakerName": "迪卢克",
            "text": "我在看酒庄这阵子的产量和销售汇报，没事，我刚看完。",
            "nextDialogs": [
              "698220106"
            ]
          },
          "698220106": {
            "id": "698220106",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "遇到麻烦了吗？",
            "nextDialogs": [
              "698220107"
            ]
          },
          "698220107": {
            "id": "698220107",
            "speakerId": 1000,
            "speakerName": "迪卢克",
            "text": "也不能说是什么大麻烦，只是上一批葡萄受气候影响，产量有所下降。",
            "nextDialogs": [
              "698220108"
            ]
          },
          "698220108": {
            "id": "698220108",
            "speakerId": 1000,
            "speakerName": "迪卢克",
            "text": "埃泽应对得很及时，那一批葡萄酿出的酒品质没有瑕疵，唯一需要我出面解决的是定价问题。",
            "nextDialogs": [
              "698220109"
            ]
          },
          "698220109": {
            "id": "698220109",
            "speakerId": 1000,
            "speakerName": "迪卢克",
            "text": "我们的供应量降低了，但来自蒙德和外部的需求没有变化，这种时候的定价需要慎重一点考虑。",
            "nextDialogs": [
              "698220110"
            ]
          },
          "698220110": {
            "id": "698220110",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "物以稀为贵…",
            "nextDialogs": [
              "698220111"
            ]
          },
          "698220111": {
            "id": "698220111",
            "speakerId": 1000,
            "speakerName": "迪卢克",
            "text": "正是。需求大于供给的时候，总会有人想为自己争取更多的利润，经销商们也都有这个意思。",
            "nextDialogs": [
              "698220112"
            ]
          },
          "698220112": {
            "id": "698220112",
            "speakerId": 1000,
            "speakerName": "迪卢克",
            "text": "但晨曦酒庄无意提价。酒庄的生意做了很久，购买晨曦酒庄出品的酒水已经是蒙德人生活的一部分。",
            "nextDialogs": [
              "698220113"
            ]
          },
          "698220113": {
            "id": "698220113",
            "speakerId": 1000,
            "speakerName": "迪卢克",
            "text": "为了短期利润破坏所有人对晨曦酒庄的回忆，没有必要。",
            "nextDialogs": [
              "698220114"
            ]
          },
          "698220114": {
            "id": "698220114",
            "speakerId": 1000,
            "speakerName": "迪卢克",
            "text": "我不缺那点钱。",
            "nextDialogs": [
              "698220115"
            ]
          },
          "698220115": {
            "id": "698220115",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "这就是酒庄老板的魄力吗！",
            "nextDialogs": [
              "698220116"
            ]
          },
          "698220116": {
            "id": "698220116",
            "speakerId": 1000,
            "speakerName": "迪卢克",
            "text": "…很意外吗？埃泽倒是很快接受了这个理由，立刻去找经销商了。",
            "nextDialogs": [
              "698220117"
            ]
          },
          "698220117": {
            "id": "698220117",
            "speakerId": 1000,
            "speakerName": "迪卢克",
            "text": "对了，你有阵子没来酒庄，要给你开一瓶喝的吗？"
          }
        }
      }
    }
  ]
}
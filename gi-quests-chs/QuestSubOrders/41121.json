        ],
        "dialogs": {
          "411210101": {
            "id": "411210101",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "我这就送过去。",
            "nextDialogs": [
              "411210102"
            ]
          },
          "411210102": {
            "id": "411210102",
            "speakerId": 1000,
            "speakerName": "莎拉",
            "text": "那就拜托你啦。",
            "nextDialogs": [
              "411210103"
            ]
          },
          "411210103": {
            "id": "411210103",
            "speakerId": 1000,
            "speakerName": "莎拉",
            "text": "对了，这份蒙德土豆饼刚刚出炉，可要小心点派送。",

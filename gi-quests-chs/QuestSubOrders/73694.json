{
  "lineCounts": {
    "Player": 3,
    "丹纳": 15
  },
  "subQuests": [
    {
      "subId": "7369401",
      "subQuestName": "与丹纳对话",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "736940101"
        ],
        "dialogs": {
          "736940101": {
            "id": "736940101",
            "speakerId": 1000,
            "speakerName": "丹纳",
            "text": "唔，大家怎么都一副疲惫的样子…",
            "nextDialogs": [
              "736940102"
            ]
          },
          "736940102": {
            "id": "736940102",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "这里在举办什么活动吗？",
            "nextDialogs": [
              "736940103"
            ]
          },
          "736940103": {
            "id": "736940103",
            "speakerId": 1000,
            "speakerName": "丹纳",
            "text": "你是…旅行者对吧？哈哈哈，久仰大名了。",
            "nextDialogs": [
              "736940104"
            ]
          },
          "736940104": {
            "id": "736940104",
            "speakerId": 1000,
            "speakerName": "丹纳",
            "text": "没错，我们伐护末那学院正在这里举办一个有关「考古」的小游戏。",
            "nextDialogs": [
              "736940105"
            ]
          },
          "736940105": {
            "id": "736940105",
            "speakerId": 1000,
            "speakerName": "丹纳",
            "text": "毕竟我们学院里有不少研究历史的学者，在这些学者的研究过程里，自然就免不了去亲自「考古」了。",
            "nextDialogs": [
              "736940106"
            ]
          },
          "736940106": {
            "id": "736940106",
            "speakerId": 1000,
            "speakerName": "丹纳",
            "text": "哎呀，别紧张，我们可不会让大家去真的考古啊。这次的活动，只是考古这种「行为」的一种模拟。",
            "nextDialogs": [
              "736940107"
            ]
          },
          "736940107": {
            "id": "736940107",
            "speakerId": 1000,
            "speakerName": "丹纳",
            "text": "我们已经预先在须弥城周围埋了不少「文物模型」…我们就暂且把埋着这些东西的地方称作「考古区」吧。",
            "nextDialogs": [
              "736940108"
            ]
          },
          "736940108": {
            "id": "736940108",
            "speakerId": 1000,
            "speakerName": "丹纳",
            "text": "参与活动的人，只需要拿上我们特别制作的探查器，在「考古区」内将埋藏的「文物模型」挖出来就好了。",
            "nextDialogs": [
              "736940109"
            ]
          },
          "736940109": {
            "id": "736940109",
            "speakerId": 1000,
            "speakerName": "丹纳",
            "text": "多亏了其他学院的同学，帮忙特制了一批容器和对应的探查器。",
            "nextDialogs": [
              "736940110"
            ]
          },
          "736940110": {
            "id": "736940110",
            "speakerId": 1000,
            "speakerName": "丹纳",
            "text": "怎么样，旅行者？你有没有兴趣试试看啊？",
            "nextDialogs": [
              "736940113"
            ]
          },
          "736940113": {
            "id": "736940113",
            "speakerId": 1000,
            "speakerName": "丹纳",
            "text": "哈哈哈，好！这是探查器，你拿好了。我再把「考古区」所在的位置标在<color=#00E1FFFF>考古手册</color>上…",
            "nextDialogs": [
              "736940114"
            ]
          },
          "736940114": {
            "id": "736940114",
            "speakerId": 1000,
            "speakerName": "丹纳",
            "text": "这样就行了，快去体验考古的乐趣吧，旅行者。",
            "nextDialogs": [
              "736940115"
            ]
          },
          "736940115": {
            "id": "736940115",
            "speakerId": 1000,
            "speakerName": "丹纳",
            "text": "如果你把所有的「文物模型」都找到了，记得回来找我拿礼物啊。",
            "nextDialogs": [
              "736940116"
            ]
          },
          "736940116": {
            "id": "736940116",
            "speakerId": 1000,
            "speakerName": "丹纳",
            "text": "寻找模型的时候，只要跟着探查器走就好了。为了方便分类，还用元素类别做了区分。",
            "nextDialogs": [
              "736940117"
            ]
          },
          "736940117": {
            "id": "736940117",
            "speakerId": 1000,
            "speakerName": "丹纳",
            "text": "不过…那些探查器原来是用来探测元素的，被临时改造后，还是可能被一些特定的元素影响…",
            "nextDialogs": [
              "736940118"
            ]
          },
          "736940118": {
            "id": "736940118",
            "speakerId": 1000,
            "speakerName": "丹纳",
            "text": "总之，只要把所有的「文物模型」都挖出来，我们还有好礼相赠喔。"
          }
        }
      }
    }
  ]
}
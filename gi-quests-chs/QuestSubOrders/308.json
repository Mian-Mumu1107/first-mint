    {
      "subId": "30801",
      "subQuestName": "与丽莎对话",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "3081101"
        ],
        "dialogs": {
          "3081101": {
            "id": "3081101",
            "speakerId": 1007,
            "speakerName": "丽莎",
            "text": "呀，小可爱。",
            "nextDialogs": [
              "3081102"
            ]
          },
          "3081102": {
            "id": "3081102",
            "speakerId": 1007,
            "speakerName": "丽莎",
            "text": "这么危险的事你也来帮忙，真令人感动。",
            "nextDialogs": [
              "3081103"
            ]
          },
          "3081103": {
            "id": "3081103",
            "speakerId": 1007,
            "speakerName": "丽莎",
            "text": "这段时间里有什么不明白的，都可以来问姐姐喔。",
            "nextDialogs": [
              "3081105",
              "3081109"
            ]
          },
          "3081105": {
            "id": "3081105",
            "speakerId": 1007,
            "speakerName": "丽莎",
            "text": "嗯，这个问题问得不错。",
            "nextDialogs": [
              "3081106"
            ]
          },
          "3081106": {
            "id": "3081106",
            "speakerId": 1007,
            "speakerName": "丽莎",
            "text": "基本上，就是体力活和脑力活之外的事吧。",
            "nextDialogs": [
              "3081107"
            ]
          },
          "3081107": {
            "id": "3081107",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "那究竟是还剩哪一种事啊！",
            "nextDialogs": [
              "3081111"
            ]
          },
          "3081111": {
            "id": "3081111",
            "speakerId": 1007,
            "speakerName": "丽莎",
            "text": "所以，你们也可以多信任我一些喔。"
          },
          "3081109": {
            "id": "3081109",
            "speakerId": 1007,
            "speakerName": "丽莎",
            "text": "嗯，这个问题问得不错。",
            "nextDialogs": [
              "3081110"
            ]
          },
          "3081110": {
            "id": "3081110",
            "speakerId": 1007,
            "speakerName": "丽莎",
            "text": "答案嘛，当然是因为琴信任我啦。"
          }
        }
      }
    },

    {
      "subId": "30814",
      "subQuestName": "(test)与丽莎对话$HIDDEN",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "3081401"
        ],
        "dialogs": {
          "3081401": {
            "id": "3081401",
            "speakerId": 1007,
            "speakerName": "丽莎",
            "text": "东风之龙，南风之狮，北风之狼，西风之鹰…",
            "nextDialogs": [
              "3081402"
            ]
          },
          "3081402": {
            "id": "3081402",
            "speakerId": 1007,
            "speakerName": "丽莎",
            "text": "它们是蒙德四方之风的守护者，也是风神「巴巴托斯」的眷属。",
            "nextDialogs": [
              "3081403"
            ]
          },
          "3081403": {
            "id": "3081403",
            "speakerId": 1007,
            "speakerName": "丽莎",
            "text": "特瓦林——这就是风魔龙的名字。",
            "nextDialogs": [
              "3081404"
            ]
          },
          "3081404": {
            "id": "3081404",
            "speakerId": 1007,
            "speakerName": "丽莎",
            "text": "在被人们称作魔龙以前，它曾是「四风守护」中的「东风之龙」。",
            "nextDialogs": [
              "3081405"
            ]
          },
          "3081405": {
            "id": "3081405",
            "speakerId": 1007,
            "speakerName": "丽莎",
            "text": "这就是，四方之风的力量中，特瓦林只能借用三方的原因了。",
            "nextDialogs": [
              "3081406"
            ]
          },
          "3081406": {
            "id": "3081406",
            "speakerId": 1007,
            "speakerName": "丽莎",
            "text": "从一开始，它就已经在燃尽「自己」了呀。",
            "nextDialogs": [
              "3081409"
            ]
          },
          "3081409": {
            "id": "3081409",
            "speakerId": 1007,
            "speakerName": "丽莎",
            "text": "我想…是因为「恨」吧。",
            "nextDialogs": [
              "3081410"
            ]
          },
          "3081410": {
            "id": "3081410",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "恨…？",
            "nextDialogs": [
              "3081411"
            ]
          },
          "3081411": {
            "id": "3081411",
            "speakerId": 1007,
            "speakerName": "丽莎",
            "text": "是对蒙德的憎恨啊。",
            "nextDialogs": [
              "3081412"
            ]
          },
          "3081412": {
            "id": "3081412",
            "speakerId": 1007,
            "speakerName": "丽莎",
            "text": "以恨意为驱动、将恨意作为比风更强的力量，化作魔龙…",
            "nextDialogs": [
              "3081413"
            ]
          },
          "3081413": {
            "id": "3081413",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "可是，「四风守护」之一，为什么反而会…",
            "nextDialogs": [
              "3081414"
            ]
          },
          "3081414": {
            "id": "3081414",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "憎恨它本该守护的那座城市呢？",
            "nextDialogs": [
              "3081415"
            ]
          },
          "3081415": {
            "id": "3081415",
            "speakerId": 1007,
            "speakerName": "丽莎",
            "text": "……",
            "nextDialogs": [
              "3081416"
            ]
          },
          "3081416": {
            "id": "3081416",
            "speakerId": 1007,
            "speakerName": "丽莎",
            "text": "身为蒙德人，真难自己说出口呀。",
            "nextDialogs": [
              "3081417"
            ]
          },
          "3081417": {
            "id": "3081417",
            "speakerId": 1007,
            "speakerName": "丽莎",
            "text": "拿去看吧…这是百年前发生的故事了。"
          }
        }
      }
    },

      }
    },
    {
      "subId": "2201503",
      "subQuestName": "打倒所有盗宝团",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "220150301"
        ],
        "dialogs": {
          "220150301": {
            "id": "220150301",
            "speakerId": 1001,
            "speakerName": "天野",
            "text": "珊瑚小姐，你刚才说的都是真的吗？",
            "nextDialogs": [
              "220150302"
            ]
          },
          "220150302": {
            "id": "220150302",
            "speakerId": 1002,
            "speakerName": "安藤",
            "text": "城里的连环盗窃案，真的是那些混账盗宝团干的吗？",
            "nextDialogs": [
              "220150303"
            ]
          },
          "220150303": {
            "id": "220150303",
            "speakerId": 1000,
            "speakerName": "珊瑚",
            "text": "那是当然。刚才我也给你看过那些证据了，凭二位的「职业直觉」…心里应该也已经有了判断吧。",
            "nextDialogs": [
              "220150304"
            ]
          },
          "220150304": {
            "id": "220150304",
            "speakerId": 1002,
            "speakerName": "安藤",
            "text": "这群盗宝团…真是胆大包天！这是不把我们放在眼里吗！",
            "nextDialogs": [
              "220150305"
            ]
          },
          "220150305": {
            "id": "220150305",
            "speakerId": 1002,
            "speakerName": "安藤",
            "text": "天野！我们快回去，把这件事往上报告吧。",
            "nextDialogs": [
              "220150306"
            ]
          },
          "220150306": {
            "id": "220150306",
            "speakerId": 1002,
            "speakerName": "安藤",
            "text": "一定要再加强巡逻，不能给这群混账一点可乘之机！",
            "nextDialogs": [
              "220150307"
            ]
          },
          "220150307": {
            "id": "220150307",
            "speakerId": 1001,
            "speakerName": "天野",
            "text": "珊瑚小姐，这些证据可以先借给我们一下吗？我们要用来说服大人们采取措施。",
            "nextDialogs": [
              "220150308"
            ]
          },
          "220150308": {
            "id": "220150308",
            "speakerId": 1000,
            "speakerName": "珊瑚",
            "text": "没问题，尽管拿走吧。毕竟盗宝团作乱这种大事，可不是我们侦探社能够处理的，只能拜托奉行所的大人们了。",
            "nextDialogs": [
              "220150309"
            ]
          },
          "220150309": {
            "id": "220150309",
            "speakerId": 1002,
            "speakerName": "安藤",
            "text": "放心吧！这群盗宝团…我们绝对一个都不放过！",
            "nextDialogs": [
              "220150310"
            ]
          },
          "220150310": {
            "id": "220150310",
            "speakerId": 1000,
            "speakerName": "珊瑚",
            "text": "辛苦你们了。现在…应该已经准备得差不多了。",
            "nextDialogs": [
              "220150312",
              "220150314"
            ]
          },
          "220150312": {
            "id": "220150312",
            "speakerId": 1000,
            "speakerName": "珊瑚",
            "text": "是，这两位奉行所的同心大人，可是结掉我手里这个案子的重要「帮助」。",
            "nextDialogs": [
              "220150316"
            ]
          },
          "220150316": {
            "id": "220150316",
            "speakerId": 1000,
            "speakerName": "珊瑚",
            "text": "在这两位同心大人加强巡逻后，城里的盗宝团一定也会提起警惕。",
            "nextDialogs": [
              "220150317"
            ]
          },
          "220150317": {
            "id": "220150317",
            "speakerId": 1000,
            "speakerName": "珊瑚",
            "text": "龙二，在我让你去的那个地方，你应该和那些盗宝团交过手了，对吧？",
            "nextDialogs": [
              "220150318"
            ]
          },
          "220150318": {
            "id": "220150318",
            "speakerId": 1003,
            "speakerName": "龙二",
            "text": "是的，社长，那些盗宝团都被我和这位旅行者击退了。",
            "nextDialogs": [
              "220150319"
            ]
          },
          "220150319": {
            "id": "220150319",
            "speakerId": 1000,
            "speakerName": "珊瑚",
            "text": "嗯…这样就好，你们折腾出的动静应该已经够大了。",
            "nextDialogs": [
              "220150320"
            ]
          },
          "220150320": {
            "id": "220150320",
            "speakerId": 1000,
            "speakerName": "珊瑚",
            "text": "接下来我们要做的，就是再等一个机会了。",
            "nextDialogs": [
              "220150321"
            ]
          },
          "220150321": {
            "id": "220150321",
            "speakerId": 1000,
            "speakerName": "珊瑚",
            "text": "辛苦你了旅行者，这些是报酬，请收下吧。",
            "nextDialogs": [
              "220150322"
            ]
          },
          "220150322": {
            "id": "220150322",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "我好像也没帮什么忙…",
            "nextDialogs": [
              "220150323"
            ]
          },
          "220150323": {
            "id": "220150323",
            "speakerId": 1000,
            "speakerName": "珊瑚",
            "text": "可不能这么说。以外国人的身份吸引住安藤，让他带着天野追着你和龙二汇合…",
            "nextDialogs": [
              "220150324"
            ]
          },
          "220150324": {
            "id": "220150324",
            "speakerId": 1000,
            "speakerName": "珊瑚",
            "text": "然后，让他们亲眼发现盗宝团的威胁，然后顺理成章地在城里加强巡逻…",
            "nextDialogs": [
              "220150325"
            ]
          },
          "220150325": {
            "id": "220150325",
            "speakerId": 1000,
            "speakerName": "珊瑚",
            "text": "这些，可都是只有你才能做到的事。",
            "nextDialogs": [
              "220150326"
            ]
          },
          "220150326": {
            "id": "220150326",
            "speakerId": 1000,
            "speakerName": "珊瑚",
            "text": "毕竟，比起我去告诉他们，让这两位同心「亲自发现」盗宝团的事，效果才更好嘛。",
            "nextDialogs": [
              "220150327"
            ]
          },
          "220150327": {
            "id": "220150327",
            "speakerId": 1000,
            "speakerName": "珊瑚",
            "text": "总之，收下这些东西吧，说不定…我之后还会再找你帮忙的。"
          },
          "220150314": {
            "id": "220150314",
            "speakerId": 1000,
            "speakerName": "珊瑚",
            "text": "我是侦探，要做的事，当然是要断案了。",
            "nextDialogs": [
              "220150315"
            ]
          },
          "220150315": {
            "id": "220150315",
            "speakerId": 1000,
            "speakerName": "珊瑚",
            "text": "这两位奉行所的同心大人，可是结掉我手里这个案子的重要「帮助」。"
          }
        }
      }
    },
    {
      "subId": "2201504",
      "subQuestName": "与龙二对话",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "220150205"
        ],
        "dialogs": {
          "220150205": {
            "id": "220150205",
            "speakerId": 1003,
            "speakerName": "龙二",
            "text": "原来如此，你就是社长说的「帮手」吗？",
            "nextDialogs": [
              "220150206"
            ]
          },
          "220150206": {
            "id": "220150206",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "你知道我要来？",
            "nextDialogs": [
              "220150207"
            ]
          },
          "220150207": {
            "id": "220150207",
            "speakerId": 1003,
            "speakerName": "龙二",
            "text": "唔…倒也不是。只是社长说，会有人来帮忙，",
            "nextDialogs": [
              "220150208"
            ]
          },
          "220150208": {
            "id": "220150208",
            "speakerId": 1002,
            "speakerName": "安藤",
            "text": "喂，你们在做什么呢？",
            "nextDialogs": [
              "220150209"
            ]
          },
          "220150209": {
            "id": "220150209",
            "speakerId": 1001,
            "speakerName": "天野",
            "text": "那些是盗宝团吗？为什么会离城里这么近…",
            "nextDialogs": [
              "220150210"
            ]
          },
          "220150210": {
            "id": "220150210",
            "speakerId": 1002,
            "speakerName": "安藤",
            "text": "龙二，你怎么也在这，还有这个可疑的外国人…",
            "nextDialogs": [
              "220150212",
              "220150214"
            ]
          },
          "220150212": {
            "id": "220150212",
            "speakerId": 1002,
            "speakerName": "安藤",
            "text": "对啊，这里的外国人也就你一个啊。",
            "nextDialogs": [
              "220150215"
            ]
          },
          "220150215": {
            "id": "220150215",
            "speakerId": 1001,
            "speakerName": "天野",
            "text": "好了，你也别太敏感了。龙二，你在这里做什么？",
            "nextDialogs": [
              "220150216"
            ]
          },
          "220150216": {
            "id": "220150216",
            "speakerId": 1003,
            "speakerName": "龙二",
            "text": "我只是根据社长的指示，跟踪可疑的人来到这里，但是却遇见了盗宝团。",
            "nextDialogs": [
              "220150217"
            ]
          },
          "220150217": {
            "id": "220150217",
            "speakerId": 1003,
            "speakerName": "龙二",
            "text": "这位旅行者确实是社长请来的帮手，刚才和我一起击退了那些盗宝团。",
            "nextDialogs": [
              "220150218"
            ]
          },
          "220150218": {
            "id": "220150218",
            "speakerId": 1001,
            "speakerName": "天野",
            "text": "这样吗…但是，这附近为什么会出现盗宝团？",
            "nextDialogs": [
              "220150219"
            ]
          },
          "220150219": {
            "id": "220150219",
            "speakerId": 1002,
            "speakerName": "安藤",
            "text": "龙二，你刚才还说什么，跟踪可疑的人…喂！难不成，你是从城里跟踪盗宝团过来的？",
            "nextDialogs": [
              "220150220"
            ]
          },
          "220150220": {
            "id": "220150220",
            "speakerId": 1003,
            "speakerName": "龙二",
            "text": "正是如此。社长之前正在处理一桩连续盗窃案，根据社长的推理，我在城里四处搜索。",
            "nextDialogs": [
              "220150221"
            ]
          },
          "220150221": {
            "id": "220150221",
            "speakerId": 1003,
            "speakerName": "龙二",
            "text": "随后，我在花见坂附近发现了可疑的人。但只是略微盘问了几句，他就慌张地离开了。",
            "nextDialogs": [
              "220150222"
            ]
          },
          "220150222": {
            "id": "220150222",
            "speakerId": 1003,
            "speakerName": "龙二",
            "text": "我追着他出了城，之后的事，你们都了解了。",
            "nextDialogs": [
              "220150223"
            ]
          },
          "220150223": {
            "id": "220150223",
            "speakerId": 1002,
            "speakerName": "安藤",
            "text": "喔…龙二，你小子怎么突然这么会说话了，之前你不是都不怎么说话的吗？",
            "nextDialogs": [
              "220150224"
            ]
          },
          "220150224": {
            "id": "220150224",
            "speakerId": 1001,
            "speakerName": "天野",
            "text": "跟着珊瑚做事，把口才也锻炼得不错了嘛。"
          },
          "220150214": {
            "id": "220150214",
            "speakerId": 1002,
            "speakerName": "安藤",
            "text": "珊瑚的帮手？听起来反倒更可疑了…"
          }
        }
      }
    },
    {
      "subId": "2201505",
      "subQuestName": "与珊瑚对话",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [],
        "dialogs": {}
      }
    },
    {
      "subId": "2201501",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "220150101"
        ],
        "dialogs": {
          "220150101": {
            "id": "220150101",
            "speakerId": 1000,
            "speakerName": "珊瑚",
            "text": "差不多要到时候了…",
            "nextDialogs": [
              "220150102"
            ]
          },
          "220150102": {
            "id": "220150102",
            "speakerId": 1000,
            "speakerName": "珊瑚",
            "text": "哦呀，欢迎光临，阁下是遇见什么难题了吗？",
            "nextDialogs": [
              "220150103"
            ]
          },
          "220150103": {
            "id": "220150103",
            "speakerId": 1000,
            "speakerName": "珊瑚",
            "text": "唔，原来如此，你…没遇见什么难题，只是想要「随便逛逛」而已…",
            "nextDialogs": [
              "220150104"
            ]
          },
          "220150104": {
            "id": "220150104",
            "speakerId": 1000,
            "speakerName": "珊瑚",
            "text": "这里是「万端珊瑚侦探社」，是一个很寻常的地方，而我嘛…是一个侦探。",
            "nextDialogs": [
              "220150106",
              "220150109"
            ]
          },
          "220150106": {
            "id": "220150106",
            "speakerId": 1000,
            "speakerName": "珊瑚",
            "text": "我叫珊瑚，是这家侦探社的社长。",
            "nextDialogs": [
              "220150107"
            ]
          },
          "220150107": {
            "id": "220150107",
            "speakerId": 1000,
            "speakerName": "珊瑚",
            "text": "不过，虽然说是社长，但这家侦探社也只有两个员工罢了。",
            "nextDialogs": [
              "220150113"
            ]
          },
          "220150113": {
            "id": "220150113",
            "speakerId": 1000,
            "speakerName": "珊瑚",
            "text": "怎么，你是第一次看见这种侦探社吗？"
          },
          "220150109": {
            "id": "220150109",
            "speakerId": 1000,
            "speakerName": "珊瑚",
            "text": "喔，这是个好问题。从一般人的视角来看，侦探这种职业也许特殊又神秘。",
            "nextDialogs": [
              "220150110"
            ]
          },
          "220150110": {
            "id": "220150110",
            "speakerId": 1000,
            "speakerName": "珊瑚",
            "text": "但要我来说，侦探也只是一种「拿钱办事」的普通职业罢了。",
            "nextDialogs": [
              "220150111"
            ]
          },
          "220150111": {
            "id": "220150111",
            "speakerId": 1000,
            "speakerName": "珊瑚",
            "text": "虽然办的事有时候会不太寻常，委托人偶尔也有些特别…",
            "nextDialogs": [
              "220150112"
            ]
          },
          "220150112": {
            "id": "220150112",
            "speakerId": 1000,
            "speakerName": "珊瑚",
            "text": "但无论如何，都脱不开「拿钱办事」这个行事主旨就是了。"
          }
        }
      }
    },
    {
      "subId": "2201505",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "220150501"
        ],
        "dialogs": {
          "220150501": {
            "id": "220150501",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "没有在蒙德看见过。",
            "nextDialogs": [
              "220150502"
            ]
          },
          "220150502": {
            "id": "220150502",
            "speakerId": 1000,
            "speakerName": "珊瑚",
            "text": "蒙德…哦，你是说蒙德城吧，我倒是对那座城市有所耳闻。",
            "nextDialogs": [
              "220150503"
            ]
          },
          "220150503": {
            "id": "220150503",
            "speakerId": 1000,
            "speakerName": "珊瑚",
            "text": "蒙德最著名的两种特产，一种是酒，另一种是「自由」，对吧？",
            "nextDialogs": [
              "220150504"
            ]
          },
          "220150504": {
            "id": "220150504",
            "speakerId": 1000,
            "speakerName": "珊瑚",
            "text": "哈哈哈，这两种特产还真是相辅相成…是蒙德城里有侦探的话，肯定天天都会生意兴隆的。"
          }
        }
      }
    },
    {
      "subId": "2201506",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "220150601"
        ],
        "dialogs": {
          "220150601": {
            "id": "220150601",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "没有在璃月看见过。",
            "nextDialogs": [
              "220150602"
            ]
          },
          "220150602": {
            "id": "220150602",
            "speakerId": 1000,
            "speakerName": "珊瑚",
            "text": "璃月也不太需要侦探啦。那边对「契约」的重视程度我也听说过一些。",
            "nextDialogs": [
              "220150603"
            ]
          },
          "220150603": {
            "id": "220150603",
            "speakerId": 1000,
            "speakerName": "珊瑚",
            "text": "而且，他们还有无论大事小情都会迅速到场解决的「千岩军」…",
            "nextDialogs": [
              "220150604"
            ]
          },
          "220150604": {
            "id": "220150604",
            "speakerId": 1000,
            "speakerName": "珊瑚",
            "text": "就算那边有侦探社，估计也会因为生意太少而迅速倒闭啦。"
          }
        }
      }
    },
    {
      "subId": "2201507",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "220150701"
        ],
        "dialogs": {
          "220150701": {
            "id": "220150701",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "我只遇见过一位「律法咨询师」…",
            "nextDialogs": [
              "220150702"
            ]
          },
          "220150702": {
            "id": "220150702",
            "speakerId": 1000,
            "speakerName": "珊瑚",
            "text": "「律法咨询师」？啊…我听说过，这种人…最难缠了。",
            "nextDialogs": [
              "220150703"
            ]
          },
          "220150703": {
            "id": "220150703",
            "speakerId": 1000,
            "speakerName": "珊瑚",
            "text": "我想，这种人最擅长的事应该就是把简单的问题复杂化，把复杂的问题公式化，再把公式化的问题契约化。",
            "nextDialogs": [
              "220150704"
            ]
          },
          "220150704": {
            "id": "220150704",
            "speakerId": 1000,
            "speakerName": "珊瑚",
            "text": "如果可以的话，我希望我永远不要遇见这种人。"
          }
        }
      }
    },
    {
      "subId": "2201509",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "220150901"
        ],
        "dialogs": {
          "220150901": {
            "id": "220150901",
            "speakerId": 1000,
            "speakerName": "珊瑚",
            "text": "那么，这件事就拜托你咯，我会准备好报酬的，顺便…你也能亲身体验一下侦探的工作。",
            "nextDialogs": [
              "220150903",
              "220150906"
            ]
          },
          "220150903": {
            "id": "220150903",
            "speakerId": 1000,
            "speakerName": "珊瑚",
            "text": "那家伙身手很好，不用担心。",
            "nextDialogs": [
              "220150904"
            ]
          },
          "220150904": {
            "id": "220150904",
            "speakerId": 1000,
            "speakerName": "珊瑚",
            "text": "怎么说，他也是曾经在奉行所里做过同心的人。"
          },
          "220150906": {
            "id": "220150906",
            "speakerId": 1000,
            "speakerName": "珊瑚",
            "text": "唔，怎么说呢…我们俩各有分工。",
            "nextDialogs": [
              "220150907"
            ]
          },
          "220150907": {
            "id": "220150907",
            "speakerId": 1000,
            "speakerName": "珊瑚",
            "text": "他负责搜集证据和线索，而我则负责分析归纳，找出真相。",
            "nextDialogs": [
              "220150908"
            ]
          },
          "220150908": {
            "id": "220150908",
            "speakerId": 1000,
            "speakerName": "珊瑚",
            "text": "一个合理的工作模式，是一家侦探社良好运转的基础嘛。"
          }
        }
      }
    }
  ]
}
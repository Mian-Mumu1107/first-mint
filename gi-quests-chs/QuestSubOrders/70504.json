  "subQuests": [
    {
      "subId": "7050401",
      "subQuestName": "与卢卡对话，进入酒馆",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "705040101"
        ],
        "dialogs": {
          "705040101": {
            "id": "705040101",
            "speakerId": 1000,
            "speakerName": "凯亚",
            "text": "哟，今天的酒保居然是你，真是罕见。",
            "nextDialogs": [
              "705040102"
            ]
          },
          "705040102": {
            "id": "705040102",
            "speakerId": 1000,
            "speakerName": "凯亚",
            "text": "那我就要一杯午后之…",
            "nextDialogs": [
              "705040103"
            ]
          },
          "705040103": {
            "id": "705040103",
            "speakerId": 1001,
            "speakerName": "罗莎莉亚",
            "text": "一开口就为难别人，真有你的。",
            "nextDialogs": [
              "705040104"
            ]
          },
          "705040104": {
            "id": "705040104",
            "speakerId": 1000,
            "speakerName": "凯亚",
            "text": "#哎呀，只是想看{M#他}{F#她}如何应对嘛。倒是没想到罗莎莉亚小姐今天也来喝酒了。",
            "nextDialogs": [
              "705040105"
            ]
          },
          "705040105": {
            "id": "705040105",
            "speakerId": 1000,
            "speakerName": "凯亚",
            "text": "酒馆里刁钻的客人那么多，旅行者不早点积累起经验可不行啊。",
            "nextDialogs": [
              "705040106"
            ]
          },
          "705040106": {
            "id": "705040106",
            "speakerId": 1002,
            "speakerName": "派蒙",
            "text": "凯亚还是那么油嘴滑舌！",
            "nextDialogs": [
              "705040107"
            ]
          },
          "705040107": {
            "id": "705040107",
            "speakerId": 1000,
            "speakerName": "凯亚",
            "text": "冤枉啊，我是一片好意！你不是应该感谢我吗？比如说，给我来一杯简简单单的月夜暗巷什么的。",
            "nextDialogs": [
              "705040108"
            ]
          },
          "705040108": {
            "id": "705040108",
            "speakerId": 1000,
            "speakerName": "凯亚",
            "text": "啊对，要大杯！",
            "nextDialogs": [
              "705040109"
            ]
          },
          "705040109": {
            "id": "705040109",
            "speakerId": 1001,
            "speakerName": "罗莎莉亚",
            "text": "给我随便来一杯。有茶香的饮品都行，量不用太大。",
            "nextDialogs": [
              "705040110"
            ]
          },
          "705040110": {
            "id": "705040110",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "明白了，请稍等片刻。",
            "nextDialogs": [
              "705040111"
            ]
          },
          "705040111": {
            "id": "705040111",
            "speakerId": 1000,
            "speakerName": "凯亚",
            "text": "慢慢来。等待美味出品的时间，也是很令人兴奋的。"
          }
        }
      }
    },

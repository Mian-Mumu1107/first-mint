  "subQuests": [
    {
      "subId": "7468101",
      "subQuestName": "与工作人员对话",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "746810101"
        ],
        "dialogs": {
          "746810101": {
            "id": "746810101",
            "speakerId": 1000,
            "speakerName": "梅里爱",
            "text": "啊哈，啊哈哈哈哈哈哈哈哈哈…散发着耀眼光芒的两位客人，你们终于来了！",
            "nextDialogs": [
              "746810102"
            ]
          },
          "746810102": {
            "id": "746810102",
            "speakerId": 1000,
            "speakerName": "梅里爱",
            "text": "#你们想必就是提瓦特今日的传说冒险家，明日的超级巨星——{NICKNAME}和派蒙吧！",
            "nextDialogs": [
              "746810104",
              "746810106"
            ]
          },
          "746810104": {
            "id": "746810104",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "我们的确在冒险家协会很有名气，但要说全提瓦特的超级巨星，好像太过火了？毕竟也有很多人不认识我们…",
            "nextDialogs": [
              "746810107"
            ]
          },
          "746810107": {
            "id": "746810107",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "印象里，见面就狠狠夸我们的人…大多都是要找我们帮忙的！",
            "nextDialogs": [
              "746810108"
            ]
          },
          "746810108": {
            "id": "746810108",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "那你就直说吧，你的需求是什么？",
            "nextDialogs": [
              "746810109"
            ]
          },
          "746810109": {
            "id": "746810109",
            "speakerId": 1000,
            "speakerName": "梅里爱",
            "text": "不不不，我并非有求于两位，而是要为你们提供一个双赢的机会——",
            "nextDialogs": [
              "746810110"
            ]
          },
          "746810110": {
            "id": "746810110",
            "speakerId": 1000,
            "speakerName": "梅里爱",
            "text": "与我，枫丹才华最为横溢的「实验映影」导演梅里爱合作，成为映幕上最为闪亮的存在！",
            "nextDialogs": [
              "746810111"
            ]
          },
          "746810111": {
            "id": "746810111",
            "speakerId": 1000,
            "speakerName": "梅里爱",
            "text": "到时你们要钱有钱，要人脉有人脉。",
            "nextDialogs": [
              "746810112"
            ]
          },
          "746810112": {
            "id": "746810112",
            "speakerId": 1000,
            "speakerName": "梅里爱",
            "text": "无论身处提瓦特的何方，横着走都没人敢拦，甚至会有人给你们铺红地毯！"
          },
          "746810106": {
            "id": "746810106",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "好夸张的语气，还用了奇奇怪怪的形容词…"
          }
        }
      }
    }
  ]
}
    {
      "subId": "7407510",
      "subQuestName": "",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "740752701"
        ],
        "dialogs": {
          "740752701": {
            "id": "740752701",
            "speakerId": 1004,
            "speakerName": "Black Screen",
            "text": "仔细检查了机关顶部的空间，什么都没有发现。",
            "nextDialogs": [
              "740752702"
            ]
          },
          "740752702": {
            "id": "740752702",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "结果最后这里什么都没有吗？",
            "nextDialogs": [
              "740752703"
            ]
          },
          "740752703": {
            "id": "740752703",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "不对，好像是东西已经被人拿走了。",
            "nextDialogs": [
              "740752704"
            ]
          },
          "740752704": {
            "id": "740752704",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "究竟是谁呢？"
          }
        }
      }
    },
    {
      "subId": "7407505",
      "subQuestName": "获取「灵魂」之块",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "740751601"
        ],
        "dialogs": {
          "740751601": {
            "id": "740751601",
            "speakerId": 1004,
            "speakerName": "Black Screen",
            "text": "仔细检查了机关顶部的空间，什么都没有发现。",
            "nextDialogs": [
              "740751602"
            ]
          },
          "740751602": {
            "id": "740751602",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "结果最后这里什么都没有吗？",
            "nextDialogs": [
              "740751603"
            ]
          },
          "740751603": {
            "id": "740751603",
            "speakerId": 21048,
            "speakerName": "卡特皮拉",
            "text": "并不是，看起来是已经被人拿走了。",
            "nextDialogs": [
              "740751604"
            ]
          },
          "740751604": {
            "id": "740751604",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "那岂不是我们的计划已经失败了？",
            "nextDialogs": [
              "740751605"
            ]
          },
          "740751605": {
            "id": "740751605",
            "speakerId": 21048,
            "speakerName": "卡特皮拉",
            "text": "「理性」的诞生需要四个象限合一。只要我们能拿到剩下的几个，我们就还有机会。",
            "nextDialogs": [
              "740751606"
            ]
          },
          "740751606": {
            "id": "740751606",
            "speakerId": 16922,
            "speakerName": "安",
            "text": "既然如此，我们就快点去接下来的地方吧。"
          }
        }
      }
    },
    {
      "subId": "7407517",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "740751701"
        ],
        "dialogs": {
          "740751701": {
            "id": "740751701",
            "speakerId": 1004,
            "speakerName": "Black Screen",
            "text": "仔细检查了机关顶部的空间，什么都没有发现。",
            "nextDialogs": [
              "740751702"
            ]
          },
          "740751702": {
            "id": "740751702",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "这里依旧什么都没有欸…",
            "nextDialogs": [
              "740751703"
            ]
          },
          "740751703": {
            "id": "740751703",
            "speakerId": 16922,
            "speakerName": "安",
            "text": "所以卡特皮拉你能告诉我们，我们究竟要找什么吗？",
            "nextDialogs": [
              "740751704"
            ]
          },
          "740751704": {
            "id": "740751704",
            "speakerId": 21048,
            "speakerName": "卡特皮拉",
            "text": "我们是在寻找锻铸水仙十字圣剑的材料。",
            "nextDialogs": [
              "740751705"
            ]
          },
          "740751705": {
            "id": "740751705",
            "speakerId": 21048,
            "speakerName": "卡特皮拉",
            "text": "水仙十字结社依据地下之国与古枫丹的神秘哲学，在物质世界重现了必要的四种架空物质。",
            "nextDialogs": [
              "740751706"
            ]
          },
          "740751706": {
            "id": "740751706",
            "speakerId": 16924,
            "speakerName": "西摩尔",
            "text": "无法理解。",
            "nextDialogs": [
              "740751707"
            ]
          },
          "740751707": {
            "id": "740751707",
            "speakerId": 21048,
            "speakerName": "卡特皮拉",
            "text": "神秘的东西本身只作用于体验，可以说比元素力还要跳脱常理呢。",
            "nextDialogs": [
              "740751708"
            ]
          },
          "740751708": {
            "id": "740751708",
            "speakerId": 16924,
            "speakerName": "西摩尔",
            "text": "几十年前我录入过教令院的素论派入门至中级教材，元素力也没有那么神奇。",
            "nextDialogs": [
              "740751709"
            ]
          },
          "740751709": {
            "id": "740751709",
            "speakerId": 21048,
            "speakerName": "卡特皮拉",
            "text": "是吗。那反正结论上来说，这是枫丹古法与地下古国技术的交汇。",
            "nextDialogs": [
              "740751710"
            ]
          },
          "740751710": {
            "id": "740751710",
            "speakerId": 21048,
            "speakerName": "卡特皮拉",
            "text": "世界上出现了「记忆」、「愿望」、「灵魂」与「人格」这四种物质。",
            "nextDialogs": [
              "740751711"
            ]
          },
          "740751711": {
            "id": "740751711",
            "speakerId": 21048,
            "speakerName": "卡特皮拉",
            "text": "为了防止歧义，我们把它们叫做「记忆」之块、「愿望」之块、「灵魂」之块与「人格」之块好了。",
            "nextDialogs": [
              "740751712"
            ]
          },
          "740751712": {
            "id": "740751712",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "为什么这些东西会用来打造圣剑啊？",
            "nextDialogs": [
              "740751713"
            ]
          },
          "740751713": {
            "id": "740751713",
            "speakerId": 21048,
            "speakerName": "卡特皮拉",
            "text": "水仙十字结社的神秘哲学里，神殿是宇宙的缩影，社员是众神的代行，圣油是锤炼的意志。",
            "nextDialogs": [
              "740751714"
            ]
          },
          "740751714": {
            "id": "740751714",
            "speakerId": 21048,
            "speakerName": "卡特皮拉",
            "text": "圣剑，则是破开一切的「理性」。它需由完整的人之意志诞生而出。",
            "nextDialogs": [
              "740751715"
            ]
          },
          "740751715": {
            "id": "740751715",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "好玄乎。",
            "nextDialogs": [
              "740751716"
            ]
          },
          "740751716": {
            "id": "740751716",
            "speakerId": 21048,
            "speakerName": "卡特皮拉",
            "text": "哎呀，神秘哲学是这样的。看着相似就可以攀附。当这种东西变成魔法了就假成真的了。",
            "nextDialogs": [
              "740751717"
            ]
          },
          "740751717": {
            "id": "740751717",
            "speakerId": 21048,
            "speakerName": "卡特皮拉",
            "text": "总之我们赶紧去下一处地方吧。"
          }
        }
      }
    },
    {
      "subId": "7407518",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "740751801"
        ],
        "dialogs": {
          "740751801": {
            "id": "740751801",
            "speakerId": 1004,
            "speakerName": "Black Screen",
            "text": "仔细检查了机关顶部的空间，什么都没有发现。",
            "nextDialogs": [
              "740751802"
            ]
          },
          "740751802": {
            "id": "740751802",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "这里的东西…也被人拿走了吗？",
            "nextDialogs": [
              "740751803"
            ]
          },
          "740751803": {
            "id": "740751803",
            "speakerId": 21048,
            "speakerName": "卡特皮拉",
            "text": "看起来是这样。",
            "nextDialogs": [
              "740751804"
            ]
          },
          "740751804": {
            "id": "740751804",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "究竟是谁会…",
            "nextDialogs": [
              "740751805"
            ]
          },
          "740751805": {
            "id": "740751805",
            "speakerId": 21048,
            "speakerName": "卡特皮拉",
            "text": "是雅各布。",
            "nextDialogs": [
              "740751806"
            ]
          },
          "740751806": {
            "id": "740751806",
            "speakerId": 16924,
            "speakerName": "西摩尔",
            "text": "我们之前在厄里那斯曾经与其发生冲突。补充订正，是最近一段时间的厄里那斯。",
            "nextDialogs": [
              "740751807"
            ]
          },
          "740751807": {
            "id": "740751807",
            "speakerId": 21048,
            "speakerName": "卡特皮拉",
            "text": "之前看到大门口那个悲剧的受害者我就知道是他的手笔了。他果然还在活动啊。",
            "nextDialogs": [
              "740751808"
            ]
          },
          "740751808": {
            "id": "740751808",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "那他拿走这里的东西是想要干什么呢？",
            "nextDialogs": [
              "740751809"
            ]
          },
          "740751809": {
            "id": "740751809",
            "speakerId": 21048,
            "speakerName": "卡特皮拉",
            "text": "很简单啊。他也想要重铸水仙十字的圣剑。因为水仙十字结社的事业还未竟呢。",
            "nextDialogs": [
              "740751810"
            ]
          },
          "740751810": {
            "id": "740751810",
            "speakerId": 21048,
            "speakerName": "卡特皮拉",
            "text": "我们还是赶紧去最后一处地方吧。"
          }
        }
      }

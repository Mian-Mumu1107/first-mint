    {
      "subId": "7182401",
      "subQuestName": "与言笑对话",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "718240101"
        ],
        "dialogs": {
          "718240101": {
            "id": "718240101",
            "speakerId": 1000,
            "speakerName": "言笑",
            "text": "得再加紧点了…",
            "nextDialogs": [
              "718240102"
            ]
          },
          "718240102": {
            "id": "718240102",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "生意这么好吗？",
            "nextDialogs": [
              "718240103"
            ]
          },
          "718240103": {
            "id": "718240103",
            "speakerId": 1000,
            "speakerName": "言笑",
            "text": "没有。这不是正过节吗？客栈里一堆人回去过节了，干活的人少了一堆，活差不多都得我自己来做。",
            "nextDialogs": [
              "718240104"
            ]
          },
          "718240104": {
            "id": "718240104",
            "speakerId": 1000,
            "speakerName": "言笑",
            "text": "还好，客人不算太多，我一个人还顶得住。",
            "nextDialogs": [
              "718240105"
            ]
          },
          "718240105": {
            "id": "718240105",
            "speakerId": 1000,
            "speakerName": "言笑",
            "text": "咳，我还得谢谢你，上次帮我那个忙，要不是你，我现在估计都没法正常开工…",
            "nextDialogs": [
              "718240108"
            ]
          },
          "718240108": {
            "id": "718240108",
            "speakerId": 1000,
            "speakerName": "言笑",
            "text": "没有！绝对没有，相信我，绝对没有！要再来一次，我绝对受不了了…",
            "nextDialogs": [
              "718240109"
            ]
          },
          "718240109": {
            "id": "718240109",
            "speakerId": 1000,
            "speakerName": "言笑",
            "text": "你要是真想打听那件事…她的话，就去问问老板吧，我是真…真不知道…"
          }
        }
      }
    },
    {
      "subId": "7182402",
      "subQuestName": "与菲尔戈黛特对话",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "718240201"
        ],
        "dialogs": {
          "718240201": {
            "id": "718240201",
            "speakerId": 1001,
            "speakerName": "菲尔戈黛特",
            "text": "旅行者，有什么事吗？",
            "nextDialogs": [
              "718240202"
            ]
          },
          "718240202": {
            "id": "718240202",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "关于小冥…",
            "nextDialogs": [
              "718240203"
            ]
          },
          "718240203": {
            "id": "718240203",
            "speakerId": 1001,
            "speakerName": "菲尔戈黛特",
            "text": "你说她啊，自从上次那件事之后，她就安稳很多了。",
            "nextDialogs": [
              "718240204"
            ]
          },
          "718240204": {
            "id": "718240204",
            "speakerId": 1001,
            "speakerName": "菲尔戈黛特",
            "text": "不过，那孩子倒也可怜，之前逢年过节，客栈越是热闹，她就越落寞，所以才经常捣乱，吓坏了客人。",
            "nextDialogs": [
              "718240205"
            ]
          },
          "718240205": {
            "id": "718240205",
            "speakerId": 1001,
            "speakerName": "菲尔戈黛特",
            "text": "但她应该也只是想有人陪着她玩吧，毕竟，她也只是个孩子而已…",
            "nextDialogs": [
              "718240208"
            ]
          },
          "718240208": {
            "id": "718240208",
            "speakerId": 1001,
            "speakerName": "菲尔戈黛特",
            "text": "给她送霄灯？嗯…这个主意倒还不错，不过那孩子很难找…",
            "nextDialogs": [
              "718240209"
            ]
          },
          "718240209": {
            "id": "718240209",
            "speakerId": 1001,
            "speakerName": "菲尔戈黛特",
            "text": "如果想找她的话，你就在晚上去旁边的树林里，把霄灯挂在树梢上吧。",
            "nextDialogs": [
              "718240210"
            ]
          },
          "718240210": {
            "id": "718240210",
            "speakerId": 1001,
            "speakerName": "菲尔戈黛特",
            "text": "这样的话，她应该就能看到了。"
          }
        }
      }
    },
    {
      "subId": "7182403",
      "subQuestName": "制作霄灯",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "718240301"
        ],
        "dialogs": {
          "718240301": {
            "id": "718240301",
            "speakerId": 1001,
            "speakerName": "菲尔戈黛特",
            "text": "怎么样，你们把霄灯送过去了吗？",
            "nextDialogs": [
              "718240302"
            ]
          },
          "718240302": {
            "id": "718240302",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "应该…算是送过去了。",
            "nextDialogs": [
              "718240303"
            ]
          },
          "718240303": {
            "id": "718240303",
            "speakerId": 1001,
            "speakerName": "菲尔戈黛特",
            "text": "嗯，这样就最好了，这样那孩子应该也会高兴一些吧。",
            "nextDialogs": [
              "718240304"
            ]
          },
          "718240304": {
            "id": "718240304",
            "speakerId": 1001,
            "speakerName": "菲尔戈黛特",
            "text": "不知道…那孩子会许什么愿望…"
          }
        }
      }
    },

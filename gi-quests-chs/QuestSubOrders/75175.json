    {
      "subId": "7517501",
      "subQuestName": "尝试启动「象拟聚星」",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "751750101"
        ],
        "dialogs": {
          "751750101": {
            "id": "751750101",
            "speakerId": 1000,
            "speakerName": "Black Screen",
            "text": "将身躯沉入液态燃素之后，画面犹如温热的记忆直接在脑海之中浮现。",
            "nextDialogs": [
              "751750102"
            ]
          },
          "751750102": {
            "id": "751750102",
            "speakerId": 1000,
            "speakerName": "Black Screen",
            "text": "流火的焰池旁，银白色的与垩灰覆体的影子进行如下交谈…",
            "nextDialogs": [
              "751750103"
            ]
          },
          "751750103": {
            "id": "751750103",
            "speakerId": 1001,
            "speakerName": "厚重却疲惫的声音",
            "text": "「…第二阶段的验证实验结束了，那即将令一切净化与进化的，我称之为『维奇洛波奇特利』，或『天火之荡』…」",
            "nextDialogs": [
              "751750104"
            ]
          },
          "751750104": {
            "id": "751750104",
            "speakerId": 1001,
            "speakerName": "厚重却疲惫的声音",
            "text": "「无所谓了，在此地，名字迟早会失去意义。」",
            "nextDialogs": [
              "751750105"
            ]
          },
          "751750105": {
            "id": "751750105",
            "speakerId": 1002,
            "speakerName": "冰冷的声音",
            "text": "「针对侵蚀，驱动『象拟聚星』进行主动依附，并在受到完全的扭曲前以自毁灭的方式消却深渊的影响…」",
            "nextDialogs": [
              "751750106"
            ]
          },
          "751750106": {
            "id": "751750106",
            "speakerId": 1002,
            "speakerName": "冰冷的声音",
            "text": "可你如何准确判定受侵蚀的对象，可控的样本…",
            "nextDialogs": [
              "751750107"
            ]
          },
          "751750107": {
            "id": "751750107",
            "speakerId": 1002,
            "speakerName": "冰冷的声音",
            "text": "你疯了，你在拿你自己做实验？",
            "nextDialogs": [
              "751750108"
            ]
          },
          "751750108": {
            "id": "751750108",
            "speakerId": 1001,
            "speakerName": "厚重却疲惫的声音",
            "text": "「这不挺好的，如此一来，现在这破败腐朽的身躯起码也能以这样的方式起到作用。」",
            "nextDialogs": [
              "751750109"
            ]
          },
          "751750109": {
            "id": "751750109",
            "speakerId": 1002,
            "speakerName": "冰冷的声音",
            "text": "…所以，在这个系统启动之后，最不可能存活下来的就是你自己？",
            "nextDialogs": [
              "751750110"
            ]
          },
          "751750110": {
            "id": "751750110",
            "speakerId": 1002,
            "speakerName": "冰冷的声音",
            "text": "深渊终于把你的脑袋也腐蚀了吗…还是说，你只是想让你的整个族群作你葬礼的殉品？",
            "nextDialogs": [
              "751750111"
            ]
          },
          "751750111": {
            "id": "751750111",
            "speakerId": 1001,
            "speakerName": "厚重却疲惫的声音",
            "text": "「你就对你的同族这么没有信心么，除你以外的所有领主都已然同意此事。」",
            "nextDialogs": [
              "751750112"
            ]
          },
          "751750112": {
            "id": "751750112",
            "speakerId": 1002,
            "speakerName": "冰冷的声音",
            "text": "他们只是愚从你的计划，却从未考量过背后真正的意义…我不会同意的。",
            "nextDialogs": [
              "751750113"
            ]
          },
          "751750113": {
            "id": "751750113",
            "speakerId": 1001,
            "speakerName": "厚重却疲惫的声音",
            "text": "「…那也无所谓了，『毁灭』…即是『新生』，我已下定决心。」",
            "nextDialogs": [
              "751750114"
            ]
          },
          "751750114": {
            "id": "751750114",
            "speakerId": 1001,
            "speakerName": "厚重却疲惫的声音",
            "text": "「哈…我每日维持清醒的时间就只有这么点了，总之，在一切完备之后，我就会开启它。」",
            "nextDialogs": [
              "751750115"
            ]
          },
          "751750115": {
            "id": "751750115",
            "speakerId": 1002,
            "speakerName": "冰冷的声音",
            "text": "没有转圜的余地了吗？我在试图找别的方法…你真的不是为了一己的私怨，而将世界推入火海？",
            "nextDialogs": [
              "751750116"
            ]
          },
          "751750116": {
            "id": "751750116",
            "speakerId": 1001,
            "speakerName": "厚重却疲惫的声音",
            "text": "「说不定呢，将阴影之大敌阻挡在世界之外，为此我可以不择手段。」",
            "nextDialogs": [
              "751750117"
            ]
          },
          "751750117": {
            "id": "751750117",
            "speakerId": 1001,
            "speakerName": "厚重却疲惫的声音",
            "text": "「呵，更何况，别的方法…你真的能从那些『人类』那里寻得你想要的东西吗？你已然陷得太深了…」",
            "nextDialogs": [
              "751750118"
            ]
          },
          "751750118": {
            "id": "751750118",
            "speakerId": 1001,
            "speakerName": "厚重却疲惫的声音",
            "text": "「我曾试图让你理解…但就跟通过焰池去知晓智慧的族裔一样，知晓和真正的接受是两码事。」",
            "nextDialogs": [
              "751750119"
            ]
          },
          "751750119": {
            "id": "751750119",
            "speakerId": 1002,
            "speakerName": "冰冷的声音",
            "text": "……",
            "nextDialogs": [
              "751750120"
            ]
          },
          "751750120": {
            "id": "751750120",
            "speakerId": 1001,
            "speakerName": "厚重却疲惫的声音",
            "text": "「如果你认为我只是单纯的想要『毁灭』，而你有自己想构建的世界…那就来阻止我，杀死我，证明给我看吧！」",
            "nextDialogs": [
              "751750121"
            ]
          },
          "751750121": {
            "id": "751750121",
            "speakerId": 1001,
            "speakerName": "厚重却疲惫的声音",
            "text": "「但终有一日，这并非预言，库库尔坎，只不过是过来者的劝告…终有一日…」",
            "nextDialogs": [
              "751750122"
            ]
          },
          "751750122": {
            "id": "751750122",
            "speakerId": 1001,
            "speakerName": "厚重却疲惫的声音",
            "text": "「你会踏上和我同样的道路。」"
          }
        }
      }
    },

      "subQuestName": "(test)任务接取$HIDDEN",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "751870101"
        ],
        "dialogs": {
          "751870101": {
            "id": "751870101",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "#角上没有火焰一样的花纹…不是{REALNAME[ID(2)|SHOWHOST(true)]}…",
            "nextDialogs": [
              "751870102"
            ]
          },
          "751870102": {
            "id": "751870102",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "唔，这个小家伙又是哪来的？",
            "nextDialogs": [
              "751870103"
            ]
          },
          "751870103": {
            "id": "751870103",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "奥奇卡纳塔的龙蛋…",
            "nextDialogs": [
              "751870104"
            ]
          },
          "751870104": {
            "id": "751870104",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "哦，是那个时候的龙蛋！",
            "nextDialogs": [
              "751870105"
            ]
          },
          "751870105": {
            "id": "751870105",
            "speakerId": 21912,
            "speakerName": "幼小的嵴锋龙",
            "text": "呜呀？",
            "nextDialogs": [
              "751870106"
            ]
          },
          "751870106": {
            "id": "751870106",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "没想到蛋里的也是一只嵴锋龙呢…",
            "nextDialogs": [
              "751870107"
            ]
          },
          "751870107": {
            "id": "751870107",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "我记得之前保护这枚龙蛋的人给它取名…这个小家伙的名字是「阿瓜拉」？",
            "nextDialogs": [
              "751870108"
            ]
          },
          "751870108": {
            "id": "751870108",
            "speakerId": 16386,
            "speakerName": "阿瓜拉",
            "text": "呀！",
            "nextDialogs": [
              "751870109"
            ]
          },
          "751870109": {
            "id": "751870109",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "哦哦，看来你对自己的名字有反应呢！",
            "nextDialogs": [
              "751870110"
            ]
          },
          "751870110": {
            "id": "751870110",
            "speakerId": 16386,
            "speakerName": "阿瓜拉",
            "text": "唔嗯？",
            "nextDialogs": [
              "751870111"
            ]
          },
          "751870111": {
            "id": "751870111",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "#就跟{REALNAME[ID(2)|SHOWHOST(true)]}一样，这家伙也没有家了呢…",
            "nextDialogs": [
              "751870112"
            ]
          },
          "751870112": {
            "id": "751870112",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "#那不然就跟我们一起吧！嘿嘿，我和{NICKNAME}，可会和嵴锋龙做朋友了！",
            "nextDialogs": [
              "751870113"
            ]
          },
          "751870113": {
            "id": "751870113",
            "speakerId": 16386,
            "speakerName": "阿瓜拉",
            "text": "呀！呀！",
            "nextDialogs": [
              "751870114"
            ]
          },
          "751870114": {
            "id": "751870114",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "嘿嘿…我就知道你会答应的！",
            "nextDialogs": [
              "751870115"
            ]
          },
          "751870115": {
            "id": "751870115",
            "speakerId": 1003,
            "speakerName": "Black Screen",
            "text": "你像一度为曾经的伙伴那样，为它系上了丝巾。",
            "nextDialogs": [
              "751870116"
            ]
          },
          "751870116": {
            "id": "751870116",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "嗯，上一只戴着丝巾的小龙，最后成长成了很了不起，很了不起的家伙！",
            "nextDialogs": [
              "751870117"
            ]
          },
          "751870117": {
            "id": "751870117",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "阿瓜拉！希望、希望你也能像它一样，健康长大！"
          }
        }
      }
    },

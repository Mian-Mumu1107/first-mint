    {
      "subId": "7619603",
      "subQuestName": "与多洛妲对话",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "761960201"
        ],
        "dialogs": {
          "761960201": {
            "id": "761960201",
            "speakerId": 1327,
            "speakerName": "莉奈娅",
            "text": "多洛妲！你怎么在这里？",
            "nextDialogs": [
              "761960202"
            ]
          },
          "761960202": {
            "id": "761960202",
            "speakerId": 16574,
            "speakerName": "多洛妲",
            "text": "莉奈娅，你来得正好！我刚才在向大家说明月落银的美妙之处呢。",
            "nextDialogs": [
              "761960203"
            ]
          },
          "761960203": {
            "id": "761960203",
            "speakerId": 16574,
            "speakerName": "多洛妲",
            "text": "月落银啊月落银，月下世界还有比你更完美的宝石吗？",
            "nextDialogs": [
              "761960204"
            ]
          },
          "761960204": {
            "id": "761960204",
            "speakerId": 16574,
            "speakerName": "多洛妲",
            "text": "看！无可挑剔的造型，珠圆玉润的感触！还有它那五彩斑斓的白，无与伦比的元素亲和力！",
            "nextDialogs": [
              "761960205"
            ]
          },
          "761960205": {
            "id": "761960205",
            "speakerId": 16574,
            "speakerName": "多洛妲",
            "text": "在我心目中，只有天上的月亮能与你媲美！",
            "nextDialogs": [
              "761960206"
            ]
          },
          "761960206": {
            "id": "761960206",
            "speakerId": 1327,
            "speakerName": "莉奈娅",
            "text": "月落银的确是很漂亮的矿石，我也收集了一些做标本。",
            "nextDialogs": [
              "761960207"
            ]
          },
          "761960207": {
            "id": "761960207",
            "speakerId": 16574,
            "speakerName": "多洛妲",
            "text": "对吧对吧！我就知道你会懂我的！",
            "nextDialogs": [
              "761960208"
            ]
          },
          "761960208": {
            "id": "761960208",
            "speakerId": 16574,
            "speakerName": "多洛妲",
            "text": "不过呢，最懂月落银的一定还是我！就算你是协会的顾问，这个第一的位置我也不会让给你的，哼哼。",
            "nextDialogs": [
              "761960209"
            ]
          },
          "761960209": {
            "id": "761960209",
            "speakerId": 16574,
            "speakerName": "多洛妲",
            "text": "对了，平时都是你来给冒险家讲课，今天就让我考考你吧。",
            "nextDialogs": [
              "761960210"
            ]
          },
          "761960210": {
            "id": "761960210",
            "speakerId": 16574,
            "speakerName": "多洛妲",
            "text": "我这儿有三颗月落银，非常遗憾，其中两颗有些细微的瑕疵，而另一颗则是我的珍藏，是月落银中的月落银！",
            "nextDialogs": [
              "761960211"
            ]
          },
          "761960211": {
            "id": "761960211",
            "speakerId": 16574,
            "speakerName": "多洛妲",
            "text": "你能够分辨出哪一颗才是最完美的月落银吗？",
            "nextDialogs": [
              "761960212"
            ]
          },
          "761960212": {
            "id": "761960212",
            "speakerId": 1327,
            "speakerName": "莉奈娅",
            "text": "让我看看…",
            "nextDialogs": [
              "761960213"
            ]
          },
          "761960213": {
            "id": "761960213",
            "speakerId": 1327,
            "speakerName": "莉奈娅",
            "text": "左边这个…",
            "nextDialogs": [
              "761960214"
            ]
          },
          "761960214": {
            "id": "761960214",
            "speakerId": 1327,
            "speakerName": "莉奈娅",
            "text": "（咦？露米这是在…）",
            "nextDialogs": [
              "761960215"
            ]
          },
          "761960215": {
            "id": "761960215",
            "speakerId": 1327,
            "speakerName": "莉奈娅",
            "text": "就选这个了！",
            "nextDialogs": [
              "761960216"
            ]
          },
          "761960216": {
            "id": "761960216",
            "speakerId": 16574,
            "speakerName": "多洛妲",
            "text": "莉奈娅也会有看走眼的时候呀，其实这颗在很不起眼的地方有一点点微小的瑕疵呢。",
            "nextDialogs": [
              "761960217"
            ]
          },
          "761960217": {
            "id": "761960217",
            "speakerId": 1327,
            "speakerName": "莉奈娅",
            "text": "唔，我认输了…不过下次，下次我可不会这么轻易输掉了！",
            "nextDialogs": [
              "761960218"
            ]
          },
          "761960218": {
            "id": "761960218",
            "speakerId": 16574,
            "speakerName": "多洛妲",
            "text": "好啊，随时奉陪！",
            "nextDialogs": [
              "761960232"
            ]
          },
          "761960232": {
            "id": "761960232",
            "speakerId": 1001,
            "speakerName": "Black Screen",
            "text": "顺势参加了多洛妲主办的月落银鉴赏大会，度过了一段愉快的时光…",
            "nextDialogs": [
              "761960219"
            ]
          },
          "761960219": {
            "id": "761960219",
            "speakerId": 16574,
            "speakerName": "多洛妲",
            "text": "没想到大家都这么热情，可惜像这样美好的时光总是转瞬即逝…差不多该收拾收拾了。",
            "nextDialogs": [
              "761960233"
            ]
          },
          "761960233": {
            "id": "761960233",
            "speakerId": 1327,
            "speakerName": "莉奈娅",
            "text": "我来帮你吧。",
            "nextDialogs": [
              "761960234"
            ]
          },
          "761960234": {
            "id": "761960234",
            "speakerId": 16574,
            "speakerName": "多洛妲",
            "text": "那太好了！"
          }
        }
      }
    },
    {
      "subId": "7619606",
      "subQuestName": "（隐藏）判断回答对错发放不同奖励$HIDDEN",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "761960601"
        ],
        "dialogs": {
          "761960601": {
            "id": "761960601",
            "speakerId": 1003,
            "speakerName": "月落银鉴赏大会",
            "text": "「如果你也曾为月落银的七彩虹光而着迷，请加入我们，成为月落银同好会的一员吧！」"
          }
        }
      }
    },
    {
      "subId": "7619604",
      "subQuestName": "回收展出用的月落银",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "761960401"
        ],
        "dialogs": {
          "761960401": {
            "id": "761960401",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "（附近似乎有些值得调查的，如果是对本地生态十分了解的<color=#FFCC33FF>莉奈娅</color>，或许会有所收获…）"
          }
        }
      }
    },
    {
      "subId": "7619605",
      "subQuestName": "与多洛妲对话",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "761960301"
        ],
        "dialogs": {
          "761960301": {
            "id": "761960301",
            "speakerId": 1327,
            "speakerName": "莉奈娅",
            "text": "你看看，应该没有遗漏吧？",
            "nextDialogs": [
              "761960302"
            ]
          },
          "761960302": {
            "id": "761960302",
            "speakerId": 16574,
            "speakerName": "多洛妲",
            "text": "嗯——没问题，不多也不少！",
            "nextDialogs": [
              "761960303"
            ]
          },
          "761960303": {
            "id": "761960303",
            "speakerId": 1327,
            "speakerName": "莉奈娅",
            "text": "我看到你用月落银在地上摆出了有趣的图案。",
            "nextDialogs": [
              "761960304"
            ]
          },
          "761960304": {
            "id": "761960304",
            "speakerId": 16574,
            "speakerName": "多洛妲",
            "text": "是呀！花费了不少心思呢，我觉得这样更能激起大家对于月落银的喜爱。",
            "nextDialogs": [
              "761960305"
            ]
          },
          "761960305": {
            "id": "761960305",
            "speakerId": 1327,
            "speakerName": "莉奈娅",
            "text": "说起来，我听说纳塔的民间故事里有这么一条…",
            "nextDialogs": [
              "761960306"
            ]
          },
          "761960306": {
            "id": "761960306",
            "speakerId": 1327,
            "speakerName": "莉奈娅",
            "text": "说的是原本住在星星上的少女坠落大地后，为了重返上天而在大地之上留下了巨大的涂鸦。",
            "nextDialogs": [
              "761960307"
            ]
          },
          "761960307": {
            "id": "761960307",
            "speakerId": 1327,
            "speakerName": "莉奈娅",
            "text": "之后，她在天上的太阳父亲果然看到了她的请求，将她带回了天上。",
            "nextDialogs": [
              "761960308"
            ]
          },
          "761960308": {
            "id": "761960308",
            "speakerId": 1327,
            "speakerName": "莉奈娅",
            "text": "说不定他也能看到多洛妲摆出的图案，就此成为月落银的粉丝呢！",
            "nextDialogs": [
              "761960309"
            ]
          },
          "761960309": {
            "id": "761960309",
            "speakerId": 16574,
            "speakerName": "多洛妲",
            "text": "哈哈哈！如果是这样，那我就是最了不起的月落银推广大使了！",
            "nextDialogs": [
              "761960310"
            ]
          },
          "761960310": {
            "id": "761960310",
            "speakerId": 16574,
            "speakerName": "多洛妲",
            "text": "不过比起那个，我还是更担心被天上的飞鸟盯上，你也知道，乌鸦之类的不是很喜欢亮晶晶的东西嘛。",
            "nextDialogs": [
              "761960311"
            ]
          },
          "761960311": {
            "id": "761960311",
            "speakerId": 1327,
            "speakerName": "莉奈娅",
            "text": "说得也是，而且除了乌鸦，也得小心地上的嗅嗅鼹鼠和盗宝鼬之类的。",
            "nextDialogs": [
              "761960312"
            ]
          },
          "761960312": {
            "id": "761960312",
            "speakerId": 16574,
            "speakerName": "多洛妲",
            "text": "还有露米！",
            "nextDialogs": [
              "761960313"
            ]
          },
          "761960313": {
            "id": "761960313",
            "speakerId": 1327,
            "speakerName": "莉奈娅",
            "text": "哈哈，对！还有露米！",
            "nextDialogs": [
              "761960314"
            ]
          },
          "761960314": {
            "id": "761960314",
            "speakerId": 16476,
            "speakerName": "露米",
            "text": "呀吼？",
            "nextDialogs": [
              "761960315"
            ]
          },
          "761960315": {
            "id": "761960315",
            "speakerId": 16574,
            "speakerName": "多洛妲",
            "text": "刚才谢谢你帮忙，虽然只是我收藏中的一小部分，这些就送给你了，就当是送给露米的吧！",
            "nextDialogs": [
              "761960316"
            ]
          },
          "761960316": {
            "id": "761960316",
            "speakerId": 1327,
            "speakerName": "莉奈娅",
            "text": "露米，今天真是个好日子呀！",
            "nextDialogs": [
              "761960317"
            ]
          },
          "761960317": {
            "id": "761960317",
            "speakerId": 16476,
            "speakerName": "露米",
            "text": "呀吼吼！"
          }
        }
      }
    },
    {
      "subId": "7619605",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [

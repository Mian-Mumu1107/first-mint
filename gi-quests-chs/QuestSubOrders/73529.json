  "subQuests": [
    {
      "subId": "7352901",
      "subQuestName": "与古怪的「舞者」对话",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "735290101"
        ],
        "dialogs": {
          "735290101": {
            "id": "735290101",
            "speakerId": 10205,
            "speakerName": "？？？",
            "text": "我感受到了。",
            "nextDialogs": [
              "735290102"
            ]
          },
          "735290102": {
            "id": "735290102",
            "speakerId": 10205,
            "speakerName": "？？？",
            "text": "你们举手投足间满溢而出的，「战斗舞步」的气息，缤纷璨绮，令人迷醉。",
            "nextDialogs": [
              "735290103"
            ]
          },
          "735290103": {
            "id": "735290103",
            "speakerId": 10205,
            "speakerName": "？？？",
            "text": "燃烧的剑锋划过侧脸时，你们瞳中的倒影连成了一线炽烈的金红…",
            "nextDialogs": [
              "735290104"
            ]
          },
          "735290104": {
            "id": "735290104",
            "speakerId": 10205,
            "speakerName": "？？？",
            "text": "环绕严冰壁垒的轴线优雅旋转时，你们的足尖踏出了错落有致的节奏…",
            "nextDialogs": [
              "735290105"
            ]
          },
          "735290105": {
            "id": "735290105",
            "speakerId": 10205,
            "speakerName": "？？？",
            "text": "面对轰然倾轧而来的古木城墙，抑或是钢铁巨人的军阵时，你们捕捉每个瞬息的敏捷身影，甚至无法被画笔和镜头捕捉…",
            "nextDialogs": [
              "735290108"
            ]
          },
          "735290108": {
            "id": "735290108",
            "speakerId": 10205,
            "speakerName": "？？？",
            "text": "这股豪气也是我所敬畏之物，不会错，你们一定能成为我的知音！",
            "nextDialogs": [
              "735290109"
            ]
          },
          "735290109": {
            "id": "735290109",
            "speakerId": 30407,
            "speakerName": "勒非尼",
            "text": "本人「轻剑舞者」勒非尼，且问两位尊姓大名。",
            "nextDialogs": [
              "735290110"
            ]
          },
          "735290110": {
            "id": "735290110",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "呜啊，好夸张的说话风格…",
            "nextDialogs": [
              "735290111"
            ]
          },
          "735290111": {
            "id": "735290111",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "#我是派蒙，这是{NICKNAME}…",
            "nextDialogs": [
              "735290112"
            ]
          },
          "735290112": {
            "id": "735290112",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "虽然我们的确很厉害，但勒非尼先生，你说的话好复杂，完全不明白是什么意思啦！",
            "nextDialogs": [
              "735290113"
            ]
          },
          "735290113": {
            "id": "735290113",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "而且你既没有带着剑，看穿着打扮也不像是舞者，为什么自称「轻剑舞者」呢？",
            "nextDialogs": [
              "735290114"
            ]
          },
          "735290114": {
            "id": "735290114",
            "speakerId": 30407,
            "speakerName": "勒非尼",
            "text": "犀利的提问，派蒙阁下想必在考验我的心性！",
            "nextDialogs": [
              "735290115"
            ]
          },
          "735290115": {
            "id": "735290115",
            "speakerId": 30407,
            "speakerName": "勒非尼",
            "text": "不以有限的武器为兵刃，而是藏剑于心，在必要之时，将锐意融入一切可用之物，让具体的战法摆脱桎梏。",
            "nextDialogs": [
              "735290116"
            ]
          },
          "735290116": {
            "id": "735290116",
            "speakerId": 30407,
            "speakerName": "勒非尼",
            "text": "绝不强调衣着，而是从踏上战场舞台的一刻起，释放华美的身姿，以至为优雅的技法主宰一切…"
          }
        }
      }
    }
  ]
}
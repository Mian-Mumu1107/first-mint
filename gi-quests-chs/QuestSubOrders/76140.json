  "subQuests": [
    {
      "subId": "7614001",
      "subQuestName": "(test)隐藏$HIDDEN",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "761390301"
        ],
        "dialogs": {
          "761390301": {
            "id": "761390301",
            "speakerId": 1000,
            "speakerName": "萨维特",
            "text": "怎么又是你，我不卖投资券了，走吧走吧。",
            "nextDialogs": [
              "761390302"
            ]
          },
          "761390302": {
            "id": "761390302",
            "speakerId": 1000,
            "speakerName": "萨维特",
            "text": "唉，回头一想，我就不该信你还有什么朋友…",
            "nextDialogs": [
              "761390305"
            ]
          },
          "761390305": {
            "id": "761390305",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "是啊，好好卖书不是挺好的？",
            "nextDialogs": [
              "761390306"
            ]
          },
          "761390306": {
            "id": "761390306",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "#喔！{NICKNAME}，你看那边，那本书好像很有趣，我们去看看吧。",
            "nextDialogs": [
              "761390307"
            ]
          },
          "761390307": {
            "id": "761390307",
            "speakerId": 1000,
            "speakerName": "萨维特",
            "text": "行，行，算我倒…霉…",
            "nextDialogs": [
              "761390308"
            ]
          },
          "761390308": {
            "id": "761390308",
            "speakerId": 1000,
            "speakerName": "萨维特",
            "text": "奈…奈芙尔老板！没想到您居然大驾光临…您…您也想买张投资…不是，您想买本书吗？",
            "nextDialogs": [
              "761390309"
            ]
          },
          "761390309": {
            "id": "761390309",
            "speakerId": 1002,
            "speakerName": "奈芙尔",
            "text": "我就不了，只是陪我这位朋友过来看看而已。",
            "nextDialogs": [
              "761390310"
            ]
          },
          "761390310": {
            "id": "761390310",
            "speakerId": 1002,
            "speakerName": "奈芙尔",
            "text": "听说萨维特老板的投资生意做得有声有色，今天一看，果然如此。",
            "nextDialogs": [
              "761390311"
            ]
          },
          "761390311": {
            "id": "761390311",
            "speakerId": 1000,
            "speakerName": "萨维特",
            "text": "一般，一般，哈哈哈…小本生意，糊口罢了。",
            "nextDialogs": [
              "761390312"
            ]
          },
          "761390312": {
            "id": "761390312",
            "speakerId": 1002,
            "speakerName": "奈芙尔",
            "text": "萨维特老板客气了，您的信誉和商业头脑，在那夏镇可是很有名的。",
            "nextDialogs": [
              "761390313"
            ]
          },
          "761390313": {
            "id": "761390313",
            "speakerId": 1002,
            "speakerName": "奈芙尔",
            "text": "我相信，大家跟着您投资，您一定能赚到大钱。",
            "nextDialogs": [
              "761390314"
            ]
          },
          "761390314": {
            "id": "761390314",
            "speakerId": 1000,
            "speakerName": "萨维特",
            "text": "借奈芙尔老板吉言…借奈芙尔老板吉言。",
            "nextDialogs": [
              "761390315"
            ]
          },
          "761390315": {
            "id": "761390315",
            "speakerId": 1000,
            "speakerName": "萨维特",
            "text": "…然后，奈芙尔老板，上次我拜托您帮忙找的那个…",
            "nextDialogs": [
              "761390316"
            ]
          },
          "761390316": {
            "id": "761390316",
            "speakerId": 1002,
            "speakerName": "奈芙尔",
            "text": "东西是已经找到了，但…",
            "nextDialogs": [
              "761390317"
            ]
          },
          "761390317": {
            "id": "761390317",
            "speakerId": 1002,
            "speakerName": "奈芙尔",
            "text": "萨维特先生，不要心急。事情，要一步一步地做才稳当。",
            "nextDialogs": [
              "761390318"
            ]
          },
          "761390318": {
            "id": "761390318",
            "speakerId": 1000,
            "speakerName": "萨维特",
            "text": "是、是，奈芙尔老板说的是…那就麻烦了，我就指望您了…"
          }
        }
      }
    }
  ]
}
            ]
          },
          "706910102": {
            "id": "706910102",
            "speakerId": 1000,
            "speakerName": "可莉",
            "text": "可莉交到了新朋友！要和我们一起玩吗？",
            "nextDialogs": [
              "706910103"
            ]
          },
          "706910103": {
            "id": "706910103",
            "speakerId": 1000,
            "speakerName": "可莉",
            "text": "哥哥姐姐们教给我们一种新游戏，叫做「雪白迷踪」。",
            "nextDialogs": [
              "706910104"
            ]
          },
          "706910104": {
            "id": "706910104",
            "speakerId": 1000,
            "speakerName": "可莉",
            "text": "规则也不难，就是很特别的捉迷藏！",
            "nextDialogs": [
              "706910105"
            ]
          },
          "706910105": {
            "id": "706910105",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "哇哇，可莉、瑶瑶和早柚，你们交上朋友啦！",
            "nextDialogs": [
              "706910106"
            ]
          },
          "706910106": {
            "id": "706910106",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "听这个游戏的名字，像是「风行迷踪」的改进版？和你们一起玩，肯定非常有意思！",
            "nextDialogs": [
              "706910109"
            ]
          },
          "706910109": {
            "id": "706910109",
            "speakerId": 1002,
            "speakerName": "早柚",
            "text": "阿嚏…虽然在营地里就不怎么冷了，但还是有点困…",
            "nextDialogs": [
              "706910110"
            ]
          },
          "706910110": {
            "id": "706910110",
            "speakerId": 1002,
            "speakerName": "早柚",
            "text": "#唔？我是不是眼花了，怎么好像看到了{NICKNAME}和派蒙？",
            "nextDialogs": [

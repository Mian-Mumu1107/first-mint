        "dialogs": {
          "706910101": {
            "id": "706910101",
            "speakerId": 1000,
            "speakerName": "可莉",
            "text": "#{M#荣誉骑士哥哥}{F#荣誉骑士姐姐}！这边这边！",
            "nextDialogs": [

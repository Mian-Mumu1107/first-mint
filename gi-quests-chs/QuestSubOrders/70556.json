      "dialogue": {
        "startDialogs": [
          "705560101"
        ],
        "dialogs": {
          "705560101": {
            "id": "705560101",
            "speakerId": 1000,
            "speakerName": "安柏",
            "text": "#你们来啦，{NICKNAME}和派蒙。",
            "nextDialogs": [
              "705560102"
            ]
          },
          "705560102": {
            "id": "705560102",
            "speakerId": 1000,
            "speakerName": "安柏",
            "text": "先认识一下新同事？这是第七小队的信号官耶嘉，还有她的搭档灰郁香。",
            "nextDialogs": [
              "705560103"
            ]
          },
          "705560103": {
            "id": "705560103",
            "speakerId": 1001,
            "speakerName": "耶嘉",
            "text": "初次见面，荣誉骑士和白色小帮手，向你们致以敬意。",
            "nextDialogs": [
              "705560104"
            ]
          },
          "705560104": {
            "id": "705560104",
            "speakerId": 1001,
            "speakerName": "耶嘉",
            "text": "灰郁香，来问好。",
            "nextDialogs": [
              "705560105"
            ]
          },
          "705560105": {
            "id": "705560105",
            "speakerId": 1002,
            "speakerName": "灰郁香",
            "text": "嘎啊！",
            "nextDialogs": [
              "705560108"
            ]
          },
          "705560108": {
            "id": "705560108",
            "speakerId": 1003,
            "speakerName": "派蒙",
            "text": "这只大大的鹰好听话欸！居然还穿着铠甲一样的衣服，还背着一个小包？",
            "nextDialogs": [
              "705560109"
            ]
          },
          "705560109": {
            "id": "705560109",
            "speakerId": 1003,
            "speakerName": "派蒙",
            "text": "等等，我有点迷糊了…安柏说的表演又是什么意思？",
            "nextDialogs": [
              "705560110"
            ]
          },
          "705560110": {
            "id": "705560110",
            "speakerId": 1003,
            "speakerName": "派蒙",
            "text": "和耶嘉小姐，还有这只鹰有关吗？",
            "nextDialogs": [
              "705560111"
            ]
          },
          "705560111": {
            "id": "705560111",
            "speakerId": 1000,
            "speakerName": "安柏",
            "text": "啊哈哈，我来简单解释一下。",
            "nextDialogs": [
              "705560112"
            ]
          },
          "705560112": {
            "id": "705560112",
            "speakerId": 1000,
            "speakerName": "安柏",
            "text": "琴团长应该和你说过，我们这边在举办风之翼竞速射击活动，没错吧？这是一种便于理解的说法…",
            "nextDialogs": [
              "705560113"
            ]
          },
          "705560113": {
            "id": "705560113",
            "speakerId": 1000,
            "speakerName": "安柏",
            "text": "其实，有可能不同于你们的预期，这次更像是一次「飞行表演与指挥挑战」。",
            "nextDialogs": [
              "705560114"
            ]
          },
          "705560114": {
            "id": "705560114",
            "speakerId": 1000,
            "speakerName": "安柏",
            "text": "核心不是传统的风之翼滑翔，而是从地面给灰郁香这样的空中单位发信，引导它进行各种复杂的行动，战胜魔物标靶…",
            "nextDialogs": [
              "705560115"
            ]
          },
          "705560115": {
            "id": "705560115",
            "speakerId": 1000,
            "speakerName": "安柏",
            "text": "算是一种新奇的体验，能给大家带来小小的惊喜！",
            "nextDialogs": [
              "705560116"
            ]
          },
          "705560116": {
            "id": "705560116",
            "speakerId": 1002,
            "speakerName": "灰郁香",
            "text": "嘎呜！"
          }
        }
      }
    }
  ]
}
{
  "lineCounts": {
    "Player": 6,
    "芙萝拉": 23
  },
  "subQuests": [
    {
      "subId": "2007112",
      "subQuestName": "与芙萝拉对话",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "200710401"
        ],
        "dialogs": {
          "200710401": {
            "id": "200710401",
            "speakerId": 1425,
            "speakerName": "芙萝拉",
            "text": "这边这边，来这边。",
            "nextDialogs": [
              "200710402"
            ]
          },
          "200710402": {
            "id": "200710402",
            "speakerId": 1425,
            "speakerName": "芙萝拉",
            "text": "你还记得上次我拜托你放进雪山的那些花吗？",
            "nextDialogs": [
              "200710403"
            ]
          },
          "200710403": {
            "id": "200710403",
            "speakerId": 1425,
            "speakerName": "芙萝拉",
            "text": "现在已经过了一天了，我想要看看冷藏的效果。",
            "nextDialogs": [
              "200710404"
            ]
          },
          "200710404": {
            "id": "200710404",
            "speakerId": 1425,
            "speakerName": "芙萝拉",
            "text": "你愿意帮我去雪山上，把那些花拿回来吗？",
            "nextDialogs": [
              "200710406",
              "200710408"
            ]
          },
          "200710406": {
            "id": "200710406",
            "speakerId": 1425,
            "speakerName": "芙萝拉",
            "text": "那就拜托你啦，我就在这里等你，请快去快回吧。"
          },
          "200710408": {
            "id": "200710408",
            "speakerId": 1425,
            "speakerName": "芙萝拉",
            "text": "你不记得了吗？是<color=#00E1FFFF>七天神像旁边</color>，<color=#00E1FFFF>山里的水边</color>，还有一个<color=#00E1FFFF>洞窟附近</color>哦。",
            "nextDialogs": [
              "200710409"
            ]
          },
          "200710409": {
            "id": "200710409",
            "speakerId": 1425,
            "speakerName": "芙萝拉",
            "text": "我再帮你在地图上标记一次吧。"
          }
        }
      }
    },
    {
      "subId": "2007101",
      "subQuestName": "前往雪山回收包裹",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "200710101"
        ],
        "dialogs": {
          "200710101": {
            "id": "200710101",
            "speakerId": 1425,
            "speakerName": "芙萝拉",
            "text": "之前存在雪山上的花怎么样啦？",
            "nextDialogs": [
              "200710102"
            ]
          },
          "200710102": {
            "id": "200710102",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "只拿到一份…",
            "nextDialogs": [
              "200710103"
            ]
          },
          "200710103": {
            "id": "200710103",
            "speakerId": 1425,
            "speakerName": "芙萝拉",
            "text": "其他的花是没能取回来吗？唔…好吧，毕竟雪山里的情况，确实很难预料呢。",
            "nextDialogs": [
              "200710104"
            ]
          },
          "200710104": {
            "id": "200710104",
            "speakerId": 1425,
            "speakerName": "芙萝拉",
            "text": "但只有这一份的话，就没法对比着看了，只能以后再找机会了…",
            "nextDialogs": [
              "200710105"
            ]
          },
          "200710105": {
            "id": "200710105",
            "speakerId": 1425,
            "speakerName": "芙萝拉",
            "text": "这次辛苦你帮忙，这是给你准备的报酬哦，以后说不定还要麻烦你。"
          }
        }
      }
    },
    {
      "subId": "2007102",
      "subQuestName": "回收雪山中七天神像附近的包裹",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "200710201"
        ],
        "dialogs": {
          "200710201": {
            "id": "200710201",
            "speakerId": 1425,
            "speakerName": "芙萝拉",
            "text": "花怎么样啦？",
            "nextDialogs": [
              "200710202"
            ]
          },
          "200710202": {
            "id": "200710202",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "对不起…",
            "nextDialogs": [
              "200710203"
            ]
          },
          "200710203": {
            "id": "200710203",
            "speakerId": 1425,
            "speakerName": "芙萝拉",
            "text": "嗯？怎么了？",
            "nextDialogs": [
              "200710204"
            ]
          },
          "200710204": {
            "id": "200710204",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "我不小心把盒子和花弄坏了…",
            "nextDialogs": [
              "200710205"
            ]
          },
          "200710205": {
            "id": "200710205",
            "speakerId": 1425,
            "speakerName": "芙萝拉",
            "text": "弄、弄坏了？！",
            "nextDialogs": [
              "200710206"
            ]
          },
          "200710206": {
            "id": "200710206",
            "speakerId": 1425,
            "speakerName": "芙萝拉",
            "text": "呜…那可是我专门挑出来的花，那么好的花，可不是能轻易找到的…",
            "nextDialogs": [
              "200710207"
            ]
          },
          "200710207": {
            "id": "200710207",
            "speakerId": 1425,
            "speakerName": "芙萝拉",
            "text": "雪山真有这么危险吗？连你这样的冒险家都会失手，连一盒花都…",
            "nextDialogs": [
              "200710208"
            ]
          },
          "200710208": {
            "id": "200710208",
            "speakerId": 1425,
            "speakerName": "芙萝拉",
            "text": "不过，还是谢谢你帮我跑这一趟，这些东西给你，请收下吧，我要去打理店里的花了。",
            "nextDialogs": [
              "200710209"
            ]
          },
          "200710209": {
            "id": "200710209",
            "speakerId": 1425,
            "speakerName": "芙萝拉",
            "text": "唉，不然…我还是再用莎拉小姐的办法试试吧…"
          }
        }
      }
    },
    {
      "subId": "2007103",
      "subQuestName": "回收雪山中七天神像附近的包裹",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "200710301"
        ],
        "dialogs": {
          "200710301": {
            "id": "200710301",
            "speakerId": 1425,
            "speakerName": "芙萝拉",
            "text": "之前存在雪山上的花怎么样啦？",
            "nextDialogs": [
              "200710302"
            ]
          },
          "200710302": {
            "id": "200710302",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "加上这次的都在这里了。",
            "nextDialogs": [
              "200710303"
            ]
          },
          "200710303": {
            "id": "200710303",
            "speakerId": 1425,
            "speakerName": "芙萝拉",
            "text": "都拿到了吗 ？太好了，快给我看看。",
            "nextDialogs": [
              "200710304"
            ]
          },
          "200710304": {
            "id": "200710304",
            "speakerId": 1425,
            "speakerName": "芙萝拉",
            "text": "呼呼，看起来不错呀，嗯…看来这个方法确实可行。",
            "nextDialogs": [
              "200710305"
            ]
          },
          "200710305": {
            "id": "200710305",
            "speakerId": 1425,
            "speakerName": "芙萝拉",
            "text": "不过，雪山距离蒙德城有些太远了，总不能每次都麻烦你，以后得想个方便的办法才行…",
            "nextDialogs": [
              "200710306"
            ]
          },
          "200710306": {
            "id": "200710306",
            "speakerId": 1425,
            "speakerName": "芙萝拉",
            "text": "总之，谢谢你来帮忙呀，这些是给你的谢礼，请拿着吧。"
          }
        }
      }
    },

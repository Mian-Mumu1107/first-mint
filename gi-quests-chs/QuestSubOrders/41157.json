            ]
          },
          "411570302": {
            "id": "411570302",
            "speakerId": 1000,
            "speakerName": "卯师傅",
            "text": "对，子瑞这小子在我们这订了一份莲子禽蛋羹。他人应该好像撒脱到孤云阁那边去了。",
            "nextDialogs": [
              "411570303"
            ]
          },
          "411570303": {
            "id": "411570303",
            "speakerId": 1000,
            "speakerName": "卯师傅",
            "text": "璃月的小年轻怎么尽去些稀奇古怪的地方！",
            "nextDialogs": [
              "411570304"
            ]
          },
          "411570304": {
            "id": "411570304",
            "speakerId": 1000,
            "speakerName": "卯师傅",
            "text": "总之这份莲子禽蛋羹，麻烦你帮忙送到去了。<color=#00E1FFFF>不要乱飞</color>，可能会把羹洒出来。"
          }
        }
      }

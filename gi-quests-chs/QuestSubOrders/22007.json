    {
      "subId": "2200703",
      "subQuestName": "与派蒙交谈",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "220070301"
        ],
        "dialogs": {
          "220070301": {
            "id": "220070301",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "唔，能找的地方好像都找遍了…还是没找到呢。",
            "nextDialogs": [
              "220070302"
            ]
          },
          "220070302": {
            "id": "220070302",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "要接着找吗？还是回去再问问宝儿？",
            "nextDialogs": [
              "220070305",
              "220070306"
            ]
          },
          "220070305": {
            "id": "220070305",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "好吧，那我们再仔细找找。"
          },
          "220070306": {
            "id": "220070306",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "嗯，回去再仔细问问吧。"
          }
        }
      }
    },
    {
      "subId": "2200704",
      "subQuestName": "从魔物手里拿回宝儿的东西",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "220070401"
        ],
        "dialogs": {
          "220070401": {
            "id": "220070401",
            "speakerId": 2421,
            "speakerName": "宝儿",
            "text": "你找到文物了吗？",
            "nextDialogs": [
              "220070402"
            ]
          },
          "220070402": {
            "id": "220070402",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "找到了。",
            "nextDialogs": [
              "220070403"
            ]
          },
          "220070403": {
            "id": "220070403",
            "speakerId": 2421,
            "speakerName": "宝儿",
            "text": "我来看看，哇…居然真的是文物…",
            "nextDialogs": [
              "220070404"
            ]
          },
          "220070404": {
            "id": "220070404",
            "speakerId": 2421,
            "speakerName": "宝儿",
            "text": "咳，看起来…这个也不是我丢的文物，但是，也很有价值！",
            "nextDialogs": [
              "220070405"
            ]
          },
          "220070405": {
            "id": "220070405",
            "speakerId": 2421,
            "speakerName": "宝儿",
            "text": "这个文物就交给我这个专业人士来保管，你们就放心吧，嘿嘿…辛苦你们啦。"
          }
        }
      }
    },

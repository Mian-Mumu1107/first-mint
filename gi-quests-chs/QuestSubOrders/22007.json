  "subQuests": [
    {
      "subId": "2200701",
      "subQuestName": "与宝儿交谈",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "220070101"
        ],
        "dialogs": {
          "220070101": {
            "id": "220070101",
            "speakerId": 2421,
            "speakerName": "宝儿",
            "text": "到底掉哪去了…",
            "nextDialogs": [
              "220070102"
            ]
          },
          "220070102": {
            "id": "220070102",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "怎么了？",
            "nextDialogs": [
              "220070103"
            ]
          },
          "220070103": {
            "id": "220070103",
            "speakerId": 2421,
            "speakerName": "宝儿",
            "text": "哎呀，是这样…我在一处遗迹考察的时候，突然被怪物袭击…",
            "nextDialogs": [
              "220070104"
            ]
          },
          "220070104": {
            "id": "220070104",
            "speakerId": 2421,
            "speakerName": "宝儿",
            "text": "我慌里慌张地逃跑，结果，把刚刚挖出来的文物忘在了原地。",
            "nextDialogs": [
              "220070105"
            ]
          },
          "220070105": {
            "id": "220070105",
            "speakerId": 2421,
            "speakerName": "宝儿",
            "text": "那群怪物离开之后，我又折返回去，但是文物已经不见了…",
            "nextDialogs": [
              "220070106"
            ]
          },
          "220070106": {
            "id": "220070106",
            "speakerId": 2421,
            "speakerName": "宝儿",
            "text": "我在周围找了半天也没找到，不知道是不是被怪物拿走了…",
            "nextDialogs": [
              "220070107"
            ]
          },
          "220070107": {
            "id": "220070107",
            "speakerId": 2421,
            "speakerName": "宝儿",
            "text": "你能帮我去找找吗？如果找到文物的话，就用这个盒子装好吧。"
          }
        }
      }
    },
    {
      "subId": "2200702",
      "subQuestName": "寻找宝儿丢失的东西",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "220070201"
        ],
        "dialogs": {
          "220070201": {
            "id": "220070201",
            "speakerId": 2421,
            "speakerName": "宝儿",
            "text": "到底掉哪去了…",
            "nextDialogs": [
              "220070202"
            ]
          },
          "220070202": {
            "id": "220070202",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "只用这个盒子…",
            "nextDialogs": [
              "220070203"
            ]
          },
          "220070203": {
            "id": "220070203",
            "speakerId": 2421,
            "speakerName": "宝儿",
            "text": "喂，你仔细看看啊，我可是用衣服在里面垫了好几层的。",
            "nextDialogs": [
              "220070204"
            ]
          },
          "220070204": {
            "id": "220070204",
            "speakerId": 2421,
            "speakerName": "宝儿",
            "text": "我可是专业的学者，怎么可能犯低级错误。",
            "nextDialogs": [
              "220070205"
            ]
          },
          "220070205": {
            "id": "220070205",
            "speakerId": 2421,
            "speakerName": "宝儿",
            "text": "好了，文物就拜托你了，我可拿那些怪物没办法…"
          }
        }
      }
    },
    {

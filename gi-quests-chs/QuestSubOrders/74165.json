    {
      "subId": "7416501",
      "subQuestName": "进入洋流",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "741650101"
        ],
        "dialogs": {
          "741650101": {
            "id": "741650101",
            "speakerId": 21261,
            "speakerName": "纳齐森科鲁兹",
            "text": "我…感受到了「理性」。到来之人，汝等是水仙十字的后继者，还是齿轮的鹰犬？",
            "nextDialogs": [
              "741650102"
            ]
          },
          "741650102": {
            "id": "741650102",
            "speakerId": 21261,
            "speakerName": "纳齐森科鲁兹",
            "text": "对我拔剑相向了。看来答案不言自明。",
            "nextDialogs": [
              "741650103"
            ]
          },
          "741650103": {
            "id": "741650103",
            "speakerId": 16922,
            "speakerName": "安",
            "text": "纳齐森科鲁兹…",
            "nextDialogs": [
              "741650104"
            ]
          },
          "741650104": {
            "id": "741650104",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "欸？这个东西就是纳齐森科鲁兹吗？",
            "nextDialogs": [
              "741650105"
            ]
          },
          "741650105": {
            "id": "741650105",
            "speakerId": 21261,
            "speakerName": "纳齐森科鲁兹",
            "text": "既然已听闻我名，那汝等自当理解我救世之道义。既已听闻我名，尔等意识之内便有得救的种子。",
            "nextDialogs": [
              "741650106"
            ]
          },
          "741650106": {
            "id": "741650106",
            "speakerId": 21261,
            "speakerName": "纳齐森科鲁兹",
            "text": "想来尔等对我兵锋相向，应该是被谎言所欺骗。如此时机，我也不想浪费太多力量。",
            "nextDialogs": [
              "741650107"
            ]
          },
          "741650107": {
            "id": "741650107",
            "speakerId": 21261,
            "speakerName": "纳齐森科鲁兹",
            "text": "欣喜吧，喝彩吧。在一切结束之后我来解答，我来展现。现在把圣剑归还到我的手中，然后离开避难吧。",
            "nextDialogs": [
              "741650108"
            ]
          },
          "741650108": {
            "id": "741650108",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "才不能把圣剑给你。",
            "nextDialogs": [
              "741650109"
            ]
          },
          "741650109": {
            "id": "741650109",
            "speakerId": 21261,
            "speakerName": "纳齐森科鲁兹",
            "text": "愚蠢啊愚蠢。但是我原谅尔等，就算如此我也会拯救尔等。",
            "nextDialogs": [
              "741650110"
            ]
          },
          "741650110": {
            "id": "741650110",
            "speakerId": 21261,
            "speakerName": "纳齐森科鲁兹",
            "text": "我感觉到了，四象限虽然得以逆转，但是涌流之树的全图并没有完成。",
            "nextDialogs": [
              "741650111"
            ]
          },
          "741650111": {
            "id": "741650111",
            "speakerId": 21261,
            "speakerName": "纳齐森科鲁兹",
            "text": "已经没有办法拯救所有人了。我将最大程度延展我的慈悲，透支我的生命。",
            "nextDialogs": [
              "741650112"
            ]
          },
          "741650112": {
            "id": "741650112",
            "speakerId": 21261,
            "speakerName": "纳齐森科鲁兹",
            "text": "如果只能救五成的人，我就尽力去救下六成的人。",
            "nextDialogs": [
              "741650113"
            ]
          },
          "741650113": {
            "id": "741650113",
            "speakerId": 21261,
            "speakerName": "纳齐森科鲁兹",
            "text": "现在，我要来取圣剑了。"
          }
        }
      }
    },
    {
      "subId": "7416508",
      "subQuestName": "进入洋流",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [],
        "dialogs": {}
      }
    },
    {
      "subId": "7416502",
      "subQuestName": "前进",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "741650201"
        ],
        "dialogs": {
          "741650201": {
            "id": "741650201",
            "speakerId": 21261,
            "speakerName": "纳齐森科鲁兹",
            "text": "不可能…我明明已经登达了「不退还」之位阶。为什么，跌落到了如此境界。",
            "nextDialogs": [
              "741650202"
            ]
          },
          "741650202": {
            "id": "741650202",
            "speakerId": 21261,
            "speakerName": "纳齐森科鲁兹",
            "text": "对原始胎海的掌控也彻底丧失了。",
            "nextDialogs": [
              "741650203"
            ]
          },
          "741650203": {
            "id": "741650203",
            "speakerId": 21261,
            "speakerName": "纳齐森科鲁兹",
            "text": "为什么，为什么会这样？为什么，为什么你们要这么做！",
            "nextDialogs": [
              "741650204"
            ]
          },
          "741650204": {
            "id": "741650204",
            "speakerId": 21261,
            "speakerName": "纳齐森科鲁兹",
            "text": "新世界无法诞生，所有人都要在蛋壳之梦里死去了！",
            "nextDialogs": [
              "741650205"
            ]
          },
          "741650205": {
            "id": "741650205",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "你才是早点从自己的梦里醒过来吧。",
            "nextDialogs": [
              "741650206"
            ]
          },
          "741650206": {
            "id": "741650206",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "世界末日这种事，当然是全世界的人一起想办法解决的事情啦。",
            "nextDialogs": [
              "741650207"
            ]
          },
          "741650207": {
            "id": "741650207",
            "speakerId": 21261,
            "speakerName": "纳齐森科鲁兹",
            "text": "我明白了，是圣剑。它没有站在我这边。它每一次挥动都切削了围聚在我周身的众生意志。",
            "nextDialogs": [
              "741650208"
            ]
          },
          "741650208": {
            "id": "741650208",
            "speakerId": 21261,
            "speakerName": "纳齐森科鲁兹",
            "text": "直到最后，我懦弱的凡人性——我的人格也回到了我的体内。",
            "nextDialogs": [
              "741650210",
              "741650216"
            ]
          },
          "741650210": {
            "id": "741650210",
            "speakerId": 21261,
            "speakerName": "纳齐森科鲁兹",
            "text": "我已经有所察觉，最早填入「世界式」的输入值出现了变动。",
            "nextDialogs": [
              "741650211"
            ]
          },
          "741650211": {
            "id": "741650211",
            "speakerId": 21261,
            "speakerName": "纳齐森科鲁兹",
            "text": "有谁掌控了生命之力，又有什么人开辟了兽之国度。",
            "nextDialogs": [
              "741650212"
            ]
          },
          "741650212": {
            "id": "741650212",
            "speakerId": 21261,
            "speakerName": "纳齐森科鲁兹",
            "text": "还有一个「变量」，那就是你啊。",
            "nextDialogs": [
              "741650213"
            ]
          },
          "741650213": {
            "id": "741650213",
            "speakerId": 21261,
            "speakerName": "纳齐森科鲁兹",
            "text": "注定见证吞食一切之鲸败走的人，一切的见证者。",
            "nextDialogs": [
              "741650214"
            ]
          },
          "741650214": {
            "id": "741650214",
            "speakerId": 21261,
            "speakerName": "纳齐森科鲁兹",
            "text": "原来是这样，原来是这样。",
            "nextDialogs": [
              "741650221"
            ]
          },
          "741650221": {
            "id": "741650221",
            "speakerId": 21261,
            "speakerName": "纳齐森科鲁兹",
            "text": "我也做过这样的梦，想要成为你这样的事物。不过这个梦，刚刚破碎了。",
            "nextDialogs": [
              "741650222"
            ]
          },
          "741650222": {
            "id": "741650222",
            "speakerId": 21261,
            "speakerName": "纳齐森科鲁兹",
            "text": "我所做的一切都毫无意义，就像是一个空虚的梦。",
            "nextDialogs": [
              "741650223"
            ]
          },
          "741650223": {
            "id": "741650223",
            "speakerId": 21261,
            "speakerName": "纳齐森科鲁兹",
            "text": "不，甚至不如一个梦。至少梦是无害的。而我……不，你们，还有他们却为这件事付出了那么多。",
            "nextDialogs": [
              "741650224"
            ]
          },
          "741650224": {
            "id": "741650224",
            "speakerId": 16922,
            "speakerName": "安",
            "text": "纳齐森科鲁兹。",
            "nextDialogs": [
              "741650225"
            ]
          },
          "741650225": {
            "id": "741650225",
            "speakerId": 21261,
            "speakerName": "纳齐森科鲁兹",
            "text": "啊，是你。我都没有发现。",
            "nextDialogs": [
              "741650226"
            ]
          },
          "741650226": {
            "id": "741650226",
            "speakerId": 16922,
            "speakerName": "安",
            "text": "你能知道我究竟是谁吗？",
            "nextDialogs": [
              "741650227"
            ]
          },
          "741650227": {
            "id": "741650227",
            "speakerId": 21261,
            "speakerName": "纳齐森科鲁兹",
            "text": "名字只是一个称呼。混在你灵魂里的两种颜色，我都是再熟悉不过了。",
            "nextDialogs": [
              "741650228"
            ]
          },
          "741650228": {
            "id": "741650228",
            "speakerId": 21261,
            "speakerName": "纳齐森科鲁兹",
            "text": "莉利丝院长不知道发生了什么，她只是抱住了一息尚存的玛丽安。",
            "nextDialogs": [
              "741650229"
            ]
          },
          "741650229": {
            "id": "741650229",
            "speakerId": 21261,
            "speakerName": "纳齐森科鲁兹",
            "text": "她理解不了过于复杂的当下与未来，只是想要留住过去。于是她做了她唯一会做的事情。",
            "nextDialogs": [
              "741650230"
            ]
          },
          "741650230": {
            "id": "741650230",
            "speakerId": 16922,
            "speakerName": "安",
            "text": "我叫做安。",
            "nextDialogs": [
              "741650231"
            ]
          },
          "741650231": {
            "id": "741650231",
            "speakerId": 21261,
            "speakerName": "纳齐森科鲁兹",
            "text": "那么，你好，安。",
            "nextDialogs": [
              "741650232"
            ]
          },
          "741650232": {
            "id": "741650232",
            "speakerId": 16922,
            "speakerName": "安",
            "text": "我愿意原谅你。",
            "nextDialogs": [
              "741650233"
            ]
          },
          "741650233": {
            "id": "741650233",
            "speakerId": 21261,
            "speakerName": "纳齐森科鲁兹",
            "text": "你在说什么奇怪的话。从一开始我的规划就有着崇高与神圣的目的。这中间没有私心。",
            "nextDialogs": [
              "741650234"
            ]
          },
          "741650234": {
            "id": "741650234",
            "speakerId": 21261,
            "speakerName": "纳齐森科鲁兹",
            "text": "没有人能评价我，没有人能审判我，没有人能原谅我。",
            "nextDialogs": [
              "741650235"
            ]
          },
          "741650235": {
            "id": "741650235",
            "speakerId": 16922,
            "speakerName": "安",
            "text": "你的目的或许是崇高的，但是你的疯狂伤害了很多人。",
            "nextDialogs": [
              "741650236"
            ]
          },
          "741650236": {
            "id": "741650236",
            "speakerId": 16922,
            "speakerName": "安",
            "text": "你连算式的输入都没填对。犯错然后被原谅，有什么问题吗？",
            "nextDialogs": [
              "741650237"
            ]
          },
          "741650237": {
            "id": "741650237",
            "speakerId": 21261,
            "speakerName": "纳齐森科鲁兹",
            "text": "…你说得对。我很抱歉。",
            "nextDialogs": [
              "741650238"
            ]
          },
          "741650238": {
            "id": "741650238",
            "speakerId": 16922,
            "speakerName": "安",
            "text": "然后纳齐森科鲁兹，你和我们回去吧。你需要见一见其他人。",
            "nextDialogs": [
              "741650239"
            ]
          },
          "741650239": {
            "id": "741650239",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "虽然这家伙好像变得很好说话了，但是这种要求…",
            "nextDialogs": [
              "741650240"
            ]
          },
          "741650240": {
            "id": "741650240",
            "speakerId": 21261,
            "speakerName": "纳齐森科鲁兹",
            "text": "没问题。",
            "nextDialogs": [
              "741650241"
            ]
          },
          "741650241": {
            "id": "741650241",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "欸！一般不是要做点心理斗争然后让我们劝个半天的吗？",
            "nextDialogs": [
              "741650242"
            ]
          },
          "741650242": {
            "id": "741650242",
            "speakerId": 21261,
            "speakerName": "纳齐森科鲁兹",
            "text": "正如我之前所说，我并未觉得自己有任何负罪。如今伟业惜溃，但是世界已然得救。",
            "nextDialogs": [
              "741650243"
            ]
          },
          "741650243": {
            "id": "741650243",
            "speakerId": 21261,
            "speakerName": "纳齐森科鲁兹",
            "text": "任由他人责骂与嘲笑我吧。我的内心已经空落，徒余一种渴望。",
            "nextDialogs": [
              "741650244"
            ]
          },
          "741650244": {
            "id": "741650244",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "是什么呢？",
            "nextDialogs": [
              "741650245"
            ]
          },
          "741650245": {
            "id": "741650245",
            "speakerId": 21261,
            "speakerName": "纳齐森科鲁兹",
            "text": "我也想回到最开始的时候。水仙的勇者还没有踏上旅程的时候。",
            "nextDialogs": [
              "741650246"
            ]
          },
          "741650246": {
            "id": "741650246",
            "speakerId": 21261,
            "speakerName": "纳齐森科鲁兹",
            "text": "不过这已经办不到了。决定人命运的终究不是人自己，如今我连让自己做什么梦的力量也丢失了。",
            "nextDialogs": [
              "741650247"
            ]
          },
          "741650247": {
            "id": "741650247",
            "speakerId": 16922,
            "speakerName": "安",
            "text": "#那，{NICKNAME}骑士，准备好之后我们就去重新封印胎海然后离开这里吧。"
          },
          "741650216": {
            "id": "741650216",
            "speakerId": 21261,
            "speakerName": "纳齐森科鲁兹",
            "text": "我本该有所察觉，最早填入「世界式」的输入值出现了变动。有「变量」降临此间。",
            "nextDialogs": [
              "741650217"
            ]
          },
          "741650217": {
            "id": "741650217",
            "speakerId": 21261,
            "speakerName": "纳齐森科鲁兹",
            "text": "并非是所有宇宙外到来的事物都能被叫做「降临」或者「变量」。",
            "nextDialogs": [
              "741650218"
            ]
          },
          "741650218": {
            "id": "741650218",
            "speakerId": 21261,
            "speakerName": "纳齐森科鲁兹",
            "text": "原来我少算了一个「变量」，那就是你啊。",
            "nextDialogs": [
              "741650219"
            ]
          },
          "741650219": {
            "id": "741650219",
            "speakerId": 21261,
            "speakerName": "纳齐森科鲁兹",
            "text": "一切的见证者，一切的记录者，一切的设计者。",
            "nextDialogs": [
              "741650220"
            ]
          },
          "741650220": {
            "id": "741650220",
            "speakerId": 21261,
            "speakerName": "纳齐森科鲁兹",
            "text": "唯有自身等价一个世界的人才能担此头衔。"
          }
        }
      }
    },

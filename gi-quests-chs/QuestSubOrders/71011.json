          "3476801"
        ],
        "dialogs": {
          "3476801": {
            "id": "3476801",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "呜哇…这座石碑上的字好难读。",
            "nextDialogs": [
              "3476802"
            ]
          },
          "3476802": {
            "id": "3476802",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "而且又是「仙踪」，又是「宫墟」的，到底是什么意思呢？",
            "nextDialogs": [
              "3476803"
            ]
          },
          "3476803": {
            "id": "3476803",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "不过，上面说「循仙踪兮天遒」…我们至少能确定，这座石碑上记录的事，就发生在这片「天遒谷」。",
            "nextDialogs": [
              "3476804"
            ]
          },
          "3476804": {
            "id": "3476804",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "唔…没办法，我们去周围看看吧，说不定会有什么发现呢。"
          }
        }
      }
    },

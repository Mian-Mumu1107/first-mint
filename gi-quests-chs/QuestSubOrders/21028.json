    {
      "subId": "2102804",
      "subQuestName": "将薄荷交给小蒙",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "210280401"
        ],
        "dialogs": {
          "210280401": {
            "id": "210280401",
            "speakerId": 2031,
            "speakerName": "小蒙",
            "text": "#谢谢{PLAYERAVATAR#SEXPRO[INFO_MALE_PRONOUN_BIGBROTHER|INFO_FEMALE_PRONOUN_BIGSISTER]}！",
            "nextDialogs": [
              "210280402"
            ]
          },
          "210280402": {
            "id": "210280402",
            "speakerId": 2103,
            "speakerName": "阿桂",
            "text": "嗯，这些应该够我做一些药了。",
            "nextDialogs": [
              "210280403"
            ]
          },
          "210280403": {
            "id": "210280403",
            "speakerId": 2103,
            "speakerName": "阿桂",
            "text": "那些治疗中暑的药物，我会放在下批药物里一起送过去。",
            "nextDialogs": [
              "210280404"
            ]
          },
          "210280404": {
            "id": "210280404",
            "speakerId": 2031,
            "speakerName": "小蒙",
            "text": "那就辛苦你啦，阿桂哥哥。",
            "nextDialogs": [
              "210280405"
            ]
          },
          "210280405": {
            "id": "210280405",
            "speakerId": 2031,
            "speakerName": "小蒙",
            "text": "#这些东西给你，谢谢你帮忙，{PLAYERAVATAR#SEXPRO[INFO_MALE_PRONOUN_BIGBROTHER|INFO_FEMALE_PRONOUN_BIGSISTER]}，我们回去吧。",
            "nextDialogs": [
              "210280406"
            ]
          },
          "210280406": {
            "id": "210280406",
            "speakerId": 2031,
            "speakerName": "小蒙",
            "text": "嘿嘿，爸爸听到这个消息肯定会高兴…",
            "nextDialogs": [
              "210280407"
            ]
          },
          "210280407": {
            "id": "210280407",
            "speakerId": 2103,
            "speakerName": "阿桂",
            "text": "小蒙，你等一会。",
            "nextDialogs": [
              "210280408"
            ]
          },
          "210280408": {
            "id": "210280408",
            "speakerId": 2031,
            "speakerName": "小蒙",
            "text": "怎么了？",
            "nextDialogs": [
              "210280409"
            ]
          },
          "210280409": {
            "id": "210280409",
            "speakerId": 2103,
            "speakerName": "阿桂",
            "text": "你不是要核查药物吗？后面的清单你还没看完呢。",
            "nextDialogs": [
              "210280410"
            ]
          },
          "210280410": {
            "id": "210280410",
            "speakerId": 2031,
            "speakerName": "小蒙",
            "text": "欸…欸？我刚才不是核查了那么久…",
            "nextDialogs": [
              "210280411"
            ]
          },
          "210280411": {
            "id": "210280411",
            "speakerId": 2103,
            "speakerName": "阿桂",
            "text": "那才核查了多少，来吧小蒙，我们继续核查。",
            "nextDialogs": [
              "210280412"
            ]
          },
          "210280412": {
            "id": "210280412",
            "speakerId": 2031,
            "speakerName": "小蒙",
            "text": "呜…好…好吧…"
          }
        }
      }
    },

  "subQuests": [
    {
      "subId": "2102801",
      "subQuestName": "与小蒙对话",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "210280101"
        ],
        "dialogs": {
          "210280101": {
            "id": "210280101",
            "speakerId": 2031,
            "speakerName": "小蒙",
            "text": "#{PLAYERAVATAR#SEXPRO[INFO_MALE_PRONOUN_BIGBROTHER|INFO_FEMALE_PRONOUN_BIGSISTER]}！你来得正好，我有事情想问你！",
            "nextDialogs": [
              "210280105",
              "210280104"
            ]
          },
          "210280105": {
            "id": "210280105",
            "speakerId": 2031,
            "speakerName": "小蒙",
            "text": "爸爸说，去须弥的路程很远，需要准备一些药物。",
            "nextDialogs": [
              "210280106"
            ]
          },
          "210280106": {
            "id": "210280106",
            "speakerId": 2031,
            "speakerName": "小蒙",
            "text": "治疗头痛的、防止腹泻的，防止中暑的…还有解酒的，消食的…好多好多。",
            "nextDialogs": [
              "210280107"
            ]
          },
          "210280107": {
            "id": "210280107",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "为什么还要准备解酒的药啦…",
            "nextDialogs": [
              "210280108"
            ]
          },
          "210280108": {
            "id": "210280108",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "谈生意的时候要用吧。",
            "nextDialogs": [
              "210280109"
            ]
          },
          "210280109": {
            "id": "210280109",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "欸？谈生意和解酒药有什么关系，难道喝酒喝得多，生意就会做得好吗？",
            "nextDialogs": [
              "210280110"
            ]
          },
          "210280110": {
            "id": "210280110",
            "speakerId": 2031,
            "speakerName": "小蒙",
            "text": "总之，爸爸要我去「不卜庐」问问，那些药物准备得怎么样了。",
            "nextDialogs": [
              "210280111"
            ]
          },
          "210280111": {
            "id": "210280111",
            "speakerId": 2031,
            "speakerName": "小蒙",
            "text": "#{PLAYERAVATAR#SEXPRO[INFO_MALE_PRONOUN_BIGBROTHER|INFO_FEMALE_PRONOUN_BIGSISTER]}，你能陪我去吗？有些事，我想要请你帮帮忙。"
          },
          "210280104": {
            "id": "210280104",
            "speakerId": 2031,
            "speakerName": "小蒙",
            "text": "大部分都是我爸爸和那群叔叔在准备啦…但是爸爸也交给我了一些任务！"
          }
        }
      }
    },
    {
      "subId": "2102802",
      "subQuestName": "前往「不卜庐」",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "210280201"
        ],
        "dialogs": {
          "210280201": {
            "id": "210280201",
            "speakerId": 2103,
            "speakerName": "阿桂",
            "text": "你好，请问是来抓药的吗？",
            "nextDialogs": [
              "210280202"
            ]
          },
          "210280202": {
            "id": "210280202",
            "speakerId": 2103,
            "speakerName": "阿桂",
            "text": "咦？这不是小蒙吗？你怎么来了？",
            "nextDialogs": [
              "210280203"
            ]
          },
          "210280203": {
            "id": "210280203",
            "speakerId": 2103,
            "speakerName": "阿桂",
            "text": "噢…我知道了，你是来问那些药物的事吧？",
            "nextDialogs": [
              "210280204"
            ]
          },
          "210280204": {
            "id": "210280204",
            "speakerId": 2103,
            "speakerName": "阿桂",
            "text": "放心吧，那些药物我基本上都准备好了，会分批送去给你爸爸的。",
            "nextDialogs": [
              "210280205"
            ]
          },
          "210280205": {
            "id": "210280205",
            "speakerId": 2103,
            "speakerName": "阿桂",
            "text": "不过你爸爸要的药物量太大，店里囤的一些药材都快用完了，可能有一些药会做得慢一些。",
            "nextDialogs": [
              "210280206"
            ]
          },
          "210280206": {
            "id": "210280206",
            "speakerId": 2103,
            "speakerName": "阿桂",
            "text": "我看看啊，嗯…主要是薄荷没剩下多少，所以治疗中暑的药也没法做了。",
            "nextDialogs": [
              "210280207"
            ]
          },
          "210280207": {
            "id": "210280207",
            "speakerId": 2103,
            "speakerName": "阿桂",
            "text": "毕竟，除了制作你爸爸的药物订单之外，我们也要给其他人看病啊。",
            "nextDialogs": [
              "210280208"
            ]
          },
          "210280208": {
            "id": "210280208",
            "speakerId": 2031,
            "speakerName": "小蒙",
            "text": "那…",
            "nextDialogs": [
              "210280210",
              "210280212"
            ]
          },
          "210280210": {
            "id": "210280210",
            "speakerId": 2031,
            "speakerName": "小蒙",
            "text": "#嘿嘿，谢谢{PLAYERAVATAR#SEXPRO[INFO_MALE_PRONOUN_BIGBROTHER|INFO_FEMALE_PRONOUN_BIGSISTER]}！",
            "nextDialogs": [
              "210280213"
            ]
          },
          "210280213": {
            "id": "210280213",
            "speakerId": 2031,
            "speakerName": "小蒙",
            "text": "那药材的事就拜托你啦，我要留在这里仔细核查一下药物。这是爸爸特意叮嘱我的！",
            "nextDialogs": [
              "210280214"
            ]
          },
          "210280214": {
            "id": "210280214",
            "speakerId": 2103,
            "speakerName": "阿桂",
            "text": "这孩子还挺认真的…",
            "nextDialogs": [
              "210280215"
            ]
          },
          "210280215": {
            "id": "210280215",
            "speakerId": 2103,
            "speakerName": "阿桂",
            "text": "那你和我进来吧，我把这一批的药物清单给你看看。",
            "nextDialogs": [
              "210280216"
            ]
          },
          "210280216": {
            "id": "210280216",
            "speakerId": 2031,
            "speakerName": "小蒙",
            "text": "呜啊…怎么这么多…",
            "nextDialogs": [
              "210280217"
            ]
          },
          "210280217": {
            "id": "210280217",
            "speakerId": 2103,
            "speakerName": "阿桂",
            "text": "你先看这些，我把另外一批拿过来。",
            "nextDialogs": [
              "210280218"
            ]
          },
          "210280218": {
            "id": "210280218",
            "speakerId": 2031,
            "speakerName": "小蒙",
            "text": "欸？还有吗？！"
          },
          "210280212": {
            "id": "210280212",
            "speakerId": 2031,
            "speakerName": "小蒙",
            "text": "#嘿嘿，没问题！谢谢{PLAYERAVATAR#SEXPRO[INFO_MALE_PRONOUN_BIGBROTHER|INFO_FEMALE_PRONOUN_BIGSISTER]}！"
          }
        }
      }
    },

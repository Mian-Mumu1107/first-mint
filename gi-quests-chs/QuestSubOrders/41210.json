    {
      "subId": "4121005",
      "subQuestName": "带上神秘的剑去战斗",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "412100501"
        ],
        "dialogs": {
          "412100501": {
            "id": "412100501",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "盗宝团居然叫我们小偷，明明他们自己才是小偷！",
            "nextDialogs": [
              "412100502"
            ]
          },
          "412100502": {
            "id": "412100502",
            "speakerId": 1018,
            "speakerName": "阿贝多",
            "text": "这些人来得可真快啊。",
            "nextDialogs": [
              "412100505"
            ]
          },
          "412100505": {
            "id": "412100505",
            "speakerId": 1018,
            "speakerName": "阿贝多",
            "text": "怎么可能。",
            "nextDialogs": [
              "412100506"
            ]
          },
          "412100506": {
            "id": "412100506",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "他们说的东西，好像就是这把剑，到底是怎么回事呀？",
            "nextDialogs": [
              "412100507"
            ]
          },
          "412100507": {
            "id": "412100507",
            "speakerId": 1018,
            "speakerName": "阿贝多",
            "text": "你那是什么表情？我当然不可能去偷剑了。",
            "nextDialogs": [
              "412100508"
            ]
          },
          "412100508": {
            "id": "412100508",
            "speakerId": 1018,
            "speakerName": "阿贝多",
            "text": "不久前，骑士团在蒙德城外抓捕了一批盗宝团，他们非法搬运的赃物也被全数收缴。",
            "nextDialogs": [
              "412100509"
            ]
          },
          "412100509": {
            "id": "412100509",
            "speakerId": 1018,
            "speakerName": "阿贝多",
            "text": "这把剑就是其中之一。说是赃物，却没人认领，也不知从哪儿来的，一直丢在仓库里。",
            "nextDialogs": [
              "412100510"
            ]
          },
          "412100510": {
            "id": "412100510",
            "speakerId": 1018,
            "speakerName": "阿贝多",
            "text": "我去仓库拿东西的时候意外注意到了它。说真的，旧成这样的剑除了拿来做炼金材料恐怕别无他用。",
            "nextDialogs": [
              "412100511"
            ]
          },
          "412100511": {
            "id": "412100511",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "噫，怎么能把赃物说成是自己的东西呀！",
            "nextDialogs": [
              "412100512"
            ]
          },
          "412100512": {
            "id": "412100512",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "然后呢？你就把它拿走了？",
            "nextDialogs": [
              "412100513"
            ]
          },
          "412100513": {
            "id": "412100513",
            "speakerId": 1018,
            "speakerName": "阿贝多",
            "text": "嗯，我拿这把剑是想做实验用，却没想到，在调查过程中发现了它的真实来历。",
            "nextDialogs": [
              "412100514"
            ]
          },
          "412100514": {
            "id": "412100514",
            "speakerId": 1018,
            "speakerName": "阿贝多",
            "text": "这把看似老旧的武器出自某位已故铁匠之手，是传说中的魔剑。",
            "nextDialogs": [
              "412100515"
            ]
          },
          "412100515": {
            "id": "412100515",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "魔剑？！",
            "nextDialogs": [
              "412100516"
            ]
          },
          "412100516": {
            "id": "412100516",
            "speakerId": 1018,
            "speakerName": "阿贝多",
            "text": "据说，铁匠在铸剑后不久便失踪，剑也下落不明。",
            "nextDialogs": [
              "412100517"
            ]
          },
          "412100517": {
            "id": "412100517",
            "speakerId": 1018,
            "speakerName": "阿贝多",
            "text": "根据赃物来源反推，它多半是被盗宝团偷走，由此失传至今。",
            "nextDialogs": [
              "412100518"
            ]
          },
          "412100518": {
            "id": "412100518",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "啊！造剑的人失踪了？！好可怕！",
            "nextDialogs": [
              "412100519"
            ]
          },
          "412100519": {
            "id": "412100519",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "怪不得是被诅咒的魔剑！",
            "nextDialogs": [
              "412100520"
            ]
          },
          "412100520": {
            "id": "412100520",
            "speakerId": 1018,
            "speakerName": "阿贝多",
            "text": "没错。",
            "nextDialogs": [
              "412100521"
            ]
          },
          "412100521": {
            "id": "412100521",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "人类竟然能造出这样的魔剑…",
            "nextDialogs": [
              "412100522"
            ]
          },
          "412100522": {
            "id": "412100522",
            "speakerId": 1018,
            "speakerName": "阿贝多",
            "text": "你知道关于<color=#00E1FFFF>「杜林」</color>和这座雪山的事吗？",
            "nextDialogs": [
              "412100523"
            ]
          },
          "412100523": {
            "id": "412100523",
            "speakerId": 1018,
            "speakerName": "阿贝多",
            "text": "<color=#00E1FFFF>「杜林」</color>，就是数百年前<color=#00E1FFFF>「风神巴巴托斯」</color>与<color=#00E1FFFF>「特瓦林」</color>联手击败的、威胁蒙德的黑龙。",
            "nextDialogs": [
              "412100524"
            ]
          },
          "412100524": {
            "id": "412100524",
            "speakerId": 1018,
            "speakerName": "阿贝多",
            "text": "激战最后，被打败的杜林从空中坠落，跌入了茫茫白雪。",
            "nextDialogs": [
              "412100525"
            ]
          },
          "412100525": {
            "id": "412100525",
            "speakerId": 1018,
            "speakerName": "阿贝多",
            "text": "雪山上的积雪终年不化，是一件非常奇妙的事。杜林落在这里，究竟是偶然还是必然？",
            "nextDialogs": [
              "412100526"
            ]
          },
          "412100526": {
            "id": "412100526",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "还能是必然吗？",
            "nextDialogs": [
              "412100527"
            ]
          },
          "412100527": {
            "id": "412100527",
            "speakerId": 1018,
            "speakerName": "阿贝多",
            "text": "选择雪山作为坟场，说不定是想利用这种冰封一切的力量来抑制杜林身上的腐殖之毒。",
            "nextDialogs": [
              "412100528"
            ]
          },
          "412100528": {
            "id": "412100528",
            "speakerId": 1018,
            "speakerName": "阿贝多",
            "text": "巴巴托斯那样的神明，应该能想到这一办法才对。",
            "nextDialogs": [
              "412100529"
            ]
          },
          "412100529": {
            "id": "412100529",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "哇…巴巴托斯那么厉害的吗…",
            "nextDialogs": [
              "412100530"
            ]
          },
          "412100530": {
            "id": "412100530",
            "speakerId": 1018,
            "speakerName": "阿贝多",
            "text": "这些只是我的猜测，并没有依据。但可以确定，这座雪山与杜林有着千丝万缕的瓜葛。",
            "nextDialogs": [
              "412100531"
            ]
          },
          "412100531": {
            "id": "412100531",
            "speakerId": 1018,
            "speakerName": "阿贝多",
            "text": "而你手中这把剑的材料里，应该就有杜林的残骸。",
            "nextDialogs": [
              "412100532"
            ]
          },
          "412100532": {
            "id": "412100532",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "龙的残骸？！",
            "nextDialogs": [
              "412100533"
            ]
          },
          "412100533": {
            "id": "412100533",
            "speakerId": 1018,
            "speakerName": "阿贝多",
            "text": "嗯。将死去的龙的眼睛、指甲、鳞片……磨成粉末涂抹到剑身上。",
            "nextDialogs": [
              "412100534"
            ]
          },
          "412100534": {
            "id": "412100534",
            "speakerId": 1018,
            "speakerName": "阿贝多",
            "text": "这样一来，杜林的污秽与毒便能融入剑中，成为剑的威力来源。",
            "nextDialogs": [
              "412100535"
            ]
          },
          "412100535": {
            "id": "412100535",
            "speakerId": 1018,
            "speakerName": "阿贝多",
            "text": "这是非常高超的工艺，铁匠在铸剑成功后，一定会因为喜悦而亲自试剑。",
            "nextDialogs": [
              "412100536"
            ]
          },
          "412100536": {
            "id": "412100536",
            "speakerId": 1018,
            "speakerName": "阿贝多",
            "text": "只要他使用这把剑来战斗，剑上的污秽之力就会顺着剑柄传入他体内。",
            "nextDialogs": [
              "412100537"
            ]
          },
          "412100537": {
            "id": "412100537",
            "speakerId": 1018,
            "speakerName": "阿贝多",
            "text": "常人无法抵抗这种力量，因诅咒而精神错乱的铁匠四处疯逃，说不定，就在某处遭遇了不测。",
            "nextDialogs": [
              "412100538"
            ]
          },
          "412100538": {
            "id": "412100538",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "呜哇…",
            "nextDialogs": [
              "412100539"
            ]
          },
          "412100539": {
            "id": "412100539",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "……",
            "nextDialogs": [
              "412100540"
            ]
          },
          "412100540": {
            "id": "412100540",
            "speakerId": 1018,
            "speakerName": "阿贝多",
            "text": "你净化过特瓦林的泪滴，有着极为罕见的力量。",
            "nextDialogs": [
              "412100541"
            ]
          },
          "412100541": {
            "id": "412100541",
            "speakerId": 1018,
            "speakerName": "阿贝多",
            "text": "这份力量确保了你不仅不会被污秽和毒性腐蚀，还能彻底消除它们的危险性。",
            "nextDialogs": [
              "412100542"
            ]
          },
          "412100542": {
            "id": "412100542",
            "speakerId": 1018,
            "speakerName": "阿贝多",
            "text": "所以，只有你能好好地使用这把剑了。",
            "nextDialogs": [
              "412100543"
            ]
          },
          "412100543": {
            "id": "412100543",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "话虽如此，这把剑果然还是太…呀！",
            "nextDialogs": [
              "412100544"
            ]
          },
          "412100544": {
            "id": "412100544",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "它、它好像在发光？",
            "nextDialogs": [
              "412100545"
            ]
          },
          "412100545": {
            "id": "412100545",
            "speakerId": 1018,
            "speakerName": "阿贝多",
            "text": "对我来说，这正是实验开始的信号。",
            "nextDialogs": [
              "412100546"
            ]
          },
          "412100546": {
            "id": "412100546",
            "speakerId": 1018,
            "speakerName": "阿贝多",
            "text": "这把剑现在还很弱，可它能吸收力量，通过这种方法，它会不断增强自身。",
            "nextDialogs": [
              "412100547"
            ]
          },
          "412100547": {
            "id": "412100547",
            "speakerId": 1018,
            "speakerName": "阿贝多",
            "text": "从某种意义上说，也算是「活物」。",
            "nextDialogs": [
              "412100548"
            ]
          },
          "412100548": {
            "id": "412100548",
            "speakerId": 1018,
            "speakerName": "阿贝多",
            "text": "旅行者，拿着它尽情冒险吧，我需要你来让它不断成长。",
            "nextDialogs": [
              "412100549"
            ]
          },
          "412100549": {
            "id": "412100549",
            "speakerId": 1018,
            "speakerName": "阿贝多",
            "text": "相信在不久的将来，一切推论都会得到验证。"
          }
        }
      }
    },

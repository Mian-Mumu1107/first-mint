{
  "lineCounts": {
    "Player": 17,
    "凶恶的男人": 3,
    "派蒙": 37,
    "砂糖": 17,
    "阿贝多": 48
  },
  "subQuests": [
    {
      "subId": "4121001",
      "subQuestName": "前往冒险家营地",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "412100101"
        ],
        "dialogs": {
          "412100101": {
            "id": "412100101",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "#嗯？{NICKNAME}，你看，这一带有驻扎的痕迹！是不是有其他冒险家在附近探险呢？",
            "nextDialogs": [
              "412100102"
            ]
          },
          "412100102": {
            "id": "412100102",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "同为冒险家，去看看别人在雪山奋斗的模样吧！"
          }
        }
      }
    },
    {
      "subId": "4121002",
      "subQuestName": "与砂糖对话",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "412100201"
        ],
        "dialogs": {
          "412100201": {
            "id": "412100201",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "呀，是砂糖！",
            "nextDialogs": [
              "412100202"
            ]
          },
          "412100202": {
            "id": "412100202",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "你也来雪山探险吗？",
            "nextDialogs": [
              "412100203"
            ]
          },
          "412100203": {
            "id": "412100203",
            "speakerId": 1019,
            "speakerName": "砂糖",
            "text": "呜哇！吓我一跳…请不要在我思考研究报告的时候突然吓唬我！",
            "nextDialogs": [
              "412100204"
            ]
          },
          "412100204": {
            "id": "412100204",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "可你看上去只是呆呆地站着而已呀…",
            "nextDialogs": [
              "412100205"
            ]
          },
          "412100205": {
            "id": "412100205",
            "speakerId": 1019,
            "speakerName": "砂糖",
            "text": "没、没有这种事，我明明是在为新研发的四倍大种子甜甜花取名。",
            "nextDialogs": [
              "412100208"
            ]
          },
          "412100208": {
            "id": "412100208",
            "speakerId": 1019,
            "speakerName": "砂糖",
            "text": "哦哦？你感兴趣吗！太好了，下次请务必给我向你展示新成果的机会！",
            "nextDialogs": [
              "412100209"
            ]
          },
          "412100209": {
            "id": "412100209",
            "speakerId": 1019,
            "speakerName": "砂糖",
            "text": "好可惜，要不是来雪山，我一般都会把成品带在身边的…",
            "nextDialogs": [
              "412100210"
            ]
          },
          "412100210": {
            "id": "412100210",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "对哦，你不是在城里做研究吗？怎么跑到这里来啦？",
            "nextDialogs": [
              "412100211"
            ]
          },
          "412100211": {
            "id": "412100211",
            "speakerId": 1019,
            "speakerName": "砂糖",
            "text": "我和蒂玛乌斯在帮阿贝多先生整理实验数据哦。蒂玛乌斯刚走，你们没遇到他吗？",
            "nextDialogs": [
              "412100212"
            ]
          },
          "412100212": {
            "id": "412100212",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "没有哎。",
            "nextDialogs": [
              "412100213"
            ]
          },
          "412100213": {
            "id": "412100213",
            "speakerId": 1019,
            "speakerName": "砂糖",
            "text": "他说自己对数据不够敏锐，比阿贝多先生差了太多。",
            "nextDialogs": [
              "412100214"
            ]
          },
          "412100214": {
            "id": "412100214",
            "speakerId": 1019,
            "speakerName": "砂糖",
            "text": "有些东西先生一眼就能看出来，我们却要想很久。恐怕这就是学识与经验的差距吧…",
            "nextDialogs": [
              "412100215"
            ]
          },
          "412100215": {
            "id": "412100215",
            "speakerId": 1019,
            "speakerName": "砂糖",
            "text": "因为沮丧，他就说要去别处散散步，我一个人先做剩余的工作。",
            "nextDialogs": [
              "412100216"
            ]
          },
          "412100216": {
            "id": "412100216",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "（总觉得蒂玛乌斯是不是故意的…）",
            "nextDialogs": [
              "412100217"
            ]
          },
          "412100217": {
            "id": "412100217",
            "speakerId": 1019,
            "speakerName": "砂糖",
            "text": "本想做完手上的事四处转转，没想到从报告里找到了一些有趣数据！",
            "nextDialogs": [
              "412100218"
            ]
          },
          "412100218": {
            "id": "412100218",
            "speakerId": 1019,
            "speakerName": "砂糖",
            "text": "唉…我的探秘之旅，又要延后了呀…",
            "nextDialogs": [
              "412100219"
            ]
          },
          "412100219": {
            "id": "412100219",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "探秘？什么秘？！",
            "nextDialogs": [
              "412100220"
            ]
          },
          "412100220": {
            "id": "412100220",
            "speakerId": 1019,
            "speakerName": "砂糖",
            "text": "啊…这么说来，你们现在有空吗？",
            "nextDialogs": [
              "412100221"
            ]
          },
          "412100221": {
            "id": "412100221",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "有呀！我们正在到处闲逛呢！",
            "nextDialogs": [
              "412100222"
            ]
          },
          "412100222": {
            "id": "412100222",
            "speakerId": 1019,
            "speakerName": "砂糖",
            "text": "能请你们帮我一个忙吗？事实上，我总觉得…阿贝多先生有事瞒着我和蒂玛乌斯。",
            "nextDialogs": [
              "412100223"
            ]
          },
          "412100223": {
            "id": "412100223",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "阿贝多不是你们的老师吗？老师能有什么事瞒着学生呀。",
            "nextDialogs": [
              "412100224"
            ]
          },
          "412100224": {
            "id": "412100224",
            "speakerId": 1019,
            "speakerName": "砂糖",
            "text": "是啊，可他似乎一直在掩藏某件东西…我猜，一定是与炼金术有关的厉害东西！",
            "nextDialogs": [
              "412100225"
            ]
          },
          "412100225": {
            "id": "412100225",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "明明不知道实情，为什么还能这么肯定啊！",
            "nextDialogs": [
              "412100226"
            ]
          },
          "412100226": {
            "id": "412100226",
            "speakerId": 1019,
            "speakerName": "砂糖",
            "text": "因为我和蒂玛乌斯都是炼金术的狂热研究者，如果是别的东西，阿贝多先生没必要瞒着我们才对。",
            "nextDialogs": [
              "412100227"
            ]
          },
          "412100227": {
            "id": "412100227",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "啊…这么一说确实很有道理…",
            "nextDialogs": [
              "412100228"
            ]
          },
          "412100228": {
            "id": "412100228",
            "speakerId": 1019,
            "speakerName": "砂糖",
            "text": "能帮我调查一下阿贝多先生到底藏着什么吗？我实在是太好奇了！拜托拜托！",
            "nextDialogs": [
              "412100229"
            ]
          },
          "412100229": {
            "id": "412100229",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "唔…你觉得呢？"
          }
        }
      }
    },
    {
      "subId": "4121003",
      "subQuestName": "找到阿贝多，了解他的秘密",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "412100301"
        ],
        "dialogs": {
          "412100301": {
            "id": "412100301",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "阿贝多——！",
            "nextDialogs": [
              "412100302"
            ]
          },
          "412100302": {
            "id": "412100302",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "嗨，又是我们哦。",
            "nextDialogs": [
              "412100303"
            ]
          },
          "412100303": {
            "id": "412100303",
            "speakerId": 1018,
            "speakerName": "阿贝多",
            "text": "嗯？你们怎么回来了？",
            "nextDialogs": [
              "412100304"
            ]
          },
          "412100304": {
            "id": "412100304",
            "speakerId": 1018,
            "speakerName": "阿贝多",
            "text": "迷路了吗？",
            "nextDialogs": [
              "412100305"
            ]
          },
          "412100305": {
            "id": "412100305",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "不是啦！",
            "nextDialogs": [
              "412100308"
            ]
          },
          "412100308": {
            "id": "412100308",
            "speakerId": 1018,
            "speakerName": "阿贝多",
            "text": "哦？秘密？",
            "nextDialogs": [
              "412100309"
            ]
          },
          "412100309": {
            "id": "412100309",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "啊啊啊，你在干什么呀！",
            "nextDialogs": [
              "412100310"
            ]
          },
          "412100310": {
            "id": "412100310",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "这种时候不是应该悄悄调查吗？怎么就说出来了！",
            "nextDialogs": [
              "412100311"
            ]
          },
          "412100311": {
            "id": "412100311",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "反正也瞒不过阿贝多吧。",
            "nextDialogs": [
              "412100312"
            ]
          },
          "412100312": {
            "id": "412100312",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "呜…就算你这么说…",
            "nextDialogs": [
              "412100313"
            ]
          },
          "412100313": {
            "id": "412100313",
            "speakerId": 1018,
            "speakerName": "阿贝多",
            "text": "来得正好，我也有事要找你，旅行者。",
            "nextDialogs": [
              "412100314"
            ]
          },
          "412100314": {
            "id": "412100314",
            "speakerId": 1018,
            "speakerName": "阿贝多",
            "text": "接着！",
            "nextDialogs": [
              "412100315"
            ]
          },
          "412100315": {
            "id": "412100315",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "咦，这是什么？",
            "nextDialogs": [
              "412100316"
            ]
          },
          "412100316": {
            "id": "412100316",
            "speakerId": 1018,
            "speakerName": "阿贝多",
            "text": "如你所见，一把单手剑。"
          }
        }
      }
    },

  "subQuests": [
    {
      "subId": "7500901",
      "subQuestName": "(test)试图进入挖掘场$HIDDEN",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "750090101"
        ],
        "dialogs": {
          "750090101": {
            "id": "750090101",
            "speakerId": 21485,
            "speakerName": "奎皮亚",
            "text": "…进场三百摩拉。",
            "nextDialogs": [
              "750090105",
              "750090104"
            ]
          },
          "750090105": {
            "id": "750090105",
            "speakerId": 21485,
            "speakerName": "奎皮亚",
            "text": "这是龙遗物研究协会规定的价格，没有商量的余地。据我所知，这里已经是定价最低的一处挖掘场了，毕竟开发得早。",
            "nextDialogs": [
              "750090106"
            ]
          },
          "750090106": {
            "id": "750090106",
            "speakerId": 21485,
            "speakerName": "奎皮亚",
            "text": "不过现在也偶尔会有像你们这样的梦想家来碰碰运气。",
            "nextDialogs": [
              "750090107"
            ]
          },
          "750090107": {
            "id": "750090107",
            "speakerId": 21485,
            "speakerName": "奎皮亚",
            "text": "说不定是之前的一百甚至一千人都没眼光，遗漏了那看似平平无奇实则价值连城的珍贵龙遗物。",
            "nextDialogs": [
              "750090108"
            ]
          },
          "750090108": {
            "id": "750090108",
            "speakerId": 21485,
            "speakerName": "奎皮亚",
            "text": "愿意花三百摩拉做个美梦的可是大有人在。",
            "nextDialogs": [
              "750090109"
            ]
          },
          "750090109": {
            "id": "750090109",
            "speakerId": 21485,
            "speakerName": "奎皮亚",
            "text": "那么，你也相信自己才是独一无二的那个幸运儿吗？",
            "nextDialogs": [
              "750090110"
            ]
          },
          "750090110": {
            "id": "750090110",
            "speakerId": 14662,
            "speakerName": "#{REALNAME[ID(2)|SHOWHOST(true)]}",
            "text": "呜…呀！呀呀！"
          },
          "750090104": {
            "id": "750090104",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "通常来说都不会这么想啦！"
          }
        }
      }
    },

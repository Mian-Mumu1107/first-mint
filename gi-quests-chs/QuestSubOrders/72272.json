  "subQuests": [
    {
      "subId": "7227201",
      "subQuestName": "（test）跟荣一郎说话$HIDDEN",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "722720101"
        ],
        "dialogs": {
          "722720101": {
            "id": "722720101",
            "speakerId": 3003,
            "speakerName": "御舆源一郎",
            "text": "你好，看上什么工艺品了吗？如果在店里找不到现成的，我可以定做。",
            "nextDialogs": [
              "722720102"
            ]
          },
          "722720102": {
            "id": "722720102",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "我有宝物想要出售。",
            "nextDialogs": [
              "722720103"
            ]
          },
          "722720103": {
            "id": "722720103",
            "speakerId": 3003,
            "speakerName": "御舆源一郎",
            "text": "欸？其实小店已经有了固定的进货渠道，平时也没有收购散货的业务...",
            "nextDialogs": [
              "722720104"
            ]
          },
          "722720104": {
            "id": "722720104",
            "speakerId": 3003,
            "speakerName": "御舆源一郎",
            "text": "不过看你的样子…似乎是个了不起的东西？",
            "nextDialogs": [
              "722720105"
            ]
          },
          "722720105": {
            "id": "722720105",
            "speakerId": 3003,
            "speakerName": "御舆源一郎",
            "text": "既然如此…不如先给我看看吧？",
            "nextDialogs": [
              "722720106"
            ]
          },
          "722720106": {
            "id": "722720106",
            "speakerId": 1001,
            "speakerName": "Black Screen",
            "text": "将龙骨花凝珠的故事告诉了御舆源一郎。",
            "nextDialogs": [
              "722720107"
            ]
          },
          "722720107": {
            "id": "722720107",
            "speakerId": 3003,
            "speakerName": "御舆源一郎",
            "text": "唔…",
            "nextDialogs": [
              "722720108"
            ]
          },
          "722720108": {
            "id": "722720108",
            "speakerId": 3003,
            "speakerName": "御舆源一郎",
            "text": "坦白说…虽然这个故事很神奇…但是好像也稍微神奇过头了些…",
            "nextDialogs": [
              "722720109"
            ]
          },
          "722720109": {
            "id": "722720109",
            "speakerId": 3003,
            "speakerName": "御舆源一郎",
            "text": "这种东西，已经有些超出我的理解能力了。",
            "nextDialogs": [
              "722720110"
            ]
          },
          "722720110": {
            "id": "722720110",
            "speakerId": 3003,
            "speakerName": "御舆源一郎",
            "text": "请别见笑，毕竟我也只是会做些手工艺品的家伙…",
            "nextDialogs": [
              "722720120"
            ]
          },
          "722720120": {
            "id": "722720120",
            "speakerId": 3003,
            "speakerName": "御舆源一郎",
            "text": "这样吧，80000摩拉，最多再加5份刺身拼盘，这种料理可不便宜。",
            "nextDialogs": [
              "722720111"
            ]
          },
          "722720111": {
            "id": "722720111",
            "speakerId": 3003,
            "speakerName": "御舆源一郎",
            "text": "这个价格你接受的话，我就买下这件宝物。",
            "nextDialogs": [
              "722720113",
              "722720116",
              "722720118"
            ]
          },
          "722720113": {
            "id": "722720113",
            "speakerId": 3003,
            "speakerName": "御舆源一郎",
            "text": "我还说不清楚，得再仔细琢磨一下这个东西。",
            "nextDialogs": [
              "722720114"
            ]
          },
          "722720114": {
            "id": "722720114",
            "speakerId": 3003,
            "speakerName": "御舆源一郎",
            "text": "如果情况好的话，说不定可以加工成一种特别的根付，这样应该能多卖点价钱。"
          },
          "722720116": {
            "id": "722720116",
            "speakerId": 3003,
            "speakerName": "御舆源一郎",
            "text": "那么这些摩拉请收好。我得去好好研究研究这个。"
          },
          "722720118": {
            "id": "722720118",
            "speakerId": 3003,
            "speakerName": "御舆源一郎",
            "text": "嗯…刚好我也可以再想想。",
            "nextDialogs": [
              "722720119"
            ]
          },
          "722720119": {
            "id": "722720119",
            "speakerId": 3003,
            "speakerName": "御舆源一郎",
            "text": "如果你考虑好了，可以再来找我。"
          }
        }
      }
    },

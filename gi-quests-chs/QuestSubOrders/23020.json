  "subQuests": [
    {
      "subId": "2302001",
      "subQuestName": "与拉菲克对话",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "230200101"
        ],
        "dialogs": {
          "230200101": {
            "id": "230200101",
            "speakerId": 4031,
            "speakerName": "绮珊",
            "text": "…所以说，我觉得这一块区域的材料是不能这么省的。",
            "nextDialogs": [
              "230200102"
            ]
          },
          "230200102": {
            "id": "230200102",
            "speakerId": 4032,
            "speakerName": "拉菲克",
            "text": "放心吧，这部分区域的强度肯定足够了，我算了很多遍。",
            "nextDialogs": [
              "230200103"
            ]
          },
          "230200103": {
            "id": "230200103",
            "speakerId": 4031,
            "speakerName": "绮珊",
            "text": "唉，都说了有很多问题是算不出来的…",
            "nextDialogs": [
              "230200104"
            ]
          },
          "230200104": {
            "id": "230200104",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "你们在争什么呢？",
            "nextDialogs": [
              "230200105"
            ]
          },
          "230200105": {
            "id": "230200105",
            "speakerId": 4032,
            "speakerName": "拉菲克",
            "text": "是你啊，我们正在讨论我那艘船的设计问题呢。",
            "nextDialogs": [
              "230200106"
            ]
          },
          "230200106": {
            "id": "230200106",
            "speakerId": 4032,
            "speakerName": "拉菲克",
            "text": "我已经进行了充分的计算，保证每一个区域都有充分的强度。",
            "nextDialogs": [
              "230200107"
            ]
          },
          "230200107": {
            "id": "230200107",
            "speakerId": 4032,
            "speakerName": "拉菲克",
            "text": "但绮珊坚持说，那些区域的强度不一定可靠…",
            "nextDialogs": [
              "230200108"
            ]
          },
          "230200108": {
            "id": "230200108",
            "speakerId": 4031,
            "speakerName": "绮珊",
            "text": "你说的那些「强度」都只存在于理论上。",
            "nextDialogs": [
              "230200109"
            ]
          },
          "230200109": {
            "id": "230200109",
            "speakerId": 4031,
            "speakerName": "绮珊",
            "text": "船下水了之后要承受的强度，一定会远远高于这个数值。",
            "nextDialogs": [
              "230200110"
            ]
          },
          "230200110": {
            "id": "230200110",
            "speakerId": 4032,
            "speakerName": "拉菲克",
            "text": "道理我都明白…但，但我手头的资金有限…还有…",
            "nextDialogs": [
              "230200111"
            ]
          },
          "230200111": {
            "id": "230200111",
            "speakerId": 4032,
            "speakerName": "拉菲克",
            "text": "要是再采购更贵的材料，我顶多就能把这艘船的龙骨造完了…咳！",
            "nextDialogs": [
              "230200112"
            ]
          },
          "230200112": {
            "id": "230200112",
            "speakerId": 4032,
            "speakerName": "拉菲克",
            "text": "总之！目前这艘船就先按照我的方案来吧，材料我都采购完了。",
            "nextDialogs": [
              "230200113"
            ]
          },
          "230200113": {
            "id": "230200113",
            "speakerId": 4032,
            "speakerName": "拉菲克",
            "text": "旅行者，如果你愿意的话，能帮我去先搬一部分材料回来吗？我一个人实在是搬不完…",
            "nextDialogs": [
              "230200118",
              "230200116"
            ]
          },
          "230200118": {
            "id": "230200118",
            "speakerId": 4032,
            "speakerName": "拉菲克",
            "text": "那就拜托你了，我还得在这里计算一些东西。等计算完了，我再去把剩下的材料搬回来…"
          },
          "230200116": {
            "id": "230200116",
            "speakerId": 4032,
            "speakerName": "拉菲克",
            "text": "那可不，她在计算某些部分的时候比我算得还快呢。",
            "nextDialogs": [
              "230200117"
            ]
          },
          "230200117": {
            "id": "230200117",
            "speakerId": 4032,
            "speakerName": "拉菲克",
            "text": "真不知道她为什么在这里做服务生…"
          }
        }
      }
    },
    {
      "subId": "2302002",
      "subQuestName": "前去拿取修船物资",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "230200201"
        ],
        "dialogs": {
          "230200201": {
            "id": "230200201",
            "speakerId": 4031,
            "speakerName": "绮珊",
            "text": "拉菲克所计算的那些船体所需材料强度，单从理论数据上看确实没问题。",
            "nextDialogs": [
              "230200202"
            ]
          },
          "230200202": {
            "id": "230200202",
            "speakerId": 4031,
            "speakerName": "绮珊",
            "text": "但如果真要下水的话…",
            "nextDialogs": [
              "230200203"
            ]
          },
          "230200203": {
            "id": "230200203",
            "speakerId": 4031,
            "speakerName": "绮珊",
            "text": "算了，他肯定也不愿意听我说的吧…"
          }
        }
      }
    },
    {
      "subId": "2302003",
      "subQuestName": "前去拿取修船物资",
      "sceneId": null,
      "locations": [],
      "dialogue": {

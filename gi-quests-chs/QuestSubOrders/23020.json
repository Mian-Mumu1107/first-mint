      }
    },
    {
      "subId": "2302004",
      "subQuestName": "回去向拉菲克说明情况",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "230200401"
        ],
        "dialogs": {
          "230200401": {
            "id": "230200401",
            "speakerId": 4032,
            "speakerName": "拉菲克",
            "text": "怎么样，你把那些材料搬过来了吗？"
          }
        }
      }
    },
    {
      "subId": "2302005",
      "subQuestName": "回去向拉菲克说明情况",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "230200501"
        ],
        "dialogs": {
          "230200501": {
            "id": "230200501",
            "speakerId": 4032,
            "speakerName": "拉菲克",
            "text": "喔！多谢你了，旅行者。这是你的报酬。",
            "nextDialogs": [
              "230200502"
            ]
          },
          "230200502": {
            "id": "230200502",
            "speakerId": 4032,
            "speakerName": "拉菲克",
            "text": "不过，这材料真是出乎意料的重啊…",
            "nextDialogs": [
              "230200503"
            ]
          },
          "230200503": {
            "id": "230200503",
            "speakerId": 4032,
            "speakerName": "拉菲克",
            "text": "我会尽快开始建造的，这艘小船花不了多长功夫，应该过段时间就能下水试航了。",
            "nextDialogs": [
              "230200504"
            ]
          },
          "230200504": {
            "id": "230200504",
            "speakerId": 4031,
            "speakerName": "绮珊",
            "text": "…到时候你可要准备好救生用具。",
            "nextDialogs": [
              "230200505"
            ]
          },
          "230200505": {
            "id": "230200505",
            "speakerId": 4032,
            "speakerName": "拉菲克",
            "text": "哎呀，没问题的，绝对没问题，你就相信我吧。"
          }
        }
      }
    },
    {
      "subId": "2302006",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "230200601"
        ],
        "dialogs": {
          "230200601": {
            "id": "230200601",
            "speakerId": 4032,
            "speakerName": "拉菲克",
            "text": "预算也没剩下多少了，必须要省着点用才行…"
          }
        }
      }
    }

  },
  "subQuests": [
    {
      "subId": "7425001",
      "subQuestName": "前往布法蒂公馆附近开启茶会",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "742500101"
        ],
        "dialogs": {
          "742500101": {
            "id": "742500101",
            "speakerId": 1000,
            "speakerName": "「木偶」",
            "text": "这么想想，以前你们到至冬时，都没这样好好地招待过你们。",
            "nextDialogs": [
              "742500102"
            ]
          },
          "742500102": {
            "id": "742500102",
            "speakerId": 1001,
            "speakerName": "林尼",
            "text": "请别这么说，桑多涅女士。即便那时没像这样一起坐下来聊天，但您每次都为我们准备了美味的茶点。",
            "nextDialogs": [
              "742500103"
            ]
          },
          "742500103": {
            "id": "742500103",
            "speakerId": 1000,
            "speakerName": "「木偶」",
            "text": "哎，抱歉。以前在那边太忙了，下次你们去的时候会多照顾你们一些的。",
            "nextDialogs": [
              "742500104"
            ]
          },
          "742500104": {
            "id": "742500104",
            "speakerId": 1002,
            "speakerName": "琳妮特",
            "text": "你以前也从不给我玩你发明的机械。",
            "nextDialogs": [
              "742500105"
            ]
          },
          "742500105": {
            "id": "742500105",
            "speakerId": 1000,
            "speakerName": "「木偶」",
            "text": "那是其他原因…",
            "nextDialogs": [
              "742500106"
            ]
          },
          "742500106": {
            "id": "742500106",
            "speakerId": 1002,
            "speakerName": "琳妮特",
            "text": "哼…",
            "nextDialogs": [
              "742500107"
            ]
          },
          "742500107": {
            "id": "742500107",
            "speakerId": 1003,
            "speakerName": "菲米尼",
            "text": "其实「父亲」大人也和我们说过，尽量不要打扰桑多涅小姐。",
            "nextDialogs": [
              "742500108"
            ]
          },
          "742500108": {
            "id": "742500108",
            "speakerId": 1000,
            "speakerName": "「木偶」",
            "text": "没事，我不在意。下次多来我这边喝点下午茶吧。",
            "nextDialogs": [
              "742500109"
            ]
          },
          "742500109": {
            "id": "742500109",
            "speakerId": 1003,
            "speakerName": "菲米尼",
            "text": "真的吗？我其实…一直都想让您帮我看看佩伊…有些改进的方向想向您请教。",
            "nextDialogs": [
              "742500110"
            ]
          },
          "742500110": {
            "id": "742500110",
            "speakerId": 1000,
            "speakerName": "「木偶」",
            "text": "好啊，这可是我的专业领域。",
            "nextDialogs": [
              "742500111"
            ]
          },
          "742500111": {
            "id": "742500111",
            "speakerId": 1003,
            "speakerName": "菲米尼",
            "text": "…谢谢桑多涅女士！",
            "nextDialogs": [
              "742500112"
            ]
          },
          "742500112": {
            "id": "742500112",
            "speakerId": 1002,
            "speakerName": "琳妮特",
            "text": "当「执行官」真的很辛苦吗？",
            "nextDialogs": [
              "742500113"
            ]
          },
          "742500113": {
            "id": "742500113",
            "speakerId": 1000,
            "speakerName": "「木偶」",
            "text": "你要这么问的话…是有点吧。要考虑的事情很多。尽管工作中更多不爽的地方是来源于同事…",
            "nextDialogs": [
              "742500114"
            ]
          },
          "742500114": {
            "id": "742500114",
            "speakerId": 1003,
            "speakerName": "菲米尼",
            "text": "也就是说…与他人的相处很重要？",
            "nextDialogs": [
              "742500115"
            ]
          },
          "742500115": {
            "id": "742500115",
            "speakerId": 1000,
            "speakerName": "「木偶」",
            "text": "算是吧。我看林尼在这方面应该没什么问题。",
            "nextDialogs": [
              "742500116"
            ]
          },
          "742500116": {
            "id": "742500116",
            "speakerId": 1001,
            "speakerName": "林尼",
            "text": "哈哈，不敢不敢，桑多涅女士抬举我了。",
            "nextDialogs": [
              "742500117"
            ]
          },
          "742500117": {
            "id": "742500117",
            "speakerId": 1000,
            "speakerName": "「木偶」",
            "text": "你想成为「执行官」吗？算了，这话题不应该我来问。当我没说。",
            "nextDialogs": [
              "742500118"
            ]
          },
          "742500118": {
            "id": "742500118",
            "speakerId": 1001,
            "speakerName": "林尼",
            "text": "嗯…这话题对我来说还有些远呢。或许以后再想也不迟吧。",
            "nextDialogs": [
              "742500119"
            ]
          },
          "742500119": {
            "id": "742500119",
            "speakerId": 1002,
            "speakerName": "琳妮特",
            "text": "当「执行官」是不是就没时间和我们一起行动了？",
            "nextDialogs": [
              "742500120"
            ]
          },
          "742500120": {
            "id": "742500120",
            "speakerId": 1003,
            "speakerName": "菲米尼",
            "text": "如果是这样的话…难道说…我和琳妮特也必须成为「执行官」？",
            "nextDialogs": [
              "742500121"
            ]
          },
          "742500121": {
            "id": "742500121",
            "speakerId": 1001,
            "speakerName": "林尼",
            "text": "你们两个，说了这是以后考虑的问题啦。",
            "nextDialogs": [
              "742500122"
            ]
          },
          "742500122": {
            "id": "742500122",
            "speakerId": 1001,
            "speakerName": "林尼",
            "text": "而且，不论到哪里，我都不会抛下你们的，这我保证。",
            "nextDialogs": [
              "742500123"
            ]
          },
          "742500123": {
            "id": "742500123",
            "speakerId": 1000,
            "speakerName": "「木偶」",
            "text": "哈…有时真羡慕你们这一家子。"
          }
        }
      }
    },
    {
      "subId": "7425002",
      "subQuestName": "前往布法蒂公馆附近开启茶会",
      "sceneId": null,
      "locations": [],

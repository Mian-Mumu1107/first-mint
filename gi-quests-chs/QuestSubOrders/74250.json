        ],
        "dialogs": {
          "742500201": {
            "id": "742500201",
            "speakerId": 1001,
            "speakerName": "林尼",
            "text": "多谢桑多涅女士的款待。",
            "nextDialogs": [
              "742500202"
            ]
          },
          "742500202": {
            "id": "742500202",
            "speakerId": 1000,
            "speakerName": "「木偶」",
            "text": "（再这么坐一会儿吧。）",
            "nextDialogs": [
              "742500204"
            ]
          },
          "742500204": {
            "id": "742500204",
            "speakerId": 1001,
            "speakerName": "林尼",
            "text": "嗯，您慢走。"
          }
        }
      }
    },

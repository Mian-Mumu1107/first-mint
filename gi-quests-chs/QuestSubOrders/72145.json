  "subQuests": [
    {
      "subId": "7214501",
      "subQuestName": "前往「眼」之所在",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "721450101"
        ],
        "dialogs": {
          "721450101": {
            "id": "721450101",
            "speakerId": 1000,
            "speakerName": "古老的石碑",
            "text": "「…有谕大御神神使目有三瞳，一曰『灵』；一曰『镜』；一曰『实』…」",
            "nextDialogs": [
              "721450102"
            ]
          },
          "721450102": {
            "id": "721450102",
            "speakerId": 1000,
            "speakerName": "古老的石碑",
            "text": "「…自海渊蓁蓁而起，出于<color=#00E1FFFF>南</color>，越于<color=#00E1FFFF>北</color>，盘桓<color=#00E1FFFF>西</color>岗…」",
            "nextDialogs": [
              "721450103"
            ]
          },
          "721450103": {
            "id": "721450103",
            "speakerId": 1000,
            "speakerName": "古老的石碑",
            "text": "「…三瞳灼灼而无所赦，是故龙嗣怪异等莫有敢敌…」",
            "nextDialogs": [
              "721450104"
            ]
          },
          "721450104": {
            "id": "721450104",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "唔…每个字都认得，连起来就完全不知在说什么了呢。",
            "nextDialogs": [
              "721450105"
            ]
          },
          "721450105": {
            "id": "721450105",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "附近看起来也没有线索…不如用<color=#00E1FFFF>「元素视野」</color>试试看吧？"
          }
        }
      }
    },

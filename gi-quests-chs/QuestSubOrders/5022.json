    {
      "subId": "502208",
      "subQuestName": "与派蒙交谈",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "50220801"
        ],
        "dialogs": {
          "50220801": {
            "id": "50220801",
            "speakerId": 1002,
            "speakerName": "派蒙",
            "text": "早上好，昨晚做噩梦了吗？",
            "nextDialogs": [
              "50220802"
            ]
          },
          "50220802": {
            "id": "50220802",
            "speakerId": 1002,
            "speakerName": "派蒙",
            "text": "我听见你的床上一直传来翻滚声，总感觉你睡得不是很好。是不是决战快到了，有点紧张？",
            "nextDialogs": [
              "50220803"
            ]
          },
          "50220803": {
            "id": "50220803",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "（昨天晚上的梦…转眼间记忆已经开始模糊了。）",
            "nextDialogs": [
              "50220804"
            ]
          },
          "50220804": {
            "id": "50220804",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "（梦里的东西就像是隔着一层细纱，看不真切。努力去回忆的时候，脑袋隐隐作痛…）",
            "nextDialogs": [
              "50220805"
            ]
          },
          "50220805": {
            "id": "50220805",
            "speakerId": 1002,
            "speakerName": "派蒙",
            "text": "嘿嘿，今天是我们与玛薇卡约好见面的日子，可要打起精神来哦！"
          }
        }
      }
    },

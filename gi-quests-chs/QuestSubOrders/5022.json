    {
      "subId": "502207",
      "subQuestName": "接近人影的聚集处",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "50220701"
        ],
        "dialogs": {
          "50220701": {
            "id": "50220701",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "（穿过光墙的那一刹那，身体仿佛被冻结了一样。）",
            "nextDialogs": [
              "50220702"
            ]
          },
          "50220702": {
            "id": "50220702",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "（夜神的庇护似乎无法触达这里，冰冷与黑暗钻入五官，耳边全都是疲惫而痛苦的叹息。）",
            "nextDialogs": [
              "50220703"
            ]
          },
          "50220703": {
            "id": "50220703",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "（他们不知道已经走了多久，不知道还要走多久…）",
            "nextDialogs": [
              "50220704"
            ]
          },
          "50220704": {
            "id": "50220704",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "（欸，那个人是…）",
            "nextDialogs": [
              "50220705"
            ]
          },
          "50220705": {
            "id": "50220705",
            "speakerId": 1001,
            "speakerName": "「队长」",
            "text": "故乡迢远，战火肆燃，我等已流尽最后的鲜血。",
            "nextDialogs": [
              "50220706"
            ]
          },
          "50220706": {
            "id": "50220706",
            "speakerId": 1001,
            "speakerName": "「队长」",
            "text": "再等一等，战士们啊…",
            "nextDialogs": [
              "50220707"
            ]
          },
          "50220707": {
            "id": "50220707",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "（为什么「队长」会在这里？他在说什么…）",
            "nextDialogs": [
              "50220708"
            ]
          },
          "50220708": {
            "id": "50220708",
            "speakerId": 1001,
            "speakerName": "「队长」",
            "text": "终有一日，我会将你们带到约定的地方。"
          }
        }
      }
    },

    {
      "subId": "502204",
      "subQuestName": "在梦境中探索",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "50220401"
        ],
        "dialogs": {
          "50220401": {
            "id": "50220401",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "（这里是什么地方？难道说…是夜神之国？）",
            "nextDialogs": [
              "50220402"
            ]
          },
          "50220402": {
            "id": "50220402",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "（我为什么会在这里？刚才我分明是在…呃…）",
            "nextDialogs": [
              "50220403"
            ]
          },
          "50220403": {
            "id": "50220403",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "（头昏沉沉的，没办法正常思考。先到附近走一走吧。）"
          }
        }
      }
    },
    {
      "subId": "502206",
      "subQuestName": "向前探索",
      "sceneId": null,

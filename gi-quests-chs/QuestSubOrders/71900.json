      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "719000101"
        ],
        "dialogs": {
          "719000101": {
            "id": "719000101",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "真正的美食？",
            "nextDialogs": [
              "719000102"
            ]
          },
          "719000102": {
            "id": "719000102",
            "speakerId": 1000,
            "speakerName": "陈八珍",
            "text": "看来，小友也是热衷于寻觅珍馐的食客啊。",
            "nextDialogs": [
              "719000103"
            ]
          },
          "719000103": {
            "id": "719000103",
            "speakerId": 1000,
            "speakerName": "陈八珍",
            "text": "在下陈八珍，不敢说是遗珑埠最好的厨子，但我从没怠慢过食材的本味，只求认真做好每一道菜。",
            "nextDialogs": [
              "719000104"
            ]
          },
          "719000104": {
            "id": "719000104",
            "speakerId": 1000,
            "speakerName": "陈八珍",
            "text": "可惜，如今我已经不怎么掌勺了，倒像是个到处闲逛的挑剔食客。",
            "nextDialogs": [
              "719000105"
            ]
          },
          "719000105": {
            "id": "719000105",
            "speakerId": 1000,
            "speakerName": "陈八珍",
            "text": "每天只是在厨房里忙碌的话，影响力终究是有限的。",
            "nextDialogs": [
              "719000106"
            ]
          },
          "719000106": {
            "id": "719000106",
            "speakerId": 1000,
            "speakerName": "陈八珍",
            "text": "所以前些年，我收了十来个徒弟，将毕生所学传授给他们。",
            "nextDialogs": [
              "719000107"
            ]
          },
          "719000107": {
            "id": "719000107",
            "speakerId": 1000,
            "speakerName": "陈八珍",
            "text": "如今，这些人里已经有几个出师了，比如连芳茶点的店主，九略茶馆的主厨也是我的得意门生。",
            "nextDialogs": [
              "719000108"
            ]
          },
          "719000108": {
            "id": "719000108",
            "speakerId": 1000,
            "speakerName": "陈八珍",
            "text": "小友可以去这些店试试，祝你找到合你口味的菜肴！"
          }
        }
      }
    }
  ]
}
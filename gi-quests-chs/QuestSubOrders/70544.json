  },
  "subQuests": [
    {
      "subId": "7054401",
      "subQuestName": "(test)彩蛋对话4$HIDDEN",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "705440101"
        ],
        "dialogs": {
          "705440101": {
            "id": "705440101",
            "speakerId": 1000,
            "speakerName": "菲谢尔",
            "text": "哦呵呵~既是被冠以「猫茸茸城堡」这般奇巧之名的宝地，陈设如此凡俗，未免有些寒碜了…",
            "nextDialogs": [
              "705440102"
            ]
          },
          "705440102": {
            "id": "705440102",
            "speakerId": 1000,
            "speakerName": "菲谢尔",
            "text": "至少得装设几座…紫玛瑙葡萄藤编织而成的秋千！纯净白银的灯盏上，应当是渊水海盐制成的蜡烛，点亮晚星纹样的猫餐盘！",
            "nextDialogs": [
              "705440103"
            ]
          },
          "705440103": {
            "id": "705440103",
            "speakerId": 1000,
            "speakerName": "菲谢尔",
            "text": "嗯…还有雕像！熔炼失落王朝的古币，以峡湾深底的奇异珍珠和露滴为辅料，打造猫之眷属的雕像，想必是个不错的选择！",
            "nextDialogs": [
              "705440104"
            ]
          },
          "705440104": {
            "id": "705440104",
            "speakerId": 1000,
            "speakerName": "菲谢尔",
            "text": "你也是这么想的，没错吧，这位猫之眷属…",
            "nextDialogs": [
              "705440105"
            ]
          },
          "705440105": {
            "id": "705440105",
            "speakerId": 1000,
            "speakerName": "菲谢尔",
            "text": "呃，你还未报上名号来。好好斟酌措辞吧，让本皇女知晓你的名字，可是无上的荣耀！",
            "nextDialogs": [
              "705440106"
            ]
          },
          "705440106": {
            "id": "705440106",
            "speakerId": 1001,
            "speakerName": "「阿呆」",
            "text": "喵？",
            "nextDialogs": [
              "705440107"
            ]
          },
          "705440107": {
            "id": "705440107",
            "speakerId": 1002,
            "speakerName": "派蒙",
            "text": "它叫「阿呆」哦，尊贵的皇女！",
            "nextDialogs": [
              "705440108"
            ]
          },
          "705440108": {
            "id": "705440108",
            "speakerId": 1002,
            "speakerName": "派蒙",
            "text": "「阿呆」不太懂事，听不懂皇女考究的用词，还请皇女见谅…",
            "nextDialogs": [
              "705440109"
            ]
          },
          "705440109": {
            "id": "705440109",
            "speakerId": 1002,
            "speakerName": "派蒙",
            "text": "不对不对！怎么一见到菲谢尔，我就自动进入那种状态了？",
            "nextDialogs": [
              "705440112"
            ]
          },
          "705440112": {
            "id": "705440112",
            "speakerId": 1000,
            "speakerName": "菲谢尔",
            "text": "果然，不出所料，两位「猫之魔法师」，你们再次被命运的纽带牵引，来到了本皇女的面前…",
            "nextDialogs": [
              "705440113"
            ]
          },
          "705440113": {
            "id": "705440113",
            "speakerId": 1000,
            "speakerName": "菲谢尔",
            "text": "真是令人感慨的重逢啊！",
            "nextDialogs": [
              "705440114"
            ]
          },
          "705440114": {
            "id": "705440114",
            "speakerId": 1002,
            "speakerName": "派蒙",
            "text": "这个称呼…看来菲谢尔已经从瓦乐瑞娜那里听说了我们的事了呢！",
            "nextDialogs": [
              "705440115"
            ]
          },
          "705440115": {
            "id": "705440115",
            "speakerId": 1000,
            "speakerName": "菲谢尔",
            "text": "有你们出谋划策，近来本皇女在幽夜净土深思之时，偶然从过往阅历中寻获的巧念，便能轻松落实了——",
            "nextDialogs": [
              "705440116"
            ]
          },
          "705440116": {
            "id": "705440116",
            "speakerId": 1000,
            "speakerName": "菲谢尔",
            "text": "本皇女打算遴选感官最为敏锐、才思最为聪颖的猫之眷属，与本皇女同行！",
            "nextDialogs": [
              "705440117"
            ]
          },
          "705440117": {
            "id": "705440117",
            "speakerId": 1001,
            "speakerName": "「阿呆」",
            "text": "喵~",
            "nextDialogs": [
              "705440118"
            ]
          },
          "705440118": {
            "id": "705440118",
            "speakerId": 1002,
            "speakerName": "派蒙",
            "text": "原来菲谢尔也有养猫的打算啊，想来倒也挺正常的，大部分人见识过猫猫的可爱后，应该都会想养一只。",
            "nextDialogs": [
              "705440119"
            ]
          },
          "705440119": {
            "id": "705440119",
            "speakerId": 1002,
            "speakerName": "派蒙",
            "text": "不过，菲谢尔不是有奥兹陪着吗？",
            "nextDialogs": [
              "705440120"
            ]
          },
          "705440120": {
            "id": "705440120",
            "speakerId": 1002,
            "speakerName": "派蒙",
            "text": "你们行动的速度本来就很快，猫猫真的能跟上？还是说…要让奥兹载着猫猫飞行？",
            "nextDialogs": [
              "705440121"
            ]
          },
          "705440121": {
            "id": "705440121",
            "speakerId": 1000,
            "speakerName": "菲谢尔",
            "text": "哼哼，本皇女时常跨越三千宇宙，虽说旅途不算漫长，但适当多些伙伴，洞悉易被忽略之物…自然没有坏处！",
            "nextDialogs": [
              "705440122"
            ]
          },
          "705440122": {
            "id": "705440122",
            "speakerId": 1000,
            "speakerName": "菲谢尔",
            "text": "奥兹也很想与猫之眷属玩…咳！想与猫之眷属通力合作，确保本皇女每时每刻的心绪都如霁月光风！",
            "nextDialogs": [
              "705440123"
            ]
          },
          "705440123": {
            "id": "705440123",
            "speakerId": 1000,
            "speakerName": "菲谢尔",
            "text": "可惜，即便奥兹难得展示平易近人的姿态，也难以完全隐去身上的威压，没法接近猫之眷属。",
            "nextDialogs": [
              "705440124"
            ]
          },
          "705440124": {
            "id": "705440124",
            "speakerId": 1000,
            "speakerName": "菲谢尔",
            "text": "距离奥兹不到五步距离时，猫之眷属们的毛发就像是飘散的蓬蓬果，疏忽膨胀开来，随后它们便会陷入惊恐，四散逃开。",
            "nextDialogs": [
              "705440125"
            ]
          },
          "705440125": {
            "id": "705440125",
            "speakerId": 1000,
            "speakerName": "菲谢尔",
            "text": "虔信风神的忠实修女建议奥兹在外休息，言之有理…我默许了。",
            "nextDialogs": [
              "705440126"
            ]
          },
          "705440126": {
            "id": "705440126",
            "speakerId": 1002,
            "speakerName": "派蒙",
            "text": "威压？我好像明白了…",
            "nextDialogs": [
              "705440127"
            ]
          },
          "705440127": {
            "id": "705440127",
            "speakerId": 1002,
            "speakerName": "派蒙",
            "text": "难道说，奥兹身上的雷元素太充沛，一进到「猫茸茸城堡」就会让所有猫猫炸毛。",
            "nextDialogs": [
              "705440128"
            ]
          },
          "705440128": {
            "id": "705440128",
            "speakerId": 1002,
            "speakerName": "派蒙",
            "text": "这样一来，还怎么让猫猫跟着菲谢尔旅行啊…",
            "nextDialogs": [
              "705440129"
            ]
          },
          "705440129": {
            "id": "705440129",
            "speakerId": 1002,
            "speakerName": "派蒙",
            "text": "要是提瓦特存在某种材料…能够隔绝雷元素的影响就好了。",
            "nextDialogs": [
              "705440130"
            ]
          },
          "705440130": {
            "id": "705440130",
            "speakerId": 1002,
            "speakerName": "派蒙",
            "text": "用这种材料给猫猫做衣服，就能让猫猫跟着菲谢尔和奥兹旅行了。",
            "nextDialogs": [
              "705440131"
            ]
          },
          "705440131": {
            "id": "705440131",
            "speakerId": 1001,
            "speakerName": "「阿呆」",
            "text": "喵？"
          }
        }
      }
    }
  ]
}
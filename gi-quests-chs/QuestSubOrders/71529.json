  "subQuests": [
    {
      "subId": "7152901",
      "subQuestName": "(test)斗虫二期-岚姐关卡$HIDDEN",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "716665001"
        ],
        "dialogs": {
          "716665001": {
            "id": "716665001",
            "speakerId": 1000,
            "speakerName": "荒泷一斗",
            "text": "不讲道理…还有这种斗虫的方法？本大爷…本大爷的脸都被打肿了！",
            "nextDialogs": [
              "716665002"
            ]
          },
          "716665002": {
            "id": "716665002",
            "speakerId": 1001,
            "speakerName": "「花里胡哨不如一刀」",
            "text": "受教了，感谢阁下。",
            "nextDialogs": [
              "716665003"
            ]
          },
          "716665003": {
            "id": "716665003",
            "speakerId": 1000,
            "speakerName": "荒泷一斗",
            "text": "居然还这么客气！",
            "nextDialogs": [
              "716665004"
            ]
          },
          "716665004": {
            "id": "716665004",
            "speakerId": 1002,
            "speakerName": "派蒙",
            "text": "嗯哼！放牛{RUBY#[D]「真剑斗虫大鬼王」}的！看来我们暂时不在的这段时间里，你还是输了嘛！",
            "nextDialogs": [
              "716665005"
            ]
          },
          "716665005": {
            "id": "716665005",
            "speakerId": 1001,
            "speakerName": "「花里胡哨不如一刀」",
            "text": "并非如此，只要「真剑斗虫大鬼王」还没有放弃，他就不算输给了我。",
            "nextDialogs": [
              "716665006"
            ]
          },
          "716665006": {
            "id": "716665006",
            "speakerId": 1001,
            "speakerName": "「花里胡哨不如一刀」",
            "text": "不论在战斗还是人生中，暂时落入下风的情况都很常见，只有连自己都放弃了，才算是真正的「败北」。",
            "nextDialogs": [
              "716665007"
            ]
          },
          "716665007": {
            "id": "716665007",
            "speakerId": 1000,
            "speakerName": "荒泷一斗",
            "text": "这…说得好！本大爷确实还没有认输！",
            "nextDialogs": [
              "716665008"
            ]
          },
          "716665008": {
            "id": "716665008",
            "speakerId": 1001,
            "speakerName": "「花里胡哨不如一刀」",
            "text": "但不必找各种各样的借口，花里胡哨的话也可以少说一点，有那个功夫，不如多给对方一刀。",
            "nextDialogs": [
              "716665009"
            ]
          },
          "716665009": {
            "id": "716665009",
            "speakerId": 1000,
            "speakerName": "荒泷一斗",
            "text": "呃…",
            "nextDialogs": [
              "716665010"
            ]
          },
          "716665010": {
            "id": "716665010",
            "speakerId": 1003,
            "speakerName": "「花角玉将」",
            "text": "鬼王，你似乎不擅长对付这类对手，不如换一位大将上阵，仔细观察双方角逐的细节。",
            "nextDialogs": [
              "716665011"
            ]
          },
          "716665011": {
            "id": "716665011",
            "speakerId": 1003,
            "speakerName": "「花角玉将」",
            "text": "修行之中，用心观战也是必不可少的一环，同样能学习到新的技巧。",
            "nextDialogs": [
              "716665012"
            ]
          },
          "716665012": {
            "id": "716665012",
            "speakerId": 1000,
            "speakerName": "荒泷一斗",
            "text": "有道理！正好我的挚友也来了！「鬼王的左膀右臂」，这次就由你出阵吧！",
            "nextDialogs": [
              "716665013"
            ]
          },
          "716665013": {
            "id": "716665013",
            "speakerId": 1002,
            "speakerName": "派蒙",
            "text": "#嘿嘿，终于到{NICKNAME}上场了，你可要好好表现一番!",
            "nextDialogs": [
              "716665016"
            ]
          },
          "716665016": {
            "id": "716665016",
            "speakerId": 1001,
            "speakerName": "「花里胡哨不如一刀」",
            "text": "#传奇冒险家{NICKNAME}居然也要参战吗？那我必须严阵以待了…"
          }
        }
      }
    },
    {

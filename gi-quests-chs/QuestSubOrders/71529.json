    {
      "subId": "7152903",
      "subQuestName": "(test)成功挑战一次岚姐$HIDDEN",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "716665101"
        ],
        "dialogs": {
          "716665101": {
            "id": "716665101",
            "speakerId": 1001,
            "speakerName": "「花里胡哨不如一刀」",
            "text": "漂亮，是我输了。",
            "nextDialogs": [
              "716665102"
            ]
          },
          "716665102": {
            "id": "716665102",
            "speakerId": 1001,
            "speakerName": "「花里胡哨不如一刀」",
            "text": "#输给{NICKNAME}，未尝不是一种光荣。",
            "nextDialogs": [
              "716665103"
            ]
          },
          "716665103": {
            "id": "716665103",
            "speakerId": 1000,
            "speakerName": "荒泷一斗",
            "text": "原来是用这种办法打赢的吗！",
            "nextDialogs": [
              "716665104"
            ]
          },
          "716665104": {
            "id": "716665104",
            "speakerId": 1002,
            "speakerName": "派蒙",
            "text": "没错，面对灵活的敌人，还是要多多变通。",
            "nextDialogs": [
              "716665105"
            ]
          },
          "716665105": {
            "id": "716665105",
            "speakerId": 1002,
            "speakerName": "派蒙",
            "text": "#一种战术行不通的时候，就要换个思路，我和{NICKNAME}在其他地方旅行的时候，常常灵活思考！",
            "nextDialogs": [
              "716665106"
            ]
          },
          "716665106": {
            "id": "716665106",
            "speakerId": 1002,
            "speakerName": "派蒙",
            "text": "只盯着一种方法做事的话，再用力也解决不了问题！",
            "nextDialogs": [
              "716665107"
            ]
          },
          "716665107": {
            "id": "716665107",
            "speakerId": 1000,
            "speakerName": "荒泷一斗",
            "text": "我记得，有时阿忍也说过差不多的话，这样看来还挺有道理的…",
            "nextDialogs": [
              "716665108"
            ]
          },
          "716665108": {
            "id": "716665108",
            "speakerId": 1000,
            "speakerName": "荒泷一斗",
            "text": "不过还是以后再想吧，先考虑眼前的正事，斗虫要紧！"
          }
        }
      }
    }
  ]

    {
      "subId": "7666701",
      "subQuestName": "和莉莉希对话",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "766670301"
        ],
        "dialogs": {
          "766670301": {
            "id": "766670301",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "我去帮你准备一些。",
            "nextDialogs": [
              "766670302"
            ]
          },
          "766670302": {
            "id": "766670302",
            "speakerId": 7058,
            "speakerName": "莉莉希",
            "text": "您、您愿意帮我？太感谢了，太感谢了——那…就请您帮我拿<color=#00E1FFFF>五颗白灵果</color>来吧，这些就够用了！",
            "nextDialogs": [
              "766670303"
            ]
          },
          "766670303": {
            "id": "766670303",
            "speakerId": 7058,
            "speakerName": "莉莉希",
            "text": "等您拿来了之后，我一定会给您做一份最好吃的「飨月餐」！"
          }
        }
      }
    },
    {
      "subId": "7666704",

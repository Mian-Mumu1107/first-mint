      }
    },
    {
      "subId": "7602007",
      "subQuestName": "与伊尔玛里对话",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "760200701"
        ],
        "dialogs": {
          "760200701": {
            "id": "760200701",
            "speakerId": 21924,
            "speakerName": "伊尔玛里",
            "text": "真是怪事…",
            "nextDialogs": [
              "760200702"
            ]
          },
          "760200702": {
            "id": "760200702",
            "speakerId": 21924,
            "speakerName": "伊尔玛里",
            "text": "你们看到了吗？刚才这棵树唰啦一下就亮起来了，还有这些小东西…可惜不是鱼。",
            "nextDialogs": [
              "760200703"
            ]
          },
          "760200703": {
            "id": "760200703",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "这么说来，中间那个东西就是它的根吗？虽然不知道是什么原理，但它现在看起来亮晶晶的，比之前黯淡的样子好看多了。",
            "nextDialogs": [
              "760200704"
            ]
          },
          "760200704": {
            "id": "760200704",
            "speakerId": 1002,
            "speakerName": "Black Screen",
            "text": "讲述了此前的经历…",
            "nextDialogs": [
              "760200705"
            ]
          },
          "760200705": {
            "id": "760200705",
            "speakerId": 21924,
            "speakerName": "伊尔玛里",
            "text": "难以置信…但你们也没必要编些胡话来诓骗我，看来我那只有一半是霜月之子的钓友说的都是真的。",
            "nextDialogs": [
              "760200706"
            ]
          },
          "760200706": {
            "id": "760200706",
            "speakerId": 21924,
            "speakerName": "伊尔玛里",
            "text": "不过那又怎样，只是些过去的残影罢了。管他们唱什么歌，说什么话，也不妨碍我们活人钓活鱼。",
            "nextDialogs": [
              "760200707"
            ]
          },
          "760200707": {
            "id": "760200707",
            "speakerId": 21924,
            "speakerName": "伊尔玛里",
            "text": "话说回来，你们也是宝藏猎人吧。你们刚才捡到的玩意儿…",
            "nextDialogs": [
              "760200708"
            ]
          },
          "760200708": {
            "id": "760200708",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "这个就是<color=#00E1FFFF>「识者之证」</color>了吧？看起来只是普通的鸟羽…",
            "nextDialogs": [
              "760200709"
            ]
          },
          "760200709": {
            "id": "760200709",
            "speakerId": 21924,
            "speakerName": "伊尔玛里",
            "text": "听相熟的游商说，集齐五个<color=#00E1FFFF>「识者之证」</color>，就能找到埋藏在月之东，日之西的什么「伟大财宝」，也不知道是真是假。",
            "nextDialogs": [
              "760200710"
            ]
          },
          "760200710": {
            "id": "760200710",
            "speakerId": 21924,
            "speakerName": "伊尔玛里",
            "text": "反正不少宝藏猎人是真的信了，一个个都趋之若鹜。",
            "nextDialogs": [
              "760200711"
            ]
          },
          "760200711": {
            "id": "760200711",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "毕、毕竟是宝藏嘛！要说的话，我也是很感兴趣的。",
            "nextDialogs": [
              "760200712"
            ]
          },
          "760200712": {
            "id": "760200712",
            "speakerId": 21924,
            "speakerName": "伊尔玛里",
            "text": "要是我再年轻个二十岁…不，就算年轻个二十岁，也还是钓鱼最重要。不过话说回来，今天也是空手而归啊…"
          }
        }
      }
    }
  ]
}
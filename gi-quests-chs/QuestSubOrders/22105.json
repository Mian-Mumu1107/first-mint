  "subQuests": [
    {
      "subId": "2210501",
      "subQuestName": "与菲尔戈黛特对话",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "221050101"
        ],
        "dialogs": {
          "221050101": {
            "id": "221050101",
            "speakerId": 2208,
            "speakerName": "菲尔戈黛特",
            "text": "真烦人…",
            "nextDialogs": [
              "221050102"
            ]
          },
          "221050102": {
            "id": "221050102",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "怎么了？",
            "nextDialogs": [
              "221050103"
            ]
          },
          "221050103": {
            "id": "221050103",
            "speakerId": 2208,
            "speakerName": "菲尔戈黛特",
            "text": "我总感觉这客栈周围怪怪的，又说不出来个所以然。",
            "nextDialogs": [
              "221050104"
            ]
          },
          "221050104": {
            "id": "221050104",
            "speakerId": 2208,
            "speakerName": "菲尔戈黛特",
            "text": "而且我们这客栈里，又都是住着些格外敏感的人…",
            "nextDialogs": [
              "221050105"
            ]
          },
          "221050105": {
            "id": "221050105",
            "speakerId": 2208,
            "speakerName": "菲尔戈黛特",
            "text": "一有什么风吹草动，门窗总会掉几扇，说不定楼板都要破几块。",
            "nextDialogs": [
              "221050106"
            ]
          },
          "221050106": {
            "id": "221050106",
            "speakerId": 2208,
            "speakerName": "菲尔戈黛特",
            "text": "虽然客人们都会自己出钱修，但是这东一块西一块的，太难看了。",
            "nextDialogs": [
              "221050107"
            ]
          },
          "221050107": {
            "id": "221050107",
            "speakerId": 2208,
            "speakerName": "菲尔戈黛特",
            "text": "您能帮我去客栈周围看看吗？有什么怪地方，就…处理一下，我还要在这接待客人。",
            "nextDialogs": [
              "221050110",
              "221050111"
            ]
          },
          "221050110": {
            "id": "221050110",
            "speakerId": 2208,
            "speakerName": "菲尔戈黛特",
            "text": "那就拜托您了。"
          },
          "221050111": {
            "id": "221050111",
            "speakerId": 2208,
            "speakerName": "菲尔戈黛特",
            "text": "客人？哎呀，不用在意，常年在野外摸爬滚打的人，免不了过度敏感。",
            "nextDialogs": [
              "221050112"
            ]
          },
          "221050112": {
            "id": "221050112",
            "speakerId": 2208,
            "speakerName": "菲尔戈黛特",
            "text": "那么就拜托您了，就是去周围看看，应该也不会出什么事。"
          }
        }
      }
    },
    {
      "subId": "2210502",
      "subQuestName": "前往可疑地点查看",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [

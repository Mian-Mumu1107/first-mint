            "speakerId": 2208,
            "speakerName": "菲尔戈黛特",
            "text": "都处理好了吗？",
            "nextDialogs": [
              "221050202"
            ]
          },
          "221050202": {
            "id": "221050202",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "还没有…",
            "nextDialogs": [
              "221050203"
            ]
          },
          "221050203": {
            "id": "221050203",
            "speakerId": 2208,
            "speakerName": "菲尔戈黛特",
            "text": "请您快些吧，不然等入了夜，某些客人就会更加敏感了。"
          }
        }
      }
    },

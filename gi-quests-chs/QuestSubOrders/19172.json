            "speakerId": 1003,
            "speakerName": "娜德瓦",
            "text": "总算能给上头一个交代了，真是多谢你们了。",
            "nextDialogs": [
              "191725102"
            ]
          },
          "191725102": {
            "id": "191725102",
            "speakerId": 1003,
            "speakerName": "娜德瓦",
            "text": "要不然，还真不知道要怎么说动这位老前辈…"
          }
        }
      }
    },
    {
      "subId": "1917252",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "191725201"
        ],
        "dialogs": {
          "191725201": {
            "id": "191725201",
            "speakerId": 1001,
            "speakerName": "阿尼斯",
            "text": "珐露珊前辈，居然真的愿意指导我了？真是太荣幸了！",
            "nextDialogs": [
              "191725202"
            ]
          },
          "191725202": {
            "id": "191725202",
            "speakerId": 1001,
            "speakerName": "阿尼斯",
            "text": "啊，不过她肯定会说，「协助绘制不算指导」…你可不要随便跟她说啊。"
          }
        }
      }
    },
    {
      "subId": "1917253",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "191725301"
        ],
        "dialogs": {
          "191725301": {
            "id": "191725301",
            "speakerId": 1000,
            "speakerName": "马姆杜",
            "text": "不愧是教令院的老前辈，刚见面的时候，我还在想她看着这么年轻，会不会不太靠谱…",
            "nextDialogs": [
              "191725302"
            ]
          },
          "191725302": {
            "id": "191725302",
            "speakerId": 1000,
            "speakerName": "马姆杜",
            "text": "啊，这话可不能让她听见，阿尼斯她嘱咐过我的…"
          }
        }
      }
    },
    {
      "subId": "1917254",
      "subQuestName": "Additional",

            "speakerName": "鲁希",
            "text": "说不定还只是图册呢，想玩到成品，又得等好长一段时间。",
            "nextDialogs": [
              "191725403"
            ]
          },
          "191725403": {
            "id": "191725403",
            "speakerId": 1006,
            "speakerName": "阿利娅",
            "text": "这段时间里，只能先玩玩《七圣召唤》解闷了吧…"
          }
        }

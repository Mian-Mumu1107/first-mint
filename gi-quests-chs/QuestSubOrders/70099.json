  "subQuests": [
    {
      "subId": "7009901",
      "subQuestName": "(test)隐藏$HIDDEN",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "700990101"
        ],
        "dialogs": {
          "700990101": {
            "id": "700990101",
            "speakerId": 10205,
            "speakerName": "？？？",
            "text": "真是好话难劝想死的鬼啊。都说了现在不能上山。",
            "nextDialogs": [
              "700990102"
            ]
          },
          "700990102": {
            "id": "700990102",
            "speakerId": 22313,
            "speakerName": "霍夫曼",
            "text": "哎哎，曼恩大爷，你别这么激动。好好说话，好好说话。",
            "nextDialogs": [
              "700990103"
            ]
          },
          "700990103": {
            "id": "700990103",
            "speakerId": 10205,
            "speakerName": "？？？",
            "text": "之前我和这位大爷在暗夜之酿聊得还好好的呢。",
            "nextDialogs": [
              "700990104"
            ]
          },
          "700990104": {
            "id": "700990104",
            "speakerId": 10205,
            "speakerName": "？？？",
            "text": "他一听说我要去风息山就开始拽着我了，一路拉扯都走到这里来了。",
            "nextDialogs": [
              "700990105"
            ]
          },
          "700990105": {
            "id": "700990105",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "咦，是霍夫曼啊。这里发生什么了吗？",
            "nextDialogs": [
              "700990106"
            ]
          },
          "700990106": {
            "id": "700990106",
            "speakerId": 22313,
            "speakerName": "霍夫曼",
            "text": "如你所见，曼恩大爷正在力劝人们远离风息山呢。",
            "nextDialogs": [
              "700990107"
            ]
          },
          "700990107": {
            "id": "700990107",
            "speakerId": 22313,
            "speakerName": "霍夫曼",
            "text": "介绍一下，这位是冒险家莉普哈特。",
            "nextDialogs": [
              "700990108"
            ]
          },
          "700990108": {
            "id": "700990108",
            "speakerId": 1748,
            "speakerName": "曼恩",
            "text": "我的亲身经历可是很吓人的！你们真的要听吗？",
            "nextDialogs": [
              "700990109"
            ]
          },
          "700990109": {
            "id": "700990109",
            "speakerId": 22312,
            "speakerName": "莉普哈特",
            "text": "好嘛，我感觉今天是走不了了。那听听吧，就当是刚才喝酒吹牛的延续了。",
            "nextDialogs": [
              "700990110"
            ]
          },
          "700990110": {
            "id": "700990110",
            "speakerId": 22312,
            "speakerName": "莉普哈特",
            "text": "我来看看究竟是怎么个危险法。",
            "nextDialogs": [
              "700990111"
            ]
          },
          "700990111": {
            "id": "700990111",
            "speakerId": 1748,
            "speakerName": "曼恩",
            "text": "疗养院里真的有鬼！我亲眼看见的！",
            "nextDialogs": [
              "700990112"
            ]
          },
          "700990112": {
            "id": "700990112",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "哇，鬼！",
            "nextDialogs": [
              "700990113"
            ]
          },
          "700990113": {
            "id": "700990113",
            "speakerId": 1748,
            "speakerName": "曼恩",
            "text": "昨天晚上的事情是这样的…"
          }
        }
      }
    },

{
  "lineCounts": {
    "Player": 5,
    "温克尔": 20
  },
  "subQuests": [
    {
      "subId": "7368401",
      "subQuestName": "与温克尔对话",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "736840101"
        ],
        "dialogs": {
          "736840101": {
            "id": "736840101",
            "speakerId": 30276,
            "speakerName": "温克尔",
            "text": "欸——各位冒险家们，有兴趣的请过来看看，协会正在开展新活动——",
            "nextDialogs": [
              "736840102"
            ]
          },
          "736840102": {
            "id": "736840102",
            "speakerId": 30276,
            "speakerName": "温克尔",
            "text": "只要参与这个活动，不仅能拿到协会发放的奖励，还会有额外的礼品——",
            "nextDialogs": [
              "736840105"
            ]
          },
          "736840105": {
            "id": "736840105",
            "speakerId": 30276,
            "speakerName": "温克尔",
            "text": "你是…旅行者！幸会幸会，哎呀，没想到能遇见前辈！",
            "nextDialogs": [
              "736840106"
            ]
          },
          "736840106": {
            "id": "736840106",
            "speakerId": 30276,
            "speakerName": "温克尔",
            "text": "如您所见，我正在为协会里的一项活动招募参与人员呢。",
            "nextDialogs": [
              "736840107"
            ]
          },
          "736840107": {
            "id": "736840107",
            "speakerId": 30276,
            "speakerName": "温克尔",
            "text": "这是我在协会里的第一项正式工作，我可得打起十二分的精神完成才行。",
            "nextDialogs": [
              "736840108"
            ]
          },
          "736840108": {
            "id": "736840108",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "关于这次活动…",
            "nextDialogs": [
              "736840109"
            ]
          },
          "736840109": {
            "id": "736840109",
            "speakerId": 30276,
            "speakerName": "温克尔",
            "text": "喔…哦！抱歉，前辈肯定还不知道这次活动的情况吧！",
            "nextDialogs": [
              "736840110"
            ]
          },
          "736840110": {
            "id": "736840110",
            "speakerId": 30276,
            "speakerName": "温克尔",
            "text": "这次的活动被杰克前辈取名叫做「跨野寻踪」。",
            "nextDialogs": [
              "736840111"
            ]
          },
          "736840111": {
            "id": "736840111",
            "speakerId": 30276,
            "speakerName": "温克尔",
            "text": "用杰克前辈的话来说，是一场「既简单又有趣，同时还能检验冒险家自身实力」的活动。",
            "nextDialogs": [
              "736840112"
            ]
          },
          "736840112": {
            "id": "736840112",
            "speakerId": 30276,
            "speakerName": "温克尔",
            "text": "具体来说，我们会在各地布设一些「野踪气球」。",
            "nextDialogs": [
              "736840113"
            ]
          },
          "736840113": {
            "id": "736840113",
            "speakerId": 30276,
            "speakerName": "温克尔",
            "text": "参与的冒险家们需要做的，就是根据提示找到「野踪气球」，并且沿着这些气球的分布轨迹前进。",
            "nextDialogs": [
              "736840114"
            ]
          },
          "736840114": {
            "id": "736840114",
            "speakerId": 30276,
            "speakerName": "温克尔",
            "text": "在限定时间内搜集到越多的「野踪气球」，就能获得越高的评价，奖励也会更加丰厚喔。"
          }
        }
      }
    }
  ]
}
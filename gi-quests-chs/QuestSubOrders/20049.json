  "subQuests": [
    {
      "subId": "2004901",
      "subQuestName": "与宁禄对话",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "200490101"
        ],
        "dialogs": {
          "200490101": {
            "id": "200490101",
            "speakerId": 1000,
            "speakerName": "宁禄",
            "text": "好想喝杯酒…",
            "nextDialogs": [
              "200490102"
            ]
          },
          "200490102": {
            "id": "200490102",
            "speakerId": 1000,
            "speakerName": "宁禄",
            "text": "但要是被优律发现我喝了酒，那就全完了。",
            "nextDialogs": [
              "200490103"
            ]
          },
          "200490103": {
            "id": "200490103",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "你怎么了？",
            "nextDialogs": [
              "200490104"
            ]
          },
          "200490104": {
            "id": "200490104",
            "speakerId": 1000,
            "speakerName": "宁禄",
            "text": "嗯？哦…哦，我就是想喝点酒。",
            "nextDialogs": [
              "200490105"
            ]
          },
          "200490105": {
            "id": "200490105",
            "speakerId": 1000,
            "speakerName": "宁禄",
            "text": "我老婆优律最看不得我喝酒了，平时在家里，我几乎滴酒不能沾。",
            "nextDialogs": [
              "200490106"
            ]
          },
          "200490106": {
            "id": "200490106",
            "speakerId": 1000,
            "speakerName": "宁禄",
            "text": "我只能趁她上街买东西的时候，才能偷偷过来安静地喝几杯。",
            "nextDialogs": [
              "200490107"
            ]
          },
          "200490107": {
            "id": "200490107",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "你也太喜欢喝酒了吧…",
            "nextDialogs": [
              "200490108"
            ]
          },
          "200490108": {
            "id": "200490108",
            "speakerId": 1000,
            "speakerName": "宁禄",
            "text": "你这话说的！蒙德人怎么可能不喝酒嘛…",
            "nextDialogs": [
              "200490109"
            ]
          },
          "200490109": {
            "id": "200490109",
            "speakerId": 1000,
            "speakerName": "宁禄",
            "text": "拜托你，去帮我拖住优律一点时间，让我喝个一杯两杯就好。",
            "nextDialogs": [
              "200490110"
            ]
          },
          "200490110": {
            "id": "200490110",
            "speakerId": 1000,
            "speakerName": "宁禄",
            "text": "买东西的时候，只要有很多选择，优律就会一直犹豫，下不了判断。",
            "nextDialogs": [
              "200490111"
            ]
          },
          "200490111": {
            "id": "200490111",
            "speakerId": 1000,
            "speakerName": "宁禄",
            "text": "如果能让她一直有很多选择，她就会一直犹豫下去…",
            "nextDialogs": [
              "200490113",
              "200490115"
            ]
          },
          "200490113": {
            "id": "200490113",
            "speakerId": 1000,
            "speakerName": "宁禄",
            "text": "哈哈哈，那就拜托你了，祝你酒运昌隆。"
          },
          "200490115": {
            "id": "200490115",
            "speakerId": 1000,
            "speakerName": "宁禄",
            "text": "哈哈哈，那就要看你能够拖多…",
            "nextDialogs": [
              "200490116"
            ]
          },
          "200490116": {
            "id": "200490116",
            "speakerId": 1000,
            "speakerName": "宁禄",
            "text": "不，不是，我只要能安静地喝一杯就好！",
            "nextDialogs": [
              "200490117"
            ]
          },
          "200490117": {
            "id": "200490117",
            "speakerId": 1000,
            "speakerName": "宁禄",
            "text": "这是一位蒙德酒客的承诺，拜托你了！"
          }
        }
      }
    },
    {
      "subId": "2004902",
      "subQuestName": "找到优律小姐",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "200490201"
        ],
        "dialogs": {
          "200490201": {
            "id": "200490201",
            "speakerId": 1001,
            "speakerName": "优律",
            "text": "日落果，苹果…到底买哪个比较好呢？",
            "nextDialogs": [
              "200490202"
            ]
          },
          "200490202": {
            "id": "200490202",
            "speakerId": 1001,
            "speakerName": "优律",
            "text": "唉，要是宁禄在这的话，直接买他喜欢的就好了…",
            "nextDialogs": [
              "200490203"
            ]
          },
          "200490203": {
            "id": "200490203",
            "speakerId": 1002,
            "speakerName": "昆恩",
            "text": "抱歉，优律小姐，日落果已经卖光了。",
            "nextDialogs": [
              "200490204"
            ]
          },
          "200490204": {
            "id": "200490204",
            "speakerId": 1001,
            "speakerName": "优律",
            "text": "是这样吗？哎呀，那就只能买苹果了。",
            "nextDialogs": [
              "200490205"
            ]
          },
          "200490205": {
            "id": "200490205",
            "speakerId": 1002,
            "speakerName": "昆恩",
            "text": "呃，优律小姐，这些苹果很不新鲜了…",
            "nextDialogs": [
              "200490206"
            ]
          },
          "200490206": {
            "id": "200490206",
            "speakerId": 1001,
            "speakerName": "优律",
            "text": "咦？是这样吗，但是我也没别的能选了…",
            "nextDialogs": [
              "200490207"
            ]
          },
          "200490207": {
            "id": "200490207",
            "speakerId": 1003,
            "speakerName": "派蒙",
            "text": "我们来帮忙！",
            "nextDialogs": [
              "200490208"
            ]
          },
          "200490208": {
            "id": "200490208",
            "speakerId": 1002,
            "speakerName": "昆恩",
            "text": "咦？你们…",
            "nextDialogs": [
              "200490209"
            ]
          },
          "200490209": {
            "id": "200490209",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "就交给我们。",
            "nextDialogs": [
              "200490210"
            ]
          },
          "200490210": {
            "id": "200490210",
            "speakerId": 1003,
            "speakerName": "派蒙",
            "text": "放心吧，我们会去找新鲜的<color=#00E1FFFF>日落果</color>回来。",
            "nextDialogs": [
              "200490211"
            ]
          },
          "200490211": {
            "id": "200490211",
            "speakerId": 1002,
            "speakerName": "昆恩",
            "text": "是，是这样吗？那就拜托了…",
            "nextDialogs": [
              "200490212"
            ]
          },
          "200490212": {
            "id": "200490212",
            "speakerId": 1001,
            "speakerName": "优律",
            "text": "那太好了，宁禄也更喜欢吃日落果一些，那我在这先等着吧。"
          }
        }
      }
    },
    {
      "subId": "2004903",
      "subQuestName": "找到日落果",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "200490301"
        ],
        "dialogs": {
          "200490301": {
            "id": "200490301",
            "speakerId": 1002,
            "speakerName": "昆恩",
            "text": "日落果就麻烦你们了，贝雅特丽奇这家伙，刚好把最后几个买走了…"
          }
        }
      }
    },
    {
      "subId": "2004904",
      "subQuestName": "交付日落果",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "200490601"
        ],
        "dialogs": {
          "200490601": {
            "id": "200490601",
            "speakerId": 1002,
            "speakerName": "昆恩",
            "text": "找到日落果了吗？",
            "nextDialogs": [
              "200490602"
            ]
          },
          "200490602": {
            "id": "200490602",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "这些够了吗？",
            "nextDialogs": [
              "200490603"
            ]
          },
          "200490603": {
            "id": "200490603",
            "speakerId": 1002,
            "speakerName": "昆恩",
            "text": "够了够了！帮大忙了，谢谢你。",
            "nextDialogs": [
              "200490604"
            ]
          },
          "200490604": {
            "id": "200490604",
            "speakerId": 1001,
            "speakerName": "优律",
            "text": "这些日落果看着真不错！",
            "nextDialogs": [
              "200490605"
            ]
          },
          "200490605": {
            "id": "200490605",
            "speakerId": 1001,
            "speakerName": "优律",
            "text": "哎呀，不过买苹果也很划算，我要不要都买了呢…"
          }
        }
      }
    },
    {
      "subId": "2004905",
      "subQuestName": "向宁禄回报",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "200490801"
        ],
        "dialogs": {
          "200490801": {
            "id": "200490801",
            "speakerId": 1000,
            "speakerName": "宁禄",
            "text": "你，你们回来了？优律…她怎么说？",
            "nextDialogs": [
              "200490802"
            ]
          },
          "200490802": {
            "id": "200490802",
            "speakerId": 1003,
            "speakerName": "派蒙",
            "text": "呜哇，好大的酒气，他不是说只喝一杯的吗？",
            "nextDialogs": [
              "200490803"
            ]
          },
          "200490803": {
            "id": "200490803",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "优律小姐正在犹豫呢。",
            "nextDialogs": [
              "200490804"
            ]
          },
          "200490804": {
            "id": "200490804",
            "speakerId": 1000,
            "speakerName": "宁禄",
            "text": "好…好！这样子我就能接着安心喝酒了！",
            "nextDialogs": [
              "200490805"
            ]
          },
          "200490805": {
            "id": "200490805",
            "speakerId": 1003,
            "speakerName": "派蒙",
            "text": "喂！你不是说只喝一杯吗？",
            "nextDialogs": [
              "200490806"
            ]
          },
          "200490806": {
            "id": "200490806",
            "speakerId": 1000,
            "speakerName": "宁禄",
            "text": "嘿嘿，是啊，我喝的一杯，是「下一杯」…",
            "nextDialogs": [
              "200490807"
            ]
          },
          "200490807": {
            "id": "200490807",
            "speakerId": 1000,
            "speakerName": "宁禄",
            "text": "多谢你们了，这些给你们，就当做谢礼吧。",
            "nextDialogs": [
              "200490808"
            ]
          },
          "200490808": {
            "id": "200490808",
            "speakerId": 1000,
            "speakerName": "宁禄",
            "text": "我要接着喝酒了，美酒时光得来不易啊——"
          }
        }
      }
    },
    {
      "subId": "2004904",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "200490401"
        ],
        "dialogs": {
          "200490401": {
            "id": "200490401",
            "speakerId": 1001,
            "speakerName": "优律",
            "text": "真是谢谢您，我的丈夫最近为我戒了酒，一直很不开心…",
            "nextDialogs": [
              "200490402"
            ]
          },
          "200490402": {
            "id": "200490402",
            "speakerId": 1001,
            "speakerName": "优律",
            "text": "如果能吃到喜欢的水果，他也许会高兴一些吧。",
            "nextDialogs": [
              "200490403"
            ]
          },
          "200490403": {
            "id": "200490403",
            "speakerId": 1001,
            "speakerName": "优律",
            "text": "不过…好像买苹果会更划得来一些…"
          }
        }
      }
    },
    {
      "subId": "2004905",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "200490501"
        ],
        "dialogs": {
          "200490501": {
            "id": "200490501",
            "speakerId": 1003,
            "speakerName": "派蒙",
            "text": "#{NICKNAME}，我们快去找日落果回来吧。",
            "nextDialogs": [
              "200490502"
            ]
          },
          "200490502": {
            "id": "200490502",
            "speakerId": 1003,
            "speakerName": "派蒙",
            "text": "这样子，优律小姐一定会接着犹豫不决。",
            "nextDialogs": [
              "200490503"
            ]
          },
          "200490503": {
            "id": "200490503",
            "speakerId": 1003,
            "speakerName": "派蒙",
            "text": "不过，宁禄先生可真是了解她呀…"
          }
        }
      }
    },
    {
      "subId": "2004907",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "200490701"
        ],
        "dialogs": {
          "200490701": {
            "id": "200490701",
            "speakerId": 1003,
            "speakerName": "派蒙",
            "text": "这下子，优律小姐肯定又会犹豫很久了吧…",
            "nextDialogs": [
              "200490702"
            ]
          },
          "200490702": {
            "id": "200490702",
            "speakerId": 1003,
            "speakerName": "派蒙",
            "text": "我们回去告诉宁禄先生吧。"
          }
        }
      }
    }
  ]
}
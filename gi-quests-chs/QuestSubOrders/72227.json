    {
      "subId": "7222702",
      "subQuestName": "(test)记录栖木供奉$HIDDEN",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "722270201"
        ],
        "dialogs": {
          "722270201": {
            "id": "722270201",
            "speakerId": 1000,
            "speakerName": "阿瑠",
            "text": "#我要快点长大，然后变成像{NICKNAME}{PLAYERAVATAR#SEXPRO[INFO_MALE_PRONOUN_BROTHER|INFO_FEMALE_PRONOUN_SISTERA]}一样的冒险家！"
          }
        }
      }
    },
    {
      "subId": "7222703",
      "subQuestName": "(test)cs树叶生长$HIDDEN",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "722270301"
        ],
        "dialogs": {
          "722270301": {
            "id": "722270301",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "这座栖木也好了呢！",
            "nextDialogs": [
              "722270302"
            ]
          },
          "722270302": {
            "id": "722270302",
            "speakerId": 1000,
            "speakerName": "阿瑠",
            "text": "太厉害了！这就是真正的冒险家吗？",
            "nextDialogs": [
              "722270303"
            ]
          },
          "722270303": {
            "id": "722270303",
            "speakerId": 1000,
            "speakerName": "阿瑠",
            "text": "唔…之前也有别人来过这里。",
            "nextDialogs": [
              "722270304"
            ]
          },
          "722270304": {
            "id": "722270304",
            "speakerId": 1000,
            "speakerName": "阿瑠",
            "text": "#但是，都不如{NICKNAME}{PLAYERAVATAR#SEXPRO[INFO_MALE_PRONOUN_BROTHER|INFO_FEMALE_PRONOUN_SISTERA]}和派蒙这么厉害！",
            "nextDialogs": [
              "722270305"
            ]
          },
          "722270305": {
            "id": "722270305",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "别人？",
            "nextDialogs": [
              "722270306"
            ]
          },
          "722270306": {
            "id": "722270306",
            "speakerId": 1000,
            "speakerName": "阿瑠",
            "text": "嗯，他们是来找木簧笛的。",
            "nextDialogs": [
              "722270309"
            ]
          },
          "722270309": {
            "id": "722270309",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "不过，木簧笛到底是什么呀？虽然之前听说是鹤观人的乐器…",
            "nextDialogs": [
              "722270310"
            ]
          },
          "722270310": {
            "id": "722270310",
            "speakerId": 1000,
            "speakerName": "阿瑠",
            "text": "嗯~的确是一种能发出声音的装置哦。",
            "nextDialogs": [
              "722270311"
            ]
          },
          "722270311": {
            "id": "722270311",
            "speakerId": 1000,
            "speakerName": "阿瑠",
            "text": "因为雾海，我们这不是很难看清楚东西吗？所以大家就会用木簧笛来传达自己的位置。",
            "nextDialogs": [
              "722270312"
            ]
          },
          "722270312": {
            "id": "722270312",
            "speakerId": 1000,
            "speakerName": "阿瑠",
            "text": "毕竟靠喊的太吵啦！而且对嗓子不好。",
            "nextDialogs": [
              "722270313"
            ]
          },
          "722270313": {
            "id": "722270313",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "确实什么都看不见呢…",
            "nextDialogs": [
              "722270314"
            ]
          },
          "722270314": {
            "id": "722270314",
            "speakerId": 1000,
            "speakerName": "阿瑠",
            "text": "对吧？",
            "nextDialogs": [
              "722270315"
            ]
          },
          "722270315": {
            "id": "722270315",
            "speakerId": 1000,
            "speakerName": "阿瑠",
            "text": "爸…又爷爷还说，木簧笛的声音可以让迷失在雾里的灵魂找到回家的路。所以是很重要的东西。",
            "nextDialogs": [
              "722270316"
            ]
          },
          "722270316": {
            "id": "722270316",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "嗯？原来这么重要吗？",
            "nextDialogs": [
              "722270317"
            ]
          },
          "722270317": {
            "id": "722270317",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "难怪祭典会需要。",
            "nextDialogs": [
              "722270318"
            ]
          },
          "722270318": {
            "id": "722270318",
            "speakerId": 1000,
            "speakerName": "阿瑠",
            "text": "#嗯，祭典一定能让{NICKNAME}{PLAYERAVATAR#SEXPRO[INFO_MALE_PRONOUN_BROTHER|INFO_FEMALE_PRONOUN_SISTERA]}和派蒙开心的！",
            "nextDialogs": [
              "722270319"
            ]
          },
          "722270319": {
            "id": "722270319",
            "speakerId": 1000,
            "speakerName": "阿瑠",
            "text": "你们先走吧！我还想在树下待一会儿。",
            "nextDialogs": [
              "722270320"
            ]
          },
          "722270320": {
            "id": "722270320",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "没问题吗？外面可能有魔物…",
            "nextDialogs": [
              "722270321"
            ]
          },
          "722270321": {
            "id": "722270321",
            "speakerId": 1000,
            "speakerName": "阿瑠",
            "text": "没问题的哦。"
          }
        }
      }
    },

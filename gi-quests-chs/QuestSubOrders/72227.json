    },
    {
      "subId": "7222701",
      "subQuestName": "(test)阿瑠说话$HIDDEN",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "722270101"
        ],
        "dialogs": {
          "722270101": {
            "id": "722270101",
            "speakerId": 1000,
            "speakerName": "阿瑠",
            "text": "#{NICKNAME}{PLAYERAVATAR#SEXPRO[INFO_MALE_PRONOUN_BROTHER|INFO_FEMALE_PRONOUN_SISTERA]}战斗的样子，好帅气！",
            "nextDialogs": [
              "722270102"
            ]
          },
          "722270102": {
            "id": "722270102",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "原来阿瑠在这里啊！",
            "nextDialogs": [
              "722270105"
            ]
          },
          "722270105": {
            "id": "722270105",
            "speakerId": 1000,
            "speakerName": "阿瑠",
            "text": "我没事喔！",
            "nextDialogs": [
              "722270106"
            ]
          },
          "722270106": {
            "id": "722270106",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "那些魔物…",
            "nextDialogs": [
              "722270108"
            ]
          },
          "722270108": {
            "id": "722270108",
            "speakerId": 1000,
            "speakerName": "阿瑠",
            "text": "不知道这些怪物是什么地方来的。",
            "nextDialogs": [
              "722270109"
            ]
          },
          "722270109": {
            "id": "722270109",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "的确，看起来不像是这里的生物呢…",
            "nextDialogs": [
              "722270110"
            ]
          },
          "722270110": {
            "id": "722270110",
            "speakerId": 1000,
            "speakerName": "阿瑠",
            "text": "嗯。以前，我们这里是没有这些东西的，也没有那些身上很多毛的人和大机器人。",
            "nextDialogs": [
              "722270111"
            ]
          },
          "722270111": {
            "id": "722270111",
            "speakerId": 1000,
            "speakerName": "阿瑠",
            "text": "以前，我们这里有一种叫「鹈猿兽」的动物。但是它很温顺，而且也很好吃。",
            "nextDialogs": [
              "722270112"
            ]
          },
          "722270112": {
            "id": "722270112",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "没听说过。",
            "nextDialogs": [
              "722270113"
            ]
          },
          "722270113": {
            "id": "722270113",
            "speakerId": 1000,
            "speakerName": "阿瑠",
            "text": "我想也是呢。在我们这里，从什么时候开始，鹈猿兽都消失了，这些家伙却出现了。",
            "nextDialogs": [
              "722270114"
            ]
          },
          "722270114": {
            "id": "722270114",
            "speakerId": 1000,
            "speakerName": "阿瑠",
            "text": "不知道是不是从「雾海」外面来的呢…",
            "nextDialogs": [
              "722270115"
            ]
          },
          "722270115": {
            "id": "722270115",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "外面也有丘丘人之类的魔物。",
            "nextDialogs": [
              "722270116"
            ]
          },
          "722270116": {
            "id": "722270116",
            "speakerId": 1000,
            "speakerName": "阿瑠",
            "text": "听起来好危险…"
          }
        }
      }
    },

{
  "lineCounts": {
    "Black Screen": 1,
    "Player": 5,
    "加尔恰": 9,
    "路通": 14,
    "阿汉格尔": 7
  },
  "subQuests": [
    {
      "subId": "2301501",
      "subQuestName": "与阿汉格尔对话",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "230150101"
        ],
        "dialogs": {
          "230150101": {
            "id": "230150101",
            "speakerId": 1000,
            "speakerName": "加尔恰",
            "text": "这一根轴承的尺寸太大了，没法和其他轴承适配…",
            "nextDialogs": [
              "230150102"
            ]
          },
          "230150102": {
            "id": "230150102",
            "speakerId": 1001,
            "speakerName": "阿汉格尔",
            "text": "上一根太小，这一根太大，我的铁块都要被你用光了！",
            "nextDialogs": [
              "230150103"
            ]
          },
          "230150103": {
            "id": "230150103",
            "speakerId": 1002,
            "speakerName": "路通",
            "text": "事实上，我们的钱也快不够了。",
            "nextDialogs": [
              "230150104"
            ]
          },
          "230150104": {
            "id": "230150104",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "你们在吵什么呢？",
            "nextDialogs": [
              "230150105"
            ]
          },
          "230150105": {
            "id": "230150105",
            "speakerId": 1001,
            "speakerName": "阿汉格尔",
            "text": "这个人，要我给他打造很多铁管和齿轮，而且每个铁管和齿轮还有不同的要求。",
            "nextDialogs": [
              "230150106"
            ]
          },
          "230150106": {
            "id": "230150106",
            "speakerId": 1001,
            "speakerName": "阿汉格尔",
            "text": "为了给他打造这些东西，我已经要把铁块都用完了！",
            "nextDialogs": [
              "230150107"
            ]
          },
          "230150107": {
            "id": "230150107",
            "speakerId": 1001,
            "speakerName": "阿汉格尔",
            "text": "但他还说不够用，还要更多的齿轮。",
            "nextDialogs": [
              "230150108"
            ]
          },
          "230150108": {
            "id": "230150108",
            "speakerId": 1000,
            "speakerName": "加尔恰",
            "text": "请您再听我解释一下我的工作，您听完之后，肯定能理解我…",
            "nextDialogs": [
              "230150109"
            ]
          },
          "230150109": {
            "id": "230150109",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "这是在折腾什么？",
            "nextDialogs": [
              "230150110"
            ]
          },
          "230150110": {
            "id": "230150110",
            "speakerId": 1002,
            "speakerName": "路通",
            "text": "就让加尔恰先生给阿汉格尔先生讲解去吧。",
            "nextDialogs": [
              "230150111"
            ]
          },
          "230150111": {
            "id": "230150111",
            "speakerId": 1002,
            "speakerName": "路通",
            "text": "旅行者，我…呃，加尔恰先生想请您帮忙去搜集一些铁块，请问您愿意吗？",
            "nextDialogs": [
              "230150114"
            ]
          },
          "230150114": {
            "id": "230150114",
            "speakerId": 1002,
            "speakerName": "路通",
            "text": "在制造机器这件事上…我们遇见了一些早已预料到的阻碍，加尔恰先生目前正在思索如何突破这个阻碍。",
            "nextDialogs": [
              "230150115"
            ]
          },
          "230150115": {
            "id": "230150115",
            "speakerId": 1002,
            "speakerName": "路通",
            "text": "如果以后您有兴趣，就请自己去问问加尔恰先生吧。",
            "nextDialogs": [
              "230150116"
            ]
          },
          "230150116": {
            "id": "230150116",
            "speakerId": 1002,
            "speakerName": "路通",
            "text": "我想…除了他自己，谁也无法解释清楚那台机器的原理。",
            "nextDialogs": [
              "230150117"
            ]
          },
          "230150117": {
            "id": "230150117",
            "speakerId": 1002,
            "speakerName": "路通",
            "text": "但在那之前，请您先拿些铁块回来吧。"
          }
        }
      }
    },
    {
      "subId": "2301502",
      "subQuestName": "将三份铁块带给路通",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "230150201"
        ],
        "dialogs": {
          "230150201": {
            "id": "230150201",
            "speakerId": 1002,
            "speakerName": "路通",
            "text": "您拿到铁块了吗？"
          }
        }
      }
    },
    {
      "subId": "2301503",
      "subQuestName": "与阿汉格尔对话",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "230150301"
        ],
        "dialogs": {
          "230150301": {
            "id": "230150301",
            "speakerId": 1001,
            "speakerName": "阿汉格尔",
            "text": "好了！好了！不要再说了，我要接着给你做齿轮去了！",
            "nextDialogs": [
              "230150302"
            ]
          },
          "230150302": {
            "id": "230150302",
            "speakerId": 1000,
            "speakerName": "加尔恰",
            "text": "但我还没有完全讲清楚我的机器…",
            "nextDialogs": [
              "230150303"
            ]
          },
          "230150303": {
            "id": "230150303",
            "speakerId": 1001,
            "speakerName": "阿汉格尔",
            "text": "铁块已经有了吧，那我马上就开工了，你离远点！",
            "nextDialogs": [
              "230150304"
            ]
          },
          "230150304": {
            "id": "230150304",
            "speakerId": 1003,
            "speakerName": "Black Screen",
            "text": "阿汉格尔猛烈挥舞着铁锤，加尔恰不得不躲到了一边…",
            "nextDialogs": [
              "230150305"
            ]
          },
          "230150305": {
            "id": "230150305",
            "speakerId": 1002,
            "speakerName": "路通",
            "text": "就让阿汉格尔先生继续工作吧，这是您的报酬，请您拿好。",
            "nextDialogs": [
              "230150306"
            ]
          },
          "230150306": {
            "id": "230150306",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "希望你们能成功。",
            "nextDialogs": [
              "230150307"
            ]
          },
          "230150307": {
            "id": "230150307",
            "speakerId": 1002,
            "speakerName": "路通",
            "text": "我对您的祝福表示感谢，旅行者。",
            "nextDialogs": [
              "230150308"
            ]
          },
          "230150308": {
            "id": "230150308",
            "speakerId": 1002,
            "speakerName": "路通",
            "text": "我对这件事…则谨慎地抱着悲观态度。",
            "nextDialogs": [
              "230150309"
            ]
          },
          "230150309": {
            "id": "230150309",
            "speakerId": 1002,
            "speakerName": "路通",
            "text": "加尔恰先生是一个机械方面的天才，这一点不容置疑。",
            "nextDialogs": [
              "230150310"
            ]
          },
          "230150310": {
            "id": "230150310",
            "speakerId": 1002,
            "speakerName": "路通",
            "text": "但我认为，对于加尔恰先生所想完成的那台机器而言…他仅仅是一个「天才」，也许还远远不够…"
          }
        }
      }
    },
    {
      "subId": "2301550",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "230155001"
        ],
        "dialogs": {
          "230155001": {
            "id": "230155001",
            "speakerId": 1001,
            "speakerName": "阿汉格尔",
            "text": "你要那么多齿轮和管子做什么？是想要搭个铁皮屋子吗？",
            "nextDialogs": [
              "230155002"
            ]
          },
          "230155002": {
            "id": "230155002",
            "speakerId": 1000,
            "speakerName": "加尔恰",
            "text": "没错，先生！我就是要搭一个屋子，一个塞满了齿轮的屋子。",
            "nextDialogs": [
              "230155003"
            ]
          },
          "230155003": {
            "id": "230155003",
            "speakerId": 1000,
            "speakerName": "加尔恰",
            "text": "我把容纳一部分齿轮的地方称为「容室」，而轴承和另外一部分齿轮，则会组成「算库」。",
            "nextDialogs": [
              "230155004"
            ]
          },
          "230155004": {
            "id": "230155004",
            "speakerId": 1000,
            "speakerName": "加尔恰",
            "text": "「容室」里的齿轮用来存储和记录数字，而「算库」里的齿轮则用来计算它们。",
            "nextDialogs": [
              "230155005"
            ]
          },
          "230155005": {
            "id": "230155005",
            "speakerId": 1000,
            "speakerName": "加尔恰",
            "text": "我画张图您就能理解了，有纸吗？没有？没关系，我在衣服上画，这样比较容易看清…",
            "nextDialogs": [
              "230155006"
            ]
          },
          "230155006": {
            "id": "230155006",
            "speakerId": 1000,
            "speakerName": "加尔恰",
            "text": "能把那块炭给我吗？非常感谢，您瞧这里…"
          }
        }
      }
    },
    {
      "subId": "2301599",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "230159901"
        ],
        "dialogs": {
          "230159901": {
            "id": "230159901",
            "speakerId": 1000,
            "speakerName": "加尔恰",
            "text": "（必须解决这个问题！但是…不不不…没有但是…）",
            "nextDialogs": [
              "230159902"
            ]
          },
          "230159902": {
            "id": "230159902",
            "speakerId": 1002,
            "speakerName": "路通",
            "text": "（唔，无论如何，车到山前必有路嘛…）"
          }
        }
      }
    }
  ]
}
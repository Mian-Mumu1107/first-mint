    {
      "subId": "7329499",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "732949901"
        ],
        "dialogs": {
          "732949901": {
            "id": "732949901",
            "speakerId": 1000,
            "speakerName": "于连",
            "text": "话说回来，两位又是为什么到这里来？应该…应该不会是和我一样吧…",
            "nextDialogs": [
              "732949902"
            ]
          },
          "732949902": {
            "id": "732949902",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "和你一样…你是说为了画画专程到这里来吗？那当然不是啦。",
            "nextDialogs": [
              "732949903"
            ]
          },
          "732949903": {
            "id": "732949903",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "#{NICKNAME}可是在册的冒险家呢，出现在提瓦特的任何角落都不奇怪！",
            "nextDialogs": [
              "732949906"
            ]
          },
          "732949906": {
            "id": "732949906",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "是画板！肯定也是于连的，和其他东西一起带回去吧。我猜茶已经好了！快点快点！"
          }
        }
      }
    }
  ]
}
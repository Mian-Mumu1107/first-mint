    {
      "subId": "7329410",
      "subQuestName": "调查沙滩上的狗",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "732941001"
        ],
        "dialogs": {
          "732941001": {
            "id": "732941001",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "奇怪，这种地方怎么会有狗？而且像是看守着什么…",
            "nextDialogs": [
              "732941002"
            ]
          },
          "732941002": {
            "id": "732941002",
            "speakerId": 1003,
            "speakerName": "狗",
            "text": "（警戒地看着你。）",
            "nextDialogs": [
              "732941004",
              "732941006"
            ]
          },
          "732941004": {
            "id": "732941004",
            "speakerId": 1003,
            "speakerName": "狗",
            "text": "（短吠了一声。）",
            "nextDialogs": [
              "732941007"
            ]
          },
          "732941007": {
            "id": "732941007",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "对了，之前不是在于连的营地看到过食盆吗？该不会是它的吧！奇怪，为什么于连说自己没有动物同伴呢…",
            "nextDialogs": [
              "732941008"
            ]
          },
          "732941008": {
            "id": "732941008",
            "speakerId": 1003,
            "speakerName": "狗",
            "text": "呜…",
            "nextDialogs": [
              "732941009"
            ]
          },
          "732941009": {
            "id": "732941009",
            "speakerId": 1002,
            "speakerName": "Black Screen",
            "text": "狗往营地的方向跑去了…",
            "nextDialogs": [
              "732941010"
            ]
          },
          "732941010": {
            "id": "732941010",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "它跑掉了…我们待会儿问问于连吧。不过现在…不知道这个沙堆下埋了什么，我们检查看看？"
          },
          "732941006": {
            "id": "732941006",
            "speakerId": 1003,
            "speakerName": "狗",
            "text": "（发出狺狺的低吼。）"
          }
        }
      }
    },
    {
      "subId": "7329411",
      "subQuestName": "调查沙堆",
      "sceneId": null,
      "locations": [],

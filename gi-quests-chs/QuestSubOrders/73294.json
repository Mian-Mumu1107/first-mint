  "subQuests": [
    {
      "subId": "7329401",
      "subQuestName": "与倒在地上的人对话$HIDDEN",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "732940101"
        ],
        "dialogs": {
          "732940101": {
            "id": "732940101",
            "speakerId": 1000,
            "speakerName": "于连",
            "text": "唔唔…",
            "nextDialogs": [
              "732940102"
            ]
          },
          "732940102": {
            "id": "732940102",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "#他看起来不怎么好的样子…肯定是饿坏了！{NICKNAME}，要不要分给他一些食物？",
            "nextDialogs": [
              "732940104",
              "732940106"
            ]
          },
          "732940104": {
            "id": "732940104",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "#可不是因为我偏心才这么说，{NICKNAME}做的料理是真的很美味！",
            "nextDialogs": [
              "732940107"
            ]
          },
          "732940107": {
            "id": "732940107",
            "speakerId": 1002,
            "speakerName": "Black Screen",
            "text": "让倒地者吃下了提瓦特煎蛋。",
            "nextDialogs": [
              "732940108"
            ]
          },
          "732940108": {
            "id": "732940108",
            "speakerId": 1000,
            "speakerName": "于连",
            "text": "重！重获新生啦！",
            "nextDialogs": [
              "732940109"
            ]
          },
          "732940109": {
            "id": "732940109",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "哇…看来他是真的饿得不行了，只是一个煎蛋而已嘛…",
            "nextDialogs": [
              "732940110"
            ]
          },
          "732940110": {
            "id": "732940110",
            "speakerId": 1000,
            "speakerName": "于连",
            "text": "真是让人复活的美味呀…唉，早知道煎蛋这样美味，就该从那个家伙手里买下那枚神奇鸟蛋。",
            "nextDialogs": [
              "732940111"
            ]
          },
          "732940111": {
            "id": "732940111",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "什么神奇鸟蛋？",
            "nextDialogs": [
              "732940112"
            ]
          },
          "732940112": {
            "id": "732940112",
            "speakerId": 1000,
            "speakerName": "于连",
            "text": "据说只要吃下它就能抵消掉一天的厄运，要是当时就买下那枚神奇鸟蛋…不，要是能买十二枚…",
            "nextDialogs": [
              "732940113"
            ]
          },
          "732940113": {
            "id": "732940113",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "唔…听起来好可疑，像是什么骗人的买卖。不过，你怎么一个人到这种地方来呀？",
            "nextDialogs": [
              "732940114"
            ]
          },
          "732940114": {
            "id": "732940114",
            "speakerId": 1000,
            "speakerName": "于连",
            "text": "我是…呃…我是来须弥采风的枫丹知名画家。你们可以叫我于连。"
          },
          "732940106": {
            "id": "732940106",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "什么嘛！不管是谁，总会有那么一两次因为饿昏而两眼一黑倒在地上的经历吧？"
          }
        }
      }
    },
    {
      "subId": "7329404",
      "subQuestName": "跟随于连前往营地",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "732940401"
        ],
        "dialogs": {
          "732940401": {
            "id": "732940401",
            "speakerId": 1000,
            "speakerName": "于连",
            "text": "行李就拜托两位了…"
          }
        }
      }
    },
    {
      "subId": "7329405",
      "subQuestName": "与于连对话",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "732940501"
        ],
        "dialogs": {
          "732940501": {
            "id": "732940501",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "好简陋的营地！这还能算是营地吗…",
            "nextDialogs": [
              "732940502"
            ]
          },
          "732940502": {
            "id": "732940502",
            "speakerId": 1000,
            "speakerName": "于连",
            "text": "可是这里风景还不错，走到沙滩边会感觉很开阔，比在枫丹的时候舒畅很多。",
            "nextDialogs": [
              "732940503"
            ]
          },
          "732940503": {
            "id": "732940503",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "你在枫丹究竟过着怎样的生活啊…和想象中的知名画家会过的生活很不一样呢。",
            "nextDialogs": [
              "732940504"
            ]
          },
          "732940504": {
            "id": "732940504",
            "speakerId": 1000,
            "speakerName": "于连",
            "text": "其实我在枫丹的住处很小，呃，因为我不是个贪图虚名的人。",
            "nextDialogs": [
              "732940505"
            ]
          },
          "732940505": {
            "id": "732940505",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "野外的冒险家营地都比这里豪华多了呢。欸？这是…你的动物同伴呢？",
            "nextDialogs": [
              "732940506"
            ]
          },
          "732940506": {
            "id": "732940506",
            "speakerId": 1000,
            "speakerName": "于连",
            "text": "呃…我可没有什么动物同伴，这大概是之前来这里的冒险家之类的留下的吧。话说回来…",
            "nextDialogs": [
              "732940507"
            ]
          },
          "732940507": {
            "id": "732940507",
            "speakerId": 1000,
            "speakerName": "于连",
            "text": "我是很想拿出点好东西招待和报答两位的，但是不巧大部分行李都在筏子散架的时候掉进水里了，我又不会游泳…",
            "nextDialogs": [
              "732940508"
            ]
          },
          "732940508": {
            "id": "732940508",
            "speakerId": 1000,
            "speakerName": "于连",
            "text": "如果两位能帮我把遗失在水上的行李找回来…",
            "nextDialogs": [
              "732940509"
            ]
          },
          "732940509": {
            "id": "732940509",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "都泡水了这行李还能要吗…",
            "nextDialogs": [
              "732940510"
            ]
          },
          "732940510": {
            "id": "732940510",
            "speakerId": 1000,
            "speakerName": "于连",
            "text": "我姑且都小心打包好了，但是里边有些东西…唉，没了就没了吧，没关系，我还能再画…还能…再画…",
            "nextDialogs": [
              "732940511"
            ]
          },
          "732940511": {
            "id": "732940511",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "#唔…感觉有点可怜…{NICKNAME}，我们就帮帮他吧！",
            "nextDialogs": [
              "732940512"
            ]
          },
          "732940512": {
            "id": "732940512",
            "speakerId": 1000,
            "speakerName": "于连",
            "text": "在这种地方实在无人可以依靠了…只能拜托两位，我在这儿泡好茶等你们。"
          }
        }
      }
    },

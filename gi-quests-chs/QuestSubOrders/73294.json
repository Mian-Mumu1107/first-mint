        "dialogs": {}
      }
    },
    {
      "subId": "7329412",
      "subQuestName": "前往营地，与于连对话",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "732941201"
        ],
        "dialogs": {
          "732941201": {
            "id": "732941201",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "我们回来啦…哦！果然是于连的动物同伴！",
            "nextDialogs": [
              "732941202"
            ]
          },
          "732941202": {
            "id": "732941202",
            "speakerId": 1003,
            "speakerName": "狗",
            "text": "（发出威胁的声音。）",
            "nextDialogs": [
              "732941203"
            ]
          },
          "732941203": {
            "id": "732941203",
            "speakerId": 1000,
            "speakerName": "于连",
            "text": "…好哇，「胡椒」你这家伙…还吼我，你也不想想是谁在养这个家！",
            "nextDialogs": [
              "732941204"
            ]
          },
          "732941204": {
            "id": "732941204",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "（原来它也有名字啊！不过这人没事吧？怎么在跟狗吵架…）",
            "nextDialogs": [
              "732941206",
              "732941208"
            ]
          },
          "732941206": {
            "id": "732941206",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "（这样能算是感情好吗？）",
            "nextDialogs": [
              "732941244"
            ]
          },
          "732941244": {
            "id": "732941244",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "那个…于连！你丢的东西我们都找回来了，话说「胡椒」应该就是你的动物同伴吧？为什么刚才骗我们说没有呢？",
            "nextDialogs": [
              "732941209"
            ]
          },
          "732941209": {
            "id": "732941209",
            "speakerId": 1000,
            "speakerName": "于连",
            "text": "跟这种恩将仇报的家伙？我宁可跟兽境猎犬当同伴。",
            "nextDialogs": [
              "732941210"
            ]
          },
          "732941210": {
            "id": "732941210",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "那你们可能当不了多久同伴…",
            "nextDialogs": [
              "732941211"
            ]
          },
          "732941211": {
            "id": "732941211",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "对呀，像于连这样光是肚饿都会昏倒的普通人，遇到兽境猎犬就不是一个提瓦特煎蛋能解决的问题了。",
            "nextDialogs": [
              "732941212"
            ]
          },
          "732941212": {
            "id": "732941212",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "说起来，它刚才在沙滩边上好像守着画板呢。"
          },
          "732941208": {
            "id": "732941208",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "（难道他平时就这样吗？唔…想想都觉得麻烦。）"
          }
        }
      }
    },

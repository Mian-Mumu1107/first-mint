        "dialogs": {
          "705270101": {
            "id": "705270101",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "你们好呀！是在聊什么好吃的吗？",
            "nextDialogs": [
              "705270107",
              "705270104"
            ]
          },
          "705270107": {
            "id": "705270107",
            "speakerId": 1001,
            "speakerName": "莎拉",
            "text": "又见面了，二位。确实我们聊的也算是和吃的有关系吧，不过…唉…",
            "nextDialogs": [
              "705270108"
            ]
          },
          "705270108": {
            "id": "705270108",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "发生什么事情了呀，快说吧，说不定我们能帮上忙呢？",
            "nextDialogs": [
              "705270109"
            ]
          },
          "705270109": {
            "id": "705270109",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "#既然事关好吃的，那我们一定不会袖手旁观的！嘿嘿，对吧，{NICKNAME}？"
          },
          "705270104": {
            "id": "705270104",
            "speakerId": 1002,
            "speakerName": "娜扎法琳",
            "text": "噢，您好，我的小吉祥草王啊。大人您不记得我了吗？",
            "nextDialogs": [
              "705270105"
            ]
          },
          "705270105": {
            "id": "705270105",
            "speakerId": 1002,
            "speakerName": "娜扎法琳",
            "text": "可能我的存在感，就像是一粒沙尘，风一吹就消散了…",
            "nextDialogs": [
              "705270106"
            ]
          },
          "705270106": {
            "id": "705270106",
            "speakerId": 1002,
            "speakerName": "娜扎法琳",
            "text": "不过二位大人之前在璃月，帮忙制作调料，又邀请大家试吃，大恩大德，我一直铭记于心呢！"
          }
        }
      }
    },
    {

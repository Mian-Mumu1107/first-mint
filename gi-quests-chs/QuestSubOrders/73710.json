        ],
        "dialogs": {
          "737100101": {
            "id": "737100101",
            "speakerId": 30969,
            "speakerName": "咚咚小圆帽",
            "text": "♪~♪♪~♪~",
            "nextDialogs": [
              "737100102"
            ]
          },
          "737100102": {
            "id": "737100102",
            "speakerId": 30430,
            "speakerName": "欢腾之火",
            "text": "♫♫~♫~♫♫~",
            "nextDialogs": [
              "737100103"
            ]
          },
          "737100103": {
            "id": "737100103",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "我们回来啦，海妮耶，左右加！",
            "nextDialogs": [
              "737100104"
            ]
          },
          "737100104": {
            "id": "737100104",
            "speakerId": 30981,
            "speakerName": "海妮耶",
            "text": "远远就听见「咚咚小圆帽」和「欢腾之火」欢乐的脚步声，看来你们这次确实玩了个痛快。",
            "nextDialogs": [
              "737100105"
            ]
          },
          "737100105": {
            "id": "737100105",
            "speakerId": 12859,
            "speakerName": "左右加",
            "text": "这么远就能听出欢乐吗？我到现在都没法辨别蕈兽伙伴脚步声里传达的情绪…",
            "nextDialogs": [
              "737100106"
            ]
          },
          "737100106": {
            "id": "737100106",
            "speakerId": 12859,
            "speakerName": "左右加",
            "text": "看来我还是得多学啊…学无止境！",
            "nextDialogs": [
              "737100107"
            ]
          },
          "737100107": {
            "id": "737100107",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "欸嘿嘿，这次出游的感觉，确实很不一样！",
            "nextDialogs": [
              "737100108"
            ]
          },
          "737100108": {
            "id": "737100108",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "带着蕈兽伙伴们玩了一圈，再回到「小小灵蕈乐园」附近，感觉和玩累了回家吃饭有点像。",
            "nextDialogs": [
              "737100109"
            ]
          },
          "737100109": {
            "id": "737100109",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "不如，现在就一起合张影吧？我看《蒸汽鸟报》提到的许多知名游记，都把旅途的各种画片按时间连起来呢。",
            "nextDialogs": [
              "737100110"
            ]
          },
          "737100110": {
            "id": "737100110",
            "speakerId": 30981,
            "speakerName": "海妮耶",
            "text": "「白银伴星」这么一说，我才想起，这些年来和蕈兽伙伴们相处得理所当然，没怎么合过影…",
            "nextDialogs": [
              "737100111"
            ]
          },
          "737100111": {
            "id": "737100111",
            "speakerId": 12859,
            "speakerName": "左右加",
            "text": "嗯！两位大老板都很懂「完美收场」的仪式嘛！",
            "nextDialogs": [
              "737100112"
            ]
          },
          "737100112": {
            "id": "737100112",
            "speakerId": 30969,
            "speakerName": "咚咚小圆帽",
            "text": "♪♪~",
            "nextDialogs": [
              "737100113"
            ]
          },
          "737100113": {
            "id": "737100113",
            "speakerId": 30430,
            "speakerName": "欢腾之火",
            "text": "♫♫~",
            "nextDialogs": [
              "737100114"
            ]
          },
          "737100114": {
            "id": "737100114",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "好哦，那就用「咚咚小圆帽」的这个相机，加上支架，来张定时合照！",
            "nextDialogs": [
              "737100115"
            ]
          },
          "737100115": {
            "id": "737100115",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "等到海妮耶和左右加不那么忙了，我们还要一起，像这样开心地出去玩！",
            "nextDialogs": [
              "737100147"
            ]
          },
          "737100147": {
            "id": "737100147",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "好耶！",
            "nextDialogs": [
              "737100116"
            ]
          },
          "737100116": {
            "id": "737100116",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "说起来，「咚咚小圆帽」拍照的天赋很厉害哦！",
            "nextDialogs": [
              "737100117"
            ]
          },
          "737100117": {
            "id": "737100117",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "我挑了几张拍得不错的，就和我们的合照放在一起，海妮耶和左右加也可以看看！",
            "nextDialogs": [
              "737100120"
            ]
          },
          "737100120": {
            "id": "737100120",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "还有还有…来，海妮耶和左右加，我给你们带了纪念品——",
            "nextDialogs": [
              "737100121"
            ]
          },
          "737100121": {
            "id": "737100121",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "是你们之前没吃到的马卡龙！",
            "nextDialogs": [
              "737100122"
            ]
          },
          "737100122": {
            "id": "737100122",
            "speakerId": 12859,
            "speakerName": "左右加",
            "text": "咦！我只是随口一说，你居然记住了吗？",
            "nextDialogs": [
              "737100123"
            ]
          },
          "737100123": {
            "id": "737100123",
            "speakerId": 30981,
            "speakerName": "海妮耶",
            "text": "「白银伴星」…令人感动…",
            "nextDialogs": [
              "737100124"
            ]
          },
          "737100124": {
            "id": "737100124",
            "speakerId": 30981,
            "speakerName": "海妮耶",
            "text": "为了以后不再这么麻烦你，我必须改掉毛病，出游前做好万全的规划…并且不能停留在纸面上。",
            "nextDialogs": [
              "737100125"
            ]
          },
          "737100125": {
            "id": "737100125",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "好朋友放松闲聊时候，随口说的事情，也能反映心里的真实想法嘛！"
          }
        }
      }
    },

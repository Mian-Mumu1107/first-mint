  "subQuests": [
    {
      "subId": "1504201",
      "subQuestName": "前往浪浪湾",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "150420101"
        ],
        "dialogs": {
          "150420101": {
            "id": "150420101",
            "speakerId": 1087,
            "speakerName": "玛拉妮",
            "text": "呜呼——！！",
            "nextDialogs": [
              "150420102"
            ]
          },
          "150420102": {
            "id": "150420102",
            "speakerId": 1087,
            "speakerName": "玛拉妮",
            "text": "阳光！海浪！鳍游龙！",
            "nextDialogs": [
              "150420103"
            ]
          },
          "150420103": {
            "id": "150420103",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "她激动得好像忘了自己的古名是「沃摩{RUBY#[S]团结}延」…",
            "nextDialogs": [
              "150420104"
            ]
          },
          "150420104": {
            "id": "150420104",
            "speakerId": 1087,
            "speakerName": "玛拉妮",
            "text": "快来呀，这边这边！哎呀，快一点嘛，用跑的！",
            "nextDialogs": [
              "150420105"
            ]
          },
          "150420105": {
            "id": "150420105",
            "speakerId": 1024,
            "speakerName": "班尼特",
            "text": "我们来了！",
            "nextDialogs": [
              "150420106"
            ]
          },
          "150420106": {
            "id": "150420106",
            "speakerId": 1087,
            "speakerName": "玛拉妮",
            "text": "看！这是什么？",
            "nextDialogs": [
              "150420107"
            ]
          },
          "150420107": {
            "id": "150420107",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "木板。",
            "nextDialogs": [
              "150420108"
            ]
          },
          "150420108": {
            "id": "150420108",
            "speakerId": 1087,
            "speakerName": "玛拉妮",
            "text": "看字！",
            "nextDialogs": [
              "150420109"
            ]
          },
          "150420109": {
            "id": "150420109",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "噢噢噢是游览地图啊。",
            "nextDialogs": [
              "150420110"
            ]
          },
          "150420110": {
            "id": "150420110",
            "speakerId": 1087,
            "speakerName": "玛拉妮",
            "text": "游览地图！其价值不亚于锁着巨大宝库的钥匙…",
            "nextDialogs": [
              "150420111"
            ]
          },
          "150420111": {
            "id": "150420111",
            "speakerId": 1024,
            "speakerName": "班尼特",
            "text": "我明白，都象征着冒险的开始！",
            "nextDialogs": [
              "150420112"
            ]
          },
          "150420112": {
            "id": "150420112",
            "speakerId": 1087,
            "speakerName": "玛拉妮",
            "text": "或者也能比喻成熊熊燃烧的燃素种？",
            "nextDialogs": [
              "150420113"
            ]
          },
          "150420113": {
            "id": "150420113",
            "speakerId": 1024,
            "speakerName": "班尼特",
            "text": "燃素？呃…好像是一种能量对吧？你是想说…只要看一眼就会有…源源不断的动力？",
            "nextDialogs": [
              "150420114"
            ]
          },
          "150420114": {
            "id": "150420114",
            "speakerId": 1087,
            "speakerName": "玛拉妮",
            "text": "没错！而且它也很重要。",
            "nextDialogs": [
              "150420115"
            ]
          },
          "150420115": {
            "id": "150420115",
            "speakerId": 1087,
            "speakerName": "玛拉妮",
            "text": "拥有地图，时刻按需查看，每个人都能走出属于自己的自由冒险之路！",
            "nextDialogs": [
              "150420116"
            ]
          },
          "150420116": {
            "id": "150420116",
            "speakerId": 1024,
            "speakerName": "班尼特",
            "text": "哇噢，自由！冒险！",
            "nextDialogs": [
              "150420117"
            ]
          },
          "150420117": {
            "id": "150420117",
            "speakerId": 21855,
            "speakerName": "阿夏",
            "text": "♪",
            "nextDialogs": [
              "150420118"
            ]
          },
          "150420118": {
            "id": "150420118",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "等等…别急着附和。我怎么听着玛拉妮话里有话…",
            "nextDialogs": [
              "150420119"
            ]
          },
          "150420119": {
            "id": "150420119",
            "speakerId": 1087,
            "speakerName": "玛拉妮",
            "text": "现在，解散！",
            "nextDialogs": [
              "150420120"
            ]
          },
          "150420120": {
            "id": "150420120",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "哪有你这种一到景点就原地解散的向导啊！",
            "nextDialogs": [
              "150420123"
            ]
          },
          "150420123": {
            "id": "150420123",
            "speakerId": 1087,
            "speakerName": "玛拉妮",
            "text": "不愧是我的好伙伴，我会把你帮我说话这件事记在心上的！",
            "nextDialogs": [
              "150420124"
            ]
          },
          "150420124": {
            "id": "150420124",
            "speakerId": 1087,
            "speakerName": "玛拉妮",
            "text": "大家仔细看，这两个大型游乐项目旁都写着「待测试」的字样，估计是遇到了什么麻烦。",
            "nextDialogs": [
              "150420125"
            ]
          },
          "150420125": {
            "id": "150420125",
            "speakerId": 1087,
            "speakerName": "玛拉妮",
            "text": "我们不如分头去找自己感兴趣的项目，一边体验，一边帮忙测试，说不定还能让浪浪湾尽早投入运营。",
            "nextDialogs": [
              "150420126"
            ]
          },
          "150420126": {
            "id": "150420126",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "我还以为一接触到你心爱的水上项目，就不管我们了，原来你还是挺热心的嘛…",
            "nextDialogs": [
              "150420127"
            ]
          },
          "150420127": {
            "id": "150420127",
            "speakerId": 1087,
            "speakerName": "玛拉妮",
            "text": "嘿嘿，最后大家就在那个巨大的鳍游龙建筑附近集合吧？",
            "nextDialogs": [
              "150420128"
            ]
          },
          "150420128": {
            "id": "150420128",
            "speakerId": 1087,
            "speakerName": "玛拉妮",
            "text": "凭我多年向导经验，区域主要挑战的入口，肯定在那附近！",
            "nextDialogs": [
              "150420129"
            ]
          },
          "150420129": {
            "id": "150420129",
            "speakerId": 1092,
            "speakerName": "恰斯卡",
            "text": "行。",
            "nextDialogs": [
              "150420130"
            ]
          },
          "150420130": {
            "id": "150420130",
            "speakerId": 1087,
            "speakerName": "玛拉妮",
            "text": "那就解散啦，记得多看地图哦！"
          }
        }
      }
    },
    {
      "subId": "1504204",

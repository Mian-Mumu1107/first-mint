    {
      "subId": "1504217",
      "subQuestName": "与众人对话",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "150421701"
        ],
        "dialogs": {
          "150421701": {
            "id": "150421701",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "辛苦啦，玛拉妮！",
            "nextDialogs": [
              "150421702"
            ]
          },
          "150421702": {
            "id": "150421702",
            "speakerId": 1087,
            "speakerName": "玛拉妮",
            "text": "呼，这回总算玩爽啦…怎么样？各位，我做得很棒吧！",
            "nextDialogs": [
              "150421703"
            ]
          },
          "150421703": {
            "id": "150421703",
            "speakerId": 1024,
            "speakerName": "班尼特",
            "text": "太漂亮了，不愧是纳塔的六英杰！",
            "nextDialogs": [
              "150421704"
            ]
          },
          "150421704": {
            "id": "150421704",
            "speakerId": 1024,
            "speakerName": "班尼特",
            "text": "在冲浪板滑出去之后，派蒙和我说起了你的事迹，听得我叹为观止！全身都像燃烧起来一样激动！",
            "nextDialogs": [
              "150421705"
            ]
          },
          "150421705": {
            "id": "150421705",
            "speakerId": 1087,
            "speakerName": "玛拉妮",
            "text": "哈哈，谢谢，听你夸的，我都想原地加开一场温泉派对了！",
            "nextDialogs": [
              "150421706"
            ]
          },
          "150421706": {
            "id": "150421706",
            "speakerId": 1087,
            "speakerName": "玛拉妮",
            "text": "哇！你们看，浪浪湾工作人员都来了！努力了那么久，大家肯定都在等着音乐、派对和犒劳呢！",
            "nextDialogs": [
              "150421707"
            ]
          },
          "150421707": {
            "id": "150421707",
            "speakerId": 1092,
            "speakerName": "恰斯卡",
            "text": "我觉得你理解错了。",
            "nextDialogs": [
              "150421708"
            ]
          },
          "150421708": {
            "id": "150421708",
            "speakerId": 1087,
            "speakerName": "玛拉妮",
            "text": "哪里错了？",
            "nextDialogs": [
              "150421709"
            ]
          },
          "150421709": {
            "id": "150421709",
            "speakerId": 6551,
            "speakerName": "图西娜",
            "text": "英雄玛拉妮小姐，能不能请您为我签个名？",
            "nextDialogs": [
              "150421710"
            ]
          },
          "150421710": {
            "id": "150421710",
            "speakerId": 21871,
            "speakerName": "高恩",
            "text": "我也想要！",
            "nextDialogs": [
              "150421711"
            ]
          },
          "150421711": {
            "id": "150421711",
            "speakerId": 21949,
            "speakerName": "幼暝视龙",
            "text": "！",
            "nextDialogs": [
              "150421712"
            ]
          },
          "150421712": {
            "id": "150421712",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "明星已经藏不住了。",
            "nextDialogs": [
              "150421713"
            ]
          },
          "150421713": {
            "id": "150421713",
            "speakerId": 1087,
            "speakerName": "玛拉妮",
            "text": "快快，趁现在其他人还没拥上来，我们抓紧时间把合照拍了！",
            "nextDialogs": [
              "150421714"
            ]
          },
          "150421714": {
            "id": "150421714",
            "speakerId": 1087,
            "speakerName": "玛拉妮",
            "text": "要明亮的笑容，自信的表情！想想旁边的海景，还有自己的幸运色…",
            "nextDialogs": [
              "150421715"
            ]
          },
          "150421715": {
            "id": "150421715",
            "speakerId": 1087,
            "speakerName": "玛拉妮",
            "text": "三、二、一——",
            "nextDialogs": [
              "150421716"
            ]
          },
          "150421716": {
            "id": "150421716",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "鳍游龙！",
            "nextDialogs": [
              "150421717"
            ]
          },
          "150421717": {
            "id": "150421717",
            "speakerId": 10205,
            "speakerName": "？？？",
            "text": "……"
          }
        }
      }

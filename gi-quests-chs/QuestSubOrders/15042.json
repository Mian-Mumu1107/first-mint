    {
      "subId": "1504213",
      "subQuestName": "看看同伴们游玩的项目",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "150421301"
        ],
        "dialogs": {
          "150421301": {
            "id": "150421301",
            "speakerId": 1092,
            "speakerName": "恰斯卡",
            "text": "哟，眼神不错，我站在这么高的地方居然都被你发现了。",
            "nextDialogs": [
              "150421302"
            ]
          },
          "150421302": {
            "id": "150421302",
            "speakerId": 1092,
            "speakerName": "恰斯卡",
            "text": "看样子，你也对这里的设施感兴趣？",
            "nextDialogs": [
              "150421304",
              "150421306"
            ]
          },
          "150421304": {
            "id": "150421304",
            "speakerId": 1092,
            "speakerName": "恰斯卡",
            "text": "我觉得挺不错。但好玩与否是个主观的判断，我说了也不算，你得亲自上手试试。",
            "nextDialogs": [
              "150421307"
            ]
          },
          "150421307": {
            "id": "150421307",
            "speakerId": 1092,
            "speakerName": "恰斯卡",
            "text": "看到那条轨道了吗？",
            "nextDialogs": [
              "150421308"
            ]
          },
          "150421308": {
            "id": "150421308",
            "speakerId": 1092,
            "speakerName": "恰斯卡",
            "text": "用颜料子弹给轨道上的球体染色吧。只要涂上相同的颜色，那些球就会被「消除」了。",
            "nextDialogs": [
              "150421309"
            ]
          },
          "150421309": {
            "id": "150421309",
            "speakerId": 1092,
            "speakerName": "恰斯卡",
            "text": "至于是如何「消除」的…呵呵，也许另一个人也端着枪，等着把那些球打飞呢。"
          },
          "150421306": {
            "id": "150421306",
            "speakerId": 1092,
            "speakerName": "恰斯卡",
            "text": "放轻松，这里可是悠悠度假村，是与「复杂」、「困难」这些词汇距离最远的地方。"
          }
        }
      }
    },
    {
      "subId": "1504214",
      "subQuestName": "准备集合",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "150421401"
        ],
        "dialogs": {
          "150421401": {
            "id": "150421401",
            "speakerId": 1092,
            "speakerName": "恰斯卡",
            "text": "现在感觉如何？",
            "nextDialogs": [
              "150421403",
              "150421405",
              "150421407"
            ]
          },
          "150421403": {
            "id": "150421403",
            "speakerId": 1092,
            "speakerName": "恰斯卡",
            "text": "口气还挺大，不过我看你确实表现得很好。",
            "nextDialogs": [
              "150421408"
            ]
          },
          "150421408": {
            "id": "150421408",
            "speakerId": 1092,
            "speakerName": "恰斯卡",
            "text": "说不定我也可以跟工作人员提提建议，让他们日后做些改进。",
            "nextDialogs": [
              "150421409"
            ]
          },
          "150421409": {
            "id": "150421409",
            "speakerId": 1092,
            "speakerName": "恰斯卡",
            "text": "再怎么说…至少也该让两位选手一决高下吧。"
          },
          "150421405": {
            "id": "150421405",
            "speakerId": 1092,
            "speakerName": "恰斯卡",
            "text": "哈哈，保持专注的确是一件需要耗费体力的事。"
          },
          "150421407": {
            "id": "150421407",
            "speakerId": 1092,
            "speakerName": "恰斯卡",
            "text": "是吗？看来我们做出了相同的判断。"
          }
        }
      }
    },
    {
      "subId": "1504215",
      "subQuestName": "前往鳍游龙建筑附近集合",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "150421501"
        ],
        "dialogs": {
          "150421501": {
            "id": "150421501",
            "speakerId": 1087,
            "speakerName": "玛拉妮",
            "text": "很好，清点人数…一二三四…",
            "nextDialogs": [
              "150421502"
            ]
          },
          "150421502": {
            "id": "150421502",
            "speakerId": 1087,
            "speakerName": "玛拉妮",
            "text": "还多了一个？",
            "nextDialogs": [
              "150421503"
            ]
          },
          "150421503": {
            "id": "150421503",
            "speakerId": 6551,
            "speakerName": "图西娜",
            "text": "各位是想要参与浪浪湾的主要挑战项目吗？但我们这边出了些状况…",
            "nextDialogs": [
              "150421504"
            ]
          },
          "150421504": {
            "id": "150421504",
            "speakerId": 6551,
            "speakerName": "图西娜",
            "text": "如果需要完成纪念册任务，在景点拍摄合照的话，我现在可以直接帮大家拍摄…",
            "nextDialogs": [
              "150421505"
            ]
          },
          "150421505": {
            "id": "150421505",
            "speakerId": 1087,
            "speakerName": "玛拉妮",
            "text": "不…这不对吧！",
            "nextDialogs": [
              "150421506"
            ]
          },
          "150421506": {
            "id": "150421506",
            "speakerId": 1087,
            "speakerName": "玛拉妮",
            "text": "画片不过是留念的手段，以后翻看时还能回想起温暖的片段…但我们在意的还是整个游玩的体验啦！",
            "nextDialogs": [
              "150421507"
            ]
          },
          "150421507": {
            "id": "150421507",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "你忘说画片可以兑奖的事了…好吧，但我也赞同，拍一张就走太敷衍了。",
            "nextDialogs": [
              "150421508"
            ]
          },
          "150421508": {
            "id": "150421508",
            "speakerId": 6551,
            "speakerName": "图西娜",
            "text": "我明白了，真是抱歉…那可能需要大家保持耐心等待了，我们会尽快解决的…",
            "nextDialogs": [
              "150421509"
            ]
          },
          "150421509": {
            "id": "150421509",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "要等多久呢？",
            "nextDialogs": [
              "150421510"
            ]
          },
          "150421510": {
            "id": "150421510",
            "speakerId": 6551,
            "speakerName": "图西娜",
            "text": "这个不太好说…",
            "nextDialogs": [
              "150421511"
            ]
          },
          "150421511": {
            "id": "150421511",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "欸？不太好说？",
            "nextDialogs": [
              "150421512"
            ]
          },
          "150421512": {
            "id": "150421512",
            "speakerId": 1087,
            "speakerName": "玛拉妮",
            "text": "有我们来帮忙呢？",
            "nextDialogs": [
              "150421513"
            ]
          },
          "150421513": {
            "id": "150421513",
            "speakerId": 6551,
            "speakerName": "图西娜",
            "text": "这个…",
            "nextDialogs": [
              "150421514"
            ]
          },
          "150421514": {
            "id": "150421514",
            "speakerId": 1092,
            "speakerName": "恰斯卡",
            "text": "我看浪浪湾其他项目工作人员很少，龙员工的状态明显有些疲惫…",
            "nextDialogs": [
              "150421515"
            ]
          },
          "150421515": {
            "id": "150421515",
            "speakerId": 1092,
            "speakerName": "恰斯卡",
            "text": "恐怕就是因为「主要挑战项目」遇到了难关，所有人手都被临时调度过来，共同参与起了修复工作？",
            "nextDialogs": [
              "150421516"
            ]
          },
          "150421516": {
            "id": "150421516",
            "speakerId": 1092,
            "speakerName": "恰斯卡",
            "text": "别紧张，我理解有不便透露的内部情况，并不是要为难你的意思。",
            "nextDialogs": [
              "150421517"
            ]
          },
          "150421517": {
            "id": "150421517",
            "speakerId": 1092,
            "speakerName": "恰斯卡",
            "text": "相反，我的同伴个个身手不凡，而且助人为乐，就在不久前完成了「暝导游船」和「阿夏快跑」两场测试。",
            "nextDialogs": [
              "150421518"
            ]
          },
          "150421518": {
            "id": "150421518",
            "speakerId": 1092,
            "speakerName": "恰斯卡",
            "text": "要是你愿意把难题和我们分享，事态就很有可能得到更快解决。",
            "nextDialogs": [
              "150421519"
            ]
          },
          "150421519": {
            "id": "150421519",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "哇，她说话有进有退的，这就是平日里深藏不露的「调停人」实力吗？",
            "nextDialogs": [
              "150421520"
            ]
          },
          "150421520": {
            "id": "150421520",
            "speakerId": 1087,
            "speakerName": "玛拉妮",
            "text": "恰斯卡，提醒我一下，你是怎么观察的来着？你不会暗中坐在树梢上偷看我们吧？",
            "nextDialogs": [
              "150421521"
            ]
          },
          "150421521": {
            "id": "150421521",
            "speakerId": 1092,
            "speakerName": "恰斯卡",
            "text": "这是重点吗？",
            "nextDialogs": [
              "150421522"
            ]
          },
          "150421522": {
            "id": "150421522",
            "speakerId": 1024,
            "speakerName": "班尼特",
            "text": "噢，重点是…我们真的很擅长支援和协助！有问题当然要大家一起出力！",
            "nextDialogs": [
              "150421523"
            ]
          },
          "150421523": {
            "id": "150421523",
            "speakerId": 6551,
            "speakerName": "图西娜",
            "text": "没想到这位客人连龙的状态都能说得那么准确…不好意思，是我不该隐瞒各位。",
            "nextDialogs": [
              "150421524"
            ]
          },
          "150421524": {
            "id": "150421524",
            "speakerId": 6551,
            "speakerName": "图西娜",
            "text": "情况是这样的。",
            "nextDialogs": [
              "150421525"
            ]
          },
          "150421525": {
            "id": "150421525",
            "speakerId": 6551,
            "speakerName": "图西娜",
            "text": "测试发现，「闪闪大滑行」仍有许多地方缺少正确涂色。由于需要在游隙灵道上进行喷绘，施工难度很大。",
            "nextDialogs": [
              "150421526"
            ]
          },
          "150421526": {
            "id": "150421526",
            "speakerId": 6551,
            "speakerName": "图西娜",
            "text": "为了不影响度假村的正式开业时间，我们只能临时关停挑战项目，争分夺秒进行抢修…",
            "nextDialogs": [
              "150421527"
            ]
          },
          "150421527": {
            "id": "150421527",
            "speakerId": 1087,
            "speakerName": "玛拉妮",
            "text": "哈哈…那好说啊。",
            "nextDialogs": [
              "150421528"
            ]
          },
          "150421528": {
            "id": "150421528",
            "speakerId": 1087,
            "speakerName": "玛拉妮",
            "text": "告诉我颜料放在哪里？我来跑一次，一口气全都涂完！",
            "nextDialogs": [
              "150421529"
            ]
          },
          "150421529": {
            "id": "150421529",
            "speakerId": 6551,
            "speakerName": "图西娜",
            "text": "啊？…她在说什么？",
            "nextDialogs": [
              "150421530"
            ]
          },
          "150421530": {
            "id": "150421530",
            "speakerId": 1092,
            "speakerName": "恰斯卡",
            "text": "我猜你可能没和她见过面，这位是「沃摩{RUBY#[S]团结}延」的玛拉妮。",
            "nextDialogs": [
              "150421531"
            ]
          },
          "150421531": {
            "id": "150421531",
            "speakerId": 6551,
            "speakerName": "图西娜",
            "text": "玛拉妮…等等，玛拉妮…？！",
            "nextDialogs": [
              "150421532"
            ]
          },
          "150421532": {
            "id": "150421532",
            "speakerId": 6551,
            "speakerName": "图西娜",
            "text": "你是说…六英杰之一的那位玛拉妮？！"
          }
        }
      }
    },

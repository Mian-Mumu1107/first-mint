      }
    },
    {
      "subId": "7181805",
      "subQuestName": "将霄灯挂在屋子上",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "718180501"
        ],
        "dialogs": {
          "718180501": {
            "id": "718180501",
            "speakerId": 2138,
            "speakerName": "小白",
            "text": "刚才多谢了，旅行者，要是我一个人去，说不定就要忙得手忙脚乱了。",
            "nextDialogs": [
              "718180502"
            ]
          },
          "718180502": {
            "id": "718180502",
            "speakerId": 2138,
            "speakerName": "小白",
            "text": "大过节的，我也不太想让江城爷爷总是一个人呆着…",
            "nextDialogs": [
              "718180503"
            ]
          },
          "718180503": {
            "id": "718180503",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "那你自己…",
            "nextDialogs": [
              "718180504"
            ]
          },
          "718180504": {
            "id": "718180504",
            "speakerId": 2138,
            "speakerName": "小白",
            "text": "嗯…我等一下也会回去打理打理磨坊里的事。",
            "nextDialogs": [
              "718180505"
            ]
          },
          "718180505": {
            "id": "718180505",
            "speakerId": 2138,
            "speakerName": "小白",
            "text": "那个磨坊是我父亲留下来的，他过世后，我辞去了璃月的工作，回来继承了他的磨坊和手艺。",
            "nextDialogs": [
              "718180506"
            ]
          },
          "718180506": {
            "id": "718180506",
            "speakerId": 2138,
            "speakerName": "小白",
            "text": "怎么说呢，在一样的环境里，做和他一样的事情，我总能回忆起很多事来。",
            "nextDialogs": [
              "718180507"
            ]
          },
          "718180507": {
            "id": "718180507",
            "speakerId": 2138,
            "speakerName": "小白",
            "text": "特别是在海灯节的时候，我总会想起父亲从前和我说过的许多话…",
            "nextDialogs": [
              "718180508"
            ]
          },
          "718180508": {
            "id": "718180508",
            "speakerId": 2138,
            "speakerName": "小白",
            "text": "啊对了，光顾着给江城爷爷做霄灯了，我还得给自己做一盏才行。",
            "nextDialogs": [
              "718180509"
            ]
          },
          "718180509": {
            "id": "718180509",
            "speakerId": 2138,
            "speakerName": "小白",
            "text": "不过材料都用光了，没有留自己的份…",
            "nextDialogs": [
              "718180510"
            ]
          },
          "718180510": {
            "id": "718180510",
            "speakerId": 2138,
            "speakerName": "小白",
            "text": "现在再去搜集材料，怕是来不及了…旅行者，能请你帮我搜集一些来吗？",
            "nextDialogs": [
              "718180511"
            ]
          },
          "718180511": {
            "id": "718180511",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "我知道了。",
            "nextDialogs": [
              "718180512"
            ]
          },
          "718180512": {
            "id": "718180512",
            "speakerId": 2138,
            "speakerName": "小白",
            "text": "那就拜托你啦。"
          }
        }
      }
    },
    {
      "subId": "7181806",
      "subQuestName": "与江城对话",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "718180401"
        ],
        "dialogs": {
          "718180401": {
            "id": "718180401",
            "speakerId": 2137,
            "speakerName": "江城",
            "text": "霄灯挂好了？好看，真好看，来年一定又是个好年呐。",
            "nextDialogs": [
              "718180404"
            ]
          },
          "718180404": {
            "id": "718180404",
            "speakerId": 2138,
            "speakerName": "小白",
            "text": "那江城爷爷，我们还有点事，就先走了，回头再来看您。",
            "nextDialogs": [
              "718180405"
            ]
          },
          "718180405": {
            "id": "718180405",
            "speakerId": 2137,
            "speakerName": "江城",
            "text": "行、行，年轻人，总有自己要忙的事…忙不完的事…",
            "nextDialogs": [
              "718180406"
            ]
          },
          "718180406": {
            "id": "718180406",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "再见。",
            "nextDialogs": [
              "718180407"
            ]
          },
          "718180407": {
            "id": "718180407",
            "speakerId": 2137,
            "speakerName": "江城",
            "text": "欸，老婆子…别忘了看看咱家的地…"
          }
        }
      }
    },
    {
      "subId": "7181807",
      "subQuestName": "跟随小白回到磨坊",
      "sceneId": null,
      "locations": [],

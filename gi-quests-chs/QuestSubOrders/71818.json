    {
      "subId": "7181808",
      "subQuestName": "帮小白搜集制作霄灯的材料",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "718180801"
        ],
        "dialogs": {
          "718180801": {
            "id": "718180801",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "可算打扫干净啦！不知道小白和江城爷爷聊得怎么样了…",
            "nextDialogs": [
              "718180802"
            ]
          },
          "718180802": {
            "id": "718180802",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "唔，我们快点回去看看吧。"
          }
        }
      }
    },
    {
      "subId": "7181809",
      "subQuestName": "将制作霄灯的材料交给小白",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "718180901"
        ],
        "dialogs": {
          "718180901": {
            "id": "718180901",
            "speakerId": 2137,
            "speakerName": "江城",
            "text": "原来是小白啊…你爹爹最近都还好吗？",
            "nextDialogs": [
              "718180902"
            ]
          },
          "718180902": {
            "id": "718180902",
            "speakerId": 2138,
            "speakerName": "小白",
            "text": "嗯…他…他很好的。磨坊的生意也没落下，璃月港的人，都跑来庄里买我们的豆腐呢。",
            "nextDialogs": [
              "718180903"
            ]
          },
          "718180903": {
            "id": "718180903",
            "speakerId": 2137,
            "speakerName": "江城",
            "text": "嘿嘿…那可不是，你爹爹做的豆腐可是我们轻策庄的好东西…"
          }
        }
      }
    },
    {
      "subId": "7181810",
      "subQuestName": "与小白对话",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "718180701"
        ],
        "dialogs": {
          "718180701": {
            "id": "718180701",
            "speakerId": 2138,
            "speakerName": "小白",
            "text": "真是太感谢啦，等会儿我就给自己编一盏霄灯。",
            "nextDialogs": [
              "718180702"
            ]
          },
          "718180702": {
            "id": "718180702",
            "speakerId": 2138,
            "speakerName": "小白",
            "text": "之前我和父亲也一起放过很多次霄灯，等编好霄灯之后，我会自己去放飞的。",
            "nextDialogs": [
              "718180703"
            ]
          },
          "718180703": {
            "id": "718180703",
            "speakerId": 2138,
            "speakerName": "小白",
            "text": "希望…他能看见这盏霄灯。",
            "nextDialogs": [
              "718180705"
            ]
          },
          "718180705": {
            "id": "718180705",
            "speakerId": 2138,
            "speakerName": "小白",
            "text": "多谢你了，祝你海灯节快乐。"
          }
        }
      }
    },
    {
      "subId": "7181806",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "718180601"
        ],
        "dialogs": {
          "718180601": {
            "id": "718180601",
            "speakerId": 2138,
            "speakerName": "小白",
            "text": "材料都已经搜集好了吗？",
            "nextDialogs": [
              "718180602"
            ]
          },
          "718180602": {
            "id": "718180602",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "已经搜集好了。",
            "nextDialogs": [
              "718180603"
            ]
          },
          "718180603": {
            "id": "718180603",
            "speakerId": 2138,
            "speakerName": "小白",
            "text": "谢谢你。"
          }
        }
      }
    },
    {
      "subId": "7181810",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "718181001"
        ],
        "dialogs": {
          "718181001": {
            "id": "718181001",
            "speakerId": 2137,
            "speakerName": "江城",
            "text": "霄灯…霄灯…真好看哪…",
            "nextDialogs": [
              "718181002"
            ]
          },
          "718181002": {
            "id": "718181002",
            "speakerId": 2138,
            "speakerName": "小白",
            "text": "旅行者，那就麻烦你就挂霄灯了，我在这看着江城爷爷。"
          }
        }
      }
    },
    {
      "subId": "7181812",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "718181201"
        ],
        "dialogs": {
          "718181201": {
            "id": "718181201",
            "speakerId": 2137,
            "speakerName": "江城",
            "text": "这霄灯真好看，来年一定又是个好年呐…"
          }
        }
      }

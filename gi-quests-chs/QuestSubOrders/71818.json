  "subQuests": [
    {
      "subId": "7181811",
      "subQuestName": "",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "718181101"
        ],
        "dialogs": {
          "718181101": {
            "id": "718181101",
            "speakerId": 2138,
            "speakerName": "小白",
            "text": "希望江城爷爷能喜欢那盏霄灯…"
          }
        }
      }
    },
    {
      "subId": "7181801",
      "subQuestName": "与小白对话",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "718180101"
        ],
        "dialogs": {
          "718180101": {
            "id": "718180101",
            "speakerId": 2138,
            "speakerName": "小白",
            "text": "你好啊，旅行者。上次真是太谢谢你了，轻策庄好久没有这么热闹过了。",
            "nextDialogs": [
              "718180102"
            ]
          },
          "718180102": {
            "id": "718180102",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "不用客气。",
            "nextDialogs": [
              "718180103"
            ]
          },
          "718180103": {
            "id": "718180103",
            "speakerId": 2138,
            "speakerName": "小白",
            "text": "往年只有我和阿芷在，最多给孩子们做点霄灯，陪老人唠点家常，再稍微做一些好吃的…",
            "nextDialogs": [
              "718180104"
            ]
          },
          "718180104": {
            "id": "718180104",
            "speakerId": 2138,
            "speakerName": "小白",
            "text": "这次多亏了你，才能过上一个热热闹闹的海灯节。",
            "nextDialogs": [
              "718180105"
            ]
          },
          "718180105": {
            "id": "718180105",
            "speakerId": 2138,
            "speakerName": "小白",
            "text": "不过热闹归热闹…我还是想去探望一下庄里的老人。今天我准备去看看江城爷爷。",
            "nextDialogs": [
              "718180106"
            ]
          },
          "718180106": {
            "id": "718180106",
            "speakerId": 2138,
            "speakerName": "小白",
            "text": "如果你愿意的话，就一起来吧。",
            "nextDialogs": [
              "718180107"
            ]
          },
          "718180107": {
            "id": "718180107",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "那我们一起吧。",
            "nextDialogs": [
              "718180108"
            ]
          },
          "718180108": {
            "id": "718180108",
            "speakerId": 2138,
            "speakerName": "小白",
            "text": "嗯，好的，那我们先去江城爷爷那里吧。"
          }
        }
      }
    },
    {
      "subId": "7181802",
      "subQuestName": "与江城对话",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "718180201"
        ],
        "dialogs": {
          "718180201": {
            "id": "718180201",
            "speakerId": 2137,
            "speakerName": "江城",
            "text": "老婆子，你回来啦？",
            "nextDialogs": [
              "718180202"
            ]
          },
          "718180202": {
            "id": "718180202",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "抱歉，你认错人了…",
            "nextDialogs": [
              "718180203"
            ]
          },
          "718180203": {
            "id": "718180203",
            "speakerId": 2137,
            "speakerName": "江城",
            "text": "嗨，我可还没老糊涂呢…怎么会认不出你…",
            "nextDialogs": [
              "718180204"
            ]
          },
          "718180204": {
            "id": "718180204",
            "speakerId": 2137,
            "speakerName": "江城",
            "text": "我刚刚还念叨着你呢，你看这大过年的，是不是该给咱女儿添件新衣裳了…",
            "nextDialogs": [
              "718180205"
            ]
          },
          "718180205": {
            "id": "718180205",
            "speakerId": 2137,
            "speakerName": "江城",
            "text": "哟…这回你还多带了个人回来…啊，是你找来的裁缝吗？我俩又想到一块儿去了？",
            "nextDialogs": [
              "718180206"
            ]
          },
          "718180206": {
            "id": "718180206",
            "speakerId": 2138,
            "speakerName": "小白",
            "text": "江城爷爷，是我，小白啊。前两天我还给你送过豆腐，这么快就不记得我了？",
            "nextDialogs": [
              "718180207"
            ]
          },
          "718180207": {
            "id": "718180207",
            "speakerId": 2137,
            "speakerName": "江城",
            "text": "啊…小白…是小白啊！记得记得！就前一阵子，你爹爹还在跟我夸你呢…",
            "nextDialogs": [
              "718180208"
            ]
          },
          "718180208": {
            "id": "718180208",
            "speakerId": 2137,
            "speakerName": "江城",
            "text": "欸…那是什么时候的事儿来着…老婆子，你还记得不…",
            "nextDialogs": [
              "718180211"
            ]
          },
          "718180211": {
            "id": "718180211",
            "speakerId": 2137,
            "speakerName": "江城",
            "text": "嗬！我就说，我的记性怎么可能差了…还有，还有…",
            "nextDialogs": [
              "718180212"
            ]
          },
          "718180212": {
            "id": "718180212",
            "speakerId": 2138,
            "speakerName": "小白",
            "text": "江城爷爷，您歇一会，别太累了…",
            "nextDialogs": [
              "718180213"
            ]
          },
          "718180213": {
            "id": "718180213",
            "speakerId": 2138,
            "speakerName": "小白",
            "text": "旅行者，要不你先去帮江城爷爷打扫一下屋子吧，我来陪他聊会儿天。",
            "nextDialogs": [
              "718180214"
            ]
          },
          "718180214": {
            "id": "718180214",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "交给我了。",
            "nextDialogs": [
              "718180215"
            ]
          },
          "718180215": {
            "id": "718180215",
            "speakerId": 2138,
            "speakerName": "小白",
            "text": "那就拜托你了。"
          }
        }
      }
    },
    {
      "subId": "7181803",
      "subQuestName": "用风或水元素帮助江城清扫屋子",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "718180301"
        ],
        "dialogs": {
          "718180301": {
            "id": "718180301",
            "speakerId": 2137,
            "speakerName": "江城",
            "text": "唉…老婆子，你也来和小白唠两句…她爹爹的手艺这么好…",
            "nextDialogs": [
              "718180302"
            ]
          },
          "718180302": {
            "id": "718180302",
            "speakerId": 2137,
            "speakerName": "江城",
            "text": "这豆腐啊，就是卖去璃月港，也是一顶一的好！",
            "nextDialogs": [
              "718180303"
            ]
          },
          "718180303": {
            "id": "718180303",
            "speakerId": 2137,
            "speakerName": "江城",
            "text": "唔，小白啊，你是来做什么的来着…",
            "nextDialogs": [
              "718180304"
            ]
          },
          "718180304": {
            "id": "718180304",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "是来送霄灯的。",
            "nextDialogs": [
              "718180305"
            ]
          },
          "718180305": {
            "id": "718180305",
            "speakerId": 2137,
            "speakerName": "江城",
            "text": "霄灯…啊…是霄灯…哎呀，年年都麻烦你啦，小白…",
            "nextDialogs": [
              "718180306"
            ]
          },
          "718180306": {
            "id": "718180306",
            "speakerId": 2137,
            "speakerName": "江城",
            "text": "老婆子，你还记得吧，之前我编霄灯的手艺可好啦，那周围的人，都找我编。",
            "nextDialogs": [
              "718180307"
            ]
          },
          "718180307": {
            "id": "718180307",
            "speakerId": 2137,
            "speakerName": "江城",
            "text": "每年过海灯节的时候，那些霄灯啊，可真好看…你等着，我这就去给你挂霄灯去…",
            "nextDialogs": [
              "718180308"
            ]
          },
          "718180308": {
            "id": "718180308",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "我来挂霄灯吧。",
            "nextDialogs": [
              "718180309"
            ]
          },
          "718180309": {
            "id": "718180309",
            "speakerId": 2137,
            "speakerName": "江城",
            "text": "嗯，也好，那你可小心点啊，可别碰着摔着了…"
          }
        }
      }
    },
    {
      "subId": "7181804",
      "subQuestName": "与江城对话",
      "sceneId": null,
      "locations": [],

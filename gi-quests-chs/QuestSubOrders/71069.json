        "dialogs": {
          "710690101": {
            "id": "710690101",
            "speakerId": 1000,
            "speakerName": "沐宁",
            "text": "瞧我说什么来着！你果然没有老老实实看守仓库！$UNRELEASED",
            "nextDialogs": [
              "710690102"
            ]
          },
          "710690102": {
            "id": "710690102",
            "speakerId": 1000,
            "speakerName": "沐宁",
            "text": "这下事情闹大了，你想怎么收场呀，阿志？你能负得了擅自解除阵法的责任吗？$UNRELEASED",
            "nextDialogs": [
              "710690103"
            ]
          },
          "710690103": {
            "id": "710690103",
            "speakerId": 1000,
            "speakerName": "沐宁",
            "text": "啊，你来了。唉…擅自破坏「磐键」的事情，你怎么解释？$UNRELEASED",
            "nextDialogs": [
              "710690106"
            ]
          },
          "710690106": {
            "id": "710690106",
            "speakerId": 1000,
            "speakerName": "沐宁",
            "text": "你…！哼，先说好责任由你自负，剩下的等七星怪罪下来再说吧。$UNRELEASED",
            "nextDialogs": [
              "710690107"
            ]
          },
          "710690107": {
            "id": "710690107",
            "speakerId": 1001,
            "speakerName": "志琼",
            "text": "嘿嘿，没关系的。沐宁这人就是这样，只会对那些不管事的人发脾气…别看他性子急，人还是不坏的。$UNRELEASED",
            "nextDialogs": [
              "710690108"
            ]
          },
          "710690108": {
            "id": "710690108",
            "speakerId": 1001,
            "speakerName": "志琼",
            "text": "不用管他的臭脾气。等你准备好，我就叫上大家一同随你下矿。$UNRELEASED",
            "nextDialogs": [
              "710690109"
            ]
          },
          "710690109": {
            "id": "710690109",
            "speakerId": 1001,
            "speakerName": "志琼",
            "text": "啊！抱歉，差点忘了…欢迎加入层岩巨渊勘探队！$UNRELEASED"
          }
        }
      }
    }
  ]

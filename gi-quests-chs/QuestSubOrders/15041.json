    {
      "subId": "1504114",
      "subQuestName": "在山洞内部四处调查",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [],
        "dialogs": {}
      }
    },
    {
      "subId": "1504115",
      "subQuestName": "与众人对话",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "150411501"
        ],
        "dialogs": {
          "150411501": {
            "id": "150411501",
            "speakerId": 1092,
            "speakerName": "恰斯卡",
            "text": "……",
            "nextDialogs": [
              "150411502"
            ]
          },
          "150411502": {
            "id": "150411502",
            "speakerId": 1092,
            "speakerName": "恰斯卡",
            "text": "好，魔物清除完毕，现在这里也没有其他残留的深渊气息了。",
            "nextDialogs": [
              "150411503"
            ]
          },
          "150411503": {
            "id": "150411503",
            "speakerId": 1092,
            "speakerName": "恰斯卡",
            "text": "都没受伤吧？",
            "nextDialogs": [
              "150411504"
            ]
          },
          "150411504": {
            "id": "150411504",
            "speakerId": 1024,
            "speakerName": "班尼特",
            "text": "手臂上擦到了一点，不过不痛的，没什么感觉。",
            "nextDialogs": [
              "150411505"
            ]
          },
          "150411505": {
            "id": "150411505",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "让我看看。",
            "nextDialogs": [
              "150411506"
            ]
          },
          "150411506": {
            "id": "150411506",
            "speakerId": 1024,
            "speakerName": "班尼特",
            "text": "噢，好的…真不好意思啊，让你担心了…",
            "nextDialogs": [
              "150411509"
            ]
          },
          "150411509": {
            "id": "150411509",
            "speakerId": 1092,
            "speakerName": "恰斯卡",
            "text": "那就好。",
            "nextDialogs": [
              "150411510"
            ]
          },
          "150411510": {
            "id": "150411510",
            "speakerId": 1087,
            "speakerName": "玛拉妮",
            "text": "但这不太寻常吧？",
            "nextDialogs": [
              "150411511"
            ]
          },
          "150411511": {
            "id": "150411511",
            "speakerId": 1087,
            "speakerName": "玛拉妮",
            "text": "我是说…丘丘游侠可能是请来的演员，但深渊魔物怎么想都不应该出现啊！",
            "nextDialogs": [
              "150411512"
            ]
          },
          "150411512": {
            "id": "150411512",
            "speakerId": 1092,
            "speakerName": "恰斯卡",
            "text": "嗯，这不可能是正常游乐体验。",
            "nextDialogs": [
              "150411513"
            ]
          },
          "150411513": {
            "id": "150411513",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "而且，我们进来的通路也被堵上了，魔物出现之前还是好好的…",
            "nextDialogs": [
              "150411514"
            ]
          },
          "150411514": {
            "id": "150411514",
            "speakerId": 1024,
            "speakerName": "班尼特",
            "text": "该不会是…我的厄运突然出现了…连累了大家…",
            "nextDialogs": [
              "150411515"
            ]
          },
          "150411515": {
            "id": "150411515",
            "speakerId": 1092,
            "speakerName": "恰斯卡",
            "text": "别往那方面想。",
            "nextDialogs": [
              "150411516"
            ]
          },
          "150411516": {
            "id": "150411516",
            "speakerId": 1024,
            "speakerName": "班尼特",
            "text": "……",
            "nextDialogs": [
              "150411517"
            ]
          },
          "150411517": {
            "id": "150411517",
            "speakerId": 1092,
            "speakerName": "恰斯卡",
            "text": "深渊魔物出现的原因有很多，被人或物吸引而来的确是一种可能。",
            "nextDialogs": [
              "150411518"
            ]
          },
          "150411518": {
            "id": "150411518",
            "speakerId": 1092,
            "speakerName": "恰斯卡",
            "text": "但现在，比起怀疑是自己招致了灾祸，更需要做的事是彻底排查隐患。",
            "nextDialogs": [
              "150411519"
            ]
          },
          "150411519": {
            "id": "150411519",
            "speakerId": 1092,
            "speakerName": "恰斯卡",
            "text": "我们还不知道山洞外有没有发生什么。",
            "nextDialogs": [
              "150411520"
            ]
          },
          "150411520": {
            "id": "150411520",
            "speakerId": 1024,
            "speakerName": "班尼特",
            "text": "你说得对，好，那就由我负责先行探路吧！",
            "nextDialogs": [
              "150411521"
            ]
          },
          "150411521": {
            "id": "150411521",
            "speakerId": 1092,
            "speakerName": "恰斯卡",
            "text": "哈，我可不能把这个机会让给你。",
            "nextDialogs": [
              "150411522"
            ]
          },
          "150411522": {
            "id": "150411522",
            "speakerId": 1092,
            "speakerName": "恰斯卡",
            "text": "这里应该遵守纳塔的规则，让机动性最高的「花羽会」成员负责侦察。",
            "nextDialogs": [
              "150411523"
            ]
          },
          "150411523": {
            "id": "150411523",
            "speakerId": 1092,
            "speakerName": "恰斯卡",
            "text": "各位，我先去打探外面的情况了。晚点见。",
            "nextDialogs": [
              "150411524"
            ]
          },
          "150411524": {
            "id": "150411524",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "但山洞不还…",
            "nextDialogs": [
              "150411525"
            ]
          },
          "150411525": {
            "id": "150411525",
            "speakerId": 1092,
            "speakerName": "恰斯卡",
            "text": "后退。",
            "nextDialogs": [
              "150411526"
            ]
          },
          "150411526": {
            "id": "150411526",
            "speakerId": 1087,
            "speakerName": "玛拉妮",
            "text": "等一下等一下啦还没准备好…",
            "nextDialogs": [
              "150411527"
            ]
          },
          "150411527": {
            "id": "150411527",
            "speakerId": 1010,
            "speakerName": "Black Screen",
            "text": "轰——",
            "nextDialogs": [
              "150411528"
            ]
          },
          "150411528": {
            "id": "150411528",
            "speakerId": 1024,
            "speakerName": "班尼特",
            "text": "哈，真的飞得好快…已经看不见人影了…",
            "nextDialogs": [
              "150411529"
            ]
          },
          "150411529": {
            "id": "150411529",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "#这下出去的路倒是不缺了。嗯？{NICKNAME}，你在看什么呀？",
            "nextDialogs": [
              "150411530"
            ]
          },
          "150411530": {
            "id": "150411530",
            "speakerId": 1010,
            "speakerName": "Black Screen",
            "text": "（弹出阅读物）",
            "nextDialogs": [
              "150411531"
            ]
          },
          "150411531": {
            "id": "150411531",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "「燧石之锋」冒险团，安洁娅，马坎尼…都是些陌生的名字啊。",
            "nextDialogs": [
              "150411532"
            ]
          },
          "150411532": {
            "id": "150411532",
            "speakerId": 1087,
            "speakerName": "玛拉妮",
            "text": "嗯…我也没听说过。"
          }
        }
      }
    },

    {
      "subId": "1504119",
      "subQuestName": "击落「乔克力老大」的热气球",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [],
        "dialogs": {}
      }
    },
    {
      "subId": "1504120",
      "subQuestName": "前往山顶热气球坠毁处",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "150412001"
        ],
        "dialogs": {
          "150412001": {
            "id": "150412001",
            "speakerId": 1092,
            "speakerName": "恰斯卡",
            "text": "放开那个人。",
            "nextDialogs": [
              "150412002"
            ]
          },
          "150412002": {
            "id": "150412002",
            "speakerId": 21867,
            "speakerName": "「乔克力老大」",
            "text": "要他活命的话，就乖乖向我投降。",
            "nextDialogs": [
              "150412003"
            ]
          },
          "150412003": {
            "id": "150412003",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "好高的山坡，爬一爬头发都吹干了…恰斯卡！",
            "nextDialogs": [
              "150412004"
            ]
          },
          "150412004": {
            "id": "150412004",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "「乔克力老大」！",
            "nextDialogs": [
              "150412005"
            ]
          },
          "150412005": {
            "id": "150412005",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "…记不住名字的什么大梨人！",
            "nextDialogs": [
              "150412006"
            ]
          },
          "150412006": {
            "id": "150412006",
            "speakerId": 6552,
            "speakerName": "「维拉庇」",
            "text": "嘘，嘘…",
            "nextDialogs": [
              "150412007"
            ]
          },
          "150412007": {
            "id": "150412007",
            "speakerId": 21867,
            "speakerName": "「乔克力老大」",
            "text": "我再说一遍，这是最后一遍。要他活命的话，就乖乖向我投降。",
            "nextDialogs": [
              "150412008"
            ]
          },
          "150412008": {
            "id": "150412008",
            "speakerId": 21867,
            "speakerName": "「乔克力老大」",
            "text": "只要你敢开枪，或者你们之中有谁胆敢轻举妄动，我就把他从这里丢下去。",
            "nextDialogs": [
              "150412009"
            ]
          },
          "150412009": {
            "id": "150412009",
            "speakerId": 6552,
            "speakerName": "「维拉庇」",
            "text": "呃啊…求求你，不要这么做…",
            "nextDialogs": [
              "150412010"
            ]
          },
          "150412010": {
            "id": "150412010",
            "speakerId": 1092,
            "speakerName": "恰斯卡",
            "text": "……",
            "nextDialogs": [
              "150412011"
            ]
          },
          "150412011": {
            "id": "150412011",
            "speakerId": 1087,
            "speakerName": "玛拉妮",
            "text": "奇怪。恰斯卡…为什么还不行动？",
            "nextDialogs": [
              "150412014"
            ]
          },
          "150412014": {
            "id": "150412014",
            "speakerId": 1024,
            "speakerName": "班尼特",
            "text": "啊！你是说…有人取代了原本的工作人员？",
            "nextDialogs": [
              "150412015"
            ]
          },
          "150412015": {
            "id": "150412015",
            "speakerId": 1087,
            "speakerName": "玛拉妮",
            "text": "考虑到不合理出现的深渊魔物…难道是想…",
            "nextDialogs": [
              "150412016"
            ]
          },
          "150412016": {
            "id": "150412016",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "假戏真做？！",
            "nextDialogs": [
              "150412017"
            ]
          },
          "150412017": {
            "id": "150412017",
            "speakerId": 21867,
            "speakerName": "「乔克力老大」",
            "text": "够了！我的忍耐不是没有限度的。",
            "nextDialogs": [
              "150412018"
            ]
          },
          "150412018": {
            "id": "150412018",
            "speakerId": 21867,
            "speakerName": "「乔克力老大」",
            "text": "现在就给我后退！你们全部人！离开山崖！",
            "nextDialogs": [
              "150412019"
            ]
          },
          "150412019": {
            "id": "150412019",
            "speakerId": 6552,
            "speakerName": "「维拉庇」",
            "text": "冒险家们，快逃，离开小镇，别管我了！",
            "nextDialogs": [
              "150412020"
            ]
          },
          "150412020": {
            "id": "150412020",
            "speakerId": 1092,
            "speakerName": "恰斯卡",
            "text": "——♪",
            "nextDialogs": [
              "150412021"
            ]
          },
          "150412021": {
            "id": "150412021",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "（这是…！）",
            "nextDialogs": [
              "150412022"
            ]
          },
          "150412022": {
            "id": "150412022",
            "speakerId": 1010,
            "speakerName": "Black Screen",
            "text": "（插入恰斯卡QTE的对决）",
            "nextDialogs": [
              "150412023"
            ]
          },
          "150412023": {
            "id": "150412023",
            "speakerId": 1012,
            "speakerName": "枪声",
            "text": "砰——",
            "nextDialogs": [
              "150412024"
            ]
          },
          "150412024": {
            "id": "150412024",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "已经没事了。",
            "nextDialogs": [
              "150412025"
            ]
          },
          "150412025": {
            "id": "150412025",
            "speakerId": 6552,
            "speakerName": "「维拉庇」",
            "text": "谢谢你，勇敢的冒险家！你们是拯救了刺梨镇，也拯救了我的英雄！",
            "nextDialogs": [
              "150412026"
            ]
          },
          "150412026": {
            "id": "150412026",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "啊…你们快看！",
            "nextDialogs": [
              "150412027"
            ]
          },
          "150412027": {
            "id": "150412027",
            "speakerId": 1024,
            "speakerName": "班尼特",
            "text": "阿夏？",
            "nextDialogs": [
              "150412028"
            ]
          },
          "150412028": {
            "id": "150412028",
            "speakerId": 1087,
            "speakerName": "玛拉妮",
            "text": "「乔克力老大」…是由阿夏们扮演的？",
            "nextDialogs": [
              "150412029"
            ]
          },
          "150412029": {
            "id": "150412029",
            "speakerId": 6552,
            "speakerName": "「维拉庇」",
            "text": "恭喜各位！做出了勇敢和正义的选择，成功击败了为非作歹的「乔克力老大」！",
            "nextDialogs": [
              "150412030"
            ]
          },
          "150412030": {
            "id": "150412030",
            "speakerId": 1013,
            "speakerName": "阿夏们",
            "text": "♪",
            "nextDialogs": [
              "150412031"
            ]
          },
          "150412031": {
            "id": "150412031",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "等等，我有点反应不过来。所以…不是假戏真做？搞半天是虚惊一场？",
            "nextDialogs": [
              "150412032"
            ]
          },
          "150412032": {
            "id": "150412032",
            "speakerId": 1092,
            "speakerName": "恰斯卡",
            "text": "我明白你们在担心什么，那也是我所顾虑的。",
            "nextDialogs": [
              "150412033"
            ]
          },
          "150412033": {
            "id": "150412033",
            "speakerId": 1092,
            "speakerName": "恰斯卡",
            "text": "来的路上，我没有发现其他深渊魔物，但我也没有放松警惕。",
            "nextDialogs": [
              "150412034"
            ]
          },
          "150412034": {
            "id": "150412034",
            "speakerId": 1092,
            "speakerName": "恰斯卡",
            "text": "放在平时，我的确会直接开枪。要是对方真敢对人质出手，我也有自信骑上灵枪救回人质。",
            "nextDialogs": [
              "150412035"
            ]
          },
          "150412035": {
            "id": "150412035",
            "speakerId": 1092,
            "speakerName": "恰斯卡",
            "text": "但这次的对手掺杂了深渊，不可侥幸，必须做好最坏打算。",
            "nextDialogs": [
              "150412036"
            ]
          },
          "150412036": {
            "id": "150412036",
            "speakerId": 1092,
            "speakerName": "恰斯卡",
            "text": "#所以我需要和{NICKNAME}在同一时刻出手，确保「击倒反派」和「救下人质」两个目标同时达成。",
            "nextDialogs": [
              "150412037"
            ]
          },
          "150412037": {
            "id": "150412037",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "还好你们在打爪牙的时候培养了默契…",
            "nextDialogs": [
              "150412038"
            ]
          },
          "150412038": {
            "id": "150412038",
            "speakerId": 1092,
            "speakerName": "恰斯卡",
            "text": "现在可以确认，唯一出现过问题的就是那处山洞。",
            "nextDialogs": [
              "150412039"
            ]
          },
          "150412039": {
            "id": "150412039",
            "speakerId": 1087,
            "speakerName": "玛拉妮",
            "text": "你确定清除完魔物后，已经不会再有危险了对吧？",
            "nextDialogs": [
              "150412040"
            ]
          },
          "150412040": {
            "id": "150412040",
            "speakerId": 1092,
            "speakerName": "恰斯卡",
            "text": "是的。",
            "nextDialogs": [
              "150412041"
            ]
          },
          "150412041": {
            "id": "150412041",
            "speakerId": 6552,
            "speakerName": "「维拉庇」",
            "text": "不好意思…我没听明白，几位口中的「山洞」，是在说这里的场所吗？",
            "nextDialogs": [
              "150412042"
            ]
          },
          "150412042": {
            "id": "150412042",
            "speakerId": 1087,
            "speakerName": "玛拉妮",
            "text": "对啊，山洞里有个冒险家营地，在绵驮兽警长倒下的那块地方附近…唉，这样形容真对不起警长…",
            "nextDialogs": [
              "150412043"
            ]
          },
          "150412043": {
            "id": "150412043",
            "speakerId": 6552,
            "speakerName": "「维拉庇」",
            "text": "真的假的？那里根本没有山洞或者营地啊…",
            "nextDialogs": [
              "150412044"
            ]
          },
          "150412044": {
            "id": "150412044",
            "speakerId": 6552,
            "speakerName": "「维拉庇」",
            "text": "你们…确定不是看错了？",
            "nextDialogs": [
              "150412045"
            ]
          },
          "150412045": {
            "id": "150412045",
            "speakerId": 1024,
            "speakerName": "班尼特",
            "text": "不会的。我们先是遭到了魔物的偷袭，后来又读到了冒险家的手记，再怎么说也不可能都是幻觉。",
            "nextDialogs": [
              "150412046"
            ]
          },
          "150412046": {
            "id": "150412046",
            "speakerId": 1024,
            "speakerName": "班尼特",
            "text": "噢，就连我手臂上的擦伤也在…竟然可以作为证据，哈哈，这就是「因祸得福」吗？",
            "nextDialogs": [
              "150412047"
            ]
          },
          "150412047": {
            "id": "150412047",
            "speakerId": 6552,
            "speakerName": "「维拉庇」",
            "text": "啊？但是，这不应该啊…",
            "nextDialogs": [
              "150412048"
            ]
          },
          "150412048": {
            "id": "150412048",
            "speakerId": 6552,
            "speakerName": "「维拉庇」",
            "text": "为了让游客身临其境地感受刺梨镇氛围，我们怎么会留和主题完全无关的穿帮设计呢？",
            "nextDialogs": [
              "150412049"
            ]
          },
          "150412049": {
            "id": "150412049",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "好像…也有道理…",
            "nextDialogs": [
              "150412050"
            ]
          },
          "150412050": {
            "id": "150412050",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "怎么办？我突然感觉背后…凉飕飕的…"
          }
        }
      }
    },

    {
      "subId": "1504106",
      "subQuestName": "与警长对话",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "150410601"
        ],
        "dialogs": {
          "150410601": {
            "id": "150410601",
            "speakerId": 1024,
            "speakerName": "班尼特",
            "text": "警长，故事的后续呢？",
            "nextDialogs": [
              "150410602"
            ]
          },
          "150410602": {
            "id": "150410602",
            "speakerId": 21866,
            "speakerName": "绵驮兽警长",
            "text": "英雄消失了，没有人知道后面发生了什么事…",
            "nextDialogs": [
              "150410603"
            ]
          },
          "150410603": {
            "id": "150410603",
            "speakerId": 21866,
            "speakerName": "绵驮兽警长",
            "text": "有人说他更名改姓，也有人说他和朋友们踏上了不归的远征，去往了如骄阳般灼热的地方…",
            "nextDialogs": [
              "150410604"
            ]
          },
          "150410604": {
            "id": "150410604",
            "speakerId": 21866,
            "speakerName": "绵驮兽警长",
            "text": "如果你们之中有谁见到了那位英雄，请替我转告他，我们很感激他所做的一切，也很想他。",
            "nextDialogs": [
              "150410605"
            ]
          },
          "150410605": {
            "id": "150410605",
            "speakerId": 1092,
            "speakerName": "恰斯卡",
            "text": "见到的话，一定把话带到。",
            "nextDialogs": [
              "150410606"
            ]
          },
          "150410606": {
            "id": "150410606",
            "speakerId": 21866,
            "speakerName": "绵驮兽警长",
            "text": "嗯，这里就是诺奇特梨老巢了。我曾偷偷跟踪过爪牙，知道启动机关的方法。我来为各位开门。",
            "nextDialogs": [
              "150410607"
            ]
          },
          "150410607": {
            "id": "150410607",
            "speakerId": 21866,
            "speakerName": "绵驮兽警长",
            "text": "……",
            "nextDialogs": [
              "150410608"
            ]
          },
          "150410608": {
            "id": "150410608",
            "speakerId": 21866,
            "speakerName": "绵驮兽警长",
            "text": "但这里眼目众多，单独行动容易成为敌人的目标，还请几位替我做些掩护。",
            "nextDialogs": [
              "150410609"
            ]
          },
          "150410609": {
            "id": "150410609",
            "speakerId": 1092,
            "speakerName": "恰斯卡",
            "text": "怎么掩护？",
            "nextDialogs": [
              "150410610"
            ]
          },
          "150410610": {
            "id": "150410610",
            "speakerId": 21866,
            "speakerName": "绵驮兽警长",
            "text": "请将妨碍在我前进路上的爪牙及时击倒。",
            "nextDialogs": [
              "150410611"
            ]
          },
          "150410611": {
            "id": "150410611",
            "speakerId": 1024,
            "speakerName": "班尼特",
            "text": "哈哈，真是个有魄力的请求。",
            "nextDialogs": [
              "150410612"
            ]
          },
          "150410612": {
            "id": "150410612",
            "speakerId": 1092,
            "speakerName": "恰斯卡",
            "text": "包在我身上。",
            "nextDialogs": [
              "150410613"
            ]
          },
          "150410613": {
            "id": "150410613",
            "speakerId": 1087,
            "speakerName": "玛拉妮",
            "text": "我就知道那话说到恰斯卡心坎上去了…",
            "nextDialogs": [
              "150410614"
            ]
          },
          "150410614": {
            "id": "150410614",
            "speakerId": 1092,
            "speakerName": "恰斯卡",
            "text": "#{NICKNAME}，那边的枪交给你了。",
            "nextDialogs": [
              "150410615"
            ]
          },
          "150410615": {
            "id": "150410615",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "收到，我来解决。",
            "nextDialogs": [
              "150410616"
            ]
          },
          "150410616": {
            "id": "150410616",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "唉，我们需要潜行的时候怎么就没人这么帮我们…"
          }
        }
      }
    },
    {
      "subId": "1504107",
      "subQuestName": "协助警长启动机关",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "150410701"
        ],
        "dialogs": {
          "150410701": {
            "id": "150410701",
            "speakerId": 1092,
            "speakerName": "恰斯卡",
            "text": "是你赢了。你的枪法挺有两下子，在其他地方练过？",
            "nextDialogs": [
              "150410702"
            ]
          },
          "150410702": {
            "id": "150410702",
            "speakerId": 1092,
            "speakerName": "恰斯卡",
            "text": "我教你点连发子弹的技巧吧，说不定今后也用得上。",
            "nextDialogs": [
              "150410703"
            ]
          },
          "150410703": {
            "id": "150410703",
            "speakerId": 1024,
            "speakerName": "班尼特",
            "text": "不好了！",
            "nextDialogs": [
              "150410704"
            ]
          },
          "150410704": {
            "id": "150410704",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "怎么了怎么了？",
            "nextDialogs": [
              "150410705"
            ]
          },
          "150410705": {
            "id": "150410705",
            "speakerId": 1024,
            "speakerName": "班尼特",
            "text": "一说话的工夫，绵驮兽警长…被抓走了…",
            "nextDialogs": [
              "150410706"
            ]
          },
          "150410706": {
            "id": "150410706",
            "speakerId": 1092,
            "speakerName": "恰斯卡",
            "text": "我们追。"
          }
        }
      }
    },
    {
      "subId": "1504108",
      "subQuestName": "与恰斯卡对话",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "150410801"
        ],
        "dialogs": {
          "150410801": {
            "id": "150410801",
            "speakerId": 1092,
            "speakerName": "恰斯卡",
            "text": "可惜了。我看你拿起枪来有模有样的，或许还是使用的机会少了。",
            "nextDialogs": [
              "150410802"
            ]
          },
          "150410802": {
            "id": "150410802",
            "speakerId": 1092,
            "speakerName": "恰斯卡",
            "text": "我教你点连发子弹的技巧吧，说不定今后也用得上。",
            "nextDialogs": [
              "150410803"
            ]
          },
          "150410803": {
            "id": "150410803",
            "speakerId": 1024,
            "speakerName": "班尼特",
            "text": "不好了！",
            "nextDialogs": [
              "150410804"
            ]
          },
          "150410804": {
            "id": "150410804",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "怎么了怎么了？",
            "nextDialogs": [
              "150410805"
            ]
          },
          "150410805": {
            "id": "150410805",
            "speakerId": 1024,
            "speakerName": "班尼特",
            "text": "一说话的工夫，绵驮兽警长…被抓走了…",
            "nextDialogs": [
              "150410806"
            ]
          },
          "150410806": {
            "id": "150410806",
            "speakerId": 1092,
            "speakerName": "恰斯卡",
            "text": "我们追。"
          }
        }
      }
    },

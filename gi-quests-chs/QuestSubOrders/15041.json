  "subQuests": [
    {
      "subId": "1504101",
      "subQuestName": "前往刺梨岩",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "150410101"
        ],
        "dialogs": {
          "150410101": {
            "id": "150410101",
            "speakerId": 10205,
            "speakerName": "？？？",
            "text": "勇敢的冒险家们，欢迎来到刺梨镇，度过一年一度的梨果之夜！",
            "nextDialogs": [
              "150410102"
            ]
          },
          "150410102": {
            "id": "150410102",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "噢噢噢，好有说法。这就已经开始营造气氛了吗？",
            "nextDialogs": [
              "150410103"
            ]
          },
          "150410103": {
            "id": "150410103",
            "speakerId": 1024,
            "speakerName": "班尼特",
            "text": "您好，这位…",
            "nextDialogs": [
              "150410104"
            ]
          },
          "150410104": {
            "id": "150410104",
            "speakerId": 6552,
            "speakerName": "「维拉庇」",
            "text": "娜娜丝梨人。",
            "nextDialogs": [
              "150410105"
            ]
          },
          "150410105": {
            "id": "150410105",
            "speakerId": 1024,
            "speakerName": "班尼特",
            "text": "这位娜娜丝梨人，请问刺梨镇怎么走？我们需要准备些什么吗？",
            "nextDialogs": [
              "150410106"
            ]
          },
          "150410106": {
            "id": "150410106",
            "speakerId": 6552,
            "speakerName": "「维拉庇」",
            "text": "哈哈，一听您的问题，就知道您是位心思缜密、经验丰富的老冒险家。",
            "nextDialogs": [
              "150410107"
            ]
          },
          "150410107": {
            "id": "150410107",
            "speakerId": 6552,
            "speakerName": "「维拉庇」",
            "text": "您和您的同伴只需要由此向下，就能抵达美丽的刺梨镇了。",
            "nextDialogs": [
              "150410108"
            ]
          },
          "150410108": {
            "id": "150410108",
            "speakerId": 6552,
            "speakerName": "「维拉庇」",
            "text": "至于准备嘛…请带上自信的头巾，乐于助人的心灵，和一点点直面困难的勇气。",
            "nextDialogs": [
              "150410109"
            ]
          },
          "150410109": {
            "id": "150410109",
            "speakerId": 21855,
            "speakerName": "阿夏",
            "text": "♪",
            "nextDialogs": [
              "150410110"
            ]
          },
          "150410110": {
            "id": "150410110",
            "speakerId": 6552,
            "speakerName": "「维拉庇」",
            "text": "啊，看来您身边还有一位小小的搭档。可以让它暂时待在您的包里吗？以免出现意外。",
            "nextDialogs": [
              "150410111"
            ]
          },
          "150410111": {
            "id": "150410111",
            "speakerId": 21855,
            "speakerName": "阿夏",
            "text": "♪~",
            "nextDialogs": [
              "150410112"
            ]
          },
          "150410112": {
            "id": "150410112",
            "speakerId": 6552,
            "speakerName": "「维拉庇」",
            "text": "好的，那就没问题了。冒险即将开幕，无畏的挑战者们，预祝你们在此度过愉快的一夜！"
          }
        }
      }
    },

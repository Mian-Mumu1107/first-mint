    {
      "subId": "1504102",
      "subQuestName": "进入山洞",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "150410201"
        ],
        "dialogs": {
          "150410201": {
            "id": "150410201",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "哇噢，没想到山洞里面这么大啊，这个小镇看起来还挺精致的。",
            "nextDialogs": [
              "150410202"
            ]
          },
          "150410202": {
            "id": "150410202",
            "speakerId": 1024,
            "speakerName": "班尼特",
            "text": "那是…悬赏板？",
            "nextDialogs": [
              "150410203"
            ]
          },
          "150410203": {
            "id": "150410203",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "我看看…个十百千万…",
            "nextDialogs": [
              "150410204"
            ]
          },
          "150410204": {
            "id": "150410204",
            "speakerId": 1092,
            "speakerName": "恰斯卡",
            "text": "……",
            "nextDialogs": [
              "150410205"
            ]
          },
          "150410205": {
            "id": "150410205",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "十万、百万…五百万摩拉！呜啊——什么东西过来了！",
            "nextDialogs": [
              "150410206"
            ]
          },
          "150410206": {
            "id": "150410206",
            "speakerId": 21866,
            "speakerName": "绵驮兽警长",
            "text": "尊贵的客人们，欢迎来到我美丽的家乡，刺梨镇。",
            "nextDialogs": [
              "150410207"
            ]
          },
          "150410207": {
            "id": "150410207",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "…吓死我了。",
            "nextDialogs": [
              "150410208"
            ]
          },
          "150410208": {
            "id": "150410208",
            "speakerId": 21866,
            "speakerName": "绵驮兽警长",
            "text": "你们是为梨果之夜来的吧？唉，可惜今年这节恐怕是过不了了。",
            "nextDialogs": [
              "150410209"
            ]
          },
          "150410209": {
            "id": "150410209",
            "speakerId": 1087,
            "speakerName": "玛拉妮",
            "text": "嗯？发生什么事了？",
            "nextDialogs": [
              "150410210"
            ]
          },
          "150410210": {
            "id": "150410210",
            "speakerId": 21866,
            "speakerName": "绵驮兽警长",
            "text": "不久之前，诺奇特梨恶霸席卷村庄，抢走了我们的金银财宝。",
            "nextDialogs": [
              "150410211"
            ]
          },
          "150410211": {
            "id": "150410211",
            "speakerId": 21866,
            "speakerName": "绵驮兽警长",
            "text": "直到现在，他还盘踞在镇上不肯出来，扬言要做我们所有人的老大。",
            "nextDialogs": [
              "150410212"
            ]
          },
          "150410212": {
            "id": "150410212",
            "speakerId": 1024,
            "speakerName": "班尼特",
            "text": "太坏了，这怎么能答应！",
            "nextDialogs": [
              "150410213"
            ]
          },
          "150410213": {
            "id": "150410213",
            "speakerId": 21866,
            "speakerName": "绵驮兽警长",
            "text": "说来话长。几位远道而来也不容易，就请随我来酒吧里小坐一下吧。"
          }
        }
      }
    },

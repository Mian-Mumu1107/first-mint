    {
      "subId": "1504110",
      "subQuestName": "与诺奇特梨恶霸对峙",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "150411001"
        ],
        "dialogs": {
          "150411001": {
            "id": "150411001",
            "speakerId": 1008,
            "speakerName": "诺奇特梨恶霸",
            "text": "吼？这就是那几个爱管闲事的异乡人？",
            "nextDialogs": [
              "150411002"
            ]
          },
          "150411002": {
            "id": "150411002",
            "speakerId": 21879,
            "speakerName": "诺奇特梨爪牙",
            "text": "老大！小心啊，他们有枪！",
            "nextDialogs": [
              "150411003"
            ]
          },
          "150411003": {
            "id": "150411003",
            "speakerId": 1008,
            "speakerName": "诺奇特梨恶霸",
            "text": "有杆枪就让你们怕成这个样子，丢不丢人。",
            "nextDialogs": [
              "150411004"
            ]
          },
          "150411004": {
            "id": "150411004",
            "speakerId": 1008,
            "speakerName": "诺奇特梨恶霸",
            "text": "来啊，爱出风头的家伙们，看看我们谁的子弹更快。",
            "nextDialogs": [
              "150411005"
            ]
          },
          "150411005": {
            "id": "150411005",
            "speakerId": 1024,
            "speakerName": "班尼特",
            "text": "那边好大的烟，情况怎么样了？",
            "nextDialogs": [
              "150411006"
            ]
          },
          "150411006": {
            "id": "150411006",
            "speakerId": 1092,
            "speakerName": "恰斯卡",
            "text": "它跑了。",
            "nextDialogs": [
              "150411007"
            ]
          },
          "150411007": {
            "id": "150411007",
            "speakerId": 1087,
            "speakerName": "玛拉妮",
            "text": "从你的枪口下跑了？",
            "nextDialogs": [
              "150411008"
            ]
          },
          "150411008": {
            "id": "150411008",
            "speakerId": 1092,
            "speakerName": "恰斯卡",
            "text": "准确地说，那位老大从一开始就没有攻击的意图。甩下狠话是个制造空隙的障眼法。它想好要跑了。",
            "nextDialogs": [
              "150411009"
            ]
          },
          "150411009": {
            "id": "150411009",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "结果自己还说那种话，丢不丢人。",
            "nextDialogs": [
              "150411010"
            ]
          },
          "150411010": {
            "id": "150411010",
            "speakerId": 1087,
            "speakerName": "玛拉妮",
            "text": "不好…出口被堵住了，恐怕同样是对方的诡计。",
            "nextDialogs": [
              "150411011"
            ]
          },
          "150411011": {
            "id": "150411011",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "那要怎么办？有什么机关吗？",
            "nextDialogs": [
              "150411012"
            ]
          },
          "150411012": {
            "id": "150411012",
            "speakerId": 1024,
            "speakerName": "班尼特",
            "text": "峡谷下方有不少笼子…各位，我们先去救人。"
          }
        }
      }
    },

    {
      "subId": "1504199",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "150419901"
        ],
        "dialogs": {
          "150419901": {
            "id": "150419901",
            "speakerId": 21866,
            "speakerName": "绵驮兽警长",
            "text": "唉，不知英雄什么时候才会回来…",
            "nextDialogs": [
              "150419902"
            ]
          },
          "150419902": {
            "id": "150419902",
            "speakerId": 1024,
            "speakerName": "班尼特",
            "text": "警长，您说的英雄是…",
            "nextDialogs": [
              "150419903"
            ]
          },
          "150419903": {
            "id": "150419903",
            "speakerId": 21866,
            "speakerName": "绵驮兽警长",
            "text": "很久以前，我们镇上生活着一位见义勇为的神枪手。",
            "nextDialogs": [
              "150419904"
            ]
          },
          "150419904": {
            "id": "150419904",
            "speakerId": 21866,
            "speakerName": "绵驮兽警长",
            "text": "他心怀正义，英勇无比，曾帮上小镇许多忙…",
            "nextDialogs": [
              "150419905"
            ]
          },
          "150419905": {
            "id": "150419905",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "啊——真是一群坏家伙，心眼和刺一样多，逃得又那么快！",
            "nextDialogs": [
              "150419906"
            ]
          },
          "150419906": {
            "id": "150419906",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "去那个被炸开的山洞看看吧，希望能有离开这里的线索。",
            "nextDialogs": [
              "150419916"
            ]
          },
          "150419916": {
            "id": "150419916",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "「乔克力老大」往山崖那边逃跑了，别放过它！",
            "nextDialogs": [
              "150419917"
            ]
          },
          "150419917": {
            "id": "150419917",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "其实…我们也做了件好事！至少为小镇排查了隐患！",
            "nextDialogs": [
              "150419918"
            ]
          },
          "150419918": {
            "id": "150419918",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "之后如果再遇到魔物…再消灭就行了！",
            "nextDialogs": [
              "150419919"
            ]
          },
          "150419919": {
            "id": "150419919",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "其实…我们也做了件好事！至少为小镇排查了隐患！",
            "nextDialogs": [
              "150419920"
            ]
          },
          "150419920": {
            "id": "150419920",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "之后如果再遇到魔物…再消灭就行了！"
          }
        }
      }
    }

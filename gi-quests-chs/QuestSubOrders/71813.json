    {
      "subId": "7181302",
      "subQuestName": "与纪芳对话",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "718130201"
        ],
        "dialogs": {
          "718130201": {
            "id": "718130201",
            "speakerId": 1625,
            "speakerName": "纪芳",
            "text": "你好，想要买什么书吗？",
            "nextDialogs": [
              "718130202"
            ]
          },
          "718130202": {
            "id": "718130202",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "我们想要《珠玑宝矿》。",
            "nextDialogs": [
              "718130203"
            ]
          },
          "718130203": {
            "id": "718130203",
            "speakerId": 1625,
            "speakerName": "纪芳",
            "text": "《珠玑宝矿》？这本书我这里可没有…怎么，你要得很急吗？",
            "nextDialogs": [
              "718130204"
            ]
          },
          "718130204": {
            "id": "718130204",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "关于重建群玉阁…",
            "nextDialogs": [
              "718130205"
            ]
          },
          "718130205": {
            "id": "718130205",
            "speakerId": 1625,
            "speakerName": "纪芳",
            "text": "咦？群玉阁要重建了吗？那确实得好好筹备，我想想…",
            "nextDialogs": [
              "718130206"
            ]
          },
          "718130206": {
            "id": "718130206",
            "speakerId": 1625,
            "speakerName": "纪芳",
            "text": "不然，你去找清昼问问吧，他读过很多书，说不定他知道在哪能找到这本《珠玑宝矿》。",
            "nextDialogs": [
              "718130207"
            ]
          },
          "718130207": {
            "id": "718130207",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "我知道了。",
            "nextDialogs": [
              "718130208"
            ]
          },
          "718130208": {
            "id": "718130208",
            "speakerId": 1625,
            "speakerName": "纪芳",
            "text": "清昼我记得经常在望舒客栈待着，你可以去那边找找他。"
          }
        }
      }
    },
    {
      "subId": "7181303",
      "subQuestName": "与清昼对话",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "718130301"
        ],
        "dialogs": {
          "718130301": {
            "id": "718130301",
            "speakerId": 2205,
            "speakerName": "清昼",
            "text": "难写，真是难写…",
            "nextDialogs": [
              "718130302"
            ]
          },
          "718130302": {
            "id": "718130302",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "关于《珠玑宝矿》…",
            "nextDialogs": [
              "718130303"
            ]
          },
          "718130303": {
            "id": "718130303",
            "speakerId": 2205,
            "speakerName": "清昼",
            "text": "《珠玑宝矿》？哦，我记得那本书。",
            "nextDialogs": [
              "718130304"
            ]
          },
          "718130304": {
            "id": "718130304",
            "speakerId": 2205,
            "speakerName": "清昼",
            "text": "我之前为了写一首和商贾之事有关的诗而四处取材，在一个地方偶然读过这本书。",
            "nextDialogs": [
              "718130305"
            ]
          },
          "718130305": {
            "id": "718130305",
            "speakerId": 2205,
            "speakerName": "清昼",
            "text": "那本书里说的东西虽然我有些看不懂，但有些事例对我作诗倒也有所启发。",
            "nextDialogs": [
              "718130306"
            ]
          },
          "718130306": {
            "id": "718130306",
            "speakerId": 2205,
            "speakerName": "清昼",
            "text": "我想想那首诗是什么啊，你稍等…",
            "nextDialogs": [
              "718130307"
            ]
          },
          "718130307": {
            "id": "718130307",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "你还记得那本书在哪里能找到吗？",
            "nextDialogs": [
              "718130308"
            ]
          },
          "718130308": {
            "id": "718130308",
            "speakerId": 2205,
            "speakerName": "清昼",
            "text": "你们要找那本书？那我可不记得在哪能找这本书了…",
            "nextDialogs": [
              "718130309"
            ]
          },
          "718130309": {
            "id": "718130309",
            "speakerId": 2205,
            "speakerName": "清昼",
            "text": "不过，如果你们急着要，我倒是可以直接手写一份给你们。",
            "nextDialogs": [
              "718130312"
            ]
          },
          "718130312": {
            "id": "718130312",
            "speakerId": 2205,
            "speakerName": "清昼",
            "text": "欸，那本书的内容倒也不长，记下来也不难。",
            "nextDialogs": [
              "718130313"
            ]
          },
          "718130313": {
            "id": "718130313",
            "speakerId": 2205,
            "speakerName": "清昼",
            "text": "而且我那时候读那本《珠玑宝矿》的时候，藏书的人压根也不让我借阅出去。",
            "nextDialogs": [
              "718130314"
            ]
          },
          "718130314": {
            "id": "718130314",
            "speakerId": 2205,
            "speakerName": "清昼",
            "text": "但作诗哪是一朝一夕的事…我就把那本书给抄了一份走，因为内容也不太多，我也就差不多背下了。",
            "nextDialogs": [
              "718130315"
            ]
          },
          "718130315": {
            "id": "718130315",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "这就是诗人的实力吗…",
            "nextDialogs": [
              "718130316"
            ]
          },
          "718130316": {
            "id": "718130316",
            "speakerId": 2205,
            "speakerName": "清昼",
            "text": "不值一提，不值一提。不过…我写一份这本书给你，你也帮我个小忙吧。",
            "nextDialogs": [
              "718130317"
            ]
          },
          "718130317": {
            "id": "718130317",
            "speakerId": 2205,
            "speakerName": "清昼",
            "text": "说来有些不好意思，我一直在这取材，却忘了吃饭，现在有些饿了…",
            "nextDialogs": [
              "718130318"
            ]
          },
          "718130318": {
            "id": "718130318",
            "speakerId": 2205,
            "speakerName": "清昼",
            "text": "请你帮我拿一份「扣三丝」过来吧，我也会在这帮你写那本《珠玑宝矿》。",
            "nextDialogs": [
              "718130319"
            ]
          },
          "718130319": {
            "id": "718130319",
            "speakerId": 2205,
            "speakerName": "清昼",
            "text": "等你回来了，我差不多也就写好了。"
          }
        }
      }
    },
    {
      "subId": "7181304",
      "subQuestName": "将一份「美味的扣三丝」带给清昼",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "718130401"
        ],
        "dialogs": {
          "718130401": {
            "id": "718130401",
            "speakerId": 2205,
            "speakerName": "清昼",
            "text": "《珠玑宝矿》…唔，「凡工商万业，如泉如流，起于山岩，终于汪洋…」"
          }
        }
      }
    },
    {
      "subId": "7181305",
      "subQuestName": "与清昼对话",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "718130501"
        ],
        "dialogs": {
          "718130501": {
            "id": "718130501",
            "speakerId": 2205,
            "speakerName": "清昼",
            "text": "「璃月之永固，人世之绸缪，愿据此大计，徐徐而行…」",
            "nextDialogs": [
              "718130502"
            ]
          },
          "718130502": {
            "id": "718130502",
            "speakerId": 2205,
            "speakerName": "清昼",
            "text": "你回来了啊，稍等，还有最后几句…",
            "nextDialogs": [
              "718130503"
            ]
          },
          "718130503": {
            "id": "718130503",
            "speakerId": 2205,
            "speakerName": "清昼",
            "text": "嗯…行了，写完了。",
            "nextDialogs": [
              "718130504"
            ]
          },
          "718130504": {
            "id": "718130504",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "这是「扣三丝」…",
            "nextDialogs": [
              "718130505"
            ]
          },
          "718130505": {
            "id": "718130505",
            "speakerId": 2205,
            "speakerName": "清昼",
            "text": "不急不急，你先看看这本书怎么样，我自认书法尚可，写的字应该是能够入眼的。",
            "nextDialogs": [
              "718130506"
            ]
          },
          "718130506": {
            "id": "718130506",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "这就是诗人的实力吗…",
            "nextDialogs": [
              "718130507"
            ]
          },
          "718130507": {
            "id": "718130507",
            "speakerId": 2205,
            "speakerName": "清昼",
            "text": "哈哈哈，谬赞，谬赞了。这本书给你，可别弄丢了啊。"
          }
        }
      }
    },
    {
      "subId": "7181306",
      "subQuestName": "与路爷对话",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "718130601"
        ],
        "dialogs": {
          "718130601": {
            "id": "718130601",
            "speakerId": 2310,
            "speakerName": "路爷",
            "text": "嗯？你有什么事吗？",
            "nextDialogs": [
              "718130602"
            ]
          },
          "718130602": {
            "id": "718130602",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "我们想要订制一些竹制的小摆件…",
            "nextDialogs": [
              "718130603"
            ]
          },
          "718130603": {
            "id": "718130603",
            "speakerId": 2310,
            "speakerName": "路爷",
            "text": "竹制的小摆件？我倒是也能做，但你这个订单是从哪…",
            "nextDialogs": [
              "718130604"
            ]
          },
          "718130604": {
            "id": "718130604",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "是百闻给的清单…",
            "nextDialogs": [
              "718130605"
            ]
          },
          "718130605": {
            "id": "718130605",
            "speakerId": 2310,
            "speakerName": "路爷",
            "text": "嚯…月海亭那边来的订单啊，行，我尽量加紧做就是。",
            "nextDialogs": [
              "718130606"
            ]
          },
          "718130606": {
            "id": "718130606",
            "speakerId": 2310,
            "speakerName": "路爷",
            "text": "不过，我经常去取材料的竹林那边，最近不知道为什么，突然多了很多林猪。",
            "nextDialogs": [
              "718130607"
            ]
          },
          "718130607": {
            "id": "718130607",
            "speakerId": 2310,
            "speakerName": "路爷",
            "text": "虽然也没什么大影响，但我总得绕着它们去取竹子…",
            "nextDialogs": [
              "718130608"
            ]
          },
          "718130608": {
            "id": "718130608",
            "speakerId": 2310,
            "speakerName": "路爷",
            "text": "要是你们能把那些林猪赶跑的话，我现在就能去取点竹子回来开工了。",
            "nextDialogs": [
              "718130609"
            ]
          },
          "718130609": {
            "id": "718130609",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "交给我吧。",
            "nextDialogs": [
              "718130610"
            ]
          },
          "718130610": {
            "id": "718130610",
            "speakerId": 2310,
            "speakerName": "路爷",
            "text": "那我就在这里等你，你赶跑那些林猪之后，就回来和我说一声吧。"
          }
        }
      }
    },
    {
      "subId": "7181307",
      "subQuestName": "驱赶林猪",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "718130701"
        ],
        "dialogs": {
          "718130701": {
            "id": "718130701",
            "speakerId": 2310,
            "speakerName": "路爷",
            "text": "你把那些林猪都赶跑了？",
            "nextDialogs": [
              "718130702"
            ]
          },
          "718130702": {
            "id": "718130702",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "都赶跑了。",
            "nextDialogs": [
              "718130703"
            ]
          },
          "718130703": {
            "id": "718130703",
            "speakerId": 2310,
            "speakerName": "路爷",
            "text": "那就行了，我等会就去取竹子去，等做好了之后，我直接送去月海亭吧。",
            "nextDialogs": [
              "718130704"
            ]
          },
          "718130704": {
            "id": "718130704",
            "speakerId": 2310,
            "speakerName": "路爷",
            "text": "这单子还挺大的，应该能赚不少了…"
          }
        }
      }
    },
    {
      "subId": "7181308",
      "subQuestName": "驱赶林猪",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "718130801"
        ],
        "dialogs": {
          "718130801": {
            "id": "718130801",
            "speakerId": 10334,
            "speakerName": "百闻",
            "text": "你好，又有什么事吗？",
            "nextDialogs": [
              "718130802"
            ]
          },
          "718130802": {
            "id": "718130802",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "关于筹备的物资…",
            "nextDialogs": [
              "718130803"
            ]
          },
          "718130803": {
            "id": "718130803",
            "speakerId": 10334,
            "speakerName": "百闻",
            "text": "这是…《珠玑宝矿》，你们是从哪里拿到这本书的，我都快找遍了璃月也没找到…",
            "nextDialogs": [
              "718130804"
            ]
          },
          "718130804": {
            "id": "718130804",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "是清昼手抄给我的。",
            "nextDialogs": [
              "718130805"
            ]
          },
          "718130805": {
            "id": "718130805",
            "speakerId": 10334,
            "speakerName": "百闻",
            "text": "是那位诗人？看来他确实名不虚传…",
            "nextDialogs": [
              "718130806"
            ]
          },
          "718130806": {
            "id": "718130806",
            "speakerId": 10334,
            "speakerName": "百闻",
            "text": "谢谢你们帮忙筹备这些东西，等路爷把那些摆件送来了，我也会支付相应的款项。",
            "nextDialogs": [
              "718130807"
            ]
          },
          "718130807": {
            "id": "718130807",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "关于重建群玉阁…",
            "nextDialogs": [
              "718130808"
            ]
          },
          "718130808": {
            "id": "718130808",
            "speakerId": 10334,
            "speakerName": "百闻",
            "text": "重建群玉阁确实已经在计划内了，但要准备的东西，做的工作都还很多。一时半会应该也无法马上建好。",
            "nextDialogs": [
              "718130809"
            ]
          },
          "718130809": {
            "id": "718130809",
            "speakerId": 10334,
            "speakerName": "百闻",
            "text": "而且最大的材料问题，到现在也没找到解决方法，真是愁人…",
            "nextDialogs": [
              "718130810"
            ]
          },
          "718130810": {
            "id": "718130810",
            "speakerId": 10334,
            "speakerName": "百闻",
            "text": "好了，不说这些了，再次感谢你们帮助筹备物资，这些报酬请你们收下，我要接着去工作了。"
          }
        }
      }
    },
    {
      "subId": "7181309",

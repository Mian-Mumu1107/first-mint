    {
      "subId": "7181310",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "718131001"
        ],
        "dialogs": {
          "718131001": {
            "id": "718131001",
            "speakerId": 2205,
            "speakerName": "清昼",
            "text": "「民失其业，无恒产给食，无片瓦遮身，田舍毁弃，尽作劳力，而巨贾厅堂金玉盈门，何道之有？」",
            "nextDialogs": [
              "718131002"
            ]
          },
          "718131002": {
            "id": "718131002",
            "speakerId": 2205,
            "speakerName": "清昼",
            "text": "虽然讲的依然是商贾之道，但细细品读，倒也有几分意思…"
          }
        }
      }
    },

    {
      "subId": "7525707",
      "subQuestName": "(test)隐藏$HIDDEN",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "752570701"
        ],
        "dialogs": {
          "752570701": {
            "id": "752570701",
            "speakerId": 1000,
            "speakerName": "伊斯特莉",
            "text": "哎呀，总算是忙完了。两位客人，多亏有你们帮忙，不然我可能要被投诉了。",
            "nextDialogs": [
              "752570702"
            ]
          },
          "752570702": {
            "id": "752570702",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "不用客气，嘿嘿，我们可是最热心的冒险家。",
            "nextDialogs": [
              "752570703"
            ]
          },
          "752570703": {
            "id": "752570703",
            "speakerId": 1000,
            "speakerName": "伊斯特莉",
            "text": "冒险家吗？那不如我来给你们留一张影吧？把你们热心的身姿记录下来。",
            "nextDialogs": [
              "752570704"
            ]
          },
          "752570704": {
            "id": "752570704",
            "speakerId": 1000,
            "speakerName": "伊斯特莉",
            "text": "来，笑一笑！悠悠纳塔，悠悠夏天！",
            "nextDialogs": [
              "752570705"
            ]
          },
          "752570705": {
            "id": "752570705",
            "speakerId": 1000,
            "speakerName": "伊斯特莉",
            "text": "谢谢你们，这些也请收下吧。"
          }
        }
      }
    },
    {
      "subId": "7525701",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "752570101"
        ],
        "dialogs": {
          "752570101": {
            "id": "752570101",
            "speakerId": 1003,
            "speakerName": "苏玛",
            "text": "年轻人啊，这场地不是好好的吗？为什么不能营业？",
            "nextDialogs": [
              "752570102"
            ]
          },
          "752570102": {
            "id": "752570102",
            "speakerId": 1000,
            "speakerName": "伊斯特莉",
            "text": "真抱歉，客人，本项目的造景助手昨晚喝多了，今天没法来上班，请明天再来吧。",
            "nextDialogs": [
              "752570103"
            ]
          },
          "752570103": {
            "id": "752570103",
            "speakerId": 1003,
            "speakerName": "苏玛",
            "text": "老婆子我年纪大了，明天再走这么远的路过来可能吃不消咯。",
            "nextDialogs": [
              "752570104"
            ]
          },
          "752570104": {
            "id": "752570104",
            "speakerId": 1001,
            "speakerName": "因提",
            "text": "没错，大家明天也有别的安排。",
            "nextDialogs": [
              "752570105"
            ]
          },
          "752570105": {
            "id": "752570105",
            "speakerId": 1000,
            "speakerName": "伊斯特莉",
            "text": "对不起，我们「夏日留影角」的特色就是可以为客人搭建心仪的留影背景。",
            "nextDialogs": [
              "752570106"
            ]
          },
          "752570106": {
            "id": "752570106",
            "speakerId": 1000,
            "speakerName": "伊斯特莉",
            "text": "现在造景助手不在，实在没法进行下去。",
            "nextDialogs": [
              "752570107"
            ]
          },
          "752570107": {
            "id": "752570107",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "需要帮忙吗？",
            "nextDialogs": [
              "752570108"
            ]
          },
          "752570108": {
            "id": "752570108",
            "speakerId": 1000,
            "speakerName": "伊斯特莉",
            "text": "欸？你们两位愿意来帮忙吗？我真的很需要。内容也不复杂，只要按照各位客人的要求布置留影的背景就可以了。"
          }
        }
      }
    },
    {
      "subId": "7525703",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "752570301"
        ],
        "dialogs": {
          "752570301": {
            "id": "752570301",
            "speakerId": 1000,
            "speakerName": "伊斯特莉",
            "text": "上一场拍得很好，下面是这位愚人众的大哥，您想拍点什么？",
            "nextDialogs": [
              "752570302"
            ]
          },
          "752570302": {
            "id": "752570302",
            "speakerId": 1002,
            "speakerName": "韦涅季克特",
            "text": "请把我拍成神枪手的样子，一看就是百发百中的那种。",
            "nextDialogs": [
              "752570303"
            ]
          },
          "752570303": {
            "id": "752570303",
            "speakerId": 1002,
            "speakerName": "韦涅季克特",
            "text": "这样我就不用为连队的射击比赛排名倒数而烦恼了。",
            "nextDialogs": [
              "752570304"
            ]
          },
          "752570304": {
            "id": "752570304",
            "speakerId": 1000,
            "speakerName": "伊斯特莉",
            "text": "没问题，那我们开始吧。"
          }
        }
      }
    },
    {
      "subId": "7525708",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "752570801"
        ],
        "dialogs": {
          "752570801": {
            "id": "752570801",
            "speakerId": 1000,
            "speakerName": "伊斯特莉",
            "text": "上一场拍得很好，最后是这位翩翩公子，您想拍点什么？",
            "nextDialogs": [
              "752570802"
            ]
          },
          "752570802": {
            "id": "752570802",
            "speakerId": 1001,
            "speakerName": "因提",
            "text": "说得不错，本人出生至今，向来将仪态与气质放在人生的首要位置。",
            "nextDialogs": [
              "752570803"
            ]
          },
          "752570803": {
            "id": "752570803",
            "speakerId": 1001,
            "speakerName": "因提",
            "text": "人无仪态，则不优雅；无气质，则不富贵。懂我的要求吗？",
            "nextDialogs": [
              "752570804"
            ]
          },
          "752570804": {
            "id": "752570804",
            "speakerId": 1000,
            "speakerName": "伊斯特莉",
            "text": "唔…让我思考思考…嗯，我们开始吧！"
          }
        }
      }
    },

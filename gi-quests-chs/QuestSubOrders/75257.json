  "subQuests": [
    {
      "subId": "7525701",
      "subQuestName": "(test)隐藏$HIDDEN",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "752570201"
        ],
        "dialogs": {
          "752570201": {
            "id": "752570201",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "听上去挺有趣的。",
            "nextDialogs": [
              "752570202"
            ]
          },
          "752570202": {
            "id": "752570202",
            "speakerId": 1000,
            "speakerName": "伊斯特莉",
            "text": "太好了！那么几位客人，谁先来？",
            "nextDialogs": [
              "752570203"
            ]
          },
          "752570203": {
            "id": "752570203",
            "speakerId": 1001,
            "speakerName": "因提",
            "text": "本人建议，女士优先。",
            "nextDialogs": [
              "752570204"
            ]
          },
          "752570204": {
            "id": "752570204",
            "speakerId": 1002,
            "speakerName": "韦涅季克特",
            "text": "没意见。",
            "nextDialogs": [
              "752570205"
            ]
          },
          "752570205": {
            "id": "752570205",
            "speakerId": 1003,
            "speakerName": "苏玛",
            "text": "哎呀，多么绅士的小伙子啊，我就想和你们这种年轻人合影。",
            "nextDialogs": [
              "752570206"
            ]
          },
          "752570206": {
            "id": "752570206",
            "speakerId": 1001,
            "speakerName": "因提",
            "text": "欸？也…也不是不行。",
            "nextDialogs": [
              "752570207"
            ]
          },
          "752570207": {
            "id": "752570207",
            "speakerId": 1002,
            "speakerName": "韦涅季克特",
            "text": "咳咳，没意见。",
            "nextDialogs": [
              "752570208"
            ]
          },
          "752570208": {
            "id": "752570208",
            "speakerId": 1003,
            "speakerName": "苏玛",
            "text": "嗯…不，还不够，再来三个小伙子吧，应该可以办到吧？",
            "nextDialogs": [
              "752570209"
            ]
          },
          "752570209": {
            "id": "752570209",
            "speakerId": 1003,
            "speakerName": "苏玛",
            "text": "唔…最好还能来点烟花，我年轻的时候，最喜欢那样的氛围了。",
            "nextDialogs": [
              "752570210"
            ]
          },
          "752570210": {
            "id": "752570210",
            "speakerId": 1000,
            "speakerName": "伊斯特莉",
            "text": "没问题，那我们开始吧。"
          }
        }
      }
    },

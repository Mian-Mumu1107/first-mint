          "740310101"
        ],
        "dialogs": {
          "740310101": {
            "id": "740310101",
            "speakerId": 1000,
            "speakerName": "尼扎米",
            "text": "年轻的战士，和我比试一下吧！",
            "nextDialogs": [
              "740310102"
            ]
          },
          "740310102": {
            "id": "740310102",
            "speakerId": 1002,
            "speakerName": "派蒙",
            "text": "好唐突！",
            "nextDialogs": [
              "740310103"
            ]
          },
          "740310103": {
            "id": "740310103",
            "speakerId": 1000,
            "speakerName": "尼扎米",
            "text": "#随你怎么说。金发的{M#小弟}{F#妹妹}，我一眼就看出，你也是久经历练的强者。",
            "nextDialogs": [
              "740310104"
            ]
          },
          "740310104": {
            "id": "740310104",
            "speakerId": 1000,
            "speakerName": "尼扎米",
            "text": "这阵子没人陪我比试，我可是无聊得很哪。你要是肯陪我练练，我出特许券！之前从罗西莫夫那儿赢了不少，正愁没处花呢。",
            "nextDialogs": [
              "740310105"
            ]
          },
          "740310105": {
            "id": "740310105",
            "speakerId": 1000,
            "speakerName": "尼扎米",
            "text": "怎么样，和我比试一下吧！"
          }
        }
      }
    },
    {

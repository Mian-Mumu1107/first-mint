          "740318102": {
            "id": "740318102",
            "speakerId": 1000,
            "speakerName": "尼扎米",
            "text": "你奉行的是以暴止暴的和平主义？嗯，人各有志。",
            "nextDialogs": [
              "740318103"
            ]
          },
          "740318103": {
            "id": "740318103",
            "speakerId": 1000,
            "speakerName": "尼扎米",
            "text": "但这不是争斗，是切磋。切磋的目的是为了更好地守护和平，你是和平主义者，那就更应该和我切磋一下了！",
            "nextDialogs": [
              "740318104"
            ]
          },
          "740318104": {
            "id": "740318104",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "有道理，我们去切磋切磋！",
            "nextDialogs": [
              "740318105"
            ]
          },
          "740318105": {
            "id": "740318105",
            "speakerId": 1000,
            "speakerName": "尼扎米",
            "text": "哈哈，好！",
            "nextDialogs": [
              "740318106"
            ]
          },
          "740318106": {
            "id": "740318106",
            "speakerId": 1000,
            "speakerName": "尼扎米",
            "text": "这里不方便，我们去宽敞地方！"
          }
        }

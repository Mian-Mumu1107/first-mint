    {
      "subId": "7010214",
      "subQuestName": "再寻找三枚奇异的「牙齿」",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "701021401"
        ],
        "dialogs": {
          "701021401": {
            "id": "701021401",
            "speakerId": 1001,
            "speakerName": "乌尔班",
            "text": "关于「龙牙」…",
            "nextDialogs": [
              "701021402"
            ]
          },
          "701021402": {
            "id": "701021402",
            "speakerId": 1001,
            "speakerName": "乌尔班",
            "text": "虽然不知道这东西是不是龙牙，但它的质量是很不错的，只要数量足够，再加上星银矿石，做一柄武器应该没问题。",
            "nextDialogs": [
              "701021404"
            ]
          },
          "701021404": {
            "id": "701021404",
            "speakerId": 1001,
            "speakerName": "乌尔班",
            "text": "搜集齐全了之后，就尽快拿来给我吧。"
          }
        }
      }
    },

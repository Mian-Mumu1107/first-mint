    {
      "subId": "7010209",
      "subQuestName": "再寻找三枚奇异的「牙齿」",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "701020901"
        ],
        "dialogs": {
          "701020901": {
            "id": "701020901",
            "speakerId": 1001,
            "speakerName": "乌尔班",
            "text": "做好了！哈哈哈，来，拿好了，是不是很有份量感？",
            "nextDialogs": [
              "701020902"
            ]
          },
          "701020902": {
            "id": "701020902",
            "speakerId": 1000,
            "speakerName": "玩家",
            "text": "我要付多少钱？",
            "nextDialogs": [
              "701020903"
            ]
          },
          "701020903": {
            "id": "701020903",
            "speakerId": 1001,
            "speakerName": "乌尔班",
            "text": "钱？不需要，你能拿来这些材料让我制作武器，我就已经很满足了，你不需要再付钱给我。",
            "nextDialogs": [
              "701020904"
            ]
          },
          "701020904": {
            "id": "701020904",
            "speakerId": 1001,
            "speakerName": "乌尔班",
            "text": "好了，拿着这把武器去冒险吧，你可要好好珍惜它啊。"
          }
        }
      }
    },
    {
      "subId": "7010210",
      "subQuestName": "再寻找三枚奇异的「牙齿」",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "701021001"
        ],
        "dialogs": {
          "701021001": {
            "id": "701021001",
            "speakerId": 1002,
            "speakerName": "派蒙",
            "text": "这枚龙牙…看上去有些不一样了。而且，它给我的感觉也更不好了…",
            "nextDialogs": [
              "701021002"
            ]
          },
          "701021002": {
            "id": "701021002",
            "speakerId": 1002,
            "speakerName": "派蒙",
            "text": "我们快点把它带去给乌尔班吧。"
          }
        }
      }
    },
    {
      "subId": "7010211",
      "subQuestName": "再寻找三枚奇异的「牙齿」$HIDDEN",

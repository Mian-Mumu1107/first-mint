  "subQuests": [
    {
      "subId": "2501901",
      "subQuestName": "",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "250190101"
        ],
        "dialogs": {
          "250190101": {
            "id": "250190101",
            "speakerId": 14264,
            "speakerName": "格里斯潘",
            "text": "这是…烬芯花啊。不错，不错，一定能派上大用场。",
            "nextDialogs": [
              "250190102"
            ]
          },
          "250190102": {
            "id": "250190102",
            "speakerId": 14265,
            "speakerName": "格罗贝尔",
            "text": "喵喵？喵？",
            "nextDialogs": [
              "250190103"
            ]
          },
          "250190103": {
            "id": "250190103",
            "speakerId": 14264,
            "speakerName": "格里斯潘",
            "text": "会长，这朵花恐怕没法在枫丹养活啊。",
            "nextDialogs": [
              "250190104"
            ]
          },
          "250190104": {
            "id": "250190104",
            "speakerId": 14264,
            "speakerName": "格里斯潘",
            "text": "如果您坚持的话…唔，做成书签怎么样？"
          }
        }
      }
    },
    {
      "subId": "2501902",
      "subQuestName": "(test)选择缴纳素材$HIDDEN",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "250192001"
        ],
        "dialogs": {
          "250192001": {
            "id": "250192001",
            "speakerId": 14264,
            "speakerName": "格里斯潘",
            "text": "太好了！那就拜托您了，我会在这里继续完善提取燃素的计划，还有许多仪器需要重新设计。",
            "nextDialogs": [
              "250192002"
            ]
          },
          "250192002": {
            "id": "250192002",
            "speakerId": 14264,
            "speakerName": "格里斯潘",
            "text": "但是，这一切都是值得的！只要能够提取出我想要的东西，我就能回镇子，舒舒服服地继续研究了。"
          }
        }
      }
    },
    {
      "subId": "2501903",
      "subQuestName": "(test)督促自己动手$HIDDEN",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "250190301"
        ],
        "dialogs": {
          "250190301": {
            "id": "250190301",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "咱们一起去吧。",
            "nextDialogs": [
              "250190302"
            ]
          },
          "250190302": {
            "id": "250190302",
            "speakerId": 14264,
            "speakerName": "格里斯潘",
            "text": "一起？那就更好了！我早就想要实地考察了，有您在旁边，我就没什么好怕的了。",
            "nextDialogs": [
              "250190303"
            ]
          },
          "250190303": {
            "id": "250190303",
            "speakerId": 14264,
            "speakerName": "格里斯潘",
            "text": "#来吧，咱们这就出发。亲爱的{NICKNAME}{M#先生}{F#小姐}！",
            "nextDialogs": [
              "250190304"
            ]
          },
          "250190304": {
            "id": "250190304",
            "speakerId": 14264,
            "speakerName": "格里斯潘",
            "text": "#至于会长您…就留在这里吧。请您放心，有亲爱的{NICKNAME}{M#先生}{F#小姐}在，我的人身安全绝对有保障！",
            "nextDialogs": [
              "250190305"
            ]
          },
          "250190305": {
            "id": "250190305",
            "speakerId": 14265,
            "speakerName": "格罗贝尔",
            "text": "喵…喵喵…喵…",
            "nextDialogs": [
              "250190306"
            ]
          },
          "250190306": {
            "id": "250190306",
            "speakerId": 14264,
            "speakerName": "格里斯潘",
            "text": "呃…差点忘了，我把考察地点先给您标在地图上，那边的烛伞蘑菇可好了！"
          }
        }
      }
    },
    {
      "subId": "2501904",
      "subQuestName": "与格里斯潘对话",

    {
      "subId": "2501911",
      "subQuestName": "与格里斯潘对话",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "250192103"
        ],
        "dialogs": {
          "250192103": {
            "id": "250192103",
            "speakerId": 14264,
            "speakerName": "格里斯潘",
            "text": "万分感谢，等我的研究成功后，我愿意请您第一个来体验「热能催眠术」。",
            "nextDialogs": [
              "250192104"
            ]
          },
          "250192104": {
            "id": "250192104",
            "speakerId": 14265,
            "speakerName": "格罗贝尔",
            "text": "喵！喵喵，喵！",
            "nextDialogs": [
              "250192105"
            ]
          },
          "250192105": {
            "id": "250192105",
            "speakerId": 14264,
            "speakerName": "格里斯潘",
            "text": "会长，您怎么能这么说？我的「热能催眠术」绝对安全！没有任何副作用！",
            "nextDialogs": [
              "250192106"
            ]
          },
          "250192106": {
            "id": "250192106",
            "speakerId": 14264,
            "speakerName": "格里斯潘",
            "text": "#为了良好的睡眠和灼热的燃素，{NICKNAME}{M#先生}{F#小姐}，万事拜托了。"
          }
        }
      }
    },
    {
      "subId": "2501905",
      "subQuestName": "将烛伞蘑菇或烬芯花交给格里斯潘",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "250190501"
        ],
        "dialogs": {
          "250190501": {
            "id": "250190501",
            "speakerId": 14265,
            "speakerName": "格罗贝尔",
            "text": "喵…喵喵…喵…"
          }
        }
      }
    },
    {
      "subId": "2501913",
      "subQuestName": "将烛伞蘑菇或烬芯花交给格里斯潘",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "250191301"
        ],
        "dialogs": {
          "250191301": {
            "id": "250191301",
            "speakerId": 14264,
            "speakerName": "格里斯潘",
            "text": "#亲爱的{NICKNAME}{M#先生}{F#小姐}，咱们又见面了。",
            "nextDialogs": [
              "250191302"
            ]
          },
          "250191302": {
            "id": "250191302",
            "speakerId": 14264,
            "speakerName": "格里斯潘",
            "text": "上次可多亏了您帮忙，我的研究又前进了一大步。",
            "nextDialogs": [
              "250191303"
            ]
          },
          "250191303": {
            "id": "250191303",
            "speakerId": 14264,
            "speakerName": "格里斯潘",
            "text": "按照这种势头，我很快就能达到预定目标了！",
            "nextDialogs": [
              "250191305",
              "250191316"
            ]
          },
          "250191305": {
            "id": "250191305",
            "speakerId": 14264,
            "speakerName": "格里斯潘",
            "text": "我没向您介绍？天哪，瞧瞧我这个脑袋，让我简单为您…",
            "nextDialogs": [
              "250191306"
            ]
          },
          "250191306": {
            "id": "250191306",
            "speakerId": 14265,
            "speakerName": "格罗贝尔",
            "text": "喵！喵喵喵喵。喵喵！",
            "nextDialogs": [
              "250191307"
            ]
          },
          "250191307": {
            "id": "250191307",
            "speakerId": 14264,
            "speakerName": "格里斯潘",
            "text": "咳，您说得对，会长。我会以最简短的方式叙述的。",
            "nextDialogs": [
              "250191308"
            ]
          },
          "250191308": {
            "id": "250191308",
            "speakerId": 14264,
            "speakerName": "格里斯潘",
            "text": "简单来说，我之所以想要搜集燃素。是想要用「热能」来进行「催眠」。",
            "nextDialogs": [
              "250191309"
            ]
          },
          "250191309": {
            "id": "250191309",
            "speakerId": 14264,
            "speakerName": "格里斯潘",
            "text": "我的催眠装置不在身边…但请您想象一个半人高，能容人坐在里面的箱子。",
            "nextDialogs": [
              "250191310"
            ]
          },
          "250191310": {
            "id": "250191310",
            "speakerId": 14264,
            "speakerName": "格里斯潘",
            "text": "这个箱子里有一个蒸汽装置，可以不断产生热气，将箱内的温度始终保持在一个特定数值上。",
            "nextDialogs": [
              "250191311"
            ]
          },
          "250191311": {
            "id": "250191311",
            "speakerId": 14264,
            "speakerName": "格里斯潘",
            "text": "被催眠者坐在里面，露出脑袋，身体则在箱子里被加热…我相信，这种方式能让催眠术更快起效，催眠效果也更好！",
            "nextDialogs": [
              "250191312"
            ]
          },
          "250191312": {
            "id": "250191312",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "你这纯粹是想把人热晕了！",
            "nextDialogs": [
              "250191313"
            ]
          },
          "250191313": {
            "id": "250191313",
            "speakerId": 14264,
            "speakerName": "格里斯潘",
            "text": "您说得倒也有几分道理。但咱们对于「晕」的定义可能不太一样…",
            "nextDialogs": [
              "250191314"
            ]
          },
          "250191314": {
            "id": "250191314",
            "speakerId": 14264,
            "speakerName": "格里斯潘",
            "text": "但现在，咱们还是先放下这些细枝末节吧，我依然想要请您帮忙。",
            "nextDialogs": [
              "250191317"
            ]
          },
          "250191317": {
            "id": "250191317",
            "speakerId": 14264,
            "speakerName": "格里斯潘",
            "text": "还是和之前一样，我想要请您去搜集带有「燃素」的东西。",
            "nextDialogs": [
              "250191318"
            ]
          },
          "250191318": {
            "id": "250191318",
            "speakerId": 14264,
            "speakerName": "格里斯潘",
            "text": "我想想…唔，还是请您拿些「烬芯花」来吧，这种植物里，确实含有不少燃素。",
            "nextDialogs": [
              "250191319"
            ]
          },
          "250191319": {
            "id": "250191319",
            "speakerId": 14264,
            "speakerName": "格里斯潘",
            "text": "当然，「烛伞蘑菇」也依然是我的重要实验材料。您看…"
          },
          "250191316": {
            "id": "250191316",
            "speakerId": 14264,
            "speakerName": "格里斯潘",
            "text": "#敏锐的{M#先生}{F#小姐}！我就知道您是一个容易合作的好人。"
          }
        }
      }
    },
    {
      "subId": "2501906",
      "subQuestName": "与格里斯潘对话",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "250192401"
        ],
        "dialogs": {
          "250192401": {
            "id": "250192401",
            "speakerId": 14264,
            "speakerName": "格里斯潘",
            "text": "#材料已经足够我再一次开展实验了，再次感谢您，{NICKNAME}{M#先生}{F#小姐}。",
            "nextDialogs": [
              "250192402"
            ]
          },
          "250192402": {
            "id": "250192402",
            "speakerId": 14264,
            "speakerName": "格里斯潘",
            "text": "这些是报酬，请您收下吧。",
            "nextDialogs": [
              "250192403"
            ]
          },
          "250192403": {
            "id": "250192403",
            "speakerId": 14265,
            "speakerName": "格罗贝尔",
            "text": "喵，喵喵，喵。",
            "nextDialogs": [
              "250192404"
            ]
          },
          "250192404": {
            "id": "250192404",
            "speakerId": 14264,
            "speakerName": "格里斯潘",
            "text": "会长也在对您表达感谢。等研究成功后，我愿意把您的名字刻在第一台「热能催眠台」上。",
            "nextDialogs": [
              "250192405"
            ]
          },
          "250192405": {
            "id": "250192405",
            "speakerId": 14264,
            "speakerName": "格里斯潘",
            "text": "好啦！接下来就是实操环节了，在哪里实操比较好呢…"
          }
        }
      }
    },
    {
      "subId": "2501910",

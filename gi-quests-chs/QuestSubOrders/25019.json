    {
      "subId": "2501908",
      "subQuestName": "打倒「秘源机兵」",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "250190801"
        ],
        "dialogs": {
          "250190801": {
            "id": "250190801",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "#我是{NICKNAME}。"
          }
        }
      }
    },
    {
      "subId": "2501909",
      "subQuestName": "与格里斯潘对话",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "250190901"
        ],
        "dialogs": {
          "250190901": {
            "id": "250190901",
            "speakerId": 14264,
            "speakerName": "格里斯潘",
            "text": "#多谢您搭救，{NICKNAME}{M#先生}{F#小姐}。",
            "nextDialogs": [
              "250190902"
            ]
          },
          "250190902": {
            "id": "250190902",
            "speakerId": 14264,
            "speakerName": "格里斯潘",
            "text": "您瞧瞧，这可真是一场惊心动魄的冒险啊。还好我说服会长，让它留在了部族里。",
            "nextDialogs": [
              "250190903"
            ]
          },
          "250190903": {
            "id": "250190903",
            "speakerId": 14264,
            "speakerName": "格里斯潘",
            "text": "会长最不喜欢的就是这种不可控的突发事件，我可不想被它教训半天。",
            "nextDialogs": [
              "250190904"
            ]
          },
          "250190904": {
            "id": "250190904",
            "speakerId": 14264,
            "speakerName": "格里斯潘",
            "text": "不过，从结果上来说，我还是采到了足够的材料，一切皆大欢喜。",
            "nextDialogs": [
              "250190905"
            ]
          },
          "250190905": {
            "id": "250190905",
            "speakerId": 14264,
            "speakerName": "格里斯潘",
            "text": "#这些东西给你，{NICKNAME}{M#先生}{F#小姐}，再次感谢您的帮助。",
            "nextDialogs": [
              "250190906"
            ]
          },
          "250190906": {
            "id": "250190906",
            "speakerId": 14264,
            "speakerName": "格里斯潘",
            "text": "等研究成功后，我愿意请您第一个来体验「热能催眠术」。"
          }
        }
      }
    },
    {
      "subId": "2501902",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "250190201"
        ],
        "dialogs": {
          "250190201": {
            "id": "250190201",
            "speakerId": 14265,
            "speakerName": "格罗贝尔",
            "text": "喵，喵喵喵，喵喵喵，喵。",
            "nextDialogs": [
              "250190202"
            ]
          },
          "250190202": {
            "id": "250190202",
            "speakerId": 14264,
            "speakerName": "格里斯潘",
            "text": "没问题，会长，我会简短介绍的…您就原谅我这张嘴吧，它总是停不下来，我也没有另一张嘴训斥它啊。",
            "nextDialogs": [
              "250190203"
            ]
          },
          "250190203": {
            "id": "250190203",
            "speakerId": 14264,
            "speakerName": "格里斯潘",
            "text": "#简单来说，{NICKNAME}，我想要请您去搜集带有「燃素」的东西。",
            "nextDialogs": [
              "250190204"
            ]
          },
          "250190204": {
            "id": "250190204",
            "speakerId": 14264,
            "speakerName": "格里斯潘",
            "text": "让我想想…呃，我一直在用「烛伞蘑菇」来提取燃素，就请您帮我找些「烛伞蘑菇」来吧。",
            "nextDialogs": [
              "250190206"
            ]
          },
          "250190206": {
            "id": "250190206",
            "speakerId": 14264,
            "speakerName": "格里斯潘",
            "text": "不过，我听说「烬芯花」里也有不少燃素…如果您能把它拿来给我的话，也不错！",
            "nextDialogs": [
              "250190205"
            ]
          },
          "250190205": {
            "id": "250190205",
            "speakerId": 14264,
            "speakerName": "格里斯潘",
            "text": "只要提取到足够的燃素，我就可以在此开始研究了。"
          }
        }
      }
    },
    {
      "subId": "2501904",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "250190401"
        ],
        "dialogs": {
          "250190401": {
            "id": "250190401",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "#我是{NICKNAME}。",
            "nextDialogs": [
              "250190403"
            ]
          },
          "250190403": {
            "id": "250190403",
            "speakerId": 14264,
            "speakerName": "格里斯潘",
            "text": "嗬！您可是鼎鼎大名啊，实在幸会！",
            "nextDialogs": [
              "250190404"
            ]
          },
          "250190404": {
            "id": "250190404",
            "speakerId": 14265,
            "speakerName": "格罗贝尔",
            "text": "喵，喵喵。",
            "nextDialogs": [
              "250190405"
            ]
          },
          "250190405": {
            "id": "250190405",
            "speakerId": 14264,
            "speakerName": "格里斯潘",
            "text": "会长也向您问好。要是咱们在佩特莉可镇，我必然会请您喝一杯好茶。",
            "nextDialogs": [
              "250190406"
            ]
          },
          "250190406": {
            "id": "250190406",
            "speakerId": 14264,
            "speakerName": "格里斯潘",
            "text": "但现在…哈哈哈，我既找不到茶，也谈不上好了。",
            "nextDialogs": [
              "250190407"
            ]
          },
          "250190407": {
            "id": "250190407",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "唔？你们遇见什么事情了吗？看你满头大汗的…",
            "nextDialogs": [
              "250190408"
            ]
          },
          "250190408": {
            "id": "250190408",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "纳塔很热，可以理解。",
            "nextDialogs": [
              "250190409"
            ]
          },
          "250190409": {
            "id": "250190409",
            "speakerId": 14264,
            "speakerName": "格里斯潘",
            "text": "#哈！让人愉快的{M#先生}{F#小姐}。从我到纳塔开始，您是唯一一个和我对上幽默感的人。",
            "nextDialogs": [
              "250190410"
            ]
          },
          "250190410": {
            "id": "250190410",
            "speakerId": 14264,
            "speakerName": "格里斯潘",
            "text": "但纳塔的热度也比不上我内心的焦急。唉，怎么事情全都凑到一块了…",
            "nextDialogs": [
              "250190411"
            ]
          },
          "250190411": {
            "id": "250190411",
            "speakerId": 14264,
            "speakerName": "格里斯潘",
            "text": "不仅没有搜集到足够多的燃素，就连镇子也失去了消息。",
            "nextDialogs": [
              "250190412"
            ]
          },
          "250190412": {
            "id": "250190412",
            "speakerId": 14264,
            "speakerName": "格里斯潘",
            "text": "#亲爱的{NICKNAME}，我知道初次见面就委人任务，实在不算礼貌。",
            "nextDialogs": [
              "250190413"
            ]
          },
          "250190413": {
            "id": "250190413",
            "speakerId": 14264,
            "speakerName": "格里斯潘",
            "text": "但我真的很需要一个靠谱的人…您无疑是最佳人选了。"
          }
        }
      }
    },
    {
      "subId": "2501906",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "250190601"
        ],
        "dialogs": {
          "250190601": {
            "id": "250190601",
            "speakerId": 14264,
            "speakerName": "格里斯潘",
            "text": "喔！这是烛伞蘑菇啊！好，太好了！",
            "nextDialogs": [
              "250190602"
            ]
          },
          "250190602": {
            "id": "250190602",
            "speakerId": 14265,
            "speakerName": "格罗贝尔",
            "text": "喵，喵…喵喵？",
            "nextDialogs": [
              "250190603"
            ]
          },
          "250190603": {
            "id": "250190603",
            "speakerId": 14264,
            "speakerName": "格里斯潘",
            "text": "放心吧会长，我不会吃这些东西的。呃…至少在处理好之前，我是不会吃的。"
          }
        }
      }
    },
    {
      "subId": "2501907",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "250190701"
        ],
        "dialogs": {
          "250190701": {
            "id": "250190701",
            "speakerId": 14264,
            "speakerName": "格里斯潘",
            "text": "这地方确实足够火热了…会长，您感觉还好吗？",
            "nextDialogs": [
              "250190702"
            ]
          },
          "250190702": {
            "id": "250190702",
            "speakerId": 14265,
            "speakerName": "格罗贝尔",
            "text": "喵。",
            "nextDialogs": [
              "250190703"
            ]
          },
          "250190703": {
            "id": "250190703",
            "speakerId": 14264,
            "speakerName": "格里斯潘",
            "text": "抱歉，会长，埃斯特和梅康顿兄弟还没回信。",
            "nextDialogs": [
              "250190704"
            ]
          },
          "250190704": {
            "id": "250190704",
            "speakerId": 14264,
            "speakerName": "格里斯潘",
            "text": "见鬼…镇子到底出了什么事…现在也没办法马上赶回去…",
            "nextDialogs": [
              "250190705"
            ]
          },
          "250190705": {
            "id": "250190705",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "你看着不像纳塔人。",
            "nextDialogs": [
              "250190706"
            ]
          },
          "250190706": {
            "id": "250190706",
            "speakerId": 14264,
            "speakerName": "格里斯潘",
            "text": "您看着倒也像是个外乡人呐。向您问好，我是格里斯潘，枫丹空想俱乐部的会员。",
            "nextDialogs": [
              "250190707"
            ]
          },
          "250190707": {
            "id": "250190707",
            "speakerId": 14264,
            "speakerName": "格里斯潘",
            "text": "这位则是咱们俱乐部的会长…部长？呃，总之是领头的，格罗贝尔女士。"
          }
        }
      }
    },
    {
      "subId": "2501910",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "250191001"
        ],
        "dialogs": {
          "250191001": {
            "id": "250191001",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "这位是派蒙。"
          }
        }
      }
    },
    {
      "subId": "2501912",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "250191201"
        ],
        "dialogs": {
          "250191201": {
            "id": "250191201",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "你是空想俱乐部的人？",
            "nextDialogs": [
              "250191202"
            ]
          },
          "250191202": {
            "id": "250191202",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "咦？等一下，我们之前就听埃斯特先生他们提起过格里斯潘这个名字…",
            "nextDialogs": [
              "250191203"
            ]
          },
          "250191203": {
            "id": "250191203",
            "speakerId": 14264,
            "speakerName": "格里斯潘",
            "text": "您去过俱乐部？露景泉在上，我总算撞上了好运！",
            "nextDialogs": [
              "250191204"
            ]
          },
          "250191204": {
            "id": "250191204",
            "speakerId": 14264,
            "speakerName": "格里斯潘",
            "text": "您知道俱乐部出了什么事吗？我已经连着寄去了好几封信，但就是没人回我！",
            "nextDialogs": [
              "250191216"
            ]
          },
          "250191216": {
            "id": "250191216",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "关于佩特莉可镇的事…",
            "nextDialogs": [
              "250191206"
            ]
          },
          "250191206": {
            "id": "250191206",
            "speakerId": 1003,
            "speakerName": "Black Screen",
            "text": "向格里斯潘讲述佩特莉可镇所发生的事…",
            "nextDialogs": [
              "250191207"
            ]
          },
          "250191207": {
            "id": "250191207",
            "speakerId": 14264,
            "speakerName": "格里斯潘",
            "text": "喔，噢，嗬…真是让人，震惊。",
            "nextDialogs": [
              "250191208"
            ]
          },
          "250191208": {
            "id": "250191208",
            "speakerId": 14265,
            "speakerName": "格罗贝尔",
            "text": "喵…喵喵。喵。",
            "nextDialogs": [
              "250191209"
            ]
          },
          "250191209": {
            "id": "250191209",
            "speakerId": 14264,
            "speakerName": "格里斯潘",
            "text": "没错，会长。我真的被震惊了。",
            "nextDialogs": [
              "250191215"
            ]
          },
          "250191215": {
            "id": "250191215",
            "speakerId": 14264,
            "speakerName": "格里斯潘",
            "text": "我真不敢相信，我居然错过了这么一场超级大催眠。天哪！看在露景泉的份上！",
            "nextDialogs": [
              "250191211"
            ]
          },
          "250191211": {
            "id": "250191211",
            "speakerId": 14264,
            "speakerName": "格里斯潘",
            "text": "我要是在镇子上，肯定能搜集到一大堆可用的实验记录！",
            "nextDialogs": [
              "250191212"
            ]
          },
          "250191212": {
            "id": "250191212",
            "speakerId": 14264,
            "speakerName": "格里斯潘",
            "text": "会长，看来咱们得尽快结束研究，回去俱乐部看看情况。",
            "nextDialogs": [
              "250191213"
            ]
          },
          "250191213": {
            "id": "250191213",
            "speakerId": 14264,
            "speakerName": "格里斯潘",
            "text": "#咳，抱歉，{NICKNAME}。我知道初次见面就委人任务，实在不算礼貌。",
            "nextDialogs": [
              "250191214"
            ]
          },
          "250191214": {
            "id": "250191214",
            "speakerId": 14264,
            "speakerName": "格里斯潘",
            "text": "但我真的很需要一个靠谱的人…您无疑是最佳人选了。"
          }
        }
      }
    },
    {
      "subId": "2501914",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "250191401"
        ],
        "dialogs": {
          "250191401": {
            "id": "250191401",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "两种都可以对吧？"
          }
        }
      }
    },
    {
      "subId": "2501915",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "250191501"
        ],
        "dialogs": {
          "250191501": {
            "id": "250191501",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "你搜集多少了？",
            "nextDialogs": [
              "250191502"
            ]
          },
          "250191502": {
            "id": "250191502",
            "speakerId": 14264,
            "speakerName": "格里斯潘",
            "text": "我？哈哈哈哈…不客气地说，我刚刚有了一个良好的开始。",
            "nextDialogs": [
              "250191503"
            ]
          },
          "250191503": {
            "id": "250191503",
            "speakerId": 14264,
            "speakerName": "格里斯潘",
            "text": "唉，我也没办法啊！纳塔的野外全都是那些不听人说话的龙。",
            "nextDialogs": [
              "250191504"
            ]
          },
          "250191504": {
            "id": "250191504",
            "speakerId": 14264,
            "speakerName": "格里斯潘",
            "text": "我能让机关远程停机，也知道怎么让失控的机关失能…但真的拿龙没办法啊！",
            "nextDialogs": [
              "250191505"
            ]
          },
          "250191505": {
            "id": "250191505",
            "speakerId": 14265,
            "speakerName": "格罗贝尔",
            "text": "喵喵。喵…"
          }
        }
      }
    },
    {
      "subId": "2501916",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "250191601"
        ],
        "dialogs": {
          "250191601": {
            "id": "250191601",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "纳塔也有其他冒险家。",
            "nextDialogs": [
              "250191602"
            ]
          },
          "250191602": {
            "id": "250191602",
            "speakerId": 14264,
            "speakerName": "格里斯潘",
            "text": "我…我无意冒犯。但我实在不擅长应付纳塔的好先生和好小姐们。",
            "nextDialogs": [
              "250191603"
            ]
          },
          "250191603": {
            "id": "250191603",
            "speakerId": 14264,
            "speakerName": "格里斯潘",
            "text": "他们的热情就像是火山，我光是靠近他们，就要被蒸发了…",
            "nextDialogs": [
              "250191604"
            ]
          },
          "250191604": {
            "id": "250191604",
            "speakerId": 14264,
            "speakerName": "格里斯潘",
            "text": "#所以，这件事就只能交给您了，{NICKNAME}{M#先生}{F#小姐}！",
            "nextDialogs": [
              "250191605"
            ]
          },
          "250191605": {
            "id": "250191605",
            "speakerId": 14265,
            "speakerName": "格罗贝尔",
            "text": "喵喵。喵…"
          }
        }
      }
    },
    {
      "subId": "2501917",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "250191701"
        ],
        "dialogs": {
          "250191701": {
            "id": "250191701",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "好吧，交给我。"
          }
        }
      }
    },
    {
      "subId": "2501918",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "250191801"
        ],
        "dialogs": {
          "250191801": {
            "id": "250191801",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "行吧，交给我。"
          }
        }
      }
    },
    {
      "subId": "2501919",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "250191901"
        ],
        "dialogs": {
          "250191901": {
            "id": "250191901",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "看在加尔恰的份上，我答应了。"
          }
        }
      }
    },
    {
      "subId": "2501922",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "250192201"
        ],
        "dialogs": {
          "250192201": {
            "id": "250192201",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "咱们一起去吧。",
            "nextDialogs": [
              "250192202"
            ]
          },
          "250192202": {
            "id": "250192202",
            "speakerId": 14264,
            "speakerName": "格里斯潘",
            "text": "没问题，上次的实地考察虽然出了点岔子，但我依然受益良多。",
            "nextDialogs": [
              "250192203"
            ]
          },
          "250192203": {
            "id": "250192203",
            "speakerId": 14265,
            "speakerName": "格罗贝尔",
            "text": "喵喵…",
            "nextDialogs": [
              "250192204"
            ]
          },
          "250192204": {
            "id": "250192204",
            "speakerId": 14264,
            "speakerName": "格里斯潘",
            "text": "#呃…那会长您就留在这里吧。请您放心，有亲爱的{NICKNAME}{M#先生}{F#小姐}在，我的人身安全绝对有保障！",
            "nextDialogs": [
              "250192205"
            ]
          },
          "250192205": {
            "id": "250192205",
            "speakerId": 14265,
            "speakerName": "格罗贝尔",
            "text": "喵…喵喵…喵…"
          }
        }
      }
    },
    {
      "subId": "2501923",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "250192301"
        ],
        "dialogs": {
          "250192301": {
            "id": "250192301",
            "speakerId": 14264,
            "speakerName": "格里斯潘",
            "text": "您找到我要的东西了吗？"
          }
        }
      }
    }
  ]
}
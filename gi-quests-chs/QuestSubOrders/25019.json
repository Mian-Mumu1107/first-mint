    {
      "subId": "2501907",
      "subQuestName": "和格里斯潘会合",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "250191101"
        ],
        "dialogs": {
          "250191101": {
            "id": "250191101",
            "speakerId": 14264,
            "speakerName": "格里斯潘",
            "text": "哈！瞧瞧这株「颗粒果」，它的长势真不错，也许，它也是受到了燃素的影响？我得把它采下来，做成样本。",
            "nextDialogs": [
              "250191102"
            ]
          },
          "250191102": {
            "id": "250191102",
            "speakerId": 14264,
            "speakerName": "格里斯潘",
            "text": "#{NICKNAME}{M#先生}{F#小姐}，您来了，快来帮我一把，把它的根茎给…",
            "nextDialogs": [
              "250191105"
            ]
          },
          "250191105": {
            "id": "250191105",
            "speakerId": 14264,
            "speakerName": "格里斯潘",
            "text": "啊？！救命啊！"
          }
        }
      }
    },

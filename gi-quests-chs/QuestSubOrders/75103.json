    {
      "subId": "7510308",
      "subQuestName": "",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "751030801"
        ],
        "dialogs": {
          "751030801": {
            "id": "751030801",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "哇，好多鱼肉！",
            "nextDialogs": [
              "751030802"
            ]
          },
          "751030802": {
            "id": "751030802",
            "speakerId": 1001,
            "speakerName": "帕尼娅",
            "text": "#啊，不可以乱动喔，金发的{M#大哥哥}{F#大姐姐}！那些是用来吸引浮流鸟的啦！",
            "nextDialogs": [
              "751030803"
            ]
          },
          "751030803": {
            "id": "751030803",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "呃，吸引浮流鸟？",
            "nextDialogs": [
              "751030804"
            ]
          },
          "751030804": {
            "id": "751030804",
            "speakerId": 1001,
            "speakerName": "帕尼娅",
            "text": "是呀，我和伊瓦伊正在等这些浮流鸟上岸呢。反正也没有什么别的事情好做嘛。",
            "nextDialogs": [
              "751030805"
            ]
          },
          "751030805": {
            "id": "751030805",
            "speakerId": 1002,
            "speakerName": "伊瓦伊",
            "text": "呜，呜呜！",
            "nextDialogs": [
              "751030806"
            ]
          },
          "751030806": {
            "id": "751030806",
            "speakerId": 1001,
            "speakerName": "帕尼娅",
            "text": "好啦好啦，伊瓦伊是乖孩子，对吧？要有耐心，不可以着急喔。",
            "nextDialogs": [
              "751030807"
            ]
          },
          "751030807": {
            "id": "751030807",
            "speakerId": 1002,
            "speakerName": "伊瓦伊",
            "text": "呜…",
            "nextDialogs": [
              "751030808"
            ]
          },
          "751030808": {
            "id": "751030808",
            "speakerId": 1001,
            "speakerName": "帕尼娅",
            "text": "总之，我们本来打算来这里玩。毕竟除了朗戈叔叔以外，平时一般不会有人到这里来，所以这就是我们的秘密基地——之类的吧？",
            "nextDialogs": [
              "751030809"
            ]
          },
          "751030809": {
            "id": "751030809",
            "speakerId": 1001,
            "speakerName": "帕尼娅",
            "text": "结果没想到，今天反而被这些浮流鸟占去先机啦。",
            "nextDialogs": [
              "751030810"
            ]
          },
          "751030810": {
            "id": "751030810",
            "speakerId": 1001,
            "speakerName": "帕尼娅",
            "text": "所以呢，我就准备了这些鱼肉，打算把浮流鸟们吸引过来。浮流鸟可是很喜欢吃鱼肉的喔！",
            "nextDialogs": [
              "751030816",
              "751030813"
            ]
          },
          "751030816": {
            "id": "751030816",
            "speakerId": 1001,
            "speakerName": "帕尼娅",
            "text": "是呀，可能是因为距离太远了，没闻到鱼肉的气味吧？要是能想办法先把它们引到岸上来的话…",
            "nextDialogs": [
              "751030817"
            ]
          },
          "751030817": {
            "id": "751030817",
            "speakerId": 1001,
            "speakerName": "帕尼娅",
            "text": "哎，要是朗戈叔叔的话，估计会说<color=#00E1FFFF>「只要把它们撞上岸就好！」</color>之类的吧…可惜，我和伊瓦伊力气太小，只会被反过来撞飞啦。",
            "nextDialogs": [
              "751030818"
            ]
          },
          "751030818": {
            "id": "751030818",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "#嗯…{NICKNAME}，要不然我们来试试看吧？如果把浮流鸟引到岸上来的话，说不定它们就会被鱼肉吸引啦！"
          },
          "751030813": {
            "id": "751030813",
            "speakerId": 1001,
            "speakerName": "帕尼娅",
            "text": "圆滚滚的，喜欢吃鱼肉…原来如此，的确是浮流鸟呢。",
            "nextDialogs": [
              "751030814"
            ]
          },
          "751030814": {
            "id": "751030814",
            "speakerId": 1002,
            "speakerName": "伊瓦伊",
            "text": "嗯，嗯！",
            "nextDialogs": [
              "751030815"
            ]
          },
          "751030815": {
            "id": "751030815",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "才不是呢！话说回来，这些浮流鸟不是完全没被吸引过来嘛！"
          }
        }
      }
    },

            ]
          },
          "751030406": {
            "id": "751030406",
            "speakerId": 1001,
            "speakerName": "帕尼娅",
            "text": "#那就再见啦，好心的{M#大哥哥}{F#大姐姐}！要是下次有时间的话，也可以来找我一起玩喔！"
          },
          "751030405": {
            "id": "751030405",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "才、才没有这回事！不管怎么说我也不会被没做成料理的食材吸引住…嗯，绝对不会！"
          }
        }

  "subQuests": [
    {
      "subId": "7050601",
      "subQuestName": "与卢卡对话，进入酒馆",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "705060101"
        ],
        "dialogs": {
          "705060101": {
            "id": "705060101",
            "speakerId": 1000,
            "speakerName": "丽莎",
            "text": "嗨，小可爱，见到你真好。",
            "nextDialogs": [
              "705060102"
            ]
          },
          "705060102": {
            "id": "705060102",
            "speakerId": 1001,
            "speakerName": "琴",
            "text": "虽然很少会在这种地方见面，但我此刻的心情，和丽莎是一样的。",
            "nextDialogs": [
              "705060103"
            ]
          },
          "705060103": {
            "id": "705060103",
            "speakerId": 1000,
            "speakerName": "丽莎",
            "text": "欸，怎么能叫「这种地方」呢？酒馆明明是娱乐休闲的好去处。",
            "nextDialogs": [
              "705060104"
            ]
          },
          "705060104": {
            "id": "705060104",
            "speakerId": 1000,
            "speakerName": "丽莎",
            "text": "你一定想不到，我可是费尽力气劝了半天，才把这位大忙人从她那把椅子上请起来。",
            "nextDialogs": [
              "705060105"
            ]
          },
          "705060105": {
            "id": "705060105",
            "speakerId": 1000,
            "speakerName": "丽莎",
            "text": "才到这里坐了没多久，琴那张脸上呀，又写满了担忧…",
            "nextDialogs": [
              "705060106"
            ]
          },
          "705060106": {
            "id": "705060106",
            "speakerId": 1001,
            "speakerName": "琴",
            "text": "丽莎…",
            "nextDialogs": [
              "705060107"
            ]
          },
          "705060107": {
            "id": "705060107",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "毕竟骑士团事务繁多…",
            "nextDialogs": [
              "705060108"
            ]
          },
          "705060108": {
            "id": "705060108",
            "speakerId": 1002,
            "speakerName": "派蒙",
            "text": "是啊，琴团长是代理团长嘛，当然会挂念团里的事啦！",
            "nextDialogs": [
              "705060109"
            ]
          },
          "705060109": {
            "id": "705060109",
            "speakerId": 1002,
            "speakerName": "派蒙",
            "text": "不过那句话怎么说的来着…「来都来了！」",
            "nextDialogs": [
              "705060110"
            ]
          },
          "705060110": {
            "id": "705060110",
            "speakerId": 1002,
            "speakerName": "派蒙",
            "text": "#让{M#他}{F#她}为你们调两杯好喝的吧，喝完就开心了！",
            "nextDialogs": [
              "705060111"
            ]
          },
          "705060111": {
            "id": "705060111",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "就当换换心情。",
            "nextDialogs": [
              "705060112"
            ]
          },
          "705060112": {
            "id": "705060112",
            "speakerId": 1000,
            "speakerName": "丽莎",
            "text": "唉，需要学会放松的，就只有琴啦。",
            "nextDialogs": [
              "705060113"
            ]
          },
          "705060113": {
            "id": "705060113",
            "speakerId": 1000,
            "speakerName": "丽莎",
            "text": "小可爱，麻烦给我一杯情诗吧，中杯，要甜一点。",
            "nextDialogs": [
              "705060114"
            ]
          },
          "705060114": {
            "id": "705060114",
            "speakerId": 1000,
            "speakerName": "丽莎",
            "text": "琴呢？来点什么？",
            "nextDialogs": [
              "705060115"
            ]
          },
          "705060115": {
            "id": "705060115",
            "speakerId": 1001,
            "speakerName": "琴",
            "text": "我的话…咖啡就好，也要中杯。",
            "nextDialogs": [
              "705060116"
            ]
          },
          "705060116": {
            "id": "705060116",
            "speakerId": 1002,
            "speakerName": "派蒙",
            "text": "琴团长平时咖啡喝得够多了吧，要不要换点别的口味？",
            "nextDialogs": [
              "705060117"
            ]
          },
          "705060117": {
            "id": "705060117",
            "speakerId": 1001,
            "speakerName": "琴",
            "text": "谢谢你，不过，我还是想喝点提神的…",
            "nextDialogs": [
              "705060118"
            ]
          },
          "705060118": {
            "id": "705060118",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "明白了，请稍等片刻。",
            "nextDialogs": [
              "705060119"
            ]
          },
          "705060119": {
            "id": "705060119",
            "speakerId": 1001,
            "speakerName": "琴",
            "text": "嗯，辛苦你了。"
          }
        }
      }
    },

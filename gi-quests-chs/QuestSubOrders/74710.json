{
  "lineCounts": {
    "Player": 2,
    "希格雯": 10,
    "派蒙": 2
  },
  "subQuests": [
    {
      "subId": "7471001",
      "subQuestName": "与希格雯对话",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "747100101"
        ],
        "dialogs": {
          "747100101": {
            "id": "747100101",
            "speakerId": 1000,
            "speakerName": "希格雯",
            "text": "嗯…在足够宽敞，装饰还特别用心的水箱之中，乖巧的鱼儿们来回游动…",
            "nextDialogs": [
              "747100102"
            ]
          },
          "747100102": {
            "id": "747100102",
            "speakerId": 1000,
            "speakerName": "希格雯",
            "text": "这场景的确非常漂亮。",
            "nextDialogs": [
              "747100103"
            ]
          },
          "747100103": {
            "id": "747100103",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "这也是水族馆吸引人的地方之一！",
            "nextDialogs": [
              "747100104"
            ]
          },
          "747100104": {
            "id": "747100104",
            "speakerId": 1000,
            "speakerName": "希格雯",
            "text": "要是它们在开放的水域里也这么安分就好了，潜入水下的人们就能更沉浸地享受自然生命的美景…",
            "nextDialogs": [
              "747100105"
            ]
          },
          "747100105": {
            "id": "747100105",
            "speakerId": 1000,
            "speakerName": "希格雯",
            "text": "言归正传，多亏你们的协助，我查出了这些鱼儿暴躁的原因——",
            "nextDialogs": [
              "747100106"
            ]
          },
          "747100106": {
            "id": "747100106",
            "speakerId": 1000,
            "speakerName": "希格雯",
            "text": "这些年来，陆陆续续发生了一些水运事故，还有坏家伙违法倾倒废弃物…",
            "nextDialogs": [
              "747100107"
            ]
          },
          "747100107": {
            "id": "747100107",
            "speakerId": 1000,
            "speakerName": "希格雯",
            "text": "大量人造物品沉入海底，不断堆积，破坏了许多鱼儿的栖息地，导致鱼儿们的攻击性愈发高涨…",
            "nextDialogs": [
              "747100108"
            ]
          },
          "747100108": {
            "id": "747100108",
            "speakerId": 1000,
            "speakerName": "希格雯",
            "text": "之前，已经有一批潜水员接到委托，开始专门处理这些垃圾了。",
            "nextDialogs": [
              "747100109"
            ]
          },
          "747100109": {
            "id": "747100109",
            "speakerId": 1000,
            "speakerName": "希格雯",
            "text": "看来得提醒他们，有劳他们加快进度…",
            "nextDialogs": [
              "747100112"
            ]
          },
          "747100112": {
            "id": "747100112",
            "speakerId": 1000,
            "speakerName": "希格雯",
            "text": "是的，在此期间，我们还是继续之前的工作，尽可能把更多暴躁的鱼儿请回来休养吧。",
            "nextDialogs": [
              "747100113"
            ]
          },
          "747100113": {
            "id": "747100113",
            "speakerId": 1000,
            "speakerName": "希格雯",
            "text": "将病患与致病环境隔离开来，是相当重要的步骤。",
            "nextDialogs": [
              "747100114"
            ]
          },
          "747100114": {
            "id": "747100114",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "收到！就放心交给我们吧，我们继续寻找患者！"
          }
        }
      }
    }
  ]
}
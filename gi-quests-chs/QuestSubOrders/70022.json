        "dialogs": {
          "700220101": {
            "id": "700220101",
            "speakerId": 1000,
            "speakerName": "好奇的丘丘人",
            "text": "Odomu tomo? Kundala? Mosi mita?",
            "nextDialogs": [
              "700220102"
            ]
          },
          "700220102": {
            "id": "700220102",
            "speakerId": 1001,
            "speakerName": "艾拉·马斯克",
            "text": "Mimi tomo! Mosi mita!",
            "nextDialogs": [
              "700220103"
            ]
          },
          "700220103": {
            "id": "700220103",
            "speakerId": 1000,
            "speakerName": "好奇的丘丘人",
            "text": "Tomo mosi mita! Tomo mani mimi?",
            "nextDialogs": [
              "700220104"
            ]
          },
          "700220104": {
            "id": "700220104",
            "speakerId": 1001,
            "speakerName": "艾拉·马斯克",
            "text": "Mimi mani ye! Plata yaya ika?",
            "nextDialogs": [
              "700220105"
            ]
          },
          "700220105": {
            "id": "700220105",
            "speakerId": 1000,
            "speakerName": "好奇的丘丘人",
            "text": "Plata ika odomu! Zido mi! mi muhe yeye! Mi mita yeye!",
            "nextDialogs": [
              "700220106"
            ]
          },
          "700220106": {
            "id": "700220106",
            "speakerId": 1002,
            "speakerName": "派蒙",
            "text": "不知怎么的，感觉他们很谈得来的样子。",
            "nextDialogs": [
              "700220109"
            ]
          },
          "700220109": {
            "id": "700220109",
            "speakerId": 1001,
            "speakerName": "艾拉·马斯克",
            "text": "哼哼，它很愿意和我们交朋友，只要我们帮一个小忙…",
            "nextDialogs": [
              "700220110"
            ]
          },
          "700220110": {
            "id": "700220110",
            "speakerId": 1001,
            "speakerName": "艾拉·马斯克",
            "text": "我们需要帮它们打倒难对付的敌人，具体位置我标记下来啦。",
            "nextDialogs": [
              "700220111"
            ]
          },
          "700220111": {
            "id": "700220111",
            "speakerId": 1000,
            "speakerName": "好奇的丘丘人",
            "text": "Dada, Valo!",
            "nextDialogs": [
              "700220112"
            ]
          },
          "700220112": {
            "id": "700220112",
            "speakerId": 1001,
            "speakerName": "艾拉·马斯克",
            "text": "Valo!"
          }
        }
      }
    },

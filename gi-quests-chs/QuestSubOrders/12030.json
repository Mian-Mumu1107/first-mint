  "subQuests": [
    {
      "subId": "1203001",
      "subQuestName": "前往降灵仪式现场",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "120300101"
        ],
        "dialogs": {
          "120300101": {
            "id": "120300101",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "神子，这里是什么地方啊？",
            "nextDialogs": [
              "120300102"
            ]
          },
          "120300102": {
            "id": "120300102",
            "speakerId": 1034,
            "speakerName": "八重神子",
            "text": "这是进行「作者见面会」的最好地点。根据我的调查，在这里召唤那个鬼魂的成功率是最高的。",
            "nextDialogs": [
              "120300103"
            ]
          },
          "120300103": {
            "id": "120300103",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "真的吗？可这里面有一种好阴森的感觉！",
            "nextDialogs": [
              "120300104"
            ]
          },
          "120300104": {
            "id": "120300104",
            "speakerId": 1034,
            "speakerName": "八重神子",
            "text": "呵呵，既然和鬼怪有关，肯定会是这种氛围嘛。",
            "nextDialogs": [
              "120300105"
            ]
          },
          "120300105": {
            "id": "120300105",
            "speakerId": 1034,
            "speakerName": "八重神子",
            "text": "怕什么，马上就要知道《真实探灵笔记》的作者是谁了，你们不激动吗？",
            "nextDialogs": [
              "120300106"
            ]
          },
          "120300106": {
            "id": "120300106",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "虽然我现在心跳很快，但我很确定并不是因为激动！",
            "nextDialogs": [
              "120300107"
            ]
          },
          "120300107": {
            "id": "120300107",
            "speakerId": 1034,
            "speakerName": "八重神子",
            "text": "哈哈哈。走，我们进去吧。",
            "nextDialogs": [
              "120300108"
            ]
          },
          "120300108": {
            "id": "120300108",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "喂——等等我们！",
            "nextDialogs": [
              "120300109"
            ]
          },
          "120300109": {
            "id": "120300109",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "#呜呜，{NICKNAME}，我有点害怕…等下你千万不要离我太远…"
          }
        }
      }
    },
    {
      "subId": "1203002",
      "subQuestName": "进入降灵仪式现场",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "120300201"
        ],
        "dialogs": {
          "120300201": {
            "id": "120300201",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "好奇怪的画。神子，你知道上面画的是什么吗？",
            "nextDialogs": [
              "120300202"
            ]
          },
          "120300202": {
            "id": "120300202",
            "speakerId": 1034,
            "speakerName": "八重神子",
            "text": "嗯…应该是古代稻妻的景色吧。",
            "nextDialogs": [
              "120300203"
            ]
          },
          "120300203": {
            "id": "120300203",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "这幅画虽然画得很好，可看起来也阴森森的，有点吓人。",
            "nextDialogs": [
              "120300204"
            ]
          },
          "120300204": {
            "id": "120300204",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "咦，画上面好像有个署名。什么…「乐斋」？看不清。",
            "nextDialogs": [
              "120300205"
            ]
          },
          "120300205": {
            "id": "120300205",
            "speakerId": 1034,
            "speakerName": "八重神子",
            "text": "走，我们到里面去看看。"
          }
        }
      }
    },
    {
      "subId": "1203003",
      "subQuestName": "寻找降灵仪式线索",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [],
        "dialogs": {}
      }
    },
    {
      "subId": "1203004",
      "subQuestName": "完成降灵仪式的准备",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "120300401"
        ],
        "dialogs": {
          "120300401": {
            "id": "120300401",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "「三二一」…",
            "nextDialogs": [
              "120300403"
            ]
          },
          "120300403": {
            "id": "120300403",
            "speakerId": 1034,
            "speakerName": "八重神子",
            "text": "喔，都学会抢答了，看来脑袋没什么问题。",
            "nextDialogs": [
              "120300404"
            ]
          },
          "120300404": {
            "id": "120300404",
            "speakerId": 1034,
            "speakerName": "八重神子",
            "text": "第一次被附身，有什么感觉吗？",
            "nextDialogs": [
              "120300407"
            ]
          },
          "120300407": {
            "id": "120300407",
            "speakerId": 1034,
            "speakerName": "八重神子",
            "text": "呵呵，那就好，也省得再向你解释前因后果了。",
            "nextDialogs": [
              "120300408"
            ]
          },
          "120300408": {
            "id": "120300408",
            "speakerId": 1034,
            "speakerName": "八重神子",
            "text": "能让有乐斋低头认输，我现在神清气爽。所以他们惦记的那件事，可要好好替他们办了才行。"
          }
        }
      }
    },
    {
      "subId": "1203007",
      "subQuestName": "(test)镜子状态打开",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "120300701"
        ],
        "dialogs": {
          "120300701": {
            "id": "120300701",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "里面居然有这么大的空间。咦，那边是…镜子？",
            "nextDialogs": [
              "120300702"
            ]
          },
          "120300702": {
            "id": "120300702",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "还有一张长得很奇怪的凳子，不知道是做什么用的。",
            "nextDialogs": [
              "120300703"
            ]
          },
          "120300703": {
            "id": "120300703",
            "speakerId": 1034,
            "speakerName": "八重神子",
            "text": "嗯嗯，原来如此。呵呵，这个布置倒是挺方便的，省了我很多事。",
            "nextDialogs": [
              "120300704"
            ]
          },
          "120300704": {
            "id": "120300704",
            "speakerId": 1034,
            "speakerName": "八重神子",
            "text": "好，你们去周围探索一下。应该能有机关，让这个房间动起来才对。"
          }
        }
      }
    },
    {
      "subId": "1203008",
      "subQuestName": "(test)镜子状态关闭",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [],
        "dialogs": {}
      }
    },
    {
      "subId": "1203005",
      "subQuestName": "开始降灵仪式",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "120300301"
        ],
        "dialogs": {
          "120300301": {
            "id": "120300301",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "是刚刚我们看过的画，和墙壁一起转到这边来了！",
            "nextDialogs": [
              "120300302"
            ]
          },
          "120300302": {
            "id": "120300302",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "更阴森更吓人了！这个地方到底有什么用意啊！",
            "nextDialogs": [
              "120300303"
            ]
          },
          "120300303": {
            "id": "120300303",
            "speakerId": 1034,
            "speakerName": "八重神子",
            "text": "好，接下来我来介绍一种狐妖的秘传术法。这幅画是「快捷降灵媒介」，有了它就能省去很多繁琐的步骤。",
            "nextDialogs": [
              "120300304"
            ]
          },
          "120300304": {
            "id": "120300304",
            "speakerId": 1034,
            "speakerName": "八重神子",
            "text": "昏黄的镜面映照出昔日的景象，触景生情的鬼魂们，就很容易被它吸引。",
            "nextDialogs": [
              "120300305"
            ]
          },
          "120300305": {
            "id": "120300305",
            "speakerId": 1034,
            "speakerName": "八重神子",
            "text": "接下来就该你出场了，小家伙。来，坐在这。",
            "nextDialogs": [
              "120300308"
            ]
          },
          "120300308": {
            "id": "120300308",
            "speakerId": 1034,
            "speakerName": "八重神子",
            "text": "降灵仪式的本质，就是让鬼魂附到活人身上。",
            "nextDialogs": [
              "120300309"
            ]
          },
          "120300309": {
            "id": "120300309",
            "speakerId": 1034,
            "speakerName": "八重神子",
            "text": "你也见到那个鬼族武士了，脱离了人类的身体还想保持形态，能存在的时间非常有限。",
            "nextDialogs": [
              "120300310"
            ]
          },
          "120300310": {
            "id": "120300310",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "#可是要让灵附到{NICKNAME}的身上，不要紧吗？",
            "nextDialogs": [
              "120300311"
            ]
          },
          "120300311": {
            "id": "120300311",
            "speakerId": 1034,
            "speakerName": "八重神子",
            "text": "你对小家伙还真关心，我都有点嫉妒了。唉，要是我的朋友也能这么体贴就好了。",
            "nextDialogs": [
              "120300312"
            ]
          },
          "120300312": {
            "id": "120300312",
            "speakerId": 1034,
            "speakerName": "八重神子",
            "text": "小家伙，你害怕吗？没事没事，很快就好了，你就当是做了一场梦。",
            "nextDialogs": [
              "120300313"
            ]
          },
          "120300313": {
            "id": "120300313",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "我该怎么做？",
            "nextDialogs": [
              "120300314"
            ]
          },
          "120300314": {
            "id": "120300314",
            "speakerId": 1034,
            "speakerName": "八重神子",
            "text": "坐到椅子上，目视着那幅画，然后放松身心。自然一些就好，不必紧张。",
            "nextDialogs": [
              "120300315"
            ]
          },
          "120300315": {
            "id": "120300315",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "#感觉{NICKNAME}就像坐在画里一样。",
            "nextDialogs": [
              "120300316"
            ]
          },
          "120300316": {
            "id": "120300316",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "咦！是我的错觉吗？那幅画好像动了！",
            "nextDialogs": [
              "120300317"
            ]
          },
          "120300317": {
            "id": "120300317",
            "speakerId": 1034,
            "speakerName": "八重神子",
            "text": "默念咒语吧，小家伙。除此之外，还需要一些强烈的念头才行。",
            "nextDialogs": [
              "120300318"
            ]
          },
          "120300318": {
            "id": "120300318",
            "speakerId": 1034,
            "speakerName": "八重神子",
            "text": "许什么愿才能招来《真实探灵笔记》的作者，你应该很清楚吧？",
            "nextDialogs": [
              "120300319"
            ]
          },
          "120300319": {
            "id": "120300319",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "应该是跟小说有关的吧。",
            "nextDialogs": [
              "120300320"
            ]
          },
          "120300320": {
            "id": "120300320",
            "speakerId": 1034,
            "speakerName": "八重神子",
            "text": "没错。不过许愿得真情实感，让我来给你制造一点动力：",
            "nextDialogs": [
              "120300321"
            ]
          },
          "120300321": {
            "id": "120300321",
            "speakerId": 1034,
            "speakerName": "八重神子",
            "text": "「老师，书的销量很好，您什么时候能把第四章的故事大纲交出来啊？」"
          }
        }
      }
    },
    {

            "speakerId": 12490,
            "speakerName": "征文告示",
            "text": "本期销售排名：",
            "nextDialogs": [
              "120293502"
            ]
          },
          "120293502": {
            "id": "120293502",
            "speakerId": 12490,
            "speakerName": "征文告示",
            "text": "感谢各位参与！本次征文试点销售结果如下——",
            "nextDialogs": [
              "120293503"
            ]
          },
          "120293503": {
            "id": "120293503",
            "speakerId": 12490,
            "speakerName": "征文告示",
            "text": "第一名：《旅行者的奇妙冒险》",
            "nextDialogs": [
              "120293504"
            ]
          },
          "120293504": {
            "id": "120293504",
            "speakerId": 12490,
            "speakerName": "征文告示",
            "text": "第二名：《珊瑚之歌》",
            "nextDialogs": [
              "120293505"
            ]
          },
          "120293505": {
            "id": "120293505",
            "speakerId": 12490,
            "speakerName": "征文告示",
            "text": "第三名：《我家上司是笨蛋》"
          }
        }
      }
    }
  ]
}
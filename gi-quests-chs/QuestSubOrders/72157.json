            "text": "唉，什么时候才能去看那位「浅濑神社代宫司」呢…"
          }
        }
      }
    },
    {
      "subId": "7215703",
      "subQuestName": "与大祐对话",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "721570101"
        ],
        "dialogs": {
          "721570101": {
            "id": "721570101",
            "speakerId": 3181,
            "speakerName": "大祐",
            "text": "这…「镇石」在哪呢？",
            "nextDialogs": [
              "721570102"
            ]
          },
          "721570102": {
            "id": "721570102",
            "speakerId": 3180,
            "speakerName": "悦子",
            "text": "啧，果然没这么简单啊…",
            "nextDialogs": [
              "721570103"
            ]
          },
          "721570103": {
            "id": "721570103",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "还是四处找找吧。",
            "nextDialogs": [
              "721570104"
            ]
          },
          "721570104": {
            "id": "721570104",
            "speakerId": 3180,
            "speakerName": "悦子",
            "text": "没办法了，我们四处找找看，看有没有相关的线索吧。",
            "nextDialogs": [
              "721570105"
            ]
          },
          "721570105": {
            "id": "721570105",
            "speakerId": 3181,
            "speakerName": "大祐",
            "text": "这里这么大，得找到什么时候啊…",
            "nextDialogs": [
              "721570106"
            ]
          },
          "721570106": {
            "id": "721570106",
            "speakerId": 3180,
            "speakerName": "悦子",
            "text": "呵呵，那就得看我们的运气了，总之先开始找吧。",
            "nextDialogs": [
              "721570107"
            ]
          },
          "721570107": {
            "id": "721570107",
            "speakerId": 3180,
            "speakerName": "悦子",
            "text": "看来…「如何找到镇石」也是我们封印「镇石」时需要解决的问题之一。",
            "nextDialogs": [
              "721570108"
            ]
          },
          "721570108": {
            "id": "721570108",
            "speakerId": 3180,
            "speakerName": "悦子",
            "text": "希望解决这个问题的线索，就在这周围。",
            "nextDialogs": [
              "721570109"
            ]
          },
          "721570109": {
            "id": "721570109",
            "speakerId": 3180,
            "speakerName": "悦子",
            "text": "大祐，不要浪费时间了，快点动起来。",
            "nextDialogs": [
              "721570110"
            ]
          },
          "721570110": {
            "id": "721570110",
            "speakerId": 3181,
            "speakerName": "大祐",
            "text": "好、好的，悦子小姐…也只能这样了…"
          }
        }
      }

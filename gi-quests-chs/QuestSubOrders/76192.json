    "玫熙": 12,
    "莉奈娅": 13,
    "赫卡": 12
  },
  "subQuests": [
    {
      "subId": "7619201",
      "subQuestName": "（隐藏）点击手册按钮完成$HIDDEN",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "761920101"
        ],
        "dialogs": {
          "761920101": {
            "id": "761920101",
            "speakerId": 1000,
            "speakerName": "赫卡",
            "text": "看来今天运气不太好，等了这么久，就连普通的霜鳍鲸也没见到几只…",
            "nextDialogs": [
              "761920102"
            ]
          },
          "761920102": {
            "id": "761920102",
            "speakerId": 1001,
            "speakerName": "玫熙",
            "text": "唔…",
            "nextDialogs": [
              "761920103"
            ]
          },
          "761920103": {
            "id": "761920103",
            "speakerId": 1000,
            "speakerName": "赫卡",
            "text": "要不今天就算了，先回去吧，以后还会有机会的。",
            "nextDialogs": [
              "761920104"
            ]
          },
          "761920104": {
            "id": "761920104",
            "speakerId": 1001,
            "speakerName": "玫熙",
            "text": "可是…可是你这次回来待不了多久就又会去其他地方吧…",
            "nextDialogs": [
              "761920105"
            ]
          },
          "761920105": {
            "id": "761920105",
            "speakerId": 1001,
            "speakerName": "玫熙",
            "text": "我们再等一下吧。",
            "nextDialogs": [
              "761920106"
            ]
          },
          "761920106": {
            "id": "761920106",
            "speakerId": 1002,
            "speakerName": "莉奈娅",
            "text": "欸？难道是赫卡？",
            "nextDialogs": [
              "761920107"
            ]
          },
          "761920107": {
            "id": "761920107",
            "speakerId": 1000,
            "speakerName": "赫卡",
            "text": "莉奈娅姐姐。是的，我回来了，不过我的图鉴还差一点才能完成，所以现在还不能和你分个胜负。",
            "nextDialogs": [
              "761920108"
            ]
          },
          "761920108": {
            "id": "761920108",
            "speakerId": 1002,
            "speakerName": "莉奈娅",
            "text": "哦？这么说来你这次远行也收获不少啊，不过这段时间我也没闲着，我也给图鉴增补了不少内容呢。",
            "nextDialogs": [
              "761920109"
            ]
          },
          "761920109": {
            "id": "761920109",
            "speakerId": 1001,
            "speakerName": "玫熙",
            "text": "莉奈娅姐姐也是来看那只霜鳍鲸的吗？",
            "nextDialogs": [
              "761920110"
            ]
          },
          "761920110": {
            "id": "761920110",
            "speakerId": 1002,
            "speakerName": "莉奈娅",
            "text": "是呀是呀，听说是最近才被发现的，考虑到它的体型，我推测是环境变化导致了表皮颜色的变化。",
            "nextDialogs": [
              "761920111"
            ]
          },
          "761920111": {
            "id": "761920111",
            "speakerId": 1002,
            "speakerName": "莉奈娅",
            "text": "比方说，环境中月矩力的浓度之类的…",
            "nextDialogs": [
              "761920112"
            ]
          },
          "761920112": {
            "id": "761920112",
            "speakerId": 1000,
            "speakerName": "赫卡",
            "text": "很可惜，今天大概是见不到了。我们已经等了很久了，但还是一无所获。",
            "nextDialogs": [
              "761920113"
            ]
          },
          "761920113": {
            "id": "761920113",
            "speakerId": 1000,
            "speakerName": "赫卡",
            "text": "莉奈娅姐姐，你也劝劝她，今天我们就先回去…",
            "nextDialogs": [
              "761920114"
            ]
          },
          "761920114": {
            "id": "761920114",
            "speakerId": 1001,
            "speakerName": "玫熙",
            "text": "我没事的，今天醒来的时候就觉得状态比平时都好，我们再等一下吧。",
            "nextDialogs": [
              "761920115"
            ]
          },
          "761920115": {
            "id": "761920115",
            "speakerId": 1001,
            "speakerName": "玫熙",
            "text": "据说见到那只霜鳍鲸的人，想要实现的愿望就能成真。那就说明，它是会带来好运的动物吧？",
            "nextDialogs": [
              "761920116"
            ]
          },
          "761920116": {
            "id": "761920116",
            "speakerId": 1001,
            "speakerName": "玫熙",
            "text": "我希望赫卡能够带上它送来的好运再出发。",
            "nextDialogs": [
              "761920117"
            ]
          },
          "761920117": {
            "id": "761920117",
            "speakerId": 1000,
            "speakerName": "赫卡",
            "text": "可是…",
            "nextDialogs": [
              "761920118"
            ]
          },
          "761920118": {
            "id": "761920118",
            "speakerId": 1002,
            "speakerName": "莉奈娅",
            "text": "那我们就一起等吧。",
            "nextDialogs": [
              "761920119"
            ]
          },
          "761920119": {
            "id": "761920119",
            "speakerId": 1000,
            "speakerName": "赫卡",
            "text": "莉奈娅姐姐！",
            "nextDialogs": [
              "761920120"
            ]
          },
          "761920120": {
            "id": "761920120",
            "speakerId": 1002,
            "speakerName": "莉奈娅",
            "text": "你先别急嘛，我有预感，今天一定能看到那只霜鳍鲸的。",
            "nextDialogs": [
              "761920121"
            ]
          },
          "761920121": {
            "id": "761920121",
            "speakerId": 1002,
            "speakerName": "莉奈娅",
            "text": "赫卡也知道的吧？我的预感一向很准。",
            "nextDialogs": [
              "761920122"
            ]
          },
          "761920122": {
            "id": "761920122",
            "speakerId": 1000,
            "speakerName": "赫卡",
            "text": "好吧…那就再等一会儿，但是真的只能一会儿哦！",
            "nextDialogs": [
              "761920123"
            ]
          },
          "761920123": {
            "id": "761920123",
            "speakerId": 1003,
            "speakerName": "Black Screen",
            "text": "等了一会儿…",
            "nextDialogs": [
              "761920124"
            ]
          },
          "761920124": {
            "id": "761920124",
            "speakerId": 1002,
            "speakerName": "莉奈娅",
            "text": "快看快看！哇，它跳得好高！",
            "nextDialogs": [
              "761920125"
            ]
          },
          "761920125": {
            "id": "761920125",
            "speakerId": 1002,
            "speakerName": "莉奈娅",
            "text": "要是我也能游得那么快就好了，如果能和它们同游，一定会很快乐吧！",
            "nextDialogs": [
              "761920126"
            ]
          },
          "761920126": {
            "id": "761920126",
            "speakerId": 1002,
            "speakerName": "莉奈娅",
            "text": "干脆现在就下水试试——",
            "nextDialogs": [
              "761920127"
            ]
          },
          "761920127": {
            "id": "761920127",
            "speakerId": 1000,
            "speakerName": "赫卡",
            "text": "那也太危险啦！唉，离开这么久回来一看，莉奈娅姐姐还是这么冒失…",
            "nextDialogs": [
              "761920128"
            ]
          },
          "761920128": {
            "id": "761920128",
            "speakerId": 1002,
            "speakerName": "莉奈娅",
            "text": "哪、哪有！赫卡难道不想和它们一起玩耍吗？它们玩得那么开心欸。",
            "nextDialogs": [
              "761920129"
            ]
          },
          "761920129": {
            "id": "761920129",
            "speakerId": 1001,
            "speakerName": "玫熙",
            "text": "可是衣服打湿了着凉了就不好了，不如留在岸上，用留影机记录下它们开心的样子吧？",
            "nextDialogs": [
              "761920130"
            ]
          },
          "761920130": {
            "id": "761920130",
            "speakerId": 1002,
            "speakerName": "莉奈娅",
            "text": "这么说也有道理…那就借赫卡的留影机一用了。"
          }
        }
      }
    },
    {

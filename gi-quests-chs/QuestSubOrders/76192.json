    {
      "subId": "7619204",
      "subQuestName": "为霜鳍鲸留影",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "761920401"
        ],
        "dialogs": {
          "761920401": {
            "id": "761920401",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "（附近似乎有些值得调查的，如果是对本地生态十分了解的<color=#FFCC33FF>莉奈娅</color>，或许会有所收获…）"
          }
        }
      }
    },
    {
      "subId": "7619205",
      "subQuestName": "与玫熙对话",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "761920201"
        ],
        "dialogs": {
          "761920201": {
            "id": "761920201",
            "speakerId": 1001,
            "speakerName": "玫熙",
            "text": "拍得真好。",
            "nextDialogs": [
              "761920202"
            ]
          },
          "761920202": {
            "id": "761920202",
            "speakerId": 1000,
            "speakerName": "赫卡",
            "text": "现在心满意足了？",
            "nextDialogs": [
              "761920203"
            ]
          },
          "761920203": {
            "id": "761920203",
            "speakerId": 1001,
            "speakerName": "玫熙",
            "text": "嗯！不管传说是不是真的，我希望不论赫卡走到哪里，好运都会助你化险为夷，最后平安回到「斯佩兰扎」。",
            "nextDialogs": [
              "761920204"
            ]
          },
          "761920204": {
            "id": "761920204",
            "speakerId": 1000,
            "speakerName": "赫卡",
            "text": "…谢谢。",
            "nextDialogs": [
              "761920205"
            ]
          },
          "761920205": {
            "id": "761920205",
            "speakerId": 1001,
            "speakerName": "玫熙",
            "text": "嘿嘿，那我们回去吧？莉奈娅姐姐，也谢谢你，我们「斯佩兰扎」见！",
            "nextDialogs": [
              "761920206"
            ]
          },
          "761920206": {
            "id": "761920206",
            "speakerId": 1002,
            "speakerName": "莉奈娅",
            "text": "「斯佩兰扎」见！"
          }
        }
      }
    },
    {

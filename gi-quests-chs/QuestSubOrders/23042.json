    },
    {
      "subId": "2304205",
      "subQuestName": "向内尔敏回报",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "230420501"
        ],
        "dialogs": {
          "230420501": {
            "id": "230420501",
            "speakerId": 1000,
            "speakerName": "内尔敏",
            "text": "太好了，之前的材料还剩下一些，加上你带来的这些，我可以再试做几次了…",
            "nextDialogs": [
              "230420502"
            ]
          },
          "230420502": {
            "id": "230420502",
            "speakerId": 1000,
            "speakerName": "内尔敏",
            "text": "呼…我再多看看笔记，这次一定要成功！",
            "nextDialogs": [
              "230420503"
            ]
          },
          "230420503": {
            "id": "230420503",
            "speakerId": 1000,
            "speakerName": "内尔敏",
            "text": "对了，我还得去摘几片花瓣…",
            "nextDialogs": [
              "230420504"
            ]
          },
          "230420504": {
            "id": "230420504",
            "speakerId": 1002,
            "speakerName": "Black Screen",
            "text": "内尔敏开始紧张地制作起了「香水」…",
            "nextDialogs": [
              "230420505"
            ]
          },
          "230420505": {
            "id": "230420505",
            "speakerId": 1000,
            "speakerName": "内尔敏",
            "text": "完成了！气味闻起来还不错…也没有变得黏黏糊糊的…",
            "nextDialogs": [
              "230420506"
            ]
          },
          "230420506": {
            "id": "230420506",
            "speakerId": 1000,
            "speakerName": "内尔敏",
            "text": "这样应该就算是成功了吧…",
            "nextDialogs": [
              "230420509"
            ]
          },
          "230420509": {
            "id": "230420509",
            "speakerId": 1000,
            "speakerName": "内尔敏",
            "text": "嗯！我还特意买了一个瓶子呢，先让我把香水装进去…",
            "nextDialogs": [
              "230420510"
            ]
          },
          "230420510": {
            "id": "230420510",
            "speakerId": 1000,
            "speakerName": "内尔敏",
            "text": "旅行者，我们一起去把香水送给里夫吧，希望他会喜欢…"
          }
        }
      }
    },
    {
      "subId": "2304206",
      "subQuestName": "把「香水」送给里夫",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "230420601"
        ],
        "dialogs": {
          "230420601": {
            "id": "230420601",
            "speakerId": 1003,
            "speakerName": "里夫",
            "text": "内尔敏，还有旅行者…你们怎么来了？是遇见什么麻烦了吗？",
            "nextDialogs": [
              "230420602"
            ]
          },
          "230420602": {
            "id": "230420602",
            "speakerId": 1003,
            "speakerName": "里夫",
            "text": "不会是那盆花有什么问题吧？我还在值班呢，等我值完班之后，再…",
            "nextDialogs": [
              "230420603"
            ]
          },
          "230420603": {
            "id": "230420603",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "内尔敏有东西送给你。",
            "nextDialogs": [
              "230420604"
            ]
          },
          "230420604": {
            "id": "230420604",
            "speakerId": 1000,
            "speakerName": "内尔敏",
            "text": "这瓶「香水」送给你！是薄荷味的喔。",
            "nextDialogs": [
              "230420605"
            ]
          },
          "230420605": {
            "id": "230420605",
            "speakerId": 1000,
            "speakerName": "内尔敏",
            "text": "我本来想做「墩墩桃」味的，但不知道为什么，我只要加入墩墩桃，香水就会变得黏糊糊的…",
            "nextDialogs": [
              "230420606"
            ]
          },
          "230420606": {
            "id": "230420606",
            "speakerId": 1003,
            "speakerName": "里夫",
            "text": "谢…谢谢，但「香水」是用来做什么的？驱虫？还是做标记…",
            "nextDialogs": [
              "230420607"
            ]
          },
          "230420607": {
            "id": "230420607",
            "speakerId": 1000,
            "speakerName": "内尔敏",
            "text": "是帮你提神啦，还有盖住你身上的汗味，你每天闻着那么重的汗味不会头晕吗？",
            "nextDialogs": [
              "230420608"
            ]
          },
          "230420608": {
            "id": "230420608",
            "speakerId": 1003,
            "speakerName": "里夫",
            "text": "这个，闻习惯了倒也还好，突然闻不到了反而有些不自在…",
            "nextDialogs": [
              "230420609"
            ]
          },
          "230420609": {
            "id": "230420609",
            "speakerId": 1000,
            "speakerName": "内尔敏",
            "text": "那「香水」我拿走了，你别用了。",
            "nextDialogs": [
              "230420610"
            ]
          },
          "230420610": {
            "id": "230420610",
            "speakerId": 1003,
            "speakerName": "里夫",
            "text": "欸！别啊，我开玩笑的！",
            "nextDialogs": [
              "230420611"
            ]
          },
          "230420611": {
            "id": "230420611",
            "speakerId": 1003,
            "speakerName": "里夫",
            "text": "快，快把「香水」给我，我头现在就开始晕了…",
            "nextDialogs": [
              "230420612"
            ]
          },
          "230420612": {
            "id": "230420612",
            "speakerId": 1000,
            "speakerName": "内尔敏",
            "text": "给你，涂在胳膊上就行了，贾瓦希尔奶奶是这么说的。",
            "nextDialogs": [
              "230420613"
            ]
          },
          "230420613": {
            "id": "230420613",
            "speakerId": 1003,
            "speakerName": "里夫",
            "text": "这气味闻起来还不错，确实很提神。涂上去还感觉冰凉凉的，挺舒服…",
            "nextDialogs": [
              "230420614"
            ]
          },
          "230420614": {
            "id": "230420614",
            "speakerId": 1000,
            "speakerName": "内尔敏",
            "text": "哼哼，这可是贾瓦希尔奶奶的秘方。",
            "nextDialogs": [
              "230420615"
            ]
          },
          "230420615": {
            "id": "230420615",
            "speakerId": 1000,
            "speakerName": "内尔敏",
            "text": "多亏了旅行者帮忙，我才能做出这么好的「香水」。",
            "nextDialogs": [
              "230420616"
            ]
          },
          "230420616": {
            "id": "230420616",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "就是帮了点小忙。",
            "nextDialogs": [
              "230420617"
            ]
          },
          "230420617": {
            "id": "230420617",
            "speakerId": 1003,
            "speakerName": "里夫",
            "text": "麻烦了你这么多次，真是不好意思…",
            "nextDialogs": [
              "230420618"
            ]
          },
          "230420618": {
            "id": "230420618",
            "speakerId": 1003,
            "speakerName": "里夫",
            "text": "这些东西给你，就当做是报酬吧，真是多谢了。",
            "nextDialogs": [
              "230420619"
            ]
          },
          "230420619": {
            "id": "230420619",
            "speakerId": 1003,
            "speakerName": "里夫",
            "text": "这「香水」用起来倒还真是不错…",
            "nextDialogs": [
              "230420620"
            ]
          },
          "230420620": {
            "id": "230420620",
            "speakerId": 1003,
            "speakerName": "里夫",
            "text": "就是…呃…内尔敏，为什么我涂上香水的地方，起了这么多疹子…"
          }
        }
      }
    },
    {
      "subId": "2304207",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "230420701"
        ],
        "dialogs": {
          "230420701": {
            "id": "230420701",
            "speakerId": 1000,
            "speakerName": "内尔敏",
            "text": "这道工序是怎么做的来着？笔记…笔记在哪…"
          }
        }
      }
    },
    {
      "subId": "2304208",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "230420801"
        ],
        "dialogs": {
          "230420801": {
            "id": "230420801",
            "speakerId": 1003,
            "speakerName": "里夫",
            "text": "旅行者，你又在忙什么呢？跑来跑去的…",
            "nextDialogs": [
              "230420802"
            ]
          },
          "230420802": {
            "id": "230420802",
            "speakerId": 1003,
            "speakerName": "里夫",
            "text": "对了，你最近有没有帮内尔敏办过什么事？或者…是听过什么和她有关的传闻？",
            "nextDialogs": [
              "230420803"
            ]
          },
          "230420803": {
            "id": "230420803",
            "speakerId": 1003,
            "speakerName": "里夫",
            "text": "总感觉她最近忙忙碌碌的，但我又不知道她在忙什么…",
            "nextDialogs": [
              "230420805",
              "230420807"
            ]
          },
          "230420805": {
            "id": "230420805",
            "speakerId": 1003,
            "speakerName": "里夫",
            "text": "是这样吗？但是我也没看见她屋子里多几盆花啊…"
          },
          "230420807": {
            "id": "230420807",
            "speakerId": 1003,
            "speakerName": "里夫",
            "text": "哈？难道是希尔米他们又缠着内尔敏做「薄荷豆汤」了？",
            "nextDialogs": [
              "230420808"
            ]
          },
          "230420808": {
            "id": "230420808",
            "speakerId": 1003,
            "speakerName": "里夫",
            "text": "这群孩子…我有空一定要去说说他们。"
          }
        }
      }
    },
    {
      "subId": "2304209",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "230420901"
        ],
        "dialogs": {
          "230420901": {
            "id": "230420901",
            "speakerId": 1000,
            "speakerName": "内尔敏",
            "text": "咳…咳咳…这气味…这样也不对…",
            "nextDialogs": [
              "230420902"
            ]
          },
          "230420902": {
            "id": "230420902",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "你没事吧？",
            "nextDialogs": [
              "230420903"
            ]
          },
          "230420903": {
            "id": "230420903",
            "speakerId": 1000,
            "speakerName": "内尔敏",
            "text": "没事没事，我刚才不小心做错了一道工序，做出的「香水」废掉了…",
            "nextDialogs": [
              "230420904"
            ]
          },
          "230420904": {
            "id": "230420904",
            "speakerId": 1000,
            "speakerName": "内尔敏",
            "text": "不说这些，你帮我拿到那些材料了吗？",
            "nextDialogs": [
              "230420905"
            ]
          },
          "230420905": {
            "id": "230420905",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "拿到了。"
          }
        }
      }
    },
    {
      "subId": "2304299",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "230429901"
        ],
        "dialogs": {
          "230429901": {
            "id": "230429901",
            "speakerId": 1004,
            "speakerName": "派蒙",
            "text": "这些水应该够用了，我们回去找内尔敏吗？"
          }
        }
      }
    }
  ]
}
  "subQuests": [
    {
      "subId": "2304201",
      "subQuestName": "与内尔敏对话",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "230420101"
        ],
        "dialogs": {
          "230420101": {
            "id": "230420101",
            "speakerId": 1000,
            "speakerName": "内尔敏",
            "text": "这样一定可以给里夫一个惊喜…嘿嘿…",
            "nextDialogs": [
              "230420102"
            ]
          },
          "230420102": {
            "id": "230420102",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "什么惊喜？",
            "nextDialogs": [
              "230420103"
            ]
          },
          "230420103": {
            "id": "230420103",
            "speakerId": 1000,
            "speakerName": "内尔敏",
            "text": "呜哇！别吓我啊旅行者！",
            "nextDialogs": [
              "230420104"
            ]
          },
          "230420104": {
            "id": "230420104",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "我是从你正面走过来的…",
            "nextDialogs": [
              "230420105"
            ]
          },
          "230420105": {
            "id": "230420105",
            "speakerId": 1000,
            "speakerName": "内尔敏",
            "text": "我在想事情嘛，完全没有注意到你。",
            "nextDialogs": [
              "230420106"
            ]
          },
          "230420106": {
            "id": "230420106",
            "speakerId": 1000,
            "speakerName": "内尔敏",
            "text": "旅行者，我问你啊…你听说过「香水」这种东西吗？",
            "nextDialogs": [
              "230420107"
            ]
          },
          "230420107": {
            "id": "230420107",
            "speakerId": 1000,
            "speakerName": "内尔敏",
            "text": "贾瓦希尔奶奶告诉我，她年轻的时候经常自制「香水」…",
            "nextDialogs": [
              "230420108"
            ]
          },
          "230420108": {
            "id": "230420108",
            "speakerId": 1000,
            "speakerName": "内尔敏",
            "text": "「香水」的气味不仅能够遮盖住人身上的汗味，而且某些特别的「香水」还有着提神的功效…",
            "nextDialogs": [
              "230420109"
            ]
          },
          "230420109": {
            "id": "230420109",
            "speakerId": 1000,
            "speakerName": "内尔敏",
            "text": "里夫一直在村口做守卫，每天热得满身大汗，回来的时候也总是说自己被晒得头晕…",
            "nextDialogs": [
              "230420110"
            ]
          },
          "230420110": {
            "id": "230420110",
            "speakerId": 1000,
            "speakerName": "内尔敏",
            "text": "所以，我就想做一瓶「薄荷香水」送给他。",
            "nextDialogs": [
              "230420111"
            ]
          },
          "230420111": {
            "id": "230420111",
            "speakerId": 1000,
            "speakerName": "内尔敏",
            "text": "贾瓦希尔奶奶把制作香水的方法写给了我，还帮我去买了很多材料…",
            "nextDialogs": [
              "230420112"
            ]
          },
          "230420112": {
            "id": "230420112",
            "speakerId": 1000,
            "speakerName": "内尔敏",
            "text": "但制作香水真是出乎意料的麻烦…光是悄悄处理材料我就花了好长时间，还做出了不少失败品…",
            "nextDialogs": [
              "230420113"
            ]
          },
          "230420113": {
            "id": "230420113",
            "speakerId": 1000,
            "speakerName": "内尔敏",
            "text": "再这么拖下去，里夫就要发现我做香水的事了！",
            "nextDialogs": [
              "230420114"
            ]
          },
          "230420114": {
            "id": "230420114",
            "speakerId": 1000,
            "speakerName": "内尔敏",
            "text": "所以旅行者，能请你帮我去置办一些材料吗？一定要悄悄地，不能让里夫发现！",
            "nextDialogs": [
              "230420116",
              "230420118"
            ]
          },
          "230420116": {
            "id": "230420116",
            "speakerId": 1000,
            "speakerName": "内尔敏",
            "text": "不行不行，这可是我准备了好久的惊喜，绝不能这么轻易就告诉他。",
            "nextDialogs": [
              "230420119"
            ]
          },
          "230420119": {
            "id": "230420119",
            "speakerId": 1000,
            "speakerName": "内尔敏",
            "text": "其实我想拜托你准备的材料也不多啦，你先去找阿扎莱先生，拿到我订的货，然后再帮我取一小桶水来就好啦。",
            "nextDialogs": [
              "230420120"
            ]
          },
          "230420120": {
            "id": "230420120",
            "speakerId": 1000,
            "speakerName": "内尔敏",
            "text": "记住，一定要悄悄的喔，绝对不能让里夫察觉到！"
          },
          "230420118": {
            "id": "230420118",
            "speakerId": 1000,
            "speakerName": "内尔敏",
            "text": "那就拜托你啦，放心，我一定会准备好报酬的。"
          }
        }
      }
    },
    {
      "subId": "2304202",
      "subQuestName": "与阿扎莱对话",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "230420301"
        ],
        "dialogs": {
          "230420301": {
            "id": "230420301",
            "speakerId": 1001,
            "speakerName": "阿扎莱",
            "text": "欢迎，客人需要点什么？",
            "nextDialogs": [
              "230420302"
            ]
          },
          "230420302": {
            "id": "230420302",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "关于内尔敏的「货物」…",
            "nextDialogs": [
              "230420303"
            ]
          },
          "230420303": {
            "id": "230420303",
            "speakerId": 1001,
            "speakerName": "阿扎莱",
            "text": "你说那个啊…已经准备好了。这些都是质量很不错的香料，价格也不贵。",
            "nextDialogs": [
              "230420304"
            ]
          },
          "230420304": {
            "id": "230420304",
            "speakerId": 1001,
            "speakerName": "阿扎莱",
            "text": "内尔敏是准备拿这些香料制作「香水」，对吧？",
            "nextDialogs": [
              "230420305"
            ]
          },
          "230420305": {
            "id": "230420305",
            "speakerId": 1001,
            "speakerName": "阿扎莱",
            "text": "唉，虽然有活力是件好事，但内尔敏也得注意一下自己的身体啊…"
          }
        }
      }
    },
    {
      "subId": "2304203",

    {
      "subId": "2101302",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "210130201"
        ],
        "dialogs": {
          "210130201": {
            "id": "210130201",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "有什么烦心事吗？",
            "nextDialogs": [
              "210130202"
            ]
          },
          "210130202": {
            "id": "210130202",
            "speakerId": 2310,
            "speakerName": "路爷",
            "text": "哦哦，是客人啊。",
            "nextDialogs": [
              "210130203"
            ]
          },
          "210130203": {
            "id": "210130203",
            "speakerId": 2310,
            "speakerName": "路爷",
            "text": "欢迎来到范木堂，轻策庄老字号工坊！大到百尺高楼，小到指尖陀螺，但凡是客官想得到的，没有老夫做不出的！",
            "nextDialogs": [
              "210130204"
            ]
          },
          "210130204": {
            "id": "210130204",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "这里是工坊？",
            "nextDialogs": [
              "210130205"
            ]
          },
          "210130205": {
            "id": "210130205",
            "speakerId": 2310,
            "speakerName": "路爷",
            "text": "当然不是。老夫的工坊在那边山上。",
            "nextDialogs": [
              "210130206"
            ]
          },
          "210130206": {
            "id": "210130206",
            "speakerId": 2310,
            "speakerName": "路爷",
            "text": "但是，有群怪物时不时地就到工坊里胡作非为。",
            "nextDialogs": [
              "210130207"
            ]
          },
          "210130207": {
            "id": "210130207",
            "speakerId": 2310,
            "speakerName": "路爷",
            "text": "我也请过千岩军的年轻人来对付它们，但每次千岩军一去，它们就一哄而散，千岩军一走，它们又卷土重来，真是烦不胜烦…",
            "nextDialogs": [
              "210130208"
            ]
          },
          "210130208": {
            "id": "210130208",
            "speakerId": 2310,
            "speakerName": "路爷",
            "text": "而且这么一弄，工坊也压根没法正常开工，唉…"
          }
        }
      }
    },
    {
      "subId": "2101303",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "210130301"
        ],
        "dialogs": {
          "210130301": {
            "id": "210130301",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "再见",
            "nextDialogs": [
              "210130302"
            ]
          },
          "210130302": {
            "id": "210130302",
            "speakerId": 2310,
            "speakerName": "路爷",
            "text": "你要走了吗？可要小心那群怪物啊。",
            "nextDialogs": [
              "210130303"
            ]
          },
          "210130303": {
            "id": "210130303",
            "speakerId": 2310,
            "speakerName": "路爷",
            "text": "唉，这工坊可怎么办才好啊…"
          }
        }
      }
    }
  ]

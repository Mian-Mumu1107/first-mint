        ],
        "dialogs": {
          "772390201": {
            "id": "772390201",
            "speakerId": 1000,
            "speakerName": "莉霍维多娃",
            "text": "真是…真是巅峰的妙想，为了躲避这些雪球，这些假想的怪兽，您的一举一动真是充满了巧思！",
            "nextDialogs": [
              "772390202"
            ]
          },
          "772390202": {
            "id": "772390202",
            "speakerId": 1000,
            "speakerName": "莉霍维多娃",
            "text": "可惜了，如果有留影机就好了，这样我就可以拍摄下您躲避的身姿并且反复观看。",
            "nextDialogs": [
              "772390203"
            ]
          },
          "772390203": {
            "id": "772390203",
            "speakerId": 1000,
            "speakerName": "莉霍维多娃",
            "text": "这些…这些奖励就交给你了，呜…要是，要是当时我有这样灵活的身段，就算再会滚的软猬兽也触及不到分毫啊！"
          }
        }
      }
    },

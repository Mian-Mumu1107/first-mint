  "subQuests": [
    {
      "subId": "7723901",
      "subQuestName": "(test)隐藏$HIDDEN",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "772390101"
        ],
        "dialogs": {
          "772390101": {
            "id": "772390101",
            "speakerId": 1000,
            "speakerName": "莉霍维多娃",
            "text": "没有人来挑战了吗，海屑镇的男士们女士们，可别让我看不起你们！",
            "nextDialogs": [
              "772390102"
            ]
          },
          "772390102": {
            "id": "772390102",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "你是…？",
            "nextDialogs": [
              "772390103"
            ]
          },
          "772390103": {
            "id": "772390103",
            "speakerId": 1000,
            "speakerName": "莉霍维多娃",
            "text": "我叫莉霍维多娃，嘿嘿，正是设计出了这个「雪球躲避大舞台」的人！",
            "nextDialogs": [
              "772390104"
            ]
          },
          "772390104": {
            "id": "772390104",
            "speakerId": 1000,
            "speakerName": "莉霍维多娃",
            "text": "实不相瞒，我从前也是冒险家协会的一位冒险家，有一次在某个雪夜在冻土上冒险的时候，遇到了成群的软猬兽。",
            "nextDialogs": [
              "772390105"
            ]
          },
          "772390105": {
            "id": "772390105",
            "speakerId": 1000,
            "speakerName": "莉霍维多娃",
            "text": "滚滚而来的软猬兽啊，就像是巨大的尖刺炮弹那样，把我追得狼狈不堪，涕泗横流…",
            "nextDialogs": [
              "772390106"
            ]
          },
          "772390106": {
            "id": "772390106",
            "speakerId": 1000,
            "speakerName": "莉霍维多娃",
            "text": "从软猬兽的冲击下活下来的我决定刻苦锻炼，而用雪球模拟软猬兽的冲击，这就是我想出来的锻炼法！",
            "nextDialogs": [
              "772390107"
            ]
          },
          "772390107": {
            "id": "772390107",
            "speakerId": 1000,
            "speakerName": "莉霍维多娃",
            "text": "等功成之日，再遇到软猬兽的时候，必能通过我灵活的身法反过来羞辱它们！哼哼…",
            "nextDialogs": [
              "772390108"
            ]
          },
          "772390108": {
            "id": "772390108",
            "speakerId": 1000,
            "speakerName": "莉霍维多娃",
            "text": "这就是「雪球躲避大舞台」！",
            "nextDialogs": [
              "772390109"
            ]
          },
          "772390109": {
            "id": "772390109",
            "speakerId": 1000,
            "speakerName": "莉霍维多娃",
            "text": "规则很简单，站在台上，想尽办法不要被雪球击中，时间越长，得到的奖励也越好！",
            "nextDialogs": [
              "772390110"
            ]
          },
          "772390110": {
            "id": "772390110",
            "speakerId": 1000,
            "speakerName": "莉霍维多娃",
            "text": "#怎么样，我能看到你眼中深藏的战士般的意志，如何，要来尝试一下吗？{M#先生}{F#小姐}？",
            "nextDialogs": [
              "772390112",
              "772390114"
            ]
          },
          "772390112": {
            "id": "772390112",
            "speakerId": 1000,
            "speakerName": "莉霍维多娃",
            "text": "好，那就请站到台子上吧！"
          },
          "772390114": {
            "id": "772390114",
            "speakerId": 1000,
            "speakerName": "莉霍维多娃",
            "text": "没有关系，就像团成团的软猬兽一直在雪夜的白桦林中等待着我，「雪球躲避大舞台」也会一直等待着你的！",
            "nextDialogs": [
              "772390115"
            ]
          },
          "772390115": {
            "id": "772390115",
            "speakerId": 1000,
            "speakerName": "莉霍维多娃",
            "text": "终有一日你会明白，是命运！是命运使你与「雪球躲避大舞台」在此处相遇的！"
          }
        }
      }
    },
    {
      "subId": "7723902",
      "subQuestName": "(test)隐藏$HIDDEN",
      "sceneId": null,
      "locations": [],
      "dialogue": {

      }
    },
    {
      "subId": "7212209",
      "subQuestName": "打倒愚人众",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "721220901"
        ],
        "dialogs": {
          "721220901": {
            "id": "721220901",
            "speakerId": 3162,
            "speakerName": "泽维尔",
            "text": "这就是我们的正式开工地了，这里的正上方，就是「御影炉心」储存「祟神」核心的装置了。",
            "nextDialogs": [
              "721220902"
            ]
          },
          "721220902": {
            "id": "721220902",
            "speakerId": 3162,
            "speakerName": "泽维尔",
            "text": "数据显示，这里的「祟神」密度也是最高的。",
            "nextDialogs": [
              "721220903"
            ]
          },
          "721220903": {
            "id": "721220903",
            "speakerId": 3162,
            "speakerName": "泽维尔",
            "text": "只要把这里给搞定，「御影炉心」的系统就能重新运转起来，让一切恢复正常了。",
            "nextDialogs": [
              "721220904"
            ]
          },
          "721220904": {
            "id": "721220904",
            "speakerId": 3162,
            "speakerName": "泽维尔",
            "text": "总算到了这一步…不得不说，我简直都想用我的那台「映影机」记录我们这次的行动了。",
            "nextDialogs": [
              "721220905"
            ]
          },
          "721220905": {
            "id": "721220905",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "可惜没法记录了。",
            "nextDialogs": [
              "721220906"
            ]
          },
          "721220906": {
            "id": "721220906",
            "speakerId": 3162,
            "speakerName": "泽维尔",
            "text": "没关系，我之后可以找些人来，重新演绎一遍我们这次行动。",
            "nextDialogs": [
              "721220907"
            ]
          },
          "721220907": {
            "id": "721220907",
            "speakerId": 3162,
            "speakerName": "泽维尔",
            "text": "这部「映影」的名字…我听说，稻妻这边的人经常把关于某某的故事叫做某某「物语」。",
            "nextDialogs": [
              "721220908"
            ]
          },
          "721220908": {
            "id": "721220908",
            "speakerId": 3162,
            "speakerName": "泽维尔",
            "text": "我觉得，这部「映影」的名字就叫做…",
            "nextDialogs": [
              "721220909"
            ]
          },
          "721220909": {
            "id": "721220909",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "「踏鞴物语」。",
            "nextDialogs": [
              "721220910"
            ]
          },
          "721220910": {
            "id": "721220910",
            "speakerId": 3162,
            "speakerName": "泽维尔",
            "text": "没错！非常好，「踏鞴物语」！",
            "nextDialogs": [
              "721220911"
            ]
          },
          "721220911": {
            "id": "721220911",
            "speakerId": 3162,
            "speakerName": "泽维尔",
            "text": "好了，一切准备就绪，旅行者，还是和之前一样。",
            "nextDialogs": [
              "721220912"
            ]
          },
          "721220912": {
            "id": "721220912",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "我搞定愚人众。",
            "nextDialogs": [
              "721220913"
            ]
          },
          "721220913": {
            "id": "721220913",
            "speakerId": 3162,
            "speakerName": "泽维尔",
            "text": "我搞定这「御影炉心」。",
            "nextDialogs": [
              "721220914"
            ]
          },
          "721220914": {
            "id": "721220914",
            "speakerId": 3162,
            "speakerName": "泽维尔",
            "text": "哈哈哈，我们这两句对白，一定能成为这部「映影」里的名台词。",
            "nextDialogs": [
              "721220915"
            ]
          },
          "721220915": {
            "id": "721220915",
            "speakerId": 3162,
            "speakerName": "泽维尔",
            "text": "等您准备好了，就去启动那个装置吧，然后我们俩一起，给这「踏鞴物语」写一个完美的结局。"
          }
        }
      }
    },
    {
      "subId": "7212210",
      "subQuestName": "与泽维尔对话",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "721220805"
        ],
        "dialogs": {
          "721220805": {
            "id": "721220805",
            "speakerId": 3162,
            "speakerName": "泽维尔",
            "text": "咳…咳咳…这帮无法无天的疯子…全都应该上法庭，上法庭！",
            "nextDialogs": [
              "721220807",
              "721220809"
            ]
          },
          "721220807": {
            "id": "721220807",
            "speakerId": 3162,
            "speakerName": "泽维尔",
            "text": "一个…一个非常安全的地方…咳咳…咳…",
            "nextDialogs": [
              "721220811"
            ]
          },
          "721220811": {
            "id": "721220811",
            "speakerId": 3162,
            "speakerName": "泽维尔",
            "text": "我们还是说正事吧，根据我手上这个信标刚刚搜集的数据，这周围的能量指数已经大大下降了。",
            "nextDialogs": [
              "721220812"
            ]
          },
          "721220812": {
            "id": "721220812",
            "speakerId": 3162,
            "speakerName": "泽维尔",
            "text": "根据这个装置现在的状态，和刚才它的表现，它已经能算是通过「最终验收」了。",
            "nextDialogs": [
              "721220813"
            ]
          },
          "721220813": {
            "id": "721220813",
            "speakerId": 3162,
            "speakerName": "泽维尔",
            "text": "现在我们可以正式开工了…来吧，我们去正式开工的地方，彻底把这件事给了结掉。"
          },
          "721220809": {
            "id": "721220809",
            "speakerId": 3162,
            "speakerName": "泽维尔",
            "text": "咳…咳咳…当然。对付这些恶徒，比起动手，我更愿意拿起法律的武器。",
            "nextDialogs": [
              "721220810"
            ]
          },
          "721220810": {
            "id": "721220810",
            "speakerId": 3162,
            "speakerName": "泽维尔",
            "text": "毕竟，不是每个人都像您一样有这么强的武艺，能够处理一些…不太容易处理的事。"
          }
        }
      }
    },

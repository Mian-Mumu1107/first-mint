  },
  "subQuests": [
    {
      "subId": "7212201",
      "subQuestName": "",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "721220101"
        ],
        "dialogs": {
          "721220101": {
            "id": "721220101",
            "speakerId": 20624,
            "speakerName": "泽维尔",
            "text": "净化装置、备用零件、路线图，还有信标数据…",
            "nextDialogs": [
              "721220102"
            ]
          },
          "721220102": {
            "id": "721220102",
            "speakerId": 20624,
            "speakerName": "泽维尔",
            "text": "这下应该就准备妥当了…等等，我检查一下我的备忘，再想想有什么遗漏的…",
            "nextDialogs": [
              "721220103"
            ]
          },
          "721220103": {
            "id": "721220103",
            "speakerId": 20624,
            "speakerName": "泽维尔",
            "text": "信标数据、路线图、备用零件，还有净化装置…",
            "nextDialogs": [
              "721220106"
            ]
          },
          "721220106": {
            "id": "721220106",
            "speakerId": 20624,
            "speakerName": "泽维尔",
            "text": "抱、抱歉，我还是第一次进入这种地方，平时我都只是做做后勤，处理处理数据…",
            "nextDialogs": [
              "721220107"
            ]
          },
          "721220107": {
            "id": "721220107",
            "speakerId": 20624,
            "speakerName": "泽维尔",
            "text": "最多…最多也就是用器械远距离操作一下。",
            "nextDialogs": [
              "721220108"
            ]
          },
          "721220108": {
            "id": "721220108",
            "speakerId": 20624,
            "speakerName": "泽维尔",
            "text": "唉，这回真的就是…「赶鸭子上架」了。您听说过这句璃月的俗话吗？",
            "nextDialogs": [
              "721220109"
            ]
          },
          "721220109": {
            "id": "721220109",
            "speakerId": 20624,
            "speakerName": "泽维尔",
            "text": "大意就是，形容让某人去做一件能力达不到的事…虽然我不知道为什么鸭子上不了架。",
            "nextDialogs": [
              "721220110"
            ]
          },
          "721220110": {
            "id": "721220110",
            "speakerId": 20624,
            "speakerName": "泽维尔",
            "text": "啊，鸭子，多么优雅、多么柔软的生物。在枫丹的如同明镜一般的水面上静静漂游的鸭子，便是此时此刻的我最怀念的景象…",
            "nextDialogs": [
              "721220111"
            ]
          },
          "721220111": {
            "id": "721220111",
            "speakerId": 20624,
            "speakerName": "泽维尔",
            "text": "唉，我们出发吧，如果这个装置运转正常的话，应该能不断净化它周围小范围内的「祟神」能量。",
            "nextDialogs": [
              "721220112"
            ]
          },
          "721220112": {
            "id": "721220112",
            "speakerId": 20624,
            "speakerName": "泽维尔",
            "text": "这样我们就能一起深入灾害区域了。还是按照之前的计划，您去搞定愚人众，我来搞定「御影炉心」…出发吧。"
          }
        }
      }
    },
    {
      "subId": "7212202",
      "subQuestName": "与泽维尔对话",
      "sceneId": null,
      "locations": [],

        "startDialogs": [],
        "dialogs": {}
      }
    },
    {
      "subId": "7212203",
      "subQuestName": "接近「御影炉心」",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "721220301"
        ],
        "dialogs": {
          "721220301": {
            "id": "721220301",
            "speakerId": 3162,
            "speakerName": "泽维尔",
            "text": "喔，见鬼。",
            "nextDialogs": [
              "721220305",
              "721220304"
            ]
          },
          "721220305": {
            "id": "721220305",
            "speakerId": 3162,
            "speakerName": "泽维尔",
            "text": "但是，这个装置似乎少了那么…一二三个零件…",
            "nextDialogs": [
              "721220306"
            ]
          },
          "721220306": {
            "id": "721220306",
            "speakerId": 3162,
            "speakerName": "泽维尔",
            "text": "幸好都不是关键部位，它暂时还能运转。",
            "nextDialogs": [
              "721220307"
            ]
          },
          "721220307": {
            "id": "721220307",
            "speakerId": 3162,
            "speakerName": "泽维尔",
            "text": "但如果想要继续往前走的话，我们还是得先想办法把那些零件找回来。",
            "nextDialogs": [
              "721220308"
            ]
          },
          "721220308": {
            "id": "721220308",
            "speakerId": 3162,
            "speakerName": "泽维尔",
            "text": "那些零件应该就在我们来时的路上，请您快去把它们找回来吧，我就在这等着您。"
          },
          "721220304": {
            "id": "721220304",
            "speakerId": 3162,
            "speakerName": "泽维尔",
            "text": "也不能说…完全符合我的预期…"
          }
        }
      }
    },
    {
      "subId": "7212204",
      "subQuestName": "与泽维尔对话",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "721220201"
        ],
        "dialogs": {
          "721220201": {
            "id": "721220201",
            "speakerId": 3162,
            "speakerName": "泽维尔",
            "text": "老天爷…我还是第一次不用任何防护手段就进这种地方…",
            "nextDialogs": [
              "721220202"
            ]
          },
          "721220202": {
            "id": "721220202",
            "speakerId": 3162,
            "speakerName": "泽维尔",
            "text": "但我们居然能顺利到达这里，很好，非常好，几乎要超出预期了。",
            "nextDialogs": [
              "721220204"
            ]
          },
          "721220204": {
            "id": "721220204",
            "speakerId": 3162,
            "speakerName": "泽维尔",
            "text": "对于这位被我临时凑起来的伙计来说，这个预期已经够高了。",
            "nextDialogs": [
              "721220206"
            ]
          },
          "721220206": {
            "id": "721220206",
            "speakerId": 3162,
            "speakerName": "泽维尔",
            "text": "按照我的预期，当我们前进到大概二分之一的距离的时候，我拼出来的这位伙计就会罢工啦。",
            "nextDialogs": [
              "721220207"
            ]
          },
          "721220207": {
            "id": "721220207",
            "speakerId": 3162,
            "speakerName": "泽维尔",
            "text": "然后，我就会因为被「祟神」影响而陷入昏迷…有可能是真被影响了，也有可能是被吓的…",
            "nextDialogs": [
              "721220208"
            ]
          },
          "721220208": {
            "id": "721220208",
            "speakerId": 3162,
            "speakerName": "泽维尔",
            "text": "但无论如何，我裤子右边的口袋里有一张纸条，只要按照上面的步骤处理，您就可以把我安全地带到外面了。",
            "nextDialogs": [
              "721220209"
            ]
          },
          "721220209": {
            "id": "721220209",
            "speakerId": 3162,
            "speakerName": "泽维尔",
            "text": "呃…我和您说过纸条的事吗？"
          }
        }
      }
    },

    {
      "subId": "7212215",
      "subQuestName": "开启「净化装置」",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "721221501"
        ],
        "dialogs": {
          "721221501": {
            "id": "721221501",
            "speakerId": 3185,
            "speakerName": "虎之助",
            "text": "「御影炉心」已经恢复正常了吗…",
            "nextDialogs": [
              "721221502"
            ]
          },
          "721221502": {
            "id": "721221502",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "你已经知道了？",
            "nextDialogs": [
              "721221503"
            ]
          },
          "721221503": {
            "id": "721221503",
            "speakerId": 3185,
            "speakerName": "虎之助",
            "text": "你们在「御影炉心」所做的事，已经有人向我报告过了。",
            "nextDialogs": [
              "721221505",
              "721221507"
            ]
          },
          "721221505": {
            "id": "721221505",
            "speakerId": 3185,
            "speakerName": "虎之助",
            "text": "没有接到范兵卫大人的命令，我无权采取任何行动。",
            "nextDialogs": [
              "721221508"
            ]
          },
          "721221508": {
            "id": "721221508",
            "speakerId": 3162,
            "speakerName": "泽维尔",
            "text": "好了好了，有这么一位对流程如此重视的严谨上司，这位士兵先生也有他自己的苦衷，咱们就别为难他了。",
            "nextDialogs": [
              "721221509"
            ]
          },
          "721221509": {
            "id": "721221509",
            "speakerId": 3162,
            "speakerName": "泽维尔",
            "text": "再说，我俩的行动之所以能如此顺利，说不定也有一部分是拜这位范兵卫先生所赐呢。",
            "nextDialogs": [
              "721221510"
            ]
          },
          "721221510": {
            "id": "721221510",
            "speakerId": 3162,
            "speakerName": "泽维尔",
            "text": "而且士兵先生也不是完全没有给我们帮助，比如那几门…",
            "nextDialogs": [
              "721221511"
            ]
          },
          "721221511": {
            "id": "721221511",
            "speakerId": 3185,
            "speakerName": "虎之助",
            "text": "泽维尔先生，非常感谢你的协助。",
            "nextDialogs": [
              "721221512"
            ]
          },
          "721221512": {
            "id": "721221512",
            "speakerId": 3162,
            "speakerName": "泽维尔",
            "text": "咳…主要还是得感谢这位旅行者，没有这位旅行者帮忙，我一个人可什么都做不到。",
            "nextDialogs": [
              "721221513"
            ]
          },
          "721221513": {
            "id": "721221513",
            "speakerId": 3185,
            "speakerName": "虎之助",
            "text": "是这样吗…",
            "nextDialogs": [
              "721221514"
            ]
          },
          "721221514": {
            "id": "721221514",
            "speakerId": 3185,
            "speakerName": "虎之助",
            "text": "非常感谢你，旅行者。我为我之前的态度…向你道歉。",
            "nextDialogs": [
              "721221515"
            ]
          },
          "721221515": {
            "id": "721221515",
            "speakerId": 3185,
            "speakerName": "虎之助",
            "text": "谢谢你保护了这座岛。"
          },
          "721221507": {
            "id": "721221507",
            "speakerId": 3185,
            "speakerName": "虎之助",
            "text": "没有接到范兵卫大人的命令，我无权采取任何行动。"
          }
        }
      }
    },
    {
      "subId": "7212216",
      "subQuestName": "与泽维尔对话",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "721221007"
        ],
        "dialogs": {
          "721221007": {
            "id": "721221007",
            "speakerId": 3162,
            "speakerName": "泽维尔",
            "text": "结、结束了…「御影炉心」应该已经重新开始运转了。",
            "nextDialogs": [
              "721221008"
            ]
          },
          "721221008": {
            "id": "721221008",
            "speakerId": 3162,
            "speakerName": "泽维尔",
            "text": "我们去顶上看看吧，我想再看看周围的情况。"
          }
        }
      }
    },
    {
      "subId": "7212211",
      "subQuestName": "前往「御影炉心」的顶部",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "721221101"
        ],
        "dialogs": {
          "721221101": {
            "id": "721221101",
            "speakerId": 3162,
            "speakerName": "泽维尔",
            "text": "这里「祟神」的密度也已经下降到了无害的程度…看来「御影炉心」确实已经运转了。",
            "nextDialogs": [
              "721221102"
            ]
          },
          "721221102": {
            "id": "721221102",
            "speakerId": 3162,
            "speakerName": "泽维尔",
            "text": "如果那群愚人众还想要「祟神」，唯一的办法，就是用外面的大炮直接轰击「御影炉心」了。",
            "nextDialogs": [
              "721221103"
            ]
          },
          "721221103": {
            "id": "721221103",
            "speakerId": 3162,
            "speakerName": "泽维尔",
            "text": "但这种行为差不多等于直接宣战了，就算愚人众再疯，应该也不会采取这种行为吧。",
            "nextDialogs": [
              "721221108",
              "721221106"
            ]
          },
          "721221108": {
            "id": "721221108",
            "speakerId": 3162,
            "speakerName": "泽维尔",
            "text": "无论如何，现在「御影炉心」已经安全了，这座岛上的我们和宝藏也不会一起被炸上天了。"
          },
          "721221106": {
            "id": "721221106",
            "speakerId": 3162,
            "speakerName": "泽维尔",
            "text": "您是说之前他们在璃月和蒙德搞的那些事吗？",
            "nextDialogs": [
              "721221107"
            ]
          },
          "721221107": {
            "id": "721221107",
            "speakerId": 3162,
            "speakerName": "泽维尔",
            "text": "我是觉得，以「御影炉心」的价值，应该还不值得他们下那种狠手…"
          }
        }
      }
    },

{
  "lineCounts": {
    "Player": 8,
    "卡夏": 39,
    "派蒙": 23
  },
  "subQuests": [
    {
      "subId": "7600902",
      "subQuestName": "(test)隐藏$HIDDEN",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "760090201"
        ],
        "dialogs": {
          "760090201": {
            "id": "760090201",
            "speakerId": 1000,
            "speakerName": "卡夏",
            "text": "嗯…好像也不是这一块…",
            "nextDialogs": [
              "760090202"
            ]
          },
          "760090202": {
            "id": "760090202",
            "speakerId": 1000,
            "speakerName": "卡夏",
            "text": "#啊，你们好呀，没见过的{M#大哥哥}{F#大姐姐}，还有…嗯，白白的精灵小姐？",
            "nextDialogs": [
              "760090203"
            ]
          },
          "760090203": {
            "id": "760090203",
            "speakerId": 1000,
            "speakerName": "卡夏",
            "text": "#欢迎{M#哥哥姐姐}{F#姐姐们}来到霜月之坊！有什么需要帮助的吗？",
            "nextDialogs": [
              "760090204"
            ]
          },
          "760090204": {
            "id": "760090204",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "#没有没有，只是看你一个人在这里，稍微有点好奇而已啦。顺带一提，我是派蒙，{M#他}{F#她}是{NICKNAME}。",
            "nextDialogs": [
              "760090205"
            ]
          },
          "760090205": {
            "id": "760090205",
            "speakerId": 1000,
            "speakerName": "卡夏",
            "text": "#嗯嗯，那就是{NICKNAME}{M#哥哥}{F#姐姐}和派蒙姐姐！看样子，你们好像不是那夏镇那边的人呢。",
            "nextDialogs": [
              "760090207",
              "760090209"
            ]
          },
          "760090207": {
            "id": "760090207",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "#是的，{NICKNAME}和我可是超厉害的冒险家！",
            "nextDialogs": [
              "760090211"
            ]
          },
          "760090211": {
            "id": "760090211",
            "speakerId": 1000,
            "speakerName": "卡夏",
            "text": "真好呀。能和好朋友一起去各种各样的地方探险，见到不同的风景…",
            "nextDialogs": [
              "760090212"
            ]
          },
          "760090212": {
            "id": "760090212",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "没错没错，我们已经去过好多好多地方啦。所以你刚才一个人在这边做什么呢？是在找什么东西吗？",
            "nextDialogs": [
              "760090213"
            ]
          },
          "760090213": {
            "id": "760090213",
            "speakerId": 1000,
            "speakerName": "卡夏",
            "text": "嗯，我在找漂亮的石头呢。",
            "nextDialogs": [
              "760090214"
            ]
          },
          "760090214": {
            "id": "760090214",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "啊，我明白了，是用来收藏的吧！不只是小孩子，有些大人也有这样的爱好呢！",
            "nextDialogs": [
              "760090215"
            ]
          },
          "760090215": {
            "id": "760090215",
            "speakerId": 1000,
            "speakerName": "卡夏",
            "text": "欸，不是喔？我是要用漂亮的石头收买小梅，让她拐走我啦。",
            "nextDialogs": [
              "760090216"
            ]
          },
          "760090216": {
            "id": "760090216",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "哦哦，原来如此，是为了让她拐…等等，你在说什么东西？！"
          },
          "760090209": {
            "id": "760090209",
            "speakerId": 1000,
            "speakerName": "卡夏",
            "text": "#哇啊，听起来好帅气！那我也可以成为{NICKNAME}{M#哥哥}{F#姐姐}的随从吗？就像故事里一样！",
            "nextDialogs": [
              "760090210"
            ]
          },
          "760090210": {
            "id": "760090210",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "你在胡说什么啦，我们只是经过这里的冒险家吧！才没有什么在幕后操纵那夏镇各方势力的打算…应该没有吧？"
          }
        }
      }
    },
    {
      "subId": "7600903",
      "subQuestName": "在附近寻找「漂亮的石头」",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "760090301"
        ],
        "dialogs": {
          "760090301": {
            "id": "760090301",
            "speakerId": 1000,
            "speakerName": "卡夏",
            "text": "#虽然我已经不是小孩子了，但还是够不到那么高的地方呢…{NICKNAME}{M#哥哥}{F#姐姐}，能帮我试一下吗？"
          }
        }
      }
    },
    {
      "subId": "7600907",
      "subQuestName": "与卡夏对话",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "760090501"
        ],
        "dialogs": {
          "760090501": {
            "id": "760090501",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "我们回来啦！卡夏，你看这个能算漂亮的石头吗？",
            "nextDialogs": [
              "760090502"
            ]
          },
          "760090502": {
            "id": "760090502",
            "speakerId": 1000,
            "speakerName": "卡夏",
            "text": "#哇，好快！{NICKNAME}{M#哥哥}{F#姐姐}不愧是专业冒险家，好厉害！",
            "nextDialogs": [
              "760090503"
            ]
          },
          "760090503": {
            "id": "760090503",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "嘿嘿，这种小事轻而易举啦。又不是让我们在几百米深的迷宫里钻洞，或者去相隔几千米的地方分别留影之类的…",
            "nextDialogs": [
              "760090504"
            ]
          },
          "760090504": {
            "id": "760090504",
            "speakerId": 1000,
            "speakerName": "卡夏",
            "text": "嗯…嗯？",
            "nextDialogs": [
              "760090505"
            ]
          },
          "760090505": {
            "id": "760090505",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "咦，怎么了吗？",
            "nextDialogs": [
              "760090506"
            ]
          },
          "760090506": {
            "id": "760090506",
            "speakerId": 1000,
            "speakerName": "卡夏",
            "text": "嗯…虽然确实是很漂亮的石头，但总觉得它好像在被这块大石头吸引呢…",
            "nextDialogs": [
              "760090507"
            ]
          },
          "760090507": {
            "id": "760090507",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "欸？我怎么完全没有感觉到？",
            "nextDialogs": [
              "760090508"
            ]
          },
          "760090508": {
            "id": "760090508",
            "speakerId": 1000,
            "speakerName": "卡夏",
            "text": "我也不是很清楚啦…只是一种模糊的预感而已。",
            "nextDialogs": [
              "760090509"
            ]
          },
          "760090509": {
            "id": "760090509",
            "speakerId": 1000,
            "speakerName": "卡夏",
            "text": "就好像…小梅也说过，雷德·米勒也正是感受到了月神大人的指引，才遇到了妖精公主。我的预感一定也是同样的东西吧？",
            "nextDialogs": [
              "760090510"
            ]
          },
          "760090510": {
            "id": "760090510",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "哦哦！这就是传说中的预知未来…不对，月神大人应该也没有那么闲吧？",
            "nextDialogs": [
              "760090511"
            ]
          },
          "760090511": {
            "id": "760090511",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "所以…你的预感是要你做什么啊？",
            "nextDialogs": [
              "760090512"
            ]
          },
          "760090512": {
            "id": "760090512",
            "speakerId": 1000,
            "speakerName": "卡夏",
            "text": "嗯…比如说，将这块石头，放回那里？",
            "nextDialogs": [
              "760090513"
            ]
          },
          "760090513": {
            "id": "760090513",
            "speakerId": 1000,
            "speakerName": "卡夏",
            "text": "#虽然我已经不是小孩子了，但还是够不到那么高的地方呢…{NICKNAME}{M#哥哥}{F#姐姐}，能帮我试一下吗？"
          }
        }
      }
    },
    {
      "subId": "7600904",
      "subQuestName": "将碎片安放到石头上",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [],
        "dialogs": {}
      }
    },
    {
      "subId": "7600905",
      "subQuestName": "与卡夏对话",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [],
        "dialogs": {}
      }
    },
    {
      "subId": "7600906",
      "subQuestName": "与卡夏对话",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "760090601"
        ],
        "dialogs": {
          "760090601": {
            "id": "760090601",
            "speakerId": 1000,
            "speakerName": "卡夏",
            "text": "哇啊，我的预感果然是对的！只要把两块石头放在一起，就会发生好厉害好厉害的事！",
            "nextDialogs": [
              "760090602"
            ]
          },
          "760090602": {
            "id": "760090602",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "呃，但是这样一来，刚才找到的石头也就没了…",
            "nextDialogs": [
              "760090603"
            ]
          },
          "760090603": {
            "id": "760090603",
            "speakerId": 1000,
            "speakerName": "卡夏",
            "text": "欸？没关系啦。派蒙姐姐是不是忘了，我一开始要找碎片，只是为了收买小梅…",
            "nextDialogs": [
              "760090604"
            ]
          },
          "760090604": {
            "id": "760090604",
            "speakerId": 1000,
            "speakerName": "卡夏",
            "text": "既然已经有了石头突然飞走的「故事」，那石头本身就不重要啦。毕竟，小梅那么会讲故事，一定也喜欢新的故事吧！",
            "nextDialogs": [
              "760090605"
            ]
          },
          "760090605": {
            "id": "760090605",
            "speakerId": 1000,
            "speakerName": "卡夏",
            "text": "#那就谢谢你们啦，{NICKNAME}{M#哥哥}{F#姐姐}，还有派蒙姐姐！虽然过程和我想得不太一样，但还是谢谢你们帮忙！",
            "nextDialogs": [
              "760090606"
            ]
          },
          "760090606": {
            "id": "760090606",
            "speakerId": 1000,
            "speakerName": "卡夏",
            "text": "#对了，这是我刚才找到的石头！因为也很好看，所以就送给{NICKNAME}{M#哥哥}{F#姐姐}作为谢礼吧！"
          }
        }
      }
    },
    {
      "subId": "7600901",
      "subQuestName": "(test)废弃$HIDDEN",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "760090101"
        ],
        "dialogs": {
          "760090101": {
            "id": "760090101",
            "speakerId": 1000,
            "speakerName": "卡夏",
            "text": "#谢谢你们，好心的{M#哥哥姐姐}{F#姐姐们}！要是附近能找到<color=#00E1FFFF>漂亮的石头</color>就好啦…"
          }
        }
      }
    }
  ]
}
        "dialogs": {
          "761850201": {
            "id": "761850201",
            "speakerId": 1316,
            "speakerName": "奈芙尔",
            "text": "搭配着「情报」喝下的茶，味道就是不一样。",
            "nextDialogs": [
              "761850202"
            ]
          },
          "761850202": {
            "id": "761850202",
            "speakerId": 1319,
            "speakerName": "「木偶」",
            "text": "（再这么坐一会儿吧。）",
            "nextDialogs": [
              "761850204"
            ]
          },
          "761850204": {
            "id": "761850204",
            "speakerId": 1316,
            "speakerName": "奈芙尔",
            "text": "哦，慢走。有空常来。"
          }
        }
      }
    },

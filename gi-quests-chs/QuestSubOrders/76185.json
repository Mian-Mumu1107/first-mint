{
  "lineCounts": {
    "「木偶」": 9,
    "奈芙尔": 12,
    "阿舍鲁": 3
  },
  "subQuests": [
    {
      "subId": "7618501",
      "subQuestName": "前往秘闻馆开启茶会",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "761850101"
        ],
        "dialogs": {
          "761850101": {
            "id": "761850101",
            "speakerId": 1316,
            "speakerName": "奈芙尔",
            "text": "嗯，美味的茶水点心。多谢桑多涅小姐的招待。",
            "nextDialogs": [
              "761850102"
            ]
          },
          "761850102": {
            "id": "761850102",
            "speakerId": 1319,
            "speakerName": "「木偶」",
            "text": "没什么，你中意就好。我还带了些阿舍鲁喜欢的零食。对不对？阿舍鲁？过来，乖。",
            "nextDialogs": [
              "761850103"
            ]
          },
          "761850103": {
            "id": "761850103",
            "speakerId": 16110,
            "speakerName": "阿舍鲁",
            "text": "喵~",
            "nextDialogs": [
              "761850104"
            ]
          },
          "761850104": {
            "id": "761850104",
            "speakerId": 1316,
            "speakerName": "奈芙尔",
            "text": "希望你同挪德卡莱，以及同「秘闻馆」的这份情谊，能够对未来我们之间的合作有所益处。",
            "nextDialogs": [
              "761850105"
            ]
          },
          "761850105": {
            "id": "761850105",
            "speakerId": 1319,
            "speakerName": "「木偶」",
            "text": "嗯，我也希望如此。来，阿舍鲁，尝尝这个。",
            "nextDialogs": [
              "761850106"
            ]
          },
          "761850106": {
            "id": "761850106",
            "speakerId": 1316,
            "speakerName": "奈芙尔",
            "text": "另外，关于之前向桑多涅小姐打听的…",
            "nextDialogs": [
              "761850107"
            ]
          },
          "761850107": {
            "id": "761850107",
            "speakerId": 1319,
            "speakerName": "「木偶」",
            "text": "哈哈，你这小肉垫真软。",
            "nextDialogs": [
              "761850108"
            ]
          },
          "761850108": {
            "id": "761850108",
            "speakerId": 1316,
            "speakerName": "奈芙尔",
            "text": "……",
            "nextDialogs": [
              "761850109"
            ]
          },
          "761850109": {
            "id": "761850109",
            "speakerId": 1316,
            "speakerName": "奈芙尔",
            "text": "桑多涅小姐…你该不会是借茶会的名义来我这里揉猫的吧？",
            "nextDialogs": [
              "761850110"
            ]
          },
          "761850110": {
            "id": "761850110",
            "speakerId": 1319,
            "speakerName": "「木偶」",
            "text": "欸…？有，有吗？没有的事！和「秘闻馆」的往来我也放在心上的！",
            "nextDialogs": [
              "761850111"
            ]
          },
          "761850111": {
            "id": "761850111",
            "speakerId": 1316,
            "speakerName": "奈芙尔",
            "text": "过来，阿舍鲁。",
            "nextDialogs": [
              "761850112"
            ]
          },
          "761850112": {
            "id": "761850112",
            "speakerId": 16110,
            "speakerName": "阿舍鲁",
            "text": "喵~",
            "nextDialogs": [
              "761850113"
            ]
          },
          "761850113": {
            "id": "761850113",
            "speakerId": 1319,
            "speakerName": "「木偶」",
            "text": "啊…",
            "nextDialogs": [
              "761850114"
            ]
          },
          "761850114": {
            "id": "761850114",
            "speakerId": 1316,
            "speakerName": "奈芙尔",
            "text": "那我们具体聊聊「往来」相关的事吧。",
            "nextDialogs": [
              "761850115"
            ]
          },
          "761850115": {
            "id": "761850115",
            "speakerId": 1319,
            "speakerName": "「木偶」",
            "text": "…啧。有…就算有一点点是想揉猫又怎样啦！",
            "nextDialogs": [
              "761850116"
            ]
          },
          "761850116": {
            "id": "761850116",
            "speakerId": 1319,
            "speakerName": "「木偶」",
            "text": "平时很多小动物都不喜欢机械，好不容易前段时间在这里研究「数秘阵列」和阿舍鲁混熟了，揉一下又怎样啦！",
            "nextDialogs": [
              "761850117"
            ]
          },
          "761850117": {
            "id": "761850117",
            "speakerId": 1316,
            "speakerName": "奈芙尔",
            "text": "哈…好吧好吧。",
            "nextDialogs": [
              "761850118"
            ]
          },
          "761850118": {
            "id": "761850118",
            "speakerId": 1316,
            "speakerName": "奈芙尔",
            "text": "去吧，阿舍鲁。反正我也管不了你喜欢蹭谁。",
            "nextDialogs": [
              "761850119"
            ]
          },
          "761850119": {
            "id": "761850119",
            "speakerId": 16110,
            "speakerName": "阿舍鲁",
            "text": "喵~",
            "nextDialogs": [
              "761850120"
            ]
          },
          "761850120": {
            "id": "761850120",
            "speakerId": 1316,
            "speakerName": "奈芙尔",
            "text": "揉个痛快之后别忘了聊正事啊…",
            "nextDialogs": [
              "761850121"
            ]
          },
          "761850121": {
            "id": "761850121",
            "speakerId": 1319,
            "speakerName": "「木偶」",
            "text": "说了我有放在心上的！"
          }
        }
      }
    },
    {
      "subId": "7618502",
      "subQuestName": "前往秘闻馆开启茶会",
      "sceneId": null,
      "locations": [],
      "dialogue": {

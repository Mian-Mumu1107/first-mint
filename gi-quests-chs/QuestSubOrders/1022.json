    {
      "subId": "102206",
      "subQuestName": "(test)甘雨对话，获得异种琉璃百合$HIDDEN",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "10220601"
        ],
        "dialogs": {
          "10220601": {
            "id": "10220601",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "它们根本不是琉璃百合，琉璃百合怎么会打人！",
            "nextDialogs": [
              "10220602"
            ]
          },
          "10220602": {
            "id": "10220602",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "超乎想象的敌人…",
            "nextDialogs": [
              "10220603"
            ]
          },
          "10220603": {
            "id": "10220603",
            "speakerId": 1001,
            "speakerName": "钟离",
            "text": "这是一种叫做「骗骗花」的魔物。",
            "nextDialogs": [
              "10220604"
            ]
          },
          "10220604": {
            "id": "10220604",
            "speakerId": 1001,
            "speakerName": "钟离",
            "text": "嗯？这些花瓣…？有点意思。",
            "nextDialogs": [
              "10220605"
            ]
          },
          "10220605": {
            "id": "10220605",
            "speakerId": 1001,
            "speakerName": "钟离",
            "text": "用于伪装的琉璃百合，与「骗骗花」一起埋了太久，反倒成了极好的药材。因祸得福…把这些花瓣收起来吧。",
            "nextDialogs": [
              "10220606"
            ]
          },
          "10220606": {
            "id": "10220606",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "还有这种好事？那这些花瓣可以用在送仙典仪上吗？",
            "nextDialogs": [
              "10220607"
            ]
          },
          "10220607": {
            "id": "10220607",
            "speakerId": 1001,
            "speakerName": "钟离",
            "text": "很遗憾，不能。",
            "nextDialogs": [
              "10220608"
            ]
          },
          "10220608": {
            "id": "10220608",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "啊，怎么这样——",
            "nextDialogs": [
              "10220609"
            ]
          },
          "10220609": {
            "id": "10220609",
            "speakerId": 1002,
            "speakerName": "甘雨",
            "text": "请问…",
            "nextDialogs": [
              "10220610"
            ]
          },
          "10220610": {
            "id": "10220610",
            "speakerId": 1002,
            "speakerName": "甘雨",
            "text": "你们是在找琉璃百合吗？",
            "nextDialogs": [
              "10220611"
            ]
          },
          "10220611": {
            "id": "10220611",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "啊！是你！呃、呃…糟糕，想不起名字…",
            "nextDialogs": [
              "10220613",
              "10220615"
            ]
          },
          "10220613": {
            "id": "10220613",
            "speakerId": 1002,
            "speakerName": "甘雨",
            "text": "你好，旅行者，没想到你还记得我的名字。",
            "nextDialogs": [
              "10220617"
            ]
          },
          "10220617": {
            "id": "10220617",
            "speakerId": 1002,
            "speakerName": "甘雨",
            "text": "说起来，二位的「群玉阁」之行，感受如何？",
            "nextDialogs": [
              "10220618"
            ]
          },
          "10220618": {
            "id": "10220618",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "因为你没告诉我们怎么上去，所以我们费了好大力气才找到路呢！",
            "nextDialogs": [
              "10220619"
            ]
          },
          "10220619": {
            "id": "10220619",
            "speakerId": 1002,
            "speakerName": "甘雨",
            "text": "哎哎哎？我、我没说吗？！",
            "nextDialogs": [
              "10220620"
            ]
          },
          "10220620": {
            "id": "10220620",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "我们靠自己打听来的！"
          },
          "10220615": {
            "id": "10220615",
            "speakerId": 1002,
            "speakerName": "甘雨",
            "text": "王小美？那、那是谁啊？",
            "nextDialogs": [
              "10220616"
            ]
          },
          "10220616": {
            "id": "10220616",
            "speakerId": 1002,
            "speakerName": "甘雨",
            "text": "甘雨和王小美，根本一个字都没记对吧…"
          }
        }
      }
    },
    {
      "subId": "102207",
      "subQuestName": "返回璃月港外",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [],

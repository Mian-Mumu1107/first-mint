      }
    },
    {
      "subId": "102208",
      "subQuestName": "打听消息",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "10220801"
        ],
        "dialogs": {
          "10220801": {
            "id": "10220801",
            "speakerId": 1003,
            "speakerName": "菲利克斯",
            "text": "喔，是「往生堂」的客卿，钟离先生吧。",
            "nextDialogs": [
              "10220802"
            ]
          },
          "10220802": {
            "id": "10220802",
            "speakerId": 1003,
            "speakerName": "菲利克斯",
            "text": "千岩军正在对我们严加监视，现在是非常时期，你可别轻举妄动。",
            "nextDialogs": [
              "10220803"
            ]
          },
          "10220803": {
            "id": "10220803",
            "speakerId": 1001,
            "speakerName": "钟离",
            "text": "非常时期？",
            "nextDialogs": [
              "10220804"
            ]
          },
          "10220804": {
            "id": "10220804",
            "speakerId": 1003,
            "speakerName": "菲利克斯",
            "text": "「绝云间」的仙人终于动身了。他们此来，恐怕来意不善。",
            "nextDialogs": [
              "10220805"
            ]
          },
          "10220805": {
            "id": "10220805",
            "speakerId": 1001,
            "speakerName": "钟离",
            "text": "是为兴师问罪么？",
            "nextDialogs": [
              "10220806"
            ]
          },
          "10220806": {
            "id": "10220806",
            "speakerId": 1003,
            "speakerName": "菲利克斯",
            "text": "多半是这样。听说七星中的几位，早早地带人前去迎接…嘿，说是迎接，不如说想要把仙人阻拦在城外吧。",
            "nextDialogs": [
              "10220807"
            ]
          },
          "10220807": {
            "id": "10220807",
            "speakerId": 1003,
            "speakerName": "菲利克斯",
            "text": "但双方态度都很强硬，一时陷入了僵局。",
            "nextDialogs": [
              "10220808"
            ]
          },
          "10220808": {
            "id": "10220808",
            "speakerId": 1001,
            "speakerName": "钟离",
            "text": "…事情走到这一步，也是必然。",
            "nextDialogs": [
              "10220809"
            ]
          },
          "10220809": {
            "id": "10220809",
            "speakerId": 1003,
            "speakerName": "菲利克斯",
            "text": "仙人不认七星，只认与岩神的「契约」。如果他们决定强攻，这璃月港恐怕是挡不住的。",
            "nextDialogs": [
              "10220810"
            ]
          },
          "10220810": {
            "id": "10220810",
            "speakerId": 1001,
            "speakerName": "钟离",
            "text": "但「璃月七星」也不是坐以待毙的人。",
            "nextDialogs": [
              "10220811"
            ]
          },
          "10220811": {
            "id": "10220811",
            "speakerId": 1003,
            "speakerName": "菲利克斯",
            "text": "哼，谁不知道他们态度强硬？但就因为这样，人和仙的矛盾才会一触即发！",
            "nextDialogs": [
              "10220812"
            ]
          },
          "10220812": {
            "id": "10220812",
            "speakerId": 1001,
            "speakerName": "钟离",
            "text": "然后呢？怎么「愚人众」反倒成了众矢之的？",
            "nextDialogs": [
              "10220813"
            ]
          },
          "10220813": {
            "id": "10220813",
            "speakerId": 1003,
            "speakerName": "菲利克斯",
            "text": "呼…还不是因为那个凝光…",
            "nextDialogs": [
              "10220814"
            ]
          },
          "10220814": {
            "id": "10220814",
            "speakerId": 1003,
            "speakerName": "菲利克斯",
            "text": "说什么「在这山雨欲来的时刻，要千岩军彻底控制愚人众的动向」。",
            "nextDialogs": [
              "10220815"
            ]
          },
          "10220815": {
            "id": "10220815",
            "speakerId": 1003,
            "speakerName": "菲利克斯",
            "text": "切！现在才想起来要限制我们的行动？七星也不过如此！",
            "nextDialogs": [
              "10220816"
            ]
          },
          "10220816": {
            "id": "10220816",
            "speakerId": 1003,
            "speakerName": "菲利克斯",
            "text": "总之，钟离先生，你是「公子」大人的合作者，你的态度也有一半是我们的态度，可别让人抓到把柄。",
            "nextDialogs": [
              "10220817"
            ]
          },
          "10220817": {
            "id": "10220817",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "看来，璃月港里的各种矛盾，都已经彻底达到极限了…",
            "nextDialogs": [
              "10220820"
            ]
          },
          "10220820": {
            "id": "10220820",
            "speakerId": 1001,
            "speakerName": "钟离",
            "text": "你的意思是，想要凭特殊的中立身份出面调解？还是想要靠你个人的武力改变某些平衡？",
            "nextDialogs": [
              "10220821"
            ]
          },
          "10220821": {
            "id": "10220821",
            "speakerId": 1001,
            "speakerName": "钟离",
            "text": "这两条路，恐怕都不那么容易吧…",
            "nextDialogs": [
              "10220822"
            ]
          },
          "10220822": {
            "id": "10220822",
            "speakerId": 1003,
            "speakerName": "菲利克斯",
            "text": "啊，对了！钟离先生。我听说你们「往生堂」，好像也被卷进了冲突里，正在与找上门来的官军对峙呢！",
            "nextDialogs": [
              "10220823"
            ]
          },
          "10220823": {
            "id": "10220823",
            "speakerId": 1001,
            "speakerName": "钟离",
            "text": "…这可不妙。",
            "nextDialogs": [
              "10220824"
            ]
          },
          "10220824": {

    {
      "subId": "102202",
      "subQuestName": "查看愚人众的研究",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "10220201"
        ],
        "dialogs": {
          "10220201": {
            "id": "10220201",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "这里有好多符咒，还有好几叠空白的纸，会是做什么用的呢？",
            "nextDialogs": [
              "10220204"
            ]
          },
          "10220204": {
            "id": "10220204",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "这上面的图案，似乎在哪见过…",
            "nextDialogs": [
              "10220205"
            ]
          },
          "10220205": {
            "id": "10220205",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "我想起来了，「公子」给你的那张「百无禁忌箓」，确实也长这样呢。",
            "nextDialogs": [
              "10220206"
            ]
          },
          "10220206": {
            "id": "10220206",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "嗯…这种和仙人有关的信物，为什么会落到「公子」手里，也确实相当可疑。",
            "nextDialogs": [
              "10220207"
            ]
          },
          "10220207": {
            "id": "10220207",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "而且，不止是「信物」…",
            "nextDialogs": [
              "10220208"
            ]
          },
          "10220208": {
            "id": "10220208",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "对哦，留云借风真君说过，岩王爷当年造「百无禁忌箓」的时候，不是当作信物来用的。",
            "nextDialogs": [
              "10220209"
            ]
          },
          "10220209": {
            "id": "10220209",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "这种符咒最初的用途，是在魔神战争当中，用来发挥神力…",
            "nextDialogs": [
              "10220210"
            ]
          },
          "10220210": {
            "id": "10220210",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "愚人众这样抄写「百无禁忌箓」，是想尝试用什么方法来引导出类似真品的效果吗？",
            "nextDialogs": [
              "10220211"
            ]
          },
          "10220211": {
            "id": "10220211",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "在战争中发挥神力的效果…唔，听起来很凶险。"
          }
        }
      }
    },
    {
      "subId": "102203",
      "subQuestName": "去荻花洲见钟离",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "10220301"
        ],
        "dialogs": {
          "10220301": {
            "id": "10220301",
            "speakerId": 1001,
            "speakerName": "钟离",
            "text": "你们很准时嘛，我也刚到不久。",
            "nextDialogs": [
              "10220302"
            ]
          },
          "10220302": {
            "id": "10220302",
            "speakerId": 1001,
            "speakerName": "钟离",
            "text": "群玉阁好玩吗？",
            "nextDialogs": [
              "10220303"
            ]
          },
          "10220303": {
            "id": "10220303",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "超——大！超华丽，超贵，是我见过最贵的建筑！",
            "nextDialogs": [
              "10220304"
            ]
          },
          "10220304": {
            "id": "10220304",
            "speakerId": 1001,
            "speakerName": "钟离",
            "text": "确实。群玉阁若称第二，璃月便无人敢称第一。",
            "nextDialogs": [
              "10220305"
            ]
          },
          "10220305": {
            "id": "10220305",
            "speakerId": 1001,
            "speakerName": "钟离",
            "text": "你们应该见过凝光了。聊得如何？",
            "nextDialogs": [
              "10220306"
            ]
          },
          "10220306": {
            "id": "10220306",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "她好有钱，好慷慨，是很亲切的人！",
            "nextDialogs": [
              "10220307"
            ]
          },
          "10220307": {
            "id": "10220307",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "但「亲切」也是商人的武器。",
            "nextDialogs": [
              "10220308"
            ]
          },
          "10220308": {
            "id": "10220308",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "#嗯…{PLAYERAVATAR#SEXPRO[INFO_MALE_PRONOUN_HE|INFO_FEMALE_PRONOUN_SHE]}对凝光的看法和我不一样。{PLAYERAVATAR#SEXPRO[INFO_MALE_PRONOUN_HE|INFO_FEMALE_PRONOUN_SHE]}觉得，还是那位说话过于直白的「玉衡星」更加可信一些。",
            "nextDialogs": [
              "10220309"
            ]
          },
          "10220309": {
            "id": "10220309",
            "speakerId": 1001,
            "speakerName": "钟离",
            "text": "哦？你们还遇到刻晴了？她对你们说了什么吗？",
            "nextDialogs": [
              "10220310"
            ]
          },
          "10220310": {
            "id": "10220310",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "她说，「『仙人』的时代已经过去了，如果连『璃月七星』都不敢正视这一点，那璃月的未来要怎么办啊？」",
            "nextDialogs": [
              "10220311"
            ]
          },
          "10220311": {
            "id": "10220311",
            "speakerId": 1001,
            "speakerName": "钟离",
            "text": "哈哈哈…不敬仙神。",
            "nextDialogs": [
              "10220312"
            ]
          },
          "10220312": {
            "id": "10220312",
            "speakerId": 1001,
            "speakerName": "钟离",
            "text": "的确，比起什么话都敢说的刻晴，同为七星，还是凝光更像一位典型的商人。",
            "nextDialogs": [
              "10220313"
            ]
          },
          "10220313": {
            "id": "10220313",
            "speakerId": 1001,
            "speakerName": "钟离",
            "text": "虽然亲切，但你无法确定她是百分之百的真诚。",
            "nextDialogs": [
              "10220316"
            ]
          },
          "10220316": {
            "id": "10220316",
            "speakerId": 1001,
            "speakerName": "钟离",
            "text": "嗯，她能坐上今天的位置，全靠自己。这样的人物，必定有其超凡之处。",
            "nextDialogs": [
              "10220317"
            ]
          },
          "10220317": {
            "id": "10220317",
            "speakerId": 1001,
            "speakerName": "钟离",
            "text": "我听说，不断扩建的「群玉阁」正是她志向的体现，是她人生中第二重要的东西。哪怕放弃天权之位，她也不会放弃群玉阁。",
            "nextDialogs": [
              "10220318"
            ]
          },
          "10220318": {
            "id": "10220318",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "群玉阁是第二位？那排第一位的呢？",
            "nextDialogs": [
              "10220319"
            ]
          },
          "10220319": {
            "id": "10220319",
            "speakerId": 1001,
            "speakerName": "钟离",
            "text": "当然是摩拉了。"
          }
        }
      }
    },
    {
      "subId": "102204",
      "subQuestName": "随钟离寻找野生琉璃百合",
      "sceneId": null,
      "locations": [],
      "dialogue": {

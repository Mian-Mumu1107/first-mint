          "10220401": {
            "id": "10220401",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "是时候一展歌喉了，加油！",
            "nextDialogs": [
              "10220402"
            ]
          },
          "10220402": {
            "id": "10220402",

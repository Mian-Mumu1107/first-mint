  "subQuests": [
    {
      "subId": "2204801",
      "subQuestName": "与寝子对话",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "220480101"
        ],
        "dialogs": {
          "220480101": {
            "id": "220480101",
            "speakerId": 3189,
            "speakerName": "「寝子」",
            "text": "神社又有些乱了啊…",
            "nextDialogs": [
              "220480102"
            ]
          },
          "220480102": {
            "id": "220480102",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "怎么了？",
            "nextDialogs": [
              "220480103"
            ]
          },
          "220480103": {
            "id": "220480103",
            "speakerId": 3189,
            "speakerName": "「寝子」",
            "text": "唔喵，是汝等啊，来得正好。",
            "nextDialogs": [
              "220480104"
            ]
          },
          "220480104": {
            "id": "220480104",
            "speakerId": 3189,
            "speakerName": "「寝子」",
            "text": "神社周围又有些乱了，落叶都积在地上，很难看。",
            "nextDialogs": [
              "220480105"
            ]
          },
          "220480105": {
            "id": "220480105",
            "speakerId": 3189,
            "speakerName": "「寝子」",
            "text": "这样子可不能接待来神社的人类啊…",
            "nextDialogs": [
              "220480106"
            ]
          },
          "220480106": {
            "id": "220480106",
            "speakerId": 3189,
            "speakerName": "「寝子」",
            "text": "汝等，能和上次一样，帮奴家打扫一下神社吗？",
            "nextDialogs": [
              "220480108",
              "220480113"
            ]
          },
          "220480108": {
            "id": "220480108",
            "speakerId": 3189,
            "speakerName": "「寝子」",
            "text": "奴家可不会去主动找那两个绿绿的人类说话。",
            "nextDialogs": [
              "220480109"
            ]
          },
          "220480109": {
            "id": "220480109",
            "speakerId": 3189,
            "speakerName": "「寝子」",
            "text": "那个高高的人类，看奴家的眼神总是很奇怪…",
            "nextDialogs": [
              "220480110"
            ]
          },
          "220480110": {
            "id": "220480110",
            "speakerId": 3189,
            "speakerName": "「寝子」",
            "text": "另外一个绿绿的人类，又总是那副提不起劲的样子。",
            "nextDialogs": [
              "220480111"
            ]
          },
          "220480111": {
            "id": "220480111",
            "speakerId": 3189,
            "speakerName": "「寝子」",
            "text": "喵喵，无论怎么想，都是两个靠不住的人类。",
            "nextDialogs": [
              "220480115"
            ]
          },
          "220480115": {
            "id": "220480115",
            "speakerId": 3189,
            "speakerName": "「寝子」",
            "text": "总之，就拜托汝等了。就和上次一样，用长棍子来「打扫」，汝等明白了吗？"
          },
          "220480113": {
            "id": "220480113",
            "speakerId": 3189,
            "speakerName": "「寝子」",
            "text": "那个石头人类一直在忙个不停，不知道在咚咚咚地敲什么…",
            "nextDialogs": [
              "220480114"
            ]
          },
          "220480114": {
            "id": "220480114",
            "speakerId": 3189,
            "speakerName": "「寝子」",
            "text": "明明石头已经敲好了，为什么还在咚咚咚呢，真烦…"
          }
        }
      }
    },
    {
      "subId": "2204802",
      "subQuestName": "打扫浅濑神社周围的落叶",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "220480201"
        ],
        "dialogs": {
          "220480201": {
            "id": "220480201",
            "speakerId": 3189,
            "speakerName": "「寝子」",
            "text": "总之，「打扫」就拜托汝等了，奴家就在这里等着汝等，喵喵。"
          }
        }
      }
    },
    {
      "subId": "2204803",
      "subQuestName": "向寝子回报",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "220480301"
        ],
        "dialogs": {
          "220480301": {
            "id": "220480301",
            "speakerId": 3189,
            "speakerName": "「寝子」",
            "text": "喔，汝等已经「打扫」完了吗？",
            "nextDialogs": [
              "220480302"
            ]
          },
          "220480302": {
            "id": "220480302",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "已经打扫完了。",
            "nextDialogs": [
              "220480303"
            ]
          },
          "220480303": {
            "id": "220480303",
            "speakerId": 3189,
            "speakerName": "「寝子」",
            "text": "喵喵，那就好，汝等果然非常可靠啊。",
            "nextDialogs": [
              "220480304"
            ]
          },
          "220480304": {
            "id": "220480304",
            "speakerId": 3189,
            "speakerName": "「寝子」",
            "text": "神社真是越来越像样了，等阿响回来了之后，她一定会非常高兴的。",
            "nextDialogs": [
              "220480305"
            ]
          },
          "220480305": {
            "id": "220480305",
            "speakerId": 3189,
            "speakerName": "「寝子」",
            "text": "奴家一定要好好打理神社才行…喵喵…"
          }
        }
      }
    }
  ]
}
    {
      "subId": "4003502",
      "subQuestName": "与凝光对话",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "400350201"
        ],
        "dialogs": {
          "400350201": {
            "id": "400350201",
            "speakerId": 10211,
            "speakerName": "凝光",
            "text": "…这份通知送去总务司，让他们把上面列出的各项工作整理安排给各部门。",
            "nextDialogs": [
              "400350202"
            ]
          },
          "400350202": {
            "id": "400350202",
            "speakerId": 10211,
            "speakerName": "凝光",
            "text": "转告他们，海灯节诸事繁杂，但无论大小工作都要办妥办好。",
            "nextDialogs": [
              "400350203"
            ]
          },
          "400350203": {
            "id": "400350203",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "凝光小姐！嘿嘿，我们又来玩啦！",
            "nextDialogs": [
              "400350204"
            ]
          },
          "400350204": {
            "id": "400350204",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "没有打扰你吧？",
            "nextDialogs": [
              "400350205"
            ]
          },
          "400350205": {
            "id": "400350205",
            "speakerId": 10211,
            "speakerName": "凝光",
            "text": "贵客来访，怎么能说是打扰。",
            "nextDialogs": [
              "400350206"
            ]
          },
          "400350206": {
            "id": "400350206",
            "speakerId": 10211,
            "speakerName": "凝光",
            "text": "看你们的样子，是来璃月过海灯节的吧？",
            "nextDialogs": [
              "400350207"
            ]
          },
          "400350207": {
            "id": "400350207",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "是呀！今年海灯节你们都在忙什么？",
            "nextDialogs": [
              "400350208"
            ]
          },
          "400350208": {
            "id": "400350208",
            "speakerId": 10211,
            "speakerName": "凝光",
            "text": "还是老样子，各种杂事。对了，总务司今年策划了一场「烟花会」，值得一看哦。",
            "nextDialogs": [
              "400350221"
            ]
          },
          "400350221": {
            "id": "400350221",
            "speakerId": 10211,
            "speakerName": "凝光",
            "text": "海灯节向来以放飞「明霄灯」为节日重点，但最近璃月发生了许多事。我想，人们需要更多温暖与团结感。",
            "nextDialogs": [
              "400350222"
            ]
          },
          "400350222": {
            "id": "400350222",
            "speakerId": 10211,
            "speakerName": "凝光",
            "text": "所以我认为，至少今年我们要采取更特别也更贴近每一个人的庆祝方式。",
            "nextDialogs": [
              "400350223"
            ]
          },
          "400350223": {
            "id": "400350223",
            "speakerId": 10211,
            "speakerName": "凝光",
            "text": "将「烟花」送至璃月各处，选择合适的时间全数点燃。让更为炽热的光与热连接起人们的情感，这便是总务司的决定。",
            "nextDialogs": [
              "400350209"
            ]
          },
          "400350209": {
            "id": "400350209",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "烟花？我们在别的地方似乎也见过烟花哦。",
            "nextDialogs": [
              "400350210"
            ]
          },
          "400350210": {
            "id": "400350210",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "璃月的烟花有什么特别之处吗？",
            "nextDialogs": [
              "400350211"
            ]
          },
          "400350211": {
            "id": "400350211",
            "speakerId": 10211,
            "speakerName": "凝光",
            "text": "烟花这一事物，最早是从璃月的某种发明演变而来的。",
            "nextDialogs": [
              "400350212"
            ]
          },
          "400350212": {
            "id": "400350212",
            "speakerId": 10211,
            "speakerName": "凝光",
            "text": "璃月祖先创造烟花时，为它取名「爆竹」。它能发出强光与巨响，可用于驱赶毒蛇猛兽或是警示他人。",
            "nextDialogs": [
              "400350213"
            ]
          },
          "400350213": {
            "id": "400350213",
            "speakerId": 10211,
            "speakerName": "凝光",
            "text": "早年人们在外耕种，联络不便。「爆竹」一物因能发出巨响，必要时会被用来传递信号。",
            "nextDialogs": [
              "400350214"
            ]
          },
          "400350214": {
            "id": "400350214",
            "speakerId": 10211,
            "speakerName": "凝光",
            "text": "璃月港正式建立后，人们生活好转，不再赶往百里之外的土地耕种。渐渐地，也不再靠「爆竹」防身。",
            "nextDialogs": [
              "400350215"
            ]
          },
          "400350215": {
            "id": "400350215",
            "speakerId": 10211,
            "speakerName": "凝光",
            "text": "但先民手持「爆竹」艰苦垦荒的精神被延续下来，作为一种习俗流传在民间。",
            "nextDialogs": [
              "400350216"
            ]
          },
          "400350216": {
            "id": "400350216",
            "speakerId": 10211,
            "speakerName": "凝光",
            "text": "「爆竹」便是烟花的前身。我们改良了「爆竹」，放到海灯节期间燃放，以这种形式来纪念先民们的奋斗精神。",
            "nextDialogs": [
              "400350217"
            ]
          },
          "400350217": {
            "id": "400350217",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "不愧是璃月。",
            "nextDialogs": [
              "400350218"
            ]
          },
          "400350218": {
            "id": "400350218",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "真厉害…璃月的东西都好有历史渊源啊…",
            "nextDialogs": [
              "400350219"
            ]
          },
          "400350219": {
            "id": "400350219",
            "speakerId": 10211,
            "speakerName": "凝光",
            "text": "相信你们也已经习惯了。历史越久远，土地上的每一件事物就会承载越多价值。这便是璃月。",
            "nextDialogs": [
              "400350220"
            ]
          },
          "400350220": {
            "id": "400350220",
            "speakerId": 10211,
            "speakerName": "凝光",
            "text": "烟花相关的事务，我交由刻晴负责了。如果你们对烟花感兴趣，就随我一同去见她吧。"
          }
        }
      }
    },
    {
      "subId": "4003503",
      "subQuestName": "前往璃月烟花摊",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "400350301"
        ],
        "dialogs": {
          "400350301": {
            "id": "400350301",
            "speakerId": 1016,
            "speakerName": "刻晴",
            "text": "唔…布置烟花的地点还得再加几个。眼光要全面，不能局限在城里，难道轻策庄的人就不过海灯节了吗？",
            "nextDialogs": [
              "400350302"
            ]
          },
          "400350302": {
            "id": "400350302",
            "speakerId": 30090,
            "speakerName": "朋义",
            "text": "但、但是大人，这样的话，预算就…",
            "nextDialogs": [
              "400350303"
            ]
          },
          "400350303": {
            "id": "400350303",
            "speakerId": 1016,
            "speakerName": "刻晴",
            "text": "预算是什么？是「办好某件事最合适的量」。",
            "nextDialogs": [
              "400350304"
            ]
          },
          "400350304": {
            "id": "400350304",
            "speakerId": 1016,
            "speakerName": "刻晴",
            "text": "如果你认为现在的预算不够办好这件事，就向总务司提出申请，重新核算审批。",
            "nextDialogs": [
              "400350305"
            ]
          },
          "400350305": {
            "id": "400350305",
            "speakerId": 1016,
            "speakerName": "刻晴",
            "text": "我们的目的是办好这届海灯节，预算是为了更好地规划，不能本末倒置啊。",
            "nextDialogs": [
              "400350306"
            ]
          },
          "400350306": {
            "id": "400350306",
            "speakerId": 30090,
            "speakerName": "朋义",
            "text": "是，我明白了，刻晴大人。",
            "nextDialogs": [
              "400350307"
            ]
          },
          "400350307": {
            "id": "400350307",
            "speakerId": 1016,
            "speakerName": "刻晴",
            "text": "嗯。安全第一，务必保证。",
            "nextDialogs": [
              "400350308"
            ]
          },
          "400350308": {
            "id": "400350308",
            "speakerId": 1016,
            "speakerName": "刻晴",
            "text": "凝光，旅行者。难得见你们过来。",
            "nextDialogs": [
              "400350309"
            ]
          },
          "400350309": {
            "id": "400350309",
            "speakerId": 1016,
            "speakerName": "刻晴",
            "text": "旅行者是来参加海灯节的吗？刚好再过不久应该就能准备完毕了。",
            "nextDialogs": [
              "400350310"
            ]
          },
          "400350310": {
            "id": "400350310",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "刻晴在忙什么？",
            "nextDialogs": [
              "400350311"
            ]
          },
          "400350311": {
            "id": "400350311",
            "speakerId": 1016,
            "speakerName": "刻晴",
            "text": "复核烟花布置，再检查一下相关设施。算是日常的小工作。",
            "nextDialogs": [
              "400350312"
            ]
          },
          "400350312": {
            "id": "400350312",
            "speakerId": 10211,
            "speakerName": "凝光",
            "text": "恕我直言，这类工作交给下属处理也行。你已经连轴转了好几天，也该休息了。",
            "nextDialogs": [
              "400350313"
            ]
          },
          "400350313": {
            "id": "400350313",
            "speakerId": 1016,
            "speakerName": "刻晴",
            "text": "小事而已，无妨。",
            "nextDialogs": [
              "400350314"
            ]
          },
          "400350314": {
            "id": "400350314",
            "speakerId": 1016,
            "speakerName": "刻晴",
            "text": "朋义，劳烦你重新做个规划，总结成书面报告递交到总务司。",
            "nextDialogs": [
              "400350315"
            ]
          },
          "400350315": {
            "id": "400350315",
            "speakerId": 1016,
            "speakerName": "刻晴",
            "text": "我去城里看看烟花布置点的情况，稍后回来。",
            "nextDialogs": [
              "400350316"
            ]
          },
          "400350316": {
            "id": "400350316",
            "speakerId": 1016,
            "speakerName": "刻晴",
            "text": "旅行者，你是贵客，适逢佳节，还请留在城内好好享受节日氛围。",
            "nextDialogs": [
              "400350317"
            ]
          },
          "400350317": {
            "id": "400350317",
            "speakerId": 1016,
            "speakerName": "刻晴",
            "text": "朋义，我交代你的事，都记住了吗？",
            "nextDialogs": [
              "400350318"
            ]
          },
          "400350318": {
            "id": "400350318",
            "speakerId": 30090,
            "speakerName": "朋义",
            "text": "是，记清楚了！",
            "nextDialogs": [
              "400350319"
            ]
          },
          "400350319": {
            "id": "400350319",
            "speakerId": 1016,
            "speakerName": "刻晴",
            "text": "好。凝光，旅行者，告辞。",
            "nextDialogs": [
              "400350320"
            ]
          },
          "400350320": {
            "id": "400350320",
            "speakerId": 30090,
            "speakerName": "朋义",
            "text": "凝光大人，还有这位…旅行者，我就先不打扰二位了。",
            "nextDialogs": [
              "400350321"
            ]
          },
          "400350321": {
            "id": "400350321",
            "speakerId": 30090,
            "speakerName": "朋义",
            "text": "刻晴大人跟我讲了好多计划，我得重新去写一份计划书…抓紧时间，抓紧时间。",
            "nextDialogs": [
              "400350355"
            ]
          },
          "400350355": {
            "id": "400350355",
            "speakerId": 30090,
            "speakerName": "朋义",
            "text": "啊对！差点忘了…",
            "nextDialogs": [
              "400350356"
            ]
          },
          "400350356": {
            "id": "400350356",
            "speakerId": 30090,
            "speakerName": "朋义",
            "text": "旅行者，这里有个「烟花筒」，刻晴大人之前提过你可能会感兴趣，让我留着它，等见到你就交给你。",
            "nextDialogs": [
              "400350357"
            ]
          },
          "400350357": {
            "id": "400350357",
            "speakerId": 30090,
            "speakerName": "朋义",
            "text": "有动手能力的人，有了这个就能亲手调配制作属于自己的烟花了。你要是有时间，请务必试试！",
            "nextDialogs": [
              "400350322"
            ]
          },
          "400350322": {
            "id": "400350322",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "刚才我完全插不上话欸…",
            "nextDialogs": [
              "400350323"
            ]
          },
          "400350323": {
            "id": "400350323",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "不对，应该说，我是「完全不敢插话」！",
            "nextDialogs": [
              "400350324"
            ]
          },
          "400350324": {
            "id": "400350324",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "刻晴，好强的气势…",
            "nextDialogs": [
              "400350325"
            ]
          },
          "400350325": {
            "id": "400350325",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "你也这么觉得对吧？刻晴的气势比之前更强了！",
            "nextDialogs": [
              "400350326"
            ]
          },
          "400350326": {
            "id": "400350326",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "而且也比之前更忙…为什么呀？",
            "nextDialogs": [
              "400350327"
            ]
          },
          "400350327": {
            "id": "400350327",
            "speakerId": 10211,
            "speakerName": "凝光",
            "text": "众仙家将璃月港交由凡人全权治理，我们七星便担起了引导民众的责任。",
            "nextDialogs": [
              "400350328"
            ]
          },
          "400350328": {
            "id": "400350328",
            "speakerId": 10211,
            "speakerName": "凝光",
            "text": "我们接手各个领域的重要工作，紧锣密鼓地安排各项事宜。",
            "nextDialogs": [
              "400350329"
            ]
          },
          "400350329": {
            "id": "400350329",
            "speakerId": 10211,
            "speakerName": "凝光",
            "text": "话虽如此，事事亲为仍很费神。",
            "nextDialogs": [
              "400350330"
            ]
          },
          "400350330": {
            "id": "400350330",
            "speakerId": 10211,
            "speakerName": "凝光",
            "text": "往年，海灯节相关的统筹事宜都由江舟负责。但她家中老父年迈，今年便请调去了其他部门。",
            "nextDialogs": [
              "400350331"
            ]
          },
          "400350331": {
            "id": "400350331",
            "speakerId": 10211,
            "speakerName": "凝光",
            "text": "海灯节的工作，便落到了我和刻晴肩上。我担任总负责人，至于万众瞩目的「烟花会」，就交给刻晴了。",
            "nextDialogs": [
              "400350332"
            ]
          },
          "400350332": {
            "id": "400350332",
            "speakerId": 10211,
            "speakerName": "凝光",
            "text": "兹事体大，我认为，应当托付给最可靠的人。而刻晴严于律己，又对工作充满热忱，是最佳人选。",
            "nextDialogs": [
              "400350333"
            ]
          },
          "400350333": {
            "id": "400350333",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "确实是非常严格的人呀…",
            "nextDialogs": [
              "400350334"
            ]
          },
          "400350334": {
            "id": "400350334",
            "speakerId": 10211,
            "speakerName": "凝光",
            "text": "不错。对人对己都万分严格，以至于投入过度，连续操劳了好些日子。",
            "nextDialogs": [
              "400350335"
            ]
          },
          "400350335": {
            "id": "400350335",
            "speakerId": 10211,
            "speakerName": "凝光",
            "text": "我认为，这不是长久之计。",
            "nextDialogs": [
              "400350336"
            ]
          },
          "400350336": {
            "id": "400350336",
            "speakerId": 10211,
            "speakerName": "凝光",
            "text": "过犹不及，是璃月人都该懂得的道理。",
            "nextDialogs": [
              "400350337"
            ]
          },
          "400350337": {
            "id": "400350337",
            "speakerId": 10211,
            "speakerName": "凝光",
            "text": "我不是没劝过她，但她的性格你们也知道。巧舌如簧的人遇上刻晴，也是要碰一鼻子灰的。",
            "nextDialogs": [
              "400350338"
            ]
          },
          "400350338": {
            "id": "400350338",
            "speakerId": 10211,
            "speakerName": "凝光",
            "text": "旅行者，你跟刻晴关系不错，又见识广阔，不如也帮我劝劝她？",
            "nextDialogs": [
              "400350341"
            ]
          },
          "400350341": {
            "id": "400350341",
            "speakerId": 10211,
            "speakerName": "凝光",
            "text": "不愧是旅行者。劝说刻晴绝非易事，有你帮忙我也安心得多。",
            "nextDialogs": [
              "400350342"
            ]
          },
          "400350342": {
            "id": "400350342",
            "speakerId": 10211,
            "speakerName": "凝光",
            "text": "我还得回群玉阁处理些事务，先行一步。刻晴的事，就劳你多费心了。",
            "nextDialogs": [
              "400350343"
            ]
          },
          "400350343": {
            "id": "400350343",
            "speakerId": 1004,
            "speakerName": "Black Screen",
            "text": "凝光离开了…",
            "nextDialogs": [
              "400350344"
            ]
          },
          "400350344": {
            "id": "400350344",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "你真的有办法说服刻晴吗？连凝光小姐都搞不定她欸…",
            "nextDialogs": [
              "400350345"
            ]
          },
          "400350345": {
            "id": "400350345",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "而且，想要说服一个人，至少得理解那个人现在的感受吧。",
            "nextDialogs": [
              "400350346"
            ]
          },
          "400350346": {
            "id": "400350346",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "刻晴现在应该是连续操劳，连休息日都没有…",
            "nextDialogs": [
              "400350347"
            ]
          },
          "400350347": {
            "id": "400350347",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "感受是…「很累」？",
            "nextDialogs": [
              "400350348"
            ]
          },
          "400350348": {
            "id": "400350348",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "这么浅显的理解根本没用吧！再想想，更重要更深入的感受是什么？",
            "nextDialogs": [
              "400350349"
            ]
          },
          "400350349": {
            "id": "400350349",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "或者，我们找个有心得的可靠的朋友问问吧？",
            "nextDialogs": [
              "400350350"
            ]
          },
          "400350350": {
            "id": "400350350",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "那就找钟离吧。",
            "nextDialogs": [
              "400350351"
            ]
          },
          "400350351": {
            "id": "400350351",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "嗯？钟离…？",
            "nextDialogs": [
              "400350352"
            ]
          },
          "400350352": {
            "id": "400350352",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "他也比较了解璃月人。",
            "nextDialogs": [
              "400350353"
            ]
          },
          "400350353": {
            "id": "400350353",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "嗯，确实很可靠！就问他吧！",
            "nextDialogs": [
              "400350354"
            ]
          },
          "400350354": {
            "id": "400350354",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "他现在是「往生堂」的客卿，那我们就去「往生堂」找找他吧！"
          }
        }
      }
    },
    {
      "subId": "4003506",
      "subQuestName": "前往往生堂寻找钟离",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "400350601"
        ],
        "dialogs": {
          "400350601": {
            "id": "400350601",
            "speakerId": 2084,
            "speakerName": "摆渡人",
            "text": "……",
            "nextDialogs": [
              "400350602"
            ]
          },
          "400350602": {
            "id": "400350602",
            "speakerId": 2084,
            "speakerName": "摆渡人",
            "text": "二位好。请问有什么事吗？",
            "nextDialogs": [
              "400350603"
            ]
          },
          "400350603": {
            "id": "400350603",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "我想找客卿钟离…",
            "nextDialogs": [
              "400350604"
            ]
          },
          "400350604": {
            "id": "400350604",
            "speakerId": 2084,
            "speakerName": "摆渡人",
            "text": "客卿跟堂主一起出门了。",
            "nextDialogs": [
              "400350605"
            ]
          },
          "400350605": {
            "id": "400350605",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "两个人都出门了？难、难道他们是去工作…",
            "nextDialogs": [
              "400350606"
            ]
          },
          "400350606": {
            "id": "400350606",
            "speakerId": 2084,
            "speakerName": "摆渡人",
            "text": "堂主说，是去散步。",
            "nextDialogs": [
              "400350607"
            ]
          },
          "400350607": {
            "id": "400350607",
            "speakerId": 2084,
            "speakerName": "摆渡人",
            "text": "如果二位要找他们，可以去「三碗不过港」看看。",
            "nextDialogs": [
              "400350608"
            ]
          },
          "400350608": {
            "id": "400350608",
            "speakerId": 2084,
            "speakerName": "摆渡人",
            "text": "听说，堂主经常去那一带…做宣传。"
          }
        }
      }
    },
    {
      "subId": "4003507",
      "subQuestName": "前往「三碗不过港」",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "400350701"
        ],
        "dialogs": {
          "400350701": {
            "id": "400350701",
            "speakerId": 1021,
            "speakerName": "胡桃",
            "text": "呼——吃饱了吃饱了！",
            "nextDialogs": [
              "400350787"
            ]
          },
          "400350787": {
            "id": "400350787",
            "speakerId": 1043,
            "speakerName": "锅巴",
            "text": "♪！",
            "nextDialogs": [
              "400350702"
            ]
          },
          "400350702": {
            "id": "400350702",
            "speakerId": 1021,
            "speakerName": "胡桃",
            "text": "香菱呀，真亏你能想出那种烤鱼配蘸水的新吃法，特别是那碗蘸水，味道可真好。",
            "nextDialogs": [
              "400350703"
            ]
          },
          "400350703": {
            "id": "400350703",
            "speakerId": 1012,
            "speakerName": "香菱",
            "text": "嘿嘿，那可是我的特制蘸水，味道当然好啦。",
            "nextDialogs": [
              "400350704"
            ]
          },
          "400350704": {
            "id": "400350704",
            "speakerId": 10232,
            "speakerName": "钟离",
            "text": "干煸绝云椒椒磨成粉，加蒜泥、葱段拌匀，再加入盐、醋、酱油，最后以滚油钓香。",
            "nextDialogs": [
              "400350705"
            ]
          },
          "400350705": {
            "id": "400350705",
            "speakerId": 10232,
            "speakerName": "钟离",
            "text": "看似粗犷的手法背后，是厨师对口味与调料比例的精准理解。多一分则多，少一分则少。",
            "nextDialogs": [
              "400350706"
            ]
          },
          "400350706": {
            "id": "400350706",
            "speakerId": 10232,
            "speakerName": "钟离",
            "text": "此谓之「精道」。",
            "nextDialogs": [
              "400350780"
            ]
          },
          "400350780": {
            "id": "400350780",
            "speakerId": 1021,
            "speakerName": "胡桃",
            "text": "嗯嗯嗯对对。怎么样香菱，夸到你心坎里了吧？",
            "nextDialogs": [
              "400350781"
            ]
          },
          "400350781": {
            "id": "400350781",
            "speakerId": 1012,
            "speakerName": "香菱",
            "text": "嘿嘿…怪害羞的呢…谢谢钟离先生！",
            "nextDialogs": [
              "400350782"
            ]
          },
          "400350782": {
            "id": "400350782",
            "speakerId": 1021,
            "speakerName": "胡桃",
            "text": "我觉得吧，我这个人已经很能说会道了，没想到跟你一比，还是不够看。",
            "nextDialogs": [
              "400350783"
            ]
          },
          "400350783": {
            "id": "400350783",
            "speakerId": 10232,
            "speakerName": "钟离",
            "text": "堂主何必跟我客气。堂主的口才，整座璃月港有目共睹。",
            "nextDialogs": [
              "400350784"
            ]
          },
          "400350784": {
            "id": "400350784",
            "speakerId": 1043,
            "speakerName": "锅巴",
            "text": "♪~♪~",
            "nextDialogs": [
              "400350785"
            ]
          },
          "400350785": {
            "id": "400350785",
            "speakerId": 1021,
            "speakerName": "胡桃",
            "text": "锅巴要来点什么吗？不用客气，本堂主请你！账记香菱头上就好。",
            "nextDialogs": [
              "400350786"
            ]
          },
          "400350786": {
            "id": "400350786",
            "speakerId": 1043,
            "speakerName": "锅巴",
            "text": "？",
            "nextDialogs": [
              "400350707"
            ]
          },
          "400350707": {
            "id": "400350707",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "你们又在说什么好吃的啦？",
            "nextDialogs": [
              "400350708"
            ]
          },
          "400350708": {
            "id": "400350708",
            "speakerId": 1021,
            "speakerName": "胡桃",
            "text": "哟！是旅行者和派蒙啊，什么风把你们吹来啦？",
            "nextDialogs": [
              "400350709"
            ]
          },
          "400350709": {
            "id": "400350709",
            "speakerId": 1021,
            "speakerName": "胡桃",
            "text": "慢着！先别说，让本堂主细细算来…唔，是来过海灯节的吧！",
            "nextDialogs": [
              "400350710"
            ]
          },
          "400350710": {
            "id": "400350710",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "一看就看出来了吧，还用猜吗？",
            "nextDialogs": [
              "400350711"
            ]
          },
          "400350711": {
            "id": "400350711",
            "speakerId": 1021,
            "speakerName": "胡桃",
            "text": "哎呀，这不是跟你们熟，逗你们乐嘛！",
            "nextDialogs": [
              "400350712"
            ]
          },
          "400350712": {
            "id": "400350712",
            "speakerId": 1012,
            "speakerName": "香菱",
            "text": "你们来得刚好，我正在请大家试吃新菜呢！",
            "nextDialogs": [
              "400350779"
            ]
          },
          "400350779": {
            "id": "400350779",
            "speakerId": 1012,
            "speakerName": "香菱",
            "text": "「三碗不过港」的老板给了好评，钟离先生和胡桃也都满意，但我总觉得，还得请更多人试试才行…",
            "nextDialogs": [
              "400350713"
            ]
          },
          "400350713": {
            "id": "400350713",
            "speakerId": 1012,
            "speakerName": "香菱",
            "text": "怎么样，你们要吃吃看吗？",
            "nextDialogs": [
              "400350714"
            ]
          },
          "400350714": {
            "id": "400350714",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "要吃要吃！",
            "nextDialogs": [
              "400350715"
            ]
          },
          "400350715": {
            "id": "400350715",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "我们是来找钟离先生的。",
            "nextDialogs": [
              "400350716"
            ]
          },
          "400350716": {
            "id": "400350716",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "啊？不、不吃吗？好吧…那先办正事…",
            "nextDialogs": [
              "400350717"
            ]
          },
          "400350717": {
            "id": "400350717",
            "speakerId": 10232,
            "speakerName": "钟离",
            "text": "许久不见，近来旅行可还顺利？",
            "nextDialogs": [
              "400350718"
            ]
          },
          "400350718": {
            "id": "400350718",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "还不错，长了不少见识。",
            "nextDialogs": [
              "400350719"
            ]
          },
          "400350719": {
            "id": "400350719",
            "speakerId": 10232,
            "speakerName": "钟离",
            "text": "如此甚好。",
            "nextDialogs": [
              "400350720"
            ]
          },
          "400350720": {
            "id": "400350720",
            "speakerId": 1021,
            "speakerName": "胡桃",
            "text": "所以呢所以呢？找咱们客卿有何贵干呀？",
            "nextDialogs": [
              "400350721"
            ]
          },
          "400350721": {
            "id": "400350721",
            "speakerId": 1021,
            "speakerName": "胡桃",
            "text": "先说好，我们今天出门也有正事要办哦！试菜只是顺便啦。",
            "nextDialogs": [
              "400350722"
            ]
          },
          "400350722": {
            "id": "400350722",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "办、办事，不能是往生堂的事吧？明明在过节呢…",
            "nextDialogs": [
              "400350723"
            ]
          },
          "400350723": {
            "id": "400350723",
            "speakerId": 1021,
            "speakerName": "胡桃",
            "text": "过节也有生老病死是不是？别大惊小怪的。好啦，吓唬你的，我是想着今天天气不错，出来看看街景，顺道宣传一下业务…",
            "nextDialogs": [
              "400350724"
            ]
          },
          "400350724": {
            "id": "400350724",
            "speakerId": 1021,
            "speakerName": "胡桃",
            "text": "你们聊着吧，我跟香菱去老板那边蹭点茶喝。钟离忙完记得找我就行！",
            "nextDialogs": [
              "400350725"
            ]
          },
          "400350725": {
            "id": "400350725",
            "speakerId": 10232,
            "speakerName": "钟离",
            "text": "可以。堂主慢走。",
            "nextDialogs": [
              "400350726"
            ]
          },
          "400350726": {
            "id": "400350726",
            "speakerId": 10232,
            "speakerName": "钟离",
            "text": "旅行者，发生什么事了？",
            "nextDialogs": [
              "400350727"
            ]
          },
          "400350727": {
            "id": "400350727",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "事情是这样的…",
            "nextDialogs": [
              "400350728"
            ]
          },
          "400350728": {
            "id": "400350728",
            "speakerId": 1004,
            "speakerName": "Black Screen",
            "text": "向钟离说明了刻晴的情况…",
            "nextDialogs": [
              "400350729"
            ]
          },
          "400350729": {
            "id": "400350729",
            "speakerId": 10232,
            "speakerName": "钟离",
            "text": "玉衡星为人刚正又聪敏勤勉，自是栋梁之才。不过，凡事均有度，还是身体要紧。",
            "nextDialogs": [
              "400350730"
            ]
          },
          "400350730": {
            "id": "400350730",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "有什么办法劝劝她吗？",
            "nextDialogs": [
              "400350731"
            ]
          },
          "400350731": {
            "id": "400350731",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "对呀对呀，你说话总是很有道理的样子，她应该会听你的吧！",
            "nextDialogs": [
              "400350732"
            ]
          },
          "400350732": {
            "id": "400350732",
            "speakerId": 10232,
            "speakerName": "钟离",
            "text": "我若是岩王帝君，尚能说服她几分。但我如今是一介客卿，也得考虑身份了。",
            "nextDialogs": [
              "400350733"
            ]
          },
          "400350733": {
            "id": "400350733",
            "speakerId": 10232,
            "speakerName": "钟离",
            "text": "何况玉衡星和我并不算熟识，冒昧进言说教，只会招人反感。",
            "nextDialogs": [
              "400350734"
            ]
          },
          "400350734": {
            "id": "400350734",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "欸？那怎么办…",
            "nextDialogs": [
              "400350735"
            ]
          },
          "400350735": {
            "id": "400350735",
            "speakerId": 10232,
            "speakerName": "钟离",
            "text": "旁敲侧击，或可一试。",
            "nextDialogs": [
              "400350736"
            ]
          },
          "400350736": {
            "id": "400350736",
            "speakerId": 10232,
            "speakerName": "钟离",
            "text": "要是有一个能让她动容的故事，就能将你要说的道理融入其中了。",
            "nextDialogs": [
              "400350737"
            ]
          },
          "400350737": {
            "id": "400350737",
            "speakerId": 10232,
            "speakerName": "钟离",
            "text": "取材自生活，便能赢得共鸣。话中谈及亲近的人事，更能事半功倍。",
            "nextDialogs": [
              "400350738"
            ]
          },
          "400350738": {
            "id": "400350738",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "呃…是什么意思呀…",
            "nextDialogs": [
              "400350739"
            ]
          },
          "400350739": {
            "id": "400350739",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "我们去找熟悉刻晴的人问问。",
            "nextDialogs": [
              "400350740"
            ]
          },
          "400350740": {
            "id": "400350740",
            "speakerId": 10232,
            "speakerName": "钟离",
            "text": "旅行者果真是一点就通。",
            "nextDialogs": [
              "400350741"
            ]
          },
          "400350741": {
            "id": "400350741",
            "speakerId": 10232,
            "speakerName": "钟离",
            "text": "寻些素材来吧。你若愿意，我也可以帮着提些建议。",
            "nextDialogs": [
              "400350742"
            ]
          },
          "400350742": {
            "id": "400350742",
            "speakerId": 10232,
            "speakerName": "钟离",
            "text": "构思妥当后，将此故事经你之口说与玉衡星即可。",
            "nextDialogs": [
              "400350743"
            ]
          },
          "400350743": {
            "id": "400350743",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "我？",
            "nextDialogs": [
              "400350744"
            ]
          },
          "400350744": {
            "id": "400350744",
            "speakerId": 10232,
            "speakerName": "钟离",
            "text": "玉衡星与你有交情。要说人选，你最是合适。",
            "nextDialogs": [
              "400350745"
            ]
          },
          "400350745": {
            "id": "400350745",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "原来是这样！也就是说，找刻晴认识的人多打听对吧？从谁先开始呢？",
            "nextDialogs": [
              "400350746"
            ]
          },
          "400350746": {
            "id": "400350746",
            "speakerId": 1016,
            "speakerName": "刻晴",
            "text": "原来你们在这里。",
            "nextDialogs": [
              "400350747"
            ]
          },
          "400350747": {
            "id": "400350747",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "咦？刻、刻晴！",
            "nextDialogs": [
              "400350748"
            ]
          },
          "400350748": {
            "id": "400350748",
            "speakerId": 1016,
            "speakerName": "刻晴",
            "text": "没想到钟离先生也在。上次「送仙典仪」还是多亏了先生帮忙。",
            "nextDialogs": [
              "400350749"
            ]
          },
          "400350749": {
            "id": "400350749",
            "speakerId": 10232,
            "speakerName": "钟离",
            "text": "帮了些小忙而已，玉衡星不必客气。",
            "nextDialogs": [
              "400350750"
            ]
          },
          "400350750": {
            "id": "400350750",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "你、你怎么来了？",
            "nextDialogs": [
              "400350751"
            ]
          },
          "400350751": {
            "id": "400350751",
            "speakerId": 1016,
            "speakerName": "刻晴",
            "text": "怎么了？你们的表情为什么这么奇怪？",
            "nextDialogs": [
              "400350752"
            ]
          },
          "400350752": {
            "id": "400350752",
            "speakerId": 1016,
            "speakerName": "刻晴",
            "text": "莫非是我来得太突然，打扰到你和钟离先生谈话了？抱歉…",
            "nextDialogs": [
              "400350753"
            ]
          },
          "400350753": {
            "id": "400350753",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "不不，没打扰没打扰。",
            "nextDialogs": [
              "400350754"
            ]
          },
          "400350754": {
            "id": "400350754",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "刻晴怎么突然想到要找我们？",
            "nextDialogs": [
              "400350755"
            ]
          },
          "400350755": {
            "id": "400350755",
            "speakerId": 1016,
            "speakerName": "刻晴",
            "text": "我来，是想请你们将我引见给仙家。佳节将至，我要代表璃月七星给各路仙家送些礼物。",
            "nextDialogs": [
              "400350756"
            ]
          },
          "400350756": {
            "id": "400350756",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "上次跟仙人们并肩作战的时候，他们不都见过你了吗？",
            "nextDialogs": [
              "400350757"
            ]
          },
          "400350757": {
            "id": "400350757",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "既然认识，直接去绝云间就行啦。",
            "nextDialogs": [
              "400350758"
            ]
          },
          "400350758": {
            "id": "400350758",
            "speakerId": 1016,
            "speakerName": "刻晴",
            "text": "一面之缘而已，仙人们或许已经记不得我了。贸然访问，怕是会惹人不快。",
            "nextDialogs": [
              "400350759"
            ]
          },
          "400350759": {
            "id": "400350759",
            "speakerId": 1016,
            "speakerName": "刻晴",
            "text": "所以我想，请你们引见才是最符合礼数的做法。",
            "nextDialogs": [
              "400350764",
              "400350762"
            ]
          },
          "400350764": {
            "id": "400350764",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "原来还要负责上门送礼，做七星可真辛苦啊…",
            "nextDialogs": [
              "400350765"
            ]
          },
          "400350765": {
            "id": "400350765",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "我们会帮忙的。",
            "nextDialogs": [
              "400350766"
            ]
          },
          "400350766": {
            "id": "400350766",
            "speakerId": 1016,
            "speakerName": "刻晴",
            "text": "好，那便说定了。我先回去准备礼物。",
            "nextDialogs": [
              "400350767"
            ]
          },
          "400350767": {
            "id": "400350767",
            "speakerId": 1016,
            "speakerName": "刻晴",
            "text": "大好的节日却要麻烦你陪着我东奔西跑，实在抱歉…我们速战速决，绝不耽搁你看烟花的行程。",
            "nextDialogs": [
              "400350768"
            ]
          },
          "400350768": {
            "id": "400350768",
            "speakerId": 1016,
            "speakerName": "刻晴",
            "text": "那不如一起去看烟花吧！",
            "nextDialogs": [
              "400350769"
            ]
          },
          "400350769": {
            "id": "400350769",
            "speakerId": 1016,
            "speakerName": "刻晴",
            "text": "欸？一、一起吗？",
            "nextDialogs": [
              "400350770"
            ]
          },
          "400350770": {
            "id": "400350770",
            "speakerId": 1016,
            "speakerName": "刻晴",
            "text": "也好，等我忙完手上的事，就随你一起去。",
            "nextDialogs": [
              "400350771"
            ]
          },
          "400350771": {
            "id": "400350771",
            "speakerId": 1016,
            "speakerName": "刻晴",
            "text": "钟离先生也是。今年的「烟花会」质量不错，先生切莫错过。",
            "nextDialogs": [
              "400350772"
            ]
          },
          "400350772": {
            "id": "400350772",
            "speakerId": 10232,
            "speakerName": "钟离",
            "text": "当然。多谢提醒。",
            "nextDialogs": [
              "400350773"
            ]
          },
          "400350773": {
            "id": "400350773",
            "speakerId": 1016,
            "speakerName": "刻晴",
            "text": "我先去忙了。旅行者，你准备完毕直接来群玉阁找我吧。",
            "nextDialogs": [
              "400350774"
            ]
          },
          "400350774": {
            "id": "400350774",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "走掉了呢。",
            "nextDialogs": [
              "400350775"
            ]
          },
          "400350775": {
            "id": "400350775",
            "speakerId": 10232,
            "speakerName": "钟离",
            "text": "玉衡星办事向来雷厉风行，令人安心。",
            "nextDialogs": [
              "400350776"
            ]
          },
          "400350776": {
            "id": "400350776",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "#钟离你也很可靠啊！对吧{NICKNAME}？",
            "nextDialogs": [
              "400350777"
            ]
          },
          "400350777": {
            "id": "400350777",
            "speakerId": 10232,
            "speakerName": "钟离",
            "text": "承蒙夸奖。",
            "nextDialogs": [
              "400350778"
            ]
          },
          "400350778": {
            "id": "400350778",
            "speakerId": 10232,
            "speakerName": "钟离",
            "text": "刚才说的事，也请二位记在心上。等你们搜集了足够多的素材，我们可以约在此处，再做商讨。"
          },
          "400350762": {
            "id": "400350762",
            "speakerId": 1016,
            "speakerName": "刻晴",
            "text": "甘雨这几天请假，一时半会儿找不到她。",
            "nextDialogs": [
              "400350763"
            ]
          },
          "400350763": {
            "id": "400350763",
            "speakerId": 1016,
            "speakerName": "刻晴",
            "text": "还是麻烦你吧。"
          }
        }
      }
    },
    {
      "subId": "4003508",

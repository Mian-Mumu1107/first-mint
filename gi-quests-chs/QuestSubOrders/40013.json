    {
      "subId": "4001304",
      "subQuestName": "(test)取得鳞片进度记录$HIDDEN",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "400130401"
        ],
        "dialogs": {
          "400130401": {
            "id": "400130401",
            "speakerId": 10090,
            "speakerName": "可莉",
            "text": "#荣誉骑士{PLAYERAVATAR#SEXPRO[INFO_MALE_PRONOUN_BROTHER|INFO_FEMALE_PRONOUN_SISTERA]}，要放鳞片了吗？",
            "nextDialogs": [
              "400130402"
            ]
          },
          "400130402": {
            "id": "400130402",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "是的。",
            "nextDialogs": [
              "400130403"
            ]
          },
          "400130403": {
            "id": "400130403",
            "speakerId": 10090,
            "speakerName": "可莉",
            "text": "可莉、可莉够不着…",
            "nextDialogs": [
              "400130404"
            ]
          },
          "400130404": {
            "id": "400130404",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "那我来做可莉的帮手。",
            "nextDialogs": [
              "400130405"
            ]
          },
          "400130405": {
            "id": "400130405",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "可莉说「好」，我再放，好吗？",
            "nextDialogs": [
              "400130406"
            ]
          },
          "400130406": {
            "id": "400130406",
            "speakerId": 10090,
            "speakerName": "可莉",
            "text": "嗯，好！",
            "nextDialogs": [
              "400130407"
            ]
          },
          "400130407": {
            "id": "400130407",
            "speakerId": 10090,
            "speakerName": "可莉",
            "text": "不过不过，可莉也不懂这些…",
            "nextDialogs": [
              "400130408"
            ]
          },
          "400130408": {
            "id": "400130408",
            "speakerId": 10090,
            "speakerName": "可莉",
            "text": "可莉相信你！你替可莉放，肯定没问题！",
            "nextDialogs": [
              "400130409"
            ]
          },
          "400130409": {
            "id": "400130409",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "那么，鱼鳞我们来放，最后最重要的机关就让可莉按吧。",
            "nextDialogs": [
              "400130410"
            ]
          },
          "400130410": {
            "id": "400130410",
            "speakerId": 10090,
            "speakerName": "可莉",
            "text": "好啊好啊！",
            "nextDialogs": [
              "400130411"
            ]
          },
          "400130411": {
            "id": "400130411",
            "speakerId": 10090,
            "speakerName": "可莉",
            "text": "终于要见到你了，嘟嘟大魔王！哼哼，显出原形！",
            "nextDialogs": [
              "400130412"
            ]
          },
          "400130412": {
            "id": "400130412",
            "speakerId": 1006,
            "speakerName": "琴",
            "text": "可莉…兴致真高啊。",
            "nextDialogs": [
              "400130413"
            ]
          },
          "400130413": {
            "id": "400130413",
            "speakerId": 10090,
            "speakerName": "可莉",
            "text": "#荣誉骑士{PLAYERAVATAR#SEXPRO[INFO_MALE_PRONOUN_BROTHER|INFO_FEMALE_PRONOUN_SISTERA]}，加油呀，可莉给你打气！"
          }
        }
      }
    },

        "dialogs": {
          "400139901": {
            "id": "400139901",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "天亮了，差不多是时候去看看鱼的情况啦。",
            "nextDialogs": [
              "400139902"
            ]
          },
          "400139902": {
            "id": "400139902",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "先跟大家会合吧！"
          }

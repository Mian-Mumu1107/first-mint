    {
      "subId": "4001310",
      "subQuestName": "回到巨大海螺旁",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "400130301"
        ],
        "dialogs": {
          "400130301": {
            "id": "400130301",
            "speakerId": 1008,
            "speakerName": "芭芭拉",
            "text": "荣誉骑士，这边这边！",
            "nextDialogs": [
              "400130302"
            ]
          },
          "400130302": {
            "id": "400130302",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "鱼的情况怎么样？",
            "nextDialogs": [
              "400130303"
            ]
          },
          "400130303": {
            "id": "400130303",
            "speakerId": 1006,
            "speakerName": "琴",
            "text": "和我们预估的一样，被水晶吸引过来了。",
            "nextDialogs": [
              "400130304"
            ]
          },
          "400130304": {
            "id": "400130304",
            "speakerId": 10090,
            "speakerName": "可莉",
            "text": "捞鱼捞鱼，捞鱼！",
            "nextDialogs": [
              "400130305"
            ]
          },
          "400130305": {
            "id": "400130305",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "啊！不行不行！",
            "nextDialogs": [
              "400130306"
            ]
          },
          "400130306": {
            "id": "400130306",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "为了避免可莉把鱼炸掉，捞鱼还是交给我们吧。毕竟，打捞采摘什么的，我们也是老手了呢。"
          }
        }
      }
    },
    {
      "subId": "4001301",
      "subQuestName": "抓住鱼获取鳞片",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "400130101"
        ],
        "dialogs": {
          "400130101": {
            "id": "400130101",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "可莉——！",
            "nextDialogs": [
              "400130102"
            ]
          },
          "400130102": {
            "id": "400130102",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "我们把鱼鳞放好了哦。",
            "nextDialogs": [
              "400130103"
            ]
          },
          "400130103": {
            "id": "400130103",
            "speakerId": 10090,
            "speakerName": "可莉",
            "text": "你真棒！嘿嘿嘿，那接下来就轮到可莉了对吧？",
            "nextDialogs": [
              "400130104"
            ]
          },
          "400130104": {
            "id": "400130104",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "对，那边的机关就交给你啦！",
            "nextDialogs": [
              "400130105"
            ]
          },
          "400130105": {
            "id": "400130105",
            "speakerId": 10090,
            "speakerName": "可莉",
            "text": "好——！",
            "nextDialogs": [
              "400130106"
            ]
          },
          "400130106": {
            "id": "400130106",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "可莉。",
            "nextDialogs": [
              "400130107"
            ]
          },
          "400130107": {
            "id": "400130107",
            "speakerId": 10090,
            "speakerName": "可莉",
            "text": "嗯？",
            "nextDialogs": [
              "400130110"
            ]
          },
          "400130110": {
            "id": "400130110",
            "speakerId": 10090,
            "speakerName": "可莉",
            "text": "嗯，可莉知道了！",
            "nextDialogs": [
              "400130111"
            ]
          },
          "400130111": {
            "id": "400130111",
            "speakerId": 10090,
            "speakerName": "可莉",
            "text": "……",
            "nextDialogs": [
              "400130112"
            ]
          },
          "400130112": {
            "id": "400130112",
            "speakerId": 1008,
            "speakerName": "芭芭拉",
            "text": "可莉，怎么了吗？",
            "nextDialogs": [
              "400130113"
            ]
          },
          "400130113": {
            "id": "400130113",
            "speakerId": 10090,
            "speakerName": "可莉",
            "text": "可莉…可莉担心…这里面真是嘟嘟大魔王该怎么办？",
            "nextDialogs": [
              "400130114"
            ]
          },
          "400130114": {
            "id": "400130114",
            "speakerId": 10090,
            "speakerName": "可莉",
            "text": "万一嘟嘟大魔王不认同可莉成为嘟嘟可的家人，或者、或者万一可莉输给了他…",
            "nextDialogs": [
              "400130115"
            ]
          },
          "400130115": {
            "id": "400130115",
            "speakerId": 10090,
            "speakerName": "可莉",
            "text": "那嘟嘟可就不能陪着可莉了，妈妈也会很难过…嘟嘟可是妈妈送给可莉的重要朋友。",
            "nextDialogs": [
              "400130116"
            ]
          },
          "400130116": {
            "id": "400130116",
            "speakerId": 10090,
            "speakerName": "可莉",
            "text": "然后就…不敢按了…",
            "nextDialogs": [
              "400130117"
            ]
          },
          "400130117": {
            "id": "400130117",
            "speakerId": 1018,
            "speakerName": "阿贝多",
            "text": "……",
            "nextDialogs": [
              "400130118"
            ]
          },
          "400130118": {
            "id": "400130118",
            "speakerId": 10090,
            "speakerName": "可莉",
            "text": "#荣誉骑士{PLAYERAVATAR#SEXPRO[INFO_MALE_PRONOUN_BROTHER|INFO_FEMALE_PRONOUN_SISTERA]}，能不能请你来帮我按呢？",
            "nextDialogs": [
              "400130119"
            ]
          },
          "400130119": {
            "id": "400130119",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "#可莉，{PLAYERAVATAR#SEXPRO[INFO_MALE_PRONOUN_BROTHER|INFO_FEMALE_PRONOUN_SISTERA]}不能帮你按。",
            "nextDialogs": [
              "400130120"
            ]
          },
          "400130120": {
            "id": "400130120",
            "speakerId": 10090,
            "speakerName": "可莉",
            "text": "为什么呀？",
            "nextDialogs": [
              "400130121"
            ]
          },
          "400130121": {
            "id": "400130121",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "#因为{PLAYERAVATAR#SEXPRO[INFO_MALE_PRONOUN_BROTHER|INFO_FEMALE_PRONOUN_SISTERA]}要握紧武器。",
            "nextDialogs": [
              "400130122"
            ]
          },
          "400130122": {
            "id": "400130122",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "这样就能保护你啦。",
            "nextDialogs": [
              "400130123"
            ]
          },
          "400130123": {
            "id": "400130123",
            "speakerId": 1006,
            "speakerName": "琴",
            "text": "是啊，可莉，我们大家都在这里陪着你。",
            "nextDialogs": [
              "400130124"
            ]
          },
          "400130124": {
            "id": "400130124",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "人多势众说的就是这种场面吧！",
            "nextDialogs": [
              "400130125"
            ]
          },
          "400130125": {
            "id": "400130125",
            "speakerId": 1004,
            "speakerName": "凯亚",
            "text": "不论是什么样的敌人，只要有我们在就不用害怕。",
            "nextDialogs": [
              "400130126"
            ]
          },
          "400130126": {
            "id": "400130126",
            "speakerId": 1009,
            "speakerName": "迪卢克",
            "text": "正好，我也想见识一下这座岛上的敌人有多强。",
            "nextDialogs": [
              "400130127"
            ]
          },
          "400130127": {
            "id": "400130127",
            "speakerId": 1011,
            "speakerName": "雷泽",
            "text": "去吧。",
            "nextDialogs": [
              "400130128"
            ]
          },
          "400130128": {
            "id": "400130128",
            "speakerId": 1011,
            "speakerName": "雷泽",
            "text": "我在这里。",
            "nextDialogs": [
              "400130129"
            ]
          },
          "400130129": {
            "id": "400130129",
            "speakerId": 1008,
            "speakerName": "芭芭拉",
            "text": "大家，不要说这种话呀…万一嘟嘟大魔王只是请可莉去他家友好商谈呢？又或者…对！说不定他已经承认了可莉！",
            "nextDialogs": [
              "400130130"
            ]
          },
          "400130130": {
            "id": "400130130",
            "speakerId": 10090,
            "speakerName": "可莉",
            "text": "他会承认可莉吗？",
            "nextDialogs": [
              "400130131"
            ]
          },
          "400130131": {
            "id": "400130131",
            "speakerId": 1018,
            "speakerName": "阿贝多",
            "text": "为什么不会呢？可莉非常认真，做得很好。",
            "nextDialogs": [
              "400130132"
            ]
          },
          "400130132": {
            "id": "400130132",
            "speakerId": 10090,
            "speakerName": "可莉",
            "text": "真的吗？"
          }
        }
      }
    },
    {
      "subId": "4001302",
      "subQuestName": "抓住鱼获取鳞片",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "400130201"
        ],
        "dialogs": {
          "400130201": {
            "id": "400130201",
            "speakerId": 1006,
            "speakerName": "琴",
            "text": "这是…等等，我都糊涂了，这是什么？！",
            "nextDialogs": [
              "400130202"
            ]
          },
          "400130202": {
            "id": "400130202",
            "speakerId": 1008,
            "speakerName": "芭芭拉",
            "text": "整座岛，简直像是藏在能量罩底下的巨大礼物箱…",
            "nextDialogs": [
              "400130203"
            ]
          },
          "400130203": {
            "id": "400130203",
            "speakerId": 1018,
            "speakerName": "阿贝多",
            "text": "那里好像有什么东西哦，不去看看吗？",
            "nextDialogs": [
              "400130204"
            ]
          },
          "400130204": {
            "id": "400130204",
            "speakerId": 10090,
            "speakerName": "可莉",
            "text": "嗯，要看！",
            "nextDialogs": [
              "400130205"
            ]
          },
          "400130205": {
            "id": "400130205",
            "speakerId": 1008,
            "speakerName": "嘟嘟大魔王",
            "text": "邪恶的红色女孩，你终于来了。我等得太久太久，实在是好无聊啊！",
            "nextDialogs": [
              "400130206"
            ]
          },
          "400130206": {
            "id": "400130206",
            "speakerId": 1008,
            "speakerName": "嘟嘟大魔王",
            "text": "你胆敢面对我，嘟嘟一族的统治者——嘟嘟大魔王，勇气可嘉！",
            "nextDialogs": [
              "400130207"
            ]
          },
          "400130207": {
            "id": "400130207",
            "speakerId": 1008,
            "speakerName": "嘟嘟大魔王",
            "text": "勇气虽然值得敬佩，但现在已经没有意义了，因为…",
            "nextDialogs": [
              "400130208"
            ]
          },
          "400130208": {
            "id": "400130208",
            "speakerId": 10923,
            "speakerName": "艾莉丝",
            "text": "因为嘟嘟大魔王就是我，你的妈妈艾莉丝哦！",
            "nextDialogs": [
              "400130209"
            ]
          },
          "400130209": {
            "id": "400130209",
            "speakerId": 10090,
            "speakerName": "可莉",
            "text": "咦，妈妈！",
            "nextDialogs": [
              "400130210"
            ]
          },
          "400130210": {
            "id": "400130210",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "艾莉丝…是那个写《提瓦特游览指南》的人？！",
            "nextDialogs": [
              "400130211"
            ]
          },
          "400130211": {
            "id": "400130211",
            "speakerId": 10923,
            "speakerName": "艾莉丝",
            "text": "可莉，还有陪同可莉一起前来海岛的各位，你们好啊。",
            "nextDialogs": [
              "400130212"
            ]
          },
          "400130212": {
            "id": "400130212",
            "speakerId": 10923,
            "speakerName": "艾莉丝",
            "text": "如何，这片海岛好玩吗？夏天的阳光和海滩，嗯~应该是个不错的假日吧？",
            "nextDialogs": [
              "400130213"
            ]
          },
          "400130213": {
            "id": "400130213",
            "speakerId": 10923,
            "speakerName": "艾莉丝",
            "text": "不用找了，我不在你们身旁。面前这台正在说话的机器是我发明的「艾莉丝留声机」，用于传递妈妈的爱哦！",
            "nextDialogs": [
              "400130214"
            ]
          },
          "400130214": {
            "id": "400130214",
            "speakerId": 1004,
            "speakerName": "凯亚",
            "text": "哦？这可真是…",
            "nextDialogs": [
              "400130215"
            ]
          },
          "400130215": {
            "id": "400130215",
            "speakerId": 10923,
            "speakerName": "艾莉丝",
            "text": "啊呀，不会吓到大家了吧？抱歉抱歉，我家可莉喜欢玩各式各样的小玩具，作为母亲的我自然要支持了。",
            "nextDialogs": [
              "400130216"
            ]
          },
          "400130216": {
            "id": "400130216",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "这些玩具一点都不小！",
            "nextDialogs": [
              "400130217"
            ]
          },
          "400130217": {
            "id": "400130217",
            "speakerId": 1011,
            "speakerName": "雷泽",
            "text": "妈…妈？",
            "nextDialogs": [
              "400130218"
            ]
          },
          "400130218": {
            "id": "400130218",
            "speakerId": 10923,
            "speakerName": "艾莉丝",
            "text": "不能见面很可惜，但我会从远方留意着你们的一举一动，像过去那样守望着各位。",
            "nextDialogs": [
              "400130219"
            ]
          },
          "400130219": {
            "id": "400130219",
            "speakerId": 1006,
            "speakerName": "琴",
            "text": "竟然是艾莉丝女士！我…我大意了…",
            "nextDialogs": [
              "400130220"
            ]
          },
          "400130220": {
            "id": "400130220",
            "speakerId": 1008,
            "speakerName": "芭芭拉",
            "text": "哎？哎？",
            "nextDialogs": [
              "400130221"
            ]
          },
          "400130221": {
            "id": "400130221",
            "speakerId": 10923,
            "speakerName": "艾莉丝",
            "text": "也许各位会为这一切感到奇怪，为什么一个离家千里的母亲要大费周章地建造这样一座水上乐园呢？",
            "nextDialogs": [
              "400130222"
            ]
          },
          "400130222": {
            "id": "400130222",
            "speakerId": 10923,
            "speakerName": "艾莉丝",
            "text": "叮叮！没错，我也亲自去过那座岛，对岛上古老的遗迹和特殊的地形很是喜爱，为了让大家都享受到这份快乐，才做了这些安排。",
            "nextDialogs": [
              "400130223"
            ]
          },
          "400130223": {
            "id": "400130223",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "可莉的妈妈也是个非常自由的人呢…",
            "nextDialogs": [
              "400130224"
            ]
          },
          "400130224": {
            "id": "400130224",
            "speakerId": 10923,
            "speakerName": "艾莉丝",
            "text": "哦呵呵，是不是有人在说我坏话呀？",
            "nextDialogs": [
              "400130225"
            ]
          },
          "400130225": {
            "id": "400130225",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "哎？没、没有啊！她是在监听吗？",
            "nextDialogs": [
              "400130226"
            ]
          },
          "400130226": {
            "id": "400130226",
            "speakerId": 1006,
            "speakerName": "琴",
            "text": "不，不需要这么麻烦。",
            "nextDialogs": [
              "400130227"
            ]
          },
          "400130227": {
            "id": "400130227",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "什么意思？",
            "nextDialogs": [
              "400130228"
            ]
          },
          "400130228": {
            "id": "400130228",
            "speakerId": 1018,
            "speakerName": "阿贝多",
            "text": "可莉的母亲艾莉丝是一位极其神秘又近乎万能的魔女。千万别太惊讶，她就是这样的人。",
            "nextDialogs": [
              "400130229"
            ]
          },
          "400130229": {
            "id": "400130229",
            "speakerId": 10923,
            "speakerName": "艾莉丝",
            "text": "你们一定在想，那些信是怎么回事，那些船又是怎么回事，还有那些浮标、能量罩…",
            "nextDialogs": [
              "400130230"
            ]
          },
          "400130230": {
            "id": "400130230",
            "speakerId": 10923,
            "speakerName": "艾莉丝",
            "text": "嗯嗯~其实我也觉得有些大费周章了，但只有这样，才能把各位请来这里，不是吗？",
            "nextDialogs": [
              "400130231"
            ]
          },
          "400130231": {
            "id": "400130231",
            "speakerId": 10923,
            "speakerName": "艾莉丝",
            "text": "那座岛本就很有故事，原住民、沉船、神秘机械…无数巧合汇聚在此，要是不做些布置，岂不是太浪费了。",
            "nextDialogs": [
              "400130232"
            ]
          },
          "400130232": {
            "id": "400130232",
            "speakerId": 10923,
            "speakerName": "艾莉丝",
            "text": "让我猜猜看，收到信的各位应该都在吧。凯亚先生、迪卢克先生、雷泽小朋友、琴小姐、芭芭拉小姐…",
            "nextDialogs": [
              "400130233"
            ]
          },
          "400130233": {
            "id": "400130233",
            "speakerId": 10923,
            "speakerName": "艾莉丝",
            "text": "#然后是可靠又聪明的小阿贝多，以及…神秘的旅行者和{PLAYERAVATAR#SEXPRO[INFO_MALE_PRONOUN_HE|INFO_FEMALE_PRONOUN_SHE]}的好伙伴，派蒙。",
            "nextDialogs": [
              "400130234"
            ]
          },
          "400130234": {
            "id": "400130234",
            "speakerId": 10923,
            "speakerName": "艾莉丝",
            "text": "你们都是受我邀请前来陪伴可莉的人。谢谢你们，让这孩子过了一个不错的夏天。",
            "nextDialogs": [
              "400130235"
            ]
          },
          "400130235": {
            "id": "400130235",
            "speakerId": 10923,
            "speakerName": "艾莉丝",
            "text": "岛上的一切都是我给你们的礼物，谢谢你们陪着她。不过等你们听到这段录音，我应该已经在别处旅行了吧。",
            "nextDialogs": [
              "400130236"
            ]
          },
          "400130236": {
            "id": "400130236",
            "speakerId": 10923,
            "speakerName": "艾莉丝",
            "text": "旅行生活是如此匆忙又有趣，哈哈，问问你们身旁那位旅行者就知道了。",
            "nextDialogs": [
              "400130237"
            ]
          },
          "400130237": {
            "id": "400130237",
            "speakerId": 1006,
            "speakerName": "琴",
            "text": "艾莉丝女士，是因为太忙无法陪伴可莉才做这些的吗…",
            "nextDialogs": [
              "400130238"
            ]
          },
          "400130238": {
            "id": "400130238",
            "speakerId": 10090,
            "speakerName": "可莉",
            "text": "不是哦，妈妈就是这样的！",
            "nextDialogs": [
              "400130239"
            ]
          },
          "400130239": {
            "id": "400130239",
            "speakerId": 10923,
            "speakerName": "艾莉丝",
            "text": "各位，如果你此刻正在思考更深一层的用意，我必须得说，情况没有你想的那么复杂。",
            "nextDialogs": [
              "400130240"
            ]
          },
          "400130240": {
            "id": "400130240",
            "speakerId": 10923,
            "speakerName": "艾莉丝",
            "text": "我之所以中意蒙德这座城邦，是因为自由也正是我们母女的期望哦。",
            "nextDialogs": [
              "400130241"
            ]
          },
          "400130241": {
            "id": "400130241",
            "speakerId": 10923,
            "speakerName": "艾莉丝",
            "text": "我的愿望很简单，希望可莉怀抱着好奇心与善意长大，只要她想，她就能做任何事，去任何地方。",
            "nextDialogs": [
              "400130242"
            ]
          },
          "400130242": {
            "id": "400130242",
            "speakerId": 1006,
            "speakerName": "琴",
            "text": "原来如此…确实是艾莉丝女士的风格，抱歉，是我误会了。",
            "nextDialogs": [
              "400130243"
            ]
          },
          "400130243": {
            "id": "400130243",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "总觉得是好有性格的妈妈呢。",
            "nextDialogs": [
              "400130244"
            ]
          },
          "400130244": {
            "id": "400130244",
            "speakerId": 10090,
            "speakerName": "可莉",
            "text": "嗯！妈妈是最好的妈妈哦！",
            "nextDialogs": [
              "400130245"
            ]
          },
          "400130245": {
            "id": "400130245",
            "speakerId": 10090,
            "speakerName": "可莉",
            "text": "妈妈，这次我们抓鱼、开船、游泳…玩了很多很多东西！",
            "nextDialogs": [
              "400130246"
            ]
          },
          "400130246": {
            "id": "400130246",
            "speakerId": 10090,
            "speakerName": "可莉",
            "text": "大家都超——级超级好，对可莉非常温柔！",
            "nextDialogs": [
              "400130247"
            ]
          },
          "400130247": {
            "id": "400130247",
            "speakerId": 10090,
            "speakerName": "可莉",
            "text": "下次你也一起来，我们再到这里玩！",
            "nextDialogs": [
              "400130248"
            ]
          },
          "400130248": {
            "id": "400130248",
            "speakerId": 1004,
            "speakerName": "凯亚",
            "text": "母女俩都是自由自在的精灵啊。",
            "nextDialogs": [
              "400130249"
            ]
          },
          "400130249": {
            "id": "400130249",
            "speakerId": 10923,
            "speakerName": "艾莉丝",
            "text": "夏天啊…说到夏天，我去那座岛时，刚好也是夏天呢。坐在沙滩上，倾听着海浪拂过脚背发出的细响，就想到了你。",
            "nextDialogs": [
              "400130250"
            ]
          },
          "400130250": {
            "id": "400130250",
            "speakerId": 10923,
            "speakerName": "艾莉丝",
            "text": "可莉，你是出生在夏天的孩子，是海与风送给妈妈的礼物。妈妈很感谢你的诞生，也想送点东西给你。",
            "nextDialogs": [
              "400130251"
            ]
          },
          "400130251": {
            "id": "400130251",
            "speakerId": 10923,
            "speakerName": "艾莉丝",
            "text": "于是妈妈在岛上做了些布置，把古老的遗迹改造成夏日游乐园，再用嘟嘟大魔王的名义请你过来。",
            "nextDialogs": [
              "400130252"
            ]
          },
          "400130252": {
            "id": "400130252",
            "speakerId": 10923,
            "speakerName": "艾莉丝",
            "text": "异世界传说里有过一座以「金苹果」为名的奇迹之岛。它有多种化名，承载着人们对美好幻梦的想象。",
            "nextDialogs": [
              "400130253"
            ]
          },
          "400130253": {
            "id": "400130253",
            "speakerId": 10923,
            "speakerName": "艾莉丝",
            "text": "妈妈喜欢那个故事，也希望你能享受到故事中的美好之事。所以妈妈送你碧蓝的海水、珍珠般白亮的细沙、不可思议的乐园…",
            "nextDialogs": [
              "400130254"
            ]
          },
          "400130254": {
            "id": "400130254",
            "speakerId": 10923,
            "speakerName": "艾莉丝",
            "text": "和那些爱你的人。",
            "nextDialogs": [
              "400130255"
            ]
          },
          "400130255": {
            "id": "400130255",
            "speakerId": 1006,
            "speakerName": "琴",
            "text": "……",
            "nextDialogs": [
              "400130256"
            ]
          },
          "400130256": {
            "id": "400130256",
            "speakerId": 1008,
            "speakerName": "芭芭拉",
            "text": "所以水晶才只有三块吗…花瓣般的浅红色、海浪般的浅蓝色、秋叶般的浅黄色…",
            "nextDialogs": [
              "400130257"
            ]
          },
          "400130257": {
            "id": "400130257",
            "speakerId": 1006,
            "speakerName": "琴",
            "text": "或许在艾莉丝看来，这片群岛就是天然存在的第四块水晶吧…位于大海正中，被植被覆盖的、绿宝石般璀璨的「夏之水晶」。",
            "nextDialogs": [
              "400130258"
            ]
          },
          "400130258": {
            "id": "400130258",
            "speakerId": 10923,
            "speakerName": "艾莉丝",
            "text": "可莉，你和妈妈一样，是比普通人更长寿的种族。对我们而言，时间是一阵风，吹过便是结束。",
            "nextDialogs": [
              "400130259"
            ]
          },
          "400130259": {
            "id": "400130259",
            "speakerId": 10923,
            "speakerName": "艾莉丝",
            "text": "在如此漫长的生命里，父母不过是孩子人生的第一环。即使我们不愿分离，终有一日，你也会走上属于自己的路。",
            "nextDialogs": [
              "400130260"
            ]
          },
          "400130260": {
            "id": "400130260",
            "speakerId": 10923,
            "speakerName": "艾莉丝",
            "text": "可莉，妈妈会一直爱你，但除了妈妈，还有许多人围在你身旁。",
            "nextDialogs": [
              "400130261"
            ]
          },
          "400130261": {
            "id": "400130261",
            "speakerId": 10923,
            "speakerName": "艾莉丝",
            "text": "陪伴你的好友、教导你的老师、哪怕知道有蹊跷也愿意为了你留在岛上的人们…",
            "nextDialogs": [
              "400130262"
            ]
          },
          "400130262": {
            "id": "400130262",
            "speakerId": 10923,
            "speakerName": "艾莉丝",
            "text": "夏天是属于大家的。无论生活如何变化，无论这一年发生多少事，夏天都不会消失，就像人们之间的爱一样。",
            "nextDialogs": [
              "400130263"
            ]
          },
          "400130263": {
            "id": "400130263",
            "speakerId": 10923,
            "speakerName": "艾莉丝",
            "text": "希望你从今以后无论去往何处都不要忘记，世界上有那么多爱你的人。",
            "nextDialogs": [
              "400130264"
            ]
          },
          "400130264": {
            "id": "400130264",
            "speakerId": 10923,
            "speakerName": "艾莉丝",
            "text": "啊对了，在家也要听阿贝多哥哥的话，妈妈会定期回来看望你们。其实啊，我一有空就会偷偷回来探望可莉和大家。嘻嘻，谁都没有发现吧？",
            "nextDialogs": [
              "400130265"
            ]
          },
          "400130265": {
            "id": "400130265",
            "speakerId": 1018,
            "speakerName": "阿贝多",
            "text": "还是老样子啊，艾莉丝阿姨。",
            "nextDialogs": [
              "400130266"
            ]
          },
          "400130266": {
            "id": "400130266",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "阿贝多这家伙，该不会从一开始就知道了吧…",
            "nextDialogs": [
              "400130267"
            ]
          },
          "400130267": {
            "id": "400130267",
            "speakerId": 10923,
            "speakerName": "艾莉丝",
            "text": "唔？时间差不多了，就先说到这里吧。对了对了，我做这些费了不少力气，你们一定要尽情地玩哦！",
            "nextDialogs": [
              "400130268"
            ]
          },
          "400130268": {
            "id": "400130268",
            "speakerId": 10923,
            "speakerName": "艾莉丝",
            "text": "那么各位，还有我的宝贝可莉，下次再见咯。",
            "nextDialogs": [
              "400130269"
            ]
          },
          "400130269": {
            "id": "400130269",
            "speakerId": 10090,
            "speakerName": "可莉",
            "text": "妈妈再见！",
            "nextDialogs": [
              "400130270"
            ]
          },
          "400130270": {
            "id": "400130270",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "可莉，好像非常开心呢。",
            "nextDialogs": [
              "400130271"
            ]
          },
          "400130271": {
            "id": "400130271",
            "speakerId": 10090,
            "speakerName": "可莉",
            "text": "嘿嘿…大魔王就是妈妈，不知为什么，可莉觉得好开心！",
            "nextDialogs": [
              "400130272"
            ]
          },
          "400130272": {
            "id": "400130272",
            "speakerId": 10090,
            "speakerName": "可莉",
            "text": "不管是炸蒙德大门的妈妈，被关禁闭的妈妈，还是写奇怪的信给我的妈妈…可莉都好喜欢。",
            "nextDialogs": [
              "400130273"
            ]
          },
          "400130273": {
            "id": "400130273",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "可莉不会觉得寂寞吗？",
            "nextDialogs": [
              "400130274"
            ]
          },
          "400130274": {
            "id": "400130274",
            "speakerId": 10090,
            "speakerName": "可莉",
            "text": "不会，因为妈妈是最厉害的大魔女，无论在哪都陪着可莉，永远不会让可莉感到无聊！",
            "nextDialogs": [
              "400130275"
            ]
          },
          "400130275": {
            "id": "400130275",
            "speakerId": 10090,
            "speakerName": "可莉",
            "text": "可莉最最最最喜欢妈妈啦！",
            "nextDialogs": [
              "400130276"
            ]
          },
          "400130276": {
            "id": "400130276",
            "speakerId": 10090,
            "speakerName": "可莉",
            "text": "#荣誉骑士{PLAYERAVATAR#SEXPRO[INFO_MALE_PRONOUN_BROTHER|INFO_FEMALE_PRONOUN_SISTERA]}，你喜欢可莉吗？",
            "nextDialogs": [
              "400130277"
            ]
          },
          "400130277": {
            "id": "400130277",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "嗯。",
            "nextDialogs": [
              "400130278"
            ]
          },
          "400130278": {
            "id": "400130278",
            "speakerId": 10090,
            "speakerName": "可莉",
            "text": "可莉也很爱你，你要陪着可莉在这里玩个够，否则，妈妈会觉得很可惜哦！",
            "nextDialogs": [
              "400130279"
            ]
          },
          "400130279": {
            "id": "400130279",
            "speakerId": 10090,
            "speakerName": "可莉",
            "text": "我还有很多蹦蹦炸弹，还有嘟嘟可也一起…我带你去游泳、炸鱼！",
            "nextDialogs": [
              "400130280"
            ]
          },
          "400130280": {
            "id": "400130280",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "跟可莉在一起就是开心！",
            "nextDialogs": [
              "400130281"
            ]
          },
          "400130281": {
            "id": "400130281",
            "speakerId": 10090,
            "speakerName": "可莉",
            "text": "喂——快来呀——",
            "nextDialogs": [
              "400130282"
            ]
          },
          "400130282": {
            "id": "400130282",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "别让可莉久等了，我们也快过去吧！"
          }
        }
      }
    },

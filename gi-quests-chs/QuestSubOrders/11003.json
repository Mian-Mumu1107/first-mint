            "text": "那、那是…！"
          }
        }
      }
    },
    {
      "subId": "1100302",
      "subQuestName": "与香菱和瑟瑟发抖的人交谈",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "110030201"
        ],
        "dialogs": {
          "110030201": {
            "id": "110030201",
            "speakerId": 1630,
            "speakerName": "奥拉夫",
            "text": "好…好冷。",
            "nextDialogs": [
              "110030202"
            ]
          },
          "110030202": {
            "id": "110030202",
            "speakerId": 1012,
            "speakerName": "香菱",
            "text": "他的身子好冷！得赶快帮他暖暖才行！",
            "nextDialogs": [
              "110030203"
            ]
          },
          "110030203": {
            "id": "110030203",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "那在这里生火吧！",
            "nextDialogs": [
              "110030204"
            ]
          },
          "110030204": {
            "id": "110030204",
            "speakerId": 1012,
            "speakerName": "香菱",
            "text": "嗯，最好还能有一碗热汤。",
            "nextDialogs": [
              "110030205"
            ]
          },
          "110030205": {
            "id": "110030205",
            "speakerId": 1012,
            "speakerName": "香菱",
            "text": "#{NICKNAME}，我在这里照顾他，能麻烦你去准备一份<color=#00E1FFFF>美味的热汤</color>吗？",
            "nextDialogs": [
              "110030206"
            ]
          },
          "110030206": {
            "id": "110030206",
            "speakerId": 1012,
            "speakerName": "香菱",
            "text": "我记得来的路上有个丘丘人营地，那里多半就有能做汤的地方。",
            "nextDialogs": [
              "110030207"
            ]
          },
          "110030207": {
            "id": "110030207",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "没问题。",
            "nextDialogs": [
              "110030208"
            ]
          },
          "110030208": {
            "id": "110030208",
            "speakerId": 1012,
            "speakerName": "香菱",
            "text": "好的，准备好了就尽快回来！"
          }
        }
      }
    },
    {
      "subId": "1100303",
      "subQuestName": "烹制「美味的萝卜时蔬汤」",

        "dialogs": {
          "110039801": {
            "id": "110039801",
            "speakerId": 10033,
            "speakerName": "香菱",
            "text": "我们来的时候路过了一个丘丘人的营地，那里应该有能做汤的地方。",
            "nextDialogs": [
              "110039802"
            ]
          },
          "110039802": {
            "id": "110039802",
            "speakerId": 10033,
            "speakerName": "香菱",
            "text": "我在这里照顾他，麻烦你去准备一碗美味的热汤，给他暖暖身子吧！"
          }
        }
      }
    },
    {
      "subId": "1100399",

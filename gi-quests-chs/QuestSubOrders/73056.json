    {
      "subId": "7305602",
      "subQuestName": "调查新生的植物",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [],
        "dialogs": {}
      }
    },
    {
      "subId": "7305603",
      "subQuestName": "和海亚姆对话",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "730560501"
        ],
        "dialogs": {
          "730560501": {
            "id": "730560501",
            "speakerId": 20744,
            "speakerName": "海亚姆",
            "text": "看呀，看呀…这里的植物长势真好！被「无留陀」蹂躏过的土壤，还是能生出有精神的植物来嘛！",
            "nextDialogs": [
              "730560502"
            ]
          },
          "730560502": {
            "id": "730560502",
            "speakerId": 20744,
            "speakerName": "海亚姆",
            "text": "哈哈，「无郁夷摩」呀「无郁夷摩」，你这个老小子！活力还是蛮足的嘛！",
            "nextDialogs": [
              "730560503"
            ]
          },
          "730560503": {
            "id": "730560503",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "哇，海亚姆先生好像突然变年轻了！",
            "nextDialogs": [
              "730560505",
              "730560507"
            ]
          },
          "730560505": {
            "id": "730560505",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "你是什么意思啦！",
            "nextDialogs": [
              "730560508"
            ]
          },
          "730560508": {
            "id": "730560508",
            "speakerId": 20744,
            "speakerName": "海亚姆",
            "text": "嗯…你采摘的这些应该够了，辛苦你们陪我来跑一趟了。既然没有其他事情，我们离开这里吧。",
            "nextDialogs": [
              "730560509"
            ]
          },
          "730560509": {
            "id": "730560509",
            "speakerId": 20744,
            "speakerName": "海亚姆",
            "text": "哈哈，真好呀…有了这些样本，或许对「死域」秘密和弱点的研究，会有更多进展吧…",
            "nextDialogs": [
              "730560510"
            ]
          },
          "730560510": {
            "id": "730560510",
            "speakerId": 20744,
            "speakerName": "海亚姆",
            "text": "辛苦两位了，我们顺原路回去吧…我还有东西交给你们。",
            "nextDialogs": [
              "730560511"
            ]
          },
          "730560511": {
            "id": "730560511",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "好耶，是谢礼！",
            "nextDialogs": [
              "730560512"
            ]
          },
          "730560512": {
            "id": "730560512",
            "speakerId": 20744,
            "speakerName": "海亚姆",
            "text": "呵呵，算是吧。"
          },
          "730560507": {
            "id": "730560507",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "虽然不是很清楚，但是好耶！"
          }
        }
      }
    },
    {
      "subId": "7305611",
      "subQuestName": "返回海亚姆的营地",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "730560601"
        ],
        "dialogs": {
          "730560601": {
            "id": "730560601",
            "speakerId": 20744,
            "speakerName": "海亚姆",
            "text": "谢谢你们，两位「杰万」。辛苦你们陪一个糟老头子跑了一趟。",
            "nextDialogs": [
              "730560602"
            ]
          },
          "730560602": {
            "id": "730560602",
            "speakerId": 20744,
            "speakerName": "海亚姆",
            "text": "对了，如果不介意的话…虽然不是什么贵重的东西。这个给你们，留作纪念吧。",
            "nextDialogs": [
              "730560603"
            ]
          },
          "730560603": {
            "id": "730560603",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "哇…是什么呀？是什么呀？",
            "nextDialogs": [
              "730560604"
            ]
          },
          "730560604": {
            "id": "730560604",
            "speakerId": 20744,
            "speakerName": "海亚姆",
            "text": "你们应该见过，这朵风干的小花。",
            "nextDialogs": [
              "730560605"
            ]
          },
          "730560605": {
            "id": "730560605",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "欸——！",
            "nextDialogs": [
              "730560608"
            ]
          },
          "730560608": {
            "id": "730560608",
            "speakerId": 20744,
            "speakerName": "海亚姆",
            "text": "没错。而如果我没有猜错的话…他们也一定给了你同样的礼物吧？",
            "nextDialogs": [
              "730560609"
            ]
          },
          "730560609": {
            "id": "730560609",
            "speakerId": 20744,
            "speakerName": "海亚姆",
            "text": "呵呵…我就知道，我们的相遇不是单纯的巧合…我从不相信巧合这种事。",
            "nextDialogs": [
              "730560610"
            ]
          },
          "730560610": {
            "id": "730560610",
            "speakerId": 20744,
            "speakerName": "海亚姆",
            "text": "这朵花就交给你了。拜托你，交给我们共同的朋友吧。",
            "nextDialogs": [
              "730560611"
            ]
          },
          "730560611": {
            "id": "730560611",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "嗯，可以是可以啦，只是…"
          }
        }
      }
    },

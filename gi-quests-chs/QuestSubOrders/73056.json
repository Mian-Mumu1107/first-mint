  },
  "subQuests": [
    {
      "subId": "7305601",
      "subQuestName": "和海亚姆对话$HIDDEN",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "730560101"
        ],
        "dialogs": {
          "730560101": {
            "id": "730560101",
            "speakerId": 10205,
            "speakerName": "？？？",
            "text": "哈哈，真是有趣…真是有意思。好起来了，这片森林…好起来了啊…",
            "nextDialogs": [
              "730560102"
            ]
          },
          "730560102": {
            "id": "730560102",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "你好！老爷爷，你是迷路了吗？",
            "nextDialogs": [
              "730560103"
            ]
          },
          "730560103": {
            "id": "730560103",
            "speakerId": 10205,
            "speakerName": "？？？",
            "text": "嗯…嗯？麋鹿…？啊，你们是在叫我吗？哈哈，迷路，是吧？没有的事，没有的事…",
            "nextDialogs": [
              "730560104"
            ]
          },
          "730560104": {
            "id": "730560104",
            "speakerId": 20744,
            "speakerName": "海亚姆",
            "text": "你们好呀，孩子们。我是生论派的陀裟多，吉亚斯·海亚姆，哈哈…叫我海亚姆就好。",
            "nextDialogs": [
              "730560105"
            ]
          },
          "730560105": {
            "id": "730560105",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "唔…你好呀，海亚姆先生！",
            "nextDialogs": [
              "730560106"
            ]
          },
          "730560106": {
            "id": "730560106",
            "speakerId": 20744,
            "speakerName": "海亚姆",
            "text": "不…像这样，压下舌尖，拱起舌中…海——然后双唇呈圆形…亚——最后，自然而然地抿起嘴唇…姆——",
            "nextDialogs": [
              "730560107"
            ]
          },
          "730560107": {
            "id": "730560107",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "呃…海——亚——姆——",
            "nextDialogs": [
              "730560108"
            ]
          },
          "730560108": {
            "id": "730560108",
            "speakerId": 20744,
            "speakerName": "海亚姆",
            "text": "对啦！真不错！好，金发的孩子，你再来一遍。",
            "nextDialogs": [
              "730560110",
              "730560112"
            ]
          },
          "730560110": {
            "id": "730560110",
            "speakerId": 20744,
            "speakerName": "海亚姆",
            "text": "哈哈，不错！比白色的小东西强多了！你看，我早说过我也能去教语音学的！",
            "nextDialogs": [
              "730560113"
            ]
          },
          "730560113": {
            "id": "730560113",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "所以，海亚姆先生…既然你没有迷路，那来这种地方做什么呀？",
            "nextDialogs": [
              "730560114"
            ]
          },
          "730560114": {
            "id": "730560114",
            "speakerId": 20744,
            "speakerName": "海亚姆",
            "text": "为什么？呵呵…我是森林学者呀。对我们森林学者来说，森林就像家一样。我怎么会在久违的家里迷路呢？",
            "nextDialogs": [
              "730560115"
            ]
          },
          "730560115": {
            "id": "730560115",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "哦……",
            "nextDialogs": [
              "730560116"
            ]
          },
          "730560116": {
            "id": "730560116",
            "speakerId": 20744,
            "speakerName": "海亚姆",
            "text": "这片森林深受「死域」的困扰。过去三十年里植物无论种类还是数量都在迅速减少，而有害的蕈类却越来越多…",
            "nextDialogs": [
              "730560117"
            ]
          },
          "730560117": {
            "id": "730560117",
            "speakerId": 20744,
            "speakerName": "海亚姆",
            "text": "但最近这段时间里，「死域」却消失了。很多曾经消失的植物如今重新生长了出来，蕈类的繁殖也有所收敛。",
            "nextDialogs": [
              "730560118"
            ]
          },
          "730560118": {
            "id": "730560118",
            "speakerId": 20744,
            "speakerName": "海亚姆",
            "text": "这种情况，我只在六十年前见到过一次…所以为了验证我的一点不成熟的想法，我就来到了这里。",
            "nextDialogs": [
              "730560119"
            ]
          },
          "730560119": {
            "id": "730560119",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "这样啊…"
          },
          "730560112": {
            "id": "730560112",
            "speakerId": 20744,
            "speakerName": "海亚姆",
            "text": "嗯…你发音太快了，太急促了。不过没关系…慢下来就好。"
          }
        }
      }
    },
    {
      "subId": "7305613",
      "subQuestName": "前往「无郁夷摩」",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [],
        "dialogs": {}
      }
    },
    {
      "subId": "7305606",
      "subQuestName": "和海亚姆对话",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "730560201"
        ],
        "dialogs": {
          "730560201": {
            "id": "730560201",
            "speakerId": 20744,
            "speakerName": "海亚姆",
            "text": "我要调查的，主要是三个地点。哈哈，三十年前来到这里的记忆应该还没有消退干净…我还能给你们指出来。",
            "nextDialogs": [
              "730560202"
            ]
          },
          "730560202": {
            "id": "730560202",
            "speakerId": 20744,
            "speakerName": "海亚姆",
            "text": "总之，辛苦你们相陪了。",
            "nextDialogs": [
              "730560203"
            ]
          },
          "730560203": {
            "id": "730560203",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "不要客气啦，海亚姆先生！这都是我们「杰万」应该做的！"
          }
        }
      }
    },
    {
      "subId": "7305607",
      "subQuestName": "调查特定地点的植物",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "730560701"
        ],
        "dialogs": {
          "730560701": {
            "id": "730560701",
            "speakerId": 20578,
            "speakerName": "兰纳迦",
            "text": "为什么来这里，你们？",
            "nextDialogs": [
              "730560702"
            ]
          },
          "730560702": {
            "id": "730560702",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "哇啊！吓我一跳！",
            "nextDialogs": [
              "730560703"
            ]
          },
          "730560703": {
            "id": "730560703",
            "speakerId": 20578,
            "speakerName": "兰纳迦",
            "text": "知道我的名字，你们。但没有在这里见过你们，兰纳迦。",
            "nextDialogs": [
              "730560704"
            ]
          },
          "730560704": {
            "id": "730560704",
            "speakerId": 20578,
            "speakerName": "兰纳迦",
            "text": "所以…为什么来这里，你们？",
            "nextDialogs": [
              "730560706",
              "730560709"
            ]
          },
          "730560706": {
            "id": "730560706",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "虽然很多事情你都记不起来了，但是我们没有恶意的！我们一直都站在你们这边！一直都会帮助「无郁夷摩」！",
            "nextDialogs": [
              "730560707"
            ]
          },
          "730560707": {
            "id": "730560707",
            "speakerId": 20578,
            "speakerName": "兰纳迦",
            "text": "「无郁夷摩」…你们知道？",
            "nextDialogs": [
              "730560710"
            ]
          },
          "730560710": {
            "id": "730560710",
            "speakerId": 20578,
            "speakerName": "兰纳迦",
            "text": "哼…看起来不像是坏蛋，你们。",
            "nextDialogs": [
              "730560711"
            ]
          },
          "730560711": {
            "id": "730560711",
            "speakerId": 20578,
            "speakerName": "兰纳迦",
            "text": "但请不要逗留，在这里。尽快离开吧，你们。还在恢复，森林…所以，还不应该逗留，新的客人。",
            "nextDialogs": [
              "730560712"
            ]
          },
          "730560712": {
            "id": "730560712",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "欸…等等呀！",
            "nextDialogs": [
              "730560713"
            ]
          },
          "730560713": {
            "id": "730560713",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "我们有东西要交给你！",
            "nextDialogs": [
              "730560714"
            ]
          },
          "730560714": {
            "id": "730560714",
            "speakerId": 20578,
            "speakerName": "兰纳迦",
            "text": "东西，给我？",
            "nextDialogs": [
              "730560715"
            ]
          },
          "730560715": {
            "id": "730560715",
            "speakerId": 20578,
            "speakerName": "兰纳迦",
            "text": "给我。",
            "nextDialogs": [
              "730560716"
            ]
          },
          "730560716": {
            "id": "730560716",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "就是这个。",
            "nextDialogs": [
              "730560717"
            ]
          },
          "730560717": {
            "id": "730560717",
            "speakerId": 20578,
            "speakerName": "兰纳迦",
            "text": "……",
            "nextDialogs": [
              "730560718"
            ]
          },
          "730560718": {
            "id": "730560718",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "你看，记起来了吗？你也给过我们一样的花呢！",
            "nextDialogs": [
              "730560719"
            ]
          },
          "730560719": {
            "id": "730560719",
            "speakerId": 20578,
            "speakerName": "兰纳迦",
            "text": "真的…和我是朋友，你们？很重要的花，为什么有，你们？"
          },
          "730560709": {
            "id": "730560709",
            "speakerId": 20578,
            "speakerName": "兰纳迦",
            "text": "朋友…？"
          }
        }
      }
    },
    {
      "subId": "7305609",
      "subQuestName": "和海亚姆对话 $HIDDEN",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "730560301"
        ],
        "dialogs": {
          "730560301": {
            "id": "730560301",
            "speakerId": 20744,
            "speakerName": "海亚姆",
            "text": "有意思…这里的植物看起来…重新焕发生机了啊。「无郁夷摩」重新发挥作用了…真是神奇。",
            "nextDialogs": [
              "730560302"
            ]
          },
          "730560302": {
            "id": "730560302",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "欸…海亚姆先生也知道「无郁夷摩」吗？我还以为只有兰那罗知道…",
            "nextDialogs": [
              "730560305"
            ]
          },
          "730560305": {
            "id": "730560305",
            "speakerId": 20744,
            "speakerName": "海亚姆",
            "text": "「兰那罗」，是吗？你们也看到过他们啊…",
            "nextDialogs": [
              "730560306"
            ]
          },
          "730560306": {
            "id": "730560306",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "欸…？嗯…是、是的。"
          }
        }
      }
    },
    {
      "subId": "7305608",
      "subQuestName": "调查特定地点的植物",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "730560801"
        ],
        "dialogs": {
          "730560801": {
            "id": "730560801",
            "speakerId": 20744,
            "speakerName": "海亚姆",
            "text": "这里的植物长势真不错呀…",
            "nextDialogs": [
              "730560803",
              "730560805"
            ]
          },
          "730560803": {
            "id": "730560803",
            "speakerId": 20744,
            "speakerName": "海亚姆",
            "text": "我还从没想过，被「无留陀」侵犯过的土地，仍然能够重新孕育出供植物葱茏生长的养分。"
          },
          "730560805": {
            "id": "730560805",
            "speakerId": 20744,
            "speakerName": "海亚姆",
            "text": "孩子们叫「兰那罗」的奇特生物体，说它们是「幻想朋友」…无疑是不准确的。",
            "nextDialogs": [
              "730560806"
            ]
          },
          "730560806": {
            "id": "730560806",
            "speakerId": 20744,
            "speakerName": "海亚姆",
            "text": "因为教令院的探测仪也无法看到它们，只有那些幼小的孩子们才能证明它们存在。",
            "nextDialogs": [
              "730560807"
            ]
          },
          "730560807": {
            "id": "730560807",
            "speakerId": 20744,
            "speakerName": "海亚姆",
            "text": "所以，生论派对这种生物的归类是「未确认生物」。"
          }
        }
      }
    },
    {
      "subId": "7305610",
      "subQuestName": "和海亚姆对话 $HIDDEN",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "730560401"
        ],
        "dialogs": {
          "730560401": {
            "id": "730560401",
            "speakerId": 20744,
            "speakerName": "海亚姆",
            "text": "哈！你瞧！看看这个！",
            "nextDialogs": [
              "730560402"
            ]
          },
          "730560402": {
            "id": "730560402",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "欸？是新植物吗？怎么突然这么兴奋？",
            "nextDialogs": [
              "730560403"
            ]
          },
          "730560403": {
            "id": "730560403",
            "speakerId": 20744,
            "speakerName": "海亚姆",
            "text": "不是，不是新植物，但更让人开心！…瞧瞧呀，我们的「秘密城堡」！哈！破败成什么样子了！",
            "nextDialogs": [
              "730560404"
            ]
          },
          "730560404": {
            "id": "730560404",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "欸…？「秘密城堡」？",
            "nextDialogs": [
              "730560405"
            ]
          },
          "730560405": {
            "id": "730560405",
            "speakerId": 20744,
            "speakerName": "海亚姆",
            "text": "哈哈！学士奥马尔回来了！他带着群星的秘密回来了！伊尔凡，熙蔓，你们在哪里！还不出来欢迎我吗！",
            "nextDialogs": [
              "730560406"
            ]
          },
          "730560406": {
            "id": "730560406",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "……",
            "nextDialogs": [
              "730560407"
            ]
          },
          "730560407": {
            "id": "730560407",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "……",
            "nextDialogs": [
              "730560408"
            ]
          },
          "730560408": {
            "id": "730560408",
            "speakerId": 20744,
            "speakerName": "海亚姆",
            "text": "呃…咳咳，抱歉，孩子们。我…我有点太兴奋了。",
            "nextDialogs": [
              "730560409"
            ]
          },
          "730560409": {
            "id": "730560409",
            "speakerId": 20744,
            "speakerName": "海亚姆",
            "text": "岁数大了总是这样，越是现在的事，就越糊涂；越是小时候的事，就越怀念，嘿嘿…",
            "nextDialogs": [
              "730560410"
            ]
          },
          "730560410": {
            "id": "730560410",
            "speakerId": 20744,
            "speakerName": "海亚姆",
            "text": "伊尔凡，熙蔓，他们是我的朋友，我们一起搭建了这座「城堡」，我们三个。",
            "nextDialogs": [
              "730560411"
            ]
          },
          "730560411": {
            "id": "730560411",
            "speakerId": 20744,
            "speakerName": "海亚姆",
            "text": "那时候，伊尔凡是大乐师，熙蔓是元帅，我是占星学士。我们偶尔也会轮换，小孩子嘛…玩腻了就会换着来。",
            "nextDialogs": [
              "730560412"
            ]
          },
          "730560412": {
            "id": "730560412",
            "speakerId": 20744,
            "speakerName": "海亚姆",
            "text": "伊尔凡弹得一手好琴；熙蔓她个子高，胳膊壮，没人打得过；而我呢？哈哈，读书多一点，家里多点摩拉而已。",
            "nextDialogs": [
              "730560414",
              "730560416"
            ]
          },
          "730560414": {
            "id": "730560414",
            "speakerId": 20744,
            "speakerName": "海亚姆",
            "text": "不，这里是我们的秘密国度，我很严肃的。我们和他们约好了切莫相忘，长大后举「复国军」回来光复城堡…",
            "nextDialogs": [
              "730560418"
            ]
          },
          "730560418": {
            "id": "730560418",
            "speakerId": 20744,
            "speakerName": "海亚姆",
            "text": "呵呵，二十年过去，他们或许都已经忘记了…这里就被我当做了研究森林的小小据点，一直运作到三十年前。",
            "nextDialogs": [
              "730560419"
            ]
          },
          "730560419": {
            "id": "730560419",
            "speakerId": 20744,
            "speakerName": "海亚姆",
            "text": "再后来，「无留陀」来了，「复国军」却还是没影儿。呵呵，也对…小孩子的约定，怎么能抵挡死亡的到来呢？",
            "nextDialogs": [
              "730560420"
            ]
          },
          "730560420": {
            "id": "730560420",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "可是…既然你还记得他们，他们一定也还记得你的吧！请不要灰心呀，海亚姆先生！",
            "nextDialogs": [
              "730560421"
            ]
          },
          "730560421": {
            "id": "730560421",
            "speakerId": 20744,
            "speakerName": "海亚姆",
            "text": "灰心？不会的。儿时的记忆，共同的「幻想朋友」，不属于大人的世界。可能会有点遗憾，但…时光不复回呀。",
            "nextDialogs": [
              "730560422"
            ]
          },
          "730560422": {
            "id": "730560422",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "「幻想朋友」…你是说兰那罗吗？"
          },
          "730560416": {
            "id": "730560416",
            "speakerId": 20744,
            "speakerName": "海亚姆",
            "text": "不，不全是。最初我们还约定了，等长大以后，举「复国军」回来光复这里…呵呵。",
            "nextDialogs": [
              "730560417"
            ]
          },
          "730560417": {
            "id": "730560417",
            "speakerId": 20744,
            "speakerName": "海亚姆",
            "text": "我后来在教令院做植物学研究，正巧回来把这里改造了一番，一波一波搬来又搬走了不少垃圾。"
          }
        }
      }
    },

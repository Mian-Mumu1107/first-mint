      }
    },
    {
      "subId": "7419102",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "741910298"
        ],
        "dialogs": {
          "741910298": {
            "id": "741910298",
            "speakerId": 1001,
            "speakerName": "<UNKNOWN>",
            "text": "「污秽啊污秽，卡皮托利姆的每一个人都是污秽的！若是不用血洗净这片土地，怎能开出无罪的花…」",
            "nextDialogs": [
              "741910299"
            ]
          },
          "741910299": {
            "id": "741910299",
            "speakerId": 1001,
            "speakerName": "<UNKNOWN>",
            "text": "「众神啊，快关上天城的铜门！雷穆斯的宝剑已斩断命运的绳结，在征服陆地和海洋之后，只剩下上天的道路…」"
          }
        }
      }
    }
  ]
}
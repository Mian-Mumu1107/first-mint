    {
      "subId": "1501507",
      "subQuestName": "追击特拉佐莉",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "150150701"
        ],
        "dialogs": {
          "150150701": {
            "id": "150150701",
            "speakerId": 14310,
            "speakerName": "特拉佐莉",
            "text": "居然来得这么快，真佩服你们的脚力。",
            "nextDialogs": [
              "150150702"
            ]
          },
          "150150702": {
            "id": "150150702",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "妮赫佳在上面！你到底想对她做什么？！",
            "nextDialogs": [
              "150150703"
            ]
          },
          "150150703": {
            "id": "150150703",
            "speakerId": 14310,
            "speakerName": "特拉佐莉",
            "text": "我没有对你们撒谎。从头到尾，我都只是在救我的女儿妮赫佳。",
            "nextDialogs": [
              "150150704"
            ]
          },
          "150150704": {
            "id": "150150704",
            "speakerId": 14310,
            "speakerName": "特拉佐莉",
            "text": "虽然她现在还不是我的孩子…但等一切都结束，她就会真正成为妮赫佳。",
            "nextDialogs": [
              "150150705"
            ]
          },
          "150150705": {
            "id": "150150705",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "还，还不是妮赫佳？这到底是怎么回事？",
            "nextDialogs": [
              "150150708"
            ]
          },
          "150150708": {
            "id": "150150708",
            "speakerId": 14310,
            "speakerName": "特拉佐莉",
            "text": "你已经想通了？没错，我想要用「记忆」让妮赫佳醒过来。",
            "nextDialogs": [
              "150150709"
            ]
          },
          "150150709": {
            "id": "150150709",
            "speakerId": 14310,
            "speakerName": "特拉佐莉",
            "text": "那孩子在夜神之国待得太久了…她怕黑，也怕冷。",
            "nextDialogs": [
              "150150710"
            ]
          },
          "150150710": {
            "id": "150150710",
            "speakerId": 14310,
            "speakerName": "特拉佐莉",
            "text": "是我让妮赫佳一个人待在那里的，我必须把她带回来。",
            "nextDialogs": [
              "150150711"
            ]
          },
          "150150711": {
            "id": "150150711",
            "speakerId": 14310,
            "speakerName": "特拉佐莉",
            "text": "别怕，妮赫佳，妈妈什么都没有忘记，妈妈一直记得你的名字…"
          }
        }
      }
    },
    {
      "subId": "1501508",
      "subQuestName": "阻止特拉佐莉的仪式",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [],
        "dialogs": {}
      }
    },
    {
      "subId": "1501501",
      "subQuestName": "营救妮佩卡",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "150150101"
        ],
        "dialogs": {
          "150150101": {
            "id": "150150101",
            "speakerId": 14310,
            "speakerName": "特拉佐莉",
            "text": "刚才我看见妮赫佳了，她和我说了话，她去哪了…去哪了！",
            "nextDialogs": [
              "150150102"
            ]
          },
          "150150102": {
            "id": "150150102",
            "speakerId": 14310,
            "speakerName": "特拉佐莉",
            "text": "妮赫佳！妮赫佳！你在哪！回答妈妈！求求你…求求你…",
            "nextDialogs": [
              "150150103"
            ]
          },
          "150150103": {
            "id": "150150103",
            "speakerId": 14310,
            "speakerName": "特拉佐莉",
            "text": "希诺宁…！你刚才也看见了对吧？你也看见了我的小妮赫佳了！",
            "nextDialogs": [
              "150150104"
            ]
          },
          "150150104": {
            "id": "150150104",
            "speakerId": 14310,
            "speakerName": "特拉佐莉",
            "text": "我摸到她的手了，也抱住她了…我是对的…我是对的…",
            "nextDialogs": [
              "150150105"
            ]
          },
          "150150105": {
            "id": "150150105",
            "speakerId": 14310,
            "speakerName": "特拉佐莉",
            "text": "那些灰色的影子只是一点小错误…只要再启动一次，对，再启动一次，妮赫佳一定…",
            "nextDialogs": [
              "150150106"
            ]
          },
          "150150106": {
            "id": "150150106",
            "speakerId": 1095,
            "speakerName": "希诺宁",
            "text": "…婶婶，你还没察觉到么？",
            "nextDialogs": [
              "150150107"
            ]
          },
          "150150107": {
            "id": "150150107",
            "speakerId": 14310,
            "speakerName": "特拉佐莉",
            "text": "察觉到…什么？没什么错，一切都没错！",
            "nextDialogs": [
              "150150108"
            ]
          },
          "150150108": {
            "id": "150150108",
            "speakerId": 14310,
            "speakerName": "特拉佐莉",
            "text": "她只是在生我的气，不愿意理我…这孩子就喜欢闹脾气，我…我能理解，我能接受！",
            "nextDialogs": [
              "150150109"
            ]
          },
          "150150109": {
            "id": "150150109",
            "speakerId": 1095,
            "speakerName": "希诺宁",
            "text": "特拉佐莉！够了！",
            "nextDialogs": [
              "150150110"
            ]
          },
          "150150110": {
            "id": "150150110",
            "speakerId": 1095,
            "speakerName": "希诺宁",
            "text": "你用「燃晶名刻」召出来的，根本不是真正的妮赫佳。",
            "nextDialogs": [
              "150150111"
            ]
          },
          "150150111": {
            "id": "150150111",
            "speakerId": 1095,
            "speakerName": "希诺宁",
            "text": "你搜集了无数人有关妮赫佳的「回忆」。但是却漏了一点…",
            "nextDialogs": [
              "150150112"
            ]
          },
          "150150112": {
            "id": "150150112",
            "speakerId": 1095,
            "speakerName": "希诺宁",
            "text": "那些被搜集的记忆中，除了真实的「回忆」外，还有着无数的「情绪」。",
            "nextDialogs": [
              "150150113"
            ]
          },
          "150150113": {
            "id": "150150113",
            "speakerId": 1095,
            "speakerName": "希诺宁",
            "text": "你难道没有意识到…当人们探望病重中的妮赫佳时，会产生什么「情绪」么？",
            "nextDialogs": [
              "150150114"
            ]
          },
          "150150114": {
            "id": "150150114",
            "speakerId": 1095,
            "speakerName": "希诺宁",
            "text": "当人们握住一个临终孩子的手，感受着她无力的呼吸，绝望的眼神…还有逐渐降低的体温时…",
            "nextDialogs": [
              "150150115"
            ]
          },
          "150150115": {
            "id": "150150115",
            "speakerId": 1095,
            "speakerName": "希诺宁",
            "text": "除了痛苦和悲伤，他们还能感受到什么？",
            "nextDialogs": [
              "150150116"
            ]
          },
          "150150116": {
            "id": "150150116",
            "speakerId": 14310,
            "speakerName": "特拉佐莉",
            "text": "我…把这些情绪…",
            "nextDialogs": [
              "150150117"
            ]
          },
          "150150117": {
            "id": "150150117",
            "speakerId": 1095,
            "speakerName": "希诺宁",
            "text": "这些「情绪」，全都被你吸纳进了「燃晶名刻」中，作为实际的「过去」固化了下来。",
            "nextDialogs": [
              "150150118"
            ]
          },
          "150150118": {
            "id": "150150118",
            "speakerId": 1095,
            "speakerName": "希诺宁",
            "text": "那些灰色的人影，是那些「过去」的「投射」。她们只会重复着妮赫佳临终前的模样。",
            "nextDialogs": [
              "150150119"
            ]
          },
          "150150119": {
            "id": "150150119",
            "speakerId": 1095,
            "speakerName": "希诺宁",
            "text": "而真正的妮赫佳想要说的话，都被这些被扭曲的悲苦思绪所掩盖了。",
            "nextDialogs": [
              "150150120"
            ]
          },
          "150150120": {
            "id": "150150120",
            "speakerId": 14310,
            "speakerName": "特拉佐莉",
            "text": "我…我不想这样…我只是想要记住妮赫佳，我只是想…只想再见她一面…",
            "nextDialogs": [
              "150150121"
            ]
          },
          "150150121": {
            "id": "150150121",
            "speakerId": 1095,
            "speakerName": "希诺宁",
            "text": "…妮赫佳，一直都陪在你身边，婶婶。",
            "nextDialogs": [
              "150150122"
            ]
          },
          "150150122": {
            "id": "150150122",
            "speakerId": 1095,
            "speakerName": "希诺宁",
            "text": "那枚被你称作「毫无作用」的「古名」，早就记录了一切。",
            "nextDialogs": [
              "150150123"
            ]
          },
          "150150123": {
            "id": "150150123",
            "speakerId": 1095,
            "speakerName": "希诺宁",
            "text": "你用尽了一切方法，抛下了一切，试图拯救自己的女儿…这是不可动摇的事实。",
            "nextDialogs": [
              "150150124"
            ]
          },
          "150150124": {
            "id": "150150124",
            "speakerId": 1095,
            "speakerName": "希诺宁",
            "text": "你难道忘了自己「古名」的真义了吗？",
            "nextDialogs": [
              "150150125"
            ]
          },
          "150150125": {
            "id": "150150125",
            "speakerId": 14310,
            "speakerName": "特拉佐莉",
            "text": "我的「古名」是…「翁{RUBY#[D]亲}杜{RUBY#[D]情}古」…",
            "nextDialogs": [
              "150150126"
            ]
          },
          "150150126": {
            "id": "150150126",
            "speakerId": 1095,
            "speakerName": "希诺宁",
            "text": "这枚「古名」，早就将你和妮赫佳之间不可动摇的亲情记录在内。但你却对此视而不见。",
            "nextDialogs": [
              "150150127"
            ]
          },
          "150150127": {
            "id": "150150127",
            "speakerId": 1095,
            "speakerName": "希诺宁",
            "text": "「名字，是过去对未来的祝福。」这是你告诉我的，婶婶。",
            "nextDialogs": [
              "150150128"
            ]
          },
          "150150128": {
            "id": "150150128",
            "speakerId": 1095,
            "speakerName": "希诺宁",
            "text": "是你给妮赫佳取了名，是你为妮赫佳送出了最初的祝福。",
            "nextDialogs": [
              "150150129"
            ]
          },
          "150150129": {
            "id": "150150129",
            "speakerId": 1095,
            "speakerName": "希诺宁",
            "text": "现在，却亲手将妮赫佳这枚名字扭曲成了囚牢，囚禁着那个无辜的孩子…也囚禁了你自己。",
            "nextDialogs": [
              "150150130"
            ]
          },
          "150150130": {
            "id": "150150130",
            "speakerId": 14310,
            "speakerName": "特拉佐莉",
            "text": "…妮赫佳是我生命的全部。失去了她，我根本看不见未来。",
            "nextDialogs": [
              "150150131"
            ]
          },
          "150150131": {
            "id": "150150131",
            "speakerId": 14310,
            "speakerName": "特拉佐莉",
            "text": "至于祝福…哈哈…从妮赫佳离开后，我就再也感觉不到「祝福」了。我只会每天梦见那孩子抓着我的手，说自己很痛，求我抱她。",
            "nextDialogs": [
              "150150132"
            ]
          },
          "150150132": {
            "id": "150150132",
            "speakerId": 14310,
            "speakerName": "特拉佐莉",
            "text": "我却什么也看不见，也抓不住妮赫佳的手，只能不断地喊她的名字，直到从梦里惊醒。",
            "nextDialogs": [
              "150150133"
            ]
          },
          "150150133": {
            "id": "150150133",
            "speakerId": 14310,
            "speakerName": "特拉佐莉",
            "text": "每一天，每一天…我都痛恨我自己，也痛恨「古名」。妮赫佳…或许也…",
            "nextDialogs": [
              "150150134"
            ]
          },
          "150150134": {
            "id": "150150134",
            "speakerId": 1095,
            "speakerName": "希诺宁",
            "text": "你觉得，妮赫佳也会恨你？",
            "nextDialogs": [
              "150150135"
            ]
          },
          "150150135": {
            "id": "150150135",
            "speakerId": 14310,
            "speakerName": "特拉佐莉",
            "text": "……",
            "nextDialogs": [
              "150150136"
            ]
          },
          "150150136": {
            "id": "150150136",
            "speakerId": 1095,
            "speakerName": "希诺宁",
            "text": "婶婶。你还记得妮赫佳对你说的最后一句话么？还记得…妮赫佳真正的遗言是什么吗？",
            "nextDialogs": [
              "150150137"
            ]
          },
          "150150137": {
            "id": "150150137",
            "speakerId": 14310,
            "speakerName": "特拉佐莉",
            "text": "我…我…",
            "nextDialogs": [
              "150150138"
            ]
          },
          "150150138": {
            "id": "150150138",
            "speakerId": 1095,
            "speakerName": "希诺宁",
            "text": "你之所以感觉不到「祝福」，是因为你已经遗忘了真正的「过去」。…婶婶，你只是沉溺在自己所想象出的回忆中，不愿自拔。",
            "nextDialogs": [
              "150150139"
            ]
          },
          "150150139": {
            "id": "150150139",
            "speakerId": 1095,
            "speakerName": "希诺宁",
            "text": "失去「过去」的「名字」，只是一根无根的枯木，除了衰朽外，再无未来。",
            "nextDialogs": [
              "150150140"
            ]
          },
          "150150140": {
            "id": "150150140",
            "speakerId": 1095,
            "speakerName": "希诺宁",
            "text": "结束了。婶婶，一切都结束了。",
            "nextDialogs": [
              "150150141"
            ]
          },
          "150150141": {
            "id": "150150141",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "哎呀，慢一点，不然你还是躺着吧？呃…不对不对，躺在这里也不太好…",
            "nextDialogs": [
              "150150142"
            ]
          },
          "150150142": {
            "id": "150150142",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "希诺宁！妮赫佳…妮佩卡已经可以站起来了，我们过来啦！",
            "nextDialogs": [
              "150150145"
            ]
          },
          "150150145": {
            "id": "150150145",
            "speakerId": 14739,
            "speakerName": "妮佩卡",
            "text": "#谢谢你们，派蒙姐姐，{NICKNAME}{M#哥哥}{F#姐姐}…",
            "nextDialogs": [
              "150150146"
            ]
          },
          "150150146": {
            "id": "150150146",
            "speakerId": 14739,
            "speakerName": "妮佩卡",
            "text": "我真的没事，刚才妮赫佳姐姐帮了我，已经没那么难受了。",
            "nextDialogs": [
              "150150147"
            ]
          },
          "150150147": {
            "id": "150150147",
            "speakerId": 1095,
            "speakerName": "希诺宁",
            "text": "那就好。如果你真的变成了妮赫佳，那这个故事，可真就要变成《勇敢的特奎》了。",
            "nextDialogs": [
              "150150148"
            ]
          },
          "150150148": {
            "id": "150150148",
            "speakerId": 1095,
            "speakerName": "希诺宁",
            "text": "这里不是聊天的地方，走吧，我们先出去。",
            "nextDialogs": [
              "150150149"
            ]
          },
          "150150149": {
            "id": "150150149",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "那…特拉佐莉女士怎么办？",
            "nextDialogs": [
              "150150150"
            ]
          },
          "150150150": {
            "id": "150150150",
            "speakerId": 1095,
            "speakerName": "希诺宁",
            "text": "放心吧，她已经做不出出格的举动了。",
            "nextDialogs": [
              "150150151"
            ]
          },
          "150150151": {
            "id": "150150151",
            "speakerId": 1004,
            "speakerName": "Black Screen",
            "text": "一切都结束了，你们离开了这座工坊。出去后，希诺宁拜托你们先陪陪妮佩卡，她还有事要和特拉佐莉单独谈谈…"
          }
        }
      }
    },
    {
      "subId": "1501509",
      "subQuestName": "与希诺宁一起，休息片刻",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "150150901"
        ],
        "dialogs": {
          "150150901": {
            "id": "150150901",
            "speakerId": 1095,
            "speakerName": "希诺宁",
            "text": "好了，我把婶婶锁在了屋里，也捆上了好几道绳子。等会我就把她带去部族，让她受到应有的惩罚。",
            "nextDialogs": [
              "150150902"
            ]
          },
          "150150902": {
            "id": "150150902",
            "speakerId": 1095,
            "speakerName": "希诺宁",
            "text": "现在嘛…我们就先离那个屋子远点，在这里晒晒太阳吧。",
            "nextDialogs": [
              "150150903"
            ]
          },
          "150150903": {
            "id": "150150903",
            "speakerId": 1095,
            "speakerName": "希诺宁",
            "text": "折腾那么久，我真的要累瘫了…",
            "nextDialogs": [
              "150150904"
            ]
          },
          "150150904": {
            "id": "150150904",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "一下子全都安排好了，希诺宁的效率可真高…",
            "nextDialogs": [
              "150150905"
            ]
          },
          "150150905": {
            "id": "150150905",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "唉…现在想想也好可怕。特拉佐莉居然想把收养来的孩子变成妮赫佳，还差点成功了…",
            "nextDialogs": [
              "150150908"
            ]
          },
          "150150908": {
            "id": "150150908",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "是啊，希诺宁倒计时的时候真帅气，呼啦一下就冲了上去，一口气搞定了所有事情！",
            "nextDialogs": [
              "150150909"
            ]
          },
          "150150909": {
            "id": "150150909",
            "speakerId": 1095,
            "speakerName": "希诺宁",
            "text": "这也是多亏了妮佩卡一直没有放弃。要是没有她一直那么勇敢地尝试求救，我可没那么容易就察觉到婶婶的计划。"
          }
        }
      }
    },

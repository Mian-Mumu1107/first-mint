    {
      "subId": "1501511",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "150151101"
        ],
        "dialogs": {
          "150151101": {
            "id": "150151101",
            "speakerId": 1095,
            "speakerName": "希诺宁",
            "text": "噢，你们来了啊，事情都处理完了。呼啊…我正打算去睡觉呢。",
            "nextDialogs": [
              "150151103",
              "150151108",
              "150151113",
              "150151117"
            ]
          },
          "150151103": {
            "id": "150151103",
            "speakerId": 1095,
            "speakerName": "希诺宁",
            "text": "婶婶啊。部族里还在商量怎么处罚她呢。",
            "nextDialogs": [
              "150151104"
            ]
          },
          "150151104": {
            "id": "150151104",
            "speakerId": 1095,
            "speakerName": "希诺宁",
            "text": "毕竟，用古名技术来犯罪的人，古往今来也没多少…帕加尔可要头疼一阵了。",
            "nextDialogs": [
              "150151105"
            ]
          },
          "150151105": {
            "id": "150151105",
            "speakerId": 1095,
            "speakerName": "希诺宁",
            "text": "至于她的工坊，部族里已经派人去看着了，过几天应该就会彻底封闭，剩余那些未成型的「燃晶名刻」应该也会彻底销毁。",
            "nextDialogs": [
              "150151106"
            ]
          },
          "150151106": {
            "id": "150151106",
            "speakerId": 1095,
            "speakerName": "希诺宁",
            "text": "还好她的「古名」没出问题，不然乱子可就大了。"
          },
          "150151108": {
            "id": "150151108",
            "speakerId": 1095,
            "speakerName": "希诺宁",
            "text": "说到这个，倒是有个好消息。「燃晶名刻」所汲取的记忆是可恢复的。",
            "nextDialogs": [
              "150151109"
            ]
          },
          "150151109": {
            "id": "150151109",
            "speakerId": 1095,
            "speakerName": "希诺宁",
            "text": "在「燃晶名刻」彻底停机后，那些回忆应该就会顺着原路，物归原主了。",
            "nextDialogs": [
              "150151110"
            ]
          },
          "150151110": {
            "id": "150151110",
            "speakerId": 1095,
            "speakerName": "希诺宁",
            "text": "婶婶想要妮赫佳回来，所以让整个部族的人都忘记了妮赫佳。",
            "nextDialogs": [
              "150151111"
            ]
          },
          "150151111": {
            "id": "150151111",
            "speakerId": 1095,
            "speakerName": "希诺宁",
            "text": "现在妮赫佳真的离开了，大家却又即将想起她…真是乱七八糟。"
          },
          "150151113": {
            "id": "150151113",
            "speakerId": 1095,
            "speakerName": "希诺宁",
            "text": "妮佩卡啊。现在正在我的工坊里帮忙呢，我也联系了同族的人，准备查一查这孩子的身世。",
            "nextDialogs": [
              "150151114"
            ]
          },
          "150151114": {
            "id": "150151114",
            "speakerId": 1095,
            "speakerName": "希诺宁",
            "text": "现在族里还没给我回信，所以我就先照顾着她，顺便教她点手艺。",
            "nextDialogs": [
              "150151115"
            ]
          },
          "150151115": {
            "id": "150151115",
            "speakerId": 1095,
            "speakerName": "希诺宁",
            "text": "妮佩卡的学习速度虽然慢了点…但态度还不错。等她在成长一些，说不定也能成为一名铸名师啊。"
          },
          "150151117": {
            "id": "150151117",
            "speakerId": 1095,
            "speakerName": "希诺宁",
            "text": "嗯，回头见。这事情有什么新进展了，我会告诉你的。"
          }
        }
      }
    },
    {
      "subId": "1501512",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "150151201"
        ],
        "dialogs": {
          "150151201": {
            "id": "150151201",
            "speakerId": 14739,
            "speakerName": "妮佩卡",
            "text": "你好！欢迎来到…来到…",
            "nextDialogs": [
              "150151203",
              "150151211"
            ]
          },
          "150151203": {
            "id": "150151203",
            "speakerId": 14739,
            "speakerName": "妮佩卡",
            "text": "#派蒙姐姐，{NICKNAME}{M#哥哥}{F#姐姐}！我…在这里过得很开心呀。",
            "nextDialogs": [
              "150151204"
            ]
          },
          "150151204": {
            "id": "150151204",
            "speakerId": 14739,
            "speakerName": "妮佩卡",
            "text": "每天都可以学到很多东西，也能吃到好吃的…虽然在锻打东西的时候被火星溅到手很痛，但我不怕痛。",
            "nextDialogs": [
              "150151205"
            ]
          },
          "150151205": {
            "id": "150151205",
            "speakerId": 14739,
            "speakerName": "妮佩卡",
            "text": "希诺宁姐姐还说，她已经在帮我查身世了，虽然现在还没有消息…但我相信希诺宁姐姐！",
            "nextDialogs": [
              "150151206"
            ]
          },
          "150151206": {
            "id": "150151206",
            "speakerId": 14739,
            "speakerName": "妮佩卡",
            "text": "我现在每天都会写日记，把经历过的有趣事情都记下来。",
            "nextDialogs": [
              "150151207"
            ]
          },
          "150151207": {
            "id": "150151207",
            "speakerId": 14739,
            "speakerName": "妮佩卡",
            "text": "等到再梦见妮赫佳姐姐的时候，就把这些事情都告诉她，她一定会很高兴的。",
            "nextDialogs": [
              "150151208"
            ]
          },
          "150151208": {
            "id": "150151208",
            "speakerId": 14739,
            "speakerName": "妮佩卡",
            "text": "我还要告诉妮赫佳姐姐，我现在很努力地在学习，吃饭和长大，她不用担心我。",
            "nextDialogs": [
              "150151209"
            ]
          },
          "150151209": {
            "id": "150151209",
            "speakerId": 14739,
            "speakerName": "妮佩卡",
            "text": "唉，可是我一直都没有梦见妮赫佳姐姐，难道…她真的走了吗…"
          },
          "150151211": {
            "id": "150151211",
            "speakerId": 14739,
            "speakerName": "妮佩卡",
            "text": "#再见，派蒙姐姐，{NICKNAME}{M#哥哥}{F#姐姐}！"
          }
        }
      }
    }
  ]
}
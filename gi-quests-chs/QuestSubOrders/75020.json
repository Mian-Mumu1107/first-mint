            ]
          },
          "750202302": {
            "id": "750202302",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "#还好我有拉着{NICKNAME}啦，不然就真的差点掉进岩浆里了。",
            "nextDialogs": [
              "750202304",
              "750202306"
            ]
          },
          "750202304": {
            "id": "750202304",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "哼，你这家伙，别得寸进尺了，拉着你飞好累的！",
            "nextDialogs": [
              "750202307"
            ]
          },
          "750202307": {
            "id": "750202307",
            "speakerId": 1000,
            "speakerName": "提佐科",
            "text": "哎…哎，让我再喘口气，大概是把石头炸开这种方式对于岩浆来说还是太过刺激了吧。",

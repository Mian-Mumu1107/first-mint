    {
      "subId": "7502011",
      "subQuestName": "想办法令液态燃素上涨",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [],
        "dialogs": {}
      }
    },
    {
      "subId": "7502001",
      "subQuestName": "打碎凝固的大熔岩",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [],
        "dialogs": {}
      }
    },
    {
      "subId": "7502012",
      "subQuestName": "与提佐科对话",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "750201201"
        ],
        "dialogs": {
          "750201201": {
            "id": "750201201",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "哇，岩浆升上来了…火榴树的树根和岩浆接洽的地方还发出了一点光…",
            "nextDialogs": [
              "750201202"
            ]
          },
          "750201202": {
            "id": "750201202",
            "speakerId": 1000,
            "speakerName": "提佐科",
            "text": "这才是正常的景象…哎，火榴树真是神奇的植物。",
            "nextDialogs": [
              "750201203"
            ]
          },
          "750201203": {
            "id": "750201203",
            "speakerId": 1000,
            "speakerName": "提佐科",
            "text": "小的时候正是因为跟着父亲看到这样的情境，才在心里觉得，哎呀，我也得和我的老爹一样，认真看管这些树啊…",
            "nextDialogs": [
              "750201204"
            ]
          },
          "750201204": {
            "id": "750201204",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "这样就能让火榴果成熟吗？",
            "nextDialogs": [
              "750201205"
            ]
          },
          "750201205": {
            "id": "750201205",
            "speakerId": 1000,
            "speakerName": "提佐科",
            "text": "嗯，而且有了你和派蒙的帮助，这批火榴果能够如此饱满地吸收到液态燃素，一定能够长出最好的火榴果…咦？",
            "nextDialogs": [
              "750201206"
            ]
          },
          "750201206": {
            "id": "750201206",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "感觉是地震，不、不对，岩浆升上来了！快点往上跑呀——！"
          }
        }
      }
    },
    {
      "subId": "7502013",
      "subQuestName": "快速逃离！",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [],
        "dialogs": {}
      }
    },
    {
      "subId": "7502014",
      "subQuestName": "与提佐科对话",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "750201401"
        ],
        "dialogs": {
          "750201401": {
            "id": "750201401",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "吓、吓死我了。刚才是怎么一回事！岩浆就像是淤泥一样，「噗噜噗噜」地从地下涌了出来…",
            "nextDialogs": [
              "750201402"
            ]
          },
          "750201402": {
            "id": "750201402",
            "speakerId": 1000,
            "speakerName": "提佐科",
            "text": "哎…哎，让我再喘口气，大概是把石头炸开这种方式对于岩浆来说还是太过刺激了吧。",
            "nextDialogs": [
              "750201403"
            ]
          },
          "750201403": {
            "id": "750201403",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "不过，那个岩浆一下子淹得那么高，不会出问题吗…就像干枯的花一下子吸了很多水…",
            "nextDialogs": [
              "750201404"
            ]
          },
          "750201404": {
            "id": "750201404",
            "speakerId": 1000,
            "speakerName": "提佐科",
            "text": "这点倒…哎，这点倒不用担心，之后液态燃素的液面高度应该还是会一点点降下去。直到和以前一样稳定。",
            "nextDialogs": [
              "750201405"
            ]
          },
          "750201405": {
            "id": "750201405",
            "speakerId": 1000,
            "speakerName": "提佐科",
            "text": "#不过，哈哈，拜其所赐，看啊，{NICKNAME}，派蒙，「山王火榴」的颜色…",
            "nextDialogs": [
              "750201406"
            ]
          },
          "750201406": {
            "id": "750201406",
            "speakerId": 1000,
            "speakerName": "提佐科",
            "text": "我们不如靠近点看看吧！",
            "nextDialogs": [
              "750201407"
            ]
          },
          "750201407": {
            "id": "750201407",
            "speakerId": 1000,
            "speakerName": "提佐科",
            "text": "哎，「山王火榴」，这完美的颜色。",
            "nextDialogs": [
              "750201408"
            ]
          },
          "750201408": {
            "id": "750201408",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "哇！",
            "nextDialogs": [
              "750201411"
            ]
          },
          "750201411": {
            "id": "750201411",
            "speakerId": 1000,
            "speakerName": "提佐科",
            "text": "哎呀，只是看着，就感觉令人温暖的颜色…只要再观察几日，说不定就可以采摘。",
            "nextDialogs": [
              "750201412"
            ]
          },
          "750201412": {
            "id": "750201412",
            "speakerId": 1000,
            "speakerName": "提佐科",
            "text": "「山王」大人最近几年状态不是很好，如果能够吃到这个果子，说不定能恢复一些…",
            "nextDialogs": [
              "750201413"
            ]
          },
          "750201413": {
            "id": "750201413",
            "speakerId": 1000,
            "speakerName": "提佐科",
            "text": "真不知道如何感谢你们，这样…虽然不多，也是我的心意。",
            "nextDialogs": [
              "750201414"
            ]
          },
          "750201414": {
            "id": "750201414",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "哼哼，那我们就收下了，不对，你不是说，要让波卡多给酬劳嘛。",
            "nextDialogs": [
              "750201415"
            ]
          },
          "750201415": {
            "id": "750201415",
            "speakerId": 1000,
            "speakerName": "提佐科",
            "text": "说说的，她的归她的，我的归我的。我和她关系还没好到找人帮忙也得让她请客的程度。",
            "nextDialogs": [
              "750201416"
            ]
          },
          "750201416": {
            "id": "750201416",
            "speakerId": 1000,
            "speakerName": "提佐科",
            "text": "你看，哎，之前我就说，我就是火榴树的专家，没错吧！",
            "nextDialogs": [
              "750201417"
            ]
          },
          "750201417": {
            "id": "750201417",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "看来你不仅仅是了不起的守卫，还是了不起的专家！",
            "nextDialogs": [
              "750201418"
            ]
          },
          "750201418": {
            "id": "750201418",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "好啦，那我们就上去了，这次可别随便晕倒了！",
            "nextDialogs": [
              "750201419"
            ]
          },
          "750201419": {
            "id": "750201419",
            "speakerId": 1000,
            "speakerName": "提佐科",
            "text": "这里环境已经稳定了，没那么容易晕倒…不过通行证我得留下来，毕竟对部族来说还挺重要，哎…",
            "nextDialogs": [
              "750201420"
            ]
          },
          "750201420": {
            "id": "750201420",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "啊…那我们要是还想过来玩怎么办呀。",
            "nextDialogs": [
              "750201421"
            ]
          },
          "750201421": {
            "id": "750201421",
            "speakerId": 1000,
            "speakerName": "提佐科",
            "text": "你们要是再来参观参观的话——",
            "nextDialogs": [
              "750201422"
            ]
          },
          "750201422": {
            "id": "750201422",
            "speakerId": 1000,
            "speakerName": "提佐科",
            "text": "那我也只能像匿叶龙那样闭上对着你们的眼睛——睁一只眼闭一只眼了。"
          }
        }
      }
    },

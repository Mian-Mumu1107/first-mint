    {
      "subId": "7213001",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "721300101"
        ],
        "dialogs": {
          "721300101": {
            "id": "721300101",
            "speakerId": 12179,
            "speakerName": "观察",
            "text": "形状奇特的石灯，似乎放射着令人不安的能量。",
            "nextDialogs": [
              "721300102"
            ]
          },
          "721300102": {
            "id": "721300102",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "这个石灯笼好邪门…散发着一种似曾相识的气息呢。",
            "nextDialogs": [
              "721300103"
            ]
          },
          "721300103": {
            "id": "721300103",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "欸，好像有人在灯柱上写了字！",
            "nextDialogs": [
              "721300104"
            ]
          },
          "721300104": {
            "id": "721300104",
            "speakerId": 12179,
            "speakerName": "观察",
            "text": "「驻守的兵士，关于此镇物如有疑问，请至无想刃狭间，与梶先生商谈。」",
            "nextDialogs": [
              "721300105"
            ]
          },
          "721300105": {
            "id": "721300105",
            "speakerId": 12179,
            "speakerName": "观察",
            "text": "字看起来很新，但也有被雨水冲刷的痕迹。下面还有几列更清晰的小字",
            "nextDialogs": [
              "721300106"
            ]
          },
          "721300106": {
            "id": "721300106",
            "speakerId": 12179,
            "speakerName": "观察",
            "text": "「陌生笔记，请勿轻信。行军贵在神速，此必为贼人缓兵之计。」",
            "nextDialogs": [
              "721300107"
            ]
          },
          "721300107": {
            "id": "721300107",
            "speakerId": 12179,
            "speakerName": "观察",
            "text": "「私自离队开小差者，必有重罚！」",
            "nextDialogs": [
              "721300108"
            ]
          },
          "721300108": {
            "id": "721300108",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "这个梶先生似乎对石灯笼很在意的样子，我们不如去无想刃狭间问问他吧？"
          }
        }
      }
    },
    {
      "subId": "7213003",

      }
    },
    {
      "subId": "2302904",
      "subQuestName": "向雅丝敏回报",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "230290401"
        ],
        "dialogs": {
          "230290401": {
            "id": "230290401",
            "speakerId": 4178,
            "speakerName": "雅丝敏",
            "text": "怎么样，你们记录到圣树的全貌了吗？",
            "nextDialogs": [
              "230290402"
            ]
          },
          "230290402": {
            "id": "230290402",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "已经记录到了。",
            "nextDialogs": [
              "230290403"
            ]
          },
          "230290403": {
            "id": "230290403",
            "speakerId": 4178,
            "speakerName": "雅丝敏",
            "text": "喔！让我看看…",
            "nextDialogs": [
              "230290404"
            ]
          },
          "230290404": {
            "id": "230290404",
            "speakerId": 4178,
            "speakerName": "雅丝敏",
            "text": "真不错，角度很好，记录得也很清晰。",
            "nextDialogs": [
              "230290405"
            ]
          },
          "230290405": {
            "id": "230290405",
            "speakerId": 4178,
            "speakerName": "雅丝敏",
            "text": "这些报酬给你，谢谢你帮忙，旅行者。",
            "nextDialogs": [
              "230290406"
            ]
          },
          "230290406": {
            "id": "230290406",
            "speakerId": 4178,
            "speakerName": "雅丝敏",
            "text": "主干没有问题…周围的枝干轮廓也没有变…",
            "nextDialogs": [
              "230290407"
            ]
          },
          "230290407": {
            "id": "230290407",
            "speakerId": 4178,
            "speakerName": "雅丝敏",
            "text": "剩下的就等拉德普和法尔希搜集好数据，我们就可以继续下一个课题了…"
          }
        }
      }
    }
  ]

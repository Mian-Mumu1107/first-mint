  "subQuests": [
    {
      "subId": "2302901",
      "subQuestName": "与雅丝敏对话",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "230290101"
        ],
        "dialogs": {
          "230290101": {
            "id": "230290101",
            "speakerId": 4178,
            "speakerName": "雅丝敏",
            "text": "也差不多是时候了…",
            "nextDialogs": [
              "230290102"
            ]
          },
          "230290102": {
            "id": "230290102",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "你还在研究圣树根系吗？",
            "nextDialogs": [
              "230290103"
            ]
          },
          "230290103": {
            "id": "230290103",
            "speakerId": 4178,
            "speakerName": "雅丝敏",
            "text": "旅行者，每次你都来得这么巧。",
            "nextDialogs": [
              "230290104"
            ]
          },
          "230290104": {
            "id": "230290104",
            "speakerId": 4178,
            "speakerName": "雅丝敏",
            "text": "非常感谢你之前的帮助，圣树的情况非常好。",
            "nextDialogs": [
              "230290105"
            ]
          },
          "230290105": {
            "id": "230290105",
            "speakerId": 4178,
            "speakerName": "雅丝敏",
            "text": "我和拉德普讨论过后，认为这种好情况还会保持很长一段时间。",
            "nextDialogs": [
              "230290106"
            ]
          },
          "230290106": {
            "id": "230290106",
            "speakerId": 4178,
            "speakerName": "雅丝敏",
            "text": "这下我们终于可以腾出手来，为我们的论文做一些准备工作了。",
            "nextDialogs": [
              "230290107"
            ]
          },
          "230290107": {
            "id": "230290107",
            "speakerId": 4178,
            "speakerName": "雅丝敏",
            "text": "瞧，我从法尔希那边借来了一部「留影机」，正准备去记录一下圣树的情况。",
            "nextDialogs": [
              "230290108"
            ]
          },
          "230290108": {
            "id": "230290108",
            "speakerId": 4178,
            "speakerName": "雅丝敏",
            "text": "旅行者，你也帮我去一个地方记录一下圣树的全貌吧，我把地点给你标在地图上。",
            "nextDialogs": [
              "230290111"
            ]
          },
          "230290111": {
            "id": "230290111",
            "speakerId": 4178,
            "speakerName": "雅丝敏",
            "text": "呃，那边…那边…太高了…",
            "nextDialogs": [
              "230290112"
            ]
          },
          "230290112": {
            "id": "230290112",
            "speakerId": 4178,
            "speakerName": "雅丝敏",
            "text": "我每次一个人去到很高的地方都会很害怕…总觉得会有一股风把我…或者我的文稿给吹走…",
            "nextDialogs": [
              "230290113"
            ]
          },
          "230290113": {
            "id": "230290113",
            "speakerId": 4178,
            "speakerName": "雅丝敏",
            "text": "平时都是法尔希去那边记录，但今天他似乎有别的事要忙，所以就只能拜托你了，旅行者。"
          }
        }
      }
    },
    {
      "subId": "2302902",
      "subQuestName": "在指定地点，记录圣树全貌",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "230290201"
        ],
        "dialogs": {
          "230290201": {
            "id": "230290201",
            "speakerId": 4178,
            "speakerName": "雅丝敏",
            "text": "记录圣树全貌的事就拜托你了，旅行者。"
          }
        }
      }
    },
    {
      "subId": "2302903",
      "subQuestName": "记录圣树全貌",
      "sceneId": null,
      "locations": [],

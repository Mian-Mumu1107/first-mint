        "dialogs": {
          "749370101": {
            "id": "749370101",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "关于莉诺尔…",
            "nextDialogs": [
              "749370102"
            ]
          },
          "749370102": {
            "id": "749370102",
            "speakerId": 1000,
            "speakerName": "艾蒂安",
            "text": "其实由我直接将她带出梅洛彼得堡，送去亲人身边也是一个可行的办法…但是那样我就变成主犯了，这代价我可支付不了。",
            "nextDialogs": [
              "749370103"
            ]
          },
          "749370103": {
            "id": "749370103",
            "speakerId": 1000,
            "speakerName": "艾蒂安",
            "text": "你或许会说，真是自私啊。我只会回答你说得对。世上有无数需要解救的人，而我甚至不能放弃自己的一切去解救其中的一个。",
            "nextDialogs": [
              "749370104"
            ]
          },
          "749370104": {
            "id": "749370104",
            "speakerId": 1000,
            "speakerName": "艾蒂安",
            "text": "我是个小人物，只能做些小人物能够做到的事，比如从旁协助。",
            "nextDialogs": [
              "749370105"
            ]
          },
          "749370105": {
            "id": "749370105",
            "speakerId": 1000,
            "speakerName": "艾蒂安",
            "text": "因为我是个小人物，所以即使我不能赞同自己的选择，我也原谅自己。"
          }
        }
      }
    }
  ]
}
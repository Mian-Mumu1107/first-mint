  "subQuests": [
    {
      "subId": "7152801",
      "subQuestName": "对战「天崩石裂超级强者」",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "716666001"
        ],
        "dialogs": {
          "716666001": {
            "id": "716666001",
            "speakerId": 1000,
            "speakerName": "「超级强者的随行厨神」",
            "text": "哟！各位好呀，最近玩得还开心吗？",
            "nextDialogs": [
              "716666002"
            ]
          },
          "716666002": {
            "id": "716666002",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "香菱，锅巴！你们终于来了！放牛{RUBY#[D]「真剑斗虫大鬼王」}的现在可正在劲头上呢。",
            "nextDialogs": [
              "716666003"
            ]
          },
          "716666003": {
            "id": "716666003",
            "speakerId": 1002,
            "speakerName": "荒泷一斗",
            "text": "总算等到这一天了！",
            "nextDialogs": [
              "716666004"
            ]
          },
          "716666004": {
            "id": "716666004",
            "speakerId": 1002,
            "speakerName": "荒泷一斗",
            "text": "锅巴兄！就让你见识一下，经历了「荒泷甲光烈烈大修行」后，本大爷…哦不，是我和「赤红一杵」的实力！",
            "nextDialogs": [
              "716666005"
            ]
          },
          "716666005": {
            "id": "716666005",
            "speakerId": 1002,
            "speakerName": "荒泷一斗",
            "text": "然后，就要麻烦你教教我了——如何跟「赤红一杵」，还有「水晶岛梆梆旋风」这些甲壳生物交流！",
            "nextDialogs": [
              "716666006"
            ]
          },
          "716666006": {
            "id": "716666006",
            "speakerId": 1002,
            "speakerName": "荒泷一斗",
            "text": "等到我成为了斗虫界最有名望的强者，我就要…在荒泷派的鬼兜虫本阵，为你打造一座特大特威风的雕像！",
            "nextDialogs": [
              "716666007"
            ]
          },
          "716666007": {
            "id": "716666007",
            "speakerId": 1003,
            "speakerName": "「天崩石裂超级强者」",
            "text": "♪~",
            "nextDialogs": [
              "716666008"
            ]
          },
          "716666008": {
            "id": "716666008",
            "speakerId": 1002,
            "speakerName": "荒泷一斗",
            "text": "什么！这就是是锅巴兄自备的鬼兜虫吗…",
            "nextDialogs": [
              "716666009"
            ]
          },
          "716666009": {
            "id": "716666009",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "质感看起来很不一般！",
            "nextDialogs": [
              "716666010"
            ]
          },
          "716666010": {
            "id": "716666010",
            "speakerId": 1004,
            "speakerName": "「花角玉将」",
            "text": "不像是正常鬼兜虫的甲壳，而是某种坚韧的木质材料，难道它穿上了装甲？",
            "nextDialogs": [
              "716666011"
            ]
          },
          "716666011": {
            "id": "716666011",
            "speakerId": 1005,
            "speakerName": "烟绯",
            "text": "姥姥听说了「荒泷甲光烈烈斗虫大修行」的前因后果，觉得「锅巴可能收徒」这件事很有意思…",
            "nextDialogs": [
              "716666012"
            ]
          },
          "716666012": {
            "id": "716666012",
            "speakerId": 1005,
            "speakerName": "烟绯",
            "text": "正好，有位朋友给她制作了许多园艺机关，用来打理花坛里的霓裳花，名为「花羽叶月神机」。",
            "nextDialogs": [
              "716666013"
            ]
          },
          "716666013": {
            "id": "716666013",
            "speakerId": 1000,
            "speakerName": "「超级强者的随行厨神」",
            "text": "「花羽叶月神机」可以化形为各种动物，自然地融入环境。松鼠、蝴蝶、团雀都不在话下，当然也包括鬼兜虫。",
            "nextDialogs": [
              "716666014"
            ]
          },
          "716666014": {
            "id": "716666014",
            "speakerId": 1000,
            "speakerName": "「超级强者的随行厨神」",
            "text": "所以，师父给了锅巴一个「花羽叶月神机」，让它化形为鬼兜虫的模样，且来与你一战。",
            "nextDialogs": [
              "716666015"
            ]
          },
          "716666015": {
            "id": "716666015",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "真的只是园艺机关而已吗？",
            "nextDialogs": [
              "716666016"
            ]
          },
          "716666016": {
            "id": "716666016",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "香菱的师父是萍姥姥…萍姥姥的朋友…萍姥姥的朋友！",
            "nextDialogs": [
              "716666019"
            ]
          },
          "716666019": {
            "id": "716666019",
            "speakerId": 1002,
            "speakerName": "荒泷一斗",
            "text": "机关怎么可能模拟鬼兜虫的特点嘛！难道锅巴兄是想试探我们的实力，所以故意用了很弱的家伙来对阵？",
            "nextDialogs": [
              "716666020"
            ]
          },
          "716666020": {
            "id": "716666020",
            "speakerId": 1004,
            "speakerName": "「花角玉将」",
            "text": "还是小心为妙，鬼王，我好像感知不到那只机关鬼兜虫的气息…或者说，深不见底。",
            "nextDialogs": [
              "716666021"
            ]
          },
          "716666021": {
            "id": "716666021",
            "speakerId": 1002,
            "speakerName": "荒泷一斗",
            "text": "机关又不是活的，你感觉不到气势很正常。",
            "nextDialogs": [
              "716666022"
            ]
          },
          "716666022": {
            "id": "716666022",
            "speakerId": 1002,
            "speakerName": "荒泷一斗",
            "text": "呃咳，虽说锅巴兄的确强得没边，但强者也需要趁手的武器和默契的伙伴。我和「赤红一杵」的组合可不是吃素的哦！",
            "nextDialogs": [
              "716666023"
            ]
          },
          "716666023": {
            "id": "716666023",
            "speakerId": 1002,
            "speakerName": "荒泷一斗",
            "text": "开始对决吧，我会用接下来的一招一式，向锅巴兄好好证明我们的实力！",
            "nextDialogs": [
              "716666024"
            ]
          },
          "716666024": {
            "id": "716666024",
            "speakerId": 1003,
            "speakerName": "「天崩石裂超级强者」",
            "text": "♪——"
          }
        }
      }
    },
    {
      "subId": "7152802",

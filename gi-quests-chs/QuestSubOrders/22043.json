  "subQuests": [
    {
      "subId": "2204301",
      "subQuestName": "与大岛纯平对话",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "220430101"
        ],
        "dialogs": {
          "220430101": {
            "id": "220430101",
            "speakerId": 3182,
            "speakerName": "大岛纯平",
            "text": "木头怎么又用完了…",
            "nextDialogs": [
              "220430102"
            ]
          },
          "220430102": {
            "id": "220430102",
            "speakerId": 3182,
            "speakerName": "大岛纯平",
            "text": "哦！旅行者，你来得正好，你愿意帮我个忙吗？",
            "nextDialogs": [
              "220430105"
            ]
          },
          "220430105": {
            "id": "220430105",
            "speakerId": 3182,
            "speakerName": "大岛纯平",
            "text": "我最近，正尝试着按照代宫司大人的模样雕刻一些尺寸很小的木雕。",
            "nextDialogs": [
              "220430106"
            ]
          },
          "220430106": {
            "id": "220430106",
            "speakerId": 3182,
            "speakerName": "大岛纯平",
            "text": "我想，等我雕得好一些之后，就带着这些木雕回鸣神岛去，看看能不能卖出去…",
            "nextDialogs": [
              "220430107"
            ]
          },
          "220430107": {
            "id": "220430107",
            "speakerId": 3182,
            "speakerName": "大岛纯平",
            "text": "如果真能卖出去的话，应该也能算是一份稳定的收入了。"
          }
        }
      }
    },
    {
      "subId": "2204302",
      "subQuestName": "将10份「御伽木」交给大岛纯平",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "220430201"
        ],
        "dialogs": {
          "220430201": {
            "id": "220430201",
            "speakerId": 3182,
            "speakerName": "大岛纯平",
            "text": "怎么样，你搜集到10份「御伽木」了吗？"
          }
        }
      }
    },
    {
      "subId": "2204303",
      "subQuestName": "与大岛纯平对话",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "220430301"
        ],
        "dialogs": {
          "220430301": {
            "id": "220430301",
            "speakerId": 3182,
            "speakerName": "大岛纯平",
            "text": "嗯，这些应该就够用了。抱歉啊，你好不容易过来神社，我还拜托你帮忙…这些东西你先收下吧。",
            "nextDialogs": [
              "220430302"
            ]
          },
          "220430302": {
            "id": "220430302",
            "speakerId": 3182,
            "speakerName": "大岛纯平",
            "text": "等我木雕的手艺练好了，我一定送你一座最好的木雕。",
            "nextDialogs": [
              "220430303"
            ]
          },
          "220430303": {
            "id": "220430303",
            "speakerId": 3182,
            "speakerName": "大岛纯平",
            "text": "唔，接下来雕个什么样的代宫司大人好呢…"
          }
        }
      }
    }
  ]
}
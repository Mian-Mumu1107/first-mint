      }
    },
    {
      "subId": "1204209",
      "subQuestName": "与影和八重神子交谈",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [],
        "dialogs": {}
      }
    },
    {
      "subId": "1204299",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "120429901"
        ],
        "dialogs": {
          "120429901": {
            "id": "120429901",
            "speakerId": 1036,
            "speakerName": "雷电将军",
            "text": "对决所需的时间，足以见证王国兴起又覆灭。",
            "nextDialogs": [
              "120429902"
            ]
          },
          "120429902": {
            "id": "120429902",
            "speakerId": 1036,
            "speakerName": "雷电将军",
            "text": "对决所耗的能量，足以倾倒大海、覆灭天光。",
            "nextDialogs": [
              "120429903"
            ]
          },
          "120429903": {
            "id": "120429903",
            "speakerId": 1036,
            "speakerName": "雷电将军",

      }
    },
    {
      "subId": "1204203",
      "subQuestName": "回到神秘空间的入口处",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "120420301"
        ],
        "dialogs": {
          "120420301": {
            "id": "120420301",
            "speakerId": 12076,
            "speakerName": "影",
            "text": "……",
            "nextDialogs": [
              "120420302"
            ]
          },
          "120420302": {
            "id": "120420302",
            "speakerId": 12076,
            "speakerName": "影",
            "text": "为什么？",
            "nextDialogs": [
              "120420303"
            ]
          },
          "120420303": {
            "id": "120420303",
            "speakerId": 12076,
            "speakerName": "影",
            "text": "你们…怎么能再次来到这里？而且…你们的模样居然还和当年一样…",
            "nextDialogs": [
              "120420304"
            ]
          },
          "120420304": {
            "id": "120420304",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "当年？你的意思是…",
            "nextDialogs": [
              "120420305"
            ]
          },
          "120420305": {
            "id": "120420305",
            "speakerId": 1036,
            "speakerName": "雷电将军",
            "text": "这场对决，令人甚是怀念。",
            "nextDialogs": [
              "120420306"
            ]
          },
          "120420306": {
            "id": "120420306",
            "speakerId": 1036,
            "speakerName": "雷电将军",
            "text": "仿佛回到了永恒的法则刚刚订立之时，你如今这份意志，竟堪比那时。",
            "nextDialogs": [
              "120420307"
            ]
          },
          "120420307": {
            "id": "120420307",
            "speakerId": 1036,
            "speakerName": "雷电将军",
            "text": "无数场战斗，你一次都未落败，也丝毫没有犹豫。",
            "nextDialogs": [
              "120420308"
            ]
          },
          "120420308": {
            "id": "120420308",
            "speakerId": 1036,
            "speakerName": "雷电将军",
            "text": "即便我将一切永恒之敌都展现在你的面前，你也不曾动摇。",
            "nextDialogs": [
              "120420309"
            ]
          },
          "120420309": {
            "id": "120420309",
            "speakerId": 12076,
            "speakerName": "影",
            "text": "能如此坚定地执行规则，你也值得敬佩。",
            "nextDialogs": [
              "120420310"
            ]
          },
          "120420310": {
            "id": "120420310",
            "speakerId": 12076,
            "speakerName": "影",
            "text": "你无愧「永恒的守护者」之名。",
            "nextDialogs": [
              "120420311"
            ]
          },
          "120420311": {
            "id": "120420311",
            "speakerId": 1036,
            "speakerName": "雷电将军",
            "text": "#{PLAYERAVATAR#SEXPRO[INFO_MALE_PRONOUN_HE|INFO_FEMALE_PRONOUN_SHE]}们再次回到这个空间，就像是命运的必然一般。",
            "nextDialogs": [
              "120420312"
            ]
          },
          "120420312": {
            "id": "120420312",
            "speakerId": 1036,
            "speakerName": "雷电将军",
            "text": "那就以这决战，为我们五百多年的宿命画上句号吧。",
            "nextDialogs": [
              "120420313"
            ]
          },
          "120420313": {
            "id": "120420313",
            "speakerId": 12076,
            "speakerName": "影",
            "text": "决战？难道你终于…",
            "nextDialogs": [
              "120420314"
            ]
          },
          "120420314": {
            "id": "120420314",
            "speakerId": 12076,
            "speakerName": "影",
            "text": "向后退，旅行者。",
            "nextDialogs": [
              "120420315"
            ]
          },
          "120420315": {
            "id": "120420315",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "你要结束一切吗？",
            "nextDialogs": [
              "120420316"
            ]
          },
          "120420316": {
            "id": "120420316",
            "speakerId": 12076,
            "speakerName": "影",
            "text": "我会成为下一个「开始」。"
          }
        }
      }
    },
    {
      "subId": "1204204",
      "subQuestName": "与八重神子交谈",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "120420201"
        ],
        "dialogs": {
          "120420201": {
            "id": "120420201",
            "speakerId": 1034,
            "speakerName": "八重神子",
            "text": "办法嘛，总是有的，虽然有些狡猾。",
            "nextDialogs": [
              "120420202"
            ]
          },
          "120420202": {
            "id": "120420202",
            "speakerId": 1034,
            "speakerName": "八重神子",
            "text": "意识空间对外行来说非常抽象。好在我是影的眷属，多少能感应到她的所在之处。",
            "nextDialogs": [
              "120420203"
            ]
          },
          "120420203": {
            "id": "120420203",
            "speakerId": 1034,
            "speakerName": "八重神子",
            "text": "换句话说，我无法定位那个地点在空间里的具体位置，但能把你们送到影身边去。",
            "nextDialogs": [
              "120420204"
            ]
          },
          "120420204": {
            "id": "120420204",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "抽象…？位置？什么跟什么…",
            "nextDialogs": [
              "120420205"
            ]
          },
          "120420205": {
            "id": "120420205",
            "speakerId": 1034,
            "speakerName": "八重神子",
            "text": "你不用理解了。简单来说，现在她身旁的一切都很混沌。",
            "nextDialogs": [
              "120420206"
            ]
          },
          "120420206": {
            "id": "120420206",
            "speakerId": 1034,
            "speakerName": "八重神子",
            "text": "如湍流一般无序…强行闯入也许会被巨浪卷走，彻底迷失在时间空间之中哦。",
            "nextDialogs": [
              "120420207"
            ]
          },
          "120420207": {
            "id": "120420207",
            "speakerId": 1034,
            "speakerName": "八重神子",
            "text": "正因如此，进入「一心净土」时把意识寄宿在物体上，才是比较保险的做法。",
            "nextDialogs": [
              "120420208"
            ]
          },
          "120420208": {
            "id": "120420208",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "啊？那我不去了，你们去吧！",
            "nextDialogs": [
              "120420211"
            ]
          },
          "120420211": {
            "id": "120420211",
            "speakerId": 1034,
            "speakerName": "八重神子",
            "text": "不去也行，最坏的情况不就是失去影吗？",
            "nextDialogs": [
              "120420212"
            ]
          },
          "120420212": {
            "id": "120420212",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "#你、你们…唉讨厌啦！我陪你去吧，{NICKNAME}…",
            "nextDialogs": [
              "120420213"
            ]
          },
          "120420213": {
            "id": "120420213",
            "speakerId": 1034,
            "speakerName": "八重神子",
            "text": "既然心意已决，那我就送你上路了哦。",
            "nextDialogs": [
              "120420214"
            ]
          },
          "120420214": {
            "id": "120420214",
            "speakerId": 1034,
            "speakerName": "八重神子",
            "text": "……",
            "nextDialogs": [
              "120420215"
            ]
          },
          "120420215": {
            "id": "120420215",
            "speakerId": 1034,
            "speakerName": "八重神子",
            "text": "嗯？这是…",
            "nextDialogs": [
              "120420216"
            ]
          },
          "120420216": {
            "id": "120420216",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "怎么了？",
            "nextDialogs": [
              "120420217"
            ]
          },
          "120420217": {
            "id": "120420217",
            "speakerId": 1034,
            "speakerName": "八重神子",
            "text": "没什么。感觉很紊乱，证实了我心中的判断。",
            "nextDialogs": [
              "120420218"
            ]
          },
          "120420218": {
            "id": "120420218",
            "speakerId": 1034,
            "speakerName": "八重神子",
            "text": "对了，在进入空间时，记得不断在心中重复你的愿望哦。",
            "nextDialogs": [
              "120420219"
            ]
          },
          "120420219": {
            "id": "120420219",
            "speakerId": 1034,
            "speakerName": "八重神子",
            "text": "只有强大到一定地步的意识才能不被抽象空间里的巨浪吞没。你足够强，我才能将你送到最合适的位置。",
            "nextDialogs": [
              "120420220"
            ]
          },
          "120420220": {
            "id": "120420220",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "我知道了。",
            "nextDialogs": [
              "120420221"
            ]
          },
          "120420221": {
            "id": "120420221",
            "speakerId": 1034,
            "speakerName": "八重神子",
            "text": "那么，门开了，请进吧。",
            "nextDialogs": [
              "120420222"
            ]
          },
          "120420222": {
            "id": "120420222",
            "speakerId": 1034,
            "speakerName": "八重神子",
            "text": "我会守在外侧随机应变，做你的最后一道保险。",
            "nextDialogs": [
              "120420223"
            ]
          },
          "120420223": {
            "id": "120420223",
            "speakerId": 1034,
            "speakerName": "八重神子",
            "text": "#我的神明就交给你了，{NICKNAME}。",
            "nextDialogs": [
              "120420224"
            ]
          },
          "120420224": {
            "id": "120420224",
            "speakerId": 1034,
            "speakerName": "八重神子",
            "text": "为了我，为了稻妻，你可要好好努力啊。",
            "nextDialogs": [
              "120420225"
            ]
          },
          "120420225": {
            "id": "120420225",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "神子，你靠得住吗…",
            "nextDialogs": [
              "120420226"
            ]
          },
          "120420226": {
            "id": "120420226",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "我们一定会成功。",
            "nextDialogs": [
              "120420227"
            ]
          },
          "120420227": {
            "id": "120420227",
            "speakerId": 1034,
            "speakerName": "八重神子",
            "text": "好了好了，快去努力！"
          }
        }
      }
    },
    {
      "subId": "1204205",
      "subQuestName": "闯入空间之内",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "120420501"
        ],
        "dialogs": {
          "120420501": {
            "id": "120420501",
            "speakerId": 1002,
            "speakerName": "Black Screen",
            "text": "离开意识空间返回神社后，你们向八重神子讲述了一切…",
            "nextDialogs": [
              "120420502"
            ]
          },
          "120420502": {
            "id": "120420502",
            "speakerId": 1034,
            "speakerName": "八重神子",
            "text": "如今的影亲手在意识空间里种下神樱树，它在过去的稻妻发了芽…",
            "nextDialogs": [
              "120420503"
            ]
          },
          "120420503": {
            "id": "120420503",
            "speakerId": 1034,
            "speakerName": "八重神子",
            "text": "无论怎么想，都是不可思议的事呢。",
            "nextDialogs": [
              "120420504"
            ]
          },
          "120420504": {
            "id": "120420504",
            "speakerId": 12076,
            "speakerName": "影",
            "text": "这些都归功于真的力量。对于永恒，她的理解比我更深。",
            "nextDialogs": [
              "120420505"
            ]
          },
          "120420505": {
            "id": "120420505",
            "speakerId": 12076,
            "speakerName": "影",
            "text": "「永恒」是与时间息息相关的概念。一旦触及永恒，时间的概念就会变得模糊。",
            "nextDialogs": [
              "120420506"
            ]
          },
          "120420506": {
            "id": "120420506",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "进入空间时我看到了奇妙的景象。",
            "nextDialogs": [
              "120420507"
            ]
          },
          "120420507": {
            "id": "120420507",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "时间既在前进，又在后退。",
            "nextDialogs": [
              "120420508"
            ]
          },
          "120420508": {
            "id": "120420508",
            "speakerId": 1034,
            "speakerName": "八重神子",
            "text": "时间本身不具有意义，也无法以常理诠释…原来，这就是我感受到的「湍流」。",
            "nextDialogs": [
              "120420509"
            ]
          },
          "120420509": {
            "id": "120420509",
            "speakerId": 1034,
            "speakerName": "八重神子",
            "text": "或许，这正是你们能顺利返回这个时间节点的原因。",
            "nextDialogs": [
              "120420510"
            ]
          },
          "120420510": {
            "id": "120420510",
            "speakerId": 1034,
            "speakerName": "八重神子",
            "text": "不过，那种紊乱感已经完全消失了。",
            "nextDialogs": [
              "120420511"
            ]
          },
          "120420511": {
            "id": "120420511",
            "speakerId": 12076,
            "speakerName": "影",
            "text": "我还不能完全理解。但直觉告诉我，一切的根源…就是那颗种子。",
            "nextDialogs": [
              "120420512"
            ]
          },
          "120420512": {
            "id": "120420512",
            "speakerId": 1034,
            "speakerName": "八重神子",
            "text": "我倒觉得，只靠真的力量，或许…",
            "nextDialogs": [
              "120420513"
            ]
          },
          "120420513": {
            "id": "120420513",
            "speakerId": 12076,
            "speakerName": "影",
            "text": "我明白你在想什么。或许真有「更高层{RUBY#[D]伊斯塔露}次的力量」参与其中。但无论如何，她的这个办法在最后关头保护了我们所有人。",
            "nextDialogs": [
              "120420514"
            ]
          },
          "120420514": {
            "id": "120420514",
            "speakerId": 12076,
            "speakerName": "影",
            "text": "要是没有神樱树，稻妻可能早在几百年前就被灾难与污秽完全吞没了。",
            "nextDialogs": [
              "120420515"
            ]
          },
          "120420515": {
            "id": "120420515",
            "speakerId": 1034,
            "speakerName": "八重神子",
            "text": "我知道你对神樱树有奇妙的感知，可对我来说，神樱树一直都存在。",
            "nextDialogs": [
              "120420516"
            ]
          },
          "120420516": {
            "id": "120420516",
            "speakerId": 1034,
            "speakerName": "八重神子",
            "text": "以前你还想向我证明这棵神樱树与真的意识空间存在关联，可惜没能成功，对吧？",
            "nextDialogs": [
              "120420517"
            ]
          },
          "120420517": {
            "id": "120420517",
            "speakerId": 12076,
            "speakerName": "影",
            "text": "嗯，现在我明白了。因为那个时候神樱树甚至都还没有被种下去。",
            "nextDialogs": [
              "120420518"
            ]
          },
          "120420518": {
            "id": "120420518",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "可是，你们不觉得那棵树跟现在这副样子差别很大吗？",
            "nextDialogs": [
              "120420519"
            ]
          },
          "120420519": {
            "id": "120420519",
            "speakerId": 1034,
            "speakerName": "八重神子",
            "text": "神樱树可是种在我的地盘里，当然要根据我的趣味进行修剪啦。",
            "nextDialogs": [
              "120420520"
            ]
          },
          "120420520": {
            "id": "120420520",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "呃…你好霸道…",
            "nextDialogs": [
              "120420521"
            ]
          },
          "120420521": {
            "id": "120420521",
            "speakerId": 1034,
            "speakerName": "八重神子",
            "text": "开玩笑的。发芽至今，这棵树也经历了很多。多亏狐狸的悉心照料，它才能有如今这副模样。",
            "nextDialogs": [
              "120420522"
            ]
          },
          "120420522": {
            "id": "120420522",
            "speakerId": 1034,
            "speakerName": "八重神子",
            "text": "和我也不是完全无关的哦。",
            "nextDialogs": [
              "120420523"
            ]
          },
          "120420523": {
            "id": "120420523",
            "speakerId": 1034,
            "speakerName": "八重神子",
            "text": "你们离开又再次进入空间，按理说间隔很短，可内部的恶战已经持续了几百年，没错吧？",
            "nextDialogs": [
              "120420524"
            ]
          },
          "120420524": {
            "id": "120420524",
            "speakerId": 1034,
            "speakerName": "八重神子",
            "text": "如果我没猜错…旅行者，你一定像我说的，一直默念着心中的愿望吧？",
            "nextDialogs": [
              "120420527"
            ]
          },
          "120420527": {
            "id": "120420527",
            "speakerId": 1034,
            "speakerName": "八重神子",
            "text": "那时我感知到影的所在地，也同样察觉到内部的「时间」有异常。",
            "nextDialogs": [
              "120420528"
            ]
          },
          "120420528": {
            "id": "120420528",
            "speakerId": 1034,
            "speakerName": "八重神子",
            "text": "如果「时间」也是我们追寻所求之物的要素之一，那只知道「位置」是不够的。",
            "nextDialogs": [
              "120420529"
            ]
          },
          "120420529": {
            "id": "120420529",
            "speakerId": 1034,
            "speakerName": "八重神子",
            "text": "不过幸好，凭借你们顽强的意志，湍流带你们去到的，正是一切心愿汇聚的时间交点——最具有可能性的那个瞬间。",
            "nextDialogs": [
              "120420530"
            ]
          },
          "120420530": {
            "id": "120420530",
            "speakerId": 1034,
            "speakerName": "八重神子",
            "text": "湍流的走向或许受到了真的影响，但能帮到影，每个人的努力都不可或缺。这一次确实要谢谢你们呢。",
            "nextDialogs": [
              "120420531"
            ]
          },
          "120420531": {
            "id": "120420531",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "难道说，我们碰上那场决战不是偶然，而是我们一定会遇到、见证的场面…"
          }
        }
      }
    },
    {
      "subId": "1204211",
      "subQuestName": "闯入空间之内",
      "sceneId": null,
      "locations": [],
      "dialogue": {

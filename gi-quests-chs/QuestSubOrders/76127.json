    {
      "subId": "7612706",
      "subQuestName": "救出黑蛋",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "761270601"
        ],
        "dialogs": {
          "761270601": {
            "id": "761270601",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "黑蛋！我们来救你啦！",
            "nextDialogs": [
              "761270602"
            ]
          },
          "761270602": {
            "id": "761270602",
            "speakerId": 22255,
            "speakerName": "黑蛋",
            "text": "…放开我…",
            "nextDialogs": [
              "761270603"
            ]
          },
          "761270603": {
            "id": "761270603",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "喂！黑蛋，醒醒！是我们！",
            "nextDialogs": [
              "761270604"
            ]
          },
          "761270604": {
            "id": "761270604",
            "speakerId": 22255,
            "speakerName": "黑蛋",
            "text": "…你们…放开我…",
            "nextDialogs": [
              "761270605"
            ]
          },
          "761270605": {
            "id": "761270605",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "清醒一点啊！我们是来救你的！你已经安全了！",
            "nextDialogs": [
              "761270606"
            ]
          },
          "761270606": {
            "id": "761270606",
            "speakerId": 22255,
            "speakerName": "黑蛋",
            "text": "哦…哦…对不起…是你们…",
            "nextDialogs": [
              "761270607"
            ]
          },
          "761270607": {
            "id": "761270607",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "你怎么被那些东西抓走了啊？你知道这是什么地方吗？",
            "nextDialogs": [
              "761270608"
            ]
          },
          "761270608": {
            "id": "761270608",
            "speakerId": 22255,
            "speakerName": "黑蛋",
            "text": "…不知道…但是…",
            "nextDialogs": [
              "761270609"
            ]
          },
          "761270609": {
            "id": "761270609",
            "speakerId": 22255,
            "speakerName": "黑蛋",
            "text": "…请让我…接入终端…",
            "nextDialogs": [
              "761270610"
            ]
          },
          "761270610": {
            "id": "761270610",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "终端？终端是什么？",
            "nextDialogs": [
              "761270611"
            ]
          },
          "761270611": {
            "id": "761270611",
            "speakerId": 22255,
            "speakerName": "黑蛋",
            "text": "…它就在入口…终端有…信息…",
            "nextDialogs": [
              "761270612"
            ]
          },
          "761270612": {
            "id": "761270612",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "哦！是不是我们来的时候看见的那个？我们快去找找。"
          }
        }
      }
    },
    {
      "subId": "7612713",
      "subQuestName": "返回入口的终端",
      "sceneId": null,

    {
      "subId": "7612726",
      "subQuestName": "与黑蛋交谈",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "761272601"
        ],
        "dialogs": {
          "761272601": {
            "id": "761272601",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "这里就是「伊比尼伯龙之眼」了吗？感觉的确很不一般…",
            "nextDialogs": [
              "761272602"
            ]
          },
          "761272602": {
            "id": "761272602",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "哦！终端在那里。",
            "nextDialogs": [
              "761272603"
            ]
          },
          "761272603": {
            "id": "761272603",
            "speakerId": 22255,
            "speakerName": "黑蛋",
            "text": "我想…我会得到有用的信息。",
            "nextDialogs": [
              "761272604"
            ]
          },
          "761272604": {
            "id": "761272604",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "哼，但愿你不要变得更加膨胀。",
            "nextDialogs": [
              "761272605"
            ]
          },
          "761272605": {
            "id": "761272605",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "刚、刚才发生了什么？",
            "nextDialogs": [
              "761272606"
            ]
          },
          "761272606": {
            "id": "761272606",
            "speakerId": 22255,
            "speakerName": "黑蛋",
            "text": "我激活了…「伊比尼伯龙之眼」…",
            "nextDialogs": [
              "761272607"
            ]
          },
          "761272607": {
            "id": "761272607",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "哦？怎么样？能找到哥伦比娅吗？",
            "nextDialogs": [
              "761272608"
            ]
          },
          "761272608": {
            "id": "761272608",
            "speakerId": 22255,
            "speakerName": "黑蛋",
            "text": "嗯…终端监测到…在一个名叫「乌吉恩圈」的设施中…",
            "nextDialogs": [
              "761272609"
            ]
          },
          "761272609": {
            "id": "761272609",
            "speakerId": 22255,
            "speakerName": "黑蛋",
            "text": "出现了缺少识别代码的新个体…",
            "nextDialogs": [
              "761272610"
            ]
          },
          "761272610": {
            "id": "761272610",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "新个体？会是哥伦比娅吗？",
            "nextDialogs": [
              "761272611"
            ]
          },
          "761272611": {
            "id": "761272611",
            "speakerId": 22255,
            "speakerName": "黑蛋",
            "text": "系统无法确认身份…",
            "nextDialogs": [
              "761272612"
            ]
          },
          "761272612": {
            "id": "761272612",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "感觉需要过去看看了。",
            "nextDialogs": [
              "761272613"
            ]
          },
          "761272613": {
            "id": "761272613",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "嗯…虽然不能确定，但是至少有了方向…所以我们要怎么过去？",
            "nextDialogs": [
              "761272614"
            ]
          },
          "761272614": {
            "id": "761272614",
            "speakerId": 22255,
            "speakerName": "黑蛋",
            "text": "我来帮忙…看…我们可以通过这个过去…",
            "nextDialogs": [
              "761272615"
            ]
          },
          "761272615": {
            "id": "761272615",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "哇！这是什么？",
            "nextDialogs": [
              "761272616"
            ]
          },
          "761272616": {
            "id": "761272616",
            "speakerId": 22255,
            "speakerName": "黑蛋",
            "text": "是基于古月之力运行的…高速换行通道入口…",
            "nextDialogs": [
              "761272617"
            ]
          },
          "761272617": {
            "id": "761272617",
            "speakerId": 22255,
            "speakerName": "黑蛋",
            "text": "通过它…就可以抵达「伊比尼伯龙之眼」的下一站…「乌吉恩圈」…",
            "nextDialogs": [
              "761272618"
            ]
          },
          "761272618": {
            "id": "761272618",
            "speakerId": 22255,
            "speakerName": "黑蛋",
            "text": "终端记录着…那里生活着许多种类的生物…是生灵的家园…",
            "nextDialogs": [
              "761272619"
            ]
          },
          "761272619": {
            "id": "761272619",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "月球上还生活着许多种类的生物？真是不可思议…",
            "nextDialogs": [
              "761272620"
            ]
          },
          "761272620": {
            "id": "761272620",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "那我们现在就出发吧？",
            "nextDialogs": [
              "761272621"
            ]
          },
          "761272621": {
            "id": "761272621",
            "speakerId": 22255,
            "speakerName": "黑蛋",
            "text": "请等一等…终端里还有什么在响应我…",
            "nextDialogs": [
              "761272622"
            ]
          },
          "761272622": {
            "id": "761272622",
            "speakerId": 22255,
            "speakerName": "黑蛋",
            "text": "啊！",
            "nextDialogs": [
              "761272623"
            ]
          },
          "761272623": {
            "id": "761272623",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "黑蛋你怎么了！",
            "nextDialogs": [
              "761272624"
            ]
          },
          "761272624": {
            "id": "761272624",
            "speakerId": 22255,
            "speakerName": "黑蛋",
            "text": "有一个隐藏模块…「望月者计划」…它响应了我…",
            "nextDialogs": [
              "761272625"
            ]
          },
          "761272625": {
            "id": "761272625",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "是什么新情报吗？",
            "nextDialogs": [
              "761272626"
            ]
          },
          "761272626": {
            "id": "761272626",
            "speakerId": 22255,
            "speakerName": "黑蛋",
            "text": "这个模块…记录着这座高塔的起源…",
            "nextDialogs": [
              "761272627"
            ]
          },
          "761272627": {
            "id": "761272627",
            "speakerId": 22255,
            "speakerName": "黑蛋",
            "text": "它来自一位龙族先驱，名字是「伊比尼{RUBY#[S]最初的望月者}伯龙」…",
            "nextDialogs": [
              "761272628"
            ]
          },
          "761272628": {
            "id": "761272628",
            "speakerId": 22255,
            "speakerName": "黑蛋",
            "text": "我们乘坐的登月飞船…也是他的成果…是他带领着普通的龙族学者来到了月亮上…",
            "nextDialogs": [
              "761272629"
            ]
          },
          "761272629": {
            "id": "761272629",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "好、好厉害！那这座「伊比尼伯龙之眼」一定是为了纪念他吧？",
            "nextDialogs": [
              "761272630"
            ]
          },
          "761272630": {
            "id": "761272630",
            "speakerId": 22255,
            "speakerName": "黑蛋",
            "text": "不是这样的…终端里记录了这样一件事…",
            "nextDialogs": [
              "761272631"
            ]
          },
          "761272631": {
            "id": "761272631",
            "speakerId": 22255,
            "speakerName": "黑蛋",
            "text": "在那位先驱登陆月球后…就开始了对月亮和近月带的探索…",
            "nextDialogs": [
              "761272632"
            ]
          },
          "761272632": {
            "id": "761272632",
            "speakerId": 22255,
            "speakerName": "黑蛋",
            "text": "直到有一天…他在近月带接收到了一个…来自星空深处的神秘信号…",
            "nextDialogs": [
              "761272633"
            ]
          },
          "761272633": {
            "id": "761272633",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "星空深处的信号？那是什么？",
            "nextDialogs": [
              "761272634"
            ]
          },
          "761272634": {
            "id": "761272634",
            "speakerId": 22255,
            "speakerName": "黑蛋",
            "text": "学者们没能解读信号的含义…",
            "nextDialogs": [
              "761272635"
            ]
          },
          "761272635": {
            "id": "761272635",
            "speakerId": 22255,
            "speakerName": "黑蛋",
            "text": "但那位先驱认为…那是他们前往星海的王…传回的讯息…",
            "nextDialogs": [
              "761272636"
            ]
          },
          "761272636": {
            "id": "761272636",
            "speakerId": 22255,
            "speakerName": "黑蛋",
            "text": "王的名字是…「尼伯龙根」。",
            "nextDialogs": [
              "761272637"
            ]
          },
          "761272637": {
            "id": "761272637",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "是…是那位龙王？！真的是他传回来的信号吗？",
            "nextDialogs": [
              "761272638"
            ]
          },
          "761272638": {
            "id": "761272638",
            "speakerId": 22255,
            "speakerName": "黑蛋",
            "text": "不知道…因为学者们无法进入深空…",
            "nextDialogs": [
              "761272639"
            ]
          },
          "761272639": {
            "id": "761272639",
            "speakerId": 22255,
            "speakerName": "黑蛋",
            "text": "所以…他们建设了这座高塔…",
            "nextDialogs": [
              "761272640"
            ]
          },
          "761272640": {
            "id": "761272640",
            "speakerId": 22255,
            "speakerName": "黑蛋",
            "text": "这座「伊比尼伯龙之眼」…最初其实是一座深空信号接发站…为了再次捕捉那个信号…",
            "nextDialogs": [
              "761272641"
            ]
          },
          "761272641": {
            "id": "761272641",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "那后来他们成功了吗？",
            "nextDialogs": [
              "761272642"
            ]
          },
          "761272642": {
            "id": "761272642",
            "speakerId": 22255,
            "speakerName": "黑蛋",
            "text": "后来…过去了很多年…直到那位先驱离世…信号都没有再出现…",
            "nextDialogs": [
              "761272643"
            ]
          },
          "761272643": {
            "id": "761272643",
            "speakerId": 22255,
            "speakerName": "黑蛋",
            "text": "再后来…他的学生也放弃了…转去了更加务实的方向。",
            "nextDialogs": [
              "761272644"
            ]
          },
          "761272644": {
            "id": "761272644",
            "speakerId": 22255,
            "speakerName": "黑蛋",
            "text": "他们将「伊比尼伯龙之眼」改造成月球表面监测站…方便他们进行更实际的月球研究工作…",
            "nextDialogs": [
              "761272645"
            ]
          },
          "761272645": {
            "id": "761272645",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "好遗憾啊…感觉我们知道了很不得了的事…",
            "nextDialogs": [
              "761272646"
            ]
          },
          "761272646": {
            "id": "761272646",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "这就是「望月者计划」吗？",
            "nextDialogs": [
              "761272647"
            ]
          },
          "761272647": {
            "id": "761272647",
            "speakerId": 22255,
            "speakerName": "黑蛋",
            "text": "不…这些只是我读取到的日志信息…",
            "nextDialogs": [
              "761272648"
            ]
          },
          "761272648": {
            "id": "761272648",
            "speakerId": 22255,
            "speakerName": "黑蛋",
            "text": "真正的「望月者计划」被加密了…我无法打开…",
            "nextDialogs": [
              "761272649"
            ]
          },
          "761272649": {
            "id": "761272649",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "咦？你刚才不是说它在响应你吗？那不是应该能直接打开吗？",
            "nextDialogs": [
              "761272650"
            ]
          },
          "761272650": {
            "id": "761272650",
            "speakerId": 22255,
            "speakerName": "黑蛋",
            "text": "我的信息与它匹配…但也许因为…数量还不够…",
            "nextDialogs": [
              "761272651"
            ]
          },
          "761272651": {
            "id": "761272651",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "什么叫数量还不够？",
            "nextDialogs": [
              "761272652"
            ]
          },
          "761272652": {
            "id": "761272652",
            "speakerId": 22255,
            "speakerName": "黑蛋",
            "text": "就像是…零食与派蒙匹配…但是两成的零食不够派蒙吃。",
            "nextDialogs": [
              "761272653"
            ]
          },
          "761272653": {
            "id": "761272653",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "两成是你的，我有八成！",
            "nextDialogs": [
              "761272654"
            ]
          },
          "761272654": {
            "id": "761272654",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "听起来黑蛋像是一个钥匙模具。",
            "nextDialogs": [
              "761272655"
            ]
          },
          "761272655": {
            "id": "761272655",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "缺少了内容物，所以打造不出钥匙。",
            "nextDialogs": [
              "761272656"
            ]
          },
          "761272656": {
            "id": "761272656",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "欸？好像感觉就是这个意思！这么想的话，这个「望月者计划」会不会跟黑蛋的使命有关呢？",
            "nextDialogs": [
              "761272657"
            ]
          },
          "761272657": {
            "id": "761272657",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "它居然主动响应黑蛋的信息，感觉就像是等着她来呢。",
            "nextDialogs": [
              "761272658"
            ]
          },
          "761272658": {
            "id": "761272658",
            "speakerId": 22255,
            "speakerName": "黑蛋",
            "text": "我不知道…但我想…打开它…",
            "nextDialogs": [
              "761272659"
            ]
          },
          "761272659": {
            "id": "761272659",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "那我们来帮忙吧！",
            "nextDialogs": [
              "761272660"
            ]
          },
          "761272660": {
            "id": "761272660",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "既然是信息的数量不够，那我们去找更多终端就好了吧？",
            "nextDialogs": [
              "761272661"
            ]
          },
          "761272661": {
            "id": "761272661",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "刚才我就发现了，黑蛋每吸收一座终端，说话就更利索一些，个性也更膨胀一些。",
            "nextDialogs": [
              "761272662"
            ]
          },
          "761272662": {
            "id": "761272662",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "虽然我不喜欢这样的变化，但如果和她的使命有关，我也只能支持她了。",
            "nextDialogs": [
              "761272665"
            ]
          },
          "761272665": {
            "id": "761272665",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "哼哼，毕竟黑蛋也有帮我们找哥伦比娅嘛。",
            "nextDialogs": [
              "761272666"
            ]
          },
          "761272666": {
            "id": "761272666",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "你放心吧，黑蛋，既然这里有终端，前面一定也有！跟我们走，总会把你喂饱的。",
            "nextDialogs": [
              "761272667"
            ]
          },
          "761272667": {
            "id": "761272667",
            "speakerId": 22255,
            "speakerName": "黑蛋",
            "text": "谢谢…派蒙…那我会尽力…不变膨胀…",
            "nextDialogs": [
              "761272668"
            ]
          },
          "761272668": {
            "id": "761272668",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "嘿嘿，那我们现在该去下一站了吧？",
            "nextDialogs": [
              "761272669"
            ]
          },
          "761272669": {
            "id": "761272669",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "出发吧。",
            "nextDialogs": [
              "761272670"
            ]
          },
          "761272670": {
            "id": "761272670",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "好耶！月球大冒险第二站——「乌吉乌吉圈」！出发！",
            "nextDialogs": [
              "761272671"
            ]
          },
          "761272671": {
            "id": "761272671",
            "speakerId": 22255,
            "speakerName": "黑蛋",
            "text": "…是「乌吉恩圈」…",
            "nextDialogs": [
              "761272672"
            ]
          },
          "761272672": {
            "id": "761272672",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "「乌吉乌吉圈」！"
          }
        }
      }
    }
  ]
}
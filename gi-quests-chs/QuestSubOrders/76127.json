    {
      "subId": "7612702",
      "subQuestName": "与派蒙交谈",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "761270201"
        ],
        "dialogs": {
          "761270201": {
            "id": "761270201",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "#呜呜呜，{NICKNAME}！我就知道你一定会没事的。",
            "nextDialogs": [
              "761270202"
            ]
          },
          "761270202": {
            "id": "761270202",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "派蒙还好吗？",
            "nextDialogs": [
              "761270203"
            ]
          },
          "761270203": {
            "id": "761270203",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "刚才很不好，我从逃生舱里出来一看，你们都不见了，差点吓死我了。",
            "nextDialogs": [
              "761270204"
            ]
          },
          "761270204": {
            "id": "761270204",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "不过现在找到了你，一下就好多了，嘿嘿嘿嘿。",
            "nextDialogs": [
              "761270205"
            ]
          },
          "761270205": {
            "id": "761270205",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "快让我看看，你有没有哪里受伤？",
            "nextDialogs": [
              "761270206"
            ]
          },
          "761270206": {
            "id": "761270206",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "放心，我也没事。",
            "nextDialogs": [
              "761270207"
            ]
          },
          "761270207": {
            "id": "761270207",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "这样我就不担心了，没想到飞船居然出了问题…不对，其实这种事早就该想到的…",
            "nextDialogs": [
              "761270208"
            ]
          },
          "761270208": {
            "id": "761270208",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "毕竟它都被埋在地下不知道多少年了，能飞起来已经是奇迹了。",
            "nextDialogs": [
              "761270209"
            ]
          },
          "761270209": {
            "id": "761270209",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "而且虽然过程有些糟糕…但我们最后还是成功来到了月球上…",
            "nextDialogs": [
              "761270210"
            ]
          },
          "761270210": {
            "id": "761270210",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "真是强劲的龙族科技。",
            "nextDialogs": [
              "761270211"
            ]
          },
          "761270211": {
            "id": "761270211",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "都怪刚才黑蛋太引人注意，让我忘记好好检查一下飞船。",
            "nextDialogs": [
              "761270212"
            ]
          },
          "761270212": {
            "id": "761270212",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "啊对了！黑蛋呢？我记得她也钻进了逃生舱。",
            "nextDialogs": [
              "761270213"
            ]
          },
          "761270213": {
            "id": "761270213",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "我们得去找她。",
            "nextDialogs": [
              "761270214"
            ]
          },
          "761270214": {
            "id": "761270214",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "希望她不要有事！"
          }
        }
      }
    },
    {
      "subId": "7612704",
      "subQuestName": "寻找黑蛋",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "761270401"
        ],
        "dialogs": {
          "761270401": {
            "id": "761270401",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "这样就成功了吧！比预想中要顺利呢。",
            "nextDialogs": [
              "761270402"
            ]
          },
          "761270402": {
            "id": "761270402",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "现在是不是还需要去激活第三座能源发生站？",
            "nextDialogs": [
              "761270403"
            ]
          },
          "761270403": {
            "id": "761270403",
            "speakerId": 22255,
            "speakerName": "黑蛋",
            "text": "看…那个已经是激活状态了。",
            "nextDialogs": [
              "761270404"
            ]
          },
          "761270404": {
            "id": "761270404",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "真的欸…第三座能源发生站居然是好的吗？龙族科技果然强劲…",
            "nextDialogs": [
              "761270405"
            ]
          },
          "761270405": {
            "id": "761270405",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "也有可能是其他人激活的。",
            "nextDialogs": [
              "761270406"
            ]
          },
          "761270406": {
            "id": "761270406",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "其他人？你是说…哥伦比娅？这么一想也只能是她了…可她为什么只激活了一座呢？",
            "nextDialogs": [
              "761270407"
            ]
          },
          "761270407": {
            "id": "761270407",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "该不会…她发现了什么不对劲的地方吧？难道这里面有什么问题？",
            "nextDialogs": [
              "761270408"
            ]
          },
          "761270408": {
            "id": "761270408",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "喂…黑蛋，你不会又坑了我们吧？那我可要扣你的好感度了！",
            "nextDialogs": [
              "761270409"
            ]
          },
          "761270409": {
            "id": "761270409",
            "speakerId": 22255,
            "speakerName": "黑蛋",
            "text": "虽然不知道…我的使命是什么…",
            "nextDialogs": [
              "761270410"
            ]
          },
          "761270410": {
            "id": "761270410",
            "speakerId": 22255,
            "speakerName": "黑蛋",
            "text": "但是一定不包括…提升谁的好感度…",
            "nextDialogs": [
              "761270411"
            ]
          },
          "761270411": {
            "id": "761270411",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "哈呀？黑蛋，你变了！是终端的信息让你膨胀了吗？",
            "nextDialogs": [
              "761270412"
            ]
          },
          "761270412": {
            "id": "761270412",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "还是先去「伊比尼伯龙之眼」看看吧。",
            "nextDialogs": [
              "761270413"
            ]
          },
          "761270413": {
            "id": "761270413",
            "speakerId": 22255,
            "speakerName": "黑蛋",
            "text": "#嗯…{NICKNAME}…更加理性…稳重…擅于思考…是更好的合作伙伴…不像派蒙…",
            "nextDialogs": [
              "761270414"
            ]
          },
          "761270414": {
            "id": "761270414",
            "speakerId": 22255,
            "speakerName": "黑蛋",
            "text": "#我们出发吧…{NICKNAME}…我跟着你走…",
            "nextDialogs": [
              "761270415"
            ]
          },
          "761270415": {
            "id": "761270415",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "哈呀？！黑蛋！我要再扣你一成零食！"
          }
        }
      }
    },
    {
      "subId": "7612705",
      "subQuestName": "前往地下",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "761270501"
        ],
        "dialogs": {
          "761270501": {
            "id": "761270501",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "看！逃生舱！这是黑蛋的逃生舱吧？",
            "nextDialogs": [
              "761270502"
            ]
          },
          "761270502": {
            "id": "761270502",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "但她好像已经不在里面了…应该也是顺利逃出来了吧。",
            "nextDialogs": [
              "761270503"
            ]
          },
          "761270503": {
            "id": "761270503",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "会是逃进了这个像遗迹一样的地方吗…感觉我们得进去找一找了。"
          }
        }
      }
    },

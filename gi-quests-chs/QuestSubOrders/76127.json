    {
      "subId": "7612721",
      "subQuestName": "与黑蛋交谈",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "761272101"
        ],
        "dialogs": {
          "761272101": {
            "id": "761272101",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "这座终端，孤零零地露在外面，真可怜。",
            "nextDialogs": [
              "761272102"
            ]
          },
          "761272102": {
            "id": "761272102",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "它是能源发生站的终端吗？黑蛋，你来试试看吧？",
            "nextDialogs": [
              "761272103"
            ]
          },
          "761272103": {
            "id": "761272103",
            "speakerId": 22255,
            "speakerName": "黑蛋",
            "text": "嗯…",
            "nextDialogs": [
              "761272104"
            ]
          },
          "761272104": {
            "id": "761272104",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "怎么样？有没有什么新情报？",
            "nextDialogs": [
              "761272105"
            ]
          },
          "761272105": {
            "id": "761272105",
            "speakerId": 22255,
            "speakerName": "黑蛋",
            "text": "确认为能源发生站终端…但是…没有读取到新信息…",
            "nextDialogs": [
              "761272106"
            ]
          },
          "761272106": {
            "id": "761272106",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "唔…虽然没有新情报，但是能够顺利启动第二座能源发生站也很好了。",
            "nextDialogs": [
              "761272107"
            ]
          },
          "761272107": {
            "id": "761272107",
            "speakerId": 22255,
            "speakerName": "黑蛋",
            "text": "等一下…检测到讯号定位器故障…能源无法传输到「伊比尼伯龙之眼」。",
            "nextDialogs": [
              "761272108"
            ]
          },
          "761272108": {
            "id": "761272108",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "欸？那怎么办？",
            "nextDialogs": [
              "761272109"
            ]
          },
          "761272109": {
            "id": "761272109",
            "speakerId": 22255,
            "speakerName": "黑蛋",
            "text": "讯号定位器…在最顶部…需要手动调整…",
            "nextDialogs": [
              "761272110"
            ]
          },
          "761272110": {
            "id": "761272110",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "这样么…那我们先想办法上去看看吧。"
          }
        }
      }
    },

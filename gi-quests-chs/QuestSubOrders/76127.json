    {
      "subId": "7612734",
      "subQuestName": "激活终端",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "761270301"
        ],
        "dialogs": {
          "761270301": {
            "id": "761270301",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "黑蛋，你说的终端就是这个吧？",
            "nextDialogs": [
              "761270302"
            ]
          },
          "761270302": {
            "id": "761270302",
            "speakerId": 22255,
            "speakerName": "黑蛋",
            "text": "没错…",
            "nextDialogs": [
              "761270303"
            ]
          },
          "761270303": {
            "id": "761270303",
            "speakerId": 22255,
            "speakerName": "黑蛋",
            "text": "啊…",
            "nextDialogs": [
              "761270304"
            ]
          },
          "761270304": {
            "id": "761270304",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "你还好吗？",
            "nextDialogs": [
              "761270305"
            ]
          },
          "761270305": {
            "id": "761270305",
            "speakerId": 22255,
            "speakerName": "黑蛋",
            "text": "宁…宁…",
            "nextDialogs": [
              "761270306"
            ]
          },
          "761270306": {
            "id": "761270306",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "什么？",
            "nextDialogs": [
              "761270307"
            ]
          },
          "761270307": {
            "id": "761270307",
            "speakerId": 22255,
            "speakerName": "黑蛋",
            "text": "我的名字…",
            "nextDialogs": [
              "761270308"
            ]
          },
          "761270308": {
            "id": "761270308",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "这里面有你的名字？你叫宁宁？",
            "nextDialogs": [
              "761270309"
            ]
          },
          "761270309": {
            "id": "761270309",
            "speakerId": 22255,
            "speakerName": "黑蛋",
            "text": "月亮的力量…能够记录…信息…",
            "nextDialogs": [
              "761270310"
            ]
          },
          "761270310": {
            "id": "761270310",
            "speakerId": 22255,
            "speakerName": "黑蛋",
            "text": "它们…就储存在终端里…",
            "nextDialogs": [
              "761270311"
            ]
          },
          "761270311": {
            "id": "761270311",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "原来黑蛋能够读取终端的信息吗？那你知道这里是什么地方了吗？",
            "nextDialogs": [
              "761270312"
            ]
          },
          "761270312": {
            "id": "761270312",
            "speakerId": 22255,
            "speakerName": "黑蛋",
            "text": "是一个能源发生站…用来制造…存储能源…",
            "nextDialogs": [
              "761270313"
            ]
          },
          "761270313": {
            "id": "761270313",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "这么说，刚才那些光球，应该就是某种能源了吧。",
            "nextDialogs": [
              "761270314"
            ]
          },
          "761270314": {
            "id": "761270314",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "黑蛋一定是因为身上有同样的力量，才被当成能源抓走了。",
            "nextDialogs": [
              "761270315"
            ]
          },
          "761270315": {
            "id": "761270315",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "能源发生站是用来做什么的？",
            "nextDialogs": [
              "761270316"
            ]
          },
          "761270316": {
            "id": "761270316",
            "speakerId": 22255,
            "speakerName": "黑蛋",
            "text": "为…「伊比尼伯龙之眼」…供能…",
            "nextDialogs": [
              "761270317"
            ]
          },
          "761270317": {
            "id": "761270317",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "伊比尼伯龙…之眼？那又是什么？听起来有些耳熟。",
            "nextDialogs": [
              "761270318"
            ]
          },
          "761270318": {
            "id": "761270318",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "是飞船降落地点之一。",
            "nextDialogs": [
              "761270319"
            ]
          },
          "761270319": {
            "id": "761270319",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "伊比尼伯龙…之眼？那又是什么？",
            "nextDialogs": [
              "761270320"
            ]
          },
          "761270320": {
            "id": "761270320",
            "speakerId": 22255,
            "speakerName": "黑蛋",
            "text": "这里有工程蓝图…给你们看…",
            "nextDialogs": [
              "761270321"
            ]
          },
          "761270321": {
            "id": "761270321",
            "speakerId": 22255,
            "speakerName": "黑蛋",
            "text": "中间的高塔…就是「伊比尼伯龙之眼」…",
            "nextDialogs": [
              "761270322"
            ]
          },
          "761270322": {
            "id": "761270322",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "好厉害！旁边那三个矮一些的呢？是能源发生站吗？",
            "nextDialogs": [
              "761270323"
            ]
          },
          "761270323": {
            "id": "761270323",
            "speakerId": 22255,
            "speakerName": "黑蛋",
            "text": "嗯…我们就在其中一个里面…",
            "nextDialogs": [
              "761270324"
            ]
          },
          "761270324": {
            "id": "761270324",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "「伊比尼伯龙之眼」具体是干什么的？",
            "nextDialogs": [
              "761270325"
            ]
          },
          "761270325": {
            "id": "761270325",
            "speakerId": 22255,
            "speakerName": "黑蛋",
            "text": "工作日志里记录…它是一座月球表面监测站…能够监测月球全表面。",
            "nextDialogs": [
              "761270326"
            ]
          },
          "761270326": {
            "id": "761270326",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "监测月球表面？这么厉害！",
            "nextDialogs": [
              "761270327"
            ]
          },
          "761270327": {
            "id": "761270327",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "这样说，它岂不是能帮我们搜索哥伦比娅的位置？",
            "nextDialogs": [
              "761270328"
            ]
          },
          "761270328": {
            "id": "761270328",
            "speakerId": 22255,
            "speakerName": "黑蛋",
            "text": "我不知道…但是…存在这种可能性…",
            "nextDialogs": [
              "761270329"
            ]
          },
          "761270329": {
            "id": "761270329",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "看来我们得去那里看看。",
            "nextDialogs": [
              "761270330"
            ]
          },
          "761270330": {
            "id": "761270330",
            "speakerId": 22255,
            "speakerName": "黑蛋",
            "text": "我们已经启动了…第一座…",
            "nextDialogs": [
              "761270331"
            ]
          },
          "761270331": {
            "id": "761270331",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "意思是还要解决另外两座能源发生站对吧？没问题，这种事情我们做过很多了。",
            "nextDialogs": [
              "761270332"
            ]
          },
          "761270332": {
            "id": "761270332",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "黑蛋，现在就跟我们来吧。",
            "nextDialogs": [
              "761270333"
            ]
          },
          "761270333": {
            "id": "761270333",
            "speakerId": 22255,
            "speakerName": "黑蛋",
            "text": "不是黑蛋…是宁宁…",
            "nextDialogs": [
              "761270334"
            ]
          },
          "761270334": {
            "id": "761270334",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "是宁宁，也是黑蛋。",
            "nextDialogs": [
              "761270335"
            ]
          },
          "761270335": {
            "id": "761270335",
            "speakerId": 22255,
            "speakerName": "黑蛋",
            "text": "是宁宁…",
            "nextDialogs": [
              "761270336"
            ]
          },
          "761270336": {
            "id": "761270336",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "好好，宁宁·黑蛋，这样行了吧？",
            "nextDialogs": [
              "761270337"
            ]
          },
          "761270337": {
            "id": "761270337",
            "speakerId": 22255,
            "speakerName": "黑蛋",
            "text": "就只是宁宁…",
            "nextDialogs": [
              "761270338"
            ]
          },
          "761270338": {
            "id": "761270338",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "喂！你这只得寸进尺的黑蛋！",
            "nextDialogs": [
              "761270339"
            ]
          },
          "761270339": {
            "id": "761270339",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "不要忘了是谁害我们流落到这个找不到餐厅的荒原…你还想不想要零食了？",
            "nextDialogs": [
              "761270340"
            ]
          },
          "761270340": {
            "id": "761270340",
            "speakerId": 22255,
            "speakerName": "黑蛋",
            "text": "……",
            "nextDialogs": [
              "761270341"
            ]
          },
          "761270341": {
            "id": "761270341",
            "speakerId": 22255,
            "speakerName": "黑蛋",
            "text": "好吧…宁宁·黑蛋。",
            "nextDialogs": [
              "761270342"
            ]
          },
          "761270342": {
            "id": "761270342",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "什么零食？",
            "nextDialogs": [
              "761270343"
            ]
          },
          "761270343": {
            "id": "761270343",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "哎呀，这是我们的小秘密啦。",
            "nextDialogs": [
              "761270344"
            ]
          },
          "761270344": {
            "id": "761270344",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "快，我们该出发去其它能源发生站了！"
          }
        }
      }

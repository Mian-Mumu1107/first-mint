  "subQuests": [
    {
      "subId": "7612729",
      "subQuestName": "航行中…",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "761270101"
        ],
        "dialogs": {
          "761270101": {
            "id": "761270101",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "（怎么…回事…？）",
            "nextDialogs": [
              "761270102"
            ]
          },
          "761270102": {
            "id": "761270102",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "（对了，是飞船发生了事故…我们进入了逃生舱…已经成功降落了吗？）",
            "nextDialogs": [
              "761270103"
            ]
          },
          "761270103": {
            "id": "761270103",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "（我似乎还在逃生舱里…得赶紧去确认派蒙的情况…）",
            "nextDialogs": [
              "761270104"
            ]
          },
          "761270104": {
            "id": "761270104",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "（离开逃生舱。）"
          }
        }
      }
    },

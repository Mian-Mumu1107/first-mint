  "subQuests": [
    {
      "subId": "1301501",
      "subQuestName": "向「品梦一刻」的人告知现状",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "130150101"
        ],
        "dialogs": {
          "130150101": {
            "id": "130150101",
            "speakerId": 1000,
            "speakerName": "皮特",
            "text": "太好了，你们也醒过来了。",
            "nextDialogs": [
              "130150102"
            ]
          },
          "130150102": {
            "id": "130150102",
            "speakerId": 1000,
            "speakerName": "皮特",
            "text": "大家都陆续醒来，城里也好消息不断。",
            "nextDialogs": [
              "130150103"
            ]
          },
          "130150103": {
            "id": "130150103",
            "speakerId": 1000,
            "speakerName": "皮特",
            "text": "看来事情已经顺利解决了对吧？",
            "nextDialogs": [
              "130150104"
            ]
          },
          "130150104": {
            "id": "130150104",
            "speakerId": 1001,
            "speakerName": "纳西妲",
            "text": "嗯，虽然费了一些周折。",
            "nextDialogs": [
              "130150105"
            ]
          },
          "130150105": {
            "id": "130150105",
            "speakerId": 1001,
            "speakerName": "纳西妲",
            "text": "应该等会儿会有很多人聚过来，麻烦你组织一下现场的秩序。",
            "nextDialogs": [
              "130150106"
            ]
          },
          "130150106": {
            "id": "130150106",
            "speakerId": 1001,
            "speakerName": "纳西妲",
            "text": "#我和{M#他}{F#她}们去一趟教令院，马上就回来。"
          }
        }
      }
    },
    {
      "subId": "1301502",
      "subQuestName": "将装有意识的容器交给教令院",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "130150201"
        ],
        "dialogs": {
          "130150201": {
            "id": "130150201",
            "speakerId": 1002,
            "speakerName": "希忒",
            "text": "是草神大人，请问有什么事呢？",
            "nextDialogs": [
              "130150202"
            ]
          },
          "130150202": {
            "id": "130150202",
            "speakerId": 1001,
            "speakerName": "纳西妲",
            "text": "我想查询一下学籍资料，是否有一位刹诃伐罗学院的学者，现在处于昏迷不醒的状态。",
            "nextDialogs": [
              "130150203"
            ]
          },
          "130150203": {
            "id": "130150203",
            "speakerId": 1002,
            "speakerName": "希忒",
            "text": "好的，请稍等。",
            "nextDialogs": [
              "130150204"
            ]
          },
          "130150204": {
            "id": "130150204",
            "speakerId": 1003,
            "speakerName": "Black Screen",
            "text": "过了一段时间。",
            "nextDialogs": [
              "130150205"
            ]
          },
          "130150205": {
            "id": "130150205",
            "speakerId": 1002,
            "speakerName": "希忒",
            "text": "久等了，草神大人，的确是有这样一位学者，名叫贝诺尼，因为违规操作虚空而陷入昏迷。",
            "nextDialogs": [
              "130150206"
            ]
          },
          "130150206": {
            "id": "130150206",
            "speakerId": 1002,
            "speakerName": "希忒",
            "text": "直到现在他还没有恢复意识，仍在接受「健康之家」的治疗。",
            "nextDialogs": [
              "130150207"
            ]
          },
          "130150207": {
            "id": "130150207",
            "speakerId": 1004,
            "speakerName": "派蒙",
            "text": "欸？他不是叫莫塞伊思吗？",
            "nextDialogs": [
              "130150208"
            ]
          },
          "130150208": {
            "id": "130150208",
            "speakerId": 1001,
            "speakerName": "纳西妲",
            "text": "估计是不想被认出来吧，他不愿意被任何人打扰。",
            "nextDialogs": [
              "130150209"
            ]
          },
          "130150209": {
            "id": "130150209",
            "speakerId": 1001,
            "speakerName": "纳西妲",
            "text": "这里面储存的知识，麻烦转交给风纪官，请他们导入到贝诺尼的大脑中。",
            "nextDialogs": [
              "130150210"
            ]
          },
          "130150210": {
            "id": "130150210",
            "speakerId": 1002,
            "speakerName": "希忒",
            "text": "好的，不过出于安全性考虑，我还需要了解一下理由。",
            "nextDialogs": [
              "130150211"
            ]
          },
          "130150211": {
            "id": "130150211",
            "speakerId": 1001,
            "speakerName": "纳西妲",
            "text": "很简单，这里面是他的意识，之前被困在某个梦境里了。",
            "nextDialogs": [
              "130150212"
            ]
          },
          "130150212": {
            "id": "130150212",
            "speakerId": 1001,
            "speakerName": "纳西妲",
            "text": "他在梦境中做了一些影响须弥治安的事，在他醒来之后，我会和大风纪官概述情况。",
            "nextDialogs": [
              "130150213"
            ]
          },
          "130150213": {
            "id": "130150213",
            "speakerId": 1002,
            "speakerName": "希忒",
            "text": "明白了，我这就去做，感谢草神大人。",
            "nextDialogs": [
              "130150214"
            ]
          },
          "130150214": {
            "id": "130150214",
            "speakerId": 1001,
            "speakerName": "纳西妲",
            "text": "嗯，没关系。",
            "nextDialogs": [
              "130150215"
            ]
          },
          "130150215": {
            "id": "130150215",
            "speakerId": 1001,
            "speakerName": "纳西妲",
            "text": "估计「品梦一刻」那边的人也聚集起来了，我们回去吧。"
          }
        }
      }
    },
    {
      "subId": "1301503",
      "subQuestName": "返回「品梦一刻」",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "130150301"
        ],
        "dialogs": {
          "130150301": {
            "id": "130150301",
            "speakerId": 1004,
            "speakerName": "派蒙",
            "text": "我们就安静当听众就好了吧。",
            "nextDialogs": [
              "130150302"
            ]
          },
          "130150302": {
            "id": "130150302",
            "speakerId": 1004,
            "speakerName": "派蒙",
            "text": "不知道她打算说什么呢。",
            "nextDialogs": [
              "130150303"
            ]
          },
          "130150303": {
            "id": "130150303",
            "speakerId": 1001,
            "speakerName": "纳西妲",
            "text": "各位刚刚苏醒的人们，你们好。",
            "nextDialogs": [
              "130150304"
            ]
          },
          "130150304": {
            "id": "130150304",
            "speakerId": 1001,
            "speakerName": "纳西妲",
            "text": "打扰到你们的美梦，我非常抱歉，在梦境中的处理或许有些冰冷，我也表达我的歉意。",
            "nextDialogs": [
              "130150305"
            ]
          },
          "130150305": {
            "id": "130150305",
            "speakerId": 1001,
            "speakerName": "纳西妲",
            "text": "梦境拥有非常奇妙的力量，对心志坚定之人，它能鼓舞人心，为理想插上翅膀。",
            "nextDialogs": [
              "130150306"
            ]
          },
          "130150306": {
            "id": "130150306",
            "speakerId": 1001,
            "speakerName": "纳西妲",
            "text": "但它也有可能乘虚而入，混淆认知，颠倒是非——很不幸，你们被选作了猎物。",
            "nextDialogs": [
              "130150307"
            ]
          },
          "130150307": {
            "id": "130150307",
            "speakerId": 1001,
            "speakerName": "纳西妲",
            "text": "就像我之前所说，我还在不断学习，不敢说能感同身受那些离别之苦。",
            "nextDialogs": [
              "130150308"
            ]
          },
          "130150308": {
            "id": "130150308",
            "speakerId": 1001,
            "speakerName": "纳西妲",
            "text": "但看看四周就知道，有过类似遭遇的人并不少见。",
            "nextDialogs": [
              "130150309"
            ]
          },
          "130150309": {
            "id": "130150309",
            "speakerId": 1001,
            "speakerName": "纳西妲",
            "text": "你们能相聚并站在这里，一同望向远方，你们应该为此自豪。",
            "nextDialogs": [
              "130150310"
            ]
          },
          "130150310": {
            "id": "130150310",
            "speakerId": 1001,
            "speakerName": "纳西妲",
            "text": "生命的道路非常漫长，我们都很难看到终点。由此我们可能会产生很多问题——",
            "nextDialogs": [
              "130150311"
            ]
          },
          "130150311": {
            "id": "130150311",
            "speakerId": 1001,
            "speakerName": "纳西妲",
            "text": "「我活着的意义是什么？我的目标是什么？我为什么要不断经历痛苦？」",
            "nextDialogs": [
              "130150312"
            ]
          },
          "130150312": {
            "id": "130150312",
            "speakerId": 1001,
            "speakerName": "纳西妲",
            "text": "诚然，停下脚步，放弃思考，重复熟悉的做法，这是最轻松的选择。",
            "nextDialogs": [
              "130150313"
            ]
          },
          "130150313": {
            "id": "130150313",
            "speakerId": 1001,
            "speakerName": "纳西妲",
            "text": "每当产生这样的念头的时候，就看看身边存在的人和事吧。",
            "nextDialogs": [
              "130150314"
            ]
          },
          "130150314": {
            "id": "130150314",
            "speakerId": 1001,
            "speakerName": "纳西妲",
            "text": "有人终日辛勤劳作，为的是一家人能在夜晚吃上热腾腾的饭菜。",
            "nextDialogs": [
              "130150315"
            ]
          },
          "130150315": {
            "id": "130150315",
            "speakerId": 1001,
            "speakerName": "纳西妲",
            "text": "有人走遍大江南北，为的是创作出让整个提瓦特都能产生共鸣的艺术品。",
            "nextDialogs": [
              "130150316"
            ]
          },
          "130150316": {
            "id": "130150316",
            "speakerId": 1001,
            "speakerName": "纳西妲",
            "text": "有人探寻世界的秘密，为的是预防逐渐逼近而又不可名状的灾难。",
            "nextDialogs": [
              "130150317"
            ]
          },
          "130150317": {
            "id": "130150317",
            "speakerId": 1001,
            "speakerName": "纳西妲",
            "text": "——自我并非生命意义的全部，每一次行动都是对自我与世界的塑造。",
            "nextDialogs": [
              "130150318"
            ]
          },
          "130150318": {
            "id": "130150318",
            "speakerId": 1001,
            "speakerName": "纳西妲",
            "text": "亲朋好友会铭记你们的所作所为，陌生人也可能因为你们的行动而受惠。",
            "nextDialogs": [
              "130150319"
            ]
          },
          "130150319": {
            "id": "130150319",
            "speakerId": 1001,
            "speakerName": "纳西妲",
            "text": "为此，有许多人哪怕承受痛苦，也要开拓全新道路。",
            "nextDialogs": [
              "130150320"
            ]
          },
          "130150320": {
            "id": "130150320",
            "speakerId": 1001,
            "speakerName": "纳西妲",
            "text": "而当你们走上同样的道路，那些终极问题的答案就会慢慢浮现，也变得不再重要。",
            "nextDialogs": [
              "130150321"
            ]
          },
          "130150321": {
            "id": "130150321",
            "speakerId": 1001,
            "speakerName": "纳西妲",
            "text": "但如果你们觉得生命就是虚无，那它就会逐渐走向虚无。",
            "nextDialogs": [
              "130150322"
            ]
          },
          "130150322": {
            "id": "130150322",
            "speakerId": 1001,
            "speakerName": "纳西妲",
            "text": "你们有选择生存方式的自由，但作为神，我需要先叫醒你们。",
            "nextDialogs": [
              "130150323"
            ]
          },
          "130150323": {
            "id": "130150323",
            "speakerId": 1001,
            "speakerName": "纳西妲",
            "text": "还要不要以放弃现实为代价拥抱美梦，取决于你们自己。"
          }
        }
      }
    },
    {
      "subId": "1301504",
      "subQuestName": "与纳西妲在广场见面",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "130150401"
        ],
        "dialogs": {
          "130150401": {
            "id": "130150401",
            "speakerId": 1004,
            "speakerName": "派蒙",
            "text": "你好厉害，在梦境里，我都觉得有点说不过那个学者了。",
            "nextDialogs": [
              "130150402"
            ]
          },
          "130150402": {
            "id": "130150402",
            "speakerId": 1001,
            "speakerName": "纳西妲",
            "text": "他利用人性弱点的方式确实很巧妙，或许他自己也早就深陷其中了。",
            "nextDialogs": [
              "130150403"
            ]
          },
          "130150403": {
            "id": "130150403",
            "speakerId": 1001,
            "speakerName": "纳西妲",
            "text": "那个梦境有难以言喻的诱惑力，甜蜜得让人上瘾，而普通人很难有清晰的判断。",
            "nextDialogs": [
              "130150404"
            ]
          },
          "130150404": {
            "id": "130150404",
            "speakerId": 1001,
            "speakerName": "纳西妲",
            "text": "但只要能醒过来，什么时候都不算晚。",
            "nextDialogs": [
              "130150405"
            ]
          },
          "130150405": {
            "id": "130150405",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "你也长进了很多啊。",
            "nextDialogs": [
              "130150406"
            ]
          },
          "130150406": {
            "id": "130150406",
            "speakerId": 1001,
            "speakerName": "纳西妲",
            "text": "欸？怎么突然这么说？",
            "nextDialogs": [
              "130150407"
            ]
          },
          "130150407": {
            "id": "130150407",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "你其实挺能共情的。",
            "nextDialogs": [
              "130150408"
            ]
          },
          "130150408": {
            "id": "130150408",
            "speakerId": 1004,
            "speakerName": "派蒙",
            "text": "就是，虽然你说你不太懂人类的感情，但你的犹豫我们都看在眼里。",
            "nextDialogs": [
              "130150409"
            ]
          },
          "130150409": {
            "id": "130150409",
            "speakerId": 1004,
            "speakerName": "派蒙",
            "text": "刚刚那段演讲，也是站在他们的立场上说的，这不是做得很好嘛！",
            "nextDialogs": [
              "130150410"
            ]
          },
          "130150410": {
            "id": "130150410",
            "speakerId": 1001,
            "speakerName": "纳西妲",
            "text": "谢谢你们，这一路上我听到了很多悲伤的故事，内心不止一次受到触动。",
            "nextDialogs": [
              "130150411"
            ]
          },
          "130150411": {
            "id": "130150411",
            "speakerId": 1001,
            "speakerName": "纳西妲",
            "text": "受害者们的行为并不算错，他们想要的东西也不过分…",
            "nextDialogs": [
              "130150412"
            ]
          },
          "130150412": {
            "id": "130150412",
            "speakerId": 1001,
            "speakerName": "纳西妲",
            "text": "所以在他们试图对抗我们，保护梦境的时候，我可以理解他们的选择。",
            "nextDialogs": [
              "130150413"
            ]
          },
          "130150413": {
            "id": "130150413",
            "speakerId": 1001,
            "speakerName": "纳西妲",
            "text": "但我的理解与触动，和他们真实经历的痛苦相比，可能连百分之一都不到。",
            "nextDialogs": [
              "130150414"
            ]
          },
          "130150414": {
            "id": "130150414",
            "speakerId": 1001,
            "speakerName": "纳西妲",
            "text": "这「百分之一」，我不敢认为它是所谓的共情。",
            "nextDialogs": [
              "130150415"
            ]
          },
          "130150415": {
            "id": "130150415",
            "speakerId": 1004,
            "speakerName": "派蒙",
            "text": "你要求真高，当然是啦。",
            "nextDialogs": [
              "130150418"
            ]
          },
          "130150418": {
            "id": "130150418",
            "speakerId": 1001,
            "speakerName": "纳西妲",
            "text": "嘿嘿，好的，果然出来转转才会成长呢。",
            "nextDialogs": [
              "130150419"
            ]
          },
          "130150419": {
            "id": "130150419",
            "speakerId": 1001,
            "speakerName": "纳西妲",
            "text": "感情和知识完全不同，我很难用清晰的言语描述它。",
            "nextDialogs": [
              "130150420"
            ]
          },
          "130150420": {
            "id": "130150420",
            "speakerId": 1001,
            "speakerName": "纳西妲",
            "text": "贝诺尼…或者「莫塞伊思」说我没有经历过生离死别，可我有种特别模糊的感觉，告诉我并不是这样。",
            "nextDialogs": [
              "130150421"
            ]
          },
          "130150421": {
            "id": "130150421",
            "speakerId": 1001,
            "speakerName": "纳西妲",
            "text": "我刚进入梦境，就感觉我被一股特别温暖的热流包裹。",
            "nextDialogs": [
              "130150422"
            ]
          },
          "130150422": {
            "id": "130150422",
            "speakerId": 1001,
            "speakerName": "纳西妲",
            "text": "温暖到感觉自己回到了生命的原初状态，再也不愿意醒来。",
            "nextDialogs": [
              "130150423"
            ]
          },
          "130150423": {
            "id": "130150423",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "（难道说她也看到了什么？）",
            "nextDialogs": [
              "130150424"
            ]
          },
          "130150424": {
            "id": "130150424",
            "speakerId": 1001,
            "speakerName": "纳西妲",
            "text": "可是我睁开眼睛之后，那种感觉就消失了，一点痕迹都没留下。",
            "nextDialogs": [
              "130150425"
            ]
          },
          "130150425": {
            "id": "130150425",
            "speakerId": 1001,
            "speakerName": "纳西妲",
            "text": "打比方的话，就像是一张白纸擦除了上面的笔迹，我看不见文字，但是能看到浅浅的凹痕。",
            "nextDialogs": [
              "130150426"
            ]
          },
          "130150426": {
            "id": "130150426",
            "speakerId": 1001,
            "speakerName": "纳西妲",
            "text": "但经历了这场梦境之后，我想得很清楚了，无论那股暖流意味着什么，都不重要。",
            "nextDialogs": [
              "130150427"
            ]
          },
          "130150427": {
            "id": "130150427",
            "speakerId": 1001,
            "speakerName": "纳西妲",
            "text": "我能确定的是，我曾经被那股很温暖的力量支撑，才能一路走到今天。",
            "nextDialogs": [
              "130150428"
            ]
          },
          "130150428": {
            "id": "130150428",
            "speakerId": 1001,
            "speakerName": "纳西妲",
            "text": "要是过分在意温暖来自于哪里，那就本末倒置了。",
            "nextDialogs": [
              "130150429"
            ]
          },
          "130150429": {
            "id": "130150429",
            "speakerId": 1001,
            "speakerName": "纳西妲",
            "text": "刚刚和人民讲了那么多理想的话，到头来自己却做不到，那是不是太丢人了，嘿嘿。",
            "nextDialogs": [
              "130150430"
            ]
          },
          "130150430": {
            "id": "130150430",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "（大慈树王已经用她的行动塑造了纳西妲。）",
            "nextDialogs": [
              "130150431"
            ]
          },
          "130150431": {
            "id": "130150431",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "（哪怕世界遗忘了她，纳西妲的思想与意志也是她「存在过」的证明。）",
            "nextDialogs": [
              "130150432"
            ]
          },
          "130150432": {
            "id": "130150432",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "（比起诉说真相，我更应该尊重她们的想法。）",
            "nextDialogs": [
              "130150433"
            ]
          },
          "130150433": {
            "id": "130150433",
            "speakerId": 1004,
            "speakerName": "派蒙",
            "text": "怎么了？突然一脸沉重的样子。",
            "nextDialogs": [
              "130150434"
            ]
          },
          "130150434": {
            "id": "130150434",
            "speakerId": 1001,
            "speakerName": "纳西妲",
            "text": "看你好几次欲言又止了，是有什么话想告诉我吗？"
          }
        }
      }
    },
    {
      "subId": "1301505",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "130150501"
        ],
        "dialogs": {
          "130150501": {
            "id": "130150501",
            "speakerId": 1005,
            "speakerName": "埃勒曼",
            "text": "谢谢你们救了我，实在对不起，幸好海达没有因为我犯糊涂而受伤…",
            "nextDialogs": [
              "130150502"
            ]
          },
          "130150502": {
            "id": "130150502",
            "speakerId": 1006,
            "speakerName": "海达",
            "text": "爸爸说，你们很厉害，是救命恩人，谢谢你们！"
          }
        }
      }
    },
    {
      "subId": "1301506",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "130150601"
        ],
        "dialogs": {
          "130150601": {
            "id": "130150601",
            "speakerId": 1007,
            "speakerName": "凯西娅",
            "text": "我准备去冒险了，和这盆植物一起。",
            "nextDialogs": [
              "130150602"
            ]
          },
          "130150602": {
            "id": "130150602",
            "speakerId": 1007,
            "speakerName": "凯西娅",
            "text": "我不该只是等待的，既然是艾莎老师无论如何都要去探寻的秘密，我也要去看一看。",
            "nextDialogs": [
              "130150603"
            ]
          },
          "130150603": {
            "id": "130150603",
            "speakerId": 1007,
            "speakerName": "凯西娅",
            "text": "谢谢你们，未来我们有缘再见。"
          }
        }
      }
    },
    {
      "subId": "1301507",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "130150701"
        ],
        "dialogs": {
          "130150701": {
            "id": "130150701",
            "speakerId": 1008,
            "speakerName": "黛比",
            "text": "我发现我和纳赛尔挺聊得来的，都是很直爽的性格。",
            "nextDialogs": [
              "130150702"
            ]
          },
          "130150702": {
            "id": "130150702",
            "speakerId": 1009,
            "speakerName": "纳赛尔",
            "text": "而且我们都和草神大人唱了反调呢，一个在现实，一个在梦里，哈哈哈。"
          }
        }
      }
    },
    {
      "subId": "1301508",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "130150801"
        ],
        "dialogs": {
          "130150801": {
            "id": "130150801",
            "speakerId": 1010,
            "speakerName": "奇恩",
            "text": "睡太久了，我还有点晕…先别管我了…"
          }
        }
      }
    },
    {
      "subId": "1301509",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "130150901"
        ],
        "dialogs": {
          "130150901": {
            "id": "130150901",
            "speakerId": 1011,
            "speakerName": "伊娜丝",
            "text": "你说，既然在梦里都是邻居，要不要干脆一起合租吧。",
            "nextDialogs": [
              "130150902"
            ]
          },
          "130150902": {
            "id": "130150902",
            "speakerId": 1012,
            "speakerName": "塞娜",
            "text": "好啊好啊，我估计也付不起一栋房子的租金了…不过总会好起来的吧。"
          }
        }
      }
    },
    {
      "subId": "1301510",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "130151001"
        ],
        "dialogs": {
          "130151001": {
            "id": "130151001",
            "speakerId": 1008,
            "speakerName": "黛比",
            "text": "我感觉到梦的深处出现了剧烈的震动，然后我就醒了。",
            "nextDialogs": [
              "130151002"
            ]
          },
          "130151002": {
            "id": "130151002",
            "speakerId": 1008,
            "speakerName": "黛比",
            "text": "梦，总是会有醒来的时候…"
          }
        }
      }
    },
    {
      "subId": "1301512",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "130151201"
        ],
        "dialogs": {
          "130151201": {
            "id": "130151201",
            "speakerId": 1009,
            "speakerName": "纳赛尔",
            "text": "全都一下子醒过来，看起来挺壮观的啊。"
          }
        }
      }
    },
    {
      "subId": "1301514",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "130151401"
        ],
        "dialogs": {
          "130151401": {
            "id": "130151401",
            "speakerId": 1002,
            "speakerName": "希忒",
            "text": "我会尽快去办，请放心。"
          }
        }
      }
    },
    {
      "subId": "1301516",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "130151601"
        ],
        "dialogs": {
          "130151601": {
            "id": "130151601",
            "speakerId": 1000,
            "speakerName": "皮特",
            "text": "幸好当时叫住了你们，不然只凭我们，肯定应对不了这种状况。",
            "nextDialogs": [
              "130151602"
            ]
          },
          "130151602": {
            "id": "130151602",
            "speakerId": 1004,
            "speakerName": "派蒙",
            "text": "你也做得很好啦。"
          }
        }
      }
    },
    {
      "subId": "1301599",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "130159901"
        ],
        "dialogs": {
          "130159901": {
            "id": "130159901",
            "speakerId": 1004,
            "speakerName": "派蒙",
            "text": "我们这是要去问问那个学者的状况吧？",
            "nextDialogs": [
              "130159902"
            ]
          },
          "130159902": {
            "id": "130159902",
            "speakerId": 1001,
            "speakerName": "纳西妲",
            "text": "嗯，不过意识回归身体之后，可能还需要一段时间才能醒过来。",
            "nextDialogs": [
              "130159903"
            ]
          },
          "130159903": {
            "id": "130159903",
            "speakerId": 1001,
            "speakerName": "纳西妲",
            "text": "接下来的事情就交给风纪官了。",
            "nextDialogs": [
              "130159904"
            ]
          },
          "130159904": {
            "id": "130159904",
            "speakerId": 1008,
            "speakerName": "黛比",
            "text": "（应该是旅行者和草神大人在深处做了什么吧。）",
            "nextDialogs": [
              "130159905"
            ]
          },
          "130159905": {
            "id": "130159905",
            "speakerId": 1009,
            "speakerName": "纳赛尔",
            "text": "（不愧是草神大人，不得不服气啊。）",
            "nextDialogs": [
              "130159906"
            ]
          },
          "130159906": {
            "id": "130159906",
            "speakerId": 1002,
            "speakerName": "希忒",
            "text": "（越是在大人物面前，越是要把工作做好，可不能渎职。）",
            "nextDialogs": [
              "130159907"
            ]
          },
          "130159907": {
            "id": "130159907",
            "speakerId": 1000,
            "speakerName": "皮特",
            "text": "（终于结束了…很完美，就是太累了，唉…）",
            "nextDialogs": [
              "130159908"
            ]
          },
          "130159908": {
            "id": "130159908",
            "speakerId": 1005,
            "speakerName": "埃勒曼",
            "text": "（我的运气真是太好了…）",
            "nextDialogs": [
              "130159909"
            ]
          },
          "130159909": {
            "id": "130159909",
            "speakerId": 1006,
            "speakerName": "海达",
            "text": "（爸爸最好了！）",
            "nextDialogs": [
              "130159910"
            ]
          },
          "130159910": {
            "id": "130159910",
            "speakerId": 1007,
            "speakerName": "凯西娅",
            "text": "（原来这才是艾莎老师对我的期待，我醒悟得太晚了。）",
            "nextDialogs": [
              "130159911"
            ]
          },
          "130159911": {
            "id": "130159911",
            "speakerId": 1008,
            "speakerName": "黛比",
            "text": "（是不是值得庆祝一下，去吃点好的？）",
            "nextDialogs": [
              "130159912"
            ]
          },
          "130159912": {
            "id": "130159912",
            "speakerId": 1009,
            "speakerName": "纳赛尔",
            "text": "（等会儿约她去喝杯酒吧。）",
            "nextDialogs": [
              "130159913"
            ]
          },
          "130159913": {
            "id": "130159913",
            "speakerId": 1010,
            "speakerName": "奇恩",
            "text": "（晕乎乎的，还有点想吐。）",
            "nextDialogs": [
              "130159914"
            ]
          },
          "130159914": {
            "id": "130159914",
            "speakerId": 1011,
            "speakerName": "伊娜丝",
            "text": "（新生活估计还需要适应一段时间，不过也无所谓了。）",
            "nextDialogs": [
              "130159915"
            ]
          },
          "130159915": {
            "id": "130159915",
            "speakerId": 1012,
            "speakerName": "塞娜",
            "text": "（太好了，接下来的日子有着落了。）",
            "nextDialogs": [
              "130159916"
            ]
          },
          "130159916": {
            "id": "130159916",
            "speakerId": 1004,
            "speakerName": "派蒙",
            "text": "纳西妲说还有些话想单独说一说。",
            "nextDialogs": [
              "130159917"
            ]
          },
          "130159917": {
            "id": "130159917",
            "speakerId": 1004,
            "speakerName": "派蒙",
            "text": "她好像去教令院前面的广场了。"
          }
        }
      }
    }
  ]
}
  "subQuests": [
    {
      "subId": "1280101",
      "subQuestName": "(test)废弃$HIDDEN",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "698310101"
        ],
        "dialogs": {
          "698310101": {
            "id": "698310101",
            "speakerId": 1055,
            "speakerName": "多莉",
            "text": "原来如此，原来如此，没有那种能把人伪装成灵药罐子的「忍术」啊…",
            "nextDialogs": [
              "698310102"
            ]
          },
          "698310102": {
            "id": "698310102",
            "speakerId": 1055,
            "speakerName": "多莉",
            "text": "不过！一人高的灵药罐，听起来也很有视觉冲击啊！",
            "nextDialogs": [
              "698310103"
            ]
          },
          "698310103": {
            "id": "698310103",
            "speakerId": 1040,
            "speakerName": "早柚",
            "text": "真的吗？但那种忍具要做好久好久，好麻烦的…",
            "nextDialogs": [
              "698310106"
            ]
          },
          "698310106": {
            "id": "698310106",
            "speakerId": 1055,
            "speakerName": "多莉",
            "text": "#咦？！{NICKNAME}老爷？您怎怎怎怎么会在这里？",
            "nextDialogs": [
              "698310107"
            ]
          },
          "698310107": {
            "id": "698310107",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "早柚，她在向你推销什么？",
            "nextDialogs": [
              "698310108"
            ]
          },
          "698310108": {
            "id": "698310108",
            "speakerId": 1040,
            "speakerName": "早柚",
            "text": "嗯。我在买东西的时候遇见了多莉，被她拽住，一个劲地要我帮忙拍「广告」。",
            "nextDialogs": [
              "698310109"
            ]
          },
          "698310109": {
            "id": "698310109",
            "speakerId": 1040,
            "speakerName": "早柚",
            "text": "她说话的语速好快，根本没办法打断，还请我吃零食喝饮料，所以就听她说到了现在。",
            "nextDialogs": [
              "698310110"
            ]
          },
          "698310110": {
            "id": "698310110",
            "speakerId": 1055,
            "speakerName": "多莉",
            "text": "哼哼，这瓶灵药可是伟大的桑歌玛哈巴依老爷手里最新最值钱的宝贝。",
            "nextDialogs": [
              "698310111"
            ]
          },
          "698310111": {
            "id": "698310111",
            "speakerId": 1055,
            "speakerName": "多莉",
            "text": "瞧瞧，仔细瞧瞧这瓶「保证让人轻轻松松长高超厉害灵药」！",
            "nextDialogs": [
              "698310112"
            ]
          },
          "698310112": {
            "id": "698310112",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "名字好长…",
            "nextDialogs": [
              "698310113"
            ]
          },
          "698310113": {
            "id": "698310113",
            "speakerId": 1055,
            "speakerName": "多莉",
            "text": "哎呀，因为最近的客人们都没什么耐心，既不想看说明书，也不想听我详细介绍。",
            "nextDialogs": [
              "698310114"
            ]
          },
          "698310114": {
            "id": "698310114",
            "speakerId": 1055,
            "speakerName": "多莉",
            "text": "所以，我就只能把这种灵药的药效全部写在名字里了。虽然名字长了一点，但胜在直观易懂呀。",
            "nextDialogs": [
              "698310115"
            ]
          },
          "698310115": {
            "id": "698310115",
            "speakerId": 1040,
            "speakerName": "早柚",
            "text": "听起来是不错，但是我没钱，我的零花钱都被巫女姐姐收起来了…"
          }
        }
      }
    }
  ]
}
  "subQuests": [
    {
      "subId": "2052001",
      "subQuestName": "与汤米对话",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "205200101"
        ],
        "dialogs": {
          "205200101": {
            "id": "205200101",
            "speakerId": 1000,
            "speakerName": "汤米",
            "text": "旅…旅行者…你…能…能不能帮帮我…",
            "nextDialogs": [
              "205200102"
            ]
          },
          "205200102": {
            "id": "205200102",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "你这是怎么了…",
            "nextDialogs": [
              "205200103"
            ]
          },
          "205200103": {
            "id": "205200103",
            "speakerId": 1000,
            "speakerName": "汤米",
            "text": "拜…拜托你，先帮我找个热源来…我…实在是太冷了…",
            "nextDialogs": [
              "205200104"
            ]
          },
          "205200104": {
            "id": "205200104",
            "speakerId": 1000,
            "speakerName": "汤米",
            "text": "或，或者…你帮我找点热菜来也行。",
            "nextDialogs": [
              "205200105"
            ]
          },
          "205200105": {
            "id": "205200105",
            "speakerId": 1000,
            "speakerName": "汤米",
            "text": "拜…拜托了，我真的冷得受不了了…"
          }
        }
      }
    },
    {
      "subId": "2052002",
      "subQuestName": "",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "205200201"
        ],
        "dialogs": {
          "205200201": {
            "id": "205200201",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "我去帮你找个热源。",
            "nextDialogs": [
              "205200202"
            ]
          },
          "205200202": {
            "id": "205200202",
            "speakerId": 1000,
            "speakerName": "汤米",
            "text": "那最好…那最好，拜托你，请快点…我感觉我马上就要被冻住了…"
          }
        }
      }
    },
    {
      "subId": "2052003",
      "subQuestName": "",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "205200301"
        ],
        "dialogs": {
          "205200301": {
            "id": "205200301",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "我去帮你做点热菜。",
            "nextDialogs": [
              "205200302"
            ]
          },
          "205200302": {
            "id": "205200302",
            "speakerId": 1000,
            "speakerName": "汤米",
            "text": "那…那也不错，那就拜托你了，请快一点…我感觉我马上就要被冻住了…"
          }
        }
      }
    },
    {
      "subId": "2052004",
      "subQuestName": "帮汤米寻找热源",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "205200401"
        ],
        "dialogs": {
          "205200401": {
            "id": "205200401",
            "speakerId": 1000,
            "speakerName": "汤米",
            "text": "呼…这下暖和多了，谢谢你，旅行者。",
            "nextDialogs": [
              "205200402"
            ]
          },
          "205200402": {
            "id": "205200402",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "你怎么会在这里？",
            "nextDialogs": [
              "205200403"
            ]
          },
          "205200403": {
            "id": "205200403",
            "speakerId": 1000,
            "speakerName": "汤米",
            "text": "唉，还不是因为委托的事…我因为一件不那么容易的委托…一直呆在这个营地里。",
            "nextDialogs": [
              "205200404"
            ]
          },
          "205200404": {
            "id": "205200404",
            "speakerId": 1000,
            "speakerName": "汤米",
            "text": "可老是这么待着也不是事，我就想找点事来做…",
            "nextDialogs": [
              "205200405"
            ]
          },
          "205200405": {
            "id": "205200405",
            "speakerId": 1000,
            "speakerName": "汤米",
            "text": "营地的那位厨师哈里斯，说是想要拜托人去雪山里找什么「冷鲜肉」。",
            "nextDialogs": [
              "205200406"
            ]
          },
          "205200406": {
            "id": "205200406",
            "speakerId": 1000,
            "speakerName": "汤米",
            "text": "他还说，只要去找那些被冰冻住的小猪就行了，不用太过深入雪山，没有任何危险…",
            "nextDialogs": [
              "205200407"
            ]
          },
          "205200407": {
            "id": "205200407",
            "speakerId": 1000,
            "speakerName": "汤米",
            "text": "我觉得这件事很简单，就把这个委托接下来了。",
            "nextDialogs": [
              "205200408"
            ]
          },
          "205200408": {
            "id": "205200408",
            "speakerId": 1000,
            "speakerName": "汤米",
            "text": "而且，我也是准备就这样慢慢锻炼自己，逐渐熟悉雪山的环境…",
            "nextDialogs": [
              "205200409"
            ]
          },
          "205200409": {
            "id": "205200409",
            "speakerId": 1000,
            "speakerName": "汤米",
            "text": "然后再把那位…炼金术士小姐的委托给完成了。",
            "nextDialogs": [
              "205200410"
            ]
          },
          "205200410": {
            "id": "205200410",
            "speakerId": 1000,
            "speakerName": "汤米",
            "text": "但没想到，我刚进雪山，没走几步就迷了路，差点被冻成冰块，还好遇见了你…",
            "nextDialogs": [
              "205200411"
            ]
          },
          "205200411": {
            "id": "205200411",
            "speakerId": 1000,
            "speakerName": "汤米",
            "text": "我现在就是非常后悔…委托也没完成…",
            "nextDialogs": [
              "205200412"
            ]
          },
          "205200412": {
            "id": "205200412",
            "speakerId": 1000,
            "speakerName": "汤米",
            "text": "旅行者…我感觉你好像相当熟悉雪山，能拜托你帮个忙吗？",
            "nextDialogs": [
              "205200413"
            ]
          },
          "205200413": {
            "id": "205200413",
            "speakerId": 1000,
            "speakerName": "汤米",
            "text": "拜托你，只要帮我找到一份「冷鲜肉」就好，只要一份，我就能完成这个委托了。",
            "nextDialogs": [
              "205200414"
            ]
          },
          "205200414": {
            "id": "205200414",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "我知道了。",
            "nextDialogs": [
              "205200415"
            ]
          },
          "205200415": {
            "id": "205200415",
            "speakerId": 1000,
            "speakerName": "汤米",
            "text": "太好了，那让我把哈里斯说的冰冻住的小猪会出没的地点给你标在地图上。",
            "nextDialogs": [
              "205200416"
            ]
          },
          "205200416": {
            "id": "205200416",
            "speakerId": 1000,
            "speakerName": "汤米",
            "text": "那么，我就先去山脚下的营地里等你的好消息了。"
          }
        }
      }
    },
    {
      "subId": "2052005",
      "subQuestName": "给汤米制作一份美味的萝卜时蔬汤",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "205200501"
        ],
        "dialogs": {
          "205200501": {
            "id": "205200501",
            "speakerId": 1000,
            "speakerName": "汤米",
            "text": "你找到「冷鲜肉」了吗？",
            "nextDialogs": [
              "205200502"
            ]
          },
          "205200502": {
            "id": "205200502",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "找到了。",
            "nextDialogs": [
              "205200503"
            ]
          },
          "205200503": {
            "id": "205200503",
            "speakerId": 1000,
            "speakerName": "汤米",
            "text": "太好了，这就是「冷鲜肉」吗？但是除了摸起来冷冰冰的，好像也没什么不同…",
            "nextDialogs": [
              "205200504"
            ]
          },
          "205200504": {
            "id": "205200504",
            "speakerId": 1000,
            "speakerName": "汤米",
            "text": "算了，我只管完成委托就行…",
            "nextDialogs": [
              "205200505"
            ]
          },
          "205200505": {
            "id": "205200505",
            "speakerId": 1000,
            "speakerName": "汤米",
            "text": "谢谢你旅行者，要不是你我就惨了。",
            "nextDialogs": [
              "205200506"
            ]
          },
          "205200506": {
            "id": "205200506",
            "speakerId": 1000,
            "speakerName": "汤米",
            "text": "这些报酬请你一定要收下。"
          }
        }
      }
    },

        "dialogs": {
          "733280101": {
            "id": "733280101",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "是你，婕德——！",
            "nextDialogs": [
              "733280102"
            ]
          },
          "733280102": {
            "id": "733280102",
            "speakerId": 1001,
            "speakerName": "婕德",
            "text": "#{NICKNAME}？！还有小派蒙！！",
            "nextDialogs": [
              "733280103"
            ]
          },
          "733280103": {
            "id": "733280103",
            "speakerId": 1002,
            "speakerName": "奔奔",
            "text": "哔哔——！",
            "nextDialogs": [
              "733280104"
            ]
          },
          "733280104": {
            "id": "733280104",
            "speakerId": 1001,
            "speakerName": "婕德",
            "text": "哈哈，我说什么来着！我们又见面了！",
            "nextDialogs": [
              "733280105"
            ]
          },
          "733280105": {
            "id": "733280105",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "你在这里做什么呢？",
            "nextDialogs": [
              "733280106"
            ]
          },
          "733280106": {
            "id": "733280106",
            "speakerId": 1001,
            "speakerName": "婕德",
            "text": "嗯…成熟女人的小秘密？",
            "nextDialogs": [
              "733280107"
            ]
          },
          "733280107": {
            "id": "733280107",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "？",
            "nextDialogs": [
              "733280108"
            ]
          },
          "733280108": {
            "id": "733280108",
            "speakerId": 1001,
            "speakerName": "婕德",
            "text": "#{M#意思就是不要打听啦！我也是有隐私的…}{F#去找一家居酒屋，想办法让我开心，我说不定会告诉你…还要我教你吗？}",
            "nextDialogs": [
              "733280109"
            ]
          },
          "733280109": {
            "id": "733280109",
            "speakerId": 1001,
            "speakerName": "婕德",
            "text": "#{M#噗…是镖局的规定，我也不能说，抱歉啦。}{F#开、开玩笑啦，别当真呀！是镖局的规定…这一趟货要严格保密，抱歉啦。}",
            "nextDialogs": [
              "733280110"
            ]
          },
          "733280110": {
            "id": "733280110",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "哼，神神秘秘的！",
            "nextDialogs": [
              "733280111"
            ]
          },
          "733280111": {
            "id": "733280111",
            "speakerId": 1001,
            "speakerName": "婕德",
            "text": "所以…最近过得怎么样？",
            "nextDialogs": [
              "733280114"
            ]
          },
          "733280114": {
            "id": "733280114",
            "speakerId": 1001,
            "speakerName": "婕德",
            "text": "嗯…我也是。",
            "nextDialogs": [
              "733280115"
            ]
          },
          "733280115": {
            "id": "733280115",
            "speakerId": 1001,
            "speakerName": "婕德",
            "text": "好啦，我不多留你了。唉…还有自己的事情要做。",
            "nextDialogs": [
              "733280116"
            ]
          },
          "733280116": {
            "id": "733280116",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "欸，婕德这么忙的吗…以前也不是这样子呀？",
            "nextDialogs": [
              "733280117"
            ]
          },
          "733280117": {
            "id": "733280117",
            "speakerId": 1001,
            "speakerName": "婕德",
            "text": "噗…这不是找到了「稳定」的工作了嘛，虽然工作内容和以前差不太多。",
            "nextDialogs": [
              "733280118"
            ]
          },
          "733280118": {
            "id": "733280118",
            "speakerId": 1001,
            "speakerName": "婕德",
            "text": "在镖局找到了工作没多久，就又开始怀念以前无拘无束的日子了…",
            "nextDialogs": [
              "733280119"
            ]
          },
          "733280119": {
            "id": "733280119",
            "speakerId": 1001,
            "speakerName": "婕德",
            "text": "虽然不知道你那边情况如何，但我一直在期待着你的故事，我也有很多故事要和你讲呢…",
            "nextDialogs": [
              "733280120"
            ]
          },
          "733280120": {
            "id": "733280120",
            "speakerId": 1001,
            "speakerName": "婕德",
            "text": "不过现在不着急啦，现在不着急…好的故事要多多积存，多多发酵嘛，曾经在沙漠里，旅人是要靠它来活命的！嘿嘿。",
            "nextDialogs": [
              "733280121"
            ]
          },
          "733280121": {
            "id": "733280121",
            "speakerId": 1001,
            "speakerName": "婕德",
            "text": "嗯…总之，请你保重。",
            "nextDialogs": [
              "733280122"
            ]
          },
          "733280122": {
            "id": "733280122",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "你也保重。",
            "nextDialogs": [
              "733280123"
            ]
          },
          "733280123": {
            "id": "733280123",
            "speakerId": 1001,
            "speakerName": "婕德",
            "text": "嗯，一千个拥抱，我会一直为你祈祷的。",
            "nextDialogs": [
              "733280124"
            ]
          },
          "733280124": {
            "id": "733280124",
            "speakerId": 1002,
            "speakerName": "奔奔",
            "text": "哔哔！",
            "nextDialogs": [
              "733280125"
            ]
          },
          "733280125": {
            "id": "733280125",
            "speakerId": 1001,
            "speakerName": "婕德",
            "text": "哈哈，奔奔也一样！"
          }
        }
      }
    },
    {

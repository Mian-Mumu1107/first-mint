{
  "lineCounts": {
    "Player": 5,
    "安彦太郎": 14,
    "派蒙": 4
  },
  "subQuests": [
    {
      "subId": "7268601",
      "subQuestName": "与安彦太郎对话",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "726860101"
        ],
        "dialogs": {
          "726860101": {
            "id": "726860101",
            "speakerId": 1000,
            "speakerName": "安彦太郎",
            "text": "请问阁下的名字是？",
            "nextDialogs": [
              "726860102"
            ]
          },
          "726860102": {
            "id": "726860102",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "#我是{NICKNAME}。",
            "nextDialogs": [
              "726860103"
            ]
          },
          "726860103": {
            "id": "726860103",
            "speakerId": 1000,
            "speakerName": "安彦太郎",
            "text": "好，我记下了，请问阁下可有赌上武者荣誉的觉悟？",
            "nextDialogs": [
              "726860106"
            ]
          },
          "726860106": {
            "id": "726860106",
            "speakerId": 1000,
            "speakerName": "安彦太郎",
            "text": "嗯？难道阁下不是慕名前来参与这场决斗的武者？",
            "nextDialogs": [
              "726860107"
            ]
          },
          "726860107": {
            "id": "726860107",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "完全没听说过这回事。",
            "nextDialogs": [
              "726860108"
            ]
          },
          "726860108": {
            "id": "726860108",
            "speakerId": 1000,
            "speakerName": "安彦太郎",
            "text": "阁下难道没有听说过「孤剑争逐」吗？",
            "nextDialogs": [
              "726860109"
            ]
          },
          "726860109": {
            "id": "726860109",
            "speakerId": 1000,
            "speakerName": "安彦太郎",
            "text": "这不应当，我明明已经张贴过公告了。",
            "nextDialogs": [
              "726860110"
            ]
          },
          "726860110": {
            "id": "726860110",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "你贴在哪里了呢？",
            "nextDialogs": [
              "726860111"
            ]
          },
          "726860111": {
            "id": "726860111",
            "speakerId": 1000,
            "speakerName": "安彦太郎",
            "text": "就在这里。",
            "nextDialogs": [
              "726860112"
            ]
          },
          "726860112": {
            "id": "726860112",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "贴在这里没有用啦，这样的宣传方式怎么会有人来！",
            "nextDialogs": [
              "726860113"
            ]
          },
          "726860113": {
            "id": "726860113",
            "speakerId": 1000,
            "speakerName": "安彦太郎",
            "text": "哼，还不是因为社奉行说「容彩祭不宜舞刀弄枪」，拒绝了我在离岛举办决斗，也禁止我张贴传单。",
            "nextDialogs": [
              "726860114"
            ]
          },
          "726860114": {
            "id": "726860114",
            "speakerId": 1000,
            "speakerName": "安彦太郎",
            "text": "因此，我只能把决斗场选在这里，把公告也贴在旁边。",
            "nextDialogs": [
              "726860115"
            ]
          },
          "726860115": {
            "id": "726860115",
            "speakerId": 1000,
            "speakerName": "安彦太郎",
            "text": "不过，实际上已经有四名武者前来参与比试了，如果连同阁下在内，那就有五人。",
            "nextDialogs": [
              "726860116"
            ]
          },
          "726860116": {
            "id": "726860116",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "#这样还能有人来参加，真是神奇。话说{NICKNAME}来这里是为了什么来着，完全没有印象了…",
            "nextDialogs": [
              "726860117"
            ]
          },
          "726860117": {
            "id": "726860117",
            "speakerId": 1000,
            "speakerName": "安彦太郎",
            "text": "我看阁下能在不知此事的前提下，来到这小岛上，一定是位有着强烈武道精神的勇者。",
            "nextDialogs": [
              "726860118"
            ]
          },
          "726860118": {
            "id": "726860118",
            "speakerId": 1000,
            "speakerName": "安彦太郎",
            "text": "痴迷于武道的人是会相互吸引的，这是常识，两位不必感到奇怪。",
            "nextDialogs": [
              "726860119"
            ]
          },
          "726860119": {
            "id": "726860119",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "这是哪个世界的常识啦。",
            "nextDialogs": [
              "726860120"
            ]
          },
          "726860120": {
            "id": "726860120",
            "speakerId": 1000,
            "speakerName": "安彦太郎",
            "text": "呵呵，如何？阁下是否愿意前来比试？",
            "nextDialogs": [
              "726860121"
            ]
          },
          "726860121": {
            "id": "726860121",
            "speakerId": 1000,
            "speakerName": "安彦太郎",
            "text": "如果阁下能一一胜过那四位参赛者，届时自有礼金奉上。",
            "nextDialogs": [
              "726860122"
            ]
          },
          "726860122": {
            "id": "726860122",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "让我考虑考虑。",
            "nextDialogs": [
              "726860123"
            ]
          },
          "726860123": {
            "id": "726860123",
            "speakerId": 1000,
            "speakerName": "安彦太郎",
            "text": "好，那么就请阁下好好考虑一番。"
          }
        }
      }
    }
  ]
}
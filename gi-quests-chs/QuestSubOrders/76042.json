            ]
          },
          "760420319": {
            "id": "760420319",
            "speakerId": 21924,
            "speakerName": "伊尔玛里",
            "text": "是啊。听说在海难之后他再不敢乘船远航，想必是不打算也做不了海盗了。但像他那样的人要做正经的营生，可不是容易的事。",
            "nextDialogs": [
              "760420320"
            ]
          },
          "760420320": {
            "id": "760420320",
            "speakerId": 1317,
            "speakerName": "雅珂达",
            "text": "过去被他…被阿特拉号「关照」过的人肯定不会善罢甘休。",
            "nextDialogs": [
              "760420321"
            ]
          },
          "760420321": {
            "id": "760420321",
            "speakerId": 1317,
            "speakerName": "雅珂达",
            "text": "不过这都是他自己选的，也怨不得别人。自己选的，就得自己受着。",
            "nextDialogs": [
              "760420322"
            ]
          },
          "760420322": {
            "id": "760420322",
            "speakerId": 21924,
            "speakerName": "伊尔玛里",
            "text": "人活着哪有不犯错的，要紧的是及时转舵。这哈尔克自己就是舵手，却一错再错，唉…",
            "nextDialogs": [
              "760420323"
            ]
          },
          "760420323": {
            "id": "760420323",
            "speakerId": 1317,
            "speakerName": "雅珂达",
            "text": "看来是这个哈尔克在那夏镇捅了娄子之后回到这儿，对他来说是结束的地方，也是开始的地方。",
            "nextDialogs": [
              "760420324"
            ]
          },
          "760420324": {
            "id": "760420324",
            "speakerId": 1317,
            "speakerName": "雅珂达",
            "text": "但是这一次他也做了错误的选择。",
            "nextDialogs": [
              "760420325"
            ]
          },
          "760420325": {
            "id": "760420325",
            "speakerId": 21924,
            "speakerName": "伊尔玛里",
            "text": "本性难移说的就是这么回事吧。他在这块儿害了不少人，后来人就跟滑手的鱼似的，一下没了影儿。",
            "nextDialogs": [
              "760420326"
            ]
          },
          "760420326": {
            "id": "760420326",
            "speakerId": 21924,
            "speakerName": "伊尔玛里",
            "text": "听说那夏镇的「旗舰」也开出了悬赏，那么多人撒网去找，连根头发丝都没捞着。",
            "nextDialogs": [
              "760420327"
            ]
          },
          "760420327": {
            "id": "760420327",
            "speakerId": 1317,
            "speakerName": "雅珂达",
            "text": "没想到老爷子鱼没钓到几条，消息倒挺灵通的嘛。",
            "nextDialogs": [
              "760420328"
            ]
          },
          "760420328": {
            "id": "760420328",
            "speakerId": 21924,
            "speakerName": "伊尔玛里",
            "text": "你这牙尖嘴利的…那我再告诉你一个好消息吧，阿特拉号的残骸就在那边，你大可以去碰碰运气。",
            "nextDialogs": [
              "760420329"
            ]
          },
          "760420329": {
            "id": "760420329",
            "speakerId": 1317,
            "speakerName": "雅珂达",
            "text": "碰碰运气？那要是他真的不知道从哪儿蹦出来揍我，老爷子你帮忙吗？",
            "nextDialogs": [
              "760420330"
            ]
          },
          "760420330": {
            "id": "760420330",
            "speakerId": 21924,
            "speakerName": "伊尔玛里",
            "text": "当然不帮，我只是个钓鱼的，能帮什么忙。最多陪你到附近，给你指个路吧…反正这里看起来是钓不上什么鱼了。",
            "nextDialogs": [
              "760420331"
            ]
          },
          "760420331": {
            "id": "760420331",
            "speakerId": 1317,
            "speakerName": "雅珂达",
            "text": "唉，说得也是。没事，打不过我还不能开溜么，逃跑我还是很擅长的。"
          }
        }
      }
    },
    {
      "subId": "7604299",

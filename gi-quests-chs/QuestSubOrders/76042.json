    "奈芙尔": 3,
    "雅珂达": 46
  },
  "subQuests": [
    {
      "subId": "7604201",
      "subQuestName": "前往「秘闻馆」",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "760420101"
        ],
        "dialogs": {
          "760420101": {
            "id": "760420101",
            "speakerId": 1317,
            "speakerName": "雅珂达",
            "text": "宝藏猎人在搜刮海盗船残骸时被鬼魂袭击…听起来像是三流娱乐小说会写的题材呢。",
            "nextDialogs": [
              "760420102"
            ]
          },
          "760420102": {
            "id": "760420102",
            "speakerId": 1317,
            "speakerName": "雅珂达",
            "text": "挨揍的那几个家伙向来说话不着边际，也不知道他们的话有几分真。",
            "nextDialogs": [
              "760420103"
            ]
          },
          "760420103": {
            "id": "760420103",
            "speakerId": 1316,
            "speakerName": "奈芙尔",
            "text": "那艘海盗船，雅珂达也听说过吧。",
            "nextDialogs": [
              "760420104"
            ]
          },
          "760420104": {
            "id": "760420104",
            "speakerId": 1317,
            "speakerName": "雅珂达",
            "text": "听过听过，虽然那时候我还小，但阿特拉号的大名我也是知道的。",
            "nextDialogs": [
              "760420105"
            ]
          },
          "760420105": {
            "id": "760420105",
            "speakerId": 1317,
            "speakerName": "雅珂达",
            "text": "「要是不听话，就会被『盾女』洛维萨抓走，被『疯子』格瑞蒂尔扔进海里喂鱼！」",
            "nextDialogs": [
              "760420106"
            ]
          },
          "760420106": {
            "id": "760420106",
            "speakerId": 1317,
            "speakerName": "雅珂达",
            "text": "以前还有大人拿这些话吓唬小孩呢，当然，我是一点也不怕啦。",
            "nextDialogs": [
              "760420107"
            ]
          },
          "760420107": {
            "id": "760420107",
            "speakerId": 1316,
            "speakerName": "奈芙尔",
            "text": "呵呵，既然如此，那这次的任务的人选也非你莫属了。",
            "nextDialogs": [
              "760420108"
            ]
          },
          "760420108": {
            "id": "760420108",
            "speakerId": 1317,
            "speakerName": "雅珂达",
            "text": "…欸？！",
            "nextDialogs": [
              "760420109"
            ]
          },
          "760420109": {
            "id": "760420109",
            "speakerId": 1317,
            "speakerName": "雅珂达",
            "text": "好吧…虽然有点远，不过我会好好调查的。",
            "nextDialogs": [
              "760420110"
            ]
          },
          "760420110": {
            "id": "760420110",
            "speakerId": 1317,
            "speakerName": "雅珂达",
            "text": "（那片海域沉船不少，时不时有人挖到宝物，说不定这次我也…）",
            "nextDialogs": [
              "760420111"
            ]
          },
          "760420111": {
            "id": "760420111",
            "speakerId": 1316,
            "speakerName": "奈芙尔",
            "text": "可别因为寻宝而耽误了正事。",
            "nextDialogs": [
              "760420112"
            ]
          },
          "760420112": {
            "id": "760420112",
            "speakerId": 1317,
            "speakerName": "雅珂达",
            "text": "知、知道了，老板！我一定速去速回！"
          }
        }
      }
    },
    {
      "subId": "7604202",
      "subQuestName": "前往刻拉蒂之眼附近的海滩调查",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "760420201"
        ],
        "dialogs": {
          "760420201": {
            "id": "760420201",
            "speakerId": 21924,
            "speakerName": "伊尔玛里",
            "text": "看你的打扮…你也是来寻宝的宝藏猎人？你们这些人隔三岔五地来，还真是乐此不疲。",
            "nextDialogs": [
              "760420202"
            ]
          },
          "760420202": {
            "id": "760420202",
            "speakerId": 1317,
            "speakerName": "雅珂达",
            "text": "老爷子看得挺准。这不是听说之前有同行折在这儿了么，还到处嚷嚷，说什么自己是被鬼魂给袭击了。",
            "nextDialogs": [
              "760420203"
            ]
          },
          "760420203": {
            "id": "760420203",
            "speakerId": 1317,
            "speakerName": "雅珂达",
            "text": "我不信邪，偏要来看看这里到底有没有会打人的鬼…当然，要是能找到同行没本事拿到手的宝物，那就更好了。",
            "nextDialogs": [
              "760420204"
            ]
          },
          "760420204": {
            "id": "760420204",
            "speakerId": 1317,
            "speakerName": "雅珂达",
            "text": "老爷子，你给我说说呗，他们说的会打人的鬼，到底是怎么回事？",
            "nextDialogs": [
              "760420205"
            ]
          },
          "760420205": {
            "id": "760420205",
            "speakerId": 21924,
            "speakerName": "伊尔玛里",
            "text": "哪有什么会打人的鬼，挨打的是人，打人的自然也是人。不过说起来，那确实是恶鬼一样的人，虽然活着，说不定早就死了。",
            "nextDialogs": [
              "760420206"
            ]
          },
          "760420206": {
            "id": "760420206",
            "speakerId": 1317,
            "speakerName": "雅珂达",
            "text": "…啊？老爷子，你该不会是…",
            "nextDialogs": [
              "760420207"
            ]
          },
          "760420207": {
            "id": "760420207",
            "speakerId": 21924,
            "speakerName": "伊尔玛里",
            "text": "我可没糊涂。阿特拉号你听过吗？",
            "nextDialogs": [
              "760420208"
            ]
          },
          "760420208": {
            "id": "760420208",
            "speakerId": 1317,
            "speakerName": "雅珂达",
            "text": "听过。不过它不是早沉了吗，而且就在这附近吧。",
            "nextDialogs": [
              "760420209"
            ]
          },
          "760420209": {
            "id": "760420209",
            "speakerId": 1317,
            "speakerName": "雅珂达",
            "text": "船上最值钱的宝贝，就要数能带人找到雷德·米勒留下的「伟大财宝」的信物了，不过到现在还没人找到。",
            "nextDialogs": [
              "760420210"
            ]
          },
          "760420210": {
            "id": "760420210",
            "speakerId": 21924,
            "speakerName": "伊尔玛里",
            "text": "你知道得还挺多。",
            "nextDialogs": [
              "760420211"
            ]
          },
          "760420211": {
            "id": "760420211",
            "speakerId": 1317,
            "speakerName": "雅珂达",
            "text": "哼哼，这叫职业素养。欸？这么说，打人的人和阿特拉号有关系？",
            "nextDialogs": [
              "760420212"
            ]
          },
          "760420212": {
            "id": "760420212",
            "speakerId": 21924,
            "speakerName": "伊尔玛里",
            "text": "没错。当年的海难虽然惨烈，但也有不少幸存者，「裂颚」哈尔克就是其中之一。阿特拉号叫得上名号的海盗也就剩他一个了。",
            "nextDialogs": [
              "760420213"
            ]
          },
          "760420213": {
            "id": "760420213",
            "speakerId": 21924,
            "speakerName": "伊尔玛里",
            "text": "听说他这些年先是去了至冬堡，近来又跟着什么商队做事。最近是在那夏镇犯了什么事吧，商队也容不下他。",
            "nextDialogs": [
              "760420214"
            ]
          },
          "760420214": {
            "id": "760420214",
            "speakerId": 21924,
            "speakerName": "伊尔玛里",
            "text": "那天几个宝藏猎人在阿特拉号的残骸附近翻找，「裂颚」哈尔克瞧见了，就给他们一顿好打。",
            "nextDialogs": [
              "760420215"
            ]
          },
          "760420215": {
            "id": "760420215",
            "speakerId": 1317,
            "speakerName": "雅珂达",
            "text": "那是他的船，哪怕沉了，也还是他的船。",
            "nextDialogs": [
              "760420216"
            ]
          },
          "760420216": {
            "id": "760420216",
            "speakerId": 21924,
            "speakerName": "伊尔玛里",
            "text": "是啊。听说在海难之后他再也不敢乘船远航，想必是不打算也做不了海盗了。但像他那样的人要做正经的营生，可不是容易的事。",
            "nextDialogs": [
              "760420217"
            ]
          },
          "760420217": {
            "id": "760420217",
            "speakerId": 1317,
            "speakerName": "雅珂达",
            "text": "过去被他…被阿特拉号「关照」过的人肯定不会善罢甘休。",
            "nextDialogs": [
              "760420218"
            ]
          },
          "760420218": {
            "id": "760420218",
            "speakerId": 1317,
            "speakerName": "雅珂达",
            "text": "不过这都是他自己选的，也怨不得别人。自己选的，就得自己受着。",
            "nextDialogs": [
              "760420219"
            ]
          },
          "760420219": {
            "id": "760420219",
            "speakerId": 21924,
            "speakerName": "伊尔玛里",
            "text": "人活着哪有不犯错的，要紧的是及时转舵。这哈尔克自己就是舵手，却一错再错，唉…",
            "nextDialogs": [
              "760420220"
            ]
          },
          "760420220": {
            "id": "760420220",
            "speakerId": 1317,
            "speakerName": "雅珂达",
            "text": "看来是这个哈尔克在那夏镇捅了娄子之后回到这儿，对他来说是结束的地方，也是开始的地方。",
            "nextDialogs": [
              "760420221"
            ]
          },
          "760420221": {
            "id": "760420221",
            "speakerId": 1317,
            "speakerName": "雅珂达",
            "text": "但是这一次他也做了错误的选择。",
            "nextDialogs": [
              "760420222"
            ]
          },
          "760420222": {
            "id": "760420222",
            "speakerId": 21924,
            "speakerName": "伊尔玛里",
            "text": "本性难移说的就是这么回事吧。他在这块儿害了不少人，后来人就跟滑手的鱼似的，一下没了影儿。",
            "nextDialogs": [
              "760420223"
            ]
          },
          "760420223": {
            "id": "760420223",
            "speakerId": 21924,
            "speakerName": "伊尔玛里",
            "text": "听说那夏镇的「旗舰」也开出了悬赏，那么多人撒网去找，连根头发丝都没捞着。",
            "nextDialogs": [
              "760420224"
            ]
          },
          "760420224": {
            "id": "760420224",
            "speakerId": 1317,
            "speakerName": "雅珂达",
            "text": "没想到老爷子鱼没钓到几条，消息倒挺灵通的嘛。",
            "nextDialogs": [
              "760420225"
            ]
          },
          "760420225": {
            "id": "760420225",
            "speakerId": 21924,
            "speakerName": "伊尔玛里",
            "text": "你这牙尖嘴利的…那我再告诉你一个好消息吧，阿特拉号的残骸就在那边，你大可以去碰碰运气。",
            "nextDialogs": [
              "760420226"
            ]
          },
          "760420226": {
            "id": "760420226",
            "speakerId": 1317,
            "speakerName": "雅珂达",
            "text": "碰碰运气？那要是他真的不知道从哪儿蹦出来揍我，老爷子你帮忙吗？",
            "nextDialogs": [
              "760420227"
            ]
          },
          "760420227": {
            "id": "760420227",
            "speakerId": 21924,
            "speakerName": "伊尔玛里",
            "text": "当然不帮，我只是个钓鱼的，能帮什么忙。最多陪你到附近，给你指个路吧…反正这里看起来是钓不上什么鱼了。",
            "nextDialogs": [
              "760420228"
            ]
          },
          "760420228": {
            "id": "760420228",
            "speakerId": 1317,
            "speakerName": "雅珂达",
            "text": "唉，说得也是。没事，打不过我还不能开溜么，逃跑我还是很擅长的。"
          }
        }
      }
    },
    {
      "subId": "7604203",
      "subQuestName": "调查沉船残骸",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "760420401"
        ],
        "dialogs": {
          "760420401": {
            "id": "760420401",
            "speakerId": 1317,
            "speakerName": "雅珂达",
            "text": "（破损成这样，谁还看得出这是曾经的海盗船啊。）",
            "nextDialogs": [
              "760420402"
            ]
          },
          "760420402": {
            "id": "760420402",
            "speakerId": 1317,
            "speakerName": "雅珂达",
            "text": "（还没被人发现的宝物…唉，还是别做梦了。）"
          }
        }
      }
    },
    {
      "subId": "7604204",
      "subQuestName": "继续寻找线索",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "760420501"
        ],
        "dialogs": {
          "760420501": {
            "id": "760420501",
            "speakerId": 1317,
            "speakerName": "雅珂达",
            "text": "（提到了哈尔克的名字，看来的确是阿特拉号的残骸。）",
            "nextDialogs": [
              "760420502"
            ]
          },
          "760420502": {
            "id": "760420502",
            "speakerId": 1317,
            "speakerName": "雅珂达",
            "text": "（他要是真的跳出来揍我，那我算因工负伤吗？得问奈姐要点津贴才行…）"
          }
        }
      }
    },

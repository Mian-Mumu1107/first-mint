            "id": "732441901",
            "speakerId": 20723,
            "speakerName": "婕德",
            "text": "「充能转化容器」，希望拿到那个东西以后，就能够让奔奔恢复过来…",
            "nextDialogs": [
              "732441902"
            ]
          },
          "732441902": {
            "id": "732441902",
            "speakerId": 20723,
            "speakerName": "婕德",
            "text": "如果实在不安心的话，我也一起去吧。",
            "nextDialogs": [
              "732441905"
            ]
          },
          "732441905": {
            "id": "732441905",
            "speakerId": 20723,
            "speakerName": "婕德",
            "text": "嗯，那我就在这里等你的好消息，一定要安全回来！"
          }
        }
      }

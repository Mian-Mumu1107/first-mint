    {
      "subId": "7324401",
      "subQuestName": "与婕德对话$HIDDEN",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "732440101"
        ],
        "dialogs": {
          "732440101": {
            "id": "732440101",
            "speakerId": 16694,
            "speakerName": "婕德",
            "text": "怎么会…我居然忘记了…",
            "nextDialogs": [
              "732440102"
            ]
          },
          "732440102": {
            "id": "732440102",
            "speakerId": 16694,
            "speakerName": "婕德",
            "text": "希望还来得及，至少，得去他的帐篷里先找一找…",
            "nextDialogs": [
              "732440103"
            ]
          },
          "732440103": {
            "id": "732440103",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "婕德！咦，怎么了，你现在正要去哪吗？",
            "nextDialogs": [
              "732440104"
            ]
          },
          "732440104": {
            "id": "732440104",
            "speakerId": 16694,
            "speakerName": "婕德",
            "text": "#派蒙，还有{NICKNAME}…你们倒是来的正好，嗯，我现在得立刻去办件事情，我要去…阿德菲住的地方。",
            "nextDialogs": [
              "732440105"
            ]
          },
          "732440105": {
            "id": "732440105",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "阿德菲？",
            "nextDialogs": [
              "732440106"
            ]
          },
          "732440106": {
            "id": "732440106",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "那个家伙不是和愚人众勾搭在一起的叛徒吗…哦！我懂了，你是想去搜刮他的帐篷！",
            "nextDialogs": [
              "732440107"
            ]
          },
          "732440107": {
            "id": "732440107",
            "speakerId": 16694,
            "speakerName": "婕德",
            "text": "不，我对那家伙留下来的东西毫无兴趣。",
            "nextDialogs": [
              "732440108"
            ]
          },
          "732440108": {
            "id": "732440108",
            "speakerId": 16694,
            "speakerName": "婕德",
            "text": "部族对这些叛徒遗留的东西应当如何处置有特定的规矩，哼…要不是因为这个，我恨不得把那家伙留下的东西全部烧光。",
            "nextDialogs": [
              "732440109"
            ]
          },
          "732440109": {
            "id": "732440109",
            "speakerId": 16694,
            "speakerName": "婕德",
            "text": "我要去他的帐篷是因为…",
            "nextDialogs": [
              "732440110"
            ]
          },
          "732440110": {
            "id": "732440110",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "是因为奔奔吧…",
            "nextDialogs": [
              "732440111"
            ]
          },
          "732440111": {
            "id": "732440111",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "啊，对哦！奔奔在阿德菲那里，这可怎么办！",
            "nextDialogs": [
              "732440112"
            ]
          },
          "732440112": {
            "id": "732440112",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "呜，婕德，你怎么把奔奔交给了那样的家伙呀！",
            "nextDialogs": [
              "732440113"
            ]
          },
          "732440113": {
            "id": "732440113",
            "speakerId": 16694,
            "speakerName": "婕德",
            "text": "唉，在、在那之前，我也不知道他是叛徒啊！",
            "nextDialogs": [
              "732440114"
            ]
          },
          "732440114": {
            "id": "732440114",
            "speakerId": 16694,
            "speakerName": "婕德",
            "text": "总之，得快点去阿德菲那里看看才行…",
            "nextDialogs": [
              "732440115"
            ]
          },
          "732440115": {
            "id": "732440115",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "#{NICKNAME}，我们也一起去吧。",
            "nextDialogs": [
              "732440118"
            ]
          },
          "732440118": {
            "id": "732440118",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "嗯，奔奔可千万别出事呀…"
          }
        }
      }
    },
    {
      "subId": "7324402",
      "subQuestName": "到达阿德菲的帐篷寻找线索",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [],
        "dialogs": {}
      }
    },
    {
      "subId": "7324419",
      "subQuestName": "查看状态失常的奔奔",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "732441001"
        ],
        "dialogs": {
          "732441001": {
            "id": "732441001",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "啊，是奔奔！",
            "nextDialogs": [
              "732441002"
            ]
          },
          "732441002": {
            "id": "732441002",
            "speakerId": 20723,
            "speakerName": "婕德",
            "text": "幸好阿德菲还没来得及把奔奔带走…",
            "nextDialogs": [
              "732441003"
            ]
          },
          "732441003": {
            "id": "732441003",
            "speakerId": 20723,
            "speakerName": "婕德",
            "text": "不如说，这里的东西都跟之前一模一样，根本没有变化。",
            "nextDialogs": [
              "732441004"
            ]
          },
          "732441004": {
            "id": "732441004",
            "speakerId": 20723,
            "speakerName": "婕德",
            "text": "这家伙不会以为自己能够成功推翻主母，然后安然无恙地回到自己的帐篷里吧…？真是自大的蠢货。",
            "nextDialogs": [
              "732441005"
            ]
          },
          "732441005": {
            "id": "732441005",
            "speakerId": 20723,
            "speakerName": "婕德",
            "text": "不过也多亏了这份愚蠢，奔奔才没出什么事。",
            "nextDialogs": [
              "732441006"
            ]
          },
          "732441006": {
            "id": "732441006",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "这也叫没出什么事吗…奔奔，奔奔…",
            "nextDialogs": [
              "732441009"
            ]
          },
          "732441009": {
            "id": "732441009",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "对啊，它怎么躺在地上…",
            "nextDialogs": [
              "732441010"
            ]
          },
          "732441010": {
            "id": "732441010",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "奔奔到底出了什么事呀，上次见到的时候还好好的呢…",
            "nextDialogs": [
              "732441011"
            ]
          },
          "732441011": {
            "id": "732441011",
            "speakerId": 20723,
            "speakerName": "婕德",
            "text": "奔奔…在离开圣显厅之后，就逐渐变得虚弱起来了，看上去像是有什么地方出了故障，发出的声音也越来越小…",
            "nextDialogs": [
              "732441012"
            ]
          },
          "732441012": {
            "id": "732441012",
            "speakerId": 20723,
            "speakerName": "婕德",
            "text": "直到发不出声音，甚至也没法移动，就像是，拥有的生命力一点一点流失掉了一样。",
            "nextDialogs": [
              "732441013"
            ]
          },
          "732441013": {
            "id": "732441013",
            "speakerId": 20723,
            "speakerName": "婕德",
            "text": "那个时候，整个部族里，除了阿德菲，没人对奔奔身上发生什么有概念。",
            "nextDialogs": [
              "732441014"
            ]
          },
          "732441014": {
            "id": "732441014",
            "speakerId": 20723,
            "speakerName": "婕德",
            "text": "所以我就把奔奔放在了阿德菲这里…",
            "nextDialogs": [
              "732441015"
            ]
          },
          "732441015": {
            "id": "732441015",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "怎么会这样…奔奔，奔奔不会就这样再也醒不了了吧。",
            "nextDialogs": [
              "732441016"
            ]
          },
          "732441016": {
            "id": "732441016",
            "speakerId": 20723,
            "speakerName": "婕德",
            "text": "……",
            "nextDialogs": [
              "732441017"
            ]
          },
          "732441017": {
            "id": "732441017",
            "speakerId": 20723,
            "speakerName": "婕德",
            "text": "总之，奔奔既然还在，总有一天能找到让它恢复的办法…",
            "nextDialogs": [
              "732441018"
            ]
          },
          "732441018": {
            "id": "732441018",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "可像这样，一点头绪都没有…",
            "nextDialogs": [
              "732441019"
            ]
          },
          "732441019": {
            "id": "732441019",
            "speakerId": 20723,
            "speakerName": "婕德",
            "text": "我想想，我记得上次阿德菲还和我说，不是什么很严重的问题，这两天就能够出结果…",
            "nextDialogs": [
              "732441020"
            ]
          },
          "732441020": {
            "id": "732441020",
            "speakerId": 20723,
            "speakerName": "婕德",
            "text": "按这家伙的习惯，如果做了什么检查，肯定会留下什么记录才对。我们在周围先找找看吧！",
            "nextDialogs": [
              "732441021"
            ]
          },
          "732441021": {
            "id": "732441021",
            "speakerId": 20723,
            "speakerName": "婕德",
            "text": "如果不是什么「严重的问题」的话，说不定我们也能解决一下！"
          }
        }
      }
    },
    {
      "subId": "7324420",
      "subQuestName": "在帐篷内进行调查",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "732442001"
        ],
        "dialogs": {
          "732442001": {
            "id": "732442001",
            "speakerId": 20724,
            "speakerName": "奔奔",
            "text": "（奔奔，躺在地上…并没有发出熟悉的「哔哔」声。）"
          }
        }
      }
    },
    {
      "subId": "7324403",
      "subQuestName": "查看信件",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "732440301"
        ],
        "dialogs": {
          "732440301": {
            "id": "732440301",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "快看，这里好像有点东西。",
            "nextDialogs": [
              "732440302"
            ]
          },
          "732440302": {
            "id": "732440302",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "不过看上去不像是一份什么检查记录，而是一封信…",
            "nextDialogs": [
              "732440303"
            ]
          },
          "732440303": {
            "id": "732440303",
            "speakerId": 20723,
            "speakerName": "婕德",
            "text": "什么信，快打开看看吧！",
            "nextDialogs": [
              "732440304"
            ]
          },
          "732440304": {
            "id": "732440304",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "看这封信上的意思，奔奔原来只是没有能量了…",
            "nextDialogs": [
              "732440305"
            ]
          },
          "732440305": {
            "id": "732440305",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "这么一想，不管是打开赤王陵的大门，还是为我们激活了权限，奔奔在一路上帮我们做了很多事…",
            "nextDialogs": [
              "732440306"
            ]
          },
          "732440306": {
            "id": "732440306",
            "speakerId": 20723,
            "speakerName": "婕德",
            "text": "就算是奔奔，也会觉得累吧…可能就是因为为我们做了那么多事，所以它才失去了能量。",
            "nextDialogs": [
              "732440307"
            ]
          },
          "732440307": {
            "id": "732440307",
            "speakerId": 20723,
            "speakerName": "婕德",
            "text": "上面提到有什么特殊的「充能转化容器」，可是帐篷里好像没有看到类似的东西。",
            "nextDialogs": [
              "732440308"
            ]
          },
          "732440308": {
            "id": "732440308",
            "speakerId": 20723,
            "speakerName": "婕德",
            "text": "难道说…",
            "nextDialogs": [
              "732440310",
              "732440313"
            ]
          },
          "732440310": {
            "id": "732440310",
            "speakerId": 20723,
            "speakerName": "婕德",
            "text": "不太像，只是用来维修奔奔的话，也不用特地藏起来，直接使用不就好了…",
            "nextDialogs": [
              "732440311"
            ]
          },
          "732440311": {
            "id": "732440311",
            "speakerId": 20723,
            "speakerName": "婕德",
            "text": "我明白了！一定是这场交易还没发生！",
            "nextDialogs": [
              "732440314"
            ]
          },
          "732440314": {
            "id": "732440314",
            "speakerId": 20723,
            "speakerName": "婕德",
            "text": "所以奔奔没被阿德菲带到交易现场，当然也没有「充能转化容器」…那剩下的问题只有一个了，阿德菲交易的对象是谁？",
            "nextDialogs": [
              "732440315"
            ]
          },
          "732440315": {
            "id": "732440315",
            "speakerId": 20723,
            "speakerName": "婕德",
            "text": "哈，真是问了个蠢问题，会和他在部落外做这种交易的恐怕只有一类人了…"
          },
          "732440313": {
            "id": "732440313",
            "speakerId": 20723,
            "speakerName": "婕德",
            "text": "啊，我明白你的意思了，这场交易还没有发生！"
          }
        }
      }
    },

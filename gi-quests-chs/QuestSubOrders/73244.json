    {
      "subId": "7324408",
      "subQuestName": "将「充能转化容器」交给婕德",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "732440801"
        ],
        "dialogs": {
          "732440801": {
            "id": "732440801",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "婕德！",
            "nextDialogs": [
              "732440803"
            ]
          },
          "732440803": {
            "id": "732440803",
            "speakerId": 20723,
            "speakerName": "婕德",
            "text": "怎么样，你们没出什么事吧？",
            "nextDialogs": [
              "732440802"
            ]
          },
          "732440802": {
            "id": "732440802",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "没有没有，什么事都没有。对了，你看，这些就是「充能转化容器」！"
          }
        }
      }
    },
    {
      "subId": "7324415",
      "subQuestName": "修复奔奔",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "732441504"
        ],
        "dialogs": {
          "732441504": {
            "id": "732441504",
            "speakerId": 20723,
            "speakerName": "婕德",
            "text": "原来「充能转化容器」长这样啊…可是，这东西应该怎么用呢…",
            "nextDialogs": [
              "732441505"
            ]
          },
          "732441505": {
            "id": "732441505",
            "speakerId": 20724,
            "speakerName": "奔奔",
            "text": "哔…哔哔…",
            "nextDialogs": [
              "732441506"
            ]
          },
          "732441506": {
            "id": "732441506",
            "speakerId": 20723,
            "speakerName": "婕德",
            "text": "奔奔？",
            "nextDialogs": [
              "732441507"
            ]
          },
          "732441507": {
            "id": "732441507",
            "speakerId": 1004,
            "speakerName": "Black Screen",
            "text": "奔奔链接上了「充能转化容器」，以很快的速度汲取了其中的能量。",
            "nextDialogs": [
              "732441508"
            ]
          },
          "732441508": {
            "id": "732441508",
            "speakerId": 20724,
            "speakerName": "奔奔",
            "text": "哔哔——哔哔——",
            "nextDialogs": [
              "732441509"
            ]
          },
          "732441509": {
            "id": "732441509",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "哇，奔奔复活了！",
            "nextDialogs": [
              "732441510"
            ]
          },
          "732441510": {
            "id": "732441510",
            "speakerId": 20723,
            "speakerName": "婕德",
            "text": "说什么傻话，奔奔之前都在睡觉，现在只是醒过来了而已啦！",
            "nextDialogs": [
              "732441511"
            ]
          },
          "732441511": {
            "id": "732441511",
            "speakerId": 20724,
            "speakerName": "奔奔",
            "text": "哔哔…哔哔…",
            "nextDialogs": [
              "732441512"
            ]
          },
          "732441512": {
            "id": "732441512",
            "speakerId": 20723,
            "speakerName": "婕德",
            "text": "没有，我才没有担心呢，我知道你总有一天能恢复过来的！",
            "nextDialogs": [
              "732441513"
            ]
          },
          "732441513": {
            "id": "732441513",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "哼，「把它独自留在别处这种事，有一次就够了…」",
            "nextDialogs": [
              "732441514"
            ]
          },
          "732441514": {
            "id": "732441514",
            "speakerId": 20723,
            "speakerName": "婕德",
            "text": "派蒙不许学我说话！",
            "nextDialogs": [
              "732441515"
            ]
          },
          "732441515": {
            "id": "732441515",
            "speakerId": 20724,
            "speakerName": "奔奔",
            "text": "哔哔——",
            "nextDialogs": [
              "732441516"
            ]
          },
          "732441516": {
            "id": "732441516",
            "speakerId": 20723,
            "speakerName": "婕德",
            "text": "#啊，对了，{NICKNAME}，奔奔说谢谢你。",
            "nextDialogs": [
              "732441517"
            ]
          },
          "732441517": {
            "id": "732441517",
            "speakerId": 20723,
            "speakerName": "婕德",
            "text": "看来就算躺着不动，但是你们做的事奔奔也能知道。",
            "nextDialogs": [
              "732441518"
            ]
          },
          "732441518": {
            "id": "732441518",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "不用谢，奔奔。",
            "nextDialogs": [
              "732441519"
            ]
          },
          "732441519": {
            "id": "732441519",
            "speakerId": 20724,
            "speakerName": "奔奔",
            "text": "哔哔！",
            "nextDialogs": [
              "732441520"
            ]
          },
          "732441520": {
            "id": "732441520",
            "speakerId": 20723,
            "speakerName": "婕德",
            "text": "唔…",
            "nextDialogs": [
              "732441521"
            ]
          },
          "732441521": {
            "id": "732441521",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "怎么了，婕德？",
            "nextDialogs": [
              "732441522"
            ]
          },
          "732441522": {
            "id": "732441522",
            "speakerId": 20723,
            "speakerName": "婕德",
            "text": "虽然醒了过来，不过看上去奔奔还是需要恢复一下…",
            "nextDialogs": [
              "732441523"
            ]
          },
          "732441523": {
            "id": "732441523",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "嗯，要好好休息呀，奔奔！",
            "nextDialogs": [
              "732441524"
            ]
          },
          "732441524": {
            "id": "732441524",
            "speakerId": 20724,
            "speakerName": "奔奔",
            "text": "哔哔…"
          }
        }
      }
    },

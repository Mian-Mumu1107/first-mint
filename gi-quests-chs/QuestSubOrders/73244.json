    {
      "subId": "7324417",
      "subQuestName": "与愚人众交易人员对话",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "732441701"
        ],
        "dialogs": {
          "732441701": {
            "id": "732441701",
            "speakerId": 20928,
            "speakerName": "愚人众交易人员",
            "text": "别、别打了…",
            "nextDialogs": [
              "732441702"
            ]
          },
          "732441702": {
            "id": "732441702",
            "speakerId": 20928,
            "speakerName": "愚人众交易人员",
            "text": "快停手吧，再打下去真的要出人命了…",
            "nextDialogs": [
              "732441703"
            ]
          },
          "732441703": {
            "id": "732441703",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "被打的人说这话还真有说服力。",
            "nextDialogs": [
              "732441704"
            ]
          },
          "732441704": {
            "id": "732441704",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "说！",
            "nextDialogs": [
              "732441705"
            ]
          },
          "732441705": {
            "id": "732441705",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "快说！",
            "nextDialogs": [
              "732441706"
            ]
          },
          "732441706": {
            "id": "732441706",
            "speakerId": 20928,
            "speakerName": "愚人众交易人员",
            "text": "我说我说，你们想知道什么我都说！",
            "nextDialogs": [
              "732441707"
            ]
          },
          "732441707": {
            "id": "732441707",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "先说说你知道什么！",
            "nextDialogs": [
              "732441708"
            ]
          },
          "732441708": {
            "id": "732441708",
            "speakerId": 20928,
            "speakerName": "愚人众交易人员",
            "text": "我、我们只是一直和阿德菲做一些交易而已…据说塔尼特的主母偏爱什么阿萨里格…还有那个新来的小姑娘…",
            "nextDialogs": [
              "732441709"
            ]
          },
          "732441709": {
            "id": "732441709",
            "speakerId": 20928,
            "speakerName": "愚人众交易人员",
            "text": "哼，虽说不知怎么回事，阿萨里格似乎也失踪了…",
            "nextDialogs": [
              "732441710"
            ]
          },
          "732441710": {
            "id": "732441710",
            "speakerId": 20928,
            "speakerName": "愚人众交易人员",
            "text": "那个女人心狠手辣，不会容留对部族失去价值的人…所以，阿德菲为了保证自己的地位联系了我们…",
            "nextDialogs": [
              "732441711"
            ]
          },
          "732441711": {
            "id": "732441711",
            "speakerId": 20928,
            "speakerName": "愚人众交易人员",
            "text": "之前我们在沙漠里的工作开展一直不是很顺利，这下倒是、倒是有点一拍即合的意思。",
            "nextDialogs": [
              "732441713",
              "732441717"
            ]
          },
          "732441713": {
            "id": "732441713",
            "speakerId": 20928,
            "speakerName": "愚人众交易人员",
            "text": "我不知道…我真的不知道！那是他们沙漠人内部的事务…不过要我猜的话，可能是因为那个女人认为我们不可信任了…",
            "nextDialogs": [
              "732441714"
            ]
          },
          "732441714": {
            "id": "732441714",
            "speakerId": 20928,
            "speakerName": "愚人众交易人员",
            "text": "…所以她才会疏远我们，而经常与我们联络的阿德菲也为此不安…",
            "nextDialogs": [
              "732441715"
            ]
          },
          "732441715": {
            "id": "732441715",
            "speakerId": 20928,
            "speakerName": "愚人众交易人员",
            "text": "毕竟我们还能撤离这个鬼地方，而他只能被榨干价值，然后任部落处置…",
            "nextDialogs": [
              "732441724"
            ]
          },
          "732441724": {
            "id": "732441724",
            "speakerId": 20928,
            "speakerName": "愚人众交易人员",
            "text": "只是阿德菲这个人异常狡猾，他要的东西我们给了不少，我们要的东西却一点眉目没有…",
            "nextDialogs": [
              "732441725"
            ]
          },
          "732441725": {
            "id": "732441725",
            "speakerId": 20928,
            "speakerName": "愚人众交易人员",
            "text": "不过听说他出事了…虽然不知道出了什么事，但我们想，这不正好是个好机会…",
            "nextDialogs": [
              "732441726"
            ]
          },
          "732441726": {
            "id": "732441726",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "好机会？什么好机会？",
            "nextDialogs": [
              "732441727"
            ]
          },
          "732441727": {
            "id": "732441727",
            "speakerId": 20928,
            "speakerName": "愚人众交易人员",
            "text": "我们估计之后也没有什么和阿德菲做交易的机会，所以就让他带上前几次信里说的什么特殊元能构装体…",
            "nextDialogs": [
              "732441728"
            ]
          },
          "732441728": {
            "id": "732441728",
            "speakerId": 20928,
            "speakerName": "愚人众交易人员",
            "text": "如果可以就夺过来，等过几天我们完全撤离了以后，也不算毫无所得…",
            "nextDialogs": [
              "732441729"
            ]
          },
          "732441729": {
            "id": "732441729",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "什么，原来你们也想来抢东西，怪不得，既没有货物也没看见那些「充能转化容器」。",
            "nextDialogs": [
              "732441730"
            ]
          },
          "732441730": {
            "id": "732441730",
            "speakerId": 20928,
            "speakerName": "愚人众交易人员",
            "text": "啊？「也」想来抢东西？"
          },
          "732441717": {
            "id": "732441717",
            "speakerId": 20928,
            "speakerName": "愚人众交易人员",
            "text": "…机密。",
            "nextDialogs": [
              "732441718"
            ]
          },
          "732441718": {
            "id": "732441718",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "……",
            "nextDialogs": [
              "732441719"
            ]
          },
          "732441719": {
            "id": "732441719",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "#你瞧，你惹{NICKNAME}生气啦！{M#他}{F#她}生气的后果很严重哦！",
            "nextDialogs": [
              "732441720"
            ]
          },
          "732441720": {
            "id": "732441720",
            "speakerId": 20928,
            "speakerName": "愚人众交易人员",
            "text": "唔…！好吧，好吧！请别生气，我说就是了！虽然…虽然我知道的也不多…",
            "nextDialogs": [
              "732441721"
            ]
          },
          "732441721": {
            "id": "732441721",
            "speakerId": 20928,
            "speakerName": "愚人众交易人员",
            "text": "我们的任务是调查沙漠住民各部落现状，以贸易的方式拉拢和渗透他们，吸引贤者注意…为须弥城内的执行官大人提供方便。",
            "nextDialogs": [
              "732441722"
            ]
          },
          "732441722": {
            "id": "732441722",
            "speakerId": 20928,
            "speakerName": "愚人众交易人员",
            "text": "另外…佛罗德洛克教授也在沙漠里寻找活体样本，他一向不服从「博士」大人的领导…要我说，这就是嫉妒…",
            "nextDialogs": [
              "732441723"
            ]
          },
          "732441723": {
            "id": "732441723",
            "speakerId": 20928,
            "speakerName": "愚人众交易人员",
            "text": "咳咳，扯多了、扯多了…总之，阿德菲是我们的联络人，我们的物资交易一直由他负责。"
          }
        }
      }
    },

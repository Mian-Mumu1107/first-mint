    {
      "subId": "7617001",
      "subQuestName": "前往「斯佩兰扎」",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "761700101"
        ],
        "dialogs": {
          "761700101": {
            "id": "761700101",
            "speakerId": 1000,
            "speakerName": "米科",
            "text": "没想到不光是月萤虫，就连小猫也会被吃掉！",
            "nextDialogs": [
              "761700102"
            ]
          },
          "761700102": {
            "id": "761700102",
            "speakerId": 1001,
            "speakerName": "玫熙",
            "text": "呜…尤尔瓦哥哥，下次带巴甫洛夫散步的时候，千万要保护好它呀。",
            "nextDialogs": [
              "761700174"
            ]
          },
          "761700174": {
            "id": "761700174",
            "speakerId": 1002,
            "speakerName": "尤尔瓦",
            "text": "别担心啦，巴甫洛夫可比普通的小猫大多了，而且不过是植物而已嘛，不会有事的。",
            "nextDialogs": [
              "761700103"
            ]
          },
          "761700103": {
            "id": "761700103",
            "speakerId": 1003,
            "speakerName": "莉奈娅",
            "text": "我记得哪个刚入行的新人冒险家在遇到十六倍曼陀草之前也说过类似的话呢。",
            "nextDialogs": [
              "761700104"
            ]
          },
          "761700104": {
            "id": "761700104",
            "speakerId": 1002,
            "speakerName": "尤尔瓦",
            "text": "欸…",
            "nextDialogs": [
              "761700105"
            ]
          },
          "761700105": {
            "id": "761700105",
            "speakerId": 1000,
            "speakerName": "米科",
            "text": "十六倍曼陀草…好酷！",
            "nextDialogs": [
              "761700106"
            ]
          },
          "761700106": {
            "id": "761700106",
            "speakerId": 1004,
            "speakerName": "露米",
            "text": "呀吼！",
            "nextDialogs": [
              "761700107"
            ]
          },
          "761700107": {
            "id": "761700107",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "远远就看到这边热闹的样子啦！你们在说什么有趣的…欸？是在上课吗？",
            "nextDialogs": [
              "761700108"
            ]
          },
          "761700108": {
            "id": "761700108",
            "speakerId": 1001,
            "speakerName": "玫熙",
            "text": "嗯，莉奈娅姐姐在给我们讲她最近的调查发现呢。",
            "nextDialogs": [
              "761700109"
            ]
          },
          "761700109": {
            "id": "761700109",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "听起来很有意思，我们也能参加吗？",
            "nextDialogs": [
              "761700110"
            ]
          },
          "761700110": {
            "id": "761700110",
            "speakerId": 1003,
            "speakerName": "莉奈娅",
            "text": "当然可以，请坐。",
            "nextDialogs": [
              "761700111"
            ]
          },
          "761700111": {
            "id": "761700111",
            "speakerId": 1003,
            "speakerName": "莉奈娅",
            "text": "既然说到了十六倍曼陀草，在虚海望，还有一种特色植物…",
            "nextDialogs": [
              "761700112"
            ]
          },
          "761700112": {
            "id": "761700112",
            "speakerId": 1002,
            "speakerName": "尤尔瓦",
            "text": "是冬凌草吧。",
            "nextDialogs": [
              "761700113"
            ]
          },
          "761700113": {
            "id": "761700113",
            "speakerId": 1003,
            "speakerName": "莉奈娅",
            "text": "嗯嗯！没错，就是冬凌草。",
            "nextDialogs": [
              "761700114"
            ]
          },
          "761700114": {
            "id": "761700114",
            "speakerId": 1000,
            "speakerName": "米科",
            "text": "欸——尤尔瓦哥哥作弊！莉奈娅还没问呢！",
            "nextDialogs": [
              "761700115"
            ]
          },
          "761700115": {
            "id": "761700115",
            "speakerId": 1002,
            "speakerName": "尤尔瓦",
            "text": "啊，抱歉抱歉，一不留神就抢答了。你别着急，后面还有回答的机会，对吧？",
            "nextDialogs": [
              "761700116"
            ]
          },
          "761700116": {
            "id": "761700116",
            "speakerId": 1003,
            "speakerName": "莉奈娅",
            "text": "我准备了好多问题呢！只要积极回答，就有机会拿到糖雕的奖励哦。",
            "nextDialogs": [
              "761700117"
            ]
          },
          "761700117": {
            "id": "761700117",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "#原来还有奖励！{NICKNAME}，那我们也要加油啦！",
            "nextDialogs": [
              "761700122",
              "761700120"
            ]
          },
          "761700122": {
            "id": "761700122",
            "speakerId": 1003,
            "speakerName": "莉奈娅",
            "text": "说回正题，关于冬凌草，其实有一个很有趣的故事呢。",
            "nextDialogs": [
              "761700123"
            ]
          },
          "761700123": {
            "id": "761700123",
            "speakerId": 1003,
            "speakerName": "莉奈娅",
            "text": "传说，冬凌草与「冬凌王」有关，而这位「冬凌王」有一位兄弟，他的象征植物是你们都很熟悉的…是什么呢？"
          },
          "761700120": {
            "id": "761700120",
            "speakerId": 1003,
            "speakerName": "莉奈娅",
            "text": "没关系的，偷偷告诉你们，卡嘉给每个人都准备了糖雕。",
            "nextDialogs": [
              "761700121"
            ]
          },
          "761700121": {
            "id": "761700121",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "哦！既然是这样，那我们可要拿出真本领了！"
          }
        }
      }
    },
    {
      "subId": "7617003",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "761700301"
        ],
        "dialogs": {
          "761700301": {
            "id": "761700301",
            "speakerId": 1003,
            "speakerName": "莉奈娅",
            "text": "其实也有传说认为宿影花不同颜色的花朵代表了霜月之子的一对姐妹…",
            "nextDialogs": [
              "761700302"
            ]
          },
          "761700302": {
            "id": "761700302",
            "speakerId": 1000,
            "speakerName": "米科",
            "text": "她们该不会也闹得你死我活的？我发现故事里的兄弟姐妹好多都这样，什么嘛，不如我们海螺帮。",
            "nextDialogs": [
              "761700303"
            ]
          },
          "761700303": {
            "id": "761700303",
            "speakerId": 1001,
            "speakerName": "玫熙",
            "text": "你让莉奈娅姐姐讲完嘛，那对姐妹最后一定和好了吧？",
            "nextDialogs": [
              "761700304"
            ]
          },
          "761700304": {
            "id": "761700304",
            "speakerId": 1001,
            "speakerName": "玫熙",
            "text": "不然就不会用两朵花贴在一起的宿影花来说她们了，对不对？我希望她们最后和好了…"
          }
        }
      }
    },
    {
      "subId": "7617004",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "761700401"
        ],
        "dialogs": {
          "761700401": {
            "id": "761700401",
            "speakerId": 1002,
            "speakerName": "尤尔瓦",
            "text": "莉奈娅平时东奔西走的，却还是不时抽空来和我们分享她的见闻…我也学到了很多，真的很感谢她。"
          }
        }
      }
    }
  ]
}
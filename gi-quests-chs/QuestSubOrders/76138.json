    {
      "subId": "7613801",
      "subQuestName": "与祖潘科对话",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "761380101"
        ],
        "dialogs": {
          "761380101": {
            "id": "761380101",
            "speakerId": 7046,
            "speakerName": "祖潘科",
            "text": "啊…奈芙尔老板！天哪，您来得正巧…",
            "nextDialogs": [
              "761380102"
            ]
          },
          "761380102": {
            "id": "761380102",
            "speakerId": 1316,
            "speakerName": "奈芙尔",
            "text": "下定决心了？",
            "nextDialogs": [
              "761380103"
            ]
          },
          "761380103": {
            "id": "761380103",
            "speakerId": 7046,
            "speakerName": "祖潘科",
            "text": "欸？下定…您、您说什么，难道…",
            "nextDialogs": [
              "761380104"
            ]
          },
          "761380104": {
            "id": "761380104",
            "speakerId": 1316,
            "speakerName": "奈芙尔",
            "text": "我知道，你一直想要去「霜月之子」那边拜访。",
            "nextDialogs": [
              "761380105"
            ]
          },
          "761380105": {
            "id": "761380105",
            "speakerId": 1316,
            "speakerName": "奈芙尔",
            "text": "所以，你希望先结识莉莉希，想要用这段友谊作为拜访「霜月之子」的敲门砖。",
            "nextDialogs": [
              "761380106"
            ]
          },
          "761380106": {
            "id": "761380106",
            "speakerId": 7046,
            "speakerName": "祖潘科",
            "text": "您…您都知道了，哎呀，我明明都把这事憋在心里，没怎么和人说呢…",
            "nextDialogs": [
              "761380107"
            ]
          },
          "761380107": {
            "id": "761380107",
            "speakerId": 1316,
            "speakerName": "奈芙尔",
            "text": "祖潘科先生，人在保守秘密时，也要学会隐瞒「正在保守秘密」这件事。",
            "nextDialogs": [
              "761380108"
            ]
          },
          "761380108": {
            "id": "761380108",
            "speakerId": 1316,
            "speakerName": "奈芙尔",
            "text": "不然的话，你在心里竖起的那道墙，迟早会开始漏风。",
            "nextDialogs": [
              "761380109"
            ]
          },
          "761380109": {
            "id": "761380109",
            "speakerId": 7046,
            "speakerName": "祖潘科",
            "text": "唉，我在家乡的时候，就不怎么会隐瞒心思…",
            "nextDialogs": [
              "761380110"
            ]
          },
          "761380110": {
            "id": "761380110",
            "speakerId": 7046,
            "speakerName": "祖潘科",
            "text": "算了，既然您都知道了，那您能帮我引荐一下吗？我是外乡人，贸然去打扰莉莉希小姐…",
            "nextDialogs": [
              "761380111"
            ]
          },
          "761380111": {
            "id": "761380111",
            "speakerId": 1316,
            "speakerName": "奈芙尔",
            "text": "她们「霜月之子」的人都好心得很，别说来访者是外乡人，就算不是人，也会温柔地接待。",
            "nextDialogs": [
              "761380112"
            ]
          },
          "761380112": {
            "id": "761380112",
            "speakerId": 7046,
            "speakerName": "祖潘科",
            "text": "啊？真的假的…",
            "nextDialogs": [
              "761380113"
            ]
          },
          "761380113": {
            "id": "761380113",
            "speakerId": 7046,
            "speakerName": "祖潘科",
            "text": "但无论如何，贸然打搅总是不太礼貌，还是请奈芙尔老板代为引荐一下吧。",
            "nextDialogs": [
              "761380114"
            ]
          },
          "761380114": {
            "id": "761380114",
            "speakerId": 1316,
            "speakerName": "奈芙尔",
            "text": "好，现在她们应该刚好发放完了餐食，是一个不错的聊天时机，我们走吧。",
            "nextDialogs": [
              "761380115"
            ]
          },
          "761380115": {
            "id": "761380115",
            "speakerId": 1316,
            "speakerName": "奈芙尔",
            "text": "啊…这一次就不用收费了，我只是恰巧路过。",
            "nextDialogs": [
              "761380116"
            ]
          },
          "761380116": {
            "id": "761380116",
            "speakerId": 7046,
            "speakerName": "祖潘科",
            "text": "谢谢您，奈芙尔老板！我这就去收拾东西…"
          }
        }
      }
    },
    {
      "subId": "7613802",
      "subQuestName": "陪同祖潘科前去与莉莉希对话",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "761380201"
        ],
        "dialogs": {
          "761380201": {
            "id": "761380201",
            "speakerId": 7058,
            "speakerName": "莉莉希",
            "text": "奈芙尔老板？还有…祖潘科先生，请问您有什么事么？",
            "nextDialogs": [
              "761380202"
            ]
          },
          "761380202": {
            "id": "761380202",
            "speakerId": 1316,
            "speakerName": "奈芙尔",
            "text": "我们的这位纳塔客人，似乎想要拜访「霜月之子」。",
            "nextDialogs": [
              "761380203"
            ]
          },
          "761380203": {
            "id": "761380203",
            "speakerId": 1316,
            "speakerName": "奈芙尔",
            "text": "但出于某些…礼节性的考虑，他还是希望找一个人，为他引荐一下。请吧，祖潘科先生。",
            "nextDialogs": [
              "761380204"
            ]
          },
          "761380204": {
            "id": "761380204",
            "speakerId": 7046,
            "speakerName": "祖潘科",
            "text": "您好，莉莉希小姐！很高兴见到您，呃…这是我从纳塔带来的…化石标本！",
            "nextDialogs": [
              "761380205"
            ]
          },
          "761380205": {
            "id": "761380205",
            "speakerId": 7058,
            "speakerName": "莉莉希",
            "text": "谢谢您，可…祖潘科先生，我早就认识您了呀，您真的不用这么客气的。",
            "nextDialogs": [
              "761380206"
            ]
          },
          "761380206": {
            "id": "761380206",
            "speakerId": 7046,
            "speakerName": "祖潘科",
            "text": "啊？您又是怎么发现我的？",
            "nextDialogs": [
              "761380207"
            ]
          },
          "761380207": {
            "id": "761380207",
            "speakerId": 7058,
            "speakerName": "莉莉希",
            "text": "我之前发放餐食的时候，您不是在旁边看吗？转悠来，转悠去，但就是不站进队里。",
            "nextDialogs": [
              "761380208"
            ]
          },
          "761380208": {
            "id": "761380208",
            "speakerId": 7058,
            "speakerName": "莉莉希",
            "text": "我还以为您也想拿，但又不好意思上前，所以还特意悄悄留了一份给您了。",
            "nextDialogs": [
              "761380209"
            ]
          },
          "761380209": {
            "id": "761380209",
            "speakerId": 7058,
            "speakerName": "莉莉希",
            "text": "但…您从来也没来拿过餐。要是您今天不来，我也要拜托人去问问您，有什么需要帮助的了。",
            "nextDialogs": [
              "761380210"
            ]
          },
          "761380210": {
            "id": "761380210",
            "speakerId": 7046,
            "speakerName": "祖潘科",
            "text": "这…这…真是抱歉，我是在犹豫，到底怎么打招呼呢…",
            "nextDialogs": [
              "761380211"
            ]
          },
          "761380211": {
            "id": "761380211",
            "speakerId": 7046,
            "speakerName": "祖潘科",
            "text": "所以，莉莉希小姐，我能去「霜月之子」看看么？",
            "nextDialogs": [
              "761380212"
            ]
          },
          "761380212": {
            "id": "761380212",
            "speakerId": 7058,
            "speakerName": "莉莉希",
            "text": "可以呀，我们「霜月之子」里本来也有几位外来的客人。但您要去做什么？",
            "nextDialogs": [
              "761380213"
            ]
          },
          "761380213": {
            "id": "761380213",
            "speakerId": 7046,
            "speakerName": "祖潘科",
            "text": "留个影，查查资料，如果可能的话…再找人询问一下传说故事！",
            "nextDialogs": [
              "761380214"
            ]
          },
          "761380214": {
            "id": "761380214",
            "speakerId": 7046,
            "speakerName": "祖潘科",
            "text": "我是纳塔「龙遗物研究协会」的成员，如果能搜集到一些和我的研究方向有关的资料，那就最好了！",
            "nextDialogs": [
              "761380215"
            ]
          },
          "761380215": {
            "id": "761380215",
            "speakerId": 7058,
            "speakerName": "莉莉希",
            "text": "喔…那你就是要去看书喽？我想想啊…",
            "nextDialogs": [
              "761380216"
            ]
          },
          "761380216": {
            "id": "761380216",
            "speakerId": 1316,
            "speakerName": "奈芙尔",
            "text": "既然二位已经顺利地结识，那这次的委托，就算是完成了，我也该离开了。",
            "nextDialogs": [
              "761380217"
            ]
          },
          "761380217": {
            "id": "761380217",
            "speakerId": 7046,
            "speakerName": "祖潘科",
            "text": "谢谢你，奈芙尔老板！那个…费用我还是会付给您的，怎么能让您白跑一趟呢。",
            "nextDialogs": [
              "761380218"
            ]
          },
          "761380218": {
            "id": "761380218",
            "speakerId": 1316,
            "speakerName": "奈芙尔",
            "text": "随您的方便，祖潘科先生。",
            "nextDialogs": [
              "761380219"
            ]
          },
          "761380219": {
            "id": "761380219",
            "speakerId": 1316,
            "speakerName": "奈芙尔",
            "text": "那么，我就先告辞了，祝二位聊得愉快。"
          }
        }
      }
    }
  ]
}
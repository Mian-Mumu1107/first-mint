  },
  "subQuests": [
    {
      "subId": "7515601",
      "subQuestName": "（test）隐藏杀怪$HIDDEN",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "751560101"
        ],
        "dialogs": {
          "751560101": {
            "id": "751560101",
            "speakerId": 1000,
            "speakerName": "科奴拉芙",
            "text": "呜呜，终于能从这个运龙车里出来了。",
            "nextDialogs": [
              "751560102"
            ]
          },
          "751560102": {
            "id": "751560102",
            "speakerId": 1000,
            "speakerName": "科奴拉芙",
            "text": "哎呀，这个运龙车实在是又闷又热，还一股臭味，只是坐进去这么小半天的功夫，就感觉折了两三年的寿啦…",
            "nextDialogs": [
              "751560103"
            ]
          },
          "751560103": {
            "id": "751560103",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "是你？这次又是怎么回事？",
            "nextDialogs": [
              "751560104"
            ]
          },
          "751560104": {
            "id": "751560104",
            "speakerId": 1000,
            "speakerName": "科奴拉芙",
            "text": "哎呀，原来是您呀，恩人，在旅途中我们居然再次又碰见…不，是又被您救了一次啊。",
            "nextDialogs": [
              "751560105"
            ]
          },
          "751560105": {
            "id": "751560105",
            "speakerId": 1000,
            "speakerName": "科奴拉芙",
            "text": "哎呀恩人啊，上次我不是说过，我的名字叫科奴拉芙，是「烟谜主」的实习祭司…",
            "nextDialogs": [
              "751560106"
            ]
          },
          "751560106": {
            "id": "751560106",
            "speakerId": 1000,
            "speakerName": "科奴拉芙",
            "text": "现在正在祭司的修行途中，嗯…部族的长辈告诉我，纳塔各地都留有先祖的宝藏，「去寻找宝藏吧，科奴拉芙！」",
            "nextDialogs": [
              "751560107"
            ]
          },
          "751560107": {
            "id": "751560107",
            "speakerId": 1000,
            "speakerName": "科奴拉芙",
            "text": "于是就以进行修行为名把我一脚踢出了部族的大门——",
            "nextDialogs": [
              "751560108"
            ]
          },
          "751560108": {
            "id": "751560108",
            "speakerId": 1000,
            "speakerName": "科奴拉芙",
            "text": "哎呀，我动用灵巧的耳朵，探听到了这附近有宝藏的线索…说是跟着什么兽的步伐就可以找到宝藏。",
            "nextDialogs": [
              "751560109"
            ]
          },
          "751560109": {
            "id": "751560109",
            "speakerId": 1000,
            "speakerName": "科奴拉芙",
            "text": "那不就是在说驮兽嘛！大概是驮兽吧…难不成还是绵驮兽？",
            "nextDialogs": [
              "751560110"
            ]
          },
          "751560110": {
            "id": "751560110",
            "speakerId": 1000,
            "speakerName": "科奴拉芙",
            "text": "总之，恩人啊…我跟踪了一只驮兽，结果跟到了这些人的营地里，以为我是偷驮兽的贼，当场关了起来…",
            "nextDialogs": [
              "751560111"
            ]
          },
          "751560111": {
            "id": "751560111",
            "speakerId": 1000,
            "speakerName": "科奴拉芙",
            "text": "埋藏的宝藏没有找到，自己差点就要被埋藏起来了呀…",
            "nextDialogs": [
              "751560112"
            ]
          },
          "751560112": {
            "id": "751560112",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "线索信息都不全…",
            "nextDialogs": [
              "751560113"
            ]
          },
          "751560113": {
            "id": "751560113",
            "speakerId": 1000,
            "speakerName": "科奴拉芙",
            "text": "您说的对，下次小女子我啊，不会再贸然行事了…或许这就是被关起来这件事得到的最好的宝藏——一个教训。",
            "nextDialogs": [
              "751560114"
            ]
          },
          "751560114": {
            "id": "751560114",
            "speakerId": 1000,
            "speakerName": "科奴拉芙",
            "text": "哎，这浑身的味儿，得找个地方好好洗个澡才行。",
            "nextDialogs": [
              "751560115"
            ]
          },
          "751560115": {
            "id": "751560115",
            "speakerId": 1000,
            "speakerName": "科奴拉芙",
            "text": "这次多谢恩人了，哎呀，为表感谢，小女子就从不是很多的盘缠里分出一些当做谢礼吧…"
          }
        }
      }
    },

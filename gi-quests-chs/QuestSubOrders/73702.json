  "subQuests": [
    {
      "subId": "7370201",
      "subQuestName": "与祖尔宛对话",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "737020101"
        ],
        "dialogs": {
          "737020101": {
            "id": "737020101",
            "speakerId": 1000,
            "speakerName": "祖尔宛",
            "text": "与上次相见时相比，表情开朗了许多嘛。看来训练进行得很顺利？",
            "nextDialogs": [
              "737020102"
            ]
          },
          "737020102": {
            "id": "737020102",
            "speakerId": 1001,
            "speakerName": "斯露莎",
            "text": "嗯，经过这几段反思我已经获得了成长。如果是现在的话…",
            "nextDialogs": [
              "737020103"
            ]
          },
          "737020103": {
            "id": "737020103",
            "speakerId": 1000,
            "speakerName": "祖尔宛",
            "text": "就可以算得上是称职的花灵勇者了？",
            "nextDialogs": [
              "737020104"
            ]
          },
          "737020104": {
            "id": "737020104",
            "speakerId": 1001,
            "speakerName": "斯露莎",
            "text": "还…还没有，毕竟还有最后的训练没有完成。",
            "nextDialogs": [
              "737020105"
            ]
          },
          "737020105": {
            "id": "737020105",
            "speakerId": 1001,
            "speakerName": "斯露莎",
            "text": "直到所有的任务完成，并且最终获得前辈的认可之后，「双角的花冠」才真正属于我…",
            "nextDialogs": [
              "737020106"
            ]
          },
          "737020106": {
            "id": "737020106",
            "speakerId": 1000,
            "speakerName": "祖尔宛",
            "text": "哦？看来之前说已经脱离了叛逆期，的确不假。",
            "nextDialogs": [
              "737020107"
            ]
          },
          "737020107": {
            "id": "737020107",
            "speakerId": 1001,
            "speakerName": "斯露莎",
            "text": "前、前辈怎么还记得这个？快忘了吧！",
            "nextDialogs": [
              "737020108"
            ]
          },
          "737020108": {
            "id": "737020108",
            "speakerId": 1000,
            "speakerName": "祖尔宛",
            "text": "呵呵，不管怎么说，看你恢复精神了就好。",
            "nextDialogs": [
              "737020109"
            ]
          },
          "737020109": {
            "id": "737020109",
            "speakerId": 1000,
            "speakerName": "祖尔宛",
            "text": "#{NICKNAME}和派蒙，斯露莎究竟是否配得上「双角的花冠」，也请两位见证到最后吧。",
            "nextDialogs": [
              "737020110"
            ]
          },
          "737020110": {
            "id": "737020110",
            "speakerId": 1000,
            "speakerName": "祖尔宛",
            "text": "我会在终点处等候，那就稍后再见了。"
          }
        }
      }
    },

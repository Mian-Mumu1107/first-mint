    {
      "subId": "7370206",
      "subQuestName": "与斯露莎对话",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "737020601"
        ],
        "dialogs": {
          "737020601": {
            "id": "737020601",
            "speakerId": 1001,
            "speakerName": "斯露莎",
            "text": "荼泥黑渊…这里就是灾厄的中心了。虽然一切都静止了…",
            "nextDialogs": [
              "737020602"
            ]
          },
          "737020602": {
            "id": "737020602",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "不难想象当时的景况。",
            "nextDialogs": [
              "737020603"
            ]
          },
          "737020603": {
            "id": "737020603",
            "speakerId": 1002,
            "speakerName": "派蒙",
            "text": "周围这些巨大的结晶…比沙虫还要大上很多倍呢！想到之后要由斯露莎来解决这里的大麻烦…",
            "nextDialogs": [
              "737020604"
            ]
          },
          "737020604": {
            "id": "737020604",
            "speakerId": 1000,
            "speakerName": "祖尔宛",
            "text": "这不正是花灵勇者所最应当承担的责任吗？而且，也是斯露莎自己所期望的。",
            "nextDialogs": [
              "737020605"
            ]
          },
          "737020605": {
            "id": "737020605",
            "speakerId": 1002,
            "speakerName": "派蒙",
            "text": "话是这么说…",
            "nextDialogs": [
              "737020606"
            ]
          },
          "737020606": {
            "id": "737020606",
            "speakerId": 1001,
            "speakerName": "斯露莎",
            "text": "难道是信不过我？哼，没想到事到如今还会被区区白飘飘看扁。",
            "nextDialogs": [
              "737020607"
            ]
          },
          "737020607": {
            "id": "737020607",
            "speakerId": 1002,
            "speakerName": "派蒙",
            "text": "哇，感觉之前那个嚣张的斯露莎又回来了！",
            "nextDialogs": [
              "737020608"
            ]
          },
          "737020608": {
            "id": "737020608",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "也不知道是好事还是坏事。",
            "nextDialogs": [
              "737020609"
            ]
          },
          "737020609": {
            "id": "737020609",
            "speakerId": 1001,
            "speakerName": "斯露莎",
            "text": "唔…经过这阵子的相处，「谒颂主」和白飘飘还是对我有所怀疑吗？我这可不是什么没来由的盲目嚣张啊。",
            "nextDialogs": [
              "737020610"
            ]
          },
          "737020610": {
            "id": "737020610",
            "speakerId": 1001,
            "speakerName": "斯露莎",
            "text": "哼哼，要知道，我已经完全理解了自己过去的失误。",
            "nextDialogs": [
              "737020611"
            ]
          },
          "737020611": {
            "id": "737020611",
            "speakerId": 1001,
            "speakerName": "斯露莎",
            "text": "过去我一度将声名看得比行动本身更重要，但现在我知道了，这是舍本逐末的行为。",
            "nextDialogs": [
              "737020612"
            ]
          },
          "737020612": {
            "id": "737020612",
            "speakerId": 1001,
            "speakerName": "斯露莎",
            "text": "就像「西摩格」是因为它的牺牲而成为神鸟，我也将会因为我所行之事而被当作花灵勇者，为人所称颂传唱。",
            "nextDialogs": [
              "737020613"
            ]
          },
          "737020613": {
            "id": "737020613",
            "speakerId": 1001,
            "speakerName": "斯露莎",
            "text": "而且，我也完成了前辈指定的全部训练，这下就算是前辈也该承认我的确是个称职的勇者，的确配得上「双角的花冠」了。",
            "nextDialogs": [
              "737020614"
            ]
          },
          "737020614": {
            "id": "737020614",
            "speakerId": 1000,
            "speakerName": "祖尔宛",
            "text": "我当然对灵光的选择没有异议。",
            "nextDialogs": [
              "737020615"
            ]
          },
          "737020615": {
            "id": "737020615",
            "speakerId": 1001,
            "speakerName": "斯露莎",
            "text": "…欸？",
            "nextDialogs": [
              "737020616"
            ]
          },
          "737020616": {
            "id": "737020616",
            "speakerId": 1000,
            "speakerName": "祖尔宛",
            "text": "怎么？这时候我该提出反对意见吗？",
            "nextDialogs": [
              "737020617"
            ]
          },
          "737020617": {
            "id": "737020617",
            "speakerId": 1001,
            "speakerName": "斯露莎",
            "text": "不…只是…只是我没想到前辈居然会这样爽快地认可…",
            "nextDialogs": [
              "737020618"
            ]
          },
          "737020618": {
            "id": "737020618",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "还以为至少会刁难两句。",
            "nextDialogs": [
              "737020619"
            ]
          },
          "737020619": {
            "id": "737020619",
            "speakerId": 1000,
            "speakerName": "祖尔宛",
            "text": "啊呀，我可不是什么坏心眼的长者。",
            "nextDialogs": [
              "737020620"
            ]
          },
          "737020620": {
            "id": "737020620",
            "speakerId": 1001,
            "speakerName": "斯露莎",
            "text": "对了，关于勇者的职责…我并没有从花冠得到有关的知识…",
            "nextDialogs": [
              "737020621"
            ]
          },
          "737020621": {
            "id": "737020621",
            "speakerId": 1001,
            "speakerName": "斯露莎",
            "text": "是因为我作为勇者还是不完全的吗？难道说还需要经过什么其他的训练…",
            "nextDialogs": [
              "737020622"
            ]
          },
          "737020622": {
            "id": "737020622",
            "speakerId": 1000,
            "speakerName": "祖尔宛",
            "text": "这个嘛…虽然勇者的称号的确是花灵传承的一部份，具体的职责却是随时代改变的。",
            "nextDialogs": [
              "737020623"
            ]
          },
          "737020623": {
            "id": "737020623",
            "speakerId": 1001,
            "speakerName": "斯露莎",
            "text": "嗯嗯。",
            "nextDialogs": [
              "737020624"
            ]
          },
          "737020624": {
            "id": "737020624",
            "speakerId": 1000,
            "speakerName": "祖尔宛",
            "text": "简单来说，就是没有具体要做哪些事的规定，也没有什么是否合格的评判标准。通常来说，灵光的选择就代表了最终的结果。",
            "nextDialogs": [
              "737020625"
            ]
          },
          "737020625": {
            "id": "737020625",
            "speakerId": 1001,
            "speakerName": "斯露莎",
            "text": "欸？也就是说…",
            "nextDialogs": [
              "737020626"
            ]
          },
          "737020626": {
            "id": "737020626",
            "speakerId": 1000,
            "speakerName": "祖尔宛",
            "text": "我是不会没收「双角的花冠」的。",
            "nextDialogs": [
              "737020628",
              "737020630"
            ]
          },
          "737020628": {
            "id": "737020628",
            "speakerId": 1002,
            "speakerName": "派蒙",
            "text": "重点不在这里吧！",
            "nextDialogs": [
              "737020633"
            ]
          },
          "737020633": {
            "id": "737020633",
            "speakerId": 1001,
            "speakerName": "斯露莎",
            "text": "我知道了！这一定也是考验的一环。",
            "nextDialogs": [
              "737020634"
            ]
          },
          "737020634": {
            "id": "737020634",
            "speakerId": 1002,
            "speakerName": "派蒙",
            "text": "斯露莎好像明白了什么？",
            "nextDialogs": [
              "737020635"
            ]
          },
          "737020635": {
            "id": "737020635",
            "speakerId": 1001,
            "speakerName": "斯露莎",
            "text": "白飘飘可真是健忘呀，我刚刚还说过呢！经过这些训练，除了磨练行动力和洞察力，最重要的是我理解了自己过去的错误。",
            "nextDialogs": [
              "737020636"
            ]
          },
          "737020636": {
            "id": "737020636",
            "speakerId": 1001,
            "speakerName": "斯露莎",
            "text": "如果因为结果其实不会改变而轻忽训练的过程，那不就重蹈覆辙了吗？所以，这一定是前辈留给我的最后的考验。",
            "nextDialogs": [
              "737020637"
            ]
          },
          "737020637": {
            "id": "737020637",
            "speakerId": 1001,
            "speakerName": "斯露莎",
            "text": "对于名副其实的花灵勇者来说，当然是不在话下了。这可是前辈充分信赖我的表现啊。",
            "nextDialogs": [
              "737020638"
            ]
          },
          "737020638": {
            "id": "737020638",
            "speakerId": 1000,
            "speakerName": "祖尔宛",
            "text": "真没想到居然被斯露莎给看穿了，不愧是灵光选中的花灵。",
            "nextDialogs": [
              "737020639"
            ]
          },
          "737020639": {
            "id": "737020639",
            "speakerId": 1000,
            "speakerName": "祖尔宛",
            "text": "#不过斯露莎能有这样的改变，或许也多亏了{NICKNAME}和派蒙两位吧。",
            "nextDialogs": [
              "737020640"
            ]
          },
          "737020640": {
            "id": "737020640",
            "speakerId": 1001,
            "speakerName": "斯露莎",
            "text": "#嗯！吾之「谒颂主」和{M#他}{F#她}的同伴白飘飘，的确是可塑之才。",
            "nextDialogs": [
              "737020641"
            ]
          },
          "737020641": {
            "id": "737020641",
            "speakerId": 1001,
            "speakerName": "斯露莎",
            "text": "#虽然想说有我自己就绰绰有余了…不过，相信有{M#他们}{F#她们}的帮助，熄灭「焚真之天象」也不是什么难事了吧。",
            "nextDialogs": [
              "737020642"
            ]
          },
          "737020642": {
            "id": "737020642",
            "speakerId": 1000,
            "speakerName": "祖尔宛",
            "text": "那真是太可靠了。别忘了，米希尔和拉沙鲁也会协助你们的。",
            "nextDialogs": [
              "737020643"
            ]
          },
          "737020643": {
            "id": "737020643",
            "speakerId": 1001,
            "speakerName": "斯露莎",
            "text": "前辈就放心交给我好了！",
            "nextDialogs": [
              "737020644"
            ]
          },
          "737020644": {
            "id": "737020644",
            "speakerId": 1002,
            "speakerName": "派蒙",
            "text": "总觉得这一切都是祖尔宛的安排…不过看斯露莎的开心的样子，也许这样也挺好的？"
          },
          "737020630": {
            "id": "737020630",
            "speakerId": 1002,
            "speakerName": "派蒙",
            "text": "对啊，祖尔宛自己也说了，灵光的选择就代表最终的结果。即使是祖尔宛也不能轻易修改这个结果吧？",
            "nextDialogs": [
              "737020631"
            ]
          },
          "737020631": {
            "id": "737020631",
            "speakerId": 1000,
            "speakerName": "祖尔宛",
            "text": "呵呵…真的不行吗？",
            "nextDialogs": [
              "737020632"
            ]
          },
          "737020632": {
            "id": "737020632",
            "speakerId": 1002,
            "speakerName": "派蒙",
            "text": "呜…有点可怕…"
          }
        }
      }
    },

    {
      "subId": "7621202",
      "subQuestName": "(test)隐藏$HIDDEN",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "762120301"
        ],
        "dialogs": {
          "762120301": {
            "id": "762120301",
            "speakerId": 1000,
            "speakerName": "Black Screen",
            "text": "你们在一旁的书架高处停了下来…",
            "nextDialogs": [
              "762120304"
            ]
          },
          "762120304": {
            "id": "762120304",
            "speakerId": 7738,
            "speakerName": "葵娅乌赫奎扎尔",
            "text": "这里，很安全。金色的朋友，有什么事？",
            "nextDialogs": [
              "762120308",
              "762120307"
            ]
          },
          "762120308": {
            "id": "762120308",
            "speakerId": 7738,
            "speakerName": "葵娅乌赫奎扎尔",
            "text": "这里，木架很高，视野开阔，是藏身的好地方。",
            "nextDialogs": [
              "762120309"
            ]
          },
          "762120309": {
            "id": "762120309",
            "speakerId": 7738,
            "speakerName": "葵娅乌赫奎扎尔",
            "text": "在我的大{RUBY#[D]部族}屋，待在地面上，是危险的。即便我们头顶上的大主{RUBY#[S]至高领主}宰不会一时兴起杀死我们，其他大{RUBY#[D]部族}屋的掠夺者们，也会来抢劫我们。",
            "nextDialogs": [
              "762120310"
            ]
          },
          "762120310": {
            "id": "762120310",
            "speakerId": 7738,
            "speakerName": "葵娅乌赫奎扎尔",
            "text": "只有像绿咬鹃一样，栖息在悬崖和树冠上，才能在灾祸到来前，逃走，幸存。",
            "nextDialogs": [
              "762120311"
            ]
          },
          "762120311": {
            "id": "762120311",
            "speakerId": 7738,
            "speakerName": "葵娅乌赫奎扎尔",
            "text": "而且，薇恩狄娅说，她想看我飞。因为，她想歌{RUBY#[D]写作}唱，骑着巨鸟，冒险的故事。",
            "nextDialogs": [
              "762120312"
            ]
          },
          "762120312": {
            "id": "762120312",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "真的不是被她骗了吗…",
            "nextDialogs": [
              "762120313"
            ]
          },
          "762120313": {
            "id": "762120313",
            "speakerId": 7738,
            "speakerName": "葵娅乌赫奎扎尔",
            "text": "不是的。薇恩狄娅是很好很好的人。也许就像十字路的主人一样好。都很温柔。",
            "nextDialogs": [
              "762120314"
            ]
          },
          "762120314": {
            "id": "762120314",
            "speakerId": 7738,
            "speakerName": "葵娅乌赫奎扎尔",
            "text": "不过，你们，飞得很高。很厉害。",
            "nextDialogs": [
              "762120315"
            ]
          },
          "762120315": {
            "id": "762120315",
            "speakerId": 7738,
            "speakerName": "葵娅乌赫奎扎尔",
            "text": "这个，送给你们，是朋友的证明。我要想想，怎么才能飞得更高，不会被追上。",
            "nextDialogs": [
              "762120316"
            ]
          },
          "762120316": {
            "id": "762120316",
            "speakerId": 7738,
            "speakerName": "葵娅乌赫奎扎尔",
            "text": "虽然这里，没有那些高贵的大主{RUBY#[S]至高领主}宰，也没有喜欢剥皮的征服者。很安全，不过，我习惯了找好退路。"
          },
          "762120307": {
            "id": "762120307",
            "speakerId": 7738,
            "speakerName": "葵娅乌赫奎扎尔",
            "text": "谢谢你。但是，没有被困。高的地方，很安全，不会被杀死。"
          }
        }
      }
    }
  ]
}
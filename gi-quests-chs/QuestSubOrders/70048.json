  },
  "subQuests": [
    {
      "subId": "7004801",
      "subQuestName": "(test)隐藏$HIDDEN",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "700480101"
        ],
        "dialogs": {
          "700480101": {
            "id": "700480101",
            "speakerId": 1000,
            "speakerName": "菲米尼",
            "text": "#是{NICKNAME}，抱歉，我才发现你也在这里。",
            "nextDialogs": [
              "700480102"
            ]
          },
          "700480102": {
            "id": "700480102",
            "speakerId": 1000,
            "speakerName": "菲米尼",
            "text": "这个度假村很大，不认识的人很多，幸好遇到你了。",
            "nextDialogs": [
              "700480103"
            ]
          },
          "700480103": {
            "id": "700480103",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "菲米尼在做什么？",
            "nextDialogs": [
              "700480104"
            ]
          },
          "700480104": {
            "id": "700480104",
            "speakerId": 1000,
            "speakerName": "菲米尼",
            "text": "我在看纳塔的海，这里有些我不认识的水生动物，比方说我们旁边的那两只。",
            "nextDialogs": [
              "700480109",
              "700480107"
            ]
          },
          "700480109": {
            "id": "700480109",
            "speakerId": 1000,
            "speakerName": "菲米尼",
            "text": "纳塔的生态和枫丹区别真大，感觉很特别，要是「家」里的所有人都能看到就好了。",
            "nextDialogs": [
              "700480110"
            ]
          },
          "700480110": {
            "id": "700480110",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "我们来给度假村留影吧。",
            "nextDialogs": [
              "700480111"
            ]
          },
          "700480111": {
            "id": "700480111",
            "speakerId": 1000,
            "speakerName": "菲米尼",
            "text": "好啊，这样就能把看到的景色记录下来，不怕忘记了。",
            "nextDialogs": [
              "700480112"
            ]
          },
          "700480112": {
            "id": "700480112",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "顺便给菲米尼也拍一张。",
            "nextDialogs": [
              "700480113"
            ]
          },
          "700480113": {
            "id": "700480113",
            "speakerId": 1000,
            "speakerName": "菲米尼",
            "text": "给我吗？我也要拍啊…",
            "nextDialogs": [
              "700480114"
            ]
          },
          "700480114": {
            "id": "700480114",
            "speakerId": 1000,
            "speakerName": "菲米尼",
            "text": "不好意思，我不是想要拒绝你的意思，只是不太习惯站在镜头前。",
            "nextDialogs": [
              "700480115"
            ]
          },
          "700480115": {
            "id": "700480115",
            "speakerId": 1000,
            "speakerName": "菲米尼",
            "text": "「父亲」说过，总是把自己藏起来的话，可能会让关心自己的人担忧。",
            "nextDialogs": [
              "700480116"
            ]
          },
          "700480116": {
            "id": "700480116",
            "speakerId": 1000,
            "speakerName": "菲米尼",
            "text": "我会努力克服这个坏习惯的。既然你说想给我留影，那我们就试试。",
            "nextDialogs": [
              "700480117"
            ]
          },
          "700480117": {
            "id": "700480117",
            "speakerId": 1000,
            "speakerName": "菲米尼",
            "text": "我想想，你对入镜的姿势有想法吗？"
          },
          "700480107": {
            "id": "700480107",
            "speakerId": 1000,
            "speakerName": "菲米尼",
            "text": "最高审判官大人吗…他们长得好不同，居然是亲戚。",
            "nextDialogs": [
              "700480108"
            ]
          },
          "700480108": {
            "id": "700480108",
            "speakerId": 1000,
            "speakerName": "菲米尼",
            "text": "难道说同样的生物，在枫丹长大和在纳塔长大，就会发育成不同的样子？"
          }
        }
      }
    }
  ]
}
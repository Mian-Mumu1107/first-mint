    {
      "subId": "7307006",
      "subQuestName": "与兰罗摩、兰修提袈对话",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "730700601"
        ],
        "dialogs": {
          "730700601": {
            "id": "730700601",
            "speakerId": 20666,
            "speakerName": "兰修提袈",
            "text": "「来呀，来呀，苗圃的梦想，树叶的记忆…」",
            "nextDialogs": [
              "730700602"
            ]
          },
          "730700602": {
            "id": "730700602",
            "speakerId": 20646,
            "speakerName": "兰罗摩",
            "text": "「看，宝石一般的石榴，余晖色的日落果…」",
            "nextDialogs": [
              "730700603"
            ]
          },
          "730700603": {
            "id": "730700603",
            "speakerId": 20646,
            "speakerName": "兰罗摩",
            "text": "原来如此，兰纳迦他们的歌，和兰玛哈的歌是同源的…",
            "nextDialogs": [
              "730700604"
            ]
          },
          "730700604": {
            "id": "730700604",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "同源是指…？",
            "nextDialogs": [
              "730700605"
            ]
          },
          "730700605": {
            "id": "730700605",
            "speakerId": 20666,
            "speakerName": "兰修提袈",
            "text": "歌就像河川一样。他们一开始，都在一起，那就是「源之歌」，她是所有歌的故乡、大河的源头。",
            "nextDialogs": [
              "730700606"
            ]
          },
          "730700606": {
            "id": "730700606",
            "speakerId": 20666,
            "speakerName": "兰修提袈",
            "text": "后来，又因为不同的记忆、不同的故事，所以唱出来以后，发生变化。就像河流变成小溪。",
            "nextDialogs": [
              "730700607"
            ]
          },
          "730700607": {
            "id": "730700607",
            "speakerId": 20666,
            "speakerName": "兰修提袈",
            "text": "但所有的小溪都会流入大海，所有的歌最终也会汇聚成同一首，回归成源之歌。",
            "nextDialogs": [
              "730700608"
            ]
          },
          "730700608": {
            "id": "730700608",
            "speakerId": 20666,
            "speakerName": "兰修提袈",
            "text": "#所以，采歌的兰那罗，要找到所有的歌。这样的话，就能找到源之歌。谢谢你，那菈{NICKNAME}、派蒙，找到了兰玛哈的歌。",
            "nextDialogs": [
              "730700610"
            ]
          },
          "730700610": {
            "id": "730700610",
            "speakerId": 20666,
            "speakerName": "兰修提袈",
            "text": "#谢谢那菈{NICKNAME}！",
            "nextDialogs": [
              "730700611"
            ]
          },
          "730700611": {
            "id": "730700611",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "嗯…歌一直会变多，还会改变，那要怎样才能找到所有的歌呀？",
            "nextDialogs": [
              "730700613"
            ]
          },
          "730700613": {
            "id": "730700613",
            "speakerId": 20666,
            "speakerName": "兰修提袈",
            "text": "兰那罗也会增加。所以，只要一直努力，一定没问题的！",
            "nextDialogs": [
              "730700614"
            ]
          },
          "730700614": {
            "id": "730700614",
            "speakerId": 20646,
            "speakerName": "兰罗摩",
            "text": "兰玛哈的歌，能够吸引健壮的草种子。他的觉树之堂，应该也是这样封印的。",
            "nextDialogs": [
              "730700615"
            ]
          },
          "730700615": {
            "id": "730700615",
            "speakerId": 20646,
            "speakerName": "兰罗摩",
            "text": "#既然那菈{NICKNAME}找到了他的歌，我们就能到觉树之堂了！",
            "nextDialogs": [
              "730700616"
            ]
          },
          "730700616": {
            "id": "730700616",
            "speakerId": 20666,
            "speakerName": "兰修提袈",
            "text": "#嗯！祝你们好运，那菈{NICKNAME}、派蒙，还有兰罗摩！我先去为无忧节做准备啦！",
            "nextDialogs": [
              "730700617"
            ]
          },
          "730700617": {
            "id": "730700617",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "交给我们吧！无忧节再见，兰修提袈！",
            "nextDialogs": [
              "730700618"
            ]
          },
          "730700618": {
            "id": "730700618",
            "speakerId": 20666,
            "speakerName": "兰修提袈",
            "text": "再见！"
          }
        }
      }
    },

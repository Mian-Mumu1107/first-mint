    {
      "subId": "7307019",
      "subQuestName": "与兰罗摩对话，进入莎兰树的梦",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "730701901"
        ],
        "dialogs": {
          "730701901": {
            "id": "730701901",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "这就是…",
            "nextDialogs": [
              "730701902"
            ]
          },
          "730701902": {
            "id": "730701902",
            "speakerId": 20646,
            "speakerName": "兰罗摩",
            "text": "嗯。这就是恒素果。",
            "nextDialogs": [
              "730701903"
            ]
          },
          "730701903": {
            "id": "730701903",
            "speakerId": 20646,
            "speakerName": "兰罗摩",
            "text": "恒素果是莎兰树积聚梦想和记忆，结出来的。对于我们来说，是能让我们恢复力量的宝贵果实。",
            "nextDialogs": [
              "730701904"
            ]
          },
          "730701904": {
            "id": "730701904",
            "speakerId": 20646,
            "speakerName": "兰罗摩",
            "text": "要让「觉王之树」长出惟耶之实，需要消耗大量的力量。所以，我们要拿恒素果去供养他。",
            "nextDialogs": [
              "730701905"
            ]
          },
          "730701905": {
            "id": "730701905",
            "speakerId": 20646,
            "speakerName": "兰罗摩",
            "text": "#那菈{NICKNAME}，要好好保管恒素果喔！",
            "nextDialogs": [
              "730701906"
            ]
          },
          "730701906": {
            "id": "730701906",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "嗯…既然如此，我们教兰罗摩「宝藏」的意思吧！",
            "nextDialogs": [
              "730701907"
            ]
          },
          "730701907": {
            "id": "730701907",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "宝藏就是很珍贵的东西的意思。你看，恒素果有很多梦想和记忆，而且能让兰那罗恢复力量，很厉害、很稀有对吧！",
            "nextDialogs": [
              "730701908"
            ]
          },
          "730701908": {
            "id": "730701908",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "像恒素果这样，很珍贵、很重要的东西，这就是宝藏喔！",
            "nextDialogs": [
              "730701909"
            ]
          },
          "730701909": {
            "id": "730701909",
            "speakerId": 20646,
            "speakerName": "兰罗摩",
            "text": "哦哦！原来宝藏是这样的意思…我知道了！谢谢派蒙！",
            "nextDialogs": [
              "730701911",
              "730701913"
            ]
          },
          "730701911": {
            "id": "730701911",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "唔…记得之前兰拉迦说了，好像要不止一个恒素果。这样的话，我们还要找别的觉树之堂吧？",
            "nextDialogs": [
              "730701914"
            ]
          },
          "730701914": {
            "id": "730701914",
            "speakerId": 20646,
            "speakerName": "兰罗摩",
            "text": "#嗯。我会努力！那菈{NICKNAME}、派蒙，我们之后再见吧！",
            "nextDialogs": [
              "730701915"
            ]
          },
          "730701915": {
            "id": "730701915",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "嗯！之后再见啦，兰罗摩！"
          },
          "730701913": {
            "id": "730701913",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "真是的，你在说什么呀…记得之前兰拉迦说了，好像要不止一个恒素果。这样的话，我们还要找别的觉树之堂吧？"
          }
        }
      }
    },

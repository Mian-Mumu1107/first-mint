    {
      "subId": "7307020",
      "subQuestName": "前往指定地点，寻找与觉树之堂有关的线索",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "730702001"
        ],
        "dialogs": {
          "730702001": {
            "id": "730702001",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "这么一来，第二个恒素果就到手了呢！",
            "nextDialogs": [
              "730702002"
            ]
          },
          "730702002": {
            "id": "730702002",
            "speakerId": 20646,
            "speakerName": "兰罗摩",
            "text": "#那菈{NICKNAME}好厉害！不但能击退无留陀，连怪物也不怕。不愧是能打败桓那吉的那菈！",
            "nextDialogs": [
              "730702003"
            ]
          },
          "730702003": {
            "id": "730702003",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "哼哼，我们一直一起冒险，遇到过很多事情呢！",
            "nextDialogs": [
              "730702004"
            ]
          },
          "730702004": {
            "id": "730702004",
            "speakerId": 20646,
            "speakerName": "兰罗摩",
            "text": "#好棒！那那菈{NICKNAME}和派蒙也有很多记忆、很多故事吧？",
            "nextDialogs": [
              "730702007"
            ]
          },
          "730702007": {
            "id": "730702007",
            "speakerId": 20646,
            "speakerName": "兰罗摩",
            "text": "#嗯。那菈{NICKNAME}和派蒙以后要说故事给我们听。",
            "nextDialogs": [
              "730702008"
            ]
          },
          "730702008": {
            "id": "730702008",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "没问题！之前我们也给人讲过故事呢，感觉已经过了好久了…",
            "nextDialogs": [
              "730702009"
            ]
          },
          "730702009": {
            "id": "730702009",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "这么说来，莎兰树的梦…在梦里面，我看到远方有一个好大好大的、紫色的树，那是什么呀？在桓那兰那好像也看得到…",
            "nextDialogs": [
              "730702010"
            ]
          },
          "730702010": {
            "id": "730702010",
            "speakerId": 20646,
            "speakerName": "兰罗摩",
            "text": "那个呀，是第一棵「觉王的梦之树」。唔…应该怎么说呢…",
            "nextDialogs": [
              "730702011"
            ]
          },
          "730702011": {
            "id": "730702011",
            "speakerId": 20646,
            "speakerName": "兰罗摩",
            "text": "梦就像是在溪水里的树叶，它很快就会和水一起跑掉跑掉不见。所以，如果要让梦一直留着，就要让梦扎根。这样就不会跑掉。",
            "nextDialogs": [
              "730702012"
            ]
          },
          "730702012": {
            "id": "730702012",
            "speakerId": 20646,
            "speakerName": "兰罗摩",
            "text": "呜呜…应该怎么说才好…"
          }
        }
      }
    },
    {
      "subId": "7307004",
      "subQuestName": "与兰罗摩对话",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "730700401"
        ],
        "dialogs": {
          "730700401": {
            "id": "730700401",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "兰罗摩！我们又见面啦！",
            "nextDialogs": [
              "730700402"
            ]
          },
          "730700402": {
            "id": "730700402",
            "speakerId": 20646,
            "speakerName": "兰罗摩",
            "text": "#嗯！那菈{NICKNAME}、派蒙，你们好。这位是兰修提袈。",
            "nextDialogs": [
              "730700403"
            ]
          },
          "730700403": {
            "id": "730700403",
            "speakerId": 20666,
            "speakerName": "兰修提袈",
            "text": "#哇！那菈{NICKNAME}、派蒙，很高兴认识你们！和诗歌里说的一样，金色的那菈，又高又强壮！",
            "nextDialogs": [
              "730700404"
            ]
          },
          "730700404": {
            "id": "730700404",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "我也很高兴！兰修提袈是兰罗摩的朋友吗？",
            "nextDialogs": [
              "730700405"
            ]
          },
          "730700405": {
            "id": "730700405",
            "speakerId": 20646,
            "speakerName": "兰罗摩",
            "text": "嗯！兰修提袈是「采歌者」，经常去收集各种各样的歌曲。",
            "nextDialogs": [
              "730700406"
            ]
          },
          "730700406": {
            "id": "730700406",
            "speakerId": 20646,
            "speakerName": "兰罗摩",
            "text": "在种子变成树苗之前，我们还一起藏在树叶里，到草王的大树里去，看那菈一边喝会让他们变笨的水，一边唱歌！",
            "nextDialogs": [
              "730700407"
            ]
          },
          "730700407": {
            "id": "730700407",
            "speakerId": 20666,
            "speakerName": "兰修提袈",
            "text": "#那菈{NICKNAME}、派蒙，有诗歌吗？",
            "nextDialogs": [
              "730700408"
            ]
          },
          "730700408": {
            "id": "730700408",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "诗歌吗…如果是那个绿色的家伙，应该知道不少吧！",
            "nextDialogs": [
              "730700409"
            ]
          },
          "730700409": {
            "id": "730700409",
            "speakerId": 20666,
            "speakerName": "兰修提袈",
            "text": "绿色的家伙？暝彩鸟？蕈猪？",
            "nextDialogs": [
              "730700410"
            ]
          },
          "730700410": {
            "id": "730700410",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "不是不是！他是蒙德的风神，是吟游诗人哦。",
            "nextDialogs": [
              "730700411"
            ]
          },
          "730700411": {
            "id": "730700411",
            "speakerId": 20666,
            "speakerName": "兰修提袈",
            "text": "哇！那一定知道很多歌！",
            "nextDialogs": [
              "730700412"
            ]
          },
          "730700412": {
            "id": "730700412",
            "speakerId": 20646,
            "speakerName": "兰罗摩",
            "text": "好厉害！风神一定能把诗歌用风吹到很远很远的地方！",
            "nextDialogs": [
              "730700413"
            ]
          },
          "730700413": {
            "id": "730700413",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "嗯！不过话说回来，这里是觉树之堂吗？",
            "nextDialogs": [
              "730700414"
            ]
          },
          "730700414": {
            "id": "730700414",
            "speakerId": 20646,
            "speakerName": "兰罗摩",
            "text": "啊。不是的，但这也是很厉害的发现。在这里，沉睡着很多年没有兰那罗找到的歌。",
            "nextDialogs": [
              "730700415"
            ]
          },
          "730700415": {
            "id": "730700415",
            "speakerId": 20646,
            "speakerName": "兰罗摩",
            "text": "兰那罗的采歌者，会一直一直追求歌的美丽。所以，在时间的最后，会把只属于自己的歌留下。",
            "nextDialogs": [
              "730700417",
              "730700419"
            ]
          },
          "730700417": {
            "id": "730700417",
            "speakerId": 20666,
            "speakerName": "兰修提袈",
            "text": "这边似乎是有兰玛哈留下的歌。如果是这样的话，附近应该就有莎兰树了！",
            "nextDialogs": [
              "730700420"
            ]
          },
          "730700420": {
            "id": "730700420",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "莎兰树…之前兰拉迦好像说过，就是那个什么来着，我看看森林书…",
            "nextDialogs": [
              "730700421"
            ]
          },
          "730700421": {
            "id": "730700421",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "#莎兰树！就是能结出恒素果的莎兰树！我们也帮忙吧，{NICKNAME}！",
            "nextDialogs": [
              "730700422"
            ]
          },
          "730700422": {
            "id": "730700422",
            "speakerId": 20646,
            "speakerName": "兰罗摩",
            "text": "太好了！能和那菈一起研究过去的歌！",
            "nextDialogs": [
              "730700423"
            ]
          },
          "730700423": {
            "id": "730700423",
            "speakerId": 20666,
            "speakerName": "兰修提袈",
            "text": "兰玛哈很喜欢这种玫瑰，但用玫瑰将诗歌藏起来的办法是兰雅玛发现的！因为兰雅玛很骄傲，所以他的玫瑰也很骄傲。",
            "nextDialogs": [
              "730700424"
            ]
          },
          "730700424": {
            "id": "730700424",
            "speakerId": 20666,
            "speakerName": "兰修提袈",
            "text": "所以，玫瑰不会自己告诉我们。只有聪明的兰那罗，或者聪明的那菈，才能够找到隐藏的歌。但是兰修提袈不够聪明…",
            "nextDialogs": [
              "730700425"
            ]
          },
          "730700425": {
            "id": "730700425",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "#不用担心！哼哼，{NICKNAME}可是很聪明的。"
          },
          "730700419": {
            "id": "730700419",
            "speakerId": 20646,
            "speakerName": "兰罗摩",
            "text": "#嗯！谢谢那菈{NICKNAME}。这边似乎是兰玛哈留下的歌。如果是这样的话，附近应该就有莎兰树了。运气很好！"
          }
        }
      }
    },

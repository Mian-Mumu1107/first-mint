    {
      "subId": "7307013",
      "subQuestName": "与兰罗摩对话",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "730701301"
        ],
        "dialogs": {
          "730701301": {
            "id": "730701301",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "这就是…莎兰树？看起来，好像没有想象中那么有生机…",
            "nextDialogs": [
              "730701302"
            ]
          },
          "730701302": {
            "id": "730701302",
            "speakerId": 20646,
            "speakerName": "兰罗摩",
            "text": "嗯。兰玛哈很努力地抵抗了，把无留陀控制在边上。不然的话，附近的森林情况应该会变得更可怕。",
            "nextDialogs": [
              "730701303"
            ]
          },
          "730701303": {
            "id": "730701303",
            "speakerId": 20646,
            "speakerName": "兰罗摩",
            "text": "树叶都掉下来，在地上腐烂。蘑菇全部变成生气的蕈兽，走兽和飞鸟也躺下来，回到土地里，只剩下白白的硬硬的东西。",
            "nextDialogs": [
              "730701304"
            ]
          },
          "730701304": {
            "id": "730701304",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "听起来好可怕…",
            "nextDialogs": [
              "730701305"
            ]
          },
          "730701305": {
            "id": "730701305",
            "speakerId": 20646,
            "speakerName": "兰罗摩",
            "text": "#嗯。不过，幸亏有那菈{NICKNAME}和派蒙，无留陀的问题好了很多很多！",
            "nextDialogs": [
              "730701306"
            ]
          },
          "730701306": {
            "id": "730701306",
            "speakerId": 20646,
            "speakerName": "兰罗摩",
            "text": "如果只有我一个的话，肯定不行。我经过的时间很少，记忆也很少，所以，没有别的兰那罗力量那么强。",
            "nextDialogs": [
              "730701307"
            ]
          },
          "730701307": {
            "id": "730701307",
            "speakerId": 20646,
            "speakerName": "兰罗摩",
            "text": "#但是，和那菈{NICKNAME}和派蒙一起，我就能得到一起冒险的记忆，力量也会变强！",
            "nextDialogs": [
              "730701309"
            ]
          },
          "730701309": {
            "id": "730701309",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "嗯！朋友一起冒险，就是这样的！",
            "nextDialogs": [
              "730701311"
            ]
          },
          "730701311": {
            "id": "730701311",
            "speakerId": 20646,
            "speakerName": "兰罗摩",
            "text": "嗯。我们要先进入他的梦中，消除无留陀的影响。",
            "nextDialogs": [
              "730701312"
            ]
          },
          "730701312": {
            "id": "730701312",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "「他」是指…莎兰树吗？",
            "nextDialogs": [
              "730701313"
            ]
          },
          "730701313": {
            "id": "730701313",
            "speakerId": 20646,
            "speakerName": "兰罗摩",
            "text": "没错。如果准备好了，就伸出手，进入他的梦吧…"
          }
        }
      }
    },
    {
      "subId": "7307017",
      "subQuestName": "与兰罗摩对话，进入莎兰树的梦",
      "sceneId": null,
      "locations": [],
      "dialogue": {

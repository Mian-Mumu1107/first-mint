  "subQuests": [
    {
      "subId": "7566201",
      "subQuestName": "(test)隐藏环对话$HIDDEN",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "756620101"
        ],
        "dialogs": {
          "756620101": {
            "id": "756620101",
            "speakerId": 1000,
            "speakerName": "基尼奇",
            "text": "有信使告诉我，战备联络官找到了强大的试炼检验人。",
            "nextDialogs": [
              "756620102"
            ]
          },
          "756620102": {
            "id": "756620102",
            "speakerId": 1000,
            "speakerName": "基尼奇",
            "text": "确认是你，我就放心了。",
            "nextDialogs": [
              "756620103"
            ]
          },
          "756620103": {
            "id": "756620103",
            "speakerId": 1001,
            "speakerName": "阿乔",
            "text": "嘁，怎么连这家伙都找上了？基尼奇，你这朋友跟你一副德行，是份委托就会接啊。",
            "nextDialogs": [
              "756620104"
            ]
          },
          "756620104": {
            "id": "756620104",
            "speakerId": 1000,
            "speakerName": "基尼奇",
            "text": "链接器来提示了。我收到了一份让聒噪的龙闭嘴的委托。",
            "nextDialogs": [
              "756620106",
              "756620108"
            ]
          },
          "756620106": {
            "id": "756620106",
            "speakerId": 1001,
            "speakerName": "阿乔",
            "text": "你…你们…好哇，竟敢合起伙来捉弄我伟大圣龙…你们会付出代价的！",
            "nextDialogs": [
              "756620109"
            ]
          },
          "756620109": {
            "id": "756620109",
            "speakerId": 1000,
            "speakerName": "基尼奇",
            "text": "#言归正传吧，{NICKNAME}，这次要有劳你检验这几个关卡了。难度和平衡性应当不会让你失望。",
            "nextDialogs": [
              "756620110"
            ]
          },
          "756620110": {
            "id": "756620110",
            "speakerId": 1001,
            "speakerName": "阿乔",
            "text": "难度？我是没看出有半点难度。",
            "nextDialogs": [
              "756620111"
            ]
          },
          "756620111": {
            "id": "756620111",
            "speakerId": 1000,
            "speakerName": "基尼奇",
            "text": "「让他们随机抽选笨蛋伙伴，蒙上脑袋体验山崖速降去。」这是你对难度的理解和诠释？",
            "nextDialogs": [
              "756620112"
            ]
          },
          "756620112": {
            "id": "756620112",
            "speakerId": 1000,
            "speakerName": "基尼奇",
            "text": "况且，抽选的伙伴里只有一成概率是匿叶龙，剩下的全是熔岩游像和岩史莱姆。"
          },
          "756620108": {
            "id": "756620108",
            "speakerId": 1001,
            "speakerName": "阿乔",
            "text": "哼…别以为你帮伟大圣龙说了句好话，我就会对你感恩戴德！"
          }
        }
      }
    }
  ]
}
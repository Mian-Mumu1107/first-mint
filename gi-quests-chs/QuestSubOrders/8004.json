    {
      "subId": "800403",
      "subQuestName": "前往指定区域进行调查",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "80040301"
        ],
        "dialogs": {
          "80040301": {
            "id": "80040301",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "这里是…一座城市！",
            "nextDialogs": [
              "80040302"
            ]
          },
          "80040302": {
            "id": "80040302",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "在空中的，倒立的，一整座城市？",
            "nextDialogs": [
              "80040402"
            ]
          },
          "80040402": {
            "id": "80040402",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "#看着这座城市，{NICKNAME}，你会不会想起些什么…",
            "nextDialogs": [
              "80040403"
            ]
          },
          "80040403": {
            "id": "80040403",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "唔，是什么来着…",
            "nextDialogs": [
              "80040404"
            ]
          },
          "80040404": {
            "id": "80040404",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "「污秽逆位神像」。",
            "nextDialogs": [
              "80040405"
            ]
          },
          "80040405": {
            "id": "80040405",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "对的对的！就是这个，又诡异，又是倒立的，还有一些震撼的感觉。",
            "nextDialogs": [
              "80040406"
            ]
          },
          "80040406": {
            "id": "80040406",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "这样说的话，难道层岩巨渊的下面真的会跟深渊教团有关吗？",
            "nextDialogs": [
              "80040407"
            ]
          },
          "80040407": {
            "id": "80040407",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "我们要想办法去调查一下…",
            "nextDialogs": [
              "80040408"
            ]
          },
          "80040408": {
            "id": "80040408",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "…啊…",
            "nextDialogs": [
              "80040409"
            ]
          },
          "80040409": {
            "id": "80040409",
            "speakerId": 1022,
            "speakerName": "戴因斯雷布",
            "text": "……"
          }
        }
      }
    },
    {
      "subId": "800405",
      "subQuestName": "前往指定区域进行调查",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "80040501"
        ],
        "dialogs": {
          "80040501": {
            "id": "80040501",
            "speakerId": 12423,
            "speakerName": "玥辉",
            "text": "这里的开采许可，我可是花了好大工夫才弄到的。后面的事就拜托你们了。"
          }
        }
      }
    },
    {
      "subId": "800404",
      "subQuestName": "前往指定区域进行调查",
      "sceneId": null,
      "locations": [],

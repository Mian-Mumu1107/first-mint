        "startDialogs": [],
        "dialogs": {}
      }
    },
    {
      "subId": "800404",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "80040401"
        ],
        "dialogs": {
          "80040401": {
            "id": "80040401",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "矿工大哥是要我们来这边调查的吗？"
          }
        }
      }
    },
    {
      "subId": "800499",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "80049901"
        ],
        "dialogs": {
          "80049901": {
            "id": "80049901",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "这边好像进不去啊，没法继续探索了。有没有办法将这个洞口打开呢…"
          }
        }
      }
    }
  ]
}
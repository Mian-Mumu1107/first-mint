  },
  "subQuests": [
    {
      "subId": "800401",
      "subQuestName": "与凯瑟琳对话",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "80040101"
        ],
        "dialogs": {
          "80040101": {
            "id": "80040101",
            "speakerId": 2078,
            "speakerName": "凯瑟琳",
            "text": "啊旅行者，可真是巧啊，呵呵。",
            "nextDialogs": [
              "80040102"
            ]
          },
          "80040102": {
            "id": "80040102",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "凯瑟琳小姐，今天有什么委托吗？还有…你今天见到我们怎么好像格外开心的样子？",
            "nextDialogs": [
              "80040103"
            ]
          },
          "80040103": {
            "id": "80040103",
            "speakerId": 2078,
            "speakerName": "凯瑟琳",
            "text": "因为今天早些时候我去神社求签，巫女告诉我说，最近适合「意料之外的再会」哦？",
            "nextDialogs": [
              "80040104"
            ]
          },
          "80040104": {
            "id": "80040104",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "凯瑟琳小姐会去神社求签？怎么感觉是非常非常稀奇的景象！",
            "nextDialogs": [
              "80040105"
            ]
          },
          "80040105": {
            "id": "80040105",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "不对，重点是你一天之内去稻妻跑了个来回吗？这里可是璃月欸！",
            "nextDialogs": [
              "80040106"
            ]
          },
          "80040106": {
            "id": "80040106",
            "speakerId": 2078,
            "speakerName": "凯瑟琳",
            "text": "呵呵，哪怕是我，也偶尔会有些私生活的嘛。",
            "nextDialogs": [
              "80040107"
            ]
          },
          "80040107": {
            "id": "80040107",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "所以你说「意料之外的再会」，指的是和我们吗？",
            "nextDialogs": [
              "80040108"
            ]
          },
          "80040108": {
            "id": "80040108",
            "speakerId": 2078,
            "speakerName": "凯瑟琳",
            "text": "谁知道呢，至少有了这份期待，就感觉见到谁都会很开心了。",
            "nextDialogs": [
              "80040109"
            ]
          },
          "80040109": {
            "id": "80040109",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "好吧…明明我们几乎每天都要见面的，凯瑟琳小姐开心就好。",
            "nextDialogs": [
              "80040112"
            ]
          },
          "80040112": {
            "id": "80040112",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "#你是说…嗯，我理解你的心情，{NICKNAME}，如果巫女所说的真能灵验就好了…",
            "nextDialogs": [
              "80040113"
            ]
          },
          "80040113": {
            "id": "80040113",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "#你的{PLAYERAVATAR#SEXPRO[INFO_FEMALE_PRONOUN_SISTER|INFO_MALE_PRONOUN_BROTHER]}…",
            "nextDialogs": [
              "80040114"
            ]
          },
          "80040114": {
            "id": "80040114",
            "speakerId": 2078,
            "speakerName": "凯瑟琳",
            "text": "我是不是…说了什么不该说的话呢？看到你们好像有些沮丧。",
            "nextDialogs": [
              "80040115"
            ]
          },
          "80040115": {
            "id": "80040115",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "没事没事，凯瑟琳小姐，我们还是回到委托的话题吧，有没有什么适合我们的委托呢？",
            "nextDialogs": [
              "80040116"
            ]
          },
          "80040116": {
            "id": "80040116",
            "speakerId": 2078,
            "speakerName": "凯瑟琳",
            "text": "嗯，正巧有一位矿工大哥的委托，似乎是关于层岩巨渊的调查。",
            "nextDialogs": [
              "80040117"
            ]
          },
          "80040117": {
            "id": "80040117",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "欸，那边难道已经解除封锁了吗？",
            "nextDialogs": [
              "80040118"
            ]
          },
          "80040118": {
            "id": "80040118",
            "speakerId": 2078,
            "speakerName": "凯瑟琳",
            "text": "那么具体情况就让委托人再详细与你们沟通吧，他叫玥辉，现在应该就在层岩巨渊的附近。",
            "nextDialogs": [
              "80040119"
            ]
          },
          "80040119": {
            "id": "80040119",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "好的，凯瑟琳小姐，那我们就动身啦！",
            "nextDialogs": [
              "80040120"
            ]
          },
          "80040120": {
            "id": "80040120",
            "speakerId": 2078,
            "speakerName": "凯瑟琳",
            "text": "嗯，向着星辰与深渊…唔，这次好像真的是向着「深渊」呢，祝两位好运。"
          }
        }
      }
    },
    {
      "subId": "800402",
      "subQuestName": "在层岩巨渊附近找到发布委托的矿工",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "80040201"
        ],
        "dialogs": {
          "80040201": {
            "id": "80040201",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "你好！是那个…那个玥辉吗？我们是冒险家协会派来的。",
            "nextDialogs": [
              "80040202"
            ]
          },
          "80040202": {
            "id": "80040202",
            "speakerId": 12423,
            "speakerName": "玥辉",
            "text": "哦，幸会幸会，确实是我发布的委托。",
            "nextDialogs": [
              "80040203"
            ]
          },
          "80040203": {
            "id": "80040203",
            "speakerId": 12423,
            "speakerName": "玥辉",
            "text": "嗯？这位看起来好像有点眼熟…是很有名的冒险家么？",
            "nextDialogs": [
              "80040206"
            ]
          },
          "80040206": {
            "id": "80040206",
            "speakerId": 12423,
            "speakerName": "玥辉",
            "text": "这样啊，好吧。先自我介绍一下，我是前不久才拿到层岩巨渊开采许可的矿工，手下有一些跟着我的兄弟。",
            "nextDialogs": [
              "80040207"
            ]
          },
          "80040207": {
            "id": "80040207",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "居然可以拿到层岩巨渊的开采许可？",
            "nextDialogs": [
              "80040208"
            ]
          },
          "80040208": {
            "id": "80040208",
            "speakerId": 12423,
            "speakerName": "玥辉",
            "text": "嗯，玉京台那边终于也开窍了，在千岩军的保护下，开始准许一些仅限于浅表范围的矿物开采，我们还是第一批。",
            "nextDialogs": [
              "80040209"
            ]
          },
          "80040209": {
            "id": "80040209",
            "speakerId": 12423,
            "speakerName": "玥辉",
            "text": "可最近发生了一些事情，矿工兄弟们都有些人心惶惶。",
            "nextDialogs": [
              "80040210"
            ]
          },
          "80040210": {
            "id": "80040210",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "发生了什么事？我们好像没听说过。",
            "nextDialogs": [
              "80040211"
            ]
          },
          "80040211": {
            "id": "80040211",
            "speakerId": 12423,
            "speakerName": "玥辉",
            "text": "嗯…这件事说大不大，说小不小，只是有些诡异…",
            "nextDialogs": [
              "80040212"
            ]
          },
          "80040212": {
            "id": "80040212",
            "speakerId": 12423,
            "speakerName": "玥辉",
            "text": "有个兄弟在休息的时候，忽然注意到几个丘丘人神情恍惚地路过。",
            "nextDialogs": [
              "80040213"
            ]
          },
          "80040213": {
            "id": "80040213",
            "speakerId": 12423,
            "speakerName": "玥辉",
            "text": "而且这些丘丘人看都没看他一眼，只是径直朝着层岩巨渊深处去了。",
            "nextDialogs": [
              "80040214"
            ]
          },
          "80040214": {
            "id": "80040214",
            "speakerId": 12423,
            "speakerName": "玥辉",
            "text": "于是那个兄弟刻意留心观察了一段时日，发现时不时便会有类似的情况发生。",
            "nextDialogs": [
              "80040215"
            ]
          },
          "80040215": {
            "id": "80040215",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "丘丘人难道也有好奇心吗？会不会只是来这边转转…",
            "nextDialogs": [
              "80040216"
            ]
          },
          "80040216": {
            "id": "80040216",
            "speakerId": 12423,
            "speakerName": "玥辉",
            "text": "不，诡异的地方在于，他发现来到层岩巨渊的丘丘人们…",
            "nextDialogs": [
              "80040217"
            ]
          },
          "80040217": {
            "id": "80040217",
            "speakerId": 12423,
            "speakerName": "玥辉",
            "text": "…从来都是「只进不出」的。",
            "nextDialogs": [
              "80040218"
            ]
          },
          "80040218": {
            "id": "80040218",
            "speakerId": 12423,
            "speakerName": "玥辉",
            "text": "那些丘丘人的行迹永远都是单向的，进去之后就再也没有出来。",
            "nextDialogs": [
              "80040219"
            ]
          },
          "80040219": {
            "id": "80040219",
            "speakerId": 12423,
            "speakerName": "玥辉",
            "text": "这段时间，类似的情况愈发频繁。",
            "nextDialogs": [
              "80040220"
            ]
          },
          "80040220": {
            "id": "80040220",
            "speakerId": 12423,
            "speakerName": "玥辉",
            "text": "「那些丘丘人的目标究竟是什么」，「它们后来怎么样了」，「会不会是在酝酿什么灾厄」…",
            "nextDialogs": [
              "80040221"
            ]
          },
          "80040221": {
            "id": "80040221",
            "speakerId": 12423,
            "speakerName": "玥辉",
            "text": "这些念头在矿工兄弟们的脑海中不断出现，很多人都要把自己吓得发疯了。",
            "nextDialogs": [
              "80040222"
            ]
          },
          "80040222": {
            "id": "80040222",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "唔呃，我好像能理解…光是听上去就觉得有些头皮发麻…"
          }
        }
      }
    },
    {
      "subId": "800407",
      "subQuestName": "进入层岩巨渊·地下矿区",
      "sceneId": null,
      "locations": [],

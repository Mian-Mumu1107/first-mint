  "subQuests": [
    {
      "subId": "7214901",
      "subQuestName": "返回珊瑚宫与露子对话",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "721490201"
        ],
        "dialogs": {
          "721490201": {
            "id": "721490201",
            "speakerId": 3193,
            "speakerName": "露子",
            "text": "#欢迎回来，{NICKNAME}。请问有什么事吗？",
            "nextDialogs": [
              "721490202"
            ]
          },
          "721490202": {
            "id": "721490202",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "关于你的委托…",
            "nextDialogs": [
              "721490203"
            ]
          },
          "721490203": {
            "id": "721490203",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "我们已经取得四颗「御灵珠」啦！",
            "nextDialogs": [
              "721490204"
            ]
          },
          "721490204": {
            "id": "721490204",
            "speakerId": 3193,
            "speakerName": "露子",
            "text": "这样吗？真是太可靠了，非常感谢！那么接下来距离解开最后的「心」之封印就只有一步之遥了。",
            "nextDialogs": [
              "721490205"
            ]
          },
          "721490205": {
            "id": "721490205",
            "speakerId": 3193,
            "speakerName": "露子",
            "text": "接下来还要辛苦两位随我一同前去，希望您不要介意。",
            "nextDialogs": [
              "721490206"
            ]
          },
          "721490206": {
            "id": "721490206",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "#既然都到这里了，我们也不在乎多走两步路啦！对吧，{NICKNAME}？",
            "nextDialogs": [
              "721490209"
            ]
          },
          "721490209": {
            "id": "721490209",
            "speakerId": 3193,
            "speakerName": "露子",
            "text": "那么事不宜迟，我们现在就出发吧！"
          }
        }
      }
    },

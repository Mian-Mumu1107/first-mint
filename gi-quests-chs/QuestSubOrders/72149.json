    {
      "subId": "7214903",
      "subQuestName": "进入「心」之所在",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "721490301"
        ],
        "dialogs": {
          "721490301": {
            "id": "721490301",
            "speakerId": 3193,
            "speakerName": "露子",
            "text": "嗯…",
            "nextDialogs": [
              "721490302"
            ]
          },
          "721490302": {
            "id": "721490302",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "露子小姐…？",
            "nextDialogs": [
              "721490303"
            ]
          },
          "721490303": {
            "id": "721490303",
            "speakerId": 3193,
            "speakerName": "露子",
            "text": "啊，抱歉，刚刚太入神了。",
            "nextDialogs": [
              "721490304"
            ]
          },
          "721490304": {
            "id": "721490304",
            "speakerId": 3193,
            "speakerName": "露子",
            "text": "多谢你们的帮助，终于取得「月浴渊之钥」了。",
            "nextDialogs": [
              "721490305"
            ]
          },
          "721490305": {
            "id": "721490305",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "「余哕鱼圆只月」…好拗口…那是什么啊？",
            "nextDialogs": [
              "721490306"
            ]
          },
          "721490306": {
            "id": "721490306",
            "speakerId": 3193,
            "speakerName": "露子",
            "text": "哈哈，简称「渊之钥」就好，我们不会强求外国人的读音准确与否的。",
            "nextDialogs": [
              "721490307"
            ]
          },
          "721490307": {
            "id": "721490307",
            "speakerId": 3193,
            "speakerName": "露子",
            "text": "这是打开渊下宫入口的必备之物，由大御神大人身上流出的血铸结而成…",
            "nextDialogs": [
              "721490308"
            ]
          },
          "721490308": {
            "id": "721490308",
            "speakerId": 3193,
            "speakerName": "露子",
            "text": "至少传说是这样的。",
            "nextDialogs": [
              "721490309"
            ]
          },
          "721490309": {
            "id": "721490309",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "哦…",
            "nextDialogs": [
              "721490310"
            ]
          },
          "721490310": {
            "id": "721490310",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "玄之又玄呢…",
            "nextDialogs": [
              "721490311"
            ]
          },
          "721490311": {
            "id": "721490311",
            "speakerId": 3193,
            "speakerName": "露子",
            "text": "一点也不玄啦，恰恰相反…",
            "nextDialogs": [
              "721490312"
            ]
          },
          "721490312": {
            "id": "721490312",
            "speakerId": 3193,
            "speakerName": "露子",
            "text": "接下来要上报现人神巫女大人，等她批准，再等灵脉的流动正确…",
            "nextDialogs": [
              "721490313"
            ]
          },
          "721490313": {
            "id": "721490313",
            "speakerId": 3193,
            "speakerName": "露子",
            "text": "之后，就可以进入渊下宫了。",
            "nextDialogs": [
              "721490314"
            ]
          },
          "721490314": {
            "id": "721490314",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "所以你在支使我们做什么啦！",
            "nextDialogs": [
              "721490315"
            ]
          },
          "721490315": {
            "id": "721490315",
            "speakerId": 3193,
            "speakerName": "露子",
            "text": "你们这趟又不是全无收获！对吧？",
            "nextDialogs": [
              "721490316"
            ]
          },
          "721490316": {
            "id": "721490316",
            "speakerId": 3193,
            "speakerName": "露子",
            "text": "比如…你们收获了珊瑚宫官方长久的友谊！海祇岛今后会一直欢迎你们的！",
            "nextDialogs": [
              "721490317"
            ]
          },
          "721490317": {
            "id": "721490317",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "什么啦！说得像真的一样！",
            "nextDialogs": [
              "721490318"
            ]
          },
          "721490318": {
            "id": "721490318",
            "speakerId": 3193,
            "speakerName": "露子",
            "text": "…",
            "nextDialogs": [
              "721490319"
            ]
          },
          "721490319": {
            "id": "721490319",
            "speakerId": 3193,
            "speakerName": "露子",
            "text": "记载中有说，「御灵珠」只会应正直纯良之辈的召唤，「月浴渊之钥」也只会为心灵清澈如水之人凝聚。",
            "nextDialogs": [
              "721490320"
            ]
          },
          "721490320": {
            "id": "721490320",
            "speakerId": 3193,
            "speakerName": "露子",
            "text": "虽然我不总是相信那些文书，但我相信您能给海祇岛带来转机。",
            "nextDialogs": [
              "721490321"
            ]
          },
          "721490321": {
            "id": "721490321",
            "speakerId": 3193,
            "speakerName": "露子",
            "text": "那么，待下渊下宫之刻到来…",
            "nextDialogs": [
              "721490325",
              "721490324"
            ]
          },
          "721490325": {
            "id": "721490325",
            "speakerId": 3193,
            "speakerName": "露子",
            "text": "那么，再见啦。"
          },
          "721490324": {
            "id": "721490324",
            "speakerId": 3193,
            "speakerName": "露子",
            "text": "呵呵，我签运很好的。我们一定还会再见面。"
          }
        }
      }
    },

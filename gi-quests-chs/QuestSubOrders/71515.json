{
  "lineCounts": {
    "Player": 9,
    "和声": 9,
    "庆兴": 10,
    "应公": 25,
    "派蒙": 11
  },
  "subQuests": [
    {
      "subId": "7151501",
      "subQuestName": "前往北码头",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "715150101"
        ],
        "dialogs": {
          "715150101": {
            "id": "715150101",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "「港内北码头现有演出。」唔，这个通知也写得太模糊了吧，既没说是什么演出，也没说是谁演。",
            "nextDialogs": [
              "715150102"
            ]
          },
          "715150102": {
            "id": "715150102",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "我们还是自己找找演出的地方吧，实在不行，还可以问路人。",
            "nextDialogs": [
              "715150103"
            ]
          },
          "715150103": {
            "id": "715150103",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "那里有好多人。",
            "nextDialogs": [
              "715150104"
            ]
          },
          "715150104": {
            "id": "715150104",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "啊，我看到了。这么多人都聚集在这里，说不定就是来看演出的。",
            "nextDialogs": [
              "715150105"
            ]
          },
          "715150105": {
            "id": "715150105",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "我们去问问看吧。"
          }
        }
      }
    },
    {
      "subId": "7151502",
      "subQuestName": "询问路人",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "715150201"
        ],
        "dialogs": {
          "715150201": {
            "id": "715150201",
            "speakerId": 30308,
            "speakerName": "庆兴",
            "text": "「如意康宁，平安吉庆…♪」",
            "nextDialogs": [
              "715150202"
            ]
          },
          "715150202": {
            "id": "715150202",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "你好。",
            "nextDialogs": [
              "715150203"
            ]
          },
          "715150203": {
            "id": "715150203",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "请问这里是不是马上要有演出啦？",
            "nextDialogs": [
              "715150204"
            ]
          },
          "715150204": {
            "id": "715150204",
            "speakerId": 30308,
            "speakerName": "庆兴",
            "text": "对呀，马上就要演纸映剧了，你们也是来看纸映剧的吗？",
            "nextDialogs": [
              "715150207"
            ]
          },
          "715150207": {
            "id": "715150207",
            "speakerId": 30308,
            "speakerName": "庆兴",
            "text": "不是啦，纸映剧和璃月戏不是一回事…",
            "nextDialogs": [
              "715150208"
            ]
          },
          "715150208": {
            "id": "715150208",
            "speakerId": 30307,
            "speakerName": "和声",
            "text": "庆兴庆兴，戏快开场了，你们别说话了，会影响大叔表演的。",
            "nextDialogs": [
              "715150209"
            ]
          },
          "715150209": {
            "id": "715150209",
            "speakerId": 30308,
            "speakerName": "庆兴",
            "text": "哦哦，纸映剧什么样，反正你们两个看了就知道了。",
            "nextDialogs": [
              "715150210"
            ]
          },
          "715150210": {
            "id": "715150210",
            "speakerId": 30306,
            "speakerName": "应公",
            "text": "…列位小看官们，咱们今天演的是虬髯公的故事。",
            "nextDialogs": [
              "715150211"
            ]
          },
          "715150211": {
            "id": "715150211",
            "speakerId": 30306,
            "speakerName": "应公",
            "text": "话说在前头，有想上厕所的，要买糖水的，大可先去。待到角儿们出场，戏就不等人喽。",
            "nextDialogs": [
              "715150212"
            ]
          },
          "715150212": {
            "id": "715150212",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "（所以这出戏叫《虬髯公》，是完全没听说过的故事欸。）",
            "nextDialogs": [
              "715150213"
            ]
          },
          "715150213": {
            "id": "715150213",
            "speakerId": 30307,
            "speakerName": "和声",
            "text": "嘘，就算小声说话，我们还是听得到，你安安静静听啦，后面点戏的时候才可以说话。",
            "nextDialogs": [
              "715150214"
            ]
          },
          "715150214": {
            "id": "715150214",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "唔…对不起。",
            "nextDialogs": [
              "715150215"
            ]
          },
          "715150215": {
            "id": "715150215",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "点戏？",
            "nextDialogs": [
              "715150216"
            ]
          },
          "715150216": {
            "id": "715150216",
            "speakerId": 30308,
            "speakerName": "庆兴",
            "text": "虬髯公的故事特别长，全都演完就太长了，所以每次大叔都会让大家选想看哪个部分…",
            "nextDialogs": [
              "715150217"
            ]
          },
          "715150217": {
            "id": "715150217",
            "speakerId": 30307,
            "speakerName": "和声",
            "text": "庆兴！我听不清大叔念戏文了！",
            "nextDialogs": [
              "715150218"
            ]
          },
          "715150218": {
            "id": "715150218",
            "speakerId": 30308,
            "speakerName": "庆兴",
            "text": "哦哦，这次我真的不插嘴了。",
            "nextDialogs": [
              "715150219"
            ]
          },
          "715150219": {
            "id": "715150219",
            "speakerId": 30306,
            "speakerName": "应公",
            "text": "看官们，今天大家想品鉴《全本虬髯公》里的哪段故事呢？",
            "nextDialogs": [
              "715150220"
            ]
          },
          "715150220": {
            "id": "715150220",
            "speakerId": 30306,
            "speakerName": "应公",
            "text": "是想看《投山》呢，还是《拜仙》？是《缚鬼》还是《登天》？",
            "nextDialogs": [
              "715150221"
            ]
          },
          "715150221": {
            "id": "715150221",
            "speakerId": 30306,
            "speakerName": "应公",
            "text": "只有小看官们报不出名儿的，没有我不会演的。",
            "nextDialogs": [
              "715150222"
            ]
          },
          "715150222": {
            "id": "715150222",
            "speakerId": 30308,
            "speakerName": "庆兴",
            "text": "我想看虬髯公和妖魔打架，他特别帅，每次都能赢。",
            "nextDialogs": [
              "715150223"
            ]
          },
          "715150223": {
            "id": "715150223",
            "speakerId": 30307,
            "speakerName": "和声",
            "text": "《拜仙》和《缚鬼》都看了好多遍了，你不腻吗？我选虬髯公回家看妹妹那段。",
            "nextDialogs": [
              "715150224"
            ]
          },
          "715150224": {
            "id": "715150224",
            "speakerId": 30308,
            "speakerName": "庆兴",
            "text": "虬髯公还有妹妹吗？我怎么不知道，这个我没看过欸。",
            "nextDialogs": [
              "715150225"
            ]
          },
          "715150225": {
            "id": "715150225",
            "speakerId": 30306,
            "speakerName": "应公",
            "text": "这位小看官是行家啊，《奔乡》这段啊点的人不多，不是老剧迷都不知道有这出。",
            "nextDialogs": [
              "715150226"
            ]
          },
          "715150226": {
            "id": "715150226",
            "speakerId": 30306,
            "speakerName": "应公",
            "text": "好，恰逢海灯佳节，咱们不演什么妖魔鬼怪，来瞧瞧有情人怎么终成眷属。",
            "nextDialogs": [
              "715150227"
            ]
          },
          "715150227": {
            "id": "715150227",
            "speakerId": 30306,
            "speakerName": "应公",
            "text": "这一场上要出现的角儿有三人，除了咱们的熟面孔虬髯公，还有一位伶仃孤女，名叫意冰，一位志诚君子，唤作南风。",
            "nextDialogs": [
              "715150228"
            ]
          },
          "715150228": {
            "id": "715150228",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "#{NICKNAME}，你听明白了吗？我怎么还是云里雾里的。",
            "nextDialogs": [
              "715150229"
            ]
          },
          "715150229": {
            "id": "715150229",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "现在要演的，好像是一个叫虬髯公的人的事？但听起来，除了男主角，还有其他配角啊。",
            "nextDialogs": [
              "715150230"
            ]
          },
          "715150230": {
            "id": "715150230",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "可我们面前只有一个演员…呃，还有一架…屏风？这怎么演戏啊。",
            "nextDialogs": [
              "715150231"
            ]
          },
          "715150231": {
            "id": "715150231",
            "speakerId": 30307,
            "speakerName": "和声",
            "text": "哎呀，这儿有个人没看过纸映剧。",
            "nextDialogs": [
              "715150232"
            ]
          },
          "715150232": {
            "id": "715150232",
            "speakerId": 30306,
            "speakerName": "应公",
            "text": "哦？后面一位小看官问了，我应公只有人一个，又没有分身化形的本事，这戏怎么演呢？",
            "nextDialogs": [
              "715150233"
            ]
          },
          "715150233": {
            "id": "715150233",
            "speakerId": 30306,
            "speakerName": "应公",
            "text": "您有所不知，我们这纸映剧虽不及璃月戏讲究，也自有一番特色。",
            "nextDialogs": [
              "715150234"
            ]
          },
          "715150234": {
            "id": "715150234",
            "speakerId": 30306,
            "speakerName": "应公",
            "text": "演璃月戏的那些个角儿们都是血肉之躯，但咱们纸映剧的演员却是纸糊绢裱的。",
            "nextDialogs": [
              "715150235"
            ]
          },
          "715150235": {
            "id": "715150235",
            "speakerId": 30306,
            "speakerName": "应公",
            "text": "人家的戏台是木头搭的，咱们的戏台是一张薄纸蒙在木架子上，说来说去都是纸，所以叫做纸映剧。",
            "nextDialogs": [
              "715150236"
            ]
          },
          "715150236": {
            "id": "715150236",
            "speakerId": 30306,
            "speakerName": "应公",
            "text": "旁白是我，演戏的却不是我，您一会儿就能见到那三位纸演员啦。",
            "nextDialogs": [
              "715150237"
            ]
          },
          "715150237": {
            "id": "715150237",
            "speakerId": 30307,
            "speakerName": "和声",
            "text": "#大叔，他们应该也不认识虬髯公，给{M#他们}{F#她们}说说虬髯公的事行不行，就是每次开头都有的那个…",
            "nextDialogs": [
              "715150238"
            ]
          },
          "715150238": {
            "id": "715150238",
            "speakerId": 30308,
            "speakerName": "庆兴",
            "text": "那个叫定场话，我也喜欢听，大叔给我们念念吧。",
            "nextDialogs": [
              "715150239"
            ]
          },
          "715150239": {
            "id": "715150239",
            "speakerId": 30307,
            "speakerName": "和声",
            "text": "定场话！定场话！",
            "nextDialogs": [
              "715150240"
            ]
          },
          "715150240": {
            "id": "715150240",
            "speakerId": 30306,
            "speakerName": "应公",
            "text": "如此听了，雄心欲把天纲正，无奈人间鬼气高。",
            "nextDialogs": [
              "715150241"
            ]
          },
          "715150241": {
            "id": "715150241",
            "speakerId": 30306,
            "speakerName": "应公",
            "text": "只说一位公子桓光，受尽人间不平气，投入山川苍莽间。",
            "nextDialogs": [
              "715150242"
            ]
          },
          "715150242": {
            "id": "715150242",
            "speakerId": 30306,
            "speakerName": "应公",
            "text": "机缘巧合，他拜入一位仙人座下，便改换了形貌，蓄起一部乌黑胡须，号称虬髯公。",
            "nextDialogs": [
              "715150243"
            ]
          },
          "715150243": {
            "id": "715150243",
            "speakerId": 30306,
            "speakerName": "应公",
            "text": "他奉仙人之命，一剑东来，把那魑魅荡平，唬得魍魉屏迹。",
            "nextDialogs": [
              "715150244"
            ]
          },
          "715150244": {
            "id": "715150244",
            "speakerId": 30306,
            "speakerName": "应公",
            "text": "虬髯公辗转修行多年，终于得悟大道，正待要返归仙家洞府时，才由仙人点拨，忆起前尘往事。",
            "nextDialogs": [
              "715150245"
            ]
          },
          "715150245": {
            "id": "715150245",
            "speakerId": 30306,
            "speakerName": "应公",
            "text": "原来他尘缘未尽，家中尚有一妹。可怜妹子意冰如今孤苦伶仃，无可依靠。",
            "nextDialogs": [
              "715150246"
            ]
          },
          "715150246": {
            "id": "715150246",
            "speakerId": 30306,
            "speakerName": "应公",
            "text": "她本以为兄长这一生襟抱送凄凉，如何能想到不日旧人返归乡。欲知后事如何…",
            "nextDialogs": [
              "715150247"
            ]
          },
          "715150247": {
            "id": "715150247",
            "speakerId": 30306,
            "speakerName": "应公",
            "text": "马上为您分解！",
            "nextDialogs": [
              "715150248"
            ]
          },
          "715150248": {
            "id": "715150248",
            "speakerId": 30307,
            "speakerName": "和声",
            "text": "好欸！别愣着啊，这里该鼓掌了。"
          }
        }
      }
    }
  ]
}
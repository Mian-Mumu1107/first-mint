  "subQuests": [
    {
      "subId": "7370801",
      "subQuestName": "前往拜达港",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "737080101"
        ],
        "dialogs": {
          "737080101": {
            "id": "737080101",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "咦，那边有只蕈兽飘过去了欸，没问题吗？",
            "nextDialogs": [
              "737080102"
            ]
          },
          "737080102": {
            "id": "737080102",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "一般来说，蕈兽在城区活动，还是有点危险的吧！除非是特别听话，受过训练的特例…",
            "nextDialogs": [
              "737080103"
            ]
          },
          "737080103": {
            "id": "737080103",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "不对呀，怎么好像有点熟悉，以前我们是不是经历过类似的情景。",
            "nextDialogs": [
              "737080105",
              "737080108"
            ]
          },
          "737080105": {
            "id": "737080105",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "对！「咚咚小圆帽」！我们在须弥结识的蕈兽伙伴！",
            "nextDialogs": [
              "737080106"
            ]
          },
          "737080106": {
            "id": "737080106",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "呜啊啊啊啊啊，上次见面都好久好久了！我们快过去看看吧！"
          },
          "737080108": {
            "id": "737080108",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "好像是…「咚咚小圆帽」？我们在须弥结识的蕈兽伙伴！",
            "nextDialogs": [
              "737080109"
            ]
          },
          "737080109": {
            "id": "737080109",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "呜啊啊啊啊啊，上次见面都好久好久了！我们快过去看看吧！"
          }
        }
      }
    },
    {
      "subId": "7370802",
      "subQuestName": "与海妮耶对话",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "737080201"
        ],
        "dialogs": {
          "737080201": {
            "id": "737080201",
            "speakerId": 1001,
            "speakerName": "海妮耶",
            "text": "看来留言转达得很顺利。",
            "nextDialogs": [
              "737080202"
            ]
          },
          "737080202": {
            "id": "737080202",
            "speakerId": 1001,
            "speakerName": "海妮耶",
            "text": "终于又见面了，「黄金流星」和「白银伴星」。",
            "nextDialogs": [
              "737080203"
            ]
          },
          "737080203": {
            "id": "737080203",
            "speakerId": 1001,
            "speakerName": "海妮耶",
            "text": "你们容光焕发的模样，让我有种时间停滞的美好感觉。",
            "nextDialogs": [
              "737080205",
              "737080209"
            ]
          },
          "737080205": {
            "id": "737080205",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "真的是你们啊，海妮耶和「咚咚小圆帽」！",
            "nextDialogs": [
              "737080206"
            ]
          },
          "737080206": {
            "id": "737080206",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "难怪看过留言，我就有种奇妙的熟悉感…说明我和「咚咚小圆帽」的默契还在！",
            "nextDialogs": [
              "737080207"
            ]
          },
          "737080207": {
            "id": "737080207",
            "speakerId": 1002,
            "speakerName": "咚咚小圆帽",
            "text": "♪~",
            "nextDialogs": [
              "737080212"
            ]
          },
          "737080212": {
            "id": "737080212",
            "speakerId": 1001,
            "speakerName": "海妮耶",
            "text": "我设想过许多重逢的情景，比如举办丰盛的宴会，或是富有创意的欢迎仪式，给你们个巨大的惊喜。",
            "nextDialogs": [
              "737080213"
            ]
          },
          "737080213": {
            "id": "737080213",
            "speakerId": 1001,
            "speakerName": "海妮耶",
            "text": "但感觉都有些见外，考虑到你们一直很忙，说不定占用太长时间，反而会让你们觉得麻烦。",
            "nextDialogs": [
              "737080214"
            ]
          },
          "737080214": {
            "id": "737080214",
            "speakerId": 1001,
            "speakerName": "海妮耶",
            "text": "而且，现在的蕈兽伙伴们也喜欢宁静的环境，所以，就让我们以松弛自然的方式重逢吧。",
            "nextDialogs": [
              "737080215"
            ]
          },
          "737080215": {
            "id": "737080215",
            "speakerId": 1003,
            "speakerName": "左右加",
            "text": "没错没错，海妮耶读的散文派上用场啦，平静的心态对生活有益！",
            "nextDialogs": [
              "737080216"
            ]
          },
          "737080216": {
            "id": "737080216",
            "speakerId": 1003,
            "speakerName": "左右加",
            "text": "还是像这样，轻轻松松聊天最开心。",
            "nextDialogs": [
              "737080217"
            ]
          },
          "737080217": {
            "id": "737080217",
            "speakerId": 1004,
            "speakerName": "欢腾之火",
            "text": "♫~",
            "nextDialogs": [
              "737080218"
            ]
          },
          "737080218": {
            "id": "737080218",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "左右加小姐也在，还有「欢腾之火」和…这位是？",
            "nextDialogs": [
              "737080219"
            ]
          },
          "737080219": {
            "id": "737080219",
            "speakerId": 1003,
            "speakerName": "左右加",
            "text": "是我自己的蕈兽伙伴「信风舞姬」哦，当时在三十二强赛上，被你们和「咚咚小圆帽」一下就打败了！",
            "nextDialogs": [
              "737080220"
            ]
          },
          "737080220": {
            "id": "737080220",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "哎呀，还是你记得清楚！"
          },
          "737080209": {
            "id": "737080209",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "确实是海妮耶和「咚咚小圆帽」！我们好久之前在「月莲杯驯兽师大赛」认识的朋友！",
            "nextDialogs": [
              "737080210"
            ]
          },
          "737080210": {
            "id": "737080210",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "印象里，之后我们还在奥摩斯港附近，还有枫丹廷见过面！不知不觉，已经过去这么长时间了…",
            "nextDialogs": [
              "737080211"
            ]
          },
          "737080211": {
            "id": "737080211",
            "speakerId": 1002,
            "speakerName": "咚咚小圆帽",
            "text": "♪~"
          }
        }
      }
    },
    {
      "subId": "7370803",
      "subQuestName": "前往游览地点",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "737080301"
        ],
        "dialogs": {
          "737080301": {
            "id": "737080301",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "呼啊…总算到了！",
            "nextDialogs": [
              "737080302"
            ]
          },
          "737080302": {
            "id": "737080302",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "虽然路途非常遥远，但我觉得，「悬木人」这边超有特色的彩石顶，对蕈兽伙伴们来说，肯定无比新奇！",
            "nextDialogs": [
              "737080303"
            ]
          },
          "737080303": {
            "id": "737080303",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "我这里有几张风景画，可以让蕈兽伙伴们对比图画和眼前的景象…",
            "nextDialogs": [
              "737080304"
            ]
          },
          "737080304": {
            "id": "737080304",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "如果伙伴们仔细观察，把两者对上号后，慢慢注意到不起眼的细节，对这里感兴趣…就说明这里适合我们深度游玩！",
            "nextDialogs": [
              "737080305"
            ]
          },
          "737080305": {
            "id": "737080305",
            "speakerId": 1002,
            "speakerName": "咚咚小圆帽",
            "text": "♪♫！",
            "nextDialogs": [
              "737080306"
            ]
          },
          "737080306": {
            "id": "737080306",
            "speakerId": 1004,
            "speakerName": "欢腾之火",
            "text": "♫…♩？",
            "nextDialogs": [
              "737080309"
            ]
          },
          "737080309": {
            "id": "737080309",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "嘿嘿，我闲下来没事的时候，也会翻看导览图册，观察一些游览胜地。",
            "nextDialogs": [
              "737080310"
            ]
          },
          "737080310": {
            "id": "737080310",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "这可是好向导的必修课！",
            "nextDialogs": [
              "737080311"
            ]
          },
          "737080311": {
            "id": "737080311",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "好啦，让蕈兽伙伴也试试看吧？"
          }
        }
      }
    },
    {
      "subId": "7370899",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "737089901"
        ],
        "dialogs": {
          "737089901": {
            "id": "737089901",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "说起来，有人在冒险家协会留了言，请我们去拜达港参观新店铺…拜达港的新店铺？",
            "nextDialogs": [
              "737089902"
            ]
          },
          "737089902": {
            "id": "737089902",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "会是谁呢？我有种碰上了好事的预感…去看看吧！",
            "nextDialogs": [
              "737089903"
            ]
          },
          "737089903": {
            "id": "737089903",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "我想到几个不错的地方，对蕈兽伙伴们来说，一定很新奇！",
            "nextDialogs": [
              "737089904"
            ]
          },
          "737089904": {
            "id": "737089904",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "虽然有点远，但长途旅行也别有一番风味嘛…就从纳塔开始吧？"
          }
        }
      }
    }
  ]
}
    {
      "subId": "7000902",
      "subQuestName": "与维克多对话",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "700090801"
        ],
        "dialogs": {
          "700090801": {
            "id": "700090801",
            "speakerId": 1517,
            "speakerName": "维克多",
            "text": "你们总算是回来了，哼，旁边那个修女看我的眼神，简直就像是我伙同你把莉莉怎么样了似的…",
            "nextDialogs": [
              "700090802"
            ]
          },
          "700090802": {
            "id": "700090802",
            "speakerId": 1517,
            "speakerName": "维克多",
            "text": "不过这样的话，那孩子总算是不会…",
            "nextDialogs": [
              "700090803"
            ]
          },
          "700090803": {
            "id": "700090803",
            "speakerId": 1599,
            "speakerName": "莉莉",
            "text": "蜀黍！这个、还有这个给尼！",
            "nextDialogs": [
              "700090804"
            ]
          },
          "700090804": {
            "id": "700090804",
            "speakerId": 1517,
            "speakerName": "维克多",
            "text": "蒲公英…还有这个烤松饼是怎么…",
            "nextDialogs": [
              "700090805"
            ]
          },
          "700090805": {
            "id": "700090805",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "是礼物吧。",
            "nextDialogs": [
              "700090806"
            ]
          },
          "700090806": {
            "id": "700090806",
            "speakerId": 1517,
            "speakerName": "维克多",
            "text": "礼、礼物？蒲公英就只剩下了个杆子，还有这烤松饼…",
            "nextDialogs": [
              "700090807"
            ]
          },
          "700090807": {
            "id": "700090807",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "这烤松饼可是莉莉亲手做的。",
            "nextDialogs": [
              "700090808"
            ]
          },
          "700090808": {
            "id": "700090808",
            "speakerId": 1517,
            "speakerName": "维克多",
            "text": "…看着真是…不错。没想到这孩子还有这手艺…",
            "nextDialogs": [
              "700090809"
            ]
          },
          "700090809": {
            "id": "700090809",
            "speakerId": 1599,
            "speakerName": "莉莉",
            "text": "嘻嘻，这都是窝学的我麻麻，蜀黍，吃完了之后，窝还要听你讲故事！",
            "nextDialogs": [
              "700090810"
            ]
          },
          "700090810": {
            "id": "700090810",
            "speakerId": 1517,
            "speakerName": "维克多",
            "text": "还…还要听，我…",
            "nextDialogs": [
              "700090811"
            ]
          },
          "700090811": {
            "id": "700090811",
            "speakerId": 1517,
            "speakerName": "维克多",
            "text": "好吧…你都送我礼物了，那我就再讲几个故事。",
            "nextDialogs": [
              "700090812"
            ]
          },
          "700090812": {
            "id": "700090812",
            "speakerId": 1599,
            "speakerName": "莉莉",
            "text": "好耶！那窝要听…驴人众的事！",
            "nextDialogs": [
              "700090813"
            ]
          },
          "700090813": {
            "id": "700090813",
            "speakerId": 1517,
            "speakerName": "维克多",
            "text": "咳！这个…这个没什么…没什么趣，我想个更有意思的。"
          }
        }
      }
    },
    {
      "subId": "7000910",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "700091001"
        ],
        "dialogs": {
          "700091001": {
            "id": "700091001",
            "speakerId": 1517,
            "speakerName": "维克多",
            "text": "你和那孩子聊得挺开心的嘛，你们刚才说的话，我也都听见了。",
            "nextDialogs": [
              "700091002"
            ]
          },
          "700091002": {
            "id": "700091002",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "你有什么看法？",
            "nextDialogs": [
              "700091003"
            ]
          },
          "700091003": {
            "id": "700091003",
            "speakerId": 1517,
            "speakerName": "维克多",
            "text": "只是小孩子的一些梦话而已，我没什么看法。",
            "nextDialogs": [
              "700091004"
            ]
          },
          "700091004": {
            "id": "700091004",
            "speakerId": 1517,
            "speakerName": "维克多",
            "text": "这世上的好坏，要是都这么容易区分的话，那很多事都…",
            "nextDialogs": [
              "700091005"
            ]
          },
          "700091005": {
            "id": "700091005",
            "speakerId": 1517,
            "speakerName": "维克多",
            "text": "…算了，不说了，你快点带她出去玩吧。"
          }
        }
      }
    }
  ]
}
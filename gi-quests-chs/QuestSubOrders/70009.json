    {
      "subId": "7000904",
      "subQuestName": "与莉莉对话",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "700090201"
        ],
        "dialogs": {
          "700090201": {
            "id": "700090201",
            "speakerId": 1599,
            "speakerName": "莉莉",
            "text": "#{PLAYERAVATAR#SEXPRO[INFO_MALE_PRONOUN_CUTEBIGBROTHER|INFO_FEMALE_PRONOUN_CUTEBIGSISTER]}，为什么那个驴人众的蜀黍，不过风画节呀…",
            "nextDialogs": [
              "700090203",
              "700090205"
            ]
          },
          "700090203": {
            "id": "700090203",
            "speakerId": 1599,
            "speakerName": "莉莉",
            "text": "纵要的工作？唔…比过风画节还纵要吗？",
            "nextDialogs": [
              "700090207"
            ]
          },
          "700090207": {
            "id": "700090207",
            "speakerId": 1599,
            "speakerName": "莉莉",
            "text": "可是，那个蜀黍就算干了这么坏这么坏的事，只要改掉，他也能变成很好很好的人吧？",
            "nextDialogs": [
              "700090208"
            ]
          },
          "700090208": {
            "id": "700090208",
            "speakerId": 1599,
            "speakerName": "莉莉",
            "text": "嗯！窝要去和那个蜀黍说，只要变得很好很好，他就能过风画节了！",
            "nextDialogs": [
              "700090209"
            ]
          },
          "700090209": {
            "id": "700090209",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "那个叔叔现在很忙，我们出去玩玩，好吗？",
            "nextDialogs": [
              "700090210"
            ]
          },
          "700090210": {
            "id": "700090210",
            "speakerId": 1599,
            "speakerName": "莉莉",
            "text": "#欸…好吧。那，{PLAYERAVATAR#SEXPRO[INFO_MALE_PRONOUN_CUTEBIGBROTHER|INFO_FEMALE_PRONOUN_CUTEBIGSISTER]}，你可以带窝出去玩吗？",
            "nextDialogs": [
              "700090211"
            ]
          },
          "700090211": {
            "id": "700090211",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "没问题，别走太远就好。",
            "nextDialogs": [
              "700090212"
            ]
          },
          "700090212": {
            "id": "700090212",
            "speakerId": 1599,
            "speakerName": "莉莉",
            "text": "好欸！那窝们快出去玩吧！"
          },
          "700090205": {
            "id": "700090205",
            "speakerId": 1599,
            "speakerName": "莉莉",
            "text": "为森么呀？是不是因为…驴人众很坏很坏？把拔缩，碎觉卜刷牙、赤饭时用手抓…",
            "nextDialogs": [
              "700090206"
            ]
          },
          "700090206": {
            "id": "700090206",
            "speakerId": 1599,
            "speakerName": "莉莉",
            "text": "唔唔，辣样是很坏呢，蜀黍的把拔看了肯定会生气的…"
          }
        }
      }
    },
    {
      "subId": "7000905",
      "subQuestName": "前往蒙德商业街",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "700090501"
        ],
        "dialogs": {
          "700090501": {
            "id": "700090501",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "关于喂小狗的事…",
            "nextDialogs": [
              "700090502"
            ]
          },
          "700090502": {
            "id": "700090502",
            "speakerId": 1423,
            "speakerName": "布兰琪",
            "text": "莉莉，旅行者，你们回来了？怎么样，找到小狗了吗？",
            "nextDialogs": [
              "700090503"
            ]
          },
          "700090503": {
            "id": "700090503",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "找到了。",
            "nextDialogs": [
              "700090504"
            ]
          },
          "700090504": {
            "id": "700090504",
            "speakerId": 1599,
            "speakerName": "莉莉",
            "text": "嗯！谢谢大捷洁，窝和它们玩得狠好啦！",
            "nextDialogs": [
              "700090505"
            ]
          },
          "700090505": {
            "id": "700090505",
            "speakerId": 1423,
            "speakerName": "布兰琪",
            "text": "这样就好了。对了，你们要是有空的话，也可以去芙萝拉小姐那边看看。",
            "nextDialogs": [
              "700090506"
            ]
          },
          "700090506": {
            "id": "700090506",
            "speakerId": 1423,
            "speakerName": "布兰琪",
            "text": "毕竟是风花节，能够带一束花回去的话，感觉也不错，对吧？",
            "nextDialogs": [
              "700090507"
            ]
          },
          "700090507": {
            "id": "700090507",
            "speakerId": 1599,
            "speakerName": "莉莉",
            "text": "#哇…窝想去看看，{PLAYERAVATAR#SEXPRO[INFO_MALE_PRONOUN_CUTEBIGBROTHER|INFO_FEMALE_PRONOUN_CUTEBIGSISTER]}…",
            "nextDialogs": [
              "700090508"
            ]
          },
          "700090508": {
            "id": "700090508",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "我们过去吧。",
            "nextDialogs": [
              "700090509"
            ]
          },
          "700090509": {
            "id": "700090509",
            "speakerId": 1599,
            "speakerName": "莉莉",
            "text": "#谢谢{PLAYERAVATAR#SEXPRO[INFO_MALE_PRONOUN_CUTEBIGBROTHER|INFO_FEMALE_PRONOUN_CUTEBIGSISTER]}！"
          }
        }
      }
    },
    {
      "subId": "7000906",
      "subQuestName": "与布兰琪对话",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "700090302"
        ],
        "dialogs": {
          "700090302": {
            "id": "700090302",
            "speakerId": 1423,
            "speakerName": "布兰琪",
            "text": "旅行者？你有什么事吗？",
            "nextDialogs": [
              "700090303"
            ]
          },
          "700090303": {
            "id": "700090303",
            "speakerId": 1423,
            "speakerName": "布兰琪",
            "text": "还有…莉莉？你怎么来了，你爸爸和妈妈呢？",
            "nextDialogs": [
              "700090304"
            ]
          },
          "700090304": {
            "id": "700090304",
            "speakerId": 1599,
            "speakerName": "莉莉",
            "text": "#把拔和麻麻有很纵要的事要做！所以这个{PLAYERAVATAR#SEXPRO[INFO_MALE_PRONOUN_CUTEBIGBROTHER|INFO_FEMALE_PRONOUN_CUTEBIGSISTER]}在带我玩。",
            "nextDialogs": [
              "700090305"
            ]
          },
          "700090305": {
            "id": "700090305",
            "speakerId": 1423,
            "speakerName": "布兰琪",
            "text": "很重要的事？鲁道夫先生和吉丽安娜小姐还真是…",
            "nextDialogs": [
              "700090306"
            ]
          },
          "700090306": {
            "id": "700090306",
            "speakerId": 1599,
            "speakerName": "莉莉",
            "text": "大捷洁，刚才那个小狗狗在哪里呀？",
            "nextDialogs": [
              "700090307"
            ]
          },
          "700090307": {
            "id": "700090307",
            "speakerId": 1423,
            "speakerName": "布兰琪",
            "text": "刚才的小狗？唔…我也不知道，平时它们基本上都躲在自己的窝里，只在我往食盆里放食物的时候，它们才过来。",
            "nextDialogs": [
              "700090308"
            ]
          },
          "700090308": {
            "id": "700090308",
            "speakerId": 1423,
            "speakerName": "布兰琪",
            "text": "可能是因为现在城里太热闹了，它们都被吵得跑出来了吧？",
            "nextDialogs": [
              "700090309"
            ]
          },
          "700090309": {
            "id": "700090309",
            "speakerId": 1423,
            "speakerName": "布兰琪",
            "text": "怎么，莉莉，你是想和它们玩吗？",
            "nextDialogs": [
              "700090310"
            ]
          },
          "700090310": {
            "id": "700090310",
            "speakerId": 1599,
            "speakerName": "莉莉",
            "text": "嗯！窝想和它们玩！",
            "nextDialogs": [
              "700090311"
            ]
          },
          "700090311": {
            "id": "700090311",
            "speakerId": 1423,
            "speakerName": "布兰琪",
            "text": "这样啊…我想想，光是找肯定是找不到的…那你们不如去那边的食盆里放点吃的，把它们引出吧。",
            "nextDialogs": [
              "700090312"
            ]
          },
          "700090312": {
            "id": "700090312",
            "speakerId": 1423,
            "speakerName": "布兰琪",
            "text": "唔，我想想…小狗的食盆里最好放些禽肉呢。",
            "nextDialogs": [
              "700090313"
            ]
          },
          "700090313": {
            "id": "700090313",
            "speakerId": 1599,
            "speakerName": "莉莉",
            "text": "欸…可是这些，都要去辣里找呀…",
            "nextDialogs": [
              "700090314"
            ]
          },
          "700090314": {
            "id": "700090314",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "交给我了。",
            "nextDialogs": [
              "700090315"
            ]
          },
          "700090315": {
            "id": "700090315",
            "speakerId": 1599,
            "speakerName": "莉莉",
            "text": "#哇！谢谢{PLAYERAVATAR#SEXPRO[INFO_MALE_PRONOUN_CUTEBIGBROTHER|INFO_FEMALE_PRONOUN_CUTEBIGSISTER]}，那窝们快点去喂它们吧！"
          }
        }
      }
    },
    {
      "subId": "7000907",
      "subQuestName": "向食盆中放入「禽肉」",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "700090701"
        ],
        "dialogs": {
          "700090701": {
            "id": "700090701",
            "speakerId": 1599,
            "speakerName": "莉莉",
            "text": "#就是这种大大的锅，{PLAYERAVATAR#SEXPRO[INFO_MALE_PRONOUN_CUTEBIGBROTHER|INFO_FEMALE_PRONOUN_CUTEBIGSISTER]}你等一下…",
            "nextDialogs": [
              "700090702"
            ]
          },
          "700090702": {
            "id": "700090702",
            "speakerId": 1599,
            "speakerName": "莉莉",
            "text": "#唔…窝要站在椅子上…{PLAYERAVATAR#SEXPRO[INFO_MALE_PRONOUN_CUTEBIGBROTHER|INFO_FEMALE_PRONOUN_CUTEBIGSISTER]}，帮我搬一把椅子过来吧…",
            "nextDialogs": [
              "700090703"
            ]
          },
          "700090703": {
            "id": "700090703",
            "speakerId": 1599,
            "speakerName": "莉莉",
            "text": "#做好啦！窝可做了三份喔，{PLAYERAVATAR#SEXPRO[INFO_MALE_PRONOUN_CUTEBIGBROTHER|INFO_FEMALE_PRONOUN_CUTEBIGSISTER]}你一份，我一份…还有那个驴人众的蜀黍一份！",
            "nextDialogs": [
              "700090704"
            ]
          },
          "700090704": {
            "id": "700090704",
            "speakerId": 1599,
            "speakerName": "莉莉",
            "text": "好啦，我们回去吧！"
          }
        }
      }
    },
    {
      "subId": "7000908",
      "subQuestName": "与莉莉对话",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "700090401"
        ],
        "dialogs": {
          "700090401": {
            "id": "700090401",
            "speakerId": 1599,
            "speakerName": "莉莉",
            "text": "狗狗来这边…有很好词的喔…",
            "nextDialogs": [
              "700090402"
            ]
          },
          "700090402": {
            "id": "700090402",
            "speakerId": 1599,
            "speakerName": "莉莉",
            "text": "哇！狗狗真过来了，嘻嘻，窝要去摸摸它啦…",
            "nextDialogs": [
              "700090403"
            ]
          },
          "700090403": {
            "id": "700090403",
            "speakerId": 1599,
            "speakerName": "莉莉",
            "text": "嘻嘻，狗狗摸起来好软…那个驴人众蜀黍说，他们家辣边，也有狠多狗狗。",
            "nextDialogs": [
              "700090404"
            ]
          },
          "700090404": {
            "id": "700090404",
            "speakerId": 1599,
            "speakerName": "莉莉",
            "text": "但他说，他家那边的狗狗，都狠大狠大，毛也狠多狠多…肯定也狠好摸吧…"
          }
        }
      }
    },
    {
      "subId": "7000909",
      "subQuestName": "(test)【隐藏】与莉莉对话黑屏刷掉狗$HIDDEN",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "700090901"
        ],
        "dialogs": {
          "700090901": {
            "id": "700090901",
            "speakerId": 1517,
            "speakerName": "维克多",
            "text": "风花节…哼，反正和我也没关系…"
          }
        }
      }
    },
    {
      "subId": "7000910",
      "subQuestName": "向布兰琪回报",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [],
        "dialogs": {}
      }
    },
    {
      "subId": "7000911",
      "subQuestName": "与芙萝拉对话",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "700090602"
        ],
        "dialogs": {
          "700090602": {
            "id": "700090602",
            "speakerId": 1425,
            "speakerName": "芙萝拉",
            "text": "呼呼，你们好呀？你们是来买花的吗？",
            "nextDialogs": [
              "700090603"
            ]
          },
          "700090603": {
            "id": "700090603",
            "speakerId": 1599,
            "speakerName": "莉莉",
            "text": "真的有好多花花…",
            "nextDialogs": [
              "700090604"
            ]
          },
          "700090604": {
            "id": "700090604",
            "speakerId": 1425,
            "speakerName": "芙萝拉",
            "text": "咦，莉莉？你怎么和这位旅行者在一起？",
            "nextDialogs": [
              "700090605"
            ]
          },
          "700090605": {
            "id": "700090605",
            "speakerId": 1599,
            "speakerName": "莉莉",
            "text": "#把拔和麻麻有很纵要的事要做！所以这个{PLAYERAVATAR#SEXPRO[INFO_MALE_PRONOUN_CUTEBIGBROTHER|INFO_FEMALE_PRONOUN_CUTEBIGSISTER]}在带我玩。",
            "nextDialogs": [
              "700090606"
            ]
          },
          "700090606": {
            "id": "700090606",
            "speakerId": 1425,
            "speakerName": "芙萝拉",
            "text": "重要的事啊…我差不多也猜到了…",
            "nextDialogs": [
              "700090607"
            ]
          },
          "700090607": {
            "id": "700090607",
            "speakerId": 1425,
            "speakerName": "芙萝拉",
            "text": "先不说这些了，你们有什么事吗？",
            "nextDialogs": [
              "700090608"
            ]
          },
          "700090608": {
            "id": "700090608",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "是来看花的。",
            "nextDialogs": [
              "700090609"
            ]
          },
          "700090609": {
            "id": "700090609",
            "speakerId": 1425,
            "speakerName": "芙萝拉",
            "text": "看花…唔，这样吧，我这里刚好有一株蒲公英，送给你吧莉莉。",
            "nextDialogs": [
              "700090610"
            ]
          },
          "700090610": {
            "id": "700090610",
            "speakerId": 1599,
            "speakerName": "莉莉",
            "text": "真的嘛？谢谢——",
            "nextDialogs": [
              "700090611"
            ]
          },
          "700090611": {
            "id": "700090611",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "为什么突然就…",
            "nextDialogs": [
              "700090612"
            ]
          },
          "700090612": {
            "id": "700090612",
            "speakerId": 1425,
            "speakerName": "芙萝拉",
            "text": "其实…是因为鲁道夫先生之前刚在我这里订了一大捧花，要送给吉丽安娜小姐…",
            "nextDialogs": [
              "700090613"
            ]
          },
          "700090613": {
            "id": "700090613",
            "speakerId": 1425,
            "speakerName": "芙萝拉",
            "text": "现在只是送一株蒲公英而已，没什么大问题…",
            "nextDialogs": [
              "700090614"
            ]
          },
          "700090614": {
            "id": "700090614",
            "speakerId": 1599,
            "speakerName": "莉莉",
            "text": "蒲公英真好看…不过，窝应该要回去了，不然把拔麻麻回来看不见我会着急的…",
            "nextDialogs": [
              "700090615"
            ]
          },
          "700090615": {
            "id": "700090615",
            "speakerId": 1599,
            "speakerName": "莉莉",
            "text": "#对了，回去之前…{PLAYERAVATAR#SEXPRO[INFO_MALE_PRONOUN_CUTEBIGBROTHER|INFO_FEMALE_PRONOUN_CUTEBIGSISTER]}，尼知道城里哪里有那种…大大的锅吗？",
            "nextDialogs": [
              "700090616"
            ]
          },
          "700090616": {
            "id": "700090616",
            "speakerId": 1599,
            "speakerName": "莉莉",
            "text": "#窝之前看过我麻麻做「烤松饼」…{PLAYERAVATAR#SEXPRO[INFO_MALE_PRONOUN_CUTEBIGBROTHER|INFO_FEMALE_PRONOUN_CUTEBIGSISTER]}陪我玩了这么久，窝来做点好次的给尼吧！"
          }
        }
      }
    },
    {
      "subId": "7000912",

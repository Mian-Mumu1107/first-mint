  "subQuests": [
    {
      "subId": "7618201",
      "subQuestName": "前往隐居处开启茶会",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "761820101"
        ],
        "dialogs": {
          "761820101": {
            "id": "761820101",
            "speakerId": 1000,
            "speakerName": "「少女」",
            "text": "这就是你曾经生活的地方吗？真漂亮。",
            "nextDialogs": [
              "761820102"
            ]
          },
          "761820102": {
            "id": "761820102",
            "speakerId": 1001,
            "speakerName": "「木偶」",
            "text": "以前更漂亮。我打理花园可是很有一手的。",
            "nextDialogs": [
              "761820103"
            ]
          },
          "761820103": {
            "id": "761820103",
            "speakerId": 1000,
            "speakerName": "「少女」",
            "text": "哈哈。",
            "nextDialogs": [
              "761820104"
            ]
          },
          "761820104": {
            "id": "761820104",
            "speakerId": 1001,
            "speakerName": "「木偶」",
            "text": "你又傻笑什么…",
            "nextDialogs": [
              "761820105"
            ]
          },
          "761820105": {
            "id": "761820105",
            "speakerId": 1000,
            "speakerName": "「少女」",
            "text": "想象了一下那时的桑多涅蹲在花丛边的样子，觉得很可爱。",
            "nextDialogs": [
              "761820106"
            ]
          },
          "761820106": {
            "id": "761820106",
            "speakerId": 1000,
            "speakerName": "「少女」",
            "text": "我等下可以进屋看看吗？",
            "nextDialogs": [
              "761820107"
            ]
          },
          "761820107": {
            "id": "761820107",
            "speakerId": 1001,
            "speakerName": "「木偶」",
            "text": "当然，我已经把灰尘都清理过一遍了。",
            "nextDialogs": [
              "761820108"
            ]
          },
          "761820108": {
            "id": "761820108",
            "speakerId": 1000,
            "speakerName": "「少女」",
            "text": "你今后打算怎么处理这个家？",
            "nextDialogs": [
              "761820109"
            ]
          },
          "761820109": {
            "id": "761820109",
            "speakerId": 1001,
            "speakerName": "「木偶」",
            "text": "嗯…果然还是想留下它。有时间就回来打理一下吧。",
            "nextDialogs": [
              "761820110"
            ]
          },
          "761820110": {
            "id": "761820110",
            "speakerId": 1000,
            "speakerName": "「少女」",
            "text": "没时间的话，我也可以来帮你打理。",
            "nextDialogs": [
              "761820111"
            ]
          },
          "761820111": {
            "id": "761820111",
            "speakerId": 1000,
            "speakerName": "「少女」",
            "text": "这里和曾经你房间给我的感觉一样，令人安心。我很喜欢。",
            "nextDialogs": [
              "761820112"
            ]
          },
          "761820112": {
            "id": "761820112",
            "speakerId": 1001,
            "speakerName": "「木偶」",
            "text": "哼…随你便吧。"
          }
        }
      }
    },
    {

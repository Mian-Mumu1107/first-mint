{
  "lineCounts": {
    "Black Screen": 1,
    "Player": 8,
    "斯万": 7,
    "菲利斯·尤格": 35
  },
  "subQuests": [
    {
      "subId": "7051401",
      "subQuestName": "与菲利斯·尤格对话",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "705140101"
        ],
        "dialogs": {
          "705140101": {
            "id": "705140101",
            "speakerId": 1000,
            "speakerName": "菲利斯·尤格",
            "text": "蒙德的热情真是超乎我想象…真是名不虚传，就连那些丘丘人也这么有活力。",
            "nextDialogs": [
              "705140102"
            ]
          },
          "705140102": {
            "id": "705140102",
            "speakerId": 1001,
            "speakerName": "斯万",
            "text": "无论如何…尤格先生，请您千万不要再自己外出了。",
            "nextDialogs": [
              "705140103"
            ]
          },
          "705140103": {
            "id": "705140103",
            "speakerId": 1000,
            "speakerName": "菲利斯·尤格",
            "text": "什么？那我的机关怎么办，还差…呃…",
            "nextDialogs": [
              "705140104"
            ]
          },
          "705140104": {
            "id": "705140104",
            "speakerId": 1000,
            "speakerName": "菲利斯·尤格",
            "text": "一、二、三…十八个…十九个部件啊！",
            "nextDialogs": [
              "705140105"
            ]
          },
          "705140105": {
            "id": "705140105",
            "speakerId": 1001,
            "speakerName": "斯万",
            "text": "已经有冒险家在帮您找了，您就安安心心在城里等着吧…",
            "nextDialogs": [
              "705140106"
            ]
          },
          "705140106": {
            "id": "705140106",
            "speakerId": 1000,
            "speakerName": "菲利斯·尤格",
            "text": "但没有那些机关，我的…我的灵感，你知道吗？我的灵感来了怎么办？",
            "nextDialogs": [
              "705140107"
            ]
          },
          "705140107": {
            "id": "705140107",
            "speakerId": 1000,
            "speakerName": "菲利斯·尤格",
            "text": "灵感稍纵即逝啊，就像…就像喝完酒打出的嗝一样，稍纵即逝啊！",
            "nextDialogs": [
              "705140108"
            ]
          },
          "705140108": {
            "id": "705140108",
            "speakerId": 1000,
            "speakerName": "菲利斯·尤格",
            "text": "喔，这个比喻不错，我得记下来，泽维尔一定会喜欢的…",
            "nextDialogs": [
              "705140109"
            ]
          },
          "705140109": {
            "id": "705140109",
            "speakerId": 1001,
            "speakerName": "斯万",
            "text": "我…您…",
            "nextDialogs": [
              "705140110"
            ]
          },
          "705140110": {
            "id": "705140110",
            "speakerId": 1001,
            "speakerName": "斯万",
            "text": "咦？荣誉骑士…太好了，荣誉骑士！请您快些过来！",
            "nextDialogs": [
              "705140113"
            ]
          },
          "705140113": {
            "id": "705140113",
            "speakerId": 1001,
            "speakerName": "斯万",
            "text": "我介绍一下，这位是来自枫丹廷的…",
            "nextDialogs": [
              "705140114"
            ]
          },
          "705140114": {
            "id": "705140114",
            "speakerId": 1000,
            "speakerName": "菲利斯·尤格",
            "text": "空想家！我们这么称呼自己！",
            "nextDialogs": [
              "705140115"
            ]
          },
          "705140115": {
            "id": "705140115",
            "speakerId": 1001,
            "speakerName": "斯万",
            "text": "…尤格先生，这位是我们蒙德城的荣誉骑士…",
            "nextDialogs": [
              "705140116"
            ]
          },
          "705140116": {
            "id": "705140116",
            "speakerId": 1000,
            "speakerName": "菲利斯·尤格",
            "text": "啊哈！尤格，菲利斯·尤格！向您致敬，荣誉骑士！我早就听闻过您的诸多事迹了。",
            "nextDialogs": [
              "705140117"
            ]
          },
          "705140117": {
            "id": "705140117",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "你认识我？",
            "nextDialogs": [
              "705140118"
            ]
          },
          "705140118": {
            "id": "705140118",
            "speakerId": 1000,
            "speakerName": "菲利斯·尤格",
            "text": "当然，当然！我当然认识您了，谁能不认识您呀？",
            "nextDialogs": [
              "705140119"
            ]
          },
          "705140119": {
            "id": "705140119",
            "speakerId": 1000,
            "speakerName": "菲利斯·尤格",
            "text": "您之前在蒙德和风龙战斗的那段事迹，可是在《蒸汽鸟日报》的头条上占了足足三周啊。",
            "nextDialogs": [
              "705140120"
            ]
          },
          "705140120": {
            "id": "705140120",
            "speakerId": 1000,
            "speakerName": "菲利斯·尤格",
            "text": "哈哈哈，那帮记者如果知道我正在和您谈话，一定会嫉妒到睡不着的。",
            "nextDialogs": [
              "705140121"
            ]
          },
          "705140121": {
            "id": "705140121",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "《蒸汽鸟日报》是什么？",
            "nextDialogs": [
              "705140122"
            ]
          },
          "705140122": {
            "id": "705140122",
            "speakerId": 1000,
            "speakerName": "菲利斯·尤格",
            "text": "您不知道吗？《蒸汽鸟日报》是枫丹廷的一家…嗯…知名度颇高的报纸。",
            "nextDialogs": [
              "705140123"
            ]
          },
          "705140123": {
            "id": "705140123",
            "speakerId": 1000,
            "speakerName": "菲利斯·尤格",
            "text": "而您，曾经帮他们攀上了销量最高点。",
            "nextDialogs": [
              "705140125"
            ]
          },
          "705140125": {
            "id": "705140125",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "头、头条？",
            "nextDialogs": [
              "705140126"
            ]
          },
          "705140126": {
            "id": "705140126",
            "speakerId": 1000,
            "speakerName": "菲利斯·尤格",
            "text": "那当然，您可是曾经帮他们攀上了销量最高点啊。",
            "nextDialogs": [
              "705140127"
            ]
          },
          "705140127": {
            "id": "705140127",
            "speakerId": 1000,
            "speakerName": "菲利斯·尤格",
            "text": "头版头条，整刊篇幅，专家访谈，还搭配最好的手绘插图，哈！他们都赚疯了！",
            "nextDialogs": [
              "705140128"
            ]
          },
          "705140128": {
            "id": "705140128",
            "speakerId": 1001,
            "speakerName": "斯万",
            "text": "那…旅行者，菲利斯·尤格先生，你们先聊着，我…呃…我先去处理点别的事，先失陪了。",
            "nextDialogs": [
              "705140129"
            ]
          },
          "705140129": {
            "id": "705140129",
            "speakerId": 1002,
            "speakerName": "Black Screen",
            "text": "斯万飞快地离开了…",
            "nextDialogs": [
              "705140130"
            ]
          },
          "705140130": {
            "id": "705140130",
            "speakerId": 1000,
            "speakerName": "菲利斯·尤格",
            "text": "好吧，看来西风骑士团和我听说的一样，有着处理不完的事务…",
            "nextDialogs": [
              "705140131"
            ]
          },
          "705140131": {
            "id": "705140131",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "所以，你为什么会来蒙德？",
            "nextDialogs": [
              "705140132"
            ]
          },
          "705140132": {
            "id": "705140132",
            "speakerId": 1000,
            "speakerName": "菲利斯·尤格",
            "text": "我？事实上，我正计划着游历提瓦特。",
            "nextDialogs": [
              "705140133"
            ]
          },
          "705140133": {
            "id": "705140133",
            "speakerId": 1000,
            "speakerName": "菲利斯·尤格",
            "text": "而我游历的目的，则是要推销我制造的这种「动械核心」。",
            "nextDialogs": [
              "705140134"
            ]
          },
          "705140134": {
            "id": "705140134",
            "speakerId": 1000,
            "speakerName": "菲利斯·尤格",
            "text": "简单来说，它是一种发条式机关，只要隔段时间扭一扭发条，这种核心就能提供很长时间的动能。",
            "nextDialogs": [
              "705140135"
            ]
          },
          "705140135": {
            "id": "705140135",
            "speakerId": 1000,
            "speakerName": "菲利斯·尤格",
            "text": "为了展示这种机关，我还专门制作了一种以「动械核心」驱动的恒动型机关玩具，我将它命名为「恒动械画」。",
            "nextDialogs": [
              "705140136"
            ]
          },
          "705140136": {
            "id": "705140136",
            "speakerId": 1000,
            "speakerName": "菲利斯·尤格",
            "text": "呃…不过很遗憾，虽然我很想向您展示这种机关…",
            "nextDialogs": [
              "705140137"
            ]
          },
          "705140137": {
            "id": "705140137",
            "speakerId": 1000,
            "speakerName": "菲利斯·尤格",
            "text": "但这种机关实在是太出色，就连那些魔物也难抵它的魅力。",
            "nextDialogs": [
              "705140138"
            ]
          },
          "705140138": {
            "id": "705140138",
            "speakerId": 1000,
            "speakerName": "菲利斯·尤格",
            "text": "目前…我的机关正被魔物们不那么友好地分成了无数块，拿在手里细细把玩呢…",
            "nextDialogs": [
              "705140139"
            ]
          },
          "705140139": {
            "id": "705140139",
            "speakerId": 1000,
            "speakerName": "菲利斯·尤格",
            "text": "虽然我已经拜托了冒险家协会帮忙，但冒险家们也一直也没给我点消息…",
            "nextDialogs": [
              "705140140"
            ]
          },
          "705140140": {
            "id": "705140140",
            "speakerId": 1000,
            "speakerName": "菲利斯·尤格",
            "text": "荣誉骑士，如果您有兴趣的话，能不能帮我这个忙？",
            "nextDialogs": [
              "705140141"
            ]
          },
          "705140141": {
            "id": "705140141",
            "speakerId": 1000,
            "speakerName": "菲利斯·尤格",
            "text": "相信我，我的机关…和报酬，绝不会让您失望的！",
            "nextDialogs": [
              "705140142"
            ]
          },
          "705140142": {
            "id": "705140142",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "交给我吧。",
            "nextDialogs": [
              "705140143"
            ]
          },
          "705140143": {
            "id": "705140143",
            "speakerId": 1000,
            "speakerName": "菲利斯·尤格",
            "text": "太棒了，您果然和报纸上写的一样，既是个实力强大的冒险家，又富有同情心。",
            "nextDialogs": [
              "705140144"
            ]
          },
          "705140144": {
            "id": "705140144",
            "speakerId": 1000,
            "speakerName": "菲利斯·尤格",
            "text": "可惜现在咱们在蒙德，如果在枫丹廷，我一定要把《蒸汽鸟日报》的记者领到您这来，给您做个专访。",
            "nextDialogs": [
              "705140145"
            ]
          },
          "705140145": {
            "id": "705140145",
            "speakerId": 1000,
            "speakerName": "菲利斯·尤格",
            "text": "他们一定会再次被您的魅力折服，心甘情愿地把接下来三周的头版和稿酬都留给您！"
          }
        }
      }
    },
    {
      "subId": "7051402",
      "subQuestName": "回收零件",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [],
        "dialogs": {}
      }
    },
    {
      "subId": "7051403",
      "subQuestName": "与菲利斯·尤格对话",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "705140301"
        ],
        "dialogs": {
          "705140301": {
            "id": "705140301",
            "speakerId": 1000,
            "speakerName": "菲利斯·尤格",
            "text": "荣誉骑士！您回来了，零件的事怎么样了？",
            "nextDialogs": [
              "705140302"
            ]
          },
          "705140302": {
            "id": "705140302",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "是这些吗？"
          }
        }
      }
    },
    {
      "subId": "7051404",
      "subQuestName": "与菲利斯·尤格对话",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "705140401"
        ],
        "dialogs": {
          "705140401": {
            "id": "705140401",
            "speakerId": 1000,
            "speakerName": "菲利斯·尤格",
            "text": "就是这些！就是这些！太棒了，我的零件，天呐！",
            "nextDialogs": [
              "705140402"
            ]
          },
          "705140402": {
            "id": "705140402",
            "speakerId": 1000,
            "speakerName": "菲利斯·尤格",
            "text": "既然零件已经找齐了，那接下来只要把这些零件组合起来就好…",
            "nextDialogs": [
              "705140403"
            ]
          },
          "705140403": {
            "id": "705140403",
            "speakerId": 1000,
            "speakerName": "菲利斯·尤格",
            "text": "唔…荣誉骑士，如果您有兴趣的话，也可以来试试拼接这幅「恒动械画」部件。",
            "nextDialogs": [
              "705140404"
            ]
          },
          "705140404": {
            "id": "705140404",
            "speakerId": 1000,
            "speakerName": "菲利斯·尤格",
            "text": "相信我，这一定会很有趣的。"
          }
        }
      }
    },
    {
      "subId": "7051405",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "705140501"
        ],
        "dialogs": {
          "705140501": {
            "id": "705140501",
            "speakerId": 1000,
            "speakerName": "菲利斯·尤格",
            "text": "#那么零件的事就拜托您了，荣誉骑士{M#先生}{F#小姐}。"
          }
        }
      }
    }
  ]
}
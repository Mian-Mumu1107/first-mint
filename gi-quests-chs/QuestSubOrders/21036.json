    {
      "subId": "2103604",
      "subQuestName": "与孙宇对话",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "210360401"
        ],
        "dialogs": {
          "210360401": {
            "id": "210360401",
            "speakerId": 1000,
            "speakerName": "孙宇",
            "text": "呼…呼…真是难以对付…",
            "nextDialogs": [
              "210360402"
            ]
          },
          "210360402": {
            "id": "210360402",
            "speakerId": 1000,
            "speakerName": "孙宇",
            "text": "抱歉，让你见笑了。看来我还是没多少长进…",
            "nextDialogs": [
              "210360403"
            ]
          },
          "210360403": {
            "id": "210360403",
            "speakerId": 1000,
            "speakerName": "孙宇",
            "text": "我还是需要多多锻炼…多谢了旅行者，这些报酬给你，请收下吧。",
            "nextDialogs": [
              "210360404"
            ]
          },
          "210360404": {
            "id": "210360404",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "你要怎么离开璃月？",
            "nextDialogs": [
              "210360405"
            ]
          },
          "210360405": {
            "id": "210360405",
            "speakerId": 1000,
            "speakerName": "孙宇",
            "text": "唔…我现在打算的是，搭那位客商的船，从水路向外旅行。",
            "nextDialogs": [
              "210360406"
            ]
          },
          "210360406": {
            "id": "210360406",
            "speakerId": 1000,
            "speakerName": "孙宇",
            "text": "第一站…我想先去枫丹看看，然后在那里待一段时间，之后再做打算。",
            "nextDialogs": [
              "210360407"
            ]
          },
          "210360407": {
            "id": "210360407",
            "speakerId": 1000,
            "speakerName": "孙宇",
            "text": "唉，也不知道我能不能说服师妹和我同行…"
          }
        }
      }
    },

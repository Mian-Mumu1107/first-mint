  "subQuests": [
    {
      "subId": "2103601",
      "subQuestName": "与孙宇对话",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "210360201"
        ],
        "dialogs": {
          "210360201": {
            "id": "210360201",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "对抗敌人。",
            "nextDialogs": [
              "210360202"
            ]
          },
          "210360202": {
            "id": "210360202",
            "speakerId": 1000,
            "speakerName": "孙宇",
            "text": "好！我早就想要把我学习的剑术用在实处了…",
            "nextDialogs": [
              "210360203"
            ]
          },
          "210360203": {
            "id": "210360203",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "只怕你看不清我的动作。",
            "nextDialogs": [
              "210360204"
            ]
          },
          "210360204": {
            "id": "210360204",
            "speakerId": 1000,
            "speakerName": "孙宇",
            "text": "这…阁下武艺竟如此高强？哈哈哈，那就只能请阁下把动作稍稍放慢些啦。",
            "nextDialogs": [
              "210360205"
            ]
          },
          "210360205": {
            "id": "210360205",
            "speakerId": 1000,
            "speakerName": "孙宇",
            "text": "我看看…附近就有一处魔物的聚集地，咱们就先去那里好了。"
          }
        }
      }
    },

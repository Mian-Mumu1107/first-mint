    {
      "subId": "2103606",
      "subQuestName": "(test)记录跑酷对话$HIDDEN",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "210360301"
        ],
        "dialogs": {
          "210360301": {
            "id": "210360301",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "越野训练。",
            "nextDialogs": [
              "210360302"
            ]
          },
          "210360302": {
            "id": "210360302",
            "speakerId": 1000,
            "speakerName": "孙宇",
            "text": "那就太好了，那位冒险家帮我规划了一条越野路线…唉，我能进来这里锻炼，也是托了她的福。",
            "nextDialogs": [
              "210360303"
            ]
          },
          "210360303": {
            "id": "210360303",
            "speakerId": 1000,
            "speakerName": "孙宇",
            "text": "她说我只要尽快到达终点就好…但我每次用的时间都实在太长…",
            "nextDialogs": [
              "210360304"
            ]
          },
          "210360304": {
            "id": "210360304",
            "speakerId": 1000,
            "speakerName": "孙宇",
            "text": "所以，我想拜托你为我示范一下如何快速「越野」，我会在后面努力跟上的。",
            "nextDialogs": [
              "210360308",
              "210360307"
            ]
          },
          "210360308": {
            "id": "210360308",
            "speakerId": 1000,
            "speakerName": "孙宇",
            "text": "那就拜托你了，我们先去训练地点吧。"
          },
          "210360307": {
            "id": "210360307",
            "speakerId": 1000,
            "speakerName": "孙宇",
            "text": "咳…我…我努力跟上，但说实话，我的脚力实在是有限啊…"
          }
        }
      }
    },
    {
      "subId": "2103602",

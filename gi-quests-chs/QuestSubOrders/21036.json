    {
      "subId": "2103601",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "210360101"
        ],
        "dialogs": {
          "210360101": {
            "id": "210360101",
            "speakerId": 1000,
            "speakerName": "孙宇",
            "text": "旅行者，我们又见面了。",
            "nextDialogs": [
              "210360103",
              "210360105"
            ]
          },
          "210360103": {
            "id": "210360103",
            "speakerId": 1000,
            "speakerName": "孙宇",
            "text": "是的，只不过…实在是有些辛苦。也不知道我是真的实力不济，还是用错了锻炼方法…",
            "nextDialogs": [
              "210360108"
            ]
          },
          "210360108": {
            "id": "210360108",
            "speakerId": 1000,
            "speakerName": "孙宇",
            "text": "先不说这些了。上次和你同行时，你的招式和动作都给了我很大启发。",
            "nextDialogs": [
              "210360109"
            ]
          },
          "210360109": {
            "id": "210360109",
            "speakerId": 1000,
            "speakerName": "孙宇",
            "text": "旅行者，请你今天再陪我出去锻炼一次吧。",
            "nextDialogs": [
              "210360110"
            ]
          },
          "210360110": {
            "id": "210360110",
            "speakerId": 1000,
            "speakerName": "孙宇",
            "text": "还是和上次一样，「对抗敌人」和「越野训练」两项，你方便陪我进行哪项锻炼？"
          },
          "210360105": {
            "id": "210360105",
            "speakerId": 1000,
            "speakerName": "孙宇",
            "text": "咳…师妹她…最近总是说城里有事要处理，一直也没回来过…",
            "nextDialogs": [
              "210360106"
            ]
          },
          "210360106": {
            "id": "210360106",
            "speakerId": 1000,
            "speakerName": "孙宇",
            "text": "我去找她说过几次，但她都只是让芷若出来挡住我，始终也不肯见我。",
            "nextDialogs": [
              "210360107"
            ]
          },
          "210360107": {
            "id": "210360107",
            "speakerId": 1000,
            "speakerName": "孙宇",
            "text": "唉，我也不知道怎么劝好她…"
          }
        }
      }
    },

    {
      "subId": "2103608",
      "subQuestName": "开始「锻炼」",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "210360801"
        ],
        "dialogs": {
          "210360801": {
            "id": "210360801",
            "speakerId": 1000,
            "speakerName": "孙宇",
            "text": "呼…呼…呼…你怎么…怎么能跑得这么快…",
            "nextDialogs": [
              "210360803",
              "210360805"
            ]
          },
          "210360803": {
            "id": "210360803",
            "speakerId": 1000,
            "speakerName": "孙宇",
            "text": "甘拜下风…甘拜下风…",
            "nextDialogs": [
              "210360806"
            ]
          },
          "210360806": {
            "id": "210360806",
            "speakerId": 1000,
            "speakerName": "孙宇",
            "text": "呼…总算是把气喘匀了。没想到「越野」居然这么累人…",
            "nextDialogs": [
              "210360807"
            ]
          },
          "210360807": {
            "id": "210360807",
            "speakerId": 1000,
            "speakerName": "孙宇",
            "text": "谢谢你给我做示范，旅行者，这些报酬请你收下吧。"
          },
          "210360805": {
            "id": "210360805",
            "speakerId": 1000,
            "speakerName": "孙宇",
            "text": "你说得…说得对…"
          }
        }
      }
    },

    {
      "subId": "7007407",
      "subQuestName": "悄悄接近鸽子",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "700740701"
        ],
        "dialogs": {
          "700740701": {
            "id": "700740701",
            "speakerId": 1001,
            "speakerName": "法尔伽",
            "text": "地上好像有鸽子的痕迹？在这里稍微等一会儿吧。",
            "nextDialogs": [
              "700740702"
            ]
          },
          "700740702": {
            "id": "700740702",
            "speakerId": 1001,
            "speakerName": "法尔伽",
            "text": "等鸽子出现就静静地走到它们身边，再撒下饲料…千万不要伤害它们哦？你准备好了吗？"
          }
        }
      }
    },
    {
      "subId": "7007408",
      "subQuestName": "与法尔伽对话",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "700740801"
        ],
        "dialogs": {
          "700740801": {
            "id": "700740801",
            "speakerId": 1005,
            "speakerName": "鸽子",
            "text": "咕咕——",
            "nextDialogs": [
              "700740802"
            ]
          },
          "700740802": {
            "id": "700740802",
            "speakerId": 1001,
            "speakerName": "法尔伽",
            "text": "羽毛！我拿到了！",
            "nextDialogs": [
              "700740803"
            ]
          },
          "700740803": {
            "id": "700740803",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "可算拿到了，这课题确实比想象的要艰难…",
            "nextDialogs": [
              "700740804"
            ]
          },
          "700740804": {
            "id": "700740804",
            "speakerId": 1001,
            "speakerName": "法尔伽",
            "text": "只差一步了…「大锅烹煮的药汤」，没记错的话是在达达乌帕谷吧？",
            "nextDialogs": [
              "700740805"
            ]
          },
          "700740805": {
            "id": "700740805",
            "speakerId": 1001,
            "speakerName": "法尔伽",
            "text": "我这就过去，你们快点跟上来！",
            "nextDialogs": [
              "700740806"
            ]
          },
          "700740806": {
            "id": "700740806",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "喂——这家伙，兴致也太高了吧？跑得比飞得还快？",
            "nextDialogs": [
              "700740809"
            ]
          },
          "700740809": {
            "id": "700740809",
            "speakerId": 1003,
            "speakerName": "迪奥娜",
            "text": "…那个酒鬼大叔…！",
            "nextDialogs": [
              "700740810"
            ]
          },
          "700740810": {
            "id": "700740810",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "嗯？谁在那里？",
            "nextDialogs": [
              "700740811"
            ]
          },
          "700740811": {
            "id": "700740811",
            "speakerId": 1003,
            "speakerName": "迪奥娜",
            "text": "…呀！",
            "nextDialogs": [
              "700740812"
            ]
          },
          "700740812": {
            "id": "700740812",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "迪奥娜？你怎么在这里？还专门藏起来了…",
            "nextDialogs": [
              "700740813"
            ]
          },
          "700740813": {
            "id": "700740813",
            "speakerId": 1003,
            "speakerName": "迪奥娜",
            "text": "我…我就只是出门采点果子，没想到突然就碰到那个大叔…",
            "nextDialogs": [
              "700740814"
            ]
          },
          "700740814": {
            "id": "700740814",
            "speakerId": 1003,
            "speakerName": "迪奥娜",
            "text": "他最近老是缠着我不放，想让我再给他调一次上回的酒…我被烦得不行，就只好到处躲着他了…",
            "nextDialogs": [
              "700740815"
            ]
          },
          "700740815": {
            "id": "700740815",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "上回的酒…是什么情况？",
            "nextDialogs": [
              "700740816"
            ]
          },
          "700740816": {
            "id": "700740816",
            "speakerId": 1003,
            "speakerName": "迪奥娜",
            "text": "他前阵子不是和一些远征军一起回来了吗？就到猫尾酒馆里喝庆功酒…",
            "nextDialogs": [
              "700740817"
            ]
          },
          "700740817": {
            "id": "700740817",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "猫尾酒馆？我还以为会在骑士团里开…",
            "nextDialogs": [
              "700740818"
            ]
          },
          "700740818": {
            "id": "700740818",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "我还以为会去「天使的馈赠」…",
            "nextDialogs": [
              "700740819"
            ]
          },
          "700740819": {
            "id": "700740819",
            "speakerId": 1003,
            "speakerName": "迪奥娜",
            "text": "呃…他们全都去了。猫尾酒馆已经是第三轮了——城里所有酒馆他们都打算喝上一轮。",
            "nextDialogs": [
              "700740820"
            ]
          },
          "700740820": {
            "id": "700740820",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "…我强烈怀疑等下一波远征军回来，他们还能用这借口再喝一轮。",
            "nextDialogs": [
              "700740821"
            ]
          },
          "700740821": {
            "id": "700740821",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "我毫不怀疑。",
            "nextDialogs": [
              "700740822"
            ]
          },
          "700740822": {
            "id": "700740822",
            "speakerId": 1003,
            "speakerName": "迪奥娜",
            "text": "…总之！那帮酒鬼大叔的样子，我实在是看不下去了！就想调杯最难喝最反胃的饮料让他们醒一醒！"
          }
        }
      }
    },
    {
      "subId": "7007409",
      "subQuestName": "前往达达乌帕谷",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "700740901"
        ],
        "dialogs": {
          "700740901": {
            "id": "700740901",
            "speakerId": 1006,
            "speakerName": "艾拉·马斯克",
            "text": "难以置信…丘丘人居然这么好说话了？",
            "nextDialogs": [
              "700740902"
            ]
          },
          "700740902": {
            "id": "700740902",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "艾拉！你有看到法尔伽吗！",
            "nextDialogs": [
              "700740903"
            ]
          },
          "700740903": {
            "id": "700740903",
            "speakerId": 1006,
            "speakerName": "艾拉·马斯克",
            "text": "嗯，他刚刚说是要去向丘丘人借锅子用…然后丘丘人一见到他，就连忙把锅给让出来了。",
            "nextDialogs": [
              "700740904"
            ]
          },
          "700740904": {
            "id": "700740904",
            "speakerId": 1006,
            "speakerName": "艾拉·马斯克",
            "text": "明明也没有交流几句，怎么会这么顺利？难道大团长还掌握了我不知道的丘丘人肢体语言？",
            "nextDialogs": [
              "700740907"
            ]
          },
          "700740907": {
            "id": "700740907",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "——重点不在这吧喂！法尔伽他现在人呢！",
            "nextDialogs": [
              "700740908"
            ]
          },
          "700740908": {
            "id": "700740908",
            "speakerId": 1006,
            "speakerName": "艾拉·马斯克",
            "text": "喏——就在那儿呢。",
            "nextDialogs": [
              "700740909"
            ]
          },
          "700740909": {
            "id": "700740909",
            "speakerId": 1001,
            "speakerName": "法尔伽",
            "text": "终于…完成了！全提瓦特最棒的美酒！此时此刻，就在我的手中！",
            "nextDialogs": [
              "700740910"
            ]
          },
          "700740910": {
            "id": "700740910",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "法尔伽——",
            "nextDialogs": [
              "700740911"
            ]
          },
          "700740911": {
            "id": "700740911",
            "speakerId": 1001,
            "speakerName": "法尔伽",
            "text": "哦？你们可算来了啊？那些丘丘人意外地很通情达理嘛，调酒的进度比想象得要快一点。",
            "nextDialogs": [
              "700740912"
            ]
          },
          "700740912": {
            "id": "700740912",
            "speakerId": 1001,
            "speakerName": "法尔伽",
            "text": "现在，就是品鉴之时！",
            "nextDialogs": [
              "700740913"
            ]
          },
          "700740913": {
            "id": "700740913",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "——你先别喝！",
            "nextDialogs": [
              "700740914"
            ]
          },
          "700740914": {
            "id": "700740914",
            "speakerId": 1001,
            "speakerName": "法尔伽",
            "text": "嗯？你们是想尝第一杯？哼哼…这第一杯的荣耀我是绝对不会让出去的！",
            "nextDialogs": [
              "700740915"
            ]
          },
          "700740915": {
            "id": "700740915",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "不是这个问题！",
            "nextDialogs": [
              "700740916"
            ]
          },
          "700740916": {
            "id": "700740916",
            "speakerId": 1001,
            "speakerName": "法尔伽",
            "text": "放心吧！我会给你们留一点的——",
            "nextDialogs": [
              "700740917"
            ]
          },
          "700740917": {
            "id": "700740917",
            "speakerId": 1001,
            "speakerName": "法尔伽",
            "text": "咕…咕…哈！",
            "nextDialogs": [
              "700740918"
            ]
          },
          "700740918": {
            "id": "700740918",
            "speakerId": 1001,
            "speakerName": "法尔伽",
            "text": "嗯？怎么感觉…有点…坏…",
            "nextDialogs": [
              "700740919"
            ]
          },
          "700740919": {
            "id": "700740919",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "法尔伽！你还好吗？法尔伽？法——尔——伽——！！"
          }
        }
      }
    },
    {
      "subId": "7007407",

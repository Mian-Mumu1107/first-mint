    {
      "subId": "7007403",
      "subQuestName": "在时限内击破所有木桩",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "700740301"
        ],
        "dialogs": {
          "700740301": {
            "id": "700740301",
            "speakerId": 1002,
            "speakerName": "艾琳",
            "text": "训练场就交给你们了！能亲眼目睹两位顶尖高手的风采，就算让我再等上三天也值啊！"
          }
        }
      }
    },
    {
      "subId": "7007410",
      "subQuestName": "击败特制木桩",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "700741001"
        ],
        "dialogs": {
          "700741001": {
            "id": "700741001",
            "speakerId": 1003,
            "speakerName": "迪奥娜",
            "text": "欸？那个酒鬼大叔…不会有事吧？"
          }
        }
      }
    },
    {
      "subId": "7007404",
      "subQuestName": "与法尔伽对话",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "700740401"
        ],
        "dialogs": {
          "700740401": {
            "id": "700740401",
            "speakerId": 1002,
            "speakerName": "艾琳",
            "text": "太厉害了！原来是用这种方式…",
            "nextDialogs": [
              "700740402"
            ]
          },
          "700740402": {
            "id": "700740402",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "…打住！这句话我耳朵都要听出茧子了！",
            "nextDialogs": [
              "700740403"
            ]
          },
          "700740403": {
            "id": "700740403",
            "speakerId": 1001,
            "speakerName": "法尔伽",
            "text": "嗯…这份木屑…不管是形状还是质感都很像…成色很不错！",
            "nextDialogs": [
              "700740404"
            ]
          },
          "700740404": {
            "id": "700740404",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "木屑究竟能有什么成色啦…不过你满意就行。下一份材料是…「欢欣而落的鸽羽」？"
          }
        }
      }
    },
    {
      "subId": "7007405",
      "subQuestName": "前往城门口",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "700740501"
        ],
        "dialogs": {
          "700740501": {
            "id": "700740501",
            "speakerId": 1004,
            "speakerName": "提米",
            "text": "喂！你们把鸽子全给…吓跑…了…",
            "nextDialogs": [
              "700740502"
            ]
          },
          "700740502": {
            "id": "700740502",
            "speakerId": 1004,
            "speakerName": "提米",
            "text": "…大…大团长？",
            "nextDialogs": [
              "700740503"
            ]
          },
          "700740503": {
            "id": "700740503",
            "speakerId": 1001,
            "speakerName": "法尔伽",
            "text": "哦？这不是小提米吗？看起来个子长高了不少啊？有在好好吃饭吗？",
            "nextDialogs": [
              "700740504"
            ]
          },
          "700740504": {
            "id": "700740504",
            "speakerId": 1004,
            "speakerName": "提米",
            "text": "有…有的！我一直记得您说的！想成为顶天立地的男子汉，就要好好吃饭！好好锻炼！",
            "nextDialogs": [
              "700740507"
            ]
          },
          "700740507": {
            "id": "700740507",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "没办法…我估计这座城里没有哪个小孩子不崇拜西风骑士团的当代传奇吧？",
            "nextDialogs": [
              "700740508"
            ]
          },
          "700740508": {
            "id": "700740508",
            "speakerId": 1001,
            "speakerName": "法尔伽",
            "text": "抱歉啊，把你的鸽子全吓跑了。",
            "nextDialogs": [
              "700740509"
            ]
          },
          "700740509": {
            "id": "700740509",
            "speakerId": 1001,
            "speakerName": "法尔伽",
            "text": "我刚好也想问一下，有什么方法能接近鸽子却不惊动它们…还能让它们保持心情愉悦吗？",
            "nextDialogs": [
              "700740510"
            ]
          },
          "700740510": {
            "id": "700740510",
            "speakerId": 1004,
            "speakerName": "提米",
            "text": "呃…我平时，会静静地走到它们身边，再撒下饲料…",
            "nextDialogs": [
              "700740511"
            ]
          },
          "700740511": {
            "id": "700740511",
            "speakerId": 1001,
            "speakerName": "法尔伽",
            "text": "——对了！就是这个！你身上还有多的饲料吗？",
            "nextDialogs": [
              "700740512"
            ]
          },
          "700740512": {
            "id": "700740512",
            "speakerId": 1004,
            "speakerName": "提米",
            "text": "饲料倒是有不少…不过…大团长…那个…你们是要…",
            "nextDialogs": [
              "700740513"
            ]
          },
          "700740513": {
            "id": "700740513",
            "speakerId": 1001,
            "speakerName": "法尔伽",
            "text": "放心吧，我向你保证——只是找它们借点羽毛而已，这是大人之间的约定！",
            "nextDialogs": [
              "700740514"
            ]
          },
          "700740514": {
            "id": "700740514",
            "speakerId": 1004,
            "speakerName": "提米",
            "text": "啊…好的！谢谢大团长！"
          }
        }
      }
    },
    {
      "subId": "7007406",
      "subQuestName": "前往鸽子出没处",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "700740601"
        ],
        "dialogs": {
          "700740601": {
            "id": "700740601",
            "speakerId": 1001,
            "speakerName": "法尔伽",
            "text": "地上好像有鸽子的痕迹？在这里稍微等一会儿吧。",
            "nextDialogs": [
              "700740602"
            ]
          },
          "700740602": {
            "id": "700740602",
            "speakerId": 1001,
            "speakerName": "法尔伽",
            "text": "等鸽子出现就静静地走到它们身边，再撒下饲料…千万不要伤害它们哦？你准备好了吗？"
          }
        }
      }
    },
    {
      "subId": "7007413",
      "subQuestName": "前往鸽子出没处",
      "sceneId": null,
      "locations": [],
      "dialogue": {

  "subQuests": [
    {
      "subId": "7007401",
      "subQuestName": "前往蒙德城",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "700740101"
        ],
        "dialogs": {
          "700740101": {
            "id": "700740101",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "说起来，明明是法尔伽跟魔女们开启的「会谈」，他自己的课题我们怎么就一直没注意呢？",
            "nextDialogs": [
              "700740102"
            ]
          },
          "700740102": {
            "id": "700740102",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "让我来翻翻看…法尔伽法尔伽…咦？怎么是…一行空白？",
            "nextDialogs": [
              "700740103"
            ]
          },
          "700740103": {
            "id": "700740103",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "要不找他自己问问？",
            "nextDialogs": [
              "700740104"
            ]
          },
          "700740104": {
            "id": "700740104",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "也对…要找他的话，感觉「酒馆」跟「餐馆」之类的地方会比较容易…",
            "nextDialogs": [
              "700740105"
            ]
          },
          "700740105": {
            "id": "700740105",
            "speakerId": 1001,
            "speakerName": "法尔伽",
            "text": "…还是不在吗？看来只能靠自己想办法了啊。",
            "nextDialogs": [
              "700740106"
            ]
          },
          "700740106": {
            "id": "700740106",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "正说着就出现了！",
            "nextDialogs": [
              "700740107"
            ]
          },
          "700740107": {
            "id": "700740107",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "嘿！法尔伽！我们想来问问关于「课题」的事…",
            "nextDialogs": [
              "700740108"
            ]
          },
          "700740108": {
            "id": "700740108",
            "speakerId": 1001,
            "speakerName": "法尔伽",
            "text": "哦？荣誉骑士跟派蒙！课题…？怎么突然问起这个？",
            "nextDialogs": [
              "700740111"
            ]
          },
          "700740111": {
            "id": "700740111",
            "speakerId": 1001,
            "speakerName": "法尔伽",
            "text": "课题…课题…啊，好像还真听艾莉丝讲过这么一回事？",
            "nextDialogs": [
              "700740112"
            ]
          },
          "700740112": {
            "id": "700740112",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "——不是因为你的「会谈」才有的「课题」吗！算了…还是说说，为什么你的课题是一行空白吧？",
            "nextDialogs": [
              "700740113"
            ]
          },
          "700740113": {
            "id": "700740113",
            "speakerId": 1001,
            "speakerName": "法尔伽",
            "text": "…嗯，恐怕是因为我的「课题」，对于那本小册子来说，有些太过沉重了。"
          }
        }
      }
    },
    {
      "subId": "7007402",
      "subQuestName": "前往骑士团训练场",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "700740201"
        ],
        "dialogs": {
          "700740201": {
            "id": "700740201",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "…说起「骑士击碎的木屑」，果然就是这里了吧？",
            "nextDialogs": [
              "700740202"
            ]
          },
          "700740202": {
            "id": "700740202",
            "speakerId": 1002,
            "speakerName": "艾琳",
            "text": "啊！大团长！荣誉骑士！你们今天也是来训练的吗？",
            "nextDialogs": [
              "700740203"
            ]
          },
          "700740203": {
            "id": "700740203",
            "speakerId": 1001,
            "speakerName": "法尔伽",
            "text": "为了追求「目标」而奋进…嗯，确实是一种训练呢。",
            "nextDialogs": [
              "700740204"
            ]
          },
          "700740204": {
            "id": "700740204",
            "speakerId": 1002,
            "speakerName": "艾琳",
            "text": "明明都已经这么强了，却还在精益求精吗…两位请随意训练吧！我会在旁边做笔记的！"
          }
        }
      }
    },
    {
      "subId": "7007412",

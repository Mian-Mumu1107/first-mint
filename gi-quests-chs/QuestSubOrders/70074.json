        "dialogs": {
          "700741002": {
            "id": "700741002",
            "speakerId": 1007,
            "speakerName": "Black Screen",
            "text": "艾琳搬出了新的木桩…"
          }
        }
      }
    },
    {
      "subId": "7007499",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "700749901"
        ],
        "dialogs": {
          "700749901": {
            "id": "700749901",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "骑士团里还有这种木桩吗！太大了吧！",
            "nextDialogs": [
              "700749902"
            ]
          },
          "700749902": {
            "id": "700749902",
            "speakerId": 1002,
            "speakerName": "艾琳",
            "text": "——是我父亲特制的珍藏款哦！这才配得上你们出手吧！",
            "nextDialogs": [
              "700749903"
            ]
          },
          "700749903": {
            "id": "700749903",
            "speakerId": 1001,
            "speakerName": "法尔伽",
            "text": "哈哈——那就试试这个！",
            "nextDialogs": [
              "700749904"
            ]
          },
          "700749904": {
            "id": "700749904",
            "speakerId": 1001,
            "speakerName": "法尔伽",
            "text": "嗯…不太行，这个成色跟那天不一样…再来一次吧。",
            "nextDialogs": [
              "700749905"
            ]
          },
          "700749905": {
            "id": "700749905",
            "speakerId": 1001,
            "speakerName": "法尔伽",
            "text": "喂喂——这不就把鸽子全吓走了吗！重新等它们飞回来吧…"
          }
        }
      }
    }
  ]
}
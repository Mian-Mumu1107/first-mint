    {
      "subId": "7219613",
      "subQuestName": "向稻叶久藏回报情况。",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "721961301"
        ],
        "dialogs": {
          "721961301": {
            "id": "721961301",
            "speakerId": 20291,
            "speakerName": "稻叶久藏",
            "text": "是外国人？有趣…",
            "nextDialogs": [
              "721961302"
            ]
          },
          "721961302": {
            "id": "721961302",
            "speakerId": 20291,
            "speakerName": "稻叶久藏",
            "text": "如果是游客的话，那你可来错地方了。",
            "nextDialogs": [
              "721961303"
            ]
          },
          "721961303": {
            "id": "721961303",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "你在做什么？",
            "nextDialogs": [
              "721961304"
            ]
          },
          "721961304": {
            "id": "721961304",
            "speakerId": 20291,
            "speakerName": "稻叶久藏",
            "text": "怎么，你是幕府的人？",
            "nextDialogs": [
              "721961305"
            ]
          },
          "721961305": {
            "id": "721961305",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "不是。",
            "nextDialogs": [
              "721961306"
            ]
          },
          "721961306": {
            "id": "721961306",
            "speakerId": 20291,
            "speakerName": "稻叶久藏",
            "text": "那就管好自己的事。",
            "nextDialogs": [
              "721961307"
            ]
          },
          "721961307": {
            "id": "721961307",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "这个家伙，怎么这么讨人厌！",
            "nextDialogs": [
              "721961308"
            ]
          },
          "721961308": {
            "id": "721961308",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "我是幕府派来的。",
            "nextDialogs": [
              "721961309"
            ]
          },
          "721961309": {
            "id": "721961309",
            "speakerId": 20291,
            "speakerName": "稻叶久藏",
            "text": "嗯，你们这些外国人…",
            "nextDialogs": [
              "721961310"
            ]
          },
          "721961310": {
            "id": "721961310",
            "speakerId": 20291,
            "speakerName": "稻叶久藏",
            "text": "在奉行大人面前摇尾乞怜，讨得点残渣剩饭，又在稻妻武士面前趾高气扬…",
            "nextDialogs": [
              "721961311"
            ]
          },
          "721961311": {
            "id": "721961311",
            "speakerId": 20291,
            "speakerName": "稻叶久藏",
            "text": "打探来打探去、到处搅混水不说…现在还专程跑来这条破船上，也不知有何贵干。",
            "nextDialogs": [
              "721961312"
            ]
          },
          "721961312": {
            "id": "721961312",
            "speakerId": 20291,
            "speakerName": "稻叶久藏",
            "text": "可惜呀，我不过一介伤兵，没什么能招待你的。",
            "nextDialogs": [
              "721961313"
            ]
          },
          "721961313": {
            "id": "721961313",
            "speakerId": 20291,
            "speakerName": "稻叶久藏",
            "text": "所以还要烦请大人自己用腿走出去。",
            "nextDialogs": [
              "721961314"
            ]
          },
          "721961314": {
            "id": "721961314",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "这家伙完全不会好好说话吗！",
            "nextDialogs": [
              "721961315"
            ]
          },
          "721961315": {
            "id": "721961315",
            "speakerId": 20291,
            "speakerName": "稻叶久藏",
            "text": "好了，你们太吵了。",
            "nextDialogs": [
              "721961316"
            ]
          },
          "721961316": {
            "id": "721961316",
            "speakerId": 20291,
            "speakerName": "稻叶久藏",
            "text": "临走前给你们一句忠告吧：别在八酝岛待太久，这座岛已经被诅咒了。",
            "nextDialogs": [
              "721961317"
            ]
          },
          "721961317": {
            "id": "721961317",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "诅咒…？",
            "nextDialogs": [
              "721961318"
            ]
          },
          "721961318": {
            "id": "721961318",
            "speakerId": 20291,
            "speakerName": "稻叶久藏",
            "text": "听不懂吗？这座岛被诅咒了。",
            "nextDialogs": [
              "721961319"
            ]
          },
          "721961319": {
            "id": "721961319",
            "speakerId": 20291,
            "speakerName": "稻叶久藏",
            "text": "停滞的战争、大人们的欲望、小人物的绝望、无辜受难者的憎恨，老人临终时弥漫满屋的药剂气味…",
            "nextDialogs": [
              "721961320"
            ]
          },
          "721961320": {
            "id": "721961320",
            "speakerId": 20291,
            "speakerName": "稻叶久藏",
            "text": "总而言之，就是诅咒。",
            "nextDialogs": [
              "721961321"
            ]
          },
          "721961321": {
            "id": "721961321",
            "speakerId": 20291,
            "speakerName": "稻叶久藏",
            "text": "趁你还没被压垮，赶紧离开吧。",
            "nextDialogs": [
              "721961322"
            ]
          },
          "721961322": {
            "id": "721961322",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "唔…完全听不懂，真是个怪人。"
          }
        }
      }
    },
    {
      "subId": "7219611",

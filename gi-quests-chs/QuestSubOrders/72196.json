{
  "lineCounts": {
    "Player": 11,
    "派蒙": 6,
    "稻叶久藏": 35
  },
  "subQuests": [
    {
      "subId": "7219614",
      "subQuestName": "用来创建npc任务$HIDDEN",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "721961401"
        ],
        "dialogs": {
          "721961401": {
            "id": "721961401",
            "speakerId": 20291,
            "speakerName": "稻叶久藏",
            "text": "怎么又是你？",
            "nextDialogs": [
              "721961402"
            ]
          },
          "721961402": {
            "id": "721961402",
            "speakerId": 20291,
            "speakerName": "稻叶久藏",
            "text": "我不是跟你说过——唉，算了。随你高兴吧。",
            "nextDialogs": [
              "721961403"
            ]
          },
          "721961403": {
            "id": "721961403",
            "speakerId": 20291,
            "speakerName": "稻叶久藏",
            "text": "别弄乱了我的东西，船上补给还够分你一点。满意了就快点离开。",
            "nextDialogs": [
              "721961404"
            ]
          },
          "721961404": {
            "id": "721961404",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "需要帮忙吗？",
            "nextDialogs": [
              "721961405"
            ]
          },
          "721961405": {
            "id": "721961405",
            "speakerId": 20291,
            "speakerName": "稻叶久藏",
            "text": "不需要。你没看到我过得很好吗？",
            "nextDialogs": [
              "721961406"
            ]
          },
          "721961406": {
            "id": "721961406",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "但你的伤口…",
            "nextDialogs": [
              "721961407"
            ]
          },
          "721961407": {
            "id": "721961407",
            "speakerId": 20291,
            "speakerName": "稻叶久藏",
            "text": "那是我的伤口，不是你的。",
            "nextDialogs": [
              "721961408"
            ]
          },
          "721961408": {
            "id": "721961408",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "喂，我们是出于好心才问的！",
            "nextDialogs": [
              "721961409"
            ]
          },
          "721961409": {
            "id": "721961409",
            "speakerId": 20291,
            "speakerName": "稻叶久藏",
            "text": "那我也出于好心回答你们：别烦我了。",
            "nextDialogs": [
              "721961410"
            ]
          },
          "721961410": {
            "id": "721961410",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "我可以帮你。",
            "nextDialogs": [
              "721961411"
            ]
          },
          "721961411": {
            "id": "721961411",
            "speakerId": 20291,
            "speakerName": "稻叶久藏",
            "text": "怎么帮我，把我交给幕府军吗？",
            "nextDialogs": [
              "721961412"
            ]
          },
          "721961412": {
            "id": "721961412",
            "speakerId": 20291,
            "speakerName": "稻叶久藏",
            "text": "哈哈，我劝你别犯傻了…我会被当成逃兵的。九条大人对逃兵从不留情面。",
            "nextDialogs": [
              "721961413"
            ]
          },
          "721961413": {
            "id": "721961413",
            "speakerId": 20291,
            "speakerName": "稻叶久藏",
            "text": "你要是真想帮我，就让我一个人好好静静吧。",
            "nextDialogs": [
              "721961414"
            ]
          },
          "721961414": {
            "id": "721961414",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "哇，这个油盐不进的家伙！"
          }
        }
      }
    },
    {
      "subId": "7219606",
      "subQuestName": "清除怪物营地1$HIDDEN",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "721960601"
        ],
        "dialogs": {
          "721960601": {
            "id": "721960601",
            "speakerId": 20291,
            "speakerName": "稻叶久藏",
            "text": "外国人，最近如何？",
            "nextDialogs": [
              "721960602"
            ]
          },
          "721960602": {
            "id": "721960602",
            "speakerId": 20291,
            "speakerName": "稻叶久藏",
            "text": "抱歉，这里不是待客的好地方。",
            "nextDialogs": [
              "721960603"
            ]
          },
          "721960603": {
            "id": "721960603",
            "speakerId": 20291,
            "speakerName": "稻叶久藏",
            "text": "不过…我很高兴你能来。",
            "nextDialogs": [
              "721960604"
            ]
          },
          "721960604": {
            "id": "721960604",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "你看起来好多了。",
            "nextDialogs": [
              "721960605"
            ]
          },
          "721960605": {
            "id": "721960605",
            "speakerId": 20291,
            "speakerName": "稻叶久藏",
            "text": "嗯，又欠你一个人情。",
            "nextDialogs": [
              "721960606"
            ]
          },
          "721960606": {
            "id": "721960606",
            "speakerId": 20291,
            "speakerName": "稻叶久藏",
            "text": "哈哈，真可惜我又撑下来了。",
            "nextDialogs": [
              "721960607"
            ]
          },
          "721960607": {
            "id": "721960607",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "这不是好事吗。有什么可惜的啦！"
          }
        }
      }
    },
    {
      "subId": "7219612",
      "subQuestName": "清除怪物营地2$HIDDEN",
      "sceneId": null,
      "locations": [],

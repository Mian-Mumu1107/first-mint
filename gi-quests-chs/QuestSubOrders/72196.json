    {
      "subId": "7219607",
      "subQuestName": "清除怪物营地3$HIDDEN",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "721960701"
        ],
        "dialogs": {
          "721960701": {
            "id": "721960701",
            "speakerId": 20291,
            "speakerName": "稻叶久藏",
            "text": "…附近的鼠辈又开始蠢蠢欲动了。",
            "nextDialogs": [
              "721960702"
            ]
          },
          "721960702": {
            "id": "721960702",
            "speakerId": 20291,
            "speakerName": "稻叶久藏",
            "text": "喂，外国人。在附近游荡的话，请小心海贼。",
            "nextDialogs": [
              "721960703"
            ]
          },
          "721960703": {
            "id": "721960703",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "谢谢。",
            "nextDialogs": [
              "721960704"
            ]
          },
          "721960704": {
            "id": "721960704",
            "speakerId": 20291,
            "speakerName": "稻叶久藏",
            "text": "应该的。",
            "nextDialogs": [
              "721960705"
            ]
          },
          "721960705": {
            "id": "721960705",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "他们不是我的对手。",
            "nextDialogs": [
              "721960706"
            ]
          },
          "721960706": {
            "id": "721960706",
            "speakerId": 20291,
            "speakerName": "稻叶久藏",
            "text": "哈哈，净说大话…",
            "nextDialogs": [
              "721960707"
            ]
          },
          "721960707": {
            "id": "721960707",
            "speakerId": 20291,
            "speakerName": "稻叶久藏",
            "text": "等你把他们都驱逐干净，再跟我说这种话吧！",
            "nextDialogs": [
              "721960708"
            ]
          },
          "721960708": {
            "id": "721960708",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "一言为定。",
            "nextDialogs": [
              "721960709"
            ]
          },
          "721960709": {
            "id": "721960709",
            "speakerId": 20291,
            "speakerName": "稻叶久藏",
            "text": "嗯，一言为定。"
          }
        }
      }
    },
    {
      "subId": "7219608",

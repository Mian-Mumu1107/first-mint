    {
      "subId": "2402103",
      "subQuestName": "与沙尔梅对话",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "240210501"
        ],
        "dialogs": {
          "240210501": {
            "id": "240210501",
            "speakerId": 1000,
            "speakerName": "沙尔梅",
            "text": "太好了，就是这个卷宗箱，您真是帮了大忙。",
            "nextDialogs": [
              "240210502"
            ]
          },
          "240210502": {
            "id": "240210502",
            "speakerId": 1000,
            "speakerName": "沙尔梅",
            "text": "这些东西请您收下吧。等我…哎哟！等我…好一点之后，就继续工作…",
            "nextDialogs": [
              "240210503"
            ]
          },
          "240210503": {
            "id": "240210503",
            "speakerId": 1000,
            "speakerName": "沙尔梅",
            "text": "唉，院里什么时候才能给我派个帮手过来…"
          }
        }
      }
    },
    {
      "subId": "2402104",
      "subQuestName": "与沙尔梅对话",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "240210601"
        ],
        "dialogs": {
          "240210601": {
            "id": "240210601",
            "speakerId": 1000,
            "speakerName": "沙尔梅",
            "text": "欸？您好像拿错卷宗箱了，不过…也没关系，这个箱子里也有许多要整理的资料。",
            "nextDialogs": [
              "240210602"
            ]
          },
          "240210602": {
            "id": "240210602",
            "speakerId": 1000,
            "speakerName": "沙尔梅",
            "text": "这些东西请您收下吧。等我…哎哟！等我…好一点之后，就继续工作…",
            "nextDialogs": [
              "240210603"
            ]
          },
          "240210603": {
            "id": "240210603",
            "speakerId": 1000,
            "speakerName": "沙尔梅",
            "text": "唉，院里什么时候才能给我派个帮手过来…"
          }
        }
      }
    },

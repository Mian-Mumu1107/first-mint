    },
    {
      "subId": "2402101",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "240210101"
        ],
        "dialogs": {
          "240210101": {
            "id": "240210101",
            "speakerId": 1000,
            "speakerName": "沙尔梅",
            "text": "痛…这箱子怎么这么重…",
            "nextDialogs": [
              "240210102"
            ]
          },
          "240210102": {
            "id": "240210102",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "你没事吧？",
            "nextDialogs": [
              "240210103"
            ]
          },
          "240210103": {
            "id": "240210103",
            "speakerId": 1000,
            "speakerName": "沙尔梅",
            "text": "荣誉高级研究员，又见到您了。真不好意思…我…我的腰好像受伤了，好痛…",
            "nextDialogs": [
              "240210104"
            ]
          },
          "240210104": {
            "id": "240210104",
            "speakerId": 1000,
            "speakerName": "沙尔梅",
            "text": "我之前准备去把一个箱子搬过来，整理一下里面装着的资料。",
            "nextDialogs": [
              "240210105"
            ]
          },
          "240210105": {
            "id": "240210105",
            "speakerId": 1000,
            "speakerName": "沙尔梅",
            "text": "我…我没想到那个箱子会有那么重，搬起来的时候一个没站住，所有的力量都吃在腰上。",
            "nextDialogs": [
              "240210106"
            ]
          },
          "240210106": {
            "id": "240210106",
            "speakerId": 1000,
            "speakerName": "沙尔梅",
            "text": "我现在…感觉腰都要断了，哎哟…",
            "nextDialogs": [
              "240210109"
            ]
          },
          "240210109": {
            "id": "240210109",
            "speakerId": 1000,
            "speakerName": "沙尔梅",
            "text": "不、不用…我之前也伤过腰，只要休息一下就好…",
            "nextDialogs": [
              "240210110"
            ]
          },
          "240210110": {
            "id": "240210110",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "到底是装着多少文件，会有这么重啊…",
            "nextDialogs": [
              "240210111"
            ]
          },
          "240210111": {
            "id": "240210111",
            "speakerId": 1000,
            "speakerName": "沙尔梅",
            "text": "应该是…很多很多卷宗吧，之前院内曾经推广过一段时间的「留痕式办公」。",
            "nextDialogs": [
              "240210112"
            ]
          },
          "240210112": {
            "id": "240210112",
            "speakerId": 1000,
            "speakerName": "沙尔梅",
            "text": "简单来说，就是院内所有的研究事务都必须留下纸质的办理证明。",
            "nextDialogs": [
              "240210113"
            ]
          },
          "240210113": {
            "id": "240210113",
            "speakerId": 1000,
            "speakerName": "沙尔梅",
            "text": "在这个办公方式推广之后，整个科学院的纸张消耗直接增长了五倍…",
            "nextDialogs": [
              "240210114"
            ]
          },
          "240210114": {
            "id": "240210114",
            "speakerId": 1000,
            "speakerName": "沙尔梅",
            "text": "因为文件太多，每一个办公室甚至被迫设立了一个「文材整理」的岗位，专门来将文件分门别类…",
            "nextDialogs": [
              "240210115"
            ]
          },
          "240210115": {
            "id": "240210115",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "也就说，所有事情都要记在纸上？听起来就好麻烦…",
            "nextDialogs": [
              "240210116"
            ]
          },
          "240210116": {
            "id": "240210116",
            "speakerId": 1000,
            "speakerName": "沙尔梅",
            "text": "是啊。后来这个办公方式也渐渐淡化，只在小范围内实行了。",
            "nextDialogs": [
              "240210117"
            ]
          },
          "240210117": {
            "id": "240210117",
            "speakerId": 1000,
            "speakerName": "沙尔梅",
            "text": "先不说这些…荣誉高级研究员，能请您帮我拿一下卷宗箱吗？虽然腰痛，但我还得快点整理好里面的卷宗才行…"
          }
        }
      }
    },

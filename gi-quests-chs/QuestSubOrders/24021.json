    {
      "subId": "2402107",
      "subQuestName": "",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "240210701"
        ],
        "dialogs": {
          "240210701": {
            "id": "240210701",
            "speakerId": 1000,
            "speakerName": "沙尔梅",
            "text": "您…您怎么把两个卷宗箱都拿来了？",
            "nextDialogs": [
              "240210703",
              "240210705"
            ]
          },
          "240210703": {
            "id": "240210703",
            "speakerId": 1000,
            "speakerName": "沙尔梅",
            "text": "噗…真有您的作风，谢谢啦。这两个卷宗箱里都有我要整理的文件。",
            "nextDialogs": [
              "240210706"
            ]
          },
          "240210706": {
            "id": "240210706",
            "speakerId": 1000,
            "speakerName": "沙尔梅",
            "text": "既然您把它们都拿来了，那我也该开始工作啦，这可是一份庞大的工作量啊。",
            "nextDialogs": [
              "240210707"
            ]
          },
          "240210707": {
            "id": "240210707",
            "speakerId": 1000,
            "speakerName": "沙尔梅",
            "text": "这些东西请您收下吧。再次感谢您帮忙，荣誉高级研究员。",
            "nextDialogs": [
              "240210708"
            ]
          },
          "240210708": {
            "id": "240210708",
            "speakerId": 1000,
            "speakerName": "沙尔梅",
            "text": "唉，院里什么时候才能给我派个帮手过来…"
          },
          "240210705": {
            "id": "240210705",
            "speakerId": 1000,
            "speakerName": "沙尔梅",
            "text": "您的直觉还真准。这两个卷宗箱里的确都有我要整理的文件。"
          }
        }
      }
    },
    {
      "subId": "2402108",
      "subQuestName": "与沙尔梅对话",
      "sceneId": null,
      "locations": [],

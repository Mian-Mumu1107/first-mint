  },
  "subQuests": [
    {
      "subId": "7566401",
      "subQuestName": "与巴罗对话",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "756640101"
        ],
        "dialogs": {
          "756640101": {
            "id": "756640101",
            "speakerId": 1000,
            "speakerName": "巴罗",
            "text": "#{NICKNAME}和派蒙！哈哈，终于见到真人了。",
            "nextDialogs": [
              "756640102"
            ]
          },
          "756640102": {
            "id": "756640102",
            "speakerId": 1000,
            "speakerName": "巴罗",
            "text": "欢迎来到荣花演武的主会场。我已经听首领们说过了，你们是来报名参赛的吧？",
            "nextDialogs": [
              "756640103"
            ]
          },
          "756640103": {
            "id": "756640103",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "是呀！不过我们还不是很了解，比赛的具体内容是什么呢？",
            "nextDialogs": [
              "756640104"
            ]
          },
          "756640104": {
            "id": "756640104",
            "speakerId": 1000,
            "speakerName": "巴罗",
            "text": "既然这样，由我来为你们简单介绍一下规则吧。",
            "nextDialogs": [
              "756640105"
            ]
          },
          "756640105": {
            "id": "756640105",
            "speakerId": 1000,
            "speakerName": "巴罗",
            "text": "首先呢，荣花演武会分成「进攻战」和「守备战」。",
            "nextDialogs": [
              "756640106"
            ]
          },
          "756640106": {
            "id": "756640106",
            "speakerId": 1000,
            "speakerName": "巴罗",
            "text": "守备战很好理解嘛，就是阻止对手进攻部族；进攻战要复杂一些，它是假定部族已经失守，现在要吹响反攻的号角。",
            "nextDialogs": [
              "756640107"
            ]
          },
          "756640107": {
            "id": "756640107",
            "speakerId": 1000,
            "speakerName": "巴罗",
            "text": "为了让比赛更有趣味性，我们制作了特殊的仪式道具。进攻方需要为它积蓄能量，破坏掉对手的特殊结界。",
            "nextDialogs": [
              "756640108"
            ]
          },
          "756640108": {
            "id": "756640108",
            "speakerId": 1000,
            "speakerName": "巴罗",
            "text": "还有，即使是比赛，我们也不想见到纯粹的暴力与冲突。打坏的东西要重新修好，另外遇到魔物也请及时清剿。",
            "nextDialogs": [
              "756640109"
            ]
          },
          "756640109": {
            "id": "756640109",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "#呜哇…我已经有点听晕了。{NICKNAME}，你记住了吗？",
            "nextDialogs": [
              "756640112"
            ]
          },
          "756640112": {
            "id": "756640112",
            "speakerId": 1000,
            "speakerName": "巴罗",
            "text": "没关系，有什么问题都可以来问我。而且比赛并不复杂，亲身参与几次，很快就能掌握要领。"
          }
        }
      }
    }
  ]
}
        ],
        "dialogs": {
          "102030201": {
            "id": "102030201",
            "speakerId": 1002,
            "speakerName": "可莉",
            "text": "呜…下次我会更小心的。",
            "nextDialogs": [
              "102030202"
            ]
          },
          "102030202": {
            "id": "102030202",
            "speakerId": 1002,
            "speakerName": "可莉",
            "text": "下一次，我会安全地完成一场伟大的冒险！",
            "nextDialogs": [
              "102030203"
            ]
          },
          "102030203": {
            "id": "102030203",
            "speakerId": 1002,
            "speakerName": "可莉",
            "text": "我听说「冒险家协会」也有一套冒险的守则，是不是应该去拜托他们呢…",
            "nextDialogs": [
              "102030204"
            ]
          },
          "102030204": {
            "id": "102030204",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "唉，要是这段话被塞琉斯会长听见了…",
            "nextDialogs": [
              "102030205"
            ]
          },
          "102030205": {
            "id": "102030205",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "他一定会去拜托琴团长，继续加长可莉的禁闭时间吧…"
          }
        }
      }
    },

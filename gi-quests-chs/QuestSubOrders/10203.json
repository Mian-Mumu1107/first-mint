    {
      "subId": "1020301",
      "subQuestName": "(test)与琴谈话$HIDDEN",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "102030101"
        ],
        "dialogs": {
          "102030101": {
            "id": "102030101",
            "speakerId": 1000,
            "speakerName": "琴",
            "text": "呼…可莉这孩子，其实是我们西风骑士团的「火花骑士」。",
            "nextDialogs": [
              "102030102"
            ]
          },
          "102030102": {
            "id": "102030102",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "什么？竟然连可莉都是骑士吗！",
            "nextDialogs": [
              "102030105"
            ]
          },
          "102030105": {
            "id": "102030105",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "没错，派蒙不甘心！",
            "nextDialogs": [
              "102030106"
            ]
          },
          "102030106": {
            "id": "102030106",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "话说回来，称号是「火花骑士」，也难怪可莉的宝物会是那种东西吧。",
            "nextDialogs": [
              "102030107"
            ]
          },
          "102030107": {
            "id": "102030107",
            "speakerId": 1000,
            "speakerName": "琴",
            "text": "嗯，虽然平时没有少给骑士团添麻烦，但骑士们还是很关心她。",
            "nextDialogs": [
              "102030108"
            ]
          },
          "102030108": {
            "id": "102030108",
            "speakerId": 1000,
            "speakerName": "琴",
            "text": "说起她的来历，其实…",
            "nextDialogs": [
              "102030109"
            ]
          },
          "102030109": {
            "id": "102030109",
            "speakerId": 1000,
            "speakerName": "琴",
            "text": "总之，以后你会对她有更多了解的。",
            "nextDialogs": [
              "102030110"
            ]
          },
          "102030110": {
            "id": "102030110",
            "speakerId": 1000,
            "speakerName": "琴",
            "text": "#到时也请你对她多关照些了，{NICKNAME}。"
          }
        }
      }
    },
    {
      "subId": "1020302",
      "subQuestName": "(test)自由对话可莉$HIDDEN",
      "sceneId": null,
      "locations": [],
      "dialogue": {

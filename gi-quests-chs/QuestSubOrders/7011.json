    {
      "subId": "701113",
      "subQuestName": "继续向前进行探索",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "70111301"
        ],
        "dialogs": {
          "70111301": {
            "id": "70111301",
            "speakerId": 10205,
            "speakerName": "？？？",
            "text": "—检测到接近者：权限…通过，原初的…正在启动…",
            "nextDialogs": [
              "70111302"
            ]
          },
          "70111302": {
            "id": "70111302",
            "speakerId": 10205,
            "speakerName": "？？？",
            "text": "您好，已然接近「明日」的超越…降临者，「灰{RUBY#[D]格赖埃之眼}眸」为您服务…",
            "nextDialogs": [
              "70111303"
            ]
          },
          "70111303": {
            "id": "70111303",
            "speakerId": 22280,
            "speakerName": "「灰眸」",
            "text": "距离上次启动已有…时间计量因…影响不可用，总之，应该是很长的时间了。",
            "nextDialogs": [
              "70111304"
            ]
          },
          "70111304": {
            "id": "70111304",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "你是…什么东西？",
            "nextDialogs": [
              "70111305"
            ]
          },
          "70111305": {
            "id": "70111305",
            "speakerId": 22280,
            "speakerName": "「灰眸」",
            "text": "我是…我是为了使命而诞生的，为了抵达「明日」…",
            "nextDialogs": [
              "70111306"
            ]
          },
          "70111306": {
            "id": "70111306",
            "speakerId": 22280,
            "speakerName": "「灰眸」",
            "text": "为此必须…奇怪，必须做什么，我…我的身体为什么…",
            "nextDialogs": [
              "70111307"
            ]
          },
          "70111307": {
            "id": "70111307",
            "speakerId": 22280,
            "speakerName": "「灰眸」",
            "text": "咦…我的身体怎么会是这个样子…",
            "nextDialogs": [
              "70111309",
              "70111311"
            ]
          },
          "70111309": {
            "id": "70111309",
            "speakerId": 22280,
            "speakerName": "「灰眸」",
            "text": "抱歉，似乎由于太久没有启动，所以很多内容佚失了。",
            "nextDialogs": [
              "70111312"
            ]
          },
          "70111312": {
            "id": "70111312",
            "speakerId": 22280,
            "speakerName": "「灰眸」",
            "text": "总之，我是为了人类能够抵达「明日」而被制造出来的…只是具体的内容暂时无法载入…",
            "nextDialogs": [
              "70111313"
            ]
          },
          "70111313": {
            "id": "70111313",
            "speakerId": 22280,
            "speakerName": "「灰眸」",
            "text": "不过比起那些，为「人类」服务仍然是我首要的目的，检测到您身躯表面失温，无法维持该状态行动太久…",
            "nextDialogs": [
              "70111314"
            ]
          },
          "70111314": {
            "id": "70111314",
            "speakerId": 22280,
            "speakerName": "「灰眸」",
            "text": "按被设定好的流程，在再次启动的时候，我要向唤醒我的人作这样的问询：",
            "nextDialogs": [
              "70111315"
            ]
          },
          "70111315": {
            "id": "70111315",
            "speakerId": 22280,
            "speakerName": "「灰眸」",
            "text": "您愿意接收我吗，超越之人，我将协助您，佑护您，达成使命，直至抵达「明日」——"
          },
          "70111311": {
            "id": "70111311",
            "speakerId": 22280,
            "speakerName": "「灰眸」",
            "text": "在被造出来的时候我是这样…但我也有曾经拥有型体的记忆和意识，与现在的状态相悖…"
          }
        }
      }
    },

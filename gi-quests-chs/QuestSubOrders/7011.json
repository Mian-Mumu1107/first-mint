    {
      "subId": "701107",
      "subQuestName": "与派蒙交谈",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "70110701"
        ],
        "dialogs": {
          "70110701": {
            "id": "70110701",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "我来看看你的留影技术是不是有进步了…嗯，等等，我好像看见了什么。",
            "nextDialogs": [
              "70110702"
            ]
          },
          "70110702": {
            "id": "70110702",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "快来，快来，这好像是个车厢！"
          }
        }
      }
    },
    {
      "subId": "701108",
      "subQuestName": "查看废弃的列车",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "70110801"
        ],
        "dialogs": {
          "70110801": {
            "id": "70110801",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "我听说至冬有很多铁轨和列车，这个应该就是吧！只是不知道为什么被废弃了…",
            "nextDialogs": [
              "70110802"
            ]
          },
          "70110802": {
            "id": "70110802",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "唔唔，还是好冷。",
            "nextDialogs": [
              "70110803"
            ]
          },
          "70110803": {
            "id": "70110803",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "是因为刚刚被雪埋了吗？",
            "nextDialogs": [
              "70110804"
            ]
          },
          "70110804": {
            "id": "70110804",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "不知道，有可能，而且我觉得雪是不是越来越大了。",
            "nextDialogs": [
              "70110805"
            ]
          },
          "70110805": {
            "id": "70110805",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "……",
            "nextDialogs": [
              "70110807",
              "70110809"
            ]
          },
          "70110807": {
            "id": "70110807",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "嗯，所以我感觉不是温度的原因…",
            "nextDialogs": [
              "70110810"
            ]
          },
          "70110810": {
            "id": "70110810",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "嗯…就是有种，很奇怪的感觉…之前没有过。",
            "nextDialogs": [
              "70110811"
            ]
          },
          "70110811": {
            "id": "70110811",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "身体…变得有点重，头也感觉有点晕…",
            "nextDialogs": [
              "70110812"
            ]
          },
          "70110812": {
            "id": "70110812",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "要不然先回头？",
            "nextDialogs": [
              "70110813"
            ]
          },
          "70110813": {
            "id": "70110813",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "没有没有，一点点，一点点而已，只是感觉有点没力气，不是大事，不用耽误行程。"
          },
          "70110809": {
            "id": "70110809",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "虽然你这么说我很高兴，不过不是因为冷啦…"
          }
        }
      }
    },

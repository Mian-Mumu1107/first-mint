    {
      "subId": "701121",
      "subQuestName": "寻找出去的道路",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "70112101"
        ],
        "dialogs": {
          "70112101": {
            "id": "70112101",
            "speakerId": 22302,
            "speakerName": "「灰眸」",
            "text": "检索到「克什尼克晶矿」，建议进行采集…",
            "nextDialogs": [
              "70112102"
            ]
          },
          "70112102": {
            "id": "70112102",
            "speakerId": 22302,
            "speakerName": "「灰眸」",
            "text": "刚才的造物就是利用了「克什尼克晶矿」的性质，才能如此高效地进行供暖。",
            "nextDialogs": [
              "70112103"
            ]
          },
          "70112103": {
            "id": "70112103",
            "speakerId": 22302,
            "speakerName": "「灰眸」",
            "text": "只可惜临时的「臻冰造物」维持时间太短，无法在开拓时期保持稳定，正因为这个，才开放了「克什尼克晶矿」的使用权。",
            "nextDialogs": [
              "70112104"
            ]
          },
          "70112104": {
            "id": "70112104",
            "speakerId": 22302,
            "speakerName": "「灰眸」",
            "text": "…不过我已经忘了，「暖和」是什么感觉了。",
            "nextDialogs": [
              "70112105"
            ]
          },
          "70112105": {
            "id": "70112105",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "或许等拿回身体…",
            "nextDialogs": [
              "70112106"
            ]
          },
          "70112106": {
            "id": "70112106",
            "speakerId": 22302,
            "speakerName": "「灰眸」",
            "text": "是的，说不定到时候就能和您一起在炉边烤火了。",
            "nextDialogs": [
              "70112107"
            ]
          },
          "70112107": {
            "id": "70112107",
            "speakerId": 22302,
            "speakerName": "「灰眸」",
            "text": "……",
            "nextDialogs": [
              "70112108"
            ]
          },
          "70112108": {
            "id": "70112108",
            "speakerId": 22302,
            "speakerName": "「灰眸」",
            "text": "总之，收集克什尼克晶矿，我就可以提取其中的能量，维持您体表的温度，现在，记住这个就好。"
          }
        }
      }
    },

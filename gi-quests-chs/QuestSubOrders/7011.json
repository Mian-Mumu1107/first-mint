    {
      "subId": "701117",
      "subQuestName": "寻找出去的道路",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "70111701"
        ],
        "dialogs": {
          "70111701": {
            "id": "70111701",
            "speakerId": 22302,
            "speakerName": "「灰眸」",
            "text": "检测到周围环境…必要出口已被冰封绝…",
            "nextDialogs": [
              "70111702"
            ]
          },
          "70111702": {
            "id": "70111702",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "或许可以用火…",
            "nextDialogs": [
              "70111703"
            ]
          },
          "70111703": {
            "id": "70111703",
            "speakerId": 22302,
            "speakerName": "「灰眸」",
            "text": "那并不是具备效率的做法，稍等…附近检测到可用「造物蓝图」…",
            "nextDialogs": [
              "70111704"
            ]
          },
          "70111704": {
            "id": "70111704",
            "speakerId": 22302,
            "speakerName": "「灰眸」",
            "text": "可以利用那个更快地清理眼前的坚冰。"
          }
        }
      }
    },

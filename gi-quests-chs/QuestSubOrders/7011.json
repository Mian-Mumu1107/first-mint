    {
      "subId": "701127",
      "subQuestName": "与派蒙和「灰眸」交谈",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "70112701"
        ],
        "dialogs": {
          "70112701": {
            "id": "70112701",
            "speakerId": 22302,
            "speakerName": "「灰眸」",
            "text": "真是奇怪，不仅是车站情况和记录有很大差距，就连铁路与地形都发生了改变…",
            "nextDialogs": [
              "70112702"
            ]
          },
          "70112702": {
            "id": "70112702",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "派蒙，没事吧？",
            "nextDialogs": [
              "70112703"
            ]
          },
          "70112703": {
            "id": "70112703",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "嗯，多亏你反应快…",
            "nextDialogs": [
              "70112704"
            ]
          },
          "70112704": {
            "id": "70112704",
            "speakerId": 22302,
            "speakerName": "「灰眸」",
            "text": "抱歉，把您卷入危险中，我也对现状一头雾水…",
            "nextDialogs": [

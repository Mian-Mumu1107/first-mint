    {
      "subId": "701126",
      "subQuestName": "驱车驶出暴风雪",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "70112601"
        ],
        "dialogs": {
          "70112601": {
            "id": "70112601",
            "speakerId": 22302,
            "speakerName": "「灰眸」",
            "text": "从这里向北，我们很快就会抵达…",
            "nextDialogs": [
              "70112602"
            ]
          },
          "70112602": {
            "id": "70112602",
            "speakerId": 22302,
            "speakerName": "「灰眸」",
            "text": "稍等，有报错提示…无法检测到通畅的铁轨？",
            "nextDialogs": [
              "70112603"
            ]
          },
          "70112603": {
            "id": "70112603",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "嗯，什么叫通畅的…",
            "nextDialogs": [
              "70112604"
            ]
          },
          "70112604": {
            "id": "70112604",
            "speakerId": 22302,
            "speakerName": "「灰眸」",
            "text": "朋友们，做好防冲击准备！即将进入预期外的飞行模式——"
          }
        }
      }
    },
    {
      "subId": "701128",
      "subQuestName": "与派蒙和「灰眸」交谈",
      "sceneId": null,

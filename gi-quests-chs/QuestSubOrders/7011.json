          "70112710": {
            "id": "70112710",
            "speakerId": 22302,
            "speakerName": "「灰眸」",
            "text": "这次肯定不会错，请您看向这个方向，那就是克什尼克之炬！",
            "nextDialogs": [
              "70112711"
            ]
          },
          "70112711": {
            "id": "70112711",
            "speakerId": 22302,
            "speakerName": "「灰眸」",
            "text": "从结果来说，我们因祸得福，走了一条最近的路。",
            "nextDialogs": [
              "70112712"
            ]
          },
          "70112712": {
            "id": "70112712",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "只是这条路实在不算平稳。",
            "nextDialogs": [
              "70112713"
            ]
          },
          "70112713": {
            "id": "70112713",
            "speakerId": 22302,
            "speakerName": "「灰眸」",
            "text": "请您放心，下次我会考虑到用户偏好的，下次一定——"
          }
        }
      }

    {
      "subId": "2005805",
      "subQuestName": "与诺拉对话",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "200580601"
        ],
        "dialogs": {
          "200580601": {
            "id": "200580601",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "再来一次。",
            "nextDialogs": [
              "200580602"
            ]
          },
          "200580602": {
            "id": "200580602",
            "speakerId": 1000,
            "speakerName": "诺拉",
            "text": "好嘞！我会在旁边好好看着的。"
          }
        }
      }
    },
    {
      "subId": "2005810",
      "subQuestName": "(test)$HIDDEN",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [],
        "dialogs": {}
      }
    },
    {
      "subId": "2005811",
      "subQuestName": "(test)$HIDDEN",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "200581101"
        ],
        "dialogs": {
          "200581101": {
            "id": "200581101",
            "speakerId": 1000,
            "speakerName": "诺拉",
            "text": "好厉害！我长大了之后，也能这样飞吗…",
            "nextDialogs": [
              "200581103",
              "200581105"
            ]
          },
          "200581103": {
            "id": "200581103",
            "speakerId": 1000,
            "speakerName": "诺拉",
            "text": "那我要快点长大，等爸爸工作完了，我就要和他一起去玩！",
            "nextDialogs": [
              "200581106"
            ]
          },
          "200581106": {
            "id": "200581106",
            "speakerId": 1000,
            "speakerName": "诺拉",
            "text": "不过，长大之后应该就不难了吧。",
            "nextDialogs": [
              "200581107"
            ]
          },
          "200581107": {
            "id": "200581107",
            "speakerId": 1000,
            "speakerName": "诺拉",
            "text": "谢谢你啦，这些给你，是我悄悄搜集的宝物，就给你做礼物吧。",
            "nextDialogs": [
              "200581108"
            ]
          },
          "200581108": {
            "id": "200581108",
            "speakerId": 1000,
            "speakerName": "诺拉",
            "text": "快点收好…还有，别和葛瑞丝阿姨说啊！"
          },
          "200581105": {
            "id": "200581105",
            "speakerId": 1000,
            "speakerName": "诺拉",
            "text": "飞行执照…那是什么？听着好像就挺难的。"
          }
        }
      }
    },

{
  "lineCounts": {
    "Player": 13,
    "葛瑞丝": 14,
    "诺拉": 31
  },
  "subQuests": [
    {
      "subId": "2005801",
      "subQuestName": "与诺拉对话",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "200580101"
        ],
        "dialogs": {
          "200580101": {
            "id": "200580101",
            "speakerId": 1000,
            "speakerName": "诺拉",
            "text": "呜…怎么办呢…",
            "nextDialogs": [
              "200580102"
            ]
          },
          "200580102": {
            "id": "200580102",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "怎么了？",
            "nextDialogs": [
              "200580103"
            ]
          },
          "200580103": {
            "id": "200580103",
            "speakerId": 1000,
            "speakerName": "诺拉",
            "text": "你看见风神像了吗？往上看，很高很高的地方…就是风神大人手的那个地方。",
            "nextDialogs": [
              "200580104"
            ]
          },
          "200580104": {
            "id": "200580104",
            "speakerId": 1000,
            "speakerName": "诺拉",
            "text": "我想要上去玩…但是，葛瑞丝阿姨一定不会让我爬上去的…",
            "nextDialogs": [
              "200580105"
            ]
          },
          "200580105": {
            "id": "200580105",
            "speakerId": 1000,
            "speakerName": "诺拉",
            "text": "拜托拜托，拜托你去和葛瑞丝阿姨说话吧，别让她看过来，我爬得很快，一下子就能爬上去…",
            "nextDialogs": [
              "200580107",
              "200580109"
            ]
          },
          "200580107": {
            "id": "200580107",
            "speakerId": 1000,
            "speakerName": "诺拉",
            "text": "那就拜托你啦！",
            "nextDialogs": [
              "200580110"
            ]
          },
          "200580110": {
            "id": "200580110",
            "speakerId": 1000,
            "speakerName": "诺拉",
            "text": "总之，就拜托你去吸引住葛瑞丝阿姨了，我这就去…",
            "nextDialogs": [
              "200580111"
            ]
          },
          "200580111": {
            "id": "200580111",
            "speakerId": 1001,
            "speakerName": "葛瑞丝",
            "text": "诺拉，不准去！",
            "nextDialogs": [
              "200580112"
            ]
          },
          "200580112": {
            "id": "200580112",
            "speakerId": 1001,
            "speakerName": "葛瑞丝",
            "text": "呼…稍微走神了一会，她居然来麻烦您了，抱歉。",
            "nextDialogs": [
              "200580113"
            ]
          },
          "200580113": {
            "id": "200580113",
            "speakerId": 1000,
            "speakerName": "诺拉",
            "text": "怎么这样！就是上去玩一玩…",
            "nextDialogs": [
              "200580114"
            ]
          },
          "200580114": {
            "id": "200580114",
            "speakerId": 1001,
            "speakerName": "葛瑞丝",
            "text": "不行就是不行，你父亲也不会允许的。",
            "nextDialogs": [
              "200580115"
            ]
          },
          "200580115": {
            "id": "200580115",
            "speakerId": 1001,
            "speakerName": "葛瑞丝",
            "text": "还有您，请您也别迁就她。要是您做这种危险的事情，肯定也有人会担心的吧。"
          },
          "200580109": {
            "id": "200580109",
            "speakerId": 1000,
            "speakerName": "诺拉",
            "text": "没关系啦，我可是很厉害的。"
          }
        }
      }
    },
    {
      "subId": "2005813",
      "subQuestName": "(test)$HIDDEN",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "200580501"
        ],
        "dialogs": {
          "200580501": {
            "id": "200580501",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "这次就这样吧…",
            "nextDialogs": [
              "200580502"
            ]
          },
          "200580502": {
            "id": "200580502",
            "speakerId": 1000,
            "speakerName": "诺拉",
            "text": "好吧…好好休息。"
          }
        }
      }
    },
    {
      "subId": "2005802",
      "subQuestName": "与诺拉对话",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "200580201"
        ],
        "dialogs": {
          "200580201": {
            "id": "200580201",
            "speakerId": 1000,
            "speakerName": "诺拉",
            "text": "呜…",
            "nextDialogs": [
              "200580202"
            ]
          },
          "200580202": {
            "id": "200580202",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "要上去做什么？",
            "nextDialogs": [
              "200580203"
            ]
          },
          "200580203": {
            "id": "200580203",
            "speakerId": 1000,
            "speakerName": "诺拉",
            "text": "葛瑞丝阿姨说，如果想要向谁说悄悄话，只要告诉蒲公英，然后撒出去，风神大人就会把蒲公英和悄悄话一起带给那个人。",
            "nextDialogs": [
              "200580204"
            ]
          },
          "200580204": {
            "id": "200580204",
            "speakerId": 1000,
            "speakerName": "诺拉",
            "text": "而且撒的地方越高，心愿就能传达地越快…",
            "nextDialogs": [
              "200580205"
            ]
          },
          "200580205": {
            "id": "200580205",
            "speakerId": 1000,
            "speakerName": "诺拉",
            "text": "葛罗丽姐姐就拜托过冒险家，帮自己去风神像上撒过蒲公英…结果隔了几天，古德温哥哥就回信了！",
            "nextDialogs": [
              "200580206"
            ]
          },
          "200580206": {
            "id": "200580206",
            "speakerId": 1000,
            "speakerName": "诺拉",
            "text": "诺拉也有悄悄话告诉爸爸，而且也找好蒲公英了！",
            "nextDialogs": [
              "200580207"
            ]
          },
          "200580207": {
            "id": "200580207",
            "speakerId": 1000,
            "speakerName": "诺拉",
            "text": "但是…葛瑞丝阿姨一直不许，一直说等我长大之后，才能回去和爸爸一起住。",
            "nextDialogs": [
              "200580208"
            ]
          },
          "200580208": {
            "id": "200580208",
            "speakerId": 1000,
            "speakerName": "诺拉",
            "text": "到底怎么样才能长大得更快呢，我也在很努力地锻炼了，但还是这么矮…",
            "nextDialogs": [
              "200580209"
            ]
          },
          "200580209": {
            "id": "200580209",
            "speakerId": 1000,
            "speakerName": "诺拉",
            "text": "嗯…我经常看见你在城里飞来飞去，你能教教我，平时你都是怎么飞的吗？",
            "nextDialogs": [
              "200580211",
              "200580213"
            ]
          },
          "200580211": {
            "id": "200580211",
            "speakerId": 1000,
            "speakerName": "诺拉",
            "text": "嘻嘻，那我就在旁边看啦。这次，总是在葛瑞丝阿姨的允许范围内了吧。"
          },
          "200580213": {
            "id": "200580213",
            "speakerId": 1000,
            "speakerName": "诺拉",
            "text": "不行不行，葛瑞丝阿姨看见了，又要训我了。"
          }
        }
      }
    },
    {
      "subId": "2005808",
      "subQuestName": "(test)$HIDDEN",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "200580801"
        ],
        "dialogs": {
          "200580801": {
            "id": "200580801",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "我去稍微休息一下…",
            "nextDialogs": [
              "200580802"
            ]
          },
          "200580802": {
            "id": "200580802",
            "speakerId": 1000,
            "speakerName": "诺拉",
            "text": "那要快点喔。"
          }
        }
      }
    },
    {
      "subId": "2005809",
      "subQuestName": "(test)$HIDDEN",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "200580901"
        ],
        "dialogs": {
          "200580901": {
            "id": "200580901",
            "speakerId": 1001,
            "speakerName": "葛瑞丝",
            "text": "唉，诺拉…",
            "nextDialogs": [
              "200580903",
              "200580908"
            ]
          },
          "200580903": {
            "id": "200580903",
            "speakerId": 1001,
            "speakerName": "葛瑞丝",
            "text": "哦，因为一些原因，她的母亲…暂时不在家里，目前是由我来照顾。",
            "nextDialogs": [
              "200580904"
            ]
          },
          "200580904": {
            "id": "200580904",
            "speakerId": 1001,
            "speakerName": "葛瑞丝",
            "text": "还有其他几个需要照顾的孩子，都是由我来负责，这也是修女的责任之一呢。",
            "nextDialogs": [
              "200580905"
            ]
          },
          "200580905": {
            "id": "200580905",
            "speakerId": 1001,
            "speakerName": "葛瑞丝",
            "text": "我就好像突然多了很多孩子一样，他们都是好孩子，和葛罗丽也都很处得来。",
            "nextDialogs": [
              "200580906"
            ]
          },
          "200580906": {
            "id": "200580906",
            "speakerId": 1001,
            "speakerName": "葛瑞丝",
            "text": "唔…我照顾时间最长的提米，都开始叫我葛瑞丝妈妈了呢。"
          },
          "200580908": {
            "id": "200580908",
            "speakerId": 1001,
            "speakerName": "葛瑞丝",
            "text": "是巴顿先生，他之前因为太喜欢喝酒，家里出了很大的问题。",
            "nextDialogs": [
              "200580909"
            ]
          },
          "200580909": {
            "id": "200580909",
            "speakerId": 1001,
            "speakerName": "葛瑞丝",
            "text": "教会和西风骑士团都警告过他几次，但他一直没有悔改的意思，最后还是迪卢克老爷帮的忙。",
            "nextDialogs": [
              "200580910"
            ]
          },
          "200580910": {
            "id": "200580910",
            "speakerId": 1001,
            "speakerName": "葛瑞丝",
            "text": "维多利亚修女的意思是，现在的巴顿不适合照顾诺拉，所以干脆把诺拉交给教会照顾，让巴顿先生一个人反省一段时间。",
            "nextDialogs": [
              "200580911"
            ]
          },
          "200580911": {
            "id": "200580911",
            "speakerId": 1001,
            "speakerName": "葛瑞丝",
            "text": "但是，诺拉也在长大，「爸爸在努力工作，不能去打扰」的借口也不能用了吧…",
            "nextDialogs": [
              "200580912"
            ]
          },
          "200580912": {
            "id": "200580912",
            "speakerId": 1001,
            "speakerName": "葛瑞丝",
            "text": "风神大人的蒲公英，也不是哪都能到的啊。"
          }
        }
      }
    },
    {
      "subId": "2005803",
      "subQuestName": "到达目标",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "200580301"
        ],
        "dialogs": {
          "200580301": {
            "id": "200580301",
            "speakerId": 1000,
            "speakerName": "诺拉",
            "text": "用了{ChallengeCurrValue10}分钟就飞到了，真厉害。",
            "nextDialogs": [
              "200580302"
            ]
          },
          "200580302": {
            "id": "200580302",
            "speakerId": 1000,
            "speakerName": "诺拉",
            "text": "你还能再试试吗？如果能飞得再快一点…",
            "nextDialogs": [
              "200580303"
            ]
          },
          "200580303": {
            "id": "200580303",
            "speakerId": 1000,
            "speakerName": "诺拉",
            "text": "我就…就送你很好的宝物。"
          }
        }
      }
    },
    {

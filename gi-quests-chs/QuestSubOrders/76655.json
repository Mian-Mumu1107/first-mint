  "subQuests": [
    {
      "subId": "7665501",
      "subQuestName": "与菲林斯对话",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "766550101"
        ],
        "dialogs": {
          "766550101": {
            "id": "766550101",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "菲林斯，你也上来了啊？",
            "nextDialogs": [
              "766550102"
            ]
          },
          "766550102": {
            "id": "766550102",
            "speakerId": 1314,
            "speakerName": "菲林斯",
            "text": "两位辛苦了，有人维护之后，这座灯塔的状态好了很多。",
            "nextDialogs": [
              "766550103"
            ]
          },
          "766550103": {
            "id": "766550103",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "嘿嘿，举手之劳。不过就算我们再怎么维护灯塔，这里还是那么黑，总有灯塔照不到的地方。",
            "nextDialogs": [
              "766550104"
            ]
          },
          "766550104": {
            "id": "766550104",
            "speakerId": 1314,
            "speakerName": "菲林斯",
            "text": "是的，和外面不同，坟场里的时间仿佛永远停在了夜晚，停在了那场战斗结束的晚上。",
            "nextDialogs": [
              "766550105"
            ]
          },
          "766550105": {
            "id": "766550105",
            "speakerId": 1314,
            "speakerName": "菲林斯",
            "text": "我原本无意改变这里的环境，是你们点亮了灯塔，推动了这里的时间。",
            "nextDialogs": [
              "766550107",
              "766550109"
            ]
          },
          "766550107": {
            "id": "766550107",
            "speakerId": 1314,
            "speakerName": "菲林斯",
            "text": "如果你想问这样是否会给我带来不便，答案是否定的。",
            "nextDialogs": [
              "766550110"
            ]
          },
          "766550110": {
            "id": "766550110",
            "speakerId": 1314,
            "speakerName": "菲林斯",
            "text": "生命是轮回，即便没有我们，这座岛上的鬼魂们也会逐渐消散，回到地脉中去。",
            "nextDialogs": [
              "766550111"
            ]
          },
          "766550111": {
            "id": "766550111",
            "speakerId": 1314,
            "speakerName": "菲林斯",
            "text": "所以不用担心灯塔无法照亮整座岛，随着鬼魂逐渐消失，笼罩这里的雾气也会变淡。",
            "nextDialogs": [
              "766550112"
            ]
          },
          "766550112": {
            "id": "766550112",
            "speakerId": 1314,
            "speakerName": "菲林斯",
            "text": "太阳总要升起。"
          },
          "766550109": {
            "id": "766550109",
            "speakerId": 1314,
            "speakerName": "菲林斯",
            "text": "请不要道歉，我并不厌恶这种改变。"
          }
        }
      }
    }
  ]
}
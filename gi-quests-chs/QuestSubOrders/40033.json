        "dialogs": {
          "400335101": {
            "id": "400335101",
            "speakerId": 3042,
            "speakerName": "龙二",
            "text": "小动物就拜托你了。我继续调查那个「黑影」的事情。"
          }
        }
      }
    },
    {
      "subId": "4003352",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "400335201"
        ],
        "dialogs": {
          "400335201": {
            "id": "400335201",
            "speakerId": 3041,
            "speakerName": "珊瑚",
            "text": "放心，我已经有初步推断了，龙二会继续调查「黑影」的，你们也快去救小动物吧。"
          }
        }
      }
    }

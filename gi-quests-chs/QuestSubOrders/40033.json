    {
      "subId": "4003301",
      "subQuestName": "前往万端珊瑚侦探社",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "400330101"
        ],
        "dialogs": {
          "400330101": {
            "id": "400330101",
            "speakerId": 3042,
            "speakerName": "龙二",
            "text": "是你们啊。来得正好。",
            "nextDialogs": [
              "400330102"
            ]
          },
          "400330102": {
            "id": "400330102",
            "speakerId": 3042,
            "speakerName": "龙二",
            "text": "我刚刚考察完几处可疑的地点。",
            "nextDialogs": [
              "400330103"
            ]
          },
          "400330103": {
            "id": "400330103",
            "speakerId": 3042,
            "speakerName": "龙二",
            "text": "其中有一处营地是由那个帽…",
            "nextDialogs": [
              "400330104"
            ]
          },
          "400330104": {
            "id": "400330104",
            "speakerId": 3042,
            "speakerName": "龙二",
            "text": "咳咳，是由那个「黑影」看守的。如果没有什么别的问题的话…",
            "nextDialogs": [
              "400330105"
            ]
          },
          "400330105": {
            "id": "400330105",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "昨天说的「调查」…",
            "nextDialogs": [
              "400330106"
            ]
          },
          "400330106": {
            "id": "400330106",
            "speakerId": 3042,
            "speakerName": "龙二",
            "text": "那个的话，我现在还什么都不知道。",
            "nextDialogs": [
              "400330107"
            ]
          },
          "400330107": {
            "id": "400330107",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "咦？不是珊瑚让你去调查的吗？",
            "nextDialogs": [
              "400330108"
            ]
          },
          "400330108": {
            "id": "400330108",
            "speakerId": 3042,
            "speakerName": "龙二",
            "text": "没错，但是…该怎么说呢？",
            "nextDialogs": [
              "400330109"
            ]
          },
          "400330109": {
            "id": "400330109",
            "speakerId": 3042,
            "speakerName": "龙二",
            "text": "比如说，「熟透了的堇瓜」和「门帘上的泥手印」，对我而言，是毫无关联的事物。",
            "nextDialogs": [
              "400330110"
            ]
          },
          "400330110": {
            "id": "400330110",
            "speakerId": 3042,
            "speakerName": "龙二",
            "text": "但在珊瑚社长的脑海中就能成为解开「寄木细工」的关键。",
            "nextDialogs": [
              "400330111"
            ]
          },
          "400330111": {
            "id": "400330111",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "「熟透了的堇瓜」和「门帘上的泥手印」…它们之间有什么关系呀？",
            "nextDialogs": [
              "400330112"
            ]
          },
          "400330112": {
            "id": "400330112",
            "speakerId": 3042,
            "speakerName": "龙二",
            "text": "只是打个比方。我依照她的指示，在八酝岛和镇守之森调查了一些地点，将我的见闻报告给她。",
            "nextDialogs": [
              "400330113"
            ]
          },
          "400330113": {
            "id": "400330113",
            "speakerId": 3042,
            "speakerName": "龙二",
            "text": "而她能从我报告的现象中得到什么结论，就只有她自己知道了。",
            "nextDialogs": [
              "400330114"
            ]
          },
          "400330114": {
            "id": "400330114",
            "speakerId": 3042,
            "speakerName": "龙二",
            "text": "只有鹿野院先生能和她的思维并驾齐驱…",
            "nextDialogs": [
              "400330115"
            ]
          },
          "400330115": {
            "id": "400330115",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "鹿野院？",
            "nextDialogs": [
              "400330116"
            ]
          },
          "400330116": {
            "id": "400330116",
            "speakerId": 3042,
            "speakerName": "龙二",
            "text": "天领奉行的人。之前查案的时候，有幸和他见过面。",
            "nextDialogs": [
              "400330117"
            ]
          },
          "400330117": {
            "id": "400330117",
            "speakerId": 3042,
            "speakerName": "龙二",
            "text": "是个…气质独特的人。如果见到了，你一定能一眼认出来。",
            "nextDialogs": [
              "400330118"
            ]
          },
          "400330118": {
            "id": "400330118",
            "speakerId": 3042,
            "speakerName": "龙二",
            "text": "总之，小动物就拜托你了。",
            "nextDialogs": [
              "400330119"
            ]
          },
          "400330119": {
            "id": "400330119",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "我还是好在意「熟透了的堇瓜」…"
          }
        }
      }
    },

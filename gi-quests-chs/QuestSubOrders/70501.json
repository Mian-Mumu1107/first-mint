    {
      "subId": "7050105",
      "subQuestName": "夺回食材，且保护货运热气球的完整",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "705010501"
        ],
        "dialogs": {
          "705010501": {
            "id": "705010501",
            "speakerId": 10258,
            "speakerName": "留云借风真君",
            "text": "怎么样？「米饭布丁」已经做好了吗？",
            "nextDialogs": [
              "705010502"
            ]
          },
          "705010502": {
            "id": "705010502",
            "speakerId": 10258,
            "speakerName": "留云借风真君",
            "text": "如此清香…闻起来真不错。不愧是本仙，不愧是本仙的「机关烹饪神机」，哈哈哈！",
            "nextDialogs": [
              "705010503"
            ]
          },
          "705010503": {
            "id": "705010503",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "您悠着点…",
            "nextDialogs": [
              "705010506"
            ]
          },
          "705010506": {
            "id": "705010506",
            "speakerId": 10258,
            "speakerName": "留云借风真君",
            "text": "这回也有劳你了，旅行者。本仙已备好给你的食谱，拿好了。",
            "nextDialogs": [
              "705010507"
            ]
          },
          "705010507": {
            "id": "705010507",
            "speakerId": 10258,
            "speakerName": "留云借风真君",
            "text": "唔，已经做了两道菜，下一道做什么好呢…"
          }
        }
      }
    },
    {
      "subId": "7050106",
      "subQuestName": "打倒来袭的魔物",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "705010601"
        ],
        "dialogs": {
          "705010601": {
            "id": "705010601",
            "speakerId": 10258,
            "speakerName": "留云借风真君",
            "text": "火候似乎控制得不太成功…",
            "nextDialogs": [
              "705010602"
            ]
          },
          "705010602": {
            "id": "705010602",
            "speakerId": 10258,
            "speakerName": "留云借风真君",
            "text": "无妨。还有备用食材，随我再试一次吧。"
          }
        }
      }
    },
    {
      "subId": "7050114",
      "subQuestName": "查看货物",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [

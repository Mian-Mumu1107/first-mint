        ],
        "dialogs": {
          "705011101": {
            "id": "705011101",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "这应该就是那些货物了，呜哇…居然有这么多…",
            "nextDialogs": [
              "705011102"
            ]
          },
          "705011102": {
            "id": "705011102",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "还好有这架货运热气球…我们快点把货物运回去吧。"
          }
        }
      }
    },

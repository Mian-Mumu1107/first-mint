    {
      "subId": "7050116",
      "subQuestName": "向留云借风真君回报",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "705011401"
        ],
        "dialogs": {
          "705011401": {
            "id": "705011401",
            "speakerId": 10258,
            "speakerName": "留云借风真君",
            "text": "不错，正是本仙所需之物…品质上乘。",
            "nextDialogs": [
              "705011402"
            ]
          },
          "705011402": {
            "id": "705011402",
            "speakerId": 10258,
            "speakerName": "留云借风真君",
            "text": "既然食材备齐，本仙马上就去开启机关。",
            "nextDialogs": [
              "705011403"
            ]
          },
          "705011403": {
            "id": "705011403",
            "speakerId": 10258,
            "speakerName": "留云借风真君",
            "text": "和上次一样，照看火候的事就交给你了，旅行者。",
            "nextDialogs": [
              "705011404"
            ]
          },
          "705011404": {
            "id": "705011404",
            "speakerId": 10258,
            "speakerName": "留云借风真君",
            "text": "你准备好之后，速来知会本仙。"
          }
        }
      }
    },

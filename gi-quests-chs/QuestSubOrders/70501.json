    {
      "subId": "7050101",
      "subQuestName": "与留云借风真君对话",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "705010101"
        ],
        "dialogs": {
          "705010101": {
            "id": "705010101",
            "speakerId": 10258,
            "speakerName": "留云借风真君",
            "text": "不知道这机关能不能制作甜品…",
            "nextDialogs": [
              "705010102"
            ]
          },
          "705010102": {
            "id": "705010102",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "这次要做什么菜？",
            "nextDialogs": [
              "705010103"
            ]
          },
          "705010103": {
            "id": "705010103",
            "speakerId": 10258,
            "speakerName": "留云借风真君",
            "text": "旅行者，你来得正好。本仙刚刚想好这次要做的菜色，其名为「布丁」。",
            "nextDialogs": [
              "705010104"
            ]
          },
          "705010104": {
            "id": "705010104",
            "speakerId": 10258,
            "speakerName": "留云借风真君",
            "text": "这种叫做「布丁」的菜色，是我从最近流行的食谱里看来的。据说香软可口，是款不错的甜品。",
            "nextDialogs": [
              "705010105"
            ]
          },
          "705010105": {
            "id": "705010105",
            "speakerId": 10258,
            "speakerName": "留云借风真君",
            "text": "本仙在其原有做法上稍加改造…",
            "nextDialogs": [
              "705010106"
            ]
          },
          "705010106": {
            "id": "705010106",
            "speakerId": 10258,
            "speakerName": "留云借风真君",
            "text": "此外，加入了「稻米」。",
            "nextDialogs": [
              "705010107"
            ]
          },
          "705010107": {
            "id": "705010107",
            "speakerId": 10258,
            "speakerName": "留云借风真君",
            "text": "改造后的这道菜理应由本仙亲自赐名，唔…就叫它「米饭布丁」吧。",
            "nextDialogs": [
              "705010108"
            ]
          },
          "705010108": {
            "id": "705010108",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "怎么听着这么管饱…",
            "nextDialogs": [
              "705010109"
            ]
          },
          "705010109": {
            "id": "705010109",
            "speakerId": 10258,
            "speakerName": "留云借风真君",
            "text": "这道甜品重在「稻米」的品质，本仙当即启动「机关烹饪神机」，令它寻找上等稻米。一路奔波，来到了此地。",
            "nextDialogs": [
              "705010110"
            ]
          },
          "705010110": {
            "id": "705010110",
            "speakerId": 10258,
            "speakerName": "留云借风真君",
            "text": "旅行者，来得早不如来得巧，再为本仙跑一趟，取来上等稻米吧。据机关显示，那种稻米应该离这里不远。",
            "nextDialogs": [
              "705010113"
            ]
          },
          "705010113": {
            "id": "705010113",
            "speakerId": 10258,
            "speakerName": "留云借风真君",
            "text": "调整机关费时，本仙暂时分身乏术。",
            "nextDialogs": [
              "705010114"
            ]
          },
          "705010114": {
            "id": "705010114",
            "speakerId": 10258,
            "speakerName": "留云借风真君",
            "text": "你手脚麻利，是不可多得的帮手。你就再替本仙跑一趟吧，等「米饭布丁」做出来，自然少不了你的份。",
            "nextDialogs": [
              "705010115"
            ]
          },
          "705010115": {
            "id": "705010115",
            "speakerId": 10258,
            "speakerName": "留云借风真君",
            "text": "总之，就有劳你了。",
            "nextDialogs": [
              "705010116"
            ]
          },
          "705010116": {
            "id": "705010116",
            "speakerId": 10258,
            "speakerName": "留云借风真君",
            "text": "机关烹饪神机…启！",
            "nextDialogs": [
              "705010117"
            ]
          },
          "705010117": {
            "id": "705010117",
            "speakerId": 10258,
            "speakerName": "留云借风真君",
            "text": "旅行者，本仙已启动机关，你快循着气息的踪迹，去把本仙要的那种稻米拿回来吧。"
          }
        }
      }
    },
    {
      "subId": "7050102",
      "subQuestName": "跟随气息的踪迹，寻找食材",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "705010201"
        ],
        "dialogs": {
          "705010201": {
            "id": "705010201",
            "speakerId": 20395,
            "speakerName": "布伦",
            "text": "谢谢你们，谢谢你们救了我…我叫布伦，是个商人。",
            "nextDialogs": [
              "705010202"
            ]
          },
          "705010202": {
            "id": "705010202",
            "speakerId": 20395,
            "speakerName": "布伦",
            "text": "唉…真是倒霉。我本来正在运一批货物…",
            "nextDialogs": [
              "705010203"
            ]
          },
          "705010203": {
            "id": "705010203",
            "speakerId": 20395,
            "speakerName": "布伦",
            "text": "但没想到…才走到半路，突然被一群魔物袭击了。",
            "nextDialogs": [
              "705010204"
            ]
          },
          "705010204": {
            "id": "705010204",
            "speakerId": 20395,
            "speakerName": "布伦",
            "text": "我一个劲地向前跑，顾不上车里的货物，也来不及辨认方向…一直跑到了这里。",
            "nextDialogs": [
              "705010205"
            ]
          },
          "705010205": {
            "id": "705010205",
            "speakerId": 20395,
            "speakerName": "布伦",
            "text": "到了这里之后，我还以为彻底甩掉它们了，就想要下车清点一下货物。",
            "nextDialogs": [
              "705010206"
            ]
          },
          "705010206": {
            "id": "705010206",
            "speakerId": 20395,
            "speakerName": "布伦",
            "text": "但是它们突然又不知道从哪钻了出来…幸好有你们帮忙。",
            "nextDialogs": [
              "705010207"
            ]
          },
          "705010207": {
            "id": "705010207",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "你运的是什么货物？",
            "nextDialogs": [
              "705010208"
            ]
          },
          "705010208": {
            "id": "705010208",
            "speakerId": 20395,
            "speakerName": "布伦",
            "text": "我运的是一批食材，稻米之类的东西…",
            "nextDialogs": [
              "705010209"
            ]
          },
          "705010209": {
            "id": "705010209",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "看来这就是那位仙人要我们找的稻米了，但是，看起来好像也没剩下多少…",
            "nextDialogs": [
              "705010210"
            ]
          },
          "705010210": {
            "id": "705010210",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "能卖一些稻米给我吗？",
            "nextDialogs": [
              "705010211"
            ]
          },
          "705010211": {
            "id": "705010211",
            "speakerId": 20395,
            "speakerName": "布伦",
            "text": "你要买稻米？不是我不卖，只是…我在逃跑的时候，车上的货物基本上都丢在路上了。",
            "nextDialogs": [
              "705010212"
            ]
          },
          "705010212": {
            "id": "705010212",
            "speakerId": 20395,
            "speakerName": "布伦",
            "text": "现在那些魔物只怕是把这些货物当做战利品，搬回它们的营地里去了。",
            "nextDialogs": [
              "705010213"
            ]
          },
          "705010213": {
            "id": "705010213",
            "speakerId": 20395,
            "speakerName": "布伦",
            "text": "我也正在头疼，怎么才能把那些货物拿回来，要是拿不回来的话，这趟生意我可就亏惨了…",
            "nextDialogs": [
              "705010214"
            ]
          },
          "705010214": {
            "id": "705010214",
            "speakerId": 20395,
            "speakerName": "布伦",
            "text": "旅行者…我看你刚才的身手很好，你能帮我去拿回这些货物吗？",
            "nextDialogs": [
              "705010215"
            ]
          },
          "705010215": {
            "id": "705010215",
            "speakerId": 20395,
            "speakerName": "布伦",
            "text": "要、要是你愿意帮我的话！你要的稻米，你要多少我就送给你多少！",
            "nextDialogs": [
              "705010217",
              "705010219"
            ]
          },
          "705010217": {
            "id": "705010217",
            "speakerId": 20395,
            "speakerName": "布伦",
            "text": "谢谢你！那就拜托你了！",
            "nextDialogs": [
              "705010220"
            ]
          },
          "705010220": {
            "id": "705010220",
            "speakerId": 20395,
            "speakerName": "布伦",
            "text": "你带着我的货运热气球去吧，把那些货物放在这上面就好了。",
            "nextDialogs": [
              "705010221"
            ]
          },
          "705010221": {
            "id": "705010221",
            "speakerId": 20395,
            "speakerName": "布伦",
            "text": "那就拜托你了，旅行者，我就在这等着你，拿到货物之后，就拿回来给我吧。"
          },
          "705010219": {
            "id": "705010219",
            "speakerId": 20395,
            "speakerName": "布伦",
            "text": "没关系，这个我有办法。"
          }
        }
      }
    },
    {
      "subId": "7050103",
      "subQuestName": "解救被魔物围困的人",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "705010301"
        ],
        "dialogs": {
          "705010301": {
            "id": "705010301",
            "speakerId": 20395,
            "speakerName": "布伦",
            "text": "你把货物拿回来了吗？谢谢你，旅行者！",
            "nextDialogs": [
              "705010302"
            ]
          },
          "705010302": {
            "id": "705010302",
            "speakerId": 20395,
            "speakerName": "布伦",
            "text": "你之前说…想要稻米，对吧？请你稍等一下，我挑一些品质比较好的给你…",
            "nextDialogs": [
              "705010303"
            ]
          },
          "705010303": {
            "id": "705010303",
            "speakerId": 20395,
            "speakerName": "布伦",
            "text": "好了！这些稻米给你，应该足够你用了。",
            "nextDialogs": [
              "705010304"
            ]
          },
          "705010304": {
            "id": "705010304",
            "speakerId": 20395,
            "speakerName": "布伦",
            "text": "再次谢谢你帮忙，旅行者，我接着赶路了。",
            "nextDialogs": [
              "705010305"
            ]
          },
          "705010305": {
            "id": "705010305",
            "speakerId": 20395,
            "speakerName": "布伦",
            "text": "希望别再遇见什么魔物了…"
          }
        }
      }
    },

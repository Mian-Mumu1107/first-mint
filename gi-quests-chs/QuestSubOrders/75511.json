        "dialogs": {
          "60067401": {
            "id": "60067401",
            "speakerId": 15358,
            "speakerName": "爱莱妲",
            "text": "记得要小心力道…轻轻粘上去…",
            "nextDialogs": [
              "60067402"
            ]
          },
          "60067402": {
            "id": "60067402",
            "speakerId": 1312,
            "speakerName": "伊涅芙",
            "text": "啊…又捏碎了…",
            "nextDialogs": [
              "60067403"
            ]
          },
          "60067403": {
            "id": "60067403",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "你们在干什么？",
            "nextDialogs": [
              "60067404"
            ]
          },
          "60067404": {
            "id": "60067404",
            "speakerId": 1312,
            "speakerName": "伊涅芙",
            "text": "#你好。{NICKNAME}，我正在学习制作「花型机关零件」。",
            "nextDialogs": [
              "60067405"
            ]
          },
          "60067405": {
            "id": "60067405",
            "speakerId": 1312,
            "speakerName": "伊涅芙",
            "text": "我准备带一些「纪念品」回去，送给在等我回去的人们。",
            "nextDialogs": [
              "60067406"
            ]
          },
          "60067406": {
            "id": "60067406",
            "speakerId": 15358,
            "speakerName": "爱莱妲",
            "text": "法尔伽大叔不清楚…不过爱诺肯定会很喜欢吧！",
            "nextDialogs": [
              "60067407"
            ]
          },
          "60067407": {
            "id": "60067407",
            "speakerId": 1312,
            "speakerName": "伊涅芙",
            "text": "对了。请收下这个。",
            "nextDialogs": [
              "60067408"
            ]
          },
          "60067408": {
            "id": "60067408",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "这是…？",
            "nextDialogs": [
              "60067409"
            ]
          },
          "60067409": {
            "id": "60067409",
            "speakerId": 1312,
            "speakerName": "伊涅芙",
            "text": "是送给你的份，「纪念」我们的相遇。",
            "nextDialogs": [
              "60067410"
            ]
          },
          "60067410": {
            "id": "60067410",
            "speakerId": 1312,
            "speakerName": "伊涅芙",
            "text": "#还有…「感谢」，{NICKNAME}。"
          }
        }
      }

    "派蒙": 9
  },
  "subQuests": [
    {
      "subId": "7269001",
      "subQuestName": "等待至翌日上午（次日早8点-12点），与柴染对话",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "726900101"
        ],
        "dialogs": {
          "726900101": {
            "id": "726900101",
            "speakerId": 1000,
            "speakerName": "柴染",
            "text": "两位，这一天终于来了。",
            "nextDialogs": [
              "726900102"
            ]
          },
          "726900102": {
            "id": "726900102",
            "speakerId": 1000,
            "speakerName": "柴染",
            "text": "对于「花影瑶庭」的构图之道，你们已经领会到了精髓。",
            "nextDialogs": [
              "726900103"
            ]
          },
          "726900103": {
            "id": "726900103",
            "speakerId": 1000,
            "speakerName": "柴染",
            "text": "是时候来一场花艺的真剑试炼了。",
            "nextDialogs": [
              "726900104"
            ]
          },
          "726900104": {
            "id": "726900104",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "等等？原来我们已经领会到精髓了吗？",
            "nextDialogs": [
              "726900105"
            ]
          },
          "726900105": {
            "id": "726900105",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "真剑试炼的意思是最难的题目吧！我突然有点害怕了…",
            "nextDialogs": [
              "726900106"
            ]
          },
          "726900106": {
            "id": "726900106",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "明明接触插花的时间还不长。",
            "nextDialogs": [
              "726900107"
            ]
          },
          "726900107": {
            "id": "726900107",
            "speakerId": 1000,
            "speakerName": "柴染",
            "text": "制作花材的手法的确需要长期的磨练，而规划「花庭」的图景与结构，更侧重意会和灵感。",
            "nextDialogs": [
              "726900108"
            ]
          },
          "726900108": {
            "id": "726900108",
            "speakerId": 1000,
            "speakerName": "柴染",
            "text": "只论后者，两位的确表现出了惊人的天赋，不再需要「花题」的锤炼了。",
            "nextDialogs": [
              "726900109"
            ]
          },
          "726900109": {
            "id": "726900109",
            "speakerId": 1000,
            "speakerName": "柴染",
            "text": "或许是因为，两位经历过迷人的旅程，见证过我无法想象的景致，才有了不同于平凡之人的心境吧。",
            "nextDialogs": [
              "726900110"
            ]
          },
          "726900110": {
            "id": "726900110",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "是，是这样吗…",
            "nextDialogs": [
              "726900111"
            ]
          },
          "726900111": {
            "id": "726900111",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "#说起来，{NICKNAME}，我们的确去过不少地方了呢，原来一起旅行的过程中，我们也会获得更多灵感啊…",
            "nextDialogs": [
              "726900112"
            ]
          },
          "726900112": {
            "id": "726900112",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "那这段时间，我们一直在学习花艺，又消耗掉了多少灵感呢？",
            "nextDialogs": [
              "726900115"
            ]
          },
          "726900115": {
            "id": "726900115",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "嗯，有道理！",
            "nextDialogs": [
              "726900116"
            ]
          },
          "726900116": {
            "id": "726900116",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "谢谢你，柴染小姐！要不是有你点拨，我们还没发现我们居然有这方面的才能呢！",
            "nextDialogs": [
              "726900117"
            ]
          },
          "726900117": {
            "id": "726900117",
            "speakerId": 1000,
            "speakerName": "柴染",
            "text": "不必客气。请用至美的「花庭」为这次的花艺体验之旅划上句点吧。"
          }
        }
      }
    },
    {
      "subId": "7269002",

  "subQuests": [
    {
      "subId": "7514502",
      "subQuestName": "(test)接取环$HIDDEN",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "751450201"
        ],
        "dialogs": {
          "751450201": {
            "id": "751450201",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "受龙所选者…啊，受龙所选者啊…",
            "nextDialogs": [
              "751450202"
            ]
          },
          "751450202": {
            "id": "751450202",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "圣山就在汝之身前…如若…就须清除…阴影之敌。",
            "nextDialogs": [
              "751450203"
            ]
          },
          "751450203": {
            "id": "751450203",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "啊，受龙所选者…进入…进入圣山吧…",
            "nextDialogs": [
              "751450204"
            ]
          },
          "751450204": {
            "id": "751450204",
            "speakerId": 14662,
            "speakerName": "#{REALNAME[ID(2)|SHOWHOST(true)]}",
            "text": "呜…",
            "nextDialogs": [
              "751450205"
            ]
          },
          "751450205": {
            "id": "751450205",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "刚才…火山喷发了…？",
            "nextDialogs": [
              "751450206"
            ]
          },
          "751450206": {
            "id": "751450206",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "没有哦，刚才火山非常安静…你们看到火山喷发了吗？",
            "nextDialogs": [
              "751450207"
            ]
          },
          "751450207": {
            "id": "751450207",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "#怎么了，{NICKNAME}，还有{REALNAME[ID(2)|SHOWHOST(true)]}，怎么一副沉思的样子…",
            "nextDialogs": [
              "751450208"
            ]
          },
          "751450208": {
            "id": "751450208",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "简直就像是侦探小说里突然想到了事件真相的侦探一样…",
            "nextDialogs": [
              "751450210",
              "751450213"
            ]
          },
          "751450210": {
            "id": "751450210",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "（向派蒙说明了所看到的…）",
            "nextDialogs": [
              "751450211"
            ]
          },
          "751450211": {
            "id": "751450211",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "#啊，你是说，看到了和刚进入纳塔遇到{REALNAME[ID(2)|SHOWHOST(true)]}时看到的相同的东西…",
            "nextDialogs": [
              "751450218"
            ]
          },
          "751450218": {
            "id": "751450218",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "还有一些奇怪的影像吗？",
            "nextDialogs": [
              "751450219"
            ]
          },
          "751450219": {
            "id": "751450219",
            "speakerId": 14662,
            "speakerName": "#{REALNAME[ID(2)|SHOWHOST(true)]}",
            "text": "嗯？",
            "nextDialogs": [
              "751450220"
            ]
          },
          "751450220": {
            "id": "751450220",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "#在那个时候{NICKNAME}就说看到了奇怪的话…唔，我没看到所以不知道啦，感觉上，像是一个人说的吗？",
            "nextDialogs": [
              "751450221"
            ]
          },
          "751450221": {
            "id": "751450221",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "应该是同一个人…",
            "nextDialogs": [
              "751450222"
            ]
          },
          "751450222": {
            "id": "751450222",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "唔，感觉有点奇怪呢…不过，这次你们还看到…巨大的遗迹，破碎的城市，深渊…",
            "nextDialogs": [
              "751450223"
            ]
          },
          "751450223": {
            "id": "751450223",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "还有「圣山」…唔，纳塔人好像也称那座火山为「圣山」，难道说，你们看到的东西和那座火山有关？",
            "nextDialogs": [
              "751450224"
            ]
          },
          "751450224": {
            "id": "751450224",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "#总觉得那个把{REALNAME[ID(2)|SHOWHOST(true)]}交到我们手上的人好像很想让我们「进入圣山」的样子…",
            "nextDialogs": [
              "751450225"
            ]
          },
          "751450225": {
            "id": "751450225",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "到了圣山里以后，是不是就可以解开小家伙身上的那个什么「焰主之祝」了…",
            "nextDialogs": [
              "751450226"
            ]
          },
          "751450226": {
            "id": "751450226",
            "speakerId": 14662,
            "speakerName": "#{REALNAME[ID(2)|SHOWHOST(true)]}",
            "text": "呀！",
            "nextDialogs": [
              "751450227"
            ]
          },
          "751450227": {
            "id": "751450227",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "#嘿嘿，为了{REALNAME[ID(2)|SHOWHOST(true)]}能够健康长大！之后我们就去那个「圣山」看看吧。",
            "nextDialogs": [
              "751450228"
            ]
          },
          "751450228": {
            "id": "751450228",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "对了，纳塔六个部族中的「沃陆之邦」好像就在火山的一侧，说不定可以在那里打探到消息呢！"
          },
          "751450213": {
            "id": "751450213",
            "speakerId": 14662,
            "speakerName": "#{REALNAME[ID(2)|SHOWHOST(true)]}",
            "text": "呀！",
            "nextDialogs": [
              "751450214"
            ]
          },
          "751450214": {
            "id": "751450214",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "可恶，怎么会，明明我偷吃小蛋糕小姐的时候没有被任何人看到…才怪啦，我偷吃的是火焰炖肉。",
            "nextDialogs": [
              "751450215"
            ]
          },
          "751450215": {
            "id": "751450215",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "所以你…不对，你们刚才看到了什么呀？",
            "nextDialogs": [
              "751450216"
            ]
          },
          "751450216": {
            "id": "751450216",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "（向派蒙说明了所看到的…）",
            "nextDialogs": [
              "751450217"
            ]
          },
          "751450217": {
            "id": "751450217",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "又看到了奇怪的话…"
          }
        }
      }
    },

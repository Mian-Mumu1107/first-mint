{
  "lineCounts": {
    "Black Screen": 3,
    "Player": 15,
    "兰拉娜": 22,
    "拉娜": 38,
    "派蒙": 20
  },
  "subQuests": [
    {
      "subId": "7303801",
      "subQuestName": "与兰拉娜对话",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "730380101"
        ],
        "dialogs": {
          "730380101": {
            "id": "730380101",
            "speakerId": 1000,
            "speakerName": "兰拉娜",
            "text": "觉王树…奇怪。觉王树不应该在这里。金色的那菈、白毛飞飞…兰拉娜不认识。但是，有熟悉的感觉。你们是谁？",
            "nextDialogs": [
              "730380102"
            ]
          },
          "730380102": {
            "id": "730380102",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "兰拉娜，真的忘记了…",
            "nextDialogs": [
              "730380103"
            ]
          },
          "730380103": {
            "id": "730380103",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "#我叫派蒙，{M#他}{F#她}是{NICKNAME}。",
            "nextDialogs": [
              "730380104"
            ]
          },
          "730380104": {
            "id": "730380104",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "我们是兰拉娜的朋友。",
            "nextDialogs": [
              "730380105"
            ]
          },
          "730380105": {
            "id": "730380105",
            "speakerId": 1000,
            "speakerName": "兰拉娜",
            "text": "嗯。兰拉娜相信你们。你们有善良的气味…",
            "nextDialogs": [
              "730380106"
            ]
          },
          "730380106": {
            "id": "730380106",
            "speakerId": 1000,
            "speakerName": "兰拉娜",
            "text": "兰拉娜明白了。本来，心里就像有一个洞一样，重要的记忆都溜走了。但是，看到觉王树、看到你们，又明白了很多。",
            "nextDialogs": [
              "730380107"
            ]
          },
          "730380107": {
            "id": "730380107",
            "speakerId": 1000,
            "speakerName": "兰拉娜",
            "text": "刚刚看到了，你们拿了「惟耶之实」吗？为了帮助朋友，所以兰拉娜忘记了很多，然后请觉王树结出了果子。",
            "nextDialogs": [
              "730380108"
            ]
          },
          "730380108": {
            "id": "730380108",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "兰拉娜很聪明呢…「朋友」的事情，你还记得吗？",
            "nextDialogs": [
              "730380109"
            ]
          },
          "730380109": {
            "id": "730380109",
            "speakerId": 1000,
            "speakerName": "兰拉娜",
            "text": "不记得。不过，没关系。既然惟耶之实在你们手中，你们一定也是兰拉娜相信的朋友，也是觉王树认可的那菈。",
            "nextDialogs": [
              "730380110"
            ]
          },
          "730380110": {
            "id": "730380110",
            "speakerId": 1000,
            "speakerName": "兰拉娜",
            "text": "拜托你们，把惟耶之实，带给兰拉娜需要帮助的朋友。",
            "nextDialogs": [
              "730380112"
            ]
          },
          "730380112": {
            "id": "730380112",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "兰拉娜，我们一起去吧！你的朋友，一定也想再见到你！",
            "nextDialogs": [
              "730380114"
            ]
          },
          "730380114": {
            "id": "730380114",
            "speakerId": 1000,
            "speakerName": "兰拉娜",
            "text": "……",
            "nextDialogs": [
              "730380115"
            ]
          },
          "730380115": {
            "id": "730380115",
            "speakerId": 1000,
            "speakerName": "兰拉娜",
            "text": "兰拉娜不要。兰拉娜已经忘记了。如果朋友看到兰拉娜忘记了自己，那一定会伤心，觉得兰拉娜不爱惜朋友。",
            "nextDialogs": [
              "730380116"
            ]
          },
          "730380116": {
            "id": "730380116",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "兰拉娜想要帮助的那个朋友，她是很好的人…很好的那菈。就算兰拉娜不记得她了，她也愿意重新当你的朋友。",
            "nextDialogs": [
              "730380117"
            ]
          },
          "730380117": {
            "id": "730380117",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "所以，我们一起去，好吗？",
            "nextDialogs": [
              "730380118"
            ]
          },
          "730380118": {
            "id": "730380118",
            "speakerId": 1000,
            "speakerName": "兰拉娜",
            "text": "…嗯。",
            "nextDialogs": [
              "730380119"
            ]
          },
          "730380119": {
            "id": "730380119",
            "speakerId": 1000,
            "speakerName": "兰拉娜",
            "text": "知道了。兰拉娜相信你们，你们是朋友。"
          }
        }
      }
    },
    {
      "subId": "7303802",
      "subQuestName": "返回拉娜身边",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "730380201"
        ],
        "dialogs": {
          "730380201": {
            "id": "730380201",
            "speakerId": 1000,
            "speakerName": "兰拉娜",
            "text": "这是，兰拉娜的兰迦拉梨…",
            "nextDialogs": [
              "730380202"
            ]
          },
          "730380202": {
            "id": "730380202",
            "speakerId": 1000,
            "speakerName": "兰拉娜",
            "text": "她就是，兰拉娜的那菈朋友吗？",
            "nextDialogs": [
              "730380203"
            ]
          },
          "730380203": {
            "id": "730380203",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "#嗯。那么，{NICKNAME}…",
            "nextDialogs": [
              "730380204"
            ]
          },
          "730380204": {
            "id": "730380204",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "（使用惟耶之实。）"
          }
        }
      }
    },
    {
      "subId": "7303803",
      "subQuestName": "与拉娜对话",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "730380301"
        ],
        "dialogs": {
          "730380301": {
            "id": "730380301",
            "speakerId": 1002,
            "speakerName": "拉娜",
            "text": "呜…",
            "nextDialogs": [
              "730380302"
            ]
          },
          "730380302": {
            "id": "730380302",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "醒过来了吗…？",
            "nextDialogs": [
              "730380305"
            ]
          },
          "730380305": {
            "id": "730380305",
            "speakerId": 1002,
            "speakerName": "拉娜",
            "text": "#咦？我又睡着了吗…这里是？{NICKNAME}、派蒙，你们没事真是太好了！我好担心，你们有没有受到死域的伤害。还有…",
            "nextDialogs": [
              "730380306"
            ]
          },
          "730380306": {
            "id": "730380306",
            "speakerId": 1002,
            "speakerName": "拉娜",
            "text": "兰拉娜？是你吗，兰拉娜…",
            "nextDialogs": [
              "730380307"
            ]
          },
          "730380307": {
            "id": "730380307",
            "speakerId": 1000,
            "speakerName": "兰拉娜",
            "text": "你好，那菈朋友。",
            "nextDialogs": [
              "730380308"
            ]
          },
          "730380308": {
            "id": "730380308",
            "speakerId": 1002,
            "speakerName": "拉娜",
            "text": "我等了你好久好久…我做了一个好长、好长的梦，梦见我遇见你的时候了…",
            "nextDialogs": [
              "730380309"
            ]
          },
          "730380309": {
            "id": "730380309",
            "speakerId": 1002,
            "speakerName": "拉娜",
            "text": "我梦见，我在森林里迷路了，找不到家，也找不到爸爸妈妈。我一直哭。你听见哭声，就过来找我，唱歌给我听…",
            "nextDialogs": [
              "730380310"
            ]
          },
          "730380310": {
            "id": "730380310",
            "speakerId": 1002,
            "speakerName": "拉娜",
            "text": "后来，我们成为了最好的朋友。我经常到森林里找你玩。你送了一朵花给我，还教了我好多好多东西，很多森林的秘密。",
            "nextDialogs": [
              "730380311"
            ]
          },
          "730380311": {
            "id": "730380311",
            "speakerId": 1002,
            "speakerName": "拉娜",
            "text": "像是，星蕈是天上的星星落在地上的倒影。像是，见到月莲开放的话…",
            "nextDialogs": [
              "730380312"
            ]
          },
          "730380312": {
            "id": "730380312",
            "speakerId": 1000,
            "speakerName": "兰拉娜",
            "text": "见到月莲开放的话，到月亮再次升起为止都会变得幸运。",
            "nextDialogs": [
              "730380313"
            ]
          },
          "730380313": {
            "id": "730380313",
            "speakerId": 1002,
            "speakerName": "拉娜",
            "text": "没错！就是这个！然后，我梦见…",
            "nextDialogs": [
              "730380314"
            ]
          },
          "730380314": {
            "id": "730380314",
            "speakerId": 1002,
            "speakerName": "拉娜",
            "text": "我梦见，为了维摩庄的大家，我快快地长大，成了可靠的大人，成了巡林官。可靠的大人，是不相信森林中的精灵童话的。",
            "nextDialogs": [
              "730380315"
            ]
          },
          "730380315": {
            "id": "730380315",
            "speakerId": 1002,
            "speakerName": "拉娜",
            "text": "我梦见，我把你给忘了。我以为兰那罗的故事，都是优丹他们小孩子的童话。我梦见，森林不过是很多树的土地，并没有魔法…",
            "nextDialogs": [
              "730380316"
            ]
          },
          "730380316": {
            "id": "730380316",
            "speakerId": 1002,
            "speakerName": "拉娜",
            "text": "刚刚醒来的时候，我真的好害怕，我害怕要是我真的忘了你，那该怎么办才好…幸好只是做梦而已！能再见到你，我好高兴喔！",
            "nextDialogs": [
              "730380317"
            ]
          },
          "730380317": {
            "id": "730380317",
            "speakerId": 1002,
            "speakerName": "拉娜",
            "text": "兰拉娜，你到哪去了呀！我等了你好久好久，等你把我带到森林里去…和你一起时才有的，充满秘密的神奇的森林…",
            "nextDialogs": [
              "730380318"
            ]
          },
          "730380318": {
            "id": "730380318",
            "speakerId": 1000,
            "speakerName": "兰拉娜",
            "text": "对不起。兰拉娜不记得了。",
            "nextDialogs": [
              "730380319"
            ]
          },
          "730380319": {
            "id": "730380319",
            "speakerId": 1002,
            "speakerName": "拉娜",
            "text": "欸…？",
            "nextDialogs": [
              "730380320"
            ]
          },
          "730380320": {
            "id": "730380320",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "嗯…拉娜，你不要怪兰拉娜。事情是这样的…",
            "nextDialogs": [
              "730380321"
            ]
          },
          "730380321": {
            "id": "730380321",
            "speakerId": 1003,
            "speakerName": "Black Screen",
            "text": "「…在寻找你的时候，我们遇到了兰拉娜。兰拉娜说…」",
            "nextDialogs": [
              "730380322"
            ]
          },
          "730380322": {
            "id": "730380322",
            "speakerId": 1003,
            "speakerName": "Black Screen",
            "text": "无郁稠林的菌冠、雨的尽头的战斗。遗迹巨像的内部，蔷薇中的小曲。扮演兄妹的兰那罗，无忧节的欢快景象…\\n慢慢地将这些时日里，与兰那罗们一起的故事，告诉了拉娜与兰拉娜。",
            "nextDialogs": [
              "730380323"
            ]
          },
          "730380323": {
            "id": "730380323",
            "speakerId": 1002,
            "speakerName": "拉娜",
            "text": "原来，忘记了的是我…",
            "nextDialogs": [
              "730380324"
            ]
          },
          "730380324": {
            "id": "730380324",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "惟耶之实是由记忆凝结成的…或许与你一起的记忆对兰拉娜而言太过珍贵，所以在治愈你的时候，让你也想起了以前的事呢…",
            "nextDialogs": [
              "730380325"
            ]
          },
          "730380325": {
            "id": "730380325",
            "speakerId": 1002,
            "speakerName": "拉娜",
            "text": "#谢谢你们…{NICKNAME}、派蒙…为了帮助我，竟然经历了这么多辛苦的事情…"
          }
        }
      }
    }
  ]
}
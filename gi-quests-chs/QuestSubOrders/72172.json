    {
      "subId": "7217201",
      "subQuestName": "与阿釜对话",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "721720101"
        ],
        "dialogs": {
          "721720101": {
            "id": "721720101",
            "speakerId": 1000,
            "speakerName": "阿釜",
            "text": "有什么事？",
            "nextDialogs": [
              "721720102"
            ]
          },
          "721720102": {
            "id": "721720102",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "我们在鹤观遇到了一些很在意的事情…",
            "nextDialogs": [
              "721720103"
            ]
          },
          "721720103": {
            "id": "721720103",
            "speakerId": 1000,
            "speakerName": "阿釜",
            "text": "所以呢？",
            "nextDialogs": [
              "721720105",
              "721720111"
            ]
          },
          "721720105": {
            "id": "721720105",
            "speakerId": 1000,
            "speakerName": "阿釜",
            "text": "有没有关系都和你们没有关系。",
            "nextDialogs": [
              "721720106"
            ]
          },
          "721720106": {
            "id": "721720106",
            "speakerId": 1000,
            "speakerName": "阿釜",
            "text": "你们已经为墨田大人找到木簧笛了，我们没必要再扯上关系。",
            "nextDialogs": [
              "721720107"
            ]
          },
          "721720107": {
            "id": "721720107",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "唔…好冷淡。其实，墨田小姐的委托还没有完。她委托我们继续调查鹤观的事情…",
            "nextDialogs": [
              "721720108"
            ]
          },
          "721720108": {
            "id": "721720108",
            "speakerId": 1000,
            "speakerName": "阿釜",
            "text": "行。我明白了。",
            "nextDialogs": [
              "721720109"
            ]
          },
          "721720109": {
            "id": "721720109",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "欸！居然这么干脆就…",
            "nextDialogs": [
              "721720112"
            ]
          },
          "721720112": {
            "id": "721720112",
            "speakerId": 1000,
            "speakerName": "阿釜",
            "text": "「釜」是家族的…应该算是氏族名吧。我的祖先是从鹤观来的。",
            "nextDialogs": [
              "721720113"
            ]
          },
          "721720113": {
            "id": "721720113",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "震惊！墨田小姐为什么不告诉我！"
          },
          "721720111": {
            "id": "721720111",
            "speakerId": 1000,
            "speakerName": "阿釜",
            "text": "行。我明白了。"
          }
        }
      }
    },
    {

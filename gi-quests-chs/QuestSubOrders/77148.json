  "subQuests": [
    {
      "subId": "7714801",
      "subQuestName": "(test)隐藏$HIDDEN",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "771480901"
        ],
        "dialogs": {
          "771480901": {
            "id": "771480901",
            "speakerId": 22614,
            "speakerName": "达什科夫",
            "text": "了不起的「契科塔」警探么，我当然知道。不过就像我反复重申的——",
            "nextDialogs": [
              "771480902"
            ]
          },
          "771480902": {
            "id": "771480902",
            "speakerId": 22614,
            "speakerName": "达什科夫",
            "text": "我们这儿没有违法的勾当，全都是合规合法、你情我愿的…喂，伊基塔！你说说看，我的话可有半分虚假？",
            "nextDialogs": [
              "771480903"
            ]
          },
          "771480903": {
            "id": "771480903",
            "speakerId": 22614,
            "speakerName": "达什科夫",
            "text": "对了，这厮是个老赌鬼，赌到除了家人和自己，再没有可以抵押的东西。",
            "nextDialogs": [
              "771480904"
            ]
          },
          "771480904": {
            "id": "771480904",
            "speakerId": 22614,
            "speakerName": "达什科夫",
            "text": "是我们「伊兹梅洛」给了他机会，让他可以用劳动来抵偿债务。只要还清了债，就可以和家人团聚了。",
            "nextDialogs": [
              "771480905"
            ]
          },
          "771480905": {
            "id": "771480905",
            "speakerId": 22614,
            "speakerName": "达什科夫",
            "text": "这要是换了别的帮派，难保不会上演骨肉分离的戏码呀，你说是不是啊，伊基塔？",
            "nextDialogs": [
              "771480906"
            ]
          },
          "771480906": {
            "id": "771480906",
            "speakerId": 22600,
            "speakerName": "伊基塔",
            "text": "是…我欠了「伊兹梅洛」的钱，我是自愿在这里劳作还债的…",
            "nextDialogs": [
              "771480907"
            ]
          },
          "771480907": {
            "id": "771480907",
            "speakerId": 22614,
            "speakerName": "达什科夫",
            "text": "警探，你可是亲耳听到了，咱们这儿没有问题。",
            "nextDialogs": [
              "771480908"
            ]
          },
          "771480908": {
            "id": "771480908",
            "speakerId": 10205,
            "speakerName": "？？？",
            "text": "我不信…他们各个脸上一丝活气都没有，这哪可能是正常的劳动环境？",
            "nextDialogs": [
              "771480909"
            ]
          },
          "771480909": {
            "id": "771480909",
            "speakerId": 10205,
            "speakerName": "？？？",
            "text": "我要单独询问这里的工人，你们「伊兹梅洛」的人不能在场。",
            "nextDialogs": [
              "771480910"
            ]
          },
          "771480910": {
            "id": "771480910",
            "speakerId": 22614,
            "speakerName": "达什科夫",
            "text": "唉，软的不行只能来硬的了么…警探，你的朋友一定抱怨过你是个不识相的家伙吧。",
            "nextDialogs": [
              "771480911"
            ]
          },
          "771480911": {
            "id": "771480911",
            "speakerId": 10205,
            "speakerName": "？？？",
            "text": "什么？从、从来没有人这么说过我！",
            "nextDialogs": [
              "771480912"
            ]
          },
          "771480912": {
            "id": "771480912",
            "speakerId": 22614,
            "speakerName": "达什科夫",
            "text": "哦，那就是连称得上是朋友的人也没有了，这倒不奇怪。",
            "nextDialogs": [
              "771480913"
            ]
          },
          "771480913": {
            "id": "771480913",
            "speakerId": 22614,
            "speakerName": "达什科夫",
            "text": "告诉你一个坏消息，在这儿的全都是我的「朋友」，而且他们有一个共享的优点——嘴都牢靠得很。",
            "nextDialogs": [
              "771480914"
            ]
          },
          "771480914": {
            "id": "771480914",
            "speakerId": 10205,
            "speakerName": "？？？",
            "text": "你在说什么…",
            "nextDialogs": [
              "771480915"
            ]
          },
          "771480915": {
            "id": "771480915",
            "speakerId": 22614,
            "speakerName": "达什科夫",
            "text": "意思就是，不管你在这儿遭遇了什么，都不会传出去！"
          }
        }
      }
    },
    {
      "subId": "7714802",
      "subQuestName": "(test)隐藏$HIDDEN",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "771480201"
        ],
        "dialogs": {
          "771480201": {
            "id": "771480201",
            "speakerId": 22599,
            "speakerName": "萨尔沃夫",
            "text": "得、得救了！「契科塔」总算来解救我们了…",
            "nextDialogs": [
              "771480202"
            ]
          },
          "771480202": {
            "id": "771480202",
            "speakerId": 22598,
            "speakerName": "基耶塔",
            "text": "警探，他们人多势众，我们好不容易才找准时机突出重围，你们可要多加小心啊！",
            "nextDialogs": [
              "771480203"
            ]
          },
          "771480203": {
            "id": "771480203",
            "speakerId": 22598,
            "speakerName": "基耶塔",
            "text": "一支小队可能都够呛…警探，你的队伍呢？",
            "nextDialogs": [
              "771480204"
            ]
          },
          "771480204": {
            "id": "771480204",
            "speakerId": 22484,
            "speakerName": "多尼娅",
            "text": "执行任务的人都在这里了。",
            "nextDialogs": [
              "771480205"
            ]
          },
          "771480205": {
            "id": "771480205",
            "speakerId": 22599,
            "speakerName": "萨尔沃夫",
            "text": "才三个人？不对…两个半？",
            "nextDialogs": [
              "771480206"
            ]
          },
          "771480206": {
            "id": "771480206",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "的确，多尼娅怎么看都不像是能独当一面的警探所以只能算半个——",
            "nextDialogs": [
              "771480207"
            ]
          },
          "771480207": {
            "id": "771480207",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "才怪啦，你是把我看扁了对不对，真是没礼貌的家伙。",
            "nextDialogs": [
              "771480208"
            ]
          },
          "771480208": {
            "id": "771480208",
            "speakerId": 22599,
            "speakerName": "萨尔沃夫",
            "text": "抱歉抱歉…我只是担心光靠几位的话，实在不是「伊兹梅洛」 头领的对手呀。",
            "nextDialogs": [
              "771480209"
            ]
          },
          "771480209": {
            "id": "771480209",
            "speakerId": 22599,
            "speakerName": "萨尔沃夫",
            "text": "那个叫古萨罗夫的，就在据点把守…光是想到他，唉，就像一脚踩进了冻原上的冰窟窿，心脏都要停跳了。",
            "nextDialogs": [
              "771480210"
            ]
          },
          "771480210": {
            "id": "771480210",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "那你们是怎么逃出来的？",
            "nextDialogs": [
              "771480211"
            ]
          },
          "771480211": {
            "id": "771480211",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "是哦！既然据点有那么多那么强的家伙看守，你们几个是怎么逃出来的？除非…除非你们是被故意放出来的…我知道了！",
            "nextDialogs": [
              "771480212"
            ]
          },
          "771480212": {
            "id": "771480212",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "一定是「伊兹梅洛」 的阴谋！",
            "nextDialogs": [
              "771480213"
            ]
          },
          "771480213": {
            "id": "771480213",
            "speakerId": 22484,
            "speakerName": "多尼娅",
            "text": "停一停！我是警探，推理的部分应该交给我。",
            "nextDialogs": [
              "771480214"
            ]
          },
          "771480214": {
            "id": "771480214",
            "speakerId": 22484,
            "speakerName": "多尼娅",
            "text": "咳，你们根本不是普通的工人，而是「伊兹梅洛」 放出的鱼饵…",
            "nextDialogs": [
              "771480215"
            ]
          },
          "771480215": {
            "id": "771480215",
            "speakerId": 22484,
            "speakerName": "多尼娅",
            "text": "为的是将我们——越多越好——引入设好的口袋，再一网打尽！",
            "nextDialogs": [
              "771480216"
            ]
          },
          "771480216": {
            "id": "771480216",
            "speakerId": 22484,
            "speakerName": "多尼娅",
            "text": "老实交代，这就是你们的伎俩对吧！我可是经过训练的警探，耍花招对我可没用！",
            "nextDialogs": [
              "771480217"
            ]
          },
          "771480217": {
            "id": "771480217",
            "speakerId": 22598,
            "speakerName": "基耶塔",
            "text": "呃，不是的，警探，是我贿赂了看守。不过刚逃出来就被发现了，所以才会有追兵…",
            "nextDialogs": [
              "771480218"
            ]
          },
          "771480218": {
            "id": "771480218",
            "speakerId": 22599,
            "speakerName": "萨尔沃夫",
            "text": "我们是真的担心你们，毕竟要是你们折了，我们就得过比以前更苦的日子了…",
            "nextDialogs": [
              "771480219"
            ]
          },
          "771480219": {
            "id": "771480219",
            "speakerId": 22484,
            "speakerName": "多尼娅",
            "text": "呜哇，太丢人了…原本以为能像前辈们那样帅气地说出事情的真相，没想到是我误会了…",
            "nextDialogs": [
              "771480220"
            ]
          },
          "771480220": {
            "id": "771480220",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "等一下，你不是警探吗，这么轻信真的没问题吗！",
            "nextDialogs": [
              "771480223"
            ]
          },
          "771480223": {
            "id": "771480223",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "好吧，那就还是按原计划…先到据点再说吧！"
          }
        }
      }
    },
    {
      "subId": "7714805",
      "subQuestName": "(test)隐藏$HIDDEN",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "771480301"
        ],
        "dialogs": {
          "771480301": {
            "id": "771480301",
            "speakerId": 22484,
            "speakerName": "多尼娅",
            "text": "刚才多谢了。我是「契科{RUBY#[S]至冬皇家轨道运输局}塔」的警探，你们可以叫我多尼娅。敢问两位尊姓大名？",
            "nextDialogs": [
              "771480302"
            ]
          },
          "771480302": {
            "id": "771480302",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "#{M#他}{F#她}是{NICKNAME}，我是派蒙，我们是…路见不平拔刀相助的冒险家！",
            "nextDialogs": [
              "771480303"
            ]
          },
          "771480303": {
            "id": "771480303",
            "speakerId": 22484,
            "speakerName": "多尼娅",
            "text": "原来如此，不过真是让两位见笑了，我真的很不擅长交涉，明明在来这里之前下定决心不要冲动行事，结果最后还是…",
            "nextDialogs": [
              "771480304"
            ]
          },
          "771480304": {
            "id": "771480304",
            "speakerId": 22484,
            "speakerName": "多尼娅",
            "text": "真是愧对各位前辈的教导，不过我也记得前辈曾说：「决定一个警探合格与否的关键便是于『关键时刻』挺身而出的勇气！",
            "nextDialogs": [
              "771480305"
            ]
          },
          "771480305": {
            "id": "771480305",
            "speakerId": 22484,
            "speakerName": "多尼娅",
            "text": "我想至少在这一点上，我是「合格」的！对了，就当刚才是前辈们所说的「关键时刻」吧！",
            "nextDialogs": [
              "771480306"
            ]
          },
          "771480306": {
            "id": "771480306",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "只要出手就是「关键时刻」吗…",
            "nextDialogs": [
              "771480307"
            ]
          },
          "771480307": {
            "id": "771480307",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "嘿嘿，就应该这样嘛！如果连挺身而出的勇气都没有，那还做什么警探…不过，嗯…你们的任务是来解救这里的伐木场工人吗？",
            "nextDialogs": [
              "771480308"
            ]
          },
          "771480308": {
            "id": "771480308",
            "speakerId": 22484,
            "speakerName": "多尼娅",
            "text": "说来惭愧…其实我的任务是前期的探查——就是在最终收网之前，暗中调查「伊兹梅洛」帮在这片区域的人员安排…",
            "nextDialogs": [
              "771480309"
            ]
          },
          "771480309": {
            "id": "771480309",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "暗中调查？可我们刚才已经把人揍了一顿欸！",
            "nextDialogs": [
              "771480310"
            ]
          },
          "771480310": {
            "id": "771480310",
            "speakerId": 22484,
            "speakerName": "多尼娅",
            "text": "是啊，已经打草惊蛇…不对，可以说是全面开战了吧。不过好在我已经摸清了据点的所在…",
            "nextDialogs": [
              "771480311"
            ]
          },
          "771480311": {
            "id": "771480311",
            "speakerId": 22484,
            "speakerName": "多尼娅",
            "text": "事到如今，只能由我来执行收网任务了！",
            "nextDialogs": [
              "771480312"
            ]
          },
          "771480312": {
            "id": "771480312",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "你要一个人包围他们所有人吗？",
            "nextDialogs": [
              "771480313"
            ]
          },
          "771480313": {
            "id": "771480313",
            "speakerId": 22484,
            "speakerName": "多尼娅",
            "text": "是的，看来在上一个「关键时刻」过后，马上又迎来了下一个「关键时刻」。",
            "nextDialogs": [
              "771480314"
            ]
          },
          "771480314": {
            "id": "771480314",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "#呃，时不时刻的先放一边，我和{NICKNAME}也来帮忙吧。",
            "nextDialogs": [
              "771480315"
            ]
          },
          "771480315": {
            "id": "771480315",
            "speakerId": 22484,
            "speakerName": "多尼娅",
            "text": "多么热心的冒险家！要是其他冒险家也像你们这样热心就好了。",
            "nextDialogs": [
              "771480316"
            ]
          },
          "771480316": {
            "id": "771480316",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "总不能眼睁睁看你包围不成反被包围嘛。"
          }
        }
      }
    },

    {
      "subId": "7714822",
      "subQuestName": "前往宝藏埋藏点",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "771483201"
        ],
        "dialogs": {
          "771483201": {
            "id": "771483201",
            "speakerId": 22484,
            "speakerName": "多尼娅",
            "text": "哇！好大的一块冰…唔，仔细一看，里面是不是有东西？",
            "nextDialogs": [
              "771483202"
            ]
          },
          "771483202": {
            "id": "771483202",
            "speakerId": 22601,
            "speakerName": "格里克",
            "text": "里面…啊，原来「大盗宝藏」被封在了里面，我们还以为里面只是一些石头…",
            "nextDialogs": [
              "771483203"
            ]
          },
          "771483203": {
            "id": "771483203",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "不过这个冰放这么久，都还没化。",
            "nextDialogs": [
              "771483204"
            ]
          },
          "771483204": {
            "id": "771483204",
            "speakerId": 22484,
            "speakerName": "多尼娅",
            "text": "至冬就是这样的天气嘛，这种冰在冻原上不管，只会越变越大。",
            "nextDialogs": [
              "771483205"
            ]
          },
          "771483205": {
            "id": "771483205",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "「关键时刻」…",
            "nextDialogs": [
              "771483206"
            ]
          },
          "771483206": {
            "id": "771483206",
            "speakerId": 22484,
            "speakerName": "多尼娅",
            "text": "再怎么关键，冰也破不了！",
            "nextDialogs": [
              "771483207"
            ]
          },
          "771483207": {
            "id": "771483207",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "用什么暖和的东西让它融化就好了吧。",
            "nextDialogs": [
              "771483208"
            ]
          },
          "771483208": {
            "id": "771483208",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "#{NICKNAME}，我记得不是有那种奇怪的臻冰机关…说不定能用那个！",
            "nextDialogs": [
              "771483209"
            ]
          },
          "771483209": {
            "id": "771483209",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "来试试看吧！"
          }
        }
      }
    },

    {
      "subId": "7714811",
      "subQuestName": "解决盘踞此处的帮派成员",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "771481101"
        ],
        "dialogs": {
          "771481101": {
            "id": "771481101",
            "speakerId": 1011,
            "speakerName": "Black Screen",
            "text": "费了一番功夫，将击败的「伊兹梅洛」成员塞进了一旁的小屋…",
            "nextDialogs": [
              "771481102"
            ]
          },
          "771481102": {
            "id": "771481102",
            "speakerId": 22484,
            "speakerName": "多尼娅",
            "text": "锁上了。之后通知同事来接管就好了。",
            "nextDialogs": [
              "771481103"
            ]
          },
          "771481103": {
            "id": "771481103",
            "speakerId": 22484,
            "speakerName": "多尼娅",
            "text": "#也辛苦两位了。这还是我第一次独自执行任务呢，要是没有{NICKNAME}相助，不知会是什么下场…",
            "nextDialogs": [
              "771481104"
            ]
          },
          "771481104": {
            "id": "771481104",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "你是说，你第一次独自执行任务，就单枪匹马闹到和犯罪团伙全面开战的地步？",
            "nextDialogs": [
              "771481105"
            ]
          },
          "771481105": {
            "id": "771481105",
            "speakerId": 22484,
            "speakerName": "多尼娅",
            "text": "在「关键时刻」挺身而出，剿灭了黑恶势力，也算是立下了大功吧！嘿嘿。",
            "nextDialogs": [
              "771481106"
            ]
          },
          "771481106": {
            "id": "771481106",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "算、算吗？",
            "nextDialogs": [
              "771481108",
              "771481110"
            ]
          },
          "771481108": {
            "id": "771481108",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "话是这么说啦。但也不是所有事只要结果没问题，过程就可以不择手段的！",
            "nextDialogs": [
              "771481111"
            ]
          },
          "771481111": {
            "id": "771481111",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "话说回来，现在那些工人该怎么办呢？",
            "nextDialogs": [
              "771481112"
            ]
          },
          "771481112": {
            "id": "771481112",
            "speakerId": 22484,
            "speakerName": "多尼娅",
            "text": "担心的话就去看看？我知道他们会在哪里，跟我来吧。"
          },
          "771481110": {
            "id": "771481110",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "到底是哪种组织啦！不过的确，不管什么组织，规则都是很重要的吧。"
          }
        }
      }
    },
    {
      "subId": "7714819",
      "subQuestName": "解决盘踞此处的帮派成员",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "771481401"
        ],
        "dialogs": {
          "771481401": {
            "id": "771481401",
            "speakerId": 22486,
            "speakerName": "古萨罗夫",
            "text": "唔…真有两下子。犯不着在这儿折了…我们改日再战！",
            "nextDialogs": [
              "771481402"
            ]
          },
          "771481402": {
            "id": "771481402",
            "speakerId": 22484,
            "speakerName": "多尼娅",
            "text": "#啊！我的「关键时刻」要逃跑了！{NICKNAME}，我们快追！"
          }
        }
      }
    },

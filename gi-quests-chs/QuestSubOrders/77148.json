    {
      "subId": "7714816",
      "subQuestName": "与格里克对话",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "771480801"
        ],
        "dialogs": {
          "771480801": {
            "id": "771480801",
            "speakerId": 22601,
            "speakerName": "格里克",
            "text": "原来这就是那群「伊兹梅洛」想找的东西，他们就是为了这个才霸占了我的伐木场。",
            "nextDialogs": [
              "771480802"
            ]
          },
          "771480802": {
            "id": "771480802",
            "speakerId": 22601,
            "speakerName": "格里克",
            "text": "这么多摩拉，哪怕只用其中的一小部分，就能让伐木场恢复运转了。",
            "nextDialogs": [
              "771480803"
            ]
          },
          "771480803": {
            "id": "771480803",
            "speakerId": 22601,
            "speakerName": "格里克",
            "text": "不过我听说冒险家协会的规定是，野外无主的财宝，谁发现就归谁所有…",
            "nextDialogs": [
              "771480805"
            ]
          },
          "771480805": {
            "id": "771480805",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "没错没错！全都归我们了！",
            "nextDialogs": [
              "771480806"
            ]
          },
          "771480806": {
            "id": "771480806",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "…等等，这分明就是「伊兹梅洛」那群恶棍会说的台词吧！就算要拿，也应该给其他人留一些吧。",
            "nextDialogs": [
              "771480808"
            ]
          },
          "771480808": {
            "id": "771480808",
            "speakerId": 22484,
            "speakerName": "多尼娅",
            "text": "欸？我也有份？哇，到下次发薪日之前可以过得滋润一些了…",
            "nextDialogs": [
              "771480809"
            ]
          },
          "771480809": {
            "id": "771480809",
            "speakerId": 22484,
            "speakerName": "多尼娅",
            "text": "不、不对！多尼娅啊多尼娅，清醒一点！这可是考验你的「关键时刻」！怎么能这么轻易就被腐化呢！",
            "nextDialogs": [
              "771480810"
            ]
          },
          "771480810": {
            "id": "771480810",
            "speakerId": 22484,
            "speakerName": "多尼娅",
            "text": "…咳，这些财宝，就交给你们处置了。",
            "nextDialogs": [
              "771480811"
            ]
          },
          "771480811": {
            "id": "771480811",
            "speakerId": 22601,
            "speakerName": "格里克",
            "text": "那…承蒙各位的厚意，我只取一小份，用来修复伐木场的设施和工具，其他的就交给出力最多的冒险家吧。",
            "nextDialogs": [
              "771480812"
            ]
          },
          "771480812": {
            "id": "771480812",
            "speakerId": 22484,
            "speakerName": "多尼娅",
            "text": "我没有异议。",
            "nextDialogs": [
              "771480813"
            ]
          },
          "771480813": {
            "id": "771480813",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "嘿嘿，好哦，那这事就算结了？不过多尼娅，你还得去联系同事来处理残局吧？",
            "nextDialogs": [
              "771480814"
            ]
          },
          "771480814": {
            "id": "771480814",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "不知道你的前辈们发现你一个人就把「伊兹梅洛」的据点清理干净了会说什么。",
            "nextDialogs": [
              "771480815"
            ]
          },
          "771480815": {
            "id": "771480815",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "说不定等着你的不是夸奖，而是责怪呢！",
            "nextDialogs": [
              "771480816"
            ]
          },
          "771480816": {
            "id": "771480816",
            "speakerId": 22484,
            "speakerName": "多尼娅",
            "text": "应、应该不会吧？不过仔细想想也不是完全没有这种可能…该怎么办…对了！",
            "nextDialogs": [
              "771480817"
            ]
          },
          "771480817": {
            "id": "771480817",
            "speakerId": 22484,
            "speakerName": "多尼娅",
            "text": "#{NICKNAME}，这样，{NICKNAME}和派蒙就成为我的「关键时刻」吧，这样，前辈一定会谅解的！",
            "nextDialogs": [
              "771480818"
            ]
          },
          "771480818": {
            "id": "771480818",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "才不要啦！",
            "nextDialogs": [
              "771480819"
            ]
          },
          "771480819": {
            "id": "771480819",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "才不要啦，而且「关键时刻」到底是什么，越来越搞不明白了！"
          }
        }
      }
    },

    {
      "subId": "7714810",
      "subQuestName": "前往帮派据点",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "771481001"
        ],
        "dialogs": {
          "771481001": {
            "id": "771481001",
            "speakerId": 22486,
            "speakerName": "古萨罗夫",
            "text": "列科塔诺夫，近来常听闻工人不服管教，频频出逃，你可有什么借口。",
            "nextDialogs": [
              "771481002"
            ]
          },
          "771481002": {
            "id": "771481002",
            "speakerId": 22603,
            "speakerName": "列科塔诺夫",
            "text": "是小的办事不力。不过啊，老大，他们也是听信了那些风言风语，才越加张狂起来…",
            "nextDialogs": [
              "771481003"
            ]
          },
          "771481003": {
            "id": "771481003",
            "speakerId": 22486,
            "speakerName": "古萨罗夫",
            "text": "风言风语…是关于「小阁下」失势的传闻？",
            "nextDialogs": [
              "771481004"
            ]
          },
          "771481004": {
            "id": "771481004",
            "speakerId": 22603,
            "speakerName": "列科塔诺夫",
            "text": "是。而且听下面的弟兄们说，这几天还有「契科塔」的狗在附近嗅探，怕是很快就会有所行动。",
            "nextDialogs": [
              "771481005"
            ]
          },
          "771481005": {
            "id": "771481005",
            "speakerId": 22603,
            "speakerName": "列科塔诺夫",
            "text": "「小阁下」那边的援兵若是没有指望，光靠咱们，在这地界，怕是孤木难支呀。",
            "nextDialogs": [
              "771481006"
            ]
          },
          "771481006": {
            "id": "771481006",
            "speakerId": 22603,
            "speakerName": "列科塔诺夫",
            "text": "老大，要我说，既然没了靠山，不如咱们趁现在将那<color=#00E1FFFF>「大盗宝藏」</color>取了，不说潇洒快活，起码也好心里有底…",
            "nextDialogs": [
              "771481007"
            ]
          },
          "771481007": {
            "id": "771481007",
            "speakerId": 22486,
            "speakerName": "古萨罗夫",
            "text": "唔，就算没了「小阁下」，能源协会总归还在，日后定有用得到「伊兹梅洛」的时候。个中利弊，得谨慎权衡。",
            "nextDialogs": [
              "771481008"
            ]
          },
          "771481008": {
            "id": "771481008",
            "speakerId": 22603,
            "speakerName": "列科塔诺夫",
            "text": "老大说的是，但要是错过了这个时机…",
            "nextDialogs": [
              "771481009"
            ]
          },
          "771481009": {
            "id": "771481009",
            "speakerId": 1010,
            "speakerName": "「伊兹梅洛」打手",
            "text": "老、老大！「契科塔」打过来了！",
            "nextDialogs": [
              "771481010"
            ]
          },
          "771481010": {
            "id": "771481010",
            "speakerId": 22486,
            "speakerName": "古萨罗夫",
            "text": "什么？！这么快？他们来了多少人？",
            "nextDialogs": [
              "771481013"
            ]
          },
          "771481013": {
            "id": "771481013",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "束手就擒吧！现在放弃抵抗的话还有酌情处理的余地！",
            "nextDialogs": [
              "771481014"
            ]
          },
          "771481014": {
            "id": "771481014",
            "speakerId": 22484,
            "speakerName": "多尼娅",
            "text": "派、派蒙！「契科塔」的警探不能和犯罪分子谈条件！",
            "nextDialogs": [
              "771481015"
            ]
          },
          "771481015": {
            "id": "771481015",
            "speakerId": 22484,
            "speakerName": "多尼娅",
            "text": "而且这明明是我的「关键时刻」，风头全被两位抢了，呜…",
            "nextDialogs": [
              "771481016"
            ]
          },
          "771481016": {
            "id": "771481016",
            "speakerId": 22486,
            "speakerName": "古萨罗夫",
            "text": "搞什么…就凭你们？我们「伊兹梅洛」还没落魄到这份上！",
            "nextDialogs": [
              "771481017"
            ]
          },
          "771481017": {
            "id": "771481017",
            "speakerId": 22486,
            "speakerName": "古萨罗夫",
            "text": "#弟兄们，抄家伙，给{M#他们}{F#她们}点颜色瞧瞧！"
          }
        }
      }
    },
    {
      "subId": "7714812",
      "subQuestName": "与古萨罗夫对话",
      "sceneId": null,
      "locations": [],

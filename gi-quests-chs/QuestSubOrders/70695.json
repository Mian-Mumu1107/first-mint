        "dialogs": {
          "706950101": {
            "id": "706950101",
            "speakerId": 1002,
            "speakerName": "安柏",
            "text": "在龙脊雪山这么冷的地方办活动，气氛还是很重要的。如果不办得热闹一些，观众们会少很多乐趣。",
            "nextDialogs": [
              "706950102"
            ]
          },
          "706950102": {
            "id": "706950102",
            "speakerId": 1002,
            "speakerName": "安柏",
            "text": "有了这些游艺摊位之后，营地里的氛围也变得更轻松了。",
            "nextDialogs": [
              "706950103"
            ]
          },
          "706950103": {
            "id": "706950103",
            "speakerId": 1002,
            "speakerName": "安柏",
            "text": "我想干脆趁着这个机会，给各个队伍发些小礼品，可以用来装饰帐篷。",
            "nextDialogs": [
              "706950104"
            ]
          },
          "706950104": {
            "id": "706950104",
            "speakerId": 1002,
            "speakerName": "安柏",
            "text": "喏，这一份是给「炽魂斗士」小队的。",
            "nextDialogs": [
              "706950105"
            ]
          },
          "706950105": {
            "id": "706950105",
            "speakerId": 1002,
            "speakerName": "安柏",
            "text": "希望大家都有好心情，发挥出最佳水平。"
          }
        }
      }
    }
  ]

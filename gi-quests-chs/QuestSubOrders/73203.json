      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "732030601"
        ],
        "dialogs": {
          "732030601": {
            "id": "732030601",
            "speakerId": 4232,
            "speakerName": "赛芭",
            "text": "来找我聊天了吗？我可攒了一肚子的话。"
          }
        }
      }
    },
    {
      "subId": "7320304",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "732030401"
        ],
        "dialogs": {
          "732030401": {
            "id": "732030401",
            "speakerId": 4232,
            "speakerName": "赛芭",
            "text": "你不像是拥有神之眼的人，却能驾驭草元素的力量，不是一般的冒险家吧。",
            "nextDialogs": [
              "732030402"
            ]
          },
          "732030402": {
            "id": "732030402",
            "speakerId": 4232,
            "speakerName": "赛芭",
            "text": "据说的确有一帮人不借助神之眼就能驱动元素力，不过相关的传闻都很糟糕，你…",
            "nextDialogs": [
              "732030403"
            ]
          },
          "732030403": {
            "id": "732030403",
            "speakerId": 4232,
            "speakerName": "赛芭",
            "text": "总之我相信你是个热心的好人，不要走上歪路啊。"
          }
        }
      }
    }
  ]
}
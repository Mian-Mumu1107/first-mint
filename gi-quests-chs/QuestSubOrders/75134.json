  "subQuests": [
    {
      "subId": "7513401",
      "subQuestName": "进入遗迹内部",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "751340101"
        ],
        "dialogs": {
          "751340101": {
            "id": "751340101",
            "speakerId": 21583,
            "speakerName": "玻娜",
            "text": "那下面的事情就拜托你们啦，我和绿宝会在这里等你们回来。",
            "nextDialogs": [
              "751340102"
            ]
          },
          "751340102": {
            "id": "751340102",
            "speakerId": 21583,
            "speakerName": "玻娜",
            "text": "不管你们在下面发现了什么，可都要回来跟我们会合啊！"
          }
        }
      }
    },
    {
      "subId": "7513402",
      "subQuestName": "探索遗迹内部",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "751340201"
        ],
        "dialogs": {
          "751340201": {
            "id": "751340201",
            "speakerId": 14662,
            "speakerName": "#{REALNAME[ID(2)|SHOWHOST(true)]}",
            "text": "呜…",
            "nextDialogs": [
              "751340202"
            ]
          },
          "751340202": {
            "id": "751340202",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "呃啊，外面都被深渊侵蚀了，感觉随时会掉下来的样子，绿宝指给我们的难道就是这个东西吗？",
            "nextDialogs": [
              "751340203"
            ]
          },
          "751340203": {
            "id": "751340203",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "也不知道那里面是什么东西，反正我觉得肯定不会是什么祭坛啦…",
            "nextDialogs": [
              "751340204"
            ]
          },
          "751340204": {
            "id": "751340204",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "「只是一板一眼地盘逻辑的话…」",
            "nextDialogs": [
              "751340205"
            ]
          },
          "751340205": {
            "id": "751340205",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "啊啊，我知道啦。而且就是因为这些深渊，绿宝才会不愿意进来的吧。",
            "nextDialogs": [
              "751340206"
            ]
          },
          "751340206": {
            "id": "751340206",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "不能放着深渊不管。",
            "nextDialogs": [
              "751340207"
            ]
          },
          "751340207": {
            "id": "751340207",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "确实，就是因为这些深渊，绿宝才会不愿意进来的吧，不能放着不管呢。",
            "nextDialogs": [
              "751340208"
            ]
          },
          "751340208": {
            "id": "751340208",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "#出发了，{REALNAME[ID(2)|SHOWHOST(true)]}！",
            "nextDialogs": [
              "751340209"
            ]
          },
          "751340209": {
            "id": "751340209",
            "speakerId": 14662,
            "speakerName": "#{REALNAME[ID(2)|SHOWHOST(true)]}",
            "text": "呀！",
            "nextDialogs": [
              "751340210"
            ]
          },
          "751340210": {
            "id": "751340210",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "喂，你们两个怎么把我排除啦，好过分！",
            "nextDialogs": [
              "751340211"
            ]
          },
          "751340211": {
            "id": "751340211",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "总之我们就先把这些脏东西清理掉吧！"
          }
        }
      }
    },
    {
      "subId": "7513403",
      "subQuestName": "靠近可疑的核心",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "751340301"
        ],
        "dialogs": {
          "751340301": {
            "id": "751340301",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "呼，总算是结束了…",
            "nextDialogs": [
              "751340302"
            ]
          },
          "751340302": {
            "id": "751340302",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "保护它的秘源机兵也安静下来了呢。",
            "nextDialogs": [
              "751340303"
            ]
          },
          "751340303": {
            "id": "751340303",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "好吧，现在让我们看看这个里面到底是什么东西！",
            "nextDialogs": [
              "751340304"
            ]
          },
          "751340304": {
            "id": "751340304",
            "speakerId": 14662,
            "speakerName": "#{REALNAME[ID(2)|SHOWHOST(true)]}",
            "text": "呀！",
            "nextDialogs": [
              "751340305"
            ]
          },
          "751340305": {
            "id": "751340305",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "可不要让我失望哦…欸？又是一块火磷石，原来这东西还不止一枚的吗？",
            "nextDialogs": [
              "751340306"
            ]
          },
          "751340306": {
            "id": "751340306",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "唔，等等，包裹它的织卷看起来也很眼熟啊…就像是我们最开始在遗迹外面的塔楼里捡到的那个笔记。",
            "nextDialogs": [
              "751340307"
            ]
          },
          "751340307": {
            "id": "751340307",
            "speakerId": 14662,
            "speakerName": "#{REALNAME[ID(2)|SHOWHOST(true)]}",
            "text": "呀…呀！",
            "nextDialogs": [
              "751340308"
            ]
          },
          "751340308": {
            "id": "751340308",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "#哇，实在是太诡异了，{REALNAME[ID(2)|SHOWHOST(true)]}你也这样觉得吧，{NICKNAME}你快看看上面写的什么？",
            "nextDialogs": [
              "751340309"
            ]
          },
          "751340309": {
            "id": "751340309",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "哇，居然真的是之前那个冒险家留下来的笔记，「统律之心」说的就是这里吧。",
            "nextDialogs": [
              "751340311"
            ]
          },
          "751340311": {
            "id": "751340311",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "是哦，而且我们在这里也找到了新的火磷石，说不定在其它地方也会有很多呢。",
            "nextDialogs": [
              "751340312"
            ]
          },
          "751340312": {
            "id": "751340312",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "想不通的事情太多了。",
            "nextDialogs": [
              "751340313"
            ]
          },
          "751340313": {
            "id": "751340313",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "是哦，而且绿宝把我们指向了这里，难道是它早知道这下面还藏了一块火磷石，所以想要让我们拿到？真是搞不懂。",
            "nextDialogs": [
              "751340314"
            ]
          },
          "751340314": {
            "id": "751340314",
            "speakerId": 14662,
            "speakerName": "#{REALNAME[ID(2)|SHOWHOST(true)]}",
            "text": "呜…",
            "nextDialogs": [
              "751340315"
            ]
          },
          "751340315": {
            "id": "751340315",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "我们还是先回去吧。",
            "nextDialogs": [
              "751340316"
            ]
          },
          "751340316": {
            "id": "751340316",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "哎，确实，绿宝一定会知道些什么吧，而且也答应了玻娜不管发现了什么都要先回去的。",
            "nextDialogs": [
              "751340317"
            ]
          },
          "751340317": {
            "id": "751340317",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "带回去让玻娜看看吧。",
            "nextDialogs": [
              "751340318"
            ]
          },
          "751340318": {
            "id": "751340318",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "哎，确实，如果让玻娜看看的话说不定会有什么发现，而且也答应了她不管找到了什么都要先回去的。",
            "nextDialogs": [
              "751340319"
            ]
          },
          "751340319": {
            "id": "751340319",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "我们赶紧离开这里吧。"
          }
        }
      }
    },
    {
      "subId": "7513404",
      "subQuestName": "设法清除深渊污染",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "751340401"
        ],
        "dialogs": {
          "751340401": {
            "id": "751340401",
            "speakerId": 21583,
            "speakerName": "玻娜",
            "text": "哦哦，你们终于回来了！",
            "nextDialogs": [
              "751340402"
            ]
          },
          "751340402": {
            "id": "751340402",
            "speakerId": 21583,
            "speakerName": "玻娜",
            "text": "所以你们在下面发现什么了呢，快说给我听听！",
            "nextDialogs": [
              "751340403"
            ]
          },
          "751340403": {
            "id": "751340403",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "其实…",
            "nextDialogs": [
              "751340404"
            ]
          },
          "751340404": {
            "id": "751340404",
            "speakerId": 1003,
            "speakerName": "Black Screen",
            "text": "你们将在下面的经历与发现告诉了玻娜…",
            "nextDialogs": [
              "751340405"
            ]
          },
          "751340405": {
            "id": "751340405",
            "speakerId": 21583,
            "speakerName": "玻娜",
            "text": "欸？！你们是说在下面又找到了一枚火磷石？哇，我原本还以为我手上的是世上唯一的一枚呢。",
            "nextDialogs": [
              "751340406"
            ]
          },
          "751340406": {
            "id": "751340406",
            "speakerId": 21583,
            "speakerName": "玻娜",
            "text": "等下，该不会我手上这枚其实是赝品吧…唔，难怪这么多年都没发现它有什么特殊的地方。",
            "nextDialogs": [
              "751340407"
            ]
          },
          "751340407": {
            "id": "751340407",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "不会吧。",
            "nextDialogs": [
              "751340408"
            ]
          },
          "751340408": {
            "id": "751340408",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "是啊，因为我们在下面找到的那块也一样，除了上面的花纹外没什么特别的。",
            "nextDialogs": [
              "751340409"
            ]
          },
          "751340409": {
            "id": "751340409",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "我们还发现了…",
            "nextDialogs": [
              "751340410"
            ]
          },
          "751340410": {
            "id": "751340410",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "哦对，我们还发现了一本奇怪的笔记，看起来像是以前来到这里的冒险家留下来的，你要看看吗？",
            "nextDialogs": [
              "751340411"
            ]
          },
          "751340411": {
            "id": "751340411",
            "speakerId": 21583,
            "speakerName": "玻娜",
            "text": "冒险家的笔记？会来到这座诅咒之城的冒险家多半都是为了「回还之玉」而来，所以…我还是不看了吧。",
            "nextDialogs": [
              "751340412"
            ]
          },
          "751340412": {
            "id": "751340412",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "嗯？但是上面提到了火磷石，还有祭坛的事情，说不定会是…",
            "nextDialogs": [
              "751340413"
            ]
          },
          "751340413": {
            "id": "751340413",
            "speakerId": 21583,
            "speakerName": "玻娜",
            "text": "嗯嗯，我知道啦。就是因为这样，在找到「回还之玉」前，我才不想看那本笔记。",
            "nextDialogs": [
              "751340414"
            ]
          },
          "751340414": {
            "id": "751340414",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "欸？那又是为什么？",
            "nextDialogs": [
              "751340415"
            ]
          },
          "751340415": {
            "id": "751340415",
            "speakerId": 21583,
            "speakerName": "玻娜",
            "text": "多年来有无数的冒险家为了寻找天蛇船和「回还之玉」而踏上征途…",
            "nextDialogs": [
              "751340416"
            ]
          },
          "751340416": {
            "id": "751340416",
            "speakerId": 21583,
            "speakerName": "玻娜",
            "text": "但他们无一例外地都失败了，谁也没能证明那艘天空之船真的存在。",
            "nextDialogs": [
              "751340417"
            ]
          },
          "751340417": {
            "id": "751340417",
            "speakerId": 21583,
            "speakerName": "玻娜",
            "text": "在人们看来，那或许只是个虚妄的梦，是饱受深渊之苦的人们所寄托的幻想。",
            "nextDialogs": [
              "751340418"
            ]
          },
          "751340418": {
            "id": "751340418",
            "speakerId": 21583,
            "speakerName": "玻娜",
            "text": "所以他们的冒险不会被叙事人所记录，他们的事迹也不会被任何人歌颂。",
            "nextDialogs": [
              "751340419"
            ]
          },
          "751340419": {
            "id": "751340419",
            "speakerId": 21583,
            "speakerName": "玻娜",
            "text": "如果无法找到天蛇船，无法拿到「回还之玉」的话，那他们所做的一切就都没有意义了！",
            "nextDialogs": [
              "751340420"
            ]
          },
          "751340420": {
            "id": "751340420",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "旅途本身就有意义。",
            "nextDialogs": [
              "751340421"
            ]
          },
          "751340421": {
            "id": "751340421",
            "speakerId": 21583,
            "speakerName": "玻娜",
            "text": "是吗，你是这样认为的啊，你这种体验派的冒险家在纳塔可不多见哦。",
            "nextDialogs": [
              "751340422"
            ]
          },
          "751340422": {
            "id": "751340422",
            "speakerId": 21583,
            "speakerName": "玻娜",
            "text": "虽说一事无成的冒险家也是存在的，但大部分人还是需要一些能够证明自己的东西的，不是吗？",
            "nextDialogs": [
              "751340423"
            ]
          },
          "751340423": {
            "id": "751340423",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "经验也是很重要的。",
            "nextDialogs": [
              "751340424"
            ]
          },
          "751340424": {
            "id": "751340424",
            "speakerId": 21583,
            "speakerName": "玻娜",
            "text": "你这种话是建立在真的存在那艘船的基础上的，假如世界上根本根本不存在什么天蛇船呢？",
            "nextDialogs": [
              "751340425"
            ]
          },
          "751340425": {
            "id": "751340425",
            "speakerId": 21583,
            "speakerName": "玻娜",
            "text": "因此必须找到天蛇船才行，无论是为了老爹，还是为了其他曾为此付出生命的冒险家们。",
            "nextDialogs": [
              "751340426"
            ]
          },
          "751340426": {
            "id": "751340426",
            "speakerId": 21583,
            "speakerName": "玻娜",
            "text": "而你们找到的那个笔记，无论究竟是谁留下来的，也只有在我们登上天蛇船之后，才会获得应有的价值。",
            "nextDialogs": [
              "751340427"
            ]
          },
          "751340427": {
            "id": "751340427",
            "speakerId": 21583,
            "speakerName": "玻娜",
            "text": "#所以哦，{NICKNAME}和小派蒙，要是我们真的能找到天蛇船然后平安回来，你们可要在那个冒险家协会好好宣传我们的事迹呀！",
            "nextDialogs": [
              "751340428"
            ]
          },
          "751340428": {
            "id": "751340428",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "交给派蒙吧，她很擅长。",
            "nextDialogs": [
              "751340429"
            ]
          },
          "751340429": {
            "id": "751340429",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "什么啦，你是想说我很擅长吹牛吗？要是我们真的找到了什么传说中的船，只要告诉凯瑟琳小姐都能传遍提瓦特了吧！",
            "nextDialogs": [
              "751340430"
            ]
          },
          "751340430": {
            "id": "751340430",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "交给我吧。",
            "nextDialogs": [
              "751340431"
            ]
          },
          "751340431": {
            "id": "751340431",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "嗯嗯，毕竟我们也算是传奇冒险家呢，只要把我们的故事告诉哪个记者，马上就能上报纸的头条吧！",
            "nextDialogs": [
              "751340432"
            ]
          },
          "751340432": {
            "id": "751340432",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "#交给{REALNAME[ID(2)|SHOWHOST(true)]}吧。",
            "nextDialogs": [
              "751340433"
            ]
          },
          "751340433": {
            "id": "751340433",
            "speakerId": 14662,
            "speakerName": "#{REALNAME[ID(2)|SHOWHOST(true)]}",
            "text": "呀！",
            "nextDialogs": [
              "751340434"
            ]
          },
          "751340434": {
            "id": "751340434",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "虽然它答应的是很开心啦，但它就算想要宣传也只能告诉龙冒险家吧…等等，龙里也会有冒险家吗？",
            "nextDialogs": [
              "751340435"
            ]
          },
          "751340435": {
            "id": "751340435",
            "speakerId": 21583,
            "speakerName": "玻娜",
            "text": "哈哈，真好，不过说了这么多你们还没有把你们找到的那枚火磷石拿出来看看呢！",
            "nextDialogs": [
              "751340436"
            ]
          },
          "751340436": {
            "id": "751340436",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "#对哦，{NICKNAME}，快把火磷石拿出来吧，不知道绿宝看到之后能不能想起些什么来。",
            "nextDialogs": [
              "751340437"
            ]
          },
          "751340437": {
            "id": "751340437",
            "speakerId": 21602,
            "speakerName": "「绿松石」",
            "text": "咕噜…",
            "nextDialogs": [
              "751340438"
            ]
          },
          "751340438": {
            "id": "751340438",
            "speakerId": 14662,
            "speakerName": "#{REALNAME[ID(2)|SHOWHOST(true)]}",
            "text": "呜呀…",
            "nextDialogs": [
              "751340439"
            ]
          },
          "751340439": {
            "id": "751340439",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "怎、怎么回事啊，眼睛都要晃瞎了！",
            "nextDialogs": [
              "751340440"
            ]
          },
          "751340440": {
            "id": "751340440",
            "speakerId": 21602,
            "speakerName": "「绿松石」",
            "text": "叽！咕叽！",
            "nextDialogs": [
              "751340441"
            ]
          },
          "751340441": {
            "id": "751340441",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "哇，但是绿宝好像突然恢复了活力的样子！",
            "nextDialogs": [
              "751340442"
            ]
          },
          "751340442": {
            "id": "751340442",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "看起来能使用「超能特攻光线」了。",
            "nextDialogs": [
              "751340443"
            ]
          },
          "751340443": {
            "id": "751340443",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "#嗯？{NICKNAME}，你是怎么能记住这么夸张的名字的啦。",
            "nextDialogs": [
              "751340444"
            ]
          },
          "751340444": {
            "id": "751340444",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "不过确实，难道就像我们之前找到的那些能量碎屑一样，火磷石就是用来储存这种能量的…",
            "nextDialogs": [
              "751340445"
            ]
          },
          "751340445": {
            "id": "751340445",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "看起来火磷石里也蕴藏着那种能量。",
            "nextDialogs": [
              "751340446"
            ]
          },
          "751340446": {
            "id": "751340446",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "是哦，难道就像我们之前找到的那些能量碎屑一样，火磷石就是用来储存这种能量的…",
            "nextDialogs": [
              "751340447"
            ]
          },
          "751340447": {
            "id": "751340447",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "然后也是因为有了这种能量，绿宝才能对付深渊的吗？",
            "nextDialogs": [
              "751340448"
            ]
          },
          "751340448": {
            "id": "751340448",
            "speakerId": 14662,
            "speakerName": "#{REALNAME[ID(2)|SHOWHOST(true)]}",
            "text": "呀，呀！",
            "nextDialogs": [
              "751340449"
            ]
          },
          "751340449": {
            "id": "751340449",
            "speakerId": 21583,
            "speakerName": "玻娜",
            "text": "#{NICKNAME}，你们看看这个。",
            "nextDialogs": [
              "751340450"
            ]
          },
          "751340450": {
            "id": "751340450",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "欸，又出什么事了？唔啊？！这个壁画怎么完全变样了！",
            "nextDialogs": [
              "751340451"
            ]
          },
          "751340451": {
            "id": "751340451",
            "speakerId": 21583,
            "speakerName": "玻娜",
            "text": "看起来我们之前见到的壁画其实是覆盖在这个上面的呢。",
            "nextDialogs": [
              "751340452"
            ]
          },
          "751340452": {
            "id": "751340452",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "在之前的壁画上也见到过…",
            "nextDialogs": [
              "751340453"
            ]
          },
          "751340453": {
            "id": "751340453",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "是哦，这不就是我们在拿到第一块「通牒金盘」的遗迹里的壁画上也看见过的那条大黑龙吗？",
            "nextDialogs": [
              "751340454"
            ]
          },
          "751340454": {
            "id": "751340454",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "看这上面画的，倒像是这条大黑龙才是这里的主人一样。",
            "nextDialogs": [
              "751340455"
            ]
          },
          "751340455": {
            "id": "751340455",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "龙盘踞在城市之上…",
            "nextDialogs": [
              "751340456"
            ]
          },
          "751340456": {
            "id": "751340456",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "看这上面画的，倒像是那条坏龙才是这里的主人一样。",
            "nextDialogs": [
              "751340457"
            ]
          },
          "751340457": {
            "id": "751340457",
            "speakerId": 21602,
            "speakerName": "「绿松石」",
            "text": "叽…咕！",
            "nextDialogs": [
              "751340458"
            ]
          },
          "751340458": {
            "id": "751340458",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "唔，绿宝想说什么，你对这幅壁画有什么印象吗？",
            "nextDialogs": [
              "751340459"
            ]
          },
          "751340459": {
            "id": "751340459",
            "speakerId": 21602,
            "speakerName": "「绿松石」",
            "text": "咿！",
            "nextDialogs": [
              "751340460"
            ]
          },
          "751340460": {
            "id": "751340460",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "欸，这次的光是指向天空…",
            "nextDialogs": [
              "751340461"
            ]
          },
          "751340461": {
            "id": "751340461",
            "speakerId": 21602,
            "speakerName": "「绿松石」",
            "text": "咕咕！",
            "nextDialogs": [
              "751340462"
            ]
          },
          "751340462": {
            "id": "751340462",
            "speakerId": 21583,
            "speakerName": "玻娜",
            "text": "嗯嗯，不会错了，源火祭坛一定就在那个方向，这座古城的最高处！",
            "nextDialogs": [
              "751340463"
            ]
          },
          "751340463": {
            "id": "751340463",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "真的假的，每次你说得这么确定我就有点担心…",
            "nextDialogs": [
              "751340464"
            ]
          },
          "751340464": {
            "id": "751340464",
            "speakerId": 21583,
            "speakerName": "玻娜",
            "text": "哎呀，就再相信我一次嘛，我有预感，这次一定不会错的！",
            "nextDialogs": [
              "751340465"
            ]
          },
          "751340465": {
            "id": "751340465",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "竟然已经开始依靠预感了吗…不过好吧，现在也只能相信你了，我们上去看看吧。"
          }
        }
      }

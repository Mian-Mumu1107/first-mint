    {
      "subId": "7508709",
      "subQuestName": "调查附近的线索",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "750870901"
        ],
        "dialogs": {
          "750870901": {
            "id": "750870901",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "怎么又是龙龙饼干？而且旁边的信是…",
            "nextDialogs": [
              "750870902"
            ]
          },
          "750870902": {
            "id": "750870902",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "果然就是葵莉娅在后面捣鬼！不过没想到居然是出于这种理由…帕朗也真够倒霉的。",
            "nextDialogs": [
              "750870903"
            ]
          },
          "750870903": {
            "id": "750870903",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "但是想到塔卢加和奥伯龙说不定就被关在前面的营地里，不管的话也有点良心难安…而且说到底，他们又没错。",
            "nextDialogs": [
              "750870904"
            ]
          },
          "750870904": {
            "id": "750870904",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "#唔…{NICKNAME}，我们还是想办法把他们救出来吧？",
            "nextDialogs": [
              "750870905"
            ]
          },
          "750870905": {
            "id": "750870905",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "如果能<color=#00E1FFFF>混进暝视龙的巡逻队伍</color>里，说不定能很轻松地潜入进去呢！"
          }
        }
      }
    },
    {
      "subId": "7508702",

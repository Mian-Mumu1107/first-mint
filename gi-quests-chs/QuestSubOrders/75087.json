    {
      "subId": "7508707",
      "subQuestName": "与塔卢加对话",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "750870701"
        ],
        "dialogs": {
          "750870701": {
            "id": "750870701",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "欸？塔卢加！你已经回来了！",
            "nextDialogs": [
              "750870702"
            ]
          },
          "750870702": {
            "id": "750870702",
            "speakerId": 6173,
            "speakerName": "塔卢加",
            "text": "#{NICKNAME}{M#哥哥}{F#姐姐}！幸好你们也没事…我已经向姐姐他们说明情况了，拉密萨纳就跟我想的一样，是个笨蛋…",
            "nextDialogs": [
              "750870703"
            ]
          },
          "750870703": {
            "id": "750870703",
            "speakerId": 6178,
            "speakerName": "奥伯龙",
            "text": "啊呜…",
            "nextDialogs": [
              "750870704"
            ]
          },
          "750870704": {
            "id": "750870704",
            "speakerId": 6173,
            "speakerName": "塔卢加",
            "text": "是啊，比你还要笨呢！",
            "nextDialogs": [
              "750870705"
            ]
          },
          "750870705": {
            "id": "750870705",
            "speakerId": 6178,
            "speakerName": "奥伯龙",
            "text": "呜呜…",
            "nextDialogs": [
              "750870706"
            ]
          },
          "750870706": {
            "id": "750870706",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "#好啦好啦，它和你分开这么久肯定也很不安。而且刚才它和{REALNAME[ID(2)|SHOWHOST(true)]}的配合也很不错呢！",
            "nextDialogs": [
              "750870707"
            ]
          },
          "750870707": {
            "id": "750870707",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "还有教化的余地。",
            "nextDialogs": [
              "750870708"
            ]
          },
          "750870708": {
            "id": "750870708",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "嗯，它还是只小龙嘛，只要塔卢加好好和它相处，之后肯定能成长为一只出色的绒翼龙！",
            "nextDialogs": [
              "750870709"
            ]
          },
          "750870709": {
            "id": "750870709",
            "speakerId": 6178,
            "speakerName": "奥伯龙",
            "text": "呜！",
            "nextDialogs": [
              "750870710"
            ]
          },
          "750870710": {
            "id": "750870710",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "说起来你是怎么回来的？是其他人找到你，先把你救出来了吗？",
            "nextDialogs": [
              "750870711"
            ]
          },
          "750870711": {
            "id": "750870711",
            "speakerId": 6173,
            "speakerName": "塔卢加",
            "text": "我是自己逃出来的。本来想带奥伯龙一起走，但它贪吃龙龙饼干，怎么劝都不肯动，我太生气了就自己一个人走了。",
            "nextDialogs": [
              "750870712"
            ]
          },
          "750870712": {
            "id": "750870712",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "欸？这么容易吗？",
            "nextDialogs": [
              "750870713"
            ]
          },
          "750870713": {
            "id": "750870713",
            "speakerId": 6173,
            "speakerName": "塔卢加",
            "text": "摸清看守龙的行动路线之后，我发现还是有可趁之机，很顺利就逃出来了。",
            "nextDialogs": [
              "750870714"
            ]
          },
          "750870714": {
            "id": "750870714",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "搞不好塔卢加才是这里最可靠的一个…",
            "nextDialogs": [
              "750870715"
            ]
          },
          "750870715": {
            "id": "750870715",
            "speakerId": 6171,
            "speakerName": "拉密萨纳",
            "text": "你们怎么来了！我正准备去找那个骗子算账…还有、还有向你们正式道歉…是我太武断了，险些诬陷了好人。",
            "nextDialogs": [
              "750870717",
              "750870719"
            ]
          },
          "750870717": {
            "id": "750870717",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "就是！事情都结束了才现身，不是抢功又是什么？",
            "nextDialogs": [
              "750870720"
            ]
          },
          "750870720": {
            "id": "750870720",
            "speakerId": 6171,
            "speakerName": "拉密萨纳",
            "text": "我无话可说。之前约定的报酬也好现在的赔偿也好，我都不会吝啬。对了，如果这样能让你们解气，给我一拳也行！",
            "nextDialogs": [
              "750870721"
            ]
          },
          "750870721": {
            "id": "750870721",
            "speakerId": 6171,
            "speakerName": "拉密萨纳",
            "text": "我也是个男子汉，该负责任的时候不会推脱。"
          },
          "750870719": {
            "id": "750870719",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "原来你还记得参与奖啊…"
          }
        }
      }
    },
    {
      "subId": "7508712",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "750871221"
        ],
        "dialogs": {
          "750871221": {
            "id": "750871221",
            "speakerId": 1007,
            "speakerName": "<UNKNOWN>",
            "text": "在被发现之前小心地退回到之前的位置，下次要更加谨慎一些…"
          }
        }
      }
    },
    {
      "subId": "7508759",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "750875901"
        ],
        "dialogs": {
          "750875901": {
            "id": "750875901",
            "speakerId": 6274,
            "speakerName": "特马乔",
            "text": "我们这儿还有几项飞行挑战，具体内容都写在告示牌上了，如果你感兴趣不妨试试，当然也会有对应的奖励。",
            "nextDialogs": [
              "750875903",
              "750875906",
              "750875910"
            ]
          },
          "750875903": {
            "id": "750875903",
            "speakerId": 6274,
            "speakerName": "特马乔",
            "text": "其实我也不知道为什么会叫这个名字，说起帕帕卡…你听过昆图尔和坏巫师茹米的故事吗？",
            "nextDialogs": [
              "750875904"
            ]
          },
          "750875904": {
            "id": "750875904",
            "speakerId": 6274,
            "speakerName": "特马乔",
            "text": "部族的战士输给了坏巫师茹米，被他变成了帕帕卡…听起来好像不是什么好事？可能帕帕卡真的飞得很快吧，谁知道呢。"
          },
          "750875906": {
            "id": "750875906",
            "speakerId": 6274,
            "speakerName": "特马乔",
            "text": "哈哈…他是个好手，但不擅长教人。当飞行竞赛的对手…还算说得过去？",
            "nextDialogs": [
              "750875907"
            ]
          },
          "750875907": {
            "id": "750875907",
            "speakerId": 6274,
            "speakerName": "特马乔",
            "text": "要不是飞得不好，谁会来这里呢？这时候如果太过严厉…唉，以前可不是没发生过这种事。",
            "nextDialogs": [
              "750875908"
            ]
          },
          "750875908": {
            "id": "750875908",
            "speakerId": 6274,
            "speakerName": "特马乔",
            "text": "所以现在的方针已经改成鼓励为主了，相信多夸夸也能有进步的。"
          },
          "750875910": {
            "id": "750875910",
            "speakerId": 6274,
            "speakerName": "特马乔",
            "text": "再见，也欢迎你随时回来。"
          }
        }
      }
    },
    {
      "subId": "7508763",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "750876301"
        ],
        "dialogs": {
          "750876301": {
            "id": "750876301",
            "speakerId": 6275,
            "speakerName": "琪希可",
            "text": "欢迎来到帕帕卡飞行学校！",
            "nextDialogs": [
              "750876304",
              "750876307"
            ]
          },
          "750876304": {
            "id": "750876304",
            "speakerId": 6275,
            "speakerName": "琪希可",
            "text": "给学员必要的指引和帮助。现在和以前可真不一样了，要知道以前可是没有这些贴心的服务的。",
            "nextDialogs": [
              "750876305"
            ]
          },
          "750876305": {
            "id": "750876305",
            "speakerId": 6275,
            "speakerName": "琪希可",
            "text": "但是有一次因为教练在指导时言辞有些…严厉？偏偏那个学员也是个脾气火爆的人物…唉，当时的场面我都不愿再提。",
            "nextDialogs": [
              "750876306"
            ]
          },
          "750876306": {
            "id": "750876306",
            "speakerId": 6275,
            "speakerName": "琪希可",
            "text": "总之自那之后飞行学校就改变了指导的方针。伸手不打笑脸人，谁也不会讨厌被夸吧？"
          },
          "750876307": {
            "id": "750876307",
            "speakerId": 6275,
            "speakerName": "琪希可",
            "text": "祝你度过愉快的一天！"
          }
        }
      }
    }
  ]
}
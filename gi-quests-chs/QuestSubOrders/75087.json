    {
      "subId": "7508703",
      "subQuestName": "调查营地内部",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "750870301"
        ],
        "dialogs": {
          "750870301": {
            "id": "750870301",
            "speakerId": 14662,
            "speakerName": "#{REALNAME[ID(2)|SHOWHOST(true)]}",
            "text": "呀！呀呀！",
            "nextDialogs": [
              "750870302"
            ]
          },
          "750870302": {
            "id": "750870302",
            "speakerId": 21773,
            "speakerName": "奥伯龙",
            "text": "呜？",
            "nextDialogs": [
              "750870303"
            ]
          },
          "750870303": {
            "id": "750870303",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "难道…难道是奥伯龙？",
            "nextDialogs": [
              "750870304"
            ]
          },
          "750870304": {
            "id": "750870304",
            "speakerId": 21773,
            "speakerName": "奥伯龙",
            "text": "啊呜！",
            "nextDialogs": [
              "750870305"
            ]
          },
          "750870305": {
            "id": "750870305",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "呃，一会儿不见，你成长了很多呢…",
            "nextDialogs": [
              "750870306"
            ]
          },
          "750870306": {
            "id": "750870306",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "塔卢加说它容易发胖，真的一点不假。对了，他人呢？怎么没和你在一起？",
            "nextDialogs": [
              "750870307"
            ]
          },
          "750870307": {
            "id": "750870307",
            "speakerId": 21773,
            "speakerName": "奥伯龙",
            "text": "呜…呜呜…",
            "nextDialogs": [
              "750870308"
            ]
          },
          "750870308": {
            "id": "750870308",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "唔，总之先带它离开这里吧！",
            "nextDialogs": [
              "750870309"
            ]
          },
          "750870309": {
            "id": "750870309",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "说起来，反正已经找到奥伯龙了，我们也不用东躲西藏了吧？塔卢加的下落也很叫人担心…得快些才行！"
          }
        }
      }
    },
    {
      "subId": "7508704",

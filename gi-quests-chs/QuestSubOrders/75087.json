    {
      "subId": "7508705",
      "subQuestName": "击败对手",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "750870501"
        ],
        "dialogs": {
          "750870501": {
            "id": "750870501",
            "speakerId": 21607,
            "speakerName": "葵莉娅",
            "text": "既然你们都找到这里了，那我也不用再扮演什么善良的商人了吧？我已经受够了和笨蛋打交道，是时候透透气了。",
            "nextDialogs": [
              "750870502"
            ]
          },
          "750870502": {
            "id": "750870502",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "你这家伙，居然把自己干的坏事说成是别人干的！害我们被白白误会！",
            "nextDialogs": [
              "750870503"
            ]
          },
          "750870503": {
            "id": "750870503",
            "speakerId": 21607,
            "speakerName": "葵莉娅",
            "text": "我是坏人，当然要干坏事。再说了，你们被那三个笨蛋误会，不正说明我的坏事干得不错？",
            "nextDialogs": [
              "750870504"
            ]
          },
          "750870504": {
            "id": "750870504",
            "speakerId": 21607,
            "speakerName": "葵莉娅",
            "text": "呵呵，现在我要干更坏的事了，你们可别逃跑哦。",
            "nextDialogs": [
              "750870505"
            ]
          },
          "750870505": {
            "id": "750870505",
            "speakerId": 21607,
            "speakerName": "葵莉娅",
            "text": "上吧！毛球！",
            "nextDialogs": [
              "750870506"
            ]
          },
          "750870506": {
            "id": "750870506",
            "speakerId": 21787,
            "speakerName": "毛球",
            "text": "吼——",
            "nextDialogs": [
              "750870507"
            ]
          },
          "750870507": {
            "id": "750870507",
            "speakerId": 14662,
            "speakerName": "#{REALNAME[ID(2)|SHOWHOST(true)]}",
            "text": "呀！",
            "nextDialogs": [
              "750870508"
            ]
          },
          "750870508": {
            "id": "750870508",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "#上吧！{REALNAME[ID(2)|SHOWHOST(true)]}！",
            "nextDialogs": [
              "750870509"
            ]
          },
          "750870509": {
            "id": "750870509",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "#{REALNAME[ID(2)|SHOWHOST(true)]}！居然要挑战比自己大得多的对手！",
            "nextDialogs": [
              "750870510"
            ]
          },
          "750870510": {
            "id": "750870510",
            "speakerId": 21773,
            "speakerName": "奥伯龙",
            "text": "呜呜…",
            "nextDialogs": [
              "750870511"
            ]
          },
          "750870511": {
            "id": "750870511",
            "speakerId": 14662,
            "speakerName": "#{REALNAME[ID(2)|SHOWHOST(true)]}",
            "text": "呀！呀呀！",
            "nextDialogs": [
              "750870512"
            ]
          },
          "750870512": {
            "id": "750870512",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "奥伯龙没什么精神的样子，也不知道是因为和塔卢加分开而感到不安，还是单纯的龙龙饼干吃得太多…",
            "nextDialogs": [
              "750870513"
            ]
          },
          "750870513": {
            "id": "750870513",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "#{REALNAME[ID(2)|SHOWHOST(true)]}会不会是想给它打气，所以才勇敢地站出来保护我们？",
            "nextDialogs": [
              "750870514"
            ]
          },
          "750870514": {
            "id": "750870514",
            "speakerId": 21607,
            "speakerName": "葵莉娅",
            "text": "这世上多得是光靠勇气无可奈何的事，比起那些虚无缥缈的东西，还是绝对的支配力更可靠。",
            "nextDialogs": [
              "750870515"
            ]
          },
          "750870515": {
            "id": "750870515",
            "speakerId": 21607,
            "speakerName": "葵莉娅",
            "text": "攻击！",
            "nextDialogs": [
              "750870516"
            ]
          },
          "750870516": {
            "id": "750870516",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "#居然！{REALNAME[ID(2)|SHOWHOST(true)]}躲过了对方的攻击！这正是嵴锋龙的特长，就算是天空的王者也拿它没有办法！",
            "nextDialogs": [
              "750870518",
              "750870520",
              "750870523",
              "750870527"
            ]
          },
          "750870518": {
            "id": "750870518",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "#{REALNAME[ID(2)|SHOWHOST(true)]}摆出了进攻的架势！",
            "nextDialogs": [
              "750870530"
            ]
          },
          "750870530": {
            "id": "750870530",
            "speakerId": 14662,
            "speakerName": "#{REALNAME[ID(2)|SHOWHOST(true)]}",
            "text": "呀！",
            "nextDialogs": [
              "750870531"
            ]
          },
          "750870531": {
            "id": "750870531",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "攻击命中了！并且造成了…造成了微量伤害？",
            "nextDialogs": [
              "750870532"
            ]
          },
          "750870532": {
            "id": "750870532",
            "speakerId": 14662,
            "speakerName": "#{REALNAME[ID(2)|SHOWHOST(true)]}",
            "text": "呀呀！",
            "nextDialogs": [
              "750870533"
            ]
          },
          "750870533": {
            "id": "750870533",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "好好，没有被对方闪避而是成功命中已经很了不起了！呼——虽然才进行了一回合，但是已经觉得很累了，怎么回事…",
            "nextDialogs": [
              "750870534"
            ]
          },
          "750870534": {
            "id": "750870534",
            "speakerId": 21607,
            "speakerName": "葵莉娅",
            "text": "那么接下来轮到我的回合了吧？攻击！",
            "nextDialogs": [
              "750870535"
            ]
          },
          "750870535": {
            "id": "750870535",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "#面对对手凌厉的进攻，{REALNAME[ID(2)|SHOWHOST(true)]}紧急采取防御态势！它防住了！",
            "nextDialogs": [
              "750870536"
            ]
          },
          "750870536": {
            "id": "750870536",
            "speakerId": 21607,
            "speakerName": "葵莉娅",
            "text": "居然在进攻之后又自主选择了防御，可恶的规则破坏者…",
            "nextDialogs": [
              "750870537"
            ]
          },
          "750870537": {
            "id": "750870537",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "回合制取胜的方法就是不要回合制！",
            "nextDialogs": [
              "750870538"
            ]
          },
          "750870538": {
            "id": "750870538",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "接下来该怎么做呢？",
            "nextDialogs": [
              "750870539"
            ]
          },
          "750870539": {
            "id": "750870539",
            "speakerId": 21773,
            "speakerName": "奥伯龙",
            "text": "…呜！",
            "nextDialogs": [
              "750870540"
            ]
          },
          "750870540": {
            "id": "750870540",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "欸？奥伯龙好像振作起来了？",
            "nextDialogs": [
              "750870541"
            ]
          },
          "750870541": {
            "id": "750870541",
            "speakerId": 14662,
            "speakerName": "#{REALNAME[ID(2)|SHOWHOST(true)]}",
            "text": "呀！呀呀！",
            "nextDialogs": [
              "750870542"
            ]
          },
          "750870542": {
            "id": "750870542",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "虽然听不懂这是在说什么，但是看样子，它们之间好像达成了某种默契…"
          },
          "750870520": {
            "id": "750870520",
            "speakerId": 14662,
            "speakerName": "#{REALNAME[ID(2)|SHOWHOST(true)]}",
            "text": "呜…呀！",
            "nextDialogs": [
              "750870521"
            ]
          },
          "750870521": {
            "id": "750870521",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "#{REALNAME[ID(2)|SHOWHOST(true)]}似乎认为防御的策略太过保守，会浪费大好机会，于是摆出了进攻的架势！"
          },
          "750870523": {
            "id": "750870523",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "我们哪有可以现在用的道具啊！就算是想要设置捕兽夹也太晚了吧？",
            "nextDialogs": [
              "750870524"
            ]
          },
          "750870524": {
            "id": "750870524",
            "speakerId": 14662,
            "speakerName": "#{REALNAME[ID(2)|SHOWHOST(true)]}",
            "text": "呜…呀！",
            "nextDialogs": [
              "750870525"
            ]
          },
          "750870525": {
            "id": "750870525",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "#哦！{REALNAME[ID(2)|SHOWHOST(true)]}摆出了进攻的架势！"
          },
          "750870527": {
            "id": "750870527",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "现在不是逃跑的时候吧！",
            "nextDialogs": [
              "750870528"
            ]
          },
          "750870528": {
            "id": "750870528",
            "speakerId": 14662,
            "speakerName": "#{REALNAME[ID(2)|SHOWHOST(true)]}",
            "text": "呜呜…呀！",
            "nextDialogs": [
              "750870529"
            ]
          },
          "750870529": {
            "id": "750870529",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "#就连{REALNAME[ID(2)|SHOWHOST(true)]}都知道呢，看，它摆出了进攻的架势！"
          }
        }
      }
    },

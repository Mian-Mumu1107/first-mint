    "「少女」": 39,
    "派蒙": 13
  },
  "subQuests": [
    {
      "subId": "7605401",
      "subQuestName": "同「少女」见面",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "760540101"
        ],
        "dialogs": {
          "760540101": {
            "id": "760540101",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "咦？哥伦比娅呢？怎么没见到她。",
            "nextDialogs": [
              "760540102"
            ]
          },
          "760540102": {
            "id": "760540102",
            "speakerId": 1318,
            "speakerName": "「少女」",
            "text": "我在这边。",
            "nextDialogs": [
              "760540103"
            ]
          },
          "760540103": {
            "id": "760540103",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "哇！你在这么高的地方做什么啦？",
            "nextDialogs": [
              "760540104"
            ]
          },
          "760540104": {
            "id": "760540104",
            "speakerId": 1318,
            "speakerName": "「少女」",
            "text": "上来。",
            "nextDialogs": [
              "760540105"
            ]
          },
          "760540105": {
            "id": "760540105",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "嗯？这次又是要干什么…",
            "nextDialogs": [
              "760540106"
            ]
          },
          "760540106": {
            "id": "760540106",
            "speakerId": 1318,
            "speakerName": "「少女」",
            "text": "还记得我们上次出去收集的石头吗？",
            "nextDialogs": [
              "760540107"
            ]
          },
          "760540107": {
            "id": "760540107",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "上次？哦，是说吸收了月矩力后会发光的那种矿石对吧？",
            "nextDialogs": [
              "760540108"
            ]
          },
          "760540108": {
            "id": "760540108",
            "speakerId": 1318,
            "speakerName": "「少女」",
            "text": "对。那之后月灵们又收集了一些，我将这些石头处理了一下，大致分为了深色和浅色的两类。",
            "nextDialogs": [
              "760540109"
            ]
          },
          "760540109": {
            "id": "760540109",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "深色和浅色？为什么？",
            "nextDialogs": [
              "760540110"
            ]
          },
          "760540110": {
            "id": "760540110",
            "speakerId": 1318,
            "speakerName": "「少女」",
            "text": "当然是用来玩「月亮棋」呀。",
            "nextDialogs": [
              "760540111"
            ]
          },
          "760540111": {
            "id": "760540111",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "欸？什…什么是「月亮棋」…",
            "nextDialogs": [
              "760540112"
            ]
          },
          "760540112": {
            "id": "760540112",
            "speakerId": 1318,
            "speakerName": "「少女」",
            "text": "你们没玩过吗…",
            "nextDialogs": [
              "760540113"
            ]
          },
          "760540113": {
            "id": "760540113",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "没有…",
            "nextDialogs": [
              "760540114"
            ]
          },
          "760540114": {
            "id": "760540114",
            "speakerId": 1318,
            "speakerName": "「少女」",
            "text": "这样吗…以前看「霜月之子」的孩子们在地上画格子的时候，我就想试试了。但没人能陪我玩。",
            "nextDialogs": [
              "760540115"
            ]
          },
          "760540115": {
            "id": "760540115",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "具体规则是什么呢？",
            "nextDialogs": [
              "760540116"
            ]
          },
          "760540116": {
            "id": "760540116",
            "speakerId": 1318,
            "speakerName": "「少女」",
            "text": "唔…这样说明容易些…",
            "nextDialogs": [
              "760540117"
            ]
          },
          "760540117": {
            "id": "760540117",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "哦！好…好厉害…你怎么做到的？",
            "nextDialogs": [
              "760540118"
            ]
          },
          "760540118": {
            "id": "760540118",
            "speakerId": 1318,
            "speakerName": "「少女」",
            "text": "嗯？就很简单地运用月矩力而已，你们做不到吗？",
            "nextDialogs": [
              "760540119"
            ]
          },
          "760540119": {
            "id": "760540119",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "不要以神明的标准来要求我们啦…",
            "nextDialogs": [
              "760540120"
            ]
          },
          "760540120": {
            "id": "760540120",
            "speakerId": 1318,
            "speakerName": "「少女」",
            "text": "好吧。这就是棋盘，或者说是游戏中的「夜空」。然后两个人手中的棋子代表了你所拥有的「月亮」。",
            "nextDialogs": [
              "760540121"
            ]
          },
          "760540121": {
            "id": "760540121",
            "speakerId": 1318,
            "speakerName": "「少女」",
            "text": "两人交替将「月亮」放到「夜空」上，谁的三个月亮最先连成一条线，谁就获胜了。",
            "nextDialogs": [
              "760540122"
            ]
          },
          "760540122": {
            "id": "760540122",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "哦！总之就是三颗棋子连成一条线的游戏对吧！",
            "nextDialogs": [
              "760540123"
            ]
          },
          "760540123": {
            "id": "760540123",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "这游戏在挪德卡莱居然叫「月亮棋」…还真是有本地特色呢…",
            "nextDialogs": [
              "760540124"
            ]
          },
          "760540124": {
            "id": "760540124",
            "speakerId": 1318,
            "speakerName": "「少女」",
            "text": "不过，「月亮」是会轮替的，天空中无法存在三个以上的「月亮」。",
            "nextDialogs": [
              "760540125"
            ]
          },
          "760540125": {
            "id": "760540125",
            "speakerId": 1318,
            "speakerName": "「少女」",
            "text": "所以当「夜空」中的「月亮」达到一定数量之后，最开始升上的「月亮」就会消失。",
            "nextDialogs": [
              "760540126"
            ]
          },
          "760540126": {
            "id": "760540126",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "还…还挺有道理…也给这游戏加了不少难度呢…",
            "nextDialogs": [
              "760540127"
            ]
          },
          "760540127": {
            "id": "760540127",
            "speakerId": 1318,
            "speakerName": "「少女」",
            "text": "嗯，要试试吗？我也是第一次玩。",
            "nextDialogs": [
              "760540128"
            ]
          },
          "760540128": {
            "id": "760540128",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "（她看起来很期待的样子呢…）",
            "nextDialogs": [
              "760540129"
            ]
          },
          "760540129": {
            "id": "760540129",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "嘿嘿，那我来给你们当裁判吧。这家伙脑子不错，你可要小心哟！",
            "nextDialogs": [
              "760540130"
            ]
          },
          "760540130": {
            "id": "760540130",
            "speakerId": 1318,
            "speakerName": "「少女」",
            "text": "好呀。"
          }
        }
      }
    },
    {
      "subId": "7605403",
      "subQuestName": "同「少女」玩月亮棋",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "760540301"
        ],
        "dialogs": {
          "760540301": {
            "id": "760540301",
            "speakerId": 1318,
            "speakerName": "「少女」",
            "text": "这样对吗…？",
            "nextDialogs": [
              "760540302"
            ]
          },
          "760540302": {
            "id": "760540302",
            "speakerId": 1318,
            "speakerName": "「少女」",
            "text": "我想想…",
            "nextDialogs": [
              "760540303"
            ]
          },
          "760540303": {
            "id": "760540303",
            "speakerId": 1318,
            "speakerName": "「少女」",
            "text": "唔…",
            "nextDialogs": [
              "760540304"
            ]
          },
          "760540304": {
            "id": "760540304",
            "speakerId": 1318,
            "speakerName": "「少女」",
            "text": "月亮…月亮…",
            "nextDialogs": [
              "760540305"
            ]
          },
          "760540305": {
            "id": "760540305",
            "speakerId": 1318,
            "speakerName": "「少女」",
            "text": "这里怎么样？",
            "nextDialogs": [
              "760540306"
            ]
          },
          "760540306": {
            "id": "760540306",
            "speakerId": 1318,
            "speakerName": "「少女」",
            "text": "这次是我赢了。",
            "nextDialogs": [
              "760540307"
            ]
          },
          "760540307": {
            "id": "760540307",
            "speakerId": 1318,
            "speakerName": "「少女」",
            "text": "我的三个月亮连起来了。",
            "nextDialogs": [
              "760540308"
            ]
          },
          "760540308": {
            "id": "760540308",
            "speakerId": 1318,
            "speakerName": "「少女」",
            "text": "嗯，这样就赢了。",
            "nextDialogs": [
              "760540309"
            ]
          },
          "760540309": {
            "id": "760540309",
            "speakerId": 1318,
            "speakerName": "「少女」",
            "text": "嗯…月升月落，真是漫长。",
            "nextDialogs": [
              "760540310"
            ]
          },
          "760540310": {
            "id": "760540310",
            "speakerId": 1318,
            "speakerName": "「少女」",
            "text": "我们的月亮谁都不让谁呢。",
            "nextDialogs": [
              "760540311"
            ]
          },
          "760540311": {
            "id": "760540311",
            "speakerId": 1318,
            "speakerName": "「少女」",
            "text": "是不是…快平手了？",
            "nextDialogs": [
              "760540312"
            ]
          },
          "760540312": {
            "id": "760540312",
            "speakerId": 1318,
            "speakerName": "「少女」",
            "text": "原来你喜欢深思熟虑后再做决定，嗯，没事，我们有很多时间。",
            "nextDialogs": [
              "760540313"
            ]
          },
          "760540313": {
            "id": "760540313",
            "speakerId": 1318,
            "speakerName": "「少女」",
            "text": "忘了怎么将「月亮」放上「夜空」吗？要不要我帮你？",
            "nextDialogs": [
              "760540314"
            ]
          },
          "760540314": {
            "id": "760540314",
            "speakerId": 1318,
            "speakerName": "「少女」",
            "text": "不喜欢这个游戏吗？我觉得还挺有意思。",
            "nextDialogs": [
              "760540315"
            ]
          },
          "760540315": {
            "id": "760540315",
            "speakerId": 1318,
            "speakerName": "「少女」",
            "text": "嗯？你是在盯着我看吗？我感觉得到。",
            "nextDialogs": [
              "760540316"
            ]
          },
          "760540316": {
            "id": "760540316",
            "speakerId": 1318,
            "speakerName": "「少女」",
            "text": "我的脸上…有关于「月亮」的答案吗？",
            "nextDialogs": [
              "760540317"
            ]
          },
          "760540317": {
            "id": "760540317",
            "speakerId": 1318,
            "speakerName": "「少女」",
            "text": "棋盘在那边哦。",
            "nextDialogs": [
              "760540318"
            ]
          },
          "760540318": {
            "id": "760540318",
            "speakerId": 1318,
            "speakerName": "「少女」",
            "text": "嗯，是你的「月亮」获胜了。",
            "nextDialogs": [
              "760540319"
            ]
          },
          "760540319": {
            "id": "760540319",
            "speakerId": 1318,
            "speakerName": "「少女」",
            "text": "这片夜空属于你了。",
            "nextDialogs": [
              "760540320"
            ]
          },
          "760540320": {
            "id": "760540320",
            "speakerId": 1318,
            "speakerName": "「少女」",
            "text": "啊…一不小心就…",
            "nextDialogs": [
              "760540321"
            ]
          },
          "760540321": {
            "id": "760540321",
            "speakerId": 1002,
            "speakerName": "Black Screen",
            "text": "与哥伦比娅在游戏中度过了一段愉快的时光…",
            "nextDialogs": [
              "760540322"
            ]
          },
          "760540322": {
            "id": "760540322",
            "speakerId": 1318,
            "speakerName": "「少女」",
            "text": "谢谢你，我玩得很开心。",
            "nextDialogs": [
              "760540323"
            ]
          },
          "760540323": {
            "id": "760540323",
            "speakerId": 1318,
            "speakerName": "「少女」",
            "text": "如果可以的话，下次也来陪我吧。",
            "nextDialogs": [
              "760540324"
            ]
          },
          "760540324": {
            "id": "760540324",
            "speakerId": 1318,
            "speakerName": "「少女」",
            "text": "把这个，当做「约定」的证明。"
          }
        }
      }
    },
    {
      "subId": "7605402",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [

      "dialogue": {
        "startDialogs": [
          "715100101"
        ],
        "dialogs": {
          "715100101": {
            "id": "715100101",
            "speakerId": 30181,
            "speakerName": "胡塞尼",
            "text": "怎么样，「普尔希娜光钉」成功运作了吗？",
            "nextDialogs": [
              "715100104"
            ]
          },
          "715100104": {
            "id": "715100104",
            "speakerId": 30181,
            "speakerName": "胡塞尼",
            "text": "成功就好，成功就好，虽然「普尔希娜光钉」不能一次性就将喷口全部封闭，但是只要成功一次，就能够持续运行。",
            "nextDialogs": [
              "715100105"
            ]
          },
          "715100105": {
            "id": "715100105",
            "speakerId": 30181,
            "speakerName": "胡塞尼",
            "text": "这样，将所有喷口全部封闭也只是时间问题。",
            "nextDialogs": [
              "715100106"
            ]
          },
          "715100106": {
            "id": "715100106",
            "speakerId": 30181,
            "speakerName": "胡塞尼",
            "text": "这问题总算解决了。",
            "nextDialogs": [
              "715100107"
            ]
          },
          "715100107": {
            "id": "715100107",
            "speakerId": 30181,
            "speakerName": "胡塞尼",
            "text": "我想想，得把这些记录下来，等关于「普尔希娜光钉」的完全研究报告上交之后，说不定我…我还能成为院内的风云人物。",
            "nextDialogs": [
              "715100108"
            ]
          },
          "715100108": {
            "id": "715100108",
            "speakerId": 30181,
            "speakerName": "胡塞尼",
            "text": "#嗯，这些都可以写进我将来的自传里，「我曾与身手超凡的{NICKNAME}于『层岩巨渊』经过一番实验…」这样记录好了…",
            "nextDialogs": [
              "715100109"
            ]
          },
          "715100109": {
            "id": "715100109",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "那我就等着那一天了。",
            "nextDialogs": [
              "715100110"
            ]
          },
          "715100110": {
            "id": "715100110",
            "speakerId": 30181,
            "speakerName": "胡塞尼",
            "text": "哈哈，不过我写研究报告很熟练，写传记啊，故事啊这种文体恐怕就有些拙劣了。",
            "nextDialogs": [
              "715100111"
            ]
          },
          "715100111": {
            "id": "715100111",
            "speakerId": 30181,
            "speakerName": "胡塞尼",
            "text": "希望到时候你不要介意。"
          }
        }
      }
    }
  ]
}
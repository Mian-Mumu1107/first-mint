    {
      "subId": "7502409",
      "subQuestName": "等一会儿…",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "750240901"
        ],
        "dialogs": {
          "750240901": {
            "id": "750240901",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "哦，果然被料理的香气吸引过去了呢。",
            "nextDialogs": [
              "750240902"
            ]
          },
          "750240902": {
            "id": "750240902",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "#唔…但是空隙感觉还不够，{REALNAME[ID(2)|SHOWHOST(true)]}可以去把翡翠引开吗？",
            "nextDialogs": [
              "750240903"
            ]
          },
          "750240903": {
            "id": "750240903",
            "speakerId": 14662,
            "speakerName": "#{REALNAME[ID(2)|SHOWHOST(true)]}",
            "text": "呀！呀呀！",
            "nextDialogs": [
              "750240904"
            ]
          },
          "750240904": {
            "id": "750240904",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "好喔，那就交给你啦！",
            "nextDialogs": [
              "750240905"
            ]
          },
          "750240905": {
            "id": "750240905",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "#{NICKNAME}，等{REALNAME[ID(2)|SHOWHOST(true)]}引开翡翠，我们就去看看那人要不要紧吧！"
          }
        }
      }
    },
    {

    {
      "subId": "7502408",
      "subQuestName": "与受伤的人对话",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "750240822"
        ],
        "dialogs": {
          "750240822": {
            "id": "750240822",
            "speakerId": 1002,
            "speakerName": "Black Screen",
            "text": "被称作「金盏花」的嵴锋龙在决斗中落败后钻入地面不知道躲到了哪里，趁这个机会，赶紧去检查了一下受伤的人…",
            "nextDialogs": [
              "750240801"
            ]
          },
          "750240801": {
            "id": "750240801",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "看起来没有明显的外伤…喂——你还好吗？能听到我说话吗？",
            "nextDialogs": [
              "750240802"
            ]
          },
          "750240802": {
            "id": "750240802",
            "speakerId": 10205,
            "speakerName": "？？？",
            "text": "…唔，金盏花？你在担心我吗？真是个心软的家伙，没事的，为了能没有顾虑地和你玩耍，我最近都在加强锻炼…",
            "nextDialogs": [
              "750240803"
            ]
          },
          "750240803": {
            "id": "750240803",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "#我是派蒙，才不是什么金盏花啦！{NICKNAME}，你说这家伙该不会是刚才摔倒的时候把脑子给撞坏了吧…",
            "nextDialogs": [
              "750240806"
            ]
          },
          "750240806": {
            "id": "750240806",
            "speakerId": 10205,
            "speakerName": "？？？",
            "text": "咦？不是金盏花…我这是怎么了？",
            "nextDialogs": [
              "750240807"
            ]
          },
          "750240807": {
            "id": "750240807",
            "speakerId": 1002,
            "speakerName": "Black Screen",
            "text": "将他被三只龙团团围住又被「金盏花」击倒的事原原本本讲述了一遍…",
            "nextDialogs": [
              "750240808"
            ]
          },
          "750240808": {
            "id": "750240808",
            "speakerId": 6174,
            "speakerName": "伊卡尤",
            "text": "原来是这样，给两位添麻烦了…请叫我伊卡尤吧，如两位所见，我是个喜欢追着龙跑…偶尔也会被龙追着跑的冒险家。",
            "nextDialogs": [
              "750240809"
            ]
          },
          "750240809": {
            "id": "750240809",
            "speakerId": 6174,
            "speakerName": "伊卡尤",
            "text": "怪我前段时间身体出了点小状况，卧床休息了一阵，不仅体力下降得厉害，也没能按时分别和它们见面…",
            "nextDialogs": [
              "750240810"
            ]
          },
          "750240810": {
            "id": "750240810",
            "speakerId": 6174,
            "speakerName": "伊卡尤",
            "text": "这次我还没到营地就被它们团团围住，可见它们一定是担心我担心得不得了，唉，我真是太幸福了。"
          }
        }
      }
    },

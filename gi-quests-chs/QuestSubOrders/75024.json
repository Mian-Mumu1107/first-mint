    {
      "subId": "7502406",
      "subQuestName": "与嵴锋龙交涉",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "750240601"
        ],
        "dialogs": {
          "750240601": {
            "id": "750240601",
            "speakerId": 21498,
            "speakerName": "「金盏花」",
            "text": "嘎呜——！",
            "nextDialogs": [
              "750240602"
            ]
          },
          "750240602": {
            "id": "750240602",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "你不要激动，我们只是担心那个人有没有受伤…",
            "nextDialogs": [
              "750240604"
            ]
          },
          "750240604": {
            "id": "750240604",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "不要这么快就放弃嘛！小金盏花，我们没有恶意的，我们也知道，呃，好勇斗狠绝对不是你的本意…",
            "nextDialogs": [
              "750240606"
            ]
          },
          "750240606": {
            "id": "750240606",
            "speakerId": 21498,
            "speakerName": "「金盏花」",
            "text": "嘎！呜！",
            "nextDialogs": [
              "750240607"
            ]
          },
          "750240607": {
            "id": "750240607",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "哇…它怎么更生气了！"
          }
        }
      }
    },

  "subQuests": [
    {
      "subId": "7502401",
      "subQuestName": "",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "750240101"
        ],
        "dialogs": {
          "750240101": {
            "id": "750240101",
            "speakerId": 10205,
            "speakerName": "？？？",
            "text": "亲爱的，你们的热情…真叫我招架不住，呼——先吃点冰，冷静一下头脑，之后我们慢慢聊，好吗？",
            "nextDialogs": [
              "750240102"
            ]
          },
          "750240102": {
            "id": "750240102",
            "speakerId": 17046,
            "speakerName": "嵴锋龙",
            "text": "嘎呜——！",
            "nextDialogs": [
              "750240103"
            ]
          },
          "750240103": {
            "id": "750240103",
            "speakerId": 1002,
            "speakerName": "Black Screen",
            "text": "起初听到「哎哟」一声惨叫，接着就是重物摔到地上的闷响，再之后只剩龙的呜呜声…",
            "nextDialogs": [
              "750240104"
            ]
          },
          "750240104": {
            "id": "750240104",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "欸？！那人没事吧…",
            "nextDialogs": [
              "750240105"
            ]
          },
          "750240105": {
            "id": "750240105",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "唔…它们围得死死的，不知道里面的人到底怎么样了…",
            "nextDialogs": [
              "750240106"
            ]
          },
          "750240106": {
            "id": "750240106",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "派蒙从上边看看？",
            "nextDialogs": [
              "750240107"
            ]
          },
          "750240107": {
            "id": "750240107",
            "speakerId": 14662,
            "speakerName": "#{REALNAME[ID(2)|SHOWHOST(true)]}",
            "text": "呀！",
            "nextDialogs": [
              "750240108"
            ]
          },
          "750240108": {
            "id": "750240108",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "#{REALNAME[ID(2)|SHOWHOST(true)]}好像在说让它试试呢，那就交给它吧！",
            "nextDialogs": [
              "750240109"
            ]
          },
          "750240109": {
            "id": "750240109",
            "speakerId": 14662,
            "speakerName": "#{REALNAME[ID(2)|SHOWHOST(true)]}",
            "text": "呜…",
            "nextDialogs": [
              "750240110"
            ]
          },
          "750240110": {
            "id": "750240110",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "呃，看起来情况不太妙的样子？那人该不会死…呸呸，说不定只是昏过去了，但不管怎么说，我们可不能见死不救呀！",
            "nextDialogs": [
              "750240111"
            ]
          },
          "750240111": {
            "id": "750240111",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "唔…麻烦三位借过一下！",
            "nextDialogs": [
              "750240112"
            ]
          },
          "750240112": {
            "id": "750240112",
            "speakerId": 17046,
            "speakerName": "嵴锋龙",
            "text": "嘎！呜！",
            "nextDialogs": [
              "750240113"
            ]
          },
          "750240113": {
            "id": "750240113",
            "speakerId": 17047,
            "speakerName": "鳍游龙",
            "text": "呜…呜呜？",
            "nextDialogs": [
              "750240114"
            ]
          },
          "750240114": {
            "id": "750240114",
            "speakerId": 17048,
            "speakerName": "匿叶龙",
            "text": "呀！",
            "nextDialogs": [
              "750240115"
            ]
          },
          "750240115": {
            "id": "750240115",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "呜哇，它们完全不肯让开…到底怎么回事呀？听那人之前的话，应该也不是完全不认识的龙…",
            "nextDialogs": [
              "750240116"
            ]
          },
          "750240116": {
            "id": "750240116",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "要是有更多线索就好了…",
            "nextDialogs": [
              "750240117"
            ]
          },
          "750240117": {
            "id": "750240117",
            "speakerId": 14662,
            "speakerName": "#{REALNAME[ID(2)|SHOWHOST(true)]}",
            "text": "…呀！",
            "nextDialogs": [
              "750240118"
            ]
          },
          "750240118": {
            "id": "750240118",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "#欸？{REALNAME[ID(2)|SHOWHOST(true)]}！是发现什么了吗？我们快跟上吧。"
          }
        }
      }
    },
    {
      "subId": "7502402",
      "subQuestName": "和龙伙伴一起寻找引开龙的办法",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "750240201"
        ],
        "dialogs": {
          "750240201": {
            "id": "750240201",
            "speakerId": 21568,
            "speakerName": "谁人的日志",
            "text": "「…今天是雨天。为小波准备了它最爱的<color=#00E1FFFF>酸汁腌鱼</color>，看到它心满意足的样子，一切也都值得了…」",
            "nextDialogs": [
              "750240202"
            ]
          },
          "750240202": {
            "id": "750240202",
            "speakerId": 21568,
            "speakerName": "谁人的日志",
            "text": "「…哪怕它原本在纵情畅游，但只要端出<color=#00E1FFFF>酸汁腌鱼</color>，它就会从水中跃出，那弧线堪称完美！…」",
            "nextDialogs": [
              "750240203"
            ]
          },
          "750240203": {
            "id": "750240203",
            "speakerId": 21568,
            "speakerName": "谁人的日志",
            "text": "「…我是不会怀疑它对我的爱的，只是担心，会不会其实它爱<color=#00E1FFFF>酸汁腌鱼</color>更甚于我…」",
            "nextDialogs": [
              "750240204"
            ]
          },
          "750240204": {
            "id": "750240204",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "小波…指的应该是鳍游龙吧，营地的锅里煮着的也是酸汁腌鱼，肯定是为它准备的。",
            "nextDialogs": [
              "750240205"
            ]
          },
          "750240205": {
            "id": "750240205",
            "speakerId": 21568,
            "speakerName": "谁人的日志",
            "text": "「…圆溜溜的眼睛，卷卷的尾巴，神气快活的叫声…翡翠啊翡翠，这世上还会有比你更可爱的小龙吗？…」",
            "nextDialogs": [
              "750240206"
            ]
          },
          "750240206": {
            "id": "750240206",
            "speakerId": 21568,
            "speakerName": "谁人的日志",
            "text": "「…从没受过欺骗，也不懂得怀疑，好像和这世上所有的生灵都能成为朋友，共享玩耍的乐趣…」",
            "nextDialogs": [
              "750240207"
            ]
          },
          "750240207": {
            "id": "750240207",
            "speakerId": 21568,
            "speakerName": "谁人的日志",
            "text": "「…要不是太忙，我真想整日整夜陪你玩耍，看你在阳光斑驳的林间穿梭，好像风的孩子，无忧无虑的精灵！…」",
            "nextDialogs": [
              "750240208"
            ]
          },
          "750240208": {
            "id": "750240208",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "#唔，看来那只小匿叶龙叫做翡翠，还是只贪玩的小龙。说不定{REALNAME[ID(2)|SHOWHOST(true)]}也能跟它交上朋友呢。",
            "nextDialogs": [
              "750240209"
            ]
          },
          "750240209": {
            "id": "750240209",
            "speakerId": 14662,
            "speakerName": "#{REALNAME[ID(2)|SHOWHOST(true)]}",
            "text": "呀！",
            "nextDialogs": [
              "750240210"
            ]
          },
          "750240210": {
            "id": "750240210",
            "speakerId": 21568,
            "speakerName": "谁人的日志",
            "text": "「…我遍踏丘陵与山谷，只为了寻得你的踪迹。如果你真的不待见我，大可以一走了之…」",
            "nextDialogs": [
              "750240211"
            ]
          },
          "750240211": {
            "id": "750240211",
            "speakerId": 21568,
            "speakerName": "谁人的日志",
            "text": "「…但你却照顾我的脚程，走走停停，甚至为我收集许多颗粒果，还有那些亮晶晶的石块…」",
            "nextDialogs": [
              "750240212"
            ]
          },
          "750240212": {
            "id": "750240212",
            "speakerId": 21568,
            "speakerName": "谁人的日志",
            "text": "「…我心爱的金盏花，只有我知道，硬壳包裹下是柔软体贴的心，好勇斗狠绝非你的本意…」",
            "nextDialogs": [
              "750240213"
            ]
          },
          "750240213": {
            "id": "750240213",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "呃…金盏花该不会是说那只脾气暴躁的嵴锋龙吧？那副气势汹汹把人击倒的样子，哪有一丝温柔体贴的影子啊！",
            "nextDialogs": [
              "750240214"
            ]
          },
          "750240214": {
            "id": "750240214",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "不过话说回来，原来这三只龙都是他的…朋友？到底为什么会把他撞昏还团团围住呢…",
            "nextDialogs": [
              "750240215"
            ]
          },
          "750240215": {
            "id": "750240215",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "先把人救出来再问吧。",
            "nextDialogs": [
              "750240216"
            ]
          },
          "750240216": {
            "id": "750240216",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "说的也是，要是有办法让龙让开就好了…对了，日志里不是说小波喜欢吃酸汁腌鱼吗？正好营地里也有，说不定能把它引开。",
            "nextDialogs": [
              "750240218",
              "750240220"
            ]
          },
          "750240218": {
            "id": "750240218",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "#嗯！翡翠很贪玩，{REALNAME[ID(2)|SHOWHOST(true)]}只要带它去旁边玩就好啦。",
            "nextDialogs": [
              "750240221"
            ]
          },
          "750240221": {
            "id": "750240221",
            "speakerId": 14662,
            "speakerName": "#{REALNAME[ID(2)|SHOWHOST(true)]}",
            "text": "呀！呀呀！",
            "nextDialogs": [
              "750240222"
            ]
          },
          "750240222": {
            "id": "750240222",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "#{REALNAME[ID(2)|SHOWHOST(true)]}也很有干劲呢！不过我们还是先试试最简单的方法吧，酸汁腌鱼不吃不就浪费了吗？"
          },
          "750240220": {
            "id": "750240220",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "#还是先试试和平的手段吧！比如让{REALNAME[ID(2)|SHOWHOST(true)]}把贪玩的翡翠引开…"
          }
        }
      }
    },
    {

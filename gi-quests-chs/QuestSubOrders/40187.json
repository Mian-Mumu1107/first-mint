    {
      "subId": "4018703",
      "subQuestName": "等待到晚上（18：00-22：00）",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "401870301"
        ],
        "dialogs": {
          "401870301": {
            "id": "401870301",
            "speakerId": 1002,
            "speakerName": "重云",
            "text": "要说谁更厉害的话，我选万象风角灵官。毕竟他是奇门算术开派祖师。",
            "nextDialogs": [
              "401870302"
            ]
          },
          "401870302": {
            "id": "401870302",
            "speakerId": 1003,
            "speakerName": "蓝砚",
            "text": "嗯！我也投我祖宗爷爷一票。再加上玄燕仙子！",
            "nextDialogs": [
              "401870303"
            ]
          },
          "401870303": {
            "id": "401870303",
            "speakerId": 1004,
            "speakerName": "嘉明",
            "text": "那我就要选连山二贤了，那些世外高人都是深藏不露的，小说里都是这样写的啦。你说咧？",
            "nextDialogs": [
              "401870304"
            ]
          },
          "401870304": {
            "id": "401870304",
            "speakerId": 1005,
            "speakerName": "行秋",
            "text": "如果是武侠小说，我可能也会这么选。",
            "nextDialogs": [
              "401870305"
            ]
          },
          "401870305": {
            "id": "401870305",
            "speakerId": 1005,
            "speakerName": "行秋",
            "text": "但很不巧，我读过《竹林月夜》，所以我认为最强的是桃都三仙里的白马仙子。她身上肯定有秘密。",
            "nextDialogs": [
              "401870306"
            ]
          },
          "401870306": {
            "id": "401870306",
            "speakerId": 1000,
            "speakerName": "香菱",
            "text": "咦？没人选云来钓叟吗？连玉衡大人都说，她的剑法来自云来钓叟的抛竿姿势呢。",
            "nextDialogs": [
              "401870307"
            ]
          },
          "401870307": {
            "id": "401870307",
            "speakerId": 1004,
            "speakerName": "嘉明",
            "text": "话是这么讲…不过好像少了点排场喔？",
            "nextDialogs": [
              "401870308"
            ]
          },
          "401870308": {
            "id": "401870308",
            "speakerId": 1005,
            "speakerName": "行秋",
            "text": "唔…可钓鱼客里出大神，这倒也是事实。",
            "nextDialogs": [
              "401870309"
            ]
          },
          "401870309": {
            "id": "401870309",
            "speakerId": 1006,
            "speakerName": "胡桃",
            "text": "嗨，你们都错啦！最厉害的当然是无妄姥爷和幽蝶仙子，要是没有他们，可就没有今天的往生堂呢。",
            "nextDialogs": [
              "401870310"
            ]
          },
          "401870310": {
            "id": "401870310",
            "speakerId": 1002,
            "speakerName": "重云",
            "text": "这样说也很有道理。",
            "nextDialogs": [
              "401870311"
            ]
          },
          "401870311": {
            "id": "401870311",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "哎呀，原来大家都到啦！",
            "nextDialogs": [
              "401870312"
            ]
          },
          "401870312": {
            "id": "401870312",
            "speakerId": 1006,
            "speakerName": "胡桃",
            "text": "#{NICKNAME}，派蒙，你们总算来了。欢迎欢迎！",
            "nextDialogs": [
              "401870313"
            ]
          },
          "401870313": {
            "id": "401870313",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "呀！胡桃，你的帽子！",
            "nextDialogs": [
              "401870314"
            ]
          },
          "401870314": {
            "id": "401870314",
            "speakerId": 1006,
            "speakerName": "胡桃",
            "text": "这回眼睛很尖嘛，派蒙。是啦，我又做了一根梅枝哦。",
            "nextDialogs": [
              "401870315"
            ]
          },
          "401870315": {
            "id": "401870315",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "#哦~这下你和{NICKNAME}的成一对了。",
            "nextDialogs": [
              "401870316"
            ]
          },
          "401870316": {
            "id": "401870316",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "话说回来，你们在干什么呢？",
            "nextDialogs": [
              "401870317"
            ]
          },
          "401870317": {
            "id": "401870317",
            "speakerId": 1003,
            "speakerName": "蓝砚",
            "text": "我们在讨论八奇里谁比较厉害。",
            "nextDialogs": [
              "401870318"
            ]
          },
          "401870318": {
            "id": "401870318",
            "speakerId": 1004,
            "speakerName": "嘉明",
            "text": "哈哈哈，都是你有你讲他有他讲而已，不会有结论的。",
            "nextDialogs": [
              "401870319"
            ]
          },
          "401870319": {
            "id": "401870319",
            "speakerId": 1002,
            "speakerName": "重云",
            "text": "嗯，除非我们有那种轻小说里的眼镜，戴上就能看见大家的战斗力。",
            "nextDialogs": [
              "401870320"
            ]
          },
          "401870320": {
            "id": "401870320",
            "speakerId": 1000,
            "speakerName": "香菱",
            "text": "哈哈，重云是被行秋传染了轻小说吗？",
            "nextDialogs": [
              "401870321"
            ]
          },
          "401870321": {
            "id": "401870321",
            "speakerId": 1005,
            "speakerName": "行秋",
            "text": "#{NICKNAME}，欢迎你。我听家人说，你和胡桃完成了一个很有风险的祭仪，所以太爷爷的病才能好。",
            "nextDialogs": [
              "401870322"
            ]
          },
          "401870322": {
            "id": "401870322",
            "speakerId": 1005,
            "speakerName": "行秋",
            "text": "大恩不言谢，今后不论遇到何种麻烦，都欢迎来与我们飞云商会商量。",
            "nextDialogs": [
              "401870323"
            ]
          },
          "401870323": {
            "id": "401870323",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "还有其他人的功劳呢。",
            "nextDialogs": [
              "401870324"
            ]
          },
          "401870324": {
            "id": "401870324",
            "speakerId": 1005,
            "speakerName": "行秋",
            "text": "嗯，我知道，父亲和大哥会一一择日登门拜访。",
            "nextDialogs": [
              "401870325"
            ]
          },
          "401870325": {
            "id": "401870325",
            "speakerId": 1006,
            "speakerName": "胡桃",
            "text": "有什么好谢的啦，行秋，不如你现在就乖乖承认，最厉害的是无妄姥爷和幽蝶仙子吧？",
            "nextDialogs": [
              "401870326"
            ]
          },
          "401870326": {
            "id": "401870326",
            "speakerId": 1000,
            "speakerName": "香菱",
            "text": "哎呀，别再讨论这种没有结果的事啦！既然大家都到了，我们就快吃饭吧。",
            "nextDialogs": [
              "401870327"
            ]
          },
          "401870327": {
            "id": "401870327",
            "speakerId": 1000,
            "speakerName": "香菱",
            "text": "派蒙，快，传授人生理念的时候到了。",
            "nextDialogs": [
              "401870328"
            ]
          },
          "401870328": {
            "id": "401870328",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "我、我吗？呃…我想想…好像是人生得意须尽吃，莫使…莫使什么来着？",
            "nextDialogs": [
              "401870329"
            ]
          },
          "401870329": {
            "id": "401870329",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "莫使金箸空对月。",
            "nextDialogs": [
              "401870330"
            ]
          },
          "401870330": {
            "id": "401870330",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "哦对对，就是这个。",
            "nextDialogs": [
              "401870331"
            ]
          },
          "401870331": {
            "id": "401870331",
            "speakerId": 1004,
            "speakerName": "嘉明",
            "text": "哇，派蒙，连人生信条都讲得磕磕绊绊的？小心人生也磕磕绊绊喔。加油！喊多一次来听听！",
            "nextDialogs": [
              "401870332"
            ]
          },
          "401870332": {
            "id": "401870332",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "人生得意须尽吃！莫使金箸空对月！",
            "nextDialogs": [
              "401870333"
            ]
          },
          "401870333": {
            "id": "401870333",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "很有精神。",
            "nextDialogs": [
              "401870334"
            ]
          },
          "401870334": {
            "id": "401870334",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "嘿嘿，那我们可以开吃了吗？",
            "nextDialogs": [
              "401870335"
            ]
          },
          "401870335": {
            "id": "401870335",
            "speakerId": 1000,
            "speakerName": "香菱",
            "text": "派蒙，你是不是忘了，还有一位特别嘉宾？",
            "nextDialogs": [
              "401870336"
            ]
          },
          "401870336": {
            "id": "401870336",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "对哦！我想起来了，其实我早就猜到是谁了啦，但是我不说。",
            "nextDialogs": [
              "401870337"
            ]
          },
          "401870337": {
            "id": "401870337",
            "speakerId": 1006,
            "speakerName": "胡桃",
            "text": "咦？派蒙的语气有点心虚呢，其实根本猜不出来吧？",
            "nextDialogs": [
              "401870338"
            ]
          },
          "401870338": {
            "id": "401870338",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "#哎呀，我真的猜出来了，就是那个人…{NICKNAME}，快帮帮我呀！",
            "nextDialogs": [
              "401870339"
            ]
          },
          "401870339": {
            "id": "401870339",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "是云堇吧。",
            "nextDialogs": [
              "401870340"
            ]
          },
          "401870340": {
            "id": "401870340",
            "speakerId": 1006,
            "speakerName": "胡桃",
            "text": "没错！就是我们的好云堇，看来你也没忘记她说的话。",
            "nextDialogs": [
              "401870341"
            ]
          },
          "401870341": {
            "id": "401870341",
            "speakerId": 1006,
            "speakerName": "胡桃",
            "text": "看，云堇上台了。",
            "nextDialogs": [
              "401870342"
            ]
          },
          "401870342": {
            "id": "401870342",
            "speakerId": 1007,
            "speakerName": "利兴",
            "text": "哇！那不是云翰社的当家吗？",
            "nextDialogs": [
              "401870343"
            ]
          },
          "401870343": {
            "id": "401870343",
            "speakerId": 1008,
            "speakerName": "捷悟",
            "text": "真走运，没想到云先生来遗珑埠了。",
            "nextDialogs": [
              "401870344"
            ]
          },
          "401870344": {
            "id": "401870344",
            "speakerId": 1009,
            "speakerName": "云堇",
            "text": "诸位有礼了。",
            "nextDialogs": [
              "401870345"
            ]
          },
          "401870345": {
            "id": "401870345",
            "speakerId": 1009,
            "speakerName": "云堇",
            "text": "今夜再唱一曲八奇炼桃都，给几位错过海灯节的好友。没有那晚的舞台，还请不要见怪。",
            "nextDialogs": [
              "401870346"
            ]
          },
          "401870346": {
            "id": "401870346",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "呜哇！云堇专门唱给你们这些错过的人听呢！",
            "nextDialogs": [
              "401870347"
            ]
          },
          "401870347": {
            "id": "401870347",
            "speakerId": 1006,
            "speakerName": "胡桃",
            "text": "嘘！她要开始啦。",
            "nextDialogs": [
              "401870356"
            ]
          },
          "401870356": {
            "id": "401870356",
            "speakerId": 1009,
            "speakerName": "云堇",
            "text": "想那桃都狂言",
            "nextDialogs": [
              "401870348"
            ]
          },
          "401870348": {
            "id": "401870348",
            "speakerId": 1009,
            "speakerName": "云堇",
            "text": "妖嘶嘶怪喧喧树下吵闹，有情鬼无缘人唯我令号。",
            "nextDialogs": [
              "401870349"
            ]
          },
          "401870349": {
            "id": "401870349",
            "speakerId": 1009,
            "speakerName": "云堇",
            "text": "离愁界入红尘怨火焦燎，骨作刀血化马九霄直捣，尔的野心可笑——",
            "nextDialogs": [
              "401870350"
            ]
          },
          "401870350": {
            "id": "401870350",
            "speakerId": 1009,
            "speakerName": "云堇",
            "text": "补天济世传灯火，戈枪剑戟影婆娑。",
            "nextDialogs": [
              "401870351"
            ]
          },
          "401870351": {
            "id": "401870351",
            "speakerId": 1009,
            "speakerName": "云堇",
            "text": "生死阴阳可奈何，你害生肥己种因果。",
            "nextDialogs": [
              "401870352"
            ]
          },
          "401870352": {
            "id": "401870352",
            "speakerId": 1009,
            "speakerName": "云堇",
            "text": "天道中正不多少，贪欲有余是尔过。",
            "nextDialogs": [
              "401870353"
            ]
          },
          "401870353": {
            "id": "401870353",
            "speakerId": 1009,
            "speakerName": "云堇",
            "text": "萌誓愿除魔非是我，共八门刀起桃都落。",
            "nextDialogs": [
              "401870354"
            ]
          },
          "401870354": {
            "id": "401870354",
            "speakerId": 1009,
            "speakerName": "云堇",
            "text": "身前力竭销魂魄，身后有人代辨清浊。",
            "nextDialogs": [
              "401870355"
            ]
          },
          "401870355": {
            "id": "401870355",
            "speakerId": 1009,
            "speakerName": "云堇",
            "text": "折柳洒泪落田陌，来年飞燕衔枝荡春波。"
          }
        }
      }
    },
    {
      "subId": "4018704",
      "subQuestName": "前往遗珑埠",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [],
        "dialogs": {}
      }
    },
    {
      "subId": "4018705",
      "subQuestName": "尾声",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "401870401"
        ],
        "dialogs": {
          "401870401": {
            "id": "401870401",
            "speakerId": 1010,
            "speakerName": "魈",
            "text": "#那日，你该陪同{NICKNAME}一起进入边界。",
            "nextDialogs": [
              "401870402"
            ]
          },
          "401870402": {
            "id": "401870402",
            "speakerId": 1011,
            "speakerName": "夜兰",
            "text": "#降魔大圣恐怕是关心则乱。要有什么事连{NICKNAME}也犯难，我就更派不上用场了。",
            "nextDialogs": [
              "401870403"
            ]
          },
          "401870403": {
            "id": "401870403",
            "speakerId": 1011,
            "speakerName": "夜兰",
            "text": "况且，是凝光差我去了层岩巨渊，我也分身乏术。",
            "nextDialogs": [
              "401870404"
            ]
          },
          "401870404": {
            "id": "401870404",
            "speakerId": 1011,
            "speakerName": "夜兰",
            "text": "降魔大圣若是不满意，不如改日去玉京台，告她一状如何？",
            "nextDialogs": [
              "401870405"
            ]
          },
          "401870405": {
            "id": "401870405",
            "speakerId": 1010,
            "speakerName": "魈",
            "text": "呵，向天权…告天权？",
            "nextDialogs": [
              "401870406"
            ]
          },
          "401870406": {
            "id": "401870406",
            "speakerId": 1011,
            "speakerName": "夜兰",
            "text": "降魔大圣把玉衡星放在哪里了，她可不怕找谁的麻烦。",
            "nextDialogs": [
              "401870407"
            ]
          },
          "401870407": {
            "id": "401870407",
            "speakerId": 1010,
            "speakerName": "魈",
            "text": "罢了，最后无事便好。",
            "nextDialogs": [
              "401870408"
            ]
          },
          "401870408": {
            "id": "401870408",
            "speakerId": 1011,
            "speakerName": "夜兰",
            "text": "嗯，望舒客栈真是个好地方啊。",
            "nextDialogs": [
              "401870409"
            ]
          },
          "401870409": {
            "id": "401870409",
            "speakerId": 1010,
            "speakerName": "魈",
            "text": "整个璃月都是好地方。",
            "nextDialogs": [
              "401870410"
            ]
          },
          "401870410": {
            "id": "401870410",
            "speakerId": 1011,
            "speakerName": "夜兰",
            "text": "哈哈，说的不错。",
            "nextDialogs": [
              "401870411"
            ]
          },
          "401870411": {
            "id": "401870411",
            "speakerId": 1011,
            "speakerName": "夜兰",
            "text": "店家，再来一份沾露虾仁，带辣碟的。",
            "nextDialogs": [
              "401870412"
            ]
          },
          "401870412": {
            "id": "401870412",
            "speakerId": 1010,
            "speakerName": "魈",
            "text": "……",
            "nextDialogs": [
              "401870413"
            ]
          },
          "401870413": {
            "id": "401870413",
            "speakerId": 1011,
            "speakerName": "夜兰",
            "text": "还要一份杏仁豆腐。"
          }
        }
      }
    },
    {
      "subId": "4018706",
      "subQuestName": "尾声",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "401870501"
        ],
        "dialogs": {
          "401870501": {
            "id": "401870501",
            "speakerId": 1012,
            "speakerName": "北斗",
            "text": "危机解除，我们的天权大人怎么还板着一张脸啊？",
            "nextDialogs": [
              "401870502"
            ]
          },
          "401870502": {
            "id": "401870502",
            "speakerId": 1013,
            "speakerName": "凝光",
            "text": "#托胡堂主与{NICKNAME}的福，问题算是圆满解决了。可危机的原因我们仍尚未知晓。",
            "nextDialogs": [
              "401870503"
            ]
          },
          "401870503": {
            "id": "401870503",
            "speakerId": 1013,
            "speakerName": "凝光",
            "text": "船长消息灵通，应当知道，最近纳塔同样发生了关乎地脉与生死的大事。",
            "nextDialogs": [
              "401870504"
            ]
          },
          "401870504": {
            "id": "401870504",
            "speakerId": 1013,
            "speakerName": "凝光",
            "text": "我在想，其中是否有某种更加隐秘的联系呢？",
            "nextDialogs": [
              "401870505"
            ]
          },
          "401870505": {
            "id": "401870505",
            "speakerId": 1012,
            "speakerName": "北斗",
            "text": "要有那种事，不可能只在璃月与纳塔，我会托生意伙伴，帮你留意其它地界的风声。",
            "nextDialogs": [
              "401870506"
            ]
          },
          "401870506": {
            "id": "401870506",
            "speakerId": 1012,
            "speakerName": "北斗",
            "text": "至于现在嘛，我建议你还是先把心思收回来，别辜负了美景佳节。",
            "nextDialogs": [
              "401870507"
            ]
          },
          "401870507": {
            "id": "401870507",
            "speakerId": 1013,
            "speakerName": "凝光",
            "text": "呵呵，怎么会？我像是刻晴那种不懂劳逸结合的人吗？",
            "nextDialogs": [
              "401870508"
            ]
          },
          "401870508": {
            "id": "401870508",
            "speakerId": 1012,
            "speakerName": "北斗",
            "text": "那你怎么还戴着这支老钗？我的那份酬劳，不是让你去买支新的吗？",
            "nextDialogs": [
              "401870509"
            ]
          },
          "401870509": {
            "id": "401870509",
            "speakerId": 1013,
            "speakerName": "凝光",
            "text": "不多确认几次，我怎么敢动北斗船长的钱？万一某人心不诚，拿我开涮呢？",
            "nextDialogs": [
              "401870510"
            ]
          },
          "401870510": {
            "id": "401870510",
            "speakerId": 1012,
            "speakerName": "北斗",
            "text": "哈哈哈哈，你这女人，非让我替你挑吗？行行，走，跟我一起去街市逛逛。",
            "nextDialogs": [
              "401870511"
            ]
          },
          "401870511": {
            "id": "401870511",
            "speakerId": 1013,
            "speakerName": "凝光",
            "text": "哎呀，北斗船长什么时候这么善解人意了？",
            "nextDialogs": [
              "401870512"
            ]
          },
          "401870512": {
            "id": "401870512",
            "speakerId": 1012,
            "speakerName": "北斗",
            "text": "哈哈，少说那些，走不走啊？",
            "nextDialogs": [
              "401870513"
            ]
          },
          "401870513": {
            "id": "401870513",
            "speakerId": 1013,
            "speakerName": "凝光",
            "text": "有何不可？"
          }
        }
      }
    },
    {
      "subId": "4018707",
      "subQuestName": "尾声",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "401870601"
        ],
        "dialogs": {
          "401870601": {
            "id": "401870601",
            "speakerId": 1014,
            "speakerName": "刻晴",
            "text": "甘雨，还在忙吗？辛苦你了。",
            "nextDialogs": [
              "401870602"
            ]
          },
          "401870602": {
            "id": "401870602",
            "speakerId": 1015,
            "speakerName": "甘雨",
            "text": "#欸？刻晴…没有啦，我也没有做什么了不起的事。这次的问题，全靠{NICKNAME}和胡堂主才是。",
            "nextDialogs": [
              "401870603"
            ]
          },
          "401870603": {
            "id": "401870603",
            "speakerId": 1014,
            "speakerName": "刻晴",
            "text": "#别妄自菲薄呀，{M#他们}{F#她们}两个当然是最大的功臣。",
            "nextDialogs": [
              "401870604"
            ]
          },
          "401870604": {
            "id": "401870604",
            "speakerId": 1014,
            "speakerName": "刻晴",
            "text": "不过我们也没有辜负大家的信任，总务司响应得很快，不是吗？",
            "nextDialogs": [
              "401870605"
            ]
          },
          "401870605": {
            "id": "401870605",
            "speakerId": 1014,
            "speakerName": "刻晴",
            "text": "虽然明面上，这次的事件不比当初的魔神之灾，但若危机爆发出来，后果就很难说了。",
            "nextDialogs": [
              "401870606"
            ]
          },
          "401870606": {
            "id": "401870606",
            "speakerId": 1015,
            "speakerName": "甘雨",
            "text": "嗯…对了，说起这个，其实我一直有个疑惑。那八门七门的阵法，我在月海亭的资料里从未见过。",
            "nextDialogs": [
              "401870607"
            ]
          },
          "401870607": {
            "id": "401870607",
            "speakerId": 1014,
            "speakerName": "刻晴",
            "text": "噢，你在想阵法的来历啊，那是凝光变出来的。",
            "nextDialogs": [
              "401870608"
            ]
          },
          "401870608": {
            "id": "401870608",
            "speakerId": 1015,
            "speakerName": "甘雨",
            "text": "欸？",
            "nextDialogs": [
              "401870609"
            ]
          },
          "401870609": {
            "id": "401870609",
            "speakerId": 1014,
            "speakerName": "刻晴",
            "text": "哈哈，只是说笑。",
            "nextDialogs": [
              "401870610"
            ]
          },
          "401870610": {
            "id": "401870610",
            "speakerId": 1014,
            "speakerName": "刻晴",
            "text": "那日，撰有此阵法的箓笺，是凭空出现在玉京台的，连夜兰都没能查到来历。",
            "nextDialogs": [
              "401870611"
            ]
          },
          "401870611": {
            "id": "401870611",
            "speakerId": 1015,
            "speakerName": "甘雨",
            "text": "凭空出现的？那…凝光是不是太过冒险了？",
            "nextDialogs": [
              "401870612"
            ]
          },
          "401870612": {
            "id": "401870612",
            "speakerId": 1014,
            "speakerName": "刻晴",
            "text": "看似冒险，但若深想一些，就明白其中的合理之处…",
            "nextDialogs": [
              "401870613"
            ]
          },
          "401870613": {
            "id": "401870613",
            "speakerId": 1014,
            "speakerName": "刻晴",
            "text": "放眼璃月，既知危机，又晓秘法，还能在玉京台避夜兰耳目、雪中送炭之人…有几位？",
            "nextDialogs": [
              "401870614"
            ]
          },
          "401870614": {
            "id": "401870614",
            "speakerId": 1015,
            "speakerName": "甘雨",
            "text": "啊…难道是师父他们…？",
            "nextDialogs": [
              "401870615"
            ]
          },
          "401870615": {
            "id": "401870615",
            "speakerId": 1015,
            "speakerName": "甘雨",
            "text": "我明白了。"
          }
        }
      }
    },
    {
      "subId": "4018708",
      "subQuestName": "尾声",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "401870701"
        ],
        "dialogs": {
          "401870701": {
            "id": "401870701",
            "speakerId": 1016,
            "speakerName": "闲云",
            "text": "往生堂那丫头，真有几分了不起。",
            "nextDialogs": [
              "401870702"
            ]
          },
          "401870702": {
            "id": "401870702",
            "speakerId": 1016,
            "speakerName": "闲云",
            "text": "早前只因为帝君在那当什么客卿，本仙才对她有些兴趣，如今方知其中真意啊。",
            "nextDialogs": [
              "401870703"
            ]
          },
          "401870703": {
            "id": "401870703",
            "speakerId": 1017,
            "speakerName": "削月筑阳真君",
            "text": "话虽如此，但能听见留云借风这番称赞，倒是稀奇得很。",
            "nextDialogs": [
              "401870704"
            ]
          },
          "401870704": {
            "id": "401870704",
            "speakerId": 1016,
            "speakerName": "闲云",
            "text": "如何稀奇了？",
            "nextDialogs": [
              "401870705"
            ]
          },
          "401870705": {
            "id": "401870705",
            "speakerId": 1018,
            "speakerName": "理水叠山真君",
            "text": "若是以往，想必是「那丫头虽有两把刷子，但若换我们申鹤甘雨，也不差几分。」",
            "nextDialogs": [
              "401870706"
            ]
          },
          "401870706": {
            "id": "401870706",
            "speakerId": 1016,
            "speakerName": "闲云",
            "text": "哼！本仙岂是那种凡事喜欢扒高抬己之辈？那丫头有此大义，不值得本仙一句称赞？",
            "nextDialogs": [
              "401870707"
            ]
          },
          "401870707": {
            "id": "401870707",
            "speakerId": 1019,
            "speakerName": "萍姥姥",
            "text": "呵呵呵，当然是值得。我在璃月港住久了，早已知道往生堂这地方，代代有英才啊。",
            "nextDialogs": [
              "401870708"
            ]
          },
          "401870708": {
            "id": "401870708",
            "speakerId": 1017,
            "speakerName": "削月筑阳真君",
            "text": "歌尘说得不错。昔日那魔神桃都与我等虽非敌，亦非友，若不是他仍心系众生，甘愿自炼己身，平定幽冥…",
            "nextDialogs": [
              "401870709"
            ]
          },
          "401870709": {
            "id": "401870709",
            "speakerId": 1017,
            "speakerName": "削月筑阳真君",
            "text": "莫说八奇，就是再来八仙，又奈他何？那之后他身化边界，不想竟由凡人维护至今，可叹，可叹。",
            "nextDialogs": [
              "401870710"
            ]
          },
          "401870710": {
            "id": "401870710",
            "speakerId": 1018,
            "speakerName": "理水叠山真君",
            "text": "话说回来，那往生堂小女，姓甚名谁，我倒还不知。",
            "nextDialogs": [
              "401870711"
            ]
          },
          "401870711": {
            "id": "401870711",
            "speakerId": 1020,
            "speakerName": "钟离",
            "text": "堂主姓胡，名桃。",
            "nextDialogs": [
              "401870712"
            ]
          },
          "401870712": {
            "id": "401870712",
            "speakerId": 1017,
            "speakerName": "削月筑阳真君",
            "text": "蝴蝶的蝴？",
            "nextDialogs": [
              "401870713"
            ]
          },
          "401870713": {
            "id": "401870713",
            "speakerId": 1020,
            "speakerName": "钟离",
            "text": "胡闹的胡。",
            "nextDialogs": [
              "401870714"
            ]
          },
          "401870714": {
            "id": "401870714",
            "speakerId": 1017,
            "speakerName": "削月筑阳真君",
            "text": "淘气的淘？",
            "nextDialogs": [
              "401870715"
            ]
          },
          "401870715": {
            "id": "401870715",
            "speakerId": 1020,
            "speakerName": "钟离",
            "text": "桃都的桃。",
            "nextDialogs": [
              "401870716"
            ]
          },
          "401870716": {
            "id": "401870716",
            "speakerId": 1018,
            "speakerName": "理水叠山真君",
            "text": "噢，蝴蝶的蝴，桃都的桃，好名字，人如其名的好名字。",
            "nextDialogs": [
              "401870717"
            ]
          },
          "401870717": {
            "id": "401870717",
            "speakerId": 1016,
            "speakerName": "闲云",
            "text": "是胡闹的胡，胡搅蛮缠、胡吃海喝的胡！",
            "nextDialogs": [
              "401870718"
            ]
          },
          "401870718": {
            "id": "401870718",
            "speakerId": 1018,
            "speakerName": "理水叠山真君",
            "text": "你看你，我不就是活跃一下气氛吗？怎么？她胡闹得，我胡闹不得？",
            "nextDialogs": [
              "401870719"
            ]
          },
          "401870719": {
            "id": "401870719",
            "speakerId": 1016,
            "speakerName": "闲云",
            "text": "哦？你几时改的名号啊？胡山胡水真君？",
            "nextDialogs": [
              "401870720"
            ]
          },
          "401870720": {
            "id": "401870720",
            "speakerId": 1019,
            "speakerName": "萍姥姥",
            "text": "呵呵，还是来喝茶吧，这是帝君从轻策带回的鬼山灵芽，颇为罕见，莫要错了时机。",
            "nextDialogs": [
              "401870721"
            ]
          },
          "401870721": {
            "id": "401870721",
            "speakerId": 1019,
            "speakerName": "萍姥姥",
            "text": "希望来年也有好茶喝啊。",
            "nextDialogs": [
              "401870722"
            ]
          },
          "401870722": {
            "id": "401870722",
            "speakerId": 1020,
            "speakerName": "钟离",
            "text": "嗯，会的。"
          }
        }
      }

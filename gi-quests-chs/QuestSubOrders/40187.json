  "subQuests": [
    {
      "subId": "4018701",
      "subQuestName": "等待到两天后",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "401870101"
        ],
        "dialogs": {
          "401870101": {
            "id": "401870101",
            "speakerId": 1000,
            "speakerName": "香菱",
            "text": "#嘿！{NICKNAME}，派蒙。",
            "nextDialogs": [
              "401870102"
            ]
          },
          "401870102": {
            "id": "401870102",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "香菱！找我们有什么事呀！",
            "nextDialogs": [
              "401870103"
            ]
          },
          "401870103": {
            "id": "401870103",
            "speakerId": 1000,
            "speakerName": "香菱",
            "text": "哈哈，我还能有什么事，当然就是祭祭五脏庙的事啦。",
            "nextDialogs": [
              "401870104"
            ]
          },
          "401870104": {
            "id": "401870104",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "终于要吃上饭了吗？",
            "nextDialogs": [
              "401870105"
            ]
          },
          "401870105": {
            "id": "401870105",
            "speakerId": 1000,
            "speakerName": "香菱",
            "text": "嗯！应该有空吧？不能再推脱了。",
            "nextDialogs": [
              "401870106"
            ]
          },
          "401870106": {
            "id": "401870106",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "一直没空的可不是我们呀，是胡桃那个家伙！",
            "nextDialogs": [
              "401870107"
            ]
          },
          "401870107": {
            "id": "401870107",
            "speakerId": 1000,
            "speakerName": "香菱",
            "text": "谁让她是堂主呢，架子大得很哦！不多来几个人都约不到。",
            "nextDialogs": [
              "401870108"
            ]
          },
          "401870108": {
            "id": "401870108",
            "speakerId": 1000,
            "speakerName": "香菱",
            "text": "不过你们放心，这回都说好了，我们逼着她不许找借口。",
            "nextDialogs": [
              "401870109"
            ]
          },
          "401870109": {
            "id": "401870109",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "哦？还有别人出手吗？",
            "nextDialogs": [
              "401870110"
            ]
          },
          "401870110": {
            "id": "401870110",
            "speakerId": 1000,
            "speakerName": "香菱",
            "text": "嘿嘿，是行秋啦，他说早想约大家一起聚一聚了，可是你们也知道他太爷爷的事吧，所以一直不方便。",
            "nextDialogs": [
              "401870111"
            ]
          },
          "401870111": {
            "id": "401870111",
            "speakerId": 1000,
            "speakerName": "香菱",
            "text": "不过海灯节那晚，行秋太爷爷突然就醒了，别提他有多高兴了，这才有机会出来，我们当然一拍即合啦。",
            "nextDialogs": [
              "401870112"
            ]
          },
          "401870112": {
            "id": "401870112",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "哇！老太公没事了吗？",
            "nextDialogs": [
              "401870113"
            ]
          },
          "401870113": {
            "id": "401870113",
            "speakerId": 1000,
            "speakerName": "香菱",
            "text": "嗯，大夫都看了，没一点毛病。",
            "nextDialogs": [
              "401870114"
            ]
          },
          "401870114": {
            "id": "401870114",
            "speakerId": 1000,
            "speakerName": "香菱",
            "text": "行秋说，他太爷爷一醒来就大吃特吃，和派蒙一样，胃口好得不得了，家人们这会开始担心，老太公别又撑坏了。",
            "nextDialogs": [
              "401870115"
            ]
          },
          "401870115": {
            "id": "401870115",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "怎么感觉像我一样不是什么好话呢。",
            "nextDialogs": [
              "401870116"
            ]
          },
          "401870116": {
            "id": "401870116",
            "speakerId": 1000,
            "speakerName": "香菱",
            "text": "当然是好话呀，派蒙的胃口是一种积极的人生态度哦。人生得意须尽吃，莫使金箸空对月呀！",
            "nextDialogs": [
              "401870117"
            ]
          },
          "401870117": {
            "id": "401870117",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "哎呀，香菱说得真好！我就是带着这种理念才一步一步走到今天的！",
            "nextDialogs": [
              "401870118"
            ]
          },
          "401870118": {
            "id": "401870118",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "有这回事？我怎么不知道。",
            "nextDialogs": [
              "401870119"
            ]
          },
          "401870119": {
            "id": "401870119",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "哼哼，就有！人生得意须尽吃，莫使…莫使什么来着？",
            "nextDialogs": [
              "401870120"
            ]
          },
          "401870120": {
            "id": "401870120",
            "speakerId": 1000,
            "speakerName": "香菱",
            "text": "哈哈，小派蒙，把你的理念留到饭桌上再说吧。",
            "nextDialogs": [
              "401870121"
            ]
          },
          "401870121": {
            "id": "401870121",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "嘿嘿，没问题！那我们在哪里吃饭呢？",
            "nextDialogs": [
              "401870122"
            ]
          },
          "401870122": {
            "id": "401870122",
            "speakerId": 1000,
            "speakerName": "香菱",
            "text": "在遗珑埠，就今晚，行秋他们都还在那边呢。对了，胡桃说她还有一位特别嘉宾。",
            "nextDialogs": [
              "401870123"
            ]
          },
          "401870123": {
            "id": "401870123",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "哪位？",
            "nextDialogs": [
              "401870124"
            ]
          },
          "401870124": {
            "id": "401870124",
            "speakerId": 1000,
            "speakerName": "香菱",
            "text": "晚上到了你们就知道了嘛。",
            "nextDialogs": [
              "401870125"
            ]
          },
          "401870125": {
            "id": "401870125",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "啊！我大概猜到是谁了，嘿嘿，但是我不说。",
            "nextDialogs": [
              "401870126"
            ]
          },
          "401870126": {
            "id": "401870126",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "我也猜到了。",
            "nextDialogs": [
              "401870127"
            ]
          },
          "401870127": {
            "id": "401870127",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "欸？你猜是谁啊？",
            "nextDialogs": [
              "401870128"
            ]
          },
          "401870128": {
            "id": "401870128",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "我也不说。",
            "nextDialogs": [
              "401870129"
            ]
          },
          "401870129": {
            "id": "401870129",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "哼，那我们晚上看看谁猜的比较准！"
          }
        }
      }
    },
    {
      "subId": "4018702",
      "subQuestName": "去找香菱",
      "sceneId": null,
      "locations": [],
      "dialogue": {

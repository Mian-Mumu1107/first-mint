        ],
        "dialogs": {
          "711100901": {
            "id": "711100901",
            "speakerId": 2472,
            "speakerName": "方矩",
            "text": "明早八点至下午六点，我们会将入选作品公开展示，地点就在合辙驿外的大街。两位不要忘记，明天要再来一趟哦。"
          }
        }
      }
    },
    {
      "subId": "7111010",
      "subQuestName": "去合辙驿外参观入选作品展",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "711101001"
        ],
        "dialogs": {
          "711101001": {
            "id": "711101001",
            "speakerId": 2472,
            "speakerName": "方矩",
            "text": "两位，你们来了。",
            "nextDialogs": [
              "711101002"
            ]
          },
          "711101002": {
            "id": "711101002",
            "speakerId": 2472,
            "speakerName": "方矩",
            "text": "看见这些展出的画片了吗？这次的「沉玉之旅」一共有八幅入选作品，你们包揽了其中一半。",
            "nextDialogs": [
              "711101003"
            ]
          },
          "711101003": {
            "id": "711101003",
            "speakerId": 2472,
            "speakerName": "方矩",
            "text": "恭喜你们！",
            "nextDialogs": [
              "711101004"
            ]
          },
          "711101004": {
            "id": "711101004",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "哇！这也太棒了吧？",
            "nextDialogs": [
              "711101005"
            ]
          },
          "711101005": {
            "id": "711101005",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "#{NICKNAME}！我就说吧，最后的结果是四分之四呢！我的算数真是越来越厉害了！",
            "nextDialogs": [
              "711101008"
            ]
          },
          "711101008": {
            "id": "711101008",
            "speakerId": 2472,
            "speakerName": "方矩",
            "text": "呵呵，就和我昨天的看法类似，评委们对你们另外两幅作品也赞赏有加。",
            "nextDialogs": [
              "711101009"
            ]
          },
          "711101009": {
            "id": "711101009",
            "speakerId": 2472,
            "speakerName": "方矩",
            "text": "所以，请收好这份限量版「沉玉之旅」留影纪念册，里面收录了这次的全部入选作品。这是你们应得的。",
            "nextDialogs": [
              "711101010"
            ]
          },
          "711101010": {
            "id": "711101010",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "这就是惊喜吗？看起来很漂亮呢！",
            "nextDialogs": [
              "711101011"
            ]
          },
          "711101011": {
            "id": "711101011",
            "speakerId": 2472,
            "speakerName": "方矩",
            "text": "如果不嫌弃的话，我这里还有一些摩拉，请收下吧。我要再次感谢你们的支持，这次是以私人的身份。",
            "nextDialogs": [
              "711101012"
            ]
          },
          "711101012": {
            "id": "711101012",
            "speakerId": 2472,
            "speakerName": "方矩",
            "text": "因为这里是我的家乡，你们把她美丽动人的地方永远地记录了下来，这些画片一定会让更多人喜欢上这里吧。",
            "nextDialogs": [
              "711101013"
            ]
          },
          "711101013": {
            "id": "711101013",
            "speakerId": 2472,
            "speakerName": "方矩",
            "text": "谢谢你们。"
          }
        }
      }
    },
    {
      "subId": "7111012",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [

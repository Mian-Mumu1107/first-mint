    {
      "subId": "7111015",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "711101501"
        ],
        "dialogs": {
          "711101501": {
            "id": "711101501",
            "speakerId": 21223,
            "speakerName": "马里",
            "text": "哎呀！那个稻妻冤大头怎么也在，我得假装没看见他才行…还好有个璃月人挡在中间，他应该没看见我吧。",
            "nextDialogs": [
              "711101502"
            ]
          },
          "711101502": {
            "id": "711101502",
            "speakerId": 21223,
            "speakerName": "马里",
            "text": "可恶，这些风景画片怎么就这么赏心悦目呢？害得我都不舍得立刻走掉…"
          }
        }
      }
    },
    {
      "subId": "7111016",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "711101601"
        ],
        "dialogs": {
          "711101601": {
            "id": "711101601",
            "speakerId": 21224,
            "speakerName": "渚春",
            "text": "这些画片拍得真不错啊。只可惜，我左右两边的气氛好像都有点不太对劲…",
            "nextDialogs": [
              "711101602"
            ]
          },
          "711101602": {
            "id": "711101602",
            "speakerId": 21224,
            "speakerName": "渚春",
            "text": "我是不是应该换个地方好好欣赏？"
          }
        }
      }
    },
    {
      "subId": "7111017",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "711101701"
        ],
        "dialogs": {
          "711101701": {
            "id": "711101701",
            "speakerId": 21222,
            "speakerName": "赤井",
            "text": "出现了！那个枫丹无良商人！我真的开始转运了吗？！",
            "nextDialogs": [
              "711101702"
            ]
          },
          "711101702": {
            "id": "711101702",
            "speakerId": 21222,
            "speakerName": "赤井",
            "text": "虽然似乎应该立刻冲过去抓住他，但这样一来，就没办法欣赏这些充满魅力的沉玉谷画片了…",
            "nextDialogs": [
              "711101703"
            ]
          },
          "711101703": {
            "id": "711101703",
            "speakerId": 21222,
            "speakerName": "赤井",
            "text": "不行，这样损失就更大了，还是等看完画片后再行动吧，特别是我的入选作品…"
          }
        }
      }
    },
    {
      "subId": "7111018",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "711101801"
        ],
        "dialogs": {
          "711101801": {
            "id": "711101801",
            "speakerId": 2472,
            "speakerName": "方矩",
            "text": "预祝参赛顺利。"
          }
        }
      }
    },
    {
      "subId": "7111099",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "711109901"
        ],
        "dialogs": {
          "711109901": {
            "id": "711109901",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "呼——算了一下现在的画片，翘英庄的，荷塘的，宝玦口的，悬练山的，全都有了！",
            "nextDialogs": [
              "711109902"
            ]
          },
          "711109902": {
            "id": "711109902",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "应该不会有比我们还努力的参赛者了吧？如果这样都没有获奖，那真是说不过去了！",
            "nextDialogs": [
              "711109903"
            ]
          },
          "711109903": {
            "id": "711109903",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "这里应该就是古树茶王边的荷塘了吧？果然像指南说的那样有魔物！"
          }
        }
      }
    }
  ]
}
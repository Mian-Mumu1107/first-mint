  "subQuests": [
    {
      "subId": "7111001",
      "subQuestName": "与合辙驿的方矩交谈$HIDDEN",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "711100101"
        ],
        "dialogs": {
          "711100101": {
            "id": "711100101",
            "speakerId": 2472,
            "speakerName": "方矩",
            "text": "两位是来参加「沉玉之旅」风光留影赛的吧？",
            "nextDialogs": [
              "711100102"
            ]
          },
          "711100102": {
            "id": "711100102",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "风光留影赛？那是什么？",
            "nextDialogs": [
              "711100103"
            ]
          },
          "711100103": {
            "id": "711100103",
            "speakerId": 2472,
            "speakerName": "方矩",
            "text": "顾名思义，是一个为了宣传沉玉谷美丽风光的留影比赛。",
            "nextDialogs": [
              "711100104"
            ]
          },
          "711100104": {
            "id": "711100104",
            "speakerId": 2472,
            "speakerName": "方矩",
            "text": "早先我们发出了问卷，向广大居民收集沉玉谷最有魅力的风光点。而参赛者则需要前往被挑选出的地点，用留影机拍下对应的画片。",
            "nextDialogs": [
              "711100105"
            ]
          },
          "711100105": {
            "id": "711100105",
            "speakerId": 2472,
            "speakerName": "方矩",
            "text": "最后我们会评选出一些优秀的画片，作为宣传示例，放在合辙驿外的大街公开展出。怎么样，两位有兴趣吗？",
            "nextDialogs": [
              "711100107",
              "711100109"
            ]
          },
          "711100107": {
            "id": "711100107",
            "speakerId": 2472,
            "speakerName": "方矩",
            "text": "若您提交的作品成功入选，当然有一份专属于您的惊喜。",
            "nextDialogs": [
              "711100110"
            ]
          },
          "711100110": {
            "id": "711100110",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "哇！有惊喜！那我们一定要努力把惊喜拿到手！",
            "nextDialogs": [
              "711100111"
            ]
          },
          "711100111": {
            "id": "711100111",
            "speakerId": 2472,
            "speakerName": "方矩",
            "text": "呵呵，即便最后遗憾落选，我们也准备了一份小小的报酬，为两位所付出的时间与心力。希望能让两位满意。",
            "nextDialogs": [
              "711100112"
            ]
          },
          "711100112": {
            "id": "711100112",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "那要怎么开始？",
            "nextDialogs": [
              "711100113"
            ]
          },
          "711100113": {
            "id": "711100113",
            "speakerId": 2472,
            "speakerName": "方矩",
            "text": "请看看这份指南，里面是由沉玉谷居民们推荐的魅力风光点。",
            "nextDialogs": [
              "711100115"
            ]
          },
          "711100115": {
            "id": "711100115",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "咦？怎么还有些被划掉的地方呀？",
            "nextDialogs": [
              "711100116"
            ]
          },
          "711100116": {
            "id": "711100116",
            "speakerId": 2472,
            "speakerName": "方矩",
            "text": "呵呵，因为那些地点的报名人数已经满了，我们希望能更加全面地展示沉玉谷美景。",
            "nextDialogs": [
              "711100117"
            ]
          },
          "711100117": {
            "id": "711100117",
            "speakerId": 2472,
            "speakerName": "方矩",
            "text": "剩下这四处是仍然可以报名的地点，您可以从中任选一处或几处。",
            "nextDialogs": [
              "711100118"
            ]
          },
          "711100118": {
            "id": "711100118",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "#原来是这样…{NICKNAME}，不如我们把剩下的地方都包了吧！",
            "nextDialogs": [
              "711100119"
            ]
          },
          "711100119": {
            "id": "711100119",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "假如拍一张画片的获奖概率是四分之一，那我们拍四张，这样就是四分之四了！也就是一定能拿到获奖的惊喜！"
          },
          "711100109": {
            "id": "711100109",
            "speakerId": 2472,
            "speakerName": "方矩",
            "text": "看来您已经干劲满满了。请容我补充，若您提交的作品成功入选，我们还有一份专属于您的惊喜。"
          }
        }
      }
    },
    {
      "subId": "7111003",
      "subQuestName": "完成沉玉谷风光留影赛",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "711100301"
        ],
        "dialogs": {
          "711100301": {
            "id": "711100301",
            "speakerId": 21224,
            "speakerName": "渚春",
            "text": "小友，你走南闯北，一定欣赏过不少奇景吧？",
            "nextDialogs": [
              "711100302"
            ]
          },
          "711100302": {
            "id": "711100302",
            "speakerId": 21224,
            "speakerName": "渚春",
            "text": "不知道这次留影赛里的沉玉谷风光，能否更胜一筹呢？"
          }
        }
      }
    },
    {
      "subId": "7111013",
      "subQuestName": "(test)完成拍摄B$HIDDEN",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "711101101"
        ],
        "dialogs": {
          "711101101": {
            "id": "711101101",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "小朋友，这只鹈鹕是你家的吗？我们能不能给它和翘英庄一起留个影？",
            "nextDialogs": [
              "711101102"
            ]
          },
          "711101102": {
            "id": "711101102",
            "speakerId": 21406,
            "speakerName": "明镜",
            "text": "哼哼！哼哼唵唵哼哼！",
            "nextDialogs": [
              "711101103"
            ]
          },
          "711101103": {
            "id": "711101103",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "咦？你在说什么？",
            "nextDialogs": [
              "711101104"
            ]
          },
          "711101104": {
            "id": "711101104",
            "speakerId": 21406,
            "speakerName": "明镜",
            "text": "这是鹈鹕话啦，就是「好哦好哦！」的意思。",
            "nextDialogs": [
              "711101105"
            ]
          },
          "711101105": {
            "id": "711101105",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "你会说鹈鹕话？",
            "nextDialogs": [
              "711101106"
            ]
          },
          "711101106": {
            "id": "711101106",
            "speakerId": 21406,
            "speakerName": "明镜",
            "text": "只会一点点而已…因为我发现它们吃饭的时候，就会不停地「哼哼！哼哼唵唵哼哼！」",
            "nextDialogs": [
              "711101107"
            ]
          },
          "711101107": {
            "id": "711101107",
            "speakerId": 21406,
            "speakerName": "明镜",
            "text": "一定就是在开心地说「好哦好哦」！",
            "nextDialogs": [
              "711101108"
            ]
          },
          "711101108": {
            "id": "711101108",
            "speakerId": 21406,
            "speakerName": "明镜",
            "text": "所以后来我也学着这么叫，它们听见就会过来，大概是以为有东西可以吃了。",
            "nextDialogs": [
              "711101109"
            ]
          },
          "711101109": {
            "id": "711101109",
            "speakerId": 21406,
            "speakerName": "明镜",
            "text": "你们想留影的话，也可以试试呼唤一下它们！可惜我也要回家了，不然还能多教教你们！",
            "nextDialogs": [
              "711101110"
            ]
          },
          "711101110": {
            "id": "711101110",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "没关系啦，小朋友，我们自己试试就好啦，谢谢你哦~路上要注意安全！",
            "nextDialogs": [
              "711101111"
            ]
          },
          "711101111": {
            "id": "711101111",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "#{NICKNAME}，我们去那边试试吧，如果能引来鹈鹕，一定会为我们的作品添加胜算！"
          }
        }
      }
    },

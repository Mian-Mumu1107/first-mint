    {
      "subId": "7111011",
      "subQuestName": "(test)完成拍摄D1$HIDDEN",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [],
        "dialogs": {}
      }
    },
    {
      "subId": "7111012",
      "subQuestName": "(test)完成拍摄D2$HIDDEN",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "711101301"
        ],
        "dialogs": {
          "711101301": {
            "id": "711101301",
            "speakerId": 21222,
            "speakerName": "赤井",
            "text": "等等！别过来！你们…你们是好人吗？",
            "nextDialogs": [
              "711101302"
            ]
          },
          "711101302": {
            "id": "711101302",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "喂喂，刚刚可是我们救的你啊！你是不是脑袋撞到哪里了…",
            "nextDialogs": [
              "711101303"
            ]
          },
          "711101303": {
            "id": "711101303",
            "speakerId": 21222,
            "speakerName": "赤井",
            "text": "啊！说的也是…实在不好意思，我这趟沉玉之旅太倒霉了，搞得我有点晕头转向…那，谢谢你们…",
            "nextDialogs": [
              "711101304"
            ]
          },
          "711101304": {
            "id": "711101304",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "你也是来参加留影比赛的？",
            "nextDialogs": [
              "711101305"
            ]
          },
          "711101305": {
            "id": "711101305",
            "speakerId": 21222,
            "speakerName": "赤井",
            "text": "你们也是吗？真巧，不过我只是个普通游客…拿那些丘丘人完全没办法。",
            "nextDialogs": [
              "711101306"
            ]
          },
          "711101306": {
            "id": "711101306",
            "speakerId": 21222,
            "speakerName": "赤井",
            "text": "真是可恶，在路上碰上了它们，不由分说就把我掳了回来，难道丘丘人也会收过路费吗？真是岂有此理…还好遇上了你们。",
            "nextDialogs": [
              "711101307"
            ]
          },
          "711101307": {
            "id": "711101307",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "啊…那你今天确实挺倒霉的。",
            "nextDialogs": [
              "711101308"
            ]
          },
          "711101308": {
            "id": "711101308",
            "speakerId": 21222,
            "speakerName": "赤井",
            "text": "不仅是今天！昨天我也很倒霉，我在一个枫丹商人那里买了一台特别贵的留影机，结果没用几次就坏了，回去找他，他又不见了…",
            "nextDialogs": [
              "711101309"
            ]
          },
          "711101309": {
            "id": "711101309",
            "speakerId": 21222,
            "speakerName": "赤井",
            "text": "真是无良商家…你们出门在外，也千万要捂好自己的钱包啊。",
            "nextDialogs": [
              "711101310"
            ]
          },
          "711101310": {
            "id": "711101310",
            "speakerId": 21222,
            "speakerName": "赤井",
            "text": "对了，有些扯远了，既然你们也参加了沉玉之旅，那来这应该是为了给悬练山留影的吧？",
            "nextDialogs": [
              "711101311"
            ]
          },
          "711101311": {
            "id": "711101311",
            "speakerId": 21222,
            "speakerName": "赤井",
            "text": "总之为了表示感谢，我把我研究过的最佳留影点位告诉你们吧，来，我来标注在你们的地图上。",
            "nextDialogs": [
              "711101312"
            ]
          },
          "711101312": {
            "id": "711101312",
            "speakerId": 21222,
            "speakerName": "赤井",
            "text": "看，这里就能看到，就是那！",
            "nextDialogs": [
              "711101313"
            ]
          },
          "711101313": {
            "id": "711101313",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "欸？那你自己呢？你不也是来参赛的吗？",
            "nextDialogs": [
              "711101314"
            ]
          },
          "711101314": {
            "id": "711101314",
            "speakerId": 21222,
            "speakerName": "赤井",
            "text": "我觉得这附近还是很危险，最好还是换个地方，我记得指南上还有其它地点…我有点想去「仙人品茗」那里看看…",
            "nextDialogs": [
              "711101315"
            ]
          },
          "711101315": {
            "id": "711101315",
            "speakerId": 21222,
            "speakerName": "赤井",
            "text": "嗯！那就这样吧，再会了两位，希望遇见你们是我转运的开始！"
          }
        }
      }
    },
    {
      "subId": "7111006",

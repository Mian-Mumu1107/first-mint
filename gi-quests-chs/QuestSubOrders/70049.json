    {
      "subId": "7004901",
      "subQuestName": "(test)蒙德野外$UNRELEASED",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "700490101"
        ],
        "dialogs": {
          "700490101": {
            "id": "700490101",
            "speakerId": 1000,
            "speakerName": "砂糖",
            "text": "…这样的药剂没问题吗？$UNRELEASED",
            "nextDialogs": [
              "700490102"
            ]
          },
          "700490102": {
            "id": "700490102",
            "speakerId": 1001,
            "speakerName": "诺艾尔",
            "text": "没关系，能行的！大概…$UNRELEASED",
            "nextDialogs": [
              "700490103"
            ]
          },
          "700490103": {
            "id": "700490103",
            "speakerId": 1002,
            "speakerName": "丘丘人$UNRELEASED",
            "text": "——Ya ika！$UNRELEASED",
            "nextDialogs": [
              "700490104"
            ]
          },
          "700490104": {
            "id": "700490104",
            "speakerId": 1001,
            "speakerName": "诺艾尔",
            "text": "唔唔…昨天复习得太晚…没休息好…$UNRELEASED",
            "nextDialogs": [
              "700490105"
            ]
          },
          "700490105": {
            "id": "700490105",
            "speakerId": 1003,
            "speakerName": "蒂玛乌斯",
            "text": "呵——看起来眼熟吗？$UNRELEASED",
            "nextDialogs": [
              "700490106"
            ]
          },
          "700490106": {
            "id": "700490106",
            "speakerId": 1003,
            "speakerName": "蒂玛乌斯",
            "text": "这样的场景，此时此刻正在蒙德各地上演！您，可能就是下一个。$UNRELEASED",
            "nextDialogs": [
              "700490107"
            ]
          },
          "700490107": {
            "id": "700490107",
            "speakerId": 1003,
            "speakerName": "蒂玛乌斯",
            "text": "除非您在出战前，做出最重要的选择…$UNRELEASED",
            "nextDialogs": [
              "700490108"
            ]
          },
          "700490108": {
            "id": "700490108",
            "speakerId": 1000,
            "speakerName": "砂糖",
            "text": "…这样的药剂没问题吗？$UNRELEASED",
            "nextDialogs": [
              "700490109"
            ]
          },
          "700490109": {
            "id": "700490109",
            "speakerId": 1001,
            "speakerName": "诺艾尔",
            "text": "…请给我最好的药剂！$UNRELEASED",
            "nextDialogs": [
              "700490110"
            ]
          },
          "700490110": {
            "id": "700490110",
            "speakerId": 1002,
            "speakerName": "丘丘人$UNRELEASED",
            "text": "——Ya ika！$UNRELEASED",
            "nextDialogs": [
              "700490111"
            ]
          },
          "700490111": {
            "id": "700490111",
            "speakerId": 1001,
            "speakerName": "诺艾尔",
            "text": "准备好——要全都打扫干净了！$UNRELEASED",
            "nextDialogs": [
              "700490112"
            ]
          },
          "700490112": {
            "id": "700490112",
            "speakerId": 1003,
            "speakerName": "蒂玛乌斯",
            "text": "扫除疲惫，做回自己！西风骑士团特许炼金药剂，给您安心，让您放心。$UNRELEASED"
          }
        }
      }
    },
    {
      "subId": "7004902",
      "subQuestName": "(test)万民堂$UNRELEASED",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "700490201"
        ],
        "dialogs": {
          "700490201": {
            "id": "700490201",
            "speakerId": 1004,
            "speakerName": "锅巴",
            "text": "♪~♪~♪~$UNRELEASED",
            "nextDialogs": [
              "700490202"
            ]
          },
          "700490202": {
            "id": "700490202",
            "speakerId": 1005,
            "speakerName": "卯师傅",
            "text": "亲朋聚宴哪家强？吃虎岩找万民堂！$UNRELEASED",
            "nextDialogs": [
              "700490203"
            ]
          },
          "700490203": {
            "id": "700490203",
            "speakerId": 1005,
            "speakerName": "卯师傅",
            "text": "璃月厨王掌厨房，菜品质量有保障！$UNRELEASED",
            "nextDialogs": [
              "700490204"
            ]
          },
          "700490204": {
            "id": "700490204",
            "speakerId": 1005,
            "speakerName": "卯师傅",
            "text": "服务热情更在行，欢声笑语聚满堂！$UNRELEASED",
            "nextDialogs": [
              "700490205"
            ]
          },
          "700490205": {
            "id": "700490205",
            "speakerId": 1006,
            "speakerName": "申鹤",
            "text": "早中晚饭哪家尝？吃虎岩找万民堂。$UNRELEASED",
            "nextDialogs": [
              "700490206"
            ]
          },
          "700490206": {
            "id": "700490206",
            "speakerId": 1006,
            "speakerName": "申鹤",
            "text": "价格便宜又实惠，佳肴美味又不贵。$UNRELEASED",
            "nextDialogs": [
              "700490207"
            ]
          },
          "700490207": {
            "id": "700490207",
            "speakerId": 1006,
            "speakerName": "申鹤",
            "text": "一日三餐顿顿享，只把下馆当家常。$UNRELEASED",
            "nextDialogs": [
              "700490208"
            ]
          },
          "700490208": {
            "id": "700490208",
            "speakerId": 1007,
            "speakerName": "香菱",
            "text": "新鲜口味哪家香？吃虎岩找万民堂！$UNRELEASED",
            "nextDialogs": [
              "700490209"
            ]
          },
          "700490209": {
            "id": "700490209",
            "speakerId": 1007,
            "speakerName": "香菱",
            "text": "璃菜月菜创新菜，准有一款你的菜。$UNRELEASED",
            "nextDialogs": [
              "700490210"
            ]
          },
          "700490210": {
            "id": "700490210",
            "speakerId": 1007,
            "speakerName": "香菱",
            "text": "锅香一起飘四方，仙人尝了也跳墙！$UNRELEASED",
            "nextDialogs": [
              "700490211"
            ]
          },
          "700490211": {
            "id": "700490211",
            "speakerId": 1008,
            "speakerName": "众人$UNRELEASED",
            "text": "——吃饭，就选万民堂！$UNRELEASED",
            "nextDialogs": [
              "700490212"
            ]
          },
          "700490212": {
            "id": "700490212",
            "speakerId": 1004,
            "speakerName": "锅巴",
            "text": "♪~♪！$UNRELEASED",
            "nextDialogs": [
              "700490213"
            ]
          },
          "700490213": {
            "id": "700490213",
            "speakerId": 1007,
            "speakerName": "香菱",
            "text": "啊——锅巴你又偷吃了！$UNRELEASED"
          }
        }
      }
    },
    {
      "subId": "7004903",
      "subQuestName": "(test)花见坂$UNRELEASED",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "700490301"
        ],
        "dialogs": {
          "700490301": {
            "id": "700490301",
            "speakerId": 1009,
            "speakerName": "荒泷一斗",
            "text": "来，这是你们的零花钱。$UNRELEASED",
            "nextDialogs": [
              "700490302"
            ]
          },
          "700490302": {
            "id": "700490302",
            "speakerId": 1010,
            "speakerName": "阿守",
            "text": "哇！我有想买的轻小说！$UNRELEASED",
            "nextDialogs": [
              "700490303"
            ]
          },
          "700490303": {
            "id": "700490303",
            "speakerId": 1011,
            "speakerName": "元太",
            "text": "嗯…要不要先存起来？$UNRELEASED",
            "nextDialogs": [
              "700490304"
            ]
          },
          "700490304": {
            "id": "700490304",
            "speakerId": 1012,
            "speakerName": "阿晃",
            "text": "不如去买串串三味吧！$UNRELEASED",
            "nextDialogs": [
              "700490305"
            ]
          },
          "700490305": {
            "id": "700490305",
            "speakerId": 1009,
            "speakerName": "荒泷一斗",
            "text": "……！$UNRELEASED",
            "nextDialogs": [
              "700490306"
            ]
          },
          "700490306": {
            "id": "700490306",
            "speakerId": 1010,
            "speakerName": "阿守",
            "text": "就这么定吧！谢谢老大！$UNRELEASED",
            "nextDialogs": [
              "700490307"
            ]
          },
          "700490307": {
            "id": "700490307",
            "speakerId": 1009,
            "speakerName": "荒泷一斗",
            "text": "……！！！$UNRELEASED",
            "nextDialogs": [
              "700490308"
            ]
          },
          "700490308": {
            "id": "700490308",
            "speakerId": 1011,
            "speakerName": "元太",
            "text": "老…老大？$UNRELEASED",
            "nextDialogs": [
              "700490309"
            ]
          },
          "700490309": {
            "id": "700490309",
            "speakerId": 1009,
            "speakerName": "荒泷一斗",
            "text": "——给你们零花钱是为了什么啊！$UNRELEASED",
            "nextDialogs": [
              "700490310"
            ]
          },
          "700490310": {
            "id": "700490310",
            "speakerId": 1009,
            "speakerName": "荒泷一斗",
            "text": "要买的话…当然是买「七圣召唤」新卡组啦！$UNRELEASED",
            "nextDialogs": [
              "700490311"
            ]
          },
          "700490311": {
            "id": "700490311",
            "speakerId": 1008,
            "speakerName": "众人$UNRELEASED",
            "text": "「七圣召唤」，赢家永远在胜利的路上！$UNRELEASED",
            "nextDialogs": [
              "700490312"
            ]
          },
          "700490312": {
            "id": "700490312",
            "speakerId": 1013,
            "speakerName": "久岐忍",
            "text": "所以你们有人赢过我了吗…？$UNRELEASED"
          }
        }
      }
    },
    {
      "subId": "7004904",
      "subQuestName": "(test)教令院室内$UNRELEASED",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "700490401"
        ],
        "dialogs": {
          "700490401": {
            "id": "700490401",
            "speakerId": 1014,
            "speakerName": "珐露珊",
            "text": "……$UNRELEASED",
            "nextDialogs": [
              "700490402"
            ]
          },
          "700490402": {
            "id": "700490402",
            "speakerId": 1015,
            "speakerName": "信使",
            "text": "珐露珊导师！有学生来信！$UNRELEASED",
            "nextDialogs": [
              "700490403"
            ]
          },
          "700490403": {
            "id": "700490403",
            "speakerId": 1014,
            "speakerName": "珐露珊",
            "text": "哦？是来报名听我的课的吗？快让我看看！$UNRELEASED",
            "nextDialogs": [
              "700490404"
            ]
          },
          "700490404": {
            "id": "700490404",
            "speakerId": 1016,
            "speakerName": "言辞诚恳的来信",
            "text": "「珐露珊前辈，首先感谢您的邀请…我考虑了很久，还是想往妙论派的方向努力！」$UNRELEASED",
            "nextDialogs": [
              "700490405"
            ]
          },
          "700490405": {
            "id": "700490405",
            "speakerId": 1017,
            "speakerName": "字迹恭敬的来信",
            "text": "「前辈好，虽然我对古代机关文献解读也很有兴趣，但知论派主要的研究方向就已经很耗精力…」$UNRELEASED",
            "nextDialogs": [
              "700490406"
            ]
          },
          "700490406": {
            "id": "700490406",
            "speakerId": 1014,
            "speakerName": "珐露珊",
            "text": "…方向…$UNRELEASED",
            "nextDialogs": [
              "700490407"
            ]
          },
          "700490407": {
            "id": "700490407",
            "speakerId": 1018,
            "speakerName": "来自化城郭的来信$UNRELEASED",
            "text": "「抱歉！珐露珊前辈，我还想再跟师父学习一段时间…」$UNRELEASED",
            "nextDialogs": [
              "700490408"
            ]
          },
          "700490408": {
            "id": "700490408",
            "speakerId": 1014,
            "speakerName": "珐露珊",
            "text": "哎…方向，方向，年轻人，都有自己的方向…$UNRELEASED",
            "nextDialogs": [
              "700490409"
            ]
          },
          "700490409": {
            "id": "700490409",
            "speakerId": 1014,
            "speakerName": "珐露珊",
            "text": "……$UNRELEASED",
            "nextDialogs": [
              "700490410"
            ]
          },
          "700490410": {
            "id": "700490410",
            "speakerId": 1014,
            "speakerName": "珐露珊",
            "text": "…有方向好啊。$UNRELEASED",
            "nextDialogs": [
              "700490411"
            ]
          },
          "700490411": {
            "id": "700490411",
            "speakerId": 1019,
            "speakerName": "赛诺",
            "text": "人生方向，不「妨」多「想」。别让选择，成为遗憾。$UNRELEASED"
          }
        }
      }
    },
    {
      "subId": "7004905",
      "subQuestName": "(test)急冻树附近$UNRELEASED",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "700490501"
        ],
        "dialogs": {
          "700490501": {
            "id": "700490501",
            "speakerId": 1020,
            "speakerName": "主持人$UNRELEASED",
            "text": "…为了寻找传说中的宝藏，你们找到一位神情紧张的商人，她看起来格外警戒…$UNRELEASED",
            "nextDialogs": [
              "700490502"
            ]
          },
          "700490502": {
            "id": "700490502",
            "speakerId": 1021,
            "speakerName": "娜维娅",
            "text": "——我可以对她使用「说服」吗？$UNRELEASED",
            "nextDialogs": [
              "700490503"
            ]
          },
          "700490503": {
            "id": "700490503",
            "speakerId": 1020,
            "speakerName": "主持人$UNRELEASED",
            "text": "…商人指引着你们踏上旅途，但一个凶神恶煞的重甲蟹拦在了你们面前。$UNRELEASED",
            "nextDialogs": [
              "700490504"
            ]
          },
          "700490504": {
            "id": "700490504",
            "speakerId": 1021,
            "speakerName": "娜维娅",
            "text": "——我可以对它使用「说服」吗？$UNRELEASED",
            "nextDialogs": [
              "700490505"
            ]
          },
          "700490505": {
            "id": "700490505",
            "speakerId": 1020,
            "speakerName": "主持人$UNRELEASED",
            "text": "…凭借重甲蟹交代的线索，你们终于找到了宝藏，但一株身缠寒气的急冻树正盘踞于上。$UNRELEASED",
            "nextDialogs": [
              "700490506"
            ]
          },
          "700490506": {
            "id": "700490506",
            "speakerId": 1021,
            "speakerName": "娜维娅",
            "text": "——我可以对它使用「说服」吗！$UNRELEASED",
            "nextDialogs": [
              "700490507"
            ]
          },
          "700490507": {
            "id": "700490507",
            "speakerId": 1022,
            "speakerName": "芙宁娜",
            "text": "等等等一下！再怎么说也不可能对植物用「说服」吧！$UNRELEASED",
            "nextDialogs": [
              "700490508"
            ]
          },
          "700490508": {
            "id": "700490508",
            "speakerId": 1021,
            "speakerName": "娜维娅",
            "text": "没问题！我这次有带「植物交谈」——啊，顺便一提检定牌还是二十。$UNRELEASED",
            "nextDialogs": [
              "700490509"
            ]
          },
          "700490509": {
            "id": "700490509",
            "speakerId": 1023,
            "speakerName": "克洛琳德",
            "text": "…好吧。急冻树羞愧地钻进地里，向你们交出了宝藏。$UNRELEASED",
            "nextDialogs": [
              "700490510"
            ]
          },
          "700490510": {
            "id": "700490510",
            "speakerId": 1024,
            "speakerName": "林尼",
            "text": "——自由冒险，欢乐无限！$UNRELEASED",
            "nextDialogs": [
              "700490511"
            ]
          },
          "700490511": {
            "id": "700490511",
            "speakerId": 1025,
            "speakerName": "琳妮特",
            "text": "…桌上剧团，等你来玩。$UNRELEASED"
          }
        }
      }
    }
  ]
}
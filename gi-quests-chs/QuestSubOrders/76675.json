    {
      "subId": "7667501",
      "subQuestName": "在西风戍垒与法尔伽对话",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "766750101"
        ],
        "dialogs": {
          "766750101": {
            "id": "766750101",
            "speakerId": 1001,
            "speakerName": "法尔伽",
            "text": "…北方有纳尼娜看着，东边就让洛朗去吧…嗯，就先这样。",
            "nextDialogs": [
              "766750102"
            ]
          },
          "766750102": {
            "id": "766750102",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "你好呀，法尔伽！",
            "nextDialogs": [
              "766750103"
            ]
          },
          "766750103": {
            "id": "766750103",
            "speakerId": 1001,
            "speakerName": "法尔伽",
            "text": "哦？荣誉骑士和派蒙？怎么逛到这营地来了？",
            "nextDialogs": [
              "766750106"
            ]
          },
          "766750106": {
            "id": "766750106",
            "speakerId": 1001,
            "speakerName": "法尔伽",
            "text": "没有的事，西风骑士团的营地，就是荣誉骑士的营地，你直接把这儿当成家就好。",
            "nextDialogs": [
              "766750107"
            ]
          },
          "766750107": {
            "id": "766750107",
            "speakerId": 1001,
            "speakerName": "法尔伽",
            "text": "不过下次过来也可以提前打声招呼，我好让后勤班多准备点好酒好菜来招待你。",
            "nextDialogs": [
              "766750108"
            ]
          },
          "766750108": {
            "id": "766750108",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "这里就是远征军的营地吗，人比想象的要少欸…",
            "nextDialogs": [
              "766750109"
            ]
          },
          "766750109": {
            "id": "766750109",
            "speakerId": 1001,
            "speakerName": "法尔伽",
            "text": "远征军里留在这的人不多。剩下的人也被分配到各处巡逻，要说的话…呵，确实有点冷清。",
            "nextDialogs": [
              "766750110"
            ]
          },
          "766750110": {
            "id": "766750110",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "剩下的人都在做什么？",
            "nextDialogs": [
              "766750111"
            ]
          },
          "766750111": {
            "id": "766750111",
            "speakerId": 1001,
            "speakerName": "法尔伽",
            "text": "收集跟深渊相关的各项情报，当然，目前主要是在应付狂猎。",
            "nextDialogs": [
              "766750112"
            ]
          },
          "766750112": {
            "id": "766750112",
            "speakerId": 1001,
            "speakerName": "法尔伽",
            "text": "收集挪德卡莱各地的情报。虽然雷利尔已经被封印了，但这里的风波还没有彻底平息。",
            "nextDialogs": [
              "766750113"
            ]
          },
          "766750113": {
            "id": "766750113",
            "speakerId": 1001,
            "speakerName": "法尔伽",
            "text": "收集跟深渊相关的各项情报。虽然挪德卡莱暂时安稳了些，但还是得警惕深渊卷土重来。",
            "nextDialogs": [
              "766750114"
            ]
          },
          "766750114": {
            "id": "766750114",
            "speakerId": 1001,
            "speakerName": "法尔伽",
            "text": "情报是行军的基础，不只是敌人的动向，还有地理环境、天气变化，都能成为左右战局的胜负手。",
            "nextDialogs": [
              "766750115"
            ]
          },
          "766750115": {
            "id": "766750115",
            "speakerId": 1001,
            "speakerName": "法尔伽",
            "text": "往后西风骑士团还打算跟北大陆情报网建立长期合作，把这个临时驻地变成一个情报站点。",
            "nextDialogs": [
              "766750116"
            ]
          },
          "766750116": {
            "id": "766750116",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "情、情报站点？难道是枫丹谍战小说里的那种…",
            "nextDialogs": [
              "766750117"
            ]
          },
          "766750117": {
            "id": "766750117",
            "speakerId": 1001,
            "speakerName": "法尔伽",
            "text": "哈哈，怎么可能呢！你在那种书里见过这么不设防的营地吗？",
            "nextDialogs": [
              "766750118"
            ]
          },
          "766750118": {
            "id": "766750118",
            "speakerId": 1001,
            "speakerName": "法尔伽",
            "text": "这些年里我们一路远征，发现提瓦特各地都出现过不同的深渊灾害。它们狡猾异常、形态多变。",
            "nextDialogs": [
              "766750119"
            ]
          },
          "766750119": {
            "id": "766750119",
            "speakerId": 1001,
            "speakerName": "法尔伽",
            "text": "我希望通过北大陆情报网把远征军的见闻分享出去，也希望继续借此收集深渊的资料。",
            "nextDialogs": [
              "766750120"
            ]
          },
          "766750120": {
            "id": "766750120",
            "speakerId": 1001,
            "speakerName": "法尔伽",
            "text": "对抗深渊可不是一国一家的事。每天都有无数阵风吹进吹出的挪德卡莱…应该是最适合设立这站点的地方吧。",
            "nextDialogs": [
              "766750121"
            ]
          },
          "766750121": {
            "id": "766750121",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "原来是这样…这就是「骑士精神」吧！",
            "nextDialogs": [
              "766750122"
            ]
          },
          "766750122": {
            "id": "766750122",
            "speakerId": 1001,
            "speakerName": "法尔伽",
            "text": "「精神」是挺好，但现实嘛…现在这个站点才刚建立没多久，连周边的地形情报都还不完整。",
            "nextDialogs": [
              "766750123"
            ]
          },
          "766750123": {
            "id": "766750123",
            "speakerId": 1001,
            "speakerName": "法尔伽",
            "text": "#{NICKNAME}，你要是在附近收集到建材、情报什么的，也记得顺手带些回来？",
            "nextDialogs": [
              "766750124"
            ]
          },
          "766750124": {
            "id": "766750124",
            "speakerId": 1001,
            "speakerName": "法尔伽",
            "text": "放心，西风骑士团绝对不会亏待自家的「荣誉骑士」。",
            "nextDialogs": [
              "766750125"
            ]
          },
          "766750125": {
            "id": "766750125",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "包在我身上！",
            "nextDialogs": [
              "766750126"
            ]
          },
          "766750126": {
            "id": "766750126",
            "speakerId": 1001,
            "speakerName": "法尔伽",
            "text": "呵，又是一场新的「远征」啊。",
            "nextDialogs": [
              "766750127"
            ]
          },
          "766750127": {
            "id": "766750127",
            "speakerId": 1002,
            "speakerName": "温弗里德",
            "text": "大——大团长！不好了大团长！",
            "nextDialogs": [
              "766750128"
            ]
          },
          "766750128": {
            "id": "766750128",
            "speakerId": 1001,
            "speakerName": "法尔伽",
            "text": "嗯？什么情况？",
            "nextDialogs": [
              "766750129"
            ]
          },
          "766750129": {
            "id": "766750129",
            "speakerId": 1002,
            "speakerName": "温弗里德",
            "text": "今天预定要来的那位客人…被困在山下了！",
            "nextDialogs": [
              "766750130"
            ]
          },
          "766750130": {
            "id": "766750130",
            "speakerId": 1001,
            "speakerName": "法尔伽",
            "text": "什么！难道是…那位客人？",
            "nextDialogs": [
              "766750131"
            ]
          },
          "766750131": {
            "id": "766750131",
            "speakerId": 1002,
            "speakerName": "温弗里德",
            "text": "对！就是他！我们的人手都还在其他地方巡逻，现在该从哪里调派…",
            "nextDialogs": [
              "766750132"
            ]
          },
          "766750132": {
            "id": "766750132",
            "speakerId": 1001,
            "speakerName": "法尔伽",
            "text": "——不用调人了！你指个路，我亲自去！两位，我们回头再见！",
            "nextDialogs": [
              "766750133"
            ]
          },
          "766750133": {
            "id": "766750133",
            "speakerId": 1003,
            "speakerName": "Black Screen",
            "text": "法尔伽风风火火地离开了…",
            "nextDialogs": [
              "766750134"
            ]
          },
          "766750134": {
            "id": "766750134",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "…呜哇，头一次见法尔伽这么紧张…那位客人究竟是什么来头？",
            "nextDialogs": [
              "766750135"
            ]
          },
          "766750135": {
            "id": "766750135",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "难道是…重要线人？",
            "nextDialogs": [
              "766750136"
            ]
          },
          "766750136": {
            "id": "766750136",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "感觉有可能！我们也跟上去帮把手吧！"
          }
        }
      }
    },

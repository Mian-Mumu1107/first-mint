      }
    },
    {
      "subId": "7667504",
      "subQuestName": "查看「重要人物」的情况",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "766750401"
        ],
        "dialogs": {
          "766750401": {
            "id": "766750401",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "——嘿，你没事吧？",
            "nextDialogs": [
              "766750402"
            ]
          },
          "766750402": {
            "id": "766750402",
            "speakerId": 1004,
            "speakerName": "杜纳塔斯",
            "text": "没、没事…呼，还好你们来得及时，要不然就真赶不上日落了。",
            "nextDialogs": [
              "766750403"
            ]
          },
          "766750403": {
            "id": "766750403",
            "speakerId": 1001,
            "speakerName": "法尔伽",
            "text": "…万幸，看起来我们的「重要物资」没出什么大事。",
            "nextDialogs": [
              "766750404"
            ]
          },
          "766750404": {
            "id": "766750404",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "呃，是什么物资这么重要…",
            "nextDialogs": [
              "766750407"
            ]
          },
          "766750407": {
            "id": "766750407",
            "speakerId": 1001,
            "speakerName": "法尔伽",
            "text": "好眼光——这是我们从晨曦酒庄专门订购的蒲公英酒！最纯正的蒙德风味！",
            "nextDialogs": [
              "766750408"
            ]
          },
          "766750408": {
            "id": "766750408",
            "speakerId": 1004,
            "speakerName": "杜纳塔斯",
            "text": "一路从蒙德运过来，可费了我们好大的劲呢。",
            "nextDialogs": [
              "766750409"
            ]
          },
          "766750409": {
            "id": "766750409",
            "speakerId": 1001,
            "speakerName": "法尔伽",
            "text": "哈哈，辛苦了老板！晚上的酒会，你也来喝一杯吧？我们可都盼着你来呢！",
            "nextDialogs": [
              "766750410"
            ]
          },
          "766750410": {
            "id": "766750410",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "…所以你之前这么着急，就只是为了赶晚上的酒会？难得看你正经一次，居然还是为了这么不正经的事…",
            "nextDialogs": [
              "766750411"
            ]
          },
          "766750411": {
            "id": "766750411",
            "speakerId": 1001,
            "speakerName": "法尔伽",
            "text": "嗯？喝酒不就是一等一的正经事吗？我都想现在就来上一杯了。",
            "nextDialogs": [
              "766750412"
            ]
          },
          "766750412": {
            "id": "766750412",
            "speakerId": 1004,
            "speakerName": "杜纳塔斯",
            "text": "等、等一等——现在恐怕不太方便！",
            "nextDialogs": [
              "766750413"
            ]
          },
          "766750413": {
            "id": "766750413",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "是啊是啊，起码先干正事…",
            "nextDialogs": [
              "766750414"
            ]
          },
          "766750414": {
            "id": "766750414",
            "speakerId": 1004,
            "speakerName": "杜纳塔斯",
            "text": "这酒是特殊定制的，需要长时间滚动防止沉淀来保持口感！现在静置了这么久，估计口感…起码打了九折！",
            "nextDialogs": [
              "766750415"
            ]
          },
          "766750415": {
            "id": "766750415",
            "speakerId": 1001,
            "speakerName": "法尔伽",
            "text": "九折？可恶！那可绝对不能现在喝了。",
            "nextDialogs": [
              "766750416"
            ]
          },
          "766750416": {
            "id": "766750416",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "…行吧，你们高兴就好。",
            "nextDialogs": [
              "766750417"
            ]
          },
          "766750417": {
            "id": "766750417",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "要怎么恢复口感？",
            "nextDialogs": [
              "766750418"
            ]
          },
          "766750418": {
            "id": "766750418",
            "speakerId": 1004,
            "speakerName": "杜纳塔斯",
            "text": "我们原本专门找人造了滚动酒桶的机关…不过刚刚像是摔坏了，现在么…估计只能靠人力让它滚起来了吧。",
            "nextDialogs": [
              "766750419"
            ]
          },
          "766750419": {
            "id": "766750419",
            "speakerId": 1001,
            "speakerName": "法尔伽",
            "text": "唔，所以是要<color=#00E1FFFF>持续打击木桶，让它滚动到目的地</color>吗…听起来很像西风骑士团的传统力量训练啊。",
            "nextDialogs": [
              "766750420"
            ]
          },
          "766750420": {
            "id": "766750420",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "西风骑士团还有这训练项目？",
            "nextDialogs": [
              "766750421"
            ]
          },
          "766750421": {
            "id": "766750421",
            "speakerId": 1001,
            "speakerName": "法尔伽",
            "text": "嗯，这种训练既要控制出手的力度，又要控制打击的角度，提防木桶偏离路线。是许多骑士的入门训练。"
          }
        }
      }
    },

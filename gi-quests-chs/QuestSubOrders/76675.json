        ],
        "dialogs": {
          "766750601": {
            "id": "766750601",
            "speakerId": 1001,
            "speakerName": "法尔伽",
            "text": "嗯？需要我帮你把酒桶复位吗？还是想要闲聊？",
            "nextDialogs": [
              "766750603",
              "766750605"
            ]
          },
          "766750603": {
            "id": "766750603",
            "speakerId": 1001,
            "speakerName": "法尔伽",
            "text": "好嘞，别放弃，再来一次！"
          },
          "766750605": {
            "id": "766750605",
            "speakerId": 1001,
            "speakerName": "法尔伽",
            "text": "头一次让雷泽尝试这项训练的时候，他花了整整一天才完成。你猜是为什么？",
            "nextDialogs": [
              "766750606"
            ]
          },
          "766750606": {
            "id": "766750606",
            "speakerId": 1001,
            "speakerName": "法尔伽",
            "text": "——其中有四分之一天用来移动木桶，四分之三天用来理解我在说什么。"
          }
        }
      }
    },
    {
      "subId": "7667507",
      "subQuestName": "运送酒桶",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "766750701"
        ],
        "dialogs": {
          "766750701": {
            "id": "766750701",
            "speakerId": 1001,
            "speakerName": "法尔伽",
            "text": "嗯？需要我帮你把酒桶复位吗？还是想要闲聊？",
            "nextDialogs": [
              "766750703",
              "766750705"
            ]
          },
          "766750703": {
            "id": "766750703",
            "speakerId": 1001,
            "speakerName": "法尔伽",
            "text": "好嘞，别放弃，再来一次！"
          },
          "766750705": {
            "id": "766750705",
            "speakerId": 1001,
            "speakerName": "法尔伽",
            "text": "关于「火花骑士」需不需要参与这些基础训练，琴和阿贝多曾经认真找我讨论过。",
            "nextDialogs": [
              "766750706"
            ]
          },
          "766750706": {
            "id": "766750706",
            "speakerId": 1001,
            "speakerName": "法尔伽",
            "text": "基本的骑士训练有助于培养品性…但「火花骑士」毕竟年纪尚小…所以我决定听取她本人的意见。",
            "nextDialogs": [
              "766750707"
            ]
          },
          "766750707": {
            "id": "766750707",
            "speakerId": 1001,
            "speakerName": "法尔伽",
            "text": "…于是她开开心心地带着炸弹去了训练场。结果我们一致同意，在她稍微再长大一点之前，不再讨论这个议题。"
          }
        }
      }
    },
    {
      "subId": "7667508",
      "subQuestName": "运送酒桶",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "766750801"
        ],
        "dialogs": {
          "766750801": {
            "id": "766750801",
            "speakerId": 1001,
            "speakerName": "法尔伽",
            "text": "嗯？需要我帮你把酒桶复位吗？还是想要闲聊？",
            "nextDialogs": [
              "766750803",
              "766750805"
            ]
          },
          "766750803": {
            "id": "766750803",
            "speakerId": 1001,
            "speakerName": "法尔伽",
            "text": "好嘞，别放弃，再来一次！"
          },
          "766750805": {
            "id": "766750805",
            "speakerId": 1001,
            "speakerName": "法尔伽",
            "text": "说起来，你应该还没见过洛恩吧？那小子我行我素惯了，到了训练的日子也不见人影。",
            "nextDialogs": [
              "766750806"
            ]
          },
          "766750806": {
            "id": "766750806",
            "speakerId": 1001,
            "speakerName": "法尔伽",
            "text": "后来一问，他说自己跑去捅魔物的老巢了，至于木桶训练嘛…不会还手的目标，他没兴趣。"
          }
        }
      }
    },
    {
      "subId": "7667509",
      "subQuestName": "与骑士们交谈",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "766750901"
        ],
        "dialogs": {
          "766750901": {
            "id": "766750901",
            "speakerId": 1002,
            "speakerName": "温弗里德",
            "text": "啊！大团长！荣誉骑士！他们回来了——",
            "nextDialogs": [
              "766750902"
            ]
          },
          "766750902": {
            "id": "766750902",
            "speakerId": 1005,
            "speakerName": "艾克贝特",
            "text": "回来了——他们回来了——大家！快来迎接！",
            "nextDialogs": [
              "766750903"
            ]
          },
          "766750903": {
            "id": "766750903",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "哇呜，居然这么受欢迎…还真有点不好意思呢。",
            "nextDialogs": [
              "766750904"
            ]
          },
          "766750904": {
            "id": "766750904",
            "speakerId": 1006,
            "speakerName": "莱夫赫姆",
            "text": "——我隔着几百米就从风里闻出来了！是蒲公英酒的味道！",
            "nextDialogs": [
              "766750905"
            ]
          },
          "766750905": {
            "id": "766750905",
            "speakerId": 1002,
            "speakerName": "温弗里德",
            "text": "还是晨曦酒庄出产的特制品！回来了…我的回忆…全都回来了！",
            "nextDialogs": [
              "766750906"
            ]
          },
          "766750906": {
            "id": "766750906",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "呃…所以你们迎接的对象不是我们吧…",
            "nextDialogs": [
              "766750907"
            ]
          },
          "766750907": {
            "id": "766750907",
            "speakerId": 1005,
            "speakerName": "艾克贝特",
            "text": "嗯…就是这个味道…跟记忆里的一模一样！",
            "nextDialogs": [
              "766750908"
            ]
          },
          "766750908": {
            "id": "766750908",
            "speakerId": 1006,
            "speakerName": "莱夫赫姆",
            "text": "真好啊，这么多年了…",
            "nextDialogs": [
              "766750909"
            ]
          },
          "766750909": {
            "id": "766750909",
            "speakerId": 1002,
            "speakerName": "温弗里德",
            "text": "我还以为，自己已经忘记晨曦酒庄的酒是什么味道的了。",
            "nextDialogs": [
              "766750910"
            ]
          },
          "766750910": {
            "id": "766750910",
            "speakerId": 1005,
            "speakerName": "艾克贝特",
            "text": "酒的味道没变…那清泉镇的老家，应该也什么都没变吧？应该…",
            "nextDialogs": [
              "766750913"
            ]
          },
          "766750913": {
            "id": "766750913",
            "speakerId": 1005,
            "speakerName": "艾克贝特",
            "text": "…谢谢你，荣誉骑士！",
            "nextDialogs": [
              "766750914"
            ]
          },
          "766750914": {
            "id": "766750914",
            "speakerId": 1001,
            "speakerName": "法尔伽",
            "text": "…好了，别那么激动，还有人没回营吧？等人齐了再开封。你们先去做酒会的准备吧。",
            "nextDialogs": [
              "766750915"
            ]
          },
          "766750915": {
            "id": "766750915",
            "speakerId": 1002,
            "speakerName": "温弗里德",
            "text": "是！我们这就去准备！",
            "nextDialogs": [
              "766750916"
            ]
          },
          "766750916": {
            "id": "766750916",
            "speakerId": 1001,
            "speakerName": "法尔伽",
            "text": "…看，我说过的吧：喝酒可是一等一的正经事。",
            "nextDialogs": [
              "766750917"
            ]
          },
          "766750917": {
            "id": "766750917",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "呜呜…蜜酱胡萝卜煎肉…甜甜花酿鸡…居然能在这吃到这么正宗的蒙德菜…",
            "nextDialogs": [
              "766750918"
            ]
          },
          "766750918": {
            "id": "766750918",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "咦…法尔伽呢？好像没看到他？总不能是在哪个角落里喝到醉了吧？"
          }
        }
      }
    },

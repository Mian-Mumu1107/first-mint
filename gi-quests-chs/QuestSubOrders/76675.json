    {
      "subId": "7667505",
      "subQuestName": "运送酒桶",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "766750501"
        ],
        "dialogs": {
          "766750501": {
            "id": "766750501",
            "speakerId": 1001,
            "speakerName": "法尔伽",
            "text": "嗯？需要我帮你把酒桶复位吗？还是想要闲聊？",
            "nextDialogs": [
              "766750503",
              "766750505"
            ]
          },
          "766750503": {
            "id": "766750503",
            "speakerId": 1001,
            "speakerName": "法尔伽",
            "text": "好嘞，别放弃，再来一次！"
          },
          "766750505": {
            "id": "766750505",
            "speakerId": 1001,
            "speakerName": "法尔伽",
            "text": "之前教导诺艾尔的时候，她一紧张就会把木桶打碎一地，然后说什么也要独自打扫干净。",
            "nextDialogs": [
              "766750506"
            ]
          },
          "766750506": {
            "id": "766750506",
            "speakerId": 1001,
            "speakerName": "法尔伽",
            "text": "时间一久…她打扫清理的本领，就冠绝整个骑士团了。呵，虽然她本人也没意识到，这其实也是一种「进步」。"
          }
        }
      }
    },
    {
      "subId": "7667506",
      "subQuestName": "运送酒桶",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [

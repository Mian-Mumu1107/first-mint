      }
    },
    {
      "subId": "2103702",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "210370201"
        ],
        "dialogs": {
          "210370201": {
            "id": "210370201",
            "speakerId": 1000,
            "speakerName": "孙宇",
            "text": "旅行者，你帮我把土取回来了吗？",
            "nextDialogs": [
              "210370202"
            ]
          },
          "210370202": {
            "id": "210370202",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "取回来了。"
          }
        }
      }
    },
    {
      "subId": "2103705",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "210370501"
        ],
        "dialogs": {
          "210370501": {
            "id": "210370501",
            "speakerId": 1000,
            "speakerName": "孙宇",
            "text": "所以这件取土的事，就拜托你了，旅行者。"
          }
        }
      }
    }
  ]
}
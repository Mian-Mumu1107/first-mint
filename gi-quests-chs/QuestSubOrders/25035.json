            "id": "250350201",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "按照标记…快件应该就在附近了。",
            "nextDialogs": [
              "250350202"
            ]
          },
          "250350202": {
            "id": "250350202",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "我们仔细在周围找一找吧，唔…会在哪里呢…"
          }
        }
      }
    },

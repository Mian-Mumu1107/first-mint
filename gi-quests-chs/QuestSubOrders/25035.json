        "dialogs": {
          "250351101": {
            "id": "250351101",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "再见。",
            "nextDialogs": [
              "250351102"
            ]
          },
          "250351102": {
            "id": "250351102",
            "speakerId": 1000,
            "speakerName": "米齐卡",
            "text": "寻找快件的事就拜托了，我还要整理店里的快件。唉…那群小子什么时候能稳重点…"
          }
        }
      }

            "nextDialogs": [
              "701440103"
            ]
          },
          "701440103": {
            "id": "701440103",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "有这些发现。",
            "nextDialogs": [
              "701440104"
            ]
          },
          "701440104": {
            "id": "701440104",
            "speakerId": 1000,
            "speakerName": "玉霞",
            "text": "这种东西是什么时候出现在雪山里的…",
            "nextDialogs": [
              "701440105"
            ]
          },
          "701440105": {
            "id": "701440105",
            "speakerId": 1000,
            "speakerName": "玉霞",
            "text": "谢谢你帮忙调查，我会向协会报告这件事的，这些报酬给你，辛苦了。"
          }
        }

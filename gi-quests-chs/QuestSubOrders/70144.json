              "701440211",
              "701440213"
            ]
          },
          "701440211": {
            "id": "701440211",
            "speakerId": 1000,
            "speakerName": "玉霞",
            "text": "那就拜托你了，那股严寒十分诡异，请一定要做好准备。",
            "nextDialogs": [
              "701440215"
            ]
          },
          "701440215": {
            "id": "701440215",
            "speakerId": 1000,
            "speakerName": "玉霞",
            "text": "那么，就请你快去那里调查一下吧，拜托你了。"
          },
          "701440213": {
            "id": "701440213",
            "speakerId": 1000,
            "speakerName": "玉霞",
            "text": "喔？你倒是很直接嘛。放心吧，协会可不会亏待冒险家，我会准备好报酬，在营地等着你的。",
            "nextDialogs": [
              "701440214"
            ]
          },
          "701440214": {
            "id": "701440214",
            "speakerId": 1000,
            "speakerName": "玉霞",
            "text": "至于具体的数目…那就要视你带回来的调查结果而定了，规矩你懂的，对吧？"
          }
        }

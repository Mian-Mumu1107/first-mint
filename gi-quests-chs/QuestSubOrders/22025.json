  "subQuests": [
    {
      "subId": "2202501",
      "subQuestName": "与汤雯对话",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "220250101"
        ],
        "dialogs": {
          "220250101": {
            "id": "220250101",
            "speakerId": 3022,
            "speakerName": "汤雯",
            "text": "啊...好饿...好难受…",
            "nextDialogs": [
              "220250102"
            ]
          },
          "220250102": {
            "id": "220250102",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "发生什么事了？",
            "nextDialogs": [
              "220250103"
            ]
          },
          "220250103": {
            "id": "220250103",
            "speakerId": 3022,
            "speakerName": "汤雯",
            "text": "我、我也不太清楚…总之就是整个人都不太精神。",
            "nextDialogs": [
              "220250104"
            ]
          },
          "220250104": {
            "id": "220250104",
            "speakerId": 3022,
            "speakerName": "汤雯",
            "text": "大概就是昨天晚上，我把你做的那份美食带回家好好品尝了一番。",
            "nextDialogs": [
              "220250105"
            ]
          },
          "220250105": {
            "id": "220250105",
            "speakerId": 3022,
            "speakerName": "汤雯",
            "text": "虽然那道菜的口味确实是…「另辟蹊径」了些，但多少还是能填饱肚子…",
            "nextDialogs": [
              "220250106"
            ]
          },
          "220250106": {
            "id": "220250106",
            "speakerId": 3022,
            "speakerName": "汤雯",
            "text": "之后我就打算睡个好觉，今天好好工作，结果…结果…",
            "nextDialogs": [
              "220250107"
            ]
          },
          "220250107": {
            "id": "220250107",
            "speakerId": 3022,
            "speakerName": "汤雯",
            "text": "每次我要睡着的时候，那道菜的微妙气味就突然从胃里反上来！搞得我瞬间就清醒了。",
            "nextDialogs": [
              "220250108"
            ]
          },
          "220250108": {
            "id": "220250108",
            "speakerId": 3022,
            "speakerName": "汤雯",
            "text": "然后就是这样的循环，一直半睡半醒地折腾到天亮…",
            "nextDialogs": [
              "220250109"
            ]
          },
          "220250109": {
            "id": "220250109",
            "speakerId": 3022,
            "speakerName": "汤雯",
            "text": "如果光是睡少一些，倒还不是什么大事，之前偶尔也会遇到加班加点的情况…",
            "nextDialogs": [
              "220250110"
            ]
          },
          "220250110": {
            "id": "220250110",
            "speakerId": 3022,
            "speakerName": "汤雯",
            "text": "关键是今天！本以为起来后，吃点东西就没事了，可没想到一吃东西，居然满嘴都还是那道菜的味道…",
            "nextDialogs": [
              "220250111"
            ]
          },
          "220250111": {
            "id": "220250111",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "那道菜有这么大威力吗…",
            "nextDialogs": [
              "220250112"
            ]
          },
          "220250112": {
            "id": "220250112",
            "speakerId": 3022,
            "speakerName": "汤雯",
            "text": "唉，不管怎么样，我现在感觉…应该只有口味独特的美食，才能冲刷掉那股奇怪的气息了…",
            "nextDialogs": [
              "220250113"
            ]
          },
          "220250113": {
            "id": "220250113",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "口味独特的美食？不如我们去问问其他人，什么才是口味独特的美食吧？",
            "nextDialogs": [
              "220250114"
            ]
          },
          "220250114": {
            "id": "220250114",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "然后再给汤雯小姐做一份…说不定就能解决她的困扰了！",
            "nextDialogs": [
              "220250115"
            ]
          },
          "220250115": {
            "id": "220250115",
            "speakerId": 3022,
            "speakerName": "汤雯",
            "text": "真的吗？真是太好了，实在感谢你们！如果、如果方便的话，请去离岛问问…",
            "nextDialogs": [
              "220250116"
            ]
          },
          "220250116": {
            "id": "220250116",
            "speakerId": 3022,
            "speakerName": "汤雯",
            "text": "我记得…离岛的商人李晓对美食就很有研究，还有楚瑜商行的秋月，她也算是半个美食家了！"
          }
        }
      }
    },
    {
      "subId": "2202502",
      "subQuestName": "问问李晓的意见",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "220250201"
        ],
        "dialogs": {
          "220250201": {
            "id": "220250201",
            "speakerId": 3071,
            "speakerName": "李晓",
            "text": "什么事？啊…你说汤雯小姐啊。",
            "nextDialogs": [
              "220250207"
            ]
          },
          "220250207": {
            "id": "220250207",
            "speakerId": 3071,
            "speakerName": "李晓",
            "text": "食欲不振...满嘴都是怪味...需要特别的美食才能拯救？",
            "nextDialogs": [
              "220250202"
            ]
          },
          "220250202": {
            "id": "220250202",
            "speakerId": 3071,
            "speakerName": "李晓",
            "text": "居然遇到了这样的困难…确实有些棘手啊。",
            "nextDialogs": [
              "220250203"
            ]
          },
          "220250203": {
            "id": "220250203",
            "speakerId": 3071,
            "speakerName": "李晓",
            "text": "不过依我看，倒不一定要特别名贵的菜，只要口感和风味独树一帜，再加上一些些的冲击力就足够了…",
            "nextDialogs": [
              "220250204"
            ]
          },
          "220250204": {
            "id": "220250204",
            "speakerId": 3071,
            "speakerName": "李晓",
            "text": "所以我的建议是——绝云锅巴！既有独特的劲脆口感，又有猛烈的香辣力道…",
            "nextDialogs": [
              "220250205"
            ]
          },
          "220250205": {
            "id": "220250205",
            "speakerId": 3071,
            "speakerName": "李晓",
            "text": "从当年在轻策庄第一次尝到绝云锅巴，已经过去十几年了，到现在我还时常想起它...",
            "nextDialogs": [
              "220250206"
            ]
          },
          "220250206": {
            "id": "220250206",
            "speakerId": 3071,
            "speakerName": "李晓",
            "text": "我想如果是绝云锅巴的话，无论什么问题都会迎刃而解的吧。"
          }
        }
      }
    },
    {
      "subId": "2202503",
      "subQuestName": "问问秋月的意见",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "220250301"
        ],
        "dialogs": {
          "220250301": {
            "id": "220250301",
            "speakerId": 3079,
            "speakerName": "秋月",
            "text": "什么事？欸…汤雯小姐吗？",
            "nextDialogs": [
              "220250307"
            ]
          },
          "220250307": {
            "id": "220250307",
            "speakerId": 3079,
            "speakerName": "秋月",
            "text": "满嘴怪味，没有食欲，吃不下饭？",
            "nextDialogs": [
              "220250302"
            ]
          },
          "220250302": {
            "id": "220250302",
            "speakerId": 3079,
            "speakerName": "秋月",
            "text": "真的是吃了不好的奇怪食物吗？没搞错吧？",
            "nextDialogs": [
              "220250303"
            ]
          },
          "220250303": {
            "id": "220250303",
            "speakerId": 3079,
            "speakerName": "秋月",
            "text": "怎么听起来感觉更像是吃撑了不消化呢。唔，让我想想...",
            "nextDialogs": [
              "220250304"
            ]
          },
          "220250304": {
            "id": "220250304",
            "speakerId": 3079,
            "speakerName": "秋月",
            "text": "算了，既然没法判断的话，就只有一道菜可以推荐了，那就是——腌笃鲜！",
            "nextDialogs": [
              "220250305"
            ]
          },
          "220250305": {
            "id": "220250305",
            "speakerId": 3079,
            "speakerName": "秋月",
            "text": "口味咸鲜，肉质酥嫩，爽口开胃，最后还有一锅老汤帮助消食。嗯！真想现在就来一点啊。",
            "nextDialogs": [
              "220250306"
            ]
          },
          "220250306": {
            "id": "220250306",
            "speakerId": 3079,
            "speakerName": "秋月",
            "text": "相信我，汤雯现在需要的就是腌笃鲜！"
          }
        }
      }
    },
    {
      "subId": "2202504",
      "subQuestName": "问问派蒙的意见",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "220250401"
        ],
        "dialogs": {
          "220250401": {
            "id": "220250401",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "呜哇，得到了不同的答案呢，绝云锅巴和腌笃鲜，都是很特别的美味呀。",
            "nextDialogs": [
              "220250402"
            ]
          },
          "220250402": {
            "id": "220250402",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "到底该做什么才好呢？好纠结！",
            "nextDialogs": [
              "220250403"
            ]
          },
          "220250403": {
            "id": "220250403",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "派蒙觉得应该做什么呢？",
            "nextDialogs": [
              "220250404"
            ]
          },
          "220250404": {
            "id": "220250404",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "欸？我吗？",
            "nextDialogs": [
              "220250405"
            ]
          },
          "220250405": {
            "id": "220250405",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "这样的话...让我选的话…让我选的话…",
            "nextDialogs": [
              "220250406"
            ]
          },
          "220250406": {
            "id": "220250406",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "我选烤吃虎鱼！",
            "nextDialogs": [
              "220250407"
            ]
          },
          "220250407": {
            "id": "220250407",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "烤吃虎鱼一听很有勇气的样子，如果汤雯小姐吃掉这种勇气，一定能顺利解决现在的麻烦吧？",
            "nextDialogs": [
              "220250410"
            ]
          },
          "220250410": {
            "id": "220250410",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "哎呀，所以说还是你来决定吧。"
          }
        }
      }
    },
    {
      "subId": "2202505",
      "subQuestName": "将美味的绝云锅巴送给汤雯",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "220250501"
        ],
        "dialogs": {
          "220250501": {
            "id": "220250501",
            "speakerId": 3022,
            "speakerName": "汤雯",
            "text": "啊，你们回来了。",
            "nextDialogs": [
              "220250502"
            ]
          },
          "220250502": {
            "id": "220250502",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "汤雯小姐，快看我们给你带来了什么？",
            "nextDialogs": [
              "220250503"
            ]
          },
          "220250503": {
            "id": "220250503",
            "speakerId": 3022,
            "speakerName": "汤雯",
            "text": "欸？好独特的香气…",
            "nextDialogs": [
              "220250504"
            ]
          },
          "220250504": {
            "id": "220250504",
            "speakerId": 3022,
            "speakerName": "汤雯",
            "text": "快！请让我尝一尝吧！"
          }
        }
      }
    },
    {
      "subId": "2202506",
      "subQuestName": "将美味的腌笃鲜送给汤雯",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "220250601"
        ],
        "dialogs": {
          "220250601": {
            "id": "220250601",
            "speakerId": 3022,
            "speakerName": "汤雯",
            "text": "这、这味道…清脆的口感、浓郁的香气混合着丝丝辛辣…",
            "nextDialogs": [
              "220250602"
            ]
          },
          "220250602": {
            "id": "220250602",
            "speakerId": 3022,
            "speakerName": "汤雯",
            "text": "嘴里的怪味也被冲洗得一干二净了。",
            "nextDialogs": [
              "220250603"
            ]
          },
          "220250603": {
            "id": "220250603",
            "speakerId": 3022,
            "speakerName": "汤雯",
            "text": "太好吃了！没想到身在异国他乡，还能尝到这种美味…",
            "nextDialogs": [
              "220250604"
            ]
          },
          "220250604": {
            "id": "220250604",
            "speakerId": 3022,
            "speakerName": "汤雯",
            "text": "这些是我的谢意，请不要推辞！"
          }
        }
      }
    },
    {

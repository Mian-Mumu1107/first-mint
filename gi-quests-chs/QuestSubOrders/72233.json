    {
      "subId": "7223308",
      "subQuestName": "与露子对话",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "722330301"
        ],
        "dialogs": {
          "722330301": {
            "id": "722330301",
            "speakerId": 3193,
            "speakerName": "露子",
            "text": "接下来就是解封之刻了，请你拿好之前的「月浴渊之钥」。",
            "nextDialogs": [
              "722330302"
            ]
          },
          "722330302": {
            "id": "722330302",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "你再说一遍。",
            "nextDialogs": [
              "722330303"
            ]
          },
          "722330303": {
            "id": "722330303",
            "speakerId": 3193,
            "speakerName": "露子",
            "text": "「月浴渊之钥」。",
            "nextDialogs": [
              "722330304"
            ]
          },
          "722330304": {
            "id": "722330304",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "你再说三遍。",
            "nextDialogs": [
              "722330305"
            ]
          },
          "722330305": {
            "id": "722330305",
            "speakerId": 3193,
            "speakerName": "露子",
            "text": "「月浴渊之钥」、「月浴渊之钥」、「哕浴腌之浴」…切，咬舌头了。",
            "nextDialogs": [
              "722330306"
            ]
          },
          "722330306": {
            "id": "722330306",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "所以你们这个命名肯定有问题啊。改个名字吧。",
            "nextDialogs": [
              "722330307"
            ]
          },
          "722330307": {
            "id": "722330307",
            "speakerId": 3193,
            "speakerName": "露子",
            "text": "就算要改也是几百年后的人受益啦。这次你就忍一下吧。",
            "nextDialogs": [
              "722330308"
            ]
          },
          "722330308": {
            "id": "722330308",
            "speakerId": 3193,
            "speakerName": "露子",
            "text": "咳咳，总、总之，我就要施行仪式了。",
            "nextDialogs": [
              "722330309"
            ]
          },
          "722330309": {
            "id": "722330309",
            "speakerId": 3193,
            "speakerName": "露子",
            "text": "十分可惜，我们并没有渊下宫试炼的具体细节，接下来您只能依赖自己了。",
            "nextDialogs": [
              "722330310"
            ]
          },
          "722330310": {
            "id": "722330310",
            "speakerId": 3193,
            "speakerName": "露子",
            "text": "这种保持神秘感的传统真是坏东西。所以我也只能祝您好运了。",
            "nextDialogs": [
              "722330311"
            ]
          },
          "722330311": {
            "id": "722330311",
            "speakerId": 3193,
            "speakerName": "露子",
            "text": "另外，请您千万不要逞强。您的安全是最重要的。"
          }
        }
      }

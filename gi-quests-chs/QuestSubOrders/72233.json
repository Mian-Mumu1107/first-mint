    {
      "subId": "7223304",
      "subQuestName": "寻找剩余的键纹$HIDDEN",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "722330401"
        ],
        "dialogs": {
          "722330401": {
            "id": "722330401",
            "speakerId": 3193,
            "speakerName": "露子",
            "text": "#{NICKNAME}，还有什么想问的吗？",
            "nextDialogs": [
              "722330403",
              "722330407"
            ]
          },
          "722330403": {
            "id": "722330403",
            "speakerId": 3193,
            "speakerName": "露子",
            "text": "键纹被我们放在了「海神之鳍」与「海神之心」处。",
            "nextDialogs": [
              "722330404"
            ]
          },
          "722330404": {
            "id": "722330404",
            "speakerId": 3193,
            "speakerName": "露子",
            "text": "其实我们也就是就近移开了一点。毕竟两处海神之伤也还算是比较隐秘的地方了。",
            "nextDialogs": [
              "722330405"
            ]
          },
          "722330405": {
            "id": "722330405",
            "speakerId": 3193,
            "speakerName": "露子",
            "text": "尽力了，真的。"
          },
          "722330407": {
            "id": "722330407",
            "speakerId": 3193,
            "speakerName": "露子",
            "text": "祭坛在北方和正东边。就在下面月浴渊的第二重山之垣上。",
            "nextDialogs": [
              "722330408"
            ]
          },
          "722330408": {
            "id": "722330408",
            "speakerId": 3193,
            "speakerName": "露子",
            "text": "如果你从珊瑚宫到「海神之鳍」与「海神之心」连两条线…",
            "nextDialogs": [
              "722330409"
            ]
          },
          "722330409": {
            "id": "722330409",
            "speakerId": 3193,
            "speakerName": "露子",
            "text": "再和二重垣的弧线取两个交点。就是这两处啦。"
          }
        }
      }
    },
    {
      "subId": "7223305",
      "subQuestName": "寻找剩余的键纹",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "722330501"
        ],
        "dialogs": {
          "722330501": {
            "id": "722330501",
            "speakerId": 3193,
            "speakerName": "露子",
            "text": "#{NICKNAME}，还有什么想问的吗？",
            "nextDialogs": [
              "722330502"
            ]
          },
          "722330502": {
            "id": "722330502",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "关于白夜国…",
            "nextDialogs": [
              "722330503"
            ]
          },
          "722330503": {
            "id": "722330503",
            "speakerId": 3193,
            "speakerName": "露子",
            "text": "渊下宫曾经的名字就叫做白夜国。因为地下之国并无日月，只有白夜和常夜两种天象。",
            "nextDialogs": [
              "722330504"
            ]
          },
          "722330504": {
            "id": "722330504",
            "speakerId": 3193,
            "speakerName": "露子",
            "text": "我的家系之中曾有一位名叫乌帽子的巫女，在白夜国历史里也算个人物，所以才让我负责「海祇御灵祭」。"
          }
        }
      }
    },

{
  "lineCounts": {
    "Player": 5,
    "达雅": 17
  },
  "subQuests": [
    {
      "subId": "7369001",
      "subQuestName": "与达雅对话",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "736900101"
        ],
        "dialogs": {
          "736900101": {
            "id": "736900101",
            "speakerId": 1000,
            "speakerName": "达雅",
            "text": "你好，我是刹诃伐罗学院的达雅！你也是来参加学院游乐会的吗？",
            "nextDialogs": [
              "736900102"
            ]
          },
          "736900102": {
            "id": "736900102",
            "speakerId": 1000,
            "speakerName": "达雅",
            "text": "这是我们学院推出的游玩项目：「通路计划」！",
            "nextDialogs": [
              "736900103"
            ]
          },
          "736900103": {
            "id": "736900103",
            "speakerId": 1000,
            "speakerName": "达雅",
            "text": "怎么样？要不要试着玩一玩呀？",
            "nextDialogs": [
              "736900104"
            ]
          },
          "736900104": {
            "id": "736900104",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "我记得刹诃伐罗学院是研究…",
            "nextDialogs": [
              "736900105"
            ]
          },
          "736900105": {
            "id": "736900105",
            "speakerId": 1000,
            "speakerName": "达雅",
            "text": "我们学院的研究很多都与机关和建筑有关。",
            "nextDialogs": [
              "736900107"
            ]
          },
          "736900107": {
            "id": "736900107",
            "speakerId": 1000,
            "speakerName": "达雅",
            "text": "咳，说远了…为了参与这次学院游乐会，我们学院里的很多学生群策群力…",
            "nextDialogs": [
              "736900108"
            ]
          },
          "736900108": {
            "id": "736900108",
            "speakerId": 1000,
            "speakerName": "达雅",
            "text": "最终，研究出了「通路计划」这个游玩项目！",
            "nextDialogs": [
              "736900109"
            ]
          },
          "736900109": {
            "id": "736900109",
            "speakerId": 1000,
            "speakerName": "达雅",
            "text": "简单来说，游玩者需要用我们已经准备好的各种物件搭建道路。",
            "nextDialogs": [
              "736900110"
            ]
          },
          "736900110": {
            "id": "736900110",
            "speakerId": 1000,
            "speakerName": "达雅",
            "text": "无论是架桥啦，铺梯啦…最终的目标，就是搭建出一条可以供人通行，并且直达终点的道路。",
            "nextDialogs": [
              "736900111"
            ]
          },
          "736900111": {
            "id": "736900111",
            "speakerId": 1000,
            "speakerName": "达雅",
            "text": "在搭建完毕后，我们还会进行一次最终检验…就像是验收搭建好的建筑一样。",
            "nextDialogs": [
              "736900112"
            ]
          },
          "736900112": {
            "id": "736900112",
            "speakerId": 1000,
            "speakerName": "达雅",
            "text": "总之，只要能搭建出一条安全的道路，就算是获胜啦。",
            "nextDialogs": [
              "736900115"
            ]
          },
          "736900115": {
            "id": "736900115",
            "speakerId": 1000,
            "speakerName": "达雅",
            "text": "哈哈哈，不用担心，这又不是在现实里建设建筑。",
            "nextDialogs": [
              "736900116"
            ]
          },
          "736900116": {
            "id": "736900116",
            "speakerId": 1000,
            "speakerName": "达雅",
            "text": "就算是搭建失误，道路垮塌了也没关系，只要重新搭建就好，我们也不会限定尝试次数的。",
            "nextDialogs": [
              "736900117"
            ]
          },
          "736900117": {
            "id": "736900117",
            "speakerId": 1000,
            "speakerName": "达雅",
            "text": "只要发挥想象力，搭出一条漂亮的道路就好啦！"
          }
        }
      }
    },
    {
      "subId": "7369099",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "736909901"
        ],
        "dialogs": {
          "736909901": {
            "id": "736909901",
            "speakerId": 1000,
            "speakerName": "达雅",
            "text": "（要是在现实里搞建筑也能这么轻松就好了，唉…）"
          }
        }
      }
    }
  ]
}
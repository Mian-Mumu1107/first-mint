    {
      "subId": "1010120",
      "subQuestName": "(test)与丽莎对话（隐藏）$HIDDEN",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "101012001"
        ],
        "dialogs": {
          "101012001": {
            "id": "101012001",
            "speakerId": 1007,
            "speakerName": "丽莎",
            "text": "应该就在这附近。",
            "nextDialogs": [
              "101012002"
            ]
          },
          "101012002": {
            "id": "101012002",
            "speakerId": 1007,
            "speakerName": "丽莎",
            "text": "在<color=#00E1FFFF>「元素视野」</color>下甚至都能看到<color=#00E1FFFF>魔力</color>的流动了。",
            "nextDialogs": [
              "101012003"
            ]
          },
          "101012003": {
            "id": "101012003",
            "speakerId": 1007,
            "speakerName": "丽莎",
            "text": "顺着<color=#00E1FFFF>魔力</color>流动的方向，去把书本找出来吧。"
          }
        }
      }
    },
    {

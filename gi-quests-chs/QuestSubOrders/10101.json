    {
      "subId": "1010108",
      "subQuestName": "(test)找到书本后的对话(隐藏)$HIDDEN",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "101010801"
        ],
        "dialogs": {
          "101010801": {
            "id": "101010801",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "是<color=#00E1FFFF>《白之公主与六侏儒》</color>！我记得这个名字，应该就是它了吧？",
            "nextDialogs": [
              "101010802"
            ]
          },
          "101010802": {
            "id": "101010802",
            "speakerId": 1007,
            "speakerName": "丽莎",
            "text": "是的哦，好在书本没有受到什么损坏呢，不然的话…",
            "nextDialogs": [
              "101010803"
            ]
          },
          "101010803": {
            "id": "101010803",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "不然的话？难道丽莎还有什么更厉害的惩罚方式…",
            "nextDialogs": [
              "101010804"
            ]
          },
          "101010804": {
            "id": "101010804",
            "speakerId": 1007,
            "speakerName": "丽莎",
            "text": "呵呵，那大概就要运用一些我在药剂学上的成果了呢。",
            "nextDialogs": [
              "101010805"
            ]
          },
          "101010805": {
            "id": "101010805",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "呜！",
            "nextDialogs": [
              "101010806"
            ]
          },
          "101010806": {
            "id": "101010806",
            "speakerId": 1007,
            "speakerName": "丽莎",
            "text": "不过话说回来，这本书根本不是「禁书区」的书，所以才会放心借给一般市民啊…",
            "nextDialogs": [
              "101010807"
            ]
          },
          "101010807": {
            "id": "101010807",
            "speakerId": 1007,
            "speakerName": "丽莎",
            "text": "除了我做的标记之外，也没有任何异常的元素波动。",
            "nextDialogs": [
              "101010808"
            ]
          },
          "101010808": {
            "id": "101010808",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "是喔。感觉完完全全只是一本普通的童话书而已嘛。",
            "nextDialogs": [
              "101010810"
            ]
          },
          "101010810": {
            "id": "101010810",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "（很神秘，令人好奇…）",
            "nextDialogs": [
              "101010811"
            ]
          },
          "101010811": {
            "id": "101010811",
            "speakerId": 1007,
            "speakerName": "丽莎",
            "text": "从图书管理员的角度来看，麻烦的工作已经做完啦。",
            "nextDialogs": [
              "101010812"
            ]
          },
          "101010812": {
            "id": "101010812",
            "speakerId": 1007,
            "speakerName": "丽莎",
            "text": "既然对这本书这么感兴趣，不如转借给你？"
          }
        }
      }
    },
    {
      "subId": "1010122",

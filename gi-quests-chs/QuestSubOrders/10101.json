    {
      "subId": "1010110",
      "subQuestName": "(test)与丽莎对话（隐藏）$HIDDEN",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "101011001"
        ],
        "dialogs": {
          "101011001": {
            "id": "101011001",
            "speakerId": 1007,
            "speakerName": "丽莎",
            "text": "嗯？你们回来啦。书的保管手续已经办好了。",
            "nextDialogs": [
              "101011002"
            ]
          },
          "101011002": {
            "id": "101011002",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "谢谢丽莎小姐！",
            "nextDialogs": [
              "101011003"
            ]
          },
          "101011003": {
            "id": "101011003",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "嗯…不过总感觉还忘记了什么事…",
            "nextDialogs": [
              "101011007",
              "101011006"
            ]
          },
          "101011007": {
            "id": "101011007",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "——啊！那边架子上放着的…不就是<color=#00E1FFFF>《提瓦特游览指南》</color>吗？",
            "nextDialogs": [
              "101011008"
            ]
          },
          "101011008": {
            "id": "101011008",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "而且有好多本的样子！",
            "nextDialogs": [
              "101011009"
            ]
          },
          "101011009": {
            "id": "101011009",
            "speakerId": 1007,
            "speakerName": "丽莎",
            "text": "呵呵呵…其实<color=#00E1FFFF>《提瓦特游览指南》</color>是一种期刊，也不算是正式的馆藏…",
            "nextDialogs": [
              "101011010"
            ]
          },
          "101011010": {
            "id": "101011010",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "唔…唔？！",
            "nextDialogs": [
              "101011011"
            ]
          },
          "101011011": {
            "id": "101011011",
            "speakerId": 1007,
            "speakerName": "丽莎",
            "text": "拿一本去吧，算是今天作为我助手的酬劳。",
            "nextDialogs": [
              "101011012"
            ]
          },
          "101011012": {
            "id": "101011012",
            "speakerId": 1007,
            "speakerName": "丽莎",
            "text": "今天有你陪同，麻烦的工作稍微变得不那么枯燥了呢。",
            "nextDialogs": [
              "101011013"
            ]
          },
          "101011013": {
            "id": "101011013",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "原来《提瓦特游览指南》只是抓人打工的鱼饵吗！",
            "nextDialogs": [
              "101011014"
            ]
          },
          "101011014": {
            "id": "101011014",
            "speakerId": 1007,

    {
      "subId": "1010114",
      "subQuestName": "(test)发现副本后让丽莎消失（隐藏）$HIDDEN",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "101010701"
        ],
        "dialogs": {
          "101010701": {
            "id": "101010701",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "居然是住在<color=#00E1FFFF>遗迹</color>里的吗？蒙德人偶尔也有奇怪的癖好呢。",
            "nextDialogs": [
              "101010702"
            ]
          },
          "101010702": {
            "id": "101010702",
            "speakerId": 1007,
            "speakerName": "丽莎",
            "text": "请不要这么随意揣测蒙德人的居住习惯。",
            "nextDialogs": [
              "101010703"
            ]
          },
          "101010703": {
            "id": "101010703",
            "speakerId": 1007,
            "speakerName": "丽莎",
            "text": "我倒是觉得更像那些不讨人喜欢的「捣乱分子」的作风呢。",
            "nextDialogs": [
              "101010705",
              "101010708",
              "101010710"
            ]
          },
          "101010705": {
            "id": "101010705",
            "speakerId": 1007,
            "speakerName": "丽莎",
            "text": "偷盗书本的事可不太适合丘丘人呢。",
            "nextDialogs": [
              "101010706"
            ]
          },
          "101010706": {
            "id": "101010706",
            "speakerId": 1007,
            "speakerName": "丽莎",
            "text": "毕竟它们大概只会把书本点着来取暖。",
            "nextDialogs": [
              "101010712"
            ]
          },
          "101010712": {
            "id": "101010712",
            "speakerId": 1007,
            "speakerName": "丽莎",
            "text": "还是<color=#00E1FFFF>深渊教团</color>作案的可能性大一些，毕竟本来就是些神出鬼没的家伙。",
            "nextDialogs": [
              "101010713"
            ]
          },
          "101010713": {
            "id": "101010713",
            "speakerId": 1007,
            "speakerName": "丽莎",
            "text": "况且…这遗迹入口的元素封印，也像是深渊法师留下的魔力痕迹。",
            "nextDialogs": [
              "101010714"
            ]
          },
          "101010714": {
            "id": "101010714",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "是封印吗，那要怎么解开呢…该不会又要花很多功夫吧…",
            "nextDialogs": [
              "101010715"
            ]
          },
          "101010715": {
            "id": "101010715",
            "speakerId": 1007,
            "speakerName": "丽莎",
            "text": "如果这点程度的元素力，就想把我拒之门外，那还真是小瞧人了。",
            "nextDialogs": [
              "101010716"
            ]
          },
          "101010716": {
            "id": "101010716",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "嗯？",
            "nextDialogs": [
              "101010717"
            ]
          },
          "101010717": {
            "id": "101010717",
            "speakerId": 1007,
            "speakerName": "丽莎",
            "text": "我们进去吧。",
            "nextDialogs": [
              "101010718"
            ]
          },
          "101010718": {
            "id": "101010718",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "呜…哇…",
            "nextDialogs": [
              "101010719"
            ]
          },
          "101010719": {
            "id": "101010719",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "这就是工作中的丽莎小姐吗…"
          },
          "101010708": {
            "id": "101010708",
            "speakerId": 1007,
            "speakerName": "丽莎",
            "text": "不愧是你，跟我心有灵犀哦。"
          },
          "101010710": {
            "id": "101010710",
            "speakerId": 1007,
            "speakerName": "丽莎",
            "text": "嗯…从总是在地下遗迹钻来钻去的角度上确实…",
            "nextDialogs": [
              "101010711"
            ]
          },
          "101010711": {
            "id": "101010711",
            "speakerId": 1007,
            "speakerName": "丽莎",
            "text": "但他们不会随便拿别人的东西…唔，更正一下，至少不会拿活着的人的东西。"
          }
        }
      }
    },

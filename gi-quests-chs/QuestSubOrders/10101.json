    {
      "subId": "1010112",
      "subQuestName": "(test)击败深渊法师后的对话（隐藏）$HIDDEN",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "101011201"
        ],
        "dialogs": {
          "101011201": {
            "id": "101011201",
            "speakerId": 10032,
            "speakerName": "深渊法师",
            "text": "你们…是怎么…找到这里，明明已经…刻意隐藏…",
            "nextDialogs": [
              "101011202"
            ]
          },
          "101011202": {
            "id": "101011202",
            "speakerId": 1007,
            "speakerName": "丽莎",
            "text": "我对你们这些家伙藏在哪里可没兴趣，只是来要回书本。",
            "nextDialogs": [
              "101011203"
            ]
          },
          "101011203": {
            "id": "101011203",
            "speakerId": 1007,
            "speakerName": "丽莎",
            "text": "有时间隐藏据点，布设封印…却没时间办出借手续吗？",
            "nextDialogs": [
              "101011204"
            ]
          },
          "101011204": {
            "id": "101011204",
            "speakerId": 1007,
            "speakerName": "丽莎",
            "text": "真是不懂得尊重他人工作的家伙。",
            "nextDialogs": [
              "101011205"
            ]
          },
          "101011205": {
            "id": "101011205",
            "speakerId": 10032,
            "speakerName": "深渊法师",
            "text": "原来是…为了<color=#00E1FFFF>那本书</color>…",
            "nextDialogs": [
              "101011206"
            ]
          },
          "101011206": {
            "id": "101011206",
            "speakerId": 10032,
            "speakerName": "深渊法师",
            "text": "没想到蒙德这种地方…居然也有人…参透书中的秘密…",
            "nextDialogs": [
              "101011207"
            ]
          },
          "101011207": {
            "id": "101011207",
            "speakerId": 10032,
            "speakerName": "深渊法师",
            "text": "你…到底是谁？",
            "nextDialogs": [
              "101011208"
            ]
          },
          "101011208": {
            "id": "101011208",
            "speakerId": 1007,
            "speakerName": "丽莎",
            "text": "图书馆的管理员。说了这么多，还要问吗？",
            "nextDialogs": [
              "101011209"
            ]
          },
          "101011209": {
            "id": "101011209",
            "speakerId": 1007,
            "speakerName": "丽莎",
            "text": "请归还书本，这是最后通牒哦。",
            "nextDialogs": [
              "101011210"
            ]
          },
          "101011210": {
            "id": "101011210",
            "speakerId": 10032,
            "speakerName": "深渊法师",
            "text": "哼…居然想…隐藏身份…",
            "nextDialogs": [
              "101011211"
            ]
          },
          "101011211": {
            "id": "101011211",
            "speakerId": 10032,
            "speakerName": "深渊法师",
            "text": "既然如此…就更不能把书拿出来了…",
            "nextDialogs": [
              "101011212"
            ]
          },
          "101011212": {
            "id": "101011212",
            "speakerId": 10032,
            "speakerName": "深渊法师",
            "text": "毕竟…那可是关乎…「那个秘密」…",
            "nextDialogs": [
              "101011213"
            ]
          },
          "101011213": {
            "id": "101011213",
            "speakerId": 10032,
            "speakerName": "深渊法师",
            "text": "咦？！啊…你…你想做什么！这种量级的元素力…你难道要——",
            "nextDialogs": [
              "101011214"
            ]
          },
          "101011214": {
            "id": "101011214",
            "speakerId": 10032,
            "speakerName": "深渊法师",
            "text": "啊啊啊啊啊———————！！！",
            "nextDialogs": [
              "101011217"
            ]
          },
          "101011217": {
            "id": "101011217",
            "speakerId": 1007,
            "speakerName": "丽莎",
            "text": "呼…不好好听人说话的家伙，就应该受一点惩罚。"
          }
        }
      }
    },
    {
      "subId": "1010116",
      "subQuestName": "寻找藏匿的书籍",
      "sceneId": null,

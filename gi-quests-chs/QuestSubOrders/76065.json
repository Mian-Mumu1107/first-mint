{
  "lineCounts": {
    "Player": 13,
    "哥伦比娅": 30
  },
  "subQuests": [
    {
      "subId": "7606501",
      "subQuestName": "(test)隐藏$HIDDEN",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "760650101"
        ],
        "dialogs": {
          "760650101": {
            "id": "760650101",
            "speakerId": 1000,
            "speakerName": "哥伦比娅",
            "text": "你来了。",
            "nextDialogs": [
              "760650102"
            ]
          },
          "760650102": {
            "id": "760650102",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "哥伦比娅居然在这里。",
            "nextDialogs": [
              "760650103"
            ]
          },
          "760650103": {
            "id": "760650103",
            "speakerId": 1000,
            "speakerName": "哥伦比娅",
            "text": "嗯，现在你也来了，所以，是我们一起在这里。",
            "nextDialogs": [
              "760650104"
            ]
          },
          "760650104": {
            "id": "760650104",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "说得好像你知道我会来。",
            "nextDialogs": [
              "760650105"
            ]
          },
          "760650105": {
            "id": "760650105",
            "speakerId": 1000,
            "speakerName": "哥伦比娅",
            "text": "我不知道是什么时候，但你总会来的。",
            "nextDialogs": [
              "760650106"
            ]
          },
          "760650106": {
            "id": "760650106",
            "speakerId": 1000,
            "speakerName": "哥伦比娅",
            "text": "就像月亮与提瓦特之间总有一股相互联系的引力。你总能找到我。不是么？",
            "nextDialogs": [
              "760650107"
            ]
          },
          "760650107": {
            "id": "760650107",
            "speakerId": 1000,
            "speakerName": "哥伦比娅",
            "text": "来，一起坐坐吧，给你留了位置。",
            "nextDialogs": [
              "760650108"
            ]
          },
          "760650108": {
            "id": "760650108",
            "speakerId": 1000,
            "speakerName": "哥伦比娅",
            "text": "上次我们在你的飞船上，看提瓦特。这次就看看星空吧。",
            "nextDialogs": [
              "760650109"
            ]
          },
          "760650109": {
            "id": "760650109",
            "speakerId": 1000,
            "speakerName": "哥伦比娅",
            "text": "宁宁和她的前辈们，就是被这片星空吸引了。那里一定也有着别样的引力。我感受得到。",
            "nextDialogs": [
              "760650110"
            ]
          },
          "760650110": {
            "id": "760650110",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "宁宁和她发出的消息…",
            "nextDialogs": [
              "760650111"
            ]
          },
          "760650111": {
            "id": "760650111",
            "speakerId": 1000,
            "speakerName": "哥伦比娅",
            "text": "别担心，她没有遇到危险。",
            "nextDialogs": [
              "760650112"
            ]
          },
          "760650112": {
            "id": "760650112",
            "speakerId": 1000,
            "speakerName": "哥伦比娅",
            "text": "她安全地走了很远很远的路，远到已经感应不到我用来护送她的力量了。",
            "nextDialogs": [
              "760650113"
            ]
          },
          "760650113": {
            "id": "760650113",
            "speakerId": 1000,
            "speakerName": "哥伦比娅",
            "text": "但是，我很好奇…",
            "nextDialogs": [
              "760650114"
            ]
          },
          "760650114": {
            "id": "760650114",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "好奇什么？",
            "nextDialogs": [
              "760650115"
            ]
          },
          "760650115": {
            "id": "760650115",
            "speakerId": 1000,
            "speakerName": "哥伦比娅",
            "text": "嗯，有很多。比如，望月者的消息会被其他人接收到吗？",
            "nextDialogs": [
              "760650116"
            ]
          },
          "760650116": {
            "id": "760650116",
            "speakerId": 1000,
            "speakerName": "哥伦比娅",
            "text": "接收到的人，或者其他存在…他们会是谁呢？",
            "nextDialogs": [
              "760650117"
            ]
          },
          "760650117": {
            "id": "760650117",
            "speakerId": 1000,
            "speakerName": "哥伦比娅",
            "text": "他们会怎么想？会和我们一样，心里也有爱和恨吗？",
            "nextDialogs": [
              "760650118"
            ]
          },
          "760650118": {
            "id": "760650118",
            "speakerId": 1000,
            "speakerName": "哥伦比娅",
            "text": "会和我们一样，即使深渊环伺，依然被头顶这片美丽又神秘的星空吸引吗？",
            "nextDialogs": [
              "760650119"
            ]
          },
          "760650119": {
            "id": "760650119",
            "speakerId": 1000,
            "speakerName": "哥伦比娅",
            "text": "会和我们一样，也想找到其他人，然后招招手说「好朋友，很高兴认识你」吗？",
            "nextDialogs": [
              "760650120"
            ]
          },
          "760650120": {
            "id": "760650120",
            "speakerId": 1000,
            "speakerName": "哥伦比娅",
            "text": "……",
            "nextDialogs": [
              "760650121"
            ]
          },
          "760650121": {
            "id": "760650121",
            "speakerId": 1000,
            "speakerName": "哥伦比娅",
            "text": "这片星空深处，还有没被黑暗吞噬的文明吗？",
            "nextDialogs": [
              "760650122"
            ]
          },
          "760650122": {
            "id": "760650122",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "我想会有的。",
            "nextDialogs": [
              "760650123"
            ]
          },
          "760650123": {
            "id": "760650123",
            "speakerId": 1000,
            "speakerName": "哥伦比娅",
            "text": "嗯？",
            "nextDialogs": [
              "760650124"
            ]
          },
          "760650124": {
            "id": "760650124",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "我们的飞船，曾接收过一段讯息。",
            "nextDialogs": [
              "760650125"
            ]
          },
          "760650125": {
            "id": "760650125",
            "speakerId": 1000,
            "speakerName": "哥伦比娅",
            "text": "什么讯息？",
            "nextDialogs": [
              "760650126"
            ]
          },
          "760650126": {
            "id": "760650126",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "有效内容几乎缺失了。",
            "nextDialogs": [
              "760650127"
            ]
          },
          "760650127": {
            "id": "760650127",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "但一定属于一个智慧文明。",
            "nextDialogs": [
              "760650128"
            ]
          },
          "760650128": {
            "id": "760650128",
            "speakerId": 1000,
            "speakerName": "哥伦比娅",
            "text": "缺失…是因为走了太远的路吗…？",
            "nextDialogs": [
              "760650129"
            ]
          },
          "760650129": {
            "id": "760650129",
            "speakerId": 1000,
            "speakerName": "哥伦比娅",
            "text": "不过，光是这样，就已经足够让人高兴了。",
            "nextDialogs": [
              "760650130"
            ]
          },
          "760650130": {
            "id": "760650130",
            "speakerId": 1000,
            "speakerName": "哥伦比娅",
            "text": "#对了，{NICKNAME}…",
            "nextDialogs": [
              "760650131"
            ]
          },
          "760650131": {
            "id": "760650131",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "嗯？",
            "nextDialogs": [
              "760650132"
            ]
          },
          "760650132": {
            "id": "760650132",
            "speakerId": 1000,
            "speakerName": "哥伦比娅",
            "text": "你原本的家乡，也在那深处吧。",
            "nextDialogs": [
              "760650133"
            ]
          },
          "760650133": {
            "id": "760650133",
            "speakerId": 1000,
            "speakerName": "哥伦比娅",
            "text": "如果有一天，你想要回到你启程的地方，打扫打扫那里。",
            "nextDialogs": [
              "760650134"
            ]
          },
          "760650134": {
            "id": "760650134",
            "speakerId": 1000,
            "speakerName": "哥伦比娅",
            "text": "我很乐意搭把手，像你帮我打扫月亮一样。",
            "nextDialogs": [
              "760650135"
            ]
          },
          "760650135": {
            "id": "760650135",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "那我不会忘记来邀请你的。",
            "nextDialogs": [
              "760650136"
            ]
          },
          "760650136": {
            "id": "760650136",
            "speakerId": 1000,
            "speakerName": "哥伦比娅",
            "text": "再开一个派对？",
            "nextDialogs": [
              "760650137"
            ]
          },
          "760650137": {
            "id": "760650137",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "再开一个派对。",
            "nextDialogs": [
              "760650138"
            ]
          },
          "760650138": {
            "id": "760650138",
            "speakerId": 1000,
            "speakerName": "哥伦比娅",
            "text": "那…",
            "nextDialogs": [
              "760650139"
            ]
          },
          "760650139": {
            "id": "760650139",
            "speakerId": 1000,
            "speakerName": "哥伦比娅",
            "text": "名字就叫「归旅之夜」，你觉得怎么样？",
            "nextDialogs": [
              "760650140"
            ]
          },
          "760650140": {
            "id": "760650140",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "也许是白天呢。",
            "nextDialogs": [
              "760650141"
            ]
          },
          "760650141": {
            "id": "760650141",
            "speakerId": 1000,
            "speakerName": "哥伦比娅",
            "text": "那就从白天玩到夜晚。把好朋友们都喊上。",
            "nextDialogs": [
              "760650142"
            ]
          },
          "760650142": {
            "id": "760650142",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "听起来很愉快。",
            "nextDialogs": [
              "760650143"
            ]
          },
          "760650143": {
            "id": "760650143",
            "speakerId": 1000,
            "speakerName": "哥伦比娅",
            "text": "愿那个夜晚在一个好天气里到来。在朋友们的团聚下到来。"
          }
        }
      }
    },
    {

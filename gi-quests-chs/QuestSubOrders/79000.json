        ],
        "dialogs": {
          "790000301": {
            "id": "790000301",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "唔唔唔，打不开…输入的密码好像不太对呢…",
            "nextDialogs": [
              "790000302"
            ]
          },
          "790000302": {
            "id": "790000302",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "再仔细听听海螺里的声音吧，说不定会有什么线索呢。"
          }
        }
      }
    }
  ]
}
  "subQuests": [
    {
      "subId": "7900010",
      "subQuestName": "家族迁徙首位隐藏任务$HIDDEN",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "680020501"
        ],
        "dialogs": {
          "680020501": {
            "id": "680020501",
            "speakerId": 1000,
            "speakerName": "回声海螺",
            "text": "「这几年，每一次海潮都比过去更高。水位上涨，我们已经快要没有生存空间…」",
            "nextDialogs": [
              "680020502"
            ]
          },
          "680020502": {
            "id": "680020502",
            "speakerId": 1000,
            "speakerName": "回声海螺",
            "text": "「我只能动员家族成员们打包物资，一同迁往高处。」",
            "nextDialogs": [
              "680020503"
            ]
          },
          "680020503": {
            "id": "680020503",
            "speakerId": 1000,
            "speakerName": "回声海螺",
            "text": "「妈妈！」",
            "nextDialogs": [
              "680020504"
            ]
          },
          "680020504": {
            "id": "680020504",
            "speakerId": 1000,
            "speakerName": "回声海螺",
            "text": "「怎么了？」",
            "nextDialogs": [
              "680020505"
            ]
          },
          "680020505": {
            "id": "680020505",
            "speakerId": 1000,
            "speakerName": "回声海螺",
            "text": "「刚刚水淹上来，我让大家先撤离去高处了！至于传家宝…抱歉，我认为家人比宝物更重要，所以…没来得及带走。」",
            "nextDialogs": [
              "680020506"
            ]
          },
          "680020506": {
            "id": "680020506",
            "speakerId": 1000,
            "speakerName": "回声海螺",
            "text": "「传家宝留在了<color=#37FFFF>岛屿中央</color>，如果以后水能褪去，或是有人能从外面进来，就让他们去找吧。」"
          }
        }
      }
    },
    {
      "subId": "7900001",
      "subQuestName": "在双双岛中寻找宝藏",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "790000101"
        ],
        "dialogs": {
          "790000101": {
            "id": "790000101",
            "speakerId": 2003052,
            "speakerName": "上锁的箱子",
            "text": "（需要输入正确的密码才能打开这个箱子。密码的「第一位」应该输入什么呢…）",
            "nextDialogs": [
              "790000107"
            ]
          },
          "790000107": {
            "id": "790000107",
            "speakerId": 2003052,
            "speakerName": "上锁的箱子",
            "text": "（需要输入正确的密码才能打开这个箱子。密码的「第二位」应该输入什么呢…）"
          }
        }
      }
    },
    {
      "subId": "7900002",
      "subQuestName": "寻找宝藏",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "790000201"
        ],
        "dialogs": {
          "790000201": {
            "id": "790000201",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "打开了！快看看里面有什么东西吧。"
          }
        }
      }
    },
    {
      "subId": "7900006",
      "subQuestName": "",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "790000401"
        ],
        "dialogs": {
          "790000401": {
            "id": "790000401",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "找到啦！宝藏，宝藏，里面会有什么呢…",
            "nextDialogs": [
              "790000402"
            ]
          },
          "790000402": {
            "id": "790000402",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "咦？上面怎么有锁。还、还是密码锁…需要密码才能打开吗…",
            "nextDialogs": [
              "790000405",
              "790000407"
            ]
          },
          "790000405": {
            "id": "790000405",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "等一下！直接砸的话，要是里面的东西也被砸坏了怎么办？",
            "nextDialogs": [
              "790000406"
            ]
          },
          "790000406": {
            "id": "790000406",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "我们还是想想打开锁的方法吧。",
            "nextDialogs": [
              "790000410"
            ]
          },
          "790000410": {
            "id": "790000410",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "但既然这个箱子装着的东西是「传家宝」，而且这箱子还是用「密码」的形式锁住的…",
            "nextDialogs": [
              "790000411"
            ]
          },
          "790000411": {
            "id": "790000411",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "那就是说，锁住这个箱子的人认为，自己所留下的「密码」能很容易就被记住…",
            "nextDialogs": [
              "790000412"
            ]
          },
          "790000412": {
            "id": "790000412",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "看来我们唯一的希望，就只有那些保存着声音的海螺了。",
            "nextDialogs": [
              "790000413"
            ]
          },
          "790000413": {
            "id": "790000413",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "再好好听一下那些海螺里的声音吧，希望那些声音里真的有「密码」的线索…"
          },
          "790000407": {
            "id": "790000407",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "不过，周围也没有石碑、壁画、纸条、刻字和笔记本的样子…",
            "nextDialogs": [
              "790000408"
            ]
          },
          "790000408": {
            "id": "790000408",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "而且也没有学者、盗宝团或者冒险家。",
            "nextDialogs": [
              "790000409"
            ]
          },
          "790000409": {
            "id": "790000409",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "是呢，唔唔，真是前所未有的大考验。"
          }
        }
      }
    },
    {
      "subId": "7900003",
      "subQuestName": "解锁宝藏",
      "sceneId": null,
      "locations": [],
      "dialogue": {

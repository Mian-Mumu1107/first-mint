        "startDialogs": [
          "191731498"
        ],
        "dialogs": {
          "191731498": {
            "id": "191731498",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "（隐去塔米米的事…）",
            "nextDialogs": [
              "191731499"
            ]
          },
          "191731499": {
            "id": "191731499",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "（将一切如实相告…）"
          }
        }
      }
    },
    {
      "subId": "1917351",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "191735101"
        ],
        "dialogs": {
          "191735101": {
            "id": "191735101",
            "speakerId": 12603,
            "speakerName": "卡卡塔",
            "text": "咕噜…",
            "nextDialogs": [
              "191735102"
            ]
          },
          "191735102": {
            "id": "191735102",
            "speakerId": 1067,
            "speakerName": "珐露珊",
            "text": "机械生命…没想到在百年后的须弥，会以这样的方式重新见到。"
          }
        }
      }
    },
    {
      "subId": "1917352",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "191735201"
        ],
        "dialogs": {
          "191735201": {
            "id": "191735201",
            "speakerId": 1051,
            "speakerName": "柯莱",
            "text": "没想到，机械生命居然也会生病…一定要好起来呀！"
          }
        }
      }
    },
    {
      "subId": "1917353",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "191735301"
        ],
        "dialogs": {
          "191735301": {
            "id": "191735301",
            "speakerId": 1050,
            "speakerName": "提纳里",
            "text": "「全自动灌溉机关」…珐露珊前辈，还真是留了个麻烦的课题下来。",
            "nextDialogs": [
              "191735302"
            ]
          },
          "191735302": {
            "id": "191735302",
            "speakerId": 1051,
            "speakerName": "柯莱",
            "text": "师父，有什么我能帮上忙的吗？不管是去采购材料，还是准备纸笔…",
            "nextDialogs": [
              "191735303"
            ]
          },
          "191735303": {
            "id": "191735303",
            "speakerId": 1050,
            "speakerName": "提纳里",
            "text": "唉…我记得，你今天还有不少功课要做吧？",
            "nextDialogs": [
              "191735304"
            ]
          },
          "191735304": {
            "id": "191735304",
            "speakerId": 1051,
            "speakerName": "柯莱",
            "text": "欸？是、是的。",
            "nextDialogs": [
              "191735305"
            ]
          },
          "191735305": {
            "id": "191735305",
            "speakerId": 1050,
            "speakerName": "提纳里",
            "text": "尽快把功课做完，早点上床睡觉，不要让珐露珊前辈担心，就是最大的帮助了。",
            "nextDialogs": [
              "191735306"
            ]
          },
          "191735306": {
            "id": "191735306",
            "speakerId": 1051,
            "speakerName": "柯莱",
            "text": "呜…好的。",
            "nextDialogs": [
              "191735307"
            ]
          },
          "191735307": {
            "id": "191735307",
            "speakerId": 12603,
            "speakerName": "卡卡塔",
            "text": "咕噜…"
          }
        }
      }
    },
    {
      "subId": "1917354",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "191735401"
        ],
        "dialogs": {
          "191735401": {
            "id": "191735401",
            "speakerId": 12932,
            "speakerName": "巴克尔",
            "text": "站住！没有拉伊德先生的允许，闲杂人等不得靠近！"
          }
        }
      }
    },
    {
      "subId": "1917355",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "191735501"
        ],
        "dialogs": {
          "191735501": {
            "id": "191735501",
            "speakerId": 12935,
            "speakerName": "拉伊德",
            "text": "那边刚好有村民偶尔休息用的帐篷，虽然简陋了点，但还请两位不要嫌弃。"
          }
        }
      }
    },
    {
      "subId": "1917356",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "191735601"
        ],
        "dialogs": {
          "191735601": {
            "id": "191735601",
            "speakerId": 12935,
            "speakerName": "拉伊德",
            "text": "竟然打扰到前辈休息，真是抱歉。我会叮嘱手下人，手脚都放轻点的。"
          }
        }
      }
    },
    {
      "subId": "1917357",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "191735701"
        ],
        "dialogs": {
          "191735701": {
            "id": "191735701",
            "speakerId": 12939,
            "speakerName": "机械残骸",
            "text": "（庞大的机械残骸一动不动…）"
          }
        }
      }
    },
    {
      "subId": "1917358",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "191735801"
        ],
        "dialogs": {
          "191735801": {
            "id": "191735801",
            "speakerId": 1067,
            "speakerName": "珐露珊",
            "text": "（珐露珊低头不语…沙漠中仿佛只有风扬起尘沙的碎响。）"
          }
        }
      }
    },
    {
      "subId": "1917359",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "191735901"
        ],
        "dialogs": {
          "191735901": {
            "id": "191735901",
            "speakerId": 12603,
            "speakerName": "卡卡塔",
            "text": "咕噜！咕噜！",
            "nextDialogs": [
              "191735902"
            ]
          },
          "191735902": {
            "id": "191735902",
            "speakerId": 1051,
            "speakerName": "柯莱",
            "text": "看起来状态不错呢，不过就算治好了病，也得注意休养哦。"
          }
        }
      }
    },
    {
      "subId": "1917360",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "191736001"
        ],
        "dialogs": {
          "191736001": {
            "id": "191736001",
            "speakerId": 1050,
            "speakerName": "提纳里",
            "text": "前辈修好卡卡塔后就出去了…她好像还有什么事要找你？",
            "nextDialogs": [
              "191736002"
            ]
          },
          "191736002": {
            "id": "191736002",
            "speakerId": 1050,
            "speakerName": "提纳里",
            "text": "…嗯，你们之间的事，我就不多过问了。不过，有什么需要帮忙的话，尽管开口。"
          }
        }
      }
    },
    {
      "subId": "1917361",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "191736101"
        ],
        "dialogs": {
          "191736101": {
            "id": "191736101",
            "speakerId": 12936,
            "speakerName": "疲惫的村民",
            "text": "唉…还不能回阿如村吗…"
          }
        }
      }
    },
    {
      "subId": "1917362",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "191736201"
        ],
        "dialogs": {
          "191736201": {
            "id": "191736201",
            "speakerId": 12937,
            "speakerName": "好奇的村民",
            "text": "他们这是在挖什么呢…"
          }
        }
      }
    },
    {
      "subId": "1917363",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "191736301"
        ],
        "dialogs": {
          "191736301": {
            "id": "191736301",
            "speakerId": 12938,
            "speakerName": "健谈的村民",
            "text": "那台大机械，看着可真威风！"
          }
        }
      }
    },
    {
      "subId": "1917372",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "191737201"
        ],
        "dialogs": {
          "191737201": {
            "id": "191737201",
            "speakerId": 12954,
            "speakerName": "字迹工整的留信",
            "text": "「…珐露珊前辈台鉴。」",
            "nextDialogs": [
              "191737202"
            ]
          },
          "191737202": {
            "id": "191737202",
            "speakerId": 12954,
            "speakerName": "字迹工整的留信",
            "text": "「塔米米所留笔记手稿等，均已整理誊写完毕，皆署尊名。」",
            "nextDialogs": [
              "191737203"
            ]
          },
          "191737203": {
            "id": "191737203",
            "speakerId": 12954,
            "speakerName": "字迹工整的留信",
            "text": "「…惟望我等百年之后，后世学生犹记珐露珊前辈之名。」"
          }
        }
      }
    },
    {
      "subId": "1917373",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "191737301"

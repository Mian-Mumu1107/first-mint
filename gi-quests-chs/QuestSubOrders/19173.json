    {
      "subId": "1917305",
      "subQuestName": "与提纳里对话并等待检查结束",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "191730501"
        ],
        "dialogs": {
          "191730501": {
            "id": "191730501",
            "speakerId": 12936,
            "speakerName": "疲惫的村民",
            "text": "有关遗迹的事？不清楚，我们也只是受雇来给他们运水运粮的。",
            "nextDialogs": [
              "191730502"
            ]
          },
          "191730502": {
            "id": "191730502",
            "speakerId": 12936,
            "speakerName": "疲惫的村民",
            "text": "别说发掘现场了，就连他们住的营地都不让我们靠近呢。"
          }
        }
      }
    },
    {
      "subId": "1917306",
      "subQuestName": "前往列柱沙原东北方",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "191730601"
        ],
        "dialogs": {
          "191730601": {
            "id": "191730601",
            "speakerId": 12937,
            "speakerName": "好奇的村民",
            "text": "这片区域之前经常有沙尘暴肆虐，最近不知道为什么平息了一些…",
            "nextDialogs": [
              "191730602"
            ]
          },
          "191730602": {
            "id": "191730602",
            "speakerId": 12937,
            "speakerName": "好奇的村民",
            "text": "听说是一位旅行者给解决的？这是人能办到的事儿吗？"
          }
        }
      }
    },
    {
      "subId": "1917307",
      "subQuestName": "前往发掘现场",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "191730701"
        ],
        "dialogs": {
          "191730701": {
            "id": "191730701",
            "speakerId": 12938,
            "speakerName": "健谈的村民",
            "text": "那台大机械，看着好威风啊！不会就是传说中的「遗迹徘徊者」吧？",
            "nextDialogs": [
              "191730702"
            ]
          },
          "191730702": {
            "id": "191730702",
            "speakerId": 12938,
            "speakerName": "健谈的村民",
            "text": "地方好像也能对得上…难不成那个传说是真的？"
          }
        }
      }
    },

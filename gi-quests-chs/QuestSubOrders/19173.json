    {
      "subId": "1917328",
      "subQuestName": "(test)隐藏任务用于记录信件闲置对话阅读进度完成成就1$HIDDEN",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "191737101"
        ],
        "dialogs": {
          "191737101": {
            "id": "191737101",
            "speakerId": 12953,
            "speakerName": "纸张泛黄的留信",
            "text": "「…塔米米的改造很顺利，现在的它，已经可以通过自我迭代，处理遗迹中的各种险情…真希望你能亲眼看到。」",
            "nextDialogs": [
              "191737102"
            ]
          },
          "191737102": {
            "id": "191737102",
            "speakerId": 12953,
            "speakerName": "纸张泛黄的留信",
            "text": "「我在改造它的时候一直在想：如果是你来操刀，能不能做得更好？」",
            "nextDialogs": [
              "191737103"
            ]
          },
          "191737103": {
            "id": "191737103",
            "speakerId": 12953,
            "speakerName": "纸张泛黄的留信",
            "text": "「…毕竟你是我见过最出色的学生。」"
          }
        }
      }
    },

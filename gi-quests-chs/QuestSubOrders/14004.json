    {
      "subId": "1400402",
      "subQuestName": "前往梅洛彼得堡的监舍区",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "140040201"
        ],
        "dialogs": {
          "140040201": {
            "id": "140040201",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "曾经以为「梅洛彼得堡」会很可怕，现在想想气氛其实也还不错。",
            "nextDialogs": [
              "140040202"
            ]
          },
          "140040202": {
            "id": "140040202",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "生活稳定，每天都有饭吃，能用「特许券」买各式各样的东西，难怪很多犯人不愿意离开。",
            "nextDialogs": [
              "140040205"
            ]
          },
          "140040205": {
            "id": "140040205",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "哦，你在说莱欧斯利啊，我也觉得他是个很有本事的人。",
            "nextDialogs": [
              "140040206"
            ]
          },
          "140040206": {
            "id": "140040206",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "虽然看上去有点严肃，但实际接触了之后，感觉也挺好说话的…",
            "nextDialogs": [
              "140040207"
            ]
          },
          "140040207": {
            "id": "140040207",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "不知道他对这里的人是什么样的态度，难道说，看人下菜？",
            "nextDialogs": [
              "140040208"
            ]
          },
          "140040208": {
            "id": "140040208",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "没点手段可不行。",
            "nextDialogs": [
              "140040209"
            ]
          },
          "140040209": {
            "id": "140040209",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "嗯，能让这里的人都守规矩，又不显得压抑，他一定有独到的管理经验吧。",
            "nextDialogs": [
              "140040210"
            ]
          },
          "140040210": {
            "id": "140040210",
            "speakerId": 10205,
            "speakerName": "？？？",
            "text": "请问，有人在吗？求求你们帮我一个忙好吗？",
            "nextDialogs": [
              "140040211"
            ]
          },
          "140040211": {
            "id": "140040211",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "欸？我刚刚是不是听到了什么声音？",
            "nextDialogs": [
              "140040212"
            ]
          },
          "140040212": {
            "id": "140040212",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "我好像也…",
            "nextDialogs": [
              "140040213"
            ]
          },
          "140040213": {
            "id": "140040213",
            "speakerId": 10205,
            "speakerName": "？？？",
            "text": "请问，有人路过吗？可不可以帮我一个忙？",
            "nextDialogs": [
              "140040214"
            ]
          },
          "140040214": {
            "id": "140040214",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "确实，没有听错，在这边！但没看到人啊，怎么会…",
            "nextDialogs": [
              "140040215"
            ]
          },
          "140040215": {
            "id": "140040215",
            "speakerId": 10205,
            "speakerName": "？？？",
            "text": "啊，是有人听到吗？你好，在这边，箱子里面。",
            "nextDialogs": [
              "140040216"
            ]
          },
          "140040216": {
            "id": "140040216",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "#箱子？怪不得没看到人。唉，{NICKNAME}，我们过去看看吧。",
            "nextDialogs": [
              "140040217"
            ]
          },
          "140040217": {
            "id": "140040217",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "你干嘛要躲在箱子里啊，要是没人路过，不管你喊多久都是白费力气哦。",
            "nextDialogs": [
              "140040218"
            ]
          },
          "140040218": {
            "id": "140040218",
            "speakerId": 13478,
            "speakerName": "费索勒",
            "text": "呃，原因比较复杂，可以先不追究吗？"
          }
        }
      }
    },
    {
      "subId": "1400403",

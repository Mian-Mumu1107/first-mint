    {
      "subId": "1400404",
      "subQuestName": "在箱子附近寻找帽子",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [],
        "dialogs": {}
      }
    },
    {
      "subId": "1400405",
      "subQuestName": "在护栏附近寻找帽子",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "140040501"
        ],
        "dialogs": {
          "140040501": {
            "id": "140040501",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "水里也没有，还以为会被吹进去呢…",
            "nextDialogs": [
              "140040502"
            ]
          },
          "140040502": {
            "id": "140040502",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "不知道掉到什么地方去了…",
            "nextDialogs": [
              "140040505"
            ]
          },
          "140040505": {
            "id": "140040505",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "也对啊，不想被人看到秃头的话，只要有帽子遮住就好了吧。",
            "nextDialogs": [
              "140040506"
            ]
          },
          "140040506": {
            "id": "140040506",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "我们可以去「破烂骨头商店」看看，我印象中那边杂七杂八什么都有！"
          }
        }
      }
    },
    {
      "subId": "1400407",
      "subQuestName": "去「破烂骨头商店」",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "140040701"
        ],
        "dialogs": {
          "140040701": {
            "id": "140040701",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "欸？我怎么记得这里的老板不是你来着…",
            "nextDialogs": [
              "140040702"
            ]
          },
          "140040702": {
            "id": "140040702",
            "speakerId": 13521,
            "speakerName": "尚博迪克",
            "text": "哈哈哈，埃尔瓦德大哥去进货了，这时候一般就让我来守摊子。",
            "nextDialogs": [
              "140040703"
            ]
          },
          "140040703": {
            "id": "140040703",
            "speakerId": 13521,
            "speakerName": "尚博迪克",
            "text": "等下，金发的外国人，加上一只会飞的白色姜饼人…",
            "nextDialogs": [
              "140040704"
            ]
          },
          "140040704": {
            "id": "140040704",
            "speakerId": 13521,
            "speakerName": "尚博迪克",
            "text": "你们就是传说中的旅行者和得力搭档派蒙吧？",
            "nextDialogs": [
              "140040705"
            ]
          },
          "140040705": {
            "id": "140040705",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "对！…哎不对！呃，半对不对？我是想说，我不是什么姜饼人，我是得力搭档派蒙！",
            "nextDialogs": [
              "140040706"
            ]
          },
          "140040706": {
            "id": "140040706",
            "speakerId": 13521,
            "speakerName": "尚博迪克",
            "text": "抱歉抱歉，直到现在才有机会一睹真容，太激动了。",
            "nextDialogs": [
              "140040707"
            ]
          },
          "140040707": {
            "id": "140040707",
            "speakerId": 13521,
            "speakerName": "尚博迪克",
            "text": "要是有什么说错话的地方，还请多多担待，不要跟我这样的小人物计较。",
            "nextDialogs": [
              "140040708"
            ]
          },
          "140040708": {
            "id": "140040708",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "啊，也没必要一下子这么客气，我只是吐槽而已…",
            "nextDialogs": [
              "140040709"
            ]
          },
          "140040709": {
            "id": "140040709",
            "speakerId": 13521,
            "speakerName": "尚博迪克",
            "text": "你们在伊黎耶岛做的那些事，早就传到梅洛彼得堡了。",
            "nextDialogs": [
              "140040710"
            ]
          },
          "140040710": {
            "id": "140040710",
            "speakerId": 13521,
            "speakerName": "尚博迪克",
            "text": "前段时间听说你们来到了这里，还被公爵大人亲自接待，我们都羡慕得很。",
            "nextDialogs": [
              "140040711"
            ]
          },
          "140040711": {
            "id": "140040711",
            "speakerId": 13521,
            "speakerName": "尚博迪克",
            "text": "现在谁都知道你们是公爵大人身边的红人，都希望能结识一下呢。",
            "nextDialogs": [
              "140040714"
            ]
          },
          "140040714": {
            "id": "140040714",
            "speakerId": 13521,
            "speakerName": "尚博迪克",
            "text": "哈哈，与其用谎言来拍马屁，我觉得还是坦诚一点比较好。",
            "nextDialogs": [
              "140040715"
            ]
          },
          "140040715": {
            "id": "140040715",
            "speakerId": 13521,
            "speakerName": "尚博迪克",
            "text": "当初我就是听说埃尔瓦德大哥好像和公爵大人关系不一般，才主动说要来帮他看店。",
            "nextDialogs": [
              "140040716"
            ]
          },
          "140040716": {
            "id": "140040716",
            "speakerId": 13521,
            "speakerName": "尚博迪克",
            "text": "结果这么久过去了，公爵大人我没见过两次，倒是和大哥成了很好的朋友。",
            "nextDialogs": [
              "140040717"
            ]
          },
          "140040717": {
            "id": "140040717",
            "speakerId": 13521,
            "speakerName": "尚博迪克",
            "text": "谁做事还没点目的了，但目的是否能实现，也不能强求嘛。",
            "nextDialogs": [
              "140040718"
            ]
          },
          "140040718": {
            "id": "140040718",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "所以你又看上我们了…",
            "nextDialogs": [
              "140040719"
            ]
          },
          "140040719": {
            "id": "140040719",
            "speakerId": 13521,
            "speakerName": "尚博迪克",
            "text": "一码归一码，能碰见你们，本来就是我的荣幸。",
            "nextDialogs": [
              "140040720"
            ]
          },
          "140040720": {
            "id": "140040720",
            "speakerId": 13521,
            "speakerName": "尚博迪克",
            "text": "对了，你们想要什么？",
            "nextDialogs": [
              "140040721"
            ]
          },
          "140040721": {
            "id": "140040721",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "男士的帽子。",
            "nextDialogs": [
              "140040722"
            ]
          },
          "140040722": {
            "id": "140040722",
            "speakerId": 13521,
            "speakerName": "尚博迪克",
            "text": "没问题，还有其他的吗？",
            "nextDialogs": [
              "140040723"
            ]
          },
          "140040723": {
            "id": "140040723",
            "speakerId": 13521,
            "speakerName": "尚博迪克",
            "text": "随便挑吧，不用担心「特许券」，都由我来买单。",
            "nextDialogs": [
              "140040724"
            ]
          },
          "140040724": {
            "id": "140040724",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "那怎么行，太不好意思了…",
            "nextDialogs": [
              "140040725"
            ]
          },
          "140040725": {
            "id": "140040725",
            "speakerId": 13521,
            "speakerName": "尚博迪克",
            "text": "哎，反正大哥也不发我工资，每次就让我挑些看得上的东西带回去。",
            "nextDialogs": [
              "140040726"
            ]
          },
          "140040726": {
            "id": "140040726",
            "speakerId": 13521,
            "speakerName": "尚博迪克",
            "text": "我最近也不缺什么，不如送给你们，交个朋友。",
            "nextDialogs": [
              "140040727"
            ]
          },
          "140040727": {
            "id": "140040727",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "都说到这个份儿上了…",
            "nextDialogs": [
              "140040728"
            ]
          },
          "140040728": {
            "id": "140040728",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "那、那我挑挑看吧…",
            "nextDialogs": [
              "140040729"
            ]
          },
          "140040729": {
            "id": "140040729",
            "speakerId": 1004,
            "speakerName": "Black Screen",
            "text": "一阵犹豫之后，派蒙很克制地挑选了两种点心。",
            "nextDialogs": [
              "140040730"
            ]
          },
          "140040730": {
            "id": "140040730",
            "speakerId": 13521,
            "speakerName": "尚博迪克",
            "text": "真的不再选一点吗？这种机会很难得哦。",
            "nextDialogs": [
              "140040731"
            ]
          },
          "140040731": {
            "id": "140040731",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "不用啦，这样就够了…",
            "nextDialogs": [
              "140040732"
            ]
          },
          "140040732": {
            "id": "140040732",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "你也有不想占便宜的时候。",
            "nextDialogs": [
              "140040733"
            ]
          },
          "140040733": {
            "id": "140040733",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "占便宜和随便拿不一样，还是占便宜更开心。",
            "nextDialogs": [
              "140040734"
            ]
          },
          "140040734": {
            "id": "140040734",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "算了，聊这个话题就太复杂了，那个人还在等我们呢。下次再和你科普派蒙心理学。",
            "nextDialogs": [
              "140040735"
            ]
          },
          "140040735": {
            "id": "140040735",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "谢谢你，那我们就先走啦。",
            "nextDialogs": [
              "140040736"
            ]
          },
          "140040736": {
            "id": "140040736",
            "speakerId": 13521,
            "speakerName": "尚博迪克",
            "text": "好的，谢谢惠顾！记得在公爵大人那里给「破烂骨头商店」一个好评哦。",
            "nextDialogs": [
              "140040737"
            ]
          },
          "140040737": {
            "id": "140040737",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "这种要好评的方式真狡猾啊…"
          }
        }
      }
    },
    {
      "subId": "1400408",
      "subQuestName": "将帽子送回去",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "140040801"
        ],
        "dialogs": {
          "140040801": {
            "id": "140040801",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "出来吧，我们把帽子带回来啦。",
            "nextDialogs": [
              "140040802"
            ]
          },
          "140040802": {
            "id": "140040802",
            "speakerId": 13478,
            "speakerName": "费索勒",
            "text": "真的吗？太谢谢你们了！我这就出来！",
            "nextDialogs": [
              "140040803"
            ]
          },
          "140040803": {
            "id": "140040803",
            "speakerId": 13478,
            "speakerName": "费索勒",
            "text": "唔…唔…",
            "nextDialogs": [
              "140040804"
            ]
          },
          "140040804": {
            "id": "140040804",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "什么嘛，你不是有头发吗？还这么浓密！",
            "nextDialogs": [
              "140040805"
            ]
          },
          "140040805": {
            "id": "140040805",
            "speakerId": 13478,
            "speakerName": "费索勒",
            "text": "唉，我就说你们误会了，不是那么回事。",
            "nextDialogs": [
              "140040806"
            ]
          },
          "140040806": {
            "id": "140040806",
            "speakerId": 13478,
            "speakerName": "费索勒",
            "text": "等一下，这个不是我丢掉的那顶帽子啊。",
            "nextDialogs": [
              "140040807"
            ]
          },
          "140040807": {
            "id": "140040807",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "因为你说的那顶帽子实在是找不到了，所以我们去买了新的。",
            "nextDialogs": [
              "140040808"
            ]
          },
          "140040808": {
            "id": "140040808",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "准确说是别人送的。",
            "nextDialogs": [
              "140040809"
            ]
          },
          "140040809": {
            "id": "140040809",
            "speakerId": 13478,
            "speakerName": "费索勒",
            "text": "哦，原来是这样，谢谢你们。但很不好意思，对我来说，不是原来的那顶帽子就不行…",
            "nextDialogs": [
              "140040810"
            ]
          },
          "140040810": {
            "id": "140040810",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "因为有什么纪念意义吗？",
            "nextDialogs": [
              "140040811"
            ]
          },
          "140040811": {
            "id": "140040811",
            "speakerId": 13478,
            "speakerName": "费索勒",
            "text": "这个，嗯…",
            "nextDialogs": [
              "140040812"
            ]
          },
          "140040812": {
            "id": "140040812",
            "speakerId": 13478,
            "speakerName": "费索勒",
            "text": "抱歉，我也解释不清楚。时间很紧，我再去周围找找看吧。",
            "nextDialogs": [
              "140040813"
            ]
          },
          "140040813": {
            "id": "140040813",
            "speakerId": 1078,
            "speakerName": "莱欧斯利",
            "text": "帽子的话，我刚刚在下面捡到一顶，这是你的吗？",
            "nextDialogs": [
              "140040814"
            ]
          },
          "140040814": {
            "id": "140040814",
            "speakerId": 13478,
            "speakerName": "费索勒",
            "text": "公爵大人？！",
            "nextDialogs": [
              "140040815"
            ]
          },
          "140040815": {
            "id": "140040815",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "哦，是莱欧斯利，有一阵子不见了啊。",
            "nextDialogs": [
              "140040816"
            ]
          },
          "140040816": {
            "id": "140040816",
            "speakerId": 1078,
            "speakerName": "莱欧斯利",
            "text": "今天没什么事，就到处巡视一下。我办公的地方虽然宽敞，但待久了也难免觉得闷。",
            "nextDialogs": [
              "140040817"
            ]
          },
          "140040817": {
            "id": "140040817",
            "speakerId": 1078,
            "speakerName": "莱欧斯利",
            "text": "你们还是老样子，只要有人需要帮忙，无论事情大小，都不会拒绝。",
            "nextDialogs": [
              "140040818"
            ]
          },
          "140040818": {
            "id": "140040818",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "这就是冒险家的精神嘛。",
            "nextDialogs": [
              "140040819"
            ]
          },
          "140040819": {
            "id": "140040819",
            "speakerId": 1078,
            "speakerName": "莱欧斯利",
            "text": "呵，都想让他们到梅洛彼得堡开个分部了。",
            "nextDialogs": [
              "140040820"
            ]
          },
          "140040820": {
            "id": "140040820",
            "speakerId": 1078,
            "speakerName": "莱欧斯利",
            "text": "对你们「檐帽会」来说，帽子是非常重要的东西吧，这可不能随便乱丢。",
            "nextDialogs": [
              "140040821"
            ]
          },
          "140040821": {
            "id": "140040821",
            "speakerId": 1078,
            "speakerName": "莱欧斯利",
            "text": "不然下次估计就没有这样的好运气了。",
            "nextDialogs": [
              "140040822"
            ]
          },
          "140040822": {
            "id": "140040822",
            "speakerId": 13478,
            "speakerName": "费索勒",
            "text": "明白了，非、非常感谢，公爵大人…",
            "nextDialogs": [
              "140040823"
            ]
          },
          "140040823": {
            "id": "140040823",
            "speakerId": 13478,
            "speakerName": "费索勒",
            "text": "那…那我先走了，呃，我…我先走了。",
            "nextDialogs": [
              "140040824"
            ]
          },
          "140040824": {
            "id": "140040824",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "好怪的人，完全搞不懂。",
            "nextDialogs": [
              "140040825"
            ]
          },
          "140040825": {
            "id": "140040825",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "他是做了什么亏心事吗？怎么看到你就像丢了魂一样。",
            "nextDialogs": [
              "140040826"
            ]
          },
          "140040826": {
            "id": "140040826",
            "speakerId": 1078,
            "speakerName": "莱欧斯利",
            "text": "怎么会，恰恰相反，「檐帽会」的人从不惹事生非，工作态度积极向上，很让我省心。",
            "nextDialogs": [
              "140040827"
            ]
          },
          "140040827": {
            "id": "140040827",
            "speakerId": 1078,
            "speakerName": "莱欧斯利",
            "text": "他的话，我想只是比较内向吧，突然看到我估计有点紧张。",
            "nextDialogs": [
              "140040828"
            ]
          },
          "140040828": {
            "id": "140040828",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "啊？内向…还有内向的罪人吗？",
            "nextDialogs": [
              "140040829"
            ]
          },
          "140040829": {
            "id": "140040829",
            "speakerId": 1078,
            "speakerName": "莱欧斯利",
            "text": "地面之上有千百罪名，犯罪者亦有千百动机，「罪人」只不过是一个归类标签。",
            "nextDialogs": [
              "140040830"
            ]
          },
          "140040830": {
            "id": "140040830",
            "speakerId": 1078,
            "speakerName": "莱欧斯利",
            "text": "无论是「邪恶」，还是「暴戾」，还是「自私」，都不足以描述复杂的人性。",
            "nextDialogs": [
              "140040831"
            ]
          },
          "140040831": {
            "id": "140040831",
            "speakerId": 1078,
            "speakerName": "莱欧斯利",
            "text": "他是什么样的人，又为什么会定罪，不去了解他的故事就无从得知。",
            "nextDialogs": [
              "140040832"
            ]
          },
          "140040832": {
            "id": "140040832",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "有道理，反正只要你不在乎就好。",
            "nextDialogs": [
              "140040835"
            ]
          },
          "140040835": {
            "id": "140040835",
            "speakerId": 1078,
            "speakerName": "莱欧斯利",
            "text": "虽然绝大多数的帮会只是让罪人间的斗殴变成群殴而已…",
            "nextDialogs": [
              "140040836"
            ]
          },
          "140040836": {
            "id": "140040836",
            "speakerId": 1078,
            "speakerName": "莱欧斯利",
            "text": "但「檐帽会」的确是在尝试一些比较新鲜有趣的事情。",
            "nextDialogs": [
              "140040837"
            ]
          },
          "140040837": {
            "id": "140040837",
            "speakerId": 1078,
            "speakerName": "莱欧斯利",
            "text": "你们现在有时间吗？不妨随我去特许食堂坐一坐，正好我也想和你们聊聊天。",
            "nextDialogs": [
              "140040838"
            ]
          },
          "140040838": {
            "id": "140040838",
            "speakerId": 1078,
            "speakerName": "莱欧斯利",
            "text": "在那之后如果感兴趣的话，我还可以带你们去「檐帽会」的休息处看看。",
            "nextDialogs": [
              "140040839"
            ]
          },
          "140040839": {
            "id": "140040839",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "我对那个食堂没什么好印象，不过反正也没事情做…",
            "nextDialogs": [
              "140040840"
            ]
          },
          "140040840": {
            "id": "140040840",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "走吧。",
            "nextDialogs": [
              "140040841"
            ]
          },
          "140040841": {
            "id": "140040841",
            "speakerId": 1078,
            "speakerName": "莱欧斯利",
            "text": "那么请随我来。"
          }
        }
      }
    },
    {
      "subId": "1400409",
      "subQuestName": "与莱欧斯利一同前往特许食堂",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "140040901"
        ],
        "dialogs": {
          "140040901": {
            "id": "140040901",
            "speakerId": 5206,
            "speakerName": "韦尔赛",
            "text": "这不是公爵大人还有旅行者嘛，欢迎来到特许食堂，需要今天的福利餐吗？",
            "nextDialogs": [
              "140040902"
            ]
          },
          "140040902": {
            "id": "140040902",
            "speakerId": 5206,
            "speakerName": "韦尔赛",
            "text": "不过公爵大人应该提前打个招呼，超豪华福利餐今天可是一份也没有做…",
            "nextDialogs": [
              "140040903"
            ]
          },
          "140040903": {
            "id": "140040903",
            "speakerId": 1078,
            "speakerName": "莱欧斯利",
            "text": "那我就不用了。你们呢？",
            "nextDialogs": [
              "140040906"
            ]
          },
          "140040906": {
            "id": "140040906",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "我…我也不要，我宁愿把肚子留给更好的…",
            "nextDialogs": [
              "140040907"
            ]
          },
          "140040907": {
            "id": "140040907",
            "speakerId": 1078,
            "speakerName": "莱欧斯利",
            "text": "真可惜，看来我们都欣赏不来韦尔赛你的手艺啊。",
            "nextDialogs": [
              "140040908"
            ]
          },
          "140040908": {
            "id": "140040908",
            "speakerId": 5206,
            "speakerName": "韦尔赛",
            "text": "哈哈，那只能请公爵大人想想办法，多给我安排点食材种类，这样我才能开发出更多套餐啊。",
            "nextDialogs": [
              "140040909"
            ]
          },
          "140040909": {
            "id": "140040909",
            "speakerId": 5206,
            "speakerName": "韦尔赛",
            "text": "不需要食物的话，我给你们上几瓶饮料吧，都是刚到货的好东西。",
            "nextDialogs": [
              "140040910"
            ]
          },
          "140040910": {
            "id": "140040910",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "这个还不错，原来你这里不只有福利餐啊。",
            "nextDialogs": [
              "140040911"
            ]
          },
          "140040911": {
            "id": "140040911",
            "speakerId": 5206,
            "speakerName": "韦尔赛",
            "text": "一般人可享受不到，这是公爵大人和你们的独家待遇。",
            "nextDialogs": [
              "140040912"
            ]
          },
          "140040912": {
            "id": "140040912",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "嘿嘿，我就喜欢独家待遇，那给我两瓶，我很能喝！",
            "nextDialogs": [
              "140040913"
            ]
          },
          "140040913": {
            "id": "140040913",
            "speakerId": 5206,
            "speakerName": "韦尔赛",
            "text": "好嘞，稍等哦。",
            "nextDialogs": [
              "140040914"
            ]
          },
          "140040914": {
            "id": "140040914",
            "speakerId": 1004,
            "speakerName": "Black Screen",
            "text": "过了一会儿，韦尔赛把饮料送了上来。",
            "nextDialogs": [
              "140040915"
            ]
          },
          "140040915": {
            "id": "140040915",
            "speakerId": 1078,
            "speakerName": "莱欧斯利",
            "text": "之前的见面略显仓促，后来又发生了这样那样的事，一直没有机会和你们聊些私人话题。",
            "nextDialogs": [
              "140040916"
            ]
          },
          "140040916": {
            "id": "140040916",
            "speakerId": 1078,
            "speakerName": "莱欧斯利",
            "text": "我是个很喜欢听故事的人，之前听说了你们在枫丹的种种事迹，很想听听真实情况。",
            "nextDialogs": [
              "140040917"
            ]
          },
          "140040917": {
            "id": "140040917",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "要聊这个可就有的说了。"
          }
        }
      }
    },
    {
      "subId": "1400450",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "140045001"
        ],
        "dialogs": {
          "140045001": {
            "id": "140045001",
            "speakerId": 13478,
            "speakerName": "费索勒",
            "text": "实在不好意思，麻烦你们了…请尽量快一点。"
          }
        }
      }
    },
    {
      "subId": "1400451",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "140045101"
        ],
        "dialogs": {
          "140045101": {
            "id": "140045101",
            "speakerId": 13521,
            "speakerName": "尚博迪克",
            "text": "欢迎下次光临！请记得和公爵大人美言几句！"
          }
        }
      }
    },
    {
      "subId": "1400499",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "140049902"
        ],
        "dialogs": {
          "140049902": {
            "id": "140049902",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "不在这里，唉，好像找起来比想象中要麻烦。"
          }
        }
      }
    }
  ]
}
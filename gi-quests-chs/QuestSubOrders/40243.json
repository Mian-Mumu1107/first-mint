{
  "lineCounts": {
    "Player": 2,
    "早柚": 14,
    "派蒙": 7
  },
  "subQuests": [
    {
      "subId": "4024301",
      "subQuestName": "与早柚对话",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "402280901"
        ],
        "dialogs": {
          "402280901": {
            "id": "402280901",
            "speakerId": 1040,
            "speakerName": "早柚",
            "text": "呼噜…",
            "nextDialogs": [
              "402280902"
            ]
          },
          "402280902": {
            "id": "402280902",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "早——柚——怎么又睡着啦。你很累吗？",
            "nextDialogs": [
              "402280903"
            ]
          },
          "402280903": {
            "id": "402280903",
            "speakerId": 1040,
            "speakerName": "早柚",
            "text": "累…搬完凳子，又指挥大礼貉跑了好长一段路…真是辛苦我自己了，需要奖励自己睡一觉。",
            "nextDialogs": [
              "402280904"
            ]
          },
          "402280904": {
            "id": "402280904",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "大狸貉？",
            "nextDialogs": [
              "402280905"
            ]
          },
          "402280905": {
            "id": "402280905",
            "speakerId": 1040,
            "speakerName": "早柚",
            "text": "我就知道肯定会有人听成「狸」。大礼貉的「礼」是礼貌的「礼」，不是狸猫的「狸」！是很有礼貌的大貉貉。",
            "nextDialogs": [
              "402280906"
            ]
          },
          "402280906": {
            "id": "402280906",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "好的。是礼貌不是狸猫。",
            "nextDialogs": [
              "402280907"
            ]
          },
          "402280907": {
            "id": "402280907",
            "speakerId": 1040,
            "speakerName": "早柚",
            "text": "大礼貉是我的幻想朋友。一般情况下大家都看不见它嘛，所以我也没给你们正式介绍过。",
            "nextDialogs": [
              "402280908"
            ]
          },
          "402280908": {
            "id": "402280908",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "果然小朋友们都有幻想朋友呢！",
            "nextDialogs": [
              "402280909"
            ]
          },
          "402280909": {
            "id": "402280909",
            "speakerId": 1040,
            "speakerName": "早柚",
            "text": "嘘——「小朋友」这个称呼听上去会长不高，我是即将独当一面的忍者。嗯…即将。",
            "nextDialogs": [
              "402280910"
            ]
          },
          "402280910": {
            "id": "402280910",
            "speakerId": 1040,
            "speakerName": "早柚",
            "text": "在独当一面前，跟好朋友共同当一面也没什么关系吧…",
            "nextDialogs": [
              "402280911"
            ]
          },
          "402280911": {
            "id": "402280911",
            "speakerId": 1040,
            "speakerName": "早柚",
            "text": "而且…大家看不见大礼貉在帮我，所以在别人眼中我还是独当一面的样子哦。",
            "nextDialogs": [
              "402280912"
            ]
          },
          "402280912": {
            "id": "402280912",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "感觉怪怪的…独当一面是这么用的吗？",
            "nextDialogs": [
              "402280915"
            ]
          },
          "402280915": {
            "id": "402280915",
            "speakerId": 1040,
            "speakerName": "早柚",
            "text": "真的吗？太好了，只需要打开这个忍术装置就可以跟它一起训练！",
            "nextDialogs": [
              "402280916"
            ]
          },
          "402280916": {
            "id": "402280916",
            "speakerId": 1040,
            "speakerName": "早柚",
            "text": "最近忙着跟小魔女们玩，落下了很多训练任务…",
            "nextDialogs": [
              "402280917"
            ]
          },
          "402280917": {
            "id": "402280917",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "训练任务？好呀早柚，想让我们帮你做任务，自己偷懒是吧！",
            "nextDialogs": [
              "402280918"
            ]
          },
          "402280918": {
            "id": "402280918",
            "speakerId": 1040,
            "speakerName": "早柚",
            "text": "这个那个…不是这样的！",
            "nextDialogs": [
              "402280919"
            ]
          },
          "402280919": {
            "id": "402280919",
            "speakerId": 1040,
            "speakerName": "早柚",
            "text": "这是老师离开前留给我的逃跑训练装置。如你们所见，我的逃跑技术已经相当熟练了。",
            "nextDialogs": [
              "402280920"
            ]
          },
          "402280920": {
            "id": "402280920",
            "speakerId": 1040,
            "speakerName": "早柚",
            "text": "属于我自己的训练任务早就完成了，我要偷的不是这个懒。",
            "nextDialogs": [
              "402280921"
            ]
          },
          "402280921": {
            "id": "402280921",
            "speakerId": 1040,
            "speakerName": "早柚",
            "text": "哎…大礼貉比我还懒，都快跟不上我的脚步了。不行啊，要逃就要一起逃。所以现在要做的是训练大礼貉的任务。",
            "nextDialogs": [
              "402280922"
            ]
          },
          "402280922": {
            "id": "402280922",
            "speakerId": 1040,
            "speakerName": "早柚",
            "text": "我想偷的是这个懒…",
            "nextDialogs": [
              "402280923"
            ]
          },
          "402280923": {
            "id": "402280923",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "这不还是偷懒吗！"
          }
        }
      }
    }
  ]
}
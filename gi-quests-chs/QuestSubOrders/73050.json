  "subQuests": [
    {
      "subId": "7305001",
      "subQuestName": "",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "730500101"
        ],
        "dialogs": {
          "730500101": {
            "id": "730500101",
            "speakerId": 1000,
            "speakerName": "兰般度",
            "text": "#那菈{NICKNAME}还有派蒙！多亏你们帮忙，法留纳神机现在很好，善见地也很好…",
            "nextDialogs": [
              "730500102"
            ]
          },
          "730500102": {
            "id": "730500102",
            "speakerId": 1001,
            "speakerName": "兰贡迪",
            "text": "兰那罗都回到桓那兰那，庆祝无忧节，像归巢的鸟。",
            "nextDialogs": [
              "730500103"
            ]
          },
          "730500103": {
            "id": "730500103",
            "speakerId": 1002,
            "speakerName": "兰那库拉",
            "text": "生气的雨变回了温柔的雨，兰那库拉也可以安心照看苗圃，培育毗波耶，高兴的毗波耶…",
            "nextDialogs": [
              "730500104"
            ]
          },
          "730500104": {
            "id": "730500104",
            "speakerId": 1003,
            "speakerName": "兰伽卢",
            "text": "高兴的毗波耶做高兴的灯，高兴的灯点缀高兴的无忧节…",
            "nextDialogs": [
              "730500105"
            ]
          },
          "730500105": {
            "id": "730500105",
            "speakerId": 1003,
            "speakerName": "兰伽卢",
            "text": "#那菈{NICKNAME}和派蒙，苗圃现在很好，无忧节也很开心，谢谢你们帮忙，治好法留纳神机，让兰那库拉回来。",
            "nextDialogs": [
              "730500106"
            ]
          },
          "730500106": {
            "id": "730500106",
            "speakerId": 1004,
            "speakerName": "派蒙",
            "text": "那就好！嘿嘿…",
            "nextDialogs": [
              "730500107"
            ]
          },
          "730500107": {
            "id": "730500107",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "这么说来，有个事情还挺在意的…",
            "nextDialogs": [
              "730500108"
            ]
          },
          "730500108": {
            "id": "730500108",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "那菈法留纳为什么叫那菈法留纳？",
            "nextDialogs": [
              "730500109"
            ]
          },
          "730500109": {
            "id": "730500109",
            "speakerId": 1000,
            "speakerName": "兰般度",
            "text": "嗯嗯。因为那个那菈，是帮助我们治好法留纳神机的那菈。",
            "nextDialogs": [
              "730500110"
            ]
          },
          "730500110": {
            "id": "730500110",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "#那{M#她}{F#他}的名字叫什么？",
            "nextDialogs": [
              "730500111"
            ]
          },
          "730500111": {
            "id": "730500111",
            "speakerId": 1000,
            "speakerName": "兰般度",
            "text": "唔…不知道耶，那菈法留纳，一直都没说过名字。",
            "nextDialogs": [
              "730500114"
            ]
          },
          "730500114": {
            "id": "730500114",
            "speakerId": 1005,
            "speakerName": "兰百梨迦",
            "text": "#那菈{NICKNAME}也帮了好多好多忙，是勇敢的那菈，战胜很多困难。我们一起在无忧节，很高兴。",
            "nextDialogs": [
              "730500115"
            ]
          },
          "730500115": {
            "id": "730500115",
            "speakerId": 1001,
            "speakerName": "兰贡迪",
            "text": "#我们有东西想交给那菈{NICKNAME}。",
            "nextDialogs": [
              "730500116"
            ]
          },
          "730500116": {
            "id": "730500116",
            "speakerId": 1000,
            "speakerName": "兰般度",
            "text": "是表达兰那罗的感谢的东西。",
            "nextDialogs": [
              "730500117"
            ]
          },
          "730500117": {
            "id": "730500117",
            "speakerId": 1002,
            "speakerName": "兰那库拉",
            "text": "#那菈{NICKNAME}一定会喜欢的，派蒙也是。",
            "nextDialogs": [
              "730500118"
            ]
          },
          "730500118": {
            "id": "730500118",
            "speakerId": 1005,
            "speakerName": "兰百梨迦",
            "text": "兰那罗的花，送给勇敢的那菈，还有派蒙。",
            "nextDialogs": [
              "730500119"
            ]
          },
          "730500119": {
            "id": "730500119",
            "speakerId": 1003,
            "speakerName": "兰伽卢",
            "text": "#兰伽卢也有小花，不是毗波耶，但是送给那菈{NICKNAME}和派蒙！",
            "nextDialogs": [
              "730500120"
            ]
          },
          "730500120": {
            "id": "730500120",
            "speakerId": 1000,
            "speakerName": "兰般度",
            "text": "#谢谢那菈{NICKNAME}和派蒙为桓那做过的一切，兰那罗不会忘记朋友！"
          }
        }
      }
    },
    {
      "subId": "7305002",
      "subQuestName": "",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "730500201"
        ],
        "dialogs": {
          "730500201": {
            "id": "730500201",
            "speakerId": 1006,
            "speakerName": "兰利遮",
            "text": "#那菈{NICKNAME}和派蒙！想让桓那「生病」的坏家伙没有再来了，现在放心。",
            "nextDialogs": [
              "730500202"
            ]
          },
          "730500202": {
            "id": "730500202",
            "speakerId": 1006,
            "speakerName": "兰利遮",
            "text": "#谢谢那菈{NICKNAME}和派蒙帮忙，兰利遮才能保护桓那…所以，兰利遮给那菈{NICKNAME}还有派蒙花花！",
            "nextDialogs": [
              "730500203"
            ]
          },
          "730500203": {
            "id": "730500203",
            "speakerId": 1006,
            "speakerName": "兰利遮",
            "text": "收下花花吧，兰利遮的好朋友！"
          }
        }
      }
    },
    {
      "subId": "7305003",
      "subQuestName": "",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "730500301"
        ],
        "dialogs": {
          "730500301": {
            "id": "730500301",
            "speakerId": 1007,
            "speakerName": "兰纳迦",
            "text": "无忧节…怀念的感觉…唔？白蓬蓬飞飞…还有金色的那菈。",
            "nextDialogs": [
              "730500302"
            ]
          },
          "730500302": {
            "id": "730500302",
            "speakerId": 1008,
            "speakerName": "兰纳真",
            "text": "是那菈朋友，和那菈朋友的朋友，希望在无忧节过得开心。",
            "nextDialogs": [
              "730500303"
            ]
          },
          "730500303": {
            "id": "730500303",
            "speakerId": 1009,
            "speakerName": "兰迦鲁",
            "text": "朋友的朋友也是朋友！金色的那菈，还有飞飞白毛都是兰迦鲁的朋友！"
          }
        }
      }
    }
  ]
}
  "subQuests": [
    {
      "subId": "1180101",
      "subQuestName": "(test)废弃$HIDDEN",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "698350101"
        ],
        "dialogs": {
          "698350101": {
            "id": "698350101",
            "speakerId": 1000,
            "speakerName": "神里绫人",
            "text": "…这种样式倒是有几分闲趣，绫华应该会喜欢。",
            "nextDialogs": [
              "698350102"
            ]
          },
          "698350102": {
            "id": "698350102",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "绫人？你是来买衣服么？",
            "nextDialogs": [
              "698350103"
            ]
          },
          "698350103": {
            "id": "698350103",
            "speakerId": 1000,
            "speakerName": "神里绫人",
            "text": "#{NICKNAME}，真是巧遇。之前我在小仓屋预约了一批布料，按照惯例原本是要送到神里屋敷进行挑选的。",
            "nextDialogs": [
              "698350104"
            ]
          },
          "698350104": {
            "id": "698350104",
            "speakerId": 1000,
            "speakerName": "神里绫人",
            "text": "只是今日恰好来天守阁与将军大人会谈，所以干脆顺路提前过来看看。",
            "nextDialogs": [
              "698350107"
            ]
          },
          "698350107": {
            "id": "698350107",
            "speakerId": 1000,
            "speakerName": "神里绫人",
            "text": "如果只是寻常用布，那自然是有专人安排。",
            "nextDialogs": [
              "698350108"
            ]
          },
          "698350108": {
            "id": "698350108",
            "speakerId": 1000,
            "speakerName": "神里绫人",
            "text": "但如果是出席正式场合所用的衣物，便要从布料与着色开始考虑，我一般还是会亲自挑选。",
            "nextDialogs": [
              "698350109"
            ]
          },
          "698350109": {
            "id": "698350109",
            "speakerId": 1000,
            "speakerName": "神里绫人",
            "text": "毕竟…神里家为社奉行，负责文化与民生，一举一动也皆会进入稻妻民众的眼中。购入的布匹样式，自然也瞒不过大家。",
            "nextDialogs": [
              "698350110"
            ]
          },
          "698350110": {
            "id": "698350110",
            "speakerId": 1000,
            "speakerName": "神里绫人",
            "text": "每一年采买布匹后，都会有不少商家打着「社奉行曾用此布」的名号来推销布匹。",
            "nextDialogs": [
              "698350111"
            ]
          },
          "698350111": {
            "id": "698350111",
            "speakerId": 1000,
            "speakerName": "神里绫人",
            "text": "之前有一年我曾差使家仆采买，但…却有人拿着摩拉去向他贿赂，呵呵，他倒也不推辞…处理这件事时，也算是颇费了一些功夫。",
            "nextDialogs": [
              "698350112"
            ]
          },
          "698350112": {
            "id": "698350112",
            "speakerId": 1000,
            "speakerName": "神里绫人",
            "text": "所以，之后涉及到这类事务时，都是由我来亲自处理，也算是提前免去一些麻烦事。"
          }
        }
      }
    },
    {

  },
  "subQuests": [
    {
      "subId": "7051201",
      "subQuestName": "前往晨曦酒庄",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "705120201"
        ],
        "dialogs": {
          "705120201": {
            "id": "705120201",
            "speakerId": 1531,
            "speakerName": "爱德琳",
            "text": "贵安，两位。好久不见了，你们还是很有精神呢。",
            "nextDialogs": [
              "705120202"
            ]
          },
          "705120202": {
            "id": "705120202",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "爱德琳女仆长，你好啊！",
            "nextDialogs": [
              "705120203"
            ]
          },
          "705120203": {
            "id": "705120203",
            "speakerId": 1531,
            "speakerName": "爱德琳",
            "text": "两位是来找迪卢克老爷商议要事的吗？",
            "nextDialogs": [
              "705120206"
            ]
          },
          "705120206": {
            "id": "705120206",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "确实，既然爱德琳小姐站在门口，还是直接拜托爱德琳小姐吧。",
            "nextDialogs": [
              "705120207"
            ]
          },
          "705120207": {
            "id": "705120207",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "爱德琳小姐，我们总是错过酒庄的特价葡萄汁，这次想早点过来预定…",
            "nextDialogs": [
              "705120208"
            ]
          },
          "705120208": {
            "id": "705120208",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "我们多付一点定金也可以哦，请给我们预留一瓶吧！",
            "nextDialogs": [
              "705120209"
            ]
          },
          "705120209": {
            "id": "705120209",
            "speakerId": 1531,
            "speakerName": "爱德琳",
            "text": "当然没问题，完全不用定金！",
            "nextDialogs": [
              "705120210"
            ]
          },
          "705120210": {
            "id": "705120210",
            "speakerId": 1531,
            "speakerName": "爱德琳",
            "text": "只不过，要麻烦你们稍微等等了。晨曦酒庄的特价葡萄汁需要不少准备时间。",
            "nextDialogs": [
              "705120211"
            ]
          },
          "705120211": {
            "id": "705120211",
            "speakerId": 1531,
            "speakerName": "爱德琳",
            "text": "每年夏天，迪卢克老爷都会亲自挑选两桶品质上好的葡萄，用来制作特价葡萄汁。",
            "nextDialogs": [
              "705120212"
            ]
          },
          "705120212": {
            "id": "705120212",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "为什么要把良品低价卖出去呢？「品质上好的葡萄」，明明一听就很贵啊。",
            "nextDialogs": [
              "705120213"
            ]
          },
          "705120213": {
            "id": "705120213",
            "speakerId": 1531,
            "speakerName": "爱德琳",
            "text": "老爷没有明确解释过，我也只能揣测他的想法——",
            "nextDialogs": [
              "705120214"
            ]
          },
          "705120214": {
            "id": "705120214",
            "speakerId": 1531,
            "speakerName": "爱德琳",
            "text": "特价只是一种手段，标着特价的商品往往能吸引更多顾客。",
            "nextDialogs": [
              "705120215"
            ]
          },
          "705120215": {
            "id": "705120215",
            "speakerId": 1531,
            "speakerName": "爱德琳",
            "text": "也许老爷希望用这种方法让果汁流行起来，为人们提供一种新的选择。",
            "nextDialogs": [
              "705120216"
            ]
          },
          "705120216": {
            "id": "705120216",
            "speakerId": 1531,
            "speakerName": "爱德琳",
            "text": "酗酒的人能找到理想替代品，这样就不会在酩酊大醉后闹事，不能喝酒的人们也可以获得别样的乐趣。"
          }
        }
      }
    },
    {
      "subId": "7051203",
      "subQuestName": "前往鹰翔海滩",
      "sceneId": null,
      "locations": [],

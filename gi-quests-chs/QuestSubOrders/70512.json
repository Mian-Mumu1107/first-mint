      }
    },
    {
      "subId": "7051204",
      "subQuestName": "调查营地",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "705120401"
        ],
        "dialogs": {
          "705120401": {
            "id": "705120401",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "看起来不像是迪卢克的帐篷，会是冒险家的营地吗？",
            "nextDialogs": [
              "705120402"
            ]
          },
          "705120402": {
            "id": "705120402",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "那里有一张纸条和一本笔记？我们读读看吧。",
            "nextDialogs": [
              "705120403"
            ]
          },
          "705120403": {
            "id": "705120403",
            "speakerId": 21220,
            "speakerName": "谁人的笔记",
            "text": "诰告「暗夜英雄」，当年的异常现象再次出现了。",
            "nextDialogs": [
              "705120404"
            ]
          },
          "705120404": {
            "id": "705120404",
            "speakerId": 21220,
            "speakerName": "谁人的笔记",
            "text": "原本你已彻底解决问题，但这次地脉又受到了某种刺激，再次释放出了记录中的魔物。",
            "nextDialogs": [
              "705120405"
            ]
          },
          "705120405": {
            "id": "705120405",
            "speakerId": 21220,
            "speakerName": "谁人的笔记",
            "text": "你想必会在第一时间赶来，处理掉威胁最大的魔物。",
            "nextDialogs": [
              "705120406"
            ]
          },
          "705120406": {
            "id": "705120406",
            "speakerId": 21220,
            "speakerName": "谁人的笔记",
            "text": "我就遵照行动守则，先去通知必要人士了。",
            "nextDialogs": [
              "705120407"
            ]
          },
          "705120407": {
            "id": "705120407",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "嗯…看这张纸条的口吻，好像是迪卢克认识的人呢，就先叫他「老爷朋友」吧。",
            "nextDialogs": [
              "705120408"
            ]
          },
          "705120408": {
            "id": "705120408",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "他在这里发现了什么不得了的事，给迪卢克老爷留下纸条以后就离开了。",
            "nextDialogs": [
              "705120409"
            ]
          },
          "705120409": {
            "id": "705120409",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "真粗心啊，这种纸条要是被别人看到了怎么办？还有笔记本，也没带走…",
            "nextDialogs": [
              "705120410"
            ]
          },
          "705120410": {
            "id": "705120410",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "不过这么说来，海滩上那个奇怪的地脉淤积点…",
            "nextDialogs": [
              "705120411"
            ]
          },
          "705120411": {
            "id": "705120411",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "就是他所说的「异常现象」吧。",
            "nextDialogs": [
              "705120412"
            ]
          },
          "705120412": {
            "id": "705120412",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "周围没有魔物，也没有不对劲的地方呀？",
            "nextDialogs": [
              "705120413"
            ]
          },
          "705120413": {
            "id": "705120413",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "#{NICKNAME}，你还想读一读老爷朋友的笔记吗？",
            "nextDialogs": [
              "705120414"
            ]
          },
          "705120414": {
            "id": "705120414",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "如果你不想读了，我们就直接过去，凑近点看看吧。"
          }
        }
      }
    },
    {
      "subId": "7051205",
      "subQuestName": "调查异常的地脉淤积点",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "705120501"
        ],
        "dialogs": {
          "705120501": {
            "id": "705120501",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "呜哇！怎么突然冒出来这么多魔物！",
            "nextDialogs": [
              "705120502"
            ]
          },
          "705120502": {
            "id": "705120502",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "等等…那是迪卢克老爷吗？",
            "nextDialogs": [
              "705120503"
            ]
          },
          "705120503": {
            "id": "705120503",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "和平时的迪卢克不太一样呢…",
            "nextDialogs": [
              "705120504"
            ]
          },
          "705120504": {
            "id": "705120504",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "锐气满满，很有干劲的样子！难道这就是「正义人」火力全开的形态吗！",
            "nextDialogs": [
              "705120507"
            ]
          },
          "705120507": {
            "id": "705120507",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "确实呢，仔细一看，这个迪卢克好像更年轻。",
            "nextDialogs": [
              "705120508"
            ]
          },
          "705120508": {
            "id": "705120508",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "但是，以前发生了什么事呢？迪卢克为什么要在这里战斗？",
            "nextDialogs": [
              "705120509"
            ]
          },
          "705120509": {
            "id": "705120509",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "唔，等到之后去问他本人好了。",
            "nextDialogs": [
              "705120510"
            ]
          },
          "705120510": {
            "id": "705120510",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "#{NICKNAME}，我们怎么办？"
          }
        }
      }
    },
    {
      "subId": "7051206",
      "subQuestName": "击败敌人",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [],
        "dialogs": {}
      }
    },
    {
      "subId": "7051207",
      "subQuestName": "与派蒙讨论当前的情况",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "705120701"
        ],
        "dialogs": {
          "705120701": {
            "id": "705120701",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "结束了呢。迪卢克赢得还挺轻松的，不愧是他。",
            "nextDialogs": [
              "705120702"
            ]
          },
          "705120702": {
            "id": "705120702",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "可是，现在这里只有一些过去的幻影，好像也没什么危险？",
            "nextDialogs": [
              "705120705"
            ]
          },
          "705120705": {
            "id": "705120705",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "所以说，迪卢克已经收工了吗？",
            "nextDialogs": [
              "705120706"
            ]
          },
          "705120706": {
            "id": "705120706",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "如果我们再触碰那个异常的地脉淤积点，还会有魔物出现吗？以前的迪卢克呢？",
            "nextDialogs": [
              "705120707"
            ]
          },
          "705120707": {
            "id": "705120707",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "就像以前在其他地脉淤积点做过的那样，打败所有出现的魔物后，异常的现象就会消失了。"
          }
        }
      }
    },
    {
      "subId": "7051202",
      "subQuestName": "(test)",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [],
        "dialogs": {}
      }
    },
    {
      "subId": "7051208",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "705120801"
        ],
        "dialogs": {
          "705120801": {
            "id": "705120801",
            "speakerId": 1531,
            "speakerName": "爱德琳",
            "text": "如果见到了老爷，请代我问候他。",
            "nextDialogs": [
              "705120802"
            ]
          },
          "705120802": {
            "id": "705120802",
            "speakerId": 1531,
            "speakerName": "爱德琳",
            "text": "还请两位一定要小心。",
            "nextDialogs": [
              "705120803"
            ]
          },
          "705120803": {
            "id": "705120803",
            "speakerId": 1531,
            "speakerName": "爱德琳",
            "text": "「哪怕有着九成的胜算，也不能掉以轻心」，这是老爷的告诫。"
          }
        }
      }
    },
    {
      "subId": "7051299",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "705129906"
        ],
        "dialogs": {
          "705129906": {
            "id": "705129906",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "那边好像有一个营地？迪卢克居然在野外扎营了？",
            "nextDialogs": [
              "705129907"
            ]
          },
          "705129907": {
            "id": "705129907",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "总觉得这种事不对劲…难道敌人很棘手，变成了持久战？",
            "nextDialogs": [
              "705129908"
            ]
          },
          "705129908": {
            "id": "705129908",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "我们快过去看看吧！"
          }
        }
      }
    }
  ]
}
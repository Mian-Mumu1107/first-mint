  "subQuests": [
    {
      "subId": "400001",
      "subQuestName": "前往德波大饭店",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "40000101"
        ],
        "dialogs": {
          "40000101": {
            "id": "40000101",
            "speakerId": 1000,
            "speakerName": "娜维娅",
            "text": "这家店在我小的时候，和父亲来过几次，不过长大以后就很少来了。不知道饭菜会不会合你们口味。",
            "nextDialogs": [
              "40000102"
            ]
          },
          "40000102": {
            "id": "40000102",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "没关系，我们很久没来这样的饭店里吃饭了，好期待！",
            "nextDialogs": [
              "40000103"
            ]
          },
          "40000103": {
            "id": "40000103",
            "speakerId": 1000,
            "speakerName": "娜维娅",
            "text": "那我就先去点菜咯，你们稍等一下。",
            "nextDialogs": [
              "40000104"
            ]
          },
          "40000104": {
            "id": "40000104",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "呜哇，看上去不错，枫丹人很会享受嘛。",
            "nextDialogs": [
              "40000105"
            ]
          },
          "40000105": {
            "id": "40000105",
            "speakerId": 1000,
            "speakerName": "娜维娅",
            "text": "嗯，快尝尝吧，如果好吃的话，下次我叫刺玫会的兄弟们来包场。",
            "nextDialogs": [
              "40000106"
            ]
          },
          "40000106": {
            "id": "40000106",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "如果不好吃呢？",
            "nextDialogs": [
              "40000107"
            ]
          },
          "40000107": {
            "id": "40000107",
            "speakerId": 1000,
            "speakerName": "娜维娅",
            "text": "唔…那就还叫刺玫会的兄弟们来包场，但每桌只点一道菜。",
            "nextDialogs": [
              "40000108"
            ]
          },
          "40000108": {
            "id": "40000108",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "你…呃…还是你有办法。",
            "nextDialogs": [
              "40000109"
            ]
          },
          "40000109": {
            "id": "40000109",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "说起来，这顿饭虽然是散伙饭，但看做是庆功宴也没什么问题吧？我们可是合作打赢了一场官司呢。",
            "nextDialogs": [
              "40000112"
            ]
          },
          "40000112": {
            "id": "40000112",
            "speakerId": 1000,
            "speakerName": "娜维娅",
            "text": "哦~！你这么一说也很有道理，可喜可贺，老板~再加两个菜！",
            "nextDialogs": [
              "40000113"
            ]
          },
          "40000113": {
            "id": "40000113",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "喂！不是要你加菜的意思啦！",
            "nextDialogs": [
              "40000114"
            ]
          },
          "40000114": {
            "id": "40000114",
            "speakerId": 1000,
            "speakerName": "娜维娅",
            "text": "呵呵呵…",
            "nextDialogs": [
              "40000115"
            ]
          },
          "40000115": {
            "id": "40000115",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "对了，你说在今天这件事以后，少女连环失踪案的幕后黑手是不是很快就会落网了呀？",
            "nextDialogs": [
              "40000116"
            ]
          },
          "40000116": {
            "id": "40000116",
            "speakerId": 1000,
            "speakerName": "娜维娅",
            "text": "只能说迈出了一大步吧，我们知道了似乎有一个组织有意在让少女溶解，但真正目的尚未明确…",
            "nextDialogs": [
              "40000117"
            ]
          },
          "40000117": {
            "id": "40000117",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "如果不是发生在眼前，我真的很难相信人居然可以溶解在水里…",
            "nextDialogs": [
              "40000118"
            ]
          },
          "40000118": {
            "id": "40000118",
            "speakerId": 1000,
            "speakerName": "娜维娅",
            "text": "是啊，正是因为有这种谁也想不到的荒唐因素在，少女连环失踪案的调查才一直抓不到关键点。",
            "nextDialogs": [
              "40000119"
            ]
          },
          "40000119": {
            "id": "40000119",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "真可恶，如果最后那个家伙能把真相说完就好了，结果居然…唉，就只差这一步了。",
            "nextDialogs": [
              "40000120"
            ]
          },
          "40000120": {
            "id": "40000120",
            "speakerId": 1000,
            "speakerName": "娜维娅",
            "text": "在这种案件的调查上，看似一小步，可如果线索完全被断开的话，又可以是深不见底的鸿沟。",
            "nextDialogs": [
              "40000121"
            ]
          },
          "40000121": {
            "id": "40000121",
            "speakerId": 1000,
            "speakerName": "娜维娅",
            "text": "说实话，我并不怎么对官方的后续调查抱希望…",
            "nextDialogs": [
              "40000122"
            ]
          },
          "40000122": {
            "id": "40000122",
            "speakerId": 1000,
            "speakerName": "娜维娅",
            "text": "也并不是不相信他们的能力，而是在某些事情上，一定需要不同的视角。",
            "nextDialogs": [
              "40000123"
            ]
          },
          "40000123": {
            "id": "40000123",
            "speakerId": 1000,
            "speakerName": "娜维娅",
            "text": "单一视角很容易被有针对性地蒙蔽或者提防，有时候换个视角才能拨云见日。",
            "nextDialogs": [
              "40000124"
            ]
          },
          "40000124": {
            "id": "40000124",
            "speakerId": 1000,
            "speakerName": "娜维娅",
            "text": "也正因如此，才会有我们「刺玫会」的存在。",
            "nextDialogs": [
              "40000125"
            ]
          },
          "40000125": {
            "id": "40000125",
            "speakerId": 1000,
            "speakerName": "娜维娅",
            "text": "高高在上的人不可能面面俱到，在那些视线死角的缝隙中残留的污秽，就由我们来渗透，由我们来解决。",
            "nextDialogs": [
              "40000126"
            ]
          },
          "40000126": {
            "id": "40000126",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "嗯…好像是我把事情想得太简单了…",
            "nextDialogs": [
              "40000127"
            ]
          },
          "40000127": {
            "id": "40000127",
            "speakerId": 1000,
            "speakerName": "娜维娅",
            "text": "唉，好了好了，既然说是「散伙饭」，你们应该已经对这个话题没什么兴趣了吧？",
            "nextDialogs": [
              "40000128"
            ]
          },
          "40000128": {
            "id": "40000128",
            "speakerId": 1000,
            "speakerName": "娜维娅",
            "text": "我们还是聊点别的，比如…你们接下来的计划是什么？"
          }
        }
      }
    },
    {
      "subId": "400008",
      "subQuestName": "与娜维娅对话",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "40000801"
        ],
        "dialogs": {
          "40000801": {
            "id": "40000801",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "唔，好撑…感觉快要飞不起来了…",
            "nextDialogs": [
              "40000803",
              "40000805"
            ]
          },
          "40000803": {
            "id": "40000803",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "才不要和你一样，太普通了。",
            "nextDialogs": [
              "40000806"
            ]
          },
          "40000806": {
            "id": "40000806",
            "speakerId": 1000,
            "speakerName": "娜维娅",
            "text": "呃…这个月的组织经费还有…",
            "nextDialogs": [
              "40000807"
            ]
          },
          "40000807": {
            "id": "40000807",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "娜维娅，你在那边做什么？",
            "nextDialogs": [
              "40000808"
            ]
          },
          "40000808": {
            "id": "40000808",
            "speakerId": 1000,
            "speakerName": "娜维娅",
            "text": "啊没什么，一顿饭而已，对我们刺玫会来说不过是九牛一毛罢了，哈哈…哈…唉…"
          },
          "40000805": {
            "id": "40000805",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "我已经飞低了差不多半根手指头那么多，你看不出来吗？"
          }
        }
      }
    },
    {
      "subId": "400002",
      "subQuestName": "前往歌剧院前的喷泉广场",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "40000201"
        ],
        "dialogs": {
          "40000201": {
            "id": "40000201",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "这里已经没什么人了呢，我们刚刚那班来伊黎耶岛的巡轨船可能是最后一班了吧？",
            "nextDialogs": [
              "40000202"
            ]
          },
          "40000202": {
            "id": "40000202",
            "speakerId": 1002,
            "speakerName": "？？？",
            "text": "「瓦谢…」",
            "nextDialogs": [
              "40000203"
            ]
          },
          "40000203": {
            "id": "40000203",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "兜兜转转还是又回到了这里…",
            "nextDialogs": [
              "40000204"
            ]
          },
          "40000204": {
            "id": "40000204",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "#{NICKNAME}？你难道又听到那个声音了吗？",
            "nextDialogs": [
              "40000207"
            ]
          },
          "40000207": {
            "id": "40000207",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "欸欸欸…好吓人，要不、要不我们白天再来？",
            "nextDialogs": [
              "40000208"
            ]
          },
          "40000208": {
            "id": "40000208",
            "speakerId": 1002,
            "speakerName": "？？？",
            "text": "「瓦谢…瓦谢…」",
            "nextDialogs": [
              "40000209"
            ]
          },
          "40000209": {
            "id": "40000209",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "喂，你、你怎么还在往前走，万一泉水里有什么不好的东西呢…"
          }
        }
      }
    },
    {
      "subId": "400003",
      "subQuestName": "与纯水精灵对话",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "40000301"
        ],
        "dialogs": {
          "40000301": {
            "id": "40000301",
            "speakerId": 1003,
            "speakerName": "纯水精灵？",
            "text": "……",
            "nextDialogs": [
              "40000304"
            ]
          },
          "40000304": {
            "id": "40000304",
            "speakerId": 1003,
            "speakerName": "纯水精灵？",
            "text": "…瓦谢？啊…是我的瓦谢吗？",
            "nextDialogs": [
              "40000305"
            ]
          },
          "40000305": {
            "id": "40000305",
            "speakerId": 1003,
            "speakerName": "纯水精灵？",
            "text": "等等…不，你好像不是…你认识瓦谢吗，我的瓦谢他在哪儿？"
          }
        }
      }
    },
    {
      "subId": "400004",
      "subQuestName": "与娜维娅对话",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "40000401"
        ],
        "dialogs": {
          "40000401": {
            "id": "40000401",
            "speakerId": 1000,
            "speakerName": "娜维娅",
            "text": "克洛琳德，刚才多亏了你出手，我理应向你道谢。但在此之前，你能否解释下你为何出现在这里…",
            "nextDialogs": [
              "40000402"
            ]
          },
          "40000402": {
            "id": "40000402",
            "speakerId": 1004,
            "speakerName": "克洛琳德",
            "text": "我…只是认为你最近会比较危险，所以跟着你而已。",
            "nextDialogs": [
              "40000403"
            ]
          },
          "40000403": {
            "id": "40000403",
            "speakerId": 1000,
            "speakerName": "娜维娅",
            "text": "我想…在我不知情的情况下跟着我，应该被称为「跟踪」才对吧？",
            "nextDialogs": [
              "40000404"
            ]
          },
          "40000404": {
            "id": "40000404",
            "speakerId": 1004,
            "speakerName": "克洛琳德",
            "text": "这是卡雷斯先生的遗愿，我不能辜负他，必须保障你的安全。如果他还活着，他也会这么做的。",
            "nextDialogs": [
              "40000405"
            ]
          },
          "40000405": {
            "id": "40000405",
            "speakerId": 1000,
            "speakerName": "娜维娅",
            "text": "你…不要提起我的父亲。",
            "nextDialogs": [
              "40000406"
            ]
          },
          "40000406": {
            "id": "40000406",
            "speakerId": 1005,
            "speakerName": "西尔弗",
            "text": "抱歉，大小姐，都怪我实力不足…",
            "nextDialogs": [
              "40000407"
            ]
          },
          "40000407": {
            "id": "40000407",
            "speakerId": 1006,
            "speakerName": "迈勒斯",
            "text": "克洛琳德小姐，我必须感谢您的出手相助，但还请注意您说话的立场，我们应该都不喜欢那些没必要的情感伤害。",
            "nextDialogs": [
              "40000408"
            ]
          },
          "40000408": {
            "id": "40000408",
            "speakerId": 1004,
            "speakerName": "克洛琳德",
            "text": "对不起，我…没考虑到你的心情。",
            "nextDialogs": [
              "40000409"
            ]
          },
          "40000409": {
            "id": "40000409",
            "speakerId": 1000,
            "speakerName": "娜维娅",
            "text": "算了…你究竟还知道些什么，为什么会觉得我很危险？",
            "nextDialogs": [
              "40000410"
            ]
          },
          "40000410": {
            "id": "40000410",
            "speakerId": 1004,
            "speakerName": "克洛琳德",
            "text": "我知道的应该并不比你多，但我相信「少女连环失踪案」的幕后黑手有着强大的势力。",
            "nextDialogs": [
              "40000411"
            ]
          },
          "40000411": {
            "id": "40000411",
            "speakerId": 1004,
            "speakerName": "克洛琳德",
            "text": "你今天的表现肯定会被他们盯上…",
            "nextDialogs": [
              "40000412"
            ]
          },
          "40000412": {
            "id": "40000412",
            "speakerId": 1000,
            "speakerName": "娜维娅",
            "text": "呵呵，他们早就应该盯上我了，倒不如说，我感觉非常奇怪，他们直到现在才动手。",
            "nextDialogs": [
              "40000413"
            ]
          },
          "40000413": {
            "id": "40000413",
            "speakerId": 1000,
            "speakerName": "娜维娅",
            "text": "那关于这些警卫机关呢？我曾经以为只有「执律庭」的人才能操控。",
            "nextDialogs": [
              "40000414"
            ]
          },
          "40000414": {
            "id": "40000414",
            "speakerId": 1004,
            "speakerName": "克洛琳德",
            "text": "我刚才刻意观察过了，这些警卫机关都没有编号，并非执律庭用来执法的机关。",
            "nextDialogs": [
              "40000415"
            ]
          },
          "40000415": {
            "id": "40000415",
            "speakerId": 1004,
            "speakerName": "克洛琳德",
            "text": "想必是某些有钱或者有权势的势力通过不法手段获得的，储备起来用作私人火力。",
            "nextDialogs": [
              "40000416"
            ]
          },
          "40000416": {
            "id": "40000416",
            "speakerId": 1000,
            "speakerName": "娜维娅",
            "text": "好吧，总之很可能是现在的「刺玫会」斗不过的势力，对吧？",
            "nextDialogs": [
              "40000417"
            ]
          },
          "40000417": {
            "id": "40000417",
            "speakerId": 1004,
            "speakerName": "克洛琳德",
            "text": "嗯，请务必小心，不要贸然行事。",
            "nextDialogs": [
              "40000418"
            ]
          },
          "40000418": {
            "id": "40000418",
            "speakerId": 1000,
            "speakerName": "娜维娅",
            "text": "不论如何，我都会继续调查下去的。让真相大白…才是我父亲真正的「遗愿」。",
            "nextDialogs": [
              "40000419"
            ]
          },
          "40000419": {
            "id": "40000419",
            "speakerId": 1000,
            "speakerName": "娜维娅",
            "text": "总之今天还是谢谢你了，克洛琳德，但如果下次你又有什么想法，请先让我知道，我不喜欢被人跟踪。",
            "nextDialogs": [
              "40000420"
            ]
          },
          "40000420": {
            "id": "40000420",
            "speakerId": 1004,
            "speakerName": "克洛琳德",
            "text": "我相信短时间内他们应该不会连续下手，我不会再跟着你了。再见，各位。",
            "nextDialogs": [
              "40000421"
            ]
          },
          "40000421": {
            "id": "40000421",
            "speakerId": 1000,
            "speakerName": "娜维娅",
            "text": "好吧好吧，那可真是今天最好的消息了…",
            "nextDialogs": [
              "40000422"
            ]
          },
          "40000422": {
            "id": "40000422",
            "speakerId": 1006,
            "speakerName": "迈勒斯",
            "text": "大小姐，我认为克洛琳德小姐应该是真诚的，或许的确可以适当缓和与她的关系…",
            "nextDialogs": [
              "40000423"
            ]
          },
          "40000423": {
            "id": "40000423",
            "speakerId": 1000,
            "speakerName": "娜维娅",
            "text": "唉，我心里也知道，但还是没办法，毕竟她是…",
            "nextDialogs": [
              "40000426"
            ]
          },
          "40000426": {
            "id": "40000426",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "#你可算彻底恢复啦，{NICKNAME}，我都以为我们要完蛋了！",
            "nextDialogs": [
              "40000427"
            ]
          },
          "40000427": {
            "id": "40000427",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "那些埋伏的警卫机关趁你昏睡过去的时候忽然冒出来，然后就是娜维娅带着她的手下赶了过来，把我们救下了。",
            "nextDialogs": [
              "40000428"
            ]
          },
          "40000428": {
            "id": "40000428",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "哦对，还有那个叫克洛琳德的决斗代理人也来帮忙了，总之，刚才真是运气好，不然我可打不过那些家伙。"
          }
        }
      }
    },
    {
      "subId": "400005",
      "subQuestName": "前往刺玫会在枫丹廷的据点",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "40000501"
        ],
        "dialogs": {
          "40000501": {
            "id": "40000501",
            "speakerId": 1000,
            "speakerName": "娜维娅",
            "text": "就在前面了，不过…先确认一下有没有人跟踪。",
            "nextDialogs": [
              "40000502"
            ]
          },
          "40000502": {
            "id": "40000502",
            "speakerId": 1005,
            "speakerName": "西尔弗",
            "text": "我一直在盯着，大小姐放心，这一路上没有发现可疑人物。",
            "nextDialogs": [
              "40000503"
            ]
          },
          "40000503": {
            "id": "40000503",
            "speakerId": 1000,
            "speakerName": "娜维娅",
            "text": "嗯，那就好，暂时还不能掉以轻心。",
            "nextDialogs": [
              "40000504"
            ]
          },
          "40000504": {
            "id": "40000504",
            "speakerId": 1006,
            "speakerName": "迈勒斯",
            "text": "我先去找找合适的房间，安排给我们两位尊贵的客人。",
            "nextDialogs": [
              "40000505"
            ]
          },
          "40000505": {
            "id": "40000505",
            "speakerId": 1000,
            "speakerName": "娜维娅",
            "text": "#辛苦你了，迈勒斯。{NICKNAME}，我们也继续走吧。"
          }
        }
      }
    },
    {
      "subId": "400006",
      "subQuestName": "前往娜维娅安排的住所",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [],
        "dialogs": {}
      }
    },
    {
      "subId": "400007",
      "subQuestName": "与迈勒斯对话",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "40000701"
        ],
        "dialogs": {
          "40000701": {
            "id": "40000701",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "这里…这里就是你们刺玫会的据点吗？和想象中的差别有点大啊…",
            "nextDialogs": [
              "40000702"
            ]
          },
          "40000702": {
            "id": "40000702",
            "speakerId": 1006,
            "speakerName": "迈勒斯",
            "text": "二位的住宿已经安排妥当了，绝对是刺玫会当下条件最一流的房间。",
            "nextDialogs": [
              "40000705"
            ]
          },
          "40000705": {
            "id": "40000705",
            "speakerId": 1000,
            "speakerName": "娜维娅",
            "text": "欸嘿…最近刺玫会的经费有些…",
            "nextDialogs": [
              "40000706"
            ]
          },
          "40000706": {
            "id": "40000706",
            "speakerId": 1000,
            "speakerName": "娜维娅",
            "text": "毕竟我们内部严禁做那些有悖道德或法律的暴利买卖，甚至很多时候我们的经费来自于拥戴我们的民众的接济。",
            "nextDialogs": [
              "40000707"
            ]
          },
          "40000707": {
            "id": "40000707",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "听起来大家都不容易呢…不过能受到人们的拥戴，也还算值得吧？",
            "nextDialogs": [
              "40000708"
            ]
          },
          "40000708": {
            "id": "40000708",
            "speakerId": 1000,
            "speakerName": "娜维娅",
            "text": "其实几年前刺玫会在我父亲手里的时候，经济状况要比现在好不少，都怪我能力不足。",
            "nextDialogs": [
              "40000709"
            ]
          },
          "40000709": {
            "id": "40000709",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "你父亲…是前一任的刺玫会老板吗？他是怎么…",
            "nextDialogs": [
              "40000710"
            ]
          },
          "40000710": {
            "id": "40000710",
            "speakerId": 1006,
            "speakerName": "迈勒斯",
            "text": "娜维娅小姐，让我来给他们解释吧…",
            "nextDialogs": [
              "40000711"
            ]
          },
          "40000711": {
            "id": "40000711",
            "speakerId": 1000,
            "speakerName": "娜维娅",
            "text": "不，事到如今我没必要逃避这个话题，作为搭档，这也是我希望他们能够了解的事。还是我自己来说吧。",
            "nextDialogs": [
              "40000712"
            ]
          },
          "40000712": {
            "id": "40000712",
            "speakerId": 1000,
            "speakerName": "娜维娅",
            "text": "我的父亲名叫卡雷斯，也正是如今街头巷尾称之为「不义的卡雷斯」的那个人。",
            "nextDialogs": [
              "40000713"
            ]
          },
          "40000713": {
            "id": "40000713",
            "speakerId": 1000,
            "speakerName": "娜维娅",
            "text": "他在三年多以前被认定为杀死自己朋友的凶手，但他拒绝被审判，最后死在了决斗场上。",
            "nextDialogs": [
              "40000714"
            ]
          },
          "40000714": {
            "id": "40000714",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "居然…",
            "nextDialogs": [
              "40000715"
            ]
          },
          "40000715": {
            "id": "40000715",
            "speakerId": 1000,
            "speakerName": "娜维娅",
            "text": "但我真的不相信父亲会是杀人凶手，这其中一定有冤屈…",
            "nextDialogs": [
              "40000716"
            ]
          },
          "40000716": {
            "id": "40000716",
            "speakerId": 1000,
            "speakerName": "娜维娅",
            "text": "我想那时候他只要接受审判，经过官方的调查，肯定会发现什么端倪，最终证明他的清白。",
            "nextDialogs": [
              "40000717"
            ]
          },
          "40000717": {
            "id": "40000717",
            "speakerId": 1000,
            "speakerName": "娜维娅",
            "text": "可奇怪的是，他不仅提出要进行决斗，而且据说…",
            "nextDialogs": [
              "40000718"
            ]
          },
          "40000718": {
            "id": "40000718",
            "speakerId": 1000,
            "speakerName": "娜维娅",
            "text": "…他在决斗中受了很重的伤以后，明明已经可以判定为输掉了决斗，但他却拒绝投降，执意要死在决斗场上。",
            "nextDialogs": [
              "40000719"
            ]
          },
          "40000719": {
            "id": "40000719",
            "speakerId": 1000,
            "speakerName": "娜维娅",
            "text": "三年了，至今我也想不明白这是为什么…",
            "nextDialogs": [
              "40000720"
            ]
          },
          "40000720": {
            "id": "40000720",
            "speakerId": 1000,
            "speakerName": "娜维娅",
            "text": "…像那样死去的话，才是失去了维护自己名誉的机会啊…"
          }
        }
      }
    },
    {
      "subId": "400009",
      "subQuestName": "进入房间休息",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "40000901"
        ],
        "dialogs": {
          "40000901": {
            "id": "40000901",
            "speakerId": 1007,
            "speakerName": "Black Screen",
            "text": "在刺玫会的守护下，风平浪静的一夜过去了…",
            "nextDialogs": [
              "40000902"
            ]
          },
          "40000902": {
            "id": "40000902",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "呼啊…睡得真好，是这里太有安全感了么…",
            "nextDialogs": [
              "40000903"
            ]
          },
          "40000903": {
            "id": "40000903",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "欸，怎么是娜维娅，你那两个跟班呢？",
            "nextDialogs": [
              "40000904"
            ]
          },
          "40000904": {
            "id": "40000904",
            "speakerId": 1000,
            "speakerName": "娜维娅",
            "text": "我让他们先回白淞镇了，就是我们刺玫会的发源地和总部，这里暂时没有什么事情要他们帮忙了。",
            "nextDialogs": [
              "40000905"
            ]
          },
          "40000905": {
            "id": "40000905",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "我怎么觉得你只是嫌他们烦，把他们甩掉了。",
            "nextDialogs": [
              "40000906"
            ]
          },
          "40000906": {
            "id": "40000906",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "话说你是什么时候来的，一直等在这里么？",
            "nextDialogs": [
              "40000907"
            ]
          },
          "40000907": {
            "id": "40000907",
            "speakerId": 1000,
            "speakerName": "娜维娅",
            "text": "不，我刚刚从外面回来，昨晚我先进行了一轮关于「瓦谢」这个名字的调查。",
            "nextDialogs": [
              "40000908"
            ]
          },
          "40000908": {
            "id": "40000908",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "你难道一整晚都没睡！？",
            "nextDialogs": [
              "40000909"
            ]
          },
          "40000909": {
            "id": "40000909",
            "speakerId": 1000,
            "speakerName": "娜维娅",
            "text": "这么重要的情报出现了，谁还睡得着呀？",
            "nextDialogs": [
              "40000910"
            ]
          },
          "40000910": {
            "id": "40000910",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "嗯…我好像刚说了睡得很好什么的…",
            "nextDialogs": [
              "40000911"
            ]
          },
          "40000911": {
            "id": "40000911",
            "speakerId": 1000,
            "speakerName": "娜维娅",
            "text": "不过可惜，这个名字的存在就像被彻底抹去了一样，哪里都调查不到。",
            "nextDialogs": [
              "40000912"
            ]
          },
          "40000912": {
            "id": "40000912",
            "speakerId": 1000,
            "speakerName": "娜维娅",
            "text": "我想可能幕后黑手早就做了手脚，怕人们调查。不过这也侧面证明了，瓦谢应该的确是关键证人吧。",
            "nextDialogs": [
              "40000913"
            ]
          },
          "40000913": {
            "id": "40000913",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "那、那可怎么办，我们已经晚了一步吗？",
            "nextDialogs": [
              "40000914"
            ]
          },
          "40000914": {
            "id": "40000914",
            "speakerId": 1000,
            "speakerName": "娜维娅",
            "text": "不，还有希望，有一处地方他们就算想要动手脚，也几乎不可能威胁得到…",
            "nextDialogs": [
              "40000915"
            ]
          },
          "40000915": {
            "id": "40000915",
            "speakerId": 1000,
            "speakerName": "娜维娅",
            "text": "那就是最高审判官那维莱特个人所保存的档案…有着近些年所有案件的详细资料。",
            "nextDialogs": [
              "40000916"
            ]
          },
          "40000916": {
            "id": "40000916",
            "speakerId": 1000,
            "speakerName": "娜维娅",
            "text": "如果你看到的那个…嗯…纯水精灵是近期失踪的少女的话，那想必肯定可以找到相关情报。",
            "nextDialogs": [
              "40000917"
            ]
          },
          "40000917": {
            "id": "40000917",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "不愧是最高审判官，原来那维莱特先生工作这么认真，还会整理保留案件的档案。",
            "nextDialogs": [
              "40000918"
            ]
          },
          "40000918": {
            "id": "40000918",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "那我们就出发去找他吧？",
            "nextDialogs": [
              "40000919"
            ]
          },
          "40000919": {
            "id": "40000919",
            "speakerId": 1000,
            "speakerName": "娜维娅",
            "text": "……",
            "nextDialogs": [
              "40000920"
            ]
          },
          "40000920": {
            "id": "40000920",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "嗯？不走吗，娜维娅，你困了吗？",
            "nextDialogs": [
              "40000921"
            ]
          },
          "40000921": {
            "id": "40000921",
            "speakerId": 1000,
            "speakerName": "娜维娅",
            "text": "唉…没事，我们走吧，去见那位最高审判官吧。"
          }
        }
      }
    },
    {
      "subId": "400051",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "40005101"
        ],
        "dialogs": {
          "40005101": {
            "id": "40005101",
            "speakerId": 1005,
            "speakerName": "西尔弗",
            "text": "这一切…都是忽然降临在娜维娅大小姐头上的，不论是刺玫会的责任还是卡雷斯先生的死…",
            "nextDialogs": [
              "40005102"
            ]
          },
          "40005102": {
            "id": "40005102",
            "speakerId": 1005,
            "speakerName": "西尔弗",
            "text": "不行…我必须抓紧变得更强才行。"
          }
        }
      }
    },

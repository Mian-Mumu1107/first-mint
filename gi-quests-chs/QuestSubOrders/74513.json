{
  "lineCounts": {
    "Player": 6,
    "拜希麦·五世": 11,
    "派蒙": 10
  },
  "subQuests": [
    {
      "subId": "7451301",
      "subQuestName": "与拜希麦·五世对话",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "745130101"
        ],
        "dialogs": {
          "745130101": {
            "id": "745130101",
            "speakerId": 30566,
            "speakerName": "拜希麦·五世",
            "text": "路过的客人，生论派的学者、兼大巴扎与海露港的新星商人拜希麦五世恳求您，别急着离开…",
            "nextDialogs": [
              "745130102"
            ]
          },
          "745130102": {
            "id": "745130102",
            "speakerId": 30566,
            "speakerName": "拜希麦·五世",
            "text": "请放松身体，放空思绪，听我说一件重要的事——",
            "nextDialogs": [
              "745130103"
            ]
          },
          "745130103": {
            "id": "745130103",
            "speakerId": 30566,
            "speakerName": "拜希麦·五世",
            "text": "团雀最可爱！",
            "nextDialogs": [
              "745130104"
            ]
          },
          "745130104": {
            "id": "745130104",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "？",
            "nextDialogs": [
              "745130105"
            ]
          },
          "745130105": {
            "id": "745130105",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "？",
            "nextDialogs": [
              "745130106"
            ]
          },
          "745130106": {
            "id": "745130106",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "团雀确实很可爱，但拜希麦小姐说自己是…学者兼商人？一句话没有限制范围，不是会引发很激烈的争论吗？",
            "nextDialogs": [
              "745130107"
            ]
          },
          "745130107": {
            "id": "745130107",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "我的印象里，学者的发言都很谨慎的，商人也不敢随便说出很夸张的话…",
            "nextDialogs": [
              "745130108"
            ]
          },
          "745130108": {
            "id": "745130108",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "如果你和别人说，「我的理论最正确」或者「我的商品最厉害」，那不是会被很多不服气的人盯上，用力找茬吗？",
            "nextDialogs": [
              "745130109"
            ]
          },
          "745130109": {
            "id": "745130109",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "奇怪，怎么感觉这段对话好像发生过，有种熟悉感…",
            "nextDialogs": [
              "745130113"
            ]
          },
          "745130113": {
            "id": "745130113",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "#噫！{NICKNAME}，为什么这么突然啦！",
            "nextDialogs": [
              "745130114"
            ]
          },
          "745130114": {
            "id": "745130114",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "就算不是开玩笑，也不要那么大声嘛…",
            "nextDialogs": [
              "745130115"
            ]
          },
          "745130115": {
            "id": "745130115",
            "speakerId": 30566,
            "speakerName": "拜希麦·五世",
            "text": "哈哈哈！就是这种气势！",
            "nextDialogs": [
              "745130116"
            ]
          },
          "745130116": {
            "id": "745130116",
            "speakerId": 30566,
            "speakerName": "拜希麦·五世",
            "text": "我当然知道，世上任何东西都没有绝对的第一。任何学术理论都有被推翻的可能，任何商品都会被新品超越。",
            "nextDialogs": [
              "745130117"
            ]
          },
          "745130117": {
            "id": "745130117",
            "speakerId": 30566,
            "speakerName": "拜希麦·五世",
            "text": "但不管客观的世界怎么变，每个人心里都存在一些…自己最认可的人与事物。不管别人怎么说，它们的价值都是最高的。",
            "nextDialogs": [
              "745130118"
            ]
          },
          "745130118": {
            "id": "745130118",
            "speakerId": 30566,
            "speakerName": "拜希麦·五世",
            "text": "要是害怕被人否认，对自己失去信心，那就永远不可能成为自己心里最棒的模样，更没法找到认可自己的知音！",
            "nextDialogs": [
              "745130119"
            ]
          },
          "745130119": {
            "id": "745130119",
            "speakerId": 30566,
            "speakerName": "拜希麦·五世",
            "text": "如果你们来玩过我这款桌上游戏「哐哐当当雀雀球」，也会像我这样大声告诉别人，团雀最可爱！",
            "nextDialogs": [
              "745130120"
            ]
          },
          "745130120": {
            "id": "745130120",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "哐哐…当当…雀雀球？就是你旁边这张桌子上的东西吗？也有点眼熟呢…",
            "nextDialogs": [
              "745130121"
            ]
          },
          "745130121": {
            "id": "745130121",
            "speakerId": 30566,
            "speakerName": "拜希麦·五世",
            "text": "没错哦，玩过这个游戏以后，你们就能深刻领会到团雀的可爱之处啦！",
            "nextDialogs": [
              "745130122"
            ]
          },
          "745130122": {
            "id": "745130122",
            "speakerId": 30566,
            "speakerName": "拜希麦·五世",
            "text": "我正在推广这种桌上游戏，如果在游戏里得到高分，还可以获得一些奖品哦！",
            "nextDialogs": [
              "745130123"
            ]
          },
          "745130123": {
            "id": "745130123",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "我确实觉得团雀很可爱啦，就算奖品不多也没关系，只要能玩得开心就足够了。",
            "nextDialogs": [
              "745130124"
            ]
          },
          "745130124": {
            "id": "745130124",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "#你觉得呢，{NICKNAME}？"
          }
        }
      }
    }
  ]
}
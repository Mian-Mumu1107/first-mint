    {
      "subId": "7412103",
      "subQuestName": "调查周围的情况",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "741210301"
        ],
        "dialogs": {
          "741210301": {
            "id": "741210301",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "你们好！",
            "nextDialogs": [
              "741210302"
            ]
          },
          "741210302": {
            "id": "741210302",
            "speakerId": 21091,
            "speakerName": "亨特",
            "text": "……",
            "nextDialogs": [
              "741210303"
            ]
          },
          "741210303": {
            "id": "741210303",
            "speakerId": 1533,
            "speakerName": "特纳",
            "text": "……",
            "nextDialogs": [
              "741210304"
            ]
          },
          "741210304": {
            "id": "741210304",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "喂！不要不理我！",
            "nextDialogs": [
              "741210305"
            ]
          },
          "741210305": {
            "id": "741210305",
            "speakerId": 21091,
            "speakerName": "亨特",
            "text": "…你好。",
            "nextDialogs": [
              "741210306"
            ]
          },
          "741210306": {
            "id": "741210306",
            "speakerId": 1533,
            "speakerName": "特纳",
            "text": "天气真好。",
            "nextDialogs": [
              "741210307"
            ]
          },
          "741210307": {
            "id": "741210307",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "关于那边那个人…",
            "nextDialogs": [
              "741210308"
            ]
          },
          "741210308": {
            "id": "741210308",
            "speakerId": 21091,
            "speakerName": "亨特",
            "text": "什么人？",
            "nextDialogs": [
              "741210309"
            ]
          },
          "741210309": {
            "id": "741210309",
            "speakerId": 1533,
            "speakerName": "特纳",
            "text": "我不知道什么人。",
            "nextDialogs": [
              "741210310"
            ]
          },
          "741210310": {
            "id": "741210310",
            "speakerId": 21091,
            "speakerName": "亨特",
            "text": "我们只是…",
            "nextDialogs": [
              "741210311"
            ]
          },
          "741210311": {
            "id": "741210311",
            "speakerId": 1533,
            "speakerName": "特纳",
            "text": "在这里散步。",
            "nextDialogs": [
              "741210312"
            ]
          },
          "741210312": {
            "id": "741210312",
            "speakerId": 21091,
            "speakerName": "亨特",
            "text": "没错。我们只是在这里散步。两个正在散步的普通人。",
            "nextDialogs": [
              "741210313"
            ]
          },
          "741210313": {
            "id": "741210313",
            "speakerId": 1533,
            "speakerName": "特纳",
            "text": "天气真好。散步真美妙。您不这么认为吗？",
            "nextDialogs": [
              "741210314"
            ]
          },
          "741210314": {
            "id": "741210314",
            "speakerId": 21091,
            "speakerName": "亨特",
            "text": "散步是完全正常的事情。您一定可以理解。",
            "nextDialogs": [
              "741210315"
            ]
          },
          "741210315": {
            "id": "741210315",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "呃，你们在说什么呀？",
            "nextDialogs": [
              "741210316"
            ]
          },
          "741210316": {
            "id": "741210316",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "刚刚你们听到呼救的声音了吗？在那边，有个人埋在土里，差点被螃蟹吃掉了！",
            "nextDialogs": [
              "741210317"
            ]
          },
          "741210317": {
            "id": "741210317",
            "speakerId": 21091,
            "speakerName": "亨特",
            "text": "居然会有这种事，发生在我们散步的地方？",
            "nextDialogs": [
              "741210318"
            ]
          },
          "741210318": {
            "id": "741210318",
            "speakerId": 1533,
            "speakerName": "特纳",
            "text": "发生在这么好的天气里。",
            "nextDialogs": [
              "741210319"
            ]
          },
          "741210319": {
            "id": "741210319",
            "speakerId": 21091,
            "speakerName": "亨特",
            "text": "他要是被螃蟹吃掉…",
            "nextDialogs": [
              "741210320"
            ]
          },
          "741210320": {
            "id": "741210320",
            "speakerId": 1533,
            "speakerName": "特纳",
            "text": "那就太好笑了。我是说，可怜。",
            "nextDialogs": [
              "741210321"
            ]
          },
          "741210321": {
            "id": "741210321",
            "speakerId": 21091,
            "speakerName": "亨特",
            "text": "可惜，我们不会让这种事情发生。我是说，不能。",
            "nextDialogs": [
              "741210322"
            ]
          },
          "741210322": {
            "id": "741210322",
            "speakerId": 1533,
            "speakerName": "特纳",
            "text": "如果我们在散步时遇到了，一定会制止。我是说，如果。",
            "nextDialogs": [
              "741210323"
            ]
          },
          "741210323": {
            "id": "741210323",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "你们在这里干什么？",
            "nextDialogs": [
              "741210324"
            ]
          },
          "741210324": {
            "id": "741210324",
            "speakerId": 21091,
            "speakerName": "亨特",
            "text": "散步。",
            "nextDialogs": [
              "741210325"
            ]
          },
          "741210325": {
            "id": "741210325",
            "speakerId": 1533,
            "speakerName": "特纳",
            "text": "都说了，是散步。",
            "nextDialogs": [
              "741210326"
            ]
          },
          "741210326": {
            "id": "741210326",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "真的什么都没注意到吗？",
            "nextDialogs": [
              "741210327"
            ]
          },
          "741210327": {
            "id": "741210327",
            "speakerId": 21091,
            "speakerName": "亨特",
            "text": "什么也没有。",
            "nextDialogs": [
              "741210328"
            ]
          },
          "741210328": {
            "id": "741210328",
            "speakerId": 1533,
            "speakerName": "特纳",
            "text": "没错，什么也没有。除了，有两个人正在打扰我们的散步。",
            "nextDialogs": [
              "741210329"
            ]
          },
          "741210329": {
            "id": "741210329",
            "speakerId": 21091,
            "speakerName": "亨特",
            "text": "散步是很…个人的事情。我们不喜欢被人打扰。",
            "nextDialogs": [
              "741210330"
            ]
          },
          "741210330": {
            "id": "741210330",
            "speakerId": 1533,
            "speakerName": "特纳",
            "text": "推荐您也找个好地方，去散步。露景泉就很适合。",
            "nextDialogs": [
              "741210331"
            ]
          },
          "741210331": {
            "id": "741210331",
            "speakerId": 21091,
            "speakerName": "亨特",
            "text": "但这里是我们散步的地方。我是说，感受大自然。",
            "nextDialogs": [
              "741210332"
            ]
          },
          "741210332": {
            "id": "741210332",
            "speakerId": 1533,
            "speakerName": "特纳",
            "text": "所以不希望被人打扰。再见。"
          }
        }
      }
    },

    {
      "subId": "7412101",
      "subQuestName": "击退螃蟹 $HIDDEN",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "741210101"
        ],
        "dialogs": {
          "741210101": {
            "id": "741210101",
            "speakerId": 21029,
            "speakerName": "恩里",
            "text": "谢谢！谢谢！太感谢了，你们真是我的大救星。我恩里永远不会忘记这份恩情！",
            "nextDialogs": [
              "741210102"
            ]
          },
          "741210102": {
            "id": "741210102",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "这个不提，我更好奇你是怎么落到这种处境的呀？",
            "nextDialogs": [
              "741210103"
            ]
          },
          "741210103": {
            "id": "741210103",
            "speakerId": 21029,
            "speakerName": "恩里",
            "text": "唉，那些螃蟹肯定是被烤鸡的香味吸引过来的吧。",
            "nextDialogs": [
              "741210104"
            ]
          },
          "741210104": {
            "id": "741210104",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "我也是被烤鸡的香味吸引过来的…",
            "nextDialogs": [
              "741210105"
            ]
          },
          "741210105": {
            "id": "741210105",
            "speakerId": 21029,
            "speakerName": "恩里",
            "text": "螃蟹和你可不一样！我看它们，大概在考虑是先吃我还是先吃烤鸡，生怕它们最后还是决定新鲜的更好。",
            "nextDialogs": [
              "741210107",
              "741210110"
            ]
          },
          "741210107": {
            "id": "741210107",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "欸，我问的是恩里的事情啦！正常人不会被埋在土里吧？",
            "nextDialogs": [
              "741210108"
            ]
          },
          "741210108": {
            "id": "741210108",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "所以，你需要帮忙吗？",
            "nextDialogs": [
              "741210111"
            ]
          },
          "741210111": {
            "id": "741210111",
            "speakerId": 21029,
            "speakerName": "恩里",
            "text": "当然…",
            "nextDialogs": [
              "741210112"
            ]
          },
          "741210112": {
            "id": "741210112",
            "speakerId": 21029,
            "speakerName": "恩里",
            "text": "呃…二位，当然不用！！不用帮忙把我挖出来！！",
            "nextDialogs": [
              "741210113"
            ]
          },
          "741210113": {
            "id": "741210113",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "#呜哇，知道了知道了我们听得到，不用这么大声！那我们走吧，{NICKNAME}！",
            "nextDialogs": [
              "741210114"
            ]
          },
          "741210114": {
            "id": "741210114",
            "speakerId": 21029,
            "speakerName": "恩里",
            "text": "等等，拜托你们等一下…",
            "nextDialogs": [
              "741210115"
            ]
          },
          "741210115": {
            "id": "741210115",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "嗯？怎么啦？",
            "nextDialogs": [
              "741210116"
            ]
          },
          "741210116": {
            "id": "741210116",
            "speakerId": 21029,
            "speakerName": "恩里",
            "text": "我…呃，咳咳！是这样的！！二位请听好！！这是一种刚发明的美容方法！！",
            "nextDialogs": [
              "741210117"
            ]
          },
          "741210117": {
            "id": "741210117",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "都说了不用喊啦！好吵哦！",
            "nextDialogs": [
              "741210118"
            ]
          },
          "741210118": {
            "id": "741210118",
            "speakerId": 21029,
            "speakerName": "恩里",
            "text": "二位千万不要怀疑！！我是神智健全的人，选择了这种科学又健康的美容方法！！以自己的力量，将自己埋在了潮湿的砂土中！！",
            "nextDialogs": [
              "741210119"
            ]
          },
          "741210119": {
            "id": "741210119",
            "speakerId": 21029,
            "speakerName": "恩里",
            "text": "请快点离开吧！！不要挡住我的阳光！！",
            "nextDialogs": [
              "741210120"
            ]
          },
          "741210120": {
            "id": "741210120",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "呃，那我们走吧…？",
            "nextDialogs": [
              "741210121"
            ]
          },
          "741210121": {
            "id": "741210121",
            "speakerId": 21029,
            "speakerName": "恩里",
            "text": "既然你们好奇！那就没办法了！！那就请听我解释这种美容方法的妙趣吧！！呃，砂土中的沙蚕等动物能够清除…",
            "nextDialogs": [
              "741210122"
            ]
          },
          "741210122": {
            "id": "741210122",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "#（呜哇，好吵。{NICKNAME}，这个人到底怎么回事呀？前言不搭后语的…）",
            "nextDialogs": [
              "741210123"
            ]
          },
          "741210123": {
            "id": "741210123",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "（感觉有些蹊跷…）",
            "nextDialogs": [
              "741210124"
            ]
          },
          "741210124": {
            "id": "741210124",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "（是喔？你有什么想法吗？）",
            "nextDialogs": [
              "741210125"
            ]
          },
          "741210125": {
            "id": "741210125",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "（先看看周围情况吧。）",
            "nextDialogs": [
              "741210126"
            ]
          },
          "741210126": {
            "id": "741210126",
            "speakerId": 21029,
            "speakerName": "恩里",
            "text": "哎，你们要走了吗…",
            "nextDialogs": [
              "741210127"
            ]
          },
          "741210127": {
            "id": "741210127",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "我们先看看周围的情况，再回来找你喔。",
            "nextDialogs": [
              "741210128"
            ]
          },
          "741210128": {
            "id": "741210128",
            "speakerId": 21029,
            "speakerName": "恩里",
            "text": "好的！！你们赶紧走吧！！"
          },
          "741210110": {
            "id": "741210110",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "对呀！你需要帮忙吗？"
          }
        }
      }
    },

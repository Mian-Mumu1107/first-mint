    {
      "subId": "7300303",
      "subQuestName": "寻找优丹",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "730030301"
        ],
        "dialogs": {
          "730030301": {
            "id": "730030301",
            "speakerId": 1000,
            "speakerName": "拉娜",
            "text": "呼…呼…总算好了…",
            "nextDialogs": [
              "730030302"
            ]
          },
          "730030302": {
            "id": "730030302",
            "speakerId": 1002,
            "speakerName": "优丹",
            "text": "拉娜姐姐…呜呜…",
            "nextDialogs": [
              "730030303"
            ]
          },
          "730030303": {
            "id": "730030303",
            "speakerId": 1000,
            "speakerName": "拉娜",
            "text": "优丹…你是男子汉，不要哭哦。你看……姐姐可以把在死域里的感觉…告诉他们…教令院的学者，然后，他们就能解决死域…",
            "nextDialogs": [
              "730030304"
            ]
          },
          "730030304": {
            "id": "730030304",
            "speakerId": 1000,
            "speakerName": "拉娜",
            "text": "#而且…你看到了吗…拉娜姐姐战斗的样子，不…{NICKNAME}{M#哥哥}{F#姐姐}战斗的样子，你要谢谢{M#他}{F#她}…",
            "nextDialogs": [
              "730030305"
            ]
          },
          "730030305": {
            "id": "730030305",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "拉娜…",
            "nextDialogs": [
              "730030307"
            ]
          },
          "730030307": {
            "id": "730030307",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "拉娜，你先休息一下吧…",
            "nextDialogs": [
              "730030309"
            ]
          },
          "730030309": {
            "id": "730030309",
            "speakerId": 1000,
            "speakerName": "拉娜",
            "text": "哈…哈哈…没关系，我只是觉得有点头晕，有点累…",
            "nextDialogs": [
              "730030310"
            ]
          },
          "730030310": {
            "id": "730030310",
            "speakerId": 1002,
            "speakerName": "优丹",
            "text": "拉娜姐姐…对不起…",
            "nextDialogs": [
              "730030311"
            ]
          },
          "730030311": {
            "id": "730030311",
            "speakerId": 1000,
            "speakerName": "拉娜",
            "text": "说…说什么呢，你可是我的小老虎呀，别哭！倒是你没关系吧？优丹…有没有不舒服…？会不会觉得头晕、没力气…",
            "nextDialogs": [
              "730030312"
            ]
          },
          "730030312": {
            "id": "730030312",
            "speakerId": 1002,
            "speakerName": "优丹",
            "text": "我没事，但是拉娜姐姐…",
            "nextDialogs": [
              "730030313"
            ]
          },
          "730030313": {
            "id": "730030313",
            "speakerId": 1000,
            "speakerName": "拉娜",
            "text": "嗯！没关系…拉娜姐姐没关系的，毕竟我是身经百战的巡林官！我们走吧！"
          }
        }
      }
    },
    {
      "subId": "7300304",
      "subQuestName": "深入洞窟，寻找优丹",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "730030401"
        ],
        "dialogs": {
          "730030401": {
            "id": "730030401",
            "speakerId": 1000,
            "speakerName": "拉娜",
            "text": "不用担心我…你们快去吧。"
          }
        }
      }
    },
    {
      "subId": "7300310",
      "subQuestName": "(test)【隐藏】愚人众对话$HIDDEN",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "730031001"
        ],
        "dialogs": {
          "730031001": {
            "id": "730031001",
            "speakerId": 1003,
            "speakerName": "愚人众士官",
            "text": "…你们，是谁？不要妨碍我们。",
            "nextDialogs": [
              "730031002"
            ]
          },
          "730031002": {
            "id": "730031002",
            "speakerId": 1000,
            "speakerName": "拉娜",
            "text": "哼，我才要问你是谁呢！我是这里的巡林官，正在搜寻下落不明的孩子。报上名来！",
            "nextDialogs": [
              "730031005"
            ]
          },
          "730031005": {
            "id": "730031005",
            "speakerId": 1000,
            "speakerName": "拉娜",
            "text": "哎呀？难道这就是艾方索提过的「愚人众」吗。请你说明来意。",
            "nextDialogs": [
              "730031006"
            ]
          },
          "730031006": {
            "id": "730031006",
            "speakerId": 1003,
            "speakerName": "愚人众士官",
            "text": "艾方索…？算了。反正你们谁都别想全身而退！",
            "nextDialogs": [
              "730031007"
            ]
          },
          "730031007": {
            "id": "730031007",
            "speakerId": 1000,
            "speakerName": "拉娜",
            "text": "真是的，看来没办法好好谈了！"
          }
        }
      }
    },
    {
      "subId": "7300311",
      "subQuestName": "击败愚人众及党羽",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "730031101"
        ],
        "dialogs": {
          "730031101": {
            "id": "730031101",
            "speakerId": 1000,
            "speakerName": "拉娜",
            "text": "#{NICKNAME}，幸好有你在…",
            "nextDialogs": [
              "730031105",
              "730031104"
            ]
          },
          "730031105": {
            "id": "730031105",
            "speakerId": 1000,
            "speakerName": "拉娜",
            "text": "看来，艾方索说得没错，愚人众确实很危险…",
            "nextDialogs": [
              "730031106"
            ]
          },
          "730031106": {
            "id": "730031106",
            "speakerId": 1000,
            "speakerName": "拉娜",
            "text": "——这个回头再说。优丹应该在洞窟更深处，我们赶紧走吧。"
          },
          "730031104": {
            "id": "730031104",
            "speakerId": 1000,
            "speakerName": "拉娜",
            "text": "真的吗？嘿嘿，可能是因为你和派蒙在身边吧。"
          }
        }
      }
    },
    {
      "subId": "7300315",

    {
      "subId": "7300312",
      "subQuestName": "(test)拉妮救优丹表现$HIDDEN",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "730030201"
        ],
        "dialogs": {
          "730030201": {
            "id": "730030201",
            "speakerId": 1000,
            "speakerName": "拉娜",
            "text": "优丹…怎么会这样…",
            "nextDialogs": [
              "730030202"
            ]
          },
          "730030202": {
            "id": "730030202",
            "speakerId": 1002,
            "speakerName": "优丹",
            "text": "#呜呜，拉娜姐姐…还有{M#大哥哥}{F#大姐姐}…",
            "nextDialogs": [
              "730030203"
            ]
          },
          "730030203": {
            "id": "730030203",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "欸？优丹为什么会在…死域里…而且，魔物好多…",
            "nextDialogs": [
              "730030204"
            ]
          },
          "730030204": {
            "id": "730030204",
            "speakerId": 1000,
            "speakerName": "拉娜",
            "text": "……",
            "nextDialogs": [
              "730030207"
            ]
          },
          "730030207": {
            "id": "730030207",
            "speakerId": 1000,
            "speakerName": "拉娜",
            "text": "不行…没时间了…",
            "nextDialogs": [
              "730030208"
            ]
          },
          "730030208": {
            "id": "730030208",
            "speakerId": 1000,
            "speakerName": "拉娜",
            "text": "#可恶，{NICKNAME}，拜托你了！我们一起上！",
            "nextDialogs": [
              "730030209"
            ]
          },
          "730030209": {
            "id": "730030209",
            "speakerId": 1000,
            "speakerName": "拉娜",
            "text": "优丹你乖乖待着别动！我们来救你了！"
          }
        }
      }
    },
    {
      "subId": "7300305",
      "subQuestName": "尝试消除死域",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "730030501"
        ],
        "dialogs": {
          "730030501": {
            "id": "730030501",
            "speakerId": 1004,
            "speakerName": "艾方索",
            "text": "#优丹？为什么你会…还有{NICKNAME}…",
            "nextDialogs": [
              "730030502"
            ]
          },
          "730030502": {
            "id": "730030502",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "事情紧急，我们长话短说…",
            "nextDialogs": [
              "730030503"
            ]
          },
          "730030503": {
            "id": "730030503",
            "speakerId": 1005,
            "speakerName": "Black Screen",
            "text": "简要说明了事情原委。",
            "nextDialogs": [
              "730030504"
            ]
          },
          "730030504": {
            "id": "730030504",
            "speakerId": 1004,
            "speakerName": "艾方索",
            "text": "…我明白了。优丹，你好好休息一下。",
            "nextDialogs": [
              "730030505"
            ]
          },
          "730030505": {
            "id": "730030505",
            "speakerId": 1002,
            "speakerName": "优丹",
            "text": "嗯。对不起，艾方索哥哥…",
            "nextDialogs": [
              "730030506"
            ]
          },
          "730030506": {
            "id": "730030506",
            "speakerId": 1004,
            "speakerName": "艾方索",
            "text": "#没关系，你没事就好…{NICKNAME}，你等我一下。我准备一些药物，马上跟你们去。",
            "nextDialogs": [
              "730030507"
            ]
          },
          "730030507": {
            "id": "730030507",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "没时间了。位置在这，你自己去。",
            "nextDialogs": [
              "730030508"
            ]
          },
          "730030508": {
            "id": "730030508",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "嗯，我们得赶快回去看着拉娜才行…",
            "nextDialogs": [
              "730030509"
            ]
          },
          "730030509": {
            "id": "730030509",
            "speakerId": 1004,
            "speakerName": "艾方索",
            "text": "哎，等等…"
          }
        }
      }
    },

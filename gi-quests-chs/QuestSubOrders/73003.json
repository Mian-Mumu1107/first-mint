    {
      "subId": "7300314",
      "subQuestName": "(test)(隐藏)拉妮休息对话$HIDDEN",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "730030801"
        ],
        "dialogs": {
          "730030801": {
            "id": "730030801",
            "speakerId": 1000,
            "speakerName": "拉娜",
            "text": "#抱歉…{NICKNAME}，派蒙，我想休息一下…优丹，等一下姐姐哦。",
            "nextDialogs": [
              "730030802"
            ]
          },
          "730030802": {
            "id": "730030802",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "拉娜，真的不要紧吗…",
            "nextDialogs": [
              "730030803"
            ]
          },
          "730030803": {
            "id": "730030803",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "我们去找人帮忙…",
            "nextDialogs": [
              "730030804"
            ]
          },
          "730030804": {
            "id": "730030804",
            "speakerId": 1000,
            "speakerName": "拉娜",
            "text": "没关系、没关系…我稍微，歇一下就好…",
            "nextDialogs": [
              "730030805"
            ]
          },
          "730030805": {
            "id": "730030805",
            "speakerId": 1002,
            "speakerName": "优丹",
            "text": "对不起，拉娜姐姐…对不起…",
            "nextDialogs": [
              "730030806"
            ]
          },
          "730030806": {
            "id": "730030806",
            "speakerId": 1000,
            "speakerName": "拉娜",
            "text": "真是的…都说了，没事的啦！不过，拉娜姐姐很生气哦…",
            "nextDialogs": [
              "730030807"
            ]
          },
          "730030807": {
            "id": "730030807",
            "speakerId": 1000,
            "speakerName": "拉娜",
            "text": "明明答应了姐姐…不要到森林里来…都说好了的。等拉娜姐姐，休息好了，一定要好好教训你这个不听话的…坏家伙…",
            "nextDialogs": [
              "730030808"
            ]
          },
          "730030808": {
            "id": "730030808",
            "speakerId": 1002,
            "speakerName": "优丹",
            "text": "呜呜…我只是之前听艾方索哥哥说，这边有很大的蘑菇！我想给姐姐采一些新鲜的蘑菇，姐姐吃了，就会很有精神…",
            "nextDialogs": [
              "730030809"
            ]
          },
          "730030809": {
            "id": "730030809",
            "speakerId": 1000,
            "speakerName": "拉娜",
            "text": "笨蛋…真是多此一举，拉娜姐姐只要想着大家，就会很有精神…",
            "nextDialogs": [
              "730030810"
            ]
          },
          "730030810": {
            "id": "730030810",
            "speakerId": 1000,
            "speakerName": "拉娜",
            "text": "不过，哈哈哈…这里的蘑菇，真的好大…如果拿去煮咖喱，一定很好吃…",
            "nextDialogs": [
              "730030811"
            ]
          },
          "730030811": {
            "id": "730030811",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "是艾方索让你来的？",
            "nextDialogs": [
              "730030812"
            ]
          },
          "730030812": {
            "id": "730030812",
            "speakerId": 1002,
            "speakerName": "优丹",
            "text": "不是…艾方索哥哥也说，不要随便跑到外面去。不过，优丹就是想要拉娜姐姐吃好吃的…所以…",
            "nextDialogs": [
              "730030813"
            ]
          },
          "730030813": {
            "id": "730030813",
            "speakerId": 1000,
            "speakerName": "拉娜",
            "text": "艾方索才不会做这种事情，他可是优丹的哥哥…",
            "nextDialogs": [
              "730030814"
            ]
          },
          "730030814": {
            "id": "730030814",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "也是…不过，优丹又怎么会困在死域里呢？",
            "nextDialogs": [
              "730030815"
            ]
          },
          "730030815": {
            "id": "730030815",
            "speakerId": 1002,
            "speakerName": "优丹",
            "text": "在林子里，我觉得好像有人跟着我…我好害怕，我觉得是「无留陀的化身」…我就一直跑…呜呜…",
            "nextDialogs": [
              "730030816"
            ]
          },
          "730030816": {
            "id": "730030816",
            "speakerId": 1002,
            "speakerName": "优丹",
            "text": "结果，就跑到了「无留陀」里…",
            "nextDialogs": [
              "730030817"
            ]
          },
          "730030817": {
            "id": "730030817",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "？",
            "nextDialogs": [
              "730030819",
              "730030824"
            ]
          },
          "730030819": {
            "id": "730030819",
            "speakerId": 1000,
            "speakerName": "拉娜",
            "text": "也就是…死域。",
            "nextDialogs": [
              "730030820"
            ]
          },
          "730030820": {
            "id": "730030820",
            "speakerId": 1002,
            "speakerName": "优丹",
            "text": "啊…对，就是死域。",
            "nextDialogs": [
              "730030821"
            ]
          },
          "730030821": {
            "id": "730030821",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "「无留陀的化身」？",
            "nextDialogs": [
              "730030822"
            ]
          },
          "730030822": {
            "id": "730030822",
            "speakerId": 1002,
            "speakerName": "优丹",
            "text": "嗯。也就是替代无留陀在大地上，做坏事的…黑黑的、高高的东西…",
            "nextDialogs": [
              "730030828"
            ]
          },
          "730030828": {
            "id": "730030828",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "无留陀…好奇怪的名字。",
            "nextDialogs": [
              "730030829"
            ]
          },
          "730030829": {
            "id": "730030829",
            "speakerId": 1000,
            "speakerName": "拉娜",
            "text": "嗯，为什么我会知道无留陀就是死域…？可恶…头好晕…",
            "nextDialogs": [
              "730030830"
            ]
          },
          "730030830": {
            "id": "730030830",
            "speakerId": 1000,
            "speakerName": "拉娜",
            "text": "刚刚，优丹，那个绿色的是什么？",
            "nextDialogs": [
              "730030831"
            ]
          },
          "730030831": {
            "id": "730030831",
            "speakerId": 1002,
            "speakerName": "优丹",
            "text": "……",
            "nextDialogs": [
              "730030832"

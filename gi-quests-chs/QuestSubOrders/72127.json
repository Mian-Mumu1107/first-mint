  },
  "subQuests": [
    {
      "subId": "7212701",
      "subQuestName": "",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "721270101"
        ],
        "dialogs": {
          "721270101": {
            "id": "721270101",
            "speakerId": 3165,
            "speakerName": "叶名山薰",
            "text": "您来啦，您注意到周围了吧，已经有很多花开了，怎么样，漂亮吗？",
            "nextDialogs": [
              "721270103",
              "721270105"
            ]
          },
          "721270103": {
            "id": "721270103",
            "speakerId": 3165,
            "speakerName": "叶名山薰",
            "text": "嘿嘿…那当然啦。我可是很用心在照顾它们呢…",
            "nextDialogs": [
              "721270106"
            ]
          },
          "721270106": {
            "id": "721270106",
            "speakerId": 3165,
            "speakerName": "叶名山薰",
            "text": "对了，能请您再帮我个忙吗？现在花开得这么好了，我本来想要去摘几朵花做成干花，和信一起寄给那些还没有回踏鞴砂的人。",
            "nextDialogs": [
              "721270107"
            ]
          },
          "721270107": {
            "id": "721270107",
            "speakerId": 3165,
            "speakerName": "叶名山薰",
            "text": "但是…不知道是不是我睡太少了，刚才出去采了几朵花就累得不行…",
            "nextDialogs": [
              "721270108"
            ]
          },
          "721270108": {
            "id": "721270108",
            "speakerId": 3165,
            "speakerName": "叶名山薰",
            "text": "能拜托您帮我去这周围摘几朵甜甜花来吗？只要三朵就好。"
          },
          "721270105": {
            "id": "721270105",
            "speakerId": 3165,
            "speakerName": "叶名山薰",
            "text": "也没有太久啦，就是…就是稍微少睡了一会而已。"
          }
        }
      }
    },
    {
      "subId": "7212702",
      "subQuestName": "",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "721270201"
        ],
        "dialogs": {
          "721270201": {
            "id": "721270201",
            "speakerId": 3165,
            "speakerName": "叶名山薰",
            "text": "您摘到甜甜花了吗？"
          }
        }
      }
    },
    {
      "subId": "7212703",
      "subQuestName": "",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "721270301"
        ],
        "dialogs": {
          "721270301": {
            "id": "721270301",
            "speakerId": 3165,
            "speakerName": "叶名山薰",
            "text": "谢谢您，这些甜甜花就够了，等会我就去做干花。",
            "nextDialogs": [
              "721270302"
            ]
          },
          "721270302": {
            "id": "721270302",
            "speakerId": 3165,
            "speakerName": "叶名山薰",
            "text": "对了，我还有一个小礼物送给您。",
            "nextDialogs": [
              "721270303"
            ]
          },
          "721270303": {
            "id": "721270303",
            "speakerId": 3165,
            "speakerName": "叶名山薰",
            "text": "喏，这朵干花请您拿好啦，虽然有点枯了…但这可是一朵很宝贵的花喔。",
            "nextDialogs": [
              "721270307",
              "721270306"
            ]
          },
          "721270307": {
            "id": "721270307",
            "speakerId": 3165,
            "speakerName": "叶名山薰",
            "text": "这可是这片花海里长出来的第一朵花，是您帮我找到的花种，所以，我想把这朵花送给您。",
            "nextDialogs": [
              "721270308"
            ]
          },
          "721270308": {
            "id": "721270308",
            "speakerId": 3165,
            "speakerName": "叶名山薰",
            "text": "虽然也不是什么很有价值的东西，但还是…非常谢谢您！",
            "nextDialogs": [
              "721270309"
            ]
          },
          "721270309": {
            "id": "721270309",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "大家都会回来的。",
            "nextDialogs": [
              "721270310"
            ]
          },
          "721270310": {
            "id": "721270310",
            "speakerId": 3165,
            "speakerName": "叶名山薰",
            "text": "嗯！所以我得再多种点花，这样大家回来的时候，就能看到更多的花了。"
          },
          "721270306": {
            "id": "721270306",
            "speakerId": 3165,
            "speakerName": "叶名山薰",
            "text": "当然有特别的地方啦，不然我可不会特别把它送给您呢。"
          }
        }
      }
    }
  ]
}
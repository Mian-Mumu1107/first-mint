  "subQuests": [
    {
      "subId": "7720205",
      "subQuestName": "(test)隐藏$HIDDEN",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "772020101"
        ],
        "dialogs": {
          "772020101": {
            "id": "772020101",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "唔，帐篷里没有人，不过也没有太多的积雪…",
            "nextDialogs": [
              "772020102"
            ]
          },
          "772020102": {
            "id": "772020102",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "什么人会到这里来呢…真是奇怪。",
            "nextDialogs": [
              "772020103"
            ]
          },
          "772020103": {
            "id": "772020103",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "这个是什么，冒险手记吗…",
            "nextDialogs": [
              "772020104"
            ]
          },
          "772020104": {
            "id": "772020104",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "「风雪就像面具一样扣在了脸上，眼睛都睁不开，根本找不到路，别说是去赫斯珀利德斯之馆，回家的路也…」",
            "nextDialogs": [
              "772020105"
            ]
          },
          "772020105": {
            "id": "772020105",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "「还好，找到了能够躲避风雪的山洞，可食物已经见底…也许一开始就不该…不行，这一定是对我的考验。」",
            "nextDialogs": [
              "772020106"
            ]
          },
          "772020106": {
            "id": "772020106",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "「我一定要到公馆，去见见那位大人…去见识见识真正的臻冰技艺。」",
            "nextDialogs": [
              "772020107"
            ]
          },
          "772020107": {
            "id": "772020107",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "「可是该怎么出去呢…也许，可以顺着这个山洞往前再探探…」",
            "nextDialogs": [
              "772020108"
            ]
          },
          "772020108": {
            "id": "772020108",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "「唔，好像已经适应这份温度，周围都开始变得暖和一点了。」",
            "nextDialogs": [
              "772020109"
            ]
          },
          "772020109": {
            "id": "772020109",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "哇，这个人没事吧，感觉都已经快冻出幻觉了。",
            "nextDialogs": [
              "772020111",
              "772020113"
            ]
          },
          "772020111": {
            "id": "772020111",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "在冰天雪地里觉得暖和才是最可怕的！",
            "nextDialogs": [
              "772020114"
            ]
          },
          "772020114": {
            "id": "772020114",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "他留下的手记里说，他顺着山洞往前…我们也往前看看吧，不知道他还有没有救…"
          },
          "772020113": {
            "id": "772020113",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "是啊…"
          }
        }
      }
    },

    {
      "subId": "7720204",
      "subQuestName": "和马尔托斯对话",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "772020401"
        ],
        "dialogs": {
          "772020401": {
            "id": "772020401",
            "speakerId": 1001,
            "speakerName": "？？？",
            "text": "呼、呼…吓死了…要是掉进水里，那真的要…小命不保。",
            "nextDialogs": [
              "772020402"
            ]
          },
          "772020402": {
            "id": "772020402",
            "speakerId": 1001,
            "speakerName": "？？？",
            "text": "感谢两位，我…我叫马尔托斯…抱歉…",
            "nextDialogs": [
              "772020403"
            ]
          },
          "772020403": {
            "id": "772020403",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "为什么要抱歉？",
            "nextDialogs": [
              "772020404"
            ]
          },
          "772020404": {
            "id": "772020404",
            "speakerId": 1003,
            "speakerName": "马尔托斯",
            "text": "…我本来想提醒二位那块冰不太坚固，可是，在那上面，不知道为什么，说不出话来。",
            "nextDialogs": [
              "772020405"
            ]
          },
          "772020405": {
            "id": "772020405",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "一定是因为那时候你身子太过虚弱…不过，现在好些了吗？",
            "nextDialogs": [
              "772020406"
            ]
          },
          "772020406": {
            "id": "772020406",
            "speakerId": 1003,
            "speakerName": "马尔托斯",
            "text": "现在好些了，多谢二位…呼…还不知道，两位恩人的名字是…",
            "nextDialogs": [
              "772020407"
            ]
          },
          "772020407": {
            "id": "772020407",
            "speakerId": 1004,
            "speakerName": "Black Screen",
            "text": "向马尔托斯作了自我介绍。",
            "nextDialogs": [
              "772020408"
            ]
          },
          "772020408": {
            "id": "772020408",
            "speakerId": 1003,
            "speakerName": "马尔托斯",
            "text": "#{NICKNAME}和派蒙，原来如此。",
            "nextDialogs": [
              "772020409"
            ]
          },
          "772020409": {
            "id": "772020409",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "…不过马尔托斯，你到这里来，是为了什么呀。冰天雪地的…",
            "nextDialogs": [
              "772020410"
            ]
          },
          "772020410": {
            "id": "772020410",
            "speakerId": 1003,
            "speakerName": "马尔托斯",
            "text": "臻冰雕塑，我是来学习臻冰雕塑的…",
            "nextDialogs": [
              "772020411"
            ]
          },
          "772020411": {
            "id": "772020411",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "臻冰雕塑？",
            "nextDialogs": [
              "772020412"
            ]
          },
          "772020412": {
            "id": "772020412",
            "speakerId": 1003,
            "speakerName": "马尔托斯",
            "text": "对！咳咳…我本来是想去赫斯珀利德斯之馆，馆的主人是精通臻冰技艺的雪精的王公…",
            "nextDialogs": [
              "772020413"
            ]
          },
          "772020413": {
            "id": "772020413",
            "speakerId": 1003,
            "speakerName": "马尔托斯",
            "text": "许多佳作都出自她手，就连至冬宫广场中心的雪花，新基捷王公府前仿晶矿的雕塑，都是她的作品…",
            "nextDialogs": [
              "772020414"
            ]
          },
          "772020414": {
            "id": "772020414",
            "speakerId": 1003,
            "speakerName": "马尔托斯",
            "text": "人类虽然无法如妖精那般驱使臻冰…但是亦可用锤与凿雕琢出同样的美。",
            "nextDialogs": [
              "772020415"
            ]
          },
          "772020415": {
            "id": "772020415",
            "speakerId": 1003,
            "speakerName": "马尔托斯",
            "text": "感谢二位的帮忙，我离公馆又更近一步啦！",
            "nextDialogs": [
              "772020416"
            ]
          },
          "772020416": {
            "id": "772020416",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "啊，你还要去山上的公馆啊！",
            "nextDialogs": [
              "772020417"
            ]
          },
          "772020417": {
            "id": "772020417",
            "speakerId": 1003,
            "speakerName": "马尔托斯",
            "text": "都到了这步，回头反而会不太甘心呐…",
            "nextDialogs": [
              "772020418"
            ]
          },
          "772020418": {
            "id": "772020418",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "可是…",
            "nextDialogs": [
              "772020421"
            ]
          },
          "772020421": {
            "id": "772020421",
            "speakerId": 1003,
            "speakerName": "马尔托斯",
            "text": "会的。",
            "nextDialogs": [
              "772020422"
            ]
          },
          "772020422": {
            "id": "772020422",
            "speakerId": 1004,
            "speakerName": "Black Screen",
            "text": "你在这里为他生起了火，并分给了他一些食物与水。",
            "nextDialogs": [
              "772020423"
            ]
          },
          "772020423": {
            "id": "772020423",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "吃饱喝足，身体暖和了，这样才好继续前进！",
            "nextDialogs": [
              "772020424"
            ]
          },
          "772020424": {
            "id": "772020424",
            "speakerId": 1003,
            "speakerName": "马尔托斯",
            "text": "…真、真是太感谢了。",
            "nextDialogs": [
              "772020425"
            ]
          },
          "772020425": {
            "id": "772020425",
            "speakerId": 1003,
            "speakerName": "马尔托斯",
            "text": "两位，如果我能学成，我一定，一定为两位做一尊了不起的雕像！"
          }
        }
      }
    },

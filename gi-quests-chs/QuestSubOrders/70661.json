    {
      "subId": "7066106",
      "subQuestName": "与楠塔克对话",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "706610601"
        ],
        "dialogs": {
          "706610601": {
            "id": "706610601",
            "speakerId": 1002,
            "speakerName": "楠塔克",
            "text": "怎么样？看你的表情，应该收获还不错吧！给我看看。",
            "nextDialogs": [
              "706610602"
            ]
          },
          "706610602": {
            "id": "706610602",
            "speakerId": 1002,
            "speakerName": "楠塔克",
            "text": "哦？是新发现的鱼种！真不错。",
            "nextDialogs": [
              "706610603"
            ]
          },
          "706610603": {
            "id": "706610603",
            "speakerId": 1002,
            "speakerName": "楠塔克",
            "text": "都快赶上当年的我了，哈哈，哈哈哈！",
            "nextDialogs": [
              "706610604"
            ]
          },
          "706610604": {
            "id": "706610604",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "你也能徒手抓鱼吗？",
            "nextDialogs": [
              "706610605"
            ]
          },
          "706610605": {
            "id": "706610605",
            "speakerId": 1002,
            "speakerName": "楠塔克",
            "text": "咳咳…看来这种普通的小鱼对你完全没有压力啊，应该给你来点更有挑战的...",
            "nextDialogs": [
              "706610606"
            ]
          },
          "706610606": {
            "id": "706610606",
            "speakerId": 1002,
            "speakerName": "楠塔克",
            "text": "你可能不知道，即使是同一种鱼，个体之间也会因为生活环境和食物的不同，而产生很大的区别。",
            "nextDialogs": [
              "706610607"
            ]
          },
          "706610607": {
            "id": "706610607",
            "speakerId": 1002,
            "speakerName": "楠塔克",
            "text": "即使看上去都长得一样，但有些个体会特别活跃，精力旺盛，它们时常会跃出水面，十分醒目。",
            "nextDialogs": [
              "706610608"
            ]
          },
          "706610608": {
            "id": "706610608",
            "speakerId": 1002,
            "speakerName": "楠塔克",
            "text": "这些个体无论是商业价值还是观赏价值都要更加优秀。",
            "nextDialogs": [
              "706610609"
            ]
          },
          "706610609": {
            "id": "706610609",
            "speakerId": 1002,
            "speakerName": "楠塔克",
            "text": "很多爱好者都会高价购入，放在家中的鱼缸饲养，用作观赏。所以也被称为「观赏鱼」。",
            "nextDialogs": [
              "706610610"
            ]
          },
          "706610610": {
            "id": "706610610",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "意思是除了「应急派蒙」外…",
            "nextDialogs": [
              "706610611"
            ]
          },
          "706610611": {
            "id": "706610611",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "还有一种「观赏派蒙」！",
            "nextDialogs": [
              "706610612"
            ]
          },
          "706610612": {
            "id": "706610612",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "才不是！派蒙哪有那么多种啦？！",
            "nextDialogs": [
              "706610613"
            ]
          },
          "706610613": {
            "id": "706610613",
            "speakerId": 1002,
            "speakerName": "楠塔克",
            "text": "就是这个道理！看来你已经完全理解了。",
            "nextDialogs": [
              "706610614"
            ]
          },
          "706610614": {
            "id": "706610614",
            "speakerId": 1002,
            "speakerName": "楠塔克",
            "text": "最近，望风山地附近的水域活跃着很多「观赏鱼」，我在你的地图上标注出来了。",
            "nextDialogs": [
              "706610615"
            ]
          },
          "706610615": {
            "id": "706610615",
            "speakerId": 1002,
            "speakerName": "楠塔克",
            "text": "现在就过去看看吧。"
          }
        }
      }
    },
    {
      "subId": "7066109",
      "subQuestName": "和楠塔克对话",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "706610701"
        ],
        "dialogs": {
          "706610701": {
            "id": "706610701",
            "speakerId": 1002,
            "speakerName": "楠塔克",
            "text": "怎么样？看你的表情，应该收获还不错吧！给我看看。",
            "nextDialogs": [
              "706610702"
            ]
          },
          "706610702": {
            "id": "706610702",
            "speakerId": 1002,
            "speakerName": "楠塔克",
            "text": "哦？是新发现的鱼种！真不错。欸…等等，你包里另外那条鱼是什么？",
            "nextDialogs": [
              "706610703"
            ]
          },
          "706610703": {
            "id": "706610703",
            "speakerId": 1002,
            "speakerName": "楠塔克",
            "text": "喔——实在是了不起！你知道这是什么吗？这可是「观赏鱼」啊！",
            "nextDialogs": [
              "706610704"
            ]
          },
          "706610704": {
            "id": "706610704",
            "speakerId": 1002,
            "speakerName": "楠塔克",
            "text": "你可能不清楚，即使是同一种鱼，个体之间也会因为生活环境和食物的不同，而产生很大的区别。",
            "nextDialogs": [
              "706610705"
            ]
          },
          "706610705": {
            "id": "706610705",
            "speakerId": 1002,
            "speakerName": "楠塔克",
            "text": "即使看上去都长得一样，但有些个体会特别活跃，精力旺盛，它们时常会跃出水面，十分醒目。",
            "nextDialogs": [
              "706610706"
            ]
          },
          "706610706": {
            "id": "706610706",
            "speakerId": 1002,
            "speakerName": "楠塔克",
            "text": "这些个体无论是商业价值还是观赏价值都要更加优秀。",
            "nextDialogs": [
              "706610707"
            ]
          },
          "706610707": {
            "id": "706610707",
            "speakerId": 1002,
            "speakerName": "楠塔克",
            "text": "很多爱好者都会高价购入，放在家中的鱼缸饲养，用作观赏。",
            "nextDialogs": [
              "706610708"
            ]
          },
          "706610708": {
            "id": "706610708",
            "speakerId": 1002,
            "speakerName": "楠塔克",
            "text": "你包里这条，就是一条货真价实的「观赏鱼」。",
            "nextDialogs": [
              "706610709"
            ]
          },
          "706610709": {
            "id": "706610709",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "意思是除了「应急派蒙」外…",
            "nextDialogs": [
              "706610710"
            ]
          },
          "706610710": {
            "id": "706610710",
            "speakerId": -1,

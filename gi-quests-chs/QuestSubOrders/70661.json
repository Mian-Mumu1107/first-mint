  "subQuests": [
    {
      "subId": "7066101",
      "subQuestName": "与蒙德的凯瑟琳对话",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "706610101"
        ],
        "dialogs": {
          "706610101": {
            "id": "706610101",
            "speakerId": 1000,
            "speakerName": "凯瑟琳",
            "text": "向着星辰与深渊，欢迎来到冒险家协会。",
            "nextDialogs": [
              "706610102"
            ]
          },
          "706610102": {
            "id": "706610102",
            "speakerId": 1000,
            "speakerName": "凯瑟琳",
            "text": "我们最近接到了一份钓鱼协会的委托，他们声称附近水域的鱼类活动出现了异常。",
            "nextDialogs": [
              "706610103"
            ]
          },
          "706610103": {
            "id": "706610103",
            "speakerId": 1000,
            "speakerName": "凯瑟琳",
            "text": "不过具体情况倒没有说明，您能帮忙去看看吗？",
            "nextDialogs": [
              "706610104"
            ]
          },
          "706610104": {
            "id": "706610104",
            "speakerId": 1000,
            "speakerName": "凯瑟琳",
            "text": "我想是您的话，无论什么情况，一定都能轻松应对。",
            "nextDialogs": [
              "706610105"
            ]
          },
          "706610105": {
            "id": "706610105",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "钓鱼协会？是那个钓鱼吗？",
            "nextDialogs": [
              "706610106"
            ]
          },
          "706610106": {
            "id": "706610106",
            "speakerId": 1000,
            "speakerName": "凯瑟琳",
            "text": "欸？那个钓鱼？我不太明白…您说的钓鱼，是哪个钓鱼？",
            "nextDialogs": [
              "706610107"
            ]
          },
          "706610107": {
            "id": "706610107",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "哎呀，钓鱼协会钓鱼协会，一听就是钓上了很多好吃的鱼的协会！",
            "nextDialogs": [
              "706610108"
            ]
          },
          "706610108": {
            "id": "706610108",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "不要浪费时间了啦，我们赶紧去看看吧！嘿，嘿嘿嘿…"
          }
        }
      }
    },
    {
      "subId": "7066102",
      "subQuestName": "与楠塔克对话",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "706610201"
        ],
        "dialogs": {
          "706610201": {
            "id": "706610201",
            "speakerId": 1002,
            "speakerName": "楠塔克",
            "text": "最近的鱼可真是活跃啊…",
            "nextDialogs": [
              "706610202"
            ]
          },
          "706610202": {
            "id": "706610202",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "有什么需要帮忙的吗？",
            "nextDialogs": [
              "706610203"
            ]
          },
          "706610203": {
            "id": "706610203",
            "speakerId": 1002,
            "speakerName": "楠塔克",
            "text": "啊，帮手终于来了，你们好！",
            "nextDialogs": [
              "706610204"
            ]
          },
          "706610204": {
            "id": "706610204",
            "speakerId": 1002,
            "speakerName": "楠塔克",
            "text": "我是楠塔克，蒙德鱼协的资深钓鱼家，咳咳。",
            "nextDialogs": [
              "706610205"
            ]
          },
          "706610205": {
            "id": "706610205",
            "speakerId": 1002,
            "speakerName": "楠塔克",
            "text": "最近，附近水域突然出现了很多新鱼种。",
            "nextDialogs": [
              "706610206"
            ]
          },
          "706610206": {
            "id": "706610206",
            "speakerId": 1002,
            "speakerName": "楠塔克",
            "text": "我立刻和其他地区的同好交流，果然，各地都出现了这种情况。",
            "nextDialogs": [
              "706610207"
            ]
          },
          "706610207": {
            "id": "706610207",
            "speakerId": 1002,
            "speakerName": "楠塔克",
            "text": "还有人说，这是提瓦特来到了百年一见的鱼类爆发期呢。",
            "nextDialogs": [
              "706610208"
            ]
          },
          "706610208": {
            "id": "706610208",
            "speakerId": 1002,
            "speakerName": "楠塔克",
            "text": "其实原因还没有完全查明，但我猜多少都跟生态环境变好有关系...",
            "nextDialogs": [
              "706610209"
            ]
          },
          "706610209": {
            "id": "706610209",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "喔——一定是这些家伙太多，给你们带来了麻烦吧？",
            "nextDialogs": [
              "706610210"
            ]
          },
          "706610210": {
            "id": "706610210",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "别担心，包在派蒙身上吧！只要它们不难吃的话…",
            "nextDialogs": [
              "706610211"
            ]
          },
          "706610211": {
            "id": "706610211",
            "speakerId": 1002,
            "speakerName": "楠塔克",
            "text": "哈哈，倒也不是麻烦，对钓鱼协会来说，鱼群当然是越多越好，只不过前提是人手足够。",
            "nextDialogs": [
              "706610212"
            ]
          },
          "706610212": {
            "id": "706610212",
            "speakerId": 1002,
            "speakerName": "楠塔克",
            "text": "但实话说，以我们现有的人力来看…",
            "nextDialogs": [
              "706610213"
            ]
          },
          "706610213": {
            "id": "706610213",
            "speakerId": 1002,
            "speakerName": "楠塔克",
            "text": "要在短期钓上来所有的新鱼种来做研究…确实有些压力。",
            "nextDialogs": [
              "706610214"
            ]
          },
          "706610214": {
            "id": "706610214",
            "speakerId": 1002,
            "speakerName": "楠塔克",
            "text": "不过反过来看，这不也是钓鱼协会发展的绝佳机会吗？",
            "nextDialogs": [
              "706610215"
            ]
          },
          "706610215": {
            "id": "706610215",
            "speakerId": 1002,
            "speakerName": "楠塔克",
            "text": "所以我就在冒险家协会挂上了委托。怎么样？有兴趣加入我们吗？",
            "nextDialogs": [
              "706610216"
            ]
          },
          "706610216": {
            "id": "706610216",
            "speakerId": 1002,
            "speakerName": "楠塔克",
            "text": "钓鱼可是很有意思的哦。",
            "nextDialogs": [
              "706610218",
              "706610220"
            ]
          },
          "706610218": {
            "id": "706610218",
            "speakerId": 1002,
            "speakerName": "楠塔克",
            "text": "好，真是充满干劲的年轻人啊！",
            "nextDialogs": [
              "706610223"
            ]
          },
          "706610223": {
            "id": "706610223",
            "speakerId": 1002,
            "speakerName": "楠塔克",
            "text": "那么现在，先跟我去果酒湖另一边吧。",
            "nextDialogs": [
              "706610224"
            ]
          },
          "706610224": {
            "id": "706610224",
            "speakerId": 1002,
            "speakerName": "楠塔克",
            "text": "那里有我们给新人准备的钓鱼场地，我先教你些最基本的技巧。"
          },
          "706610220": {
            "id": "706610220",
            "speakerId": 1002,
            "speakerName": "楠塔克",
            "text": "直接跳下去多危险呀？你们这些冒险家还真是勇敢…",
            "nextDialogs": [
              "706610221"
            ]
          },
          "706610221": {
            "id": "706610221",
            "speakerId": 1002,
            "speakerName": "楠塔克",
            "text": "可惜那些鱼儿没你们勇敢，看见这么大个活人跳进水里，它们肯定全吓跑了。",
            "nextDialogs": [
              "706610222"
            ]
          },
          "706610222": {
            "id": "706610222",
            "speakerId": 1002,
            "speakerName": "楠塔克",
            "text": "还是不要做这种事比较好。"
          }
        }
      }
    },
    {
      "subId": "7066103",
      "subQuestName": "在果酒湖畔和楠塔克见面",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "706610401"
        ],
        "dialogs": {
          "706610401": {
            "id": "706610401",
            "speakerId": 1002,
            "speakerName": "楠塔克",
            "text": "就这里了！看见水里那些小鱼儿了吗？真漂亮...",
            "nextDialogs": [
              "706610402"
            ]
          },
          "706610402": {
            "id": "706610402",
            "speakerId": 1002,
            "speakerName": "楠塔克",
            "text": "这些是给你准备的工具，有鱼竿、鱼饵、还有鱼饵的制作配方。",
            "nextDialogs": [
              "706610403"
            ]
          },
          "706610403": {
            "id": "706610403",
            "speakerId": 1002,
            "speakerName": "楠塔克",
            "text": "先在鱼钩上填好鱼饵，再瞄准鱼群聚集的地方…抛竿！然后乖乖等鱼儿上钩。",
            "nextDialogs": [
              "706610404"
            ]
          },
          "706610404": {
            "id": "706610404",
            "speakerId": 1002,
            "speakerName": "楠塔克",
            "text": "听说新人身上都会有「新手好运」啊，我当年可是钓上了一条半米多的大鲈鱼！你也来试试吧！",
            "nextDialogs": [
              "706610405"
            ]
          },
          "706610405": {
            "id": "706610405",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "希望能再钓一只小派蒙吧。",
            "nextDialogs": [
              "706610406"
            ]
          },
          "706610406": {
            "id": "706610406",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "有一个我还不够吗？！",
            "nextDialogs": [
              "706610407"
            ]
          },
          "706610407": {
            "id": "706610407",
            "speakerId": 1002,
            "speakerName": "楠塔克",
            "text": "派蒙？这个名字倒是很陌生，也是一种鱼吗？",
            "nextDialogs": [
              "706610408"
            ]
          },
          "706610408": {
            "id": "706610408",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "是以前钓的「神奇海鲜」。",
            "nextDialogs": [
              "706610409"
            ]
          },
          "706610409": {
            "id": "706610409",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "喂！已经从「应急食品」变成「神奇海鲜」了吗？",
            "nextDialogs": [
              "706610410"
            ]
          },
          "706610410": {
            "id": "706610410",
            "speakerId": 1002,
            "speakerName": "楠塔克",
            "text": "原来如此！没想到你已经是个小有经验的钓鱼家了啊。",
            "nextDialogs": [
              "706610411"
            ]
          },
          "706610411": {
            "id": "706610411",
            "speakerId": 1002,
            "speakerName": "楠塔克",
            "text": "那我就更加期待你的收获了！"
          }
        }
      }
    },

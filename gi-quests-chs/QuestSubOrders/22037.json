    {
      "subId": "2203703",
      "subQuestName": "与绀田传助对话",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "220370301"
        ],
        "dialogs": {
          "220370301": {
            "id": "220370301",
            "speakerId": 1001,
            "speakerName": "绀田传助",
            "text": "你都摘干净了吗？",
            "nextDialogs": [
              "220370302"
            ]
          },
          "220370302": {
            "id": "220370302",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "摘来的蘑菇都在这里了。",
            "nextDialogs": [
              "220370303"
            ]
          },
          "220370303": {
            "id": "220370303",
            "speakerId": 1001,
            "speakerName": "绀田传助",
            "text": "只有这些吗？我印象里，地里长出的蘑菇不止这些啊，是不是没摘干净啊…",
            "nextDialogs": [
              "220370304"
            ]
          },
          "220370304": {
            "id": "220370304",
            "speakerId": 1001,
            "speakerName": "绀田传助",
            "text": "但无论如何我都要谢谢你，年轻人。这些东西给你，就当做是报酬吧。",
            "nextDialogs": [
              "220370305"
            ]
          },
          "220370305": {
            "id": "220370305",
            "speakerId": 1001,
            "speakerName": "绀田传助",
            "text": "不过，这肥料还真是厉害啊，居然能让蘑菇长这么快，要是庄稼也能长这么快就好了。",
            "nextDialogs": [
              "220370306"
            ]
          },
          "220370306": {
            "id": "220370306",
            "speakerId": 1001,
            "speakerName": "绀田传助",
            "text": "等我有空了之后，一定要再买点回来试试…"
          }
        }
      }
    },
    {
      "subId": "2203704",
      "subQuestName": "与绀田传助对话",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "220370403"
        ],
        "dialogs": {
          "220370403": {
            "id": "220370403",
            "speakerId": 1001,
            "speakerName": "绀田传助",
            "text": "你都摘干净了吗？",
            "nextDialogs": [
              "220370404"
            ]
          },
          "220370404": {
            "id": "220370404",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "摘来的蘑菇都在这里了。",
            "nextDialogs": [
              "220370405"
            ]
          },
          "220370405": {
            "id": "220370405",
            "speakerId": 1001,
            "speakerName": "绀田传助",
            "text": "地里长出的蘑菇还真不少啊，看来是都摘干净了。",
            "nextDialogs": [
              "220370406"
            ]
          },
          "220370406": {
            "id": "220370406",
            "speakerId": 1001,
            "speakerName": "绀田传助",
            "text": "谢谢你了年轻人，没你帮忙，我都不知道怎么办了。这些东西给你，就当做是报酬吧。",
            "nextDialogs": [
              "220370407"
            ]
          },
          "220370407": {
            "id": "220370407",
            "speakerId": 1001,
            "speakerName": "绀田传助",
            "text": "不过，这肥料还真是厉害啊，居然能让蘑菇长这么快，要是庄稼也能长这么快就好了。",
            "nextDialogs": [
              "220370408"
            ]
          },
          "220370408": {
            "id": "220370408",
            "speakerId": 1001,
            "speakerName": "绀田传助",
            "text": "等我有空了之后，一定要再买点回来试试…"
          }
        }
      }
    }
  ]
}
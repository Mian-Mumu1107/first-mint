    {
      "subId": "7507903",
      "subQuestName": "与特马乔对话",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "750790301"
        ],
        "dialogs": {
          "750790301": {
            "id": "750790301",
            "speakerId": 6274,
            "speakerName": "特马乔",
            "text": "#欢迎…呃，看来你们之中至少有一个已经熟练掌握了翱翔的要义，那么是这位{M#小兄弟}{F#小妹}想学习飞行技巧？",
            "nextDialogs": [
              "750790303"
            ]
          },
          "750790303": {
            "id": "750790303",
            "speakerId": 6274,
            "speakerName": "特马乔",
            "text": "飞行执照？这倒是个新鲜词儿。",
            "nextDialogs": [
              "750790305"
            ]
          },
          "750790305": {
            "id": "750790305",
            "speakerId": 6274,
            "speakerName": "特马乔",
            "text": "咱们这儿主打一个人和龙共同进步，你的伙伴…",
            "nextDialogs": [
              "750790306"
            ]
          },
          "750790306": {
            "id": "750790306",
            "speakerId": 14662,
            "speakerName": "#{REALNAME[ID(2)|SHOWHOST(true)]}",
            "text": "唔，呀！",
            "nextDialogs": [
              "750790307"
            ]
          },
          "750790307": {
            "id": "750790307",
            "speakerId": 6274,
            "speakerName": "特马乔",
            "text": "…嗯，小家伙，看来帕帕卡飞行学校不是能让你一展身手的地方。别太介怀了，这当然不是你的问题。",
            "nextDialogs": [
              "750790308"
            ]
          },
          "750790308": {
            "id": "750790308",
            "speakerId": 14662,
            "speakerName": "#{REALNAME[ID(2)|SHOWHOST(true)]}",
            "text": "呜嗯？",
            "nextDialogs": [
              "750790309"
            ]
          },
          "750790309": {
            "id": "750790309",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "#{REALNAME[ID(2)|SHOWHOST(true)]}还小，还有潜力。",
            "nextDialogs": [
              "750790310"
            ]
          },
          "750790310": {
            "id": "750790310",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "嵴锋龙的潜力怎么想也不会是和绒翼龙暝视龙比飞行吧！",
            "nextDialogs": [
              "750790311"
            ]
          },
          "750790311": {
            "id": "750790311",
            "speakerId": 6274,
            "speakerName": "特马乔",
            "text": "#不管怎么说，{M#小兄弟}{F#小妹}如果对咱们这儿的飞行训练感兴趣，不妨试试开放的训练赛道！",
            "nextDialogs": [
              "750790313"
            ]
          },
          "750790313": {
            "id": "750790313",
            "speakerId": 6274,
            "speakerName": "特马乔",
            "text": "不管是躲避障碍物还是灵活转向，都是驾驭绒翼龙所需的必备能力，到底有几分本事，训练赛道一试便知！",
            "nextDialogs": [
              "750790312"
            ]
          },
          "750790312": {
            "id": "750790312",
            "speakerId": 6274,
            "speakerName": "特马乔",
            "text": "#实话说为了推广，咱们也是费了不少心思，又是准备奖品又是筹办比赛。{M#小兄弟}{F#小妹}顺利通过的话就去找拉密萨纳领奖吧。"
          }
        }
      }
    },
    {

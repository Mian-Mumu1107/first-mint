          },
          "772420805": {
            "id": "772420805",
            "speakerId": 1003,
            "speakerName": "野外温泉告示",
            "text": "（上面除了写着原来的注意事项，还在下面用加大加粗的笔划写着：）",
            "nextDialogs": [
              "772420806"
            ]
          },
          "772420806": {
            "id": "772420806",
            "speakerId": 1003,
            "speakerName": "野外温泉告示",
            "text": "「不许！不许！浮流鸟…还是什么浮燃鸟！进入温泉！」"
          }
        }
      }
    },

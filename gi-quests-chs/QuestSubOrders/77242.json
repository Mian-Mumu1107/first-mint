    {
      "subId": "7724203",
      "subQuestName": "(test)隐藏$HIDDEN",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "772420201"
        ],
        "dialogs": {
          "772420201": {
            "id": "772420201",
            "speakerId": 1004,
            "speakerName": "Black Screen",
            "text": "终于，在温泉里暴走的浮燃鸟冷静了下来。似乎意识到了此处并非故乡，露出了一脸悻悻的表情。",
            "nextDialogs": [
              "772420202"
            ]
          },
          "772420202": {
            "id": "772420202",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "呜哇，我居然从这只浮燃鸟脸上看到了失落的情绪。",
            "nextDialogs": [
              "772420203"
            ]
          },
          "772420203": {
            "id": "772420203",
            "speakerId": 1002,
            "speakerName": "钦图图",
            "text": "加维塔！真是的，总算冷静下来了吗…",
            "nextDialogs": [
              "772420204"
            ]
          },
          "772420204": {
            "id": "772420204",
            "speakerId": 1005,
            "speakerName": "加维塔",
            "text": "呱？",
            "nextDialogs": [
              "772420205"
            ]
          },
          "772420205": {
            "id": "772420205",
            "speakerId": 1002,
            "speakerName": "钦图图",
            "text": "唉…算了。",
            "nextDialogs": [
              "772420206"
            ]
          },
          "772420206": {
            "id": "772420206",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "嘿嘿，它冷静下来了就好！",
            "nextDialogs": [
              "772420207"
            ]
          },
          "772420207": {
            "id": "772420207",
            "speakerId": 1002,
            "speakerName": "钦图图",
            "text": "多谢、多谢你们！为了它的健康着想，看来我们还是快点返程比较好…",
            "nextDialogs": [
              "772420208"
            ]
          },
          "772420208": {
            "id": "772420208",
            "speakerId": 1002,
            "speakerName": "钦图图",
            "text": "真不知道该如何道谢才行…对了，加维塔，你也得谢谢这两位！",
            "nextDialogs": [
              "772420209"
            ]
          },
          "772420209": {
            "id": "772420209",
            "speakerId": 1005,
            "speakerName": "加维塔",
            "text": "……",
            "nextDialogs": [
              "772420210"
            ]
          },
          "772420210": {
            "id": "772420210",
            "speakerId": 1005,
            "speakerName": "加维塔",
            "text": "呱？",
            "nextDialogs": [
              "772420211"
            ]
          },
          "772420211": {
            "id": "772420211",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "它最好是能听得懂啦！"
          }
        }
      }
    },

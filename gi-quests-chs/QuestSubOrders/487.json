    {
      "subId": "48712",
      "subQuestName": "(test)与玛格丽特对话，完成委托$HIDDEN",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "4871201"
        ],
        "dialogs": {
          "4871201": {
            "id": "4871201",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "居然又让它跑掉了…唉…",
            "nextDialogs": [
              "4871202"
            ]
          },
          "4871202": {
            "id": "4871202",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "欸？可是看它这次逃跑的方向…莫非是…"
          }
        }
      }
    },
    {
      "subId": "48710",
      "subQuestName": "完成玛格丽特的委托",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "4871001"
        ],
        "dialogs": {
          "4871001": {
            "id": "4871001",
            "speakerId": 1431,
            "speakerName": "玛格丽特",
            "text": "「小王子」~！真是听话的宝贝，居然自己回来了。"
          }
        }
      }
    },
    {
      "subId": "48703",
      "subQuestName": "完成玛格丽特的委托",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "4870301"
        ],
        "dialogs": {
          "4870301": {
            "id": "4870301",
            "speakerId": 1431,
            "speakerName": "玛格丽特",
            "text": "「小王子」~！你跑哪儿去了呀，终于回来了。",
            "nextDialogs": [
              "4870302"
            ]
          },
          "4870302": {
            "id": "4870302",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "可让我们好找呢。",
            "nextDialogs": [
              "4870303"
            ]
          },
          "4870303": {
            "id": "4870303",
            "speakerId": 1431,
            "speakerName": "玛格丽特",
            "text": "唉，「小王子」呀，你怎么忍心这样抛弃我呢…",
            "nextDialogs": [
              "4870304"
            ]
          },
          "4870304": {
            "id": "4870304",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "已经进入「二人世界」了吗…",
            "nextDialogs": [
              "4870305"
            ]
          },
          "4870305": {
            "id": "4870305",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "还有你的星铁弦在这儿哦，温迪。",
            "nextDialogs": [
              "4870306"
            ]
          },
          "4870306": {
            "id": "4870306",
            "speakerId": 1001,
            "speakerName": "温迪",
            "text": "还真的被你们找到了，我原本都不怎么抱希望了。",
            "nextDialogs": [
              "4870307"
            ]
          },
          "4870307": {
            "id": "4870307",
            "speakerId": 1001,
            "speakerName": "温迪",
            "text": "为了表示感谢，用这弦为你们办一场「专场演唱」都不过分呢…阿、阿…",
            "nextDialogs": [
              "4870308"
            ]
          },
          "4870308": {
            "id": "4870308",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "阿？",
            "nextDialogs": [
              "4870309"
            ]
          },
          "4870309": {
            "id": "4870309",
            "speakerId": 1001,
            "speakerName": "温迪",
            "text": "阿嚏——！",
            "nextDialogs": [
              "4870310"
            ]
          },
          "4870310": {
            "id": "4870310",
            "speakerId": 1001,
            "speakerName": "温迪",
            "text": "咳咳…啊哈哈…离「小王子」这么近的话，我对猫过敏的体质果然又…",
            "nextDialogs": [
              "4870311"
            ]
          },
          "4870311": {
            "id": "4870311",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "怪不得你没有自己去抓它…",
            "nextDialogs": [
              "4870312"
            ]
          },
          "4870312": {
            "id": "4870312",
            "speakerId": 1001,
            "speakerName": "温迪",
            "text": "欸嘿，总之帮了大忙啦，那我先走啦…阿、阿嚏——"
          }
        }
      }
    },

    },
    {
      "subId": "48705",
      "subQuestName": "(test)完成找猫猫$HIDDEN",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "4870501"
        ],
        "dialogs": {
          "4870501": {
            "id": "4870501",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "还真是警觉呀，就这么让「小王子」跑掉了。",
            "nextDialogs": [
              "4870502"
            ]
          },
          "4870502": {
            "id": "4870502",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "想办法<color=#00E1FFFF>从它身后接近</color>吧，最好蹲下来，好让脚步轻一些。",
            "nextDialogs": [
              "4870503"
            ]
          },
          "4870503": {
            "id": "4870503",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "不会飞就是麻烦，嘿嘿。",
            "nextDialogs": [
              "4870504"
            ]
          },
          "4870504": {
            "id": "4870504",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "如果不放心的话，不如先用<color=#00E1FFFF>鱼肉</color>来吸引「小王子」的注意，猫都喜欢吃鱼的吧？",
            "nextDialogs": [
              "4870505"
            ]
          },
          "4870505": {
            "id": "4870505",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "<color=#00E1FFFF>鱼肉</color>没有了的话就去附近的湖里抓，快点行动吧~！"
          }
        }
      }
    },

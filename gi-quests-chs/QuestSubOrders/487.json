          "4871101"
        ],
        "dialogs": {
          "4871101": {
            "id": "4871101",
            "speakerId": 1431,
            "speakerName": "玛格丽特",
            "text": "你们刚才到哪里去了呀？",
            "nextDialogs": [
              "4871102"
            ]
          },
          "4871102": {
            "id": "4871102",
            "speakerId": 1431,
            "speakerName": "玛格丽特",
            "text": "「小王子」应该就在城里的商业区和居民区附近，是一只纯黑色的猫哦。"
          }
        }
      }
    },
    {
      "subId": "48702",

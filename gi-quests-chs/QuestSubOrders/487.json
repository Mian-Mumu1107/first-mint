  "subQuests": [
    {
      "subId": "48701",
      "subQuestName": "与玛格丽特对话",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "4870101"
        ],
        "dialogs": {
          "4870101": {
            "id": "4870101",
            "speakerId": 1001,
            "speakerName": "温迪",
            "text": "…原来那只猫是你家走丢的呀。",
            "nextDialogs": [
              "4870102"
            ]
          },
          "4870102": {
            "id": "4870102",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "温迪！你也是来帮忙的吗？",
            "nextDialogs": [
              "4870103"
            ]
          },
          "4870103": {
            "id": "4870103",
            "speakerId": 1001,
            "speakerName": "温迪",
            "text": "帮忙？我倒觉得，需要帮忙的其实是我…",
            "nextDialogs": [
              "4870104"
            ]
          },
          "4870104": {
            "id": "4870104",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "咦？我看你刚才好像也在问玛格丽特小姐的「小王子」的事…",
            "nextDialogs": [
              "4870105"
            ]
          },
          "4870105": {
            "id": "4870105",
            "speakerId": 1001,
            "speakerName": "温迪",
            "text": "哦，所以偷走我备用的<color=#00E1FFFF>星铁弦</color>的那只猫，名字叫「小王子」吗。",
            "nextDialogs": [
              "4870106"
            ]
          },
          "4870106": {
            "id": "4870106",
            "speakerId": 1001,
            "speakerName": "温迪",
            "text": "虽说看到蒙德的生灵如此自由自在，是件好事…但未免也太为所欲为了吧。",
            "nextDialogs": [
              "4870107"
            ]
          },
          "4870107": {
            "id": "4870107",
            "speakerId": 1431,
            "speakerName": "玛格丽特",
            "text": "啊哈哈，「小王子」就是这样调皮机灵的宝贝呢。",
            "nextDialogs": [
              "4870108"
            ]
          },
          "4870108": {
            "id": "4870108",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "这就是喜欢放纵孩子的家长吧。",
            "nextDialogs": [
              "4870109"
            ]
          },
          "4870109": {
            "id": "4870109",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "好像巴巴托斯一样呢。",
            "nextDialogs": [
              "4870110"
            ]
          },
          "4870110": {
            "id": "4870110",
            "speakerId": 1001,
            "speakerName": "温迪",
            "text": "哈哈哈…真是巧妙的比喻，咳咳。还是先找到「小王子」再说吧。",
            "nextDialogs": [
              "4870111"
            ]
          },
          "4870111": {
            "id": "4870111",
            "speakerId": 1001,
            "speakerName": "温迪",
            "text": "今晚我还有演出，拿不回备用弦的话，可就要让听众失望了。",
            "nextDialogs": [
              "4870112"
            ]
          },
          "4870112": {
            "id": "4870112",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "话说猫咪为什么会去偷温迪的备用琴弦呢？",
            "nextDialogs": [
              "4870113"
            ]
          },
          "4870113": {
            "id": "4870113",
            "speakerId": 1431,
            "speakerName": "玛格丽特",
            "text": "猫咪都喜欢玩毛线团的呀！",
            "nextDialogs": [
              "4870114"
            ]
          },
          "4870114": {
            "id": "4870114",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "欸欸！？",
            "nextDialogs": [
              "4870115"
            ]
          },
          "4870115": {
            "id": "4870115",
            "speakerId": 1001,
            "speakerName": "温迪",
            "text": "星铁做的琴弦蕴含着风的元素力，有超乎意料的韧性，所以平时我都卷成毛线团的样子带在身上啦。",
            "nextDialogs": [
              "4870116"
            ]
          },
          "4870116": {
            "id": "4870116",
            "speakerId": 1001,
            "speakerName": "温迪",
            "text": "这可是吟游诗人的小秘密，哼哼。",
            "nextDialogs": [
              "4870117"
            ]
          },
          "4870117": {
            "id": "4870117",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "咦？你说那弦上有风的元素力？",
            "nextDialogs": [
              "4870118"
            ]
          },
          "4870118": {
            "id": "4870118",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "#那好，我们有线索啦！{NICKNAME}，快用<color=#00E1FFFF>「元素视野」</color>查看一下吧？"
          }
        }
      }
    },
    {
      "subId": "48711",
      "subQuestName": "找玛格丽特听取委托内容",
      "sceneId": null,
      "locations": [],
      "dialogue": {

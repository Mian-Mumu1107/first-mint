    {
      "subId": "60501",
      "subQuestName": "(test)隐藏$HIDDEN",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "6051101"
        ],
        "dialogs": {
          "6051101": {
            "id": "6051101",
            "speakerId": 1019,
            "speakerName": "砂糖",
            "text": "#阿贝多先生！{NICKNAME}！",
            "nextDialogs": [
              "6051102"
            ]
          },
          "6051102": {
            "id": "6051102",
            "speakerId": 1018,
            "speakerName": "阿贝多",
            "text": "情况应该还好吧。",
            "nextDialogs": [
              "6051103"
            ]
          },
          "6051103": {
            "id": "6051103",
            "speakerId": 1019,
            "speakerName": "砂糖",
            "text": "嗯！刚才有一些怪物冲进了城内，不过我跟迪卢克老爷和凯亚先生一起击退了他们。",
            "nextDialogs": [
              "6051104"
            ]
          },
          "6051104": {
            "id": "6051104",
            "speakerId": 1019,
            "speakerName": "砂糖",
            "text": "趁现在有空，我打算做些药剂分发给附近的战士，应该能够帮上些忙！",
            "nextDialogs": [
              "6051105"
            ]
          },
          "6051105": {
            "id": "6051105",
            "speakerId": 1018,
            "speakerName": "阿贝多",
            "text": "稳妥的判断，辛苦你了。",
            "nextDialogs": [
              "6051106"
            ]
          },
          "6051106": {
            "id": "6051106",
            "speakerId": 1018,
            "speakerName": "阿贝多",
            "text": "注意安全。虽然我不觉得会有这种情况，但如果出现你无法应对的情况，立刻撤离到安全地区。不用担心阵线问题。",
            "nextDialogs": [
              "6051107"
            ]
          },
          "6051107": {
            "id": "6051107",
            "speakerId": 1019,
            "speakerName": "砂糖",
            "text": "是，我明白了！"
          }
        }
      }
    },
    {
      "subId": "60502",
      "subQuestName": "(test)隐藏$HIDDEN",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "6050201"
        ],
        "dialogs": {
          "6050201": {
            "id": "6050201",
            "speakerId": 1004,
            "speakerName": "凯亚",
            "text": "两位辛苦了，防御得非常完美。",
            "nextDialogs": [
              "6050202"
            ]
          },
          "6050202": {
            "id": "6050202",
            "speakerId": 1009,
            "speakerName": "迪卢克",
            "text": "接下来这里交给我们就行。",
            "nextDialogs": [
              "6050203"
            ]
          },
          "6050203": {
            "id": "6050203",
            "speakerId": 1439,
            "speakerName": "劳伦斯",
            "text": "凯亚队长，斯万他…",
            "nextDialogs": [
              "6050204"
            ]
          },
          "6050204": {
            "id": "6050204",
            "speakerId": 1437,
            "speakerName": "斯万",
            "text": "喂！我没事。倒是你的小腿…",
            "nextDialogs": [
              "6050205"
            ]
          },
          "6050205": {
            "id": "6050205",
            "speakerId": 1004,
            "speakerName": "凯亚",
            "text": "斯万，劳伦斯，都到西风教会接受治疗吧，别勉强。我们会接手这一带。",
            "nextDialogs": [
              "6050206"
            ]
          },
          "6050206": {
            "id": "6050206",
            "speakerId": 1437,
            "speakerName": "斯万",
            "text": "可是，迪卢克老爷也…您不是早就已经离开骑士团了吗？",
            "nextDialogs": [
              "6050207"
            ]
          },
          "6050207": {
            "id": "6050207",
            "speakerId": 1009,
            "speakerName": "迪卢克",
            "text": "是啊，但也不是只有骑士团的人才能看守这扇大门。",
            "nextDialogs": [
              "6050208"
            ]
          },
          "6050208": {
            "id": "6050208",
            "speakerId": 1004,
            "speakerName": "凯亚",
            "text": "老爷一向很热心，哎，你就别管了。市民愿意做些什么，那就让他做呗，也没什么不好，不是吗？",
            "nextDialogs": [
              "6050209"
            ]
          },
          "6050209": {
            "id": "6050209",
            "speakerId": 1437,
            "speakerName": "斯万",
            "text": "…我明白了。非常抱歉，我衷心感谢您能支援我们！",
            "nextDialogs": [
              "6050210"
            ]
          },
          "6050210": {
            "id": "6050210",
            "speakerId": 1439,
            "speakerName": "劳伦斯",
            "text": "我们会尽快回来，多谢二位！",
            "nextDialogs": [
              "6050211"
            ]
          },
          "6050211": {
            "id": "6050211",
            "speakerId": 1006,
            "speakerName": "Black Screen",
            "text": "(test)时间回到现在..."
          }
        }
      }
    },

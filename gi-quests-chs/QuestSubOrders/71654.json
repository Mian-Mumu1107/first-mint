    {
      "subId": "7165407",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "716540701"
        ],
        "dialogs": {
          "716540701": {
            "id": "716540701",
            "speakerId": 13276,
            "speakerName": "阿圆",
            "text": "呼…总算又有人来了…咦…",
            "nextDialogs": [
              "716540702"
            ]
          },
          "716540702": {
            "id": "716540702",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "啊，远处看还以为是只大团雀，走近一看，这不是阿圆嘛！",
            "nextDialogs": [
              "716540703"
            ]
          },
          "716540703": {
            "id": "716540703",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "难道…你就是萍姥姥说的「小家伙」？",
            "nextDialogs": [
              "716540704"
            ]
          },
          "716540704": {
            "id": "716540704",
            "speakerId": 13276,
            "speakerName": "阿圆",
            "text": "萍姥姥…啊，你说阿萍啊，对，我就是她召过来的，也听她说了你们的事。",
            "nextDialogs": [
              "716540705"
            ]
          },
          "716540705": {
            "id": "716540705",
            "speakerId": 13276,
            "speakerName": "阿圆",
            "text": "上次在蒙德的酒馆内见面时，我就觉得与二位缘分未尽。",
            "nextDialogs": [
              "716540706"
            ]
          },
          "716540706": {
            "id": "716540706",
            "speakerId": 13276,
            "speakerName": "阿圆",
            "text": "今日在壶中看见二位才知道，缘来如此。",
            "nextDialogs": [
              "716540707"
            ]
          },
          "716540707": {
            "id": "716540707",
            "speakerId": 13276,
            "speakerName": "阿圆",
            "text": "在这洞天之内，万事都交给我来打理就好。",
            "nextDialogs": [
              "716540708"
            ]
          },
          "716540708": {
            "id": "716540708",
            "speakerId": 13276,
            "speakerName": "阿圆",
            "text": "虽然你们的旅途还得继续…但至少，每天能有个舒适的地方睡个安稳觉了。",
            "nextDialogs": [
              "716540709"
            ]
          },
          "716540709": {
            "id": "716540709",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "「壶灵」到底是什么？",
            "nextDialogs": [
              "716540710"
            ]
          },
          "716540710": {
            "id": "716540710",
            "speakerId": 13276,
            "speakerName": "阿圆",
            "text": "嗯…虽然洞天是仙人所创造，但洞天内的诸般杂事，仙人们一般都没空自己打理。",
            "nextDialogs": [
              "716540711"
            ]
          },
          "716540711": {
            "id": "716540711",
            "speakerId": 13276,
            "speakerName": "阿圆",
            "text": "所以仙人才创造了我们「壶灵」，帮他们镇守洞天，打理诸事。",
            "nextDialogs": [
              "716540712"
            ]
          },
          "716540712": {
            "id": "716540712",
            "speakerId": 13276,
            "speakerName": "阿圆",
            "text": "简单来说，就像是这方洞天的「管家」一样吧。",
            "nextDialogs": [
              "716540713"
            ]
          },
          "716540713": {
            "id": "716540713",
            "speakerId": 13276,
            "speakerName": "阿圆",
            "text": "对了，我先和你们简单讲讲这方「洞天」…",
            "nextDialogs": [
              "716540714"
            ]
          },
          "716540714": {
            "id": "716540714",
            "speakerId": 13276,
            "speakerName": "阿圆",
            "text": "你们带着图纸吗？那种画着漂亮房子，漂亮椅子的图纸。",
            "nextDialogs": [
              "716540715"
            ]
          },
          "716540715": {
            "id": "716540715",
            "speakerId": 13276,
            "speakerName": "阿圆",
            "text": "只要有「图纸」，你们就能将这个壶中洞天建成你们期待的模样了。",
            "nextDialogs": [
              "716540716"
            ]
          },
          "716540716": {
            "id": "716540716",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "图纸…对了！婆婆在给我们壶的时候，不是也给了我们图纸吗？快拿出来看看吧。",
            "nextDialogs": [
              "716540717"
            ]
          },
          "716540717": {
            "id": "716540717",
            "speakerId": 13276,
            "speakerName": "阿圆",
            "text": "对，对，这就是图纸，快展开看看。",
            "nextDialogs": [
              "716540718"
            ]
          },
          "716540718": {
            "id": "716540718",
            "speakerId": 13276,
            "speakerName": "阿圆",
            "text": "你们先记牢这些图纸里的东西样式，再准备些相应的材料物件…",
            "nextDialogs": [
              "716540719"
            ]
          },
          "716540719": {
            "id": "716540719",
            "speakerId": 13276,
            "speakerName": "阿圆",
            "text": "然后再飘出一缕念头，图纸里的东西就会在这盏壶里出现啦。",
            "nextDialogs": [
              "716540720"
            ]
          },
          "716540720": {
            "id": "716540720",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "这样就能让东西出现？那岂不是…能在壶里建造一整座城市了？",
            "nextDialogs": [
              "716540721"
            ]
          },
          "716540721": {
            "id": "716540721",
            "speakerId": 13276,
            "speakerName": "阿圆",
            "text": "嗯…这个不太可能呢，之前有一位金色眼睛的仙人和我说过这件事。",
            "nextDialogs": [
              "716540722"
            ]
          },
          "716540722": {
            "id": "716540722",
            "speakerId": 13276,
            "speakerName": "阿圆",
            "text": "他说…洞天虽是仙人「外景」之能所显，但即便是仙人显能，也终有极限。",
            "nextDialogs": [
              "716540723"
            ]
          },
          "716540723": {
            "id": "716540723",
            "speakerId": 13276,
            "speakerName": "阿圆",
            "text": "毕竟此方天地并不是真天地，只是避出尘世的一片青叶，只可偷得半日闲暇，不能避出一世清净。",
            "nextDialogs": [
              "716540724"
            ]
          },
          "716540724": {
            "id": "716540724",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "金色眼睛的仙人？到底是哪一位呢…",
            "nextDialogs": [
              "716540725"
            ]
          },
          "716540725": {
            "id": "716540725",
            "speakerId": 13276,
            "speakerName": "阿圆",
            "text": "我也记不太清了。而且，之后我也再没见过那位仙人了。",
            "nextDialogs": [
              "716540726"
            ]
          },
          "716540726": {
            "id": "716540726",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "有种奇怪的感觉…",
            "nextDialogs": [
              "716540727"
            ]
          },
          "716540727": {
            "id": "716540727",
            "speakerId": 13276,
            "speakerName": "阿圆",
            "text": "先不说这些了，你们先好好逛一下周围，熟悉一下这「洞天」吧。",
            "nextDialogs": [
              "716540728"
            ]
          },
          "716540728": {
            "id": "716540728",
            "speakerId": 13276,
            "speakerName": "阿圆",
            "text": "有什么事想问的话，你们尽管来找我就是。"
          }
        }
      }
    }
  ]
}
    {
      "subId": "7165402",
      "subQuestName": "与派蒙对话",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "716540201"
        ],
        "dialogs": {
          "716540201": {
            "id": "716540201",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "哇…这壶里的空间，好像比萍姥姥那盏更大呢，中间还有一栋好大的房子！",
            "nextDialogs": [
              "716540202"
            ]
          },
          "716540202": {
            "id": "716540202",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "不过，周围却没什么东西呢…",
            "nextDialogs": [
              "716540204",
              "716540206"
            ]
          },
          "716540204": {
            "id": "716540204",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "凿不动！你自己不是拿着剑吗？你自己去凿啦！",
            "nextDialogs": [
              "716540207"
            ]
          },
          "716540207": {
            "id": "716540207",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "唉，不过除了那个房子之外，这周围怎么空荡荡的…",
            "nextDialogs": [
              "716540208"
            ]
          },
          "716540208": {
            "id": "716540208",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "欸？等等，那是什么？"
          },
          "716540206": {
            "id": "716540206",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "明明有房子，为什么我还要挖地洞啦！"
          }
        }
      }
    },
    {

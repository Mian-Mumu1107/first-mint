    {
      "subId": "46305",
      "subQuestName": "(test)听凯亚解释「宝藏」的真相$HIDDEN",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "4630501"
        ],
        "dialogs": {
          "4630501": {
            "id": "4630501",
            "speakerId": 1214,
            "speakerName": "伊扎德",
            "text": "呼…没想到居然混到了被骑士团救命的地步，真是丢脸。",
            "nextDialogs": [
              "4630502"
            ]
          },
          "4630502": {
            "id": "4630502",
            "speakerId": 1004,
            "speakerName": "凯亚",
            "text": "别忘了你承诺过什么，否则刚才的东西绝对不会是你见过最可怕的东西…",
            "nextDialogs": [
              "4630503"
            ]
          },
          "4630503": {
            "id": "4630503",
            "speakerId": 1214,
            "speakerName": "伊扎德",
            "text": "这…喂！你们骑士团都是这样对待嫌犯的吗…",
            "nextDialogs": [
              "4630504"
            ]
          },
          "4630504": {
            "id": "4630504",
            "speakerId": 1004,
            "speakerName": "凯亚",
            "text": "开玩笑的。好了，把他带回蒙德城吧。",
            "nextDialogs": [
              "4630505"
            ]
          },
          "4630505": {
            "id": "4630505",
            "speakerId": 1215,
            "speakerName": "西风骑士",
            "text": "是！凯亚队长。",
            "nextDialogs": [
              "4630506"
            ]
          },
          "4630506": {
            "id": "4630506",
            "speakerId": 1215,
            "speakerName": "西风骑士",
            "text": "队长，这两个人也要一并带走吗？",
            "nextDialogs": [
              "4630507"
            ]
          },
          "4630507": {
            "id": "4630507",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "什么？！",
            "nextDialogs": [
              "4630508"
            ]
          },
          "4630508": {
            "id": "4630508",
            "speakerId": 1004,
            "speakerName": "凯亚",
            "text": "哈哈，不用了。这两位可是本次行动的功臣。",
            "nextDialogs": [
              "4630509"
            ]
          },
          "4630509": {
            "id": "4630509",
            "speakerId": 1004,
            "speakerName": "凯亚",
            "text": "没有他们散布<color=#00E1FFFF>假情报</color>，我们也没那么容易搞定盗宝团。",
            "nextDialogs": [
              "4630513"
            ]
          },
          "4630513": {
            "id": "4630513",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "呜呜呜…骗子！喜欢说谎的坏人！骑士团的败类！",
            "nextDialogs": [
              "4630514"
            ]
          },
          "4630514": {
            "id": "4630514",
            "speakerId": 1004,
            "speakerName": "凯亚",
            "text": "停，停——好啦，好啦。",
            "nextDialogs": [
              "4630515"
            ]
          },
          "4630515": {
            "id": "4630515",
            "speakerId": 1004,
            "speakerName": "凯亚",
            "text": "尽管宝藏是假的，但至少有那么一瞬间你是想要独吞的吧？",
            "nextDialogs": [
              "4630516"
            ]
          },
          "4630516": {
            "id": "4630516",
            "speakerId": 1004,
            "speakerName": "凯亚",
            "text": "不然，你们为什么不通知我，而是自己过来了？",
            "nextDialogs": [
              "4630517"
            ]
          },
          "4630517": {
            "id": "4630517",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "啊！…唔嗯嗯嗯嗯…哼！",
            "nextDialogs": [
              "4630518"
            ]
          },
          "4630518": {
            "id": "4630518",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "#{NICKNAME}，我们走！谁有空和这家伙理论啊！",
            "nextDialogs": [
              "4630519"
            ]
          },
          "4630519": {
            "id": "4630519",
            "speakerId": 1004,
            "speakerName": "凯亚",
            "text": "哈哈，稍等一下。",
            "nextDialogs": [
              "4630520"
            ]
          },
          "4630520": {
            "id": "4630520",
            "speakerId": 1004,
            "speakerName": "凯亚",
            "text": "二位帮了我这么大的忙，谢礼总是少不了的。",
            "nextDialogs": [
              "4630521"
            ]
          },
          "4630521": {
            "id": "4630521",
            "speakerId": 1004,
            "speakerName": "凯亚",
            "text": "这柄剑名为「斩开黎明指向胜利的拂晓神剑」，如它的名字一样，是象征光明与胜利之剑。",
            "nextDialogs": [
              "4630533"
            ]
          },
          "4630533": {
            "id": "4630533",
            "speakerId": 1004,
            "speakerName": "凯亚",
            "text": "不嫌弃的话，这柄我珍藏已久的「黎明神剑」就作为给两位的谢礼吧。",
            "nextDialogs": [
              "4630522"
            ]
          },
          "4630522": {
            "id": "4630522",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "「黎明神剑」？",
            "nextDialogs": [
              "4630523"
            ]
          },
          "4630523": {
            "id": "4630523",
            "speakerId": 1004,
            "speakerName": "凯亚",
            "text": "没错。与通情达理的派蒙阁下很相称吧？",
            "nextDialogs": [
              "4630524"
            ]
          },
          "4630524": {
            "id": "4630524",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "嗯…如果谢礼是这柄「黎明神剑」的话…",
            "nextDialogs": [
              "4630525"
            ]
          },
          "4630525": {
            "id": "4630525",
            "speakerId": 1004,
            "speakerName": "凯亚",
            "text": "你们会理解我的，对吗？",
            "nextDialogs": [
              "4630526"
            ]
          },
          "4630526": {
            "id": "4630526",
            "speakerId": 1004,
            "speakerName": "凯亚",
            "text": "有你们这样温柔又懂得体谅他人的朋友，是我凯亚的荣幸。",
            "nextDialogs": [
              "4630527"
            ]
          },
          "4630527": {
            "id": "4630527",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "嗯…嗯…",
            "nextDialogs": [
              "4630528"
            ]
          },
          "4630528": {
            "id": "4630528",
            "speakerId": 1004,
            "speakerName": "凯亚",
            "text": "这次的事实在抱歉，但请派蒙阁下放心，同样的伎俩我是不会用两次的。"
          }
        }
      }
    },

  "subQuests": [
    {
      "subId": "46300",
      "subQuestName": "与派蒙商量下一步行动",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "4630001"
        ],
        "dialogs": {
          "4630001": {
            "id": "4630001",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "这下谜团都解开啦，真是花了很多功夫呢。",
            "nextDialogs": [
              "4630014"
            ]
          },
          "4630014": {
            "id": "4630014",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "不过话说回来，这张藏宝图画的还真是潦草呢…确实像是出自海盗之手。",
            "nextDialogs": [
              "4630002"
            ]
          },
          "4630002": {
            "id": "4630002",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "那么现在…",
            "nextDialogs": [
              "4630004"
            ]
          },
          "4630004": {
            "id": "4630004",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "嗯…？派蒙觉得，不，需，要，哦。",
            "nextDialogs": [
              "4630006"
            ]
          },
          "4630006": {
            "id": "4630006",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "不愧是派蒙的伙伴！和派蒙想的…完，全，一，样！",
            "nextDialogs": [
              "4630007"
            ]
          },
          "4630007": {
            "id": "4630007",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "不直接过去的话，万一被别人抢先可就麻烦啦。",
            "nextDialogs": [
              "4630008"
            ]
          },
          "4630008": {
            "id": "4630008",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "比如凯亚…嗯，凯亚说过的「盗宝团」之类的家伙。",
            "nextDialogs": [
              "4630009"
            ]
          },
          "4630009": {
            "id": "4630009",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "总之，我最多只是想借来那把剑…",
            "nextDialogs": [
              "4630010"
            ]
          },
          "4630010": {
            "id": "4630010",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "不、不，只是想去看一眼而已！",
            "nextDialogs": [
              "4630011"
            ]
          },
          "4630011": {
            "id": "4630011",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "绝不是想着什么天下无敌、高枕无忧吃喝玩乐…之类的事！",
            "nextDialogs": [
              "4630012"
            ]
          },
          "4630012": {
            "id": "4630012",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "好了，闲话就等到找到宝藏以后再说吧。",
            "nextDialogs": [
              "4630013"
            ]
          },
          "4630013": {
            "id": "4630013",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "阿卡狄亚寻宝之旅——正式启程！"
          }
        }
      }
    },
    {
      "subId": "46301",
      "subQuestName": "根据地图找到宝藏埋藏地",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "4630101"
        ],
        "dialogs": {
          "4630101": {
            "id": "4630101",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "「阿卡狄亚遗迹」就是这里了吧。",
            "nextDialogs": [
              "4630102"
            ]
          },
          "4630102": {
            "id": "4630102",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "怎么说…感觉稍微有些普通？",
            "nextDialogs": [
              "4630103"
            ]
          },
          "4630103": {
            "id": "4630103",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "我明白了，正所谓越是普通的地方，越容易被人忽视。",
            "nextDialogs": [
              "4630104"
            ]
          },
          "4630104": {
            "id": "4630104",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "真是深刻，凯亚的爷爷果然厉害。",
            "nextDialogs": [
              "4630105"
            ]
          },
          "4630105": {
            "id": "4630105",
            "speakerId": 10366,
            "speakerName": "???",
            "text": "——沙沙，咯噔。",
            "nextDialogs": [
              "4630106"
            ]
          },
          "4630106": {
            "id": "4630106",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "嗯？派蒙，你听…",
            "nextDialogs": [
              "4630107"
            ]
          },
          "4630107": {
            "id": "4630107",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "是老鼠。",
            "nextDialogs": [
              "4630108"
            ]
          },
          "4630108": {
            "id": "4630108",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "回答得太轻易了吧。",
            "nextDialogs": [
              "4630109"
            ]
          },
          "4630109": {
            "id": "4630109",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "唔…别疑神疑鬼了，不会有什么问题的。",
            "nextDialogs": [
              "4630110"
            ]
          },
          "4630110": {
            "id": "4630110",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "动作要快！宝藏已经在里面等我们很久啦！"
          }
        }
      }
    },

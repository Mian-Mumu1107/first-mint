    {
      "subId": "46303",
      "subQuestName": "(test)与派蒙对话$HIDDEN",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "4630301"
        ],
        "dialogs": {
          "4630301": {
            "id": "4630301",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "呼…这里就是尽头了？",
            "nextDialogs": [
              "4630302"
            ]
          },
          "4630302": {
            "id": "4630302",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "宝藏~宝藏~藏在哪里呀~",
            "nextDialogs": [
              "4630303"
            ]
          },
          "4630303": {
            "id": "4630303",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "#{NICKNAME}，一起在附近找找吧。",
            "nextDialogs": [
              "4630304"
            ]
          },
          "4630304": {
            "id": "4630304",
            "speakerId": 10366,
            "speakerName": "???",
            "text": "哈哈哈…这就不用麻烦你们了。",
            "nextDialogs": [
              "4630305"
            ]
          },
          "4630305": {
            "id": "4630305",
            "speakerId": 10366,
            "speakerName": "???",
            "text": "剩下的，由我来接手就好。",
            "nextDialogs": [
              "4630307",
              "4630309"
            ]
          },
          "4630307": {
            "id": "4630307",
            "speakerId": 10366,
            "speakerName": "???",
            "text": "真是机灵，不过现在才发现是不是有点太晚了？",
            "nextDialogs": [
              "4630311"
            ]
          },
          "4630311": {
            "id": "4630311",
            "speakerId": 1214,
            "speakerName": "伊扎德",
            "text": "你们好，我是伊扎德。",
            "nextDialogs": [
              "4630312"
            ]
          },
          "4630312": {
            "id": "4630312",
            "speakerId": 1214,
            "speakerName": "伊扎德",
            "text": "替盗宝团说声谢谢吧，感谢两位好心人为我带路。",
            "nextDialogs": [
              "4630313"
            ]
          },
          "4630313": {
            "id": "4630313",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "唔啊…",
            "nextDialogs": [
              "4630314"
            ]
          },
          "4630314": {
            "id": "4630314",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "真是奇怪，我们明明一直都在暗中行动，宝藏的秘密是怎么泄露的？",
            "nextDialogs": [
              "4630315"
            ]
          },
          "4630315": {
            "id": "4630315",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "我倒是完全不觉得奇怪。",
            "nextDialogs": [
              "4630316"
            ]
          },
          "4630316": {
            "id": "4630316",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "哼！我可不会甘心的。喂，盗宝贼！你以为我们不会反抗吗！",
            "nextDialogs": [
              "4630317"
            ]
          },
          "4630317": {
            "id": "4630317",
            "speakerId": 1214,
            "speakerName": "伊扎德",
            "text": "你要是这么瞧不起我们的实力，一会就别太吃惊了。",
            "nextDialogs": [
              "4630318"
            ]
          },
          "4630318": {
            "id": "4630318",
            "speakerId": 1214,
            "speakerName": "伊扎德",
            "text": "只要我一声令下，外面埋伏的兄弟们就会来和你们打招呼了。",
            "nextDialogs": [
              "4630319"
            ]
          },
          "4630319": {
            "id": "4630319",
            "speakerId": 1214,
            "speakerName": "伊扎德",
            "text": "可惜啊，他们不会像我这么好说话的，哈哈哈哈……",
            "nextDialogs": [
              "4630320"
            ]
          },
          "4630320": {
            "id": "4630320",
            "speakerId": 1004,
            "speakerName": "凯亚",
            "text": "（凯亚和西风骑士登场）",
            "nextDialogs": [
              "4630321"
            ]
          },
          "4630321": {
            "id": "4630321",
            "speakerId": 1004,
            "speakerName": "凯亚",
            "text": "在阁下这么开心的时候来打搅，真是不好意思。",
            "nextDialogs": [
              "4630322"
            ]
          },
          "4630322": {
            "id": "4630322",
            "speakerId": 1004,
            "speakerName": "凯亚",
            "text": "至于你的那些兄弟嘛，他们已经没法回应你了。",
            "nextDialogs": [
              "4630323"
            ]
          },
          "4630323": {
            "id": "4630323",
            "speakerId": 1004,
            "speakerName": "凯亚",
            "text": "恐怕你…只能去蒙德的监狱里探访他们了。",
            "nextDialogs": [
              "4630324"
            ]
          },
          "4630324": {
            "id": "4630324",
            "speakerId": 1004,
            "speakerName": "凯亚",
            "text": "或者，与他们做个狱友，也不错吧？",
            "nextDialogs": [
              "4630325"
            ]
          },
          "4630325": {
            "id": "4630325",
            "speakerId": 1214,
            "speakerName": "伊扎德",
            "text": "骑士团的人…？！",
            "nextDialogs": [
              "4630326"
            ]
          },
          "4630326": {
            "id": "4630326",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "哇，是凯亚！",
            "nextDialogs": [
              "4630327"
            ]
          },
          "4630327": {
            "id": "4630327",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "——凯亚，他在打你的宝藏的主意！快点把他抓起来！",
            "nextDialogs": [
              "4630328"
            ]
          },
          "4630328": {
            "id": "4630328",
            "speakerId": 1214,
            "speakerName": "伊扎德",
            "text": "嘁，糟心啊，明明就快到手了…",
            "nextDialogs": [
              "4630329"
            ]
          },
          "4630329": {
            "id": "4630329",
            "speakerId": 1004,
            "speakerName": "凯亚",
            "text": "哦呵，宝藏？",
            "nextDialogs": [
              "4630330"
            ]
          },
          "4630330": {
            "id": "4630330",
            "speakerId": 1004,
            "speakerName": "凯亚",
            "text": "不好意思了，这里根本没有什么宝藏。",
            "nextDialogs": [
              "4630331"
            ]
          },
          "4630331": {
            "id": "4630331",
            "speakerId": 1004,
            "speakerName": "凯亚",
            "text": "辛苦你们白跑一趟。那么现在，束手就擒吧。",
            "nextDialogs": [
              "4630332"
            ]
          },
          "4630332": {
            "id": "4630332",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "咦？",
            "nextDialogs": [
              "4630333"
            ]
          },
          "4630333": {
            "id": "4630333",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "没有…宝藏？",
            "nextDialogs": [
              "4630334"
            ]
          },
          "4630334": {
            "id": "4630334",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "凯亚刚才是不是说…没有…宝藏？",
            "nextDialogs": [
              "4630335"
            ]
          },
          "4630335": {
            "id": "4630335",
            "speakerId": 1214,
            "speakerName": "伊扎德",
            "text": "哈哈。被算计了…没想到骑士也会用这种下作手段…",
            "nextDialogs": [
              "4630336"
            ]
          },
          "4630336": {
            "id": "4630336",
            "speakerId": 1004,
            "speakerName": "凯亚",
            "text": "身为盗贼就不要随便评论骑士的智慧…喂，等等，你想干什么？",
            "nextDialogs": [
              "4630337"
            ]
          },
          "4630337": {
            "id": "4630337",
            "speakerId": 1214,
            "speakerName": "伊扎德",
            "text": "谁要被你们抓住啊！",
            "nextDialogs": [
              "4630338"
            ]
          },
          "4630338": {
            "id": "4630338",
            "speakerId": 1214,
            "speakerName": "伊扎德",
            "text": "这…这是什么？我不是故意的！"
          },
          "4630309": {
            "id": "4630309",
            "speakerId": 10366,
            "speakerName": "???",
            "text": "哈哈哈，情报交易所。我倒是和他们打过交道。",
            "nextDialogs": [
              "4630310"
            ]
          },
          "4630310": {
            "id": "4630310",
            "speakerId": 10366,
            "speakerName": "???",
            "text": "都是些守规矩的商人，发不了大财的家伙们…"
          }
        }
      }
    },

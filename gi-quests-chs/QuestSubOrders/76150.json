    {
      "subId": "7615001",
      "subQuestName": "(test)隐藏$HIDDEN",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "761500101"
        ],
        "dialogs": {
          "761500101": {
            "id": "761500101",
            "speakerId": 1000,
            "speakerName": "彩特琳德",
            "text": "咳咳咳。",
            "nextDialogs": [
              "761500102"
            ]
          },
          "761500102": {
            "id": "761500102",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "你没事吧？",
            "nextDialogs": [
              "761500103"
            ]
          },
          "761500103": {
            "id": "761500103",
            "speakerId": 1000,
            "speakerName": "彩特琳德",
            "text": "我…没事。我做了一个很长很长的噩梦。",
            "nextDialogs": [
              "761500104"
            ]
          },
          "761500104": {
            "id": "761500104",
            "speakerId": 1000,
            "speakerName": "彩特琳德",
            "text": "算了。上一句话当我没说。",
            "nextDialogs": [
              "761500105"
            ]
          },
          "761500105": {
            "id": "761500105",
            "speakerId": 1000,
            "speakerName": "彩特琳德",
            "text": "我忍不了了。为什么我要遇到这种事情。",
            "nextDialogs": [
              "761500106"
            ]
          },
          "761500106": {
            "id": "761500106",
            "speakerId": 1000,
            "speakerName": "彩特琳德",
            "text": "为什么我总要遇到这些事情。爸爸妈妈，然后是姐姐…",
            "nextDialogs": [
              "761500107"
            ]
          },
          "761500107": {
            "id": "761500107",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "没事的，我在。",
            "nextDialogs": [
              "761500108"
            ]
          },
          "761500108": {
            "id": "761500108",
            "speakerId": 1000,
            "speakerName": "彩特琳德",
            "text": "嗯。我没有生你们的气。",
            "nextDialogs": [
              "761500109"
            ]
          },
          "761500109": {
            "id": "761500109",
            "speakerId": 1001,
            "speakerName": "小右",
            "text": "♪~",
            "nextDialogs": [
              "761500110"
            ]
          },
          "761500110": {
            "id": "761500110",
            "speakerId": 1000,
            "speakerName": "彩特琳德",
            "text": "小右捡了个什么东西？",
            "nextDialogs": [
              "761500111"
            ]
          },
          "761500111": {
            "id": "761500111",
            "speakerId": 1002,
            "speakerName": "伊斯托利亚",
            "text": "我把这个叫做「念亡碎片」，或许是向死而生的出路。",
            "nextDialogs": [
              "761500112"
            ]
          },
          "761500112": {
            "id": "761500112",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "一起走吧。",
            "nextDialogs": [
              "761500113"
            ]
          },
          "761500113": {
            "id": "761500113",
            "speakerId": 1000,
            "speakerName": "彩特琳德",
            "text": "嗯。",
            "nextDialogs": [
              "761500114"
            ]
          },
          "761500114": {
            "id": "761500114",
            "speakerId": 1002,
            "speakerName": "伊斯托利亚",
            "text": "既然找到琳德了。我们就去找找出去的办法吧。",
            "nextDialogs": [
              "761500115"
            ]
          },
          "761500115": {
            "id": "761500115",
            "speakerId": 1003,
            "speakerName": "阿罗逻",
            "text": "这里真的可以靠实力出去吗？",
            "nextDialogs": [
              "761500116"
            ]
          },
          "761500116": {
            "id": "761500116",
            "speakerId": 1002,
            "speakerName": "伊斯托利亚",
            "text": "既然梅兰塔和尼西里塔可以自由往来，通常都还会带人出入。那小右应该也可以。",
            "nextDialogs": [
              "761500117"
            ]
          },
          "761500117": {
            "id": "761500117",
            "speakerId": 1001,
            "speakerName": "小右",
            "text": "♪~",
            "nextDialogs": [
              "761500118"
            ]
          },
          "761500118": {
            "id": "761500118",
            "speakerId": 1002,
            "speakerName": "伊斯托利亚",
            "text": "现在收集到了三枚「念亡碎片」。",
            "nextDialogs": [
              "761500119"
            ]
          },
          "761500119": {
            "id": "761500119",
            "speakerId": 1002,
            "speakerName": "伊斯托利亚",
            "text": "哦，这个是暂定名。因为我也不知道小右收集这个要做什么。",
            "nextDialogs": [
              "761500120"
            ]
          },
          "761500120": {
            "id": "761500120",
            "speakerId": 1002,
            "speakerName": "伊斯托利亚",
            "text": "小右，接下来怎么办？",
            "nextDialogs": [
              "761500121"
            ]
          },
          "761500121": {
            "id": "761500121",
            "speakerId": 1001,
            "speakerName": "小右",
            "text": "！",
            "nextDialogs": [
              "761500122"
            ]
          },
          "761500122": {
            "id": "761500122",
            "speakerId": 1002,
            "speakerName": "伊斯托利亚",
            "text": "跟着它指示的方向走吧。"
          }
        }
      }
    },

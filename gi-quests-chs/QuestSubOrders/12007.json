  },
  "subQuests": [
    {
      "subId": "1200701",
      "subQuestName": "前往笔记中记载的地点",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "120070101"
        ],
        "dialogs": {
          "120070101": {
            "id": "120070101",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "这就是高人的居所吗？",
            "nextDialogs": [
              "120070102"
            ]
          },
          "120070102": {
            "id": "120070102",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "呜…怎么感觉凉飕飕的呀…真有人住在这里吗？",
            "nextDialogs": [
              "120070103"
            ]
          },
          "120070103": {
            "id": "120070103",
            "speakerId": 1001,
            "speakerName": "神里绫华",
            "text": "我、我也觉得有点意外…",
            "nextDialogs": [
              "120070104"
            ]
          },
          "120070104": {
            "id": "120070104",
            "speakerId": 1001,
            "speakerName": "神里绫华",
            "text": "奇怪，笔记上说的确实是这里没错啊，难道说…",
            "nextDialogs": [
              "120070107"
            ]
          },
          "120070107": {
            "id": "120070107",
            "speakerId": 1001,
            "speakerName": "神里绫华",
            "text": "呜…内心有点动摇…",
            "nextDialogs": [
              "120070108"
            ]
          },
          "120070108": {
            "id": "120070108",
            "speakerId": 1001,
            "speakerName": "神里绫华",
            "text": "不过既然已经走到这里，我认为，我们还是应该进去一探究竟。",
            "nextDialogs": [
              "120070109"
            ]
          },
          "120070109": {
            "id": "120070109",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "嗯，也有道理，万一有什么惊喜呢？",
            "nextDialogs": [
              "120070110"
            ]
          },
          "120070110": {
            "id": "120070110",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "对了，那本笔记上是怎么说的呀？",
            "nextDialogs": [
              "120070111"
            ]
          },
          "120070111": {
            "id": "120070111",
            "speakerId": 1001,
            "speakerName": "神里绫华",
            "text": "我想想…",
            "nextDialogs": [
              "120070112"
            ]
          },
          "120070112": {
            "id": "120070112",
            "speakerId": 1001,
            "speakerName": "神里绫华",
            "text": "「鹤衔来<color=#00E1FFFF>一</color>朵装饰发梢的鲜花，白兔将<color=#00E1FFFF>四</color>片月光缝成裙摆，我打扮得当，<color=#00E1FFFF>向着东方</color>喊了<color=#00E1FFFF>七</color>声椿的名字，转眼便站在去往她家的小径上。」",
            "nextDialogs": [
              "120070113"
            ]
          },
          "120070113": {
            "id": "120070113",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "好像童话故事一样…难道说，只要这样做，「椿」就会来迎接你妈妈？",
            "nextDialogs": [
              "120070114"
            ]
          },
          "120070114": {
            "id": "120070114",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "越来越像仙人了。",
            "nextDialogs": [
              "120070115"
            ]
          },
          "120070115": {
            "id": "120070115",
            "speakerId": 1001,
            "speakerName": "神里绫华",
            "text": "总觉得，也像是某种暗号…",
            "nextDialogs": [
              "120070116"
            ]
          },
          "120070116": {
            "id": "120070116",
            "speakerId": 1001,
            "speakerName": "神里绫华",
            "text": "我们靠近一点再做判断吧。",
            "nextDialogs": [
              "120070117"
            ]
          },
          "120070117": {
            "id": "120070117",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "嗯！"
          }
        }
      }
    },

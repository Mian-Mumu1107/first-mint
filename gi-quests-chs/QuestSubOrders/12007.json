      }
    },
    {
      "subId": "1200705",
      "subQuestName": "与神里绫华对话",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "120070201"
        ],
        "dialogs": {
          "120070201": {
            "id": "120070201",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "开了吗开了吗？有没有仙人留下的财宝？",
            "nextDialogs": [
              "120070202"
            ]
          },
          "120070202": {
            "id": "120070202",
            "speakerId": 1001,
            "speakerName": "神里绫华",
            "text": "这是…",
            "nextDialogs": [
              "120070203"
            ]
          },
          "120070203": {
            "id": "120070203",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "唔…这是书吗？",
            "nextDialogs": [
              "120070204"
            ]
          },
          "120070204": {
            "id": "120070204",
            "speakerId": 1001,
            "speakerName": "神里绫华",
            "text": "看起来也是本笔记。",
            "nextDialogs": [
              "120070205"
            ]
          },
          "120070205": {
            "id": "120070205",
            "speakerId": 1001,
            "speakerName": "神里绫华",
            "text": "难道这会是「椿」的笔记吗…",
            "nextDialogs": [
              "120070206"
            ]
          },
          "120070206": {
            "id": "120070206",
            "speakerId": 1001,
            "speakerName": "神里绫华",
            "text": "各位，我们还是到外面去吧。这里气氛跟我想的有些不同，总觉得…不太想在这里翻开这本笔记。",
            "nextDialogs": [
              "120070207"
            ]
          },
          "120070207": {
            "id": "120070207",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "说得对，光线不好容易看坏眼睛哦。走吧走吧，去外面！"
          }
        }
      }
    },

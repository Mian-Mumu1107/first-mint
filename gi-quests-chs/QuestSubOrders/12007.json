    {
      "subId": "1200703",
      "subQuestName": "根据提示探查可疑之处",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "120070301"
        ],
        "dialogs": {
          "120070301": {
            "id": "120070301",
            "speakerId": 1001,
            "speakerName": "神里绫华",
            "text": "到这里就可以了。",
            "nextDialogs": [
              "120070302"
            ]
          },
          "120070302": {
            "id": "120070302",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "快看看笔记里写了什么！",
            "nextDialogs": [
              "120070303"
            ]
          },
          "120070303": {
            "id": "120070303",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "呜~会不会是神秘宝藏呀，好期待！",
            "nextDialogs": [
              "120070304"
            ]
          },
          "120070304": {
            "id": "120070304",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "派蒙。",
            "nextDialogs": [
              "120070305"
            ]
          },
          "120070305": {
            "id": "120070305",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "怎么了？突然那么小声，搞得我也紧张起来了…",
            "nextDialogs": [
              "120070306"
            ]
          },
          "120070306": {
            "id": "120070306",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "我们到边上去吧。",
            "nextDialogs": [
              "120070307"
            ]
          },
          "120070307": {
            "id": "120070307",
            "speakerId": 1001,
            "speakerName": "神里绫华",
            "text": "……",
            "nextDialogs": [
              "120070308"
            ]
          },
          "120070308": {
            "id": "120070308",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "原来是不想打扰绫华看笔记啊，看来，那本笔记真是有来头的东西。",
            "nextDialogs": [
              "120070309"
            ]
          },
          "120070309": {
            "id": "120070309",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "不过看她的神情…多半不是藏宝图了。",
            "nextDialogs": [
              "120070310"
            ]
          },
          "120070310": {
            "id": "120070310",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "唔，里面会有什么呢？",
            "nextDialogs": [
              "120070311"
            ]
          },
          "120070311": {
            "id": "120070311",
            "speakerId": 1001,
            "speakerName": "神里绫华",
            "text": "……",
            "nextDialogs": [
              "120070312"
            ]
          },
          "120070312": {
            "id": "120070312",
            "speakerId": 1001,
            "speakerName": "神里绫华",
            "text": "呼。",
            "nextDialogs": [
              "120070313"
            ]
          },
          "120070313": {
            "id": "120070313",
            "speakerId": 1001,
            "speakerName": "神里绫华",
            "text": "旅行者，派蒙，抱歉让你们久等了。",
            "nextDialogs": [
              "120070314"
            ]
          },
          "120070314": {
            "id": "120070314",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "才一小会儿，你已经看得很快啦！",
            "nextDialogs": [
              "120070315"
            ]
          },
          "120070315": {
            "id": "120070315",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "笔记看完了吗？",
            "nextDialogs": [
              "120070316"
            ]
          },
          "120070316": {
            "id": "120070316",
            "speakerId": 1001,
            "speakerName": "神里绫华",
            "text": "嗯，看完了哦。",
            "nextDialogs": [
              "120070317"
            ]
          },
          "120070317": {
            "id": "120070317",
            "speakerId": 1001,
            "speakerName": "神里绫华",
            "text": "我想，我应当和你们分享这本笔记的真相。",
            "nextDialogs": [
              "120070318"
            ]
          },
          "120070318": {
            "id": "120070318",
            "speakerId": 1001,
            "speakerName": "神里绫华",
            "text": "虽然，里面的内容跟我想的完全不同就是了…",
            "nextDialogs": [
              "120070319"
            ]
          },
          "120070319": {
            "id": "120070319",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "不同？这不是狐狸神使的笔记吗？",
            "nextDialogs": [
              "120070320"
            ]
          },
          "120070320": {
            "id": "120070320",
            "speakerId": 1001,
            "speakerName": "神里绫华",
            "text": "不是狐狸神使。",
            "nextDialogs": [
              "120070321"
            ]
          },
          "120070321": {
            "id": "120070321",
            "speakerId": 1001,
            "speakerName": "神里绫华",
            "text": "「椿」的真身…",
            "nextDialogs": [
              "120070322"
            ]
          },
          "120070322": {
            "id": "120070322",
            "speakerId": 1001,
            "speakerName": "神里绫华",
            "text": "就是我的母亲。",
            "nextDialogs": [
              "120070323"
            ]
          },
          "120070323": {
            "id": "120070323",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "哎？！",
            "nextDialogs": [
              "120070324"
            ]
          },
          "120070324": {
            "id": "120070324",
            "speakerId": 1001,
            "speakerName": "神里绫华",
            "text": "很惊讶对吧？我、我也很惊讶…但这本笔记一开始便这样写了。",
            "nextDialogs": [
              "120070325"
            ]
          },
          "120070325": {
            "id": "120070325",
            "speakerId": 1001,
            "speakerName": "神里绫华",
            "text": "「椿与平时的我既相同又不同，作为椿时，我不是神里华代，而是一个最最平凡的女子。」",
            "nextDialogs": [
              "120070326"
            ]
          },
          "120070326": {
            "id": "120070326",
            "speakerId": 1001,
            "speakerName": "神里绫华",
            "text": "「以下所有，仅仅是一个普通的我所记录的生活琐事罢了。」",
            "nextDialogs": [
              "120070327"
            ]
          },
          "120070327": {
            "id": "120070327",
            "speakerId": 1001,
            "speakerName": "神里绫华",
            "text": "笔记中写的，大多是母亲平日里私密又琐碎的小心思…那些我们以为与「椿」有关的事，也是属于她的想法。",
            "nextDialogs": [
              "120070328"
            ]
          },
          "120070328": {
            "id": "120070328",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "意思是说，设计图纸跟异国料理…",
            "nextDialogs": [
              "120070329"
            ]
          },
          "120070329": {
            "id": "120070329",
            "speakerId": 1001,
            "speakerName": "神里绫华",
            "text": "嗯，都是我母亲想要尝试的东西。",
            "nextDialogs": [
              "120070330"
            ]
          },
          "120070330": {
            "id": "120070330",
            "speakerId": 1001,
            "speakerName": "神里绫华",
            "text": "或许对你们来说有些奇怪，但作为我而言，非常能够理解母亲的这种行为。",
            "nextDialogs": [
              "120070331"
            ]
          },
          "120070331": {
            "id": "120070331",
            "speakerId": 1001,
            "speakerName": "神里绫华",
            "text": "倒不如说，其实…其实我自己也有这样的一面…",
            "nextDialogs": [
              "120070332"
            ]
          },
          "120070332": {
            "id": "120070332",
            "speakerId": 1001,
            "speakerName": "神里绫华",
            "text": "看笔记的时候甚至有些不知所措，就好像是我的一些想法被人看穿了、写到笔记上一样…",
            "nextDialogs": [
              "120070333"
            ]
          },
          "120070333": {
            "id": "120070333",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "绫华…",
            "nextDialogs": [
              "120070334"
            ]
          },
          "120070334": {
            "id": "120070334",
            "speakerId": 1001,
            "speakerName": "神里绫华",
            "text": "母亲嫁给我父亲之后，就一直作为神里家的主母掌管各项事宜。社奉行身份相对尊贵，需要打点的方面非常多。",
            "nextDialogs": [
              "120070335"
            ]
          },
          "120070335": {
            "id": "120070335",
            "speakerId": 1001,
            "speakerName": "神里绫华",
            "text": "不仅如此，她的一举一动都代表着神里家族。人们总是注视着她，在这种情况下，她一定没有太多时间去做自己想做的事…",
            "nextDialogs": [
              "120070336"
            ]
          },
          "120070336": {
            "id": "120070336",
            "speakerId": 1001,
            "speakerName": "神里绫华",
            "text": "父母过世后，我和哥哥接手了神里家的一切。期间遇到的许多困难，可能对外人来说有些难以想象…",
            "nextDialogs": [
              "120070337"
            ]
          },
          "120070337": {
            "id": "120070337",
            "speakerId": 1001,
            "speakerName": "神里绫华",
            "text": "每当我遇到麻烦事，总是会想：母亲当年是否也这样做过？这样的事，她会怎么处理呢？",
            "nextDialogs": [
              "120070338"
            ]
          },
          "120070338": {
            "id": "120070338",
            "speakerId": 1001,
            "speakerName": "神里绫华",
            "text": "或许，真是太久没见她了吧。不知不觉中，就连我的记忆里也几乎只剩下母亲威严和高贵的一面。",
            "nextDialogs": [
              "120070339"
            ]
          },
          "120070339": {
            "id": "120070339",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "……",
            "nextDialogs": [
              "120070340"
            ]
          },
          "120070340": {
            "id": "120070340",
            "speakerId": 1001,
            "speakerName": "神里绫华",
            "text": "但…这是不对的。",
            "nextDialogs": [
              "120070341"
            ]
          },
          "120070341": {
            "id": "120070341",
            "speakerId": 1001,
            "speakerName": "神里绫华",
            "text": "当我看到这本笔记，就意识到了…她和我完全一样，无论我们背负着怎样的职责，也都只是一介普通人而已。",
            "nextDialogs": [
              "120070342"
            ]
          },
          "120070342": {
            "id": "120070342",
            "speakerId": 1001,
            "speakerName": "神里绫华",
            "text": "喜欢漂亮的着物，想要尝试每个地区的美食，渴望不曾见过的美景…",
            "nextDialogs": [
              "120070343"
            ]
          },
          "120070343": {
            "id": "120070343",
            "speakerId": 1001,
            "speakerName": "神里绫华",
            "text": "也许你们听见这样的话会笑话我不够成熟，但…我确实也有这样的想法。不是作为神里绫华，而是作为一个普通的女孩去生活。",
            "nextDialogs": [
              "120070344"
            ]
          },
          "120070344": {
            "id": "120070344",
            "speakerId": 1001,
            "speakerName": "神里绫华",
            "text": "母亲写到，她一直想参加稻妻本地的民间祭典。她说，天气晴朗的夜晚，自家中向远方眺望，偶尔能看见祭典的灯火。",
            "nextDialogs": [
              "120070345"
            ]
          },
          "120070345": {
            "id": "120070345",
            "speakerId": 1001,
            "speakerName": "神里绫华",
            "text": "我也看到过哦！非常热闹，人很多，灯笼里的火非常明亮，能照亮大片夜空…有时我们还要操心那里的治安问题呢。",
            "nextDialogs": [
              "120070346"
            ]
          },
          "120070346": {
            "id": "120070346",
            "speakerId": 1001,
            "speakerName": "神里绫华",
            "text": "只是，以我们的身份，贸然参加祭典或许并不合礼数。尤其在我父母的时代，社奉行与民众的关系还没有那么亲近…",
            "nextDialogs": [
              "120070347"
            ]
          },
          "120070347": {
            "id": "120070347",
            "speakerId": 1001,
            "speakerName": "神里绫华",
            "text": "就算没有人限制我们，社奉行的人突然出现在人群中，大家多少也会投来异样的眼光吧。会想着，我们去那里是要做什么呢？",
            "nextDialogs": [
              "120070348"
            ]
          },
          "120070348": {
            "id": "120070348",
            "speakerId": 1001,
            "speakerName": "神里绫华",
            "text": "母亲说，她不想让别人感到拘谨，希望大家尽情享受祭典的快乐与自由…她不愿打扰别人，也没有那么多闲暇，便一次都没有去过了。",
            "nextDialogs": [
              "120070349"
            ]
          },
          "120070349": {
            "id": "120070349",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "原来是这样…所以那张设计图纸上画的是她打算穿去祭典的衣服吗？",
            "nextDialogs": [
              "120070350"
            ]
          },
          "120070350": {
            "id": "120070350",
            "speakerId": 1001,
            "speakerName": "神里绫华",
            "text": "是的。祭典上有时会售卖异国料理，那些也是她想要尝试的东西。",
            "nextDialogs": [
              "120070351"
            ]
          },
          "120070351": {
            "id": "120070351",
            "speakerId": 1001,
            "speakerName": "神里绫华",
            "text": "说来有些冒昧，但…真没想到我的妈妈也有这么少女心的一面呢，哈哈哈。",
            "nextDialogs": [
              "120070352"
            ]
          },
          "120070352": {
            "id": "120070352",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "才不冒昧呢，我认为，你妈妈是个可爱又有责任心的人！",
            "nextDialogs": [
              "120070353"
            ]
          },
          "120070353": {
            "id": "120070353",
            "speakerId": 1001,
            "speakerName": "神里绫华",
            "text": "……",
            "nextDialogs": [
              "120070354"
            ]
          },
          "120070354": {
            "id": "120070354",
            "speakerId": 1001,
            "speakerName": "神里绫华",
            "text": "不知不觉中，我为母亲完成了一些愿望。唯独去祭典一事，我无法替她完成。",
            "nextDialogs": [
              "120070355"
            ]
          },
          "120070355": {
            "id": "120070355",
            "speakerId": 1001,
            "speakerName": "神里绫华",
            "text": "似乎…也没有机会见到她完成这件事了呢。",
            "nextDialogs": [
              "120070358"
            ]
          },
          "120070358": {
            "id": "120070358",
            "speakerId": 1001,
            "speakerName": "神里绫华",
            "text": "嗯，我明白。",
            "nextDialogs": [
              "120070359"
            ]
          },
          "120070359": {
            "id": "120070359",
            "speakerId": 1001,
            "speakerName": "神里绫华",
            "text": "…谢谢你们，我好像明白了一些事呢。",
            "nextDialogs": [
              "120070360"
            ]
          },
          "120070360": {
            "id": "120070360",
            "speakerId": 1001,
            "speakerName": "神里绫华",
            "text": "母亲和我，在某些方面是完全一样的。她所面临的事，同样也是我将要面对的事。",
            "nextDialogs": [
              "120070361"
            ]
          },
          "120070361": {
            "id": "120070361",
            "speakerId": 1001,
            "speakerName": "神里绫华",
            "text": "她把无法实现的事寄托在「椿」身上，而我…已经下定决心了。",
            "nextDialogs": [
              "120070362"
            ]
          },
          "120070362": {
            "id": "120070362",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "咦！难道你也要…",
            "nextDialogs": [
              "120070363"
            ]
          },
          "120070363": {
            "id": "120070363",
            "speakerId": 1001,
            "speakerName": "神里绫华",
            "text": "不，我…",
            "nextDialogs": [
              "120070364"
            ]
          },
          "120070364": {
            "id": "120070364",
            "speakerId": 1001,
            "speakerName": "神里绫华",
            "text": "我不打算用这样的方式。我想…我有了新的目标，我会不留遗憾地度过每一天。",
            "nextDialogs": [
              "120070365"
            ]
          },
          "120070365": {
            "id": "120070365",
            "speakerId": 1001,
            "speakerName": "神里绫华",
            "text": "那个…旅行者，我…呃…",
            "nextDialogs": [
              "120070366"
            ]
          },
          "120070366": {
            "id": "120070366",
            "speakerId": 1001,
            "speakerName": "神里绫华",
            "text": "呼…放松，放松…",
            "nextDialogs": [
              "120070367"
            ]
          },
          "120070367": {
            "id": "120070367",
            "speakerId": 1001,
            "speakerName": "神里绫华",
            "text": "你对我们这里的祭典有兴趣吗？",
            "nextDialogs": [
              "120070368"
            ]
          },
          "120070368": {
            "id": "120070368",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "从看到海报开始，我就一直想去哦！绫华是不是也有兴趣？",
            "nextDialogs": [
              "120070369"
            ]
          },
          "120070369": {
            "id": "120070369",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "绫华，你也没去过祭典吗？",
            "nextDialogs": [
              "120070370"
            ]
          },
          "120070370": {
            "id": "120070370",
            "speakerId": 1001,
            "speakerName": "神里绫华",
            "text": "啊啊，请不要笑话我！我、我也曾担心过那些事…不过，已经不要紧了。",
            "nextDialogs": [
              "120070371"
            ]
          },
          "120070371": {
            "id": "120070371",
            "speakerId": 1001,
            "speakerName": "神里绫华",
            "text": "我打算真诚地面对自己的心，完成这个同样属于我的愿望。如果是你的话，一定不会责怪我的任性…",
            "nextDialogs": [
              "120070372"
            ]
          },
          "120070372": {
            "id": "120070372",
            "speakerId": 1001,
            "speakerName": "神里绫华",
            "text": "我想…我想请你和我一起去祭典！",
            "nextDialogs": [
              "120070373"
            ]
          },
          "120070373": {
            "id": "120070373",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "我非常乐意。",
            "nextDialogs": [
              "120070374"
            ]
          },
          "120070374": {
            "id": "120070374",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "要去要去！祭典上肯定有很多好吃的吧？还有好玩的，嘿嘿！",
            "nextDialogs": [
              "120070375"
            ]
          },
          "120070375": {
            "id": "120070375",
            "speakerId": 1001,
            "speakerName": "神里绫华",
            "text": "…太好了，谢谢你们！",
            "nextDialogs": [
              "120070376"
            ]
          },
          "120070376": {
            "id": "120070376",
            "speakerId": 1001,
            "speakerName": "神里绫华",
            "text": "现在去的话，应该还能赶上。",
            "nextDialogs": [
              "120070377"
            ]
          },
          "120070377": {
            "id": "120070377",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "对哦，今天好像是最后一天吧？还等什么，快走快走！"
          }
        }
      }
    },

  },
  "subQuests": [
    {
      "subId": "7104201",
      "subQuestName": "向瑾武讲述发生的事",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "710420101"
        ],
        "dialogs": {
          "710420101": {
            "id": "710420101",
            "speakerId": 20580,
            "speakerName": "瑾武",
            "text": "啊，你们回来了。",
            "nextDialogs": [
              "710420102"
            ]
          },
          "710420102": {
            "id": "710420102",
            "speakerId": 20580,
            "speakerName": "瑾武",
            "text": "嗯…克里托夫？你来这里做什么？",
            "nextDialogs": [
              "710420103"
            ]
          },
          "710420103": {
            "id": "710420103",
            "speakerId": 2617,
            "speakerName": "克里托夫",
            "text": "嘿嘿…这个嘛…",
            "nextDialogs": [
              "710420104"
            ]
          },
          "710420104": {
            "id": "710420104",
            "speakerId": 20006,
            "speakerName": "志琼",
            "text": "瑾武姐也认得这家伙？",
            "nextDialogs": [
              "710420105"
            ]
          },
          "710420105": {
            "id": "710420105",
            "speakerId": 20580,
            "speakerName": "瑾武",
            "text": "嗯，认得。矿上卖假药的。到处兜售什么「大汉药水」，工人们买来一看，都是落落莓糖浆。",
            "nextDialogs": [
              "710420106"
            ]
          },
          "710420106": {
            "id": "710420106",
            "speakerId": 20580,
            "speakerName": "瑾武",
            "text": "不过…无毒无害，便宜不难喝，还专门冰镇过。比大老远上城里采购饮料实惠多了。",
            "nextDialogs": [
              "710420107"
            ]
          },
          "710420107": {
            "id": "710420107",
            "speakerId": 20580,
            "speakerName": "瑾武",
            "text": "怎么？几年没见，跟盗宝团混了？",
            "nextDialogs": [
              "710420108"
            ]
          },
          "710420108": {
            "id": "710420108",
            "speakerId": 2617,
            "speakerName": "克里托夫",
            "text": "嗯…可以这么说吧…哈哈…",
            "nextDialogs": [
              "710420109"
            ]
          },
          "710420109": {
            "id": "710420109",
            "speakerId": 20006,
            "speakerName": "志琼",
            "text": "大姐怎么知道他是…",
            "nextDialogs": [
              "710420110"
            ]
          },
          "710420110": {
            "id": "710420110",
            "speakerId": 20580,
            "speakerName": "瑾武",
            "text": "哈哈，你不知道的还多着呢。矿下二十来年不见天日，我是白干的吗？",
            "nextDialogs": [
              "710420111"
            ]
          },
          "710420111": {
            "id": "710420111",
            "speakerId": 20580,
            "speakerName": "瑾武",
            "text": "脸上的矿灰好洗，手上染的颜色是洗不掉咯。",
            "nextDialogs": [
              "710420112"
            ]
          },
          "710420112": {
            "id": "710420112",
            "speakerId": 20580,
            "speakerName": "瑾武",
            "text": "好了，告诉我，你有什么用？勘探队的物资可喂不饱卖呆耍闲的人。",
            "nextDialogs": [
              "710420119",
              "710420115"
            ]
          },
          "710420119": {
            "id": "710420119",
            "speakerId": 20580,
            "speakerName": "瑾武",
            "text": "嗯。之前学的炼金术派上用场了，是吧？不错，我们正好还缺一个爆破组。",
            "nextDialogs": [
              "710420120"
            ]
          },
          "710420120": {
            "id": "710420120",
            "speakerId": 20006,
            "speakerName": "志琼",
            "text": "可我们不是已经从蒙德联络了一位爆破手吗？为什么一定要信任他？",
            "nextDialogs": [
              "710420121"
            ]
          },
          "710420121": {
            "id": "710420121",
            "speakerId": 20580,
            "speakerName": "瑾武",
            "text": "啊，你说她呀。沐宁今早收到蒙德那边的致歉信，那孩子因为…唔，炸了「猎鹿人」的灶台？被关了禁闭…",
            "nextDialogs": [
              "710420122"
            ]
          },
          "710420122": {
            "id": "710420122",
            "speakerId": 20580,
            "speakerName": "瑾武",
            "text": "就连预计要一起来的那位，她的监护人…什么骑兵队长的…也一并被关了禁闭。",
            "nextDialogs": [
              "710420123"
            ]
          },
          "710420123": {
            "id": "710420123",
            "speakerId": 20580,
            "speakerName": "瑾武",
            "text": "看不明白，不知道是蒙德人的暗号还是什么。反正她来不了了。",
            "nextDialogs": [
              "710420124"
            ]
          },
          "710420124": {
            "id": "710420124",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "唔…会是谁呢…？"
          },
          "710420115": {
            "id": "710420115",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "哈哈哈哈哈哈！这也算吗！",
            "nextDialogs": [
              "710420116"
            ]
          },
          "710420116": {
            "id": "710420116",
            "speakerId": 20580,
            "speakerName": "瑾武",
            "text": "当然不算。",
            "nextDialogs": [
              "710420117"
            ]
          },
          "710420117": {
            "id": "710420117",
            "speakerId": 2617,
            "speakerName": "克里托夫",
            "text": "调配炸药…算不算？",
            "nextDialogs": [
              "710420118"
            ]
          },
          "710420118": {
            "id": "710420118",
            "speakerId": 20580,
            "speakerName": "瑾武",
            "text": "……"
          }
        }
      }
    },
    {
      "subId": "7104203",
      "subQuestName": "寻找两把火药库房的钥匙",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "710420301"
        ],
        "dialogs": {
          "710420301": {
            "id": "710420301",
            "speakerId": 2617,
            "speakerName": "克里托夫",
            "text": "怎么样？调配好磐石精油了吗？",
            "nextDialogs": [
              "710420302"
            ]
          },
          "710420302": {
            "id": "710420302",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "调配完成啦！我们保管得很小心哦！",
            "nextDialogs": [
              "710420303"
            ]
          },
          "710420303": {
            "id": "710420303",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "这里就是了。"
          }
        }
      }
    },
    {
      "subId": "7104202",
      "subQuestName": "寻找两把火药库房的钥匙",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "710420201"
        ],
        "dialogs": {
          "710420201": {
            "id": "710420201",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "我们已经找到炮弹啦！你看，完好无损哦！引信怎么样啦？",
            "nextDialogs": [
              "710420202"
            ]
          },
          "710420202": {
            "id": "710420202",
            "speakerId": 2617,
            "speakerName": "克里托夫",
            "text": "…不太好。炮弹的引信都不能用了。",
            "nextDialogs": [
              "710420203"
            ]
          },
          "710420203": {
            "id": "710420203",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "怎会如此？",
            "nextDialogs": [
              "710420204"
            ]
          },
          "710420204": {
            "id": "710420204",
            "speakerId": 2617,
            "speakerName": "克里托夫",
            "text": "库房里存放的都是以催化岩元素反应为条件才能触发的引信…但很显然，矿坑深处的异变也影响了它们。",
            "nextDialogs": [
              "710420205"
            ]
          },
          "710420205": {
            "id": "710420205",
            "speakerId": 2617,
            "speakerName": "克里托夫",
            "text": "引信内部的岩元素催化物结成了奇怪的蓝色晶体，变成了某种惰性物质…引信全废了。",
            "nextDialogs": [
              "710420206"
            ]
          },
          "710420206": {
            "id": "710420206",
            "speakerId": 2617,
            "speakerName": "克里托夫",
            "text": "这下麻烦了…还没有预计到这么邪门的情况。",
            "nextDialogs": [
              "710420207"
            ]
          },
          "710420207": {
            "id": "710420207",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "哇…虽然每个字都是人话，为什么这个人的语言我什么也听不懂…",
            "nextDialogs": [
              "710420208"
            ]
          },
          "710420208": {
            "id": "710420208",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "炮弹没有引信的话会怎样？",
            "nextDialogs": [
              "710420209"
            ]
          },
          "710420209": {
            "id": "710420209",
            "speakerId": 2617,
            "speakerName": "克里托夫",
            "text": "这个问题还挺没水准的…",
            "nextDialogs": [
              "710420210"
            ]
          },
          "710420210": {
            "id": "710420210",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "欸？你说什么？大点声！",
            "nextDialogs": [
              "710420211"
            ]
          },
          "710420211": {
            "id": "710420211",
            "speakerId": 2617,
            "speakerName": "克里托夫",
            "text": "没…没什么。我是说，这里的炮弹都是这样的。如果没有安装引信的话，就算当球踢也不用担心爆炸。",
            "nextDialogs": [
              "710420212"
            ]
          },
          "710420212": {
            "id": "710420212",
            "speakerId": 2617,
            "speakerName": "克里托夫",
            "text": "因为嗯…引信是引爆炮弹的催化物，你明白吧？岩元素反应产生的能量引发炮弹内容物的元素反应，然后…",
            "nextDialogs": [
              "710420213"
            ]
          },
          "710420213": {
            "id": "710420213",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "然后我就懂啦！「嘣——！」对吧？",
            "nextDialogs": [
              "710420214"
            ]
          },
          "710420214": {
            "id": "710420214",
            "speakerId": 2617,
            "speakerName": "克里托夫",
            "text": "嗯…没错。但没有引信的话，炮弹就怎么样也没法引爆了…真是让人头疼。",
            "nextDialogs": [
              "710420215"
            ]
          },
          "710420215": {
            "id": "710420215",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "岩元素反应本身不就是惰性的吗？",
            "nextDialogs": [
              "710420216"
            ]
          },
          "710420216": {
            "id": "710420216",
            "speakerId": 2617,
            "speakerName": "克里托夫",
            "text": "嗯？炼金术的基础知识，对吧？哈哈，但元素的潜力是我们所难以预料的。",
            "nextDialogs": [
              "710420217"
            ]
          },
          "710420217": {
            "id": "710420217",
            "speakerId": 2617,
            "speakerName": "克里托夫",
            "text": "嗯…假如在一个小容器内压缩入足够浓度的岩元素微粒的话，一旦激发反应，其产生的爆发力也是非常强大的。",
            "nextDialogs": [
              "710420218"
            ]
          },
          "710420218": {
            "id": "710420218",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "唔…就和拥有岩元素神之眼的人能操使的奇怪力量差不多吧…？",
            "nextDialogs": [
              "710420219"
            ]
          },
          "710420219": {
            "id": "710420219",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "那么他们把岩元素都藏在哪里了呢…？",
            "nextDialogs": [
              "710420220"
            ]
          },
          "710420220": {
            "id": "710420220",
            "speakerId": 2617,
            "speakerName": "克里托夫",
            "text": "元素使用者的原理算是特例啦…和我所说的，璃月矿工常用的临时引信制作方法，是完全不同的。",
            "nextDialogs": [
              "710420221"
            ]
          },
          "710420221": {
            "id": "710420221",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "你一个蒙德的盗宝团，怎么说话比璃月人自己都懂的？",
            "nextDialogs": [
              "710420222"
            ]
          },
          "710420222": {
            "id": "710420222",
            "speakerId": 2617,
            "speakerName": "克里托夫",
            "text": "嘿嘿，你猜？",
            "nextDialogs": [
              "710420223"
            ]
          },
          "710420223": {
            "id": "710420223",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "呜——！好想揍这个假药人！",
            "nextDialogs": [
              "710420225"
            ]
          },
          "710420225": {
            "id": "710420225",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "什么啦！这是把我当狗狗了吗！",
            "nextDialogs": [
              "710420227"
            ]
          },
          "710420227": {
            "id": "710420227",
            "speakerId": 2617,
            "speakerName": "克里托夫",
            "text": "咳咳…如果各位愿意相信我的话，我可以用这里的合成台做出一个简易引信。",
            "nextDialogs": [
              "710420228"
            ]
          },
          "710420228": {
            "id": "710420228",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "唔…你的话…不是不相信你啦，可毕竟你是盗宝团来的，而且又不是矿工…谁知道你会不会把我们都炸上天呢？",
            "nextDialogs": [
              "710420229"
            ]
          },
          "710420229": {
            "id": "710420229",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "#况且就算我信任你，{NICKNAME}也不会…",
            "nextDialogs": [
              "710420230"
            ]
          },
          "710420230": {
            "id": "710420230",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "就交给你了。",
            "nextDialogs": [
              "710420231"
            ]
          },
          "710420231": {
            "id": "710420231",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "欸——？明明刚刚在营地里的时候，志琼不是说…",
            "nextDialogs": [
              "710420232"
            ]
          },
          "710420232": {
            "id": "710420232",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "哼，好啦，不要和我解释啦！真拿你没办法…"
          }
        }
      }
    },

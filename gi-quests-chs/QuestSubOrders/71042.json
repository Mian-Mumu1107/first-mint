          },
          "710420902": {
            "id": "710420902",
            "speakerId": 2156,
            "speakerName": "「安全距离爆破装置·信号指南」",
            "text": "「中位灯桩，低频闪烁。」",
            "nextDialogs": [
              "710420903"
            ]
          },
          "710420903": {
            "id": "710420903",
            "speakerId": 2156,
            "speakerName": "「安全距离爆破装置·信号指南」",
            "text": "「高地灯桩，低频闪烁。」",
            "nextDialogs": [
              "710420904"
            ]
          },
          "710420904": {
            "id": "710420904",

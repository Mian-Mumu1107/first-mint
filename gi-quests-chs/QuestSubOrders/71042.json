    {
      "subId": "7104215",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "710421501"
        ],
        "dialogs": {
          "710421501": {
            "id": "710421501",
            "speakerId": 20006,
            "speakerName": "志琼",
            "text": "在矿工们发现这个东西之后，「流明石」开始在层岩巨渊里肆意增生…它们之间一定有着什么联系。",
            "nextDialogs": [
              "710421507"
            ]
          },
          "710421507": {
            "id": "710421507",
            "speakerId": 20006,
            "speakerName": "志琼",
            "text": "近来层岩巨渊的地质结构变化一直在…加速。你也看到了那些覆盖岩石的污黑物质…是近来才大面积增生的。",
            "nextDialogs": [
              "710421508"
            ]
          },
          "710421508": {
            "id": "710421508",
            "speakerId": 20006,
            "speakerName": "志琼",
            "text": "我不敢确定，但或许都和这些流动的光…和这块漂浮的晶石碎片有关。",
            "nextDialogs": [
              "710421509"
            ]
          },
          "710421509": {
            "id": "710421509",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "唔…为什么呀？",
            "nextDialogs": [
              "710421510"
            ]
          },
          "710421510": {
            "id": "710421510",
            "speakerId": 20006,
            "speakerName": "志琼",
            "text": "呃…它们…都给我一种不舒服的感觉…？",
            "nextDialogs": [
              "710421511"
            ]
          },
          "710421511": {
            "id": "710421511",
            "speakerId": 20006,
            "speakerName": "志琼",
            "text": "就像…坐马车会头晕想吐，或者坐船遇到风浪会失去方向感一样的感觉…",
            "nextDialogs": [
              "710421512"
            ]
          },
          "710421512": {
            "id": "710421512",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "欸？有吗？我感觉还好呀？",
            "nextDialogs": [
              "710421515"
            ]
          },
          "710421515": {
            "id": "710421515",
            "speakerId": 20006,
            "speakerName": "志琼",
            "text": "谢谢前辈关心，我没关系的。我之前也不是没有忍受过高山反应和晕船…这点不舒服，算不得什么的。"
          }
        }
      }
    }
  ]

    {
      "subId": "7104204",
      "subQuestName": "前往打开火药库房的大门",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "710420401"
        ],
        "dialogs": {
          "710420401": {
            "id": "710420401",
            "speakerId": 2617,
            "speakerName": "克里托夫",
            "text": "嗯…没错，不要晃，稳住…就是这样，精油看起来应该没有问题。接下来只需要把引信装在炮弹里面就大功告成了。",
            "nextDialogs": [
              "710420444"
            ]
          },
          "710420444": {
            "id": "710420444",
            "speakerId": 1004,
            "speakerName": "Black Screen",
            "text": "克里托夫一通忙碌，将引信组装在了炮弹上…",
            "nextDialogs": [
              "710420402"
            ]
          },
          "710420402": {
            "id": "710420402",
            "speakerId": 2617,
            "speakerName": "克里托夫",
            "text": "好了，这下就可以了。呼…小心不要磕磕碰碰的，不然的话可就热闹了…",
            "nextDialogs": [
              "710420403"
            ]
          },
          "710420403": {
            "id": "710420403",
            "speakerId": 20006,
            "speakerName": "志琼",
            "text": "我回来了！在矿道深处又测绘了新的地图，前辈请看一看吧！",
            "nextDialogs": [
              "710420404"
            ]
          },
          "710420404": {
            "id": "710420404",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "谢谢，辛苦你了。",
            "nextDialogs": [
              "710420405"
            ]
          },
          "710420405": {
            "id": "710420405",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "辛苦了！",
            "nextDialogs": [
              "710420406"
            ]
          },
          "710420406": {
            "id": "710420406",
            "speakerId": 20006,
            "speakerName": "志琼",
            "text": "没什么的，能帮上忙就好…你们这边怎么样？炮弹找到了吗？",
            "nextDialogs": [
              "710420407"
            ]
          },
          "710420407": {
            "id": "710420407",
            "speakerId": 2617,
            "speakerName": "克里托夫",
            "text": "喂，小心一点！炮弹已经装上了引信，你这么大的动作会害了我们所有人的！",
            "nextDialogs": [
              "710420408"
            ]
          },
          "710420408": {
            "id": "710420408",
            "speakerId": 20006,
            "speakerName": "志琼",
            "text": "你这家伙，什么时候这么趾高气扬了！",
            "nextDialogs": [
              "710420409"
            ]
          },
          "710420409": {
            "id": "710420409",
            "speakerId": 2617,
            "speakerName": "克里托夫",
            "text": "如果你手里握着炸弹，你说话也会有底气许多的。",
            "nextDialogs": [
              "710420410"
            ]
          },
          "710420410": {
            "id": "710420410",
            "speakerId": 20006,
            "speakerName": "志琼",
            "text": "怎么，你要威胁我是吗？盗宝团的狐狸尾巴不藏了？你想把我们全炸飞吗？",
            "nextDialogs": [
              "710420411"
            ]
          },
          "710420411": {
            "id": "710420411",
            "speakerId": 2617,
            "speakerName": "克里托夫",
            "text": "我说过了，炸弹又不会认人。你再这样提高音量，可就不是我想不想炸飞你的问题了。",
            "nextDialogs": [
              "710420412"
            ]
          },
          "710420412": {
            "id": "710420412",
            "speakerId": 20006,
            "speakerName": "志琼",
            "text": "哼，我又没办法决定你怎么想，谁知道你的脑袋里转着什么歪心思？",
            "nextDialogs": [
              "710420413"
            ]
          },
          "710420413": {
            "id": "710420413",
            "speakerId": 20006,
            "speakerName": "志琼",
            "text": "参加过盗宝团的大抵都差不多，犯罪者心理，犯罪者思路…说的就是你们，现在可好，炸弹也跑到了你手里？",
            "nextDialogs": [
              "710420414"
            ]
          },
          "710420414": {
            "id": "710420414",
            "speakerId": 2617,
            "speakerName": "克里托夫",
            "text": "那又怎么样？放在你手里早就把我们炸飞三十次都不够了！",
            "nextDialogs": [
              "710420417"
            ]
          },
          "710420417": {
            "id": "710420417",
            "speakerId": 20006,
            "speakerName": "志琼",
            "text": "唔…抱歉，前辈。我只是信不过这个盗宝团的家伙。",
            "nextDialogs": [
              "710420418"
            ]
          },
          "710420418": {
            "id": "710420418",
            "speakerId": 2617,
            "speakerName": "克里托夫",
            "text": "哼，我也很难对一个疑心病患者保持尊重。",
            "nextDialogs": [
              "710420419"
            ]
          },
          "710420419": {
            "id": "710420419",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "你们两个，能不能听我说！",
            "nextDialogs": [
              "710420420"
            ]
          },
          "710420420": {
            "id": "710420420",
            "speakerId": 20006,
            "speakerName": "志琼",
            "text": "…好的，前辈。",
            "nextDialogs": [
              "710420421"
            ]
          },
          "710420421": {
            "id": "710420421",
            "speakerId": 2617,
            "speakerName": "克里托夫",
            "text": "你请说。",
            "nextDialogs": [
              "710420422"
            ]
          },
          "710420422": {
            "id": "710420422",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "不是我在要求你们彼此信任…",
            "nextDialogs": [
              "710420423"
            ]
          },
          "710420423": {
            "id": "710420423",
            "speakerId": 20006,
            "speakerName": "志琼",
            "text": "我知道，可是他…"
          }
        }
      }
    },
    {
      "subId": "7104205",
      "subQuestName": "找到炮弹",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "710420501"
        ],
        "dialogs": {
          "710420501": {
            "id": "710420501",
            "speakerId": 20006,
            "speakerName": "志琼",
            "text": "成功了！前辈你看，我们成功了！",
            "nextDialogs": [
              "710420502"
            ]
          },
          "710420502": {
            "id": "710420502",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "好耶！正中目标！",
            "nextDialogs": [
              "710420505"
            ]
          },
          "710420505": {
            "id": "710420505",
            "speakerId": 20006,
            "speakerName": "志琼",
            "text": "克里托夫那家伙还有两把刷子…我们之前真是错怪他了。"
          }
        }
      }
    },
    {
      "subId": "7104206",
      "subQuestName": "将炮弹带回勘探队营地",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [],
        "dialogs": {}
      }
    },
    {
      "subId": "7104207",
      "subQuestName": "调配三个「特殊的磐石精油」",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "710420701"
        ],
        "dialogs": {
          "710420701": {
            "id": "710420701",
            "speakerId": 20006,
            "speakerName": "志琼",
            "text": "呼…呼…谢谢你们，这些怪物实在是太难缠了…以前从来没有见过…不知道从哪来的…",
            "nextDialogs": [
              "710420702"
            ]
          },
          "710420702": {
            "id": "710420702",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "#哇…怎么你比我们还要累呀…明明全是{NICKNAME}在出力。",
            "nextDialogs": [
              "710420705"
            ]
          },
          "710420705": {
            "id": "710420705",
            "speakerId": 20006,
            "speakerName": "志琼",
            "text": "抱歉…抱歉拖累你们了…我没事的…呼…在这里休息一下就好了。只是…这里空气稀薄，有点胸闷…",
            "nextDialogs": [
              "710420706"
            ]
          },
          "710420706": {
            "id": "710420706",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "唔…你这个样子，看得我都胸闷啦…",
            "nextDialogs": [
              "710420707"
            ]
          },
          "710420707": {
            "id": "710420707",
            "speakerId": 20006,
            "speakerName": "志琼",
            "text": "没事的…我们再去调查一下…那些机关吧。我刚刚看到有些光点在高处的断崖飘荡停留，就像…有生命一样…",
            "nextDialogs": [
              "710420708"
            ]
          },
          "710420708": {
            "id": "710420708",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "哇…你还是在这里休息吧，我们去就好啦！你可不要倒在这里呀！",
            "nextDialogs": [
              "710420709"
            ]
          },
          "710420709": {
            "id": "710420709",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "#唔…我们按照志琼的提示，再去调查一下那些光点吧？{NICKNAME}！",
            "nextDialogs": [
              "710420710"
            ]
          },
          "710420710": {
            "id": "710420710",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "不知为什么，总觉得它们能够再次激活那些机关呢…"
          }
        }
      }
    },
    {
      "subId": "7104208",
      "subQuestName": "将「特殊的磐石精油」交给克里托夫",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "710420801"
        ],
        "dialogs": {
          "710420801": {
            "id": "710420801",
            "speakerId": 20006,
            "speakerName": "志琼",
            "text": "咳咳…咳咳！咳咳…哈…哈…",
            "nextDialogs": [
              "710420802"
            ]
          },
          "710420802": {
            "id": "710420802",
            "speakerId": 20006,
            "speakerName": "志琼",
            "text": "呼…！好多了！空气突然…咳咳…！清新了好多！",
            "nextDialogs": [
              "710420803"
            ]
          },
          "710420803": {
            "id": "710420803",
            "speakerId": 20006,
            "speakerName": "志琼",
            "text": "那东西…飞走了，为我们砸开了一条通路？",
            "nextDialogs": [
              "710420804"
            ]
          },
          "710420804": {
            "id": "710420804",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "哇…你这样好吓人！好像那个…怎么说来着…就好像「回光访赵」一样！",
            "nextDialogs": [
              "710420807"
            ]
          },
          "710420807": {
            "id": "710420807",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "你这家伙，又在针对我了！",
            "nextDialogs": [
              "710420808"
            ]
          },
          "710420808": {
            "id": "710420808",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "再说「回光返照」哪有这样用的！",
            "nextDialogs": [
              "710420809"
            ]
          },
          "710420809": {
            "id": "710420809",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "好啦，你也关心一下志琼嘛！",
            "nextDialogs": [
              "710420810"
            ]
          },
          "710420810": {
            "id": "710420810",
            "speakerId": 20006,
            "speakerName": "志琼",
            "text": "哈哈…没事了。刚刚或许只是不适反应而已，看起来可能有点吓人…不过没什么的，前辈请不要太过在意。",
            "nextDialogs": [
              "710420811"
            ]
          },
          "710420811": {
            "id": "710420811",
            "speakerId": 20006,
            "speakerName": "志琼",
            "text": "就像…普通人第一次登上极高的山，难免会因为空气稀薄而昏厥，或者在极深的海里，双肺会被海水压得透不过气…",
            "nextDialogs": [
              "710420812"
            ]
          },
          "710420812": {
            "id": "710420812",
            "speakerId": 20006,
            "speakerName": "志琼",
            "text": "这些都是小问题，都是冒险家必经的困难。没关系的，真的。",
            "nextDialogs": [
              "710420813"
            ]
          },
          "710420813": {
            "id": "710420813",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "什么小问题啦…被你说得这么可怕！"
          }
        }
      }
    },

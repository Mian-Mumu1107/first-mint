    {
      "subId": "7104231",
      "subQuestName": "与志琼一同装填炮弹",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [],
        "dialogs": {}
      }
    },
    {
      "subId": "7104232",
      "subQuestName": "与志琼交谈",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "710421401"
        ],
        "dialogs": {
          "710421401": {
            "id": "710421401",
            "speakerId": 20006,
            "speakerName": "志琼",
            "text": "现在我们可以装填炮弹了，小心…炮弹已经安装了引信…",
            "nextDialogs": [
              "710421402"
            ]
          },
          "710421402": {
            "id": "710421402",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "唔…早知道的话，我们在这里组装引信，就地装填不就好啦…",
            "nextDialogs": [
              "710421403"
            ]
          },
          "710421403": {
            "id": "710421403",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "装都装了，就不要说这种话了…",
            "nextDialogs": [
              "710421404"
            ]
          },
          "710421404": {
            "id": "710421404",
            "speakerId": 20006,
            "speakerName": "志琼",
            "text": "前辈，请帮把手！",
            "nextDialogs": [
              "710421405"
            ]
          },
          "710421405": {
            "id": "710421405",
            "speakerId": 1004,
            "speakerName": "Black Screen",
            "text": "你们成功装填了炮弹，幸而无事发生。"
          }
        }
      }
    },
    {
      "subId": "7104211",
      "subQuestName": "操纵大炮击碎封山岩石",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "710421101"
        ],
        "dialogs": {
          "710421101": {
            "id": "710421101",
            "speakerId": 2617,
            "speakerName": "克里托夫",
            "text": "我很感谢你能信任我，我是不会让大家失望的。",
            "nextDialogs": [
              "710421104",
              "710421105"
            ]
          },
          "710421104": {
            "id": "710421104",
            "speakerId": 2617,
            "speakerName": "克里托夫",
            "text": "嗯，我明白的…呃，我就不耽误你了。"
          },
          "710421105": {
            "id": "710421105",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "关于志琼…",
            "nextDialogs": [
              "710421106"
            ]
          },
          "710421106": {
            "id": "710421106",
            "speakerId": 2617,
            "speakerName": "克里托夫",
            "text": "她呀…一直很神经质的样子。可能是矿下的「黑泥」接触太多了吧，她该学会多休息，总是紧绷绷的怎么行。",
            "nextDialogs": [
              "710421107"
            ]
          },
          "710421107": {
            "id": "710421107",
            "speakerId": 2617,
            "speakerName": "克里托夫",
            "text": "哼，不过还好，我能容忍的。也多谢你和瑾武姐能信任我了。"
          }
        }
      }
    },
    {
      "subId": "7104212",
      "subQuestName": "与志琼交谈",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [],
        "dialogs": {}
      }
    },
    {
      "subId": "7104213",
      "subQuestName": "继续深入",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [],
        "dialogs": {}
      }
    },
    {
      "subId": "7104215",
      "subQuestName": "与志琼交谈",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "710420601"
        ],
        "dialogs": {
          "710420601": {
            "id": "710420601",
            "speakerId": 20006,
            "speakerName": "志琼",
            "text": "在矿工们发现这个东西之后，「流明石」开始在层岩巨渊里肆意增生…它们之间一定有着什么联系。",
            "nextDialogs": [
              "710420602"
            ]
          },
          "710420602": {
            "id": "710420602",
            "speakerId": 20006,
            "speakerName": "志琼",
            "text": "从它漂浮的样子，以及残损的形状来看…和霞姐提过的龙脊雪山碎片很像。",
            "nextDialogs": [
              "710420603"
            ]
          },
          "710420603": {
            "id": "710420603",
            "speakerId": 20006,
            "speakerName": "志琼",
            "text": "没错，就是前辈你发现的那些浮空碎片…说不定它也会被另一块更大的碎片吸引，最终不可阻止地与之结合？",
            "nextDialogs": [
              "710420604"
            ]
          },
          "710420604": {
            "id": "710420604",
            "speakerId": 20006,
            "speakerName": "志琼",
            "text": "说不定…在这下面，也埋藏着无名的古文明呢？就像雪山上的那座古墓？前辈意下如何呢？",
            "nextDialogs": [
              "710420607"
            ]
          },
          "710420607": {
            "id": "710420607",
            "speakerId": 20006,
            "speakerName": "志琼",
            "text": "近来层岩巨渊的地质结构变化一直在…加速。你也看到了那些覆盖岩石的污黑物质…是近来才大面积增生的。",
            "nextDialogs": [
              "710420608"
            ]
          },
          "710420608": {
            "id": "710420608",
            "speakerId": 20006,
            "speakerName": "志琼",
            "text": "我不敢确定，但或许都和这些流动的光…和这块漂浮的晶石碎片有关。",
            "nextDialogs": [
              "710420609"
            ]
          },
          "710420609": {
            "id": "710420609",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "唔…为什么呀？",
            "nextDialogs": [
              "710420610"
            ]
          },
          "710420610": {
            "id": "710420610",
            "speakerId": 20006,
            "speakerName": "志琼",
            "text": "呃…它们…都给我一种不舒服的感觉…？",
            "nextDialogs": [
              "710420611"
            ]
          },
          "710420611": {
            "id": "710420611",
            "speakerId": 20006,
            "speakerName": "志琼",
            "text": "就像…坐马车会头晕想吐，或者坐船遇到风浪会失去方向感一样的感觉…",
            "nextDialogs": [
              "710420612"
            ]
          },
          "710420612": {
            "id": "710420612",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "欸？有吗？我感觉还好呀？"
          }
        }
      }
    },
    {
      "subId": "7104216",
      "subQuestName": "激活机关$HIDDEN",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "710421601"
        ],
        "dialogs": {
          "710421601": {
            "id": "710421601",
            "speakerId": 2617,
            "speakerName": "克里托夫",
            "text": "怎么样？磐石精油调配有困难吗？",
            "nextDialogs": [
              "710421604"
            ]
          },
          "710421604": {
            "id": "710421604",
            "speakerId": 2617,
            "speakerName": "克里托夫",
            "text": "哈哈，没关系、没关系。我写的配方，就算七岁小姑娘也能配出炸药来的！多试几次，别把自己伤了就好！"
          }
        }
      }
    },

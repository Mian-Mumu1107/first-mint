  "subQuests": [
    {
      "subId": "7567501",
      "subQuestName": "前往悠悠度假村",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "756750101"
        ],
        "dialogs": {
          "756750101": {
            "id": "756750101",
            "speakerId": 1000,
            "speakerName": "昂吉安妮",
            "text": "嘿！哈！",
            "nextDialogs": [
              "756750102"
            ]
          },
          "756750102": {
            "id": "756750102",
            "speakerId": 1000,
            "speakerName": "昂吉安妮",
            "text": "我的脑袋已经被音乐占满了，跳舞跳舞！",
            "nextDialogs": [
              "756750103"
            ]
          },
          "756750103": {
            "id": "756750103",
            "speakerId": 1001,
            "speakerName": "瑟琪",
            "text": "摇摆摇摆~",
            "nextDialogs": [
              "756750104"
            ]
          },
          "756750104": {
            "id": "756750104",
            "speakerId": 1002,
            "speakerName": "梅内娅",
            "text": "快快乐乐——",
            "nextDialogs": [
              "756750105"
            ]
          },
          "756750105": {
            "id": "756750105",
            "speakerId": 1003,
            "speakerName": "莫乌",
            "text": "呜啊呜啊！",
            "nextDialogs": [
              "756750106"
            ]
          },
          "756750106": {
            "id": "756750106",
            "speakerId": 1004,
            "speakerName": "玛因",
            "text": "还赚了外快。",
            "nextDialogs": [
              "756750107"
            ]
          },
          "756750107": {
            "id": "756750107",
            "speakerId": 1000,
            "speakerName": "昂吉安妮",
            "text": "咦？你这小妞，什么时候的事？",
            "nextDialogs": [
              "756750108"
            ]
          },
          "756750108": {
            "id": "756750108",
            "speakerId": 1004,
            "speakerName": "玛因",
            "text": "努斯妲小姐忙不过来，我就抽空去支援了她的学徒，清剿了几个魔物的巢穴。",
            "nextDialogs": [
              "756750109"
            ]
          },
          "756750109": {
            "id": "756750109",
            "speakerId": 1004,
            "speakerName": "玛因",
            "text": "在纳塔，战斗和跳舞一样尽兴，喜欢。",
            "nextDialogs": [
              "756750110"
            ]
          },
          "756750110": {
            "id": "756750110",
            "speakerId": 1005,
            "speakerName": "努斯妲",
            "text": "真是麻烦你了，玛因。我的本意是让新人们多多锻炼，没想到他们还是不能独立完成那一组任务。",
            "nextDialogs": [
              "756750111"
            ]
          },
          "756750111": {
            "id": "756750111",
            "speakerId": 1005,
            "speakerName": "努斯妲",
            "text": "等我回去后，给他们狠狠加练！",
            "nextDialogs": [
              "756750112"
            ]
          },
          "756750112": {
            "id": "756750112",
            "speakerId": 1004,
            "speakerName": "玛因",
            "text": "不麻烦，他们也打得很漂亮。只不过之前没想到，巢穴里有预估七倍的魔物罢了。",
            "nextDialogs": [
              "756750113"
            ]
          },
          "756750113": {
            "id": "756750113",
            "speakerId": 1004,
            "speakerName": "玛因",
            "text": "「花羽会」给的好多，我为爱贝尔买礼物的钱都凑够了。",
            "nextDialogs": [
              "756750114"
            ]
          },
          "756750114": {
            "id": "756750114",
            "speakerId": 1000,
            "speakerName": "昂吉安妮",
            "text": "但你的假期时间好像也差不多了？",
            "nextDialogs": [
              "756750115"
            ]
          },
          "756750115": {
            "id": "756750115",
            "speakerId": 1000,
            "speakerName": "昂吉安妮",
            "text": "再玩几天，就可以预订船票琢磨返程的事。",
            "nextDialogs": [
              "756750116"
            ]
          },
          "756750116": {
            "id": "756750116",
            "speakerId": 1004,
            "speakerName": "玛因",
            "text": "不急，还可以跳舞。小萝克珊、勒泰利埃，谢妮和弗雷瑞斯最近在争着任务做，我可不能和他们抢。",
            "nextDialogs": [
              "756750117"
            ]
          },
          "756750117": {
            "id": "756750117",
            "speakerId": 1001,
            "speakerName": "瑟琪",
            "text": "那就继续跳舞，继续开心。",
            "nextDialogs": [
              "756750118"
            ]
          },
          "756750118": {
            "id": "756750118",
            "speakerId": 1002,
            "speakerName": "梅内娅",
            "text": "跳累就吃，吃饱就睡，无忧无虑！",
            "nextDialogs": [
              "756750119"
            ]
          },
          "756750119": {
            "id": "756750119",
            "speakerId": 1003,
            "speakerName": "莫乌",
            "text": "咿啊——",
            "nextDialogs": [
              "756750120"
            ]
          },
          "756750120": {
            "id": "756750120",
            "speakerId": 1006,
            "speakerName": "Black Screen",
            "text": "美露莘们和小鳍游龙排成一列，向着舞台蹦蹦跳跳过去了。",
            "nextDialogs": [
              "756750121"
            ]
          },
          "756750121": {
            "id": "756750121",
            "speakerId": 1005,
            "speakerName": "努斯妲",
            "text": "真是一群可爱的客人…",
            "nextDialogs": [
              "756750122"
            ]
          },
          "756750122": {
            "id": "756750122",
            "speakerId": 1007,
            "speakerName": "派蒙",
            "text": "嘿嘿，你也很享受嘛，努斯妲。",
            "nextDialogs": [
              "756750125"
            ]
          },
          "756750125": {
            "id": "756750125",
            "speakerId": 1005,
            "speakerName": "努斯妲",
            "text": "当真？那以后，每次「舞力聚会」，我都非来不可。",
            "nextDialogs": [
              "756750126"
            ]
          },
          "756750126": {
            "id": "756750126",
            "speakerId": 1005,
            "speakerName": "努斯妲",
            "text": "要让那些见面就喊我大姐，甚至是阿姨的后辈…有一天发现，我的精神面貌比他们都年轻。",
            "nextDialogs": [
              "756750127"
            ]
          },
          "756750127": {
            "id": "756750127",
            "speakerId": 1005,
            "speakerName": "努斯妲",
            "text": "以后的「舞力聚会」应该以这次为典范，办得越频繁越好！成为每个月都有的惯例，都在情理之中！"
          }
        }
      }
    },
    {

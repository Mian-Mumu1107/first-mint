    {
      "subId": "2502803",
      "subQuestName": "(test)(hide)唱片破坏后完成$HIDDEN",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "250280301"
        ],
        "dialogs": {
          "250280301": {
            "id": "250280301",
            "speakerId": 1004,
            "speakerName": "派蒙",
            "text": "啊…箱子好像被打坏了…上面的唱片也…",
            "nextDialogs": [
              "250280302"
            ]
          },
          "250280302": {
            "id": "250280302",
            "speakerId": 1001,
            "speakerName": "冷静的部族成员",
            "text": "应该是那家伙把我们往那边引的。唉，他到底是从哪学的这一身毛病。",
            "nextDialogs": [
              "250280303"
            ]
          },
          "250280303": {
            "id": "250280303",
            "speakerId": 1001,
            "speakerName": "冷静的部族成员",
            "text": "你们是被米卢·努伊先生拜托来取唱片的吧？我之前看见你们在和他谈话，能猜出你们的来意。",
            "nextDialogs": [
              "250280304"
            ]
          },
          "250280304": {
            "id": "250280304",
            "speakerId": 1001,
            "speakerName": "冷静的部族成员",
            "text": "我们都是「流泉之众」的人。那家伙…之前还算是好人，最近不知道从哪学来了一身坏毛病。",
            "nextDialogs": [
              "250280305"
            ]
          },
          "250280305": {
            "id": "250280305",
            "speakerId": 1001,
            "speakerName": "冷静的部族成员",
            "text": "抱歉，忘了自我介绍。我是利洛，再次替我的…同伴，向您道歉。",
            "nextDialogs": [
              "250280306"
            ]
          },
          "250280306": {
            "id": "250280306",
            "speakerId": 1003,
            "speakerName": "利洛",
            "text": "…这谈话场面实在不太讲究。如果是在部族里的话，我至少能请您喝上一杯水。",
            "nextDialogs": [
              "250280308",
              "250280310"
            ]
          },
          "250280308": {
            "id": "250280308",
            "speakerId": 1003,
            "speakerName": "利洛",
            "text": "是吗？看您的模样，和刚才的身手，确实也像是一位经验丰富的冒险家。",
            "nextDialogs": [
              "250280313"
            ]
          },
          "250280313": {
            "id": "250280313",
            "speakerId": 1003,
            "speakerName": "利洛",
            "text": "…咳。先不说这些，我们先收拾一下周围吧。我会把唱片碎片搜集好的。",
            "nextDialogs": [
              "250280314"
            ]
          },
          "250280314": {
            "id": "250280314",
            "speakerId": 1003,
            "speakerName": "利洛",
            "text": "我和你们一起去见米卢·努伊先生。必须要向他当面道歉才行。"
          },
          "250280310": {
            "id": "250280310",
            "speakerId": 1003,
            "speakerName": "利洛",
            "text": "是的。我曾经被一位璃月的先生雇佣，陪着他一起进山去探查矿脉。",
            "nextDialogs": [
              "250280311"
            ]
          },
          "250280311": {
            "id": "250280311",
            "speakerId": 1003,
            "speakerName": "利洛",
            "text": "在和他一起工作的那段时间里，我受益良多。他在离开纳塔时，还送给我了一个璃月的名字，「逸扬」。",
            "nextDialogs": [
              "250280312"
            ]
          },
          "250280312": {
            "id": "250280312",
            "speakerId": 1003,
            "speakerName": "利洛",
            "text": "据他说，这是代表着「在空中飘逸飞扬」的意思。呃…虽然我是不太明白…"
          }
        }
      }
    },

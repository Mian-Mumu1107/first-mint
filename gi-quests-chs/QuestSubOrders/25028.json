    {
      "subId": "2502806",
      "subQuestName": "向米卢·努伊回报",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "250280501"
        ],
        "dialogs": {
          "250280501": {
            "id": "250280501",
            "speakerId": 1002,
            "speakerName": "米卢·努伊",
            "text": "我的唱片！太好了，这些唱片没有损坏…",
            "nextDialogs": [
              "250280502"
            ]
          },
          "250280502": {
            "id": "250280502",
            "speakerId": 1003,
            "speakerName": "利洛",
            "text": "非常抱歉。米卢·努伊先生，我的同伴抢走了您的唱片，我替他向您道歉。",
            "nextDialogs": [
              "250280503"
            ]
          },
          "250280503": {
            "id": "250280503",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "唱片没事就好。",
            "nextDialogs": [
              "250280504"
            ]
          },
          "250280504": {
            "id": "250280504",
            "speakerId": 1002,
            "speakerName": "米卢·努伊",
            "text": "呼。你说得没错，这可是原型唱片，要是损坏的话，我非去跳崖不可。",
            "nextDialogs": [
              "250280505"
            ]
          },
          "250280505": {
            "id": "250280505",
            "speakerId": 1002,
            "speakerName": "米卢·努伊",
            "text": "…这位叫利洛的老兄，你也别垂着头了。既然唱片没事，我也不会太计较这件事。",
            "nextDialogs": [
              "250280506"
            ]
          },
          "250280506": {
            "id": "250280506",
            "speakerId": 1002,
            "speakerName": "米卢·努伊",
            "text": "你只需要回答我一个问题。今天的事，就可以一笔勾销。",
            "nextDialogs": [
              "250280507"
            ]
          },
          "250280507": {
            "id": "250280507",
            "speakerId": 1003,
            "speakerName": "利洛",
            "text": "请您说吧，我一定会尽力回答。",
            "nextDialogs": [
              "250280508"
            ]
          },
          "250280508": {
            "id": "250280508",
            "speakerId": 1002,
            "speakerName": "米卢·努伊",
            "text": "你们在听我的唱片时，觉得它好听吗？",
            "nextDialogs": [
              "250280509"
            ]
          },
          "250280509": {
            "id": "250280509",
            "speakerId": 1002,
            "speakerName": "米卢·努伊",
            "text": "不是那种会吸引孩子和龙宝宝们的「好听」，而是那种…有流行感的「好听」！",
            "nextDialogs": [
              "250280510"
            ]
          },
          "250280510": {
            "id": "250280510",
            "speakerId": 1002,
            "speakerName": "米卢·努伊",
            "text": "你明白吗？在你们听这个唱片时，有这种感觉吗！",
            "nextDialogs": [
              "250280511"
            ]
          },
          "250280511": {
            "id": "250280511",
            "speakerId": 1003,
            "speakerName": "利洛",
            "text": "流行感？那个…您稍微等一会…",
            "nextDialogs": [
              "250280512"
            ]
          },
          "250280512": {
            "id": "250280512",
            "speakerId": 1002,
            "speakerName": "米卢·努伊",
            "text": "你们之所以派龙宝宝来抢走唱片，就是因为喜欢里面的流行感，对不对！",
            "nextDialogs": [
              "250280513"
            ]
          },
          "250280513": {
            "id": "250280513",
            "speakerId": 1003,
            "speakerName": "利洛",
            "text": "那个，您听我解释…",
            "nextDialogs": [
              "250280514"
            ]
          },
          "250280514": {
            "id": "250280514",
            "speakerId": 1003,
            "speakerName": "利洛",
            "text": "我们…从来没有「指使」过龙宝宝们去拿您的唱片…",
            "nextDialogs": [
              "250280515"
            ]
          },
          "250280515": {
            "id": "250280515",
            "speakerId": 1003,
            "speakerName": "利洛",
            "text": "是它们，被您唱片里的歌曲吸引，才自己跑了过去…",
            "nextDialogs": [
              "250280516"
            ]
          },
          "250280516": {
            "id": "250280516",
            "speakerId": 1002,
            "speakerName": "米卢·努伊",
            "text": "什么？",
            "nextDialogs": [
              "250280517"
            ]
          },
          "250280517": {
            "id": "250280517",
            "speakerId": 1003,
            "speakerName": "利洛",
            "text": "您的歌曲非常优秀啊！相信我，每次我放您的唱片时，龙宝宝们都围着我们疯跑，开心的要命！",
            "nextDialogs": [
              "250280518"
            ]
          },
          "250280518": {
            "id": "250280518",
            "speakerId": 1002,
            "speakerName": "米卢·努伊",
            "text": "什么？可恶…我的唱片…",
            "nextDialogs": [
              "250280519"
            ]
          },
          "250280519": {
            "id": "250280519",
            "speakerId": 1003,
            "speakerName": "利洛",
            "text": "我明白您的心情。如此珍贵的唱片居然会遭到威胁…",
            "nextDialogs": [
              "250280520"
            ]
          },
          "250280520": {
            "id": "250280520",
            "speakerId": 1003,
            "speakerName": "利洛",
            "text": "但我愿意做您的无偿护卫，直到您做出一张新唱片为止！有我在，没人能再抢走您的唱片了！",
            "nextDialogs": [
              "250280521"
            ]
          },
          "250280521": {
            "id": "250280521",
            "speakerId": 1002,
            "speakerName": "米卢·努伊",
            "text": "我的唱片！不是这种儿歌啊！"
          }
        }
      }
    },

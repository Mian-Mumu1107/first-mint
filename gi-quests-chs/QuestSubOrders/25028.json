    {
      "subId": "2502810",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "250281001"
        ],
        "dialogs": {
          "250281001": {
            "id": "250281001",
            "speakerId": 1002,
            "speakerName": "米卢·努伊",
            "text": "「流行感」到底是什么呢？哎哟，真难想…"
          }
        }
      }
    },
    {
      "subId": "2502812",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "250281201"
        ],
        "dialogs": {
          "250281201": {
            "id": "250281201",
            "speakerId": 1002,
            "speakerName": "米卢·努伊",
            "text": "很好！二位战斗的英姿真是让人印象深刻！",
            "nextDialogs": [
              "250281202"
            ]
          },
          "250281202": {
            "id": "250281202",
            "speakerId": 1002,
            "speakerName": "米卢·努伊",
            "text": "不仅很有力，而且非常有节奏，简直就像是拿着指挥棒在指挥这场战斗啊！但是…",
            "nextDialogs": [
              "250281203"
            ]
          },
          "250281203": {
            "id": "250281203",
            "speakerId": 1002,
            "speakerName": "米卢·努伊",
            "text": "…那些碎成不知道多少片的唱片。实在是这场演奏中的，不和谐音符。",
            "nextDialogs": [
              "250281204"
            ]
          },
          "250281204": {
            "id": "250281204",
            "speakerId": 1002,
            "speakerName": "米卢·努伊",
            "text": "愿大灵保佑我那些倒霉的朋友们…无论如何，我至少能把一部分唱片带回去给他们了。",
            "nextDialogs": [
              "250281205"
            ]
          },
          "250281205": {
            "id": "250281205",
            "speakerId": 1002,
            "speakerName": "米卢·努伊",
            "text": "这些东西给您，请您收下吧！利洛老兄，我们回部族去吧。",
            "nextDialogs": [
              "250281206"
            ]
          },
          "250281206": {
            "id": "250281206",
            "speakerId": 1002,
            "speakerName": "米卢·努伊",
            "text": "希望我的好朋友们不会晕倒。唉…"
          }
        }
      }
    },
    {
      "subId": "2502813",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "250281301"
        ],
        "dialogs": {
          "250281301": {
            "id": "250281301",
            "speakerId": 1002,
            "speakerName": "米卢·努伊",
            "text": "好，利洛老兄。咱们今天的目标就是那群家伙了，做好准备！",
            "nextDialogs": [
              "250281302"
            ]
          },
          "250281302": {
            "id": "250281302",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "你们还在取材啊…",
            "nextDialogs": [
              "250281303"
            ]
          },
          "250281303": {
            "id": "250281303",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "唱片做得怎么样了？",
            "nextDialogs": [
              "250281304"
            ]
          },
          "250281304": {
            "id": "250281304",
            "speakerId": 1002,
            "speakerName": "米卢·努伊",
            "text": "#这不是{NICKNAME}吗？托您和利洛老兄，还有我那几位音乐人朋友的福，我的新唱片马上就要做好了。",
            "nextDialogs": [
              "250281305"
            ]
          },
          "250281305": {
            "id": "250281305",
            "speakerId": 1002,
            "speakerName": "米卢·努伊",
            "text": "这份唱片里，融合了战斗声、呐喊声，还有各种来自大自然的声音…绝对是一份独一无二的唱片！",
            "nextDialogs": [
              "250281306"
            ]
          },
          "250281306": {
            "id": "250281306",
            "speakerId": 1002,
            "speakerName": "米卢·努伊",
            "text": "而且在取材过程中，我们还顺便帮各位音乐人朋友们取回了许多被「借」走不还的唱片。",
            "nextDialogs": [
              "250281307"
            ]
          },
          "250281307": {
            "id": "250281307",
            "speakerId": 1002,
            "speakerName": "米卢·努伊",
            "text": "总而言之，一切顺利。所有事情都在朝着好的方向发展。",
            "nextDialogs": [
              "250281308"
            ]
          },
          "250281308": {
            "id": "250281308",
            "speakerId": 1002,
            "speakerName": "米卢·努伊",
            "text": "#对了，我们正打算去取回另外一张被「借」走不还的唱片。{NICKNAME}，如果你愿意的话，能再帮我们一把吗？",
            "nextDialogs": [
              "250281310",
              "250281312"
            ]
          },
          "250281310": {
            "id": "250281310",
            "speakerId": 1002,
            "speakerName": "米卢·努伊",
            "text": "感谢您！等我把唱片制作完了，一定要把您的名字署在第一位！",
            "nextDialogs": [
              "250281313"
            ]
          },
          "250281313": {
            "id": "250281313",
            "speakerId": 1002,
            "speakerName": "米卢·努伊",
            "text": "利洛老兄嘛…就署在第二位吧。",
            "nextDialogs": [
              "250281314"
            ]
          },
          "250281314": {
            "id": "250281314",
            "speakerId": 1003,
            "speakerName": "利洛",
            "text": "#我的荣幸。那我们就出发吧，{NICKNAME}。"
          },
          "250281312": {
            "id": "250281312",
            "speakerId": 1002,
            "speakerName": "米卢·努伊",
            "text": "那当然！您绝对是我最重要的帮手。等我把唱片制作完了，一定要把您的名字署在第一位！"
          }
        }
      }
    },
    {
      "subId": "2502899",

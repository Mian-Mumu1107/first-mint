      }
    },
    {
      "subId": "2502804",
      "subQuestName": "向米卢·努伊回报",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "250280401"
        ],
        "dialogs": {
          "250280401": {
            "id": "250280401",
            "speakerId": 1002,
            "speakerName": "米卢·努伊",
            "text": "很好！二位战斗的英姿真是让人印象深刻！",
            "nextDialogs": [
              "250280402"
            ]
          },
          "250280402": {
            "id": "250280402",
            "speakerId": 1002,
            "speakerName": "米卢·努伊",
            "text": "不仅很有力，而且非常有节奏，简直就像是拿着指挥棒在指挥这场战斗啊。",
            "nextDialogs": [
              "250280403"
            ]
          },
          "250280403": {
            "id": "250280403",
            "speakerId": 1002,
            "speakerName": "米卢·努伊",
            "text": "最重要的是…唱片也非常完整！感谢您，我的那些朋友们总算能睡个好觉了。",
            "nextDialogs": [
              "250280404"
            ]
          },
          "250280404": {
            "id": "250280404",
            "speakerId": 1002,
            "speakerName": "米卢·努伊",
            "text": "咦，等等…节奏？没错，我要找的就是这种节奏感！",
            "nextDialogs": [
              "250280405"
            ]
          },
          "250280405": {
            "id": "250280405",
            "speakerId": 1002,
            "speakerName": "米卢·努伊",
            "text": "用这种节奏作为基础旋律…不对，要选用声音更沉的乐器…",
            "nextDialogs": [
              "250280406"
            ]
          },
          "250280406": {
            "id": "250280406",
            "speakerId": 1002,
            "speakerName": "米卢·努伊",
            "text": "这些东西给您，请您收下吧！利洛老兄，我们快回部族去，我有灵感了！",
            "nextDialogs": [
              "250280407"
            ]
          },
          "250280407": {
            "id": "250280407",
            "speakerId": 1002,
            "speakerName": "米卢·努伊",
            "text": "见鬼，我得把那些节奏记下来…对了，衣服，我要把它们记在衣服上！"
          }
        }
      }
    },
    {
      "subId": "2502801",
      "subQuestName": "与米卢·努伊对话",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "250280101"
        ],
        "dialogs": {
          "250280101": {
            "id": "250280101",
            "speakerId": 1002,
            "speakerName": "米卢·努伊",
            "text": "完了，完了！我的流行大作…要被吃光了…",
            "nextDialogs": [
              "250280102"
            ]
          },
          "250280102": {
            "id": "250280102",
            "speakerId": 1002,
            "speakerName": "米卢·努伊",
            "text": "早知道这样，我还不如让帕卡把它放在儿童歌曲区…",
            "nextDialogs": [
              "250280103"
            ]
          },
          "250280103": {
            "id": "250280103",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "发生什么了？",
            "nextDialogs": [
              "250280104"
            ]
          },
          "250280104": {
            "id": "250280104",
            "speakerId": 1002,
            "speakerName": "米卢·努伊",
            "text": "#你是…等等，{NICKNAME}！太好了，你来了！",
            "nextDialogs": [
              "250280105"
            ]
          },
          "250280105": {
            "id": "250280105",
            "speakerId": 1002,
            "speakerName": "米卢·努伊",
            "text": "我有重要的事情要委托给你！纳塔的…不对，世界流行音乐的未来！就等着你去拯救了！",
            "nextDialogs": [
              "250280109",
              "250280108"
            ]
          },
          "250280109": {
            "id": "250280109",
            "speakerId": 1002,
            "speakerName": "米卢·努伊",
            "text": "请您快点去拯救我的唱片！不然他们就要被那群小鳍游龙吃掉…或者被那些不懂音乐的家伙毁掉了！"
          },
          "250280108": {
            "id": "250280108",
            "speakerId": 1002,
            "speakerName": "米卢·努伊",
            "text": "呃…那个…我很高兴您有这种特长，之后我们也许可以合作…但现在…"
          }
        }
      }
    },
    {
      "subId": "2502810",

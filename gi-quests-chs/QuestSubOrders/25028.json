  },
  "subQuests": [
    {
      "subId": "2502811",
      "subQuestName": "与米卢·努伊对话",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "250281101"
        ],
        "dialogs": {
          "250281101": {
            "id": "250281101",
            "speakerId": 1000,
            "speakerName": "不耐烦的部族成员",
            "text": "啧，这个唱片听起来也没什么意思，没什么流行元素。",
            "nextDialogs": [
              "250281102"
            ]
          },
          "250281102": {
            "id": "250281102",
            "speakerId": 1001,
            "speakerName": "冷静的部族成员",
            "text": "擅自把人家的唱片拿过来，这样不对。快点还回去吧。",
            "nextDialogs": [
              "250281103"
            ]
          },
          "250281103": {
            "id": "250281103",
            "speakerId": 1000,
            "speakerName": "不耐烦的部族成员",
            "text": "我说你啊，跟着那个璃月人工作了一段时间之后，就变得婆婆妈妈的。",
            "nextDialogs": [
              "250281104"
            ]
          },
          "250281104": {
            "id": "250281104",
            "speakerId": 1000,
            "speakerName": "不耐烦的部族成员",
            "text": "再说了，这种唱片本来就卖得不好，我这不是在帮他拓展销量吗？",
            "nextDialogs": [
              "250281105"
            ]
          },
          "250281105": {
            "id": "250281105",
            "speakerId": 1000,
            "speakerName": "不耐烦的部族成员",
            "text": "哈哈哈哈，你瞧，龙宝宝们也很喜欢这唱片的味道。",
            "nextDialogs": [
              "250281106"
            ]
          },
          "250281106": {
            "id": "250281106",
            "speakerId": 1001,
            "speakerName": "冷静的部族成员",
            "text": "够了。把唱片给我，我会亲自还回去。",
            "nextDialogs": [
              "250281107"
            ]
          },
          "250281107": {
            "id": "250281107",
            "speakerId": 1000,
            "speakerName": "不耐烦的部族成员",
            "text": "…你有完没完。怎么？想试试拳头了？",
            "nextDialogs": [
              "250281108"
            ]
          },
          "250281108": {
            "id": "250281108",
            "speakerId": 1000,
            "speakerName": "不耐烦的部族成员",
            "text": "好啊，我正愁最近没东西练手，想舒展一下筋骨呢！"
          }
        }
      }
    },
    {
      "subId": "2502807",
      "subQuestName": "与米卢·努伊对话",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "250280201"
        ],
        "dialogs": {
          "250280201": {
            "id": "250280201",
            "speakerId": 1002,
            "speakerName": "米卢·努伊",
            "text": "好，利洛老兄。咱们今天的目标就是那群家伙了，做好准备！",
            "nextDialogs": [
              "250280202"
            ]
          },
          "250280202": {
            "id": "250280202",
            "speakerId": 1003,
            "speakerName": "利洛",
            "text": "没问题，都准备好了。",
            "nextDialogs": [
              "250280205"
            ]
          },
          "250280205": {
            "id": "250280205",
            "speakerId": 1002,
            "speakerName": "米卢·努伊",
            "text": "您好啊，居然能在这里见到您。没错，咱们正在为新的歌曲取材呢。",
            "nextDialogs": [
              "250280206"
            ]
          },
          "250280206": {
            "id": "250280206",
            "speakerId": 1002,
            "speakerName": "米卢·努伊",
            "text": "上次的事情之后，我和利洛老兄仔细谈了谈有关唱片的问题，收获了不少新的灵感。",
            "nextDialogs": [
              "250280207"
            ]
          },
          "250280207": {
            "id": "250280207",
            "speakerId": 1003,
            "speakerName": "利洛",
            "text": "您说得太夸张了。我只是建议米卢·努伊先生换一个方法，或者是找其他素材来制作音乐。",
            "nextDialogs": [
              "250280208"
            ]
          },
          "250280208": {
            "id": "250280208",
            "speakerId": 1003,
            "speakerName": "利洛",
            "text": "我之前在部族中所听到的音乐，有些甚至把武器的碰撞声、战斗的呐喊声、人奔跑的脚步声加进了歌曲之中。",
            "nextDialogs": [
              "250280209"
            ]
          },
          "250280209": {
            "id": "250280209",
            "speakerId": 1003,
            "speakerName": "利洛",
            "text": "这样子做出的歌曲很受欢迎，传播的速度也很快…我想，也许这就是米卢·努伊先生想要的「流行感」。",
            "nextDialogs": [
              "250280210"
            ]
          },
          "250280210": {
            "id": "250280210",
            "speakerId": 1002,
            "speakerName": "米卢·努伊",
            "text": "没错！所以我们一直在寻找战士，想要瞧瞧他们是如何战斗的。",
            "nextDialogs": [
              "250280211"
            ]
          },
          "250280211": {
            "id": "250280211",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "那你们找到取材对象了吗？",
            "nextDialogs": [
              "250280212"
            ]
          },
          "250280212": {
            "id": "250280212",
            "speakerId": 1002,
            "speakerName": "米卢·努伊",
            "text": "找到了！就是前面那几位。我们在部族里打听到，这群人一直在外面寻找对手，实力也很强…",
            "nextDialogs": [
              "250280213"
            ]
          },
          "250280213": {
            "id": "250280213",
            "speakerId": 1003,
            "speakerName": "利洛",
            "text": "咳。简单来说，这群人成天在外面惹事，遇见人就上去问「要不要切磋」。",
            "nextDialogs": [
              "250280214"
            ]
          },
          "250280214": {
            "id": "250280214",
            "speakerId": 1002,
            "speakerName": "米卢·努伊",
            "text": "只要输给了他们，还会被逼着拿出东西作为输掉的赌注。",
            "nextDialogs": [
              "250280215"
            ]
          },
          "250280215": {
            "id": "250280215",
            "speakerId": 1002,
            "speakerName": "米卢·努伊",
            "text": "我也有好几位音乐家朋友被他们劫掠…真是不可原谅！",
            "nextDialogs": [
              "250280216"
            ]
          },
          "250280216": {
            "id": "250280216",
            "speakerId": 1003,
            "speakerName": "利洛",
            "text": "没错，部族里的人也快受不了了。想要找人去教训一下他们。",
            "nextDialogs": [
              "250280217"
            ]
          },
          "250280217": {
            "id": "250280217",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "听着不像是什么正常人…",
            "nextDialogs": [
              "250280218"
            ]
          },
          "250280218": {
            "id": "250280218",
            "speakerId": 1002,
            "speakerName": "米卢·努伊",
            "text": "谁知道他们怎么想的？说真的，我从来都不理解这种人的想法。",
            "nextDialogs": [
              "250280219"
            ]
          },
          "250280219": {
            "id": "250280219",
            "speakerId": 1002,
            "speakerName": "米卢·努伊",
            "text": "要是您愿意的话，就和利洛老兄一起去教训他们吧。",
            "nextDialogs": [
              "250280220"
            ]
          },
          "250280220": {
            "id": "250280220",
            "speakerId": 1002,
            "speakerName": "米卢·努伊",
            "text": "您的身手我早有见识。如果能看见您施展拳脚，我肯定能找到更多，更好的灵感！",
            "nextDialogs": [
              "250280221"
            ]
          },
          "250280221": {
            "id": "250280221",
            "speakerId": 1002,
            "speakerName": "米卢·努伊",
            "text": "但…我请您注意！如果那群家伙手里有唱片的话，您可千万别弄坏了！",
            "nextDialogs": [
              "250280222"
            ]
          },
          "250280222": {
            "id": "250280222",
            "speakerId": 1002,
            "speakerName": "米卢·努伊",
            "text": "不然我那些音乐家朋友，一定会再晕过去一次…"
          }
        }
      }
    },
    {
      "subId": "2502808",
      "subQuestName": "教训那些惹事生非的部族成员",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "250280801"
        ],
        "dialogs": {
          "250280801": {
            "id": "250280801",
            "speakerId": 1002,
            "speakerName": "米卢·努伊",
            "text": "您把我的唱片拿回来了吗？",
            "nextDialogs": [
              "250280802"
            ]
          },
          "250280802": {
            "id": "250280802",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "你的唱片为什么会被它们抢走？",
            "nextDialogs": [
              "250280803"
            ]
          },
          "250280803": {
            "id": "250280803",
            "speakerId": 1002,
            "speakerName": "米卢·努伊",
            "text": "这个，说来话长…我本来刚刚做出一首全新的歌曲。主题是歌颂春天和动物之类的…",
            "nextDialogs": [
              "250280804"
            ]
          },
          "250280804": {
            "id": "250280804",
            "speakerId": 1002,
            "speakerName": "米卢·努伊",
            "text": "结果帕卡那小子听完之后，伸手就把我的歌又放到了儿童区！",
            "nextDialogs": [
              "250280805"
            ]
          },
          "250280805": {
            "id": "250280805",
            "speakerId": 1002,
            "speakerName": "米卢·努伊",
            "text": "还说什么，这种有趣又简洁的曲调，孩子们和龙宝宝们一定会喜欢的…",
            "nextDialogs": [
              "250280806"
            ]
          },
          "250280806": {
            "id": "250280806",
            "speakerId": 1002,
            "speakerName": "米卢·努伊",
            "text": "可恶！我做的可是正经的流行乐，不是什么儿童歌曲！",
            "nextDialogs": [
              "250280807"
            ]
          },
          "250280807": {
            "id": "250280807",
            "speakerId": 1002,
            "speakerName": "米卢·努伊",
            "text": "我气不过，就带着唱片来这里，想要自己享受一下自己做的音乐。",
            "nextDialogs": [
              "250280808"
            ]
          },
          "250280808": {
            "id": "250280808",
            "speakerId": 1002,
            "speakerName": "米卢·努伊",
            "text": "结果…听着听着，一群小鳍游龙就聚集了过来。",
            "nextDialogs": [
              "250280809"
            ]
          },
          "250280809": {
            "id": "250280809",
            "speakerId": 1002,
            "speakerName": "米卢·努伊",
            "text": "还没等我反应过来，它们就一下子窜了过去，一口咬起唱片跑掉了！",
            "nextDialogs": [
              "250280810"
            ]
          },
          "250280810": {
            "id": "250280810",
            "speakerId": 1002,
            "speakerName": "米卢·努伊",
            "text": "我本来想要追着它们过去。但追到一半，却发现有一群看起来很暴躁的人聚在一起…",
            "nextDialogs": [
              "250280811"
            ]
          },
          "250280811": {
            "id": "250280811",
            "speakerId": 1002,
            "speakerName": "米卢·努伊",
            "text": "说不定，就是这群家伙指使小鳍游龙抢走了我的唱片，他们一定在觊觎我的音乐！",
            "nextDialogs": [
              "250280812"
            ]
          },
          "250280812": {
            "id": "250280812",
            "speakerId": 1002,
            "speakerName": "米卢·努伊",
            "text": "啊啊啊——不能再说了！冒险家，算我米卢·努伊求求你了，快去把我的唱片拿回来吧！",
            "nextDialogs": [
              "250280813"
            ]
          },
          "250280813": {
            "id": "250280813",
            "speakerId": 1002,
            "speakerName": "米卢·努伊",
            "text": "如，如果可以的话…还请您尽量让我的唱片保持完整。不然，我这些天的努力…全都白费了…"
          }
        }
      }
    },
    {
      "subId": "2502809",
      "subQuestName": "(test)(hide)唱片破坏后完成$HIDDEN",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [],

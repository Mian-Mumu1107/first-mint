    {
      "subId": "801712",
      "subQuestName": "与蒂莱尔对话",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "80170901"
        ],
        "dialogs": {
          "80170901": {
            "id": "80170901",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "（——！！！）",
            "nextDialogs": [
              "80170902"
            ]
          },
          "80170902": {
            "id": "80170902",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "（刚刚的梦…）",
            "nextDialogs": [
              "80170903"
            ]
          },
          "80170903": {
            "id": "80170903",
            "speakerId": 15204,
            "speakerName": "蒂莱尔",
            "text": "啊…你醒了，那、那个，不好意思，我刚刚不是故意…",
            "nextDialogs": [
              "80170904"
            ]
          },
          "80170904": {
            "id": "80170904",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "（蒂莱尔刚刚拉了我的手？）",
            "nextDialogs": [
              "80170905"
            ]
          },
          "80170905": {
            "id": "80170905",
            "speakerId": 15204,
            "speakerName": "蒂莱尔",
            "text": "我只是发现你好像在做噩梦，很痛苦的样子…",
            "nextDialogs": [
              "80170906"
            ]
          },
          "80170906": {
            "id": "80170906",
            "speakerId": 15204,
            "speakerName": "蒂莱尔",
            "text": "所以我试着握住了你的手，以为能够安慰到你一些…我做噩梦的时候我的家人就是这么做的！",
            "nextDialogs": [
              "80170907"
            ]
          },
          "80170907": {
            "id": "80170907",
            "speakerId": 15204,
            "speakerName": "蒂莱尔",
            "text": "但是，好像在你身上没什么效果，甚至可能起了反效果…真是太不好意思了…",
            "nextDialogs": [
              "80170908"
            ]
          },
          "80170908": {
            "id": "80170908",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "哦？是嘛…",
            "nextDialogs": [
              "80170909"
            ]
          },
          "80170909": {
            "id": "80170909",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "#你该不会是想对{NICKNAME}图谋不轨吧？",
            "nextDialogs": [
              "80170910"
            ]
          },
          "80170910": {
            "id": "80170910",
            "speakerId": 15204,
            "speakerName": "蒂莱尔",
            "text": "我！我…可是很理智的！",
            "nextDialogs": [
              "80170911"
            ]
          },
          "80170911": {
            "id": "80170911",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "这和理智有什么关系？",
            "nextDialogs": [
              "80170912"
            ]
          },
          "80170912": {
            "id": "80170912",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "（不行，还是回忆不起来…刚刚梦到了什么来着？）",
            "nextDialogs": [
              "80170913"
            ]
          },
          "80170913": {
            "id": "80170913",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "#（好像一开始看到了{M#荧}{F#哥哥}在夜神之国…可后面的部分就记不清了…）",
            "nextDialogs": [
              "80170914"
            ]
          },
          "80170914": {
            "id": "80170914",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "（算了，强迫自己回想也不是办法…）",
            "nextDialogs": [
              "80170917"
            ]
          },
          "80170917": {
            "id": "80170917",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "这么一番折腾，我都睡不着了！",
            "nextDialogs": [
              "80170918"
            ]
          },
          "80170918": {
            "id": "80170918",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "#{NICKNAME}先睡吧，后半夜我会看住这个小姑娘的！",
            "nextDialogs": [
              "80170919"
            ]
          },
          "80170919": {
            "id": "80170919",
            "speakerId": 15204,
            "speakerName": "蒂莱尔",
            "text": "唉…难道我真的表现得很可疑吗…",
            "nextDialogs": [
              "80170920"
            ]
          },
          "80170920": {
            "id": "80170920",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "这是三天份的饭哦，蒂莱尔，容易坏掉的先吃，能够放久一点的后吃…你应该分得清楚吧？",
            "nextDialogs": [
              "80170921"
            ]
          },
          "80170921": {
            "id": "80170921",
            "speakerId": 15204,
            "speakerName": "蒂莱尔",
            "text": "嗯，从食材上我还是可以辨别的，真的谢谢你们，我就不客气了。",
            "nextDialogs": [
              "80170922"
            ]
          },
          "80170922": {
            "id": "80170922",
            "speakerId": 15204,
            "speakerName": "蒂莱尔",
            "text": "三天的时间肯定足够我把伤养好了，到时候我就继续出发去找「救世主」。",
            "nextDialogs": [
              "80170923"
            ]
          },
          "80170923": {
            "id": "80170923",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "好的，那我们就走啦，再见蒂莱尔~！",
            "nextDialogs": [

  "subQuests": [
    {
      "subId": "801701",
      "subQuestName": "回到先前的山洞附近调查",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "80170101"
        ],
        "dialogs": {
          "80170101": {
            "id": "80170101",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "兜兜转转又回到了这里，那个丘丘人应该就是在这附近发现的钥匙吧。",
            "nextDialogs": [
              "80170102"
            ]
          },
          "80170102": {
            "id": "80170102",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "好好调查一下有没有其他线索吧，伊安珊她们还等着我们呢！",
            "nextDialogs": [
              "80170103"
            ]
          },
          "80170103": {
            "id": "80170103",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "唉…到处都没有什么痕迹，那个丘丘人究竟是怎么捡到钥匙的呀…",
            "nextDialogs": [
              "80170104"
            ]
          },
          "80170104": {
            "id": "80170104",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "#难道说真的只是你{M#妹妹}{F#哥哥}路过这里，然后钥匙不小心从口袋里掉出来了？",
            "nextDialogs": [
              "80170105"
            ]
          },
          "80170105": {
            "id": "80170105",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "这么重要的东西随随便便弄丢，总觉得有点滑稽…呃…也不好说，丢东西这种事谁也说不准。",
            "nextDialogs": [
              "80170106"
            ]
          },
          "80170106": {
            "id": "80170106",
            "speakerId": 10205,
            "speakerName": "？？？",
            "text": "太好了，这里有人…请帮帮我！",
            "nextDialogs": [
              "80170107"
            ]
          },
          "80170107": {
            "id": "80170107",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "欸！你是…你遇到什么事了吗？",
            "nextDialogs": [
              "80170108"
            ]
          },
          "80170108": {
            "id": "80170108",
            "speakerId": 10205,
            "speakerName": "？？？",
            "text": "啊…",
            "nextDialogs": [
              "80170109"
            ]
          },
          "80170109": {
            "id": "80170109",
            "speakerId": 10205,
            "speakerName": "？？？",
            "text": "啊，不对，不是在意这个的时候…",
            "nextDialogs": [
              "80170110"
            ]
          },
          "80170110": {
            "id": "80170110",
            "speakerId": 10205,
            "speakerName": "？？？",
            "text": "请救救我，那些魔物一直在追我，我实在跑不动了，你们能想想办法吗？",
            "nextDialogs": [
              "80170113"
            ]
          },
          "80170113": {
            "id": "80170113",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "对呀，你说的魔物在哪里？我怎么没看到有什么东西追你？",
            "nextDialogs": [
              "80170114"
            ]
          },
          "80170114": {
            "id": "80170114",
            "speakerId": 10205,
            "speakerName": "？？？",
            "text": "啊…？不好意思，我不太懂你们的意思…",
            "nextDialogs": [
              "80170115"
            ]
          },
          "80170115": {
            "id": "80170115",
            "speakerId": 10205,
            "speakerName": "？？？",
            "text": "魔物就在眼前了，现在应该不是开玩笑的时候吧？",
            "nextDialogs": [
              "80170116"
            ]
          },
          "80170116": {
            "id": "80170116",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "唔…我们真的不是在开玩笑，我们什么也没看到。",
            "nextDialogs": [
              "80170117"
            ]
          },
          "80170117": {
            "id": "80170117",
            "speakerId": 10205,
            "speakerName": "？？？",
            "text": "怎么会…算了，快和我一起跑吧，它们来了！"
          }
        }
      }
    },
    {
      "subId": "801702",
      "subQuestName": "解决出现的魔物",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "80170201"
        ],
        "dialogs": {
          "80170201": {
            "id": "80170201",
            "speakerId": 15267,
            "speakerName": "苏图拉",
            "text": "哦~！我们的英雄「杜麦{RUBY#[S]希望}尼」！之前有幸跟您并肩作战过，不知道您还有没有印象，哈哈…",
            "nextDialogs": [
              "80170203",
              "80170205"
            ]
          },
          "80170203": {
            "id": "80170203",
            "speakerId": 15267,
            "speakerName": "苏图拉",
            "text": "那我可太荣幸了，没错过这次的作战可真幸运。",
            "nextDialogs": [
              "80170206"
            ]
          },
          "80170206": {
            "id": "80170206",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "在这里站岗辛苦你啦。",
            "nextDialogs": [
              "80170207"
            ]
          },
          "80170207": {
            "id": "80170207",
            "speakerId": 15267,
            "speakerName": "苏图拉",
            "text": "没事没事，其实很清闲的，对面一直没什么动作。",
            "nextDialogs": [
              "80170208"
            ]
          },
          "80170208": {
            "id": "80170208",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "有发现什么异常吗？",
            "nextDialogs": [
              "80170209"
            ]
          },
          "80170209": {
            "id": "80170209",
            "speakerId": 15267,
            "speakerName": "苏图拉",
            "text": "和作战有关的异常目前没有，但我之前确实留意到，深渊教团的很多家伙不选择进攻，反而在附近游荡…",
            "nextDialogs": [
              "80170210"
            ]
          },
          "80170210": {
            "id": "80170210",
            "speakerId": 15267,
            "speakerName": "苏图拉",
            "text": "然后时不时做出些类似「冥想」的动作，可能是深渊教团的什么习俗吧。",
            "nextDialogs": [
              "80170211"
            ]
          },
          "80170211": {
            "id": "80170211",
            "speakerId": 15267,
            "speakerName": "苏图拉",
            "text": "出于谨慎考虑，我还叫来了部族里的萨满，让他们看看有没有什么玄机…",
            "nextDialogs": [
              "80170212"
            ]
          },
          "80170212": {
            "id": "80170212",
            "speakerId": 15267,
            "speakerName": "苏图拉",
            "text": "但大家都没看出来什么，可能只是单纯和信仰有关，我们也没再管了。",
            "nextDialogs": [
              "80170213"
            ]
          },
          "80170213": {
            "id": "80170213",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "这样啊…也挺好的，他们做自己的事总比要跟我们打架强。"
          },
          "80170205": {
            "id": "80170205",
            "speakerId": 15267,
            "speakerName": "苏图拉",
            "text": "哈哈很正常，您一直冲锋陷阵在最前面，您的背影一直在激励着我。"
          }
        }
      }
    },
    {
      "subId": "801703",
      "subQuestName": "与被魔物袭击的少女对话",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "80170301"
        ],
        "dialogs": {
          "80170301": {
            "id": "80170301",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "#啊？已经解决了吗？到底怎么回事呀{NICKNAME}，我怎么还是什么也看不到。",
            "nextDialogs": [
              "80170302"
            ]
          },
          "80170302": {
            "id": "80170302",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "感觉你好像在和空气打架，嗯…怪滑稽的。",
            "nextDialogs": [
              "80170305"
            ]
          },
          "80170305": {
            "id": "80170305",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "拉手？"
          }
        }
      }
    },
    {
      "subId": "801704",
      "subQuestName": "前往「烟谜主」",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "80170401"
        ],
        "dialogs": {
          "80170401": {
            "id": "80170401",
            "speakerId": 1091,
            "speakerName": "伊安珊",
            "text": "哟，你们回来啦。怎么样，有什么收获么？",
            "nextDialogs": [
              "80170402"
            ]
          },
          "80170402": {
            "id": "80170402",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "实质性的收获算是没有，倒是有些奇奇怪怪的经历…",
            "nextDialogs": [
              "80170403"
            ]
          },
          "80170403": {
            "id": "80170403",
            "speakerId": 1091,
            "speakerName": "伊安珊",
            "text": "那就是说还是没能抓到结束战争的契机咯？",
            "nextDialogs": [
              "80170406"
            ]
          },
          "80170406": {
            "id": "80170406",
            "speakerId": 1091,
            "speakerName": "伊安珊",
            "text": "没关系没关系，你们不在的这段时间，战争也基本处于「停滞」状态。",
            "nextDialogs": [
              "80170407"
            ]
          },
          "80170407": {
            "id": "80170407",
            "speakerId": 1091,
            "speakerName": "伊安珊",
            "text": "深渊教团没再进攻过，由于暂时不清楚对方意图，我们也没选择贸然出击…",
            "nextDialogs": [
              "80170408"
            ]
          },
          "80170408": {
            "id": "80170408",
            "speakerId": 1091,
            "speakerName": "伊安珊",
            "text": "暂时就这么对峙着，除了哨兵们辛苦了一点，其他好像什么事都没发生过。",
            "nextDialogs": [
              "80170409"
            ]
          },
          "80170409": {
            "id": "80170409",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "这样啊，真是搞不清楚深渊教团的家伙们。",
            "nextDialogs": [
              "80170410"
            ]
          },
          "80170410": {
            "id": "80170410",
            "speakerId": 1091,
            "speakerName": "伊安珊",
            "text": "#那么，{NICKNAME}…不知道你能不能代替我去慰问一下那些哨兵们。",
            "nextDialogs": [
              "80170411"
            ]
          },
          "80170411": {
            "id": "80170411",
            "speakerId": 1091,
            "speakerName": "伊安珊",
            "text": "一直轮班盯梢还是很辛苦的，如果是你这位风头正劲的大英雄来慰问的话，效果肯定比我要好。",
            "nextDialogs": [
              "80170412"
            ]
          },
          "80170412": {
            "id": "80170412",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "教练太谦虚啦，嘿嘿…"
          }
        }
      }
    },
    {
      "subId": "801709",
      "subQuestName": "与前线哨兵对话",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [],
        "dialogs": {}
      }
    },
    {
      "subId": "801710",
      "subQuestName": "与前线哨兵对话",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "80170701"
        ],
        "dialogs": {
          "80170701": {
            "id": "80170701",
            "speakerId": 15268,
            "speakerName": "坎塔鲁",
            "text": "…是…是英雄「杜麦{RUBY#[S]希望}尼」吗？您怎么来了…是来慰问的吗？",
            "nextDialogs": [
              "80170702"
            ]
          },
          "80170702": {
            "id": "80170702",
            "speakerId": 15268,
            "speakerName": "坎塔鲁",
            "text": "怎么…怎么办，好紧张…",
            "nextDialogs": [
              "80170703"
            ]
          },
          "80170703": {
            "id": "80170703",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "#上战场都不紧张，怎么见到{NICKNAME}紧张成这样呀？",
            "nextDialogs": [
              "80170704"
            ]
          },
          "80170704": {
            "id": "80170704",
            "speakerId": 15268,
            "speakerName": "坎塔鲁",
            "text": "这根本不是一回事…上战场的机会总会有，一对一跟大英雄对话的机会可不多！",
            "nextDialogs": [
              "80170705"
            ]
          },
          "80170705": {
            "id": "80170705",
            "speakerId": 15268,
            "speakerName": "坎塔鲁",
            "text": "怎么会不紧张呢，万一我说错话…或者站的姿势不正确，又或者我的表情管理不到位，给英雄留下不好的印象怎么办！",
            "nextDialogs": [
              "80170706"
            ]
          },
          "80170706": {
            "id": "80170706",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "谁会在乎你的站姿和表情呀！",
            "nextDialogs": [
              "80170707"
            ]
          },
          "80170707": {
            "id": "80170707",
            "speakerId": 15268,
            "speakerName": "坎塔鲁",
            "text": "唉…好、好吧…",
            "nextDialogs": [
              "80170708"
            ]
          },
          "80170708": {
            "id": "80170708",
            "speakerId": 15268,
            "speakerName": "坎塔鲁",
            "text": "那个，英雄大人，我有个小小的不情之请…",
            "nextDialogs": [
              "80170709"
            ]
          },
          "80170709": {
            "id": "80170709",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "是要签名吗，好说好说…",
            "nextDialogs": [
              "80170710"
            ]
          },
          "80170710": {
            "id": "80170710",
            "speakerId": 15268,
            "speakerName": "坎塔鲁",
            "text": "我可以跟您打一架吗？",
            "nextDialogs": [
              "80170711"
            ]
          },
          "80170711": {
            "id": "80170711",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "喂！你是怎么用这么怂的语气说出这么不客气的话的呀？之前的紧张都是装的吧！",
            "nextDialogs": [
              "80170712"
            ]
          },
          "80170712": {
            "id": "80170712",
            "speakerId": 15268,
            "speakerName": "坎塔鲁",
            "text": "没有没有，怎么会呢…我只是觉得如果现在不提这个要求的话，回去容易后悔一辈子…",
            "nextDialogs": [
              "80170713"
            ]
          },
          "80170713": {
            "id": "80170713",
            "speakerId": 15268,
            "speakerName": "坎塔鲁",
            "text": "不过我确实是在执勤任务的过程中，能不能麻烦派蒙大人帮我替个班…",
            "nextDialogs": [
              "80170714"
            ]
          },
          "80170714": {
            "id": "80170714",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "又用很怂的语气提出了很不合理的要求！",
            "nextDialogs": [
              "80170717"
            ]
          },
          "80170717": {
            "id": "80170717",
            "speakerId": 15268,
            "speakerName": "坎塔鲁",
            "text": "哦哦哦——！！！",
            "nextDialogs": [
              "80170718"
            ]
          },
          "80170718": {
            "id": "80170718",
            "speakerId": 15268,
            "speakerName": "坎塔鲁",
            "text": "虽然从没想过要取胜，但没想到差距这么大啊…",
            "nextDialogs": [
              "80170719"
            ]
          },
          "80170719": {
            "id": "80170719",
            "speakerId": 15268,
            "speakerName": "坎塔鲁",
            "text": "哈哈，和英雄「杜麦{RUBY#[S]希望}尼」交过手，是值得吹一辈子的经历了，今天真走运。",
            "nextDialogs": [
              "80170720"
            ]
          },
          "80170720": {
            "id": "80170720",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "怎么打完架，你的语气完全变了呀？",
            "nextDialogs": [
              "80170721"
            ]
          },
          "80170721": {
            "id": "80170721",
            "speakerId": 15268,
            "speakerName": "坎塔鲁",
            "text": "男人就是要用战斗来沟通，现在我已经觉得和英雄大人很熟了，当然不紧张了。",
            "nextDialogs": [
              "80170722"
            ]
          },
          "80170722": {
            "id": "80170722",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "唉…我倒是有点不想和你沟通了。",
            "nextDialogs": [
              "80170723"
            ]
          },
          "80170723": {
            "id": "80170723",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "附近有发现什么异常吗？",
            "nextDialogs": [
              "80170724"
            ]
          },
          "80170724": {
            "id": "80170724",
            "speakerId": 15268,
            "speakerName": "坎塔鲁",
            "text": "报告，没有异常，暂时没有发现深渊教团的战略动向。",
            "nextDialogs": [
              "80170725"
            ]
          },
          "80170725": {
            "id": "80170725",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "果然如此，这边也是一样呢。我们再转一圈就回去吧？"
          }
        }
      }
    },
    {
      "subId": "801705",
      "subQuestName": "与伊安珊对话",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "80170501"
        ],
        "dialogs": {
          "80170501": {
            "id": "80170501",
            "speakerId": 1091,
            "speakerName": "伊安珊",
            "text": "你们回来了，怎么样，哨兵们有报告些什么吗？",
            "nextDialogs": [
              "80170502"
            ]
          },
          "80170502": {
            "id": "80170502",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "应该说没什么重要的情报，有人提及一些深渊教团的家伙会在附近做些冥想什么的，但好像是无害的。",
            "nextDialogs": [
              "80170503"
            ]
          },
          "80170503": {
            "id": "80170503",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "另外就是…呃…好想打那个叫坎塔鲁的哨兵的小报告…",
            "nextDialogs": [
              "80170504"
            ]
          },
          "80170504": {
            "id": "80170504",
            "speakerId": 1091,
            "speakerName": "伊安珊",
            "text": "嗯？",
            "nextDialogs": [
              "80170507"
            ]
          },
          "80170507": {
            "id": "80170507",
            "speakerId": 1096,
            "speakerName": "茜特菈莉",
            "text": "#{NICKNAME}回来了？啧，怎么没人早点叫醒我…",
            "nextDialogs": [
              "80170508"
            ]
          },
          "80170508": {
            "id": "80170508",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "看你的样子…宿醉的你也没有那么好叫醒吧，茜特菈莉。",
            "nextDialogs": [
              "80170509"
            ]
          },
          "80170509": {
            "id": "80170509",
            "speakerId": 1096,
            "speakerName": "茜特菈莉",
            "text": "我…我宿醉的时候还是可以保持清醒的！呃…好像这句话哪里不对…",
            "nextDialogs": [
              "80170510"
            ]
          },
          "80170510": {
            "id": "80170510",
            "speakerId": 1096,
            "speakerName": "茜特菈莉",
            "text": "我想说的是，我刚听到你们在说什么深渊教团的「冥想」？",
            "nextDialogs": [
              "80170511"
            ]
          },
          "80170511": {
            "id": "80170511",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "对呀，茜特菈莉难道察觉到什么了吗？",
            "nextDialogs": [
              "80170512"
            ]
          },
          "80170512": {
            "id": "80170512",
            "speakerId": 1096,
            "speakerName": "茜特菈莉",
            "text": "刚刚的梦中确实有些异样…尽管只是模糊不清的感觉，纳塔的地脉此时此刻似乎混入了某种「杂音」…",
            "nextDialogs": [
              "80170513"
            ]
          },
          "80170513": {
            "id": "80170513",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "杂音？",
            "nextDialogs": [
              "80170514"
            ]
          },
          "80170514": {
            "id": "80170514",
            "speakerId": 1096,
            "speakerName": "茜特菈莉",
            "text": "虽说这种杂音似乎对地脉和夜神之国没有任何实质性的影响…",
            "nextDialogs": [
              "80170515"
            ]
          },
          "80170515": {
            "id": "80170515",
            "speakerId": 1096,
            "speakerName": "茜特菈莉",
            "text": "就好像…互不干扰的两个维度的东西，也感觉不到任何威胁，但总觉得有些事情正在发生。",
            "nextDialogs": [
              "80170516"
            ]
          },
          "80170516": {
            "id": "80170516",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "就连对地脉和夜神之国的事情最敏感的茜特菈莉都只有这么含混不清的感觉吗？",
            "nextDialogs": [
              "80170517"
            ]
          },
          "80170517": {
            "id": "80170517",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "难怪那个叫苏图拉的哨兵喊来的萨满们都察觉不到任何东西。",
            "nextDialogs": [
              "80170518"
            ]
          },
          "80170518": {
            "id": "80170518",
            "speakerId": 1096,
            "speakerName": "茜特菈莉",
            "text": "伊安珊，我建议我们一会儿去找首领，这样拖下去对我们没有好处，是时候考虑主动出击驱逐那些深渊教团了。",
            "nextDialogs": [
              "80170519"
            ]
          },
          "80170519": {
            "id": "80170519",
            "speakerId": 1091,
            "speakerName": "伊安珊",
            "text": "如果是黑曜石奶奶的提议，首领当然会同意，不过筹措兵力估计还需要一点时间。",
            "nextDialogs": [
              "80170520"
            ]
          },
          "80170520": {
            "id": "80170520",
            "speakerId": 1091,
            "speakerName": "伊安珊",
            "text": "战争还是要做好万全准备才是。",
            "nextDialogs": [
              "80170521"
            ]
          },
          "80170521": {
            "id": "80170521",
            "speakerId": 1096,
            "speakerName": "茜特菈莉",
            "text": "这种事情我就不管了，你们忙你们的吧，出发的时候带上我就是了。"
          }
        }
      }
    },
    {
      "subId": "801706",
      "subQuestName": "回到先前的山洞查看",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "80170601"
        ],
        "dialogs": {
          "80170601": {
            "id": "80170601",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "又回到这里了，蒂莱尔应该还在这里吧？",
            "nextDialogs": [
              "80170602"
            ]
          },
          "80170602": {
            "id": "80170602",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "这么安静…感觉也不好说，万一伊安珊怀疑的是正确的，她可能就不会乖乖躲在这里了吧？",
            "nextDialogs": [
              "80170605"
            ]
          },
          "80170605": {
            "id": "80170605",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "喂！当心！",
            "nextDialogs": [
              "80170606"
            ]
          },
          "80170606": {
            "id": "80170606",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "——！！！",
            "nextDialogs": [
              "80170607"
            ]
          },
          "80170607": {
            "id": "80170607",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "（难道说蒂莱尔她果然…）",
            "nextDialogs": [
              "80170608"
            ]
          },
          "80170608": {
            "id": "80170608",
            "speakerId": 15204,
            "speakerName": "蒂莱尔",
            "text": "——嗨呀！",
            "nextDialogs": [
              "80170609"
            ]
          },
          "80170609": {
            "id": "80170609",
            "speakerId": 15204,
            "speakerName": "蒂莱尔",
            "text": "啊…对不起对不起！怎么是你们！我听到有动静，还以为是来找我的魔物…",
            "nextDialogs": [
              "80170610"
            ]
          },
          "80170610": {
            "id": "80170610",
            "speakerId": 15204,
            "speakerName": "蒂莱尔",
            "text": "痛不痛？真是对不起，是我太紧张了…"
          }
        }
      }
    },
    {
      "subId": "801707",
      "subQuestName": "守护蒂莱尔",
      "sceneId": null,

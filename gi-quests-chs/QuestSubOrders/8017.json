    {
      "subId": "801708",
      "subQuestName": "与蒂莱尔对话",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "80170801"
        ],
        "dialogs": {
          "80170801": {
            "id": "80170801",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "欸？看你的样子，全都解决了吗？",
            "nextDialogs": [
              "80170802"
            ]
          },
          "80170802": {
            "id": "80170802",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "我都已经快要习惯看你和空气打架的样子了…",
            "nextDialogs": [
              "80170803"
            ]
          },
          "80170803": {
            "id": "80170803",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "还好吗，蒂莱尔？",
            "nextDialogs": [
              "80170804"
            ]
          },
          "80170804": {
            "id": "80170804",
            "speakerId": 15204,
            "speakerName": "蒂莱尔",
            "text": "……",
            "nextDialogs": [
              "80170805"
            ]
          },
          "80170805": {
            "id": "80170805",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "蒂莱尔？是被吓到了吗？",
            "nextDialogs": [
              "80170806"
            ]
          },
          "80170806": {
            "id": "80170806",
            "speakerId": 15204,
            "speakerName": "蒂莱尔",
            "text": "…啊…我、我没事…就是刚刚在发呆罢了。",
            "nextDialogs": [
              "80170807"
            ]
          },
          "80170807": {
            "id": "80170807",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "刚刚那么危急的情况，你居然有心情发呆…我看你的胆子也没有那么小嘛。",
            "nextDialogs": [
              "80170808"
            ]
          },
          "80170808": {
            "id": "80170808",
            "speakerId": 15204,
            "speakerName": "蒂莱尔",
            "text": "我只是在…好好地用力地把保护我的人的背影烙印在脑子里，我觉得这样才比较礼貌。",
            "nextDialogs": [
              "80170809"
            ]
          },
          "80170809": {
            "id": "80170809",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "唉…随便你吧。",
            "nextDialogs": [
              "80170810"
            ]
          },
          "80170810": {
            "id": "80170810",
            "speakerId": 15204,
            "speakerName": "蒂莱尔",
            "text": "已经看不到别的魔物了，时间也有点晚了，你们要不要考虑今晚就在这里休息？",
            "nextDialogs": [
              "80170811"
            ]
          },
          "80170811": {
            "id": "80170811",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "#值得考虑的提案，你觉得呢，{NICKNAME}？",
            "nextDialogs": [
              "80170812"
            ]
          },
          "80170812": {
            "id": "80170812",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "（虽然基本已经确定蒂莱尔没什么嫌疑了，但…还是再观察一晚好了。）",
            "nextDialogs": [
              "80170813"
            ]
          },
          "80170813": {
            "id": "80170813",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "嗯，那就这么决定了蒂莱尔，欸？蒂莱尔你怎么自顾自进去了呀？",
            "nextDialogs": [
              "80170814"
            ]
          },
          "80170814": {
            "id": "80170814",
            "speakerId": 1007,
            "speakerName": "Black Screen",
            "text": "夜深人静，你看着手里的那把「休眠仓钥匙」，戒心逐渐松动，沉沉睡去…",
            "nextDialogs": [
              "80170815"
            ]
          },
          "80170815": {
            "id": "80170815",
            "speakerId": 1007,
            "speakerName": "Black Screen",
            "text": "不久后，梦境笼罩了你…"
          }
        }
      }
    },
    {
      "subId": "801713",
      "subQuestName": "入睡，进入梦境",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "80171001"
        ],
        "dialogs": {
          "80171001": {
            "id": "80171001",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "（这里是…夜神之国？）",
            "nextDialogs": [
              "80171002"
            ]
          },
          "80171002": {
            "id": "80171002",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "#（{M#荧}{F#哥哥}！还有…夜神？）",
            "nextDialogs": [
              "80171003"
            ]
          },
          "80171003": {
            "id": "80171003",
            "speakerId": 1008,
            "speakerName": "Sibling",
            "text": "……",
            "nextDialogs": [
              "80171004"
            ]
          },
          "80171004": {
            "id": "80171004",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "（——！！！）",
            "nextDialogs": [
              "80171005"
            ]
          },
          "80171005": {
            "id": "80171005",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "（头…好痛！）",
            "nextDialogs": [
              "80171006"
            ]
          },
          "80171006": {
            "id": "80171006",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "（……）",
            "nextDialogs": [
              "80171007"
            ]
          },
          "80171007": {
            "id": "80171007",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "（头痛…好像消失了？）",
            "nextDialogs": [
              "80171008"
            ]
          },
          "80171008": {
            "id": "80171008",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "（黑暗里…似乎有什么声音…）",
            "nextDialogs": [
              "80171009"
            ]
          },
          "80171009": {
            "id": "80171009",
            "speakerId": 10205,
            "speakerName": "？？？",
            "text": "…那应该完全可以称之为「灭顶之灾」。",
            "nextDialogs": [
              "80171010"
            ]
          },
          "80171010": {
            "id": "80171010",
            "speakerId": 10205,
            "speakerName": "？？？",
            "text": "赤红色的天空…",
            "nextDialogs": [
              "80171011"
            ]
          },
          "80171011": {
            "id": "80171011",
            "speakerId": 10205,
            "speakerName": "？？？",
            "text": "将一切屠戮殆尽的兽群…",
            "nextDialogs": [
              "80171012"
            ]
          },
          "80171012": {
            "id": "80171012",
            "speakerId": 10205,
            "speakerName": "？？？",
            "text": "无尽的痛苦与不可逆转的诅咒…",
            "nextDialogs": [
              "80171013"
            ]
          },
          "80171013": {
            "id": "80171013",
            "speakerId": 10205,
            "speakerName": "？？？",
            "text": "以及…「救世主」的诞生。"
          }
        }
      }
    },

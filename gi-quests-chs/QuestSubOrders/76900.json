        "dialogs": {
          "769000101": {
            "id": "769000101",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "关于你说的故事…",
            "nextDialogs": [
              "769000102"
            ]
          },
          "769000102": {
            "id": "769000102",
            "speakerId": 1000,
            "speakerName": "乌尔瓦",
            "text": "都是些沙漠人耳熟能详的老故事。像是穆扎法尔代伊的冒险，还有妖后玛海菈的宝藏，孩子们都很喜欢。",
            "nextDialogs": [
              "769000103"
            ]
          },
          "769000103": {
            "id": "769000103",
            "speakerId": 1000,
            "speakerName": "乌尔瓦",
            "text": "当然，也有一些关于智慧和…如何做出正确选择的故事。",
            "nextDialogs": [
              "769000104"
            ]
          },
          "769000104": {
            "id": "769000104",
            "speakerId": 1000,
            "speakerName": "乌尔瓦",
            "text": "故事里总有好人和坏人。但老朽希望他们明白，即使不慎踏上了错误的道路，也不必沿着它一直走下去。",
            "nextDialogs": [
              "769000105"
            ]
          },
          "769000105": {
            "id": "769000105",
            "speakerId": 1000,
            "speakerName": "乌尔瓦",
            "text": "沙漠是个严酷的地方，能生存下来的人，都或多或少懂得一些道理。而有些道理，是年轻时搞不懂，付出代价才能明白的呀…",
            "nextDialogs": [
              "769000106"
            ]
          },
          "769000106": {
            "id": "769000106",
            "speakerId": 1000,
            "speakerName": "乌尔瓦",
            "text": "…呵呵，抱歉，说远了。人上了岁数，就是喜欢絮叨…"
          }
        }
      }
    }
  ]
}
      }
    },
    {
      "subId": "1202510",
      "subQuestName": "与荒泷一斗对话",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "120250401"
        ],
        "dialogs": {
          "120250401": {
            "id": "120250401",
            "speakerId": 1003,
            "speakerName": "荒泷一斗",
            "text": "就是这个，就是这个，你看，跟着我就一定能找到鬼兜虫！",
            "nextDialogs": [
              "120250404"
            ]
          },
          "120250404": {
            "id": "120250404",
            "speakerId": 1003,
            "speakerName": "荒泷一斗",
            "text": "嗯，小是有点小，但斗虫的胜负，也不完全是由体型决定的。",
            "nextDialogs": [
              "120250405"
            ]
          },
          "120250405": {
            "id": "120250405",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "你之前不是这么说的！",
            "nextDialogs": [
              "120250406"
            ]
          },
          "120250406": {
            "id": "120250406",
            "speakerId": 1003,
            "speakerName": "荒泷一斗",
            "text": "听我解释嘛，小虫子在力量上有所欠缺，但它更灵活，更有可能出奇制胜。",
            "nextDialogs": [
              "120250407"
            ]
          },
          "120250407": {
            "id": "120250407",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "但它看起来也没什么精神。",
            "nextDialogs": [
              "120250408"
            ]
          },
          "120250408": {
            "id": "120250408",
            "speakerId": 1003,
            "speakerName": "荒泷一斗",
            "text": "「精神」这东西，不斗一斗怎么看得出来？",
            "nextDialogs": [
              "120250409"
            ]
          },
          "120250409": {
            "id": "120250409",
            "speakerId": 1003,
            "speakerName": "荒泷一斗",
            "text": "它虽然看起来有点稚嫩，但这也有优势，有句话叫盲人不怕蛇嘛。",
            "nextDialogs": [
              "120250410"
            ]
          },
          "120250410": {
            "id": "120250410",
            "speakerId": 1003,
            "speakerName": "荒泷一斗",
            "text": "没有打过架的虫子，打起架来特别有狠劲，反倒是一些老江湖，看到难缠的对手会畏畏缩缩的。",
            "nextDialogs": [
              "120250411"
            ]
          },
          "120250411": {
            "id": "120250411",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "我本来期待更大的虫子…",
            "nextDialogs": [
              "120250412"
            ]
          },
          "120250412": {
            "id": "120250412",
            "speakerId": 1003,
            "speakerName": "荒泷一斗",
            "text": "没问题，相信本大爷的判断吧，我的经验告诉我，这只鬼兜虫已经很不错了。",
            "nextDialogs": [
              "120250413"
            ]
          },
          "120250413": {
            "id": "120250413",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "说起来，派蒙去哪儿了？",
            "nextDialogs": [
              "120250414"
            ]
          },
          "120250414": {
            "id": "120250414",
            "speakerId": 1002,
            "speakerName": "派蒙",
            "text": "我回来了！你们看我找到了什么！",
            "nextDialogs": [
              "120250415"
            ]
          },
          "120250415": {
            "id": "120250415",
            "speakerId": 1002,
            "speakerName": "派蒙",
            "text": "反正要陪一斗，闲着也是闲着。我们跳下来的时候，我飞到另一边去看了看，碰巧就看到这一只。",
            "nextDialogs": [
              "120250416"
            ]
          },
          "120250416": {
            "id": "120250416",
            "speakerId": 1002,
            "speakerName": "派蒙",
            "text": "怎么样，又大，又健壮，一看就很能打，很符合一斗对强者的描述！",
            "nextDialogs": [
              "120250417"
            ]
          },
          "120250417": {
            "id": "120250417",
            "speakerId": 1002,
            "speakerName": "派蒙",
            "text": "你们找到的一定比这个更…",
            "nextDialogs": [
              "120250418"
            ]
          },
          "120250418": {
            "id": "120250418",
            "speakerId": 1002,
            "speakerName": "派蒙",
            "text": "大…吧…",
            "nextDialogs": [
              "120250419"
            ]
          },
          "120250419": {
            "id": "120250419",
            "speakerId": 1003,
            "speakerName": "荒泷一斗",
            "text": "啊，这…难道你也很有抓虫子的经验？",
            "nextDialogs": [
              "120250420"
            ]
          },
          "120250420": {
            "id": "120250420",
            "speakerId": 1002,
            "speakerName": "派蒙",
            "text": "第、第一次自己抓鬼兜虫。",
            "nextDialogs": [
              "120250421"
            ]
          },
          "120250421": {
            "id": "120250421",
            "speakerId": 1003,
            "speakerName": "荒泷一斗",
            "text": "那你很有天赋啊，用不了多久，你就能成长为斗虫专家的！不过肯定会比我逊一筹就是了。",
            "nextDialogs": [
              "120250422"
            ]
          },
          "120250422": {
            "id": "120250422",
            "speakerId": 1002,
            "speakerName": "派蒙",
            "text": "那…那好像也没什么了不起。",
            "nextDialogs": [
              "120250423"
            ]
          },
          "120250423": {
            "id": "120250423",
            "speakerId": 1003,
            "speakerName": "荒泷一斗",
            "text": "很好，再算上这一只，我们的胜算又提升了，这次一定可以赢的！",
            "nextDialogs": [
              "120250424"
            ]
          },
          "120250424": {
            "id": "120250424",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "「这次」？你不会没赢过吧？",
            "nextDialogs": [
              "120250425"
            ]
          },
          "120250425": {
            "id": "120250425",
            "speakerId": 1003,
            "speakerName": "荒泷一斗",
            "text": "咳咳…这世上啊，有些人虽然充满才能和热血，却不一定能得到好的结果。",
            "nextDialogs": [
              "120250426"
            ]
          },
          "120250426": {
            "id": "120250426",
            "speakerId": 1003,
            "speakerName": "荒泷一斗",
            "text": "毕竟结果会受到很多因素的影响，有一个词语非常完美地概括了这些情况，它叫做「巧合」。",
            "nextDialogs": [
              "120250427"
            ]
          },
          "120250427": {
            "id": "120250427",
            "speakerId": 1002,
            "speakerName": "派蒙",
            "text": "这么厉害吗，那我的这只有没有也无所谓了吧，干脆…",
            "nextDialogs": [
              "120250428"
            ]
          },
          "120250428": {
            "id": "120250428",
            "speakerId": 1003,
            "speakerName": "荒泷一斗",
            "text": "等、等等等一下！"
          }
        }
      }
    },
    {
      "subId": "1202512",
      "subQuestName": "跟随荒泷一斗与大辅斗虫",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [],
        "dialogs": {}
      }
    },
    {
      "subId": "1202514",
      "subQuestName": "向荒泷一斗了解鬼族的过去",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "120250601"
        ],
        "dialogs": {
          "120250601": {
            "id": "120250601",
            "speakerId": 1003,
            "speakerName": "荒泷一斗",
            "text": "本大爷坦率承认吧，天领奉行正在追查的抢劫与掳掠事件，都不是我做的。",
            "nextDialogs": [
              "120250602"
            ]
          },
          "120250602": {
            "id": "120250602",
            "speakerId": 1003,
            "speakerName": "荒泷一斗",
            "text": "我撒谎有我的理由，在解决重要的事情之前，我不想把无关的人卷进来。",
            "nextDialogs": [
              "120250603"
            ]
          },
          "120250603": {
            "id": "120250603",
            "speakerId": 1003,
            "speakerName": "荒泷一斗",
            "text": "我和你们的想法一样，都竭力想要避免争斗。无论我们谁受伤，都绝对不是好结果。",
            "nextDialogs": [
              "120250604"
            ]
          },
          "120250604": {
            "id": "120250604",
            "speakerId": 1002,
            "speakerName": "派蒙",
            "text": "那到底是什么事，不惜背负罪名也要去做呢？",
            "nextDialogs": [
              "120250605"
            ]
          },
          "120250605": {
            "id": "120250605",
            "speakerId": 1003,
            "speakerName": "荒泷一斗",
            "text": "唉…你们是外面来的对吧，那我还得从很久很久以前，赤鬼和青鬼的故事开始讲…",
            "nextDialogs": [
              "120250606"
            ]
          },
          "120250606": {
            "id": "120250606",
            "speakerId": 1002,
            "speakerName": "派蒙",
            "text": "等等，如果是童话故事的话，我们已经听过了。",
            "nextDialogs": [
              "120250607"
            ]
          },
          "120250607": {
            "id": "120250607",
            "speakerId": 1003,
            "speakerName": "荒泷一斗",
            "text": "什么嘛，你们已经知道了啊。那可就简单多了，省了我不少的麻烦。",
            "nextDialogs": [
              "120250608"
            ]
          },
          "120250608": {
            "id": "120250608",
            "speakerId": 1002,
            "speakerName": "派蒙",
            "text": "难道童话故事里发生的事情是真的吗？",
            "nextDialogs": [
              "120250609"
            ]
          },
          "120250609": {
            "id": "120250609",
            "speakerId": 1003,
            "speakerName": "荒泷一斗",
            "text": "关于鬼族的命运，童话里讲的都是真的——青鬼选择了自我流放，只有赤鬼留存了下来。",
            "nextDialogs": [
              "120250610"
            ]
          },
          "120250610": {
            "id": "120250610",
            "speakerId": 1003,
            "speakerName": "荒泷一斗",
            "text": "但其他的就和真正的历史没有什么关系了，童话讲述的都是美好故事，没办法提及残酷的真实。",
            "nextDialogs": [
              "120250611"
            ]
          },
          "120250611": {
            "id": "120250611",
            "speakerId": 1003,
            "speakerName": "荒泷一斗",
            "text": "很久以前的稻妻还很危险，那时候如果想要寻求雷电将军的庇护，就必须和人类搞好关系。",
            "nextDialogs": [
              "120250612"
            ]
          },
          "120250612": {
            "id": "120250612",
            "speakerId": 1003,
            "speakerName": "荒泷一斗",
            "text": "鬼族生来骄傲，要去「请求别人的接纳」并不容易。在这个过程中，鬼族慢慢分裂成了两派。",
            "nextDialogs": [
              "120250613"
            ]
          },
          "120250613": {
            "id": "120250613",
            "speakerId": 1003,
            "speakerName": "荒泷一斗",
            "text": "对人类的态度比较亲和的，就是赤鬼，而比较倔强和固执的，就是青鬼。",
            "nextDialogs": [
              "120250614"
            ]
          },
          "120250614": {
            "id": "120250614",
            "speakerId": 1002,
            "speakerName": "派蒙",
            "text": "我还以为是两个不同的种族呢，原来是一家人啊…",
            "nextDialogs": [
              "120250615"
            ]
          },
          "120250615": {
            "id": "120250615",
            "speakerId": 1003,
            "speakerName": "荒泷一斗",
            "text": "嗯，我们之间几乎没有区别，都是靠在角上涂不同的颜色，来区别立场。",
            "nextDialogs": [
              "120250616"
            ]
          },
          "120250616": {
            "id": "120250616",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "为什么青鬼必须牺牲？",
            "nextDialogs": [
              "120250617"
            ]
          },
          "120250617": {
            "id": "120250617",
            "speakerId": 1003,
            "speakerName": "荒泷一斗",
            "text": "因为在那个时候，人类对鬼族的戒心还很强。",
            "nextDialogs": [
              "120250618"
            ]
          },
          "120250618": {
            "id": "120250618",
            "speakerId": 1003,
            "speakerName": "荒泷一斗",
            "text": "赤鬼努力地想要找到和人类的和平相处之道，但青鬼时不时就会和人类产生矛盾。",
            "nextDialogs": [
              "120250619"
            ]
          },
          "120250619": {
            "id": "120250619",
            "speakerId": 1003,
            "speakerName": "荒泷一斗",
            "text": "人类可不管赤鬼青鬼什么的，只会认为鬼族不好相处。",
            "nextDialogs": [
              "120250620"
            ]
          },
          "120250620": {
            "id": "120250620",
            "speakerId": 1003,
            "speakerName": "荒泷一斗",
            "text": "一直这样下去，鬼族永远不会被人类接受。这个时候，赤鬼与青鬼里最德高望重的首领站了出来。",
            "nextDialogs": [
              "120250621"
            ]
          },
          "120250621": {
            "id": "120250621",
            "speakerId": 1003,
            "speakerName": "荒泷一斗",
            "text": "他们饮酒立誓，青鬼将会扮演恶鬼的角色，帮助赤鬼融入人类社会，但青鬼的首领也提出了两个条件。",
            "nextDialogs": [
              "120250622"
            ]
          },
          "120250622": {
            "id": "120250622",
            "speakerId": 1002,
            "speakerName": "派蒙",
            "text": "条件？",
            "nextDialogs": [
              "120250623"
            ]
          },
          "120250623": {
            "id": "120250623",
            "speakerId": 1003,
            "speakerName": "荒泷一斗",
            "text": "首先，鬼族不可对人类抱有成见，在被人类接纳之前要先在心中接纳人类。不可恃强凌弱，也不可自暴自弃。",
            "nextDialogs": [
              "120250624"
            ]
          },
          "120250624": {
            "id": "120250624",
            "speakerId": 1003,
            "speakerName": "荒泷一斗",
            "text": "第二，赤鬼要融入人类，但不可取悦人类。鬼族应该以正直的性格，奔腾的热血，强大的力量去赢得人类的尊重。",
            "nextDialogs": [
              "120250625"
            ]
          },
          "120250625": {
            "id": "120250625",
            "speakerId": 1003,
            "speakerName": "荒泷一斗",
            "text": "换句话说，就是在延续鬼族血脉的同时，守住我们的「骄傲」。",
            "nextDialogs": [
              "120250626"
            ]
          },
          "120250626": {
            "id": "120250626",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "原来是这样…",
            "nextDialogs": [
              "120250627"
            ]
          },
          "120250627": {
            "id": "120250627",
            "speakerId": 1003,
            "speakerName": "荒泷一斗",
            "text": "在那之后，因为决定自我牺牲，青鬼的族群越来越小，最后就消失了。",
            "nextDialogs": [
              "120250628"
            ]
          },
          "120250628": {
            "id": "120250628",
            "speakerId": 1003,
            "speakerName": "荒泷一斗",
            "text": "赤鬼和青鬼的故事，我从小听到大，我从来没想过，青鬼一族竟然活了下来…",
            "nextDialogs": [
              "120250629"
            ]
          },
          "120250629": {
            "id": "120250629",
            "speakerId": 1002,
            "speakerName": "派蒙",
            "text": "所以你的意思是，这些作恶事件都是青鬼一族的后人做的？",
            "nextDialogs": [
              "120250630"
            ]
          },
          "120250630": {
            "id": "120250630",
            "speakerId": 1003,
            "speakerName": "荒泷一斗",
            "text": "是的，很多人根本不在乎鬼角的颜色，甚至都不知道有青鬼的存在。",
            "nextDialogs": [
              "120250631"
            ]
          },
          "120250631": {
            "id": "120250631",
            "speakerId": 1003,
            "speakerName": "荒泷一斗",
            "text": "但「荒泷派」的弟兄们不会认错，他们亲眼在现场见到了角的颜色与我不同的鬼。",
            "nextDialogs": [
              "120250632"
            ]
          },
          "120250632": {
            "id": "120250632",
            "speakerId": 1003,
            "speakerName": "荒泷一斗",
            "text": "可如果是青鬼的后代，未免有些太奇怪了，本大爷实在是不能接受。",
            "nextDialogs": [
              "120250633"
            ]
          },
          "120250633": {
            "id": "120250633",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "因为青鬼很重视「骄傲」？",
            "nextDialogs": [
              "120250634"
            ]
          },
          "120250634": {
            "id": "120250634",
            "speakerId": 1003,
            "speakerName": "荒泷一斗",
            "text": "对啊！他们总是将「骄傲」看得比自己的生命更重！",
            "nextDialogs": [
              "120250635"
            ]
          },
          "120250635": {
            "id": "120250635",
            "speakerId": 1003,
            "speakerName": "荒泷一斗",
            "text": "我一直很钦佩选择了自我牺牲的青鬼一族，也明白我的祖先对鬼族的未来有怎样的期望。",
            "nextDialogs": [
              "120250636"
            ]
          },
          "120250636": {
            "id": "120250636",
            "speakerId": 1003,
            "speakerName": "荒泷一斗",
            "text": "抢劫，掳掠，哪里是鬼族的「骄傲」容许之事！",
            "nextDialogs": [
              "120250637"
            ]
          },
          "120250637": {
            "id": "120250637",
            "speakerId": 1003,
            "speakerName": "荒泷一斗",
            "text": "我觉得，那个青鬼一定是被骗了，或者被人威胁，才做了这样的事。可是，我没有证据…",
            "nextDialogs": [
              "120250638"
            ]
          },
          "120250638": {
            "id": "120250638",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "所以你是在争取时间？",
            "nextDialogs": [
              "120250639"
            ]
          },
          "120250639": {
            "id": "120250639",
            "speakerId": 1003,
            "speakerName": "荒泷一斗",
            "text": "是的，要是没有我混淆视听，那家伙肯定已经被天领奉行的人抓了。",
            "nextDialogs": [
              "120250640"
            ]
          },
          "120250640": {
            "id": "120250640",
            "speakerId": 1002,
            "speakerName": "派蒙",
            "text": "大辅不会也和这件事有关吧？他说你救了他，他应该知道你做的事。",
            "nextDialogs": [
              "120250641"
            ]
          },
          "120250641": {
            "id": "120250641",
            "speakerId": 1003,
            "speakerName": "荒泷一斗",
            "text": "因为他就是我在现场打跑了流浪武士，拼了命抢下来的。",
            "nextDialogs": [
              "120250642"
            ]
          },
          "120250642": {
            "id": "120250642",
            "speakerId": 1003,
            "speakerName": "荒泷一斗",
            "text": "那帮人洗劫他家的时候，他正好在外面玩，回来的时候，爸爸妈妈都已经被抓走了。",
            "nextDialogs": [
              "120250643"
            ]
          },
          "120250643": {
            "id": "120250643",
            "speakerId": 1003,
            "speakerName": "荒泷一斗",
            "text": "我要追查这件事，也是为了把他的父母找回来。",
            "nextDialogs": [
              "120250646"
            ]
          },
          "120250646": {
            "id": "120250646",
            "speakerId": 1003,
            "speakerName": "荒泷一斗",
            "text": "我就没想说这些，本大爷原本的计划是干净利落地把你打晕，然后带着我的家人逃去另外的地方。",
            "nextDialogs": [
              "120250647"
            ]
          },
          "120250647": {
            "id": "120250647",
            "speakerId": 1003,
            "speakerName": "荒泷一斗",
            "text": "这件事不仅牵扯到青鬼，还牵扯到参与抢劫和掳掠的危险团体，我不能把无关的人牵扯进来。",
            "nextDialogs": [
              "120250648"
            ]
          },
          "120250648": {
            "id": "120250648",
            "speakerId": 1003,
            "speakerName": "荒泷一斗",
            "text": "本大爷的解释就到此为止，如果你不能信服，要把我抓回去，那我就会尽我的全力，和你战斗到底。",
            "nextDialogs": [
              "120250649"
            ]
          },
          "120250649": {
            "id": "120250649",
            "speakerId": 1003,
            "speakerName": "荒泷一斗",
            "text": "如果你愿意相信我，就再给我一点时间，等我把青鬼找回来，我会带着他一起去自首。",
            "nextDialogs": [
              "120250650"
            ]
          },
          "120250650": {
            "id": "120250650",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "我会帮你的。",
            "nextDialogs": [
              "120250651"
            ]
          },
          "120250651": {
            "id": "120250651",
            "speakerId": 1002,
            "speakerName": "派蒙",
            "text": "嗯，还有我！"
          }
        }
      }
    },
    {
      "subId": "1202521",
      "subQuestName": "（test）到达合适的位置",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [],
        "dialogs": {}
      }
    },
    {
      "subId": "1202510",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "120251001"
        ],
        "dialogs": {
          "120251001": {
            "id": "120251001",
            "speakerId": 1000,
            "speakerName": "大辅",
            "text": "你们捉到虫子了吗？",
            "nextDialogs": [
              "120251002"
            ]
          },
          "120251002": {
            "id": "120251002",
            "speakerId": 1000,
            "speakerName": "大辅",
            "text": "没捉到就快去找找吧，我已经等不及了。"
          }
        }
      }
    },
    {
      "subId": "1202511",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "120251101"
        ],
        "dialogs": {
          "120251101": {
            "id": "120251101",
            "speakerId": 1001,
            "speakerName": "鬼婆婆",
            "text": "一斗啊，不用在意我们。想做的事，就放手去做吧。"
          }
        }
      }
    },
    {
      "subId": "1202599",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "120259901"
        ],
        "dialogs": {
          "120259901": {
            "id": "120259901",
            "speakerId": 1002,
            "speakerName": "派蒙",
            "text": "按照珊瑚的情报，人应该就在附近了。",
            "nextDialogs": [
              "120259902"
            ]
          },
          "120259902": {
            "id": "120259902",
            "speakerId": 1002,
            "speakerName": "派蒙",
            "text": "之前凯瑟琳提到了他有神之眼，干脆用「元素视野」追踪一下吧。",
            "nextDialogs": [
              "120259903"
            ]
          },
          "120259903": {
            "id": "120259903",
            "speakerId": 1002,
            "speakerName": "派蒙",
            "text": "好像有脚印，跟着调查一下吧。",
            "nextDialogs": [
              "120259904"
            ]
          },
          "120259904": {
            "id": "120259904",
            "speakerId": 1002,
            "speakerName": "派蒙",
            "text": "有个营地，但好像没什么值得注意的…",
            "nextDialogs": [
              "120259905"
            ]
          },
          "120259905": {
            "id": "120259905",
            "speakerId": 1002,
            "speakerName": "派蒙",
            "text": "我们继续往前走吧。",
            "nextDialogs": [
              "120259906"
            ]
          },
          "120259906": {
            "id": "120259906",
            "speakerId": 1002,
            "speakerName": "派蒙",
            "text": "这里还有脚印，他应该就在前面了。",
            "nextDialogs": [
              "120259907"
            ]
          },
          "120259907": {
            "id": "120259907",
            "speakerId": 1002,
            "speakerName": "派蒙",
            "text": "雷劈下来了！",
            "nextDialogs": [
              "120259908"
            ]
          },
          "120259908": {
            "id": "120259908",
            "speakerId": 1003,
            "speakerName": "荒泷一斗",
            "text": "糟了，不会把鬼兜虫吓跑了吧…",
            "nextDialogs": [
              "120259909"
            ]
          },
          "120259909": {
            "id": "120259909",
            "speakerId": 1003,
            "speakerName": "荒泷一斗",
            "text": "唔，果然已经不见了…",
            "nextDialogs": [
              "120259910"
            ]
          },
          "120259910": {
            "id": "120259910",
            "speakerId": 1003,
            "speakerName": "荒泷一斗",
            "text": "既然如此，从这里跳下去吧，我的直觉告诉我下面会有很大的鬼兜虫。",
            "nextDialogs": [
              "120259911"
            ]
          },
          "120259911": {
            "id": "120259911",
            "speakerId": 1003,
            "speakerName": "荒泷一斗",
            "text": "快看，那一团紫色的，有好多鬼兜虫聚在那里！",
            "nextDialogs": [
              "120259916"
            ]
          },
          "120259916": {
            "id": "120259916",
            "speakerId": 1003,
            "speakerName": "荒泷一斗",
            "text": "呃啊！"
          }
        }
      }
    }
  ]
}
    {
      "subId": "1202520",
      "subQuestName": "继续向前追踪",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "120252001"
        ],
        "dialogs": {
          "120252001": {
            "id": "120252001",
            "speakerId": 1000,
            "speakerName": "大辅",
            "text": "求求你们相信我，一斗哥哥没有做坏事！他不是坏人！",
            "nextDialogs": [
              "120252002"
            ]
          },
          "120252002": {
            "id": "120252002",
            "speakerId": 1001,
            "speakerName": "鬼婆婆",
            "text": "大辅这孩子就让我来安慰吧，没事的，不用担心。"
          }
        }
      }
    },
    {
      "subId": "1202501",
      "subQuestName": "继续向前追踪",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "120250101"
        ],
        "dialogs": {
          "120250101": {
            "id": "120250101",
            "speakerId": 1002,
            "speakerName": "派蒙",
            "text": "等下，那边的，就是荒泷一斗吧。",
            "nextDialogs": [
              "120250102"
            ]
          },
          "120250102": {
            "id": "120250102",
            "speakerId": 1002,
            "speakerName": "派蒙",
            "text": "他好像没有注意我们这边，正好，我们先试试珊瑚交给我们的豆子吧。",
            "nextDialogs": [
              "120250103"
            ]
          },
          "120250103": {
            "id": "120250103",
            "speakerId": 1002,
            "speakerName": "派蒙",
            "text": "能够避免争斗的话，也能避免意料之外的情况了。"
          }
        }
      }
    },

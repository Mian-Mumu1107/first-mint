    {
      "subId": "1202507",
      "subQuestName": "靠近鬼兜虫出没的大树",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "120250701"
        ],
        "dialogs": {
          "120250701": {
            "id": "120250701",
            "speakerId": 1004,
            "speakerName": "珊瑚",
            "text": "多谢惠顾，祝你们一切顺利。",
            "nextDialogs": [
              "120250702"
            ]
          },
          "120250702": {
            "id": "120250702",
            "speakerId": 1004,
            "speakerName": "珊瑚",
            "text": "下次记得多准备一点预算哦。"
          }
        }

    {
      "subId": "7111602",
      "subQuestName": "与铁豆儿交谈",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "711160202"
        ],
        "dialogs": {
          "711160202": {
            "id": "711160202",
            "speakerId": 21297,
            "speakerName": "铁豆儿",
            "text": "合字上的朋友，大恩不讲谢，有什么需要的，招呼一声就成！",
            "nextDialogs": [
              "711160203"
            ]
          },
          "711160203": {
            "id": "711160203",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "喔！你这个人还怪客气的。",
            "nextDialogs": [
              "711160205",
              "711160208"
            ]
          },
          "711160205": {
            "id": "711160205",
            "speakerId": 21297,
            "speakerName": "铁豆儿",
            "text": "需要摩拉？哈哈，这倒是好说。就是办起来还有点小小的麻烦——",
            "nextDialogs": [
              "711160206"
            ]
          },
          "711160206": {
            "id": "711160206",
            "speakerId": 21297,
            "speakerName": "铁豆儿",
            "text": "俺们的摩拉，全被瓢把子带走了。现在这土窝已经成黄草窑子了。",
            "nextDialogs": [
              "711160210"
            ]
          },
          "711160210": {
            "id": "711160210",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "瓢把子？",
            "nextDialogs": [
              "711160211"
            ]
          },
          "711160211": {
            "id": "711160211",
            "speakerId": 21297,
            "speakerName": "铁豆儿",
            "text": "就是俺们铁盐帮的老大，他在那边的山崖底下，跟一伙枫丹佬走砂，留下俺们守着窝。",
            "nextDialogs": [
              "711160212"
            ]
          },
          "711160212": {
            "id": "711160212",
            "speakerId": 21297,
            "speakerName": "铁豆儿",
            "text": "但是刚刚朋友也瞧见了吧？那些枫丹皮娃子，居然趁着瓢把子在谈事儿，偷偷摸了来，捅屁股！",
            "nextDialogs": [
              "711160213"
            ]
          },
          "711160213": {
            "id": "711160213",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "呜哇…捅屁股…！",
            "nextDialogs": [
              "711160214"
            ]
          },
          "711160214": {
            "id": "711160214",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "呜哇…！",
            "nextDialogs": [
              "711160215"
            ]
          },
          "711160215": {
            "id": "711160215",
            "speakerId": 21297,
            "speakerName": "铁豆儿",
            "text": "好崽子，这是把俺们当羊牯了？",
            "nextDialogs": [
              "711160216"
            ]
          },
          "711160216": {
            "id": "711160216",
            "speakerId": 21297,
            "speakerName": "铁豆儿",
            "text": "现在这边水漫了，瓢把子指不定也要吃暗青子。好朋友，话说帮人帮到底，还请再帮俺们一把？",
            "nextDialogs": [
              "711160217"
            ]
          },
          "711160217": {
            "id": "711160217",
            "speakerId": 21297,
            "speakerName": "铁豆儿",
            "text": "若瓢把子没事，保准有你们吃香喝辣。",
            "nextDialogs": [
              "711160218"
            ]
          },
          "711160218": {
            "id": "711160218",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "在哪里？我先去看看。",
            "nextDialogs": [
              "711160219"
            ]
          },
          "711160219": {
            "id": "711160219",
            "speakerId": 21297,
            "speakerName": "铁豆儿",
            "text": "就在那边山崖底下的海滩，你们过去指定能瞧见。",
            "nextDialogs": [
              "711160220"
            ]
          },
          "711160220": {
            "id": "711160220",
            "speakerId": 21297,
            "speakerName": "铁豆儿",
            "text": "两位朋友，托你们先走一步，俺收拾收拾就来。"
          },
          "711160208": {
            "id": "711160208",
            "speakerId": 21297,
            "speakerName": "铁豆儿",
            "text": "义薄云天！义薄云天啊！既然这样，两位朋友，俺正好有个事儿想说说。",
            "nextDialogs": [
              "711160209"
            ]
          },
          "711160209": {
            "id": "711160209",
            "speakerId": 21297,
            "speakerName": "铁豆儿",
            "text": "俺觉得瓢把子那边，搞不好也得遭事，得去帮忙。"
          }
        }
      }
    },
    {
      "subId": "7111603",
      "subQuestName": "前往山崖下的海滩",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [],
        "dialogs": {}
      }
    },
    {
      "subId": "7111604",
      "subQuestName": "介入双方的交谈",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "711160401"
        ],
        "dialogs": {
          "711160401": {
            "id": "711160401",
            "speakerId": 21298,
            "speakerName": "铁明",
            "text": "尊尼老大，你我朋友一场，我呢，也明白你们近来有难处。",
            "nextDialogs": [
              "711160402"
            ]
          },
          "711160402": {
            "id": "711160402",
            "speakerId": 21298,
            "speakerName": "铁明",
            "text": "有什么问题当面和我商量就好，搞成这样…未免有点伤感情了吧？",
            "nextDialogs": [
              "711160403"
            ]
          },
          "711160403": {
            "id": "711160403",
            "speakerId": 21299,
            "speakerName": "尊尼",
            "text": "嘿，朋友…你知道，我们这边的生意不同往常了。「刺玫会」近来得了势，我们的兄弟颇有些成了干货，落了水…",
            "nextDialogs": [
              "711160404"
            ]
          },
          "711160404": {
            "id": "711160404",
            "speakerId": 21299,
            "speakerName": "尊尼",
            "text": "小鸟儿们都还嗷嗷待哺呢。再这样下去，我们恐怕连鸟嘴都沾不湿了…",
            "nextDialogs": [
              "711160405"
            ]
          },
          "711160405": {
            "id": "711160405",
            "speakerId": 21299,
            "speakerName": "尊尼",
            "text": "我们的生意很好，很合理，如果多给我们一点…将来感谢的机会，我想朋友们会更能体会到我的诚意。",
            "nextDialogs": [
              "711160406"
            ]
          },
          "711160406": {
            "id": "711160406",
            "speakerId": 21299,
            "speakerName": "尊尼",
            "text": "不然…哈哈，大海这样广阔，铁明先生，你们也不是不好找到新朋友！",
            "nextDialogs": [
              "711160407"
            ]
          },
          "711160407": {
            "id": "711160407",
            "speakerId": 21298,
            "speakerName": "铁明",
            "text": "这样说，尊尼老大，这个报价，就是你的意思了？",
            "nextDialogs": [
              "711160408"
            ]
          },
          "711160408": {
            "id": "711160408",
            "speakerId": 21299,
            "speakerName": "尊尼",
            "text": "这样的价格有什么问题吗？",
            "nextDialogs": [
              "711160409"
            ]
          },
          "711160409": {
            "id": "711160409",
            "speakerId": 21362,
            "speakerName": "铁船儿",
            "text": "枫丹佬！招子放亮点！这点钱打发谁呢？！放那么多的屁干什么！",
            "nextDialogs": [
              "711160410"
            ]
          },
          "711160410": {
            "id": "711160410",
            "speakerId": 21298,
            "speakerName": "铁明",
            "text": "多嘴！",
            "nextDialogs": [
              "711160411"
            ]
          },
          "711160411": {
            "id": "711160411",
            "speakerId": 21298,
            "speakerName": "铁明",
            "text": "尊尼老大，我的货卖给唐佩西家族，一箱五万八。卖给德尼禄家族，一箱七万。他们都是柔灯港地下响当当的帮会，这不必我说。",
            "nextDialogs": [
              "711160412"
            ]
          },
          "711160412": {
            "id": "711160412",
            "speakerId": 21298,
            "speakerName": "铁明",
            "text": "我的货卖给你，三箱只要十万，专人接，专人送…为什么？为的是珍惜你这个朋友。",
            "nextDialogs": [
              "711160413"
            ]
          },
          "711160413": {
            "id": "711160413",
            "speakerId": 21298,
            "speakerName": "铁明",
            "text": "大道理我就不多说了…我相信尊尼老大还是欠考虑了！我们找个地方喝一杯，再聊聊怎么样！",
            "nextDialogs": [
              "711160414"
            ]
          },
          "711160414": {
            "id": "711160414",
            "speakerId": 21299,
            "speakerName": "尊尼",
            "text": "呵呵，没那个必要。我知道璃月人最讲究契约，契约最在乎公平。可没听说过情理能大于公平的说法。",
            "nextDialogs": [
              "711160415"
            ]
          },
          "711160415": {
            "id": "711160415",
            "speakerId": 21298,
            "speakerName": "铁明",
            "text": "呵呵，尊尼老大！如此注重契约精神，我的小弟们也该多多向你学习，哈哈！",
            "nextDialogs": [
              "711160416"
            ]
          },
          "711160416": {
            "id": "711160416",
            "speakerId": 21298,
            "speakerName": "铁明",
            "text": "只不过，在这件事上，我要首先看到你们对契约的尊重。",
            "nextDialogs": [
              "711160417"
            ]
          },
          "711160417": {
            "id": "711160417",
            "speakerId": 21299,
            "speakerName": "尊尼",
            "text": "当然，当然！您的话再有道理不过了，璃月的古老契约真是令人崇敬，看来我必须要展示一下我的敬意。",
            "nextDialogs": [
              "711160418"
            ]
          },
          "711160418": {
            "id": "711160418",
            "speakerId": 21299,
            "speakerName": "尊尼",
            "text": "沃克，你觉得给每件货的报价再提高…一摩拉，怎么样？",
            "nextDialogs": [
              "711160419"
            ]
          },
          "711160419": {
            "id": "711160419",
            "speakerId": 21363,
            "speakerName": "沃克",
            "text": "十分恰当，尊尼先生。这些璃月人如此辛劳，理应再获得每件货一摩拉的报酬。",
            "nextDialogs": [
              "711160420"
            ]
          },
          "711160420": {
            "id": "711160420",
            "speakerId": 21362,
            "speakerName": "铁船儿",
            "text": "枫丹佬！你们到底什么意思？！",
            "nextDialogs": [
              "711160421"
            ]
          },
          "711160421": {
            "id": "711160421",
            "speakerId": 21299,
            "speakerName": "尊尼",
            "text": "朋友，你们还感受不到这份远道而来的诚意吗？",
            "nextDialogs": [
              "711160422"
            ]
          },
          "711160422": {
            "id": "711160422",
            "speakerId": 21298,
            "speakerName": "铁明",
            "text": "尊尼老大，你们这是执意要违背约定了？",
            "nextDialogs": [
              "711160423"
            ]
          },
          "711160423": {
            "id": "711160423",
            "speakerId": 21299,
            "speakerName": "尊尼",
            "text": "哦？是吗？沃克，你觉得是这样吗？",
            "nextDialogs": [
              "711160424"
            ]
          },
          "711160424": {
            "id": "711160424",
            "speakerId": 21363,
            "speakerName": "沃克",
            "text": "尊尼先生，若您问我的意思…大海如此广阔，是虾米就该有点自知之明。",
            "nextDialogs": [
              "711160425"
            ]
          },
          "711160425": {
            "id": "711160425",
            "speakerId": 21299,
            "speakerName": "尊尼",
            "text": "沃克，我为你羞愧，你怎能如此侮辱我们的璃月朋友？",
            "nextDialogs": [
              "711160426"
            ]
          },
          "711160426": {
            "id": "711160426",
            "speakerId": 21299,
            "speakerName": "尊尼",
            "text": "毕竟稍后就要收下他们的地盘，我们不该心怀感恩吗？",
            "nextDialogs": [
              "711160427"
            ]
          },
          "711160427": {
            "id": "711160427",
            "speakerId": 21363,
            "speakerName": "沃克",
            "text": "对不起，尊尼先生。",
            "nextDialogs": [
              "711160428"
            ]
          },
          "711160428": {
            "id": "711160428",
            "speakerId": 21362,
            "speakerName": "铁船儿",
            "text": "你们！混账东西！你们居然打着这个主意…",
            "nextDialogs": [
              "711160429"
            ]
          },
          "711160429": {
            "id": "711160429",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "怎么还骂起人了？",
            "nextDialogs": [
              "711160430"
            ]
          },
          "711160430": {
            "id": "711160430",
            "speakerId": 21299,
            "speakerName": "尊尼",
            "text": "哦？这两位小朋友是…？",
            "nextDialogs": [
              "711160431"
            ]
          },
          "711160431": {
            "id": "711160431",
            "speakerId": 21299,
            "speakerName": "尊尼",
            "text": "呵呵，可真是有趣啊，璃月的小朋友都这么有胆色吗？沃克。",
            "nextDialogs": [
              "711160432"
            ]
          },
          "711160432": {
            "id": "711160432",
            "speakerId": 21363,
            "speakerName": "沃克",
            "text": "喂！哪来的小鬼，赏你们点摩拉，赶紧滚去买奶喝吧！",
            "nextDialogs": [
              "711160433"
            ]
          },
          "711160433": {
            "id": "711160433",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "你！你们这些人也太没礼貌了吧？",
            "nextDialogs": [
              "711160434"
            ]
          },
          "711160434": {
            "id": "711160434",
            "speakerId": 21298,
            "speakerName": "铁明",
            "text": "你们两位是…？",
            "nextDialogs": [
              "711160437"
            ]
          },
          "711160437": {
            "id": "711160437",
            "speakerId": 21299,
            "speakerName": "尊尼",
            "text": "哈哈哈哈！这样说来…你们是铁明先生请来的帮手了？",
            "nextDialogs": [
              "711160438"
            ]
          },
          "711160438": {
            "id": "711160438",
            "speakerId": 21299,
            "speakerName": "尊尼",
            "text": "原来铁明先生也早就对我们有想法了啊？哼，我们也不是毫无准备。沃克！",
            "nextDialogs": [
              "711160439"
            ]
          },
          "711160439": {
            "id": "711160439",
            "speakerId": 21363,
            "speakerName": "沃克",
            "text": "出来吧！兄弟们！到时候了！",
            "nextDialogs": [
              "711160440"
            ]
          },
          "711160440": {
            "id": "711160440",
            "speakerId": 21362,
            "speakerName": "铁船儿",
            "text": "什么？！",
            "nextDialogs": [
              "711160441"
            ]
          },
          "711160441": {
            "id": "711160441",
            "speakerId": 21299,
            "speakerName": "尊尼",
            "text": "哎呀，哎呀，怎么回事？好像还是我们的人比较多呢。",
            "nextDialogs": [
              "711160442"
            ]
          },
          "711160442": {
            "id": "711160442",
            "speakerId": 21299,
            "speakerName": "尊尼",
            "text": "铁明先生，真遗憾，我事先给手下安排了一些活，现在您留在营地的人，应该已经被清理干净了。",
            "nextDialogs": [
              "711160443"
            ]
          },
          "711160443": {
            "id": "711160443",
            "speakerId": 21299,
            "speakerName": "尊尼",
            "text": "请安心的去吧，您的生意我们会好好打理的。",
            "nextDialogs": [
              "711160444"
            ]
          },
          "711160444": {
            "id": "711160444",
            "speakerId": 21298,
            "speakerName": "铁明",
            "text": "尊尼老大…想淌我们铁盐帮的线，没那么简单！",
            "nextDialogs": [
              "711160445"
            ]
          },
          "711160445": {
            "id": "711160445",
            "speakerId": 21299,
            "speakerName": "尊尼",
            "text": "希望您的命和嘴一样硬，动手！"
          }
        }
      }
    },
    {
      "subId": "7111605",
      "subQuestName": "击败尊尼",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [],
        "dialogs": {}
      }
    },
    {
      "subId": "7111606",
      "subQuestName": "与铁明交谈",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "711160601"
        ],
        "dialogs": {
          "711160601": {
            "id": "711160601",
            "speakerId": 21298,
            "speakerName": "铁明",
            "text": "两位豪侠！多谢了！",
            "nextDialogs": [
              "711160602"
            ]
          },
          "711160602": {
            "id": "711160602",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "不用谢不用谢！不管在哪里交易，都要遵守契约才行！",
            "nextDialogs": [
              "711160603"
            ]
          },
          "711160603": {
            "id": "711160603",
            "speakerId": 21298,
            "speakerName": "铁明",
            "text": "呵呵，这位小豪侠说的是。不过这样看，两位似乎对我们的交易很清楚嘛。",
            "nextDialogs": [
              "711160604"
            ]
          },
          "711160604": {
            "id": "711160604",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "是铁豆儿告诉我们的啦，她说你们在这里走砂什么的…",
            "nextDialogs": [
              "711160605"
            ]
          },
          "711160605": {
            "id": "711160605",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "不过走砂是什么意思？",
            "nextDialogs": [
              "711160606"
            ]
          },
          "711160606": {
            "id": "711160606",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "好像不是什么正规的交易。",
            "nextDialogs": [
              "711160607"
            ]
          },
          "711160607": {
            "id": "711160607",
            "speakerId": 21298,
            "speakerName": "铁明",
            "text": "既然这样，那我必须得要好好感谢两位豪侠了。",
            "nextDialogs": [
              "711160608"
            ]
          },
          "711160608": {
            "id": "711160608",
            "speakerId": 21298,
            "speakerName": "铁明",
            "text": "来人！把他们绑好咯，丢去海里！",
            "nextDialogs": [
              "711160609"
            ]
          },
          "711160609": {
            "id": "711160609",
            "speakerId": 21298,
            "speakerName": "铁明",
            "text": "记得多绑几块石头，这两位对我们铁盐帮有恩，别叫他们多遭了罪！",
            "nextDialogs": [
              "711160610"
            ]
          },
          "711160610": {
            "id": "711160610",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "什么？！你…你要对我们做什么？",
            "nextDialogs": [
              "711160611"
            ]
          },
          "711160611": {
            "id": "711160611",
            "speakerId": 21298,
            "speakerName": "铁明",
            "text": "这位小豪侠，你刚才不是还很明白吗？璃月是讲究契约的国度。",
            "nextDialogs": [
              "711160612"
            ]
          },
          "711160612": {
            "id": "711160612",
            "speakerId": 21298,
            "speakerName": "铁明",
            "text": "撞破了非法团伙的交易，自然就会被灭口，这不是人尽皆知的契约吗？",
            "nextDialogs": [
              "711160613"
            ]
          },
          "711160613": {
            "id": "711160613",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "哪有这种契约啊！你这种恩将仇报才是不讲契约！！",
            "nextDialogs": [
              "711160614"
            ]
          },
          "711160614": {
            "id": "711160614",
            "speakerId": 21298,
            "speakerName": "铁明",
            "text": "不要白白浪费我的好意，等我亲自动手，你们就有苦头吃了。",
            "nextDialogs": [
              "711160617"
            ]
          },
          "711160617": {
            "id": "711160617",
            "speakerId": 21298,
            "speakerName": "铁明",
            "text": "少废话！铁豆儿！铁船儿！还不动手？！",
            "nextDialogs": [
              "711160618"
            ]
          },
          "711160618": {
            "id": "711160618",
            "speakerId": 21362,
            "speakerName": "铁船儿",
            "text": "铁明老大，你果然还是这么不仁不义啊。",
            "nextDialogs": [
              "711160619"
            ]
          },
          "711160619": {
            "id": "711160619",
            "speakerId": 21297,
            "speakerName": "铁豆儿",
            "text": "也不枉我们费一番功夫，绝对不能再放你这样的人在璃月为非作歹了。",
            "nextDialogs": [
              "711160626"
            ]
          },
          "711160626": {
            "id": "711160626",
            "speakerId": 21297,
            "speakerName": "铁豆儿",
            "text": "收网！",
            "nextDialogs": [
              "711160620"
            ]
          },
          "711160620": {
            "id": "711160620",
            "speakerId": 21298,
            "speakerName": "铁明",
            "text": "什…什么？",
            "nextDialogs": [
              "711160621"
            ]
          },
          "711160621": {
            "id": "711160621",
            "speakerId": 21297,
            "speakerName": "铁豆儿",
            "text": "贼人铁明！睁大你的眼睛再好好看看！我们是谁？！",
            "nextDialogs": [
              "711160622"
            ]
          },
          "711160622": {
            "id": "711160622",
            "speakerId": 21298,
            "speakerName": "铁明",
            "text": "千…千岩军？！",
            "nextDialogs": [
              "711160623"
            ]
          },
          "711160623": {
            "id": "711160623",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "喂喂！怎么回事？！怎么突然…",
            "nextDialogs": [
              "711160624"
            ]
          },
          "711160624": {
            "id": "711160624",
            "speakerId": 21298,
            "speakerName": "铁明",
            "text": "我只当你们几个是新上了跳板，没想到是该死的鹰爪孙…",
            "nextDialogs": [
              "711160625"
            ]
          },
          "711160625": {
            "id": "711160625",
            "speakerId": 21298,
            "speakerName": "铁明",
            "text": "别以为我会束手就擒！我跟你们拼了！"
          }
        }
      }
    },
    {
      "subId": "7111607",
      "subQuestName": "击败铁明",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [],
        "dialogs": {}
      }
    },
    {
      "subId": "7111608",
      "subQuestName": "与千岩军交谈",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "711160801"
        ],
        "dialogs": {
          "711160801": {
            "id": "711160801",
            "speakerId": 21362,
            "speakerName": "铁船儿",
            "text": "真是不虚此行！没想到这次行动既抓到了人，还遇见了大名鼎鼎的旅行者。",
            "nextDialogs": [
              "711160802"
            ]
          },
          "711160802": {
            "id": "711160802",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "你们认识我们啊？",
            "nextDialogs": [
              "711160803"
            ]
          },
          "711160803": {
            "id": "711160803",
            "speakerId": 21297,
            "speakerName": "铁豆儿",
            "text": "那当然，旅行者，我有亲戚住在璃月港，你们的事我都听了好多遍呢，所以前面一早就认出你们了。",
            "nextDialogs": [
              "711160804"
            ]
          },
          "711160804": {
            "id": "711160804",
            "speakerId": 21297,
            "speakerName": "铁豆儿",
            "text": "只不过那时候人多口杂，我怕走漏风声，让这伙人跑了。所以没有明说，真是不好意思啦。",
            "nextDialogs": [
              "711160805"
            ]
          },
          "711160805": {
            "id": "711160805",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "原来我们不是撞上了非法团伙的交易，而是撞上了千岩军抓坏蛋的行动啊！",
            "nextDialogs": [
              "711160806"
            ]
          },
          "711160806": {
            "id": "711160806",
            "speakerId": 21362,
            "speakerName": "铁船儿",
            "text": "哈哈，没错，我们盯上这伙私自贩盐的家伙有一阵子了，前阵子恰好得到帮助，才成功打入了内部。",
            "nextDialogs": [
              "711160807"
            ]
          },
          "711160807": {
            "id": "711160807",
            "speakerId": 21362,
            "speakerName": "铁船儿",
            "text": "差不多等了一个多月呢，今天终于等到机会，把这伙铁盐帮和枫丹那边的大鱼一网捞上来。",
            "nextDialogs": [
              "711160808"
            ]
          },
          "711160808": {
            "id": "711160808",
            "speakerId": 21297,
            "speakerName": "铁豆儿",
            "text": "别说了，前面差点还被大鱼拖下了水，那伙人下手真黑，多亏了旅行者来帮忙。",
            "nextDialogs": [
              "711160809"
            ]
          },
          "711160809": {
            "id": "711160809",
            "speakerId": 21297,
            "speakerName": "铁豆儿",
            "text": "总而言之，旅行者，前面答应你们吃香的喝辣的，可能没法兑现了，但是这里有一些摩拉，请你们收好。",
            "nextDialogs": [
              "711160810"
            ]
          },
          "711160810": {
            "id": "711160810",
            "speakerId": 21297,
            "speakerName": "铁豆儿",
            "text": "不用推脱哦，两位。帮助别人就该得到回报，大家都要遵守这条契约才行。否则未来愿意伸出援手的人会越来越少。",
            "nextDialogs": [
              "711160811"
            ]
          },
          "711160811": {
            "id": "711160811",
            "speakerId": 21362,
            "speakerName": "铁船儿",
            "text": "好了，我们也该去处理剩下的事了，就不再耽误两位时间了。",
            "nextDialogs": [
              "711160812"
            ]
          },
          "711160812": {
            "id": "711160812",
            "speakerId": 21362,
            "speakerName": "铁船儿",
            "text": "祝你们前路顺利！"
          }
        }
      }
    },
    {
      "subId": "7111651",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "711165101"
        ],
        "dialogs": {
          "711165101": {
            "id": "711165101",
            "speakerId": 21297,
            "speakerName": "铁豆儿",
            "text": "芽儿们！给俺扒了这些皮娃子的衣裳！大通衫、小罗考，一件不留！"
          }
        }
      }
    },
    {
      "subId": "7111652",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "711165201"
        ],
        "dialogs": {
          "711165201": {
            "id": "711165201",
            "speakerId": 21362,
            "speakerName": "铁船儿",
            "text": "旅行者！你们也来了啊。",
            "nextDialogs": [
              "711165202"
            ]
          },
          "711165202": {
            "id": "711165202",
            "speakerId": 21297,
            "speakerName": "铁豆儿",
            "text": "你们放心吧，后事我们会处理好的，不会再让这些歹徒危害璃月了。"
          }
        }
      }
    },
    {
      "subId": "7111653",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "711165301"
        ],
        "dialogs": {
          "711165301": {
            "id": "711165301",
            "speakerId": 21364,
            "speakerName": "青夜",
            "text": "给我的这件好像不太合身啊…",
            "nextDialogs": [
              "711165302"
            ]
          },
          "711165302": {
            "id": "711165302",
            "speakerId": 21300,
            "speakerName": "红鱼",
            "text": "哪那么多事，我这件这么臭不是照样穿了？",
            "nextDialogs": [
              "711165303"
            ]
          },
          "711165303": {
            "id": "711165303",
            "speakerId": 21300,
            "speakerName": "红鱼",
            "text": "赶紧的！这些盗宝团的衣服没你想的那么好弄，别挑三拣四了。"
          }
        }
      }
    },
    {
      "subId": "7111654",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "711165401"
        ],
        "dialogs": {
          "711165401": {
            "id": "711165401",
            "speakerId": 2251,
            "speakerName": "凌霄",
            "text": "最近此地不太平，往来旅客请绕行。",
            "nextDialogs": [
              "711165402"
            ]
          },
          "711165402": {
            "id": "711165402",
            "speakerId": -1,
            "speakerName": "Player",

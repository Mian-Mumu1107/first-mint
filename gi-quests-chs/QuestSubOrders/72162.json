    {
      "subId": "7216226",
      "subQuestName": "与藤原俊子对话",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "721621301"
        ],
        "dialogs": {
          "721621301": {
            "id": "721621301",
            "speakerId": 1000,
            "speakerName": "藤原俊子",
            "text": "呼…总算是到了，你们稍等一下，我去准备报酬。",
            "nextDialogs": [
              "721621302"
            ]
          },
          "721621302": {
            "id": "721621302",
            "speakerId": 1000,
            "speakerName": "藤原俊子",
            "text": "好了。这些东西请你们收下吧，虽然不多…但也算是我的一点心意。",
            "nextDialogs": [
              "721621303"
            ]
          },
          "721621303": {
            "id": "721621303",
            "speakerId": 1000,
            "speakerName": "藤原俊子",
            "text": "这次的寻宝行动真是乱七八糟，而且还就拿到了一幅画。",
            "nextDialogs": [
              "721621304"
            ]
          },
          "721621304": {
            "id": "721621304",
            "speakerId": 1000,
            "speakerName": "藤原俊子",
            "text": "唉，为什么我家的祖先，会专门为一张画设计那么多机关呢？",
            "nextDialogs": [
              "721621305"
            ]
          },
          "721621305": {
            "id": "721621305",
            "speakerId": 1000,
            "speakerName": "藤原俊子",
            "text": "完全搞不明白…我还是带着这幅画，回去稻妻城里找人问问看吧。",
            "nextDialogs": [
              "721621306"
            ]
          },
          "721621306": {
            "id": "721621306",
            "speakerId": 1000,
            "speakerName": "藤原俊子",
            "text": "唔，不如…直接去问问太田太郎先生吧…"
          }
        }
      }
    },

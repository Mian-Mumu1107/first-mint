    {
      "subId": "7216203",
      "subQuestName": "启动开关",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "721620301"
        ],
        "dialogs": {
          "721620301": {
            "id": "721620301",
            "speakerId": 1000,
            "speakerName": "藤原俊子",
            "text": "这座机关…好像和我们进来的时候解开的那座机关是同一类型。",
            "nextDialogs": [
              "721620302"
            ]
          },
          "721620302": {
            "id": "721620302",
            "speakerId": 1000,
            "speakerName": "藤原俊子",
            "text": "不过，好像复杂了不少…",
            "nextDialogs": [
              "721620303"
            ]
          },
          "721620303": {
            "id": "721620303",
            "speakerId": 1000,
            "speakerName": "藤原俊子",
            "text": "但是没关系！我祖上的那张图上一定有解开这座机关的线索！"
          }
        }
      }
    },
    {
      "subId": "7216205",
      "subQuestName": "查看并启动机关",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "721620501"
        ],
        "dialogs": {
          "721620501": {
            "id": "721620501",
            "speakerId": 1000,
            "speakerName": "藤原俊子",
            "text": "营地就在不远，走一会就到了，我们出发吧。"
          }
        }
      }
    },
    {
      "subId": "7216204",
      "subQuestName": "与藤原俊子对话",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "721629902"
        ],
        "dialogs": {
          "721629902": {
            "id": "721629902",
            "speakerId": 1000,
            "speakerName": "藤原俊子",
            "text": "突、突然响起了什么声音…",
            "nextDialogs": [
              "721629903"
            ]
          },
          "721629903": {
            "id": "721629903",
            "speakerId": 1000,
            "speakerName": "藤原俊子",
            "text": "看那边！那边…怎么突然出现了一个大洞？",
            "nextDialogs": [
              "721629904"
            ]
          },
          "721629904": {
            "id": "721629904",
            "speakerId": 1000,
            "speakerName": "藤原俊子",
            "text": "底下…好像是一个地下室，我们进去看看吧！快！"
          }
        }
      }
    },
    {
      "subId": "7216206",
      "subQuestName": "进入地下室",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "721620601"
        ],
        "dialogs": {
          "721620601": {
            "id": "721620601",
            "speakerId": 1000,
            "speakerName": "藤原俊子",
            "text": "唉，这回真是…",
            "nextDialogs": [
              "721620602"
            ]
          },
          "721620602": {
            "id": "721620602",
            "speakerId": 1002,
            "speakerName": "盗宝团",
            "text": "真是大发横财了？",
            "nextDialogs": [
              "721620603"
            ]
          },
          "721620603": {
            "id": "721620603",
            "speakerId": 1000,
            "speakerName": "藤原俊子",
            "text": "你、你们…",
            "nextDialogs": [
              "721620604"
            ]
          },
          "721620604": {
            "id": "721620604",
            "speakerId": 1002,
            "speakerName": "盗宝团",
            "text": "嘿嘿…少废话，把宝贝交出来！兄弟们跟着你这么久，可不能白跑一趟！",
            "nextDialogs": [
              "721620605"
            ]
          },
          "721620605": {
            "id": "721620605",
            "speakerId": 1000,
            "speakerName": "藤原俊子",
            "text": "什么？等一下！我就只找到了一幅画！",
            "nextDialogs": [
              "721620606"
            ]
          },
          "721620606": {
            "id": "721620606",
            "speakerId": 1002,
            "speakerName": "盗宝团",
            "text": "一幅画？那也得给我交出来！兄弟们，上！",
            "nextDialogs": [
              "721620607"
            ]
          },
          "721620607": {
            "id": "721620607",
            "speakerId": 1000,
            "speakerName": "藤原俊子",
            "text": "救、救命啊！旅行者！"
          }
        }
      }
    },
    {

    {
      "subId": "7216210",
      "subQuestName": "启动开关",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "721621001"
        ],
        "dialogs": {
          "721621001": {
            "id": "721621001",
            "speakerId": 1000,
            "speakerName": "藤原俊子",
            "text": "唉，真是不知道…",
            "nextDialogs": [
              "721621002"
            ]
          },
          "721621002": {
            "id": "721621002",
            "speakerId": 1003,
            "speakerName": "愚人众",
            "text": "把那幅画，拿出来吧。",
            "nextDialogs": [
              "721621003"
            ]
          },
          "721621003": {
            "id": "721621003",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "愚人众？！他、他们来这里做什么？！",
            "nextDialogs": [
              "721621004"
            ]
          },
          "721621004": {
            "id": "721621004",
            "speakerId": 1000,
            "speakerName": "藤原俊子",
            "text": "那就是一幅普通的画而已啦！你们要就给你们好了！给你们啦！",
            "nextDialogs": [
              "721621005"
            ]
          },
          "721621005": {
            "id": "721621005",
            "speakerId": 1003,
            "speakerName": "愚人众",
            "text": "还有其余的东西，也一并拿出来！",
            "nextDialogs": [
              "721621006"
            ]
          },
          "721621006": {
            "id": "721621006",
            "speakerId": 1000,
            "speakerName": "藤原俊子",
            "text": "其余的？没有其余的东西了！我就只找到这一幅画而已啊！",
            "nextDialogs": [
              "721621007"
            ]
          },
          "721621007": {
            "id": "721621007",
            "speakerId": 1003,
            "speakerName": "愚人众",
            "text": "哼，只有一幅画…还能用那么复杂的机关保护着的？",
            "nextDialogs": [
              "721621008"
            ]
          },
          "721621008": {
            "id": "721621008",
            "speakerId": 1003,
            "speakerName": "愚人众",
            "text": "要不是发现了那群野武士的踪迹，我们还发现不了那个地下室。",
            "nextDialogs": [
              "721621009"
            ]
          },
          "721621009": {
            "id": "721621009",
            "speakerId": 1003,
            "speakerName": "愚人众",
            "text": "等了这么久，总归要有点收获才行…上！",
            "nextDialogs": [
              "721621010"
            ]
          },
          "721621010": {
            "id": "721621010",
            "speakerId": 1000,
            "speakerName": "藤原俊子",
            "text": "我…我真是…旅行者！救命啊！"
          }
        }
      }
    },
    {
      "subId": "7216207",
      "subQuestName": "启动机关",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "721620701"
        ],
        "dialogs": {
          "721620701": {
            "id": "721620701",
            "speakerId": 1000,
            "speakerName": "藤原俊子",
            "text": "这帮盗宝团到底是什么时候盯上我的…",
            "nextDialogs": [
              "721620702"
            ]
          },
          "721620702": {
            "id": "721620702",
            "speakerId": 1000,
            "speakerName": "藤原俊子",
            "text": "谢谢你，旅行者，我们快点回营地吧。"
          }
        }
      }
    },
    {
      "subId": "7216208",
      "subQuestName": "再次启动机关",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "721620801"
        ],
        "dialogs": {
          "721620801": {
            "id": "721620801",
            "speakerId": 1000,
            "speakerName": "藤原俊子",
            "text": "唉，真是没想…",
            "nextDialogs": [
              "721620802"
            ]
          },
          "721620802": {
            "id": "721620802",
            "speakerId": 1004,
            "speakerName": "野武士",
            "text": "还请各位，稍微留步。",
            "nextDialogs": [
              "721620803"
            ]
          },
          "721620803": {
            "id": "721620803",
            "speakerId": 1004,
            "speakerName": "野武士",
            "text": "能劳烦你们，把刚刚找到的宝物拿出来吗？",
            "nextDialogs": [
              "721620804"
            ]
          },
          "721620804": {
            "id": "721620804",
            "speakerId": 1000,
            "speakerName": "藤原俊子",
            "text": "什么…",
            "nextDialogs": [
              "721620805"
            ]
          },
          "721620805": {
            "id": "721620805",
            "speakerId": 1004,
            "speakerName": "野武士",
            "text": "刚才你们不是为了保护宝物，连盗宝团都击退了吗？",
            "nextDialogs": [
              "721620806"
            ]
          },
          "721620806": {
            "id": "721620806",
            "speakerId": 1004,
            "speakerName": "野武士",
            "text": "想必，肯定是找到了什么贵重的宝物吧。",
            "nextDialogs": [
              "721620807"
            ]
          },
          "721620807": {
            "id": "721620807",
            "speakerId": 1000,
            "speakerName": "藤原俊子",
            "text": "都说了只有一幅画啊！",
            "nextDialogs": [
              "721620808"
            ]
          },
          "721620808": {
            "id": "721620808",
            "speakerId": 1004,
            "speakerName": "野武士",
            "text": "看来是说不通了…但我们也不能白跟着那群盗宝团这么久，动手！",
            "nextDialogs": [
              "721620809"
            ]
          },
          "721620809": {
            "id": "721620809",
            "speakerId": 1000,
            "speakerName": "藤原俊子",
            "text": "你们给我好好听人说话啊！旅行者！救命啊！"
          }
        }
      }
    },
    {
      "subId": "7216209",
      "subQuestName": "等待藤原俊子开启宝箱",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "721620901"
        ],
        "dialogs": {
          "721620901": {
            "id": "721620901",
            "speakerId": 1000,
            "speakerName": "藤原俊子",
            "text": "这帮人怎么这么不讲道理啊！都说了我只找到一幅画了啊！",
            "nextDialogs": [
              "721620902"
            ]
          },
          "721620902": {
            "id": "721620902",
            "speakerId": 1000,
            "speakerName": "藤原俊子",
            "text": "我们继续走吧，必须快点回营地去…"
          }
        }
      }
    },
    {
      "subId": "7216219",
      "subQuestName": "与藤原俊子对话",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "721620401"
        ],
        "dialogs": {
          "721620401": {
            "id": "721620401",
            "speakerId": 1000,
            "speakerName": "藤原俊子",
            "text": "这里面…怎么只有这个…",
            "nextDialogs": [
              "721620402"
            ]
          },
          "721620402": {
            "id": "721620402",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "怎么了？",
            "nextDialogs": [
              "721620403"
            ]
          },
          "721620403": {
            "id": "721620403",
            "speakerId": 1000,
            "speakerName": "藤原俊子",
            "text": "那个箱子里只装着这一幅画。",
            "nextDialogs": [
              "721620404"
            ]
          },
          "721620404": {
            "id": "721620404",
            "speakerId": 1000,
            "speakerName": "藤原俊子",
            "text": "这个就是宝藏吗？真是莫名其妙。",
            "nextDialogs": [
              "721620405"
            ]
          },
          "721620405": {
            "id": "721620405",
            "speakerId": 1000,
            "speakerName": "藤原俊子",
            "text": "唉，只找到了这一幅画，也没办法分给你…",
            "nextDialogs": [
              "721620406"
            ]
          },
          "721620406": {
            "id": "721620406",
            "speakerId": 1000,
            "speakerName": "藤原俊子",
            "text": "这样吧，你们跟我来，我们先回我的营地去。",
            "nextDialogs": [
              "721620407"
            ]
          },
          "721620407": {
            "id": "721620407",
            "speakerId": 1000,
            "speakerName": "藤原俊子",
            "text": "去了那里之后，我再把报酬给你们。",
            "nextDialogs": [
              "721620408"
            ]
          },
          "721620408": {
            "id": "721620408",
            "speakerId": 1000,
            "speakerName": "藤原俊子",
            "text": "行了，我们快点出发吧。",
            "nextDialogs": [
              "721620409"
            ]
          },
          "721620409": {
            "id": "721620409",
            "speakerId": 1000,
            "speakerName": "藤原俊子",
            "text": "就一幅画，真奇怪…"
          }
        }
      }
    },
    {
      "subId": "7216211",
      "subQuestName": "跟上藤原俊子",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "721621101"
        ],
        "dialogs": {
          "721621101": {
            "id": "721621101",
            "speakerId": 1000,
            "speakerName": "藤原俊子",
            "text": "为、为什么所有人都不相信我只拿到了这一幅画，呜…",
            "nextDialogs": [
              "721621102"
            ]
          },
          "721621102": {
            "id": "721621102",
            "speakerId": 1000,
            "speakerName": "藤原俊子",
            "text": "就算是抢劫…也要好好听人讲话吧！",
            "nextDialogs": [
              "721621103"
            ]
          },
          "721621103": {
            "id": "721621103",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "我们还是快走吧…",
            "nextDialogs": [
              "721621104"
            ]
          },
          "721621104": {
            "id": "721621104",
            "speakerId": 1000,
            "speakerName": "藤原俊子",
            "text": "呜呜呜…好、好…我们快点回营地吧，我真是受不了了…"
          }
        }
      }
    },
    {
      "subId": "7216212",
      "subQuestName": "跟随藤原俊子前往营地",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "721621201"
        ],
        "dialogs": {
          "721621201": {
            "id": "721621201",
            "speakerId": 1005,
            "speakerName": "？？？",
            "text": "喵！",
            "nextDialogs": [
              "721621202"
            ]
          },
          "721621202": {
            "id": "721621202",
            "speakerId": 1000,
            "speakerName": "藤原俊子",
            "text": "呜哇！又是谁啊！我真的只拿到了这一幅画而已！",
            "nextDialogs": [
              "721621203"
            ]
          },
          "721621203": {
            "id": "721621203",
            "speakerId": 1000,
            "speakerName": "藤原俊子",
            "text": "对不起！对不起！我以后绝对不会再来寻宝了！",
            "nextDialogs": [

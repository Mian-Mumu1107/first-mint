    {
      "subId": "7216201",
      "subQuestName": "解救被魔物围困的人",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "721620101"
        ],
        "dialogs": {
          "721620101": {
            "id": "721620101",
            "speakerId": 1000,
            "speakerName": "藤原俊子",
            "text": "谢、谢谢你们，呼…这些家伙居然趁我不注意偷袭我…",
            "nextDialogs": [
              "721620104"
            ]
          },
          "721620104": {
            "id": "721620104",
            "speakerId": 1000,
            "speakerName": "藤原俊子",
            "text": "我叫藤原俊子，正在这里…嗯…",
            "nextDialogs": [
              "721620105"
            ]
          },
          "721620105": {
            "id": "721620105",
            "speakerId": 1000,
            "speakerName": "藤原俊子",
            "text": "算了，你们救了我…我就告诉你们吧。",
            "nextDialogs": [
              "721620106"
            ]
          },
          "721620106": {
            "id": "721620106",
            "speakerId": 1000,
            "speakerName": "藤原俊子",
            "text": "其实，我正在这里寻找我祖上留下来的宝藏！",
            "nextDialogs": [
              "721620107"
            ]
          },
          "721620107": {
            "id": "721620107",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "宝、宝藏！",
            "nextDialogs": [
              "721620108"
            ]
          },
          "721620108": {
            "id": "721620108",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "你找到了吗？",
            "nextDialogs": [
              "721620109"
            ]
          },
          "721620109": {
            "id": "721620109",
            "speakerId": 1000,
            "speakerName": "藤原俊子",
            "text": "哈哈哈，那是当然，我顺着线索找到了宝藏所在地，也确定了进入的方法。",
            "nextDialogs": [
              "721620110"
            ]
          },
          "721620110": {
            "id": "721620110",
            "speakerId": 1000,
            "speakerName": "藤原俊子",
            "text": "但是…在我准备启动开关，进入藏宝地的时候，就被那群魔物偷袭了。",
            "nextDialogs": [
              "721620111"
            ]
          },
          "721620111": {
            "id": "721620111",
            "speakerId": 1000,
            "speakerName": "藤原俊子",
            "text": "多亏你们击退了那群魔物，谢谢你们。",
            "nextDialogs": [
              "721620112"
            ]
          },
          "721620112": {
            "id": "721620112",
            "speakerId": 1000,
            "speakerName": "藤原俊子",
            "text": "然后…那个，虽然有点不好意思…",
            "nextDialogs": [
              "721620113"
            ]
          },
          "721620113": {
            "id": "721620113",
            "speakerId": 1000,
            "speakerName": "藤原俊子",
            "text": "但是，能不能请你们接着保护我一段时间？",
            "nextDialogs": [
              "721620114"
            ]
          },
          "721620114": {
            "id": "721620114",
            "speakerId": 1000,
            "speakerName": "藤原俊子",
            "text": "我还得继续寻宝，这周围又有那么多魔物，我一个人肯定没法对付…",
            "nextDialogs": [
              "721620115"
            ]
          },
          "721620115": {
            "id": "721620115",
            "speakerId": 1000,
            "speakerName": "藤原俊子",
            "text": "如果你们愿意帮忙的话，我可以把…把宝藏分给你们一些！"
          }
        }
      }
    },

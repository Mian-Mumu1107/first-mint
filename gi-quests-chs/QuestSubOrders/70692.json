{
  "lineCounts": {
    "Player": 4,
    "「狂图捕手」": 4,
    "派蒙": 4,
    "米卡": 13
  },
  "subQuests": [
    {
      "subId": "7069201",
      "subQuestName": "与米卡对话",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "706920101"
        ],
        "dialogs": {
          "706920101": {
            "id": "706920101",
            "speakerId": 1000,
            "speakerName": "「狂图捕手」",
            "text": "哇哇，骑士小哥，你把我们的大英雄引过来了！",
            "nextDialogs": [
              "706920102"
            ]
          },
          "706920102": {
            "id": "706920102",
            "speakerId": 1001,
            "speakerName": "米卡",
            "text": "是荣誉骑士前辈，还有白色小帮手！你们好！",
            "nextDialogs": [
              "706920103"
            ]
          },
          "706920103": {
            "id": "706920103",
            "speakerId": 1002,
            "speakerName": "派蒙",
            "text": "米卡和…纳塔的朋友？你们在忙什么呢？",
            "nextDialogs": [
              "706920104"
            ]
          },
          "706920104": {
            "id": "706920104",
            "speakerId": 1001,
            "speakerName": "米卡",
            "text": "我们正在推广一种对冒险家团体很有帮助的「前哨龙龙」。",
            "nextDialogs": [
              "706920105"
            ]
          },
          "706920105": {
            "id": "706920105",
            "speakerId": 1001,
            "speakerName": "米卡",
            "text": "它结合了安柏前辈从须弥带回来的「侦察伙伴」机关核心，还有纳塔朋友们送我的小龙玩偶外形…",
            "nextDialogs": [
              "706920106"
            ]
          },
          "706920106": {
            "id": "706920106",
            "speakerId": 1002,
            "speakerName": "派蒙",
            "text": "伙伴机关…哦哦，我还有印象！",
            "nextDialogs": [
              "706920107"
            ]
          },
          "706920107": {
            "id": "706920107",
            "speakerId": 1001,
            "speakerName": "米卡",
            "text": "与须弥的「侦察伙伴」的功能类似，「前哨龙龙」可以帮忙侦察魔物，勘测地形。",
            "nextDialogs": [
              "706920108"
            ]
          },
          "706920108": {
            "id": "706920108",
            "speakerId": 1001,
            "speakerName": "米卡",
            "text": "不过，由于重点放在后者，它更侧重行动的可控性和精准度…",
            "nextDialogs": [
              "706920109"
            ]
          },
          "706920109": {
            "id": "706920109",
            "speakerId": 1001,
            "speakerName": "米卡",
            "text": "…荣誉骑士前辈有兴趣试飞一下吗？",
            "nextDialogs": [
              "706920112"
            ]
          },
          "706920112": {
            "id": "706920112",
            "speakerId": 1001,
            "speakerName": "米卡",
            "text": "欸？是…是我太紧张了吗？",
            "nextDialogs": [
              "706920113"
            ]
          },
          "706920113": {
            "id": "706920113",
            "speakerId": 1001,
            "speakerName": "米卡",
            "text": "好像的确…明明之前基本放松下来，可以比较自然地面对你了。",
            "nextDialogs": [
              "706920114"
            ]
          },
          "706920114": {
            "id": "706920114",
            "speakerId": 1001,
            "speakerName": "米卡",
            "text": "但最近从不少其他国家的朋友那里听说了你的事迹，感觉你越来越厉害，越来越了不起了…",
            "nextDialogs": [
              "706920115"
            ]
          },
          "706920115": {
            "id": "706920115",
            "speakerId": 1001,
            "speakerName": "米卡",
            "text": "一想到以后要帮上你的忙，不能拖你的后腿，下意识又绷紧了弦。",
            "nextDialogs": [
              "706920116"
            ]
          },
          "706920116": {
            "id": "706920116",
            "speakerId": 1002,
            "speakerName": "派蒙",
            "text": "还真是米卡特有的逻辑…",
            "nextDialogs": [
              "706920117"
            ]
          },
          "706920117": {
            "id": "706920117",
            "speakerId": 1000,
            "speakerName": "「狂图捕手」",
            "text": "已经很不错了，骑士小哥！",
            "nextDialogs": [
              "706920118"
            ]
          },
          "706920118": {
            "id": "706920118",
            "speakerId": 1000,
            "speakerName": "「狂图捕手」",
            "text": "#在纳塔啊，部族里的战士要是碰见了{NICKNAME}，有的会激动到语无伦次，有的还会半个字都说不出来！",
            "nextDialogs": [
              "706920119"
            ]
          },
          "706920119": {
            "id": "706920119",
            "speakerId": 1000,
            "speakerName": "「狂图捕手」",
            "text": "#你作为{NICKNAME}的同事，也能算得上传奇级高手，和我们的部族首领对话都不必虚！",
            "nextDialogs": [
              "706920120"
            ]
          },
          "706920120": {
            "id": "706920120",
            "speakerId": 1002,
            "speakerName": "派蒙",
            "text": "没错没错，米卡要自信点！",
            "nextDialogs": [
              "706920121"
            ]
          },
          "706920121": {
            "id": "706920121",
            "speakerId": 1001,
            "speakerName": "米卡",
            "text": "原来还有这种事…这样的思考角度，我完全没想过…",
            "nextDialogs": [
              "706920122"
            ]
          },
          "706920122": {
            "id": "706920122",
            "speakerId": 1001,
            "speakerName": "米卡",
            "text": "#总之，如果{NICKNAME}试飞过「前哨龙龙」后感到满意，这个可爱又可靠的辅助机关，肯定能造福更多冒险家团体！"
          }
        }
      }
    }
  ]
}
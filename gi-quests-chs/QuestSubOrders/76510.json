              "765100106"
            ]
          },
          "765100106": {
            "id": "765100106",
            "speakerId": 30956,
            "speakerName": "埃德勒",
            "text": "唉，真不知道你哪来的执念？不会是因为上次随随便便被我打翻了吧！如果是这个原因，那就切磋。",
            "nextDialogs": [
              "765100107"
            ]
          },
          "765100107": {
            "id": "765100107",
            "speakerId": 30956,
            "speakerName": "埃德勒",

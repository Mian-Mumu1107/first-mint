        ],
        "dialogs": {
          "745280401": {
            "id": "745280401",
            "speakerId": 1000,
            "speakerName": "丝柯克",
            "text": "是你啊。我们的旅途，又交汇到了一起。",
            "nextDialogs": [
              "745280404"
            ]
          },
          "745280404": {
            "id": "745280404",
            "speakerId": 1000,
            "speakerName": "丝柯克",
            "text": "我在观察这个世界留下的「伤疤」。那次爆炸将这里夷为废墟…",
            "nextDialogs": [
              "745280405"
            ]
          },
          "745280405": {
            "id": "745280405",
            "speakerId": 1000,
            "speakerName": "丝柯克",
            "text": "但如今，人们又在废墟之上建起了新的东西。",
            "nextDialogs": [
              "745280406"
            ]
          },
          "745280406": {
            "id": "745280406",
            "speakerId": 1000,
            "speakerName": "丝柯克",
            "text": "万物皆有终点，但凋亡之后，亦会孕育新的可能。",
            "nextDialogs": [
              "745280407"
            ]
          },
          "745280407": {
            "id": "745280407",
            "speakerId": 1000,
            "speakerName": "丝柯克",
            "text": "你的力量比上次见面时又成长了些。看来你没有懈怠锻炼。不错。"
          }
        }
      }
    }
  ]

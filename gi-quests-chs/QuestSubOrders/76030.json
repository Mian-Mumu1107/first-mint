            ]
          },
          "760309908": {
            "id": "760309908",
            "speakerId": 1001,
            "speakerName": "「少女」",
            "text": "那边往右一些。",
            "nextDialogs": [
              "760309909"
            ]
          },
          "760309909": {
            "id": "760309909",
            "speakerId": 1001,
            "speakerName": "「少女」",
            "text": "嗯，不错。"

  "subQuests": [
    {
      "subId": "7603001",
      "subQuestName": "同「少女」见面",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "760300101"
        ],
        "dialogs": {
          "760300101": {
            "id": "760300101",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "哦~今天这里的氛围有些不寻常嘛，哥伦比娅你在装点这处花田吗？",
            "nextDialogs": [
              "760300102"
            ]
          },
          "760300102": {
            "id": "760300102",
            "speakerId": 1001,
            "speakerName": "「少女」",
            "text": "不是我，是它们。",
            "nextDialogs": [
              "760300103"
            ]
          },
          "760300103": {
            "id": "760300103",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "它们…月灵？",
            "nextDialogs": [
              "760300104"
            ]
          },
          "760300104": {
            "id": "760300104",
            "speakerId": 1001,
            "speakerName": "「少女」",
            "text": "这种石头在吸收了月矩力之后会泛出微光，月灵们很喜欢。",
            "nextDialogs": [
              "760300105"
            ]
          },
          "760300105": {
            "id": "760300105",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "所以它们就…把石头放在地上玩？",
            "nextDialogs": [
              "760300106"
            ]
          },
          "760300106": {
            "id": "760300106",
            "speakerId": 1001,
            "speakerName": "「少女」",
            "text": "你们到这里来。",
            "nextDialogs": [
              "760300107"
            ]
          },
          "760300107": {
            "id": "760300107",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "嗯？",
            "nextDialogs": [
              "760300108"
            ]
          },
          "760300108": {
            "id": "760300108",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "哦！原来从高处看的话是一幅画欸！",
            "nextDialogs": [
              "760300109"
            ]
          },
          "760300109": {
            "id": "760300109",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "但好像缺了一块…",
            "nextDialogs": [
              "760300110"
            ]
          },
          "760300110": {
            "id": "760300110",
            "speakerId": 1001,
            "speakerName": "「少女」",
            "text": "有些不够了，我去采一点吧。",
            "nextDialogs": [
              "760300111"
            ]
          },
          "760300111": {
            "id": "760300111",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "咦？你要出去采？",
            "nextDialogs": [
              "760300112"
            ]
          },
          "760300112": {
            "id": "760300112",
            "speakerId": 1001,
            "speakerName": "「少女」",
            "text": "我知道一处不错的地方，那里月光照拂，有很多这样的石头。",
            "nextDialogs": [
              "760300113"
            ]
          },
          "760300113": {
            "id": "760300113",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "要我们陪你吗？",
            "nextDialogs": [
              "760300114"
            ]
          },
          "760300114": {
            "id": "760300114",
            "speakerId": 1001,
            "speakerName": "「少女」",
            "text": "好啊。",
            "nextDialogs": [
              "760300115"
            ]
          },
          "760300115": {
            "id": "760300115",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "嗯，那就多采一些吧，我们也想看看完整的画呢。"
          }
        }
      }
    },

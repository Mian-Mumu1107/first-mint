    {
      "subId": "7603003",
      "subQuestName": "同「少女」对话",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "760300301"
        ],
        "dialogs": {
          "760300301": {
            "id": "760300301",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "这样就够了吧。总觉得已经采了好多好多。",
            "nextDialogs": [
              "760300302"
            ]
          },
          "760300302": {
            "id": "760300302",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "我们回去吧，也不能老让那画缺一块。",
            "nextDialogs": [
              "760300303"
            ]
          },
          "760300303": {
            "id": "760300303",
            "speakerId": 1002,
            "speakerName": "莉洁卡",
            "text": "呜呜…呜呜…",
            "nextDialogs": [
              "760300304"
            ]
          },
          "760300304": {
            "id": "760300304",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "呀！有人过来了，先躲起来！",
            "nextDialogs": [
              "760300305"
            ]
          },
          "760300305": {
            "id": "760300305",
            "speakerId": 1002,
            "speakerName": "莉洁卡",
            "text": "呜呜…这里是哪里呀…妈妈…我想回家…",
            "nextDialogs": [
              "760300306"
            ]
          },
          "760300306": {
            "id": "760300306",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "看起来是「霜月之子」的人欸，她迷路了吗？",
            "nextDialogs": [
              "760300307"
            ]
          },
          "760300307": {
            "id": "760300307",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "我去帮帮她吧…",
            "nextDialogs": [
              "760300308"
            ]
          },
          "760300308": {
            "id": "760300308",
            "speakerId": 1001,
            "speakerName": "「少女」",
            "text": "真的吗？",
            "nextDialogs": [
              "760300309"
            ]
          },
          "760300309": {
            "id": "760300309",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "啊？这怎么看都得帮吧！",
            "nextDialogs": [
              "760300310"
            ]
          },
          "760300310": {
            "id": "760300310",
            "speakerId": 1001,
            "speakerName": "「少女」",
            "text": "我记得「霜月之子」对「外来者」很戒备。这么晚了，你头上没有角冠，如果她反倒被吓跑…",
            "nextDialogs": [
              "760300311"
            ]
          },
          "760300311": {
            "id": "760300311",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "你…你说得倒的确有可能，但也不能就这么不管吧！",
            "nextDialogs": [
              "760300312"
            ]
          },
          "760300312": {
            "id": "760300312",
            "speakerId": 1001,
            "speakerName": "「少女」",
            "text": "唔…跟我来。",
            "nextDialogs": [
              "760300313"
            ]
          },
          "760300313": {
            "id": "760300313",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "欸？"
          }
        }
      }
    },

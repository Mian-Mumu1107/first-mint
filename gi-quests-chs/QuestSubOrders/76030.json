    {
      "subId": "7603005",
      "subQuestName": "同「少女」对话",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "760300501"
        ],
        "dialogs": {
          "760300501": {
            "id": "760300501",
            "speakerId": 1002,
            "speakerName": "莉洁卡",
            "text": "呜呜…咦？这是…",
            "nextDialogs": [
              "760300502"
            ]
          },
          "760300502": {
            "id": "760300502",
            "speakerId": 1002,
            "speakerName": "莉洁卡",
            "text": "好漂亮…",
            "nextDialogs": [
              "760300503"
            ]
          },
          "760300503": {
            "id": "760300503",
            "speakerId": 1001,
            "speakerName": "「少女」",
            "text": "这样就好了。",
            "nextDialogs": [
              "760300504"
            ]
          },
          "760300504": {
            "id": "760300504",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "哦~她一路捡着石头回去了，那边是「霜月之坊」的方向呢。",
            "nextDialogs": [
              "760300505"
            ]
          },
          "760300505": {
            "id": "760300505",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "（哥伦比娅…虽说自己不想被当作「神明」，但还是会帮助遇到困难的人…）",
            "nextDialogs": [
              "760300506"
            ]
          },
          "760300506": {
            "id": "760300506",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "啊，但这么一来，那幅画是不是就…",
            "nextDialogs": [
              "760300507"
            ]
          },
          "760300507": {
            "id": "760300507",
            "speakerId": 1001,
            "speakerName": "「少女」",
            "text": "没关系。",
            "nextDialogs": [
              "760300508"
            ]
          },
          "760300508": {
            "id": "760300508",
            "speakerId": 1001,
            "speakerName": "「少女」",
            "text": "残缺的画可以之后再添上。",
            "nextDialogs": [
              "760300509"
            ]
          },
          "760300509": {
            "id": "760300509",
            "speakerId": 1001,
            "speakerName": "「少女」",
            "text": "我喜欢看人们找到「回家」的路，回到属于他们的「家」。"
          }
        }
      }
    },
    {
      "subId": "7603099",

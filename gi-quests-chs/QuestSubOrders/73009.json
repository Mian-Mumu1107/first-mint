{
  "lineCounts": {
    "Black Screen": 2,
    "Player": 15,
    "兰拉娜": 4,
    "兰拉迦": 32,
    "拉娜": 5
  },
  "subQuests": [
    {
      "subId": "7300901",
      "subQuestName": "",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "730090101"
        ],
        "dialogs": {
          "730090101": {
            "id": "730090101",
            "speakerId": 20597,
            "speakerName": "兰拉娜",
            "text": "兰拉娜会照顾她。因为她是最重要的朋友。",
            "nextDialogs": [
              "730090102"
            ]
          },
          "730090102": {
            "id": "730090102",
            "speakerId": 20597,
            "speakerName": "兰拉娜",
            "text": "#那菈{NICKNAME}，请你去「桓那兰那」，唱响「大梦的曲调」。然后，请他们帮忙准备「惟耶之实」。",
            "nextDialogs": [
              "730090106",
              "730090105"
            ]
          },
          "730090106": {
            "id": "730090106",
            "speakerId": 20597,
            "speakerName": "兰拉娜",
            "text": "就像云朵会明白要降下雨滴，雨水会明白要落入土地。种子会明白要茁壮成长，变成大树，结出饱满的果实。"
          },
          "730090105": {
            "id": "730090105",
            "speakerId": 20597,
            "speakerName": "兰拉娜",
            "text": "#那菈{NICKNAME}，看起来没有明白，但是没有关系。在正确的时候，那菈{NICKNAME}会明白应该做什么。"
          }
        }
      }
    },
    {
      "subId": "7300902",
      "subQuestName": "",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "730090201"
        ],
        "dialogs": {
          "730090201": {
            "id": "730090201",
            "speakerId": 16701,
            "speakerName": "拉娜",
            "text": "……"
          }
        }
      }
    },
    {
      "subId": "7300903",
      "subQuestName": "",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "730090301"
        ],
        "dialogs": {
          "730090301": {
            "id": "730090301",
            "speakerId": 16701,
            "speakerName": "拉娜",
            "text": "（拉娜依旧沉睡着。兰拉娜并不在周围。）",
            "nextDialogs": [
              "730090302"
            ]
          },
          "730090302": {
            "id": "730090302",
            "speakerId": 16701,
            "speakerName": "拉娜",
            "text": "（从包裹拉娜的「气泡」当中隐约有什么景象浮现出来…）",
            "nextDialogs": [
              "730090304"
            ]
          },
          "730090304": {
            "id": "730090304",
            "speakerId": 1002,
            "speakerName": "Black Screen",
            "text": "你身处丛林当中，一切都是无比巨大，又无比幽深。但你在其中十分自在。\\n偶然透过树叶洒落的阳光如同金箔一般闪闪发亮，如同你一般高的野草低声地嬉笑着，在你走过时轻轻触碰你的手。",
            "nextDialogs": [
              "730090305"
            ]
          },
          "730090305": {
            "id": "730090305",
            "speakerId": 1002,
            "speakerName": "Black Screen",
            "text": "聆听风中树木的哼唱与流水的奏乐时，你注意到了不安的哭声。循着声音，你找到了一个小小的人儿。\\n似乎是因为哭得累了，她趴在草甸中睡着了。你走到她的身边，轻轻唱起了能令生灵平静的歌…",
            "nextDialogs": [
              "730090306"
            ]
          },
          "730090306": {
            "id": "730090306",
            "speakerId": 16701,
            "speakerName": "拉娜",
            "text": "（…拉娜的状况似乎没有恶化。）"
          }
        }
      }
    },
    {
      "subId": "7300904",
      "subQuestName": "",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "730090401"
        ],
        "dialogs": {
          "730090401": {
            "id": "730090401",
            "speakerId": 16701,
            "speakerName": "拉娜",
            "text": "（拉娜依旧沉睡着。既然有兰拉娜的兰迦拉梨，应该没什么问题吧。）"
          }
        }
      }
    },
    {
      "subId": "7300905",
      "subQuestName": "",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "730090501"
        ],
        "dialogs": {
          "730090501": {
            "id": "730090501",
            "speakerId": 20648,
            "speakerName": "兰拉迦",
            "text": "#哦哦。是那菈{NICKNAME}。有什么事需要老身解答的吗？"
          }
        }
      }
    },
    {
      "subId": "7300906",
      "subQuestName": "",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "730090601"
        ],
        "dialogs": {
          "730090601": {
            "id": "730090601",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "有没有什么需要帮忙的？",
            "nextDialogs": [
              "730090602"
            ]
          },
          "730090602": {
            "id": "730090602",
            "speakerId": 20648,
            "speakerName": "兰拉迦",
            "text": "#哦哦，谢谢你，那菈{NICKNAME}。如你所见，老身相当自在。"
          }
        }
      }
    },
    {
      "subId": "7300907",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "730090701"
        ],
        "dialogs": {
          "730090701": {
            "id": "730090701",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "有没有为什么事情发愁的兰那罗？",
            "nextDialogs": [
              "730090702"
            ]
          },
          "730090702": {
            "id": "730090702",
            "speakerId": 20648,
            "speakerName": "兰拉迦",
            "text": "这个嘛…到桓那兰那的中心去，应该能遇到兰帕卡提。最近好像是在为什么事情发愁。"
          }
        }
      }
    },
    {
      "subId": "7300908",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "730090801"
        ],
        "dialogs": {
          "730090801": {
            "id": "730090801",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "要准备无忧节，还有什么要做的？",
            "nextDialogs": [
              "730090802"
            ]
          },
          "730090802": {
            "id": "730090802",
            "speakerId": 20648,
            "speakerName": "兰拉迦",
            "text": "说到这个，兰加惟应该在桓那兰那的中心。既然要办无忧节，他应该也有需要帮忙的事情。"
          }
        }
      }
    },
    {
      "subId": "7300909",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "730090901"
        ],
        "dialogs": {
          "730090901": {
            "id": "730090901",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "关于「无留陀」…",
            "nextDialogs": [
              "730090902"
            ]
          },
          "730090902": {
            "id": "730090902",
            "speakerId": 20648,
            "speakerName": "兰拉迦",
            "text": "那是很久以前的故事了…",
            "nextDialogs": [
              "730090903"
            ]
          },
          "730090903": {
            "id": "730090903",
            "speakerId": 20648,
            "speakerName": "兰拉迦",
            "text": "在过去，兰那罗行走在大地上，和那菈及万物为友，而林中也没有无留陀。直到在很多很多个月亮以前的一次灾难…",
            "nextDialogs": [
              "730090904"
            ]
          },
          "730090904": {
            "id": "730090904",
            "speakerId": 20648,
            "speakerName": "兰拉迦",
            "text": "树王归还了沙恒，无留陀开始在地上肆虐。而丛林终于恢复生机后，兰那罗为了保护自己，将真正的桓那兰那藏在了梦中。",
            "nextDialogs": [
              "730090905"
            ]
          },
          "730090905": {
            "id": "730090905",
            "speakerId": 20648,
            "speakerName": "兰拉迦",
            "text": "森林本不知死为何物。直到有一天，树想起大地中充满了凋败的花、死去的兽。",
            "nextDialogs": [
              "730090906"
            ]
          },
          "730090906": {
            "id": "730090906",
            "speakerId": 20648,
            "speakerName": "兰拉迦",
            "text": "正如在同一天，大地想起自己曾经或将要吞食漆黑的毒血。河流想到太阳降下，蒸发了所有水的红色的世界。",
            "nextDialogs": [
              "730090907"
            ]
          },
          "730090907": {
            "id": "730090907",
            "speakerId": 20648,
            "speakerName": "兰拉迦",
            "text": "他们明白了，万物都将无可避免地死去。这时，「无留陀」就诞生了。此乃「死」之名，知晓它存在的，终究会死去。",
            "nextDialogs": [
              "730090908"
            ]
          },
          "730090908": {
            "id": "730090908",
            "speakerId": 20648,
            "speakerName": "兰拉迦",
            "text": "无留陀的力量就是令一切走向死。而高大、阴暗、扭曲的东西就是无留陀选中的化身，带来死的使徒。",
            "nextDialogs": [
              "730090909"
            ]
          },
          "730090909": {
            "id": "730090909",
            "speakerId": 20648,
            "speakerName": "兰拉迦",
            "text": "当然了，在老身的故事中，无留陀的化身形态是不定的。也许是走兽。也许是飞鸟。也许是那菈。也许是疫病…",
            "nextDialogs": [
              "730090910"
            ]
          },
          "730090910": {
            "id": "730090910",
            "speakerId": 20648,
            "speakerName": "兰拉迦",
            "text": "但故事究竟是故事，那已经不是老身的记忆了。"
          }
        }
      }
    },
    {
      "subId": "7300910",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "730091001"
        ],
        "dialogs": {
          "730091001": {
            "id": "730091001",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "关于「恒素果」…",
            "nextDialogs": [
              "730091002"
            ]
          },
          "730091002": {
            "id": "730091002",
            "speakerId": 20648,
            "speakerName": "兰拉迦",
            "text": "那是充满了力量的果实。它汲取大地中的记忆与梦生长，再经兰那罗与那菈的努力才能结出。",
            "nextDialogs": [
              "730091003"
            ]
          },
          "730091003": {
            "id": "730091003",
            "speakerId": 20648,
            "speakerName": "兰拉迦",
            "text": "以恒素果的力量供养「觉王之树」，就能结出惟耶之实。那是树王亲自种下的伟大之树，也是兰那罗一族的原点。"
          }
        }
      }
    },
    {
      "subId": "7300911",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "730091101"
        ],
        "dialogs": {
          "730091101": {
            "id": "730091101",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "关于「森林书」…",
            "nextDialogs": [
              "730091102"
            ]
          },
          "730091102": {
            "id": "730091102",
            "speakerId": 20648,
            "speakerName": "兰拉迦",
            "text": "#那是那菈法留纳留下的东西。{M#她}{F#他}是一个金灿灿的那菈，与你一样善良、勇敢、正直。",
            "nextDialogs": [
              "730091103"
            ]
          },
          "730091103": {
            "id": "730091103",
            "speakerId": 20648,
            "speakerName": "兰拉迦",
            "text": "#还记得那个时期的兰那罗，都十分想念{M#她}{F#他}，也热爱{M#她}{F#他}的故事。但老身相信，既然如今有了那菈{NICKNAME}…"
          }
        }
      }
    },
    {
      "subId": "7300912",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "730091201"
        ],
        "dialogs": {
          "730091201": {
            "id": "730091201",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "再见。",
            "nextDialogs": [
              "730091202"
            ]
          },
          "730091202": {
            "id": "730091202",
            "speakerId": 20648,
            "speakerName": "兰拉迦",
            "text": "嗯。老身很期待和你们一起度过无忧节哪。"
          }
        }
      }
    },
    {
      "subId": "7300913",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "730091301"
        ],
        "dialogs": {
          "730091301": {
            "id": "730091301",
            "speakerId": 20648,
            "speakerName": "兰拉迦",
            "text": "#老身能过上无忧节，都是托了那菈{NICKNAME}和派蒙的福。谢谢你们。",
            "nextDialogs": [
              "730091302"
            ]
          },
          "730091302": {
            "id": "730091302",
            "speakerId": 20648,
            "speakerName": "兰拉迦",
            "text": "老身很遗憾，无法像兰罗摩他们那样，和你一起在外面冒险，也不能帮助你们。",
            "nextDialogs": [
              "730091303"
            ]
          },
          "730091303": {
            "id": "730091303",
            "speakerId": 20648,
            "speakerName": "兰拉迦",
            "text": "但是，这个梦永远欢迎你们。如果对外面的世界感觉累了，就到桓那兰那来吧。"
          }
        }
      }
    },

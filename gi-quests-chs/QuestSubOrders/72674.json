  },
  "subQuests": [
    {
      "subId": "7267401",
      "subQuestName": "前往镇守之森，拜访五百藏",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "726740101"
        ],
        "dialogs": {
          "726740101": {
            "id": "726740101",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "五百藏，你好！",
            "nextDialogs": [
              "726740102"
            ]
          },
          "726740102": {
            "id": "726740102",
            "speakerId": 3159,
            "speakerName": "五百藏",
            "text": "咿！居然被识破了！你们究竟是…这个气味…",
            "nextDialogs": [
              "726740103"
            ]
          },
          "726740103": {
            "id": "726740103",
            "speakerId": 3159,
            "speakerName": "五百藏",
            "text": "原来是你们这些小辈啊。有些时日没见，气味我都认不得了。",
            "nextDialogs": [
              "726740104"
            ]
          },
          "726740104": {
            "id": "726740104",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "五百藏倒是完全没变，还是看到人就害怕，而且还困在石头里呢！",
            "nextDialogs": [
              "726740105"
            ]
          },
          "726740105": {
            "id": "726740105",
            "speakerId": 3159,
            "speakerName": "五百藏",
            "text": "呶？！你这小辈，这话是什么意思？",
            "nextDialogs": [
              "726740108"
            ]
          },
          "726740108": {
            "id": "726740108",
            "speakerId": 3159,
            "speakerName": "五百藏",
            "text": "区区人类的封印罢了！只要吾辈努力…",
            "nextDialogs": [
              "726740109"
            ]
          },
          "726740109": {
            "id": "726740109",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "咳咳。",
            "nextDialogs": [
              "726740110"
            ]
          },
          "726740110": {
            "id": "726740110",
            "speakerId": 3159,
            "speakerName": "五百藏",
            "text": "……",
            "nextDialogs": [
              "726740111"
            ]
          },
          "726740111": {
            "id": "726740111",
            "speakerId": 3159,
            "speakerName": "五百藏",
            "text": "#哼。不管怎么说，孩子们受了你不少照顾。小狸子们总说，有个闻起来很香的黄毛{PLAYERAVATAR#SEXPRO[INFO_MALE_PRONOUN_UNCLE|INFO_FEMALE_PRONOUN_AUNT]}经常陪他们玩，可开心了。"
          }
        }
      }
    },
    {
      "subId": "7267402",
      "subQuestName": "与吉法师对话",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "726740201"
        ],
        "dialogs": {
          "726740201": {
            "id": "726740201",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "吉法师，好久不见啦！",
            "nextDialogs": [
              "726740202"
            ]
          },
          "726740202": {
            "id": "726740202",
            "speakerId": 3160,
            "speakerName": "「吉法师」",
            "text": "呶！白毛黄毛。",
            "nextDialogs": [
              "726740203"
            ]
          },
          "726740203": {
            "id": "726740203",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "黄毛是指我…？",
            "nextDialogs": [
              "726740204"
            ]
          },
          "726740204": {
            "id": "726740204",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "喂！你说谁是白毛呀！",
            "nextDialogs": [
              "726740205"
            ]
          },
          "726740205": {
            "id": "726740205",
            "speakerId": 3160,
            "speakerName": "「吉法师」",
            "text": "好强。能听懂。",
            "nextDialogs": [
              "726740206"
            ]
          },
          "726740206": {
            "id": "726740206",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "#我叫{NICKNAME}，这位是派蒙。",
            "nextDialogs": [
              "726740207"
            ]
          },
          "726740207": {
            "id": "726740207",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "要好好记住喔！",
            "nextDialogs": [
              "726740208"
            ]
          },
          "726740208": {
            "id": "726740208",
            "speakerId": 3160,
            "speakerName": "「吉法师」",
            "text": "咔嚓咔嚓菫瓜。",
            "nextDialogs": [
              "726740209"
            ]
          },
          "726740209": {
            "id": "726740209",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "咦，菫瓜？咔嚓咔嚓又是什么？！",
            "nextDialogs": [
              "726740210"
            ]
          },
          "726740210": {
            "id": "726740210",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "无论如何，也算是勉强能说得上话吧…",
            "nextDialogs": [
              "726740211"
            ]
          },
          "726740211": {
            "id": "726740211",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "确实有够勉强的。",
            "nextDialogs": [
              "726740212"
            ]
          },
          "726740212": {
            "id": "726740212",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "#不管怎么说，{NICKNAME}，我们去跟五百藏打声招呼吧！毕竟，要带吉法师一起远行了。",
            "nextDialogs": [
              "726740213"
            ]
          },
          "726740213": {
            "id": "726740213",
            "speakerId": 3160,
            "speakerName": "「吉法师」",
            "text": "五百藏！耶！",
            "nextDialogs": [
              "726740214"
            ]
          },
          "726740214": {
            "id": "726740214",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "耶！"
          }
        }
      }
    },
    {
      "subId": "7267403",
      "subQuestName": "与五百藏对话",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "726740301"
        ],
        "dialogs": {
          "726740301": {
            "id": "726740301",
            "speakerId": 3159,
            "speakerName": "五百藏",
            "text": "呶！如何？",
            "nextDialogs": [
              "726740302"
            ]
          },
          "726740302": {
            "id": "726740302",
            "speakerId": 3160,
            "speakerName": "「吉法师」",
            "text": "呶！见到白毛黄毛，喜欢。菫瓜砰砰。",
            "nextDialogs": [
              "726740303"
            ]
          },
          "726740303": {
            "id": "726740303",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "菫瓜砰砰…",
            "nextDialogs": [
              "726740304"
            ]
          },
          "726740304": {
            "id": "726740304",
            "speakerId": 3159,
            "speakerName": "五百藏",
            "text": "呶？想不到，你这小辈，还挺上道嘛…？",
            "nextDialogs": [
              "726740305"
            ]
          },
          "726740305": {
            "id": "726740305",
            "speakerId": 3160,
            "speakerName": "「吉法师」",
            "text": "砰砰！",
            "nextDialogs": [
              "726740306"
            ]
          },
          "726740306": {
            "id": "726740306",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "所以说，菫瓜砰砰是什么意思…？",
            "nextDialogs": [
              "726740307"
            ]
          },
          "726740307": {
            "id": "726740307",
            "speakerId": 3160,
            "speakerName": "「吉法师」",
            "text": "砰砰是砰砰，菫瓜是菫瓜。",
            "nextDialogs": [
              "726740308"
            ]
          },
          "726740308": {
            "id": "726740308",
            "speakerId": 3159,
            "speakerName": "五百藏",
            "text": "看来你们交流没有任何问题了。吾辈的「烹饪」技术还是一样好哪。",
            "nextDialogs": [
              "726740310"
            ]
          },
          "726740310": {
            "id": "726740310",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "不对！问题大着呢！吉法师说的话，基本都听不懂啦！",
            "nextDialogs": [
              "726740312"
            ]
          },
          "726740312": {
            "id": "726740312",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "是这样的…",
            "nextDialogs": [
              "726740313"
            ]
          },
          "726740313": {
            "id": "726740313",
            "speakerId": 1003,
            "speakerName": "Black Screen",
            "text": "向五百藏传达了交流的效果。",
            "nextDialogs": [
              "726740314"
            ]
          },
          "726740314": {
            "id": "726740314",
            "speakerId": 3159,
            "speakerName": "五百藏",
            "text": "唔唔，原来是这样啊。不用担心，那是因为你们还没有适应吉法师的气味。",
            "nextDialogs": [
              "726740315"
            ]
          },
          "726740315": {
            "id": "726740315",
            "speakerId": 3159,
            "speakerName": "五百藏",
            "text": "慢慢适应吧！越适应吉法师的气息，就越能听明白吉法师说的话。",
            "nextDialogs": [
              "726740316"
            ]
          },
          "726740316": {
            "id": "726740316",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "「慢慢」是多久啦…",
            "nextDialogs": [
              "726740317"
            ]
          },
          "726740317": {
            "id": "726740317",
            "speakerId": 3159,
            "speakerName": "五百藏",
            "text": "这个啊，这个嘛…我想想…",
            "nextDialogs": [
              "726740318"
            ]
          },
          "726740318": {
            "id": "726740318",
            "speakerId": 3159,
            "speakerName": "五百藏",
            "text": "呶！稍安勿躁就是了，真是急性子。",
            "nextDialogs": [
              "726740319"
            ]
          },
          "726740319": {
            "id": "726740319",
            "speakerId": 3160,
            "speakerName": "「吉法师」",
            "text": "急性子不好。",
            "nextDialogs": [
              "726740320"
            ]
          },
          "726740320": {
            "id": "726740320",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "看来五百藏也不知道啊。",
            "nextDialogs": [
              "726740321"
            ]
          },
          "726740321": {
            "id": "726740321",
            "speakerId": 3159,
            "speakerName": "五百藏",
            "text": "哼！吾辈可是活了好久好久的妖狸大王隐神五百藏，怎么会像你们人类那样，对时间这么计较呢！",
            "nextDialogs": [
              "726740322"
            ]
          },
          "726740322": {
            "id": "726740322",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "（虽然大部分时间都被封印在石像里啦。）",
            "nextDialogs": [
              "726740323"
            ]
          },
          "726740323": {
            "id": "726740323",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "不过，为什么五百藏可以和人对话？",
            "nextDialogs": [
              "726740324"
            ]
          },
          "726740324": {
            "id": "726740324",
            "speakerId": 3159,
            "speakerName": "五百藏",
            "text": "呶，真没礼貌。应该是，为什么你们人类可以和吾辈对话才对。",
            "nextDialogs": [
              "726740325"
            ]
          },
          "726740325": {
            "id": "726740325",
            "speakerId": 3159,
            "speakerName": "五百藏",
            "text": "像吾辈这样活了好久好久、力量强大的妖狸，多少都和人类打过交道。",
            "nextDialogs": [
              "726740326"
            ]
          },
          "726740326": {
            "id": "726740326",
            "speakerId": 3159,
            "speakerName": "五百藏",
            "text": "好久好久以前，吾等经常和天狗、狐、鬼、妖怪与人打交道。人的故事虽然总在说人，其实有一半是妖狸伪装成的人类的历史。",
            "nextDialogs": [
              "726740327"
            ]
          },
          "726740327": {
            "id": "726740327",
            "speakerId": 3159,
            "speakerName": "五百藏",
            "text": "剩下一半的一半是人类自己的故事，另一半是天狗、狐、鬼和其他妖怪的故事。",
            "nextDialogs": [
              "726740328"
            ]
          },
          "726740328": {
            "id": "726740328",
            "speakerId": 3159,
            "speakerName": "五百藏",
            "text": "不过，这一半里面，也有一半是吾等妖狸伪装成他们的故事。然后，所有妖狸的故事里，有一半是吾辈五百藏的故事。",
            "nextDialogs": [
              "726740329"
            ]
          },
          "726740329": {
            "id": "726740329",
            "speakerId": 3159,
            "speakerName": "五百藏",
            "text": "所以，哼，吾辈可是最厉害的呶，能够和你们这些小辈说话自然不在话下。",
            "nextDialogs": [
              "726740330"
            ]
          },
          "726740330": {
            "id": "726740330",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "我懂了，十六分之五都是你的。",
            "nextDialogs": [
              "726740331"
            ]
          },
          "726740331": {
            "id": "726740331",
            "speakerId": 3159,
            "speakerName": "五百藏",
            "text": "呶？「十六分之五」…是什么好吃的吗？",
            "nextDialogs": [
              "726740332"
            ]
          },
          "726740332": {
            "id": "726740332",
            "speakerId": 3160,
            "speakerName": "「吉法师」",
            "text": "听起来，好吃。想吃。",
            "nextDialogs": [
              "726740333"
            ]
          },
          "726740333": {
            "id": "726740333",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "#{NICKNAME}是说，依照五百藏的说法，五百藏在故事里的占比啦。",
            "nextDialogs": [
              "726740334"
            ]
          },
          "726740334": {
            "id": "726740334",
            "speakerId": 3160,
            "speakerName": "「吉法师」",
            "text": "五百藏。厉害。",
            "nextDialogs": [
              "726740335"
            ]
          },
          "726740335": {
            "id": "726740335",
            "speakerId": 3159,
            "speakerName": "五百藏",
            "text": "哼，那还用说。吾辈的厉害，你要好好学学。",
            "nextDialogs": [
              "726740336"
            ]
          },
          "726740336": {
            "id": "726740336",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "欸？仔细一想，好像能慢慢听明白吉法师说的话了…",
            "nextDialogs": [
              "726740337"
            ]
          },
          "726740337": {
            "id": "726740337",
            "speakerId": 3160,
            "speakerName": "「吉法师」",
            "text": "白毛聪明。",
            "nextDialogs": [
              "726740338"
            ]
          },
          "726740338": {
            "id": "726740338",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "呜哇，被吉法师这样夸了，心里感觉很不是滋味…",
            "nextDialogs": [
              "726740339"
            ]
          },
          "726740339": {
            "id": "726740339",
            "speakerId": 3159,
            "speakerName": "五百藏",
            "text": "那就好。这个孩子就拜托你们了，带他到外边去修行吧。",
            "nextDialogs": [
              "726740340"
            ]
          },
          "726740340": {
            "id": "726740340",
            "speakerId": 3159,
            "speakerName": "五百藏",
            "text": "吾辈还是个幼狸的时候，也曾经巡礼稻妻十八所，寻访过去大妖狸「九百九」的名迹，绝不偏离狸道，才能达到今天的高度。",
            "nextDialogs": [
              "726740341"
            ]
          },
          "726740341": {
            "id": "726740341",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "欸！所以五百藏才被封印在石头里吗？",
            "nextDialogs": [
              "726740342"
            ]
          },
          "726740342": {
            "id": "726740342",
            "speakerId": 3160,
            "speakerName": "「吉法师」",
            "text": "呶哈哈，石头。",
            "nextDialogs": [
              "726740343"
            ]
          },
          "726740343": {
            "id": "726740343",
            "speakerId": 3159,
            "speakerName": "五百藏",
            "text": "呶？！吉法师，连你也…",
            "nextDialogs": [
              "726740344"
            ]
          },
          "726740344": {
            "id": "726740344",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "回到正题！那我们先去什么地方好呢？"
          }
        }
      }
    },
    {
      "subId": "7267404",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "726740401"
        ],
        "dialogs": {
          "726740401": {
            "id": "726740401",
            "speakerId": 3159,
            "speakerName": "五百藏",
            "text": "有了吾辈特制的妖狸饭，就算是你们也可以和小狸子对话。去和吉法师聊聊看吧。",
            "nextDialogs": [
              "726740402"
            ]
          },
          "726740402": {
            "id": "726740402",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "这就去。",
            "nextDialogs": [
              "726740403"
            ]
          },
          "726740403": {
            "id": "726740403",
            "speakerId": 3159,
            "speakerName": "五百藏",
            "text": "快去快去。吾辈反正没有别的去处，时间很多，小狸子们可不一样。"
          }
        }
      }
    }
  ]
}
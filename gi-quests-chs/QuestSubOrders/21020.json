        "dialogs": {
          "210202201": {
            "id": "210202201",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "「我想再聪明一点…」",
            "nextDialogs": [
              "210202202"
            ]
          },
          "210202202": {
            "id": "210202202",
            "speakerId": 20046,
            "speakerName": "祈愿的篝火",
            "text": "「篝火突然燃烧地更加猛烈了，腾起的火焰似乎正隐隐指向着<color=#00E1FFFF>西边</color>的高山…」"

{
  "lineCounts": {
    "Player": 6,
    "朝雾": 16,
    "派蒙": 1
  },
  "subQuests": [
    {
      "subId": "7451401",
      "subQuestName": "与朝雾对话",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "745140101"
        ],
        "dialogs": {
          "745140101": {
            "id": "745140101",
            "speakerId": 1000,
            "speakerName": "朝雾",
            "text": "好…好冷，果然不该随便吹风的…",
            "nextDialogs": [
              "745140102"
            ]
          },
          "745140102": {
            "id": "745140102",
            "speakerId": 1000,
            "speakerName": "朝雾",
            "text": "#欸？{NICKNAME}！派蒙！你们…阿嚏！",
            "nextDialogs": [
              "745140103"
            ]
          },
          "745140103": {
            "id": "745140103",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "朝雾？你怎么会在这里？",
            "nextDialogs": [
              "745140104"
            ]
          },
          "745140104": {
            "id": "745140104",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "你的身体好了吗？居然能一个人来这么远的地方…",
            "nextDialogs": [
              "745140105"
            ]
          },
          "745140105": {
            "id": "745140105",
            "speakerId": 1000,
            "speakerName": "朝雾",
            "text": "我…那个…好，好得差不多啦！你看，我都不咳嗽了。",
            "nextDialogs": [
              "745140106"
            ]
          },
          "745140106": {
            "id": "745140106",
            "speakerId": 1000,
            "speakerName": "朝雾",
            "text": "哈哈…哈…",
            "nextDialogs": [
              "745140109"
            ]
          },
          "745140109": {
            "id": "745140109",
            "speakerId": 1000,
            "speakerName": "朝雾",
            "text": "呜哇！别啊！我承认了，我是自己偷偷跑出来的啦！",
            "nextDialogs": [
              "745140110"
            ]
          },
          "745140110": {
            "id": "745140110",
            "speakerId": 1000,
            "speakerName": "朝雾",
            "text": "我…我也没办法啊，老是窝在稻妻，怎么可能画出好看的画。",
            "nextDialogs": [
              "745140111"
            ]
          },
          "745140111": {
            "id": "745140111",
            "speakerId": 1000,
            "speakerName": "朝雾",
            "text": "就算有你帮我到处去留影，但说到底，画片肯定比不过实景啊。",
            "nextDialogs": [
              "745140112"
            ]
          },
          "745140112": {
            "id": "745140112",
            "speakerId": 1000,
            "speakerName": "朝雾",
            "text": "所以，我就拜托之前合作过的一个老师帮忙联系了一支商队，悄悄地出来旅行。",
            "nextDialogs": [
              "745140113"
            ]
          },
          "745140113": {
            "id": "745140113",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "亏你还把画具都背过来了…",
            "nextDialogs": [
              "745140114"
            ]
          },
          "745140114": {
            "id": "745140114",
            "speakerId": 1000,
            "speakerName": "朝雾",
            "text": "那当然。画板可是我的灵魂，怎么能随便丢下它们呢。",
            "nextDialogs": [
              "745140115"
            ]
          },
          "745140115": {
            "id": "745140115",
            "speakerId": 1000,
            "speakerName": "朝雾",
            "text": "而且我的画在枫丹也卖得很好呀，还有几个枫丹的作家，请我给他们的小说画封面了。",
            "nextDialogs": [
              "745140116"
            ]
          },
          "745140116": {
            "id": "745140116",
            "speakerId": 1000,
            "speakerName": "朝雾",
            "text": "不过…他们居然没有在小说中间插入插画的习惯呢。真没想到…",
            "nextDialogs": [
              "745140117"
            ]
          },
          "745140117": {
            "id": "745140117",
            "speakerId": 1000,
            "speakerName": "朝雾",
            "text": "#对了，{NICKNAME}，刚巧你在这里…你愿意再帮我去取材吗？"
          }
        }
      }
    }
  ]
}
    {
      "subId": "1103008",
      "subQuestName": "完成魈的修炼内容",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "110300801"
        ],
        "dialogs": {
          "110300801": {
            "id": "110300801",
            "speakerId": 1005,
            "speakerName": "魈",
            "text": "专注于修行，我可没答应过陪你们闲聊。"
          }
        }
      }
    },
    {
      "subId": "1103009",
      "subQuestName": "与魈对话",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "110300601"
        ],
        "dialogs": {
          "110300601": {
            "id": "110300601",
            "speakerId": 1004,
            "speakerName": "甘雨",
            "text": "您布置的修炼我已经完成了…",
            "nextDialogs": [
              "110300602"
            ]
          },
          "110300602": {
            "id": "110300602",
            "speakerId": 1005,
            "speakerName": "魈",
            "text": "无需向我报告，你所想要的他人评价，无益于修炼本身。",
            "nextDialogs": [
              "110300603"
            ]
          },
          "110300603": {
            "id": "110300603",
            "speakerId": 1005,
            "speakerName": "魈",
            "text": "修炼的结果，仅仅留给自身审视，会更容易使你精进。",
            "nextDialogs": [
              "110300604"
            ]
          },
          "110300604": {
            "id": "110300604",
            "speakerId": 1004,
            "speakerName": "甘雨",
            "text": "嗯…我记住了。",
            "nextDialogs": [
              "110300605"
            ]
          },
          "110300605": {
            "id": "110300605",
            "speakerId": 1003,
            "speakerName": "派蒙",
            "text": "魈总是有一套自己的见解呢…",
            "nextDialogs": [
              "110300608"
            ]
          },
          "110300608": {
            "id": "110300608",
            "speakerId": 1005,
            "speakerName": "魈",
            "text": "明日我会继续提高修炼的难度，你要…",
            "nextDialogs": [
              "110300609"
            ]
          },
          "110300609": {
            "id": "110300609",
            "speakerId": 1005,
            "speakerName": "魈",
            "text": "……",
            "nextDialogs": [
              "110300610"
            ]
          },
          "110300610": {
            "id": "110300610",
            "speakerId": 1003,
            "speakerName": "派蒙",
            "text": "要什么？",
            "nextDialogs": [
              "110300611"
            ]
          },
          "110300611": {
            "id": "110300611",
            "speakerId": 1005,
            "speakerName": "魈",
            "text": "呼…从那边过来了，那个难对付的家伙…",
            "nextDialogs": [
              "110300612"

    {
      "subId": "1103004",
      "subQuestName": "前往甘雨的修炼地点，与甘雨对话",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "110300301"
        ],
        "dialogs": {
          "110300301": {
            "id": "110300301",
            "speakerId": 1003,
            "speakerName": "派蒙",
            "text": "甘雨小姐，果然在这里。",
            "nextDialogs": [
              "110300302"
            ]
          },
          "110300302": {
            "id": "110300302",
            "speakerId": 1004,
            "speakerName": "甘雨",
            "text": "二位为什么跟到这里来了？",
            "nextDialogs": [
              "110300304",
              "110300308"
            ]
          },
          "110300304": {
            "id": "110300304",
            "speakerId": 1004,
            "speakerName": "甘雨",
            "text": "啊，我…仙家境地，凡人本就不该久留。",
            "nextDialogs": [
              "110300305"
            ]
          },
          "110300305": {
            "id": "110300305",
            "speakerId": 1004,
            "speakerName": "甘雨",
            "text": "嗯…不过看在二位好意的份儿上，我可以带你们体验一下仙家的修行。",
            "nextDialogs": [
              "110300306"
            ]
          },
          "110300306": {
            "id": "110300306",
            "speakerId": 1003,
            "speakerName": "派蒙",
            "text": "欸~！",
            "nextDialogs": [
              "110300309"
            ]
          },
          "110300309": {
            "id": "110300309",
            "speakerId": 1004,
            "speakerName": "甘雨",
            "text": "我现在要做的修行是留云真君为我安排的，旨在帮我找回一些作为仙人的感觉。",
            "nextDialogs": [
              "110300310"
            ]
          },
          "110300310": {
            "id": "110300310",
            "speakerId": 1004,
            "speakerName": "甘雨",
            "text": "虽然其中融入了些她的风格和趣味…但愿不会让你们对仙人有所误解。",
            "nextDialogs": [
              "110300311"
            ]
          },
          "110300311": {
            "id": "110300311",
            "speakerId": 1003,
            "speakerName": "派蒙",
            "text": "会、会很难吗？",
            "nextDialogs": [
              "110300312"
            ]
          },
          "110300312": {
            "id": "110300312",
            "speakerId": 1004,
            "speakerName": "甘雨",
            "text": "不会，旅者的实力我已知晓，体内隐藏的力量不逊于我等。",
            "nextDialogs": [
              "110300313"
            ]
          },
          "110300313": {
            "id": "110300313",
            "speakerId": 1004,
            "speakerName": "甘雨",
            "text": "做好准备的话，就开始吧？"
          },
          "110300308": {
            "id": "110300308",
            "speakerId": 1004,
            "speakerName": "甘雨",
            "text": "原来如此，你们对仙家修行感兴趣啊…"
          }
        }
      }
    },
    {
      "subId": "1103010",

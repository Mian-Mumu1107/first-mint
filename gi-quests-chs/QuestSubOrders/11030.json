    {
      "subId": "1103005",
      "subQuestName": "完成留云借风真君的修炼内容",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "110300501"
        ],
        "dialogs": {
          "110300501": {
            "id": "110300501",
            "speakerId": 1005,
            "speakerName": "魈",
            "text": "迟了四分之一个时辰…你还是甩不开那些人类的陋习。",
            "nextDialogs": [
              "110300502"
            ]
          },
          "110300502": {
            "id": "110300502",
            "speakerId": 1004,
            "speakerName": "甘雨",
            "text": "不好意思，刚才在留云真君那边，我…",
            "nextDialogs": [
              "110300503"
            ]
          },
          "110300503": {
            "id": "110300503",
            "speakerId": 1005,
            "speakerName": "魈",
            "text": "不必向我解释什么，也无需相互谅解，我只是受托帮助你修行而已。",
            "nextDialogs": [
              "110300504"
            ]
          },
          "110300504": {
            "id": "110300504",
            "speakerId": 1003,
            "speakerName": "派蒙",
            "text": "当老师的魈…也太严格了。",
            "nextDialogs": [
              "110300505"
            ]
          },
          "110300505": {
            "id": "110300505",
            "speakerId": 1005,
            "speakerName": "魈",
            "text": "你既非仙人，亦非人类，以此身份漫步尘世边缘，难免产生许多困惑。",
            "nextDialogs": [
              "110300506"
            ]
          },
          "110300506": {
            "id": "110300506",
            "speakerId": 1005,
            "speakerName": "魈",
            "text": "所以，比起向我解释，还是先直面你自己的内心比较好。",
            "nextDialogs": [
              "110300507"
            ]
          },
          "110300507": {
            "id": "110300507",
            "speakerId": 1004,
            "speakerName": "甘雨",
            "text": "我…没有遮掩什么。",
            "nextDialogs": [
              "110300510"
            ]
          },
          "110300510": {
            "id": "110300510",
            "speakerId": 1005,
            "speakerName": "魈",
            "text": "躯壳与神魂是统一的，神魂如果遇上困境，从躯壳寻求突破也是一种选择。",
            "nextDialogs": [
              "110300511"
            ]
          },
          "110300511": {
            "id": "110300511",
            "speakerId": 1005,
            "speakerName": "魈",
            "text": "我给你安排的修行，会试着探索你躯壳的潜能。",
            "nextDialogs": [
              "110300512"
            ]
          },
          "110300512": {
            "id": "110300512",
            "speakerId": 1004,
            "speakerName": "甘雨",
            "text": "嗯，我做好准备了。"
          }
        }
      }
    },
    {
      "subId": "1103006",
      "subQuestName": "与甘雨对话",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "110300401"
        ],
        "dialogs": {
          "110300401": {
            "id": "110300401",
            "speakerId": 1004,
            "speakerName": "甘雨",
            "text": "顺利完成了呢，感觉如何？",
            "nextDialogs": [
              "110300403",
              "110300405"
            ]
          },
          "110300403": {
            "id": "110300403",
            "speakerId": 1004,
            "speakerName": "甘雨",
            "text": "没错，虽然没有仙人的血脉，但你好像具备了许多仙人的资质呢。",
            "nextDialogs": [
              "110300406"
            ]
          },
          "110300406": {
            "id": "110300406",
            "speakerId": 1003,
            "speakerName": "派蒙",
            "text": "做完修行以后，甘雨还有什么打算呢？",
            "nextDialogs": [
              "110300407"
            ]
          },
          "110300407": {
            "id": "110300407",
            "speakerId": 1004,
            "speakerName": "甘雨",
            "text": "修行并未结束，留云真君安排的修行只是第一环而已。",
            "nextDialogs": [
              "110300408"
            ]
          },
          "110300408": {
            "id": "110300408",
            "speakerId": 1003,
            "speakerName": "派蒙",
            "text": "欸！那也就是说，还有其他仙人安排的修行？"
          },
          "110300405": {
            "id": "110300405",
            "speakerId": 1004,
            "speakerName": "甘雨",
            "text": "辛苦吗…不仅仙人如此，世间众生也是如此吧。"
          }
        }
      }
    },
    {

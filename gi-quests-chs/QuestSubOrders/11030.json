  "subQuests": [
    {
      "subId": "1103001",
      "subQuestName": "与「群玉阁」的秘书们对话",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "110300101"
        ],
        "dialogs": {
          "110300101": {
            "id": "110300101",
            "speakerId": 1000,
            "speakerName": "百晓",
            "text": "这工作量也实在太惊人了，我们明明有三个人…",
            "nextDialogs": [
              "110300102"
            ]
          },
          "110300102": {
            "id": "110300102",
            "speakerId": 1001,
            "speakerName": "百识",
            "text": "她一直都是怎么过来的…「七星」的秘书果然不是一般人，这种挫败感…",
            "nextDialogs": [
              "110300103"
            ]
          },
          "110300103": {
            "id": "110300103",
            "speakerId": 1002,
            "speakerName": "百闻",
            "text": "欸，你们是…",
            "nextDialogs": [
              "110300104"
            ]
          },
          "110300104": {
            "id": "110300104",
            "speakerId": 1003,
            "speakerName": "派蒙",
            "text": "你们不是凝光的三个跟班吗！怎么在这里？",
            "nextDialogs": [
              "110300105"
            ]
          },
          "110300105": {
            "id": "110300105",
            "speakerId": 1000,
            "speakerName": "百晓",
            "text": "咳…是凝光小姐的私人秘书，不是跟班。",
            "nextDialogs": [
              "110300106"
            ]
          },
          "110300106": {
            "id": "110300106",
            "speakerId": 1002,
            "speakerName": "百闻",
            "text": "请问你有见过甘雨小姐吗？旅行者。",
            "nextDialogs": [
              "110300107"
            ]
          },
          "110300107": {
            "id": "110300107",
            "speakerId": 1002,
            "speakerName": "百闻",
            "text": "自从她前往绝云间之后，已经有很多天没回来了。她是辅助「璃月七星」这个整体的秘书，我们正在替她打理工作…",
            "nextDialogs": [
              "110300110"
            ]
          },
          "110300110": {
            "id": "110300110",
            "speakerId": 1000,
            "speakerName": "百晓",
            "text": "唔，之前众仙来璃月问罪，虽说事情已经谈和，但「七星」还是希望能展现对仙人们敬重的一面…",
            "nextDialogs": [
              "110300111"
            ]
          },
          "110300111": {
            "id": "110300111",
            "speakerId": 1000,
            "speakerName": "百晓",
            "text": "于是派甘雨小姐作为使者，带信函前往绝云间，将最近璃月风波的处理情况交给仙人过目。",
            "nextDialogs": [
              "110300112"
            ]
          },
          "110300112": {
            "id": "110300112",
            "speakerId": 1000,
            "speakerName": "百晓",
            "text": "可是…理论上甘雨小姐应该已经回来继续投入工作了，可一直没见她的踪影。",
            "nextDialogs": [
              "110300113"
            ]
          },
          "110300113": {
            "id": "110300113",
            "speakerId": 1003,
            "speakerName": "派蒙",
            "text": "这样啊…可能甘雨小姐只是顺路旅游去了？工作久了也要放松一下心情嘛。",
            "nextDialogs": [
              "110300114"
            ]
          },
          "110300114": {
            "id": "110300114",
            "speakerId": 1002,
            "speakerName": "百闻",
            "text": "这个恐怕不会的…自从我们认识甘雨小姐以来，说她是全璃月最勤奋的人也不为过…",
            "nextDialogs": [
              "110300115"
            ]
          },
          "110300115": {
            "id": "110300115",
            "speakerId": 1002,
            "speakerName": "百闻",
            "text": "就算是每年固定时间的休假，甘雨小姐也会以「还有很多事情要忙」为由，继续留守月海亭。",
            "nextDialogs": [
              "110300116"
            ]
          },
          "110300116": {
            "id": "110300116",
            "speakerId": 1002,
            "speakerName": "百闻",
            "text": "这样的她会借出差的机会去偷懒…实在有些难以想象。",
            "nextDialogs": [
              "110300117"
            ]
          },
          "110300117": {
            "id": "110300117",
            "speakerId": 1003,
            "speakerName": "派蒙",
            "text": "原来是这样呀…可是，她也有一半是仙人，应该不至于出什么意外吧？你们又为什么一副特别着急的样子…",
            "nextDialogs": [
              "110300118"
            ]
          },
          "110300118": {
            "id": "110300118",
            "speakerId": 1001,
            "speakerName": "百识",
            "text": "这个嘛…当然是因为，她那「不可理喻」的工作量了！",
            "nextDialogs": [
              "110300119"
            ]
          },
          "110300119": {
            "id": "110300119",
            "speakerId": 1001,
            "speakerName": "百识",
            "text": "唉…原先得知要为甘雨小姐代班，而且是三个人一起，以为不过是换换工作环境罢了…",
            "nextDialogs": [
              "110300120"
            ]
          },
          "110300120": {
            "id": "110300120",
            "speakerId": 1000,
            "speakerName": "百晓",
            "text": "嗯，可想不到，原来甘雨小姐一个人的日常工作，就远远超过我们三人可以处理的范畴了…"
          }
        }
      }
    },
    {
      "subId": "1103002",
      "subQuestName": "前往奥藏山附近，寻找甘雨",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "110300201"
        ],
        "dialogs": {
          "110300201": {
            "id": "110300201",
            "speakerId": 1003,
            "speakerName": "派蒙",
            "text": "甘雨小姐！你原来在这儿！",
            "nextDialogs": [
              "110300202"
            ]
          },
          "110300202": {
            "id": "110300202",
            "speakerId": 1004,
            "speakerName": "甘雨",
            "text": "二位…真没料到会在这里相见。请问有公事还是私事？",
            "nextDialogs": [
              "110300203"
            ]
          },
          "110300203": {
            "id": "110300203",
            "speakerId": 1004,
            "speakerName": "甘雨",
            "text": "啊…不对，如今我已脱离尘世，如果是商港事务的话，还请到月海亭去咨询。",
            "nextDialogs": [
              "110300206"
            ]
          },
          "110300206": {
            "id": "110300206",
            "speakerId": 1003,
            "speakerName": "派蒙",
            "text": "欸，甘雨小姐难道不做「七星」的秘书了吗？他们都还在等你回去呢…",
            "nextDialogs": [
              "110300207"
            ]
          },
          "110300207": {
            "id": "110300207",
            "speakerId": 1004,
            "speakerName": "甘雨",
            "text": "要我回去…原来这就是你们的来意吗？不好意思，要让两位无功而返了。",
            "nextDialogs": [
              "110300208"
            ]
          },
          "110300208": {
            "id": "110300208",
            "speakerId": 1003,
            "speakerName": "派蒙",
            "text": "怎么会…莫非是发生什么了吗？",
            "nextDialogs": [
              "110300209"
            ]
          },
          "110300209": {
            "id": "110300209",
            "speakerId": 1004,
            "speakerName": "甘雨",
            "text": "云卷云舒，潮起潮落，不过是历史的选择罢了…",
            "nextDialogs": [
              "110300210"
            ]
          },
          "110300210": {
            "id": "110300210",
            "speakerId": 1004,
            "speakerName": "甘雨",
            "text": "自上次仙众将璃月港的「监督」之权交还给百姓之后，我便已经知道，离开璃月只是时间问题…",
            "nextDialogs": [
              "110300211"
            ]
          },
          "110300211": {
            "id": "110300211",
            "speakerId": 1004,
            "speakerName": "甘雨",
            "text": "拥有仙人血脉的我，在璃月港其实并没有容身之所。",
            "nextDialogs": [
              "110300212"
            ]
          },
          "110300212": {
            "id": "110300212",
            "speakerId": 1004,
            "speakerName": "甘雨",
            "text": "此行送达信函之后，我曾回到璃月港，发现我的工作已被百闻、百晓、百识接替…",
            "nextDialogs": [
              "110300213"
            ]
          },
          "110300213": {
            "id": "110300213",
            "speakerId": 1004,
            "speakerName": "甘雨",
            "text": "想必这次送信的工作，也只是将我支开的借口吧？既然「七星」给了我体面退场的机会，我也自然应该识趣…"
          }
        }
      }
    },
    {
      "subId": "1103003",
      "subQuestName": "找到甘雨并与她对话",
      "sceneId": null,

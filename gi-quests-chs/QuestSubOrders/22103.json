  "subQuests": [
    {
      "subId": "2210301",
      "subQuestName": "与菲尔戈黛特对话",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "221030101"
        ],
        "dialogs": {
          "221030101": {
            "id": "221030101",
            "speakerId": 1000,
            "speakerName": "菲尔戈黛特",
            "text": "真麻烦…",
            "nextDialogs": [
              "221030102"
            ]
          },
          "221030102": {
            "id": "221030102",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "怎么了？",
            "nextDialogs": [
              "221030103"
            ]
          },
          "221030103": {
            "id": "221030103",
            "speakerId": 1000,
            "speakerName": "菲尔戈黛特",
            "text": "咦？是客人吗？抱歉，最近客栈周围很奇怪…",
            "nextDialogs": [
              "221030104"
            ]
          },
          "221030104": {
            "id": "221030104",
            "speakerId": 1000,
            "speakerName": "菲尔戈黛特",
            "text": "有好几位客人在附近被怪物袭击，弄得有些客人都不敢来做生意了…",
            "nextDialogs": [
              "221030105"
            ]
          },
          "221030105": {
            "id": "221030105",
            "speakerId": 1000,
            "speakerName": "菲尔戈黛特",
            "text": "这样下去，迟早会惹出大麻烦来。",
            "nextDialogs": [
              "221030106"
            ]
          },
          "221030106": {
            "id": "221030106",
            "speakerId": 1000,
            "speakerName": "菲尔戈黛特",
            "text": "唔，看你的打扮，是旅行者吧…您愿意帮忙去周围看看吗？",
            "nextDialogs": [
              "221030109",
              "221030110"
            ]
          },
          "221030109": {
            "id": "221030109",
            "speakerId": 1000,
            "speakerName": "菲尔戈黛特",
            "text": "谢谢您愿意帮忙。",
            "nextDialogs": [
              "221030113"
            ]
          },
          "221030113": {
            "id": "221030113",
            "speakerId": 1000,
            "speakerName": "菲尔戈黛特",
            "text": "总之，就拜托您了，我会准备好报酬的。"
          },
          "221030110": {
            "id": "221030110",
            "speakerId": 1000,
            "speakerName": "菲尔戈黛特",
            "text": "",
            "nextDialogs": [
              "221030111"
            ]
          },
          "221030111": {
            "id": "221030111",
            "speakerId": 1000,
            "speakerName": "菲尔戈黛特",
            "text": "主要是…怕哪个怪物触了那位的霉头…",
            "nextDialogs": [
              "221030112"
            ]
          },
          "221030112": {
            "id": "221030112",
            "speakerId": 1000,
            "speakerName": "菲尔戈黛特",
            "text": "他对付怪物，可从来不看场合和在场的人等…"
          }
        }
      }
    },
    {
      "subId": "2210302",
      "subQuestName": "前往可疑地点查看",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "221030201"
        ],
        "dialogs": {
          "221030201": {
            "id": "221030201",
            "speakerId": 1000,
            "speakerName": "菲尔戈黛特",
            "text": "都处理好了吗？",
            "nextDialogs": [
              "221030202"
            ]
          },
          "221030202": {
            "id": "221030202",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "还没有…",
            "nextDialogs": [
              "221030203"
            ]
          },
          "221030203": {
            "id": "221030203",
            "speakerId": 1000,
            "speakerName": "菲尔戈黛特",
            "text": "请您快些吧，那位来无影去无踪的…指不定什么时候就会回来。",
            "nextDialogs": [
              "221030204"
            ]
          },
          "221030204": {
            "id": "221030204",
            "speakerId": 1000,
            "speakerName": "菲尔戈黛特",
            "text": "要是他真动起手来，这客栈又要歇业了。"
          }
        }
      }
    },
    {
      "subId": "2210303",
      "subQuestName": "消灭所有魔物",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "221030301"
        ],
        "dialogs": {
          "221030301": {
            "id": "221030301",
            "speakerId": 1000,
            "speakerName": "菲尔戈黛特",
            "text": "都处理好了吗？",
            "nextDialogs": [
              "221030302"
            ]
          },
          "221030302": {
            "id": "221030302",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "处理好了。",
            "nextDialogs": [
              "221030303"
            ]
          },
          "221030303": {
            "id": "221030303",
            "speakerId": 1000,
            "speakerName": "菲尔戈黛特",
            "text": "太好了…总算能安心做会生意了。",
            "nextDialogs": [
              "221030304"
            ]
          },
          "221030304": {
            "id": "221030304",
            "speakerId": 1000,
            "speakerName": "菲尔戈黛特",
            "text": "这是给您的报酬，收下吧。",
            "nextDialogs": [
              "221030305"
            ]
          },
          "221030305": {
            "id": "221030305",
            "speakerId": 1000,
            "speakerName": "菲尔戈黛特",
            "text": "「那位」是谁？嗯…你没见过他吗？",
            "nextDialogs": [
              "221030306"
            ]
          },
          "221030306": {
            "id": "221030306",
            "speakerId": 1000,
            "speakerName": "菲尔戈黛特",
            "text": "他有时候会在客栈顶上休息，您说不定看见过呢。",
            "nextDialogs": [
              "221030307"
            ]
          },
          "221030307": {
            "id": "221030307",
            "speakerId": 1000,
            "speakerName": "菲尔戈黛特",
            "text": "不过，就算您见到他了，最好也别轻易去打扰他，他喜欢一个人呆着。"
          }
        }
      }
    },
    {

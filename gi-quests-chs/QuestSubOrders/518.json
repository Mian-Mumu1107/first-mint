    "幕府通告": 4,
    "港务公告": 4,
    "留言": 29,
    "离岛港口告示板": 1,
    "荒泷完眼归我一斗": 3,
    "鸣神大社公告": 2
  },
  "subQuests": [
    {
      "subId": "51801",
      "subQuestName": "",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "5180101"
        ],
        "dialogs": {
          "5180101": {
            "id": "5180101",
            "speakerId": 1000,
            "speakerName": "离岛港口告示板",
            "text": "此乃幕府所设离岛港口告示板，各种事务，尽皆公示。闲人请勿擅自张贴！"
          }
        }
      }
    },
    {
      "subId": "51802",
      "subQuestName": "",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "5180201"
        ],
        "dialogs": {
          "5180201": {
            "id": "5180201",
            "speakerId": 1001,
            "speakerName": "勘定公告",
            "text": "原勘定奉行柊慎介，以大逆之罪免去职务，听凭大御所殿下发落。宥其年迈功高，暂行永久关押，不得保释。",
            "nextDialogs": [
              "5180202"
            ]
          },
          "5180202": {
            "id": "5180202",
            "speakerId": 1001,
            "speakerName": "勘定公告",
            "text": "若关押期间再有逆叛之举，则视为稻妻举国之公敌，大辟之刑不得宽免。",
            "nextDialogs": [
              "5180203"
            ]
          },
          "5180203": {
            "id": "5180203",
            "speakerId": 1001,
            "speakerName": "勘定公告",
            "text": "勘定奉行府上尚在评议接班人，议定之前，勘定之事务暂由大御所殿下亲委之人直接督行。",
            "nextDialogs": [
              "5180204"
            ]
          },
          "5180204": {
            "id": "5180204",
            "speakerId": 1001,
            "speakerName": "勘定公告",
            "text": "勘定役职暂无调整，诸位官员役人请稍安勿躁，听从幕府方面安排。"
          }
        }
      }
    },
    {
      "subId": "51803",
      "subQuestName": "",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "5180301"
        ],
        "dialogs": {
          "5180301": {
            "id": "5180301",
            "speakerId": 1002,
            "speakerName": "港务公告",
            "text": "鉴于当前停战和平之情状，往海祇岛的贩运商道暂行恢复。",
            "nextDialogs": [
              "5180302"
            ]
          },
          "5180302": {
            "id": "5180302",
            "speakerId": 1002,
            "speakerName": "港务公告",
            "text": "商道安保工作由官府与珊瑚宫两方议定后，往海祇岛之商港将不日开放。"
          }
        }
      }
    },
    {
      "subId": "51804",
      "subQuestName": "",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "5180401"
        ],
        "dialogs": {
          "5180401": {
            "id": "5180401",
            "speakerId": 1003,
            "speakerName": "留言",
            "text": "「战争终于结束了。相比起开心，或许更多是如释重负的轻快感吧。」",
            "nextDialogs": [
              "5180402"
            ]
          },
          "5180402": {
            "id": "5180402",
            "speakerId": 1003,
            "speakerName": "留言",
            "text": "「社奉行大人派遣的监察们也确实有在好好履职，商人们减轻了许多负担…」",
            "nextDialogs": [
              "5180403"
            ]
          },
          "5180403": {
            "id": "5180403",
            "speakerId": 1003,
            "speakerName": "留言",
            "text": "「尽管『锁国令』尚未解除，但至少生意扭转了亏损…无论如何，今后未来可期。」"
          }
        }
      }
    },
    {
      "subId": "51805",
      "subQuestName": "",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "5180501"
        ],
        "dialogs": {
          "5180501": {
            "id": "5180501",
            "speakerId": 1002,
            "speakerName": "港务公告",
            "text": "日前八酝岛蛇骨矿洞暂行关闭，暂由幕府方与珊瑚宫方代表商议开发议程，议定后择日再开。",
            "nextDialogs": [
              "5180502"
            ]
          },
          "5180502": {
            "id": "5180502",
            "speakerId": 1002,
            "speakerName": "港务公告",
            "text": "原蛇骨矿洞矿工可前往社奉行府邸领取失业补助，并登记就业意向推荐书。"
          }
        }
      }
    },
    {
      "subId": "51806",
      "subQuestName": "",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "5180601"
        ],
        "dialogs": {
          "5180601": {
            "id": "5180601",
            "speakerId": 1001,
            "speakerName": "勘定公告",
            "text": "至冬国商人之贸易及港务特权全部取消，限两周内请缴齐拖欠款项，否则离岛将不予保护。",
            "nextDialogs": [
              "5180602"
            ]
          },
          "5180602": {
            "id": "5180602",
            "speakerId": 1001,
            "speakerName": "勘定公告",
            "text": "请战时武备物资承包商即刻离开稻妻及珊瑚宫领内，愚人众及相关人员不得留住。",
            "nextDialogs": [
              "5180603"
            ]
          },
          "5180603": {
            "id": "5180603",
            "speakerId": 1003,
            "speakerName": "留言",
            "text": "「我是幕府军的皮具承包商，和愚人众毫无瓜葛，对这场战争也仅在财务报表上有所了解…」",
            "nextDialogs": [
              "5180604"
            ]
          },
          "5180604": {
            "id": "5180604",
            "speakerId": 1003,
            "speakerName": "留言",
            "text": "「而且此前已在勘定奉行府上申领了永久经营许可，即使这样也要赶我走吗…」",
            "nextDialogs": [
              "5180605"
            ]
          },
          "5180605": {
            "id": "5180605",
            "speakerId": 1004,
            "speakerName": "回复",
            "text": "十分不好意思，请在期限内尽快离开。"
          }
        }
      }
    },
    {
      "subId": "51807",
      "subQuestName": "",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "5180701"
        ],
        "dialogs": {
          "5180701": {
            "id": "5180701",
            "speakerId": 1005,
            "speakerName": "寻人启事",
            "text": "寻夫稻叶藤三郎久藏。高大无须，额角有剑疤。自停战以来尚未归家。",
            "nextDialogs": [
              "5180702"
            ]
          },
          "5180702": {
            "id": "5180702",
            "speakerId": 1005,
            "speakerName": "寻人启事",
            "text": "望诸位归国武士、故交友人等告知其人下落，或提供线索。必有重谢！",
            "nextDialogs": [
              "5180703"
            ]
          },
          "5180703": {
            "id": "5180703",
            "speakerId": 1005,
            "speakerName": "寻人启事",
            "text": "稻叶静子，敬上。"
          }
        }
      }
    },
    {
      "subId": "51808",
      "subQuestName": "",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "5180801"
        ],
        "dialogs": {
          "5180801": {
            "id": "5180801",
            "speakerId": 1003,
            "speakerName": "留言",
            "text": "「之前一直在后方做辎重工作，错过了稻妻城的盛景，今日终于得偿所愿。」",
            "nextDialogs": [
              "5180802"
            ]
          },
          "5180802": {
            "id": "5180802",
            "speakerId": 1003,
            "speakerName": "留言",
            "text": "「离岛的本地人非常拘谨，或许因为此前不久我们还是兵刃相交的敌人吧…」",
            "nextDialogs": [
              "5180803"
            ]
          },
          "5180803": {
            "id": "5180803",
            "speakerId": 1003,
            "speakerName": "留言",
            "text": "「但外国人却非常欢迎我们，到处都有对海祇人大打折扣的舶来店铺…」",
            "nextDialogs": [
              "5180804"
            ]
          },
          "5180804": {
            "id": "5180804",
            "speakerId": 1003,
            "speakerName": "留言",
            "text": "「看起来我们的行动确实让他们的生活轻松了不少…此前的诸多不幸并非没有意义。」"
          }
        }
      }
    },
    {
      "subId": "51809",
      "subQuestName": "",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "5180901"
        ],
        "dialogs": {
          "5180901": {
            "id": "5180901",
            "speakerId": 1006,
            "speakerName": "荒泷完眼归我一斗",
            "text": "「哈哈！自从夺回了神之眼，浑身干劲十足呀！！本大爷的斗志又回来了！」",
            "nextDialogs": [
              "5180902"
            ]
          },
          "5180902": {
            "id": "5180902",
            "speakerId": 1006,
            "speakerName": "荒泷完眼归我一斗",
            "text": "「混蛋天狗！听说你打了败仗夹着尾巴回来了，我做梦都要笑醒了，哈哈哈哈哈！！」",
            "nextDialogs": [
              "5180903"
            ]
          },
          "5180903": {
            "id": "5180903",
            "speakerId": 1006,
            "speakerName": "荒泷完眼归我一斗",
            "text": "「本大爷就在港口等着你！正要好好嘲笑你一顿呢，可别忘了决斗的事情！！」",
            "nextDialogs": [
              "5180904"
            ]
          },
          "5180904": {
            "id": "5180904",
            "speakerId": 1004,
            "speakerName": "回复",
            "text": "烦死了，知道了！！",
            "nextDialogs": [
              "5180905"
            ]
          },
          "5180905": {
            "id": "5180905",
            "speakerId": 1001,
            "speakerName": "勘定公告",
            "text": "此条留言由裟罗大人特令保留，请诸位役人莫要清除。",
            "nextDialogs": [
              "5180906"
            ]
          },
          "5180906": {
            "id": "5180906",
            "speakerId": 1004,
            "speakerName": "回复",
            "text": "我没说过！赶紧给我清理掉！！你们远国监司就没有一个会办事的人吗！！"
          }
        }
      }
    },
    {
      "subId": "51810",
      "subQuestName": "",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "5181001"
        ],
        "dialogs": {
          "5181001": {
            "id": "5181001",
            "speakerId": 1003,
            "speakerName": "留言",
            "text": "「看到此前节节败退的『叛贼』如今却大摇大摆地在离岛商铺闲逛…」",
            "nextDialogs": [
              "5181002"
            ]
          },
          "5181002": {
            "id": "5181002",
            "speakerId": 1003,
            "speakerName": "留言",
            "text": "「再想想此前为这场战争的付出与伤痛…苦涩之感油然而生。」",
            "nextDialogs": [
              "5181003"
            ]
          },
          "5181003": {
            "id": "5181003",
            "speakerId": 1003,
            "speakerName": "留言",
            "text": "「但无论如何，活着回来就好，还能与亲人相聚就好…战争太让人疲累了。」",
            "nextDialogs": [
              "5181004"
            ]
          },
          "5181004": {
            "id": "5181004",
            "speakerId": 1007,
            "speakerName": "另一人的留言",
            "text": "「尽管身为敌人的立场，或许不太方便说什么…」",
            "nextDialogs": [
              "5181005"
            ]
          },
          "5181005": {
            "id": "5181005",
            "speakerId": 1007,
            "speakerName": "另一人的留言",
            "text": "「但和平总是新的机遇，听说稻妻的『乌有亭』很有名，有时间去喝一杯吧。」",
            "nextDialogs": [
              "5181006"
            ]
          },
          "5181006": {
            "id": "5181006",
            "speakerId": 1003,
            "speakerName": "留言",
            "text": "「少在这里套近乎了。」"
          }
        }
      }
    },
    {
      "subId": "51811",
      "subQuestName": "",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "5181101"
        ],
        "dialogs": {
          "5181101": {
            "id": "5181101",
            "speakerId": 1003,
            "speakerName": "留言",
            "text": "「今日特地来到离岛，寻访那位曾在战场上斩过我一剑的天领武士。」",
            "nextDialogs": [
              "5181102"
            ]
          },
          "5181102": {
            "id": "5181102",
            "speakerId": 1003,
            "speakerName": "留言",
            "text": "「多谢上次未伤要害，不如再行比试。」",
            "nextDialogs": [
              "5181103"
            ]
          },
          "5181103": {
            "id": "5181103",
            "speakerId": 1007,
            "speakerName": "另一人的留言",
            "text": "「只可惜如今天下总无事，大御所殿下禁止了御前试合之外的一切真剑比试。」",
            "nextDialogs": [
              "5181104"
            ]
          },
          "5181104": {
            "id": "5181104",
            "speakerId": 1003,
            "speakerName": "留言",
            "text": "「无趣！无趣！不如去喝酒！」",
            "nextDialogs": [
              "5181105"
            ]
          },
          "5181105": {
            "id": "5181105",
            "speakerId": 1007,
            "speakerName": "另一人的留言",
            "text": "「说起喝酒，我倒是知道有一个好去处，我们约在港口集合？」",
            "nextDialogs": [
              "5181106"
            ]
          },
          "5181106": {
            "id": "5181106",
            "speakerId": 1003,
            "speakerName": "留言",
            "text": "「甚好，甚好！」"
          }
        }
      }
    },
    {
      "subId": "51812",
      "subQuestName": "",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "5181201"
        ],
        "dialogs": {
          "5181201": {
            "id": "5181201",
            "speakerId": 1008,
            "speakerName": "鸣神大社公告",
            "text": "经神子大人允许，近期大社将再度举行盛大事会。",
            "nextDialogs": [
              "5181202"
            ]
          },
          "5181202": {
            "id": "5181202",
            "speakerId": 1008,
            "speakerName": "鸣神大社公告",
            "text": "机会难得，还请诸位巫女神官、事务奉行等早做准备！"
          }
        }
      }
    },
    {
      "subId": "51813",
      "subQuestName": "",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "5181301"
        ],
        "dialogs": {
          "5181301": {
            "id": "5181301",
            "speakerId": 1003,
            "speakerName": "留言",
            "text": "「虽然战争终于平息了，但海贼仍然在许多海域肆虐，诸位朋友远行依然要注意安全。」",
            "nextDialogs": [
              "5181302"
            ]
          },
          "5181302": {
            "id": "5181302",
            "speakerId": 1003,
            "speakerName": "留言",
            "text": "「听说官府正在和珊瑚宫那边谈判，以后或许会恢复海上协防的协议。」",
            "nextDialogs": [
              "5181303"
            ]
          },
          "5181303": {
            "id": "5181303",
            "speakerId": 1007,
            "speakerName": "另一人的留言",
            "text": "「如果是那样的话，就太好了。」"
          }
        }
      }
    },
    {
      "subId": "51814",
      "subQuestName": "",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "5181401"
        ],
        "dialogs": {
          "5181401": {
            "id": "5181401",
            "speakerId": 1009,
            "speakerName": "幕府通告",
            "text": "鉴于此前战时在踏鞴砂与八酝岛发生的诸多惨剧，大御所殿下与海祇现人神巫女均深感悲痛。",
            "nextDialogs": [
              "5181402"
            ]
          },
          "5181402": {
            "id": "5181402",
            "speakerId": 1009,
            "speakerName": "幕府通告",
            "text": "自今以后，幕府将与珊瑚宫方面携手共同努力重建诸地，再议合作开发事宜。",
            "nextDialogs": [
              "5181403"
            ]
          },
          "5181403": {
            "id": "5181403",
            "speakerId": 1009,
            "speakerName": "幕府通告",
            "text": "战乱之平息，罪魁之服法，实稻妻国之大幸。",
            "nextDialogs": [
              "5181404"
            ]
          },
          "5181404": {
            "id": "5181404",
            "speakerId": 1009,
            "speakerName": "幕府通告",
            "text": "我等今后更应追随将军殿下之神威明智，谐和并行，终将成就恒常之大业。"
          }
        }
      }
    },
    {
      "subId": "51815",
      "subQuestName": "",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "5181501"
        ],
        "dialogs": {
          "5181501": {
            "id": "5181501",
            "speakerId": 1003,
            "speakerName": "留言",
            "text": "「勘定奉行有限恢复了几条商路，尽管对于较大的商铺而言仍然只能带来微薄的收入…」",
            "nextDialogs": [
              "5181502"
            ]
          },
          "5181502": {
            "id": "5181502",
            "speakerId": 1003,
            "speakerName": "留言",
            "text": "「但相应的，在社奉行大人委派的监察努力下，许多苛捐杂税被取消了。」",
            "nextDialogs": [
              "5181503"
            ]
          },
          "5181503": {
            "id": "5181503",
            "speakerId": 1003,
            "speakerName": "留言",
            "text": "「对于我们外国人而言，或许清贫经营的日子还要持续很长时间，但至少大家都有了喘息的空间…」",
            "nextDialogs": [
              "5181504"
            ]
          },
          "5181504": {
            "id": "5181504",
            "speakerId": 1003,
            "speakerName": "留言",
            "text": "「无论如何，世道有所改变，真是太好了。」"
          }
        }
      }
    },
    {
      "subId": "51816",
      "subQuestName": "",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "5181601"
        ],
        "dialogs": {
          "5181601": {
            "id": "5181601",
            "speakerId": 1003,
            "speakerName": "留言",
            "text": "「曾经和我一起下海捞鱼的老友回来了，军旅生涯让他忧郁了许多。」",
            "nextDialogs": [
              "5181602"
            ]
          },
          "5181602": {
            "id": "5181602",
            "speakerId": 1003,
            "speakerName": "留言",
            "text": "「虽然街坊邻居因为他参加过反抗军而多少有点顾虑，不愿意太多来往…」",
            "nextDialogs": [

    {
      "subId": "600399",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "60039904"
        ],
        "dialogs": {
          "60039904": {
            "id": "60039904",
            "speakerId": 16700,
            "speakerName": "多托雷",
            "text": "抱歉抱歉，掳走你的伙伴并非我本意。",
            "nextDialogs": [
              "60039905"
            ]
          },
          "60039905": {
            "id": "60039905",
            "speakerId": 16700,
            "speakerName": "多托雷",
            "text": "但这并非没有选择，只要你愿意顺从，我自然也能放他们自由。",
            "nextDialogs": [
              "60039906"
            ]
          },
          "60039906": {
            "id": "60039906",
            "speakerId": 16700,
            "speakerName": "多托雷",
            "text": "这可是相当理想的交易。不考虑考虑吗？"
          }
        }
      }
    },
    {
      "subId": "601699",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "60169901"
        ],
        "dialogs": {
          "60169901": {
            "id": "60169901",
            "speakerId": 1314,
            "speakerName": "菲林斯",
            "text": "哦？把我转移到了未知的结界内。",

    {
      "subId": "601607",
      "subQuestName": "击败眼前的敌人",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "60160701"
        ],
        "dialogs": {
          "60160701": {
            "id": "60160701",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "（……！！）",
            "nextDialogs": [
              "60160702"
            ]
          },
          "60160702": {
            "id": "60160702",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "（有什么东西过来了…是「博士」的爪牙吗？）",
            "nextDialogs": [
              "60160703"
            ]
          },
          "60160703": {
            "id": "60160703",
            "speakerId": 1316,
            "speakerName": "奈芙尔",
            "text": "来了，数量还不少。",
            "nextDialogs": [
              "60160704"
            ]
          },
          "60160704": {
            "id": "60160704",
            "speakerId": 1315,
            "speakerName": "菈乌玛",
            "text": "和预期一样。",
            "nextDialogs": [
              "60160705"
            ]
          },
          "60160705": {
            "id": "60160705",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "各位！准备好！",
            "nextDialogs": [
              "60160706"
            ]
          },
          "60160706": {
            "id": "60160706",
            "speakerId": 1314,
            "speakerName": "菲林斯",
            "text": "到指定地点迎战！",
            "nextDialogs": [
              "60160707"
            ]
          },
          "60160707": {
            "id": "60160707",
            "speakerId": 1018,
            "speakerName": "阿贝多",
            "text": "开始吧。",
            "nextDialogs": [
              "60160708"
            ]
          },
          "60160708": {
            "id": "60160708",
            "speakerId": 1320,
            "speakerName": "杜林",
            "text": "随时可以行动！"
          }
        }
      }
    },

    {
      "subId": "601602",
      "subQuestName": "与「木偶」对话",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "60160201"
        ],
        "dialogs": {
          "60160201": {
            "id": "60160201",
            "speakerId": 1319,
            "speakerName": "「木偶」",
            "text": "喔，你们来了。",
            "nextDialogs": [
              "60160202"
            ]
          },
          "60160202": {
            "id": "60160202",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "桑多涅！进度怎么样？",
            "nextDialogs": [
              "60160203"
            ]
          },
          "60160203": {
            "id": "60160203",
            "speakerId": 1319,
            "speakerName": "「木偶」",
            "text": "你们将成为第一第二个见到我得意之作的人…或者飘浮灵？",
            "nextDialogs": [
              "60160204"
            ]
          },
          "60160204": {
            "id": "60160204",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "喂！！",
            "nextDialogs": [
              "60160205"
            ]
          },
          "60160205": {
            "id": "60160205",
            "speakerId": 1319,
            "speakerName": "「木偶」",
            "text": "不管了。来，都不许眨眼，仔细地看清楚。",
            "nextDialogs": [
              "60160206"
            ]
          },
          "60160206": {
            "id": "60160206",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "哇，是个从来没见过的东西！",
            "nextDialogs": [
              "60160207"
            ]
          },
          "60160207": {
            "id": "60160207",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "看上去很不得了！",
            "nextDialogs": [
              "60160208"
            ]
          },
          "60160208": {
            "id": "60160208",
            "speakerId": 1319,
            "speakerName": "「木偶」",
            "text": "这个计程仪直观表现了「术式」的进展。目前，它还在构建最重要的联结。",
            "nextDialogs": [
              "60160209"
            ]
          },
          "60160209": {
            "id": "60160209",
            "speakerId": 1319,
            "speakerName": "「木偶」",
            "text": "进程完成时，我会将它送到你身边。这样才能迎回哥伦比娅。",
            "nextDialogs": [
              "60160210"
            ]
          },
          "60160210": {
            "id": "60160210",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "送到身边？如果只是计算结果的话，直接用通讯仪告诉我们不就行了？",
            "nextDialogs": [
              "60160211"
            ]
          },
          "60160211": {
            "id": "60160211",
            "speakerId": 1319,
            "speakerName": "「木偶」",
            "text": "…啧。你这小东西还真是没见过世面。这不是简简单单的「算式」，而是能够构建某种规则的「术式」。",
            "nextDialogs": [
              "60160212"
            ]
          },
          "60160212": {
            "id": "60160212",
            "speakerId": 1319,
            "speakerName": "「木偶」",
            "text": "…算了，说多了你们也不明白，总之只要知道它是哥伦比娅回来所需的必要条件就行了。",
            "nextDialogs": [
              "60160213"
            ]
          },
          "60160213": {
            "id": "60160213",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "我明白了。",
            "nextDialogs": [
              "60160214"
            ]
          },
          "60160214": {
            "id": "60160214",
            "speakerId": 1319,
            "speakerName": "「木偶」",
            "text": "我把这些数据分享给你。尼可同意我使用她构建的信息通道，所以可以通过嘟嘟通讯仪，像这样…",
            "nextDialogs": [
              "60160215"
            ]
          },
          "60160215": {
            "id": "60160215",
            "speakerId": 1319,
            "speakerName": "「木偶」",
            "text": "好了。现在你也可以查看进程了。",
            "nextDialogs": [
              "60160216"
            ]
          },
          "60160216": {
            "id": "60160216",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "真的有欸！你好厉害！",
            "nextDialogs": [
              "60160217"
            ]
          },
          "60160217": {
            "id": "60160217",
            "speakerId": 1319,
            "speakerName": "「木偶」",
            "text": "废话，我一直很厉害，哈哈哈哈。",
            "nextDialogs": [
              "60160218"
            ]
          },
          "60160218": {
            "id": "60160218",
            "speakerId": 1319,
            "speakerName": "「木偶」",
            "text": "嗯，我需要交代给你的就这些。接下来要是有空，也去看看其他人，监督一下他们，别让任何人掉链子。",
            "nextDialogs": [
              "60160219"
            ]
          },
          "60160219": {
            "id": "60160219",
            "speakerId": 1319,
            "speakerName": "「木偶」",
            "text": "在愚人众，这类监督不属于苛责的范畴。我只是希望一切顺利。",
            "nextDialogs": [
              "60160220"
            ]
          },
          "60160220": {
            "id": "60160220",
            "speakerId": 1319,
            "speakerName": "「木偶」",
            "text": "目前术式还在运转，我不方便移动。你就作为我的第二双眼睛，去完成使命吧。"
          }
        }
      }
    },
    {
      "subId": "601603",
      "subQuestName": "与同伴们对话",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "60160301"
        ],
        "dialogs": {
          "60160301": {
            "id": "60160301",
            "speakerId": 1314,
            "speakerName": "菲林斯",
            "text": "#{NICKNAME}，派蒙，很高兴见到你们。",
            "nextDialogs": [
              "60160302"
            ]
          },
          "60160302": {
            "id": "60160302",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "菲林斯！你这边准备得怎么样？",
            "nextDialogs": [
              "60160303"
            ]
          },
          "60160303": {
            "id": "60160303",
            "speakerId": 1314,
            "speakerName": "菲林斯",
            "text": "还不错。我已经做好正面迎战多托雷的准备了。",
            "nextDialogs": [
              "60160304"
            ]
          },
          "60160304": {
            "id": "60160304",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "哦哦，这一次看起来比平时还认真些呢。",
            "nextDialogs": [
              "60160305"
            ]
          },
          "60160305": {
            "id": "60160305",
            "speakerId": 1314,
            "speakerName": "菲林斯",
            "text": "说真的，我平时不怎么喜欢全力以赴。那不利于隐藏身份，对吧？再说，一个人应当有选择地展露实力。",
            "nextDialogs": [
              "60160306"
            ]
          },
          "60160306": {
            "id": "60160306",
            "speakerId": 1314,
            "speakerName": "菲林斯",
            "text": "养精蓄锐，更好地赢下关键之战。目前我正处于这个状态。",
            "nextDialogs": [
              "60160307"
            ]
          },
          "60160307": {
            "id": "60160307",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "#能看到你认真，心里都踏实了几分。对吧{NICKNAME}？",
            "nextDialogs": [
              "60160310"
            ]
          },
          "60160310": {
            "id": "60160310",
            "speakerId": 1314,
            "speakerName": "菲林斯",
            "text": "能得到两位的信任，我很荣幸。",
            "nextDialogs": [
              "60160311"
            ]
          },
          "60160311": {
            "id": "60160311",
            "speakerId": 1314,
            "speakerName": "菲林斯",
            "text": "还请好好休息。我衷心希望，能在决战中见到精神抖擞的你们。"
          }
        }
      }
    },
    {
      "subId": "601604",
      "subQuestName": "与同伴们对话",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "60160401"
        ],
        "dialogs": {
          "60160401": {
            "id": "60160401",
            "speakerId": 1316,
            "speakerName": "奈芙尔",
            "text": "看什么呢？咏月使小姐。",
            "nextDialogs": [
              "60160402"
            ]
          },
          "60160402": {
            "id": "60160402",
            "speakerId": 1315,
            "speakerName": "菈乌玛",
            "text": "你对我的称呼还真奇怪。咏月使小姐、咏月使女士…都叫过了。",
            "nextDialogs": [
              "60160403"
            ]
          },
          "60160403": {
            "id": "60160403",
            "speakerId": 1316,
            "speakerName": "奈芙尔",
            "text": "是啊，不行吗？这不都是你吗。",
            "nextDialogs": [
              "60160404"
            ]
          },
          "60160404": {
            "id": "60160404",
            "speakerId": 1315,
            "speakerName": "菈乌玛",
            "text": "但我已经想好直接叫你奈芙尔了。",
            "nextDialogs": [
              "60160405"
            ]
          },
          "60160405": {
            "id": "60160405",
            "speakerId": 1316,
            "speakerName": "奈芙尔",
            "text": "我本来就叫这个，有什么奇怪的。",
            "nextDialogs": [
              "60160406"
            ]
          },
          "60160406": {
            "id": "60160406",
            "speakerId": 1315,
            "speakerName": "菈乌玛",
            "text": "意思是不加任何称谓，直呼其名。",
            "nextDialogs": [
              "60160407"
            ]
          },
          "60160407": {
            "id": "60160407",
            "speakerId": 1316,
            "speakerName": "奈芙尔",
            "text": "什么意思？",
            "nextDialogs": [
              "60160408"
            ]
          },
          "60160408": {
            "id": "60160408",
            "speakerId": 1315,
            "speakerName": "菈乌玛",
            "text": "也许可以证明我们的关系变融洽了。",
            "nextDialogs": [
              "60160409"
            ]
          },
          "60160409": {
            "id": "60160409",
            "speakerId": 1316,
            "speakerName": "奈芙尔",
            "text": "多么美丽的错觉。",
            "nextDialogs": [
              "60160410"
            ]
          },
          "60160410": {
            "id": "60160410",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "奈芙尔！菈乌玛！",
            "nextDialogs": [
              "60160411"
            ]
          },
          "60160411": {
            "id": "60160411",
            "speakerId": 1315,
            "speakerName": "菈乌玛",
            "text": "#派蒙，{NICKNAME}。",
            "nextDialogs": [
              "60160412"
            ]
          },
          "60160412": {
            "id": "60160412",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "我们来看看你们的情况！准备得还顺利吗？有好好休息吗？",
            "nextDialogs": [
              "60160413"
            ]
          },
          "60160413": {
            "id": "60160413",
            "speakerId": 1316,
            "speakerName": "奈芙尔",
            "text": "放心吧，不会拖大家后腿的。",
            "nextDialogs": [
              "60160414"
            ]
          },
          "60160414": {
            "id": "60160414",
            "speakerId": 1315,
            "speakerName": "菈乌玛",
            "text": "我也会全力帮助大家取得胜利。",
            "nextDialogs": [
              "60160415"
            ]
          },
          "60160415": {
            "id": "60160415",
            "speakerId": 1315,
            "speakerName": "菈乌玛",
            "text": "对了，请允许我给你们稍微检查一下…",
            "nextDialogs": [
              "60160416"
            ]
          },
          "60160416": {
            "id": "60160416",
            "speakerId": 1315,
            "speakerName": "菈乌玛",
            "text": "…好了。两位的状态都不错，真是再好不过了。",
            "nextDialogs": [
              "60160419"
            ]
          },
          "60160419": {
            "id": "60160419",
            "speakerId": 1316,
            "speakerName": "奈芙尔",
            "text": "不用客气。你不比我们任何人轻松，所以你也要好好休息，直到迎战多托雷的那一刻。",
            "nextDialogs": [
              "60160420"
            ]
          },
          "60160420": {
            "id": "60160420",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "#放心吧，我会监督{M#他}{F#她}的。",
            "nextDialogs": [
              "60160421"
            ]
          },
          "60160421": {
            "id": "60160421",
            "speakerId": 1315,
            "speakerName": "菈乌玛",
            "text": "那就好。派蒙自己也要注意休息哦。",
            "nextDialogs": [
              "60160422"
            ]
          },
          "60160422": {
            "id": "60160422",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "嗯，我记住啦！"
          }
        }
      }
    },
    {
      "subId": "601605",
      "subQuestName": "与同伴们对话",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "60160501"
        ],
        "dialogs": {
          "60160501": {
            "id": "60160501",
            "speakerId": 1320,
            "speakerName": "杜林",
            "text": "尼可小姐送来了支援，那夏镇附近现在已经构筑起完整的防御工事了！",
            "nextDialogs": [
              "60160502"
            ]
          },
          "60160502": {
            "id": "60160502",
            "speakerId": 1018,
            "speakerName": "阿贝多",
            "text": "泛着金色的火光…是尼可女士的力量。",
            "nextDialogs": [
              "60160503"
            ]
          },
          "60160503": {
            "id": "60160503",
            "speakerId": 1018,
            "speakerName": "阿贝多",
            "text": "加上刚才法尔伽团长送来的信息…嗯，他们果然商量好了。",
            "nextDialogs": [
              "60160504"
            ]
          },
          "60160504": {
            "id": "60160504",
            "speakerId": 1018,
            "speakerName": "阿贝多",
            "text": "有她帮忙，情况应该会稳定一些。至少大家可以得到最基本的保障。",
            "nextDialogs": [
              "60160505"
            ]
          },
          "60160505": {
            "id": "60160505",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "阿贝多，杜林！",
            "nextDialogs": [
              "60160506"
            ]
          },
          "60160506": {
            "id": "60160506",
            "speakerId": 1320,
            "speakerName": "杜林",
            "text": "#是{NICKNAME}和派蒙！你们好。",
            "nextDialogs": [
              "60160507"
            ]
          },
          "60160507": {
            "id": "60160507",
            "speakerId": 1018,
            "speakerName": "阿贝多",
            "text": "休息得还好吗？",
            "nextDialogs": [
              "60160508"
            ]
          },
          "60160508": {
            "id": "60160508",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "谢谢关心，还不错。",
            "nextDialogs": [
              "60160509"
            ]
          },
          "60160509": {
            "id": "60160509",
            "speakerId": 1320,
            "speakerName": "杜林",
            "text": "那我们就放心了。",
            "nextDialogs": [
              "60160510"
            ]
          },
          "60160510": {
            "id": "60160510",
            "speakerId": 1320,
            "speakerName": "杜林",
            "text": "按照计划，那夏镇交给我和阿贝多。",
            "nextDialogs": [
              "60160511"
            ]
          },
          "60160511": {
            "id": "60160511",
            "speakerId": 1320,
            "speakerName": "杜林",
            "text": "虽说多托雷的能量界域一直在不断向这里拓张…我们会竭尽全力守住阵地的。",
            "nextDialogs": [
              "60160512"
            ]
          },
          "60160512": {
            "id": "60160512",
            "speakerId": 1018,
            "speakerName": "阿贝多",
            "text": "我们并肩作战过很多次，每一次都取得了好的结果。",
            "nextDialogs": [
              "60160513"
            ]
          },
          "60160513": {
            "id": "60160513",
            "speakerId": 1018,
            "speakerName": "阿贝多",
            "text": "这次一定也是如此，所以，尽管去战斗吧。"
          }
        }
      }
    },

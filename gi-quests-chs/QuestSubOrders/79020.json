    {
      "subId": "7902005",
      "subQuestName": "（test)收集危危岛藏宝图$HIDDEN",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "790200501"
        ],
        "dialogs": {
          "790200501": {
            "id": "790200501",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "这下我们四个线索全部拿到啦…",
            "nextDialogs": [
              "790200502"
            ]
          },
          "790200502": {
            "id": "790200502",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "…唔，完全看不懂到底藏在哪里…",
            "nextDialogs": [
              "790200503"
            ]
          },
          "790200503": {
            "id": "790200503",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "这个以什么什么为心，是什么意思啊？",
            "nextDialogs": [
              "790200506"
            ]
          },
          "790200506": {
            "id": "790200506",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "是这样啊，这样就能在地图上画出四个圈，唔，这个以船长为半径…到底是多长啊…",
            "nextDialogs": [
              "790200507"
            ]
          },
          "790200507": {
            "id": "790200507",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "不如参考见过的船…",
            "nextDialogs": [
              "790200508"
            ]
          },
          "790200508": {
            "id": "790200508",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "嗯，那就把以前在港口看见的大船当参考…唔…",
            "nextDialogs": [
              "790200509"
            ]
          },
          "790200509": {
            "id": "790200509",
            "speakerId": 1001,
            "speakerName": "Black Screen",
            "text": "派蒙按照提示在地图上画出了四个圈",
            "nextDialogs": [
              "790200510"
            ]
          },
          "790200510": {
            "id": "790200510",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "这样就画出四个圈了，宝藏就在四个圈都覆盖到的地方…",
            "nextDialogs": [
              "790200511"
            ]
          },
          "790200511": {
            "id": "790200511",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "嗯，那就是藏宝藏的地方了！"
          }
        }
      }
    },
    {
      "subId": "7902006",
      "subQuestName": "（test)收集布丁岛藏宝图$HIDDEN",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "790200601"
        ],
        "dialogs": {
          "790200601": {
            "id": "790200601",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "原来这就是「赤穗百目鬼一众」藏的秘宝，不过…他们那个时候就能把秘宝藏在云阶上吗…",
            "nextDialogs": [
              "790200602"
            ]
          },
          "790200602": {
            "id": "790200602",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "总觉得有点奇怪…",
            "nextDialogs": [
              "790200605"
            ]
          },
          "790200605": {
            "id": "790200605",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "对啊，那不都是因为机器影响才出现的嘛…难道这个宝藏真的是他们藏起来的吗…",
            "nextDialogs": [
              "790200606"
            ]
          },
          "790200606": {
            "id": "790200606",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "可能是宝藏想被找到吧…",
            "nextDialogs": [
              "790200607"
            ]
          },
          "790200607": {
            "id": "790200607",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "嗯，也可能是藏下秘宝的人，希望秘宝被找到的想法，被机器影响了呢……",
            "nextDialogs": [
              "790200608"
            ]
          },
          "790200608": {
            "id": "790200608",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "不过无论如何，秘宝就归我们啦！"
          }
        }
      }
    },

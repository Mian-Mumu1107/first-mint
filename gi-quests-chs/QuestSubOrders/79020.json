  "subQuests": [
    {
      "subId": "7902001",
      "subQuestName": "(test）隐藏环$HIDDEN",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "790200101"
        ],
        "dialogs": {
          "790200101": {
            "id": "790200101",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "我看看，嗯…这说不定是什么宝藏的地图！",
            "nextDialogs": [
              "790200102"
            ]
          },
          "790200102": {
            "id": "790200102",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "真的吗？",
            "nextDialogs": [
              "790200103"
            ]
          },
          "790200103": {
            "id": "790200103",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "哼，我闻到了宝藏的味道，肯定是这样的！",
            "nextDialogs": [
              "790200116"
            ]
          },
          "790200116": {
            "id": "790200116",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "你看，留下图的是「海盗赤穗百目鬼一众」，总觉得是在哪里听到过的名字！",
            "nextDialogs": [
              "790200104"
            ]
          },
          "790200104": {
            "id": "790200104",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "而且你看，「秘宝所藏之处…」果然有秘宝！",
            "nextDialogs": [
              "790200105"
            ]
          },
          "790200105": {
            "id": "790200105",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "嗯，接下来是…「其中隐秘…一分为四…」",
            "nextDialogs": [
              "790200106"
            ]
          },
          "790200106": {
            "id": "790200106",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "一分为四，是把什么东西分成了四个的意思吗？",
            "nextDialogs": [
              "790200109"
            ]
          },
          "790200109": {
            "id": "790200109",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "不知道…",
            "nextDialogs": [
              "790200110"
            ]
          },
          "790200110": {
            "id": "790200110",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "不过这边说「置于四座大岛礁石之处」，应该是说藏在金苹果群岛上的四座岛的礁石…",
            "nextDialogs": [
              "790200111"
            ]
          },
          "790200111": {
            "id": "790200111",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "啊，这里不就是礁石吗！",
            "nextDialogs": [
              "790200112"
            ]
          },
          "790200112": {
            "id": "790200112",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "看来有四份的是藏宝线索…",
            "nextDialogs": [
              "790200113"
            ]
          },
          "790200113": {
            "id": "790200113",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "而且还在四个岛的礁石附近！",
            "nextDialogs": [
              "790200114"
            ]
          },
          "790200114": {
            "id": "790200114",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "说起金苹果群岛的四个岛，那就肯定是最大的四个了！",
            "nextDialogs": [
              "790200115"
            ]
          },
          "790200115": {
            "id": "790200115",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "我们就去其他三个岛的礁石附近找找看吧！"
          }
        }
      }
    },

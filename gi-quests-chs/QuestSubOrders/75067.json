{
  "lineCounts": {
    "夸恩因": 24
  },
  "subQuests": [
    {
      "subId": "7506701",
      "subQuestName": "",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "750670101"
        ],
        "dialogs": {
          "750670101": {
            "id": "750670101",
            "speakerId": 21610,
            "speakerName": "夸恩因",
            "text": "这些非人之物还真是难缠，非人的怪物。勇士啊…我是冒险团的夸恩因，我的职责…",
            "nextDialogs": [
              "750670102"
            ]
          },
          "750670102": {
            "id": "750670102",
            "speakerId": 21610,
            "speakerName": "夸恩因",
            "text": "我的职责…就是清理这些怪物，对，我是冒险团里的战士，小心，勇士…",
            "nextDialogs": [
              "750670103"
            ]
          },
          "750670103": {
            "id": "750670103",
            "speakerId": 21610,
            "speakerName": "夸恩因",
            "text": "这些怪物，非常狡猾，会伪装成不同的样子。",
            "nextDialogs": [
              "750670104"
            ]
          },
          "750670104": {
            "id": "750670104",
            "speakerId": 21610,
            "speakerName": "夸恩因",
            "text": "每天夜里，在入睡之前都会听见…听见躲藏在这古老废墟里的它们的声音，所以才…无法在营地入睡。",
            "nextDialogs": [
              "750670105"
            ]
          },
          "750670105": {
            "id": "750670105",
            "speakerId": 21610,
            "speakerName": "夸恩因",
            "text": "这里全是这样的怪物。你们也…也要小心啊。"
          }
        }
      }
    },
    {
      "subId": "7506702",
      "subQuestName": "",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "750670201"
        ],
        "dialogs": {
          "750670201": {
            "id": "750670201",
            "speakerId": 21610,
            "speakerName": "夸恩因",
            "text": "啊，这里果然是被诅咒了的地方…",
            "nextDialogs": [
              "750670202"
            ]
          },
          "750670202": {
            "id": "750670202",
            "speakerId": 21610,
            "speakerName": "夸恩因",
            "text": "你们也不要过多停留了，快点离去吧…对，在漆黑的潮水到来之前，你们一定要离去才行。",
            "nextDialogs": [
              "750670203"
            ]
          },
          "750670203": {
            "id": "750670203",
            "speakerId": 21610,
            "speakerName": "夸恩因",
            "text": "对，漆黑的潮水，那巨大的影子就要来了，得…得让大家安全离开，要让大家…安全离开。"
          }
        }
      }
    },
    {
      "subId": "7506703",
      "subQuestName": "",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "750670301"
        ],
        "dialogs": {
          "750670301": {
            "id": "750670301",
            "speakerId": 21610,
            "speakerName": "夸恩因",
            "text": "你们怎么还逗留在此处呢…",
            "nextDialogs": [
              "750670302"
            ]
          },
          "750670302": {
            "id": "750670302",
            "speakerId": 21610,
            "speakerName": "夸恩因",
            "text": "冒险团的领队，那位戴着鹰隼战面的英雄都已经…我们已经无力抵挡…",
            "nextDialogs": [
              "750670303"
            ]
          },
          "750670303": {
            "id": "750670303",
            "speakerId": 21610,
            "speakerName": "夸恩因",
            "text": "快走吧，快走吧，这里是被诅咒之地啊，勇士，不是人该涉足的地方。"
          }
        }
      }
    },
    {
      "subId": "7506704",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "750670401"
        ],
        "dialogs": {
          "750670401": {
            "id": "750670401",
            "speakerId": 21682,
            "speakerName": "夸恩因",
            "text": "你还在这里啊，勇士。",
            "nextDialogs": [
              "750670402"
            ]
          },
          "750670402": {
            "id": "750670402",
            "speakerId": 21682,
            "speakerName": "夸恩因",
            "text": "从前，有学者说，这座烬城之中，古老暴虐的城主有…阻止深渊侵蚀的办法，于是我们…",
            "nextDialogs": [
              "750670403"
            ]
          },
          "750670403": {
            "id": "750670403",
            "speakerId": 21682,
            "speakerName": "夸恩因",
            "text": "可是，这真是邪门的地方啊，勇士，我最近也觉得、觉得有点奇怪了。",
            "nextDialogs": [
              "750670404"
            ]
          },
          "750670404": {
            "id": "750670404",
            "speakerId": 21682,
            "speakerName": "夸恩因",
            "text": "有的时候，前一天还完整的路，一觉醒来，就变得破破烂烂的…那些石头屋子原本是那样吗，总觉得，应该更完整一些。",
            "nextDialogs": [
              "750670405"
            ]
          },
          "750670405": {
            "id": "750670405",
            "speakerId": 21682,
            "speakerName": "夸恩因",
            "text": "但有的时候，醒来却能看到本来不应该再出现的朋友…那些是怪物吗？大概，是变成我朋友模样的怪物吧。",
            "nextDialogs": [
              "750670406"
            ]
          },
          "750670406": {
            "id": "750670406",
            "speakerId": 21682,
            "speakerName": "夸恩因",
            "text": "我要…我在这里担负的职责就是，清理掉那些怪物，但是为什么…为什么我要那么做？",
            "nextDialogs": [
              "750670407"
            ]
          },
          "750670407": {
            "id": "750670407",
            "speakerId": 21682,
            "speakerName": "夸恩因",
            "text": "总之，这是奇怪的地方，你们还是…快点离开吧。"
          }
        }
      }
    },
    {
      "subId": "7506705",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "750670501"
        ],
        "dialogs": {
          "750670501": {
            "id": "750670501",
            "speakerId": 21610,
            "speakerName": "夸恩因",
            "text": "你们还是快点走吧，再不走就来不及了…",
            "nextDialogs": [
              "750670502"
            ]
          },
          "750670502": {
            "id": "750670502",
            "speakerId": 21610,
            "speakerName": "夸恩因",
            "text": "为什么来不及…对，因为，因为冒险团已经全军覆没了，所有人都被…都被那只漆黑的巨兽…",
            "nextDialogs": [
              "750670503"
            ]
          },
          "750670503": {
            "id": "750670503",
            "speakerId": 21610,
            "speakerName": "夸恩因",
            "text": "他们让我保护那些撤离的人，至少要让他们离开这座城，「花羽会」的救援就在路上…",
            "nextDialogs": [
              "750670504"
            ]
          },
          "750670504": {
            "id": "750670504",
            "speakerId": 21610,
            "speakerName": "夸恩因",
            "text": "我要清除掉这些邪恶的魔物，这样，那些剩下的人才能回到光明照耀的土地…咦，可是，为什么我在这里？",
            "nextDialogs": [
              "750670505"
            ]
          },
          "750670505": {
            "id": "750670505",
            "speakerId": 21610,
            "speakerName": "夸恩因",
            "text": "耳边的声音…唔，耳边的声音变得越来越重，我…得回到瀑布那才行，我得…回到瀑布那边。",
            "nextDialogs": [
              "750670506"
            ]
          },
          "750670506": {
            "id": "750670506",
            "speakerId": 21610,
            "speakerName": "夸恩因",
            "text": "勇士，你们也要，早点离开为妙啊。"
          }
        }
      }
    }
  ]
}
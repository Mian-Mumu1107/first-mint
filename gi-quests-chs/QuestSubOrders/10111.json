        ],
        "dialogs": {
          "101100919": {
            "id": "101100919",
            "speakerId": 1004,
            "speakerName": "艾琳",
            "text": "那就拜托你们了！",
            "nextDialogs": [
              "101100920"
            ]
          },
          "101100920": {
            "id": "101100920",
            "speakerId": 1004,
            "speakerName": "艾琳",
            "text": "杰克在<color=#00E1FFFF>南风之狮的庙宇</color>，别忘了哦。"
          }
        }
      }
    }

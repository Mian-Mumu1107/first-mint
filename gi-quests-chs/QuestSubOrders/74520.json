    {
      "subId": "7452004",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "745200401"
        ],
        "dialogs": {
          "745200401": {
            "id": "745200401",
            "speakerId": 1000,
            "speakerName": "优菈",
            "text": "#是你啊，{NICKNAME}，没想到能在这种地方遇到你。",
            "nextDialogs": [
              "745200404"
            ]
          },
          "745200404": {
            "id": "745200404",
            "speakerId": 1000,
            "speakerName": "优菈",
            "text": "算是例行巡视。不过，对我而言，更像是保持战斗状态的必要活动。",
            "nextDialogs": [
              "745200405"
            ]
          },
          "745200405": {
            "id": "745200405",
            "speakerId": 1000,
            "speakerName": "优菈",
            "text": "最近蒙德相对太平，值得游击小队全体出动的威胁几乎没有。队里的大家…精神上确实放松了不少。",
            "nextDialogs": [
              "745200406"
            ]
          },
          "745200406": {
            "id": "745200406",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "劳逸结合也是好事嘛。",
            "nextDialogs": [
              "745200407"
            ]
          },
          "745200407": {
            "id": "745200407",
            "speakerId": 1000,
            "speakerName": "优菈",
            "text": "话虽如此，但我作为队长，必须要时刻保持自己的战斗力。",
            "nextDialogs": [
              "745200408"
            ]
          },
          "745200408": {
            "id": "745200408",
            "speakerId": 1000,
            "speakerName": "优菈",
            "text": "毕竟，敌人的剑可不会因为和平而变得迟钝。",
            "nextDialogs": [
              "745200409"
            ]
          },
          "745200409": {
            "id": "745200409",
            "speakerId": 1000,
            "speakerName": "优菈",
            "text": "所以，我习惯在巡视的间隙，找个僻静的地方练习剑术，确保姿态不会生疏。"
          }
        }
      }
    }
  ]

  "subQuests": [
    {
      "subId": "2301101",
      "subQuestName": "与维克多对话",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "230110101"
        ],
        "dialogs": {
          "230110101": {
            "id": "230110101",
            "speakerId": 1000,
            "speakerName": "维克多",
            "text": "呃…这里该怎么雕来着…",
            "nextDialogs": [
              "230110104"
            ]
          },
          "230110104": {
            "id": "230110104",
            "speakerId": 1000,
            "speakerName": "维克多",
            "text": "哎呀，谁啊，别吵我，我正…",
            "nextDialogs": [
              "230110105"
            ]
          },
          "230110105": {
            "id": "230110105",
            "speakerId": 1000,
            "speakerName": "维克多",
            "text": "啊？！旅行者？！你怎么也来须弥了？",
            "nextDialogs": [
              "230110106"
            ]
          },
          "230110106": {
            "id": "230110106",
            "speakerId": 1000,
            "speakerName": "维克多",
            "text": "不会是鲁道夫那家伙派你来揍我的吧，我就是很久之前送了莉莉一点礼物而已啊！"
          }
        }
      }
    },
    {
      "subId": "2301102",
      "subQuestName": "与哈马维对话",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "230110301"
        ],
        "dialogs": {
          "230110301": {
            "id": "230110301",
            "speakerId": 1001,
            "speakerName": "哈马维",
            "text": "真是倒霉…",
            "nextDialogs": [
              "230110302"
            ]
          },
          "230110302": {
            "id": "230110302",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "关于维克多的木头…",
            "nextDialogs": [
              "230110303"
            ]
          },
          "230110303": {
            "id": "230110303",
            "speakerId": 1001,
            "speakerName": "哈马维",
            "text": "你是说那个愚人众找我订的木头吧。",
            "nextDialogs": [
              "230110304"
            ]
          },
          "230110304": {
            "id": "230110304",
            "speakerId": 1001,
            "speakerName": "哈马维",
            "text": "唉，别提了，我就说和愚人众做生意不会有好运气。",
            "nextDialogs": [
              "230110305"
            ]
          },
          "230110305": {
            "id": "230110305",
            "speakerId": 1001,
            "speakerName": "哈马维",
            "text": "那批木头运到一半就被魔物袭击了，人是全跑回来了，但车毁了，木头都丢在了半路上。",
            "nextDialogs": [
              "230110306"
            ]
          },
          "230110306": {
            "id": "230110306",
            "speakerId": 1001,
            "speakerName": "哈马维",
            "text": "唉，现在这情况，我是不敢过去了，一时半会也找不到人去赶走那些魔物…",
            "nextDialogs": [
              "230110308"
            ]
          },
          "230110308": {
            "id": "230110308",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "我不是愚人众…",
            "nextDialogs": [
              "230110309"
            ]
          },
          "230110309": {
            "id": "230110309",
            "speakerId": 1001,
            "speakerName": "哈马维",
            "text": "你不是愚人众吗？那你怎么帮他做事？奇怪…",
            "nextDialogs": [
              "230110310"
            ]
          },
          "230110310": {
            "id": "230110310",
            "speakerId": 1001,
            "speakerName": "哈马维",
            "text": "无论如何，那辆车我暂时是拉不回来了，我只能等到能雇到人之后再想办法。",
            "nextDialogs": [
              "230110311"
            ]
          },
          "230110311": {
            "id": "230110311",
            "speakerId": 1001,
            "speakerName": "哈马维",
            "text": "如果你着急要木头的话，我把那辆车大概的地方给你标在地图上，你自己过去看看吧。",
            "nextDialogs": [
              "230110312"
            ]
          },
          "230110312": {
            "id": "230110312",
            "speakerId": 1001,
            "speakerName": "哈马维",
            "text": "唉，只要和愚人众沾边果然就遇不上好事…"
          }
        }
      }
    },
    {
      "subId": "2301107",
      "subQuestName": "打倒所有蕈兽$HIDDEN",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "230110701"
        ],
        "dialogs": {
          "230110701": {
            "id": "230110701",
            "speakerId": 1000,
            "speakerName": "维克多",
            "text": "怎么样，我买的木头已经到了吗？",
            "nextDialogs": [
              "230110702"
            ]
          },
          "230110702": {
            "id": "230110702",
            "speakerId": 1002,
            "speakerName": "Black Screen",
            "text": "向维克多叙述了事情的过程…",
            "nextDialogs": [
              "230110703"
            ]
          },
          "230110703": {
            "id": "230110703",
            "speakerId": 1000,
            "speakerName": "维克多",
            "text": "又是魔物？我怎么感觉全世界的货车都很容易被魔物袭击…",
            "nextDialogs": [
              "230110704"
            ]
          },
          "230110704": {
            "id": "230110704",
            "speakerId": 1000,
            "speakerName": "维克多",
            "text": "算了，反正木头能送回来就行。",
            "nextDialogs": [
              "230110705"
            ]
          },
          "230110705": {
            "id": "230110705",
            "speakerId": 1000,
            "speakerName": "维克多",
            "text": "喏，这是说好的报酬，好好数一数吧。",
            "nextDialogs": [
              "230110706"
            ]
          },
          "230110706": {
            "id": "230110706",
            "speakerId": 1000,
            "speakerName": "维克多",
            "text": "还有…那个，莉莉还好吗？",
            "nextDialogs": [
              "230110707"
            ]
          },
          "230110707": {
            "id": "230110707",
            "speakerId": 1000,
            "speakerName": "维克多",
            "text": "我走的时候也没和那丫头当面道别，她没生气吧？",
            "nextDialogs": [
              "230110709",
              "230110711"
            ]
          },
          "230110709": {
            "id": "230110709",
            "speakerId": 1000,
            "speakerName": "维克多",
            "text": "那就行，咳…你别这么看着我，我就是关心一下啊！",
            "nextDialogs": [
              "230110714"
            ]
          },
          "230110714": {
            "id": "230110714",
            "speakerId": 1000,
            "speakerName": "维克多",
            "text": "不说这些了，再数数报酬吧，旅行者，我可是一分都没少你的。"
          },
          "230110711": {
            "id": "230110711",
            "speakerId": 1000,
            "speakerName": "维克多",
            "text": "那弗谢沃洛德先生非得踢我不可，算了吧。",
            "nextDialogs": [
              "230110712"
            ]
          },
          "230110712": {
            "id": "230110712",
            "speakerId": 1000,
            "speakerName": "维克多",
            "text": "我也不太敢直接寄信过去。",
            "nextDialogs": [
              "230110713"
            ]
          },
          "230110713": {
            "id": "230110713",
            "speakerId": 1000,
            "speakerName": "维克多",
            "text": "收到一封来自愚人众的信，听起来就不像什么好事，哈哈哈…"
          }
        }
      }
    },

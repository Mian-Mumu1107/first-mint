    "顺吉": 25
  },
  "subQuests": [
    {
      "subId": "7281201",
      "subQuestName": "与顺吉对话",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "728120101"
        ],
        "dialogs": {
          "728120101": {
            "id": "728120101",
            "speakerId": 1000,
            "speakerName": "顺吉",
            "text": "…我这次的构思就是这样。",
            "nextDialogs": [
              "728120102"
            ]
          },
          "728120102": {
            "id": "728120102",
            "speakerId": 1000,
            "speakerName": "顺吉",
            "text": "身怀绝技的忍者，用各种绝技潜入敌方的堡垒，偷取到自己想要的情报…",
            "nextDialogs": [
              "728120103"
            ]
          },
          "728120103": {
            "id": "728120103",
            "speakerId": 1001,
            "speakerName": "阿茂",
            "text": "唉…那你准备给这个忍者多少种「绝技」？",
            "nextDialogs": [
              "728120104"
            ]
          },
          "728120104": {
            "id": "728120104",
            "speakerId": 1000,
            "speakerName": "顺吉",
            "text": "这、这个…当然是要视情况而定啦。",
            "nextDialogs": [
              "728120105"
            ]
          },
          "728120105": {
            "id": "728120105",
            "speakerId": 1001,
            "speakerName": "阿茂",
            "text": "也就说，你完全没有想好这件事吧？",
            "nextDialogs": [
              "728120106"
            ]
          },
          "728120106": {
            "id": "728120106",
            "speakerId": 1000,
            "speakerName": "顺吉",
            "text": "没关系！要是事先把设定写死了，那后面的剧情也不好展开了嘛…",
            "nextDialogs": [
              "728120107"
            ]
          },
          "728120107": {
            "id": "728120107",
            "speakerId": 1001,
            "speakerName": "阿茂",
            "text": "你又来了…要是你不定好这些设定，写着写着又会变得乱七八糟了！",
            "nextDialogs": [
              "728120108"
            ]
          },
          "728120108": {
            "id": "728120108",
            "speakerId": 1000,
            "speakerName": "顺吉",
            "text": "我、我有我自己的创作方式！故事当然是要以剧情为主，怎么能被设定束缚！",
            "nextDialogs": [
              "728120109"
            ]
          },
          "728120109": {
            "id": "728120109",
            "speakerId": 1001,
            "speakerName": "阿茂",
            "text": "这观点也太不负责了，我说你啊…",
            "nextDialogs": [
              "728120110"
            ]
          },
          "728120110": {
            "id": "728120110",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "你们在吵什么呢？",
            "nextDialogs": [
              "728120111"
            ]
          },
          "728120111": {
            "id": "728120111",
            "speakerId": 1000,
            "speakerName": "顺吉",
            "text": "喔！是你啊，我正在构思一部以忍者为主题的小说呢。",
            "nextDialogs": [
              "728120112"
            ]
          },
          "728120112": {
            "id": "728120112",
            "speakerId": 1000,
            "speakerName": "顺吉",
            "text": "可是，阿茂又觉得我的构思不好了…",
            "nextDialogs": [
              "728120113"
            ]
          },
          "728120113": {
            "id": "728120113",
            "speakerId": 1001,
            "speakerName": "阿茂",
            "text": "我没有觉得你的构思不好…我是说你要脚踏实地，在动笔之前，先把设定全都定下来…",
            "nextDialogs": [
              "728120114"
            ]
          },
          "728120114": {
            "id": "728120114",
            "speakerId": 1000,
            "speakerName": "顺吉",
            "text": "不行，不行…我才不要先写一大堆设定，再根据设定来想剧情，那样也太死板了。",
            "nextDialogs": [
              "728120115"
            ]
          },
          "728120115": {
            "id": "728120115",
            "speakerId": 1000,
            "speakerName": "顺吉",
            "text": "剧情是小说里最重要的东西，小说里的一切都要为剧情服务，设定也是…",
            "nextDialogs": [
              "728120116"
            ]
          },
          "728120116": {
            "id": "728120116",
            "speakerId": 1001,
            "speakerName": "阿茂",
            "text": "你…",
            "nextDialogs": [
              "728120117"
            ]
          },
          "728120117": {
            "id": "728120117",
            "speakerId": 1000,
            "speakerName": "顺吉",
            "text": "我…",
            "nextDialogs": [
              "728120120"
            ]
          },
          "728120120": {
            "id": "728120120",
            "speakerId": 1001,
            "speakerName": "阿茂",
            "text": "算了，这样肯定说服不了你…",
            "nextDialogs": [
              "728120121"
            ]
          },
          "728120121": {
            "id": "728120121",
            "speakerId": 1000,
            "speakerName": "顺吉",
            "text": "无论你怎么说，我也不会放弃我的创作原则。",
            "nextDialogs": [
              "728120122"
            ]
          },
          "728120122": {
            "id": "728120122",
            "speakerId": 1001,
            "speakerName": "阿茂",
            "text": "真是…旅行者，既然你在这里，不如就由你来判断一下这件事吧。"
          }
        }
      }
    },
    {
      "subId": "7281204",
      "subQuestName": "与顺吉对话",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [],

      }
    },
    {
      "subId": "7281202",
      "subQuestName": "感受顺吉的「故事」",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "728120201"
        ],
        "dialogs": {
          "728120201": {
            "id": "728120201",
            "speakerId": 1000,
            "speakerName": "顺吉",
            "text": "好了，故事就到此结束了。",
            "nextDialogs": [
              "728120202"
            ]
          },
          "728120202": {
            "id": "728120202",
            "speakerId": 1000,
            "speakerName": "顺吉",
            "text": "我从来没这么累过，这故事真的有这么复杂吗…",
            "nextDialogs": [
              "728120203"
            ]
          },
          "728120203": {
            "id": "728120203",
            "speakerId": 1001,
            "speakerName": "阿茂",
            "text": "这就是你不事先定好设定的下场。没有设定束缚，故事里的所有元素都会乱七八糟地撞来撞去。",
            "nextDialogs": [
              "728120204"
            ]
          },
          "728120204": {
            "id": "728120204",
            "speakerId": 1001,
            "speakerName": "阿茂",
            "text": "在这种情况下，你对故事压根没有任何掌控力，无论写什么剧情都会累个半死。",
            "nextDialogs": [
              "728120205"
            ]
          },
          "728120205": {
            "id": "728120205",
            "speakerId": 1000,
            "speakerName": "顺吉",
            "text": "唉，我没力气和你争了…旅行者，谢谢您做出的这些…判断。",
            "nextDialogs": [
              "728120206"
            ]
          },
          "728120206": {
            "id": "728120206",
            "speakerId": 1000,
            "speakerName": "顺吉",
            "text": "这些判断实在是让我…获益匪浅。",
            "nextDialogs": [
              "728120207"
            ]
          },
          "728120207": {
            "id": "728120207",
            "speakerId": 1000,
            "speakerName": "顺吉",
            "text": "这些谢礼请您收下，我等会就回去接着写小说去。",
            "nextDialogs": [
              "728120208"
            ]
          },
          "728120208": {
            "id": "728120208",
            "speakerId": 1000,
            "speakerName": "顺吉",
            "text": "设定和剧情，唉…到底哪个比较重要呢…"
          }
        }
      }
    },
    {

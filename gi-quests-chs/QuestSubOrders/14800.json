  "subQuests": [
    {
      "subId": "1480001",
      "subQuestName": "(test)废弃$HIDDEN",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "698410101"
        ],
        "dialogs": {
          "698410101": {
            "id": "698410101",
            "speakerId": 1071,
            "speakerName": "林尼",
            "text": "呼…还要再走一段啊…",
            "nextDialogs": [
              "698410102"
            ]
          },
          "698410102": {
            "id": "698410102",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "林尼，你怎么在这里？",
            "nextDialogs": [
              "698410103"
            ]
          },
          "698410103": {
            "id": "698410103",
            "speakerId": 1071,
            "speakerName": "林尼",
            "text": "#{NICKNAME}，没想到会在这里遇见你…哎呀！看来我要对刚才遇见的那阵风道歉啦。",
            "nextDialogs": [
              "698410104"
            ]
          },
          "698410104": {
            "id": "698410104",
            "speakerId": 1071,
            "speakerName": "林尼",
            "text": "它莫名其妙地把我帽子给吹飞了，我刚追到帽子，就正好遇见了你。",
            "nextDialogs": [
              "698410105"
            ]
          },
          "698410105": {
            "id": "698410105",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "林尼打算去科学院？",
            "nextDialogs": [
              "698410106"
            ]
          },
          "698410106": {
            "id": "698410106",
            "speakerId": 1071,
            "speakerName": "林尼",
            "text": "嗯…我正打算去找一位研究员呢，他也对魔术很感兴趣，说是想要和我交流一下魔术手法。",
            "nextDialogs": [
              "698410107"
            ]
          },
          "698410107": {
            "id": "698410107",
            "speakerId": 1071,
            "speakerName": "林尼",
            "text": "我听说，这位研究员研究出了很多奇妙的机关，可以用来变出很厉害的魔术。",
            "nextDialogs": [
              "698410108"
            ]
          },
          "698410108": {
            "id": "698410108",
            "speakerId": 1071,
            "speakerName": "林尼",
            "text": "比如，他曾经造出了一个小型的保温桶，每天都塞在袖子里。",
            "nextDialogs": [
              "698410109"
            ]
          },
          "698410109": {
            "id": "698410109",
            "speakerId": 1071,
            "speakerName": "林尼",
            "text": "只要用手指勾动机关，保温桶里的冰块就会顺着袖子滑出来，这就是他众多魔术之一的「冰块戏法」。",
            "nextDialogs": [
              "698410112"
            ]
          },
          "698410112": {
            "id": "698410112",
            "speakerId": 1071,
            "speakerName": "林尼",
            "text": "哈哈哈，当然算了。你想想，你是一个坐在办公室里的职员，天气热得要命，你想出去买一瓶冰枫达，想解解渴。",
            "nextDialogs": [
              "698410113"
            ]
          },
          "698410113": {
            "id": "698410113",
            "speakerId": 1071,
            "speakerName": "林尼",
            "text": "但天气实在太热了，枫达机也坏掉了，买到的枫达根本不冰，办公室里也没冰块…",
            "nextDialogs": [
              "698410114"
            ]
          },
          "698410114": {
            "id": "698410114",
            "speakerId": 1071,
            "speakerName": "林尼",
            "text": "就在你要崩溃的时候，你旁边的同事一拍手，你装着枫达的杯子里突然多出了几块冰块…想象一下，你会是什么感受？"
          }
        }
      }
    }
  ]
}
  },
  "subQuests": [
    {
      "subId": "7603101",
      "subQuestName": "同「少女」见面",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "760310401"
        ],
        "dialogs": {
          "760310401": {
            "id": "760310401",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "#咦？{NICKNAME}，你看那是什么？",
            "nextDialogs": [
              "760310402"
            ]
          },
          "760310402": {
            "id": "760310402",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "一只…帔髦獾？",
            "nextDialogs": [
              "760310403"
            ]
          },
          "760310403": {
            "id": "760310403",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "它怎么一个人躲在这里呀，是来找「少女」的吗？",
            "nextDialogs": [
              "760310404"
            ]
          },
          "760310404": {
            "id": "760310404",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "看它的样子好像被什么东西吓到了，我们先带它进去吧。"
          }
        }
      }
    },
    {
      "subId": "7603106",
      "subQuestName": "进入「银月之庭」",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "760310101"
        ],
        "dialogs": {
          "760310101": {
            "id": "760310101",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "哥伦比娅？",
            "nextDialogs": [
              "760310102"
            ]
          },
          "760310102": {
            "id": "760310102",
            "speakerId": 1001,
            "speakerName": "「少女」",
            "text": "呼…呼…",
            "nextDialogs": [
              "760310103"
            ]
          },
          "760310103": {
            "id": "760310103",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "#啊！她在睡午觉呢，{NICKNAME}，要不我们待会儿再来。",
            "nextDialogs": [
              "760310104"
            ]
          },
          "760310104": {
            "id": "760310104",
            "speakerId": 1002,
            "speakerName": "帔髦獾",
            "text": "……！",
            "nextDialogs": [
              "760310105"
            ]
          },
          "760310105": {
            "id": "760310105",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "欸！你别去呀！",
            "nextDialogs": [
              "760310106"
            ]
          },
          "760310106": {
            "id": "760310106",
            "speakerId": 1001,
            "speakerName": "「少女」",
            "text": "…唔！",
            "nextDialogs": [
              "760310107"
            ]
          },
          "760310107": {
            "id": "760310107",
            "speakerId": 1001,
            "speakerName": "「少女」",
            "text": "疼…",
            "nextDialogs": [
              "760310108"
            ]
          },
          "760310108": {
            "id": "760310108",
            "speakerId": 1002,
            "speakerName": "帔髦獾",
            "text": "……",
            "nextDialogs": [
              "760310109"
            ]
          },
          "760310109": {
            "id": "760310109",
            "speakerId": 1001,
            "speakerName": "「少女」",
            "text": "脚滑了一下？唔，没关系，我没事。嗯？你们也来了？",
            "nextDialogs": [
              "760310110"
            ]
          },
          "760310110": {
            "id": "760310110",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "原来「月神」还会被动物撞疼的吗…",
            "nextDialogs": [
              "760310111"
            ]
          },
          "760310111": {
            "id": "760310111",
            "speakerId": 1001,
            "speakerName": "「少女」",
            "text": "动物们散发的月矩力中没有「恶意」，我就没在意。",
            "nextDialogs": [
              "760310112"
            ]
          },
          "760310112": {
            "id": "760310112",
            "speakerId": 1001,
            "speakerName": "「少女」",
            "text": "你怎么了？为什么这么害怕？",
            "nextDialogs": [
              "760310113"
            ]
          },
          "760310113": {
            "id": "760310113",
            "speakerId": 1002,
            "speakerName": "帔髦獾",
            "text": "……",
            "nextDialogs": [
              "760310114"
            ]
          },
          "760310114": {
            "id": "760310114",
            "speakerId": 1001,
            "speakerName": "「少女」",
            "text": "嗯，嗯嗯。",
            "nextDialogs": [
              "760310115"
            ]
          },
          "760310115": {
            "id": "760310115",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "原来你也能听懂它们说了什么？",
            "nextDialogs": [
              "760310116"
            ]
          },
          "760310116": {
            "id": "760310116",
            "speakerId": 1001,
            "speakerName": "「少女」",
            "text": "挪德卡莱是月亮升起的地方，只要是在月矩力下长大的动物，都可以算「月神的眷属」。",
            "nextDialogs": [
              "760310117"
            ]
          },
          "760310117": {
            "id": "760310117",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "那它说了什么呀？",
            "nextDialogs": [
              "760310118"
            ]
          },
          "760310118": {
            "id": "760310118",
            "speakerId": 1001,
            "speakerName": "「少女」",
            "text": "它生活的地方出现了魔物，本来想找菈乌玛…但一路被魔物追到了这附近…",
            "nextDialogs": [
              "760310119"
            ]
          },
          "760310119": {
            "id": "760310119",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "哦，怪不得会那么害怕…",
            "nextDialogs": [
              "760310120"
            ]
          },
          "760310120": {
            "id": "760310120",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "要送它回去吗？",
            "nextDialogs": [
              "760310121"
            ]
          },
          "760310121": {
            "id": "760310121",
            "speakerId": 1001,
            "speakerName": "「少女」",
            "text": "嗯，送去菈乌玛那里好了。她会处理的。",
            "nextDialogs": [
              "760310122"
            ]
          },
          "760310122": {
            "id": "760310122",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "好呀，看来又要出一趟门了呢。不过这次去的是「霜月之子」那边，你可真的要藏好啊！"
          }
        }
      }
    },
    {
      "subId": "7603102",
      "subQuestName": "同菈乌玛见面",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "760310201"
        ],
        "dialogs": {
          "760310201": {
            "id": "760310201",
            "speakerId": 1003,
            "speakerName": "菈乌玛",
            "text": "…没错，之后再让库涅贡妲拿些水果过去，这两天她需要静养。",
            "nextDialogs": [
              "760310202"
            ]
          },
          "760310202": {
            "id": "760310202",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "哦，菈乌玛好像在忙欸。我们稍等一下。",
            "nextDialogs": [
              "760310203"
            ]
          },
          "760310203": {
            "id": "760310203",
            "speakerId": 1001,
            "speakerName": "「少女」",
            "text": "很久以前我就知道，「咏月使」是「霜月之子」中非常重要的存在。",
            "nextDialogs": [
              "760310204"
            ]
          },
          "760310204": {
            "id": "760310204",
            "speakerId": 1001,
            "speakerName": "「少女」",
            "text": "我有时会觉得，她们说不定比真正的「神明」还辛苦。",
            "nextDialogs": [
              "760310205"
            ]
          },
          "760310205": {
            "id": "760310205",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "哦！她闲下来了！快趁现在…",
            "nextDialogs": [
              "760310206"
            ]
          },
          "760310206": {
            "id": "760310206",
            "speakerId": 1004,
            "speakerName": "瓦娜莫",
            "text": "菈乌玛大人，这边有些工事需要您安排一下。",
            "nextDialogs": [
              "760310207"
            ]
          },
          "760310207": {
            "id": "760310207",
            "speakerId": 1003,
            "speakerName": "菈乌玛",
            "text": "好，我这就来。",
            "nextDialogs": [
              "760310208"
            ]
          },
          "760310208": {
            "id": "760310208",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "又被叫走了吗！真的一点空隙都不给欸！",
            "nextDialogs": [
              "760310209"
            ]
          },
          "760310209": {
            "id": "760310209",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "我们小心地跟上去吧！"
          }
        }
      }
    },
    {
      "subId": "7603103",
      "subQuestName": "跟上菈乌玛",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "760310301"
        ],
        "dialogs": {
          "760310301": {
            "id": "760310301",
            "speakerId": 1003,
            "speakerName": "菈乌玛",
            "text": "…这样就好。辛苦你们了。",
            "nextDialogs": [
              "760310302"
            ]
          },
          "760310302": {
            "id": "760310302",
            "speakerId": 1003,
            "speakerName": "菈乌玛",
            "text": "月光联系着你我，不论日夜。",
            "nextDialogs": [
              "760310303"
            ]
          },
          "760310303": {
            "id": "760310303",
            "speakerId": 1001,
            "speakerName": "「少女」",
            "text": "…嗯？这和我以前听到的不一样了。",
            "nextDialogs": [
              "760310304"
            ]
          },
          "760310304": {
            "id": "760310304",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "啊！那人走了！我们上吧！",
            "nextDialogs": [
              "760310305"
            ]
          },
          "760310305": {
            "id": "760310305",
            "speakerId": 1005,
            "speakerName": "马西捷",
            "text": "菈乌玛大人！",
            "nextDialogs": [
              "760310306"
            ]
          },
          "760310306": {
            "id": "760310306",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "怎么没完了！",
            "nextDialogs": [
              "760310307"
            ]
          },
          "760310307": {
            "id": "760310307",
            "speakerId": 1003,
            "speakerName": "菈乌玛",
            "text": "……",
            "nextDialogs": [
              "760310308"
            ]
          },
          "760310308": {
            "id": "760310308",
            "speakerId": 1003,
            "speakerName": "菈乌玛",
            "text": "…辛苦了。我稍微出去一会儿，马上回来。",
            "nextDialogs": [
              "760310309"
            ]
          },
          "760310309": {
            "id": "760310309",
            "speakerId": 1003,
            "speakerName": "菈乌玛",
            "text": "……",
            "nextDialogs": [
              "760310310"
            ]
          },
          "760310310": {
            "id": "760310310",
            "speakerId": 1003,
            "speakerName": "菈乌玛",
            "text": "几位，周围没人了，可以出来了。",
            "nextDialogs": [
              "760310311"
            ]
          },
          "760310311": {
            "id": "760310311",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "原来你早就发现我们了！",
            "nextDialogs": [
              "760310312"
            ]
          },
          "760310312": {
            "id": "760310312",
            "speakerId": 1003,
            "speakerName": "菈乌玛",
            "text": "我怎么可能遗漏「库塔{RUBY#[S]月之少女}尔」散发出的月矩力呢。",
            "nextDialogs": [
              "760310313"
            ]
          },
          "760310313": {
            "id": "760310313",
            "speakerId": 1003,
            "speakerName": "菈乌玛",
            "text": "你们…怎么一直跟着我？简直像在…视察我的工作一样。",
            "nextDialogs": [
              "760310314"
            ]
          },
          "760310314": {
            "id": "760310314",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "呃…抱…抱歉，只是有件事需要找你，但一直找不到时机…没给你不必要的压力就好…",
            "nextDialogs": [
              "760310315"
            ]
          },
          "760310315": {
            "id": "760310315",
            "speakerId": 1003,
            "speakerName": "菈乌玛",
            "text": "这样吗…明白了，我会处理的。",
            "nextDialogs": [
              "760310316"
            ]
          },
          "760310316": {
            "id": "760310316",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "老实说，看完你一天的工作，我都有些不好意思再给你添麻烦了。",
            "nextDialogs": [
              "760310317"
            ]
          },
          "760310317": {
            "id": "760310317",
            "speakerId": 1003,
            "speakerName": "菈乌玛",
            "text": "这没什么，都是身为「咏月使」应该做的。",
            "nextDialogs": [
              "760310318"
            ]
          },
          "760310318": {
            "id": "760310318",
            "speakerId": 1003,
            "speakerName": "菈乌玛",
            "text": "……",
            "nextDialogs": [
              "760310319"
            ]
          },
          "760310319": {
            "id": "760310319",
            "speakerId": 1001,
            "speakerName": "「少女」",
            "text": "…嗯？",
            "nextDialogs": [
              "760310320"
            ]
          },
          "760310320": {
            "id": "760310320",
            "speakerId": 1003,
            "speakerName": "菈乌玛",
            "text": "…看过这些之后，「库塔{RUBY#[S]月之少女}尔」对如今的「霜月之子」怎么看？",
            "nextDialogs": [
              "760310321"
            ]
          },
          "760310321": {
            "id": "760310321",
            "speakerId": 1001,
            "speakerName": "「少女」",
            "text": "……",
            "nextDialogs": [
              "760310322"
            ]
          },
          "760310322": {
            "id": "760310322",
            "speakerId": 1001,
            "speakerName": "「少女」",
            "text": "和几百年前完全不一样的氛围。好的方面。",
            "nextDialogs": [
              "760310323"
            ]
          },
          "760310323": {
            "id": "760310323",
            "speakerId": 1003,
            "speakerName": "菈乌玛",
            "text": "是吗…谢谢你这么说。",
            "nextDialogs": [
              "760310324"
            ]
          },
          "760310324": {
            "id": "760310324",
            "speakerId": 1001,
            "speakerName": "「少女」",
            "text": "把手给我。",
            "nextDialogs": [
              "760310325"
            ]
          },
          "760310325": {
            "id": "760310325",
            "speakerId": 1001,
            "speakerName": "「少女」",
            "text": "#你也是，{NICKNAME}。",
            "nextDialogs": [
              "760310326"
            ]
          },
          "760310326": {
            "id": "760310326",
            "speakerId": 1003,
            "speakerName": "菈乌玛",
            "text": "…欸？这是…为什么？",
            "nextDialogs": [
              "760310327"
            ]
          },
          "760310327": {
            "id": "760310327",
            "speakerId": 1001,
            "speakerName": "「少女」",
            "text": "我喜欢你现在的祷词。",
            "nextDialogs": [
              "760310328"
            ]
          },
          "760310328": {
            "id": "760310328",
            "speakerId": 1001,
            "speakerName": "「少女」",
            "text": "…月光联系着你我，不论日夜。"
          }
        }
      }
    },

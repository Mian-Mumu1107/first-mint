    {
      "subId": "7503304",
      "subQuestName": "与库约尼对话",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "750330401"
        ],
        "dialogs": {
          "750330401": {
            "id": "750330401",
            "speakerId": 1005,
            "speakerName": "库约尼",
            "text": "飞得不错，年轻人！",
            "nextDialogs": [
              "750330402"
            ]
          },
          "750330402": {
            "id": "750330402",
            "speakerId": 1000,
            "speakerName": "阿科米蒂",
            "text": "恩人，刚才你觉得我飞得怎么样？",
            "nextDialogs": [
              "750330405"
            ]
          },
          "750330405": {
            "id": "750330405",
            "speakerId": 1000,
            "speakerName": "阿科米蒂",
            "text": "谢谢你愿意给我这些肯定，我看得出来和你相比，我飞得并不好。",
            "nextDialogs": [
              "750330406"
            ]
          },
          "750330406": {
            "id": "750330406",
            "speakerId": 1001,
            "speakerName": "马塔伽",
            "text": "阿科米蒂…",
            "nextDialogs": [
              "750330407"
            ]
          },
          "750330407": {
            "id": "750330407",
            "speakerId": 1000,
            "speakerName": "阿科米蒂",
            "text": "不是你们想的那样，我不是因为比不过别人又沮丧了。我是能飞的，我自己知道。",
            "nextDialogs": [
              "750330408"
            ]
          },
          "750330408": {
            "id": "750330408",
            "speakerId": 1000,
            "speakerName": "阿科米蒂",
            "text": "只是长期处在糟糕的状态里，破坏了我对自己的信任，就算能飞好也没办法从容面对。",
            "nextDialogs": [
              "750330409"
            ]
          },
          "750330409": {
            "id": "750330409",
            "speakerId": 1000,
            "speakerName": "阿科米蒂",
            "text": "#{NICKNAME}不会这样，{M#他}{F#她}的飞姿就自在得多，大家都能看出来。",
            "nextDialogs": [
              "750330410"
            ]
          },
          "750330410": {
            "id": "750330410",
            "speakerId": 1000,
            "speakerName": "阿科米蒂",
            "text": "爸爸，我知道你和姐姐希望我自己做决定，不要逃避。",
            "nextDialogs": [
              "750330411"
            ]
          },
          "750330411": {
            "id": "750330411",
            "speakerId": 1000,
            "speakerName": "阿科米蒂",
            "text": "如果我现在告诉你们，不管是我的身体，大脑还是心…",
            "nextDialogs": [
              "750330412"
            ]
          },
          "750330412": {
            "id": "750330412",
            "speakerId": 1000,
            "speakerName": "阿科米蒂",
            "text": "都不愿意在不适合自己的道路上继续走下去，你们还会支持我吗？",
            "nextDialogs": [
              "750330413"
            ]
          },
          "750330413": {
            "id": "750330413",
            "speakerId": 1002,
            "speakerName": "曼尤雅",
            "text": "没关系，只要是你自己做出的决定，只要你愿意承担后果。",
            "nextDialogs": [
              "750330414"
            ]
          },
          "750330414": {
            "id": "750330414",
            "speakerId": 1000,
            "speakerName": "阿科米蒂",
            "text": "马塔伽，你会…",
            "nextDialogs": [
              "750330415"
            ]
          },
          "750330415": {
            "id": "750330415",
            "speakerId": 1001,
            "speakerName": "马塔伽",
            "text": "停！别以为我会在这时候跳出来指责你，我哥哥是什么性格我一直知道。",
            "nextDialogs": [
              "750330416"
            ]
          },
          "750330416": {
            "id": "750330416",
            "speakerId": 1001,
            "speakerName": "马塔伽",
            "text": "受不了就果断放弃，只要坦荡你就算勇士，谁也没资格批评你。",
            "nextDialogs": [
              "750330417"
            ]
          },
          "750330417": {
            "id": "750330417",
            "speakerId": 1005,
            "speakerName": "库约尼",
            "text": "有的时候，训练大师的工作还是挺轻松的，我为勇士们制定训练计划，自己却不用上场。",
            "nextDialogs": [
              "750330418"
            ]
          },
          "750330418": {
            "id": "750330418",
            "speakerId": 1005,
            "speakerName": "库约尼",
            "text": "不过，你们的父亲我曾经也过着成天和龙一起飞来飞去的日子，知道这种生活的真正滋味。",
            "nextDialogs": [
              "750330419"
            ]
          },
          "750330419": {
            "id": "750330419",
            "speakerId": 1005,
            "speakerName": "库约尼",
            "text": "批评别人很容易，放手去做永远比简单动动嘴皮子难。",
            "nextDialogs": [
              "750330420"
            ]
          },
          "750330420": {
            "id": "750330420",
            "speakerId": 1005,
            "speakerName": "库约尼",
            "text": "作为一个训练师，我建议你申请休假调整身心状态，哪怕这会引起队里的不满，你也该这么做。",
            "nextDialogs": [
              "750330421"
            ]
          },
          "750330421": {
            "id": "750330421",
            "speakerId": 1005,
            "speakerName": "库约尼",
            "text": "作为一个父亲，知道你不愿意再继续，我尊重你的选择。",
            "nextDialogs": [
              "750330422"
            ]
          },
          "750330422": {
            "id": "750330422",
            "speakerId": 1005,
            "speakerName": "库约尼",
            "text": "就算不在飞行队待着了，也没什么大不了，花羽会的勇士也不是只有通过飞行才能证明自己的价值。",
            "nextDialogs": [
              "750330423"
            ]
          },
          "750330423": {
            "id": "750330423",
            "speakerId": 1000,
            "speakerName": "阿科米蒂",
            "text": "谢谢你们…我还担心…",
            "nextDialogs": [
              "750330424"
            ]
          },
          "750330424": {
            "id": "750330424",
            "speakerId": 1002,
            "speakerName": "曼尤雅",
            "text": "别想太多，我们是你的家人，有什么事我们都会帮你一起想办法。",
            "nextDialogs": [
              "750330425"
            ]
          },
          "750330425": {
            "id": "750330425",
            "speakerId": 1003,
            "speakerName": "派蒙",
            "text": "做勇士也不容易啊，没想到进入花羽会的飞行队这么辛苦。"
          }
        }
      }
    },
    {
      "subId": "7503309",
      "subQuestName": "与库约尼对话",
      "sceneId": null,

    {
      "subId": "7503302",
      "subQuestName": "与库约尼对话开启飞行比赛",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "750331001"
        ],
        "dialogs": {
          "750331001": {
            "id": "750331001",
            "speakerId": 1005,
            "speakerName": "库约尼",
            "text": "飞得不错，年轻人！哈哈哈哈！",
            "nextDialogs": [
              "750331002"
            ]
          },
          "750331002": {
            "id": "750331002",
            "speakerId": 1005,
            "speakerName": "库约尼",
            "text": "不过想要超过这几个孩子还得再多练习几次，很少有人能一蹴而就，别放在心上。",
            "nextDialogs": [
              "750331003"
            ]
          },
          "750331003": {
            "id": "750331003",
            "speakerId": 1005,
            "speakerName": "库约尼",
            "text": "还想再试试的话，来找我就好。"
          }
        }
      }
    },
    {
      "subId": "7503305",
      "subQuestName": "完成飞行比赛",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "750330501"
        ],
        "dialogs": {
          "750330501": {
            "id": "750330501",
            "speakerId": 1001,
            "speakerName": "马塔伽",
            "text": "哈哈，抱歉，这次被我抢先了！",
            "nextDialogs": [
              "750330502"
            ]
          },
          "750330502": {
            "id": "750330502",
            "speakerId": 1000,
            "speakerName": "阿科米蒂",
            "text": "这小子从以前就这样，总是半道发力，你很烦啊马塔伽！",
            "nextDialogs": [
              "750330503"
            ]
          },
          "750330503": {
            "id": "750330503",
            "speakerId": 1001,
            "speakerName": "马塔伽",
            "text": "不服气的话，就努力追上我吧！哈哈！"
          }
        }
      }
    },

    {
      "subId": "7503302",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "750330201"
        ],
        "dialogs": {
          "750330201": {
            "id": "750330201",
            "speakerId": 1005,
            "speakerName": "库约尼",
            "text": "来跟我的孩子飞一次吧，年轻人，能跟花羽会的飞行好手一起竞速的机会可不多。",
            "nextDialogs": [
              "750330202"
            ]
          },
          "750330202": {
            "id": "750330202",
            "speakerId": 1005,
            "speakerName": "库约尼",
            "text": "去追追看赛道上的<color=#00E1FFFF>飞行火炬</color>，谁先追上谁就是赢家，这几个孩子还小的时候我就是这么训练他们的。",
            "nextDialogs": [
              "750330203"
            ]
          },
          "750330203": {
            "id": "750330203",
            "speakerId": 1005,
            "speakerName": "库约尼",
            "text": "<color=#00E1FFFF>火炬被一个气球提着，点缀着红色的羽毛</color>，象征着勇士应当承担的责任与荣誉，是我做给他们的。",
            "nextDialogs": [
              "750330204"
            ]
          },
          "750330204": {
            "id": "750330204",
            "speakerId": 1005,
            "speakerName": "库约尼",
            "text": "你看到就能认出来，怎么样，来试试？",
            "nextDialogs": [
              "750330206",
              "750330208"
            ]
          },
          "750330206": {
            "id": "750330206",
            "speakerId": 1005,
            "speakerName": "库约尼",
            "text": "哈哈好，那就去起点预备吧。"
          },
          "750330208": {
            "id": "750330208",
            "speakerId": 1005,
            "speakerName": "库约尼",
            "text": "那我们就等你准备好再说。"
          }
        }
      }
    },
    {
      "subId": "7503306",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "750330601"
        ],
        "dialogs": {
          "750330601": {
            "id": "750330601",
            "speakerId": 1001,
            "speakerName": "马塔伽",
            "text": "#哎呀，我又输了，练了这么久结果还是输给{M#他}{F#她}了。",
            "nextDialogs": [
              "750330602"
            ]
          },
          "750330602": {
            "id": "750330602",
            "speakerId": 1000,
            "speakerName": "阿科米蒂",
            "text": "早就告诉你了，总是想着赢是不会有尽头的，我真羡慕你这种只知道往前冲，什么都不怕的劲头。",
            "nextDialogs": [
              "750330603"
            ]
          },
          "750330603": {
            "id": "750330603",
            "speakerId": 1002,
            "speakerName": "曼尤雅",
            "text": "阿科米蒂小一点的时候也是这样的，那会儿天天跟在我屁股后面说想要当驯龙大师呢。",
            "nextDialogs": [
              "750330604"
            ]
          },
          "750330604": {
            "id": "750330604",
            "speakerId": 1000,
            "speakerName": "阿科米蒂",
            "text": "别取笑我了，姐姐…",
            "nextDialogs": [
              "750330605"
            ]
          },
          "750330605": {
            "id": "750330605",
            "speakerId": 1005,
            "speakerName": "库约尼",
            "text": "你们都是我的好孩子，也都是勇士，所有的勇士在不同的阶段要面对不同的问题。",
            "nextDialogs": [
              "750330606"
            ]
          },
          "750330606": {
            "id": "750330606",
            "speakerId": 1005,
            "speakerName": "库约尼",
            "text": "这没关系，只要做到无愧于心，我以你们为傲。"
          }
        }
      }
    },

  "subQuests": [
    {
      "subId": "7503301",
      "subQuestName": "与众人对话",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "750330101"
        ],
        "dialogs": {
          "750330101": {
            "id": "750330101",
            "speakerId": 1000,
            "speakerName": "阿科米蒂",
            "text": "为什么我非得坚持不可，我就不能放弃吗…我不干了！姐姐，你帮帮我。",
            "nextDialogs": [
              "750330102"
            ]
          },
          "750330102": {
            "id": "750330102",
            "speakerId": 1001,
            "speakerName": "马塔伽",
            "text": "丢人！白长了这么大个子，碰到一点困难就想逃跑还算是勇士吗？你这家伙居然是我的同胞哥哥。",
            "nextDialogs": [
              "750330103"
            ]
          },
          "750330103": {
            "id": "750330103",
            "speakerId": 1000,
            "speakerName": "阿科米蒂",
            "text": "你就没有想不出办法，要找人帮忙的时候吗？",
            "nextDialogs": [
              "750330104"
            ]
          },
          "750330104": {
            "id": "750330104",
            "speakerId": 1001,
            "speakerName": "马塔伽",
            "text": "有。我是回来找爸爸和姐姐，让他们检验我特训成果的。我不会像你那么没骨气！",
            "nextDialogs": [
              "750330105"
            ]
          },
          "750330105": {
            "id": "750330105",
            "speakerId": 1002,
            "speakerName": "曼尤雅",
            "text": "阿科米蒂，我觉得队长拒绝你的退队申请是希望你想想清楚，不要在情绪剧烈波动的时候做决定。",
            "nextDialogs": [
              "750330106"
            ]
          },
          "750330106": {
            "id": "750330106",
            "speakerId": 1002,
            "speakerName": "曼尤雅",
            "text": "平静下来之后靠你自己做出决定吧，将来别后悔就好。",
            "nextDialogs": [
              "750330107"
            ]
          },
          "750330107": {
            "id": "750330107",
            "speakerId": 1002,
            "speakerName": "曼尤雅",
            "text": "我已经退役了，自己都不知道自己该干什么，恐怕没资格指导你。",
            "nextDialogs": [
              "750330108"
            ]
          },
          "750330108": {
            "id": "750330108",
            "speakerId": 1003,
            "speakerName": "派蒙",
            "text": "没想到你们三个人是一家子。",
            "nextDialogs": [
              "750330111"
            ]
          },
          "750330111": {
            "id": "750330111",
            "speakerId": 1004,
            "speakerName": "三人",
            "text": "是你们？！",
            "nextDialogs": [
              "750330112"
            ]
          },
          "750330112": {
            "id": "750330112",
            "speakerId": 1000,
            "speakerName": "阿科米蒂",
            "text": "坏消息，恩人，逃跑计划失败了。"
          }
        }
      }
    },
    {
      "subId": "7503308",
      "subQuestName": "(test)失败原因-离开范围or超出保底时间$HIDDEN",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "750330801"
        ],
        "dialogs": {
          "750330801": {
            "id": "750330801",
            "speakerId": 1001,
            "speakerName": "马塔伽",
            "text": "又是追逐赛吗？哈哈，你们等着瞧吧！",
            "nextDialogs": [
              "750330802"
            ]
          },
          "750330802": {
            "id": "750330802",
            "speakerId": 1002,
            "speakerName": "曼尤雅",
            "text": "你小子很有自信嘛，阿科米蒂，我们两个可不能输啊。",
            "nextDialogs": [
              "750330803"
            ]
          },
          "750330803": {
            "id": "750330803",
            "speakerId": 1000,
            "speakerName": "阿科米蒂",
            "text": "输给大姐就算了，马塔伽这个家伙我绝对不要输给他。",
            "nextDialogs": [
              "750330804"
            ]
          },
          "750330804": {
            "id": "750330804",
            "speakerId": 1000,
            "speakerName": "阿科米蒂",
            "text": "#{NICKNAME}，你也加油，当心马塔伽这小子留后手，他从以前就喜欢来这招。",
            "nextDialogs": [
              "750330805"
            ]
          },
          "750330805": {
            "id": "750330805",
            "speakerId": 1000,
            "speakerName": "阿科米蒂",
            "text": "你准备好了之后，记得找爸爸说一声，我们一起飞。"
          }
        }
      }
    },

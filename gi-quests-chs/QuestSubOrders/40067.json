  "subQuests": [
    {
      "subId": "4006701",
      "subQuestName": "调查四周寻找所需道具",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "400670101"
        ],
        "dialogs": {
          "400670101": {
            "id": "400670101",
            "speakerId": 10095,
            "speakerName": "莫娜",
            "text": "…似乎每次跟你见面都是这种情况呢。占卜、解读、锁定目标，再解决问题。",
            "nextDialogs": [
              "400670102"
            ]
          },
          "400670102": {
            "id": "400670102",
            "speakerId": 10095,
            "speakerName": "莫娜",
            "text": "你身边围绕着各种各样的朋友、秘密和命运，真不可思议。",
            "nextDialogs": [
              "400670103"
            ]
          },
          "400670103": {
            "id": "400670103",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "对哦，莱纳德事件也是跟莫娜和菲谢尔一起解决的呢。",
            "nextDialogs": [
              "400670104"
            ]
          },
          "400670104": {
            "id": "400670104",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "对占星术士来说是好事吧？",
            "nextDialogs": [
              "400670105"
            ]
          },
          "400670105": {
            "id": "400670105",
            "speakerId": 10095,
            "speakerName": "莫娜",
            "text": "勉强算是啦。但愿这一回我们也能强强联手，尽快解决问题。",
            "nextDialogs": [
              "400670106"
            ]
          },
          "400670106": {
            "id": "400670106",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "强强联手，是说你们俩，还是说我们三个？",
            "nextDialogs": [
              "400670107"
            ]
          },
          "400670107": {
            "id": "400670107",
            "speakerId": 10095,
            "speakerName": "莫娜",
            "text": "噗…",
            "nextDialogs": [
              "400670108"
            ]
          },
          "400670108": {
            "id": "400670108",
            "speakerId": 10095,
            "speakerName": "莫娜",
            "text": "好啦好啦，不会排挤你的。有时候派蒙的眼光独到又锐利，对我帮助很大。",
            "nextDialogs": [
              "400670109"
            ]
          },
          "400670109": {
            "id": "400670109",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "真的？我有点开始欣赏你了，天才莫娜！",
            "nextDialogs": [
              "400670110"
            ]
          },
          "400670110": {
            "id": "400670110",
            "speakerId": 10095,
            "speakerName": "莫娜",
            "text": "对吧对吧？像我这样聪明又迷人的占星术士，世界上再也找不出第二个了，哦呵呵！",
            "nextDialogs": [
              "400670111"
            ]
          },
          "400670111": {
            "id": "400670111",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "你什么都好，就是能不能…不要学菲谢尔笑…",
            "nextDialogs": [
              "400670112"
            ]
          },
          "400670112": {
            "id": "400670112",
            "speakerId": 10095,
            "speakerName": "莫娜",
            "text": "咳！不好意思…跟朋友相处久了，难免受影响…哈哈…",
            "nextDialogs": [
              "400670113"
            ]
          },
          "400670113": {
            "id": "400670113",
            "speakerId": 10095,
            "speakerName": "莫娜",
            "text": "#之后的日子里，我会继续观测星象。保持联系，{NICKNAME}。"
          }
        }
      }
    },
    {
      "subId": "4006702",
      "subQuestName": "将山石放入盆景",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "400670201"
        ],
        "dialogs": {
          "400670201": {
            "id": "400670201",
            "speakerId": 10095,
            "speakerName": "莫娜",
            "text": "…没想到，会在景色如此美妙的地方处理这种不可思议的事件。",
            "nextDialogs": [
              "400670202"
            ]
          },
          "400670202": {
            "id": "400670202",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "感觉如何？",
            "nextDialogs": [
              "400670203"
            ]
          },
          "400670203": {
            "id": "400670203",
            "speakerId": 10095,
            "speakerName": "莫娜",
            "text": "还行。如果你能帮上我的忙就更好了。",
            "nextDialogs": [
              "400670204"
            ]
          },
          "400670204": {
            "id": "400670204",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "那具体需要我们做些什么呢？",
            "nextDialogs": [
              "400670205"
            ]
          },
          "400670205": {
            "id": "400670205",
            "speakerId": 10095,
            "speakerName": "莫娜",
            "text": "唔…",
            "nextDialogs": [
              "400670206"
            ]
          },
          "400670206": {
            "id": "400670206",
            "speakerId": 10095,
            "speakerName": "莫娜",
            "text": "唔…唔…好像也没什么？",
            "nextDialogs": [
              "400670207"
            ]
          },
          "400670207": {
            "id": "400670207",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "你、你小看我们？！",
            "nextDialogs": [
              "400670208"
            ]
          },
          "400670208": {
            "id": "400670208",
            "speakerId": 10095,
            "speakerName": "莫娜",
            "text": "不，我是刚刚才意识到，虽然你话不多，却总是把事情办得很漂亮，悄悄地为大家做了很多事。",
            "nextDialogs": [
              "400670209"
            ]
          },
          "400670209": {
            "id": "400670209",
            "speakerId": 10095,
            "speakerName": "莫娜",
            "text": "你这样的人，应该是大家最需要的同伴。只要你在，好像就能放心许多。",
            "nextDialogs": [
              "400670210"
            ]
          },
          "400670210": {
            "id": "400670210",
            "speakerId": 10095,
            "speakerName": "莫娜",
            "text": "虽然擅自期待或许会给对方带去压力，但我认为…占星术士要有观察力，而发现他人的优点，也是一种观察。",
            "nextDialogs": [
              "400670211"
            ]
          },
          "400670211": {
            "id": "400670211",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "所以你只是想夸我们？",
            "nextDialogs": [
              "400670212"
            ]
          },
          "400670212": {
            "id": "400670212",
            "speakerId": 10095,
            "speakerName": "莫娜",
            "text": "只是陈述事实而已，没在夸你。",
            "nextDialogs": [
              "400670213"
            ]
          },
          "400670213": {
            "id": "400670213",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "原来如此，莫娜不肯承认…",
            "nextDialogs": [
              "400670214"
            ]
          },
          "400670214": {
            "id": "400670214",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "不肯承认她在夸奖别人！",
            "nextDialogs": [
              "400670215"
            ]
          },
          "400670215": {
            "id": "400670215",
            "speakerId": 10095,
            "speakerName": "莫娜",
            "text": "你、你笑什么，都说了是客观评价，没在夸你！没——在——夸你！",
            "nextDialogs": [
              "400670216"
            ]
          },
          "400670216": {
            "id": "400670216",
            "speakerId": 10095,
            "speakerName": "莫娜",
            "text": "#之后的日子里，我会继续观测星象。保持联系，{NICKNAME}。"
          }
        }
      }
    },
    {
      "subId": "4006703",
      "subQuestName": "与众人对话",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "400670301"
        ],
        "dialogs": {
          "400670301": {
            "id": "400670301",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "这里怎么搞的，碎成这样…",
            "nextDialogs": [
              "400670302"
            ]
          },
          "400670302": {
            "id": "400670302",
            "speakerId": 10011,
            "speakerName": "菲谢尔",
            "text": "…没落的权贵之家，就是如此吗。",
            "nextDialogs": [
              "400670303"
            ]
          },
          "400670303": {
            "id": "400670303",
            "speakerId": 10095,
            "speakerName": "莫娜",
            "text": "支离破碎，而且空无一人。应该是已经走到末尾了吧。",
            "nextDialogs": [
              "400670304"
            ]
          },
          "400670304": {
            "id": "400670304",
            "speakerId": 1042,
            "speakerName": "辛焱",
            "text": "走吧。"
          }
        }
      }
    },
    {
      "subId": "4006704",
      "subQuestName": "在破碎的空间中前进",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "400670401"
        ],
        "dialogs": {
          "400670401": {
            "id": "400670401",
            "speakerId": 12673,
            "speakerName": "船夫",
            "text": "你是枫原？快上船，我送你走！",
            "nextDialogs": [
              "400670402"
            ]
          },
          "400670402": {
            "id": "400670402",
            "speakerId": 1032,
            "speakerName": "枫原万叶",
            "text": "您…为什么要帮我？我可是通缉犯。",
            "nextDialogs": [
              "400670403"
            ]
          },
          "400670403": {
            "id": "400670403",
            "speakerId": 12673,
            "speakerName": "船夫",
            "text": "当然是社奉…啊咳咳！是有人付了钱，说要把你安全送出稻妻。",
            "nextDialogs": [
              "400670404"
            ]
          },
          "400670404": {
            "id": "400670404",
            "speakerId": 12673,
            "speakerName": "船夫",
            "text": "不过，别人能帮的实在有限，后面的路还得靠你自己。"
          }
        }
      }
    },
    {
      "subId": "4006705",
      "subQuestName": "在破碎的空间中前进",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "400670501"
        ],
        "dialogs": {
          "400670501": {
            "id": "400670501",
            "speakerId": 1032,
            "speakerName": "枫原万叶",
            "text": "那只瓷盆里，应该有棵枯死的植物才对。但在这里，枯木没有出现。",
            "nextDialogs": [
              "400670502"
            ]
          },
          "400670502": {
            "id": "400670502",
            "speakerId": 1032,
            "speakerName": "枫原万叶",
            "text": "…你们不在的时候，我想了许多，总算是明白过来了。",
            "nextDialogs": [
              "400670503"
            ]
          },
          "400670503": {
            "id": "400670503",
            "speakerId": 1032,
            "speakerName": "枫原万叶",
            "text": "这里是我的幻境，盆景中空无一物，意味着它即是我的心境。",
            "nextDialogs": [
              "400670504"
            ]
          },
          "400670504": {
            "id": "400670504",
            "speakerId": 1032,
            "speakerName": "枫原万叶",
            "text": "心中「净」澈，万物天地皆为「净」；心至「空」处，天地万物皆为「空」。",
            "nextDialogs": [
              "400670505"
            ]
          },
          "400670505": {
            "id": "400670505",
            "speakerId": 1032,
            "speakerName": "枫原万叶",
            "text": "净与空，便是我如今的心境了。",
            "nextDialogs": [
              "400670506"
            ]
          },
          "400670506": {
            "id": "400670506",
            "speakerId": 1032,
            "speakerName": "枫原万叶",
            "text": "不过，那也未必不是遗憾。心中缺损，亦作「空」。",
            "nextDialogs": [
              "400670507"
            ]
          },
          "400670507": {
            "id": "400670507",
            "speakerId": 1032,
            "speakerName": "枫原万叶",
            "text": "所以这盆景才出现在我的幻想之中，给我机会完成心愿。",
            "nextDialogs": [
              "400670508"
            ]
          },
          "400670508": {
            "id": "400670508",
            "speakerId": 1032,
            "speakerName": "枫原万叶",
            "text": "真没想到，在我内心深处，竟然也想制作属于自己的盆景…如此，才算是真正继承了枫原的传统吧。"
          }
        }
      }
    },
    {
      "subId": "4006706",
      "subQuestName": "在破碎的空间中前进",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "400670601"
        ],
        "dialogs": {
          "400670601": {
            "id": "400670601",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "那万叶想做的事，应该已经完成了吧？",
            "nextDialogs": [
              "400670602"
            ]
          },
          "400670602": {
            "id": "400670602",
            "speakerId": 1032,
            "speakerName": "枫原万叶",
            "text": "嗯，可以这么说。",
            "nextDialogs": [
              "400670603"
            ]
          },
          "400670603": {
            "id": "400670603",
            "speakerId": 1032,
            "speakerName": "枫原万叶",
            "text": "你们见证了过去的我，还与他告别。等你们亲眼看完属于我的一切，它们才真正成为历史。",
            "nextDialogs": [
              "400670604"
            ]
          },
          "400670604": {
            "id": "400670604",
            "speakerId": 1032,
            "speakerName": "枫原万叶",
            "text": "人一生最重要的是与他人的牵绊，而非对自己的苛责。驻足过去的人，不会有未来。",
            "nextDialogs": [
              "400670605"
            ]
          },
          "400670605": {
            "id": "400670605",
            "speakerId": 1032,
            "speakerName": "枫原万叶",
            "text": "所以请你们相信，我走到了这里，也将继续走下去。将来，就请各位多关照了。"
          }
        }
      }
    },

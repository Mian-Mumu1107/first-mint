    {
      "subId": "4006715",
      "subQuestName": "聆听码头上的声音",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "400671001"
        ],
        "dialogs": {
          "400671001": {
            "id": "400671001",
            "speakerId": 2440,
            "speakerName": "海龙",
            "text": "喂老弟！你没事吧！要不要上来避避难？",
            "nextDialogs": [
              "400671002"
            ]
          },
          "400671002": {
            "id": "400671002",
            "speakerId": 1032,
            "speakerName": "枫原万叶",
            "text": "海盗？",
            "nextDialogs": [
              "400671003"
            ]
          },
          "400671003": {
            "id": "400671003",
            "speakerId": 2440,
            "speakerName": "海龙",
            "text": "哈，没错，就是海盗！你就说，要不要来？"
          }
        }
      }

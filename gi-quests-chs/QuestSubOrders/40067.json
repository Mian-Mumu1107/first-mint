    {
      "subId": "4006713",
      "subQuestName": "返回营地",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "400671301"
        ],
        "dialogs": {
          "400671301": {
            "id": "400671301",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "呼啊，走了不少路，都有点困了…",
            "nextDialogs": [
              "400671302"
            ]
          },
          "400671302": {
            "id": "400671302",
            "speakerId": 1042,
            "speakerName": "辛焱",
            "text": "大家都辛苦了，今天要不早点休息吧。",
            "nextDialogs": [
              "400671303"
            ]
          },
          "400671303": {
            "id": "400671303",
            "speakerId": 10011,
            "speakerName": "菲谢尔",
            "text": "……",
            "nextDialogs": [
              "400671304"
            ]
          },
          "400671304": {
            "id": "400671304",
            "speakerId": 10095,
            "speakerName": "莫娜",
            "text": "嗯？怎么了，你脸色不太好看。",
            "nextDialogs": [
              "400671305"
            ]
          },
          "400671305": {
            "id": "400671305",
            "speakerId": 10011,
            "speakerName": "菲谢尔",
            "text": "没什么。本皇女感到疲惫，或许是今日舟车劳顿。",
            "nextDialogs": [
              "400671306"
            ]
          },
          "400671306": {
            "id": "400671306",
            "speakerId": 10012,
            "speakerName": "奥兹",
            "text": "……",
            "nextDialogs": [
              "400671307"
            ]
          },
          "400671307": {
            "id": "400671307",
            "speakerId": 10012,
            "speakerName": "奥兹",
            "text": "小姐，您还好吗？",
            "nextDialogs": [
              "400671308"
            ]
          },
          "400671308": {
            "id": "400671308",
            "speakerId": 10011,
            "speakerName": "菲谢尔",
            "text": "奥兹，不要多事。",
            "nextDialogs": [
              "400671309"
            ]
          },
          "400671309": {
            "id": "400671309",
            "speakerId": 10012,
            "speakerName": "奥兹",
            "text": "是。",
            "nextDialogs": [
              "400671310"
            ]
          },
          "400671310": {
            "id": "400671310",
            "speakerId": 10095,
            "speakerName": "莫娜",
            "text": "……？",
            "nextDialogs": [
              "400671311"
            ]
          },
          "400671311": {
            "id": "400671311",
            "speakerId": 1042,
            "speakerName": "辛焱",
            "text": "我去找找有没有可以吃的东西，你们要是累了就先坐一会儿，还有精力的可以来帮我。",
            "nextDialogs": [
              "400671312"
            ]
          },
          "400671312": {
            "id": "400671312",
            "speakerId": 1032,
            "speakerName": "枫原万叶",
            "text": "我来吧。",
            "nextDialogs": [
              "400671313"
            ]
          },
          "400671313": {
            "id": "400671313",
            "speakerId": 10095,
            "speakerName": "莫娜",
            "text": "我也可以帮忙。",
            "nextDialogs": [
              "400671314"
            ]
          },
          "400671314": {
            "id": "400671314",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "别人都那么积极，我们也去吧！",
            "nextDialogs": [
              "400671315"
            ]
          },
          "400671315": {
            "id": "400671315",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "那我和派蒙也来帮你。",
            "nextDialogs": [
              "400671316"
            ]
          },
          "400671316": {
            "id": "400671316",
            "speakerId": 1042,
            "speakerName": "辛焱",
            "text": "不至于不至于，而且…",
            "nextDialogs": [
              "400671317"
            ]
          },
          "400671317": {
            "id": "400671317",
            "speakerId": 1042,
            "speakerName": "辛焱",
            "text": "我看皇女殿下有些忧郁，莫娜，你跟她比较熟，不如陪她出去散散心吧。",
            "nextDialogs": [
              "400671318"
            ]
          },
          "400671318": {
            "id": "400671318",
            "speakerId": 10095,
            "speakerName": "莫娜",
            "text": "原来你也发现了。我刚想着趁准备食物的时候跟你们提一下这事呢。既然如此，那边就交给我了。",
            "nextDialogs": [
              "400671319"
            ]
          },
          "400671319": {
            "id": "400671319",
            "speakerId": 1042,
            "speakerName": "辛焱",
            "text": "好嘞，那我们几个来准备食物。",
            "nextDialogs": [
              "400671320"
            ]
          },
          "400671320": {
            "id": "400671320",
            "speakerId": 1008,
            "speakerName": "Black Screen",
            "text": "莫娜对我们眨眨眼，跑去陪伴菲谢尔了。剩下的人一起找了些能烹饪成佳肴的食材…",
            "nextDialogs": [
              "400671321"
            ]
          },
          "400671321": {
            "id": "400671321",
            "speakerId": 1042,
            "speakerName": "辛焱",
            "text": "嗯，这些就够了，一会儿烤着吃吧。下回要是走过那些没人的营地，可以找找有没有炖锅，这样还能做菜。",
            "nextDialogs": [
              "400671322"
            ]
          },
          "400671322": {
            "id": "400671322",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "真周到呀！明明不是厨师，却这么会照顾人。",
            "nextDialogs": [
              "400671323"
            ]
          },
          "400671323": {
            "id": "400671323",
            "speakerId": 1042,
            "speakerName": "辛焱",
            "text": "嘿嘿，做些力所能及的小事而已，不值得你这么夸啦。",
            "nextDialogs": [
              "400671324"
            ]
          },
          "400671324": {
            "id": "400671324",
            "speakerId": 1032,
            "speakerName": "枫原万叶",
            "text": "辛焱是连「死兆星号」的兄弟们都认可的好伙伴。",
            "nextDialogs": [
              "400671325"
            ]
          },
          "400671325": {
            "id": "400671325",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "嗯！我们眼里万叶也是这么可靠的人哦！",
            "nextDialogs": [
              "400671326"
            ]
          },
          "400671326": {
            "id": "400671326",
            "speakerId": 1042,
            "speakerName": "辛焱",
            "text": "哈哈哈，说得好。",
            "nextDialogs": [
              "400671327"
            ]
          },
          "400671327": {
            "id": "400671327",
            "speakerId": 1032,
            "speakerName": "枫原万叶",
            "text": "嗯…既然如此，我作为可靠的伙伴，刚巧有些话想说。",
            "nextDialogs": [
              "400671328"
            ]
          },
          "400671328": {
            "id": "400671328",
            "speakerId": 1032,
            "speakerName": "枫原万叶",
            "text": "听你们说的，那片不可思议的幻境，根本是依照「枫原万叶」迄今为止的人生创建而成。",
            "nextDialogs": [
              "400671329"
            ]
          },
          "400671329": {
            "id": "400671329",
            "speakerId": 1032,
            "speakerName": "枫原万叶",
            "text": "…简直像是我的一场梦。",
            "nextDialogs": [
              "400671330"
            ]
          },
          "400671330": {
            "id": "400671330",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "或许就是代表着「梦」呢。",
            "nextDialogs": [
              "400671331"
            ]
          },
          "400671331": {
            "id": "400671331",
            "speakerId": 1042,
            "speakerName": "辛焱",
            "text": "万叶，你是不是…一直也想要完成属于你的「盆景」？",
            "nextDialogs": [
              "400671332"
            ]
          },
          "400671332": {
            "id": "400671332",
            "speakerId": 1032,
            "speakerName": "枫原万叶",
            "text": "是吗…到头来，居然是实现了我的愿望吗…",
            "nextDialogs": [
              "400671333"
            ]
          },
          "400671333": {
            "id": "400671333",
            "speakerId": 1032,
            "speakerName": "枫原万叶",
            "text": "既然我会遇到这种情况，那是不是意味着，我们大家都有这种可能？",
            "nextDialogs": [
              "400671334"
            ]
          },
          "400671334": {
            "id": "400671334",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "嗯，我也这么想。",
            "nextDialogs": [
              "400671335"
            ]
          },
          "400671335": {
            "id": "400671335",
            "speakerId": 1042,
            "speakerName": "辛焱",
            "text": "我也同意。只是，不知道下一个类似的场所会是跟谁有关的幻境。",
            "nextDialogs": [
              "400671336"
            ]
          },
          "400671336": {
            "id": "400671336",
            "speakerId": 1042,
            "speakerName": "辛焱",
            "text": "哈，这么一说，要是我也能有这样的美梦该多好。",
            "nextDialogs": [
              "400671337"
            ]
          },
          "400671337": {
            "id": "400671337",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "你居然很想要这样的东西吗？",
            "nextDialogs": [
              "400671338"
            ]
          },
          "400671338": {
            "id": "400671338",
            "speakerId": 1042,
            "speakerName": "辛焱",
            "text": "如果我能拥有这样的领域，应该会是跟音乐有关的东西吧。嗯哼哼，到时候就能一展身手啦！",
            "nextDialogs": [
              "400671339"
            ]
          },
          "400671339": {
            "id": "400671339",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "不会是要突然演奏吧！",
            "nextDialogs": [
              "400671340"
            ]
          },
          "400671340": {
            "id": "400671340",
            "speakerId": 1042,
            "speakerName": "辛焱",
            "text": "很正常吧？任何搞音乐的人来到这片群岛，面对如此美景，不想来点音乐才奇怪。",
            "nextDialogs": [
              "400671341"
            ]
          },
          "400671341": {
            "id": "400671341",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "好强健的心智，好乐观的精神，我有点佩服了…",
            "nextDialogs": [
              "400671342"
            ]
          },
          "400671342": {
            "id": "400671342",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "#啊对了！{NICKNAME}，我想吃山崖边的水果，陪我去摘好吗？",
            "nextDialogs": [
              "400671343"
            ]
          },
          "400671343": {
            "id": "400671343",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "（嗯？莫非…）",
            "nextDialogs": [
              "400671344"
            ]
          },
          "400671344": {
            "id": "400671344",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "二位先忙，我陪派蒙。"
          }
        }
      }
    },
    {
      "subId": "4006714",
      "subQuestName": "到隐蔽地点联络温迪",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [],
        "dialogs": {}
      }
    },
    {
      "subId": "4006712",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "400671201"
        ],
        "dialogs": {
          "400671201": {
            "id": "400671201",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "万叶，找到你了。",
            "nextDialogs": [
              "400671202"
            ]
          },
          "400671202": {
            "id": "400671202",
            "speakerId": 1032,
            "speakerName": "枫原万叶",
            "text": "来得不快也不慢，刚刚好，容我想完了迄今为止的人生。",
            "nextDialogs": [
              "400671203"
            ]
          },
          "400671203": {
            "id": "400671203",
            "speakerId": 1032,
            "speakerName": "枫原万叶",
            "text": "枫原家的盆景，你感觉如何？",
            "nextDialogs": [
              "400671205",
              "400671208"
            ]
          },
          "400671205": {
            "id": "400671205",
            "speakerId": 1032,
            "speakerName": "枫原万叶",
            "text": "古老的东西，往往都伴随着遗憾。枫原亦是如此。",
            "nextDialogs": [
              "400671206"
            ]
          },
          "400671206": {
            "id": "400671206",
            "speakerId": 1032,
            "speakerName": "枫原万叶",
            "text": "但无妨，散也是聚。不在此处，便是在他乡。",
            "nextDialogs": [
              "400671209"
            ]
          },
          "400671209": {
            "id": "400671209",
            "speakerId": 10095,
            "speakerName": "莫娜",
            "text": "这片秘境很有趣，像戏剧一样，每一出都比上一出更特别，更震撼人心。",
            "nextDialogs": [
              "400671210"
            ]
          },
          "400671210": {
            "id": "400671210",
            "speakerId": 1032,
            "speakerName": "枫原万叶",
            "text": "占星术士都是见多识广的人。能让你这样说，这片幻境也不枉存在了。",
            "nextDialogs": [
              "400671211"
            ]
          },
          "400671211": {
            "id": "400671211",
            "speakerId": 10011,
            "speakerName": "菲谢尔",
            "text": "喂，汝…心情如何？",
            "nextDialogs": [
              "400671212"
            ]
          },
          "400671212": {
            "id": "400671212",
            "speakerId": 10012,
            "speakerName": "奥兹",
            "text": "小姐的意思是问候万叶卿，希望你心情别太低落。",
            "nextDialogs": [
              "400671213"
            ]
          },
          "400671213": {
            "id": "400671213",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "回忆这样的经历，不可能高兴的吧…",
            "nextDialogs": [
              "400671214"
            ]
          },
          "400671214": {
            "id": "400671214",
            "speakerId": 1032,
            "speakerName": "枫原万叶",
            "text": "哈哈，说得也是。感谢各位的关心。幸好，这些事对我而言都是过去了。",
            "nextDialogs": [
              "400671215"
            ]
          },
          "400671215": {
            "id": "400671215",
            "speakerId": 1032,
            "speakerName": "枫原万叶",
            "text": "第一眼看见盆景，我就想到了这种可能性…我在等你们，或许这正是我被独自留在终点的理由。"
          },
          "400671208": {
            "id": "400671208",
            "speakerId": 1032,
            "speakerName": "枫原万叶",
            "text": "是啊。"
          }
        }
      }
    },
    {
      "subId": "4006714",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "400671401"
        ],
        "dialogs": {
          "400671401": {
            "id": "400671401",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "今天这些奇怪的房子，幻境一样的…呃…盆景？总之就是那堆怪事啦！我觉得，是不是应该告诉温迪？",
            "nextDialogs": [
              "400671404"
            ]
          },
          "400671404": {
            "id": "400671404",
            "speakerId": 12625,
            "speakerName": "嘟嘟通讯仪",
            "text": "嘟嘟可——嘟嘟可——",
            "nextDialogs": [
              "400671405"
            ]
          },
          "400671405": {
            "id": "400671405",
            "speakerId": 12625,
            "speakerName": "嘟嘟通讯仪",
            "text": "嘟嘟可——嘟嘟可——嘟嘟可——",
            "nextDialogs": [
              "400671406"
            ]
          },
          "400671406": {
            "id": "400671406",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "没有回应…奇怪，他怎么不理我们？",
            "nextDialogs": [
              "400671407"
            ]
          },
          "400671407": {
            "id": "400671407",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "不应该这样…",
            "nextDialogs": [
              "400671408"
            ]
          },
          "400671408": {
            "id": "400671408",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "难道说，温迪又走神了？还是演出期间没把炸弹带在身边？又或者是喝醉了，正在大树底下打盹…",
            "nextDialogs": [
              "400671409"
            ]
          },
          "400671409": {
            "id": "400671409",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "唔…好奇怪，要不然…要不然明天再联系他吧。",
            "nextDialogs": [
              "400671410"
            ]
          },
          "400671410": {
            "id": "400671410",
            "speakerId": 10095,
            "speakerName": "莫娜",
            "text": "旅行者，派蒙，你们在这儿啊。",
            "nextDialogs": [
              "400671411"
            ]
          },
          "400671411": {
            "id": "400671411",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "是莫娜！你跟菲谢尔聊完了？",
            "nextDialogs": [
              "400671412"
            ]
          },
          "400671412": {
            "id": "400671412",
            "speakerId": 10095,
            "speakerName": "莫娜",
            "text": "啊哈哈，算是吧…她有点忧郁，我猜…可能是跟今天遇到的幻境有关。",
            "nextDialogs": [
              "400671413"
            ]
          },
          "400671413": {
            "id": "400671413",
            "speakerId": 10095,
            "speakerName": "莫娜",
            "text": "菲谢尔对这次旅行非常积极，但我有种感觉，她似乎并不想见到属于自己的幻境…",
            "nextDialogs": [
              "400671414"
            ]
          },
          "400671414": {
            "id": "400671414",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "为什么？她不是应该最向往这些事吗？",
            "nextDialogs": [
              "400671415"
            ]
          },
          "400671415": {
            "id": "400671415",
            "speakerId": 10095,
            "speakerName": "莫娜",
            "text": "…还不能下结论，不过我会多留意。",
            "nextDialogs": [
              "400671416"
            ]
          },
          "400671416": {
            "id": "400671416",
            "speakerId": 10095,
            "speakerName": "莫娜",
            "text": "我是想跟你们说另一件事。刚才我在海边又做了一次占卜。",
            "nextDialogs": [
              "400671417"
            ]
          },
          "400671417": {
            "id": "400671417",
            "speakerId": 10095,
            "speakerName": "莫娜",
            "text": "水占盘依然浑浊，但不同的是，隐约能从中感觉到某股力量。我无法看清它的位置，但能感受到，它在变化。",
            "nextDialogs": [
              "400671418"
            ]
          },
          "400671418": {
            "id": "400671418",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "看不见要怎么感受啊…",
            "nextDialogs": [
              "400671419"
            ]
          },
          "400671419": {
            "id": "400671419",
            "speakerId": 10095,
            "speakerName": "莫娜",
            "text": "该怎么给外行解释呢…啊！你就理解成，屋里有条裂缝，我们不知道它在哪里，但有风漏了进来。",
            "nextDialogs": [
              "400671420"
            ]
          },
          "400671420": {
            "id": "400671420",
            "speakerId": 10095,
            "speakerName": "莫娜",
            "text": "不仅如此，屋里的温度也一直在下降。",
            "nextDialogs": [
              "400671421"
            ]
          },
          "400671421": {
            "id": "400671421",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "哦！这么说的话，我好像明白了。你是想找出那条裂缝在哪里对吗？",
            "nextDialogs": [
              "400671422"
            ]
          },
          "400671422": {
            "id": "400671422",
            "speakerId": 10095,
            "speakerName": "莫娜",
            "text": "可以这么说。我需要先看到那条墙缝，才能决定接下来怎么做。"
          }
        }
      }
    },
    {
      "subId": "4006799",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "400679901"
        ],
        "dialogs": {
          "400679901": {
            "id": "400679901",
            "speakerId": 12669,
            "speakerName": "老仆",
            "text": "少爷，我们是最后的家仆了啊！您当真要遣散大家？那往后，谁来…",
            "nextDialogs": [
              "400679902"
            ]
          },
          "400679902": {
            "id": "400679902",
            "speakerId": 1032,
            "speakerName": "枫原万叶",
            "text": "不必担心，我会照顾好自己。",
            "nextDialogs": [
              "400679903"
            ]
          },
          "400679903": {
            "id": "400679903",
            "speakerId": 12669,
            "speakerName": "老仆",
            "text": "唉，夫人走得早，老爷又离你而去，如今这个名存实亡的家，只剩你一人…",
            "nextDialogs": [
              "400679904"
            ]
          },
          "400679904": {
            "id": "400679904",
            "speakerId": 12669,
            "speakerName": "老仆",
            "text": "老仆这一走，此生应是不会再见了。少爷，请多保重。",
            "nextDialogs": [
              "400679905"
            ]
          },
          "400679905": {
            "id": "400679905",
            "speakerId": 12670,
            "speakerName": "水手",
            "text": "喂——！要开船了！",
            "nextDialogs": [
              "400679906"
            ]
          },
          "400679906": {
            "id": "400679906",
            "speakerId": 1032,
            "speakerName": "枫原万叶",
            "text": "再会了。",
            "nextDialogs": [
              "400679907"
            ]
          },
          "400679907": {
            "id": "400679907",
            "speakerId": 1032,
            "speakerName": "枫原万叶",
            "text": "枫原家终于还是在我手上解散了。",
            "nextDialogs": [
              "400679908"
            ]
          },
          "400679908": {
            "id": "400679908",
            "speakerId": 1032,
            "speakerName": "枫原万叶",
            "text": "但正如父亲所说，不能让生活束缚了我。像这样四处漂泊，或许才更适合我。",
            "nextDialogs": [
              "400679909"
            ]
          },
          "400679909": {
            "id": "400679909",
            "speakerId": 1032,
            "speakerName": "枫原万叶",
            "text": "据说，「神之眼」意味着神明的视线。",
            "nextDialogs": [
              "400679910"
            ]
          },
          "400679910": {
            "id": "400679910",
            "speakerId": 12672,
            "speakerName": "友人",
            "text": "嗯，这个我也有。可被神明注视，一定就是好事吗？",
            "nextDialogs": [
              "400679911"
            ]
          },
          "400679911": {
            "id": "400679911",
            "speakerId": 1032,
            "speakerName": "枫原万叶",
            "text": "…或许吧。",
            "nextDialogs": [
              "400679912"
            ]
          },
          "400679912": {
            "id": "400679912",
            "speakerId": 12668,
            "speakerName": "幕府足轻",
            "text": "眼狩令！拥有神之眼的人，全部老实上交！",
            "nextDialogs": [
              "400679913"
            ]
          },
          "400679913": {
            "id": "400679913",
            "speakerId": 12672,
            "speakerName": "友人",
            "text": "喂，这边，快走！",
            "nextDialogs": [
              "400679914"
            ]
          },
          "400679914": {
            "id": "400679914",
            "speakerId": 1032,
            "speakerName": "枫原万叶",
            "text": "不必问原因。我很明白人们为什么抗拒眼狩令。",
            "nextDialogs": [
              "400679915"
            ]
          },
          "400679915": {
            "id": "400679915",
            "speakerId": 1032,
            "speakerName": "枫原万叶",
            "text": "人不能失去愿望，那是我们心底最纯正的力量。",
            "nextDialogs": [
              "400679916"
            ]
          },
          "400679916": {
            "id": "400679916",
            "speakerId": 1032,
            "speakerName": "枫原万叶",
            "text": "到了万不得已的时刻，我会离开。",
            "nextDialogs": [
              "400679924"
            ]
          },
          "400679924": {
            "id": "400679924",
            "speakerId": 1032,
            "speakerName": "枫原万叶",
            "text": "祖父生前曾去璃月观光，父亲则从书中读到蒙德风景。我…又该去哪里？",
            "nextDialogs": [
              "400679925"
            ]
          },
          "400679925": {
            "id": "400679925",
            "speakerId": 1032,
            "speakerName": "枫原万叶",
            "text": "…天色转阴，是要下雨了吧。",
            "nextDialogs": [
              "400679926"
            ]
          },
          "400679926": {
            "id": "400679926",
            "speakerId": 1032,
            "speakerName": "枫原万叶",
            "text": "这场雨，还会停吗？"
          }
        }
      }
    }
  ]
}
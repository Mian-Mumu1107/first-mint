    {
      "subId": "7401211",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "740121101"
        ],
        "dialogs": {
          "740121101": {
            "id": "740121101",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "最好还是不要动它…",
            "nextDialogs": [
              "740121102"
            ]
          },
          "740121102": {
            "id": "740121102",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "#是…是呀，总觉得是很危险的东西…{NICKNAME}，我们还是离它远一些比较好…"
          }
        }
      }
    },
    {
      "subId": "7401212",

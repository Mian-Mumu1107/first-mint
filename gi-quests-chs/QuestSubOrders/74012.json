    {
      "subId": "7401205",
      "subQuestName": "前往附近的营地搜寻线索",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "740120501"
        ],
        "dialogs": {
          "740120501": {
            "id": "740120501",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "呜哇，好严格！我可绝对不想在这家伙手下工作！",
            "nextDialogs": [
              "740120502"
            ]
          },
          "740120502": {
            "id": "740120502",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "还说什么「集体荣誉感」…连饭都不让人吃，还有什么荣誉感嘛！",
            "nextDialogs": [
              "740120504",
              "740120506"
            ]
          },
          "740120504": {
            "id": "740120504",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "唔，纪律确实很重要啦…不过也没必要做到这种地步吧？",
            "nextDialogs": [
              "740120507"
            ]
          },
          "740120507": {
            "id": "740120507",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "咦？仔细想想的话，要是我们也敲锅的话，说不定就能把那个叫舒米洛夫的小队长给引下来了吧？",
            "nextDialogs": [
              "740120508"
            ]
          },
          "740120508": {
            "id": "740120508",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "#这样一来，我们说不定就能上去了…{NICKNAME}，我们快去试试看吧！"
          },
          "740120506": {
            "id": "740120506",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "就是啊！越是不知道怎么才能做实事的家伙，就越喜欢搞这种奇怪的纪律和规定…"
          }
        }
      }
    },
    {
      "subId": "7401206",
      "subQuestName": "敲击烹饪用的锅",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "740120601"
        ],
        "dialogs": {
          "740120601": {
            "id": "740120601",
            "speakerId": 1001,
            "speakerName": "Black Screen",
            "text": "「咚——咚——咚——」\\n没过多久，一阵急匆匆的脚步声从塔楼上方传来…"
          }
        }
      }
    },
    {
      "subId": "7401207",
      "subQuestName": "击败愚人众",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [

        "startDialogs": [
          "740121201"
        ],
        "dialogs": {
          "740121201": {
            "id": "740121201",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "咦？是和之前在另外那座塔里一样的控制台…",
            "nextDialogs": [
              "740121202"
            ]
          },
          "740121202": {
            "id": "740121202",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "拉动拉杆。",
            "nextDialogs": [
              "740121203"
            ]
          },
          "740121203": {
            "id": "740121203",
            "speakerId": 1001,
            "speakerName": "Black Screen",
            "text": "你拉动了拉杆。\\n与之前一样，一阵轰鸣和晃动后，机器吐出了一叠纸带…",
            "nextDialogs": [
              "740121204"
            ]
          },
          "740121204": {
            "id": "740121204",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "唔，是和之前一样的纸带…",
            "nextDialogs": [
              "740121205"
            ]
          },
          "740121205": {
            "id": "740121205",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "虽然还是完全看不懂，但之后说不定会在什么地方用上，还是先带在身上吧？"
          }
        }
      }
    },
    {
      "subId": "7401213",

    {
      "subId": "7401209",
      "subQuestName": "调查终端",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "740121001"
        ],
        "dialogs": {
          "740121001": {
            "id": "740121001",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "拉动拉杆。",
            "nextDialogs": [
              "740121002"
            ]
          },
          "740121002": {
            "id": "740121002",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "#呜哇！{NICKNAME}，你在干什么啦！",
            "nextDialogs": [
              "740121003"
            ]
          },
          "740121003": {
            "id": "740121003",
            "speakerId": 1001,
            "speakerName": "Black Screen",
            "text": "你毫不犹豫地拉动了拉杆。\\n下一个瞬间，伴随着宛若雷霆的震耳轰鸣，整座高塔开始剧烈地晃动起来，仿佛天为之崩、地为之裂…",
            "nextDialogs": [
              "740121004"
            ]
          },
          "740121004": {
            "id": "740121004",
            "speakerId": 1001,
            "speakerName": "Black Screen",
            "text": "然后…噗地一声，机器吐出了一叠纸带，正好掉在你的手中。\\n一切重归沉寂。",
            "nextDialogs": [
              "740121005"
            ]
          },
          "740121005": {
            "id": "740121005",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "就…就只是这样吗？",
            "nextDialogs": [
              "740121006"
            ]
          },
          "740121006": {
            "id": "740121006",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "唔…完全看不懂上面刻了什么东西，但看上去好像挺重要的…",
            "nextDialogs": [
              "740121007"
            ]
          },
          "740121007": {
            "id": "740121007",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "#{NICKNAME}，我们还是先留着这些纸带吧？说不定之后会在什么地方用上…"
          }
        }
      }
    },
    {
      "subId": "7401209",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {

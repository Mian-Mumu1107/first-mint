      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "740121301"
        ],
        "dialogs": {
          "740121301": {
            "id": "740121301",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "让我看看…嗯，应该就是这个啦，写着「千万不要动！」的拉杆！",

{
  "lineCounts": {
    "Player": 9,
    "哈贾娜德": 30,
    "派蒙": 22
  },
  "subQuests": [
    {
      "subId": "7350901",
      "subQuestName": "与奇怪的学者对话",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "735090101"
        ],
        "dialogs": {
          "735090101": {
            "id": "735090101",
            "speakerId": 30226,
            "speakerName": "哈贾娜德",
            "text": "嘿嘿…呵呵…啊哈哈哈哈哈…大功告成了！",
            "nextDialogs": [
              "735090102"
            ]
          },
          "735090102": {
            "id": "735090102",
            "speakerId": 30226,
            "speakerName": "哈贾娜德",
            "text": "接下来只需要雇一群佣兵，进行试点部署，争取在十天内达成初始作战能力。",
            "nextDialogs": [
              "735090103"
            ]
          },
          "735090103": {
            "id": "735090103",
            "speakerId": 30226,
            "speakerName": "哈贾娜德",
            "text": "一旦取得了前线人员的报告，就能彻底说服导师，要到更多预算，然后向教令院证明，这就是炼金药剂的最强形态！",
            "nextDialogs": [
              "735090104"
            ]
          },
          "735090104": {
            "id": "735090104",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "怎么回事？这个人为什么孤零零地站在这里，对着沙漠的方向傻笑？",
            "nextDialogs": [
              "735090105"
            ]
          },
          "735090105": {
            "id": "735090105",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "还说着什么佣兵和作战，听起来像是战斗狂人才会说的话！",
            "nextDialogs": [
              "735090106"
            ]
          },
          "735090106": {
            "id": "735090106",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "#{NICKNAME}，我们怎么办？要不…先离她远一点？",
            "nextDialogs": [
              "735090108",
              "735090125"
            ]
          },
          "735090108": {
            "id": "735090108",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "噫！差点忘了，你也是个打架大师…",
            "nextDialogs": [
              "735090109"
            ]
          },
          "735090109": {
            "id": "735090109",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "说起来，以前也有差不多的情况呢——如果你和对方聊得投机，对方大概会直接雇我们帮忙。",
            "nextDialogs": [
              "735090110"
            ]
          },
          "735090110": {
            "id": "735090110",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "要是这个人不打算做坏事，给的摩拉也管够，我们倒是可以考虑考虑！",
            "nextDialogs": [
              "735090111"
            ]
          },
          "735090111": {
            "id": "735090111",
            "speakerId": 30226,
            "speakerName": "哈贾娜德",
            "text": "嗯？有人在背后议论我？",
            "nextDialogs": [
              "735090112"
            ]
          },
          "735090112": {
            "id": "735090112",
            "speakerId": 30226,
            "speakerName": "哈贾娜德",
            "text": "居…居然是你们！金发异乡人和「白色高智能浮游助手单元」！",
            "nextDialogs": [
              "735090113"
            ]
          },
          "735090113": {
            "id": "735090113",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "咦，你认识我们吗？我不记得我有过这种外号啊？",
            "nextDialogs": [
              "735090114"
            ]
          },
          "735090114": {
            "id": "735090114",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "介绍一下自己？",
            "nextDialogs": [
              "735090115"
            ]
          },
          "735090115": {
            "id": "735090115",
            "speakerId": 30226,
            "speakerName": "哈贾娜德",
            "text": "看样子你们忘掉我了…可以理解。毕竟我只是个普通人，而你们都是活传奇。",
            "nextDialogs": [
              "735090116"
            ]
          },
          "735090116": {
            "id": "735090116",
            "speakerId": 30226,
            "speakerName": "哈贾娜德",
            "text": "很久以前，你们帮我试验了我的得意之作「重熔片剂」——一种为战斗提供助力的新式炼金药剂。",
            "nextDialogs": [
              "735090117"
            ]
          },
          "735090117": {
            "id": "735090117",
            "speakerId": 30226,
            "speakerName": "哈贾娜德",
            "text": "那次的研究很顺利，你们享受了酣畅淋漓的战斗，为我提供了许多数据和启发。",
            "nextDialogs": [
              "735090118"
            ]
          },
          "735090118": {
            "id": "735090118",
            "speakerId": 30226,
            "speakerName": "哈贾娜德",
            "text": "可以说，你们改变了我的人生，我一直很感谢你们！我的研究成果也帮到了一些「三十人团」的成员，有助于须弥的治安…",
            "nextDialogs": [
              "735090119"
            ]
          },
          "735090119": {
            "id": "735090119",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "有，有这么夸张吗？那我们之后要好好回忆一下！",
            "nextDialogs": [
              "735090120"
            ]
          },
          "735090120": {
            "id": "735090120",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "话说回来，刚才你好像在念叨什么战斗和药剂的事？",
            "nextDialogs": [
              "735090121"
            ]
          },
          "735090121": {
            "id": "735090121",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "这一次也需要我们帮忙吗？",
            "nextDialogs": [
              "735090122"
            ]
          },
          "735090122": {
            "id": "735090122",
            "speakerId": 30226,
            "speakerName": "哈贾娜德",
            "text": "好啊！有你们两位在，我也不用去和那些佣兵打交道了。",
            "nextDialogs": [
              "735090123"
            ]
          },
          "735090123": {
            "id": "735090123",
            "speakerId": 30226,
            "speakerName": "哈贾娜德",
            "text": "说实在的，我还担心被他们漫天要价，或者直接打劫呢。",
            "nextDialogs": [
              "735090139"
            ]
          },
          "735090139": {
            "id": "735090139",
            "speakerId": 30226,
            "speakerName": "哈贾娜德",
            "text": "要是你们能帮我完成「震沸合剂」的验证工作，之前规划的预算全都付给你们，也算是对你们的进一步感谢了。",
            "nextDialogs": [
              "735090140"
            ]
          },
          "735090140": {
            "id": "735090140",
            "speakerId": 30226,
            "speakerName": "哈贾娜德",
            "text": "总计五十人份薪水的摩拉，这报酬还算丰厚吧？",
            "nextDialogs": [
              "735090141"
            ]
          },
          "735090141": {
            "id": "735090141",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "五十人份的摩拉？那不就相当于…干了一天的活，就好久好久都不用再忙了？",
            "nextDialogs": [
              "735090142"
            ]
          },
          "735090142": {
            "id": "735090142",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "#我觉得很划算，{NICKNAME}，这种好事可不多哦！"
          },
          "735090125": {
            "id": "735090125",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "这么一说，她好像确实有点眼熟…",
            "nextDialogs": [
              "735090126"
            ]
          },
          "735090126": {
            "id": "735090126",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "我想起来了，很久以前，我们在雨林里的悬崖边遇见过这个人！她叫什么来着…"
          }
        }
      }
    }
  ]
}
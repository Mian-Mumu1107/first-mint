    {
      "subId": "2001002",
      "subQuestName": "和艾拉·马斯克一起前往丘丘人营地",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "200100201"
        ],
        "dialogs": {
          "200100201": {
            "id": "200100201",
            "speakerId": 1565,
            "speakerName": "艾拉·马斯克",
            "text": "这里刚好有个丘丘人醒着。",
            "nextDialogs": [
              "200100202"
            ]
          },
          "200100202": {
            "id": "200100202",
            "speakerId": 1565,
            "speakerName": "艾拉·马斯克",
            "text": "就这位了，我们快点过去吧。",
            "nextDialogs": [
              "200100203"
            ]
          },
          "200100203": {
            "id": "200100203",
            "speakerId": 1565,
            "speakerName": "艾拉·马斯克",
            "text": "小心点，过去的时候别吵醒其他丘丘人。",
            "nextDialogs": [
              "200100204"
            ]
          },
          "200100204": {
            "id": "200100204",
            "speakerId": 1565,
            "speakerName": "艾拉·马斯克",
            "text": "不然他们肯定会误会，以为我们是准备来攻击他们。",
            "nextDialogs": [
              "200100205"
            ]
          },
          "200100205": {
            "id": "200100205",
            "speakerId": 1565,
            "speakerName": "艾拉·马斯克",
            "text": "要是这样，肯定不能顺利地对话了。"
          }
        }
      }
    },

    },
    {
      "subId": "2001001",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "200100101"
        ],
        "dialogs": {
          "200100101": {
            "id": "200100101",
            "speakerId": 1565,
            "speakerName": "艾拉·马斯克",
            "text": "旅行者，这里，过来这里！",
            "nextDialogs": [
              "200100102"
            ]
          },
          "200100102": {
            "id": "200100102",
            "speakerId": 1565,
            "speakerName": "艾拉·马斯克",
            "text": "别惊动了那些丘丘人，你怎么总是直挺挺地往营地里面冲呀…",
            "nextDialogs": [
              "200100103"
            ]
          },
          "200100103": {
            "id": "200100103",
            "speakerId": 1565,
            "speakerName": "艾拉·马斯克",
            "text": "算了，不管这些了，我一直在研究丘丘人的语言，但是比起记录，我更想要研究口语。",
            "nextDialogs": [
              "200100104"
            ]
          },
          "200100104": {
            "id": "200100104",
            "speakerId": 1565,
            "speakerName": "艾拉·马斯克",
            "text": "好不容易在这里遇见了一个完整的丘丘人营地，我可不能放过这个机会。",
            "nextDialogs": [
              "200100105"
            ]
          },
          "200100105": {
            "id": "200100105",
            "speakerId": 1565,
            "speakerName": "艾拉·马斯克",
            "text": "所以，旅行者，你能和我一起去这营地里面，找个丘丘人来练习口语吗？"
          }
        }
      }
    }
  ]
}
    {
      "subId": "2001008",
      "subQuestName": "接近醒着的丘丘人，不能吵醒其他丘丘人",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "200100801"
        ],
        "dialogs": {
          "200100801": {
            "id": "200100801",
            "speakerId": 1565,
            "speakerName": "艾拉·马斯克",
            "text": "都说了别惊醒其他的丘丘人了，你难道从来没有「悄悄接近」丘丘人营地的经验吗？",
            "nextDialogs": [
              "200100802"
            ]
          },
          "200100802": {
            "id": "200100802",
            "speakerId": 1565,
            "speakerName": "艾拉·马斯克",
            "text": "唉，这个营地已经没有丘丘人了，大好的机会就被这么浪费了。只能下次再说了。"
          }
        }
      }
    },
    {
      "subId": "2001010",
      "subQuestName": "(test)惊醒丘丘人$HIDDEN",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "200101001"
        ],
        "dialogs": {
          "200101001": {
            "id": "200101001",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "还是你自己去吧。",
            "nextDialogs": [
              "200101002"
            ]
          },
          "200101002": {
            "id": "200101002",
            "speakerId": 1565,
            "speakerName": "艾拉·马斯克",
            "text": "不行！这是个宝贵的学习机会，就算你想偷懒，我也不会放你走的！"
          }
        }
      }
    },
    {
      "subId": "2001014",
      "subQuestName": "(test)陪同艾拉·马斯克与丘丘人对话$HIDDEN",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "200100601"
        ],
        "dialogs": {
          "200100601": {
            "id": "200100601",
            "speakerId": 1565,
            "speakerName": "艾拉·马斯克",
            "text": "Olah! Muhe mimi, nye, eh... mosi aba?",
            "nextDialogs": [
              "200100602"
            ]
          },
          "200100602": {
            "id": "200100602",
            "speakerId": 20025,
            "speakerName": "丘丘人",
            "text": "Yo mimi beru si?",
            "nextDialogs": [
              "200100603"
            ]
          },
          "200100603": {
            "id": "200100603",
            "speakerId": 1565,
            "speakerName": "艾拉·马斯克",
            "text": "Buka...mita nye, guru-guru...yo mosi ka?",
            "nextDialogs": [
              "200100604"
            ]
          },
          "200100604": {
            "id": "200100604",
            "speakerId": 20025,
            "speakerName": "丘丘人",
            "text": "Ya odomu, Todo yo, buka guru-guru nye.",
            "nextDialogs": [
              "200100605"
            ]
          },
          "200100605": {
            "id": "200100605",
            "speakerId": 1565,
            "speakerName": "艾拉·马斯克",
            "text": "Mi? Dada! Valo.",
            "nextDialogs": [
              "200100606"
            ]
          },
          "200100606": {
            "id": "200100606",
            "speakerId": 20025,
            "speakerName": "丘丘人",
            "text": "Valo, ya odomu.",
            "nextDialogs": [
              "200100607"
            ]
          },
          "200100607": {
            "id": "200100607",
            "speakerId": 1565,
            "speakerName": "艾拉·马斯克",
            "text": "嘻嘻，看这个丘丘人的动作，好像很开心的样子呢。",
            "nextDialogs": [
              "200100608"
            ]
          },
          "200100608": {
            "id": "200100608",
            "speakerId": 1565,
            "speakerName": "艾拉·马斯克",
            "text": "看样子这次的交流成功了，我的丘丘人口语果然很不错。"
          }
        }
      }
    },
    {
      "subId": "2001004",
      "subQuestName": "(test)陪同艾拉·马斯克与丘丘人对话$HIDDEN",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "200100301"
        ],
        "dialogs": {
          "200100301": {
            "id": "200100301",
            "speakerId": 1565,
            "speakerName": "艾拉·马斯克",
            "text": "Biat ye, ye pupu dada mosi! Plama ye upa dada!",
            "nextDialogs": [
              "200100302"
            ]
          },
          "200100302": {
            "id": "200100302",
            "speakerId": 20025,
            "speakerName": "丘丘人",
            "text": "Dala beru yo?! Kundala muhe, kucha?",
            "nextDialogs": [
              "200100303"
            ]
          },
          "200100303": {
            "id": "200100303",
            "speakerId": 1565,
            "speakerName": "艾拉·马斯克",
            "text": "Kundala gusha! Hahaha!",
            "nextDialogs": [
              "200100304"
            ]
          },
          "200100304": {
            "id": "200100304",
            "speakerId": 20025,
            "speakerName": "丘丘人",
            "text": "Biat ye, plata ye pupu!",
            "nextDialogs": [
              "200100305"
            ]
          },
          "200100305": {
            "id": "200100305",
            "speakerId": 20025,
            "speakerName": "丘丘人",
            "text": "Movo unta nye kucha, mi dada tiga mitono!",
            "nextDialogs": [
              "200100306"
            ]
          },
          "200100306": {
            "id": "200100306",
            "speakerId": 1565,
            "speakerName": "艾拉·马斯克",
            "text": "看来他听懂我说的话了，正在准备拿礼物给我们…",
            "nextDialogs": [
              "200100307"
            ]
          },
          "200100307": {
            "id": "200100307",
            "speakerId": 1565,
            "speakerName": "艾拉·马斯克",
            "text": "是，是武器！呜呜呜呜呜，旅行者！救救我！"
          }
        }
      }
    },
    {
      "subId": "2001007",
      "subQuestName": "(test)控制刷怪$HIDDEN",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "200100701"
        ],
        "dialogs": {
          "200100701": {
            "id": "200100701",
            "speakerId": 1565,
            "speakerName": "艾拉·马斯克",
            "text": "怎么样？我的丘丘人口语很不错吧？只要语言能够相通，那么互相理解也只是时间问题。",
            "nextDialogs": [
              "200100702"
            ]
          },
          "200100702": {
            "id": "200100702",
            "speakerId": 1565,
            "speakerName": "艾拉·马斯克",
            "text": "我是这么希望的…我的梦想，是和丘丘人们做朋友。",
            "nextDialogs": [
              "200100703"
            ]
          },
          "200100703": {
            "id": "200100703",
            "speakerId": 1565,
            "speakerName": "艾拉·马斯克",
            "text": "对了，请收下这个吧，这是刚才那位丘丘人送给我们的。",
            "nextDialogs": [
              "200100704"
            ]
          },
          "200100704": {
            "id": "200100704",
            "speakerId": 1565,
            "speakerName": "艾拉·马斯克",
            "text": "一份来自于丘丘人的礼物，还是很新奇的吧？",
            "nextDialogs": [
              "200100705"
            ]
          },
          "200100705": {
            "id": "200100705",
            "speakerId": 1565,
            "speakerName": "艾拉·马斯克",
            "text": "那么我先走了，还有很多发现要记录下来，下次有机会再见吧。"
          }
        }
      }
    },
    {
      "subId": "2001011",
      "subQuestName": "(test)判断08或10完成$HIDDEN",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "200101101"
        ],
        "dialogs": {
          "200101101": {
            "id": "200101101",
            "speakerId": 1565,
            "speakerName": "艾拉·马斯克",
            "text": "糟糕，他们全都醒了！"
          }
        }
      }
    },
    {
      "subId": "2001005",
      "subQuestName": "击退生气的丘丘人",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "200100501"
        ],
        "dialogs": {
          "200100501": {
            "id": "200100501",
            "speakerId": 1565,
            "speakerName": "艾拉·马斯克",
            "text": "小心点，过去的时候别吵醒其他丘丘人。",
            "nextDialogs": [
              "200100502"
            ]
          },
          "200100502": {
            "id": "200100502",
            "speakerId": 1565,
            "speakerName": "艾拉·马斯克",
            "text": "不然他们肯定会误会，以为我们是准备来攻击他们。",
            "nextDialogs": [
              "200100503"
            ]
          },
          "200100503": {
            "id": "200100503",
            "speakerId": 1565,
            "speakerName": "艾拉·马斯克",
            "text": "要是这样，肯定不能顺利地对话了。"
          }
        }
      }
    },
    {
      "subId": "2001006",
      "subQuestName": "与艾拉·马斯克对话",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "200100401"
        ],
        "dialogs": {
          "200100401": {
            "id": "200100401",
            "speakerId": 1565,
            "speakerName": "艾拉·马斯克",
            "text": "还好有你在，不然我都不知道怎么收场了。",
            "nextDialogs": [
              "200100402"
            ]
          },
          "200100402": {
            "id": "200100402",
            "speakerId": 1565,
            "speakerName": "艾拉·马斯克",
            "text": "我觉得我没说错什么地方呀，到底是哪里的发音出问题了？",
            "nextDialogs": [
              "200100403"
            ]
          },
          "200100403": {
            "id": "200100403",
            "speakerId": 1565,
            "speakerName": "艾拉·马斯克",
            "text": "我回去得再好好研究一下…"
          }
        }
      }
    },
    {
      "subId": "2001015",
      "subQuestName": "与艾拉·马斯克对话",
      "sceneId": null,
      "locations": [],

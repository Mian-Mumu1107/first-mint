  "subQuests": [
    {
      "subId": "2001009",
      "subQuestName": "前往询问艾拉·马斯克",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "200100901"
        ],
        "dialogs": {
          "200100901": {
            "id": "200100901",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "好的，我现在就去抓一个…",
            "nextDialogs": [
              "200100902"
            ]
          },
          "200100902": {
            "id": "200100902",
            "speakerId": 1565,
            "speakerName": "艾拉·马斯克",
            "text": "等等！别直接冲进去，这些到底是谁教你的啊？！",
            "nextDialogs": [
              "200100903"
            ]
          },
          "200100903": {
            "id": "200100903",
            "speakerId": 1565,
            "speakerName": "艾拉·马斯克",
            "text": "等会和我一起，我们找一个丘丘人，友好地对话吧。"
          }
        }
      }
    },

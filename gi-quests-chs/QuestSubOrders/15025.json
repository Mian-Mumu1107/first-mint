    {
      "subId": "1502515",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "150251501"
        ],
        "dialogs": {
          "150251501": {
            "id": "150251501",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "染料就藏在这个山洞里吗？",
            "nextDialogs": [
              "150251502"
            ]
          },
          "150251502": {
            "id": "150251502",
            "speakerId": 1002,
            "speakerName": "托尔特克",
            "text": "我只能带两位到这里，只有谕示选定的人才能继续往前走。",
            "nextDialogs": [
              "150251503"
            ]
          },
          "150251503": {
            "id": "150251503",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "为什么？",
            "nextDialogs": [
              "150251504"
            ]
          },
          "150251504": {
            "id": "150251504",
            "speakerId": 1002,
            "speakerName": "托尔特克",
            "text": "请容我说明一下，据说这个山洞里生长着一种奇特的果实，利用它的汁液可以制作上好的染料。",
            "nextDialogs": [
              "150251505"
            ]
          },
          "150251505": {
            "id": "150251505",
            "speakerId": 1002,
            "speakerName": "托尔特克",
            "text": "很多年前，一些先祖想要创作一系列伟大的涂鸦作品。或许为了方便制作染料，他们直接选择这个山洞作为创作地点。",
            "nextDialogs": [
              "150251506"
            ]
          },
          "150251506": {
            "id": "150251506",
            "speakerId": 1002,
            "speakerName": "托尔特克",
            "text": "不过，他们不想让这些作品在完成之前就被旁人看到，于是在山洞内留下了禁制。",
            "nextDialogs": [
              "150251507"
            ]
          },
          "150251507": {
            "id": "150251507",
            "speakerId": 1002,
            "speakerName": "托尔特克",
            "text": "似乎只有在「色彩」上造诣极高的人，才有能力解开这个禁制。",
            "nextDialogs": [
              "150251508"
            ]
          },
          "150251508": {
            "id": "150251508",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "哦…"
          }
        }
      }
    },
    {
      "subId": "1502599",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "150259901"
        ],
        "dialogs": {
          "150259901": {
            "id": "150259901",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "前面没路了...或许可以试试之前的办法?",
            "nextDialogs": [
              "150259902"
            ]
          },
          "150259902": {
            "id": "150259902",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "#{NICKNAME}，你看到了什么吧？那肯定就是我们要采集的东西！"
          }
        }
      }
    }

    {
      "subId": "1502504",
      "subQuestName": "设法破除屏障",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "150250401"
        ],
        "dialogs": {
          "150250401": {
            "id": "150250401",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "应该就是这里了！托尔特克说的果实应该就是石壁上那种吧？",
            "nextDialogs": [
              "150250402"
            ]
          },
          "150250402": {
            "id": "150250402",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "上次来的时候，没怎么注意过呢。",
            "nextDialogs": [
              "150250403"
            ]
          },
          "150250403": {
            "id": "150250403",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "不过，具体该采集哪些？",
            "nextDialogs": [
              "150250404"
            ]
          },
          "150250404": {
            "id": "150250404",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "应该和首领提到的能力有关。",
            "nextDialogs": [
              "150250405"
            ]
          },
          "150250405": {
            "id": "150250405",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "嗯，先试一试！"
          }
        }
      }
    },

    {
      "subId": "1502518",
      "subQuestName": "获取染料",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "150251801"
        ],
        "dialogs": {
          "150251801": {
            "id": "150251801",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "烟谜主先祖留下的涂鸦果然很壮观呢，不过，我们看到的涂鸦似乎还没有把故事讲完。",
            "nextDialogs": [
              "150251802"
            ]
          },
          "150251802": {
            "id": "150251802",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "难道山洞更深处还有涂鸦作品？有些好奇啊…",
            "nextDialogs": [
              "150251804",
              "150251806"
            ]
          },
          "150251804": {
            "id": "150251804",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "我只是随口一说啦，托尔特克还在外面等着，带染料出去更要紧一些吧？",
            "nextDialogs": [
              "150251807"
            ]
          },
          "150251807": {
            "id": "150251807",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "我们先去和托尔特克会合！"
          },
          "150251806": {
            "id": "150251806",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "嗯，以后肯定还有机会！"
          }
        }
      }
    },

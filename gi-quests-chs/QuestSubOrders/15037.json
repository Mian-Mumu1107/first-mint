    {
      "subId": "1503702",
      "subQuestName": "查看丝柯克的情况",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "150370201"
        ],
        "dialogs": {
          "150370201": {
            "id": "150370201",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "呼…早上好。",
            "nextDialogs": [
              "150370202"
            ]
          },
          "150370202": {
            "id": "150370202",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "咦，丝柯克还在冥想吗？已经过去两天了，她什么时候醒呀？",
            "nextDialogs": [
              "150370205"
            ]
          },
          "150370205": {
            "id": "150370205",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "嗯…不过感觉我们也帮不上什么忙…对了！我去买点早餐吧，等她醒了，估计肚子也饿啦。",
            "nextDialogs": [
              "150370206"
            ]
          },
          "150370206": {
            "id": "150370206",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "等我一下，很快就回来！",
            "nextDialogs": [
              "150370207"
            ]
          },
          "150370207": {
            "id": "150370207",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "（丝柯克的表情很平静，看上去就像是睡着了…）",
            "nextDialogs": [
              "150370208"
            ]
          },
          "150370208": {
            "id": "150370208",
            "speakerId": 15289,
            "speakerName": "奇特的生灵",
            "text": "♪~"
          }
        }
      }
    },

      }
    },
    {
      "subId": "1503710",
      "subQuestName": "跟随奇特的小家伙",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "150371001"
        ],
        "dialogs": {
          "150371001": {
            "id": "150371001",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "（这是…小时候的丝柯克？）",
            "nextDialogs": [
              "150371002"
            ]
          },
          "150371002": {
            "id": "150371002",
            "speakerId": 15289,
            "speakerName": "奇特的生灵",
            "text": "一口气走到了这里呢！这是丝柯克刚开始拜师学艺，跟随极恶骑训练的时候。",
            "nextDialogs": [
              "150371003"
            ]
          },
          "150371003": {
            "id": "150371003",
            "speakerId": 15288,
            "speakerName": "苏尔特洛奇",
            "text": "断了的手腕我帮你接好了，明天再加一倍的训练量。",
            "nextDialogs": [
              "150371004"
            ]
          },
          "150371004": {
            "id": "150371004",
            "speakerId": 13790,
            "speakerName": "丝柯克",
            "text": "……",
            "nextDialogs": [
              "150371005"
            ]
          },
          "150371005": {
            "id": "150371005",
            "speakerId": 15288,
            "speakerName": "苏尔特洛奇",
            "text": "这次你没有哭，很好。弱者往往寄希望于用眼泪引起同情，这是最无用的想法。",
            "nextDialogs": [
              "150371006"
            ]
          },
          "150371006": {
            "id": "150371006",
            "speakerId": 13790,
            "speakerName": "丝柯克",
            "text": "我能问个问题吗？师父…为什么要救我？",
            "nextDialogs": [
              "150371007"
            ]
          },
          "150371007": {
            "id": "150371007",
            "speakerId": 13790,
            "speakerName": "丝柯克",
            "text": "我一直觉得，或许我不该活下来…这样就不必时时想起那场大火，也不必像现在这样…",
            "nextDialogs": [
              "150371008"
            ]
          },
          "150371008": {
            "id": "150371008",
            "speakerId": 15288,
            "speakerName": "苏尔特洛奇",
            "text": "我救你，是出于自己的目的。",
            "nextDialogs": [
              "150371009"
            ]
          },
          "150371009": {
            "id": "150371009",
            "speakerId": 15288,
            "speakerName": "苏尔特洛奇",
            "text": "我已经太久没有品味过「全力以赴的战斗」了。那些杰出的天才如我踏过的泥沙，就连命运也向我俯首。",
            "nextDialogs": [
              "150371010"
            ]
          },
          "150371010": {
            "id": "150371010",
            "speakerId": 15288,
            "speakerName": "苏尔特洛奇",
            "text": "所以，我会倾尽一切地培养你，不择手段地训练你。希望有一天，你能够给我带来一些惊喜。",
            "nextDialogs": [
              "150371011"
            ]
          },
          "150371011": {
            "id": "150371011",
            "speakerId": 13790,
            "speakerName": "丝柯克",
            "text": "可是我并不想向你挥剑…！",
            "nextDialogs": [
              "150371012"
            ]
          },
          "150371012": {
            "id": "150371012",
            "speakerId": 15288,
            "speakerName": "苏尔特洛奇",
            "text": "现在，你的想法并不重要。",
            "nextDialogs": [
              "150371013"
            ]
          },
          "150371013": {
            "id": "150371013",
            "speakerId": 15288,
            "speakerName": "苏尔特洛奇",
            "text": "弱者的呐喊在广袤的星海中溅不起半点浪花，这一点你应该深有体会。",
            "nextDialogs": [
              "150371014"
            ]
          },
          "150371014": {
            "id": "150371014",
            "speakerId": 13790,
            "speakerName": "丝柯克",
            "text": "我明白了，师父。",
            "nextDialogs": [
              "150371015"
            ]
          },
          "150371015": {
            "id": "150371015",
            "speakerId": 15289,
            "speakerName": "奇特的生灵",
            "text": "从那日起，浸透血泪的训练再无尽头，疲惫与虚无的感受每天都如影随形。",
            "nextDialogs": [
              "150371016"
            ]
          },
          "150371016": {
            "id": "150371016",
            "speakerId": 15289,
            "speakerName": "奇特的生灵",
            "text": "不知过去多久，她的天赋开花结果，她也终于能像师父一样掌控内心的情感了。怎么说呢…",
            "nextDialogs": [
              "150371017"
            ]
          },
          "150371017": {
            "id": "150371017",
            "speakerId": 15289,
            "speakerName": "奇特的生灵",
            "text": "她的心里仍然装着人类的悲喜，但所有情绪都要经过理性的允许。顺便一提，这时候开始，她变得像你认识的那个丝柯克了。",
            "nextDialogs": [
              "150371018"
            ]
          },
          "150371018": {
            "id": "150371018",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "（极恶骑似乎是从一场灾害中救了年轻的丝柯克，并从一开始就毫不掩饰自己救她的目的。）",
            "nextDialogs": [
              "150371019"
            ]
          },
          "150371019": {
            "id": "150371019",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "（只剩下一个谜团了——那场「灾害」究竟是什么？）",
            "nextDialogs": [
              "150371020"
            ]
          },
          "150371020": {
            "id": "150371020",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "（极恶骑最后的话语残酷而冰冷，但当时的丝柯克却好像很容易就接受了。这也是受那场灾害的影响吗？）",
            "nextDialogs": [
              "150371021"
            ]
          },
          "150371021": {
            "id": "150371021",
            "speakerId": 15289,
            "speakerName": "奇特的生灵",
            "text": "啊…快到终点了！",
            "nextDialogs": [
              "150371022"
            ]
          },
          "150371022": {
            "id": "150371022",
            "speakerId": 15289,
            "speakerName": "奇特的生灵",
            "text": "还有点舍不得呢。走吧？陪我走完这最后一程。"
          }
        }
      }
    },
    {
      "subId": "1503711",
      "subQuestName": "跟随奇特的小家伙",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [],
        "dialogs": {}
      }
    },
    {
      "subId": "1503712",
      "subQuestName": "跟随奇特的小家伙",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "150371201"
        ],
        "dialogs": {
          "150371201": {
            "id": "150371201",
            "speakerId": 15289,
            "speakerName": "奇特的生灵",
            "text": "喔…这里应该是所有回忆中最美好的部分了。",
            "nextDialogs": [
              "150371202"
            ]
          },
          "150371202": {
            "id": "150371202",
            "speakerId": 15289,
            "speakerName": "奇特的生灵",
            "text": "多么无忧无虑的时光啊。天上是薄薄的云，阳光将一切染成碎金色。歌声里，就算是含羞的花儿也会一同起舞。",
            "nextDialogs": [
              "150371203"
            ]
          },
          "150371203": {
            "id": "150371203",
            "speakerId": 15289,
            "speakerName": "奇特的生灵",
            "text": "这里就是丝柯克的故乡。小时候的丝柯克生活在这里，她对一切都充满好奇，时常逃学去各个地方玩耍。",
            "nextDialogs": [
              "150371204"
            ]
          },
          "150371204": {
            "id": "150371204",
            "speakerId": 15289,
            "speakerName": "奇特的生灵",
            "text": "海底深处的宝藏，遥远星空中的秘密，还有「商船」上那些打扮奇怪的大人…对，商船。那是一切的转折。",
            "nextDialogs": [
              "150371205"
            ]
          },
          "150371205": {
            "id": "150371205",
            "speakerId": 15289,
            "speakerName": "奇特的生灵",
            "text": "某一天，一艘飞船降落这里。下船的人面带笑容，说自己来自一颗邻近的星球，想要进行友好的贸易。",
            "nextDialogs": [
              "150371206"
            ]
          },
          "150371206": {
            "id": "150371206",
            "speakerId": 15289,
            "speakerName": "奇特的生灵",
            "text": "丝柯克的爸爸妈妈、叔叔伯伯…大家亲切地招待了远方的客人，并允许他们在星球上自由探索，一时间宾主尽欢。",
            "nextDialogs": [
              "150371207"
            ]
          },
          "150371207": {
            "id": "150371207",
            "speakerId": 15289,
            "speakerName": "奇特的生灵",
            "text": "当时，谁都没有预料到之后发生的事。数个月后，来历不明的军队突然抵达，沉默地覆灭了星球上的一切。",
            "nextDialogs": [
              "150371208"
            ]
          },
          "150371208": {
            "id": "150371208",
            "speakerId": 15289,
            "speakerName": "奇特的生灵",
            "text": "丝柯克那天照旧逃学，所以没有第一时间被发现。但她回来的路上，却正好目睹了那场惨剧。",
            "nextDialogs": [
              "150371209"
            ]
          },
          "150371209": {
            "id": "150371209",
            "speakerId": 15289,
            "speakerName": "奇特的生灵",
            "text": "无数的人向她呼救。熟悉的人，亲近的人…父亲的兄弟，母亲的姐妹…还有邻家的小女儿、瘸腿的商贩、古板的大鼻子老师…",
            "nextDialogs": [
              "150371210"
            ]
          },
          "150371210": {
            "id": "150371210",
            "speakerId": 15289,
            "speakerName": "奇特的生灵",
            "text": "人命就像无人在意的廉价商品，被大火付之一炬。她什么都做不到，只能不断地跑，直至眼前出现那个人的身影。",
            "nextDialogs": [
              "150371211"
            ]
          },
          "150371211": {
            "id": "150371211",
            "speakerId": 15289,
            "speakerName": "奇特的生灵",
            "text": "如果不是「极恶骑」偶然路过这里，她应该也会葬身在那场大火中，到死都不明白这一切的原因。",
            "nextDialogs": [
              "150371214"
            ]
          },
          "150371214": {
            "id": "150371214",
            "speakerId": 15289,
            "speakerName": "奇特的生灵",
            "text": "……",
            "nextDialogs": [
              "150371215"
            ]
          },
          "150371215": {
            "id": "150371215",
            "speakerId": 15289,
            "speakerName": "奇特的生灵",
            "text": "因为她和她的族人是「威胁」。"
          }
        }
      }
    },
    {
      "subId": "1503713",
      "subQuestName": "跟随奇特的小家伙",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [],
        "dialogs": {}
      }
    },
    {
      "subId": "1503714",
      "subQuestName": "与丝柯克对话",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "150371401"
        ],
        "dialogs": {
          "150371401": {
            "id": "150371401",
            "speakerId": 13790,
            "speakerName": "丝柯克",
            "text": "……",
            "nextDialogs": [
              "150371402"
            ]
          },
          "150371402": {
            "id": "150371402",
            "speakerId": 13790,
            "speakerName": "丝柯克",
            "text": "#所以，你让我在这里等，就为了带{M#他}{F#她}过来？",
            "nextDialogs": [
              "150371403"
            ]
          },
          "150371403": {
            "id": "150371403",
            "speakerId": 15289,
            "speakerName": "奇特的生灵",
            "text": "我想和「你」…不，想和「我」聊聊。",
            "nextDialogs": [
              "150371404"
            ]
          },
          "150371404": {
            "id": "150371404",
            "speakerId": 15289,
            "speakerName": "奇特的生灵",
            "text": "#我希望有人见证我们的争吵与和解，而{M#他}{F#她}是此刻最好的人选。",
            "nextDialogs": [
              "150371407"
            ]
          },
          "150371407": {
            "id": "150371407",
            "speakerId": 15289,
            "speakerName": "奇特的生灵",
            "text": "我正是被理性压制的情感，是她锁在内心监牢中的「自己」。",
            "nextDialogs": [
              "150371408"
            ]
          },
          "150371408": {
            "id": "150371408",
            "speakerId": 15289,
            "speakerName": "奇特的生灵",
            "text": "那些被你否决的冲动，那些被你抛下的过往，最终都化成了「我」的一部分。",
            "nextDialogs": [
              "150371409"
            ]
          },
          "150371409": {
            "id": "150371409",
            "speakerId": 15289,
            "speakerName": "奇特的生灵",
            "text": "所以，我也是「最初的你」。因为你一直不愿意正视我，所以我主动来见你了。",
            "nextDialogs": [
              "150371410"
            ]
          },
          "150371410": {
            "id": "150371410",
            "speakerId": 13790,
            "speakerName": "丝柯克",
            "text": "你错了。我一直都正视你，所以才将你封存在这里。",
            "nextDialogs": [
              "150371411"
            ]
          },
          "150371411": {
            "id": "150371411",
            "speakerId": 13790,
            "speakerName": "丝柯克",
            "text": "你的存在只会削弱我的力量。那些你流露出憧憬与喜悦的瞬间，恰恰是这具身体最脆弱的时候。",
            "nextDialogs": [
              "150371412"
            ]
          },
          "150371412": {
            "id": "150371412",
            "speakerId": 13790,
            "speakerName": "丝柯克",
            "text": "别忘了，正因为相信善良与美好，我们的故乡才会变成废墟。宇宙太过广袤，个人的情感不值一提。",
            "nextDialogs": [
              "150371413"
            ]
          },
          "150371413": {
            "id": "150371413",
            "speakerId": 15289,
            "speakerName": "奇特的生灵",
            "text": "的确如此。但修正错误不代表否定过去的一切。",
            "nextDialogs": [
              "150371414"
            ]
          },
          "150371414": {
            "id": "150371414",
            "speakerId": 15289,
            "speakerName": "奇特的生灵",
            "text": "剥离掉你所谓「软弱」的情感，我们和那些带来毁灭的士兵又有什么区别？",
            "nextDialogs": [
              "150371415"
            ]
          },
          "150371415": {
            "id": "150371415",
            "speakerId": 13790,
            "speakerName": "丝柯克",
            "text": "区别在于我清楚地知道自己在做什么、要做什么。",
            "nextDialogs": [
              "150371416"
            ]
          },
          "150371416": {
            "id": "150371416",
            "speakerId": 13790,
            "speakerName": "丝柯克",
            "text": "我承认你的存在，只是限制你的自由，这是我最大的仁慈。",
            "nextDialogs": [
              "150371417"
            ]
          },
          "150371417": {
            "id": "150371417",
            "speakerId": 13790,
            "speakerName": "丝柯克",
            "text": "我背负了你无法做到的一切，甚至超越了麻木与虚无。理性支撑着我一路走到这里，是我之所以为「我」、为强者的重要原因。",
            "nextDialogs": [
              "150371418"
            ]
          },
          "150371418": {
            "id": "150371418",
            "speakerId": 15289,
            "speakerName": "奇特的生灵",
            "text": "问题就在这里，我想和你一起背负。",
            "nextDialogs": [
              "150371419"
            ]
          },
          "150371419": {
            "id": "150371419",
            "speakerId": 15289,
            "speakerName": "奇特的生灵",
            "text": "哪怕个人的情感相较广袤的宇宙显得渺小，我也觉得它一定有价值。它让冰冷的星海变得温暖，为我们所见到的世界赋予意义。",
            "nextDialogs": [
              "150371420"
            ]
          },
          "150371420": {
            "id": "150371420",
            "speakerId": 15289,
            "speakerName": "奇特的生灵",
            "text": "我想让你回忆起憧憬星空的夜晚，回忆起探索未知的午后。我想让你从那些安宁时光中得到慰藉，从无休止的压力中暂且抽身。",
            "nextDialogs": [
              "150371421"
            ]
          },
          "150371421": {
            "id": "150371421",
            "speakerId": 13790,
            "speakerName": "丝柯克",
            "text": "这不是眼下我们该做的事。",
            "nextDialogs": [
              "150371422"
            ]
          },
          "150371422": {
            "id": "150371422",
            "speakerId": 15289,
            "speakerName": "奇特的生灵",
            "text": "这就是眼下我们该做的事！",
            "nextDialogs": [
              "150371423"
            ]
          },
          "150371423": {
            "id": "150371423",
            "speakerId": 15289,
            "speakerName": "奇特的生灵",
            "text": "你想不想知道，为什么力量恢复得比你预想中要慢？",
            "nextDialogs": [
              "150371424"
            ]
          },
          "150371424": {
            "id": "150371424",
            "speakerId": 13790,
            "speakerName": "丝柯克",
            "text": "终于说到正题了。我在这里等你，就是想得到这个问题的答案。",
            "nextDialogs": [
              "150371425"
            ]
          },
          "150371425": {
            "id": "150371425",
            "speakerId": 15289,
            "speakerName": "奇特的生灵",
            "text": "那就看看这个世界，看看你的「内心」吧。",
            "nextDialogs": [
              "150371426"
            ]
          },
          "150371426": {
            "id": "150371426",
            "speakerId": 15289,
            "speakerName": "奇特的生灵",
            "text": "抽掉梦想与好奇心，就失去了最初的驱动力；裁断与否定过去的自己，就无法从往日的岁月中获得力量。",
            "nextDialogs": [
              "150371427"
            ]
          },
          "150371427": {
            "id": "150371427",
            "speakerId": 15289,
            "speakerName": "奇特的生灵",
            "text": "支撑你向前的只剩下恐惧与幸存者的内疚，这些东西没办法帮助你走到最后，所以这条河才会越来越浑浊。",
            "nextDialogs": [
              "150371428"
            ]
          },
          "150371428": {
            "id": "150371428",
            "speakerId": 13790,
            "speakerName": "丝柯克",
            "text": "那我也没有向弱者寻求帮助的道理。",
            "nextDialogs": [
              "150371429"
            ]
          },
          "150371429": {
            "id": "150371429",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "——这份感情并不弱小。",
            "nextDialogs": [
              "150371430"
            ]
          },
          "150371430": {
            "id": "150371430",
            "speakerId": 13790,
            "speakerName": "丝柯克",
            "text": "……",
            "nextDialogs": [
              "150371431"
            ]
          },
          "150371431": {
            "id": "150371431",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "它能跨越时间、挣脱束缚，出现在你的面前…这就是证明。",
            "nextDialogs": [
              "150371432"
            ]
          },
          "150371432": {
            "id": "150371432",
            "speakerId": 15289,
            "speakerName": "奇特的生灵",
            "text": "谢谢你替我说话，我就知道带你来是最正确的选择。",
            "nextDialogs": [
              "150371433"
            ]
          },
          "150371433": {
            "id": "150371433",
            "speakerId": 15289,
            "speakerName": "奇特的生灵",
            "text": "其实，我并不想跟你争论对错，我们之间本就没有对错之分。你说得对，如果不用理性隔绝情感，我们熬不过最艰难的时光。",
            "nextDialogs": [
              "150371434"
            ]
          },
          "150371434": {
            "id": "150371434",
            "speakerId": 15289,
            "speakerName": "奇特的生灵",
            "text": "但人不能永远走在一条路上，对吧？我知道你从未忘记那场灾难，作为唯一的幸存者，你时常会感到痛苦。",
            "nextDialogs": [
              "150371435"
            ]
          },
          "150371435": {
            "id": "150371435",
            "speakerId": 15289,
            "speakerName": "奇特的生灵",
            "text": "他们的声音在你耳边回响，其中也包括我的。因为在你的潜意识里，你很清楚自己并没有成为曾经预想中的模样。",
            "nextDialogs": [
              "150371436"
            ]
          },
          "150371436": {
            "id": "150371436",
            "speakerId": 15289,
            "speakerName": "奇特的生灵",
            "text": "没有实现的期待会变成扎入心脏的尖刺。哪怕你不愿意接受我，我也希望你…至少能放下一些事。",
            "nextDialogs": [
              "150371437"
            ]
          },
          "150371437": {
            "id": "150371437",
            "speakerId": 13790,
            "speakerName": "丝柯克",
            "text": "……",
            "nextDialogs": [
              "150371438"
            ]
          },
          "150371438": {
            "id": "150371438",
            "speakerId": 13790,
            "speakerName": "丝柯克",
            "text": "我还记得有一次打水的时候，爸爸妈妈唱过一首歌谣。",
            "nextDialogs": [
              "150371439"
            ]
          },
          "150371439": {
            "id": "150371439",
            "speakerId": 13790,
            "speakerName": "丝柯克",
            "text": "「舞动的流水啊，途中的泥沙在请求你的歌声与流动。你肯携跛足的泥沙一同远行吗？」",
            "nextDialogs": [
              "150371440"
            ]
          },
          "150371440": {
            "id": "150371440",
            "speakerId": 13790,
            "speakerName": "丝柯克",
            "text": "我并非轻快的流水，你也不是沉寂的泥沙。但如果这就是你的愿望，我会带着你一起走到最后。",
            "nextDialogs": [
              "150371441"
            ]
          },
          "150371441": {
            "id": "150371441",
            "speakerId": 15289,
            "speakerName": "奇特的生灵",
            "text": "谢谢你。",
            "nextDialogs": [
              "150371442"
            ]
          },
          "150371442": {
            "id": "150371442",
            "speakerId": 13790,
            "speakerName": "丝柯克",
            "text": "…是我该向你道谢。"
          }
        }
      }
    },
    {
      "subId": "1503715",
      "subQuestName": "与丝柯克对话",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "150371501"
        ],
        "dialogs": {
          "150371501": {
            "id": "150371501",
            "speakerId": 13790,
            "speakerName": "丝柯克",
            "text": "你看过我的记忆了，对吧？",
            "nextDialogs": [
              "150371502"
            ]
          },
          "150371502": {
            "id": "150371502",
            "speakerId": 13790,
            "speakerName": "丝柯克",
            "text": "我曾经问过自己的师父，弱肉强食是否就是宇宙的终极法则。",
            "nextDialogs": [
              "150371503"
            ]
          },
          "150371503": {
            "id": "150371503",
            "speakerId": 13790,
            "speakerName": "丝柯克",
            "text": "师父的回答是，「并非如此，但是在缺乏秩序的世界里，没有下限的人往往更容易活下来」。",
            "nextDialogs": [
              "150371506"
            ]
          },
          "150371506": {
            "id": "150371506",
            "speakerId": 13790,
            "speakerName": "丝柯克",
            "text": "所以在听完之后，我萌生出一个想法。",
            "nextDialogs": [
              "150371507"
            ]
          },
          "150371507": {
            "id": "150371507",
            "speakerId": 13790,
            "speakerName": "丝柯克",
            "text": "有一天，我要建立我自己的秩序。让当初的惨剧不会再次发生，让强权不再是世界的公理。",
            "nextDialogs": [
              "150371508"
            ]
          },
          "150371508": {
            "id": "150371508",
            "speakerId": 13790,
            "speakerName": "丝柯克",
            "text": "但是在那之前，我要先打赢师父。因为我的师父——苏尔特洛奇，本身就是一切规则的破坏者。",
            "nextDialogs": [
              "150371509"
            ]
          },
          "150371509": {
            "id": "150371509",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "这听起来并不容易。",
            "nextDialogs": [
              "150371510"
            ]
          },
          "150371510": {
            "id": "150371510",
            "speakerId": 13790,
            "speakerName": "丝柯克",
            "text": "没错，除了力量的差距外，我本身也没有把他视作敌人的理由。",
            "nextDialogs": [
              "150371511"
            ]
          },
          "150371511": {
            "id": "150371511",
            "speakerId": 13790,
            "speakerName": "丝柯克",
            "text": "尽管他培养我并非出自善心，但他做到了一个师父所有该做的事。师父救过我的命，教给我武艺与道理，我很尊敬他。",
            "nextDialogs": [
              "150371512"
            ]
          },
          "150371512": {
            "id": "150371512",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "但你们终有一天要刀剑相向…",
            "nextDialogs": [
              "150371513"
            ]
          },
          "150371513": {
            "id": "150371513",
            "speakerId": 13790,
            "speakerName": "丝柯克",
            "text": "我并不想这么做。但师父从不食言，他说的每句话我都必须认真对待。",
            "nextDialogs": [
              "150371514"
            ]
          },
          "150371514": {
            "id": "150371514",
            "speakerId": 13790,
            "speakerName": "丝柯克",
            "text": "他已经不在提瓦特，有时会通过深渊「传达」给我一些声音。多半是朴素的问候，偶尔也会解答我的疑惑。",
            "nextDialogs": [
              "150371515"
            ]
          },
          "150371515": {
            "id": "150371515",
            "speakerId": 13790,
            "speakerName": "丝柯克",
            "text": "每次收到问候的时候，我的心脏都会停跳一瞬。总担心下一秒他就会出现在我的面前，踏碎我的影子。",
            "nextDialogs": [
              "150371516"
            ]
          },
          "150371516": {
            "id": "150371516",
            "speakerId": 13790,
            "speakerName": "丝柯克",
            "text": "也许他是对的，这才是无法磨灭的恐惧。我敬佩他，也畏惧他，所以我无时无刻不在思考如何变强。",
            "nextDialogs": [
              "150371517"
            ]
          },
          "150371517": {
            "id": "150371517",
            "speakerId": 13790,
            "speakerName": "丝柯克",
            "text": "我不知道师父的心里到底在想什么，但我必须竭尽全力。"
          }
        }
      }
    },
    {
      "subId": "1503716",
      "subQuestName": "离开魂梦狭间",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "150371601"
        ],
        "dialogs": {
          "150371601": {
            "id": "150371601",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "（丝柯克的目光望向遥远的天际。）",
            "nextDialogs": [
              "150371602"
            ]
          },
          "150371602": {
            "id": "150371602",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "（这里已经没有要做的事了，要离开吗？）"
          }
        }
      }
    },
    {
      "subId": "1503717",
      "subQuestName": "与丝柯克对话",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "150371701"
        ],
        "dialogs": {
          "150371701": {
            "id": "150371701",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "啊，你们终于醒啦！",
            "nextDialogs": [
              "150371702"
            ]
          },
          "150371702": {
            "id": "150371702",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "真是的，我出去买东西回来，就看到你们都像睡着了一样，吓我一跳。",
            "nextDialogs": [
              "150371703"
            ]
          },
          "150371703": {
            "id": "150371703",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "怎么样，一切还顺利吗？",
            "nextDialogs": [
              "150371704"
            ]
          },
          "150371704": {
            "id": "150371704",
            "speakerId": 13790,
            "speakerName": "丝柯克",
            "text": "你说呢？",
            "nextDialogs": [
              "150371707"
            ]
          },
          "150371707": {
            "id": "150371707",
            "speakerId": 13790,
            "speakerName": "丝柯克",
            "text": "唯有有源之水，能洗净腐烂与污秽，从过去流到未来。",
            "nextDialogs": [
              "150371708"
            ]
          },
          "150371708": {
            "id": "150371708",
            "speakerId": 13790,
            "speakerName": "丝柯克",
            "text": "我教过你，将旅途中的感受融入自身的剑术流派。今天的事…大概也会永远地成为「我」的一部分吧。",
            "nextDialogs": [
              "150371709"
            ]
          },
          "150371709": {
            "id": "150371709",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "嗯？这种感觉…你们好像在聊我不知道的事情！",
            "nextDialogs": [
              "150371710"
            ]
          },
          "150371710": {
            "id": "150371710",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "不管啦，我带回来的点心很好吃哦，先填饱肚子再说！",
            "nextDialogs": [
              "150371711"
            ]
          },
          "150371711": {
            "id": "150371711",
            "speakerId": 1004,
            "speakerName": "Black Screen",
            "text": "三个人一起品尝了好吃的点心…",
            "nextDialogs": [
              "150371712"
            ]
          },
          "150371712": {
            "id": "150371712",
            "speakerId": 13790,
            "speakerName": "丝柯克",
            "text": "时间差不多，该去应战了。",
            "nextDialogs": [
              "150371713"
            ]
          },
          "150371713": {
            "id": "150371713",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "终于要跟他正面对抗了吗？"
          }
        }
      }
    },
    {
      "subId": "1503506",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "150350604"
        ],
        "dialogs": {
          "150350604": {
            "id": "150350604",
            "speakerId": 1311,
            "speakerName": "丝柯克",
            "text": "（真想快一点长大啊…外面的世界那么有趣，好想早点去看看。）"
          }
        }
      }
    },
    {
      "subId": "1503508",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "150350807"
        ],
        "dialogs": {

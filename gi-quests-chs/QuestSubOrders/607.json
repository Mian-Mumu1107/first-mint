            ]
          },
          "6070102": {
            "id": "6070102",
            "speakerId": 10011,
            "speakerName": "菲谢尔",
            "text": "大胆魔物，幽夜净土不会容忍此等罪行…",
            "nextDialogs": [
              "6070103"
            ]
          },
          "6070103": {
            "id": "6070103",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "是菲谢尔！",
            "nextDialogs": [
              "6070104"
            ]
          },
          "6070104": {
            "id": "6070104",
            "speakerId": 10012,
            "speakerName": "奥兹",
            "text": "#噢，是{NICKNAME}的声音！",
            "nextDialogs": [
              "6070105"
            ]
          },
          "6070105": {
            "id": "6070105",
            "speakerId": 10011,
            "speakerName": "菲谢尔",
            "text": "来得正是时候，吾之扈从啊，拔剑吧！"
          }
        }
      }
    },
    {
      "subId": "60702",
      "subQuestName": "(test)隐藏$HIDDEN",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "6070201"
        ],
        "dialogs": {
          "6070201": {
            "id": "6070201",
            "speakerId": 10011,
            "speakerName": "菲谢尔",
            "text": "汝等无需惊恐，魔物已被消灭。",
            "nextDialogs": [
              "6070202"
            ]
          },
          "6070202": {
            "id": "6070202",
            "speakerId": 10012,
            "speakerName": "奥兹",
            "text": "小姐的意思是，接下来也请不要随意外出，留在室内便好。我们会尽可能保证这一带居民的安全。",
            "nextDialogs": [
              "6070203"
            ]
          },
          "6070203": {
            "id": "6070203",
            "speakerId": 15262,
            "speakerName": "帕斯里",
            "text": "非常感谢！非常感谢！",
            "nextDialogs": [
              "6070204"
            ]
          },
          "6070204": {
            "id": "6070204",
            "speakerId": 15262,
            "speakerName": "帕斯里",
            "text": "不过，这只…这只大鸟竟然也会说话吗？哎呀…这…",
            "nextDialogs": [
              "6070205"
            ]
          },
          "6070205": {
            "id": "6070205",
            "speakerId": 10012,
            "speakerName": "奥兹",
            "text": "噢，您不必多虑，我只是小姐的臣子，绝不是乡野魔物，更不会对各位造成任何威胁。",
            "nextDialogs": [
              "6070206"
            ]
          },
          "6070206": {
            "id": "6070206",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "这两位都是好人，请放心。",
            "nextDialogs": [
              "6070207"
            ]
          },
          "6070207": {
            "id": "6070207",
            "speakerId": 15262,
            "speakerName": "帕斯里",
            "text": "啊、啊当然，我不是那个意思！抱歉，抱歉，都怪我口不择言的…",
            "nextDialogs": [
              "6070208"
            ]
          },
          "6070208": {
            "id": "6070208",
            "speakerId": 10011,
            "speakerName": "菲谢尔",
            "text": "嗯哼，无妨。",
            "nextDialogs": [
              "6070209"
            ]
          },
          "6070209": {
            "id": "6070209",
            "speakerId": 10011,
            "speakerName": "菲谢尔",
            "text": "扈从，还有要事在身么？尽管去铲平余孽吧，光辉的皇女祝福你的前路。"
          }
        }
      }
    },

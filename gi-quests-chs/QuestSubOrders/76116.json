        ],
        "dialogs": {
          "761160101": {
            "id": "761160101",
            "speakerId": 1000,
            "speakerName": "安妮兹卡",
            "text": "这不是我们和博比克的生死之交嘛！",
            "nextDialogs": [
              "761160103",
              "761160106",
              "761160109",
              "761160111"
            ]
          },
          "761160103": {
            "id": "761160103",
            "speakerId": 1000,
            "speakerName": "安妮兹卡",
            "text": "我们会留在这里一段时间，毕竟把德兹斯拉沃的实验室大门破坏了。我们得守在附近，免得再被那些坏蛋们乘虚而入了。",
            "nextDialogs": [
              "761160104"
            ]
          },
          "761160104": {
            "id": "761160104",
            "speakerId": 1000,
            "speakerName": "安妮兹卡",
            "text": "等我们修好了门，或是小德回家了，大概就会跟你们一样，带着博比克一起出门旅行吧！"
          },
          "761160106": {
            "id": "761160106",
            "speakerId": 1000,
            "speakerName": "安妮兹卡",
            "text": "完全没有头绪他会在哪里…要是你们在旅行的时候遇到他了的话，请替我们问好！",
            "nextDialogs": [
              "761160107"
            ]
          },
          "761160107": {
            "id": "761160107",
            "speakerId": 1000,
            "speakerName": "安妮兹卡",
            "text": "真想和他一起再到「旗舰」喝上整整一晚！"
          },
          "761160109": {
            "id": "761160109",
            "speakerId": 1000,
            "speakerName": "安妮兹卡",
            "text": "你想博比克啦？只要你有空，可以随时来找它玩哦！"
          },
          "761160111": {
            "id": "761160111",
            "speakerId": 1000,
            "speakerName": "安妮兹卡",
            "text": "嗯嗯，一定会再见的，毕竟我们是生死之交嘛！"
          }
        }
      }
    }
  ]
}
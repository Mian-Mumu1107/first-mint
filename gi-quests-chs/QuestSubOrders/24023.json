    {
      "subId": "2402310",
      "subQuestName": "(test)【隐藏】有交付A1B1C1要$HIDDEN",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "240231101"
        ],
        "dialogs": {
          "240231101": {
            "id": "240231101",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "给我灌装一瓶新的吧。",
            "nextDialogs": [
              "240231102"
            ]
          },
          "240231102": {
            "id": "240231102",
            "speakerId": 5209,
            "speakerName": "安里",
            "text": "没问题，请您稍等。",
            "nextDialogs": [
              "240231103"
            ]
          },
          "240231103": {
            "id": "240231103",
            "speakerId": 5209,
            "speakerName": "安里",
            "text": "好了，这瓶枫达我也灌装了两个人的量，应该够您喝了。",
            "nextDialogs": [
              "240231104"
            ]
          },
          "240231104": {
            "id": "240231104",
            "speakerId": 5209,
            "speakerName": "安里",
            "text": "无论如何…记住，清爽枫达，畅饮世界！"
          }
        }
      }

    {
      "subId": "2402310",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "240231001"
        ],
        "dialogs": {
          "240231001": {
            "id": "240231001",
            "speakerId": 5209,
            "speakerName": "安里",
            "text": "这瓶枫达就送给您了。这里面可是饱含着我们的心血啊，味道一定不会差的。",
            "nextDialogs": [
              "240231002"
            ]
          },
          "240231002": {
            "id": "240231002",
            "speakerId": 5209,
            "speakerName": "安里",
            "text": "但这种枫达还存在着许多问题。比如原料的处理方式和投放剂量、灌装时的最佳容量…",
            "nextDialogs": [
              "240231003"
            ]
          },
          "240231003": {
            "id": "240231003",
            "speakerId": 5209,
            "speakerName": "安里",
            "text": "甚至还有瓶身的设计方案。既然是新型枫达，那自然也要采用全新的包装，才能让人印象深刻。",
            "nextDialogs": [
              "240231004"
            ]
          },
          "240231004": {
            "id": "240231004",
            "speakerId": 5209,
            "speakerName": "安里",
            "text": "不过，这些问题就留给我操心吧，您只需要安心享用枫达就好。",
            "nextDialogs": [
              "240231005"
            ]
          },
          "240231005": {
            "id": "240231005",
            "speakerId": 5209,
            "speakerName": "安里",
            "text": "这瓶枫达我特意灌装了两个人的量，应该够您喝了。",
            "nextDialogs": [
              "240231006"
            ]
          },
          "240231006": {
            "id": "240231006",
            "speakerId": 5209,
            "speakerName": "安里",
            "text": "喔，我之前给您的那瓶枫达，您是还没来得及喝吗？",
            "nextDialogs": [
              "240231007"
            ]
          },
          "240231007": {
            "id": "240231007",
            "speakerId": 5209,
            "speakerName": "安里",
            "text": "按照时间算…这瓶枫达也许已经不能喝了，请把它给我吧，我给您灌一瓶新的。",
            "nextDialogs": [
              "240231008"
            ]
          },
          "240231008": {
            "id": "240231008",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "能把两瓶都给我吗？",
            "nextDialogs": [
              "240231009"
            ]
          },
          "240231009": {
            "id": "240231009",
            "speakerId": 5209,
            "speakerName": "安里",
            "text": "抱歉，我之前给您的那个枫达瓶是特别制作的，有着十分良好的密封性。",
            "nextDialogs": [
              "240231010"
            ]
          },
          "240231010": {
            "id": "240231010",
            "speakerId": 5209,
            "speakerName": "安里",
            "text": "这种瓶子我目前也只做出了一个，所以…如果要给您灌装新的枫达，之前的枫达就必须倒掉啊。"
          }
        }
      }
    }

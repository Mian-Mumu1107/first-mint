        "dialogs": {
          "240231301": {
            "id": "240231301",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "我还是留着原来的吧。",
            "nextDialogs": [
              "240231302"
            ]
          },
          "240231302": {
            "id": "240231302",
            "speakerId": 5209,
            "speakerName": "安里",
            "text": "好吧，我尊重您的意见。但您千万别喝这瓶枫达啊，过了这么长时间，它的味道也许会变得…非常怪。"
          }
        }

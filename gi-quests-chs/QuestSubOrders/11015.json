    {
      "subId": "1101330",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "110133001"
        ],
        "dialogs": {
          "110133001": {
            "id": "110133001",
            "speakerId": 1009,
            "speakerName": "刻晴",
            "text": "旅行者，派蒙，没想到你们居然找到孤云阁来了。",
            "nextDialogs": [
              "110133002"
            ]
          },
          "110133002": {
            "id": "110133002",
            "speakerId": 1009,
            "speakerName": "刻晴",
            "text": "有什么事吗？我现在很忙，恐怕聊不了太久。",
            "nextDialogs": [
              "110133004",
              "110133008"
            ]
          },
          "110133004": {
            "id": "110133004",
            "speakerId": 1009,
            "speakerName": "刻晴",
            "text": "如你所见，这里有些工程。",
            "nextDialogs": [
              "110133005"
            ]
          },
          "110133005": {
            "id": "110133005",
            "speakerId": 1009,
            "speakerName": "刻晴",
            "text": "我认为，比起群玉阁，此处的工事更加重要，所以特意过来监督。",
            "nextDialogs": [
              "110133006"
            ]
          },
          "110133006": {
            "id": "110133006",
            "speakerId": 1009,
            "speakerName": "刻晴",
            "text": "希望能赶得上…"
          },
          "110133008": {
            "id": "110133008",
            "speakerId": 1009,
            "speakerName": "刻晴",
            "text": "这是新式归终机。",
            "nextDialogs": [
              "110133009"
            ]
          },
          "110133009": {
            "id": "110133009",
            "speakerId": 1009,
            "speakerName": "刻晴",
            "text": "凝光命专人拆解研究归终机，以此为蓝本设计出了改良图纸。",
            "nextDialogs": [
              "110133010"
            ]
          },
          "110133010": {
            "id": "110133010",
            "speakerId": 1009,
            "speakerName": "刻晴",
            "text": "相比仙人制造的原版归终机，这一款的射速与威力都稍逊一筹，但胜在可以量产。",
            "nextDialogs": [
              "110133011"
            ]
          },
          "110133011": {
            "id": "110133011",
            "speakerId": 1009,
            "speakerName": "刻晴",
            "text": "而且拆卸和组装都十分方便，可以灵活部署到各个地方。",
            "nextDialogs": [
              "110133012"
            ]
          },
          "110133012": {
            "id": "110133012",
            "speakerId": 1009,
            "speakerName": "刻晴",
            "text": "相信它会是应对危机的良策。"
          }
        }
      }
    },
    {
      "subId": "1101424",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "110142401"
        ],
        "dialogs": {
          "110142401": {
            "id": "110142401",
            "speakerId": 1014,
            "speakerName": "常丰",
            "text": "群玉阁，真漂亮啊——"
          }
        }
      }
    },
    {
      "subId": "1101425",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "110142501"
        ],
        "dialogs": {
          "110142501": {
            "id": "110142501",
            "speakerId": 1015,
            "speakerName": "安顺",
            "text": "能在工期内完工，是大家的功劳。"
          }
        }
      }
    },
    {
      "subId": "1101426",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "110142601"
        ],
        "dialogs": {
          "110142601": {
            "id": "110142601",
            "speakerId": 1016,
            "speakerName": "乐明",
            "text": "群玉阁已经修建完毕，等千奇核心和仙家符箓安好之后，就可以升空了。"
          }
        }
      }
    },
    {
      "subId": "1101427",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "110142701"
        ],
        "dialogs": {
          "110142701": {
            "id": "110142701",
            "speakerId": 1017,
            "speakerName": "理正",
            "text": "能够参与修建群玉阁，对我也是一场考验…等放工之后，去喝一杯吧。"
          }
        }
      }
    },
    {
      "subId": "1101428",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "110142801"
        ],
        "dialogs": {
          "110142801": {
            "id": "110142801",
            "speakerId": 1018,
            "speakerName": "思勤",
            "text": "我已经迫不及待，想看到群玉阁升空了！"
          }
        }
      }
    },
    {
      "subId": "1101429",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "110142901"
        ],
        "dialogs": {
          "110142901": {
            "id": "110142901",
            "speakerId": 1019,
            "speakerName": "阿亮",
            "text": "终于可以松一口气了，这段时间，各式各样的人来来往往，我们的压力也很大。",
            "nextDialogs": [
              "110142902"
            ]
          },
          "110142902": {
            "id": "110142902",
            "speakerId": 1019,
            "speakerName": "阿亮",
            "text": "好在平安完工，希望孤云阁的兄弟们也一切顺利。"
          }
        }
      }
    },
    {
      "subId": "1101430",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "110143001"
        ],
        "dialogs": {
          "110143001": {
            "id": "110143001",
            "speakerId": 1020,
            "speakerName": "七七",
            "text": "啊，是你们。",
            "nextDialogs": [
              "110143002"
            ]
          },
          "110143002": {
            "id": "110143002",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "七七怎么在这里？",
            "nextDialogs": [
              "110143003"
            ]
          },
          "110143003": {
            "id": "110143003",
            "speakerId": 1020,
            "speakerName": "七七",
            "text": "海边，很危险。",
            "nextDialogs": [
              "110143004"
            ]
          },
          "110143004": {
            "id": "110143004",
            "speakerId": 1020,
            "speakerName": "七七",
            "text": "七七正在，帮忙，疏散人群。",
            "nextDialogs": [
              "110143007"
            ]
          },
          "110143007": {
            "id": "110143007",
            "speakerId": 1020,
            "speakerName": "七七",
            "text": "嗯。凝光说，海里有不好的东西。",
            "nextDialogs": [
              "110143008"
            ]
          },
          "110143008": {
            "id": "110143008",
            "speakerId": 1020,
            "speakerName": "七七",
            "text": "所以，派七七来，疏散人群。",
            "nextDialogs": [
              "110143009"
            ]
          },
          "110143009": {
            "id": "110143009",
            "speakerId": 1020,
            "speakerName": "七七",
            "text": "不过，没有人听七七说话，七七只能守在这里。",
            "nextDialogs": [
              "110143010"
            ]
          },
          "110143010": {
            "id": "110143010",
            "speakerId": 1020,
            "speakerName": "七七",
            "text": "万一有危险，七七就站出来，保护大家。",
            "nextDialogs": [
              "110143011"
            ]
          },
          "110143011": {
            "id": "110143011",
            "speakerId": 1020,
            "speakerName": "七七",
            "text": "你们，也不要靠近海边，会遇到危险。"
          }
        }
      }
    },
    {
      "subId": "1101505",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "110150501"
        ],
        "dialogs": {
          "110150501": {
            "id": "110150501",
            "speakerId": 1007,
            "speakerName": "申鹤",
            "text": "现在想想，多亏师父让我来送符箓，我才能与你相遇。",
            "nextDialogs": [
              "110150502"
            ]
          },
          "110150502": {
            "id": "110150502",
            "speakerId": 1007,
            "speakerName": "申鹤",
            "text": "今后，也请多关照了。"
          }
        }
      }

  "subQuests": [
    {
      "subId": "1101501",
      "subQuestName": "将千奇核心与仙家符箓交给秘书",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "110150101"
        ],
        "dialogs": {
          "110150101": {
            "id": "110150101",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "凝光小姐的小秘书，我们把材料找齐啦！",
            "nextDialogs": [
              "110150102"
            ]
          },
          "110150102": {
            "id": "110150102",
            "speakerId": 1001,
            "speakerName": "百闻",
            "text": "哦？这么快？",
            "nextDialogs": [
              "110150103"
            ]
          },
          "110150103": {
            "id": "110150103",
            "speakerId": 1001,
            "speakerName": "百闻",
            "text": "而且三位是一起找齐的吗…原来如此，我懂了。",
            "nextDialogs": [
              "110150104"
            ]
          },
          "110150104": {
            "id": "110150104",
            "speakerId": 1001,
            "speakerName": "百闻",
            "text": "千奇核心和仙家符箓都没什么问题。看来这场比赛，要分出胜负了呢。",
            "nextDialogs": [
              "110150105"
            ]
          },
          "110150105": {
            "id": "110150105",
            "speakerId": 1001,
            "speakerName": "百闻",
            "text": "#我宣布，这次材料筹备竞赛的三位优胜者，分别是{NICKNAME}、云堇和北斗！",
            "nextDialogs": [
              "110150106"
            ]
          },
          "110150106": {
            "id": "110150106",
            "speakerId": 1002,
            "speakerName": "宏飞",
            "text": "不是，这就结束了？我浮生石还没找到呢！",
            "nextDialogs": [
              "110150107"
            ]
          },
          "110150107": {
            "id": "110150107",
            "speakerId": 1003,
            "speakerName": "昌贵",
            "text": "我不能接受…",
            "nextDialogs": [
              "110150108"
            ]
          },
          "110150108": {
            "id": "110150108",
            "speakerId": 1004,
            "speakerName": "志成",
            "text": "唉，紧赶慢赶，还是慢人一步…",
            "nextDialogs": [
              "110150109"
            ]
          },
          "110150109": {
            "id": "110150109",
            "speakerId": 1001,
            "speakerName": "百闻",
            "text": "那就有请三位优胜者，先移步到群玉阁，凝光大人已经在上面等着了。",
            "nextDialogs": [
              "110150110"
            ]
          },
          "110150110": {
            "id": "110150110",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "咦？北斗哪去了，刚刚还看见她在这里的。",
            "nextDialogs": [
              "110150111"
            ]
          },
          "110150111": {
            "id": "110150111",
            "speakerId": 1001,
            "speakerName": "百闻",
            "text": "北斗小姐有些事情，可能会晚一点到。几位先随我来吧。",
            "nextDialogs": [
              "110150112"
            ]
          },
          "110150112": {
            "id": "110150112",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "好吧，那我们先到群玉阁上看看吧。",
            "nextDialogs": [
              "110150113"
            ]
          },
          "110150113": {
            "id": "110150113",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "上次登上群玉阁，好像还是很久之前呢！"
          }
        }
      }
    },
    {
      "subId": "1101506",
      "subQuestName": "在群玉阁上与凝光对话",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "110150201"
        ],
        "dialogs": {
          "110150201": {
            "id": "110150201",
            "speakerId": 1005,
            "speakerName": "凝光",
            "text": "将仙家符箓与千奇核心相结合，放入群玉阁控制仓内。",
            "nextDialogs": [
              "110150202"
            ]
          },
          "110150202": {
            "id": "110150202",
            "speakerId": 1005,
            "speakerName": "凝光",
            "text": "如此一来，群玉阁就算正式重建完毕。之后收起铁索，它便会升入高空。",
            "nextDialogs": [
              "110150203"
            ]
          },
          "110150203": {
            "id": "110150203",
            "speakerId": 1005,
            "speakerName": "凝光",
            "text": "辛苦几位。现在该由我兑现承诺，给你们奖励了。",
            "nextDialogs": [
              "110150204"
            ]
          },
          "110150204": {
            "id": "110150204",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "好耶！",
            "nextDialogs": [
              "110150205"
            ]
          },
          "110150205": {
            "id": "110150205",
            "speakerId": 1005,
            "speakerName": "凝光",
            "text": "云先生的来意，我稍有耳闻。你正在为新的戏曲寻找合适的舞台，对吗？",
            "nextDialogs": [
              "110150206"
            ]
          },
          "110150206": {
            "id": "110150206",
            "speakerId": 1006,
            "speakerName": "云堇",
            "text": "正是。不知道凝光小姐有什么建议吗？",
            "nextDialogs": [
              "110150207"
            ]
          },
          "110150207": {
            "id": "110150207",
            "speakerId": 1005,
            "speakerName": "凝光",
            "text": "既然是云先生隆重准备的新戏，想必极有分量，初演不如就选在这新建成的群玉阁上，如何？",
            "nextDialogs": [
              "110150208"
            ]
          },
          "110150208": {
            "id": "110150208",
            "speakerId": 1005,
            "speakerName": "凝光",
            "text": "群玉阁地势极高，由此向外，能一览众山小。高处知风劲，又可观人间众相，我想，天下怕是没有比这里更适合先生的戏台了。",
            "nextDialogs": [
              "110150209"
            ]
          },
          "110150209": {
            "id": "110150209",
            "speakerId": 1006,
            "speakerName": "云堇",
            "text": "多谢凝光小姐。稍后我会备好戏曲道具，劳烦凝光小姐一并带上群玉阁。",
            "nextDialogs": [
              "110150210"
            ]
          },
          "110150210": {
            "id": "110150210",
            "speakerId": 1005,
            "speakerName": "凝光",
            "text": "名戏佳曲，值得如此。不必客气。",
            "nextDialogs": [
              "110150211"
            ]
          },
          "110150211": {
            "id": "110150211",
            "speakerId": 1006,
            "speakerName": "云堇",
            "text": "#{NICKNAME}、申鹤，还有小派蒙，我先告辞了。记得来听我的戏哦。",
            "nextDialogs": [
              "110150212"
            ]
          },
          "110150212": {
            "id": "110150212",
            "speakerId": 1005,
            "speakerName": "凝光",
            "text": "#你呢？{NICKNAME}，你想问我什么呢？",
            "nextDialogs": [
              "110150213"
            ]
          },
          "110150213": {
            "id": "110150213",
            "speakerId": 1005,
            "speakerName": "凝光",
            "text": "#事先说明，你{MATEAVATAR#SEXPRO[INFO_MALE_PRONOUN_BROTHER|INFO_FEMALE_PRONOUN_SISTER]}的行踪我也不清楚，就不要浪费这个问题了。",
            "nextDialogs": [
              "110150214"
            ]
          },
          "110150214": {
            "id": "110150214",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "唔…凝光小姐总是未卜先知的样子呢…既然这样，就轮到派蒙来问了！",
            "nextDialogs": [
              "110150215"
            ]
          },
          "110150215": {
            "id": "110150215",
            "speakerId": 1005,
            "speakerName": "凝光",
            "text": "…经商可没有你们想的那么容易。资金、人脉、对风向的感知、对机遇的嗅觉…凡此种种，缺一不可。",
            "nextDialogs": [
              "110150216"
            ]
          },
          "110150216": {
            "id": "110150216",
            "speakerId": 1005,
            "speakerName": "凝光",
            "text": "你们若是想问怎么赚钱，我自会按照约定回答。但对现在的你们来说，未必有效。",
            "nextDialogs": [
              "110150217"
            ]
          },
          "110150217": {
            "id": "110150217",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "哇——明明我还什么都没有问呢！",
            "nextDialogs": [
              "110150218"
            ]
          },
          "110150218": {
            "id": "110150218",
            "speakerId": 1005,
            "speakerName": "凝光",
            "text": "心思都写在脸上了，一看便知。当然，你们帮我重建群玉阁，恩情重大，我绝不会亏待你们。",
            "nextDialogs": [
              "110150219"
            ]
          },
          "110150219": {
            "id": "110150219",
            "speakerId": 1005,
            "speakerName": "凝光",
            "text": "我可以许诺，若有一天你们急需接济，可以来我这里寻个差使。至于薪水待遇，我当然会按最高规格来给。",
            "nextDialogs": [
              "110150220"
            ]
          },
          "110150220": {
            "id": "110150220",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "太好啦！下次摩拉用完的时候，我们来找凝光小姐就行！",
            "nextDialogs": [
              "110150221"
            ]
          },
          "110150221": {
            "id": "110150221",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "那我们俩都没有问题了，申鹤有什么想问的吗？",
            "nextDialogs": [
              "110150222"
            ]
          },
          "110150222": {
            "id": "110150222",
            "speakerId": 1007,
            "speakerName": "申鹤",
            "text": "我？",
            "nextDialogs": [
              "110150223"
            ]
          },
          "110150223": {
            "id": "110150223",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "是呀！因为材料是大家一起找齐的呢！",
            "nextDialogs": [
              "110150224"
            ]
          },
          "110150224": {
            "id": "110150224",
            "speakerId": 1007,
            "speakerName": "申鹤",
            "text": "多谢…但我实在没有什么问题。",
            "nextDialogs": [
              "110150225"
            ]
          },
          "110150225": {
            "id": "110150225",
            "speakerId": 1005,
            "speakerName": "凝光",
            "text": "是吗？那这个千载难逢的提问机会，怕是要浪费了。",
            "nextDialogs": [
              "110150226"
            ]
          },
          "110150226": {
            "id": "110150226",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "怎么可以这样，不可以浪费！唔，让我们再想想…",
            "nextDialogs": [
              "110150227"
            ]
          },
          "110150227": {
            "id": "110150227",
            "speakerId": 1007,
            "speakerName": "申鹤",
            "text": "…凝光小姐，你觉得我能融入璃月港吗？",
            "nextDialogs": [
              "110150228"
            ]
          },
          "110150228": {
            "id": "110150228",
            "speakerId": 1005,
            "speakerName": "凝光",
            "text": "这倒是一个有趣的问题。",
            "nextDialogs": [
              "110150229"
            ]
          },
          "110150229": {
            "id": "110150229",
            "speakerId": 1005,
            "speakerName": "凝光",
            "text": "璃月港是一座包容的城市，只要你遵守这里的规章制度，它就不会拒绝你。",
            "nextDialogs": [
              "110150230"
            ]
          },
          "110150230": {
            "id": "110150230",
            "speakerId": 1005,
            "speakerName": "凝光",
            "text": "所以，重要的是，你能否对璃月港产生「归属感」。",
            "nextDialogs": [
              "110150231"
            ]
          },
          "110150231": {
            "id": "110150231",
            "speakerId": 1007,
            "speakerName": "申鹤",
            "text": "归属感？",
            "nextDialogs": [
              "110150232"
            ]
          },
          "110150232": {
            "id": "110150232",
            "speakerId": 1005,
            "speakerName": "凝光",
            "text": "是啊。喜欢一个地方，融入一个地方…总是要有理由的。",
            "nextDialogs": [
              "110150233"
            ]
          },
          "110150233": {
            "id": "110150233",
            "speakerId": 1005,
            "speakerName": "凝光",
            "text": "或许是在这里遇见过什么人、经历过什么事，也或许只是享受璃月的氛围，习惯了这样去生活。",
            "nextDialogs": [
              "110150234"
            ]
          },
          "110150234": {
            "id": "110150234",
            "speakerId": 1005,
            "speakerName": "凝光",
            "text": "总之，每个人都需要一个留下来的理由，希望你也能早日找到。",
            "nextDialogs": [
              "110150235"
            ]
          },
          "110150235": {
            "id": "110150235",
            "speakerId": 1007,
            "speakerName": "申鹤",
            "text": "…我明白了。",
            "nextDialogs": [
              "110150236"
            ]
          },
          "110150236": {
            "id": "110150236",
            "speakerId": 1008,
            "speakerName": "北斗",
            "text": "哟，几位正聊着呢？刚刚去了趟船队，来晚了。",
            "nextDialogs": [
              "110150237"
            ]
          },
          "110150237": {
            "id": "110150237",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "快来快来，正好轮到北斗啦！北斗有什么想问的问题吗？",
            "nextDialogs": [
              "110150238"
            ]
          },
          "110150238": {
            "id": "110150238",
            "speakerId": 1008,
            "speakerName": "北斗",
            "text": "我？我没什么想问的。本来就是被她强拉来帮忙，顺便参赛而已。",
            "nextDialogs": [
              "110150239"
            ]
          },
          "110150239": {
            "id": "110150239",
            "speakerId": 1008,
            "speakerName": "北斗",
            "text": "凝光，上次跟你说的事，你可别忘了。",
            "nextDialogs": [
              "110150240"
            ]
          },
          "110150240": {
            "id": "110150240",
            "speakerId": 1008,
            "speakerName": "北斗",
            "text": "那东西不好对付，光靠我的船队，很难摆平。",
            "nextDialogs": [
              "110150241"
            ]
          },
          "110150241": {
            "id": "110150241",
            "speakerId": 1005,
            "speakerName": "凝光",
            "text": "放心吧，我准备好了。伤药准备妥当，千岩军也提前赶过去埋伏了。",
            "nextDialogs": [
              "110150242"
            ]
          },
          "110150242": {
            "id": "110150242",
            "speakerId": 1008,
            "speakerName": "北斗",
            "text": "那就好。你自己当心点，不要掉以轻心。",
            "nextDialogs": [
              "110150243"
            ]
          },
          "110150243": {
            "id": "110150243",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "北斗，凝光小姐，你们在聊什么呀？",
            "nextDialogs": [
              "110150244"
            ]
          },
          "110150244": {
            "id": "110150244",
            "speakerId": 1005,
            "speakerName": "凝光",
            "text": "等群玉阁升空，你们自会明白。但…不是什么愉快的事，不知道或许更好。",
            "nextDialogs": [
              "110150245"
            ]
          },
          "110150245": {
            "id": "110150245",
            "speakerId": 1005,
            "speakerName": "凝光",
            "text": "第一次登上群玉阁的时候，我站在高台边缘，从空中遥望着璃月港。",
            "nextDialogs": [
              "110150246"
            ]
          },
          "110150246": {
            "id": "110150246",
            "speakerId": 1005,
            "speakerName": "凝光",
            "text": "那时我想，终有一日我会让群玉阁的影子覆盖七国。",
            "nextDialogs": [
              "110150247"
            ]
          },
          "110150247": {
            "id": "110150247",
            "speakerId": 1005,
            "speakerName": "凝光",
            "text": "时至今日，我的愿望依然未变。不过，这次重修群玉阁，却不只是为了我自己。",
            "nextDialogs": [
              "110150248"
            ]
          },
          "110150248": {
            "id": "110150248",
            "speakerId": 1005,
            "speakerName": "凝光",
            "text": "我希望，无论何时群玉阁都能一直浮在璃月港上空，见证人间的繁荣安宁。",
            "nextDialogs": [
              "110150249"
            ]
          },
          "110150249": {
            "id": "110150249",
            "speakerId": 1005,
            "speakerName": "凝光",
            "text": "…也希望各位，与我一同见证。",
            "nextDialogs": [
              "110150250"
            ]
          },
          "110150250": {
            "id": "110150250",
            "speakerId": 1005,
            "speakerName": "凝光",
            "text": "升空仪式，开始！"
          }
        }
      }
    },

    {
      "subId": "1101599",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "110159901"
        ],
        "dialogs": {
          "110159901": {
            "id": "110159901",
            "speakerId": 1007,
            "speakerName": "申鹤",
            "text": "你们怎么也来了？",
            "nextDialogs": [
              "110159902"
            ]
          },
          "110159902": {
            "id": "110159902",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "我们也不能让申鹤一个人冒险！",
            "nextDialogs": [
              "110159903"
            ]
          },
          "110159903": {
            "id": "110159903",
            "speakerId": 1007,
            "speakerName": "申鹤",
            "text": "冒险谈不上。璃月港的人早有准备，眼下她已经受了重伤，只是靠执念支撑着而已。",
            "nextDialogs": [
              "110159904"
            ]
          },
          "110159904": {
            "id": "110159904",
            "speakerId": 1007,
            "speakerName": "申鹤",
            "text": "虽然我的体力也所剩无几，不过像这样以命相搏…我大概比她要擅长。",
            "nextDialogs": [
              "110159905"
            ]
          },
          "110159905": {
            "id": "110159905",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "我们也来帮忙！",
            "nextDialogs": [
              "110159906"
            ]
          },
          "110159906": {
            "id": "110159906",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "她逃走了！我们要追过去吗？\\n",
            "nextDialogs": [
              "110159907"
            ]
          },
          "110159907": {
            "id": "110159907",
            "speakerId": 1007,
            "speakerName": "申鹤",
            "text": "此处并不稳固，继续追下去风险太大。\\n",
            "nextDialogs": [
              "110159908"
            ]
          },
          "110159908": {
            "id": "110159908",
            "speakerId": 1007,
            "speakerName": "申鹤",
            "text": "一旦坍塌，后果不堪设想…还是先回去吧。"
          }
        }
      }
    }

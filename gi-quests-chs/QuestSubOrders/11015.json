    {
      "subId": "1101508",
      "subQuestName": "与凝光对话",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "110150801"
        ],
        "dialogs": {
          "110150801": {
            "id": "110150801",
            "speakerId": 1009,
            "speakerName": "刻晴",
            "text": "千岩军的损伤在预想范围之内。",
            "nextDialogs": [
              "110150802"
            ]
          },
          "110150802": {
            "id": "110150802",
            "speakerId": 1009,
            "speakerName": "刻晴",
            "text": "不过回看整个计划，还是有些瑕疵。",
            "nextDialogs": [
              "110150803"
            ]
          },
          "110150803": {
            "id": "110150803",
            "speakerId": 1009,
            "speakerName": "刻晴",
            "text": "如果时间更充裕一些，就能在这里提前布置结界，防备海浪冲击。",
            "nextDialogs": [
              "110150804"
            ]
          },
          "110150804": {
            "id": "110150804",
            "speakerId": 1009,
            "speakerName": "刻晴",
            "text": "这些都是教训，下次不可再犯…这次幸好有你们帮忙，多谢了。"
          }
        }
      }
    },
    {
      "subId": "1101503",
      "subQuestName": "与凝光对话",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "110150301"
        ],
        "dialogs": {
          "110150301": {
            "id": "110150301",
            "speakerId": 1007,
            "speakerName": "申鹤",
            "text": "……",
            "nextDialogs": [
              "110150304"
            ]
          },
          "110150304": {
            "id": "110150304",
            "speakerId": 1007,
            "speakerName": "申鹤",
            "text": "只是力量有些消耗过度，没关系的。",
            "nextDialogs": [
              "110150305"
            ]
          },
          "110150305": {
            "id": "110150305",
            "speakerId": 1007,
            "speakerName": "申鹤",
            "text": "本来想一个人把那家伙处理掉，没想到你还是追下来了。",
            "nextDialogs": [
              "110150306"
            ]
          },
          "110150306": {
            "id": "110150306",
            "speakerId": 1007,
            "speakerName": "申鹤",
            "text": "放心，她暂时不敢来了。受了那么严重的伤，应该已经遁逃到别处了。",
            "nextDialogs": [
              "110150307"
            ]
          },
          "110150307": {
            "id": "110150307",
            "speakerId": 1005,
            "speakerName": "凝光",
            "text": "方才在水下，情况如何？",
            "nextDialogs": [
              "110150308"
            ]
          },
          "110150308": {
            "id": "110150308",
            "speakerId": 1007,
            "speakerName": "申鹤",
            "text": "解决掉了。她在潜入水下前就受了伤，我们没费太大力气。",
            "nextDialogs": [
              "110150309"
            ]
          },
          "110150309": {
            "id": "110150309",
            "speakerId": 1005,
            "speakerName": "凝光",
            "text": "那就好。无论如何，总算是平安度过本次危机了。之后请到群玉阁来，我会好好招待你们。",
            "nextDialogs": [
              "110150310"
            ]
          },
          "110150310": {
            "id": "110150310",
            "speakerId": 1010,
            "speakerName": "正茂",
            "text": "凝光大人，船队传来消息，那只水怪已经离开了孤云阁附近，周围海域恢复正常！",
            "nextDialogs": [
              "110150311"
            ]
          },
          "110150311": {
            "id": "110150311",
            "speakerId": 1005,
            "speakerName": "凝光",
            "text": "辛苦你们了，千岩军情况如何？",
            "nextDialogs": [
              "110150312"
            ]
          },
          "110150312": {
            "id": "110150312",
            "speakerId": 1010,
            "speakerName": "正茂",
            "text": "多亏了凝光大人准备的伤药，以及刻晴大人的临阵指挥，我们尽可能将损伤控制到了最低。",
            "nextDialogs": [
              "110150313"
            ]
          },
          "110150313": {
            "id": "110150313",
            "speakerId": 1010,
            "speakerName": "正茂",
            "text": "当然，也要感谢这位小姐出手相助。",
            "nextDialogs": [
              "110150314"
            ]
          },
          "110150314": {
            "id": "110150314",
            "speakerId": 1010,
            "speakerName": "正茂",
            "text": "我替千岩军所有的兄弟们，向你表示感谢。",
            "nextDialogs": [
              "110150315"
            ]
          },
          "110150315": {
            "id": "110150315",
            "speakerId": 1007,
            "speakerName": "申鹤",
            "text": "我…"
          }
        }
      }
    },
    {
      "subId": "1101504",
      "subQuestName": "前往群玉阁参加庆功宴",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "110150401"
        ],
        "dialogs": {
          "110150401": {
            "id": "110150401",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "哇哦…大家都落座了呢！",
            "nextDialogs": [
              "110150402"
            ]
          },
          "110150402": {
            "id": "110150402",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "我还是第一次在群玉阁上参加凝光小姐的宴会呢！感觉有好多好吃的！",
            "nextDialogs": [
              "110150403"
            ]
          },
          "110150403": {
            "id": "110150403",
            "speakerId": 1005,
            "speakerName": "凝光",
            "text": "诸位都是我凝光的贵客。今日来此，可要尽兴而归。",
            "nextDialogs": [
              "110150404"
            ]
          },
          "110150404": {
            "id": "110150404",
            "speakerId": 1005,
            "speakerName": "凝光",
            "text": "不能喝酒的客人，请以饮品代替。美酒宜人，宜人的却不只是美酒。相信群玉阁上的美景也能醉人心脾。",
            "nextDialogs": [
              "110150405"
            ]
          },
          "110150405": {
            "id": "110150405",
            "speakerId": 1011,
            "speakerName": "永业",
            "text": "听说了吗？今天好像有云先生登台。",
            "nextDialogs": [
              "110150406"
            ]
          },
          "110150406": {
            "id": "110150406",
            "speakerId": 1012,
            "speakerName": "朱陶",
            "text": "呵，实不相瞒，我就是冲着这个来的！云先生的戏，我可是一场不落。",
            "nextDialogs": [
              "110150407"
            ]
          },
          "110150407": {
            "id": "110150407",
            "speakerId": 1012,
            "speakerName": "朱陶",
            "text": "这次据说唱的是《神女劈观》，云先生的父亲写的戏。我期待得两三个晚上没睡好了。",
            "nextDialogs": [
              "110150408"
            ]
          },
          "110150408": {
            "id": "110150408",
            "speakerId": 1013,
            "speakerName": "诗羽",
            "text": "哎，你们看，云先生上台了！",
            "nextDialogs": [
              "110150409"
            ]
          },
          "110150409": {
            "id": "110150409",
            "speakerId": 1006,
            "speakerName": "云堇",
            "text": "怎么样，我唱得还不错吧？",
            "nextDialogs": [
              "110150410"
            ]
          },
          "110150410": {
            "id": "110150410",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "太好听了！有机会的话，派蒙也想学！",
            "nextDialogs": [
              "110150411"
            ]
          },
          "110150411": {
            "id": "110150411",
            "speakerId": 1007,
            "speakerName": "申鹤",
            "text": "很好听。而且…谢谢你。",
            "nextDialogs": [
              "110150412"
            ]
          },
          "110150412": {
            "id": "110150412",
            "speakerId": 1006,
            "speakerName": "云堇",
            "text": "不客气，多亏有你，《神女劈观》才能变得更加完整。",
            "nextDialogs": [
              "110150413"
            ]
          },
          "110150413": {
            "id": "110150413",
            "speakerId": 1006,
            "speakerName": "云堇",
            "text": "戏会落幕，人生却不会。相信今后，你一定可以顺利融入璃月港。",
            "nextDialogs": [
              "110150414"
            ]
          },
          "110150414": {
            "id": "110150414",
            "speakerId": 1007,
            "speakerName": "申鹤",
            "text": "谢谢。我想，我已经找到改变的「契机」了。",
            "nextDialogs": [
              "110150415"
            ]
          },
          "110150415": {
            "id": "110150415",
            "speakerId": 1012,
            "speakerName": "朱陶",
            "text": "云先生…嗝…原来你在这里。",
            "nextDialogs": [
              "110150416"
            ]
          },
          "110150416": {
            "id": "110150416",
            "speakerId": 1012,
            "speakerName": "朱陶",
            "text": "嗯？这位白、白发姑娘看着好特别，简直就像是仙人一样。",
            "nextDialogs": [
              "110150417"
            ]
          },
          "110150417": {
            "id": "110150417",
            "speakerId": 1012,
            "speakerName": "朱陶",
            "text": "#莫非你就是那位神女？还有这位，这位不是大名鼎鼎的{NICKNAME}吗？嘿嘿嘿，看来这次我真是不虚此行…",
            "nextDialogs": [
              "110150418"
            ]
          },
          "110150418": {
            "id": "110150418",
            "speakerId": 1012,
            "speakerName": "朱陶",
            "text": "不介意加张椅子吧，来，咱们一起聊聊天…",
            "nextDialogs": [
              "110150419"
            ]
          },
          "110150419": {
            "id": "110150419",
            "speakerId": 1007,
            "speakerName": "申鹤",
            "text": "……",
            "nextDialogs": [
              "110150420"
            ]
          },
          "110150420": {
            "id": "110150420",
            "speakerId": 1007,
            "speakerName": "申鹤",
            "text": "如果你不想用鼻子或者眼睛把剩下的酒喝完，就快点离开比较好。",
            "nextDialogs": [
              "110150421"
            ]
          },
          "110150421": {
            "id": "110150421",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "这熟悉的感觉…好像又回到第一次和申鹤见面的时候了…",
            "nextDialogs": [
              "110150422"
            ]
          },
          "110150422": {
            "id": "110150422",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "看来还有很长的路要走呢。",
            "nextDialogs": [
              "110150423"
            ]
          },
          "110150423": {
            "id": "110150423",
            "speakerId": 1012,
            "speakerName": "朱陶",
            "text": "噫！你想干什么！",
            "nextDialogs": [
              "110150424"
            ]
          },
          "110150424": {
            "id": "110150424",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "冷静，申鹤。冷静呀——"
          }
        }
      }
    },

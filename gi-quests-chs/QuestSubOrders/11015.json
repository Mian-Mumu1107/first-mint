        ],
        "dialogs": {
          "110151701": {
            "id": "110151701",
            "speakerId": 1013,
            "speakerName": "诗羽",
            "text": "什么时候我也能修一座群玉阁…唉，眼下我的财力还远远不够。",
            "nextDialogs": [
              "110151702"
            ]
          },
          "110151702": {
            "id": "110151702",
            "speakerId": 1013,
            "speakerName": "诗羽",
            "text": "不过怀着这样的梦想去努力，或许有一天…"
          }
        }

  "subQuests": [
    {
      "subId": "1480101",
      "subQuestName": "(test)隐藏$HIDDEN",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "698450101"
        ],
        "dialogs": {
          "698450101": {
            "id": "698450101",
            "speakerId": 1000,
            "speakerName": "那维莱特",
            "text": "……",
            "nextDialogs": [
              "698450102"
            ]
          },
          "698450102": {
            "id": "698450102",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "（那维莱特？竟然一个人在这里淋雨…难道是心情不好？）",
            "nextDialogs": [
              "698450103"
            ]
          },
          "698450103": {
            "id": "698450103",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "（相逢是缘，去打个招呼吧。）",
            "nextDialogs": [
              "698450104"
            ]
          },
          "698450104": {
            "id": "698450104",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "你好。",
            "nextDialogs": [
              "698450105"
            ]
          },
          "698450105": {
            "id": "698450105",
            "speakerId": 1000,
            "speakerName": "那维莱特",
            "text": "#是你啊，{NICKNAME}，你也好。",
            "nextDialogs": [
              "698450106"
            ]
          },
          "698450106": {
            "id": "698450106",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "最近还好吗？",
            "nextDialogs": [
              "698450107"
            ]
          },
          "698450107": {
            "id": "698450107",
            "speakerId": 1000,
            "speakerName": "那维莱特",
            "text": "一切如常，多谢关心。",
            "nextDialogs": [
              "698450108"
            ]
          },
          "698450108": {
            "id": "698450108",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "心情不错？",
            "nextDialogs": [
              "698450109"
            ]
          },
          "698450109": {
            "id": "698450109",
            "speakerId": 1000,
            "speakerName": "那维莱特",
            "text": "嗯，你看出来了？",
            "nextDialogs": [
              "698450110"
            ]
          },
          "698450110": {
            "id": "698450110",
            "speakerId": 1000,
            "speakerName": "那维莱特",
            "text": "晨报的天气预测栏目说今日此时此地会有降雨。",
            "nextDialogs": [
              "698450111"
            ]
          },
          "698450111": {
            "id": "698450111",
            "speakerId": 1000,
            "speakerName": "那维莱特",
            "text": "以我的经验来看，这类预测的准确性总是有待考证…",
            "nextDialogs": [
              "698450112"
            ]
          },
          "698450112": {
            "id": "698450112",
            "speakerId": 1000,
            "speakerName": "那维莱特",
            "text": "但今天很幸运，大雨如期而至了。",
            "nextDialogs": [
              "698450113"
            ]
          },
          "698450113": {
            "id": "698450113",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "太好了，为你高兴。",
            "nextDialogs": [
              "698450114"
            ]
          },
          "698450114": {
            "id": "698450114",
            "speakerId": 1000,
            "speakerName": "那维莱特",
            "text": "谢谢。",
            "nextDialogs": [
              "698450115"
            ]
          },
          "698450115": {
            "id": "698450115",
            "speakerId": 1000,
            "speakerName": "那维莱特",
            "text": "不过我也知道，淋雨只是我的私人爱好，一般人并没有这样的习惯。",
            "nextDialogs": [
              "698450116"
            ]
          },
          "698450116": {
            "id": "698450116",
            "speakerId": 1000,
            "speakerName": "那维莱特",
            "text": "雨势如此之大，你站在这里陪我，没问题吗？",
            "nextDialogs": [
              "698450119"
            ]
          },
          "698450119": {
            "id": "698450119",
            "speakerId": 1000,
            "speakerName": "那维莱特",
            "text": "唔…原来如此…",
            "nextDialogs": [
              "698450120"
            ]
          },
          "698450120": {
            "id": "698450120",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "怎么了？",
            "nextDialogs": [
              "698450121"
            ]
          },
          "698450121": {
            "id": "698450121",
            "speakerId": 1000,
            "speakerName": "那维莱特",
            "text": "是这样…之前我曾听到美露莘们在聊天，抱怨天气经常不配合自己的准备。",
            "nextDialogs": [
              "698450122"
            ]
          },
          "698450122": {
            "id": "698450122",
            "speakerId": 1000,
            "speakerName": "那维莱特",
            "text": "比如为了可能出现的雨天带伞出门的时候反而晴空万里，然而一旦抱着侥幸心理没有带伞，当天反而会倾盆大雨。",
            "nextDialogs": [
              "698450123"
            ]
          },
          "698450123": {
            "id": "698450123",
            "speakerId": 1000,
            "speakerName": "那维莱特",
            "text": "当然，我知道这之间并没有什么必然联系，毕竟我也亲自尝试过…",
            "nextDialogs": [
              "698450124"
            ]
          },
          "698450124": {
            "id": "698450124",
            "speakerId": 1000,
            "speakerName": "那维莱特",
            "text": "嗯…简而言之，收效甚微。",
            "nextDialogs": [
              "698450125"
            ]
          },
          "698450125": {
            "id": "698450125",
            "speakerId": 1000,
            "speakerName": "那维莱特",
            "text": "不过既然你此时提及，我难免会觉得，今日能遇上这场大雨，没准是托了你的福。"
          }
        }
      }
    }
  ]
}
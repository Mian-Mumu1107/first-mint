    },
    {
      "subId": "7408106",
      "subQuestName": "(test)（隐藏）与派蒙对话",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "740810601"
        ],
        "dialogs": {
          "740810601": {
            "id": "740810601",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "光束传到对面去了，那边好像还有一些机关？中间那个大装置倒是没什么反应呢…",
            "nextDialogs": [
              "740810602"
            ]
          },
          "740810602": {
            "id": "740810602",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "唔…按照以前冒险的经验，只要我们把看起来差不多的机关都启动，应该就会发生什么关键的变化！"
          }
        }
      }

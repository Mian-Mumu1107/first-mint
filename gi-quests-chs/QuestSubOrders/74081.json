    {
      "subId": "7408124",
      "subQuestName": "与瑟维妮对话",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "740812401"
        ],
        "dialogs": {
          "740812401": {
            "id": "740812401",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "要回收的就是这些打孔纸带对吧？",
            "nextDialogs": [
              "740812402"
            ]
          },
          "740812402": {
            "id": "740812402",
            "speakerId": 1001,
            "speakerName": "Black Screen",
            "text": "向瑟维妮出示了回收的打孔纸带…",
            "nextDialogs": [
              "740812403"
            ]
          },
          "740812403": {
            "id": "740812403",
            "speakerId": 1005,
            "speakerName": "瑟维妮",
            "text": "没错，就是这些。你们办事可真干练，一点也不拖泥带水。",
            "nextDialogs": [
              "740812404"
            ]
          },
          "740812404": {
            "id": "740812404",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "这么简单的工作，当然是咻咻地就完成啦。",
            "nextDialogs": [
              "740812405"
            ]
          },
          "740812405": {
            "id": "740812405",
            "speakerId": 1005,
            "speakerName": "瑟维妮",
            "text": "那也很了不起了。毫不夸张地说，有些同事真的会花费整整一天的时间，就为了找到一份材料…",
            "nextDialogs": [
              "740812406"
            ]
          },
          "740812406": {
            "id": "740812406",
            "speakerId": 1005,
            "speakerName": "瑟维妮",
            "text": "不说这些了。这些打孔纸带就麻烦两位送回给希塞蕾前辈了。",
            "nextDialogs": [
              "740812407"
            ]
          },
          "740812407": {
            "id": "740812407",
            "speakerId": 1005,
            "speakerName": "瑟维妮",
            "text": "告诉她我暂时还不会回去。哦，还有，请她联系梅雅德前辈尽快回收这里的试验机。",
            "nextDialogs": [
              "740812408"
            ]
          },
          "740812408": {
            "id": "740812408",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "#好哦。那{NICKNAME}，我们原路返回？",
            "nextDialogs": [
              "740812409"
            ]
          },
          "740812409": {
            "id": "740812409",
            "speakerId": 1005,
            "speakerName": "瑟维妮",
            "text": "啊，那倒不必了。",
            "nextDialogs": [
              "740812410"
            ]
          },
          "740812410": {
            "id": "740812410",
            "speakerId": 1005,
            "speakerName": "瑟维妮",
            "text": "两位应该能够潜水吧？其实这边有条水路应该可以出去，之前为了防止踩空暂时封上了，我来帮你们打开通路。",
            "nextDialogs": [
              "740812411"
            ]
          },
          "740812411": {
            "id": "740812411",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "#那太好了！{NICKNAME}，我们就从水路回去吧！",
            "nextDialogs": [
              "740812412"
            ]
          },
          "740812412": {
            "id": "740812412",
            "speakerId": 1005,
            "speakerName": "瑟维妮",
            "text": "打开通路的终端在里间，我去就好了。你们自行离开应该没问题吧？不会迷路吧？",
            "nextDialogs": [
              "740812413"
            ]
          },
          "740812413": {
            "id": "740812413",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "#那你就太小瞧我们了！我可是提瓦特最好的向导，有我在，{NICKNAME}怎么会迷路呢？",
            "nextDialogs": [
              "740812414"
            ]
          },
          "740812414": {
            "id": "740812414",
            "speakerId": 1005,
            "speakerName": "瑟维妮",
            "text": "真可靠呀。那捎信和打孔纸带的事就拜托两位了，我就不远送了。"
          }
        }
      }

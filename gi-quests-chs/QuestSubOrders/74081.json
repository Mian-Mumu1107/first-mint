    {
      "subId": "7408129",
      "subQuestName": "与研究员对话",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "740812901"
        ],
        "dialogs": {
          "740812901": {
            "id": "740812901",
            "speakerId": 1003,
            "speakerName": "？？？",
            "text": "又是震动又是打斗声，还以为是伊斯丁豪斯先生回来了呢，原来是有人误启动了外面的装置…",
            "nextDialogs": [
              "740812902"
            ]
          },
          "740812902": {
            "id": "740812902",
            "speakerId": 1003,
            "speakerName": "？？？",
            "text": "哎呀哎呀，梅雅德前辈的试验机…怎么会搞成这副模样。"
          }
        }
      }
    },
    {
      "subId": "7408117",
      "subQuestName": "与研究员对话",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "740811701"
        ],
        "dialogs": {
          "740811701": {
            "id": "740811701",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "呃…我们、我们该不会闯大祸了吧？",
            "nextDialogs": [
              "740811702"
            ]
          },
          "740811702": {
            "id": "740811702",
            "speakerId": 1003,
            "speakerName": "？？？",
            "text": "真奇怪，刚才感到一阵晃动…",
            "nextDialogs": [
              "740811705"
            ]
          },
          "740811705": {
            "id": "740811705",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "唔，可能是因为我们刚才动了上层的装置…",
            "nextDialogs": [
              "740811706"
            ]
          },
          "740811706": {
            "id": "740811706",
            "speakerId": 1003,
            "speakerName": "？？？",
            "text": "这里的门原本是锁上的吧？还特意放了一些发条机关在门口看守…"
          }
        }
      }
    },

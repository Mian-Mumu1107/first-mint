    {
      "subId": "7408103",
      "subQuestName": "(test)（对话表现）进入后山洞天$HIDDEN",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "740810301"
        ],
        "dialogs": {
          "740810301": {
            "id": "740810301",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "哇…没想到水下居然有这么大的空间，还有奇怪的装置！",
            "nextDialogs": [

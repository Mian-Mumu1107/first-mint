        ],
        "dialogs": {
          "740811101": {
            "id": "740811101",
            "speakerId": 1005,
            "speakerName": "瑟维妮",
            "text": "打孔纸带应该就在书架上，你们找找看吧。其他的研究资料就…",
            "nextDialogs": [
              "740811102"
            ]
          },
          "740811102": {
            "id": "740811102",
            "speakerId": 1005,
            "speakerName": "瑟维妮",
            "text": "看看应该也没问题吧？反正没什么机密信息…"

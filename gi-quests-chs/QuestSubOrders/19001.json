    {
      "subId": "1900101",
      "subQuestName": "与维多利亚修女对话",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "190010101"
        ],
        "dialogs": {
          "190010101": {
            "id": "190010101",
            "speakerId": 1471,
            "speakerName": "维多利亚",
            "text": "芭芭拉小姐…不会出了什么事吧…",
            "nextDialogs": [
              "190010102"
            ]
          },
          "190010102": {
            "id": "190010102",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "芭芭拉怎么了？",
            "nextDialogs": [
              "190010103"
            ]
          },
          "190010103": {
            "id": "190010103",
            "speakerId": 1471,
            "speakerName": "维多利亚",
            "text": "芭芭拉小姐说自己要外出采药，但是到现在还没回来。",
            "nextDialogs": [
              "190010104"
            ]
          },
          "190010104": {
            "id": "190010104",
            "speakerId": 1471,
            "speakerName": "维多利亚",
            "text": "难道要向西风骑士团报告吗…",
            "nextDialogs": [
              "190010105"
            ]
          },
          "190010105": {
            "id": "190010105",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "我去找芭芭拉。",
            "nextDialogs": [
              "190010106"
            ]
          },
          "190010106": {
            "id": "190010106",
            "speakerId": 1471,
            "speakerName": "维多利亚",
            "text": "你？哦…你这位「荣誉骑士」确实很合适…",
            "nextDialogs": [
              "190010107"
            ]
          },
          "190010107": {
            "id": "190010107",
            "speakerId": 1471,
            "speakerName": "维多利亚",
            "text": "这样的话，倒也免了向骑士团报告后的一堆麻烦事…",
            "nextDialogs": [
              "190010108"
            ]
          },
          "190010108": {
            "id": "190010108",
            "speakerId": 1471,
            "speakerName": "维多利亚",
            "text": "那就拜托你了，芭芭拉小姐在离开之前说，她准备去奔狼领附近采药。",
            "nextDialogs": [
              "190010109"
            ]
          },
          "190010109": {
            "id": "190010109",
            "speakerId": 1471,
            "speakerName": "维多利亚",
            "text": "你可以去那边找找她。"
          }
        }
      }
    },

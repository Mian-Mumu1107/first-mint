    {
      "subId": "7504808",
      "subQuestName": "与神秘的冒险家对话",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "750480801"
        ],
        "dialogs": {
          "750480801": {
            "id": "750480801",
            "speakerId": 1004,
            "speakerName": "？？？",
            "text": "喂，前面的家伙！",
            "nextDialogs": [
              "750480802"
            ]
          },
          "750480802": {
            "id": "750480802",
            "speakerId": 1004,
            "speakerName": "？？？",
            "text": "嗯嗯，没错，说的就是你们三位，转过身来啦。",
            "nextDialogs": [
              "750480803"
            ]
          },
          "750480803": {
            "id": "750480803",
            "speakerId": 1004,
            "speakerName": "？？？",
            "text": "哦？看起来听得懂人话嘛！",
            "nextDialogs": [
              "750480804"
            ]
          },
          "750480804": {
            "id": "750480804",
            "speakerId": 1004,
            "speakerName": "？？？",
            "text": "真是吓了我一跳，我还以为是什么假扮成人类模样的深渊魔物。要是你们不回话的话，我可就打算先下手为强了。",
            "nextDialogs": [
              "750480806",
              "750480808"
            ]
          },
          "750480806": {
            "id": "750480806",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "对啊，我们也没想到这里会有其他人吧！",
            "nextDialogs": [
              "750480810"
            ]
          },
          "750480810": {
            "id": "750480810",
            "speakerId": 1003,
            "speakerName": "玻娜",
            "text": "嘿，不管怎么说，能在这里相遇也是一种机缘呢。我是来自「花羽会」的王牌冒险家，叫我玻娜就好。"
          },
          "750480808": {
            "id": "750480808",
            "speakerId": 1004,
            "speakerName": "？？？",
            "text": "哦？所以才这么自信地把背后暴露给我吗？",
            "nextDialogs": [
              "750480809"
            ]
          },
          "750480809": {
            "id": "750480809",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "我们也没想到这里会有其他人吧！"
          }
        }
      }
    },

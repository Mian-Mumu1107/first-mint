    },
    {
      "subId": "7504810",
      "subQuestName": "探索流灰之街",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "750481001"
        ],
        "dialogs": {
          "750481001": {
            "id": "750481001",
            "speakerId": 1003,
            "speakerName": "玻娜",
            "text": "哼，差不多是时候了呢，如果能在这里将它击落的话…",
            "nextDialogs": [
              "750481002"
            ]
          },
          "750481002": {
            "id": "750481002",
            "speakerId": 1005,
            "speakerName": "「绿松石」",
            "text": "叽！咕叽！",
            "nextDialogs": [
              "750481003"
            ]
          },
          "750481003": {
            "id": "750481003",
            "speakerId": 1003,
            "speakerName": "玻娜",
            "text": "#嗯嗯，只要使出那个就可以了。{NICKNAME}，试着把手放到绿宝身上吧…",
            "nextDialogs": [
              "750481004"
            ]
          },
          "750481004": {
            "id": "750481004",
            "speakerId": 1003,
            "speakerName": "玻娜",
            "text": "「超能特攻光线」，发射！"
          }
        }
      }
    },
    {
      "subId": "7504811",

        "dialogs": {}
      }
    },
    {
      "subId": "7504816",
      "subQuestName": "取回火磷石",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "750481601"
        ],
        "dialogs": {
          "750481601": {
            "id": "750481601",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "可恶，结果这次还是让它跑掉了！",
            "nextDialogs": [
              "750481602"
            ]
          },
          "750481602": {
            "id": "750481602",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "刚才明明差一点就能抓住它了吧。也不知道怎么回事，它像是突然又恢复了力量一样…",
            "nextDialogs": [
              "750481604"
            ]
          },
          "750481604": {
            "id": "750481604",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "嗯？难不成你能听懂那条坏龙说话？",
            "nextDialogs": [
              "750481605"
            ]
          },
          "750481605": {
            "id": "750481605",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "是金色的花纹上说的啦。",
            "nextDialogs": [
              "750481607"
            ]
          },
          "750481607": {
            "id": "750481607",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "欸？你又看到那个金色花纹了吗，难道又是那个什么「盗火贤者」留下来的启示？",
            "nextDialogs": [
              "750481608"
            ]
          },
          "750481608": {
            "id": "750481608",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "该不会来到这座古城寻找宝物，也是他给我们的什么试炼？",
            "nextDialogs": [
              "750481609"
            ]
          },
          "750481609": {
            "id": "750481609",
            "speakerId": 1003,
            "speakerName": "玻娜",
            "text": "嗯？你们在说什么呢？",
            "nextDialogs": [
              "750481610"
            ]
          },
          "750481610": {
            "id": "750481610",
            "speakerId": 1003,
            "speakerName": "玻娜",
            "text": "啊，累累累…真是条难缠的龙，本来还以为能在这里结果了它呢，没想到它的命还挺大。",
            "nextDialogs": [
              "750481611"
            ]
          },
          "750481611": {
            "id": "750481611",
            "speakerId": 1003,
            "speakerName": "玻娜",
            "text": "不过这下总算能拿回我的火磷石了，哦，看起来就在这里嘛！",
            "nextDialogs": [
              "750481612"
            ]
          },
          "750481612": {
            "id": "750481612",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "话说回来，我们接下来要怎么办呢？虽说我们是为了寻找那个冒险家说的「回还之玉」才过来这里的…",
            "nextDialogs": [
              "750481613"
            ]
          },
          "750481613": {
            "id": "750481613",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "但是到现在我们都还不知道那个「回还之玉」到底是什么吧！",
            "nextDialogs": [
              "750481614"
            ]
          },
          "750481614": {
            "id": "750481614",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "玻娜一定知道些什么吧，该不会又是那种什么要找到三个火磷石才能打开的机关？",
            "nextDialogs": [
              "750481615"
            ]
          },
          "750481615": {
            "id": "750481615",
            "speakerId": 1003,
            "speakerName": "玻娜",
            "text": "要是有那么简单就好了…其实那个「回还之玉」根本不在这座城里，而是在天空之上。",
            "nextDialogs": [
              "750481616"
            ]
          },
          "750481616": {
            "id": "750481616",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "欸？但是我们在那座塔里捡到的笔记上明明是说…该不会那些冒险家都搞错了吧？",
            "nextDialogs": [
              "750481617"
            ]
          },
          "750481617": {
            "id": "750481617",
            "speakerId": 1003,
            "speakerName": "玻娜",
            "text": "捡到的笔记？因为这种理由就跑到了这座禁忌之城「奥奇卡纳塔」里来，该说不说，还真是艺高人胆大呢。",
            "nextDialogs": [
              "750481618"
            ]
          },
          "750481618": {
            "id": "750481618",
            "speakerId": 1003,
            "speakerName": "玻娜",
            "text": "既然你们连「回还之玉」的事情都不清楚，应该也没听说过「托纳{RUBY#[D]天蛇船}蒂乌」的故事吧？",
            "nextDialogs": [
              "750481619"
            ]
          },
          "750481619": {
            "id": "750481619",
            "speakerId": 1003,
            "speakerName": "玻娜",
            "text": "那是曾经统治奥奇卡纳塔的暴君，蛇王奥奇坎所建造的满载宝物的天船，是无数纳塔的冒险家所追逐的目标。",
            "nextDialogs": [
              "750481620"
            ]
          },
          "750481620": {
            "id": "750481620",
            "speakerId": 1003,
            "speakerName": "玻娜",
            "text": "这其中，也包括我的老爹，他曾经是「花羽会」最厉害的冒险家。",
            "nextDialogs": [
              "750481621"
            ]
          },
          "750481621": {
            "id": "750481621",
            "speakerId": 1003,
            "speakerName": "玻娜",
            "text": "但是除了作为冒险家的野心之外，天蛇船对他来说还有更重要的意义。",
            "nextDialogs": [
              "750481622"
            ]
          },
          "750481622": {
            "id": "750481622",
            "speakerId": 1003,
            "speakerName": "玻娜",
            "text": "数十年前，深渊灾厄曾一度摧毁我们的部族，盘踞在这座古城的邪龙，也是那个时候才出现的。",
            "nextDialogs": [
              "750481623"
            ]
          },
          "750481623": {
            "id": "750481623",
            "speakerId": 1003,
            "speakerName": "玻娜",
            "text": "而据说在「天蛇船」上无数的宝物中有一件「回还{RUBY#[D]奥梅忒托}之玉」，据说只要找到它便能镇压这座被深渊浸染的古城。",
            "nextDialogs": [
              "750481624"
            ]
          },
          "750481624": {
            "id": "750481624",
            "speakerId": 1003,
            "speakerName": "玻娜",
            "text": "那时大家刚刚目睹了深渊带来的噩梦，如果能够找到这件宝物，镇压这里的污秽的话，部族的大家也就不用再生活在恐惧中了。",
            "nextDialogs": [
              "750481625"
            ]
          },
          "750481625": {
            "id": "750481625",
            "speakerId": 1003,
            "speakerName": "玻娜",
            "text": "老爹就是为了这个才踏上旅途的…虽然，最后他也没能成功回来，只留下了这块在遗迹中寻到的火磷石…"
          }
        }
      }
    },

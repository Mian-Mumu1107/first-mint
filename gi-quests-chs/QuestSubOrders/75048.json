      }
    },
    {
      "subId": "7504812",
      "subQuestName": "寻找恶龙的踪迹",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "750481201"
        ],
        "dialogs": {
          "750481201": {
            "id": "750481201",
            "speakerId": 1003,
            "speakerName": "玻娜",
            "text": "漂亮啊！怎么样，很厉害吧，这个「超能特攻光线」！",
            "nextDialogs": [
              "750481202"
            ]
          },
          "750481202": {
            "id": "750481202",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "所以为什么要叫「超能特攻光线」啦？玻娜的取名品味也太怪了。",
            "nextDialogs": [
              "750481203"
            ]
          },
          "750481203": {
            "id": "750481203",
            "speakerId": 1003,
            "speakerName": "玻娜",
            "text": "派蒙不觉得很有气势吗？在战斗的时候一定要喊出帅气的招式名才好让大家传颂啊，这也是身为冒险家的经验哦。",
            "nextDialogs": [
              "750481204"
            ]
          },
          "750481204": {
            "id": "750481204",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "呃，招式名什么的先不提，这次也是多亏了绿宝才把那条坏龙打下来了呢。",
            "nextDialogs": [
              "750481205"
            ]
          },
          "750481205": {
            "id": "750481205",
            "speakerId": 1005,
            "speakerName": "「绿松石」",
            "text": "咕…",
            "nextDialogs": [
              "750481206"
            ]
          },
          "750481206": {
            "id": "750481206",
            "speakerId": 1002,
            "speakerName": "#{REALNAME[ID(2)|SHOWHOST(true)]}",
            "text": "呜呜…",
            "nextDialogs": [
              "750481207"
            ]
          },
          "750481207": {
            "id": "750481207",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "#欸？我不是说{REALNAME[ID(2)|SHOWHOST(true)]}没派上用场的意思啦，别难过呀。",
            "nextDialogs": [
              "750481209",
              "750481211"
            ]
          },
          "750481209": {
            "id": "750481209",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "#{NICKNAME}你也帮我解释一下啊，每个人擅长的地方都不一样，只是这里不适合{REALNAME[ID(2)|SHOWHOST(true)]}发挥而已吧。",
            "nextDialogs": [
              "750481212"
            ]
          },
          "750481212": {
            "id": "750481212",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "话说回来，坏龙是往那个方向飞了吗？",
            "nextDialogs": [
              "750481213"
            ]
          },
          "750481213": {
            "id": "750481213",
            "speakerId": 1003,
            "speakerName": "玻娜",
            "text": "哼哼，野兽受了伤第一反应一定是躲回巢穴里，它的老家说不定就在那边呢。",
            "nextDialogs": [
              "750481214"
            ]
          },
          "750481214": {
            "id": "750481214",
            "speakerId": 1003,
            "speakerName": "玻娜",
            "text": "事不宜迟，趁那家伙还没来得及恢复气力，一鼓作气地把火磷石夺回来吧！",
            "nextDialogs": [
              "750481215"
            ]
          },
          "750481215": {
            "id": "750481215",
            "speakerId": 1003,
            "speakerName": "玻娜",
            "text": "哈，要是像以前那样一个人的话，就算是受了伤的恶龙，我也是不敢和它正面交锋的。",
            "nextDialogs": [
              "750481216"
            ]
          },
          "750481216": {
            "id": "750481216",
            "speakerId": 1003,
            "speakerName": "玻娜",
            "text": "不过这次我们有这么多人，你们又这么能打，看来是不用担心啦。"
          },
          "750481211": {
            "id": "750481211",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "#对啊，接下来说不定就到了{REALNAME[ID(2)|SHOWHOST(true)]}大放异彩的时候了呢。"
          }
        }
      }
    },

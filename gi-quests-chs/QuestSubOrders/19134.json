          },
          "191340602": {
            "id": "191340602",
            "speakerId": 1003,
            "speakerName": "盈丰",
            "text": "凝光大人的拍卖会，这么说吧，买到就是赚到，多买就是多赚。"
          }
        }
      }
    },
    {
      "subId": "1913407",

    {
      "subId": "1913409",
      "subQuestName": "了解参拍者的想法",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "191340901"
        ],
        "dialogs": {
          "191340901": {
            "id": "191340901",
            "speakerId": 1005,
            "speakerName": "晓飞",
            "text": "欸？你问我为什么要出这么高的价？",
            "nextDialogs": [
              "191340902"
            ]
          },
          "191340902": {
            "id": "191340902",
            "speakerId": 1005,
            "speakerName": "晓飞",
            "text": "那还用说嘛，因为这是凝光的东西啊。",
            "nextDialogs": [
              "191340903"
            ]
          },
          "191340903": {
            "id": "191340903",
            "speakerId": 1005,
            "speakerName": "晓飞",
            "text": "虽然东西看上去很一般，但只是因为我的眼光一般，知识储备也不足…",
            "nextDialogs": [
              "191340904"
            ]
          },
          "191340904": {
            "id": "191340904",
            "speakerId": 1005,
            "speakerName": "晓飞",
            "text": "总之先买下来，然后赶快找个人帮我鉴定一下，我就发财了，嘿嘿。"
          }
        }
      }
    },
    {
      "subId": "1913410",
      "subQuestName": "了解参拍者的想法",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "191341001"
        ],
        "dialogs": {
          "191341001": {
            "id": "191341001",
            "speakerId": 1003,
            "speakerName": "盈丰",
            "text": "这可算是下了血本，不过最后的结果也很让我满意，哼。",
            "nextDialogs": [
              "191341002"
            ]
          },
          "191341002": {
            "id": "191341002",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "你不担心价格虚高吗？",
            "nextDialogs": [
              "191341003"
            ]
          },
          "191341003": {
            "id": "191341003",
            "speakerId": 1003,
            "speakerName": "盈丰",
            "text": "只要是从凝光这里买的东西，就永远不会虚高。",
            "nextDialogs": [
              "191341004"
            ]
          },
          "191341004": {
            "id": "191341004",
            "speakerId": 1003,
            "speakerName": "盈丰",
            "text": "像我这么相信凝光大人的买家大有人在，我能赚多少，就看有多少人比我更狂热了。"
          }
        }
      }
    },
    {
      "subId": "1913411",

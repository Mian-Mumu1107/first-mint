    {
      "subId": "7724010",
      "subQuestName": "(test)隐藏$HIDDEN",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "772400501"
        ],
        "dialogs": {
          "772400501": {
            "id": "772400501",
            "speakerId": 22770,
            "speakerName": "克鲁日科娃",
            "text": "来试试「数霜精」挑战吧…参加一次仅需1000摩拉，成功即可获得海量奖励！",
            "nextDialogs": [
              "772400503",
              "772400508"
            ]
          },
          "772400503": {
            "id": "772400503",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "#嗯…1000摩拉，我来替{NICKNAME}付！待会要是真的能得到奖励…",
            "nextDialogs": [
              "772400504"
            ]
          },
          "772400504": {
            "id": "772400504",
            "speakerId": 22770,
            "speakerName": "克鲁日科娃",
            "text": "一定能的，这位可爱的小小的看上去像是霜精的女士。",
            "nextDialogs": [
              "772400505"
            ]
          },
          "772400505": {
            "id": "772400505",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "#好哦，待会儿{NICKNAME}拿了奖励，一定得请我吃好吃的！",
            "nextDialogs": [
              "772400506"
            ]
          },
          "772400506": {
            "id": "772400506",
            "speakerId": 22770,
            "speakerName": "克鲁日科娃",
            "text": "好，那就请两位站在那…挑战马上就要开始咯。"
          },
          "772400508": {
            "id": "772400508",
            "speakerId": 22770,
            "speakerName": "克鲁日科娃",
            "text": "哎呀，真可惜，但是没关系，我还会在这里好一会儿，等你们有空了，一定要记得来挑战哦！"
          }
        }
      }
    },
    {
      "subId": "7724002",
      "subQuestName": "(test)隐藏$HIDDEN",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "772400201"
        ],
        "dialogs": {
          "772400201": {
            "id": "772400201",
            "speakerId": 22770,
            "speakerName": "克鲁日科娃",
            "text": "不知道你们有没有数清楚呢…总之就是那个…呃，像是那样的霜精有几只呢？",
            "nextDialogs": [
              "772400208",
              "772400209"
            ]
          },
          "772400208": {
            "id": "772400208",
            "speakerId": 22770,
            "speakerName": "克鲁日科娃",
            "text": "哎呀，错了！抱歉。真可惜啊，就这样与大奖失之交臂了。"
          },
          "772400209": {
            "id": "772400209",
            "speakerId": 22770,
            "speakerName": "克鲁日科娃",
            "text": "哎呀，错了！抱歉，可能是您刚才没有听清楚问题…我刚才可没有问列车上的霜精一共有几只哦。",
            "nextDialogs": [
              "772400210"
            ]
          },
          "772400210": {
            "id": "772400210",
            "speakerId": 22770,
            "speakerName": "克鲁日科娃",
            "text": "我问的是…对，我问的是像那样…「戴着帽子」的霜精一共有几只。",
            "nextDialogs": [
              "772400211"
            ]
          },
          "772400211": {
            "id": "772400211",
            "speakerId": 22770,
            "speakerName": "克鲁日科娃",
            "text": "真可惜啊，就这样与大奖失之交臂了。",
            "nextDialogs": [
              "772400212"
            ]
          },
          "772400212": {
            "id": "772400212",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "什么啊，你这家伙，刚才根本就没说清楚问题！",
            "nextDialogs": [
              "772400213"
            ]
          },
          "772400213": {
            "id": "772400213",
            "speakerId": 22770,
            "speakerName": "克鲁日科娃",
            "text": "哎呀，是你们答得太快了。",
            "nextDialogs": [
              "772400214"
            ]
          },
          "772400214": {
            "id": "772400214",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "那、那我们再来一次！这次我们绝对会数清楚的！",
            "nextDialogs": [
              "772400215"
            ]
          },
          "772400215": {
            "id": "772400215",
            "speakerId": 22770,
            "speakerName": "克鲁日科娃",
            "text": "那么参加的费用…",
            "nextDialogs": [
              "772400216"
            ]
          },
          "772400216": {
            "id": "772400216",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "我来出，哼，这次知道你要数「戴帽子的霜精」，我们就不会数错了！",
            "nextDialogs": [
              "772400217"
            ]
          },
          "772400217": {
            "id": "772400217",
            "speakerId": 22770,
            "speakerName": "克鲁日科娃",
            "text": "哎呀，真是慷慨的挑战者，那就预祝你们挑战成功咯…"
          }
        }
      }
    },
    {
      "subId": "7724003",

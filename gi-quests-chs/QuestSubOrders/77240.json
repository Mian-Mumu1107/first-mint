            ]
          },
          "772400312": {
            "id": "772400312",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "这次我也在旁边偷偷数了…戴帽子的霜精就是5只！而且你之前也说得很清楚，问的也是戴帽子的霜精！",
            "nextDialogs": [
              "772400313"
            ]
          },
          "772400313": {
            "id": "772400313",
            "speakerId": 22770,
            "speakerName": "克鲁日科娃",
            "text": "是的呢！正确答案就是——5只！",
            "nextDialogs": [
              "772400314"
            ]
          },
          "772400314": {
            "id": "772400314",
            "speakerId": 22770,
            "speakerName": "克鲁日科娃",
            "text": "那么，就请挑战成功的勇士拿走奖励，我就先行告退啦！"
          }

    {
      "subId": "7724004",
      "subQuestName": "(test)隐藏$HIDDEN",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "772400401"
        ],
        "dialogs": {
          "772400401": {
            "id": "772400401",
            "speakerId": 1002,
            "speakerName": "Black Screen",
            "text": "还好那个骗子没有走远，你们把她抓住，带回了列车前…",
            "nextDialogs": [
              "772400402"
            ]
          },
          "772400402": {
            "id": "772400402",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "快，把我刚才给你的参加费还给我！",
            "nextDialogs": [
              "772400403"
            ]
          },
          "772400403": {
            "id": "772400403",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "真是个骗人的坏家伙。",
            "nextDialogs": [
              "772400404"
            ]
          },
          "772400404": {
            "id": "772400404",
            "speakerId": 22770,
            "speakerName": "克鲁日科娃",
            "text": "我错了我错了，呜呜…我以为自己跑得已经够快了，没想到还是被你们抓了回来…",
            "nextDialogs": [
              "772400405"
            ]
          },
          "772400405": {
            "id": "772400405",
            "speakerId": 22770,
            "speakerName": "克鲁日科娃",
            "text": "原谅我吧，我、我还没骗几个人呢。",
            "nextDialogs": [
              "772400406"
            ]
          },
          "772400406": {
            "id": "772400406",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "你还想骗多少个！",
            "nextDialogs": [
              "772400407"
            ]
          },
          "772400407": {
            "id": "772400407",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "骗一个都多了！",
            "nextDialogs": [
              "772400408"
            ]
          },
          "772400408": {
            "id": "772400408",
            "speakerId": 22770,
            "speakerName": "克鲁日科娃",
            "text": "呜呜…我、我再也不敢了。",
            "nextDialogs": [
              "772400409"
            ]
          },
          "772400409": {
            "id": "772400409",
            "speakerId": 22770,
            "speakerName": "克鲁日科娃",
            "text": "实不相瞒，我从前也是冒险家协会的一位冒险家，有一次在某个雪夜在冻土上冒险的时候，遇到了成群的软猬兽。",
            "nextDialogs": [
              "772400410"
            ]
          },
          "772400410": {
            "id": "772400410",
            "speakerId": 22770,
            "speakerName": "克鲁日科娃",
            "text": "滚滚而来的软猬兽啊，就像是巨大的尖刺炮弹那样，把我追得狼狈不堪，涕泗横流…",
            "nextDialogs": [
              "772400411"
            ]
          },
          "772400411": {
            "id": "772400411",
            "speakerId": 22770,
            "speakerName": "克鲁日科娃",
            "text": "那以后我就暗暗下定决心，一定要骗…赚取足够多的摩拉，付钱让别的冒险家把那些软猬兽全部赶跑…",
            "nextDialogs": [
              "772400412"
            ]
          },
          "772400412": {
            "id": "772400412",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "那就正经赚钱嘛，别搞这些骗局…列车上的霜精呢？",
            "nextDialogs": [
              "772400413"
            ]
          },
          "772400413": {
            "id": "772400413",
            "speakerId": 22770,
            "speakerName": "克鲁日科娃",
            "text": "我骗它们列车里有好吃的，它们就来了…",
            "nextDialogs": [
              "772400414"
            ]
          },
          "772400414": {
            "id": "772400414",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "唉，我想也是，以后不许骗人，把那些霜精也放了吧！",
            "nextDialogs": [
              "772400415"
            ]
          },
          "772400415": {
            "id": "772400415",
            "speakerId": 22770,
            "speakerName": "克鲁日科娃",
            "text": "好、好的…",
            "nextDialogs": [
              "772400416"
            ]
          },
          "772400416": {
            "id": "772400416",
            "speakerId": 1002,
            "speakerName": "Black Screen",
            "text": "名为克鲁日科娃的骗子将霜精们放走。\\n并再三发誓，以后绝对不会再从事骗局，而是好好工作、正经赚钱…",
            "nextDialogs": [
              "772400417"
            ]
          },
          "772400417": {
            "id": "772400417",
            "speakerId": 1002,
            "speakerName": "Black Screen",
            "text": "直到此刻霜精们才意识到自己上当受骗。\\n为了报答将它们解救的你，它们把亮晶晶的纽扣递到了你的手里。",
            "nextDialogs": [
              "772400418"
            ]
          },
          "772400418": {
            "id": "772400418",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "哦…这是纽扣，是霜精们的谢礼？",
            "nextDialogs": [
              "772400419"
            ]
          },
          "772400419": {
            "id": "772400419",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "真是的，那个骗子真是令人生气…霜精们也是，真希望它们不要再被人骗了！"
          }
        }
      }
    },
    {
      "subId": "7724005",
      "subQuestName": "(test)隐藏$HIDDEN",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "772400301"
        ],
        "dialogs": {
          "772400301": {
            "id": "772400301",
            "speakerId": 22770,
            "speakerName": "克鲁日科娃",
            "text": "不知道你们有没有数清楚呢…那么，戴帽子的霜精一共有几只呢？",
            "nextDialogs": [
              "772400303",
              "772400307",
              "772400311"
            ]
          },
          "772400303": {
            "id": "772400303",
            "speakerId": 22770,
            "speakerName": "克鲁日科娃",
            "text": "哎呀…距离正确答案已经很近了，很可惜…",
            "nextDialogs": [
              "772400304"
            ]
          },
          "772400304": {
            "id": "772400304",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "唔…我也觉得好像不太对！不行，得再重来一回！",
            "nextDialogs": [
              "772400305"
            ]
          },
          "772400305": {
            "id": "772400305",
            "speakerId": 22770,
            "speakerName": "克鲁日科娃",
            "text": "好的，好的，参加的费用已经收到了，还请继续吧…"
          },
          "772400307": {
            "id": "772400307",
            "speakerId": 22770,
            "speakerName": "克鲁日科娃",
            "text": "哎呀…距离正确答案已经很近了，很可惜…",
            "nextDialogs": [
              "772400308"
            ]
          },
          "772400308": {
            "id": "772400308",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "唔…我也觉得好像不太对！不行，得再重来一回！",
            "nextDialogs": [
              "772400309"
            ]
          },
          "772400309": {
            "id": "772400309",
            "speakerId": 22770,
            "speakerName": "克鲁日科娃",
            "text": "好的，好的，参加的费用已经收到了，还请继续吧…"
          },
          "772400311": {
            "id": "772400311",
            "speakerId": 22770,
            "speakerName": "克鲁日科娃",
            "text": "嗯…究竟结果如何呢…",
            "nextDialogs": [

  "subQuests": [
    {
      "subId": "2202201",
      "subQuestName": "与芭尔瓦涅对话",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "220220101"
        ],
        "dialogs": {
          "220220101": {
            "id": "220220101",
            "speakerId": 20270,
            "speakerName": "芭尔瓦涅",
            "text": "这个食谱的搭配应该是这样才对…",
            "nextDialogs": [
              "220220102"
            ]
          },
          "220220102": {
            "id": "220220102",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "你在做什么呢？",
            "nextDialogs": [
              "220220103"
            ]
          },
          "220220103": {
            "id": "220220103",
            "speakerId": 20270,
            "speakerName": "芭尔瓦涅",
            "text": "我正在整理食谱呢，呃…但有些食谱还是记不太清…",
            "nextDialogs": [
              "220220105",
              "220220107"
            ]
          },
          "220220105": {
            "id": "220220105",
            "speakerId": 20270,
            "speakerName": "芭尔瓦涅",
            "text": "旭东…我之所以记不清那些食谱，大部分原因就是他成天折腾的那些「创意食物」。",
            "nextDialogs": [
              "220220109"
            ]
          },
          "220220109": {
            "id": "220220109",
            "speakerId": 20270,
            "speakerName": "芭尔瓦涅",
            "text": "每次他拿到新食谱之后，顶多只会按照那些食谱记录的方法做一两天。",
            "nextDialogs": [
              "220220110"
            ]
          },
          "220220110": {
            "id": "220220110",
            "speakerId": 20270,
            "speakerName": "芭尔瓦涅",
            "text": "然后，他就会开始…用各种方法「改造」那些食谱。"
          },
          "220220107": {
            "id": "220220107",
            "speakerId": 20270,
            "speakerName": "芭尔瓦涅",
            "text": "拜托你不要再重复这个名字了，我的论文里绝对不会出现这五个字…",
            "nextDialogs": [
              "220220108"
            ]
          },
          "220220108": {
            "id": "220220108",
            "speakerId": 20270,
            "speakerName": "芭尔瓦涅",
            "text": "再说了，我之所以记不清那些食谱，大部分原因也就是旭东成天折腾的那些「创意食物」。"
          }
        }
      }
    },
    {
      "subId": "2202202",
      "subQuestName": "与芭尔瓦涅对话",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "220220701"
        ],
        "dialogs": {
          "220220701": {
            "id": "220220701",
            "speakerId": 20270,
            "speakerName": "芭尔瓦涅",
            "text": "嗯，谢谢你。这些食谱我就先记下了，希望旭东不要再乱改它们了",
            "nextDialogs": [
              "220220702"
            ]
          },
          "220220702": {
            "id": "220220702",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "他为什么要这么做？",
            "nextDialogs": [
              "220220703"
            ]
          },
          "220220703": {
            "id": "220220703",
            "speakerId": 20270,
            "speakerName": "芭尔瓦涅",
            "text": "旭东只是和我说，他想要把这些菜变便宜点。",
            "nextDialogs": [
              "220220704"
            ]
          },
          "220220704": {
            "id": "220220704",
            "speakerId": 20270,
            "speakerName": "芭尔瓦涅",
            "text": "我是完全弄不懂他这么做的理由…但不管怎么说，他的手艺是真的不错。",
            "nextDialogs": [
              "220220705"
            ]
          },
          "220220705": {
            "id": "220220705",
            "speakerId": 20270,
            "speakerName": "芭尔瓦涅",
            "text": "真是的…他有这手艺做些什么不好，怎么尽和这些食谱过不去呢…"
          }
        }
      }
    },
    {
      "subId": "2202203",
      "subQuestName": "与芭尔瓦涅对话",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "220220801"
        ],
        "dialogs": {
          "220220801": {
            "id": "220220801",
            "speakerId": 20270,
            "speakerName": "芭尔瓦涅",
            "text": "嗯…总感觉这些食谱哪里不太对…",
            "nextDialogs": [
              "220220802"
            ]
          },
          "220220802": {
            "id": "220220802",
            "speakerId": 20270,
            "speakerName": "芭尔瓦涅",
            "text": "算了，总之我先记下来吧，谢谢你，希望旭东不要再乱改它们了",
            "nextDialogs": [
              "220220803"
            ]
          },
          "220220803": {
            "id": "220220803",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "他为什么要这么做？",
            "nextDialogs": [
              "220220804"
            ]
          },
          "220220804": {
            "id": "220220804",
            "speakerId": 20270,
            "speakerName": "芭尔瓦涅",
            "text": "旭东只是和我说，他想要把这些菜变便宜点。",
            "nextDialogs": [
              "220220805"
            ]
          },
          "220220805": {
            "id": "220220805",
            "speakerId": 20270,
            "speakerName": "芭尔瓦涅",
            "text": "我是完全弄不懂他这么做的理由…但不管怎么说，他的手艺是真的不错。",
            "nextDialogs": [
              "220220806"
            ]
          },
          "220220806": {
            "id": "220220806",
            "speakerId": 20270,
            "speakerName": "芭尔瓦涅",
            "text": "真是的…他有这手艺做些什么不好，怎么尽和这些食谱过不去呢…"
          }
        }
      }
    },
    {
      "subId": "2202204",
      "subQuestName": "",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "220220401"
        ],
        "dialogs": {
          "220220401": {
            "id": "220220401",
            "speakerId": 20270,
            "speakerName": "芭尔瓦涅",
            "text": "璃月有一道菜「腌笃鲜」，据说制作起来很是精细…",
            "nextDialogs": [
              "220220402"
            ]
          },
          "220220402": {
            "id": "220220402",
            "speakerId": 20270,
            "speakerName": "芭尔瓦涅",
            "text": "旭东这个家伙…果然又改了…",
            "nextDialogs": [
              "220220403"
            ]
          },
          "220220403": {
            "id": "220220403",
            "speakerId": 20270,
            "speakerName": "芭尔瓦涅",
            "text": "「金鱼草切碎，与口蘑同煮，调以盐糖，汤尝之有火腿味。」",
            "nextDialogs": [
              "220220404"
            ]
          },
          "220220404": {
            "id": "220220404",
            "speakerId": 20270,
            "speakerName": "芭尔瓦涅",
            "text": "谁要把这两个放一起煮啊！？而且就算汤有火腿味，那我也吃不到火腿啊！",
            "nextDialogs": [
              "220220405"
            ]
          },
          "220220405": {
            "id": "220220405",
            "speakerId": 20270,
            "speakerName": "芭尔瓦涅",
            "text": "算了…旅行者，我想问的是，这道「腌笃鲜」的原料，除了兽肉和火腿之外，还需要一道什么材料？",
            "nextDialogs": [
              "220220411",
              "220220410"
            ]
          },
          "220220411": {
            "id": "220220411",
            "speakerId": 20270,
            "speakerName": "芭尔瓦涅",
            "text": "唔…是这样吗？我先记一下…"
          },
          "220220410": {
            "id": "220220410",
            "speakerId": 20270,
            "speakerName": "芭尔瓦涅",
            "text": "唔…是这样吗？我先记一下…"
          }
        }
      }
    },
    {
      "subId": "2202205",
      "subQuestName": "与芭尔瓦涅对话",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "220220501"
        ],
        "dialogs": {
          "220220501": {
            "id": "220220501",
            "speakerId": 20270,
            "speakerName": "芭尔瓦涅",
            "text": "稻妻有一道叫做「串串三味」的菜…自从宗久大叔教给旭东后，他就一个劲地在那琢磨…",
            "nextDialogs": [
              "220220502"
            ]
          },
          "220220502": {
            "id": "220220502",
            "speakerId": 20270,
            "speakerName": "芭尔瓦涅",
            "text": "居然还有这么多笔记…",
            "nextDialogs": [
              "220220503"
            ]
          },
          "220220503": {
            "id": "220220503",
            "speakerId": 20270,
            "speakerName": "芭尔瓦涅",
            "text": "「串串二字实在妙极，无论何种食材，皆可串于一签之上…」",
            "nextDialogs": [
              "220220504"
            ]
          },
          "220220504": {
            "id": "220220504",
            "speakerId": 20270,
            "speakerName": "芭尔瓦涅",
            "text": "这人到底想要串什么…算了，旅行者，我想问的是，这道「串串三味」的原料，除了兽肉、面粉和金鱼草之外，还需要一道什么材料？",
            "nextDialogs": [
              "220220506",
              "220220510"
            ]
          },
          "220220506": {
            "id": "220220506",
            "speakerId": 20270,
            "speakerName": "芭尔瓦涅",
            "text": "唔…是这样吗？我先记一下…"
          },
          "220220510": {
            "id": "220220510",
            "speakerId": 20270,
            "speakerName": "芭尔瓦涅",
            "text": "唔…是这样吗？我先记一下…"
          }
        }
      }
    },
    {
      "subId": "2202202",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "220220201"
        ],
        "dialogs": {
          "220220201": {
            "id": "220220201",
            "speakerId": 20270,
            "speakerName": "芭尔瓦涅",
            "text": "蒙德有一道「北地苹果焖肉」，旭东这家伙又在乱写…",
            "nextDialogs": [
              "220220202"
            ]
          },
          "220220202": {
            "id": "220220202",
            "speakerId": 20270,
            "speakerName": "芭尔瓦涅",
            "text": "「黄油略贵，兽肉难储，不如揉和面团，洗出面筋，再将面筋入屉蒸熟，佐以蔬果调料，入口亦有肉感。」",
            "nextDialogs": [
              "220220203"
            ]
          },
          "220220203": {
            "id": "220220203",
            "speakerId": 20270,
            "speakerName": "芭尔瓦涅",
            "text": "这家伙，黄油有什么贵的，兽肉直接去买新鲜的不就好了？",
            "nextDialogs": [
              "220220204"
            ]
          },
          "220220204": {
            "id": "220220204",
            "speakerId": 20270,
            "speakerName": "芭尔瓦涅",
            "text": "算了…旅行者，我想问你的是，这道「北地苹果焖肉」的原料，除了苹果、黄油和兽肉之外，还有一道材料是？",
            "nextDialogs": [
              "220220210",
              "220220207"
            ]
          },
          "220220210": {
            "id": "220220210",
            "speakerId": 20270,
            "speakerName": "芭尔瓦涅",
            "text": "唔…是这样吗？我先记一下…"
          },
          "220220207": {
            "id": "220220207",
            "speakerId": 20270,
            "speakerName": "芭尔瓦涅",
            "text": "唔…是这样吗？我先记一下…"
          }
        }
      }
    },
    {
      "subId": "2202203",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "220220301"
        ],
        "dialogs": {
          "220220301": {
            "id": "220220301",
            "speakerId": 20270,
            "speakerName": "芭尔瓦涅",
            "text": "璃月有一道「天枢肉」很有名气，我看看…咦，旭东果然又在乱写了…",
            "nextDialogs": [
              "220220302"
            ]
          },
          "220220302": {
            "id": "220220302",
            "speakerId": 20270,
            "speakerName": "芭尔瓦涅",
            "text": "「可取土豆去皮蒸熟，趁热捣烂后拌以油盐，倒扣碗中，再以面粉调出厚芡汁浇上，初尝软烂如肉。」",
            "nextDialogs": [
              "220220303"
            ]
          },
          "220220303": {
            "id": "220220303",
            "speakerId": 20270,
            "speakerName": "芭尔瓦涅",
            "text": "初尝…那吃多了不还是能分辨出来吗？这也就骗骗没吃过正版「天枢肉」的人…",
            "nextDialogs": [
              "220220304"
            ]
          },
          "220220304": {
            "id": "220220304",
            "speakerId": 20270,
            "speakerName": "芭尔瓦涅",
            "text": "算了，旅行者，我想问的是…这道「天枢肉」的原料，除了兽肉、糖和松茸外，还需要一道什么材料？",
            "nextDialogs": [
              "220220310",
              "220220307"
            ]
          },
          "220220310": {
            "id": "220220310",
            "speakerId": 20270,
            "speakerName": "芭尔瓦涅",
            "text": "唔…是这样吗？我先记一下…"
          },
          "220220307": {
            "id": "220220307",
            "speakerId": 20270,
            "speakerName": "芭尔瓦涅",
            "text": "唔…是这样吗？我先记一下…"
          }
        }
      }
    },
    {
      "subId": "2202206",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "220220601"
        ],
        "dialogs": {
          "220220601": {
            "id": "220220601",
            "speakerId": 20270,
            "speakerName": "芭尔瓦涅",
            "text": "璃月有一道菜「水煮黑背鲈」，听说是一道很有名的菜…",
            "nextDialogs": [
              "220220602"
            ]
          },
          "220220602": {
            "id": "220220602",
            "speakerId": 20270,
            "speakerName": "芭尔瓦涅",
            "text": "「…琉璃袋难求。小灯草与金鱼草共煮一碗汤水，以汤水入菜，亦可得同味。」",
            "nextDialogs": [
              "220220603"
            ]
          },
          "220220603": {
            "id": "220220603",
            "speakerId": 20270,
            "speakerName": "芭尔瓦涅",
            "text": "旭东这都是怎么想到的…",
            "nextDialogs": [
              "220220604"
            ]
          },
          "220220604": {
            "id": "220220604",
            "speakerId": 20270,
            "speakerName": "芭尔瓦涅",
            "text": "算了，旅行者，我想问的是，这道「水煮黑背鲈」，除了琉璃袋、绝云椒椒和鱼肉外，还有一道调料是什么？",
            "nextDialogs": [
              "220220610",
              "220220607"
            ]
          },
          "220220610": {
            "id": "220220610",
            "speakerId": 20270,
            "speakerName": "芭尔瓦涅",
            "text": "唔…是这样吗？我先记一下…"
          },
          "220220607": {
            "id": "220220607",
            "speakerId": 20270,
            "speakerName": "芭尔瓦涅",
            "text": "唔…是这样吗？我先记一下…"
          }
        }
      }
    }
  ]
}
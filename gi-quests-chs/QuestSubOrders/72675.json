    {
      "subId": "7267508",
      "subQuestName": "登上桅杆",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "726750801"
        ],
        "dialogs": {
          "726750801": {
            "id": "726750801",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "你看！视线很好吧？",
            "nextDialogs": [
              "726750802"
            ]
          },
          "726750802": {
            "id": "726750802",
            "speakerId": 3160,
            "speakerName": "「吉法师」",
            "text": "呶，好厉害。",
            "nextDialogs": [
              "726750803"
            ]
          },
          "726750803": {
            "id": "726750803",
            "speakerId": 3160,
            "speakerName": "「吉法师」",
            "text": "那边好多山。是什么地方？",
            "nextDialogs": [
              "726750804"
            ]
          },
          "726750804": {
            "id": "726750804",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "嗯？那边的话…",
            "nextDialogs": [
              "726750807"
            ]
          },
          "726750807": {
            "id": "726750807",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "没错！那边应该就是影向山。影向山下面，就是镇守之森。",
            "nextDialogs": [
              "726750808"
            ]
          },
          "726750808": {
            "id": "726750808",
            "speakerId": 3160,
            "speakerName": "「吉法师」",
            "text": "好远。五百藏在海的那边。",
            "nextDialogs": [
              "726750809"
            ]
          },
          "726750809": {
            "id": "726750809",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "嗯。不过，我们会陪你一起修行的！",
            "nextDialogs": [
              "726750810"
            ]
          },
          "726750810": {
            "id": "726750810",
            "speakerId": 3160,
            "speakerName": "「吉法师」",
            "text": "嗯！",
            "nextDialogs": [
              "726750811"
            ]
          },
          "726750811": {
            "id": "726750811",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "接下来，去什么地方好呢…",
            "nextDialogs": [
              "726750812"
            ]
          },
          "726750812": {
            "id": "726750812",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "唔，有没有什么对我们来说很熟悉，又有好吃的东西的地方呢…"
          }
        }
      }
    },
    {
      "subId": "7226408",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "722640801"
        ],
        "dialogs": {
          "722640801": {
            "id": "722640801",
            "speakerId": 3159,
            "speakerName": "五百藏",
            "text": "让这孩子多看看外面的世界吧。吾辈做不到的事情，就交给你了。"
          }
        }
      }
    },
    {
      "subId": "7226414",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "722641401"
        ],
        "dialogs": {
          "722641401": {
            "id": "722641401",
            "speakerId": 15132,
            "speakerName": "「吉法师」",
            "text": "呶！修行开心。",
            "nextDialogs": [
              "722641403",
              "722641413"
            ]
          },
          "722641403": {
            "id": "722641403",
            "speakerId": 15132,
            "speakerName": "「吉法师」",
            "text": "黄毛好强。砰砰，好大好圆就没了。",
            "nextDialogs": [
              "722641404"
            ]
          },
          "722641404": {
            "id": "722641404",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "因为平时有在锻炼。",
            "nextDialogs": [
              "722641405"
            ]
          },
          "722641405": {
            "id": "722641405",
            "speakerId": 15132,
            "speakerName": "「吉法师」",
            "text": "呶！想和黄毛一样强。",
            "nextDialogs": [
              "722641406"
            ]
          },
          "722641406": {
            "id": "722641406",
            "speakerId": 15132,
            "speakerName": "「吉法师」",
            "text": "所以修行。修行修行，变强变强。",
            "nextDialogs": [
              "722641407"
            ]
          },
          "722641407": {
            "id": "722641407",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "吉法师变强了以后，想干什么？",
            "nextDialogs": [
              "722641408"
            ]
          },
          "722641408": {
            "id": "722641408",
            "speakerId": 15132,
            "speakerName": "「吉法师」",
            "text": "报复刑部小判，呶哈哈。",
            "nextDialogs": [
              "722641409"
            ]
          },
          "722641409": {
            "id": "722641409",
            "speakerId": 15132,
            "speakerName": "「吉法师」",
            "text": "把五百藏变成不是石头。",
            "nextDialogs": [
              "722641410"
            ]
          },
          "722641410": {
            "id": "722641410",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "加油。修行的路线就交给我们吧。",
            "nextDialogs": [
              "722641411"
            ]
          },
          "722641411": {
            "id": "722641411",
            "speakerId": 15132,
            "speakerName": "「吉法师」",
            "text": "呶！"
          },
          "722641413": {
            "id": "722641413",
            "speakerId": 15132,
            "speakerName": "「吉法师」",
            "text": "耶！"
          }
        }
      }
    }
  ]
}
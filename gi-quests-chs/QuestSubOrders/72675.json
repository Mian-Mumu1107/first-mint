    {
      "subId": "7267501",
      "subQuestName": "前往孤云阁",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "726750101"
        ],
        "dialogs": {
          "726750101": {
            "id": "726750101",
            "speakerId": 3160,
            "speakerName": "「吉法师」",
            "text": "和雪山不同，不冷。也没有雪。",
            "nextDialogs": [
              "726750102"
            ]
          },
          "726750102": {
            "id": "726750102",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "这里是孤云阁！传说是当年岩王帝君击败那个…那个…很多头的大水蛇，叫什么来着？",
            "nextDialogs": [
              "726750105"
            ]
          },
          "726750105": {
            "id": "726750105",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "啊，对！漩涡之魔神奥赛尔！当年就是在这里，被石枪打败、镇压的。",
            "nextDialogs": [
              "726750106"
            ]
          },
          "726750106": {
            "id": "726750106",
            "speakerId": 3160,
            "speakerName": "「吉法师」",
            "text": "哇！",
            "nextDialogs": [
              "726750107"
            ]
          },
          "726750107": {
            "id": "726750107",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "嘿嘿，厉害吧？不过我们也和它战斗过！我们在凝光小姐的群玉阁上…",
            "nextDialogs": [
              "726750108"
            ]
          },
          "726750108": {
            "id": "726750108",
            "speakerId": 3160,
            "speakerName": "「吉法师」",
            "text": "金色的晶蝶！",
            "nextDialogs": [
              "726750109"
            ]
          },
          "726750109": {
            "id": "726750109",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "原来是在感叹这个喔！好好听人说话啦！",
            "nextDialogs": [
              "726750110"
            ]
          },
          "726750110": {
            "id": "726750110",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "毕竟和稻妻的晶蝶不同…",
            "nextDialogs": [
              "726750111"
            ]
          },
          "726750111": {
            "id": "726750111",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "他应该没见过不是紫色的晶蝶…",
            "nextDialogs": [
              "726750112"
            ]
          },
          "726750112": {
            "id": "726750112",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "#嗯…也是啦。真拿吉法师没办法。{NICKNAME}，抓个晶蝶给他看看吧！"
          }
        }
      }
    },
    {
      "subId": "7267502",
      "subQuestName": "将1枚晶核交给吉法师",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "726750201"
        ],
        "dialogs": {
          "726750201": {
            "id": "726750201",
            "speakerId": 3160,
            "speakerName": "「吉法师」",
            "text": "砰砰~晶蝶~金色的晶蝶~"
          }
        }
      }
    },
    {
      "subId": "7267503",
      "subQuestName": "与吉法师对话",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "726750301"
        ],
        "dialogs": {
          "726750301": {
            "id": "726750301",
            "speakerId": 3160,
            "speakerName": "「吉法师」",
            "text": "…",
            "nextDialogs": [
              "726750302"
            ]
          },
          "726750302": {
            "id": "726750302",
            "speakerId": 3160,
            "speakerName": "「吉法师」",
            "text": "不是金色。",
            "nextDialogs": [
              "726750303"
            ]
          },
          "726750303": {
            "id": "726750303",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "欸！震惊！居然不是金色的！",
            "nextDialogs": [
              "726750306"
            ]
          },
          "726750306": {
            "id": "726750306",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "这么一想，虽然和你旅行的时候抓过很多晶蝶，但从来没注意过…",
            "nextDialogs": [
              "726750307"
            ]
          },
          "726750307": {
            "id": "726750307",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "有种…我有种自己突然长大了，有些幻想破灭了的感觉…？",
            "nextDialogs": [
              "726750308"
            ]
          },
          "726750308": {
            "id": "726750308",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "看来派蒙也需要修行。",
            "nextDialogs": [
              "726750309"
            ]
          },
          "726750309": {
            "id": "726750309",
            "speakerId": 3160,
            "speakerName": "「吉法师」",
            "text": "白毛加油。",
            "nextDialogs": [
              "726750310"
            ]
          },
          "726750310": {
            "id": "726750310",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "真是的，别给我加油啦！明明是吉法师要修行。",
            "nextDialogs": [
              "726750311"
            ]
          },
          "726750311": {
            "id": "726750311",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "不过，还是有点失望喔…为什么岩晶蝶的晶核不是金色的呢？",
            "nextDialogs": [
              "726750312"
            ]
          },
          "726750312": {
            "id": "726750312",
            "speakerId": 3160,
            "speakerName": "「吉法师」",
            "text": "对。晶蝶是金色，为什么不是金色。"
          }
        }
      }
    },
    {
      "subId": "7267504",
      "subQuestName": "前往能看见死兆星号的地方",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "726750401"
        ],
        "dialogs": {
          "726750401": {
            "id": "726750401",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "看，死兆星号！",
            "nextDialogs": [
              "726750402"
            ]
          },
          "726750402": {
            "id": "726750402",
            "speakerId": 3160,
            "speakerName": "「吉法师」",
            "text": "好厉害！好多水！",
            "nextDialogs": [
              "726750403"
            ]
          },
          "726750403": {
            "id": "726750403",
            "speakerId": 3160,
            "speakerName": "「吉法师」",
            "text": "而且，好大！好大而且在水上！",
            "nextDialogs": [
              "726750404"
            ]
          },
          "726750404": {
            "id": "726750404",
            "speakerId": 3160,
            "speakerName": "「吉法师」",
            "text": "这么大，一定很重。为什么不会沉下去？",
            "nextDialogs": [
              "726750405"
            ]
          },
          "726750405": {
            "id": "726750405",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "因为死兆星号是船呀。",
            "nextDialogs": [
              "726750406"
            ]
          },
          "726750406": {
            "id": "726750406",
            "speakerId": 3160,
            "speakerName": "「吉法师」",
            "text": "但是，泥巴船就会沉。五百藏说过。兔子、妖狸、泥巴船的故事。",
            "nextDialogs": [
              "726750407"
            ]
          },
          "726750407": {
            "id": "726750407",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "嗯…不过，北斗的死兆星号不是泥巴做的，所以不会沉。",
            "nextDialogs": [
              "726750408"
            ]
          },
          "726750408": {
            "id": "726750408",
            "speakerId": 3160,
            "speakerName": "「吉法师」",
            "text": "为什么不是泥巴，就不会沉？",
            "nextDialogs": [
              "726750409"
            ]
          },
          "726750409": {
            "id": "726750409",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "吉法师说话倒是越来越流利了…不过应该怎么说呢…对了…",
            "nextDialogs": [
              "726750410"
            ]
          },
          "726750410": {
            "id": "726750410",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "#哼哼，{NICKNAME}，让我考考你。为什么船能浮在水面上？",
            "nextDialogs": [
              "726750412",
              "726750415"
            ]
          },
          "726750412": {
            "id": "726750412",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "欸？草元素有这样的作用吗？",
            "nextDialogs": [
              "726750413"
            ]
          },
          "726750413": {
            "id": "726750413",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "唔…不过，为什么拿盾牌的丘丘人不能浮在水面上呢？",
            "nextDialogs": [
              "726750416"
            ]
          },
          "726750416": {
            "id": "726750416",
            "speakerId": 3160,
            "speakerName": "「吉法师」",
            "text": "呜呶呶，听不懂。",
            "nextDialogs": [
              "726750417"
            ]
          },
          "726750417": {
            "id": "726750417",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "没关系，等吉法师长大以后，变得像派蒙一样聪明，就能明白了。为什么船能浮起来，为什么雪山会下雪，都能明白。"
          },
          "726750415": {
            "id": "726750415",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "原来是这样吗！嗯嗯我明白了。"
          }
        }
      }
    },
    {
      "subId": "7267505",

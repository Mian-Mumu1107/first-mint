    {
      "subId": "7267506",
      "subQuestName": "与吉法师对话",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "726750601"
        ],
        "dialogs": {
          "726750601": {
            "id": "726750601",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "接下来，带吉法师我们去死兆星上看看吧！",
            "nextDialogs": [
              "726750602"
            ]
          },
          "726750602": {
            "id": "726750602",
            "speakerId": 3160,
            "speakerName": "「吉法师」",
            "text": "不好。船要是沉呶…",
            "nextDialogs": [
              "726750603"
            ]
          },
          "726750603": {
            "id": "726750603",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "这艘船不会沉的。",
            "nextDialogs": [
              "726750604"
            ]
          },
          "726750604": {
            "id": "726750604",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "我们就是坐这个船，去的稻妻。",
            "nextDialogs": [
              "726750605"
            ]
          },
          "726750605": {
            "id": "726750605",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "对呀！然后，我们才认识了五百藏和吉法师。不用担心！",
            "nextDialogs": [
              "726750606"
            ]
          },
          "726750606": {
            "id": "726750606",
            "speakerId": 3160,
            "speakerName": "「吉法师」",
            "text": "喔！原来是这样。",
            "nextDialogs": [
              "726750607"
            ]
          },
          "726750607": {
            "id": "726750607",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "而且北斗大姐头很可靠，南十字星的人也很可靠。所以呀，这艘船就是海上最安全的地方。",
            "nextDialogs": [
              "726750608"
            ]
          },
          "726750608": {
            "id": "726750608",
            "speakerId": 3160,
            "speakerName": "「吉法师」",
            "text": "呶！好！"
          }
        }
      }
    },
    {
      "subId": "7267507",
      "subQuestName": "前往死兆星号",
      "sceneId": null,

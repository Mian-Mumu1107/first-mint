  "subQuests": [
    {
      "subId": "7005801",
      "subQuestName": "(test)隐藏$HIDDEN",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "700580101"
        ],
        "dialogs": {
          "700580101": {
            "id": "700580101",
            "speakerId": 10204,
            "speakerName": "魈",
            "text": "是你，许久未见了。",
            "nextDialogs": [
              "700580102"
            ]
          },
          "700580102": {
            "id": "700580102",
            "speakerId": 10204,
            "speakerName": "魈",
            "text": "我正准备放些霄灯，要一起吗？",
            "nextDialogs": [
              "700580103"
            ]
          },
          "700580103": {
            "id": "700580103",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "好的。",
            "nextDialogs": [
              "700580107",
              "700580106"
            ]
          },
          "700580107": {
            "id": "700580107",
            "speakerId": 10204,
            "speakerName": "魈",
            "text": "你手上拿着留影机，一路脚步轻松，显然是来留影的。",
            "nextDialogs": [
              "700580108"
            ]
          },
          "700580108": {
            "id": "700580108",
            "speakerId": 10204,
            "speakerName": "魈",
            "text": "这座庙靠山临水，是个幽静去处。",
            "nextDialogs": [
              "700580109"
            ]
          },
          "700580109": {
            "id": "700580109",
            "speakerId": 10204,
            "speakerName": "魈",
            "text": "偶尔有些香客前来绘墨，年轻一些的，会带留影机来，我见过。",
            "nextDialogs": [
              "700580110"
            ]
          },
          "700580110": {
            "id": "700580110",
            "speakerId": 10204,
            "speakerName": "魈",
            "text": "恰好今天没什么人来打扰，你可放心留影。",
            "nextDialogs": [
              "700580111"
            ]
          },
          "700580111": {
            "id": "700580111",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "顺带给魈也拍一张吧。",
            "nextDialogs": [
              "700580112"
            ]
          },
          "700580112": {
            "id": "700580112",
            "speakerId": 10204,
            "speakerName": "魈",
            "text": "…给我留影吗？",
            "nextDialogs": [
              "700580113"
            ]
          },
          "700580113": {
            "id": "700580113",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "还可以记下霄灯放飞的瞬间。",
            "nextDialogs": [
              "700580114"
            ]
          },
          "700580114": {
            "id": "700580114",
            "speakerId": 10204,
            "speakerName": "魈",
            "text": "我来这里是想放些霄灯，倒是没想过要留什么念想。",
            "nextDialogs": [
              "700580115"
            ]
          },
          "700580115": {
            "id": "700580115",
            "speakerId": 10204,
            "speakerName": "魈",
            "text": "如此亦好，那就依着你的想法来。",
            "nextDialogs": [
              "700580116"
            ]
          },
          "700580116": {
            "id": "700580116",
            "speakerId": 10204,
            "speakerName": "魈",
            "text": "照你看来，我以何种姿态留影为好？"
          },
          "700580106": {
            "id": "700580106",
            "speakerId": 10204,
            "speakerName": "魈",
            "text": "我不知道，但你的气息不难感知。"
          }
        }
      }
    }
  ]
}
    {
      "subId": "7321215",
      "subQuestName": "(test)剿灭丘丘人营地$HIDDEN",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "732121501"
        ],
        "dialogs": {
          "732121501": {
            "id": "732121501",
            "speakerId": 4294,
            "speakerName": "尤夫腾",
            "text": "这件事情很、很紧急，请、请、请快去告诉主母吧。"
          }
        }
      }
    },
    {
      "subId": "7321213",
      "subQuestName": "调查丘丘人营地",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "732121601"
        ],
        "dialogs": {
          "732121601": {
            "id": "732121601",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "唔…没有什么完整的东西留下来呢…哼，气死我啦！这些丘丘人太糟蹋东西啦！",
            "nextDialogs": [
              "732121603",
              "732121605"
            ]
          },
          "732121603": {
            "id": "732121603",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "欸…？可是…丘丘人就在这里扎营呀？"
          },
          "732121605": {
            "id": "732121605",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "可是丘丘人在路中间扎下了营地呀？你看，挡在这里不是正好可以拦路抢劫吗！"
          }
        }
      }
    },
    {
      "subId": "7321205",
      "subQuestName": "调查附近的线索",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "732120801"
        ],
        "dialogs": {
          "732120801": {
            "id": "732120801",
            "speakerId": 1004,
            "speakerName": "残破的毛毯",
            "text": "（一卷完好的毛毯，其上缝制着塔尼特部族的标志，沾染着点点不祥的污迹…）",
            "nextDialogs": [
              "732120802"
            ]
          },
          "732120802": {
            "id": "732120802",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "这卷毛毯…真奇怪…",
            "nextDialogs": [
              "732120803"
            ]
          },
          "732120803": {
            "id": "732120803",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "唔…昂贵的毛毯，为什么会被丢在这里呢？",
            "nextDialogs": [
              "732120804"
            ]
          },
          "732120804": {
            "id": "732120804",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "或许是因为发生了抢夺和打斗…",
            "nextDialogs": [
              "732120805"
            ]
          },
          "732120805": {
            "id": "732120805",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "嗯…有道理哦…这样的话，就能说明白啦。",
            "nextDialogs": [
              "732120806"
            ]
          },
          "732120806": {
            "id": "732120806",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "商队和劫匪在这里发生了打斗，一些物资在打斗过程中被破坏掉了，还有一些完好的物资没有顾得上整理就被丢弃掉了…",
            "nextDialogs": [
              "732120807"
            ]
          },
          "732120807": {
            "id": "732120807",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "派蒙的推理很靠谱呢。",
            "nextDialogs": [
              "732120808"
            ]
          },
          "732120808": {
            "id": "732120808",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "哼哼！毕竟是我派蒙嘛！",
            "nextDialogs": [
              "732120809"
            ]
          },
          "732120809": {
            "id": "732120809",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "于是，商队和劫匪一路打、一路跑！一路打、一路跑！一路打、一路跑…所以路上会散落着破碎的箱子和罐子！",
            "nextDialogs": [
              "732120810"
            ]
          },
          "732120810": {
            "id": "732120810",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "嗯，这样就能说得通啦！",
            "nextDialogs": [
              "732120811"
            ]
          },
          "732120811": {
            "id": "732120811",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "完全说不通吧！",
            "nextDialogs": [
              "732120812"
            ]
          },
          "732120812": {
            "id": "732120812",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "欸——！",
            "nextDialogs": [
              "732120815"
            ]
          },
          "732120815": {
            "id": "732120815",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "这样吗…",
            "nextDialogs": [
              "732120816"
            ]
          },
          "732120816": {
            "id": "732120816",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "因为沿途没有发现争斗痕迹。",
            "nextDialogs": [
              "732120817"
            ]
          },
          "732120817": {
            "id": "732120817",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "这样呀…哼哼，那我的推理也差的不远啦…八九不离十嘛！",
            "nextDialogs": [
              "732120818"
            ]
          },
          "732120818": {
            "id": "732120818",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "唔…但我总觉得哪里不太对劲…"
          }
        }
      }
    },

  "subQuests": [
    {
      "subId": "7321201",
      "subQuestName": "(test)与尤夫腾对话 $HIDDEN",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "732120101"
        ],
        "dialogs": {
          "732120101": {
            "id": "732120101",
            "speakerId": 4294,
            "speakerName": "尤夫腾",
            "text": "啊，「镇灵主人」，您、您、您来了。",
            "nextDialogs": [
              "732120102"
            ]
          },
          "732120102": {
            "id": "732120102",
            "speakerId": 4294,
            "speakerName": "尤夫腾",
            "text": "我正好有一件事要拜托您，一件、一件…急事。",
            "nextDialogs": [
              "732120104",
              "732120106"
            ]
          },
          "732120104": {
            "id": "732120104",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "嗯嗯，你慢慢说，我们会帮忙的啦！",
            "nextDialogs": [
              "732120107"
            ]
          },
          "732120107": {
            "id": "732120107",
            "speakerId": 4294,
            "speakerName": "尤夫腾",
            "text": "是我的一批、一批、一批货物…丢失了。",
            "nextDialogs": [
              "732120108"
            ]
          },
          "732120108": {
            "id": "732120108",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "居然丢了三批货物呢！",
            "nextDialogs": [
              "732120109"
            ]
          },
          "732120109": {
            "id": "732120109",
            "speakerId": 4294,
            "speakerName": "尤夫腾",
            "text": "不，是一、一、一批…货物。",
            "nextDialogs": [
              "732120110"
            ]
          },
          "732120110": {
            "id": "732120110",
            "speakerId": 4294,
            "speakerName": "尤夫腾",
            "text": "外人运进来的「丰沃之惠」，已经很、很久了，但没、没有到货…",
            "nextDialogs": [
              "732120111"
            ]
          },
          "732120111": {
            "id": "732120111",
            "speakerId": 4294,
            "speakerName": "尤夫腾",
            "text": "可能是那些北、北方人搞的鬼…因为芭别尔主母一直在针对他们，搜、搜捕叛徒什么的…",
            "nextDialogs": [
              "732120112"
            ]
          },
          "732120112": {
            "id": "732120112",
            "speakerId": 4294,
            "speakerName": "尤夫腾",
            "text": "自从、自从阿德菲和阿萨里格不在了以后…他们的活动也多起来了。",
            "nextDialogs": [
              "732120113"
            ]
          },
          "732120113": {
            "id": "732120113",
            "speakerId": 4294,
            "speakerName": "尤夫腾",
            "text": "好、好了，不多说别、别的闲话。运送「丰沃之惠」的商队最后是在、在这片区域被哨兵发现的…",
            "nextDialogs": [
              "732120114"
            ]
          },
          "732120114": {
            "id": "732120114",
            "speakerId": 4294,
            "speakerName": "尤夫腾",
            "text": "希望您能帮助我找、找、找到货物，或者至少、至少、至少…将商队留下的线索告知我。",
            "nextDialogs": [
              "732120115"
            ]
          },
          "732120115": {
            "id": "732120115",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "好的，我会帮忙的。",
            "nextDialogs": [
              "732120116"
            ]
          },
          "732120116": {
            "id": "732120116",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "商队自己就不见了？听起来是被坏家伙打劫了呢…",
            "nextDialogs": [
              "732120117"
            ]
          },
          "732120117": {
            "id": "732120117",
            "speakerId": 4294,
            "speakerName": "尤夫腾",
            "text": "十分、十分、十分感谢，这些肉请您收下吧。",
            "nextDialogs": [
              "732120118"
            ]
          },
          "732120118": {
            "id": "732120118",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "你太客气啦！"
          },
          "732120106": {
            "id": "732120106",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "慢慢说啦，不要着急！"
          }
        }
      }
    },
    {
      "subId": "7321202",
      "subQuestName": "前往商队最后出现的地点",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [],
        "dialogs": {}
      }
    },
    {
      "subId": "7321203",
      "subQuestName": "调查该地点",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "732120501"
        ],
        "dialogs": {
          "732120501": {
            "id": "732120501",
            "speakerId": 1002,
            "speakerName": "破损的罐子",
            "text": "（一个破损的空罐，尚未完全被沙子掩埋。看起来它是在不久前被人丢弃的。）",
            "nextDialogs": [
              "732120502"
            ]
          },
          "732120502": {
            "id": "732120502",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "你看！这个罐子还没有被沙子掩埋呢！",
            "nextDialogs": [
              "732120504",
              "732120506"
            ]
          },
          "732120504": {
            "id": "732120504",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "看起来很不妙呢…说不定他们顺路还遗落了其他东西，我们再往前找找看吧？"
          },
          "732120506": {
            "id": "732120506",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "嗯…他们应该还沿途丢弃了其他东西，我们继续往前走走看看吧！"
          }
        }
      }
    },
    {
      "subId": "7321204",
      "subQuestName": "沿途调查线索",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "732120601"
        ],
        "dialogs": {
          "732120601": {
            "id": "732120601",
            "speakerId": 1003,
            "speakerName": "破裂的空木箱",
            "text": "（空空如也的破木箱，被人随意地丢弃在这里，无力地倒在路边。）",
            "nextDialogs": [
              "732120602"
            ]
          },
          "732120602": {
            "id": "732120602",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "咦，这个木箱一定是车队的吧，上面有部落的标志呢！",
            "nextDialogs": [
              "732120603"
            ]
          },
          "732120603": {
            "id": "732120603",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "这里的地形很适合伏击。",
            "nextDialogs": [
              "732120604"
            ]
          },
          "732120604": {
            "id": "732120604",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "说得是呢…这个位置，一看就很凶险！",
            "nextDialogs": [
              "732120605"
            ]
          },
          "732120605": {
            "id": "732120605",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "就连大件物资也被抢夺一空了…",
            "nextDialogs": [
              "732120606"
            ]
          },
          "732120606": {
            "id": "732120606",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "他们搬走了物资，但是留下了空箱子…嗯，他们的人数应该不少，而且缺少搬运木箱的工具。",
            "nextDialogs": [
              "732120607"
            ]
          },
          "732120607": {
            "id": "732120607",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "或者，这是他们的计谋…",
            "nextDialogs": [
              "732120608"
            ]
          },
          "732120608": {
            "id": "732120608",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "欸…？计谋？",
            "nextDialogs": [
              "732120609"
            ]
          },
          "732120609": {
            "id": "732120609",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "难道这些空箱是他们故意留下来的…为了引人上钩吗？",
            "nextDialogs": [
              "732120610"
            ]
          },
          "732120610": {
            "id": "732120610",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "为了引我们上钩。",
            "nextDialogs": [
              "732120611"
            ]
          },
          "732120611": {
            "id": "732120611",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "呜哇…我汗毛都要起来了！那我们还要不要继续往前探查呀…",
            "nextDialogs": [
              "732120613",
              "732120615"
            ]
          },
          "732120613": {
            "id": "732120613",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "我不要，谁说我害怕啦！哼…况且你也一定离不开我呀！"
          },
          "732120615": {
            "id": "732120615",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "唔，你说的好可怕…哼，但既然你都不怕，我们就继续顺着道路探查吧。"
          }
        }
      }
    },
    {
      "subId": "7321214",
      "subQuestName": "沿途调查线索",
      "sceneId": null,

    {
      "subId": "7321216",
      "subQuestName": "与派蒙对话",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [],
        "dialogs": {}
      }
    },
    {
      "subId": "7321209",
      "subQuestName": "与派蒙对话",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "732120901"
        ],
        "dialogs": {
          "732120901": {
            "id": "732120901",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "呜…好险！还好我们超能打，三下五除二就…就把他们全解决了！",
            "nextDialogs": [
              "732120902"
            ]
          },
          "732120902": {
            "id": "732120902",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "谢谢「招待」。",
            "nextDialogs": [
              "732120903"
            ]
          },
          "732120903": {
            "id": "732120903",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "为什么每个坏蛋都喜欢招惹我们！是因为我们看起来很好欺负吗？",
            "nextDialogs": [
              "732120904"
            ]
          },
          "732120904": {
            "id": "732120904",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "他们自称是婕德指使的…",
            "nextDialogs": [
              "732120905"
            ]
          },
          "732120905": {
            "id": "732120905",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "……",
            "nextDialogs": [
              "732120906"
            ]
          },
          "732120906": {
            "id": "732120906",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "你相信他们说的话吗？",
            "nextDialogs": [
              "732120907"
            ]
          },
          "732120907": {
            "id": "732120907",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "我不相信婕德有理由做这样的事。",
            "nextDialogs": [
              "732120908"
            ]
          },
          "732120908": {
            "id": "732120908",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "但肯定她被卷入了某个更大的阴谋…",
            "nextDialogs": [
              "732120909"
            ]
          },
          "732120909": {
            "id": "732120909",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "唔…我也相信婕德是不会做这种事的…不过，现在我们怎么办呀？",
            "nextDialogs": [
              "732120910"
            ]
          },
          "732120910": {
            "id": "732120910",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "袭击我们的人认识婕德，也就是说在塔尼特部落里一定也有他们的人…",
            "nextDialogs": [
              "732120911"
            ]
          },
          "732120911": {
            "id": "732120911",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "这样的话，我们回到部落就很有可能会被他们盯上，他们一定是不会善罢甘休的。",
            "nextDialogs": [
              "732120912"
            ]
          },
          "732120912": {
            "id": "732120912",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "而且婕德…我也不愿意怀疑她啦，但…既然想要谋害我们的人就在塔尼特部落里，我们不如先走为上策吧…？",
            "nextDialogs": [
              "732120913"
            ]
          },
          "732120913": {
            "id": "732120913",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "我们离开的话，婕德可能会有危险。",
            "nextDialogs": [
              "732120914"
            ]
          },
          "732120914": {
            "id": "732120914",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "唔，也对呢…我们不能抛下她不管呀。",
            "nextDialogs": [
              "732120915"
            ]
          },
          "732120915": {
            "id": "732120915",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "我们先回去，但不要提及婕德。",
            "nextDialogs": [
              "732120916"
            ]
          },
          "732120916": {
            "id": "732120916",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "欸…？可是…",
            "nextDialogs": [
              "732120917"
            ]
          },
          "732120917": {
            "id": "732120917",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "哼…我才没有害怕呢！既然你这样决定了，那就这样吧！"
          }
        }
      }
    },
    {
      "subId": "7321210",
      "subQuestName": "向尤夫腾回报调查结果",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "732121001"
        ],
        "dialogs": {
          "732121001": {
            "id": "732121001",
            "speakerId": 4294,
            "speakerName": "尤夫腾",
            "text": "你、你、你们回来了？",
            "nextDialogs": [
              "732121002"
            ]
          },
          "732121002": {
            "id": "732121002",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "怎么啦，我们能回来很奇怪吗！",
            "nextDialogs": [
              "732121003"
            ]
          },
          "732121003": {
            "id": "732121003",
            "speakerId": 4294,
            "speakerName": "尤夫腾",
            "text": "不、不、没有，很高兴你们能回来，尊、尊贵的「镇灵主人」。",
            "nextDialogs": [
              "732121004"
            ]
          },
          "732121004": {
            "id": "732121004",
            "speakerId": 4294,
            "speakerName": "尤夫腾",
            "text": "对、对了，关、关、关、关于商队的事情…你们调查得如何了？",
            "nextDialogs": [
              "732121005"
            ]
          },
          "732121005": {
            "id": "732121005",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "商队遭到了伏击，货物被洗劫了。",
            "nextDialogs": [
              "732121006"
            ]
          },
          "732121006": {
            "id": "732121006",
            "speakerId": 4294,
            "speakerName": "尤夫腾",
            "text": "可恶！可恶！又是那群叛徒搞的鬼！一、一定、一定是的！",
            "nextDialogs": [
              "732121007"
            ]
          },
          "732121007": {
            "id": "732121007",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "叛徒…？",
            "nextDialogs": [
              "732121008"
            ]
          },
          "732121008": {
            "id": "732121008",
            "speakerId": 4294,
            "speakerName": "尤夫腾",
            "text": "叛、叛、叛徒，和北方人勾结的狗！",
            "nextDialogs": [
              "732121009"
            ]
          },
          "732121009": {
            "id": "732121009",
            "speakerId": 4294,
            "speakerName": "尤夫腾",
            "text": "除了、除了这个，你、你、你们还发现了什么吗？",
            "nextDialogs": [
              "732121010"
            ]
          },
          "732121010": {
            "id": "732121010",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "我们遭到了镀金旅团的袭击。",
            "nextDialogs": [
              "732121011"
            ]
          },
          "732121011": {
            "id": "732121011",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "嗯，我们刚调查完商队，就被突然出现的镀金旅团坏家伙袭击了！他们还说是…",
            "nextDialogs": [
              "732121012"
            ]
          },
          "732121012": {
            "id": "732121012",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "他们还说他们认识我们。",
            "nextDialogs": [
              "732121013"
            ]
          },
          "732121013": {
            "id": "732121013",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "呃…对！",
            "nextDialogs": [
              "732121014"
            ]
          },
          "732121014": {
            "id": "732121014",
            "speakerId": 4294,
            "speakerName": "尤夫腾",
            "text": "……",
            "nextDialogs": [
              "732121015"
            ]
          },
          "732121015": {
            "id": "732121015",
            "speakerId": 4294,
            "speakerName": "尤夫腾",
            "text": "果、果、果然如此…他们也盯上了您。",
            "nextDialogs": [
              "732121016"
            ]
          },
          "732121016": {
            "id": "732121016",
            "speakerId": 4294,
            "speakerName": "尤夫腾",
            "text": "这里是您的报、报、报酬。请、请快点去和芭别尔主母说说这件事吧，事、事、事不宜迟！",
            "nextDialogs": [
              "732121017"
            ]
          },
          "732121017": {
            "id": "732121017",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "好、好的。",
            "nextDialogs": [
              "732121018"
            ]
          },
          "732121018": {
            "id": "732121018",
            "speakerId": 4294,
            "speakerName": "尤夫腾",
            "text": "再、再见。尊贵的「镇灵主人」。"
          }
        }
      }
    },
    {
      "subId": "7321211",
      "subQuestName": "向芭别尔回报情况",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "732121101"
        ],
        "dialogs": {
          "732121101": {
            "id": "732121101",
            "speakerId": 4291,
            "speakerName": "芭别尔",
            "text": "你来了，尊贵的「镇灵主人」，请问有什么急事吗？",
            "nextDialogs": [
              "732121102"
            ]
          },
          "732121102": {
            "id": "732121102",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "尤夫腾的商队被「叛徒」洗劫了。",
            "nextDialogs": [
              "732121103"
            ]
          },
          "732121103": {
            "id": "732121103",
            "speakerId": 4291,
            "speakerName": "芭别尔",
            "text": "这样吗…这并不奇怪，因为从雪国而来的北方人一直在渗透我们的领地，许多叛徒听信了他们的诱惑，转而与我们为敌。",
            "nextDialogs": [
              "732121104"
            ]
          },
          "732121104": {
            "id": "732121104",
            "speakerId": 4291,
            "speakerName": "芭别尔",
            "text": "这些人一直在作乱，零星的劫掠事件时有发生，从几个月前就是如此了…",
            "nextDialogs": [
              "732121105"
            ]
          },
          "732121105": {
            "id": "732121105",
            "speakerId": 4291,
            "speakerName": "芭别尔",
            "text": "呃…抱歉，我没想故意打断你，请你继续。",
            "nextDialogs": [
              "732121106"
            ]
          },
          "732121106": {
            "id": "732121106",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "那些「叛徒」也盯上了我们。",
            "nextDialogs": [
              "732121107"
            ]
          },
          "732121107": {
            "id": "732121107",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "嗯，我们刚调查完商队，镀金旅团坏家伙就突然出现，袭击了我们！",
            "nextDialogs": [
              "732121108"
            ]
          },
          "732121108": {
            "id": "732121108",
            "speakerId": 4291,
            "speakerName": "芭别尔",
            "text": "这样吗…可恶啊。",
            "nextDialogs": [
              "732121109"
            ]
          },
          "732121109": {
            "id": "732121109",
            "speakerId": 4291,
            "speakerName": "芭别尔",
            "text": "看起来…即使失去了阿德菲和阿萨里格，这群野狗依然敢对我们吐露獠牙。",
            "nextDialogs": [
              "732121110"
            ]
          },
          "732121110": {
            "id": "732121110",
            "speakerId": 4291,
            "speakerName": "芭别尔",
            "text": "这样吧，请你们先留在这里休息压惊，你们的安全保护工作我会亲自负责。",
            "nextDialogs": [
              "732121111"
            ]
          },
          "732121111": {
            "id": "732121111",
            "speakerId": 4291,
            "speakerName": "芭别尔",
            "text": "婕德还在外面执行部落的任务，待她回来，我会委托她同你一起调查此事。",
            "nextDialogs": [
              "732121112"
            ]
          },
          "732121112": {
            "id": "732121112",
            "speakerId": 4291,
            "speakerName": "芭别尔",
            "text": "而在这之前，我会负责全力追查袭击你们的凶手…请你们宽心。",
            "nextDialogs": [
              "732121113"
            ]
          },
          "732121113": {
            "id": "732121113",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "唔…还有还有！拦截我们的那群坏东西似乎认识我们！他们可能是部落里的人呢！",
            "nextDialogs": [
              "732121114"
            ]
          },
          "732121114": {
            "id": "732121114",
            "speakerId": 4291,
            "speakerName": "芭别尔",
            "text": "不是没有可能…但没关系，你们受宾客权利保护…只要还在这里，就没有人会伤害你们。",
            "nextDialogs": [
              "732121115"
            ]
          },
          "732121115": {
            "id": "732121115",
            "speakerId": 4291,
            "speakerName": "芭别尔",
            "text": "如果有人试图在塔尼特部落内为难你们，无论那人是谁，我都会以主母的身份追究到底。",
            "nextDialogs": [
              "732121116"
            ]
          },
          "732121116": {
            "id": "732121116",
            "speakerId": 4291,
            "speakerName": "芭别尔",
            "text": "请你休息一下吧，关于叛徒的事件，我会全力追查的。",
            "nextDialogs": [
              "732121117"
            ]
          },
          "732121117": {
            "id": "732121117",
            "speakerId": 4291,
            "speakerName": "芭别尔",
            "text": "另外，我也会替你留意婕德的，等她回来就第一时间通知你们。",
            "nextDialogs": [
              "732121118"
            ]
          },
          "732121118": {
            "id": "732121118",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "嗯嗯，那就谢谢你啦，芭别尔主母！",
            "nextDialogs": [
              "732121119"
            ]
          },
          "732121119": {
            "id": "732121119",
            "speakerId": 4291,
            "speakerName": "芭别尔",
            "text": "请不必客气。"
          }
        }
      }
    },
    {
      "subId": "7321203",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "732120301"
        ],
        "dialogs": {
          "732120301": {
            "id": "732120301",
            "speakerId": 4294,
            "speakerName": "尤夫腾",
            "text": "怎么，有、有、有何进展？",
            "nextDialogs": [
              "732120302"
            ]
          },
          "732120302": {
            "id": "732120302",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "我们还在调查失踪的商队。",
            "nextDialogs": [
              "732120303"
            ]
          },
          "732120303": {
            "id": "732120303",
            "speakerId": 4294,
            "speakerName": "尤夫腾",
            "text": "请、请、请尽快调查吧，我请求您。"
          }
        }
      }
    },
    {
      "subId": "7321204",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "732120401"
        ],
        "dialogs": {
          "732120401": {
            "id": "732120401",
            "speakerId": 16694,
            "speakerName": "婕德",
            "text": "#{NICKNAME}！你好呀！",
            "nextDialogs": [
              "732120402"
            ]
          },
          "732120402": {
            "id": "732120402",
            "speakerId": 16694,
            "speakerName": "婕德",
            "text": "很感谢你能陪我一起去冒险，关于我父母的事…谢谢你。",
            "nextDialogs": [
              "732120403"
            ]
          },
          "732120403": {
            "id": "732120403",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "请不用这么客气。",
            "nextDialogs": [
              "732120404"
            ]
          },
          "732120404": {
            "id": "732120404",
            "speakerId": 16694,
            "speakerName": "婕德",
            "text": "嘿嘿，如果不是芭别尔主母还委托了其他任务，我就也陪你一起去沙漠里探险啦。",
            "nextDialogs": [
              "732120405"
            ]
          },
          "732120405": {
            "id": "732120405",
            "speakerId": 16694,
            "speakerName": "婕德",
            "text": "我还知道好多好玩的地方，等我有时间就带你们一起去！",
            "nextDialogs": [
              "732120406"
            ]
          },
          "732120406": {
            "id": "732120406",
            "speakerId": 16694,
            "speakerName": "婕德",
            "text": "不过现在怕是不方便咯，那些勾结北方人的叛徒一直在觊觎着我们的领地，我还要侦察他们的动向才行。"
          }
        }
      }
    },
    {
      "subId": "7321217",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "732121701"
        ],
        "dialogs": {
          "732121701": {
            "id": "732121701",
            "speakerId": 4291,
            "speakerName": "芭别尔",
            "text": "你好，尊贵的镇灵主人。",
            "nextDialogs": [
              "732121702"
            ]
          },
          "732121702": {
            "id": "732121702",
            "speakerId": 4291,
            "speakerName": "芭别尔",
            "text": "关于你们上次遇袭的事情，我还正在追查，请你们一定放心。",
            "nextDialogs": [
              "732121703"
            ]
          },
          "732121703": {
            "id": "732121703",
            "speakerId": 4291,
            "speakerName": "芭别尔",
            "text": "我保证你们在塔尼特部族内的安全，但如果进入沙漠…还请万分小心。",
            "nextDialogs": [
              "732121705",
              "732121712",
              "732121715",
              "732121722"
            ]
          },
          "732121705": {
            "id": "732121705",
            "speakerId": 4291,
            "speakerName": "芭别尔",
            "text": "请容我代表塔尼特部族再次感谢你们和婕德的付出…",
            "nextDialogs": [
              "732121706"
            ]
          },
          "732121706": {
            "id": "732121706",
            "speakerId": 4291,
            "speakerName": "芭别尔",
            "text": "「永恒绿洲」不仅对那孩子有重要的意义，对于塔尼特部族，它也是信仰的中心。",
            "nextDialogs": [
              "732121707"
            ]
          },
          "732121707": {
            "id": "732121707",
            "speakerId": 4291,
            "speakerName": "芭别尔",
            "text": "拥有它，就是拥有了「绿洲女王」娜布·玛莉卡塔的王座…对于曾属于她的子民之后代来说，意义重大。",
            "nextDialogs": [
              "732121708"
            ]
          },
          "732121708": {
            "id": "732121708",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "我不太明白…它究竟有什么价值？",
            "nextDialogs": [
              "732121709"
            ]
          },
          "732121709": {
            "id": "732121709",
            "speakerId": 4291,
            "speakerName": "芭别尔",
            "text": "哈哈，毫无价值…",
            "nextDialogs": [
              "732121710"
            ]
          },
          "732121710": {
            "id": "732121710",
            "speakerId": 4291,
            "speakerName": "芭别尔",
            "text": "…价值非凡。"
          },
          "732121712": {
            "id": "732121712",
            "speakerId": 4291,
            "speakerName": "芭别尔",
            "text": "是啊，既然我们已经控制了「永恒绿洲」，就要阻止其他怀有非分之想的家伙靠近。塔尼特如今是「永恒绿洲」的卫士。",
            "nextDialogs": [
              "732121713"
            ]
          },
          "732121713": {
            "id": "732121713",
            "speakerId": 4291,
            "speakerName": "芭别尔",
            "text": "而最适合完成这等任务的，我想是婕德无疑了。她也是在守护自己的父母，不是吗？"
          },
          "732121715": {
            "id": "732121715",
            "speakerId": 4291,
            "speakerName": "芭别尔",
            "text": "我猜是因为我们打开了通往「永恒绿洲」的道路，那些叛徒们才又开始蠢蠢欲动起来了。",
            "nextDialogs": [
              "732121716"
            ]
          },
          "732121716": {
            "id": "732121716",
            "speakerId": 4291,
            "speakerName": "芭别尔",
            "text": "我们的女神，对于他们来说是至高权力的标志，也能给他们带来无数财源…我无法容忍这种亵渎，不论她是睡着，还是醒着。"
          },
          "732121722": {
            "id": "732121722",
            "speakerId": 4291,
            "speakerName": "芭别尔",
            "text": "保重，尊贵的「镇灵主人。」"
          }
        }
      }
    },
    {
      "subId": "7321299",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "732129901"
        ],
        "dialogs": {
          "732129901": {
            "id": "732129901",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "按照尤夫腾在地图上标的记号，应该就是这里没错啦！",
            "nextDialogs": [
              "732129902"
            ]
          },
          "732129902": {
            "id": "732129902",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "我们在附近查看一下吧，说不定商队留下了什么线索呢！",
            "nextDialogs": [
              "732129904"
            ]
          },
          "732129904": {
            "id": "732129904",
            "speakerId": 1005,

    {
      "subId": "4003401",
      "subQuestName": "前往万端珊瑚侦探社",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "400340102"
        ],
        "dialogs": {
          "400340102": {
            "id": "400340102",
            "speakerId": 1000,
            "speakerName": "珊瑚",
            "text": "嗯，你们果然来了。",
            "nextDialogs": [
              "400340103"
            ]
          },
          "400340103": {
            "id": "400340103",
            "speakerId": 1000,
            "speakerName": "珊瑚",
            "text": "龙二的话，按照目前收集到的线索和我的推理，他已经去八酝岛调查了。",
            "nextDialogs": [
              "400340104"
            ]
          },
          "400340104": {
            "id": "400340104",
            "speakerId": 1000,
            "speakerName": "珊瑚",
            "text": "我把方位标记在你的地图上，如果你赶紧动身，应该还可以和他会合。",
            "nextDialogs": [
              "400340105"
            ]
          },
          "400340105": {
            "id": "400340105",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "怎么突然这么急急忙忙的，之前不还在侦探社等我们一起的吗？",
            "nextDialogs": [
              "400340106"
            ]
          },
          "400340106": {
            "id": "400340106",
            "speakerId": 1000,
            "speakerName": "珊瑚",
            "text": "因为已经接近尾声了。你们也快点动身，一同见证真相的浮现吧。",
            "nextDialogs": [
              "400340107"
            ]
          },
          "400340107": {
            "id": "400340107",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "#这么一说，我也有点迫不及待了。我们快走吧，{NICKNAME}。"
          }
        }
      }
    },
    {
      "subId": "4003402",
      "subQuestName": "寻找龙二并与龙二对话",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "400340201"
        ],
        "dialogs": {
          "400340201": {
            "id": "400340201",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "龙二！我们来了！",
            "nextDialogs": [
              "400340202"
            ]
          },
          "400340202": {
            "id": "400340202",
            "speakerId": 1002,
            "speakerName": "龙二",
            "text": "啊，是你们。珊瑚社长让我先过来调查，说你们晚点就会过来。果然如此。",
            "nextDialogs": [
              "400340203"
            ]
          },
          "400340203": {
            "id": "400340203",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "还多亏了她告诉我们，你在这里呢！龙二调查得怎么样啦？",
            "nextDialogs": [
              "400340204"
            ]
          },
          "400340204": {
            "id": "400340204",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "咦，这里怎么都是些关着小动物的笼子，没有人吗？",
            "nextDialogs": [
              "400340205"
            ]
          },
          "400340205": {
            "id": "400340205",
            "speakerId": 1002,
            "speakerName": "龙二",
            "text": "刚刚走开了，是盗宝团。珊瑚社长告诉我，他们打算偷狗来训练成「寻宝犬」。",
            "nextDialogs": [
              "400340207",
              "400340209"
            ]
          },
          "400340207": {
            "id": "400340207",
            "speakerId": 1002,
            "speakerName": "龙二",
            "text": "没错，就像盗宝鼬。只不过鼬因为太过调皮，不服管教，所以失败了。这次，他们就以更加忠心的「狗」为目标。",
            "nextDialogs": [
              "400340210"
            ]
          },
          "400340210": {
            "id": "400340210",
            "speakerId": 1002,
            "speakerName": "龙二",
            "text": "以前处理过不少盗宝团的相关委托。这么一想，珊瑚社长说得果然没错。",
            "nextDialogs": [
              "400340211"
            ]
          },
          "400340211": {
            "id": "400340211",
            "speakerId": 1002,
            "speakerName": "龙二",
            "text": "就像人有脚印，组织也会留下自己独有的痕迹。整个事件中，虽然有着其他迷失、被困的小动物，但痕迹最终还是指向了盗宝团。",
            "nextDialogs": [
              "400340212"
            ]
          },
          "400340212": {
            "id": "400340212",
            "speakerId": 1002,
            "speakerName": "龙二",
            "text": "参考了一下当时的解决办法，然后我就调查到了这里。",
            "nextDialogs": [
              "400340213"
            ]
          },
          "400340213": {
            "id": "400340213",
            "speakerId": 1002,
            "speakerName": "龙二",
            "text": "不过居然不派个人留守，比起之前的案件，这次的作案者们心也太大了。",
            "nextDialogs": [
              "400340214"
            ]
          },
          "400340214": {
            "id": "400340214",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "#嗯，真是一群心大的坏家伙！不过嘛，{NICKNAME}，你打了这么多天架也累了吧？"
          },
          "400340209": {
            "id": "400340209",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "喂！"
          }
        }
      }
    },
    {
      "subId": "4003403",
      "subQuestName": "打开笼子",
      "sceneId": null,
      "locations": [],

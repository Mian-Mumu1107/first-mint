    {
      "subId": "4003406",
      "subQuestName": "奇怪的狗狗",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "400340601"
        ],
        "dialogs": {
          "400340601": {
            "id": "400340601",
            "speakerId": 1003,
            "speakerName": "？？？",
            "text": "……",
            "nextDialogs": [
              "400340602"
            ]
          },
          "400340602": {
            "id": "400340602",
            "speakerId": 1003,
            "speakerName": "？？？",
            "text": "汪呜！",
            "nextDialogs": [
              "400340603"
            ]
          },
          "400340603": {
            "id": "400340603",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "这、这是…",
            "nextDialogs": [
              "400340605",
              "400340607"
            ]
          },
          "400340605": {
            "id": "400340605",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "才不是啦！这算什么外号啦！",
            "nextDialogs": [
              "400340609"
            ]
          },
          "400340609": {
            "id": "400340609",
            "speakerId": 1002,
            "speakerName": "龙二",
            "text": "不管怎么说，好像没有攻击我们的意思…",
            "nextDialogs": [
              "400340610"
            ]
          },
          "400340610": {
            "id": "400340610",
            "speakerId": 1003,
            "speakerName": "？？？",
            "text": "汪汪——",
            "nextDialogs": [
              "400340611"
            ]
          },
          "400340611": {
            "id": "400340611",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "呜哇，它跑了。",
            "nextDialogs": [
              "400340612"
            ]
          },
          "400340612": {
            "id": "400340612",
            "speakerId": 1002,
            "speakerName": "龙二",
            "text": "边跑边回头看我们，或许是让我们跟上去的意思？",
            "nextDialogs": [
              "400340613"
            ]
          },
          "400340613": {
            "id": "400340613",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "我们快跟上吧。",
            "nextDialogs": [
              "400340614"
            ]
          },
          "400340614": {
            "id": "400340614",
            "speakerId": 1002,
            "speakerName": "龙二",
            "text": "嗯，说不定真相就在前面…或许就如同珊瑚社长预料的那样…"
          },
          "400340607": {
            "id": "400340607",
            "speakerId": 1002,
            "speakerName": "龙二",
            "text": "是帽子狗才对！"
          }
        }
      }
    },
    {
      "subId": "4003407",
      "subQuestName": "跟上跑开的狗狗",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [],
        "dialogs": {}
      }
    },
    {
      "subId": "4003411",
      "subQuestName": "读信",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "400341101"
        ],
        "dialogs": {
          "400341101": {
            "id": "400341101",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "呼——终于追上了。",
            "nextDialogs": [
              "400341102"
            ]
          },
          "400341102": {
            "id": "400341102",
            "speakerId": 1002,
            "speakerName": "龙二",
            "text": "嗯？它面前的是…一封信？",
            "nextDialogs": [
              "400341103"
            ]
          },
          "400341103": {
            "id": "400341103",
            "speakerId": 1002,
            "speakerName": "龙二",
            "text": "我们先看看吧，这是目前唯一的线索了。",
            "nextDialogs": [
              "400341104"
            ]
          },
          "400341104": {
            "id": "400341104",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "嗯！让我看看，里面写的是什么……",
            "nextDialogs": [
              "400341105"
            ]
          },
          "400341105": {
            "id": "400341105",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "「致有缘…」呃，太破了看不清楚。",
            "nextDialogs": [
              "400341106"
            ]
          },
          "400341106": {
            "id": "400341106",
            "speakerId": 1002,
            "speakerName": "龙二",
            "text": "可能是「致有缘之人」吧。",
            "nextDialogs": [
              "400341107"
            ]
          },
          "400341107": {
            "id": "400341107",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "哦哦，然后是…「我们家是专门训练忍犬的世家，为忍者们带来了许许多多可靠的伙伴。」",
            "nextDialogs": [
              "400341108"
            ]
          },
          "400341108": {
            "id": "400341108",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "「……此番征兵令下来，怕是凶多吉少。我此生没什么遗憾，唯一放心不下的只有影狼丸。」",
            "nextDialogs": [
              "400341109"
            ]
          },
          "400341109": {
            "id": "400341109",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "「小时候，它太弱了，所以忍者们来进行契约的时候，它被剩了下来。但是没关系，身为训练师，我不会放弃任何一只狗。」",
            "nextDialogs": [
              "400341110"
            ]
          },
          "400341110": {
            "id": "400341110",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "「经过日复一日的努力，影狼丸真的变得越来越厉害了。只可惜，它完全不想和任何忍者契约。」",
            "nextDialogs": [
              "400341111"
            ]
          },
          "400341111": {
            "id": "400341111",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "「虽然战争还未开始，但奉行所的催促越来越急，我已无暇顾及其他，现在到了不得不离开的时候了。」",
            "nextDialogs": [
              "400341112"
            ]
          },
          "400341112": {
            "id": "400341112",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "「只好留下这一封信，若是日后有人能找到这里，请代替我照顾一下影狼丸。」",
            "nextDialogs": [
              "400341113"
            ]
          },
          "400341113": {
            "id": "400341113",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "「它脸上有一道疤痕，是年幼时留下的，气场也与其他普通狗狗不同，很好辨认。」",
            "nextDialogs": [
              "400341114"
            ]
          },
          "400341114": {
            "id": "400341114",
            "speakerId": 1002,
            "speakerName": "龙二",
            "text": "信里说的这只影狼丸应该就是…",
            "nextDialogs": [
              "400341115"
            ]
          },
          "400341115": {
            "id": "400341115",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "带我们来的这只。",
            "nextDialogs": [
              "400341116"
            ]
          },
          "400341116": {
            "id": "400341116",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "确实很好辨认呢！信上还有行内容，我看看…",
            "nextDialogs": [
              "400341117"
            ]
          },
          "400341117": {
            "id": "400341117",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "「我知道这是不情之请，但也实在没有别的办法。还有，若是今后它愿意契约了，能带着自己中意的人来到这里的话，那么契约方法是…」",
            "nextDialogs": [
              "400341118"
            ]
          },
          "400341118": {
            "id": "400341118",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "哎呀，最重要的地方怎么划掉了！",
            "nextDialogs": [
              "400341119"
            ]
          },
          "400341119": {
            "id": "400341119",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "大概是觉得不可能吧。",
            "nextDialogs": [
              "400341120"
            ]
          },
          "400341120": {
            "id": "400341120",
            "speakerId": 1002,
            "speakerName": "龙二",
            "text": "的确，毕竟一开始影狼丸完全不想和人契约。",
            "nextDialogs": [
              "400341121"
            ]
          },
          "400341121": {
            "id": "400341121",
            "speakerId": 1004,
            "speakerName": "影狼丸",
            "text": "汪汪——",
            "nextDialogs": [
              "400341122"
            ]
          },
          "400341122": {
            "id": "400341122",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "#欸，它怎么又突然跑掉了，还往屋子里跑了。{NICKNAME}，快跟上吧。"
          }
        }
      }
    },
    {
      "subId": "4003408",
      "subQuestName": "跟上再次跑开的影狼丸",
      "sceneId": null,
      "locations": [],

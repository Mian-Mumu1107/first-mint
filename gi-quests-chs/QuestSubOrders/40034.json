    {
      "subId": "4003404",
      "subQuestName": "打开笼子以后",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "400340401"
        ],
        "dialogs": {
          "400340401": {
            "id": "400340401",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "奇怪，这只狗狗怎么不走？",
            "nextDialogs": [
              "400340402"
            ]
          },
          "400340402": {
            "id": "400340402",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "是病了吗？"
          }
        }
      }
    },

    {
      "subId": "4003412",
      "subQuestName": "击败影狼丸",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [],
        "dialogs": {}
      }
    },
    {
      "subId": "4003409",
      "subQuestName": "与龙二对话",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "400340901"
        ],
        "dialogs": {
          "400340901": {
            "id": "400340901",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "#呼，总算结束了。真是搞不懂，怎么突然就开始战斗了，明明影狼丸之前看起来还挺友好的，还好有{NICKNAME}在。",
            "nextDialogs": [
              "400340902"
            ]
          },
          "400340902": {
            "id": "400340902",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "#咦，为什么影狼丸会跟着{NICKNAME}？",
            "nextDialogs": [
              "400340903"
            ]
          },
          "400340903": {
            "id": "400340903",
            "speakerId": 1004,
            "speakerName": "影狼丸",
            "text": "汪呜汪呜！",
            "nextDialogs": [
              "400340904"
            ]
          },
          "400340904": {
            "id": "400340904",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "这叫声好像听起来有点高兴？",
            "nextDialogs": [
              "400340905"
            ]
          },
          "400340905": {
            "id": "400340905",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "你怎么听出来的！我还一头雾水呢！",
            "nextDialogs": [
              "400340906"
            ]
          },
          "400340906": {
            "id": "400340906",
            "speakerId": 1002,
            "speakerName": "龙二",
            "text": "#如果我的猜想没错的话，影狼丸应该已经成为{NICKNAME}的忍犬了。",
            "nextDialogs": [
              "400340907"
            ]
          },
          "400340907": {
            "id": "400340907",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "欸！",
            "nextDialogs": [
              "400340908"
            ]
          },
          "400340908": {
            "id": "400340908",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "欸！",
            "nextDialogs": [
              "400340909"
            ]
          },
          "400340909": {
            "id": "400340909",
            "speakerId": 1002,
            "speakerName": "龙二",
            "text": "关于忍犬的契约方法，我也只是略有耳闻罢了。据说忍者看中忍犬后，需要打败它，才能得到忍犬的认可。",
            "nextDialogs": [
              "400340910"
            ]
          },
          "400340910": {
            "id": "400340910",
            "speakerId": 1002,
            "speakerName": "龙二",
            "text": "忍者渴望强大的伙伴，忍犬也是一样的，只有互相认可，才能完成契约。看来确实是这样子。",
            "nextDialogs": [
              "400340911"
            ]
          },
          "400340911": {
            "id": "400340911",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "#可是{NICKNAME}又不是忍者…而且…",
            "nextDialogs": [
              "400340912"
            ]
          },
          "400340912": {
            "id": "400340912",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "呜。",
            "nextDialogs": [
              "400340913"
            ]
          },
          "400340913": {
            "id": "400340913",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "派蒙怎么了？",
            "nextDialogs": [
              "400340914"
            ]
          },
          "400340914": {
            "id": "400340914",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "#{NICKNAME}，你先同意答应我一件事情！",
            "nextDialogs": [
              "400340915"
            ]
          },
          "400340915": {
            "id": "400340915",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "什么事情？",
            "nextDialogs": [
              "400340916"
            ]
          },
          "400340916": {
            "id": "400340916",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "你先说答应嘛！",
            "nextDialogs": [
              "400340917"
            ]
          },
          "400340917": {
            "id": "400340917",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "好吧，我答应你。",
            "nextDialogs": [
              "400340918"
            ]
          },
          "400340918": {
            "id": "400340918",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "就算你现在已经契约了影狼丸，你也不能忘记派蒙是你最最最好的伙伴哦！",
            "nextDialogs": [
              "400340919"
            ]
          },
          "400340919": {
            "id": "400340919",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "嗯，派蒙是我最好的伙伴。",
            "nextDialogs": [
              "400340920"
            ]
          },
          "400340920": {
            "id": "400340920",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "太好了！",
            "nextDialogs": [
              "400340923"
            ]
          },
          "400340923": {
            "id": "400340923",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "欸嘿嘿。我们永远都是最最最好的伙伴！",
            "nextDialogs": [
              "400340924"
            ]
          },
          "400340924": {
            "id": "400340924",
            "speakerId": 1002,
            "speakerName": "龙二",
            "text": "咳咳，两位关系真好…",
            "nextDialogs": [
              "400340925"
            ]
          },
          "400340925": {
            "id": "400340925",
            "speakerId": 1002,
            "speakerName": "龙二",
            "text": "不过话又说回来，既然影狼丸实力那么强，为什么之前那个人还要留信下来，让别人照顾它呢？",
            "nextDialogs": [
              "400340926"
            ]
          },
          "400340926": {
            "id": "400340926",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "#这个我知道哦！{NICKNAME}，很强对吧。",
            "nextDialogs": [
              "400340927"
            ]
          },
          "400340927": {
            "id": "400340927",
            "speakerId": 1002,
            "speakerName": "龙二",
            "text": "确实实力超群。",
            "nextDialogs": [
              "400340928"
            ]
          },
          "400340928": {
            "id": "400340928",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "#但是如果有一天，万一有什么意外，我不得不和{NICKNAME}分开，我也会很担心的。这和{NICKNAME}强不强，其实没什么关系啦。",
            "nextDialogs": [
              "400340929"
            ]
          },
          "400340929": {
            "id": "400340929",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "#呸呸，我在说什么不吉利的事情！总之只是打个比方！我和{NICKNAME}是最好的伙伴，我们是不会分开的！",
            "nextDialogs": [
              "400340930"
            ]
          },
          "400340930": {
            "id": "400340930",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "派蒙…",
            "nextDialogs": [
              "400340931"
            ]
          },
          "400340931": {
            "id": "400340931",
            "speakerId": 1002,
            "speakerName": "龙二",
            "text": "派蒙的推理很合理。那么接下来唯一的问题是，为什么这只狗狗会偷走村民们的小动物，并守着呢？",
            "nextDialogs": [
              "400340932"
            ]
          },
          "400340932": {
            "id": "400340932",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "呃…唔…这个机智的派蒙也想不出来了。",
            "nextDialogs": [
              "400340933"
            ]
          },
          "400340933": {
            "id": "400340933",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "#可惜，影狼丸也没办法说话，不然让{NICKNAME}去问问就知道了。",
            "nextDialogs": [
              "400340934"
            ]
          },
          "400340934": {
            "id": "400340934",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "我们去找找珊瑚吧。",
            "nextDialogs": [
              "400340935"
            ]
          },
          "400340935": {
            "id": "400340935",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "对哦，还有珊瑚！这个时候总该轮到头脑派出场了，我们去找她吧！",
            "nextDialogs": [
              "400340936"
            ]
          },
          "400340936": {
            "id": "400340936",
            "speakerId": 1002,
            "speakerName": "龙二",
            "text": "嗯，我先去把藏起来的小动物还回去，我们到时候侦探社汇合吧。"
          }
        }
      }
    },
    {
      "subId": "4003410",
      "subQuestName": "向珊瑚回报",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "400341001"
        ],
        "dialogs": {
          "400341001": {
            "id": "400341001",
            "speakerId": 1002,
            "speakerName": "龙二",
            "text": "珊瑚社长，我们回来了，事情是这样子的……",
            "nextDialogs": [
              "400341002"
            ]
          },
          "400341002": {
            "id": "400341002",
            "speakerId": 1000,
            "speakerName": "珊瑚",
            "text": "原来如此。我大概知道为什么影狼丸会守着小动物了。",
            "nextDialogs": [
              "400341003"
            ]
          },
          "400341003": {
            "id": "400341003",
            "speakerId": 1000,
            "speakerName": "珊瑚",
            "text": "是想要带着其他小动物变强吧。",
            "nextDialogs": [
              "400341004"
            ]
          },
          "400341004": {
            "id": "400341004",
            "speakerId": 1000,
            "speakerName": "珊瑚",
            "text": "它小的时候很弱，然后又变强了，对吧。所以它就想通过训练，也带着别的小动物变强。",
            "nextDialogs": [
              "400341005"
            ]
          },
          "400341005": {
            "id": "400341005",
            "speakerId": 1000,
            "speakerName": "珊瑚",
            "text": "后来它看到愿意保护弱小的旅行者之后，又认可了旅行者作为主人。",
            "nextDialogs": [
              "400341006"
            ]
          },
          "400341006": {
            "id": "400341006",
            "speakerId": 1000,
            "speakerName": "珊瑚",
            "text": "这也是出于它对弱小的同情心。",
            "nextDialogs": [
              "400341007"
            ]
          },
          "400341007": {
            "id": "400341007",
            "speakerId": 1000,
            "speakerName": "珊瑚",
            "text": "不过这只是我通过线索进行的推理罢了。",
            "nextDialogs": [
              "400341008"
            ]
          },
          "400341008": {
            "id": "400341008",
            "speakerId": 1000,
            "speakerName": "珊瑚",
            "text": "至于真实情况嘛，应该也八九不离十了。但由于影狼丸不会说话，我们也没办法得到一个肯定的回答了。",
            "nextDialogs": [
              "400341009"
            ]
          },
          "400341009": {
            "id": "400341009",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "珊瑚说话也很有道理呢！不愧是头脑派。",
            "nextDialogs": [
              "400341010"
            ]
          },
          "400341010": {
            "id": "400341010",
            "speakerId": 1004,
            "speakerName": "影狼丸",
            "text": "汪汪汪！",
            "nextDialogs": [
              "400341011"
            ]
          },
          "400341011": {
            "id": "400341011",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "呜哇，你也是在肯定珊瑚说的话吗？",
            "nextDialogs": [
              "400341012"
            ]
          },
          "400341012": {
            "id": "400341012",
            "speakerId": 1000,
            "speakerName": "珊瑚",
            "text": "不要以为奉承我，下次你们有委托的时候我就会打折哦。不过呢，这个案子算是办结了。",
            "nextDialogs": [
              "400341013"
            ]
          },
          "400341013": {
            "id": "400341013",
            "speakerId": 1002,
            "speakerName": "龙二",
            "text": "#感谢{NICKNAME}和派蒙，多亏了你们才能办结这个案子。",
            "nextDialogs": [
              "400341014"
            ]
          },
          "400341014": {
            "id": "400341014",
            "speakerId": 1000,
            "speakerName": "珊瑚",
            "text": "哦，差点忘了，「四方之网」你们用着感觉如何？",
            "nextDialogs": [
              "400341017"
            ]
          },
          "400341017": {
            "id": "400341017",
            "speakerId": 1000,
            "speakerName": "珊瑚",
            "text": "嗯，我记下来了。我会和我的那位朋友说的，谢啦。",
            "nextDialogs": [
              "400341018"
            ]
          },
          "400341018": {
            "id": "400341018",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "#不客气！以后有什么困难，随时来找我们哦！{NICKNAME}可厉害了！",
            "nextDialogs": [
              "400341019"
            ]
          },
          "400341019": {
            "id": "400341019",
            "speakerId": 1000,
            "speakerName": "珊瑚",
            "text": "旅行者确实实力不俗，但是不用和我说这些客套话，毕竟感情是真相的敌人。"
          }
        }
      }
    },
    {
      "subId": "4003451",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "400345101"
        ],
        "dialogs": {
          "400345101": {
            "id": "400345101",
            "speakerId": 1000,
            "speakerName": "珊瑚",
            "text": "这次的事件，已经快落下帷幕了…",
            "nextDialogs": [
              "400345102"
            ]
          },
          "400345102": {
            "id": "400345102",
            "speakerId": 1000,
            "speakerName": "珊瑚",
            "text": "应该叫什么名字好呢…「幻影犬主」？还是「盗宝团十二面相」…",
            "nextDialogs": [
              "400345103"
            ]
          },
          "400345103": {
            "id": "400345103",
            "speakerId": 1000,
            "speakerName": "珊瑚",
            "text": "给事件取名真难。下次去拜托八重堂的人好了。"
          }
        }
      }
    }
  ]
}
        "dialogs": {
          "710840201": {
            "id": "710840201",
            "speakerId": 2181,
            "speakerName": "《层岩巨渊矿产图鉴》",
            "text": "「…在巨渊深处漫长悠久的元素反应影响下，地表砂土亦呈奇妙的紫红色…」",
            "nextDialogs": [
              "710840202"
            ]
          },
          "710840202": {
            "id": "710840202",
            "speakerId": 2181,
            "speakerName": "《层岩巨渊矿产图鉴》",
            "text": "「…从中采取提炼而出的『琉璃晶砂』，亦拥有似乎并非来自此世的华美光泽…」",
            "nextDialogs": [
              "710840203"
            ]
          },
          "710840203": {
            "id": "710840203",
            "speakerId": 2181,
            "speakerName": "《层岩巨渊矿产图鉴》",
            "text": "「…璃月之瓷器因而为贵，全赖层岩巨渊之民提炼『琉璃晶砂』之传统…」"
          }
        }
      }
    },
    {
      "subId": "7109302",
      "subQuestName": "",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "710372701"
        ],
        "dialogs": {
          "710372701": {
            "id": "710372701",
            "speakerId": 2193,
            "speakerName": "《层岩巨渊矿产报告》",
            "text": "「…『流明石』之增生区域仍在扩大，似呈蔓延之势。流明晶石本身无毒无害，但其形成过程中却会吸收附近高价值矿石，加以转变…」",
            "nextDialogs": [
              "710372702"
            ]
          },
          "710372702": {
            "id": "710372702",
            "speakerId": 2193,
            "speakerName": "《层岩巨渊矿产报告》",
            "text": "「…按此增生势头，此种矿藏必将剧烈贬值，间以影响其他矿石产量。谨请辉山厅速速派遣专业人员研究其性质功用，以供长远之计…」"
          }
        }
      }
    },
    {
      "subId": "7109303",
      "subQuestName": "",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "710372801"
        ],
        "dialogs": {
          "710372801": {
            "id": "710372801",
            "speakerId": 2194,
            "speakerName": "《层岩巨渊「灵石」调查书》",
            "text": "「…矿工传说中的『灵石』、『愿望石』等，乃是出自层岩巨渊深处岩厅的神秘晶矿…」",
            "nextDialogs": [
              "710372802"
            ]
          },
          "710372802": {
            "id": "710372802",
            "speakerId": 2194,
            "speakerName": "《层岩巨渊「灵石」调查书》",
            "text": "「…取样表明其成分与提瓦特大陆上大部分矿产存在明显区别，且似有缓慢改变周边物质构造之趋势。或许与层岩巨渊古老传说中坠落的『天星』有关…」",
            "nextDialogs": [
              "710372803"
            ]
          },
          "710372803": {
            "id": "710372803",
            "speakerId": 2194,
            "speakerName": "《层岩巨渊「灵石」调查书》",
            "text": "「…又抑或，传说中深遁巨渊的『天星』正在更深处，等待人们发掘？…」"
          }
        }
      }
    }
  ]
}
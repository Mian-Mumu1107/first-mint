    {
      "subId": "7527801",
      "subQuestName": "后日谈$HIDDEN",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "752780101"
        ],
        "dialogs": {
          "752780101": {
            "id": "752780101",
            "speakerId": 1000,
            "speakerName": "？？？",
            "text": "两、两位！请你们留步！",
            "nextDialogs": [
              "752780102"
            ]
          },
          "752780102": {
            "id": "752780102",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "怎么啦，小妹妹，你有什么事儿吗？",
            "nextDialogs": [
              "752780103"
            ]
          },
          "752780103": {
            "id": "752780103",
            "speakerId": 1000,
            "speakerName": "？？？",
            "text": "「承载绽放刺梨的奇迹，用圣火点燃你的笑容！」",
            "nextDialogs": [
              "752780104"
            ]
          },
          "752780104": {
            "id": "752780104",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "欸、欸？",
            "nextDialogs": [
              "752780105"
            ]
          },
          "752780105": {
            "id": "752780105",
            "speakerId": 1000,
            "speakerName": "？？？",
            "text": "「以悠悠度假村之名，为你献上欢迎的舞蹈，闪耀吧！皮皮潘偶像！」",
            "nextDialogs": [
              "752780106"
            ]
          },
          "752780106": {
            "id": "752780106",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "啊！这句台词，又来了吗！",
            "nextDialogs": [
              "752780107"
            ]
          },
          "752780107": {
            "id": "752780107",
            "speakerId": 1002,
            "speakerName": "「希顿」",
            "text": "#嗯，是我，「希顿」。嘿嘿，好久不见啊！我又来了！{NICKNAME}{M#哥哥}{F#姐姐}，派蒙姐姐。",
            "nextDialogs": [
              "752780108"
            ]
          },
          "752780108": {
            "id": "752780108",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "原、原来是你啊，「希顿」，我还以为又遇到了什么可怕的人呢！",
            "nextDialogs": [
              "752780111"
            ]
          },
          "752780111": {
            "id": "752780111",
            "speakerId": 1002,
            "speakerName": "「希顿」",
            "text": "嘿嘿，我跟你们说，老爹准备亲自辅导我，要把我打造成合格的演员！",
            "nextDialogs": [
              "752780112"
            ]
          },
          "752780112": {
            "id": "752780112",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "虽然他嘴上凶凶的，结果还是很关照你的嘛！当然，要是他没有教给你奇怪的东西就更好了…",
            "nextDialogs": [
              "752780113"
            ]
          },
          "752780113": {
            "id": "752780113",
            "speakerId": 1002,
            "speakerName": "「希顿」",
            "text": "对了，这个送给你们！",
            "nextDialogs": [
              "752780114"
            ]
          },
          "752780114": {
            "id": "752780114",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "这、这是你的演出服？可没有了这个的话，你…",
            "nextDialogs": [
              "752780115"
            ]
          },
          "752780115": {
            "id": "752780115",
            "speakerId": 1002,
            "speakerName": "「希顿」",
            "text": "嘿嘿，不用担心，老爹他给我做了一套更适合我的体型的演出服！这次我肯定不会再在舞台上摔倒了！",
            "nextDialogs": [
              "752780116"
            ]
          },
          "752780116": {
            "id": "752780116",
            "speakerId": 1002,
            "speakerName": "「希顿」",
            "text": "至于原来的演出服，我已经把它做成摆件，请你们收下，把它作为我们友谊的象征吧！",
            "nextDialogs": [
              "752780117"
            ]
          },
          "752780117": {
            "id": "752780117",
            "speakerId": 1002,
            "speakerName": "「希顿」",
            "text": "等到下次见面，我会穿上新的演出服，为你们献上欢迎的舞蹈的！所以请你们以后一定来捧场，我会等着你们的！",
            "nextDialogs": [
              "752780118"
            ]
          },
          "752780118": {
            "id": "752780118",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "嗯，我们一定会的！",
            "nextDialogs": [
              "752780119"
            ]
          },
          "752780119": {
            "id": "752780119",
            "speakerId": 1003,
            "speakerName": "远处传来的声音",
            "text": "「希顿」！该回来训练了！",
            "nextDialogs": [
              "752780120"
            ]
          },
          "752780120": {
            "id": "752780120",
            "speakerId": 1002,
            "speakerName": "「希顿」",
            "text": "#好啦，时间不早了，我准备去锻炼肌肉了！{NICKNAME}{M#哥哥}{F#姐姐}，派蒙姐姐，再见！",
            "nextDialogs": [
              "752780121"
            ]
          },
          "752780121": {
            "id": "752780121",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "嗯嗯，再见哦！",
            "nextDialogs": [
              "752780122"
            ]
          },
          "752780122": {
            "id": "752780122",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "（你真的会去吗？）",
            "nextDialogs": [
              "752780123"
            ]
          },
          "752780123": {
            "id": "752780123",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "一定会的！当然…如果那个时候能看到普通的「偶像」表演就更好了…"
          }
        }
      }
    }
  ]
}
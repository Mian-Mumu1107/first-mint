    {
      "subId": "7450714",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "745071401"
        ],
        "dialogs": {
          "745071401": {
            "id": "745071401",
            "speakerId": 1001,
            "speakerName": "蒂蕾娜",
            "text": "来吧，试着对局一次！",
            "nextDialogs": [
              "745071402"
            ]
          },
          "745071402": {
            "id": "745071402",
            "speakerId": 1001,
            "speakerName": "蒂蕾娜",
            "text": "不过，我明白，我在各方面的实力都远不如你，也请你不要太凶狠！"
          }
        }
      }
    },
    {
      "subId": "7450719",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "745071901"
        ],
        "dialogs": {
          "745071901": {
            "id": "745071901",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "嘿嘿，原来我之前猜得没错，真的是…「咚咚小圆帽」和「欢腾之火」！",
            "nextDialogs": [
              "745071902"
            ]
          },
          "745071902": {
            "id": "745071902",
            "speakerId": 1004,
            "speakerName": "咚咚小圆帽",
            "text": "♪~",
            "nextDialogs": [
              "745071903"
            ]
          },
          "745071903": {
            "id": "745071903",
            "speakerId": 1005,
            "speakerName": "欢腾之火",
            "text": "♫~",
            "nextDialogs": [
              "745071904"
            ]
          },
          "745071904": {
            "id": "745071904",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "请你们等一下哦！我们和海妮耶，还有蒂蕾娜小姐说完正事，马上就来陪你们玩！"
          }
        }
      }
    }
  ]
}
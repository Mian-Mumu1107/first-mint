            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "常九爷，这个给你。",
            "nextDialogs": [
              "100031303"
            ]
          },
          "100031303": {
            "id": "100031303",
            "speakerId": 1624,
            "speakerName": "常九爷",
            "text": "嗯，什么东西？",
            "nextDialogs": [

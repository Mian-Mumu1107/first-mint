    "？？？": 6
  },
  "subQuests": [
    {
      "subId": "7711201",
      "subQuestName": "寻找娜斯佳",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "771120101"
        ],
        "dialogs": {
          "771120101": {
            "id": "771120101",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "娜斯佳！",
            "nextDialogs": [
              "771120102"
            ]
          },
          "771120102": {
            "id": "771120102",
            "speakerId": 1001,
            "speakerName": "娜斯佳",
            "text": "#别担心，小小派蒙，{NICKNAME}{M#大哥哥}{F#大姐姐}，不如说，现在我很好哦，因为我见到了莫罗医生…",
            "nextDialogs": [
              "771120103"
            ]
          },
          "771120103": {
            "id": "771120103",
            "speakerId": 1001,
            "speakerName": "娜斯佳",
            "text": "#莫罗医生夸奖了我，说他看得见，我在小小派蒙和{NICKNAME}{M#大哥哥}{F#大姐姐}的帮助下跨越困难回来。",
            "nextDialogs": [
              "771120104"
            ]
          },
          "771120104": {
            "id": "771120104",
            "speakerId": 1001,
            "speakerName": "娜斯佳",
            "text": "他说我很了不起，也能成为「完全树」的一部分，我也，我也感受到了妈妈…虽然那和以前的拥抱并不一样…",
            "nextDialogs": [
              "771120105"
            ]
          },
          "771120105": {
            "id": "771120105",
            "speakerId": 1001,
            "speakerName": "娜斯佳",
            "text": "但是我知道妈妈确实在那里。",
            "nextDialogs": [
              "771120106"
            ]
          },
          "771120106": {
            "id": "771120106",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "咦？莫罗医生，娜斯佳的妈妈？这里除了娜斯佳就没有任何人了啊？",
            "nextDialogs": [
              "771120107"
            ]
          },
          "771120107": {
            "id": "771120107",
            "speakerId": 1001,
            "speakerName": "娜斯佳",
            "text": "小小派蒙看不到呢，如果小小派蒙成为家人的话，就能够感受到了…",
            "nextDialogs": [
              "771120108"
            ]
          },
          "771120108": {
            "id": "771120108",
            "speakerId": 1001,
            "speakerName": "娜斯佳",
            "text": "因为…啊，因为…「完全树」是超越了一切时间，超越了一切生命的生命，是…永恒。",
            "nextDialogs": [
              "771120109"
            ]
          },
          "771120109": {
            "id": "771120109",
            "speakerId": 1001,
            "speakerName": "娜斯佳",
            "text": "谢谢，「娜斯佳已经不再是单独的娜斯佳」…娜斯佳是「我们」，现在，「或彼时」，娜斯佳本来就是「我们」的一部分。",
            "nextDialogs": [
              "771120110"
            ]
          },
          "771120110": {
            "id": "771120110",
            "speakerId": 1001,
            "speakerName": "娜斯佳",
            "text": "只是在「这一刻」她回归了，「我们的怀抱」，在永恒的尺度，相连，感谢你们的帮助，尤其是你…",
            "nextDialogs": [
              "771120111"
            ]
          },
          "771120111": {
            "id": "771120111",
            "speakerId": 1001,
            "speakerName": "娜斯佳",
            "text": "「降临者」，那第四位的，「如今位格唯一」的双生子之一。",
            "nextDialogs": [
              "771120114"
            ]
          },
          "771120114": {
            "id": "771120114",
            "speakerId": 1002,
            "speakerName": "曾为娜斯佳的某物",
            "text": "「我们」共有千万个名字，「曾经」，如今已失去意义，但是我是你们寻找的，「或追求的」，那个东西，「那个人」。",
            "nextDialogs": [
              "771120115"
            ]
          },
          "771120115": {
            "id": "771120115",
            "speakerId": 1002,
            "speakerName": "曾为娜斯佳的某物",
            "text": "为了方便理解，你可以叫我卡谢伊，「或者莫罗医生」，其实这两者没有差别，「现在更是没有任何差别了」。",
            "nextDialogs": [
              "771120116"
            ]
          },
          "771120116": {
            "id": "771120116",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "啊，原来那个坏蛋就是你！",
            "nextDialogs": [
              "771120117"
            ]
          },
          "771120117": {
            "id": "771120117",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "把「眼镜」的力量还回来，还有娜斯佳，你不许用娜斯佳的身体。",
            "nextDialogs": [
              "771120118"
            ]
          },
          "771120118": {
            "id": "771120118",
            "speakerId": 1002,
            "speakerName": "曾为娜斯佳的某物",
            "text": "…「灰眸」，或者「原初之人」，力量的归还，「这样的事终究会发生」，但命运会偏转，我，「或者我们」，原本以为…",
            "nextDialogs": [
              "771120119"
            ]
          },
          "771120119": {
            "id": "771120119",
            "speakerId": 1002,
            "speakerName": "曾为娜斯佳的某物",
            "text": "会出现在这里的是另一个人，「阿克西妮娅」。如今，是你被选择，代替了她应该做的事。",
            "nextDialogs": [
              "771120120"
            ]
          },
          "771120120": {
            "id": "771120120",
            "speakerId": 1002,
            "speakerName": "曾为娜斯佳的某物",
            "text": "取走吧，「仪式已然完成」。我，「或者我们」已用不到那份力量，已经是永恒，「从概念上无限接近永恒的生命」。",
            "nextDialogs": [
              "771120121"
            ]
          },
          "771120121": {
            "id": "771120121",
            "speakerId": 1002,
            "speakerName": "曾为娜斯佳的某物",
            "text": "这样驱使话语的时间也很短暂，在一切永恒的时间里，话语终将失去意义，「为一切都会失去意义」。",
            "nextDialogs": [
              "771120122"
            ]
          },
          "771120122": {
            "id": "771120122",
            "speakerId": 1002,
            "speakerName": "曾为娜斯佳的某物",
            "text": "啊，可是，恒久的梦啊，恒久的梦，没有意义而不会痛苦的庭院里…我为何寻求永恒，为了…为了…",
            "nextDialogs": [
              "771120123"
            ]
          },
          "771120123": {
            "id": "771120123",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "你忘了你想要什么东西了。",
            "nextDialogs": [
              "771120124"
            ]
          },
          "771120124": {
            "id": "771120124",
            "speakerId": 1002,
            "speakerName": "曾为娜斯佳的某物",
            "text": "…因为「想要什么东西」已失去了意义。",
            "nextDialogs": [
              "771120125"
            ]
          },
          "771120125": {
            "id": "771120125",
            "speakerId": 1002,
            "speakerName": "曾为娜斯佳的某物",
            "text": "永恒啊，冷酷的彼端，即便再炽热的爱也无法抵达。",
            "nextDialogs": [
              "771120126"
            ]
          },
          "771120126": {
            "id": "771120126",
            "speakerId": 1002,
            "speakerName": "曾为娜斯佳的某物",
            "text": "我，「我们」，会将力量归还。",
            "nextDialogs": [
              "771120127"
            ]
          },
          "771120127": {
            "id": "771120127",
            "speakerId": 1002,
            "speakerName": "曾为娜斯佳的某物",
            "text": "不过…这一切终究会以没人想要看到的方式结束…",
            "nextDialogs": [
              "771120128"
            ]
          },
          "771120128": {
            "id": "771120128",
            "speakerId": 1003,
            "speakerName": "「灰眸」",
            "text": "那是什么意思？",
            "nextDialogs": [
              "771120129"
            ]
          },
          "771120129": {
            "id": "771120129",
            "speakerId": 1002,
            "speakerName": "曾为娜斯佳的某物",
            "text": "你会明白的，到最后，「在最初」，你的设想。你选择了「降临者」，这将是你最后的挣扎吗，「又或只是命运的巧合」…",
            "nextDialogs": [
              "771120130"
            ]
          },
          "771120130": {
            "id": "771120130",
            "speakerId": 1002,
            "speakerName": "曾为娜斯佳的某物",
            "text": "真是短暂的苦痛，我将要回归，回归「我们」之间。娜斯佳，你，还有一点点时间，才能成为「我们」。",
            "nextDialogs": [
              "771120131"
            ]
          },
          "771120131": {
            "id": "771120131",
            "speakerId": 1002,
            "speakerName": "曾为娜斯佳的某物",
            "text": "与他们告别吧，虽然到最后，「或时间的尽头」，在寂灭之后，我们都会变成同样的东西。",
            "nextDialogs": [
              "771120132"
            ]
          },
          "771120132": {
            "id": "771120132",
            "speakerId": 1001,
            "speakerName": "娜斯佳",
            "text": "唔…好的，我会好好告别的。",
            "nextDialogs": [
              "771120133"
            ]
          },
          "771120133": {
            "id": "771120133",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "娜斯佳？",
            "nextDialogs": [
              "771120134"
            ]
          },
          "771120134": {
            "id": "771120134",
            "speakerId": 1001,
            "speakerName": "娜斯佳",
            "text": "#小小派蒙，{NICKNAME}{M#大哥哥}{F#大姐姐}，谢谢你们。谢谢你们帮忙，我才能回「家」。",
            "nextDialogs": [
              "771120135"
            ]
          },
          "771120135": {
            "id": "771120135",
            "speakerId": 1001,
            "speakerName": "娜斯佳",
            "text": "这样我就能成为「完全树」的一部分，我也能变得和大家一样，也能重新和妈妈一起生活啦…",
            "nextDialogs": [
              "771120136"
            ]
          },
          "771120136": {
            "id": "771120136",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "可是，娜斯佳，如果变成「完全树」，我们以后就没法一起玩游戏，呃，在树林里跑来跑去，或者，吃好吃的东西。",
            "nextDialogs": [
              "771120137"
            ]
          },
          "771120137": {
            "id": "771120137",
            "speakerId": 1001,
            "speakerName": "娜斯佳",
            "text": "没关系的，小小派蒙，那些虽然都很重要，但是娜斯佳有更重要的事要做。"
          }
        }
      }
    },
    {
      "subId": "7711202",
      "subQuestName": "与娜斯佳对话",
      "sceneId": null,

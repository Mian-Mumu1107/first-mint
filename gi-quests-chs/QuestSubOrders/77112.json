    {
      "subId": "7711204",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "771120401"
        ],
        "dialogs": {
          "771120401": {
            "id": "771120401",
            "speakerId": 1006,
            "speakerName": "蓝藻",
            "text": "又回到了这个地方啊…还是以前的样子，只不过，种子中的嫩芽好像马上要钻出来了，新的枝叶也在生长…",
            "nextDialogs": [
              "771120402"
            ]
          },
          "771120402": {
            "id": "771120402",
            "speakerId": 1006,
            "speakerName": "蓝藻",
            "text": "我的床…变成了别的生命的小床…我的被子…我的枕头和我的玩具…",
            "nextDialogs": [
              "771120403"
            ]
          },
          "771120403": {
            "id": "771120403",
            "speakerId": 1006,
            "speakerName": "蓝藻",
            "text": "它好像已经不是我的小窝了？但是…奇怪，妈妈也已经在我的旁边了，我为什么还在怀念…",
            "nextDialogs": [
              "771120404"
            ]
          },
          "771120404": {
            "id": "771120404",
            "speakerId": 1006,
            "speakerName": "蓝藻",
            "text": "妈妈的手摸着我的头发，它们还没有变成漂亮的枝叶，但妈妈一样爱我——「乖乖孩子早早睡…」",
            "nextDialogs": [
              "771120405"
            ]
          },
          "771120405": {
            "id": "771120405",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "（是娜斯佳吗？但好像没办法和她对话…）"
          }
        }
      }
    }
  ]
}
        "dialogs": {
          "745300401": {
            "id": "745300401",
            "speakerId": 1086,
            "speakerName": "卡齐娜",
            "text": "啊，师父！你回来啦！",
            "nextDialogs": [
              "745300404"
            ]
          },
          "745300404": {
            "id": "745300404",
            "speakerId": 1086,
            "speakerName": "卡齐娜",
            "text": "嘿嘿，我这次挖掘，找到了很不错的原矿哦！",
            "nextDialogs": [
              "745300405"
            ]
          },
          "745300405": {
            "id": "745300405",
            "speakerId": 1086,
            "speakerName": "卡齐娜",
            "text": "如果能好好打磨的话，说不定能变成闪闪发光的大宝石呢！",
            "nextDialogs": [
              "745300406"
            ]
          },
          "745300406": {
            "id": "745300406",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "太好了！",
            "nextDialogs": [
              "745300407"
            ]
          },
          "745300407": {
            "id": "745300407",
            "speakerId": 1086,
            "speakerName": "卡齐娜",
            "text": "嗯！本来前面都没什么收获，我差点就要空手而归了。",
            "nextDialogs": [
              "745300408"
            ]
          },
          "745300408": {
            "id": "745300408",
            "speakerId": 1086,
            "speakerName": "卡齐娜",
            "text": "但是我想着，要再坚持一下…所以就告诉自己，再往下挖一点，就再挖一点点…",
            "nextDialogs": [
              "745300409"
            ]
          },
          "745300409": {
            "id": "745300409",
            "speakerId": 1086,
            "speakerName": "卡齐娜",
            "text": "不知道到底重复了多少次，终于找到了这个！",
            "nextDialogs": [
              "745300410"
            ]
          },
          "745300410": {
            "id": "745300410",
            "speakerId": 1086,
            "speakerName": "卡齐娜",
            "text": "等我出来的时候，才发现太阳都快下山了…好像不小心就挖了一整天。"
          }
        }
      }
    }

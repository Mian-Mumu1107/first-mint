  "subQuests": [
    {
      "subId": "7002801",
      "subQuestName": "与胡塞尼对话",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "700280101"
        ],
        "dialogs": {
          "700280101": {
            "id": "700280101",
            "speakerId": 1000,
            "speakerName": "胡塞尼",
            "text": "多亏你的试用数据，「普尔希娜光钉」的最终校准工作已经完成。",
            "nextDialogs": [
              "700280102"
            ]
          },
          "700280102": {
            "id": "700280102",
            "speakerId": 1000,
            "speakerName": "胡塞尼",
            "text": "现在，我有十足的把握，它们一定能稳定运行。",
            "nextDialogs": [
              "700280103"
            ]
          },
          "700280103": {
            "id": "700280103",
            "speakerId": 1000,
            "speakerName": "胡塞尼",
            "text": "只要我们把「普尔希娜光钉」布置在特异体时常出没的地点，就能控制住它的能源供应。",
            "nextDialogs": [
              "700280104"
            ]
          },
          "700280104": {
            "id": "700280104",
            "speakerId": 1000,
            "speakerName": "胡塞尼",
            "text": "如只要光钉启动，机体就无法再反复自我修复了。",
            "nextDialogs": [
              "700280106",
              "700280108"
            ]
          },
          "700280106": {
            "id": "700280106",
            "speakerId": 1000,
            "speakerName": "胡塞尼",
            "text": "功劳并不在我，我们应该感谢的是先辈们为我们留下的知识。",
            "nextDialogs": [
              "700280109"
            ]
          },
          "700280109": {
            "id": "700280109",
            "speakerId": 1000,
            "speakerName": "胡塞尼",
            "text": "如果没有那些知识给予的引导，我无论如何也想不出制伏那台特异体的方法。",
            "nextDialogs": [
              "700280110"
            ]
          },
          "700280110": {
            "id": "700280110",
            "speakerId": 1000,
            "speakerName": "胡塞尼",
            "text": "我们所作的一切都有赖于知识的引导，知识才是这世界上最重要的资源啊。",
            "nextDialogs": [
              "700280111"
            ]
          },
          "700280111": {
            "id": "700280111",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "听起来很难懂。",
            "nextDialogs": [
              "700280112"
            ]
          },
          "700280112": {
            "id": "700280112",
            "speakerId": 1000,
            "speakerName": "胡塞尼",
            "text": "你不理解这个最基本的道理也很正常，你毕竟还没有领受过至高智慧的熏陶。",
            "nextDialogs": [
              "700280113"
            ]
          },
          "700280113": {
            "id": "700280113",
            "speakerId": 1000,
            "speakerName": "胡塞尼",
            "text": "费了不少功夫终于修好了「普尔希娜光钉」，我一时有点兴奋，哈哈，刚才有些扯远了。",
            "nextDialogs": [
              "700280114"
            ]
          },
          "700280114": {
            "id": "700280114",
            "speakerId": 1000,
            "speakerName": "胡塞尼",
            "text": "我们只剩最后一项准备工作了，那就是去鹤观把「普尔希娜光钉」布置好。",
            "nextDialogs": [
              "700280115"
            ]
          },
          "700280115": {
            "id": "700280115",
            "speakerId": 1000,
            "speakerName": "胡塞尼",
            "text": "抱歉，这件事我就帮不上忙了。",
            "nextDialogs": [
              "700280116"
            ]
          },
          "700280116": {
            "id": "700280116",
            "speakerId": 1000,
            "speakerName": "胡塞尼",
            "text": "按稻妻本地规定，我这种连驻留手续都没办好的人不能自由行动，这件事只能由你完成了。",
            "nextDialogs": [
              "700280117"
            ]
          },
          "700280117": {
            "id": "700280117",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "明白了。",
            "nextDialogs": [
              "700280118"
            ]
          },
          "700280118": {
            "id": "700280118",
            "speakerId": 1000,
            "speakerName": "胡塞尼",
            "text": "那就靠你了。我建议你在布置完成后，不要轻率动手，简单观察一下情况是否正常，再和我说一声。",
            "nextDialogs": [
              "700280119"
            ]
          },
          "700280119": {
            "id": "700280119",
            "speakerId": 1000,
            "speakerName": "胡塞尼",
            "text": "为了你的安全着想，我们最好谨慎些。"
          },
          "700280108": {
            "id": "700280108",
            "speakerId": 1000,
            "speakerName": "胡塞尼",
            "text": "我倒不这么认为，我们应该感谢的是先辈们为我们留下的知识。"
          }
        }
      }
    },
    {
      "subId": "7002802",
      "subQuestName": "前往布置「普尔希娜光钉」",
      "sceneId": null,
      "locations": [],

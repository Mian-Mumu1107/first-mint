      }
    },
    {
      "subId": "7002803",
      "subQuestName": "向胡塞尼回报",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "700280301"
        ],
        "dialogs": {
          "700280301": {
            "id": "700280301",
            "speakerId": 1000,
            "speakerName": "胡塞尼",
            "text": "怎么样？光钉有没有正常运行？",
            "nextDialogs": [
              "700280302"
            ]
          },
          "700280302": {
            "id": "700280302",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "一切正常。",
            "nextDialogs": [
              "700280303"
            ]
          },
          "700280303": {
            "id": "700280303",
            "speakerId": 1000,
            "speakerName": "胡塞尼",
            "text": "嗯，一切正常是最好的情况，希望以后也不要出故障。",
            "nextDialogs": [
              "700280304"
            ]
          },
          "700280304": {
            "id": "700280304",
            "speakerId": 1000,
            "speakerName": "胡塞尼",
            "text": "这样一来，只要在特异体出现在光钉附近时启动光钉，特异体的能量供应就会被切断。",
            "nextDialogs": [
              "700280305"
            ]
          },
          "700280305": {
            "id": "700280305",
            "speakerId": 1000,
            "speakerName": "胡塞尼",
            "text": "这次，你应该能够击败它了，放开手去干吧。",
            "nextDialogs": [
              "700280306"
            ]
          },
          "700280306": {
            "id": "700280306",
            "speakerId": 1000,
            "speakerName": "胡塞尼",
            "text": "我相信你的实力。"
          }
        }
      }
    }
  ]
}
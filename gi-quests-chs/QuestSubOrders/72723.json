{
  "lineCounts": {
    "Player": 7,
    "柴染": 16,
    "派蒙": 8
  },
  "subQuests": [
    {
      "subId": "7272301",
      "subQuestName": "",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "726870101"
        ],
        "dialogs": {
          "726870101": {
            "id": "726870101",
            "speakerId": 30171,
            "speakerName": "柴染",
            "text": "你们好，有缘人。",
            "nextDialogs": [
              "726870102"
            ]
          },
          "726870102": {
            "id": "726870102",
            "speakerId": 30171,
            "speakerName": "柴染",
            "text": "两位举手投足间散发着一股馨香，必定经受过风雅之物的熏陶…",
            "nextDialogs": [
              "726870103"
            ]
          },
          "726870103": {
            "id": "726870103",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "#咦，我们身上香香的？让我闻闻你，{NICKNAME}。",
            "nextDialogs": [
              "726870104"
            ]
          },
          "726870104": {
            "id": "726870104",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "真的诶，你身上有股松茸酿肉卷的香味！这个姐姐看人真准！",
            "nextDialogs": [
              "726870107"
            ]
          },
          "726870107": {
            "id": "726870107",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "也对哦，这种熟悉的展开…我明白了！这位姐姐果然也需要我们帮忙吗？",
            "nextDialogs": [
              "726870108"
            ]
          },
          "726870108": {
            "id": "726870108",
            "speakerId": 30171,
            "speakerName": "柴染",
            "text": "两位是尽职尽责的向导，的确能为我招徕更多客人，但我希望你们也能以客人的身份享受这场祭典。",
            "nextDialogs": [
              "726870109"
            ]
          },
          "726870109": {
            "id": "726870109",
            "speakerId": 30171,
            "speakerName": "柴染",
            "text": "如果两位有空，要来试试看吗？构筑专属你们的「花影瑶庭」。",
            "nextDialogs": [
              "726870110"
            ]
          },
          "726870110": {
            "id": "726870110",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "「花影瑶庭」是什么啊？",
            "nextDialogs": [
              "726870111"
            ]
          },
          "726870111": {
            "id": "726870111",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "我也想了解一下。",
            "nextDialogs": [
              "726870112"
            ]
          },
          "726870112": {
            "id": "726870112",
            "speakerId": 30171,
            "speakerName": "柴染",
            "text": "如你所见，我是一名花匠。我身边这些花架上陈列着的，是以「插花」之道所构筑的「花庭」。",
            "nextDialogs": [
              "726870113"
            ]
          },
          "726870113": {
            "id": "726870113",
            "speakerId": 30171,
            "speakerName": "柴染",
            "text": "将精心修剪的花卉置入花器，辅以各色饰物，构建桌上庭院般的景致。这便是「花影瑶庭」，花艺的结晶。",
            "nextDialogs": [
              "726870114"
            ]
          },
          "726870114": {
            "id": "726870114",
            "speakerId": 30171,
            "speakerName": "柴染",
            "text": "在社奉行的支持下，我携多座「花影瑶庭」参与容彩祭，希望能让客人们领略到花艺的美好。",
            "nextDialogs": [
              "726870115"
            ]
          },
          "726870115": {
            "id": "726870115",
            "speakerId": 30171,
            "speakerName": "柴染",
            "text": "要是对「花影瑶庭」感兴趣，现在就可以来体验一番。",
            "nextDialogs": [
              "726870116"
            ]
          },
          "726870116": {
            "id": "726870116",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "确实…这些花艺作品都好漂亮，听起来也好高雅啊。不过，总觉得这种事情好难好难…我们能做到吗？"
          }
        }
      }
    }
  ]
}
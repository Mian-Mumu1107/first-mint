  "subQuests": [
    {
      "subId": "7451001",
      "subQuestName": "与摊位旁的两人对话",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "745100101"
        ],
        "dialogs": {
          "745100101": {
            "id": "745100101",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "是我们赢啦！蕈兽伙伴们大获全胜！",
            "nextDialogs": [
              "745100102"
            ]
          },
          "745100102": {
            "id": "745100102",
            "speakerId": 1001,
            "speakerName": "海妮耶",
            "text": "真是华丽的战斗策略，不愧是你们，「黄金流星」和「白银伴星」…",
            "nextDialogs": [
              "745100103"
            ]
          },
          "745100103": {
            "id": "745100103",
            "speakerId": 1001,
            "speakerName": "海妮耶",
            "text": "你们的驯兽才能完全超出了常理，即便面对常理以外的对手，蕈兽伙伴们也能在你们的指挥下立于不败之地！",
            "nextDialogs": [
              "745100106"
            ]
          },
          "745100106": {
            "id": "745100106",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "不过，前几次有大雪猪王和魔偶剑鬼登场，这次居然连刀子狗都找来了。",
            "nextDialogs": [
              "745100107"
            ]
          },
          "745100107": {
            "id": "745100107",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "左右加，你设置对手的阵容，还真是随心所欲啊…",
            "nextDialogs": [
              "745100108"
            ]
          },
          "745100108": {
            "id": "745100108",
            "speakerId": 1002,
            "speakerName": "左右加",
            "text": "这些强敌可都是各地冒险家故事中传说般的存在哦！名气多多少少漂洋过海，能引起各地玩家的共鸣嘛。",
            "nextDialogs": [
              "745100109"
            ]
          },
          "745100109": {
            "id": "745100109",
            "speakerId": 1002,
            "speakerName": "左右加",
            "text": "作为一个小说作者，我也很喜欢…各种本来无关的角色比拼一番实力的场景，想想都兴奋！",
            "nextDialogs": [
              "745100110"
            ]
          },
          "745100110": {
            "id": "745100110",
            "speakerId": 1002,
            "speakerName": "左右加",
            "text": "那么，「智巧勇武双连星」，你们已经体验了本次「小小灵蕈大幻戏」的所有关卡，感觉怎么样？"
          }
        }
      }
    },

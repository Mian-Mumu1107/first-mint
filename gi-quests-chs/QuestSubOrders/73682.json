{
  "lineCounts": {
    "Player": 5,
    "派蒙": 8,
    "莱妮": 16
  },
  "subQuests": [
    {
      "subId": "7368201",
      "subQuestName": "与莱妮对话",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "736820101"
        ],
        "dialogs": {
          "736820101": {
            "id": "736820101",
            "speakerId": 30249,
            "speakerName": "莱妮",
            "text": "可让我一阵好等啊，两位胆识卓绝的朋友！请抓紧这大好的机会，和我一起领略冒险的艺术，尝试超越本我吧！",
            "nextDialogs": [
              "736820104"
            ]
          },
          "736820104": {
            "id": "736820104",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "唔，虽然不知道你在说什么，但好像很厉害！能不能再解释一下？",
            "nextDialogs": [
              "736820105"
            ]
          },
          "736820105": {
            "id": "736820105",
            "speakerId": 30249,
            "speakerName": "莱妮",
            "text": "当然没问题…慢着，我认识你…居然是您！",
            "nextDialogs": [
              "736820106"
            ]
          },
          "736820106": {
            "id": "736820106",
            "speakerId": 30249,
            "speakerName": "莱妮",
            "text": "抗击风魔龙的空战豪杰，不倦执勤的委托粉碎机，隐秘宝箱的寻踪人，未知迷雾的破除者…",
            "nextDialogs": [
              "736820107"
            ]
          },
          "736820107": {
            "id": "736820107",
            "speakerId": 30249,
            "speakerName": "莱妮",
            "text": "如果您带头参加这次活动，一定能拉动大家的热情，推进这项伟大的事业！",
            "nextDialogs": [
              "736820108"
            ]
          },
          "736820108": {
            "id": "736820108",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "好大一串称号？",
            "nextDialogs": [
              "736820109"
            ]
          },
          "736820109": {
            "id": "736820109",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "从来没听过欸！",
            "nextDialogs": [
              "736820110"
            ]
          },
          "736820110": {
            "id": "736820110",
            "speakerId": 30249,
            "speakerName": "莱妮",
            "text": "这些称号通常出现酒桌上、篝火周围和孩子们的睡前故事里，只靠人们口口相传，您没听过也很正常。",
            "nextDialogs": [
              "736820111"
            ]
          },
          "736820111": {
            "id": "736820111",
            "speakerId": 30249,
            "speakerName": "莱妮",
            "text": "总之，您活跃的身影鼓励着成百上千位冒险家，给了大家不断变强的动力！",
            "nextDialogs": [
              "736820112"
            ]
          },
          "736820112": {
            "id": "736820112",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "#原来{NICKNAME}在蒙德的冒险家协会已经这么有名了吗？那我呢，我有什么称号吗？",
            "nextDialogs": [
              "736820113"
            ]
          },
          "736820113": {
            "id": "736820113",
            "speakerId": 30249,
            "speakerName": "莱妮",
            "text": "咳咳！我好像听朋友说过，有人称你为…「如鸟羽般轻灵，如北风般豪爽的派蒙大人」。",
            "nextDialogs": [
              "736820114"
            ]
          },
          "736820114": {
            "id": "736820114",
            "speakerId": 30249,
            "speakerName": "莱妮",
            "text": "「鸟羽般轻灵」形容的是你小巧敏捷的身姿，「北风般豪爽」说的是你和北风骑士不相上下的，令人羡慕的好胃口！"
          }
        }
      }
    }
  ]
}
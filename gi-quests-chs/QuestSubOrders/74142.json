    {
      "subId": "7414204",
      "subQuestName": "与「夏诺蒂拉」对话",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "741420401"
        ],
        "dialogs": {
          "741420401": {
            "id": "741420401",
            "speakerId": 1001,
            "speakerName": "夏诺蒂拉",
            "text": "#咦，{NICKNAME}{M#哥哥}{F#姐姐}…我们不是刚刚才见过面吗？",
            "nextDialogs": [
              "741420402"
            ]
          },
          "741420402": {
            "id": "741420402",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "什么时候的事？",
            "nextDialogs": [
              "741420403"
            ]
          },
          "741420403": {
            "id": "741420403",
            "speakerId": 1001,
            "speakerName": "夏诺蒂拉",
            "text": "唔，我也说不准耶…毕竟，在这种地方根本不知道时间嘛！",
            "nextDialogs": [
              "741420404"
            ]
          },
          "741420404": {
            "id": "741420404",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "夏诺蒂拉，跟我走吧。",
            "nextDialogs": [
              "741420405"
            ]
          },
          "741420405": {
            "id": "741420405",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "这里很不正常。",
            "nextDialogs": [
              "741420406"
            ]
          },
          "741420406": {
            "id": "741420406",
            "speakerId": 1001,
            "speakerName": "夏诺蒂拉",
            "text": "但是，正常与不正常，难道不是我们决定的吗？",
            "nextDialogs": [
              "741420407"
            ]
          },
          "741420407": {
            "id": "741420407",
            "speakerId": 1001,
            "speakerName": "夏诺蒂拉",
            "text": "嗯…我也没有别的意思，但这里对我来说真的很好。这里充满生机与色彩，在那边的世界我从来没见过这样的景象。",
            "nextDialogs": [
              "741420408"
            ]
          },
          "741420408": {
            "id": "741420408",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "我只见到一朵向日葵…",
            "nextDialogs": [
              "741420409"
            ]
          },
          "741420409": {
            "id": "741420409",
            "speakerId": 1001,
            "speakerName": "夏诺蒂拉",
            "text": "真的？哇！在什么地方？",
            "nextDialogs": [
              "741420410"
            ]
          },
          "741420410": {
            "id": "741420410",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "之前我们遇到小狗的地方。",
            "nextDialogs": [
              "741420411"
            ]
          },
          "741420411": {
            "id": "741420411",
            "speakerId": 1001,
            "speakerName": "夏诺蒂拉",
            "text": "喔！那我先出发啦！",
            "nextDialogs": [
              "741420412"
            ]
          },
          "741420412": {
            "id": "741420412",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "等等…"
          }
        }
      }
    },
    {
      "subId": "7414205",

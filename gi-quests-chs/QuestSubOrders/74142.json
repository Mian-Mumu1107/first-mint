    {
      "subId": "7414203",
      "subQuestName": "(test)再次去交互书$HIDDEN",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "741421601"
        ],
        "dialogs": {
          "741421601": {
            "id": "741421601",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "毋须担心。",
            "nextDialogs": [
              "741421602"
            ]
          },
          "741421602": {

    },
    {
      "subId": "7414207",
      "subQuestName": "继续追寻",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "741420701"
        ],
        "dialogs": {
          "741420701": {
            "id": "741420701",
            "speakerId": 1001,
            "speakerName": "夏诺蒂拉",
            "text": "#啊！是{NICKNAME}{M#哥哥}{F#姐姐}。咦，派蒙没和你一起吗？",
            "nextDialogs": [
              "741420702"
            ]
          },
          "741420702": {
            "id": "741420702",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "那个裂隙…你在看什么？",
            "nextDialogs": [
              "741420703"
            ]
          },
          "741420703": {
            "id": "741420703",
            "speakerId": 1001,
            "speakerName": "夏诺蒂拉",
            "text": "咦？什么裂隙呀，这不是镜子吗？",
            "nextDialogs": [
              "741420704"
            ]
          },
          "741420704": {
            "id": "741420704",
            "speakerId": 1001,
            "speakerName": "夏诺蒂拉",
            "text": "唔，这么说来，我确实有在找的东西。",
            "nextDialogs": [
              "741420705"
            ]
          },
          "741420705": {
            "id": "741420705",
            "speakerId": 1001,
            "speakerName": "夏诺蒂拉",
            "text": "我一直在找「谜镜」的线索…应该是像画一样的东西，和「揭示之书」一样，也能够让人「冥想」。",
            "nextDialogs": [
              "741420706"
            ]
          },
          "741420706": {
            "id": "741420706",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "关于四象限与格式塔的「画」…",
            "nextDialogs": [
              "741420707"
            ]
          },
          "741420707": {
            "id": "741420707",
            "speakerId": 1001,
            "speakerName": "夏诺蒂拉",
            "text": "#…是喔，原来在那样的地方。嗯！谢谢{NICKNAME}{M#哥哥}{F#姐姐}！"
          }
        }
      }
    },

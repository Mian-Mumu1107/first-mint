  "subQuests": [
    {
      "subId": "7608401",
      "subQuestName": "同「少女」见面",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "760490603"
        ],
        "dialogs": {
          "760490603": {
            "id": "760490603",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "平和的乐调…",
            "nextDialogs": [
              "760490604"
            ]
          },
          "760490604": {
            "id": "760490604",
            "speakerId": 1000,
            "speakerName": "「少女」",
            "text": "好听。我平时哼的旋律，原来你都记下来了。",
            "nextDialogs": [
              "760490605"
            ]
          },
          "760490605": {
            "id": "760490605",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "嘿嘿，因为你唱歌很好听嘛，我们有时会悄悄在旁边听上一会儿。",
            "nextDialogs": [
              "760490606"
            ]
          },
          "760490606": {
            "id": "760490606",
            "speakerId": 1000,
            "speakerName": "「少女」",
            "text": "月灵们也听得入迷了。不知道它们有没有学会。",
            "nextDialogs": [
              "760490607"
            ]
          },
          "760490607": {
            "id": "760490607",
            "speakerId": 1000,
            "speakerName": "「少女」",
            "text": "说不定，以后还得多请你们教几次。",
            "nextDialogs": [
              "760490608"
            ]
          },
          "760490608": {
            "id": "760490608",
            "speakerId": 1000,
            "speakerName": "「少女」",
            "text": "来吧，把手给我。",
            "nextDialogs": [
              "760490609"
            ]
          },
          "760490609": {
            "id": "760490609",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "欸？我们这是无偿演出，不用收学费的！",
            "nextDialogs": [
              "760490610"
            ]
          },
          "760490610": {
            "id": "760490610",
            "speakerId": 1000,
            "speakerName": "「少女」",
            "text": "嗯？学费？",
            "nextDialogs": [
              "760490611"
            ]
          },
          "760490611": {
            "id": "760490611",
            "speakerId": 1000,
            "speakerName": "「少女」",
            "text": "我只是觉得，好听的旋律，应该有美丽的月光相伴。"
          }
        }
      }
    },
    {
      "subId": "7604903",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "760490301"
        ],
        "dialogs": {
          "760490301": {
            "id": "760490301",
            "speakerId": 1000,
            "speakerName": "「少女」",
            "text": "今天月灵们很满足了。但以后，或许还会再麻烦你们来教它们。"
          }
        }
      }
    },
    {
      "subId": "7604907",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "760490709"
        ],
        "dialogs": {
          "760490709": {
            "id": "760490709",
            "speakerId": 1000,
            "speakerName": "「少女」",
            "text": "如今我们穿过云雾，一同见到了月亮上的那个答案…它的美好就如你此刻的琴声。"
          }
        }
      }
    },
    {
      "subId": "7608401",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "760840101"
        ],
        "dialogs": {
          "760840101": {
            "id": "760840101",
            "speakerId": 1000,
            "speakerName": "「少女」",
            "text": "你们来了？今天月灵们又在玩琴。能像上次一样弹一首给它们听吗？",
            "nextDialogs": [
              "760840102"
            ]
          },
          "760840102": {
            "id": "760840102",
            "speakerId": 1000,
            "speakerName": "「少女」",
            "text": "我正好也想听些不一样的曲调。",
            "nextDialogs": [
              "760840103"
            ]
          },
          "760840103": {
            "id": "760840103",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "（弹什么好呢…）"
          }
        }
      }
    },
    {
      "subId": "7608402",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "760840201"
        ],
        "dialogs": {
          "760840201": {
            "id": "760840201",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "演奏哥伦比娅常哼的歌…",
            "nextDialogs": [
              "760490202"
            ]
          },
          "760490202": {
            "id": "760490202",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "演奏哥伦比娅常哼的歌…",
            "nextDialogs": [
              "760490201"
            ]
          },
          "760490201": {
            "id": "760490201",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "（以什么样的情绪演奏呢…）",
            "nextDialogs": [
              "760490702"
            ]
          },
          "760490702": {
            "id": "760490702",
            "speakerId": 1000,
            "speakerName": "「少女」",
            "text": "结束了？感觉都还没听够…",
            "nextDialogs": [
              "760490703"
            ]
          },
          "760490703": {
            "id": "760490703",
            "speakerId": 1000,
            "speakerName": "「少女」",
            "text": "我曾说过这是我唯一记得的「摇篮曲」。",
            "nextDialogs": [
              "760490704"
            ]
          },
          "760490704": {
            "id": "760490704",
            "speakerId": 1000,
            "speakerName": "「少女」",
            "text": "尽管还没找到其中的意义，但听你弹过之后，我开始觉得在月亮上等待着我的那个答案，至少是美好的。",
            "nextDialogs": [
              "760490705"
            ]
          },
          "760490705": {
            "id": "760490705",
            "speakerId": 1000,
            "speakerName": "「少女」",
            "text": "来，把手给我。",
            "nextDialogs": [
              "760490706"
            ]
          },
          "760490706": {
            "id": "760490706",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "这次就不用回报啦。",
            "nextDialogs": [
              "760490707"
            ]
          },
          "760490707": {
            "id": "760490707",
            "speakerId": 1000,
            "speakerName": "「少女」",
            "text": "不，我只是想为这旋律添上一束美好的月光。"
          }
        }
      }
    },

    {
      "subId": "7608405",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "760840501"
        ],
        "dialogs": {
          "760840501": {
            "id": "760840501",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "愉快的乐调…"
          }
        }
      }
    },
    {
      "subId": "7608406",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "760840601"
        ],
        "dialogs": {
          "760840601": {
            "id": "760840601",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "演奏他国的音乐…",
            "nextDialogs": [
              "760490801"
            ]
          },
          "760490801": {
            "id": "760490801",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "演奏他国的音乐…",
            "nextDialogs": [
              "760490802"
            ]
          },
          "760490802": {
            "id": "760490802",
            "speakerId": 1000,
            "speakerName": "「少女」",
            "text": "奇妙的感觉。以前偶尔也听过类似的旋律，但听你弹的感受很不一样。",
            "nextDialogs": [
              "760490803"
            ]
          },
          "760490803": {
            "id": "760490803",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "#可能其中包含了{M#他}{F#她}对那个国家的感情吧。",
            "nextDialogs": [
              "760490804"
            ]
          },
          "760490804": {
            "id": "760490804",
            "speakerId": 1000,
            "speakerName": "「少女」",
            "text": "奇妙的是，我能够从乐调中想象出风景…不知道现实和我的想象会有多少区别呢…",
            "nextDialogs": [
              "760490805"
            ]
          },
          "760490805": {
            "id": "760490805",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "想看还不简单？到时候就让我们来当你的导游吧！",
            "nextDialogs": [
              "760490806"
            ]
          },
          "760490806": {
            "id": "760490806",
            "speakerId": 1000,
            "speakerName": "「少女」",
            "text": "嗯…如果能有那么一天的话。"
          }
        }
      }
    }
  ]

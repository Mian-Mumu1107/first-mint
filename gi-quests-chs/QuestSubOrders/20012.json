    {
      "subId": "2001202",
      "subQuestName": "(test)击败附近怪物$HIDDEN",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "200120201"
        ],
        "dialogs": {
          "200120201": {
            "id": "200120201",
            "speakerId": 157001,
            "speakerName": "惊慌的米拉娜",
            "text": "谢谢你，旅行者。",
            "nextDialogs": [
              "200120202"
            ]
          },
          "200120202": {
            "id": "200120202",
            "speakerId": 157001,
            "speakerName": "惊慌的米拉娜",
            "text": "唉，怪物和路障…平时在家里就忙个不停，散个步也能遇见这种倒霉事。",
            "nextDialogs": [
              "200120203"
            ]
          },
          "200120203": {
            "id": "200120203",
            "speakerId": 157001,
            "speakerName": "惊慌的米拉娜",
            "text": "抱歉，能请您帮我把这个路障也一并清理了吗？",
            "nextDialogs": [
              "200120206",
              "200120207"
            ]
          },
          "200120206": {
            "id": "200120206",
            "speakerId": 157001,
            "speakerName": "惊慌的米拉娜",
            "text": "谢谢您，希望我的两个孩子能和您一样，有个好品德。"
          },
          "200120207": {
            "id": "200120207",
            "speakerId": 157001,
            "speakerName": "惊慌的米拉娜",
            "text": "哎呀，只是一点举手之劳，不会花您太长时间的。"
          }
        }
      }
    },
    {
      "subId": "2001203",
      "subQuestName": "消灭所有魔物并摧毁路障",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "200120301"
        ],
        "dialogs": {
          "200120301": {
            "id": "200120301",
            "speakerId": 1570,
            "speakerName": "惊慌的米拉娜",
            "text": "太感谢你了，旅行者。",
            "nextDialogs": [
              "200120302"
            ]
          },
          "200120302": {
            "id": "200120302",
            "speakerId": 1570,
            "speakerName": "惊慌的米拉娜",
            "text": "但请你别和人说我在这遇见麻烦了。不然我肯定又要被我丈夫念叨个不停了。",
            "nextDialogs": [
              "200120303"
            ]
          },
          "200120303": {
            "id": "200120303",
            "speakerId": 1570,
            "speakerName": "惊慌的米拉娜",
            "text": "别用这种眼神看着我，等你结了婚就知道，连独自散步都是奢侈的娱乐，所以必须抓紧每分每秒。",
            "nextDialogs": [
              "200120304"
            ]
          },
          "200120304": {
            "id": "200120304",
            "speakerId": 1570,
            "speakerName": "惊慌的米拉娜",
            "text": "喏，这个给你，我在路上采了一些，自己做饭可比叫猎鹿人的餐便宜多了。过日子就要这样精打细算。"
          }
        }
      }
    },

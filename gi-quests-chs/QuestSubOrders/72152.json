        ],
        "dialogs": {
          "721520101": {
            "id": "721520101",
            "speakerId": 1000,
            "speakerName": "盗宝团的笔记",
            "text": "「…此处曾是大海贼林藏的藏宝之地，兄弟们搬走了最后几箱…」",
            "nextDialogs": [
              "721520102"
            ]
          },
          "721520102": {
            "id": "721520102",
            "speakerId": 1000,
            "speakerName": "盗宝团的笔记",
            "text": "「…但林藏生前诡计多端，在岛上多处留下了专属记号…」",
            "nextDialogs": [
              "721520103"
            ]
          },
          "721520103": {
            "id": "721520103",
            "speakerId": 1000,
            "speakerName": "盗宝团的笔记",
            "text": "「…或许只是掩饰，或许确有宝藏，但只有前往一探究竟才能确定…」",
            "nextDialogs": [
              "721520104"
            ]
          },
          "721520104": {
            "id": "721520104",
            "speakerId": 1000,
            "speakerName": "盗宝团的笔记",
            "text": "「…我们已经发现了一些标记，时不我待，该动身去发掘林藏的全部遗宝了！」",
            "nextDialogs": [
              "721520105"
            ]
          },
          "721520105": {
            "id": "721520105",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "唔…好长…除了「宝藏」两个字以外完全不想读…",
            "nextDialogs": [
              "721520106"
            ]
          },
          "721520106": {
            "id": "721520106",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "欸…？宝藏？！",
            "nextDialogs": [
              "721520107"
            ]
          },
          "721520107": {
            "id": "721520107",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "既然有宝藏，我们也快点出发吧！别让盗宝团抢先啦！"
          }
        }
      }
    },

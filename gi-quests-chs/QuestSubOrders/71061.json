  "subQuests": [
    {
      "subId": "7106116",
      "subQuestName": "靠近奇怪的大蘑菇$HIDDEN",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [],
        "dialogs": {}
      }
    },
    {
      "subId": "7106101",
      "subQuestName": "与赞玛兰对话",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "710610101"
        ],
        "dialogs": {
          "710610101": {
            "id": "710610101",
            "speakerId": 1000,
            "speakerName": "赞玛兰",
            "text": "两脚但不用脚的小东西太过多疑。",
            "nextDialogs": [
              "710610102"
            ]
          },
          "710610102": {
            "id": "710610102",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "我不叫什么「两脚但不用脚的小东西」！我叫派蒙！气死我了，一定要找机会给你取一个难听的绰号。",
            "nextDialogs": [
              "710610103"
            ]
          },
          "710610103": {
            "id": "710610103",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "对了，就叫你「大蘑头」好了！",
            "nextDialogs": [
              "710610104"
            ]
          },
          "710610104": {
            "id": "710610104",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "周围好像飘着一些发光的粉尘，看起来像是蘑菇的孢子，不知道我们能听到蘑菇的声音是不是和它们有关系。",
            "nextDialogs": [
              "710610105"
            ]
          },
          "710610105": {
            "id": "710610105",
            "speakerId": 1000,
            "speakerName": "赞玛兰",
            "text": "赞玛兰知道许多有脚但不用脚的，不知道派蒙。",
            "nextDialogs": [
              "710610106"
            ]
          },
          "710610106": {
            "id": "710610106",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "哼哼，那是因为我是特别的呀。",
            "nextDialogs": [
              "710610107"
            ]
          },
          "710610107": {
            "id": "710610107",
            "speakerId": 1000,
            "speakerName": "赞玛兰",
            "text": "赞玛兰知道两脚的，怪哉怪哉，有熟悉的气息。",
            "nextDialogs": [
              "710610108"
            ]
          },
          "710610108": {
            "id": "710610108",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "#{NICKNAME}，你认识大蘑头吗？",
            "nextDialogs": [
              "710610111"
            ]
          },
          "710610111": {
            "id": "710610111",
            "speakerId": 1000,
            "speakerName": "赞玛兰",
            "text": "是镀金的热砂与幽邃的雨林的气息，是故乡的气息。",
            "nextDialogs": [
              "710610112"
            ]
          },
          "710610112": {
            "id": "710610112",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "热砂和雨林，是说须弥吗？我们的确在营地和从须弥来的学者接触过…",
            "nextDialogs": [
              "710610113"
            ]
          },
          "710610113": {
            "id": "710610113",
            "speakerId": 1000,
            "speakerName": "赞玛兰",
            "text": "赞玛兰虽然已经离开故乡有些时日，但绝不会错认。",
            "nextDialogs": [
              "710610114"
            ]
          },
          "710610114": {
            "id": "710610114",
            "speakerId": 1000,
            "speakerName": "赞玛兰",
            "text": "#两脚的{NICKNAME}，有缘之人，赞玛兰有事相求。",
            "nextDialogs": [
              "710610115"
            ]
          },
          "710610115": {
            "id": "710610115",
            "speakerId": 1000,
            "speakerName": "赞玛兰",
            "text": "赞玛兰在此处安住已久，原本此地是处惬意的居所…",
            "nextDialogs": [
              "710610116"
            ]
          },
          "710610116": {
            "id": "710610116",
            "speakerId": 1000,
            "speakerName": "赞玛兰",
            "text": "但近来邪气愈来愈盛，为抵御邪气，赞玛兰耗尽了气力，落得如此模样，不得已而向两脚的求救。",
            "nextDialogs": [
              "710610117"
            ]
          },
          "710610117": {
            "id": "710610117",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "仔细看看，大蘑头确实很没精神呢，好像生病了一样。",
            "nextDialogs": [
              "710610118"
            ]
          },
          "710610118": {
            "id": "710610118",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "#唔，对了，{NICKNAME}，要不要把「触媒」的能量分给大蘑头？也许这样它就能打起精神来了。"
          }
        }
      }
    },
    {
      "subId": "7106102",
      "subQuestName": "将「触媒」能量分给赞玛兰",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "710610201"
        ],
        "dialogs": {
          "710610201": {
            "id": "710610201",
            "speakerId": 1002,
            "speakerName": "Black Screen",
            "text": "将「触媒」的能量分给了赞玛兰。",
            "nextDialogs": [
              "710610202"
            ]
          },
          "710610202": {
            "id": "710610202",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "呜哇，大蘑头亮起来了！现在是不是该叫「荧光大蘑头」了…",
            "nextDialogs": [
              "710610203"
            ]
          },
          "710610203": {
            "id": "710610203",
            "speakerId": 1000,
            "speakerName": "赞玛兰",
            "text": "#赞美{NICKNAME}，赞美派蒙。",
            "nextDialogs": [
              "710610204"
            ]
          },
          "710610204": {
            "id": "710610204",
            "speakerId": 1000,
            "speakerName": "赞玛兰",
            "text": "#多亏{NICKNAME}，多亏派蒙，赞玛兰重获了生命的辉光。",
            "nextDialogs": [
              "710610205"
            ]
          },
          "710610205": {
            "id": "710610205",
            "speakerId": 1000,
            "speakerName": "赞玛兰",
            "text": "但切不可放松大意，赞玛兰知道，邪气的源头仍在，邪气随时可能再来袭扰。",
            "nextDialogs": [
              "710610206"
            ]
          },
          "710610206": {
            "id": "710610206",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "欸，那该怎么办才好？",
            "nextDialogs": [
              "710610207"
            ]
          },
          "710610207": {
            "id": "710610207",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "呜啊，哪里冒出来的这些黑泥？这就是大蘑头说的「邪气」吗？"
          }
        }
      }
    },

    {
      "subId": "7106104",
      "subQuestName": "清除赞玛兰周围的「邪气」",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "710610401"
        ],
        "dialogs": {
          "710610401": {
            "id": "710610401",
            "speakerId": 1000,
            "speakerName": "赞玛兰",
            "text": "#赞美{NICKNAME}，赞美派蒙。",
            "nextDialogs": [
              "710610402"
            ]
          },
          "710610402": {
            "id": "710610402",
            "speakerId": 1000,
            "speakerName": "赞玛兰",
            "text": "虽于心不安，但且容赞玛兰直言，正如两脚的有言：「帮人帮到底」…",
            "nextDialogs": [
              "710610404",
              "710610406"
            ]
          },
          "710610404": {
            "id": "710610404",
            "speakerId": 1000,
            "speakerName": "赞玛兰",
            "text": "两脚的这等远见卓识的确配得上有智慧者的称号。",
            "nextDialogs": [
              "710610407"
            ]
          },
          "710610407": {
            "id": "710610407",
            "speakerId": 1000,
            "speakerName": "赞玛兰",
            "text": "还请不要推辞，收下这份「才慧之瑞佑」。",
            "nextDialogs": [
              "710610408"
            ]
          },
          "710610408": {
            "id": "710610408",
            "speakerId": 1002,
            "speakerName": "Black Screen",
            "text": "获得了「才慧之瑞佑」。",
            "nextDialogs": [
              "710610409"
            ]
          },
          "710610409": {
            "id": "710610409",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "呜啊…这是什么东西，看起来好可疑的样子…",
            "nextDialogs": [
              "710610410"
            ]
          },
          "710610410": {
            "id": "710610410",
            "speakerId": 1000,
            "speakerName": "赞玛兰",
            "text": "此处仍有不少邪气在空中游荡，赞玛兰能够感知，却无法分辨源头的所在。沿水流探索，必定会有所发现。",
            "nextDialogs": [
              "710610411"
            ]
          },
          "710610411": {
            "id": "710610411",
            "speakerId": 1000,
            "speakerName": "赞玛兰",
            "text": "#{NICKNAME}只要对邪气的源头使用「才慧之瑞佑」，赞玛兰的同族自会把问题处理。"
          },
          "710610406": {
            "id": "710610406",
            "speakerId": 1000,
            "speakerName": "赞玛兰",
            "text": "同为安享大地恩惠的有生之物，彼此扶助才顺应道理。"
          }
        }
      }
    },
    {
      "subId": "7106110",
      "subQuestName": "告知赞玛兰「邪气」已被清除",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "710610301"
        ],
        "dialogs": {
          "710610301": {
            "id": "710610301",
            "speakerId": 1000,
            "speakerName": "赞玛兰",
            "text": "#赞美{NICKNAME}，赞美派蒙。",
            "nextDialogs": [
              "710610302"
            ]
          },
          "710610302": {
            "id": "710610302",
            "speakerId": 1000,
            "speakerName": "赞玛兰",
            "text": "赞玛兰的呼唤久久未得到回应。多脚的和四脚的自不必说，两脚的也对赞玛兰的呼救置若罔闻。",
            "nextDialogs": [
              "710610303"
            ]
          },
          "710610303": {
            "id": "710610303",
            "speakerId": 1000,
            "speakerName": "赞玛兰",
            "text": "#只有真正有智慧者才会回应赞玛兰的呼唤。派蒙是有智慧者，{NICKNAME}也是有智慧者。",
            "nextDialogs": [
              "710610304"
            ]
          },
          "710610304": {
            "id": "710610304",
            "speakerId": 1000,
            "speakerName": "赞玛兰",
            "text": "两脚的之中的佼佼者理应获得赞玛兰的感谢。",
            "nextDialogs": [
              "710610323"
            ]
          },
          "710610323": {
            "id": "710610323",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "哼哼，「有智慧者」派蒙，不容小觑！",
            "nextDialogs": [
              "710610305"
            ]
          },
          "710610305": {
            "id": "710610305",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "小事一桩。",
            "nextDialogs": [
              "710610306"
            ]
          },
          "710610306": {
            "id": "710610306",
            "speakerId": 1000,
            "speakerName": "赞玛兰",
            "text": "#相信假以时日，{NICKNAME}和派蒙也能成为与赞玛兰和赞玛兰的同族相提并论的存在。",
            "nextDialogs": [
              "710610307"
            ]
          },
          "710610307": {
            "id": "710610307",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "等等，大蘑头这话是什么意思？",
            "nextDialogs": [
              "710610308"
            ]
          },
          "710610308": {
            "id": "710610308",
            "speakerId": 1000,
            "speakerName": "赞玛兰",
            "text": "多脚的不如四脚的，四脚的不如两脚的，自然两脚的也不如无脚的。",
            "nextDialogs": [
              "710610309"
            ]
          },
          "710610309": {
            "id": "710610309",
            "speakerId": 1000,
            "speakerName": "赞玛兰",
            "text": "#虽然{NICKNAME}和派蒙先天不足，但只要有心，后天的努力也未必不能改变运命的走向。",
            "nextDialogs": [
              "710610310"
            ]
          },
          "710610310": {
            "id": "710610310",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "不过是个荧光大蘑菇而已，竟然这么嚣张！不知道荧光蘑菇能不能做成料理…",
            "nextDialogs": [
              "710610313"
            ]
          },
          "710610313": {
            "id": "710610313",
            "speakerId": 1000,
            "speakerName": "赞玛兰",
            "text": "派蒙胃口不小。今日吃蘑菇，明日吃蘑菇，百日之后派蒙之中已经不剩派蒙，只留蘑菇。",
            "nextDialogs": [
              "710610314"
            ]
          },
          "710610314": {
            "id": "710610314",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "#呜呜，{NICKNAME}，大蘑头讲话好可怕…",
            "nextDialogs": [
              "710610315"
            ]
          },
          "710610315": {
            "id": "710610315",
            "speakerId": 1000,
            "speakerName": "赞玛兰",
            "text": "唔，派蒙不懂幽默。",
            "nextDialogs": [
              "710610316"
            ]
          },
          "710610316": {
            "id": "710610316",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "这话一点也不幽默！",
            "nextDialogs": [
              "710610317"
            ]
          },
          "710610317": {
            "id": "710610317",
            "speakerId": 1000,
            "speakerName": "赞玛兰",
            "text": "赞玛兰摆脱了邪气，同族却仍在受苦。而今的赞玛兰力有不逮，无法像过去那般为弱者提供庇佑。",
            "nextDialogs": [
              "710610318"
            ]
          },
          "710610318": {
            "id": "710610318",
            "speakerId": 1000,
            "speakerName": "赞玛兰",
            "text": "#赞玛兰恳请{NICKNAME}，莫要吝惜哀怜，拯救无法自救的弱者吧。",
            "nextDialogs": [
              "710610319"
            ]
          },
          "710610319": {
            "id": "710610319",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "#意思是，还有其他的病怏怏的蘑菇吗？{NICKNAME}，要不要帮帮它们呢。"
          }
        }
      }
    },
    {
      "subId": "7106106",
      "subQuestName": "帮助赞玛兰的同族$HIDDEN",
      "sceneId": null,
      "locations": [],
      "dialogue": {

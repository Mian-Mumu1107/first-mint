    {
      "subId": "7106109",
      "subQuestName": "告知赞玛兰「邪气」源头已被清除",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "710610501"
        ],
        "dialogs": {
          "710610501": {
            "id": "710610501",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "喂，大蘑头，我们回来啦。你的那个什么…对了，「才慧之瑞佑」！用完了…",
            "nextDialogs": [
              "710610503"
            ]
          },
          "710610503": {
            "id": "710610503",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "不过裂口已经堵上了，现在应该没问题啦！",
            "nextDialogs": [
              "710610504"
            ]
          },
          "710610504": {
            "id": "710610504",
            "speakerId": 1000,
            "speakerName": "赞玛兰",

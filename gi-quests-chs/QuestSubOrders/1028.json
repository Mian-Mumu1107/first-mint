      }
    },
    {
      "subId": "102804",
      "subQuestName": "与众人对话",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "10280401"
        ],
        "dialogs": {
          "10280401": {
            "id": "10280401",
            "speakerId": 1000,
            "speakerName": "荒泷一斗",
            "text": "嗯？不对，怎么搞的。",
            "nextDialogs": [
              "10280402"
            ]
          },
          "10280402": {
            "id": "10280402",
            "speakerId": 1003,
            "speakerName": "派蒙",
            "text": "我们…我们怎么回来了？",
            "nextDialogs": [
              "10280403"
            ]
          },
          "10280403": {
            "id": "10280403",
            "speakerId": 1000,
            "speakerName": "荒泷一斗",
            "text": "这里是我们走过的地方？",
            "nextDialogs": [
              "10280404"
            ]
          },
          "10280404": {
            "id": "10280404",
            "speakerId": 1001,
            "speakerName": "久岐忍",
            "text": "对，是起点。",
            "nextDialogs": [
              "10280405"
            ]
          },
          "10280405": {
            "id": "10280405",
            "speakerId": 1000,
            "speakerName": "荒泷一斗",
            "text": "可我们没走错啊，刚才一路走的都是通往出口的路，没有往回。",
            "nextDialogs": [
              "10280406"
            ]
          },
          "10280406": {
            "id": "10280406",
            "speakerId": 1004,
            "speakerName": "夜兰",
            "text": "我也记得是这样。",
            "nextDialogs": [
              "10280407"
            ]
          },
          "10280407": {
            "id": "10280407",
            "speakerId": 1000,
            "speakerName": "荒泷一斗",
            "text": "旅行者，你也确定没错对吧？",
            "nextDialogs": [
              "10280408"
            ]
          },
          "10280408": {
            "id": "10280408",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "嗯，我觉得没有走错。",
            "nextDialogs": [
              "10280409"
            ]
          },
          "10280409": {
            "id": "10280409",
            "speakerId": 1003,
            "speakerName": "派蒙",
            "text": "奇怪…",
            "nextDialogs": [
              "10280410"
            ]
          },
          "10280410": {
            "id": "10280410",
            "speakerId": 1000,
            "speakerName": "荒泷一斗",
            "text": "在稻妻有种说法，商人晚上走夜路中了狸妖的奸计，整晚都在同一个地方绕个不停，直到天亮还走不出去…",
            "nextDialogs": [
              "10280411"
            ]
          },
          "10280411": {
            "id": "10280411",
            "speakerId": 1003,
            "speakerName": "派蒙",
            "text": "不就是鬼打墙嘛，我也知道哦。",
            "nextDialogs": [
              "10280412"
            ]
          },
          "10280412": {
            "id": "10280412",
            "speakerId": 1000,
            "speakerName": "荒泷一斗",
            "text": "原来大家都知道，那就好办了，我现在认为，我们就是遇到了这种怪事。",
            "nextDialogs": [
              "10280413"
            ]
          },
          "10280413": {
            "id": "10280413",
            "speakerId": 1000,
            "speakerName": "荒泷一斗",
            "text": "不过没关系，我有个帮手能驱邪，遇到这种情况，就该叫他出来了。",
            "nextDialogs": [
              "10280414"
            ]
          },
          "10280414": {
            "id": "10280414",
            "speakerId": 1003,
            "speakerName": "派蒙",
            "text": "一斗这个鬼，身边竟然有驱邪的伙伴…他心可真大啊。",
            "nextDialogs": [
              "10280415"
            ]
          },
          "10280415": {
            "id": "10280415",
            "speakerId": 1001,
            "speakerName": "久岐忍",
            "text": "迟钝是老大过得好的资本嘛。",
            "nextDialogs": [
              "10280416"
            ]
          },
          "10280416": {
            "id": "10280416",
            "speakerId": 1000,
            "speakerName": "荒泷一斗",
            "text": "来吧，阿丑！",
            "nextDialogs": [
              "10280417"
            ]
          },
          "10280417": {
            "id": "10280417",
            "speakerId": 1002,
            "speakerName": "阿丑",
            "text": "哞——！",
            "nextDialogs": [
              "10280418"
            ]
          },
          "10280418": {
            "id": "10280418",
            "speakerId": 1000,
            "speakerName": "荒泷一斗",
            "text": "这就是咱们荒泷派编外成员，阿丑。",
            "nextDialogs": [
              "10280419"
            ]
          },
          "10280419": {
            "id": "10280419",
            "speakerId": 1002,
            "speakerName": "阿丑",
            "text": "哞哞。",
            "nextDialogs": [
              "10280420"
            ]
          },
          "10280420": {
            "id": "10280420",
            "speakerId": 1000,
            "speakerName": "荒泷一斗",
            "text": "哦，阿丑在向大家问好呢。你们叫他阿丑也行，丑哥也行。阿丑可擅长找路了，一会儿就让他带我们走。",
            "nextDialogs": [
              "10280421"
            ]
          },
          "10280421": {
            "id": "10280421",
            "speakerId": 1004,
            "speakerName": "夜兰",
            "text": "原来还有编外成员…",
            "nextDialogs": [
              "10280422"
            ]
          },
          "10280422": {
            "id": "10280422",
            "speakerId": 1005,
            "speakerName": "烟绯",
            "text": "我觉得不像靠谱的样子。",
            "nextDialogs": [
              "10280423"
            ]
          },
          "10280423": {
            "id": "10280423",
            "speakerId": 1004,
            "speakerName": "夜兰",
            "text": "谁知道。",
            "nextDialogs": [
              "10280424"
            ]
          },
          "10280424": {
            "id": "10280424",
            "speakerId": 1000,
            "speakerName": "荒泷一斗",
            "text": "阿丑，去！给兄弟们找条明路。",
            "nextDialogs": [
              "10280425"
            ]
          },
          "10280425": {
            "id": "10280425",
            "speakerId": 1002,
            "speakerName": "阿丑",
            "text": "哞——！",
            "nextDialogs": [
              "10280426"
            ]
          },
          "10280426": {
            "id": "10280426",
            "speakerId": 1006,
            "speakerName": "Black Screen",
            "text": "阿丑开始在四周寻找是否有隐藏的出口…",
            "nextDialogs": [
              "10280427"
            ]
          },
          "10280427": {
            "id": "10280427",
            "speakerId": 1002,
            "speakerName": "阿丑",
            "text": "哞…哞哞…哞！",
            "nextDialogs": [
              "10280428"
            ]
          },
          "10280428": {
            "id": "10280428",
            "speakerId": 1000,
            "speakerName": "荒泷一斗",
            "text": "嗯？噢噢…啊？！不会吧？！",
            "nextDialogs": [
              "10280429"
            ]
          },
          "10280429": {
            "id": "10280429",
            "speakerId": 1003,
            "speakerName": "派蒙",
            "text": "怎么了？",
            "nextDialogs": [
              "10280430"
            ]
          },
          "10280430": {
            "id": "10280430",
            "speakerId": 1000,
            "speakerName": "荒泷一斗",
            "text": "阿丑说，他沿路找遍了，根本没有出口。",
            "nextDialogs": [
              "10280431"
            ]
          },
          "10280431": {
            "id": "10280431",
            "speakerId": 1000,
            "speakerName": "荒泷一斗",
            "text": "可我们既然能进来，没理由出不去啊。不行…我去看看。",
            "nextDialogs": [
              "10280432"
            ]
          },
          "10280432": {
            "id": "10280432",
            "speakerId": 1005,
            "speakerName": "烟绯",
            "text": "你们注意到了吗？起初我们以为自己是从上空掉下来的，那时头上还有高不见顶的出口…现在出口也消失了。",
            "nextDialogs": [
              "10280433"
            ]
          },
          "10280433": {
            "id": "10280433",
            "speakerId": 1005,
            "speakerName": "烟绯",
            "text": "怎么会这样？",
            "nextDialogs": [
              "10280434"
            ]
          },
          "10280434": {
            "id": "10280434",
            "speakerId": 1001,
            "speakerName": "久岐忍",
            "text": "看来，地下这些建筑不是我们想的那么简单。",
            "nextDialogs": [
              "10280435"
            ]
          },
          "10280435": {
            "id": "10280435",
            "speakerId": 1004,
            "speakerName": "夜兰",
            "text": "…我四处检查一下。",
            "nextDialogs": [
              "10280436"
            ]
          },
          "10280436": {
            "id": "10280436",
            "speakerId": 1003,
            "speakerName": "派蒙",
            "text": "这里四处都是岩壁，会不会…会不会是我们记错了，其实我们根本不是从这里掉下来的！",
            "nextDialogs": [
              "10280437"
            ]
          },
          "10280437": {
            "id": "10280437",
            "speakerId": 1000,
            "speakerName": "荒泷一斗",
            "text": "喂，你是在害怕吗？",
            "nextDialogs": [
              "10280438"
            ]
          },
          "10280438": {
            "id": "10280438",
            "speakerId": 1003,
            "speakerName": "派蒙",
            "text": "我、我可没有那么胆小！",
            "nextDialogs": [
              "10280439"
            ]
          },
          "10280439": {
            "id": "10280439",
            "speakerId": 1002,
            "speakerName": "阿丑",
            "text": "哞——",
            "nextDialogs": [
              "10280440"
            ]
          },
          "10280440": {
            "id": "10280440",
            "speakerId": 1000,
            "speakerName": "荒泷一斗",
            "text": "阿丑也觉得你害怕了。没关系，害怕就说出来，我们保护你。",
            "nextDialogs": [
              "10280441"
            ]
          },
          "10280441": {
            "id": "10280441",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "派蒙，有我在。",
            "nextDialogs": [
              "10280442"
            ]
          },
          "10280442": {
            "id": "10280442",
            "speakerId": 1000,
            "speakerName": "荒泷一斗",
            "text": "#愣着也不是办法，再找找路吧。阿忍，你陪着恩人，我带{NICKNAME}和派蒙。",
            "nextDialogs": [
              "10280443"
            ]
          },
          "10280443": {
            "id": "10280443",
            "speakerId": 1001,
            "speakerName": "久岐忍",
            "text": "好，大家都要注意安全。",
            "nextDialogs": [
              "10280444"
            ]
          },
          "10280444": {
            "id": "10280444",
            "speakerId": 1005,
            "speakerName": "烟绯",
            "text": "恩人什么的，言重了，叫烟绯就行。一斗先生不愧是帮派老大，很有领导力嘛。",
            "nextDialogs": [
              "10280445"
            ]
          },
          "10280445": {
            "id": "10280445",
            "speakerId": 1000,
            "speakerName": "荒泷一斗",
            "text": "哪里哪里，你叫我一斗就行。既然说好都是同伴，就该彼此照顾。派蒙，怕的话本大爷可以捂住你的眼睛。",
            "nextDialogs": [
              "10280446"
            ]
          },
          "10280446": {
            "id": "10280446",
            "speakerId": 1006,
            "speakerName": "Black Screen",
            "text": "众人兵分几路，检查了四周的环境，但并无收获…",
            "nextDialogs": [
              "10280447"
            ]
          },
          "10280447": {
            "id": "10280447",
            "speakerId": 1000,
            "speakerName": "荒泷一斗",
            "text": "…唉。",
            "nextDialogs": [
              "10280448"
            ]
          },
          "10280448": {
            "id": "10280448",
            "speakerId": 1003,
            "speakerName": "派蒙",
            "text": "真的没有出口…",
            "nextDialogs": [
              "10280449"
            ]
          },
          "10280449": {
            "id": "10280449",
            "speakerId": 1002,
            "speakerName": "阿丑",
            "text": "哞！",
            "nextDialogs": [
              "10280450"
            ]
          },
          "10280450": {
            "id": "10280450",
            "speakerId": 1000,
            "speakerName": "荒泷一斗",
            "text": "我觉得，这地方有问题。",
            "nextDialogs": [
              "10280451"
            ]
          },
          "10280451": {
            "id": "10280451",
            "speakerId": 1001,
            "speakerName": "久岐忍",
            "text": "老大，你们那里怎么样？",
            "nextDialogs": [
              "10280452"
            ]
          },
          "10280452": {
            "id": "10280452",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "没有收获。",
            "nextDialogs": [
              "10280453"
            ]
          },
          "10280453": {
            "id": "10280453",
            "speakerId": 1000,
            "speakerName": "荒泷一斗",
            "text": "而且就在刚才，我余光好像瞥到几个人影…别是真闹鬼了吧。",
            "nextDialogs": [
              "10280454"
            ]
          },
          "10280454": {
            "id": "10280454",
            "speakerId": 1003,
            "speakerName": "派蒙",
            "text": "虽然现在气氛很不对劲，但我还是要说，一斗，你自己不就是鬼吗？",
            "nextDialogs": [
              "10280455"
            ]
          },
          "10280455": {
            "id": "10280455",
            "speakerId": 1000,
            "speakerName": "荒泷一斗",
            "text": "不是啦！我是说那种，那种忽闪忽闪，一会儿有一会儿没的。",
            "nextDialogs": [
              "10280456"
            ]
          },
          "10280456": {
            "id": "10280456",
            "speakerId": 1003,
            "speakerName": "派蒙",
            "text": "嗯？一斗，其实…你怕鬼吗？",
            "nextDialogs": [
              "10280457"
            ]
          },
          "10280457": {
            "id": "10280457",
            "speakerId": 1001,
            "speakerName": "久岐忍",
            "text": "啊呀。被人家看出来了呢，老大。",
            "nextDialogs": [
              "10280458"
            ]
          },
          "10280458": {
            "id": "10280458",
            "speakerId": 1000,
            "speakerName": "荒泷一斗",
            "text": "我、我哪有！你们不许乱说。",
            "nextDialogs": [
              "10280459"
            ]
          },
          "10280459": {
            "id": "10280459",
            "speakerId": 1003,
            "speakerName": "派蒙",
            "text": "嘻嘻，看你这样我忽然不怕了…喂放牛的，要是害怕的话，我可以捂着你的眼睛哦。",
            "nextDialogs": [
              "10280460"
            ]
          },
          "10280460": {
            "id": "10280460",
            "speakerId": 1001,
            "speakerName": "久岐忍",
            "text": "……",
            "nextDialogs": [
              "10280461"
            ]
          },
          "10280461": {
            "id": "10280461",
            "speakerId": 1001,
            "speakerName": "久岐忍",
            "text": "看来，我得找点别的事做了。",
            "nextDialogs": [
              "10280462"
            ]
          },
          "10280462": {
            "id": "10280462",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "（嗯？阿忍走到一旁，似乎找了几块石头，又从口袋拿出树枝和堇瓜…嗯嗯？）",
            "nextDialogs": [
              "10280463"
            ]
          },
          "10280463": {
            "id": "10280463",
            "speakerId": 1001,
            "speakerName": "久岐忍",
            "text": "放点盐…胡椒也来一点。",
            "nextDialogs": [
              "10280464"
            ]
          },
          "10280464": {
            "id": "10280464",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "请问你是在烤堇瓜吗？",
            "nextDialogs": [
              "10280465"
            ]
          },
          "10280465": {
            "id": "10280465",
            "speakerId": 1001,
            "speakerName": "久岐忍",
            "text": "对。烤堇瓜很好吃，一会儿你也尝尝吧。",
            "nextDialogs": [
              "10280466"
            ]
          },
          "10280466": {
            "id": "10280466",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "好。",
            "nextDialogs": [
              "10280467"
            ]
          },
          "10280467": {
            "id": "10280467",
            "speakerId": 1001,
            "speakerName": "久岐忍",
            "text": "唔…有甜咸两种，你喜欢哪种？",
            "nextDialogs": [
              "10280468"
            ]
          },
          "10280468": {
            "id": "10280468",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "都可以。",
            "nextDialogs": [
              "10280469"
            ]
          },
          "10280469": {
            "id": "10280469",
            "speakerId": 1001,
            "speakerName": "久岐忍",
            "text": "嗯，那就都试试好了。越是现在这种场合，越要稳定精神。",
            "nextDialogs": [
              "10280470"
            ]
          },
          "10280470": {
            "id": "10280470",
            "speakerId": 1001,
            "speakerName": "久岐忍",
            "text": "如果我没猜错的话，这里可能藏着不方便让我和老大知道的秘密。不过别担心，我会注意不让老大打扰你们讨论机密的。",
            "nextDialogs": [
              "10280471"
            ]
          },
          "10280471": {
            "id": "10280471",
            "speakerId": 1005,
            "speakerName": "烟绯",
            "text": "哇，居然在烤东西吃。",
            "nextDialogs": [
              "10280472"
            ]
          },
          "10280472": {
            "id": "10280472",
            "speakerId": 1001,
            "speakerName": "久岐忍",
            "text": "烟绯小姐要来一点吗？",
            "nextDialogs": [
              "10280473"
            ]
          },
          "10280473": {
            "id": "10280473",
            "speakerId": 1005,
            "speakerName": "烟绯",
            "text": "我不饿，你们先吃吧。",
            "nextDialogs": [
              "10280474"
            ]
          },
          "10280474": {
            "id": "10280474",
            "speakerId": 1005,
            "speakerName": "烟绯",
            "text": "说起来，跟阿忍也是好久没见了。",
            "nextDialogs": [
              "10280475"
            ]
          },
          "10280475": {
            "id": "10280475",
            "speakerId": 1001,
            "speakerName": "久岐忍",
            "text": "是啊。上回见面还是我在璃月念书的时候了，你来替我的老师代了一节课。",
            "nextDialogs": [
              "10280476"
            ]
          },
          "10280476": {
            "id": "10280476",
            "speakerId": 1005,
            "speakerName": "烟绯",
            "text": "代课…啊，想起来了，是有一年的冬天对吧？",
            "nextDialogs": [
              "10280477"
            ]
          },
          "10280477": {
            "id": "10280477",
            "speakerId": 1001,
            "speakerName": "久岐忍",
            "text": "对，大家都说你讲课很有趣。这么说来…应该叫你一声师姐才对。",
            "nextDialogs": [
              "10280478"
            ]
          },
          "10280478": {
            "id": "10280478",
            "speakerId": 1005,
            "speakerName": "烟绯",
            "text": "嗯嗯，这个叫法真不错，我喜欢！",
            "nextDialogs": [
              "10280479"
            ]
          },
          "10280479": {
            "id": "10280479",
            "speakerId": 1005,
            "speakerName": "烟绯",
            "text": "没想到会跟师妹一起遇到这种意外，也算是缘分了。",
            "nextDialogs": [
              "10280480"
            ]
          },
          "10280480": {
            "id": "10280480",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "烟绯还会讲课，真厉害。",
            "nextDialogs": [
              "10280481"
            ]
          },
          "10280481": {
            "id": "10280481",
            "speakerId": 1001,
            "speakerName": "久岐忍",
            "text": "而且风格诙谐幽默，寓教于乐，很受学生欢迎哦。",
            "nextDialogs": [
              "10280482"
            ]
          },
          "10280482": {
            "id": "10280482",
            "speakerId": 1005,
            "speakerName": "烟绯",
            "text": "哈哈哈，师妹真是过奖。",
            "nextDialogs": [
              "10280483"
            ]
          },
          "10280483": {
            "id": "10280483",
            "speakerId": 1004,
            "speakerName": "夜兰",
            "text": "几位，都在啊。",
            "nextDialogs": [
              "10280484"
            ]
          },
          "10280484": {
            "id": "10280484",
            "speakerId": 1005,
            "speakerName": "烟绯",
            "text": "夜兰，我们分头找过了，这附近没有出口。你呢？有什么收获吗？",
            "nextDialogs": [
              "10280485"
            ]
          },
          "10280485": {
            "id": "10280485",
            "speakerId": 1004,
            "speakerName": "夜兰",
            "text": "没有。",
            "nextDialogs": [
              "10280486"
            ]
          },
          "10280486": {
            "id": "10280486",
            "speakerId": 1004,
            "speakerName": "夜兰",
            "text": "而且…虽然我不想这么说，但还是做好心理准备吧。",
            "nextDialogs": [
              "10280487"
            ]
          },
          "10280487": {
            "id": "10280487",
            "speakerId": 1004,
            "speakerName": "夜兰",
            "text": "如果一直找不到路，我们也许会在地下待一段时间。",
            "nextDialogs": [
              "10280488"
            ]
          },
          "10280488": {
            "id": "10280488",
            "speakerId": 1005,
            "speakerName": "烟绯",
            "text": "…我想也是。",
            "nextDialogs": [
              "10280489"
            ]
          },
          "10280489": {
            "id": "10280489",
            "speakerId": 1001,
            "speakerName": "久岐忍",
            "text": "…明白了。",
            "nextDialogs": [
              "10280490"
            ]
          },
          "10280490": {
            "id": "10280490",
            "speakerId": 1004,
            "speakerName": "夜兰",
            "text": "但世上不应存在只能进不能出的地下空间，这不合理…我会继续想办法。",
            "nextDialogs": [
              "10280491"
            ]
          },
          "10280491": {
            "id": "10280491",
            "speakerId": 1004,
            "speakerName": "夜兰",
            "text": "各位假如找到疑似出口的地方，也千万记得在保证安全的前提下进行探索。",
            "nextDialogs": [
              "10280492"
            ]
          },
          "10280492": {
            "id": "10280492",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "（说起来，魈也在这里。还记得他提过，如果遇到棘手的情况，可以呼唤他的名字。）",
            "nextDialogs": [
              "10280493"
            ]
          },
          "10280493": {
            "id": "10280493",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "（…嗯，或许是个办法。）",
            "nextDialogs": [
              "10280494"
            ]
          },
          "10280494": {
            "id": "10280494",
            "speakerId": 1003,
            "speakerName": "派蒙",
            "text": "喂喂，看你神情严肃，是要做什么吗？",
            "nextDialogs": [
              "10280495"
            ]
          },
          "10280495": {
            "id": "10280495",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "你记不记得，魈也在这里。",
            "nextDialogs": [
              "10280496"
            ]
          },
          "10280496": {
            "id": "10280496",
            "speakerId": 1003,
            "speakerName": "派蒙",
            "text": "魈…对哦！你是不是想叫他来帮忙？",
            "nextDialogs": [
              "10280497"
            ]
          },
          "10280497": {
            "id": "10280497",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "我认为可以一试。",
            "nextDialogs": [
              "10280498"
            ]
          },
          "10280498": {
            "id": "10280498",
            "speakerId": 1003,
            "speakerName": "派蒙",
            "text": "好，试试看！",
            "nextDialogs": [
              "10280499"
            ]
          },
          "10280499": {
            "id": "10280499",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "……",
            "nextDialogs": [
              "10280500"
            ]
          },
          "10280500": {
            "id": "10280500",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "魈，能听见吗？",
            "nextDialogs": [
              "10280501"
            ]
          },
          "10280501": {
            "id": "10280501",
            "speakerId": 1003,
            "speakerName": "派蒙",
            "text": "……",
            "nextDialogs": [
              "10280502"
            ]
          },
          "10280502": {
            "id": "10280502",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "……",
            "nextDialogs": [
              "10280503"
            ]
          },
          "10280503": {
            "id": "10280503",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "魈？",
            "nextDialogs": [
              "10280504"
            ]
          },
          "10280504": {
            "id": "10280504",
            "speakerId": 1003,
            "speakerName": "派蒙",
            "text": "没有回应…我还以为魈无论在哪都会赶过来呢。",
            "nextDialogs": [
              "10280505"
            ]
          },
          "10280505": {
            "id": "10280505",
            "speakerId": 1003,
            "speakerName": "派蒙",
            "text": "难道说，就连魈都感觉不到我们的气息吗？",
            "nextDialogs": [
              "10280506"
            ]
          },
          "10280506": {
            "id": "10280506",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "（……）",
            "nextDialogs": [
              "10280507"
            ]
          },
          "10280507": {
            "id": "10280507",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "（如果真是如此，将意味着什么？我们身处的这片地下…究竟是怎么回事？）"
          }
        }
      }
    },
    {

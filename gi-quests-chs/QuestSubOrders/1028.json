    {
      "subId": "102808",
      "subQuestName": "确认秘境是否通向外界",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "10280801"
        ],
        "dialogs": {
          "10280801": {
            "id": "10280801",
            "speakerId": 1000,
            "speakerName": "荒泷一斗",
            "text": "不行，我要再去看一次。拿出我荒泷天下独尊…",
            "nextDialogs": [
              "10280802"
            ]
          },
          "10280802": {
            "id": "10280802",
            "speakerId": 1001,
            "speakerName": "久岐忍",
            "text": "老大。",
            "nextDialogs": [
              "10280803"
            ]
          },
          "10280803": {
            "id": "10280803",
            "speakerId": 1000,
            "speakerName": "荒泷一斗",
            "text": "噫！干嘛那么严肃嘛。",
            "nextDialogs": [
              "10280804"
            ]
          },
          "10280804": {
            "id": "10280804",
            "speakerId": 1001,
            "speakerName": "久岐忍",
            "text": "烤堇瓜。",
            "nextDialogs": [
              "10280805"
            ]
          },
          "10280805": {
            "id": "10280805",
            "speakerId": 1000,
            "speakerName": "荒泷一斗",
            "text": "哈？发生了那么大的事情，你就叫我在这烤堇瓜？",
            "nextDialogs": [
              "10280806"
            ]
          },
          "10280806": {
            "id": "10280806",
            "speakerId": 1002,
            "speakerName": "阿丑",
            "text": "哞！哞。",
            "nextDialogs": [
              "10280807"
            ]
          },
          "10280807": {
            "id": "10280807",
            "speakerId": 1000,
            "speakerName": "荒泷一斗",
            "text": "听见没，阿丑都说你说得对…等等，阿丑你又是帮哪边的？",
            "nextDialogs": [
              "10280808"
            ]
          },
          "10280808": {
            "id": "10280808",
            "speakerId": 1002,
            "speakerName": "阿丑",
            "text": "哞…",
            "nextDialogs": [
              "10280809"
            ]
          },
          "10280809": {
            "id": "10280809",
            "speakerId": 1001,
            "speakerName": "久岐忍",
            "text": "后勤是很重要的。保持充沛的体力和稳定的精神状态，才能应对未知。",
            "nextDialogs": [
              "10280810"
            ]
          },
          "10280810": {
            "id": "10280810",
            "speakerId": 1001,
            "speakerName": "久岐忍",
            "text": "阿丑也知道这个道理。",
            "nextDialogs": [
              "10280811"
            ]
          },
          "10280811": {
            "id": "10280811",
            "speakerId": 1000,
            "speakerName": "荒泷一斗",
            "text": "好啊，你们一个两个的…这就已经吃上了？",
            "nextDialogs": [
              "10280812"
            ]
          },
          "10280812": {
            "id": "10280812",
            "speakerId": 1000,
            "speakerName": "荒泷一斗",
            "text": "等等，已经熟了？香倒是挺香的…嗯…",
            "nextDialogs": [
              "10280813"
            ]
          },
          "10280813": {
            "id": "10280813",
            "speakerId": 1000,
            "speakerName": "荒泷一斗",
            "text": "好吧，那就先垫垫肚子再想办法。别把堇瓜吃完了，也给我留两个啊！"
          }
        }
      }
    },
    {
      "subId": "102803",
      "subQuestName": "离开秘境",
      "sceneId": null,
      "locations": [],

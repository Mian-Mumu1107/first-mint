    },
    {
      "subId": "102805",
      "subQuestName": "与众人对话",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "10280601"
        ],
        "dialogs": {
          "10280601": {
            "id": "10280601",
            "speakerId": 1005,
            "speakerName": "烟绯",
            "text": "没想到我们会被困在这个地方，这下可真是难办了。",
            "nextDialogs": [
              "10280602"
            ]
          },
          "10280602": {
            "id": "10280602",
            "speakerId": 1005,
            "speakerName": "烟绯",
            "text": "就算我博学广闻，那也是在律法领域之内。我可不懂什么「越狱」的知识…",
            "nextDialogs": [
              "10280603"
            ]
          },
          "10280603": {
            "id": "10280603",
            "speakerId": 1005,
            "speakerName": "烟绯",
            "text": "亏我还和老爹定过「要快乐生活」的契约呢…唉，至少我不能消沉。",
            "nextDialogs": [
              "10280604"
            ]
          },
          "10280604": {
            "id": "10280604",
            "speakerId": 1005,
            "speakerName": "烟绯",
            "text": "往好处想，能来新地方开开眼界，还能和旧友重逢，都是好事。",
            "nextDialogs": [
              "10280605"
            ]
          },
          "10280605": {
            "id": "10280605",
            "speakerId": 1005,
            "speakerName": "烟绯",
            "text": "嗯嗯…对，好事。嗯…"
          }
        }
      }
    },
    {
      "subId": "102802",
      "subQuestName": "与众人对话",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "10280701"
        ],
        "dialogs": {
          "10280701": {
            "id": "10280701",
            "speakerId": 1004,
            "speakerName": "夜兰",
            "text": "现在情况严峻，暂时找不到出口。要做好多待一段时间的心理准备。",
            "nextDialogs": [
              "10280702"
            ]
          },
          "10280702": {
            "id": "10280702",
            "speakerId": 1004,
            "speakerName": "夜兰",
            "text": "好在物资看起来还不缺。这支拼拼凑凑的队伍里，也有擅于应对危机的人。",
            "nextDialogs": [
              "10280703"
            ]
          },
          "10280703": {
            "id": "10280703",
            "speakerId": 1004,
            "speakerName": "夜兰",
            "text": "照顾好你们自己。剩下的，我来想办法。"
          }
        }
      }
    },

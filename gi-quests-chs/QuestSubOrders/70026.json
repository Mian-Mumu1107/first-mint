    "胡塞尼": 40
  },
  "subQuests": [
    {
      "subId": "7002601",
      "subQuestName": "与凯瑟琳对话",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "700260101"
        ],
        "dialogs": {
          "700260101": {
            "id": "700260101",
            "speakerId": 3004,
            "speakerName": "凯瑟琳",
            "text": "你好，旅行者，我们又见面了。",
            "nextDialogs": [
              "700260102"
            ]
          },
          "700260102": {
            "id": "700260102",
            "speakerId": 3004,
            "speakerName": "凯瑟琳",
            "text": "你最近的委托接取和完成记录都非常漂亮，说是冒险家协会的明星会员也不为过。",
            "nextDialogs": [
              "700260104",
              "700260106"
            ]
          },
          "700260104": {
            "id": "700260104",
            "speakerId": 3004,
            "speakerName": "凯瑟琳",
            "text": "我们冒险家协会稻妻分会和其他分会平时就有交流，你在蒙德和璃月的事迹我们都听说了，你就不用谦虚了。",
            "nextDialogs": [
              "700260107"
            ]
          },
          "700260107": {
            "id": "700260107",
            "speakerId": 3004,
            "speakerName": "凯瑟琳",
            "text": "这次请你过来，其实是想请你考虑一份比较简单的调查委托，需要调查的区域位于鹤观。",
            "nextDialogs": [
              "700260108"
            ]
          },
          "700260108": {
            "id": "700260108",
            "speakerId": 3004,
            "speakerName": "凯瑟琳",
            "text": "虽说鹤观地区的天气比较特别，经常有大雾笼罩，但只是进行调查任务的话，应该不会有太大危险。",
            "nextDialogs": [
              "700260109"
            ]
          },
          "700260109": {
            "id": "700260109",
            "speakerId": 3004,
            "speakerName": "凯瑟琳",
            "text": "协会曾经将这份委托分派给一位比较有经验的冒险家，但这位冒险家前往鹤观后，很快就回来取消了委托。",
            "nextDialogs": [
              "700260110"
            ]
          },
          "700260110": {
            "id": "700260110",
            "speakerId": 3004,
            "speakerName": "凯瑟琳",
            "text": "他也未做过多说明，只是匆忙说明自己能力有限，放弃了这个委托。",
            "nextDialogs": [
              "700260111"
            ]
          },
          "700260111": {
            "id": "700260111",
            "speakerId": 3004,
            "speakerName": "凯瑟琳",
            "text": "可是在他之后，这份委托挂了很久也没有人接，委托人也来问了很多次…",
            "nextDialogs": [
              "700260112"
            ]
          },
          "700260112": {
            "id": "700260112",
            "speakerId": 3004,
            "speakerName": "凯瑟琳",
            "text": "所以我想，如果请一位生存能力优更优秀、冒险经验也更丰富的冒险家，应该能完美解决这份委托。",
            "nextDialogs": [
              "700260113"
            ]
          },
          "700260113": {
            "id": "700260113",
            "speakerId": 3004,
            "speakerName": "凯瑟琳",
            "text": "于是我想到了你。旅行者，你觉得怎么样呢？"
          },
          "700260106": {
            "id": "700260106",
            "speakerId": 3004,
            "speakerName": "凯瑟琳",
            "text": "你果然和传说中的一样，是个爽快的人呀。"
          }
        }
      }
    },
    {
      "subId": "7002602",
      "subQuestName": "前往指定区域进行调查",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "700260201"
        ],
        "dialogs": {
          "700260201": {
            "id": "700260201",
            "speakerId": 12913,
            "speakerName": "凯瑟琳",
            "text": "旅行者，你回来了啊，情况怎么样？",
            "nextDialogs": [
              "700260202"
            ]
          },
          "700260202": {
            "id": "700260202",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "关于「会复活的遗迹重机」…",
            "nextDialogs": [
              "700260203"
            ]
          },
          "700260203": {
            "id": "700260203",
            "speakerId": 12913,
            "speakerName": "凯瑟琳",
            "text": "出现在调查区域的奇怪遗迹重机，不管打倒多少次都会重新站起来…这个情况委托人完全没有提过。",
            "nextDialogs": [
              "700260204"
            ]
          },
          "700260204": {
            "id": "700260204",
            "speakerId": 12913,
            "speakerName": "凯瑟琳",
            "text": "难怪之前那位冒险家一副不想多提的样子，应该是在那个奇怪的遗迹重机那里吃了亏吧。",
            "nextDialogs": [
              "700260205"
            ]
          },
          "700260205": {
            "id": "700260205",
            "speakerId": 12913,
            "speakerName": "凯瑟琳",
            "text": "这种严重影响冒险家生命安全的事，应该早点跟我们说明才是。",
            "nextDialogs": [
              "700260206"
            ]
          },
          "700260206": {
            "id": "700260206",
            "speakerId": 12913,
            "speakerName": "凯瑟琳",
            "text": "明明在填写委托内容说明的时候还特别讲了要坦诚清晰的，胡塞尼先生怎么能这样？",
            "nextDialogs": [
              "700260207"
            ]
          },
          "700260207": {
            "id": "700260207",
            "speakerId": 12913,
            "speakerName": "凯瑟琳",
            "text": "语焉不详、内容错漏，最近越来越多委托内容说明都是这样，这样叫协会怎么给冒险家分配任务呢，真是的…",
            "nextDialogs": [
              "700260209",
              "700260211"
            ]
          },
          "700260209": {
            "id": "700260209",
            "speakerId": 12913,
            "speakerName": "凯瑟琳",
            "text": "我倒还好了，只是希望委托人在前期发布委托时，能够跟协会沟通清楚吧。",
            "nextDialogs": [
              "700260212"
            ]
          },
          "700260212": {
            "id": "700260212",
            "speakerId": 12913,
            "speakerName": "凯瑟琳",
            "text": "不好意思，没忍住就说了这些多余的话。",
            "nextDialogs": [
              "700260213"
            ]
          },
          "700260213": {
            "id": "700260213",
            "speakerId": 12913,
            "speakerName": "凯瑟琳",
            "text": "总之，我认为合理的处理办法是由你直接和委托人沟通，直接把「会复活的遗迹重机」的情况告诉他本人，降低沟通成本。",
            "nextDialogs": [
              "700260214"
            ]
          },
          "700260214": {
            "id": "700260214",
            "speakerId": 12913,
            "speakerName": "凯瑟琳",
            "text": "看看他是否能接受这样的调查结果，这样还要继续调查的话，委托人本人也应该一起想想解决办法。",
            "nextDialogs": [
              "700260215"
            ]
          },
          "700260215": {
            "id": "700260215",
            "speakerId": 12913,
            "speakerName": "凯瑟琳",
            "text": "我这里也会做好情况登记工作，如果这个委托还要继续的话，协会随时都可以为你提供援助。",
            "nextDialogs": [
              "700260216"
            ]
          },
          "700260216": {
            "id": "700260216",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "我明白了。",
            "nextDialogs": [
              "700260217"
            ]
          },
          "700260217": {
            "id": "700260217",
            "speakerId": 12913,
            "speakerName": "凯瑟琳",
            "text": "那就辛苦你去和委托人胡塞尼先生谈一谈了。"
          },
          "700260211": {
            "id": "700260211",
            "speakerId": 12913,
            "speakerName": "凯瑟琳",
            "text": "代表协会和委托人们沟通毕竟是我的工作内容之一，这也是冒险的一部分…吧。"
          }
        }
      }
    },
    {
      "subId": "7002603",
      "subQuestName": "向凯瑟琳回报",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [],
        "dialogs": {}
      }
    },
    {
      "subId": "7002604",
      "subQuestName": "询问胡塞尼",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "700260301"
        ],
        "dialogs": {
          "700260301": {
            "id": "700260301",
            "speakerId": 30068,
            "speakerName": "胡塞尼",
            "text": "鹤观的研究工作…",
            "nextDialogs": [
              "700260304"
            ]
          },
          "700260304": {
            "id": "700260304",
            "speakerId": 30068,
            "speakerName": "胡塞尼",
            "text": "哦哦，我刚收到冒险家协会的情况说明时，就在猜接委托的是不是你，果然是你啊。",
            "nextDialogs": [
              "700260305"
            ]
          },
          "700260305": {
            "id": "700260305",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "这次的调查委托…",
            "nextDialogs": [
              "700260306"
            ]
          },
          "700260306": {
            "id": "700260306",
            "speakerId": 30068,
            "speakerName": "胡塞尼",
            "text": "唉，我知道你要说什么，凯瑟琳小姐刚刚跟我发了好大一通牢骚，我已经大致明白情况了。",
            "nextDialogs": [
              "700260307"
            ]
          },
          "700260307": {
            "id": "700260307",
            "speakerId": 30068,
            "speakerName": "胡塞尼",
            "text": "在我委托你们调查的区域，出现了「会复活的遗迹重机」对吧？"
          }
        }
      }
    }
  ]
}
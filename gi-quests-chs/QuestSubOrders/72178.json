          },
          "721780304": {
            "id": "721780304",
            "speakerId": 20335,
            "speakerName": "神龛",
            "text": "（这座神龛木料稍旧，但良好的维护使外表暗淡的颜色也不显得破败，反而更有韵味。）",
            "nextDialogs": [

        ],
        "dialogs": {
          "721780201": {
            "id": "721780201",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "这里也有一座神龛，我们去看看吧？",
            "nextDialogs": [
              "721780202"
            ]
          },
          "721780202": {
            "id": "721780202",
            "speakerId": 20335,
            "speakerName": "神龛",
            "text": "（看起来很普通的神龛，并没有任何奇特的元素痕迹。）",
            "nextDialogs": [
              "721780203"
            ]
          },
          "721780203": {
            "id": "721780203",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "调查",
            "nextDialogs": [
              "721780204"
            ]
          },
          "721780204": {
            "id": "721780204",
            "speakerId": 20335,
            "speakerName": "神龛",
            "text": "（这座神龛看起来干净整洁，散发着淡淡的神樱香气。或许不久前有人在此处祈祷过。）",
            "nextDialogs": [
              "721780205"
            ]
          },
          "721780205": {
            "id": "721780205",
            "speakerId": 20335,
            "speakerName": "神龛",
            "text": "（但除此之外，并没有更新近的痕迹。）",
            "nextDialogs": [
              "721780206"
            ]
          },
          "721780206": {
            "id": "721780206",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "是神樱花瓣的气味呢…长次的妈妈或许来过！",
            "nextDialogs": [
              "721780207"
            ]
          },
          "721780207": {
            "id": "721780207",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "而且一定是不久前！"
          }
        }
      }
    },
    {

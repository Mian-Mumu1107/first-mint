        "dialogs": {
          "721780301": {
            "id": "721780301",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "这座神龛看起来好新，我们调查一下吧！",
            "nextDialogs": [
              "721780302"
            ]
          },
          "721780302": {
            "id": "721780302",
            "speakerId": 20335,
            "speakerName": "神龛",
            "text": "（看起来很普通的神龛，并没有任何奇特的元素痕迹。）",
            "nextDialogs": [
              "721780303"
            ]
          },
          "721780303": {
            "id": "721780303",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "调查",
            "nextDialogs": [

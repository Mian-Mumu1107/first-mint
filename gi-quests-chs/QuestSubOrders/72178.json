        ],
        "dialogs": {
          "721780101": {
            "id": "721780101",
            "speakerId": 20335,
            "speakerName": "神龛",
            "text": "（看起来很普通的神龛，并没有任何奇特的元素痕迹。）",
            "nextDialogs": [
              "721780102"
            ]
          },
          "721780102": {
            "id": "721780102",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "调查",
            "nextDialogs": [
              "721780103"
            ]
          },
          "721780103": {
            "id": "721780103",
            "speakerId": 20335,
            "speakerName": "神龛",
            "text": "（这座神龛看起来状态良好，似乎不久前才被精心照料过。打理这里的，或许是一个细心的人。）",
            "nextDialogs": [
              "721780104"
            ]
          },
          "721780104": {
            "id": "721780104",
            "speakerId": 20335,
            "speakerName": "神龛",
            "text": "（但除此之外，并没有谁来过的痕迹。）",
            "nextDialogs": [
              "721780105"
            ]
          },
          "721780105": {
            "id": "721780105",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "奇怪呢…好像有人来过。"
          }
        }
      }
    },

          },
          "759490102": {
            "id": "759490102",
            "speakerId": 1000,
            "speakerName": "夏贝瓦",
            "text": "这、这个嘛，已经在研究了，在研究了！比方说，火山与摔角招式之间，就存在着某种关联…",
            "nextDialogs": [

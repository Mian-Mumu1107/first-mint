            ]
          },
          "759490103": {
            "id": "759490103",
            "speakerId": 1000,
            "speakerName": "夏贝瓦",
            "text": "「众生的角逐铸就了今日的历史，因而摔角即是历史之音」，此事在祭司王马古汉留下的织卷中亦有记载…",
            "nextDialogs": [
              "759490104"
            ]
          },
          "759490104": {
            "id": "759490104",
            "speakerId": 1000,
            "speakerName": "夏贝瓦",
            "text": "…啊，不对，并没有记载。这句话好像是桑哈杰大师胡说的…",
            "nextDialogs": [
              "759490105"
            ]
          },
          "759490105": {
            "id": "759490105",
            "speakerId": 1000,
            "speakerName": "夏贝瓦",
            "text": "总之，「角逐」也确实是纳塔历史重要的一环，所以研究摔角也是有意义的…嗯！"
          }
        }
      }

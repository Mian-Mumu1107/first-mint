    {
      "subId": "7325714",
      "subQuestName": "与米希尔和拉沙鲁对话",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "732571401"
        ],
        "dialogs": {
          "732571401": {
            "id": "732571401",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "终于安静下来了。",
            "nextDialogs": [
              "732571402"
            ]
          },
          "732571402": {
            "id": "732571402",
            "speakerId": 1005,
            "speakerName": "米希尔",
            "text": "趁着没有新的污秽流溢出来，快点进行「离渡之仪」吧。",
            "nextDialogs": [
              "732571403"
            ]
          },
          "732571403": {
            "id": "732571403",
            "speakerId": 1005,
            "speakerName": "米希尔",
            "text": "然后我们的工作就可以结束了。",
            "nextDialogs": [
              "732571404"
            ]
          },
          "732571404": {
            "id": "732571404",
            "speakerId": 1004,
            "speakerName": "拉沙鲁",
            "text": "然后…就可以不受打扰，安心睡觉了…",
            "nextDialogs": [
              "732571405"
            ]
          },
          "732571405": {
            "id": "732571405",
            "speakerId": 1005,
            "speakerName": "米希尔",
            "text": "快过来，斯露莎。",
            "nextDialogs": [
              "732571406"
            ]
          },
          "732571406": {
            "id": "732571406",
            "speakerId": 1004,
            "speakerName": "拉沙鲁",
            "text": "斯露莎…别耽搁了。",
            "nextDialogs": [
              "732571407"
            ]
          },
          "732571407": {
            "id": "732571407",
            "speakerId": 1005,
            "speakerName": "米希尔",
            "text": "得我们三个一起才行。"
          }
        }
      }
    },
    {
      "subId": "7325711",
      "subQuestName": "(test)传送门解锁cs$HIDDEN",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "732571101"
        ],
        "dialogs": {
          "732571101": {
            "id": "732571101",
            "speakerId": 1004,
            "speakerName": "拉沙鲁",
            "text": "好累…好想…回去睡觉。呼……"
          }
        }
      }

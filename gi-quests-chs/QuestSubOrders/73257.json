    {
      "subId": "7325730",
      "subQuestName": "与米希尔对话",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "732573001"
        ],
        "dialogs": {
          "732573001": {
            "id": "732573001",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "放置好大灵光之后，这附近看上去也恢复生机了呢！",
            "nextDialogs": [
              "732573002"
            ]
          },
          "732573002": {
            "id": "732573002",
            "speakerId": 1005,
            "speakerName": "米希尔",
            "text": "这些树木本来就是由灵光的力量培育用于抵御灾厄的侵蚀的，只不过在漫长的时间里慢慢耗尽了力量。",
            "nextDialogs": [
              "732573003"
            ]
          },
          "732573003": {
            "id": "732573003",
            "speakerId": 1005,
            "speakerName": "米希尔",
            "text": "现在有了「灵光绝唱」的滋养，它便能够恢复往日的光辉了。",
            "nextDialogs": [
              "732573004"
            ]
          },
          "732573004": {
            "id": "732573004",
            "speakerId": 1005,
            "speakerName": "米希尔",
            "text": "不过封印既然解除，那么属于过去的污秽应该也一并被释放出来了。",
            "nextDialogs": [
              "732573005"
            ]
          },
          "732573005": {
            "id": "732573005",
            "speakerId": 1005,
            "speakerName": "米希尔",
            "text": "若是我和拉沙鲁在这里耗尽力量可就没办法进行仪式了，接下来的几处就拜托你们了。",
            "nextDialogs": [
              "732573006"
            ]
          },
          "732573006": {
            "id": "732573006",
            "speakerId": 1002,
            "speakerName": "斯露莎",
            "text": "哼哼，就交给我吧，毕竟对抗污秽可是勇者的工作呢！"
          }
        }
      }
    },

    {
      "subId": "7325704",
      "subQuestName": "与米希尔和拉沙鲁对话",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "732570401"
        ],
        "dialogs": {
          "732570401": {
            "id": "732570401",
            "speakerId": 1004,
            "speakerName": "拉沙鲁",
            "text": "好慢啊…斯露莎。",
            "nextDialogs": [
              "732570402"
            ]
          },
          "732570402": {
            "id": "732570402",
            "speakerId": 1005,
            "speakerName": "米希尔",
            "text": "我们都在这里等好久了。",
            "nextDialogs": [
              "732570403"
            ]
          },
          "732570403": {
            "id": "732570403",
            "speakerId": 1004,
            "speakerName": "拉沙鲁",
            "text": "好累…好想…回去睡觉。呼……",
            "nextDialogs": [
              "732570404"
            ]
          },
          "732570404": {
            "id": "732570404",
            "speakerId": 1002,
            "speakerName": "斯露莎",
            "text": "什么啦，明明你们什么都没做，一直是我在干活吧！",
            "nextDialogs": [
              "732570405"
            ]
          },
          "732570405": {
            "id": "732570405",
            "speakerId": 1005,
            "speakerName": "米希尔",
            "text": "不能这么说，等待也是件重要的工作呢，不如说比起短暂的行动，等待才是永恒的事业。",
            "nextDialogs": [
              "732570406"
            ]
          },
          "732570406": {
            "id": "732570406",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "这是什么歪理啊…",
            "nextDialogs": [
              "732570407"
            ]
          },
          "732570407": {
            "id": "732570407",
            "speakerId": 1005,
            "speakerName": "米希尔",
            "text": "应该说是我们花灵的哲学吧。",
            "nextDialogs": [
              "732570408"
            ]
          },
          "732570408": {
            "id": "732570408",
            "speakerId": 1005,
            "speakerName": "米希尔",
            "text": "不过比起空谈哲学…现在要紧的是「灵光绝唱」，你们当然已经集齐了吧？",
            "nextDialogs": [
              "732570409"
            ]
          },
          "732570409": {
            "id": "732570409",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "那当然咯！",
            "nextDialogs": [
              "732570410"
            ]
          },
          "732570410": {
            "id": "732570410",
            "speakerId": 1005,
            "speakerName": "米希尔",
            "text": "既然这样就由我们来解开这里的封印，然后便可以用「灵光绝唱」聚集起灵光的力量了。",
            "nextDialogs": [
              "732570411"
            ]
          },
          "732570411": {
            "id": "732570411",
            "speakerId": 1005,
            "speakerName": "米希尔",
            "text": "不过请小心，毕竟淤积了这么多年的污秽，不知道会有什么东西被释放出来呢。"
          }
        }
      }
    },

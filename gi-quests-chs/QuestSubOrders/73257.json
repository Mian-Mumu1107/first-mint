    {
      "subId": "7325729",
      "subQuestName": "与米希尔和拉沙鲁对话",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "732572901"
        ],
        "dialogs": {
          "732572901": {
            "id": "732572901",
            "speakerId": 1005,
            "speakerName": "米希尔",
            "text": "好了，穿过渊底的通道已经打开了，我们的任务也算是完成了。",
            "nextDialogs": [
              "732572902"
            ]
          },
          "732572902": {
            "id": "732572902",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "欸，这么简单就完成了吗？一直在说什么仪式仪式的，我还以为要念一堆听不懂的咒语才算完成呢。",
            "nextDialogs": [
              "732572903"
            ]
          },
          "732572903": {
            "id": "732572903",
            "speakerId": 1005,
            "speakerName": "米希尔",
            "text": "哼哼，人类才需要做那种事啦，毕竟只靠自己的话，他们连元素都调动不了呢。",
            "nextDialogs": [
              "732572904"
            ]
          },
          "732572904": {
            "id": "732572904",
            "speakerId": 1005,
            "speakerName": "米希尔",
            "text": "我们花灵就不同了，毕竟我们和灵光的力量是同源的，就像你们走路也不需要念咒语吧。",
            "nextDialogs": [
              "732572905"
            ]
          },
          "732572905": {
            "id": "732572905",
            "speakerId": 1005,
            "speakerName": "米希尔",
            "text": "哦…虽然你是用飘的。",
            "nextDialogs": [
              "732572906"
            ]
          },
          "732572906": {
            "id": "732572906",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "果然都是歪理。",
            "nextDialogs": [
              "732572907"
            ]
          },
          "732572907": {
            "id": "732572907",
            "speakerId": 1005,
            "speakerName": "米希尔",
            "text": "好了，无关的事情就不多说了，接下来的事情就交给你们了。",
            "nextDialogs": [
              "732572908"
            ]
          },
          "732572908": {
            "id": "732572908",
            "speakerId": 1005,
            "speakerName": "米希尔",
            "text": "「永恒的灵光，将指引我们上升的道路。」"
          }
        }
      }
    },

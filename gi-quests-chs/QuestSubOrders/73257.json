  "subQuests": [
    {
      "subId": "7325715",
      "subQuestName": "前往甘露花海",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "732571501"
        ],
        "dialogs": {
          "732571501": {
            "id": "732571501",
            "speakerId": 1000,
            "speakerName": "那先朱那",
            "text": "那么「双角的花冠」的事情就拜托你们了，我也要去处理剩余的工作了。",
            "nextDialogs": [
              "732571502"
            ]
          },
          "732571502": {
            "id": "732571502",
            "speakerId": 1000,
            "speakerName": "那先朱那",
            "text": "相信不管是什么人，都将会慑服于你们和尊使大人的威光之下的。",
            "nextDialogs": [
              "732571503"
            ]
          },
          "732571503": {
            "id": "732571503",
            "speakerId": 1000,
            "speakerName": "那先朱那",
            "text": "等所有事情都完成之后，我们就在铁穆山的营地会合吧！"
          }
        }
      }
    },
    {
      "subId": "7325701",
      "subQuestName": "(test)回到花海自动进对话$HIDDEN",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "732570101"
        ],
        "dialogs": {
          "732570101": {
            "id": "732570101",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "说来，从遗迹工场出来之后，斯露莎好像一直都没说过话的样子。",
            "nextDialogs": [
              "732570102"
            ]
          },
          "732570102": {
            "id": "732570102",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "明明之前一路上都没停下来过，现在这么安静，都有点不习惯了。",
            "nextDialogs": [
              "732570106"
            ]
          },
          "732570106": {
            "id": "732570106",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "打起精神来呀，斯露莎，我们还有很多事情要做呢！",
            "nextDialogs": [
              "732570107"
            ]
          },
          "732570107": {
            "id": "732570107",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "比如完成那个…就是那个什么很难记的仪式，然后赶紧解决掉那个大窟窿。",
            "nextDialogs": [
              "732570108"
            ]
          },
          "732570108": {
            "id": "732570108",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "等所有事情都完成之后，我们去吃好吃的吧，毕竟大家都辛苦了一番呢。",
            "nextDialogs": [
              "732570109"
            ]
          },
          "732570109": {
            "id": "732570109",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "比如说…唔，不过我也不知道花灵会喜欢吃什么…",
            "nextDialogs": [
              "732570110"
            ]
          },
          "732570110": {
            "id": "732570110",
            "speakerId": 1002,
            "speakerName": "斯露莎",
            "text": "……",
            "nextDialogs": [
              "732570111"
            ]
          },
          "732570111": {
            "id": "732570111",
            "speakerId": 1002,
            "speakerName": "斯露莎",
            "text": "…花灵是不用吃东西的啦，笨飘飘。",
            "nextDialogs": [
              "732570112"
            ]
          },
          "732570112": {
            "id": "732570112",
            "speakerId": 1002,
            "speakerName": "斯露莎",
            "text": "哎，没想到我竟然有一天会沦落到被白飘飘安慰，这也实在太丢人了吧。",
            "nextDialogs": [
              "732570113"
            ]
          },
          "732570113": {
            "id": "732570113",
            "speakerId": 1002,
            "speakerName": "斯露莎",
            "text": "简直恨不得现在就被封印到「灰余晶」里面，要不然就找个可以一睡不醒的山洞躲起来，直到认识我的家伙都消失好了。",
            "nextDialogs": [
              "732570114"
            ]
          },
          "732570114": {
            "id": "732570114",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "说了不许叫我白飘飘，不过真的有这种山洞吗？"
          }
        }
      }
    },
    {
      "subId": "7325702",
      "subQuestName": "与祖尔宛对话",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "732570201"
        ],
        "dialogs": {
          "732570201": {
            "id": "732570201",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "祖尔宛，我们回来啦！",
            "nextDialogs": [
              "732570202"
            ]
          },
          "732570202": {
            "id": "732570202",
            "speakerId": 1003,
            "speakerName": "祖尔宛",
            "text": "#啊呀，是{NICKNAME}、斯露莎还有派蒙。",
            "nextDialogs": [
              "732570203"
            ]
          },
          "732570203": {
            "id": "732570203",
            "speakerId": 1003,
            "speakerName": "祖尔宛",
            "text": "看你们的样子，应该是已经成功拿到所有的「灵光绝唱」了呢。",
            "nextDialogs": [
              "732570206"
            ]
          },
          "732570206": {
            "id": "732570206",
            "speakerId": 1003,
            "speakerName": "祖尔宛",
            "text": "不管怎么样，最终的结果是好的，拜托你们果然没错。",
            "nextDialogs": [
              "732570207"
            ]
          },
          "732570207": {
            "id": "732570207",
            "speakerId": 1003,
            "speakerName": "祖尔宛",
            "text": "若不是有你们在，恐怕「灵光绝唱」早就被那些心怀叵测的家伙夺走了。",
            "nextDialogs": [
              "732570208"
            ]
          },
          "732570208": {
            "id": "732570208",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "欸，祖尔宛的话，怎么听起来像是早就知道些什么的样子啊？",
            "nextDialogs": [
              "732570209"
            ]
          },
          "732570209": {
            "id": "732570209",
            "speakerId": 1003,
            "speakerName": "祖尔宛",
            "text": "欸嘿，还真的被我说中了啊，你们该不会真的遇到了那些侍奉黑渊的家伙吧？"
          }
        }
      }
    },

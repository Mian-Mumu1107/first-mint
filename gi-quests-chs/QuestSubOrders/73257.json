    {
      "subId": "7325717",
      "subQuestName": "与米希尔对话",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "732571701"
        ],
        "dialogs": {
          "732571701": {
            "id": "732571701",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "嗯，这样我们就算是完成了。",
            "nextDialogs": [
              "732571702"
            ]
          },
          "732571702": {
            "id": "732571702",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "看上去有花朵从树上生长出来了，不过接下来该怎么办呢？",
            "nextDialogs": [
              "732571703"
            ]
          },
          "732571703": {
            "id": "732571703",
            "speakerId": 1005,
            "speakerName": "米希尔",
            "text": "哎呀，你们别看我，我也不知道。",
            "nextDialogs": [
              "732571704"
            ]
          },
          "732571704": {
            "id": "732571704",
            "speakerId": 1005,
            "speakerName": "米希尔",
            "text": "说来斯露莎不是已经戴上了「双角的花冠」吗？只要依靠花冠，便可以连接母树的记忆与智慧。",
            "nextDialogs": [
              "732571705"
            ]
          },
          "732571705": {
            "id": "732571705",
            "speakerId": 1005,
            "speakerName": "米希尔",
            "text": "斯露莎快点用那个想想吧。",
            "nextDialogs": [
              "732571706"
            ]
          },
          "732571706": {
            "id": "732571706",
            "speakerId": 1002,
            "speakerName": "斯露莎",
            "text": "虽然是这样说，我还没有习惯这个花冠呢！",
            "nextDialogs": [
              "732571707"
            ]
          },
          "732571707": {
            "id": "732571707",
            "speakerId": 1002,
            "speakerName": "斯露莎",
            "text": "唔，我好像看到了，虽然新生的枝芽已经长出，但污秽还没被完全清除。",
            "nextDialogs": [
              "732571708"
            ]
          },
          "732571708": {
            "id": "732571708",
            "speakerId": 1002,
            "speakerName": "斯露莎",
            "text": "我们还必须得净化这些花朵才行。",
            "nextDialogs": [
              "732571709"
            ]
          },
          "732571709": {
            "id": "732571709",
            "speakerId": 1002,
            "speakerName": "斯露莎",
            "text": "然后纯净的灵光之力才能再次生长出来。"
          }
        }
      }
    },

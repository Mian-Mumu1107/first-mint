      "dialogue": {
        "startDialogs": [
          "721560101"
        ],
        "dialogs": {
          "721560101": {
            "id": "721560101",
            "speakerId": 1000,
            "speakerName": "悦子",
            "text": "好！这样第二座「镇石」也封印好了，只剩下两座了。",
            "nextDialogs": [
              "721560102"
            ]
          },
          "721560102": {
            "id": "721560102",
            "speakerId": 1001,
            "speakerName": "大祐",
            "text": "那我们就快去看看剩下的两座「镇石」吧。",
            "nextDialogs": [
              "721560103"
            ]
          },
          "721560103": {
            "id": "721560103",
            "speakerId": 1001,
            "speakerName": "大祐",
            "text": "只要把「镇石」全部封印的话，雷暴应该就会平息了吧。",
            "nextDialogs": [
              "721560104"
            ]
          },
          "721560104": {
            "id": "721560104",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "快出发吧。",
            "nextDialogs": [
              "721560105"
            ]
          },
          "721560105": {
            "id": "721560105",
            "speakerId": 1001,
            "speakerName": "大祐",
            "text": "希望那位「寝子」说的是真的…",
            "nextDialogs": [
              "721560106"
            ]
          },
          "721560106": {
            "id": "721560106",
            "speakerId": 1000,
            "speakerName": "悦子",
            "text": "但是，这也是我们手上有关雷暴的唯一线索了…",
            "nextDialogs": [
              "721560107"
            ]
          },
          "721560107": {
            "id": "721560107",
            "speakerId": 1000,
            "speakerName": "悦子",
            "text": "无论如何，我们还是快去看看那两座「镇石」吧。",
            "nextDialogs": [
              "721560110"
            ]
          },
          "721560110": {
            "id": "721560110",
            "speakerId": 1000,
            "speakerName": "悦子",
            "text": "雷暴和「镇石」…回去得向协会好好报告一下了…"
          }
        }
      }
    },

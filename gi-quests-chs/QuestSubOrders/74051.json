  "subQuests": [
    {
      "subId": "7405103",
      "subQuestName": "",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "740510201"
        ],
        "dialogs": {
          "740510201": {
            "id": "740510201",
            "speakerId": 1000,
            "speakerName": "兴晔",
            "text": "老板，这下可怎么办？映影没拍好，映影机还丢了…",
            "nextDialogs": [
              "740510202"
            ]
          },
          "740510202": {
            "id": "740510202",
            "speakerId": 1001,
            "speakerName": "邱老板",
            "text": "行了，别唉声叹气的。咱们不是已经去冒险家协会挂过委托了吗？",
            "nextDialogs": [
              "740510203"
            ]
          },
          "740510203": {
            "id": "740510203",
            "speakerId": 1001,
            "speakerName": "邱老板",
            "text": "为今之计，只有一个等字…",
            "nextDialogs": [
              "740510204"
            ]
          },
          "740510204": {
            "id": "740510204",
            "speakerId": 1002,
            "speakerName": "弈丰",
            "text": "但是，咱们拍了一半的映影片还在机器里。",
            "nextDialogs": [
              "740510205"
            ]
          },
          "740510205": {
            "id": "740510205",
            "speakerId": 1002,
            "speakerName": "弈丰",
            "text": "就算机器不容易坏，但要是那些片子被弄坏了…",
            "nextDialogs": [
              "740510206"
            ]
          },
          "740510206": {
            "id": "740510206",
            "speakerId": 1001,
            "speakerName": "邱老板",
            "text": "这…",
            "nextDialogs": [
              "740510208"
            ]
          },
          "740510208": {
            "id": "740510208",
            "speakerId": 1001,
            "speakerName": "邱老板",
            "text": "瞧！这不就来了吗？我就说嘛，要沉下心来等！",
            "nextDialogs": [
              "740510221"
            ]
          },
          "740510221": {
            "id": "740510221",
            "speakerId": 1002,
            "speakerName": "弈丰",
            "text": "冒险家协会的效率，什么时候这么高了？",
            "nextDialogs": [
              "740510209"
            ]
          },
          "740510209": {
            "id": "740510209",
            "speakerId": 1000,
            "speakerName": "兴晔",
            "text": "唔，看来枫丹人办事也不都是磨磨蹭蹭的嘛。",
            "nextDialogs": [
              "740510210"
            ]
          },
          "740510210": {
            "id": "740510210",
            "speakerId": 1001,
            "speakerName": "邱老板",
            "text": "您好，您好，冒险家。您一定是接到了协会的委托，来帮助我们拿回映影机的吧？",
            "nextDialogs": [
              "740510211"
            ]
          },
          "740510211": {
            "id": "740510211",
            "speakerId": 1001,
            "speakerName": "邱老板",
            "text": "我们就是在那边被魔物袭击的，请您快点…"
          }
        }
      }
    },
    {
      "subId": "7405104",
      "subQuestName": "打倒所有魔物，取回映影机",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "740510401"
        ],
        "dialogs": {
          "740510401": {
            "id": "740510401",
            "speakerId": 1001,
            "speakerName": "邱老板",
            "text": "(test)原来他们三个来此之后不小心把装胶片的箱子掉到水里了，三个人都不会潜水。",
            "nextDialogs": [
              "740510402"
            ]
          },
          "740510402": {
            "id": "740510402",
            "speakerId": 1000,
            "speakerName": "兴晔",
            "text": "(test)所以现在只能在这里干瞪眼了。拜托主角帮忙取回来。"
          }
        }
      }
    },
    {
      "subId": "7405105",
      "subQuestName": "与邱老板一行人对话",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "740510301"
        ],
        "dialogs": {
          "740510301": {
            "id": "740510301",
            "speakerId": 1001,
            "speakerName": "邱老板",
            "text": "太好了，映影机完好无损，里面的映影也没有被破坏…",
            "nextDialogs": [
              "740510328"
            ]
          },
          "740510328": {
            "id": "740510328",
            "speakerId": 1001,
            "speakerName": "邱老板",
            "text": "谢天谢地，我还以为又要从头开拍了。",
            "nextDialogs": [
              "740510329"
            ]
          },
          "740510329": {
            "id": "740510329",
            "speakerId": 1001,
            "speakerName": "邱老板",
            "text": "这事情就说来话长了…",
            "nextDialogs": [
              "740510305"
            ]
          },
          "740510305": {
            "id": "740510305",
            "speakerId": 1001,
            "speakerName": "邱老板",
            "text": "庄里的人大部分都是做茶叶生意的，但我们…对茶叶生意没什么兴趣…",
            "nextDialogs": [
              "740510306"
            ]
          },
          "740510306": {
            "id": "740510306",
            "speakerId": 1001,
            "speakerName": "邱老板",
            "text": "所以就转了行，去帮庄里的茶叶商拍宣传用的记录映影。",
            "nextDialogs": [
              "740510307"
            ]
          },
          "740510307": {
            "id": "740510307",
            "speakerId": 1002,
            "speakerName": "弈丰",
            "text": "其实是做茶叶生意的人太多，我们原本的生意比不过他们啦。",
            "nextDialogs": [
              "740510308"
            ]
          },
          "740510308": {
            "id": "740510308",
            "speakerId": 1000,
            "speakerName": "兴晔",
            "text": "店里的好手也一个接一个地跑去别家干活，再做茶叶生意，我们就没饭吃了。",
            "nextDialogs": [
              "740510309"
            ]
          },
          "740510309": {
            "id": "740510309",
            "speakerId": 1001,
            "speakerName": "邱老板",
            "text": "你们两个…就不能说点好听的吗？！",
            "nextDialogs": [
              "740510310"
            ]
          },
          "740510310": {
            "id": "740510310",
            "speakerId": 1001,
            "speakerName": "邱老板",
            "text": "给庄里的茶叶拍宣传映影这件事，赚得也不少了。",
            "nextDialogs": [
              "740510311"
            ]
          },
          "740510311": {
            "id": "740510311",
            "speakerId": 1002,
            "speakerName": "弈丰",
            "text": "可是，最近庄里也有其他人开始拍宣传映影了啊。",
            "nextDialogs": [
              "740510312"
            ]
          },
          "740510312": {
            "id": "740510312",
            "speakerId": 1000,
            "speakerName": "兴晔",
            "text": "有的映影里还有人唱戏呢，派头可大了。",
            "nextDialogs": [
              "740510313"
            ]
          },
          "740510313": {
            "id": "740510313",
            "speakerId": 1001,
            "speakerName": "邱老板",
            "text": "所以我们才来枫丹，寻求映影专家的建议啊！",
            "nextDialogs": [
              "740510314"
            ]
          },
          "740510314": {
            "id": "740510314",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "所以，你们是来枫丹学拍摄映影的？",
            "nextDialogs": [
              "740510315"
            ]
          },
          "740510315": {
            "id": "740510315",
            "speakerId": 1001,
            "speakerName": "邱老板",
            "text": "没错。我们找到了一个名叫热塞尔的「映影专家」。",
            "nextDialogs": [
              "740510316"
            ]
          },
          "740510316": {
            "id": "740510316",
            "speakerId": 1001,
            "speakerName": "邱老板",
            "text": "他很擅长在映影中用光影来…那什么来着？",
            "nextDialogs": [
              "740510317"
            ]
          },
          "740510317": {
            "id": "740510317",
            "speakerId": 1002,
            "speakerName": "弈丰",
            "text": "「叙事」。",
            "nextDialogs": [
              "740510318"
            ]
          },
          "740510318": {
            "id": "740510318",
            "speakerId": 1001,
            "speakerName": "邱老板",
            "text": "对！用光影来「叙事」。",
            "nextDialogs": [
              "740510319"
            ]
          },
          "740510319": {
            "id": "740510319",
            "speakerId": 1001,
            "speakerName": "邱老板",
            "text": "有了热塞尔先生的指导，我们一定能拍出整个翘英庄里最好的映影！",
            "nextDialogs": [
              "740510320"
            ]
          },
          "740510320": {
            "id": "740510320",
            "speakerId": 1000,
            "speakerName": "兴晔",
            "text": "老板，你上个月才说要拍出整个璃月里最好的映影。",
            "nextDialogs": [
              "740510321"
            ]
          },
          "740510321": {
            "id": "740510321",
            "speakerId": 1001,
            "speakerName": "邱老板",
            "text": "做生意就是要合理地调整自己对未来的预期…你懂什么？",
            "nextDialogs": [
              "740510322"
            ]
          },
          "740510322": {
            "id": "740510322",
            "speakerId": 1001,
            "speakerName": "邱老板",
            "text": "总之，感谢您的帮忙，旅行者，这些钱请您收下。",
            "nextDialogs": [
              "740510323"
            ]
          },
          "740510323": {
            "id": "740510323",
            "speakerId": 1001,
            "speakerName": "邱老板",
            "text": "兴晔、弈丰，把东西赶紧架起来！今天必须把样片拍完，拿过去给热塞尔先生看。",
            "nextDialogs": [
              "740510324"
            ]
          },
          "740510324": {
            "id": "740510324",
            "speakerId": 1001,
            "speakerName": "邱老板",
            "text": "注意打光！镜头要…这么对着光源，打出一个…有高级质感的光线！",
            "nextDialogs": [
              "740510325"
            ]
          },
          "740510325": {
            "id": "740510325",
            "speakerId": 1001,
            "speakerName": "邱老板",
            "text": "你们都看过那本书了吧，光影要有质感，质感你们明白吗？",
            "nextDialogs": [
              "740510326"
            ]
          },
          "740510326": {
            "id": "740510326",
            "speakerId": 1000,
            "speakerName": "兴晔",
            "text": "老板，虽然热塞尔先生的那本书我们的确都看过了…",
            "nextDialogs": [
              "740510327"
            ]
          },
          "740510327": {
            "id": "740510327",
            "speakerId": 1002,
            "speakerName": "弈丰",
            "text": "但就凭这个镜头，就算我们再折腾，拍出来的光线质感也高级不到哪去啊…"
          }
        }
      }
    },

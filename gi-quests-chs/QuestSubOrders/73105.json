  "subQuests": [
    {
      "subId": "7310501",
      "subQuestName": "与妮露法对话$HIDDEN",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "731050101"
        ],
        "dialogs": {
          "731050101": {
            "id": "731050101",
            "speakerId": 20774,
            "speakerName": "妮露法",
            "text": "爱拉尼…你到底跑到哪里去了…",
            "nextDialogs": [
              "731050102"
            ]
          },
          "731050102": {
            "id": "731050102",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "爱拉尼？",
            "nextDialogs": [
              "731050103"
            ]
          },
          "731050103": {
            "id": "731050103",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "欸？这名字…我记得，是那个总是在写论文的大姐姐？我们在海祇岛见过的那位。",
            "nextDialogs": [
              "731050104"
            ]
          },
          "731050104": {
            "id": "731050104",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "对喔！她说过她是从教令院出去取材的，现在应该已经回去了吧。",
            "nextDialogs": [
              "731050105"
            ]
          },
          "731050105": {
            "id": "731050105",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "不过…那个人好像很焦急的样子…我们过去问问她发生了什么吧。",
            "nextDialogs": [
              "731050106"
            ]
          },
          "731050106": {
            "id": "731050106",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "如果爱拉尼真的回了教令院，我们也正好过去打个招呼呢。",
            "nextDialogs": [
              "731050107"
            ]
          },
          "731050107": {
            "id": "731050107",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "你好，关于爱拉尼…",
            "nextDialogs": [
              "731050108"
            ]
          },
          "731050108": {
            "id": "731050108",
            "speakerId": 20774,
            "speakerName": "妮露法",
            "text": "你是冒险家协会派来的冒险家吗？！请问你找到爱拉尼的下落了吗？",
            "nextDialogs": [
              "731050109"
            ]
          },
          "731050109": {
            "id": "731050109",
            "speakerId": 20774,
            "speakerName": "妮露法",
            "text": "我知道我催了好多次，真的很不好意思，但我真的很担心她，我…",
            "nextDialogs": [
              "731050110"
            ]
          },
          "731050110": {
            "id": "731050110",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "呜哇，你冷静点，我们不是冒险家协会派来的啦，我们只是路过…",
            "nextDialogs": [
              "731050111"
            ]
          },
          "731050111": {
            "id": "731050111",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "请问您是…",
            "nextDialogs": [
              "731050112"
            ]
          },
          "731050112": {
            "id": "731050112",
            "speakerId": 20774,
            "speakerName": "妮露法",
            "text": "你们不是冒险家吗？抱歉，因为协会那边一直没消息，我…我太着急了…",
            "nextDialogs": [
              "731050149"
            ]
          },
          "731050149": {
            "id": "731050149",
            "speakerId": 1002,
            "speakerName": "Black Screen",
            "text": "讲述了至今为止与爱拉尼一同经历的事…",
            "nextDialogs": [
              "731050113"
            ]
          },
          "731050113": {
            "id": "731050113",
            "speakerId": 20774,
            "speakerName": "妮露法",
            "text": "原来您就是爱拉尼一直提到的那位旅行者…",
            "nextDialogs": [
              "731050114"
            ]
          },
          "731050114": {
            "id": "731050114",
            "speakerId": 20774,
            "speakerName": "妮露法",
            "text": "我叫妮露法，是教令院的学者…你们应该也能看出来，对吧？",
            "nextDialogs": [
              "731050115"
            ]
          },
          "731050115": {
            "id": "731050115",
            "speakerId": 20774,
            "speakerName": "妮露法",
            "text": "虽然说是学者，但我现在大部分精力都放在了领着学生做研究上。",
            "nextDialogs": [
              "731050116"
            ]
          },
          "731050116": {
            "id": "731050116",
            "speakerId": 20774,
            "speakerName": "妮露法",
            "text": "爱拉尼就是我的学生之一，这孩子的论文一直都写得很艰难…",
            "nextDialogs": [
              "731050117"
            ]
          },
          "731050117": {
            "id": "731050117",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "你，你就是爱拉尼的那位导师？",
            "nextDialogs": [
              "731050118"
            ]
          },
          "731050118": {
            "id": "731050118",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "爱拉尼小姐说，她的好多篇论文都被导师说不合格，不得不重写…",
            "nextDialogs": [
              "731050119"
            ]
          },
          "731050119": {
            "id": "731050119",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "不对不对，现在不是说这些的时候，爱拉尼小姐怎么了呀？",
            "nextDialogs": [
              "731050120"
            ]
          },
          "731050120": {
            "id": "731050120",
            "speakerId": 20774,
            "speakerName": "妮露法",
            "text": "这孩子…这孩子失踪了。",
            "nextDialogs": [
              "731050121"
            ]
          },
          "731050121": {
            "id": "731050121",
            "speakerId": 20774,
            "speakerName": "妮露法",
            "text": "前段时间，爱拉尼从稻妻带着一篇论文兴冲冲地回来，论文的内容是研究海祇岛的民俗文化…",
            "nextDialogs": [
              "731050124"
            ]
          },
          "731050124": {
            "id": "731050124",
            "speakerId": 20774,
            "speakerName": "妮露法",
            "text": "我能看出来，这篇论文写得很好，各方面都是高水准…",
            "nextDialogs": [
              "731050125"
            ]
          },
          "731050125": {
            "id": "731050125",
            "speakerId": 20774,
            "speakerName": "妮露法",
            "text": "但是…但是她回来得太晚了啊！之前我让她把初稿提前寄给我，却一直都没收到回信。",
            "nextDialogs": [
              "731050126"
            ]
          },
          "731050126": {
            "id": "731050126",
            "speakerId": 20774,
            "speakerName": "妮露法",
            "text": "等她带着全版论文回来的时候，早就有人提交了和她研究内容一模一样的论文，都已经通过预审了！",
            "nextDialogs": [
              "731050127"
            ]
          },
          "731050127": {
            "id": "731050127",
            "speakerId": 20774,
            "speakerName": "妮露法",
            "text": "我虽然拼命去帮她争取机会，但她的论文还是…还是没通过…",
            "nextDialogs": [
              "731050128"
            ]
          },
          "731050128": {
            "id": "731050128",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "不对啊，爱拉尼小姐很早就开始取材了呀？怎么可能拖到现在才…",
            "nextDialogs": [
              "731050129"
            ]
          },
          "731050129": {
            "id": "731050129",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "等等，说到稻妻…难道…",
            "nextDialogs": [
              "731050130"
            ]
          },
          "731050130": {
            "id": "731050130",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "锁，锁国令！",
            "nextDialogs": [
              "731050131"
            ]
          },
          "731050131": {
            "id": "731050131",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "怎么这样…",
            "nextDialogs": [
              "731050132"
            ]
          },
          "731050132": {
            "id": "731050132",
            "speakerId": 20774,
            "speakerName": "妮露法",
            "text": "我根本不知道怎么告诉她这个消息…本来打算过几天，想个委婉的方式和她沟通。",
            "nextDialogs": [
              "731050133"
            ]
          },
          "731050133": {
            "id": "731050133",
            "speakerId": 20774,
            "speakerName": "妮露法",
            "text": "结果不知道哪个大嘴巴，直接把这个消息告诉她。",
            "nextDialogs": [
              "731050134"
            ]
          },
          "731050134": {
            "id": "731050134",
            "speakerId": 20774,
            "speakerName": "妮露法",
            "text": "然后她就不见了，我找遍了教令院也没有找到，只能去冒险家协会发布了委托。",
            "nextDialogs": [
              "731050135"
            ]
          },
          "731050135": {
            "id": "731050135",
            "speakerId": 20774,
            "speakerName": "妮露法",
            "text": "但冒险家也只是在一个地方发现了爱拉尼的笔记本，没有发现她的人影。",
            "nextDialogs": [
              "731050136"
            ]
          },
          "731050136": {
            "id": "731050136",
            "speakerId": 20774,
            "speakerName": "妮露法",
            "text": "现在，冒险家们应该还在到处找爱拉尼的下落…",
            "nextDialogs": [
              "731050137"
            ]
          },
          "731050137": {
            "id": "731050137",
            "speakerId": 20774,
            "speakerName": "妮露法",
            "text": "我，我真的不知道怎么办才好，呜…"
          }
        }
      }
    },

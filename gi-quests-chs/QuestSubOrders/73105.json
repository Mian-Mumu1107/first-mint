    {
      "subId": "7310507",
      "subQuestName": "与爱拉尼对话",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "731050701"
        ],
        "dialogs": {
          "731050701": {
            "id": "731050701",
            "speakerId": 10205,
            "speakerName": "？？？",
            "text": "爱拉尼！你到底出不出来！？",
            "nextDialogs": [
              "731050702"
            ]
          },
          "731050702": {
            "id": "731050702",
            "speakerId": 20088,
            "speakerName": "爱拉尼",
            "text": "就是不出来！我不做学者了！我也不想上学了！",
            "nextDialogs": [
              "731050703"
            ]
          },
          "731050703": {
            "id": "731050703",
            "speakerId": 20088,
            "speakerName": "爱拉尼",
            "text": "反正我都付给你那么多钱了，你就让我一个人待着不行吗？！",
            "nextDialogs": [
              "731050704"
            ]
          },
          "731050704": {
            "id": "731050704",
            "speakerId": 10205,
            "speakerName": "？？？",
            "text": "死丫头，油盐不进是吧…",
            "nextDialogs": [
              "731050707"
            ]
          },
          "731050707": {
            "id": "731050707",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "你，你们好…",
            "nextDialogs": [
              "731050708"
            ]
          },
          "731050708": {
            "id": "731050708",
            "speakerId": 10205,
            "speakerName": "？？？",
            "text": "嗯？你们是…",
            "nextDialogs": [
              "731050709"
            ]
          },
          "731050709": {
            "id": "731050709",
            "speakerId": 20088,
            "speakerName": "爱拉尼",
            "text": "旅，旅行者！呜…",
            "nextDialogs": [
              "731050710"
            ]
          },
          "731050710": {
            "id": "731050710",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "爱拉尼小姐，你真的在这里呀…"
          }
        }
      }
    },
    {
      "subId": "7310508",
      "subQuestName": "向妮露法回报",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "731050801"
        ],
        "dialogs": {
          "731050801": {
            "id": "731050801",
            "speakerId": 20774,
            "speakerName": "妮露法",
            "text": "旅行者！怎么样，你找到爱拉尼了吗？",
            "nextDialogs": [
              "731050802"
            ]
          },
          "731050802": {
            "id": "731050802",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "找到是找到了…",
            "nextDialogs": [
              "731050823"
            ]
          },
          "731050823": {
            "id": "731050823",
            "speakerId": 1002,
            "speakerName": "Black Screen",
            "text": "向妮露法讲述了事情的经过，并把爱拉尼的便签给了她…",
            "nextDialogs": [
              "731050803"
            ]
          },
          "731050803": {
            "id": "731050803",
            "speakerId": 20774,
            "speakerName": "妮露法",
            "text": "娜赞？怎么会是她…",
            "nextDialogs": [
              "731050804"
            ]
          },
          "731050804": {
            "id": "731050804",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "你认识她吗？",
            "nextDialogs": [
              "731050805"
            ]
          },
          "731050805": {
            "id": "731050805",
            "speakerId": 20774,
            "speakerName": "妮露法",
            "text": "嗯…也谈不上认识，但我听人提起过，她是一个很奇怪的盗宝团成员。",
            "nextDialogs": [
              "731050806"
            ]
          },
          "731050806": {
            "id": "731050806",
            "speakerId": 20774,
            "speakerName": "妮露法",
            "text": "据说，她劫掠行人的时候，会向被劫掠的人提一个问题。",
            "nextDialogs": [
              "731050807"
            ]
          },
          "731050807": {
            "id": "731050807",
            "speakerId": 20774,
            "speakerName": "妮露法",
            "text": "问题的范围从文学到元素，乱七八糟的什么都有，甚至…甚至还有那种「头脑急转弯」…",
            "nextDialogs": [
              "731050808"
            ]
          },
          "731050808": {
            "id": "731050808",
            "speakerId": 20774,
            "speakerName": "妮露法",
            "text": "无论如何，只要能解出娜赞的问题，那她不仅会把劫掠的东西全部奉还，还会亲自护送你回城里。",
            "nextDialogs": [
              "731050809"
            ]
          },
          "731050809": {
            "id": "731050809",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "她原来是这种怪人吗…",
            "nextDialogs": [
              "731050812"
            ]
          },
          "731050812": {
            "id": "731050812",
            "speakerId": 20774,
            "speakerName": "妮露法",
            "text": "没人知道她是什么目的。我之所以知道这件事，也是因为我的导师曾经在野外遇见过娜赞。",
            "nextDialogs": [
              "731050813"
            ]
          },
          "731050813": {
            "id": "731050813",
            "speakerId": 20774,
            "speakerName": "妮露法",
            "text": "当时娜赞的问题是：「用什么东西能够迅速填满一间空荡荡的屋子。」",
            "nextDialogs": [
              "731050814"
            ]
          },
          "731050814": {
            "id": "731050814",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "唔…",
            "nextDialogs": [
              "731050815"
            ]
          },
          "731050815": {
            "id": "731050815",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "风！对吗？肯定对吧！",
            "nextDialogs": [
              "731050816"
            ]
          },
          "731050816": {
            "id": "731050816",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "呃…烛光？",
            "nextDialogs": [
              "731050817"
            ]
          },
          "731050817": {
            "id": "731050817",
            "speakerId": 20774,
            "speakerName": "妮露法",
            "text": "我导师的回答是：「元素力始终无处不在。」",
            "nextDialogs": [
              "731050818"
            ]
          },
          "731050818": {
            "id": "731050818",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "……",
            "nextDialogs": [
              "731050819"
            ]
          },
          "731050819": {
            "id": "731050819",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "耍赖！",
            "nextDialogs": [
              "731050820"
            ]
          },
          "731050820": {
            "id": "731050820",
            "speakerId": 20774,
            "speakerName": "妮露法",
            "text": "哈哈哈…总之，娜赞是把我的导师送回了城里，还和他礼貌地道别。",
            "nextDialogs": [
              "731050821"
            ]
          },
          "731050821": {
            "id": "731050821",
            "speakerId": 20774,
            "speakerName": "妮露法",
            "text": "如果是她和爱拉尼在一起，我反倒不那么担心了。",
            "nextDialogs": [
              "731050822"
            ]
          },
          "731050822": {
            "id": "731050822",
            "speakerId": 20774,
            "speakerName": "妮露法",
            "text": "但爱拉尼那孩子一直待在那里也不行，我得想个办法，帮她把论文的问题解决了…"
          }
        }
      }
    },
    {
      "subId": "7310530",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "731053001"
        ],
        "dialogs": {
          "731053001": {
            "id": "731053001",
            "speakerId": 20774,
            "speakerName": "妮露法",
            "text": "爱拉尼，你可千万要平安啊…",
            "nextDialogs": [
              "731053003",
              "731053006"
            ]
          },
          "731053003": {
            "id": "731053003",
            "speakerId": 20774,
            "speakerName": "妮露法",
            "text": "爱拉尼是一个很勤奋的孩子，虽然有时候…总是会在奇怪的地方钻牛角尖…",
            "nextDialogs": [
              "731053004"
            ]
          },
          "731053004": {
            "id": "731053004",
            "speakerId": 20774,
            "speakerName": "妮露法",
            "text": "但她绝对是一个合格的学生，我也相信她绝对会成为一个合格的学者。"
          },
          "731053006": {
            "id": "731053006",
            "speakerId": 20774,
            "speakerName": "妮露法",
            "text": "老实说，是的。",
            "nextDialogs": [
              "731053007"
            ]
          },
          "731053007": {
            "id": "731053007",
            "speakerId": 20774,
            "speakerName": "妮露法",
            "text": "论文的审核是一件…很复杂的事，除了考虑自己的研究方向，文献的充足程度…",
            "nextDialogs": [
              "731053008"
            ]
          },
          "731053008": {
            "id": "731053008",
            "speakerId": 20774,
            "speakerName": "妮露法",
            "text": "还要注意同类型论文的数量，研究课题有没有和别人冲突。开题之后，也会遇见各种各样的困难。",
            "nextDialogs": [
              "731053009"
            ]
          },
          "731053009": {
            "id": "731053009",
            "speakerId": 20774,
            "speakerName": "妮露法",
            "text": "唉，但爱拉尼那孩子的运气也太差了点…"
          }
        }
      }
    },
    {
      "subId": "7310531",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "731053101"
        ],
        "dialogs": {
          "731053101": {
            "id": "731053101",
            "speakerId": 20776,
            "speakerName": "娜赞",
            "text": "还有什么事？",
            "nextDialogs": [
              "731053103",
              "731053109"
            ]
          },
          "731053103": {
            "id": "731053103",
            "speakerId": 20776,
            "speakerName": "娜赞",
            "text": "对爱拉尼这么「好」？",
            "nextDialogs": [
              "731053104"
            ]
          },
          "731053104": {
            "id": "731053104",
            "speakerId": 20776,
            "speakerName": "娜赞",
            "text": "你误会了。我这么做理由很简单。第一，爱拉尼付过钱了。",
            "nextDialogs": [
              "731053105"
            ]
          },
          "731053105": {
            "id": "731053105",
            "speakerId": 20776,
            "speakerName": "娜赞",
            "text": "第二，我从来只取财，不害人，如果我把她拽出来，丢去荒郊野岭，那我在道上的名声就要坏透了。",
            "nextDialogs": [
              "731053106"
            ]
          },
          "731053106": {
            "id": "731053106",
            "speakerId": 20776,
            "speakerName": "娜赞",
            "text": "第三，她是一个有知识的人，有着远大的未来。",
            "nextDialogs": [
              "731053107"
            ]
          },
          "731053107": {
            "id": "731053107",
            "speakerId": 20776,
            "speakerName": "娜赞",
            "text": "能帮上她的忙，我这个在泥巴里打滚的盗宝团，也许…算是能沾点光了？哼…"
          },
          "731053109": {
            "id": "731053109",
            "speakerId": 20776,
            "speakerName": "娜赞",
            "text": "不是一个小数目。她说是帮人做什么「肥料」赚来的钱，我不明白，也懒得管。",
            "nextDialogs": [
              "731053110"
            ]
          },
          "731053110": {
            "id": "731053110",
            "speakerId": 20776,
            "speakerName": "娜赞",
            "text": "总归她付了钱，我就会暂时帮她的忙，就这么简单。"
          }
        }
      }
    },
    {
      "subId": "7310532",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "731053201"
        ],
        "dialogs": {
          "731053201": {
            "id": "731053201",
            "speakerId": 20088,
            "speakerName": "爱拉尼",
            "text": "呜呜呜…呜呜…为什么世界上有论文这种东西…呜呜…"
          }
        }
      }
    }
  ]
}
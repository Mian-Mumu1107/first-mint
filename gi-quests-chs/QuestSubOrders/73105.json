    {
      "subId": "7310505",
      "subQuestName": "与盗宝团对话",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "731050501"
        ],
        "dialogs": {
          "731050501": {
            "id": "731050501",
            "speakerId": 20775,
            "speakerName": "戈布利",
            "text": "英雄！好汉，别打了，别打了！都是误会啊！",
            "nextDialogs": [
              "731050503",
              "731050506"
            ]
          },
          "731050503": {
            "id": "731050503",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "你们对爱拉尼小姐做了什么？老实交代！",
            "nextDialogs": [
              "731050504"
            ]
          },
          "731050504": {
            "id": "731050504",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "不然…不然我们就揍你喔！",
            "nextDialogs": [
              "731050507"
            ]
          },
          "731050507": {
            "id": "731050507",
            "speakerId": 20775,
            "speakerName": "戈布利",
            "text": "别，别别别，英雄您听我说完，这真的是误会…",
            "nextDialogs": [
              "731050508"
            ]
          },
          "731050508": {
            "id": "731050508",
            "speakerId": 20775,
            "speakerName": "戈布利",
            "text": "那位小姑奶奶我们哪敢惹啊，我们根本就折腾不过她啊！"
          },
          "731050506": {
            "id": "731050506",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "老实交代！不然…不然我们就揍你喔！"
          }
        }
      }
    },
    {
      "subId": "7310506",
      "subQuestName": "前往寻找爱拉尼",
      "sceneId": null,

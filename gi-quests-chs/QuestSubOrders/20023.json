  "subQuests": [
    {
      "subId": "2002301",
      "subQuestName": "询问维多利亚修女",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "200230101"
        ],
        "dialogs": {
          "200230101": {
            "id": "200230101",
            "speakerId": 1471,
            "speakerName": "维多利亚",
            "text": "他到底有没有悔改呢…",
            "nextDialogs": [
              "200230102"
            ]
          },
          "200230102": {
            "id": "200230102",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "悔改什么？",
            "nextDialogs": [
              "200230103"
            ]
          },
          "200230103": {
            "id": "200230103",
            "speakerId": 1471,
            "speakerName": "维多利亚",
            "text": "每天都会有很多人到我这里，倾诉他们所犯下的罪孽，祈求神的原谅。",
            "nextDialogs": [
              "200230104"
            ]
          },
          "200230104": {
            "id": "200230104",
            "speakerId": 1471,
            "speakerName": "维多利亚",
            "text": "但如果只是口头说说，不付诸行动，那不就只是在浪费时间吗？",
            "nextDialogs": [
              "200230105"
            ]
          },
          "200230105": {
            "id": "200230105",
            "speakerId": 1471,
            "speakerName": "维多利亚",
            "text": "比如宁禄先生，他为自己酗酒的习惯忏悔了好多次，但一点改变都没有…",
            "nextDialogs": [
              "200230106"
            ]
          },
          "200230106": {
            "id": "200230106",
            "speakerId": 1471,
            "speakerName": "维多利亚",
            "text": "如果你有空的话，去帮我去看看他现在的情况吧。",
            "nextDialogs": [
              "200230108",
              "200230111"
            ]
          },
          "200230108": {
            "id": "200230108",
            "speakerId": 1471,
            "speakerName": "维多利亚",
            "text": "对了，如果他又在喝酒，请带一些证据回来。",
            "nextDialogs": [
              "200230109"
            ]
          },
          "200230109": {
            "id": "200230109",
            "speakerId": 1471,
            "speakerName": "维多利亚",
            "text": "屡教不改的人…还是需要一点能深刻铭记的「教诲」。"
          },
          "200230111": {
            "id": "200230111",
            "speakerId": 1471,
            "speakerName": "维多利亚",
            "text": "喝酒不算「罪孽」，但是因为喝酒，而让其他人陷入苦恼算是「罪孽」。",
            "nextDialogs": [
              "200230112"
            ]
          },
          "200230112": {
            "id": "200230112",
            "speakerId": 1471,
            "speakerName": "维多利亚",
            "text": "如果每个人都恣意妄为，那么这座蒙德城，总有一天也会陷入巨大的苦恼中。",
            "nextDialogs": [
              "200230113"
            ]
          },
          "200230113": {
            "id": "200230113",
            "speakerId": 1471,
            "speakerName": "维多利亚",
            "text": "所以，要将每一份刚冒头的「罪孽」掐断，好了，你快点去看看宁禄的情况吧。"
          }
        }
      }
    },
    {
      "subId": "2002302",
      "subQuestName": "找到宁禄先生",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "200230201"
        ],
        "dialogs": {
          "200230201": {
            "id": "200230201",
            "speakerId": 1461,
            "speakerName": "宁禄",
            "text": "哈哈哈，我每天都指着这一杯…",
            "nextDialogs": [
              "200230202"
            ]
          },
          "200230202": {
            "id": "200230202",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "你不是说要戒酒吗？",
            "nextDialogs": [
              "200230203"
            ]
          },
          "200230203": {
            "id": "200230203",
            "speakerId": 1461,
            "speakerName": "宁禄",
            "text": "啊？！吓死我了…我还以为是我老婆呢。",
            "nextDialogs": [
              "200230204"
            ]
          },
          "200230204": {
            "id": "200230204",
            "speakerId": 1461,
            "speakerName": "宁禄",
            "text": "偶尔喝一点也无所谓吧，我可是辛苦工作了一天啊。",
            "nextDialogs": [
              "200230205"
            ]
          },
          "200230205": {
            "id": "200230205",
            "speakerId": 1461,
            "speakerName": "宁禄",
            "text": "好了好了，我再喝一点就回去了…优律也差不多该买完东西了。"
          }
        }
      }
    },
    {
      "subId": "2002303",
      "subQuestName": "调查酒杯取证",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "200230301"
        ],
        "dialogs": {
          "200230301": {
            "id": "200230301",
            "speakerId": 10030,
            "speakerName": "查尔斯",
            "text": "怎么？有事吗？",
            "nextDialogs": [
              "200230302"
            ]
          },
          "200230302": {
            "id": "200230302",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "关于宁禄…",
            "nextDialogs": [
              "200230303"
            ]
          },
          "200230303": {
            "id": "200230303",
            "speakerId": 10030,
            "speakerName": "查尔斯",
            "text": "他今天已经喝了快半天了，你看，这是他喝的账单。",
            "nextDialogs": [
              "200230304"
            ]
          },
          "200230304": {
            "id": "200230304",
            "speakerId": 10030,
            "speakerName": "查尔斯",
            "text": "再这么下去，只能把优律小姐叫来了吧。",
            "nextDialogs": [
              "200230305"
            ]
          },
          "200230305": {
            "id": "200230305",
            "speakerId": 10030,
            "speakerName": "查尔斯",
            "text": "借用一下？也不是不行，可是你们要这个做什么？"
          }
        }
      }
    },
    {
      "subId": "2002304",
      "subQuestName": "与酒保查尔斯对话",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [],
        "dialogs": {}
      }
    },
    {
      "subId": "2002305",
      "subQuestName": "向维多利亚修女回报",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "200230401"
        ],
        "dialogs": {
          "200230401": {
            "id": "200230401",
            "speakerId": 1471,
            "speakerName": "维多利亚",
            "text": "调查的情况如何？",
            "nextDialogs": [
              "200230402"
            ]
          },
          "200230402": {
            "id": "200230402",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "这是宁禄的喝酒账单。",
            "nextDialogs": [
              "200230403"
            ]
          },
          "200230403": {
            "id": "200230403",
            "speakerId": 1471,
            "speakerName": "维多利亚",
            "text": "哼，果然是这样…不出所料。",
            "nextDialogs": [
              "200230404"
            ]
          },
          "200230404": {
            "id": "200230404",
            "speakerId": 1471,
            "speakerName": "维多利亚",
            "text": "无论过去经历了什么，只要没有真正吃到苦头，人们最终什么都不会记得…",
            "nextDialogs": [
              "200230405"
            ]
          },
          "200230405": {
            "id": "200230405",
            "speakerId": 1471,
            "speakerName": "维多利亚",
            "text": "好了，这是给你们的答谢，收下吧。",
            "nextDialogs": [
              "200230406"
            ]
          },
          "200230406": {
            "id": "200230406",
            "speakerId": 1471,
            "speakerName": "维多利亚",
            "text": "宁禄的那一份「答谢」，我也会好好思考的。"
          }
        }
      }
    },
    {
      "subId": "2002306",
      "subQuestName": "找到宁禄先生",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "200230601"
        ],
        "dialogs": {
          "200230601": {
            "id": "200230601",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "完全没有悔改的意思呢…"
          }
        }
      }
    },
    {
      "subId": "2002307",
      "subQuestName": "观察宁禄先生的近况",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "200230701"
        ],
        "dialogs": {
          "200230701": {
            "id": "200230701",
            "speakerId": 1471,
            "speakerName": "维多利亚",
            "text": "人不会轻易从过去中学到任何教训，除非…有人亲口告诉他们。"
          }
        }
      }
    },
    {
      "subId": "2002308",
      "subQuestName": "向维多利亚修女回报",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "200230901"
        ],
        "dialogs": {
          "200230901": {
            "id": "200230901",
            "speakerId": 1471,
            "speakerName": "维多利亚",
            "text": "调查的情况如何？",
            "nextDialogs": [
              "200230902"
            ]
          },
          "200230902": {
            "id": "200230902",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "宁禄正在努力戒酒。",
            "nextDialogs": [
              "200230903"
            ]
          },
          "200230903": {
            "id": "200230903",
            "speakerId": 1471,
            "speakerName": "维多利亚",
            "text": "正在努力戒酒…是这样吗。",
            "nextDialogs": [
              "200230904"
            ]
          },
          "200230904": {
            "id": "200230904",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "但是没有证据…",
            "nextDialogs": [
              "200230905"
            ]
          },
          "200230905": {
            "id": "200230905",
            "speakerId": 1471,
            "speakerName": "维多利亚",
            "text": "没关系，只要你们没有找到他喝酒的证据，我就可以认为他正在悔改了。",
            "nextDialogs": [
              "200230906"
            ]
          },
          "200230906": {
            "id": "200230906",
            "speakerId": 1471,
            "speakerName": "维多利亚",
            "text": "在没有证据之前，我一直相信，每个人都是无罪的。",
            "nextDialogs": [
              "200230907"
            ]
          },
          "200230907": {
            "id": "200230907",
            "speakerId": 1471,
            "speakerName": "维多利亚",
            "text": "但是…总是会有各种各样的证据，证明着他们的各种「罪孽」…真是好笑。",
            "nextDialogs": [
              "200230908"
            ]
          },
          "200230908": {
            "id": "200230908",
            "speakerId": 1471,
            "speakerName": "维多利亚",
            "text": "这是给你们的答谢，收下吧。希望你们不会有需要「悔罪」的那一天。"
          }
        }
      }
    },

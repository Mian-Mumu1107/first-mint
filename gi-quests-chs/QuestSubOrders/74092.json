{
  "lineCounts": {
    "Player": 8,
    "克洛妮艾": 24,
    "派蒙": 3,
    "缪妮": 5
  },
  "subQuests": [
    {
      "subId": "7409201",
      "subQuestName": "(test)和女记者对话$HIDDEN",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "740920101"
        ],
        "dialogs": {
          "740920101": {
            "id": "740920101",
            "speakerId": 5259,
            "speakerName": "克洛妮艾",
            "text": "为什么…为什么会这样…可恶…",
            "nextDialogs": [
              "740920104"
            ]
          },
          "740920104": {
            "id": "740920104",
            "speakerId": 5259,
            "speakerName": "克洛妮艾",
            "text": "#{NICKNAME}！你来了，太好了…你…至少你还知道真相…",
            "nextDialogs": [
              "740920105"
            ]
          },
          "740920105": {
            "id": "740920105",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "克洛妮艾小姐，你冷静一点，你…你怎么了？",
            "nextDialogs": [
              "740920106"
            ]
          },
          "740920106": {
            "id": "740920106",
            "speakerId": 5259,
            "speakerName": "克洛妮艾",
            "text": "就算…就算我的报道没办法登上报纸…",
            "nextDialogs": [
              "740920107"
            ]
          },
          "740920107": {
            "id": "740920107",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "你的报道怎么样了？",
            "nextDialogs": [
              "740920108"
            ]
          },
          "740920108": {
            "id": "740920108",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "嗯，我们还在奇怪，什么时候才会看见你的报道呢。",
            "nextDialogs": [
              "740920109"
            ]
          },
          "740920109": {
            "id": "740920109",
            "speakerId": 5259,
            "speakerName": "克洛妮艾",
            "text": "没看到…没看到，对，对…你们应该没看到…",
            "nextDialogs": [
              "740920110"
            ]
          },
          "740920110": {
            "id": "740920110",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "你怎么…一副慌张的样子？",
            "nextDialogs": [
              "740920111"
            ]
          },
          "740920111": {
            "id": "740920111",
            "speakerId": 5259,
            "speakerName": "克洛妮艾",
            "text": "事情是这样的…自从那天从枫丹科学院回来之后，我就开始着手编撰文章。",
            "nextDialogs": [
              "740920112"
            ]
          },
          "740920112": {
            "id": "740920112",
            "speakerId": 5259,
            "speakerName": "克洛妮艾",
            "text": "我把所有我看见的，我听见的，我感受到的全部如实写了上去。",
            "nextDialogs": [
              "740920113"
            ]
          },
          "740920113": {
            "id": "740920113",
            "speakerId": 5259,
            "speakerName": "克洛妮艾",
            "text": "比如，枫丹科学院并没有完全清除始基矿。反而重新启动了另一项和始基矿有关的项目。",
            "nextDialogs": [
              "740920114"
            ]
          },
          "740920114": {
            "id": "740920114",
            "speakerId": 5259,
            "speakerName": "克洛妮艾",
            "text": "一个艾德温曾经的部下被派去探索枫丹科学院废墟，但却在爆炸中丧生。",
            "nextDialogs": [
              "740920115"
            ]
          },
          "740920115": {
            "id": "740920115",
            "speakerId": 5259,
            "speakerName": "克洛妮艾",
            "text": "枫丹科学院高级技官雷蒙多拒绝承认他的身亡，并且坚持那些爆炸本就在计划内。",
            "nextDialogs": [
              "740920116"
            ]
          },
          "740920116": {
            "id": "740920116",
            "speakerId": 5259,
            "speakerName": "克洛妮艾",
            "text": "还有废墟里那个失控的大机器，被污染的水体…",
            "nextDialogs": [
              "740920117"
            ]
          },
          "740920117": {
            "id": "740920117",
            "speakerId": 5259,
            "speakerName": "克洛妮艾",
            "text": "所有枫丹科学院想要隐瞒的事情，我全都写进了文章里！",
            "nextDialogs": [
              "740920118"
            ]
          },
          "740920118": {
            "id": "740920118",
            "speakerId": 5259,
            "speakerName": "克洛妮艾",
            "text": "但是…就在我递交了这篇报道后，却被告知，枫丹科学院对我发起了诉讼！",
            "nextDialogs": [
              "740920119"
            ]
          },
          "740920119": {
            "id": "740920119",
            "speakerId": 5259,
            "speakerName": "克洛妮艾",
            "text": "按照报社规定，我所有和枫丹科学院有关的报道文章都必须接受「可信度审查」。",
            "nextDialogs": [
              "740920120"
            ]
          },
          "740920120": {
            "id": "740920120",
            "speakerId": 5259,
            "speakerName": "克洛妮艾",
            "text": "那一篇对枫丹科学院的报道，也被撤了下来…"
          }
        }
      }
    },
    {

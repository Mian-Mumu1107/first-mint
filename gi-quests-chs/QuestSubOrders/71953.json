        "dialogs": {
          "719530101": {
            "id": "719530101",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "关于钓鱼…",
            "nextDialogs": [
              "719530102"
            ]
          },
          "719530102": {
            "id": "719530102",
            "speakerId": 2003,
            "speakerName": "天叔",
            "text": "哦你说钓鱼啊，钓鱼可不是我用来伪装自己的工具，我是真的很喜欢钓鱼。",
            "nextDialogs": [
              "719530103"
            ]
          },
          "719530103": {
            "id": "719530103",
            "speakerId": 2003,
            "speakerName": "天叔",
            "text": "在经历一生的纷乱纠葛之后，钓鱼是一种可以静静理清一生份儿的思绪的事。",
            "nextDialogs": [
              "719530104"
            ]
          },
          "719530104": {
            "id": "719530104",
            "speakerId": 2003,
            "speakerName": "天叔",
            "text": "所以其实钓鱼的收获我也就没那么在意了…反而是你比我更在意这些鱼的价值吧？",
            "nextDialogs": [
              "719530105"
            ]
          },
          "719530105": {
            "id": "719530105",
            "speakerId": 2003,
            "speakerName": "天叔",
            "text": "呵呵…看出来了，今天的收获就全送给你吧。"
          }
        }
      }
    }
  ]

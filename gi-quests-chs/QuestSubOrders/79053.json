{
  "lineCounts": {
    "Player": 13,
    "伊迪娅": 41,
    "派蒙": 10
  },
  "subQuests": [
    {
      "subId": "7905301",
      "subQuestName": "",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "790530101"
        ],
        "dialogs": {
          "790530101": {
            "id": "790530101",
            "speakerId": 1000,
            "speakerName": "伊迪娅",
            "text": "「欢迎来到『琉形蜃境』，希望你们能够在这里稍微忘记旅途的疲惫，好好休息一番。」",
            "nextDialogs": [
              "790530102"
            ]
          },
          "790530102": {
            "id": "790530102",
            "speakerId": 1000,
            "speakerName": "伊迪娅",
            "text": "本来应该在初次见面的时候说这种欢迎辞的，唉，没想到居然发生了那么多事。",
            "nextDialogs": [
              "790530103"
            ]
          },
          "790530103": {
            "id": "790530103",
            "speakerId": 1000,
            "speakerName": "伊迪娅",
            "text": "既然一切恢复了，那就为你补上这句开场…怎么样，听上去还是挺正经的吧！",
            "nextDialogs": [
              "790530105",
              "790530110",
              "790530115",
              "790530118"
            ]
          },
          "790530105": {
            "id": "790530105",
            "speakerId": 1000,
            "speakerName": "伊迪娅",
            "text": "欸，是要我解释原理吗，其实原理我也没有那么清楚啦。总之，先成图更像是一种想法…",
            "nextDialogs": [
              "790530106"
            ]
          },
          "790530106": {
            "id": "790530106",
            "speakerId": 1000,
            "speakerName": "伊迪娅",
            "text": "就像植物如何生长其实早就写入种子之中，就像鸟的翅膀如何展开早在卵中业已注定。",
            "nextDialogs": [
              "790530107"
            ]
          },
          "790530107": {
            "id": "790530107",
            "speakerId": 1000,
            "speakerName": "伊迪娅",
            "text": "事物符合道理地变成现在目及的一切，而在最开始的开始或许已经奠定了万物的蓝图。",
            "nextDialogs": [
              "790530108"
            ]
          },
          "790530108": {
            "id": "790530108",
            "speakerId": 1000,
            "speakerName": "伊迪娅",
            "text": "先成图就是那份蓝图，然后由瓶中的折光照射，展开变成了整个琉形蜃境。啊，只不过这是只能在这支魔瓶里才能实现的伎俩。"
          },
          "790530110": {
            "id": "790530110",
            "speakerId": 1000,
            "speakerName": "伊迪娅",
            "text": "啊，你是说为什么从枫丹逃离的事吗？回想起来就像是上辈子的事一样…",
            "nextDialogs": [
              "790530111"
            ]
          },
          "790530111": {
            "id": "790530111",
            "speakerId": 1000,
            "speakerName": "伊迪娅",
            "text": "要说逃出来的理由的话，是因为「水」，枫丹的水变了，对于纯水精灵来说，那里的水现在充满了…痛苦与仇恨？",
            "nextDialogs": [
              "790530112"
            ]
          },
          "790530112": {
            "id": "790530112",
            "speakerId": 1000,
            "speakerName": "伊迪娅",
            "text": "对我们来说，如果要活下去，最好从故土逃离。啊，就是在那个时候慌不择路，倒在了沙漠里…",
            "nextDialogs": [
              "790530113"
            ]
          },
          "790530113": {
            "id": "790530113",
            "speakerId": 1000,
            "speakerName": "伊迪娅",
            "text": "要我说，这片沙漠也太大了！"
          },
          "790530115": {
            "id": "790530115",
            "speakerId": 1000,
            "speakerName": "伊迪娅",
            "text": "哦，你是说洛蒂娅姐姐吗，咦，你见过她吗？",
            "nextDialogs": [
              "790530116"
            ]
          },
          "790530116": {
            "id": "790530116",
            "speakerId": 1000,
            "speakerName": "伊迪娅",
            "text": "看来她也找到了属于自己的栖身之所…轻策庄，在璃月吗？那还真是，离开到了很远的地方啊，洛蒂娅姐姐…"
          },
          "790530118": {
            "id": "790530118",
            "speakerId": 1000,
            "speakerName": "伊迪娅",
            "text": "嗯，我会…我会努力的！也请你好好享受这里湿润的环境吧，在沙漠里有这样的地方还挺难得的呢！"
          }
        }
      }
    },
    {
      "subId": "7905302",
      "subQuestName": "",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "790531301"
        ],
        "dialogs": {
          "790531301": {
            "id": "790531301",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "伊迪娅小姐，紧急情况，重大事件！",
            "nextDialogs": [
              "790531302"
            ]
          },
          "790531302": {
            "id": "790531302",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "我们找到了一块怀表！你快看看，这是不是传说中的摩拉怀表！",
            "nextDialogs": [
              "790531305"
            ]
          },
          "790531305": {
            "id": "790531305",
            "speakerId": 1000,
            "speakerName": "伊迪娅",
            "text": "哦？让我来瞧一瞧…",
            "nextDialogs": [
              "790531306"
            ]
          },
          "790531306": {
            "id": "790531306",
            "speakerId": 1000,
            "speakerName": "伊迪娅",
            "text": "居然，居然真被你们找到了！难道说，一切都有冥冥之中的旨意？",
            "nextDialogs": [
              "790531307"
            ]
          },
          "790531307": {
            "id": "790531307",
            "speakerId": 1000,
            "speakerName": "伊迪娅",
            "text": "神奇的冒险家留下了终极的彩蛋，结果被传奇的旅行者找到…",
            "nextDialogs": [
              "790531308"
            ]
          },
          "790531308": {
            "id": "790531308",
            "speakerId": 1000,
            "speakerName": "伊迪娅",
            "text": "我好像在这之中感受到了某种…精神的传承！",
            "nextDialogs": [
              "790531309"
            ]
          },
          "790531309": {
            "id": "790531309",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "你这么夸奖我们，我倒是很高兴啦，不过现在我更好奇，找到怀表后会发生什么事…"
          }
        }
      }
    },
    {
      "subId": "7905304",
      "subQuestName": "",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "790531401"
        ],
        "dialogs": {
          "790531401": {
            "id": "790531401",
            "speakerId": 1000,
            "speakerName": "伊迪娅",
            "text": "啊，是你们两位呀，怎么了，看上去有什么事需要咨询的样子。",
            "nextDialogs": [
              "790531402"
            ]
          },
          "790531402": {
            "id": "790531402",
            "speakerId": 1000,
            "speakerName": "伊迪娅",
            "text": "不过如果有什么关于「琉形蜃境」的事要问，那问我就问对人啦，对我来说，「琉形蜃境」就跟我手掌上的水纹一样…",
            "nextDialogs": [
              "790531404",
              "790531406"
            ]
          },
          "790531404": {
            "id": "790531404",
            "speakerId": 1000,
            "speakerName": "伊迪娅",
            "text": "那只是一种比喻啦！我才不会长皱纹呢！",
            "nextDialogs": [
              "790531407"
            ]
          },
          "790531407": {
            "id": "790531407",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "总之，事情是这样的！我们在乐园里捡到了这样一张信纸！",
            "nextDialogs": [
              "790531408"
            ]
          },
          "790531408": {
            "id": "790531408",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "伊迪娅肯定知道这是怎么来的吧。",
            "nextDialogs": [
              "790531409"
            ]
          },
          "790531409": {
            "id": "790531409",
            "speakerId": 1000,
            "speakerName": "伊迪娅",
            "text": "那是当然，这封信一看就是…咦，还是第一次看到这样的信…",
            "nextDialogs": [
              "790531410"
            ]
          },
          "790531410": {
            "id": "790531410",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "手掌上的水纹看起来很模糊的样子呢…",
            "nextDialogs": [
              "790531411"
            ]
          },
          "790531411": {
            "id": "790531411",
            "speakerId": 1000,
            "speakerName": "伊迪娅",
            "text": "这、这显然是趁我不注意的时候，有人悄悄埋下的，第一次看到也很正常。",
            "nextDialogs": [
              "790531412"
            ]
          },
          "790531412": {
            "id": "790531412",
            "speakerId": 1000,
            "speakerName": "伊迪娅",
            "text": "而且，从内容上看，比起一封信，更像是留下的遗书和记录，到底是谁呢，信上这个说话的语调，总觉得有点熟悉…",
            "nextDialogs": [
              "790531413"
            ]
          },
          "790531413": {
            "id": "790531413",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "看上去和「蜃楼玉匣」有关？",
            "nextDialogs": [
              "790531414"
            ]
          },
          "790531414": {
            "id": "790531414",
            "speakerId": 1000,
            "speakerName": "伊迪娅",
            "text": "啊！这么一说我想起来了，这是把「蜃楼玉匣」带进来的那个老人留下来的…那还是，那还是我来瓶子里没有多久的事。",
            "nextDialogs": [
              "790531415"
            ]
          },
          "790531415": {
            "id": "790531415",
            "speakerId": 1000,
            "speakerName": "伊迪娅",
            "text": "老人是位稻妻人，一进来就问，这里是不是能够达成别人愿望的秘境，让我把他送回从前的战场…",
            "nextDialogs": [
              "790531416"
            ]
          },
          "790531416": {
            "id": "790531416",
            "speakerId": 1000,
            "speakerName": "伊迪娅",
            "text": "我设法向他解释，但是…他进入秘境的时候身体状况十分糟糕，看得出来由于长途跋涉，精神也到了有些油尽灯枯的程度…",
            "nextDialogs": [
              "790531417"
            ]
          },
          "790531417": {
            "id": "790531417",
            "speakerId": 1000,
            "speakerName": "伊迪娅",
            "text": "一个劲地说着「求你了，把我送回那一天…」或者「把我送回那场战争中吧…」这种话。",
            "nextDialogs": [
              "790531418"
            ]
          },
          "790531418": {
            "id": "790531418",
            "speakerId": 1000,
            "speakerName": "伊迪娅",
            "text": "所以我就用瓶中的蜃境…仿造了他想象中的战场。",
            "nextDialogs": [
              "790531419"
            ]
          },
          "790531419": {
            "id": "790531419",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "啊，所以信里的「终于回到此处」…",
            "nextDialogs": [
              "790531420"
            ]
          },
          "790531420": {
            "id": "790531420",
            "speakerId": 1000,
            "speakerName": "伊迪娅",
            "text": "大概是恍惚间醒来，发现周围的蜃境与化作记忆中战场类似的样子了吧。战场还挺可怕的，但是他却笑得很开心。",
            "nextDialogs": [
              "790531421"
            ]
          },
          "790531421": {
            "id": "790531421",
            "speakerId": 1000,
            "speakerName": "伊迪娅",
            "text": "怎么会有人在生命的最后想看到那样可怕的场景呢…"
          },
          "790531406": {
            "id": "790531406",
            "speakerId": 1000,
            "speakerName": "伊迪娅",
            "text": "只、只是一种比喻啦，就跟你的掌纹一样，没什么好看的。"
          }
        }
      }
    }
  ]
}
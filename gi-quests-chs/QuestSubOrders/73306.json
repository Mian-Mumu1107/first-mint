  "subQuests": [
    {
      "subId": "7305525",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "730552501"
        ],
        "dialogs": {
          "730552501": {
            "id": "730552501",
            "speakerId": 4218,
            "speakerName": "提尔扎德",
            "text": "…是你们啊，还有什么话要说吗？",
            "nextDialogs": [
              "730552503",
              "730552508",
              "730552512"
            ]
          },
          "730552503": {
            "id": "730552503",
            "speakerId": 4218,
            "speakerName": "提尔扎德",
            "text": "…我居然到最后还怀疑了他。我真是个混蛋…",
            "nextDialogs": [
              "730552504"
            ]
          },
          "730552504": {
            "id": "730552504",
            "speakerId": 4218,
            "speakerName": "提尔扎德",
            "text": "现在我对他只有感谢…",
            "nextDialogs": [
              "730552505"
            ]
          },
          "730552505": {
            "id": "730552505",
            "speakerId": 4218,
            "speakerName": "提尔扎德",
            "text": "之前我一直摇摆不定，无论是学术上还是生活上…但从今往后我不会再动摇了。我会走自己坚信的那条路，无论有多么艰难…",
            "nextDialogs": [
              "730552506"
            ]
          },
          "730552506": {
            "id": "730552506",
            "speakerId": 4218,
            "speakerName": "提尔扎德",
            "text": "就算是为了告慰哲伯莱勒…"
          },
          "730552508": {
            "id": "730552508",
            "speakerId": 4218,
            "speakerName": "提尔扎德",
            "text": "我开始怀疑自己之前读到的那些文献究竟有多少可信度…",
            "nextDialogs": [
              "730552509"
            ]
          },
          "730552509": {
            "id": "730552509",
            "speakerId": 4218,
            "speakerName": "提尔扎德",
            "text": "那首「祷文」…有种说不上来的怪异的感觉，还有萨梅尔…说的那些话…有必要回去之后重新深入研究一下。",
            "nextDialogs": [
              "730552510"
            ]
          },
          "730552510": {
            "id": "730552510",
            "speakerId": 4218,
            "speakerName": "提尔扎德",
            "text": "当然，首要任务还是按原计划写完论文。"
          },
          "730552512": {
            "id": "730552512",
            "speakerId": 4218,
            "speakerName": "提尔扎德",
            "text": "唉…我也希望自己能为她做些什么，可是…",
            "nextDialogs": [
              "730552513"
            ]
          },
          "730552513": {
            "id": "730552513",
            "speakerId": 4218,
            "speakerName": "提尔扎德",
            "text": "我什么都做不到…",
            "nextDialogs": [
              "730552514"
            ]
          },
          "730552514": {
            "id": "730552514",
            "speakerId": 4218,
            "speakerName": "提尔扎德",
            "text": "她又什么都不肯说，但凡她能说出一个愿望，只要是我力所能及的，我都愿意为她办到…"
          }
        }
      }
    },
    {
      "subId": "7305526",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "730552601"
        ],
        "dialogs": {
          "730552601": {
            "id": "730552601",
            "speakerId": 16694,
            "speakerName": "婕德",
            "text": "抱歉…还不能很好地控制自己的情绪。",
            "nextDialogs": [
              "730552602"
            ]
          },
          "730552602": {
            "id": "730552602",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "不要道歉。",
            "nextDialogs": [
              "730552603"
            ]
          },
          "730552603": {
            "id": "730552603",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "对啊…婕德很难过，我们都知道的。",
            "nextDialogs": [
              "730552604"
            ]
          },
          "730552604": {
            "id": "730552604",
            "speakerId": 16694,
            "speakerName": "婕德",
            "text": "谢谢你们…祝你们今后的旅途一切顺利…",
            "nextDialogs": [
              "730552605"
            ]
          },
          "730552605": {
            "id": "730552605",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "唔…也希望婕德今后可以一切顺利…一定会的！"
          }
        }
      }
    },
    {
      "subId": "7305527",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "730552701"
        ],
        "dialogs": {
          "730552701": {
            "id": "730552701",
            "speakerId": 4247,
            "speakerName": "博尼法兹",
            "text": "怎么没有看到奥米德和米尔萨德？难道说他们…",
            "nextDialogs": [
              "730552702"
            ]
          },
          "730552702": {
            "id": "730552702",
            "speakerId": 1702,
            "speakerName": "纳赫蒂加尔",
            "text": "他们没事，只是…都各自有了打算，不跟着我们做驮兽生意了。",
            "nextDialogs": [
              "730552703"
            ]
          },
          "730552703": {
            "id": "730552703",
            "speakerId": 4247,
            "speakerName": "博尼法兹",
            "text": "啊？那怎么办，光凭我们俩，人手不够吧，还得再招人…可是又没几个人愿意到阿如村来…",
            "nextDialogs": [
              "730552704"
            ]
          },
          "730552704": {
            "id": "730552704",
            "speakerId": 4247,
            "speakerName": "博尼法兹",
            "text": "算了，这些事情以后再说，塞琉斯平安回来了就行。下次可不能让它再去这么危险的地方了。",
            "nextDialogs": [
              "730552705"
            ]
          },
          "730552705": {
            "id": "730552705",
            "speakerId": 1702,
            "speakerName": "纳赫蒂加尔",
            "text": "你这是说的什么话？我们可是驮兽商人，不让驮兽出去干活，我们吃什么？",
            "nextDialogs": [
              "730552706"
            ]
          },
          "730552706": {
            "id": "730552706",
            "speakerId": 1702,
            "speakerName": "纳赫蒂加尔",
            "text": "光喝风可填不饱肚子，再说了，这种地方你张嘴试试，保准一嘴沙…",
            "nextDialogs": [
              "730552707"
            ]
          },
          "730552707": {
            "id": "730552707",
            "speakerId": 4247,
            "speakerName": "博尼法兹",
            "text": "那也不能让塞琉斯去冒险啊，我看你身体也挺强健的，不如你来驮货物。",
            "nextDialogs": [
              "730552708"
            ]
          },
          "730552708": {
            "id": "730552708",
            "speakerId": 1702,
            "speakerName": "纳赫蒂加尔",
            "text": "？"
          }
        }
      }
    }
  ]
}
  "subQuests": [
    {
      "subId": "2204601",
      "subQuestName": "与寝子对话",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "220460101"
        ],
        "dialogs": {
          "220460101": {
            "id": "220460101",
            "speakerId": 3189,
            "speakerName": "「寝子」",
            "text": "神社又有些乱了啊…",
            "nextDialogs": [
              "220460102"
            ]
          },
          "220460102": {
            "id": "220460102",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "怎么了？",
            "nextDialogs": [
              "220460103"
            ]
          },
          "220460103": {
            "id": "220460103",
            "speakerId": 3189,
            "speakerName": "「寝子」",
            "text": "唔喵，是汝等啊，来得正好。",
            "nextDialogs": [
              "220460104"
            ]
          },
          "220460104": {
            "id": "220460104",
            "speakerId": 3189,
            "speakerName": "「寝子」",
            "text": "一段时间没打扫，神社的屋子周围，又有了好多污渍。",
            "nextDialogs": [
              "220460105"
            ]
          },
          "220460105": {
            "id": "220460105",
            "speakerId": 3189,
            "speakerName": "「寝子」",
            "text": "这样子可不能接待来神社的人类啊…",
            "nextDialogs": [
              "220460106"
            ]
          },
          "220460106": {
            "id": "220460106",
            "speakerId": 3189,
            "speakerName": "「寝子」",
            "text": "汝等，能和上次一样，帮奴家打扫一下神社吗？",
            "nextDialogs": [
              "220460108",
              "220460113"
            ]
          },
          "220460108": {
            "id": "220460108",
            "speakerId": 3189,
            "speakerName": "「寝子」",
            "text": "奴家可不会去主动找那两个绿绿的人类说话。",
            "nextDialogs": [
              "220460109"
            ]
          },
          "220460109": {
            "id": "220460109",
            "speakerId": 3189,
            "speakerName": "「寝子」",
            "text": "那个高高的人类，看奴家的眼神总是很奇怪…",
            "nextDialogs": [
              "220460110"
            ]
          },
          "220460110": {
            "id": "220460110",
            "speakerId": 3189,
            "speakerName": "「寝子」",
            "text": "另外一个绿绿的人类，又总是那副提不起劲的样子。",
            "nextDialogs": [
              "220460111"
            ]
          },
          "220460111": {
            "id": "220460111",
            "speakerId": 3189,
            "speakerName": "「寝子」",
            "text": "喵喵，无论怎么想，都是两个靠不住的人类。",
            "nextDialogs": [
              "220460115"
            ]
          },
          "220460115": {
            "id": "220460115",
            "speakerId": 3189,
            "speakerName": "「寝子」",
            "text": "总之，就拜托汝等了。就和上次一样，用长棍子和水「打扫」，汝等明白了吗？"
          },
          "220460113": {
            "id": "220460113",
            "speakerId": 3189,
            "speakerName": "「寝子」",
            "text": "那个石头人类一直在忙个不停，不知道在咚咚咚地敲什么…",
            "nextDialogs": [
              "220460114"
            ]
          },
          "220460114": {
            "id": "220460114",
            "speakerId": 3189,
            "speakerName": "「寝子」",
            "text": "明明石头已经敲好了，为什么还在咚咚咚呢，真烦…"
          }
        }
      }
    },
    {
      "subId": "2204602",
      "subQuestName": "打扫浅濑神社周围的污渍",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "220460201"
        ],
        "dialogs": {
          "220460201": {
            "id": "220460201",
            "speakerId": 3189,
            "speakerName": "「寝子」",
            "text": "总之，「打扫」就拜托汝等了，奴家就在这里等着汝等，喵喵。"
          }
        }
      }
    },
    {
      "subId": "2204603",
      "subQuestName": "向寝子回报",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "220460301"
        ],
        "dialogs": {
          "220460301": {
            "id": "220460301",
            "speakerId": 3189,
            "speakerName": "「寝子」",
            "text": "喔，汝等已经「打扫」完了吗？",
            "nextDialogs": [
              "220460302"
            ]
          },
          "220460302": {
            "id": "220460302",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "已经打扫完了。",
            "nextDialogs": [
              "220460303"
            ]
          },
          "220460303": {
            "id": "220460303",
            "speakerId": 3189,
            "speakerName": "「寝子」",
            "text": "喵喵，那就好，汝等果然非常可靠啊。",
            "nextDialogs": [
              "220460304"
            ]
          },
          "220460304": {
            "id": "220460304",
            "speakerId": 3189,
            "speakerName": "「寝子」",
            "text": "神社真是越来越像样了，等阿响回来了之后，她一定会非常高兴的。",
            "nextDialogs": [
              "220460305"
            ]
          },
          "220460305": {
            "id": "220460305",
            "speakerId": 3189,
            "speakerName": "「寝子」",
            "text": "奴家一定要好好打理神社才行…喵喵…"
          }
        }
      }
    }
  ]
}
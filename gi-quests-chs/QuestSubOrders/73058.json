    {
      "subId": "7305804",
      "subQuestName": "和兰迦鲁对话",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "730580201"
        ],
        "dialogs": {
          "730580201": {
            "id": "730580201",
            "speakerId": 20577,
            "speakerName": "兰迦鲁",
            "text": "怎么样，有发现什么吗？",
            "nextDialogs": [
              "730580202"
            ]
          },
          "730580202": {
            "id": "730580202",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "唔…只发现了语焉不详的命令，还有这个！一朵风干的花！",
            "nextDialogs": [
              "730580203"
            ]
          },
          "730580203": {
            "id": "730580203",
            "speakerId": 20577,
            "speakerName": "兰迦鲁",
            "text": "欸…！这个，可以给我吗？",
            "nextDialogs": [
              "730580204"
            ]
          },
          "730580204": {
            "id": "730580204",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "这个是坏人留下的，你就不怕有毒…什么的吗？",
            "nextDialogs": [
              "730580205"
            ]
          },
          "730580205": {
            "id": "730580205",
            "speakerId": 20577,
            "speakerName": "兰迦鲁",
            "text": "不需要担心，我见过这朵花…那个人，我应该见过…请你交给我，好吗？",
            "nextDialogs": [
              "730580206"
            ]
          },
          "730580206": {
            "id": "730580206",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "请你拿去吧。",
            "nextDialogs": [
              "730580207"
            ]
          },
          "730580207": {
            "id": "730580207",
            "speakerId": 20577,
            "speakerName": "兰迦鲁",
            "text": "#谢谢你！那菈{NICKNAME}和白飞飞！",
            "nextDialogs": [
              "730580208"
            ]
          },
          "730580208": {
            "id": "730580208",
            "speakerId": 1002,
            "speakerName": "Black Screen",
            "text": "兰迦鲁将风干的小花带去了无郁稠林…"
          }
        }
      }
    },

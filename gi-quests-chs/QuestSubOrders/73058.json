          "730580401": {
            "id": "730580401",
            "speakerId": 20577,
            "speakerName": "兰迦鲁",
            "text": "去看看坏蛋那菈的营地吧！一定能知道他们是来做什么的！",
            "nextDialogs": [
              "730580402"
            ]
          },
          "730580402": {
            "id": "730580402",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "你是怎么分辨坏蛋的？",
            "nextDialogs": [
              "730580403"
            ]
          },
          "730580403": {
            "id": "730580403",
            "speakerId": 20577,
            "speakerName": "兰迦鲁",
            "text": "#唔…不知道，说不清楚！但是我知道，那菈{NICKNAME}和白飞飞一定不是坏人！兰迦鲁相信！"
          }
        }
      }

    {
      "subId": "7527101",
      "subQuestName": "与斯奇交谈$HIDDEN",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "752710401"
        ],
        "dialogs": {
          "752710401": {
            "id": "752710401",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "我来帮你把它们涂成红色吧。",
            "nextDialogs": [

    {
      "subId": "7527101",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "752710101"
        ],
        "dialogs": {
          "752710101": {
            "id": "752710101",
            "speakerId": 1000,
            "speakerName": "斯奇",
            "text": "请不要弄坏了这些气球。如果你想玩气球，我可以送你一些别的。",
            "nextDialogs": [
              "752710102"
            ]
          },
          "752710102": {
            "id": "752710102",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "这些气球还挺特别的。",
            "nextDialogs": [
              "752710103"
            ]
          },
          "752710103": {
            "id": "752710103",
            "speakerId": 1000,
            "speakerName": "斯奇",
            "text": "说起来还有点不好意思，这是重要的道具。",
            "nextDialogs": [
              "752710104"
            ]
          },
          "752710104": {
            "id": "752710104",
            "speakerId": 1000,
            "speakerName": "斯奇",
            "text": "看它的样子，你应该也猜到是用来干什么的吧？",
            "nextDialogs": [
              "752710106",
              "752710108"
            ]
          },
          "752710106": {
            "id": "752710106",
            "speakerId": 1000,
            "speakerName": "斯奇",
            "text": "是告白啦。",
            "nextDialogs": [
              "752710109"
            ]
          },
          "752710109": {
            "id": "752710109",
            "speakerId": 1000,
            "speakerName": "斯奇",
            "text": "我会在浪漫的气球中间向我心爱的尤普依表露心意，你觉得怎么样？",
            "nextDialogs": [
              "752710110"
            ]
          },
          "752710110": {
            "id": "752710110",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "应该用红色的气球。",
            "nextDialogs": [
              "752710111"
            ]
          },
          "752710111": {
            "id": "752710111",
            "speakerId": 1000,
            "speakerName": "斯奇",
            "text": "欸？你说得有道理…我果然还是缺乏了一点浪漫精神吗？",
            "nextDialogs": [
              "752710112"
            ]
          },
          "752710112": {
            "id": "752710112",
            "speakerId": 1000,
            "speakerName": "斯奇",
            "text": "可尤普依马上就要来了，这时候去哪里找红气球啊？"
          },
          "752710108": {
            "id": "752710108",
            "speakerId": 1000,
            "speakerName": "斯奇",
            "text": "没…没错！"
          }
        }
      }
    },
    {
      "subId": "7527105",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "752710501"
        ],
        "dialogs": {
          "752710501": {
            "id": "752710501",
            "speakerId": 1000,
            "speakerName": "斯奇",
            "text": "谢谢你，好心的朋友。",
            "nextDialogs": [
              "752710502"
            ]
          },
          "752710502": {
            "id": "752710502",
            "speakerId": 1001,
            "speakerName": "尤普依",
            "text": "斯奇给你添麻烦了吧，他的思路跟正常人不太一样，不过这也是我喜欢他的地方。"
          }
        }
      }
    }

    },
    {
      "subId": "7527102",
      "subQuestName": "将气球涂成红色$HIDDEN",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "752710201"
        ],
        "dialogs": {
          "752710201": {
            "id": "752710201",
            "speakerId": 1000,
            "speakerName": "斯奇",
            "text": "好心的朋友，遇见你我真是太走运了。请帮我把气球涂成浪漫的红色吧。"
          }
        }
      }
    },
    {
      "subId": "7527103",
      "subQuestName": "与斯奇交谈$HIDDEN",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "752710301"
        ],
        "dialogs": {
          "752710301": {
            "id": "752710301",
            "speakerId": 1000,
            "speakerName": "斯奇",
            "text": "浪漫的红气球！真漂亮…我心爱的尤普依一定会喜欢的…",
            "nextDialogs": [
              "752710302"
            ]
          },
          "752710302": {
            "id": "752710302",
            "speakerId": 1000,
            "speakerName": "斯奇",
            "text": "你说是吧？朋友。",
            "nextDialogs": [
              "752710305"
            ]
          },
          "752710305": {
            "id": "752710305",
            "speakerId": 1000,
            "speakerName": "斯奇",
            "text": "不论如何，非常感谢你，朋友，请别离开，我想让尤普依也认识你一下。",
            "nextDialogs": [
              "752710306"
            ]
          },
          "752710306": {
            "id": "752710306",
            "speakerId": 1000,
            "speakerName": "斯奇",
            "text": "算算时间，她马上就会过来了，我们约好的。"
          }
        }
      }
    },
    {
      "subId": "7527105",
      "subQuestName": "见证斯奇的告白仪式$HIDDEN",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "752710601"
        ],
        "dialogs": {
          "752710601": {
            "id": "752710601",
            "speakerId": 1000,
            "speakerName": "斯奇",
            "text": "尤普依！你来啦！",
            "nextDialogs": [
              "752710602"
            ]
          },
          "752710602": {
            "id": "752710602",
            "speakerId": 1001,
            "speakerName": "尤普依",
            "text": "斯奇…？是你？你怎么穿成这个样子…",
            "nextDialogs": [
              "752710603"
            ]
          },
          "752710603": {
            "id": "752710603",
            "speakerId": 1000,
            "speakerName": "斯奇",
            "text": "这是你最喜欢的娜娜丝梨人…我去租来的，帅吗？还有这些气球，也是我专门准备的。",
            "nextDialogs": [
              "752710604"
            ]
          },
          "752710604": {
            "id": "752710604",
            "speakerId": 1000,
            "speakerName": "斯奇",
            "text": "其实我有一句话，很早就想跟你说了…和我交往吧！",
            "nextDialogs": [
              "752710605"
            ]
          },
          "752710605": {
            "id": "752710605",
            "speakerId": 1001,
            "speakerName": "尤普依",
            "text": "你…你有病吧？",
            "nextDialogs": [
              "752710606"
            ]
          },
          "752710606": {
            "id": "752710606",
            "speakerId": 1000,
            "speakerName": "斯奇",
            "text": "不！我心爱的姑娘，尤普依，请和我交往吧！",
            "nextDialogs": [
              "752710607"
            ]
          },
          "752710607": {
            "id": "752710607",
            "speakerId": 1001,
            "speakerName": "尤普依",
            "text": "你真的不是脑子坏了吗？今天是我们结婚三周年啊！",
            "nextDialogs": [
              "752710608"
            ]
          },
          "752710608": {
            "id": "752710608",
            "speakerId": 1000,
            "speakerName": "斯奇",
            "text": "我当然记得！但…你一直说我不懂浪漫，结婚前连一次正经的告白都没有…所以…这就是我迟到的告白！",
            "nextDialogs": [
              "752710609"
            ]
          },
          "752710609": {
            "id": "752710609",
            "speakerId": 1001,
            "speakerName": "尤普依",
            "text": "哈…明白了，我同意了哦。",
            "nextDialogs": [
              "752710610"
            ]
          },
          "752710610": {
            "id": "752710610",
            "speakerId": 1000,
            "speakerName": "斯奇",
            "text": "欸？真的吗？",
            "nextDialogs": [
              "752710611"
            ]
          },
          "752710611": {
            "id": "752710611",
            "speakerId": 1001,
            "speakerName": "尤普依",
            "text": "我说我同意啦，我浪漫的小男子汉。",
            "nextDialogs": [
              "752710612"
            ]
          },
          "752710612": {
            "id": "752710612",
            "speakerId": 1002,
            "speakerName": "Black Screen",
            "text": "悠悠的风儿吹过，将两人拥抱在了一起。"
          }
        }
      }
    },

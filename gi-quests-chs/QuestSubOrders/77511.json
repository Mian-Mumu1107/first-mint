        "dialogs": {
          "775110101": {
            "id": "775110101",
            "speakerId": 1000,
            "speakerName": "赛况播报员",
            "text": "来自提瓦特各地的杰出冒险家们，首届「冒险家竞技大赛」的所有赛程都已结束。",
            "nextDialogs": [
              "775110102"
            ]
          },
          "775110102": {
            "id": "775110102",
            "speakerId": 1000,
            "speakerName": "赛况播报员",
            "text": "#结果已然揭晓，「传奇」一词具象化般的{NICKNAME}和{M#他}{F#她}的向导，不可阻挡地直取冠军！",
            "nextDialogs": [
              "775110103"
            ]
          },
          "775110103": {
            "id": "775110103",
            "speakerId": 1001,
            "speakerName": "萨林",
            "text": "漂亮！",
            "nextDialogs": [
              "775110104"
            ]
          },
          "775110104": {
            "id": "775110104",
            "speakerId": 1002,
            "speakerName": "瓦乐瑞娜",
            "text": "恭喜啊，两位！",
            "nextDialogs": [
              "775110105"
            ]
          },
          "775110105": {
            "id": "775110105",
            "speakerId": 1003,
            "speakerName": "苏赫拉布",
            "text": "这位陌生的前辈…就是我以后努力的目标了…",
            "nextDialogs": [
              "775110106"
            ]
          },
          "775110106": {
            "id": "775110106",
            "speakerId": 1004,
            "speakerName": "岚姐",
            "text": "换成别人，在最后时刻把我从榜首打下来，我可能还会有一点不服输。",
            "nextDialogs": [
              "775110107"
            ]
          },
          "775110107": {
            "id": "775110107",
            "speakerId": 1004,
            "speakerName": "岚姐",
            "text": "但由你和派蒙的组合出手，那还说什么？应该为你们举杯庆祝！",
            "nextDialogs": [
              "775110108"
            ]
          },
          "775110108": {
            "id": "775110108",
            "speakerId": 1005,
            "speakerName": "梨香",
            "text": "喝个痛快！",
            "nextDialogs": [
              "775110109"
            ]
          },
          "775110109": {
            "id": "775110109",
            "speakerId": 1006,
            "speakerName": "塔拉利欣",
            "text": "除了摩拉，我们还为你准备了一些纪念物，请稍等片刻…",
            "nextDialogs": [
              "775110112"
            ]
          },
          "775110112": {
            "id": "775110112",
            "speakerId": 1007,
            "speakerName": "派蒙",
            "text": "虽然意外参加了这场比赛，观众也不怎么多，但考虑到比赛本身就是临时举办的，已经很尽兴了。",
            "nextDialogs": [
              "775110113"
            ]
          },
          "775110113": {
            "id": "775110113",
            "speakerId": 1007,
            "speakerName": "派蒙",
            "text": "而且，我们正好也练了练手，好好强化了一下刚刚学会没多久的新本领！",
            "nextDialogs": [
              "775110114"
            ]
          },
          "775110114": {
            "id": "775110114",
            "speakerId": 1005,
            "speakerName": "梨香",
            "text": "那庆功宴…",
            "nextDialogs": [
              "775110115"
            ]
          },
          "775110115": {
            "id": "775110115",
            "speakerId": 1008,
            "speakerName": "玉霞",
            "text": "喝酒的事之后再说，这场比赛最重要的目的还没解决。",
            "nextDialogs": [
              "775110116"
            ]
          },
          "775110116": {
            "id": "775110116",
            "speakerId": 1005,
            "speakerName": "梨香",
            "text": "噫！倒也是。",
            "nextDialogs": [
              "775110117"
            ]
          },
          "775110117": {
            "id": "775110117",
            "speakerId": 1004,
            "speakerName": "岚姐",
            "text": "现在，能完全服众的人在场了，之前暂停的会议，也该就此继续下去。",
            "nextDialogs": [
              "775110118"
            ]
          },
          "775110118": {
            "id": "775110118",
            "speakerId": 1006,
            "speakerName": "塔拉利欣",
            "text": "#按照规则，投票决定任何一条议题时，{NICKNAME}的权重将以其余人的总合计算。",
            "nextDialogs": [
              "775110119"
            ]
          },
          "775110119": {
            "id": "775110119",
            "speakerId": 1007,
            "speakerName": "派蒙",
            "text": "总合…就是加在一起的意思…也就是说…",
            "nextDialogs": [
              "775110120"
            ]
          },
          "775110120": {
            "id": "775110120",
            "speakerId": 1004,
            "speakerName": "岚姐",
            "text": "#{NICKNAME}有一票通过或否决权，还可以直接给出修改的建议。",
            "nextDialogs": [
              "775110121"
            ]
          },
          "775110121": {
            "id": "775110121",
            "speakerId": 1007,
            "speakerName": "派蒙",
            "text": "#现在我理解这个冠军份量了…搞不好，{NICKNAME}说的话，能影响成百上千的冒险家？"
          }
        }
      }

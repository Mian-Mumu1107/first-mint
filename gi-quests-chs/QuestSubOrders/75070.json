    {
      "subId": "7507015",
      "subQuestName": "(test)隐藏判断第一次失败$HIDDEN",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "750701501"
        ],
        "dialogs": {
          "750701501": {
            "id": "750701501",
            "speakerId": 21586,
            "speakerName": "马尼菲科",
            "text": "有什么事吗？那些小家伙也不听你使唤吗？"
          }
        }
      }
    },
    {
      "subId": "7507016",
      "subQuestName": "与马尼菲科对话",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "750701601"
        ],
        "dialogs": {
          "750701601": {
            "id": "750701601",
            "speakerId": 21586,
            "speakerName": "马尼菲科",
            "text": "唉…如你所见，效果很…不理想。就像我这个人一样…一事无成，一事无成！",
            "nextDialogs": [
              "750701602"
            ]
          },
          "750701602": {
            "id": "750701602",
            "speakerId": 21586,
            "speakerName": "马尼菲科",
            "text": "啊…我的家人总是告诉我，像我这样的小树总能投下大大的影子！全是胡说八道，全是胡说八道！他们只是想羞辱我！",
            "nextDialogs": [
              "750701603"
            ]
          },
          "750701603": {
            "id": "750701603",
            "speakerId": 21586,
            "speakerName": "马尼菲科",
            "text": "呜……",
            "nextDialogs": [
              "750701604"
            ]
          },
          "750701604": {
            "id": "750701604",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "呜哇…你也别发脾气啦！发脾气也不能让你显得块头更大呀！",
            "nextDialogs": [
              "750701606",
              "750701610"
            ]
          },
          "750701606": {
            "id": "750701606",
            "speakerId": 21586,
            "speakerName": "马尼菲科",
            "text": "谁说我泄气了！可恶！混蛋！愤怒和羞辱只能鞭策我继续前进！这就是恼羞成怒带来的力量！我们继续！",
            "nextDialogs": [
              "750701607"
            ]
          },
          "750701607": {
            "id": "750701607",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "唔…虽然确实蛮有斗志的…但这个人真奇怪啊…",
            "nextDialogs": [
              "750701608"
            ]
          },
          "750701608": {
            "id": "750701608",
            "speakerId": 21586,
            "speakerName": "马尼菲科",
            "text": "嗯，嗯。"
          },
          "750701610": {
            "id": "750701610",
            "speakerId": 21586,
            "speakerName": "马尼菲科",
            "text": "好！我们重来！",
            "nextDialogs": [
              "750701611"
            ]
          },
          "750701611": {
            "id": "750701611",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "呜哇！这心态恢复得也太快了点！"
          }
        }
      }
    },
    {
      "subId": "7507018",

    "马尼菲科": 28
  },
  "subQuests": [
    {
      "subId": "7507007",
      "subQuestName": "(test)翼手龙听导演讲戏$HIDDEN",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "750700701"
        ],
        "dialogs": {
          "750700701": {
            "id": "750700701",
            "speakerId": 21586,
            "speakerName": "马尼菲科",
            "text": "哈哈！我就知道我们会再次见面！瞧瞧你们来得多巧！你们即将见证我拍下人生中第二件杰作！",
            "nextDialogs": [
              "750700702"
            ]
          },
          "750700702": {
            "id": "750700702",
            "speakerId": 21586,
            "speakerName": "马尼菲科",
            "text": "呃…也不是第二件啦，我不错的作品还是很多的…",
            "nextDialogs": [
              "750700703"
            ]
          },
          "750700703": {
            "id": "750700703",
            "speakerId": 21586,
            "speakerName": "马尼菲科",
            "text": "总之，你们非常幸运，我正在准备在这里拍下一张动态场景画片，哈哈，这是我第一次挑战动态拍摄！",
            "nextDialogs": [
              "750700704"
            ]
          },
          "750700704": {
            "id": "750700704",
            "speakerId": 21586,
            "speakerName": "马尼菲科",
            "text": "毕竟以前都是在案发现场拍受害者归档画片…呃，不过那些就没必要细说啦…",
            "nextDialogs": [
              "750700705"
            ]
          },
          "750700705": {
            "id": "750700705",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "所以，这次还需要我们帮忙吗，马尼菲科先生？",
            "nextDialogs": [
              "750700706"
            ]
          },
          "750700706": {
            "id": "750700706",
            "speakerId": 14662,
            "speakerName": "#{REALNAME[ID(2)|SHOWHOST(true)]}",
            "text": "呀？",
            "nextDialogs": [
              "750700707"
            ]
          },
          "750700707": {
            "id": "750700707",
            "speakerId": 21586,
            "speakerName": "马尼菲科",
            "text": "不…呃，嗯，如果你们能帮忙的话，也好！来吧，让我给你介绍下情况。",
            "nextDialogs": [
              "750700708"
            ]
          },
          "750700708": {
            "id": "750700708",
            "speakerId": 21586,
            "speakerName": "马尼菲科",
            "text": "是这样的，我需要在这座瀑布拍摄一张绒翼龙向水面俯冲的画片，就是它在俯冲到谷底水面之上时最具冲击感的那个瞬间！",
            "nextDialogs": [
              "750700709"
            ]
          },
          "750700709": {
            "id": "750700709",
            "speakerId": 21586,
            "speakerName": "马尼菲科",
            "text": "为了做准备，我在瀑布下的水潭里隐藏了能吸引绒翼龙的食物。只是…唉，到现在我还没有等到它们以合适的角度俯冲下去。",
            "nextDialogs": [
              "750700710"
            ]
          },
          "750700710": {
            "id": "750700710",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "欸？不过水面上那个大圈…是个什么东西呀？",
            "nextDialogs": [
              "750700711"
            ]
          },
          "750700711": {
            "id": "750700711",
            "speakerId": 21586,
            "speakerName": "马尼菲科",
            "text": "不用太在意那个，我也不太清楚…只是从附近的部落捡来充当标靶的垃圾罢了。",
            "nextDialogs": [
              "750700712"
            ]
          },
          "750700712": {
            "id": "750700712",
            "speakerId": 21586,
            "speakerName": "马尼菲科",
            "text": "唉，到目前为止，我拍出的废片都是平平无奇，真是气人。我倒是还能继续等啦，只是既然你们来了…",
            "nextDialogs": [
              "750700713"
            ]
          },
          "750700713": {
            "id": "750700713",
            "speakerId": 21586,
            "speakerName": "马尼菲科",
            "text": "或许你们可以…呃，开导一下它们？教教这些任性的小家伙们怎么好好俯冲！毕竟你们可是全纳塔有名的驯龙大师嘛！",
            "nextDialogs": [
              "750700714"
            ]
          },
          "750700714": {
            "id": "750700714",
            "speakerId": 21586,
            "speakerName": "马尼菲科",
            "text": "很好，我从这里发出信号，只要在我倒数到「一」的时候，你们能够准确地冲到标靶的所在的水面上就好！",
            "nextDialogs": [
              "750700716",
              "750700718"
            ]
          },
          "750700716": {
            "id": "750700716",
            "speakerId": 21586,
            "speakerName": "马尼菲科",
            "text": "哈哈，太好了，那就快点试试看吧！"
          },
          "750700718": {
            "id": "750700718",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "没关系，失败也不过是浪费了我们的时间而已。我们是旅行者，旅行者的时间最不值钱。",
            "nextDialogs": [
              "750700719"
            ]
          },
          "750700719": {
            "id": "750700719",
            "speakerId": 14662,
            "speakerName": "#{REALNAME[ID(2)|SHOWHOST(true)]}",
            "text": "？"
          }
        }
      }
    },

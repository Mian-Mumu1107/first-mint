      }
    },
    {
      "subId": "7507014",
      "subQuestName": "与马尼菲科对话",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "750701401"
        ],
        "dialogs": {
          "750701401": {
            "id": "750701401",
            "speakerId": 21586,
            "speakerName": "马尼菲科",
            "text": "可恶，我们又得重来一次了！呃…我是说，如果你们不介意的话。",
            "nextDialogs": [
              "750701402"
            ]
          },
          "750701402": {
            "id": "750701402",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "唉…既然来都来了，没什么介意不介意啦。",
            "nextDialogs": [
              "750701404",
              "750701406"
            ]
          },
          "750701404": {
            "id": "750701404",
            "speakerId": 21586,
            "speakerName": "马尼菲科",
            "text": "嗯，谢谢。"
          },
          "750701406": {
            "id": "750701406",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "跳崖可是体力活，也该让人家休息一下啦！",
            "nextDialogs": [
              "750701407"
            ]
          },
          "750701407": {
            "id": "750701407",
            "speakerId": 21586,
            "speakerName": "马尼菲科",
            "text": "唔…抱歉，是我欠考虑了。等你们准备好了直接开始就是，我一直在这里等着呢。"
          }
        }
      }
    },
    {
      "subId": "7507009",
      "subQuestName": "与马尼菲科对话",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "750700901"
        ],
        "dialogs": {
          "750700901": {
            "id": "750700901",
            "speakerId": 21586,
            "speakerName": "马尼菲科",
            "text": "哈哈，完美！副本给你！",
            "nextDialogs": [
              "750700902"
            ]
          },
          "750700902": {
            "id": "750700902",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "哇！果然好厉害！",
            "nextDialogs": [
              "750700903"
            ]
          },
          "750700903": {
            "id": "750700903",
            "speakerId": 21586,
            "speakerName": "马尼菲科",
            "text": "来，给你报酬，这是第二次…不，第三次受你们帮助了，我都怀疑如果没有你们帮忙，我这次摄影之旅还能不能走到最后！",
            "nextDialogs": [
              "750700904"
            ]
          },
          "750700904": {
            "id": "750700904",
            "speakerId": 21586,
            "speakerName": "马尼菲科",
            "text": "我的下一个目的地是这里…在地图上给你们标好了。如果有兴趣的话，我时刻等着与你们再次合作。",
            "nextDialogs": [
              "750700905"
            ]
          },
          "750700905": {
            "id": "750700905",
            "speakerId": 21586,
            "speakerName": "马尼菲科",
            "text": "啊…时间差不多了，我要走咯！也祝你们好运！",
            "nextDialogs": [
              "750700906"
            ]
          },
          "750700906": {
            "id": "750700906",
            "speakerId": 1003,
            "speakerName": "Black Screen",
            "text": "马尼菲科收拾好行李，欢快地跃上了热气球。\\n随着热气球慢慢远去，小小的马尼菲科哈哈大笑，留下了悠远的回声。"
          }
        }
      }
    },
    {

  "subQuests": [
    {
      "subId": "7351601",
      "subQuestName": "回到学者身边",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "735160101"
        ],
        "dialogs": {
          "735160101": {
            "id": "735160101",
            "speakerId": 1000,
            "speakerName": "维纳亚克",
            "text": "——施芮娅，你刚刚看到了吗！我们的「对沙虫用杀虫炮」，果然是划时代的设计！",
            "nextDialogs": [
              "735160102"
            ]
          },
          "735160102": {
            "id": "735160102",
            "speakerId": 1000,
            "speakerName": "维纳亚克",
            "text": "真希望当年听我们答辩的导师都过来看看，治治他们陈腐守旧的眼界！",
            "nextDialogs": [
              "735160103"
            ]
          },
          "735160103": {
            "id": "735160103",
            "speakerId": 1001,
            "speakerName": "施芮娅",
            "text": "居然真的没出什么问题…我还以为八成会落到三号机的下场…",
            "nextDialogs": [
              "735160104"
            ]
          },
          "735160104": {
            "id": "735160104",
            "speakerId": 1000,
            "speakerName": "维纳亚克",
            "text": "咳…吃一堑长一智嘛，我也不是当初那个我了。",
            "nextDialogs": [
              "735160105"
            ]
          },
          "735160105": {
            "id": "735160105",
            "speakerId": 1002,
            "speakerName": "派蒙",
            "text": "当年究竟出了多少事故啊…无、无论如何，实验成功了就好！",
            "nextDialogs": [
              "735160106"
            ]
          },
          "735160106": {
            "id": "735160106",
            "speakerId": 1000,
            "speakerName": "维纳亚克",
            "text": "嗯，趁着现在势头不错，我们换个地方再来一次吧！",
            "nextDialogs": [
              "735160107"
            ]
          },
          "735160107": {
            "id": "735160107",
            "speakerId": 1000,
            "speakerName": "维纳亚克",
            "text": "——目击情报说，这附近至少还有两位数的沙虫呢！",
            "nextDialogs": [
              "735160108"
            ]
          },
          "735160108": {
            "id": "735160108",
            "speakerId": 1002,
            "speakerName": "派蒙",
            "text": "等等——两位数？！你不会打算就这么一只一只干掉吧？这得干到什么时候啊！",
            "nextDialogs": [
              "735160109"
            ]
          },
          "735160109": {
            "id": "735160109",
            "speakerId": 1000,
            "speakerName": "维纳亚克",
            "text": "嗯？有什么问题吗？如果是「对沙虫用杀虫炮」的保养情况，应该不用担心…",
            "nextDialogs": [
              "735160110"
            ]
          },
          "735160110": {
            "id": "735160110",
            "speakerId": 1002,
            "speakerName": "派蒙",
            "text": "慢着慢着！要重复那么久望不到头的工作，机械没垮我们也要累垮了…",
            "nextDialogs": [
              "735160111"
            ]
          },
          "735160111": {
            "id": "735160111",
            "speakerId": 1001,
            "speakerName": "施芮娅",
            "text": "维纳亚克，可不是每个人都像你一样，只要闻着机油味就能恢复精神。",
            "nextDialogs": [
              "735160112"
            ]
          },
          "735160112": {
            "id": "735160112",
            "speakerId": 1000,
            "speakerName": "维纳亚克",
            "text": "是吗？看来下次得把湿件性能也纳入考量了…",
            "nextDialogs": [
              "735160113"
            ]
          },
          "735160113": {
            "id": "735160113",
            "speakerId": 1001,
            "speakerName": "施芮娅",
            "text": "总之，今天就先到这里吧。有了这次完整运行的数据和战斗后采集到的样本，我离解开谜题也更近了一步。",
            "nextDialogs": [
              "735160114"
            ]
          },
          "735160114": {
            "id": "735160114",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "什么谜题？",
            "nextDialogs": [
              "735160115"
            ]
          },
          "735160115": {
            "id": "735160115",
            "speakerId": 1001,
            "speakerName": "施芮娅",
            "text": "沙虫作乱的原因、环境参数的异常…只要能搞清楚这些，说不定就能从根本上解决这次动乱了。",
            "nextDialogs": [
              "735160116"
            ]
          },
          "735160116": {
            "id": "735160116",
            "speakerId": 1001,
            "speakerName": "施芮娅",
            "text": "请再给我一天时间做点调查吧，等到明天这个时候，应该就会有结果了。"
          }
        }
      }
    },

  },
  "subQuests": [
    {
      "subId": "2004301",
      "subQuestName": "与米歇尔小姐对话",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "200430101"
        ],
        "dialogs": {
          "200430101": {
            "id": "200430101",
            "speakerId": 1421,
            "speakerName": "米歇尔",
            "text": "腰怎么这么痛…",
            "nextDialogs": [
              "200430102"
            ]
          },
          "200430102": {
            "id": "200430102",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "你怎么了？",
            "nextDialogs": [
              "200430103"
            ]
          },
          "200430103": {
            "id": "200430103",
            "speakerId": 1421,
            "speakerName": "米歇尔",
            "text": "我正准备去工作，但是突然腰很痛。",
            "nextDialogs": [
              "200430104"
            ]
          },
          "200430104": {
            "id": "200430104",
            "speakerId": 1421,
            "speakerName": "米歇尔",
            "text": "我已经和昆恩约好去他的水果摊帮忙，现在只能休息一下再去了…",
            "nextDialogs": [
              "200430105"
            ]
          },
          "200430105": {
            "id": "200430105",
            "speakerId": 1421,
            "speakerName": "米歇尔",
            "text": "唉，但是光待在这里也只是耽误事。",
            "nextDialogs": [
              "200430106"
            ]
          },
          "200430106": {
            "id": "200430106",
            "speakerId": 1421,
            "speakerName": "米歇尔",
            "text": "你能帮我去问问昆恩，他需要我做什么工作吗？我也好做些准备。",
            "nextDialogs": [
              "200430108",
              "200430110"
            ]
          },
          "200430108": {
            "id": "200430108",
            "speakerId": 1421,
            "speakerName": "米歇尔",
            "text": "那就拜托你了，我只要休息一会就好。"
          },
          "200430110": {
            "id": "200430110",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "喂，这么点小事，帮个忙也没关系吧！"
          }
        }
      }
    },
    {
      "subId": "2004306",
      "subQuestName": "(test)触发和派蒙的对话$HIDDEN",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "200430601"
        ],
        "dialogs": {
          "200430601": {
            "id": "200430601",
            "speakerId": 1421,
            "speakerName": "米歇尔",
            "text": "你们问昆恩先生了吗？",
            "nextDialogs": [
              "200430602"
            ]
          },
          "200430602": {
            "id": "200430602",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "昆恩先生请你回去休息。",
            "nextDialogs": [
              "200430603"
            ]
          },
          "200430603": {
            "id": "200430603",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "昆恩先生的店里今天没有什么工作喔，请回去好好休息吧！",
            "nextDialogs": [
              "200430604"
            ]
          },
          "200430604": {
            "id": "200430604",
            "speakerId": 1421,
            "speakerName": "米歇尔",
            "text": "是吗，呼…看来要去找别的事做了呢。",
            "nextDialogs": [
              "200430605"
            ]
          },
          "200430605": {
            "id": "200430605",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "咦，咦？！你不去休息吗？好不容易不用工作了…",
            "nextDialogs": [
              "200430606"
            ]
          },
          "200430606": {
            "id": "200430606",
            "speakerId": 1421,
            "speakerName": "米歇尔",
            "text": "你们感受一下四周，巴巴托斯大人的风还在勤劳地工作着。",
            "nextDialogs": [
              "200430607"
            ]
          },
          "200430607": {
            "id": "200430607",
            "speakerId": 1421,
            "speakerName": "米歇尔",
            "text": "我们这些被他庇佑着的人，也没有偷懒的道理。",
            "nextDialogs": [
              "200430608"
            ]
          },
          "200430608": {
            "id": "200430608",
            "speakerId": 1421,
            "speakerName": "米歇尔",
            "text": "不过，你是去做什么事了，怎么出了这么多汗？",
            "nextDialogs": [
              "200430609"
            ]
          },
          "200430609": {
            "id": "200430609",
            "speakerId": 1421,
            "speakerName": "米歇尔",
            "text": "看来你也是个忙碌的人呢。不过这样也好，借助着辛勤的汗水，才能更清晰地感受到巴巴托斯大人的风。",
            "nextDialogs": [
              "200430610"
            ]
          },
          "200430610": {
            "id": "200430610",
            "speakerId": 1421,
            "speakerName": "米歇尔",
            "text": "来，这瓶牛奶给你，快点喝掉，然后继续加油吧，工作可是永无止境的。"
          }
        }
      }
    },
    {
      "subId": "2004307",
      "subQuestName": "(test)和派蒙对话$HIDDEN",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "200430801"
        ],
        "dialogs": {
          "200430801": {
            "id": "200430801",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "呜哇，这么忙，看起来工作就很辛苦。",
            "nextDialogs": [
              "200430802"
            ]
          },
          "200430802": {
            "id": "200430802",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "米歇尔小姐已经很累了，我们先帮昆恩先生把工作做完吧。",
            "nextDialogs": [
              "200430803"
            ]
          },
          "200430803": {
            "id": "200430803",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "然后再拜托他，给米歇尔小姐一个轻松的工作…",
            "nextDialogs": [
              "200430804"
            ]
          },
          "200430804": {
            "id": "200430804",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "希望我们这样自作主张，不会让米歇尔小姐不高兴。"
          }
        }
      }
    },
    {
      "subId": "2004302",
      "subQuestName": "与昆恩对话",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "200430301"
        ],
        "dialogs": {
          "200430301": {
            "id": "200430301",
            "speakerId": 1403,
            "speakerName": "昆恩",
            "text": "怎么还没送来，糟糕了…",
            "nextDialogs": [
              "200430302"
            ]
          },
          "200430302": {
            "id": "200430302",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "发生什么了？",
            "nextDialogs": [
              "200430303"
            ]
          },
          "200430303": {
            "id": "200430303",
            "speakerId": 1403,
            "speakerName": "昆恩",
            "text": "啊…摊子里的日落果卖光了，我刚去订了几批日落果。",
            "nextDialogs": [
              "200430304"
            ]
          },
          "200430304": {
            "id": "200430304",
            "speakerId": 1403,
            "speakerName": "昆恩",
            "text": "但是到现在也没送来…好多客人都在等着买呢。",
            "nextDialogs": [
              "200430305"
            ]
          },
          "200430305": {
            "id": "200430305",
            "speakerId": 1403,
            "speakerName": "昆恩",
            "text": "光是优律小姐就来了三趟了，她就只要<color=#00E1FFFF>三颗日落果</color>，我可不想失去这个老顾客啊！",
            "nextDialogs": [
              "200430306"
            ]
          },
          "200430306": {
            "id": "200430306",
            "speakerId": 1403,
            "speakerName": "昆恩",
            "text": "我还要看摊子…要是谁能帮我去城外找点日落果回来就好了。",
            "nextDialogs": [
              "200430308",
              "200430310"
            ]
          },
          "200430308": {
            "id": "200430308",
            "speakerId": 1403,
            "speakerName": "昆恩",
            "text": "你愿意帮忙吗？那太好了，就拜托你了！"
          },
          "200430310": {
            "id": "200430310",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "等一下！米歇尔小姐那个样子，怎么出去摘果子啊！",
            "nextDialogs": [
              "200430311"
            ]
          },
          "200430311": {
            "id": "200430311",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "我们来帮忙吧！"
          }
        }
      }
    },
    {
      "subId": "2004303",

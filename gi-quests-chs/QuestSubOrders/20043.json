    {
      "subId": "2004304",
      "subQuestName": "将日落果交给昆恩",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "200430501"
        ],
        "dialogs": {
          "200430501": {
            "id": "200430501",
            "speakerId": 1403,
            "speakerName": "昆恩",
            "text": "你找到日落果了吗？",
            "nextDialogs": [
              "200430502"
            ]
          },
          "200430502": {
            "id": "200430502",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "已经找好了。",
            "nextDialogs": [
              "200430503"
            ]
          },
          "200430503": {
            "id": "200430503",
            "speakerId": 1403,
            "speakerName": "昆恩",
            "text": "谢谢，这些应该就够优律小姐买了。",
            "nextDialogs": [
              "200430504"
            ]
          },
          "200430504": {
            "id": "200430504",
            "speakerId": 1403,
            "speakerName": "昆恩",
            "text": "唉，但是很多客人们还是走掉了，一个人果然还是忙不过来啊。",
            "nextDialogs": [
              "200430505"
            ]
          },
          "200430505": {
            "id": "200430505",
            "speakerId": 1403,
            "speakerName": "昆恩",
            "text": "哦对了，谢谢你们帮忙，要给你们谢礼才行，稍等一下…",
            "nextDialogs": [
              "200430506"
            ]
          },
          "200430506": {
            "id": "200430506",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "谢礼就不用了，我们有事情拜托你…",
            "nextDialogs": [
              "200430507"
            ]
          },
          "200430507": {
            "id": "200430507",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "关于米歇尔小姐…",
            "nextDialogs": [
              "200430508"
            ]
          },
          "200430508": {
            "id": "200430508",
            "speakerId": 1403,
            "speakerName": "昆恩",
            "text": "米歇尔小姐…你们遇见她了吗？",
            "nextDialogs": [
              "200430509"
            ]
          },
          "200430509": {
            "id": "200430509",
            "speakerId": 1403,
            "speakerName": "昆恩",
            "text": "希望我交给她一点轻松的工作？",
            "nextDialogs": [
              "200430510"
            ]
          },
          "200430510": {
            "id": "200430510",
            "speakerId": 1403,
            "speakerName": "昆恩",
            "text": "可我一开始就只准备让她帮忙看店啊。",
            "nextDialogs": [
              "200430511"
            ]
          },
          "200430511": {
            "id": "200430511",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "是，是这样吗？",
            "nextDialogs": [
              "200430512"
            ]
          },
          "200430512": {
            "id": "200430512",
            "speakerId": 1403,
            "speakerName": "昆恩",
            "text": "不过现在客人们都走了，看来是不用人看店了…",
            "nextDialogs": [
              "200430513"
            ]
          },
          "200430513": {
            "id": "200430513",
            "speakerId": 1403,
            "speakerName": "昆恩",
            "text": "麻烦你们告诉米歇尔小姐，让她回去休息吧。",
            "nextDialogs": [
              "200430514"
            ]
          },
          "200430514": {
            "id": "200430514",
            "speakerId": 1403,
            "speakerName": "昆恩",
            "text": "我等会准备去看看那批货到底怎么回事…"
          }
        }
      }
    },

  "subQuests": [
    {
      "subId": "1102101",
      "subQuestName": "一同前往孤云阁",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [],
        "dialogs": {}
      }
    },
    {
      "subId": "1102102",
      "subQuestName": "与众人交谈",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "110210201"
        ],
        "dialogs": {
          "110210201": {
            "id": "110210201",
            "speakerId": 10302,
            "speakerName": "克列门特",
            "text": "唔，这地方，怎么看起来这么普通…真的能找到有价值的东西吗？",
            "nextDialogs": [
              "110210202"
            ]
          },
          "110210202": {
            "id": "110210202",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "嗯？我觉得挺壮观的呀。",
            "nextDialogs": [
              "110210203"
            ]
          },
          "110210203": {
            "id": "110210203",
            "speakerId": 10302,
            "speakerName": "克列门特",
            "text": "我不是说风景，而是…既然发生了一场大战，总该有些不同寻常的地方吧，但现在，唉，甚至不知道该从哪儿找起。",
            "nextDialogs": [
              "110210204"
            ]
          },
          "110210204": {
            "id": "110210204",
            "speakerId": 10232,
            "speakerName": "钟离",
            "text": "此处名为孤云阁，如果想要研究魔神，或是魔神战争时期的历史，这里都是绝佳的场所。",
            "nextDialogs": [
              "110210205"
            ]
          },
          "110210205": {
            "id": "110210205",
            "speakerId": 10232,
            "speakerName": "钟离",
            "text": "相传，岩王帝君以岩为枪，投入此片海域，将魔神刺穿并镇压。",
            "nextDialogs": [
              "110210206"
            ]
          },
          "110210206": {
            "id": "110210206",
            "speakerId": 10232,
            "speakerName": "钟离",
            "text": "那些岩枪经历了长年的风化，最终形成了此番别致的景象。",
            "nextDialogs": [
              "110210207"
            ]
          },
          "110210207": {
            "id": "110210207",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "这、这么大的山，居然是岩王爷的武器？",
            "nextDialogs": [
              "110210208"
            ]
          },
          "110210208": {
            "id": "110210208",
            "speakerId": 10232,
            "speakerName": "钟离",
            "text": "如今残存于我们眼前的，不过冰山一角。当年帝君投下的岩枪，无论数量还是体积，都远超于此。",
            "nextDialogs": [
              "110210209"
            ]
          },
          "110210209": {
            "id": "110210209",
            "speakerId": 10232,
            "speakerName": "钟离",
            "text": "只不过因为角度各异，柱体又过于巨大，受到海水侵蚀，或是重力影响，很多都整体沉入了海底。",
            "nextDialogs": [
              "110210210"
            ]
          },
          "110210210": {
            "id": "110210210",
            "speakerId": 10232,
            "speakerName": "钟离",
            "text": "所以，除了后来的风化，起初的崩落也是孤云阁的重要成因之一。",
            "nextDialogs": [
              "110210211"
            ]
          },
          "110210211": {
            "id": "110210211",
            "speakerId": 10302,
            "speakerName": "克列门特",
            "text": "那…能和这么夸张的力量对抗的魔神，应该也很强吧。",
            "nextDialogs": [
              "110210212"
            ]
          },
          "110210212": {
            "id": "110210212",
            "speakerId": 10232,
            "speakerName": "钟离",
            "text": "是的，这就是孤云阁的研究价值所在。",
            "nextDialogs": [
              "110210213"
            ]
          },
          "110210213": {
            "id": "110210213",
            "speakerId": 10232,
            "speakerName": "钟离",
            "text": "与那段历史有关的物件大多沉于深海，但「漩涡之魔神」掀起了滔天巨浪，也给了这些东西重见天日的机会。",
            "nextDialogs": [
              "110210214"
            ]
          },
          "110210214": {
            "id": "110210214",
            "speakerId": 10302,
            "speakerName": "克列门特",
            "text": "也就是说，只要仔细找找，肯定就能赚得盆满钵满…",
            "nextDialogs": [
              "110210215"
            ]
          },
          "110210215": {
            "id": "110210215",
            "speakerId": 10302,
            "speakerName": "克列门特",
            "text": "啊，我是说，肯定会收获颇丰，是吧？这我就安心了。",
            "nextDialogs": [
              "110210216"
            ]
          },
          "110210216": {
            "id": "110210216",
            "speakerId": 10302,
            "speakerName": "克列门特",
            "text": "反正带了这么多人，我觉得分头寻找效率会更高。",
            "nextDialogs": [
              "110210217"
            ]
          },
          "110210217": {
            "id": "110210217",
            "speakerId": 10232,
            "speakerName": "钟离",
            "text": "嗯，那么，我和我的这位朋友同行吧，虽然我略懂一些杂学，但在专业的考古学家面前，还是不班门弄斧了。",
            "nextDialogs": [
              "110210218"
            ]
          },
          "110210218": {
            "id": "110210218",
            "speakerId": 10303,
            "speakerName": "宛烟",
            "text": "欸？我、我吗？",
            "nextDialogs": [
              "110210219"
            ]
          },
          "110210219": {
            "id": "110210219",
            "speakerId": 10302,
            "speakerName": "克列门特",
            "text": "怎么啦？这不是你的本职工作，有必要这么惊讶吗？",
            "nextDialogs": [
              "110210220"
            ]
          },
          "110210220": {
            "id": "110210220",
            "speakerId": 10303,
            "speakerName": "宛烟",
            "text": "我知道了…那、那我就为他带路了。",
            "nextDialogs": [
              "110210221"
            ]
          },
          "110210221": {
            "id": "110210221",
            "speakerId": 10232,
            "speakerName": "钟离",
            "text": "嗯，如果收集到了什么珍贵或者稀奇的东西，我想想…就到对岸汇合吧。"
          }
        }
      }
    },
    {
      "subId": "1102107",
      "subQuestName": "使用「元素视野」寻找古物",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "110210701"
        ],
        "dialogs": {
          "110210701": {
            "id": "110210701",
            "speakerId": 10232,
            "speakerName": "钟离",
            "text": "那古老的魔神，应该留下了不少元素痕迹，追踪痕迹应该会事半功倍。"
          }
        }
      }
    },

      }
    },
    {
      "subId": "1102106",
      "subQuestName": "与另一队汇合",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "110210601"
        ],
        "dialogs": {
          "110210601": {
            "id": "110210601",
            "speakerId": 10302,
            "speakerName": "克列门特",
            "text": "…你这也叫考古学家？！这也看不出来，那也不认识，你到底行不行啊！",
            "nextDialogs": [
              "110210602"
            ]
          },
          "110210602": {
            "id": "110210602",
            "speakerId": 10303,
            "speakerName": "宛烟",
            "text": "术、术业有专攻不是很正常的事吗！我已经很努力地讲解了！",
            "nextDialogs": [
              "110210603"
            ]
          },
          "110210603": {
            "id": "110210603",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "别吵架别吵架，到底发生什么了啊？",
            "nextDialogs": [
              "110210604"
            ]
          },
          "110210604": {
            "id": "110210604",
            "speakerId": 10302,
            "speakerName": "克列门特",
            "text": "这家伙，口口声声说自己是考古学家，却对这周围的遗迹一窍不通！还没有我懂得多！",
            "nextDialogs": [
              "110210605"
            ]
          },
          "110210605": {
            "id": "110210605",
            "speakerId": 10302,
            "speakerName": "克列门特",
            "text": "我只能靠直觉…我是说，经验，带了点好像有价值的东西回来。唉，真是耽误时间！",
            "nextDialogs": [
              "110210606"
            ]
          },
          "110210606": {
            "id": "110210606",
            "speakerId": 10303,
            "speakerName": "宛烟",
            "text": "我…我一直都在研究「盐之魔神」，对海里的东西不懂，也很正常吧！",
            "nextDialogs": [
              "110210609"
            ]
          },
          "110210609": {
            "id": "110210609",
            "speakerId": 10303,
            "speakerName": "宛烟",
            "text": "倒是你，一直在问我这个值多少摩拉、那个值多少摩拉！文物的价值难道就是摩拉吗！",
            "nextDialogs": [
              "110210610"
            ]
          },
          "110210610": {
            "id": "110210610",
            "speakerId": 10302,
            "speakerName": "克列门特",
            "text": "这、这…文物的价值，用摩拉来衡量，不是最直白吗！也很符合璃月的传统吧！",
            "nextDialogs": [
              "110210611"
            ]
          },
          "110210611": {
            "id": "110210611",
            "speakerId": 10232,
            "speakerName": "钟离",
            "text": "没关系，两位稍安勿躁，我们倒是带回来了一些不错的东西，可以一起看看。",
            "nextDialogs": [
              "110210612"
            ]
          },
          "110210612": {
            "id": "110210612",
            "speakerId": 10232,
            "speakerName": "钟离",
            "text": "唔…",
            "nextDialogs": [
              "110210613"
            ]
          },
          "110210613": {
            "id": "110210613",
            "speakerId": 10232,
            "speakerName": "钟离",
            "text": "很遗憾，你们带回来的这些东西，虽然确实是被「漩涡之魔神」带上岸的，可惜都与魔神无关，只是出自附近海域而已。",
            "nextDialogs": [
              "110210614"
            ]
          },
          "110210614": {
            "id": "110210614",
            "speakerId": 10232,
            "speakerName": "钟离",
            "text": "相比之下，还是我们找到的这块石板，表面有神秘的纹饰，且微存魔神之力，或许会对研究有所帮助。",
            "nextDialogs": [
              "110210615"
            ]
          },
          "110210615": {
            "id": "110210615",
            "speakerId": 10302,
            "speakerName": "克列门特",
            "text": "快、快把它给我！",
            "nextDialogs": [
              "110210616"
            ]
          },
          "110210616": {
            "id": "110210616",
            "speakerId": 10302,
            "speakerName": "克列门特",
            "text": "嘿嘿，有了这个，就不算毫无收获了。魔神的力量，哼哼，这个才是好东西啊…",
            "nextDialogs": [
              "110210617"
            ]
          },
          "110210617": {
            "id": "110210617",
            "speakerId": 10302,
            "speakerName": "克列门特",
            "text": "咳咳，但是，这其他的东西应该也还值几个钱，能收回雇佣顾问的成本——都归我了！",
            "nextDialogs": [
              "110210618"
            ]
          },
          "110210618": {
            "id": "110210618",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "一定要有魔神的力量残留在上面，才有研究的价值吗？",
            "nextDialogs": [
              "110210619"
            ]
          },
          "110210619": {
            "id": "110210619",
            "speakerId": 10303,
            "speakerName": "宛烟",
            "text": "不是的，我追寻「盐之魔神」的历史，是因为历史能讲述文化，还有信仰…",
            "nextDialogs": [
              "110210620"
            ]
          },
          "110210620": {
            "id": "110210620",
            "speakerId": 10303,
            "speakerName": "宛烟",
            "text": "至于你，就只是想借考古的名义发财吧！",
            "nextDialogs": [
              "110210621"
            ]
          },
          "110210621": {
            "id": "110210621",
            "speakerId": 10302,
            "speakerName": "克列门特",
            "text": "胡说！我是至冬国的专业考古研究员，如假包换！"
          }
        }
      }
    },
    {

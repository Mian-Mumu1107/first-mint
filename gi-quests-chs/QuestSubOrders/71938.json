        "dialogs": {
          "719380101": {
            "id": "719380101",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "关于古华派…",
            "nextDialogs": [
              "719380102"
            ]
          },
          "719380102": {
            "id": "719380102",
            "speakerId": 1000,
            "speakerName": "盖曼",
            "text": "嗯，这是个曾经在璃月盛极一时的组织，那时候他们还叫「古华团」…",
            "nextDialogs": [
              "719380103"
            ]
          },
          "719380103": {
            "id": "719380103",
            "speakerId": 1000,
            "speakerName": "盖曼",
            "text": "事到如今，这古华派的弟子也是寥寥无几。",
            "nextDialogs": [
              "719380104"
            ]
          },
          "719380104": {
            "id": "719380104",
            "speakerId": 1000,
            "speakerName": "盖曼",
            "text": "我前段时间刚从一个自称古华派关门弟子的人手中买了一批剑，他说是这古华派珍藏的宝剑…",
            "nextDialogs": [
              "719380105"
            ]
          },
          "719380105": {
            "id": "719380105",
            "speakerId": 1000,
            "speakerName": "盖曼",
            "text": "结果前两天铁匠铺老板告诉我，这就是一批很普通的武器…",
            "nextDialogs": [
              "719380106"
            ]
          },
          "719380106": {
            "id": "719380106",
            "speakerId": 1000,
            "speakerName": "盖曼",
            "text": "…唉，真没想到璃月的骗子如此狡诈…这些剑我带着也是累赘，不如送给你了，眼不见心不烦！"
          }
        }
      }
    }
  ]

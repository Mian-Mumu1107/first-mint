      }
    },
    {
      "subId": "7665208",
      "subQuestName": "把「阿莎莎」藏起来",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "766520801"
        ],
        "dialogs": {
          "766520801": {
            "id": "766520801",
            "speakerId": 1313,
            "speakerName": "爱诺",
            "text": "#做得很漂亮嘛！{NICKNAME}也很有当机械师的天赋。",
            "nextDialogs": [
              "766520802"
            ]
          },
          "766520802": {
            "id": "766520802",
            "speakerId": 1313,
            "speakerName": "爱诺",
            "text": "谢谢你们，这下我有了一个更厉害的「淘金小弟」。",
            "nextDialogs": [
              "766520803"
            ]
          },
          "766520803": {
            "id": "766520803",
            "speakerId": 1313,
            "speakerName": "爱诺",
            "text": "阿莎莎，你以后要认真干活噢，我会给你发工资的。",
            "nextDialogs": [
              "766520804"
            ]
          },
          "766520804": {
            "id": "766520804",
            "speakerId": 16118,
            "speakerName": "阿莎莎·郎勃罗",
            "text": "谁稀罕啦！",
            "nextDialogs": [
              "766520805"
            ]
          },
          "766520805": {
            "id": "766520805",
            "speakerId": 1313,
            "speakerName": "爱诺",
            "text": "你的脾气真是不太好，给你戴一朵花花。希望你能温柔一点，呐~",
            "nextDialogs": [
              "766520807"
            ]
          },
          "766520807": {
            "id": "766520807",
            "speakerId": 1313,
            "speakerName": "爱诺",
            "text": "嗯，这下子看起来可爱多了。",
            "nextDialogs": [
              "766520808"
            ]
          },
          "766520808": {
            "id": "766520808",
            "speakerId": 1313,
            "speakerName": "爱诺",
            "text": "#对了，{NICKNAME}，派蒙，要是以后你们也捡到了没用的材料，比如螺丝螺母什么的，可以送来我这里。",
            "nextDialogs": [
              "766520809"
            ]
          },
          "766520809": {
            "id": "766520809",
            "speakerId": 1313,
            "speakerName": "爱诺",
            "text": "我能把它们都变成花花，或者用来升级我的操作台，嘿嘿。当然不会让你们白干活，报酬一定会让你们愿意天天来的。",
            "nextDialogs": [
              "766520810"
            ]
          },
          "766520810": {
            "id": "766520810",
            "speakerId": 1313,
            "speakerName": "爱诺",
            "text": "成交吗？",
            "nextDialogs": [
              "766520811"
            ]
          },
          "766520811": {
            "id": "766520811",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "当然。",
            "nextDialogs": [
              "766520812"
            ]
          },
          "766520812": {
            "id": "766520812",
            "speakerId": 1313,
            "speakerName": "爱诺",
            "text": "太好咯！果然还是伊涅芙说的对呀。「不顺利」中也藏着「顺利」。等你度过了「不」，之后就是「顺利」。",
            "nextDialogs": [
              "766520813"
            ]
          },
          "766520813": {
            "id": "766520813",
            "speakerId": 1313,
            "speakerName": "爱诺",
            "text": "你们的旅途一定也会是这样。"
          }
        }
      }
    },

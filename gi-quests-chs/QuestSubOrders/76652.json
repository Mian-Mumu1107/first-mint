      }
    },
    {
      "subId": "7665201",
      "subQuestName": "回蛋卷工坊看看",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "766520101"
        ],
        "dialogs": {
          "766520101": {
            "id": "766520101",
            "speakerId": 1313,
            "speakerName": "爱诺",
            "text": "最近怎么这么不顺利，能不能让我睡个好觉！",
            "nextDialogs": [
              "766520102"
            ]
          },
          "766520102": {
            "id": "766520102",
            "speakerId": 1312,
            "speakerName": "伊涅芙",
            "text": "稍安勿躁，爱诺，「不顺利」中也藏着「顺利」。等你度过了「不」，之后就是「顺利」。",
            "nextDialogs": [
              "766520103"
            ]
          },
          "766520103": {
            "id": "766520103",
            "speakerId": 1313,
            "speakerName": "爱诺",
            "text": "#是吗？伊涅芙，你回来之后好像变得更会安慰人了，是{NICKNAME}教你的吗？",
            "nextDialogs": [
              "766520104"
            ]
          },
          "766520104": {
            "id": "766520104",
            "speakerId": 1312,
            "speakerName": "伊涅芙",
            "text": "谢谢，我也不知道。",
            "nextDialogs": [
              "766520105"
            ]
          },
          "766520105": {
            "id": "766520105",
            "speakerId": 1312,
            "speakerName": "伊涅芙",
            "text": "请去休息吧，我会替你检查这些分拣机器人。",
            "nextDialogs": [
              "766520106"
            ]
          },
          "766520106": {
            "id": "766520106",
            "speakerId": 1313,
            "speakerName": "爱诺",
            "text": "不行！我要用扳手挨个敲一遍它们的脑袋，看看到底是哪个坏东西在造反。",
            "nextDialogs": [
              "766520107"
            ]
          },
          "766520107": {
            "id": "766520107",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "你们好。",
            "nextDialogs": [
              "766520108"
            ]
          },
          "766520108": {
            "id": "766520108",
            "speakerId": 1313,
            "speakerName": "爱诺",
            "text": "#欸？{NICKNAME}，和派蒙？是你们哦。",
            "nextDialogs": [
              "766520109"
            ]
          },
          "766520109": {
            "id": "766520109",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "你们好呀，爱诺，伊涅芙！",
            "nextDialogs": [
              "766520110"
            ]
          },
          "766520110": {
            "id": "766520110",
            "speakerId": 1313,
            "speakerName": "爱诺",
            "text": "距离我们上次见面过去多久了啦？唔…好像不太久，但是记不清了。昨天晚上没睡好，今天脑袋不灵光。",
            "nextDialogs": [
              "766520111"
            ]
          },
          "766520111": {
            "id": "766520111",
            "speakerId": 1313,
            "speakerName": "爱诺",
            "text": "不管怎么说，见到你们，我的心情变好了一点。",
            "nextDialogs": [
              "766520112"
            ]
          },
          "766520112": {
            "id": "766520112",
            "speakerId": 1312,
            "speakerName": "伊涅芙",
            "text": "爱诺，你看，「顺利」就藏在「不顺利」中。",
            "nextDialogs": [
              "766520113"
            ]
          },
          "766520113": {
            "id": "766520113",
            "speakerId": 1313,
            "speakerName": "爱诺",
            "text": "嗯？",
            "nextDialogs": [
              "766520114"
            ]
          },
          "766520114": {
            "id": "766520114",
            "speakerId": 1312,
            "speakerName": "伊涅芙",
            "text": "#你遇到了烦恼，心情很差，但你努力地面对它，很快，{NICKNAME}和派蒙出现了，{M#他们}{F#她们}让你心情变好。",
            "nextDialogs": [
              "766520115"
            ]
          },
          "766520115": {
            "id": "766520115",
            "speakerId": 1312,
            "speakerName": "伊涅芙",
            "text": "这就是说明：「不」已经过去，「顺利」已经到来。",
            "nextDialogs": [
              "766520116"
            ]
          },
          "766520116": {
            "id": "766520116",
            "speakerId": 1313,
            "speakerName": "爱诺",
            "text": "真的吗？你好像有点说服我了…",
            "nextDialogs": [
              "766520117"
            ]
          },
          "766520117": {
            "id": "766520117",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "哎呀，爱诺怎么心情不好呀？有什么烦恼和我们说说，我们一定帮帮忙！",
            "nextDialogs": [
              "766520118"
            ]
          },
          "766520118": {
            "id": "766520118",
            "speakerId": 1313,
            "speakerName": "爱诺",
            "text": "只是些小事啦，最近总有人半夜在工坊外面打架，叮铃哐啷吵得我睡不着。就在昨晚，甚至还打到工坊里来啦！",
            "nextDialogs": [
              "766520119"
            ]
          },
          "766520119": {
            "id": "766520119",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "这就是叮铃哐啷蛋卷工坊的含义吗？啊不对不对…那些是什么人？听起来很危险！",
            "nextDialogs": [
              "766520120"
            ]
          },
          "766520120": {
            "id": "766520120",
            "speakerId": 1312,
            "speakerName": "伊涅芙",
            "text": "请放心，是一伙盗宝团，他们偷了愚人众的东西，所以正在被追缉。",
            "nextDialogs": [
              "766520121"
            ]
          },
          "766520121": {
            "id": "766520121",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "欸？盗宝团？本地的帮派很有志气啊…居然敢把手伸到愚人众的兜兜里。",
            "nextDialogs": [
              "766520122"
            ]
          },
          "766520122": {
            "id": "766520122",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "啊，不对不对，不管怎么样…深夜扰民的帮派真是太可恶了！",
            "nextDialogs": [
              "766520123"
            ]
          },
          "766520123": {
            "id": "766520123",
            "speakerId": 1313,
            "speakerName": "爱诺",
            "text": "之前伊涅芙不在，我只能躲在工坊里偷偷诅咒他们，好在伊涅芙终于回来了，哼哼…！全部要他们好看！",
            "nextDialogs": [
              "766520124"
            ]
          },
          "766520124": {
            "id": "766520124",
            "speakerId": 1312,
            "speakerName": "伊涅芙",
            "text": "昨天晚上我已经把他们都清扫出去了。不会有人再来打扰你，爱诺。",
            "nextDialogs": [
              "766520125"
            ]
          },
          "766520125": {
            "id": "766520125",
            "speakerId": 1313,
            "speakerName": "爱诺",
            "text": "嘿嘿，伊涅芙最好了。",
            "nextDialogs": [
              "766520126"
            ]
          },
          "766520126": {
            "id": "766520126",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "伊涅芙好厉害！所以问题已经解决了呀？",
            "nextDialogs": [
              "766520127"
            ]
          },
          "766520127": {
            "id": "766520127",
            "speakerId": 1313,
            "speakerName": "爱诺",
            "text": "睡不好的问题是解决了，可今天早上我的「淘金小弟」又出故障了。就是这些家伙，它们本来会从垃圾堆里挑出有用的宝贝。",
            "nextDialogs": [
              "766520128"
            ]
          },
          "766520128": {
            "id": "766520128",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "哇，那你们也很厉害哦。",
            "nextDialogs": [
              "766520129"
            ]
          },
          "766520129": {
            "id": "766520129",
            "speakerId": 1313,
            "speakerName": "爱诺",
            "text": "夸奖的话先暂停啦，现在它们中有一个叛徒！",
            "nextDialogs": [
              "766520130"
            ]
          },
          "766520130": {
            "id": "766520130",
            "speakerId": 1312,
            "speakerName": "伊涅芙",
            "text": "嗯，今天早上这些分拣机器人捡回来了一些无用的东西，从占比估算，应该是某一个个体出现了功能故障。",
            "nextDialogs": [
              "766520131"
            ]
          },
          "766520131": {
            "id": "766520131",
            "speakerId": 1313,
            "speakerName": "爱诺",
            "text": "你们说，是不是昨晚那帮人把「小弟」打坏了，对吧？我的「小弟」怎么会随随便便自己坏掉！",
            "nextDialogs": [
              "766520132"
            ]
          },
          "766520132": {
            "id": "766520132",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "那得让他们赔钱！",
            "nextDialogs": [
              "766520133"
            ]
          },
          "766520133": {
            "id": "766520133",
            "speakerId": 1313,
            "speakerName": "爱诺",
            "text": "嗯嗯，我们现在就先把坏「小弟」找出来，再看看是哪里的问题。",
            "nextDialogs": [
              "766520134"
            ]
          },
          "766520134": {
            "id": "766520134",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "要怎么找呢？",
            "nextDialogs": [
              "766520135"
            ]
          },
          "766520135": {
            "id": "766520135",
            "speakerId": 1313,
            "speakerName": "爱诺",
            "text": "先用凶狠的眼神观察！让它们感到压力，心虚的家伙就会开始汗流浃背。",
            "nextDialogs": [
              "766520136"
            ]
          },
          "766520136": {
            "id": "766520136",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "原来是心理攻势…可它们真的会流汗吗？",
            "nextDialogs": [
              "766520137"
            ]
          },
          "766520137": {
            "id": "766520137",
            "speakerId": 1313,
            "speakerName": "爱诺",
            "text": "如果不行，那再一个一个拉去小房间审问。",
            "nextDialogs": [
              "766520138"
            ]
          },
          "766520138": {
            "id": "766520138",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "不可以直接拆掉检修吗？",
            "nextDialogs": [
              "766520139"
            ]
          },
          "766520139": {
            "id": "766520139",
            "speakerId": 1313,
            "speakerName": "爱诺",
            "text": "那样好像有点不公平。还有两个勤劳的好「小弟」呢，如果把它们当成坏「小弟」一样拆掉，难道不会让它们伤心吗？",
            "nextDialogs": [
              "766520140"
            ]
          },
          "766520140": {
            "id": "766520140",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "呃…那好吧…喂！你们三个听见了吗，谁犯了错，自己站出来，不要牵连其他人！我们会…会…",
            "nextDialogs": [
              "766520141"
            ]
          },
          "766520141": {
            "id": "766520141",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "我们会怎么样来着？",
            "nextDialogs": [
              "766520142"
            ]
          },
          "766520142": {
            "id": "766520142",
            "speakerId": 1313,
            "speakerName": "爱诺",
            "text": "我们会从轻发落！",
            "nextDialogs": [
              "766520143"
            ]
          },
          "766520143": {
            "id": "766520143",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "（用凶狠的眼神来回巡视「小弟」。）",
            "nextDialogs": [
              "766520144"
            ]
          },
          "766520144": {
            "id": "766520144",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "#{NICKNAME}，你还挺入戏的嘛！发现什么不对劲了吗？",
            "nextDialogs": [
              "766520146",
              "766520148"
            ]
          },
          "766520146": {
            "id": "766520146",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "明明是右边那个吧！",
            "nextDialogs": [
              "766520150"
            ]
          },
          "766520150": {
            "id": "766520150",
            "speakerId": 1313,
            "speakerName": "爱诺",
            "text": "哦！就是右边那个家伙！它在我们的心理攻势下露出马脚了！",
            "nextDialogs": [
              "766520151"
            ]
          },
          "766520151": {
            "id": "766520151",
            "speakerId": 1313,
            "speakerName": "爱诺",
            "text": "#{NICKNAME}，帮我抓住它！"
          },
          "766520148": {
            "id": "766520148",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "明明是右边那个吧！"
          }
        }
      }
    },
    {
      "subId": "7665202",
      "subQuestName": "抓住坏「小弟」",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "766520201"
        ],
        "dialogs": {
          "766520201": {
            "id": "766520201",
            "speakerId": 1313,
            "speakerName": "爱诺",
            "text": "#{NICKNAME}，帮我抓住它！"
          }
        }
      }
    },
    {
      "subId": "7665203",
      "subQuestName": "和爱诺交谈",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "766520301"
        ],
        "dialogs": {
          "766520301": {
            "id": "766520301",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "爱诺，伊涅芙，我们抓住它了！接下来是不是要检查一下？",
            "nextDialogs": [
              "766520302"
            ]
          },
          "766520302": {
            "id": "766520302",
            "speakerId": 1312,
            "speakerName": "伊涅芙",
            "text": "检测到外观一切正常，推测因受攻击而产生故障的可能性减小。",
            "nextDialogs": [
              "766520303"
            ]
          },
          "766520303": {
            "id": "766520303",
            "speakerId": 1313,
            "speakerName": "爱诺",
            "text": "难道真的是核心的问题？让我拆开来看看。",
            "nextDialogs": [
              "766520304"
            ]
          },
          "766520304": {
            "id": "766520304",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "不好！它要逃跑了！",
            "nextDialogs": [
              "766520305"
            ]
          },
          "766520305": {
            "id": "766520305",
            "speakerId": 1313,
            "speakerName": "爱诺",
            "text": "快追！",
            "nextDialogs": [
              "766520306"
            ]
          },
          "766520306": {
            "id": "766520306",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "欸…那个是不是它？怎么变得那么大了！",
            "nextDialogs": [
              "766520307"
            ]
          },
          "766520307": {
            "id": "766520307",
            "speakerId": 1312,
            "speakerName": "伊涅芙",
            "text": "不，那些是已经报废的分拣机器人。它竟然可以与它们相连接。",
            "nextDialogs": [
              "766520308"
            ]
          },
          "766520308": {
            "id": "766520308",
            "speakerId": 1313,
            "speakerName": "爱诺",
            "text": "老实说啊，我已经开始好奇了，这看起来不是简单的故障…",
            "nextDialogs": [
              "766520309"
            ]
          },
          "766520309": {
            "id": "766520309",
            "speakerId": 1313,
            "speakerName": "爱诺",
            "text": "我们先把它抓出来吧！"
          }
        }
      }
    },
    {
      "subId": "7665204",
      "subQuestName": "抓住坏「小弟」",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "766520401"
        ],
        "dialogs": {
          "766520401": {
            "id": "766520401",
            "speakerId": 1313,
            "speakerName": "爱诺",
            "text": "#{NICKNAME}，你来试试怎么样？很有意思的。"
          }
        }
      }
    },
    {
      "subId": "7665205",
      "subQuestName": "和爱诺交谈",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "766520501"
        ],
        "dialogs": {
          "766520501": {
            "id": "766520501",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "终于抓住他了，这下连我都开始好奇了，这个「小弟」到底是怎么回事？",
            "nextDialogs": [
              "766520502"
            ]
          },
          "766520502": {
            "id": "766520502",
            "speakerId": 15520,
            "speakerName": "奇怪的淘金小弟",
            "text": "哼，真没见识！",
            "nextDialogs": [
              "766520503"
            ]
          },
          "766520503": {
            "id": "766520503",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "欸？！你…你会说话？！爱诺，这应该吗？",
            "nextDialogs": [
              "766520504"
            ]
          },
          "766520504": {
            "id": "766520504",
            "speakerId": 1313,
            "speakerName": "爱诺",
            "text": "不可能…虽然我给「淘金小弟」添加了说话的功能，但也都是预设的语音…",
            "nextDialogs": [
              "766520505"
            ]
          },
          "766520505": {
            "id": "766520505",
            "speakerId": 1313,
            "speakerName": "爱诺",
            "text": "它们不可能像伊涅芙那样拥有自主意识，毕竟核心完全不是一个级别…",
            "nextDialogs": [
              "766520506"
            ]
          },
          "766520506": {
            "id": "766520506",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "可它好像可以交流的样子，难道是核心升级了？",
            "nextDialogs": [
              "766520507"
            ]
          },
          "766520507": {
            "id": "766520507",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "你叫什么名字？",
            "nextDialogs": [
              "766520508"
            ]
          },
          "766520508": {
            "id": "766520508",
            "speakerId": 15520,
            "speakerName": "奇怪的淘金小弟",
            "text": "怎样？跟你有什么关系啊？",
            "nextDialogs": [
              "766520509"
            ]
          },
          "766520509": {
            "id": "766520509",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "这家伙怎么这么嚣张！简直像是我们被它抓住了一样！",
            "nextDialogs": [
              "766520510"
            ]
          },
          "766520510": {
            "id": "766520510",
            "speakerId": 15520,
            "speakerName": "奇怪的淘金小弟",
            "text": "不然呢？你们再不离开，我就把你们通通抓起来，送进梅洛彼得…！",
            "nextDialogs": [
              "766520511"
            ]
          },
          "766520511": {
            "id": "766520511",
            "speakerId": 1312,
            "speakerName": "伊涅芙",
            "text": "梅洛彼得？那是什么地方？",
            "nextDialogs": [
              "766520512"
            ]
          },
          "766520512": {
            "id": "766520512",
            "speakerId": 15520,
            "speakerName": "奇怪的淘金小弟",
            "text": "就是、就是…就是…咦？梅洛彼得什么来着…？",
            "nextDialogs": [
              "766520513"
            ]
          },
          "766520513": {
            "id": "766520513",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "梅洛彼得堡？",
            "nextDialogs": [
              "766520514"
            ]
          },
          "766520514": {
            "id": "766520514",
            "speakerId": 15520,
            "speakerName": "奇怪的淘金小弟",
            "text": "梅洛彼得堡…好像是这个名字…",
            "nextDialogs": [
              "766520515"
            ]
          },
          "766520515": {
            "id": "766520515",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "你是从枫丹来的吗？",
            "nextDialogs": [
              "766520516"
            ]
          },
          "766520516": {
            "id": "766520516",
            "speakerId": 15520,
            "speakerName": "奇怪的淘金小弟",
            "text": "干嘛？不要一上来就打听女孩子的私生活！",
            "nextDialogs": [
              "766520517"
            ]
          },
          "766520517": {
            "id": "766520517",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "喂！什么女孩子，你不是个垃圾分类机器人吗？",
            "nextDialogs": [
              "766520518"
            ]
          },
          "766520518": {
            "id": "766520518",
            "speakerId": 15520,
            "speakerName": "奇怪的淘金小弟",
            "text": "是女孩子！",
            "nextDialogs": [
              "766520519"
            ]
          },
          "766520519": {
            "id": "766520519",
            "speakerId": 1313,
            "speakerName": "爱诺",
            "text": "这太不对劲了，虽然不知道发生了什么…但它肯定不是原本的「淘金小弟」…",
            "nextDialogs": [
              "766520520"
            ]
          },
          "766520520": {
            "id": "766520520",
            "speakerId": 1313,
            "speakerName": "爱诺",
            "text": "决定了，就把你拆开来看看是怎么回事吧！",
            "nextDialogs": [
              "766520521"
            ]
          },
          "766520521": {
            "id": "766520521",
            "speakerId": 15520,
            "speakerName": "奇怪的淘金小弟",
            "text": "不要对我动手动脚啊！救命！",
            "nextDialogs": [
              "766520522"
            ]
          },
          "766520522": {
            "id": "766520522",
            "speakerId": 1313,
            "speakerName": "爱诺",
            "text": "我也是女孩子！",
            "nextDialogs": [
              "766520523"
            ]
          },
          "766520523": {
            "id": "766520523",
            "speakerId": 15520,
            "speakerName": "奇怪的淘金小弟",
            "text": "女孩子也不行！",
            "nextDialogs": [
              "766520524"
            ]
          },
          "766520524": {
            "id": "766520524",
            "speakerId": 1312,
            "speakerName": "伊涅芙",
            "text": "#{NICKNAME}，派蒙，抱歉，爱诺兴趣来了就会全神贯注。请给她一些时间吧，她会弄清楚发生了什么。",
            "nextDialogs": [
              "766520525"
            ]
          },
          "766520525": {
            "id": "766520525",
            "speakerId": 1312,
            "speakerName": "伊涅芙",
            "text": "如果你们也想知道，明天的这时候再来工坊看看吧。"
          }
        }
      }
    },
    {
      "subId": "7665206",
      "subQuestName": "等待到第二天（8：00-24：00）",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "766520601"
        ],
        "dialogs": {
          "766520601": {
            "id": "766520601",
            "speakerId": 1313,
            "speakerName": "爱诺",
            "text": "真奇怪，我用的明明是挪德卡莱普通机械的核心…",
            "nextDialogs": [
              "766520602"
            ]
          },
          "766520602": {
            "id": "766520602",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "爱诺，伊涅芙，我们来啦。",
            "nextDialogs": [
              "766520603"
            ]
          },
          "766520603": {
            "id": "766520603",
            "speakerId": 1312,
            "speakerName": "伊涅芙",
            "text": "你们好，欢迎。",
            "nextDialogs": [
              "766520604"
            ]
          },
          "766520604": {
            "id": "766520604",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "爱诺找到原因了吗？",
            "nextDialogs": [
              "766520605"
            ]
          },
          "766520605": {
            "id": "766520605",
            "speakerId": 1313,
            "speakerName": "爱诺",
            "text": "故障的原因倒是找到啦，可是问题反而变得更多了。",
            "nextDialogs": [
              "766520606"
            ]
          },
          "766520606": {
            "id": "766520606",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "为什么啊？",
            "nextDialogs": [
              "766520607"
            ]
          },
          "766520607": {
            "id": "766520607",
            "speakerId": 1312,
            "speakerName": "伊涅芙",
            "text": "故障机器人的核心不对，不是爱诺原本使用的核心，而是一颗来自枫丹发条机关的核心。",
            "nextDialogs": [
              "766520608"
            ]
          },
          "766520608": {
            "id": "766520608",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "核心变了？！那我们要把它找回来吗？！",
            "nextDialogs": [
              "766520609"
            ]
          },
          "766520609": {
            "id": "766520609",
            "speakerId": 1313,
            "speakerName": "爱诺",
            "text": "不用着急啦，原本的核心都是我从各种垃圾上拆下来的，很普通，就算丢一百个也没关系。",
            "nextDialogs": [
              "766520610"
            ]
          },
          "766520610": {
            "id": "766520610",
            "speakerId": 1313,
            "speakerName": "爱诺",
            "text": "问题是现在的这颗核心，它非常高级，有很多连我也不懂的功能模块…",
            "nextDialogs": [
              "766520611"
            ]
          },
          "766520611": {
            "id": "766520611",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "居然是这样？这就是它会说话的原因？和伊涅芙一样？",
            "nextDialogs": [
              "766520612"
            ]
          },
          "766520612": {
            "id": "766520612",
            "speakerId": 1313,
            "speakerName": "爱诺",
            "text": "不知道，不过我能看出来，这颗核心应该经历过一次严重的爆炸，大部分模块都已经损毁了，没有一个地方是我能修的…",
            "nextDialogs": [
              "766520613"
            ]
          },
          "766520613": {
            "id": "766520613",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "连爱诺都办不到吗…",
            "nextDialogs": [
              "766520614"
            ]
          },
          "766520614": {
            "id": "766520614",
            "speakerId": 1312,
            "speakerName": "伊涅芙",
            "text": "虽然这枚核心来自枫丹，但使用的是一种冷门的技术，除非有相关知识，否则没有人能快速取得突破。",
            "nextDialogs": [
              "766520615"
            ]
          },
          "766520615": {
            "id": "766520615",
            "speakerId": 1313,
            "speakerName": "爱诺",
            "text": "话是这么说，但我也不是毫无收获啦，嘿嘿，我还是在损毁的数据片段中挖出了一个有意义的符号，是一个字——「莎」。",
            "nextDialogs": [
              "766520616"
            ]
          },
          "766520616": {
            "id": "766520616",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "莎？这是它的名字吗？",
            "nextDialogs": [
              "766520617"
            ]
          },
          "766520617": {
            "id": "766520617",
            "speakerId": 1313,
            "speakerName": "爱诺",
            "text": "我猜不是，但一定有重要意义！因为这个字是在核心最底层发现的，那是被保护得最好的地方，所以才有机会遗留下来。",
            "nextDialogs": [
              "766520618"
            ]
          },
          "766520618": {
            "id": "766520618",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "被保护得最好的地方…？",
            "nextDialogs": [
              "766520619"
            ]
          },
          "766520619": {
            "id": "766520619",
            "speakerId": 1312,
            "speakerName": "伊涅芙",
            "text": "如果我的核心将要损坏，我会把有关爱诺的数据放在那种地方。",
            "nextDialogs": [
              "766520620"
            ]
          },
          "766520620": {
            "id": "766520620",
            "speakerId": 1313,
            "speakerName": "爱诺",
            "text": "呸呸！霉霉飞飞！伊涅芙，你的核心才不会坏呢，不要说不吉利的话！",
            "nextDialogs": [
              "766520621"
            ]
          },
          "766520621": {
            "id": "766520621",
            "speakerId": 1312,
            "speakerName": "伊涅芙",
            "text": "只是情景的模拟说明。",
            "nextDialogs": [
              "766520622"
            ]
          },
          "766520622": {
            "id": "766520622",
            "speakerId": 1313,
            "speakerName": "爱诺",
            "text": "不管，快跟我念，呸呸！霉霉飞飞！",
            "nextDialogs": [
              "766520623"
            ]
          },
          "766520623": {
            "id": "766520623",
            "speakerId": 1312,
            "speakerName": "伊涅芙",
            "text": "呸呸，霉霉飞飞，这样吗？",
            "nextDialogs": [
              "766520624"
            ]
          },
          "766520624": {
            "id": "766520624",
            "speakerId": 1313,
            "speakerName": "爱诺",
            "text": "这才对嘛。",
            "nextDialogs": [
              "766520625"
            ]
          },
          "766520625": {
            "id": "766520625",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "噫…",
            "nextDialogs": [
              "766520626"
            ]
          },
          "766520626": {
            "id": "766520626",
            "speakerId": 1313,
            "speakerName": "爱诺",
            "text": "话说回来，在这颗核心的底层，应该还存在些完好并有意义的数据，不然它应该说不了话才对。",
            "nextDialogs": [
              "766520627"
            ]
          },
          "766520627": {
            "id": "766520627",
            "speakerId": 1313,
            "speakerName": "爱诺",
            "text": "小数据~我要慢慢把你们挖出来~一个都别跑~",
            "nextDialogs": [
              "766520628"
            ]
          },
          "766520628": {
            "id": "766520628",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "好神秘的核心啊…可它都这么不简单了，怎么会跑到「淘金小弟」里来呢？",
            "nextDialogs": [
              "766520629"
            ]
          },
          "766520629": {
            "id": "766520629",
            "speakerId": 1313,
            "speakerName": "爱诺",
            "text": "恭喜派蒙！你找到了最大的问题！",
            "nextDialogs": [
              "766520630"
            ]
          },
          "766520630": {
            "id": "766520630",
            "speakerId": 1313,
            "speakerName": "爱诺",
            "text": "不知道是谁在什么时候，把一颗虽然损毁、但还是很有研究价值的核心和「淘金小弟」原本的捡破烂核心掉了包。",
            "nextDialogs": [
              "766520631"
            ]
          },
          "766520631": {
            "id": "766520631",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "会不会和愚人众或盗宝团有关系。",
            "nextDialogs": [
              "766520632"
            ]
          },
          "766520632": {
            "id": "766520632",
            "speakerId": 1313,
            "speakerName": "爱诺",
            "text": "#恭喜{NICKNAME}！你发现了最可能的答案！",
            "nextDialogs": [
              "766520633"
            ]
          },
          "766520633": {
            "id": "766520633",
            "speakerId": 1313,
            "speakerName": "爱诺",
            "text": "它故障的前一天发生了什么？一队愚人众追着一伙盗宝团打进了工坊。",
            "nextDialogs": [
              "766520634"
            ]
          },
          "766520634": {
            "id": "766520634",
            "speakerId": 1313,
            "speakerName": "爱诺",
            "text": "会不会这枚核心就是盗宝团从愚人众手里偷来的？情急之下又把它塞进了「淘金小弟」里，又把淘金小弟的核心让出去交差。",
            "nextDialogs": [
              "766520635"
            ]
          },
          "766520635": {
            "id": "766520635",
            "speakerId": 1313,
            "speakerName": "爱诺",
            "text": "是不是很合理？伊涅芙，我是不是很聪明？",
            "nextDialogs": [
              "766520636"
            ]
          },
          "766520636": {
            "id": "766520636",
            "speakerId": 1312,
            "speakerName": "伊涅芙",
            "text": "当然。虽然以上只是爱诺的推测。但我们从秘闻馆取得了一些相互印证的情报——",
            "nextDialogs": [
              "766520637"
            ]
          },
          "766520637": {
            "id": "766520637",
            "speakerId": 1312,
            "speakerName": "伊涅芙",
            "text": "一支隶属于「木偶」的部队前日返回至冬时货物失窃，失窃物品不详。盗窃者是一伙只有三人的盗宝团。",
            "nextDialogs": [
              "766520638"
            ]
          },
          "766520638": {
            "id": "766520638",
            "speakerId": 1312,
            "speakerName": "伊涅芙",
            "text": "首领为一名白发戴兜帽的女子，余下是一名粉色头发和一名蓝紫色头发的男子。",
            "nextDialogs": [
              "766520639"
            ]
          },
          "766520639": {
            "id": "766520639",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "哇哦，这就是那个有志气的本地帮派吧！",
            "nextDialogs": [
              "766520640"
            ]
          },
          "766520640": {
            "id": "766520640",
            "speakerId": 1312,
            "speakerName": "伊涅芙",
            "text": "他们是最近开始活跃的，秘闻馆那边推测，可能是外地流窜过来的人马。",
            "nextDialogs": [
              "766520641"
            ]
          },
          "766520641": {
            "id": "766520641",
            "speakerId": 1313,
            "speakerName": "爱诺",
            "text": "不要管他们啦，反正雅珂达说了只是一些小鱼小虾。",
            "nextDialogs": [
              "766520642"
            ]
          },
          "766520642": {
            "id": "766520642",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "那你们现在打算怎么办？",
            "nextDialogs": [
              "766520643"
            ]
          },
          "766520643": {
            "id": "766520643",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "对啊，如果真是那伙盗宝团偷偷放的，他们肯定还会再来的。",
            "nextDialogs": [
              "766520644"
            ]
          },
          "766520644": {
            "id": "766520644",
            "speakerId": 1313,
            "speakerName": "爱诺",
            "text": "那就来吧，如果他们态度还行的话，我就请他们吃蛋卷。",
            "nextDialogs": [
              "766520645"
            ]
          },
          "766520645": {
            "id": "766520645",
            "speakerId": 1313,
            "speakerName": "爱诺",
            "text": "如果态度很恶劣，伊涅芙会请他们甜甜圈吃到饱。",
            "nextDialogs": [
              "766520646"
            ]
          },
          "766520646": {
            "id": "766520646",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "那他们要是偷偷溜进来把核心偷走怎么办？",
            "nextDialogs": [
              "766520647"
            ]
          },
          "766520647": {
            "id": "766520647",
            "speakerId": 1313,
            "speakerName": "爱诺",
            "text": "嘿嘿，我早就想到了，所以今天就要把它藏起来。",
            "nextDialogs": [
              "766520648"
            ]
          },
          "766520648": {
            "id": "766520648",
            "speakerId": 1313,
            "speakerName": "爱诺",
            "text": "伊涅芙，请把阿莎莎它们叫出来吧。",
            "nextDialogs": [
              "766520649"
            ]
          },
          "766520649": {
            "id": "766520649",
            "speakerId": 1313,
            "speakerName": "爱诺",
            "text": "当当当当，我打算把阿莎莎藏进报废的淘金小弟里面。",
            "nextDialogs": [
              "766520650"
            ]
          },
          "766520650": {
            "id": "766520650",
            "speakerId": 1004,
            "speakerName": "阿莎莎",
            "text": "谁给你替我起名的权力？",
            "nextDialogs": [
              "766520651"
            ]
          },
          "766520651": {
            "id": "766520651",
            "speakerId": 1313,
            "speakerName": "爱诺",
            "text": "我们总得用一个名字叫你吧。",
            "nextDialogs": [
              "766520652"
            ]
          },
          "766520652": {
            "id": "766520652",
            "speakerId": 1004,
            "speakerName": "阿莎莎",
            "text": "郎…郎勃罗？",
            "nextDialogs": [
              "766520653"
            ]
          },
          "766520653": {
            "id": "766520653",
            "speakerId": 1313,
            "speakerName": "爱诺",
            "text": "这是什么奇怪的名字啊？也是你从数据废墟里搜出来的吗，一点也不淑女。",
            "nextDialogs": [
              "766520654"
            ]
          },
          "766520654": {
            "id": "766520654",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "阿莎莎·郎勃罗呢？",
            "nextDialogs": [
              "766520655"
            ]
          },
          "766520655": {
            "id": "766520655",
            "speakerId": 1313,
            "speakerName": "爱诺",
            "text": "噢，如果是姓氏的话，好像还可以接受。那就这么决定了，阿莎莎·郎勃罗！你没有意见吧？",
            "nextDialogs": [
              "766520656"
            ]
          },
          "766520656": {
            "id": "766520656",
            "speakerId": 1313,
            "speakerName": "爱诺",
            "text": "有意见我也不管你，谁让你随便跑到别人家里来。以后你就给我好好在这里打工哦！",
            "nextDialogs": [
              "766520657"
            ]
          },
          "766520657": {
            "id": "766520657",
            "speakerId": 16118,
            "speakerName": "阿莎莎·郎勃罗",
            "text": "哼！",
            "nextDialogs": [
              "766520658"
            ]
          },
          "766520658": {
            "id": "766520658",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "它好像很不情愿的样子…",
            "nextDialogs": [
              "766520659"
            ]
          },
          "766520659": {
            "id": "766520659",
            "speakerId": 1312,
            "speakerName": "伊涅芙",
            "text": "不，它其实并没有情愿或不情愿的情感。",
            "nextDialogs": [
              "766520660"
            ]
          },
          "766520660": {
            "id": "766520660",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "欸？什么意思？",
            "nextDialogs": [
              "766520661"
            ]
          },
          "766520661": {
            "id": "766520661",
            "speakerId": 1313,
            "speakerName": "爱诺",
            "text": "因为它的核心已经被毁得不成样子啦。它现在说的话，它的语气，都只是对数据废墟中残留片段的模拟。",
            "nextDialogs": [
              "766520662"
            ]
          },
          "766520662": {
            "id": "766520662",
            "speakerId": 1313,
            "speakerName": "爱诺",
            "text": "说得再清楚一些，假如「莎」代表了某个人的话，现在的阿莎莎就是在模仿那个人说话。",
            "nextDialogs": [
              "766520663"
            ]
          },
          "766520663": {
            "id": "766520663",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "居然是这样…",
            "nextDialogs": [
              "766520664"
            ]
          },
          "766520664": {
            "id": "766520664",
            "speakerId": 1313,
            "speakerName": "爱诺",
            "text": "嗯，不说那些了，我们先干正事吧！把阿莎莎藏起来。",
            "nextDialogs": [
              "766520665"
            ]
          },
          "766520665": {
            "id": "766520665",
            "speakerId": 1313,
            "speakerName": "爱诺",
            "text": "#{NICKNAME}，你来试试怎么样？很有意思的。"
          }
        }
      }
    },
    {
      "subId": "7665207",
      "subQuestName": "和爱诺交谈",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [],

    {
      "subId": "7506911",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "750691101"
        ],
        "dialogs": {
          "750691101": {
            "id": "750691101",
            "speakerId": 1000,
            "speakerName": "夸恩因",
            "text": "瀑布，呵呵…因为瀑布的声音充斥了耳朵，所以，就听不见别的东西了…",
            "nextDialogs": [
              "750691102"
            ]
          },
          "750691102": {
            "id": "750691102",
            "speakerId": 1000,
            "speakerName": "夸恩因",
            "text": "啊，是你啊，有什么事吗？",
            "nextDialogs": [
              "750691103"
            ]
          },
          "750691103": {
            "id": "750691103",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "没有什么事。",
            "nextDialogs": [
              "750691104"
            ]
          },
          "750691104": {
            "id": "750691104",
            "speakerId": 1000,
            "speakerName": "夸恩因",
            "text": "是嘛…啊呀，听我一句劝吧，勇士，还是快些离去吧。"
          }
        }
      }
    },
    {
      "subId": "7506912",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "750691201"
        ],
        "dialogs": {
          "750691201": {
            "id": "750691201",
            "speakerId": 1000,
            "speakerName": "夸恩因",
            "text": "瀑布，呵呵…因为瀑布的声音充斥了耳朵，所以，就听不见别的东西了…",
            "nextDialogs": [
              "750691202"
            ]
          },
          "750691202": {
            "id": "750691202",
            "speakerId": 1000,
            "speakerName": "夸恩因",
            "text": "啊，是你啊，有什么事吗？",
            "nextDialogs": [
              "750691204",
              "750691208"
            ]
          },
          "750691204": {
            "id": "750691204",
            "speakerId": 1000,
            "speakerName": "夸恩因",
            "text": "我是…冒险团的战士，不过，我的勇武比不上领队的泰卡大人，不过，也有用得上我的地方。",
            "nextDialogs": [
              "750691205"
            ]
          },
          "750691205": {
            "id": "750691205",
            "speakerId": 1000,
            "speakerName": "夸恩因",
            "text": "我负责保护冒险团的营地…有的时候在夜里也，无法睡去，所以干脆起来巡逻，保护营地。",
            "nextDialogs": [
              "750691206"
            ]
          },
          "750691206": {
            "id": "750691206",
            "speakerId": 1000,
            "speakerName": "夸恩因",
            "text": "不知道什么时候，营地里的人越来越少了…啊，咦，奇怪，为什么我现在在这里？"
          },
          "750691208": {
            "id": "750691208",
            "speakerId": 1000,
            "speakerName": "夸恩因",
            "text": "是嘛…啊呀，听我一句劝吧，勇士，还是快些离去吧。"
          }
        }
      }
    },
    {
      "subId": "7506913",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "750691301"
        ],
        "dialogs": {
          "750691301": {
            "id": "750691301",
            "speakerId": 1000,
            "speakerName": "夸恩因",
            "text": "瀑布，呵呵…因为瀑布的声音充斥了耳朵，所以，就听不见别的东西了…",
            "nextDialogs": [
              "750691302"
            ]
          },
          "750691302": {
            "id": "750691302",
            "speakerId": 1000,
            "speakerName": "夸恩因",
            "text": "啊，是你啊，有什么事吗？",
            "nextDialogs": [
              "750691304",
              "750691308",
              "750691314"
            ]
          },
          "750691304": {
            "id": "750691304",
            "speakerId": 1000,
            "speakerName": "夸恩因",
            "text": "我是…冒险团的战士，不过，我的勇武比不上领队的泰卡大人，不过，也有用得上我的地方。",
            "nextDialogs": [
              "750691305"
            ]
          },
          "750691305": {
            "id": "750691305",
            "speakerId": 1000,
            "speakerName": "夸恩因",
            "text": "我负责保护冒险团的营地…有的时候在夜里也，无法睡去，所以干脆起来巡逻，保护营地。",
            "nextDialogs": [
              "750691306"
            ]
          },
          "750691306": {
            "id": "750691306",
            "speakerId": 1000,
            "speakerName": "夸恩因",
            "text": "不知道什么时候，营地里的人越来越少了…啊，咦，奇怪，为什么我现在在这里？"
          },
          "750691308": {
            "id": "750691308",
            "speakerId": 1000,
            "speakerName": "夸恩因",
            "text": "是啊，只有在瀑布这里，水声才能盖过…",
            "nextDialogs": [
              "750691309"
            ]
          },
          "750691309": {
            "id": "750691309",
            "speakerId": 1000,
            "speakerName": "夸恩因",
            "text": "你听不见吗，有人在耳边发出低声呜咽的声音，就像是濒死的人无法发出惨叫，只留有肺挤压空气的声响。",
            "nextDialogs": [
              "750691310"
            ]
          },
          "750691310": {
            "id": "750691310",
            "speakerId": 1000,
            "speakerName": "夸恩因",
            "text": "然后你就会看到惨白色的脸，带着怒火凝视着你，啊，那就像是…自己的脸。",
            "nextDialogs": [
              "750691311"
            ]
          },
          "750691311": {
            "id": "750691311",
            "speakerId": 1000,
            "speakerName": "夸恩因",
            "text": "啊，只有在瀑布里，只有在瀑布里，才听不到那些。呵呵，你听不到吗…",
            "nextDialogs": [
              "750691312"
            ]
          },
          "750691312": {
            "id": "750691312",
            "speakerId": 1000,
            "speakerName": "夸恩因",
            "text": "说不定在这里太久，你也会变成我这样，所以还是快些离去吧，勇士啊。"
          },
          "750691314": {
            "id": "750691314",
            "speakerId": 1000,
            "speakerName": "夸恩因",
            "text": "是嘛…啊呀，听我一句劝吧，勇士，还是快些离去吧。"
          }
        }
      }

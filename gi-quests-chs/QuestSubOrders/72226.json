        "startDialogs": [
          "722260301"
        ],
        "dialogs": {
          "722260301": {
            "id": "722260301",
            "speakerId": 20452,
            "speakerName": "阿瑠",
            "text": "#谢谢你们，{NICKNAME}{PLAYERAVATAR#SEXPRO[INFO_MALE_PRONOUN_BROTHER|INFO_FEMALE_PRONOUN_SISTERA]}、派蒙！",
            "nextDialogs": [
              "722260302"
            ]
          },
          "722260302": {
            "id": "722260302",
            "speakerId": 20452,
            "speakerName": "阿瑠",
            "text": "栖木的状态很好，这回的祭典一定会很顺利的！",
            "nextDialogs": [
              "722260305"
            ]
          },
          "722260305": {
            "id": "722260305",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "#哼哼。再怎么说，我和{NICKNAME}也是见识过很多东西的。",
            "nextDialogs": [
              "722260306"
            ]
          },
          "722260306": {
            "id": "722260306",
            "speakerId": 20452,
            "speakerName": "阿瑠",
            "text": "#这么说来，{NICKNAME}{PLAYERAVATAR#SEXPRO[INFO_MALE_PRONOUN_BROTHER|INFO_FEMALE_PRONOUN_SISTERA]}，你们是从哪里来的呀？",
            "nextDialogs": [
              "722260307"
            ]
          },
          "722260307": {
            "id": "722260307",
            "speakerId": 20452,
            "speakerName": "阿瑠",
            "text": "之前也有听来的人说过「稻妻」、「鸣神岛」之类的地方，你们也是稻妻人吗？",
            "nextDialogs": [
              "722260308"
            ]
          },
          "722260308": {
            "id": "722260308",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "相对而言的话…",
            "nextDialogs": [
              "722260309"
            ]
          },
          "722260309": {
            "id": "722260309",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "我们确实是从鸣神岛来的呢…啊！",
            "nextDialogs": [
              "722260310"
            ]
          },
          "722260310": {
            "id": "722260310",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "我都快忘了我们是来找木簧笛的了！",
            "nextDialogs": [
              "722260312"
            ]
          },
          "722260312": {
            "id": "722260312",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "的确呢…",
            "nextDialogs": [
              "722260313"
            ]
          },
          "722260313": {
            "id": "722260313",
            "speakerId": 20452,
            "speakerName": "阿瑠",
            "text": "……",
            "nextDialogs": [
              "722260314"
            ]
          },
          "722260314": {
            "id": "722260314",
            "speakerId": 20452,
            "speakerName": "阿瑠",
            "text": "好厉害！还可以爬到龙的头上！"
          }
        }

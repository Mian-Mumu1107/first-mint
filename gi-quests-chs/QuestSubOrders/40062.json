  },
  "subQuests": [
    {
      "subId": "4006201",
      "subQuestName": "",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "400471301"
        ],
        "dialogs": {
          "400471301": {
            "id": "400471301",
            "speakerId": 1000,
            "speakerName": "阿祇",
            "text": "怎么样，决定好了吗？",
            "nextDialogs": [
              "400471302"
            ]
          },
          "400471302": {
            "id": "400471302",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "嗯嗯，让我们一起来整治渊下宫的黑雾问题吧。",
            "nextDialogs": [
              "400471303"
            ]
          },
          "400471303": {
            "id": "400471303",
            "speakerId": 1000,
            "speakerName": "阿祇",
            "text": "是吗。那么请你收下这个。",
            "nextDialogs": [
              "400471304"
            ]
          },
          "400471304": {
            "id": "400471304",
            "speakerId": 1000,
            "speakerName": "阿祇",
            "text": "这个叫做「睦疏之匣」，是我之前找办法的时候从大日御舆里翻出来的。",
            "nextDialogs": [
              "400471305"
            ]
          },
          "400471305": {
            "id": "400471305",
            "speakerId": 1000,
            "speakerName": "阿祇",
            "text": "其实千灯仪式的做法和用具都是从大日御舆里翻出来的。还好我能看懂人类的文字。",
            "nextDialogs": [
              "400471306"
            ]
          },
          "400471306": {
            "id": "400471306",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "嗯？你能看懂人类的文字不是很正常嘛？你是说能看懂古代渊下宫的文字吗？",
            "nextDialogs": [
              "400471307"
            ]
          },
          "400471307": {
            "id": "400471307",
            "speakerId": 1000,
            "speakerName": "阿祇",
            "text": "啊，没什么。我觉得应该是想说《渊海祝由集成》上的文字吧。我并不知道是古代字还是现代字。",
            "nextDialogs": [
              "400471308"
            ]
          },
          "400471308": {
            "id": "400471308",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "越听越混乱了。",
            "nextDialogs": [
              "400471309"
            ]
          },
          "400471309": {
            "id": "400471309",
            "speakerId": 1000,
            "speakerName": "阿祇",
            "text": "不必在意，还是说回正事吧。",
            "nextDialogs": [
              "400471310"
            ]
          },
          "400471310": {
            "id": "400471310",
            "speakerId": 1000,
            "speakerName": "阿祇",
            "text": "这个睦疏之匣可以采取光明，然后小范围内抵消虚界的黑暗。",
            "nextDialogs": [
              "400471311"
            ]
          },
          "400471311": {
            "id": "400471311",
            "speakerId": 1000,
            "speakerName": "阿祇",
            "text": "比如说被黑雾护持的魔物，使用睦疏之匣的力量，就可以将他们打回原形。",
            "nextDialogs": [
              "400471312"
            ]
          },
          "400471312": {
            "id": "400471312",
            "speakerId": 1000,
            "speakerName": "阿祇",
            "text": "正好营地附近有这样的魔物在作怪，你可以去体会一下睦疏之匣的力量。我稍后会跟上你的。"
          }
        }
      }
    }
  ]
}
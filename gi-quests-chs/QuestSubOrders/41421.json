      }
    },
    {
      "subId": "4142105",
      "subQuestName": "与奇怪的生物对话",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "414210501"
        ],
        "dialogs": {
          "414210501": {
            "id": "414210501",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "唔啊，居然掉下来了一个…",
            "nextDialogs": [
              "414210502"
            ]
          },
          "414210502": {
            "id": "414210502",
            "speakerId": 1003,
            "speakerName": "奇怪的生物",
            "text": "嫣朵拉，没有水，快死了…",
            "nextDialogs": [
              "414210503"
            ]
          },
          "414210503": {
            "id": "414210503",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "嫣朵拉，是你的名字吗？",
            "nextDialogs": [
              "414210504"
            ]
          },
          "414210504": {
            "id": "414210504",
            "speakerId": 10367,
            "speakerName": "嫣朵拉",
            "text": "苦味，是敌意。会杀掉嫣朵拉。",
            "nextDialogs": [
              "414210505"
            ]
          },
          "414210505": {
            "id": "414210505",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "虽然不知道怎么办。要怎么样才能拯救你呢？",
            "nextDialogs": [
              "414210506"
            ]
          },
          "414210506": {
            "id": "414210506",
            "speakerId": 10367,
            "speakerName": "嫣朵拉",
            "text": "要去，有甜甜水的地方。要去，清泉。",
            "nextDialogs": [
              "414210507"
            ]
          },
          "414210507": {
            "id": "414210507",
            "speakerId": 10367,
            "speakerName": "嫣朵拉",
            "text": "嫣朵拉，寄宿水团子，代步。没水。嫣朵拉，无处栖身。",
            "nextDialogs": [
              "414210508"
            ]
          },
          "414210508": {
            "id": "414210508",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "我们要怎么把它带去有清泉的地方呢？",
            "nextDialogs": [
              "414210509"
            ]
          },
          "414210509": {
            "id": "414210509",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "这里倒是有一瓶水。",
            "nextDialogs": [
              "414210510"
            ]
          },
          "414210510": {
            "id": "414210510",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "可是这瓶水也是苦味的啊。",
            "nextDialogs": [
              "414210511"
            ]
          },
          "414210511": {
            "id": "414210511",
            "speakerId": 10367,
            "speakerName": "嫣朵拉",
            "text": "嫣朵拉，可以忍耐。但是，不能很久。",
            "nextDialogs": [
              "414210512"
            ]
          },
          "414210512": {
            "id": "414210512",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "哦哦，那事不宜迟。赶紧出发前往有清泉的地方吧。",
            "nextDialogs": [
              "414210513"
            ]
          },
          "414210513": {
            "id": "414210513",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "不过这个家伙靠着水史莱姆旅行了这么远，和我们的关系很像呢。"
          }
        }
      }
    },
    {
      "subId": "4142106",
      "subQuestName": "返回清泉镇",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "414210601"
        ],
        "dialogs": {
          "414210601": {
            "id": "414210601",
            "speakerId": 10367,
            "speakerName": "嫣朵拉",
            "text": "这里，水是甜的。嫣朵拉发现了，是同类。",
            "nextDialogs": [
              "414210602"
            ]
          },
          "414210602": {
            "id": "414210602",
            "speakerId": 10367,
            "speakerName": "嫣朵拉",
            "text": "嫣朵拉，同类，把水变好喝。也变苦，是洛蒂娅干的。",
            "nextDialogs": [
              "414210603"
            ]
          },
          "414210603": {
            "id": "414210603",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "这么说来，清泉镇似乎的确有泉水精灵的传说来着？",
            "nextDialogs": [
              "414210604"
            ]
          },
          "414210604": {
            "id": "414210604",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "不过我们还是赶紧先去泉水边把瓶子里苦味的水换掉吧。"
          }
        }
      }
    },
    {
      "subId": "4142107",
      "subQuestName": "靠近清泉镇的泉水",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "414210701"
        ],
        "dialogs": {
          "414210701": {
            "id": "414210701",
            "speakerId": 1650,
            "speakerName": "老芬奇",
            "text": "…你是？",
            "nextDialogs": [
              "414210702"
            ]
          },
          "414210702": {
            "id": "414210702",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "哇啊啊，嫣朵拉你怎么自己跑出来了！",
            "nextDialogs": [
              "414210703"
            ]
          },
          "414210703": {
            "id": "414210703",
            "speakerId": 10367,
            "speakerName": "嫣朵拉",
            "text": "我是嫣朵拉。纯水的精灵。",
            "nextDialogs": [
              "414210704"
            ]
          },
          "414210704": {
            "id": "414210704",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "这么说来，这位老爷爷似乎就是深信着清泉精灵存在的人来着。",
            "nextDialogs": [
              "414210705"
            ]
          },
          "414210705": {
            "id": "414210705",
            "speakerId": 1650,
            "speakerName": "老芬奇",
            "text": "…嗯。",
            "nextDialogs": [
              "414210706"
            ]
          },
          "414210706": {
            "id": "414210706",
            "speakerId": 1650,
            "speakerName": "老芬奇",
            "text": "你和她简直一模一样。不过你要小多了啊。",
            "nextDialogs": [
              "414210707"
            ]
          },
          "414210707": {
            "id": "414210707",
            "speakerId": 10367,
            "speakerName": "嫣朵拉",
            "text": "嫣朵拉，还小！嫣朵拉，在学习。",
            "nextDialogs": [
              "414210708"
            ]
          },
          "414210708": {
            "id": "414210708",
            "speakerId": 1650,
            "speakerName": "老芬奇",
            "text": "不过，你出现在我的面前，至少证明了那场相识不是我的白日梦。",
            "nextDialogs": [
              "414210709"
            ]
          },
          "414210709": {
            "id": "414210709",
            "speakerId": 10367,
            "speakerName": "嫣朵拉",
            "text": "她还在。名字，不知道。不知道，也不回答嫣朵拉。",
            "nextDialogs": [
              "414210710"
            ]
          },
          "414210710": {
            "id": "414210710",
            "speakerId": 10367,
            "speakerName": "嫣朵拉",
            "text": "嫣朵拉，要联系她。嫣朵拉，能带话。你要说什么？",
            "nextDialogs": [
              "414210711"
            ]
          },
          "414210711": {
            "id": "414210711",
            "speakerId": 1650,
            "speakerName": "老芬奇",
            "text": "你是说，她一直都在吗？你可以帮我向她带话？",
            "nextDialogs": [
              "414210712"
            ]
          },
          "414210712": {
            "id": "414210712",
            "speakerId": 10367,
            "speakerName": "嫣朵拉",
            "text": "是的，是的。",
            "nextDialogs": [
              "414210713"
            ]
          },
          "414210713": {
            "id": "414210713",
            "speakerId": 1650,
            "speakerName": "老芬奇",
            "text": "…嗯。",
            "nextDialogs": [
              "414210714"
            ]
          },
          "414210714": {
            "id": "414210714",
            "speakerId": 1650,
            "speakerName": "老芬奇",
            "text": "我已经很老了。我…",
            "nextDialogs": [
              "414210715"
            ]
          },
          "414210715": {
            "id": "414210715",
            "speakerId": 1650,
            "speakerName": "老芬奇",
            "text": "帮我向她问声好吧。"
          }
        }
      }
    },
    {
      "subId": "4142108",
      "subQuestName": "与嫣朵拉对话",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "414210801"
        ],
        "dialogs": {
          "414210801": {
            "id": "414210801",
            "speakerId": 10367,
            "speakerName": "嫣朵拉",
            "text": "…",
            "nextDialogs": [
              "414210802"
            ]
          },
          "414210802": {
            "id": "414210802",
            "speakerId": 10367,
            "speakerName": "嫣朵拉",
            "text": "她说了一些奇怪的话，不懂。",
            "nextDialogs": [
              "414210803"
            ]
          },
          "414210803": {
            "id": "414210803",
            "speakerId": 10367,
            "speakerName": "嫣朵拉",
            "text": "馋…缠…什么的，看不懂。问也不回答。",
            "nextDialogs": [
              "414210804"
            ]
          },
          "414210804": {
            "id": "414210804",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "识字数和词汇量不足啊。",
            "nextDialogs": [
              "414210805"
            ]
          },
          "414210805": {
            "id": "414210805",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "大概是有不能和大家见面的理由吧。",
            "nextDialogs": [
              "414210806"
            ]
          },
          "414210806": {
            "id": "414210806",
            "speakerId": 10367,
            "speakerName": "嫣朵拉",
            "text": "不明白。纯水精灵，我们，喜欢融合在一起。",
            "nextDialogs": [
              "414210807"
            ]
          },
          "414210807": {
            "id": "414210807",
            "speakerId": 10367,
            "speakerName": "嫣朵拉",
            "text": "她，一个意识，孤独。",
            "nextDialogs": [
              "414210808"
            ]
          },
          "414210808": {
            "id": "414210808",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "我想大概是因为其他生物和你们没办法融合吧。",
            "nextDialogs": [
              "414210809"
            ]
          },
          "414210809": {
            "id": "414210809",
            "speakerId": 10367,
            "speakerName": "嫣朵拉",
            "text": "诶，没办法吗？",
            "nextDialogs": [
              "414210810"
            ]
          },
          "414210810": {
            "id": "414210810",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "会在你们的身体里淹死的！",
            "nextDialogs": [
              "414210811"
            ]
          },
          "414210811": {
            "id": "414210811",
            "speakerId": 10367,
            "speakerName": "嫣朵拉",
            "text": "你们真孤独。我们，所有人，爱所有人。",
            "nextDialogs": [
              "414210812"
            ]
          },
          "414210812": {
            "id": "414210812",
            "speakerId": 10367,
            "speakerName": "嫣朵拉",
            "text": "啊！",
            "nextDialogs": [
              "414210813"
            ]
          },
          "414210813": {
            "id": "414210813",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "突然怎么了？",
            "nextDialogs": [
              "414210814"
            ]
          },
          "414210814": {
            "id": "414210814",
            "speakerId": 10367,
            "speakerName": "嫣朵拉",
            "text": "石门附近，洛蒂娅的眼线！水的小动物。是，侦察兵。",
            "nextDialogs": [
              "414210815"
            ]
          },
          "414210815": {
            "id": "414210815",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "这么说来似乎的确在附近看到过纯水小动物来着？",
            "nextDialogs": [
              "414210818"
            ]
          },
          "414210818": {
            "id": "414210818",
            "speakerId": 10367,
            "speakerName": "嫣朵拉",
            "text": "强大的水，幻化，小动物。很危险。但是，和它们融合，可以学到东西。",
            "nextDialogs": [
              "414210819"
            ]
          },
          "414210819": {
            "id": "414210819",
            "speakerId": 10367,
            "speakerName": "嫣朵拉",
            "text": "带我去。那边那边。洛蒂娅很不安。洛蒂娅把水变苦了。嫣朵拉学习说话，和洛蒂娅说清楚。",
            "nextDialogs": [
              "414210820"
            ]
          },
          "414210820": {
            "id": "414210820",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "你是说你能帮助我们？",
            "nextDialogs": [
              "414210821"
            ]
          },
          "414210821": {
            "id": "414210821",
            "speakerId": 10367,
            "speakerName": "嫣朵拉",
            "text": "是的，是的。",
            "nextDialogs": [
              "414210822"
            ]
          },
          "414210822": {
            "id": "414210822",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "#{NICKNAME}，我觉得还是值得一试的，毕竟我们目前也没有别的线索了。"
          }
        }

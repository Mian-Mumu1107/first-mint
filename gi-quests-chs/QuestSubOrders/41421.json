  },
  "subQuests": [
    {
      "subId": "4142101",
      "subQuestName": "前往蒙德冒险家协会找凯瑟琳",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "414210101"
        ],
        "dialogs": {
          "414210101": {
            "id": "414210101",
            "speakerId": 1512,
            "speakerName": "凯瑟琳",
            "text": "旅行者，你好啊。最近可别来无恙？",
            "nextDialogs": [
              "414210102"
            ]
          },
          "414210102": {
            "id": "414210102",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "又发生了什么奇怪的事情了吗，凯瑟琳？",
            "nextDialogs": [
              "414210103"
            ]
          },
          "414210103": {
            "id": "414210103",
            "speakerId": 1512,
            "speakerName": "凯瑟琳",
            "text": "和之前那些大事件相比，这件事有些不足为奇。不过因为它事关蒙德的经济，还是挺头疼的。",
            "nextDialogs": [
              "414210106"
            ]
          },
          "414210106": {
            "id": "414210106",
            "speakerId": 1512,
            "speakerName": "凯瑟琳",
            "text": "最近啊，酒庄附近的水源毫无征兆的变苦了。这样下去，未来几年的酿酒业会遭受灭顶之灾。",
            "nextDialogs": [
              "414210107"
            ]
          },
          "414210107": {
            "id": "414210107",
            "speakerId": 1512,
            "speakerName": "凯瑟琳",
            "text": "具体的事情，就请你和酒庄的康纳谈一谈吧。"
          }
        }
      }
    },
    {
      "subId": "4142102",
      "subQuestName": "前往晨曦酒庄询问康纳",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "414210201"
        ],
        "dialogs": {
          "414210201": {
            "id": "414210201",
            "speakerId": 1529,
            "speakerName": "康纳",
            "text": "协会派来协助的人员就是你们吗？",
            "nextDialogs": [
              "414210202"
            ]
          },
          "414210202": {
            "id": "414210202",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "是我们。",
            "nextDialogs": [
              "414210203"
            ]
          },
          "414210203": {
            "id": "414210203",
            "speakerId": 1529,
            "speakerName": "康纳",
            "text": "那我就放心了。关于这件事，比起让我来说，你们还是自己体验一下比较好。",
            "nextDialogs": [
              "414210204"
            ]
          },
          "414210204": {
            "id": "414210204",
            "speakerId": 1529,
            "speakerName": "康纳",
            "text": "这瓶水是就近取用的。它已经经过了所有的净水工序，绝对卫生。你可以放心尝尝看。",
            "nextDialogs": [
              "414210205"
            ]
          },
          "414210205": {
            "id": "414210205",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "我也要我也要！我也想试试。",
            "nextDialogs": [
              "414210206"
            ]
          },
          "414210206": {
            "id": "414210206",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "（尝一口…）",
            "nextDialogs": [
              "414210207"
            ]
          },
          "414210207": {
            "id": "414210207",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "呜啊，呸呸呸。这个苦味…",
            "nextDialogs": [
              "414210208"
            ]
          },
          "414210208": {
            "id": "414210208",
            "speakerId": 1529,
            "speakerName": "康纳",
            "text": "这个苦味用传统的净水手段根本去不掉，不是成分上的问题。应该又是神奇元素力引发的现象吧。",
            "nextDialogs": [
              "414210209"
            ]
          },
          "414210209": {
            "id": "414210209",
            "speakerId": 1529,
            "speakerName": "康纳",
            "text": "这样的水可根本无法酿酒啊。",
            "nextDialogs": [
              "414210210"
            ]
          },
          "414210210": {
            "id": "414210210",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "那附近的鱼最近生活也很艰难吧。",
            "nextDialogs": [
              "414210211"
            ]
          },
          "414210211": {
            "id": "414210211",
            "speakerId": 1529,
            "speakerName": "康纳",
            "text": "我们试过了，那些被苦得翻肚皮的鱼，做成菜都是苦的。",
            "nextDialogs": [
              "414210212"
            ]
          },
          "414210212": {
            "id": "414210212",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "…我都没想这么远！",
            "nextDialogs": [
              "414210213"
            ]
          },
          "414210213": {
            "id": "414210213",
            "speakerId": 1529,
            "speakerName": "康纳",
            "text": "总之，事情就是这样。如果你问我有什么头绪没有的话，我直觉认为应该向北去调查。不知璃月碧水河和轻策庄的水现在味道如何？"
          }
        }
      }
    },
    {
      "subId": "4142103",
      "subQuestName": "沿着水域向西北调查",
      "sceneId": null,
      "locations": [],

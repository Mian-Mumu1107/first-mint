    {
      "subId": "7667802",
      "subQuestName": "演奏乐器",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "760840601"
        ],
        "dialogs": {
          "760840601": {
            "id": "760840601",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "演奏他国的音乐…",
            "nextDialogs": [
              "760490801"
            ]
          },
          "760490801": {
            "id": "760490801",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "演奏他国的音乐…",
            "nextDialogs": [
              "760490802"
            ]
          },
          "760490802": {
            "id": "760490802",
            "speakerId": 1002,
            "speakerName": "「少女」",
            "text": "奇妙的感觉。以前偶尔也听过类似的旋律，但听你弹的感受很不一样。",
            "nextDialogs": [
              "760490803"
            ]
          },
          "760490803": {
            "id": "760490803",
            "speakerId": 1003,
            "speakerName": "派蒙",
            "text": "#可能其中包含了{M#他}{F#她}对那个国家的感情吧。",
            "nextDialogs": [
              "760490804"
            ]
          },
          "760490804": {
            "id": "760490804",
            "speakerId": 1002,
            "speakerName": "「少女」",
            "text": "奇妙的是，我能够从乐调中想象出风景…不知道现实和我的想象会有多少区别呢…",
            "nextDialogs": [
              "760490805"
            ]
          },
          "760490805": {
            "id": "760490805",
            "speakerId": 1003,
            "speakerName": "派蒙",
            "text": "想看还不简单？到时候就让我们来当你的导游吧！",
            "nextDialogs": [
              "760490806"
            ]
          },
          "760490806": {
            "id": "760490806",
            "speakerId": 1002,
            "speakerName": "「少女」",
            "text": "嗯…如果能有那么一天的话。"
          }
        }
      }
    },
    {
      "subId": "7604907",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "760490709"
        ],
        "dialogs": {
          "760490709": {
            "id": "760490709",
            "speakerId": 1002,
            "speakerName": "「少女」",
            "text": "如今我们穿过云雾，一同见到了月亮上的那个答案…它的美好就如你此刻的琴声。"
          }
        }
      }
    },
    {
      "subId": "7608304",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "760830401"
        ],
        "dialogs": {
          "760830401": {
            "id": "760830401",
            "speakerId": 1002,
            "speakerName": "「少女」",
            "text": "去吧，月灵们。",
            "nextDialogs": [
              "760830402"
            ]
          },
          "760830402": {
            "id": "760830402",
            "speakerId": 1002,
            "speakerName": "「少女」",
            "text": "猜猜看这是什么图案。",
            "nextDialogs": [
              "760830404",
              "760830408",
              "760830413"
            ]
          },
          "760830404": {
            "id": "760830404",
            "speakerId": 1004,
            "speakerName": "月灵",
            "text": "！！",
            "nextDialogs": [
              "760830405"
            ]
          },
          "760830405": {
            "id": "760830405",
            "speakerId": 1003,
            "speakerName": "派蒙",
            "text": "哼哼，这次还是挺明显的嘛。",
            "nextDialogs": [
              "760830406"
            ]
          },
          "760830406": {
            "id": "760830406",
            "speakerId": 1002,
            "speakerName": "「少女」",
            "text": "对我们来说，这个谜底有些过于简单了。"
          },
          "760830408": {
            "id": "760830408",
            "speakerId": 1003,
            "speakerName": "派蒙",
            "text": "这次的这位是腰部出了问题？！",
            "nextDialogs": [
              "760830409"
            ]
          },
          "760830409": {
            "id": "760830409",
            "speakerId": 1002,
            "speakerName": "「少女」",
            "text": "你们的见闻真的非常丰富呢…",
            "nextDialogs": [
              "760830410"
            ]
          },
          "760830410": {
            "id": "760830410",
            "speakerId": 1002,
            "speakerName": "「少女」",
            "text": "正确答案是月亮。",
            "nextDialogs": [
              "760830411"
            ]
          },
          "760830411": {
            "id": "760830411",
            "speakerId": 1002,
            "speakerName": "「少女」",
            "text": "回来吧，做得很好哦。"
          },
          "760830413": {
            "id": "760830413",
            "speakerId": 1003,
            "speakerName": "派蒙",
            "text": "谁都看得出来是圆弧吧！那么简单的结论怎么可能是正确答案啦！",
            "nextDialogs": [
              "760830414"
            ]
          },
          "760830414": {
            "id": "760830414",
            "speakerId": 1002,
            "speakerName": "「少女」",
            "text": "的确不能说有错，可惜这并不是月灵们的本意。",
            "nextDialogs": [
              "760830415"
            ]
          },
          "760830415": {
            "id": "760830415",
            "speakerId": 1002,
            "speakerName": "「少女」",
            "text": "正确答案是月亮。",
            "nextDialogs": [
              "760830416"
            ]
          },
          "760830416": {
            "id": "760830416",
            "speakerId": 1002,
            "speakerName": "「少女」",
            "text": "回来吧，做得很好哦。"
          }
        }
      }
    },
    {
      "subId": "7608305",
      "subQuestName": "Additional",
      "sceneId": null,

    {
      "subId": "7667803",
      "subQuestName": "猜图案",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "760830701"
        ],
        "dialogs": {
          "760830701": {
            "id": "760830701",
            "speakerId": 1001,
            "speakerName": "Black Screen",
            "text": "游戏结束后，月灵们一如既往地扑到了你身上，看起来十分开心。",
            "nextDialogs": [
              "760830702"

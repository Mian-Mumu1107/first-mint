        "dialogs": {
          "760830501": {
            "id": "760830501",
            "speakerId": 1002,
            "speakerName": "「少女」",
            "text": "去吧，月灵们。",
            "nextDialogs": [
              "760830502"
            ]
          },
          "760830502": {
            "id": "760830502",
            "speakerId": 1002,
            "speakerName": "「少女」",
            "text": "猜猜看这是什么图案吧。",
            "nextDialogs": [
              "760830504",
              "760830509",
              "760830514"
            ]
          },
          "760830504": {
            "id": "760830504",
            "speakerId": 1004,
            "speakerName": "月灵",
            "text": "！！",
            "nextDialogs": [
              "760830505"
            ]
          },
          "760830505": {
            "id": "760830505",
            "speakerId": 1003,
            "speakerName": "派蒙",
            "text": "你这到底是怎么看出来的？",
            "nextDialogs": [
              "760830506"
            ]
          },
          "760830506": {
            "id": "760830506",
            "speakerId": 1002,
            "speakerName": "「少女」",
            "text": "原来它叫这个名字。它也会把那位机械师放在手上，盛着她到处走吗？",
            "nextDialogs": [
              "760830507"
            ]
          },
          "760830507": {
            "id": "760830507",
            "speakerId": 1003,
            "speakerName": "派蒙",
            "text": "你的想象中好像混入了前同事的影子…"
          },
          "760830509": {
            "id": "760830509",
            "speakerId": 1003,
            "speakerName": "派蒙",
            "text": "都吃成这样了，它还盗得了宝吗？",
            "nextDialogs": [
              "760830510"
            ]
          },
          "760830510": {
            "id": "760830510",
            "speakerId": 1002,
            "speakerName": "「少女」",
            "text": "或者说已经用不着去偷东西了吧？",
            "nextDialogs": [
              "760830511"
            ]
          },
          "760830511": {
            "id": "760830511",
            "speakerId": 1002,
            "speakerName": "「少女」",
            "text": "正确答案是…爱诺工坊附近的大大的机械鸭子。",
            "nextDialogs": [
              "760830512"
            ]
          },
          "760830512": {
            "id": "760830512",
            "speakerId": 1002,
            "speakerName": "「少女」",
            "text": "回来吧，辛苦你们了。"
          },
          "760830514": {
            "id": "760830514",
            "speakerId": 1003,
            "speakerName": "派蒙",
            "text": "月灵们真拼命啊，为了摆游戏用的图案，还要专门观察和研究实验器材！",
            "nextDialogs": [
              "760830515"
            ]
          },
          "760830515": {
            "id": "760830515",
            "speakerId": 1002,
            "speakerName": "「少女」",
            "text": "答案很接近了。",
            "nextDialogs": [
              "760830516"
            ]
          },
          "760830516": {
            "id": "760830516",
            "speakerId": 1002,
            "speakerName": "「少女」",
            "text": "正确答案是…爱诺工坊附近的大大的机械鸭子。",
            "nextDialogs": [
              "760830517"
            ]
          },
          "760830517": {
            "id": "760830517",
            "speakerId": 1003,
            "speakerName": "派蒙",
            "text": "这哪里接近了！",
            "nextDialogs": [
              "760830518"
            ]
          },
          "760830518": {
            "id": "760830518",
            "speakerId": 1002,
            "speakerName": "「少女」",
            "text": "回来吧，辛苦你们了。"
          }
        }
      }
    },

          },
          "760830605": {
            "id": "760830605",
            "speakerId": 1003,
            "speakerName": "派蒙",
            "text": "你不会在我们不知道的时候，偷偷跟月灵们玩过一次了吧？",
            "nextDialogs": [
              "760830606"
            ]
          },
          "760830606": {
            "id": "760830606",
            "speakerId": 1002,
            "speakerName": "「少女」",
            "text": "「愚人众」在挪德卡莱建造的设施太过张扬了，连月灵们也记住了它…"
          },
          "760830608": {
            "id": "760830608",
            "speakerId": 1003,
            "speakerName": "派蒙",
            "text": "虽然身体的部分能够想象出来，但风蕈兽的菌帽真有那么圆吗？",
            "nextDialogs": [
              "760830609"
            ]
          },
          "760830609": {
            "id": "760830609",
            "speakerId": 1002,
            "speakerName": "「少女」",
            "text": "「浮游」的特征倒是没说错呢…",
            "nextDialogs": [
              "760830610"
            ]
          },
          "760830610": {
            "id": "760830610",
            "speakerId": 1002,
            "speakerName": "「少女」",
            "text": "正确答案是月矩力试验设计局。",
            "nextDialogs": [
              "760830611"
            ]
          },
          "760830611": {
            "id": "760830611",
            "speakerId": 1002,
            "speakerName": "「少女」",
            "text": "「愚人众」在挪德卡莱建造的设施太过张扬了，连月灵们也记住了它…",
            "nextDialogs": [
              "760830612"
            ]
          },
          "760830612": {
            "id": "760830612",
            "speakerId": 1002,
            "speakerName": "「少女」",
            "text": "回来吧，很努力了哟。"
          },
          "760830614": {
            "id": "760830614",
            "speakerId": 1003,
            "speakerName": "派蒙",
            "text": "这伞柄好像有点短了，下雨天不太好拿啊。",
            "nextDialogs": [
              "760830615"
            ]
          },
          "760830615": {
            "id": "760830615",
            "speakerId": 1002,
            "speakerName": "「少女」",
            "text": "伞…我平时不怎么用呢。下雨的时候，用月矩力做个护盾就行了吧？",
            "nextDialogs": [
              "760830616"
            ]
          },
          "760830616": {
            "id": "760830616",
            "speakerId": 1003,
            "speakerName": "派蒙",
            "text": "原来你教我们的那招在下雨天也能用吗！",
            "nextDialogs": [
              "760830617"
            ]
          },
          "760830617": {
            "id": "760830617",
            "speakerId": 1002,
            "speakerName": "「少女」",
            "text": "正确答案是月矩力试验设计局。",
            "nextDialogs": [
              "760830618"
            ]
          },
          "760830618": {
            "id": "760830618",
            "speakerId": 1002,
            "speakerName": "「少女」",
            "text": "「愚人众」在挪德卡莱建造的设施太过张扬了，连月灵们也记住了它…",
            "nextDialogs": [
              "760830619"
            ]
          },
          "760830619": {
            "id": "760830619",
            "speakerId": 1002,
            "speakerName": "「少女」",
            "text": "回来吧，很努力了哟。"
          }
        }
      }
    },
    {
      "subId": "7608401",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "760840101"
        ],
        "dialogs": {
          "760840101": {
            "id": "760840101",
            "speakerId": 1002,
            "speakerName": "「少女」",
            "text": "你们来了？今天月灵们又在玩琴。能像上次一样弹一首给它们听吗？",
            "nextDialogs": [
              "760840102"
            ]
          },
          "760840102": {
            "id": "760840102",
            "speakerId": 1002,
            "speakerName": "「少女」",
            "text": "我正好也想听些不一样的曲调。",
            "nextDialogs": [
              "760840103"
            ]
          },
          "760840103": {
            "id": "760840103",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "（弹什么好呢…）"
          }
        }
      }
    },
    {
      "subId": "7608402",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "760840201"
        ],
        "dialogs": {
          "760840201": {
            "id": "760840201",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "演奏哥伦比娅常哼的歌…",
            "nextDialogs": [
              "760490202"
            ]
          },
          "760490202": {
            "id": "760490202",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "演奏哥伦比娅常哼的歌…",
            "nextDialogs": [
              "760490201"
            ]
          },
          "760490201": {
            "id": "760490201",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "（以什么样的情绪演奏呢…）",
            "nextDialogs": [
              "760490604",
              "760490702"
            ]
          },
          "760490604": {
            "id": "760490604",
            "speakerId": 1002,
            "speakerName": "「少女」",
            "text": "好听。我平时哼的旋律，原来你都记下来了。",
            "nextDialogs": [
              "760490605"
            ]
          },
          "760490605": {
            "id": "760490605",
            "speakerId": 1003,
            "speakerName": "派蒙",
            "text": "嘿嘿，因为你唱歌很好听嘛，我们有时会悄悄在旁边听上一会儿。",
            "nextDialogs": [
              "760490606"
            ]
          },
          "760490606": {
            "id": "760490606",
            "speakerId": 1002,
            "speakerName": "「少女」",
            "text": "月灵们也听得入迷了。不知道它们有没有学会。",
            "nextDialogs": [
              "760490607"
            ]
          },
          "760490607": {
            "id": "760490607",
            "speakerId": 1002,
            "speakerName": "「少女」",
            "text": "说不定，以后还得多请你们教几次。",
            "nextDialogs": [
              "760490608"
            ]
          },
          "760490608": {
            "id": "760490608",
            "speakerId": 1002,
            "speakerName": "「少女」",
            "text": "来吧，把手给我。",
            "nextDialogs": [
              "760490609"
            ]
          },
          "760490609": {
            "id": "760490609",
            "speakerId": 1003,
            "speakerName": "派蒙",
            "text": "欸？我们这是无偿演出，不用收学费的！",
            "nextDialogs": [
              "760490610"
            ]
          },
          "760490610": {
            "id": "760490610",
            "speakerId": 1002,
            "speakerName": "「少女」",
            "text": "嗯？学费？",
            "nextDialogs": [
              "760490611"
            ]
          },
          "760490611": {
            "id": "760490611",
            "speakerId": 1002,
            "speakerName": "「少女」",
            "text": "我只是觉得，好听的旋律，应该有美丽的月光相伴。"
          },
          "760490702": {
            "id": "760490702",
            "speakerId": 1002,
            "speakerName": "「少女」",
            "text": "结束了？感觉都还没听够…",
            "nextDialogs": [
              "760490703"
            ]
          },
          "760490703": {
            "id": "760490703",
            "speakerId": 1002,
            "speakerName": "「少女」",
            "text": "我曾说过这是我唯一记得的「摇篮曲」。",
            "nextDialogs": [
              "760490704"
            ]
          },
          "760490704": {
            "id": "760490704",
            "speakerId": 1002,
            "speakerName": "「少女」",
            "text": "尽管还没找到其中的意义，但听你弹过之后，我开始觉得在月亮上等待着我的那个答案，至少是美好的。",
            "nextDialogs": [
              "760490705"
            ]
          },
          "760490705": {
            "id": "760490705",
            "speakerId": 1002,
            "speakerName": "「少女」",
            "text": "来，把手给我。",
            "nextDialogs": [
              "760490706"
            ]
          },
          "760490706": {
            "id": "760490706",
            "speakerId": 1003,
            "speakerName": "派蒙",
            "text": "这次就不用回报啦。",
            "nextDialogs": [
              "760490707"
            ]
          },
          "760490707": {
            "id": "760490707",
            "speakerId": 1002,
            "speakerName": "「少女」",
            "text": "不，我只是想为这旋律添上一束美好的月光。"
          }
        }
      }
    },

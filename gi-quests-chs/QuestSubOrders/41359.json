    {
      "subId": "4135901",
      "subQuestName": "与小千对话",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "413590101"
        ],
        "dialogs": {
          "413590101": {
            "id": "413590101",
            "speakerId": 1000,
            "speakerName": "小千",
            "text": "欢迎试玩「玲珑霄灯图」…",
            "nextDialogs": [
              "413590102"
            ]
          },
          "413590102": {
            "id": "413590102",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "这次也准备了不一样的图案吗？",
            "nextDialogs": [
              "413590103"
            ]
          },
          "413590103": {
            "id": "413590103",
            "speakerId": 1000,
            "speakerName": "小千",
            "text": "当然啦，毕竟被你连续解开了两次，这次我可是真的去换了难度最高的几盏灯。",
            "nextDialogs": [
              "413590104"
            ]
          },
          "413590104": {
            "id": "413590104",
            "speakerId": 1000,
            "speakerName": "小千",
            "text": "不过，图当然还是三个拼成一个完整的，难度还是在<color=#00E1FFFF>「连轴」</color>上。",
            "nextDialogs": [
              "413590105"
            ]
          },
          "413590105": {
            "id": "413590105",
            "speakerId": 1000,
            "speakerName": "小千",
            "text": "嘿嘿，你就自己去体会一下吧，这次的图案是<color=#00E1FFFF>「仙鹤」</color>哦。",
            "nextDialogs": [
              "413590106"
            ]
          },
          "413590106": {
            "id": "413590106",
            "speakerId": 1000,
            "speakerName": "小千",
            "text": "拼好了图之后，你就可以去找宝藏去啦。"
          }
        }
      }
    },
    {
      "subId": "4135902",
      "subQuestName": "完成「玲珑霄灯图·鹤」",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "413590201"
        ],
        "dialogs": {
          "413590201": {
            "id": "413590201",
            "speakerId": 1000,
            "speakerName": "小千",
            "text": "怎么样，寻宝之旅还顺利吗？",
            "nextDialogs": [
              "413590202"
            ]
          },
          "413590202": {
            "id": "413590202",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "已经找到全部宝藏了。",
            "nextDialogs": [
              "413590203"
            ]
          },
          "413590203": {
            "id": "413590203",
            "speakerId": 1000,
            "speakerName": "小千",
            "text": "你居然真的把三张图都解完了…你还挺厉害的…",
            "nextDialogs": [
              "413590204"
            ]
          },
          "413590204": {
            "id": "413590204",
            "speakerId": 1000,
            "speakerName": "小千",
            "text": "咳，对于你这种实力高超的冒险家，我们协会也特别准备了一份大礼。",
            "nextDialogs": [
              "413590205"
            ]
          },
          "413590205": {
            "id": "413590205",
            "speakerId": 1000,
            "speakerName": "小千",
            "text": "看到对面那些宝箱了吗？打开吧，里面的东西都归你了。",
            "nextDialogs": [
              "413590206"
            ]
          },
          "413590206": {
            "id": "413590206",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "我拿了之后…",
            "nextDialogs": [
              "413590207"
            ]
          },
          "413590207": {
            "id": "413590207",
            "speakerId": 1000,
            "speakerName": "小千",
            "text": "后面的人当然就没了，冒险就是这样，战利品谁先拿到就归谁。",
            "nextDialogs": [
              "413590208"
            ]
          },
          "413590208": {
            "id": "413590208",
            "speakerId": 1000,
            "speakerName": "小千",
            "text": "好了，祝你在海灯节玩得开心。"
          }
        }
      }
    },

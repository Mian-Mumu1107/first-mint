        "dialogs": {
          "711550501": {
            "id": "711550501",
            "speakerId": 1000,
            "speakerName": "梦见月瑞希",
            "text": "#真是一张好画片，谢谢你，{NICKNAME}，我会把它保存好的。",
            "nextDialogs": [
              "711550502"
            ]
          },
          "711550502": {
            "id": "711550502",
            "speakerId": 1000,
            "speakerName": "梦见月瑞希",
            "text": "嗯…不如给它做一个相框，放在店里吧…",
            "nextDialogs": [
              "711550504",
              "711550507"
            ]
          },
          "711550504": {
            "id": "711550504",
            "speakerId": 1000,
            "speakerName": "梦见月瑞希",
            "text": "我看见啦，很好看的霄灯。我刚才给它助了一把力，这样它肯定能飞得很高。",
            "nextDialogs": [
              "711550505"
            ]
          },
          "711550505": {
            "id": "711550505",
            "speakerId": 1000,
            "speakerName": "梦见月瑞希",
            "text": "呵…按照璃月人的说法，你在霄灯上写的心愿，肯定也能圆满实现啦。"
          },
          "711550507": {
            "id": "711550507",
            "speakerId": 1000,
            "speakerName": "梦见月瑞希",
            "text": "也祝你节日快乐，呵…今天晚上，璃月港的大家应当无心入眠了吧。"
          }
        }
      }

        ],
        "dialogs": {
          "761060801": {
            "id": "761060801",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "打扰了，我好像走错了…",
            "nextDialogs": [
              "761060802"
            ]
          },
          "761060802": {
            "id": "761060802",
            "speakerId": 22239,
            "speakerName": "沃莉斯菈娃",
            "text": "这可是军事重地！你要是有事就赶紧办事，没事别到处乱逛。"

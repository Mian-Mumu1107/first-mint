  "subQuests": [
    {
      "subId": "7610601",
      "subQuestName": "(test)隐藏$HIDDEN",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "761060401"
        ],
        "dialogs": {
          "761060401": {
            "id": "761060401",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "堂堂愚人众就只有这种程度的本领？",
            "nextDialogs": [
              "761060402"
            ]
          },
          "761060402": {
            "id": "761060402",
            "speakerId": 22239,
            "speakerName": "沃莉斯菈娃",
            "text": "现在的新人说话怎么都这么呛人呢…等一下，仔细看你好像不是这次招进来的新人啊！",
            "nextDialogs": [
              "761060403"
            ]
          },
          "761060403": {
            "id": "761060403",
            "speakerId": 22239,
            "speakerName": "沃莉斯菈娃",
            "text": "还企图撒谎混入我们的队伍，被我看穿了吧？给我拿下！"
          }
        }
      }
    },
    {
      "subId": "7610601",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "761060101"
        ],
        "dialogs": {
          "761060101": {
            "id": "761060101",
            "speakerId": 22239,
            "speakerName": "沃莉斯菈娃",
            "text": "嗯？你看上去有点面生，是新来的对吧？"
          }
        }
      }
    },
    {
      "subId": "7610602",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "761060201"
        ],
        "dialogs": {
          "761060201": {
            "id": "761060201",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "…嗯。",
            "nextDialogs": [
              "761060202"
            ]
          },
          "761060202": {
            "id": "761060202",
            "speakerId": 22239,
            "speakerName": "沃莉斯菈娃",
            "text": "我可是为你好。没事别到设计局里边去，尤其是二层！要是吸收了太多月矩力…轻则头疼重则呕吐。别怪我没提醒过你！"
          }
        }
      }
    },
    {
      "subId": "7610603",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "761060301"
        ],
        "dialogs": {
          "761060301": {
            "id": "761060301",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "真的？",
            "nextDialogs": [
              "761060302"
            ]
          },
          "761060302": {
            "id": "761060302",
            "speakerId": 22239,
            "speakerName": "沃莉斯菈娃",
            "text": "那当然！但凡在里面干活的家伙都会多发一杯苹果酿。你想想，要是对身体没有伤害，怎么会有这样的好事？",
            "nextDialogs": [
              "761060303"
            ]
          },
          "761060303": {
            "id": "761060303",
            "speakerId": 22239,
            "speakerName": "沃莉斯菈娃",
            "text": "再说了，我之前在霜月之子那边亲眼所见！他们的那些执祭头上都长出角来了，你说这能正常吗？",
            "nextDialogs": [
              "761060304"
            ]
          },
          "761060304": {
            "id": "761060304",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "原来是这样…多谢提醒。",
            "nextDialogs": [
              "761060305"
            ]
          },
          "761060305": {
            "id": "761060305",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "听上去好可怕哦！会、会变成怪物吗？",
            "nextDialogs": [
              "761060306"
            ]
          },
          "761060306": {
            "id": "761060306",
            "speakerId": 22239,
            "speakerName": "沃莉斯菈娃",
            "text": "唉，尽派新来的做这些危险的事…你自己小心些吧，别在里面待太久。"
          }
        }
      }
    },
    {
      "subId": "7610605",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "761060501"
        ],
        "dialogs": {
          "761060501": {
            "id": "761060501",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "初次见面，我是你们的老对手了！",
            "nextDialogs": [
              "761060502"
            ]
          },
          "761060502": {
            "id": "761060502",
            "speakerId": 22239,
            "speakerName": "沃莉斯菈娃",
            "text": "可恶，竟然是敌袭…都给我上！"
          }
        }
      }
    },
    {
      "subId": "7610606",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "761060601"
        ],
        "dialogs": {
          "761060601": {
            "id": "761060601",
            "speakerId": 22239,
            "speakerName": "沃莉斯菈娃",
            "text": "都说了不要在里面待太久了，你怎么还跑来跑去的？你真不怕吸收那么多月矩力之后的副作用吗？"
          }
        }
      }
    },
    {
      "subId": "7610607",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "761060701"
        ],
        "dialogs": {
          "761060701": {
            "id": "761060701",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "不怕啊，我可不像你这么弱。",
            "nextDialogs": [
              "761060702"
            ]
          },
          "761060702": {
            "id": "761060702",
            "speakerId": 22239,
            "speakerName": "沃莉斯菈娃",
            "text": "哈？！现在的新人说话怎么都这么呛人呢…等一下，仔细看你好像不是这次招进来的新人啊！原、原来是奸细吗？给我拿下！"
          }
        }
      }
    },
    {
      "subId": "7610608",
      "subQuestName": "Additional",
      "sceneId": null,

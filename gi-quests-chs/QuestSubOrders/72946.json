        "dialogs": {
          "729460101": {
            "id": "729460101",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "关于「花散里」…",
            "nextDialogs": [
              "729460102"
            ]
          },
          "729460102": {
            "id": "729460102",
            "speakerId": 1000,
            "speakerName": "稻城萤美",
            "text": "「花散里」？据我所知，鸣神大社并没有这么一号人物呢…",
            "nextDialogs": [
              "729460103"
            ]
          },
          "729460103": {
            "id": "729460103",
            "speakerId": 1000,
            "speakerName": "稻城萤美",
            "text": "…这么说来，之前清理拜殿的时候，发现了一副颇有年头的狐狸面具，过去似乎属于狐斋宫大人。",
            "nextDialogs": [
              "729460104"
            ]
          },
          "729460104": {
            "id": "729460104",
            "speakerId": 1000,
            "speakerName": "稻城萤美",
            "text": "不嫌弃的话，不知您是否愿意收下呢？您是完成了大祓的人物，与敝社，与狐斋宫大人都颇有因缘。",
            "nextDialogs": [
              "729460105"
            ]
          },
          "729460105": {
            "id": "729460105",
            "speakerId": 1000,
            "speakerName": "稻城萤美",
            "text": "虽然因饱尝年月而十分脆弱、不适合戴在脸上，但这幅面具多少也承载着过去的思念与祝福吧。"
          }
        }
      }
    }
  ]

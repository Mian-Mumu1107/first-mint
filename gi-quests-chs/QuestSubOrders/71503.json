      }
    },
    {
      "subId": "7150301",
      "subQuestName": "与胡塞尼对话",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "715030101"
        ],
        "dialogs": {
          "715030101": {
            "id": "715030101",
            "speakerId": 30181,
            "speakerName": "胡塞尼",
            "text": "#你来得好，{NICKNAME}，我们正讨论怎么将「普尔希娜光钉」搬运进去的事…",
            "nextDialogs": [
              "715030102"
            ]
          },
          "715030102": {
            "id": "715030102",
            "speakerId": 30181,
            "speakerName": "胡塞尼",
            "text": "不过这里的情况比我们想象的严重太多了。",
            "nextDialogs": [
              "715030103"
            ]
          },
          "715030103": {
            "id": "715030103",
            "speakerId": 30183,
            "speakerName": "阿昊",
            "text": "咳咳…不行，这里的黑泥太多，又全是黑泥引来的怪物，搬不进去了。",
            "nextDialogs": [
              "715030104"
            ]
          },
          "715030104": {
            "id": "715030104",
            "speakerId": 30183,
            "speakerName": "阿昊",
            "text": "根本找不到能够再往前的路…",
            "nextDialogs": [
              "715030105"
            ]
          },
          "715030105": {
            "id": "715030105",
            "speakerId": 30184,
            "speakerName": "老图",
            "text": "这还远没到矿道里面呢，来，再搭把手，再试试。",
            "nextDialogs": [
              "715030106"
            ]
          },
          "715030106": {
            "id": "715030106",
            "speakerId": 30184,
            "speakerName": "老图",
            "text": "要是还是不行，我就去外面再找几个弟兄！",
            "nextDialogs": [
              "715030107"
            ]
          },
          "715030107": {
            "id": "715030107",
            "speakerId": 30184,
            "speakerName": "老图",
            "text": "不就是搬个东西嘛，我挖矿巨星老图，随便挥挥镐子就能挖空一座山，这层岩巨渊里的怪物能奈我何？",
            "nextDialogs": [
              "715030108"
            ]
          },
          "715030108": {
            "id": "715030108",
            "speakerId": 30183,
            "speakerName": "阿昊",
            "text": "你就别装了，你憋咳嗽憋得脸都红了。",
            "nextDialogs": [
              "715030109"
            ]
          },
          "715030109": {
            "id": "715030109",
            "speakerId": 30184,
            "speakerName": "老图",
            "text": "你胡说，我哪有，呃咳，咳咳咳咳…",
            "nextDialogs": [
              "715030110"
            ]
          },
          "715030110": {
            "id": "715030110",
            "speakerId": 30181,
            "speakerName": "胡塞尼",
            "text": "不能再继续前进了。",
            "nextDialogs": [
              "715030111"
            ]
          },
          "715030111": {
            "id": "715030111",
            "speakerId": 30181,
            "speakerName": "胡塞尼",
            "text": "过度接触这些黑泥，会造成严重后果，而且里面怪物那么多，太危险了。",
            "nextDialogs": [
              "715030112"
            ]
          },
          "715030112": {
            "id": "715030112",
            "speakerId": 30184,
            "speakerName": "老图",
            "text": "可是，可是我们都看到了，之前把机器放到矿区，矿区不就干净了嘛。",
            "nextDialogs": [
              "715030113"
            ]
          },
          "715030113": {
            "id": "715030113",
            "speakerId": 30184,
            "speakerName": "老图",
            "text": "要是，咳咳，要是能早点解决矿道里的这些黑泥…",
            "nextDialogs": [
              "715030114"
            ]
          },
          "715030114": {
            "id": "715030114",
            "speakerId": 30181,
            "speakerName": "胡塞尼",
            "text": "这不是追求速成的时候，无论是处理问题还是实验，不进行准备，完成勘查，就贸然进行，一个误操作就会造成生命危险。",
            "nextDialogs": [
              "715030115"
            ]
          },
          "715030115": {
            "id": "715030115",
            "speakerId": 30181,
            "speakerName": "胡塞尼",
            "text": "「个人生命至关重要」，这是「教令院」实验室操作手册上的基本守则之一。",
            "nextDialogs": [
              "715030116"
            ]
          },
          "715030116": {
            "id": "715030116",
            "speakerId": 30181,
            "speakerName": "胡塞尼",
            "text": "身为「教令院」的学者，我不能对这样的行为视而不见。",
            "nextDialogs": [
              "715030117"
            ]
          },
          "715030117": {
            "id": "715030117",
            "speakerId": 30183,
            "speakerName": "阿昊",
            "text": "唉，可是我们停手了…这么多黑泥该怎么办？",
            "nextDialogs": [
              "715030118"
            ]
          },
          "715030118": {
            "id": "715030118",
            "speakerId": 30183,
            "speakerName": "阿昊",
            "text": "如果这些黑泥引来更多怪物…就算我们再来二十个人…咳咳，都没法送进去。",
            "nextDialogs": [
              "715030119"
            ]
          },
          "715030119": {
            "id": "715030119",
            "speakerId": 30181,
            "speakerName": "胡塞尼",
            "text": "我想想…",
            "nextDialogs": [
              "715030120"
            ]
          },
          "715030120": {
            "id": "715030120",
            "speakerId": 30181,
            "speakerName": "胡塞尼",
            "text": "实在不行就，在这里先启动一次光钉…",
            "nextDialogs": [
              "715030121"
            ]
          },
          "715030121": {
            "id": "715030121",
            "speakerId": 30183,
            "speakerName": "阿昊",
            "text": "在这里启动光钉？",
            "nextDialogs": [
              "715030122"
            ]
          },
          "715030122": {
            "id": "715030122",
            "speakerId": 30181,
            "speakerName": "胡塞尼",
            "text": "对，我刚才目测了一下黑泥涌出的速率，虽然比昨天矿区里要快，但是毕竟不是黑泥的核心区域，清理的速度会比涌出的速度快。",
            "nextDialogs": [
              "715030123"
            ]
          },
          "715030123": {
            "id": "715030123",
            "speakerId": 30181,
            "speakerName": "胡塞尼",
            "text": "层岩巨渊的怪物被黑泥吸引，肯定也是受到了黑泥里能量的影响。",
            "nextDialogs": [
              "715030124"
            ]
          },
          "715030124": {
            "id": "715030124",
            "speakerId": 30181,
            "speakerName": "胡塞尼",
            "text": "#在这里启动光钉，减轻周围黑泥的影响，对{NICKNAME}你的行动也有助益。",
            "nextDialogs": [
              "715030125"
            ]
          },
          "715030125": {
            "id": "715030125",
            "speakerId": 30181,
            "speakerName": "胡塞尼",
            "text": "如果清理完黑泥，怪物也不会在此聚集。到时候再试试看往里搬运吧。",
            "nextDialogs": [
              "715030126"
            ]
          },
          "715030126": {
            "id": "715030126",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "那就这么办。",
            "nextDialogs": [
              "715030127"
            ]
          },
          "715030127": {
            "id": "715030127",
            "speakerId": 30181,
            "speakerName": "胡塞尼",
            "text": "两位，就先回营地休息一下，之后还有麻烦两位的时候。",
            "nextDialogs": [
              "715030128"
            ]
          },
          "715030128": {
            "id": "715030128",
            "speakerId": 30184,
            "speakerName": "老图",
            "text": "我还不用休息，就这点事…咳咳，还没到我挖矿巨星想要休息的时候，不就是清理怪物嘛，我能帮得上忙！",
            "nextDialogs": [
              "715030129"
            ]
          },
          "715030129": {
            "id": "715030129",
            "speakerId": 30183,
            "speakerName": "阿昊",
            "text": "别强撑着了，我还不知道你？",
            "nextDialogs": [
              "715030130"
            ]
          },
          "715030130": {
            "id": "715030130",
            "speakerId": 30183,
            "speakerName": "阿昊",
            "text": "#这位可是{NICKNAME}，事情交给{NICKNAME}，还有什么需要我和你操心的。",
            "nextDialogs": [
              "715030131"
            ]
          },
          "715030131": {
            "id": "715030131",
            "speakerId": 30183,
            "speakerName": "阿昊",
            "text": "#{NICKNAME}，清理周围的黑泥和怪物，就交给你了。",
            "nextDialogs": [
              "715030134"
            ]
          },
          "715030134": {
            "id": "715030134",
            "speakerId": 30181,
            "speakerName": "胡塞尼",
            "text": "#对了，{NICKNAME}这周围全是黑泥，比我想象的要严重太多了…",
            "nextDialogs": [
              "715030135"
            ]
          },
          "715030135": {
            "id": "715030135",
            "speakerId": 30181,
            "speakerName": "胡塞尼",
            "text": "黑泥周围还有很多的怪物，一定要小心啊…",
            "nextDialogs": [
              "715030136"
            ]
          },
          "715030136": {
            "id": "715030136",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "我会小心的。",
            "nextDialogs": [
              "715030137"
            ]
          },
          "715030137": {
            "id": "715030137",
            "speakerId": 30181,
            "speakerName": "胡塞尼",
            "text": "不，我是说，一定要注意「普尔希娜光钉」的安全啊。",
            "nextDialogs": [
              "715030138"
            ]
          },
          "715030138": {
            "id": "715030138",
            "speakerId": 30181,
            "speakerName": "胡塞尼",
            "text": "我相信你的实力，但是「普尔希娜光钉」毕竟是精密而脆弱的伟大仪器…",
            "nextDialogs": [
              "715030139"
            ]
          },
          "715030139": {
            "id": "715030139",
            "speakerId": 30181,
            "speakerName": "胡塞尼",
            "text": "可得注意不让光钉受到损伤。"
          }
        }
      }
    },
    {

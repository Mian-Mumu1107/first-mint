    {
      "subId": "4135801",
      "subQuestName": "与小千对话",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "413580101"
        ],
        "dialogs": {
          "413580101": {
            "id": "413580101",
            "speakerId": 1000,
            "speakerName": "小千",
            "text": "欢迎试玩「玲珑霄灯图」…",
            "nextDialogs": [
              "413580102"
            ]
          },
          "413580102": {
            "id": "413580102",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "咦？这些灯…",
            "nextDialogs": [
              "413580103"
            ]
          },
          "413580103": {
            "id": "413580103",
            "speakerId": 1000,
            "speakerName": "小千",
            "text": "是你啊，来得正好，你上次解开了那盏灯之后，我特意又换了几盏灯。",
            "nextDialogs": [
              "413580104"
            ]
          },
          "413580104": {
            "id": "413580104",
            "speakerId": 1000,
            "speakerName": "小千",
            "text": "怎么样，要不要再试试解读一下？这次可没上次那么简单了。",
            "nextDialogs": [
              "413580106",
              "413580109"
            ]
          },
          "413580106": {
            "id": "413580106",
            "speakerId": 1000,
            "speakerName": "小千",
            "text": "不不，图案还是很好理解，也只分成三份。",
            "nextDialogs": [
              "413580107"
            ]
          },
          "413580107": {
            "id": "413580107",
            "speakerId": 1000,
            "speakerName": "小千",
            "text": "这次的难度，是在「转灯的方式」上。",
            "nextDialogs": [
              "413580112"
            ]
          },
          "413580112": {
            "id": "413580112",
            "speakerId": 1000,
            "speakerName": "小千",
            "text": "哦！对了，这次要拼出来的图案是<color=#00E1FFFF>「摩拉」</color>，记住了啊，拼好了正确的图案之后，才能去找宝藏。"
          },
          "413580109": {
            "id": "413580109",
            "speakerId": 1000,
            "speakerName": "小千",
            "text": "嘿嘿，这次的三盏灯可是<color=#00E1FFFF>「连轴」</color>的。",
            "nextDialogs": [
              "413580110"
            ]
          },
          "413580110": {
            "id": "413580110",
            "speakerId": 1000,
            "speakerName": "小千",
            "text": "简单来说，就是当你转一盏的时候，说不定另外一盏也会跟着转。",
            "nextDialogs": [
              "413580111"
            ]
          },
          "413580111": {
            "id": "413580111",
            "speakerId": 1000,
            "speakerName": "小千",
            "text": "好了，你就自己去体会一下吧。"
          }
        }
      }
    },
    {
      "subId": "4135802",
      "subQuestName": "完成「玲珑霄灯图·摩拉」",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "413580201"
        ],
        "dialogs": {
          "413580201": {
            "id": "413580201",
            "speakerId": 1000,
            "speakerName": "小千",
            "text": "怎么样，寻宝之旅还顺利吗？",
            "nextDialogs": [
              "413580202"
            ]
          },
          "413580202": {
            "id": "413580202",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "已经找到全部宝藏了。",
            "nextDialogs": [
              "413580203"
            ]
          },
          "413580203": {
            "id": "413580203",
            "speakerId": 1000,
            "speakerName": "小千",
            "text": "全部都找到了？你寻宝的功夫真还挺…出色的，好多人过来，转了一下灯就走了…",
            "nextDialogs": [
              "413580204"
            ]
          },
          "413580204": {
            "id": "413580204",
            "speakerId": 1000,
            "speakerName": "小千",
            "text": "既然你找到了全部的宝藏…那这些奖励给你，收下吧，祝你在海灯节玩得开心。"
          }
        }
      }
    },

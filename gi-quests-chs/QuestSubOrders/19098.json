        "dialogs": {
          "190730902": {
            "id": "190730902",
            "speakerId": 1000,
            "speakerName": "「卡布斯」",
            "text": "你怎么擅自回来了？",
            "nextDialogs": [
              "190730901"
            ]
          },
          "190730901": {
            "id": "190730901",
            "speakerId": 1001,
            "speakerName": "「贡达法」",
            "text": "带着王子的书信，我离开了前线回到王庭。我的王，贡达法求见。"

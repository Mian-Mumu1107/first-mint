        "startDialogs": [
          "190982201"
        ],
        "dialogs": {
          "190982201": {
            "id": "190982201",
            "speakerId": 1000,
            "speakerName": "「卡布斯」",
            "text": "你怎么擅自回来了？",
            "nextDialogs": [
              "190982202"
            ]
          },
          "190982202": {
            "id": "190982202",
            "speakerId": 1001,
            "speakerName": "「贡达法」",
            "text": "带着王子的书信，我离开了前线回到王庭。我的王，贡达法求见。"
          }
        }
      }
    },
    {
      "subId": "1909823",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "190982301"
        ],
        "dialogs": {
          "190982301": {
            "id": "190982301",
            "speakerId": 1005,
            "speakerName": "演出公告",
            "text": "卡布斯剧团驻演中。购买酒水即可欣赏免费演出！"
          }
        }
      }
    },
    {
      "subId": "1909899",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "190989901"
        ],
        "dialogs": {
          "190989901": {
            "id": "190989901",
            "speakerId": 1006,
            "speakerName": "凯亚",
            "text": "看戏…算是不错的娱乐吧，可惜故事我都已经知道了。",
            "nextDialogs": [
              "190989902"
            ]
          },
          "190989902": {
            "id": "190989902",
            "speakerId": 1006,
            "speakerName": "凯亚",
            "text": "#不过有{NICKNAME}作陪应该不会无聊。离风暴的中心越近就越让人心跳加速，呵呵。",
            "nextDialogs": [
              "190989903"
            ]
          },
          "190989903": {
            "id": "190989903",
            "speakerId": 1006,
            "speakerName": "凯亚",
            "text": "非如此不可…哈哈，非如此不可！",
            "nextDialogs": [
              "190989904"
            ]
          },
          "190989904": {
            "id": "190989904",
            "speakerId": 1006,
            "speakerName": "凯亚",
            "text": "在事情变得更无聊之前，早点脱身为好。",
            "nextDialogs": [
              "190989905"
            ]
          },
          "190989905": {
            "id": "190989905",
            "speakerId": 1000,
            "speakerName": "「卡布斯」",
            "text": "不管怎么说，演戏赚钱总比当佣兵稳定啊。",
            "nextDialogs": [
              "190989906"
            ]
          },
          "190989906": {
            "id": "190989906",
            "speakerId": 1001,
            "speakerName": "「贡达法」",
            "text": "台词啊台词…平常哪有人是这么说话的，这就是教令院的智慧吗…",
            "nextDialogs": [
              "190989907"
            ]
          },
          "190989907": {
            "id": "190989907",
            "speakerId": 1004,
            "speakerName": "娜斯米儿",
            "text": "好帅气的外国人呀。",
            "nextDialogs": [
              "190989908"
            ]
          },
          "190989908": {
            "id": "190989908",
            "speakerId": 1007,
            "speakerName": "罗莎娜",
            "text": "居然是蒙德来的，我还以为是沙漠人呢。",
            "nextDialogs": [
              "190989909"
            ]
          },
          "190989909": {
            "id": "190989909",
            "speakerId": 1002,
            "speakerName": "艾依曼",
            "text": "可惜达毕尔的剧团是流动的，过一阵子就要离开了。",
            "nextDialogs": [
              "190989910"
            ]
          },
          "190989910": {
            "id": "190989910",
            "speakerId": 1003,
            "speakerName": "奥乌兹",
            "text": "我这算不算是工作期间溜号…"
          }
        }
      }
    }
  ]

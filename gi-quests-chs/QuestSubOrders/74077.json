        "dialogs": {}
      }
    },
    {
      "subId": "7407708",
      "subQuestName": "（废弃）前往下层",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "740770801"
        ],
        "dialogs": {
          "740770801": {
            "id": "740770801",
            "speakerId": 16924,
            "speakerName": "西摩尔",
            "text": "你好，有什么能为你效劳的吗？",
            "nextDialogs": [
              "740770802"
            ]
          },
          "740770802": {
            "id": "740770802",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "关于警卫发条机关…",
            "nextDialogs": [
              "740770803"
            ]
          },
          "740770803": {
            "id": "740770803",
            "speakerId": 16924,
            "speakerName": "西摩尔",
            "text": "请不必担心。它们都处在非激活状态。",
            "nextDialogs": [
              "740770804"
            ]
          },
          "740770804": {
            "id": "740770804",
            "speakerId": 16924,
            "speakerName": "西摩尔",
            "text": "而且年代久远，加上是初期型号，它们苏醒过来的概率并不是百分之百。",
            "nextDialogs": [
              "740770805"
            ]
          },
          "740770805": {
            "id": "740770805",
            "speakerId": 16924,
            "speakerName": "西摩尔",
            "text": "根据我身边这几位的记录来看，开启下层的入口就会触发激活唤醒。",
            "nextDialogs": [
              "740770806"
            ]
          },
          "740770806": {
            "id": "740770806",
            "speakerId": 16924,
            "speakerName": "西摩尔",
            "text": "到时候大概会有六成机关能成功启动。剩下四成，启动不了的概率也不是百分之百。",
            "nextDialogs": [
              "740770807"
            ]
          },
          "740770807": {
            "id": "740770807",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "呃…",
            "nextDialogs": [
              "740770808"
            ]
          },
          "740770808": {
            "id": "740770808",
            "speakerId": 16924,
            "speakerName": "西摩尔",
            "text": "至少漫长的时间有概率帮我们减轻备战压力。",
            "nextDialogs": [
              "740770809"
            ]
          },
          "740770809": {
            "id": "740770809",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "这几句话逻辑好绕哦。",
            "nextDialogs": [
              "740770810"
            ]
          },
          "740770810": {
            "id": "740770810",
            "speakerId": 16924,
            "speakerName": "西摩尔",
            "text": "#抱歉，{NICKNAME}{M#先生}{F#小姐}。"
          }
        }
      }
    },
    {
      "subId": "7407709",
      "subQuestName": "与大家对话",
      "sceneId": null,
      "locations": [],

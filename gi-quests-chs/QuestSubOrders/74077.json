  },
  "subQuests": [
    {
      "subId": "7407701",
      "subQuestName": "解开此层的谜题",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "740770101"
        ],
        "dialogs": {
          "740770101": {
            "id": "740770101",
            "speakerId": 21048,
            "speakerName": "卡特皮拉",
            "text": "我估计了一下塔的高度，也快到底层了。继续往下可能就要面对纳齐森科鲁兹了。",
            "nextDialogs": [
              "740770102"
            ]
          },
          "740770102": {
            "id": "740770102",
            "speakerId": 21048,
            "speakerName": "卡特皮拉",
            "text": "世界也要迎来它自己的答案了。究竟是毁灭还是得救，亦或者以纳齐森科鲁兹的方式得救。",
            "nextDialogs": [
              "740770103"
            ]
          },
          "740770103": {
            "id": "740770103",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "我才不要用他们设想的形式躲过大灾难呢！",
            "nextDialogs": [
              "740770104"
            ]
          },
          "740770104": {
            "id": "740770104",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "#一定要走的话，我觉得让{NICKNAME}带我跑出提瓦特都更好。",
            "nextDialogs": [
              "740770105"
            ]
          },
          "740770105": {
            "id": "740770105",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "要救所有人。",
            "nextDialogs": [
              "740770106"
            ]
          },
          "740770106": {
            "id": "740770106",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "哎呀，我也不是说要对大家见死不救嘛！",
            "nextDialogs": [
              "740770107"
            ]
          },
          "740770107": {
            "id": "740770107",
            "speakerId": 21048,
            "speakerName": "卡特皮拉",
            "text": "这里似乎没有什么谜题，也没有什么追兵了。不如在这里休整一下吧。",
            "nextDialogs": [
              "740770108"
            ]
          },
          "740770108": {
            "id": "740770108",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "嗯，做好准备吧。",
            "nextDialogs": [
              "740770109"
            ]
          },
          "740770109": {
            "id": "740770109",
            "speakerId": 16924,
            "speakerName": "西摩尔",
            "text": "各位，这扇去往下层的门似乎上锁了。",
            "nextDialogs": [
              "740770110"
            ]
          },
          "740770110": {
            "id": "740770110",
            "speakerId": 16924,
            "speakerName": "西摩尔",
            "text": "需要我引擎超转加足马力进行暴力破门吗？",
            "nextDialogs": [
              "740770111"
            ]
          },
          "740770111": {
            "id": "740770111",
            "speakerId": 21048,
            "speakerName": "卡特皮拉",
            "text": "不必了吧。本来我们就决定在这里休整一下，现在我们都稍微留点心，找找看钥匙就好。",
            "nextDialogs": [
              "740770112"
            ]
          },
          "740770112": {
            "id": "740770112",
            "speakerId": 21048,
            "speakerName": "卡特皮拉",
            "text": "如果最后发现这是扇没有钥匙的门，我亲自把它劈开。"
          }
        }
      }
    },
    {
      "subId": "7407702",
      "subQuestName": "前往下层",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "740770201"
        ],
        "dialogs": {
          "740770201": {
            "id": "740770201",
            "speakerId": 21048,
            "speakerName": "卡特皮拉",
            "text": "这些东西，阵仗怪吓人的…",
            "nextDialogs": [
              "740770202"
            ]
          },
          "740770202": {
            "id": "740770202",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "卡特皮拉又变回来了！",
            "nextDialogs": [
              "740770203"
            ]
          },
          "740770203": {
            "id": "740770203",
            "speakerId": 21048,
            "speakerName": "卡特皮拉",
            "text": "毕竟要做好战斗的准备。你看。",
            "nextDialogs": [
              "740770204"
            ]
          },
          "740770204": {
            "id": "740770204",
            "speakerId": 21048,
            "speakerName": "卡特皮拉",
            "text": "这些是查封这座塔的时候，留下的安保设施。",
            "nextDialogs": [
              "740770205"
            ]
          },
          "740770205": {
            "id": "740770205",
            "speakerId": 21048,
            "speakerName": "卡特皮拉",
            "text": "我们一旦试图前往最底层，恐怕就会触发它们的唤醒流程。",
            "nextDialogs": [
              "740770206"
            ]
          },
          "740770206": {
            "id": "740770206",
            "speakerId": 16924,
            "speakerName": "西摩尔",
            "text": "你的猜测没错。刚才已经检验过了，这批发条机关仍有唤醒启动可能。",
            "nextDialogs": [
              "740770207"
            ]
          },
          "740770207": {
            "id": "740770207",
            "speakerId": 16924,
            "speakerName": "西摩尔",
            "text": "换句话说，也有唤不醒的可能。",
            "nextDialogs": [
              "740770208"
            ]
          },
          "740770208": {
            "id": "740770208",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "这么多年它们就都在这里吗？",
            "nextDialogs": [
              "740770209"
            ]
          },
          "740770209": {
            "id": "740770209",
            "speakerId": 21048,
            "speakerName": "卡特皮拉",
            "text": "这么多年，水仙十字圣剑才第一次被修复啊。",
            "nextDialogs": [
              "740770210"
            ]
          },
          "740770210": {
            "id": "740770210",
            "speakerId": 21048,
            "speakerName": "卡特皮拉",
            "text": "如果当年的设计无误，解除最终封印的钥匙就是圣剑本身了。",
            "nextDialogs": [
              "740770211"
            ]
          },
          "740770211": {
            "id": "740770211",
            "speakerId": 21048,
            "speakerName": "卡特皮拉",
            "text": "准备好了的话，就动手吧。"
          }
        }
      }
    },
    {
      "subId": "7407703",
      "subQuestName": "前往下层",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "740770301"
        ],
        "dialogs": {
          "740770301": {
            "id": "740770301",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "呜哇，感觉地板在动…",
            "nextDialogs": [
              "740770302"
            ]
          },
          "740770302": {
            "id": "740770302",
            "speakerId": 21048,
            "speakerName": "卡特皮拉",
            "text": "这就是结束的开始了。"
          }
        }
      }
    },
    {
      "subId": "7407707",
      "subQuestName": "解开此层的谜题",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "740770701"
        ],
        "dialogs": {
          "740770701": {
            "id": "740770701",
            "speakerId": 21048,
            "speakerName": "卡特皮拉",
            "text": "这里也有一些藏书和纳齐森科鲁兹的笔记。虽然很有趣，但是也全都是没有结局的东西。",
            "nextDialogs": [
              "740770702"
            ]
          },
          "740770702": {
            "id": "740770702",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "卡特皮拉，我有个问题。",
            "nextDialogs": [
              "740770703"
            ]
          },
          "740770703": {
            "id": "740770703",
            "speakerId": 21048,
            "speakerName": "卡特皮拉",
            "text": "请说吧。",
            "nextDialogs": [
              "740770704"
            ]
          },
          "740770704": {
            "id": "740770704",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "结社的人明明很讨厌发条机关…",
            "nextDialogs": [
              "740770705"
            ]
          },
          "740770705": {
            "id": "740770705",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "…这座塔为什么这么多齿轮。",
            "nextDialogs": [
              "740770706"
            ]
          },
          "740770706": {
            "id": "740770706",
            "speakerId": 21048,
            "speakerName": "卡特皮拉",
            "text": "这个问题确实很有意思，但我只能说说我的推论。",
            "nextDialogs": [
              "740770707"
            ]
          },
          "740770707": {
            "id": "740770707",
            "speakerId": 21048,
            "speakerName": "卡特皮拉",
            "text": "在我看来，这里的主题不是齿轮，而是钟。",
            "nextDialogs": [
              "740770708"
            ]
          },
          "740770708": {
            "id": "740770708",
            "speakerId": 21048,
            "speakerName": "卡特皮拉",
            "text": "哪怕是对雅各布或者，纳齐森科鲁兹来说，钟声响起都有特别的意义吧。",
            "nextDialogs": [
              "740770709"
            ]
          },
          "740770709": {
            "id": "740770709",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "特别的意义？",
            "nextDialogs": [
              "740770710"
            ]
          },
          "740770710": {
            "id": "740770710",
            "speakerId": 21048,
            "speakerName": "卡特皮拉",
            "text": "钟响之时，世界终结、冒险结束，或者大梦初醒。谁知道呢？"
          }
        }
      }
    },
    {
      "subId": "7407718",
      "subQuestName": "前往下层",
      "sceneId": null,
      "locations": [],
      "dialogue": {

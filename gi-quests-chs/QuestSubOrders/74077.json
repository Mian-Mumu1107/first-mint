    {
      "subId": "7407722",
      "subQuestName": "稍作休息，与大家聊聊",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "740770601"
        ],
        "dialogs": {
          "740770601": {
            "id": "740770601",
            "speakerId": 20995,
            "speakerName": "安",
            "text": "#{NICKNAME}骑士，有什么事情吗？",
            "nextDialogs": [
              "740770602"
            ]
          },
          "740770602": {
            "id": "740770602",
            "speakerId": 20995,
            "speakerName": "安",
            "text": "卡特皮拉和西摩尔都在帮忙，我似乎在这里就派不上什么用场了。",
            "nextDialogs": [
              "740770603"
            ]
          },
          "740770603": {
            "id": "740770603",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "不必在意。",
            "nextDialogs": [
              "740770604"
            ]
          },
          "740770604": {
            "id": "740770604",
            "speakerId": 20995,
            "speakerName": "安",
            "text": "嗯嗯，我明白的。明明可以一脚踹开的门，大家都很默契地在调查。",
            "nextDialogs": [
              "740770605"
            ]
          },
          "740770605": {
            "id": "740770605",
            "speakerId": 20995,
            "speakerName": "安",
            "text": "大家都在做某种，心理准备吧。"
          }
        }
      }
    },
    {
      "subId": "7407723",
      "subQuestName": "稍作休息，与大家聊聊",
      "sceneId": null,
      "locations": [],

      }
    },
    {
      "subId": "7407725",
      "subQuestName": "稍作休息，与大家聊聊",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "740771201"
        ],
        "dialogs": {
          "740771201": {
            "id": "740771201",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "#{NICKNAME}，为什么人们都喜欢沉浸在梦里？",
            "nextDialogs": [
              "740771202"
            ]
          },
          "740771202": {
            "id": "740771202",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "那个「玛丽安」编织着大家环绕的梦境，纳齐森科鲁兹活在拯救世界的梦想里。",
            "nextDialogs": [
              "740771203"
            ]
          },
          "740771203": {
            "id": "740771203",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "明天的事情都是我在操心…",
            "nextDialogs": [
              "740771204"
            ]
          },
          "740771204": {
            "id": "740771204",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "…派蒙不理解很正常。",
            "nextDialogs": [
              "740771205"
            ]
          },
          "740771205": {
            "id": "740771205",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "因、因为我是一个活在当下的类型！",
            "nextDialogs": [
              "740771206"
            ]
          },
          "740771206": {
            "id": "740771206",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "是梦总是会醒的。",
            "nextDialogs": [
              "740771207"
            ]
          },
          "740771207": {
            "id": "740771207",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "梦醒来的话，就只有两个选择了。",
            "nextDialogs": [
              "740771208"
            ]
          },
          "740771208": {
            "id": "740771208",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "赶紧接着睡，看能不能重新做那个梦。",
            "nextDialogs": [
              "740771209"
            ]
          },
          "740771209": {
            "id": "740771209",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "或者，就在清醒的世界里，好好面对自己。",
            "nextDialogs": [
              "740771210"
            ]
          },
          "740771210": {
            "id": "740771210",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "既然梦醒了，就该吃早餐了吧。那就吃个野菇鸡肉串犒劳自己吧。",
            "nextDialogs": [
              "740771211"
            ]
          },
          "740771211": {
            "id": "740771211",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "又要清醒、勇敢地面对一天现实了呢。给自己加个油！",
            "nextDialogs": [
              "740771212"
            ]
          },
          "740771212": {
            "id": "740771212",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "哇塞，真是伏笔！",
            "nextDialogs": [
              "740771213"
            ]
          },
          "740771213": {
            "id": "740771213",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "伏笔？什么伏笔？"
          }
        }
      }
    },
    {
      "subId": "7407726",
      "subQuestName": "与卡特皮拉对话",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "740772501"
        ],
        "dialogs": {
          "740772501": {
            "id": "740772501",
            "speakerId": 21048,
            "speakerName": "卡特皮拉",
            "text": "#{NICKNAME}， 看看书页中夹杂着什么？",
            "nextDialogs": [
              "740772502"
            ]
          },
          "740772502": {
            "id": "740772502",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "哇，是钥匙！",
            "nextDialogs": [
              "740772503"
            ]
          },
          "740772503": {
            "id": "740772503",
            "speakerId": 21048,
            "speakerName": "卡特皮拉",
            "text": "没错，西摩尔用声波成像模糊验证了一下，确实是那扇门的钥匙。",
            "nextDialogs": [
              "740772504"
            ]
          },
          "740772504": {
            "id": "740772504",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "如果这里曾经被枫丹官方查抄过的话，为什么藏在书里的钥匙一直没有被发现呢？",
            "nextDialogs": [
              "740772505"
            ]
          },
          "740772505": {
            "id": "740772505",
            "speakerId": 21048,
            "speakerName": "卡特皮拉",
            "text": "答案或许是，根本没有查抄。刚才翻了翻这里的笔记，大概能理解为什么…",
            "nextDialogs": [
              "740772506"
            ]
          },
          "740772506": {
            "id": "740772506",
            "speakerId": 21048,
            "speakerName": "卡特皮拉",
            "text": "为什么他只是悄悄关上门就离开了。",
            "nextDialogs": [
              "740772507"
            ]
          },
          "740772507": {
            "id": "740772507",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "嗯，你这句话是什么意思啊？",
            "nextDialogs": [
              "740772508"
            ]
          },
          "740772508": {
            "id": "740772508",
            "speakerId": 21048,
            "speakerName": "卡特皮拉",
            "text": "没什么。或许做到这一步就足够了，下面还有随时可能启动的发条机关呢。",
            "nextDialogs": [
              "740772509"
            ]
          },
          "740772509": {
            "id": "740772509",
            "speakerId": 21048,
            "speakerName": "卡特皮拉",
            "text": "该出发了。"
          }
        }
      }
    },

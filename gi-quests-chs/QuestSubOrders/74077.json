    {
      "subId": "7407716",
      "subQuestName": "与大家对话",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "740770401"
        ],
        "dialogs": {
          "740770401": {
            "id": "740770401",
            "speakerId": 20995,
            "speakerName": "安",
            "text": "#{NICKNAME}骑士、派蒙、卡特皮拉，还有西摩尔…你们还好吗？",
            "nextDialogs": [
              "740770402"
            ]
          },
          "740770402": {
            "id": "740770402",
            "speakerId": 21048,
            "speakerName": "卡特皮拉",
            "text": "嗯。看来通往更深处的入口就要开启了。",
            "nextDialogs": [
              "740770403"
            ]
          },
          "740770403": {
            "id": "740770403",
            "speakerId": 21048,
            "speakerName": "卡特皮拉",
            "text": "去吧，抓住机会。",
            "nextDialogs": [
              "740770404"
            ]
          },
          "740770404": {
            "id": "740770404",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "但是，这里还有好多发条机关…",
            "nextDialogs": [
              "740770405"
            ]
          },
          "740770405": {
            "id": "740770405",
            "speakerId": 21048,
            "speakerName": "卡特皮拉",
            "text": "快去！这里就交给我和西摩尔。让我们在水仙十字结社再会。",
            "nextDialogs": [
              "740770406"
            ]
          },
          "740770406": {
            "id": "740770406",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "拜托你们了。",
            "nextDialogs": [
              "740770407"
            ]
          },
          "740770407": {
            "id": "740770407",
            "speakerId": 16924,
            "speakerName": "西摩尔",
            "text": "毋须担心。评估战力结果：生还概率百分之百。",
            "nextDialogs": [
              "740770408"
            ]
          },
          "740770408": {
            "id": "740770408",
            "speakerId": 1004,
            "speakerName": "Black Screen",
            "text": "向卡特皮拉与西摩尔点头示意后，趁着封印开启的一瞬间跳了进去。\\n在另一头的是…"
          }
        }
      }
    },
    {
      "subId": "7407717",
      "subQuestName": "与安对话",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "740770501"
        ],
        "dialogs": {
          "740770501": {
            "id": "740770501",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "看来是卡特皮拉他们，在另一边挡着…",
            "nextDialogs": [
              "740770502"
            ]
          },
          "740770502": {
            "id": "740770502",
            "speakerId": 20995,
            "speakerName": "安",
            "text": "西摩尔，卡特皮拉…",
            "nextDialogs": [
              "740770503"
            ]
          },
          "740770503": {
            "id": "740770503",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "安，别担心！他们都很厉害的。而且，我们不是约好了吗？等事情结束，我们就在水仙十字结社会合。",
            "nextDialogs": [
              "740770504"
            ]
          },
          "740770504": {
            "id": "740770504",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "#况且，还有{NICKNAME}和我在呀！",
            "nextDialogs": [
              "740770505"
            ]
          },
          "740770505": {
            "id": "740770505",
            "speakerId": 20995,
            "speakerName": "安",
            "text": "#…你说得对，派蒙。{NICKNAME}骑士和派蒙，是我见过的最厉害、最聪明、最善良的人。有你们在身边，没什么好怕的。",
            "nextDialogs": [
              "740770506"
            ]
          },
          "740770506": {
            "id": "740770506",
            "speakerId": 20995,
            "speakerName": "安",
            "text": "没什么好怕的！嗯嗯！一点也不可怕！",
            "nextDialogs": [
              "740770507"
            ]
          },
          "740770507": {
            "id": "740770507",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "（虽然我有点怕就是了…）",
            "nextDialogs": [
              "740770510"
            ]
          },
          "740770510": {
            "id": "740770510",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "必须朝着未来前进。",
            "nextDialogs": [
              "740770511"
            ]
          },
          "740770511": {
            "id": "740770511",
            "speakerId": 1005,
            "speakerName": "派蒙&安",
            "text": "嗯！",
            "nextDialogs": [
              "740770512"
            ]
          },
          "740770512": {
            "id": "740770512",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "接下来，不知道会遇到什么事情…谨慎前进吧！"
          }
        }
      }
    },
    {
      "subId": "7407721",
      "subQuestName": "",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "740772101"
        ],
        "dialogs": {
          "740772101": {
            "id": "740772101",
            "speakerId": 16922,
            "speakerName": "安",
            "text": "#{NICKNAME}骑士，还有什么事吗？",
            "nextDialogs": [
              "740772102"
            ]
          },
          "740772102": {
            "id": "740772102",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "结束之后，有什么想做的吗？",
            "nextDialogs": [
              "740772103"
            ]
          },
          "740772103": {
            "id": "740772103",
            "speakerId": 16922,
            "speakerName": "安",
            "text": "说实话，没有想那么多。感觉我已经无处可去了。",
            "nextDialogs": [
              "740772104"
            ]
          },
          "740772104": {
            "id": "740772104",
            "speakerId": 16922,
            "speakerName": "安",
            "text": "知道真相之后，我再也回不到小卷心菜和阿尔身边了。",
            "nextDialogs": [
              "740772105"
            ]
          },
          "740772105": {
            "id": "740772105",
            "speakerId": 16922,
            "speakerName": "安",
            "text": "我应该去哪里呢？",
            "nextDialogs": [
              "740772106"
            ]
          },
          "740772106": {
            "id": "740772106",
            "speakerId": 16922,
            "speakerName": "安",
            "text": "算了，以后的事情以后再想吧！"
          }
        }
      }
    },
    {
      "subId": "7407709",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "740770901"
        ],
        "dialogs": {
          "740770901": {
            "id": "740770901",
            "speakerId": 21048,
            "speakerName": "卡特皮拉",
            "text": "去吧，最后关头了。"
          }
        }
      }
    },
    {
      "subId": "7407711",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "740771101"
        ],
        "dialogs": {
          "740771101": {
            "id": "740771101",
            "speakerId": 16924,
            "speakerName": "西摩尔",
            "text": "当二位先受到攻击时，我的许可就会激活。我就可以对官方武装出手了。",
            "nextDialogs": [
              "740771102"
            ]
          },
          "740771102": {
            "id": "740771102",
            "speakerId": 16924,
            "speakerName": "西摩尔",
            "text": "所以不必担心。"
          }
        }
      }
    },
    {
      "subId": "7407722",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "740772201"
        ],
        "dialogs": {
          "740772201": {
            "id": "740772201",
            "speakerId": 21048,
            "speakerName": "卡特皮拉",
            "text": "还有什么事吗？",
            "nextDialogs": [
              "740772202"
            ]
          },
          "740772202": {
            "id": "740772202",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "结束之后，你会去找莉诺尔吗？",
            "nextDialogs": [
              "740772203"
            ]
          },
          "740772203": {
            "id": "740772203",
            "speakerId": 21048,
            "speakerName": "卡特皮拉",
            "text": "应该会去看看，不过我应该还是会继续流浪吧。我的内心有很多问题需要得到解答。",
            "nextDialogs": [
              "740772204"
            ]
          },
          "740772204": {
            "id": "740772204",
            "speakerId": 21048,
            "speakerName": "卡特皮拉",
            "text": "在听了雅各布说的话以后，我倒想起有个「揭示之书」和他们早年的事情有关。或许有关于我的线索吧。",
            "nextDialogs": [
              "740772205"
            ]
          },
          "740772205": {
            "id": "740772205",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "你还是很在意过去吗？",
            "nextDialogs": [
              "740772206"
            ]
          },
          "740772206": {
            "id": "740772206",
            "speakerId": 21048,
            "speakerName": "卡特皮拉",
            "text": "嗯。但话说回来，比起这个，我更关心好多年前读过的小说是否有一个美满的结局。",
            "nextDialogs": [
              "740772207"
            ]
          },
          "740772207": {
            "id": "740772207",
            "speakerId": 21048,
            "speakerName": "卡特皮拉",
            "text": "为此，我可以跋山涉水，不开玩笑。",
            "nextDialogs": [
              "740772208"
            ]
          },
          "740772208": {
            "id": "740772208",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "你，又是在开玩笑吧？",
            "nextDialogs": [
              "740772209"
            ]
          },
          "740772209": {
            "id": "740772209",
            "speakerId": 21048,
            "speakerName": "卡特皮拉",
            "text": "有那么一点。不过我对于一个很精彩的梦如何结束，是会报以真心的。"
          }
        }
      }
    },
    {
      "subId": "7407723",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "740772301"
        ],
        "dialogs": {
          "740772301": {
            "id": "740772301",
            "speakerId": 5303,
            "speakerName": "西摩尔",
            "text": "#还有什么事情吗，{NICKNAME}{M#先生}{F#小姐}？",
            "nextDialogs": [
              "740772302"
            ]
          },
          "740772302": {
            "id": "740772302",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "你之后有什么打算吗？",
            "nextDialogs": [
              "740772303"
            ]
          },
          "740772303": {
            "id": "740772303",
            "speakerId": 5303,
            "speakerName": "西摩尔",
            "text": "您是指一切结束之后吗？如果还能与玛丽安小姐再见的话，我希望…",
            "nextDialogs": [
              "740772304"
            ]
          },
          "740772304": {
            "id": "740772304",
            "speakerId": 5303,
            "speakerName": "西摩尔",
            "text": "我希望她能同意和我回去见玛梅赫，然后我们三个一起去周游世界。",
            "nextDialogs": [
              "740772305"
            ]
          },
          "740772305": {
            "id": "740772305",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "你真是条好狗狗。",
            "nextDialogs": [
              "740772306"
            ]
          },
          "740772306": {
            "id": "740772306",
            "speakerId": 5303,
            "speakerName": "西摩尔",
            "text": "不太理解您的意思。",
            "nextDialogs": [
              "740772307"
            ]
          },
          "740772307": {
            "id": "740772307",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "你可真是件可靠性高的原型机！",
            "nextDialogs": [
              "740772308"
            ]
          },
          "740772308": {
            "id": "740772308",
            "speakerId": 5303,
            "speakerName": "西摩尔",
            "text": "谢谢您的夸奖。"
          }
        }
      }
    }
  ]
}
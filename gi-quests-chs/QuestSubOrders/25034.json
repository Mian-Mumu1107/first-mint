  "subQuests": [
    {
      "subId": "2503401",
      "subQuestName": "与特拉忒对话",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "250340101"
        ],
        "dialogs": {
          "250340101": {
            "id": "250340101",
            "speakerId": 1000,
            "speakerName": "特拉忒",
            "text": "它不喜欢你们，走开！",
            "nextDialogs": [
              "250340102"
            ]
          },
          "250340102": {
            "id": "250340102",
            "speakerId": 1001,
            "speakerName": "不耐烦的贼匪",
            "text": "臭小子…你认识这只龙吗？它和你什么关系？",
            "nextDialogs": [
              "250340103"
            ]
          },
          "250340103": {
            "id": "250340103",
            "speakerId": 1002,
            "speakerName": "奇卡",
            "text": "呜…呜呜！",
            "nextDialogs": [
              "250340104"
            ]
          },
          "250340104": {
            "id": "250340104",
            "speakerId": 1001,
            "speakerName": "不耐烦的贼匪",
            "text": "瞧瞧，这只龙都不耐烦了。小子，滚一边去，我们不打小孩。",
            "nextDialogs": [
              "250340105"
            ]
          },
          "250340105": {
            "id": "250340105",
            "speakerId": 1001,
            "speakerName": "不耐烦的贼匪",
            "text": "哥几个，把袋子拿过来。哼哼，这只小龙肯定能卖个好价钱。",
            "nextDialogs": [
              "250340106"
            ]
          },
          "250340106": {
            "id": "250340106",
            "speakerId": 1000,
            "speakerName": "特拉忒",
            "text": "不许过来！再过来我可要动手了！",
            "nextDialogs": [
              "250340107"
            ]
          },
          "250340107": {
            "id": "250340107",
            "speakerId": 1001,
            "speakerName": "不耐烦的贼匪",
            "text": "动，动手？你？哈哈哈哈哈哈，哥几个，他要和我们动手！",
            "nextDialogs": [
              "250340108"
            ]
          },
          "250340108": {
            "id": "250340108",
            "speakerId": 1001,
            "speakerName": "不耐烦的贼匪",
            "text": "我好怕啊，小子。但既然你都放出话了，那可别怪我了。",
            "nextDialogs": [
              "250340109"
            ]
          },
          "250340109": {
            "id": "250340109",
            "speakerId": 1002,
            "speakerName": "奇卡",
            "text": "呜！呜呜！呜！",
            "nextDialogs": [
              "250340110"
            ]
          },
          "250340110": {
            "id": "250340110",
            "speakerId": 1001,
            "speakerName": "不耐烦的贼匪",
            "text": "啧，这小龙还挺凶的…小子，你就好好睡一觉…",
            "nextDialogs": [
              "250340113"
            ]
          },
          "250340113": {
            "id": "250340113",
            "speakerId": 1000,
            "speakerName": "特拉忒",
            "text": "#{M#大哥哥}{F#大姐姐}！他们是坏蛋！想要抢走奇卡！",
            "nextDialogs": [
              "250340114"
            ]
          },
          "250340114": {
            "id": "250340114",
            "speakerId": 1002,
            "speakerName": "奇卡",
            "text": "呜呜！呜呜！",
            "nextDialogs": [
              "250340115"
            ]
          },
          "250340115": {
            "id": "250340115",
            "speakerId": 1001,
            "speakerName": "不耐烦的贼匪",
            "text": "…过路的好汉。只要你不管这件事，哥们承你的情，事成后分你一份钱。"
          }
        }
      }
    },
    {
      "subId": "2503403",
      "subQuestName": "打倒所有敌人",
      "sceneId": null,
      "locations": [],

      }
    },
    {
      "subId": "2503404",
      "subQuestName": "与特拉忒对话",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "250340501"
        ],
        "dialogs": {
          "250340501": {
            "id": "250340501",
            "speakerId": 1000,
            "speakerName": "特拉忒",
            "text": "#{M#大哥哥}{F#大姐姐}，谢谢你救了我们。",
            "nextDialogs": [
              "250340502"
            ]
          },
          "250340502": {
            "id": "250340502",
            "speakerId": 1002,
            "speakerName": "奇卡",
            "text": "呜，呜呜…",
            "nextDialogs": [
              "250340503"
            ]
          },
          "250340503": {
            "id": "250340503",
            "speakerId": 1000,
            "speakerName": "特拉忒",
            "text": "这里离部族太远，我都没办法通知伊莱帕姐姐。要是你没来，奇卡肯定会被抓走的。",
            "nextDialogs": [
              "250340504"
            ]
          },
          "250340504": {
            "id": "250340504",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "你来这里做什么？",
            "nextDialogs": [
              "250340505"
            ]
          },
          "250340505": {
            "id": "250340505",
            "speakerId": 1000,
            "speakerName": "特拉忒",
            "text": "我们还是来这里训练爬山。但训练到一半的时候，我们肚子都饿了。",
            "nextDialogs": [
              "250340506"
            ]
          },
          "250340506": {
            "id": "250340506",
            "speakerId": 1000,
            "speakerName": "特拉忒",
            "text": "所以，我就和奇卡去摘果子。没想到一边摘果子，一边走了太远…",
            "nextDialogs": [
              "250340507"
            ]
          },
          "250340507": {
            "id": "250340507",
            "speakerId": 1000,
            "speakerName": "特拉忒",
            "text": "等到我们吃饱的时候，已经走了好远。回去肯定又要被妈妈念叨了…",
            "nextDialogs": [
              "250340508"
            ]
          },
          "250340508": {
            "id": "250340508",
            "speakerId": 1000,
            "speakerName": "特拉忒",
            "text": "#再次谢谢你救了我，{M#大哥哥}{F#大姐姐}，这些「苦种」给你，都是我刚摘下来的！",
            "nextDialogs": [
              "250340509"
            ]
          },
          "250340509": {
            "id": "250340509",
            "speakerId": 1000,
            "speakerName": "特拉忒",
            "text": "我们快点回去吧，奇卡，走吧！",
            "nextDialogs": [
              "250340510"
            ]
          },
          "250340510": {
            "id": "250340510",
            "speakerId": 1002,
            "speakerName": "奇卡",
            "text": "呜！呜呜！呜呜！"
          }
        }
      }
    }
  ]
}
  },
  "subQuests": [
    {
      "subId": "7223401",
      "subQuestName": "(test)Start$HIDDEN",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "722340101"
        ],
        "dialogs": {
          "722340101": {
            "id": "722340101",
            "speakerId": 1000,
            "speakerName": "桦山",
            "text": "怎么样，坐起来舒服吗？",
            "nextDialogs": [
              "722340102"
            ]
          },
          "722340102": {
            "id": "722340102",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "突然出现，吓我一跳！",
            "nextDialogs": [
              "722340103"
            ]
          },
          "722340103": {
            "id": "722340103",
            "speakerId": 1000,
            "speakerName": "桦山",
            "text": "抱歉抱歉，没打算这样的。",
            "nextDialogs": [
              "722340104"
            ]
          },
          "722340104": {
            "id": "722340104",
            "speakerId": 1000,
            "speakerName": "桦山",
            "text": "我叫桦山，你现在坐的位置我也经常坐。很安静，适合思考人生。",
            "nextDialogs": [
              "722340105"
            ]
          },
          "722340105": {
            "id": "722340105",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "那我让、让给你？",
            "nextDialogs": [
              "722340106"
            ]
          },
          "722340106": {
            "id": "722340106",
            "speakerId": 1000,
            "speakerName": "桦山",
            "text": "唉，谢谢，可是不必了。话说，你是从别处来的？",
            "nextDialogs": [
              "722340107"
            ]
          },
          "722340107": {
            "id": "722340107",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "是的。",
            "nextDialogs": [
              "722340108"
            ]
          },
          "722340108": {
            "id": "722340108",
            "speakerId": 1000,
            "speakerName": "桦山",
            "text": "那你一定见识很广吧。我从来没出去过，虽然四处搬家的经历倒是很丰富。",
            "nextDialogs": [
              "722340109"
            ]
          },
          "722340109": {
            "id": "722340109",
            "speakerId": 1000,
            "speakerName": "桦山",
            "text": "唉，说起这搬家的经历…",
            "nextDialogs": [
              "722340110"
            ]
          },
          "722340110": {
            "id": "722340110",
            "speakerId": 1000,
            "speakerName": "桦山",
            "text": "因为年少时频频搬家，几乎没结识几个相熟的伙伴。独自四处游荡时发现了不错的景致也无人可分享…",
            "nextDialogs": [
              "722340111"
            ]
          },
          "722340111": {
            "id": "722340111",
            "speakerId": 1000,
            "speakerName": "桦山",
            "text": "唉，如果能让你看看那些景致，那倒也好。你在旅途中经过这些地方，不妨坐下看看，要是能回来和我谈谈你的感受那就更好了。",
            "nextDialogs": [
              "722340112"
            ]
          },
          "722340112": {
            "id": "722340112",
            "speakerId": 1000,
            "speakerName": "桦山",
            "text": "一处在狭间之街最高处的石门下，一处在常夜灵庙旁珊瑚环绕的空阔地，一处在蛇心之地的高耸残垣旁。",
            "nextDialogs": [
              "722340113"
            ]
          },
          "722340113": {
            "id": "722340113",
            "speakerId": 1000,
            "speakerName": "桦山",
            "text": "我在这些地方都留下了标记，在高处挂了灯盏，给自己照亮。你应该能很容易找到。"
          }
        }
      }
    },
    {
      "subId": "7223402",
      "subQuestName": "(test)和NPC对话$HIDDEN",

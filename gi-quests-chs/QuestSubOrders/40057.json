    {
      "subId": "4005712",
      "subQuestName": "返回离岛五歌仙广场",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [],
        "dialogs": {}
      }
    },
    {
      "subId": "4005713",
      "subQuestName": "与绫华对话",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "400570601"
        ],
        "dialogs": {
          "400570601": {
            "id": "400570601",
            "speakerId": 1002,
            "speakerName": "Black Screen",
            "text": "不久后，阿贝多完成了两幅画像…",
            "nextDialogs": [
              "400570602"
            ]
          },
          "400570602": {
            "id": "400570602",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "嗯…唔唔…",
            "nextDialogs": [
              "400570605"
            ]
          },
          "400570605": {
            "id": "400570605",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "是啊，其实自从读完了五歌仙故事后，我就有件事一直没想明白。",
            "nextDialogs": [
              "400570606"
            ]
          },
          "400570606": {
            "id": "400570606",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "说起来，五歌仙里不是还有一个「黑主」吗？",
            "nextDialogs": [
              "400570607"
            ]
          },
          "400570607": {
            "id": "400570607",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "现在，岂不是在他完全没有出现的情况下，五歌仙的故事就结束了？",
            "nextDialogs": [
              "400570608"
            ]
          },
          "400570608": {
            "id": "400570608",
            "speakerId": 1011,
            "speakerName": "温迪",
            "text": "噗…哈哈哈，原来你还没有发现吗？",
            "nextDialogs": [
              "400570609"
            ]
          },
          "400570609": {
            "id": "400570609",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "喂，卖唱的，你不要太过分！我没发现什么？",
            "nextDialogs": [
              "400570610"
            ]
          },
          "400570610": {
            "id": "400570610",
            "speakerId": 1003,
            "speakerName": "阿贝多",
            "text": "派蒙，其实现有的四篇诗歌里，已经包含了黑主的故事。",
            "nextDialogs": [
              "400570611"
            ]
          },
          "400570611": {
            "id": "400570611",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "咦，真的吗？",
            "nextDialogs": [
              "400570612"
            ]
          },
          "400570612": {
            "id": "400570612",
            "speakerId": 1011,
            "speakerName": "温迪",
            "text": "事情的关键，就在于葵之翁看到墨染清洗诗集后写出的那首诗。",
            "nextDialogs": [
              "400570613"
            ]
          },
          "400570613": {
            "id": "400570613",
            "speakerId": 1011,
            "speakerName": "温迪",
            "text": "少女在溪边清洗赤人诗集的情景，对于普通人来说，完全不明所以。",
            "nextDialogs": [
              "400570614"
            ]
          },
          "400570614": {
            "id": "400570614",
            "speakerId": 1011,
            "speakerName": "温迪",
            "text": "甚至就连葵之翁也不明白，墨染的行动意味着什么。他只是单纯地睹物思人，回忆起了故交。",
            "nextDialogs": [
              "400570615"
            ]
          },
          "400570615": {
            "id": "400570615",
            "speakerId": 1011,
            "speakerName": "温迪",
            "text": "不过，对于陷害赤人的犯人来说就不一样了。",
            "nextDialogs": [
              "400570616"
            ]
          },
          "400570616": {
            "id": "400570616",
            "speakerId": 1011,
            "speakerName": "温迪",
            "text": "只有他担心，如果这首诗被将军看到，将军就有可能发现赤人抄袭事件的真相，那他可就要完蛋了。",
            "nextDialogs": [
              "400570617"
            ]
          },
          "400570617": {
            "id": "400570617",
            "speakerId": 1011,
            "speakerName": "温迪",
            "text": "所以，他才会铤而走险，威胁葵之翁把那首诗撕下来。",
            "nextDialogs": [
              "400570618"
            ]
          },
          "400570618": {
            "id": "400570618",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "原来那个威胁葵之翁的家伙，就是陷害了赤人的犯人！",
            "nextDialogs": [
              "400570619"
            ]
          },
          "400570619": {
            "id": "400570619",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "这个犯人正是「黑主」。",
            "nextDialogs": [
              "400570620"
            ]
          },
          "400570620": {
            "id": "400570620",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "什么，他就是「黑主」？！",
            "nextDialogs": [
              "400570621"
            ]
          },
          "400570621": {
            "id": "400570621",
            "speakerId": 1011,
            "speakerName": "温迪",
            "text": "对，因为这些诗作虽然只有四篇，却讲述了「五歌仙」的故事。",
            "nextDialogs": [
              "400570622"
            ]
          },
          "400570622": {
            "id": "400570622",
            "speakerId": 1011,
            "speakerName": "温迪",
            "text": "既然诗中的将军肯定不是歌仙，剩下的出场角色，就只有那个身份不明的神秘人咯。",
            "nextDialogs": [
              "400570623"
            ]
          },
          "400570623": {
            "id": "400570623",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "听你们解释过之后，我现在总算是都明白了。",
            "nextDialogs": [
              "400570624"
            ]
          },
          "400570624": {
            "id": "400570624",
            "speakerId": 1003,
            "speakerName": "阿贝多",
            "text": "不过，现在我在想另一件事。",
            "nextDialogs": [
              "400570625"
            ]
          },
          "400570625": {
            "id": "400570625",
            "speakerId": 1003,
            "speakerName": "阿贝多",
            "text": "五歌仙的故事情节，和我们周围发生的事都有或多或少的联系。",
            "nextDialogs": [
              "400570626"
            ]
          },
          "400570626": {
            "id": "400570626",
            "speakerId": 1003,
            "speakerName": "阿贝多",
            "text": "那么在现实当中，会不会也有这样一个「黑主」存在呢？",
            "nextDialogs": [
              "400570627"
            ]
          },
          "400570627": {
            "id": "400570627",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "现实中的…「黑主」？",
            "nextDialogs": [
              "400570628"
            ]
          },
          "400570628": {
            "id": "400570628",
            "speakerId": 1011,
            "speakerName": "温迪",
            "text": "说起来，万叶他是不是想到了些什么呢？",
            "nextDialogs": [
              "400570629"
            ]
          },
          "400570629": {
            "id": "400570629",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "万叶？对啊，好像从刚才开始，他就变得特别沉默，我们过去问问他吧。"
          }
        }
      }
    },
    {
      "subId": "4005714",
      "subQuestName": "与万叶对话",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [],
        "dialogs": {}
      }
    },
    {
      "subId": "4005751",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "400575101"
        ],
        "dialogs": {
          "400575101": {
            "id": "400575101",
            "speakerId": 1005,
            "speakerName": "平山",
            "text": "小野寺，等会就由你把发售会的变化告诉八重大人吧，这个主意八重大人一定会喜欢。",
            "nextDialogs": [
              "400575102"
            ]
          },
          "400575102": {
            "id": "400575102",
            "speakerId": 1005,
            "speakerName": "平山",
            "text": "你的脑子动得很快，只要行事再稳妥一些，将来一定能有所作为。",
            "nextDialogs": [
              "400575103"
            ]
          },
          "400575103": {
            "id": "400575103",
            "speakerId": 1007,
            "speakerName": "小野寺",
            "text": "非常感谢，编辑长。",
            "nextDialogs": [
              "400575104"
            ]
          },
          "400575104": {
            "id": "400575104",
            "speakerId": 1008,
            "speakerName": "村田",
            "text": "这大概就是所谓的因祸得福吧？新刊发售会变成「签售会」，读者们也一定会高兴的。"
          }
        }
      }
    },
    {
      "subId": "4005799",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "400579901"
        ],
        "dialogs": {
          "400579901": {
            "id": "400579901",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "已经到了要去港口的时间了，我们走吧。",
            "nextDialogs": [
              "400579902"
            ]
          },
          "400579902": {
            "id": "400579902",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "「到港时刻表」上写着：船只经停，一人。难道说今天要来的嘉宾只有一个人吗？",
            "nextDialogs": [
              "400579903"
            ]
          },
          "400579903": {
            "id": "400579903",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "你看，码头上的那个身影，好像是万叶！"
          }
        }
      }
    }
  ]
}
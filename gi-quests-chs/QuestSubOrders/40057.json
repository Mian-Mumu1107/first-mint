      }
    },
    {
      "subId": "4005705",
      "subQuestName": "前往乌有亭",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "400570501"
        ],
        "dialogs": {
          "400570501": {
            "id": "400570501",
            "speakerId": 1002,
            "speakerName": "Black Screen",
            "text": "将纸张小心地浸入水中…",
            "nextDialogs": [
              "400570502"
            ]
          },
          "400570502": {
            "id": "400570502",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "哇，你们看，纸上果然出现了很多字！",
            "nextDialogs": [
              "400570503"
            ]
          },
          "400570503": {
            "id": "400570503",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "快给我看看上面写了什么！",
            "nextDialogs": [
              "400570504"
            ]
          },
          "400570504": {
            "id": "400570504",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "唔…故事里说，墨染拿到了赤人的诗集后，把诗集放到了溪水里。",
            "nextDialogs": [
              "400570505"
            ]
          },
          "400570505": {
            "id": "400570505",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "然后，被指认抄袭的那篇诗的字迹就晕开了…为什么会这样？",
            "nextDialogs": [
              "400570506"
            ]
          },
          "400570506": {
            "id": "400570506",
            "speakerId": 1004,
            "speakerName": "神里绫华",
            "text": "派蒙，在过去印刷尚不发达的年代，手写在书上的文字很容易因为受潮变模糊。",
            "nextDialogs": [
              "400570507"
            ]
          },
          "400570507": {
            "id": "400570507",
            "speakerId": 1004,
            "speakerName": "神里绫华",
            "text": "为了让字迹保存更久，往往不是使用特制的墨水书写，就是在写完后，在纸面刷一层防水的涂料。",
            "nextDialogs": [
              "400570508"
            ]
          },
          "400570508": {
            "id": "400570508",
            "speakerId": 1004,
            "speakerName": "神里绫华",
            "text": "特制的墨水制作起来费时费力，刷涂料的办法也并不轻松。",
            "nextDialogs": [
              "400570509"
            ]
          },
          "400570509": {
            "id": "400570509",
            "speakerId": 1004,
            "speakerName": "神里绫华",
            "text": "不过，赤人的诗集既然是要呈给将军品鉴的重要物品，肯定会采用两种办法之一才对。",
            "nextDialogs": [
              "400570510"
            ]
          },
          "400570510": {
            "id": "400570510",
            "speakerId": 1004,
            "speakerName": "神里绫华",
            "text": "但现在抄袭的那篇诗作上，不仅缺少赤人的印章，字迹在遇水后的状况也和其他纸面大不相同。",
            "nextDialogs": [
              "400570513"
            ]
          },
          "400570513": {
            "id": "400570513",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "也就是说赤人并没有做坏事，他是被人陷害的！",
            "nextDialogs": [
              "400570514"
            ]
          },
          "400570514": {
            "id": "400570514",
            "speakerId": 1003,
            "speakerName": "阿贝多",
            "text": "对，这就是墨染的故事想要告诉我们的真相。",
            "nextDialogs": [
              "400570515"
            ]
          },
          "400570515": {
            "id": "400570515",
            "speakerId": 1003,
            "speakerName": "阿贝多",
            "text": "虽然故事令人唏嘘，但现在「赤人」和「墨染」这两幅画的内容，已经能决定下来了。",
            "nextDialogs": [
              "400570516"
            ]
          },
          "400570516": {
            "id": "400570516",
            "speakerId": 1003,
            "speakerName": "阿贝多",
            "text": "万叶，绫华，不知道你们愿不愿意担任模特呢？",
            "nextDialogs": [
              "400570517"
            ]
          },
          "400570517": {
            "id": "400570517",
            "speakerId": 1004,
            "speakerName": "神里绫华",
            "text": "当然可以。",
            "nextDialogs": [
              "400570518"
            ]
          },
          "400570518": {
            "id": "400570518",
            "speakerId": 1000,
            "speakerName": "枫原万叶",
            "text": "我也没有问题。",
            "nextDialogs": [
              "400570519"
            ]
          },
          "400570519": {
            "id": "400570519",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "太好啦，这样就能一下子完成两幅画了！",
            "nextDialogs": [
              "400570520"
            ]
          },
          "400570520": {
            "id": "400570520",
            "speakerId": 1003,
            "speakerName": "阿贝多",
            "text": "嗯，现在四篇故事都集齐了，五歌仙的故事也终于彻底完整了。"
          }
        }
      }
    },
    {
      "subId": "4005706",
      "subQuestName": "与行秋对话",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "400570301"
        ],
        "dialogs": {
          "400570301": {
            "id": "400570301",
            "speakerId": 1005,
            "speakerName": "平山",
            "text": "加油啊枕玉老师，今天写出来的字已经很有进步了，说明昨天的特训很有效！",
            "nextDialogs": [
              "400570302"
            ]
          },
          "400570302": {
            "id": "400570302",
            "speakerId": 1006,
            "speakerName": "行秋",
            "text": "唉，不行了，我的手已经酸得抬不起来了…早知道这样，之前就不在书法课上看小说了。",
            "nextDialogs": [
              "400570303"
            ]
          },
          "400570303": {
            "id": "400570303",
            "speakerId": 1005,
            "speakerName": "平山",
            "text": "刚刚已经休息了十分钟了，再坚持一下啊！",
            "nextDialogs": [
              "400570304"
            ]
          },
          "400570304": {
            "id": "400570304",
            "speakerId": 1007,
            "speakerName": "小野寺",
            "text": "编辑长不愧是我们之中催稿最可怕的人。",
            "nextDialogs": [
              "400570305"
            ]
          },
          "400570305": {
            "id": "400570305",
            "speakerId": 1008,
            "speakerName": "村田",
            "text": "嗯，难怪一遇到麻烦的作者，八重大人最后总会派编辑长出马…",
            "nextDialogs": [
              "400570306"
            ]
          },
          "400570306": {
            "id": "400570306",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "太可怕了，才一阵子没见，行秋就已经要变成行尸走肉了。",
            "nextDialogs": [
              "400570307"
            ]
          },
          "400570307": {
            "id": "400570307",
            "speakerId": 1003,
            "speakerName": "阿贝多",
            "text": "编辑长，其实刚才我们找到了一个办法，或许可以解决大家的困境。",
            "nextDialogs": [
              "400570308"
            ]
          },
          "400570308": {
            "id": "400570308",
            "speakerId": 1003,
            "speakerName": "阿贝多",
            "text": "璃月和稻妻，印章使用都很广泛，印章也往往视作与签名等同之物。或许可以用这个思路，让签名变得容易些。",
            "nextDialogs": [
              "400570309"
            ]
          },
          "400570309": {
            "id": "400570309",
            "speakerId": 1003,
            "speakerName": "阿贝多",
            "text": "当然，只有印章是不行的，签名需要由两部分组成。",
            "nextDialogs": [
              "400570310"
            ]
          },
          "400570310": {
            "id": "400570310",
            "speakerId": 1003,
            "speakerName": "阿贝多",
            "text": "首先是个人的图章，这部分以枕玉老师的签名为模板刻制就好。",
            "nextDialogs": [
              "400570311"
            ]
          },
          "400570311": {
            "id": "400570311",
            "speakerId": 1003,
            "speakerName": "阿贝多",
            "text": "同时，我会再为枕玉老师设计一个美观易写的图案，枕玉老师只需在每本书上签下这个图案即可。",
            "nextDialogs": [
              "400570312"
            ]
          },
          "400570312": {
            "id": "400570312",
            "speakerId": 1005,
            "speakerName": "平山",
            "text": "让我想想…",
            "nextDialogs": [
              "400570313"
            ]
          },
          "400570313": {
            "id": "400570313",
            "speakerId": 1005,
            "speakerName": "平山",
            "text": "嗯，这办法可行！不仅出自作者亲笔，而且效果应该也会十分美观。",
            "nextDialogs": [
              "400570314"
            ]
          },
          "400570314": {
            "id": "400570314",
            "speakerId": 1006,
            "speakerName": "行秋",
            "text": "真的吗，这么说来我终于得救了？",
            "nextDialogs": [
              "400570315"
            ]
          },
          "400570315": {
            "id": "400570315",
            "speakerId": 1007,
            "speakerName": "小野寺",
            "text": "编辑长，我突然想到，之前我们之所以放弃了现场签售，是因为考虑到作者签名会花费比较长时间。",
            "nextDialogs": [
              "400570316"
            ]
          },
          "400570316": {
            "id": "400570316",
            "speakerId": 1007,
            "speakerName": "小野寺",
            "text": "但如果是这种形式的签名的话，是不是在现场签售也来得及？",
            "nextDialogs": [
              "400570317"
            ]
          },
          "400570317": {
            "id": "400570317",
            "speakerId": 1007,
            "speakerName": "小野寺",
            "text": "而且如果所有作者都采用类似的形式，也不会让枕玉老师的签名显得突兀。",
            "nextDialogs": [
              "400570318"
            ]
          },
          "400570318": {
            "id": "400570318",
            "speakerId": 1003,
            "speakerName": "阿贝多",
            "text": "如果你们觉得可行，我当然也很乐意为其他作者设计签名。",
            "nextDialogs": [
              "400570319"
            ]
          },
          "400570319": {
            "id": "400570319",
            "speakerId": 1000,
            "speakerName": "枫原万叶",
            "text": "雕刻印章的事可以交给我。",
            "nextDialogs": [
              "400570320"
            ]
          },
          "400570320": {
            "id": "400570320",
            "speakerId": 1005,
            "speakerName": "平山",
            "text": "既然这样，我现在就去联络新刊发售会的其他两位作者。",
            "nextDialogs": [
              "400570321"
            ]
          },
          "400570321": {
            "id": "400570321",
            "speakerId": 1002,
            "speakerName": "Black Screen",
            "text": "不久后，两位作者赶来了…",
            "nextDialogs": [
              "400570322"
            ]
          },
          "400570322": {
            "id": "400570322",
            "speakerId": 1009,
            "speakerName": "聪美",
            "text": "竟然能获得白垩老师设计的签名，真是太荣幸了。",
            "nextDialogs": [
              "400570323"
            ]
          },
          "400570323": {
            "id": "400570323",
            "speakerId": 1010,
            "speakerName": "勘解由小路健三郎",
            "text": "因为我的笔名很复杂，不适合进行签售，这下终于可以实现心愿了！",
            "nextDialogs": [
              "400570324"
            ]
          },
          "400570324": {
            "id": "400570324",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "太好啦，看来大家都同意这个提案呢。",
            "nextDialogs": [
              "400570325"
            ]
          },
          "400570325": {
            "id": "400570325",
            "speakerId": 1005,
            "speakerName": "平山",
            "text": "让枕玉老师忙了这么多天，实在不好意思，接下来这几天就请您好好休息，后续事宜就交给我们吧。",
            "nextDialogs": [
              "400570326"
            ]
          },
          "400570326": {
            "id": "400570326",
            "speakerId": 1005,
            "speakerName": "平山",
            "text": "已经签好的这些书，将来也会作为八重堂活动的特殊奖品使用。",
            "nextDialogs": [
              "400570327"
            ]
          },
          "400570327": {
            "id": "400570327",
            "speakerId": 1007,
            "speakerName": "小野寺",
            "text": "呼…得救了，终于得救了！",
            "nextDialogs": [
              "400570328"
            ]
          },
          "400570328": {
            "id": "400570328",
            "speakerId": 1006,
            "speakerName": "行秋",
            "text": "多亏大家相助，我和小野寺先生才能彻底摆脱困境。",
            "nextDialogs": [
              "400570329"
            ]
          },
          "400570329": {
            "id": "400570329",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "嘻嘻，行秋终于自由啦，出去好好呼吸一下新鲜空气吧。"
          }
        }
      }
    },
    {
      "subId": "4005707",
      "subQuestName": "离开乌有亭",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "400570701"
        ],
        "dialogs": {
          "400570701": {
            "id": "400570701",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "万叶，你怎么了？从刚才开始就一直站在这幅空白的画布前，而且脸色也不太好。",
            "nextDialogs": [
              "400570702"
            ]
          },
          "400570702": {
            "id": "400570702",
            "speakerId": 1003,
            "speakerName": "阿贝多",
            "text": "抱歉，虽然这只是我们的猜测，不过五歌仙故事，是不是让你联想到了什么？",
            "nextDialogs": [
              "400570703"
            ]
          },
          "400570703": {
            "id": "400570703",
            "speakerId": 1000,
            "speakerName": "枫原万叶",
            "text": "我刚刚的确想到了一些事，只不过那些都是我家的一些陈年旧事罢了。",
            "nextDialogs": [
              "400570704"
            ]
          },
          "400570704": {
            "id": "400570704",
            "speakerId": 1000,
            "speakerName": "枫原万叶",
            "text": "虽然我并不介意告诉大家，但我觉得不该再麻烦你们了。",
            "nextDialogs": [
              "400570705"
            ]
          },
          "400570705": {
            "id": "400570705",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "万叶，我们都是你的朋友，没有麻烦不麻烦这一说。",
            "nextDialogs": [
              "400570706"
            ]
          },
          "400570706": {
            "id": "400570706",
            "speakerId": 1004,
            "speakerName": "神里绫华",
            "text": "枫原，请恕我冒昧，你所想之事是否与「雷电五传」有关？",
            "nextDialogs": [
              "400570707"
            ]
          },
          "400570707": {
            "id": "400570707",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "「雷电五传」，那是什么？",
            "nextDialogs": [
              "400570708"
            ]
          },
          "400570708": {
            "id": "400570708",
            "speakerId": 1000,
            "speakerName": "枫原万叶",
            "text": "看来我和神里小姐所想的是同一件事。",
            "nextDialogs": [
              "400570709"
            ]
          },
          "400570709": {
            "id": "400570709",
            "speakerId": 1000,
            "speakerName": "枫原万叶",
            "text": "这件事与社奉行也有不小的关系，不知道你是否同意，我把它告诉大家？",
            "nextDialogs": [
              "400570710"
            ]
          },
          "400570710": {
            "id": "400570710",
            "speakerId": 1004,
            "speakerName": "神里绫华",
            "text": "在场大家都是值得信赖的人，说出来也无妨。",
            "nextDialogs": [
              "400570711"
            ]
          },
          "400570711": {
            "id": "400570711",
            "speakerId": 1004,
            "speakerName": "神里绫华",
            "text": "只不过这件事要解释起来有些复杂，还是让我先从「雷电五传」讲起吧。",
            "nextDialogs": [
              "400570712"
            ]
          },
          "400570712": {
            "id": "400570712",
            "speakerId": 1004,
            "speakerName": "神里绫华",
            "text": "各位知道，社奉行主要掌管祭祀活动与文化传承，而稻妻的「锻刀技艺」，也是其中极为重要的部分。",
            "nextDialogs": [
              "400570713"
            ]
          },
          "400570713": {
            "id": "400570713",
            "speakerId": 1004,
            "speakerName": "神里绫华",
            "text": "「雷电五传」曾经是稻妻最为顶尖的五个锻刀流派，这五个家族虽是刀匠世家，却也在社奉行有不小的官职。",
            "nextDialogs": [
              "400570714"
            ]
          },
          "400570714": {
            "id": "400570714",
            "speakerId": 1004,
            "speakerName": "神里绫华",
            "text": "只可惜，现在雷电五传已经只剩下「天目流」仍有师徒传承，「一心传」虽然技艺失传，但所幸还有后人在世。",
            "nextDialogs": [
              "400570715"
            ]
          },
          "400570715": {
            "id": "400570715",
            "speakerId": 1004,
            "speakerName": "神里绫华",
            "text": "而枫原家，就正是「一心」一脉的后人。",
            "nextDialogs": [
              "400570716"
            ]
          },
          "400570716": {
            "id": "400570716",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "我们原来只知道万叶家曾经是贵族，没想到竟然还与社奉行和锻刀有关。",
            "nextDialogs": [
              "400570717"
            ]
          },
          "400570717": {
            "id": "400570717",
            "speakerId": 1000,
            "speakerName": "枫原万叶",
            "text": "嗯，不过这都是很早以前的事了，「一心传」在我曾祖父那一代就没落了。",
            "nextDialogs": [
              "400570718"
            ]
          },
          "400570718": {
            "id": "400570718",
            "speakerId": 1000,
            "speakerName": "枫原万叶",
            "text": "我爷爷不满曾祖父的无所作为，在年轻时曾经游历提瓦特，寻找重振家业的办法，可惜最终没能成功。",
            "nextDialogs": [
              "400570719"
            ]
          },
          "400570719": {
            "id": "400570719",
            "speakerId": 1000,
            "speakerName": "枫原万叶",
            "text": "而到我这里，更是连仅剩的祖宅都失去了。",
            "nextDialogs": [
              "400570720"
            ]
          },
          "400570720": {
            "id": "400570720",
            "speakerId": 1004,
            "speakerName": "神里绫华",
            "text": "之前我听兄长提起过，「雷电五传」的没落非常快，在短短数十年里，就有三家遭遇种种不幸，最终彻底消失。",
            "nextDialogs": [
              "400570721"
            ]
          },
          "400570721": {
            "id": "400570721",
            "speakerId": 1004,
            "speakerName": "神里绫华",
            "text": "然后就有人猜测，这些不幸其实都是有人暗中操作的结果，有人想要灭绝「雷电五传」。",
            "nextDialogs": [
              "400570722"
            ]
          },
          "400570722": {
            "id": "400570722",
            "speakerId": 1004,
            "speakerName": "神里绫华",
            "text": "不过由于雷电五传并没有完全消失，这种说法最终也只是被当作坊间传闻而已。",
            "nextDialogs": [
              "400570723"
            ]
          },
          "400570723": {
            "id": "400570723",
            "speakerId": 1000,
            "speakerName": "枫原万叶",
            "text": "对，我之前也一直是这么认为的。",
            "nextDialogs": [
              "400570724"
            ]
          },
          "400570724": {
            "id": "400570724",
            "speakerId": 1000,
            "speakerName": "枫原万叶",
            "text": "不过我知道，曾祖父年轻时曾发生过「一件大事」。",
            "nextDialogs": [
              "400570725"
            ]
          },
          "400570725": {
            "id": "400570725",
            "speakerId": 1000,
            "speakerName": "枫原万叶",
            "text": "那件事不仅牵扯到我们枫原一族，甚至差点动摇了神里家在社奉行的地位。",
            "nextDialogs": [
              "400570726"
            ]
          },
          "400570726": {
            "id": "400570726",
            "speakerId": 1000,
            "speakerName": "枫原万叶",
            "text": "我读到五歌仙的故事后就隐约意识到，它似乎正在提示我那件事的真相。",
            "nextDialogs": [
              "400570727"
            ]
          },
          "400570727": {
            "id": "400570727",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "万叶，当年到底发生过什么？",
            "nextDialogs": [
              "400570728"
            ]
          },
          "400570728": {
            "id": "400570728",
            "speakerId": 1000,
            "speakerName": "枫原万叶",
            "text": "关于那件事的一些细节，我还需要找人求证，大家明天中午再到这里汇合吧。",
            "nextDialogs": [
              "400570729"
            ]
          },
          "400570729": {
            "id": "400570729",
            "speakerId": 1000,
            "speakerName": "枫原万叶",
            "text": "到时候，我会把知道的一切都详细告诉你们。"
          }
        }
      }
    },
    {
      "subId": "4005708",
      "subQuestName": "在乌有亭门口商量下一步计划",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "400570401"
        ],
        "dialogs": {
          "400570401": {
            "id": "400570401",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "现在时间还早，我们接下来要去哪里？",
            "nextDialogs": [
              "400570402"
            ]
          },
          "400570402": {
            "id": "400570402",
            "speakerId": 1004,
            "speakerName": "神里绫华",
            "text": "各位，可算找到你们了。",
            "nextDialogs": [
              "400570403"
            ]
          },
          "400570403": {
            "id": "400570403",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "咦，是绫华和温迪…你们两个怎么会在一起？",
            "nextDialogs": [
              "400570404"
            ]
          },
          "400570404": {
            "id": "400570404",
            "speakerId": 1004,
            "speakerName": "神里绫华",
            "text": "其实是刚才，我去容彩祭会场安排插花课程的事，在花架上发现了一张神秘的纸片。",
            "nextDialogs": [
              "400570405"
            ]
          },
          "400570405": {
            "id": "400570405",
            "speakerId": 1004,
            "speakerName": "神里绫华",
            "text": "当时刚好这位吟游诗人就在旁边，我听他说，这些天你们还发现过其他类似的东西，于是就和他一起来找你们。",
            "nextDialogs": [
              "400570406"
            ]
          },
          "400570406": {
            "id": "400570406",
            "speakerId": 1011,
            "speakerName": "温迪",
            "text": "不过这位小姐发现的纸片，和我们之前找到的不太一样。",
            "nextDialogs": [
              "400570407"
            ]
          },
          "400570407": {
            "id": "400570407",
            "speakerId": 1004,
            "speakerName": "神里绫华",
            "text": "东西在这里，请各位过目。",
            "nextDialogs": [
              "400570408"
            ]
          },
          "400570408": {
            "id": "400570408",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "之前的诗歌长度都差不多，但这次却只有两句。",
            "nextDialogs": [
              "400570409"
            ]
          },
          "400570409": {
            "id": "400570409",
            "speakerId": 1003,
            "speakerName": "阿贝多",
            "text": "明明只有短短两句话，却既没有挨着标题，也没有写在整张纸中间。",
            "nextDialogs": [
              "400570410"
            ]
          },
          "400570410": {
            "id": "400570410",
            "speakerId": 1003,
            "speakerName": "阿贝多",
            "text": "字迹的位置简直就像是在告诉我们，除了这两句话之外，这张纸上还有其他内容似的。",
            "nextDialogs": [
              "400570411"
            ]
          },
          "400570411": {
            "id": "400570411",
            "speakerId": 1006,
            "speakerName": "行秋",
            "text": "如果从字面意思来理解这句诗的话，就是「把纸张放在水中，真相自然会浮现」。",
            "nextDialogs": [
              "400570412"
            ]
          },
          "400570412": {
            "id": "400570412",
            "speakerId": 1006,
            "speakerName": "行秋",
            "text": "说起来我家中有本古籍，专讲古代的奇闻异事，书中提到过一种特殊的墨水，能够遇水则显，水干则消。",
            "nextDialogs": [
              "400570413"
            ]
          },
          "400570413": {
            "id": "400570413",
            "speakerId": 1011,
            "speakerName": "温迪",
            "text": "那我们要不要去试试？刚好这附近就有水池。"
          }
        }
      }
    },
    {

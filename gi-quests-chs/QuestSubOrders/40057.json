    "神里绫华": 20,
    "聪美": 1,
    "行秋": 5,
    "阿贝多": 22
  },
  "subQuests": [
    {
      "subId": "4005701",
      "subQuestName": "等到第二天早上（7~9时）",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "400570101"
        ],
        "dialogs": {
          "400570101": {
            "id": "400570101",
            "speakerId": 1000,
            "speakerName": "枫原万叶",
            "text": "#{NICKNAME}，派蒙，你们好。我听说容彩祭会有向导，却没想到是你们。",
            "nextDialogs": [
              "400570102"
            ]
          },
          "400570102": {
            "id": "400570102",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "嘻嘻，我们也没想到，万叶竟然会以容彩祭嘉宾的身份回到稻妻。",
            "nextDialogs": [
              "400570103"
            ]
          },
          "400570103": {
            "id": "400570103",
            "speakerId": 1000,
            "speakerName": "枫原万叶",
            "text": "接到邀请函时我也有些诧异，不过在外面漂泊久了，能借此机会回到故土，祭拜一下故人也不错。",
            "nextDialogs": [
              "400570104"
            ]
          },
          "400570104": {
            "id": "400570104",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "万叶，我们刚才远远地看见你好像正在找什么东西，发生什么事了？",
            "nextDialogs": [
              "400570105"
            ]
          },
          "400570105": {
            "id": "400570105",
            "speakerId": 1000,
            "speakerName": "枫原万叶",
            "text": "是这样的，刚才我跟着大家下船的时候，突然听到身边响起了很轻的脚步声。",
            "nextDialogs": [
              "400570106"
            ]
          },
          "400570106": {
            "id": "400570106",
            "speakerId": 1000,
            "speakerName": "枫原万叶",
            "text": "那种脚步绝不是一般乘客，可我回过头时，那人已经不见了，只有栈桥下传来了「噗通」一声响。",
            "nextDialogs": [
              "400570107"
            ]
          },
          "400570107": {
            "id": "400570107",
            "speakerId": 1000,
            "speakerName": "枫原万叶",
            "text": "我没找到对方的踪影，不过却在脚边发现了一张奇怪的纸。",
            "nextDialogs": [
              "400570108"
            ]
          },
          "400570108": {
            "id": "400570108",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "万叶，你捡到的纸上是不是写了一首诗？",
            "nextDialogs": [
              "400570109"
            ]
          },
          "400570109": {
            "id": "400570109",
            "speakerId": 1000,
            "speakerName": "枫原万叶",
            "text": "咦，你们怎么知道？",
            "nextDialogs": [
              "400570110"
            ]
          },
          "400570110": {
            "id": "400570110",
            "speakerId": 1002,
            "speakerName": "Black Screen",
            "text": "把之前几天发生的事告诉了万叶…",
            "nextDialogs": [
              "400570111"
            ]
          },
          "400570111": {
            "id": "400570111",
            "speakerId": 1000,
            "speakerName": "枫原万叶",
            "text": "竟然还有这种事。",
            "nextDialogs": [
              "400570112"
            ]
          },
          "400570112": {
            "id": "400570112",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "万叶，能给我们看看那张纸吗？",
            "nextDialogs": [
              "400570113"
            ]
          },
          "400570113": {
            "id": "400570113",
            "speakerId": 1000,
            "speakerName": "枫原万叶",
            "text": "在这里，请吧。",
            "nextDialogs": [
              "400570114"
            ]
          },
          "400570114": {
            "id": "400570114",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "上次葵之翁的诗最后提到了「赤人」，果然这一篇就是赤人的故事了。",
            "nextDialogs": [
              "400570115"
            ]
          },
          "400570115": {
            "id": "400570115",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "这次的故事大致是说：赤人因为喜欢用红色的印章才有了这个雅号，不过他却因为剽窃被将军发现，然后被流放了…",
            "nextDialogs": [
              "400570116"
            ]
          },
          "400570116": {
            "id": "400570116",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "怎么说呢，如果要评价的话，今天的故事听起来不是很吉利。",
            "nextDialogs": [
              "400570117"
            ]
          },
          "400570117": {
            "id": "400570117",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "其实之前的也好不到哪去…",
            "nextDialogs": [
              "400570118"
            ]
          },
          "400570118": {
            "id": "400570118",
            "speakerId": 1000,
            "speakerName": "枫原万叶",
            "text": "我倒觉得这篇故事并无不妥，我之前也曾经是被幕府通缉的要犯，和故事里的赤人也差不多。",
            "nextDialogs": [
              "400570119"
            ]
          },
          "400570119": {
            "id": "400570119",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "这篇故事里的赤人做了坏事，被将军流放是咎由自取，和万叶一点都不一样。",
            "nextDialogs": [
              "400570120"
            ]
          },
          "400570120": {
            "id": "400570120",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "喂，你在想什么呢？",
            "nextDialogs": [
              "400570123"
            ]
          },
          "400570123": {
            "id": "400570123",
            "speakerId": 1000,
            "speakerName": "枫原万叶",
            "text": "对了，你们刚才提到，有位朋友最近正苦于签名太慢是吗？",
            "nextDialogs": [
              "400570124"
            ]
          },
          "400570124": {
            "id": "400570124",
            "speakerId": 1000,
            "speakerName": "枫原万叶",
            "text": "在璃月和稻妻，的确都有「印章等同于签名」的说法，这说不定是个可行的主意。",
            "nextDialogs": [
              "400570125"
            ]
          },
          "400570125": {
            "id": "400570125",
            "speakerId": 1000,
            "speakerName": "枫原万叶",
            "text": "在海上航行时，我偶尔会雕刻些东西打发时光，如果要做印章，或许我也能出一份力。",
            "nextDialogs": [
              "400570126"
            ]
          },
          "400570126": {
            "id": "400570126",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "哇，那就太好了！我们现在，先去找阿贝多商量一下吧。"
          }
        }
      }
    },
    {
      "subId": "4005702",
      "subQuestName": "前往离岛码头",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "400570201"
        ],
        "dialogs": {
          "400570201": {
            "id": "400570201",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "阿贝多，我们找到帮行秋的办法了！",
            "nextDialogs": [
              "400570202"
            ]
          },
          "400570202": {
            "id": "400570202",
            "speakerId": 1002,
            "speakerName": "Black Screen",
            "text": "把刚才发生的事告诉了阿贝多。",
            "nextDialogs": [
              "400570203"
            ]
          },
          "400570203": {
            "id": "400570203",
            "speakerId": 1003,
            "speakerName": "阿贝多",
            "text": "五歌仙的故事果然又出现了，而且还来了这么一个办法。",
            "nextDialogs": [
              "400570204"
            ]
          },
          "400570204": {
            "id": "400570204",
            "speakerId": 1003,
            "speakerName": "阿贝多",
            "text": "印章，嗯，让我想想…",
            "nextDialogs": [
              "400570205"
            ]
          },
          "400570205": {
            "id": "400570205",
            "speakerId": 1003,
            "speakerName": "阿贝多",
            "text": "确实是个高效率的方案，这样一来行秋就不用苦于字迹问题了。不过…",
            "nextDialogs": [
              "400570208"
            ]
          },
          "400570208": {
            "id": "400570208",
            "speakerId": 1003,
            "speakerName": "阿贝多",
            "text": "因为行秋的签名之前已经对读者公布过，如果这次的新刊上只有他使用印章，未免显得诚意不足。",
            "nextDialogs": [
              "400570209"
            ]
          },
          "400570209": {
            "id": "400570209",
            "speakerId": 1003,
            "speakerName": "阿贝多",
            "text": "我想到了另一个主意，当然印章也是其中一部分。我们现在就去乌有亭，和大家商量一下吧。"
          }
        }
      }
    },
    {
      "subId": "4005703",

        "dialogs": {}
      }
    },
    {
      "subId": "7719108",
      "subQuestName": "(test)隐藏$HIDDEN",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "771910801"
        ],
        "dialogs": {
          "771910801": {
            "id": "771910801",
            "speakerId": 1001,
            "speakerName": "Black Screen",
            "text": "阿布佐娃按照你的安排，分别询问客人们是否满足需要…",
            "nextDialogs": [
              "771910802"
            ]
          },
          "771910802": {
            "id": "771910802",
            "speakerId": 1001,
            "speakerName": "Black Screen",
            "text": "似乎所有客人们都很满意。",
            "nextDialogs": [
              "771910803"
            ]
          },
          "771910803": {
            "id": "771910803",
            "speakerId": 22633,
            "speakerName": "阿布佐娃",
            "text": "呼…成、成功了！",
            "nextDialogs": [
              "771910804"
            ]
          },
          "771910804": {
            "id": "771910804",
            "speakerId": 22633,
            "speakerName": "阿布佐娃",
            "text": "真是太感谢了，要是没有客人您，我都不知道要怎么办，没有客人不满意真是太好了。",
            "nextDialogs": [
              "771910807"
            ]
          },
          "771910807": {
            "id": "771910807",
            "speakerId": 22633,
            "speakerName": "阿布佐娃",
            "text": "嘿嘿，当然不会忘了客人您啦！",
            "nextDialogs": [
              "771910808"
            ]
          },
          "771910808": {
            "id": "771910808",
            "speakerId": 22633,
            "speakerName": "阿布佐娃",
            "text": "虽然不多，但是这些东西就交给您作为帮了我大忙的酬劳！",
            "nextDialogs": [
              "771910809"
            ]
          },
          "771910809": {
            "id": "771910809",
            "speakerId": 22633,
            "speakerName": "阿布佐娃",
            "text": "呜呜…第一次遇到了能帮忙解决麻烦而不是制造麻烦的客人…啊，也不是说其他客人都在制造麻烦的意思…"
          }
        }
      }
    },
    {
      "subId": "7719111",
      "subQuestName": "(test)隐藏$HIDDEN",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "771911101"
        ],
        "dialogs": {
          "771911101": {
            "id": "771911101",
            "speakerId": 22634,
            "speakerName": "科夏克娃",
            "text": "唉…真是的…我倒是和谁坐一桌都可以…",
            "nextDialogs": [
              "771911102"
            ]
          },
          "771911102": {
            "id": "771911102",
            "speakerId": 22634,
            "speakerName": "科夏克娃",
            "text": "可是我的妹妹，赫梅莉娃，却<color=#00E1FFFF>不让我和任何男性单独坐一桌</color>，但凡有这样的情况，她也非得要坐过来才行。",
            "nextDialogs": [
              "771911103"
            ]
          },
          "771911103": {
            "id": "771911103",
            "speakerId": 22634,
            "speakerName": "科夏克娃",
            "text": "真是奇怪，她从小到大都这样…不过…毕竟她这也是担心我。",
            "nextDialogs": [
              "771911106",
              "771911107"
            ]
          },
          "771911106": {
            "id": "771911106",
            "speakerId": 22634,
            "speakerName": "科夏克娃",
            "text": "嗯…之后就要等侍者来引导我们入座，对吧。哎…希望座位的安排能让赫梅莉娃满意吧。"
          },
          "771911107": {
            "id": "771911107",
            "speakerId": 22634,
            "speakerName": "科夏克娃",
            "text": "嗯…之后就要等侍者来引导我们入座，对吧。哎…希望座位的安排能让赫梅莉娃满意吧。"
          }
        }
      }
    },
    {
      "subId": "7719110",
      "subQuestName": "(test)隐藏$HIDDEN",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "771911001"
        ],
        "dialogs": {
          "771911001": {
            "id": "771911001",
            "speakerId": 22635,
            "speakerName": "兹拉托夫",
            "text": "呼…就没有人能够…能够管管墙上的裂隙吗？",
            "nextDialogs": [
              "771911002"
            ]
          },
          "771911002": {
            "id": "771911002",
            "speakerId": 22635,
            "speakerName": "兹拉托夫",
            "text": "真是的，这些馆里的雪孃，不知道裂隙有多可怕吗，要是有人从那些裂隙里看、看过来…怎么办？"
          }
        }
      }
    },
    {
      "subId": "7719112",
      "subQuestName": "(test)隐藏$HIDDEN",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "771910201"
        ],
        "dialogs": {
          "771910201": {
            "id": "771910201",
            "speakerId": 22635,
            "speakerName": "兹拉托夫",
            "text": "#啊…您是说，厢房里墙壁上的缝被堵上了吗…那可真是太好了，您真是位热心肠的{M#先生}{F#小姐}。",
            "nextDialogs": [
              "771910204",
              "771910205"
            ]
          },
          "771910204": {
            "id": "771910204",
            "speakerId": 22635,
            "speakerName": "兹拉托夫",
            "text": "之后，等待侍者来安排位置就好了吧，没有安排就无法入座，山中之馆的规矩我还是明白的。"
          },
          "771910205": {
            "id": "771910205",
            "speakerId": 22635,
            "speakerName": "兹拉托夫",
            "text": "之后，等待侍者来安排位置就好了吧，没有安排就无法入座，山中之馆的规矩我还是明白的。"
          }
        }
      }
    },
    {
      "subId": "7719103",
      "subQuestName": "(test)隐藏$HIDDEN",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "771910301"
        ],
        "dialogs": {
          "771910301": {
            "id": "771910301",
            "speakerId": 22636,
            "speakerName": "伊斯克琳娜",
            "text": "桌子的要求？我倒没有什么太大的要求，只要能<color=#00E1FFFF>坐在大厅里</color>就行，毕竟离吧台近嘛。",
            "nextDialogs": [
              "771910302"
            ]
          },
          "771910302": {
            "id": "771910302",
            "speakerId": 22636,
            "speakerName": "伊斯克琳娜",
            "text": "难得来赫斯珀利德斯之馆一趟，就让我在这里多喝一会儿吧…哼哼…",
            "nextDialogs": [
              "771910305",
              "771910306"
            ]
          },
          "771910305": {
            "id": "771910305",
            "speakerId": 22636,
            "speakerName": "伊斯克琳娜",
            "text": "好的，就让我等侍者的引导吧…呼呼，待会儿要喝什么酒呢…"
          },
          "771910306": {
            "id": "771910306",
            "speakerId": 22636,
            "speakerName": "伊斯克琳娜",
            "text": "好的，就让我等侍者的引导吧…呼呼，待会儿要喝什么酒呢…"
          }
        }
      }
    },
    {
      "subId": "7719104",
      "subQuestName": "(test)隐藏$HIDDEN",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "771910401"
        ],
        "dialogs": {
          "771910401": {
            "id": "771910401",
            "speakerId": 22637,
            "speakerName": "赫梅莉娃",
            "text": "哼，没想到雪孃王公制造的公馆居然用这么小的桌子…听说以前也流行过这种…",
            "nextDialogs": [
              "771910402"
            ]
          },
          "771910402": {
            "id": "771910402",
            "speakerId": 22637,
            "speakerName": "赫梅莉娃",
            "text": "不过现在已经不是什么「贵妇人在小桌边亲密交谈」的时代啦！这种桌子，能坐两个人就是极限…",
            "nextDialogs": [
              "771910403"
            ]
          },
          "771910403": {
            "id": "771910403",
            "speakerId": 22637,
            "speakerName": "赫梅莉娃",
            "text": "<color=#00E1FFFF>让我和其他两个人挤这样一张桌子？想也别想！</color>",
            "nextDialogs": [
              "771910406",
              "771910407"
            ]
          },
          "771910406": {
            "id": "771910406",
            "speakerId": 22637,
            "speakerName": "赫梅莉娃",
            "text": "要是待会儿那个侍者没能满足我的要求，我一定会向这边负责的雪精好好说说！"
          },
          "771910407": {
            "id": "771910407",
            "speakerId": 22637,
            "speakerName": "赫梅莉娃",
            "text": "要是待会儿那个侍者没能满足我的要求，我一定会向这边负责的雪精好好说说！"
          }
        }
      }
    },
    {

            "speakerId": 1001,
            "speakerName": "Black Screen",
            "text": "阿布佐娃按照你的安排，分别询问客人们是否满足需要…",
            "nextDialogs": [
              "771910502"
            ]
          },
          "771910502": {
            "id": "771910502",
            "speakerId": 1001,
            "speakerName": "Black Screen",
            "text": "但并非所有的客人都很满意…",
            "nextDialogs": [
              "771910503"
            ]
          },
          "771910503": {
            "id": "771910503",
            "speakerId": 22633,
            "speakerName": "阿布佐娃",
            "text": "呜…不对，好像还是不行…",
            "nextDialogs": [
              "771910504"
            ]
          },
          "771910504": {
            "id": "771910504",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "那我再想想办法吧…",
            "nextDialogs": [
              "771910505"
            ]
          },
          "771910505": {
            "id": "771910505",
            "speakerId": 22633,
            "speakerName": "阿布佐娃",
            "text": "交、交给您了…"
          }
        }
      }
    },
    {
      "subId": "7719113",
      "subQuestName": "(test)隐藏$HIDDEN",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "771911301"
        ],
        "dialogs": {
          "771911301": {
            "id": "771911301",
            "speakerId": 22636,
            "speakerName": "伊斯克琳娜",
            "text": "难得来赫斯珀利德斯之馆一趟，就让我在这里多喝一会儿吧…哼哼…",
            "nextDialogs": [
              "771911302"
            ]
          },
          "771911302": {
            "id": "771911302",
            "speakerId": 22636,
            "speakerName": "伊斯克琳娜",
            "text": "看看还有哪个家伙不自量力，敢和我比拼酒力…"
          }
        }
      }
    },
    {
      "subId": "7719114",
      "subQuestName": "(test)隐藏$HIDDEN",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "771911401"
        ],
        "dialogs": {
          "771911401": {
            "id": "771911401",
            "speakerId": 22634,
            "speakerName": "科夏克娃",
            "text": "妹妹…其实你没有必要…",
            "nextDialogs": [
              "771911402"
            ]
          },
          "771911402": {
            "id": "771911402",
            "speakerId": 22637,
            "speakerName": "赫梅莉娃",
            "text": "我这不都是担心你吗，姐姐…真是的，谁能想到帕芙琳娜大人的贵宾室连个单独的桌子都分不出来…",
            "nextDialogs": [
              "771911403"
            ]
          },
          "771911403": {
            "id": "771911403",
            "speakerId": 22637,
            "speakerName": "赫梅莉娃",
            "text": "更何况，一想到纯洁的姐姐你要独自和一个男的坐在一起，我就感到浑身刺挠…",
            "nextDialogs": [
              "771911404"
            ]
          },
          "771911404": {
            "id": "771911404",
            "speakerId": 22634,
            "speakerName": "科夏克娃",
            "text": "唉…"
          }
        }
      }
    },
    {
      "subId": "7719107",
      "subQuestName": "(test)废弃$HIDDEN",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "771910701"
        ],
        "dialogs": {
          "771910701": {
            "id": "771910701",
            "speakerId": 22633,
            "speakerName": "阿布佐娃",
            "text": "怎么样，客人，您…安排好了吗？还是、再需要点时间？",
            "nextDialogs": [
              "771910703",
              "771910706"
            ]
          },
          "771910703": {
            "id": "771910703",
            "speakerId": 22633,
            "speakerName": "阿布佐娃",
            "text": "真、真的吗，我再去打探一下他们的想法…",
            "nextDialogs": [
              "771910704"
            ]
          },
          "771910704": {
            "id": "771910704",
            "speakerId": 22633,
            "speakerName": "阿布佐娃",
            "text": "还请在这里稍等！"
          },
          "771910706": {
            "id": "771910706",
            "speakerId": 22633,
            "speakerName": "阿布佐娃",
            "text": "好的，要是您安排好了，还请跟我说！"
          }
        }
      }
    },

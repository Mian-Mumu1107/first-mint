    {
      "subId": "7719109",
      "subQuestName": "(test)隐藏$HIDDEN",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "771910601"
        ],
        "dialogs": {
          "771910601": {
            "id": "771910601",
            "speakerId": 22635,
            "speakerName": "兹拉托夫",
            "text": "呼…怎么会这样…唉，我只想要进厢房休息一阵…",
            "nextDialogs": [
              "771910602"
            ]
          },
          "771910602": {
            "id": "771910602",
            "speakerId": 22635,
            "speakerName": "兹拉托夫",
            "text": "结果你看，那边的墙壁居然有个巨大的缝隙…怎么…这可怎么让人安心。",
            "nextDialogs": [
              "771910603"
            ]
          },
          "771910603": {
            "id": "771910603",
            "speakerId": 22635,
            "speakerName": "兹拉托夫",
            "text": "结果我去问那个雪孃，她说：「人手不足，暂时没法修缮」…要是有人在我休息的时候，透过那个缝隙…",
            "nextDialogs": [
              "771910604"
            ]
          },
          "771910604": {
            "id": "771910604",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "只要挡住不就行了？",
            "nextDialogs": [
              "771910605"
            ]
          },
          "771910605": {
            "id": "771910605",
            "speakerId": 22635,
            "speakerName": "兹拉托夫",
            "text": "挡住？呃…",
            "nextDialogs": [
              "771910606"
            ]
          },
          "771910606": {
            "id": "771910606",
            "speakerId": 22635,
            "speakerName": "兹拉托夫",
            "text": "倒也不是不行，如果有什么东西可以挡住那个缝隙就好啦！"
          }
        }
      }
    },

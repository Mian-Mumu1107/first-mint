  "subQuests": [
    {
      "subId": "7719101",
      "subQuestName": "服务员请求帮忙分桌$HIDDEN",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "771910101"
        ],
        "dialogs": {
          "771910101": {
            "id": "771910101",
            "speakerId": 22633,
            "speakerName": "阿布佐娃",
            "text": "真是的…这该如何是好，有没有人能帮帮忙呢…",
            "nextDialogs": [
              "771910103",
              "771910125"
            ]
          },
          "771910103": {
            "id": "771910103",
            "speakerId": 22633,
            "speakerName": "阿布佐娃",
            "text": "嗯…是这样，帕芙琳娜大人举办婚礼，许多从前不常来赫斯珀利德斯之馆的雪精们也纷至沓来。",
            "nextDialogs": [
              "771910104"
            ]
          },
          "771910104": {
            "id": "771910104",
            "speakerId": 22633,
            "speakerName": "阿布佐娃",
            "text": "…啊，我也不是说客人多不好哦，这当然是好事，不过您看，现在常备的位置就不是很够了。",
            "nextDialogs": [
              "771910105"
            ]
          },
          "771910105": {
            "id": "771910105",
            "speakerId": 22633,
            "speakerName": "阿布佐娃",
            "text": "现在还只剩下两个空桌，但是却有四个客人…",
            "nextDialogs": [
              "771910106"
            ]
          },
          "771910106": {
            "id": "771910106",
            "speakerId": 22633,
            "speakerName": "阿布佐娃",
            "text": "能够进贵宾室的都是了不起的大人物，要是随意安排，惹恼了他们…我、我可怎么办啊？"
          },
          "771910125": {
            "id": "771910125",
            "speakerId": 22633,
            "speakerName": "阿布佐娃",
            "text": "好、好的，客人…"
          }
        }
      }
    },
    {
      "subId": "7719120",

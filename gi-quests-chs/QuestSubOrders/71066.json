    },
    {
      "subId": "7106601",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "710660101"
        ],
        "dialogs": {
          "710660101": {
            "id": "710660101",
            "speakerId": 2154,
            "speakerName": "塔列辛",
            "text": "唉…奇怪，奇怪，真是奇哉怪也…",
            "nextDialogs": [
              "710660102"
            ]
          },
          "710660102": {
            "id": "710660102",
            "speakerId": 2154,
            "speakerName": "塔列辛",
            "text": "应该还在的才对…可是怎么也找不到了…",
            "nextDialogs": [
              "710660103"
            ]
          },
          "710660103": {
            "id": "710660103",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "发生什么事了？",
            "nextDialogs": [
              "710660104"
            ]
          },
          "710660104": {
            "id": "710660104",
            "speakerId": 2154,
            "speakerName": "塔列辛",
            "text": "我的戒指…不见了。那枚戒指对我来说很重要，如果丢在这里可不行啊…",
            "nextDialogs": [
              "710660105"
            ]
          },
          "710660105": {
            "id": "710660105",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "你的戒指是什么样子的？",
            "nextDialogs": [
              "710660106"
            ]
          },
          "710660106": {
            "id": "710660106",
            "speakerId": 2154,
            "speakerName": "塔列辛",
            "text": "戒圈是黄铜的，上面镶嵌了一枚漂亮的红色宝石…",
            "nextDialogs": [
              "710660107"
            ]
          },
          "710660107": {
            "id": "710660107",
            "speakerId": 2154,
            "speakerName": "塔列辛",
            "text": "我是在传说中魔龙杜林陨落之地旁边的熔岩池拾到它的，这应当能解释为何它会有阴燃的黑暗火焰光泽…",
            "nextDialogs": [
              "710660108"
            ]
          },
          "710660108": {
            "id": "710660108",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "哇……",
            "nextDialogs": [
              "710660109"
            ]
          },
          "710660109": {
            "id": "710660109",
            "speakerId": 2154,
            "speakerName": "塔列辛",
            "text": "传说它的主人一旦戴上它，就会受到「深渊之大君」的凝视，被它的黑暗大军追杀…",
            "nextDialogs": [
              "710660110"
            ]
          },
          "710660110": {
            "id": "710660110",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "哦！"
          }
        }
      }
    },
    {
      "subId": "7106605",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "710660501"
        ],
        "dialogs": {
          "710660501": {
            "id": "710660501",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "龙脊雪山没什么熔岩池。"
          }
        }
      }
    },
    {
      "subId": "7106608",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "710660801"
        ],
        "dialogs": {
          "710660801": {
            "id": "710660801",
            "speakerId": 2617,
            "speakerName": "克里托夫",
            "text": "你好，最近发生什么事情了吗？",
            "nextDialogs": [
              "710660802"
            ]
          },
          "710660802": {
            "id": "710660802",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "关于盗宝鼬…",
            "nextDialogs": [
              "710660803"
            ]
          },
          "710660803": {
            "id": "710660803",
            "speakerId": 2617,
            "speakerName": "克里托夫",
            "text": "哦哦，你是说层岩巨渊的盗宝鼬吧？哈哈…原本是归我管的，结果被我搞砸了…没什么好说的啦。",
            "nextDialogs": [
              "710660804"
            ]
          },
          "710660804": {
            "id": "710660804",
            "speakerId": 2617,
            "speakerName": "克里托夫",
            "text": "嗯…哦，让我把它们再抓起来是不太可能啦…毕竟这些小家伙神出鬼没，实在难以追踪…",
            "nextDialogs": [
              "710660805"
            ]
          },
          "710660805": {
            "id": "710660805",
            "speakerId": 2617,
            "speakerName": "克里托夫",
            "text": "不过呀，如果有谁的东西被那些坏家伙偷掉的话，我能提供一点小小的提示。",
            "nextDialogs": [
              "710660806"
            ]
          },
          "710660806": {
            "id": "710660806",
            "speakerId": 2617,
            "speakerName": "克里托夫",
            "text": "盗宝团训练饲养盗宝鼬，都会在固定的时间进行喂食。其中有三种不同的盗宝鼬…",
            "nextDialogs": [
              "710660807"
            ]
          },
          "710660807": {
            "id": "710660807",
            "speakerId": 2617,
            "speakerName": "克里托夫",
            "text": "最厉害的「大黄金盗宝鼬」…然后呢，是比较常见的「藏金盗宝鼬」，还有笨笨的「新手盗宝鼬」，不过出现的时间…",
            "nextDialogs": [
              "710660808"
            ]
          },
          "710660808": {
            "id": "710660808",
            "speakerId": 2617,
            "speakerName": "克里托夫",
            "text": "哎…应该是有一本训练手册的，时间上面都写了，谁还特意去记那些东西，应该就在盗宝鼬出没地附近的营地里吧。",
            "nextDialogs": [
              "710660809"
            ]
          },
          "710660809": {
            "id": "710660809",
            "speakerId": 2617,
            "speakerName": "克里托夫",
            "text": "啊…我差点忘记了！想要唤来它们的话，就请吹口哨吧。",
            "nextDialogs": [
              "710660810"
            ]
          },
          "710660810": {
            "id": "710660810",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "吹口哨？",
            "nextDialogs": [
              "710660811"
            ]
          },
          "710660811": {
            "id": "710660811",
            "speakerId": 2617,
            "speakerName": "克里托夫",
            "text": "嗯，普通的口哨就好，不需要太花哨，重要的是时机啦。"
          }
        }
      }
    }
  ]
}
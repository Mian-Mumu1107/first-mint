    {
      "subId": "7050502",
      "subQuestName": "为迪卢克调制指定饮品",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "705050201"
        ],
        "dialogs": {
          "705050201": {
            "id": "705050201",
            "speakerId": 1009,
            "speakerName": "迪卢克",
            "text": "味道很不错。",
            "nextDialogs": [
              "705050202"
            ]
          },
          "705050202": {
            "id": "705050202",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "主要还是原材料好！只要水果新鲜，就算什么也不加都会很甜。",
            "nextDialogs": [
              "705050203"
            ]
          },
          "705050203": {
            "id": "705050203",
            "speakerId": 1009,
            "speakerName": "迪卢克",
            "text": "那就感谢蒙德的土地吧。",
            "nextDialogs": [
              "705050204"
            ]
          },
          "705050204": {
            "id": "705050204",
            "speakerId": 1009,
            "speakerName": "迪卢克",
            "text": "…苍谷落日，是我第一次调出的饮品。",
            "nextDialogs": [
              "705050205"
            ]
          },
          "705050205": {
            "id": "705050205",
            "speakerId": 1009,
            "speakerName": "迪卢克",
            "text": "那时还小，父亲摆出了几种材料，让我自己动手尝试。",
            "nextDialogs": [
              "705050206"
            ]
          },
          "705050206": {
            "id": "705050206",
            "speakerId": 1009,
            "speakerName": "迪卢克",
            "text": "没有要求，也没有提示，多半是为了看我的灵性吧。",
            "nextDialogs": [
              "705050207"
            ]
          },
          "705050207": {
            "id": "705050207",
            "speakerId": 1009,
            "speakerName": "迪卢克",
            "text": "最后我做出的，就是这样一杯果汁。",
            "nextDialogs": [
              "705050208"
            ]
          },
          "705050208": {
            "id": "705050208",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "欸，为、为什么…",
            "nextDialogs": [
              "705050209"
            ]
          },
          "705050209": {
            "id": "705050209",
            "speakerId": 1009,
            "speakerName": "迪卢克",
            "text": "父亲也很诧异。但当时的我并未考虑其他因素，只知道果汁很甜。",
            "nextDialogs": [
              "705050210"
            ]
          },
          "705050210": {
            "id": "705050210",
            "speakerId": 1009,
            "speakerName": "迪卢克",
            "text": "现在想来，那是多么幼稚又短浅的认知啊…",
            "nextDialogs": [
              "705050211"
            ]
          },
          "705050211": {
            "id": "705050211",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "我不这么认为。",
            "nextDialogs": [
              "705050212"
            ]
          },
          "705050212": {
            "id": "705050212",
            "speakerId": 1009,
            "speakerName": "迪卢克",
            "text": "……",
            "nextDialogs": [
              "705050215"
            ]
          },
          "705050215": {
            "id": "705050215",
            "speakerId": 1009,
            "speakerName": "迪卢克",
            "text": "我没有那样想过…毕竟，当时父亲什么都没说。",
            "nextDialogs": [
              "705050216"
            ]
          },
          "705050216": {
            "id": "705050216",
            "speakerId": 1009,
            "speakerName": "迪卢克",
            "text": "不过，谢谢你。",
            "nextDialogs": [
              "705050217"
            ]
          },
          "705050217": {
            "id": "705050217",
            "speakerId": 1009,
            "speakerName": "迪卢克",
            "text": "另外，有件东西想给你。",
            "nextDialogs": [
              "705050218"
            ]
          },
          "705050218": {
            "id": "705050218",
            "speakerId": 1009,
            "speakerName": "迪卢克",
            "text": "…等你对酒保工作有更多体验之后，再交给你比较好。以你的能力，一定能出色地完成这份工作。",
            "nextDialogs": [
              "705050219"
            ]
          },
          "705050219": {
            "id": "705050219",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "我也会…帮忙打气！",
            "nextDialogs": [
              "705050220"
            ]
          },
          "705050220": {
            "id": "705050220",
            "speakerId": 1009,
            "speakerName": "迪卢克",
            "text": "嗯，期待你们的成果。那我就先告辞了。",
            "nextDialogs": [
              "705050221"
            ]
          },
          "705050221": {
            "id": "705050221",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "有空再来哦！"
          }
        }
      }
    },

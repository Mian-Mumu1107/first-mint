  "subQuests": [
    {
      "subId": "7050501",
      "subQuestName": "与卢卡对话，进入酒馆",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "705050101"
        ],
        "dialogs": {
          "705050101": {
            "id": "705050101",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "迪卢克老爷！真难得！是今天刚好闲着没事干吗？",
            "nextDialogs": [
              "705050102"
            ]
          },
          "705050102": {
            "id": "705050102",
            "speakerId": 1009,
            "speakerName": "迪卢克",
            "text": "什么叫闲着没事干。我收到了你们兼任酒保的消息，过来看看而已。",
            "nextDialogs": [
              "705050103"
            ]
          },
          "705050103": {
            "id": "705050103",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "哇，情报太灵通了！",
            "nextDialogs": [
              "705050104"
            ]
          },
          "705050104": {
            "id": "705050104",
            "speakerId": 1009,
            "speakerName": "迪卢克",
            "text": "#所以，{NICKNAME}，当酒保的体验如何？",
            "nextDialogs": [
              "705050105"
            ]
          },
          "705050105": {
            "id": "705050105",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "才刚开始…",
            "nextDialogs": [
              "705050106"
            ]
          },
          "705050106": {
            "id": "705050106",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "是啊，迪卢克老爷问得太早啦，我们开张还没多久呢。",
            "nextDialogs": [
              "705050107"
            ]
          },
          "705050107": {
            "id": "705050107",
            "speakerId": 1009,
            "speakerName": "迪卢克",
            "text": "只是想问问第一感觉。",
            "nextDialogs": [
              "705050108"
            ]
          },
          "705050108": {
            "id": "705050108",
            "speakerId": 1009,
            "speakerName": "迪卢克",
            "text": "兴奋吗？还是困扰？有什么感受，直说就好。",
            "nextDialogs": [
              "705050111"
            ]
          },
          "705050111": {
            "id": "705050111",
            "speakerId": 1009,
            "speakerName": "迪卢克",
            "text": "原来如此。",
            "nextDialogs": [
              "705050112"
            ]
          },
          "705050112": {
            "id": "705050112",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "不、不问问我吗？",
            "nextDialogs": [
              "705050113"
            ]
          },
          "705050113": {
            "id": "705050113",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "我的第一感觉是…好喝！",
            "nextDialogs": [
              "705050114"
            ]
          },
          "705050114": {
            "id": "705050114",
            "speakerId": 1009,
            "speakerName": "迪卢克",
            "text": "……",
            "nextDialogs": [
              "705050115"
            ]
          },
          "705050115": {
            "id": "705050115",
            "speakerId": 1009,
            "speakerName": "迪卢克",
            "text": "那就好，为你高兴。",
            "nextDialogs": [
              "705050116"
            ]
          },
          "705050116": {
            "id": "705050116",
            "speakerId": 1009,
            "speakerName": "迪卢克",
            "text": "能请你帮我调一杯苍谷落日吗？杯量随意。",
            "nextDialogs": [
              "705050117"
            ]
          },
          "705050117": {
            "id": "705050117",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "明白了，请稍等片刻。",
            "nextDialogs": [
              "705050118"
            ]
          },
          "705050118": {
            "id": "705050118",
            "speakerId": 1009,
            "speakerName": "迪卢克",
            "text": "嗯，不用着急。"
          }
        }
      }
    },

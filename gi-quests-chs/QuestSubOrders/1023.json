    {
      "subId": "102303",
      "subQuestName": "(test)黄金屋对话$HIDDEN",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "10230301"
        ],
        "dialogs": {
          "10230301": {
            "id": "10230301",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "哇啊——这里就是<color=#00E1FFFF>「黄金屋」</color>？",
            "nextDialogs": [
              "10230302"
            ]
          },
          "10230302": {
            "id": "10230302",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "外面看起来就已经很气派了，没想到里面更加豪华！而且…而且满地都是摩拉！！！",
            "nextDialogs": [
              "10230303"
            ]
          },
          "10230303": {
            "id": "10230303",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "既然整个提瓦特的摩拉，都是在这里造出来的，那…是不是多一点少一点，都很不容易被发现？",
            "nextDialogs": [
              "10230306"
            ]
          },
          "10230306": {
            "id": "10230306",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "原来是诱饵式陷阱，好险好险！幸亏有你提醒！",
            "nextDialogs": [
              "10230307"
            ]
          },
          "10230307": {
            "id": "10230307",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "但就算不能拿，近距离看看应该没问题吧？",
            "nextDialogs": [
              "10230308"
            ]
          },
          "10230308": {
            "id": "10230308",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "可以的话，我还想躺在里面睡一觉！用摩拉当被子，做梦也会更香，嘿嘿嘿…"
          }
        }
      }
    },
    {
      "subId": "102302",
      "subQuestName": "调查仙祖法蜕",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "10230201"
        ],
        "dialogs": {
          "10230201": {
            "id": "10230201",
            "speakerId": 1001,
            "speakerName": "？？？",
            "text": "作为「引路人」，你们的使命明明已经完成，为什么还要来自找麻烦呢？",
            "nextDialogs": [
              "10230202"
            ]
          },
          "10230202": {
            "id": "10230202",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "嗯？是谁！",
            "nextDialogs": [
              "10230203"
            ]
          },
          "10230203": {
            "id": "10230203",
            "speakerId": 1002,
            "speakerName": "「公子」",
            "text": "如果你们是「愚人众」，或许能够拿到一笔来自女皇的丰厚奖赏。",
            "nextDialogs": [
              "10230204"
            ]
          },
          "10230204": {
            "id": "10230204",
            "speakerId": 1002,
            "speakerName": "「公子」",
            "text": "但可惜现在，就只是毫无价值的碍事者而已。",
            "nextDialogs": [
              "10230206",
              "10230209"
            ]
          },
          "10230206": {
            "id": "10230206",
            "speakerId": 1002,
            "speakerName": "「公子」",
            "text": "该从何说起呢？本来绕远路也不是我的风格，但谁知道一到璃月，岩之神就离奇死亡，「仙祖法蜕」还被藏了起来。",
            "nextDialogs": [
              "10230207"
            ]
          },
          "10230207": {
            "id": "10230207",
            "speakerId": 1002,
            "speakerName": "「公子」",
            "text": "要不是借你们筹办「送仙典仪」的机会，得到了一些消息，只怕会更加麻烦。",
            "nextDialogs": [
              "10230211"
            ]
          },
          "10230211": {
            "id": "10230211",
            "speakerId": 1002,
            "speakerName": "「公子」",
            "text": "嘿…不惜停止摩拉的铸造，也要隐藏「仙祖法蜕」…七星还真是下了血本呢。",
            "nextDialogs": [
              "10230212"
            ]
          },
          "10230212": {
            "id": "10230212",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "原、原来你真的是想要在「仙祖法蜕」里找出「神之心」？",
            "nextDialogs": [
              "10230213"
            ]
          },
          "10230213": {
            "id": "10230213",
            "speakerId": 1002,
            "speakerName": "「公子」",
            "text": "作为愚人众的十一执行官，必须贯彻冰之女皇的意旨。",
            "nextDialogs": [
              "10230214"
            ]
          },
          "10230214": {
            "id": "10230214",
            "speakerId": 1002,
            "speakerName": "「公子」",
            "text": "女皇想要，我们就来取。"
          },
          "10230209": {
            "id": "10230209",
            "speakerId": 1002,
            "speakerName": "「公子」",
            "text": "虽然感谢你们让我没怎么费工夫，就找到了这藏匿之所…",
            "nextDialogs": [
              "10230210"
            ]
          },
          "10230210": {
            "id": "10230210",
            "speakerId": 1002,
            "speakerName": "「公子」",
            "text": "但现在想要阻止我？还是别白费力气了。"
          }
        }
      }
    },
    {
      "subId": "102304",
      "subQuestName": "与「公子」作战",
      "sceneId": null,
      "locations": [],

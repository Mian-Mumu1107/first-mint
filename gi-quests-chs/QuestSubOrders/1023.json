    {
      "subId": "102305",
      "subQuestName": "(test)BOSS战后接剧情对话$HIDDEN",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "10230501"
        ],
        "dialogs": {
          "10230501": {
            "id": "10230501",
            "speakerId": 1002,
            "speakerName": "「公子」",
            "text": "呼…",
            "nextDialogs": [
              "10230502"
            ]
          },
          "10230502": {
            "id": "10230502",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "啊，他变回了原来的样子。",
            "nextDialogs": [
              "10230546"
            ]
          },
          "10230546": {
            "id": "10230546",
            "speakerId": 1002,
            "speakerName": "「公子」",
            "text": "也该…冷静下来了。",
            "nextDialogs": [
              "10230503"
            ]
          },
          "10230503": {
            "id": "10230503",
            "speakerId": 1002,
            "speakerName": "「公子」",
            "text": "刚才那身「魔王武装」，对身体的负担果然很大，让我没机会停下来思考…",
            "nextDialogs": [
              "10230504"
            ]
          },
          "10230504": {
            "id": "10230504",
            "speakerId": 1002,
            "speakerName": "「公子」",
            "text": "但仔细一想，你们确实没有比我抢先一步得到「神之心」的可能性。",
            "nextDialogs": [
              "10230505"
            ]
          },
          "10230505": {
            "id": "10230505",
            "speakerId": 1002,
            "speakerName": "「公子」",
            "text": "无论「神之心」去了哪里…都应该与你们无关吧。",
            "nextDialogs": [
              "10230506"
            ]
          },
          "10230506": {
            "id": "10230506",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "是啊，都说了不是我们拿的！",
            "nextDialogs": [
              "10230507"
            ]
          },
          "10230507": {
            "id": "10230507",
            "speakerId": 1002,
            "speakerName": "「公子」",
            "text": "旅者，你今天展现出的实力，比「女士」在蒙德对你的评价更强，这是为什么呢？",
            "nextDialogs": [
              "10230510"
            ]
          },
          "10230510": {
            "id": "10230510",
            "speakerId": 1002,
            "speakerName": "「公子」",
            "text": "看你的样子，心里好像是有答案的？",
            "nextDialogs": [
              "10230511"
            ]
          },
          "10230511": {
            "id": "10230511",
            "speakerId": 1002,
            "speakerName": "「公子」",
            "text": "唉，但如果是不能对我说的秘密，那我也只能勉强压抑一下自己的好奇心啦。",
            "nextDialogs": [
              "10230512"
            ]
          },
          "10230512": {
            "id": "10230512",
            "speakerId": 1002,
            "speakerName": "「公子」",
            "text": "有这场战斗，我已经很满足了。",
            "nextDialogs": [
              "10230513"
            ]
          },
          "10230513": {
            "id": "10230513",
            "speakerId": 1002,
            "speakerName": "「公子」",
            "text": "同样追求变强的人，都是朋友，尽管这种友谊的形式，只能是互相争斗…",
            "nextDialogs": [
              "10230514"
            ]
          },
          "10230514": {
            "id": "10230514",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "真是奇怪的朋友观。",
            "nextDialogs": [
              "10230515"
            ]
          },
          "10230515": {
            "id": "10230515",
            "speakerId": 1002,
            "speakerName": "「公子」",
            "text": "但现在，也不得不暂时搁置知己间的交流，回到我的任务中去了。",
            "nextDialogs": [
              "10230516"
            ]
          },
          "10230516": {
            "id": "10230516",
            "speakerId": 1002,
            "speakerName": "「公子」",
            "text": "——既然「神之心」不是被人拿走，那会不会是…从一开始，就不在「仙祖法蜕」里呢？",
            "nextDialogs": [
              "10230517"
            ]
          },
          "10230517": {
            "id": "10230517",
            "speakerId": 1002,
            "speakerName": "「公子」",
            "text": "更进一步地想，「仙祖法蜕」本身，会不会也只是一种障眼法？",
            "nextDialogs": [
              "10230518"
            ]
          },
          "10230518": {
            "id": "10230518",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "啊，你是想说…"
          }
        }
      }
    },
    {
      "subId": "102306",
      "subQuestName": "(test)剧情对话后接CS$HIDDEN",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "10230601"
        ],
        "dialogs": {
          "10230601": {
            "id": "10230601",
            "speakerId": 1002,
            "speakerName": "「公子」",
            "text": "拭目以待吧，失去神明的国度，会不会被远古的恶意重新吞没？"
          }
        }
      }
    },

    {
      "subId": "2006904",
      "subQuestName": "在山洞附近放置包裹",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "200690401"
        ],
        "dialogs": {
          "200690401": {
            "id": "200690401",
            "speakerId": 1000,
            "speakerName": "芙萝拉",
            "text": "花怎么样啦？",
            "nextDialogs": [
              "200690402"
            ]
          },
          "200690402": {
            "id": "200690402",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "对不起…",
            "nextDialogs": [
              "200690403"
            ]
          },
          "200690403": {
            "id": "200690403",
            "speakerId": 1000,
            "speakerName": "芙萝拉",
            "text": "嗯？怎么了？",
            "nextDialogs": [
              "200690404"
            ]
          },
          "200690404": {
            "id": "200690404",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "我不小心把盒子和花弄坏了…",
            "nextDialogs": [
              "200690405"
            ]
          },
          "200690405": {
            "id": "200690405",
            "speakerId": 1000,
            "speakerName": "芙萝拉",
            "text": "弄、弄坏了？！",
            "nextDialogs": [
              "200690406"
            ]
          },
          "200690406": {
            "id": "200690406",
            "speakerId": 1000,
            "speakerName": "芙萝拉",
            "text": "呜…那可是我专门挑出来的花，那么好的花，可不是能轻易找到的…",
            "nextDialogs": [
              "200690407"
            ]
          },
          "200690407": {
            "id": "200690407",
            "speakerId": 1000,
            "speakerName": "芙萝拉",
            "text": "雪山真有这么危险吗？连你这样的冒险家都会失手，连一盒花都…",
            "nextDialogs": [
              "200690408"
            ]
          },
          "200690408": {
            "id": "200690408",
            "speakerId": 1000,
            "speakerName": "芙萝拉",
            "text": "不过，还是谢谢你帮我跑这一趟，这些东西给你，请收下吧，我要去打理店里的花了。",
            "nextDialogs": [
              "200690409"
            ]
          },
          "200690409": {
            "id": "200690409",
            "speakerId": 1000,
            "speakerName": "芙萝拉",
            "text": "唉，不然…我还是再用莎拉小姐的办法试试吧…"
          }
        }
      }
    },

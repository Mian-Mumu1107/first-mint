  },
  "subQuests": [
    {
      "subId": "1012101",
      "subQuestName": "前往教堂前的广场",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "101210101"
        ],
        "dialogs": {
          "101210101": {
            "id": "101210101",
            "speakerId": 1029,
            "speakerName": "优菈",
            "text": "你们终于来了，那么事不宜迟，我们就开始上第一堂礼仪课…",
            "nextDialogs": [
              "101210102"
            ]
          },
          "101210102": {
            "id": "101210102",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "等下，等下，我们还是想先问清楚，不然放心不下来！",
            "nextDialogs": [
              "101210105"
            ]
          },
          "101210105": {
            "id": "101210105",
            "speakerId": 1029,
            "speakerName": "优菈",
            "text": "原来你们还在惦记这件事，说不定你们比我还记仇呢。",
            "nextDialogs": [
              "101210106"
            ]
          },
          "101210106": {
            "id": "101210106",
            "speakerId": 1029,
            "speakerName": "优菈",
            "text": "放心，记仇是记仇，报仇是报仇。现在不是报仇的心情，所以就先记在心里。",
            "nextDialogs": [
              "101210107"
            ]
          },
          "101210107": {
            "id": "101210107",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "报仇，居然要看心情…",
            "nextDialogs": [
              "101210108"
            ]
          },
          "101210108": {
            "id": "101210108",
            "speakerId": 1029,
            "speakerName": "优菈",
            "text": "我记下来的仇，早就在心里堆了厚厚一摞。就算要复仇，也得讲究一个先来后到吧。",
            "nextDialogs": [
              "101210109"
            ]
          },
          "101210109": {
            "id": "101210109",
            "speakerId": 1029,
            "speakerName": "优菈",
            "text": "真的轮到你们的时候，都不知道过了多久。",
            "nextDialogs": [
              "101210110"
            ]
          },
          "101210110": {
            "id": "101210110",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "那既然都堆了这么多了，之前我们的冒犯，不如一笔勾销？",
            "nextDialogs": [
              "101210111"
            ]
          },
          "101210111": {
            "id": "101210111",
            "speakerId": 1029,
            "speakerName": "优菈",
            "text": "那可不行，你想得美。抢我功劳，把我当坏人，怀疑我的叔父，哪件事不值得记仇？"
          }
        }
      }
    },
    {
      "subId": "1012102",
      "subQuestName": "与优菈交谈",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [],
        "dialogs": {}
      }
    },
    {
      "subId": "1012103",
      "subQuestName": "与市民交谈，旁观优菈的示范",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "101210201"
        ],
        "dialogs": {
          "101210201": {
            "id": "101210201",
            "speakerId": 10387,
            "speakerName": "诺曼",
            "text": "你是…劳伦斯家的优菈吧？总觉得没什么好事…",
            "nextDialogs": [
              "101210202"
            ]
          },
          "101210202": {
            "id": "101210202",
            "speakerId": 1029,
            "speakerName": "优菈",
            "text": "咳咳…劳碌之人，何不稍停片刻？可知尊贵的劳伦斯一族亲临此地，有要事相告。",
            "nextDialogs": [
              "101210203"
            ]
          },
          "101210203": {
            "id": "101210203",
            "speakerId": 1029,
            "speakerName": "优菈",
            "text": "请以郑重的跪礼，嗯…然后是什么来着？哦，对，与最大的诚意接受贵族赠予的荣光。",
            "nextDialogs": [
              "101210205"
            ]
          },
          "101210205": {
            "id": "101210205",
            "speakerId": 10387,
            "speakerName": "诺曼",
            "text": "突然说什么没头没尾的话？",
            "nextDialogs": [
              "101210206"
            ]
          },
          "101210206": {
            "id": "101210206",
            "speakerId": 1029,
            "speakerName": "优菈",
            "text": "…欸，等等，家训的话，这里应该怎么表现…",
            "nextDialogs": [
              "101210207"
            ]
          },
          "101210207": {
            "id": "101210207",
            "speakerId": 1029,
            "speakerName": "优菈",
            "text": "「产生争执时，应将捍卫家族的威名与尊严放在首位。」",
            "nextDialogs": [
              "101210208"
            ]
          },
          "101210208": {
            "id": "101210208",
            "speakerId": 1029,
            "speakerName": "优菈",
            "text": "明白了。咳咳，你身为平民，终日蒙受恩惠而生，理应毕恭毕敬，怎能如此出言不逊？",
            "nextDialogs": [
              "101210209"
            ]
          },
          "101210209": {
            "id": "101210209",
            "speakerId": 10387,
            "speakerName": "诺曼",
            "text": "唉，劳伦斯家族的人都这么古怪吗…",
            "nextDialogs": [
              "101210210"
            ]
          },
          "101210210": {
            "id": "101210210",
            "speakerId": 10387,
            "speakerName": "诺曼",
            "text": "劳伦斯横行霸道的时代早就过去了，我不管你想干什么，快走吧。",
            "nextDialogs": [
              "101210213"
            ]
          },
          "101210213": {
            "id": "101210213",
            "speakerId": 10387,
            "speakerName": "诺曼",
            "text": "但是我也说了，你们在做什么我都不想管，对劳伦斯家族的人，我无话可说。",
            "nextDialogs": [
              "101210214"
            ]
          },
          "101210214": {
            "id": "101210214",
            "speakerId": 10387,
            "speakerName": "诺曼",
            "text": "也给你一个忠告，在蒙德，不要和劳伦斯家族的人走得太近。",
            "nextDialogs": [
              "101210215"
            ]
          },
          "101210215": {
            "id": "101210215",
            "speakerId": 10387,
            "speakerName": "诺曼",
            "text": "没其他事的话，我就先走了。再说下去，我怕克制不住。",
            "nextDialogs": [
              "101210216"
            ]
          },
          "101210216": {
            "id": "101210216",
            "speakerId": 1029,
            "speakerName": "优菈",
            "text": "喂，喂！别走啊！可恶，你等着，这个仇我记下了！",
            "nextDialogs": [
              "101210217"
            ]
          },
          "101210217": {
            "id": "101210217",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "只是因为劳伦斯的名字，不至于吧…",
            "nextDialogs": [
              "101210218"
            ]
          },
          "101210218": {
            "id": "101210218",
            "speakerId": 1029,
            "speakerName": "优菈",
            "text": "没事没事，这情况我早就想到了，走吧，我们换个人试一试。"
          }
        }
      }
    },
    {
      "subId": "1012104",
      "subQuestName": "继续找市民交谈",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "101210301"
        ],
        "dialogs": {
          "101210301": {
            "id": "101210301",
            "speakerId": 1029,
            "speakerName": "优菈",
            "text": "咳咳，困顿之人，你当明晓尊贵的劳伦斯一族亲临此地，乃是有要事相告。",
            "nextDialogs": [
              "101210302"
            ]
          },
          "101210302": {
            "id": "101210302",
            "speakerId": 1029,
            "speakerName": "优菈",
            "text": "请以郑重的跪礼与最大的诚意，接受贵族赠予的荣光。",
            "nextDialogs": [
              "101210303"
            ]
          },
          "101210303": {
            "id": "101210303",
            "speakerId": 10388,
            "speakerName": "莱诺",
            "text": "……",
            "nextDialogs": [
              "101210304"
            ]
          },
          "101210304": {
            "id": "101210304",
            "speakerId": 1029,
            "speakerName": "优菈",
            "text": "唔，为什么没反应？礼仪规范里说了要等对方单膝跪地，挺直上身之后，以俯视的姿态说接下来的话。",
            "nextDialogs": [
              "101210305"
            ]
          },
          "101210305": {
            "id": "101210305",
            "speakerId": 1029,
            "speakerName": "优菈",
            "text": "哦，对了，视线不可以在对方身上停留太长时间，进一步凸显地位差距…糟了，好像我已经看了很久了。",
            "nextDialogs": [
              "101210306"
            ]
          },
          "101210306": {
            "id": "101210306",
            "speakerId": 10388,
            "speakerName": "莱诺",
            "text": "……",
            "nextDialogs": [
              "101210307"
            ]
          },
          "101210307": {
            "id": "101210307",
            "speakerId": 1029,
            "speakerName": "优菈",
            "text": "行吧，感觉不跪也没关系，可能有点不方便。那我直接说下去了，哦，等等，这里好像可以说一句无礼之人…",
            "nextDialogs": [
              "101210308"
            ]
          },
          "101210308": {
            "id": "101210308",
            "speakerId": 10388,
            "speakerName": "莱诺",
            "text": "别再吵我了，需要我说更过分的话吗？",
            "nextDialogs": [
              "101210309"
            ]
          },
          "101210309": {
            "id": "101210309",
            "speakerId": 10388,
            "speakerName": "莱诺",
            "text": "我和劳伦斯家的人没什么好说的。",
            "nextDialogs": [
              "101210310"
            ]
          },
          "101210310": {
            "id": "101210310",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "欸，又是这种态度吗？",
            "nextDialogs": [
              "101210313"
            ]
          },
          "101210313": {
            "id": "101210313",
            "speakerId": 1029,
            "speakerName": "优菈",
            "text": "也对，他看起来态度很坚决。唱独角戏的话效果应该不会好，我们还是再换个人吧。",
            "nextDialogs": [
              "101210314"
            ]
          },
          "101210314": {
            "id": "101210314",
            "speakerId": 1029,
            "speakerName": "优菈",
            "text": "啊，不过你不愿意搭理我这件事，我记仇了，等着吧！"
          }
        }
      }
    },
    {
      "subId": "1012105",
      "subQuestName": "继续找市民交谈",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "101210401"
        ],
        "dialogs": {
          "101210401": {
            "id": "101210401",
            "speakerId": 1029,
            "speakerName": "优菈",
            "text": "勤苦之人…",
            "nextDialogs": [
              "101210402"
            ]
          },
          "101210402": {
            "id": "101210402",
            "speakerId": 10389,
            "speakerName": "兰道尔",
            "text": "行了行了，我都听到了，不用白费工夫了，我们的答案都是一样的，无话可说。",
            "nextDialogs": [
              "101210403"
            ]
          },
          "101210403": {
            "id": "101210403",
            "speakerId": 10389,
            "speakerName": "兰道尔",
            "text": "真是的，明明都是这样的气氛了，还不明白吗…",
            "nextDialogs": [
              "101210404"
            ]
          },
          "101210404": {
            "id": "101210404",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "你先冷静一下，我们没有恶意。",
            "nextDialogs": [
              "101210405"
            ]
          },
          "101210405": {
            "id": "101210405",
            "speakerId": 10389,
            "speakerName": "兰道尔",
            "text": "唉，虽然我知道她是西风骑士，骑士团应该是不会看走眼的，但「劳伦斯」这个名字，就是一块治不好的伤疤。",
            "nextDialogs": [
              "101210406"
            ]
          },
          "101210406": {
            "id": "101210406",
            "speakerId": 10389,
            "speakerName": "兰道尔",
            "text": "又有谁不知道，直到今天，劳伦斯家族的后裔还在盘算重新占领蒙德，将旧贵族的制度带回来呢？",
            "nextDialogs": [
              "101210407"
            ]
          },
          "101210407": {
            "id": "101210407",
            "speakerId": 10389,
            "speakerName": "兰道尔",
            "text": "不避讳就算了，还故意用家族那别扭的说话方式装模作样。我会觉得，这是不在乎我们普通人的感受。",
            "nextDialogs": [
              "101210408"
            ]
          },
          "101210408": {
            "id": "101210408",
            "speakerId": 1029,
            "speakerName": "优菈",
            "text": "你说的很有道理。",
            "nextDialogs": [
              "101210409"
            ]
          },
          "101210409": {
            "id": "101210409",
            "speakerId": 1029,
            "speakerName": "优菈",
            "text": "但是，这个仇，我还是记下了！",
            "nextDialogs": [
              "101210410"
            ]
          },
          "101210410": {
            "id": "101210410",
            "speakerId": 10389,
            "speakerName": "兰道尔",
            "text": "干、干嘛？要动手？听着啊，我打是打不过你，但我可以找骑士团告状！",
            "nextDialogs": [
              "101210413"
            ]
          },
          "101210413": {
            "id": "101210413",
            "speakerId": 10389,
            "speakerName": "兰道尔",
            "text": "不好意思，但我希望她能理解我的态度。",
            "nextDialogs": [
              "101210414"
            ]
          },
          "101210414": {
            "id": "101210414",
            "speakerId": 10389,
            "speakerName": "兰道尔",
            "text": "劝你们一句，不想经历更多不愉快的话，就趁早停下来吧。",
            "nextDialogs": [
              "101210415"
            ]
          },
          "101210415": {
            "id": "101210415",
            "speakerId": 1029,
            "speakerName": "优菈",
            "text": "算了，既然这样，就先不跟他计较了，我们走。",
            "nextDialogs": [
              "101210416"
            ]
          },
          "101210416": {
            "id": "101210416",
            "speakerId": 10389,
            "speakerName": "兰道尔",
            "text": "唉…",
            "nextDialogs": [
              "101210417"
            ]
          },
          "101210417": {
            "id": "101210417",
            "speakerId": 1029,
            "speakerName": "优菈",
            "text": "没关系，这很正常，我们再换个人。",
            "nextDialogs": [
              "101210418"
            ]
          },
          "101210418": {
            "id": "101210418",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "等等，我觉得已经够了！先停一停吧！",
            "nextDialogs": [
              "101210419"
            ]
          },
          "101210419": {
            "id": "101210419",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "我觉得我应该道歉，不该让你去示范的。我不知道大家对劳伦斯家族有这么大的意见…",
            "nextDialogs": [
              "101210420"
            ]
          },
          "101210420": {
            "id": "101210420",
            "speakerId": 1029,
            "speakerName": "优菈",
            "text": "哈哈，没办法，毕竟是家喻户晓的坏人，三岁的小孩子都知道那段故事，会对我态度不好也很正常。"
          }
        }
      }
    },
    {
      "subId": "1012106",
      "subQuestName": "前往雪山，进行仪态训练",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "101210601"
        ],
        "dialogs": {
          "101210601": {
            "id": "101210601",
            "speakerId": 1029,
            "speakerName": "优菈",
            "text": "不错嘛，比我预想中要好太多了。",
            "nextDialogs": [
              "101210602"
            ]
          },
          "101210602": {
            "id": "101210602",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "呼，呼，我差点就被打中了…幸好没有拖后腿。",
            "nextDialogs": [
              "101210603"
            ]
          },
          "101210603": {
            "id": "101210603",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "这样我们就是合格的贵族了？",
            "nextDialogs": [
              "101210604"
            ]
          },
          "101210604": {
            "id": "101210604",
            "speakerId": 1029,
            "speakerName": "优菈",
            "text": "那可没有，这才刚刚开始呢。",
            "nextDialogs": [
              "101210605"
            ]
          },
          "101210605": {
            "id": "101210605",
            "speakerId": 1029,
            "speakerName": "优菈",
            "text": "刚刚我们经历的，还是比较简单的情况。在实战中，很难有停下来分析的机会。",
            "nextDialogs": [
              "101210606"
            ]
          },
          "101210606": {
            "id": "101210606",
            "speakerId": 1029,
            "speakerName": "优菈",
            "text": "在前方有一块地脉镇石，会将魔物吸引过来。",
            "nextDialogs": [
              "101210607"
            ]
          },
          "101210607": {
            "id": "101210607",
            "speakerId": 1029,
            "speakerName": "优菈",
            "text": "在激烈的战斗中冷静迅速地判断形势，这样才能做到真正的优雅。",
            "nextDialogs": [
              "101210610"
            ]
          },
          "101210610": {
            "id": "101210610",
            "speakerId": 1029,
            "speakerName": "优菈",
            "text": "因为小时候家里人的要求很高嘛。",
            "nextDialogs": [
              "101210611"
            ]
          },
          "101210611": {
            "id": "101210611",
            "speakerId": 1029,
            "speakerName": "优菈",
            "text": "好了，我们一起过去吧。"
          }
        }
      }
    },
    {
      "subId": "1012107",
      "subQuestName": "与优菈交谈，了解训练内容",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "101210501"
        ],
        "dialogs": {
          "101210501": {
            "id": "101210501",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "好、好冷，贵族的训练这么严苛吗？",
            "nextDialogs": [
              "101210502"
            ]
          },
          "101210502": {
            "id": "101210502",
            "speakerId": 1029,
            "speakerName": "优菈",
            "text": "想要拥有贵族的仪态，就要学会保持自身的优雅，无论是多么恶劣的外部环境，都是这样。",
            "nextDialogs": [
              "101210503"
            ]
          },
          "101210503": {
            "id": "101210503",
            "speakerId": 1029,
            "speakerName": "优菈",
            "text": "比如从这里看过去，你能看到有一段很难走的山路对吧。",
            "nextDialogs": [
              "101210504"
            ]
          },
          "101210504": {
            "id": "101210504",
            "speakerId": 1029,
            "speakerName": "优菈",
            "text": "但如果是一位教养良好的贵族，就能轻松通过，片叶不沾身，全程保持优雅。",
            "nextDialogs": [
              "101210505"
            ]
          },
          "101210505": {
            "id": "101210505",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "这已经不是贵族，是经验丰富的冒险家了吧…",
            "nextDialogs": [
              "101210506"
            ]
          },
          "101210506": {
            "id": "101210506",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "#不过在这方面，{NICKNAME}，你的经验应该比学贵族说话要丰富？",
            "nextDialogs": [
              "101210508",
              "101210510"
            ]
          },
          "101210508": {
            "id": "101210508",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "嗯嗯，冒险的经验可以活用在这里了呢。",
            "nextDialogs": [
              "101210511"
            ]
          },
          "101210511": {
            "id": "101210511",
            "speakerId": 1029,
            "speakerName": "优菈",
            "text": "哈哈，看来你们很有信心嘛。",
            "nextDialogs": [
              "101210512"
            ]
          },
          "101210512": {
            "id": "101210512",
            "speakerId": 1029,
            "speakerName": "优菈",
            "text": "那我们开始吧，记住，要保持优雅，可不要被炸飞或者打飞了，那样就太难看了。"
          },
          "101210510": {
            "id": "101210510",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "我也是这么想的，应该会很顺利吧！"
          }
        }
      }
    },

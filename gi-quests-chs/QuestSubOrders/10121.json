    {
      "subId": "1012120",
      "subQuestName": "从莎拉处取得「酱菜煎肉」",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "101210901"
        ],
        "dialogs": {
          "101210901": {
            "id": "101210901",
            "speakerId": 1419,
            "speakerName": "莎拉",
            "text": "来，「酱菜煎肉」已经打包好了，要趁热吃才能保证口感哦。",
            "nextDialogs": [
              "101210902"
            ]
          },
          "101210902": {
            "id": "101210902",
            "speakerId": 1419,
            "speakerName": "莎拉",
            "text": "如果优菈对你们说了什么奇怪的话，别往心里去。其实她是个很善良的人。",
            "nextDialogs": [
              "101210903"
            ]
          },
          "101210903": {
            "id": "101210903",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "其实我刚刚就想问了，之前优菈去找蒙德城里的普通人说话，大家都很不待见她的样子。",
            "nextDialogs": [
              "101210904"
            ]
          },
          "101210904": {
            "id": "101210904",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "但是刚刚看她和安柏，还有和你，好像关系又很好…",
            "nextDialogs": [
              "101210905"
            ]
          },
          "101210905": {
            "id": "101210905",
            "speakerId": 1419,
            "speakerName": "莎拉",
            "text": "劳伦斯这个姓氏，对蒙德人来说太沉重了。",
            "nextDialogs": [
              "101210906"
            ]
          },
          "101210906": {
            "id": "101210906",
            "speakerId": 1419,
            "speakerName": "莎拉",
            "text": "一旦背上了这个姓氏，大家就只能看得见「劳伦斯」，而看不见「优菈」了。",
            "nextDialogs": [
              "101210907"
            ]
          },
          "101210907": {
            "id": "101210907",
            "speakerId": 1419,
            "speakerName": "莎拉",
            "text": "那么「优菈」无论想做什么，都是有罪的，无论做了什么，都是没有意义的。",
            "nextDialogs": [
              "101210910"
            ]
          },
          "101210910": {
            "id": "101210910",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "那为什么你对优菈，有不同的看法呢？",
            "nextDialogs": [
              "101210911"
            ]
          },
          "101210911": {
            "id": "101210911",
            "speakerId": 1419,
            "speakerName": "莎拉",
            "text": "因为，她在加入西风骑士团的时候，引起了非常大的轰动。",
            "nextDialogs": [
              "101210912"
            ]
          },
          "101210912": {
            "id": "101210912",
            "speakerId": 1419,
            "speakerName": "莎拉",
            "text": "很多人写了联名信，强烈要求骑士团撤回让她入团的决定。",
            "nextDialogs": [
              "101210913"
            ]
          },
          "101210913": {
            "id": "101210913",
            "speakerId": 1419,
            "speakerName": "莎拉",
            "text": "另一方面，劳伦斯家族也来了很多人，在骑士团总部门口闹事，要求优菈出面给一个说法。",
            "nextDialogs": [
              "101210914"
            ]
          },
          "101210914": {
            "id": "101210914",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "哇，两边都不讨好呢。",
            "nextDialogs": [
              "101210915"
            ]
          },
          "101210915": {
            "id": "101210915",
            "speakerId": 1419,
            "speakerName": "莎拉",
            "text": "是的，可以想象那时候优菈究竟下了多大的决心。",
            "nextDialogs": [
              "101210916"
            ]
          },
          "101210916": {
            "id": "101210916",
            "speakerId": 1419,
            "speakerName": "莎拉",
            "text": "幸好大团长法尔伽，还有骑士团其他人的态度足够坚决，才把这种矛盾压了下去。但也只是压到了暗处，并没有被解决。",
            "nextDialogs": [
              "101210917"
            ]
          },
          "101210917": {
            "id": "101210917",
            "speakerId": 1419,
            "speakerName": "莎拉",
            "text": "在普通民众眼里，她是骑士团的污点，在劳伦斯家里的人眼里，她是家门不幸。",
            "nextDialogs": [
              "101210918"
            ]
          },
          "101210918": {
            "id": "101210918",
            "speakerId": 1419,
            "speakerName": "莎拉",
            "text": "可她只是默默履行着骑士的责任，默默地帮助一个又一个的人，我就是其中之一。",
            "nextDialogs": [
              "101210919"
            ]
          },
          "101210919": {
            "id": "101210919",
            "speakerId": 1419,
            "speakerName": "莎拉",
            "text": "我觉得这样的人，是应该被理解与照顾的。至少，也应该享受一点点公正的待遇吧。"
          }
        }
      }
    },
    {
      "subId": "1012099",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "101209907"
        ],
        "dialogs": {
          "101209907": {
            "id": "101209907",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "记仇归记仇，她又不像是在生气，真是搞不懂…",
            "nextDialogs": [
              "101209908"
            ]
          },
          "101209908": {
            "id": "101209908",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "唉，不过我们遇到过的怪人，也不少了。"
          }
        }
      }
    },
    {
      "subId": "1012112",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "101211201"
        ],
        "dialogs": {
          "101211201": {
            "id": "101211201",
            "speakerId": 1029,
            "speakerName": "优菈",
            "text": "加油，记得不要被炸飞或者打飞了，那样就不优雅了。"
          }
        }
      }
    },
    {
      "subId": "1012199",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "101219901"
        ],
        "dialogs": {
          "101219901": {
            "id": "101219901",
            "speakerId": 1029,
            "speakerName": "优菈",
            "text": "这样可不行，露出了破绽。",
            "nextDialogs": [
              "101219902"
            ]
          },
          "101219902": {
            "id": "101219902",
            "speakerId": 1029,
            "speakerName": "优菈",
            "text": "没关系，我们回到起点，重新准备一下。",
            "nextDialogs": [
              "101219903"
            ]
          },
          "101219903": {
            "id": "101219903",
            "speakerId": 1029,
            "speakerName": "优菈",
            "text": "就是这个地脉镇石，启动它吧。",
            "nextDialogs": [
              "101219904"
            ]
          },
          "101219904": {
            "id": "101219904",
            "speakerId": 1029,
            "speakerName": "优菈",
            "text": "小心不要被击飞或冻结，不然就太不优雅了。",
            "nextDialogs": [
              "101219905"
            ]
          },
          "101219905": {
            "id": "101219905",
            "speakerId": 1029,
            "speakerName": "优菈",
            "text": "这样可不行，露出了破绽。",
            "nextDialogs": [
              "101219906"
            ]
          },
          "101219906": {
            "id": "101219906",
            "speakerId": 1029,
            "speakerName": "优菈",
            "text": "没关系，我们回到起点，重新准备一下。",
            "nextDialogs": [
              "101219907"
            ]
          },
          "101219907": {
            "id": "101219907",
            "speakerId": 1029,
            "speakerName": "优菈",
            "text": "可惜，失败了。",
            "nextDialogs": [
              "101219908"
            ]
          },
          "101219908": {
            "id": "101219908",
            "speakerId": 1029,
            "speakerName": "优菈",
            "text": "没关系，放轻松，训练而已。我们再试一次吧。"
          }
        }
      }
    }
  ]
}
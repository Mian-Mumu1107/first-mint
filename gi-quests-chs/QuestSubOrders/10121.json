    {
      "subId": "1012118",
      "subQuestName": "播放开车$HIDDEN",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "101211801"
        ],
        "dialogs": {
          "101211801": {
            "id": "101211801",
            "speakerId": 10389,
            "speakerName": "兰道尔",
            "text": "看来你们终于不打算再去找其他人了…",
            "nextDialogs": [
              "101211802"
            ]
          },
          "101211802": {
            "id": "101211802",
            "speakerId": 10389,
            "speakerName": "兰道尔",
            "text": "这是最明智的，对大家都好。"
          }
        }
      }
    },
    {
      "subId": "1012110",
      "subQuestName": "前往训练地，启动地脉镇石",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "101211001"
        ],
        "dialogs": {
          "101211001": {
            "id": "101211001",
            "speakerId": 10388,
            "speakerName": "莱诺",
            "text": "搞不懂这个人怎么想的，你们还是离她远点比较好。"
          }
        }
      }
    },
    {
      "subId": "1012111",
      "subQuestName": "击败敌人，避免被击飞或冻结",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "101211101"
        ],
        "dialogs": {
          "101211101": {
            "id": "101211101",
            "speakerId": 1029,
            "speakerName": "优菈",
            "text": "刚开始是会比较难，保持耐心，我们再试一次。",
            "nextDialogs": [
              "101211102"
            ]
          },
          "101211102": {
            "id": "101211102",
            "speakerId": 1029,
            "speakerName": "优菈",
            "text": "记住，要保持优雅，可不要被炸飞或者打飞了。"
          }
        }
      }
    },
    {
      "subId": "1012112",
      "subQuestName": "与优菈交谈",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "101210701"
        ],
        "dialogs": {
          "101210701": {
            "id": "101210701",
            "speakerId": 1029,
            "speakerName": "优菈",
            "text": "好极了，我都没想到你的表现会这么优秀。",
            "nextDialogs": [
              "101210702"
            ]
          },
          "101210702": {
            "id": "101210702",
            "speakerId": 1029,
            "speakerName": "优菈",
            "text": "就连在雪山这种环境下也能动静自若，哈哈，可能我都做不到你这么好呢。",
            "nextDialogs": [
              "101210703"
            ]
          },
          "101210703": {
            "id": "101210703",
            "speakerId": 1029,
            "speakerName": "优菈",
            "text": "这样的话，感觉我都不需要多教些什么了。",
            "nextDialogs": [
              "101210704"
            ]
          },
          "101210704": {
            "id": "101210704",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "#早就说了，{PLAYERAVATAR#SEXPRO[INFO_MALE_PRONOUN_HE|INFO_FEMALE_PRONOUN_SHE]}在冒险方面是很擅长的。",
            "nextDialogs": [
              "101210705"
            ]
          },
          "101210705": {
            "id": "101210705",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "嘿嘿，这下我们就通过了对吧。那我们快离开雪山吧，我快要冻僵了。",
            "nextDialogs": [
              "101210706"
            ]
          },
          "101210706": {
            "id": "101210706",
            "speakerId": 1029,
            "speakerName": "优菈",
            "text": "#别急，我刚刚夸奖的是{PLAYERAVATAR#SEXPRO[INFO_MALE_PRONOUN_HE|INFO_FEMALE_PRONOUN_SHE]}，但是你的表现，完全没有长进！",
            "nextDialogs": [
              "101210707"
            ]
          },
          "101210707": {
            "id": "101210707",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "我也是被训练对象吗？！",
            "nextDialogs": [
              "101210708"
            ]
          },
          "101210708": {
            "id": "101210708",
            "speakerId": 1029,
            "speakerName": "优菈",
            "text": "是啊，训练的时候你慌慌张张的，到处乱飘，要不然就是晃来晃去，一点都不优雅。",
            "nextDialogs": [
              "101210709"
            ]
          },
          "101210709": {
            "id": "101210709",
            "speakerId": 1029,
            "speakerName": "优菈",
            "text": "你是不是没有把我教你的东西听进去啊？",
            "nextDialogs": [
              "101210711",
              "101210713"
            ]
          },
          "101210711": {
            "id": "101210711",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "#对对对，还有，我的注意力都在{PLAYERAVATAR#SEXPRO[INFO_MALE_PRONOUN_HE|INFO_FEMALE_PRONOUN_SHE]}身上啊。",
            "nextDialogs": [
              "101210714"
            ]
          },
          "101210714": {
            "id": "101210714",
            "speakerId": 1029,
            "speakerName": "优菈",
            "text": "不管是什么理由，把我的话当耳旁风，这个仇我记下了。",
            "nextDialogs": [
              "101210715"
            ]
          },
          "101210715": {
            "id": "101210715",
            "speakerId": 1029,
            "speakerName": "优菈",
            "text": "唉，真是的，这个给你，把它喝了。",
            "nextDialogs": [
              "101210716"
            ]
          },
          "101210716": {
            "id": "101210716",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "这是什么？你要对我下毒吗？！",
            "nextDialogs": [
              "101210717"
            ]
          },
          "101210717": {
            "id": "101210717",
            "speakerId": 1029,
            "speakerName": "优菈",
            "text": "不是啦，是热牛奶。",
            "nextDialogs": [
              "101210718"
            ]
          },
          "101210718": {
            "id": "101210718",
            "speakerId": 1029,
            "speakerName": "优菈",
            "text": "你说你快要冻僵了，那就喝点热热的牛奶，暖暖身子吧。",
            "nextDialogs": [
              "101210719"
            ]
          },
          "101210719": {
            "id": "101210719",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "哦哦，谢谢你！可是…你刚才还说记仇…",
            "nextDialogs": [
              "101210720"
            ]
          },
          "101210720": {
            "id": "101210720",
            "speakerId": 1029,
            "speakerName": "优菈",
            "text": "若不是记了你的仇，我才不管你冷不冷呢。要是在我复仇之前，你就冻成冰块了，我不就没法复仇了吗？",
            "nextDialogs": [
              "101210721"
            ]
          },
          "101210721": {
            "id": "101210721",
            "speakerId": 1029,
            "speakerName": "优菈",
            "text": "所以，小家伙，别死哦。",
            "nextDialogs": [
              "101210722"
            ]
          },
          "101210722": {
            "id": "101210722",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "咦——！果然你这个人怪怪的！"
          },
          "101210713": {
            "id": "101210713",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "才不是呢，我把注意力都放在你身上了！"
          }
        }
      }
    },
    {
      "subId": "1012113",
      "subQuestName": "前往「猎鹿人」准备见面礼",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [],
        "dialogs": {}
      }
    },
    {
      "subId": "1012114",
      "subQuestName": "与优菈和安柏交谈",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "101210801"
        ],
        "dialogs": {
          "101210801": {
            "id": "101210801",
            "speakerId": 1002,
            "speakerName": "安柏",
            "text": "是优菈，还有荣誉骑士！你们好啊！",
            "nextDialogs": [
              "101210802"
            ]
          },
          "101210802": {
            "id": "101210802",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "又见面了，安柏，我们真是有缘啊。",
            "nextDialogs": [
              "101210803"
            ]
          },
          "101210803": {
            "id": "101210803",
            "speakerId": 1002,
            "speakerName": "安柏",
            "text": "嘿嘿，我刚刚从城外回来，正想来猎鹿人吃顿饭。既然你们来了，一起吧一起吧！",
            "nextDialogs": [
              "101210804"
            ]
          },
          "101210804": {
            "id": "101210804",
            "speakerId": 1029,
            "speakerName": "优菈",
            "text": "好啊，已经有一段时间没有和你一起吃饭了。",
            "nextDialogs": [
              "101210805"
            ]
          },
          "101210805": {
            "id": "101210805",
            "speakerId": 1029,
            "speakerName": "优菈",
            "text": "来来来，你们也坐吧。见面礼的事，我们边吃边说。",
            "nextDialogs": [
              "101210806"
            ]
          },
          "101210806": {
            "id": "101210806",
            "speakerId": 1419,
            "speakerName": "莎拉",
            "text": "请问要加什么菜吗？",
            "nextDialogs": [
              "101210807"
            ]
          },
          "101210807": {
            "id": "101210807",
            "speakerId": 1029,
            "speakerName": "优菈",
            "text": "我叔父很喜欢的那一道「酱菜煎肉」，麻烦你做一份然后打包吧，等会儿要给他送过去。",
            "nextDialogs": [
              "101210808"
            ]
          },
          "101210808": {
            "id": "101210808",
            "speakerId": 1419,
            "speakerName": "莎拉",
            "text": "好的，知道了。不过要从头开始准备需要花点时间，等会儿来柜台找我拿吧。",
            "nextDialogs": [
              "101210809"
            ]
          },
          "101210809": {
            "id": "101210809",
            "speakerId": 1029,
            "speakerName": "优菈",
            "text": "等等，先别走，这道「满足沙拉」也是安柏之前点的吗？",
            "nextDialogs": [
              "101210810"
            ]
          },
          "101210810": {
            "id": "101210810",
            "speakerId": 1419,
            "speakerName": "莎拉",
            "text": "哦，不是的，因为看她没点什么素菜，我就送了一份小菜，可以解解腻。",
            "nextDialogs": [
              "101210811"
            ]
          },
          "101210811": {
            "id": "101210811",
            "speakerId": 1029,
            "speakerName": "优菈",
            "text": "明明没有点，你却要擅自送，哼，这个仇我记下来了。",
            "nextDialogs": [
              "101210812"
            ]
          },
          "101210812": {
            "id": "101210812",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "这也是要记仇的事吗？！",
            "nextDialogs": [
              "101210813"
            ]
          },
          "101210813": {
            "id": "101210813",
            "speakerId": 1419,
            "speakerName": "莎拉",
            "text": "你又不是第一天认识我，我就是这种大恶人啊。",
            "nextDialogs": [
              "101210814"
            ]
          },
          "101210814": {
            "id": "101210814",
            "speakerId": 1419,
            "speakerName": "莎拉",
            "text": "好啦，你们慢慢聊，我去准备「酱菜煎肉」了。",
            "nextDialogs": [
              "101210815"
            ]
          },
          "101210815": {
            "id": "101210815",
            "speakerId": 1029,
            "speakerName": "优菈",
            "text": "唉，莎拉这家伙，一定要找机会跟她算清这笔账。",
            "nextDialogs": [
              "101210816"
            ]
          },
          "101210816": {
            "id": "101210816",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "不过，为什么要选「酱菜煎肉」当见面礼呢？我都没听过这道菜…",
            "nextDialogs": [
              "101210817"
            ]
          },
          "101210817": {
            "id": "101210817",
            "speakerId": 1029,
            "speakerName": "优菈",
            "text": "因为那是猎鹿人的隐藏菜品，只有我叔父那样的老食客才知道这道菜，很符合旧贵族的口味。",
            "nextDialogs": [
              "101210818"
            ]
          },
          "101210818": {
            "id": "101210818",
            "speakerId": 1002,
            "speakerName": "安柏",
            "text": "但因为酱菜有股酸酸的味道，有很多人都不喜欢，所以渐渐就没人愿意点这道菜了。",
            "nextDialogs": [
              "101210819"
            ]
          },
          "101210819": {
            "id": "101210819",
            "speakerId": 1002,
            "speakerName": "安柏",
            "text": "优菈请我吃过一次，我差点连一口都咽不下去。后来我就叫它「复仇煎肉」了。",
            "nextDialogs": [
              "101210820"
            ]
          },
          "101210820": {
            "id": "101210820",
            "speakerId": 1029,
            "speakerName": "优菈",
            "text": "没想到你的口味和我差这么多嘛。不过，一不小心就报了仇，还是很开心的。",
            "nextDialogs": [
              "101210821"
            ]
          },
          "101210821": {
            "id": "101210821",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "你也记安柏的仇吗？",
            "nextDialogs": [
              "101210822"
            ]
          },
          "101210822": {
            "id": "101210822",
            "speakerId": 1029,
            "speakerName": "优菈",
            "text": "那是当然，像她这么招人恨的小姑娘，蒙德城里都找不出几个呢。",
            "nextDialogs": [
              "101210823"
            ]
          },
          "101210823": {
            "id": "101210823",
            "speakerId": 1002,
            "speakerName": "安柏",
            "text": "平时开玩笑没问题，别在荣誉骑士面前这么说啦，会被误会的。",
            "nextDialogs": [
              "101210824"
            ]
          },
          "101210824": {
            "id": "101210824",
            "speakerId": 1002,
            "speakerName": "安柏",
            "text": "优菈平时虽然把「记仇」挂在嘴边，但这只是她的生活方式而已，其实不会往心里去的。",
            "nextDialogs": [
              "101210825"
            ]
          },
          "101210825": {
            "id": "101210825",
            "speakerId": 1029,
            "speakerName": "优菈",
            "text": "会往心里去！会记得很清楚的！你这个人，确实很招人恨啊！",
            "nextDialogs": [
              "101210826"
            ]
          },
          "101210826": {
            "id": "101210826",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "我也发现了，优菈其实就是个很单纯的好人。",
            "nextDialogs": [
              "101210827"
            ]
          },
          "101210827": {
            "id": "101210827",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "想要表达好意的话，完全没必要这么别扭啊。",
            "nextDialogs": [
              "101210828"
            ]
          },
          "101210828": {
            "id": "101210828",
            "speakerId": 1029,
            "speakerName": "优菈",
            "text": "…唉，小家伙，你没像我这样被当成「罪人」吧？",
            "nextDialogs": [
              "101210829"
            ]
          },
          "101210829": {
            "id": "101210829",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "嗯，那倒是…",
            "nextDialogs": [
              "101210830"
            ]
          },
          "101210830": {
            "id": "101210830",
            "speakerId": 1029,
            "speakerName": "优菈",
            "text": "那你是不会知道，坏人想要当好人有多难的。我当不了好人，也没有要当好人的想法。",
            "nextDialogs": [
              "101210831"
            ]
          },
          "101210831": {
            "id": "101210831",
            "speakerId": 1029,
            "speakerName": "优菈",
            "text": "好啦，别突然严肃起来啊，我开玩笑的。快吃饭吧，不然饭菜就要凉了。",
            "nextDialogs": [
              "101210832"
            ]
          },
          "101210832": {
            "id": "101210832",
            "speakerId": 1002,
            "speakerName": "安柏",
            "text": "好饱好饱，我去找莎拉买单吧。",
            "nextDialogs": [
              "101210833"
            ]
          },
          "101210833": {
            "id": "101210833",
            "speakerId": 1029,
            "speakerName": "优菈",
            "text": "不用，摩拉我都留在盘子下面了。直接去付账的话，莎拉肯定不会收那一碟小菜的钱。",
            "nextDialogs": [
              "101210834"
            ]
          },
          "101210834": {
            "id": "101210834",
            "speakerId": 1029,
            "speakerName": "优菈",
            "text": "可别小看我复仇的技术，这种破绽是不会让莎拉抓到的，哼。",
            "nextDialogs": [
              "101210835"
            ]
          },
          "101210835": {
            "id": "101210835",
            "speakerId": 1029,
            "speakerName": "优菈",
            "text": "好了，接下来你们就自己去见我的叔父吧，他在清泉镇附近的山上有个小营地，一般没事他就会待在那里。",
            "nextDialogs": [
              "101210836"
            ]
          },
          "101210836": {
            "id": "101210836",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "欸？我以为优菈会跟我们一起去的。",
            "nextDialogs": [
              "101210837"
            ]
          },
          "101210837": {
            "id": "101210837",
            "speakerId": 1029,
            "speakerName": "优菈",
            "text": "这个，稍微有点不方便啦。没我在的话，你们应该会更顺利。",
            "nextDialogs": [
              "101210838"
            ]
          },
          "101210838": {
            "id": "101210838",
            "speakerId": 1029,
            "speakerName": "优菈",
            "text": "对了，不要忘记找莎拉拿上打包的菜哦。",
            "nextDialogs": [
              "101210839"
            ]
          },
          "101210839": {
            "id": "101210839",
            "speakerId": 1002,
            "speakerName": "安柏",
            "text": "我也要继续去野外调查了，下次再见！",
            "nextDialogs": [
              "101210840"
            ]
          },
          "101210840": {
            "id": "101210840",
            "speakerId": 1029,
            "speakerName": "优菈",
            "text": "有机会再见吧，你们真的很有意思。"
          }
        }
      }
    },

    {
      "subId": "7213101",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "721310101"
        ],
        "dialogs": {
          "721310101": {
            "id": "721310101",
            "speakerId": 1002,
            "speakerName": "观察",
            "text": "形状奇特的石灯，似乎放射着令人不安的能量。",
            "nextDialogs": [
              "721310102"
            ]
          },
          "721310102": {
            "id": "721310102",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "这是…石灯笼？为什么这里会有石灯笼呢？",
            "nextDialogs": [
              "721310103"
            ]
          },
          "721310103": {
            "id": "721310103",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "欸，灯柱上被人写了字，我们看看吧？",
            "nextDialogs": [
              "721310104"
            ]
          },
          "721310104": {
            "id": "721310104",
            "speakerId": 1002,
            "speakerName": "观察",
            "text": "「诸位工友，关于此镇物如有疑问，请至无想刃狭间，与梶先生商谈。」",
            "nextDialogs": [
              "721310105"
            ]
          },
          "721310105": {
            "id": "721310105",
            "speakerId": 1002,
            "speakerName": "观察",
            "text": "字迹看起来很新。下面还有几列粗犷的小字：",
            "nextDialogs": [
              "721310106"
            ]
          },
          "721310106": {
            "id": "721310106",
            "speakerId": 1002,
            "speakerName": "观察",
            "text": "「十分抱歉我们也帮不上什么忙，昨日刚刚接到天领奉行大人的紧急疏散令。」",
            "nextDialogs": [
              "721310107"
            ]
          },
          "721310107": {
            "id": "721310107",
            "speakerId": 1002,
            "speakerName": "观察",
            "text": "「希望有缘来日再见，共同商讨解决『祟神』作乱之事。」",
            "nextDialogs": [
              "721310108"
            ]
          },
          "721310108": {
            "id": "721310108",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "这个梶先生似乎对石灯笼很在意的样子，我们不如去无想刃狭间问问他吧？"
          }
        }
      }
    },
    {
      "subId": "7213103",

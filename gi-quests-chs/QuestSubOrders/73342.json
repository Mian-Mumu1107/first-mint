            ]
          },
          "733420207": {
            "id": "733420207",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "#我们就帮帮那位花灵吧，{NICKNAME}？",
            "nextDialogs": [
              "733420208"
            ]
          },
          "733420208": {
            "id": "733420208",
            "speakerId": 13210,
            "speakerName": "斯露莎",
            "text": "于我而言，这并不是什么难事，还能帮到瑟法娜。我的「谒颂主」，请你多多留意这样的「净觉花」吧。",

{
  "lineCounts": {
    "Player": 6,
    "伊莲": 28,
    "派蒙": 13
  },
  "subQuests": [
    {
      "subId": "7468001",
      "subQuestName": "与工作人员对话",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "746800101"
        ],
        "dialogs": {
          "746800101": {
            "id": "746800101",
            "speakerId": 30486,
            "speakerName": "伊莲",
            "text": "「千灵映影节」…你做的好呀！干得漂亮！",
            "nextDialogs": [
              "746800102"
            ]
          },
          "746800102": {
            "id": "746800102",
            "speakerId": 30486,
            "speakerName": "伊莲",
            "text": "这样一来，想在截止日期前完成项目，根本就是痴人说梦…",
            "nextDialogs": [
              "746800103"
            ]
          },
          "746800103": {
            "id": "746800103",
            "speakerId": 30486,
            "speakerName": "伊莲",
            "text": "呜呜呜…噫啊啊…这次老板不会痛骂我了…应该会直接干掉我吧！",
            "nextDialogs": [
              "746800104"
            ]
          },
          "746800104": {
            "id": "746800104",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "这位小姐怎么自顾自地哭起来了？",
            "nextDialogs": [
              "746800105"
            ]
          },
          "746800105": {
            "id": "746800105",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "我们需要帮她找位医生吗？不知道枫丹有没有专门治疗心情的医生？",
            "nextDialogs": [
              "746800106"
            ]
          },
          "746800106": {
            "id": "746800106",
            "speakerId": 30486,
            "speakerName": "伊莲",
            "text": "唔姆…你们什么时候来的…",
            "nextDialogs": [
              "746800107"
            ]
          },
          "746800107": {
            "id": "746800107",
            "speakerId": 30486,
            "speakerName": "伊莲",
            "text": "谢谢两位的关心，现在我更需要…能复活我即将死亡的职业生涯的医生。",
            "nextDialogs": [
              "746800108"
            ]
          },
          "746800108": {
            "id": "746800108",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "这应该不属于医生的工作吧！",
            "nextDialogs": [
              "746800110",
              "746800112"
            ]
          },
          "746800110": {
            "id": "746800110",
            "speakerId": 30486,
            "speakerName": "伊莲",
            "text": "呀！换工作比死还折磨啊，所有熟悉的做事方法都不管用了，全都要重新学！",
            "nextDialogs": [
              "746800113"
            ]
          },
          "746800113": {
            "id": "746800113",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "这样聊下去也不是个办法，还是请你先说明一下吧，你现在遇见了什么困难？",
            "nextDialogs": [
              "746800114"
            ]
          },
          "746800114": {
            "id": "746800114",
            "speakerId": 30486,
            "speakerName": "伊莲",
            "text": "有点难，这可是技术问题，我想想该怎么总结…",
            "nextDialogs": [
              "746800115"
            ]
          },
          "746800115": {
            "id": "746800115",
            "speakerId": 30486,
            "speakerName": "伊莲",
            "text": "简单来说，我是「千灵映影节」器材供应商的工程师伊莲，主要负责开发摄影器材。",
            "nextDialogs": [
              "746800116"
            ]
          },
          "746800116": {
            "id": "746800116",
            "speakerId": 30486,
            "speakerName": "伊莲",
            "text": "为了追求映影的效果，我们的甲方提出，需要一种能够载着映影机快速移动的「稳像平台」…",
            "nextDialogs": [
              "746800117"
            ]
          },
          "746800117": {
            "id": "746800117",
            "speakerId": 30486,
            "speakerName": "伊莲",
            "text": "同时，这种「稳像平台」还需要搭载模仿演员的人偶或动物模型，扮演集群的远景。",
            "nextDialogs": [
              "746800118"
            ]
          },
          "746800118": {
            "id": "746800118",
            "speakerId": 30486,
            "speakerName": "伊莲",
            "text": "如此一来，他们就能在高速运动中稳定跟拍演员，或者省下雇佣大量演员的费用了。",
            "nextDialogs": [
              "746800119"
            ]
          },
          "746800119": {
            "id": "746800119",
            "speakerId": 30486,
            "speakerName": "伊莲",
            "text": "而且，他们要求每个平台的采购价，不能高于一台留影机的三分之一，使用寿命不能低于三十年。",
            "nextDialogs": [
              "746800120"
            ]
          },
          "746800120": {
            "id": "746800120",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "哪有这么提要求的！就算是超级厉害的工匠，也不可能做出又便宜好用又耐用的道具吧！",
            "nextDialogs": [
              "746800121"
            ]
          },
          "746800121": {
            "id": "746800121",
            "speakerId": 30486,
            "speakerName": "伊莲",
            "text": "我做完了。",
            "nextDialogs": [
              "746800122"
            ]
          },
          "746800122": {
            "id": "746800122",
            "speakerId": 30486,
            "speakerName": "伊莲",
            "text": "毕竟甲方是不可忤逆之人，以前甲方提过更过分的需求，我也豁出半条命满足了他们。",
            "nextDialogs": [
              "746800123"
            ]
          },
          "746800123": {
            "id": "746800123",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "……",
            "nextDialogs": [
              "746800124"
            ]
          },
          "746800124": {
            "id": "746800124",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "…那你在愁什么啦！",
            "nextDialogs": [
              "746800125"
            ]
          },
          "746800125": {
            "id": "746800125",
            "speakerId": 30486,
            "speakerName": "伊莲",
            "text": "问题是我没有测试员！好不容易做出了产品，不经过全面检测，项目就不算完成！",
            "nextDialogs": [
              "746800126"
            ]
          },
          "746800126": {
            "id": "746800126",
            "speakerId": 30486,
            "speakerName": "伊莲",
            "text": "稍微懂一点机关原理，或是体力足够好的测试员，都被「千灵映影节」雇佣去检查更重要的东西了…",
            "nextDialogs": [
              "746800127"
            ]
          },
          "746800127": {
            "id": "746800127",
            "speakerId": 30486,
            "speakerName": "伊莲",
            "text": "不经过测试的产品，交到甲方手里的话，要是被找出什么大问题，我还要倒赔钱，赔十倍！",
            "nextDialogs": [
              "746800128"
            ]
          },
          "746800128": {
            "id": "746800128",
            "speakerId": 30486,
            "speakerName": "伊莲",
            "text": "我只能在这里一边推销自家的产品，一边寻找外援…",
            "nextDialogs": [
              "746800129"
            ]
          },
          "746800129": {
            "id": "746800129",
            "speakerId": 30486,
            "speakerName": "伊莲",
            "text": "就算最后入不敷出也只能认了，毕竟和甲方的合同是老板签的，但要十倍赔钱的话，就是我个人来担责了。",
            "nextDialogs": [
              "746800130"
            ]
          },
          "746800130": {
            "id": "746800130",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "事已至此，先说说测试内容…",
            "nextDialogs": [
              "746800131"
            ]
          },
          "746800131": {
            "id": "746800131",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "#没错，如果不是特别困难的测试内容，说不定我和{NICKNAME}能替你做点简单的活。",
            "nextDialogs": [
              "746800132"
            ]
          },
          "746800132": {
            "id": "746800132",
            "speakerId": 30486,
            "speakerName": "伊莲",
            "text": "听起来没什么难点，实践起来可不容易——",
            "nextDialogs": [
              "746800133"
            ]
          },
          "746800133": {
            "id": "746800133",
            "speakerId": 30486,
            "speakerName": "伊莲",
            "text": "为了确认「稳像平台」在极限速度下的运转情况，我将它们调成了「避开一切接近者」的被动运动模式。",
            "nextDialogs": [
              "746800134"
            ]
          },
          "746800134": {
            "id": "746800134",
            "speakerId": 30486,
            "speakerName": "伊莲",
            "text": "测试员需要在特定场地内追逐「稳像平台」，尽可能在短时间内将更多平台驱赶至目标区域。",
            "nextDialogs": [
              "746800135"
            ]
          },
          "746800135": {
            "id": "746800135",
            "speakerId": 30486,
            "speakerName": "伊莲",
            "text": "像我这种体力差的人，稍微追着「稳像平台」跑两步，就完全没力气了…"
          },
          "746800112": {
            "id": "746800112",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "听她说得这么夸张，确实不能再袖手旁观了。"
          }
        }
      }
    }
  ]
}
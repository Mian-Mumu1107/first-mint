  "subQuests": [
    {
      "subId": "7605701",
      "subQuestName": "第二天对话$HIDDEN",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "760570101"
        ],
        "dialogs": {
          "760570101": {
            "id": "760570101",
            "speakerId": 21917,
            "speakerName": "瓦伊诺",
            "text": "下次再设计一下团队战好了？或许对战也是不错的主意？哦，是你们呀，欢迎来到训练场！",
            "nextDialogs": [
              "760570103",
              "760570106",
              "760570110"
            ]
          },
          "760570103": {
            "id": "760570103",
            "speakerId": 21917,
            "speakerName": "瓦伊诺",
            "text": "客人渐渐多了起来，这还是多亏了你们。当然，还有孩子们和「地隐会」的功劳！",
            "nextDialogs": [
              "760570104"
            ]
          },
          "760570104": {
            "id": "760570104",
            "speakerId": 21917,
            "speakerName": "瓦伊诺",
            "text": "我发现，训练场会是一个很适合聚会的地方。和多年不见的朋友突然相聚，一时会不知道该说些什么吧？"
          },
          "760570106": {
            "id": "760570106",
            "speakerId": 21917,
            "speakerName": "瓦伊诺",
            "text": "啊…暂时还没有找到比靶标更合适的鼹鼠窝垫材…",
            "nextDialogs": [
              "760570107"
            ]
          },
          "760570107": {
            "id": "760570107",
            "speakerId": 21917,
            "speakerName": "瓦伊诺",
            "text": "我和孩子们试了好几种材料了，它们就是特别中意靶标。目前为止还是只能去和它们交易换回来…",
            "nextDialogs": [
              "760570108"
            ]
          },
          "760570108": {
            "id": "760570108",
            "speakerId": 21917,
            "speakerName": "瓦伊诺",
            "text": "不过，我们也渐渐掌握了它们的宝物汇率，净赚不少。"
          },
          "760570110": {
            "id": "760570110",
            "speakerId": 21917,
            "speakerName": "瓦伊诺",
            "text": "嗯，请随时来！记得哦，只要是你们，永远免费！"
          }
        }
      }
    },
    {
      "subId": "7605702",

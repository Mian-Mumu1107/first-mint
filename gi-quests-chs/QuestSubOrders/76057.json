        "dialogs": {
          "760571901": {
            "id": "760571901",
            "speakerId": 21917,
            "speakerName": "瓦伊诺",
            "text": "多亏了你们！我会好好参考你们和茜斯柯小朋友的意见的。希望以后客人会越来越多！"

    },
    {
      "subId": "7609807",
      "subQuestName": "调查终端",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "760980701"
        ],
        "dialogs": {
          "760980701": {
            "id": "760980701",
            "speakerId": 1002,
            "speakerName": "避难所主控制终端",
            "text": "权限已激活，欢迎使用避难所主控制终端系统。",
            "nextDialogs": [
              "760980702"
            ]
          },
          "760980702": {
            "id": "760980702",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "让我看看…这上面显示的好像是这里的地图？",
            "nextDialogs": [
              "760980703"
            ]
          },
          "760980703": {
            "id": "760980703",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "我们在外面拿到的密钥卡，似乎只有前往<color=#00E1FFF>一号研究区</color>的授权…",
            "nextDialogs": [
              "760980704"
            ]
          },
          "760980704": {
            "id": "760980704",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "（查询一号研究区状态。）",
            "nextDialogs": [
              "760980705"
            ]
          },
          "760980705": {
            "id": "760980705",
            "speakerId": 1002,
            "speakerName": "避难所主控制终端",
            "text": "正在生成状态报告，请稍候。",
            "nextDialogs": [
              "760980706"
            ]
          },
          "760980706": {
            "id": "760980706",
            "speakerId": 1002,
            "speakerName": "避难所主控制终端",
            "text": "<color=#00E1FFF>一号研究区</color>：<color=#FF5E41FF>警告</color>。检测到高浓度深渊污染。当前外溢风险：<color=#FF5E41FF>极高</color>。",
            "nextDialogs": [
              "760980707"
            ]
          },
          "760980707": {
            "id": "760980707",
            "speakerId": 1002,
            "speakerName": "避难所主控制终端",
            "text": "<color=#FF5E41FF>末日</color>净化系统：<color=#FF5E41FF>阻塞中</color>。已派遣维修人员。",
            "nextDialogs": [
              "760980708"
            ]
          },
          "760980708": {
            "id": "760980708",
            "speakerId": 1002,
            "speakerName": "避难所主控制终端",
            "text": "距离上次呼叫维修已有：<color=#FF5E41FF>错误</color>标准小时。请勿恐慌，公民，保持冷静并等待监督指示。",
            "nextDialogs": [
              "760980709"
            ]
          },
          "760980709": {
            "id": "760980709",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "呜哇，这个什么净化系统不是完全没有用嘛！",
            "nextDialogs": [
              "760980710"
            ]
          },
          "760980710": {
            "id": "760980710",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "我懂了，「末日」其实就是指深渊污染吧？唉，明明建造避难所就是为了抵御深渊，结果没想到里面比外面侵蚀得还严重…",
            "nextDialogs": [
              "760980712",
              "760980714"
            ]
          },
          "760980712": {
            "id": "760980712",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "#{NICKNAME}，我们想想办法吧？放着不管的话，深渊灾害说不定会外溢…",
            "nextDialogs": [
              "760980715"
            ]
          },
          "760980715": {
            "id": "760980715",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "先去一号研究区看看吧。",
            "nextDialogs": [
              "760980716"
            ]
          },
          "760980716": {
            "id": "760980716",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "嗯嗯，我们走！"
          },
          "760980714": {
            "id": "760980714",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "我也搞不清楚啦。不过，要是放着不管的话，深渊灾厄说不定会外溢…还是得先把问题解决掉才行呢！"
          }
        }
      }
    },

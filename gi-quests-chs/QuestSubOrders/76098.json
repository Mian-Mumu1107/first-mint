    {
      "subId": "7609818",
      "subQuestName": "调查控制终端",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "760981801"
        ],
        "dialogs": {
          "760981801": {
            "id": "760981801",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "呼…终于解决掉了，还真是讨厌的家伙…",
            "nextDialogs": [
              "760981802"
            ]
          },
          "760981802": {
            "id": "760981802",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "直到最后，它好像都觉得自己是在天外，而提瓦特已经完全毁灭了…",
            "nextDialogs": [
              "760981803"
            ]
          },
          "760981803": {
            "id": "760981803",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "算了，像这样满口胡话的家伙，还是别管它啦！这样一来，无论是什么「末日」还是深渊，都已经被我们解决掉了！",
            "nextDialogs": [
              "760981805",
              "760981807"
            ]
          },
          "760981805": {
            "id": "760981805",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "嗯嗯，这也算是那个叫格蕾兹娜的研究员的功劳吧？虽然不知道她后来怎么样了…",
            "nextDialogs": [
              "760981808"
            ]
          },
          "760981808": {
            "id": "760981808",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "好，这样一来就圆满解——欸？等一下，这是什么东西？",
            "nextDialogs": [
              "760981809"
            ]
          },
          "760981809": {
            "id": "760981809",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "识、识者之证？！居然会在这种地方…",
            "nextDialogs": [
              "760981810"
            ]
          },
          "760981810": {
            "id": "760981810",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "而且看样子还是大盗雷德·米勒亲自留下的…这样一来，我们距离「伟大财宝」就更近一步啦！",
            "nextDialogs": [
              "760981811"
            ]
          },
          "760981811": {
            "id": "760981811",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "嘿嘿，到底会有什么好东西呢？好期待呀！"
          },
          "760981807": {
            "id": "760981807",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "不，你刚才根本没用剑吧！啊，差点忘了，离开避难所的时候要记得取回武器才行…"
          }
        }
      }
    },

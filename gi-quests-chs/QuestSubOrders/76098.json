{
  "lineCounts": {
    "Player": 25,
    "「末缀之劫」": 14,
    "「末缀之劫」？": 2,
    "古老的终端": 3,
    "派蒙": 58,
    "温和的女声": 4,
    "避难所主控制终端": 11,
    "避难所自动威胁响应系统": 10
  },
  "subQuests": [
    {
      "subId": "7609803",
      "subQuestName": "进入避难所$HIDDEN",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "760980301"
        ],
        "dialogs": {
          "760980301": {
            "id": "760980301",
            "speakerId": 1000,
            "speakerName": "温和的女声",
            "text": "「…欢迎来到（…）号避难所，远道而来的朋友…」",
            "nextDialogs": [
              "760980302"
            ]
          },
          "760980302": {
            "id": "760980302",
            "speakerId": 1000,
            "speakerName": "温和的女声",
            "text": "「…如果您正在听这段录音，那便意味着<color=#FF5E41FF>末日</color>即将来临…」",
            "nextDialogs": [
              "760980303"
            ]
          },
          "760980303": {
            "id": "760980303",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "哇啊！吓我一跳，这个居然还会响喔…不对，比起那个，它刚才是不是说了什么虽然我没听懂但是好像很可怕的事？",
            "nextDialogs": [
              "760980308",
              "760980306"
            ]
          },
          "760980308": {
            "id": "760980308",
            "speakerId": 1000,
            "speakerName": "温和的女声",
            "text": "「…幸运的是，您找到了这里，而我们也有幸能与您…共同…<color=#FF5E41FF>末日</color>后的…」",
            "nextDialogs": [
              "760980309"
            ]
          },
          "760980309": {
            "id": "760980309",
            "speakerId": 1000,
            "speakerName": "温和的女声",
            "text": "「…请…密钥卡…<color=#00E1FFF>升降梯</color>已接通至…安全后…搭乘…前往避难所…」",
            "nextDialogs": [
              "760980310"
            ]
          },
          "760980310": {
            "id": "760980310",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "呜啊，是机器坏掉了吗？杂音把她的声音盖过去了，听不清她后面在说什么…",
            "nextDialogs": [
              "760980311"
            ]
          },
          "760980311": {
            "id": "760980311",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "#完全搞不懂这里是用来做什么的…{NICKNAME}，要不然我们还是进去看看吧？"
          },
          "760980306": {
            "id": "760980306",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "哦哦，原来只是末日啊，那我就放心了——",
            "nextDialogs": [
              "760980307"
            ]
          },
          "760980307": {
            "id": "760980307",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "怎么可能放心啦！这种时候就别用那种像是在说「明天的早餐是野菇鸡肉串」一样理所当然的语气啦！"
          }
        }
      }
    },
    {
      "subId": "7609804",
      "subQuestName": "进入避难所",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "760980401"
        ],
        "dialogs": {
          "760980401": {
            "id": "760980401",
            "speakerId": 1002,
            "speakerName": "避难所主控制终端",
            "text": "<color=#00E1FFF>一号研究区</color>维修指令已完成。晚于预期：<color=#FF5E41FF>3942176</color>小时。怠工行为已上报监督。",
            "nextDialogs": [
              "760980402"
            ]
          },
          "760980402": {
            "id": "760980402",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "多、多少小时？呜哇，我就只记得一个三了，剩下的一长串数字到底是多久啊？",
            "nextDialogs": [
              "760980403"
            ]
          },
          "760980403": {
            "id": "760980403",
            "speakerId": 1002,
            "speakerName": "避难所主控制终端",
            "text": "权限已更新：高级技工柯泰尼科夫，欢迎使用避难所主控制终端系统。",
            "nextDialogs": [
              "760980404"
            ]
          },
          "760980404": {
            "id": "760980404",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "咦？这台机器好像把我们识别成了那个本来被派去维修净化系统的维修工…",
            "nextDialogs": [
              "760980405"
            ]
          },
          "760980405": {
            "id": "760980405",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "不过，这样一来，我们能去的地方也变多了呢！我看看…这边好像是<color=#00E1FFF>二号研究区</color>？",
            "nextDialogs": [
              "760980406"
            ]
          },
          "760980406": {
            "id": "760980406",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "（查询二号研究区状态。）",
            "nextDialogs": [
              "760980407"
            ]
          },
          "760980407": {
            "id": "760980407",
            "speakerId": 1002,
            "speakerName": "避难所主控制终端",
            "text": "正在生成状态报告，请稍候。",
            "nextDialogs": [
              "760980408"
            ]
          },
          "760980408": {
            "id": "760980408",
            "speakerId": 1002,
            "speakerName": "避难所主控制终端",
            "text": "<color=#00E1FFF>二号研究区</color>：<color=#FF5E41FF>警告</color>。检测到高浓度深渊污染与「末缀之劫」活动迹象。",
            "nextDialogs": [
              "760980409"
            ]
          },
          "760980409": {
            "id": "760980409",
            "speakerId": 1002,
            "speakerName": "避难所主控制终端",
            "text": "<color=#FF5E41FF>末日</color>净化系统：<color=#FF5E41FF>已损坏</color>。高级技工柯泰尼科夫，请在警卫陪同下前往维修。",
            "nextDialogs": [
              "760980410"
            ]
          },
          "760980410": {
            "id": "760980410",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "哪来的警卫啊！欸？等等，刚才是不是出现了一个很奇怪的名字？",
            "nextDialogs": [
              "760980414",
              "760980413"
            ]
          },
          "760980414": {
            "id": "760980414",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "不过，要是那个「末日」其实是指深渊魔兽的话，那应该就是这地方污染的源头了…",
            "nextDialogs": [
              "760980415"
            ]
          },
          "760980415": {
            "id": "760980415",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "#只要解决掉那家伙，应该就能彻底清除这里的深渊污染了吧？{NICKNAME}，我们去<color=#00E1FFF>二号研究区</color>看看吧！"
          },
          "760980413": {
            "id": "760980413",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "#哼哼，{NICKNAME}，你的安全就交给我吧！——虽然很想这么说啦，但派蒙警卫也没有武器，你自己注意安全喔。"
          }
        }
      }
    },
    {
      "subId": "7609802",
      "subQuestName": "继续前进",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "760980201"
        ],
        "dialogs": {
          "760980201": {
            "id": "760980201",
            "speakerId": 1003,
            "speakerName": "避难所自动威胁响应系统",
            "text": "检测到未登记居民。正在启动标准安全检查程序…",
            "nextDialogs": [
              "760980202"
            ]
          },
          "760980202": {
            "id": "760980202",
            "speakerId": 1003,
            "speakerName": "避难所自动威胁响应系统",
            "text": "扫描完成。检测到您携带有<color=#FF5E41FF>多件危险品</color>。为了其他避难所居民的安全，请将所有武器及危险物品放入指定的收纳柜中。",
            "nextDialogs": [
              "760980203"
            ]
          },
          "760980203": {
            "id": "760980203",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "欸，要我们把武器交出去？！",
            "nextDialogs": [
              "760980204"
            ]
          },
          "760980204": {
            "id": "760980204",
            "speakerId": 1003,
            "speakerName": "避难所自动威胁响应系统",
            "text": "请谅解。收缴危险品是为确保避难所居民的绝对安全。您的所有物品将被妥善保管，待您离开时即可取回。",
            "nextDialogs": [
              "760980205"
            ]
          },
          "760980205": {
            "id": "760980205",
            "speakerId": 1003,
            "speakerName": "避难所自动威胁响应系统",
            "text": "若是您存在安全顾虑，还请务必放心。避难所内部搭载了最先进的<color=#FF5E41FF>末日</color>净化系统，您不会遇到任何危险。",
            "nextDialogs": [
              "760980206"
            ]
          },
          "760980206": {
            "id": "760980206",
            "speakerId": 1003,
            "speakerName": "避难所自动威胁响应系统",
            "text": "以（…）教授的名誉担保，无论天幕之外有何种魔物侵扰，都绝不会渗入我们的乐园分毫。",
            "nextDialogs": [
              "760980207"
            ]
          },
          "760980207": {
            "id": "760980207",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "呃，天幕之外？我们不是在海底吗？",
            "nextDialogs": [
              "760980208"
            ]
          },
          "760980208": {
            "id": "760980208",
            "speakerId": 1003,
            "speakerName": "避难所自动威胁响应系统",
            "text": "……",
            "nextDialogs": [
              "760980209"
            ]
          },
          "760980209": {
            "id": "760980209",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "哦哦，我懂了！就和那夏镇的小说里写的一样，这个所谓的「末日」，其实是打算侵略我们提瓦特的外星人——",
            "nextDialogs": [
              "760980213"
            ]
          },
          "760980213": {
            "id": "760980213",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "我只是在开玩笑啦！就算真有天外来的侵略者，也不会跑到这种地方来…呃，应该不会吧？",
            "nextDialogs": [
              "760980214"
            ]
          },
          "760980214": {
            "id": "760980214",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "不过话说回来，既然是避难所，为了安全考虑要求卸下武器也…还算合理吧？除非这里其实在做什么奇怪的坏事…",
            "nextDialogs": [
              "760980215"
            ]
          },
          "760980215": {
            "id": "760980215",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "比如故意只提供特别难吃的食物之类的，或者故意让净水装置隔段时间就坏一次之类的，又或者大门永远都打不开之类的…",
            "nextDialogs": [
              "760980216"
            ]
          },
          "760980216": {
            "id": "760980216",
            "speakerId": 1004,
            "speakerName": "古老的终端",
            "text": "请不必担忧。本避难所旨在提供绝对安全的庇护环境，所有居民均可随时自由离开。",
            "nextDialogs": [
              "760980217"
            ]
          },
          "760980217": {
            "id": "760980217",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "#呃，既然它都这么说了…那要不然我们先按照它说的做吧，{NICKNAME}？",
            "nextDialogs": [
              "760980218"
            ]
          },
          "760980218": {
            "id": "760980218",
            "speakerId": 1004,
            "speakerName": "古老的终端",
            "text": "感谢您的配合。危险品已收纳。扫描完成，未检测到其他威胁。标准安全检查程序结束。",
            "nextDialogs": [
              "760980219"
            ]
          },
          "760980219": {
            "id": "760980219",
            "speakerId": 1004,
            "speakerName": "古老的终端",
            "text": "欢迎来到<color=#FF5E41FF>末日</color>后的避难所。"
          }
        }
      }
    },

    {
      "subId": "7609810",
      "subQuestName": "调查终端",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "760981001"
        ],
        "dialogs": {
          "760981001": {
            "id": "760981001",
            "speakerId": 1003,
            "speakerName": "避难所自动威胁响应系统",
            "text": "维修已完成。<color=#FF5E41FF>末日</color>净化系统：<color=#FF5E41FF>正常运作中</color>。<color=#3399CCFF>密钥卡</color>已解除锁定。",
            "nextDialogs": [
              "760981002"
            ]
          },
          "760981002": {
            "id": "760981002",
            "speakerId": 1003,
            "speakerName": "避难所自动威胁响应系统",
            "text": "不要忘记取走密钥卡。祝你拥有美好的一天。",
            "nextDialogs": [
              "760981003"
            ]
          },
          "760981003": {
            "id": "760981003",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "欸？仔细看看的话，这张卡的颜色好像和我们的不太一样？",
            "nextDialogs": [
              "760981004"
            ]
          },
          "760981004": {
            "id": "760981004",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "虽然不知道是谁丢在这里的，总之还是先带上吧。要是能找到失主的话…呃，虽然这里好像已经没有人了…"
          }
        }
      }
    },

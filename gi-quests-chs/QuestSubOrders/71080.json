  "subQuests": [
    {
      "subId": "7108001",
      "subQuestName": "隐藏判断任务存在$HIDDEN",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "710800101"
        ],
        "dialogs": {
          "710800101": {
            "id": "710800101",
            "speakerId": 1000,
            "speakerName": "塔列辛",
            "text": "#哈，你好！是收服了东风之龙、拯救我家乡的大英雄{NICKNAME}呀！"
          }
        }
      }
    },
    {
      "subId": "7108002",
      "subQuestName": "上层封印解除$HIDDEN",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "710800607"
        ],
        "dialogs": {
          "710800607": {
            "id": "710800607",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "讲述有关如何解除「七星阵法」的故事…",
            "nextDialogs": [
              "710800608"
            ]
          },
          "710800608": {
            "id": "710800608",
            "speakerId": 1001,
            "speakerName": "Black Screen",
            "text": "你为塔列辛讲述了此前的经历…",
            "nextDialogs": [
              "710800609"
            ]
          },
          "710800609": {
            "id": "710800609",
            "speakerId": 1000,
            "speakerName": "塔列辛",
            "text": "哦哦…「就这样，就这样…在忠诚的仆人…」不对不对…！",
            "nextDialogs": [
              "710800610"
            ]
          },
          "710800610": {
            "id": "710800610",
            "speakerId": 1000,
            "speakerName": "塔列辛",
            "text": "#「…在忠诚的友伴指引下，{NICKNAME}打通了前往矿坑的道路…！」",
            "nextDialogs": [
              "710800611"
            ]
          },
          "710800611": {
            "id": "710800611",
            "speakerId": 1002,
            "speakerName": "派蒙",
            "text": "哇…这样不太好吧，我们毕竟没有经过人家允许就…",
            "nextDialogs": [
              "710800612"
            ]
          },
          "710800612": {
            "id": "710800612",
            "speakerId": 1000,
            "speakerName": "塔列辛",
            "text": "欸~不用担心！英雄不为常人所为之事，不循常人所拘之道！大家不会在意这点小小问题的！"
          }
        }
      }
    },
    {
      "subId": "7108003",
      "subQuestName": "解开黑雾$HIDDEN",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "710800613"
        ],
        "dialogs": {
          "710800613": {
            "id": "710800613",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "讲述有关黑雾与深渊怪物的故事…",
            "nextDialogs": [
              "710800614"
            ]
          },
          "710800614": {
            "id": "710800614",
            "speakerId": 1001,
            "speakerName": "Black Screen",
            "text": "你为塔列辛讲述了此前的经历…",
            "nextDialogs": [
              "710800615"
            ]
          },
          "710800615": {
            "id": "710800615",
            "speakerId": 1000,
            "speakerName": "塔列辛",
            "text": "哇…这个很好！这个很好！请让我记录下来！",
            "nextDialogs": [
              "710800616"
            ]
          },
          "710800616": {
            "id": "710800616",
            "speakerId": 1000,
            "speakerName": "塔列辛",
            "text": "「…深黑的雾气如雪崩压至，倏而离析，来自深渊的两位使徒消失不见，正如来时一般…」"
          }
        }
      }
    },
    {
      "subId": "7108004",
      "subQuestName": "大碎片完成$HIDDEN",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "710800617"
        ],
        "dialogs": {
          "710800617": {
            "id": "710800617",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "讲述有关巨渊深处湛蓝晶石的故事…",
            "nextDialogs": [
              "710800618"
            ]
          },
          "710800618": {
            "id": "710800618",
            "speakerId": 1001,
            "speakerName": "Black Screen",
            "text": "你为塔列辛讲述了此前的经历…",
            "nextDialogs": [
              "710800619"
            ]
          },
          "710800619": {
            "id": "710800619",
            "speakerId": 1000,
            "speakerName": "塔列辛",
            "text": "「…天与水的颜色重又在晶石表面流动，紫红色的溃斑就此褪去…」",
            "nextDialogs": [
              "710800620"
            ]
          },
          "710800620": {
            "id": "710800620",
            "speakerId": 1000,
            "speakerName": "塔列辛",
            "text": "#「…古老遗迹中的构装巨兽，其头上正挨了{NICKNAME}的铁拳，昏昏沉沉之时…利箭救星顷刻而至！」",
            "nextDialogs": [
              "710800621"
            ]
          },
          "710800621": {
            "id": "710800621",
            "speakerId": 1000,
            "speakerName": "塔列辛",
            "text": "「…那相助旅者的神秘客消失无踪，再看蛇行的构装巨兽，却已被晶石砸得七零八落…」"
          }
        }
      }
    },
    {
      "subId": "7108005",
      "subQuestName": "大蘑菇任务完成$HIDDEN",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "710800622"
        ],
        "dialogs": {
          "710800622": {
            "id": "710800622",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "讲述有关岩洞中巨大荧光菌类的故事…",
            "nextDialogs": [
              "710800623"
            ]
          },
          "710800623": {
            "id": "710800623",
            "speakerId": 1001,
            "speakerName": "Black Screen",
            "text": "你为塔列辛讲述了此前的经历…",
            "nextDialogs": [
              "710800624"
            ]
          },
          "710800624": {
            "id": "710800624",
            "speakerId": 1000,
            "speakerName": "塔列辛",
            "text": "有趣…这个实在令人意想不到呀…请容我好好构思一下再开口吧。",
            "nextDialogs": [
              "710800625"
            ]
          },
          "710800625": {
            "id": "710800625",
            "speakerId": 1000,
            "speakerName": "塔列辛",
            "text": "「…虽是高可参天的巨蘑，面临黑暗侵袭之时，亦是难以自救的弱者…」",
            "nextDialogs": [
              "710800626"
            ]
          },
          "710800626": {
            "id": "710800626",
            "speakerId": 1000,
            "speakerName": "塔列辛",
            "text": "#「…{NICKNAME}应呼唤而来，为其净化土地，排忧解难…」"
          }
        }
      }
    },
    {
      "subId": "7108006",
      "subQuestName": "黑蛇骑士完成$HIDDEN",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "710800629"
        ],
        "dialogs": {
          "710800629": {
            "id": "710800629",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "讲述有关九位黑蛇骑士的故事…",
            "nextDialogs": [
              "710800630"
            ]
          },
          "710800630": {
            "id": "710800630",
            "speakerId": 1001,
            "speakerName": "Black Screen",
            "text": "你为塔列辛讲述了此前的经历…",
            "nextDialogs": [
              "710800631"
            ]
          },
          "710800631": {
            "id": "710800631",
            "speakerId": 1000,
            "speakerName": "塔列辛",
            "text": "这个好呀，这个好！「…于是，命运的旅人言道：『漫说一个一个接踵而至，就是九个一同攻来，一并击破又有何难？』…」",
            "nextDialogs": [
              "710800632"
            ]
          },
          "710800632": {
            "id": "710800632",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "唔…也没有这么夸张就是了…",
            "nextDialogs": [
              "710800633"
            ]
          },
          "710800633": {
            "id": "710800633",
            "speakerId": 1000,
            "speakerName": "塔列辛",
            "text": "没关系的…请容我现编…不，编纂一下九位剑士的家世…"
          }
        }
      }
    },
    {
      "subId": "7108007",
      "subQuestName": "双子线完成$HIDDEN",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "710800634"
        ],
        "dialogs": {
          "710800634": {
            "id": "710800634",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "讲述追寻血亲的进展…",
            "nextDialogs": [
              "710800635"
            ]
          },
          "710800635": {
            "id": "710800635",
            "speakerId": 1001,
            "speakerName": "Black Screen",
            "text": "你为塔列辛讲述了此前的经历…",
            "nextDialogs": [
              "710800636"
            ]
          },
          "710800636": {
            "id": "710800636",
            "speakerId": 1000,
            "speakerName": "塔列辛",
            "text": "有趣，有趣…被遗忘的古国，不被认同的牺牲…落于愚昧的不公惩罚…十分宏大的主题，十分宏大的故事呀…",
            "nextDialogs": [
              "710800637"
            ]
          },
          "710800637": {
            "id": "710800637",
            "speakerId": 1000,
            "speakerName": "塔列辛",
            "text": "而这样的故事，乃是你冒险途中所经历的事件，与你的目标也息息相关…",
            "nextDialogs": [
              "710800638"
            ]
          },
          "710800638": {
            "id": "710800638",
            "speakerId": 1000,
            "speakerName": "塔列辛",
            "text": "谢谢你让我知道这些，我会记录下来的。但我暂时不会编撰成诗…因为这只是属于你的史诗的小小碎片而已。",
            "nextDialogs": [
              "710800639"
            ]
          },
          "710800639": {
            "id": "710800639",
            "speakerId": 1000,
            "speakerName": "塔列辛",
            "text": "我不会以有限的才能亵渎你的故事…但请你完成自己的旅途后，一定要讲与我听。",
            "nextDialogs": [
              "710800640"
            ]
          },
          "710800640": {
            "id": "710800640",
            "speakerId": 1000,
            "speakerName": "塔列辛",
            "text": "我有预感，待到那一天，我将有幸听到最为伟大的英雄史诗…出自你自己的口舌与双脚。"
          }
        }
      }
    },
    {
      "subId": "7108008",
      "subQuestName": "愚人众任务完成$HIDDEN",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "710800641"
        ],
        "dialogs": {
          "710800641": {
            "id": "710800641",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "讲述有关陷入困境的愚人众的故事…",
            "nextDialogs": [
              "710800642"
            ]
          },
          "710800642": {
            "id": "710800642",
            "speakerId": 1001,
            "speakerName": "Black Screen",
            "text": "你为塔列辛讲述了此前的经历…",
            "nextDialogs": [
              "710800643"
            ]
          },
          "710800643": {
            "id": "710800643",
            "speakerId": 1000,
            "speakerName": "塔列辛",
            "text": "哈哈，这个故事很有意思呀！「…『日暮途穷的苦涩今日，竟被大敌所搭救！』安东上士如是叹息…」",
            "nextDialogs": [
              "710800644"
            ]
          },
          "710800644": {
            "id": "710800644",
            "speakerId": 1000,
            "speakerName": "塔列辛",
            "text": "「今日暂时的友人，难保来日会不会重新为敌！」"
          }
        }
      }
    },

    {
      "subId": "7108011",
      "subQuestName": "与塔列辛对话获得诗篇$HIDDEN",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "710800701"
        ],
        "dialogs": {
          "710800701": {
            "id": "710800701",
            "speakerId": 1000,
            "speakerName": "塔列辛",
            "text": "感谢你帮我完成这部史诗，对了，这份手稿是我的谢礼。请收下吧。",
            "nextDialogs": [
              "710800702"
            ]
          },
          "710800702": {
            "id": "710800702",
            "speakerId": 1000,
            "speakerName": "塔列辛",
            "text": "呼…这是史诗的初稿，承载了我情感与抱负。我今天将它交付与你，作为一点小小的回报。"
          }
        }
      }
    },
    {
      "subId": "7108002",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "710800201"
        ],
        "dialogs": {
          "710800201": {
            "id": "710800201",
            "speakerId": 1000,
            "speakerName": "塔列辛",
            "text": "#你来了，{NICKNAME}，直面「愚人众」执行官，从海魔面前拯救了璃月的英雄！"
          }
        }
      }
    },
    {
      "subId": "7108003",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "710800301"
        ],
        "dialogs": {
          "710800301": {
            "id": "710800301",
            "speakerId": 1000,
            "speakerName": "塔列辛",
            "text": "#啊啊，是在遥远晨雾中的雷霆之国兴云吐雾的大人物！{NICKNAME}，请到这来，请到这来！"
          }
        }
      }
    },
    {
      "subId": "7108004",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "710800401"
        ],
        "dialogs": {
          "710800401": {
            "id": "710800401",
            "speakerId": 1000,
            "speakerName": "塔列辛",
            "text": "#你好呀！你好呀！{NICKNAME}！曾徒步登上龙脊雪山的大冒险家！"
          }
        }
      }
    },
    {
      "subId": "7108005",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "710800501"
        ],
        "dialogs": {
          "710800501": {
            "id": "710800501",
            "speakerId": 1000,
            "speakerName": "塔列辛",
            "text": "#你好啊！令「愚人众」执行官在异国俯首败伏的旅人！{NICKNAME}！"
          }
        }
      }
    },
    {
      "subId": "7108006",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "710800601"
        ],
        "dialogs": {
          "710800601": {
            "id": "710800601",
            "speakerId": 1000,
            "speakerName": "塔列辛",
            "text": "虽然有点唐突…但不知可否请向英雄讨教故事一二，以便我编纂成诗歌，传唱后世？",
            "nextDialogs": [
              "710800604"
            ]
          },
          "710800604": {
            "id": "710800604",
            "speakerId": 1000,
            "speakerName": "塔列辛",
            "text": "您能够答应的话就太好了！我在此洗耳恭听！"
          },
          "710800605": {
            "id": "710800605",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "讲述关于层岩巨渊本身的故事。",
            "nextDialogs": [
              "710800606"
            ]
          },
          "710800606": {
            "id": "710800606",
            "speakerId": 1000,
            "speakerName": "塔列辛",
            "text": "好的，请你讲述吧！",
            "nextDialogs": [
              "710800627"
            ]
          },
          "710800627": {
            "id": "710800627",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "讲述关于所见所闻之人与物的故事。",
            "nextDialogs": [
              "710800628"
            ]
          },
          "710800628": {
            "id": "710800628",
            "speakerId": 1000,
            "speakerName": "塔列辛",
            "text": "还请您知无不言，我洗耳恭听。",
            "nextDialogs": [
              "710800645"
            ]
          },
          "710800645": {
            "id": "710800645",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "再见。",
            "nextDialogs": [
              "710800646"
            ]
          },
          "710800646": {
            "id": "710800646",
            "speakerId": 1000,
            "speakerName": "塔列辛",
            "text": "#愿你平安。非常感谢您能停留，流誉七国的大英雄{NICKNAME}！"
          }
        }
      }
    }
  ]
}
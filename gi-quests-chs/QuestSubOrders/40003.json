    {
      "subId": "4000309",
      "subQuestName": "与未知人士对话$UNRELEASED",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "400030901"
        ],
        "dialogs": {
          "400030901": {
            "id": "400030901",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "……$UNRELEASED",
            "nextDialogs": [
              "400030902"
            ]
          },
          "400030902": {
            "id": "400030902",
            "speakerId": 10204,
            "speakerName": "魈",
            "text": "……$UNRELEASED",
            "nextDialogs": [
              "400030903"
            ]
          },
          "400030903": {
            "id": "400030903",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "#{NICKNAME}，怎么办，这个人看起来很难沟通的样子。$UNRELEASED",
            "nextDialogs": [
              "400030904"
            ]
          },
          "400030904": {
            "id": "400030904",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "呜啊。感、感觉，并不是善人…$UNRELEASED",
            "nextDialogs": [
              "400030905"
            ]
          },
          "400030905": {
            "id": "400030905",
            "speakerId": 10204,
            "speakerName": "魈",
            "text": "不要只依靠感觉，就对「善恶」随口评说。$UNRELEASED",
            "nextDialogs": [
              "400030906"
            ]
          },
          "400030906": {
            "id": "400030906",
            "speakerId": 10204,
            "speakerName": "魈",
            "text": "不过，我确实是恶鬼。我是斩杀妖物、魔障的护法夜叉，魈。$UNRELEASED",
            "nextDialogs": [
              "400030907"
            ]
          },
          "400030907": {
            "id": "400030907",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "护法夜叉…！$UNRELEASED",
            "nextDialogs": [
              "400030910"
            ]
          },
          "400030910": {
            "id": "400030910",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "对、对了…之前有听璃月的人说过…夜叉也是守护璃月的仙人…$UNRELEASED",
            "nextDialogs": [
              "400030911"
            ]
          },
          "400030911": {
            "id": "400030911",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "暗中镇守人类的世界，为不知情的凡人斩妖除魔…$UNRELEASED",
            "nextDialogs": [
              "400030912"
            ]
          },
          "400030912": {
            "id": "400030912",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "一般意义上，这不就是叫做善人吗！$UNRELEASED",
            "nextDialogs": [
              "400030913"
            ]
          },
          "400030913": {
            "id": "400030913",
            "speakerId": 10204,
            "speakerName": "魈",
            "text": "…不。夜叉的「护法」，并不出于对人类的善意。$UNRELEASED",
            "nextDialogs": [
              "400030914"
            ]
          },
          "400030914": {
            "id": "400030914",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "呜…明明海灯节的主题，就是纪念英雄。$UNRELEASED",
            "nextDialogs": [
              "400030915"
            ]
          },
          "400030915": {
            "id": "400030915",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "历史上护佑璃月的那些英雄，难得有一个活到现在的，却对纪念自己的节日不领情呢。$UNRELEASED",
            "nextDialogs": [
              "400030916"
            ]
          },
          "400030916": {
            "id": "400030916",
            "speakerId": 10204,
            "speakerName": "魈",
            "text": "……$UNRELEASED",
            "nextDialogs": [
              "400030917"
            ]
          },
          "400030917": {
            "id": "400030917",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "魈先生…呃，魈上仙…？为什么你刚才不直接制伏那个可疑的家伙呢？$UNRELEASED",
            "nextDialogs": [
              "400030918"
            ]
          },
          "400030918": {
            "id": "400030918",
            "speakerId": 10204,
            "speakerName": "魈",
            "text": "本以为是妖物作祟，我才过来看看。$UNRELEASED",
            "nextDialogs": [
              "400030919"
            ]
          },
          "400030919": {
            "id": "400030919",
            "speakerId": 10204,
            "speakerName": "魈",
            "text": "如果在仙与魔的世界，有什么东西失去桎梏，那就是我的责任。$UNRELEASED",
            "nextDialogs": [
              "400030920"
            ]
          },
          "400030920": {
            "id": "400030920",
            "speakerId": 10204,
            "speakerName": "魈",
            "text": "但这次的威胁来自人类的世界——你们的世界，所以这是你的责任，人类旅者。$UNRELEASED",
            "nextDialogs": [
              "400030921"
            ]
          },
          "400030921": {
            "id": "400030921",
            "speakerId": 10204,
            "speakerName": "魈",
            "text": "必要时…也希望你自觉一些，下手果断。$UNRELEASED",
            "nextDialogs": [
              "400030922"
            ]
          },
          "400030922": {
            "id": "400030922",
            "speakerId": 10204,
            "speakerName": "魈",
            "text": "不要让斩妖之枪的枪缨，沾染凡间之血。$UNRELEASED",
            "nextDialogs": [
              "400030923"
            ]
          },
          "400030923": {
            "id": "400030923",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "这个是——$UNRELEASED",
            "nextDialogs": [
              "400030924"
            ]
          },
          "400030924": {
            "id": "400030924",
            "speakerId": 10204,
            "speakerName": "魈",
            "text": "是那人留下的符号。$UNRELEASED",
            "nextDialogs": [
              "400030925"
            ]
          },
          "400030925": {
            "id": "400030925",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "派蒙认识吗？$UNRELEASED",
            "nextDialogs": [
              "400030926"
            ]
          },
          "400030926": {
            "id": "400030926",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "并没有什么印象呢。$UNRELEASED",
            "nextDialogs": [
              "400030927"
            ]
          },
          "400030927": {
            "id": "400030927",
            "speakerId": 10204,
            "speakerName": "魈",
            "text": "那就努力向我展示，你们能做到哪一步吧。$UNRELEASED",
            "nextDialogs": [
              "400030928"
            ]
          },
          "400030928": {
            "id": "400030928",
            "speakerId": 10204,
            "speakerName": "魈",
            "text": "如果换我来，导向的结局多少会有「红色海灯节」的可能性。$UNRELEASED",
            "nextDialogs": [
              "400030929"
            ]
          },
          "400030929": {
            "id": "400030929",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "颜色还挺喜庆的。$UNRELEASED",
            "nextDialogs": [
              "400030930"
            ]
          },
          "400030930": {
            "id": "400030930",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "听着好吓人！$UNRELEASED",
            "nextDialogs": [
              "400030932"
            ]
          },
          "400030932": {
            "id": "400030932",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "呜哇，你先别这么冲动。等我们先问明白这个符号的来历再说吧。$UNRELEASED"
          }
        }
      }
    }
  ]
}
    {
      "subId": "4000307",
      "subQuestName": "(test)与派蒙对话（隐藏）$UNRELEASED$HIDDEN",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "400030701"
        ],
        "dialogs": {
          "400030701": {
            "id": "400030701",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "果然，那个是！",
            "nextDialogs": [
              "400030704"
            ]
          },
          "400030704": {
            "id": "400030704",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "等一等，似乎还有人——"
          }
        }
      }
    },
    {
      "subId": "4000308",

  "subQuests": [
    {
      "subId": "4000301",
      "subQuestName": "(test)派蒙开车台词（隐藏）$UNRELEASED$HIDDEN",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "400030101"
        ],
        "dialogs": {
          "400030101": {
            "id": "400030101",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "不知道总务司那边，处理得怎么样了？"
          }
        }
      }
    },
    {
      "subId": "4000302",
      "subQuestName": "前往总务司，与嘉义对话$UNRELEASED",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "400030201"
        ],
        "dialogs": {
          "400030201": {
            "id": "400030201",
            "speakerId": 2056,
            "speakerName": "嘉义",
            "text": "你们…哦，对了，是昨天来提醒险情的二位。$UNRELEASED",
            "nextDialogs": [
              "400030202"
            ]
          },
          "400030202": {
            "id": "400030202",
            "speakerId": 2056,
            "speakerName": "嘉义",
            "text": "唉…实不相瞒，海灯节期间，总务司事务繁杂，暂时抽不出人手来排查。$UNRELEASED",
            "nextDialogs": [
              "400030203"
            ]
          },
          "400030203": {
            "id": "400030203",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "欸？怎么这样——$UNRELEASED",
            "nextDialogs": [
              "400030204"
            ]
          },
          "400030204": {
            "id": "400030204",
            "speakerId": 2056,
            "speakerName": "嘉义",
            "text": "真对不住，难得你们这么热心提供情报…容我想想…也许…$UNRELEASED",
            "nextDialogs": [
              "400030205"
            ]
          },
          "400030205": {
            "id": "400030205",
            "speakerId": 2056,
            "speakerName": "嘉义",
            "text": "也许，我们有一个小队能帮上忙。他们手上的任务，今天只剩最后一个了。$UNRELEASED",
            "nextDialogs": [
              "400030206"
            ]
          },
          "400030206": {
            "id": "400030206",
            "speakerId": 2056,
            "speakerName": "嘉义",
            "text": "他们在归离原清剿怪物，如果你们能联系上他们的话…$UNRELEASED"
          }
        }
      }
    },
    {
      "subId": "4000305",
      "subQuestName": "前去寻找千岩军$UNRELEASED",
      "sceneId": null,

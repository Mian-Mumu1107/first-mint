    {
      "subId": "4000303",
      "subQuestName": "清剿丘丘人与路障$UNRELEASED",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "400030301"
        ],
        "dialogs": {
          "400030301": {
            "id": "400030301",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "是丘丘人的路障！它们为什么要封住这条路呢？是想埋伏谁吗？"
          }
        }
      }
    },
    {
      "subId": "4000304",
      "subQuestName": "与千岩军小队对话$UNRELEASED",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "400030401"
        ],
        "dialogs": {
          "400030401": {
            "id": "400030401",
            "speakerId": 242801,
            "speakerName": "星火",
            "text": "好了，这里的怪物痕迹已经调查完毕，该收工了——嗯？$UNRELEASED",
            "nextDialogs": [
              "400030402"
            ]
          },
          "400030402": {
            "id": "400030402",
            "speakerId": 242801,
            "speakerName": "星火",
            "text": "你们是什么人？$UNRELEASED",
            "nextDialogs": [
              "400030403"
            ]
          },
          "400030403": {
            "id": "400030403",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "是嘉义让我们来找你的，他说…$UNRELEASED",
            "nextDialogs": [
              "400030404"
            ]
          },
          "400030404": {
            "id": "400030404",
            "speakerId": 242801,
            "speakerName": "星火",
            "text": "原来如此。$UNRELEASED",
            "nextDialogs": [
              "400030405"
            ]
          },
          "400030405": {
            "id": "400030405",
            "speakerId": 242801,
            "speakerName": "星火",
            "text": "感谢你们对总务司工作的支持，这件事我们记下了，很快就会提上日程。$UNRELEASED",
            "nextDialogs": [
              "400030406"
            ]
          },
          "400030406": {
            "id": "400030406",
            "speakerId": 242801,
            "speakerName": "星火",
            "text": "那么，我们在璃月港有缘再见吧，热心的旅行者。$UNRELEASED",
            "nextDialogs": [
              "400030407"
            ]
          },
          "400030407": {
            "id": "400030407",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "#{NICKNAME}，你有没有觉得…$UNRELEASED",
            "nextDialogs": [
              "400030409",
              "400030414"
            ]
          },
          "400030409": {
            "id": "400030409",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "派蒙我也这么认为！$UNRELEASED",
            "nextDialogs": [
              "400030410"
            ]
          },
          "400030410": {
            "id": "400030410",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "本地人估计习惯了那些好吃的。$UNRELEASED",
            "nextDialogs": [
              "400030411"
            ]
          },
          "400030411": {
            "id": "400030411",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "但流落荒野、在最惨的时候只能吃奇怪蘑菇维持生活的旅行者…$UNRELEASED",
            "nextDialogs": [
              "400030412"
            ]
          },
          "400030412": {
            "id": "400030412",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "对你来说，海灯节，意，义，非，凡！$UNRELEASED",
            "nextDialogs": [
              "400030416"
            ]
          },
          "400030416": {
            "id": "400030416",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "所以我们再去昨天目击的地点看看吧。$UNRELEASED",
            "nextDialogs": [
              "400030417"
            ]
          },
          "400030417": {
            "id": "400030417",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "听巡捕大爷说，罪犯都喜欢回案发地点看看。罪犯的心理就是这样。$UNRELEASED",
            "nextDialogs": [
              "400030418"
            ]
          },
          "400030418": {
            "id": "400030418",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "还没「案发」呢…$UNRELEASED",
            "nextDialogs": [
              "400030419"
            ]
          },
          "400030419": {
            "id": "400030419",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "所以说要抓紧时间啊，如果易燃品被人动了手脚，那案发的时候一切就都晚了！$UNRELEASED"
          },
          "400030414": {
            "id": "400030414",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "我也这么认为！$UNRELEASED",
            "nextDialogs": [
              "400030415"
            ]
          },
          "400030415": {
            "id": "400030415",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "根据我们四处冒险的经验，这件事还是负责到底比较好。$UNRELEASED"
          }
        }
      }
    },
    {
      "subId": "4000306",
      "subQuestName": "回「案发地点」看看$UNRELEASED",
      "sceneId": null,
      "locations": [],
      "dialogue": {

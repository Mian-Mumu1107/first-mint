          },
          "707090103": {
            "id": "707090103",
            "speakerId": 1656,
            "speakerName": "男子汉杰克",
            "text": "谢谢你愿意帮忙，那三份野菇鸡肉串，你已经全部拿到了吗？",
            "nextDialogs": [
              "707090106"
            ]
          },
          "707090106": {
            "id": "707090106",
            "speakerId": 1656,
            "speakerName": "男子汉杰克",
            "text": "那你拿到了之后，就尽快拿给人家吧。吃了肉之后，人家才会长力气呢。"
          }
        }
      }
    },
    {

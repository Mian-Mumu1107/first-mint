  },
  "subQuests": [
    {
      "subId": "7612001",
      "subQuestName": "同哥伦比娅见面",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "761200101"
        ],
        "dialogs": {
          "761200101": {
            "id": "761200101",
            "speakerId": 1000,
            "speakerName": "哥伦比娅",
            "text": "…来，给你，这样我的部分就可以了吧？",
            "nextDialogs": [
              "761200102"
            ]
          },
          "761200102": {
            "id": "761200102",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "哇！是画板！这么看来，难道说…！",
            "nextDialogs": [
              "761200103"
            ]
          },
          "761200103": {
            "id": "761200103",
            "speakerId": 1000,
            "speakerName": "哥伦比娅",
            "text": "嗯，你们来得正好。",
            "nextDialogs": [
              "761200104"
            ]
          },
          "761200104": {
            "id": "761200104",
            "speakerId": 1002,
            "speakerName": "梅拉",
            "text": "~！",
            "nextDialogs": [
              "761200105"
            ]
          },
          "761200105": {
            "id": "761200105",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "是梅拉大画家！好久不见了！",
            "nextDialogs": [
              "761200106"
            ]
          },
          "761200106": {
            "id": "761200106",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "来得正好指的是…",
            "nextDialogs": [
              "761200107"
            ]
          },
          "761200107": {
            "id": "761200107",
            "speakerId": 1000,
            "speakerName": "哥伦比娅",
            "text": "我刚刚带梅拉去了一趟月球。",
            "nextDialogs": [
              "761200108"
            ]
          },
          "761200108": {
            "id": "761200108",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "真羡慕你说这话的语气…轻松得就像说去隔壁花园逛了一圈一样。",
            "nextDialogs": [
              "761200109"
            ]
          },
          "761200109": {
            "id": "761200109",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "不过，你们去月球做什么呀？去采风吗？",
            "nextDialogs": [
              "761200110"
            ]
          },
          "761200110": {
            "id": "761200110",
            "speakerId": 1000,
            "speakerName": "哥伦比娅",
            "text": "对了一半。我们还在月球上，选好了办「画展」的地方，你们记得的吧？",
            "nextDialogs": [
              "761200111"
            ]
          },
          "761200111": {
            "id": "761200111",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "哦！记得记得，大画家梅拉的月神主题展！到时候可一定要叫我们去啊！",
            "nextDialogs": [
              "761200112"
            ]
          },
          "761200112": {
            "id": "761200112",
            "speakerId": 1000,
            "speakerName": "哥伦比娅",
            "text": "嗯，当然。另外，梅拉这孩子，好像能体察到周围一些很细微的变化。",
            "nextDialogs": [
              "761200113"
            ]
          },
          "761200113": {
            "id": "761200113",
            "speakerId": 1000,
            "speakerName": "哥伦比娅",
            "text": "它说我从月球上回来之后，很明显变了不少。",
            "nextDialogs": [
              "761200114"
            ]
          },
          "761200114": {
            "id": "761200114",
            "speakerId": 1000,
            "speakerName": "哥伦比娅",
            "text": "所以想让我带它去看看，月球上到底有什么特殊的东西。",
            "nextDialogs": [
              "761200115"
            ]
          },
          "761200115": {
            "id": "761200115",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "哦！不愧是大艺术家…",
            "nextDialogs": [
              "761200116"
            ]
          },
          "761200116": {
            "id": "761200116",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "所以特殊的东西是…",
            "nextDialogs": [
              "761200117"
            ]
          },
          "761200117": {
            "id": "761200117",
            "speakerId": 1000,
            "speakerName": "哥伦比娅",
            "text": "我也不知道，我带梅拉逛了好多地方，它好像都不满意。",
            "nextDialogs": [
              "761200118"
            ]
          },
          "761200118": {
            "id": "761200118",
            "speakerId": 1000,
            "speakerName": "哥伦比娅",
            "text": "直到，我带它去了你的飞船附近。",
            "nextDialogs": [
              "761200121"
            ]
          },
          "761200121": {
            "id": "761200121",
            "speakerId": 1000,
            "speakerName": "哥伦比娅",
            "text": "不过我带它走近一些后，却发现它感兴趣的并不是飞船。",
            "nextDialogs": [
              "761200122"
            ]
          },
          "761200122": {
            "id": "761200122",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "嗯？那是什么呀？",
            "nextDialogs": [
              "761200123"
            ]
          },
          "761200123": {
            "id": "761200123",
            "speakerId": 1002,
            "speakerName": "梅拉",
            "text": "~！！",
            "nextDialogs": [
              "761200124"
            ]
          },
          "761200124": {
            "id": "761200124",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "嗯？它在绕着哥伦比娅你飞欸。",
            "nextDialogs": [
              "761200125"
            ]
          },
          "761200125": {
            "id": "761200125",
            "speakerId": 1000,
            "speakerName": "哥伦比娅",
            "text": "哈哈，在那时它就这样。",
            "nextDialogs": [
              "761200126"
            ]
          },
          "761200126": {
            "id": "761200126",
            "speakerId": 1000,
            "speakerName": "哥伦比娅",
            "text": "我想，它真正感兴趣的，是我看到飞船后的样子。",
            "nextDialogs": [
              "761200127"
            ]
          },
          "761200127": {
            "id": "761200127",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "你的…样子？",
            "nextDialogs": [
              "761200128"
            ]
          },
          "761200128": {
            "id": "761200128",
            "speakerId": 1000,
            "speakerName": "哥伦比娅",
            "text": "#嗯，我想起了和{NICKNAME}一起来到这里时的情景。",
            "nextDialogs": [
              "761200129"
            ]
          },
          "761200129": {
            "id": "761200129",
            "speakerId": 1000,
            "speakerName": "哥伦比娅",
            "text": "#我们坐在船上，望着提瓦特。{M#他}{F#她}找到了过去的真相，而我找到了自己的「家」。",
            "nextDialogs": [
              "761200130"
            ]
          },
          "761200130": {
            "id": "761200130",
            "speakerId": 1000,
            "speakerName": "哥伦比娅",
            "text": "仅仅只是回忆起这些，我就有了一种安心，或说，幸福的感觉。",
            "nextDialogs": [
              "761200131"
            ]
          },
          "761200131": {
            "id": "761200131",
            "speakerId": 1002,
            "speakerName": "梅拉",
            "text": "~！",
            "nextDialogs": [
              "761200132"
            ]
          },
          "761200132": {
            "id": "761200132",
            "speakerId": 1000,
            "speakerName": "哥伦比娅",
            "text": "嗯，你说得没错，这是我以前基本不曾有过的感受。",
            "nextDialogs": [
              "761200133"
            ]
          },
          "761200133": {
            "id": "761200133",
            "speakerId": 1000,
            "speakerName": "哥伦比娅",
            "text": "所以，我就把我们的故事，包括和你上月球后发生的事告诉了梅拉。",
            "nextDialogs": [
              "761200134"
            ]
          },
          "761200134": {
            "id": "761200134",
            "speakerId": 1000,
            "speakerName": "哥伦比娅",
            "text": "它听完后看起来很满意，像是找到了自己想要的灵感。",
            "nextDialogs": [
              "761200135"
            ]
          },
          "761200135": {
            "id": "761200135",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "原来是这样，那现在就是大画家梅拉动笔的阶段了吧？",
            "nextDialogs": [
              "761200136"
            ]
          },
          "761200136": {
            "id": "761200136",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "你们当时没带我上去，我也很好奇梅拉到底会画出怎样的风景呢。",
            "nextDialogs": [
              "761200137"
            ]
          },
          "761200137": {
            "id": "761200137",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "这次需要什么来做颜料？",
            "nextDialogs": [
              "761200138"
            ]
          },
          "761200138": {
            "id": "761200138",
            "speakerId": 1000,
            "speakerName": "哥伦比娅",
            "text": "这次的有些特殊。",
            "nextDialogs": [
              "761200139"
            ]
          },
          "761200139": {
            "id": "761200139",
            "speakerId": 1002,
            "speakerName": "梅拉",
            "text": "~！",
            "nextDialogs": [
              "761200140"
            ]
          },
          "761200140": {
            "id": "761200140",
            "speakerId": 1000,
            "speakerName": "哥伦比娅",
            "text": "梅拉说，它想要只属于我们自己的颜料。",
            "nextDialogs": [
              "761200141"
            ]
          },
          "761200141": {
            "id": "761200141",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "欸？这是什么意思？",
            "nextDialogs": [
              "761200142"
            ]
          },
          "761200142": {
            "id": "761200142",
            "speakerId": 1000,
            "speakerName": "哥伦比娅",
            "text": "大概就是…当你看到这个东西的时候，就会想起这段旅程，心中浮现起它带给你的收获与欢喜。",
            "nextDialogs": [
              "761200143"
            ]
          },
          "761200143": {
            "id": "761200143",
            "speakerId": 1000,
            "speakerName": "哥伦比娅",
            "text": "不用担心，梅拉只是想看看那东西，感受一下而已。不会用这么珍贵的东西来做颜料的。",
            "nextDialogs": [
              "761200144"
            ]
          },
          "761200144": {
            "id": "761200144",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "哥伦比娅给了什么？",
            "nextDialogs": [
              "761200145"
            ]
          },
          "761200145": {
            "id": "761200145",
            "speakerId": 1000,
            "speakerName": "哥伦比娅",
            "text": "月球的土壤，还有你们送给我的祈月之夜贺卡。",
            "nextDialogs": [
              "761200146"
            ]
          },
          "761200146": {
            "id": "761200146",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "#哦~总之就是能代表这次冒险的东西吧？那就交给{NICKNAME}来选了！"
          }
        }
      }
    },
    {
      "subId": "7612003",
      "subQuestName": "将代表这段旅程的东西交给月灵",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "761200301"
        ],
        "dialogs": {
          "761200301": {
            "id": "761200301",
            "speakerId": 1000,
            "speakerName": "哥伦比娅",
            "text": "嗯，不错的选择。",
            "nextDialogs": [
              "761200302"
            ]
          },
          "761200302": {
            "id": "761200302",
            "speakerId": 1002,
            "speakerName": "梅拉",
            "text": "~！",
            "nextDialogs": [
              "761200303"
            ]
          },
          "761200303": {
            "id": "761200303",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "它看起来很满意呢，已经开始画起来了欸！",
            "nextDialogs": [
              "761200304"
            ]
          },
          "761200304": {
            "id": "761200304",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "这么一想，梅拉的这些画，简直囊括了哥伦比娅从诞生到现在的故事呢。",
            "nextDialogs": [
              "761200305"
            ]
          },
          "761200305": {
            "id": "761200305",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "故事还不会结束。",
            "nextDialogs": [
              "761200306"
            ]
          },
          "761200306": {
            "id": "761200306",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "嗯！我也还没看够这位大画家的作品呢。",
            "nextDialogs": [
              "761200307"
            ]
          },
          "761200307": {
            "id": "761200307",
            "speakerId": 1002,
            "speakerName": "梅拉",
            "text": "！！",
            "nextDialogs": [
              "761200308"
            ]
          },
          "761200308": {
            "id": "761200308",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "哦！画好了吗？你的速度真是一如既往地快呢。",
            "nextDialogs": [
              "761200309"
            ]
          },
          "761200309": {
            "id": "761200309",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "我看看…哇！好漂亮！",
            "nextDialogs": [
              "761200310"
            ]
          },
          "761200310": {
            "id": "761200310",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "原来在月球上看提瓦特，是这么美的吗？",
            "nextDialogs": [
              "761200311"
            ]
          },
          "761200311": {
            "id": "761200311",
            "speakerId": 1000,
            "speakerName": "哥伦比娅",
            "text": "哈…我现在能明白，为什么梅拉会说我变得不同了。",
            "nextDialogs": [
              "761200312"
            ]
          },
          "761200312": {
            "id": "761200312",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "嗯？为什么？",
            "nextDialogs": [
              "761200313"
            ]
          },
          "761200313": {
            "id": "761200313",
            "speakerId": 1000,
            "speakerName": "哥伦比娅",
            "text": "看到这幅画后，我想起来了。",
            "nextDialogs": [
              "761200314"
            ]
          },
          "761200314": {
            "id": "761200314",
            "speakerId": 1000,
            "speakerName": "哥伦比娅",
            "text": "当时的我坐在月球上看着提瓦特，心里在想——以前的我，一直都在寻找属于自己的「家」。",
            "nextDialogs": [
              "761200315"
            ]
          },
          "761200315": {
            "id": "761200315",
            "speakerId": 1000,
            "speakerName": "哥伦比娅",
            "text": "但现在，我忽然有了两个「家」。而且它们都如此美丽。",
            "nextDialogs": [
              "761200316"
            ]
          },
          "761200316": {
            "id": "761200316",
            "speakerId": 1000,
            "speakerName": "哥伦比娅",
            "text": "那时我明白了，或许「家」是你珍视的东西、珍视的「家人」和朋友们所在的地方。",
            "nextDialogs": [
              "761200317"
            ]
          },
          "761200317": {
            "id": "761200317",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "不错的感想。",
            "nextDialogs": [
              "761200318"
            ]
          },
          "761200318": {
            "id": "761200318",
            "speakerId": 1000,
            "speakerName": "哥伦比娅",
            "text": "谢谢你，这之后，我想经常带月灵们去月亮上玩。",
            "nextDialogs": [
              "761200319"
            ]
          },
          "761200319": {
            "id": "761200319",
            "speakerId": 1000,
            "speakerName": "哥伦比娅",
            "text": "也欢迎你们，以后一起去我的「另一个家」看看。"
          }
        }
      }
    },

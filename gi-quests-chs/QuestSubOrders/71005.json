  "subQuests": [
    {
      "subId": "7100501",
      "subQuestName": "（test）和翠玦坡附近的考古学家完成对话。$HIDDEN",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "710050101"
        ],
        "dialogs": {
          "710050101": {
            "id": "710050101",
            "speakerId": 1000,
            "speakerName": "铭文",
            "text": "「凡天下战乱，皆起于人心九因…」",
            "nextDialogs": [
              "710050102"
            ]
          },
          "710050102": {
            "id": "710050102",
            "speakerId": 1000,
            "speakerName": "铭文",
            "text": "「立九柱以靖世，镇纷战于此，愿再不起刀兵…」"
          }
        }
      }
    },
    {
      "subId": "7100510",
      "subQuestName": "（test）解除9颗岩柱$HIDDEN",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "710051001"
        ],
        "dialogs": {
          "710051001": {
            "id": "710051001",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "我卖了。",
            "nextDialogs": [
              "710051002"
            ]
          },
          "710051002": {
            "id": "710051002",
            "speakerId": 1001,
            "speakerName": "琳琅",
            "text": "这些是钱，这枚戒指我就收下了。",
            "nextDialogs": [
              "710051003"
            ]
          },
          "710051003": {
            "id": "710051003",
            "speakerId": 1001,
            "speakerName": "琳琅",
            "text": "如果你以后还有什么古董想要出手，可以再来我这里。"
          }
        }
      }
    },
    {
      "subId": "7100509",
      "subQuestName": "（test）解除9颗岩柱$HIDDEN",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "710050901"
        ],
        "dialogs": {
          "710050901": {
            "id": "710050901",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "想请你看样古玩…",
            "nextDialogs": [
              "710050902"
            ]
          },
          "710050902": {
            "id": "710050902",
            "speakerId": 1001,
            "speakerName": "琳琅",
            "text": "古玩？嗯，你算是找对人了，这璃月港里，我对古玩的估价最公道了，拿出来看看吧。",
            "nextDialogs": [
              "710050903"
            ]
          },
          "710050903": {
            "id": "710050903",
            "speakerId": 1001,
            "speakerName": "琳琅",
            "text": "嗯，玉石和戒身都是不错的材质。年代似乎也很久远了…唔，戒指保存得也很完好，真是难得。",
            "nextDialogs": [
              "710050904"
            ]
          },
          "710050904": {
            "id": "710050904",
            "speakerId": 1001,
            "speakerName": "琳琅",
            "text": "不过，「世间纷难，众生皆苦」这句铭文我倒是没听过。",
            "nextDialogs": [
              "710050905"
            ]
          },
          "710050905": {
            "id": "710050905",
            "speakerId": 1001,
            "speakerName": "琳琅",
            "text": "算了，你是从哪里拿到这枚戒指的？",
            "nextDialogs": [
              "710050906"
            ]
          },
          "710050906": {
            "id": "710050906",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "翠玦坡旁的遗迹。",
            "nextDialogs": [
              "710050907"
            ]
          },
          "710050907": {
            "id": "710050907",
            "speakerId": 1001,
            "speakerName": "琳琅",
            "text": "翠玦坡旁的遗迹…居然敢去那里寻宝，那你的身手还挺不错的。",
            "nextDialogs": [
              "710050908"
            ]
          },
          "710050908": {
            "id": "710050908",
            "speakerId": 1001,
            "speakerName": "琳琅",
            "text": "那片遗迹，周围是不是有九根柱子，中间还有一块石碑？",
            "nextDialogs": [
              "710050909"
            ]
          },
          "710050909": {
            "id": "710050909",
            "speakerId": 1001,
            "speakerName": "琳琅",
            "text": "别这么惊讶，我经常听来我这里做生意的人提起那片遗迹，说是那么大的阵仗，里面一定埋着好宝贝。",
            "nextDialogs": [
              "710050910"
            ]
          },
          "710050910": {
            "id": "710050910",
            "speakerId": 1001,
            "speakerName": "琳琅",
            "text": "有些人还说，这些柱子和里面的那个遗迹，都是璃月先民们为了镇压战乱而建造…",
            "nextDialogs": [
              "710050911"
            ]
          },
          "710050911": {
            "id": "710050911",
            "speakerId": 1001,
            "speakerName": "琳琅",
            "text": "不过，这大概也就是传说罢了，九根石头柱子就能镇压战乱的话，那这个世界早就太平了。",
            "nextDialogs": [
              "710050912"
            ]
          },
          "710050912": {
            "id": "710050912",
            "speakerId": 1001,
            "speakerName": "琳琅",
            "text": "但无论这些传说到底是真是假，这枚戒指既然是那片遗迹里的，自然也和这些传说有关系。",
            "nextDialogs": [
              "710050913"
            ]
          },
          "710050913": {
            "id": "710050913",
            "speakerId": 1001,
            "speakerName": "琳琅",
            "text": "既能套上名头，又有来历可说，本身品质也不错，自然也能卖个好价钱。",
            "nextDialogs": [
              "710050914"
            ]
          },
          "710050914": {
            "id": "710050914",
            "speakerId": 1001,
            "speakerName": "琳琅",
            "text": "…放心，我不会追问你是怎么打开那片遗迹的。我只是做生意而已，其余的事，和我没关系。",
            "nextDialogs": [
              "710050915"
            ]
          },
          "710050915": {
            "id": "710050915",
            "speakerId": 1001,
            "speakerName": "琳琅",
            "text": "总之，这枚戒指，我出<color=#00E1FFFF>200000摩拉</color>，怎么样？"
          }
        }
      }
    },
    {
      "subId": "7100508",

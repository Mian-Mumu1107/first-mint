          "710050201"
        ],
        "dialogs": {
          "710050201": {
            "id": "710050201",
            "speakerId": 1003,
            "speakerName": "派蒙",
            "text": "这个遗迹里的氛围，总感觉让人不是很舒服，不过，这应该就是这个遗迹的尽头了",
            "nextDialogs": [
              "710050202"
            ]
          },
          "710050202": {
            "id": "710050202",
            "speakerId": 1003,
            "speakerName": "派蒙",
            "text": "这一趟也算是有所收获啦，嘿嘿，还拿到了那枚戒指。",
            "nextDialogs": [
              "710050203"
            ]
          },
          "710050203": {
            "id": "710050203",
            "speakerId": 1003,
            "speakerName": "派蒙",
            "text": "我们快出去，找一些<color=#00E1FFFF>懂古玩的人</color>来看看，这个宝物到底能卖多少钱吧。"
          }
        }
      }
    },
    {

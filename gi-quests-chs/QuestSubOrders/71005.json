      }
    },
    {
      "subId": "7100507",
      "subQuestName": "（test）解除9颗岩柱$HIDDEN",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "710050701"
        ],
        "dialogs": {
          "710050701": {
            "id": "710050701",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "关于那枚戒指…",
            "nextDialogs": [
              "710050702"
            ]
          },
          "710050702": {
            "id": "710050702",
            "speakerId": 1002,
            "speakerName": "博来",

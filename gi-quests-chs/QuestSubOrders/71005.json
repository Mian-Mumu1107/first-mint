    {
      "subId": "7100512",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "710051201"
        ],
        "dialogs": {
          "710051201": {
            "id": "710051201",
            "speakerId": 1000,
            "speakerName": "铭文",
            "text": "「贪心、眷恋、凝视、妒忌、嗔怒、恶欲、自矜、竞夺、动乱…」",
            "nextDialogs": [
              "710051202"
            ]
          },
          "710051202": {
            "id": "710051202",
            "speakerId": 1000,
            "speakerName": "铭文",
            "text": "「此凡心九种，既可助世，又可乱世，不褪不灭，绵延不绝…故立九柱以靖世，镇世间纷战于此。」",
            "nextDialogs": [
              "710051203"
            ]
          },
          "710051203": {
            "id": "710051203",
            "speakerId": 1000,
            "speakerName": "铭文",
            "text": "「若有后世者破靖世九柱入内，世间必刀兵又起。」",
            "nextDialogs": [
              "710051204"
            ]
          },
          "710051204": {
            "id": "710051204",
            "speakerId": 1000,
            "speakerName": "铭文",
            "text": "「正读此碑者，可自取室内宝器，镇守璃月八方。」"
          }
        }
      }
    },
    {
      "subId": "7100513",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [

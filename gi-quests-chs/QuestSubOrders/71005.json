    {
      "subId": "7100505",
      "subQuestName": "（test）解除9颗岩柱$HIDDEN",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "710050501"
        ],
        "dialogs": {
          "710050501": {
            "id": "710050501",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "我再想想。",
            "nextDialogs": [
              "710050502"
            ]
          },
          "710050502": {
            "id": "710050502",
            "speakerId": 1002,
            "speakerName": "博来",
            "text": "您…也行吧，您再想想，要论价钱，我说不定不是开价最高的。",
            "nextDialogs": [
              "710050503"
            ]
          },
          "710050503": {
            "id": "710050503",
            "speakerId": 1002,
            "speakerName": "博来",
            "text": "但要是论生意，您把戒指卖我，我绝不会亏您的。",
            "nextDialogs": [
              "710050504"
            ]
          },
          "710050504": {
            "id": "710050504",
            "speakerId": 1002,
            "speakerName": "博来",
            "text": "您想，这宝贝戒指哪能是一锤子买卖，您把戒指卖我，要是以后有什么后续买卖，我还不得先来告诉您？",
            "nextDialogs": [
              "710050505"
            ]
          },
          "710050505": {
            "id": "710050505",
            "speakerId": 1002,
            "speakerName": "博来",
            "text": "再说了，我不还会搭您点东西嘛…",
            "nextDialogs": [
              "710050506"
            ]
          },
          "710050506": {
            "id": "710050506",
            "speakerId": 1002,
            "speakerName": "博来",
            "text": "您好好想，好好想啊，要是愿意把戒指卖给我，您尽管来！"
          }
        }
      }
    },
    {
      "subId": "7100504",
      "subQuestName": "（test）解除9颗岩柱$HIDDEN",
      "sceneId": null,
      "locations": [],
      "dialogue": {

    },
    {
      "subId": "7100503",
      "subQuestName": "（test）解除9颗岩柱$HIDDEN",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "710050301"
        ],
        "dialogs": {
          "710050301": {
            "id": "710050301",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "想请你看样古玩…",
            "nextDialogs": [
              "710050302"
            ]
          },
          "710050302": {
            "id": "710050302",
            "speakerId": 1002,
            "speakerName": "博来",
            "text": "古玩啊，我可不太了解…不过，还是先拿出来看看吧。",
            "nextDialogs": [
              "710050303"
            ]
          },
          "710050303": {
            "id": "710050303",
            "speakerId": 1002,
            "speakerName": "博来",
            "text": "这枚戒指…我看看，粗琢的玉石，哟呵，这玉石的料子还不错，光是这颗玉石就能值点钱了。",
            "nextDialogs": [
              "710050304"
            ]
          },
          "710050304": {
            "id": "710050304",
            "speakerId": 1002,
            "speakerName": "博来",
            "text": "这戒托…里头还刻着字，「世间纷难，众生皆苦」…这戒指，您是从哪拿出来的？",
            "nextDialogs": [
              "710050305"
            ]
          },
          "710050305": {
            "id": "710050305",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "翠玦坡旁的遗迹。",
            "nextDialogs": [
              "710050306"
            ]
          },
          "710050306": {
            "id": "710050306",
            "speakerId": 1002,
            "speakerName": "博来",
            "text": "翠玦坡，翠玦坡…啧啧，可惜了，旁边就是绝云间…",
            "nextDialogs": [
              "710050307"
            ]
          },
          "710050307": {
            "id": "710050307",
            "speakerId": 1002,
            "speakerName": "博来",
            "text": "要是这戒指是从绝云间里的哪个遗迹中带出来的，那准能卖个好价钱。",
            "nextDialogs": [
              "710050308"
            ]
          },
          "710050308": {
            "id": "710050308",
            "speakerId": 1002,
            "speakerName": "博来",
            "text": "可惜了，没点来头，这价钱得低不少。不过这戒指的品相不错，单卖出去也肯定有人要。",
            "nextDialogs": [
              "710050309"
            ]
          },
          "710050309": {
            "id": "710050309",
            "speakerId": 1002,
            "speakerName": "博来",
            "text": "这样，我出<color=#00E1FFFF>180000摩拉</color>，再搭您点东西，您看，愿意把这戒指出给我吗？"
          }
        }
      }
    },
    {
      "subId": "7100502",
      "subQuestName": "（test）解除9颗岩柱$HIDDEN",
      "sceneId": null,
      "locations": [],
      "dialogue": {

        "dialogs": {
          "10293301": {
            "id": "10293301",
            "speakerId": 1002,
            "speakerName": "荒泷一斗",
            "text": "阿丑，你说这矮堇瓜是不是睡着了？会做什么梦啊？",
            "nextDialogs": [
              "10293302"
            ]
          },
          "10293302": {
            "id": "10293302",
            "speakerId": 1003,
            "speakerName": "阿丑",
            "text": "哞？哞。",
            "nextDialogs": [
              "10293303"
            ]
          },
          "10293303": {
            "id": "10293303",
            "speakerId": 1002,
            "speakerName": "荒泷一斗",
            "text": "看她平常老是耀武扬威的，居然也有这么没精神的时候，唉…好可怜。",
            "nextDialogs": [
              "10293304"
            ]
          },
          "10293304": {
            "id": "10293304",
            "speakerId": 1002,
            "speakerName": "荒泷一斗",
            "text": "还有那个小哥，看着很疲惫。一个两个，真叫人担心啊。",
            "nextDialogs": [
              "10293305"
            ]
          },
          "10293305": {
            "id": "10293305",
            "speakerId": 1003,
            "speakerName": "阿丑",
            "text": "哞哞哞。",
            "nextDialogs": [
              "10293306"
            ]
          },
          "10293306": {
            "id": "10293306",
            "speakerId": 1002,
            "speakerName": "荒泷一斗",
            "text": "我在牢房里也这样睡？你可真会开玩笑。本大爷的睡姿肯定是全世界最帅…",
            "nextDialogs": [
              "10293307"
            ]
          },
          "10293307": {
            "id": "10293307",
            "speakerId": 1002,
            "speakerName": "荒泷一斗",
            "text": "#{NICKNAME}？！你什么时候过来的？"
          }
        }
      }
    },

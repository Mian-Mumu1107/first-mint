  "subQuests": [
    {
      "subId": "1111301",
      "subQuestName": "将信物带去无妄坡，交给胡桃",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "111130101"
        ],
        "dialogs": {
          "111130101": {
            "id": "111130101",
            "speakerId": 1000,
            "speakerName": "胡桃",
            "text": "哦——！回来啦？比我想的还快！",
            "nextDialogs": [
              "111130102"
            ]
          },
          "111130102": {
            "id": "111130102",
            "speakerId": 1000,
            "speakerName": "胡桃",
            "text": "派蒙，没有说漏嘴吧？",
            "nextDialogs": [
              "111130103"
            ]
          },
          "111130103": {
            "id": "111130103",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "我看起来有这么不可靠吗！",
            "nextDialogs": [
              "111130104"
            ]
          },
          "111130104": {
            "id": "111130104",
            "speakerId": 1000,
            "speakerName": "胡桃",
            "text": "嘿嘿，开玩笑的，其实没关系，他们愿意拿出信物，就说明他们多少猜到了一些。",
            "nextDialogs": [
              "111130105"
            ]
          },
          "111130105": {
            "id": "111130105",
            "speakerId": 1000,
            "speakerName": "胡桃",
            "text": "不过，幽灵和亡魂相关的事，无论发生什么，都是奇怪的，同时也是不奇怪的。",
            "nextDialogs": [
              "111130106"
            ]
          },
          "111130106": {
            "id": "111130106",
            "speakerId": 1000,
            "speakerName": "胡桃",
            "text": "他们不愿深究也是因为这一原因吧。要是真敢跟来，那…可就触碰到我的底线喽。",
            "nextDialogs": [
              "111130109"
            ]
          },
          "111130109": {
            "id": "111130109",
            "speakerId": 1000,
            "speakerName": "胡桃",
            "text": "「维护生死的边界」，这是往生堂最重要的工作内容嘛，我也会稍微比平时认真一点。",
            "nextDialogs": [
              "111130110"
            ]
          },
          "111130110": {
            "id": "111130110",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "原来我们已经是特例了吗？跨越这种「边界」也没关系了？",
            "nextDialogs": [
              "111130111"
            ]
          },
          "111130111": {
            "id": "111130111",
            "speakerId": 1000,
            "speakerName": "胡桃",
            "text": "那是当然，毕竟你们已经被卷进来了，和老孟一样，不在乎让你们多看点东西。",
            "nextDialogs": [
              "111130112"
            ]
          },
          "111130112": {
            "id": "111130112",
            "speakerId": 1000,
            "speakerName": "胡桃",
            "text": "接下来要去的地方，无论看到什么，发生什么，都不要觉得惊讶。",
            "nextDialogs": [
              "111130113"
            ]
          },
          "111130113": {
            "id": "111130113",
            "speakerId": 1000,
            "speakerName": "胡桃",
            "text": "那是存在于生死边界的平凡之地。要说特别之处，也就是不为人知而已。",
            "nextDialogs": [
              "111130114"
            ]
          },
          "111130114": {
            "id": "111130114",
            "speakerId": 1000,
            "speakerName": "胡桃",
            "text": "千万千万不要大惊小怪哦？否则出来之前，我就得为你们清理记忆了。",
            "nextDialogs": [
              "111130115"
            ]
          },
          "111130115": {
            "id": "111130115",
            "speakerId": 1000,
            "speakerName": "胡桃",
            "text": "走吧！听话一点对大家都好。",
            "nextDialogs": [
              "111130116"
            ]
          },
          "111130116": {
            "id": "111130116",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "有、有点吓人…",
            "nextDialogs": [
              "111130117"
            ]
          },
          "111130117": {
            "id": "111130117",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "但就像她说的，我们已经被卷进来了，就走到最后吧。"
          }
        }
      }
    },
    {
      "subId": "1111302",
      "subQuestName": "前往胡桃所说的「寻常之地」",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "111130201"
        ],
        "dialogs": {
          "111130201": {
            "id": "111130201",
            "speakerId": 1000,
            "speakerName": "胡桃",
            "text": "(test)进入夹缝"
          }
        }
      }
    },
    {
      "subId": "1111306",
      "subQuestName": "（test）通过第一个降魔印机关$HIDDEN",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "111130601"
        ],
        "dialogs": {
          "111130601": {
            "id": "111130601",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "终于过来了，我还以为我们被困在了诡异的空间里面呢。",
            "nextDialogs": [
              "111130602"
            ]
          },
          "111130602": {
            "id": "111130602",
            "speakerId": 1000,
            "speakerName": "胡桃",
            "text": "就是要给人这样的感觉，才能把擅闯者吓跑嘛。",
            "nextDialogs": [
              "111130603"
            ]
          },
          "111130603": {
            "id": "111130603",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "之后应该不会再有什么古怪的东西了吧？",
            "nextDialogs": [
              "111130604"
            ]
          },
          "111130604": {
            "id": "111130604",
            "speakerId": 1000,
            "speakerName": "胡桃",
            "text": "嗯，只需要从前面跳下去。",
            "nextDialogs": [
              "111130605"
            ]
          },
          "111130605": {
            "id": "111130605",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "欸欸——？！"
          }
        }
      }
    },
    {
      "subId": "1111308",
      "subQuestName": "（test）通过第二个降魔印机关$HIDDEN",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "111130801"
        ],
        "dialogs": {
          "111130801": {
            "id": "111130801",
            "speakerId": 1002,
            "speakerName": "狼哥",
            "text": "哇，这上面居然有我们五个人的名字？",
            "nextDialogs": [
              "111130802"
            ]
          },
          "111130802": {
            "id": "111130802",
            "speakerId": 1002,
            "speakerName": "狼哥",
            "text": "嘿嘿，真好。对了，刚刚听你说每一年都会放灯，那以后上面的名字会不会越来越多？",
            "nextDialogs": [
              "111130803"
            ]
          },
          "111130803": {
            "id": "111130803",
            "speakerId": 1002,
            "speakerName": "狼哥",
            "text": "比如，小五的孩子，木木的妻子之类的。",
            "nextDialogs": [
              "111130804"
            ]
          },
          "111130804": {
            "id": "111130804",
            "speakerId": 1003,
            "speakerName": "老孟",
            "text": "其实确实有个好消息，木木他马上就要当爸爸了，最近总是在说这件事，好像既开心又紧张。",
            "nextDialogs": [
              "111130805"
            ]
          },
          "111130805": {
            "id": "111130805",
            "speakerId": 1002,
            "speakerName": "狼哥",
            "text": "哈哈哈，他这么木讷的人，能当好爸爸吗？",
            "nextDialogs": [
              "111130806"
            ]
          },
          "111130806": {
            "id": "111130806",
            "speakerId": 1003,
            "speakerName": "老孟",
            "text": "不不不，他现在精明得很，我来好好给你讲讲——"
          }
        }
      }
    },
    {
      "subId": "1111303",
      "subQuestName": "沿路深入，前往边界",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [],
        "dialogs": {}
      }
    },
    {
      "subId": "1111304",
      "subQuestName": "继续向前，见证欢送仪式",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "111130401"
        ],
        "dialogs": {
          "111130401": {
            "id": "111130401",
            "speakerId": 1004,
            "speakerName": "回忆中的小五",
            "text": "又是海灯节，要是有一天能真的去看灯就好了。",
            "nextDialogs": [
              "111130402"
            ]
          },
          "111130402": {
            "id": "111130402",
            "speakerId": 1005,
            "speakerName": "回忆中的聪子",
            "text": "没有灯也可以许愿啊，我妈妈告诉我的，只要大声喊出来，梦想就会在未来实现。",
            "nextDialogs": [
              "111130403"
            ]
          },
          "111130403": {
            "id": "111130403",
            "speakerId": 1006,
            "speakerName": "回忆中的狼哥",
            "text": "大声喊出来，是不是…有点丢脸？",
            "nextDialogs": [
              "111130404"
            ]
          },
          "111130404": {
            "id": "111130404",
            "speakerId": 1007,
            "speakerName": "回忆中的老孟",
            "text": "你需要有人帮你起个头，大家都喊了，你就不会害羞了。",
            "nextDialogs": [
              "111130405"
            ]
          },
          "111130405": {
            "id": "111130405",
            "speakerId": 1005,
            "speakerName": "回忆中的聪子",
            "text": "对对对，那小五，你先来。",
            "nextDialogs": [
              "111130406"
            ]
          },
          "111130406": {
            "id": "111130406",
            "speakerId": 1004,
            "speakerName": "回忆中的小五",
            "text": "那…那我想，开一家大大的餐馆，有吃不完的饭菜还有点心！天天都能吃香嫩椒椒鸡！",
            "nextDialogs": [
              "111130407"
            ]
          },
          "111130407": {
            "id": "111130407",
            "speakerId": 1008,
            "speakerName": "回忆中的木木",
            "text": "哈哈哈，瞧你这出息。",
            "nextDialogs": [
              "111130408"
            ]
          },
          "111130408": {
            "id": "111130408",
            "speakerId": 1004,
            "speakerName": "回忆中的小五",
            "text": "你笑我，那你呢？",
            "nextDialogs": [
              "111130409"
            ]
          },
          "111130409": {
            "id": "111130409",
            "speakerId": 1008,
            "speakerName": "回忆中的木木",
            "text": "那当然是赚钱！做大生意，赚很多很多钱！有钱了想干什么干什么，有钱了多开心啊！",
            "nextDialogs": [
              "111130410"
            ]
          },
          "111130410": {
            "id": "111130410",
            "speakerId": 1007,
            "speakerName": "回忆中的老孟",
            "text": "对啊，有了钱，那个超贵的玩具箱，不也是想买就能买？",
            "nextDialogs": [
              "111130411"
            ]
          },
          "111130411": {
            "id": "111130411",
            "speakerId": 1008,
            "speakerName": "回忆中的木木",
            "text": "不仅要买，还一人一个，不，一人好几个！",
            "nextDialogs": [
              "111130412"
            ]
          },
          "111130412": {
            "id": "111130412",
            "speakerId": 1005,
            "speakerName": "回忆中的聪子",
            "text": "那既然木木要当大商人，我就没必要赚钱了吧。",
            "nextDialogs": [
              "111130413"
            ]
          },
          "111130413": {
            "id": "111130413",
            "speakerId": 1008,
            "speakerName": "回忆中的木木",
            "text": "不行不行，赚钱很辛苦的，别光指望我一个人啊！",
            "nextDialogs": [
              "111130414"
            ]
          },
          "111130414": {
            "id": "111130414",
            "speakerId": 1005,
            "speakerName": "回忆中的聪子",
            "text": "我以后，想学做明霄灯，就是好大好大的那个。霄灯我也要学，到时候当最好的工匠。",
            "nextDialogs": [
              "111130415"
            ]
          },
          "111130415": {
            "id": "111130415",
            "speakerId": 1006,
            "speakerName": "回忆中的狼哥",
            "text": "对哦，这样我们就不用去璃月港，也可以放霄灯过节了！",
            "nextDialogs": [
              "111130416"
            ]
          },
          "111130416": {
            "id": "111130416",
            "speakerId": 1004,
            "speakerName": "回忆中的小五",
            "text": "说了这么多，老孟，狼哥，你们两个呢？",
            "nextDialogs": [
              "111130417"
            ]
          },
          "111130417": {
            "id": "111130417",
            "speakerId": 1006,
            "speakerName": "回忆中的狼哥",
            "text": "我啊…",
            "nextDialogs": [
              "111130418"
            ]
          },
          "111130418": {
            "id": "111130418",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "啊，都消失了，最关键的东西没听到。",
            "nextDialogs": [
              "111130419"
            ]
          },
          "111130419": {
            "id": "111130419",
            "speakerId": 1003,
            "speakerName": "老孟",
            "text": "真怀念啊，这是我们最后一次，五个人一起过的海灯节吧。",
            "nextDialogs": [
              "111130420"
            ]
          },
          "111130420": {
            "id": "111130420",
            "speakerId": 1002,
            "speakerName": "狼哥",
            "text": "都已经过去这么久了，大家都长大了…",
            "nextDialogs": [
              "111130421"
            ]
          },
          "111130421": {
            "id": "111130421",
            "speakerId": 1002,
            "speakerName": "狼哥",
            "text": "不知道当时喊出来的这些愿望，真的实现了吗？",
            "nextDialogs": [
              "111130424"
            ]
          },
          "111130424": {
            "id": "111130424",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "我们去找了他们三个，把信物都要来了！",
            "nextDialogs": [
              "111130425"
            ]
          },
          "111130425": {
            "id": "111130425",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "小五当了大厨，木木成了大商人，聪子也成了霄灯工匠！",
            "nextDialogs": [
              "111130426"
            ]
          },
          "111130426": {
            "id": "111130426",
            "speakerId": 1002,
            "speakerName": "狼哥",
            "text": "这样啊…",
            "nextDialogs": [
              "111130427"
            ]
          },
          "111130427": {
            "id": "111130427",
            "speakerId": 1002,
            "speakerName": "狼哥",
            "text": "唔…",
            "nextDialogs": [
              "111130428"
            ]
          },
          "111130428": {
            "id": "111130428",
            "speakerId": 1003,
            "speakerName": "老孟",
            "text": "当初说的，我们一直都记在心上，当作是无论如何都要完成的约定。",
            "nextDialogs": [
              "111130429"
            ]
          },
          "111130429": {
            "id": "111130429",
            "speakerId": 1003,
            "speakerName": "老孟",
            "text": "总之，先把这盏灯放起来吧。",
            "nextDialogs": [
              "111130430"
            ]
          },
          "111130430": {
            "id": "111130430",
            "speakerId": 1000,
            "speakerName": "胡桃",
            "text": "#喂，{NICKNAME}，别不解风情啦。",
            "nextDialogs": [
              "111130431"
            ]
          },
          "111130431": {
            "id": "111130431",
            "speakerId": 1000,
            "speakerName": "胡桃",
            "text": "他们叙旧的时候，我们站远一点随便聊聊吧。"
          }
        }
      }
    },
    {
      "subId": "1111305",
      "subQuestName": "与胡桃交谈，等待两人叙旧",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "111130501"
        ],
        "dialogs": {
          "111130501": {
            "id": "111130501",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "说我们不解风情，明明你才是最看不懂气氛的人。",
            "nextDialogs": [
              "111130503",
              "111130505"
            ]
          },
          "111130503": {
            "id": "111130503",
            "speakerId": 1000,
            "speakerName": "胡桃",
            "text": "老孟是已经跨越「边界」的人，只能像这样把他送回去。",
            "nextDialogs": [
              "111130506"
            ]
          },
          "111130506": {
            "id": "111130506",
            "speakerId": 1000,
            "speakerName": "胡桃",
            "text": "我之前说过，往生堂一开始做的并不是葬仪，而是类似医生一样的工作。",
            "nextDialogs": [
              "111130507"
            ]
          },
          "111130507": {
            "id": "111130507",
            "speakerId": 1000,
            "speakerName": "胡桃",
            "text": "魔神战争时期，尸横遍野，生灵涂炭，传染病四处蔓延，「死亡」疯狂侵吞我们生者的世界。",
            "nextDialogs": [
              "111130508"
            ]
          },
          "111130508": {
            "id": "111130508",
            "speakerId": 1000,
            "speakerName": "胡桃",
            "text": "那时候，往生堂诞生了，以微不足道的人类的身份，花费了漫长的时间，将死亡赶了回去。",
            "nextDialogs": [
              "111130509"
            ]
          },
          "111130509": {
            "id": "111130509",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "感觉付出了很大的代价。",
            "nextDialogs": [
              "111130510"
            ]
          },
          "111130510": {
            "id": "111130510",
            "speakerId": 1000,
            "speakerName": "胡桃",
            "text": "又过了很长时间，璃月港繁荣兴旺，所有人都在追逐名誉与摩拉，最后，疯狂的人触动了死亡的「遗产」。",
            "nextDialogs": [
              "111130511"
            ]
          },
          "111130511": {
            "id": "111130511",
            "speakerId": 1000,
            "speakerName": "胡桃",
            "text": "魔神残渣肆虐人世，具体的就不提了，总之那是「生」于极致的自毁，也是「死」在尽头的反噬。",
            "nextDialogs": [
              "111130512"
            ]
          },
          "111130512": {
            "id": "111130512",
            "speakerId": 1000,
            "speakerName": "胡桃",
            "text": "在那之后又是很久很久，很久很久，平衡恢复，界线划清，才有了今天你们见到的璃月港，你们见到的往生堂，还有，我。"
          },
          "111130505": {
            "id": "111130505",
            "speakerId": 1000,
            "speakerName": "胡桃",
            "text": "是吗？只要能达成目标，做什么和怎么做都是细节问题吧。"
          }
        }
      }
    },
    {
      "subId": "1111307",
      "subQuestName": "回到无妄坡，为狼哥送别",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "111130701"
        ],
        "dialogs": {
          "111130701": {
            "id": "111130701",
            "speakerId": 1000,
            "speakerName": "胡桃",
            "text": "狼哥，现在你应该很满足了吧？",
            "nextDialogs": [
              "111130702"
            ]
          },
          "111130702": {
            "id": "111130702",
            "speakerId": 1000,
            "speakerName": "胡桃",
            "text": "如果以后再动了什么歪念头，真的变成恶鬼，我可是会不念旧情直接消灭你的。",
            "nextDialogs": [
              "111130703"
            ]
          },
          "111130703": {
            "id": "111130703",
            "speakerId": 1002,
            "speakerName": "狼哥",
            "text": "不会的，不会的，你们为我做了这么多，我已经心满意足了。",
            "nextDialogs": [
              "111130704"
            ]
          },
          "111130704": {
            "id": "111130704",
            "speakerId": 1002,
            "speakerName": "狼哥",
            "text": "知道大家过得都很好，我也不想打扰他们的生活。",
            "nextDialogs": [
              "111130705"
            ]
          },
          "111130705": {
            "id": "111130705",
            "speakerId": 1003,
            "speakerName": "老孟",
            "text": "我也要谢谢你们，这也算是圆了我的一场梦。",
            "nextDialogs": [
              "111130706"
            ]
          },
          "111130706": {
            "id": "111130706",
            "speakerId": 1000,
            "speakerName": "胡桃",
            "text": "那刚刚的话也送给你，老孟，要是在这之后还念念不舍，我就提前一点送你们团聚。",
            "nextDialogs": [
              "111130707"
            ]
          },
          "111130707": {
            "id": "111130707",
            "speakerId": 1003,
            "speakerName": "老孟",
            "text": "不、不会的…不要笑着说这么可怕的事。",
            "nextDialogs": [
              "111130708"
            ]
          },
          "111130708": {
            "id": "111130708",
            "speakerId": 1000,
            "speakerName": "胡桃",
            "text": "哈哈哈。那么，最后的最后，每人都给狼哥送上一句告别吧。",
            "nextDialogs": [
              "111130709"
            ]
          },
          "111130709": {
            "id": "111130709",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "再见啦，狼哥。",
            "nextDialogs": [
              "111130710"
            ]
          },
          "111130710": {
            "id": "111130710",
            "speakerId": 1000,
            "speakerName": "胡桃",
            "text": "不对不对，不能再见，最多是「慢走」之类的说法，可不能「再见」啊。",
            "nextDialogs": [
              "111130711"
            ]
          },
          "111130711": {
            "id": "111130711",
            "speakerId": 1002,
            "speakerName": "狼哥",
            "text": "哈哈哈，没关系，我安静离开就好了。",
            "nextDialogs": [
              "111130712"
            ]
          },
          "111130712": {
            "id": "111130712",
            "speakerId": 1002,
            "speakerName": "狼哥",
            "text": "抱歉啊，只有我们当时喊出来的梦想，没办法实现了。",
            "nextDialogs": [
              "111130713"
            ]
          },
          "111130713": {
            "id": "111130713",
            "speakerId": 1003,
            "speakerName": "老孟",
            "text": "没关系，总会有遗憾的，你就安心上路吧。",
            "nextDialogs": [
              "111130714"
            ]
          },
          "111130714": {
            "id": "111130714",
            "speakerId": 1002,
            "speakerName": "狼哥",
            "text": "嗯，我会记住大家的，各位再见！",
            "nextDialogs": [
              "111130715"
            ]
          },
          "111130715": {
            "id": "111130715",
            "speakerId": 1003,
            "speakerName": "老孟",
            "text": "走掉了，唉…",
            "nextDialogs": [
              "111130716"
            ]
          },
          "111130716": {
            "id": "111130716",
            "speakerId": 1003,
            "speakerName": "老孟",
            "text": "就像是了结了人生中的一件大事，还是觉得心里空荡荡的。",
            "nextDialogs": [
              "111130717"
            ]
          },
          "111130717": {
            "id": "111130717",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "所以，之前没有听到，你们两个人的愿望是什么？",
            "nextDialogs": [
              "111130718"
            ]
          },
          "111130718": {
            "id": "111130718",
            "speakerId": 1003,
            "speakerName": "老孟",
            "text": "「成家立业之后，两家人一起过海灯节。」",
            "nextDialogs": [
              "111130719"
            ]
          },
          "111130719": {
            "id": "111130719",
            "speakerId": 1003,
            "speakerName": "老孟",
            "text": "所以我很羡慕我的朋友们，小五他们都还有机会实现梦想，但是我的梦想，终究是没有机会了…",
            "nextDialogs": [
              "111130722"
            ]
          },
          "111130722": {
            "id": "111130722",
            "speakerId": 1000,
            "speakerName": "胡桃",
            "text": "对嘛对嘛，而且你这么想，谁都会有被烧掉的一天。",
            "nextDialogs": [
              "111130723"
            ]
          },
          "111130723": {
            "id": "111130723",
            "speakerId": 1000,
            "speakerName": "胡桃",
            "text": "活着的时候好好活着，当活着的职责履行完了，你还能见到你想见的人，不也是一件好事吗？",
            "nextDialogs": [
              "111130724"
            ]
          },
          "111130724": {
            "id": "111130724",
            "speakerId": 1003,
            "speakerName": "老孟",
            "text": "呃…谢、谢谢。",
            "nextDialogs": [
              "111130725"
            ]
          },
          "111130725": {
            "id": "111130725",
            "speakerId": 1003,
            "speakerName": "老孟",
            "text": "总之，我以后应该再也不会回无妄坡了，我也需要好好收拾收拾我的心情。",
            "nextDialogs": [
              "111130726"
            ]
          },
          "111130726": {
            "id": "111130726",
            "speakerId": 1000,
            "speakerName": "胡桃",
            "text": "没关系，那就趁这个机会出去玩玩吧，我准假了。啊，当然和现在一样，是没有工钱的。",
            "nextDialogs": [
              "111130727"
            ]
          },
          "111130727": {
            "id": "111130727",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "不过，好像是不是忘了一件什么事？",
            "nextDialogs": [
              "111130728"
            ]
          },
          "111130728": {
            "id": "111130728",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "说好的「找人」。",
            "nextDialogs": [
              "111130729"
            ]
          },
          "111130729": {
            "id": "111130729",
            "speakerId": 1000,
            "speakerName": "胡桃",
            "text": "嗯？带你们去了「边界」，也是想让你们找找看啊。不过，看你们的反应，应该是没找到，可惜可惜。",
            "nextDialogs": [
              "111130730"
            ]
          },
          "111130730": {
            "id": "111130730",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "才不可惜呢！",
            "nextDialogs": [
              "111130731"
            ]
          },
          "111130731": {
            "id": "111130731",
            "speakerId": 1000,
            "speakerName": "胡桃",
            "text": "哈哈哈，我也帮你们找了找，用了些你们不用知道的办法。可惜我也没找到什么值得追查的东西。",
            "nextDialogs": [
              "111130732"
            ]
          },
          "111130732": {
            "id": "111130732",
            "speakerId": 1000,
            "speakerName": "胡桃",
            "text": "之后我会帮你留意这方面的线索的，一旦有什么消息会直接来找你。",
            "nextDialogs": [
              "111130733"
            ]
          },
          "111130733": {
            "id": "111130733",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "感觉你只是随便说说…",
            "nextDialogs": [
              "111130734"
            ]
          },
          "111130734": {
            "id": "111130734",
            "speakerId": 1000,
            "speakerName": "胡桃",
            "text": "嘿嘿，毕竟找活人不是我擅长的事嘛，如果让我找的是「边界」另一边的人…",
            "nextDialogs": [
              "111130735"
            ]
          },
          "111130735": {
            "id": "111130735",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "不要再说可怕的话了——！",
            "nextDialogs": [
              "111130736"
            ]
          },
          "111130736": {
            "id": "111130736",
            "speakerId": 1000,
            "speakerName": "胡桃",
            "text": "放心放心，会帮你们好好找那个活人的。真是的，什么时候才能听得懂我的玩笑话。"
          }
        }
      }
    },
    {
      "subId": "1111223",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "111122301"
        ],
        "dialogs": {
          "111122301": {
            "id": "111122301",
            "speakerId": 1009,
            "speakerName": "木木",
            "text": "说起来，你们两个人都是亲手做的东西，只有我的是买来的。",
            "nextDialogs": [
              "111122302"
            ]
          },
          "111122302": {
            "id": "111122302",
            "speakerId": 1010,
            "speakerName": "小五",
            "text": "但你那一个，价值上来说，已经是我们的很多很多倍了吧。",
            "nextDialogs": [
              "111122303"
            ]
          },
          "111122303": {
            "id": "111122303",
            "speakerId": 1011,
            "speakerName": "聪子",
            "text": "重要的不是价钱，而是这些东西在我们童年时期的分量。",
            "nextDialogs": [
              "111122304"
            ]
          },
          "111122304": {
            "id": "111122304",
            "speakerId": 1011,
            "speakerName": "聪子",
            "text": "还有，永远不能忘记的承诺啊。"
          }
        }
      }
    },
    {
      "subId": "1111310",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "111131001"
        ],
        "dialogs": {
          "111131001": {
            "id": "111131001",
            "speakerId": 1012,
            "speakerName": "兰溪",
            "text": "你们是…客人？抱歉，只是觉得有点意外。",
            "nextDialogs": [
              "111131002"
            ]
          },
          "111131002": {
            "id": "111131002",
            "speakerId": 1012,
            "speakerName": "兰溪",
            "text": "看到是胡桃带你们来的，我也就安心了，只是这地方什么都没有，也难做什么招待。",
            "nextDialogs": [
              "111131003"
            ]
          },
          "111131003": {
            "id": "111131003",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "你是谁？",
            "nextDialogs": [
              "111131004"
            ]
          },
          "111131004": {
            "id": "111131004",
            "speakerId": 1012,
            "speakerName": "兰溪",
            "text": "我叫兰溪，一直在这里等一个人，已经数不清有多长时间了。",
            "nextDialogs": [
              "111131005"
            ]
          },
          "111131005": {
            "id": "111131005",
            "speakerId": 1012,
            "speakerName": "兰溪",
            "text": "都说等待很难熬，但如果一直在这里走走看看，和新人旧人聊聊天，也没有什么好着急的。",
            "nextDialogs": [
              "111131006"
            ]
          },
          "111131006": {
            "id": "111131006",
            "speakerId": 1012,
            "speakerName": "兰溪",
            "text": "等下去的话，能等到吗？还是等不到呢？",
            "nextDialogs": [
              "111131007"
            ]
          },
          "111131007": {
            "id": "111131007",
            "speakerId": 1012,
            "speakerName": "兰溪",
            "text": "不管怎样都好，我是只能等下去了，如果你也有重要的人，最好就不要一直等下去。"
          }
        }
      }
    },
    {
      "subId": "1111311",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "111131101"
        ],
        "dialogs": {
          "111131101": {
            "id": "111131101",
            "speakerId": 1013,
            "speakerName": "祝明",
            "text": "你是新来的？巧了，我也是！",
            "nextDialogs": [
              "111131102"
            ]
          },
          "111131102": {
            "id": "111131102",
            "speakerId": 1013,
            "speakerName": "祝明",
            "text": "没想到风景这么好！我以为会是黑漆漆，冷冰冰，连方向都分不清的地方呢！",
            "nextDialogs": [
              "111131103"
            ]
          },
          "111131103": {
            "id": "111131103",
            "speakerId": 1013,
            "speakerName": "祝明",
            "text": "能在这里整理心情，再好不过了。哈哈，可能是我原本就没抱什么期待吧。"
          }
        }
      }
    },
    {
      "subId": "1111312",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "111131201"
        ],
        "dialogs": {
          "111131201": {
            "id": "111131201",
            "speakerId": 1014,
            "speakerName": "舒杨",
            "text": "说起来，你这几天见到老张了吗？",
            "nextDialogs": [
              "111131202"
            ]
          },
          "111131202": {
            "id": "111131202",
            "speakerId": 1015,
            "speakerName": "老墨",
            "text": "他啊，我记得他说，差不多该放下了。",
            "nextDialogs": [
              "111131203"
            ]
          },
          "111131203": {
            "id": "111131203",
            "speakerId": 1014,
            "speakerName": "舒杨",
            "text": "哦哦，那是好事啊，不知道接下来他会去什么地方呢？",
            "nextDialogs": [
              "111131204"
            ]
          },
          "111131204": {
            "id": "111131204",
            "speakerId": 1015,
            "speakerName": "老墨",
            "text": "你好奇的话，我们也一起去看看？",
            "nextDialogs": [
              "111131205"
            ]
          },
          "111131205": {
            "id": "111131205",
            "speakerId": 1014,
            "speakerName": "舒杨",
            "text": "哈哈，以后吧，现在我还想多待一待。"
          }
        }
      }
    }
  ]
}
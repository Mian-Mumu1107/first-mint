      }
    },
    {
      "subId": "7418412",
      "subQuestName": "击败复活的石像",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [],
        "dialogs": {}
      }
    },
    {
      "subId": "7418413",
      "subQuestName": "与会说话的猫对话",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "741841301"
        ],
        "dialogs": {
          "741841301": {
            "id": "741841301",
            "speakerId": 10205,
            "speakerName": "？？？",
            "text": "不错，不错，战斗的英姿，丝毫不逊于昔日的「逐影猎人」…",
            "nextDialogs": [
              "741841304"
            ]
          },
          "741841304": {
            "id": "741841304",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "…我们的旅途中倒是已经见过不少怪东西了，事到如今，就算是又会发光又会说话的猫…也还是比较稀有吧…",
            "nextDialogs": [
              "741841305"
            ]
          },
          "741841305": {
            "id": "741841305",
            "speakerId": 1008,
            "speakerName": "发光的猫",
            "text": "#…吾就不纠结于被称为「怪东西」了。{NICKNAME}，还有派蒙，被选中的勇者，现在正是两位这样真正的英雄挺身而出的时刻！",
            "nextDialogs": [
              "741841306"
            ]
          },
          "741841306": {
            "id": "741841306",
            "speakerId": 1008,
            "speakerName": "发光的猫",
            "text": "为了拯救那些迷失的灵魂，请你们立刻动身，随我前往深海的旧日国度，平息失序的「乐章」吧。"
          }
        }
      }
    },
    {
      "subId": "7418414",
      "subQuestName": "跟随小呜斯跃入深泉",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [],
        "dialogs": {}
      }
    },
    {
      "subId": "7418416",
      "subQuestName": "前往水下的「褪色城堡」",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [],
        "dialogs": {}
      }
    },
    {
      "subId": "7418435",
      "subQuestName": "前往水下的「褪色城堡」",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "741843501"
        ],
        "dialogs": {
          "741843501": {
            "id": "741843501",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "没想到下面还有这么大的地方，看来小呜斯没搞错嘛！",
            "nextDialogs": [
              "741843502"
            ]
          },
          "741843502": {
            "id": "741843502",
            "speakerId": 21338,
            "speakerName": "小呜斯",
            "text": "这还只是冰山一角呢！过去曾有一整个国家的陆地坠入水中…而我的使命就是阻止坠入深水之中的东西再度回到地上。",
            "nextDialogs": [
              "741843503"
            ]
          },
          "741843503": {
            "id": "741843503",
            "speakerId": 21338,
            "speakerName": "小呜斯",
            "text": "…似乎是这样。",
            "nextDialogs": [
              "741843505",
              "741843509"
            ]
          },
          "741843505": {
            "id": "741843505",
            "speakerId": 21338,
            "speakerName": "小呜斯",
            "text": "毕竟我只是比镇上的猫稍微懂得多一点的猫而已嘛。",
            "nextDialogs": [
              "741843506"
            ]
          },
          "741843506": {
            "id": "741843506",
            "speakerId": 21338,
            "speakerName": "小呜斯",
            "text": "呵呵，先不说这些了，镇上居民的灵魂能否平安回到各自的躯体就全靠我们了，还得请两位打起精神来呀。",
            "nextDialogs": [
              "741843507"
            ]
          },
          "741843507": {
            "id": "741843507",
            "speakerId": 21338,
            "speakerName": "小呜斯",
            "text": "穿过大门就是褪色城堡了，我们继续前进吧。"
          },
          "741843509": {
            "id": "741843509",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "那么接下来就由我来带路…虽然很想这么说啦！"
          }
        }
      }
    },
    {
      "subId": "7418428",
      "subQuestName": "走向「褪色城堡」",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [],
        "dialogs": {}
      }
    },
    {
      "subId": "7418418",
      "subQuestName": "获得奇妙的音乐盒",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "741841801"
        ],
        "dialogs": {
          "741841801": {
            "id": "741841801",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "哇，这么大的城堡，应该能住很多人吧？",
            "nextDialogs": [
              "741841802"
            ]
          },
          "741841802": {
            "id": "741841802",
            "speakerId": 21338,
            "speakerName": "小呜斯",
            "text": "这是当然，而且不止住过人呢…",
            "nextDialogs": [
              "741841803"
            ]
          },
          "741841803": {
            "id": "741841803",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "喂，小呜斯又在一本正经地说这种吓人的话了！",
            "nextDialogs": [
              "741841804"
            ]
          },
          "741841804": {
            "id": "741841804",
            "speakerId": 21338,
            "speakerName": "小呜斯",
            "text": "哎呀，放心，对于你们这样的勇者来说，就算遇到什么躲藏起来的鬼怪，想必也能轻松解决吧。",
            "nextDialogs": [
              "741841805"
            ]
          },
          "741841805": {
            "id": "741841805",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "这又是什么？好精致的盒子，看起来像是音乐盒嘛！不过摆在这里…和周围的氛围有些格格不入呢。",
            "nextDialogs": [
              "741841806"
            ]
          },
          "741841806": {
            "id": "741841806",
            "speakerId": 21338,
            "speakerName": "小呜斯",
            "text": "好眼力，这的确是音乐盒。不过就像我比普通的猫懂得多一点，这个音乐盒也比普通的音乐盒功能更丰富一点。",
            "nextDialogs": [
              "741841808",
              "741841810"
            ]
          },
          "741841808": {
            "id": "741841808",
            "speakerId": 21338,
            "speakerName": "小呜斯",
            "text": "哦？我倒是没有想到这一层。可惜，它暂时没有这样的功能。",
            "nextDialogs": [
              "741841813"
            ]
          },
          "741841813": {
            "id": "741841813",
            "speakerId": 21338,
            "speakerName": "小呜斯",
            "text": "总之，有了这个，就算是对乐理一无所知的人也能自如使用「乐章」的力量，我们之后会用得上它的。",
            "nextDialogs": [
              "741841814"
            ]
          },
          "741841814": {
            "id": "741841814",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "#欸？可是镇上的居民不就是因为什么「乐章」失序才会变成那副样子吗？万一{NICKNAME}一不小心按错了什么地方…"
          },
          "741841810": {
            "id": "741841810",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "我就是随口那么一说嘛！唔…没想到你会这么认真，是我不好，你不要再生气啦。",
            "nextDialogs": [
              "741841811"
            ]
          },
          "741841811": {
            "id": "741841811",
            "speakerId": 21338,
            "speakerName": "小呜斯",
            "text": "喵喵？",
            "nextDialogs": [
              "741841812"
            ]
          },
          "741841812": {
            "id": "741841812",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "这种时候装猫吗？！"
          }
        }
      }
    },
    {
      "subId": "7418432",
      "subQuestName": "获得奇妙的音乐盒",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "741843201"
        ],
        "dialogs": {
          "741843201": {
            "id": "741843201",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "嗯…听起来是首欢快的曲子呢，感觉心里暖洋洋的…",
            "nextDialogs": [
              "741843202"
            ]
          },
          "741843202": {
            "id": "741843202",
            "speakerId": 21338,
            "speakerName": "小呜斯",
            "text": "嘿嘿，看来音乐盒没有损坏，能够正常运作。瞧，这不是很安全吗？",
            "nextDialogs": [
              "741843203"
            ]
          },
          "741843203": {
            "id": "741843203",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "…原来你根本不知道它还能不能用啊！",
            "nextDialogs": [
              "741843204"
            ]
          },
          "741843204": {
            "id": "741843204",
            "speakerId": 21338,
            "speakerName": "小呜斯",
            "text": "我只是没有十足的确信罢了，毕竟许多事不能只从外部判断，你说对吗？",
            "nextDialogs": [
              "741843205"
            ]
          },
          "741843205": {
            "id": "741843205",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "总觉得你不是在说音乐盒的事…不过这个问题先放一边，我们接下来应该怎么办呢？",
            "nextDialogs": [
              "741843206"
            ]
          },
          "741843206": {
            "id": "741843206",
            "speakerId": 21338,
            "speakerName": "小呜斯",
            "text": "无论如何，失序的「乐章」一定就在这里。如果能探明其所在的话，或许就能找回镇上居民被夺走的灵魂了。",
            "nextDialogs": [
              "741843207"
            ]
          },
          "741843207": {
            "id": "741843207",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "那就先在附近找找看有没有线索吧。",
            "nextDialogs": [
              "741843208"
            ]
          },
          "741843208": {
            "id": "741843208",
            "speakerId": 21338,
            "speakerName": "小呜斯",
            "text": "合理的判断。根据我的记忆，这座城堡里有不少奇妙的房间，或许可以先去调查看看。",
            "nextDialogs": [
              "741843209"
            ]
          },
          "741843209": {
            "id": "741843209",
            "speakerId": 21338,
            "speakerName": "小呜斯",
            "text": "另外，城堡中心的大厅有一座神奇的舞台，虽然现在已经不会有任何剧目上演了…",
            "nextDialogs": [
              "741843210"
            ]
          },
          "741843210": {
            "id": "741843210",
            "speakerId": 21338,
            "speakerName": "小呜斯",
            "text": "但在过去那曾是可以通向水下更深处的入口，「乐章」的力量还残留在那里，也需去确认一下是否有异变发生。",
            "nextDialogs": [
              "741843211"
            ]
          },
          "741843211": {
            "id": "741843211",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "更深的地方…？",
            "nextDialogs": [
              "741843212"
            ]
          },
          "741843212": {
            "id": "741843212",
            "speakerId": 21338,
            "speakerName": "小呜斯",
            "text": "水下更深处究竟有什么等待着我们呢？",
            "nextDialogs": [
              "741843213"
            ]
          },
          "741843213": {
            "id": "741843213",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "在这种时候卖关子喔！小呜斯意外的还挺坏心眼的呢。",
            "nextDialogs": [
              "741843214"
            ]
          },
          "741843214": {
            "id": "741843214",
            "speakerId": 21338,
            "speakerName": "小呜斯",
            "text": "但是在谜底揭晓以前，我们得先在城堡找到线索。这就行动起来吧。"
          }
        }
      }
    },
    {
      "subId": "7418438",
      "subQuestName": "前往佩特莉可镇",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [],
        "dialogs": {}
      }
    },
    {
      "subId": "7418403",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "741840397"
        ],
        "dialogs": {
          "741840397": {
            "id": "741840397",
            "speakerId": 1010,
            "speakerName": "Black Screen",
            "text": "被打得落花流水的小贼连「宝藏」都顾不上，驾着船逃跑了。",
            "nextDialogs": [
              "741840398"
            ]
          },
          "741840398": {
            "id": "741840398",
            "speakerId": 1010,
            "speakerName": "Black Screen",
            "text": "结果，箱子中并没有什么魔王邪恶陷阱。",
            "nextDialogs": [
              "741840399"
            ]
          },
          "741840399": {
            "id": "741840399",
            "speakerId": 1010,
            "speakerName": "Black Screen",
            "text": "然而也没有什么财宝。里面装满的都是沉甸甸的碎石。"
          }
        }
      }
    },
    {
      "subId": "7418434",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "741843401"
        ],
        "dialogs": {

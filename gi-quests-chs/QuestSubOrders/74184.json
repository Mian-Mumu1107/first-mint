  "subQuests": [
    {
      "subId": "7418401",
      "subQuestName": "",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "741840101"
        ],
        "dialogs": {
          "741840101": {
            "id": "741840101",
            "speakerId": 21417,
            "speakerName": "领头的家伙",
            "text": "喂，你这笨蛋！怎么还有这么多箱子没搬到船上，磨磨蹭蹭的…要搞到什么时候啊！",
            "nextDialogs": [
              "741840102"
            ]
          },
          "741840102": {
            "id": "741840102",
            "speakerId": 21418,
            "speakerName": "被称作「笨蛋」的家伙",
            "text": "不是啊，老大！这些箱子实在是太重了，再继续往船上搬的话，我怕…",
            "nextDialogs": [
              "741840103"
            ]
          },
          "741840103": {
            "id": "741840103",
            "speakerId": 21417,
            "speakerName": "领头的家伙",
            "text": "有什么好怕的！这些可是宝藏，不带走的话，可就暴殄天物了啊！",
            "nextDialogs": [
              "741840104"
            ]
          },
          "741840104": {
            "id": "741840104",
            "speakerId": 21418,
            "speakerName": "被称作「笨蛋」的家伙",
            "text": "但是，要是把这些箱子全装上船，再加上我们几个，我怕船会支撑不住啊。",
            "nextDialogs": [
              "741840105"
            ]
          },
          "741840105": {
            "id": "741840105",
            "speakerId": 21417,
            "speakerName": "领头的家伙",
            "text": "哈，那还不简单！把你们几个留在岛上，不就能把宝藏带回去了吗？",
            "nextDialogs": [
              "741840106"
            ]
          },
          "741840106": {
            "id": "741840106",
            "speakerId": 21418,
            "speakerName": "被称作「笨蛋」的家伙",
            "text": "不愧是老大，真是绝妙的计策…不对！至少把我给带上吧，我可不想被那些魔像抓到，变成那种鬼样子啊！",
            "nextDialogs": [
              "741840107"
            ]
          },
          "741840107": {
            "id": "741840107",
            "speakerId": 21417,
            "speakerName": "领头的家伙",
            "text": "别废话了，手脚麻利点！要是等「魔王」的爪牙追上来，我们全都得完蛋！",
            "nextDialogs": [
              "741840108"
            ]
          },
          "741840108": {
            "id": "741840108",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "…魔王的爪牙？他们是在演戏吗？",
            "nextDialogs": [
              "741840109"
            ]
          },
          "741840109": {
            "id": "741840109",
            "speakerId": 21418,
            "speakerName": "被称作「笨蛋」的家伙",
            "text": "等等，老大！那边有人！",
            "nextDialogs": [
              "741840110"
            ]
          },
          "741840110": {
            "id": "741840110",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "#{NICKNAME}，我们要不去问问他们在…",
            "nextDialogs": [
              "741840111"
            ]
          },
          "741840111": {
            "id": "741840111",
            "speakerId": 21417,
            "speakerName": "领头的家伙",
            "text": "喂！那边一大一小的，鬼鬼祟祟地在干什么呢！",
            "nextDialogs": [
              "741840113",
              "741840115"
            ]
          },
          "741840113": {
            "id": "741840113",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "我们也没有干什么坏事吧，有什么好紧张的！",
            "nextDialogs": [
              "741840116"
            ]
          },
          "741840116": {
            "id": "741840116",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "总之，还是先跟他们聊聊吧。",
            "nextDialogs": [
              "741840117"
            ]
          },
          "741840117": {
            "id": "741840117",
            "speakerId": 21417,
            "speakerName": "领头的家伙",
            "text": "嗯…看样子，你们是异邦人啊。我原本还以为是「魔王利魔世」的爪牙呢。",
            "nextDialogs": [
              "741840118"
            ]
          },
          "741840118": {
            "id": "741840118",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "#这位是{NICKNAME}，我叫派蒙，确实是旅行者呢！话说回来，「魔王利魔世」是谁呀？他的戏份已经结束了吗？",
            "nextDialogs": [
              "741840119"
            ]
          },
          "741840119": {
            "id": "741840119",
            "speakerId": 21417,
            "speakerName": "领头的家伙",
            "text": "哈哈，连魔王都不知道吗…好吧，你们像是没见过世面的异邦人，倒也情有可原。那就让我好好给你们讲讲！",
            "nextDialogs": [
              "741840120"
            ]
          },
          "741840120": {
            "id": "741840120",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "哦哦哦！",
            "nextDialogs": [
              "741840121"
            ]
          },
          "741840121": {
            "id": "741840121",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "好详细的背景设定。",
            "nextDialogs": [
              "741840122"
            ]
          },
          "741840122": {
            "id": "741840122",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "然后呢然后呢？你们是怎么打败魔王的呀？",
            "nextDialogs": [
              "741840123"
            ]
          },
          "741840123": {
            "id": "741840123",
            "speakerId": 21417,
            "speakerName": "领头的家伙",
            "text": "魔王使役的魔像个个力大无穷，正面对抗我们哪里会是对手？这次多亏了「机智的埃斯特」…",
            "nextDialogs": [
              "741840124"
            ]
          },
          "741840124": {
            "id": "741840124",
            "speakerId": 21417,
            "speakerName": "领头的家伙",
            "text": "在他的帮助下，我们潜入了魔王城，夺回了魔王和他的爪牙从我们枫丹人身上搜刮来的宝藏！",
            "nextDialogs": [
              "741840125"
            ]
          },
          "741840125": {
            "id": "741840125",
            "speakerId": 21418,
            "speakerName": "被称作「笨蛋」的家伙",
            "text": "就像老大说的，什么来着…「扰乱魔王军部署的特别军事行动」，真是高明的计策！"
          },
          "741840115": {
            "id": "741840115",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "#啊？{NICKNAME}，你在说什么呀…？"
          }
        }
      }
    },
    {
      "subId": "7418402",
      "subQuestName": "击败「盗贼」们",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [],
        "dialogs": {}
      }
    },
    {
      "subId": "7418403",
      "subQuestName": "观察装载「宝物」的箱子",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "741840301"
        ],
        "dialogs": {
          "741840301": {
            "id": "741840301",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "…居然就这样跑掉了，原来他们真的不是在演戏喔。",
            "nextDialogs": [
              "741840302"
            ]
          },
          "741840302": {
            "id": "741840302",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "可是，「宝藏」又是怎么回事？什么魔王，什么魔王城，怎么可能是真的…",
            "nextDialogs": [
              "741840303"
            ]
          },
          "741840303": {
            "id": "741840303",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "要不我们打开看看宝藏？",
            "nextDialogs": [
              "741840304"
            ]
          },
          "741840304": {
            "id": "741840304",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "欸？！可是这种来路不明的东西…",
            "nextDialogs": [
              "741840306",
              "741840308"
            ]
          },
          "741840306": {
            "id": "741840306",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "我只是怕…万一、万一箱子里有什么魔王邪恶陷阱…",
            "nextDialogs": [
              "741840309"
            ]
          },
          "741840309": {
            "id": "741840309",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "真拿你没办法！不过，要小心一点哦！",
            "nextDialogs": [
              "741840310"
            ]
          },
          "741840310": {
            "id": "741840310",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "哼！我就知道，那些人都是骗子！哪有什么宝藏！",
            "nextDialogs": [
              "741840311"
            ]
          },
          "741840311": {
            "id": "741840311",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "还是说，这个破破烂烂的雕像，是什么价值连城的珍贵文物？",
            "nextDialogs": [
              "741840312"
            ]
          },
          "741840312": {
            "id": "741840312",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "唔…我们还是到佩特莉可镇问问情况吧，说不定是镇上的重要地标、吉祥物什么的呢！",
            "nextDialogs": [
              "741840313"
            ]
          },
          "741840313": {
            "id": "741840313",
            "speakerId": 1003,
            "speakerName": "派蒙的声音",
            "text": "至于这些「宝藏」…我们…",
            "nextDialogs": [
              "741840314"
            ]
          },
          "741840314": {
            "id": "741840314",
            "speakerId": 1003,
            "speakerName": "派蒙的声音",
            "text": "#…喂！{NICKNAME}，你…"
          },
          "741840308": {
            "id": "741840308",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "你说得没错，但是，如果里面有什么魔王邪恶陷阱…"
          }
        }
      }
    },

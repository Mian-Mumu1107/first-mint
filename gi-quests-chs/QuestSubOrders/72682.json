{
  "lineCounts": {
    "Player": 13,
    "茅葺一庆": 20
  },
  "subQuests": [
    {
      "subId": "7268201",
      "subQuestName": "与茅葺对话",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "726820101"
        ],
        "dialogs": {
          "726820101": {
            "id": "726820101",
            "speakerId": 30065,
            "speakerName": "茅葺一庆",
            "text": "嗨！那边那位金发异乡人…",
            "nextDialogs": [
              "726820104"
            ]
          },
          "726820104": {
            "id": "726820104",
            "speakerId": 30065,
            "speakerName": "茅葺一庆",
            "text": "嗯…你这头金发，越看越眼熟…难道是…",
            "nextDialogs": [
              "726820105"
            ]
          },
          "726820105": {
            "id": "726820105",
            "speakerId": 30065,
            "speakerName": "茅葺一庆",
            "text": "啊，对了！是上次「百人一揆」中，表现无比亮眼的「黄金旋风」…",
            "nextDialogs": [
              "726820106"
            ]
          },
          "726820106": {
            "id": "726820106",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "黄、黄金旋风…？",
            "nextDialogs": [
              "726820107"
            ]
          },
          "726820107": {
            "id": "726820107",
            "speakerId": 30065,
            "speakerName": "茅葺一庆",
            "text": "上次，我在乱斗的场馆一隅，观察着参加者的活跃表现，想将其中最为精彩的场面收为素材。而你战斗的身姿，如刈草的黄金之风一般，横扫各路敌手…"
          }
        }
      }
    },
    {
      "subId": "7268202",
      "subQuestName": "与茅葺对话",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "726820201"
        ],
        "dialogs": {
          "726820201": {
            "id": "726820201",
            "speakerId": 30065,
            "speakerName": "茅葺一庆",
            "text": "我们到了。",
            "nextDialogs": [
              "726820202"
            ]
          },
          "726820202": {
            "id": "726820202",
            "speakerId": 30065,
            "speakerName": "茅葺一庆",
            "text": "只要踏入这扇看起来十分可疑的大门，就能进入这回的战斗场馆。",
            "nextDialogs": [
              "726820205"
            ]
          },
          "726820205": {
            "id": "726820205",
            "speakerId": 30065,
            "speakerName": "茅葺一庆",
            "text": "这次的规则和上次应该差不多。来自世界各地，渴求争斗的魔物、冒险者、战士，在它的舞台上酣畅淋漓地大打出手。",
            "nextDialogs": [
              "726820206"
            ]
          },
          "726820206": {
            "id": "726820206",
            "speakerId": 30065,
            "speakerName": "茅葺一庆",
            "text": "与之前一样，你可以和志同道合的同伴、战友一起去参战。毕竟，所谓「百人」，自然是人数越多越好啦。",
            "nextDialogs": [
              "726820207"
            ]
          },
          "726820207": {
            "id": "726820207",
            "speakerId": 30065,
            "speakerName": "茅葺一庆",
            "text": "我很期待你的表现。",
            "nextDialogs": [
              "726820208"
            ]
          },
          "726820208": {
            "id": "726820208",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "这次你也不参加吗？",
            "nextDialogs": [
              "726820209"
            ]
          },
          "726820209": {
            "id": "726820209",
            "speakerId": 30065,
            "speakerName": "茅葺一庆",
            "text": "我吗？我会以旁观者的身份参与，为你喝彩。",
            "nextDialogs": [
              "726820210"
            ]
          },
          "726820210": {
            "id": "726820210",
            "speakerId": 30065,
            "speakerName": "茅葺一庆",
            "text": "毕竟，我的目标还是写出最精彩的格斗小说，而不是成为像你这样耀眼的战士。",
            "nextDialogs": [
              "726820211"
            ]
          },
          "726820211": {
            "id": "726820211",
            "speakerId": 30065,
            "speakerName": "茅葺一庆",
            "text": "而我的直觉告诉我，你一定会是格斗场上最耀眼的明星。"
          }
        }
      }
    }
  ]
}
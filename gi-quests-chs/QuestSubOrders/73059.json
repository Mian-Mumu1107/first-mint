        "dialogs": {
          "730590501": {
            "id": "730590501",
            "speakerId": 1005,
            "speakerName": "兰迦鲁",
            "text": "#谢谢你们！那菈{NICKNAME}和白飞飞！",
            "nextDialogs": [
              "730590502"
            ]
          },
          "730590502": {
            "id": "730590502",
            "speakerId": 1005,
            "speakerName": "兰迦鲁",
            "text": "以后也要一起玩呀！"
          }
        }
      }
    }
  ]

    {
      "subId": "7305904",
      "subQuestName": "（test）刷新group专用$HIDDEN",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "730590401"
        ],
        "dialogs": {
          "730590401": {
            "id": "730590401",
            "speakerId": 1003,
            "speakerName": "兰纳迦",
            "text": "你好，金色的那菈和白飞飞。",
            "nextDialogs": [
              "730590402"
            ]
          },
          "730590402": {
            "id": "730590402",
            "speakerId": 1003,
            "speakerName": "兰纳迦",
            "text": "谢谢你们，虽然回不来了，以前的记忆…但可以信任的朋友，你们是的。"
          }
        }
      }
    },
    {
      "subId": "7305903",
      "subQuestName": "和兰那罗们对话",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "730590201"
        ],
        "dialogs": {
          "730590201": {
            "id": "730590201",
            "speakerId": 1004,
            "speakerName": "兰纳真",
            "text": "兰纳迦，他来啦，他们来啦！",
            "nextDialogs": [
              "730590202"
            ]
          },
          "730590202": {
            "id": "730590202",
            "speakerId": 1005,
            "speakerName": "兰迦鲁",
            "text": "嗯嗯，来啦，来啦！",
            "nextDialogs": [
              "730590203"
            ]
          },
          "730590203": {
            "id": "730590203",
            "speakerId": 1003,
            "speakerName": "兰纳迦",
            "text": "#来啦，那菈{NICKNAME}，白色的飞飞。欢迎你们，我们三个。",
            "nextDialogs": [
              "730590204"
            ]
          },
          "730590204": {
            "id": "730590204",
            "speakerId": 1003,
            "speakerName": "兰纳迦",
            "text": "到了，月亮。到啦，种下花朵的时刻。你们准备好了吗？",
            "nextDialogs": [
              "730590205"
            ]
          },
          "730590205": {
            "id": "730590205",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "我准备好了。",
            "nextDialogs": [
              "730590206"
            ]
          },
          "730590206": {
            "id": "730590206",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "嗯，我也是！",
            "nextDialogs": [
              "730590207"
            ]
          },
          "730590207": {
            "id": "730590207",
            "speakerId": 1003,
            "speakerName": "兰纳迦",
            "text": "那么…兰纳真，兰迦鲁，我们开始仪式吧。",
            "nextDialogs": [
              "730590208"
            ]
          },
          "730590208": {
            "id": "730590208",
            "speakerId": 1003,
            "speakerName": "兰纳迦",
            "text": "「归去，归去，花园的梦，森林的记忆…」",
            "nextDialogs": [
              "730590209"
            ]
          },
          "730590209": {
            "id": "730590209",
            "speakerId": 1004,
            "speakerName": "兰纳真",
            "text": "「迎接吧，让我们：」",
            "nextDialogs": [
              "730590210"
            ]
          },
          "730590210": {
            "id": "730590210",
            "speakerId": 1004,
            "speakerName": "兰纳真",
            "text": "「渐浓的睡梦，不散的欢欣。」",
            "nextDialogs": [
              "730590211"
            ]
          },
          "730590211": {
            "id": "730590211",
            "speakerId": 1005,
            "speakerName": "兰迦鲁",
            "text": "「庆贺呀，让我们：」",
            "nextDialogs": [
              "730590212"
            ]
          },
          "730590212": {
            "id": "730590212",
            "speakerId": 1005,
            "speakerName": "兰迦鲁",
            "text": "「石榴歌唱，苹果鼓掌！」",
            "nextDialogs": [
              "730590213"
            ]
          },
          "730590213": {
            "id": "730590213",
            "speakerId": 1002,
            "speakerName": "Black Screen",
            "text": "兰那罗们种下干瘪的花朵，随着歌谣在风中回荡，花朵奇迹般地重返了新生…",
            "nextDialogs": [
              "730590214"
            ]
          },
          "730590214": {
            "id": "730590214",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "哇…这三朵花，又活过来了！",
            "nextDialogs": [
              "730590215"
            ]
          },
          "730590215": {
            "id": "730590215",
            "speakerId": 1003,
            "speakerName": "兰纳迦",
            "text": "是呀，因为…是慈悯的，「无郁夷摩」。所以，她要让记忆有重新焕发的机会。",
            "nextDialogs": [
              "730590216"
            ]
          },
          "730590216": {
            "id": "730590216",
            "speakerId": 1004,
            "speakerName": "兰纳真",
            "text": "嗯！即使我们不再记得你们啦，记忆也会…唔，融进叶脉和根系中间，变成绿叶，变成年轮！",
            "nextDialogs": [
              "730590217"
            ]
          },
          "730590217": {
            "id": "730590217",
            "speakerId": 1005,
            "speakerName": "兰迦鲁",
            "text": "或者变成肉肉的虫虫，给别的虫虫吃，别的虫虫留下滋养草木的东西，让我们全都长大大！",
            "nextDialogs": [
              "730590218"
            ]
          },
          "730590218": {
            "id": "730590218",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "可是…你们还是不记得我们了，对吗？",
            "nextDialogs": [
              "730590219"
            ]
          },
          "730590219": {
            "id": "730590219",
            "speakerId": 1003,
            "speakerName": "兰纳迦",
            "text": "嗯…因为，并不专属于你我，记忆…过去经历的事情，我们，已经分给了森林里的所有草木…",
            "nextDialogs": [
              "730590220"
            ]
          },
          "730590220": {
            "id": "730590220",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "……",
            "nextDialogs": [
              "730590221"
            ]
          },
          "730590221": {
            "id": "730590221",
            "speakerId": 1004,
            "speakerName": "兰纳真",
            "text": "但是没关系呀，我们已经是新的朋友了，对吧！",
            "nextDialogs": [
              "730590222"
            ]
          },
          "730590222": {
            "id": "730590222",
            "speakerId": 1005,
            "speakerName": "兰迦鲁",
            "text": "嗯！新朋友！"
          }
        }
      }
    },
    {
      "subId": "7305903",

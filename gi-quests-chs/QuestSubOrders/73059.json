  "subQuests": [
    {
      "subId": "7305901",
      "subQuestName": "到达无郁稠林",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "730590101"
        ],
        "dialogs": {
          "730590101": {
            "id": "730590101",
            "speakerId": 1000,
            "speakerName": "海亚姆",
            "text": "「石榴歌唱，苹果鼓掌…」",
            "nextDialogs": [
              "730590102"
            ]
          },
          "730590102": {
            "id": "730590102",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "你好呀，海亚姆先生！你怎么在这里？",
            "nextDialogs": [
              "730590103"
            ]
          },
          "730590103": {
            "id": "730590103",
            "speakerId": 1000,
            "speakerName": "海亚姆",
            "text": "哦哦，你好，你好。白色的小朋友，和…唉…抱歉，孩子，我的脑袋不太清楚了，时间稍微一长就记不住名字…",
            "nextDialogs": [
              "730590104"
            ]
          },
          "730590104": {
            "id": "730590104",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "#叫我{NICKNAME}就好。",
            "nextDialogs": [
              "730590105"
            ]
          },
          "730590105": {
            "id": "730590105",
            "speakerId": 1000,
            "speakerName": "海亚姆",
            "text": "哈哈…好啊，你们就是之前…",
            "nextDialogs": [
              "730590106"
            ]
          },
          "730590106": {
            "id": "730590106",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "对！我们就是那两个「杰万」——勇敢的年轻人！",
            "nextDialogs": [
              "730590107"
            ]
          },
          "730590107": {
            "id": "730590107",
            "speakerId": 1000,
            "speakerName": "海亚姆",
            "text": "嗯…所以，告诉我，「兰那罗」，他们还记得我吗？还记得我们所有人吗？",
            "nextDialogs": [
              "730590108"
            ]
          },
          "730590108": {
            "id": "730590108",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "欸…这个…",
            "nextDialogs": [
              "730590110",
              "730590113"
            ]
          },
          "730590110": {
            "id": "730590110",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "……",
            "nextDialogs": [
              "730590111"
            ]
          },
          "730590111": {
            "id": "730590111",
            "speakerId": 1000,
            "speakerName": "海亚姆",
            "text": "这样啊…但我看不到他们了，也听不到他们如何想念我…真是遗憾。",
            "nextDialogs": [
              "730590114"
            ]
          },
          "730590114": {
            "id": "730590114",
            "speakerId": 1000,
            "speakerName": "海亚姆",
            "text": "呵呵…我看不到他们了。我太老了，看不到他们的样子，听不到他们的声音…错过了，都错过了。",
            "nextDialogs": [
              "730590115"
            ]
          },
          "730590115": {
            "id": "730590115",
            "speakerId": 1000,
            "speakerName": "海亚姆",
            "text": "咳咳…抱歉，我先离开了。或许只有期待奇迹了吧…",
            "nextDialogs": [
              "730590116"
            ]
          },
          "730590116": {
            "id": "730590116",
            "speakerId": 1000,
            "speakerName": "海亚姆",
            "text": "奇迹不能去理解，不能去追求，只能等待呀。",
            "nextDialogs": [
              "730590117"
            ]
          },
          "730590117": {
            "id": "730590117",
            "speakerId": 1002,
            "speakerName": "Black Screen",
            "text": "海亚姆蹒跚着离开了…"
          },
          "730590113": {
            "id": "730590113",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "但是…我们还可以和他们重新交朋友呀！"
          }
        }
      }
    },
    {
      "subId": "7305902",
      "subQuestName": "和海亚姆对话",
      "sceneId": null,
      "locations": [],

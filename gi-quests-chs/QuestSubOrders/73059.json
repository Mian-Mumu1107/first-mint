            "speakerId": 1004,
            "speakerName": "兰纳真",
            "text": "你好！新朋友！",
            "nextDialogs": [
              "730590302"
            ]
          },
          "730590302": {
            "id": "730590302",
            "speakerId": 1004,
            "speakerName": "兰纳真",
            "text": "希望你能一直记得，我们的歌！"
          }
        }
      }
    },
    {
      "subId": "7305905",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [

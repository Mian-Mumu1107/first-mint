    {
      "subId": "7350301",
      "subQuestName": "与德鲁苏对话$HIDDEN",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "735030101"
        ],
        "dialogs": {
          "735030101": {
            "id": "735030101",
            "speakerId": 20847,
            "speakerName": "德鲁苏",
            "text": "唔，这个地方不错…",
            "nextDialogs": [
              "735030102"
            ]
          },
          "735030102": {
            "id": "735030102",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "你又在研究谜语吗？",
            "nextDialogs": [
              "735030103"
            ]
          },
          "735030103": {
            "id": "735030103",
            "speakerId": 20847,
            "speakerName": "德鲁苏",
            "text": "旅行者！你来得正好，我正准备设计一段全新的连续谜题呢。",
            "nextDialogs": [
              "735030104"
            ]
          },
          "735030104": {
            "id": "735030104",
            "speakerId": 20847,
            "speakerName": "德鲁苏",
            "text": "这里的地形有点复杂。你看，港口的一侧有一根「圣树」的巨大根系入水。",
            "nextDialogs": [
              "735030105"
            ]
          },
          "735030105": {
            "id": "735030105",
            "speakerId": 20847,
            "speakerName": "德鲁苏",
            "text": "另一侧则是一片巨大的荷叶，和一堆待出港的船只。",
            "nextDialogs": [
              "735030106"
            ]
          },
          "735030106": {
            "id": "735030106",
            "speakerId": 20847,
            "speakerName": "德鲁苏",
            "text": "旅行者，你觉得这段谜语以哪一边的景物为主题最好？",
            "nextDialogs": [
              "735030108",
              "735030111",
              "735030114"
            ]
          },
          "735030108": {
            "id": "735030108",
            "speakerId": 20847,
            "speakerName": "德鲁苏",
            "text": "是吗？「圣树」的巨大根系确实很显眼，作为谜语的「切入点」也很容易被感知到。",
            "nextDialogs": [
              "735030109"
            ]
          },
          "735030109": {
            "id": "735030109",
            "speakerId": 20847,
            "speakerName": "德鲁苏",
            "text": "好！那我就以根系为主题写一道谜语。"
          },
          "735030111": {
            "id": "735030111",
            "speakerId": 20847,
            "speakerName": "德鲁苏",
            "text": "确实…把这两者联系起来的话，也许有着别样的趣味性。",
            "nextDialogs": [
              "735030112"
            ]
          },
          "735030112": {
            "id": "735030112",
            "speakerId": 20847,
            "speakerName": "德鲁苏",
            "text": "没问题，我就以这个主题来写一道谜语好了。"
          },
          "735030114": {
            "id": "735030114",
            "speakerId": 20847,
            "speakerName": "德鲁苏",
            "text": "太简单了？那你有什么想法吗？"
          }
        }
      }
    },
    {
      "subId": "7350308",
      "subQuestName": "",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "735030801"
        ],
        "dialogs": {

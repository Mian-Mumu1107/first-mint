  "subQuests": [
    {
      "subId": "7500012",
      "subQuestName": "(test)进入纳塔接取任务$HIDDEN",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "750001201"
        ],
        "dialogs": {
          "750001201": {
            "id": "750001201",
            "speakerId": 21619,
            "speakerName": "小家伙？",
            "text": "呀！",
            "nextDialogs": [
              "750001202"
            ]
          },
          "750001202": {
            "id": "750001202",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "#嗯，「{TMPVALUE(TMP_VALUE_KEY_TYPE_LITTLE_DRILL_TMP_NAME)}」确实也挺顺口的，而且，这也能算是我取的名字嘛，嘿嘿！"
          }
        }
      }
    },
    {
      "subId": "7500001",
      "subQuestName": "(test)test进入纳塔任务传送-回滚点$HIDDEN",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "750000101"
        ],
        "dialogs": {
          "750000101": {
            "id": "750000101",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "喂，喂…大家伙，你还好吗，还站得起来吗？",
            "nextDialogs": [
              "750000102"
            ]
          },
          "750000102": {
            "id": "750000102",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "看上去好虚弱，真是的，到底发生了什么啊…那些飘浮幽灵狗真让人讨厌，果然飘浮着的家伙都不是什么好东西！",
            "nextDialogs": [
              "750000103"
            ]
          },
          "750000103": {
            "id": "750000103",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "你自己不也飘着吗？",
            "nextDialogs": [
              "750000104"
            ]
          },
          "750000104": {
            "id": "750000104",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "我和那些家伙怎么能一样啦！",
            "nextDialogs": [
              "750000105"
            ]
          },
          "750000105": {
            "id": "750000105",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "#不说那些了，快，{NICKNAME}，我们看看还有什么吃的，给这个大家伙吃点，然后…然后让它好好休息。",
            "nextDialogs": [
              "750000106"
            ]
          },
          "750000106": {
            "id": "750000106",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "这样，它一定能恢复一点精神的！",
            "nextDialogs": [
              "750000109"
            ]
          },
          "750000109": {
            "id": "750000109",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "怎么会这样。",
            "nextDialogs": [
              "750000110"
            ]
          },
          "750000110": {
            "id": "750000110",
            "speakerId": 21523,
            "speakerName": "大家伙？",
            "text": "…呼。",
            "nextDialogs": [
              "750000111"
            ]
          },
          "750000111": {
            "id": "750000111",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "#呜，它现在肯定很难受，{NICKNAME}。"
          }
        }
      }
    },
    {
      "subId": "7500002",

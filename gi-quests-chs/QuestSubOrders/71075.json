        "dialogs": {
          "710750101": {
            "id": "710750101",
            "speakerId": 1000,
            "speakerName": "？？？",
            "text": "嘿，就是你！",
            "nextDialogs": [
              "710750102"
            ]
          },
          "710750102": {
            "id": "710750102",
            "speakerId": 1000,
            "speakerName": "？？？",
            "text": "那个什么二哥，翻了半天翻不到，你这个对这个地方熟悉的家伙总能找到吧！",
            "nextDialogs": [
              "710750103"
            ]
          },
          "710750103": {
            "id": "710750103",
            "speakerId": 1000,
            "speakerName": "？？？",
            "text": "找不到？只要等到一个能找到的人，逼你们把找到的东西交出来不就行了。",
            "nextDialogs": [
              "710750104"
            ]
          },
          "710750104": {
            "id": "710750104",
            "speakerId": 1001,
            "speakerName": "「小轻策」",
            "text": "我江湖人称「小轻策」，区区层岩巨渊这儿一群挖矿的摆不平，还怎么在外面混？来，把东西给我吧。",
            "nextDialogs": [
              "710750105"
            ]
          },
          "710750105": {
            "id": "710750105",
            "speakerId": 1001,
            "speakerName": "「小轻策」",
            "text": "千岩军的宝藏，我们盗宝团就收下了！",
            "nextDialogs": [
              "710750108"
            ]
          },
          "710750108": {
            "id": "710750108",
            "speakerId": 1001,
            "speakerName": "「小轻策」",
            "text": "你说没有就没有？",
            "nextDialogs": [
              "710750109"
            ]
          },
          "710750109": {
            "id": "710750109",
            "speakerId": 1001,
            "speakerName": "「小轻策」",
            "text": "…哼，我还以为你们每天跑上跑下，身子板看上去能结实点呢。",
            "nextDialogs": [
              "710750110"
            ]
          },
          "710750110": {
            "id": "710750110",
            "speakerId": 1001,
            "speakerName": "「小轻策」",
            "text": "你选吧，是被我一拳撂倒搜个全身，还是自己亲手把「庇佑之冠」呈上来？",
            "nextDialogs": [
              "710750111"
            ]
          },
          "710750111": {
            "id": "710750111",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "我觉得你不会想和我打的…",
            "nextDialogs": [
              "710750112"
            ]
          },
          "710750112": {
            "id": "710750112",
            "speakerId": 1001,
            "speakerName": "「小轻策」",
            "text": "呦，语气很大嘛…",
            "nextDialogs": [
              "710750113"
            ]
          },
          "710750113": {
            "id": "710750113",
            "speakerId": 1001,
            "speakerName": "「小轻策」",
            "text": "我看你这是敬酒不吃吃罚酒了！"
          }
        }
      }

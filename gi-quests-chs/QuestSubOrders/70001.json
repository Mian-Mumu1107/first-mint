    {
      "subId": "7000111",
      "subQuestName": "返回薇尔处",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "700010601"
        ],
        "dialogs": {
          "700010601": {
            "id": "700010601",
            "speakerId": 1525,
            "speakerName": "薇尔",
            "text": "盗宝团的事怎么样了？",
            "nextDialogs": [
              "700010602"
            ]
          },
          "700010602": {
            "id": "700010602",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "已经全部解决了。",
            "nextDialogs": [
              "700010603"
            ]
          },
          "700010603": {
            "id": "700010603",
            "speakerId": 1525,
            "speakerName": "薇尔",
            "text": "嗯，不愧是西风的荣誉骑士，做得很好。你之前和那位盗宝团搭话的方式也很巧妙，果然是「那位先生」看中的人。",
            "nextDialogs": [
              "700010604"
            ]
          },
          "700010604": {
            "id": "700010604",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "你…你一直在看？",
            "nextDialogs": [
              "700010605"
            ]
          },
          "700010605": {
            "id": "700010605",
            "speakerId": 1525,
            "speakerName": "薇尔",
            "text": "当然啦，不然我怎么能那么及时地把西风骑士给叫过去呢？",
            "nextDialogs": [
              "700010606"
            ]
          },
          "700010606": {
            "id": "700010606",
            "speakerId": 1525,
            "speakerName": "薇尔",
            "text": "总之，谢谢你帮忙，这些东西请你收下吧，不用客气，这些也都是「那位先生」专门给我拨的款。",
            "nextDialogs": [
              "700010607"
            ]
          },
          "700010607": {
            "id": "700010607",
            "speakerId": 1525,
            "speakerName": "薇尔",
            "text": "那么再见了，祝你们有愉快的一天。"
          }
        }
      }
    },
    {
      "subId": "7000108",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [

    {
      "subId": "7109808",
      "subQuestName": "与加尔恰对话",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "710981501"
        ],
        "dialogs": {
          "710981501": {
            "id": "710981501",
            "speakerId": 1001,
            "speakerName": "加尔恰",
            "text": "这味道真不错。但是尝起来，和言笑先生做的萝卜时蔬汤完全不一样…",
            "nextDialogs": [
              "710981502"
            ]
          },
          "710981502": {
            "id": "710981502",
            "speakerId": 1001,
            "speakerName": "加尔恰",
            "text": "我很好奇，您…您具体是怎么做这道菜的？食材投入了多少？调料是怎么放的？",
            "nextDialogs": [
              "710981505"
            ]
          },
          "710981505": {
            "id": "710981505",
            "speakerId": 1001,
            "speakerName": "加尔恰",
            "text": "啊…抱歉，但还是请您详细和我说一说吧，您做菜的手法，说不定能给我一些灵感呢。",
            "nextDialogs": [
              "710981506"
            ]
          },
          "710981506": {
            "id": "710981506",
            "speakerId": 1003,
            "speakerName": "Black Screen",
            "text": "旅行者详细讲述了自己烹饪萝卜时蔬汤的手法…",
            "nextDialogs": [
              "710981507"
            ]
          },
          "710981507": {
            "id": "710981507",
            "speakerId": 1001,
            "speakerName": "加尔恰",
            "text": "原来如此…",
            "nextDialogs": [
              "710981508"
            ]
          },
          "710981508": {
            "id": "710981508",
            "speakerId": 1001,
            "speakerName": "加尔恰",
            "text": "唉，一道菜的味道，实在是被太多的变量影响，想要精细计算的话，就必须要投入更多的计算量。",
            "nextDialogs": [
              "710981509"
            ]
          },
          "710981509": {
            "id": "710981509",
            "speakerId": 1001,
            "speakerName": "加尔恰",
            "text": "但是，更多的计算量，就意味着我必须改良我的「推数机」…",
            "nextDialogs": [
              "710981510"
            ]
          },
          "710981510": {
            "id": "710981510",
            "speakerId": 1001,
            "speakerName": "加尔恰",
            "text": "希望教令院图书馆里的资料会给我灵感。",
            "nextDialogs": [
              "710981511"
            ]
          },
          "710981511": {
            "id": "710981511",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "你为什么要制造「推数机」？",
            "nextDialogs": [
              "710981512"
            ]
          },
          "710981512": {
            "id": "710981512",
            "speakerId": 1001,
            "speakerName": "加尔恰",
            "text": "唔，这是一个好问题，但在我回答这个问题之前，我得先问您一个问题。",
            "nextDialogs": [
              "710981513"
            ]
          },
          "710981513": {
            "id": "710981513",
            "speakerId": 1001,
            "speakerName": "加尔恰",
            "text": "您觉得，我制造的这台「推数机」是否拥有「思想」？"
          }
        }
      }
    },
    {
      "subId": "7109803",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "710980301"
        ],
        "dialogs": {
          "710980301": {
            "id": "710980301",
            "speakerId": 1004,
            "speakerName": "言笑",
            "text": "为什么会有人连萝卜时蔬汤都学不会啊！",
            "nextDialogs": [
              "710980302"
            ]
          },
          "710980302": {
            "id": "710980302",
            "speakerId": 1004,
            "speakerName": "言笑",
            "text": "一个劲地问，一个劲地问！我怎么知道我做的每道菜里食材和调料的量到底是多少啊！？",
            "nextDialogs": [
              "710980303"
            ]
          },
          "710980303": {
            "id": "710980303",
            "speakerId": 1004,
            "speakerName": "言笑",
            "text": "做菜的时候放的那些调料和食材的量，不就是…不就是随着心走吗？哪个厨师会记这种事！",
            "nextDialogs": [
              "710980304"
            ]
          },
          "710980304": {
            "id": "710980304",
            "speakerId": 1004,
            "speakerName": "言笑",
            "text": "要不是看在他们付了钱的份上，我非找老板告状不可…",
            "nextDialogs": [
              "710980305"
            ]
          },
          "710980305": {
            "id": "710980305",
            "speakerId": 1004,
            "speakerName": "言笑",
            "text": "呼…我真是受不了了，我怎么会遇到这种人…"
          }
        }
      }
    },
    {
      "subId": "7109811",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "710981101"
        ],
        "dialogs": {
          "710981101": {
            "id": "710981101",
            "speakerId": 1002,
            "speakerName": "派蒙",
            "text": "呜哇，加尔恰先生好像把灶台里的火也弄熄了。",
            "nextDialogs": [
              "710981102"
            ]
          },
          "710981102": {
            "id": "710981102",
            "speakerId": 1002,
            "speakerName": "派蒙",
            "text": "先想办法把灶火给点燃吧。"
          }
        }
      }
    },
    {
      "subId": "7109812",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "710981201"
        ],
        "dialogs": {
          "710981201": {
            "id": "710981201",
            "speakerId": 1002,
            "speakerName": "派蒙",
            "text": "好嘞！我们来好好地做一道萝卜时蔬汤吧。"
          }
        }
      }
    },
    {
      "subId": "7109813",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "710981301"
        ],
        "dialogs": {
          "710981301": {
            "id": "710981301",
            "speakerId": 1001,
            "speakerName": "加尔恰",
            "text": "这个参数…不对，不对，必须先调整算式…",
            "nextDialogs": [
              "710981302"
            ]
          },
          "710981302": {
            "id": "710981302",
            "speakerId": 1000,
            "speakerName": "路通",
            "text": "先生，我们必须要省点钱了。不然我们去须弥的路费都要不够了。",
            "nextDialogs": [
              "710981303"
            ]
          },
          "710981303": {
            "id": "710981303",
            "speakerId": 1001,
            "speakerName": "加尔恰",
            "text": "须弥？没错，路通，你说的对，等到了须弥，我一定能找出改良我这台「推数机」的方法。",
            "nextDialogs": [
              "710981304"
            ]
          },
          "710981304": {
            "id": "710981304",
            "speakerId": 1001,
            "speakerName": "加尔恰",
            "text": "然后，我的「推数机」一定能算出更伟大的数字…",
            "nextDialogs": [
              "710981305"
            ]
          },
          "710981305": {
            "id": "710981305",
            "speakerId": 1000,
            "speakerName": "路通",
            "text": "…我完全同意您的看法，先生。"
          }
        }
      }
    }
  ]
}
    {
      "subId": "7109804",
      "subQuestName": "前往厨房",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "710980401"
        ],
        "dialogs": {
          "710980401": {
            "id": "710980401",
            "speakerId": 1001,
            "speakerName": "加尔恰",
            "text": "您做好了？真是厨艺不凡啊。"
          }
        }
      }
    },
    {
      "subId": "7109809",
      "subQuestName": "(test)厨房对话$HIDDEN",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "710980901"
        ],
        "dialogs": {
          "710980901": {
            "id": "710980901",
            "speakerId": 1001,
            "speakerName": "加尔恰",
            "text": "开始吧路通，这次我们把每种材料的量再削减一成…步骤一，开始烹饪。",
            "nextDialogs": [
              "710980902"
            ]
          },
          "710980902": {
            "id": "710980902",
            "speakerId": 1000,
            "speakerName": "路通",
            "text": "好的，先生。",
            "nextDialogs": [
              "710980903"
            ]
          },
          "710980903": {
            "id": "710980903",
            "speakerId": 1001,
            "speakerName": "加尔恰",
            "text": "首先是水…喔！注意注水的速度，这很重要。",
            "nextDialogs": [
              "710980904"
            ]
          },
          "710980904": {
            "id": "710980904",
            "speakerId": 1001,
            "speakerName": "加尔恰",
            "text": "然后开始投料，首先是萝卜…",
            "nextDialogs": [
              "710980905"
            ]
          },
          "710980905": {
            "id": "710980905",
            "speakerId": 1002,
            "speakerName": "派蒙",
            "text": "呜哇…这哪里是做菜啊，感觉他们就像是在搞什么炼金实验一样…",
            "nextDialogs": [
              "710980906"
            ]
          },
          "710980906": {
            "id": "710980906",
            "speakerId": 1002,
            "speakerName": "派蒙",
            "text": "这样做出来的菜，真的会好吃吗…",
            "nextDialogs": [
              "710980907"
            ]
          },
          "710980907": {
            "id": "710980907",
            "speakerId": 1001,
            "speakerName": "加尔恰",
            "text": "完成了，萝卜时蔬汤！",
            "nextDialogs": [
              "710980908"
            ]
          },
          "710980908": {
            "id": "710980908",
            "speakerId": 1000,
            "speakerName": "路通",
            "text": "我们的流程走得十分顺畅，先生。",
            "nextDialogs": [
              "710980909"
            ]
          },
          "710980909": {
            "id": "710980909",
            "speakerId": 1001,
            "speakerName": "加尔恰",
            "text": "太好了，我们赶紧来尝尝看吧，旅行者，也给您两份。",
            "nextDialogs": [
              "710980910"
            ]
          },
          "710980910": {
            "id": "710980910",
            "speakerId": 1002,
            "speakerName": "派蒙",
            "text": "好欸！我先开始尝啦！",
            "nextDialogs": [
              "710980911"
            ]
          },
          "710980911": {
            "id": "710980911",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "谢谢…",
            "nextDialogs": [
              "710980912"
            ]
          },
          "710980912": {
            "id": "710980912",
            "speakerId": 1002,
            "speakerName": "派蒙",
            "text": "呜…这味道…",
            "nextDialogs": [
              "710980913"
            ]
          },
          "710980913": {
            "id": "710980913",
            "speakerId": 1000,
            "speakerName": "路通",
            "text": "…先生，我想这些萝卜还需要再煮一会…",
            "nextDialogs": [
              "710980914"
            ]
          },
          "710980914": {
            "id": "710980914",
            "speakerId": 1001,
            "speakerName": "加尔恰",
            "text": "咳咳、咳…这些薄荷，怎么会煮成这样，我明明精算了它的最佳烹饪时间…",
            "nextDialogs": [
              "710980917"
            ]
          },
          "710980917": {
            "id": "710980917",
            "speakerId": 1001,
            "speakerName": "加尔恰",
            "text": "咳咳…这碗汤的味道，还不如上一次！",
            "nextDialogs": [
              "710980918"
            ]
          },
          "710980918": {
            "id": "710980918",
            "speakerId": 1000,
            "speakerName": "路通",
            "text": "我…咳咳…我完全同意您的观点，先生…",
            "nextDialogs": [
              "710980919"
            ]
          },
          "710980919": {
            "id": "710980919",
            "speakerId": 1001,
            "speakerName": "加尔恰",
            "text": "咳咳…步骤…步骤二，我们来复盘一下。",
            "nextDialogs": [
              "710980920"
            ]
          },
          "710980920": {
            "id": "710980920",
            "speakerId": 1001,
            "speakerName": "加尔恰",
            "text": "见鬼…公式里准是漏了什么参数，或者是计算的精度不够…我得回去调整算法才行。",
            "nextDialogs": [
              "710980921"
            ]
          },
          "710980921": {
            "id": "710980921",
            "speakerId": 1001,
            "speakerName": "加尔恰",
            "text": "路通，你把这次烹饪的数据都记录下来了吗？",
            "nextDialogs": [
              "710980922"
            ]
          },
          "710980922": {
            "id": "710980922",
            "speakerId": 1000,
            "speakerName": "路通",
            "text": "全部都记录下来了，先生。",
            "nextDialogs": [
              "710980923"
            ]
          },
          "710980923": {
            "id": "710980923",
            "speakerId": 1001,
            "speakerName": "加尔恰",
            "text": "很好，看来我们又向成功迈了一步。然后是步骤三，请厨师为我们再演示一遍烹饪过程。"
          }
        }
      }
    },
    {
      "subId": "7109805",
      "subQuestName": "点火",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "710980501"
        ],
        "dialogs": {
          "710980501": {
            "id": "710980501",
            "speakerId": 1000,
            "speakerName": "路通",
            "text": "做菜的事就拜托你了，旅行者。"
          }
        }
      }

  "subQuests": [
    {
      "subId": "7109801",
      "subQuestName": "(test)踩圈接取蓝叹号$HIDDEN",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "710980101"
        ],
        "dialogs": {
          "710980101": {
            "id": "710980101",
            "speakerId": 1000,
            "speakerName": "路通",
            "text": "先生，值得一提的是，算上今天，我们已经连续吃了整整六天的萝卜时蔬汤了。",
            "nextDialogs": [
              "710980102"
            ]
          },
          "710980102": {
            "id": "710980102",
            "speakerId": 1000,
            "speakerName": "路通",
            "text": "除却费用危机之外，我们的肠胃问题也已经不可忽视…",
            "nextDialogs": [
              "710980103"
            ]
          },
          "710980103": {
            "id": "710980103",
            "speakerId": 1001,
            "speakerName": "加尔恰",
            "text": "你说得对！非常对，亲爱的路通，你总是这么敏锐！",
            "nextDialogs": [
              "710980104"
            ]
          },
          "710980104": {
            "id": "710980104",
            "speakerId": 1001,
            "speakerName": "加尔恰",
            "text": "我们也许正是因为肠胃问题，才不能准确地判断出这道菜的味道。",
            "nextDialogs": [
              "710980105"
            ]
          },
          "710980105": {
            "id": "710980105",
            "speakerId": 1001,
            "speakerName": "加尔恰",
            "text": "我们得去找个旁证！路通，得去找个第三方旁证才行！",
            "nextDialogs": [
              "710980106"
            ]
          },
          "710980106": {
            "id": "710980106",
            "speakerId": 1000,
            "speakerName": "路通",
            "text": "谢谢夸奖，先生。但我的重点其实并不在此…",
            "nextDialogs": [
              "710980109"
            ]
          },
          "710980109": {
            "id": "710980109",
            "speakerId": 1001,
            "speakerName": "加尔恰",
            "text": "啊…哈！咱们的旁证者来了，太棒了！甚至还不止一个！",
            "nextDialogs": [
              "710980110"
            ]
          },
          "710980110": {
            "id": "710980110",
            "speakerId": 1002,
            "speakerName": "派蒙",
            "text": "欸？什、什么？旁证者？",
            "nextDialogs": [
              "710980111"
            ]
          },
          "710980111": {
            "id": "710980111",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "你说我们？",
            "nextDialogs": [
              "710980112"
            ]
          },
          "710980112": {
            "id": "710980112",
            "speakerId": 1001,
            "speakerName": "加尔恰",
            "text": "没错，您吃过萝卜时蔬汤吗？熟悉它的味道吗？明白它的做法吗？",
            "nextDialogs": [
              "710980113"
            ]
          },
          "710980113": {
            "id": "710980113",
            "speakerId": 1000,
            "speakerName": "路通",
            "text": "先生，你得先说清楚事情的原委…",
            "nextDialogs": [
              "710980114"
            ]
          },
          "710980114": {
            "id": "710980114",
            "speakerId": 1002,
            "speakerName": "派蒙",
            "text": "#嗯…吃过！熟悉！{NICKNAME}会做！",
            "nextDialogs": [
              "710980115"
            ]
          },
          "710980115": {
            "id": "710980115",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "派蒙，你得先听清楚事情的原委…",
            "nextDialogs": [
              "710980116"
            ]
          },
          "710980116": {
            "id": "710980116",
            "speakerId": 1000,
            "speakerName": "路通",
            "text": "还是由我来陈述一下我们的委托吧…希望您愿意接受。",
            "nextDialogs": [
              "710980117"
            ]
          },
          "710980117": {
            "id": "710980117",
            "speakerId": 1000,
            "speakerName": "路通",
            "text": "我是路通，这位是我的老板，来自枫丹的加尔恰先生。",
            "nextDialogs": [
              "710980118"
            ]
          },
          "710980118": {
            "id": "710980118",
            "speakerId": 1000,
            "speakerName": "路通",
            "text": "加尔恰先生正在研究一种…嗯…被他称为「推数机」的东西。",
            "nextDialogs": [
              "710980119"
            ]
          },
          "710980119": {
            "id": "710980119",
            "speakerId": 1000,
            "speakerName": "路通",
            "text": "具体来说，就是一种能够…帮人计算各种数值的工具，我这么概括对吗，先生？",
            "nextDialogs": [
              "710980120"
            ]
          },
          "710980120": {
            "id": "710980120",
            "speakerId": 1001,
            "speakerName": "加尔恰",
            "text": "非常准确，亲爱的路通，「推数机」的功能就是这么简洁。",
            "nextDialogs": [
              "710980121"
            ]
          },
          "710980121": {
            "id": "710980121",
            "speakerId": 1001,
            "speakerName": "加尔恰",
            "text": "对，要简洁…必须要简洁，那个转化符太复杂了…",
            "nextDialogs": [
              "710980122"
            ]
          },
          "710980122": {
            "id": "710980122",
            "speakerId": 1002,
            "speakerName": "派蒙",
            "text": "但是，这些和萝卜时蔬汤又有什么关系？",
            "nextDialogs": [
              "710980123"
            ]
          },
          "710980123": {
            "id": "710980123",
            "speakerId": 1000,
            "speakerName": "路通",
            "text": "这部分就由加尔恰先生来说明吧，先生？",
            "nextDialogs": [
              "710980124"
            ]
          },
          "710980124": {
            "id": "710980124",
            "speakerId": 1001,
            "speakerName": "加尔恰",
            "text": "可是要怎么简化…喔！是的，没问题。",
            "nextDialogs": [
              "710980125"
            ]
          },
          "710980125": {
            "id": "710980125",
            "speakerId": 1001,
            "speakerName": "加尔恰",
            "text": "呃…我们得从简单的地方开始说，你们知道「公式」吗？",
            "nextDialogs": [
              "710980126"
            ]
          },
          "710980126": {
            "id": "710980126",
            "speakerId": 1002,
            "speakerName": "派蒙",
            "text": "公式？嗯…没听说过…",
            "nextDialogs": [
              "710980127"
            ]
          },
          "710980127": {
            "id": "710980127",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "不太了解…",
            "nextDialogs": [
              "710980128"
            ]
          },
          "710980128": {
            "id": "710980128",
            "speakerId": 1001,
            "speakerName": "加尔恰",
            "text": "好吧…没关系，你们就把公式理解成…嗯…",
            "nextDialogs": [
              "710980129"
            ]
          },
          "710980129": {
            "id": "710980129",
            "speakerId": 1001,
            "speakerName": "加尔恰",
            "text": "一个…一个用于表达各个量之间的一定关系的式子，有一定的普遍应用性…",
            "nextDialogs": [
              "710980130"
            ]
          },
          "710980130": {
            "id": "710980130",
            "speakerId": 1002,
            "speakerName": "派蒙",
            "text": "欸？欸…",
            "nextDialogs": [
              "710980131"
            ]
          },
          "710980131": {
            "id": "710980131",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "听起来很厉害…",
            "nextDialogs": [
              "710980132"
            ]
          },
          "710980132": {
            "id": "710980132",
            "speakerId": 1000,
            "speakerName": "路通",
            "text": "简单来说，在「推数机」的辅助下，我们正在尝试写出「萝卜时蔬汤」的菜谱公式。",
            "nextDialogs": [
              "710980133"
            ]
          },
          "710980133": {
            "id": "710980133",
            "speakerId": 1000,
            "speakerName": "路通",
            "text": "加尔恰先生相信，只要找到了正确的公式，我们就能将「萝卜时蔬汤」的做法转写为一种…",
            "nextDialogs": [
              "710980134"
            ]
          },
          "710980134": {
            "id": "710980134",
            "speakerId": 1001,
            "speakerName": "加尔恰",
            "text": "一种「通用式流程」。",
            "nextDialogs": [
              "710980135"
            ]
          },
          "710980135": {
            "id": "710980135",
            "speakerId": 1000,
            "speakerName": "路通",
            "text": "一种…「傻瓜式流程」。",
            "nextDialogs": [
              "710980136"
            ]
          },
          "710980136": {
            "id": "710980136",
            "speakerId": 1000,
            "speakerName": "路通",
            "text": "只要按照这种流程操作，无论是谁都能烹饪出美味的「萝卜时蔬汤」。",
            "nextDialogs": [
              "710980137"
            ]
          },
          "710980137": {
            "id": "710980137",
            "speakerId": 1002,
            "speakerName": "派蒙",
            "text": "听起来好麻烦…就不能直接找人请教做菜方法吗？",
            "nextDialogs": [
              "710980138"
            ]
          },
          "710980138": {
            "id": "710980138",
            "speakerId": 1000,
            "speakerName": "路通",
            "text": "这种方法…实在是太过考验人的天赋了。",
            "nextDialogs": [
              "710980139"
            ]
          },
          "710980139": {
            "id": "710980139",
            "speakerId": 1000,
            "speakerName": "路通",
            "text": "像我和加尔恰先生这种对烹饪毫无天赋的人，就算是厨师教得再认真，我们也完全无法学到精髓。",
            "nextDialogs": [
              "710980140"
            ]
          },
          "710980140": {
            "id": "710980140",
            "speakerId": 1000,
            "speakerName": "路通",
            "text": "这一点，我相信这家客栈的言笑先生有着十分深刻的体会…"
          }
        }
      }
    },
    {
      "subId": "7109802",
      "subQuestName": "(test)蓝叹号对话$HIDDEN",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "710980701"
        ],
        "dialogs": {
          "710980701": {
            "id": "710980701",
            "speakerId": 1001,
            "speakerName": "加尔恰",
            "text": "…这里的参数，喔，还有这里的…",
            "nextDialogs": [
              "710980702"
            ]
          },
          "710980702": {
            "id": "710980702",
            "speakerId": 1000,
            "speakerName": "路通",
            "text": "加尔恰先生？",
            "nextDialogs": [
              "710980703"
            ]
          },
          "710980703": {
            "id": "710980703",
            "speakerId": 1001,
            "speakerName": "加尔恰",
            "text": "不对，不对…差不多…不对…真巧妙，非常巧妙…",
            "nextDialogs": [
              "710980704"
            ]
          },
          "710980704": {
            "id": "710980704",
            "speakerId": 1000,
            "speakerName": "路通",
            "text": "加尔恰先生。",
            "nextDialogs": [
              "710980705"
            ]
          },
          "710980705": {
            "id": "710980705",
            "speakerId": 1001,
            "speakerName": "加尔恰",
            "text": "啊，路通，亲爱的路通，你帮我点那道菜了吗？",
            "nextDialogs": [
              "710980706"
            ]
          },
          "710980706": {
            "id": "710980706",
            "speakerId": 1000,
            "speakerName": "路通",
            "text": "萝卜时蔬汤已经点好了，先生。",
            "nextDialogs": [
              "710980707"
            ]
          },
          "710980707": {
            "id": "710980707",
            "speakerId": 1001,
            "speakerName": "加尔恰",
            "text": "太好了，你可真是太贴心了，亲爱的路通，这次我准能把那道菜的制作公式转写出来。",
            "nextDialogs": [
              "710980708"
            ]
          },
          "710980708": {
            "id": "710980708",
            "speakerId": 1000,
            "speakerName": "路通",
            "text": "我对此满怀期望，先生。",
            "nextDialogs": [
              "710980709"
            ]
          },
          "710980709": {
            "id": "710980709",
            "speakerId": 1002,
            "speakerName": "派蒙",
            "text": "咦？他们在说什么，菜的…制作公式？那是什么呀？",
            "nextDialogs": [
              "710980711",
              "710980713"
            ]
          },
          "710980711": {
            "id": "710980711",
            "speakerId": 1002,
            "speakerName": "派蒙",
            "text": "那我们就去问问吧，说不定…他们是在准备研究什么新菜，我们还能试吃一下呢！"
          },
          "710980713": {
            "id": "710980713",
            "speakerId": 1002,
            "speakerName": "派蒙",
            "text": "好呀！说不定…他们是在准备研究什么新菜，我们还能试吃一下呢！"
          }
        }
      }
    },
    {
      "subId": "7109803",
      "subQuestName": "与加尔恰对话",
      "sceneId": null,

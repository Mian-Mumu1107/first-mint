    },
    {
      "subId": "2003102",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "200310201"
        ],
        "dialogs": {
          "200310201": {
            "id": "200310201",
            "speakerId": 12913,
            "speakerName": "凯瑟琳",
            "text": "#完成得很好，{NICKNAME}，作为第一次来说相当出色了。",
            "nextDialogs": [
              "200310202"
            ]
          },
          "200310202": {
            "id": "200310202",
            "speakerId": 12913,
            "speakerName": "凯瑟琳",
            "text": "委托人都让我帮忙感谢你呢。",
            "nextDialogs": [
              "200310203"
            ]
          },
          "200310203": {
            "id": "200310203",
            "speakerId": 12913,
            "speakerName": "凯瑟琳",
            "text": "那么现在该我履行之前的约定了。"
          }
        }
      }
    },
    {
      "subId": "2003104",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "200310401"
        ],
        "dialogs": {
          "200310401": {
            "id": "200310401",
            "speakerId": 12913,
            "speakerName": "凯瑟琳",
            "text": "#我听说了哦，{NICKNAME}。",
            "nextDialogs": [
              "200310402"
            ]
          },
          "200310402": {
            "id": "200310402",
            "speakerId": 12913,
            "speakerName": "凯瑟琳",
            "text": "你已经完成了冒险家协会承接的<color=#00E1FFFF>委托</color>，委托人都让我向你道谢呢。",
            "nextDialogs": [
              "200310403"
            ]
          },
          "200310403": {
            "id": "200310403",
            "speakerId": 12913,
            "speakerName": "凯瑟琳",
            "text": "委托？没什么印象。",
            "nextDialogs": [
              "200310404"
            ]
          },
          "200310404": {
            "id": "200310404",
            "speakerId": 12913,
            "speakerName": "凯瑟琳",
            "text": "就是你在路上遇到的需要你帮忙的事。",
            "nextDialogs": [
              "200310405"
            ]
          },
          "200310405": {
            "id": "200310405",
            "speakerId": 12913,
            "speakerName": "凯瑟琳",
            "text": "他们其实都是在协会发布了委托的。",
            "nextDialogs": [
              "200310408"
            ]
          },
          "200310408": {
            "id": "200310408",
            "speakerId": 12913,
            "speakerName": "凯瑟琳",
            "text": "总之，还是和你简单介绍下吧。",
            "nextDialogs": [
              "200310409"
            ]
          },
          "200310409": {
            "id": "200310409",
            "speakerId": 12913,
            "speakerName": "凯瑟琳",
            "text": "冒险家协会每天都会收到来自各处的委托，并负责整理发放给各位冒险家。",
            "nextDialogs": [
              "200310410"
            ]
          },
          "200310410": {
            "id": "200310410",
            "speakerId": 12913,
            "speakerName": "凯瑟琳",
            "text": "这也是冒险家们最主要的报酬来源。",
            "nextDialogs": [
              "200310411"
            ]
          },
          "200310411": {
            "id": "200310411",
            "speakerId": 12913,
            "speakerName": "凯瑟琳",
            "text": "说到报酬，就不得不提到协会为你准备的一个惊喜。"
          }
        }
      }
    }

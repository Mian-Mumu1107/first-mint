{
  "lineCounts": {
    "Player": 9,
    "凯瑟琳": 47,
    "派蒙": 3
  },
  "subQuests": [
    {
      "subId": "2003101",
      "subQuestName": "与凯瑟琳对话",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "200310101"
        ],
        "dialogs": {
          "200310101": {
            "id": "200310101",
            "speakerId": 12913,
            "speakerName": "凯瑟琳",
            "text": "我们又见面了，冒险家新星。",
            "nextDialogs": [
              "200310102"
            ]
          },
          "200310102": {
            "id": "200310102",
            "speakerId": 12913,
            "speakerName": "凯瑟琳",
            "text": "怎么样，最近的冒险还顺利吗？",
            "nextDialogs": [
              "200310104",
              "200310106"
            ]
          },
          "200310104": {
            "id": "200310104",
            "speakerId": 12913,
            "speakerName": "凯瑟琳",
            "text": "很不错的气势，记得一直保持下去哦。",
            "nextDialogs": [
              "200310107"
            ]
          },
          "200310107": {
            "id": "200310107",
            "speakerId": 12913,
            "speakerName": "凯瑟琳",
            "text": "看起来你已经积累了很多的阅历，是时候介绍给你冒险家协会的重要工作了。",
            "nextDialogs": [
              "200310108"
            ]
          },
          "200310108": {
            "id": "200310108",
            "speakerId": 12913,
            "speakerName": "凯瑟琳",
            "text": "冒险家协会每天都会收到来自各处的<color=#00E1FFFF>委托</color>，并负责整理发放给各位冒险家。",
            "nextDialogs": [
              "200310109"
            ]
          },
          "200310109": {
            "id": "200310109",
            "speakerId": 12913,
            "speakerName": "凯瑟琳",
            "text": "这也是冒险家们最主要的报酬来源。",
            "nextDialogs": [
              "200310110"
            ]
          },
          "200310110": {
            "id": "200310110",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "都是什么样的委托？",
            "nextDialogs": [
              "200310111"
            ]
          },
          "200310111": {
            "id": "200310111",
            "speakerId": 12913,
            "speakerName": "凯瑟琳",
            "text": "什么类型都可能有，从帮助居民到清理怪物，有琐碎的也有很危险的。",
            "nextDialogs": [
              "200310112"
            ]
          },
          "200310112": {
            "id": "200310112",
            "speakerId": 12913,
            "speakerName": "凯瑟琳",
            "text": "俗话说百闻不如一见，还是亲自上手做一做更容易理解。",
            "nextDialogs": [
              "200310113"
            ]
          },
          "200310113": {
            "id": "200310113",
            "speakerId": 12913,
            "speakerName": "凯瑟琳",
            "text": "这里就是今天的委托内容。",
            "nextDialogs": [
              "200310114"
            ]
          },
          "200310114": {
            "id": "200310114",
            "speakerId": 12913,
            "speakerName": "凯瑟琳",
            "text": "麻烦完成之后来向我报告一下，我会提供一份丰厚的奖励的。"
          },
          "200310106": {
            "id": "200310106",
            "speakerId": 12913,
            "speakerName": "凯瑟琳",
            "text": "刚开始是会这样的，在冒险前做好准备会让你轻松不少。"
          }
        }
      }
    },
    {
      "subId": "2003102",
      "subQuestName": "(test)与凯瑟琳对话$HIDDEN",
      "sceneId": null,
      "locations": [],
      "dialogue": {

      }
    },
    {
      "subId": "2003103",
      "subQuestName": "(test)完成委托$HIDDEN",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "201013701"
        ],
        "dialogs": {
          "201013701": {
            "id": "201013701",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "<color=#FFCC33FF>领取「每日委托」奖励</color>",
            "nextDialogs": [
              "201013702"
            ]
          },
          "201013702": {
            "id": "201013702",
            "speakerId": 12913,
            "speakerName": "凯瑟琳",
            "text": "感谢你完成了今天的委托，这是给你的奖励。"
          }
        }
      }
    },
    {
      "subId": "2003104",
      "subQuestName": "(test)与凯瑟琳对话$HIDDEN",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "200310301"
        ],
        "dialogs": {
          "200310301": {
            "id": "200310301",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "嘿嘿，那我们就不客气地收下了。",
            "nextDialogs": [
              "200310302"
            ]
          },
          "200310302": {
            "id": "200310302",
            "speakerId": 12913,
            "speakerName": "凯瑟琳",
            "text": "尽管收下，这是冒险家协会表示感谢的方式。",
            "nextDialogs": [
              "200310303"
            ]
          },
          "200310303": {
            "id": "200310303",
            "speakerId": 12913,
            "speakerName": "凯瑟琳",
            "text": "因为每天协会都会收到很多委托，如果不是各位冒险家鼎力相助，是肯定没办法完成的。",
            "nextDialogs": [
              "200310304"
            ]
          },
          "200310304": {
            "id": "200310304",
            "speakerId": 12913,
            "speakerName": "凯瑟琳",
            "text": "当你每天完成足够数量的委托，就可以到我这里领取一份额外的礼物。",
            "nextDialogs": [
              "200310305"
            ]
          },
          "200310305": {
            "id": "200310305",
            "speakerId": 12913,
            "speakerName": "凯瑟琳",
            "text": "「冒险之证」里会记录今天已经完成过的数量。",
            "nextDialogs": [
              "200310306"
            ]
          },
          "200310306": {
            "id": "200310306",
            "speakerId": 12913,
            "speakerName": "凯瑟琳",
            "text": "一定记得要当天过来领取礼物，因为数量有限，错过了是没办法补发的。",
            "nextDialogs": [
              "200310308",
              "200310310"
            ]
          },
          "200310308": {
            "id": "200310308",
            "speakerId": 12913,
            "speakerName": "凯瑟琳",
            "text": "不用客气，是应该谢谢你。",
            "nextDialogs": [
              "200310312"
            ]
          },
          "200310312": {
            "id": "200310312",
            "speakerId": 12913,
            "speakerName": "凯瑟琳",
            "text": "对了，如果你帮助你的冒险伙伴完成委托，同样会计算在领取礼物的数量之内。",
            "nextDialogs": [
              "200310313"
            ]
          },
          "200310313": {
            "id": "200310313",
            "speakerId": 12913,
            "speakerName": "凯瑟琳",
            "text": "也请多多与你的伙伴相互合作吧！向着星辰与深渊！"
          },
          "200310310": {
            "id": "200310310",
            "speakerId": 12913,
            "speakerName": "凯瑟琳",
            "text": "现在的话是这样的…很抱歉。",
            "nextDialogs": [
              "200310311"
            ]
          },
          "200310311": {
            "id": "200310311",
            "speakerId": 12913,
            "speakerName": "凯瑟琳",
            "text": "不过也请放心，关于冒险家们的报酬，我们一直都在和总部争取。"
          }
        }
      }
    },

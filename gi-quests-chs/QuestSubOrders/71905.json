          },
          "719050102": {
            "id": "719050102",
            "speakerId": 1000,
            "speakerName": "快刀陈",
            "text": "唉，提起师门，多少还是会有些怀念的，也不知道师父和师弟、师妹他们现在在做什么…",
            "nextDialogs": [

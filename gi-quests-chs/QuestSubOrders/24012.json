          }
        }
      }
    },
    {
      "subId": "2401283",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "240128301"
        ],
        "dialogs": {
          "240128301": {
            "id": "240128301",
            "speakerId": 1000,
            "speakerName": "阿鲁埃",
            "text": "唔，这份「浓缩咖啡」的味道不太对啊…",
            "nextDialogs": [
              "240128302"
            ]
          },
          "240128302": {
            "id": "240128302",
            "speakerId": 1000,
            "speakerName": "阿鲁埃",
            "text": "制作这种咖啡时，只要将<color=#00E1FFFF>两份咖啡液</color>混合起来就好了。",
            "nextDialogs": [
              "240128303"
            ]
          },
          "240128303": {
            "id": "240128303",
            "speakerId": 1000,
            "speakerName": "阿鲁埃",
            "text": "请您再试着调制一遍吧。"
          }
        }
      }
    },
    {
      "subId": "2401284",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "240128401"
        ],
        "dialogs": {
          "240128401": {
            "id": "240128401",
            "speakerId": 1000,
            "speakerName": "阿鲁埃",
            "text": "您的咖啡调制好了吗？",
            "nextDialogs": [
              "240128403",
              "240128406"
            ]
          },
          "240128403": {
            "id": "240128403",
            "speakerId": 1000,
            "speakerName": "阿鲁埃",
            "text": "首先，您需要<color=#00E1FFFF>一份咖啡液</color>，<color=#00E1FFFF>一份牛奶</color>，将它们完全混合。",
            "nextDialogs": [
              "240128404"
            ]
          },
          "240128404": {
            "id": "240128404",
            "speakerId": 1000,
            "speakerName": "阿鲁埃",
            "text": "之后，再覆上<color=#00E1FFFF>一份「奶泡」</color>…「奶泡」我已经帮您准备好了，放在那边。"
          },
          "240128406": {
            "id": "240128406",
            "speakerId": 1000,
            "speakerName": "阿鲁埃",
            "text": "我很期待您所调制咖啡的味道。"
          }
        }
      }
    },
    {
      "subId": "2401285",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "240128501"
        ],

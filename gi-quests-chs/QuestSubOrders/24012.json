    {
      "subId": "2401212",
      "subQuestName": "与阿鲁埃对话",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "240121201"
        ],
        "dialogs": {
          "240121201": {
            "id": "240121201",
            "speakerId": 1000,
            "speakerName": "阿鲁埃",
            "text": "唔，这份「溶奶咖啡」的味道不太对啊…",
            "nextDialogs": [
              "240121202"
            ]
          },
          "240121202": {
            "id": "240121202",
            "speakerId": 1000,
            "speakerName": "阿鲁埃",
            "text": "首先，您需要<color=#00E1FFFF>一份咖啡液</color>，<color=#00E1FFFF>一份牛奶</color>，将它们完全混合。",
            "nextDialogs": [
              "240121203"
            ]
          },
          "240121203": {
            "id": "240121203",
            "speakerId": 1000,
            "speakerName": "阿鲁埃",
            "text": "之后，再覆上<color=#00E1FFFF>一份「奶泡」</color>…「奶泡」我已经帮您准备好了，放在那边。",
            "nextDialogs": [
              "240121204"
            ]
          },
          "240121204": {
            "id": "240121204",
            "speakerId": 1000,
            "speakerName": "阿鲁埃",
            "text": "请您再试着调制一遍吧。"
          }
        }
      }
    },
    {
      "subId": "2401214",
      "subQuestName": "与阿鲁埃对话",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "240121401"
        ],
        "dialogs": {
          "240121401": {
            "id": "240121401",
            "speakerId": 1000,
            "speakerName": "阿鲁埃",
            "text": "您今天的手法怎么乱七八糟的…是遇见什么事了吗？",
            "nextDialogs": [
              "240121402"
            ]
          },
          "240121402": {
            "id": "240121402",
            "speakerId": 1000,
            "speakerName": "阿鲁埃",
            "text": "没关系，这次就由我来调制咖啡吧。",
            "nextDialogs": [
              "240121403"
            ]
          },
          "240121403": {
            "id": "240121403",
            "speakerId": 1001,
            "speakerName": "Black Screen",
            "text": "阿鲁埃开始调制咖啡…",
            "nextDialogs": [
              "240121404"
            ]
          },
          "240121404": {
            "id": "240121404",
            "speakerId": 1000,
            "speakerName": "阿鲁埃",
            "text": "好了，请您把这杯咖啡给客人端过去吧。"
          }
        }
      }
    },
    {
      "subId": "2401209",
      "subQuestName": "与阿鲁埃对话",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "240120901"
        ],
        "dialogs": {
          "240120901": {
            "id": "240120901",
            "speakerId": 1000,
            "speakerName": "阿鲁埃",
            "text": "非常好！堪称完美的味道，快点端给客人吧，她一定会很享受这杯咖啡的。"
          }
        }
      }
    },

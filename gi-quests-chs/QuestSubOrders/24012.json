  "subQuests": [
    {
      "subId": "2401201",
      "subQuestName": "与阿鲁埃对话",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "240127101"
        ],
        "dialogs": {
          "240127101": {
            "id": "240127101",
            "speakerId": 1000,
            "speakerName": "阿鲁埃",
            "text": "夏特莱小姐刚刚点了一杯<color=#00E1FFFF>「溶奶咖啡」</color>。",
            "nextDialogs": [
              "240127102"
            ]
          },
          "240127102": {
            "id": "240127102",
            "speakerId": 1000,
            "speakerName": "阿鲁埃",
            "text": "首先，您需要<color=#00E1FFFF>一份咖啡液</color>，<color=#00E1FFFF>一份牛奶</color>，将它们完全混合之后，再覆上<color=#00E1FFFF>一份「奶泡」</color>。",
            "nextDialogs": [
              "240127103"
            ]
          },
          "240127103": {
            "id": "240127103",
            "speakerId": 1000,
            "speakerName": "阿鲁埃",
            "text": "「奶泡」是我们店里的特别食材。想要做的话，先得准备好另一份牛奶，再把咖啡机的这根管子洗净，擦干…",
            "nextDialogs": [
              "240127104"
            ]
          },
          "240127104": {
            "id": "240127104",
            "speakerId": 1000,
            "speakerName": "阿鲁埃",
            "text": "再把管子以这个角度插入牛奶罐里…呃，还是我直接帮您做好吧，让一个新手来打奶泡实在是太难为人了…"
          }
        }
      }
    },
    {
      "subId": "2401215",
      "subQuestName": "",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "240125101"
        ],
        "dialogs": {
          "240125101": {
            "id": "240125101",
            "speakerId": 1000,
            "speakerName": "阿鲁埃",
            "text": "今天，您不需要为任何客人调制咖啡。",
            "nextDialogs": [
              "240125102"
            ]
          },
          "240125102": {
            "id": "240125102",
            "speakerId": 1000,
            "speakerName": "阿鲁埃",
            "text": "您也在店里帮了这么多的忙，调咖啡的手艺也日渐精湛…就我来看，您绝对够资格成为正式的「咖啡师」了。",
            "nextDialogs": [
              "240125105"
            ]
          },
          "240125105": {
            "id": "240125105",
            "speakerId": 1000,
            "speakerName": "阿鲁埃",
            "text": "这就得说起玛卡德尔先生给我们找的麻烦了。",
            "nextDialogs": [
              "240125140"
            ]
          },
          "240125140": {
            "id": "240125140",
            "speakerId": 1000,
            "speakerName": "阿鲁埃",
            "text": "这位在沫芒宫工作的先生虽然对调制咖啡一窍不通，但他无事生非可是一把好手。",
            "nextDialogs": [
              "240125106"
            ]
          },
          "240125106": {
            "id": "240125106",
            "speakerId": 1000,
            "speakerName": "阿鲁埃",
            "text": "他要求所有咖啡店执行他设计的方案，并且接受沫芒宫工作人员的监督。",
            "nextDialogs": [
              "240125107"
            ]
          },
          "240125107": {
            "id": "240125107",
            "speakerId": 1000,
            "speakerName": "阿鲁埃",
            "text": "具体来说，就是对店内雇佣的咖啡师展开「能力评估」，将咖啡师的能力分为从一到五的五个等级。",
            "nextDialogs": [
              "240125108"
            ]
          },
          "240125108": {
            "id": "240125108",
            "speakerId": 1000,
            "speakerName": "阿鲁埃",
            "text": "这种「能力评估」里不仅包含一份二十七页的纸面考试，还包括一系列从基础到高级的实际操作测试。",
            "nextDialogs": [
              "240125109"
            ]
          },
          "240125109": {
            "id": "240125109",
            "speakerId": 1000,
            "speakerName": "阿鲁埃",
            "text": "在评估完成后，玛卡德尔先生和他那些同样精通没事找事的同事就会为咖啡师颁发所谓的「等级证书」。",
            "nextDialogs": [
              "240125110"
            ]
          },
          "240125110": {
            "id": "240125110",
            "speakerId": 1000,
            "speakerName": "阿鲁埃",
            "text": "持有「等级证书」的人，就是正式咖啡师，反之则是非正式咖啡师。",
            "nextDialogs": [
              "240125111"
            ]
          },
          "240125111": {
            "id": "240125111",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "这份「等级证书」有什么作用吗？",
            "nextDialogs": [
              "240125112"
            ]
          },
          "240125112": {
            "id": "240125112",
            "speakerId": 1000,
            "speakerName": "阿鲁埃",
            "text": "到目前为止，根据我和其他同行的观察，这份「等级证书」在调制咖啡时并没什么大用。",
            "nextDialogs": [
              "240125113"
            ]
          },
          "240125113": {
            "id": "240125113",
            "speakerId": 1000,
            "speakerName": "阿鲁埃",
            "text": "它并不会让某人调出的咖啡变得美味或劣质，也不会对咖啡师调制咖啡的水平造成任何影响。",
            "nextDialogs": [
              "240125114"
            ]
          },
          "240125114": {
            "id": "240125114",
            "speakerId": 1000,
            "speakerName": "阿鲁埃",
            "text": "唯一的作用，就是让玛卡德尔先生又亲自牵头成立了一个「咖啡管理办公室」，还下属不少人呢。"
          }
        }
      }
    },
    {
      "subId": "2401202",
      "subQuestName": "开始调制咖啡",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "240120202"
        ],
        "dialogs": {
          "240120202": {
            "id": "240120202",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "准备好了。",
            "nextDialogs": [
              "240120203"
            ]
          },
          "240120203": {
            "id": "240120203",
            "speakerId": 1000,
            "speakerName": "阿鲁埃",
            "text": "很好，那就开始吧。如果有什么问题，可以再来问问我。"
          }
        }
      }
    },
    {
      "subId": "2401203",
      "subQuestName": "开始调制「特调咖啡」",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "240120301"
        ],
        "dialogs": {
          "240120301": {
            "id": "240120301",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "（应该加入咖啡调制材料了吧…）"
          }
        }
      }
    },
    {
      "subId": "2401204",
      "subQuestName": "与阿鲁埃对话",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "240120401"
        ],
        "dialogs": {
          "240120401": {
            "id": "240120401",
            "speakerId": 1001,
            "speakerName": "Black Screen",
            "text": "在精准且高效的操作下，咖啡调制完成了…",
            "nextDialogs": [
              "240120402"
            ]
          },
          "240120402": {
            "id": "240120402",
            "speakerId": 1000,
            "speakerName": "阿鲁埃",
            "text": "多么惊人的味道…这股香气和醇厚感，让我尝一口…",
            "nextDialogs": [
              "240120403"
            ]
          },
          "240120403": {
            "id": "240120403",
            "speakerId": 1000,
            "speakerName": "阿鲁埃",
            "text": "完美！完美的味道，您就是天生的咖啡师！",
            "nextDialogs": [
              "240120404"
            ]
          },
          "240120404": {
            "id": "240120404",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "太夸张了…",
            "nextDialogs": [
              "240120405"
            ]
          },
          "240120405": {
            "id": "240120405",
            "speakerId": 1000,
            "speakerName": "阿鲁埃",
            "text": "哎呀！就是因为这样不必要的谦虚，您才会亲手把自己的咖啡师天赋给埋没了，我的眼光绝不会出错！",
            "nextDialogs": [
              "240120406"
            ]
          },
          "240120406": {
            "id": "240120406",
            "speakerId": 1000,
            "speakerName": "阿鲁埃",
            "text": "恭喜您，从现在开始，您就是一位正式的咖啡师了。",
            "nextDialogs": [
              "240120407"
            ]
          },
          "240120407": {
            "id": "240120407",
            "speakerId": 1000,
            "speakerName": "阿鲁埃",
            "text": "对了，这个杯子还请您收下。这也是我这家店里的规矩，每一位正式的咖啡师都会拿到专属于自己的咖啡杯。",
            "nextDialogs": [
              "240120408"
            ]
          },
          "240120408": {
            "id": "240120408",
            "speakerId": 1000,
            "speakerName": "阿鲁埃",
            "text": "这个杯子会一直留在店里，如果您来店里喝咖啡，直接用它就好。",
            "nextDialogs": [
              "240120409"
            ]
          },
          "240120409": {
            "id": "240120409",
            "speakerId": 1000,
            "speakerName": "阿鲁埃",
            "text": "等我准备好之后，我就要去找敬爱的玛卡德尔先生谈谈，帮您在「咖啡管理办公室」里登记成正式咖啡师。",
            "nextDialogs": [
              "240120410"
            ]
          },
          "240120410": {
            "id": "240120410",
            "speakerId": 1000,
            "speakerName": "阿鲁埃",
            "text": "希望玛卡德尔能听得懂人话…哼…"
          }
        }
      }
    },

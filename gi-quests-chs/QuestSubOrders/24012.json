      }
    },
    {
      "subId": "2401211",
      "subQuestName": "与阿鲁埃对话",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "240121101"
        ],
        "dialogs": {
          "240121101": {
            "id": "240121101",
            "speakerId": 1000,
            "speakerName": "阿鲁埃",
            "text": "很好！客人非常满意您调制的咖啡，您真是天生的咖啡师。",
            "nextDialogs": [
              "240121102"
            ]
          },
          "240121102": {
            "id": "240121102",
            "speakerId": 1000,
            "speakerName": "阿鲁埃",
            "text": "要是您以后有空，还请多多来店里，无论是做客还是调咖啡，我都欢迎。",
            "nextDialogs": [
              "240121103"
            ]
          },
          "240121103": {
            "id": "240121103",
            "speakerId": 1000,
            "speakerName": "阿鲁埃",
            "text": "但我还是得再和您说，您是有天赋的，如果真的下力气研究，成为一名伟大的咖啡师也只是时间问题…"
          }
        }
      }
    },
    {
      "subId": "2401201",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "240120101"
        ],
        "dialogs": {
          "240120101": {
            "id": "240120101",
            "speakerId": 1000,
            "speakerName": "阿鲁埃",
            "text": "您好，欢迎光临，需要喝点什么？",
            "nextDialogs": [
              "240120106"
            ]
          },
          "240120106": {
            "id": "240120106",
            "speakerId": 1000,
            "speakerName": "阿鲁埃",
            "text": "先明白地说说您偏爱的口味，再去找个地方坐下吧，咖啡一会就好。",
            "nextDialogs": [
              "240120107"
            ]
          },
          "240120107": {
            "id": "240120107",
            "speakerId": 1000,
            "speakerName": "阿鲁埃",
            "text": "但是您可得听我告诫，在找位置的时候，记得离其他客人远一些。",
            "nextDialogs": [
              "240120110"
            ]
          },
          "240120110": {
            "id": "240120110",
            "speakerId": 1000,
            "speakerName": "阿鲁埃",
            "text": "那倒不是，喝咖啡的人大多想有个说话的伴，而且表达欲旺盛着呢，您要是被他们拉着了，一时半会就脱不开身了。",
            "nextDialogs": [
              "240120111"
            ]
          },
          "240120111": {
            "id": "240120111",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "听着像是喝醉了似的…",
            "nextDialogs": [
              "240120112"
            ]
          },
          "240120112": {
            "id": "240120112",
            "speakerId": 1000,
            "speakerName": "阿鲁埃",
            "text": "醉汉可比这群坐在这里喝咖啡的先生们好对付多了。如果一个醉汉缠着您，只要叫警官过来，他马上就能醒酒。",
            "nextDialogs": [
              "240120113"
            ]
          },
          "240120113": {
            "id": "240120113",
            "speakerId": 1000,
            "speakerName": "阿鲁埃",
            "text": "这群先生在高谈阔论时可清醒着呢，在您和他之中的一个人服软之前，无论是您还是拳头，都无法让他闭上嘴。",
            "nextDialogs": [
              "240120114"
            ]
          },
          "240120114": {
            "id": "240120114",
            "speakerId": 1000,
            "speakerName": "阿鲁埃",
            "text": "所以我请您坐下时稍微离这些客人远点，保持着距离。不然您刚来枫丹廷不久，就要对咱们这里落下个坏印象啦。",
            "nextDialogs": [
              "240120115"
            ]
          },
          "240120115": {
            "id": "240120115",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "他们为什么会…这样？",
            "nextDialogs": [
              "240120116"
            ]
          },
          "240120116": {
            "id": "240120116",
            "speakerId": 1000,
            "speakerName": "阿鲁埃",
            "text": "您要是问我的话…那当然是我这店里的咖啡太美味了，客人们都不忍心一口气喝完，只能断断续续地细细品味。",
            "nextDialogs": [
              "240120117"
            ]
          },
          "240120117": {
            "id": "240120117",
            "speakerId": 1000,
            "speakerName": "阿鲁埃",
            "text": "他们又无法忍受没咖啡可品的时间空档，不得不找个人说话打发时间呀…当然，这是开玩笑的。",
            "nextDialogs": [
              "240120118"
            ]
          },
          "240120118": {
            "id": "240120118",
            "speakerId": 1000,
            "speakerName": "阿鲁埃",
            "text": "咖啡店和酒馆一样，都是个放松的场所…大家在一天工作之后，总是聚在这里抱怨自己遇见的糟糕事。",
            "nextDialogs": [
              "240120119"
            ]
          },
          "240120119": {
            "id": "240120119",
            "speakerId": 1000,
            "speakerName": "阿鲁埃",
            "text": "单论放松的话，喝酒当然更有效果。但喝酒有一个咖啡绝对不会有的坏处…",
            "nextDialogs": [
              "240120120"
            ]
          },
          "240120120": {
            "id": "240120120",
            "speakerId": 1000,
            "speakerName": "阿鲁埃",
            "text": "如果一个人放怀畅饮，每抱怨一件糟糕事就喝下一杯的话，那他一定会喝太多，最后丢掉自个的理智。",
            "nextDialogs": [
              "240120121"
            ]
          },
          "240120121": {
            "id": "240120121",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "喝醉了确实很糟糕…",
            "nextDialogs": [
              "240120122"
            ]
          },
          "240120122": {
            "id": "240120122",
            "speakerId": 1000,
            "speakerName": "阿鲁埃",
            "text": "没错，我见过一个在沫芒宫工作的先生，平时这先生待人彬彬有礼，既耐心又细心。",
            "nextDialogs": [
              "240120123"
            ]
          },
          "240120123": {
            "id": "240120123",
            "speakerId": 1000,
            "speakerName": "阿鲁埃",
            "text": "有一天他喝多了，坚持认为自己是个苹果树，还尖叫着说有人把他拔出来，又剥了树皮…虽然那些衣服是他自己脱掉的。",
            "nextDialogs": [
              "240120124"
            ]
          },
          "240120124": {
            "id": "240120124",
            "speakerId": 1000,
            "speakerName": "阿鲁埃",
            "text": "然后，他就满世界地开始找树坑，大声嚷嚷着自己必须得回土里去，不然就得枯死。",
            "nextDialogs": [
              "240120125"
            ]
          },
          "240120125": {
            "id": "240120125",
            "speakerId": 1000,
            "speakerName": "阿鲁埃",
            "text": "还好有一个先生急中生智，指挥着我们在外面挖了个坑。挖好坑之后，我们就朝苹果树先生大喊：「嘿！这里的苹果树呢？」",
            "nextDialogs": [
              "240120126"
            ]
          },
          "240120126": {
            "id": "240120126",
            "speakerId": 1000,
            "speakerName": "阿鲁埃",
            "text": "那位苹果树先生就像是听见警报一样，一下子跳进了坑里，还催我们快些埋土…最后，他在半个身子没在土里的情况下睡着了。",
            "nextDialogs": [
              "240120127"
            ]
          },
          "240120127": {
            "id": "240120127",
            "speakerId": 1000,
            "speakerName": "阿鲁埃",
            "text": "而我们也得到了安宁，除了那位出主意的先生有些倒霉…"
          }
        }
      }
    },
    {
      "subId": "2401202",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "240120201"
        ],
        "dialogs": {
          "240120201": {
            "id": "240120201",
            "speakerId": 1000,
            "speakerName": "阿鲁埃",
            "text": "准备好开始调制咖啡了吗？",
            "nextDialogs": [
              "240120204"
            ]
          },
          "240120204": {
            "id": "240120204",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "还有别的事…",
            "nextDialogs": [
              "240120205"
            ]
          },
          "240120205": {
            "id": "240120205",
            "speakerId": 1000,
            "speakerName": "阿鲁埃",
            "text": "您准备好了之后，就和我说。如果有什么问题，也可以再来问问我。"
          }
        }
      }
    },
    {
      "subId": "2401252",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "240125201"
        ],
        "dialogs": {
          "240125201": {
            "id": "240125201",
            "speakerId": 1000,
            "speakerName": "阿鲁埃",
            "text": "看来您今天的心情不太平静啊，调制咖啡的手法都乱了。",
            "nextDialogs": [
              "240125202"
            ]
          },
          "240125202": {
            "id": "240125202",
            "speakerId": 1000,
            "speakerName": "阿鲁埃",
            "text": "没关系，每个人都有这种时候，您得学着放轻松，这只是一杯咖啡，并不是您全部的人生。",
            "nextDialogs": [
              "240125203"
            ]
          },
          "240125203": {
            "id": "240125203",
            "speakerId": 1000,
            "speakerName": "阿鲁埃",
            "text": "相信我，您绝对是有天赋的，只要沉下心来，一定能调制出美味的咖啡。"
          }
        }
      }
    },
    {
      "subId": "2401261",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "240126101"
        ],
        "dialogs": {
          "240126101": {
            "id": "240126101",
            "speakerId": 1000,
            "speakerName": "阿鲁埃",
            "text": "您可算来了。没了您帮忙，我都有点支持不住了，快点来柜台里吧。",
            "nextDialogs": [
              "240126102"
            ]
          },
          "240126102": {
            "id": "240126102",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "客人很多吗？",
            "nextDialogs": [
              "240126103"
            ]
          },
          "240126103": {
            "id": "240126103",
            "speakerId": 1000,
            "speakerName": "阿鲁埃",
            "text": "出乎意料地多。自从您帮我调制咖啡之后，这店里的桌子就没有空过。",
            "nextDialogs": [
              "240126104"
            ]
          },
          "240126104": {
            "id": "240126104",
            "speakerId": 1000,
            "speakerName": "阿鲁埃",
            "text": "我之前说什么来着？您就是做这一行的料！要是您愿意，就一直在这里帮我吧。",
            "nextDialogs": [
              "240126105"
            ]
          },
          "240126105": {
            "id": "240126105",
            "speakerId": 1000,
            "speakerName": "阿鲁埃",
            "text": "要是生意够好，我说不定还能帮您去别处开个分店。",
            "nextDialogs": [
              "240126108"
            ]
          },
          "240126108": {
            "id": "240126108",
            "speakerId": 1000,
            "speakerName": "阿鲁埃",
            "text": "好吧，您看着也像是个忙人。您之前从店门口路过的时候，跑得和风一样，我还以为有人在追您呢。",
            "nextDialogs": [
              "240126109"
            ]
          },
          "240126109": {
            "id": "240126109",
            "speakerId": 1000,
            "speakerName": "阿鲁埃",
            "text": "但既然您今天来这里了，想必…是总算空出点时间来了？"
          }
        }
      }
    },
    {
      "subId": "2401272",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "240127201"
        ],
        "dialogs": {
          "240127201": {
            "id": "240127201",
            "speakerId": 1000,
            "speakerName": "阿鲁埃",
            "text": "梅莘警官似乎有点急事要办，她点了一杯<color=#00E1FFFF>「明澈咖啡」</color>。",
            "nextDialogs": [
              "240127202"
            ]
          },
          "240127202": {
            "id": "240127202",
            "speakerId": 1000,
            "speakerName": "阿鲁埃",
            "text": "您只需要<color=#00E1FFFF>一份咖啡</color>，<color=#00E1FFFF>一份饮用水</color>。拿好装咖啡的杯子，把水倒进去，这杯咖啡就成了，是不是非常简单？",
            "nextDialogs": [
              "240127203"
            ]
          },
          "240127203": {
            "id": "240127203",
            "speakerId": 1000,
            "speakerName": "阿鲁埃",
            "text": "虽然我个人不是非常喜欢这类调制手法太过随便，忽视咖啡风味的咖啡…",
            "nextDialogs": [
              "240127204"
            ]
          },
          "240127204": {
            "id": "240127204",
            "speakerId": 1000,
            "speakerName": "阿鲁埃",
            "text": "但这种咖啡调制起来方便快捷，而且除开咖啡液之外，它所采用的调制材料只有饮用水，没有牛奶之类的食材中和，所以提神的效果也非常明显。",
            "nextDialogs": [
              "240127205"
            ]
          },
          "240127205": {
            "id": "240127205",
            "speakerId": 1000,
            "speakerName": "阿鲁埃",
            "text": "对梅莘警官这种成天奔波，心力交瘁，但又不得不鼓起力气继续工作的人来说，喝这种咖啡再合适不过了…",
            "nextDialogs": [
              "240127206"
            ]
          },
          "240127206": {
            "id": "240127206",
            "speakerId": 1000,
            "speakerName": "阿鲁埃",
            "text": "唉，梅莘警官啊…"
          }
        }
      }
    },
    {
      "subId": "2401273",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "240127301"
        ],
        "dialogs": {
          "240127301": {
            "id": "240127301",
            "speakerId": 1000,
            "speakerName": "阿鲁埃",
            "text": "夏特莱小姐今天心情好像不错，刚来点了一杯<color=#00E1FFFF>「奶芙咖啡」</color>。",
            "nextDialogs": [
              "240127302"
            ]
          },
          "240127302": {
            "id": "240127302",
            "speakerId": 1000,
            "speakerName": "阿鲁埃",
            "text": "制作时需要<color=#00E1FFFF>一份咖啡液</color>，<color=#00E1FFFF>一份牛奶</color>，把两者混合后，在最上方打入<color=#00E1FFFF>一份「奶油」</color>。",
            "nextDialogs": [
              "240127303"
            ]
          },
          "240127303": {
            "id": "240127303",
            "speakerId": 1000,
            "speakerName": "阿鲁埃",
            "text": "您尝过本店特制的奶油吗？味道非常不错，口感如同云朵一般绵柔，也不会太甜…",
            "nextDialogs": [
              "240127304"
            ]
          },
          "240127304": {
            "id": "240127304",
            "speakerId": 1000,
            "speakerName": "阿鲁埃",
            "text": "呃？哦，不用您亲手做，直接用店里的存货就好，我就是想为您介绍介绍…"
          }
        }
      }
    },
    {
      "subId": "2401274",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "240127401"
        ],
        "dialogs": {
          "240127401": {
            "id": "240127401",
            "speakerId": 1000,
            "speakerName": "阿鲁埃",
            "text": "梅莘警官好像遇见了烦心事…她点了一杯<color=#00E1FFFF>「浓缩咖啡」</color>。",
            "nextDialogs": [
              "240127402"
            ]
          },
          "240127402": {
            "id": "240127402",
            "speakerId": 1000,
            "speakerName": "阿鲁埃",
            "text": "制作这种咖啡…将<color=#00E1FFFF>两份咖啡液</color>混合起来就好了，再搭配一份小点心，梅莘警官比较喜欢蛋糕。",
            "nextDialogs": [
              "240127403"
            ]
          },
          "240127403": {
            "id": "240127403",
            "speakerId": 1000,
            "speakerName": "阿鲁埃",
            "text": "唉，梅莘警官看起来好像更疲惫了…"
          }
        }
      }
    },
    {
      "subId": "2401281",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "240128101"
        ],
        "dialogs": {
          "240128101": {
            "id": "240128101",
            "speakerId": 1000,
            "speakerName": "阿鲁埃",
            "text": "唔，这份「明澈咖啡」的味道不太对啊…",
            "nextDialogs": [
              "240128102"
            ]
          },
          "240128102": {
            "id": "240128102",
            "speakerId": 1000,
            "speakerName": "阿鲁埃",
            "text": "您只需要<color=#00E1FFFF>一份咖啡</color>，<color=#00E1FFFF>一份饮用水</color>。拿好装咖啡的杯子，把水倒进去，这杯咖啡就成了。",
            "nextDialogs": [
              "240128103"
            ]
          },
          "240128103": {
            "id": "240128103",
            "speakerId": 1000,
            "speakerName": "阿鲁埃",
            "text": "请您再试着调制一遍吧。"
          }
        }
      }
    },
    {
      "subId": "2401282",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [

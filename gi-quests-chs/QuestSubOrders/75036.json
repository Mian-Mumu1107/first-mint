        ],
        "dialogs": {
          "750360801": {
            "id": "750360801",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "出来吧出来吧，小小的种子~",
            "nextDialogs": [
              "750360802"
            ]
          },
          "750360802": {
            "id": "750360802",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "出来吧出来吧，开漂亮的小花~",
            "nextDialogs": [
              "750360803"
            ]
          },
          "750360803": {
            "id": "750360803",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "…欸？",
            "nextDialogs": [
              "750360804"
            ]
          },
          "750360804": {
            "id": "750360804",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "唔…",
            "nextDialogs": [
              "750360805"
            ]
          },
          "750360805": {
            "id": "750360805",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "#啊，{NICKNAME}，燃素的能量没有了，一定是被种子好好吸收了，只是…怎么一点反应都没有…",
            "nextDialogs": [
              "750360806"
            ]
          },
          "750360806": {
            "id": "750360806",
            "speakerId": 1001,
            "speakerName": "#{REALNAME[ID(2)|SHOWHOST(true)]}",
            "text": "唔？",
            "nextDialogs": [
              "750360808",
              "750360812"
            ]
          },
          "750360808": {
            "id": "750360808",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "是嘛！不过想想也是…",
            "nextDialogs": [
              "750360809"
            ]
          },
          "750360809": {
            "id": "750360809",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "蒲公英只要「呼——」地一吹就能飞出好多白色的小伞，钩钩果会挂在小狼的身上，一直跑到很远的地方…",
            "nextDialogs": [
              "750360810"
            ]
          },
          "750360810": {
            "id": "750360810",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "种子的生命力都是很顽强的！",
            "nextDialogs": [
              "750360815"
            ]
          },
          "750360815": {
            "id": "750360815",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "那我们先不要打扰它了，过些时候再来看看吧！",
            "nextDialogs": [
              "750360816"
            ]
          },
          "750360816": {
            "id": "750360816",
            "speakerId": 1001,
            "speakerName": "#{REALNAME[ID(2)|SHOWHOST(true)]}",
            "text": "呀！"
          },
          "750360812": {
            "id": "750360812",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "真、真的吗？也对哦！是不是我太心急了…",
            "nextDialogs": [
              "750360813"
            ]
          },
          "750360813": {
            "id": "750360813",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "#种子又是被{REALNAME[ID(2)|SHOWHOST(true)]}挖出来，又是被飞虫偷取养分，还被怪物「轰隆隆」地打扰了一番…",
            "nextDialogs": [
              "750360814"
            ]
          },
          "750360814": {
            "id": "750360814",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "听到有人在花田上打架，对于埋在土里的种子来说，就像听到暴风和雷声一样吓人。然后它就悄悄地缩在土里，一动也不敢动了…嗯！一定是这样。"
          }
        }
      }

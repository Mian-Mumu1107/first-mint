  "subQuests": [
    {
      "subId": "2301601",
      "subQuestName": "与加尔恰对话",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "230160101"
        ],
        "dialogs": {
          "230160101": {
            "id": "230160101",
            "speakerId": 1000,
            "speakerName": "加尔恰",
            "text": "我的手…呃！全麻了…",
            "nextDialogs": [
              "230160102"
            ]
          },
          "230160102": {
            "id": "230160102",
            "speakerId": 1001,
            "speakerName": "路通",
            "text": "先生，您过段时间还要给迦雅小姐计算账目，可不要过分劳累。",
            "nextDialogs": [
              "230160103"
            ]
          },
          "230160103": {
            "id": "230160103",
            "speakerId": 1000,
            "speakerName": "加尔恰",
            "text": "我，我知道！别提这个，路通！",
            "nextDialogs": [
              "230160104"
            ]
          },
          "230160104": {
            "id": "230160104",
            "speakerId": 1001,
            "speakerName": "路通",
            "text": "当然，如果您不能去的话，我也可以为您代劳。",
            "nextDialogs": [
              "230160105"
            ]
          },
          "230160105": {
            "id": "230160105",
            "speakerId": 1000,
            "speakerName": "加尔恰",
            "text": "不！我自己会去，我只要再…再砸出几个齿轮来…",
            "nextDialogs": [
              "230160106"
            ]
          },
          "230160106": {
            "id": "230160106",
            "speakerId": 1000,
            "speakerName": "加尔恰",
            "text": "……",
            "nextDialogs": [
              "230160107"
            ]
          },
          "230160107": {
            "id": "230160107",
            "speakerId": 1000,
            "speakerName": "加尔恰",
            "text": "好吧，我砸不动了，我真的砸不动了…",
            "nextDialogs": [
              "230160108"
            ]
          },
          "230160108": {
            "id": "230160108",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "你又在干啥…",
            "nextDialogs": [
              "230160109"
            ]
          },
          "230160109": {
            "id": "230160109",
            "speakerId": 1000,
            "speakerName": "加尔恰",
            "text": "是你啊，旅行者…哎哟…我的手…",
            "nextDialogs": [
              "230160110"
            ]
          },
          "230160110": {
            "id": "230160110",
            "speakerId": 1000,
            "speakerName": "加尔恰",
            "text": "是这样，因为阿汉格尔先生还有其他的工作，不能一直帮我制作我要的零件…",
            "nextDialogs": [
              "230160111"
            ]
          },
          "230160111": {
            "id": "230160111",
            "speakerId": 1000,
            "speakerName": "加尔恰",
            "text": "而且他所制作的零件，总是和我想要的有一些细微的差别。",
            "nextDialogs": [
              "230160112"
            ]
          },
          "230160112": {
            "id": "230160112",
            "speakerId": 1000,
            "speakerName": "加尔恰",
            "text": "所以，为了保证这些零件的可靠性，我就直接向阿汉格尔先生请教了一下铸造的手法，决定自己来亲手铸造。",
            "nextDialogs": [
              "230160113"
            ]
          },
          "230160113": {
            "id": "230160113",
            "speakerId": 1000,
            "speakerName": "加尔恰",
            "text": "还好在枫丹的时候我有过类似的工作经验…但阿汉格尔先生和我说的那些手法，有些我是真记不住，哎哟…",
            "nextDialogs": [
              "230160114"
            ]
          },
          "230160114": {
            "id": "230160114",
            "speakerId": 1000,
            "speakerName": "加尔恰",
            "text": "旅行者，请您代我向阿汉格尔先生再请教一下手法，我是真的需要休息一下…",
            "nextDialogs": [
              "230160121",
              "230160117"
            ]
          },
          "230160121": {
            "id": "230160121",
            "speakerId": 1000,
            "speakerName": "加尔恰",
            "text": "谢谢您愿意帮忙，哎哟…我的手…"
          },
          "230160117": {
            "id": "230160117",
            "speakerId": 1000,
            "speakerName": "加尔恰",
            "text": "生意伙伴！一个…呃…才华横溢，财富也横溢的…生意伙伴！",
            "nextDialogs": [
              "230160118"
            ]
          },
          "230160118": {
            "id": "230160118",
            "speakerId": 1000,
            "speakerName": "加尔恰",
            "text": "我们之间签了长期的账目管理合同！所以我才会一直去找她，对吧路通？",
            "nextDialogs": [
              "230160119"
            ]
          },
          "230160119": {
            "id": "230160119",
            "speakerId": 1001,
            "speakerName": "路通",
            "text": "您说得很有道理，先生。",
            "nextDialogs": [
              "230160120"
            ]
          },
          "230160120": {
            "id": "230160120",
            "speakerId": 1000,
            "speakerName": "加尔恰",
            "text": "总，总之就是这样…旅行者，请您快些去找阿汉格尔先生请教一下吧，我就在这等您。"
          }
        }
      }
    },
    {
      "subId": "2301602",
      "subQuestName": "询问阿汉格尔",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "230160201"
        ],
        "dialogs": {
          "230160201": {
            "id": "230160201",
            "speakerId": 1002,
            "speakerName": "阿汉格尔",
            "text": "都说了等一会…嗯？怎么是你？",
            "nextDialogs": [
              "230160204"
            ]
          },
          "230160204": {
            "id": "230160204",
            "speakerId": 1002,
            "speakerName": "阿汉格尔",
            "text": "他还真去自己做了啊…真是个怪人。",
            "nextDialogs": [
              "230160205"
            ]
          },
          "230160205": {
            "id": "230160205",
            "speakerId": 1002,
            "speakerName": "阿汉格尔",
            "text": "我打了这么多年铁，从来没见过要求这么细致的人。",
            "nextDialogs": [
              "230160206"
            ]
          },
          "230160206": {
            "id": "230160206",
            "speakerId": 1002,
            "speakerName": "阿汉格尔",
            "text": "他居然还会拿着尺量铁管之间的接缝粗细，还有螺纹的间距。",
            "nextDialogs": [
              "230160207"
            ]
          },
          "230160207": {
            "id": "230160207",
            "speakerId": 1002,
            "speakerName": "阿汉格尔",
            "text": "我实在是不耐烦了，就说他有本事自己去做…结果他第二天还真的过来请教铸造的手法。",
            "nextDialogs": [
              "230160208"
            ]
          },
          "230160208": {
            "id": "230160208",
            "speakerId": 1002,
            "speakerName": "阿汉格尔",
            "text": "我真是服了他了，就随他去了，只要他自己出材料钱，工具什么的都让他用。",
            "nextDialogs": [
              "230160209"
            ]
          },
          "230160209": {
            "id": "230160209",
            "speakerId": 1002,
            "speakerName": "阿汉格尔",
            "text": "唉，真不知道这家伙想做什么东西…"
          }
        }
      }
    },
    {
      "subId": "2301603",
      "subQuestName": "向加尔恰回报",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "230163901"
        ],
        "dialogs": {
          "230163901": {
            "id": "230163901",
            "speakerId": 1003,
            "speakerName": "Black Screen",
            "text": "加尔恰开始了操作…",
            "nextDialogs": [
              "230163902"
            ]
          },
          "230163902": {
            "id": "230163902",
            "speakerId": 1000,
            "speakerName": "加尔恰",
            "text": "啊哈！成功了，这个齿轮不错！",
            "nextDialogs": [
              "230163903"
            ]
          },
          "230163903": {
            "id": "230163903",
            "speakerId": 1000,
            "speakerName": "加尔恰",
            "text": "齿间距…厚度…大小…我得拿个尺子来看看…",
            "nextDialogs": [
              "230163904"
            ]
          },
          "230163904": {
            "id": "230163904",
            "speakerId": 1001,
            "speakerName": "路通",
            "text": "就让加尔恰先生去测量数据吧，旅行者，这些报酬给你，请你收下吧。",
            "nextDialogs": [
              "230163905"
            ]
          },
          "230163905": {
            "id": "230163905",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "你还抱着谨慎悲观的态度吗？",
            "nextDialogs": [
              "230163906"
            ]
          },
          "230163906": {
            "id": "230163906",
            "speakerId": 1001,
            "speakerName": "路通",
            "text": "是的，我一直是这样的态度。",
            "nextDialogs": [
              "230163907"
            ]
          },
          "230163907": {
            "id": "230163907",
            "speakerId": 1001,
            "speakerName": "路通",
            "text": "我和加尔恰先生正在一座大山前徘徊，现在我们只是在山脚下搬开了一小块石头。",
            "nextDialogs": [
              "230163908"
            ]
          },
          "230163908": {
            "id": "230163908",
            "speakerId": 1001,
            "speakerName": "路通",
            "text": "但事实上，我们根本就没找到能进入山里的路。",
            "nextDialogs": [
              "230163909"
            ]
          },
          "230163909": {
            "id": "230163909",
            "speakerId": 1001,
            "speakerName": "路通",
            "text": "希望加尔恰先生的才能，能引导着我们走上正确的道路…",
            "nextDialogs": [
              "230163910"
            ]
          },
          "230163910": {
            "id": "230163910",
            "speakerId": 1001,
            "speakerName": "路通",
            "text": "不然我就只能默念那句「车到山前必有路」了。"
          }
        }
      }
    },
    {
      "subId": "2301603",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "230160301"
        ],
        "dialogs": {
          "230160301": {
            "id": "230160301",
            "speakerId": 1000,
            "speakerName": "加尔恰",
            "text": "路通！这个齿轮可以脱模了，快来帮帮忙！",
            "nextDialogs": [
              "230160302"
            ]
          },
          "230160302": {
            "id": "230160302",
            "speakerId": 1000,
            "speakerName": "加尔恰",
            "text": "旅行者，你也回来了，你应该已经向阿汉格尔先生请教到手法了吧。",
            "nextDialogs": [
              "230160303"
            ]
          },
          "230160303": {
            "id": "230160303",
            "speakerId": 1000,
            "speakerName": "加尔恰",
            "text": "快，快，我该怎么处理这齿轮？"
          }
        }
      }
    },
    {
      "subId": "2301631",
      "subQuestName": "Additional",
      "sceneId": null,

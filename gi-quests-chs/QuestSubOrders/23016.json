    {
      "subId": "2301634",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "230163401"
        ],
        "dialogs": {
          "230163401": {
            "id": "230163401",
            "speakerId": 1003,
            "speakerName": "Black Screen",
            "text": "加尔恰开始了操作…",
            "nextDialogs": [
              "230163402"
            ]
          },
          "230163402": {
            "id": "230163402",
            "speakerId": 1000,
            "speakerName": "加尔恰",
            "text": "好吧，这齿轮出炉了…然后呢？"
          }
        }
      }
    },
    {
      "subId": "2301635",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "230163501"
        ],
        "dialogs": {
          "230163501": {
            "id": "230163501",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "从内向外敲打。"
          }
        }
      }
    },
    {
      "subId": "2301636",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "230163601"
        ],
        "dialogs": {
          "230163601": {
            "id": "230163601",
            "speakerId": -1,

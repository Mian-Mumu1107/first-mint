            "text": "从外向内敲打。"
          }
        }
      }
    },
    {
      "subId": "2301637",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "230163701"
        ],
        "dialogs": {
          "230163701": {
            "id": "230163701",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "猛烈敲打中间。"
          }
        }
      }
    },
    {
      "subId": "2301638",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "230163801"
        ],
        "dialogs": {
          "230163801": {
            "id": "230163801",
            "speakerId": 1003,
            "speakerName": "Black Screen",
            "text": "加尔恰开始了操作…",
            "nextDialogs": [
              "230163802"
            ]
          },
          "230163802": {
            "id": "230163802",
            "speakerId": 1000,
            "speakerName": "加尔恰",
            "text": "呃…这齿轮看着好像…不太对啊。",
            "nextDialogs": [
              "230163803"
            ]
          },
          "230163803": {
            "id": "230163803",
            "speakerId": 1000,
            "speakerName": "加尔恰",
            "text": "没关系，我们再来一次…旅行者，我要注意什么？"
          }
        }
      }
    },
    {
      "subId": "2301650",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "230165001"
        ],
        "dialogs": {
          "230165001": {
            "id": "230165001",
            "speakerId": 1001,
            "speakerName": "路通",
            "text": "先生，依我来看，我们也许应该…换一个思路。",
            "nextDialogs": [
              "230165002"
            ]
          },
          "230165002": {
            "id": "230165002",
            "speakerId": 1000,
            "speakerName": "加尔恰",
            "text": "换一个思路？",
            "nextDialogs": [
              "230165003"
            ]
          },
          "230165003": {
            "id": "230165003",
            "speakerId": 1001,
            "speakerName": "路通",
            "text": "比如，尝试制作一些不那么复杂，但足够巧妙的机械。",
            "nextDialogs": [
              "230165004"
            ]
          },
          "230165004": {
            "id": "230165004",
            "speakerId": 1001,
            "speakerName": "路通",
            "text": "我相信以您的才能，制作出这类机械一定…",
            "nextDialogs": [
              "230165005"
            ]
          },
          "230165005": {
            "id": "230165005",
            "speakerId": 1000,
            "speakerName": "加尔恰",
            "text": "亲爱的路通，我们之前就讨论过这个问题了，你知道我的回答…而我也会始终尊重你的选择",
            "nextDialogs": [
              "230165006"
            ]
          },
          "230165006": {
            "id": "230165006",
            "speakerId": 1001,
            "speakerName": "路通",
            "text": "我们还是来讨论一下您下次和迦雅小姐共进晚餐的地点吧，先生。",
            "nextDialogs": [
              "230165007"
            ]
          },
          "230165007": {
            "id": "230165007",
            "speakerId": 1000,
            "speakerName": "加尔恰",
            "text": "谢谢你，路通。",
            "nextDialogs": [
              "230165008"
            ]
          },
          "230165008": {
            "id": "230165008",
            "speakerId": 1001,
            "speakerName": "路通",
            "text": "不客气，先生，我们俩签的合同还没结束呢。"
          }
        }
      }
    },
    {
      "subId": "2301651",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "230165101"
        ],
        "dialogs": {
          "230165101": {
            "id": "230165101",
            "speakerId": 1002,
            "speakerName": "阿汉格尔",
            "text": "还有什么事吗？",
            "nextDialogs": [
              "230165103",
              "230165106"
            ]
          },
          "230165103": {
            "id": "230165103",
            "speakerId": 1002,
            "speakerName": "阿汉格尔",
            "text": "有一段时间了吧，这家伙学习的热情比一些学徒都高。",
            "nextDialogs": [
              "230165104"
            ]
          },
          "230165104": {
            "id": "230165104",
            "speakerId": 1002,
            "speakerName": "阿汉格尔",
            "text": "但他这个样子，实在不像是想拿打铁这门手艺吃饭的人啊…"
          },
          "230165106": {
            "id": "230165106",
            "speakerId": 1002,
            "speakerName": "阿汉格尔",
            "text": "嗯…倒是有一个女人时不时地过来找他，还带着不少东西。",
            "nextDialogs": [
              "230165107"
            ]
          },
          "230165107": {
            "id": "230165107",
            "speakerId": 1002,
            "speakerName": "阿汉格尔",
            "text": "我听他说，这个女人叫迦雅…还是什么的。",
            "nextDialogs": [
              "230165108"
            ]
          },
          "230165108": {
            "id": "230165108",
            "speakerId": 1002,
            "speakerName": "阿汉格尔",
            "text": "这群看起来就和打铁不沾边的人，为什么会一直聚在我这铁匠铺里呢…"
          }
        }
      }
    },
    {
      "subId": "2301652",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "230165201"
        ],
        "dialogs": {
          "230165201": {
            "id": "230165201",
            "speakerId": 1002,
            "speakerName": "阿汉格尔",
            "text": "这家伙到底想要做什么东西…"
          }
        }
      }
    },
    {
      "subId": "2301699",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {

        ],
        "dialogs": {
          "402011501": {
            "id": "402011501",
            "speakerId": 1000,
            "speakerName": "夜兰",
            "text": "我会注意周边情况，阻止「诈狂」接近…",
            "nextDialogs": [
              "402011502"
            ]
          },
          "402011502": {
            "id": "402011502",
            "speakerId": 1000,
            "speakerName": "夜兰",
            "text": "当然，如果发现我在附近，对方必定不敢冒险。",
            "nextDialogs": [
              "402011503"
            ]
          },
          "402011503": {
            "id": "402011503",
            "speakerId": 1000,
            "speakerName": "夜兰",
            "text": "你就趁此机会，好好取证，仔细调查一番货物吧。"
          }
        }
      }

    "？？？": 2
  },
  "subQuests": [
    {
      "subId": "4121201",
      "subQuestName": "与阿贝多会合",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "412120101"
        ],
        "dialogs": {
          "412120101": {
            "id": "412120101",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "阿贝多！我们回来啦！",
            "nextDialogs": [
              "412120102"
            ]
          },
          "412120102": {
            "id": "412120102",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "哎呀，是有客人吗？",
            "nextDialogs": [
              "412120105"
            ]
          },
          "412120105": {
            "id": "412120105",
            "speakerId": 1409,
            "speakerName": "塞琉斯",
            "text": "让新人来雪山冒险，或许还是太心急了…",
            "nextDialogs": [
              "412120106"
            ]
          },
          "412120106": {
            "id": "412120106",
            "speakerId": 1409,
            "speakerName": "塞琉斯",
            "text": "可是，冒险不就是挑战自我极限吗？没有磨难、没有刺激的旅途还有什么意思！",
            "nextDialogs": [
              "412120107"
            ]
          },
          "412120107": {
            "id": "412120107",
            "speakerId": 1409,
            "speakerName": "塞琉斯",
            "text": "哪怕这一带到处都有凶恶的丘丘人土匪与淹没到膝盖的积雪，冒险家们也绝不能停下脚步。",
            "nextDialogs": [
              "412120108"
            ]
          },
          "412120108": {
            "id": "412120108",
            "speakerId": 1018,
            "speakerName": "阿贝多",
            "text": "塞琉斯，说重点。",
            "nextDialogs": [
              "412120109"
            ]
          },
          "412120109": {
            "id": "412120109",
            "speakerId": 1409,
            "speakerName": "塞琉斯",
            "text": "哈哈哈，瞧你说的！聊天就跟探险一样，重在过程，哪有什么重点！",
            "nextDialogs": [
              "412120110"
            ]
          },
          "412120110": {
            "id": "412120110",
            "speakerId": 1409,
            "speakerName": "塞琉斯",
            "text": "嗯！被打劫到放弃据点，在冰冷的雪堆里生火做饭！",
            "nextDialogs": [
              "412120111"
            ]
          },
          "412120111": {
            "id": "412120111",
            "speakerId": 1409,
            "speakerName": "塞琉斯",
            "text": "雪山之旅对冒险家协会各位新人来说，一定是永生难忘的经历，哈哈哈！",
            "nextDialogs": [
              "412120112"
            ]
          },
          "412120112": {
            "id": "412120112",
            "speakerId": 1018,
            "speakerName": "阿贝多",
            "text": "嗯，对。",
            "nextDialogs": [
              "412120113"
            ]
          },
          "412120113": {
            "id": "412120113",
            "speakerId": 1409,
            "speakerName": "塞琉斯",
            "text": "哪怕此刻他们在心中埋怨我、憎恨我，未来也会为这份回忆感谢我，这就是冒险的传承啊。",
            "nextDialogs": [
              "412120114"
            ]
          },
          "412120114": {
            "id": "412120114",
            "speakerId": 1018,
            "speakerName": "阿贝多",
            "text": "嗯，你接着说。",
            "nextDialogs": [
              "412120115"
            ]
          },
          "412120115": {
            "id": "412120115",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "呜哇…阿贝多老毛病又犯了，对不感兴趣的东西好冷淡呢…",
            "nextDialogs": [
              "412120116"
            ]
          },
          "412120116": {
            "id": "412120116",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "看来他对冒险家的兴趣实在不怎么大。",
            "nextDialogs": [
              "412120117"
            ]
          },
          "412120117": {
            "id": "412120117",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "是吗？我看他对你就很有兴趣啊。",
            "nextDialogs": [
              "412120118"
            ]
          },
          "412120118": {
            "id": "412120118",
            "speakerId": 1409,
            "speakerName": "塞琉斯",
            "text": "不过，该说是新人太弱，还是雪山太强呢？这次可真是损失惨重啊…",
            "nextDialogs": [
              "412120119"
            ]
          },
          "412120119": {
            "id": "412120119",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "为什么损失惨重？",
            "nextDialogs": [
              "412120120"
            ]
          },
          "412120120": {
            "id": "412120120",
            "speakerId": 1409,
            "speakerName": "塞琉斯",
            "text": "哦…！你是…！",
            "nextDialogs": [
              "412120121"
            ]
          },
          "412120121": {
            "id": "412120121",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "你好，塞琉斯先生。",
            "nextDialogs": [
              "412120122"
            ]
          },
          "412120122": {
            "id": "412120122",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "好久不见啦——！",
            "nextDialogs": [
              "412120123"
            ]
          },
          "412120123": {
            "id": "412120123",
            "speakerId": 1409,
            "speakerName": "塞琉斯",
            "text": "#啊~年轻的冒险家和{PLAYERAVATAR#SEXPRO[INFO_MALE_PRONOUN_HE|INFO_FEMALE_PRONOUN_SHE]}的好伙伴，真高兴在这里见到你们。",
            "nextDialogs": [
              "412120124"
            ]
          },
          "412120124": {
            "id": "412120124",
            "speakerId": 1409,
            "speakerName": "塞琉斯",
            "text": "希望这片严寒的山脉没有给你们造成太多麻烦。",
            "nextDialogs": [
              "412120125"
            ]
          },
          "412120125": {
            "id": "412120125",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "能应付的都不是麻烦！",
            "nextDialogs": [
              "412120126"
            ]
          },
          "412120126": {
            "id": "412120126",
            "speakerId": 1409,
            "speakerName": "塞琉斯",
            "text": "哈哈哈，没错！我喜欢你自信的发言！",
            "nextDialogs": [
              "412120127"
            ]
          },
          "412120127": {
            "id": "412120127",
            "speakerId": 1409,
            "speakerName": "塞琉斯",
            "text": "特意顶着风雪到这里来，是有不得不办的工作吗？",
            "nextDialogs": [
              "412120128"
            ]
          },
          "412120128": {
            "id": "412120128",
            "speakerId": 1018,
            "speakerName": "阿贝多",
            "text": "#我来这里采集丘丘人的最新数据，委托{PLAYERAVATAR#SEXPRO[INFO_MALE_PRONOUN_HE|INFO_FEMALE_PRONOUN_SHE]}做我的助手。"
          }
        }
      }
    },
    {
      "subId": "4121203",
      "subQuestName": "与阿贝多对话",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [],
        "dialogs": {}
      }
    },
    {
      "subId": "4121204",
      "subQuestName": "前往山腰",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "412120401"
        ],
        "dialogs": {
          "412120401": {
            "id": "412120401",
            "speakerId": 1018,
            "speakerName": "阿贝多",
            "text": "素描本上有画和笔记，一定要拿回来。"
          }
        }
      }
    },
    {
      "subId": "4121221",
      "subQuestName": "与阿贝多对话",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "412120301"
        ],
        "dialogs": {
          "412120301": {
            "id": "412120301",
            "speakerId": 1018,
            "speakerName": "阿贝多",
            "text": "嗯？似乎不在。",
            "nextDialogs": [
              "412120302"
            ]
          },
          "412120302": {
            "id": "412120302",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "怪物也会出去串门呀？",
            "nextDialogs": [
              "412120303"
            ]
          },
          "412120303": {
            "id": "412120303",
            "speakerId": 1018,
            "speakerName": "阿贝多",
            "text": "那么，在怪物出现之前，你想四处走走，还是休息一会儿？",
            "nextDialogs": [
              "412120305",
              "412120307"
            ]
          },
          "412120305": {
            "id": "412120305",
            "speakerId": 1018,
            "speakerName": "阿贝多",
            "text": "我也这么想。",
            "nextDialogs": [
              "412120309"
            ]
          },
          "412120309": {
            "id": "412120309",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "要聊天了吗？我也要听，给我留个位置！",
            "nextDialogs": [
              "412120310"
            ]
          },
          "412120310": {
            "id": "412120310",
            "speakerId": 1018,
            "speakerName": "阿贝多",
            "text": "我知道你对我、对这整件事都有不少问题。如先前所说，我会回答。",
            "nextDialogs": [
              "412120311"
            ]
          },
          "412120311": {
            "id": "412120311",
            "speakerId": 1018,
            "speakerName": "阿贝多",
            "text": "不过我也不打算欺骗你。有些还不能挑明的事，现阶段请容我略过。",
            "nextDialogs": [
              "412120312"
            ]
          },
          "412120312": {
            "id": "412120312",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "呜哇…意外地是个很坦率的人呢…"
          },
          "412120307": {
            "id": "412120307",
            "speakerId": 1018,
            "speakerName": "阿贝多",
            "text": "……",
            "nextDialogs": [
              "412120308"
            ]
          },
          "412120308": {
            "id": "412120308",
            "speakerId": 1018,
            "speakerName": "阿贝多",
            "text": "好吧，你想问什么？"
          }
        }
      }
    },
    {
      "subId": "4121207",
      "subQuestName": "击败来袭的丘丘人",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "412120701"
        ],
        "dialogs": {
          "412120701": {
            "id": "412120701",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "阿贝多，应急工作做得还顺利吗？",
            "nextDialogs": [
              "412120702"
            ]
          },
          "412120702": {
            "id": "412120702",
            "speakerId": 1018,
            "speakerName": "阿贝多",
            "text": "还行。有几页遭到破坏，但大部分完好无损。",
            "nextDialogs": [
              "412120703"
            ]
          },
          "412120703": {
            "id": "412120703",
            "speakerId": 1018,
            "speakerName": "阿贝多",
            "text": "雪山气温太低，尤其是那个山洞，附近的气温已经达到了极限…",
            "nextDialogs": [
              "412120704"
            ]
          },
          "412120704": {
            "id": "412120704",
            "speakerId": 1018,
            "speakerName": "阿贝多",
            "text": "何况丘丘人还把口水弄在了本子上。结冰的纸落在那样的低温里，真是不堪设想。",
            "nextDialogs": [
              "412120705"
            ]
          },
          "412120705": {
            "id": "412120705",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "结冰的纸那么脆，一碰就碎了吧？",
            "nextDialogs": [
              "412120706"
            ]
          },
          "412120706": {
            "id": "412120706",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "真亏你有办法把素描本救回来。",
            "nextDialogs": [
              "412120707"
            ]
          },
          "412120707": {
            "id": "412120707",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "不愧是炼金术士，心灵手巧呀。",
            "nextDialogs": [
              "412120708"
            ]
          },
          "412120708": {
            "id": "412120708",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "要是本子损坏严重的话，阿贝多一定会大发雷霆吧？",
            "nextDialogs": [
              "412120709"
            ]
          },
          "412120709": {
            "id": "412120709",
            "speakerId": 1018,
            "speakerName": "阿贝多",
            "text": "为什么你会这样想？",
            "nextDialogs": [
              "412120710"
            ]
          },
          "412120710": {
            "id": "412120710",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "因为你说过上面有很多图画和笔记。",
            "nextDialogs": [
              "412120711"
            ]
          },
          "412120711": {
            "id": "412120711",
            "speakerId": 1018,
            "speakerName": "阿贝多",
            "text": "确实如此，这本素描本一直被我带在身边。",
            "nextDialogs": [
              "412120712"
            ]
          },
          "412120712": {
            "id": "412120712",
            "speakerId": 1018,
            "speakerName": "阿贝多",
            "text": "不过，也不至于为这种事太过生气。",
            "nextDialogs": [
              "412120713"
            ]
          },
          "412120713": {
            "id": "412120713",
            "speakerId": 1018,
            "speakerName": "阿贝多",
            "text": "如果真的抢救不回来，重新画过就好。",
            "nextDialogs": [
              "412120714"
            ]
          },
          "412120714": {
            "id": "412120714",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "咦…这种时候倒很现实了…",
            "nextDialogs": [
              "412120717"
            ]
          },
          "412120717": {
            "id": "412120717",
            "speakerId": 1018,
            "speakerName": "阿贝多",
            "text": "是吗？",
            "nextDialogs": [
              "412120718"
            ]
          },
          "412120718": {
            "id": "412120718",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "不管怎么说，那都是你用心绘制的画。",
            "nextDialogs": [
              "412120719"
            ]
          },
          "412120719": {
            "id": "412120719",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "对呀对呀！",
            "nextDialogs": [
              "412120720"
            ]
          },
          "412120720": {
            "id": "412120720",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "画作承载的是记忆。",
            "nextDialogs": [
              "412120721"
            ]
          },
          "412120721": {
            "id": "412120721",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "是的！",
            "nextDialogs": [
              "412120722"
            ]
          },
          "412120722": {
            "id": "412120722",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "别轻易放弃与回忆有关的东西。",
            "nextDialogs": [
              "412120723"
            ]
          },
          "412120723": {
            "id": "412120723",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "#正是如此！哎呀，{NICKNAME}说得真不错，其实我想说的也是这些。",
            "nextDialogs": [
              "412120724"
            ]
          },
          "412120724": {
            "id": "412120724",
            "speakerId": 1018,
            "speakerName": "阿贝多",
            "text": "…也是。重画很麻烦，我不喜欢这样。",
            "nextDialogs": [
              "412120725"
            ]
          },
          "412120725": {
            "id": "412120725",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "我猜是因为阿贝多很天才吧？",
            "nextDialogs": [
              "412120726"
            ]
          },
          "412120726": {
            "id": "412120726",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "你看，你会那么多别人不会的技艺，懂得那么多别人不懂的道理！",
            "nextDialogs": [
              "412120727"
            ]
          },
          "412120727": {
            "id": "412120727",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "这样的人有时反而会忽略细节呢。难道说这就是聪明的弊端吗？",
            "nextDialogs": [
              "412120728"
            ]
          },
          "412120728": {
            "id": "412120728",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "阿贝多也说过派蒙聪明哦。",
            "nextDialogs": [
              "412120729"
            ]
          },
          "412120729": {
            "id": "412120729",
            "speakerId": 1018,
            "speakerName": "阿贝多",
            "text": "是的，派蒙是个很有趣的生物。"
          }
        }
      }
    },
    {
      "subId": "4121205",
      "subQuestName": "(test)丘丘人战斗开车$HIDDEN",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "412120501"
        ],
        "dialogs": {
          "412120501": {
            "id": "412120501",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "你们看到了吗？那只丘丘人抓着一本书一样的东西跑掉了！",
            "nextDialogs": [
              "412120502"
            ]
          },
          "412120502": {
            "id": "412120502",
            "speakerId": 1018,
            "speakerName": "阿贝多",
            "text": "麻烦了…是我的素描本。",
            "nextDialogs": [
              "412120505"
            ]
          },
          "412120505": {
            "id": "412120505",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "我倒觉得它只是个普通的小偷啦。",
            "nextDialogs": [
              "412120506"
            ]
          },
          "412120506": {
            "id": "412120506",
            "speakerId": 1018,
            "speakerName": "阿贝多",
            "text": "竟敢偷我的素描本，哼，胆子不小。",
            "nextDialogs": [
              "412120507"
            ]
          },
          "412120507": {
            "id": "412120507",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "阿贝多，以一种很平静的方式生气了呢…",
            "nextDialogs": [
              "412120508"
            ]
          },
          "412120508": {
            "id": "412120508",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "我会帮忙的！"
          }
        }
      }
    },

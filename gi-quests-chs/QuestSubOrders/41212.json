    {
      "subId": "4121209",
      "subQuestName": "跟随脚印追踪丘丘人",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "412120901"
        ],
        "dialogs": {
          "412120901": {
            "id": "412120901",
            "speakerId": 1018,
            "speakerName": "阿贝多",
            "text": "是怪物的营地。看来，赃物已经被它们带回老窝了。",
            "nextDialogs": [
              "412120902"
            ]
          },
          "412120902": {
            "id": "412120902",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "我们冲进去！",
            "nextDialogs": [
              "412120903"
            ]
          },
          "412120903": {
            "id": "412120903",
            "speakerId": 1018,
            "speakerName": "阿贝多",
            "text": "不，最好还是想办法把它们引出来。"
          }
        }
      }
    },
    {
      "subId": "4121202",
      "subQuestName": "到达山洞前$HIDDEN",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [],
        "dialogs": {}
      }
    },
    {
      "subId": "4121210",
      "subQuestName": "与阿贝多对话",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "412120601"
        ],
        "dialogs": {
          "412120601": {
            "id": "412120601",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "前面没有路了，只有一个很大的山洞入口。",
            "nextDialogs": [
              "412120602"
            ]
          },
          "412120602": {
            "id": "412120602",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "是跑进去了吗？",
            "nextDialogs": [
              "412120603"
            ]
          },
          "412120603": {
            "id": "412120603",
            "speakerId": 1018,
            "speakerName": "阿贝多",
            "text": "从脚印的情况来看，它跑进去了。",
            "nextDialogs": [
              "412120604"
            ]
          },
          "412120604": {
            "id": "412120604",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "那我们也跟上去吧！不要让它跑远了！",
            "nextDialogs": [
              "412120605"
            ]
          },
          "412120605": {
            "id": "412120605",
            "speakerId": 1018,
            "speakerName": "阿贝多",
            "text": "等等。",
            "nextDialogs": [
              "412120606"
            ]
          },
          "412120606": {
            "id": "412120606",
            "speakerId": 1018,
            "speakerName": "阿贝多",
            "text": "这座雪山体积惊人，山腹内就算有路，也不会是一马平川的那种。",
            "nextDialogs": [
              "412120607"
            ]
          },
          "412120607": {
            "id": "412120607",
            "speakerId": 1018,
            "speakerName": "阿贝多",
            "text": "……",
            "nextDialogs": [
              "412120608"
            ]
          },
          "412120608": {
            "id": "412120608",
            "speakerId": 1018,
            "speakerName": "阿贝多",
            "text": "感觉到了吗？带着冰原和山石气味的风…还有回声，里面的空间一定很大。",
            "nextDialogs": [
              "412120609"
            ]
          },
          "412120609": {
            "id": "412120609",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "还真是！",
            "nextDialogs": [
              "412120610"
            ]
          },
          "412120610": {
            "id": "412120610",
            "speakerId": 1018,
            "speakerName": "阿贝多",
            "text": "所以，轻举妄动对我们没有好处。",
            "nextDialogs": [
              "412120611"
            ]
          },
          "412120611": {
            "id": "412120611",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "可是…都已经追到这里了，总不能让它白白跑掉吧！",
            "nextDialogs": [
              "412120612"
            ]
          },
          "412120612": {
            "id": "412120612",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "那本素描本对你很重要吧？",
            "nextDialogs": [
              "412120613"
            ]
          },
          "412120613": {
            "id": "412120613",
            "speakerId": 1018,
            "speakerName": "阿贝多",
            "text": "很重要，但也不能莽撞行事。",
            "nextDialogs": [
              "412120614"
            ]
          },
          "412120614": {
            "id": "412120614",
            "speakerId": 1018,
            "speakerName": "阿贝多",
            "text": "还有另一条路，只是要费些功夫。",
            "nextDialogs": [
              "412120615"
            ]
          },
          "412120615": {
            "id": "412120615",
            "speakerId": 1018,
            "speakerName": "阿贝多",
            "text": "没猜错的话，这个山洞的出口在山体另一侧。",
            "nextDialogs": [
              "412120616"
            ]
          },
          "412120616": {
            "id": "412120616",
            "speakerId": 1018,
            "speakerName": "阿贝多",
            "text": "你很擅长飞行，我的技术也还不错。做好准备吧，我们一口气飞过去。"
          }
        }
      }
    },

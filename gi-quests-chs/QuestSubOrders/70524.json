          "705249902": {
            "id": "705249902",
            "speakerId": 10012,
            "speakerName": "奥兹",
            "text": "小姐，我一直都在。",
            "nextDialogs": [
              "705249903"
            ]
          },
          "705249903": {
            "id": "705249903",
            "speakerId": 10011,
            "speakerName": "菲谢尔",
            "text": "我是说「七圣召唤」里啦。",

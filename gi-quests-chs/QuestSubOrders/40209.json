{
  "lineCounts": {
    "Player": 2,
    "伊涅芙": 5,
    "派蒙": 4,
    "爱诺": 8,
    "雅珂达": 17
  },
  "subQuests": [
    {
      "subId": "4020901",
      "subQuestName": "(test)废弃",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "402090101"
        ],
        "dialogs": {
          "402090101": {
            "id": "402090101",
            "speakerId": 1000,
            "speakerName": "雅珂达",
            "text": "要是想做宣传的话，只要吆喝一声，会场第一层的客人一抬头就能看到这里。",
            "nextDialogs": [
              "402090102"
            ]
          },
          "402090102": {
            "id": "402090102",
            "speakerId": 1000,
            "speakerName": "雅珂达",
            "text": "从第一层到第二层来，这里是必经之处，那些逛展的客人多多少少都会来这里看一眼。",
            "nextDialogs": [
              "402090103"
            ]
          },
          "402090103": {
            "id": "402090103",
            "speakerId": 1000,
            "speakerName": "雅珂达",
            "text": "看吧，有了我推荐的这个展位，你们肯定生意兴隆！",
            "nextDialogs": [
              "402090104"
            ]
          },
          "402090104": {
            "id": "402090104",
            "speakerId": 1001,
            "speakerName": "爱诺",
            "text": "…所以呢？",
            "nextDialogs": [
              "402090105"
            ]
          },
          "402090105": {
            "id": "402090105",
            "speakerId": 1002,
            "speakerName": "伊涅芙",
            "text": "检索过往数据库，对比分析雅珂达的表情特征，得出结论——雅珂达希望我们能回馈她的好意。",
            "nextDialogs": [
              "402090106"
            ]
          },
          "402090106": {
            "id": "402090106",
            "speakerId": 1000,
            "speakerName": "雅珂达",
            "text": "（嗯，还是笨蛋机器人靠谱一些。）",
            "nextDialogs": [
              "402090107"
            ]
          },
          "402090107": {
            "id": "402090107",
            "speakerId": 1001,
            "speakerName": "爱诺",
            "text": "那该怎么回馈呢？",
            "nextDialogs": [
              "402090108"
            ]
          },
          "402090108": {
            "id": "402090108",
            "speakerId": 1002,
            "speakerName": "伊涅芙",
            "text": "方案拟定中…拟定完毕。雅珂达，你下一次来工坊分享甜点时，我会把靠近过道的位置留给你。",
            "nextDialogs": [
              "402090109"
            ]
          },
          "402090109": {
            "id": "402090109",
            "speakerId": 1000,
            "speakerName": "雅珂达",
            "text": "啊？",
            "nextDialogs": [
              "402090110"
            ]
          },
          "402090110": {
            "id": "402090110",
            "speakerId": 1002,
            "speakerName": "伊涅芙",
            "text": "在那个座位上，总是能首先接触到从厨房送来的甜点。那里不会被窗户的光线直射，也靠水壶更近一些。",
            "nextDialogs": [
              "402090111"
            ]
          },
          "402090111": {
            "id": "402090111",
            "speakerId": 1002,
            "speakerName": "伊涅芙",
            "text": "在我推荐的那个座位上，你享用甜点的过程肯定十分愉快。",
            "nextDialogs": [
              "402090112"
            ]
          },
          "402090112": {
            "id": "402090112",
            "speakerId": 1000,
            "speakerName": "雅珂达",
            "text": "…这两边是等价的吗？",
            "nextDialogs": [
              "402090113"
            ]
          },
          "402090113": {
            "id": "402090113",
            "speakerId": 1001,
            "speakerName": "爱诺",
            "text": "不然呢？那个位置一般是给我准备的，要不是为了赚「甜品资金」，我一次都不愿意让给你。",
            "nextDialogs": [
              "402090114"
            ]
          },
          "402090114": {
            "id": "402090114",
            "speakerId": 1003,
            "speakerName": "派蒙",
            "text": "怎么了？雅珂达看上去很苦恼。",
            "nextDialogs": [
              "402090115"
            ]
          },
          "402090115": {
            "id": "402090115",
            "speakerId": 1000,
            "speakerName": "雅珂达",
            "text": "我就直说吧，看在我帮你们抢到了好展位的份上，能不能给我提供一次技术支援？",
            "nextDialogs": [
              "402090116"
            ]
          },
          "402090116": {
            "id": "402090116",
            "speakerId": 1003,
            "speakerName": "派蒙",
            "text": "技术支援？",
            "nextDialogs": [
              "402090117"
            ]
          },
          "402090117": {
            "id": "402090117",
            "speakerId": 1000,
            "speakerName": "雅珂达",
            "text": "今年展会的规模比往年大了很多，可能出的乱子肯定也比往年大很多。",
            "nextDialogs": [
              "402090118"
            ]
          },
          "402090118": {
            "id": "402090118",
            "speakerId": 1000,
            "speakerName": "雅珂达",
            "text": "爱诺，你有没有那种一拿出手就可以震慑全场的机械造物？作为展会的管理者，我要有兜底的手段啊。",
            "nextDialogs": [
              "402090119"
            ]
          },
          "402090119": {
            "id": "402090119",
            "speakerId": 1001,
            "speakerName": "爱诺",
            "text": "震慑全场…",
            "nextDialogs": [
              "402090120"
            ]
          },
          "402090120": {
            "id": "402090120",
            "speakerId": 1003,
            "speakerName": "派蒙",
            "text": "真要出了那么大的问题，你不应该直接报告奈芙尔吗？",
            "nextDialogs": [
              "402090121"
            ]
          },
          "402090121": {
            "id": "402090121",
            "speakerId": 1000,
            "speakerName": "雅珂达",
            "text": "话是这么说，但是自己惹到的麻烦，最好还是用自己的人脉来解决…",
            "nextDialogs": [
              "402090122"
            ]
          },
          "402090122": {
            "id": "402090122",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "什么麻烦？",
            "nextDialogs": [
              "402090123"
            ]
          },
          "402090123": {
            "id": "402090123",
            "speakerId": 1000,
            "speakerName": "雅珂达",
            "text": "还记得那三个孩子吗？找他们麻烦的可不是普通的混混，对展会有意见的大有人在，他可能是被推出来专门找茬的。",
            "nextDialogs": [
              "402090124"
            ]
          },
          "402090124": {
            "id": "402090124",
            "speakerId": 1000,
            "speakerName": "雅珂达",
            "text": "当然，他们不敢直接招惹伏尼契商会，但是在展会之外对三个孩子使坏的事还是敢做的。",
            "nextDialogs": [
              "402090125"
            ]
          },
          "402090125": {
            "id": "402090125",
            "speakerId": 1000,
            "speakerName": "雅珂达",
            "text": "但是按照规定，我不该为展会之外的事负责，所以就很难对奈姐讲…",
            "nextDialogs": [
              "402090126"
            ]
          },
          "402090126": {
            "id": "402090126",
            "speakerId": 1000,
            "speakerName": "雅珂达",
            "text": "（虽然并不后悔，但雅珂达啊，你还真是会给自己找活干…）",
            "nextDialogs": [
              "402090127"
            ]
          },
          "402090127": {
            "id": "402090127",
            "speakerId": 1003,
            "speakerName": "派蒙",
            "text": "听上去确实有必要做一些准备…",
            "nextDialogs": [
              "402090128"
            ]
          },
          "402090128": {
            "id": "402090128",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "爱诺，可以帮帮雅珂达吗？",
            "nextDialogs": [
              "402090129"
            ]
          },
          "402090129": {
            "id": "402090129",
            "speakerId": 1001,
            "speakerName": "爱诺",
            "text": "好吧，我可以把「叮铃哐啷终极开关」借你用一次。",
            "nextDialogs": [
              "402090130"
            ]
          },
          "402090130": {
            "id": "402090130",
            "speakerId": 1002,
            "speakerName": "伊涅芙",
            "text": "嗯，确实只有它能满足「震慑全场」的需求。",
            "nextDialogs": [
              "402090131"
            ]
          },
          "402090131": {
            "id": "402090131",
            "speakerId": 1000,
            "speakerName": "雅珂达",
            "text": "「叮铃哐啷终极开关」？那是什么东西？",
            "nextDialogs": [
              "402090132"
            ]
          },
          "402090132": {
            "id": "402090132",
            "speakerId": 1001,
            "speakerName": "爱诺",
            "text": "喏，就是这个家伙。之前遇到过一次很棘手的情况，所以我就设计了它。",
            "nextDialogs": [
              "402090133"
            ]
          },
          "402090133": {
            "id": "402090133",
            "speakerId": 1001,
            "speakerName": "爱诺",
            "text": "你在它头上敲三下，就打开了「开关」。到时候，整个挪德卡莱几乎没有你处理不了的麻烦。",
            "nextDialogs": [
              "402090134"
            ]
          },
          "402090134": {
            "id": "402090134",
            "speakerId": 1000,
            "speakerName": "雅珂达",
            "text": "真的？打开「开关」后会发生什么呢？",
            "nextDialogs": [
              "402090135"
            ]
          },
          "402090135": {
            "id": "402090135",
            "speakerId": 1001,
            "speakerName": "爱诺",
            "text": "我只借你用一次，所以最好留到万不得已的时候。",
            "nextDialogs": [
              "402090136"
            ]
          },
          "402090136": {
            "id": "402090136",
            "speakerId": 1000,
            "speakerName": "雅珂达",
            "text": "好吧，我信你。"
          }
        }
      }
    }
  ]
}
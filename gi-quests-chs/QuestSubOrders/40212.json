  "subQuests": [
    {
      "subId": "4021201",
      "subQuestName": "与可莉对话",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "402280501"
        ],
        "dialogs": {
          "402280501": {
            "id": "402280501",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "可莉，玩具选好了吗？",
            "nextDialogs": [
              "402280502"
            ]
          },
          "402280502": {
            "id": "402280502",
            "speakerId": 10090,
            "speakerName": "可莉",
            "text": "嗯！妈妈给我做的魔法玩具，能跟嘟嘟可玩丢炸弹，可莉要分享给其他小魔女，一起丢炸弹！",
            "nextDialogs": [
              "402280503"
            ]
          },
          "402280503": {
            "id": "402280503",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "丢炸弹？！不行不行，太危险了可莉。",
            "nextDialogs": [
              "402280504"
            ]
          },
          "402280504": {
            "id": "402280504",
            "speakerId": 10090,
            "speakerName": "可莉",
            "text": "小派蒙放心，不危险。在这个魔法玩具里，蹦蹦炸弹不会爆炸，妈妈说可以随便玩，不会被关禁闭。",
            "nextDialogs": [
              "402280505"
            ]
          },
          "402280505": {
            "id": "402280505",
            "speakerId": 10090,
            "speakerName": "可莉",
            "text": "#荣誉骑士{M#哥哥}{F#姐姐}和小派蒙，你们也来玩吧，这次一起来稻妻玩的嘟嘟可也很想跟你们见面！",
            "nextDialogs": [
              "402280506"
            ]
          },
          "402280506": {
            "id": "402280506",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "欸…可莉不是一直带着嘟嘟可在身边吗？我们早就见过面了呀。",
            "nextDialogs": [
              "402280507"
            ]
          },
          "402280507": {
            "id": "402280507",
            "speakerId": 10090,
            "speakerName": "可莉",
            "text": "不一样哦。嘟嘟一族有很多嘟嘟可，有的跟可莉一样，喜欢在外面大冒险。",
            "nextDialogs": [
              "402280508"
            ]
          },
          "402280508": {
            "id": "402280508",
            "speakerId": 10090,
            "speakerName": "可莉",
            "text": "有的嘟嘟可平时住在另一个地方，还没跟你们见过面。",
            "nextDialogs": [
              "402280509"
            ]
          },
          "402280509": {
            "id": "402280509",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "另一个地方？",
            "nextDialogs": [
              "402280510"
            ]
          },
          "402280510": {
            "id": "402280510",
            "speakerId": 10090,
            "speakerName": "可莉",
            "text": "布伦妮姐姐在蒙德给我看过绘本，她说那里是小朋友们的幻想世界，嘟嘟可是可莉的幻想朋友。",
            "nextDialogs": [
              "402280511"
            ]
          },
          "402280511": {
            "id": "402280511",
            "speakerId": 10090,
            "speakerName": "可莉",
            "text": "但不管在哪，妈妈都能邀请嘟嘟可出来跟大家玩！像这次，嘟嘟可就被邀请到魔法玩具里。",
            "nextDialogs": [
              "402280512"
            ]
          },
          "402280512": {
            "id": "402280512",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "虽然之前已经见识过不少造型的嘟嘟可了，但还是觉得很神奇…",
            "nextDialogs": [
              "402280513"
            ]
          },
          "402280513": {
            "id": "402280513",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "魔法，很神奇吧。",
            "nextDialogs": [
              "402280514"
            ]
          },
          "402280514": {
            "id": "402280514",
            "speakerId": 10090,
            "speakerName": "可莉",
            "text": "#那荣誉骑士{M#哥哥}{F#姐姐}什么时候跟嘟嘟可玩丢炸弹？"
          }
        }
      }
    }
  ]
}
    {
      "subId": "2502904",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "250290401"
        ],
        "dialogs": {
          "250290401": {
            "id": "250290401",
            "speakerId": 1000,
            "speakerName": "特拉忒",
            "text": "#{M#大哥哥}{F#大姐姐}好厉害！我都没能看清你爬上去的动作…但是你爬山的速度，比马伊塔还要快！",
            "nextDialogs": [
              "250290405",
              "250290404"
            ]
          },
          "250290405": {
            "id": "250290405",
            "speakerId": 1000,
            "speakerName": "特拉忒",
            "text": "但是，这么短的登山时间…奇卡应该暂时没法做到啦…",
            "nextDialogs": [
              "250290406"
            ]
          },
          "250290406": {
            "id": "250290406",
            "speakerId": 1001,
            "speakerName": "奇卡",
            "text": "呜，呜呜…",
            "nextDialogs": [
              "250290407"
            ]
          },
          "250290407": {
            "id": "250290407",
            "speakerId": 1000,
            "speakerName": "特拉忒",
            "text": "#没关系，我等下拿着{M#大哥哥}{F#大姐姐}的爬山时间去找马伊塔。说不定，他能帮我制订一个…合理的训练计划。",
            "nextDialogs": [
              "250290408"
            ]
          },
          "250290408": {
            "id": "250290408",
            "speakerId": 1000,
            "speakerName": "特拉忒",
            "text": "#{M#大哥哥}{F#大姐姐}，谢谢你帮忙，这些「苦种」给你。",
            "nextDialogs": [
              "250290409"
            ]
          },
          "250290409": {
            "id": "250290409",
            "speakerId": 1000,
            "speakerName": "特拉忒",
            "text": "这是我们刚摘下来的，可新鲜了，做成巧克力一定好吃！",
            "nextDialogs": [
              "250290410"
            ]
          },
          "250290410": {
            "id": "250290410",
            "speakerId": 1001,
            "speakerName": "奇卡",
            "text": "呜呜，呜呜！",
            "nextDialogs": [
              "250290411"
            ]
          },
          "250290411": {
            "id": "250290411",
            "speakerId": 1000,
            "speakerName": "特拉忒",
            "text": "那我们就出发吧，不知道马伊塔在不在部族里。他不会又出去攀岩了吧…"
          },
          "250290404": {
            "id": "250290404",
            "speakerId": 1000,
            "speakerName": "特拉忒",
            "text": "他是我的朋友，特别擅长攀岩。除了洛娅姐姐之外，几乎没人能在攀岩这个项目里胜过他。"
          }
        }
      }
    },
    {
      "subId": "2502905",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "250290501"
        ],
        "dialogs": {
          "250290501": {
            "id": "250290501",
            "speakerId": 1000,
            "speakerName": "特拉忒",
            "text": "#嘿嘿，那就拜托{M#大哥哥}{F#大姐姐}啦，我们会在底下算好时间的。",
            "nextDialogs": [
              "250290502"
            ]
          },
          "250290502": {
            "id": "250290502",
            "speakerId": 1001,
            "speakerName": "奇卡",
            "text": "呜，呜？呜呜…"
          }
        }
      }
    },
    {
      "subId": "2502907",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "250290701"
        ],
        "dialogs": {
          "250290701": {
            "id": "250290701",
            "speakerId": 1001,
            "speakerName": "奇卡",
            "text": "山，高高，好累…"
          }
        }
      }
    },
    {
      "subId": "2502908",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "250290801"
        ],
        "dialogs": {
          "250290801": {
            "id": "250290801",
            "speakerId": 1000,
            "speakerName": "特拉忒",
            "text": "#那就拜托你啦，{M#大哥哥}{F#大姐姐}。我们会在地上仔细看着你的动作，算好时间的。"
          }
        }
      }

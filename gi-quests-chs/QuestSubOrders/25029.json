  "subQuests": [
    {
      "subId": "2502901",
      "subQuestName": "与特拉忒对话",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "250290101"
        ],
        "dialogs": {
          "250290101": {
            "id": "250290101",
            "speakerId": 1000,
            "speakerName": "特拉忒",
            "text": "乖乖喔，不要灰心，只要你身体好了，然后…加油学习！一定能很快爬到山顶的！",
            "nextDialogs": [
              "250290102"
            ]
          },
          "250290102": {
            "id": "250290102",
            "speakerId": 1001,
            "speakerName": "奇卡",
            "text": "呜呜…呜…",
            "nextDialogs": [
              "250290103"
            ]
          },
          "250290103": {
            "id": "250290103",
            "speakerId": 1000,
            "speakerName": "特拉忒",
            "text": "你是不是肚子饿了？嗯…那我去给你拿点吃的喔。",
            "nextDialogs": [
              "250290104"
            ]
          },
          "250290104": {
            "id": "250290104",
            "speakerId": 1001,
            "speakerName": "奇卡",
            "text": "呜…呜…",
            "nextDialogs": [
              "250290105"
            ]
          },
          "250290105": {
            "id": "250290105",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "你在做什么呢？",
            "nextDialogs": [
              "250290106"
            ]
          },
          "250290106": {
            "id": "250290106",
            "speakerId": 1000,
            "speakerName": "特拉忒",
            "text": "我在陪我的伙伴奇卡玩呢。虽然它还很小，但我妈妈说，它长大后，肯定会和其他匿叶龙一样厉害！",
            "nextDialogs": [
              "250290107"
            ]
          },
          "250290107": {
            "id": "250290107",
            "speakerId": 1001,
            "speakerName": "奇卡",
            "text": "呜…呜呜…",
            "nextDialogs": [
              "250290108"
            ]
          },
          "250290108": {
            "id": "250290108",
            "speakerId": 1000,
            "speakerName": "特拉忒",
            "text": "别难过啦。你只是身子太弱了，之前还受过伤。",
            "nextDialogs": [
              "250290109"
            ]
          },
          "250290109": {
            "id": "250290109",
            "speakerId": 1000,
            "speakerName": "特拉忒",
            "text": "妈妈说，只要你多吃好吃的，然后和我一起多多锻炼，肯定会好起来的。",
            "nextDialogs": [
              "250290110"
            ]
          },
          "250290110": {
            "id": "250290110",
            "speakerId": 1001,
            "speakerName": "奇卡",
            "text": "呜？呜呜…",
            "nextDialogs": [
              "250290112",
              "250290114"
            ]
          },
          "250290112": {
            "id": "250290112",
            "speakerId": 1001,
            "speakerName": "奇卡",
            "text": "呜呜…呜…",
            "nextDialogs": [
              "250290119"
            ]
          },
          "250290119": {
            "id": "250290119",
            "speakerId": 1000,
            "speakerName": "特拉忒",
            "text": "哎呀，说了这么多话，马上就要锻炼了，先吃点东西好了。",
            "nextDialogs": [
              "250290120"
            ]
          },
          "250290120": {
            "id": "250290120",
            "speakerId": 1000,
            "speakerName": "特拉忒",
            "text": "这可是我妈妈特制的果干，先在大锅里炒啊炒，然后加入很多香香的调料…",
            "nextDialogs": [
              "250290121"
            ]
          },
          "250290121": {
            "id": "250290121",
            "speakerId": 1000,
            "speakerName": "特拉忒",
            "text": "而且还要加好多糖和花瓣…总之，味道可好了！我这就给你欸？…",
            "nextDialogs": [
              "250290122"
            ]
          },
          "250290122": {
            "id": "250290122",
            "speakerId": 1000,
            "speakerName": "特拉忒",
            "text": "我的果干呢？明明放在包里的…",
            "nextDialogs": [
              "250290123"
            ]
          },
          "250290123": {
            "id": "250290123",
            "speakerId": 1001,
            "speakerName": "奇卡",
            "text": "…呜，呜…",
            "nextDialogs": [
              "250290124"
            ]
          },
          "250290124": {
            "id": "250290124",
            "speakerId": 1000,
            "speakerName": "特拉忒",
            "text": "呜哇！奇卡！难道都被你偷吃了？都说了不要馋嘴，吃多了就跑不动啦！",
            "nextDialogs": [
              "250290125"
            ]
          },
          "250290125": {
            "id": "250290125",
            "speakerId": 1001,
            "speakerName": "奇卡",
            "text": "唔唔，呜…"
          },
          "250290114": {
            "id": "250290114",
            "speakerId": 1000,
            "speakerName": "特拉忒",
            "text": "我不知道…也许妈妈知道！但妈妈把奇卡带回来的时候，它就生着病呢。",
            "nextDialogs": [
              "250290115"
            ]
          },
          "250290115": {
            "id": "250290115",
            "speakerId": 1000,
            "speakerName": "特拉忒",
            "text": "奇卡吃不下东西，也没力气动。我只能每天把药化在水里，然后喂它喝下去。",
            "nextDialogs": [
              "250290116"
            ]
          },
          "250290116": {
            "id": "250290116",
            "speakerId": 1000,
            "speakerName": "特拉忒",
            "text": "虽然奇卡最后病好了，但是…它的身体很弱。没办法像其他的匿叶龙一样，在悬崖旁边窜来窜去。",
            "nextDialogs": [
              "250290117"
            ]
          },
          "250290117": {
            "id": "250290117",
            "speakerId": 1000,
            "speakerName": "特拉忒",
            "text": "它因为这件事一直很难过，所以我想要帮它！让它恢复健康，然后…变得比其他匿叶龙还要强！",
            "nextDialogs": [
              "250290118"
            ]
          },
          "250290118": {
            "id": "250290118",
            "speakerId": 1001,
            "speakerName": "奇卡",
            "text": "呜！"
          }
        }
      }
    },
    {
      "subId": "2502902",
      "subQuestName": "爬上山顶",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "250290201"
        ],
        "dialogs": {
          "250290201": {
            "id": "250290201",
            "speakerId": 1000,
            "speakerName": "特拉忒",
            "text": "乖乖喔，今天吃饱了吗？有没有力气训练呀？",
            "nextDialogs": [
              "250290202"
            ]
          },
          "250290202": {
            "id": "250290202",
            "speakerId": 1001,
            "speakerName": "奇卡",
            "text": "呜，呜呜，呜！",
            "nextDialogs": [
              "250290203"
            ]
          },
          "250290203": {
            "id": "250290203",
            "speakerId": 1000,
            "speakerName": "特拉忒",
            "text": "呜哇，这么有活力？好！那今天可要加把劲了！",
            "nextDialogs": [
              "250290204"
            ]
          },
          "250290204": {
            "id": "250290204",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "一起加把劲吧！",
            "nextDialogs": [
              "250290206"
            ]
          },
          "250290206": {
            "id": "250290206",
            "speakerId": 1000,
            "speakerName": "特拉忒",
            "text": "#欸？您好呀，{M#大哥哥}{F#大姐姐}！我们正在进行爬山训练呢。",
            "nextDialogs": [
              "250290207"
            ]
          },
          "250290207": {
            "id": "250290207",
            "speakerId": 1001,
            "speakerName": "奇卡",
            "text": "呜呜！呜呜！",
            "nextDialogs": [
              "250290208"
            ]
          },
          "250290208": {
            "id": "250290208",
            "speakerId": 1001,
            "speakerName": "奇卡",
            "text": "呜呜，呜…",
            "nextDialogs": [
              "250290210",
              "250290213"
            ]
          },
          "250290210": {
            "id": "250290210",
            "speakerId": 1000,
            "speakerName": "特拉忒",
            "text": "那个…至少能说「有进步」吧。这次奇卡爬的比上次高多了。",
            "nextDialogs": [
              "250290211"
            ]
          },
          "250290211": {
            "id": "250290211",
            "speakerId": 1000,
            "speakerName": "特拉忒",
            "text": "就是在爬山的时候，奇卡的动作有些不熟练…",
            "nextDialogs": [
              "250290216"
            ]
          },
          "250290216": {
            "id": "250290216",
            "speakerId": 1000,
            "speakerName": "特拉忒",
            "text": "#{M#大哥哥}{F#大姐姐}，你能再为我们示范一遍吗？"
          },
          "250290213": {
            "id": "250290213",
            "speakerId": 1000,
            "speakerName": "特拉忒",
            "text": "当然啦。妈妈都说，我可擅长照料奇卡了。",
            "nextDialogs": [
              "250290214"
            ]
          },
          "250290214": {
            "id": "250290214",
            "speakerId": 1000,
            "speakerName": "特拉忒",
            "text": "奇卡的进步可大了，爬的高度也比上次高很多。",
            "nextDialogs": [
              "250290215"
            ]
          },
          "250290215": {
            "id": "250290215",
            "speakerId": 1000,
            "speakerName": "特拉忒",
            "text": "就是在爬山的时候，奇卡的动作有些不熟练…"
          }
        }
      }
    },
    {
      "subId": "2502903",
      "subQuestName": "(test)隐藏任务用于判断是达成时限要求$HIDDEN",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "250290301"
        ],
        "dialogs": {
          "250290301": {
            "id": "250290301",
            "speakerId": 1000,
            "speakerName": "特拉忒",
            "text": "#{M#大哥哥}{F#大姐姐}好厉害！爬得和马伊塔一样快！",
            "nextDialogs": [
              "250290303",
              "250290305"
            ]
          },
          "250290303": {
            "id": "250290303",
            "speakerId": 1000,
            "speakerName": "特拉忒",
            "text": "#失误？难道{M#大哥哥}{F#大姐姐}还能爬得更快？这就是超厉害冒险家的实力吗…",
            "nextDialogs": [
              "250290306"
            ]
          },
          "250290306": {
            "id": "250290306",
            "speakerId": 1000,
            "speakerName": "特拉忒",
            "text": "把这个爬山时间作为目标的话…嗯…",
            "nextDialogs": [
              "250290307"
            ]
          },
          "250290307": {
            "id": "250290307",
            "speakerId": 1001,
            "speakerName": "奇卡",
            "text": "呜，呜呜…",
            "nextDialogs": [
              "250290308"
            ]
          },
          "250290308": {
            "id": "250290308",
            "speakerId": 1000,
            "speakerName": "特拉忒",
            "text": "…哈哈，好像还是有些难为你了呢。",
            "nextDialogs": [
              "250290309"
            ]
          },
          "250290309": {
            "id": "250290309",
            "speakerId": 1000,
            "speakerName": "特拉忒",
            "text": "#没关系，我等下拿着{M#大哥哥}{F#大姐姐}的爬山时间去找马伊塔。说不定，他能帮我制订一个…合理的训练计划。",
            "nextDialogs": [
              "250290310"
            ]
          },
          "250290310": {
            "id": "250290310",
            "speakerId": 1000,
            "speakerName": "特拉忒",
            "text": "#{M#大哥哥}{F#大姐姐}，谢谢你帮忙，这枚「苦种」给你。",
            "nextDialogs": [
              "250290311"
            ]
          },
          "250290311": {
            "id": "250290311",
            "speakerId": 1000,
            "speakerName": "特拉忒",
            "text": "这是我们刚摘下来的，可新鲜了，做成巧克力一定好吃！",
            "nextDialogs": [
              "250290312"
            ]
          },
          "250290312": {
            "id": "250290312",
            "speakerId": 1001,
            "speakerName": "奇卡",
            "text": "呜呜，呜呜！",
            "nextDialogs": [
              "250290313"
            ]
          },
          "250290313": {
            "id": "250290313",
            "speakerId": 1000,
            "speakerName": "特拉忒",
            "text": "那我们就出发吧，不知道马伊塔在不在部族里。他不会又出去攀岩了吧…"
          },
          "250290305": {
            "id": "250290305",
            "speakerId": 1000,
            "speakerName": "特拉忒",
            "text": "他是我的朋友，特别擅长攀岩。除了洛娅姐姐之外，几乎没人能在攀岩这个项目里胜过他。"
          }
        }
      }
    },

            ]
          },
          "760369903": {
            "id": "760369903",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "欸？她看起来好不开心的样子！",
            "nextDialogs": [
              "760369904"
            ]
          },
          "760369904": {
            "id": "760369904",
            "speakerId": 1318,
            "speakerName": "「少女」",
            "text": "是这个吗？",
            "nextDialogs": [
              "760369905"
            ]
          },
          "760369905": {
            "id": "760369905",
            "speakerId": 1318,
            "speakerName": "「少女」",
            "text": "也不是这个？",
            "nextDialogs": [
              "760369906"
            ]
          },
          "760369906": {
            "id": "760369906",
            "speakerId": 1318,
            "speakerName": "「少女」",
            "text": "这个呢？"
          }
        }
      }

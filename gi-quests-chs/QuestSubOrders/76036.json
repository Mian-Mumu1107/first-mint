  "subQuests": [
    {
      "subId": "7603601",
      "subQuestName": "同「少女」见面",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "760360101"
        ],
        "dialogs": {
          "760360101": {
            "id": "760360101",
            "speakerId": 1318,
            "speakerName": "「少女」",
            "text": "不是这个蓝色吗？",
            "nextDialogs": [
              "760360102"
            ]
          },
          "760360102": {
            "id": "760360102",
            "speakerId": 15703,
            "speakerName": "月灵",
            "text": "……",
            "nextDialogs": [
              "760360105"
            ]
          },
          "760360105": {
            "id": "760360105",
            "speakerId": 1318,
            "speakerName": "「少女」",
            "text": "嗯？是你们。",
            "nextDialogs": [
              "760360106"
            ]
          },
          "760360106": {
            "id": "760360106",
            "speakerId": 1318,
            "speakerName": "「少女」",
            "text": "帮帮我好吗？之后会给你们好处的。",
            "nextDialogs": [
              "760360107"
            ]
          },
          "760360107": {
            "id": "760360107",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "呃…你什么时候才能改掉这个习惯啦…"
          }
        }
      }
    },
    {
      "subId": "7603602",
      "subQuestName": "将一些色彩丰富的东西交给月灵",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "760360201"
        ],
        "dialogs": {
          "760360201": {
            "id": "760360201",
            "speakerId": 15703,
            "speakerName": "月灵",
            "text": "！！",
            "nextDialogs": [
              "760360202"
            ]
          },
          "760360202": {
            "id": "760360202",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "别急哦，我们找找，最好是挪德卡莱颜色丰富的植物，对吧？"
          }
        }
      }
    },
    {
      "subId": "7603603",
      "subQuestName": "同月灵对话",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "760360301"
        ],
        "dialogs": {
          "760360301": {
            "id": "760360301",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "这些就够了吧？",
            "nextDialogs": [
              "760360302"
            ]
          },
          "760360302": {
            "id": "760360302",
            "speakerId": 1318,
            "speakerName": "「少女」",
            "text": "嗯，它看起来很满意。",
            "nextDialogs": [
              "760360303"
            ]
          },
          "760360303": {
            "id": "760360303",
            "speakerId": 15603,
            "speakerName": "梅拉",
            "text": "~！",
            "nextDialogs": [
              "760360304"
            ]
          },
          "760360304": {
            "id": "760360304",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "我以前都不知道月灵还会画画呢。",
            "nextDialogs": [
              "760360305"
            ]
          },
          "760360305": {
            "id": "760360305",
            "speakerId": 1318,
            "speakerName": "「少女」",
            "text": "它们其实和我们一样，有着各自的性格和爱好。",
            "nextDialogs": [
              "760360306"
            ]
          },
          "760360306": {
            "id": "760360306",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "欸？难道说挪德卡莱的每一只月灵你都认识？",
            "nextDialogs": [
              "760360307"
            ]
          },
          "760360307": {
            "id": "760360307",
            "speakerId": 1318,
            "speakerName": "「少女」",
            "text": "嗯，只要见过的话就认识。",
            "nextDialogs": [
              "760360308"
            ]
          },
          "760360308": {
            "id": "760360308",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "这么厉害？！在我看来除了努昂诺塔有些特殊之外，其他月灵几乎都长一个样…",
            "nextDialogs": [
              "760360309"
            ]
          },
          "760360309": {
            "id": "760360309",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "那这只会画画的小家伙叫什么名字呀？",
            "nextDialogs": [
              "760360310"
            ]
          },
          "760360310": {
            "id": "760360310",
            "speakerId": 1318,
            "speakerName": "「少女」",
            "text": "名字…？",
            "nextDialogs": [
              "760360311"
            ]
          },
          "760360311": {
            "id": "760360311",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "你该不会没给它们取名字吧…",
            "nextDialogs": [
              "760360312"
            ]
          },
          "760360312": {
            "id": "760360312",
            "speakerId": 1318,
            "speakerName": "「少女」",
            "text": "我认识它们，它们也认识我，不需要名字…我也没有名字呀。",
            "nextDialogs": [
              "760360313"
            ]
          },
          "760360313": {
            "id": "760360313",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "不要把不好的传统延续下去呀！",
            "nextDialogs": [
              "760360314"
            ]
          },
          "760360314": {
            "id": "760360314",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "呃…那，那我想想…「努昂诺塔」意思是月神赐福下诞生的生灵…",
            "nextDialogs": [
              "760360315"
            ]
          },
          "760360315": {
            "id": "760360315",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "那「画」在「霜月之子」的语言里是怎么说的？",
            "nextDialogs": [
              "760360316"
            ]
          },
          "760360316": {
            "id": "760360316",
            "speakerId": 1318,
            "speakerName": "「少女」",
            "text": "好像是…梅…娜？梅拉？是梅拉。",
            "nextDialogs": [
              "760360317"
            ]
          },
          "760360317": {
            "id": "760360317",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "听着还不错，那就叫它「梅拉」好了！",
            "nextDialogs": [
              "760360318"
            ]
          },
          "760360318": {
            "id": "760360318",
            "speakerId": 15603,
            "speakerName": "梅拉",
            "text": "？？",
            "nextDialogs": [
              "760360319"
            ]
          },
          "760360319": {
            "id": "760360319",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "怎么样，梅拉，你画好了吗？",
            "nextDialogs": [
              "760360320"
            ]
          },
          "760360320": {
            "id": "760360320",
            "speakerId": 15603,
            "speakerName": "梅拉",
            "text": "！！",
            "nextDialogs": [
              "760360321"
            ]
          },
          "760360321": {
            "id": "760360321",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "哦！我看看我看看…这！这…！",
            "nextDialogs": [
              "760360322"
            ]
          },
          "760360322": {
            "id": "760360322",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "怎么了？",
            "nextDialogs": [
              "760360323"
            ]
          },
          "760360323": {
            "id": "760360323",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "这画得也太好了！",
            "nextDialogs": [
              "760360324"
            ]
          },
          "760360324": {
            "id": "760360324",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "我还以为画得会比较孩子气…或者…像美露莘那样…",
            "nextDialogs": [
              "760360325"
            ]
          },
          "760360325": {
            "id": "760360325",
            "speakerId": 1318,
            "speakerName": "「少女」",
            "text": "月灵很擅长感知周围的环境，在临摹所见之物的时候，倾向于将自己的感受原封不动地记录下来。",
            "nextDialogs": [
              "760360326"
            ]
          },
          "760360326": {
            "id": "760360326",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "梅拉画的是…哥伦比娅？",
            "nextDialogs": [
              "760360327"
            ]
          },
          "760360327": {
            "id": "760360327",
            "speakerId": 15603,
            "speakerName": "梅拉",
            "text": "！！",
            "nextDialogs": [
              "760360328"
            ]
          },
          "760360328": {
            "id": "760360328",
            "speakerId": 1318,
            "speakerName": "「少女」",
            "text": "嗯？",
            "nextDialogs": [
              "760360329"
            ]
          },
          "760360329": {
            "id": "760360329",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "…看起来像是哥伦比娅刚诞生时的样子。",
            "nextDialogs": [
              "760360330"
            ]
          },
          "760360330": {
            "id": "760360330",
            "speakerId": 1318,
            "speakerName": "「少女」",
            "text": "欸？",
            "nextDialogs": [
              "760360331"
            ]
          },
          "760360331": {
            "id": "760360331",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "我记得菈乌玛也说过，你诞生的时候被「霜月之子」记录了下来，不过和这幅画似乎有些区别。",
            "nextDialogs": [
              "760360334"
            ]
          },
          "760360334": {
            "id": "760360334",
            "speakerId": 1318,
            "speakerName": "「少女」",
            "text": "这孩子…梅拉，是最初诞生的月灵之一。它或许是结合自己的感知，想象了当时的画面吧。",
            "nextDialogs": [
              "760360335"
            ]
          },
          "760360335": {
            "id": "760360335",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "哦！这么看来，梅拉在很努力地为我们介绍自己的神明呢。",
            "nextDialogs": [
              "760360336"
            ]
          },
          "760360336": {
            "id": "760360336",
            "speakerId": 15603,
            "speakerName": "梅拉",
            "text": "~！",
            "nextDialogs": [
              "760360337"
            ]
          },
          "760360337": {
            "id": "760360337",
            "speakerId": 1318,
            "speakerName": "「少女」",
            "text": "……",
            "nextDialogs": [
              "760360338"
            ]
          },
          "760360338": {
            "id": "760360338",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "放心吧，我们会和哥伦比娅好好相处的。",
            "nextDialogs": [
              "760360339"
            ]
          },
          "760360339": {
            "id": "760360339",
            "speakerId": 15603,
            "speakerName": "梅拉",
            "text": "！！",
            "nextDialogs": [
              "760360340"
            ]
          },
          "760360340": {
            "id": "760360340",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "咦？这么快又画好一张？",
            "nextDialogs": [
              "760360341"
            ]
          },
          "760360341": {
            "id": "760360341",
            "speakerId": 1318,
            "speakerName": "「少女」",
            "text": "……？",
            "nextDialogs": [
              "760360342"
            ]
          },
          "760360342": {
            "id": "760360342",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "这画的是…「霜月之子」将哥伦比娅奉为神明时候的事吧。",
            "nextDialogs": [
              "760360343"
            ]
          },
          "760360343": {
            "id": "760360343",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "嗯？哥伦比娅在祭坛那边干什么呢？画得太小了有些看不清。",
            "nextDialogs": [
              "760360344"
            ]
          },
          "760360344": {
            "id": "760360344",
            "speakerId": 15603,
            "speakerName": "梅拉",
            "text": "~！",
            "nextDialogs": [
              "760360345"
            ]
          },
          "760360345": {
            "id": "760360345",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "原来是在吃贡品吗！",
            "nextDialogs": [
              "760360346"
            ]
          },
          "760360346": {
            "id": "760360346",
            "speakerId": 1318,
            "speakerName": "「少女」",
            "text": "…不能吃吗？",
            "nextDialogs": [
              "760360347"
            ]
          },
          "760360347": {
            "id": "760360347",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "倒也不是说不能吃吧，只是…有些意外。",
            "nextDialogs": [
              "760360348"
            ]
          },
          "760360348": {
            "id": "760360348",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "看你吃得很开心…",
            "nextDialogs": [
              "760360349"
            ]
          },
          "760360349": {
            "id": "760360349",
            "speakerId": 1318,
            "speakerName": "「少女」",
            "text": "因为…好吃嘛…",
            "nextDialogs": [
              "760360350"
            ]
          },
          "760360350": {
            "id": "760360350",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "也是…",
            "nextDialogs": [
              "760360351"
            ]
          },
          "760360351": {
            "id": "760360351",
            "speakerId": 15603,
            "speakerName": "梅拉",
            "text": "~！",
            "nextDialogs": [
              "760360352"
            ]
          },
          "760360352": {
            "id": "760360352",
            "speakerId": 1318,
            "speakerName": "「少女」",
            "text": "好，知道了。",
            "nextDialogs": [
              "760360353"
            ]
          },
          "760360353": {
            "id": "760360353",
            "speakerId": 1318,
            "speakerName": "「少女」",
            "text": "手给我。"
          }
        }
      }
    },
    {

      "subId": "7069401",
      "subQuestName": "与「邦邦滚石」对话",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "706940101"
        ],
        "dialogs": {
          "706940101": {
            "id": "706940101",
            "speakerId": 1035,
            "speakerName": "宵宫",
            "text": "邦邦小姐，腰还疼吗？",
            "nextDialogs": [
              "706940102"
            ]
          },
          "706940102": {
            "id": "706940102",
            "speakerId": 30896,
            "speakerName": "「邦邦滚石」",
            "text": "目前没事了…热敷当真见效快！",
            "nextDialogs": [
              "706940103"
            ]
          },
          "706940103": {
            "id": "706940103",
            "speakerId": 1035,
            "speakerName": "宵宫",
            "text": "嘿嘿，用慢速火药加热湿绷带的方法，可得把握好时间哦，不然就会把绷带点燃。",
            "nextDialogs": [
              "706940104"
            ]
          },
          "706940104": {
            "id": "706940104",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "这种加热绷带的方法，可能只有宵宫才能想到了！",
            "nextDialogs": [
              "706940105"
            ]
          },
          "706940105": {
            "id": "706940105",
            "speakerId": 30896,
            "speakerName": "「邦邦滚石」",
            "text": "#等等…看看这是谁来了！名副其实的大英雄，和{M#他}{F#她}的白色伙伴！",
            "nextDialogs": [
              "706940106"
            ]
          },
          "706940106": {
            "id": "706940106",
            "speakerId": 30896,
            "speakerName": "「邦邦滚石」",
            "text": "漫画织卷里的场景，要在我眼前上演了吗？",
            "nextDialogs": [
              "706940109"
            ]
          },
          "706940109": {
            "id": "706940109",
            "speakerId": 30896,
            "speakerName": "「邦邦滚石」",
            "text": "不打紧！只不过是在野外转悠，找了些以前没怎么见过的强敌练手！",
            "nextDialogs": [
              "706940110"
            ]
          },
          "706940110": {
            "id": "706940110",
            "speakerId": 30896,
            "speakerName": "「邦邦滚石」",
            "text": "宵宫小姐才是，我不小心扭到腰咕噜噜摔成雪球滚下来的时候，帮了我大忙！",
            "nextDialogs": [
              "706940111"
            ]
          },
          "706940111": {
            "id": "706940111",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "哇啊…听着就疼…",
            "nextDialogs": [
              "706940112"
            ]
          },
          "706940112": {
            "id": "706940112",
            "speakerId": 1035,
            "speakerName": "宵宫",
            "text": "哈哈，按照《炽魂斗士战记》的说法，「我只是一个路过的战士罢了」…",
            "nextDialogs": [
              "706940113"
            ]
          },
          "706940113": {
            "id": "706940113",
            "speakerId": 1035,
            "speakerName": "宵宫",
            "text": "而且是自由的雇佣战士！骑士团已经给我行动许可了，可以自行击退魔物。"
          }
        }
      }
    }
  ]
}
    {
      "subId": "1020002",
      "subQuestName": "(test)派蒙巴顿开车$HIDDEN",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "102000201"
        ],
        "dialogs": {
          "102000201": {
            "id": "102000201",
            "speakerId": 1001,
            "speakerName": "巴顿",
            "text": "唉，只能从窗外听到大家的讨论，连发言的机会都没有，好想参加他们的话题啊…",
            "nextDialogs": [
              "102000202"
            ]
          },
          "102000202": {
            "id": "102000202",
            "speakerId": 1002,
            "speakerName": "派蒙",
            "text": "欸？什么什么？有什么好玩的事情吗？我也想听！",
            "nextDialogs": [
              "102000203"
            ]
          },
          "102000203": {
            "id": "102000203",
            "speakerId": 1001,
            "speakerName": "巴顿",
            "text": "酒馆里的客人们，最近激烈地讨论起了一个话题——「谁，才是蒙德城最强战力」。",
            "nextDialogs": [
              "102000204"
            ]
          },
          "102000204": {
            "id": "102000204",
            "speakerId": 1002,
            "speakerName": "派蒙",
            "text": "「最强」…？",
            "nextDialogs": [
              "102000205"
            ]
          },
          "102000205": {
            "id": "102000205",
            "speakerId": 1002,
            "speakerName": "派蒙",
            "text": "强到一拳能放倒几只丘丘人，算最强吗？",
            "nextDialogs": [
              "102000207",
              "102000209"
            ]
          },
          "102000207": {
            "id": "102000207",
            "speakerId": 1002,
            "speakerName": "派蒙",
            "text": "唔…看来「最强」的称号，并不好拿啊。",
            "nextDialogs": [
              "102000210"
            ]
          },
          "102000210": {
            "id": "102000210",
            "speakerId": 1002,
            "speakerName": "派蒙",
            "text": "对了，巴顿先生，关于这个话题，大家讨论出什么共识了吗？",
            "nextDialogs": [
              "102000211"
            ]
          },
          "102000211": {
            "id": "102000211",
            "speakerId": 1001,
            "speakerName": "巴顿",
            "text": "嗯…指望「自由之都」的人轻而易举达成共识，就像期待天上掉渔人吐司一样难。",
            "nextDialogs": [
              "102000212"
            ]
          },
          "102000212": {
            "id": "102000212",
            "speakerId": 1001,
            "speakerName": "巴顿",
            "text": "每个人都有自己的想法，但谁手里的信息都不全面，所以讨论才会变得激烈又有趣吧。",
            "nextDialogs": [
              "102000213"
            ]
          },
          "102000213": {
            "id": "102000213",
            "speakerId": 1001,
            "speakerName": "巴顿",
            "text": "现在市面上占据主流的提名…我想想…",
            "nextDialogs": [
              "102000214"
            ]
          },
          "102000214": {
            "id": "102000214",
            "speakerId": 1001,
            "speakerName": "巴顿",
            "text": "应该是「蒲公英骑士派」和「暗夜英雄派」吧。"
          },
          "102000209": {
            "id": "102000209",
            "speakerId": 1002,
            "speakerName": "派蒙",
            "text": "好，那我要提名你。"
          }
        }
      }
    },
    {
      "subId": "1020015",
      "subQuestName": "向巴顿了解最近的话题",
      "sceneId": null,
      "locations": [],

    {
      "subId": "1020005",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "102000501"
        ],
        "dialogs": {
          "102000501": {
            "id": "102000501",
            "speakerId": 1005,
            "speakerName": "查尔斯",
            "text": "今天想喝点儿什么？"
          }
        }
      }
    },
    {
      "subId": "1020011",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "102001101"
        ],
        "dialogs": {
          "102001101": {
            "id": "102001101",
            "speakerId": 1003,
            "speakerName": "杰克",
            "text": "你好！我在锻炼身为冒险家的酒量…你要不要一起？"
          }
        }
      }
    },
    {
      "subId": "1020012",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "102001201"
        ],
        "dialogs": {
          "102001201": {
            "id": "102001201",
            "speakerId": 1003,
            "speakerName": "杰克",
            "text": "你好像喝了很多啊？",
            "nextDialogs": [
              "102001202"
            ]
          },
          "102001202": {
            "id": "102001202",
            "speakerId": 1003,
            "speakerName": "杰克",
            "text": "很多吗？我数数…8杯啤酒…5杯葡萄酒…7杯苹果酒，也就这些吧。",
            "nextDialogs": [
              "102001203"
            ]
          },
          "102001203": {
            "id": "102001203",
            "speakerId": 1003,
            "speakerName": "杰克",
            "text": "这点还差得远啊，那些传说中的蒙德冒险家，据说能喝下半个果酒湖那么多的酒…",
            "nextDialogs": [
              "102001204"
            ]
          },
          "102001204": {
            "id": "102001204",
            "speakerId": 1003,
            "speakerName": "杰克",
            "text": "只是传说？嗯…原来是这样吗…怪不得，我一直想不通他们买酒的钱是哪里来的…"
          }
        }
      }
    },
    {
      "subId": "1020013",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "102001301"
        ],
        "dialogs": {
          "102001301": {
            "id": "102001301",
            "speakerId": 1003,
            "speakerName": "杰克",
            "text": "你喜欢什么酒？",
            "nextDialogs": [
              "102001302"
            ]
          },
          "102001302": {
            "id": "102001302",
            "speakerId": 1003,
            "speakerName": "杰克",
            "text": "我的话…啤酒吧，倒不是说特别喜欢…",
            "nextDialogs": [
              "102001303"
            ]
          },
          "102001303": {
            "id": "102001303",
            "speakerId": 1003,
            "speakerName": "杰克",
            "text": "只是像我这样的贫穷冒险者，似乎没什么太多选择…",
            "nextDialogs": [
              "102001304"
            ]
          },
          "102001304": {
            "id": "102001304",
            "speakerId": 1003,
            "speakerName": "杰克",
            "text": "能喝个痛快的就是好酒，你不觉得吗？"
          }
        }
      }
    },
    {
      "subId": "1020015",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "102001501"
        ],
        "dialogs": {
          "102001501": {
            "id": "102001501",
            "speakerId": 1006,
            "speakerName": "六指乔瑟",
            "text": "嘿~朋友你好！",
            "nextDialogs": [
              "102001502"
            ]
          },
          "102001502": {
            "id": "102001502",
            "speakerId": 1006,
            "speakerName": "六指乔瑟",
            "text": "怎么样？想听听六指乔瑟呕心沥血的最新作吗？"
          }
        }
      }
    },
    {
      "subId": "1020017",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "102001701"
        ],
        "dialogs": {
          "102001701": {
            "id": "102001701",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "再见。",
            "nextDialogs": [
              "102001702"
            ]
          },
          "102001702": {
            "id": "102001702",
            "speakerId": 1006,
            "speakerName": "六指乔瑟",
            "text": "要走了吗？看来你是个大忙人呢。",
            "nextDialogs": [
              "102001703"
            ]
          },
          "102001703": {
            "id": "102001703",
            "speakerId": 1006,
            "speakerName": "六指乔瑟",
            "text": "如果稍微有空闲的话，也来我这边捧个场吧。"
          }
        }
      }
    },
    {
      "subId": "1020018",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "102001801"
        ],
        "dialogs": {
          "102001801": {
            "id": "102001801",
            "speakerId": 1004,
            "speakerName": "布鲁斯",
            "text": "哦！你也是来品尝蒙德著名的好酒吗？"
          }
        }
      }
    },
    {
      "subId": "1020019",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "102001901"
        ],
        "dialogs": {
          "102001901": {
            "id": "102001901",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "你怎么在这儿？",
            "nextDialogs": [
              "102001902"
            ]
          },
          "102001902": {
            "id": "102001902",
            "speakerId": 1004,
            "speakerName": "布鲁斯",
            "text": "要说问什么…因为我下班了啊。",
            "nextDialogs": [
              "102001903"
            ]
          },
          "102001903": {
            "id": "102001903",
            "speakerId": 1004,
            "speakerName": "布鲁斯",
            "text": "在工作后小酌一杯的话晚上会睡得好些。",
            "nextDialogs": [
              "102001904"
            ]
          },
          "102001904": {
            "id": "102001904",
            "speakerId": 1004,
            "speakerName": "布鲁斯",
            "text": "唔？反正我工作的时候也是在偷懒？",
            "nextDialogs": [
              "102001905"
            ]
          },
          "102001905": {
            "id": "102001905",
            "speakerId": 1004,
            "speakerName": "布鲁斯",
            "text": "那都是因为…蒙德实在是太平静了嘛。",
            "nextDialogs": [
              "102001906"
            ]
          },
          "102001906": {
            "id": "102001906",
            "speakerId": 1004,
            "speakerName": "布鲁斯",
            "text": "要是我当初去了冒险家协会，生活大概会比现在有趣吧……",
            "nextDialogs": [
              "102001907"
            ]
          },
          "102001907": {
            "id": "102001907",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "…为什么会这么想？",
            "nextDialogs": [
              "102001908"
            ]
          },
          "102001908": {
            "id": "102001908",
            "speakerId": 1004,
            "speakerName": "布鲁斯",
            "text": "你想想，如果当上冒险家，就可以自由地在七国探索…",
            "nextDialogs": [
              "102001909"
            ]
          },
          "102001909": {
            "id": "102001909",
            "speakerId": 1004,
            "speakerName": "布鲁斯",
            "text": "还能通过冒险养活自己，那样的生活不是很有趣吗？"
          }
        }
      }
    },
    {
      "subId": "1020022",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "102002201"
        ],
        "dialogs": {
          "102002201": {
            "id": "102002201",
            "speakerId": 1003,
            "speakerName": "杰克",
            "text": "你好！我在锻炼身为冒险家的酒量…你要不要一起？"
          }
        }
      }
    },
    {
      "subId": "1020023",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "102002301"
        ],
        "dialogs": {
          "102002301": {
            "id": "102002301",
            "speakerId": 1006,
            "speakerName": "六指乔瑟",
            "text": "嘿~朋友你好！",
            "nextDialogs": [
              "102002302"
            ]
          },
          "102002302": {
            "id": "102002302",
            "speakerId": 1006,
            "speakerName": "六指乔瑟",
            "text": "怎么样？想听听六指乔瑟呕心沥血的最新作吗？"
          }
        }
      }
    },
    {
      "subId": "1020024",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "102002401"
        ],
        "dialogs": {
          "102002401": {
            "id": "102002401",
            "speakerId": 1004,
            "speakerName": "布鲁斯",
            "text": "哦！你也是来品尝蒙德著名的好酒吗？"
          }
        }
      }
    },
    {
      "subId": "1020025",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "102002501"
        ],
        "dialogs": {
          "102002501": {
            "id": "102002501",
            "speakerId": 1005,
            "speakerName": "查尔斯",
            "text": "有什么推荐吗？",
            "nextDialogs": [
              "102002502"
            ]
          },
          "102002502": {
            "id": "102002502",
            "speakerId": 1005,
            "speakerName": "查尔斯",
            "text": "晨曦酒庄的精品苹果酒，可以说是「天使的馈赠」的主打酒品。",
            "nextDialogs": [
              "102002503"
            ]
          },
          "102002503": {
            "id": "102002503",
            "speakerId": 1005,
            "speakerName": "查尔斯",
            "text": "感兴趣的话也可以尝尝我的调制酒，如果你是第一次喝，我可以送你一杯特调。"
          }
        }
      }
    },
    {
      "subId": "1020026",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "102002601"
        ],
        "dialogs": {
          "102002601": {
            "id": "102002601",
            "speakerId": 1005,
            "speakerName": "查尔斯",
            "text": "关于你自己。",
            "nextDialogs": [
              "102002602"
            ]
          },
          "102002602": {
            "id": "102002602",
            "speakerId": 1005,
            "speakerName": "查尔斯",
            "text": "居然对我感兴趣吗？",
            "nextDialogs": [
              "102002603"
            ]
          },
          "102002603": {
            "id": "102002603",
            "speakerId": 1005,
            "speakerName": "查尔斯",
            "text": "我在这里做酒保大概有十多年了，和其他员工一样，都是直接受雇于晨曦酒庄。",
            "nextDialogs": [
              "102002604"
            ]
          },
          "102002604": {
            "id": "102002604",
            "speakerId": 1005,
            "speakerName": "查尔斯",
            "text": "对酒本身谈不上喜爱，不过是我的工作而已…",
            "nextDialogs": [
              "102002605"
            ]
          },
          "102002605": {
            "id": "102002605",
            "speakerId": 1005,
            "speakerName": "查尔斯",
            "text": "嗯…当然也不会像猫尾酒馆的迪奥娜那样，据说她好像很讨厌酒。",
            "nextDialogs": [
              "102002606"
            ]
          },
          "102002606": {
            "id": "102002606",
            "speakerId": 1005,
            "speakerName": "查尔斯",
            "text": "偶尔酒庄老板迪卢克老爷会来带班。",
            "nextDialogs": [
              "102002607"
            ]
          },
          "102002607": {
            "id": "102002607",
            "speakerId": 1005,
            "speakerName": "查尔斯",
            "text": "毕竟对我来说是难得的假期，这一点我还是很感谢老爷他的。"
          }
        }
      }
    },
    {
      "subId": "1020027",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "102002701"
        ],
        "dialogs": {
          "102002701": {
            "id": "102002701",
            "speakerId": 1005,
            "speakerName": "查尔斯",
            "text": "不用了，谢谢。",
            "nextDialogs": [
              "102002702"
            ]
          },
          "102002702": {
            "id": "102002702",
            "speakerId": 1005,
            "speakerName": "查尔斯",
            "text": "是吗，少喝一点总归没错。"
          }
        }
      }
    }
  ]
}
      }
    },
    {
      "subId": "1020003",
      "subQuestName": "进入酒馆",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "102000301"
        ],
        "dialogs": {
          "102000301": {
            "id": "102000301",
            "speakerId": 1002,
            "speakerName": "派蒙",
            "text": "果然就跟巴顿先生说得一样呢。",
            "nextDialogs": [
              "102000304"
            ]
          },
          "102000304": {
            "id": "102000304",
            "speakerId": 1002,
            "speakerName": "派蒙",
            "text": "但是，如果像这样，谁都说服不了谁的话…",
            "nextDialogs": [
              "102000305"
            ]
          },
          "102000305": {
            "id": "102000305",
            "speakerId": 1002,
            "speakerName": "派蒙",
            "text": "岂不是永远都不能知道「蒙德的最强战力」到底是谁了。",
            "nextDialogs": [
              "102000306"
            ]
          },
          "102000306": {
            "id": "102000306",
            "speakerId": 1002,
            "speakerName": "派蒙",
            "text": "啊，有了！",
            "nextDialogs": [
              "102000307"
            ]
          },
          "102000307": {
            "id": "102000307",
            "speakerId": 1002,
            "speakerName": "派蒙",
            "text": "我们去找<color=#00E1FFFF>琴团长</color>问问看吧？",
            "nextDialogs": [
              "102000308"
            ]
          },
          "102000308": {
            "id": "102000308",
            "speakerId": 1002,
            "speakerName": "派蒙",
            "text": "说不定会有，「西风骑士团认证的官方排行榜」！"
          }
        }
      }
    },
    {
      "subId": "1020004",
      "subQuestName": "向酒客们打听「最强战力」的事",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "102000701"
        ],
        "dialogs": {
          "102000701": {
            "id": "102000701",
            "speakerId": 1003,
            "speakerName": "杰克",
            "text": "关于「蒙德最强战力」。",
            "nextDialogs": [
              "102000702"
            ]
          },
          "102000702": {
            "id": "102000702",
            "speakerId": 1003,
            "speakerName": "杰克",
            "text": "你问我心目中的「最强战力」？",
            "nextDialogs": [
              "102000703"
            ]
          },
          "102000703": {
            "id": "102000703",
            "speakerId": 1003,
            "speakerName": "杰克",
            "text": "那应该就是光辉万丈的大冒险家——斯坦利先生了吧。",
            "nextDialogs": [
              "102000704"
            ]
          },
          "102000704": {
            "id": "102000704",
            "speakerId": 1003,
            "speakerName": "杰克",
            "text": "虽然协会的塞琉斯会长也很厉害，但能够直面烬寂海魔兽的，只有斯坦利先生一个吧！",
            "nextDialogs": [
              "102000705"
            ]
          },
          "102000705": {
            "id": "102000705",
            "speakerId": 1002,
            "speakerName": "派蒙",
            "text": "「烬寂海的魔兽」，听上去很凶猛呢。",
            "nextDialogs": [
              "102000706"
            ]
          },
          "102000706": {
            "id": "102000706",
            "speakerId": 1002,
            "speakerName": "派蒙",
            "text": "要是出现在你面前，你会害怕吗？",
            "nextDialogs": [
              "102000708",
              "102000710"
            ]
          },
          "102000708": {
            "id": "102000708",
            "speakerId": 1002,
            "speakerName": "派蒙",
            "text": "哦哦！真不愧是你呢。"
          },
          "102000710": {
            "id": "102000710",
            "speakerId": 1002,
            "speakerName": "派蒙",
            "text": "唔，没错。毕竟，那个，安全第一。"
          }
        }
      }
    },
    {
      "subId": "1020011",
      "subQuestName": "向酒客们打听「最强战力」的事",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "102000801"
        ],
        "dialogs": {
          "102000801": {
            "id": "102000801",
            "speakerId": 1004,
            "speakerName": "布鲁斯",
            "text": "关于「蒙德最强战力」。",
            "nextDialogs": [
              "102000802"
            ]
          },
          "102000802": {
            "id": "102000802",
            "speakerId": 1004,
            "speakerName": "布鲁斯",
            "text": "嗝…要说最强的话。",
            "nextDialogs": [
              "102000803"
            ]
          },
          "102000803": {
            "id": "102000803",
            "speakerId": 1004,
            "speakerName": "布鲁斯",
            "text": "那当然是我们的琴团长了…嗝。",
            "nextDialogs": [
              "102000804"
            ]
          },
          "102000804": {
            "id": "102000804",
            "speakerId": 1004,
            "speakerName": "布鲁斯",
            "text": "就是因为…琴团长太厉害，甩几下剑…就能…击败遗迹守卫…",
            "nextDialogs": [
              "102000805"
            ]
          },
          "102000805": {
            "id": "102000805",
            "speakerId": 1004,
            "speakerName": "布鲁斯",
            "text": "一个人就能…扫平达达乌帕谷的三大部族…",
            "nextDialogs": [
              "102000806"
            ]
          },
          "102000806": {
            "id": "102000806",
            "speakerId": 1004,
            "speakerName": "布鲁斯",
            "text": "才会，让我们过得太安逸…无所事事…",
            "nextDialogs": [
              "102000807"
            ]
          },
          "102000807": {
            "id": "102000807",
            "speakerId": 1002,
            "speakerName": "派蒙",
            "text": "嗯，琴团长给人的感觉，的确很可靠。",
            "nextDialogs": [
              "102000808"
            ]
          },
          "102000808": {
            "id": "102000808",
            "speakerId": 1002,
            "speakerName": "派蒙",
            "text": "但是，总觉得这个家伙已经醉醺醺的了…"
          }
        }
      }
    },
    {
      "subId": "1020012",
      "subQuestName": "向酒客们打听「最强战力」的事",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "102000901"
        ],
        "dialogs": {
          "102000901": {
            "id": "102000901",
            "speakerId": 1005,
            "speakerName": "查尔斯",
            "text": "关于「蒙德最强战力」。",
            "nextDialogs": [
              "102000902"
            ]
          },
          "102000902": {
            "id": "102000902",
            "speakerId": 1005,
            "speakerName": "查尔斯",
            "text": "「最强战力」？我不太关心这类话题…",
            "nextDialogs": [
              "102000903"
            ]
          },
          "102000903": {
            "id": "102000903",
            "speakerId": 1002,
            "speakerName": "派蒙",
            "text": "欸。我还以为会有什么，只有酒保先生才知道的消息渠道呢。",
            "nextDialogs": [
              "102000904"
            ]
          },
          "102000904": {
            "id": "102000904",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "就像专供的酒源一样？",
            "nextDialogs": [
              "102000905"
            ]
          },
          "102000905": {
            "id": "102000905",
            "speakerId": 1002,
            "speakerName": "派蒙",
            "text": "没错没错！就是这样。",
            "nextDialogs": [
              "102000906"
            ]
          },
          "102000906": {
            "id": "102000906",
            "speakerId": 1005,
            "speakerName": "查尔斯",
            "text": "我可不做情报方面的工作。",
            "nextDialogs": [
              "102000907"
            ]
          },
          "102000907": {
            "id": "102000907",
            "speakerId": 1005,
            "speakerName": "查尔斯",
            "text": "但真要我推选一个人选的话，「暗夜英雄」吧。",
            "nextDialogs": [
              "102000908"
            ]
          },
          "102000908": {
            "id": "102000908",
            "speakerId": 1005,
            "speakerName": "查尔斯",
            "text": "我听人提起他的事迹，好像是从深渊教团手里救出过平民。",
            "nextDialogs": [
              "102000909"
            ]
          },
          "102000909": {
            "id": "102000909",
            "speakerId": 1002,
            "speakerName": "派蒙",
            "text": "出现了，是隐藏情报！",
            "nextDialogs": [
              "102000910"
            ]
          },
          "102000910": {
            "id": "102000910",
            "speakerId": 1002,
            "speakerName": "派蒙",
            "text": "话说回来，那些深渊教团的怪物，还真是四处作乱啊。"
          }
        }
      }
    },
    {
      "subId": "1020013",
      "subQuestName": "向酒客们打听「最强战力」的事",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "102001001"
        ],
        "dialogs": {
          "102001001": {
            "id": "102001001",
            "speakerId": 1006,
            "speakerName": "六指乔瑟",
            "text": "关于「蒙德最强战力」。",
            "nextDialogs": [
              "102001002"
            ]
          },
          "102001002": {
            "id": "102001002",
            "speakerId": 1006,
            "speakerName": "六指乔瑟",
            "text": "唔…「蒙德的最强战力」…",
            "nextDialogs": [
              "102001003"
            ]
          },
          "102001003": {
            "id": "102001003",
            "speakerId": 1006,
            "speakerName": "六指乔瑟",
            "text": "我想…那是一个红衣服的小女孩。",
            "nextDialogs": [
              "102001004"
            ]
          },
          "102001004": {
            "id": "102001004",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "红衣服的小女孩？",
            "nextDialogs": [
              "102001005"
            ]
          },
          "102001005": {
            "id": "102001005",
            "speakerId": 1006,
            "speakerName": "六指乔瑟",
            "text": "没错。这就要说起半个月前的某一天，我去望风山地寻找新作的灵感，结果…",
            "nextDialogs": [
              "102001006"
            ]
          },
          "102001006": {
            "id": "102001006",
            "speakerId": 1006,
            "speakerName": "六指乔瑟",
            "text": "你猜怎么着？",
            "nextDialogs": [
              "102001007"
            ]
          },
          "102001007": {
            "id": "102001007",
            "speakerId": 1002,
            "speakerName": "派蒙",
            "text": "怎么着？",
            "nextDialogs": [
              "102001008"
            ]
          },
          "102001008": {
            "id": "102001008",
            "speakerId": 1006,
            "speakerName": "六指乔瑟",
            "text": "我发现了一位极具破坏力的强者！",
            "nextDialogs": [
              "102001009"
            ]
          },
          "102001009": {
            "id": "102001009",
            "speakerId": 1006,
            "speakerName": "六指乔瑟",
            "text": "望风山地的一大片地貌，都被那位强者改变了！",
            "nextDialogs": [
              "102001010"
            ]
          },
          "102001010": {
            "id": "102001010",
            "speakerId": 1002,
            "speakerName": "派蒙",
            "text": "哇！！",
            "nextDialogs": [
              "102001011"
            ]
          },
          "102001011": {
            "id": "102001011",
            "speakerId": 1006,
            "speakerName": "六指乔瑟",
            "text": "那时我躲在灌木丛后面，看到一个红衣服的小女孩跑远了，只留下面目全非的山地。",
            "nextDialogs": [
              "102001012"
            ]
          },
          "102001012": {
            "id": "102001012",
            "speakerId": 1006,
            "speakerName": "六指乔瑟",
            "text": "唔…但是这样说了别人也不相信。",
            "nextDialogs": [
              "102001013"
            ]
          },
          "102001013": {
            "id": "102001013",
            "speakerId": 1002,
            "speakerName": "派蒙",
            "text": "嗯…小女孩和那么强大的破坏力，很难联系在一起呢。",
            "nextDialogs": [
              "102001014"
            ]
          },
          "102001014": {
            "id": "102001014",
            "speakerId": 1006,
            "speakerName": "六指乔瑟",
            "text": "要我说，她一定有什么大家都不知道的宝物。",
            "nextDialogs": [
              "102001015"
            ]
          },
          "102001015": {
            "id": "102001015",
            "speakerId": 1006,
            "speakerName": "六指乔瑟",
            "text": "说不好，还是全蒙德最厉害的宝物！",
            "nextDialogs": [
              "102001016"
            ]
          },
          "102001016": {
            "id": "102001016",
            "speakerId": 1002,
            "speakerName": "派蒙",
            "text": "你是说…宝物？！",
            "nextDialogs": [
              "102001017"
            ]
          },
          "102001017": {
            "id": "102001017",
            "speakerId": 1002,
            "speakerName": "派蒙",
            "text": "#{NICKNAME}，你听见了吗。",
            "nextDialogs": [
              "102001018"
            ]
          },
          "102001018": {
            "id": "102001018",
            "speakerId": 1006,
            "speakerName": "六指乔瑟",
            "text": "…这是我的猜测。唔…不对，是吟游诗人敏锐的感觉！",
            "nextDialogs": [
              "102001020",
              "102001022"
            ]
          },
          "102001020": {
            "id": "102001020",
            "speakerId": 1006,
            "speakerName": "六指乔瑟",
            "text": "怎么这样…",
            "nextDialogs": [
              "102001023"
            ]
          },
          "102001023": {
            "id": "102001023",
            "speakerId": 1002,
            "speakerName": "派蒙",
            "text": "那个小女孩，叫什么名字呢？",
            "nextDialogs": [
              "102001024"
            ]
          },
          "102001024": {
            "id": "102001024",
            "speakerId": 1006,
            "speakerName": "六指乔瑟",
            "text": "唔…名字我就不知道了。不怎么在蒙德城里见过她。",
            "nextDialogs": [
              "102001025"
            ]
          },
          "102001025": {
            "id": "102001025",
            "speakerId": 1006,
            "speakerName": "六指乔瑟",
            "text": "唉，别不相信啊，我说的可都是实话！",
            "nextDialogs": [
              "102001026"
            ]
          },
          "102001026": {
            "id": "102001026",
            "speakerId": 1002,
            "speakerName": "派蒙",
            "text": "嗯唔…听上去还有点神神秘秘的呢。",
            "nextDialogs": [
              "102001027"
            ]
          },
          "102001027": {
            "id": "102001027",
            "speakerId": 1002,
            "speakerName": "派蒙",
            "text": "不过，谢谢你的情报！"
          },
          "102001022": {
            "id": "102001022",
            "speakerId": 1006,
            "speakerName": "六指乔瑟",
            "text": "谢谢你！啊，难得的知音？！我是多么喜悦， 居然在…"
          }
        }
      }
    },
    {
      "subId": "1020014",
      "subQuestName": "(test)向酒客们打听「最强战力」的事$HIDDEN",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "102001401"
        ],
        "dialogs": {
          "102001401": {
            "id": "102001401",
            "speakerId": 1003,
            "speakerName": "杰克",
            "text": "再见。",
            "nextDialogs": [
              "102001402"
            ]
          },
          "102001402": {
            "id": "102001402",
            "speakerId": 1003,
            "speakerName": "杰克",
            "text": "嗯，再见。祝你今后的冒险一切顺利。"
          }
        }
      }
    },
    {
      "subId": "1020016",
      "subQuestName": "(test)任务隔离，防止回滚$HIDDEN",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "102001601"
        ],
        "dialogs": {
          "102001601": {
            "id": "102001601",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "…你是谁？",
            "nextDialogs": [
              "102001602"
            ]
          },
          "102001602": {
            "id": "102001602",
            "speakerId": 1006,
            "speakerName": "六指乔瑟",
            "text": "叫我「六指乔瑟」就可以了。",
            "nextDialogs": [
              "102001603"
            ]
          },
          "102001603": {
            "id": "102001603",
            "speakerId": 1006,
            "speakerName": "六指乔瑟",
            "text": "我是蒙德的人气吟游诗人，嗯…至少曾经很有人气。",
            "nextDialogs": [
              "102001605",
              "102001610"
            ]
          },
          "102001605": {
            "id": "102001605",
            "speakerId": 1006,
            "speakerName": "六指乔瑟",
            "text": "嗯？你要听我的新作「晨风颂曲」吗？",
            "nextDialogs": [
              "102001606"
            ]
          },
          "102001606": {
            "id": "102001606",
            "speakerId": 1006,
            "speakerName": "六指乔瑟",
            "text": "那么…请先容我调下琴。",
            "nextDialogs": [
              "102001607"
            ]
          },
          "102001607": {
            "id": "102001607",
            "speakerId": 1006,
            "speakerName": "六指乔瑟",
            "text": "唔……",
            "nextDialogs": [
              "102001608"
            ]
          },
          "102001608": {
            "id": "102001608",
            "speakerId": 1006,
            "speakerName": "六指乔瑟",
            "text": "不好意思，我这里已经很久没有听众来过了，弦的状态有点…还是下次吧。"
          },
          "102001610": {
            "id": "102001610",
            "speakerId": 1006,
            "speakerName": "六指乔瑟",
            "text": "当然，毕竟蒙德还有「牧歌之城」的叫法。",
            "nextDialogs": [
              "102001611"
            ]
          },
          "102001611": {
            "id": "102001611",
            "speakerId": 1006,
            "speakerName": "六指乔瑟",
            "text": "可最近出现了一个奇怪的吟游诗人，我调查了很久都没查出他的来头，可恶。",
            "nextDialogs": [
              "102001612"
            ]
          },
          "102001612": {
            "id": "102001612",
            "speakerId": 1006,
            "speakerName": "六指乔瑟",
            "text": "自从他出现，我的听众就明显越来越少了。",
            "nextDialogs": [
              "102001613"
            ]
          },
          "102001613": {
            "id": "102001613",
            "speakerId": 1006,
            "speakerName": "六指乔瑟",
            "text": "本想找他一决胜负把听众抢回来的…",
            "nextDialogs": [
              "102001614"
            ]
          },
          "102001614": {
            "id": "102001614",
            "speakerId": 1006,
            "speakerName": "六指乔瑟",
            "text": "可是那个人的歌声实在太美妙了，我自己也会沉醉其中…唔…"
          }
        }
      }
    },
    {
      "subId": "1020005",
      "subQuestName": "和派蒙一起总结情报",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [],
        "dialogs": {}
      }
    },
    {
      "subId": "1020006",
      "subQuestName": "前往骑士团",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "102000601"
        ],
        "dialogs": {
          "102000601": {
            "id": "102000601",
            "speakerId": 1007,
            "speakerName": "？？？",
            "text": "唔！我，我很好！对不起，撞到了你们。",
            "nextDialogs": [
              "102000602"
            ]
          },
          "102000602": {
            "id": "102000602",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "你有东西掉了。",
            "nextDialogs": [
              "102000603"
            ]
          },
          "102000603": {
            "id": "102000603",
            "speakerId": 1002,
            "speakerName": "派蒙",
            "text": "嗯唔…这上面写的是…",
            "nextDialogs": [
              "102000604"
            ]
          },
          "102000604": {
            "id": "102000604",
            "speakerId": 1002,
            "speakerName": "派蒙",
            "text": "「城里放炮禁闭室报到」、「炸弹伤人琴找上门」、「放火烧山可莉完蛋」？",
            "nextDialogs": [
              "102000605"
            ]
          },
          "102000605": {
            "id": "102000605",
            "speakerId": 1007,
            "speakerName": "？？？",
            "text": "呀？！",
            "nextDialogs": [
              "102000606"
            ]
          },
          "102000606": {
            "id": "102000606",
            "speakerId": 1007,
            "speakerName": "？？？",
            "text": "这…这是凯亚哥哥帮我总结出的…总结出的…唔，生存守则！",
            "nextDialogs": [
              "102000607"
            ]
          },
          "102000607": {
            "id": "102000607",
            "speakerId": 1002,
            "speakerName": "派蒙",
            "text": "生存守则？",
            "nextDialogs": [
              "102000608"
            ]
          },
          "102000608": {
            "id": "102000608",
            "speakerId": 1007,
            "speakerName": "？？？",
            "text": "就…就是不论如何千万不能违反的东西。",
            "nextDialogs": [
              "102000609"
            ]
          },
          "102000609": {
            "id": "102000609",
            "speakerId": 1007,
            "speakerName": "？？？",
            "text": "不然会发生很可怕、很可怕的事情。",
            "nextDialogs": [
              "102000612"
            ]
          },
          "102000612": {
            "id": "102000612",
            "speakerId": 1007,
            "speakerName": "？？？",
            "text": "嗯！",
            "nextDialogs": [
              "102000613"
            ]
          },
          "102000613": {
            "id": "102000613",
            "speakerId": 1007,
            "speakerName": "？？？",
            "text": "啊啊啊，忘记做自我介绍了。",
            "nextDialogs": [
              "102000614"
            ]
          },
          "102000614": {
            "id": "102000614",
            "speakerId": 1008,
            "speakerName": "可莉",
            "text": "我的名字叫作可莉。"
          }
        }
      }
    },
    {
      "subId": "1020007",
      "subQuestName": "向琴了解「最强战力」的情报",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "102000401"
        ],
        "dialogs": {
          "102000401": {
            "id": "102000401",
            "speakerId": 1002,
            "speakerName": "派蒙",
            "text": "琴团长！打扰你啦，我们在收集「蒙德最强战力」的情报。",
            "nextDialogs": [
              "102000402"
            ]
          },
          "102000402": {
            "id": "102000402",
            "speakerId": 1002,
            "speakerName": "派蒙",
            "text": "有没有…那种…西风骑士团认证过的官方排名呢？",
            "nextDialogs": [
              "102000403"
            ]
          },
          "102000403": {
            "id": "102000403",
            "speakerId": 1000,
            "speakerName": "琴",
            "text": "「蒙德最强战力」…？",
            "nextDialogs": [
              "102000404"
            ]
          },
          "102000404": {
            "id": "102000404",
            "speakerId": 1000,
            "speakerName": "琴",
            "text": "抱歉，不能帮上忙了。我身边并没有这方面的资料…",
            "nextDialogs": [
              "102000405"
            ]
          },
          "102000405": {
            "id": "102000405",
            "speakerId": 1002,
            "speakerName": "派蒙",
            "text": "欸…好可惜。",
            "nextDialogs": [
              "102000406"
            ]
          },
          "102000406": {
            "id": "102000406",
            "speakerId": 1002,
            "speakerName": "派蒙",
            "text": "#我还希望看{PLAYERAVATAR#SEXPRO[INFO_MALE_PRONOUN_HE|INFO_FEMALE_PRONOUN_SHE]}排上前五呢。",
            "nextDialogs": [
              "102000407"
            ]
          },
          "102000407": {
            "id": "102000407",
            "speakerId": 1000,
            "speakerName": "琴",
            "text": "哈哈。即使没有这方面的统计，我对这位荣誉骑士的实力也从未质疑过。",
            "nextDialogs": [
              "102000408"
            ]
          },
          "102000408": {
            "id": "102000408",
            "speakerId": 1000,
            "speakerName": "琴",
            "text": "对了，说到这个…",
            "nextDialogs": [
              "102000409"
            ]
          },
          "102000409": {
            "id": "102000409",
            "speakerId": 1000,
            "speakerName": "琴",
            "text": "最近又有深渊教团的法师，在蒙德城附近鬼鬼祟祟地出没。",
            "nextDialogs": [
              "102000410"
            ]
          },
          "102000410": {
            "id": "102000410",
            "speakerId": 1000,
            "speakerName": "琴",
            "text": "如果你们在蒙德周边逗留，也希望能够帮忙留意一下。",
            "nextDialogs": [
              "102000411"
            ]
          },
          "102000411": {
            "id": "102000411",
            "speakerId": 1000,
            "speakerName": "琴",
            "text": "以你的「战力」，守护人们的安全，应当不成问题。",
            "nextDialogs": [
              "102000412"
            ]
          },
          "102000412": {
            "id": "102000412",
            "speakerId": 1002,
            "speakerName": "派蒙",
            "text": "#好！如果能够把深渊教团解决掉的话，{PLAYERAVATAR#SEXPRO[INFO_MALE_PRONOUN_HE|INFO_FEMALE_PRONOUN_SHE]}的排名又会上升一点吧。",
            "nextDialogs": [
              "102000415"
            ]
          },
          "102000415": {
            "id": "102000415",
            "speakerId": 1002,
            "speakerName": "派蒙",
            "text": "总之，打倒他们就对了啦！",
            "nextDialogs": [
              "102000416"
            ]
          },
          "102000416": {
            "id": "102000416",
            "speakerId": 1000,
            "speakerName": "琴",
            "text": "哈，感觉被你们的干劲激励了呢。",
            "nextDialogs": [
              "102000417"
            ]
          },
          "102000417": {
            "id": "102000417",
            "speakerId": 1000,
            "speakerName": "琴",
            "text": "那么，一路小心。"
          }
        }
      }
    },

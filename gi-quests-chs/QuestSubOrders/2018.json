    {
      "subId": "201802",
      "subQuestName": "返回鸣神大社，找到八重神子",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "20180201"
        ],
        "dialogs": {
          "20180201": {
            "id": "20180201",
            "speakerId": 1038,
            "speakerName": "九条裟罗",
            "text": "八重宫司大人，我如约来了。请放心，我没带随从来，这次行程也不会有人知道。",
            "nextDialogs": [
              "20180202"
            ]
          },
          "20180202": {
            "id": "20180202",
            "speakerId": 1034,
            "speakerName": "八重神子",
            "text": "知道你会守约的，而且我猜…你这几天甚至会心烦意乱，夜不能寐吧？",
            "nextDialogs": [
              "20180203"
            ]
          },
          "20180203": {
            "id": "20180203",
            "speakerId": 1038,
            "speakerName": "九条裟罗",
            "text": "我…我不会那样怀疑家主他们的，您过度揣测了。",
            "nextDialogs": [
              "20180204"
            ]
          },
          "20180204": {
            "id": "20180204",
            "speakerId": 1038,
            "speakerName": "九条裟罗",
            "text": "那么，我要的证据在哪里？",
            "nextDialogs": [
              "20180205"
            ]
          },
          "20180205": {
            "id": "20180205",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "在这里。",
            "nextDialogs": [
              "20180206"
            ]
          },
          "20180206": {
            "id": "20180206",
            "speakerId": 1034,
            "speakerName": "八重神子",
            "text": "哦~另一个守约的人也来了。",
            "nextDialogs": [
              "20180207"
            ]
          },
          "20180207": {
            "id": "20180207",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "为了拿到这些，可费了我们一番功夫呢。",
            "nextDialogs": [
              "20180208"
            ]
          },
          "20180208": {
            "id": "20180208",
            "speakerId": 1034,
            "speakerName": "八重神子",
            "text": "交给裟罗看看吧，让她自己评判。",
            "nextDialogs": [
              "20180209"
            ]
          },
          "20180209": {
            "id": "20180209",
            "speakerId": 1038,
            "speakerName": "九条裟罗",
            "text": "这是…",
            "nextDialogs": [
              "20180210"
            ]
          },
          "20180210": {
            "id": "20180210",
            "speakerId": 1038,
            "speakerName": "九条裟罗",
            "text": "…这上面确实印有家主的官印，不像是造假…",
            "nextDialogs": [
              "20180211"
            ]
          },
          "20180211": {
            "id": "20180211",
            "speakerId": 1038,
            "speakerName": "九条裟罗",
            "text": "反抗军，珊瑚宫，前线的事，居然只字未提…",
            "nextDialogs": [
              "20180212"
            ]
          },
          "20180212": {
            "id": "20180212",
            "speakerId": 1038,
            "speakerName": "九条裟罗",
            "text": "前线那些阵亡的将士，人民在此间经受的困苦，全都不值一提吗！",
            "nextDialogs": [
              "20180213"
            ]
          },
          "20180213": {
            "id": "20180213",
            "speakerId": 1038,
            "speakerName": "九条裟罗",
            "text": "也太小看人命了吧，究竟为何要如此隐瞒…",
            "nextDialogs": [
              "20180214"
            ]
          },
          "20180214": {
            "id": "20180214",
            "speakerId": 1034,
            "speakerName": "八重神子",
            "text": "当然是为了让眼狩令顺利推行，不然把这些写进去的话，将军反悔了可怎么办呢？",
            "nextDialogs": [
              "20180215"
            ]
          },
          "20180215": {
            "id": "20180215",
            "speakerId": 1038,
            "speakerName": "九条裟罗",
            "text": "天领奉行…果然在刻意蒙蔽将军吗？",
            "nextDialogs": [
              "20180216"
            ]
          },
          "20180216": {
            "id": "20180216",
            "speakerId": 1034,
            "speakerName": "八重神子",
            "text": "是呢，再想想，眼狩令的推行…对谁更有利呢？",
            "nextDialogs": [
              "20180217"
            ]
          },
          "20180217": {
            "id": "20180217",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "这里还有一封密信。",
            "nextDialogs": [
              "20180218"
            ]
          },
          "20180218": {
            "id": "20180218",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "是天领奉行与愚人众的来往书信哦，还是被九条家的家主刻意藏起来的。",
            "nextDialogs": [
              "20180219"
            ]
          },
          "20180219": {
            "id": "20180219",
            "speakerId": 1038,
            "speakerName": "九条裟罗",
            "text": "……",
            "nextDialogs": [
              "20180220"
            ]
          },
          "20180220": {
            "id": "20180220",
            "speakerId": 1034,
            "speakerName": "八重神子",
            "text": "如何？你想看到的东西，你不想看到的东西，这样一来都摆在你面前了。",
            "nextDialogs": [
              "20180221"
            ]
          },
          "20180221": {
            "id": "20180221",
            "speakerId": 1034,
            "speakerName": "八重神子",
            "text": "该不会…你还想要逃避吧？",
            "nextDialogs": [
              "20180222"
            ]
          },
          "20180222": {
            "id": "20180222",
            "speakerId": 1038,
            "speakerName": "九条裟罗",
            "text": "我迄今为止所坚持的一切岂不是…居然…他们居然…可恶！",
            "nextDialogs": [
              "20180223"
            ]
          },
          "20180223": {
            "id": "20180223",
            "speakerId": 1038,
            "speakerName": "九条裟罗",
            "text": "背叛的行为不可饶恕…我要去和家主当面对质！",
            "nextDialogs": [
              "20180224"
            ]
          },
          "20180224": {
            "id": "20180224",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "九条裟罗真的很气愤呢，看样子策反成功了。",
            "nextDialogs": [
              "20180227"
            ]
          },
          "20180227": {
            "id": "20180227",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "嗯，我们去追她吧。",
            "nextDialogs": [
              "20180228"
            ]
          },
          "20180228": {
            "id": "20180228",
            "speakerId": 1034,
            "speakerName": "八重神子",
            "text": "等一下，旅行者，我还有话想要和你说。",
            "nextDialogs": [
              "20180229"
            ]
          },
          "20180229": {
            "id": "20180229",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "嗯？",
            "nextDialogs": [
              "20180230"
            ]
          },
          "20180230": {
            "id": "20180230",
            "speakerId": 1034,
            "speakerName": "八重神子",
            "text": "你第一次进入「一心净土」，是在千手百眼神像前吧？",
            "nextDialogs": [
              "20180231"
            ]
          },
          "20180231": {
            "id": "20180231",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "没错。",
            "nextDialogs": [
              "20180232"
            ]
          },
          "20180232": {
            "id": "20180232",
            "speakerId": 1034,
            "speakerName": "八重神子",
            "text": "你要想办法，重现那天的情景。",
            "nextDialogs": [
              "20180233"
            ]
          },
          "20180233": {
            "id": "20180233",
            "speakerId": 1034,
            "speakerName": "八重神子",
            "text": "在千手百眼神像前，再度让雷电将军「敞开心扉」的话，就一定有机会…",
            "nextDialogs": [
              "20180234"
            ]
          },
          "20180234": {
            "id": "20180234",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "我会尽力。",
            "nextDialogs": [
              "20180235"
            ]
          },
          "20180235": {
            "id": "20180235",
            "speakerId": 1034,
            "speakerName": "八重神子",
            "text": "把这个带在身上吧，作为饯别的礼物。",
            "nextDialogs": [
              "20180236"
            ]
          },
          "20180236": {
            "id": "20180236",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "这是…？",
            "nextDialogs": [
              "20180237"
            ]
          },
          "20180237": {
            "id": "20180237",
            "speakerId": 1034,
            "speakerName": "八重神子",
            "text": "鸣神大社的御守，可从来都是很灵验的，我特意给你留了一个。"
          }
        }
      }
    },
    {
      "subId": "201803",
      "subQuestName": "跟随九条裟罗前往天领奉行府",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "20180301"
        ],
        "dialogs": {
          "20180301": {
            "id": "20180301",
            "speakerId": 1038,
            "speakerName": "九条裟罗",
            "text": "你们也跟来了么？胆量倒是不小。",
            "nextDialogs": [
              "20180302"
            ]
          },
          "20180302": {
            "id": "20180302",
            "speakerId": 1038,
            "speakerName": "九条裟罗",
            "text": "你们作为证人，在我向家主求证之前，姑且可以先保你们不被就地逮捕。",
            "nextDialogs": [
              "20180303"
            ]
          },
          "20180303": {
            "id": "20180303",
            "speakerId": 1038,
            "speakerName": "九条裟罗",
            "text": "不过…若证实你们之前的所言皆是诽谤，那你们不仅走不了，还会另有罪名加身，明白吧？",
            "nextDialogs": [
              "20180306"
            ]
          },
          "20180306": {
            "id": "20180306",
            "speakerId": 1038,
            "speakerName": "九条裟罗",
            "text": "哼，很好。"
          }
        }
      }
    },

    {
      "subId": "201804",
      "subQuestName": "与九条孝行对话",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "20180403"
        ],
        "dialogs": {
          "20180403": {
            "id": "20180403",
            "speakerId": 3053,
            "speakerName": "九条孝行",
            "text": "住手！裟罗，你疯了吗！居然敢不顾我的禁令！",
            "nextDialogs": [
              "20180404"
            ]
          },
          "20180404": {
            "id": "20180404",
            "speakerId": 1038,
            "speakerName": "九条裟罗",
            "text": "家主…",
            "nextDialogs": [
              "20180405"
            ]
          },
          "20180405": {
            "id": "20180405",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "问啊，别被他的气势给压制了！",
            "nextDialogs": [
              "20180406"
            ]
          },
          "20180406": {
            "id": "20180406",
            "speakerId": 1038,
            "speakerName": "九条裟罗",
            "text": "哼…孝行大人，我看过奉行府的上奏公文和写给愚人众的信件了，请您…给我一个交待！",
            "nextDialogs": [
              "20180407"
            ]
          },
          "20180407": {
            "id": "20180407",
            "speakerId": 3053,
            "speakerName": "九条孝行",
            "text": "遗失的那些公文和信件，原来是被你拿走了么？哼…",
            "nextDialogs": [
              "20180408"
            ]
          },
          "20180408": {
            "id": "20180408",
            "speakerId": 1038,
            "speakerName": "九条裟罗",
            "text": "您的这句话，我可以理解为…那些果真都是出自您的手笔，而并非伪造么？",
            "nextDialogs": [
              "20180409"
            ]
          },
          "20180409": {
            "id": "20180409",
            "speakerId": 1038,
            "speakerName": "九条裟罗",
            "text": "请您告诉我，家主，告诉我天领奉行…真的背叛了幕府吗！",
            "nextDialogs": [
              "20180410"
            ]
          },
          "20180410": {
            "id": "20180410",
            "speakerId": 3053,
            "speakerName": "九条孝行",
            "text": "哼…我的确与愚人众有所往来，你所见过的公文也的确出自我之手。",
            "nextDialogs": [
              "20180411"
            ]
          },
          "20180411": {
            "id": "20180411",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "居然就这么承认了…",
            "nextDialogs": [
              "20180412"
            ]
          },
          "20180412": {
            "id": "20180412",
            "speakerId": 3053,
            "speakerName": "九条孝行",
            "text": "只需要协助眼狩令的颁布和推行，就能拿到至冬使节承诺的那些好处…",
            "nextDialogs": [
              "20180413"
            ]
          },
          "20180413": {
            "id": "20180413",
            "speakerId": 3053,
            "speakerName": "九条孝行",
            "text": "一直以来，觊觎九条家地位的人那么多，想把我们拉下马的家系也数不胜数。",
            "nextDialogs": [
              "20180414"
            ]
          },
          "20180414": {
            "id": "20180414",
            "speakerId": 3053,
            "speakerName": "九条孝行",
            "text": "既能得到他国势力的大力支持，又可以借眼狩令削弱那些敌人的战力…",
            "nextDialogs": [
              "20180415"
            ]
          },
          "20180415": {
            "id": "20180415",
            "speakerId": 3053,
            "speakerName": "九条孝行",
            "text": "我认为是一笔划算的买卖，只不过没必要知会你而已，裟罗。",
            "nextDialogs": [
              "20180416"
            ]
          },
          "20180416": {
            "id": "20180416",
            "speakerId": 1038,
            "speakerName": "九条裟罗",
            "text": "你明明…明明一直都那么崇敬将军，为什么把背叛的事说得那么轻描淡写！",
            "nextDialogs": [
              "20180417"
            ]
          },
          "20180417": {
            "id": "20180417",
            "speakerId": 3053,
            "speakerName": "九条孝行",
            "text": "背叛？这能算得上是背叛吗？",
            "nextDialogs": [
              "20180418"
            ]
          },
          "20180418": {
            "id": "20180418",
            "speakerId": 3053,
            "speakerName": "九条孝行",
            "text": "那些愚人众不过是反过来被我利用罢了，他们又能成什么事？",
            "nextDialogs": [
              "20180419"
            ]
          },
          "20180419": {
            "id": "20180419",
            "speakerId": 3053,
            "speakerName": "九条孝行",
            "text": "在稻妻的国土上，一旦天雷落下，他们不过是些只会瑟瑟发抖的蝼蚁罢了，绝不敢造次。",
            "nextDialogs": [
              "20180420"
            ]
          },
          "20180420": {
            "id": "20180420",
            "speakerId": 3053,
            "speakerName": "九条孝行",
            "text": "毕竟——",
            "nextDialogs": [
              "20180421"
            ]
          },
          "20180421": {
            "id": "20180421",
            "speakerId": 3053,
            "speakerName": "九条孝行",
            "text": "我们可拥有着天下无双的雷电将军，拥有着那「无想的一刀」啊！",
            "nextDialogs": [
              "20180424"
            ]
          },
          "20180424": {
            "id": "20180424",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "嗯…他崇拜的与其说是雷电将军，倒不如说是雷电将军的武艺以及「无想的一刀」吧？而且，已经近乎狂热了…",
            "nextDialogs": [
              "20180425"
            ]
          },
          "20180425": {
            "id": "20180425",
            "speakerId": 1038,
            "speakerName": "九条裟罗",
            "text": "可是，你的忠义之心呢，家主…",
            "nextDialogs": [
              "20180426"
            ]
          },
          "20180426": {
            "id": "20180426",
            "speakerId": 1038,
            "speakerName": "九条裟罗",
            "text": "自从被九条家收养以来，是你一直在教导我身为臣下的忠义之道…",
            "nextDialogs": [
              "20180427"
            ]
          },
          "20180427": {
            "id": "20180427",
            "speakerId": 1038,
            "speakerName": "九条裟罗",
            "text": "如此看来，你们只是想我忠于九条家，担心我有朝一日会背叛而已吧？",
            "nextDialogs": [
              "20180428"
            ]
          },
          "20180428": {
            "id": "20180428",
            "speakerId": 1038,
            "speakerName": "九条裟罗",
            "text": "那些大道理，不过是你遮掩自己的丑恶与自私的工具！",
            "nextDialogs": [
              "20180429"
            ]
          },
          "20180429": {
            "id": "20180429",
            "speakerId": 3053,
            "speakerName": "九条孝行",
            "text": "自私？我也是在守护着属于九条家的永恒啊，我相信将军大人她会理解我的，前家主大人他…也一定会理解我的。",
            "nextDialogs": [
              "20180430"
            ]
          },
          "20180430": {
            "id": "20180430",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "虽然不想这么说，但九条家也太自大了，愚人众恐怕没那么好对付…"
          }
        }
      }
    },
    {
      "subId": "201850",
      "subQuestName": "Additional",
      "sceneId": null,

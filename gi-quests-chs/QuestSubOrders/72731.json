    {
      "subId": "7273102",
      "subQuestName": "与荒泷一斗对话",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "727310201"
        ],
        "dialogs": {
          "727310201": {
            "id": "727310201",
            "speakerId": 13019,
            "speakerName": "「花角玉将」",
            "text": "哈哈哈哈哈哈哈…",
            "nextDialogs": [
              "727310202"
            ]
          },
          "727310202": {
            "id": "727310202",
            "speakerId": 13019,
            "speakerName": "「花角玉将」",
            "text": "尽兴！",
            "nextDialogs": [
              "727310203"
            ]
          },
          "727310203": {
            "id": "727310203",
            "speakerId": 1044,
            "speakerName": "荒泷一斗",
            "text": "哈哈哈哈哈哈哈…",
            "nextDialogs": [
              "727310204"
            ]
          },
          "727310204": {
            "id": "727310204",
            "speakerId": 1044,
            "speakerName": "荒泷一斗",
            "text": "痛快！",
            "nextDialogs": [
              "727310205"
            ]
          },
          "727310205": {
            "id": "727310205",
            "speakerId": 13019,
            "speakerName": "「花角玉将」",
            "text": "尽管斗虫的风格与我不同，但你倾注在鬼兜虫身上的一腔热血，让我找到了强烈的共鸣。",
            "nextDialogs": [
              "727310206"
            ]
          },
          "727310206": {
            "id": "727310206",
            "speakerId": 13019,
            "speakerName": "「花角玉将」",
            "text": "假以时日，你必定能成为斗虫界的佼佼者。",
            "nextDialogs": [
              "727310207"
            ]
          },
          "727310207": {
            "id": "727310207",
            "speakerId": 1044,
            "speakerName": "荒泷一斗",
            "text": "你也不赖！整整一千一百四十一场较量，居然能勉强战胜本大爷五百七十场。",
            "nextDialogs": [
              "727310208"
            ]
          },
          "727310208": {
            "id": "727310208",
            "speakerId": 1044,
            "speakerName": "荒泷一斗",
            "text": "和本大爷拉锯百场以上的对手里，你最有毅力，不得不说，你让本大爷刮目相看了！",
            "nextDialogs": [
              "727310209"
            ]
          },
          "727310209": {
            "id": "727310209",
            "speakerId": 13019,
            "speakerName": "「花角玉将」",
            "text": "是五百七十一场，我赢的次数更多哦。考虑到客场作战的因素，本来应该是我占上风。",
            "nextDialogs": [
              "727310210"
            ]
          },
          "727310210": {
            "id": "727310210",
            "speakerId": 1044,
            "speakerName": "荒泷一斗",
            "text": "嘿？怎么了你？这种时候还嘴硬？本大爷记得清清楚楚，阿守也可以作证！",
            "nextDialogs": [
              "727310211"
            ]
          },
          "727310211": {
            "id": "727310211",
            "speakerId": 1044,
            "speakerName": "荒泷一斗",
            "text": "你说是吧，阿守？",
            "nextDialogs": [
              "727310212"
            ]
          },
          "727310212": {
            "id": "727310212",
            "speakerId": 12278,
            "speakerName": "阿守",
            "text": "老大…我，我实在撑不住了…让我睡一会儿吧。",
            "nextDialogs": [
              "727310213"
            ]
          },
          "727310213": {
            "id": "727310213",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "呜哇，难道这段时间，他们一直在这里斗虫，完全没有休息吗？",
            "nextDialogs": [
              "727310214"
            ]
          },
          "727310214": {
            "id": "727310214",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "他们一直在这里斗虫，完全没有休息吗？",
            "nextDialogs": [
              "727310217"
            ]
          },
          "727310217": {
            "id": "727310217",
            "speakerId": 1044,
            "speakerName": "荒泷一斗",
            "text": "行！本大爷宽宏大量，让你一局也无所谓，反正接下来，本大爷还会赢回来的！",
            "nextDialogs": [
              "727310218"
            ]
          },
          "727310218": {
            "id": "727310218",
            "speakerId": 1044,
            "speakerName": "荒泷一斗",
            "text": "看你不服气的样子，之后的较量，就去你的主场吧。本大爷要让你明白，场地没什么影响，关键还是斗虫的人！",
            "nextDialogs": [
              "727310219"
            ]
          },
          "727310219": {
            "id": "727310219",
            "speakerId": 13019,
            "speakerName": "「花角玉将」",
            "text": "正合我意，且随我来。",
            "nextDialogs": [
              "727310220"
            ]
          },
          "727310220": {
            "id": "727310220",
            "speakerId": 1044,
            "speakerName": "荒泷一斗",
            "text": "嗯？我的挚友和飞行矮堇瓜，你们可算来了！",
            "nextDialogs": [
              "727310221"
            ]
          },
          "727310221": {
            "id": "727310221",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "怎么又变回飞行矮堇瓜了，难道我不帮你斗虫的时候，你就只能想起难听的外号吗？",
            "nextDialogs": [
              "727310222"
            ]
          },
          "727310222": {
            "id": "727310222",
            "speakerId": 1044,
            "speakerName": "荒泷一斗",
            "text": "这个先放一边！说好要给你们的两月份免费拉面优惠券，拿着吧！",
            "nextDialogs": [
              "727310223"
            ]
          },
          "727310223": {
            "id": "727310223",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "拉面优惠券？对哦，拉面！",
            "nextDialogs": [
              "727310224"
            ]
          },
          "727310224": {
            "id": "727310224",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "这样才像话嘛，还算你识相！"
          }
        }
      }
    },
    {
      "subId": "7273199",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "727319902"
        ],
        "dialogs": {
          "727319902": {
            "id": "727319902",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "上次打败「花角玉将」后，放牛的好像说过，还要和他继续切磋几场来着？"
          }
        }
      }
    }
  ]

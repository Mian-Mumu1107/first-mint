    {
      "subId": "7273101",
      "subQuestName": "与荒泷一斗对话",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "727310701"
        ],
        "dialogs": {
          "727310701": {
            "id": "727310701",
            "speakerId": 13019,
            "speakerName": "「花角玉将」",
            "text": "原来如此，原来如此啊…再打一场吧，我一定能看透你斗虫的门道。",
            "nextDialogs": [
              "727310702"
            ]
          },
          "727310702": {
            "id": "727310702",
            "speakerId": 13019,
            "speakerName": "「花角玉将」",
            "text": "比试的胜负似乎已经没那么重要了，我们就斗个爽快，如何？",
            "nextDialogs": [
              "727310703"
            ]
          },
          "727310703": {
            "id": "727310703",
            "speakerId": 13019,
            "speakerName": "「花角玉将」",
            "text": "难得有这么合拍的对手，短短几分钟就结束，未免也太不尽兴了？",
            "nextDialogs": [
              "727310704"
            ]
          },
          "727310704": {
            "id": "727310704",
            "speakerId": 1044,
            "speakerName": "荒泷一斗",
            "text": "哈！来就来！",
            "nextDialogs": [
              "727310705"
            ]
          },
          "727310705": {
            "id": "727310705",
            "speakerId": 1044,
            "speakerName": "荒泷一斗",
            "text": "不过…看穿本大爷斗虫的秘技？你可别痴心妄想啊！",
            "nextDialogs": [
              "727310706"
            ]
          },
          "727310706": {
            "id": "727310706",
            "speakerId": 1044,
            "speakerName": "荒泷一斗",
            "text": "如果你肯承认，是我斗虫的本领更强，无论斗多少场，我都会奉陪到底！",
            "nextDialogs": [
              "727310707"
            ]
          },
          "727310707": {
            "id": "727310707",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "唔，放牛的和「花角玉将」还是热血沸腾呢，就让他们继续斗虫吧，斗到他们完全满足！"
          }
        }
      }
    },
    {
      "subId": "7273104",

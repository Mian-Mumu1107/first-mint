    {
      "subId": "201402",
      "subQuestName": "与派蒙对话$HIDDEN",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "20140201"
        ],
        "dialogs": {
          "20140201": {
            "id": "20140201",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "应该就是这里了。不过，确实没看到什么可疑的家伙…",
            "nextDialogs": [
              "20140202"
            ]
          },
          "20140202": {
            "id": "20140202",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "#难道说是躲起来了吗？{NICKNAME}，我们在附近搜寻一下吧。",
            "nextDialogs": [
              "20140203"
            ]
          },
          "20140203": {
            "id": "20140203",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "这些<color=#00E1FFFF>雷元素方碑</color>，感觉有些可疑…"
          }
        }
      }
    },

    "瑾武": 25
  },
  "subQuests": [
    {
      "subId": "7108802",
      "subQuestName": "",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "710880201"
        ],
        "dialogs": {
          "710880201": {
            "id": "710880201",
            "speakerId": 2618,
            "speakerName": "海迪夫",
            "text": "你好！啊，原来是你呀！",
            "nextDialogs": [
              "710880221"
            ]
          },
          "710880221": {
            "id": "710880221",
            "speakerId": 2618,
            "speakerName": "海迪夫",
            "text": "哈，他们还真把你给找来了。",
            "nextDialogs": [
              "710880204"
            ]
          },
          "710880204": {
            "id": "710880204",
            "speakerId": 2618,
            "speakerName": "海迪夫",
            "text": "哎哟，失礼失礼！我叫海迪夫，海迪夫·普尔希纳。",
            "nextDialogs": [
              "710880205"
            ]
          },
          "710880205": {
            "id": "710880205",
            "speakerId": 2618,
            "speakerName": "海迪夫",
            "text": "哈哈，如果你了解学院历史的话，我们的祖师们在星相学上曾是普尔比鲁尼一系的宿敌。"
          }
        }
      }
    },
    {
      "subId": "7108803",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "710880301"
        ],
        "dialogs": {
          "710880301": {
            "id": "710880301",
            "speakerId": 20580,
            "speakerName": "瑾武",
            "text": "哟，是新面孔，你好，年轻人！",
            "nextDialogs": [
              "710880302"
            ]
          },
          "710880302": {
            "id": "710880302",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "新面孔？",
            "nextDialogs": [
              "710880303"
            ]
          },
          "710880303": {
            "id": "710880303",
            "speakerId": 20580,
            "speakerName": "瑾武",
            "text": "哈哈…矿上的每一个人不好说认识吧，至少都能叫得出名字。不过你嘛…是第一次来矿上，对吧？",
            "nextDialogs": [
              "710880304"
            ]
          },
          "710880304": {
            "id": "710880304",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "#{NICKNAME}，幸会。",
            "nextDialogs": [
              "710880305"
            ]
          },
          "710880305": {
            "id": "710880305",
            "speakerId": 20580,
            "speakerName": "瑾武",
            "text": "瑾武，管设备的。在矿上干了二十来年，算是这帮小伙子的大姐。有什么不懂的可以来找我，设备出毛病了找我也行。",
            "nextDialogs": [
              "710880306"
            ]
          },
          "710880306": {
            "id": "710880306",
            "speakerId": 20580,
            "speakerName": "瑾武",
            "text": "或者，单纯听大姐闲扯两句历史故事什么的，我也欢迎。闲着也是闲着嘛。",
            "nextDialogs": [
              "710880308",
              "710880317",
              "710880324",
              "710880327"
            ]
          },
          "710880308": {
            "id": "710880308",
            "speakerId": 20580,
            "speakerName": "瑾武",
            "text": "那可就说来话长了…我就给你简短介绍一下吧。",
            "nextDialogs": [
              "710880309"
            ]
          },
          "710880309": {
            "id": "710880309",
            "speakerId": 20580,
            "speakerName": "瑾武",
            "text": "层岩巨渊是璃月最大的矿产基地，也是天衡山矿区之后第二古老的矿区。",
            "nextDialogs": [
              "710880310"
            ]
          },
          "710880310": {
            "id": "710880310",
            "speakerId": 20580,
            "speakerName": "瑾武",
            "text": "传说在岩王爷到来之前，这里就居住着以开采琉璃晶砂、交易陶瓷制成品为生的部族…",
            "nextDialogs": [
              "710880311"
            ]
          },
          "710880311": {
            "id": "710880311",
            "speakerId": 20580,
            "speakerName": "瑾武",
            "text": "后来这些部族与岩王爷的夜叉信使歃血为盟，自成一支，于是便成为了今日八门之一——盛露厅的前身。",
            "nextDialogs": [
              "710880312"
            ]
          },
          "710880312": {
            "id": "710880312",
            "speakerId": 20580,
            "speakerName": "瑾武",
            "text": "他们也参加了镇压若陀龙王与击退漆黑灾祸的大战…可谓劳苦功高。",
            "nextDialogs": [
              "710880313"
            ]
          },
          "710880313": {
            "id": "710880313",
            "speakerId": 20580,
            "speakerName": "瑾武",
            "text": "你看，西北面的那座谷地…传说就是当年岩王爷将若陀龙王拖离层岩巨渊，活生生拖出来的痕迹呢。",
            "nextDialogs": [
              "710880314"
            ]
          },
          "710880314": {
            "id": "710880314",
            "speakerId": 20580,
            "speakerName": "瑾武",
            "text": "后来呀，待到褪尽蛮荒，习惯了城市生活的部民便随岩王爷迁入城中，专以制造和贩卖瓷器为业，不再顾兵戈之事了。",
            "nextDialogs": [
              "710880315"
            ]
          },
          "710880315": {
            "id": "710880315",
            "speakerId": 20580,
            "speakerName": "瑾武",
            "text": "哈哈…所以别看盛露厅如今都是些斤斤计较的瓷器商人，祖上也是同岩王爷并肩打过硬仗的。"
          },
          "710880317": {
            "id": "710880317",
            "speakerId": 20580,
            "speakerName": "瑾武",
            "text": "几年前矿区封锁时我也在场，听说下层的小伙子们挖到了不得了的东西。",
            "nextDialogs": [
              "710880318"
            ]
          },
          "710880318": {
            "id": "710880318",
            "speakerId": 20580,
            "speakerName": "瑾武",
            "text": "我光记得那时候伤员被接连不断地运上地面…",
            "nextDialogs": [
              "710880319"
            ]
          },
          "710880319": {
            "id": "710880319",
            "speakerId": 20580,
            "speakerName": "瑾武",
            "text": "更邪门的是，小伙子们受的伤并不是矿下面常见的工伤，而是…呃，有点像精神上的打击，你懂吧？",
            "nextDialogs": [
              "710880320"
            ]
          },
          "710880320": {
            "id": "710880320",
            "speakerId": 20580,
            "speakerName": "瑾武",
            "text": "把小伙子们送到地面之后，他们过几天就慢慢恢复正常了…虽然没造成什么严重损失，但还是引起了七星的震动。",
            "nextDialogs": [
              "710880321"
            ]
          },
          "710880321": {
            "id": "710880321",
            "speakerId": 20580,
            "speakerName": "瑾武",
            "text": "不管他们挖到了什么，一定不是什么好东西就对了。玉京台的大人们可能也是这样想的…就全面封锁了层岩巨渊。",
            "nextDialogs": [
              "710880322"
            ]
          },
          "710880322": {
            "id": "710880322",
            "speakerId": 20580,
            "speakerName": "瑾武",
            "text": "结果呢，盛露厅可不高兴了…哈哈，那就是另一个话题咯。"
          },
          "710880324": {
            "id": "710880324",
            "speakerId": 20580,
            "speakerName": "瑾武",
            "text": "我？管设备的。二十来年了，别人家孩子上学的年纪我就在鼓捣晶石矿灯和滤水器了，没什么好说的。",
            "nextDialogs": [
              "710880325"
            ]
          },
          "710880325": {
            "id": "710880325",
            "speakerId": 20580,
            "speakerName": "瑾武",
            "text": "#{M#认识了一拨又一拨矿工，初次下矿时也比你大不了多少。}{F#女孩子可不要做这种工作，像我一样把大好时光浪费在矿上，整天一身臭汗忙来忙去，不值得的。}"
          },
          "710880327": {
            "id": "710880327",
            "speakerId": 20580,
            "speakerName": "瑾武",
            "text": "那是「七星」专门设立的阵法，为的就是防君子不防…哈哈，不开玩笑了。",
            "nextDialogs": [
              "710880328"
            ]
          },
          "710880328": {
            "id": "710880328",
            "speakerId": 20580,
            "speakerName": "瑾武",
            "text": "总之，这阵法在行政上是最高级别的封印，任何人看到它就会自然想到，擅自解封的话，要面临什么样的问责。",
            "nextDialogs": [
              "710880329"
            ]
          },
          "710880329": {
            "id": "710880329",
            "speakerId": 20580,
            "speakerName": "瑾武",
            "text": "所以呢，「七星」专门以过于显眼的「磐键」作为固定阵法的节点，也是为了显示权威…",
            "nextDialogs": [
              "710880330"
            ]
          },
          "710880330": {
            "id": "710880330",
            "speakerId": 20580,
            "speakerName": "瑾武",
            "text": "让小贼们即使有贼心，也没有贼胆大张旗鼓地解除封印，引得大人物震怒。",
            "nextDialogs": [
              "710880331"
            ]
          },
          "710880331": {
            "id": "710880331",
            "speakerId": 20580,
            "speakerName": "瑾武",
            "text": "咳咳…换句话说，如果有人真的解除了封印，而没有受到有效干涉…就证明那家伙至少得到了「七星」的默许。"
          }
        }
      }
    }
  ]
}
    {
      "subId": "7350801",
      "subQuestName": "与海妮耶和贝尔福对话",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "735080101"
        ],
        "dialogs": {
          "735080101": {
            "id": "735080101",
            "speakerId": 30253,
            "speakerName": "贝尔福",
            "text": "#这些天来多谢你们了，「黄金流星」{NICKNAME}和「白银伴星」！",
            "nextDialogs": [
              "735080102"
            ]
          },
          "735080102": {
            "id": "735080102",
            "speakerId": 30253,
            "speakerName": "贝尔福",
            "text": "我记录下了你们每次游玩「灵蕈棋阵」的过程，根据你们的游玩记录，可以得出许多数据。",
            "nextDialogs": [
              "735080103"
            ]
          },
          "735080103": {
            "id": "735080103",
            "speakerId": 30253,
            "speakerName": "贝尔福",
            "text": "你们属于「顶尖水准」的试玩者，将你们的记录和普通试玩者的相结合，就能分析出稳妥的改进方案。",
            "nextDialogs": [
              "735080104"
            ]
          },
          "735080104": {
            "id": "735080104",
            "speakerId": 12855,
            "speakerName": "海妮耶",
            "text": "当然，最后还要请你们发表关于总体风格的建议。",
            "nextDialogs": [
              "735080105"
            ]
          },
          "735080105": {
            "id": "735080105",
            "speakerId": 12855,
            "speakerName": "海妮耶",
            "text": "你们的反馈不止对「灵蕈棋阵」这个游戏有正面意义，还在一定程度上影响着下一届大赛的玩法。",
            "nextDialogs": [
              "735080106"
            ]
          },
          "735080106": {
            "id": "735080106",
            "speakerId": 30253,
            "speakerName": "贝尔福",
            "text": "还请你们大概说说自己的倾向。比如…是更重视趣味性，还是竞技性呢？",
            "nextDialogs": [
              "735080108",
              "735080113",
              "735080118"
            ]
          },
          "735080108": {
            "id": "735080108",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "对哦！比赛和对抗确实很重要，不过，我们希望之后的挑战更能考验我们和蕈兽伙伴的默契！",
            "nextDialogs": [
              "735080109"
            ]
          },
          "735080109": {
            "id": "735080109",
            "speakerId": 12855,
            "speakerName": "海妮耶",
            "text": "和蕈兽伙伴们的默契吗…我明白了。",
            "nextDialogs": [
              "735080110"
            ]
          },
          "735080110": {
            "id": "735080110",
            "speakerId": 12855,
            "speakerName": "海妮耶",
            "text": "贝尔福先生，记得我之前和你说过的，最重要的理念吧？",
            "nextDialogs": [
              "735080111"
            ]
          },
          "735080111": {
            "id": "735080111",
            "speakerId": 30253,
            "speakerName": "贝尔福",
            "text": "理解！下次大赛，我会争取设计一些考验你们配合的挑战，让你们和蕈兽伙伴在高效的沟通中发挥全力！",
            "nextDialogs": [
              "735080121"
            ]
          },
          "735080121": {
            "id": "735080121",
            "speakerId": 12855,
            "speakerName": "海妮耶",
            "text": "你们两位还真是一点都没变呢…",
            "nextDialogs": [
              "735080122"
            ]
          },
          "735080122": {
            "id": "735080122",
            "speakerId": 12855,
            "speakerName": "海妮耶",
            "text": "总之，这样一来，本次「灵蕈棋阵」的测试就大功告成了。"
          },
          "735080113": {
            "id": "735080113",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "嗯！这次和蕈兽伙伴们见面后，我更加确定了，我们和蕈兽伙伴们之间的默契，只会变强，不会被时间冲淡！",
            "nextDialogs": [
              "735080114"
            ]
          },
          "735080114": {
            "id": "735080114",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "下次再和蕈兽伙伴们一起参赛时，我们的配合不知道会有多厉害，肯定要用华丽的战斗体现出来！",
            "nextDialogs": [
              "735080115"
            ]
          },
          "735080115": {
            "id": "735080115",
            "speakerId": 12855,
            "speakerName": "海妮耶",
            "text": "原来如此，你们觉得适当的挑战，可以展现出蕈兽伙伴的全部实力。",
            "nextDialogs": [
              "735080116"
            ]
          },
          "735080116": {
            "id": "735080116",
            "speakerId": 30253,
            "speakerName": "贝尔福",
            "text": "那下次比赛，就要适当增加一些挑战性的内容了！"
          },
          "735080118": {
            "id": "735080118",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "嗯！不管怎么样，只要能和蕈兽伙伴们一起玩，一起通过考验，战胜困难，我们就很开心啦！",
            "nextDialogs": [
              "735080119"
            ]
          },
          "735080119": {
            "id": "735080119",
            "speakerId": 12855,
            "speakerName": "海妮耶",
            "text": "明白了，乐趣和挑战并存，这句话说着简单，不过做起来很难…",
            "nextDialogs": [
              "735080120"
            ]
          },
          "735080120": {
            "id": "735080120",
            "speakerId": 30253,
            "speakerName": "贝尔福",
            "text": "都交给我了，我会尽全力拿出让你们满意的方案的！"
          }
        }
      }
    },
    {
      "subId": "7350899",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "735089901"
        ],
        "dialogs": {
          "735089901": {
            "id": "735089901",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "嗯，时间刚刚好，我们也好好体验了「灵蕈棋阵」。",
            "nextDialogs": [
              "735089902"
            ]
          },
          "735089902": {
            "id": "735089902",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "差不多该去找海妮耶和贝尔福，给他们一些反馈了吧！"
          }
        }
      }
    }
  ]
}
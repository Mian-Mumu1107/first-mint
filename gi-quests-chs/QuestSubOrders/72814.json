        "dialogs": {
          "728140101": {
            "id": "728140101",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "什么创意美食？",
            "nextDialogs": [
              "728140102"
            ]
          },
          "728140102": {
            "id": "728140102",
            "speakerId": 30751,
            "speakerName": "智树",
            "text": "被摇滚乐腌渍的团子牛奶——摇滚团子牛奶！来，送你一个。",
            "nextDialogs": [
              "728140103"
            ]
          },
          "728140103": {
            "id": "728140103",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "只是普通的团子牛奶吧？",
            "nextDialogs": [
              "728140104"
            ]
          },
          "728140104": {
            "id": "728140104",
            "speakerId": 30751,
            "speakerName": "智树",
            "text": "可不能这么说，至少我特地给普通的团子牛奶听了一段时间的摇滚乐。",
            "nextDialogs": [
              "728140105"
            ]
          },
          "728140105": {
            "id": "728140105",
            "speakerId": 30751,
            "speakerName": "智树",
            "text": "所以口味也变成了，普通的团子牛奶放了一段时间之后的口味。",
            "nextDialogs": [
              "728140106"
            ]
          },
          "728140106": {
            "id": "728140106",
            "speakerId": 30751,
            "speakerName": "智树",
            "text": "这样一来，有些客人愿意为此付出比普通的团子牛奶多一倍的价格。",
            "nextDialogs": [
              "728140107"
            ]
          },
          "728140107": {
            "id": "728140107",
            "speakerId": 30751,
            "speakerName": "智树",
            "text": "这就是摇滚乐的魅力吗？真是妙不可言！"
          }
        }

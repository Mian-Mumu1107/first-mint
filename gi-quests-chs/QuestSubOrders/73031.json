  "subQuests": [
    {
      "subId": "7303102",
      "subQuestName": "",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "730310201"
        ],
        "dialogs": {
          "730310201": {
            "id": "730310201",
            "speakerId": 1000,
            "speakerName": "兰罗摩",
            "text": "无忧节的准备，应该差不多要好了。还要准备一段时间！",
            "nextDialogs": [
              "730310202"
            ]
          },
          "730310202": {
            "id": "730310202",
            "speakerId": 1001,
            "speakerName": "兰拉迦",
            "text": "#嗯，多亏了那菈{NICKNAME}和派蒙帮忙。无忧节终于快要开始了。真期待呢…"
          }
        }
      }
    },
    {
      "subId": "7303103",
      "subQuestName": "",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "730310301"
        ],
        "dialogs": {
          "730310301": {
            "id": "730310301",
            "speakerId": 1002,
            "speakerName": "派蒙",
            "text": "兰拉迦、兰罗摩，我们回来啦！",
            "nextDialogs": [
              "730310302"
            ]
          },
          "730310302": {
            "id": "730310302",
            "speakerId": 1000,
            "speakerName": "兰罗摩",
            "text": "#又见到那菈{NICKNAME}和派蒙了！真开心。",
            "nextDialogs": [
              "730310303"
            ]
          },
          "730310303": {
            "id": "730310303",
            "speakerId": 1001,
            "speakerName": "兰拉迦",
            "text": "#哎呀，你们回来了。大家都在说，有个好高大、好厉害的那菈{NICKNAME}，帮了他们很多很多。大家都很开心。",
            "nextDialogs": [
              "730310304"
            ]
          },
          "730310304": {
            "id": "730310304",
            "speakerId": 1002,
            "speakerName": "派蒙",
            "text": "#有人帮忙干活确实很开心呢！对吧，{NICKNAME}？",
            "nextDialogs": [
              "730310307"
            ]
          },
          "730310307": {
            "id": "730310307",
            "speakerId": 1001,
            "speakerName": "兰拉迦",
            "text": "不是的。他们开心，是因为认识了新朋友。虽然兰纳真、兰纳迦和兰迦鲁都不记得了，但森林会记住一切。故事不会彻底失落。",
            "nextDialogs": [
              "730310308"
            ]
          },
          "730310308": {
            "id": "730310308",
            "speakerId": 1002,
            "speakerName": "派蒙",
            "text": "噢…",
            "nextDialogs": [
              "730310309"
            ]
          },
          "730310309": {
            "id": "730310309",
            "speakerId": 1000,
            "speakerName": "兰罗摩",
            "text": "无忧节的准备，应该差不多要好了。我好期待！"
          }
        }
      }
    },
    {
      "subId": "7303106",
      "subQuestName": "",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "730310601"
        ],
        "dialogs": {
          "730310601": {
            "id": "730310601",
            "speakerId": 1002,
            "speakerName": "派蒙",
            "text": "拉娜看起来…",
            "nextDialogs": [
              "730310602"
            ]
          },
          "730310602": {
            "id": "730310602",
            "speakerId": 1002,
            "speakerName": "派蒙",
            "text": "其实我想说「睡得好香」，但这么说好像不太好…？",
            "nextDialogs": [
              "730310603"
            ]
          },
          "730310603": {
            "id": "730310603",
            "speakerId": 1003,
            "speakerName": "拉娜",
            "text": "（从包裹拉娜的「气泡」当中隐约有什么景象浮现出来…）",
            "nextDialogs": [
              "730310604"
            ]
          },
          "730310604": {
            "id": "730310604",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "（沉浸到景象中去…）",
            "nextDialogs": [
              "730310605"
            ]
          },
          "730310605": {
            "id": "730310605",
            "speakerId": 1004,
            "speakerName": "Black Screen",
            "text": "你身处丛林当中，一切都是无比巨大，又无比幽深。但你在其中十分自在。\\n偶然透过树叶洒落的阳光如同金箔一般闪闪发亮，如同你一般高的野草低声地嬉笑着，在你走过时轻轻触碰你的手。",
            "nextDialogs": [
              "730310606"
            ]
          },
          "730310606": {
            "id": "730310606",
            "speakerId": 1004,
            "speakerName": "Black Screen",
            "text": "聆听风中树木的哼唱与流水的奏乐时，你注意到了不安的哭声。循着声音，你找到了一个小小的人儿。\\n似乎是因为哭得累了，她趴在草甸中睡着了。你走到她的身边，轻轻唱起了能令生灵平静的歌…",
            "nextDialogs": [
              "730310607"
            ]
          },
          "730310607": {
            "id": "730310607",
            "speakerId": 1002,
            "speakerName": "派蒙",
            "text": "#…喂！{NICKNAME}，你怎么了？",
            "nextDialogs": [
              "730310608"
            ]
          },
          "730310608": {
            "id": "730310608",
            "speakerId": 1002,
            "speakerName": "派蒙",
            "text": "你没事就好…看你的样子，我还以为要晕过去了…担心死了…",
            "nextDialogs": [
              "730310609"
            ]
          },
          "730310609": {
            "id": "730310609",
            "speakerId": 1005,
            "speakerName": "兰拉娜",
            "text": "#那菈{NICKNAME}！你们来了！",
            "nextDialogs": [
              "730310610"
            ]
          },
          "730310610": {
            "id": "730310610",
            "speakerId": 1002,
            "speakerName": "派蒙",
            "text": "哇！吓我一跳！",
            "nextDialogs": [
              "730310611"
            ]
          },
          "730310611": {
            "id": "730310611",
            "speakerId": 1005,
            "speakerName": "兰拉娜",
            "text": "哇！",
            "nextDialogs": [
              "730310614"
            ]
          },
          "730310614": {
            "id": "730310614",
            "speakerId": 1002,
            "speakerName": "派蒙",
            "text": "真是的，你们兰那罗怎么总是这样神出鬼没啦！",
            "nextDialogs": [
              "730310615"
            ]
          },
          "730310615": {
            "id": "730310615",
            "speakerId": 1005,
            "speakerName": "兰拉娜",
            "text": "白毛飞飞才是，怎么突然「哇」！",
            "nextDialogs": [
              "730310616"
            ]
          },
          "730310616": {
            "id": "730310616",
            "speakerId": 1002,
            "speakerName": "派蒙",
            "text": "我叫派蒙，才不是什么白毛飞飞！",
            "nextDialogs": [
              "730310617"
            ]
          },
          "730310617": {
            "id": "730310617",
            "speakerId": 1005,
            "speakerName": "兰拉娜",
            "text": "兰拉娜在地里面，维持兰迦拉梨的力量。这样的话，那菈拉娜就不会枯萎。但是，要重新变得强壮，还是需要惟耶之实。",
            "nextDialogs": [
              "730310618"
            ]
          },
          "730310618": {
            "id": "730310618",
            "speakerId": 1002,
            "speakerName": "派蒙",
            "text": "#原来如此。不过，这么说来，{NICKNAME}之前怎么了来着…？",
            "nextDialogs": [
              "730310619"
            ]
          },
          "730310619": {
            "id": "730310619",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "（说明了感受到的景象…）",
            "nextDialogs": [
              "730310620"
            ]
          },
          "730310620": {
            "id": "730310620",
            "speakerId": 1005,
            "speakerName": "兰拉娜",
            "text": "应该，是兰拉娜的回忆。",
            "nextDialogs": [
              "730310621"
            ]
          },
          "730310621": {
            "id": "730310621",
            "speakerId": 1002,
            "speakerName": "派蒙",
            "text": "回忆…？",
            "nextDialogs": [
              "730310622"
            ]
          },
          "730310622": {
            "id": "730310622",
            "speakerId": 1005,
            "speakerName": "兰拉娜",
            "text": "派蒙不知道。回忆和梦是兰那罗的力量，最珍贵的东西。有梦和回忆，兰拉娜就能用兰迦拉梨，帮助需要帮助的那菈和兰那罗。",
            "nextDialogs": [
              "730310623"
            ]
          },
          "730310623": {
            "id": "730310623",
            "speakerId": 1005,
            "speakerName": "兰拉娜",
            "text": "#有的那菈，能感觉到兰迦拉梨里的记忆。看来那菈{NICKNAME}能感觉到。",
            "nextDialogs": [
              "730310624"
            ]
          },
          "730310624": {
            "id": "730310624",
            "speakerId": 1002,
            "speakerName": "派蒙",
            "text": "这么一听，就感觉兰迦拉梨是很庄重的事情呢！之前，在那个洞窟里，用兰迦拉梨保护优丹的也是兰拉娜吧？",
            "nextDialogs": [
              "730310625"
            ]
          },
          "730310625": {
            "id": "730310625",
            "speakerId": 1005,
            "speakerName": "兰拉娜",
            "text": "是兰拉娜。那菈优丹、那菈卡乌斯、那菈素达蓓都是兰拉娜的朋友。所以，兰拉娜保护他们。",
            "nextDialogs": [
              "730310626"
            ]
          },
          "730310626": {
            "id": "730310626",
            "speakerId": 1005,
            "speakerName": "兰拉娜",
            "text": "他们经常到森林里，和兰拉娜一起玩。兰拉娜教他们森林的知识、花草的语言。是很重要的朋友，和那菈拉娜一样。",
            "nextDialogs": [
              "730310627"
            ]
          },
          "730310627": {
            "id": "730310627",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "关于孩子失踪的事情…",
            "nextDialogs": [
              "730310628"
            ]
          },
          "730310628": {
            "id": "730310628",
            "speakerId": 1002,
            "speakerName": "派蒙",
            "text": "对！说起这个，在优丹之前，卡乌斯和素达蓓也失踪过…但是，后来又被送回了维摩庄。这也是兰拉娜做的吗？",
            "nextDialogs": [
              "730310629"
            ]
          },
          "730310629": {
            "id": "730310629",
            "speakerId": 1005,
            "speakerName": "兰拉娜",
            "text": "嗯。兰拉娜发现，坏那菈和那菈巴螺迦带走他们。所以，兰拉娜就趁坏那菈不知道，帮助那菈卡乌斯和那菈素达蓓，带他们走。"
          }
        }
      }
    },

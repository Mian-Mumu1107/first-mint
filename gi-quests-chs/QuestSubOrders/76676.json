        "dialogs": {
          "766760101": {
            "id": "766760101",
            "speakerId": 1000,
            "speakerName": "努斯妲",
            "text": "鼓掌鼓掌！活动进行到现在，可以说，已经到了完美境界！",
            "nextDialogs": [
              "766760102"
            ]
          },
          "766760102": {
            "id": "766760102",
            "speakerId": 1000,
            "speakerName": "努斯妲",
            "text": "好几位须弥朋友们学会了纳塔风格的舞蹈，我看到了我们的舞蹈走向全提瓦特的潜力！",
            "nextDialogs": [
              "766760103"
            ]
          },
          "766760103": {
            "id": "766760103",
            "speakerId": 1000,
            "speakerName": "努斯妲",
            "text": "期待之后，我们两边的「舞术交流」常态化，每隔一段时间，都稳定互访！",
            "nextDialogs": [
              "766760104"
            ]
          },
          "766760104": {
            "id": "766760104",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "那，纳塔的龙龙们也能像「镀金旅团」一样大耍刀舞了嘛？",
            "nextDialogs": [
              "766760107"
            ]
          },
          "766760107": {
            "id": "766760107",
            "speakerId": 1002,
            "speakerName": "塔拉内",
            "text": "啊？说的难道是…努斯妲她们最初见到弯刀叔叔时，弯刀叔叔他们用来吓退那些圣骸赤鹫的示威动作？",
            "nextDialogs": [
              "766760108"
            ]
          },
          "766760108": {
            "id": "766760108",
            "speakerId": 1002,
            "speakerName": "塔拉内",
            "text": "弯刀叔叔没和你们说明吗？那些动作的来源？",
            "nextDialogs": [
              "766760109"
            ]
          },
          "766760109": {
            "id": "766760109",
            "speakerId": 1000,
            "speakerName": "努斯妲",
            "text": "有说啊，那支舞不是叫…「炽鬃之狮与苍鹭之守的二重奏」来着吗？是个优美与力量感并重的名字！",
            "nextDialogs": [
              "766760110"
            ]
          },
          "766760110": {
            "id": "766760110",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "好，好熟悉两个称号！"
          }
        }
      }
    }
  ]
}
    {
      "subId": "7452404",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "745240401"
        ],
        "dialogs": {
          "745240401": {
            "id": "745240401",
            "speakerId": 1034,
            "speakerName": "八重神子",
            "text": "哎呀，这不是小家伙吗？难道是打听到了我今天的行程，特意来这里见我？",
            "nextDialogs": [
              "745240404"
            ]
          },
          "745240404": {
            "id": "745240404",
            "speakerId": 1034,
            "speakerName": "八重神子",
            "text": "呵呵，鼻子还挺灵。不过是给某位不爱出门的友人带了些甜点，和时下最热门的轻小说罢了。",
            "nextDialogs": [
              "745240405"
            ]
          },
          "745240405": {
            "id": "745240405",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "影也开始追更了？",
            "nextDialogs": [
              "745240406"
            ]
          },
          "745240406": {
            "id": "745240406",
            "speakerId": 1034,
            "speakerName": "八重神子",
            "text": "她的说法是，想借此了解稻妻民众近来的娱乐生活和喜好变化。",
            "nextDialogs": [
              "745240407"
            ]
          },
          "745240407": {
            "id": "745240407",
            "speakerId": 1034,
            "speakerName": "八重神子",
            "text": "刚才，她还和我讨论了一番呢。一开始，她还只是一本正经地分析故事内容所体现出的读者偏好…",
            "nextDialogs": [
              "745240408"
            ]
          },
          "745240408": {
            "id": "745240408",
            "speakerId": 1034,
            "speakerName": "八重神子",
            "text": "…可说着说着，就忽然很在意地问我：「所以，那个角色最后的结局究竟如何？」",
            "nextDialogs": [
              "745240409"
            ]
          },
          "745240409": {
            "id": "745240409",
            "speakerId": 1034,
            "speakerName": "八重神子",
            "text": "呵呵，看来就算是影，也难免会被精彩的故事所吸引呢。"
          }
        }
      }
    }
  ]

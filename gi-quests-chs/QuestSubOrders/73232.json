    {
      "subId": "7323203",
      "subQuestName": "与斯露莎对话",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "732320301"
        ],
        "dialogs": {
          "732320301": {
            "id": "732320301",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "这里是，那棵大树桩子的上面吗？",
            "nextDialogs": [
              "732320302"
            ]
          },
          "732320302": {
            "id": "732320302",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "明明好不容易才穿过了大窟窿到达这里，怎么又被拦住了啦！",
            "nextDialogs": [
              "732320303"
            ]
          },
          "732320303": {
            "id": "732320303",
            "speakerId": 1001,
            "speakerName": "斯露莎",
            "text": "按理来说我已经获得了「双角的花冠」，应该不会被母树拒绝的才对…呜呜…",
            "nextDialogs": [
              "732320304"
            ]
          },
          "732320304": {
            "id": "732320304",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "唔，怎么了斯露莎，你看上去好像很难受的样子。",
            "nextDialogs": [
              "732320305"
            ]
          },
          "732320305": {
            "id": "732320305",
            "speakerId": 1001,
            "speakerName": "斯露莎",
            "text": "呜呜…是「双角的花冠」…好像有什么东西在涌进来…",
            "nextDialogs": [
              "732320306"
            ]
          },
          "732320306": {
            "id": "732320306",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "哇啊，斯露莎！"
          }
        }
      }
    },
    {

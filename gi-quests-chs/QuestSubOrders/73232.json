    },
    {
      "subId": "7323218",
      "subQuestName": "与斯露莎对话",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "732321801"
        ],
        "dialogs": {
          "732321801": {
            "id": "732321801",
            "speakerId": 1002,
            "speakerName": "Black Screen",
            "text": "完成「祭水之仪」后，你们沿着甘露的流向，跟随斯露莎离开了「万种母树」回到花海…",
            "nextDialogs": [
              "732321802"
            ]
          },
          "732321802": {
            "id": "732321802",
            "speakerId": 1002,
            "speakerName": "Black Screen",
            "text": "而祖尔宛也已经在此等候着你们…",
            "nextDialogs": [
              "732321803"
            ]
          },
          "732321803": {
            "id": "732321803",
            "speakerId": 1003,
            "speakerName": "祖尔宛",
            "text": "没想到你们真的完成了「祭水之仪」，这番功绩已可比拟古代的英雄，真是让我惊讶。",
            "nextDialogs": [
              "732321804"
            ]
          },
          "732321804": {
            "id": "732321804",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "你明明就是一副一点也不惊讶的样子吧！",
            "nextDialogs": [
              "732321805"
            ]
          },
          "732321805": {
            "id": "732321805",
            "speakerId": 1001,
            "speakerName": "斯露莎",
            "text": "「焚真之天象」已经熄灭，大地也得到了净化，没想到不靠牺牲也能够做到…",
            "nextDialogs": [
              "732321806"
            ]
          },
          "732321806": {
            "id": "732321806",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "下了一场好大的雨啊，天上的大窟窿不见了，枯树桩子也重新长成了大树。",
            "nextDialogs": [
              "732321807"
            ]
          },
          "732321807": {
            "id": "732321807",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "不用再承受污秽侵蚀，神明大人应该也没有那么痛苦了吧！",
            "nextDialogs": [
              "732321808"
            ]
          },
          "732321808": {
            "id": "732321808",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "那么关于五百年前的事情…",
            "nextDialogs": [
              "732321809"
            ]
          },
          "732321809": {
            "id": "732321809",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "对哦，刚才斯露莎在大树里面看到了过去的记忆，果然最开始抵抗魔物的矫论团先辈里面有坎瑞亚的人！",
            "nextDialogs": [
              "732321810"
            ]
          },
          "732321810": {
            "id": "732321810",
            "speakerId": 1003,
            "speakerName": "祖尔宛",
            "text": "哎呀，别这么严肃嘛。既然你们已经接触了来自过去的记忆，那么接下来我要说的，就不是故事，而是事实了。",
            "nextDialogs": [
              "732321811"
            ]
          },
          "732321811": {
            "id": "732321811",
            "speakerId": 1003,
            "speakerName": "祖尔宛",
            "text": "很久很久以前，当我第一次从花海中醒来时，除了这一方小小的净土，天空中到处是黑渊的异象，外面也都是魔物的国度。",
            "nextDialogs": [
              "732321812"
            ]
          },
          "732321812": {
            "id": "732321812",
            "speakerId": 1003,
            "speakerName": "祖尔宛",
            "text": "循着神鸟遗愿的指引，我召集灵光的力量，离开花海以镇压地上的魔物，直到在荒野中遇到了那个金发的男人。",
            "nextDialogs": [
              "732321813"
            ]
          },
          "732321813": {
            "id": "732321813",
            "speakerId": 1003,
            "speakerName": "祖尔宛",
            "text": "那个家伙一半的身躯已形同魔物，但身上却没有魔物的气息，我发现他时，他的手中还紧紧攥着一枚指环。",
            "nextDialogs": [
              "732321814"
            ]
          },
          "732321814": {
            "id": "732321814",
            "speakerId": 1003,
            "speakerName": "祖尔宛",
            "text": "我将他带到花海之中，醒来之后他自称是荼诃的剑士，因身负诅咒才活了下来。",
            "nextDialogs": [
              "732321815"
            ]
          },
          "732321815": {
            "id": "732321815",
            "speakerId": 1003,
            "speakerName": "祖尔宛",
            "text": "后来一段时间，我便与这位蒙面的剑士同行，共同对抗进攻花海的迪弗们。",
            "nextDialogs": [
              "732321816"
            ]
          },
          "732321816": {
            "id": "732321816",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "身负诅咒…",
            "nextDialogs": [
              "732321817"
            ]
          },
          "732321817": {
            "id": "732321817",
            "speakerId": 1003,
            "speakerName": "祖尔宛",
            "text": "嗯，据说那场灾厄之中，荼诃人都受到了不同程度的诅咒。",
            "nextDialogs": [
              "732321818"
            ]
          },
          "732321818": {
            "id": "732321818",
            "speakerId": 1003,
            "speakerName": "祖尔宛",
            "text": "那之后不久，从沙漠的东方来了一群学者装束的人，为首的是一位独臂的贤者。",
            "nextDialogs": [
              "732321819"
            ]
          },
          "732321819": {
            "id": "732321819",
            "speakerId": 1003,
            "speakerName": "祖尔宛",
            "text": "他们自称是曾与荼诃人的勇士并肩作战之人。据他们所说，那是一群即便知道已背负上污名，却依然循着本愿而行的勇士。",
            "nextDialogs": [
              "732321820"
            ]
          },
          "732321820": {
            "id": "732321820",
            "speakerId": 1003,
            "speakerName": "祖尔宛",
            "text": "背负着勇士们的遗愿，为了彻底消除黑渊的灾祸，他们循着勇士们曾走过的道路而溯行至此。",
            "nextDialogs": [
              "732321821"
            ]
          },
          "732321821": {
            "id": "732321821",
            "speakerId": 1003,
            "speakerName": "祖尔宛",
            "text": "后来，我们共同进入了荼诃人留下的遗迹，发现了那些曾经与魔物对抗的机关，它们也隶属于曾与学者们并肩作战的战团。",
            "nextDialogs": [
              "732321822"
            ]
          },
          "732321822": {
            "id": "732321822",
            "speakerId": 1003,
            "speakerName": "祖尔宛",
            "text": "最后独臂的贤者靠着荼诃人留下的文献，找到了得以穿过黑渊进入母树的方法。",
            "nextDialogs": [
              "732321823"
            ]
          },
          "732321823": {
            "id": "732321823",
            "speakerId": 1003,
            "speakerName": "祖尔宛",
            "text": "于是我们便一同进入母树，用甘露净化了天上与地上的污秽。此后花海中不断有花灵诞生，地上的魔物则渐渐消失。",
            "nextDialogs": [
              "732321824"
            ]
          },
          "732321824": {
            "id": "732321824",
            "speakerId": 1003,
            "speakerName": "祖尔宛",
            "text": "#后来，蒙面的剑士随一位与你有着同样金色头发的{M#少女}{F#少年}离开了花海，贤者则独自进入地下的遗迹再也没有回来。",
            "nextDialogs": [
              "732321825"
            ]
          },
          "732321825": {
            "id": "732321825",
            "speakerId": 1003,
            "speakerName": "祖尔宛",
            "text": "剩下的人则与新生的花灵结成了伙伴，自称为「矫论团」，在这里生活了下来。",
            "nextDialogs": [
              "732321826"
            ]
          },
          "732321826": {
            "id": "732321826",
            "speakerId": 1003,
            "speakerName": "祖尔宛",
            "text": "如今金发的勇士又回到了花海，虽然不是当初的那位，不过我也能感受到某些东西又开始重新流逝了。",
            "nextDialogs": [
              "732321827"
            ]
          },
          "732321827": {
            "id": "732321827",
            "speakerId": 1003,
            "speakerName": "祖尔宛",
            "text": "这也是为什么我一开始就选择了拜托你们的原因啊，有你们在我就不用再想着去哪找出一位能与花灵并肩作战的勇士了。",
            "nextDialogs": [
              "732321828"
            ]
          },
          "732321828": {
            "id": "732321828",
            "speakerId": 1003,
            "speakerName": "祖尔宛",
            "text": "教导人类的工作可是很辛苦的。",
            "nextDialogs": [
              "732321829"
            ]
          },
          "732321829": {
            "id": "732321829",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "怎么你们花灵一个比一个懒啊！",
            "nextDialogs": [
              "732321830"
            ]
          },
          "732321830": {
            "id": "732321830",
            "speakerId": 1001,
            "speakerName": "斯露莎",
            "text": "喂，白飘飘说的这话可别带上我。",
            "nextDialogs": [
              "732321831"
            ]
          },
          "732321831": {
            "id": "732321831",
            "speakerId": 1003,
            "speakerName": "祖尔宛",
            "text": "哎呀，既然完成了「祭水之仪」，污秽一时半会也没办法威胁这里，我也可以趁机好好休息了。",
            "nextDialogs": [
              "732321832"
            ]
          },
          "732321832": {
            "id": "732321832",
            "speakerId": 1003,
            "speakerName": "祖尔宛",
            "text": "至于斯露莎，我就把她交给你们了，你们可要在旅途中好好教导她，毕竟这也算是「谒颂主」的工作呢。",
            "nextDialogs": [
              "732321833"
            ]
          },
          "732321833": {
            "id": "732321833",
            "speakerId": 1001,
            "speakerName": "斯露莎",
            "text": "我才不想被白飘飘指导…",
            "nextDialogs": [
              "732321834"
            ]
          },
          "732321834": {
            "id": "732321834",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "嘿嘿，斯露莎可要好好听话！不过怎么祖尔宛说的就像是以后不会再见面了一样。",
            "nextDialogs": [
              "732321835"
            ]
          },
          "732321835": {
            "id": "732321835",
            "speakerId": 1003,
            "speakerName": "祖尔宛",
            "text": "反正你们又不会留在这里陪我，你们这些人都一样啦，永远也不打算停下脚步。",
            "nextDialogs": [
              "732321838"
            ]
          },
          "732321838": {
            "id": "732321838",
            "speakerId": 1003,
            "speakerName": "祖尔宛",
            "text": "哎呀，我是不会再相信这种话了，毕竟已经不是第一次听了哪。",
            "nextDialogs": [
              "732321839"
            ]
          },
          "732321839": {
            "id": "732321839",
            "speakerId": 1003,
            "speakerName": "祖尔宛",
            "text": "说起这个，也不知道那位蒙面的剑士现在怎么样了，你们要是见到他可要帮我问好。",
            "nextDialogs": [
              "732321840"
            ]
          },
          "732321840": {
            "id": "732321840",
            "speakerId": 1003,
            "speakerName": "祖尔宛",
            "text": "毕竟你们都是旅人嘛，总是会有机会见面的。",
            "nextDialogs": [
              "732321841"
            ]
          },
          "732321841": {
            "id": "732321841",
            "speakerId": 1003,
            "speakerName": "祖尔宛",
            "text": "好啦，你们该回到属于你们的地方去了，可别太想我哦。"
          }
        }
      }
    },
    {
      "subId": "7323225",
      "subQuestName": "与凯瑟琳对话",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "732322501"
        ],
        "dialogs": {
          "732322501": {
            "id": "732322501",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "凯瑟琳小姐，我们回来了！",
            "nextDialogs": [
              "732322502"
            ]
          },
          "732322502": {
            "id": "732322502",
            "speakerId": 1004,
            "speakerName": "凯瑟琳",
            "text": "欢迎回来，我已经收到教令院的反馈了，没想到你们真的成功解决掉那个奇异天象了呢。",
            "nextDialogs": [
              "732322503"
            ]
          },
          "732322503": {
            "id": "732322503",
            "speakerId": 1004,
            "speakerName": "凯瑟琳",
            "text": "可以说是超出预期了。",
            "nextDialogs": [
              "732322504"
            ]
          },
          "732322504": {
            "id": "732322504",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "欸？我记得凯瑟琳小姐不是说，我们是最合适的人选吗？",
            "nextDialogs": [
              "732322505"
            ]
          },
          "732322505": {
            "id": "732322505",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "该不会你对每个人都会说同样的话吧。",
            "nextDialogs": [
              "732322506"
            ]
          },
          "732322506": {
            "id": "732322506",
            "speakerId": 1004,
            "speakerName": "凯瑟琳",
            "text": "怎么会，我当然相信你们可以完成这个委托了。",
            "nextDialogs": [
              "732322507"
            ]
          },
          "732322507": {
            "id": "732322507",
            "speakerId": 1004,
            "speakerName": "凯瑟琳",
            "text": "对了，之前还有拜托你们先联系到「那迦朱那团」。不知道他们是不是帮上什么忙了呢？",
            "nextDialogs": [
              "732322510"
            ]
          },
          "732322510": {
            "id": "732322510",
            "speakerId": 1004,
            "speakerName": "凯瑟琳",
            "text": "看来发生了很多故事呢。",
            "nextDialogs": [
              "732322511"
            ]
          },
          "732322511": {
            "id": "732322511",
            "speakerId": 1004,
            "speakerName": "凯瑟琳",
            "text": "不过不管发生什么样的事情，都是冒险的一部分。对于冒险家来说，都是难得的宝物呢。",
            "nextDialogs": [
              "732322512"
            ]
          },
          "732322512": {
            "id": "732322512",
            "speakerId": 1004,
            "speakerName": "凯瑟琳",
            "text": "既然顺利完成了委托，协会应该也可以获得坎瑞亚遗迹的调查许可了，如果有相关委托的话，我也会优先考虑你们的。",
            "nextDialogs": [
              "732322513"
            ]
          },
          "732322513": {
            "id": "732322513",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "不过说起来，虽然做了这么多事情，我们都还不知道委托人是谁呢！",
            "nextDialogs": [
              "732322514"
            ]
          },
          "732322514": {
            "id": "732322514",
            "speakerId": 1004,
            "speakerName": "凯瑟琳",
            "text": "这个嘛…冒险家协会有义务为委托人保密，没办法直接向你们透露。",
            "nextDialogs": [
              "732322515"
            ]
          },
          "732322515": {
            "id": "732322515",
            "speakerId": 1004,
            "speakerName": "凯瑟琳",
            "text": "不过将信物交给我们的那位先生，倒是自称是什么轻小说作家。",
            "nextDialogs": [
              "732322516"
            ]
          },
          "732322516": {
            "id": "732322516",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "轻小说作家？听起来有点耳熟，我记得之前也提到过矫论团有一位前辈…",
            "nextDialogs": [
              "732322517"
            ]
          },
          "732322517": {
            "id": "732322517",
            "speakerId": 1004,
            "speakerName": "凯瑟琳",
            "text": "看来你们是知道些什么呢，不过这些事情就与协会无关了。那么教令院的报酬已经放在我这里了，就请你们收下吧。"
          }
        }
      }
    },

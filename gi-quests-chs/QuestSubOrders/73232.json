            ]
          },
          "732321303": {
            "id": "732321303",
            "speakerId": 1001,
            "speakerName": "斯露莎",
            "text": "这些是从神明的意识里跑出来的，数百年来，她一直承受着这些。",
            "nextDialogs": [
              "732321304"
            ]
          },
          "732321304": {
            "id": "732321304",
            "speakerId": 1001,
            "speakerName": "斯露莎",
            "text": "想办法减轻她的痛苦吧！",
            "nextDialogs": [
              "732321305"
            ]
          },
          "732321305": {
            "id": "732321305",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "这些家伙越来越难缠了。",
            "nextDialogs": [

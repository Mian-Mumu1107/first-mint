    {
      "subId": "7323212",
      "subQuestName": "前往「伽乌迦那」",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [],
        "dialogs": {}
      }
    },
    {
      "subId": "7323224",
      "subQuestName": "与斯露莎对话",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "732322401"
        ],
        "dialogs": {
          "732322401": {
            "id": "732322401",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "这下所有的「慈心」都带回到莲花里来了，按照刚才斯露莎说的，应该已经可以唤醒神明的「神识」了吧。",
            "nextDialogs": [
              "732322402"
            ]
          },
          "732322402": {
            "id": "732322402",
            "speakerId": 1001,
            "speakerName": "斯露莎",
            "text": "那么，真正的「祭水之仪」就要开始了。",
            "nextDialogs": [
              "732322403"
            ]
          },
          "732322403": {
            "id": "732322403",
            "speakerId": 1001,
            "speakerName": "斯露莎",
            "text": "接下来我会借助灵光的力量，使「伽乌迦那」重新开出圣洁之花。",
            "nextDialogs": [
              "732322404"
            ]
          },
          "732322404": {
            "id": "732322404",
            "speakerId": 1001,
            "speakerName": "斯露莎",
            "text": "不过这也会释放出圣莲所积攒的污秽，污秽将化为魔物阻碍我们。",
            "nextDialogs": [
              "732322405"
            ]
          },
          "732322405": {
            "id": "732322405",
            "speakerId": 1001,
            "speakerName": "斯露莎",
            "text": "不过没关系，只要神明大人的「神识」被唤醒了，甘露的力量也会庇护我们。",
            "nextDialogs": [
              "732322406"
            ]
          },
          "732322406": {
            "id": "732322406",
            "speakerId": 1001,
            "speakerName": "斯露莎",
            "text": "只要圣洁之花长成，它便能将甘露播散到整个大地，净化所有的污秽。",
            "nextDialogs": [
              "732322407"
            ]
          },
          "732322407": {
            "id": "732322407",
            "speakerId": 1001,
            "speakerName": "斯露莎",
            "text": "这便是属于勇者的终末之战了！"
          }
        }
      }
    },
    {
      "subId": "7323213",
      "subQuestName": "守护圣洁之花",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "732321301"
        ],
        "dialogs": {
          "732321301": {
            "id": "732321301",
            "speakerId": 1001,
            "speakerName": "斯露莎",
            "text": "「慈心」生长出来了…"
          }
        }
      }
    },

        "startDialogs": [],
        "dialogs": {}
      }
    },
    {
      "subId": "7323206",
      "subQuestName": "与斯露莎对话",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "732320601"
        ],
        "dialogs": {
          "732320601": {
            "id": "732320601",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "喂喂！快醒醒，斯露莎。",
            "nextDialogs": [
              "732320602"
            ]
          },
          "732320602": {
            "id": "732320602",
            "speakerId": 1001,
            "speakerName": "斯露莎",
            "text": "唔…",
            "nextDialogs": [
              "732320603"
            ]
          },
          "732320603": {
            "id": "732320603",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "呼，你终于醒过来了，刚才在上面的时候你突然就晕过去了，吓死我了。",
            "nextDialogs": [
              "732320604"
            ]
          },
          "732320604": {
            "id": "732320604",
            "speakerId": 1001,
            "speakerName": "斯露莎",
            "text": "嗯…我没事。",
            "nextDialogs": [
              "732320605"
            ]
          },
          "732320605": {
            "id": "732320605",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "不过在那之后母树就打开了，然后我们就跟着来到了这里，这里该不会是…祖尔宛说的那个巨莲「伽乌迦那」吧！",
            "nextDialogs": [
              "732320606"
            ]
          },
          "732320606": {
            "id": "732320606",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "所以斯露莎刚才到底是怎么了啊，是花冠出了什么问题吗？",
            "nextDialogs": [
              "732320607"
            ]
          },
          "732320607": {
            "id": "732320607",
            "speakerId": 1001,
            "speakerName": "斯露莎",
            "text": "我刚才好像看到了大地回归母树的记忆。无数的花灵、荼诃的机关与人类的勇士，与魔物交战然后牺牲。",
            "nextDialogs": [
              "732320608"
            ]
          },
          "732320608": {
            "id": "732320608",
            "speakerId": 1001,
            "speakerName": "斯露莎",
            "text": "蒙面的剑士、独臂的贤者与元祖的花灵降服了自渊底而出的魔物。",
            "nextDialogs": [
              "732320609"
            ]
          },
          "732320609": {
            "id": "732320609",
            "speakerId": 1001,
            "speakerName": "斯露莎",
            "text": "而他们的意志最后都随着灵光回到了母树当中，化为从天而降的甘霖。",
            "nextDialogs": [
              "732320610"
            ]
          },
          "732320610": {
            "id": "732320610",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "荼诃的机关…听上去该不会真的像那先朱那说的那样吧？",
            "nextDialogs": [
              "732320611"
            ]
          },
          "732320611": {
            "id": "732320611",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "看来还是得问祖尔宛才行。",
            "nextDialogs": [
              "732320612"
            ]
          },
          "732320612": {
            "id": "732320612",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "嗯，不过现在我们接下来该怎么办呢，我记得祖尔宛是说要清除什么污秽来着？",
            "nextDialogs": [
              "732320613"
            ]
          },
          "732320613": {
            "id": "732320613",
            "speakerId": 1001,
            "speakerName": "斯露莎",
            "text": "只有进入神明大人的「神识」所依附的「染境」，将那些被污秽困在其中的「慈心」带出来，才能重新唤醒「神识」。",
            "nextDialogs": [
              "732320614"
            ]
          },
          "732320614": {
            "id": "732320614",
            "speakerId": 1001,
            "speakerName": "斯露莎",
            "text": "在我所看到的记忆中，那是个无边虚无的空间。",
            "nextDialogs": [
              "732320615"
            ]
          },
          "732320615": {
            "id": "732320615",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "既然这样，那我们要怎么样才能进去呢。",
            "nextDialogs": [
              "732320616"
            ]
          },
          "732320616": {
            "id": "732320616",
            "speakerId": 1001,
            "speakerName": "斯露莎",
            "text": "跟着我来就行，只要沿着古代英雄们的「心迹」，就能到达那里了！"
          }
        }
      }
    },

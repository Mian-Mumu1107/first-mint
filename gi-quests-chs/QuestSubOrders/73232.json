    {
      "subId": "7323219",
      "subQuestName": "(test)智慧空间3传送任务$HIDDEN",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "732321901"
        ],
        "dialogs": {
          "732321901": {
            "id": "732321901",
            "speakerId": 1002,
            "speakerName": "Black Screen",
            "text": "完成「祭水之仪」后，你们沿着甘露的流向，跟随斯露莎离开了「万种母树」回到花海…",
            "nextDialogs": [
              "732321902"
            ]
          },
          "732321902": {
            "id": "732321902",
            "speakerId": 1002,
            "speakerName": "Black Screen",
            "text": "而祖尔宛也已经在此等候着你们…",
            "nextDialogs": [
              "732321903"
            ]
          },
          "732321903": {
            "id": "732321903",
            "speakerId": 1003,
            "speakerName": "祖尔宛",
            "text": "没想到你们真的完成了「祭水之仪」，这番功绩已可比拟古代的英雄，真是让我惊讶。",
            "nextDialogs": [
              "732321904"
            ]
          },
          "732321904": {
            "id": "732321904",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "你明明就是一副一点也不惊讶的样子吧！",
            "nextDialogs": [
              "732321905"
            ]
          },
          "732321905": {
            "id": "732321905",
            "speakerId": 1001,
            "speakerName": "斯露莎",
            "text": "「焚真之天象」已经熄灭，大地也得到了净化，没想到不靠牺牲也能够做到…",
            "nextDialogs": [
              "732321906"
            ]
          },
          "732321906": {
            "id": "732321906",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "下了一场好大的雨啊，天上的大窟窿不见了，枯树桩子也重新长成了大树。",
            "nextDialogs": [
              "732321907"
            ]
          },
          "732321907": {
            "id": "732321907",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "不用再承受污秽侵蚀，神明大人应该也没有那么痛苦了吧！",
            "nextDialogs": [
              "732321908"
            ]
          },
          "732321908": {
            "id": "732321908",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "那么关于五百年前的事情…",
            "nextDialogs": [
              "732321909"
            ]
          },
          "732321909": {
            "id": "732321909",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "对哦，刚才斯露莎在大树里面看到了过去的记忆，果然最开始抵抗魔物的矫论团先辈里面有坎瑞亚的人！",
            "nextDialogs": [
              "732321910"
            ]
          },
          "732321910": {
            "id": "732321910",
            "speakerId": 1003,
            "speakerName": "祖尔宛",
            "text": "哎呀，别这么严肃嘛。既然你们已经接触了来自过去的记忆，那么接下来我要说的，就不是故事，而是事实了。",
            "nextDialogs": [
              "732321911"
            ]
          },
          "732321911": {
            "id": "732321911",
            "speakerId": 1003,
            "speakerName": "祖尔宛",
            "text": "很久很久以前，当我第一次从花海中醒来时，除了这一方小小的净土，天空中到处是黑渊的异象，外面也都是魔物的国度。",
            "nextDialogs": [
              "732321912"
            ]
          },
          "732321912": {
            "id": "732321912",
            "speakerId": 1003,
            "speakerName": "祖尔宛",
            "text": "循着神鸟遗愿的指引，我召集灵光的力量，离开花海以镇压地上的魔物，直到在荒野中遇到了那个金发的男人。",
            "nextDialogs": [
              "732321913"
            ]
          },
          "732321913": {
            "id": "732321913",
            "speakerId": 1003,
            "speakerName": "祖尔宛",
            "text": "那个家伙一半的身躯已形同魔物，但身上却没有魔物的气息，我发现他时，他的手中还紧紧攥着一枚指环。",
            "nextDialogs": [
              "732321914"
            ]
          },
          "732321914": {
            "id": "732321914",
            "speakerId": 1003,
            "speakerName": "祖尔宛",
            "text": "我将他带到花海之中，醒来之后他自称是荼诃的剑士，因身负诅咒才活了下来。",
            "nextDialogs": [
              "732321915"
            ]
          },
          "732321915": {
            "id": "732321915",
            "speakerId": 1003,
            "speakerName": "祖尔宛",
            "text": "后来一段时间，我便与这位蒙面的剑士同行，共同对抗进攻花海的迪弗们。",
            "nextDialogs": [
              "732321917",
              "732321920"
            ]
          },
          "732321917": {
            "id": "732321917",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "来自坎瑞亚的蒙面剑士，我们认识的人里面也…该不会是…",
            "nextDialogs": [
              "732321918"
            ]
          },
          "732321918": {
            "id": "732321918",
            "speakerId": 1003,
            "speakerName": "祖尔宛",
            "text": "哦？你们果然认识吗，这样的话解释起来就方便多了。",
            "nextDialogs": [
              "732321921"
            ]
          },
          "732321921": {
            "id": "732321921",
            "speakerId": 1003,
            "speakerName": "祖尔宛",
            "text": "那之后不久，从沙漠的东方来了一群学者装束的人，为首的是一位独臂的贤者。",
            "nextDialogs": [
              "732321922"
            ]
          },
          "732321922": {
            "id": "732321922",
            "speakerId": 1003,
            "speakerName": "祖尔宛",
            "text": "他们自称是曾与荼诃人的勇士并肩作战之人。据他们所说，那是一群即便知道已背负上污名，却依然循着本愿而行的勇士。",
            "nextDialogs": [
              "732321923"
            ]
          },
          "732321923": {
            "id": "732321923",
            "speakerId": 1003,
            "speakerName": "祖尔宛",
            "text": "背负着勇士们的遗愿，为了彻底消除黑渊的灾祸，他们循着勇士们曾走过的道路而溯行至此。",
            "nextDialogs": [
              "732321924"
            ]
          },
          "732321924": {
            "id": "732321924",
            "speakerId": 1003,
            "speakerName": "祖尔宛",
            "text": "后来，我们共同进入了荼诃人留下的遗迹，发现了那些曾经与魔物对抗的机关，它们也隶属于曾与学者们并肩作战的战团。",
            "nextDialogs": [
              "732321925"
            ]
          },
          "732321925": {
            "id": "732321925",
            "speakerId": 1003,
            "speakerName": "祖尔宛",
            "text": "最后独臂的贤者靠着荼诃人留下的文献，找到了得以穿过黑渊进入母树的方法。",
            "nextDialogs": [
              "732321926"
            ]
          },
          "732321926": {
            "id": "732321926",
            "speakerId": 1003,
            "speakerName": "祖尔宛",
            "text": "于是我们便一同进入母树，用甘露净化了天上与地上的污秽。此后花海中不断有花灵诞生，地上的魔物则渐渐消失。",
            "nextDialogs": [
              "732321927"
            ]
          },
          "732321927": {
            "id": "732321927",
            "speakerId": 1003,
            "speakerName": "祖尔宛",
            "text": "#后来，蒙面的剑士随一位与你有着同样金色头发的{M#少女}{F#少年}离开了花海，贤者则独自进入地下的遗迹再也没有回来。",
            "nextDialogs": [
              "732321928"
            ]
          },
          "732321928": {
            "id": "732321928",
            "speakerId": 1003,
            "speakerName": "祖尔宛",
            "text": "剩下的人则与新生的花灵结成了伙伴，自称为「矫论团」，在这里生活了下来。",
            "nextDialogs": [
              "732321929"
            ]
          },
          "732321929": {
            "id": "732321929",
            "speakerId": 1003,
            "speakerName": "祖尔宛",
            "text": "如今金发的勇士又回到了花海，虽然不是当初的那位，不过我也能感受到某些东西又开始重新流逝了。",
            "nextDialogs": [
              "732321930"
            ]
          },
          "732321930": {
            "id": "732321930",
            "speakerId": 1003,
            "speakerName": "祖尔宛",
            "text": "这也是为什么我一开始就选择了拜托你们的原因啊，有你们在我就不用再想着去哪找出一位能与花灵并肩作战的勇士了。",
            "nextDialogs": [
              "732321931"
            ]
          },
          "732321931": {
            "id": "732321931",
            "speakerId": 1003,
            "speakerName": "祖尔宛",
            "text": "教导人类的工作可是很辛苦的。",
            "nextDialogs": [
              "732321932"
            ]
          },
          "732321932": {
            "id": "732321932",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "怎么你们花灵一个比一个懒啊！",
            "nextDialogs": [
              "732321933"
            ]
          },
          "732321933": {
            "id": "732321933",
            "speakerId": 1001,
            "speakerName": "斯露莎",
            "text": "喂，白飘飘说的这话可别带上我。",
            "nextDialogs": [
              "732321934"
            ]
          },
          "732321934": {
            "id": "732321934",
            "speakerId": 1003,
            "speakerName": "祖尔宛",
            "text": "哎呀，既然完成了「祭水之仪」，污秽一时半会也没办法威胁这里，我也可以趁机好好休息了。",
            "nextDialogs": [
              "732321935"
            ]
          },
          "732321935": {
            "id": "732321935",
            "speakerId": 1003,
            "speakerName": "祖尔宛",
            "text": "至于斯露莎，我就把她交给你们了，你们可要在旅途中好好教导她，毕竟这也算是「谒颂主」的工作呢。",
            "nextDialogs": [
              "732321936"
            ]
          },
          "732321936": {
            "id": "732321936",
            "speakerId": 1001,
            "speakerName": "斯露莎",
            "text": "我才不想被白飘飘指导…",
            "nextDialogs": [
              "732321937"
            ]
          },
          "732321937": {
            "id": "732321937",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "嘿嘿，斯露莎可要好好听话！不过怎么祖尔宛说的就像是以后不会再见面了一样。",
            "nextDialogs": [
              "732321938"
            ]
          },
          "732321938": {
            "id": "732321938",
            "speakerId": 1003,
            "speakerName": "祖尔宛",
            "text": "反正你们又不会留在这里陪我，你们这些人都一样啦，永远也不打算停下脚步。"
          },
          "732321920": {
            "id": "732321920",
            "speakerId": 1003,
            "speakerName": "祖尔宛",
            "text": "嗯，据说那场灾厄之中，荼诃人都受到了不同程度的诅咒。"
          }
        }
      }
    },
    {

    },
    {
      "subId": "7615903",
      "subQuestName": "与尼可对话",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "761590301"
        ],
        "dialogs": {
          "761590301": {
            "id": "761590301",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "这里是奔狼领？这周围，好像也不像是能处理课业的地方呢…",
            "nextDialogs": [
              "761590302"
            ]
          },
          "761590302": {
            "id": "761590302",
            "speakerId": 1322,
            "speakerName": "尼可",
            "text": "这已经是离得最近的「仙灵之庭」了，没事，离我们要找的那个「课业起始地」不远。",
            "nextDialogs": [
              "761590303"
            ]
          },
          "761590303": {
            "id": "761590303",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "呜哇！那些狼是什么时候凑近的，那个…我们没有恶意，我们还认识雷泽呢…",
            "nextDialogs": [
              "761590304"
            ]
          },
          "761590304": {
            "id": "761590304",
            "speakerId": 16658,
            "speakerName": "狼群",
            "text": "……",
            "nextDialogs": [
              "761590307"
            ]
          },
          "761590307": {
            "id": "761590307",
            "speakerId": 1322,
            "speakerName": "尼可",
            "text": "那孩子还没有来么？或许是时机还未到吧。不过，只要和「卢皮卡」并肩，无论面对任何敌人，那孩子都更胜一筹。",
            "nextDialogs": [
              "761590308"
            ]
          },
          "761590308": {
            "id": "761590308",
            "speakerId": 16658,
            "speakerName": "狼群",
            "text": "……",
            "nextDialogs": [
              "761590309"
            ]
          },
          "761590309": {
            "id": "761590309",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "它们怎么又回来了？难道是听到了我们的话？要是雷泽在就好了，他肯定听得懂狼群想要说什么…",
            "nextDialogs": [
              "761590310"
            ]
          },
          "761590310": {
            "id": "761590310",
            "speakerId": 1322,
            "speakerName": "尼可",
            "text": "是啊，但除此之外，他还要懂得更多东西才行。"
          }
        }
      }
    },
    {
      "subId": "7615905",
      "subQuestName": "进入房间",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "761590501"
        ],
        "dialogs": {
          "761590501": {
            "id": "761590501",
            "speakerId": 16736,
            "speakerName": "查看艾莉丝的纸条…",
            "text": "「课业辅导辛苦啦，快点回家喝一杯热茶吧！」",
            "nextDialogs": [
              "761590502"
            ]
          },
          "761590502": {
            "id": "761590502",
            "speakerId": 16736,
            "speakerName": "查看艾莉丝的纸条…",
            "text": "「另：门内有惊喜！」"
          }
        }
      }
    },
    {
      "subId": "7615906",
      "subQuestName": "与尼可对话",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "761590601"
        ],
        "dialogs": {
          "761590601": {
            "id": "761590601",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "又换地方了。这里是…",
            "nextDialogs": [
              "761590604"
            ]
          },
          "761590604": {
            "id": "761590604",
            "speakerId": 1322,
            "speakerName": "尼可",
            "text": "怪不得艾莉丝那一天，突然来找我要屋子的钥匙，说什么要布置一间漂亮的茶话室…我都跟她说了我已经有茶话室了…"
          }
        }
      }
    },
    {

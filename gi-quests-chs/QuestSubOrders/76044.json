{
  "lineCounts": {
    "勒塞克": 11,
    "奈芙尔": 6,
    "雅珂达": 24
  },
  "subQuests": [
    {
      "subId": "7604401",
      "subQuestName": "前往「秘闻馆」",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "760440101"
        ],
        "dialogs": {
          "760440101": {
            "id": "760440101",
            "speakerId": 1000,
            "speakerName": "雅珂达",
            "text": "「旗舰」的悬赏里有一条很棘手呢，几乎没什么线索。",
            "nextDialogs": [
              "760440102"
            ]
          },
          "760440102": {
            "id": "760440102",
            "speakerId": 1000,
            "speakerName": "雅珂达",
            "text": "前阵子还听说他在伦波岛北边伤人呢，现在却突然消失得无影无踪，一点消息也没有…",
            "nextDialogs": [
              "760440103"
            ]
          },
          "760440103": {
            "id": "760440103",
            "speakerId": 1001,
            "speakerName": "奈芙尔",
            "text": "「凡走过必留痕迹」，哪怕是抹除痕迹，也会留下新的印迹。",
            "nextDialogs": [
              "760440104"
            ]
          },
          "760440104": {
            "id": "760440104",
            "speakerId": 1001,
            "speakerName": "奈芙尔",
            "text": "再者，悬赏里没有明文写出，也不代表他们没有掌握任何信息。",
            "nextDialogs": [
              "760440105"
            ]
          },
          "760440105": {
            "id": "760440105",
            "speakerId": 1000,
            "speakerName": "雅珂达",
            "text": "说得也是，我去找勒塞克问问好了，凭我的资深身份，应该能问出些什么。",
            "nextDialogs": [
              "760440106"
            ]
          },
          "760440106": {
            "id": "760440106",
            "speakerId": 1001,
            "speakerName": "奈芙尔",
            "text": "那就交给你了。",
            "nextDialogs": [
              "760440107"
            ]
          },
          "760440107": {
            "id": "760440107",
            "speakerId": 1000,
            "speakerName": "雅珂达",
            "text": "嗯，放心吧，老板！"
          }
        }
      }
    },
    {
      "subId": "7604402",
      "subQuestName": "与「旗舰」员工勒塞克对话",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "760440201"
        ],
        "dialogs": {
          "760440201": {
            "id": "760440201",
            "speakerId": 1002,
            "speakerName": "勒塞克",
            "text": "悬赏目标的信息都在板上，问我也行，但赏金多少没有商量的余地。",
            "nextDialogs": [
              "760440202"
            ]
          },
          "760440202": {
            "id": "760440202",
            "speakerId": 1000,
            "speakerName": "雅珂达",
            "text": "关于悬赏目标…",
            "nextDialogs": [
              "760440203"
            ]
          },
          "760440203": {
            "id": "760440203",
            "speakerId": 1002,
            "speakerName": "勒塞克",
            "text": "板上有四个目标，但只有三个有线索。被人指控欺诈而悬赏的…",
            "nextDialogs": [
              "760440204"
            ]
          },
          "760440204": {
            "id": "760440204",
            "speakerId": 1000,
            "speakerName": "雅珂达",
            "text": "…停一下，停一下！敷衍那些新入行的宝藏猎人也就算了，对我也这样？你知道我要问的是哪个。",
            "nextDialogs": [
              "760440205"
            ]
          },
          "760440205": {
            "id": "760440205",
            "speakerId": 1002,
            "speakerName": "勒塞克",
            "text": "「秘闻馆」要插手吗？",
            "nextDialogs": [
              "760440206"
            ]
          },
          "760440206": {
            "id": "760440206",
            "speakerId": 1000,
            "speakerName": "雅珂达",
            "text": "那得看老板的意思。欸？怎么变成你问我了？",
            "nextDialogs": [
              "760440207"
            ]
          },
          "760440207": {
            "id": "760440207",
            "speakerId": 1000,
            "speakerName": "雅珂达",
            "text": "说起来，「裂颚」哈尔克到现在还是下落不明，难道不是因为你们给的线索写得太模糊了吗？你自己看看，连外貌特征都没有。",
            "nextDialogs": [
              "760440208"
            ]
          },
          "760440208": {
            "id": "760440208",
            "speakerId": 1002,
            "speakerName": "勒塞克",
            "text": "要是哪个宝藏猎人连这个都不知道，那肯定也不是哈尔克的对手，何必让他们浪费时间…浪费自己的性命。",
            "nextDialogs": [
              "760440209"
            ]
          },
          "760440209": {
            "id": "760440209",
            "speakerId": 1000,
            "speakerName": "雅珂达",
            "text": "好吧，那除了他下巴上那道骇人的疤痕，还有什么其他的特征？最好是其他人不知道的。",
            "nextDialogs": [
              "760440210"
            ]
          },
          "760440210": {
            "id": "760440210",
            "speakerId": 1002,
            "speakerName": "勒塞克",
            "text": "其他人不知道的…你是说身上的，比如说背上的印记之类？",
            "nextDialogs": [
              "760440211"
            ]
          },
          "760440211": {
            "id": "760440211",
            "speakerId": 1000,
            "speakerName": "雅珂达",
            "text": "对，就是这种，原来真有啊！不过你又是怎么知道的？",
            "nextDialogs": [
              "760440212"
            ]
          },
          "760440212": {
            "id": "760440212",
            "speakerId": 1002,
            "speakerName": "勒塞克",
            "text": "我不知道。有没有我也不知道。再说，就算真的有，你准备怎么查验？",
            "nextDialogs": [
              "760440213"
            ]
          },
          "760440213": {
            "id": "760440213",
            "speakerId": 1000,
            "speakerName": "雅珂达",
            "text": "这、这么说来也是…唉，真的就没什么独家消息？看在咱们这么熟的份上，就不能透露一点吗？",
            "nextDialogs": [
              "760440214"
            ]
          },
          "760440214": {
            "id": "760440214",
            "speakerId": 1002,
            "speakerName": "勒塞克",
            "text": "哈尔克在那夏镇暴露了本性之后逃窜去了伦波岛北部一带，在那里继续为非作歹。",
            "nextDialogs": [
              "760440215"
            ]
          },
          "760440215": {
            "id": "760440215",
            "speakerId": 1000,
            "speakerName": "雅珂达",
            "text": "这我都知道，之前多多少少听过。",
            "nextDialogs": [
              "760440216"
            ]
          },
          "760440216": {
            "id": "760440216",
            "speakerId": 1000,
            "speakerName": "雅珂达",
            "text": "但他最近不是没了消息吗？要是去了北边，皮拉米达城还好，但要是去了至冬堡…",
            "nextDialogs": [
              "760440217"
            ]
          },
          "760440217": {
            "id": "760440217",
            "speakerId": 1000,
            "speakerName": "雅珂达",
            "text": "（冰天雪地的，我这胳膊能受得了吗…）",
            "nextDialogs": [
              "760440218"
            ]
          },
          "760440218": {
            "id": "760440218",
            "speakerId": 1002,
            "speakerName": "勒塞克",
            "text": "不会，他还在伦波岛，只是不知道他在哪里藏身。这条是独家消息。",
            "nextDialogs": [
              "760440219"
            ]
          },
          "760440219": {
            "id": "760440219",
            "speakerId": 1000,
            "speakerName": "雅珂达",
            "text": "欸，这你又是怎么确定的？",
            "nextDialogs": [
              "760440220"
            ]
          },
          "760440220": {
            "id": "760440220",
            "speakerId": 1002,
            "speakerName": "勒塞克",
            "text": "那就是商业机密了，价钱是另算的。",
            "nextDialogs": [
              "760440221"
            ]
          },
          "760440221": {
            "id": "760440221",
            "speakerId": 1000,
            "speakerName": "雅珂达",
            "text": "嘁，小气。唉，一个下巴有疤的壮汉，哪怕只是在伦波岛上，走十步也能碰到一个吧，这要怎么找啊。",
            "nextDialogs": [
              "760440222"
            ]
          },
          "760440222": {
            "id": "760440222",
            "speakerId": 1002,
            "speakerName": "勒塞克",
            "text": "那就看在我们这么熟的份上，给你一个建议，别光盯着下巴上的疤痕。",
            "nextDialogs": [
              "760440223"
            ]
          },
          "760440223": {
            "id": "760440223",
            "speakerId": 1000,
            "speakerName": "雅珂达",
            "text": "…你是想说，他会设法把下巴上的疤痕遮住？",
            "nextDialogs": [
              "760440224"
            ]
          },
          "760440224": {
            "id": "760440224",
            "speakerId": 1000,
            "speakerName": "雅珂达",
            "text": "有道理…他会被称作「裂颚」就是因为那道标志性的伤疤，反过来说，如果没了这道疤痕，他就和其他壮汉没什么区别了。",
            "nextDialogs": [
              "760440225"
            ]
          },
          "760440225": {
            "id": "760440225",
            "speakerId": 1000,
            "speakerName": "雅珂达",
            "text": "这样一来，只要找刻意遮挡下巴的壮汉就好了。算是一条新线索，好吧，之后有进展了再来找你。",
            "nextDialogs": [
              "760440226"
            ]
          },
          "760440226": {
            "id": "760440226",
            "speakerId": 1002,
            "speakerName": "勒塞克",
            "text": "等你的好消息。"
          }
        }
      }
    },
    {
      "subId": "7604403",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "760440301"
        ],
        "dialogs": {
          "760440301": {
            "id": "760440301",
            "speakerId": 1000,
            "speakerName": "雅珂达",
            "text": "「旗舰」的悬赏啊…不知不觉就只剩最后一条了。",
            "nextDialogs": [
              "760440302"
            ]
          },
          "760440302": {
            "id": "760440302",
            "speakerId": 1001,
            "speakerName": "奈芙尔",
            "text": "#听闻是多亏了{NICKNAME}的活跃，不过看来就算是{M#他}{F#她}，对这最后一条悬赏也是束手无策。",
            "nextDialogs": [
              "760440303"
            ]
          },
          "760440303": {
            "id": "760440303",
            "speakerId": 1000,
            "speakerName": "雅珂达",
            "text": "毕竟实在没什么线索嘛——",
            "nextDialogs": [
              "760440304"
            ]
          },
          "760440304": {
            "id": "760440304",
            "speakerId": 1000,
            "speakerName": "雅珂达",
            "text": "啊，悬赏上没写，倒也不见得真的没有。",
            "nextDialogs": [
              "760440305"
            ]
          },
          "760440305": {
            "id": "760440305",
            "speakerId": 1001,
            "speakerName": "奈芙尔",
            "text": "看来你有头绪了？",
            "nextDialogs": [
              "760440306"
            ]
          },
          "760440306": {
            "id": "760440306",
            "speakerId": 1000,
            "speakerName": "雅珂达",
            "text": "我去找勒塞克问问好了，凭我的资深身份，应该能问出些什么。",
            "nextDialogs": [
              "760440307"
            ]
          },
          "760440307": {
            "id": "760440307",
            "speakerId": 1001,
            "speakerName": "奈芙尔",
            "text": "那就交给你了。",
            "nextDialogs": [
              "760440308"
            ]
          },
          "760440308": {
            "id": "760440308",
            "speakerId": 1000,
            "speakerName": "雅珂达",
            "text": "嗯，放心吧，老板！"
          }
        }
      }
    }
  ]
}
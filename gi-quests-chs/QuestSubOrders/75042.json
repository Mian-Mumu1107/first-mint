{
  "lineCounts": {
    "Player": 4,
    "曼科": 12
  },
  "subQuests": [
    {
      "subId": "7504201",
      "subQuestName": "(test)初见完成后，大木在前哨站闲置$HIDDEN",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "750420101"
        ],
        "dialogs": {
          "750420101": {
            "id": "750420101",
            "speakerId": 1000,
            "speakerName": "曼科",
            "text": "哦，您好，最近如何？",
            "nextDialogs": [
              "750420102"
            ]
          },
          "750420102": {
            "id": "750420102",
            "speakerId": 1000,
            "speakerName": "曼科",
            "text": "或者，你来找我，是有什么想要确认的？",
            "nextDialogs": [
              "750420104",
              "750420109",
              "750420116"
            ]
          },
          "750420104": {
            "id": "750420104",
            "speakerId": 1000,
            "speakerName": "曼科",
            "text": "「焰主之祝」…有人认为这是一种返祖的现象，因为大家一致认为这种力量拥有一种血脉上的更深邃的源头。",
            "nextDialogs": [
              "750420105"
            ]
          },
          "750420105": {
            "id": "750420105",
            "speakerId": 1000,
            "speakerName": "曼科",
            "text": "只是…据龙遗物研究协会的记载来看，这些身上有「焰主之祝」印记的幼龙大多数在成长过程中，受体内不可控的力量摆布…",
            "nextDialogs": [
              "750420106"
            ]
          },
          "750420106": {
            "id": "750420106",
            "speakerId": 1000,
            "speakerName": "曼科",
            "text": "那份力量会撕扯他们的身躯，让它们变成有别于正常龙众的东西…变得狂暴，失去理智。",
            "nextDialogs": [
              "750420107"
            ]
          },
          "750420107": {
            "id": "750420107",
            "speakerId": 1000,
            "speakerName": "曼科",
            "text": "名为「霍拉瓦伽」的绒翼龙暴君就是最好的例子…据说它从前就是一只被赐予「焰主之祝」的绒翼龙。"
          },
          "750420109": {
            "id": "750420109",
            "speakerId": 1000,
            "speakerName": "曼科",
            "text": "就是让它回归夜神的国度，在它生时，或许无法被龙众或夜神之国接纳。",
            "nextDialogs": [
              "750420110"
            ]
          },
          "750420110": {
            "id": "750420110",
            "speakerId": 1000,
            "speakerName": "曼科",
            "text": "但在它离开此世之后，必然还是会回归夜晚的怀抱，这对于它来说，虽然冰冷，但是在那里它将与众生的灵魂汇合…",
            "nextDialogs": [
              "750420111"
            ]
          },
          "750420111": {
            "id": "750420111",
            "speakerId": 1000,
            "speakerName": "曼科",
            "text": "恕我冒昧，那或许也是一种温柔。",
            "nextDialogs": [
              "750420112"
            ]
          },
          "750420112": {
            "id": "750420112",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "有信物的线索了吗？",
            "nextDialogs": [
              "750420113"
            ]
          },
          "750420113": {
            "id": "750420113",
            "speakerId": 1000,
            "speakerName": "曼科",
            "text": "有一些，但是…我得找人确认，也许之后你能在帕加尔那里找到我，他是回声之子的领袖。",
            "nextDialogs": [
              "750420114"
            ]
          },
          "750420114": {
            "id": "750420114",
            "speakerId": 1000,
            "speakerName": "曼科",
            "text": "虽然他看上去有点…浮夸，但是恕我直言，他比最坚固的晶石还要可靠。"
          },
          "750420116": {
            "id": "750420116",
            "speakerId": 1000,
            "speakerName": "曼科",
            "text": "随时欢迎您，朋友。"
          }
        }
      }
    }
  ]
}
        "dialogs": {
          "721160101": {
            "id": "721160101",
            "speakerId": 20624,
            "speakerName": "泽维尔",
            "text": "还是要再等一段时间啊…",
            "nextDialogs": [
              "721160102"
            ]
          },
          "721160102": {
            "id": "721160102",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "数据搜集好了吗？",
            "nextDialogs": [
              "721160103"
            ]
          },
          "721160103": {
            "id": "721160103",
            "speakerId": 20624,
            "speakerName": "泽维尔",
            "text": "是您啊，真是幸会。数据暂时还没搜集好，我想应该还需要一点时间。",
            "nextDialogs": [
              "721160104"
            ]
          },
          "721160104": {
            "id": "721160104",
            "speakerId": 20624,
            "speakerName": "泽维尔",
            "text": "不过，我也正好趁着这段时间思考了一下应急净化器的结构…",
            "nextDialogs": [
              "721160106",
              "721160108"
            ]
          },
          "721160106": {
            "id": "721160106",
            "speakerId": 20624,
            "speakerName": "泽维尔",
            "text": "只是我的一点应急小技巧而已。",
            "nextDialogs": [
              "721160109"
            ]
          },
          "721160109": {
            "id": "721160109",
            "speakerId": 20624,
            "speakerName": "泽维尔",
            "text": "按照我们之前商量的计划，我们得同时对付愚人众和「祟神」两个大麻烦。",
            "nextDialogs": [
              "721160110"
            ]
          },
          "721160110": {
            "id": "721160110",
            "speakerId": 20624,
            "speakerName": "泽维尔",
            "text": "我相信您一定能搞定那些愚人众，而我，当然就要负责搞定那些「祟神」了。",
            "nextDialogs": [
              "721160111"
            ]
          },
          "721160111": {
            "id": "721160111",
            "speakerId": 20624,
            "speakerName": "泽维尔",
            "text": "这个应急净化器，就是我搞定那些「祟神」的装置。但要制作出这种装置，还需要您再来搭把手。"
          },
          "721160108": {
            "id": "721160108",
            "speakerId": 20624,
            "speakerName": "泽维尔",
            "text": "算是吧，但这种技巧，我一般不会在客户服务的时候提供…"
          }
        }
      }
    },

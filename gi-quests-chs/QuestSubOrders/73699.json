  "subQuests": [
    {
      "subId": "7369901",
      "subQuestName": "与祖尔宛对话",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "736990101"
        ],
        "dialogs": {
          "736990101": {
            "id": "736990101",
            "speakerId": 4284,
            "speakerName": "祖尔宛",
            "text": "哦，看来你们已经顺利完成了之前的训练。",
            "nextDialogs": [
              "736990102"
            ]
          },
          "736990102": {
            "id": "736990102",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "完成是完成了，不过斯露莎这家伙…",
            "nextDialogs": [
              "736990103"
            ]
          },
          "736990103": {
            "id": "736990103",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "看到几百年前的沙虫结晶，明明前一刻还一本正经地说什么虽然它已经存在了几百年，但总有一天还是会不留任何痕迹地消失…",
            "nextDialogs": [
              "736990104"
            ]
          },
          "736990104": {
            "id": "736990104",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "后一刻说到赞美她的颂诗可能会更快被传得面目全非，马上就换了个脸色。",
            "nextDialogs": [
              "736990105"
            ]
          },
          "736990105": {
            "id": "736990105",
            "speakerId": 13210,
            "speakerName": "斯露莎",
            "text": "哼，那当然了，我的伟业…我是说，吾辈花灵的伟业，应该是不朽的。怎么能跟那些随时都有可能烟消云散的存在相比。",
            "nextDialogs": [
              "736990106"
            ]
          },
          "736990106": {
            "id": "736990106",
            "speakerId": 13210,
            "speakerName": "斯露莎",
            "text": "不能正确地保存，那就一定是方法有问题。前辈也是为了提醒我这一点才让我去重新审视沙虫结晶的吧？",
            "nextDialogs": [
              "736990107"
            ]
          },
          "736990107": {
            "id": "736990107",
            "speakerId": 4284,
            "speakerName": "祖尔宛",
            "text": "原来斯露莎是这样想的，倒也有些意思。",
            "nextDialogs": [
              "736990108"
            ]
          },
          "736990108": {
            "id": "736990108",
            "speakerId": 13210,
            "speakerName": "斯露莎",
            "text": "难道前辈就不在乎花灵一族的声名吗？",
            "nextDialogs": [
              "736990109"
            ]
          },
          "736990109": {
            "id": "736990109",
            "speakerId": 4284,
            "speakerName": "祖尔宛",
            "text": "如果说是人类之中流传的声名，或许并不那么在乎吧。不管怎么说，现在的矫论团可是无趣得很呐。",
            "nextDialogs": [
              "736990110"
            ]
          },
          "736990110": {
            "id": "736990110",
            "speakerId": 4284,
            "speakerName": "祖尔宛",
            "text": "#当然，要是多几个像{NICKNAME}和派蒙这样有趣的人物，那就另当别论。",
            "nextDialogs": [
              "736990111"
            ]
          },
          "736990111": {
            "id": "736990111",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "嘿嘿，祖尔宛夸我们了欸。",
            "nextDialogs": [
              "736990113",
              "736990116"
            ]
          },
          "736990113": {
            "id": "736990113",
            "speakerId": 13210,
            "speakerName": "斯露莎",
            "text": "等等…你、你怎么乱认前辈！",
            "nextDialogs": [
              "736990114"
            ]
          },
          "736990114": {
            "id": "736990114",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "斯露莎不要这么小气嘛，反正祖尔宛是这里的长者，我们叫一声前辈也很合理，对吧？",
            "nextDialogs": [
              "736990117"
            ]
          },
          "736990117": {
            "id": "736990117",
            "speakerId": 4284,
            "speakerName": "祖尔宛",
            "text": "不说闲话了，既然斯露莎还将在人类之中的声名看得这般重要，那么接下来的训练或许刚刚好吧。",
            "nextDialogs": [
              "736990118"
            ]
          },
          "736990118": {
            "id": "736990118",
            "speakerId": 4284,
            "speakerName": "祖尔宛",
            "text": "嗯，我就等你们的好消息了。"
          },
          "736990116": {
            "id": "736990116",
            "speakerId": 4284,
            "speakerName": "祖尔宛",
            "text": "以我的标准来说，的确是夸奖的词汇。"
          }
        }
      }
    },

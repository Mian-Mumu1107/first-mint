      }
    },
    {
      "subId": "7369906",
      "subQuestName": "与斯露莎对话",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "736990601"
        ],
        "dialogs": {
          "736990601": {
            "id": "736990601",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "哈，这不是之前来找米希尔时经过的地方么。不过米希尔现在应该不在这里吧？",
            "nextDialogs": [
              "736990602"
            ]
          },
          "736990602": {
            "id": "736990602",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "周围这些荆棘…应该都是米希尔的伙伴吧，看起来都还不错。说起来，我们之前还受过它们不少帮助呢。",
            "nextDialogs": [
              "736990603"
            ]
          },
          "736990603": {
            "id": "736990603",
            "speakerId": 13210,
            "speakerName": "斯露莎",
            "text": "白飘飘还真是…该不会把我的功劳全都忘了吧？",
            "nextDialogs": [
              "736990604"
            ]
          },
          "736990604": {
            "id": "736990604",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "怎么会，斯露莎虽然嘴上抱怨个不停，但是到底还是会将同族之谊放在心上的，对吧？",
            "nextDialogs": [
              "736990606",
              "736990608"
            ]
          },
          "736990606": {
            "id": "736990606",
            "speakerId": 13210,
            "speakerName": "斯露莎",
            "text": "身为「谒颂主」怎能这样健忘？罚你多写几篇颂诗！",
            "nextDialogs": [
              "736990609"
            ]
          },
          "736990609": {
            "id": "736990609",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "嘿嘿，我知道，斯露莎这就叫「刀子嘴豆腐心」！",
            "nextDialogs": [
              "736990610"
            ]
          },
          "736990610": {
            "id": "736990610",
            "speakerId": 13210,
            "speakerName": "斯露莎",
            "text": "才不是这样，我只是为了得到花冠…要不是前辈非让我来，哼…",
            "nextDialogs": [
              "736990611"
            ]
          },
          "736990611": {
            "id": "736990611",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "不管怎么说，斯露莎能获得「双角的花冠」，也是因为有米希尔，那岂不是应该好好感谢她？",
            "nextDialogs": [
              "736990612"
            ]
          },
          "736990612": {
            "id": "736990612",
            "speakerId": 13210,
            "speakerName": "斯露莎",
            "text": "那种曾经沾染污秽还难看挣扎的家伙…要我说，再走十遍「净罪的巡礼路」还差不多。",
            "nextDialogs": [
              "736990613"
            ]
          },
          "736990613": {
            "id": "736990613",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "十遍也太多了吧！等等…仔细想想好像也不是不能接受？"
          },
          "736990608": {
            "id": "736990608",
            "speakerId": 13210,
            "speakerName": "斯露莎",
            "text": "这样才对嘛，哼哼。"
          }
        }
      }
    }
  ]
}
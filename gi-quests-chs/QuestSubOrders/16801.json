  },
  "subQuests": [
    {
      "subId": "1680102",
      "subQuestName": "医生$HIDDEN",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "698571001"
        ],
        "dialogs": {
          "698571001": {
            "id": "698571001",
            "speakerId": 1000,
            "speakerName": "雅珂达",
            "text": "叶洛亚，你真的不能和我一起偷偷摸摸到怪物背后偷袭，把它们全部打倒吗？",
            "nextDialogs": [
              "698571002"
            ]
          },
          "698571002": {
            "id": "698571002",
            "speakerId": 1000,
            "speakerName": "雅珂达",
            "text": "我一轮可以行动三次欸，总共就四个怪物，我打倒三个，你打倒一个就行。",
            "nextDialogs": [
              "698571003"
            ]
          },
          "698571003": {
            "id": "698571003",
            "speakerId": 1001,
            "speakerName": "叶洛亚",
            "text": "我可以正面吸引怪物的注意力，但偷袭…",
            "nextDialogs": [
              "698571004"
            ]
          },
          "698571004": {
            "id": "698571004",
            "speakerId": 1002,
            "speakerName": "娜维娅",
            "text": "唉，这也是没办法的事。毕竟叶洛亚是选了「公正之杯」的「纯水骑士」嘛。",
            "nextDialogs": [
              "698571005"
            ]
          },
          "698571005": {
            "id": "698571005",
            "speakerId": 1003,
            "speakerName": "「主持人」",
            "text": "是的。如果叶洛亚选择从背后偷袭，那么就会被迫转为「弃誓骑士」，在进行所有行动时，都会附加一个巨大的减值。",
            "nextDialogs": [
              "698571006"
            ]
          },
          "698571006": {
            "id": "698571006",
            "speakerId": 1002,
            "speakerName": "娜维娅",
            "text": "这下糟糕了，要是不一口气打倒所有怪物，那我们所有人都要被炸药炸飞了啊！",
            "nextDialogs": [
              "698571007"
            ]
          },
          "698571007": {
            "id": "698571007",
            "speakerId": 1001,
            "speakerName": "叶洛亚",
            "text": "还有一个办法。我可以用「狂澜波」一口气冲到最深处，然后引爆炸药…",
            "nextDialogs": [
              "698571008"
            ]
          },
          "698571008": {
            "id": "698571008",
            "speakerId": 1002,
            "speakerName": "娜维娅",
            "text": "不行不行，那样你的角色不就要被「除名」了嘛！大家好不容易聚起来玩得这么开心，你一个人被「除名」也太可惜了啦。",
            "nextDialogs": [
              "698571009"
            ]
          },
          "698571009": {
            "id": "698571009",
            "speakerId": 1001,
            "speakerName": "叶洛亚",
            "text": "但是，如果不这样做，娜维娅小姐玩了这么久的「角色」恐怕也要被「除名」，这样不更可惜了吗？",
            "nextDialogs": [
              "698571010"
            ]
          },
          "698571010": {
            "id": "698571010",
            "speakerId": 1000,
            "speakerName": "雅珂达",
            "text": "我才刚玩没多久，不要啊——",
            "nextDialogs": [
              "698571011"
            ]
          },
          "698571011": {
            "id": "698571011",
            "speakerId": 1002,
            "speakerName": "娜维娅",
            "text": "呜——没关系，我还有一招。",
            "nextDialogs": [
              "698571012"
            ]
          },
          "698571012": {
            "id": "698571012",
            "speakerId": 1004,
            "speakerName": "克洛琳德",
            "text": "娜维娅，把蛋卷收回去。",
            "nextDialogs": [
              "698571013"
            ]
          },
          "698571013": {
            "id": "698571013",
            "speakerId": 1000,
            "speakerName": "雅珂达",
            "text": "呜哇！这一招也被防住了啊！",
            "nextDialogs": [
              "698571016"
            ]
          },
          "698571016": {
            "id": "698571016",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "这桌上的摆件，还有你们刚才说的话，你们这是在玩…",
            "nextDialogs": [
              "698571017"
            ]
          },
          "698571017": {
            "id": "698571017",
            "speakerId": 1002,
            "speakerName": "娜维娅",
            "text": "#救星来啦！{NICKNAME}，你来得正好！快快快，快加入我们！",
            "nextDialogs": [
              "698571018"
            ]
          },
          "698571018": {
            "id": "698571018",
            "speakerId": 1002,
            "speakerName": "娜维娅",
            "text": "克洛琳德，这样应该不算违反规则吧？",
            "nextDialogs": [
              "698571103"
            ]
          },
          "698571103": {
            "id": "698571103",
            "speakerId": 1004,
            "speakerName": "克洛琳德",
            "text": "#如果{NICKNAME}同意的话。顺便一提，为了照顾新人，我们现在玩的难度是「轻松体验」。",
            "nextDialogs": [
              "698571104"
            ]
          },
          "698571104": {
            "id": "698571104",
            "speakerId": 1002,
            "speakerName": "娜维娅",
            "text": "#{NICKNAME}，你愿意和我们继续冒险吗？肯定愿意的，对吧？"
          }
        }
      }
    },
    {
      "subId": "1680103",
      "subQuestName": "厨师$HIDDEN",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [],
        "dialogs": {}
      }
    },
    {
      "subId": "1680105",
      "subQuestName": "",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "698571301"
        ],
        "dialogs": {
          "698571301": {
            "id": "698571301",
            "speakerId": 1004,
            "speakerName": "克洛琳德",
            "text": "好。那么游戏继续。",
            "nextDialogs": [
              "698571302"
            ]
          },
          "698571302": {
            "id": "698571302",
            "speakerId": 1003,
            "speakerName": "「主持人」",
            "text": "「…就在所有人束手无策之时，一个熟悉的声音却从众人的背后响起。」",
            "nextDialogs": [
              "698571402",
              "698571502"
            ]
          },
          "698571402": {
            "id": "698571402",
            "speakerId": 1002,
            "speakerName": "娜维娅",
            "text": "#{NICKNAME}，你怎么会在这里？难、难道是听到了我们的呼唤？",
            "nextDialogs": [
              "698571403"
            ]
          },
          "698571403": {
            "id": "698571403",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "#（怎么把{NICKNAME}说得和召唤灵一样…啊，这么一想，确实很像呢，嘿嘿嘿…）",
            "nextDialogs": [
              "698571404"
            ]
          },
          "698571404": {
            "id": "698571404",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "是、是啊…我听见了呼唤，我必须回应！",
            "nextDialogs": [
              "698571405"
            ]
          },
          "698571405": {
            "id": "698571405",
            "speakerId": 1000,
            "speakerName": "雅珂达",
            "text": "（这意思就是：「我是被突然莫名其妙拉进来玩游戏的啊！」吧…）",
            "nextDialogs": [
              "698571701"
            ]
          },
          "698571701": {
            "id": "698571701",
            "speakerId": 1001,
            "speakerName": "叶洛亚",
            "text": "#（不愧是{NICKNAME}，好强的代入感啊…）",
            "nextDialogs": [
              "698571801"
            ]
          },
          "698571801": {
            "id": "698571801",
            "speakerId": 1003,
            "speakerName": "「主持人」",
            "text": "「虽然逐影猎人们彼此之间还有许多话想要倾诉，但此时此刻，久别重逢的喜悦必须要让位于迫在眉睫的危机。」",
            "nextDialogs": [
              "698571802"
            ]
          },
          "698571802": {
            "id": "698571802",
            "speakerId": 1003,
            "speakerName": "「主持人」",
            "text": "那么，战斗轮继续。第一轮由你们行动。",
            "nextDialogs": [
              "698571803"
            ]
          },
          "698571803": {
            "id": "698571803",
            "speakerId": 1003,
            "speakerName": "「主持人」",
            "text": "另外。因为临时加入了新成员，所以我要为敌人的各项能力加上数张「暗卡」。",
            "nextDialogs": [
              "698571804"
            ]
          },
          "698571804": {
            "id": "698571804",
            "speakerId": 1002,
            "speakerName": "娜维娅",
            "text": "#{NICKNAME}才不是突然加入的，{M#他}{F#她}一直和我们旅行啊。",
            "nextDialogs": [
              "698571805"
            ]
          },
          "698571805": {
            "id": "698571805",
            "speakerId": 1002,
            "speakerName": "娜维娅",
            "text": "只不过…呃…突然离开了一小段时间而已…",
            "nextDialogs": [
              "698571806"
            ]
          },
          "698571806": {
            "id": "698571806",
            "speakerId": 1003,
            "speakerName": "「主持人」",
            "text": "我已经算好「暗卡」数量了。你们该商量战术了。",
            "nextDialogs": [
              "698571807"
            ]
          },
          "698571807": {
            "id": "698571807",
            "speakerId": 1002,
            "speakerName": "娜维娅",
            "text": "欸——克洛琳德好严格哦…",
            "nextDialogs": [
              "698571808"
            ]
          },
          "698571808": {
            "id": "698571808",
            "speakerId": 1002,
            "speakerName": "娜维娅",
            "text": "#那么就按照原本的战术来吧，既然有了{NICKNAME}的加入，我们的人手就足够了。",
            "nextDialogs": [
              "698571809"
            ]
          },
          "698571809": {
            "id": "698571809",
            "speakerId": 1002,
            "speakerName": "娜维娅",
            "text": "我和叶洛亚待在正面，抵挡住怪物的攻势。",
            "nextDialogs": [
              "698571810"
            ]
          },
          "698571810": {
            "id": "698571810",
            "speakerId": 1002,
            "speakerName": "娜维娅",
            "text": "#雅珂达和{NICKNAME}就绕到背后，把怪物从背后一口气全部打倒。",
            "nextDialogs": [
              "698571811"
            ]
          },
          "698571811": {
            "id": "698571811",
            "speakerId": 1000,
            "speakerName": "雅珂达",
            "text": "好嘞，交给我吧。嘿嘿，从背后攻击的时候，「炼气士」可是有着很高的伤害增强呢。",
            "nextDialogs": [
              "698571901"
            ]
          },
          "698571901": {
            "id": "698571901",
            "speakerId": 1000,
            "speakerName": "雅珂达",
            "text": "#不过…{NICKNAME}，你为什么是厨师啊。厨师要怎么…偷袭呢？"
          },
          "698571502": {
            "id": "698571502",
            "speakerId": 1002,
            "speakerName": "娜维娅",
            "text": "#{NICKNAME}，你怎么会在这里？难、难道是听到了我们的呼唤？",
            "nextDialogs": [
              "698571503"
            ]
          },
          "698571503": {
            "id": "698571503",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "#（怎么把{NICKNAME}说得和召唤灵一样…啊，这么一想，确实很像呢，嘿嘿嘿…）",
            "nextDialogs": [
              "698571504"
            ]
          },
          "698571504": {
            "id": "698571504",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "是、是啊…我听见了呼唤，我必须回应！",
            "nextDialogs": [
              "698571505"
            ]
          },
          "698571505": {
            "id": "698571505",
            "speakerId": 1000,
            "speakerName": "雅珂达",
            "text": "（这意思就是：「我是被突然莫名其妙拉进来玩游戏的啊！」吧…）",
            "nextDialogs": [
              "698571601"
            ]
          },
          "698571601": {
            "id": "698571601",
            "speakerId": 1001,
            "speakerName": "叶洛亚",
            "text": "（不愧是娜维娅小姐之前提过的老玩家，一下子就代入了啊…）"
          }
        }
      }
    },
    {
      "subId": "1680107",
      "subQuestName": "",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "698572101"
        ],
        "dialogs": {
          "698572101": {
            "id": "698572101",
            "speakerId": 1000,
            "speakerName": "雅珂达",
            "text": "是这样啊…「桌上剧团」的这种游戏还真是复杂啊，真需要想象力…",
            "nextDialogs": [
              "698572102"
            ]
          },
          "698572102": {
            "id": "698572102",
            "speakerId": 1002,
            "speakerName": "娜维娅",
            "text": "#不愧是{NICKNAME}，一下子就想出来战斗方法了。但我还要多说一句，叶洛亚，你这次可不能一个人冲出去了。",
            "nextDialogs": [
              "698572103"
            ]
          },
          "698572103": {
            "id": "698572103",
            "speakerId": 1001,
            "speakerName": "叶洛亚",
            "text": "我明白。「纯水骑士」的职责是保护队友，成为他们的盾牌…抱歉，我总是忍不住…",
            "nextDialogs": [
              "698572104"
            ]
          },
          "698572104": {
            "id": "698572104",
            "speakerId": 1000,
            "speakerName": "雅珂达",
            "text": "哎呀，没关系的。我现在可以一轮行动三次，我肯定追得上你，放开了玩吧。",
            "nextDialogs": [
              "698572105"
            ]
          },
          "698572105": {
            "id": "698572105",
            "speakerId": 1002,
            "speakerName": "娜维娅",
            "text": "那就交给你了，叶洛亚！",
            "nextDialogs": [
              "698572106"
            ]
          },
          "698572106": {
            "id": "698572106",
            "speakerId": 1001,
            "speakerName": "叶洛亚",
            "text": "那我…使用这面纯水骑士盾牌上附带的技能「破邪号令」！",
            "nextDialogs": [
              "698572107"
            ]
          },
          "698572107": {
            "id": "698572107",
            "speakerId": 1003,
            "speakerName": "「主持人」",
            "text": "「纯水骑士举起手中的盾牌，高声颂唱着骑士的箴言。怪物们完全被公正的光辉——还有光辉下那位无畏的骑士——吸引住了注意力。」",
            "nextDialogs": [
              "698572108"
            ]
          },
          "698572108": {
            "id": "698572108",
            "speakerId": 1003,
            "speakerName": "「主持人」",
            "text": "「而埋伏在后方的两位同伴，也抓住了这个机会。准备发动攻势。」",
            "nextDialogs": [
              "698572109"
            ]
          },
          "698572109": {
            "id": "698572109",
            "speakerId": 1000,
            "speakerName": "雅珂达",
            "text": "那你先出手，我随后攻击。",
            "nextDialogs": [
              "698572202",
              "698572302",
              "698572402",
              "698572502",
              "698572602",
              "698572702",
              "698572802",
              "698572902"
            ]
          },
          "698572202": {
            "id": "698572202",
            "speakerId": 1003,
            "speakerName": "「主持人」",
            "text": "#「逐影猎人的身手不减往日，{M#他}{F#她}敏捷地跃出草丛，用平底锅重重地轰击了敌人的后脑。」",
            "nextDialogs": [
              "698572203"
            ]
          },
          "698572203": {
            "id": "698572203",
            "speakerId": 1003,
            "speakerName": "「主持人」",
            "text": "「即使平底锅只是普通的平底锅，但逐影猎人却不是普通的厨师。敌人哼了一声，就彻底倒下了。」",
            "nextDialogs": [
              "698573001"
            ]
          },
          "698573001": {
            "id": "698573001",
            "speakerId": 1000,
            "speakerName": "雅珂达",
            "text": "成…成功了！太好了，接下来我要…对，我要先用「疾行如风」拉近距离，然后用「四象击」从背后…",
            "nextDialogs": [
              "698573101"
            ]
          },
          "698573101": {
            "id": "698573101",
            "speakerId": 1000,
            "speakerName": "雅珂达",
            "text": "果然没有成功啊！不管了，反正怪物都冲上来了，就在原地用「四象击」炸飞它们…",
            "nextDialogs": [
              "698573201"
            ]
          },
          "698573201": {
            "id": "698573201",
            "speakerId": 1000,
            "speakerName": "雅珂达",
            "text": "哎哟！好痛，什么东西咬我的腿…咦，阿舍鲁，你怎么来了？",
            "nextDialogs": [
              "698573202"
            ]
          },
          "698573202": {
            "id": "698573202",
            "speakerId": 1006,
            "speakerName": "阿舍鲁",
            "text": "喵，喵——",
            "nextDialogs": [
              "698573203"
            ]
          },
          "698573203": {
            "id": "698573203",
            "speakerId": 1000,
            "speakerName": "雅珂达",
            "text": "啊…！都这个点了？！完蛋了完蛋了，老板交代的事我完全忘记了啊！",
            "nextDialogs": [
              "698573204"
            ]
          },
          "698573204": {
            "id": "698573204",
            "speakerId": 1000,
            "speakerName": "雅珂达",
            "text": "对不起对不起，我我我我我暂时不能玩了——",
            "nextDialogs": [
              "698573205"
            ]
          },
          "698573205": {
            "id": "698573205",
            "speakerId": 1006,
            "speakerName": "阿舍鲁",
            "text": "喵，喵喵喵~",
            "nextDialogs": [
              "698573206"
            ]
          },
          "698573206": {
            "id": "698573206",
            "speakerId": 1000,
            "speakerName": "雅珂达",
            "text": "阿舍鲁，等等我啊！喂，跑那么快干什么啊！",
            "nextDialogs": [
              "698573207"
            ]
          },
          "698573207": {
            "id": "698573207",
            "speakerId": 1004,
            "speakerName": "克洛琳德",
            "text": "…看来，我们今天只能玩到这里了。",
            "nextDialogs": [
              "698573208"
            ]
          },
          "698573208": {
            "id": "698573208",
            "speakerId": 1004,
            "speakerName": "克洛琳德",
            "text": "娜维娅，把怪物指示牌放回原处，我看见了。"
          },
          "698572302": {
            "id": "698572302",
            "speakerId": 1003,
            "speakerName": "「主持人」",
            "text": "「逐影猎人猛地跃出了草丛，猛地将平底锅砸向了敌人。」",
            "nextDialogs": [
              "698572303"
            ]
          },
          "698572303": {
            "id": "698572303",
            "speakerId": 1003,
            "speakerName": "「主持人」",
            "text": "「不过，虽然逐影猎人并不是普通的厨师，但平底锅却只是普通的平底锅。」",
            "nextDialogs": [
              "698572304"
            ]
          },
          "698572304": {
            "id": "698572304",
            "speakerId": 1003,
            "speakerName": "「主持人」",
            "text": "「在轰上敌人后脑的瞬间，平底锅四分五裂，在短暂的眩晕后，敌人转过头，怒视着手无寸铁的逐影猎人。」"
          },
          "698572402": {
            "id": "698572402",
            "speakerId": 1003,
            "speakerName": "「主持人」",
            "text": "「逐影猎人熟练地掏出厨具开始烹饪，很快便做出了一道美味至极的餐食。」",
            "nextDialogs": [
              "698572403"
            ]
          },
          "698572403": {
            "id": "698572403",
            "speakerId": 1003,
            "speakerName": "「主持人」",
            "text": "#「被香味引诱而来的敌人，完全将注意力放在了美味的餐食上，却忽视了逐影猎人和{M#他}{F#她}的同伴」"
          },
          "698572502": {
            "id": "698572502",
            "speakerId": 1003,
            "speakerName": "「主持人」",
            "text": "「逐影猎人熟练地掏出厨具开始烹饪，很快便做出了一道餐食。」",
            "nextDialogs": [
              "698572503"
            ]
          },
          "698572503": {
            "id": "698572503",
            "speakerId": 1003,
            "speakerName": "「主持人」",
            "text": "「被烹饪声响引诱而来的敌人，不解地看着正在做饭的逐影猎人，旁边的餐食似乎也无法吸引它们的注意力。」"
          },
          "698572602": {
            "id": "698572602",
            "speakerId": 1003,
            "speakerName": "「主持人」",
            "text": "「逐影猎人掏出了自己药箱中的药物，熟练地配置出了一罐麻醉用药剂。」",
            "nextDialogs": [
              "698572603"
            ]
          },
          "698572603": {
            "id": "698572603",
            "speakerId": 1003,
            "speakerName": "「主持人」",
            "text": "#「{M#他}{F#她}将这瓶药剂悄悄地滚到了敌人的脚下，顷刻后，毫无防备的敌人全部昏迷了。」"
          },
          "698572702": {
            "id": "698572702",
            "speakerId": 1003,
            "speakerName": "「主持人」",
            "text": "#「逐影猎人掏出了自己药箱中的药物，正准备配置药剂，但{M#他}{F#她}却不小心打翻了一味原料。」",
            "nextDialogs": [
              "698572703"
            ]
          },
          "698572703": {
            "id": "698572703",
            "speakerId": 1003,
            "speakerName": "「主持人」",
            "text": "#「泄露的原料污染了其他药物，各类药物互相发生作用，腾起了剧毒的烟雾，让逐影猎人和{M#他}{F#她}的同伴咳嗽连连，头晕目眩。」"
          },
          "698572802": {
            "id": "698572802",
            "speakerId": 1003,
            "speakerName": "「主持人」",
            "text": "#「逐影猎人猛地将整个药箱掷向了敌人。就和{M#他}{F#她}预想的一般，药箱碎裂后，里面的药物也彼此混合了起来。」",
            "nextDialogs": [
              "698572803"
            ]
          },
          "698572803": {
            "id": "698572803",
            "speakerId": 1003,
            "speakerName": "「主持人」",
            "text": "「在剧毒的烟雾里，已经被药箱重击过一次后脑的敌人头晕目眩，昏倒在地。」"
          },
          "698572902": {
            "id": "698572902",
            "speakerId": 1003,
            "speakerName": "「主持人」",
            "text": "#「逐影猎人猛地将整个药箱掷向了敌人。虽然精确命中了敌人的后脑，但这个药箱的坚固程度远超{M#他}{F#她}的想象。」",
            "nextDialogs": [
              "698572903"
            ]
          },
          "698572903": {
            "id": "698572903",
            "speakerId": 1003,
            "speakerName": "「主持人」",
            "text": "「药箱并没有碎裂，虽然内部的药物确实已经混合产生了剧毒的烟雾，但这股烟雾，却被药箱牢牢封堵，一丝也没漏出来。」"
          }
        }
      }
    }
  ]
}
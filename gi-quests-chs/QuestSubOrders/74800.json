  "subQuests": [
    {
      "subId": "7480001",
      "subQuestName": "和吉雅罗对话",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "748000101"
        ],
        "dialogs": {
          "748000101": {
            "id": "748000101",
            "speakerId": 1000,
            "speakerName": "吉雅罗",
            "text": "应该不会…应该不会…",
            "nextDialogs": [
              "748000102"
            ]
          },
          "748000102": {
            "id": "748000102",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "你在干什么？",
            "nextDialogs": [
              "748000103"
            ]
          },
          "748000103": {
            "id": "748000103",
            "speakerId": 1000,
            "speakerName": "吉雅罗",
            "text": "啊！别！我什么也没干，别伤害我！",
            "nextDialogs": [
              "748000104"
            ]
          },
          "748000104": {
            "id": "748000104",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "你在说什么呢。我们为什么要伤害你呀？",
            "nextDialogs": [
              "748000105"
            ]
          },
          "748000105": {
            "id": "748000105",
            "speakerId": 1000,
            "speakerName": "吉雅罗",
            "text": "我不知道！但我也不知道你们不会伤害我。",
            "nextDialogs": [
              "748000108"
            ]
          },
          "748000108": {
            "id": "748000108",
            "speakerId": 1000,
            "speakerName": "吉雅罗",
            "text": "对了…对了！一定是因为我发现了你们的秘密，对吧？",
            "nextDialogs": [
              "748000109"
            ]
          },
          "748000109": {
            "id": "748000109",
            "speakerId": 1000,
            "speakerName": "吉雅罗",
            "text": "是…是我在咖啡馆里拿走了夹着你们密信的报纸？",
            "nextDialogs": [
              "748000110"
            ]
          },
          "748000110": {
            "id": "748000110",
            "speakerId": 1000,
            "speakerName": "吉雅罗",
            "text": "还是我不小心看见了你们接头的密语？等等，难道是我昨晚上吃的那一条鱼…",
            "nextDialogs": [
              "748000111"
            ]
          },
          "748000111": {
            "id": "748000111",
            "speakerId": 1000,
            "speakerName": "吉雅罗",
            "text": "我就说那条鱼为什么刺那么少，是你们把那条鱼身上的刺给剔下来的！",
            "nextDialogs": [
              "748000112"
            ]
          },
          "748000112": {
            "id": "748000112",
            "speakerId": 1000,
            "speakerName": "吉雅罗",
            "text": "对，对，你们想用鱼骨两侧不同的鱼刺数量传递消息…但这条鱼却阴差阳错被我买回了家…",
            "nextDialogs": [
              "748000113"
            ]
          },
          "748000113": {
            "id": "748000113",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "这家伙，到底在说什么呀？完全听不明白…"
          }
        }
      }
    },
    {
      "subId": "7480007",
      "subQuestName": "前往巡轨船附近",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "748000201"
        ],
        "dialogs": {
          "748000201": {
            "id": "748000201",
            "speakerId": 1000,
            "speakerName": "吉雅罗",
            "text": "旁边就是巡轨船了…等会我们一起上去吧。"
          }
        }
      }
    },
    {
      "subId": "7480006",
      "subQuestName": "和吉雅罗对话",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "748000801"
        ],
        "dialogs": {
          "748000801": {
            "id": "748000801",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "…我说啊。为什么你一直蹲在地上？还抱着头。",
            "nextDialogs": [
              "748000802"
            ]
          },
          "748000802": {
            "id": "748000802",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "难道你是怕被撞到头吗？但这里连顶都没有啊。",
            "nextDialogs": [
              "748000803"
            ]
          },
          "748000803": {
            "id": "748000803",
            "speakerId": 1000,
            "speakerName": "吉雅罗",
            "text": "嘘，快过来，你们快和我一起趴下！这里很危险…",
            "nextDialogs": [
              "748000804"
            ]
          },
          "748000804": {
            "id": "748000804",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "这个人又开始了…",
            "nextDialogs": [
              "748000805"
            ]
          },
          "748000805": {
            "id": "748000805",
            "speakerId": 1000,
            "speakerName": "吉雅罗",
            "text": "这条巡轨船的顶上没有任何遮挡，如果在两侧立起两根竖杆，中间再挂上一根钓鱼线…",
            "nextDialogs": [
              "748000806"
            ]
          },
          "748000806": {
            "id": "748000806",
            "speakerId": 1000,
            "speakerName": "吉雅罗",
            "text": "只要巡轨船路过那两根竖杆之间，那根钓鱼线就会瞬间切向…",
            "nextDialogs": [
              "748000807"
            ]
          },
          "748000807": {
            "id": "748000807",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "呜哇！别说啦！",
            "nextDialogs": [
              "748000808"
            ]
          },
          "748000808": {
            "id": "748000808",
            "speakerId": 1000,
            "speakerName": "吉雅罗",
            "text": "不、不，甚至不需要两根竖杆，只需要一根…",
            "nextDialogs": [
              "748000809"
            ]
          },
          "748000809": {
            "id": "748000809",
            "speakerId": 1000,
            "speakerName": "吉雅罗",
            "text": "只要在上面挂上一根带鱼钩的鱼线，让它垂在半空…",
            "nextDialogs": [
              "748000810"
            ]
          },
          "748000810": {
            "id": "748000810",
            "speakerId": 1000,
            "speakerName": "吉雅罗",
            "text": "巡轨船上的人，就会自然而然地被鱼钩勾住，然后…",
            "nextDialogs": [
              "748000811"
            ]
          },
          "748000811": {
            "id": "748000811",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "我不听我不听我不听我不听…",
            "nextDialogs": [
              "748000812"
            ]
          },
          "748000812": {
            "id": "748000812",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "听她说了一路，连我都有点害怕了…",
            "nextDialogs": [
              "748000813"
            ]
          },
          "748000813": {
            "id": "748000813",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "等到站了之后，我们就快下去吧…"
          }
        }
      }
    },
    {
      "subId": "7480003",
      "subQuestName": "前往咖啡馆",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "748000401"
        ],
        "dialogs": {
          "748000401": {
            "id": "748000401",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "你怎么又躲起来了，这周围什么也没有啊？",
            "nextDialogs": [
              "748000402"
            ]
          },
          "748000402": {
            "id": "748000402",
            "speakerId": 1000,
            "speakerName": "吉雅罗",
            "text": "你没看见那台警卫机关吗？就在我们面前！",
            "nextDialogs": [
              "748000405"
            ]
          },
          "748000405": {
            "id": "748000405",
            "speakerId": 1000,
            "speakerName": "吉雅罗",
            "text": "嘘，快点离开那边，这警卫机关要是失控了怎么办？",
            "nextDialogs": [
              "748000406"
            ]
          },
          "748000406": {
            "id": "748000406",
            "speakerId": 1000,
            "speakerName": "吉雅罗",
            "text": "或者它…它的能源核心突然发生爆炸，或者是被人遥控着攻击我们！",
            "nextDialogs": [
              "748000407"
            ]
          },
          "748000407": {
            "id": "748000407",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "但它一切正常。",
            "nextDialogs": [
              "748000408"
            ]
          },
          "748000408": {
            "id": "748000408",
            "speakerId": 1000,
            "speakerName": "吉雅罗",
            "text": "这正是我害怕的。一个原本正常的机关突然失控，让某个倒霉蛋丢了命…",
            "nextDialogs": [
              "748000409"
            ]
          },
          "748000409": {
            "id": "748000409",
            "speakerId": 1000,
            "speakerName": "吉雅罗",
            "text": "这件事不会有任何人为其负责，说不定连作案主使都找不到…实在是太危险了！",
            "nextDialogs": [
              "748000410"
            ]
          },
          "748000410": {
            "id": "748000410",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "它已经走了喔，你可以出来了。",
            "nextDialogs": [
              "748000411"
            ]
          },
          "748000411": {
            "id": "748000411",
            "speakerId": 1000,
            "speakerName": "吉雅罗",
            "text": "喔，它真的没有失控，真是出乎预料。我们又捡了一条命啊。"
          }
        }
      }
    },
    {
      "subId": "7480005",

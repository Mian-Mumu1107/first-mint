            "id": "748000501",
            "speakerId": 1000,
            "speakerName": "吉雅罗",
            "text": "对，没错…就是这样…",
            "nextDialogs": [
              "748000504"
            ]
          },
          "748000504": {
            "id": "748000504",
            "speakerId": 1000,
            "speakerName": "吉雅罗",
            "text": "#好的，谢谢你，{NICKNAME}。多谢一路护送我过来。",
            "nextDialogs": [
              "748000505"
            ]
          },
          "748000505": {
            "id": "748000505",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "说是护送…其实我们只是跟着你走了一路而已，什么也没做啊。"
          }
        }
      }
    },

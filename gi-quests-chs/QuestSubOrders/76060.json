  "subQuests": [
    {
      "subId": "7606001",
      "subQuestName": "同「少女」见面",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "760600101"
        ],
        "dialogs": {
          "760600101": {
            "id": "760600101",
            "speakerId": 1000,
            "speakerName": "梅拉",
            "text": "……",
            "nextDialogs": [
              "760600102"
            ]
          },
          "760600102": {
            "id": "760600102",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "咦？这不是梅拉吗？它又出去取材了？",
            "nextDialogs": [
              "760600103"
            ]
          },
          "760600103": {
            "id": "760600103",
            "speakerId": 1002,
            "speakerName": "「少女」",
            "text": "嗯，但它回来后就一直这样，像是在思考什么一样。",
            "nextDialogs": [
              "760600104"
            ]
          },
          "760600104": {
            "id": "760600104",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "说不定这次的主题比较深刻呢，就像大画家突然顿悟了世间真理什么的。",
            "nextDialogs": [
              "760600105"
            ]
          },
          "760600105": {
            "id": "760600105",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "说起来，梅拉已经给过我们好多幅画了呢，要是再这么画下去的话，都可以为它专门办个画展了吧？",
            "nextDialogs": [
              "760600106"
            ]
          },
          "760600106": {
            "id": "760600106",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "哼哼，到时候就由我来为人们讲述大画家梅拉的创作历程。当然，真要办画展的话，也得哥伦比娅同意才行。",
            "nextDialogs": [
              "760600107"
            ]
          },
          "760600107": {
            "id": "760600107",
            "speakerId": 1002,
            "speakerName": "「少女」",
            "text": "嗯？为什么？",
            "nextDialogs": [
              "760600108"
            ]
          },
          "760600108": {
            "id": "760600108",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "梅拉画的几乎都是你…",
            "nextDialogs": [
              "760600109"
            ]
          },
          "760600109": {
            "id": "760600109",
            "speakerId": 1002,
            "speakerName": "「少女」",
            "text": "哦，没事，我不介意。听起来挺有趣的。",
            "nextDialogs": [
              "760600110"
            ]
          },
          "760600110": {
            "id": "760600110",
            "speakerId": 1000,
            "speakerName": "梅拉",
            "text": "~！",
            "nextDialogs": [
              "760600111"
            ]
          },
          "760600111": {
            "id": "760600111",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "哦！梅拉好像决定要画什么了！快快快，看看我们有什么合适的颜料。",
            "nextDialogs": [
              "760600112"
            ]
          },
          "760600112": {
            "id": "760600112",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "这次的话…就选一些比较深沉、静谧的颜色吧！"
          }
        }
      }
    },
    {
      "subId": "7606002",
      "subQuestName": "将一些色彩丰富的东西交给月灵",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "760600201"
        ],
        "dialogs": {
          "760600201": {
            "id": "760600201",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "（深沉而又静谧的颜色…）"
          }
        }
      }
    },
    {
      "subId": "7606003",
      "subQuestName": "观看月灵的画作",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "760600301"
        ],
        "dialogs": {
          "760600301": {
            "id": "760600301",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "好，就这些吧。梅拉觉得呢？",
            "nextDialogs": [
              "760600302"
            ]
          },
          "760600302": {
            "id": "760600302",
            "speakerId": 1000,
            "speakerName": "梅拉",
            "text": "~！",
            "nextDialogs": [
              "760600303"
            ]
          },
          "760600303": {
            "id": "760600303",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "它看起来挺满意的。嘿嘿…这次会是怎样的一幅画呢？",
            "nextDialogs": [
              "760600304"
            ]
          },
          "760600304": {
            "id": "760600304",
            "speakerId": 1000,
            "speakerName": "梅拉",
            "text": "……",
            "nextDialogs": [
              "760600305"
            ]
          },
          "760600305": {
            "id": "760600305",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "咦？已经画好了吗？",
            "nextDialogs": [
              "760600306"
            ]
          },
          "760600306": {
            "id": "760600306",
            "speakerId": 1000,
            "speakerName": "梅拉",
            "text": "……",
            "nextDialogs": [
              "760600307"
            ]
          },
          "760600307": {
            "id": "760600307",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "梅拉的样子，看起来有些伤心呢，是因为画的关系吗？我看看…",
            "nextDialogs": [
              "760600308"
            ]
          },
          "760600308": {
            "id": "760600308",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "啊，这次画的也是哥伦比娅呢，这是在…月光下散步吗？画中的你还抬头望着夜空。",
            "nextDialogs": [
              "760600309"
            ]
          },
          "760600309": {
            "id": "760600309",
            "speakerId": 1002,
            "speakerName": "「少女」",
            "text": "我大概…是在看虚假之天外的那轮月亮吧。以前经常这么在晚上散步。",
            "nextDialogs": [
              "760600310"
            ]
          },
          "760600310": {
            "id": "760600310",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "以前？啊…这么说来…",
            "nextDialogs": [
              "760600311"
            ]
          },
          "760600311": {
            "id": "760600311",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "（现在的哥伦比娅几乎只能待在这处庭园里…明明挪德卡莱是她诞生的地方…）",
            "nextDialogs": [
              "760600312"
            ]
          },
          "760600312": {
            "id": "760600312",
            "speakerId": 1002,
            "speakerName": "「少女」",
            "text": "以前散步的时候就会想，那个真实的「霜月」上究竟有些什么？",
            "nextDialogs": [
              "760600313"
            ]
          },
          "760600313": {
            "id": "760600313",
            "speakerId": 1002,
            "speakerName": "「少女」",
            "text": "会不会也像这边一样，有很多小动物…",
            "nextDialogs": [
              "760600314"
            ]
          },
          "760600314": {
            "id": "760600314",
            "speakerId": 1002,
            "speakerName": "「少女」",
            "text": "还是说，其实什么都没有呢。",
            "nextDialogs": [
              "760600315"
            ]
          },
          "760600315": {
            "id": "760600315",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "唔…",
            "nextDialogs": [
              "760600317",
              "760600320"
            ]
          },
          "760600317": {
            "id": "760600317",
            "speakerId": 1002,
            "speakerName": "「少女」",
            "text": "哈，你的想法很有趣。",
            "nextDialogs": [
              "760600318"
            ]
          },
          "760600318": {
            "id": "760600318",
            "speakerId": 1002,
            "speakerName": "「少女」",
            "text": "不过…月亮在虚假之天外，或许还是不要让这里的小动物们陪我一起去冒险比较好…",
            "nextDialogs": [
              "760600322"
            ]
          },
          "760600322": {
            "id": "760600322",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "（一边是无法自由行动的「家」…一边是不知道有什么的「家」…）",
            "nextDialogs": [
              "760600323"
            ]
          },
          "760600323": {
            "id": "760600323",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "（……）",
            "nextDialogs": [
              "760600324"
            ]
          },
          "760600324": {
            "id": "760600324",
            "speakerId": 1000,
            "speakerName": "梅拉",
            "text": "……",
            "nextDialogs": [
              "760600325"
            ]
          },
          "760600325": {
            "id": "760600325",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "梅拉一定也很舍不得你走吧。",
            "nextDialogs": [
              "760600326"
            ]
          },
          "760600326": {
            "id": "760600326",
            "speakerId": 1002,
            "speakerName": "「少女」",
            "text": "我也舍不得它们。",
            "nextDialogs": [
              "760600327"
            ]
          },
          "760600327": {
            "id": "760600327",
            "speakerId": 1002,
            "speakerName": "「少女」",
            "text": "但这终究是我一个人的旅行。是需要我独自去寻找的答案。",
            "nextDialogs": [
              "760600328"
            ]
          },
          "760600328": {
            "id": "760600328",
            "speakerId": 1002,
            "speakerName": "「少女」",
            "text": "说不定，这个答案其实很美好呢？",
            "nextDialogs": [
              "760600329"
            ]
          },
          "760600329": {
            "id": "760600329",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "那，那到时候我们就带着梅拉一起去看望你！",
            "nextDialogs": [
              "760600330"
            ]
          },
          "760600330": {
            "id": "760600330",
            "speakerId": 1002,
            "speakerName": "「少女」",
            "text": "好啊，办一个月亮上的画展。",
            "nextDialogs": [
              "760600331"
            ]
          },
          "760600331": {
            "id": "760600331",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "哇，听起来就不错！说好了啊！",
            "nextDialogs": [
              "760600332"
            ]
          },
          "760600332": {
            "id": "760600332",
            "speakerId": 1002,
            "speakerName": "「少女」",
            "text": "嗯…",
            "nextDialogs": [
              "760600333"
            ]
          },
          "760600333": {
            "id": "760600333",
            "speakerId": 1002,
            "speakerName": "「少女」",
            "text": "希望如此…"
          },
          "760600320": {
            "id": "760600320",
            "speakerId": 1002,
            "speakerName": "「少女」",
            "text": "唔，希望如此。",
            "nextDialogs": [
              "760600321"
            ]
          },
          "760600321": {
            "id": "760600321",
            "speakerId": 1002,
            "speakerName": "「少女」",
            "text": "也希望它们欢迎我这个突然回家的「神明」吧。"
          }
        }
      }
    },
    {

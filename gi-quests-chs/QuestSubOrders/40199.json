  "subQuests": [
    {
      "subId": "4019901",
      "subQuestName": "前往遗珑埠品茶",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "401990101"
        ],
        "dialogs": {
          "401990101": {
            "id": "401990101",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "欸，那边在喝茶的人…不是夜兰吗？",
            "nextDialogs": [
              "401990102"
            ]
          },
          "401990102": {
            "id": "401990102",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "她好像在和朋友聚会？我们来得正巧！",
            "nextDialogs": [
              "401990105"
            ]
          },
          "401990105": {
            "id": "401990105",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "欸，不上去打招呼吗？",
            "nextDialogs": [
              "401990106"
            ]
          },
          "401990106": {
            "id": "401990106",
            "speakerId": 1048,
            "speakerName": "夜兰",
            "text": "前前后后忙了这么久，应该没有漏网之鱼了吧，埃德勒警官？",
            "nextDialogs": [
              "401990107"
            ]
          },
          "401990107": {
            "id": "401990107",
            "speakerId": 1048,
            "speakerName": "夜兰",
            "text": "外勤办案的时间应当还有几天，正好用来犒赏自己，适当度个假？",
            "nextDialogs": [
              "401990108"
            ]
          },
          "401990108": {
            "id": "401990108",
            "speakerId": 30818,
            "speakerName": "埃德勒",
            "text": "多谢您热情招待，夜兰小姐，这阵子简直忙掉了我半条命…",
            "nextDialogs": [
              "401990109"
            ]
          },
          "401990109": {
            "id": "401990109",
            "speakerId": 30818,
            "speakerName": "埃德勒",
            "text": "唔哎…十三个据点啊…那些家伙简直都是盗宝鼬成精！乌泱泱抓出那么一大批人的时候，我都怀疑冤枉了谁！",
            "nextDialogs": [
              "401990110"
            ]
          },
          "401990110": {
            "id": "401990110",
            "speakerId": 30818,
            "speakerName": "埃德勒",
            "text": "好在，终于把这帮经济犯一锅端掉了！现在，我就要去翘英庄，找我那位工程师同学安心叙叙旧。",
            "nextDialogs": [
              "401990111"
            ]
          },
          "401990111": {
            "id": "401990111",
            "speakerId": 1048,
            "speakerName": "夜兰",
            "text": "别忘了带些茶叶和点心，给执律庭的朋友们当礼物。",
            "nextDialogs": [
              "401990112"
            ]
          },
          "401990112": {
            "id": "401990112",
            "speakerId": 10205,
            "speakerName": "？？？",
            "text": "……",
            "nextDialogs": [
              "401990113"
            ]
          },
          "401990113": {
            "id": "401990113",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "啊，夜兰的朋友走掉了，我还以为能认识一下呢…"
          }
        }
      }
    },
    {
      "subId": "4019904",
      "subQuestName": "前往可疑区域",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "401990401"
        ],
        "dialogs": {
          "401990401": {
            "id": "401990401",
            "speakerId": 1048,
            "speakerName": "夜兰",
            "text": "嗯，就从这里开始调查好了。",
            "nextDialogs": [
              "401990402"
            ]
          },
          "401990402": {
            "id": "401990402",
            "speakerId": 1004,
            "speakerName": "Black Screen",
            "text": "跟随夜兰在沉玉谷东北荒无人烟的区域穿行…\\n在夜兰的引导下，从隐秘的位置对海滩进行了一番侦察，成为了「暗中观察的眼哨」。",
            "nextDialogs": [
              "401990403"
            ]
          },
          "401990403": {
            "id": "401990403",
            "speakerId": 1004,
            "speakerName": "Black Screen",
            "text": "并没有直接发现「黑钱领主」团伙的成员。周围的环境似乎也没有什么异常之处。",
            "nextDialogs": [
              "401990404"
            ]
          },
          "401990404": {
            "id": "401990404",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "结果…这里好像是普普通通的野外？根本没有坏家伙的痕迹嘛。",
            "nextDialogs": [
              "401990407"
            ]
          },
          "401990407": {
            "id": "401990407",
            "speakerId": 1048,
            "speakerName": "夜兰",
            "text": "#嗯，{NICKNAME}已经明白自己要扮演怎样的角色了，进入状态的速度确实不比顶级探员逊色。",
            "nextDialogs": [
              "401990408"
            ]
          },
          "401990408": {
            "id": "401990408",
            "speakerId": 1048,
            "speakerName": "夜兰",
            "text": "现阶段，我们需要「布饵」，这鱼饵就是「黑钱领主」的赃物。所以「找到关键的物品」，比找人更重要。",
            "nextDialogs": [
              "401990409"
            ]
          },
          "401990409": {
            "id": "401990409",
            "speakerId": 1048,
            "speakerName": "夜兰",
            "text": "要找到赃物，锁定对方藏匿的据点，就是重中之重了。",
            "nextDialogs": [
              "401990410"
            ]
          },
          "401990410": {
            "id": "401990410",
            "speakerId": 1048,
            "speakerName": "夜兰",
            "text": "你难道没有觉得，这里的视野很棒吗？",
            "nextDialogs": [
              "401990411"
            ]
          },
          "401990411": {
            "id": "401990411",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "这么一说…好像可以看到遗珑埠的港口，远处水面的船，还有一座塔…那座塔是干什么的来着？",
            "nextDialogs": [
              "401990412"
            ]
          },
          "401990412": {
            "id": "401990412",
            "speakerId": 1048,
            "speakerName": "夜兰",
            "text": "是千岩军的灯塔，平时负责守望水域。必要时，则会打出频闪灯语，承担一定的通信作用。"
          }
        }
      }
    },
    {
      "subId": "4019902",
      "subQuestName": "装备道具并与夜兰对话",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "401990801"
        ],
        "dialogs": {
          "401990801": {
            "id": "401990801",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "可以开始调查了。",
            "nextDialogs": [
              "401990802"
            ]
          },
          "401990802": {
            "id": "401990802",
            "speakerId": 1048,
            "speakerName": "夜兰",
            "text": "请细心观察，许多线索可能并不起眼…"
          }
        }
      }
    },
    {
      "subId": "4019905",
      "subQuestName": "调查可疑区域",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "401990501"
        ],
        "dialogs": {
          "401990501": {
            "id": "401990501",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "看起来，依然只是一片普普通通的野外呢…",
            "nextDialogs": [
              "401990504"
            ]
          },
          "401990504": {
            "id": "401990504",
            "speakerId": 1048,
            "speakerName": "夜兰",
            "text": "别放过任何可疑的迹象哦，我相信你们。"
          }
        }
      }
    },
    {
      "subId": "4019906",
      "subQuestName": "与夜兰对话",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "401990601"
        ],
        "dialogs": {
          "401990601": {
            "id": "401990601",
            "speakerId": 1048,
            "speakerName": "夜兰",
            "text": "收获还不错。",
            "nextDialogs": [
              "401990602"
            ]
          },
          "401990602": {
            "id": "401990602",
            "speakerId": 1048,
            "speakerName": "夜兰",
            "text": "一柄钥匙，应当可以打开某扇关键的门；鸽子传信筒中，则有着许多暗语写成的短讯。",
            "nextDialogs": [
              "401990603"
            ]
          },
          "401990603": {
            "id": "401990603",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "噫…真的在这里藏着一些作案工具…那帮家伙未免也太大胆了！",
            "nextDialogs": [
              "401990604"
            ]
          },
          "401990604": {
            "id": "401990604",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "不怕观察千岩军的时候，被千岩军发现，抓起来好好调查吗？",
            "nextDialogs": [
              "401990605"
            ]
          },
          "401990605": {
            "id": "401990605",
            "speakerId": 1048,
            "speakerName": "夜兰",
            "text": "这些器物表明，「黑钱领主」的眼哨有很大概率伪装成了渔民，他们的心理素质足够死硬…",
            "nextDialogs": [
              "401990606"
            ]
          },
          "401990606": {
            "id": "401990606",
            "speakerId": 1048,
            "speakerName": "夜兰",
            "text": "如果眼哨坚持宣称，自己只是找了个清静的地方歇脚，没有关键证据，千岩军也不可能扣押一个平民，对其深入调查。",
            "nextDialogs": [
              "401990607"
            ]
          },
          "401990607": {
            "id": "401990607",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "呃…我都能想象出那人死皮赖脸的模样了…",
            "nextDialogs": [
              "401990610"
            ]
          },
          "401990610": {
            "id": "401990610",
            "speakerId": 1048,
            "speakerName": "夜兰",
            "text": "藏匿器物的痕迹还很新，说明部署在这里的眼哨另有一人并未被埃德勒抓捕，还在活动。",
            "nextDialogs": [
              "401990611"
            ]
          },
          "401990611": {
            "id": "401990611",
            "speakerId": 1048,
            "speakerName": "夜兰",
            "text": "我们需要警惕，不能让对方意识到，我们还在追踪调查。",
            "nextDialogs": [
              "401990612"
            ]
          },
          "401990612": {
            "id": "401990612",
            "speakerId": 1004,
            "speakerName": "Black Screen",
            "text": "夜兰显然有备而来，取出一套精巧的工具组，首先原样复刻了那柄钥匙，随后针对性记录了传信筒中的暗语片段…\\n随后，夜兰将现场恢复成了原状，完全看不出有过调查的痕迹。",
            "nextDialogs": [
              "401990613"
            ]
          },
          "401990613": {
            "id": "401990613",
            "speakerId": 1048,
            "speakerName": "夜兰",
            "text": "好了，既然我的猜想得到了验证，黑钱领主确实在这里安插了眼哨，那么，藏匿货物的据点会在哪呢…",
            "nextDialogs": [
              "401990614"
            ]
          },
          "401990614": {
            "id": "401990614",
            "speakerId": 1048,
            "speakerName": "夜兰",
            "text": "#你怎么看，{NICKNAME}？"
          }
        }
      }
    },

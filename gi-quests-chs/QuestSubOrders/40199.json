        "dialogs": {}
      }
    },
    {
      "subId": "4019909",
      "subQuestName": "与夜兰对话",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "401990701"
        ],
        "dialogs": {
          "401990701": {
            "id": "401990701",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "找到了找到了！这就是那些家伙藏匿货物的据点了吧…还挺隐蔽呢！",
            "nextDialogs": [
              "401990702"
            ]
          },
          "401990702": {
            "id": "401990702",
            "speakerId": 1048,
            "speakerName": "夜兰",
            "text": "令人惊叹的效率，我开始期待你独自探案的潜力了…",
            "nextDialogs": [
              "401990703"
            ]
          },
          "401990703": {
            "id": "401990703",
            "speakerId": 1048,
            "speakerName": "夜兰",
            "text": "好了，让我们试试看，上个哨点找到的那柄钥匙，能否带来更多惊喜。",
            "nextDialogs": [
              "401990704"
            ]
          },
          "401990704": {
            "id": "401990704",
            "speakerId": 1048,
            "speakerName": "夜兰",
            "text": "嗯，终究是在客场行动，他们没法布置更多诱饵了，这倒是方便了我们。",
            "nextDialogs": [
              "401990705"
            ]
          },
          "401990705": {
            "id": "401990705",
            "speakerId": 1048,
            "speakerName": "夜兰",
            "text": "接下来就交给我吧，进入他们的藏身处后，每一步都需要小心谨慎，不能留下任何痕迹。",
            "nextDialogs": [
              "401990706"
            ]
          },
          "401990706": {
            "id": "401990706",
            "speakerId": 1048,
            "speakerName": "夜兰",
            "text": "请在外面帮我放风，避免我们在调查期间和对方撞个正着。",
            "nextDialogs": [
              "401990707"
            ]
          },
          "401990707": {
            "id": "401990707",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "#好！虽然我们没有干过这样的活，但我相信{NICKNAME}，让{M#他}{F#她}保护你！",
            "nextDialogs": [
              "401990710"
            ]
          },
          "401990710": {
            "id": "401990710",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "也，也对哦…夜兰做事好像从来不留破绽呢…",
            "nextDialogs": [
              "401990711"
            ]
          },
          "401990711": {
            "id": "401990711",
            "speakerId": 1004,
            "speakerName": "Black Screen",
            "text": "开启据点的大门后，夜兰仔细观察，确认据点的内部构造是一般的地窖…\\n碍于施工不便，对方并未完全封闭据点的顶部和侧墙，偶尔会有水分从土壤析出，在据点中流淌…",
            "nextDialogs": [
              "401990712"
            ]
          },
          "401990712": {
            "id": "401990712",
            "speakerId": 1004,
            "speakerName": "Black Screen",
            "text": "于是，夜兰以纤薄的水元素覆盖双手。\\n如此一来，即便她需要接触据点中的器物，随着时间推移，水汽自然蒸发，也会带走她的行动痕迹。\\n随后，夜兰谨慎地进入了隐秘据点，开始探查封存其中的商品…",
            "nextDialogs": [
              "401990713"
            ]
          },
          "401990713": {
            "id": "401990713",
            "speakerId": 1048,
            "speakerName": "夜兰",
            "text": "一切就绪，我记录了据点内所有瓷器、花瓶和茶叶的特征。",
            "nextDialogs": [
              "401990714"
            ]
          },
          "401990714": {
            "id": "401990714",
            "speakerId": 1048,
            "speakerName": "夜兰",
            "text": "在拍卖会的现场，我们就能借助这些特征，盯住试图拍下对应收藏品的买家，进而不断放长鱼线…",
            "nextDialogs": [
              "401990715"
            ]
          },
          "401990715": {
            "id": "401990715",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "动作好快，未免也太熟练了啦！"
          }
        }
      }
    },

    {
      "subId": "4019903",
      "subQuestName": "装备道具并与夜兰对话",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "401991201"
        ],
        "dialogs": {
          "401991201": {
            "id": "401991201",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "可以开始调查了。",
            "nextDialogs": [
              "401991202"
            ]
          },
          "401991202": {
            "id": "401991202",
            "speakerId": 1048,
            "speakerName": "夜兰",
            "text": "嗯，拿出之前那种细致的洞察力，我相信你。"
          }
        }
      }
    },
    {
      "subId": "4019908",
      "subQuestName": "调查可疑区域",
      "sceneId": null,
      "locations": [],

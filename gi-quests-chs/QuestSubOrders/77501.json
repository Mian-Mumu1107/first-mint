    {
      "subId": "7750102",
      "subQuestName": "前往冒险家协会总部",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "775010201"
        ],
        "dialogs": {
          "775010201": {
            "id": "775010201",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "咦？前面那个背影好像有些眼熟？",
            "nextDialogs": [
              "775010202"
            ]
          },
          "775010202": {
            "id": "775010202",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "等等，那不是璃月的分会长…岚姐吗！",
            "nextDialogs": [
              "775010203"
            ]
          },
          "775010203": {
            "id": "775010203",
            "speakerId": 16951,
            "speakerName": "岚姐",
            "text": "还真来总部的柜台了？",
            "nextDialogs": [
              "775010204"
            ]
          },
          "775010204": {
            "id": "775010204",
            "speakerId": 16951,
            "speakerName": "岚姐",
            "text": "喂喂喂，人来了！",
            "nextDialogs": [
              "775010205"
            ]
          },
          "775010205": {
            "id": "775010205",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "欸！怎么回事？",
            "nextDialogs": [
              "775010208"
            ]
          },
          "775010208": {
            "id": "775010208",
            "speakerId": 16951,
            "speakerName": "岚姐",
            "text": "啊呀，不是要为难你。我们也算是老相识了吧，哪来的矛盾？",
            "nextDialogs": [
              "775010209"
            ]
          },
          "775010209": {
            "id": "775010209",
            "speakerId": 16951,
            "speakerName": "岚姐",
            "text": "而且，就我们这点战力，真要和你打起来，还不够当你的开胃小菜。",
            "nextDialogs": [
              "775010210"
            ]
          },
          "775010210": {
            "id": "775010210",
            "speakerId": 17015,
            "speakerName": "塔拉利欣",
            "text": "只是为了防止您一溜烟又消失不见，请见谅。",
            "nextDialogs": [
              "775010211"
            ]
          },
          "775010211": {
            "id": "775010211",
            "speakerId": 17015,
            "speakerName": "塔拉利欣",
            "text": "如果这次没能让您留步，下次再见就不知是何时了。",
            "nextDialogs": [
              "775010212"
            ]
          },
          "775010212": {
            "id": "775010212",
            "speakerId": 17015,
            "speakerName": "塔拉利欣",
            "text": "请容本人，至冬冒险家总部文员塔拉利欣向您解释——",
            "nextDialogs": [
              "775010213"
            ]
          },
          "775010213": {
            "id": "775010213",
            "speakerId": 17015,
            "speakerName": "塔拉利欣",
            "text": "#目前仅有的十五位S级冒险家之一，威名用一页纸都写不完的{NICKNAME}啊——",
            "nextDialogs": [
              "775010214"
            ]
          },
          "775010214": {
            "id": "775010214",
            "speakerId": 17015,
            "speakerName": "塔拉利欣",
            "text": "有场重要赛事等待着您，缺了您，它就永远划不上句号。",
            "nextDialogs": [
              "775010215"
            ]
          },
          "775010215": {
            "id": "775010215",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "吓，吓死我了，还以为要在城里直接开打呢。",
            "nextDialogs": [
              "775010216"
            ]
          },
          "775010216": {
            "id": "775010216",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "只是比赛而已，好好说就行嘛，还怕我们拒绝不成？"
          }
        }
      }
    },
    {
      "subId": "7750103",
      "subQuestName": "前往赛场",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "775010301"
        ],
        "dialogs": {
          "775010301": {
            "id": "775010301",
            "speakerId": 17015,
            "speakerName": "塔拉利欣",
            "text": "如您所见，这里就是赛场了。",
            "nextDialogs": [
              "775010302"
            ]
          },
          "775010302": {
            "id": "775010302",
            "speakerId": 17015,
            "speakerName": "塔拉利欣",
            "text": "确切地说，是「冒险家协会发展大会」的会场。",
            "nextDialogs": [
              "775010303"
            ]
          },
          "775010303": {
            "id": "775010303",
            "speakerId": 17015,
            "speakerName": "塔拉利欣",
            "text": "最初邀请各国冒险家前来的目的，是共同商讨协会后续发展的事宜。",
            "nextDialogs": [
              "775010304"
            ]
          },
          "775010304": {
            "id": "775010304",
            "speakerId": 17015,
            "speakerName": "塔拉利欣",
            "text": "只是因为会议进展不顺，各方争执不下，才提前举办了赛事…",
            "nextDialogs": [
              "775010305"
            ]
          },
          "775010305": {
            "id": "775010305",
            "speakerId": 16951,
            "speakerName": "岚姐",
            "text": "原本为了促进各国冒险家友好交流的「首届冒险家竞技大赛」，成为了决定话语权的角斗场。",
            "nextDialogs": [
              "775010306"
            ]
          },
          "775010306": {
            "id": "775010306",
            "speakerId": 16951,
            "speakerName": "岚姐",
            "text": "各个国家的分会派来的队伍，都是由他们收到消息时，能找到的最强冒险家带队。",
            "nextDialogs": [
              "775010307"
            ]
          },
          "775010307": {
            "id": "775010307",
            "speakerId": 16951,
            "speakerName": "岚姐",
            "text": "璃月这边是我，蒙德的队长是玉霞，和我一起在雪山海岸露营过的老友，拳脚功夫比酒量强八倍。",
            "nextDialogs": [
              "775010308"
            ]
          },
          "775010308": {
            "id": "775010308",
            "speakerId": 16951,
            "speakerName": "岚姐",
            "text": "稻妻的「打工战士」梨香…不熟，但说话很有礼貌，不赖。",
            "nextDialogs": [
              "775010309"
            ]
          },
          "775010309": {
            "id": "775010309",
            "speakerId": 17015,
            "speakerName": "塔拉利欣",
            "text": "须弥方面的核心人物是传奇佣兵莲塔，她陪着一位新人玩了三年半，大家本来都以为她想退隐了。",
            "nextDialogs": [
              "775010310"
            ]
          },
          "775010310": {
            "id": "775010310",
            "speakerId": 17015,
            "speakerName": "塔拉利欣",
            "text": "枫丹队长是新秀，纳蒂亚和尤维尔的搭档，智谋和执行力都令人惊叹。",
            "nextDialogs": [
              "775010311"
            ]
          },
          "775010311": {
            "id": "775010311",
            "speakerId": 17015,
            "speakerName": "塔拉利欣",
            "text": "纳塔的「伊奎米利的寒星」莉琉，一位赫赫有名的部族战士，近期战绩如火箭般猛升。",
            "nextDialogs": [
              "775010312"
            ]
          },
          "775010312": {
            "id": "775010312",
            "speakerId": 17015,
            "speakerName": "塔拉利欣",
            "text": "而挪德卡莱的萨林，是年少有为的均衡型选手，非常懂得平衡各方势力，完成了不少极难的委托…",
            "nextDialogs": [
              "775010315"
            ]
          },
          "775010315": {
            "id": "775010315",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "我都听晕了，原来在我们没怎么注意的地方，冒险家里也冒出来这么多威风的人…",
            "nextDialogs": [
              "775010316"
            ]
          },
          "775010316": {
            "id": "775010316",
            "speakerId": 16951,
            "speakerName": "岚姐",
            "text": "#{NICKNAME}要干的事情很简单，把所有对手都打趴下…包括我。",
            "nextDialogs": [
              "775010317"
            ]
          },
          "775010317": {
            "id": "775010317",
            "speakerId": 16951,
            "speakerName": "岚姐",
            "text": "呃，我的意思是，在四大主要技能项目上，拿到最高的比分——",
            "nextDialogs": [
              "775010318"
            ]
          },
          "775010318": {
            "id": "775010318",
            "speakerId": 16951,
            "speakerName": "岚姐",
            "text": "通过「射术反应战」，向大家展示你对新式武器铳枪统治性的驾驭能力；",
            "nextDialogs": [
              "775010319"
            ]
          },
          "775010319": {
            "id": "775010319",
            "speakerId": 16951,
            "speakerName": "岚姐",
            "text": "在「冰雪迷宫探行推演」中，将老牌冒险家探索秘境时的灵巧思维交给后辈；",
            "nextDialogs": [
              "775010320"
            ]
          },
          "775010320": {
            "id": "775010320",
            "speakerId": 16951,
            "speakerName": "岚姐",
            "text": "「攻夺圆滚滚秘境」是你武力的最佳秀场，只需了解秘境的特性，打个痛快便可；",
            "nextDialogs": [
              "775010321"
            ]
          },
          "775010321": {
            "id": "775010321",
            "speakerId": 16951,
            "speakerName": "岚姐",
            "text": "而新的「程准列车驭法」是你对「运力」和「控制力」的侧写，能凸显冒险家兼顾全局的能力。",
            "nextDialogs": [
              "775010322"
            ]
          },
          "775010322": {
            "id": "775010322",
            "speakerId": 17015,
            "speakerName": "塔拉利欣",
            "text": "四个项目都采用了新颖的设计，确保每一组冒险家都没有可以依赖的经验，全是临场发挥，实战见真章。",
            "nextDialogs": [
              "775010323"
            ]
          },
          "775010323": {
            "id": "775010323",
            "speakerId": 17015,
            "speakerName": "塔拉利欣",
            "text": "等你拿到无可比拟的最高成绩后，会议上的许多议题，就都由您来拍板了。",
            "nextDialogs": [
              "775010324"
            ]
          },
          "775010324": {
            "id": "775010324",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "话说回来，岚姐和塔拉利欣没有自己的要求吗？",
            "nextDialogs": [
              "775010325"
            ]
          },
          "775010325": {
            "id": "775010325",
            "speakerId": 16951,
            "speakerName": "岚姐",
            "text": "你觉得我是那种…会为了「是否需要建立冒险家考勤打卡标准」去和人争论的家伙吗？",
            "nextDialogs": [
              "775010326"
            ]
          },
          "775010326": {
            "id": "775010326",
            "speakerId": 16951,
            "speakerName": "岚姐",
            "text": "为璃月分会争取更多资金和奖金这件事，我已经搞定了，剩下的问题，只要有个结果，我怎样都好说。",
            "nextDialogs": [
              "775010327"
            ]
          },
          "775010327": {
            "id": "775010327",
            "speakerId": 17015,
            "speakerName": "塔拉利欣",
            "text": "我的话，身为总部的参会代表，我只希望会议能探讨出大家都信服的方案，圆满落幕。",
            "nextDialogs": [
              "775010328"
            ]
          },
          "775010328": {
            "id": "775010328",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "唔哦…明白你们的意思了！",
            "nextDialogs": [
              "775010329"
            ]
          },
          "775010329": {
            "id": "775010329",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "让我仔细看看…",
            "nextDialogs": [
              "775010330"
            ]
          },
          "775010330": {
            "id": "775010330",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "虽然这么说有点失礼，但「派蒙战力探测器」已经显示出了结果。",
            "nextDialogs": [
              "775010331"
            ]
          },
          "775010331": {
            "id": "775010331",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "他们确实是很强的冒险家，实力值得认可，打得有来有回也可以理解。",
            "nextDialogs": [
              "775010332"
            ]
          },
          "775010332": {
            "id": "775010332",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "#可惜，{NICKNAME}被当成S级冒险家，是因为评级的上限只有S！"
          }
        }
      }
    }
  ]
}
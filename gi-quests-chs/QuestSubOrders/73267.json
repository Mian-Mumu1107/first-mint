  "subQuests": [
    {
      "subId": "7326701",
      "subQuestName": "与阿提亚对话$HIDDEN",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "732670101"
        ],
        "dialogs": {
          "732670101": {
            "id": "732670101",
            "speakerId": 1000,
            "speakerName": "阿提亚",
            "text": "加入镀金旅团！拥抱美好生活！这位朋友，有没有兴趣了解一下我们镀金旅团啊？",
            "nextDialogs": [
              "732670102"
            ]
          },
          "732670102": {
            "id": "732670102",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "呃…",
            "nextDialogs": [
              "732670103"
            ]
          },
          "732670103": {
            "id": "732670103",
            "speakerId": 1000,
            "speakerName": "阿提亚",
            "text": "咳，你听我说啊。镀金旅团可是个好地方，自由！团结！友好！",
            "nextDialogs": [
              "732670104"
            ]
          },
          "732670104": {
            "id": "732670104",
            "speakerId": 1000,
            "speakerName": "阿提亚",
            "text": "而且还能从住在树上的那些家伙的腰包里掏钱出来。教令院的学者们都可有钱了，绝对不会拖欠…",
            "nextDialogs": [
              "732670107"
            ]
          },
          "732670107": {
            "id": "732670107",
            "speakerId": 1000,
            "speakerName": "阿提亚",
            "text": "呃…冒险家协会…那…那也不耽误嘛！这年头谁没个兼职，而且冒险家和佣兵感觉上也，也差不多…",
            "nextDialogs": [
              "732670108"
            ]
          },
          "732670108": {
            "id": "732670108",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "还是差挺多的啦。",
            "nextDialogs": [
              "732670109"
            ]
          },
          "732670109": {
            "id": "732670109",
            "speakerId": 1000,
            "speakerName": "阿提亚",
            "text": "唉，不过我们的伙食也很好啊，隔三差五就有鱼有肉的。",
            "nextDialogs": [
              "732670110"
            ]
          },
          "732670110": {
            "id": "732670110",
            "speakerId": 1000,
            "speakerName": "阿提亚",
            "text": "而且如果你运气好的话，甚至能和那位「炽鬃之狮」迪希雅说上话呢！我…咳咳…咳咳…"
          }
        }
      }
    },
    {
      "subId": "7326702",

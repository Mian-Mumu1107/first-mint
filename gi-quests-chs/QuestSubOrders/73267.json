    {
      "subId": "7326708",
      "subQuestName": "与艾登和卡里玛对话",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "732670801"
        ],
        "dialogs": {
          "732670801": {
            "id": "732670801",
            "speakerId": 1003,
            "speakerName": "艾登",
            "text": "喔——",
            "nextDialogs": [
              "732670802"
            ]
          },
          "732670802": {
            "id": "732670802",
            "speakerId": 1004,
            "speakerName": "卡里玛",
            "text": "居，居然跑得这么快…",
            "nextDialogs": [
              "732670803"
            ]
          },
          "732670803": {
            "id": "732670803",
            "speakerId": 1000,
            "speakerName": "阿提亚",
            "text": "很好！速度很不错，跑得也很稳。",
            "nextDialogs": [
              "732670804"
            ]
          },
          "732670804": {
            "id": "732670804",
            "speakerId": 1000,
            "speakerName": "阿提亚",
            "text": "艾登，卡里玛，你们可要记好了。",
            "nextDialogs": [
              "732670805"
            ]
          },
          "732670805": {
            "id": "732670805",
            "speakerId": 1000,
            "speakerName": "阿提亚",
            "text": "遇见危险的情况可不要逞强，需要撤退的时候，一定要果断撤退才行。",
            "nextDialogs": [
              "732670806"
            ]
          },
          "732670806": {
            "id": "732670806",
            "speakerId": 1000,
            "speakerName": "阿提亚",
            "text": "特别是你，艾登。",
            "nextDialogs": [
              "732670807"
            ]
          },
          "732670807": {
            "id": "732670807",
            "speakerId": 1003,
            "speakerName": "艾登",
            "text": "我知道啦——",
            "nextDialogs": [
              "732670808"
            ]
          },
          "732670808": {
            "id": "732670808",
            "speakerId": 1000,
            "speakerName": "阿提亚",
            "text": "不错，那我们下一步…就去村外，让你们亲眼见识一下「战斗」的场面吧。",
            "nextDialogs": [
              "732670809"
            ]
          },
          "732670809": {
            "id": "732670809",
            "speakerId": 1003,
            "speakerName": "艾登",
            "text": "好耶！爸爸刚给我削了一根木剑，我就带在身上。卡里玛，你呢？",
            "nextDialogs": [
              "732670810"
            ]
          },
          "732670810": {
            "id": "732670810",
            "speakerId": 1004,
            "speakerName": "卡里玛",
            "text": "我倒是有一副小弓箭，虽然…妈妈只给我没有箭头的箭。",
            "nextDialogs": [
              "732670811"
            ]
          },
          "732670811": {
            "id": "732670811",
            "speakerId": 1000,
            "speakerName": "阿提亚",
            "text": "哈哈哈！没问题，你们又有剑又有弓，而且还有满腔勇气，这些就足够你们踏上冒险之路了。",
            "nextDialogs": [
              "732670812"
            ]
          },
          "732670812": {
            "id": "732670812",
            "speakerId": 1000,
            "speakerName": "阿提亚",
            "text": "但是，去了村外之后记得不要乱跑，要时刻待在我和旅行者身边。",
            "nextDialogs": [
              "732670815"
            ]
          },
          "732670815": {
            "id": "732670815",
            "speakerId": 1000,
            "speakerName": "阿提亚",
            "text": "…放心吧，那个地方我已经事先踩过点了，只有几只病恹恹的蝎子，几乎没有攻击性，不会有问题的。",
            "nextDialogs": [
              "732670816"
            ]
          },
          "732670816": {
            "id": "732670816",
            "speakerId": 1000,
            "speakerName": "阿提亚",
            "text": "再说了，不是还有咱们俩在嘛。"
          }
        }
      }
    },
    {
      "subId": "7326709",
      "subQuestName": "打倒所有魔物",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [],
        "dialogs": {}
      }
    },
    {
      "subId": "7326710",
      "subQuestName": "与艾登和卡里玛对话",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "732671001"
        ],
        "dialogs": {
          "732671001": {
            "id": "732671001",
            "speakerId": 1003,
            "speakerName": "艾登",
            "text": "呜…那些蝎子好…好大…根本不敢靠近…",
            "nextDialogs": [
              "732671002"
            ]
          },
          "732671002": {
            "id": "732671002",
            "speakerId": 1004,
            "speakerName": "卡里玛",
            "text": "我明明用箭射中它们了，为什么一点反应都没有…",
            "nextDialogs": [
              "732671003"
            ]
          },
          "732671003": {
            "id": "732671003",
            "speakerId": 1004,
            "speakerName": "卡里玛",
            "text": "但是…你怎么这么轻松就打倒了它们…",
            "nextDialogs": [
              "732671006"
            ]
          },
          "732671006": {
            "id": "732671006",
            "speakerId": 1004,
            "speakerName": "卡里玛",
            "text": "呜…明明坎蒂丝姐姐说，我已经很有进步了…",
            "nextDialogs": [
              "732671007"
            ]
          },
          "732671007": {
            "id": "732671007",
            "speakerId": 1000,
            "speakerName": "阿提亚",
            "text": "卡里玛，别这么沮丧嘛，只要每天都进步一点，总有一天你也会拥有强大的实力。",
            "nextDialogs": [
              "732671008"
            ]
          },
          "732671008": {
            "id": "732671008",
            "speakerId": 1000,
            "speakerName": "阿提亚",
            "text": "艾登也是，只要这么持续锻炼下去，加入镀金旅团也只是时间问题。",
            "nextDialogs": [
              "732671009"
            ]
          },
          "732671009": {
            "id": "732671009",
            "speakerId": 1003,
            "speakerName": "艾登",
            "text": "唔唔，要是能向迪希雅姐姐当面请教武艺的话…",
            "nextDialogs": [
              "732671010"
            ]
          },
          "732671010": {
            "id": "732671010",
            "speakerId": 1004,
            "speakerName": "卡里玛",
            "text": "下次见到坎蒂丝姐姐的时候，一定要拜托她再指导我训练！",
            "nextDialogs": [
              "732671011"
            ]
          },
          "732671011": {
            "id": "732671011",
            "speakerId": 1000,
            "speakerName": "阿提亚",
            "text": "这两个孩子…都很有干劲嘛，哈哈哈哈！"
          }
        }
      }
    },
    {
      "subId": "7326799",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [

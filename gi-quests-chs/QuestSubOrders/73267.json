      }
    },
    {
      "subId": "7326703",
      "subQuestName": "与萨尼娅对话",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "732670301"
        ],
        "dialogs": {
          "732670301": {
            "id": "732670301",
            "speakerId": 1001,
            "speakerName": "萨尼娅",
            "text": "真让人发愁…",
            "nextDialogs": [
              "732670302"
            ]
          },
          "732670302": {
            "id": "732670302",
            "speakerId": 1000,
            "speakerName": "阿提亚",
            "text": "萨尼娅！上午好啊，你在选什么呢？",
            "nextDialogs": [
              "732670303"
            ]
          },
          "732670303": {
            "id": "732670303",
            "speakerId": 1001,
            "speakerName": "萨尼娅",
            "text": "阿提亚…我都说过了，杰巴里对镀金旅团没什么兴趣，我也不想他去做什么佣兵，你就别想让我帮着你说话了。",
            "nextDialogs": [
              "732670304"
            ]
          },
          "732670304": {
            "id": "732670304",
            "speakerId": 1000,
            "speakerName": "阿提亚",
            "text": "哎呀，杰巴里的厨艺那么好，去镀金旅团里准能混个好职位，你们家的收入也会好很多啊。",
            "nextDialogs": [
              "732670305"
            ]
          },
          "732670305": {
            "id": "732670305",
            "speakerId": 1000,
            "speakerName": "阿提亚",
            "text": "而且他不也说过，想要外出找点活干吗？如果他真想外出工作，有我这个熟人介绍当然是最好的啊。",
            "nextDialogs": [
              "732670306"
            ]
          },
          "732670306": {
            "id": "732670306",
            "speakerId": 1001,
            "speakerName": "萨尼娅",
            "text": "你就听他说吧，他隔一段时间就会说一次这种话，过几天就再反悔。",
            "nextDialogs": [
              "732670307"
            ]
          },
          "732670307": {
            "id": "732670307",
            "speakerId": 1001,
            "speakerName": "萨尼娅",
            "text": "说到最后，他就是舍不得我一个人待在村里…我也舍不得他一个人出去打拼。",
            "nextDialogs": [
              "732670308"
            ]
          },
          "732670308": {
            "id": "732670308",
            "speakerId": 1001,
            "speakerName": "萨尼娅",
            "text": "更何况，是每天都去玩命的佣兵！所以你就别想了，就算杰巴里想去，我也会拦着他的。",
            "nextDialogs": [
              "732670309"
            ]
          },
          "732670309": {
            "id": "732670309",
            "speakerId": 1001,
            "speakerName": "萨尼娅",
            "text": "好了，话就说到这里，我还要买东西呢，你去找别人吧。",
            "nextDialogs": [
              "732670310"
            ]
          },
          "732670310": {
            "id": "732670310",
            "speakerId": 1000,
            "speakerName": "阿提亚",
            "text": "呼…好吧。旅行者， 你看见了吧，这就是我每天工作的状况。",
            "nextDialogs": [
              "732670311"
            ]
          },
          "732670311": {
            "id": "732670311",
            "speakerId": 1000,
            "speakerName": "阿提亚",
            "text": "我们接下来去找福迪尔吧，他…曾经是我们的人，但后来退出了。",
            "nextDialogs": [
              "732670312"
            ]
          },
          "732670312": {
            "id": "732670312",
            "speakerId": 1000,
            "speakerName": "阿提亚",
            "text": "要是我能把他劝回来，那就再好不过了…"
          }
        }
      }
    },
    {
      "subId": "7326705",
      "subQuestName": "和福迪尔对话",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "732670501"
        ],
        "dialogs": {
          "732670501": {
            "id": "732670501",
            "speakerId": 1002,
            "speakerName": "福迪尔",
            "text": "阿提亚，你怎么又来了。",
            "nextDialogs": [
              "732670502"
            ]
          },
          "732670502": {
            "id": "732670502",
            "speakerId": 1000,
            "speakerName": "阿提亚",
            "text": "嘿嘿，百折不挠是咱们镀金旅团的优良品质嘛。",
            "nextDialogs": [
              "732670503"
            ]
          },
          "732670503": {
            "id": "732670503",
            "speakerId": 1002,
            "speakerName": "福迪尔",
            "text": "那你也应该知道，坚持原则更是我的处事方法。",
            "nextDialogs": [
              "732670504"
            ]
          },
          "732670504": {
            "id": "732670504",
            "speakerId": 1000,
            "speakerName": "阿提亚",
            "text": "福迪尔大哥…",
            "nextDialogs": [
              "732670505"
            ]
          },
          "732670505": {
            "id": "732670505",
            "speakerId": 1002,
            "speakerName": "福迪尔",
            "text": "我已经退出镀金旅团了，你不用这么称呼我。",
            "nextDialogs": [
              "732670506"
            ]
          },
          "732670506": {
            "id": "732670506",
            "speakerId": 1000,
            "speakerName": "阿提亚",
            "text": "唉，福迪尔先生。你真的不考虑回去看看吗？",
            "nextDialogs": [
              "732670507"
            ]
          },
          "732670507": {
            "id": "732670507",
            "speakerId": 1000,
            "speakerName": "阿提亚",
            "text": "虽然有些兄弟的作风是有点…呃…冒进，但还是有很多兄弟遵纪守法啊。",
            "nextDialogs": [
              "732670508"
            ]
          },
          "732670508": {
            "id": "732670508",
            "speakerId": 1002,
            "speakerName": "福迪尔",
            "text": "阿提亚，我说过了，我不会再回去。",
            "nextDialogs": [
              "732670509"
            ]
          },
          "732670509": {
            "id": "732670509",
            "speakerId": 1002,
            "speakerName": "福迪尔",
            "text": "你说的那些事情，我都已经用我自己的眼睛确认过了。",
            "nextDialogs": [
              "732670510"
            ]
          },
          "732670510": {
            "id": "732670510",
            "speakerId": 1002,
            "speakerName": "福迪尔",
            "text": "也许镀金旅团里不全是目无法纪之人，也不是每个镀金旅团成员都喜欢做那些趁火打劫的事…",
            "nextDialogs": [
              "732670511"
            ]
          },
          "732670511": {
            "id": "732670511",
            "speakerId": 1002,
            "speakerName": "福迪尔",
            "text": "但阿提亚…恶行会传播。只要有一个人违法乱纪，那他周围的人就会受到影响…",
            "nextDialogs": [
              "732670522"
            ]
          },
          "732670522": {
            "id": "732670522",
            "speakerId": 1002,
            "speakerName": "福迪尔",
            "text": "一个人影响一群人，那一群人再不断地开展行动，对更多人造成影响…",
            "nextDialogs": [
              "732670523"
            ]
          },
          "732670523": {
            "id": "732670523",
            "speakerId": 1002,
            "speakerName": "福迪尔",
            "text": "阿提亚，这些情况你应该比我更清楚吧。",
            "nextDialogs": [
              "732670512"
            ]
          },
          "732670512": {
            "id": "732670512",
            "speakerId": 1002,
            "speakerName": "福迪尔",
            "text": "在这种氛围里…恶行易施啊，阿提亚。",
            "nextDialogs": [
              "732670513"
            ]
          },
          "732670513": {
            "id": "732670513",
            "speakerId": 1000,
            "speakerName": "阿提亚",
            "text": "……",
            "nextDialogs": [
              "732670514"
            ]
          },
          "732670514": {
            "id": "732670514",
            "speakerId": 1002,
            "speakerName": "福迪尔",
            "text": "你想劝我回去，我也想劝你离开。",
            "nextDialogs": [
              "732670515"
            ]
          },
          "732670515": {
            "id": "732670515",
            "speakerId": 1002,
            "speakerName": "福迪尔",
            "text": "也许在你眼里，镀金旅团这个团体虽然称不上有道德，但也不能算是恶劣…但人不能永远生活在灰色地带里。",
            "nextDialogs": [
              "732670516"
            ]
          },
          "732670516": {
            "id": "732670516",
            "speakerId": 1002,
            "speakerName": "福迪尔",
            "text": "…这只是我对你的忠告。具体如何，还得你自己做出决断。",
            "nextDialogs": [
              "732670517"
            ]
          },
          "732670517": {
            "id": "732670517",
            "speakerId": 1000,
            "speakerName": "阿提亚",
            "text": "我知道的，福迪尔大哥。",
            "nextDialogs": [
              "732670518"
            ]
          },
          "732670518": {
            "id": "732670518",
            "speakerId": 1002,
            "speakerName": "福迪尔",
            "text": "嗯。如果你真的退出了…同时也想谋个生计，我会帮你。",
            "nextDialogs": [
              "732670519"
            ]
          },
          "732670519": {
            "id": "732670519",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "你没事吧？",
            "nextDialogs": [
              "732670520"
            ]
          },
          "732670520": {
            "id": "732670520",
            "speakerId": 1000,
            "speakerName": "阿提亚",
            "text": "哈哈哈，我就是辩不过福迪尔大哥…",
            "nextDialogs": [
              "732670521"
            ]
          },
          "732670521": {
            "id": "732670521",
            "speakerId": 1000,
            "speakerName": "阿提亚",
            "text": "接下来…哈哈，咱们先回去休息一下吧，说了这么多话，我喉咙都痛了。"
          }
        }
      }
    },
    {
      "subId": "7326706",
      "subQuestName": "回去稍微休息片刻",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "732670601"
        ],
        "dialogs": {
          "732670601": {
            "id": "732670601",
            "speakerId": 1003,
            "speakerName": "艾登",
            "text": "阿提亚叔叔！你还在招募人加入镀金旅团吗？",
            "nextDialogs": [
              "732670602"
            ]
          },
          "732670602": {
            "id": "732670602",
            "speakerId": 1000,
            "speakerName": "阿提亚",
            "text": "艾登，你怎么又跑出来了，和你妈妈说过了吗？",
            "nextDialogs": [
              "732670603"
            ]
          },
          "732670603": {
            "id": "732670603",
            "speakerId": 1003,
            "speakerName": "艾登",
            "text": "说过啦！妈妈在工作，我就自己来找卡里玛玩了。",
            "nextDialogs": [
              "732670604"
            ]
          },
          "732670604": {
            "id": "732670604",
            "speakerId": 1004,
            "speakerName": "卡里玛",
            "text": "你好呀，阿提亚叔叔。",
            "nextDialogs": [
              "732670605"
            ]
          },
          "732670605": {
            "id": "732670605",
            "speakerId": 1003,
            "speakerName": "艾登",
            "text": "阿提亚叔叔，我上次和你说的事，你觉得怎么样？",
            "nextDialogs": [
              "732670606"
            ]
          },
          "732670606": {
            "id": "732670606",
            "speakerId": 1003,
            "speakerName": "艾登",
            "text": "我一直都在锻炼，还和卡里玛一起训练了很久…她都已经快要跑不过我啦。",
            "nextDialogs": [
              "732670607"
            ]
          },
          "732670607": {
            "id": "732670607",
            "speakerId": 1004,
            "speakerName": "卡里玛",
            "text": "谁跑不过你了，我只不过是那天中饭没有吃饱而已。",
            "nextDialogs": [
              "732670608"
            ]
          },
          "732670608": {
            "id": "732670608",
            "speakerId": 1003,
            "speakerName": "艾登",
            "text": "总之，我可是按照你给我制订的计划训练了好久…",
            "nextDialogs": [
              "732670609"
            ]
          },
          "732670609": {
            "id": "732670609",
            "speakerId": 1003,
            "speakerName": "艾登",
            "text": "阿提亚叔叔，你今天再给我测试一下吧！看看我够不够格加入镀金旅团！",
            "nextDialogs": [
              "732670612"
            ]
          },
          "732670612": {
            "id": "732670612",
            "speakerId": 1000,
            "speakerName": "阿提亚",
            "text": "咳…好！艾登，今天我就以镀金旅团成员的身份，再次对你进行测验！",
            "nextDialogs": [
              "732670613"
            ]
          },
          "732670613": {
            "id": "732670613",
            "speakerId": 1003,
            "speakerName": "艾登",
            "text": "好耶！卡里玛，你也来测测看吧，我们一起加油！",
            "nextDialogs": [
              "732670614"
            ]
          },
          "732670614": {
            "id": "732670614",
            "speakerId": 1004,
            "speakerName": "卡里玛",
            "text": "我可不想加入镀金旅团，我只想留在村里，好好保护大家…",
            "nextDialogs": [
              "732670615"
            ]
          },
          "732670615": {
            "id": "732670615",
            "speakerId": 1004,
            "speakerName": "卡里玛",
            "text": "不过…让阿提亚叔叔帮我测验一下也不错，我可是向坎蒂丝姐姐请教过锻炼方法的！",
            "nextDialogs": [
              "732670616"
            ]
          },
          "732670616": {
            "id": "732670616",
            "speakerId": 1003,
            "speakerName": "艾登",
            "text": "欸？！你什么时候…",
            "nextDialogs": [
              "732670617"
            ]
          },
          "732670617": {
            "id": "732670617",
            "speakerId": 1000,
            "speakerName": "阿提亚",
            "text": "哈哈哈，你们俩这么有活力，很不错！",
            "nextDialogs": [
              "732670618"
            ]
          },
          "732670618": {
            "id": "732670618",
            "speakerId": 1000,
            "speakerName": "阿提亚",
            "text": "艾登，你也不要瘪着嘴了，有机会的话，我也带着你去向迪希雅请教锻炼方法，怎么样？",
            "nextDialogs": [
              "732670619"
            ]
          },
          "732670619": {
            "id": "732670619",
            "speakerId": 1003,
            "speakerName": "艾登",
            "text": "真的？！",
            "nextDialogs": [
              "732670620"
            ]
          },
          "732670620": {
            "id": "732670620",
            "speakerId": 1000,
            "speakerName": "阿提亚",
            "text": "镀金旅团成员说的话，绝对不作假。",
            "nextDialogs": [
              "732670621"
            ]
          },
          "732670621": {
            "id": "732670621",
            "speakerId": 1000,
            "speakerName": "阿提亚",
            "text": "不过，今天咱们在开始测验之前，就先让这位旅行者来示范一下标准动作吧。"
          }
        }
      }
    },
    {

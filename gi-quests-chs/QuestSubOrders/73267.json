        "dialogs": {
          "732679901": {
            "id": "732679901",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "简单来说，就是…尽快到达那里就可以了，对吧？",
            "nextDialogs": [
              "732679902"
            ]
          },
          "732679902": {
            "id": "732679902",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "意外地很简单啊…都让我有点不习惯了…"
          }
        }
      }
    }
  ]
}
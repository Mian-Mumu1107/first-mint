          }
        }
      }
    },
    {
      "subId": "2201009",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "220100901"
        ],
        "dialogs": {
          "220100901": {
            "id": "220100901",
            "speakerId": 3032,
            "speakerName": "顺吉",
            "text": "我们去了一趟「天目锻冶屋」，我找到了新剧情的灵感了！",
            "nextDialogs": [
              "220100902"
            ]
          },
          "220100902": {
            "id": "220100902",
            "speakerId": 3033,
            "speakerName": "阿茂",
            "text": "哦？居然真的去取材了，不错不错，说来听听！",
            "nextDialogs": [
              "220100903"
            ]
          },
          "220100903": {
            "id": "220100903",
            "speakerId": 3032,
            "speakerName": "顺吉",
            "text": "在一天夜里，主角突然觉醒了超一流的炼金锻造术「名刀再现」。",
            "nextDialogs": [
              "220100904"
            ]
          },
          "220100904": {
            "id": "220100904",
            "speakerId": 3032,
            "speakerName": "顺吉",
            "text": "哪怕手握生锈的废刀，只需报上相应的名号，就能将它转化成神兵利器！",
            "nextDialogs": [
              "220100905"
            ]
          },
          "220100905": {
            "id": "220100905",
            "speakerId": 3032,
            "speakerName": "顺吉",
            "text": "这样一来，就…怎么了？",
            "nextDialogs": [
              "220100906"
            ]
          },
          "220100906": {
            "id": "220100906",
            "speakerId": 3033,
            "speakerName": "阿茂",
            "text": "喂…你是不是又要来这一套了！",
            "nextDialogs": [
              "220100909"
            ]
          },
          "220100909": {
            "id": "220100909",
            "speakerId": 3033,
            "speakerName": "阿茂",
            "text": "我说你啊！是不是又打算用新增设定的方法推进剧情。",
            "nextDialogs": [
              "220100910"
            ]
          },
          "220100910": {
            "id": "220100910",
            "speakerId": 3033,
            "speakerName": "阿茂",
            "text": "然后还要给那些设定也增加更多更复杂的设定，就这样推进剧情写完新章，对吧？",
            "nextDialogs": [
              "220100911"
            ]
          },
          "220100911": {
            "id": "220100911",
            "speakerId": 3033,
            "speakerName": "阿茂",
            "text": "就算是你再喜欢这个角色，也别让这个角色的要素这么多啊！读者都要看晕了！",
            "nextDialogs": [
              "220100912"
            ]
          },
          "220100912": {
            "id": "220100912",
            "speakerId": 3032,
            "speakerName": "顺吉",
            "text": "我的风格一直是这样，我觉得这样的剧情很爽快，读者肯定也会喜欢的！",
            "nextDialogs": [
              "220100913"
            ]
          },
          "220100913": {
            "id": "220100913",
            "speakerId": 3033,
            "speakerName": "阿茂",
            "text": "少来这套，你知道读者现在已经开始被你的那些生造词弄晕了吗！",
            "nextDialogs": [
              "220100914"
            ]
          },
          "220100914": {
            "id": "220100914",
            "speakerId": 3032,
            "speakerName": "顺吉",
            "text": "我不和你说了，你的观念太传统了，我们还是让这位旅行者评评理吧。",
            "nextDialogs": [
              "220100915"
            ]
          },
          "220100915": {
            "id": "220100915",
            "speakerId": 3032,
            "speakerName": "顺吉",
            "text": "旅行者，你觉得我和阿茂的想法，谁更对一些？"
          }
        }
      }
    },

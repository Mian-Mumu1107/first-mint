{
  "lineCounts": {
    "Player": 20,
    "阿茂": 36,
    "顺吉": 71
  },
  "subQuests": [
    {
      "subId": "2201001",
      "subQuestName": "拜访阿茂和顺吉",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "220100201"
        ],
        "dialogs": {
          "220100201": {
            "id": "220100201",
            "speakerId": 3032,
            "speakerName": "顺吉",
            "text": "我正在构思的章节里，主角在为下一场大战做准备。",
            "nextDialogs": [
              "220100202"
            ]
          },
          "220100202": {
            "id": "220100202",
            "speakerId": 3032,
            "speakerName": "顺吉",
            "text": "我觉得，他需要一个更强的武器，容我想想…",
            "nextDialogs": [
              "220100203"
            ]
          },
          "220100203": {
            "id": "220100203",
            "speakerId": 3032,
            "speakerName": "顺吉",
            "text": "我们就去「天目锻冶屋」看看吧。"
          }
        }
      }
    },
    {
      "subId": "2201002",
      "subQuestName": "与顺吉一同前往「天目锻冶屋」",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "220100601"
        ],
        "dialogs": {
          "220100601": {
            "id": "220100601",
            "speakerId": 3032,
            "speakerName": "顺吉",
            "text": "火花飞溅，铁锤和铁砧不停碰撞…",
            "nextDialogs": [
              "220100602"
            ]
          },
          "220100602": {
            "id": "220100602",
            "speakerId": 3032,
            "speakerName": "顺吉",
            "text": "「天目锻冶屋」真是个热情澎湃的地方！",
            "nextDialogs": [
              "220100603"
            ]
          },
          "220100603": {
            "id": "220100603",
            "speakerId": 3032,
            "speakerName": "顺吉",
            "text": "铁匠们只用简单的工具，就能把粗糙的原胚和矿石变成性能卓越的兵器。",
            "nextDialogs": [
              "220100604"
            ]
          },
          "220100604": {
            "id": "220100604",
            "speakerId": 3032,
            "speakerName": "顺吉",
            "text": "那要是在锻造的过程中，使用炼金术，岂不是能制造出无坚不摧的神兵利器？",
            "nextDialogs": [
              "220100608",
              "220100607"
            ]
          },
          "220100608": {
            "id": "220100608",
            "speakerId": 3032,
            "speakerName": "顺吉",
            "text": "嗯！这个主意不错，让主角拥有一把…由炼金术铸就的最强武器！",
            "nextDialogs": [
              "220100609"
            ]
          },
          "220100609": {
            "id": "220100609",
            "speakerId": 3032,
            "speakerName": "顺吉",
            "text": "而且还要让这把武器有一个好名字…和一个好来历。",
            "nextDialogs": [
              "220100610"
            ]
          },
          "220100610": {
            "id": "220100610",
            "speakerId": 3032,
            "speakerName": "顺吉",
            "text": "没错，就这么干！",
            "nextDialogs": [
              "220100611"
            ]
          },
          "220100611": {
            "id": "220100611",
            "speakerId": 3032,
            "speakerName": "顺吉",
            "text": "旅行者，我们回去吧，我要把我的构思告诉阿茂。"
          },
          "220100607": {
            "id": "220100607",
            "speakerId": 3032,
            "speakerName": "顺吉",
            "text": "误解？什么误解，炼金术不就是那种…把不可能化为可能的技术吗？"
          }
        }
      }
    },
    {
      "subId": "2201003",
      "subQuestName": "与顺吉一同前往「九十九物」",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "220100701"
        ],
        "dialogs": {
          "220100701": {
            "id": "220100701",
            "speakerId": 3032,
            "speakerName": "顺吉",
            "text": "「九十九物」里有着各式各样的商品，和冒险途中搜集的物品很像。",
            "nextDialogs": [
              "220100702"
            ]
          },
          "220100702": {
            "id": "220100702",
            "speakerId": 3032,
            "speakerName": "顺吉",
            "text": "葵小姐总是说，「一些其貌不扬的东西，也会被特定的买方看重」。",
            "nextDialogs": [
              "220100703"
            ]
          },
          "220100703": {
            "id": "220100703",
            "speakerId": 3032,
            "speakerName": "顺吉",
            "text": "唔…看来想要让商品卖出高价，找准买方重视的因素才是关键呢。",
            "nextDialogs": [
              "220100704"
            ]
          },
          "220100704": {
            "id": "220100704",
            "speakerId": 3032,
            "speakerName": "顺吉",
            "text": "但如果要这么写的话，就要花很大的功夫在描写心理博弈上，和「鬼武道」这本小说主题有些不合啊…",
            "nextDialogs": [
              "220100705"
            ]
          },
          "220100705": {
            "id": "220100705",
            "speakerId": 3032,
            "speakerName": "顺吉",
            "text": "不如让主角可以读心好了，这样他就可以准确洞察买方的需求…",
            "nextDialogs": [
              "220100707",
              "220100709"
            ]
          },
          "220100707": {
            "id": "220100707",
            "speakerId": 3032,
            "speakerName": "顺吉",
            "text": "这就是人物的「成长」啦，没关系的没关系的。",
            "nextDialogs": [
              "220100710"
            ]
          },
          "220100710": {
            "id": "220100710",
            "speakerId": 3032,
            "speakerName": "顺吉",
            "text": "我有灵感了，我明白该怎么写了！",
            "nextDialogs": [
              "220100711"
            ]
          },
          "220100711": {
            "id": "220100711",
            "speakerId": 3032,
            "speakerName": "顺吉",
            "text": "旅行者，我们回去吧，我要把我的构思告诉阿茂。"
          },
          "220100709": {
            "id": "220100709",
            "speakerId": 3032,
            "speakerName": "顺吉",
            "text": "剧情铺垫…唔，这个我写的时候会考虑的，应该不会有问题。"
          }
        }
      }
    },
    {
      "subId": "2201004",
      "subQuestName": "与顺吉一同观察同心们的工作",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "220100801"
        ],
        "dialogs": {
          "220100801": {
            "id": "220100801",
            "speakerId": 3032,
            "speakerName": "顺吉",
            "text": "同心们维持着花见坂的治安，可疑人士根本逃不过他们的监视。",
            "nextDialogs": [
              "220100802"
            ]
          },
          "220100802": {
            "id": "220100802",
            "speakerId": 3032,
            "speakerName": "顺吉",
            "text": "敌国的骑士，和同心有着相同的职责，但为了更大的看头，就设定成同心的…十倍实力吧。",
            "nextDialogs": [
              "220100804"
            ]
          },
          "220100804": {
            "id": "220100804",
            "speakerId": 3032,
            "speakerName": "顺吉",
            "text": "数值上的察觉是最直观的嘛，这样才能体现出主角的强大！",
            "nextDialogs": [
              "220100806"
            ]
          },
          "220100806": {
            "id": "220100806",
            "speakerId": 3032,
            "speakerName": "顺吉",
            "text": "至于主角怎么解决这个问题…就让主角有一个…呃，伪装的能力吧，能够自由改变外形和声音的那种。",
            "nextDialogs": [
              "220100807"
            ]
          },
          "220100807": {
            "id": "220100807",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "这是突然增加设定吗…",
            "nextDialogs": [
              "220100808"
            ]
          },
          "220100808": {
            "id": "220100808",
            "speakerId": 3032,
            "speakerName": "顺吉",
            "text": "这是主角的隐藏能力啦，遇见了需要用这种能力解决的敌人，当然要展现出来了。",
            "nextDialogs": [
              "220100809"
            ]
          },
          "220100809": {
            "id": "220100809",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "我说，你是现编的吧？",
            "nextDialogs": [
              "220100810"
            ]
          },
          "220100810": {
            "id": "220100810",
            "speakerId": 3032,
            "speakerName": "顺吉",
            "text": "那、那怎么可能啦…我当然是之前就想好了。",
            "nextDialogs": [
              "220100811"
            ]
          },
          "220100811": {
            "id": "220100811",
            "speakerId": 3032,
            "speakerName": "顺吉",
            "text": "好了，就这么办，我们回去把我的构思告诉阿茂吧。"
          }
        }
      }
    },
    {
      "subId": "2201005",
      "subQuestName": "回八重堂找阿茂",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "220100501"
        ],
        "dialogs": {
          "220100501": {
            "id": "220100501",
            "speakerId": 3033,
            "speakerName": "阿茂",
            "text": "希望这个月的合刊能按时送印啊…"
          }
        }
      }
    },
    {
      "subId": "2201006",
      "subQuestName": "(test)【隐藏】选支持顺吉$HIDDEN",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "220100916"
        ],
        "dialogs": {
          "220100916": {
            "id": "220100916",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "其实顺吉的想法还不错…",
            "nextDialogs": [
              "220100917"
            ]
          },
          "220100917": {
            "id": "220100917",
            "speakerId": 3033,
            "speakerName": "阿茂",
            "text": "还不错？这、这样写下去，到最后他自己都会被这些设定弄晕的！",
            "nextDialogs": [
              "220100918"
            ]
          },
          "220100918": {
            "id": "220100918",
            "speakerId": 3032,
            "speakerName": "顺吉",
            "text": "哈哈哈，你瞧，旅行者也支持我，说明我的构思足够吸引人！",
            "nextDialogs": [
              "220100919"
            ]
          },
          "220100919": {
            "id": "220100919",
            "speakerId": 3032,
            "speakerName": "顺吉",
            "text": "小说最重要的当然就是能吸引人的爽快剧情了，我现在就按这个思路去写了。",
            "nextDialogs": [
              "220100920"
            ]
          },
          "220100920": {
            "id": "220100920",
            "speakerId": 3033,
            "speakerName": "阿茂",
            "text": "我说你啊…",
            "nextDialogs": [
              "220100921"
            ]
          },
          "220100921": {
            "id": "220100921",
            "speakerId": 3032,
            "speakerName": "顺吉",
            "text": "别担心了，我自己写的东西我自己心里有数，这样写绝对会得到一致好评，你就看好吧。"
          }
        }
      }
    },
    {
      "subId": "2201007",
      "subQuestName": "(test)【隐藏】选支持阿茂$HIDDEN",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "220100922"
        ],
        "dialogs": {
          "220100922": {
            "id": "220100922",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "其实阿茂的看法更合理…",
            "nextDialogs": [
              "220100923"
            ]
          },
          "220100923": {
            "id": "220100923",
            "speakerId": 3032,
            "speakerName": "顺吉",
            "text": "更合理？合理性哪有爽快的情节重要，没有足够吸引人的故事，再合理的情节都只能带来无趣！",
            "nextDialogs": [
              "220100924"
            ]
          },
          "220100924": {
            "id": "220100924",
            "speakerId": 3033,
            "speakerName": "阿茂",
            "text": "你这家伙…你爽快了一时，到要给这个故事收尾的时候，你会被你之前搞的这些设定逼疯的！",
            "nextDialogs": [
              "220100925"
            ]
          },
          "220100925": {
            "id": "220100925",
            "speakerId": 3032,
            "speakerName": "顺吉",
            "text": "我、我自己做了笔记，收尾的时候怎么可能有问题！",
            "nextDialogs": [
              "220100926"
            ]
          },
          "220100926": {
            "id": "220100926",
            "speakerId": 3033,
            "speakerName": "阿茂",
            "text": "你自己都要做笔记才能记住这些设定了，你打算让读者也和你一样，一边读小说一边记笔记吗？",
            "nextDialogs": [
              "220100927"
            ]
          },
          "220100927": {
            "id": "220100927",
            "speakerId": 3032,
            "speakerName": "顺吉",
            "text": "呃…这…",
            "nextDialogs": [
              "220100928"
            ]
          },
          "220100928": {
            "id": "220100928",
            "speakerId": 3033,
            "speakerName": "阿茂",
            "text": "我也不是不让你使用这些设定，但就算要用，也要慎重地选择使用的方法和次数。",
            "nextDialogs": [
              "220100929"
            ]
          },
          "220100929": {
            "id": "220100929",
            "speakerId": 3033,
            "speakerName": "阿茂",
            "text": "写小说这件事，说到底是一个体力活，如果一开始就拼尽全力的话，越到后面只会越疲软。",
            "nextDialogs": [
              "220100930"
            ]
          },
          "220100930": {
            "id": "220100930",
            "speakerId": 3033,
            "speakerName": "阿茂",
            "text": "只有一步步地稳定前进，才是一本小说成功的关键，你就相信我吧。",
            "nextDialogs": [
              "220100931"
            ]
          },
          "220100931": {
            "id": "220100931",
            "speakerId": 3032,
            "speakerName": "顺吉",
            "text": "好、好吧…唉…"
          }
        }
      }
    },
    {
      "subId": "2201001",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "220100101"
        ],
        "dialogs": {
          "220100101": {
            "id": "220100101",
            "speakerId": 3033,
            "speakerName": "阿茂",
            "text": "顺吉，明天是交稿的最后期限，绝对不能再拖延了！",
            "nextDialogs": [
              "220100102"
            ]
          },
          "220100102": {
            "id": "220100102",
            "speakerId": 3032,
            "speakerName": "顺吉",
            "text": "你再怎么催我都没用，剧情卡在关键的地方了，我不知道该怎么写才好。",
            "nextDialogs": [
              "220100103"
            ]
          },
          "220100103": {
            "id": "220100103",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "你们在吵什么呢？",
            "nextDialogs": [
              "220100104"
            ]
          },
          "220100104": {
            "id": "220100104",
            "speakerId": 3033,
            "speakerName": "阿茂",
            "text": "是…是旅行者？你来得正好，正好你来评评理。",
            "nextDialogs": [
              "220100105"
            ]
          },
          "220100105": {
            "id": "220100105",
            "speakerId": 3033,
            "speakerName": "阿茂",
            "text": "我是「八重堂」的编辑阿茂。这位是我负责的作家顺吉。",
            "nextDialogs": [
              "220100106"
            ]
          },
          "220100106": {
            "id": "220100106",
            "speakerId": 3033,
            "speakerName": "阿茂",
            "text": "他的新小说《鬼武道》本来很受欢迎，但他总是不能按时交稿，有时会拖延好几周。",
            "nextDialogs": [
              "220100107"
            ]
          },
          "220100107": {
            "id": "220100107",
            "speakerId": 3033,
            "speakerName": "阿茂",
            "text": "这次他又犯老毛病了，如果明天还不交稿，这个月的小说合刊就没法按时送印了。",
            "nextDialogs": [
              "220100108"
            ]
          },
          "220100108": {
            "id": "220100108",
            "speakerId": 3032,
            "speakerName": "顺吉",
            "text": "实在不行，就延期发售吧，反正忠实的读者还是会掏钱的。",
            "nextDialogs": [
              "220100109"
            ]
          },
          "220100109": {
            "id": "220100109",
            "speakerId": 3033,
            "speakerName": "阿茂",
            "text": "别开玩笑了，要是不能连续更新的话，小说的口碑会一口气跌到谷底的！",
            "nextDialogs": [
              "220100110"
            ]
          },
          "220100110": {
            "id": "220100110",
            "speakerId": 3032,
            "speakerName": "顺吉",
            "text": "但我没有灵感，与其写一些无趣的注水章节，还不如好好思索一下真正有趣的故事！",
            "nextDialogs": [
              "220100111"
            ]
          },
          "220100111": {
            "id": "220100111",
            "speakerId": 3033,
            "speakerName": "阿茂",
            "text": "但其他作者都已经都差不多交齐了，就差你一个人了！",
            "nextDialogs": [
              "220100112"
            ]
          },
          "220100112": {
            "id": "220100112",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "或许顺吉先生真的需要灵感…",
            "nextDialogs": [
              "220100113"
            ]
          },
          "220100113": {
            "id": "220100113",
            "speakerId": 3032,
            "speakerName": "顺吉",
            "text": "没错！这位朋友就很懂行，我需要灵感！",
            "nextDialogs": [
              "220100114"
            ]
          },
          "220100114": {
            "id": "220100114",
            "speakerId": 3032,
            "speakerName": "顺吉",
            "text": "也许四处转转，找找灵感，我就知道接下来该怎么写了！",
            "nextDialogs": [
              "220100115"
            ]
          },
          "220100115": {
            "id": "220100115",
            "speakerId": 3033,
            "speakerName": "阿茂",
            "text": "喂，上次你就是拿这个借口又拖了一天，还想来这套吗？",
            "nextDialogs": [
              "220100116"
            ]
          },
          "220100116": {
            "id": "220100116",
            "speakerId": 3032,
            "speakerName": "顺吉",
            "text": "这次绝对不会了，你也相信我一回啊！",
            "nextDialogs": [
              "220100117"
            ]
          },
          "220100117": {
            "id": "220100117",
            "speakerId": 3033,
            "speakerName": "阿茂",
            "text": "真是的…好吧，就再相信你一回…",
            "nextDialogs": [
              "220100118"
            ]
          },
          "220100118": {
            "id": "220100118",
            "speakerId": 3033,
            "speakerName": "阿茂",
            "text": "一定，一定不能再拖了，知道了吗？",
            "nextDialogs": [
              "220100119"
            ]
          },
          "220100119": {
            "id": "220100119",
            "speakerId": 3032,
            "speakerName": "顺吉",
            "text": "我知道了，我知道了…",
            "nextDialogs": [
              "220100120"
            ]
          },
          "220100120": {
            "id": "220100120",
            "speakerId": 3032,
            "speakerName": "顺吉",
            "text": "呼…这回看来是真的不能拖了…",
            "nextDialogs": [
              "220100123"
            ]
          },
          "220100123": {
            "id": "220100123",
            "speakerId": 3032,
            "speakerName": "顺吉",
            "text": "但灵感这东西，有时候找也找不到啊…",
            "nextDialogs": [
              "220100124"
            ]
          },
          "220100124": {
            "id": "220100124",
            "speakerId": 3032,
            "speakerName": "顺吉",
            "text": "不过现在也只能四处找找看了，不然阿茂非把我的屋子给掀了…"
          }
        }
      }
    },

          }
        }
      }
    },
    {
      "subId": "2201004",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "220100401"
        ],
        "dialogs": {
          "220100401": {
            "id": "220100401",
            "speakerId": 3032,
            "speakerName": "顺吉",
            "text": "我正在构思的章节里，主角独自去往了敌人的领地。",
            "nextDialogs": [
              "220100402"
            ]
          },
          "220100402": {
            "id": "220100402",
            "speakerId": 3032,
            "speakerName": "顺吉",
            "text": "想要在那里对抗敌人们，收集情报是一项必要的工作，该怎么让他从容地度过这关呢…",
            "nextDialogs": [
              "220100403"
            ]
          },

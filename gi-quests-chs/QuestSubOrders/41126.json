    {
      "subId": "4112605",
      "subQuestName": "向轻策庄里的人询问小六的去向",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "411260501"
        ],
        "dialogs": {
          "411260501": {
            "id": "411260501",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "关于小六…",
            "nextDialogs": [
              "411260502"
            ]
          },
          "411260502": {
            "id": "411260502",
            "speakerId": 1003,
            "speakerName": "云淡",
            "text": "小六，哦…那孩子啊，我记得她说要找个高点的地方看陨石…",
            "nextDialogs": [
              "411260503"
            ]
          },
          "411260503": {
            "id": "411260503",
            "speakerId": 1003,
            "speakerName": "云淡",
            "text": "唔，好像是<color=#00E1FFFF>顺着那边的梯子爬上去</color>了吧。"
          }
        }
      }
    },
    {
      "subId": "4112606",
      "subQuestName": "向轻策庄里的人询问小六的去向",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "411260601"
        ],
        "dialogs": {
          "411260601": {
            "id": "411260601",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "关于小六…",
            "nextDialogs": [
              "411260602"
            ]
          },
          "411260602": {
            "id": "411260602",
            "speakerId": 1004,
            "speakerName": "东东",
            "text": "你问小六啊，我们本来约好了一起在这看陨石的，但她说要找个高点的地方看。",
            "nextDialogs": [
              "411260603"
            ]
          },
          "411260603": {
            "id": "411260603",
            "speakerId": 1004,
            "speakerName": "东东",
            "text": "她说找到了地方之后就回来告诉我…我还真不知道她现在在哪。"
          }
        }
      }
    },
    {
      "subId": "4112607",
      "subQuestName": "向轻策庄里的人询问小六的去向",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "411260701"
        ],
        "dialogs": {
          "411260701": {
            "id": "411260701",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "关于小六…",
            "nextDialogs": [
              "411260702"
            ]
          },
          "411260702": {
            "id": "411260702",
            "speakerId": 1005,
            "speakerName": "鬼伯伯",
            "text": "小六…小六，我倒是知道这孩子，但我一直在这呆着，没见着她经过。"
          }
        }
      }
    },
    {
      "subId": "4112608",
      "subQuestName": "保护环$HIDDEN",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "411260801"
        ],
        "dialogs": {
          "411260801": {
            "id": "411260801",
            "speakerId": 1002,
            "speakerName": "小六",
            "text": "在这里，应该就能看清楚陨石了…",
            "nextDialogs": [
              "411260802"
            ]
          },
          "411260802": {
            "id": "411260802",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "有封信给你。",
            "nextDialogs": [
              "411260803"
            ]
          },
          "411260803": {
            "id": "411260803",
            "speakerId": 1002,
            "speakerName": "小六",
            "text": "爸爸写给我的信…唔，我大概知道里面写了什么…",
            "nextDialogs": [
              "411260804"
            ]
          },
          "411260804": {
            "id": "411260804",
            "speakerId": 1002,
            "speakerName": "小六",
            "text": "肯定是说，他又因为工作没法回来陪我了。",
            "nextDialogs": [
              "411260805"
            ]
          },
          "411260805": {
            "id": "411260805",
            "speakerId": 1002,
            "speakerName": "小六",
            "text": "那些千岩军叔叔过来的时候，我还以为爸爸也会一起来呢，结果他还是没来…",
            "nextDialogs": [
              "411260806"
            ]
          },
          "411260806": {
            "id": "411260806",
            "speakerId": 1002,
            "speakerName": "小六",
            "text": "不过也好，那么多大石头从天上掉下来，要是爸爸在野外的话，说不定会有危险。",
            "nextDialogs": [
              "411260808",
              "411260810"
            ]
          },
          "411260808": {
            "id": "411260808",
            "speakerId": 1002,
            "speakerName": "小六",
            "text": "嗯…有一点点，但是有千岩军叔叔在这里呢，不会有问题的。",
            "nextDialogs": [
              "411260811"
            ]
          },
          "411260811": {
            "id": "411260811",
            "speakerId": 1002,
            "speakerName": "小六",
            "text": "对了，那你帮我把这封信送给爸爸吧，他肯定担心我了。",
            "nextDialogs": [
              "411260812"
            ]
          },
          "411260812": {
            "id": "411260812",
            "speakerId": 1002,
            "speakerName": "小六",
            "text": "唉…真奇怪，爸爸每次说要请假回来陪我的时候，都会出点事让他没法回来…"
          },
          "411260810": {
            "id": "411260810",
            "speakerId": 1002,
            "speakerName": "小六",
            "text": "我知道，那些千岩军叔叔不知道说了多少遍了。"
          }
        }
      }
    },

    {
      "subId": "4112610",
      "subQuestName": "向嘉义回报",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "411261001"
        ],
        "dialogs": {
          "411261001": {
            "id": "411261001",
            "speakerId": 1000,
            "speakerName": "嘉义",
            "text": "谢谢，旅行者。这封信我先收着，现在可不是读信的时候…我马上要出去执行任务了。",
            "nextDialogs": [
              "411261002"
            ]
          },
          "411261002": {
            "id": "411261002",
            "speakerId": 1000,
            "speakerName": "嘉义",
            "text": "这是给你的报酬，辛苦你了。",
            "nextDialogs": [
              "411261003"
            ]
          },
          "411261003": {
            "id": "411261003",
            "speakerId": 1000,
            "speakerName": "嘉义",
            "text": "等这次事情过去，我一定要请个长假…"
          }
        }
      }
    },
    {
      "subId": "4112611",

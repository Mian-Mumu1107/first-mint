            "id": "411260201",
            "speakerId": 1000,
            "speakerName": "嘉义",
            "text": "唉，我这个假到底什么时候才能请到…"
          }
        }
      }
    },
    {
      "subId": "4112609",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "411260901"
        ],
        "dialogs": {
          "411260901": {
            "id": "411260901",
            "speakerId": 1000,
            "speakerName": "嘉义",
            "text": "你回来了，信送到了吗？",
            "nextDialogs": [
              "411260902"
            ]
          },
          "411260902": {
            "id": "411260902",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "送到了，这是小六给你的信。",
            "nextDialogs": [
              "411260903"
            ]
          },
          "411260903": {
            "id": "411260903",
            "speakerId": 1000,

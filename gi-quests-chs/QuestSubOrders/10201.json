  "subQuests": [
    {
      "subId": "1020101",
      "subQuestName": "前往低语森林，找到藏宝地",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "102010101"
        ],
        "dialogs": {
          "102010101": {
            "id": "102010101",
            "speakerId": 10090,
            "speakerName": "可莉",
            "text": "到了到了！就在这附近！",
            "nextDialogs": [
              "102010102"
            ]
          },
          "102010102": {
            "id": "102010102",
            "speakerId": 10090,
            "speakerName": "可莉",
            "text": "你们看，我那~~么大一个宝物，之前就是埋在这儿的…",
            "nextDialogs": [
              "102010103"
            ]
          },
          "102010103": {
            "id": "102010103",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "被挖出了一个坑呢…",
            "nextDialogs": [
              "102010104"
            ]
          },
          "102010104": {
            "id": "102010104",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "等等，那边有谁…",
            "nextDialogs": [
              "102010105"
            ]
          },
          "102010105": {
            "id": "102010105",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "是深渊法师？！难道它就是琴团长之前警告的，偷偷接近蒙德城的…",
            "nextDialogs": [
              "102010106"
            ]
          },
          "102010106": {
            "id": "102010106",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "咦？它手里拿着的是什么？",
            "nextDialogs": [
              "102010107"
            ]
          },
          "102010107": {
            "id": "102010107",
            "speakerId": 10090,
            "speakerName": "可莉",
            "text": "是我的宝物！",
            "nextDialogs": [
              "102010108"
            ]
          },
          "102010108": {
            "id": "102010108",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "欸？！",
            "nextDialogs": [
              "102010109"
            ]
          },
          "102010109": {
            "id": "102010109",
            "speakerId": 10091,
            "speakerName": "深渊法师",
            "text": "嘁，那女孩居然带了帮手。计划有变…",
            "nextDialogs": [
              "102010110"
            ]
          },
          "102010110": {
            "id": "102010110",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "喂！你有本事别逃呀！",
            "nextDialogs": [
              "102010111"
            ]
          },
          "102010111": {
            "id": "102010111",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "我们追。"
          }
        }
      }
    },

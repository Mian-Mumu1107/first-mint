    {
      "subId": "1020102",
      "subQuestName": "与可莉一起追逐深渊法师（>50米失败）",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "102010201"
        ],
        "dialogs": {
          "102010201": {
            "id": "102010201",
            "speakerId": 10090,
            "speakerName": "可莉",
            "text": "「深渊法师」？之前来森林里玩的时候，没有见过呢…"
          }
        }
      }
    },
    {
      "subId": "1020103",
      "subQuestName": "(test)追逐I$HIDDEN",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "102010301"
        ],
        "dialogs": {
          "102010301": {
            "id": "102010301",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "啊，是秘境的入口！深渊法师一定是逃进去了吧。",
            "nextDialogs": [
              "102010304"
            ]
          },
          "102010304": {
            "id": "102010304",
            "speakerId": 10090,
            "speakerName": "可莉",
            "text": "呼…呼……",
            "nextDialogs": [
              "102010305"
            ]
          },
          "102010305": {
            "id": "102010305",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "小可莉，还跑得动吗？",
            "nextDialogs": [
              "102010306"
            ]
          },
          "102010306": {
            "id": "102010306",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "要不要留在这里，我们讨来宝物之后还给你。",
            "nextDialogs": [
              "102010307"
            ]
          },
          "102010307": {
            "id": "102010307",
            "speakerId": 10090,
            "speakerName": "可莉",
            "text": "…不，不行，我要跟你们一起去！",
            "nextDialogs": [
              "102010308"
            ]
          },
          "102010308": {
            "id": "102010308",
            "speakerId": 10090,
            "speakerName": "可莉",
            "text": "毛茸茸偷的是我的东西，我自己也要负责把它夺回来！"
          }
        }
      }
    },
    {
      "subId": "1020114",
      "subQuestName": "(test)战斗I对话$HIDDEN",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "102010601"
        ],
        "dialogs": {
          "102010601": {
            "id": "102010601",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "快把宝物交出来！",
            "nextDialogs": [
              "102010602"
            ]
          },
          "102010602": {
            "id": "102010602",
            "speakerId": 10032,
            "speakerName": "深渊法师",
            "text": "呼…烦死了…",
            "nextDialogs": [
              "102010603"
            ]
          },
          "102010603": {
            "id": "102010603",
            "speakerId": 10032,
            "speakerName": "深渊法师",
            "text": "好不容易到手的…怎么可能还给你。",
            "nextDialogs": [
              "102010604"
            ]
          },
          "102010604": {
            "id": "102010604",
            "speakerId": 10032,
            "speakerName": "深渊法师",
            "text": "哼…"
          }
        }
      }
    },
    {
      "subId": "1020104",
      "subQuestName": "(test)战斗I$HIDDEN",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "102010401"
        ],
        "dialogs": {
          "102010401": {
            "id": "102010401",
            "speakerId": 10032,
            "speakerName": "深渊法师",
            "text": "哼，追上来了吗。看来你们还算有两下子。",
            "nextDialogs": [
              "102010402"
            ]
          },
          "102010402": {
            "id": "102010402",
            "speakerId": 10032,
            "speakerName": "深渊法师",
            "text": "不过，你们也就到此为止了。",
            "nextDialogs": [
              "102010403"
            ]
          },
          "102010403": {
            "id": "102010403",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "你想要做什么？",
            "nextDialogs": [
              "102010404"
            ]
          },
          "102010404": {
            "id": "102010404",
            "speakerId": 10032,
            "speakerName": "深渊法师",
            "text": "哈哈哈哈哈哈。",
            "nextDialogs": [
              "102010405"
            ]
          },
          "102010405": {
            "id": "102010405",
            "speakerId": 10032,
            "speakerName": "深渊法师",
            "text": "我们可是在人类的传言里，收集到了详细的战力情报。",
            "nextDialogs": [
              "102010406"
            ]
          },
          "102010406": {
            "id": "102010406",
            "speakerId": 10032,
            "speakerName": "深渊法师",
            "text": "这个红衣服的小女孩，拥有蒙德城最厉害的宝物。",
            "nextDialogs": [
              "102010407"
            ]
          },
          "102010407": {
            "id": "102010407",
            "speakerId": 10032,
            "speakerName": "深渊法师",
            "text": "现在宝物在我手上，你们再着急也没用了。",
            "nextDialogs": [
              "102010408"
            ]
          },
          "102010408": {
            "id": "102010408",
            "speakerId": 10032,
            "speakerName": "深渊法师",
            "text": "好——就用这个宝物来对付你们吧！",
            "nextDialogs": [
              "102010409"
            ]
          },
          "102010409": {
            "id": "102010409",
            "speakerId": 10090,
            "speakerName": "可莉",
            "text": "不行！千…千万别动它！",
            "nextDialogs": [
              "102010410"
            ]
          },
          "102010410": {
            "id": "102010410",
            "speakerId": 10032,
            "speakerName": "深渊法师",
            "text": "哼哼，看你慌张的样子，终于知道害怕了吗。",
            "nextDialogs": [
              "102010411"
            ]
          },
          "102010411": {
            "id": "102010411",
            "speakerId": 10032,
            "speakerName": "深渊法师",
            "text": "让我看看，哦…火焰的标记吗，哼哼哼哼。",
            "nextDialogs": [
              "102010412"
            ]
          },
          "102010412": {
            "id": "102010412",
            "speakerId": 10205,
            "speakerName": "？？？",
            "text": "嘣——",
            "nextDialogs": [
              "102010501"
            ]
          },
          "102010501": {
            "id": "102010501",
            "speakerId": 10090,
            "speakerName": "可莉",
            "text": "啊！",
            "nextDialogs": [
              "102010502"
            ]
          },
          "102010502": {
            "id": "102010502",
            "speakerId": 10090,
            "speakerName": "可莉",
            "text": "生存守则之——「炸弹伤人琴找上门」…",
            "nextDialogs": [
              "102010503"
            ]
          },
          "102010503": {
            "id": "102010503",
            "speakerId": 10090,
            "speakerName": "可莉",
            "text": "完了完了…这下全完了呜呜呜……",
            "nextDialogs": [
              "102010504"
            ]
          },
          "102010504": {
            "id": "102010504",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "……",
            "nextDialogs": [
              "102010505"
            ]
          },
          "102010505": {
            "id": "102010505",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "可莉的「宝物」，原来是炸弹吗！",
            "nextDialogs": [
              "102010508"
            ]
          },
          "102010508": {
            "id": "102010508",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "唔，难怪会有可莉是蒙德最强战力的传言呢。",
            "nextDialogs": [
              "102010509"
            ]
          },
          "102010509": {
            "id": "102010509",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "至少我是肯定不敢跟她打架的啦。",
            "nextDialogs": [
              "102010510"
            ]
          },
          "102010510": {
            "id": "102010510",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "但是，她为什么要逃走呢？"
          }
        }
      }
    },

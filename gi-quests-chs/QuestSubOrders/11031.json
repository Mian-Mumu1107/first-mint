  "subQuests": [
    {
      "subId": "1103101",
      "subQuestName": "陪同甘雨回到璃月港",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "110310101"
        ],
        "dialogs": {
          "110310101": {
            "id": "110310101",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "终于回来了！",
            "nextDialogs": [
              "110310102"
            ]
          },
          "110310102": {
            "id": "110310102",
            "speakerId": 1015,
            "speakerName": "甘雨",
            "text": "唉…我果然还是…",
            "nextDialogs": [
              "110310103"
            ]
          },
          "110310103": {
            "id": "110310103",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "都到这里了，甘雨小姐总不会又要回去了吧？",
            "nextDialogs": [
              "110310104"
            ]
          },
          "110310104": {
            "id": "110310104",
            "speakerId": 1015,
            "speakerName": "甘雨",
            "text": "…你说的也是，而且现在离开也对二位太不礼貌了。",
            "nextDialogs": [
              "110310105"
            ]
          },
          "110310105": {
            "id": "110310105",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "嘿嘿，那么甘雨小姐想先去哪里呢？",
            "nextDialogs": [
              "110310106"
            ]
          },
          "110310106": {
            "id": "110310106",
            "speakerId": 1015,
            "speakerName": "甘雨",
            "text": "山间待久了，想要第一时间见到大海…",
            "nextDialogs": [
              "110310107"
            ]
          },
          "110310107": {
            "id": "110310107",
            "speakerId": 1015,
            "speakerName": "甘雨",
            "text": "那我们先去港口转转吧。",
            "nextDialogs": [
              "110310108"
            ]
          },
          "110310108": {
            "id": "110310108",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "乐意奉陪！"
          }
        }
      }
    },
    {
      "subId": "1103102",
      "subQuestName": "与甘雨对话",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [],
        "dialogs": {}
      }
    },
    {
      "subId": "1103103",
      "subQuestName": "到璃月港码头附近逛逛",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "110310301"
        ],
        "dialogs": {
          "110310301": {
            "id": "110310301",
            "speakerId": 2029,
            "speakerName": "慧心",
            "text": "甘雨前辈！可真是好久不见！",
            "nextDialogs": [
              "110310302"
            ]
          },
          "110310302": {
            "id": "110310302",
            "speakerId": 2029,
            "speakerName": "慧心",
            "text": "不知为什么，在正忙乱的时候见了你，就突然会有一种安心的感觉。",
            "nextDialogs": [
              "110310303"
            ]
          },
          "110310303": {
            "id": "110310303",
            "speakerId": 1015,
            "speakerName": "甘雨",
            "text": "是慧心呀，好久不见，你这么说就有些夸张了。",
            "nextDialogs": [
              "110310304"
            ]
          },
          "110310304": {
            "id": "110310304",
            "speakerId": 1015,
            "speakerName": "甘雨",
            "text": "刚听说你这边遇到些麻烦，就特地过来看一下有没有什么帮得上忙的地方。",
            "nextDialogs": [
              "110310305"
            ]
          },
          "110310305": {
            "id": "110310305",
            "speakerId": 2029,
            "speakerName": "慧心",
            "text": "唉…一定是我父亲叫前辈过来的吧…",
            "nextDialogs": [
              "110310306"
            ]
          },
          "110310306": {
            "id": "110310306",
            "speakerId": 2029,
            "speakerName": "慧心",
            "text": "他又在滥用「七星」的身份麻烦你…",
            "nextDialogs": [
              "110310307"
            ]
          },
          "110310307": {
            "id": "110310307",
            "speakerId": 1015,
            "speakerName": "甘雨",
            "text": "呵呵，没有的事，既然是月海亭的后辈遇上麻烦，我随时愿意帮忙。",
            "nextDialogs": [
              "110310308"
            ]
          },
          "110310308": {
            "id": "110310308",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "甘雨不仅是称职的秘书，更是称职的前辈呢…",
            "nextDialogs": [
              "110310309"
            ]
          },
          "110310309": {
            "id": "110310309",
            "speakerId": 1015,
            "speakerName": "甘雨",
            "text": "所以问题出在哪里了，可以先跟我说说吗？",
            "nextDialogs": [
              "110310310"
            ]
          },
          "110310310": {
            "id": "110310310",
            "speakerId": 2029,
            "speakerName": "慧心",
            "text": "啊，是这样的…我之前在整理税单的时候，发现一些蹊跷…",
            "nextDialogs": [
              "110310311"
            ]
          },
          "110310311": {
            "id": "110310311",
            "speakerId": 2029,
            "speakerName": "慧心",
            "text": "「荣发商铺」和「万有铺子」两家店的报税情况明显有问题，可不论是质问还是查账，问题都没有进展。",
            "nextDialogs": [
              "110310312"
            ]
          },
          "110310312": {
            "id": "110310312",
            "speakerId": 2029,
            "speakerName": "慧心",
            "text": "没有证据的话，又没办法采用强制手段…",
            "nextDialogs": [
              "110310313"
            ]
          },
          "110310313": {
            "id": "110310313",
            "speakerId": 1015,
            "speakerName": "甘雨",
            "text": "原来如此，并不少见。商人为了钱，总会做些利欲熏心的事。",
            "nextDialogs": [
              "110310314"
            ]
          },
          "110310314": {
            "id": "110310314",
            "speakerId": 2029,
            "speakerName": "慧心",
            "text": "那么，前辈你有什么解决的方法吗？",
            "nextDialogs": [
              "110310315"
            ]
          },
          "110310315": {
            "id": "110310315",
            "speakerId": 1015,
            "speakerName": "甘雨",
            "text": "自然有，类似的事件我处理过成百上千次，让我想想这次该用什么方法…",
            "nextDialogs": [
              "110310316"
            ]
          },
          "110310316": {
            "id": "110310316",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "这就是千年级的工作经验吗…",
            "nextDialogs": [
              "110310317"
            ]
          },
          "110310317": {
            "id": "110310317",
            "speakerId": 1015,
            "speakerName": "甘雨",
            "text": "嗯…这次就选用这种方法吧——「最了解一个人的，往往是他的敌人。」",
            "nextDialogs": [
              "110310318"
            ]
          },
          "110310318": {
            "id": "110310318",
            "speakerId": 2029,
            "speakerName": "慧心",
            "text": "欸？",
            "nextDialogs": [
              "110310319"
            ]
          },
          "110310319": {
            "id": "110310319",
            "speakerId": 1015,
            "speakerName": "甘雨",
            "text": "在我的印象里，「荣发商铺」和「万有铺子」在商品类别和市场划分上，一直存在竞争的关系…",
            "nextDialogs": [
              "110310320"
            ]
          },
          "110310320": {
            "id": "110310320",
            "speakerId": 1015,
            "speakerName": "甘雨",
            "text": "既然如此…",
            "nextDialogs": [
              "110310321"
            ]
          },
          "110310321": {
            "id": "110310321",
            "speakerId": 2029,
            "speakerName": "慧心",
            "text": "既然如此…啊，我明白你的意思了，甘雨前辈！",
            "nextDialogs": [
              "110310323",
              "110310325"
            ]
          },
          "110310323": {
            "id": "110310323",
            "speakerId": 2029,
            "speakerName": "慧心",
            "text": "甘雨前辈的意思，是要让他们相互揭发。",
            "nextDialogs": [
              "110310326"
            ]
          },
          "110310326": {
            "id": "110310326",
            "speakerId": 1015,
            "speakerName": "甘雨",
            "text": "我们先去「万有铺子」吧，记得老板叫…博来，对吧？",
            "nextDialogs": [
              "110310327"
            ]
          },
          "110310327": {
            "id": "110310327",
            "speakerId": 2029,
            "speakerName": "慧心",
            "text": "嗯，是的，请跟我来！"
          },
          "110310325": {
            "id": "110310325",
            "speakerId": 1015,
            "speakerName": "甘雨",
            "text": "没错。"
          }
        }
      }
    },
    {
      "subId": "1103104",
      "subQuestName": "到璃月港码头附近逛逛",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "110310201"
        ],
        "dialogs": {
          "110310201": {
            "id": "110310201",
            "speakerId": 1015,
            "speakerName": "甘雨",
            "text": "熟悉的港口，还有这海浪声…",
            "nextDialogs": [
              "110310202"
            ]
          },
          "110310202": {
            "id": "110310202",
            "speakerId": 1015,
            "speakerName": "甘雨",
            "text": "令人怀念的海风气味…",
            "nextDialogs": [
              "110310203"
            ]
          },
          "110310203": {
            "id": "110310203",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "甘雨小姐好像没离开多久吧，为什么看起来这么感慨。",
            "nextDialogs": [
              "110310204"
            ]
          },
          "110310204": {
            "id": "110310204",
            "speakerId": 1015,
            "speakerName": "甘雨",
            "text": "啊，之前因为工作太忙的缘故，确实很久没有来过这边散步了。",
            "nextDialogs": [
              "110310205"
            ]
          },
          "110310205": {
            "id": "110310205",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "确实甘雨一直都在加班的样子。",
            "nextDialogs": [
              "110310206"
            ]
          },
          "110310206": {
            "id": "110310206",
            "speakerId": 1015,
            "speakerName": "甘雨",
            "text": "嗯，想一想在这边的时光，我也总是一个人在书案后面处理文件…",
            "nextDialogs": [
              "110310207"
            ]
          },
          "110310207": {
            "id": "110310207",
            "speakerId": 1015,
            "speakerName": "甘雨",
            "text": "心境上来说，跟在绝云间修行的感觉也差不多呢。",
            "nextDialogs": [
              "110310208"
            ]
          },
          "110310208": {
            "id": "110310208",
            "speakerId": 2003,
            "speakerName": "天叔",
            "text": "这不是…甘雨姐姐吗？",
            "nextDialogs": [
              "110310209"
            ]
          },
          "110310209": {
            "id": "110310209",
            "speakerId": 2003,
            "speakerName": "天叔",
            "text": "哈哈哈…真想不到在这里遇见您，我记得您可一直忙得很呐。",
            "nextDialogs": [
              "110310210"
            ]
          },
          "110310210": {
            "id": "110310210",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "这、这位大爷在叫「甘雨姐姐」！",
            "nextDialogs": [
              "110310214",
              "110310213"
            ]
          },
          "110310214": {
            "id": "110310214",
            "speakerId": 1015,
            "speakerName": "甘雨",
            "text": "咳咳…还没有向二位介绍，这位是天叔，身份是…",
            "nextDialogs": [
              "110310215"
            ]
          },
          "110310215": {
            "id": "110310215",
            "speakerId": 2003,
            "speakerName": "天叔",
            "text": "没关系，和他们讲便是，毕竟是璃月的功臣，至今还没有正式拜会。",
            "nextDialogs": [
              "110310216"
            ]
          },
          "110310216": {
            "id": "110310216",
            "speakerId": 1015,
            "speakerName": "甘雨",
            "text": "…天叔的身份是「璃月七星」之一，「天枢星」。",
            "nextDialogs": [
              "110310217"
            ]
          },
          "110310217": {
            "id": "110310217",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "什么！这位大爷是「七星」之中的一位？",
            "nextDialogs": [
              "110310218"
            ]
          },
          "110310218": {
            "id": "110310218",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "和凝光平起平坐！？",
            "nextDialogs": [
              "110310219"
            ]
          },
          "110310219": {
            "id": "110310219",
            "speakerId": 2003,
            "speakerName": "天叔",
            "text": "嘘…身份的事，还望各位保密。",
            "nextDialogs": [
              "110310220"
            ]
          },
          "110310220": {
            "id": "110310220",
            "speakerId": 2003,
            "speakerName": "天叔",
            "text": "毕竟在这港口钓钓鱼，散散步，是我最大的乐趣。我可不想时刻有那些拿枪的兵士跟着。",
            "nextDialogs": [
              "110310221"
            ]
          },
          "110310221": {
            "id": "110310221",
            "speakerId": 2003,
            "speakerName": "天叔",
            "text": "大部分人眼里，我就是个又健忘又啰嗦的老头子罢了。",
            "nextDialogs": [
              "110310222"
            ]
          },
          "110310222": {
            "id": "110310222",
            "speakerId": 1015,
            "speakerName": "甘雨",
            "text": "天叔是在自谦了。他虽然年事已高，但由于德高望重，一直没有别人能替代他的位置。"
          },
          "110310213": {
            "id": "110310213",
            "speakerId": 1015,
            "speakerName": "甘雨",
            "text": "啊…请不要借机…"
          }
        }
      }
    },
    {
      "subId": "1103105",
      "subQuestName": "前往月海亭，与慧心对话",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [],
        "dialogs": {}
      }
    },
    {
      "subId": "1103106",
      "subQuestName": "前往「万有铺子」，与博来对话",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "110310401"
        ],
        "dialogs": {
          "110310401": {
            "id": "110310401",
            "speakerId": 2013,
            "speakerName": "博来",
            "text": "哟，之前见过的旅行者，还有两位…你们是从月海亭来的吧？",
            "nextDialogs": [
              "110310402"
            ]
          },
          "110310402": {
            "id": "110310402",
            "speakerId": 2013,
            "speakerName": "博来",
            "text": "呵呵，莫非有什么大订单，要恩赐给我？",
            "nextDialogs": [
              "110310403"
            ]
          },
          "110310403": {
            "id": "110310403",
            "speakerId": 1015,
            "speakerName": "甘雨",
            "text": "您多虑了，博来先生。目前为止「万有铺子」的信用，还不足以直接接受来自月海亭的大订单啊。",
            "nextDialogs": [
              "110310404"
            ]
          },
          "110310404": {
            "id": "110310404",
            "speakerId": 1015,
            "speakerName": "甘雨",
            "text": "就算有这样的机会，想必也一定会落在「荣发商铺」那边。",
            "nextDialogs": [
              "110310405"
            ]
          },
          "110310405": {
            "id": "110310405",
            "speakerId": 2013,
            "speakerName": "博来",
            "text": "什么！「荣发商铺」？",
            "nextDialogs": [
              "110310406"
            ]
          },
          "110310406": {
            "id": "110310406",
            "speakerId": 2013,
            "speakerName": "博来",
            "text": "可恶…东升那小子，凭什么便宜都要让他抢了去…",
            "nextDialogs": [
              "110310407"
            ]
          },
          "110310407": {
            "id": "110310407",
            "speakerId": 1015,
            "speakerName": "甘雨",
            "text": "嗯，「荣发商铺」的信用一直非常良好，而且从每年的报税情况看，也都十分积极主动…",
            "nextDialogs": [
              "110310408"
            ]
          },
          "110310408": {
            "id": "110310408",
            "speakerId": 2013,
            "speakerName": "博来",
            "text": "呵呵呵…报税？积极主动？",
            "nextDialogs": [
              "110310409"
            ]
          },
          "110310409": {
            "id": "110310409",
            "speakerId": 1015,
            "speakerName": "甘雨",
            "text": "嗯？博来先生刚才的意思是？",
            "nextDialogs": [
              "110310410"
            ]
          },
          "110310410": {
            "id": "110310410",
            "speakerId": 2013,
            "speakerName": "博来",
            "text": "你们别上当，就那小子的一肚子坏水，我最清楚不过了。",
            "nextDialogs": [
              "110310411"
            ]
          },
          "110310411": {
            "id": "110310411",
            "speakerId": 2013,
            "speakerName": "博来",
            "text": "不信你把他们店的税单给我看看，我准能找出什么岔子的。",
            "nextDialogs": [
              "110310412"
            ]
          },
          "110310412": {
            "id": "110310412",
            "speakerId": 1015,
            "speakerName": "甘雨",
            "text": "你对「荣发商铺」的经营情况那么了解？",
            "nextDialogs": [
              "110310413"
            ]
          },
          "110310413": {
            "id": "110310413",
            "speakerId": 2013,
            "speakerName": "博来",
            "text": "当然！每一笔他们家的生意，都恨得我咬牙切齿！",
            "nextDialogs": [
              "110310414"
            ]
          },
          "110310414": {
            "id": "110310414",
            "speakerId": 2013,
            "speakerName": "博来",
            "text": "看到那小子挣钱，比我自己亏钱还难受！",
            "nextDialogs": [
              "110310417"
            ]
          },
          "110310417": {
            "id": "110310417",
            "speakerId": 1015,
            "speakerName": "甘雨",
            "text": "那么，这份税单请过目吧，根据你反映的情况，我们会对「荣发商铺」的信用重新进行评估。",
            "nextDialogs": [
              "110310418"
            ]
          },
          "110310418": {
            "id": "110310418",
            "speakerId": 2013,
            "speakerName": "博来",
            "text": "好的好的，我一定仔仔细细地过目…",
            "nextDialogs": [
              "110310419"
            ]
          },
          "110310419": {
            "id": "110310419",
            "speakerId": 2013,
            "speakerName": "博来",
            "text": "一条一条，一字一字…",
            "nextDialogs": [
              "110310420"
            ]
          },
          "110310420": {
            "id": "110310420",
            "speakerId": 2013,
            "speakerName": "博来",
            "text": "有了！有了有了！",
            "nextDialogs": [
              "110310421"
            ]
          },
          "110310421": {
            "id": "110310421",
            "speakerId": 2013,
            "speakerName": "博来",
            "text": "年初从「范木堂」那里进货的高档木质家具呢？他还故意在我面前炫耀过！",
            "nextDialogs": [
              "110310422"
            ]
          },
          "110310422": {
            "id": "110310422",
            "speakerId": 2013,
            "speakerName": "博来",
            "text": "瞧瞧这税单，只字未提！利润全被那小子吞了！",
            "nextDialogs": [
              "110310423"
            ]
          },
          "110310423": {
            "id": "110310423",
            "speakerId": 2029,
            "speakerName": "慧心",
            "text": "原来如此，他似乎把这笔买卖的所有相关凭证全都处理掉了…怪不得查不出…",
            "nextDialogs": [
              "110310424"
            ]
          },
          "110310424": {
            "id": "110310424",
            "speakerId": 2013,
            "speakerName": "博来",
            "text": "哼，我就说…果然没让我失望，我已经等不及看他窘迫的样子了。",
            "nextDialogs": [
              "110310425"
            ]
          },
          "110310425": {
            "id": "110310425",
            "speakerId": 2029,
            "speakerName": "慧心",
            "text": "不过前辈…即便如此，他也还是可以矢口否认做过这笔生意呀？",
            "nextDialogs": [
              "110310426"
            ]
          },
          "110310426": {
            "id": "110310426",
            "speakerId": 1015,
            "speakerName": "甘雨",
            "text": "嗯，可即便他销毁了所有证据，我相信货源「范木堂」那里还是会留下些什么的…",
            "nextDialogs": [
              "110310427"
            ]
          },
          "110310427": {
            "id": "110310427",
            "speakerId": 2013,
            "speakerName": "博来",
            "text": "对！「范木堂」的路老爷子可不会听东升的安排，路爷那里准还留有收据。",
            "nextDialogs": [
              "110310428"
            ]
          },
          "110310428": {
            "id": "110310428",
            "speakerId": 1015,
            "speakerName": "甘雨",
            "text": "希望如此吧，那我们去一趟「范木堂」好了，应该在轻策庄附近。",
            "nextDialogs": [
              "110310429"
            ]
          },
          "110310429": {
            "id": "110310429",
            "speakerId": 1015,
            "speakerName": "甘雨",
            "text": "谢谢你的揭发行为，博来先生。",
            "nextDialogs": [
              "110310430"
            ]
          },
          "110310430": {
            "id": "110310430",
            "speakerId": 2013,
            "speakerName": "博来",
            "text": "欸，举手之劳，请各位找到证据以后从严处理他，就是对我最好的感谢。",
            "nextDialogs": [
              "110310431"
            ]
          },
          "110310431": {
            "id": "110310431",
            "speakerId": 2029,
            "speakerName": "慧心",
            "text": "要去轻策庄的话，我恐怕…",
            "nextDialogs": [
              "110310432"
            ]
          },
          "110310432": {
            "id": "110310432",
            "speakerId": 1015,
            "speakerName": "甘雨",
            "text": "没关系，慧心这边还有工作，不方便离开璃月港吧？这一趟我们去就好。",
            "nextDialogs": [
              "110310433"
            ]
          },
          "110310433": {
            "id": "110310433",
            "speakerId": 2029,
            "speakerName": "慧心",
            "text": "嗯，前辈真是善解人意…虽然很不好意思，但还是不得不麻烦几位了。"
          }
        }
      }
    },
    {
      "subId": "1103107",
      "subQuestName": "前往「范木堂」，与路爷对话",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "110310501"
        ],
        "dialogs": {
          "110310501": {
            "id": "110310501",
            "speakerId": 2310,
            "speakerName": "路爷",
            "text": "欢迎欢迎，几位来找我这老木匠是有何意？",
            "nextDialogs": [
              "110310502"
            ]
          },
          "110310502": {
            "id": "110310502",
            "speakerId": 2310,
            "speakerName": "路爷",
            "text": "是要来拜师的话，我倒是很欣慰，可一下子收不了这么多，不如先当我的养子…",
            "nextDialogs": [
              "110310503"
            ]
          },
          "110310503": {
            "id": "110310503",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "轻策庄都是些可怜又孤单的老头子呢。",
            "nextDialogs": [
              "110310504"
            ]
          },
          "110310504": {
            "id": "110310504",
            "speakerId": 2310,
            "speakerName": "路爷",
            "text": "…飞着的那个，我可都听见了！",
            "nextDialogs": [
              "110310505"
            ]
          },
          "110310505": {
            "id": "110310505",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "唔哇，对不起！",
            "nextDialogs": [
              "110310506"
            ]
          },
          "110310506": {
            "id": "110310506",
            "speakerId": 1015,
            "speakerName": "甘雨",
            "text": "路爷，我们此行是来找您问些事，顺带来探望您。",
            "nextDialogs": [
              "110310507"
            ]
          },
          "110310507": {
            "id": "110310507",
            "speakerId": 2310,
            "speakerName": "路爷",
            "text": "哟，我其实知道，你是从月海亭过来的人吧？",
            "nextDialogs": [
              "110310508"
            ]
          },
          "110310508": {
            "id": "110310508",
            "speakerId": 2310,
            "speakerName": "路爷",
            "text": "「七星」哪里会顾着我这个老头子，罢了，意思我懂，你说有什么要问的吧。",
            "nextDialogs": [
              "110310509"
            ]
          },
          "110310509": {
            "id": "110310509",
            "speakerId": 1015,
            "speakerName": "甘雨",
            "text": "呵呵，路爷真是直爽。情况是这样，我们在寻找「荣发商铺」的东升漏税的证据…",
            "nextDialogs": [
              "110310510"
            ]
          },
          "110310510": {
            "id": "110310510",
            "speakerId": 1015,
            "speakerName": "甘雨",
            "text": "请问年初时候东升来您这里订购的家具，是否还有收据或者记录呢？",
            "nextDialogs": [
              "110310511"
            ]
          },
          "110310511": {
            "id": "110310511",
            "speakerId": 2310,
            "speakerName": "路爷",
            "text": "你说「荣发商铺」那单生意啊，呵呵，那可是单大买卖，我怎么会不记得。",
            "nextDialogs": [
              "110310512"
            ]
          },
          "110310512": {
            "id": "110310512",
            "speakerId": 1015,
            "speakerName": "甘雨",
            "text": "果然，博来先生说的确实没错。",
            "nextDialogs": [
              "110310513"
            ]
          },
          "110310513": {
            "id": "110310513",
            "speakerId": 1015,
            "speakerName": "甘雨",
            "text": "那…可否借来收据一用，不然我们无法与东升对证。",
            "nextDialogs": [
              "110310514"
            ]
          },
          "110310514": {
            "id": "110310514",
            "speakerId": 2310,
            "speakerName": "路爷",
            "text": "可以，当然可以。",
            "nextDialogs": [
              "110310515"
            ]
          },
          "110310515": {
            "id": "110310515",
            "speakerId": 2310,
            "speakerName": "路爷",
            "text": "只是现在…恐怕有心无力啊。",
            "nextDialogs": [
              "110310516"
            ]
          },
          "110310516": {
            "id": "110310516",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "欸，这话怎么说？",
            "nextDialogs": [
              "110310517"
            ]
          },
          "110310517": {
            "id": "110310517",
            "speakerId": 2310,
            "speakerName": "路爷",
            "text": "这边「范木堂」里，我只用来做木匠活和摆放成品。",
            "nextDialogs": [
              "110310518"
            ]
          },
          "110310518": {
            "id": "110310518",
            "speakerId": 2310,
            "speakerName": "路爷",
            "text": "至于旧账单账本一类的东西，我都存放在西边的仓库里。",
            "nextDialogs": [
              "110310519"
            ]
          },
          "110310519": {
            "id": "110310519",
            "speakerId": 2310,
            "speakerName": "路爷",
            "text": "可是最近有些烦人的家伙，把我的仓库给霸占了，赶又赶不走…",
            "nextDialogs": [
              "110310520"
            ]
          },
          "110310520": {
            "id": "110310520",
            "speakerId": 2310,
            "speakerName": "路爷",
            "text": "既然你们也有所求，不如自己到仓库去把收据取来，也顺带给他们点教训。",
            "nextDialogs": [
              "110310521"
            ]
          },
          "110310521": {
            "id": "110310521",
            "speakerId": 1015,
            "speakerName": "甘雨",
            "text": "原来如此，情况我们了解了。",
            "nextDialogs": [
              "110310522"
            ]
          },
          "110310522": {
            "id": "110310522",
            "speakerId": 2310,
            "speakerName": "路爷",
            "text": "那你们自己解决好了，我就先回去忙活了。",
            "nextDialogs": [
              "110310523"
            ]
          },
          "110310523": {
            "id": "110310523",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "夺回仓库，找到收据…是武斗派出场的时候了！",
            "nextDialogs": [
              "110310524"
            ]
          },
          "110310524": {
            "id": "110310524",
            "speakerId": 1015,
            "speakerName": "甘雨",
            "text": "等一下，我好像看到…不怀好意的家伙了，就在那边。",
            "nextDialogs": [
              "110310525"
            ]
          },
          "110310525": {
            "id": "110310525",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "哦！看穿着…是愚人众！",
            "nextDialogs": [
              "110310528"
            ]
          },
          "110310528": {
            "id": "110310528",
            "speakerId": 1015,
            "speakerName": "甘雨",
            "text": "一定是在谋划什么对璃月港不利的事情…",
            "nextDialogs": [
              "110310529"
            ]
          },
          "110310529": {
            "id": "110310529",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "说不定占据了路爷仓库的坏蛋，就是他们！",
            "nextDialogs": [
              "110310530"
            ]
          },
          "110310530": {
            "id": "110310530",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "可是…真的不先观察一下吗？",
            "nextDialogs": [
              "110310531"
            ]
          },
          "110310531": {
            "id": "110310531",
            "speakerId": 1015,
            "speakerName": "甘雨",
            "text": "自上次魔神进攻港口的事件发生之后，愚人众的风评已在璃月降至低谷。",
            "nextDialogs": [
              "110310532"
            ]
          },
          "110310532": {
            "id": "110310532",
            "speakerId": 1015,
            "speakerName": "甘雨",
            "text": "在境内与愚人众发生些小冲突，是不会引发什么严肃的外交问题的，这点请放心。",
            "nextDialogs": [
              "110310533"
            ]
          },
          "110310533": {
            "id": "110310533",
            "speakerId": 1015,
            "speakerName": "甘雨",
            "text": "况且…我已经感受到了此人的恶意，这是…",
            "nextDialogs": [
              "110310534"
            ]
          },
          "110310534": {
            "id": "110310534",
            "speakerId": 1015,
            "speakerName": "甘雨",
            "text": "…作为「七星秘书」的直觉。",
            "nextDialogs": [
              "110310535"
            ]
          },
          "110310535": {
            "id": "110310535",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "既然如此，那还等什么？我们去揍他一顿吧！"
          }
        }
      }
    },
    {
      "subId": "1103112",
      "subQuestName": "（test）与路爷对话$HIDDEN",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [],
        "dialogs": {}
      }
    },
    {
      "subId": "1103108",
      "subQuestName": "击败可疑的愚人众手下",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "110310801"
        ],
        "dialogs": {
          "110310801": {
            "id": "110310801",
            "speakerId": 2029,
            "speakerName": "慧心",
            "text": "前辈，你们回来了。",
            "nextDialogs": [
              "110310802"
            ]
          },
          "110310802": {
            "id": "110310802",
            "speakerId": 2029,
            "speakerName": "慧心",
            "text": "真是麻烦你们为了我的事如此奔波…",
            "nextDialogs": [
              "110310803"
            ]
          },
          "110310803": {
            "id": "110310803",
            "speakerId": 1015,
            "speakerName": "甘雨",
            "text": "答应给后辈帮忙，我肯定会负责到底的，别这样说了。",
            "nextDialogs": [
              "110310804"
            ]
          },
          "110310804": {
            "id": "110310804",
            "speakerId": 1015,
            "speakerName": "甘雨",
            "text": "看，这是「荣发商铺」在「范木堂」订单的收据，我们拿回来了。",
            "nextDialogs": [
              "110310805"
            ]
          },
          "110310805": {
            "id": "110310805",
            "speakerId": 2029,
            "speakerName": "慧心",
            "text": "太感谢了！这下可就好办了。",
            "nextDialogs": [
              "110310806"
            ]
          },
          "110310806": {
            "id": "110310806",
            "speakerId": 1015,
            "speakerName": "甘雨",
            "text": "嗯，我们一起去找「荣发商铺」的老板…好好聊聊吧？"
          }
        }
      }
    },
    {
      "subId": "1103109",
      "subQuestName": "与可疑的愚人众手下对话",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "110310701"
        ],
        "dialogs": {
          "110310701": {
            "id": "110310701",
            "speakerId": 10324,
            "speakerName": "愚人众先遣队",
            "text": "咳咳…你们这些…家伙…",
            "nextDialogs": [
              "110310702"
            ]
          },
          "110310702": {
            "id": "110310702",
            "speakerId": 1015,
            "speakerName": "甘雨",
            "text": "苦头应该吃得差不多了，该好好交待你们的计划了吧？",
            "nextDialogs": [
              "110310703"
            ]
          },
          "110310703": {
            "id": "110310703",
            "speakerId": 10324,
            "speakerName": "愚人众先遣队",
            "text": "计划…什么计划？",
            "nextDialogs": [
              "110310704"
            ]
          },
          "110310704": {
            "id": "110310704",
            "speakerId": 1015,
            "speakerName": "甘雨",
            "text": "刚才只是教训，不是逼供，这一点请你注意。",
            "nextDialogs": [
              "110310705"
            ]
          },
          "110310705": {
            "id": "110310705",
            "speakerId": 1015,
            "speakerName": "甘雨",
            "text": "但是，如果你一直掩盖你们的预谋，对璃月不利…",
            "nextDialogs": [
              "110310706"
            ]
          },
          "110310706": {
            "id": "110310706",
            "speakerId": 1015,
            "speakerName": "甘雨",
            "text": "那么我将不惜采用一些不那么客气的办法…",
            "nextDialogs": [
              "110310709"
            ]
          },
          "110310709": {
            "id": "110310709",
            "speakerId": 10324,
            "speakerName": "愚人众先遣队",
            "text": "真的…没打算做什么…",
            "nextDialogs": [
              "110310710"
            ]
          },
          "110310710": {
            "id": "110310710",
            "speakerId": 1015,
            "speakerName": "甘雨",
            "text": "没打算做什么…那又为何，身为愚人众部下的你会突然出现在轻策庄的郊外？",
            "nextDialogs": [
              "110310711"
            ]
          },
          "110310711": {
            "id": "110310711",
            "speakerId": 10324,
            "speakerName": "愚人众先遣队",
            "text": "如果要这么问的话…确实，我是准备…",
            "nextDialogs": [
              "110310712"
            ]
          },
          "110310712": {
            "id": "110310712",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "准备…？",
            "nextDialogs": [
              "110310713"
            ]
          },
          "110310713": {
            "id": "110310713",
            "speakerId": 10324,
            "speakerName": "愚人众先遣队",
            "text": "…去采那边的树莓。",
            "nextDialogs": [
              "110310714"
            ]
          },
          "110310714": {
            "id": "110310714",
            "speakerId": 1015,
            "speakerName": "甘雨",
            "text": "唔…",
            "nextDialogs": [
              "110310715"
            ]
          },
          "110310715": {
            "id": "110310715",
            "speakerId": 1015,
            "speakerName": "甘雨",
            "text": "我有些出乎意料，你会找这样无聊的借口。",
            "nextDialogs": [
              "110310716"
            ]
          },
          "110310716": {
            "id": "110310716",
            "speakerId": 10324,
            "speakerName": "愚人众先遣队",
            "text": "是真的！我难得一大早出来散心，道听途说这边有新鲜的莓果…",
            "nextDialogs": [
              "110310717"
            ]
          },
          "110310717": {
            "id": "110310717",
            "speakerId": 10324,
            "speakerName": "愚人众先遣队",
            "text": "你再想想，我身边甚至一个同伴都没有，轻策庄也不过是个养老胜地而已，我能有什么预谋呢？",
            "nextDialogs": [
              "110310718"
            ]
          },
          "110310718": {
            "id": "110310718",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "看他的眼神，好像真的很委屈的样子。",
            "nextDialogs": [
              "110310719"
            ]
          },
          "110310719": {
            "id": "110310719",
            "speakerId": 1015,
            "speakerName": "甘雨",
            "text": "…那「范木堂」的仓库被占据的事，也和你没有关系？",
            "nextDialogs": [
              "110310720"
            ]
          },
          "110310720": {
            "id": "110310720",
            "speakerId": 10324,
            "speakerName": "愚人众先遣队",
            "text": "「范木堂」的仓库？在哪里？",
            "nextDialogs": [
              "110310721"
            ]
          },
          "110310721": {
            "id": "110310721",
            "speakerId": 10324,
            "speakerName": "愚人众先遣队",
            "text": "我真的，只是来采树莓的而已…",
            "nextDialogs": [
              "110310722"
            ]
          },
          "110310722": {
            "id": "110310722",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "难道说占据了路爷家仓库的家伙，并不是愚人众…"
          }
        }
      }
    },
    {
      "subId": "1103110",
      "subQuestName": "清理占据仓库的敌人",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "110311001"
        ],
        "dialogs": {
          "110311001": {
            "id": "110311001",
            "speakerId": 2003,
            "speakerName": "天叔",
            "text": "欸，不必多说。我女儿那边也确实需要甘雨帮忙，没有什么别的意思，呵呵…"
          }
        }
      }
    },
    {
      "subId": "1103111",
      "subQuestName": "寻找与「荣发商铺」交易的收据",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "110311101"
        ],
        "dialogs": {
          "110311101": {
            "id": "110311101",
            "speakerId": 2310,
            "speakerName": "路爷",
            "text": "记得把那些家伙赶走，正好省得我去找千岩军了…"
          }
        }
      }
    },
    {
      "subId": "1103113",
      "subQuestName": "回到月海亭，与慧心对话",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [],
        "dialogs": {}
      }
    },
    {
      "subId": "1103114",
      "subQuestName": "前往「荣发商铺」，与东升对话",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "110310901"
        ],
        "dialogs": {
          "110310901": {
            "id": "110310901",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "关于税单…",
            "nextDialogs": [
              "110310902"
            ]
          },
          "110310902": {
            "id": "110310902",
            "speakerId": 2454,
            "speakerName": "东升",
            "text": "这不是…月海亭的慧心吗，我记得你。",
            "nextDialogs": [
              "110310903"
            ]
          },
          "110310903": {
            "id": "110310903",
            "speakerId": 2454,
            "speakerName": "东升",
            "text": "我跟你说过了，所有交易都如实记录，税单填报也绝对没有问题。",
            "nextDialogs": [
              "110310904"
            ]
          },
          "110310904": {
            "id": "110310904",
            "speakerId": 2454,
            "speakerName": "东升",
            "text": "我还要做生意，希望你不要为了子虚乌有的事一直揪着不放了…",
            "nextDialogs": [
              "110310905"
            ]
          },
          "110310905": {
            "id": "110310905",
            "speakerId": 1015,
            "speakerName": "甘雨",
            "text": "子虚乌有？东升先生的话里，还真是透着几分自信。",
            "nextDialogs": [
              "110310906"
            ]
          },
          "110310906": {
            "id": "110310906",
            "speakerId": 1015,
            "speakerName": "甘雨",
            "text": "但我衷心地建议您，趁早放弃诡辩。因为这很可能影响到最终处理时，您需要缴纳的罚金。",
            "nextDialogs": [
              "110310907"
            ]
          },
          "110310907": {
            "id": "110310907",
            "speakerId": 2454,
            "speakerName": "东升",
            "text": "啊…没、没有，不会的，我光明正大地做生意，从来不贪图什么乱七八糟的蝇头小利。",
            "nextDialogs": [
              "110310910"
            ]
          },
          "110310910": {
            "id": "110310910",
            "speakerId": 1015,
            "speakerName": "甘雨",
            "text": "难道是我解释得不够清楚？东升先生，您漏税的事实已经确凿，我们只是来看看您的态度而已。",
            "nextDialogs": [
              "110310911"
            ]
          },
          "110310911": {
            "id": "110310911",
            "speakerId": 2454,
            "speakerName": "东升",
            "text": "…事、事实确凿？不可能，不可能的，我怎么可能？不可能的呀。",
            "nextDialogs": [
              "110310912"
            ]
          },
          "110310912": {
            "id": "110310912",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "已经语无伦次了，甘雨小姐给的压力实在太大啦…",
            "nextDialogs": [
              "110310913"
            ]
          },
          "110310913": {
            "id": "110310913",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "还是给他个痛快吧！",
            "nextDialogs": [
              "110310914"
            ]
          },
          "110310914": {
            "id": "110310914",
            "speakerId": 2029,
            "speakerName": "慧心",
            "text": "东升先生，请您看看这是什么。",
            "nextDialogs": [
              "110310915"
            ]
          },
          "110310915": {
            "id": "110310915",
            "speakerId": 2454,
            "speakerName": "东升",
            "text": "这…这、这是！「范木堂」那边的收据！",
            "nextDialogs": [
              "110310916"
            ]
          },
          "110310916": {
            "id": "110310916",
            "speakerId": 2454,
            "speakerName": "东升",
            "text": "我、我这、路爷他…我不是…",
            "nextDialogs": [
              "110310917"
            ]
          },
          "110310917": {
            "id": "110310917",
            "speakerId": 2029,
            "speakerName": "慧心",
            "text": "承认漏税的事实了吗？这笔交易，根本没在之前的税单里。",
            "nextDialogs": [
              "110310918"
            ]
          },
          "110310918": {
            "id": "110310918",
            "speakerId": 2454,
            "speakerName": "东升",
            "text": "唉…真没想到，你们连这都能找得出来，我还以为我做得天衣无缝呢…",
            "nextDialogs": [
              "110310919"
            ]
          },
          "110310919": {
            "id": "110310919",
            "speakerId": 1015,
            "speakerName": "甘雨",
            "text": "确实，如果没有博来先生帮忙的话，我们怎么也查不到会有这样一笔账。",
            "nextDialogs": [
              "110310920"
            ]
          },
          "110310920": {
            "id": "110310920",
            "speakerId": 2454,
            "speakerName": "东升",
            "text": "博来？「万有铺子」的那个家伙…居然背地里告发我！",
            "nextDialogs": [
              "110310921"
            ]
          },
          "110310921": {
            "id": "110310921",
            "speakerId": 2454,
            "speakerName": "东升",
            "text": "哼，明明他自己也一直不干不净的…",
            "nextDialogs": [
              "110310922"
            ]
          },
          "110310922": {
            "id": "110310922",
            "speakerId": 1015,
            "speakerName": "甘雨",
            "text": "哦？东升先生，您刚才的发言我非常感兴趣…不知能否详谈一下呢？",
            "nextDialogs": [
              "110310923"
            ]
          },
          "110310923": {
            "id": "110310923",
            "speakerId": 1015,
            "speakerName": "甘雨",
            "text": "接下来的事，就不用我继续指导了吧？",
            "nextDialogs": [
              "110310924"
            ]
          },
          "110310924": {
            "id": "110310924",
            "speakerId": 2029,
            "speakerName": "慧心",
            "text": "嗯，谢谢甘雨前辈！我会自己处理好的。",
            "nextDialogs": [
              "110310925"
            ]
          },
          "110310925": {
            "id": "110310925",
            "speakerId": 1015,
            "speakerName": "甘雨",
            "text": "呵呵，那就好。",
            "nextDialogs": [
              "110310926"
            ]
          },
          "110310926": {
            "id": "110310926",
            "speakerId": 2029,
            "speakerName": "慧心",
            "text": "说起来，甘雨前辈可真是厉害…",
            "nextDialogs": [
              "110310927"
            ]
          },
          "110310927": {
            "id": "110310927",
            "speakerId": 2029,
            "speakerName": "慧心",
            "text": "「最了解一个人的，往往是他的敌人。」",
            "nextDialogs": [
              "110310928"
            ]
          },
          "110310928": {
            "id": "110310928",
            "speakerId": 2029,
            "speakerName": "慧心",
            "text": "这样的道理究竟是怎么想出来的，而且还那样顺利地付诸实践。",
            "nextDialogs": [
              "110310929"
            ]
          },
          "110310929": {
            "id": "110310929",
            "speakerId": 1015,
            "speakerName": "甘雨",
            "text": "呵呵，其实这是你父亲「天枢」大人常用的办事做派，我只是从中悟得了这些道理而已。",
            "nextDialogs": [
              "110310930"
            ]
          },
          "110310930": {
            "id": "110310930",
            "speakerId": 2029,
            "speakerName": "慧心",
            "text": "我、我父亲！",
            "nextDialogs": [
              "110310931"
            ]
          },
          "110310931": {
            "id": "110310931",
            "speakerId": 1015,
            "speakerName": "甘雨",
            "text": "让对手与他自己的敌人之间相互牵制，从而作壁上观立于不败之地。",
            "nextDialogs": [
              "110310932"
            ]
          },
          "110310932": {
            "id": "110310932",
            "speakerId": 1015,
            "speakerName": "甘雨",
            "text": "也正因如此，天叔他才能稳坐「七星」之位这么多年。",
            "nextDialogs": [
              "110310933"
            ]
          },
          "110310933": {
            "id": "110310933",
            "speakerId": 1015,
            "speakerName": "甘雨",
            "text": "我思来想去，觉得你作为天叔的女儿，一定天生就更容易接受父亲做事的方法吧？",
            "nextDialogs": [
              "110310934"
            ]
          },
          "110310934": {
            "id": "110310934",
            "speakerId": 1015,
            "speakerName": "甘雨",
            "text": "所以我才用了和你父亲一样的手段，并把它演示给你。",
            "nextDialogs": [
              "110310935"
            ]
          },
          "110310935": {
            "id": "110310935",
            "speakerId": 2029,
            "speakerName": "慧心",
            "text": "原来是这样啊…或许，我还真的不是那么了解我自己的父亲…",
            "nextDialogs": [
              "110310936"
            ]
          },
          "110310936": {
            "id": "110310936",
            "speakerId": 2029,
            "speakerName": "慧心",
            "text": "甘雨前辈，真的很谢谢你！呵呵，这是我所受到过的最亲切的指导了！谢谢！",
            "nextDialogs": [
              "110310937"
            ]
          },
          "110310937": {
            "id": "110310937",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "甘雨不仅解决了公事上的问题，好像连家庭上的问题也一并解决了呢。",
            "nextDialogs": [
              "110310938"
            ]
          },
          "110310938": {
            "id": "110310938",
            "speakerId": 2029,
            "speakerName": "慧心",
            "text": "前辈，您帮了我这么大忙，请务必、务必让我报答您…",
            "nextDialogs": [
              "110310939"
            ]
          },
          "110310939": {
            "id": "110310939",
            "speakerId": 1015,
            "speakerName": "甘雨",
            "text": "啊，报答什么的，有些太过言重了…真的只是件小事而已。",
            "nextDialogs": [
              "110310940"
            ]
          },
          "110310940": {
            "id": "110310940",
            "speakerId": 2029,
            "speakerName": "慧心",
            "text": "那、那至少让我请您吃顿饭！还有旅行者和派蒙也一起来吧，这段时间也麻烦二位了！",
            "nextDialogs": [
              "110310941"
            ]
          },
          "110310941": {
            "id": "110310941",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "好欸！快答应吧，甘雨小姐！吃饭吃饭！"
          }
        }
      }
    },

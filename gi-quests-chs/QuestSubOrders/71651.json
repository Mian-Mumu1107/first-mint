        "dialogs": {
          "716510101": {
            "id": "716510101",
            "speakerId": 1000,
            "speakerName": "凯瑟琳",
            "text": "冒险家，感谢你这些日子的努力，委托你「岩龙蜥」的调查的事，终于可以告一段落了。",
            "nextDialogs": [
              "716510103",
              "716510105"
            ]
          },
          "716510103": {
            "id": "716510103",
            "speakerId": 1000,
            "speakerName": "凯瑟琳",
            "text": "辛苦你了，解了协会的燃眉之急。",
            "nextDialogs": [
              "716510106"
            ]
          },
          "716510106": {
            "id": "716510106",
            "speakerId": 1000,
            "speakerName": "凯瑟琳",
            "text": "去探亲的冒险家们已经陆续回协会报到了，你已经做了很多贡献，收尾的工作就交给我们吧。",
            "nextDialogs": [
              "716510107"
            ]
          },
          "716510107": {
            "id": "716510107",
            "speakerId": 1000,
            "speakerName": "凯瑟琳",
            "text": "至于为什么「岩龙蜥」这种古老生物会突然出现，我们也会继续调查的。",
            "nextDialogs": [
              "716510108"
            ]
          },
          "716510108": {
            "id": "716510108",
            "speakerId": 1000,
            "speakerName": "凯瑟琳",
            "text": "对了，不要忘记领取这次调查的报酬哦。",
            "nextDialogs": [
              "716510109"
            ]
          },
          "716510109": {
            "id": "716510109",
            "speakerId": 1000,
            "speakerName": "凯瑟琳",
            "text": "冒险家协会期待你今后的活跃表现！向着星辰与深渊！"
          },
          "716510105": {
            "id": "716510105",
            "speakerId": 1000,
            "speakerName": "凯瑟琳",
            "text": "哈哈，看来你乐在其中的样子，这再好不过了。"
          }
        }
      }
    }

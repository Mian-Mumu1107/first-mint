{
  "lineCounts": {
    "Player": 14,
    "提米": 15,
    "葛瑞丝": 29
  },
  "subQuests": [
    {
      "subId": "2006801",
      "subQuestName": "与葛瑞丝对话",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "200680101"
        ],
        "dialogs": {
          "200680101": {
            "id": "200680101",
            "speakerId": 1429,
            "speakerName": "葛瑞丝",
            "text": "唉，这可怎么办才好…",
            "nextDialogs": [
              "200680102"
            ]
          },
          "200680102": {
            "id": "200680102",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "呃，发生什么了？",
            "nextDialogs": [
              "200680103"
            ]
          },
          "200680103": {
            "id": "200680103",
            "speakerId": 1429,
            "speakerName": "葛瑞丝",
            "text": "是您啊，您来得正好。提米已经把您对鸭子做的事告诉我了。",
            "nextDialogs": [
              "200680104"
            ]
          },
          "200680104": {
            "id": "200680104",
            "speakerId": 1429,
            "speakerName": "葛瑞丝",
            "text": "您…您…唉，我该怎么说您好呢，您的事迹我也不是没听说过…",
            "nextDialogs": [
              "200680105"
            ]
          },
          "200680105": {
            "id": "200680105",
            "speakerId": 1429,
            "speakerName": "葛瑞丝",
            "text": "您的那些勇气和力量…怎么能用在这种地方…",
            "nextDialogs": [
              "200680109",
              "200680111",
              "200680112"
            ]
          },
          "200680109": {
            "id": "200680109",
            "speakerId": 1429,
            "speakerName": "葛瑞丝",
            "text": "您…如果实在肚子饿的话，可以去正经工作赚钱啊。",
            "nextDialogs": [
              "200680110"
            ]
          },
          "200680110": {
            "id": "200680110",
            "speakerId": 1429,
            "speakerName": "葛瑞丝",
            "text": "以您的实力，在冒险家协会绝对能占得一席之地…",
            "nextDialogs": [
              "200680113"
            ]
          },
          "200680113": {
            "id": "200680113",
            "speakerId": 1429,
            "speakerName": "葛瑞丝",
            "text": "唉，事情已经发生了，多说无益，提米因为这件事已经闷闷不乐很久了。",
            "nextDialogs": [
              "200680114"
            ]
          },
          "200680114": {
            "id": "200680114",
            "speakerId": 1429,
            "speakerName": "葛瑞丝",
            "text": "我曾经从提米的…父亲那里，学过一道菜谱。加入了「慕风蘑菇」的「蒙德土豆饼」，是提米最喜欢吃的东西。",
            "nextDialogs": [
              "200680115"
            ]
          },
          "200680115": {
            "id": "200680115",
            "speakerId": 1429,
            "speakerName": "葛瑞丝",
            "text": "您帮我找三个「慕风蘑菇」来吧，提米能吃到这个，心情应该会好些…您也能向他道歉了。"
          },
          "200680111": {
            "id": "200680111",
            "speakerId": 1429,
            "speakerName": "葛瑞丝",
            "text": "失手打到鸽子和鸭子？那么您遇见的那些强敌，一定也是您「失手」击败的吧。"
          },
          "200680112": {
            "id": "200680112",
            "speakerId": 1429,
            "speakerName": "葛瑞丝",
            "text": "您…您，我…算了，看来您的实力，确实是很全面…"
          }
        }
      }
    },
    {
      "subId": "2006802",
      "subQuestName": "将3个慕风蘑菇带给葛瑞丝",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "200680201"
        ],
        "dialogs": {
          "200680201": {
            "id": "200680201",
            "speakerId": 1429,
            "speakerName": "葛瑞丝",
            "text": "您找到「慕风蘑菇」了吗？在城里的房檐下，应该能找到很多…"
          }
        }
      }
    },
    {
      "subId": "2006804",
      "subQuestName": "等待葛瑞丝制作蒙德土豆饼",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "200680401"
        ],
        "dialogs": {
          "200680401": {
            "id": "200680401",
            "speakerId": 1429,
            "speakerName": "葛瑞丝",
            "text": "这些就足够了，谢谢您，请您稍等一下…",
            "nextDialogs": [
              "200680402"
            ]
          },
          "200680402": {
            "id": "200680402",
            "speakerId": 1429,
            "speakerName": "葛瑞丝",
            "text": "这样就可以了，请您把这份「蒙德土豆饼」送给提米吧。",
            "nextDialogs": [
              "200680403"
            ]
          },
          "200680403": {
            "id": "200680403",
            "speakerId": 1429,
            "speakerName": "葛瑞丝",
            "text": "请您以后别做这种…不好的事了，实在是得不偿失…",
            "nextDialogs": [
              "200680404"
            ]
          },
          "200680404": {
            "id": "200680404",
            "speakerId": 1429,
            "speakerName": "葛瑞丝",
            "text": "希望您能记住我的告诫，别让我和提米太失望。",
            "nextDialogs": [
              "200680405"
            ]
          },
          "200680405": {
            "id": "200680405",
            "speakerId": 1429,
            "speakerName": "葛瑞丝",
            "text": "不过…唉，要是人人都能记住告诫，那维多利亚修女就不会那么忙了…"
          }
        }
      }
    },
    {
      "subId": "2006803",
      "subQuestName": "与提米对话",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "200680301"
        ],
        "dialogs": {
          "200680301": {
            "id": "200680301",
            "speakerId": 1567,
            "speakerName": "提米",
            "text": "…吃吧，吃吧，吃好了就快点走…",
            "nextDialogs": [
              "200680305",
              "200680306",
              "200680307"
            ]
          },
          "200680305": {
            "id": "200680305",
            "speakerId": 1567,
            "speakerName": "提米",
            "text": "怎么又是你！",
            "nextDialogs": [
              "200680308"
            ]
          },
          "200680308": {
            "id": "200680308",
            "speakerId": 1567,
            "speakerName": "提米",
            "text": "你到底想做什么啊，难道还想对鸭子和鸽子下手吗？"
          },
          "200680306": {
            "id": "200680306",
            "speakerId": 1567,
            "speakerName": "提米",
            "text": "怎么又是你？你到底有完没完！"
          },
          "200680307": {
            "id": "200680307",
            "speakerId": 1567,
            "speakerName": "提米",
            "text": "你还好意思问我！？"
          }
        }
      }
    },
    {
      "subId": "2006805",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "200680501"
        ],
        "dialogs": {
          "200680501": {
            "id": "200680501",
            "speakerId": 1429,
            "speakerName": "葛瑞丝",
            "text": "请您快把土豆饼送去给提米吧。",
            "nextDialogs": [
              "200680503",
              "200680507"
            ]
          },
          "200680503": {
            "id": "200680503",
            "speakerId": 1429,
            "speakerName": "葛瑞丝",
            "text": "是我。我一直在照顾着一些需要照顾的孩子。",
            "nextDialogs": [
              "200680504"
            ]
          },
          "200680504": {
            "id": "200680504",
            "speakerId": 1429,
            "speakerName": "葛瑞丝",
            "text": "提米是我照顾时间最长的，逐渐就叫我「葛瑞丝妈妈」了。",
            "nextDialogs": [
              "200680505"
            ]
          },
          "200680505": {
            "id": "200680505",
            "speakerId": 1429,
            "speakerName": "葛瑞丝",
            "text": "但是，我终归不是他真正的家人…"
          },
          "200680507": {
            "id": "200680507",
            "speakerId": 1429,
            "speakerName": "葛瑞丝",
            "text": "您…您怎么会问出这种问题来？",
            "nextDialogs": [
              "200680508"
            ]
          },
          "200680508": {
            "id": "200680508",
            "speakerId": 1429,
            "speakerName": "葛瑞丝",
            "text": "那孩子在城里也没多少朋友和亲近的人，除了诺拉和葛罗丽之外，就只有小动物们愿意一直陪他玩了。",
            "nextDialogs": [
              "200680509"
            ]
          },
          "200680509": {
            "id": "200680509",
            "speakerId": 1429,
            "speakerName": "葛瑞丝",
            "text": "而且，那群鸽子还…",
            "nextDialogs": [
              "200680510"
            ]
          },
          "200680510": {
            "id": "200680510",
            "speakerId": 1429,
            "speakerName": "葛瑞丝",
            "text": "…不，没事，请您快点把土豆饼送给提米吧。"
          }
        }
      }
    },
    {
      "subId": "2006806",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "200680601"
        ],
        "dialogs": {
          "200680601": {
            "id": "200680601",
            "speakerId": 1567,
            "speakerName": "提米",
            "text": "…怎么还没回来…",
            "nextDialogs": [
              "200680602"
            ]
          },
          "200680602": {
            "id": "200680602",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "那个，提米…",
            "nextDialogs": [
              "200680603"
            ]
          },
          "200680603": {
            "id": "200680603",
            "speakerId": 1567,
            "speakerName": "提米",
            "text": "你怎么又来了！？走开啦！鸽子们…还有小鸭子！都快跑啊！"
          }
        }
      }
    }
  ]
}
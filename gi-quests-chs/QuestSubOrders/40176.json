        "dialogs": {
          "401730501": {
            "id": "401730501",
            "speakerId": 1000,
            "speakerName": "茜特菈莉",
            "text": "#{NICKNAME}，有事吗？",
            "nextDialogs": [
              "401730502"
            ]
          },
          "401730502": {
            "id": "401730502",
            "speakerId": 1000,
            "speakerName": "茜特菈莉",
            "text": "我稍后要去首领那里还仪式剑，营地的其他东西就暂时留在这里。你有兴趣的话可以随便使用。",
            "nextDialogs": [
              "401730503"
            ]
          },
          "401730503": {
            "id": "401730503",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "我有一本《蜃楼战记》最新卷…",
            "nextDialogs": [
              "401730504"
            ]
          },
          "401730504": {
            "id": "401730504",
            "speakerId": 1000,
            "speakerName": "茜特菈莉",
            "text": "欸？",
            "nextDialogs": [
              "401730505"
            ]
          },
          "401730505": {
            "id": "401730505",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "还有《奥西兹小姐事件簿》番外…",
            "nextDialogs": [
              "401730506"
            ]
          },
          "401730506": {
            "id": "401730506",
            "speakerId": 1000,
            "speakerName": "茜特菈莉",
            "text": "欸欸欸？！",
            "nextDialogs": [
              "401730507"
            ]
          },
          "401730507": {
            "id": "401730507",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "要来一起看看吗？",
            "nextDialogs": [
              "401730508"
            ]
          },
          "401730508": {
            "id": "401730508",
            "speakerId": 1000,
            "speakerName": "茜特菈莉",
            "text": "唔…",
            "nextDialogs": [
              "401730509"
            ]
          },
          "401730509": {
            "id": "401730509",
            "speakerId": 1000,
            "speakerName": "茜特菈莉",
            "text": "#（怎么回事？怎么回事？{M#他}{F#她}怎么知道我喜欢那些？难道，{M#他}{F#她}在关注我？！）",
            "nextDialogs": [
              "401730510"
            ]
          },
          "401730510": {
            "id": "401730510",
            "speakerId": 1000,
            "speakerName": "茜特菈莉",
            "text": "（不，我怎么会有这种不切实际的想法…肯定是欧洛伦暴露了我，可恶…）",
            "nextDialogs": [
              "401730511"
            ]
          },
          "401730511": {
            "id": "401730511",
            "speakerId": 1000,
            "speakerName": "茜特菈莉",
            "text": "#（可…{M#他}{F#她}记住我的喜好了吗？欸？其实不记住也没关系，又不是什么重要的事…）",
            "nextDialogs": [
              "401730512"
            ]
          },
          "401730512": {
            "id": "401730512",
            "speakerId": 1000,
            "speakerName": "茜特菈莉",
            "text": "#（但…{M#他}{F#她}正在邀请我欸！怎么办怎么办，要怎么回应？）",
            "nextDialogs": [
              "401730513"
            ]
          },
          "401730513": {
            "id": "401730513",
            "speakerId": 1000,
            "speakerName": "茜特菈莉",
            "text": "咳咳…",
            "nextDialogs": [
              "401730514"
            ]
          },
          "401730514": {
            "id": "401730514",
            "speakerId": 1000,
            "speakerName": "茜特菈莉",
            "text": "好啊，有空吧，等我忙完。"
          }
        }
      }
    }
  ]
}
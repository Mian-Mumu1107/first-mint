        ],
        "dialogs": {
          "752520601": {
            "id": "752520601",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "你是那个酒吧迎宾，我们见过。",
            "nextDialogs": [
              "752520602"
            ]
          },
          "752520602": {
            "id": "752520602",
            "speakerId": 6512,
            "speakerName": "泰克胡",
            "text": "是吗？难怪觉得你有点眼熟，不过我一天见过很多人，所以记不太清了…不过，这不重要。"
          }
        }
      }
    },
    {
      "subId": "7525205",
      "subQuestName": "回去找伊凯卡",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "752520701"
        ],
        "dialogs": {
          "752520701": {
            "id": "752520701",
            "speakerId": 6512,
            "speakerName": "泰克胡",
            "text": "重要的是，你在这附近见过一个光头吗？我找他有事。",
            "nextDialogs": [
              "752520704",
              "752520705"
            ]
          },
          "752520704": {
            "id": "752520704",
            "speakerId": 6512,
            "speakerName": "泰克胡",
            "text": "哦？他刚才在这里是吗？看来已经跑了，是知道我正在追他了吧…",
            "nextDialogs": [
              "752520709"
            ]
          },
          "752520709": {
            "id": "752520709",
            "speakerId": 6512,
            "speakerName": "泰克胡",
            "text": "哼，伊凯卡…你跑不了的。",
            "nextDialogs": [
              "752520706"
            ]
          },
          "752520706": {
            "id": "752520706",
            "speakerId": 6512,
            "speakerName": "泰克胡",
            "text": "看在我们还算有缘的份上，劝你离那家伙和我都远一点，免得你这张漂亮脸蛋溅到白白红红的脏颜料。",
            "nextDialogs": [
              "752520707"
            ]
          },
          "752520707": {
            "id": "752520707",
            "speakerId": 6512,
            "speakerName": "泰克胡",
            "text": "这些是我在营地里搜出来的东西，我猜是他来不及带走的。",
            "nextDialogs": [
              "752520708"
            ]
          },
          "752520708": {
            "id": "752520708",
            "speakerId": 6512,
            "speakerName": "泰克胡",
            "text": "送给你了，别有什么顾虑，这些东西现在是我说了算。",
            "nextDialogs": [
              "752520710"
            ]
          },
          "752520710": {
            "id": "752520710",
            "speakerId": 6512,
            "speakerName": "泰克胡",
            "text": "那家伙的命迟早也都是我的。"
          },
          "752520705": {
            "id": "752520705",
            "speakerId": 6512,
            "speakerName": "泰克胡",
            "text": "你没骗我吧？我暂且信了你这张诚恳的小脸。"
          }
        }
      }
    },

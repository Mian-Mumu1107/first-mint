    {
      "subId": "7507303",
      "subQuestName": "(test)靠近钥匙$HIDDEN",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "750730301"
        ],
        "dialogs": {
          "750730301": {
            "id": "750730301",
            "speakerId": 1000,
            "speakerName": "？？？",
            "text": "呜呜，终于能从这个笼子里出来了。",
            "nextDialogs": [
              "750730302"
            ]
          },
          "750730302": {
            "id": "750730302",
            "speakerId": 1000,
            "speakerName": "？？？",
            "text": "这个热气球晃晃荡荡的，嘿，说不定来上一阵风，整个笼子都得被掀下去…",
            "nextDialogs": [
              "750730303"
            ]
          },
          "750730303": {
            "id": "750730303",
            "speakerId": 1000,
            "speakerName": "？？？",
            "text": "那时候估计就连黑曜石奶奶都没办法救我啦。",
            "nextDialogs": [
              "750730304"
            ]
          },
          "750730304": {
            "id": "750730304",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "你是谁，为什么在这？",
            "nextDialogs": [
              "750730305"
            ]
          },
          "750730305": {
            "id": "750730305",
            "speakerId": 1001,
            "speakerName": "科奴拉芙",
            "text": "啊，我还没做自我介绍，我啊，我的名字叫科奴拉芙，是「烟谜主」的实习祭司…",
            "nextDialogs": [
              "750730306"
            ]
          },
          "750730306": {
            "id": "750730306",
            "speakerId": 1001,
            "speakerName": "科奴拉芙",
            "text": "现在正在祭司的修行途中，嗯…之前一直待在部族里，所以部族里的长辈跟我说，「你总得出去见见世面吧！」",
            "nextDialogs": [
              "750730307"
            ]
          },
          "750730307": {
            "id": "750730307",
            "speakerId": 1001,
            "speakerName": "科奴拉芙",
            "text": "于是就以进行修行为名把我一脚踢出了部族的大门——",
            "nextDialogs": [
              "750730308"
            ]
          },
          "750730308": {
            "id": "750730308",
            "speakerId": 1001,
            "speakerName": "科奴拉芙",
            "text": "不过，被丘丘人抓起来，这种「世面」还是不见为妙啊，你说对不对啊，恩人。",
            "nextDialogs": [
              "750730310",
              "750730312"
            ]
          },
          "750730310": {
            "id": "750730310",
            "speakerId": 1001,
            "speakerName": "科奴拉芙",
            "text": "就是就是，要不是遇到恩人，我还不知道要在这里被困到什么时候呢…",
            "nextDialogs": [
              "750730313"
            ]
          },
          "750730313": {
            "id": "750730313",
            "speakerId": 1001,
            "speakerName": "科奴拉芙",
            "text": "唔，总之，多谢恩人救了小女子…在这上面吹了这么多风，还是先下去，想想继续修行的事…",
            "nextDialogs": [
              "750730314"
            ]
          },
          "750730314": {
            "id": "750730314",
            "speakerId": 1001,
            "speakerName": "科奴拉芙",
            "text": "小女子身上的盘缠不多，不过家里人说，受人恩惠总要回报，这些就给恩人吧！"
          },
          "750730312": {
            "id": "750730312",
            "speakerId": 1001,
            "speakerName": "科奴拉芙",
            "text": "嘿…这你就骗不着小女子我啦，像恩人这么强的冒险者，这个世上也是少数吧…"
          }
        }
      }
    },

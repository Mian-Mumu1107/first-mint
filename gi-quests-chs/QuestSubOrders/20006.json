    {
      "subId": "2000601",
      "subQuestName": "前往猎鹿人餐馆询问莎拉",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "200060101"
        ],
        "dialogs": {
          "200060101": {
            "id": "200060101",
            "speakerId": 10002,
            "speakerName": "莎拉",
            "text": "餐品外送订单",
            "nextDialogs": [
              "200060102"
            ]
          },
          "200060102": {
            "id": "200060102",
            "speakerId": 10002,
            "speakerName": "莎拉",
            "text": "欢迎光临猎鹿人…旅行者？你来得正好。",
            "nextDialogs": [
              "200060103"
            ]
          },
          "200060103": {
            "id": "200060103",
            "speakerId": 10002,
            "speakerName": "莎拉",
            "text": "抱歉啦，我知道你饿着肚子，但是能请你帮我个忙吗？",
            "nextDialogs": [
              "200060104"
            ]
          },
          "200060104": {
            "id": "200060104",
            "speakerId": 10002,
            "speakerName": "莎拉",
            "text": "清泉镇里的欧琳小姐订了一份<color=#00E1FFFF>蜜酱胡萝卜煎肉</color>，但是我听说，清泉镇最近总是有史莱姆出来捣乱…",
            "nextDialogs": [
              "200060105"
            ]
          },
          "200060105": {
            "id": "200060105",
            "speakerId": 10002,
            "speakerName": "莎拉",
            "text": "我自己不敢过去…能请你帮我把餐品送给<color=#00E1FFFF>清泉镇的欧琳</color>吗？",
            "nextDialogs": [
              "200060108",
              "200060110"
            ]
          },
          "200060108": {
            "id": "200060108",
            "speakerId": 10002,
            "speakerName": "莎拉",
            "text": "等你回来的时候，会有一顿大餐做回报的！",
            "nextDialogs": [
              "200060109"
            ]
          },
          "200060109": {
            "id": "200060109",
            "speakerId": 10002,
            "speakerName": "莎拉",
            "text": "拜托了！"
          },
          "200060110": {
            "id": "200060110",
            "speakerId": 10002,
            "speakerName": "莎拉",
            "text": "等你帮完我的忙之后，我，我就请你吃猎鹿人特制料理，就拜托你了！"
          }
        }
      }
    },

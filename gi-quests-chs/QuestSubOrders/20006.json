    {
      "subId": "2000603",
      "subQuestName": "(test)运送餐品给活跃的欧琳$HIDDEN",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "200060201"
        ],
        "dialogs": {
          "200060201": {
            "id": "200060201",
            "speakerId": 159401,
            "speakerName": "活跃的欧琳",
            "text": "谢谢你，这些史莱姆真讨厌。",
            "nextDialogs": [
              "200060202"
            ]
          },
          "200060202": {
            "id": "200060202",
            "speakerId": 159401,
            "speakerName": "活跃的欧琳",
            "text": "要不是我饿到没力气了，这些家伙…",
            "nextDialogs": [
              "200060203"
            ]
          },
          "200060203": {
            "id": "200060203",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "这是你订的餐。",
            "nextDialogs": [
              "200060204"
            ]
          },
          "200060204": {
            "id": "200060204",
            "speakerId": 159401,
            "speakerName": "活跃的欧琳",
            "text": "唔——是胡萝卜和肉的香气…要是能早点吃到，那些史莱姆早就被我打飞了！",
            "nextDialogs": [
              "200060205"
            ]
          },
          "200060205": {
            "id": "200060205",
            "speakerId": 159401,
            "speakerName": "活跃的欧琳",
            "text": "算了不管了，这是餐费，带回去给莎拉小姐吧。"
          }
        }
      }
    },

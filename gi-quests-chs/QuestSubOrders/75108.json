    {
      "subId": "7510804",
      "subQuestName": "(test)释放被关押的动物$HIDDEN",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "751080401"
        ],
        "dialogs": {
          "751080401": {
            "id": "751080401",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "欸？这些笼子里怎么关着一些龙？",
            "nextDialogs": [
              "751080402"
            ]
          },
          "751080402": {
            "id": "751080402",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "不对劲…难道说，它们都是被那群人强行抓起来的？",
            "nextDialogs": [
              "751080403"
            ]
          },
          "751080403": {
            "id": "751080403",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "我们好像在不知不觉中打败了一群…捕捉龙的贩子？",
            "nextDialogs": [
              "751080405",
              "751080407"
            ]
          },
          "751080405": {
            "id": "751080405",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "好耶！我们这就救出被抓的龙吧！",
            "nextDialogs": [
              "751080408"
            ]
          },
          "751080408": {
            "id": "751080408",
            "speakerId": 1001,
            "speakerName": "#{REALNAME[ID(2)|SHOWHOST(true)]}",
            "text": "呀！"
          },
          "751080407": {
            "id": "751080407",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "有所谓啦，被抓的龙重获自由很重要，我们赶快帮帮它们！"
          }
        }
      }
    },
    {
      "subId": "7510805",
      "subQuestName": "解救动物们",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "751080501"
        ],
        "dialogs": {
          "751080501": {
            "id": "751080501",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "这里居然还有一只…膨膨兽？坏家伙们真是什么动物都倒卖啊…",
            "nextDialogs": [
              "751080502"
            ]
          },
          "751080502": {
            "id": "751080502",
            "speakerId": 1002,
            "speakerName": "受害的膨膨兽",
            "text": "嗷…呜呜！",
            "nextDialogs": [
              "751080503"
            ]
          },
          "751080503": {
            "id": "751080503",
            "speakerId": 1001,
            "speakerName": "#{REALNAME[ID(2)|SHOWHOST(true)]}",
            "text": "嗯…嗯！",
            "nextDialogs": [
              "751080504"
            ]
          },
          "751080504": {
            "id": "751080504",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "#咦？{REALNAME[ID(2)|SHOWHOST(true)]}怎么好像对膨膨兽很感兴趣？",
            "nextDialogs": [
              "751080505"
            ]
          },
          "751080505": {
            "id": "751080505",
            "speakerId": 1003,
            "speakerName": "Black Screen",
            "text": "#{REALNAME[ID(2)|SHOWHOST(true)]}认真听了听膨膨兽的叫声，似乎明白了什么，提着膨膨兽的尾巴，将它带到了水边的浅滩上，一起玩耍了起来。",
            "nextDialogs": [
              "751080512"
            ]
          },
          "751080512": {
            "id": "751080512",
            "speakerId": 1001,
            "speakerName": "#{REALNAME[ID(2)|SHOWHOST(true)]}",
            "text": "呀！",
            "nextDialogs": [
              "751080508"
            ]
          },
          "751080508": {
            "id": "751080508",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "确实喔，说不定它们两个能交上朋友呢！",
            "nextDialogs": [
              "751080509"
            ]
          },
          "751080509": {
            "id": "751080509",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "不过，那只膨膨兽好像一点力气都没有，两只…大爪子…都不怎么扑腾了。",
            "nextDialogs": [
              "751080510"
            ]
          },
          "751080510": {
            "id": "751080510",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "附近连装饭的盘子都没看见…可能它们被关得太久，一直在挨饿。",
            "nextDialogs": [
              "751080511"
            ]
          },
          "751080511": {
            "id": "751080511",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "#既然如此，我们就给膨膨兽和{REALNAME[ID(2)|SHOWHOST(true)]}做点吃的吧！"
          }
        }
      }
    },

    {
      "subId": "7510807",
      "subQuestName": "为动物朋友们送上料理",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "751080701"
        ],
        "dialogs": {
          "751080701": {
            "id": "751080701",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "好吃的来啦！别光顾着玩哦，该补充一下体力了。",
            "nextDialogs": [
              "751080702"
            ]
          },
          "751080702": {
            "id": "751080702",
            "speakerId": 1001,
            "speakerName": "#{REALNAME[ID(2)|SHOWHOST(true)]}",
            "text": "呀！",
            "nextDialogs": [
              "751080703"
            ]
          },
          "751080703": {
            "id": "751080703",
            "speakerId": 1004,
            "speakerName": "虚弱的膨膨兽",
            "text": "嗷…嗷嗷！",
            "nextDialogs": [
              "751080704"
            ]
          },
          "751080704": {
            "id": "751080704",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "吃得真香！就是不知道这样倒过来吃饭，会不会噎着…",
            "nextDialogs": [
              "751080705"
            ]
          },
          "751080705": {
            "id": "751080705",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "别学膨膨兽哦，要注意安全。",
            "nextDialogs": [
              "751080706"
            ]
          },
          "751080706": {
            "id": "751080706",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "怎么感觉你这个提醒显得我呆呆的…我又不是膨膨兽，当然不会这样吃东西了。",
            "nextDialogs": [
              "751080707"
            ]
          },
          "751080707": {
            "id": "751080707",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "你也试试不就知道了。",
            "nextDialogs": [
              "751080708"
            ]
          },
          "751080708": {
            "id": "751080708",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "喂！我又不是膨膨兽，才不会这样吃东西呢！",
            "nextDialogs": [
              "751080709"
            ]
          },
          "751080709": {
            "id": "751080709",
            "speakerId": 1003,
            "speakerName": "Black Screen",
            "text": "膨膨兽似乎恢复了元气，扑腾着跳入海中…",
            "nextDialogs": [
              "751080719"
            ]
          },
          "751080719": {
            "id": "751080719",
            "speakerId": 1001,
            "speakerName": "#{REALNAME[ID(2)|SHOWHOST(true)]}",
            "text": "嗯…嗷！",
            "nextDialogs": [
              "751080710"
            ]
          },
          "751080710": {
            "id": "751080710",
            "speakerId": 1005,
            "speakerName": "恢复元气的膨膨兽",
            "text": "嗷，呜…呀！",
            "nextDialogs": [
              "751080712"
            ]
          },
          "751080712": {
            "id": "751080712",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "啊，膨膨兽走掉了…",
            "nextDialogs": [
              "751080713"
            ]
          },
          "751080713": {
            "id": "751080713",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "没办法，毕竟不是纳塔的生物。",
            "nextDialogs": [
              "751080715"
            ]
          },
          "751080715": {
            "id": "751080715",
            "speakerId": 1001,
            "speakerName": "#{REALNAME[ID(2)|SHOWHOST(true)]}",
            "text": "唔…",
            "nextDialogs": [
              "751080716"
            ]
          },
          "751080716": {
            "id": "751080716",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "#别难过哦，{REALNAME[ID(2)|SHOWHOST(true)]}，你们刚才玩得那么开心，已经成为好朋友了！",
            "nextDialogs": [
              "751080717"
            ]
          },
          "751080717": {
            "id": "751080717",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "我有种预感，我们和那只膨膨兽以后还会再见面的！",
            "nextDialogs": [
              "751080718"
            ]
          },
          "751080718": {
            "id": "751080718",
            "speakerId": 1001,
            "speakerName": "#{REALNAME[ID(2)|SHOWHOST(true)]}",
            "text": "呀！"
          }
        }
      }
    },

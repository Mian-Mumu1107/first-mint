  "subQuests": [
    {
      "subId": "7510801",
      "subQuestName": "(test)到达营地附近$HIDDEN",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "751080101"
        ],
        "dialogs": {
          "751080101": {
            "id": "751080101",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "说是要做料理，不过，选哪种料理才好呢？",
            "nextDialogs": [
              "751080102"
            ]
          },
          "751080102": {
            "id": "751080102",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "我记得，以前我们给膨膨兽「呜呜葡萄」喂过鱼肉，那鱼料理应该很不错！",
            "nextDialogs": [
              "751080103"
            ]
          },
          "751080103": {
            "id": "751080103",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "#要让膨膨兽和{REALNAME[ID(2)|SHOWHOST(true)]}吃得开心…感觉纳塔特色的「薄荷酱烤鱼」很不错呢。",
            "nextDialogs": [
              "751080106"
            ]
          },
          "751080106": {
            "id": "751080106",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "好，那就开工吧，我也会在一边给你出主意的！"
          }
        }
      }
    },
    {
      "subId": "7510803",
      "subQuestName": "(test)清理走私者营地$HIDDEN",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "751080301"
        ],
        "dialogs": {
          "751080301": {
            "id": "751080301",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "果然还有一些龙被关着…",
            "nextDialogs": [
              "751080302"
            ]
          },
          "751080302": {
            "id": "751080302",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "没想到，之前捣毁了那个据点，他们还是死性不改，继续干着这些伤害龙的坏事。",
            "nextDialogs": [
              "751080303"
            ]
          },
          "751080303": {
            "id": "751080303",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "早知道，我们应该当时就追击，把他们全灭的。",
            "nextDialogs": [
              "751080305",
              "751080307"
            ]
          },
          "751080305": {
            "id": "751080305",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "说的也是，我们这就救出被抓的龙吧！",
            "nextDialogs": [
              "751080308"
            ]
          },
          "751080308": {
            "id": "751080308",
            "speakerId": 1001,
            "speakerName": "#{REALNAME[ID(2)|SHOWHOST(true)]}",
            "text": "呀！"
          },
          "751080307": {
            "id": "751080307",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "#冷酷残忍的{NICKNAME}…想象不出来…还是先帮帮它们吧！"
          }
        }
      }
    },
    {
      "subId": "7510808",

      }
    },
    {
      "subId": "7507604",
      "subQuestName": "揭开海岛的封印",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "750760401"
        ],
        "dialogs": {
          "750760401": {
            "id": "750760401",
            "speakerId": 1000,
            "speakerName": "萨卡乌",
            "text": "海上的迷雾最近越发深重了，啊…真是让人忧心…",
            "nextDialogs": [
              "750760404"
            ]
          },
          "750760404": {
            "id": "750760404",
            "speakerId": 1000,
            "speakerName": "萨卡乌",
            "text": "难道那个传说是真的？",
            "nextDialogs": [
              "750760405"
            ]
          },
          "750760405": {
            "id": "750760405",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "什么传说？",
            "nextDialogs": [
              "750760406"
            ]
          },
          "750760406": {
            "id": "750760406",
            "speakerId": 1000,
            "speakerName": "萨卡乌",
            "text": "呃…啊，这就要看异邦的勇士你要听什么样的传说了…",
            "nextDialogs": [
              "750760407"
            ]
          },
          "750760407": {
            "id": "750760407",
            "speakerId": 1000,
            "speakerName": "萨卡乌",
            "text": "关于海面上浮岛与巨大涂鸦的故事，有两个来由，一个更像故事，一个更像真实的传说。",
            "nextDialogs": [
              "750760402"
            ]
          },
          "750760402": {
            "id": "750760402",
            "speakerId": 1000,
            "speakerName": "萨卡乌",
            "text": "异邦的勇士，你想要听哪一个呢？",
            "nextDialogs": [
              "750760409",
              "750760412"
            ]
          },
          "750760409": {
            "id": "750760409",
            "speakerId": 1000,
            "speakerName": "萨卡乌",
            "text": "嗯，更像故事的那边总是比较浪漫啦…迷雾浮岛中涂鸦的来源，是一部名为《奎伊露和乌库库的故事》中的一部分。",
            "nextDialogs": [
              "750760403"
            ]
          },
          "750760403": {
            "id": "750760403",
            "speakerId": 1000,
            "speakerName": "萨卡乌",
            "text": "据说名叫奎伊露的少女为了与她的太阳父亲联系，而在那海滨之处留下了巨大的涂鸦。",
            "nextDialogs": [
              "750760410"
            ]
          },
          "750760410": {
            "id": "750760410",
            "speakerId": 1000,
            "speakerName": "萨卡乌",
            "text": "她的太阳父亲在天上看到涂鸦，于是将她从地上接走…大致就是这样的故事。",
            "nextDialogs": [
              "750760417"
            ]
          },
          "750760417": {
            "id": "750760417",
            "speakerId": 1000,
            "speakerName": "萨卡乌",
            "text": "那看上去令人不安的迷雾，据说是太阳父亲给予地上部族民的惩罚，因为部族民夺去了他女儿的力量。",
            "nextDialogs": [
              "750760415"
            ]
          },
          "750760415": {
            "id": "750760415",
            "speakerId": 1000,
            "speakerName": "萨卡乌",
            "text": "唉，不管是传说还是故事，迷雾自海上升起，都不是什么吉兆。",
            "nextDialogs": [
              "750760416"
            ]
          },
          "750760416": {
            "id": "750760416",
            "speakerId": 1000,
            "speakerName": "萨卡乌",
            "text": "异邦的勇士啊…那里现在说不定很危险，一定要小心，最好不要靠近啊…"
          },
          "750760412": {
            "id": "750760412",
            "speakerId": 1000,
            "speakerName": "萨卡乌",
            "text": "关于真实的传说嘛…据说很久以前，有很邪恶的巫师扮作大灵的样子，蛊惑了部族的勇士。",
            "nextDialogs": [
              "750760413"
            ]
          },
          "750760413": {
            "id": "750760413",
            "speakerId": 1000,
            "speakerName": "萨卡乌",
            "text": "后来，部族的勇士们不得不用巨大的涂鸦，将那个黑漆漆的邪恶巫师关在了涂鸦的封印之下…",
            "nextDialogs": [
              "750760414"
            ]
          },
          "750760414": {
            "id": "750760414",
            "speakerId": 1000,
            "speakerName": "萨卡乌",
            "text": "海面之所以会变成这个样子，据说是因为邪恶的巫师会突破封印，从封印中跑出来为非作歹的预兆。"
          }
        }
      }
    },

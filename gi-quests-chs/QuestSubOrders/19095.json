      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "190950201"
        ],
        "dialogs": {
          "190950201": {
            "id": "190950201",
            "speakerId": 1000,
            "speakerName": "阿贝多",
            "text": "……",
            "nextDialogs": [
              "190950202"
            ]
          },
          "190950202": {
            "id": "190950202",
            "speakerId": 1001,
            "speakerName": "凯亚",
            "text": "……",
            "nextDialogs": [
              "190950203"
            ]
          },
          "190950203": {
            "id": "190950203",
            "speakerId": 1000,
            "speakerName": "阿贝多",
            "text": "欢迎回来，两位…可莉总是以为凯亚也被关禁闭了，这下我可以解释了。",
            "nextDialogs": [
              "190950204"
            ]
          },
          "190950204": {
            "id": "190950204",
            "speakerId": 1001,
            "speakerName": "凯亚",
            "text": "唉，所以这次是什么情况？",
            "nextDialogs": [
              "190950205"
            ]
          },
          "190950205": {
            "id": "190950205",
            "speakerId": 1000,
            "speakerName": "阿贝多",
            "text": "…坩埚炸了。",
            "nextDialogs": [
              "190950206"
            ]
          },
          "190950206": {
            "id": "190950206",
            "speakerId": 1001,
            "speakerName": "凯亚",
            "text": "就炸了一处？",
            "nextDialogs": [
              "190950207"
            ]
          },
          "190950207": {
            "id": "190950207",
            "speakerId": 1000,
            "speakerName": "阿贝多",
            "text": "不是，所有的都炸了，连带着合成台一起，烟…有点大。",
            "nextDialogs": [
              "190950208"
            ]
          },
          "190950208": {
            "id": "190950208",
            "speakerId": 1001,
            "speakerName": "凯亚",
            "text": "哦，怪不得琴要找你。",
            "nextDialogs": [
              "190950209",
              "190950211"
            ]
          },
          "190950209": {
            "id": "190950209",
            "speakerId": 1001,
            "speakerName": "凯亚",
            "text": "这次以后，恐怕你也得慢慢熟练起来了。",
            "nextDialogs": [
              "190950210"
            ]
          },
          "190950210": {
            "id": "190950210",
            "speakerId": 1001,
            "speakerName": "凯亚",
            "text": "你以后要是碰到这种情况，记得找我和阿贝多，最好是我们几个一起处理，诚恳点向琴和受影响的人道歉。",
            "nextDialogs": [
              "190950212"
            ]
          },
          "190950212": {
            "id": "190950212",
            "speakerId": 1000,
            "speakerName": "阿贝多",
            "text": "其他的你们应该都能猜到了，抱歉明明你们刚回来就被卷进这种事。",
            "nextDialogs": [
              "190950213"
            ]
          },
          "190950213": {
            "id": "190950213",
            "speakerId": 1001,
            "speakerName": "凯亚",
            "text": "这没什么。",
            "nextDialogs": [
              "190950297"
            ]
          },
          "190950297": {
            "id": "190950297",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "阿贝多不要介意。",
            "nextDialogs": [
              "190950214"
            ]
          },
          "190950214": {
            "id": "190950214",
            "speakerId": 1000,
            "speakerName": "阿贝多",
            "text": "礼物什么的，现在我时间有点紧，不好意思。等可莉出来，我再让她来找你吧。",
            "nextDialogs": [
              "190950215"
            ]
          },
          "190950215": {
            "id": "190950215",
            "speakerId": 1001,
            "speakerName": "凯亚",
            "text": "嗯，我理解，你去收拾工坊吧，其他的以后再说。",
            "nextDialogs": [
              "190950216"
            ]
          },
          "190950216": {
            "id": "190950216",
            "speakerId": 1001,
            "speakerName": "凯亚",
            "text": "阿贝多先走了，我们也离开骑士团吧。"
          },
          "190950211": {
            "id": "190950211",
            "speakerId": 1000,
            "speakerName": "阿贝多",
            "text": "那天，全蒙德城的人都看到了工坊上空冒着的烟。"
          }
        }
      }
    },

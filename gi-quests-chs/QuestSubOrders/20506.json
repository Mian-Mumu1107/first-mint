  "subQuests": [
    {
      "subId": "2050601",
      "subQuestName": "与蒂玛乌斯对话，了解炼金术",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "205060101"
        ],
        "dialogs": {
          "205060101": {
            "id": "205060101",
            "speakerId": 1587,
            "speakerName": "蒂玛乌斯",
            "text": "你好，我是炼金术的研究者蒂玛乌斯，欢迎来到蒙德城。",
            "nextDialogs": [
              "205060102"
            ]
          },
          "205060102": {
            "id": "205060102",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "炼金术？",
            "nextDialogs": [
              "205060103"
            ]
          },
          "205060103": {
            "id": "205060103",
            "speakerId": 1587,
            "speakerName": "蒂玛乌斯",
            "text": "这是一种从古代流传下来的技术，目前我们还对它了解甚少。",
            "nextDialogs": [
              "205060104"
            ]
          },
          "205060104": {
            "id": "205060104",
            "speakerId": 1587,
            "speakerName": "蒂玛乌斯",
            "text": "它的规则神秘而奇妙，和我们所知的创造物体的原理完全不同。",
            "nextDialogs": [
              "205060105"
            ]
          },
          "205060105": {
            "id": "205060105",
            "speakerId": 1587,
            "speakerName": "蒂玛乌斯",
            "text": "要是能掌握这门技术，我们应该就能造出很不得了的东西了。",
            "nextDialogs": [
              "205060106"
            ]
          },
          "205060106": {
            "id": "205060106",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "这边的这个就是炼金术用的台子吧？",
            "nextDialogs": [
              "205060107"
            ]
          },
          "205060107": {
            "id": "205060107",
            "speakerId": 1587,
            "speakerName": "蒂玛乌斯",
            "text": "没错。对了，要不亲自使用一下炼金术试试？",
            "nextDialogs": [
              "205060110"
            ]
          },
          "205060110": {
            "id": "205060110",
            "speakerId": 1587,
            "speakerName": "蒂玛乌斯",
            "text": "没事的，至少操作上并不复杂。你有兴趣的话我可以教你最基础的部分。",
            "nextDialogs": [
              "205060111"
            ]
          },
          "205060111": {
            "id": "205060111",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "炼金合成"
          }
        }
      }
    },
    {
      "subId": "2050602",
      "subQuestName": "(test)与蒂玛乌斯对话（隐藏）$HIDDEN",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "205060201"
        ],
        "dialogs": {
          "205060201": {
            "id": "205060201",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "好神奇啊…",
            "nextDialogs": [
              "205060202"
            ]
          },
          "205060202": {
            "id": "205060202",
            "speakerId": 1587,
            "speakerName": "蒂玛乌斯",
            "text": "我们现在所使用的炼金术，都还只是在模仿古代人留下来的方法。",
            "nextDialogs": [
              "205060203"
            ]
          },
          "205060203": {
            "id": "205060203",
            "speakerId": 1587,
            "speakerName": "蒂玛乌斯",
            "text": "会使用风之翼的人是不需要知道它是怎么制作出来的，炼金术也是一个道理。",
            "nextDialogs": [
              "205060204"
            ]
          },
          "205060204": {
            "id": "205060204",
            "speakerId": 1587,
            "speakerName": "蒂玛乌斯",
            "text": "但每当我觉得好像摸到了一点原理，它又马上会让人出乎意料，唉…",
            "nextDialogs": [
              "205060206",
              "205060208"
            ]
          },
          "205060206": {
            "id": "205060206",
            "speakerId": 1587,
            "speakerName": "蒂玛乌斯",
            "text": "说实话我也不知道，但就是不知道才引人好奇。",
            "nextDialogs": [
              "205060210"
            ]
          },
          "205060210": {
            "id": "205060210",
            "speakerId": 1587,
            "speakerName": "蒂玛乌斯",
            "text": "有很多神奇的配方我也还在研究。",
            "nextDialogs": [
              "205060211"
            ]
          },
          "205060211": {
            "id": "205060211",
            "speakerId": 1587,
            "speakerName": "蒂玛乌斯",
            "text": "在你冒险的途中，应该能见到一些古代文明留下的关于炼金术的记录。",
            "nextDialogs": [
              "205060212"
            ]
          },
          "205060212": {
            "id": "205060212",
            "speakerId": 1587,
            "speakerName": "蒂玛乌斯",
            "text": "随着你「冒险等阶」的提高，你掌握的配方也会更多。"
          },
          "205060208": {
            "id": "205060208",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "有一个我还不够吗？！",
            "nextDialogs": [
              "205060209"
            ]
          },
          "205060209": {
            "id": "205060209",
            "speakerId": 1587,
            "speakerName": "蒂玛乌斯",
            "text": "哈哈哈，很可惜现在还不行。"
          }
        }
      }
    }
  ]
}
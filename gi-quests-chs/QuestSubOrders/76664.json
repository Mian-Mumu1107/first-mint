{
  "lineCounts": {
    "米尔斯基": 14,
    "菈乌玛": 9
  },
  "subQuests": [
    {
      "subId": "7666401",
      "subQuestName": "",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "766505701"
        ],
        "dialogs": {
          "766505701": {
            "id": "766505701",
            "speakerId": 1315,
            "speakerName": "菈乌玛",
            "text": "米尔斯基先生，您好。",
            "nextDialogs": [
              "766505702"
            ]
          },
          "766505702": {
            "id": "766505702",
            "speakerId": 7107,
            "speakerName": "米尔斯基",
            "text": "菈乌玛小姐，您来了。上次我的提议您怎么看？",
            "nextDialogs": [
              "766505703"
            ]
          },
          "766505703": {
            "id": "766505703",
            "speakerId": 7107,
            "speakerName": "米尔斯基",
            "text": "只要一点简单的材料，我就能让这里大变样。",
            "nextDialogs": [
              "766505704"
            ]
          },
          "766505704": {
            "id": "766505704",
            "speakerId": 7107,
            "speakerName": "米尔斯基",
            "text": "无论是自动抽水的水泵，加固房屋的支撑杆，还有缝纫用的机械，我都能造出来。",
            "nextDialogs": [
              "766505705"
            ]
          },
          "766505705": {
            "id": "766505705",
            "speakerId": 7107,
            "speakerName": "米尔斯基",
            "text": "剩下的边角料，我还能给孩子们做点小跳蛙，他们爱死这玩具了。",
            "nextDialogs": [
              "766505706"
            ]
          },
          "766505706": {
            "id": "766505706",
            "speakerId": 1315,
            "speakerName": "菈乌玛",
            "text": "如果您愿意帮忙，那自然是最好，相关的费用，我们也会如数支付。",
            "nextDialogs": [
              "766505707"
            ]
          },
          "766505707": {
            "id": "766505707",
            "speakerId": 7107,
            "speakerName": "米尔斯基",
            "text": "钱？噢，谢谢您的慷慨。但我更关心的是，您愿意让我去书库里查阅书籍吗？",
            "nextDialogs": [
              "766505708"
            ]
          },
          "766505708": {
            "id": "766505708",
            "speakerId": 7107,
            "speakerName": "米尔斯基",
            "text": "我相信，那间书库里绝对有我想要的「月矩力」资料。",
            "nextDialogs": [
              "766505709"
            ]
          },
          "766505709": {
            "id": "766505709",
            "speakerId": 1315,
            "speakerName": "菈乌玛",
            "text": "没问题，您是我们的客人，书库的大门随时为您敞开。",
            "nextDialogs": [
              "766505710"
            ]
          },
          "766505710": {
            "id": "766505710",
            "speakerId": 7107,
            "speakerName": "米尔斯基",
            "text": "呃，我的意思是，借阅得更远一些，或者是抄录…",
            "nextDialogs": [
              "766505711"
            ]
          },
          "766505711": {
            "id": "766505711",
            "speakerId": 1315,
            "speakerName": "菈乌玛",
            "text": "不行。您只能在书库里阅读那些书籍。",
            "nextDialogs": [
              "766505712"
            ]
          },
          "766505712": {
            "id": "766505712",
            "speakerId": 7107,
            "speakerName": "米尔斯基",
            "text": "好吧，那也足够了。等我收拾一下，就去书库里做客。",
            "nextDialogs": [
              "766505713"
            ]
          },
          "766505713": {
            "id": "766505713",
            "speakerId": 1315,
            "speakerName": "菈乌玛",
            "text": "随时欢迎…对了，还有一件小事，如果您在书库里看见了一位正在抄写教条的侍祭，请别打扰她。",
            "nextDialogs": [
              "766505714"
            ]
          },
          "766505714": {
            "id": "766505714",
            "speakerId": 1315,
            "speakerName": "菈乌玛",
            "text": "她犯了错，刚刚结束了静思，接下来要一直抄写教条，直到她能够端正心念的那一天。",
            "nextDialogs": [
              "766505715"
            ]
          },
          "766505715": {
            "id": "766505715",
            "speakerId": 7107,
            "speakerName": "米尔斯基",
            "text": "抄写教条？哈哈哈，您可真好心。要是我之前那位老板发现我犯了错，非得要把我下辈子赚的钱也赔给他不可。",
            "nextDialogs": [
              "766505716"
            ]
          },
          "766505716": {
            "id": "766505716",
            "speakerId": 1315,
            "speakerName": "菈乌玛",
            "text": "我相信，对维娜琴卡来说，抄写教条已经是一件很重的惩罚了。",
            "nextDialogs": [
              "766505717"
            ]
          },
          "766505717": {
            "id": "766505717",
            "speakerId": 7107,
            "speakerName": "米尔斯基",
            "text": "也许吧，但对我来说，抄书只是…",
            "nextDialogs": [
              "766505718"
            ]
          },
          "766505718": {
            "id": "766505718",
            "speakerId": 7107,
            "speakerName": "米尔斯基",
            "text": "您、您等一会，谁？您说是谁？",
            "nextDialogs": [
              "766505719"
            ]
          },
          "766505719": {
            "id": "766505719",
            "speakerId": 1315,
            "speakerName": "菈乌玛",
            "text": "维娜琴卡，您认识她？",
            "nextDialogs": [
              "766505720"
            ]
          },
          "766505720": {
            "id": "766505720",
            "speakerId": 7107,
            "speakerName": "米尔斯基",
            "text": "哦…噢！不认识，只是这名字，听起来倒不是非常生分。",
            "nextDialogs": [
              "766505721"
            ]
          },
          "766505721": {
            "id": "766505721",
            "speakerId": 7107,
            "speakerName": "米尔斯基",
            "text": "容我问一句，这位维娜琴卡小姐，具体是哪几天会去抄写教条？毕竟人家正在做正事，我可不能打搅了她。",
            "nextDialogs": [
              "766505722"
            ]
          },
          "766505722": {
            "id": "766505722",
            "speakerId": 1315,
            "speakerName": "菈乌玛",
            "text": "每天都去。但您不必如此拘谨，她会在单独的位置抄写，只要您略微注意一些，应该是不会打扰她的。",
            "nextDialogs": [
              "766505723"
            ]
          },
          "766505723": {
            "id": "766505723",
            "speakerId": 7107,
            "speakerName": "米尔斯基",
            "text": "好的，好的。呃…我马上收拾，收拾好了之后，马上就去书库。"
          }
        }
      }
    }
  ]
}
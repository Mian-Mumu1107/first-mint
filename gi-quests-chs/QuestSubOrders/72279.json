  },
  "subQuests": [
    {
      "subId": "7227919",
      "subQuestName": "",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "722791901"
        ],
        "dialogs": {
          "722791901": {
            "id": "722791901",
            "speakerId": 1033,
            "speakerName": "托马",
            "text": "嘿，在这里见到你们真是意外。",
            "nextDialogs": [
              "722791902"
            ]
          },
          "722791902": {
            "id": "722791902",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "你怎么来了？",
            "nextDialogs": [
              "722791903"
            ]
          },
          "722791903": {
            "id": "722791903",
            "speakerId": 1033,
            "speakerName": "托马",
            "text": "本来我是听说会展上出现了一位特别喜爱狸猫留影板的「人物」。",
            "nextDialogs": [
              "722791904"
            ]
          },
          "722791904": {
            "id": "722791904",
            "speakerId": 1033,
            "speakerName": "托马",
            "text": "毕竟是我社奉行操办的祭典，有这等「人物」出现，我当然要来认识一下。",
            "nextDialogs": [
              "722791905"
            ]
          },
          "722791905": {
            "id": "722791905",
            "speakerId": 1033,
            "speakerName": "托马",
            "text": "这红色的角…如果我没猜错的话，这位就是鼎鼎有名的荒泷派之主，荒泷一斗阁下吧？",
            "nextDialogs": [
              "722791906"
            ]
          },
          "722791906": {
            "id": "722791906",
            "speakerId": 1044,
            "speakerName": "荒泷一斗",
            "text": "哈哈哈哈哈——！托马兄弟果然有眼力！",
            "nextDialogs": [
              "722791907"
            ]
          },
          "722791907": {
            "id": "722791907",
            "speakerId": 1044,
            "speakerName": "荒泷一斗",
            "text": "神里家的无敌家政官，我也早就听过你的大名！",
            "nextDialogs": [
              "722791908"
            ]
          },
          "722791908": {
            "id": "722791908",
            "speakerId": 1033,
            "speakerName": "托马",
            "text": "初次见面，一斗兄弟抬爱了。",
            "nextDialogs": [
              "722791909"
            ]
          },
          "722791909": {
            "id": "722791909",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "呜哇！这两个人，这么快就称兄道弟起来了…",
            "nextDialogs": [
              "722791910"
            ]
          },
          "722791910": {
            "id": "722791910",
            "speakerId": 1033,
            "speakerName": "托马",
            "text": "没想到一斗兄弟和旅行者都在这里。",
            "nextDialogs": [
              "722791911"
            ]
          },
          "722791911": {
            "id": "722791911",
            "speakerId": 1033,
            "speakerName": "托马",
            "text": "我也勉强算是东道主，是有什么麻烦吗？尽管开口，不用和我客气。",
            "nextDialogs": [
              "722791912"
            ]
          },
          "722791912": {
            "id": "722791912",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "是一斗啦！他要…",
            "nextDialogs": [
              "722791913"
            ]
          },
          "722791913": {
            "id": "722791913",
            "speakerId": 1044,
            "speakerName": "荒泷一斗",
            "text": "没什么大不了，我们只是在商量决斗的方式罢了。",
            "nextDialogs": [
              "722791914"
            ]
          },
          "722791914": {
            "id": "722791914",
            "speakerId": 1033,
            "speakerName": "托马",
            "text": "噢——决斗的方式是吧…",
            "nextDialogs": [
              "722791915"
            ]
          },
          "722791915": {
            "id": "722791915",
            "speakerId": 1033,
            "speakerName": "托马",
            "text": "我倒有个提议，既然是要在容彩祭上决斗，或许可以来一场志愿者大比拼吧。",
            "nextDialogs": [
              "722791916"
            ]
          },
          "722791916": {
            "id": "722791916",
            "speakerId": 1033,
            "speakerName": "托马",
            "text": "一起为容彩祭添砖加瓦，各位觉得怎么样？",
            "nextDialogs": [
              "722791917"
            ]
          },
          "722791917": {
            "id": "722791917",
            "speakerId": 1044,
            "speakerName": "荒泷一斗",
            "text": "志愿者大比拼？听起来完全不能体现我荒泷派的豪情壮志啊…",
            "nextDialogs": [
              "722791918"
            ]
          },
          "722791918": {
            "id": "722791918",
            "speakerId": 1044,
            "speakerName": "荒泷一斗",
            "text": "#我的兴趣只有两分。一分给{NICKNAME}，一分给托马兄弟。",
            "nextDialogs": [
              "722791919"
            ]
          },
          "722791919": {
            "id": "722791919",
            "speakerId": 12278,
            "speakerName": "阿守",
            "text": "老大的意思是…他的满分是一百分。",
            "nextDialogs": [
              "722791920"
            ]
          },
          "722791920": {
            "id": "722791920",
            "speakerId": 1033,
            "speakerName": "托马",
            "text": "哈哈，嗯，这份工作确实用不上豪情壮志，只需要一些耐心与奉献就够了。",
            "nextDialogs": [
              "722791921"
            ]
          },
          "722791921": {
            "id": "722791921",
            "speakerId": 1033,
            "speakerName": "托马",
            "text": "而且因为是志愿者，也没有什么报酬，只有远航之风的联名饮料，作为一点慰问…",
            "nextDialogs": [
              "722791922"
            ]
          },
          "722791922": {
            "id": "722791922",
            "speakerId": 1033,
            "speakerName": "托马",
            "text": "实在有些配不上荒泷派的身份，是我欠考虑了。",
            "nextDialogs": [
              "722791923"
            ]
          },
          "722791923": {
            "id": "722791923",
            "speakerId": 1044,
            "speakerName": "荒泷一斗",
            "text": "等等…你刚刚说什么慰问？",
            "nextDialogs": [
              "722791924"
            ]
          },
          "722791924": {
            "id": "722791924",
            "speakerId": 1033,
            "speakerName": "托马",
            "text": "噢，只是一点八重堂与远航之风联名的特别饮料，不值一提。",
            "nextDialogs": [
              "722791925"
            ]
          },
          "722791925": {
            "id": "722791925",
            "speakerId": 12276,
            "speakerName": "阿晃",
            "text": "老大！是那款饮料!",
            "nextDialogs": [
              "722791926"
            ]
          },
          "722791926": {
            "id": "722791926",
            "speakerId": 12277,
            "speakerName": "元太",
            "text": "干活就有饮料！",
            "nextDialogs": [
              "722791927"
            ]
          },
          "722791927": {
            "id": "722791927",
            "speakerId": 1044,
            "speakerName": "荒泷一斗",
            "text": "啊…托马兄弟，其实你不知道，我说的两分，其实满分就是两分。",
            "nextDialogs": [
              "722791928"
            ]
          },
          "722791928": {
            "id": "722791928",
            "speakerId": 1044,
            "speakerName": "荒泷一斗",
            "text": "毕竟我们荒泷派，最不缺的就是耐心与奉献！",
            "nextDialogs": [
              "722791929"
            ]
          },
          "722791929": {
            "id": "722791929",
            "speakerId": 1044,
            "speakerName": "荒泷一斗",
            "text": "你的点子非常豪爽畅快，热情奔放！简直是为本大爷量身定制，哈哈哈哈哈——！",
            "nextDialogs": [
              "722791930"
            ]
          },
          "722791930": {
            "id": "722791930",
            "speakerId": 1044,
            "speakerName": "荒泷一斗",
            "text": "旅行者，我们就来决斗这个吧，谁先完成志愿者的工作谁就赢了！你觉得怎么样？",
            "nextDialogs": [
              "722791931"
            ]
          },
          "722791931": {
            "id": "722791931",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "明明刚刚还一副没兴趣的样子喂。",
            "nextDialogs": [
              "722791934"
            ]
          },
          "722791934": {
            "id": "722791934",
            "speakerId": 1044,
            "speakerName": "荒泷一斗",
            "text": "我堂堂荒泷铁血第一斗，行的正站得直，说要决斗，就一定决斗。",
            "nextDialogs": [
              "722791935"
            ]
          },
          "722791935": {
            "id": "722791935",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "其实只是不想让别人知道目的是特别饮料吧。",
            "nextDialogs": [
              "722791936"
            ]
          },
          "722791936": {
            "id": "722791936",
            "speakerId": 1033,
            "speakerName": "托马",
            "text": "既然如此，不如就让我来当一回裁判。",
            "nextDialogs": [
              "722791937"
            ]
          },
          "722791937": {
            "id": "722791937",
            "speakerId": 1033,
            "speakerName": "托马",
            "text": "志愿者的工作很简单，主要是帮助祭典上需要帮助的人们。",
            "nextDialogs": [
              "722791938"
            ]
          },
          "722791938": {
            "id": "722791938",
            "speakerId": 1033,
            "speakerName": "托马",
            "text": "我会把我这里已经收到的工作请求分发给你们。",
            "nextDialogs": [
              "722791939"
            ]
          },
          "722791939": {
            "id": "722791939",
            "speakerId": 1033,
            "speakerName": "托马",
            "text": "准备好了的话，我们现在就开始吧。"
          }
        }
      }
    },
    {
      "subId": "7227901",
      "subQuestName": "与木村交谈",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "722790101"
        ],
        "dialogs": {
          "722790101": {
            "id": "722790101",
            "speakerId": 20567,
            "speakerName": "木村",
            "text": "这么多投诉…该怎么办呢？",
            "nextDialogs": [
              "722790102"
            ]
          },
          "722790102": {
            "id": "722790102",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "需要帮忙吗?",
            "nextDialogs": [
              "722790103"
            ]
          },
          "722790103": {
            "id": "722790103",
            "speakerId": 20567,
            "speakerName": "木村",
            "text": "啊，您应该就是上面说的…会来协助我们的那位旅行者吧？",
            "nextDialogs": [
              "722790104"
            ]
          },
          "722790104": {
            "id": "722790104",
            "speakerId": 20567,
            "speakerName": "木村",
            "text": "您来的太及时了，我们确实遇到了一点小麻烦。",
            "nextDialogs": [
              "722790105"
            ]
          },
          "722790105": {
            "id": "722790105",
            "speakerId": 20567,
            "speakerName": "木村",
            "text": "如您所知，现在这里正在举办容彩祭。",
            "nextDialogs": [
              "722790106"
            ]
          },
          "722790106": {
            "id": "722790106",
            "speakerId": 20567,
            "speakerName": "木村",
            "text": "容彩祭上除了一些商品展售外，还提供了很多免费的娱乐休闲项目。",
            "nextDialogs": [
              "722790107"
            ]
          },
          "722790107": {
            "id": "722790107",
            "speakerId": 20567,
            "speakerName": "木村",
            "text": "但是今天我们接到了好几起投诉，说有伙人霸占了一块狸猫合影板。",
            "nextDialogs": [
              "722790108"
            ]
          },
          "722790108": {
            "id": "722790108",
            "speakerId": 20567,
            "speakerName": "木村",
            "text": "他们一直赖着不走，搞得其他人都没法使用了。",
            "nextDialogs": [
              "722790109"
            ]
          },
          "722790109": {
            "id": "722790109",
            "speakerId": 20567,
            "speakerName": "木村",
            "text": "啊，真是头疼…",
            "nextDialogs": [
              "722790111",
              "722790116"
            ]
          },
          "722790111": {
            "id": "722790111",
            "speakerId": 20567,
            "speakerName": "木村",
            "text": "唔…我们当然也去交涉过了。只是设立休闲设施的初衷，是希望大家都能享受到会展的乐趣。",
            "nextDialogs": [
              "722790112"
            ]
          },
          "722790112": {
            "id": "722790112",
            "speakerId": 20567,
            "speakerName": "木村",
            "text": "原则上就是对所有人开放的，自然也没有规定使用时限…",
            "nextDialogs": [
              "722790113"
            ]
          },
          "722790113": {
            "id": "722790113",
            "speakerId": 20567,
            "speakerName": "木村",
            "text": "所以只要他们没有做出什么违法的事，就算像这样赖着不走…",
            "nextDialogs": [
              "722790114"
            ]
          },
          "722790114": {
            "id": "722790114",
            "speakerId": 20567,
            "speakerName": "木村",
            "text": "我们也没有什么好办法。",
            "nextDialogs": [
              "722790121"
            ]
          },
          "722790121": {
            "id": "722790121",
            "speakerId": 20567,
            "speakerName": "木村",
            "text": "所以，您能帮忙去协商一下吗？",
            "nextDialogs": [
              "722790122"
            ]
          },
          "722790122": {
            "id": "722790122",
            "speakerId": 20567,
            "speakerName": "木村",
            "text": "如果这些投诉不解决，被九条大人知道了。",
            "nextDialogs": [
              "722790123"
            ]
          },
          "722790123": {
            "id": "722790123",
            "speakerId": 20567,
            "speakerName": "木村",
            "text": "我这个月的奖金一定泡汤了…",
            "nextDialogs": [
              "722790124"
            ]
          },
          "722790124": {
            "id": "722790124",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "霸占合影板这种事情，听起来很像是那个家伙会做的呢！",
            "nextDialogs": [
              "722790125"
            ]
          },
          "722790125": {
            "id": "722790125",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "#{NICKNAME}，我们去看看吧？",
            "nextDialogs": [
              "722790126"
            ]
          },
          "722790126": {
            "id": "722790126",
            "speakerId": 20567,
            "speakerName": "木村",
            "text": "太感谢了！他们就在广场东边的狸猫合影板附近。"
          },
          "722790116": {
            "id": "722790116",
            "speakerId": 20567,
            "speakerName": "木村",
            "text": "抓…抓起来？虽然这样做是能解决目前的麻烦啦…",
            "nextDialogs": [
              "722790117"
            ]
          },
          "722790117": {
            "id": "722790117",
            "speakerId": 20567,
            "speakerName": "木村",
            "text": "但是大概很快就会有天领奉行无故抓人的新麻烦吧？",
            "nextDialogs": [
              "722790118"
            ]
          },
          "722790118": {
            "id": "722790118",
            "speakerId": 20567,
            "speakerName": "木村",
            "text": "我们先前也去交涉过了，但毕竟这些设施原则上是对所有人开放的，自然也没有规定使用时限…",
            "nextDialogs": [
              "722790119"
            ]
          },
          "722790119": {
            "id": "722790119",
            "speakerId": 20567,
            "speakerName": "木村",
            "text": "所以只要他们没有做出什么违法的事，就算像这样赖着不走…",
            "nextDialogs": [
              "722790120"
            ]
          },
          "722790120": {
            "id": "722790120",
            "speakerId": 20567,
            "speakerName": "木村",
            "text": "我们也没有什么好办法。"
          }
        }
      }
    },
    {
      "subId": "7227902",
      "subQuestName": "前往狸猫合影板附近",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [],
        "dialogs": {}
      }
    },
    {
      "subId": "7227903",
      "subQuestName": "与一斗交谈",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "722790401"
        ],
        "dialogs": {
          "722790401": {
            "id": "722790401",
            "speakerId": 1044,
            "speakerName": "荒泷一斗",
            "text": "哎哟，旅行者，派蒙，别来无恙啊！",
            "nextDialogs": [
              "722790402"
            ]
          },
          "722790402": {
            "id": "722790402",
            "speakerId": 1044,
            "speakerName": "荒泷一斗",
            "text": "原来你们也逛容彩祭，果然是同好啊，本大爷没有看错你们。",
            "nextDialogs": [
              "722790403"
            ]
          },
          "722790403": {
            "id": "722790403",
            "speakerId": 1044,
            "speakerName": "荒泷一斗",
            "text": "哈哈哈哈——！",
            "nextDialogs": [
              "722790404"
            ]
          },
          "722790404": {
            "id": "722790404",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "真是幼稚。",
            "nextDialogs": [
              "722790405"
            ]
          },
          "722790405": {
            "id": "722790405",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "我们可是来帮人解决问题的。",
            "nextDialogs": [
              "722790406"
            ]
          },
          "722790406": {
            "id": "722790406",
            "speakerId": 1044,
            "speakerName": "荒泷一斗",
            "text": "噢——原来如此。谁有问题需要我解决吗？我们荒泷派义不容辞！",
            "nextDialogs": [
              "722790409"
            ]
          },
          "722790409": {
            "id": "722790409",
            "speakerId": 1044,
            "speakerName": "荒泷一斗",
            "text": "欸？！",
            "nextDialogs": [
              "722790410"
            ]
          },
          "722790410": {
            "id": "722790410",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "你们荒泷派就是问题啦！",
            "nextDialogs": [
              "722790411"
            ]
          },
          "722790411": {
            "id": "722790411",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "天领奉行说你们霸占了这块公用的合影板，搞得其他人都没法用了。",
            "nextDialogs": [
              "722790412"
            ]
          },
          "722790412": {
            "id": "722790412",
            "speakerId": 1044,
            "speakerName": "荒泷一斗",
            "text": "啊…这个…这个…没有这回事吧…"
          }
        }
      }
    },
    {
      "subId": "7227916",
      "subQuestName": "与托马交谈",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [],
        "dialogs": {}
      }
    },
    {
      "subId": "7227920",
      "subQuestName": "",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "722792001"
        ],
        "dialogs": {
          "722792001": {
            "id": "722792001",
            "speakerId": 1033,
            "speakerName": "托马",
            "text": "志愿者的工作很简单，主要是帮助祭典上需要帮助的人们。",
            "nextDialogs": [
              "722792002"
            ]
          },
          "722792002": {
            "id": "722792002",
            "speakerId": 1033,
            "speakerName": "托马",
            "text": "我会把我这里已经收到的工作请求分发给你们。"
          }
        }
      }
    },
    {
      "subId": "7227917",
      "subQuestName": "",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "722791701"
        ],
        "dialogs": {
          "722791701": {
            "id": "722791701",
            "speakerId": 20566,
            "speakerName": "平泉",
            "text": "没想到这一次的容彩祭这么热闹…"
          }
        }
      }
    },
    {
      "subId": "7227912",
      "subQuestName": "",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "722791201"
        ],
        "dialogs": {
          "722791201": {
            "id": "722791201",
            "speakerId": 20568,
            "speakerName": "石田",
            "text": "这么快就清理完成了吗？真是麻烦你们了！",
            "nextDialogs": [
              "722791202"
            ]
          },
          "722791202": {
            "id": "722791202",
            "speakerId": 20568,
            "speakerName": "石田",
            "text": "你们这些志愿者真是热心肠，太感谢了。"
          }
        }
      }
    },
    {
      "subId": "7227904",
      "subQuestName": "帮助祭典的摊主",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "722790801"
        ],
        "dialogs": {
          "722790801": {
            "id": "722790801",
            "speakerId": 20568,
            "speakerName": "石田",
            "text": "是志愿者吗？你们来的太及时了。",
            "nextDialogs": [
              "722790802"
            ]
          },
          "722790802": {
            "id": "722790802",
            "speakerId": 20568,
            "speakerName": "石田",
            "text": "想必两位已经看见了吧，我的摊位附近积了很多落叶灰尘。",
            "nextDialogs": [
              "722790803"
            ]
          },
          "722790803": {
            "id": "722790803",
            "speakerId": 20568,
            "speakerName": "石田",
            "text": "主要是因为这几天的客人太多了，好几次想去打扫一下却都没时间…",
            "nextDialogs": [
              "722790804"
            ]
          },
          "722790804": {
            "id": "722790804",
            "speakerId": 20568,
            "speakerName": "石田",
            "text": "能请你们帮忙清扫一下吗？实在感谢！"
          }
        }
      }
    },
    {
      "subId": "7227905",
      "subQuestName": "帮忙清扫摊位附近",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [],
        "dialogs": {}
      }
    },
    {
      "subId": "7227918",
      "subQuestName": "帮忙清扫摊位附近",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "722791801"
        ],
        "dialogs": {
          "722791801": {
            "id": "722791801",
            "speakerId": 20569,
            "speakerName": "竹内",
            "text": "哎呀，你们就是那些热心的志愿者吧。",
            "nextDialogs": [
              "722791802"
            ]
          },
          "722791802": {
            "id": "722791802",
            "speakerId": 20569,
            "speakerName": "竹内",
            "text": "瞧你们累的，快把货物放下，先好好休息会吧。",
            "nextDialogs": [
              "722791803"
            ]
          },
          "722791803": {
            "id": "722791803",
            "speakerId": 20569,
            "speakerName": "竹内",
            "text": "听说社奉行安排了远航之风，要给你们这些志愿者准备特别饮料作为感谢呢。",
            "nextDialogs": [
              "722791804"
            ]
          },
          "722791804": {
            "id": "722791804",
            "speakerId": 20569,
            "speakerName": "竹内",
            "text": "嘿嘿，其实这些豆乳，就是饮料的原材料之一哦，每天现做，绝对新鲜！",
            "nextDialogs": [
              "722791805"
            ]
          },
          "722791805": {
            "id": "722791805",
            "speakerId": 20569,
            "speakerName": "竹内",
            "text": "说起来，上一批加工好的豆乳，刚刚已经送去那边了，要不了多久，你们就可以一饱口福啦。",
            "nextDialogs": [
              "722791806"
            ]
          },
          "722791806": {
            "id": "722791806",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "欸？！远航之风的特别饮料里…有豆乳！",
            "nextDialogs": [
              "722791807"
            ]
          },
          "722791807": {
            "id": "722791807",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "一斗那个家伙不能喝豆制品的吧！",
            "nextDialogs": [
              "722791808"
            ]
          },
          "722791808": {
            "id": "722791808",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "我们得快点去远航之风等着他…"
          }
        }
      }
    },
    {
      "subId": "7227906",

    {
      "subId": "7227909",
      "subQuestName": "前往远航之风",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [],
        "dialogs": {}
      }
    },
    {
      "subId": "7227910",
      "subQuestName": "与一斗交谈",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "722791001"
        ],
        "dialogs": {
          "722791001": {
            "id": "722791001",
            "speakerId": 1044,
            "speakerName": "荒泷一斗",
            "text": "哈哈哈哈哈——！你们终于到了？本大爷已经提前很久就完成了哦。",
            "nextDialogs": [
              "722791002"
            ]
          },
          "722791002": {
            "id": "722791002",
            "speakerId": 1044,
            "speakerName": "荒泷一斗",
            "text": "就算是志愿者这种活，本大爷果然也是战无不胜啊哈哈哈哈！",
            "nextDialogs": [
              "722791003"
            ]
          },
          "722791003": {
            "id": "722791003",
            "speakerId": 1044,
            "speakerName": "荒泷一斗",
            "text": "#{NICKNAME}，你输了哦。作为胜者的奖励，这杯特别饮料…",
            "nextDialogs": [
              "722791004"
            ]
          },
          "722791004": {
            "id": "722791004",
            "speakerId": 1044,
            "speakerName": "荒泷一斗",
            "text": "这杯远航之风与八重堂联名研发的、《拜托了我的狐仙宫司》里的无敌饮料！",
            "nextDialogs": [
              "722791005"
            ]
          },
          "722791005": {
            "id": "722791005",
            "speakerId": 1044,
            "speakerName": "荒泷一斗",
            "text": "本大爷就不客气地笑纳了！哈哈哈哈——！",
            "nextDialogs": [
              "722791006"
            ]
          },
          "722791006": {
            "id": "722791006",
            "speakerId": 1044,
            "speakerName": "荒泷一斗",
            "text": "饮料饮料，入我肚来！",
            "nextDialogs": [
              "722791009"
            ]
          },
          "722791009": {
            "id": "722791009",
            "speakerId": 1011,
            "speakerName": "Black Screen",
            "text": "咕嘟——嗨——一斗豪迈地举起饮料，一饮而尽。",
            "nextDialogs": [
              "722791010"
            ]
          },
          "722791010": {
            "id": "722791010",
            "speakerId": 1044,
            "speakerName": "荒泷一斗",
            "text": "呜哇哇哇哇嗷——好饮料！好饮料…",
            "nextDialogs": [
              "722791011"
            ]
          },
          "722791011": {
            "id": "722791011",
            "speakerId": 1044,
            "speakerName": "荒泷一斗",
            "text": "确实是好饮料…啧…就是怎么好像有点坏…",
            "nextDialogs": [
              "722791012"
            ]
          },
          "722791012": {
            "id": "722791012",
            "speakerId": 12278,
            "speakerName": "阿守",
            "text": "老大，他们说饮料里好像…",
            "nextDialogs": [
              "722791013"
            ]
          },
          "722791013": {
            "id": "722791013",
            "speakerId": 12276,
            "speakerName": "阿晃",
            "text": "好像有豆子！",
            "nextDialogs": [
              "722791014"
            ]
          },
          "722791014": {
            "id": "722791014",
            "speakerId": 1044,
            "speakerName": "荒泷一斗",
            "text": "哈？！",
            "nextDialogs": [
              "722791015"
            ]
          },
          "722791015": {
            "id": "722791015",
            "speakerId": 1011,
            "speakerName": "Black Screen",
            "text": "一个豪迈的身影重重摔倒。",
            "nextDialogs": [
              "722791016"
            ]
          },
          "722791016": {
            "id": "722791016",
            "speakerId": 12277,
            "speakerName": "元太",
            "text": "老大倒了！老大倒了！",
            "nextDialogs": [
              "722791017"
            ]
          },
          "722791017": {
            "id": "722791017",
            "speakerId": 12278,
            "speakerName": "阿守",
            "text": "快！快送去医生那里！",
            "nextDialogs": [
              "722791018"
            ]
          },
          "722791018": {
            "id": "722791018",
            "speakerId": 1033,
            "speakerName": "托马",
            "text": "怎么回事，荒泷一斗不能喝豆制品？",
            "nextDialogs": [
              "722791019"
            ]
          },
          "722791019": {
            "id": "722791019",
            "speakerId": 12276,
            "speakerName": "阿晃",
            "text": "老大他豆子过敏！",
            "nextDialogs": [
              "722791020"
            ]
          },
          "722791020": {
            "id": "722791020",
            "speakerId": 1033,
            "speakerName": "托马",
            "text": "居然还有这种事…先不管了！快，你们带上荒泷一斗跟我来，我来安排医生，希望不是大问题。",
            "nextDialogs": [
              "722791021"
            ]
          },
          "722791021": {
            "id": "722791021",
            "speakerId": 1033,
            "speakerName": "托马",
            "text": "#抱歉了，{NICKNAME}，没有考虑到这种事，真是我的疏忽。",
            "nextDialogs": [
              "722791022"
            ]
          },
          "722791022": {
            "id": "722791022",
            "speakerId": 1033,
            "speakerName": "托马",
            "text": "荒泷一斗就交给我吧，我保证会让他好好站起来。",
            "nextDialogs": [
              "722791023"
            ]
          },
          "722791023": {
            "id": "722791023",
            "speakerId": 1033,
            "speakerName": "托马",
            "text": "你放心吧，我们回头见。",
            "nextDialogs": [
              "722791024"
            ]
          },
          "722791024": {
            "id": "722791024",
            "speakerId": 3081,
            "speakerName": "卡琵莉亚",
            "text": "原来您的朋友豆子过敏，这种事虽然少见，但也确实听闻过。",
            "nextDialogs": [
              "722791025"
            ]
          },
          "722791025": {
            "id": "722791025",
            "speakerId": 3081,
            "speakerName": "卡琵莉亚",
            "text": "真抱歉小店的饮料造成了这种事情，实在有些过意不去。",
            "nextDialogs": [
              "722791026"
            ]
          },
          "722791026": {
            "id": "722791026",
            "speakerId": 3081,
            "speakerName": "卡琵莉亚",
            "text": "如果您不介意的话，希望您能收下这个。这是不含豆乳的特别饮料配方。",
            "nextDialogs": [
              "722791027"
            ]
          },
          "722791027": {
            "id": "722791027",
            "speakerId": 3081,
            "speakerName": "卡琵莉亚",
            "text": "看得出来，您的朋友很喜欢这款饮料，虽然去掉豆乳，口感会有一些变化，但相信更适合您的朋友。",
            "nextDialogs": [
              "722791028"
            ]
          },
          "722791028": {
            "id": "722791028",
            "speakerId": 3081,
            "speakerName": "卡琵莉亚",
            "text": "请一定要收下，这是小店的一点心意。"
          }
        }
      }
    },
    {

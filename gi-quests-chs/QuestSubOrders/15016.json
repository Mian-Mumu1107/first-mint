      }
    },
    {
      "subId": "1501601",
      "subQuestName": "前往希诺宁的工坊拜访",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "150160101"
        ],
        "dialogs": {
          "150160101": {
            "id": "150160101",
            "speakerId": 1095,
            "speakerName": "希诺宁",
            "text": "噢，你们来了啊，事情都处理完了。我正打算去休息呢。",
            "nextDialogs": [
              "150160102"
            ]
          },
          "150160102": {
            "id": "150160102",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "特拉佐莉会受到什么处罚？",
            "nextDialogs": [
              "150160103"
            ]
          },
          "150160103": {
            "id": "150160103",
            "speakerId": 1095,
            "speakerName": "希诺宁",
            "text": "部族里还在商量着呢，用古名技术来犯罪的人，古往今来也没多少…帕加尔可要头疼一阵了。",
            "nextDialogs": [
              "150160104"
            ]
          },
          "150160104": {
            "id": "150160104",
            "speakerId": 1095,
            "speakerName": "希诺宁",
            "text": "能够确定的是，特拉佐莉的工坊会被完全封闭，剩余那些未成型的「燃晶名刻」也会彻底销毁。",
            "nextDialogs": [
              "150160105"
            ]
          },
          "150160105": {
            "id": "150160105",
            "speakerId": 1095,
            "speakerName": "希诺宁",
            "text": "至于那些已经成型的「燃晶名刻」，我会接手处理。唉，又是个麻烦的工作…",
            "nextDialogs": [
              "150160106"
            ]
          },
          "150160106": {
            "id": "150160106",
            "speakerId": 1095,
            "speakerName": "希诺宁",
            "text": "无论如何，至少她的「古名」没出问题，不然乱子可就大了…",
            "nextDialogs": [
              "150160107"
            ]
          },
          "150160107": {
            "id": "150160107",
            "speakerId": 1095,
            "speakerName": "希诺宁",
            "text": "噢，说到古名。倒是有个好消息。「燃晶名刻」所汲取的记忆是可恢复的。",
            "nextDialogs": [
              "150160108"
            ]
          },
          "150160108": {
            "id": "150160108",
            "speakerId": 1095,
            "speakerName": "希诺宁",
            "text": "等到所有「燃晶名刻」都停止工作后，那些回忆应该就会顺着原路，物归原主了。",
            "nextDialogs": [
              "150160111"
            ]
          },
          "150160111": {
            "id": "150160111",
            "speakerId": 1095,
            "speakerName": "希诺宁",
            "text": "是啊。这么一想…婶婶想要妮赫佳回来，所以让整个部族的人都忘记了妮赫佳。",
            "nextDialogs": [
              "150160112"
            ]
          },
          "150160112": {
            "id": "150160112",
            "speakerId": 1095,
            "speakerName": "希诺宁",
            "text": "现在妮赫佳真的离开了，大家却又即将想起她…真是乱七八糟。",
            "nextDialogs": [
              "150160113"
            ]
          },
          "150160113": {
            "id": "150160113",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "妮佩卡现在的情况还好吗？",
            "nextDialogs": [
              "150160114"
            ]
          },
          "150160114": {
            "id": "150160114",
            "speakerId": 1095,
            "speakerName": "希诺宁",
            "text": "她正在我的工坊里休息呢，我已经联系了同族的人，准备正式查一查这孩子的身世。",
            "nextDialogs": [
              "150160115"
            ]
          },
          "150160115": {
            "id": "150160115",
            "speakerId": 1095,
            "speakerName": "希诺宁",
            "text": "现在族里还没给我回信，所以我就打算先照顾着她，顺便教她点手艺。",
            "nextDialogs": [
              "150160116"
            ]
          },
          "150160116": {
            "id": "150160116",
            "speakerId": 1095,
            "speakerName": "希诺宁",
            "text": "这都是后话了。现在就让妮佩卡好好睡一觉吧。",
            "nextDialogs": [
              "150160117"
            ]
          },
          "150160117": {
            "id": "150160117",
            "speakerId": 1095,
            "speakerName": "希诺宁",
            "text": "只有睡饱了，才有精力面对这么多麻烦。"
          }
        }
      }
    }
  ]
}
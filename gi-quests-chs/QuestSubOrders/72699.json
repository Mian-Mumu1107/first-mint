  "subQuests": [
    {
      "subId": "7269901",
      "subQuestName": "与安彦太郎对话",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "726990101"
        ],
        "dialogs": {
          "726990101": {
            "id": "726990101",
            "speakerId": 30167,
            "speakerName": "安彦太郎",
            "text": "不知阁下的剑技到底水平如何，这一战我非常期待。",
            "nextDialogs": [
              "726990102"
            ]
          },
          "726990102": {
            "id": "726990102",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "你怎么也…",
            "nextDialogs": [
              "726990103"
            ]
          },
          "726990103": {
            "id": "726990103",
            "speakerId": 30167,
            "speakerName": "安彦太郎",
            "text": "其实，我之前说有四位武者，是把自己也算在其中了。",
            "nextDialogs": [
              "726990104"
            ]
          },
          "726990104": {
            "id": "726990104",
            "speakerId": 30167,
            "speakerName": "安彦太郎",
            "text": "虽说我是这场决斗的主办人，但无奈参与者实在太少…",
            "nextDialogs": [
              "726990105"
            ]
          },
          "726990105": {
            "id": "726990105",
            "speakerId": 30167,
            "speakerName": "安彦太郎",
            "text": "更何况，此身为战斗而生，既然遇到了强大的对手，就没有不与对方一战的道理！",
            "nextDialogs": [
              "726990106"
            ]
          },
          "726990106": {
            "id": "726990106",
            "speakerId": 30167,
            "speakerName": "安彦太郎",
            "text": "哈哈，我想说这句台词很久了！",
            "nextDialogs": [
              "726990107"
            ]
          },
          "726990107": {
            "id": "726990107",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "喂，这人到底行不行啊！",
            "nextDialogs": [
              "726990108"
            ]
          },
          "726990108": {
            "id": "726990108",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "不能轻敌。",
            "nextDialogs": [
              "726990109"
            ]
          },
          "726990109": {
            "id": "726990109",
            "speakerId": 30167,
            "speakerName": "安彦太郎",
            "text": "说得好！阁下这种对所有对手一视同仁的态度，让我肃然起敬。",
            "nextDialogs": [
              "726990110"
            ]
          },
          "726990110": {
            "id": "726990110",
            "speakerId": 30167,
            "speakerName": "安彦太郎",
            "text": "之前，如果不是因为我以貌取人，看轻了第四位武者，那场战斗也不会输得那么惨。",
            "nextDialogs": [
              "726990111"
            ]
          },
          "726990111": {
            "id": "726990111",
            "speakerId": 30167,
            "speakerName": "安彦太郎",
            "text": "#不过现在，我已经不是当时的我了！那么，{NICKNAME}，开始比试吧！",
            "nextDialogs": [
              "726990115",
              "726990113"
            ]
          },
          "726990115": {
            "id": "726990115",
            "speakerId": 30167,
            "speakerName": "安彦太郎",
            "text": "来吧。"
          },
          "726990113": {
            "id": "726990113",
            "speakerId": 30167,
            "speakerName": "安彦太郎",
            "text": "我明白了，阁下先准备就是。"
          }
        }
      }
    }
  ]
}
  },
  "subQuests": [
    {
      "subId": "102001",
      "subQuestName": "前往天衡山",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "10200101"
        ],
        "dialogs": {
          "10200101": {
            "id": "10200101",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "看！天上那个就是「群玉阁」了。",
            "nextDialogs": [
              "10200104"
            ]
          },
          "10200104": {
            "id": "10200104",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "唔…唔…",
            "nextDialogs": [
              "10200105"
            ]
          },
          "10200105": {
            "id": "10200105",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "失策了！作为向导的我，好像并不知道通往「天上」的路在哪里…"
          }
        }
      }
    },
    {
      "subId": "102002",
      "subQuestName": "寻找前往群玉阁的方法",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "10200201"
        ],
        "dialogs": {
          "10200201": {
            "id": "10200201",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "快看，这里有机关！",
            "nextDialogs": [
              "10200202"
            ]
          },
          "10200202": {
            "id": "10200202",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "既然出现在对应的位置，那肯定是跟群玉阁有关。",
            "nextDialogs": [
              "10200204",
              "10200206"
            ]
          },
          "10200204": {
            "id": "10200204",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "错不了！"
          },
          "10200206": {
            "id": "10200206",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "怎么会？要相信我的直觉！"
          }
        }
      }
    },
    {
      "subId": "102003",
      "subQuestName": "尝试操控机关",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [],
        "dialogs": {}
      }
    },
    {
      "subId": "102007",
      "subQuestName": "(test)派蒙对话$HIDDEN",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "10200701"
        ],
        "dialogs": {
          "10200701": {
            "id": "10200701",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "哎哎？只能飞到这里…",
            "nextDialogs": [
              "10200702"
            ]
          },
          "10200702": {
            "id": "10200702",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "都怪风场不够厉害，不然就能直接上到顶啦！",
            "nextDialogs": [
              "10200703"
            ]
          },
          "10200703": {
            "id": "10200703",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "回璃月港吧…找千岩军打听一下。",
            "nextDialogs": [
              "10200704"
            ]
          },
          "10200704": {
            "id": "10200704",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "嗯？为什么？",
            "nextDialogs": [
              "10200705"
            ]
          },
          "10200705": {
            "id": "10200705",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "上去的方法应该不是秘密，否则…",
            "nextDialogs": [
              "10200706"
            ]
          },
          "10200706": {
            "id": "10200706",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "否则？…喔，我明白了，否则甘雨让我们自己拜访群玉阁，就说不通了，对吧？",
            "nextDialogs": [
              "10200707"
            ]
          },
          "10200707": {
            "id": "10200707",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "好吧，那就按你说的办吧，我们…",
            "nextDialogs": [
              "10200708"
            ]
          },
          "10200708": {
            "id": "10200708",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "啊！先等一等，你看下面。",
            "nextDialogs": [
              "10200709"
            ]
          },
          "10200709": {
            "id": "10200709",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "原来我们已经走到<color=#00E1FFFF>「归终机」</color>附近了呀。",
            "nextDialogs": [
              "10200710"
            ]
          },
          "10200710": {
            "id": "10200710",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "这样的话…唔…我有个新点子！",
            "nextDialogs": [
              "10200711"
            ]
          },
          "10200711": {
            "id": "10200711",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "——不如，用「归终机」把你发射上去吧？",
            "nextDialogs": [
              "10200713",
              "10200715"
            ]
          },
          "10200713": {
            "id": "10200713",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "唔呃…这么说来，确实没有考虑到安全细节…",
            "nextDialogs": [
              "10200716"
            ]
          },
          "10200716": {
            "id": "10200716",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "不过我记得，归终机有望远的功能。",
            "nextDialogs": [
              "10200717"
            ]
          },
          "10200717": {
            "id": "10200717",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "啊，对哦！",
            "nextDialogs": [
              "10200718"
            ]
          },
          "10200718": {
            "id": "10200718",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "这么说来，确实可以利用…那就靠归终机来找找看，附近还有没有上去的路吧！"
          },
          "10200715": {
            "id": "10200715",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "唔呃…只是没有考虑到安全细节而已…"
          }
        }
      }
    },
    {
      "subId": "102004",
      "subQuestName": "前往归终机附近",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "10200401"
        ],
        "dialogs": {
          "10200401": {
            "id": "10200401",
            "speakerId": 1001,
            "speakerName": "华清",
            "text": "站住！",
            "nextDialogs": [
              "10200402"
            ]
          },
          "10200402": {
            "id": "10200402",
            "speakerId": 1001,
            "speakerName": "华清",
            "text": "什么人，竟敢私闯重地！",
            "nextDialogs": [
              "10200405"
            ]
          },
          "10200405": {
            "id": "10200405",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "是啊是啊，真不懂你们在说什么！",
            "nextDialogs": [
              "10200406"
            ]
          },
          "10200406": {
            "id": "10200406",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "我们是受邀来这里的，是贵客！凭什么这样对我们…",
            "nextDialogs": [
              "10200407"
            ]
          },
          "10200407": {
            "id": "10200407",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "不…等一下…难道凝光…她是故意的！",
            "nextDialogs": [
              "10200408"
            ]
          },
          "10200408": {
            "id": "10200408",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "她假装请我们上群玉阁，其实在这里埋伏了千岩军，想要把我们抓起来！"
          }
        }
      }
    },
    {
      "subId": "102005",
      "subQuestName": "与千岩军战斗",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [],
        "dialogs": {}
      }
    },
    {
      "subId": "102006",
      "subQuestName": "(test)战斗后对话$HIDDEN",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "10200601"
        ],
        "dialogs": {
          "10200601": {
            "id": "10200601",
            "speakerId": 1002,
            "speakerName": "？？？",
            "text": "住手！何事喧哗？",
            "nextDialogs": [
              "10200602"
            ]
          },
          "10200602": {
            "id": "10200602",
            "speakerId": 1001,
            "speakerName": "华清",
            "text": "刻晴大人，这两个怪人突然出现，似乎对归终机有所图谋。",
            "nextDialogs": [
              "10200603"
            ]
          },
          "10200603": {
            "id": "10200603",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "你、你说谁是怪人！",
            "nextDialogs": [
              "10200604"
            ]
          },
          "10200604": {
            "id": "10200604",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "我只是在找前往群玉阁的路。",
            "nextDialogs": [
              "10200605"
            ]
          },
          "10200605": {
            "id": "10200605",
            "speakerId": 1003,
            "speakerName": "刻晴",
            "text": "嗯？你们要上「群玉阁」？你们是谁？",
            "nextDialogs": [
              "10200606"
            ]
          },
          "10200606": {
            "id": "10200606",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "我们是受邀请的客人，想找「璃月七星」！你又是谁呀？",
            "nextDialogs": [
              "10200607"
            ]
          },
          "10200607": {
            "id": "10200607",
            "speakerId": 1003,
            "speakerName": "刻晴",
            "text": "……",
            "nextDialogs": [
              "10200608"
            ]
          },
          "10200608": {
            "id": "10200608",
            "speakerId": 1003,
            "speakerName": "刻晴",
            "text": "真巧，我就是「璃月七星」。",
            "nextDialogs": [
              "10200609"
            ]
          },
          "10200609": {
            "id": "10200609",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "？？？",
            "nextDialogs": [
              "10200610"
            ]
          },
          "10200610": {
            "id": "10200610",
            "speakerId": 1003,
            "speakerName": "刻晴",
            "text": "我是刻晴，璃月七星之一的「玉衡星」。",
            "nextDialogs": [
              "10200611"
            ]
          },
          "10200611": {
            "id": "10200611",
            "speakerId": 1003,
            "speakerName": "刻晴",
            "text": "我知道你的事，旅行者，你是凝光的客人吧？没想到会在山间偶遇。",
            "nextDialogs": [
              "10200612"
            ]
          },
          "10200612": {
            "id": "10200612",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "哇——我也没想到会在荒郊野岭遇见有钱的大人物。",
            "nextDialogs": [
              "10200613"
            ]
          },
          "10200613": {
            "id": "10200613",
            "speakerId": 1003,
            "speakerName": "刻晴",
            "text": "天衡古城垣的归终机损坏，却在一夜之间修复完好。我在这里，原本是想调查一番。",
            "nextDialogs": [
              "10200614"
            ]
          },
          "10200614": {
            "id": "10200614",
            "speakerId": 1003,
            "speakerName": "刻晴",
            "text": "这些千岩军只是负责守卫现场，不是来抓人的。",
            "nextDialogs": [
              "10200615"
            ]
          },
          "10200615": {
            "id": "10200615",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "原来是误会啊？嗯…真是完全没想到。",
            "nextDialogs": [
              "10200616"
            ]
          },
          "10200616": {
            "id": "10200616",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "还是很容易想到的。",
            "nextDialogs": [
              "10200617"
            ]
          },
          "10200617": {
            "id": "10200617",
            "speakerId": 1003,
            "speakerName": "刻晴",
            "text": "话说回来，仙人所造的机关，居然有凡人能修好。这即使对「七星」来说，也算一件奇事。",
            "nextDialogs": [
              "10200618"
            ]
          },
          "10200618": {
            "id": "10200618",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "嘿嘿，那个是…",
            "nextDialogs": [
              "10200621"
            ]
          },
          "10200621": {
            "id": "10200621",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "咦？啊，哦…对了，这位「玉衡」大人，你知道「天权」大人为什么要邀请我们去群玉阁吗？",
            "nextDialogs": [
              "10200622"
            ]
          },
          "10200622": {
            "id": "10200622",
            "speakerId": 1003,
            "speakerName": "刻晴",
            "text": "叫我刻晴就好。",
            "nextDialogs": [
              "10200623"
            ]
          },
          "10200623": {
            "id": "10200623",
            "speakerId": 1003,
            "speakerName": "刻晴",
            "text": "凝光约你见面，我想，无非是希望「拯救蒙德的英雄」中立一些。至少…不要完全站在仙人一方。",
            "nextDialogs": [
              "10200624"
            ]
          },
          "10200624": {
            "id": "10200624",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "我们可没有站边！我们和那些仙人聊过，他们也是准备庇佑璃月的…",
            "nextDialogs": [
              "10200625"
            ]
          },
          "10200625": {
            "id": "10200625",
            "speakerId": 1003,
            "speakerName": "刻晴",
            "text": "你说的「庇佑」，就是指那种居高临下的傲慢吗？",
            "nextDialogs": [
              "10200626"
            ]
          },
          "10200626": {
            "id": "10200626",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "欸？",
            "nextDialogs": [
              "10200627"
            ]
          },
          "10200627": {
            "id": "10200627",
            "speakerId": 1003,
            "speakerName": "刻晴",
            "text": "因为你们是凡民，是他们庇佑的对象，所以他们不会把你当做「有能力刺杀神明的刺客」。",
            "nextDialogs": [
              "10200628"
            ]
          },
          "10200628": {
            "id": "10200628",
            "speakerId": 1003,
            "speakerName": "刻晴",
            "text": "所以他们一定也觉得，凝光封锁现场、盘问凡民、追捕刺客…这些命令全都是无用功，甚至是在掩盖什么。",
            "nextDialogs": [
              "10200629"
            ]
          },
          "10200629": {
            "id": "10200629",
            "speakerId": 1003,
            "speakerName": "刻晴",
            "text": "我直说了吧：这是在小看人。",
            "nextDialogs": [
              "10200630"
            ]
          },
          "10200630": {
            "id": "10200630",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "你这么说，确实也有点道理…",
            "nextDialogs": [
              "10200631"
            ]
          },
          "10200631": {
            "id": "10200631",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "不过，像你这样「不敬仙神」的璃月人，我还是第一次遇见呢。",
            "nextDialogs": [
              "10200632"
            ]
          },
          "10200632": {
            "id": "10200632",
            "speakerId": 1003,
            "speakerName": "刻晴",
            "text": "哈…我是要敬他们时间观念淡薄，又对凡人心存傲慢，所以暂时还不会对我们「七星」出手吗？",
            "nextDialogs": [
              "10200633"
            ]
          },
          "10200633": {
            "id": "10200633",
            "speakerId": 1003,
            "speakerName": "刻晴",
            "text": "算了，我不该这样谈论仙人。「不敬仙神」只是我个人的态度，凝光就绝对不会说这种话。",
            "nextDialogs": [
              "10200634"
            ]
          },
          "10200634": {
            "id": "10200634",
            "speakerId": 1003,
            "speakerName": "刻晴",
            "text": "总之，我也承认，这一次仙人们的行事，已经足够克制。",
            "nextDialogs": [
              "10200635"
            ]
          },
          "10200635": {
            "id": "10200635",
            "speakerId": 1003,
            "speakerName": "刻晴",
            "text": "帝君遇害，实在非比寻常。面对如此超出常理的事态，他们仍然愿意召集众仙商议、没有直接打来…",
            "nextDialogs": [
              "10200636"
            ]
          },
          "10200636": {
            "id": "10200636",
            "speakerId": 1003,
            "speakerName": "刻晴",
            "text": "这还挺文明的，真叫人意外。"
          }
        }
      }
    }
  ]
}
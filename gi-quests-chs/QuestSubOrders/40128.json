    {
      "subId": "4012805",
      "subQuestName": "返回营地",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "401280501"
        ],
        "dialogs": {
          "401280501": {
            "id": "401280501",
            "speakerId": 1006,
            "speakerName": "祖莉亚·德斯特雷",
            "text": "♪♫♪~",
            "nextDialogs": [
              "401280502"
            ]
          },
          "401280502": {
            "id": "401280502",
            "speakerId": 1006,
            "speakerName": "祖莉亚·德斯特雷",
            "text": "呀，菲米尼先生，你回来了，我就猜到你去水下了。",
            "nextDialogs": [
              "401280503"
            ]
          },
          "401280503": {
            "id": "401280503",
            "speakerId": 1005,
            "speakerName": "菲米尼",
            "text": "祖莉亚·德斯特雷夫人，抱歉，久等了吧？「特尔克西」的进度很顺利。",
            "nextDialogs": [
              "401280504"
            ]
          },
          "401280504": {
            "id": "401280504",
            "speakerId": 1006,
            "speakerName": "祖莉亚·德斯特雷",
            "text": "不用着急，我只是雇主，可不是监工。说起来…这两位是？",
            "nextDialogs": [
              "401280505"
            ]
          },
          "401280505": {
            "id": "401280505",
            "speakerId": 1005,
            "speakerName": "菲米尼",
            "text": "#{M#他们}{F#她们}…{M#他们}{F#她们}是信得过的伙伴，是来帮忙的。",
            "nextDialogs": [
              "401280506"
            ]
          },
          "401280506": {
            "id": "401280506",
            "speakerId": 1006,
            "speakerName": "祖莉亚·德斯特雷",
            "text": "嗯，看得出来，可靠的人身边通常也会是可靠的人。",
            "nextDialogs": [
              "401280507"
            ]
          },
          "401280507": {
            "id": "401280507",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "#祖莉亚·德斯特雷夫人你好！你就是菲米尼的雇主吗？我是派蒙，这位是{NICKNAME}。",
            "nextDialogs": [
              "401280508"
            ]
          },
          "401280508": {
            "id": "401280508",
            "speakerId": 1006,
            "speakerName": "祖莉亚·德斯特雷",
            "text": "你们好，这位大朋友和小朋友，你们两个真可爱，像屋檐下的小精灵。你们可以直接叫我的名字。",
            "nextDialogs": [
              "401280509"
            ]
          },
          "401280509": {
            "id": "401280509",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "欸嘿嘿，真的吗？",
            "nextDialogs": [
              "401280510"
            ]
          },
          "401280510": {
            "id": "401280510",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "我也像精灵吗？",
            "nextDialogs": [
              "401280511"
            ]
          },
          "401280511": {
            "id": "401280511",
            "speakerId": 1006,
            "speakerName": "祖莉亚·德斯特雷",
            "text": "当然，如果我的孩子有你们这样的朋友，也许就不会沉迷在水妖的故事里，我也就不用麻烦菲米尼先生了。",
            "nextDialogs": [
              "401280512"
            ]
          },
          "401280512": {
            "id": "401280512",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "沉迷在水妖的故事里？",
            "nextDialogs": [
              "401280513"
            ]
          },
          "401280513": {
            "id": "401280513",
            "speakerId": 1006,
            "speakerName": "祖莉亚·德斯特雷",
            "text": "你们还不知道我的事吗？我以为菲米尼先生已经告诉你们了。",
            "nextDialogs": [
              "401280514"
            ]
          },
          "401280514": {
            "id": "401280514",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "菲米尼说啦，那是夫人的隐私，不能随便透露详情。",
            "nextDialogs": [
              "401280515"
            ]
          },
          "401280515": {
            "id": "401280515",
            "speakerId": 1006,
            "speakerName": "祖莉亚·德斯特雷",
            "text": "原来如此，菲米尼先生比想象中还让人放心呢。我觉得，既然两位是这次的帮手，让你们了解详情，会对之后的进程更有益处。",
            "nextDialogs": [
              "401280516"
            ]
          },
          "401280516": {
            "id": "401280516",
            "speakerId": 1006,
            "speakerName": "祖莉亚·德斯特雷",
            "text": "不过未经允许就向他人大倒苦水，实在有些失礼。所以…不知道两位愿不愿意听呢？",
            "nextDialogs": [
              "401280517"
            ]
          },
          "401280517": {
            "id": "401280517",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "祖莉亚夫人，如果有事让你烦闷就尽管说出来吧。你都夸我们可爱啦，我们也会想办法为你排忧解难的！",
            "nextDialogs": [
              "401280518"
            ]
          },
          "401280518": {
            "id": "401280518",
            "speakerId": 1006,
            "speakerName": "祖莉亚·德斯特雷",
            "text": "真是让人喜爱的小精灵啊，那让我想想该怎么说吧。嗯…你们应该都已经知道水妖的故事了吧？",
            "nextDialogs": [
              "401280519"
            ]
          },
          "401280519": {
            "id": "401280519",
            "speakerId": 1006,
            "speakerName": "祖莉亚·德斯特雷",
            "text": "为了让孩子呆在安全的地方，大人编出了去水边会被水妖抓走的说法。但我家孩子很特别，别人害怕的特尔克西，他却很迷恋。",
            "nextDialogs": [
              "401280520"
            ]
          },
          "401280520": {
            "id": "401280520",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "迷…迷恋水妖？好强大！",
            "nextDialogs": [
              "401280521"
            ]
          },
          "401280521": {
            "id": "401280521",
            "speakerId": 1006,
            "speakerName": "祖莉亚·德斯特雷",
            "text": "嗯，他曾告诉我，也许大家都对水妖有误解，水妖只是感到孤独，所以才想唱歌给孩子们听。为此，他常偷偷独自跑去水边。",
            "nextDialogs": [
              "401280522"
            ]
          },
          "401280522": {
            "id": "401280522",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "是觉得水妖孤独，所以要去和水妖做朋友吗？真是与众不同的想法！",
            "nextDialogs": [
              "401280523"
            ]
          },
          "401280523": {
            "id": "401280523",
            "speakerId": 1006,
            "speakerName": "祖莉亚·德斯特雷",
            "text": "谢谢你，小派蒙，他确实与众不同，所以才八岁就确诊了孤独病…",
            "nextDialogs": [
              "401280524"
            ]
          },
          "401280524": {
            "id": "401280524",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "孤独病？",
            "nextDialogs": [
              "401280525"
            ]
          },
          "401280525": {
            "id": "401280525",
            "speakerId": 1006,
            "speakerName": "祖莉亚·德斯特雷",
            "text": "嗯，一种心理疾病，病人时常会感到深深的孤独，对很多事也失去了兴趣。也许就是因为这个，他才想和水妖做朋友。",
            "nextDialogs": [
              "401280526"
            ]
          },
          "401280526": {
            "id": "401280526",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "怎么会…那这种病严重吗？",
            "nextDialogs": [
              "401280527"
            ]
          },
          "401280527": {
            "id": "401280527",
            "speakerId": 1005,
            "speakerName": "菲米尼",
            "text": "#假如派蒙一天能和{NICKNAME}说一千句话，得病后大概就只能说一两句了。",
            "nextDialogs": [
              "401280528"
            ]
          },
          "401280528": {
            "id": "401280528",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "#那怎么行？快让医生把这种病赶走啦！我一天至少要和{NICKNAME}说两千句话，少一句都不行！",
            "nextDialogs": [
              "401280529"
            ]
          },
          "401280529": {
            "id": "401280529",
            "speakerId": 1006,
            "speakerName": "祖莉亚·德斯特雷",
            "text": "嗯，我的家庭医生已经介入了，但因为病例不多，所以一直没有很好的治疗方案。最近他还出现了新的症状…比如失控性幻想。",
            "nextDialogs": [
              "401280530"
            ]
          },
          "401280530": {
            "id": "401280530",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "什么什么？",
            "nextDialogs": [
              "401280531"
            ]
          },
          "401280531": {
            "id": "401280531",
            "speakerId": 1005,
            "speakerName": "菲米尼",
            "text": "失控性，幻想。就是指控制不住地沉迷幻想与幻觉，混淆现实…",
            "nextDialogs": [
              "401280532"
            ]
          },
          "401280532": {
            "id": "401280532",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "那…那他在幻想什么？",
            "nextDialogs": [
              "401280533"
            ]
          },
          "401280533": {
            "id": "401280533",
            "speakerId": 1006,
            "speakerName": "祖莉亚·德斯特雷",
            "text": "一个他小时常跟我提起的梦，我把他最近断断续续的呓语记录了下来，是这样子的…",
            "nextDialogs": [
              "401280534"
            ]
          },
          "401280534": {
            "id": "401280534",
            "speakerId": 1003,
            "speakerName": "Black Screen",
            "text": "曾经，在塞洛海原五百尺深的水下，有一个盛大又华丽的水妖王国。",
            "nextDialogs": [
              "401280571"
            ]
          },
          "401280571": {
            "id": "401280571",
            "speakerId": 1003,
            "speakerName": "Black Screen",
            "text": "那儿生活着数不清的可爱水妖，它们住在由七彩贝壳与珊瑚建造的房子里，白天辛勤地照看海兽，夜里就穿梭在金色的水草间歌唱…",
            "nextDialogs": [
              "401280572"
            ]
          },
          "401280572": {
            "id": "401280572",
            "speakerId": 1003,
            "speakerName": "Black Screen",
            "text": "它们就这么幸福地生活着，直到彩虹巡礼日的来临，那是新王降临的重要节日。"
          }
        }
      }
    },
    {
      "subId": "4012806",
      "subQuestName": "与菲米尼对话",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "401280601"
        ],
        "dialogs": {
          "401280601": {
            "id": "401280601",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "怎么了菲米尼？你想说什么？",
            "nextDialogs": [
              "401280602"
            ]
          },
          "401280602": {
            "id": "401280602",
            "speakerId": 1005,
            "speakerName": "菲米尼",
            "text": "咳…如果可以的话，我希望，你们能够做些心理准备…",
            "nextDialogs": [
              "401280603"
            ]
          },
          "401280603": {
            "id": "401280603",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "什么心理准备？",
            "nextDialogs": [
              "401280604"
            ]
          },
          "401280604": {
            "id": "401280604",
            "speakerId": 1005,
            "speakerName": "菲米尼",
            "text": "#{NICKNAME}，你应该还是第一次碰见这种病人吧？我知道你非常强大，也一定会全心帮忙，但是这种病，万一…",
            "nextDialogs": [
              "401280605"
            ]
          },
          "401280605": {
            "id": "401280605",
            "speakerId": 1005,
            "speakerName": "菲米尼",
            "text": "万一结果不是我们想要的…我希望你也能接受，不要责怪自己…",
            "nextDialogs": [
              "401280606"
            ]
          },
          "401280606": {
            "id": "401280606",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "菲米尼，你怎么突然说这些，不是刚刚答应了祖莉亚夫人要乐观吗？",
            "nextDialogs": [
              "401280607"
            ]
          },
          "401280607": {
            "id": "401280607",
            "speakerId": 1005,
            "speakerName": "菲米尼",
            "text": "我不是不乐观…只是…",
            "nextDialogs": [
              "401280608"
            ]
          },
          "401280608": {
            "id": "401280608",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "你很了解这种病人？",
            "nextDialogs": [
              "401280609"
            ]
          },
          "401280609": {
            "id": "401280609",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "你刚才就一副「我都清楚」的模样…啊！该不会，你也…",
            "nextDialogs": [
              "401280610"
            ]
          },
          "401280610": {
            "id": "401280610",
            "speakerId": 1005,
            "speakerName": "菲米尼",
            "text": "不不…别误会，我没有，我只是…只是曾见过一些，在壁炉之家，前任院长的时期。",
            "nextDialogs": [
              "401280611"
            ]
          },
          "401280611": {
            "id": "401280611",
            "speakerId": 1005,
            "speakerName": "菲米尼",
            "text": "他们说，这种病的成因很复杂，什么说法都有，遗传、心理、环境，甚至还有说地脉紊乱影响的，说魔神残渣影响的…",
            "nextDialogs": [
              "401280612"
            ]
          },
          "401280612": {
            "id": "401280612",
            "speakerId": 1005,
            "speakerName": "菲米尼",
            "text": "在我所知的病例中，能称为好结局的…并不多。最坏的情况，甚至病人会…会离开我们。",
            "nextDialogs": [
              "401280613"
            ]
          },
          "401280613": {
            "id": "401280613",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "啊？居然严重到那种程度吗？我还以为最多也就是不讲话…",
            "nextDialogs": [
              "401280614"
            ]
          },
          "401280614": {
            "id": "401280614",
            "speakerId": 1005,
            "speakerName": "菲米尼",
            "text": "嗯，所以，要是你们不能接受坏的结果，我宁愿你们现在就停下…我不希望你们因此而难受…",
            "nextDialogs": [
              "401280616",
              "401280618"
            ]
          },
          "401280616": {
            "id": "401280616",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "对对对！我也是跟着这位见过大风大浪的人见过了很多大风大浪哦，无论遇到什么困难，我们都不会害怕！",
            "nextDialogs": [
              "401280619"
            ]
          },
          "401280619": {
            "id": "401280619",
            "speakerId": 1005,
            "speakerName": "菲米尼",
            "text": "…这样么，明白了，那我们就一起完成这次真实的幻想历险吧。",
            "nextDialogs": [
              "401280620"
            ]
          },
          "401280620": {
            "id": "401280620",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "好！不过我刚才就想问，既然这种病这么麻烦，那你觉得这个办法真的会有用吗？",
            "nextDialogs": [
              "401280621"
            ]
          },
          "401280621": {
            "id": "401280621",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "做一个玩具，把它当做「特尔克西」；找一座遗迹，说它是「水妖王国」，然后把这段历险画成绘本给病人看…",
            "nextDialogs": [
              "401280622"
            ]
          },
          "401280622": {
            "id": "401280622",
            "speakerId": 1005,
            "speakerName": "菲米尼",
            "text": "我想…会有用的。那孩子产生了幻想，就代表他想要挽救自己，只是他无力控制，才任由内心的王国崩塌。",
            "nextDialogs": [
              "401280623"
            ]
          },
          "401280623": {
            "id": "401280623",
            "speakerId": 1005,
            "speakerName": "菲米尼",
            "text": "但如果我们帮他控制幻想，帮他从黑暗中逃脱，就像帮失语者重新说话那样，我相信事情就会不一样…",
            "nextDialogs": [
              "401280624"
            ]
          },
          "401280624": {
            "id": "401280624",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "这么说好像也有点道理…菲米尼，你怎么会想到这个的？",
            "nextDialogs": [
              "401280625"
            ]
          },
          "401280625": {
            "id": "401280625",
            "speakerId": 1005,
            "speakerName": "菲米尼",
            "text": "可能…可能因为我也幻想过，就像那孩子的童话世界一样，而且我从中得到了很多帮助，所以我相信幻想的力量。",
            "nextDialogs": [
              "401280626"
            ]
          },
          "401280626": {
            "id": "401280626",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "是你前面说的那个企鹅小镇？",
            "nextDialogs": [
              "401280627"
            ]
          },
          "401280627": {
            "id": "401280627",
            "speakerId": 1005,
            "speakerName": "菲米尼",
            "text": "#唔…{NICKNAME}，你记住了啊…",
            "nextDialogs": [
              "401280628"
            ]
          },
          "401280628": {
            "id": "401280628",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "什么企鹅小镇？我怎么不记得啦…也是个童话世界吗？快给我说说！",
            "nextDialogs": [
              "401280629"
            ]
          },
          "401280629": {
            "id": "401280629",
            "speakerId": 1003,
            "speakerName": "Black Screen",
            "text": "突然，菲米尼拿出了一个潜水头盔带上了。",
            "nextDialogs": [
              "401280630"
            ]
          },
          "401280630": {
            "id": "401280630",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "喂喂，为什么突然戴上那个！",
            "nextDialogs": [
              "401280631"
            ]
          },
          "401280631": {
            "id": "401280631",
            "speakerId": 1005,
            "speakerName": "菲米尼",
            "text": "咳…是我的一点…一点个人习惯，请不要在意这个…",
            "nextDialogs": [
              "401280632"
            ]
          },
          "401280632": {
            "id": "401280632",
            "speakerId": 1005,
            "speakerName": "菲米尼",
            "text": "总之，企鹅小镇是一个安宁的小镇，那里住着很多企鹅居民，他们都很擅长制作发条玩具。",
            "nextDialogs": [
              "401280633"
            ]
          },
          "401280633": {
            "id": "401280633",
            "speakerId": 1005,
            "speakerName": "菲米尼",
            "text": "而「佩伊」则是凯旋的英雄，是小镇里默默守护大家的人。",
            "nextDialogs": [
              "401280634"
            ]
          },
          "401280634": {
            "id": "401280634",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "「佩伊」？可「佩伊」不是你做出来的吗？",
            "nextDialogs": [
              "401280635"
            ]
          },
          "401280635": {
            "id": "401280635",
            "speakerId": 1005,
            "speakerName": "菲米尼",
            "text": "但我也常常想，或许后来是他感到了我的需要，才来到我的身边…所以不是我制作了「佩伊」，而是「佩伊」选择了我。",
            "nextDialogs": [
              "401280636"
            ]
          },
          "401280636": {
            "id": "401280636",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "完了，我怎么觉得…菲米尼也开始有点失控性幻想了。",
            "nextDialogs": [
              "401280637"
            ]
          },
          "401280637": {
            "id": "401280637",
            "speakerId": 1005,
            "speakerName": "菲米尼",
            "text": "不…我能分清现实，我只是同时认为…认为那个幻想的童话世界也存在着。",
            "nextDialogs": [
              "401280638"
            ]
          },
          "401280638": {
            "id": "401280638",
            "speakerId": 1005,
            "speakerName": "菲米尼",
            "text": "它们可能藏在不容易发现的角落，只在某些特殊时刻才降临到身边…",
            "nextDialogs": [
              "401280639"
            ]
          },
          "401280639": {
            "id": "401280639",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "特殊时刻？戴上潜水头盔的时刻吗？",
            "nextDialogs": [
              "401280640"
            ]
          },
          "401280640": {
            "id": "401280640",
            "speakerId": 1005,
            "speakerName": "菲米尼",
            "text": "…有时，偶尔…",
            "nextDialogs": [
              "401280641"
            ]
          },
          "401280641": {
            "id": "401280641",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "真的假的？！我只是随便说说…",
            "nextDialogs": [
              "401280642"
            ]
          },
          "401280642": {
            "id": "401280642",
            "speakerId": 1005,
            "speakerName": "菲米尼",
            "text": "你们有没有从水里往外面看过？就像躲进另一个世界，回头观察我们的世界。那感觉很特别，既有点陌生，又觉得被保护着。",
            "nextDialogs": [
              "401280643"
            ]
          },
          "401280643": {
            "id": "401280643",
            "speakerId": 1005,
            "speakerName": "菲米尼",
            "text": "戴上潜水头盔也一样，在那种时刻，就有可能看到一些…一些美好的东西，好像童话在那一刻成为了现实，跟奇迹一样。",
            "nextDialogs": [
              "401280644"
            ]
          },
          "401280644": {
            "id": "401280644",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "奇迹？！",
            "nextDialogs": [
              "401280645"
            ]
          },
          "401280645": {
            "id": "401280645",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "说的我都想试试你的头盔了。",
            "nextDialogs": [
              "401280646"
            ]
          },
          "401280646": {
            "id": "401280646",
            "speakerId": 1005,
            "speakerName": "菲米尼",
            "text": "…如果是你的指令的话…"
          },
          "401280618": {
            "id": "401280618",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "#哎呀，你又不是三岁小孩子啦，还这么爱开玩笑。菲米尼你不要管{M#他}{F#她}，无论遇到什么困难，我们都不会害怕！"
          }
        }
      }
    },
    {
      "subId": "4012812",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "401281201"
        ],
        "dialogs": {
          "401281201": {
            "id": "401281201",
            "speakerId": 1004,
            "speakerName": "「特尔克西」",
            "text": "-.. -... .-- -...？"
          }
        }
      }
    },
    {
      "subId": "4012899",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "401289901"
        ],
        "dialogs": {
          "401289901": {
            "id": "401289901",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "这里就是那片水域了吗？倒是意外的平静…咦？快看，岸边有脚印…",
            "nextDialogs": [
              "401289902"
            ]
          },
          "401289902": {
            "id": "401289902",
            "speakerId": 1005,
            "speakerName": "菲米尼",
            "text": "「特尔克西」就在帐篷里，他能够接受简单的语言指令，你们可以试着喊一喊他的名字，看他会不会过来。",
            "nextDialogs": [
              "401289903"
            ]
          },
          "401289903": {
            "id": "401289903",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "好高级！那让我来喊一下试试。喂——「特尔克西」——听得见吗？",
            "nextDialogs": [
              "401289907"
            ]
          },
          "401289907": {
            "id": "401289907",
            "speakerId": 1005,
            "speakerName": "菲米尼",
            "text": "好了，这些差不多就够了，我们先回营地吧，在水下呆了这么久，辛苦你们了。"
          }
        }
      }
    }
  ]
}
      }
    },
    {
      "subId": "4012802",
      "subQuestName": "调查岸边的脚印",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "401280201"
        ],
        "dialogs": {
          "401280201": {
            "id": "401280201",
            "speakerId": 1002,
            "speakerName": "新鲜的脚印",
            "text": "（脚印的痕迹朝着水下延伸…）",
            "nextDialogs": [
              "401280202"
            ]
          },
          "401280202": {
            "id": "401280202",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "这些脚印看起来很新鲜…不会又有受害者吧？我们快看看附近还有没有别的线索。",
            "nextDialogs": [
              "401280203"
            ]
          },
          "401280203": {
            "id": "401280203",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "#等等！{NICKNAME}，你有没有听到什么声音？",
            "nextDialogs": [
              "401280204"
            ]
          },
          "401280204": {
            "id": "401280204",
            "speakerId": 1003,
            "speakerName": "Black Screen",
            "text": "咕噜——咕噜——\\n从水边传来…",
            "nextDialogs": [
              "401280249"
            ]
          },
          "401280249": {
            "id": "401280249",
            "speakerId": 1003,
            "speakerName": "Black Screen",
            "text": "咕噜咕噜咕噜——\\n声音越来越大…",
            "nextDialogs": [
              "401280250"
            ]
          },
          "401280250": {
            "id": "401280250",
            "speakerId": 1003,
            "speakerName": "Black Screen",
            "text": "哗啦——\\n上岸了…"
          }
        }
      }
    },
    {
      "subId": "4012809",
      "subQuestName": "前往菲米尼的营地",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "401280901"
        ],
        "dialogs": {
          "401280901": {
            "id": "401280901",
            "speakerId": 1004,
            "speakerName": "「特尔克西」",
            "text": "-.. -... .-- -...？",
            "nextDialogs": [
              "401280902"
            ]
          },
          "401280902": {
            "id": "401280902",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "哇！这就是「特尔克西」吗？长得和「佩伊」差不多呢，也是企鹅的样子。",
            "nextDialogs": [
              "401280903"
            ]
          },
          "401280903": {
            "id": "401280903",
            "speakerId": 1005,
            "speakerName": "菲米尼",
            "text": "嗯，如果「特尔克西」在企鹅小镇，应该会和「佩伊」成为好朋友。",
            "nextDialogs": [
              "401280904"
            ]
          },
          "401280904": {
            "id": "401280904",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "「企鹅小镇」是哪里？",
            "nextDialogs": [
              "401280905"
            ]
          },
          "401280905": {
            "id": "401280905",
            "speakerId": 1005,
            "speakerName": "菲米尼",
            "text": "…不用在意，是个不怎么起眼的地方…",
            "nextDialogs": [
              "401280906"
            ]
          },
          "401280906": {
            "id": "401280906",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "喂喂！「特尔克西」，你好呀！你会打招呼吗？",
            "nextDialogs": [
              "401280907"
            ]
          },
          "401280907": {
            "id": "401280907",
            "speakerId": 1004,
            "speakerName": "「特尔克西」",
            "text": "-.. -... .-- -...？",
            "nextDialogs": [
              "401280908"
            ]
          },
          "401280908": {
            "id": "401280908",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "「特尔克西」会说话？",
            "nextDialogs": [
              "401280909"
            ]
          },
          "401280909": {
            "id": "401280909",
            "speakerId": 1005,
            "speakerName": "菲米尼",
            "text": "原本是有安装语言输出模块的计划，但考虑到工期问题，中途还是放弃了。",
            "nextDialogs": [
              "401280910"
            ]
          },
          "401280910": {
            "id": "401280910",
            "speakerId": 1005,
            "speakerName": "菲米尼",
            "text": "现在「特尔克西」只能输出主板里写好的信号码，但无法转译成我们能理解的语言。所以还不算会说话…",
            "nextDialogs": [
              "401280911"
            ]
          },
          "401280911": {
            "id": "401280911",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "不…不用说的这么专业！我们能听懂，你是想要我们帮你完成这个什么语言模块吧？",
            "nextDialogs": [
              "401280912"
            ]
          },
          "401280912": {
            "id": "401280912",
            "speakerId": 1005,
            "speakerName": "菲米尼",
            "text": "…不，那不必要，雇主也没有这个需求，只是我自己的小尝试…",
            "nextDialogs": [
              "401280913"
            ]
          },
          "401280913": {
            "id": "401280913",
            "speakerId": 1005,
            "speakerName": "菲米尼",
            "text": "想请你们帮忙的是另外两件事，一是对「特尔克西」的操作主板进行回路调试，确保他在大部分情况都能很好地工作。",
            "nextDialogs": [
              "401280914"
            ]
          },
          "401280914": {
            "id": "401280914",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "听起来好像不是很复杂，那第二件工作呢？",
            "nextDialogs": [
              "401280915"
            ]
          },
          "401280915": {
            "id": "401280915",
            "speakerId": 1005,
            "speakerName": "菲米尼",
            "text": "第二件工作也简单，只要去水下寻找一些彩色贝壳、珊瑚这些材料，用来制作「特尔克西」的武器。",
            "nextDialogs": [
              "401280916"
            ]
          },
          "401280916": {
            "id": "401280916",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "居然有武器？「特尔克西」还要战斗吗？",
            "nextDialogs": [
              "401280917"
            ]
          },
          "401280917": {
            "id": "401280917",
            "speakerId": 1005,
            "speakerName": "菲米尼",
            "text": "嗯，「特尔克西」要像英勇的王子一样，高举着武器前进，这是那位雇主的需求…",
            "nextDialogs": [
              "401280918"
            ]
          },
          "401280918": {
            "id": "401280918",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "这位雇主还真是有想法！给「特尔克西」起了一个水妖的名字，却要求他拥有王子的样子…",
            "nextDialogs": [
              "401280919"
            ]
          },
          "401280919": {
            "id": "401280919",
            "speakerId": 1005,
            "speakerName": "菲米尼",
            "text": "无论水妖还是王子，「特尔克西」诞生的目的都没有变，他和「佩伊」一样，是为陪伴而来的。",
            "nextDialogs": [
              "401280920"
            ]
          },
          "401280920": {
            "id": "401280920",
            "speakerId": 1004,
            "speakerName": "「特尔克西」",
            "text": "-.. .--. -. --.- -... .... --- .--- ..-.",
            "nextDialogs": [
              "401280921"
            ]
          },
          "401280921": {
            "id": "401280921",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "呜哇，「特尔克西」又在说什么了，他能听懂我们的话吗？",
            "nextDialogs": [
              "401280922"
            ]
          },
          "401280922": {
            "id": "401280922",
            "speakerId": 1005,
            "speakerName": "菲米尼",
            "text": "他可以对一些关键词做出反应，不过因为缺少自转译模块的原因，所以，很抱歉，他还不能交流…",
            "nextDialogs": [
              "401280923"
            ]
          },
          "401280923": {
            "id": "401280923",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "…真遗憾，算了，我们还是快点开始工作吧！就从…就从调试主板开始吧？听起来在营地里就可以完成。",
            "nextDialogs": [
              "401280924"
            ]
          },
          "401280924": {
            "id": "401280924",
            "speakerId": 1005,
            "speakerName": "菲米尼",
            "text": "好，主板在我的工具台上，请跟我来吧。",
            "nextDialogs": [
              "401280925"
            ]
          },
          "401280925": {
            "id": "401280925",
            "speakerId": 1005,
            "speakerName": "菲米尼",
            "text": "就是这里了，我有一份调试手册，如果不清楚可以看看。",
            "nextDialogs": [
              "401280926"
            ]
          },
          "401280926": {
            "id": "401280926",
            "speakerId": 1005,
            "speakerName": "菲米尼",
            "text": "现在要试一试吗？就算失败也不用担心，我有很多备用主板。",
            "nextDialogs": [
              "401280927"
            ]
          },
          "401280927": {
            "id": "401280927",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "试试吧。",
            "nextDialogs": [
              "401280928"
            ]
          },
          "401280928": {
            "id": "401280928",
            "speakerId": 1005,
            "speakerName": "菲米尼",
            "text": "嗯…如果是你，一定可以的。"
          }
        }
      }
    },
    {

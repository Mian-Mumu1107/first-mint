    {
      "subId": "4012807",
      "subQuestName": "维护主板",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "401280701"
        ],
        "dialogs": {
          "401280701": {
            "id": "401280701",
            "speakerId": 1005,
            "speakerName": "菲米尼",
            "text": "请试试吧，主板就在旁边的桌子上。"
          }
        }
      }
    },
    {
      "subId": "4012808",
      "subQuestName": "与菲米尼交谈",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "401280801"
        ],
        "dialogs": {
          "401280801": {
            "id": "401280801",
            "speakerId": 1005,
            "speakerName": "菲米尼",
            "text": "#{NICKNAME}，这种工作果然难不倒你。",
            "nextDialogs": [
              "401280802"
            ]
          },
          "401280802": {
            "id": "401280802",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "嘿嘿，我们可是接手过很多类似的活呢。",
            "nextDialogs": [
              "401280803"
            ]
          },
          "401280803": {
            "id": "401280803",
            "speakerId": 1005,
            "speakerName": "菲米尼",
            "text": "那接下来我们就去水边吧，和之前说的一样，我们的目标是水下的彩色贝壳和珊瑚。",
            "nextDialogs": [
              "401280804"
            ]
          },
          "401280804": {
            "id": "401280804",
            "speakerId": 1005,
            "speakerName": "菲米尼",
            "text": "对了，你们应该对枫丹的水下环境还比较适应吧？",
            "nextDialogs": [
              "401280807"
            ]
          },
          "401280807": {
            "id": "401280807",
            "speakerId": 1005,
            "speakerName": "菲米尼",
            "text": "那就好。如果感到不舒服也不用慌，我会一直在你们身边。"
          }
        }
      }
    },

        ],
        "dialogs": {
          "150458001": {
            "id": "150458001",
            "speakerId": 1024,
            "speakerName": "班尼特",
            "text": "上面那层喷成橙色一定很棒！",
            "nextDialogs": [
              "150458002"
            ]
          },
          "150458002": {
            "id": "150458002",
            "speakerId": 1092,
            "speakerName": "恰斯卡",
            "text": "花羽会的颜色应该不错…",
            "nextDialogs": [
              "150458003"
            ]
          },
          "150458003": {
            "id": "150458003",
            "speakerId": 1087,
            "speakerName": "玛拉妮",
            "text": "蓝色也是这栋小屋的幸运色！",
            "nextDialogs": [
              "150458004"
            ]
          },
          "150458004": {
            "id": "150458004",
            "speakerId": 1001,
            "speakerName": "温迪",
            "text": "你觉得这边用浅绿色怎么样~",
            "nextDialogs": [
              "150458005"
            ]
          },
          "150458005": {
            "id": "150458005",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "我想要这里是明黄色！",
            "nextDialogs": [
              "150458006"
            ]
          },
          "150458006": {
            "id": "150458006",
            "speakerId": 1024,
            "speakerName": "班尼特",
            "text": "真不错啊！",
            "nextDialogs": [
              "150458007"
            ]
          },
          "150458007": {
            "id": "150458007",
            "speakerId": 1092,
            "speakerName": "恰斯卡",
            "text": "果然合适。",
            "nextDialogs": [
              "150458008"
            ]
          },
          "150458008": {
            "id": "150458008",
            "speakerId": 1087,
            "speakerName": "玛拉妮",
            "text": "幸运小屋~！",
            "nextDialogs": [
              "150458009"
            ]
          },
          "150458009": {
            "id": "150458009",
            "speakerId": 1001,
            "speakerName": "温迪",
            "text": "看着就很凉爽呢。",
            "nextDialogs": [
              "150458010"
            ]
          },
          "150458010": {
            "id": "150458010",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "太棒了，不愧是你！"
          }
        }
      }
    },

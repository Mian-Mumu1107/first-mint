    {
      "subId": "1504506",
      "subQuestName": "与众人对话",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "150450601"
        ],
        "dialogs": {
          "150450601": {
            "id": "150450601",
            "speakerId": 1024,
            "speakerName": "班尼特",
            "text": "噢，真好看！",
            "nextDialogs": [
              "150450602"
            ]
          },
          "150450602": {
            "id": "150450602",
            "speakerId": 1087,
            "speakerName": "玛拉妮",
            "text": "各位，来我这里集合！要拍照啦！",
            "nextDialogs": [
              "150450603"
            ]
          },
          "150450603": {
            "id": "150450603",
            "speakerId": 1087,
            "speakerName": "玛拉妮",
            "text": "嗯…不错嘛！所有人的精神状态都很饱满，没有黏答答的刘海或者熬夜的黑眼圈。",
            "nextDialogs": [
              "150450604"
            ]
          },
          "150450604": {
            "id": "150450604",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "你拍照前还会帮忙检查这些？",
            "nextDialogs": [
              "150450605"
            ]
          },
          "150450605": {
            "id": "150450605",
            "speakerId": 1087,
            "speakerName": "玛拉妮",
            "text": "拍照不够细心还怎么声称自己是好向导？",
            "nextDialogs": [
              "150450606"
            ]
          },
          "150450606": {
            "id": "150450606",
            "speakerId": 1001,
            "speakerName": "温迪",
            "text": "爱喝酒的吟游诗人才能成为好旅伴？",
            "nextDialogs": [
              "150450607"
            ]
          },
          "150450607": {
            "id": "150450607",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "这话到底是怎么接上的…",
            "nextDialogs": [
              "150450608"
            ]
          },
          "150450608": {
            "id": "150450608",
            "speakerId": 1024,
            "speakerName": "班尼特",
            "text": "哈哈，但气氛很好。",
            "nextDialogs": [
              "150450609"
            ]
          },
          "150450609": {
            "id": "150450609",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "大家变成一起说胡话的朋友了。",
            "nextDialogs": [
              "150450610"
            ]
          },
          "150450610": {
            "id": "150450610",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "这真的是个好方向吗？你也跟班尼特一样在惯着卖唱的吧？",
            "nextDialogs": [
              "150450611"
            ]
          },
          "150450611": {
            "id": "150450611",
            "speakerId": 1092,
            "speakerName": "恰斯卡",
            "text": "至少不坏。",
            "nextDialogs": [
              "150450612"
            ]
          },
          "150450612": {
            "id": "150450612",
            "speakerId": 1087,
            "speakerName": "玛拉妮",
            "text": "#来，{NICKNAME}，把这个阿夏头箍带上。这是大家一起为你买的纪念礼物噢！",
            "nextDialogs": [
              "150450613"
            ]
          },
          "150450613": {
            "id": "150450613",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "谢谢。",
            "nextDialogs": [
              "150450614"
            ]
          },
          "150450614": {
            "id": "150450614",
            "speakerId": 1024,
            "speakerName": "班尼特",
            "text": "嗯，很适合你！",
            "nextDialogs": [
              "150450615"
            ]
          },
          "150450615": {
            "id": "150450615",
            "speakerId": 1087,
            "speakerName": "玛拉妮",
            "text": "那么…",
            "nextDialogs": [
              "150450616"
            ]
          },
          "150450616": {
            "id": "150450616",
            "speakerId": 1087,
            "speakerName": "玛拉妮",
            "text": "三、二、一——",
            "nextDialogs": [
              "150450617"
            ]
          },
          "150450617": {
            "id": "150450617",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "……",
            "nextDialogs": [
              "150450618"
            ]
          },
          "150450618": {
            "id": "150450618",
            "speakerId": 1024,
            "speakerName": "班尼特",
            "text": "派蒙？",
            "nextDialogs": [
              "150450619"
            ]
          },
          "150450619": {
            "id": "150450619",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "…不好意思，胡话听多了之后脑袋突然卡壳了，没想出要说什么词…",
            "nextDialogs": [
              "150450620"
            ]
          },
          "150450620": {
            "id": "150450620",
            "speakerId": 1092,
            "speakerName": "恰斯卡",
            "text": "再加上还有点舍不得大家？",
            "nextDialogs": [
              "150450621"
            ]
          },
          "150450621": {
            "id": "150450621",
            "speakerId": 1092,
            "speakerName": "恰斯卡",
            "text": "觉得当自己这么说出来的时候，仿佛就是在给假期画上句号了？",
            "nextDialogs": [
              "150450622"
            ]
          },
          "150450622": {
            "id": "150450622",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "你…！你还说「调停人」不会读心术！",
            "nextDialogs": [
              "150450623"
            ]
          },
          "150450623": {
            "id": "150450623",
            "speakerId": 1087,
            "speakerName": "玛拉妮",
            "text": "哈哈，派蒙…",
            "nextDialogs": [
              "150450624"
            ]
          },
          "150450624": {
            "id": "150450624",
            "speakerId": 1024,
            "speakerName": "班尼特",
            "text": "没事的，派蒙。",
            "nextDialogs": [
              "150450625"
            ]
          },
          "150450625": {
            "id": "150450625",
            "speakerId": 1024,
            "speakerName": "班尼特",
            "text": "夏天一定还会到来，就像你和火神大人许愿的那样。",
            "nextDialogs": [
              "150450626"
            ]
          },
          "150450626": {
            "id": "150450626",
            "speakerId": 1024,
            "speakerName": "班尼特",
            "text": "大家的旅程都在继续。但只要我们都珍惜着彼此，总有一天还会相聚。",
            "nextDialogs": [
              "150450627"
            ]
          },
          "150450627": {
            "id": "150450627",
            "speakerId": 1087,
            "speakerName": "玛拉妮",
            "text": "班尼特是不是变得相当能说啊，温迪老师？",
            "nextDialogs": [
              "150450628"
            ]
          },
          "150450628": {
            "id": "150450628",
            "speakerId": 1001,
            "speakerName": "温迪",
            "text": "啊呀，不是我教的哦。",
            "nextDialogs": [
              "150450629"
            ]
          },
          "150450629": {
            "id": "150450629",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "不是你教的你语气那么得意干嘛呀！真是的，我好不容易有点感动…",
            "nextDialogs": [
              "150450630"
            ]
          },
          "150450630": {
            "id": "150450630",
            "speakerId": 1087,
            "speakerName": "玛拉妮",
            "text": "那我们重新来一次？",
            "nextDialogs": [
              "150450631"
            ]
          },
          "150450631": {
            "id": "150450631",
            "speakerId": 1024,
            "speakerName": "班尼特",
            "text": "大家一起吧？",
            "nextDialogs": [
              "150450632"
            ]
          },
          "150450632": {
            "id": "150450632",
            "speakerId": 1092,
            "speakerName": "恰斯卡",
            "text": "喊什么？",
            "nextDialogs": [
              "150450633"
            ]
          },
          "150450633": {
            "id": "150450633",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "幸运之星？",
            "nextDialogs": [
              "150450634"
            ]
          },
          "150450634": {
            "id": "150450634",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "好！",
            "nextDialogs": [
              "150450635"
            ]
          },
          "150450635": {
            "id": "150450635",
            "speakerId": 1087,
            "speakerName": "玛拉妮",
            "text": "三、二、一——",
            "nextDialogs": [
              "150450636"
            ]
          },
          "150450636": {
            "id": "150450636",
            "speakerId": 10266,
            "speakerName": "众人",
            "text": "幸运之星！",
            "nextDialogs": [
              "150450641"
            ]
          },
          "150450641": {
            "id": "150450641",
            "speakerId": 1006,
            "speakerName": "Black Screen",
            "text": "和朋友们共度了一段愉快的时光…",
            "nextDialogs": [
              "150450642"
            ]
          },
          "150450642": {
            "id": "150450642",
            "speakerId": 1092,
            "speakerName": "恰斯卡",
            "text": "…班尼特之后有什么打算？",
            "nextDialogs": [
              "150450643"
            ]
          },
          "150450643": {
            "id": "150450643",
            "speakerId": 1087,
            "speakerName": "玛拉妮",
            "text": "对啊，如果现在不好做决定的话，可以来我们「流泉之众」坐坐，想待多久都行。",
            "nextDialogs": [
              "150450644"
            ]
          },
          "150450644": {
            "id": "150450644",
            "speakerId": 1024,
            "speakerName": "班尼特",
            "text": "…嗯，谢谢你的好意，玛拉妮。",
            "nextDialogs": [
              "150450645"
            ]
          },
          "150450645": {
            "id": "150450645",
            "speakerId": 1024,
            "speakerName": "班尼特",
            "text": "在这之前，我去见了火神大人，向她郑重表达了我的感谢。",
            "nextDialogs": [
              "150450646"
            ]
          },
          "150450646": {
            "id": "150450646",
            "speakerId": 1024,
            "speakerName": "班尼特",
            "text": "她告诉我，那片空间是由深渊拟态而成的烬寂海，空间本身极不稳定，现在已经彻底消失了。",
            "nextDialogs": [
              "150450647"
            ]
          },
          "150450647": {
            "id": "150450647",
            "speakerId": 1024,
            "speakerName": "班尼特",
            "text": "后面聊到我的事之后，火神大人欢迎我留在纳塔，但也说会尊重我的决定。",
            "nextDialogs": [
              "150450648"
            ]
          },
          "150450648": {
            "id": "150450648",
            "speakerId": 1024,
            "speakerName": "班尼特",
            "text": "我思考再三…还是决定回蒙德。",
            "nextDialogs": [
              "150450649"
            ]
          },
          "150450649": {
            "id": "150450649",
            "speakerId": 1092,
            "speakerName": "恰斯卡",
            "text": "放心不下老爹们？",
            "nextDialogs": [
              "150450650"
            ]
          },
          "150450650": {
            "id": "150450650",
            "speakerId": 1024,
            "speakerName": "班尼特",
            "text": "这也是原因之一。我答应要把收获的故事讲给老爹们听，不能失约。",
            "nextDialogs": [
              "150450651"
            ]
          },
          "150450651": {
            "id": "150450651",
            "speakerId": 1024,
            "speakerName": "班尼特",
            "text": "其余的嘛…",
            "nextDialogs": [
              "150450652"
            ]
          },
          "150450652": {
            "id": "150450652",
            "speakerId": 1024,
            "speakerName": "班尼特",
            "text": "告别的时候，我对爸妈说了，我一定会成为提瓦特最伟大的传奇冒险家。",
            "nextDialogs": [
              "150450653"
            ]
          },
          "150450653": {
            "id": "150450653",
            "speakerId": 1024,
            "speakerName": "班尼特",
            "text": "冒险家，可不能只待在一个地方啊。",
            "nextDialogs": [
              "150450654"
            ]
          },
          "150450654": {
            "id": "150450654",
            "speakerId": 1087,
            "speakerName": "玛拉妮",
            "text": "班尼特…",
            "nextDialogs": [
              "150450655"
            ]
          },
          "150450655": {
            "id": "150450655",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "要是你在离开纳塔之后，又变得不幸起来…那要怎么办？",
            "nextDialogs": [
              "150450656"
            ]
          },
          "150450656": {
            "id": "150450656",
            "speakerId": 1024,
            "speakerName": "班尼特",
            "text": "哈哈，这也没关系。",
            "nextDialogs": [
              "150450657"
            ]
          },
          "150450657": {
            "id": "150450657",
            "speakerId": 1024,
            "speakerName": "班尼特",
            "text": "在这次旅程中获得的温暖，足以让我面对未来的所有挑战。",
            "nextDialogs": [
              "150450658"
            ]
          },
          "150450658": {
            "id": "150450658",
            "speakerId": 1024,
            "speakerName": "班尼特",
            "text": "我想把握自己的命运。我想将这份家人和朋友带给我的温暖，继续传递下去。这个想法一直没变。",
            "nextDialogs": [
              "150450659"
            ]
          },
          "150450659": {
            "id": "150450659",
            "speakerId": 1092,
            "speakerName": "恰斯卡",
            "text": "敬我们的团长！",
            "nextDialogs": [
              "150450660"
            ]
          },
          "150450660": {
            "id": "150450660",
            "speakerId": 1001,
            "speakerName": "温迪",
            "text": "敬班尼特团长！",
            "nextDialogs": [
              "150450661"
            ]
          },
          "150450661": {
            "id": "150450661",
            "speakerId": 1087,
            "speakerName": "玛拉妮",
            "text": "干杯干杯——！",
            "nextDialogs": [
              "150450662"
            ]
          },
          "150450662": {
            "id": "150450662",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "呃…竟然快要通宵了…",
            "nextDialogs": [
              "150450663"
            ]
          },
          "150450663": {
            "id": "150450663",
            "speakerId": 1087,
            "speakerName": "玛拉妮",
            "text": "玩得尽兴嘛！接下去轮到谁表演？",
            "nextDialogs": [
              "150450664"
            ]
          },
          "150450664": {
            "id": "150450664",
            "speakerId": 1092,
            "speakerName": "恰斯卡",
            "text": "我看班尼特好几次要睡着了。",
            "nextDialogs": [
              "150450665"
            ]
          },
          "150450665": {
            "id": "150450665",
            "speakerId": 1024,
            "speakerName": "班尼特",
            "text": "没有，没有…我还可以…",
            "nextDialogs": [
              "150450666"
            ]
          },
          "150450666": {
            "id": "150450666",
            "speakerId": 1092,
            "speakerName": "恰斯卡",
            "text": "大家都回去休息吧，玛拉妮，这么有力气就交给你收拾场地了。",
            "nextDialogs": [
              "150450667"
            ]
          },
          "150450667": {
            "id": "150450667",
            "speakerId": 1087,
            "speakerName": "玛拉妮",
            "text": "欸？为什么是我——",
            "nextDialogs": [
              "150450668"
            ]
          },
          "150450668": {
            "id": "150450668",
            "speakerId": 1001,
            "speakerName": "温迪",
            "text": "#{NICKNAME}，再陪我散散步？",
            "nextDialogs": [
              "150450669"
            ]
          },
          "150450669": {
            "id": "150450669",
            "speakerId": 1001,
            "speakerName": "温迪",
            "text": "我知道一个风景不错的地方。"
          }
        }
      }
    },
    {
      "subId": "1504507",
      "subQuestName": "前往温迪所说的地点",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "150450701"
        ],
        "dialogs": {
          "150450701": {
            "id": "150450701",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "卖唱的，你还是那么会挑地方…",
            "nextDialogs": [
              "150450702"
            ]
          },
          "150450702": {
            "id": "150450702",
            "speakerId": 1001,
            "speakerName": "温迪",
            "text": "很高兴你能喜欢。有些故事不适合飞鸟，只能说给高处的星辰听呢。",
            "nextDialogs": [
              "150450703"
            ]
          },
          "150450703": {
            "id": "150450703",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "要讲睡前故事了吗？",
            "nextDialogs": [
              "150450704"
            ]
          },
          "150450704": {
            "id": "150450704",
            "speakerId": 1001,
            "speakerName": "温迪",
            "text": "哈哈，这篇故事，要从「时间」开始说起。",
            "nextDialogs": [
              "150450705"
            ]
          },
          "150450705": {
            "id": "150450705",
            "speakerId": 1001,
            "speakerName": "温迪",
            "text": "很久很久以前，「时{RUBY#[D]伊斯塔露}间」开始记录这个世界。",
            "nextDialogs": [
              "150450706"
            ]
          },
          "150450706": {
            "id": "150450706",
            "speakerId": 1001,
            "speakerName": "温迪",
            "text": "她对栖息在尘世的生灵一视同仁，与此同时，这些生灵在她心中也是同等的无足轻重。",
            "nextDialogs": [
              "150450707"
            ]
          },
          "150450707": {
            "id": "150450707",
            "speakerId": 1001,
            "speakerName": "温迪",
            "text": "她就好像一张古老的卷轴，将所有人、所有事、所有的相遇与别离都刻印在自己的记忆中。",
            "nextDialogs": [
              "150450708"
            ]
          },
          "150450708": {
            "id": "150450708",
            "speakerId": 1001,
            "speakerName": "温迪",
            "text": "那时还是风精灵的我，在千风神殿与「时间」偶遇。",
            "nextDialogs": [
              "150450709"
            ]
          },
          "150450709": {
            "id": "150450709",
            "speakerId": 1001,
            "speakerName": "温迪",
            "text": "她聆听我的愿望，将部分力量与权能的碎片出让给了我…",
            "nextDialogs": [
              "150450712"
            ]
          },
          "150450712": {
            "id": "150450712",
            "speakerId": 1001,
            "speakerName": "温迪",
            "text": "看来这不是你第一次听说「时间与风」的故事。",
            "nextDialogs": [
              "150450713"
            ]
          },
          "150450713": {
            "id": "150450713",
            "speakerId": 1001,
            "speakerName": "温迪",
            "text": "这不是很有韵味吗？",
            "nextDialogs": [
              "150450714"
            ]
          },
          "150450714": {
            "id": "150450714",
            "speakerId": 1001,
            "speakerName": "温迪",
            "text": "靠着铭刻在祭礼、诗歌、遗迹和古籍中的记忆，被视作微不足道的生灵们一次次「见」到了时间。",
            "nextDialogs": [
              "150450715"
            ]
          },
          "150450715": {
            "id": "150450715",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "这就是你要说的故事？",
            "nextDialogs": [
              "150450716"
            ]
          },
          "150450716": {
            "id": "150450716",
            "speakerId": 1001,
            "speakerName": "温迪",
            "text": "嗯…只能算是故事的「序章」。",
            "nextDialogs": [
              "150450717"
            ]
          },
          "150450717": {
            "id": "150450717",
            "speakerId": 1001,
            "speakerName": "温迪",
            "text": "烬寂海的污染是具有时间特性的，换句话说，它的灾害存在于时间的每一处。",
            "nextDialogs": [
              "150450718"
            ]
          },
          "150450718": {
            "id": "150450718",
            "speakerId": 1001,
            "speakerName": "温迪",
            "text": "不同于「时间」本身，我的心中，一直存在诸多愿望。",
            "nextDialogs": [
              "150450719"
            ]
          },
          "150450719": {
            "id": "150450719",
            "speakerId": 1001,
            "speakerName": "温迪",
            "text": "五百年前，为了防止烬寂海的污染继续扩散，影响特诺奇兹托克以外的更多区域…",
            "nextDialogs": [
              "150450720"
            ]
          },
          "150450720": {
            "id": "150450720",
            "speakerId": 1001,
            "speakerName": "温迪",
            "text": "我将烬寂海从时间轴上吹了出去，让它成为了「无风之地」。",
            "nextDialogs": [
              "150450721"
            ]
          },
          "150450721": {
            "id": "150450721",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "这就是烬寂海消失之谜的真相吗…",
            "nextDialogs": [
              "150450722"
            ]
          },
          "150450722": {
            "id": "150450722",
            "speakerId": 1001,
            "speakerName": "温迪",
            "text": "哎呀，好像让你弄混了呢。",
            "nextDialogs": [
              "150450723"
            ]
          },
          "150450723": {
            "id": "150450723",
            "speakerId": 1001,
            "speakerName": "温迪",
            "text": "如果你问的是二三十年前，烬寂海从特诺奇兹托克消失的事，或许存在比我更适合的讲述人。",
            "nextDialogs": [
              "150450724"
            ]
          },
          "150450724": {
            "id": "150450724",
            "speakerId": 1001,
            "speakerName": "温迪",
            "text": "烬寂海承载了太多不应属于它的故事…我仅参与了其中一个篇章。",
            "nextDialogs": [
              "150450725"
            ]
          },
          "150450725": {
            "id": "150450725",
            "speakerId": 1001,
            "speakerName": "温迪",
            "text": "而我在五百年前做出的选择，也有代价。",
            "nextDialogs": [
              "150450726"
            ]
          },
          "150450726": {
            "id": "150450726",
            "speakerId": 1001,
            "speakerName": "温迪",
            "text": "有些灵魂因此无法返回蒙德…另有些灵魂沉淀在这块土地上，和幻写灵结合，成为了你我所见的阿夏。",
            "nextDialogs": [
              "150450727"
            ]
          },
          "150450727": {
            "id": "150450727",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "所以，你这次来特诺奇兹托克是为了…",
            "nextDialogs": [
              "150450728"
            ]
          },
          "150450728": {
            "id": "150450728",
            "speakerId": 1001,
            "speakerName": "温迪",
            "text": "没错，我需要和现任火神玛薇卡合作。",
            "nextDialogs": [
              "150450729"
            ]
          },
          "150450729": {
            "id": "150450729",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "是在点燃蜡烛的时候吗？",
            "nextDialogs": [
              "150450730"
            ]
          },
          "150450730": {
            "id": "150450730",
            "speakerId": 1001,
            "speakerName": "温迪",
            "text": "猜对咯，火光是我们的暗号。",
            "nextDialogs": [
              "150450731"
            ]
          },
          "150450731": {
            "id": "150450731",
            "speakerId": 1001,
            "speakerName": "温迪",
            "text": "由玛薇卡从那片空间中开启通往真正烬寂海的裂隙，我才能悄悄钻进去，把所有愿意回家的灵魂都接送回去。",
            "nextDialogs": [
              "150450732"
            ]
          },
          "150450732": {
            "id": "150450732",
            "speakerId": 1001,
            "speakerName": "温迪",
            "text": "至于带回记忆这种小把戏…欸嘿，也不是第一次了吧。",
            "nextDialogs": [
              "150450733"
            ]
          },
          "150450733": {
            "id": "150450733",
            "speakerId": 1001,
            "speakerName": "温迪",
            "text": "玛薇卡还和我提到了你想帮忙引荐的事…没想到还是被我抢先了。",
            "nextDialogs": [
              "150450734"
            ]
          },
          "150450734": {
            "id": "150450734",
            "speakerId": 1001,
            "speakerName": "温迪",
            "text": "很高兴看到她也热爱着美酒与自由…我们很聊得来。"
          }
        }
      }
    },

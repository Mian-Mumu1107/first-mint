    {
      "subId": "7110802",
      "subQuestName": "探索藏书阁",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "711080201"
        ],
        "dialogs": {
          "711080201": {
            "id": "711080201",
            "speakerId": 2230,
            "speakerName": "《古华手记》",
            "text": "(test)今天开始写日记了，习武多年，我要留下一本惊世著作，将我的武学传于后世有缘人！第一天，养猪。",
            "nextDialogs": [
              "711080204"
            ]
          },
          "711080204": {
            "id": "711080204",
            "speakerId": 2230,
            "speakerName": "《古华手记》",
            "text": "(test)第二天，养猪。第三天，古华啊古华，你怎能如此堕落，说好的要将武功记录下来呢？"
          }
        }
      }
    },
    {
      "subId": "7110803",
      "subQuestName": "找出隐藏在藏书阁中的秘密",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "711080301"
        ],
        "dialogs": {
          "711080301": {
            "id": "711080301",
            "speakerId": 2230,
            "speakerName": "《古华手记》",
            "text": "「…修习刺明之法。木人不慎尽毁…无钱资…自思一良策，何不束草为人…」",
            "nextDialogs": [
              "711080302"
            ]
          },
          "711080302": {
            "id": "711080302",
            "speakerId": 2230,
            "speakerName": "《古华手记》",
            "text": "「收揽稻草。」",
            "nextDialogs": [
              "711080303"
            ]
          },
          "711080303": {
            "id": "711080303",
            "speakerId": 2230,
            "speakerName": "《古华手记》",
            "text": "「束草。甚疲。」",
            "nextDialogs": [
              "711080304"
            ]
          },
          "711080304": {
            "id": "711080304",
            "speakerId": 2230,
            "speakerName": "《古华手记》",
            "text": "「…修习刺明之法。草人不慎尽毁…不妨先习剑。」",
            "nextDialogs": [
              "711080307"
            ]
          },
          "711080307": {
            "id": "711080307",
            "speakerId": 2230,
            "speakerName": "《古华手记》",
            "text": "「…无事。闲坐庭前观雨，腹中稍饥…思悟前日所见，忽得启感，若以剑…（模糊不清）自名『裁雨』，改日当试。」",
            "nextDialogs": [
              "711080308"
            ]
          },
          "711080308": {
            "id": "711080308",
            "speakerId": 2230,
            "speakerName": "《古华手记》",
            "text": "「…修习裁雨之法，不慎跌坠，所幸伤不甚重…自思一良策，不妨凿地浚池于桩下，既可使不复跌伤，又可养鱼以为食…」",
            "nextDialogs": [
              "711080309"
            ]
          },
          "711080309": {
            "id": "711080309",
            "speakerId": 2230,
            "speakerName": "《古华手记》",
            "text": "「…往见渔者，市数十鱼…试烹之，甚肥美，众鱼莫可与比…」",
            "nextDialogs": [
              "711080310"
            ]
          },
          "711080310": {
            "id": "711080310",
            "speakerId": 2230,
            "speakerName": "《古华手记》",
            "text": "（此后十余页均为鱼肉的各种烹饪方法，记载无比详细，有些甚至还搭配了插图。）",
            "nextDialogs": [
              "711080311"
            ]
          },
          "711080311": {
            "id": "711080311",
            "speakerId": 2230,
            "speakerName": "《古华手记》",
            "text": "「…修习裁雨之法，不慎跌坠。」",
            "nextDialogs": [
              "711080312"
            ]
          },
          "711080312": {
            "id": "711080312",
            "speakerId": 2230,
            "speakerName": "《古华手记》",
            "text": "「…成。」"
          }
        }
      }
    },
    {
      "subId": "7110804",
      "subQuestName": "开启机关",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "711080401"
        ],
        "dialogs": {
          "711080401": {
            "id": "711080401",
            "speakerId": 2230,
            "speakerName": "《古华手记》",
            "text": "「…修习刺明之法。木人不慎尽毁…无钱资…自思一良策，何不束草为人…」",
            "nextDialogs": [
              "711080420",
              "711080405"
            ]
          },
          "711080420": {
            "id": "711080420",
            "speakerId": 2230,
            "speakerName": "《古华手记》",
            "text": "「…以<color=#00E1FFFF>目</color>视之，使<color=#00E1FFFF>四方之卷</color>合于<color=#00E1FFFF>四方之阁</color>，便可…」",
            "nextDialogs": [
              "711080421"
            ]
          },
          "711080421": {
            "id": "711080421",
            "speakerId": 2230,
            "speakerName": "《古华手记》",
            "text": "（此后数页均被涂抹，无法阅读。旁有第三代掌门批注：此为劝诫后世之人博览四方书卷。）"
          },
          "711080405": {
            "id": "711080405",
            "speakerId": 2230,
            "speakerName": "《古华手记》",
            "text": "「收揽稻草。」",
            "nextDialogs": [
              "711080406"
            ]
          },
          "711080406": {
            "id": "711080406",
            "speakerId": 2230,
            "speakerName": "《古华手记》",
            "text": "「束草。甚疲。」",
            "nextDialogs": [
              "711080407"
            ]
          },
          "711080407": {
            "id": "711080407",
            "speakerId": 2230,
            "speakerName": "《古华手记》",
            "text": "「…修习刺明之法。草人不慎尽毁…不妨先习剑。」"
          }
        }
      }
    },
    {
      "subId": "7110825",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "711082501"
        ],
        "dialogs": {
          "711082501": {
            "id": "711082501",
            "speakerId": 2520,
            "speakerName": "文四爷",
            "text": "唉，不想我古华派千年传承，到头来竟落到了门长带头骗吃骗喝的境地…奈何，奈何啊…",
            "nextDialogs": [
              "711082502"
            ]
          },
          "711082502": {
            "id": "711082502",
            "speakerId": 2484,
            "speakerName": "黄三爷",
            "text": "嗨…行了行了，我这不是舍不得师弟守着这师门饿死嘛？",
            "nextDialogs": [
              "711082503"
            ]
          },
          "711082503": {
            "id": "711082503",
            "speakerId": 2484,
            "speakerName": "黄三爷",
            "text": "#你也别露出那种表情了。你一天到晚郁郁寡欢的…看到刚才那个{M#小伙子}{F#小姑娘}活跃的表现，你也挺欣慰的不是？",
            "nextDialogs": [
              "711082504"
            ]
          },
          "711082504": {
            "id": "711082504",
            "speakerId": 2520,
            "speakerName": "文四爷",
            "text": "#就那{M#傻小子}{F#傻姑娘}？进去转一圈给你做个腊肉饭？我还欣慰？我要年轻几岁先一掌拍死你…",
            "nextDialogs": [
              "711082505"
            ]
          },
          "711082505": {
            "id": "711082505",
            "speakerId": 2484,
            "speakerName": "黄三爷",
            "text": "嘿，年轻几岁你掌法还不如我呢！",
            "nextDialogs": [
              "711082506"
            ]
          },
          "711082506": {
            "id": "711082506",
            "speakerId": 2484,
            "speakerName": "黄三爷",
            "text": "行了，你听我说…就剩下咱们几个老家伙了，若不像这样试探有缘人的底细，总不能真让那些藏书陪着咱们进棺材吧？",
            "nextDialogs": [
              "711082507"
            ]
          },
          "711082507": {
            "id": "711082507",
            "speakerId": 2520,
            "speakerName": "文四爷",
            "text": "……",
            "nextDialogs": [
              "711082508"
            ]
          },
          "711082508": {
            "id": "711082508",
            "speakerId": 2484,
            "speakerName": "黄三爷",
            "text": "哈哈，罢了，罢了，这等让人难受的丧气话，不说也罢。",
            "nextDialogs": [
              "711082509"
            ]
          },
          "711082509": {
            "id": "711082509",
            "speakerId": 2484,
            "speakerName": "黄三爷",
            "text": "对了，那两个孩子刚才做给我的美食，你也尝尝看吧？嘿嘿，我觉得比万民堂做得还美味呢！来，尝一口，尝一口嘛！"
          }
        }
      }
    },
    {
      "subId": "7110899",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "711089902"
        ],
        "dialogs": {
          "711089902": {
            "id": "711089902",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "不过，话虽如此，到头来遗宝的事情还是骗人的嘛…好生气！我今天一定要从藏书阁里带点好东西走！",
            "nextDialogs": [
              "711089903"
            ]
          },
          "711089903": {
            "id": "711089903",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "唔，刚才那本书里有句话让我很在意…",
            "nextDialogs": [
              "711089904"
            ]
          },
          "711089904": {
            "id": "711089904",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "说什么「以<color=#00E1FFFF>目</color>视之」…是要我们用元素视野看一看吗？",
            "nextDialogs": [
              "711089905"
            ]
          },
          "711089905": {
            "id": "711089905",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "哇啊，水面降下去了！",
            "nextDialogs": [
              "711089906"
            ]
          },
          "711089906": {
            "id": "711089906",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "#说不定…说不定我们真的找到了古华的遗宝呢！{NICKNAME}，{NICKNAME}，我们快点进去看看吧！"
          }
        }
      }
    }
  ]
}
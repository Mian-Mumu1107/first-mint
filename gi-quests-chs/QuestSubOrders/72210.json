    {
      "subId": "7221005",
      "subQuestName": "与寝子对话",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "722100501"
        ],
        "dialogs": {
          "722100501": {
            "id": "722100501",
            "speakerId": 1000,
            "speakerName": "「寝子」",
            "text": "汝等，找到那两个孩子了吗？",
            "nextDialogs": [
              "722100502"
            ]
          },
          "722100502": {
            "id": "722100502",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "还没有…",
            "nextDialogs": [
              "722100503"
            ]
          },
          "722100503": {
            "id": "722100503",
            "speakerId": 1000,
            "speakerName": "「寝子」",
            "text": "唔…这样吗？那汝等可要快点啊，不然，那两个孩子也许又会跑到更远的地方去了。"
          }
        }
      }
    },
    {
      "subId": "7221004",
      "subQuestName": "与寝子对话",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "722100401"
        ],
        "dialogs": {
          "722100401": {
            "id": "722100401",
            "speakerId": 1000,
            "speakerName": "「寝子」",
            "text": "汝等找到他们了吗？",
            "nextDialogs": [
              "722100402"
            ]
          },
          "722100402": {
            "id": "722100402",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "找到了。",
            "nextDialogs": [
              "722100403"
            ]
          },
          "722100403": {
            "id": "722100403",
            "speakerId": 1000,
            "speakerName": "「寝子」",
            "text": "汝等，为什么总是不听奴家的话呢？为什么不能像「阿饭」那样听话呢？",
            "nextDialogs": [
              "722100404"
            ]
          },
          "722100404": {
            "id": "722100404",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "「阿饭」…",
            "nextDialogs": [
              "722100405"
            ]
          },
          "722100405": {
            "id": "722100405",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "确实是用好东西当名字呢…",
            "nextDialogs": [
              "722100406"
            ]
          },
          "722100406": {
            "id": "722100406",
            "speakerId": 1002,
            "speakerName": "「八宝」",
            "text": "喵，喵喵喵…喵…",
            "nextDialogs": [
              "722100407"
            ]
          },
          "722100407": {
            "id": "722100407",
            "speakerId": 1003,
            "speakerName": "「昆布丸」",
            "text": "喵！喵喵！",
            "nextDialogs": [
              "722100408"
            ]
          },
          "722100408": {
            "id": "722100408",
            "speakerId": 1000,
            "speakerName": "「寝子」",
            "text": "不许和奴家顶嘴！不然以后奴家可不去找汝等了，就给奴家从…从太阳还在天上，饿到月亮到天上，再饿到太阳跑到天上，然后再自己想办法回来吧！",
            "nextDialogs": [
              "722100409"
            ]
          },
          "722100409": {
            "id": "722100409",
            "speakerId": 1003,
            "speakerName": "「昆布丸」",
            "text": "喵…",
            "nextDialogs": [
              "722100410"
            ]
          },
          "722100410": {
            "id": "722100410",
            "speakerId": 1000,
            "speakerName": "「寝子」",
            "text": "呵呵，这才是好孩子，好了，回来就好。",
            "nextDialogs": [
              "722100411"
            ]
          },
          "722100411": {
            "id": "722100411",
            "speakerId": 1000,
            "speakerName": "「寝子」",
            "text": "多亏汝等了，要是没有汝等帮忙，这小家伙们又要在野外挨饿了。",
            "nextDialogs": [
              "722100412"
            ]
          },
          "722100412": {
            "id": "722100412",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "它们应该能自己回来…",
            "nextDialogs": [
              "722100413"
            ]
          },
          "722100413": {
            "id": "722100413",
            "speakerId": 1000,
            "speakerName": "「寝子」",
            "text": "总之，奴家很感谢。",
            "nextDialogs": [
              "722100414"
            ]
          },
          "722100414": {
            "id": "722100414",
            "speakerId": 1000,
            "speakerName": "「寝子」",
            "text": "有空的话，记得常来这边看看，奴家说不定还会有事要请汝等搭把手。"
          }
        }
      }
    }
  ]
}
  "subQuests": [
    {
      "subId": "7221001",
      "subQuestName": "test 与寝子对话 隐藏$HIDDEN",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "722100101"
        ],
        "dialogs": {
          "722100101": {
            "id": "722100101",
            "speakerId": 1000,
            "speakerName": "「寝子」",
            "text": "哎呀…喵喵，跑到哪里去了…",
            "nextDialogs": [
              "722100102"
            ]
          },
          "722100102": {
            "id": "722100102",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "怎么了？",
            "nextDialogs": [
              "722100103"
            ]
          },
          "722100103": {
            "id": "722100103",
            "speakerId": 1000,
            "speakerName": "「寝子」",
            "text": "是汝等啊。有些小家伙不知道跑到哪里玩了，真是令人担心哪。",
            "nextDialogs": [
              "722100104"
            ]
          },
          "722100104": {
            "id": "722100104",
            "speakerId": 1000,
            "speakerName": "「寝子」",
            "text": "外面可是很危险的。虽然奴家教过它们很多次了。外面又有拿棒子的毛茸茸人，又有…圆形的水和火的东西，可是相当危险哪。",
            "nextDialogs": [
              "722100105"
            ]
          },
          "722100105": {
            "id": "722100105",
            "speakerId": 1000,
            "speakerName": "「寝子」",
            "text": "如果跑到酥酥麻麻里面去，还会弄得全身的毛都竖起来。这种滋味，奴家可不希望小家伙们也体会到。",
            "nextDialogs": [
              "722100106"
            ]
          },
          "722100106": {
            "id": "722100106",
            "speakerId": 1000,
            "speakerName": "「寝子」",
            "text": "但总有几个不听话的小家伙到处乱跑，奴家每次都要费很大劲把它们找回来…",
            "nextDialogs": [
              "722100107"
            ]
          },
          "722100107": {
            "id": "722100107",
            "speakerId": 1000,
            "speakerName": "「寝子」",
            "text": "今天又有几个不知道跑到哪去了。好担心。",
            "nextDialogs": [
              "722100108"
            ]
          },
          "722100108": {
            "id": "722100108",
            "speakerId": 1000,
            "speakerName": "「寝子」",
            "text": "汝也帮奴家。找到「昆布丸」和「八宝」。",
            "nextDialogs": [
              "722100109"
            ]
          },
          "722100109": {
            "id": "722100109",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "「昆布丸」是…",
            "nextDialogs": [
              "722100110"
            ]
          },
          "722100110": {
            "id": "722100110",
            "speakerId": 1000,
            "speakerName": "「寝子」",
            "text": "是个好孩子。这一代昆布丸很聪明。",
            "nextDialogs": [
              "722100111"
            ]
          },
          "722100111": {
            "id": "722100111",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "「这一代」？",
            "nextDialogs": [
              "722100112"
            ]
          },
          "722100112": {
            "id": "722100112",
            "speakerId": 1000,
            "speakerName": "「寝子」",
            "text": "阿响有时候会说到的东西。奴家也不知道是什么，但看她说的时候的表情，那应该是好东西吧。",
            "nextDialogs": [
              "722100113"
            ]
          },
          "722100113": {
            "id": "722100113",
            "speakerId": 1000,
            "speakerName": "「寝子」",
            "text": "奴家会用好东西给小家伙取名字。等小家伙长大了、走了以后，奴家就会用这些名字，给更小更小的小家伙取名字。",
            "nextDialogs": [
              "722100114"
            ]
          },
          "722100114": {
            "id": "722100114",
            "speakerId": 1000,
            "speakerName": "「寝子」",
            "text": "「昆布丸」喜欢在高的地方睡觉。去好高好高的地方找。",
            "nextDialogs": [
              "722100115"
            ]
          },
          "722100115": {
            "id": "722100115",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "那，「八宝」是…",
            "nextDialogs": [
              "722100116"
            ]
          },
          "722100116": {
            "id": "722100116",
            "speakerId": 1000,
            "speakerName": "「寝子」",
            "text": "非常机灵的小家伙。很喜欢吃鱼。所以，有时候会在海边找被冲到岸上的鱼。",
            "nextDialogs": [
              "722100117"
            ]
          },
          "722100117": {
            "id": "722100117",
            "speakerId": 1000,
            "speakerName": "「寝子」",
            "text": "但是，很危险。水可是可怕的东西。好久好久以前，有个叫「吾辈」的小家伙就掉到水里去，差点就回不来了。",
            "nextDialogs": [
              "722100118"
            ]
          },
          "722100118": {
            "id": "722100118",
            "speakerId": 1000,
            "speakerName": "「寝子」",
            "text": "「八宝」应该在海边看，有没有小鱼和螃蟹。去有咸水的地方找。",
            "nextDialogs": [
              "722100119"
            ]
          },
          "722100119": {
            "id": "722100119",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "太宽泛了…",
            "nextDialogs": [
              "722100120"
            ]
          },
          "722100120": {
            "id": "722100120",
            "speakerId": 1000,
            "speakerName": "「寝子」",
            "text": "总之，就是，好高好高，还有咸水。",
            "nextDialogs": [
              "722100121"
            ]
          },
          "722100121": {
            "id": "722100121",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "总、总之，把地图拿出来让寝子看看…",
            "nextDialogs": [
              "722100122"
            ]
          },
          "722100122": {
            "id": "722100122",
            "speakerId": 1000,
            "speakerName": "「寝子」",
            "text": "汝啊，悟性不行哪。你看，这里就是好高好高。这里就是咸水。它们一定在这两个地方。",
            "nextDialogs": [
              "722100124",
              "722100126"
            ]
          },
          "722100124": {
            "id": "722100124",
            "speakerId": 1000,
            "speakerName": "「寝子」",
            "text": "那就拜托汝等了，喵喵，这些孩子可真是的…"
          },
          "722100126": {
            "id": "722100126",
            "speakerId": 1000,
            "speakerName": "「寝子」",
            "text": "喵喵，没关系，那些孩子都不怕人的…不如说，正是因为没人陪它们玩，它们才会到处乱跑呢。",
            "nextDialogs": [
              "722100127"
            ]
          },
          "722100127": {
            "id": "722100127",
            "speakerId": 1000,
            "speakerName": "「寝子」",
            "text": "那就拜托汝等了，喵喵，这些孩子可真是的…"
          }
        }
      }
    },
    {
      "subId": "7221002",
      "subQuestName": "前往海边，将小猫带回神社",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "722100201"
        ],
        "dialogs": {
          "722100201": {
            "id": "722100201",
            "speakerId": 1002,
            "speakerName": "「八宝」",
            "text": "喵，喵喵？",
            "nextDialogs": [
              "722100202"
            ]
          },
          "722100202": {
            "id": "722100202",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "啊，它应该就是寝子说的「八宝」了…",
            "nextDialogs": [
              "722100204",
              "722100206"
            ]
          },
          "722100204": {
            "id": "722100204",
            "speakerId": 1002,
            "speakerName": "「八宝」",
            "text": "喵喵。",
            "nextDialogs": [
              "722100207"
            ]
          },
          "722100207": {
            "id": "722100207",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "呜哇，好听话的小猫…"
          },
          "722100206": {
            "id": "722100206",
            "speakerId": 1002,
            "speakerName": "「八宝」",
            "text": "喵…喵喵喵？"
          }
        }
      }
    },

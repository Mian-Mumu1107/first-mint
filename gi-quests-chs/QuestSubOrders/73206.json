{
  "lineCounts": {
    "Black Screen": 1,
    "Player": 14,
    "派蒙": 3,
    "赛芭": 7,
    "阿凡": 64
  },
  "subQuests": [
    {
      "subId": "7320608",
      "subQuestName": "(test)73205与阿凡闲聊$HIDDEN",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "732050501"
        ],
        "dialogs": {
          "732050501": {
            "id": "732050501",
            "speakerId": 4233,
            "speakerName": "阿凡",
            "text": "♪蔷薇啊蔷薇，实现我的愿望…",
            "nextDialogs": [
              "732050502"
            ]
          },
          "732050502": {
            "id": "732050502",
            "speakerId": 4233,
            "speakerName": "阿凡",
            "text": "嗯？你们还在啊。",
            "nextDialogs": [
              "732050504",
              "732050514"
            ]
          },
          "732050504": {
            "id": "732050504",
            "speakerId": 4233,
            "speakerName": "阿凡",
            "text": "呵呵，反正我是个怪老头，「怪老头做事哪有为什么」，很少有人像你这样问我。",
            "nextDialogs": [
              "732050505"
            ]
          },
          "732050505": {
            "id": "732050505",
            "speakerId": 4233,
            "speakerName": "阿凡",
            "text": "我啊，这一辈子总想出去闯荡，想抓住机会做点什么。",
            "nextDialogs": [
              "732050506"
            ]
          },
          "732050506": {
            "id": "732050506",
            "speakerId": 4233,
            "speakerName": "阿凡",
            "text": "刚结婚不久的时候差点儿跟着镀金旅团离开，但想想总觉得不能抛下老婆出去漂泊。",
            "nextDialogs": [
              "732050507"
            ]
          },
          "732050507": {
            "id": "732050507",
            "speakerId": 4233,
            "speakerName": "阿凡",
            "text": "后来遇到行脚商，我又想跟着出去跑生意，最终因为本钱不够没走成。",
            "nextDialogs": [
              "732050508"
            ]
          },
          "732050508": {
            "id": "732050508",
            "speakerId": 4233,
            "speakerName": "阿凡",
            "text": "再后来老太婆不在了，我没牵挂了，可是年纪已经太老，没法离开了。",
            "nextDialogs": [
              "732050509"
            ]
          },
          "732050509": {
            "id": "732050509",
            "speakerId": 4233,
            "speakerName": "阿凡",
            "text": "拖拖拉拉混到今天，我错过的事情太多。",
            "nextDialogs": [
              "732050510"
            ]
          },
          "732050510": {
            "id": "732050510",
            "speakerId": 4233,
            "speakerName": "阿凡",
            "text": "回过头发现自己不属于这个村子，也不属于其他任何地方。",
            "nextDialogs": [
              "732050511"
            ]
          },
          "732050511": {
            "id": "732050511",
            "speakerId": 4233,
            "speakerName": "阿凡",
            "text": "最后结果么，就是我一个人搬到村子边上生活才舒服。",
            "nextDialogs": [
              "732050512"
            ]
          },
          "732050512": {
            "id": "732050512",
            "speakerId": 4233,
            "speakerName": "阿凡",
            "text": "几十年也就这么回事，算了。",
            "nextDialogs": [
              "732050525"
            ]
          },
          "732050525": {
            "id": "732050525",
            "speakerId": 4233,
            "speakerName": "阿凡",
            "text": "这些花开了我就叫你们来看，明天或者后天，它们说不定就开了，你有空来看吧？",
            "nextDialogs": [
              "732050526"
            ]
          },
          "732050526": {
            "id": "732050526",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "没问题。",
            "nextDialogs": [
              "732050527"
            ]
          },
          "732050527": {
            "id": "732050527",
            "speakerId": 4233,
            "speakerName": "阿凡",
            "text": "好好好，我知道了…",
            "nextDialogs": [
              "732050528"
            ]
          },
          "732050528": {
            "id": "732050528",
            "speakerId": 4233,
            "speakerName": "阿凡",
            "text": "♪蔷薇啊蔷薇，实现我的愿望…"
          },
          "732050514": {
            "id": "732050514",
            "speakerId": 4233,
            "speakerName": "阿凡",
            "text": "也就只有外来的人会打听鬼老头的事了，我们村里的小孩可都知道这个名字。",
            "nextDialogs": [
              "732050515"
            ]
          },
          "732050515": {
            "id": "732050515",
            "speakerId": 4233,
            "speakerName": "阿凡",
            "text": "哪家孩子不听话，孩子的父母就吓唬他：马上鬼老头要来把你抓走了。",
            "nextDialogs": [
              "732050516"
            ]
          },
          "732050516": {
            "id": "732050516",
            "speakerId": 4233,
            "speakerName": "阿凡",
            "text": "这些年轻人啊，一个都不认识鬼老头，倒挺会把他的名头搬出来吓人。",
            "nextDialogs": [
              "732050517"
            ]
          },
          "732050517": {
            "id": "732050517",
            "speakerId": 4233,
            "speakerName": "阿凡",
            "text": "我小的时候可是见过鬼老头本人的，他是讨厌小孩子没错，但长得也不恐怖。",
            "nextDialogs": [
              "732050518"
            ]
          },
          "732050518": {
            "id": "732050518",
            "speakerId": 4233,
            "speakerName": "阿凡",
            "text": "不知道怎么就被传成了鬼老头，我看都是一帮闲人在背后胡说八道。",
            "nextDialogs": [
              "732050519"
            ]
          },
          "732050519": {
            "id": "732050519",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "你们不是朋友吗？",
            "nextDialogs": [
              "732050520"
            ]
          },
          "732050520": {
            "id": "732050520",
            "speakerId": 4233,
            "speakerName": "阿凡",
            "text": "我还小的时候，经常溜到他的小花园附近玩，他一发现，就会挥着锄头把我赶走。",
            "nextDialogs": [
              "732050521"
            ]
          },
          "732050521": {
            "id": "732050521",
            "speakerId": 4233,
            "speakerName": "阿凡",
            "text": "他八成只把我当成去捣乱的调皮小子，哪里会记得我哟。",
            "nextDialogs": [
              "732050522"
            ]
          },
          "732050522": {
            "id": "732050522",
            "speakerId": 4233,
            "speakerName": "阿凡",
            "text": "虽然他不一定认识我，但我还是一直记得他和他的小花园。",
            "nextDialogs": [
              "732050523"
            ]
          },
          "732050523": {
            "id": "732050523",
            "speakerId": 4233,
            "speakerName": "阿凡",
            "text": "我说他是我的朋友，也不算错，不是吗？",
            "nextDialogs": [
              "732050524"
            ]
          },
          "732050524": {
            "id": "732050524",
            "speakerId": 4233,
            "speakerName": "阿凡",
            "text": "就当是为了还原我记忆里的小花园，我也会把这些花种出来的。"
          }
        }
      }
    },

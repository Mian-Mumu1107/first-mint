  },
  "subQuests": [
    {
      "subId": "2230401",
      "subQuestName": "与张顺对话",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "223040101"
        ],
        "dialogs": {
          "223040101": {
            "id": "223040101",
            "speakerId": 2033,
            "speakerName": "张顺",
            "text": "这可怎么办…",
            "nextDialogs": [
              "223040102"
            ]
          },
          "223040102": {
            "id": "223040102",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "怎么了？",
            "nextDialogs": [
              "223040103"
            ]
          },
          "223040103": {
            "id": "223040103",
            "speakerId": 2033,
            "speakerName": "张顺",
            "text": "我之前是南十字船队的水手，但是有次运气不好，受了伤…",
            "nextDialogs": [
              "223040104"
            ]
          },
          "223040104": {
            "id": "223040104",
            "speakerId": 2033,
            "speakerName": "张顺",
            "text": "退出船队之后，为了筹钱生活，我把几张藏宝图押给了一个叫博来的生意人。",
            "nextDialogs": [
              "223040105"
            ]
          },
          "223040105": {
            "id": "223040105",
            "speakerId": 2033,
            "speakerName": "张顺",
            "text": "如果真有宝藏，他也会匀我一份，但是一直没什么消息，我觉得他压根没有去找…",
            "nextDialogs": [
              "223040106"
            ]
          },
          "223040106": {
            "id": "223040106",
            "speakerId": 2033,
            "speakerName": "张顺",
            "text": "老是这样也不是个办法，你愿意帮我去找找宝藏吗？",
            "nextDialogs": [
              "223040108",
              "223040110"
            ]
          },
          "223040108": {
            "id": "223040108",
            "speakerId": 2033,
            "speakerName": "张顺",
            "text": "那就拜托你了。",
            "nextDialogs": [
              "223040120"
            ]
          },
          "223040120": {
            "id": "223040120",
            "speakerId": 2033,
            "speakerName": "张顺",
            "text": "你先去<color=#00E1FFFF>博来</color>那拿<color=#00E1FFFF>藏宝图</color>吧，然后把<color=#00E1FFFF>宝藏</color>直接带回去<color=#00E1FFFF>给他</color>。",
            "nextDialogs": [
              "223040121"
            ]
          },
          "223040121": {
            "id": "223040121",
            "speakerId": 2033,
            "speakerName": "张顺",
            "text": "我已经和他说好了，他会把我的那一份留着的。"
          },
          "223040110": {
            "id": "223040110",
            "speakerId": 2033,
            "speakerName": "张顺",
            "text": "我这个身子的情况我自己知道，随时可能旧伤复发，我可不想拖累船队，就自己退出了。",
            "nextDialogs": [
              "223040111"
            ]
          },
          "223040111": {
            "id": "223040111",
            "speakerId": 2033,
            "speakerName": "张顺",
            "text": "然后，我用自己之前搜集的一些零碎，在这里做点小生意谋生。但是这生意也不好做啊，东西也快卖光了…",
            "nextDialogs": [
              "223040112"
            ]
          },
          "223040112": {
            "id": "223040112",
            "speakerId": 2033,
            "speakerName": "张顺",
            "text": "我本来还有几张藏宝图，也是之前跟船的时候拿到的战利品。",
            "nextDialogs": [
              "223040113"
            ]
          },
          "223040113": {
            "id": "223040113",
            "speakerId": 2033,
            "speakerName": "张顺",
            "text": "但是我这个破身子，走路都费劲，哪里还能去探险呢？",
            "nextDialogs": [
              "223040114"
            ]
          },
          "223040114": {
            "id": "223040114",
            "speakerId": 2033,
            "speakerName": "张顺",
            "text": "我就把那几张藏宝图押给了那个叫博来的，换了几个钱。",
            "nextDialogs": [
              "223040115"
            ]
          },
          "223040115": {
            "id": "223040115",
            "speakerId": 2033,
            "speakerName": "张顺",
            "text": "不过他大概也没办法亲自去寻宝吧，毕竟也就是个普通商人…所以，宝藏的事就拜托你了。"
          }
        }
      }
    },
    {
      "subId": "2230402",
      "subQuestName": "与博来对话",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "223040801"
        ],
        "dialogs": {
          "223040801": {
            "id": "223040801",
            "speakerId": 2013,
            "speakerName": "博来",
            "text": "对了，您看得懂这藏宝图吗？",
            "nextDialogs": [
              "223040802"
            ]
          },
          "223040802": {
            "id": "223040802",
            "speakerId": 2013,
            "speakerName": "博来",
            "text": "不瞒您说，我当初刚拿到的时候，请过几个人来瞅了几眼。",
            "nextDialogs": [
              "223040803"
            ]
          },
          "223040803": {
            "id": "223040803",
            "speakerId": 2013,
            "speakerName": "博来",
            "text": "宝藏是在个什么地方，大致也已经摸清了。不过，他们说如果真要下手寻宝，我得另外加钱，所以我就没去寻…",
            "nextDialogs": [
              "223040804"
            ]
          },
          "223040804": {
            "id": "223040804",
            "speakerId": 2013,
            "speakerName": "博来",
            "text": "要是觉得自己解麻烦，那您和我说一声，我马上给您把地方标出来。",
            "nextDialogs": [
              "223040805"
            ]
          },
          "223040805": {
            "id": "223040805",
            "speakerId": 2013,
            "speakerName": "博来",
            "text": "不过费用嘛。嘿嘿，您多少得付点…就<color=#00E1FFFF>100摩拉</color>，您看怎么样。",
            "nextDialogs": [
              "223040806"
            ]
          },
          "223040806": {
            "id": "223040806",
            "speakerId": 2013,
            "speakerName": "博来",
            "text": "您看，需要我给您在藏宝图上<color=#00E1FFFF>标上地点</color>吗？"
          }
        }
      }
    },
    {
      "subId": "2230403",
      "subQuestName": "与博来对话$HIDDEN",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "223040301"
        ],
        "dialogs": {
          "223040301": {
            "id": "223040301",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "给我标上吧。",
            "nextDialogs": [
              "223040302"
            ]
          },
          "223040302": {
            "id": "223040302",
            "speakerId": 2013,
            "speakerName": "博来",
            "text": "好，我现在就把地方给您标好了。",
            "nextDialogs": [
              "223040303"
            ]
          },
          "223040303": {
            "id": "223040303",
            "speakerId": 2013,
            "speakerName": "博来",
            "text": "您走好，拿到宝藏之后，记得拿回来我们一起分啊。"
          }
        }
      }
    },
    {
      "subId": "2230404",
      "subQuestName": "寻找宝藏$HIDDEN",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "223040401"
        ],
        "dialogs": {
          "223040401": {
            "id": "223040401",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "不用了。",
            "nextDialogs": [
              "223040402"
            ]
          },
          "223040402": {
            "id": "223040402",
            "speakerId": 2013,
            "speakerName": "博来",
            "text": "那也行，都凭您自己的主意。",
            "nextDialogs": [
              "223040403"
            ]
          },
          "223040403": {
            "id": "223040403",
            "speakerId": 2013,
            "speakerName": "博来",
            "text": "您走好，拿到宝藏之后，记得拿回来我们一起分啊。"
          }
        }
      }
    },

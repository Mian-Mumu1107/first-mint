    {
      "subId": "2230405",
      "subQuestName": "与博来对话",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "223040601"
        ],
        "dialogs": {
          "223040601": {
            "id": "223040601",
            "speakerId": 2013,
            "speakerName": "博来",
            "text": "您回来了，宝藏找着了吗？",
            "nextDialogs": [
              "223040602"
            ]
          },
          "223040602": {
            "id": "223040602",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "找到了。",
            "nextDialogs": [
              "223040603"
            ]
          },
          "223040603": {
            "id": "223040603",
            "speakerId": 2013,
            "speakerName": "博来",
            "text": "不愧是实打实的冒险家，手脚这个麻利。",
            "nextDialogs": [
              "223040604"
            ]
          },
          "223040604": {
            "id": "223040604",
            "speakerId": 2013,
            "speakerName": "博来",
            "text": "那行，我看看啊，这个盒子…哼，没啥用的东西…",
            "nextDialogs": [
              "223040605"
            ]
          },
          "223040605": {
            "id": "223040605",
            "speakerId": 2013,
            "speakerName": "博来",
            "text": "不过还是辛苦你了，这份是您的，张顺的那份我留着，等他过来拿。",
            "nextDialogs": [
              "223040606"
            ]
          },
          "223040606": {
            "id": "223040606",
            "speakerId": 2013,
            "speakerName": "博来",
            "text": "唉，还是没找着，那群家伙别是把我给蒙了吧…"
          }
        }
      }
    },
    {
      "subId": "2230405",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "223040501"
        ],
        "dialogs": {
          "223040501": {
            "id": "223040501",
            "speakerId": 2033,
            "speakerName": "张顺",
            "text": "要是没受伤…肯定能和大姐头一起，找到更多宝藏吧…",
            "nextDialogs": [
              "223040502"
            ]
          },
          "223040502": {
            "id": "223040502",
            "speakerId": 2033,
            "speakerName": "张顺",
            "text": "唉，真想再去船上看看…"
          }
        }
      }
    },
    {
      "subId": "2230407",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "223040701"
        ],
        "dialogs": {
          "223040701": {
            "id": "223040701",
            "speakerId": 2013,
            "speakerName": "博来",
            "text": "您真不需要？就是一点小小的消息…"
          }
        }
      }
    },
    {
      "subId": "2230409",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "223040901"
        ],
        "dialogs": {
          "223040901": {
            "id": "223040901",
            "speakerId": 2013,
            "speakerName": "博来",
            "text": "您回来了，宝藏找着了吗？",
            "nextDialogs": [
              "223040902"
            ]
          },
          "223040902": {
            "id": "223040902",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "找到了。",
            "nextDialogs": [
              "223040903"
            ]
          },
          "223040903": {
            "id": "223040903",
            "speakerId": 2013,
            "speakerName": "博来",
            "text": "不愧是实打实的冒险家，手脚这个麻利。",
            "nextDialogs": [
              "223040904"
            ]
          },
          "223040904": {
            "id": "223040904",
            "speakerId": 2013,
            "speakerName": "博来",
            "text": "那行，我看看啊，这个盒子…这是什么，地图的残片？",
            "nextDialogs": [
              "223040905"
            ]
          },
          "223040905": {
            "id": "223040905",
            "speakerId": 2013,
            "speakerName": "博来",
            "text": "那群家伙说的居然是真的，在那些破烂藏宝图里面，藏着真宝藏的线索…",
            "nextDialogs": [
              "223040906"
            ]
          },
          "223040906": {
            "id": "223040906",
            "speakerId": 2013,
            "speakerName": "博来",
            "text": "咦？您怎么还在这，这份是您的，您…您赶紧忙您的去吧，张顺那一份我留着等他来拿。"
          }
        }
      }
    }
  ]

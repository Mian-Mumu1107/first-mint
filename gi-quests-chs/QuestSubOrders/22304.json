    {
      "subId": "2230441",
      "subQuestName": "",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "223040201"
        ],
        "dialogs": {
          "223040201": {
            "id": "223040201",
            "speakerId": 2013,
            "speakerName": "博来",
            "text": "喂，朋友，货要不要？",
            "nextDialogs": [
              "223040202"
            ]
          },
          "223040202": {
            "id": "223040202",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "要藏宝图。",
            "nextDialogs": [
              "223040203"
            ]
          },
          "223040203": {
            "id": "223040203",
            "speakerId": 2013,
            "speakerName": "博来",
            "text": "藏宝图？哦…你是说张顺押在我这的那些是吧。",
            "nextDialogs": [
              "223040204"
            ]
          },
          "223040204": {
            "id": "223040204",
            "speakerId": 2013,
            "speakerName": "博来",
            "text": "嚯，你还真想去看看藏着什么宝贝？我还是权当收着玩玩呢…",
            "nextDialogs": [
              "223040205"
            ]
          },
          "223040205": {
            "id": "223040205",
            "speakerId": 2013,
            "speakerName": "博来",
            "text": "一看你就是个实打实的冒险家，听见宝藏两个字眼睛都在放光。",
            "nextDialogs": [
              "223040206"
            ]
          },
          "223040206": {
            "id": "223040206",
            "speakerId": 2013,
            "speakerName": "博来",
            "text": "反正这些藏宝图我要了也没用，给你也没关系。",
            "nextDialogs": [
              "223040207"
            ]
          },
          "223040207": {
            "id": "223040207",
            "speakerId": 2013,
            "speakerName": "博来",
            "text": "不过，你要是真找到了宝贝，咱们得匀一匀。",
            "nextDialogs": [
              "223040208"
            ]
          },
          "223040208": {
            "id": "223040208",
            "speakerId": 2013,
            "speakerName": "博来",
            "text": "毕竟这藏宝图在我这放了这么久，仓储费那也得付点不是…"
          }
        }
      }
    },

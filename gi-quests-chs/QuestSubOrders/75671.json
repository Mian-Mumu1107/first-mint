        "dialogs": {
          "756710101": {
            "id": "756710101",
            "speakerId": 1000,
            "speakerName": "拜希麦·五世",
            "text": "啾啾，咕咕，啾啾啾！",
            "nextDialogs": [
              "756710102"
            ]
          },
          "756710102": {
            "id": "756710102",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "这是在…干什么呢？",
            "nextDialogs": [
              "756710105"
            ]
          },
          "756710105": {
            "id": "756710105",
            "speakerId": 1000,
            "speakerName": "拜希麦·五世",
            "text": "是哦！是和可爱团雀沟通的技巧！",
            "nextDialogs": [
              "756710106"
            ]
          },
          "756710106": {
            "id": "756710106",
            "speakerId": 1000,
            "speakerName": "拜希麦·五世",
            "text": "哦，我好像忘了和你们打招呼了，还有那句必不可少的开场白。",
            "nextDialogs": [
              "756710107"
            ]
          },
          "756710107": {
            "id": "756710107",
            "speakerId": 1000,
            "speakerName": "拜希麦·五世",
            "text": "两位路过的好心人，生论派的学者、新星商人和可爱动物专家拜希麦五世向你们问好。",
            "nextDialogs": [
              "756710108"
            ]
          },
          "756710108": {
            "id": "756710108",
            "speakerId": 1000,
            "speakerName": "拜希麦·五世",
            "text": "请放松身体，放空思绪，听我说一件重要的事————",
            "nextDialogs": [
              "756710109"
            ]
          },
          "756710109": {
            "id": "756710109",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "团雀最可爱？",
            "nextDialogs": [
              "756710110"
            ]
          },
          "756710110": {
            "id": "756710110",
            "speakerId": 1000,
            "speakerName": "拜希麦·五世",
            "text": "完全正确！恭喜你被团雀的可爱感染，开始了抢答！",
            "nextDialogs": [
              "756710111"
            ]
          },
          "756710111": {
            "id": "756710111",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "奇怪，不知道为什么，好像看见桌上的游戏，脑袋里就冒出了这句话。",
            "nextDialogs": [
              "756710112"
            ]
          },
          "756710112": {
            "id": "756710112",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "#你有印象吗，{NICKNAME}？"
          }
        }
      }
    }
  ]

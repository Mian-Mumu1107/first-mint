    {
      "subId": "7182102",
      "subQuestName": "前往指定地点回收霄灯",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "718210201"
        ],
        "dialogs": {
          "718210201": {
            "id": "718210201",
            "speakerId": 1001,
            "speakerName": "快拳阿凌",
            "text": "怎么会这样！",
            "nextDialogs": [
              "718210202"
            ]
          },
          "718210202": {
            "id": "718210202",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "你怎么在这里？",
            "nextDialogs": [
              "718210203"
            ]
          },
          "718210203": {
            "id": "718210203",
            "speakerId": 1001,
            "speakerName": "快拳阿凌",
            "text": "我…唉，是这样，师父说，他最近领悟出了一套新的腿法，非常厉害！",
            "nextDialogs": [
              "718210204"
            ]
          },
          "718210204": {
            "id": "718210204",
            "speakerId": 1001,
            "speakerName": "快拳阿凌",
            "text": "他说我的心不够诚，基本功也不到家，不愿意将腿法传授于我…",
            "nextDialogs": [
              "718210205"
            ]
          },
          "718210205": {
            "id": "718210205",
            "speakerId": 1001,
            "speakerName": "快拳阿凌",
            "text": "不过我想正好现在赶上海灯节，我诚心献一盏霄灯给师父，说不定他心情一好就愿意传授我了呢？",
            "nextDialogs": [
              "718210206"
            ]
          },
          "718210206": {
            "id": "718210206",
            "speakerId": 1001,
            "speakerName": "快拳阿凌",
            "text": "但我实在找不到浮生石了，看见了有一盏霄灯卡在那，就想去把那盏霄灯的浮生石拿过来…",
            "nextDialogs": [
              "718210207"
            ]
          },
          "718210207": {
            "id": "718210207",
            "speakerId": 1001,
            "speakerName": "快拳阿凌",
            "text": "结果就是这样了…唉，霄灯我还是别要了，给你吧。",
            "nextDialogs": [
              "718210208"
            ]
          },
          "718210208": {
            "id": "718210208",
            "speakerId": 1001,
            "speakerName": "快拳阿凌",
            "text": "居然被魔物逼成这样，我的基本功果然还是不到家啊…"
          }
        }
      }
    },
    {
      "subId": "7182103",
      "subQuestName": "回收霄灯",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "718210301"
        ],
        "dialogs": {
          "718210301": {
            "id": "718210301",
            "speakerId": 1000,
            "speakerName": "宏宇",
            "text": "怎么样，那些地方有需要回收的霄灯吗？",
            "nextDialogs": [
              "718210302"
            ]
          },
          "718210302": {
            "id": "718210302",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "回收了三盏霄灯。",
            "nextDialogs": [
              "718210303"
            ]
          },
          "718210303": {
            "id": "718210303",
            "speakerId": 1000,
            "speakerName": "宏宇",
            "text": "多谢了，要回收那些地方的霄灯真是太费事了，我每次过去都累得要命…",
            "nextDialogs": [
              "718210304"
            ]
          },
          "718210304": {
            "id": "718210304",
            "speakerId": 1000,
            "speakerName": "宏宇",
            "text": "有你帮忙，我总算能轻松点了。对了，这是给你的报酬，辛苦你了。"
          }
        }
      }
    },
    {
      "subId": "7182104",
      "subQuestName": "前往指定地点回收霄灯",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "718210401"
        ],
        "dialogs": {
          "718210401": {
            "id": "718210401",
            "speakerId": 1000,
            "speakerName": "宏宇",
            "text": "人家往外放霄灯，我往回收霄灯，总觉得有点不对头啊…"
          }
        }
      }
    },
    {
      "subId": "7182105",
      "subQuestName": "回收霄灯",
      "sceneId": null,

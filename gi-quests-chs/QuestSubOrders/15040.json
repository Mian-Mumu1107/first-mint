        "dialogs": {
          "150401001": {
            "id": "150401001",
            "speakerId": 1002,
            "speakerName": "玛拉妮",
            "text": "好的！「飘飘巡风阿夏」状态很好，所有人都在镜头之中。恰斯卡，再往中间靠一点！",
            "nextDialogs": [
              "150401002"
            ]
          },
          "150401002": {
            "id": "150401002",
            "speakerId": 1000,
            "speakerName": "班尼特",
            "text": "好激动！",
            "nextDialogs": [
              "150401003"
            ]
          },
          "150401003": {
            "id": "150401003",
            "speakerId": 1002,
            "speakerName": "玛拉妮",
            "text": "都准备好了吗？",
            "nextDialogs": [
              "150401004"
            ]
          },
          "150401004": {
            "id": "150401004",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "你也别忘了回来噢！",
            "nextDialogs": [
              "150401005"
            ]
          },
          "150401005": {
            "id": "150401005",
            "speakerId": 1002,
            "speakerName": "玛拉妮",
            "text": "别担心别担心，一个甩尾的事。来喽！",
            "nextDialogs": [
              "150401006"
            ]
          },
          "150401006": {
            "id": "150401006",
            "speakerId": 1002,
            "speakerName": "玛拉妮",

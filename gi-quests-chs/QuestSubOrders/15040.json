    {
      "subId": "1504006",
      "subQuestName": "与众人对话",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "150400601"
        ],
        "dialogs": {
          "150400601": {
            "id": "150400601",
            "speakerId": 1000,
            "speakerName": "班尼特",
            "text": "哈…满足了满足了！谢谢你，我的好对手，我和阿夏玩得都很尽兴！",
            "nextDialogs": [
              "150400606",
              "150400605"
            ]
          },
          "150400606": {
            "id": "150400606",
            "speakerId": 1002,
            "speakerName": "玛拉妮",
            "text": "辛苦你们啦！",
            "nextDialogs": [
              "150400607"
            ]
          },
          "150400607": {
            "id": "150400607",
            "speakerId": 1006,
            "speakerName": "提可菈",
            "text": "#恭喜{NICKNAME}取得了最终胜利，也要感谢救星先生和阿夏展现出的精彩配合。",
            "nextDialogs": [
              "150400608"
            ]
          },
          "150400608": {
            "id": "150400608",
            "speakerId": 1004,
            "speakerName": "阿夏",
            "text": "♪",
            "nextDialogs": [
              "150400609"
            ]
          },
          "150400609": {
            "id": "150400609",
            "speakerId": 1006,
            "speakerName": "提可菈",
            "text": "先前听到你解读阿夏语句的时候，我还不太相信呢。但经过这一场比赛，不得不说，我是开眼界了…",
            "nextDialogs": [
              "150400610"
            ]
          },
          "150400610": {
            "id": "150400610",
            "speakerId": 1002,
            "speakerName": "玛拉妮",
            "text": "我也是我也是，我为两边都捏了一把汗，感觉就像在旁观「归火圣夜巡礼」的决赛一样。",
            "nextDialogs": [
              "150400611"
            ]
          },
          "150400611": {
            "id": "150400611",
            "speakerId": 1003,
            "speakerName": "恰斯卡",
            "text": "能理解。「争斗」到了白热化的阶段，我都手痒得想飞上来，再丢几发子弹。",
            "nextDialogs": [
              "150400612"
            ]
          },
          "150400612": {
            "id": "150400612",
            "speakerId": 1002,
            "speakerName": "玛拉妮",
            "text": "你的子弹还能染色？",
            "nextDialogs": [
              "150400613"
            ]
          },
          "150400613": {
            "id": "150400613",
            "speakerId": 1003,
            "speakerName": "恰斯卡",
            "text": "能，但具体染上什么颜色我就不好说了。恐怕会变成「咚咚坠落阿夏」。",
            "nextDialogs": [
              "150400614"
            ]
          },
          "150400614": {
            "id": "150400614",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "呃——",
            "nextDialogs": [
              "150400615"
            ]
          },
          "150400615": {
            "id": "150400615",
            "speakerId": 1006,
            "speakerName": "提可菈",
            "text": "哈哈，现在，距离「飘飘巡风阿夏」的完成只差最后一步了。",
            "nextDialogs": [
              "150400616"
            ]
          },
          "150400616": {
            "id": "150400616",
            "speakerId": 1006,
            "speakerName": "提可菈",
            "text": "#请{M#两位救星先生}{F#救星小姐和救星先生}点亮「飘飘巡风阿夏」的笔刷吧！",
            "nextDialogs": [
              "150400617"
            ]
          },
          "150400617": {
            "id": "150400617",
            "speakerId": 1005,
            "speakerName": "Black Screen",
            "text": "（播放涂鸦灵地标的timeline）",
            "nextDialogs": [
              "150400618"
            ]
          },
          "150400618": {
            "id": "150400618",
            "speakerId": 1006,
            "speakerName": "提可菈",
            "text": "很棒吧？我给大家推荐一个观景点，用来拍合照特别好！"
          },
          "150400605": {
            "id": "150400605",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "这种时候才想起我已经晚了！彻底晚了啦！"
          }
        }
      }

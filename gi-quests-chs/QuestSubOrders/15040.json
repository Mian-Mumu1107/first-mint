    },
    {
      "subId": "1504003",
      "subQuestName": "与众人对话",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "150400301"
        ],
        "dialogs": {
          "150400301": {
            "id": "150400301",
            "speakerId": 1002,
            "speakerName": "玛拉妮",
            "text": "哇，效果真棒！「沫彩花海」终于像模像样了！",
            "nextDialogs": [
              "150400302"
            ]
          },
          "150400302": {
            "id": "150400302",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "各位都辛苦啦，剩下的，只需要找到那位工作人员说一声就行了吧？",
            "nextDialogs": [
              "150400303"
            ]
          },
          "150400303": {
            "id": "150400303",
            "speakerId": 1006,
            "speakerName": "提可菈",
            "text": "几位请留步，呼…呼…",
            "nextDialogs": [
              "150400304"
            ]
          },
          "150400304": {
            "id": "150400304",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "说来就来了？",
            "nextDialogs": [
              "150400305"
            ]
          },
          "150400305": {
            "id": "150400305",
            "speakerId": 1000,
            "speakerName": "班尼特",
            "text": "别急，请慢点说。",
            "nextDialogs": [
              "150400306"
            ]
          },
          "150400306": {
            "id": "150400306",
            "speakerId": 1006,
            "speakerName": "提可菈",
            "text": "呼…好的，我是负责彩彩崖主要挑战项目「飘飘巡风阿夏」的工作人员。",
            "nextDialogs": [
              "150400307"
            ]
          },
          "150400307": {
            "id": "150400307",
            "speakerId": 1006,
            "speakerName": "提可菈",
            "text": "刚才从高处看到这里的草地突然之间变成了花海，还是那么富有艺术美感的配色，吓得望远镜都快掉了下来…",
            "nextDialogs": [
              "150400308"
            ]
          },
          "150400308": {
            "id": "150400308",
            "speakerId": 1006,
            "speakerName": "提可菈",
            "text": "你们…你们简直是彩彩崖的救星啊！",
            "nextDialogs": [
              "150400309"
            ]
          },
          "150400309": {
            "id": "150400309",
            "speakerId": 1004,
            "speakerName": "阿夏",
            "text": "♪",
            "nextDialogs": [
              "150400310"
            ]
          },
          "150400310": {
            "id": "150400310",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "举手之劳，嘿嘿，出力的主要是他俩啦。",
            "nextDialogs": [
              "150400311"
            ]
          },
          "150400311": {
            "id": "150400311",
            "speakerId": 1006,
            "speakerName": "提可菈",
            "text": "#{M#两位救星先生}{F#救星小姐和救星先生}，请问你们愿意尝试我这边的项目…",
            "nextDialogs": [
              "150400312"
            ]
          },
          "150400312": {
            "id": "150400312",
            "speakerId": 1006,
            "speakerName": "提可菈",
            "text": "不…请问你们愿意为我们的标志性建筑染上色彩吗？",
            "nextDialogs": [
              "150400313"
            ]
          },
          "150400313": {
            "id": "150400313",
            "speakerId": 1000,
            "speakerName": "班尼特",
            "text": "听着好厉害啊…真的可以吗？",
            "nextDialogs": [
              "150400314"
            ]
          },
          "150400314": {
            "id": "150400314",
            "speakerId": 1006,
            "speakerName": "提可菈",
            "text": "当然可以，绝对可以，不如说…恳请你们答应！",
            "nextDialogs": [
              "150400315"
            ]
          },
          "150400315": {
            "id": "150400315",
            "speakerId": 1006,
            "speakerName": "提可菈",
            "text": "一想到我那位同事平白蒙受了各位的照顾，我理应替他答谢你们！我想这份体验或许比酬金更特殊…",
            "nextDialogs": [
              "150400316"
            ]
          },
          "150400316": {
            "id": "150400316",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "那我还是觉得…",
            "nextDialogs": [
              "150400317"
            ]
          },
          "150400317": {
            "id": "150400317",
            "speakerId": 1000,
            "speakerName": "班尼特",
            "text": "她的意思是我们答应了！哈哈，请问要怎么过去？",
            "nextDialogs": [
              "150400318"
            ]
          },
          "150400318": {
            "id": "150400318",
            "speakerId": 1006,
            "speakerName": "提可菈",
            "text": "请随我来，我们乘坐热气球上去。"
          }
        }
      }
    },
    {
      "subId": "1504004",
      "subQuestName": "乘坐热气球，前往「飘飘巡风阿夏」",

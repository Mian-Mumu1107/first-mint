    {
      "subId": "1504007",
      "subQuestName": "与众人对话",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "150400701"
        ],
        "dialogs": {
          "150400701": {
            "id": "150400701",
            "speakerId": 1006,
            "speakerName": "提可菈",
            "text": "我们到了，这就是「飘飘巡风阿夏」。",
            "nextDialogs": [
              "150400702"
            ]
          },
          "150400702": {
            "id": "150400702",
            "speakerId": 1000,
            "speakerName": "班尼特",
            "text": "哇噢，太酷了！近看它居然那么大…",
            "nextDialogs": [
              "150400703"
            ]
          },
          "150400703": {
            "id": "150400703",
            "speakerId": 1000,
            "speakerName": "班尼特",
            "text": "喷绘上颜色之后，即使站在很远的地方，也能眺望到它吧？",
            "nextDialogs": [
              "150400704"
            ]
          },
          "150400704": {
            "id": "150400704",
            "speakerId": 1006,
            "speakerName": "提可菈",
            "text": "当然，只要地形开阔，不被山体遮挡，无论是从呼呼丘的屋顶泳池，还是提提岛那边的峡湾，全都看得到！",
            "nextDialogs": [
              "150400705"
            ]
          },
          "150400705": {
            "id": "150400705",
            "speakerId": 1002,
            "speakerName": "玛拉妮",
            "text": "真为你们骄傲。好好发挥啊，二位！",
            "nextDialogs": [
              "150400706"
            ]
          },
          "150400706": {
            "id": "150400706",
            "speakerId": 1000,
            "speakerName": "班尼特",
            "text": "啊…我已经开始激动了，要用什么颜色好呢…我的幸运色？还是…",
            "nextDialogs": [
              "150400707"
            ]
          },
          "150400707": {
            "id": "150400707",
            "speakerId": 1004,
            "speakerName": "阿夏",
            "text": "♪",
            "nextDialogs": [
              "150400708"
            ]
          },
          "150400708": {
            "id": "150400708",
            "speakerId": 1004,
            "speakerName": "阿夏",
            "text": "♪",
            "nextDialogs": [
              "150400709"
            ]
          },
          "150400709": {
            "id": "150400709",
            "speakerId": 1004,
            "speakerName": "阿夏",
            "text": "♪~",
            "nextDialogs": [
              "150400710"
            ]
          },
          "150400710": {
            "id": "150400710",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "唔，它这是一口气说了好长一段话？",
            "nextDialogs": [
              "150400711"
            ]
          },
          "150400711": {
            "id": "150400711",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "恰斯卡，你看着的吧？再替大家翻译翻译呢？",
            "nextDialogs": [
              "150400712"
            ]
          },
          "150400712": {
            "id": "150400712",
            "speakerId": 1003,
            "speakerName": "恰斯卡",
            "text": "嗯…信息量太多，我得算算到底有多少种可能性…",
            "nextDialogs": [
              "150400713"
            ]
          },
          "150400713": {
            "id": "150400713",
            "speakerId": 1000,
            "speakerName": "班尼特",
            "text": "#我想我明白了它的意思。阿夏是想和我组队，和{NICKNAME}比拼一番。",
            "nextDialogs": [
              "150400714"
            ]
          },
          "150400714": {
            "id": "150400714",
            "speakerId": 1000,
            "speakerName": "班尼特",
            "text": "它喜欢和朋友合作，共同帮助有需要的人。",
            "nextDialogs": [
              "150400715"
            ]
          },
          "150400715": {
            "id": "150400715",
            "speakerId": 1000,
            "speakerName": "班尼特",
            "text": "但具备竞技性的挑战才会让平凡的活动变成令人兴奋不已的冒险，它很享受这份刺激。",
            "nextDialogs": [
              "150400716"
            ]
          },
          "150400716": {
            "id": "150400716",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "它…它真说了那么多？",
            "nextDialogs": [
              "150400717"
            ]
          },
          "150400717": {
            "id": "150400717",
            "speakerId": 1000,
            "speakerName": "班尼特",
            "text": "哈哈，大意吧！也加入了我自己的理解。",
            "nextDialogs": [
              "150400718"
            ]
          },
          "150400718": {
            "id": "150400718",
            "speakerId": 1004,
            "speakerName": "阿夏",
            "text": "♪",
            "nextDialogs": [
              "150400719"
            ]
          },
          "150400719": {
            "id": "150400719",
            "speakerId": 1002,
            "speakerName": "玛拉妮",
            "text": "看这反应好像是说中了，他俩的感情还真是越来越好了…",
            "nextDialogs": [
              "150400720"
            ]
          },
          "150400720": {
            "id": "150400720",
            "speakerId": 1000,
            "speakerName": "班尼特",
            "text": "#好啦，阿夏，虽然我和你有着相同的想法…但我们不该让{NICKNAME}迁就我们的喜好，对吗？",
            "nextDialogs": [
              "150400721"
            ]
          },
          "150400721": {
            "id": "150400721",
            "speakerId": 1000,
            "speakerName": "班尼特",
            "text": "要认真尊重朋友的心情和意见哦！",
            "nextDialogs": [
              "150400722"
            ]
          },
          "150400722": {
            "id": "150400722",
            "speakerId": 1004,
            "speakerName": "阿夏",
            "text": "♪",
            "nextDialogs": [
              "150400724",
              "150400727",
              "150400730"
            ]
          },
          "150400724": {
            "id": "150400724",
            "speakerId": 1000,
            "speakerName": "班尼特",
            "text": "「那我接受你的挑战。」",
            "nextDialogs": [
              "150400725"
            ]
          },
          "150400725": {
            "id": "150400725",
            "speakerId": 1000,
            "speakerName": "班尼特",
            "text": "啊哈哈…看到你的表情，我实在没办法把这句话说出气势来啊。",
            "nextDialogs": [
              "150400732"
            ]
          },
          "150400732": {
            "id": "150400732",
            "speakerId": 1006,
            "speakerName": "提可菈",
            "text": "两边的参赛选手都准备好了吗？那就跟我来吧，由我担任裁判。"
          },
          "150400727": {
            "id": "150400727",
            "speakerId": 1000,
            "speakerName": "班尼特",
            "text": "#不行，只有我们开心是不够的！{NICKNAME}，我希望你也能享受其中。",
            "nextDialogs": [
              "150400728"
            ]
          },
          "150400728": {
            "id": "150400728",
            "speakerId": 1000,
            "speakerName": "班尼特",
            "text": "来吧！不要有压力，玩得开心最重要！"
          },
          "150400730": {
            "id": "150400730",
            "speakerId": 1000,
            "speakerName": "班尼特",
            "text": "#{NICKNAME}很有自信啊！好！那我也要使出全力了！",
            "nextDialogs": [
              "150400731"
            ]
          },
          "150400731": {
            "id": "150400731",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "喂！我可一直都是和你一队的呀！"
          }
        }
      }

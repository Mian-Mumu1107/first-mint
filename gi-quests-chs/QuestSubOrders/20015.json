      }
    },
    {
      "subId": "2001501",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "200150101"
        ],
        "dialogs": {
          "200150101": {
            "id": "200150101",
            "speakerId": 1000,
            "speakerName": "艾拉·马斯克",
            "text": "旅行者，这里，过来这里！",
            "nextDialogs": [
              "200150102"
            ]
          },
          "200150102": {
            "id": "200150102",
            "speakerId": 1000,
            "speakerName": "艾拉·马斯克",
            "text": "别惊动了那些丘丘人，你怎么总是直挺挺地往营地里面冲呀…",
            "nextDialogs": [
              "200150103"
            ]
          },
          "200150103": {
            "id": "200150103",
            "speakerId": 1000,
            "speakerName": "艾拉·马斯克",
            "text": "算了，不管这些了，我一直在研究丘丘人的语言，但是比起记录，我更想要研究口语。",
            "nextDialogs": [
              "200150104"
            ]
          },
          "200150104": {
            "id": "200150104",
            "speakerId": 1000,
            "speakerName": "艾拉·马斯克",
            "text": "好不容易在这里遇见了一个完整的丘丘人营地，我可不能放过这个机会。",
            "nextDialogs": [
              "200150105"
            ]
          },
          "200150105": {
            "id": "200150105",
            "speakerId": 1000,
            "speakerName": "艾拉·马斯克",
            "text": "所以，旅行者，你能和我一起去这营地里面，找个丘丘人来练习口语吗？"
          }
        }
      }
    }
  ]
}
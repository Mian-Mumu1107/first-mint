    {
      "subId": "2001508",
      "subQuestName": "接近醒着的丘丘人，不能吵醒其他丘丘人",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "200150801"
        ],
        "dialogs": {
          "200150801": {
            "id": "200150801",
            "speakerId": 1000,
            "speakerName": "艾拉·马斯克",
            "text": "都说了别惊醒其他的丘丘人了，你难道从来没有「悄悄接近」丘丘人营地的经验吗？",
            "nextDialogs": [
              "200150802"
            ]
          },
          "200150802": {
            "id": "200150802",
            "speakerId": 1000,
            "speakerName": "艾拉·马斯克",
            "text": "唉，这个营地已经没有丘丘人了，大好的机会就被这么浪费了。只能下次再说了。"
          }
        }
      }
    },
    {
      "subId": "2001510",
      "subQuestName": "(test)惊醒丘丘人$HIDDEN",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "200151001"
        ],
        "dialogs": {
          "200151001": {
            "id": "200151001",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "还是你自己去吧。",
            "nextDialogs": [
              "200151002"
            ]
          },
          "200151002": {
            "id": "200151002",
            "speakerId": 1000,
            "speakerName": "艾拉·马斯克",
            "text": "不行！这是个宝贵的学习机会，就算你想偷懒，我也不会放你走的！"
          }
        }
      }
    },
    {
      "subId": "2001514",
      "subQuestName": "(test)陪同艾拉·马斯克与丘丘人对话$HIDDEN",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "200150601"
        ],
        "dialogs": {
          "200150601": {
            "id": "200150601",
            "speakerId": 1000,
            "speakerName": "艾拉·马斯克",
            "text": "Olah! Muhe mimi, nye, eh... mosi aba?",
            "nextDialogs": [
              "200150602"
            ]
          },
          "200150602": {
            "id": "200150602",
            "speakerId": 1001,
            "speakerName": "丘丘人",
            "text": "Yo mimi beru si?",
            "nextDialogs": [
              "200150603"
            ]
          },
          "200150603": {
            "id": "200150603",
            "speakerId": 1000,
            "speakerName": "艾拉·马斯克",
            "text": "Buka...mita nye, guru-guru...yo mosi ka?",
            "nextDialogs": [
              "200150604"
            ]
          },
          "200150604": {
            "id": "200150604",
            "speakerId": 1001,
            "speakerName": "丘丘人",
            "text": "Ya odomu, Todo yo, buka guru-guru nye.",
            "nextDialogs": [
              "200150605"
            ]
          },
          "200150605": {
            "id": "200150605",
            "speakerId": 1000,
            "speakerName": "艾拉·马斯克",
            "text": "Mi? Dada! Valo.",
            "nextDialogs": [
              "200150606"
            ]
          },
          "200150606": {
            "id": "200150606",
            "speakerId": 1001,
            "speakerName": "丘丘人",
            "text": "Valo, ya odomu.",
            "nextDialogs": [
              "200150607"
            ]
          },
          "200150607": {
            "id": "200150607",
            "speakerId": 1000,
            "speakerName": "艾拉·马斯克",
            "text": "嘻嘻，看这个丘丘人的动作，好像很开心的样子呢。",
            "nextDialogs": [
              "200150608"
            ]
          },
          "200150608": {
            "id": "200150608",
            "speakerId": 1000,
            "speakerName": "艾拉·马斯克",
            "text": "看样子这次的交流成功了，我的丘丘人口语果然很不错。"
          }
        }
      }
    },
    {
      "subId": "2001504",
      "subQuestName": "(test)陪同艾拉·马斯克与丘丘人对话$HIDDEN",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "200150301"
        ],
        "dialogs": {
          "200150301": {
            "id": "200150301",
            "speakerId": 1000,
            "speakerName": "艾拉·马斯克",
            "text": "Biat ye, ye pupu dada mosi! Plama ye upa dada!",
            "nextDialogs": [
              "200150302"
            ]
          },
          "200150302": {
            "id": "200150302",
            "speakerId": 1001,
            "speakerName": "丘丘人",
            "text": "Dala beru yo?! Kundala muhe, kucha?",
            "nextDialogs": [
              "200150303"
            ]
          },
          "200150303": {
            "id": "200150303",
            "speakerId": 1000,
            "speakerName": "艾拉·马斯克",
            "text": "Kundala gusha! Hahaha!",
            "nextDialogs": [
              "200150304"
            ]
          },
          "200150304": {
            "id": "200150304",
            "speakerId": 1001,
            "speakerName": "丘丘人",
            "text": "Biat ye, plata ye pupu!",
            "nextDialogs": [
              "200150305"
            ]
          },
          "200150305": {
            "id": "200150305",
            "speakerId": 1001,
            "speakerName": "丘丘人",
            "text": "Movo unta nye kucha, mi dada tiga mitono!",
            "nextDialogs": [
              "200150306"
            ]
          },
          "200150306": {
            "id": "200150306",
            "speakerId": 1000,
            "speakerName": "艾拉·马斯克",
            "text": "看来他听懂我说的话了，正在准备拿礼物给我们…",
            "nextDialogs": [
              "200150307"
            ]
          },
          "200150307": {
            "id": "200150307",
            "speakerId": 1000,
            "speakerName": "艾拉·马斯克",
            "text": "是，是武器！呜呜呜呜呜，旅行者！救救我！"
          }
        }
      }
    },
    {
      "subId": "2001507",
      "subQuestName": "(test)控制刷怪$HIDDEN",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "200150701"
        ],
        "dialogs": {
          "200150701": {
            "id": "200150701",
            "speakerId": 1000,
            "speakerName": "艾拉·马斯克",
            "text": "怎么样？我的丘丘人口语很不错吧？只要语言能够相通，那么互相理解也只是时间问题。",
            "nextDialogs": [
              "200150702"
            ]
          },
          "200150702": {
            "id": "200150702",
            "speakerId": 1000,
            "speakerName": "艾拉·马斯克",
            "text": "我是这么希望的…我的梦想，是和丘丘人们做朋友。",
            "nextDialogs": [
              "200150703"
            ]
          },
          "200150703": {
            "id": "200150703",
            "speakerId": 1000,
            "speakerName": "艾拉·马斯克",
            "text": "对了，请收下这个吧，这是刚才那位丘丘人送给我们的。",
            "nextDialogs": [
              "200150704"
            ]
          },
          "200150704": {
            "id": "200150704",
            "speakerId": 1000,
            "speakerName": "艾拉·马斯克",
            "text": "一份来自于丘丘人的礼物，还是很新奇的吧？",
            "nextDialogs": [
              "200150705"
            ]
          },
          "200150705": {
            "id": "200150705",
            "speakerId": 1000,
            "speakerName": "艾拉·马斯克",
            "text": "那么我先走了，还有很多发现要记录下来，下次有机会再见吧。"
          }
        }
      }
    },
    {
      "subId": "2001511",
      "subQuestName": "(test)判断08或10完成$HIDDEN",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "200151101"
        ],
        "dialogs": {
          "200151101": {
            "id": "200151101",
            "speakerId": 1000,
            "speakerName": "艾拉·马斯克",
            "text": "糟糕，他们全都醒了！"
          }
        }
      }
    },
    {
      "subId": "2001505",
      "subQuestName": "击退生气的丘丘人",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "200150501"
        ],
        "dialogs": {
          "200150501": {
            "id": "200150501",
            "speakerId": 1000,
            "speakerName": "艾拉·马斯克",
            "text": "小心点，过去的时候别吵醒其他丘丘人。",
            "nextDialogs": [
              "200150502"
            ]
          },
          "200150502": {
            "id": "200150502",
            "speakerId": 1000,
            "speakerName": "艾拉·马斯克",
            "text": "不然他们肯定会误会，以为我们是准备来攻击他们。",
            "nextDialogs": [
              "200150503"
            ]
          },
          "200150503": {
            "id": "200150503",
            "speakerId": 1000,
            "speakerName": "艾拉·马斯克",
            "text": "要是这样，肯定不能顺利地对话了。"
          }
        }
      }
    },
    {
      "subId": "2001506",
      "subQuestName": "与艾拉·马斯克对话",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "200150401"
        ],
        "dialogs": {
          "200150401": {
            "id": "200150401",
            "speakerId": 1000,
            "speakerName": "艾拉·马斯克",
            "text": "还好有你在，不然我都不知道怎么收场了。",
            "nextDialogs": [
              "200150402"
            ]
          },
          "200150402": {
            "id": "200150402",
            "speakerId": 1000,
            "speakerName": "艾拉·马斯克",
            "text": "我觉得我没说错什么地方呀，到底是哪里的发音出问题了？",
            "nextDialogs": [
              "200150403"
            ]
          },
          "200150403": {
            "id": "200150403",
            "speakerId": 1000,
            "speakerName": "艾拉·马斯克",
            "text": "我回去得再好好研究一下…"
          }
        }
      }
    },
    {
      "subId": "2001515",
      "subQuestName": "与艾拉·马斯克对话",
      "sceneId": null,
      "locations": [],
      "dialogue": {

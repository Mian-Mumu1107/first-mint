  "subQuests": [
    {
      "subId": "2001509",
      "subQuestName": "前往询问艾拉·马斯克",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "200150901"
        ],
        "dialogs": {
          "200150901": {
            "id": "200150901",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "好的，我现在就去抓一个…",
            "nextDialogs": [
              "200150902"
            ]
          },
          "200150902": {
            "id": "200150902",
            "speakerId": 1000,
            "speakerName": "艾拉·马斯克",
            "text": "等等！别直接冲进去，这些到底是谁教你的啊？！",
            "nextDialogs": [
              "200150903"
            ]
          },
          "200150903": {
            "id": "200150903",
            "speakerId": 1000,
            "speakerName": "艾拉·马斯克",
            "text": "等会和我一起，我们找一个丘丘人，友好地对话吧。"
          }
        }
      }
    },

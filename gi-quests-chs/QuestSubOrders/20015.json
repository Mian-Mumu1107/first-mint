    {
      "subId": "2001502",
      "subQuestName": "和艾拉·马斯克一起前往丘丘人营地",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "200150201"
        ],
        "dialogs": {
          "200150201": {
            "id": "200150201",
            "speakerId": 1000,
            "speakerName": "艾拉·马斯克",
            "text": "这里刚好有个丘丘人醒着。",
            "nextDialogs": [
              "200150202"
            ]
          },
          "200150202": {
            "id": "200150202",
            "speakerId": 1000,
            "speakerName": "艾拉·马斯克",
            "text": "就这位了，我们快点过去吧。",
            "nextDialogs": [
              "200150203"
            ]
          },
          "200150203": {
            "id": "200150203",
            "speakerId": 1000,
            "speakerName": "艾拉·马斯克",
            "text": "小心点，过去的时候别吵醒其他丘丘人。",
            "nextDialogs": [
              "200150204"
            ]
          },
          "200150204": {
            "id": "200150204",
            "speakerId": 1000,
            "speakerName": "艾拉·马斯克",
            "text": "不然他们肯定会误会，以为我们是准备来攻击他们。",
            "nextDialogs": [
              "200150205"
            ]
          },
          "200150205": {
            "id": "200150205",
            "speakerId": 1000,
            "speakerName": "艾拉·马斯克",
            "text": "要是这样，肯定不能顺利地对话了。"
          }
        }
      }
    },

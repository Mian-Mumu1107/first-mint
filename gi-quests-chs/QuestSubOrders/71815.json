    {
      "subId": "7181509",
      "subQuestName": "猜猜第一个灯谜",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "718150901"
        ],
        "dialogs": {
          "718150901": {
            "id": "718150901",
            "speakerId": 1007,
            "speakerName": "灯谜",
            "text": "「竹骨石肌一身轻，不听菱歌听衡经。」",
            "nextDialogs": [
              "718150902"
            ]
          },
          "718150902": {
            "id": "718150902",
            "speakerId": 1007,
            "speakerName": "灯谜",
            "text": "「莫道此生沉黑海，身中自有大光明。」",
            "nextDialogs": [
              "718150903"
            ]
          },
          "718150903": {
            "id": "718150903",
            "speakerId": 1008,
            "speakerName": "派蒙",
            "text": "这、这就是灯谜吗？好难…你有什么头绪吗？",
            "nextDialogs": [
              "718150904"
            ]
          },
          "718150904": {
            "id": "718150904",
            "speakerId": 1007,
            "speakerName": "灯谜",
            "text": "「竹骨石肌一身轻，不听菱歌听衡经。」",
            "nextDialogs": [
              "718150905"
            ]
          },
          "718150905": {
            "id": "718150905",
            "speakerId": 1007,
            "speakerName": "灯谜",
            "text": "「莫道此生沉黑海，身中自有大光明。」",
            "nextDialogs": [
              "718150909",
              "718150910"
            ]
          },
          "718150909": {
            "id": "718150909",
            "speakerId": 1006,
            "speakerName": "清昼",
            "text": "唔…猜得不对，还是再想想吧。"
          },
          "718150910": {
            "id": "718150910",
            "speakerId": 1006,
            "speakerName": "清昼",
            "text": "不错，正确的谜底就是这个。",
            "nextDialogs": [
              "718150911"
            ]
          },
          "718150911": {
            "id": "718150911",
            "speakerId": 1006,
            "speakerName": "清昼",
            "text": "霄灯正是竹骨石肌所做，放飞后浮空而行，这衡经说的也正是「玑衡经」，正是「不听菱歌听衡经」。",
            "nextDialogs": [
              "718150913"
            ]
          },
          "718150913": {
            "id": "718150913",
            "speakerId": 1006,
            "speakerName": "清昼",
            "text": "霄灯放飞后，虽然浮生石不坏，但灯罩本身会坏，坏掉的灯罩坠入海中后，就是「此生沉黑海」了。",
            "nextDialogs": [
              "718150914"
            ]
          },
          "718150914": {
            "id": "718150914",
            "speakerId": 1006,
            "speakerName": "清昼",
            "text": "但即便如此，寄托在霄灯上的愿望也不会消逝…这就是「身中自有大光明」。",
            "nextDialogs": [
              "718150915"
            ]
          },
          "718150915": {
            "id": "718150915",
            "speakerId": 1009,
            "speakerName": "小六",
            "text": "欸…是这么解的吗？完全想不到…",
            "nextDialogs": [
              "718150916"
            ]
          },
          "718150916": {
            "id": "718150916",
            "speakerId": 1009,
            "speakerName": "小六",
            "text": "#{PLAYERAVATAR#SEXPRO[INFO_MALE_PRONOUN_BIGBROTHER|INFO_FEMALE_PRONOUN_BIGSISTER]}，你好厉害，那…这个礼物给你！",
            "nextDialogs": [
              "718150917"
            ]
          },
          "718150917": {
            "id": "718150917",
            "speakerId": 1009,
            "speakerName": "小六",
            "text": "我听人家说，猜对了灯谜都要给「彩头」的…这个给你，就当做是「彩头」吧。"
          }
        }
      }
    },
    {
      "subId": "7181510",
      "subQuestName": "猜猜第二个灯谜",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "718151001"
        ],
        "dialogs": {
          "718151001": {
            "id": "718151001",
            "speakerId": 1007,
            "speakerName": "灯谜",
            "text": "「本由竹胎石胆造，登天照夜如日归。」",
            "nextDialogs": [
              "718151002"
            ]
          },
          "718151002": {
            "id": "718151002",
            "speakerId": 1007,
            "speakerName": "灯谜",
            "text": "「一声震得人方恐，回首相看已化灰。」",
            "nextDialogs": [
              "718151003"
            ]
          },
          "718151003": {
            "id": "718151003",
            "speakerId": 1008,
            "speakerName": "派蒙",
            "text": "咦？这个感觉还挺简单的，好好想想吧。",
            "nextDialogs": [
              "718151004"
            ]
          },
          "718151004": {
            "id": "718151004",
            "speakerId": 1007,
            "speakerName": "灯谜",
            "text": "「本由竹胎石胆造，登天照夜如日归。」",
            "nextDialogs": [
              "718151005"
            ]
          },
          "718151005": {
            "id": "718151005",
            "speakerId": 1007,
            "speakerName": "灯谜",
            "text": "「一声震得人方恐，回首相看已化灰。」",
            "nextDialogs": [
              "718151009",
              "718151010"
            ]
          },
          "718151009": {
            "id": "718151009",
            "speakerId": 1006,
            "speakerName": "清昼",
            "text": "唔…猜得不对，还是再想想吧。"
          },
          "718151010": {
            "id": "718151010",
            "speakerId": 1006,
            "speakerName": "清昼",
            "text": "不错，正确的谜底就是这个。哈哈哈，这个应该挺简单的，竹胎石胆，登天照夜…",
            "nextDialogs": [
              "718151011"
            ]
          },
          "718151011": {
            "id": "718151011",
            "speakerId": 1006,
            "speakerName": "清昼",
            "text": "还有「一声震得人方恐」，除了爆竹之外，也不会是别的了。",
            "nextDialogs": [
              "718151012"
            ]
          },
          "718151012": {
            "id": "718151012",
            "speakerId": 1010,
            "speakerName": "阿佐",
            "text": "啊…啊！对啊！我怎么没想到…",
            "nextDialogs": [
              "718151013"
            ]
          },
          "718151013": {
            "id": "718151013",
            "speakerId": 1010,
            "speakerName": "阿佐",
            "text": "既然你猜对了灯谜…那这个给你，收下吧。"
          }
        }
      }
    },
    {
      "subId": "7181511",
      "subQuestName": "猜猜第三个灯谜",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "718151101"
        ],
        "dialogs": {
          "718151101": {
            "id": "718151101",
            "speakerId": 1007,
            "speakerName": "灯谜",
            "text": "「岩上万民仰能见，裹挟东风上云间。」",
            "nextDialogs": [
              "718151102"
            ]
          },
          "718151102": {
            "id": "718151102",
            "speakerId": 1007,
            "speakerName": "灯谜",
            "text": "「游丝一断浑无力，扑棱坠地懒拾捡。」",
            "nextDialogs": [
              "718151103"
            ]
          },
          "718151103": {
            "id": "718151103",
            "speakerId": 1008,
            "speakerName": "派蒙",
            "text": "呃，这个该怎么解啊…",
            "nextDialogs": [
              "718151104"
            ]
          },
          "718151104": {
            "id": "718151104",
            "speakerId": 1007,
            "speakerName": "灯谜",
            "text": "「岩上万民仰能见，裹挟东风上云间。」",
            "nextDialogs": [
              "718151105"
            ]
          },
          "718151105": {
            "id": "718151105",
            "speakerId": 1007,
            "speakerName": "灯谜",
            "text": "「游丝一断浑无力，扑棱坠地懒拾捡。」",
            "nextDialogs": [
              "718151109",
              "718151110"
            ]
          },
          "718151109": {
            "id": "718151109",
            "speakerId": 1006,
            "speakerName": "清昼",
            "text": "唔…猜得不对，还是再想想吧。"
          },
          "718151110": {
            "id": "718151110",
            "speakerId": 1006,
            "speakerName": "清昼",
            "text": "不错，正确的谜底就是这个，要「裹挟东风」才能「上云间」…",
            "nextDialogs": [
              "718151111"
            ]
          },
          "718151111": {
            "id": "718151111",
            "speakerId": 1006,
            "speakerName": "清昼",
            "text": "而且，还牵着「游丝」的，自然就是「风筝」了。",
            "nextDialogs": [
              "718151112"
            ]
          },
          "718151112": {
            "id": "718151112",
            "speakerId": 1011,
            "speakerName": "阿佑",
            "text": "咦？为什么是这个，我想想…",
            "nextDialogs": [
              "718151113"
            ]
          },
          "718151113": {
            "id": "718151113",
            "speakerId": 1011,
            "speakerName": "阿佑",
            "text": "#好像还真是…{PLAYERAVATAR#SEXPRO[INFO_MALE_PRONOUN_BIGBROTHER|INFO_FEMALE_PRONOUN_BIGSISTER]}，你是怎么想出来的？好厉害…",
            "nextDialogs": [
              "718151114"
            ]
          },
          "718151114": {
            "id": "718151114",
            "speakerId": 1011,
            "speakerName": "阿佑",
            "text": "既然你猜对了灯谜，那这个给你。"
          }
        }
      }
    },
    {
      "subId": "7181512",
      "subQuestName": "与清昼对话",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "718151201"
        ],
        "dialogs": {
          "718151201": {
            "id": "718151201",
            "speakerId": 1006,
            "speakerName": "清昼",
            "text": "你能把三个灯谜都猜对，看来你确实也算得上才思敏捷。",
            "nextDialogs": [
              "718151202"
            ]
          },
          "718151202": {
            "id": "718151202",
            "speakerId": 1006,
            "speakerName": "清昼",
            "text": "啊…对了，虽然一般来说，要把霄灯送给猜对了灯谜的人，但这几盏霄灯我可不能送你…",
            "nextDialogs": [
              "718151203"
            ]
          },
          "718151203": {
            "id": "718151203",
            "speakerId": 1006,
            "speakerName": "清昼",
            "text": "要是我再编三盏霄灯，手非得废了不可，咳…这些东西给你，收下吧。",
            "nextDialogs": [
              "718151204"
            ]
          },
          "718151204": {
            "id": "718151204",
            "speakerId": 1006,
            "speakerName": "清昼",
            "text": "看那些孩子们意犹未尽的样子，看起来三个灯谜不够啊…我得再想几个灯谜才行。",
            "nextDialogs": [
              "718151207"
            ]
          },
          "718151207": {
            "id": "718151207",
            "speakerId": 1006,
            "speakerName": "清昼",
            "text": "……",
            "nextDialogs": [
              "718151208"
            ]
          },
          "718151208": {
            "id": "718151208",
            "speakerId": 1006,
            "speakerName": "清昼",
            "text": "不需担心，那首诗…只能算是我心中一点小意气，虚无缥缈。",
            "nextDialogs": [
              "718151209"
            ]
          },
          "718151209": {
            "id": "718151209",
            "speakerId": 1006,
            "speakerName": "清昼",
            "text": "但是这群孩子们，可是实打实地在等着我给他们出灯谜。",
            "nextDialogs": [
              "718151210"
            ]
          },
          "718151210": {
            "id": "718151210",
            "speakerId": 1006,
            "speakerName": "清昼",
            "text": "我先陪着这群孩子们玩个够，等那个画家来了，我会和他说的。",
            "nextDialogs": [
              "718151211"
            ]
          },
          "718151211": {
            "id": "718151211",
            "speakerId": 1006,
            "speakerName": "清昼",
            "text": "哦对了，看看时间，望雅应该也快到了，请你帮我去接一下她吧，我接着在这里给这群孩子们出灯谜。"
          }
        }
      }
    },
    {
      "subId": "7181513",
      "subQuestName": "与望雅对话",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "718152001"
        ],
        "dialogs": {
          "718152001": {
            "id": "718152001",
            "speakerId": 1000,
            "speakerName": "望雅",
            "text": "总算是到了…旅行者？你看见清昼和伯桓子了吗？",
            "nextDialogs": [
              "718152002"
            ]
          },
          "718152002": {
            "id": "718152002",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "关于清昼和伯桓子…",
            "nextDialogs": [
              "718152003"
            ]
          },
          "718152003": {
            "id": "718152003",
            "speakerId": 1000,
            "speakerName": "望雅",
            "text": "这样啊…那太好了，我还担心我不来没人安排呢。",
            "nextDialogs": [
              "718152004"
            ]
          },
          "718152004": {
            "id": "718152004",
            "speakerId": 1000,
            "speakerName": "望雅",
            "text": "总务司那边要转运的货物实在是有点多，我帮忙点了半天才点好。",
            "nextDialogs": [
              "718152005"
            ]
          },
          "718152005": {
            "id": "718152005",
            "speakerId": 1000,
            "speakerName": "望雅",
            "text": "点好之后，我就马上往这边赶了，没想到还是到了这个时间才到…",
            "nextDialogs": [
              "718152006"
            ]
          },
          "718152006": {
            "id": "718152006",
            "speakerId": 1000,
            "speakerName": "望雅",
            "text": "不过听你说的，好像也不需要我安排什么了。",
            "nextDialogs": [
              "718152007"
            ]
          },
          "718152007": {
            "id": "718152007",
            "speakerId": 1000,
            "speakerName": "望雅",
            "text": "我等会再去找他们，我们先慢慢往上散会步吧。"
          }
        }
      }
    },
    {
      "subId": "7181514",
      "subQuestName": "跟随望雅",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [],
        "dialogs": {}
      }
    },
    {
      "subId": "7181515",
      "subQuestName": "与望雅对话",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "718152101"
        ],
        "dialogs": {
          "718152101": {
            "id": "718152101",
            "speakerId": 1000,
            "speakerName": "望雅",
            "text": "轻策庄…其实我小时候也来过几次。",
            "nextDialogs": [
              "718152102"
            ]
          },
          "718152102": {
            "id": "718152102",
            "speakerId": 1000,
            "speakerName": "望雅",
            "text": "我还记得这里的豆腐很好吃，还有各种好玩的小木雕。",
            "nextDialogs": [
              "718152103"
            ]
          },
          "718152103": {
            "id": "718152103",
            "speakerId": 1000,
            "speakerName": "望雅",
            "text": "这周围的景色也很不错，之前不少人都觉得，在这里生活是一件不错的事。",
            "nextDialogs": [
              "718152104"
            ]
          },
          "718152104": {
            "id": "718152104",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "那为什么这里会…",
            "nextDialogs": [
              "718152105"
            ]
          },
          "718152105": {
            "id": "718152105",
            "speakerId": 1000,
            "speakerName": "望雅",
            "text": "对于…老人们来说，轻策庄确实是一个很闲适的地方，周围都是认识的人和熟悉的事物，不会怎么改变。",
            "nextDialogs": [
              "718152106"
            ]
          },
          "718152106": {
            "id": "718152106",
            "speakerId": 1000,
            "speakerName": "望雅",
            "text": "在这里呆着的时候，你有时候甚至会怀疑，时间是不是静止了。",
            "nextDialogs": [
              "718152107"
            ]
          },
          "718152107": {
            "id": "718152107",
            "speakerId": 1000,
            "speakerName": "望雅",
            "text": "不过，这里也许不是那么适合年轻人吧…",
            "nextDialogs": [
              "718152108"
            ]
          },
          "718152108": {
            "id": "718152108",
            "speakerId": 1000,
            "speakerName": "望雅",
            "text": "因为各种各样的原因，轻策庄里的年轻人大部分都去了璃月港里，只有老人和孩子们留在了这里。",
            "nextDialogs": [
              "718152109"
            ]
          },
          "718152109": {
            "id": "718152109",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "这到底是因为…",
            "nextDialogs": [
              "718152110"
            ]
          },
          "718152110": {
            "id": "718152110",
            "speakerId": 1000,
            "speakerName": "望雅",
            "text": "这件事的原因…可不是一两句话就能说清楚的。",
            "nextDialogs": [
              "718152111"
            ]
          },
          "718152111": {
            "id": "718152111",
            "speakerId": 1000,
            "speakerName": "望雅",
            "text": "我们再往前走走吧。"
          }
        }
      }
    },
    {
      "subId": "7181516",
      "subQuestName": "跟随望雅",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [],
        "dialogs": {}
      }
    },
    {
      "subId": "7181517",
      "subQuestName": "与望雅对话",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "718152201"
        ],
        "dialogs": {
          "718152201": {
            "id": "718152201",
            "speakerId": 1000,
            "speakerName": "望雅",
            "text": "总之，不管原因是什么，轻策庄里逐渐只剩下了老人和孩子们。",
            "nextDialogs": [
              "718152202"
            ]
          },
          "718152202": {
            "id": "718152202",
            "speakerId": 1000,
            "speakerName": "望雅",
            "text": "逢年过节的时候，他们也很难真正地置办起节日的氛围，虽然总务司年年都会派人送物资过来，但是…",
            "nextDialogs": [
              "718152203"
            ]
          },
          "718152203": {
            "id": "718152203",
            "speakerId": 1000,
            "speakerName": "望雅",
            "text": "但是我们作为外人，能够为他们做的，也仅仅就到此为止了。",
            "nextDialogs": [
              "718152204"
            ]
          },
          "718152204": {
            "id": "718152204",
            "speakerId": 1000,
            "speakerName": "望雅",
            "text": "我想，他们真正需要的…也许是家人的陪伴吧。",
            "nextDialogs": [
              "718152205"
            ]
          },
          "718152205": {
            "id": "718152205",
            "speakerId": 1000,
            "speakerName": "望雅",
            "text": "如果没有亲人陪伴，那再多的娱乐和物资也…",
            "nextDialogs": [
              "718152208"
            ]
          },
          "718152208": {
            "id": "718152208",
            "speakerId": 1000,
            "speakerName": "望雅",
            "text": "啊！抱歉，因为我一直在接触这方面的事，不由自主地就感慨了起来，说了这么多沉重的事！",
            "nextDialogs": [
              "718152209"
            ]
          },
          "718152209": {
            "id": "718152209",
            "speakerId": 1000,
            "speakerName": "望雅",
            "text": "不管怎么说，有清昼、伯桓子还有你帮忙，今年的轻策庄可是热闹了不少呢。",
            "nextDialogs": [
              "718152210"
            ]
          },
          "718152210": {
            "id": "718152210",
            "speakerId": 1000,
            "speakerName": "望雅",
            "text": "再次感谢你愿意帮忙，旅行者。"
          }
        }
      }
    },

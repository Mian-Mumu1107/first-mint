    {
      "subId": "301201",
      "subQuestName": "与纳西妲对话",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "30120101"
        ],
        "dialogs": {
          "30120101": {
            "id": "30120101",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "早上好，纳西妲！我全想起来了，是不是该说「早上好，小吉祥草王」了呢？",
            "nextDialogs": [
              "30120102"
            ]
          },
          "30120102": {
            "id": "30120102",
            "speakerId": 1056,
            "speakerName": "纳西妲",
            "text": "……",
            "nextDialogs": [
              "30120103"
            ]
          },
          "30120103": {
            "id": "30120103",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "欸，怎么了么，纳西妲，你的脸色有点不好。",
            "nextDialogs": [
              "30120106"
            ]
          },
          "30120106": {
            "id": "30120106",
            "speakerId": 1056,
            "speakerName": "纳西妲",
            "text": "情况…恐怕和你此刻脑海中的那个想法一样…",
            "nextDialogs": [
              "30120107"
            ]
          },
          "30120107": {
            "id": "30120107",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "迪娜泽黛消失了？不会吧！我们…没赶上吗？",
            "nextDialogs": [
              "30120108"
            ]
          },
          "30120108": {
            "id": "30120108",
            "speakerId": 1056,
            "speakerName": "纳西妲",
            "text": "消失的的确是真正的迪娜泽黛的意识，在过度收割梦境的情况下，意识已经无法再支撑下去了。"
          }
        }
      }
    },
    {
      "subId": "301202",
      "subQuestName": "与花之骑士法里斯对话",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "30120201"
        ],
        "dialogs": {
          "30120201": {
            "id": "30120201",
            "speakerId": 12653,
            "speakerName": "毗伽尔",
            "text": "欸？你们回来了，之前我看你们急匆匆走了，是有什么事么？",
            "nextDialogs": [
              "30120202"
            ]
          },
          "30120202": {
            "id": "30120202",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "没什么，这很难解释…这样吧，你陪我们做个实验好不好？",
            "nextDialogs": [
              "30120203"
            ]
          },
          "30120203": {
            "id": "30120203",
            "speakerId": 12653,
            "speakerName": "毗伽尔",
            "text": "实验？有点莫名其妙，不过你说吧，要怎么做？",
            "nextDialogs": [
              "30120204"
            ]
          },
          "30120204": {
            "id": "30120204",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "你有什么愿望吗？",
            "nextDialogs": [
              "30120205"
            ]
          },
          "30120205": {
            "id": "30120205",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "想象一下你的愿望在你眼前实现。",
            "nextDialogs": [
              "30120206"
            ]
          },
          "30120206": {
            "id": "30120206",
            "speakerId": 12653,
            "speakerName": "毗伽尔",
            "text": "愿望？花神诞祭还有什么许愿环节？",
            "nextDialogs": [
              "30120207"
            ]
          },
          "30120207": {
            "id": "30120207",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "哎呀别管那么多啦！",
            "nextDialogs": [
              "30120208"
            ]
          },
          "30120208": {
            "id": "30120208",
            "speakerId": 12653,
            "speakerName": "毗伽尔",
            "text": "好好好…",
            "nextDialogs": [
              "30120209"
            ]
          },
          "30120209": {
            "id": "30120209",
            "speakerId": 12653,
            "speakerName": "毗伽尔",
            "text": "我现在的愿望…唔，说来有些不好意思，那可能…就是想让迪娜泽黛小姐开心吧。",
            "nextDialogs": [
              "30120210"
            ]
          },
          "30120210": {
            "id": "30120210",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "啊…",
            "nextDialogs": [
              "30120211"
            ]
          },
          "30120211": {
            "id": "30120211",
            "speakerId": 12653,
            "speakerName": "毗伽尔",
            "text": "刚才我好像看到她的心情不太好，不怎么搭理人的样子。",
            "nextDialogs": [
              "30120212"
            ]
          },
          "30120212": {
            "id": "30120212",
            "speakerId": 12653,
            "speakerName": "毗伽尔",
            "text": "可其实她之前并不是这样的，她又温柔，又善解人意，还讨孩子们喜欢…",
            "nextDialogs": [
              "30120213"
            ]
          },
          "30120213": {
            "id": "30120213",
            "speakerId": 12653,
            "speakerName": "毗伽尔",
            "text": "我还想过，会不会有一种可能，她让我帮忙扮「花之骑士法里斯」，是因为在她眼里我很特殊呢…",
            "nextDialogs": [
              "30120214"
            ]
          },
          "30120214": {
            "id": "30120214",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "你，难道喜欢迪娜泽黛？",
            "nextDialogs": [
              "30120215"
            ]
          },
          "30120215": {
            "id": "30120215",
            "speakerId": 12653,
            "speakerName": "毗伽尔",
            "text": "啊、啊…啊哈哈哈…有那么明显吗？也是…刚才我说的这些好像是挺明显的。",
            "nextDialogs": [
              "30120216"
            ]
          },
          "30120216": {
            "id": "30120216",
            "speakerId": 12653,
            "speakerName": "毗伽尔",
            "text": "她那时候一边说「想要人们都笑着度过花神诞祭」，一边给我戴上了「花之骑士」的帽子。",
            "nextDialogs": [
              "30120217"
            ]
          },
          "30120217": {
            "id": "30120217",
            "speakerId": 12653,
            "speakerName": "毗伽尔",
            "text": "却不知道，我没那么在意大家的心情，那一刻我只想一辈子都当她的「花之骑士」，五十年，一百年都可以。",
            "nextDialogs": [
              "30120218"
            ]
          },
          "30120218": {
            "id": "30120218",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "……",
            "nextDialogs": [
              "30120219"
            ]
          },
          "30120219": {
            "id": "30120219",
            "speakerId": 12653,
            "speakerName": "毗伽尔",
            "text": "哎呀呀，太不好意思了，趁势说了些肉麻的话。",
            "nextDialogs": [
              "30120220"
            ]
          },
          "30120220": {
            "id": "30120220",
            "speakerId": 12653,
            "speakerName": "毗伽尔",
            "text": "好了好了，我的愿望是——「迪娜泽黛小姐现在笑着出现在我面前」，那我开始许愿咯…",
            "nextDialogs": [
              "30120221"
            ]
          },
          "30120221": {
            "id": "30120221",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "一定要实现啊…",
            "nextDialogs": [
              "30120222"
            ]
          },
          "30120222": {
            "id": "30120222",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "一定要实现啊…",
            "nextDialogs": [
              "30120223"
            ]
          },
          "30120223": {
            "id": "30120223",
            "speakerId": 12653,
            "speakerName": "毗伽尔",
            "text": "我睁开眼睛咯，哟吼！",
            "nextDialogs": [
              "30120224"
            ]
          },
          "30120224": {
            "id": "30120224",
            "speakerId": 12653,
            "speakerName": "毗伽尔",
            "text": "啊——这是…！",
            "nextDialogs": [
              "30120225"
            ]
          },
          "30120225": {
            "id": "30120225",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "啊！？",
            "nextDialogs": [
              "30120226"
            ]
          },
          "30120226": {
            "id": "30120226",
            "speakerId": 12653,
            "speakerName": "毗伽尔",
            "text": "…这不是小帕奇吗，雅尔达糖果一人只能领一份，快回家吧。",
            "nextDialogs": [
              "30120227"
            ]
          },
          "30120227": {
            "id": "30120227",
            "speakerId": 12653,
            "speakerName": "毗伽尔",
            "text": "哈哈哈…你们的把戏根本不灵嘛。算了算了，不用她来到我面前了，只要她开心就够了，哈哈哈…",
            "nextDialogs": [
              "30120228"
            ]
          },
          "30120228": {
            "id": "30120228",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "唉…看来他并不是所谓的梦境主体，果然没有那么好找。",
            "nextDialogs": [
              "30120229"
            ]
          },
          "30120229": {
            "id": "30120229",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "不过话说，认识迪娜泽黛的大家真的都很喜欢她呢，可她却在大家都不知情的时候…",
            "nextDialogs": [
              "30120230"
            ]
          },
          "30120230": {
            "id": "30120230",
            "speakerId": 1052,
            "speakerName": "迪希雅",
            "text": "小姐，请退后！",
            "nextDialogs": [
              "30120231"
            ]
          },
          "30120231": {
            "id": "30120231",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "是迪希雅的声音！对哦，这个时间的话，正是迪娜泽黛遇上绑匪们的时候。",
            "nextDialogs": [
              "30120232"
            ]
          },
          "30120232": {
            "id": "30120232",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "我去教训教训他们。",
            "nextDialogs": [
              "30120233"
            ]
          },
          "30120233": {
            "id": "30120233",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "欸，可是迪希雅会解决的呀，喂，旅行者！"
          }
        }
      }
    },
    {
      "subId": "301203",
      "subQuestName": "回到住处附近",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "30120401"
        ],
        "dialogs": {
          "30120401": {
            "id": "30120401",
            "speakerId": 1052,
            "speakerName": "迪希雅",
            "text": "…哦？是你，来得正好。拜托你带着…",
            "nextDialogs": [
              "30120404"
            ]
          },
          "30120404": {
            "id": "30120404",
            "speakerId": 1052,
            "speakerName": "迪希雅",
            "text": "喂，这可是我的工作，呼玛伊家又不会付钱给你。"
          }
        }
      }
    },
    {
      "subId": "301204",
      "subQuestName": "击败所有埋伏的镀金旅团成员",
      "sceneId": null,
      "locations": [],

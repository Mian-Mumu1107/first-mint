    {
      "subId": "301212",
      "subQuestName": "与派蒙对话",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "30121001"
        ],
        "dialogs": {
          "30121001": {
            "id": "30121001",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "呼啊——早上好，旅行者，总感觉睡了好久呢…",
            "nextDialogs": [
              "30121004"
            ]
          },
          "30121004": {
            "id": "30121004",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "…脑袋昏沉沉的，是睡了太多么。昨晚我们是怎么睡着的…",
            "nextDialogs": [
              "30121005"
            ]
          },
          "30121005": {
            "id": "30121005",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "我记得，好像是…花神诞祭结束后…",
            "nextDialogs": [
              "30121006"
            ]
          },
          "30121006": {
            "id": "30121006",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "…花神诞祭！",
            "nextDialogs": [
              "30121013"
            ]
          },
          "30121013": {
            "id": "30121013",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "我们已经从「花神诞祭的轮回」中出来了吧？",
            "nextDialogs": [
              "30121007"
            ]
          },
          "30121007": {
            "id": "30121007",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "我想起来了！",
            "nextDialogs": [
              "30121014"
            ]
          },
          "30121014": {
            "id": "30121014",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "快，先把虚空终端摘掉吧！"
          }
        }
      }
    },
    {
      "subId": "301210",
      "subQuestName": "寻找迪娜泽黛",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "30120901"
        ],
        "dialogs": {
          "30120901": {
            "id": "30120901",
            "speakerId": 1008,
            "speakerName": "凯瑟琳？",
            "text": "做得不错，旅行者，派蒙。",
            "nextDialogs": [
              "30120902"
            ]
          },
          "30120902": {
            "id": "30120902",
            "speakerId": 1008,
            "speakerName": "凯瑟琳？",
            "text": "还有…谢谢你，迪娜泽黛，能为我筹办花神诞祭。",
            "nextDialogs": [
              "30120903"
            ]
          },
          "30120903": {
            "id": "30120903",
            "speakerId": 12555,
            "speakerName": "迪娜泽黛",
            "text": "请问你是…",
            "nextDialogs": [
              "30120904"
            ]
          },
          "30120904": {
            "id": "30120904",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "迪娜泽黛！呜…呜…你这不是没事吗！别吓我们呀…",
            "nextDialogs": [
              "30120905"
            ]
          },
          "30120905": {
            "id": "30120905",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "迪娜泽黛…",
            "nextDialogs": [
              "30120906"
            ]
          },
          "30120906": {
            "id": "30120906",
            "speakerId": 12555,
            "speakerName": "迪娜泽黛",
            "text": "哦~！旅行者，小派蒙！你们听我说哦！",
            "nextDialogs": [
              "30120907"
            ]
          },
          "30120907": {
            "id": "30120907",
            "speakerId": 12555,
            "speakerName": "迪娜泽黛",
            "text": "我刚刚做了一个梦…梦见妮露在跳「花神之舞」了！"
          }
        }
      }
    },

      }
    },
    {
      "subId": "301205",
      "subQuestName": "与派蒙对话",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "30120501"
        ],
        "dialogs": {
          "30120501": {
            "id": "30120501",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "旅行者…你完全是在拿他们撒气吧？",
            "nextDialogs": [
              "30120504"
            ]
          },
          "30120504": {
            "id": "30120504",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "唉…你也是，纳西妲也是，迪娜泽黛可不会想看到你们这个样子呀。",
            "nextDialogs": [
              "30120505"
            ]
          },
          "30120505": {
            "id": "30120505",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "哦对了，说起来…我想到一件事情。",
            "nextDialogs": [
              "30120506"
            ]
          },
          "30120506": {
            "id": "30120506",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "当初第一次花神诞祭，也就是我们还没有进入「轮回」的时候，我们和迪娜泽黛到这里是不是为了取东西来着？",
            "nextDialogs": [
              "30120507"
            ]
          },
          "30120507": {
            "id": "30120507",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "她好像说是自己有东西忘记带出来了。"
          }
        }
      }
    },
    {
      "subId": "301207",
      "subQuestName": "与「迪娜泽黛」对话",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "30120601"
        ],
        "dialogs": {
          "30120601": {
            "id": "30120601",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "是迪娜泽黛的「人偶」…",
            "nextDialogs": [
              "30120604"
            ]
          },
          "30120604": {
            "id": "30120604",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "谢谢你。",
            "nextDialogs": [
              "30120605"
            ]
          },
          "30120605": {
            "id": "30120605",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "旅行者…",
            "nextDialogs": [
              "30120606"
            ]
          },
          "30120606": {
            "id": "30120606",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "你累了吗？",
            "nextDialogs": [
              "30120607"
            ]
          },
          "30120607": {
            "id": "30120607",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "回想起来，我们真的困在这里好久好久了…和迪娜泽黛愉快地聊天，感觉好像已经是很久很久以前的事了。",
            "nextDialogs": [
              "30120608"
            ]
          },
          "30120608": {
            "id": "30120608",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "还记得那时我们都坐在这里，她提到要去看妮露的「花神之舞」，眼睛闪闪发光的样子…",
            "nextDialogs": [
              "30120609"
            ]
          },
          "30120609": {
            "id": "30120609",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "我已经…快要记不清了。",
            "nextDialogs": [
              "30120610"
            ]
          },
          "30120610": {
            "id": "30120610",
            "speakerId": 12555,
            "speakerName": "迪娜泽黛",
            "text": "…生命中永远会有令人懊恼的事，但我知道，我们是为了不留遗憾而活着的，对吗？",
            "nextDialogs": [
              "30120611"
            ]
          },
          "30120611": {
            "id": "30120611",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "！？",
            "nextDialogs": [
              "30120612"
            ]
          },
          "30120612": {
            "id": "30120612",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "刚刚这句话，是过去的迪娜泽黛曾经说过的吧？难道说…！",
            "nextDialogs": [
              "30120613"
            ]
          },
          "30120613": {
            "id": "30120613",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "迪娜泽黛…？",
            "nextDialogs": [
              "30120614"
            ]
          },
          "30120614": {
            "id": "30120614",
            "speakerId": 12555,
            "speakerName": "迪娜泽黛",
            "text": "嗯？怎么了旅行者。",
            "nextDialogs": [
              "30120615"
            ]
          },
          "30120615": {
            "id": "30120615",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "……",
            "nextDialogs": [
              "30120616"
            ]
          },
          "30120616": {
            "id": "30120616",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "好像…还是那个「人偶」的她呀，可刚刚是怎么回事…"
          }
        }
      }
    },
    {
      "subId": "301209",
      "subQuestName": "观看花神之舞",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "30120701"
        ],
        "dialogs": {
          "30120701": {
            "id": "30120701",
            "speakerId": 12659,
            "speakerName": "塞塔蕾",
            "text": "你再继续这样坚持，我们也不得不下令查办所有花神诞祭的组织者了…",
            "nextDialogs": [
              "30120702"
            ]
          },
          "30120702": {
            "id": "30120702",
            "speakerId": 12659,
            "speakerName": "塞塔蕾",
            "text": "大贤者原本就已经网开一面了，请你识趣一些。",
            "nextDialogs": [
              "30120703"
            ]
          },
          "30120703": {
            "id": "30120703",
            "speakerId": 1054,
            "speakerName": "妮露",
            "text": "怎么…怎么能这样…",
            "nextDialogs": [
              "30120704"
            ]
          },
          "30120704": {
            "id": "30120704",
            "speakerId": 1054,
            "speakerName": "妮露",
            "text": "啊…旅行者？不必这样为我们出头，他是教令院的贤者，连累到你可就不好了…",
            "nextDialogs": [
              "30120705"
            ]
          },
          "30120705": {
            "id": "30120705",
            "speakerId": 12660,
            "speakerName": "阿扎尔",
            "text": "…旅行者？",
            "nextDialogs": [
              "30120706"
            ]
          },
          "30120706": {
            "id": "30120706",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "旅行者，你忽然间做什么呀，要是被教令院的人抓了，今天不就浪费了？",
            "nextDialogs": [
              "30120707"
            ]
          },
          "30120707": {
            "id": "30120707",
            "speakerId": 12660,
            "speakerName": "阿扎尔",
            "text": "……",
            "nextDialogs": [
              "30120708"
            ]
          },
          "30120708": {
            "id": "30120708",
            "speakerId": 12659,
            "speakerName": "塞塔蕾",
            "text": "……",
            "nextDialogs": [
              "30120709"
            ]
          },
          "30120709": {
            "id": "30120709",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "欸，他们…好像没反应？被吓到了吗？",
            "nextDialogs": [
              "30120712"
            ]
          },
          "30120712": {
            "id": "30120712",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "啊——原来如此，如果是贤者们的计划，那他们肯定不会让自己也…",
            "nextDialogs": [
              "30120713"
            ]
          },
          "30120713": {
            "id": "30120713",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "所以「它们」也只是替代品。",
            "nextDialogs": [
              "30120714"
            ]
          },
          "30120714": {
            "id": "30120714",
            "speakerId": 1054,
            "speakerName": "妮露",
            "text": "怎么回事？大贤者他们怎么了？"
          }
        }
      }
    },

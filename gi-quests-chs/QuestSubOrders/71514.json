{
  "lineCounts": {
    "Player": 6,
    "派蒙": 10,
    "甜甜": 20
  },
  "subQuests": [
    {
      "subId": "7151401",
      "subQuestName": "与甜甜对话",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "715140101"
        ],
        "dialogs": {
          "715140101": {
            "id": "715140101",
            "speakerId": 1000,
            "speakerName": "甜甜",
            "text": "嗨嗨嗨！两位前辈，海灯节好呀！",
            "nextDialogs": [
              "715140102"
            ]
          },
          "715140102": {
            "id": "715140102",
            "speakerId": 1000,
            "speakerName": "甜甜",
            "text": "最近玩得开心吗？有兴趣跟我来一场特别冒险吗？",
            "nextDialogs": [
              "715140103"
            ]
          },
          "715140103": {
            "id": "715140103",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "呜哇，居然叫我们前辈？态度真不错！",
            "nextDialogs": [
              "715140104"
            ]
          },
          "715140104": {
            "id": "715140104",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "不说最近，我们一直挺开心的啦！不过…我怎么觉得你有点眼熟呢？",
            "nextDialogs": [
              "715140105"
            ]
          },
          "715140105": {
            "id": "715140105",
            "speakerId": 1000,
            "speakerName": "甜甜",
            "text": "你们可是冒险家协会的超级全勤王，肯定见过我！",
            "nextDialogs": [
              "715140106"
            ]
          },
          "715140106": {
            "id": "715140106",
            "speakerId": 1000,
            "speakerName": "甜甜",
            "text": "我叫甜甜，平常总在绯云坡附近转悠，为协会招揽新人。",
            "nextDialogs": [
              "715140107"
            ]
          },
          "715140107": {
            "id": "715140107",
            "speakerId": 1000,
            "speakerName": "甜甜",
            "text": "路过绯云坡的人里，十个有十个听过我的声音，还要加上他们抱的猫、遛的狗！",
            "nextDialogs": [
              "715140109",
              "715140111"
            ]
          },
          "715140109": {
            "id": "715140109",
            "speakerId": 1000,
            "speakerName": "甜甜",
            "text": "对对对，说明我的努力被前辈们注意到了！那更要让前辈们体验一下我的杰作了！",
            "nextDialogs": [
              "715140112"
            ]
          },
          "715140112": {
            "id": "715140112",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "话都说到这份上了，我们两位前辈肯定要给你面子！",
            "nextDialogs": [
              "715140113"
            ]
          },
          "715140113": {
            "id": "715140113",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "请简单介绍一下你说的特别冒险吧？",
            "nextDialogs": [
              "715140114"
            ]
          },
          "715140114": {
            "id": "715140114",
            "speakerId": 1000,
            "speakerName": "甜甜",
            "text": "好！那我就进入正题了！",
            "nextDialogs": [
              "715140115"
            ]
          },
          "715140115": {
            "id": "715140115",
            "speakerId": 1000,
            "speakerName": "甜甜",
            "text": "最近我在万文集舍看到了新的小说…不对，应该说是找到了新的情报！",
            "nextDialogs": [
              "715140116"
            ]
          },
          "715140116": {
            "id": "715140116",
            "speakerId": 1000,
            "speakerName": "甜甜",
            "text": "我发现人们对于冒险的期望正在变高，登山和风之翼滑翔这类活动的吸引力都不如以前了。",
            "nextDialogs": [
              "715140117"
            ]
          },
          "715140117": {
            "id": "715140117",
            "speakerId": 1000,
            "speakerName": "甜甜",
            "text": "为了让更多人加入冒险家协会，新奇而刺激的体验是必需品。",
            "nextDialogs": [
              "715140118"
            ]
          },
          "715140118": {
            "id": "715140118",
            "speakerId": 1000,
            "speakerName": "甜甜",
            "text": "所以，我联合外地的几位宣传员，一起花费重金，请教了几位登山高手和烟花工匠，设计了一种全新的竞速挑战！",
            "nextDialogs": [
              "715140119"
            ]
          },
          "715140119": {
            "id": "715140119",
            "speakerId": 1000,
            "speakerName": "甜甜",
            "text": "挑战中布置了很多机关，只要踩上去，就可以利用烟花和火药爆炸的推力，一下子飞到天上，完成超厉害的加速！",
            "nextDialogs": [
              "715140120"
            ]
          },
          "715140120": {
            "id": "715140120",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "烟花？火药？竞速挑战的过程中…把人炸到天上？"
          },
          "715140111": {
            "id": "715140111",
            "speakerId": 1000,
            "speakerName": "甜甜",
            "text": "居然没印象？那我要用这次的杰作让更多人记住我…不对，是招揽更多人加入协会！"
          }
        }
      }
    }
  ]
}
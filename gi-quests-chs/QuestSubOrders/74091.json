  "subQuests": [
    {
      "subId": "7409101",
      "subQuestName": "与艾古伊对话$HIDDEN",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "740910101"
        ],
        "dialogs": {
          "740910101": {
            "id": "740910101",
            "speakerId": 5226,
            "speakerName": "艾古伊",
            "text": "那小子，该不会被丘丘人抓去煮汤了吧…",
            "nextDialogs": [
              "740910105",
              "740910104"
            ]
          },
          "740910105": {
            "id": "740910105",
            "speakerId": 5226,
            "speakerName": "艾古伊",
            "text": "那边，你们瞧，能看到水上的丘丘人营地吧？",
            "nextDialogs": [
              "740910106"
            ]
          },
          "740910106": {
            "id": "740910106",
            "speakerId": 5226,
            "speakerName": "艾古伊",
            "text": "简直就像一夜之间突然冒出来的，该休息的时间不休息，拼命干活，哎哟，和巴朗那臭小子一模一样。",
            "nextDialogs": [
              "740910107"
            ]
          },
          "740910107": {
            "id": "740910107",
            "speakerId": 5226,
            "speakerName": "艾古伊",
            "text": "依我看，他要是走运，现在没在锅里，那说不定正跟丘丘人聊得火热呢。",
            "nextDialogs": [
              "740910108"
            ]
          },
          "740910108": {
            "id": "740910108",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "欸？你的意思是说，你认识的人被那边的丘丘人抓走了？你怎么一点也不着急，如果是真的，得赶紧救人呀。",
            "nextDialogs": [
              "740910109"
            ]
          },
          "740910109": {
            "id": "740910109",
            "speakerId": 5226,
            "speakerName": "艾古伊",
            "text": "救人？救什么人？我早跟他说了，危险的工作没必要自己拼命，等艾蒂安定期联络的时候报告一声，让艾蒂安找人处理就行了。",
            "nextDialogs": [
              "740910110"
            ]
          },
          "740910110": {
            "id": "740910110",
            "speakerId": 5226,
            "speakerName": "艾古伊",
            "text": "我好心教他，可他小子是什么嘴脸？反过来指责我工作不认真，玩忽职守。",
            "nextDialogs": [
              "740910111"
            ]
          },
          "740910111": {
            "id": "740910111",
            "speakerId": 5226,
            "speakerName": "艾古伊",
            "text": "既然他不把老前辈的经验和智慧当回事，那我只好说，都是他自己选的，年轻人就该吃点苦头，不吃点教训怎么能成长。"
          },
          "740910104": {
            "id": "740910104",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "重点在这里吗！"
          }
        }
      }
    },
    {
      "subId": "7409112",
      "subQuestName": "(test)（隐藏）前往区域搜寻巴朗$HIDDEN",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "740911201"
        ],
        "dialogs": {
          "740911201": {
            "id": "740911201",
            "speakerId": 5226,
            "speakerName": "艾古伊",
            "text": "要是为了救巴朗那臭小子害你们受伤，到时让他给你们赔罪，让他休假照顾你们！"
          }
        }
      }
    },
    {
      "subId": "7409102",
      "subQuestName": "前往水上丘丘人营地寻找巴朗",
      "sceneId": null,
      "locations": [],

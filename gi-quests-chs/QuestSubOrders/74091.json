    {
      "subId": "7409113",
      "subQuestName": "与被困的人对话",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "740910401"
        ],
        "dialogs": {
          "740910401": {
            "id": "740910401",
            "speakerId": 10205,
            "speakerName": "？？？",
            "text": "两位…好心人…谢谢你们…",
            "nextDialogs": [
              "740910402"
            ]
          },
          "740910402": {
            "id": "740910402",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "你没事吧？",
            "nextDialogs": [
              "740910403"
            ]
          },
          "740910403": {
            "id": "740910403",
            "speakerId": 10205,
            "speakerName": "？？？",
            "text": "我…我…还行…大概还行…",
            "nextDialogs": [
              "740910404"
            ]
          },
          "740910404": {
            "id": "740910404",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "看起来快不行了。",
            "nextDialogs": [
              "740910405"
            ]
          },
          "740910405": {
            "id": "740910405",
            "speakerId": 10205,
            "speakerName": "？？？",
            "text": "麻…麻烦两位带我去那边的码头…我…我…",
            "nextDialogs": [
              "740910406"
            ]
          },
          "740910406": {
            "id": "740910406",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "你还是先别说话了，我们带你回去就是了！"
          }
        }
      }
    },
    {
      "subId": "7409104",

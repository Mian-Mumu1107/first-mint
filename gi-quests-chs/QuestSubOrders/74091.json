        "startDialogs": [],
        "dialogs": {}
      }
    },
    {
      "subId": "7409115",
      "subQuestName": "解救被困的人",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "740911501"
        ],
        "dialogs": {
          "740911501": {
            "id": "740911501",
            "speakerId": 5227,
            "speakerName": "巴朗",
            "text": "怎么了，遇到麻烦了吗？是检修工作有哪里不明白吗？我再给你们讲讲！",
            "nextDialogs": [
              "740911502",
              "740911508"
            ]
          },
          "740911502": {
            "id": "740911502",
            "speakerId": 5227,
            "speakerName": "巴朗",
            "text": "如果在水下发现管道有<color=#00E1FFFF>气体外泄</color>的情况，应该是水下生物…或者是非生物的冲撞导致的。",
            "nextDialogs": [
              "740911503"
            ]
          },
          "740911503": {
            "id": "740911503",
            "speakerId": 5227,
            "speakerName": "巴朗",
            "text": "应急处理的方法是<color=#00E1FFFF>控制调节阀调整流量，暂时止住气体外泄</color>。你们只需要做到这种程度就好了。",
            "nextDialogs": [
              "740911504"
            ]
          },
          "740911504": {
            "id": "740911504",
            "speakerId": 5227,
            "speakerName": "巴朗",
            "text": "调节阀的操作是有技巧的，<color=#00E1FFFF>转动手轮时需要观察气体流量，如果气体流量变小了，就说明思路没问题</color>。",
            "nextDialogs": [
              "740911505"
            ]
          },
          "740911505": {
            "id": "740911505",
            "speakerId": 5227,
            "speakerName": "巴朗",
            "text": "应该没有那么难的，就拜托你们了。"
          },
          "740911508": {
            "id": "740911508",
            "speakerId": 5227,
            "speakerName": "巴朗",
            "text": "那就拜托了。"
          }
        }
      }
    },

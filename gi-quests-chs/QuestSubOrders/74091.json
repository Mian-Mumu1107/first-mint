    {
      "subId": "7409114",
      "subQuestName": "前往码头",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "740910501"
        ],
        "dialogs": {
          "740910501": {
            "id": "740910501",
            "speakerId": 10205,
            "speakerName": "？？？",
            "text": "艾古伊先生，我…我回来了…",
            "nextDialogs": [
              "740910502"
            ]
          },
          "740910502": {
            "id": "740910502",
            "speakerId": 5226,
            "speakerName": "艾古伊",
            "text": "你们是…看样子是你们救了巴朗，谢谢你们。",
            "nextDialogs": [
              "740910503"
            ]
          },
          "740910503": {
            "id": "740910503",
            "speakerId": 5226,
            "speakerName": "艾古伊",
            "text": "你这臭小子…我早跟你说了，危险的工作没必要自己拼命，等艾蒂安定期联络的时候报告一声，让艾蒂安找人处理就行了。",
            "nextDialogs": [
              "740910504"
            ]
          },
          "740910504": {
            "id": "740910504",
            "speakerId": 5226,
            "speakerName": "艾古伊",
            "text": "我当初好心教你，可你小子是什么嘴脸？反过来指责我工作不认真，玩忽职守。",
            "nextDialogs": [
              "740910505"
            ]
          },
          "740910505": {
            "id": "740910505",
            "speakerId": 5226,
            "speakerName": "艾古伊",
            "text": "看看，我说什么来着？太危险了，你应付不来。你还不信，现在吃到教训了吧？",
            "nextDialogs": [
              "740910506"
            ]
          },
          "740910506": {
            "id": "740910506",
            "speakerId": 5227,
            "speakerName": "巴朗",
            "text": "我…我…",
            "nextDialogs": [
              "740910507"
            ]
          },
          "740910507": {
            "id": "740910507",
            "speakerId": 5226,
            "speakerName": "艾古伊",
            "text": "怎么，你还想嘴硬？我倒要听听，你还有什么高见。",
            "nextDialogs": [
              "740910508"
            ]
          },
          "740910508": {
            "id": "740910508",
            "speakerId": 5227,
            "speakerName": "巴朗",
            "text": "让我喝口水…",
            "nextDialogs": [
              "740910509"
            ]
          },
          "740910509": {
            "id": "740910509",
            "speakerId": 1004,
            "speakerName": "Black Screen",
            "text": "巴朗找到水瓶，咕噜咕噜猛灌了几口，接着又掰了一块干面包嚼了起来。\\n其间不管老人说什么，他都好像没听见似的，只顾吃喝。",
            "nextDialogs": [
              "740910510"
            ]
          },
          "740910510": {
            "id": "740910510",
            "speakerId": 5227,
            "speakerName": "巴朗",
            "text": "呼…总算是…总算是活下来了。感谢两位相助，不然我恐怕是…",
            "nextDialogs": [
              "740910511"
            ]
          },
          "740910511": {
            "id": "740910511",
            "speakerId": 5226,
            "speakerName": "艾古伊",
            "text": "恐怕是只能留下些抚恤金给你的父母了。",
            "nextDialogs": [
              "740910512"
            ]
          },
          "740910512": {
            "id": "740910512",
            "speakerId": 5227,
            "speakerName": "巴朗",
            "text": "哼，那也比因为玩忽职守而导致重大安全事故最后被革职要强得多。",
            "nextDialogs": [
              "740910513"
            ]
          },
          "740910513": {
            "id": "740910513",
            "speakerId": 5226,
            "speakerName": "艾古伊",
            "text": "臭小子…唉，真是跟你说不通！",
            "nextDialogs": [
              "740910514"
            ]
          },
          "740910514": {
            "id": "740910514",
            "speakerId": 5227,
            "speakerName": "巴朗",
            "text": "两位，虽然这么说非常厚脸皮…可是我必须说，这也是为了大家的安全。",
            "nextDialogs": [
              "740910515"
            ]
          },
          "740910515": {
            "id": "740910515",
            "speakerId": 5227,
            "speakerName": "巴朗",
            "text": "两位应该会潜水吧？",
            "nextDialogs": [
              "740910516"
            ]
          },
          "740910516": {
            "id": "740910516",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "会倒是会…",
            "nextDialogs": [
              "740910517"
            ]
          },
          "740910517": {
            "id": "740910517",
            "speakerId": 5227,
            "speakerName": "巴朗",
            "text": "我被丘丘人抓住的时候，潜水服也丢失了，此前例行检查时发现备用品损坏了，虽然重新申请了，但还没送到…",
            "nextDialogs": [
              "740910518"
            ]
          },
          "740910518": {
            "id": "740910518",
            "speakerId": 5227,
            "speakerName": "巴朗",
            "text": "但是管道的维护工作不能怠慢，两位会潜水的话，能否麻烦两位代替我下水检查一下梅洛彼得堡的管道。",
            "nextDialogs": [
              "740910519"
            ]
          },
          "740910519": {
            "id": "740910519",
            "speakerId": 5227,
            "speakerName": "巴朗",
            "text": "当然，酬劳我一定会准备好，不会亏待两位。",
            "nextDialogs": [
              "740910520"
            ]
          },
          "740910520": {
            "id": "740910520",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "既然关系到大家的安全，这忙我们也不是不能帮。但是检查管道听起来好像是很专业的工作，交给我们真的没问题吗？",
            "nextDialogs": [
              "740910521"
            ]
          },
          "740910521": {
            "id": "740910521",
            "speakerId": 5227,
            "speakerName": "巴朗",
            "text": "只是例行检查而已，我估计是会有一些小问题，上次检查的时候就发现有四处风险…但处理起来应该不会太难，我给你们讲讲！",
            "nextDialogs": [
              "740910522"
            ]
          },
          "740910522": {
            "id": "740910522",
            "speakerId": 5227,
            "speakerName": "巴朗",
            "text": "如果在水下发现管道有<color=#00E1FFFF>气体外泄</color>的情况，应该是水下生物…或者是非生物的冲撞导致的。",
            "nextDialogs": [
              "740910523"
            ]
          },
          "740910523": {
            "id": "740910523",
            "speakerId": 5227,
            "speakerName": "巴朗",
            "text": "应急处理的方法是<color=#00E1FFFF>控制调节阀调整流量，暂时止住气体外泄</color>。你们只需要做到这种程度就好了。",
            "nextDialogs": [
              "740910527"
            ]
          },
          "740910527": {
            "id": "740910527",
            "speakerId": 5227,
            "speakerName": "巴朗",
            "text": "调节阀的操作是有技巧的，<color=#00E1FFFF>转动手轮时需要观察气体流量，如果气体流量变小了，就说明思路没问题</color>。",
            "nextDialogs": [
              "740910524"
            ]
          },
          "740910524": {
            "id": "740910524",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "哦…好像听懂了！",
            "nextDialogs": [
              "740910525"
            ]
          },
          "740910525": {
            "id": "740910525",
            "speakerId": 5227,
            "speakerName": "巴朗",
            "text": "如果还有哪里不明白，在例行检查完成之前，有任何问题我随时为两位解答。",
            "nextDialogs": [
              "740910526"
            ]
          },
          "740910526": {
            "id": "740910526",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "好吧，总之我们先去试试！"
          }
        }
      }
    },

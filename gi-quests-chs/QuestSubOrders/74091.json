    {
      "subId": "7409110",
      "subQuestName": "向巴朗回报",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "740911001"
        ],
        "dialogs": {
          "740911001": {
            "id": "740911001",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "我们回来了！的确有些问题呢，不过都按你教我们的方法处理好了，你就放心好啦。",
            "nextDialogs": [
              "740911002"
            ]
          },
          "740911002": {
            "id": "740911002",
            "speakerId": 5227,
            "speakerName": "巴朗",
            "text": "真是太谢谢你们了，这些小的安全隐患如果不及时排除，等到酿成大祸就后悔也来不及了。",
            "nextDialogs": [
              "740911003"
            ]
          },
          "740911003": {
            "id": "740911003",
            "speakerId": 5227,
            "speakerName": "巴朗",
            "text": "…所以我无法认同艾古伊老先生的观点，即便我知道，他是以他的方式关照我。"
          }
        }
      }
    },
    {
      "subId": "7409114",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "740911401"
        ],
        "dialogs": {
          "740911401": {
            "id": "740911401",
            "speakerId": 5226,
            "speakerName": "艾古伊",
            "text": "唉，你们也别太拼命了，遇到自己解决不了的问题别硬撑。"
          }
        }
      }
    },
    {
      "subId": "7409117",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "740911701"
        ],
        "dialogs": {
          "740911701": {
            "id": "740911701",
            "speakerId": 5226,
            "speakerName": "艾古伊",
            "text": "那些麻烦的检修工作既然有人帮忙，何必要自己费那么大劲…",
            "nextDialogs": [
              "740911703",
              "740911707"
            ]
          },
          "740911703": {
            "id": "740911703",
            "speakerId": 5226,
            "speakerName": "艾古伊",
            "text": "梅洛彼得堡那么多管道，总得有人维护吧？我们就是干这个的。",
            "nextDialogs": [
              "740911704"
            ]
          },
          "740911704": {
            "id": "740911704",
            "speakerId": 5226,
            "speakerName": "艾古伊",
            "text": "不过大部分时候都只是些小修小补罢了，毕竟真要出了大问题，靠我又有什么用？",
            "nextDialogs": [
              "740911705"
            ]
          },
          "740911705": {
            "id": "740911705",
            "speakerId": 5226,
            "speakerName": "艾古伊",
            "text": "还是做些自己力所能及的事吧，比如趁休假时帮人捎些信去城里…"
          },
          "740911707": {
            "id": "740911707",
            "speakerId": 5226,
            "speakerName": "艾古伊",
            "text": "反正我闲得很，哪有什么打扰不打扰的。"
          }
        }
      }
    }
  ]

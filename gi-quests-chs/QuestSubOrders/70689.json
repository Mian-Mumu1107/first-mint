  "subQuests": [
    {
      "subId": "7068901",
      "subQuestName": "与凯瑟琳对话",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "706890114"
        ],
        "dialogs": {
          "706890114": {
            "id": "706890114",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "<color=#FFCC33FF>有什么新鲜事吗？</color>",
            "nextDialogs": [
              "706890101"
            ]
          },
          "706890101": {
            "id": "706890101",
            "speakerId": 12913,
            "speakerName": "凯瑟琳",
            "text": "#{NICKNAME}，您来得正好，请留步。我有一件东西需要交给您。",
            "nextDialogs": [
              "706890104"
            ]
          },
          "706890104": {
            "id": "706890104",
            "speakerId": 12913,
            "speakerName": "凯瑟琳",
            "text": "…您确实已经对本协会的各项事务很熟悉了。但很遗憾，这件东西和以上委托皆无关系。",
            "nextDialogs": [
              "706890105"
            ]
          },
          "706890105": {
            "id": "706890105",
            "speakerId": 12913,
            "speakerName": "凯瑟琳",
            "text": "请拿好这本协会制作的新型笔记本。"
          }
        }
      }
    },

    {
      "subId": "1200003",
      "subQuestName": "向纪芳打听游览指南",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "120000301"
        ],
        "dialogs": {
          "120000301": {
            "id": "120000301",
            "speakerId": 1625,
            "speakerName": "纪芳",
            "text": "啊，随便看看吧，不买也行。",
            "nextDialogs": [
              "120000302"
            ]
          },
          "120000302": {
            "id": "120000302",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "我们是来找书的，这里有没有《提瓦特游览指南》的璃月篇呢？",
            "nextDialogs": [
              "120000303"
            ]
          },
          "120000303": {
            "id": "120000303",
            "speakerId": 1625,
            "speakerName": "纪芳",
            "text": "哦，这本书很久以前就不卖了，没什么人气。",
            "nextDialogs": [
              "120000304"
            ]
          },
          "120000304": {
            "id": "120000304",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "欸？！明明蒙德篇那么有趣…太可惜了！",
            "nextDialogs": [
              "120000305"
            ]
          },
          "120000305": {
            "id": "120000305",
            "speakerId": 1625,
            "speakerName": "纪芳",
            "text": "这书的作者太有个性了，说是指南，但其实起不到什么指南的作用。",
            "nextDialogs": [
              "120000306"
            ]
          },
          "120000306": {
            "id": "120000306",
            "speakerId": 1625,
            "speakerName": "纪芳",
            "text": "不仅卖不出去，我曾经还因为这书被游客投诉过。",
            "nextDialogs": [
              "120000309"
            ]
          },
          "120000309": {
            "id": "120000309",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "但我还是觉得很可惜，蒙德篇当成冒险日记来读也很有趣啊…",
            "nextDialogs": [
              "120000310"
            ]
          },
          "120000310": {
            "id": "120000310",
            "speakerId": 1625,
            "speakerName": "纪芳",
            "text": "反正我这里现在已经没有了，如果实在想看，可以去常九爷那儿碰碰运气。",
            "nextDialogs": [
              "120000311"
            ]
          },
          "120000311": {
            "id": "120000311",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "常九爷？",
            "nextDialogs": [
              "120000312"
            ]
          },
          "120000312": {
            "id": "120000312",
            "speakerId": 1625,
            "speakerName": "纪芳",
            "text": "他住在轻策庄，收藏各种书籍。虽然脾气不太好，但聊到藏书还是很健谈的。",
            "nextDialogs": [
              "120000313"
            ]
          },
          "120000313": {
            "id": "120000313",
            "speakerId": 1625,
            "speakerName": "纪芳",
            "text": "他还在璃月港的时候就是我的老主顾了，现在我有时也会给他寄两本绝版藏书…",
            "nextDialogs": [
              "120000324"
            ]
          },
          "120000324": {
            "id": "120000324",
            "speakerId": 1625,
            "speakerName": "纪芳",
            "text": "不过他住的地方很难找，要先沿着轻策庄后山的栈道一路爬上去…",
            "nextDialogs": [
              "120000314"
            ]
          },
          "120000314": {
            "id": "120000314",
            "speakerId": 10205,
            "speakerName": "？？？",
            "text": "你说，绝版藏书？",
            "nextDialogs": [
              "120000315"
            ]
          },
          "120000315": {
            "id": "120000315",
            "speakerId": 10205,
            "speakerName": "？？？",
            "text": "那已经绝版的《神霄折戟录》第六卷，也可能在他的收藏之中？"
          }
        }
      }
    },
    {
      "subId": "1200004",
      "subQuestName": "前往轻策庄后山，拜访常九爷",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [],
        "dialogs": {}
      }
    },
    {
      "subId": "1200005",
      "subQuestName": "与常九爷对话",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "120000501"
        ],
        "dialogs": {
          "120000501": {
            "id": "120000501",
            "speakerId": 1624,
            "speakerName": "常九爷",
            "text": "唉，天要亡我啊…天要…亡我…",
            "nextDialogs": [
              "120000502"
            ]
          },
          "120000502": {
            "id": "120000502",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "请问你就是常九爷吗？",
            "nextDialogs": [
              "120000503"
            ]
          },
          "120000503": {
            "id": "120000503",
            "speakerId": 1624,
            "speakerName": "常九爷",
            "text": "嗯，有事吗？有事快说。",
            "nextDialogs": [
              "120000504"
            ]
          },
          "120000504": {
            "id": "120000504",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "听说你这里有很多绝版的藏书，我们想借《提瓦特游览指南》的璃月篇看一看。",
            "nextDialogs": [
              "120000505"
            ]
          },
          "120000505": {
            "id": "120000505",
            "speakerId": 1624,
            "speakerName": "常九爷",
            "text": "唉，别跟我提书的事了，我都快烦死了。",
            "nextDialogs": [
              "120000506"
            ]
          },
          "120000506": {
            "id": "120000506",
            "speakerId": 1624,
            "speakerName": "常九爷",
            "text": "层岩巨渊封锁以后，我家矿石生意很不好做，「愚人众」还在下黑手…",
            "nextDialogs": [
              "120000507"
            ]
          },
          "120000507": {
            "id": "120000507",
            "speakerId": 1624,
            "speakerName": "常九爷",
            "text": "为了筹货款，我只能把我的爱书都拿去当了…！你知道这意味什么吗？！",
            "nextDialogs": [
              "120000510"
            ]
          },
          "120000510": {
            "id": "120000510",
            "speakerId": 1624,
            "speakerName": "常九爷",
            "text": "不对！是我的人生！我倾尽一生收藏的！保护的！我的藏书，没了！！",
            "nextDialogs": [
              "120000511"
            ]
          },
          "120000511": {
            "id": "120000511",
            "speakerId": 1624,
            "speakerName": "常九爷",
            "text": "唉…算了，冲着你们大吼大叫也没什么意义。早点筹钱把书赎回来才是真的。",
            "nextDialogs": [
              "120000512"
            ]
          },
          "120000512": {
            "id": "120000512",
            "speakerId": 1624,
            "speakerName": "常九爷",
            "text": "没其他事的话，我也没心情聊天。走吧走吧。",
            "nextDialogs": [
              "120000513"
            ]
          },
          "120000513": {
            "id": "120000513",
            "speakerId": 10045,
            "speakerName": "行秋",
            "text": "莫非，连《神霄折戟录》的第六卷，也当掉了？",
            "nextDialogs": [
              "120000514"
            ]
          },
          "120000514": {
            "id": "120000514",
            "speakerId": 1624,
            "speakerName": "常九爷",
            "text": "哦？想不到会听到这个名字…你还挺有品味的。",
            "nextDialogs": [
              "120000515"
            ]
          },
          "120000515": {
            "id": "120000515",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "意思是我们没有品味吗？！",
            "nextDialogs": [
              "120000516"
            ]
          },
          "120000516": {
            "id": "120000516",
            "speakerId": 1624,
            "speakerName": "常九爷",
            "text": "这可是具有时代意义的一本奇书，当年刚推出的时候不被任何人看好…",
            "nextDialogs": [
              "120000517"
            ]
          },
          "120000517": {
            "id": "120000517",
            "speakerId": 1624,
            "speakerName": "常九爷",
            "text": "但它改变了很多人对武侠小说的印象，之后也出现了大批的模仿者。",
            "nextDialogs": [
              "120000518"
            ]
          },
          "120000518": {
            "id": "120000518",
            "speakerId": 1624,
            "speakerName": "常九爷",
            "text": "最初的一版数量非常少，几乎一下子就绝版了。",
            "nextDialogs": [
              "120000519"
            ]
          },
          "120000519": {
            "id": "120000519",
            "speakerId": 10045,
            "speakerName": "行秋",
            "text": "在后来的加印版本中，作为补充故事的第六卷，不知为何并没有再版的机会。",
            "nextDialogs": [
              "120000520"
            ]
          },
          "120000520": {
            "id": "120000520",
            "speakerId": 1624,
            "speakerName": "常九爷",
            "text": "对对对，就是这样！因为存世数量非常之少，无论我再怎么缺钱，也舍不得当掉啊。",
            "nextDialogs": [
              "120000521"
            ]
          },
          "120000521": {
            "id": "120000521",
            "speakerId": 10045,
            "speakerName": "行秋",
            "text": "这么说，这本书还在你的手上？！",
            "nextDialogs": [
              "120000522"
            ]
          },
          "120000522": {
            "id": "120000522",
            "speakerId": 1624,
            "speakerName": "常九爷",
            "text": "嗯，这是我剩下的唯一一本爱书了…",
            "nextDialogs": [
              "120000523"
            ]
          },
          "120000523": {
            "id": "120000523",
            "speakerId": 2062,
            "speakerName": "昌虎",
            "text": "喂，老常！",
            "nextDialogs": [
              "120000524"
            ]
          },
          "120000524": {
            "id": "120000524",
            "speakerId": 2062,
            "speakerName": "昌虎",
            "text": "磨磨蹭蹭的，是我家老爷给你脸了？那批石珀，究竟是卖还是不卖？！",
            "nextDialogs": [
              "120000525"
            ]
          },
          "120000525": {
            "id": "120000525",
            "speakerId": 2062,
            "speakerName": "昌虎",
            "text": "惹恼了茂才公，就等于惹恼了「愚人众」，这道理总该明白吧。",
            "nextDialogs": [
              "120000526"
            ]
          },
          "120000526": {
            "id": "120000526",
            "speakerId": 1624,
            "speakerName": "常九爷",
            "text": "啊，又是你…",
            "nextDialogs": [
              "120000527"
            ]
          },
          "120000527": {
            "id": "120000527",
            "speakerId": 1624,
            "speakerName": "常九爷",
            "text": "可我也不能三折来卖这一批石珀啊，那样的话…我可能再也赎不回我的书了…",
            "nextDialogs": [
              "120000528"
            ]
          },
          "120000528": {
            "id": "120000528",
            "speakerId": 2062,
            "speakerName": "昌虎",
            "text": "那我不管，你是要看书还是要吃饭？还是想带着书进棺材提前躺好？",
            "nextDialogs": [
              "120000529"
            ]
          },
          "120000529": {
            "id": "120000529",
            "speakerId": 1624,
            "speakerName": "常九爷",
            "text": "呃，你…唉…",
            "nextDialogs": [
              "120000530"
            ]
          },
          "120000530": {
            "id": "120000530",
            "speakerId": 10045,
            "speakerName": "行秋",
            "text": "话不能这么讲，这位兄台。买卖讲究一个你情我愿，哪里有强买强卖的道理。",
            "nextDialogs": [
              "120000531"
            ]
          },
          "120000531": {
            "id": "120000531",
            "speakerId": 2062,
            "speakerName": "昌虎",
            "text": "你又是从哪儿冒出来的？关你什么事！",
            "nextDialogs": [
              "120000532"
            ]
          },
          "120000532": {
            "id": "120000532",
            "speakerId": 10045,
            "speakerName": "行秋",
            "text": "在下路见不平行侠仗义之人，古华派，行秋。",
            "nextDialogs": [
              "120000533"
            ]
          },
          "120000533": {
            "id": "120000533",
            "speakerId": 2062,
            "speakerName": "昌虎",
            "text": "噗…噗哈哈哈——！",
            "nextDialogs": [
              "120000534"
            ]
          },
          "120000534": {
            "id": "120000534",
            "speakerId": 2062,
            "speakerName": "昌虎",
            "text": "古华派，他说古华派！哈哈哈——！听见了吗？这年头还有人提古华派！",
            "nextDialogs": [
              "120000535"
            ]
          },
          "120000535": {
            "id": "120000535",
            "speakerId": 2062,
            "speakerName": "昌虎",
            "text": "不过是个断了香火、摇摇欲坠的小门派吧？就这还敢行侠仗义？",
            "nextDialogs": [
              "120000536"
            ]
          },
          "120000536": {
            "id": "120000536",
            "speakerId": 10045,
            "speakerName": "行秋",
            "text": "正义和身份可没什么关系，你只不过是个狐假虎威的小家丁，不是一样在作恶吗？",
            "nextDialogs": [
              "120000537"
            ]
          },
          "120000537": {
            "id": "120000537",
            "speakerId": 2062,
            "speakerName": "昌虎",
            "text": "你…你！行啊，你给我等着！看我有没有本事收拾你！",
            "nextDialogs": [
              "120000538"
            ]
          },
          "120000538": {
            "id": "120000538",
            "speakerId": 2062,
            "speakerName": "昌虎",
            "text": "还有你，老常！这批矿你不卖也得卖！",
            "nextDialogs": [
              "120000539"
            ]
          },
          "120000539": {
            "id": "120000539",
            "speakerId": 1624,
            "speakerName": "常九爷",
            "text": "唉，虎落平阳被犬欺。这日子是过不下去了啊。",
            "nextDialogs": [
              "120000540"
            ]
          },
          "120000540": {
            "id": "120000540",
            "speakerId": 10045,
            "speakerName": "行秋",
            "text": "那话说回来吧，究竟能否将书借给我呢？"
          }
        }
      }
    },
    {
      "subId": "1200006",
      "subQuestName": "寻找借书离开的行秋",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "120000601"
        ],
        "dialogs": {
          "120000601": {
            "id": "120000601",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "站在这里看书就是你行侠仗义的方式吗？",
            "nextDialogs": [
              "120000602"
            ]
          },
          "120000602": {
            "id": "120000602",
            "speakerId": 10045,
            "speakerName": "行秋",
            "text": "有意思，有意思，原来还发生了这样的事…",
            "nextDialogs": [
              "120000603"
            ]
          },
          "120000603": {
            "id": "120000603",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "喂，听我说话啦！",
            "nextDialogs": [
              "120000604"
            ]
          },
          "120000604": {
            "id": "120000604",
            "speakerId": 10045,
            "speakerName": "行秋",
            "text": "原来如此，备受追捧果然是有原因的啊。",
            "nextDialogs": [
              "120000608"
            ]
          },
          "120000608": {
            "id": "120000608",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "喂——",
            "nextDialogs": [
              "120000607"
            ]
          },
          "120000607": {
            "id": "120000607",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "是啊，不能以超低价买到矿石，就要让常九爷吃苦头，他们简直和强盗没区别！"
          }
        }
      }
    },
    {
      "subId": "1200009",
      "subQuestName": "击败来袭的愚人众",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [],
        "dialogs": {}
      }
    },
    {
      "subId": "1200011",
      "subQuestName": "(test)击败来袭的愚人众$HIDDEN",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [],
        "dialogs": {}
      }
    },
    {
      "subId": "1200010",
      "subQuestName": "(test)击败来袭的愚人众$HIDDEN",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "120001001"
        ],
        "dialogs": {
          "120001001": {
            "id": "120001001",
            "speakerId": 2062,
            "speakerName": "昌虎",
            "text": "还以为腰上那个只是普通的玉石…没想到居然是「神之眼」！",
            "nextDialogs": [
              "120001002"
            ]
          },
          "120001002": {
            "id": "120001002",
            "speakerId": 2062,
            "speakerName": "昌虎",
            "text": "今、今天就先放过你！咱们走着瞧！这事没完！",
            "nextDialogs": [
              "120001022"
            ]
          },
          "120001022": {
            "id": "120001022",
            "speakerId": 10045,
            "speakerName": "行秋",
            "text": "唉，指望他们吸取教训，是不可能的吧。",
            "nextDialogs": [
              "120001004",
              "120001006"
            ]
          },
          "120001004": {
            "id": "120001004",
            "speakerId": 10045,
            "speakerName": "行秋",
            "text": "嗯，只不过以「神之眼」退敌有恃强凌弱之嫌，所以我不太喜欢用。",
            "nextDialogs": [
              "120001008"
            ]
          },
          "120001008": {
            "id": "120001008",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "他们现在走了，但肯定会再来找麻烦。",
            "nextDialogs": [
              "120001009"
            ]
          },
          "120001009": {
            "id": "120001009",
            "speakerId": 10045,
            "speakerName": "行秋",
            "text": "我知道，我不会害了我的恩人，商有商道，这件事我会负责到底。",
            "nextDialogs": [
              "120001010"
            ]
          },
          "120001010": {
            "id": "120001010",
            "speakerId": 10045,
            "speakerName": "行秋",
            "text": "「愚人众」平常不会站在某个商人一边，但看那家丁的嚣张态度，应该所言非虚。",
            "nextDialogs": [
              "120001011"
            ]
          },
          "120001011": {
            "id": "120001011",
            "speakerId": 10045,
            "speakerName": "行秋",
            "text": "这其中多半是有更深的勾结。",
            "nextDialogs": [
              "120001012"
            ]
          },
          "120001012": {
            "id": "120001012",
            "speakerId": 10045,
            "speakerName": "行秋",
            "text": "刚才他们提到的「茂才公」，这名号我也听过，他的宅子在璃月港很显眼，拜托你们去打探些线索吧。",
            "nextDialogs": [
              "120001013"
            ]
          },
          "120001013": {
            "id": "120001013",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "道理是有道理的…那你要干什么呢？",
            "nextDialogs": [
              "120001014"
            ]
          },
          "120001014": {
            "id": "120001014",
            "speakerId": 10045,
            "speakerName": "行秋",
            "text": "我？我还有其他想要了解的事，我想想…等下我们就在璃月港的玉京台见吧。",
            "nextDialogs": [
              "120001015"
            ]
          },
          "120001015": {
            "id": "120001015",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "真的吗？不会只是想使唤我们去跑腿吧？",
            "nextDialogs": [
              "120001016"
            ]
          },
          "120001016": {
            "id": "120001016",
            "speakerId": 10045,
            "speakerName": "行秋",
            "text": "哦哦，竟然发生了这样的事，这一段真是妙，妙不可言！",
            "nextDialogs": [
              "120001017"
            ]
          },
          "120001017": {
            "id": "120001017",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "唔唔唔！气死我了！我可以打他吗！"
          },
          "120001006": {
            "id": "120001006",
            "speakerId": 10045,
            "speakerName": "行秋",
            "text": "不不不，你误会了，刚才那人的话虽不堪入耳，但对古华派的评价…其实也不算错…唉。",
            "nextDialogs": [
              "120001007"
            ]
          },
          "120001007": {
            "id": "120001007",
            "speakerId": 10045,
            "speakerName": "行秋",
            "text": "虽然我有重振山门之愿，但这也非一朝一夕之功。"
          }
        }
      }
    },

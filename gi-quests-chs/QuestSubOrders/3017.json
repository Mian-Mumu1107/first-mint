  "subQuests": [
    {
      "subId": "301701",
      "subQuestName": "前往化城郭",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "30170101"
        ],
        "dialogs": {
          "30170101": {
            "id": "30170101",
            "speakerId": 1000,
            "speakerName": "塔什芬",
            "text": "站住。",
            "nextDialogs": [
              "30170102"
            ]
          },
          "30170102": {
            "id": "30170102",
            "speakerId": 1000,
            "speakerName": "塔什芬",
            "text": "金发旅行者，还有漂浮着的小精灵，看来没错了。看看周围，你们已经中了我们的埋伏了。",
            "nextDialogs": [
              "30170103"
            ]
          },
          "30170103": {
            "id": "30170103",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "你们！你们是「三十人团」的家伙吗？是来抓我们的吗？",
            "nextDialogs": [
              "30170104"
            ]
          },
          "30170104": {
            "id": "30170104",
            "speakerId": 1000,
            "speakerName": "塔什芬",
            "text": "「三十人团」…我们可不是那些给官方打杂，又吃力不讨好的走狗们。",
            "nextDialogs": [
              "30170105"
            ]
          },
          "30170105": {
            "id": "30170105",
            "speakerId": 1000,
            "speakerName": "塔什芬",
            "text": "我们可是在须弥收取最高一档佣金的精英佣兵团，这次是为了完成一位名叫「放逐者」的先生的委托。",
            "nextDialogs": [
              "30170106"
            ]
          },
          "30170106": {
            "id": "30170106",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "「放逐者」…教令院的放逐者？",
            "nextDialogs": [
              "30170107"
            ]
          },
          "30170107": {
            "id": "30170107",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "看来是「博士」了。",
            "nextDialogs": [
              "30170108"
            ]
          },
          "30170108": {
            "id": "30170108",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "可是「博士」为什么不直接派愚人众来抓我们呢？",
            "nextDialogs": [
              "30170111"
            ]
          },
          "30170111": {
            "id": "30170111",
            "speakerId": 1000,
            "speakerName": "塔什芬",
            "text": "还有功夫闲聊这些，看起来你们是真的不怕死啊。给我上！",
            "nextDialogs": [
              "30170112"
            ]
          },
          "30170112": {
            "id": "30170112",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "#{NICKNAME}，我们…我们上！"
          }
        }
      }
    },
    {
      "subId": "301702",
      "subQuestName": "击败埋伏的镀金旅团",
      "sceneId": null,
      "locations": [],

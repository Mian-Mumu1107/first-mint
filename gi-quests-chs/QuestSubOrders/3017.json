        "dialogs": {}
      }
    },
    {
      "subId": "301703",
      "subQuestName": "和派蒙整理情报",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "30170301"
        ],
        "dialogs": {
          "30170301": {
            "id": "30170301",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "的确有些棘手呢，这就是佣兵中的精英吗？",
            "nextDialogs": [
              "30170302"
            ]
          },
          "30170302": {
            "id": "30170302",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "估计不会只有这一波埋伏。",
            "nextDialogs": [
              "30170303"
            ]
          },
          "30170303": {
            "id": "30170303",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "是啊，看来我们以后也要多多提防了。",
            "nextDialogs": [
              "30170304"
            ]
          },
          "30170304": {
            "id": "30170304",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "不过「博士」真的有些可怕，是算准了我们会去找提纳里吗，所以才雇人在这里设下埋伏…",
            "nextDialogs": [
              "30170305"
            ]
          },
          "30170305": {
            "id": "30170305",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "和聪明人作对可真是让人头疼啊，我们继续前进吧。"
          }
        }
      }
    },
    {
      "subId": "301704",
      "subQuestName": "寻找提纳里",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "30170401"
        ],
        "dialogs": {
          "30170401": {
            "id": "30170401",
            "speakerId": 1002,
            "speakerName": "柯莱",
            "text": "欸，旅行者，还有派蒙？你们怎么会回来这里？",
            "nextDialogs": [
              "30170402"
            ]
          },
          "30170402": {
            "id": "30170402",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "柯莱！又见面了，你还好吗？",
            "nextDialogs": [
              "30170403"
            ]
          },
          "30170403": {
            "id": "30170403",
            "speakerId": 1002,
            "speakerName": "柯莱",
            "text": "我…坦诚地讲，不是很好。最近我身上的魔鳞病有加速恶化的趋势，很多细碎的工作也都变得难以完成了。",
            "nextDialogs": [
              "30170404"
            ]
          },
          "30170404": {
            "id": "30170404",
            "speakerId": 1002,
            "speakerName": "柯莱",
            "text": "所以提纳里师父取消了我的各类巡林任务，只允许我留在这里协助组织工作。",
            "nextDialogs": [
              "30170405"
            ]
          },
          "30170405": {
            "id": "30170405",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "这样啊…柯莱…",
            "nextDialogs": [
              "30170406"
            ]
          },
          "30170406": {
            "id": "30170406",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "看来只有根治世界树才能…",
            "nextDialogs": [
              "30170407"
            ]
          },
          "30170407": {
            "id": "30170407",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "话说提纳里呢，是外出巡林了吗？我们是来找他的。",
            "nextDialogs": [
              "30170408"
            ]
          },
          "30170408": {
            "id": "30170408",
            "speakerId": 1002,
            "speakerName": "柯莱",
            "text": "提纳里师父吗，他最近刚刚离开了道成林，到禅那园去了。",
            "nextDialogs": [
              "30170409"
            ]
          },
          "30170409": {
            "id": "30170409",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "啊？提纳里走了？可是…可是过去提纳里不是一直不愿离开道成林，连贤者的邀请都拒绝了吗？",
            "nextDialogs": [
              "30170410"
            ]
          },
          "30170410": {
            "id": "30170410",
            "speakerId": 1002,
            "speakerName": "柯莱",
            "text": "我也觉得奇怪…提纳里师父他一直很看重巡林官的工作，不会轻易离开，可这次却匆匆忙忙地走了。",
            "nextDialogs": [
              "30170411"
            ]
          },
          "30170411": {
            "id": "30170411",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "他没说去干什么了吗？",
            "nextDialogs": [
              "30170412"
            ]
          },
          "30170412": {
            "id": "30170412",
            "speakerId": 1002,
            "speakerName": "柯莱",
            "text": "没有，就连他要走的消息都是留下字条通知我的，各种事务也通过排班表安排好了。",
            "nextDialogs": [
              "30170413"
            ]
          },
          "30170413": {
            "id": "30170413",
            "speakerId": 1002,
            "speakerName": "柯莱",
            "text": "走得这么匆忙，估计是有什么需要争分夺秒的事情吧。",
            "nextDialogs": [
              "30170414"
            ]
          },
          "30170414": {
            "id": "30170414",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "你刚才说提纳里去的是禅那园，那是什么地方呀？",
            "nextDialogs": [
              "30170415"
            ]
          },
          "30170415": {
            "id": "30170415",
            "speakerId": 1002,
            "speakerName": "柯莱",
            "text": "提纳里师父之前在教令院的生论派进修，而禅那园则类似于生论派的研究基地，种植了各种稀有植被以供研究。",
            "nextDialogs": [
              "30170416"
            ]
          },
          "30170416": {
            "id": "30170416",
            "speakerId": 1002,
            "speakerName": "柯莱",
            "text": "我知道提纳里师父在成为巡林官以前，曾经有很长一段时间在禅那园专心钻研学术。",
            "nextDialogs": [
              "30170417"
            ]
          },
          "30170417": {
            "id": "30170417",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "研究基地吗…提纳里到底突发奇想要搞什么研究呀…",
            "nextDialogs": [
              "30170418"
            ]
          },
          "30170418": {
            "id": "30170418",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "#{NICKNAME}，时间紧迫，那我们就去一趟那个禅那园找他吧。",
            "nextDialogs": [
              "30170421"
            ]
          },
          "30170421": {
            "id": "30170421",
            "speakerId": 1002,
            "speakerName": "柯莱",
            "text": "啊…嗯，我没关系，与魔鳞病共生我已经再习惯不过了。见到提纳里师父的话，请代我向他问候。",
            "nextDialogs": [
              "30170422"
            ]
          },
          "30170422": {
            "id": "30170422",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "好的~我们记住了，再见柯莱~！"
          }
        }
      }
    },
    {
      "subId": "301705",
      "subQuestName": "前往禅那园",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "30170501"
        ],
        "dialogs": {
          "30170501": {
            "id": "30170501",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "等等，那边的是！",
            "nextDialogs": [
              "30170504"
            ]
          },
          "30170504": {
            "id": "30170504",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "你果然没事，真是太好了！我们好担心你的…"
          }
        }
      }
    },
    {
      "subId": "301706",
      "subQuestName": "进入禅那园内部",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "30170601"
        ],
        "dialogs": {
          "30170601": {
            "id": "30170601",
            "speakerId": 1003,
            "speakerName": "海芭夏",
            "text": "#{NICKNAME}？是{NICKNAME}吗！",
            "nextDialogs": [
              "30170602"
            ]
          },
          "30170602": {
            "id": "30170602",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "啊！你是…海芭夏！",
            "nextDialogs": [
              "30170605"
            ]
          },
          "30170605": {
            "id": "30170605",
            "speakerId": 1003,
            "speakerName": "海芭夏",
            "text": "天啊，可真是令人开心，能见到你们真是太好了。",
            "nextDialogs": [
              "30170606"
            ]
          },
          "30170606": {
            "id": "30170606",
            "speakerId": 1004,
            "speakerName": "纳西妲",
            "text": "这位是…？",
            "nextDialogs": [
              "30170607"
            ]
          },
          "30170607": {
            "id": "30170607",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "是我们在道成林时候遇见的修行学者，当时正在那什么…「林居狂语期」。",
            "nextDialogs": [
              "30170608"
            ]
          },
          "30170608": {
            "id": "30170608",
            "speakerId": 1004,
            "speakerName": "纳西妲",
            "text": "唔…这样吗。",
            "nextDialogs": [
              "30170609"
            ]
          },
          "30170609": {
            "id": "30170609",
            "speakerId": 1003,
            "speakerName": "海芭夏",
            "text": "是啊，我们可是老朋友了。正巧我来这边之后，没什么人愿意跟我讲话，你们来得正是时候。",
            "nextDialogs": [
              "30170610"
            ]
          },
          "30170610": {
            "id": "30170610",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "海芭夏，你开心过头啦。话说你居然已经离开道成林了吗，不继续在森林里修行啦？",
            "nextDialogs": [
              "30170611"
            ]
          },
          "30170611": {
            "id": "30170611",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "等等，不对…难道说，你已经修行结束，进入「寂静圆满期」了？",
            "nextDialogs": [
              "30170612"
            ]
          },
          "30170612": {
            "id": "30170612",
            "speakerId": 1003,
            "speakerName": "海芭夏",
            "text": "哼哼…你说呢？",
            "nextDialogs": [
              "30170613"
            ]
          },
          "30170613": {
            "id": "30170613",
            "speakerId": 1003,
            "speakerName": "海芭夏",
            "text": "我之前…已经在意识中见过神明了。",
            "nextDialogs": [
              "30170614"
            ]
          },
          "30170614": {
            "id": "30170614",
            "speakerId": 1004,
            "speakerName": "纳西妲",
            "text": "…嗯？",
            "nextDialogs": [
              "30170615"
            ]
          },
          "30170615": {
            "id": "30170615",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "啊？真的吗！恭喜恭喜！"
          }
        }
      }
    },
    {
      "subId": "301707",
      "subQuestName": "与提纳里对话",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "30170701"
        ],
        "dialogs": {
          "30170701": {
            "id": "30170701",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "…好像到这里就没有人追过来了。",
            "nextDialogs": [
              "30170704"
            ]
          },
          "30170704": {
            "id": "30170704",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "#你还好吗，纳西妲…欸，不对！这种感觉是，{NICKNAME}你回来了吗！",
            "nextDialogs": [
              "30170705"
            ]
          },
          "30170705": {
            "id": "30170705",
            "speakerId": 1005,
            "speakerName": "提纳里",
            "text": "#嗯？现在又是{NICKNAME}本人了么？"
          }
        }
      }
    },
    {
      "subId": "301708",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "30170801"
        ],
        "dialogs": {
          "30170801": {
            "id": "30170801",
            "speakerId": 1002,
            "speakerName": "柯莱",
            "text": "当初就决定要对你们坦诚了，所以才没有隐瞒我的病情…不用担心我，我不会有事的。"
          }
        }
      }
    }
  ]
}
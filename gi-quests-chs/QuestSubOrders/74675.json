{
  "lineCounts": {
    "Player": 4,
    "小露米埃尔": 21,
    "派蒙": 3
  },
  "subQuests": [
    {
      "subId": "7467501",
      "subQuestName": "与工作人员对话",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "746750101"
        ],
        "dialogs": {
          "746750101": {
            "id": "746750101",
            "speakerId": 30488,
            "speakerName": "小露米埃尔",
            "text": "美好的一天，不是吗？",
            "nextDialogs": [
              "746750102"
            ]
          },
          "746750102": {
            "id": "746750102",
            "speakerId": 30488,
            "speakerName": "小露米埃尔",
            "text": "出名到你们这种程度，应该不断会有人向你们递名片吧。",
            "nextDialogs": [
              "746750103"
            ]
          },
          "746750103": {
            "id": "746750103",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "#唔…你认识我们？{NICKNAME}，这个孩子好老成啊。",
            "nextDialogs": [
              "746750104"
            ]
          },
          "746750104": {
            "id": "746750104",
            "speakerId": 30488,
            "speakerName": "小露米埃尔",
            "text": "仅仅因为对面年纪尚轻就轻视别人，是无知者才会犯的毛病，我想两位不至于如此肤浅。",
            "nextDialogs": [
              "746750105"
            ]
          },
          "746750105": {
            "id": "746750105",
            "speakerId": 30488,
            "speakerName": "小露米埃尔",
            "text": "尽管我无意自夸，但我和兄长是本地小有名气的映影导演，大家更习惯称呼我为小露米埃尔先生。",
            "nextDialogs": [
              "746750108"
            ]
          },
          "746750108": {
            "id": "746750108",
            "speakerId": 30488,
            "speakerName": "小露米埃尔",
            "text": "没错，我对你们的冒险经历很感兴趣。在我们这行里，非凡的故事永远都会受到追捧。",
            "nextDialogs": [
              "746750109"
            ]
          },
          "746750109": {
            "id": "746750109",
            "speakerId": 30488,
            "speakerName": "小露米埃尔",
            "text": "既然你们还不认识我，那我就先做个自我介绍吧。",
            "nextDialogs": [
              "746750110"
            ]
          },
          "746750110": {
            "id": "746750110",
            "speakerId": 30488,
            "speakerName": "小露米埃尔",
            "text": "我和我的兄长已经合作拍摄映影很久了，也有过几部比较出名的片子，或许你们看过《工厂大门》…？",
            "nextDialogs": [
              "746750111"
            ]
          },
          "746750111": {
            "id": "746750111",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "没有。",
            "nextDialogs": [
              "746750112"
            ]
          },
          "746750112": {
            "id": "746750112",
            "speakerId": 30488,
            "speakerName": "小露米埃尔",
            "text": "哦，没关系，那么《进站》呢？",
            "nextDialogs": [
              "746750113"
            ]
          },
          "746750113": {
            "id": "746750113",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "也没有。",
            "nextDialogs": [
              "746750114"
            ]
          },
          "746750114": {
            "id": "746750114",
            "speakerId": 30488,
            "speakerName": "小露米埃尔",
            "text": "……",
            "nextDialogs": [
              "746750115"
            ]
          },
          "746750115": {
            "id": "746750115",
            "speakerId": 30488,
            "speakerName": "小露米埃尔",
            "text": "啊，这样啊。",
            "nextDialogs": [
              "746750116"
            ]
          },
          "746750116": {
            "id": "746750116",
            "speakerId": 30488,
            "speakerName": "小露米埃尔",
            "text": "…那也不足为奇，我们兄弟作为影人的道路还很长，以后会拍出更多家喻户晓的映影。",
            "nextDialogs": [
              "746750117"
            ]
          },
          "746750117": {
            "id": "746750117",
            "speakerId": 30488,
            "speakerName": "小露米埃尔",
            "text": "映影的制作，从构思故事、演员表演、摄影师和导演合作拍摄，再到处理成片，都是相当有趣的过程。",
            "nextDialogs": [
              "746750118"
            ]
          },
          "746750118": {
            "id": "746750118",
            "speakerId": 30488,
            "speakerName": "小露米埃尔",
            "text": "在这其中，我认为拍摄过程是最具有技术性的部分。",
            "nextDialogs": [
              "746750119"
            ]
          },
          "746750119": {
            "id": "746750119",
            "speakerId": 30488,
            "speakerName": "小露米埃尔",
            "text": "拍摄重点的取舍，决定了观者将得到怎样的信息、感受到怎样的氛围…",
            "nextDialogs": [
              "746750120"
            ]
          },
          "746750120": {
            "id": "746750120",
            "speakerId": 30488,
            "speakerName": "小露米埃尔",
            "text": "虽然旁白也很重要，但我们不能指望只靠旁白来构成一个故事。",
            "nextDialogs": [
              "746750121"
            ]
          },
          "746750121": {
            "id": "746750121",
            "speakerId": 30488,
            "speakerName": "小露米埃尔",
            "text": "四个镜头！我一直相信，只要四个镜头就可以构成一个最小的叙事单元。",
            "nextDialogs": [
              "746750122"
            ]
          },
          "746750122": {
            "id": "746750122",
            "speakerId": 30488,
            "speakerName": "小露米埃尔",
            "text": "在这四个镜头之内，天才可以创造奇迹。",
            "nextDialogs": [
              "746750123"
            ]
          },
          "746750123": {
            "id": "746750123",
            "speakerId": 30488,
            "speakerName": "小露米埃尔",
            "text": "两位想试试看吗？借这个机会，来感受一下映影的魅力吧！",
            "nextDialogs": [
              "746750124"
            ]
          },
          "746750124": {
            "id": "746750124",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "那我们该怎么做？",
            "nextDialogs": [
              "746750125"
            ]
          },
          "746750125": {
            "id": "746750125",
            "speakerId": 30488,
            "speakerName": "小露米埃尔",
            "text": "很简单。我可以为你们提供一些已经成形的短幅情节作为拍摄主题。",
            "nextDialogs": [
              "746750126"
            ]
          },
          "746750126": {
            "id": "746750126",
            "speakerId": 30488,
            "speakerName": "小露米埃尔",
            "text": "重点是尝试镜头与旁白的多种处理方式，从而完成几部短篇映影的拍摄。二位有兴趣吗？",
            "nextDialogs": [
              "746750127"
            ]
          },
          "746750127": {
            "id": "746750127",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "听起来很有趣。",
            "nextDialogs": [
              "746750128"
            ]
          },
          "746750128": {
            "id": "746750128",
            "speakerId": 30488,
            "speakerName": "小露米埃尔",
            "text": "太好了！那么二位准备好之后，随时可以前往我挑好的拍摄地点尝试拍摄，我也会针对拍摄好的成片提出反馈。"
          }
        }
      }
    }
  ]
}
            ]
          },
          "230020102": {
            "id": "230020102",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "范兵卫？这个名字好熟悉啊，好像在哪听人提起过…",
            "nextDialogs": [
              "230020105"
            ]
          },
          "230020105": {
            "id": "230020105",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "呜哇！他是那个拖拖拉拉，把「御影炉心」弄得一团糟的家伙！"
          }
        }
      }
    },
    {
      "subId": "2300202",
      "subQuestName": "前往采摘蘑菇",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "230020201"
        ],
        "dialogs": {
          "230020201": {
            "id": "230020201",
            "speakerId": 4024,
            "speakerName": "范兵卫",
            "text": "怎么样，您采到蘑菇了吗？"
          }
        }
      }
    },
    {
      "subId": "2300203",
      "subQuestName": "采摘蘑菇",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "230020301"
        ],
        "dialogs": {
          "230020301": {
            "id": "230020301",
            "speakerId": 4024,
            "speakerName": "范兵卫",
            "text": "太好了，这些就足够了。这些蘑菇看起来就不错…",
            "nextDialogs": [
              "230020302"
            ]
          },
          "230020302": {
            "id": "230020302",
            "speakerId": 4024,
            "speakerName": "范兵卫",
            "text": "这些酬劳请您收好，多谢您帮忙了。",
            "nextDialogs": [
              "230020303"
            ]
          },
          "230020303": {
            "id": "230020303",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "这是税前还是税后？",
            "nextDialogs": [
              "230020304"
            ]
          },
          "230020304": {
            "id": "230020304",
            "speakerId": 4024,
            "speakerName": "范兵卫",
            "text": "当然是税后了，您放心吧，我不会让您专门回稻妻去补税的。",
            "nextDialogs": [
              "230020305"
            ]
          },
          "230020305": {
            "id": "230020305",
            "speakerId": 4024,
            "speakerName": "范兵卫",
            "text": "不过，也不知道幕府那边的税务政策有没有修改…",
            "nextDialogs": [
              "230020306"
            ]
          },
          "230020306": {
            "id": "230020306",
            "speakerId": 4024,
            "speakerName": "范兵卫",
            "text": "唔，还是找个时间再给阳介写封信吧…"
          }
        }
      }
    },

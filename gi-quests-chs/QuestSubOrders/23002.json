      "dialogue": {
        "startDialogs": [
          "230020501"
        ],
        "dialogs": {
          "230020501": {
            "id": "230020501",
            "speakerId": 4024,
            "speakerName": "范兵卫",
            "text": "这家的蘑菇看起来也不太靠谱啊…",
            "nextDialogs": [
              "230020502"
            ]
          },
          "230020502": {
            "id": "230020502",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "他怎么一副犯愁的样子…不会又惹上什么麻烦了吧…",
            "nextDialogs": [
              "230020503"
            ]
          },
          "230020503": {
            "id": "230020503",
            "speakerId": 4024,
            "speakerName": "范兵卫",
            "text": "旅行者，您来了。上次您拿来的蘑菇质量真是不错。",
            "nextDialogs": [
              "230020504"
            ]
          },
          "230020504": {
            "id": "230020504",
            "speakerId": 4024,
            "speakerName": "范兵卫",
            "text": "这次能请您再去采一些来吗？我想拿来和其他供货商的蘑菇做对比。",
            "nextDialogs": [
              "230020506",
              "230020508"
            ]
          },
          "230020506": {
            "id": "230020506",
            "speakerId": 4024,
            "speakerName": "范兵卫",
            "text": "那就拜托您了。"
          },
          "230020508": {
            "id": "230020508",
            "speakerId": 4024,
            "speakerName": "范兵卫",
            "text": "唔，五六家吧，但这些供货商的蘑菇质量都不太稳定，我实在是有些不安。",
            "nextDialogs": [
              "230020509"
            ]
          },
          "230020509": {
            "id": "230020509",
            "speakerId": 4024,
            "speakerName": "范兵卫",
            "text": "我还会继续找其他供货商，采蘑菇的事情就拜托您了。"
          }
        }
      }

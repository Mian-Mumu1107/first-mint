    {
      "subId": "7103711",
      "subQuestName": "与瑾武交谈",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "710370401"
        ],
        "dialogs": {
          "710370401": {
            "id": "710370401",
            "speakerId": 2616,
            "speakerName": "瑾武",
            "text": "就是这里了…奇怪，志琼那娃子在哪里…",
            "nextDialogs": [
              "710370402"
            ]
          },
          "710370402": {
            "id": "710370402",
            "speakerId": 2616,
            "speakerName": "瑾武",
            "text": "志琼，志琼！",
            "nextDialogs": [
              "710370403"
            ]
          },
          "710370403": {
            "id": "710370403",
            "speakerId": 2616,
            "speakerName": "瑾武",
            "text": "唉…对，那娃子又自顾自跑到矿洞深处画地图了…",
            "nextDialogs": [
              "710370407",
              "710370406"
            ]
          },
          "710370407": {
            "id": "710370407",
            "speakerId": 2616,
            "speakerName": "瑾武",
            "text": "刚刚你们离开的时候，她画了这幅地图。",
            "nextDialogs": [
              "710370408"
            ]
          },
          "710370408": {
            "id": "710370408",
            "speakerId": 2616,
            "speakerName": "瑾武",
            "text": "她应该又跑去深处探险了。请替我告诉她一声，前方很危险，不要冒冒失失地甩下大家自己一个人乱撞…",
            "nextDialogs": [
              "710370409"
            ]
          },
          "710370409": {
            "id": "710370409",
            "speakerId": 2616,
            "speakerName": "瑾武",
            "text": "…如果再惹出什么麻烦拖累大家，瑾武姐的拳头是不会留情的。",
            "nextDialogs": [
              "710370410"
            ]
          },
          "710370410": {
            "id": "710370410",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "呜哇…好凶恶…",
            "nextDialogs": [
              "710370411"
            ]
          },
          "710370411": {
            "id": "710370411",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "好凶恶…",
            "nextDialogs": [
              "710370412"
            ]
          },
          "710370412": {
            "id": "710370412",
            "speakerId": 2616,
            "speakerName": "瑾武",
            "text": "好啦，两位也不要闲着。要么帮我布置营地，要么去前面探路。",
            "nextDialogs": [
              "710370413"
            ]
          },
          "710370413": {
            "id": "710370413",
            "speakerId": 2616,
            "speakerName": "瑾武",
            "text": "抱歉，我不太会说客气话…总之，至少要对大家有用。",
            "nextDialogs": [
              "710370414"
            ]
          },
          "710370414": {
            "id": "710370414",
            "speakerId": 2616,
            "speakerName": "瑾武",
            "text": "啊，顺便一提，如果你们在路上看见了流明石的原晶，就请带给我吧。",
            "nextDialogs": [
              "710370415"
            ]
          },
          "710370415": {
            "id": "710370415",
            "speakerId": 2616,
            "speakerName": "瑾武",
            "text": "我会想办法把它们加工成更有效用的「触媒」。根据我的经验…这些东西在矿下会很有用的。"
          },
          "710370406": {
            "id": "710370406",
            "speakerId": 2616,
            "speakerName": "瑾武",
            "text": "现在还没…哼，不过她如果再不通知我就乱跑的话，她的屁股就有危险了。"
          }
        }
      }
    },

    {
      "subId": "7103709",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "710370901"
        ],
        "dialogs": {
          "710370901": {
            "id": "710370901",
            "speakerId": 2616,
            "speakerName": "瑾武",
            "text": "等你们回来，志琼的地图应该也差不多画好了。",
            "nextDialogs": [
              "710370902"
            ]
          },
          "710370902": {
            "id": "710370902",
            "speakerId": 2616,
            "speakerName": "瑾武",
            "text": "不过在这之前，我还要等上面的运输队把我的工具都带下来，这段时间请你们自由探索吧。"

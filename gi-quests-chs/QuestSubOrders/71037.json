    {
      "subId": "7103715",
      "subQuestName": "返回勘探队营地",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "710371501"
        ],
        "dialogs": {
          "710371501": {
            "id": "710371501",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "唔，瑾武姐之前提到的应该就是这几处地方了，我们回去找她吧！"
          }
        }
      }
    },
    {
      "subId": "7103716",
      "subQuestName": "与志琼交谈",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "710371101"
        ],
        "dialogs": {
          "710371101": {
            "id": "710371101",
            "speakerId": 20006,
            "speakerName": "志琼",
            "text": "多谢前辈的帮助，请收下这个。",
            "nextDialogs": [
              "710371102"
            ]
          },
          "710371102": {
            "id": "710371102",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "谢谢。",
            "nextDialogs": [
              "710371103"
            ]
          },
          "710371103": {
            "id": "710371103",
            "speakerId": 20006,
            "speakerName": "志琼",
            "text": "哈哈，前辈不用这么客气啦，反正是海迪夫出钱…嘘，小声点，别被那个须弥小气鬼听见啦。",
            "nextDialogs": [
              "710371104"
            ]
          },
          "710371104": {
            "id": "710371104",
            "speakerId": 20006,
            "speakerName": "志琼",
            "text": "咳咳…抱歉，我们去找瑾武姐吧？之前一路上的许多疑问，或许可以借助她的经验解答呢。",
            "nextDialogs": [
              "710371105"
            ]
          },
          "710371105": {
            "id": "710371105",
            "speakerId": 20006,
            "speakerName": "志琼",
            "text": "就像前辈在雪山那样…瑾武姐虽然不太愿意提起，但她年轻时也是矿上的传奇人物呢…咳咳…",
            "nextDialogs": [
              "710371106"
            ]
          },
          "710371106": {
            "id": "710371106",
            "speakerId": 20006,
            "speakerName": "志琼",
            "text": "听说她为千岩军的搜救队引路，从险境救出了许多矿工…哈哈，不过那些旧事我就不提啦，免得她生气。",
            "nextDialogs": [
              "710371107"
            ]
          },
          "710371107": {
            "id": "710371107",
            "speakerId": 20006,
            "speakerName": "志琼",
            "text": "好了，我就不啰嗦强留你啦。"
          }
        }
      }
    },

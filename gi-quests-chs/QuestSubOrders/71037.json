      }
    },
    {
      "subId": "7103705",
      "subQuestName": "寻找关于老何的线索$HIDDEN",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "710370501"
        ],
        "dialogs": {
          "710370501": {
            "id": "710370501",
            "speakerId": 20006,
            "speakerName": "志琼",
            "text": "#啊，是{NICKNAME}前辈，你们来了！",
            "nextDialogs": [
              "710370503",
              "710370511"
            ]
          },
          "710370503": {
            "id": "710370503",
            "speakerId": 20006,
            "speakerName": "志琼",
            "text": "又是那套安全叮嘱吧？唉…我听都听烦啦。",
            "nextDialogs": [
              "710370504"
            ]
          },
          "710370504": {
            "id": "710370504",
            "speakerId": 20006,
            "speakerName": "志琼",
            "text": "我从小也是在矿上长大的，矿坑里的危险哪有不知道的？",
            "nextDialogs": [
              "710370505"
            ]
          },
          "710370505": {
            "id": "710370505",
            "speakerId": 20006,
            "speakerName": "志琼",
            "text": "至于那些未知的事物，长辈们总是喜欢借经验来判断是否危险…然后反过来用结果来证明自己的经验。",
            "nextDialogs": [
              "710370506"
            ]
          },
          "710370506": {
            "id": "710370506",
            "speakerId": 20006,
            "speakerName": "志琼",
            "text": "我是受够他们这种自大了…我相信身为冒险家的前辈你，也是一样吧？",
            "nextDialogs": [
              "710370507"
            ]
          },
          "710370507": {
            "id": "710370507",
            "speakerId": 20006,
            "speakerName": "志琼",
            "text": "如果霞姐一味警告你雪山的危险，而前辈就听信了，就这样裹足不前的话，那得错过多少精彩的冒险呀！",
            "nextDialogs": [
              "710370508"
            ]
          },
          "710370508": {
            "id": "710370508",
            "speakerId": 20006,
            "speakerName": "志琼",
            "text": "好啦——不要再劝我了，我不想和前辈为这种小事吵起来…唔，我们换个话题吧？",
            "nextDialogs": [
              "710370509"
            ]
          },
          "710370509": {
            "id": "710370509",
            "speakerId": 20006,
            "speakerName": "志琼",
            "text": "前辈你看，我现在正在勘探这里的地形，以便绘制地图…",
            "nextDialogs": [
              "710370512"
            ]
          },
          "710370512": {
            "id": "710370512",
            "speakerId": 20006,
            "speakerName": "志琼",
            "text": "只不过…之前在探索矿洞的时候，前路被几处奇怪的异变点阻挡了…",
            "nextDialogs": [
              "710370513"
            ]
          },
          "710370513": {
            "id": "710370513",
            "speakerId": 20006,
            "speakerName": "志琼",
            "text": "如果能够取样或者拍下照的话，总务司与冒险家协会应该都会很高兴的。",
            "nextDialogs": [
              "710370514"
            ]
          },
          "710370514": {
            "id": "710370514",
            "speakerId": 20006,
            "speakerName": "志琼",
            "text": "说来丢人…下矿时我的留影机不小心摔坏了，所以只能仰赖前辈高超的摄影技巧啦。",
            "nextDialogs": [
              "710370515"
            ]
          },
          "710370515": {
            "id": "710370515",
            "speakerId": 20006,
            "speakerName": "志琼",
            "text": "还有另一些地点…嗯，这里和这里，有盗宝团的踪迹…",
            "nextDialogs": [
              "710370516"
            ]
          },
          "710370516": {
            "id": "710370516",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "什么呀…完全看不出哪里是哪里！",
            "nextDialogs": [
              "710370517"
            ]
          },
          "710370517": {
            "id": "710370517",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "只是几个叉号和几条线呢…",
            "nextDialogs": [
              "710370518"
            ]
          },
          "710370518": {
            "id": "710370518",
            "speakerId": 20006,
            "speakerName": "志琼",
            "text": "哈哈，抱歉抱歉…只是自己习惯，就忘记不是人人都有制图师的直觉了。",
            "nextDialogs": [
              "710370519"
            ]
          },
          "710370519": {
            "id": "710370519",
            "speakerId": 20006,
            "speakerName": "志琼",
            "text": "不过没关系，我会随前辈一起去，给你们指路的。",
            "nextDialogs": [
              "710370520"
            ]
          },
          "710370520": {
            "id": "710370520",
            "speakerId": 20006,
            "speakerName": "志琼",
            "text": "这几处地点，我们先去解决哪里都可以的。"
          },
          "710370511": {
            "id": "710370511",
            "speakerId": 20006,
            "speakerName": "志琼",
            "text": "嗯…我刚刚说了呀，我在勘探地形，绘制地图。"
          }
        }
      }
    },
    {
      "subId": "7103706",
      "subQuestName": "寻找关于老何的线索",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "710371001"
        ],
        "dialogs": {
          "710371001": {
            "id": "710371001",
            "speakerId": 20539,
            "speakerName": "日志的残片",
            "text": "「…光线暗下来了…我的晶石灯还能用大概四个小时…」",
            "nextDialogs": [
              "710371002"
            ]
          },
          "710371002": {
            "id": "710371002",
            "speakerId": 20539,
            "speakerName": "日志的残片",
            "text": "「…食物不多了，凭借记忆还能找到滤水器的所在，但必须尽快找到新的光源才行…」",
            "nextDialogs": [
              "710371003"
            ]
          },
          "710371003": {
            "id": "710371003",
            "speakerId": 20539,
            "speakerName": "日志的残片",
            "text": "「…看到荧光在飘动，或者，在走动？可能是缺氧导致的幻觉…」"
          }
        }
      }
    },
    {
      "subId": "7103707",
      "subQuestName": "寻找关于老何的线索",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "710371201"
        ],
        "dialogs": {
          "710371201": {
            "id": "710371201",
            "speakerId": 20539,
            "speakerName": "日志的残片",
            "text": "「…从地下深处渗上来了奇怪的黑色熔岩，也许不是熔岩。总之看起来很不妙，没有敢靠近…」",
            "nextDialogs": [
              "710371202"
            ]
          },
          "710371202": {
            "id": "710371202",
            "speakerId": 20539,
            "speakerName": "日志的残片",
            "text": "「…去了更深处探索，带回了一些奇怪的蘑菇…无法确定能否食用…」",
            "nextDialogs": [
              "710371203"
            ]
          },
          "710371203": {
            "id": "710371203",
            "speakerId": 20539,
            "speakerName": "日志的残片",
            "text": "「…『熔岩』吸引了一些元素生物…如果它们能吃的话，或许我也能…」",
            "nextDialogs": [
              "710371204"
            ]
          },
          "710371204": {
            "id": "710371204",
            "speakerId": 20539,
            "speakerName": "日志的残片",
            "text": "「…不对，不太妙。那些小东西变得不太对劲了，尽快离开这里，这东西显然不能当成食物…」",
            "nextDialogs": [
              "710371205"
            ]
          },
          "710371205": {
            "id": "710371205",
            "speakerId": 20539,
            "speakerName": "日志的残片",
            "text": "「…如果习惯的话，蘑菇的味道还不错…继续往生着蘑菇的地方前进，接下来就去那边扎营好了…」"
          }
        }
      }
    },
    {
      "subId": "7103708",
      "subQuestName": "寻找关于老何的线索",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "710371401"
        ],
        "dialogs": {
          "710371401": {
            "id": "710371401",
            "speakerId": 20539,
            "speakerName": "日志的残片",
            "text": "「…一靠近黑色『熔岩』，就会思维紊乱、五感敏感，情绪易怒。但来到这块晶石附近就能缓解不少…」",
            "nextDialogs": [
              "710371402"
            ]
          },
          "710371402": {
            "id": "710371402",
            "speakerId": 20539,
            "speakerName": "日志的残片",
            "text": "「…听说瑾武小妹她们那边的什么『触媒』可以从这些晶石里汲取能量，等出去上到地面，一定要找她好好问问…」",
            "nextDialogs": [
              "710371403"
            ]
          },
          "710371403": {
            "id": "710371403",
            "speakerId": 20539,
            "speakerName": "日志的残片",
            "text": "「…耳朵仍然痒，听到有人叫我，她说深处有水，有蘑菇…」",
            "nextDialogs": [
              "710371404"
            ]
          },
          "710371404": {
            "id": "710371404",
            "speakerId": 20539,
            "speakerName": "日志的残片",
            "text": "「…妈呀，可能我要疯掉了…」"
          }
        }
      }
    },

        "dialogs": {
          "706570101": {
            "id": "706570101",
            "speakerId": 30046,
            "speakerName": "莉兹",
            "text": "你好，我是西风骑士团的莉兹。相信你也听说了吧，风花节期间，蒙德会有各种各样的好玩活动！",
            "nextDialogs": [
              "706570104"
            ]
          },
          "706570104": {
            "id": "706570104",
            "speakerId": 30046,
            "speakerName": "莉兹",
            "text": "我的工作，就是接待来到蒙德的客人，让每个人都能充分享受这个节日的乐趣！",
            "nextDialogs": [
              "706570105"
            ]
          },
          "706570105": {
            "id": "706570105",
            "speakerId": 30046,
            "speakerName": "莉兹",
            "text": "因为举办活动的地方不一定在城内，如果没人来介绍，有很多精彩游戏就会被错过了。",
            "nextDialogs": [
              "706570106"
            ]
          },
          "706570106": {
            "id": "706570106",
            "speakerId": 30046,
            "speakerName": "莉兹",
            "text": "现在要隆重向你推荐的就是这个——「百发百中」！",
            "nextDialogs": [
              "706570107"
            ]
          },
          "706570107": {
            "id": "706570107",
            "speakerId": 30046,
            "speakerName": "莉兹",
            "text": "顾名思义，就是射击天上的目标，如果又快又准，就可以获得高分！"
          }
        }
      }
    }
  ]

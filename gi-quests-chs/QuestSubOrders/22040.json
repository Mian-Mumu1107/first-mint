              "220400502"
            ]
          },
          "220400502": {
            "id": "220400502",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "打听到了。",
            "nextDialogs": [
              "220400503"
            ]
          },
          "220400503": {
            "id": "220400503",
            "speakerId": 1000,
            "speakerName": "小仓澪",
            "text": "那太好了，大家是怎么说的呢？",
            "nextDialogs": [
              "220400504"
            ]
          },
          "220400504": {
            "id": "220400504",
            "speakerId": 1000,
            "speakerName": "小仓澪",
            "text": "书本和…茶具？听起来倒是有趣。",
            "nextDialogs": [
              "220400505"
            ]
          },
          "220400505": {
            "id": "220400505",
            "speakerId": 1000,
            "speakerName": "小仓澪",
            "text": "但是，具体要怎么做呢？我得再好好琢磨琢磨…",
            "nextDialogs": [
              "220400506"
            ]
          },
          "220400506": {
            "id": "220400506",
            "speakerId": 1000,
            "speakerName": "小仓澪",
            "text": "这些信息对我来说都非常有用，实在感谢，这些报酬还请你不要推辞。"
          }
        }
      }
    },

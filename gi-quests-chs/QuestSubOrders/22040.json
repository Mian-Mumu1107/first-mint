            ]
          },
          "220400402": {
            "id": "220400402",
            "speakerId": 1002,
            "speakerName": "拉姆齐",
            "text": "着物上的纹样？哈哈，我可不太了解这方面的事。",
            "nextDialogs": [
              "220400403"
            ]
          },
          "220400403": {
            "id": "220400403",
            "speakerId": 1002,
            "speakerName": "拉姆齐",
            "text": "不过，要我说的话，如果能把「茶具」作为纹样的话，也许会非常有趣。",
            "nextDialogs": [
              "220400404"
            ]
          },
          "220400404": {
            "id": "220400404",
            "speakerId": 1002,
            "speakerName": "拉姆齐",
            "text": "印着茶具纹样的着物…哈哈哈，感觉还挺有稻妻感的。"
          }
        }
      }
    },
    {
      "subId": "2204004",

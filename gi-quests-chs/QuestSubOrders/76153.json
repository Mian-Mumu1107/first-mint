  "subQuests": [
    {
      "subId": "7615301",
      "subQuestName": "与萨维特对话",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "761530101"
        ],
        "dialogs": {
          "761530101": {
            "id": "761530101",
            "speakerId": 7008,
            "speakerName": "萨维特",
            "text": "出版业也不挣钱哪，要不干脆只做投资算了…",
            "nextDialogs": [
              "761530102"
            ]
          },
          "761530102": {
            "id": "761530102",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "想看看投资券…",
            "nextDialogs": [
              "761530103"
            ]
          },
          "761530103": {
            "id": "761530103",
            "speakerId": 7008,
            "speakerName": "萨维特",
            "text": "好嘞，投资券2000摩拉一张，每周结算一次，嘿嘿，这小袋子里…",
            "nextDialogs": [
              "761530104"
            ]
          },
          "761530104": {
            "id": "761530104",
            "speakerId": 7008,
            "speakerName": "萨维特",
            "text": "…呃！",
            "nextDialogs": [
              "761530105"
            ]
          },
          "761530105": {
            "id": "761530105",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "怎么了？",
            "nextDialogs": [
              "761530106"
            ]
          },
          "761530106": {
            "id": "761530106",
            "speakerId": 7008,
            "speakerName": "萨维特",
            "text": "雅珂达，你怎么来了，是奈芙尔老板有什么…",
            "nextDialogs": [
              "761530107"
            ]
          },
          "761530107": {
            "id": "761530107",
            "speakerId": 1317,
            "speakerName": "雅珂达",
            "text": "没有，我就是陪着我的朋友来这里随便逛逛。",
            "nextDialogs": [
              "761530108"
            ]
          },
          "761530108": {
            "id": "761530108",
            "speakerId": 1317,
            "speakerName": "雅珂达",
            "text": "嘿嘿，看来萨维特老板的投资生意确实做得很好啊。",
            "nextDialogs": [
              "761530109"
            ]
          },
          "761530109": {
            "id": "761530109",
            "speakerId": 7008,
            "speakerName": "萨维特",
            "text": "一般！一般，哈哈哈…小本生意，糊口罢了。",
            "nextDialogs": [
              "761530110"
            ]
          },
          "761530110": {
            "id": "761530110",
            "speakerId": 7008,
            "speakerName": "萨维特",
            "text": "（这丫头…话里有话！肯定是奈芙尔派她过来的…嘁。）",
            "nextDialogs": [
              "761530111"
            ]
          },
          "761530111": {
            "id": "761530111",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "这真的能赚钱吗？",
            "nextDialogs": [
              "761530112"
            ]
          },
          "761530112": {
            "id": "761530112",
            "speakerId": 1317,
            "speakerName": "雅珂达",
            "text": "当然啦，老板说了，萨维特老板可是最最有声望，最最有能力的商人。跟着他投资，准没错。",
            "nextDialogs": [
              "761530113"
            ]
          },
          "761530113": {
            "id": "761530113",
            "speakerId": 7008,
            "speakerName": "萨维特",
            "text": "是…是…哈哈哈…",
            "nextDialogs": [
              "761530114"
            ]
          },
          "761530114": {
            "id": "761530114",
            "speakerId": 7008,
            "speakerName": "萨维特",
            "text": "（果然是奈芙尔…！）",
            "nextDialogs": [
              "761530115"
            ]
          },
          "761530115": {
            "id": "761530115",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "那什么时候能结算投资…",
            "nextDialogs": [
              "761530116"
            ]
          },
          "761530116": {
            "id": "761530116",
            "speakerId": 7008,
            "speakerName": "萨维特",
            "text": "今天！就在今天，您刚才买的是我们刚刚推出的…短线投资券！盈亏立即结算！",
            "nextDialogs": [
              "761530117"
            ]
          },
          "761530117": {
            "id": "761530117",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "怎么感觉这些话都是你刚刚才编出来的…",
            "nextDialogs": [
              "761530118"
            ]
          },
          "761530118": {
            "id": "761530118",
            "speakerId": 7008,
            "speakerName": "萨维特",
            "text": "呃…总、总之，感谢您购买短线投资券！",
            "nextDialogs": [
              "761530119"
            ]
          },
          "761530119": {
            "id": "761530119",
            "speakerId": 7008,
            "speakerName": "萨维特",
            "text": "这是您的投资回报，祝您拥有美好的一天！",
            "nextDialogs": [
              "761530122"
            ]
          },
          "761530122": {
            "id": "761530122",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "真的？嘿嘿嘿，那你给我买一个小鸟形状的，我就喜欢那样的！",
            "nextDialogs": [
              "761530123"
            ]
          },
          "761530123": {
            "id": "761530123",
            "speakerId": 1317,
            "speakerName": "雅珂达",
            "text": "欸，我和你们一起去，给老板也带一个回去。",
            "nextDialogs": [
              "761530124"
            ]
          },
          "761530124": {
            "id": "761530124",
            "speakerId": 7008,
            "speakerName": "萨维特",
            "text": "雅…雅珂达小姐，稍等！",
            "nextDialogs": [
              "761530125"
            ]
          },
          "761530125": {
            "id": "761530125",
            "speakerId": 7008,
            "speakerName": "萨维特",
            "text": "…那个，奈芙尔老板是否交代您了什么…",
            "nextDialogs": [
              "761530126"
            ]
          },
          "761530126": {
            "id": "761530126",
            "speakerId": 1317,
            "speakerName": "雅珂达",
            "text": "啊。老板说：「东西已经找到了。」",
            "nextDialogs": [
              "761530127"
            ]
          },
          "761530127": {
            "id": "761530127",
            "speakerId": 1317,
            "speakerName": "雅珂达",
            "text": "「萨维特先生，不要心急。事情，要一步一步地做才稳当。」",
            "nextDialogs": [
              "761530128"
            ]
          },
          "761530128": {
            "id": "761530128",
            "speakerId": 7008,
            "speakerName": "萨维特",
            "text": "是、是，奈芙尔老板说的是…那就麻烦了，我就指望二位了…"
          }
        }
      }
    },

  },
  "subQuests": [
    {
      "subId": "401901",
      "subQuestName": "返回监狱了解众人的情况",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "40190101"
        ],
        "dialogs": {
          "40190101": {
            "id": "40190101",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "护士长！",
            "nextDialogs": [
              "40190102"
            ]
          },
          "40190102": {
            "id": "40190102",
            "speakerId": 1001,
            "speakerName": "希格雯",
            "text": "#{NICKNAME}，派蒙，你们回来了！",
            "nextDialogs": [
              "40190103"
            ]
          },
          "40190103": {
            "id": "40190103",
            "speakerId": 1001,
            "speakerName": "希格雯",
            "text": "还好吗？没有伤到哪里吧？",
            "nextDialogs": [
              "40190104"
            ]
          },
          "40190104": {
            "id": "40190104",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "请放心，我们很好。",
            "nextDialogs": [
              "40190105"
            ]
          },
          "40190105": {
            "id": "40190105",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "没事哦！你们呢？发生那么大的事，乱成一团，没出太大问题吧？",
            "nextDialogs": [
              "40190106"
            ]
          },
          "40190106": {
            "id": "40190106",
            "speakerId": 1001,
            "speakerName": "希格雯",
            "text": "少数人受了点外伤，整体还好。那维莱特先生过来了一趟，多亏他我们才能暂时压制住危机。",
            "nextDialogs": [
              "40190107"
            ]
          },
          "40190107": {
            "id": "40190107",
            "speakerId": 1001,
            "speakerName": "希格雯",
            "text": "也要谢谢你们帮的忙。",
            "nextDialogs": [
              "40190108"
            ]
          },
          "40190108": {
            "id": "40190108",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "那维莱特怎么知道这里需要他？",
            "nextDialogs": [
              "40190109"
            ]
          },
          "40190109": {
            "id": "40190109",
            "speakerId": 1001,
            "speakerName": "希格雯",
            "text": "那维莱特先生与水元素的呼应很强，涨水时海洋产生了巨大的波动，他能感受到。",
            "nextDialogs": [
              "40190110"
            ]
          },
          "40190110": {
            "id": "40190110",
            "speakerId": 1001,
            "speakerName": "希格雯",
            "text": "我给犯人包扎时还遇到那对炸弹兄弟念叨你们俩头也不回的跑去楼下了呢，看见你们没事我才能放心。",
            "nextDialogs": [
              "40190111"
            ]
          },
          "40190111": {
            "id": "40190111",
            "speakerId": 1001,
            "speakerName": "希格雯",
            "text": "不赶时间的话，请在这里多留几天。",
            "nextDialogs": [
              "40190112"
            ]
          },
          "40190112": {
            "id": "40190112",
            "speakerId": 1001,
            "speakerName": "希格雯",
            "text": "有什么想吃的随时跟我说，我让韦尔塞先生去安排，累了也可以到医务室休息一会儿。",
            "nextDialogs": [
              "40190113"
            ]
          },
          "40190113": {
            "id": "40190113",
            "speakerId": 1001,
            "speakerName": "希格雯",
            "text": "我刚好也想多观察观察你们的面部肌肉。你们开心的笑容非常有感染力，很不错哟，让我念念不忘。"
          }
        }
      }
    },
    {
      "subId": "401902",
      "subQuestName": "返回监狱了解众人的情况",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "40190201"
        ],
        "dialogs": {
          "40190201": {
            "id": "40190201",
            "speakerId": 1002,
            "speakerName": "林尼",
            "text": "猜猜下一张是什么花色？",
            "nextDialogs": [
              "40190202"
            ]
          },
          "40190202": {
            "id": "40190202",
            "speakerId": 1003,
            "speakerName": "菲米尼",
            "text": "唔…呲牙咧嘴猫？",
            "nextDialogs": [
              "40190203"
            ]
          },
          "40190203": {
            "id": "40190203",
            "speakerId": 1004,
            "speakerName": "琳妮特",
            "text": "啊，是你们。",
            "nextDialogs": [
              "40190204"
            ]
          },
          "40190204": {
            "id": "40190204",
            "speakerId": 1002,
            "speakerName": "林尼",
            "text": "#{NICKNAME}，派蒙！",
            "nextDialogs": [
              "40190205"
            ]
          },
          "40190205": {
            "id": "40190205",
            "speakerId": 1003,
            "speakerName": "菲米尼",
            "text": "你们好。",
            "nextDialogs": [
              "40190206"
            ]
          },
          "40190206": {
            "id": "40190206",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "菲米尼看起来恢复得差不多了呢。",
            "nextDialogs": [
              "40190207"
            ]
          },
          "40190207": {
            "id": "40190207",
            "speakerId": 1003,
            "speakerName": "菲米尼",
            "text": "嗯，托大家的福。",
            "nextDialogs": [
              "40190208"
            ]
          },
          "40190208": {
            "id": "40190208",
            "speakerId": 1003,
            "speakerName": "菲米尼",
            "text": "对了！我…我鼓足勇气跟克洛琳德小姐道过谢了！",
            "nextDialogs": [
              "40190209"
            ]
          },
          "40190209": {
            "id": "40190209",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "哇，她什么反应？",
            "nextDialogs": [
              "40190210"
            ]
          },
          "40190210": {
            "id": "40190210",
            "speakerId": 1003,
            "speakerName": "菲米尼",
            "text": "她说没关系…她好像完全不觉得救人是件大事，还让我别放在心上。",
            "nextDialogs": [
              "40190211"
            ]
          },
          "40190211": {
            "id": "40190211",
            "speakerId": 1004,
            "speakerName": "琳妮特",
            "text": "是不想给你压力。确实别太在意比较好哦。",
            "nextDialogs": [
              "40190212"
            ]
          },
          "40190212": {
            "id": "40190212",
            "speakerId": 1003,
            "speakerName": "菲米尼",
            "text": "嗯…",
            "nextDialogs": [
              "40190213"
            ]
          },
          "40190213": {
            "id": "40190213",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "听我说！我们回了一趟歌剧院，在那里遇到了「仆人」哦！",
            "nextDialogs": [
              "40190214"
            ]
          },
          "40190214": {
            "id": "40190214",
            "speakerId": 1002,
            "speakerName": "林尼",
            "text": "「父亲」？她有对你们说什么吗？",
            "nextDialogs": [
              "40190215"
            ]
          },
          "40190215": {
            "id": "40190215",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "说了一些比较玄的话，还说期待未来某日跟我们合作呢。",
            "nextDialogs": [
              "40190216"
            ]
          },
          "40190216": {
            "id": "40190216",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "有点意外。",
            "nextDialogs": [
              "40190217"
            ]
          },
          "40190217": {
            "id": "40190217",
            "speakerId": 1002,
            "speakerName": "林尼",
            "text": "「父亲」对你们的态度比我们想的还要好一些…太好了。",
            "nextDialogs": [
              "40190218"
            ]
          },
          "40190218": {
            "id": "40190218",
            "speakerId": 1002,
            "speakerName": "林尼",
            "text": "#{NICKNAME}，你得相信「父亲」，她有她的职责，必要时她会联合一切可动用的力量，其中也包含你。",
            "nextDialogs": [
              "40190219"
            ]
          },
          "40190219": {
            "id": "40190219",
            "speakerId": 1004,
            "speakerName": "琳妮特",
            "text": "嗯，「父亲」非常优秀，值得信赖。",
            "nextDialogs": [
              "40190220"
            ]
          },
          "40190220": {
            "id": "40190220",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "噢，说到这个，她还说林尼太要强了，偶尔也要学着依赖别人哦。",
            "nextDialogs": [
              "40190221"
            ]
          },
          "40190221": {
            "id": "40190221",
            "speakerId": 1002,
            "speakerName": "林尼",
            "text": "呃…我知道了。",
            "nextDialogs": [
              "40190222"
            ]
          },
          "40190222": {
            "id": "40190222",
            "speakerId": 1003,
            "speakerName": "菲米尼",
            "text": "果然是「父亲」会说的话呢…",
            "nextDialogs": [
              "40190223"
            ]
          },
          "40190223": {
            "id": "40190223",
            "speakerId": 1002,
            "speakerName": "林尼",
            "text": "喂！",
            "nextDialogs": [
              "40190224"
            ]
          },
          "40190224": {
            "id": "40190224",
            "speakerId": 1004,
            "speakerName": "琳妮特",
            "text": "你们会暂时留在这里吗？",
            "nextDialogs": [
              "40190225"
            ]
          },
          "40190225": {
            "id": "40190225",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "应该是吧。",
            "nextDialogs": [
              "40190226"
            ]
          },
          "40190226": {
            "id": "40190226",
            "speakerId": 1004,
            "speakerName": "琳妮特",
            "text": "好，我们可以开茶会。",
            "nextDialogs": [
              "40190227"
            ]
          },
          "40190227": {
            "id": "40190227",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "真的？那我还想吃蛋糕！",
            "nextDialogs": [
              "40190228"
            ]
          },
          "40190228": {
            "id": "40190228",
            "speakerId": 1004,
            "speakerName": "琳妮特",
            "text": "「还」的意思是，你们在上面吃了好吃的蛋糕。嗯，真好呢。",
            "nextDialogs": [
              "40190229"
            ]
          },
          "40190229": {
            "id": "40190229",
            "speakerId": 1004,
            "speakerName": "琳妮特",
            "text": "下次也跟我们一起喝茶吃点心吧。"
          }
        }
      }
    },
    {
      "subId": "401904",
      "subQuestName": "返回监狱了解众人的情况",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "40190401"
        ],
        "dialogs": {
          "40190401": {
            "id": "40190401",
            "speakerId": 1005,
            "speakerName": "库斯图",
            "text": "咦？你们…你们怎么回来了？",
            "nextDialogs": [
              "40190402"
            ]
          },
          "40190402": {
            "id": "40190402",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "库斯图！拉韦兰！",
            "nextDialogs": [
              "40190403"
            ]
          },
          "40190403": {
            "id": "40190403",
            "speakerId": 1006,
            "speakerName": "拉韦兰",
            "text": "喂，你们不是被抓回来的吧？",
            "nextDialogs": [
              "40190404"
            ]
          },
          "40190404": {
            "id": "40190404",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "欸？没有啊？",
            "nextDialogs": [
              "40190405"
            ]
          },
          "40190405": {
            "id": "40190405",
            "speakerId": 1005,
            "speakerName": "库斯图",
            "text": "该死！还以为你们趁着上次的骚动逃出去了呢，我以为你们是难得的成功逃狱者，没想到你们…你们根本就没走？",
            "nextDialogs": [
              "40190406"
            ]
          },
          "40190406": {
            "id": "40190406",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "啊哈哈…不好意思，我们只是有点事…",
            "nextDialogs": [
              "40190407"
            ]
          },
          "40190407": {
            "id": "40190407",
            "speakerId": 1006,
            "speakerName": "拉韦兰",
            "text": "好了好了，别纠结这些。没事就好，这家伙一度很担心你们。",
            "nextDialogs": [
              "40190408"
            ]
          },
          "40190408": {
            "id": "40190408",
            "speakerId": 1005,
            "speakerName": "库斯图",
            "text": "别光说我！你不也是吗？",
            "nextDialogs": [
              "40190409"
            ]
          },
          "40190409": {
            "id": "40190409",
            "speakerId": 1006,
            "speakerName": "拉韦兰",
            "text": "嗯，我也是。",
            "nextDialogs": [
              "40190410"
            ]
          },
          "40190410": {
            "id": "40190410",
            "speakerId": 1006,
            "speakerName": "拉韦兰",
            "text": "这几天我也被调去厨房帮佣了，刚才干活的时候库斯图还对着胡萝卜喃喃自语：「那两个家伙没事吧？还活着吗？」",
            "nextDialogs": [
              "40190411"
            ]
          },
          "40190411": {
            "id": "40190411",
            "speakerId": 1006,
            "speakerName": "拉韦兰",
            "text": "这种时候我就说：「没事的，一定已经在哪里喝着饮料看风景了。」",
            "nextDialogs": [
              "40190412"
            ]
          },
          "40190412": {
            "id": "40190412",
            "speakerId": 1005,
            "speakerName": "库斯图",
            "text": "#哎！关心一下狱友很正常吧？{M#他们}{F#她们}都这么爱听我讲八卦了…",
            "nextDialogs": [
              "40190413"
            ]
          },
          "40190413": {
            "id": "40190413",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "这两个家伙…比想的更热心更有人情味呢…",
            "nextDialogs": [
              "40190416"
            ]
          },
          "40190416": {
            "id": "40190416",
            "speakerId": 1005,
            "speakerName": "库斯图",
            "text": "…嘿，你这家伙。记得多吃点！"
          }
        }
      }
    },
    {
      "subId": "401905",
      "subQuestName": "返回监狱了解众人的情况",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "40190501"
        ],
        "dialogs": {
          "40190501": {
            "id": "40190501",
            "speakerId": 1007,
            "speakerName": "露尔薇",
            "text": "朱里厄！护士长说你没吃午饭？",
            "nextDialogs": [
              "40190502"
            ]
          },
          "40190502": {
            "id": "40190502",
            "speakerId": 1008,
            "speakerName": "朱里厄",
            "text": "我在忙工作，忘了。",
            "nextDialogs": [
              "40190503"
            ]
          },
          "40190503": {
            "id": "40190503",
            "speakerId": 1007,
            "speakerName": "露尔薇",
            "text": "那也不能…咦？是你们二位！",
            "nextDialogs": [
              "40190504"
            ]
          },
          "40190504": {
            "id": "40190504",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "朱里厄，露尔薇，你们好呀！",
            "nextDialogs": [
              "40190505"
            ]
          },
          "40190505": {
            "id": "40190505",
            "speakerId": 1008,
            "speakerName": "朱里厄",
            "text": "你们好啊，最近这里挺乱的，你们还好吧？",
            "nextDialogs": [
              "40190506"
            ]
          },
          "40190506": {
            "id": "40190506",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "谢谢，我们没事。",
            "nextDialogs": [
              "40190507"
            ]
          },
          "40190507": {
            "id": "40190507",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "你们呢？还一直走医务室的密道来这里研究那艘大船吗？",
            "nextDialogs": [
              "40190508"
            ]
          },
          "40190508": {
            "id": "40190508",
            "speakerId": 1007,
            "speakerName": "露尔薇",
            "text": "是啊，这个秘密只有我们几个知道，你们可千万不能说出去哦。",
            "nextDialogs": [
              "40190509"
            ]
          },
          "40190509": {
            "id": "40190509",
            "speakerId": 1008,
            "speakerName": "朱里厄",
            "text": "医务室人多的时候非常麻烦，不过走那条路怎么说都比从公爵办公室过来好。",
            "nextDialogs": [
              "40190510"
            ]
          },
          "40190510": {
            "id": "40190510",
            "speakerId": 1007,
            "speakerName": "露尔薇",
            "text": "你经常趁机去医务室偷懒也是事实啦。",
            "nextDialogs": [
              "40190511"
            ]
          },
          "40190511": {
            "id": "40190511",
            "speakerId": 1008,
            "speakerName": "朱里厄",
            "text": "为什么你也经常在？",
            "nextDialogs": [
              "40190512"
            ]
          },
          "40190512": {
            "id": "40190512",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "你们两个确实有借着造船谈恋爱吧…",
            "nextDialogs": [
              "40190513"
            ]
          },
          "40190513": {
            "id": "40190513",
            "speakerId": 1009,
            "speakerName": "二人一起",
            "text": "才没有！"
          }
        }
      }
    },
    {
      "subId": "401903",
      "subQuestName": "与莱欧斯利对话",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "40190301"
        ],
        "dialogs": {
          "40190301": {
            "id": "40190301",
            "speakerId": 1010,
            "speakerName": "莱欧斯利",
            "text": "出狱的犯人居然又回来了？吹的什么风啊。",
            "nextDialogs": [
              "40190302"
            ]
          },
          "40190302": {
            "id": "40190302",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "来看看梅洛彼得堡的情况嘛！应该还好吧？",
            "nextDialogs": [
              "40190303"
            ]
          },
          "40190303": {
            "id": "40190303",
            "speakerId": 1010,
            "speakerName": "莱欧斯利",
            "text": "问题不大，那维莱特过来摆平了一些棘手问题。",
            "nextDialogs": [
              "40190304"
            ]
          },
          "40190304": {
            "id": "40190304",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "既然这样，你们直接请他留在这里不就好了吗？",
            "nextDialogs": [
              "40190305"
            ]
          },
          "40190305": {
            "id": "40190305",
            "speakerId": 1010,
            "speakerName": "莱欧斯利",
            "text": "噢，好办法。我们可以一起说服最高审判官为了一片水抛弃整个法庭。",
            "nextDialogs": [
              "40190306"
            ]
          },
          "40190306": {
            "id": "40190306",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "行不通吧…",
            "nextDialogs": [
              "40190307"
            ]
          },
          "40190307": {
            "id": "40190307",
            "speakerId": 1010,
            "speakerName": "莱欧斯利",
            "text": "他匆匆下来一趟，茶都不喝一口就回去了。不过带走了护士长给他的礼物。",
            "nextDialogs": [
              "40190308"
            ]
          },
          "40190308": {
            "id": "40190308",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "听起来是个大忙人呢。",
            "nextDialogs": [
              "40190309"
            ]
          },
          "40190309": {
            "id": "40190309",
            "speakerId": 1010,
            "speakerName": "莱欧斯利",
            "text": "克洛琳德小姐也回去了，同样带走了护士长的礼物。",
            "nextDialogs": [
              "40190310"
            ]
          },
          "40190310": {
            "id": "40190310",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "礼物是奶昔吗？",
            "nextDialogs": [
              "40190311"
            ]
          },
          "40190311": {
            "id": "40190311",
            "speakerId": 1010,
            "speakerName": "莱欧斯利",
            "text": "给那维莱特的是奶昔，给克洛琳德的是唇膏。",
            "nextDialogs": [
              "40190312"
            ]
          },
          "40190312": {
            "id": "40190312",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "欸？差好多啊！",
            "nextDialogs": [
              "40190313"
            ]
          },
          "40190313": {
            "id": "40190313",
            "speakerId": 1010,
            "speakerName": "莱欧斯利",
            "text": "谁让克洛琳德没有那维莱特那么忙，而且足够健康呢。护士长又喜欢给女士挑选美容用的礼物。",
            "nextDialogs": [
              "40190314"
            ]
          },
          "40190314": {
            "id": "40190314",
            "speakerId": 1010,
            "speakerName": "莱欧斯利",
            "text": "对了，也有给你们的礼物。",
            "nextDialogs": [
              "40190315"
            ]
          },
          "40190315": {
            "id": "40190315",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "护士长送的吗？",
            "nextDialogs": [
              "40190316"
            ]
          },
          "40190316": {
            "id": "40190316",
            "speakerId": 1010,
            "speakerName": "莱欧斯利",
            "text": "我送的。",
            "nextDialogs": [
              "40190317"
            ]
          },
          "40190317": {
            "id": "40190317",
            "speakerId": 1010,
            "speakerName": "莱欧斯利",
            "text": "你们在梅洛彼得堡的事已经办完，随时可以返回水上，只是刑期还没结束。期满之前，原先那间牢房可供你们随便使用。",
            "nextDialogs": [
              "40190318"
            ]
          },
          "40190318": {
            "id": "40190318",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "真的可以吗？那岂不是还能住好久！",
            "nextDialogs": [
              "40190319"
            ]
          },
          "40190319": {
            "id": "40190319",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "包伙食吗？",
            "nextDialogs": [
              "40190320"
            ]
          },
          "40190320": {
            "id": "40190320",
            "speakerId": 1010,
            "speakerName": "莱欧斯利",
            "text": "食堂将对你们免费开放。",
            "nextDialogs": [
              "40190321"
            ]
          },
          "40190321": {
            "id": "40190321",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "好欸！",
            "nextDialogs": [
              "40190322"
            ]
          },
          "40190322": {
            "id": "40190322",
            "speakerId": 1010,
            "speakerName": "莱欧斯利",
            "text": "记得刑满释放那天来我这里办手续。"
          }
        }
      }
    },
    {
      "subId": "401906",
      "subQuestName": "回到监舍区休息",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "40190601"
        ],
        "dialogs": {
          "40190601": {
            "id": "40190601",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "又回到这间牢房了，但我们现在已经不是囚犯啦，感觉有点不一样呢。",
            "nextDialogs": [
              "40190602"
            ]
          },
          "40190602": {
            "id": "40190602",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "有种扬眉吐气的感觉。",
            "nextDialogs": [
              "40190603"
            ]
          },
          "40190603": {
            "id": "40190603",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "没错，不过我们本来也没做什么坏事，随时都可以扬眉吐气啦。",
            "nextDialogs": [
              "40190604"
            ]
          },
          "40190604": {
            "id": "40190604",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "有种重获自由的感觉。",
            "nextDialogs": [
              "40190605"
            ]
          },
          "40190605": {
            "id": "40190605",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "嗯！自由的感觉好特别呀。",
            "nextDialogs": [
              "40190606"
            ]
          },
          "40190606": {
            "id": "40190606",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "派蒙有话要说吗？",
            "nextDialogs": [
              "40190607"
            ]
          },
          "40190607": {
            "id": "40190607",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "咦？你怎么知道？",
            "nextDialogs": [
              "40190608"
            ]
          },
          "40190608": {
            "id": "40190608",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "因为平时派蒙会直接睡着。",
            "nextDialogs": [
              "40190609"
            ]
          },
          "40190609": {
            "id": "40190609",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "我才不是那样呢！好啦…我是想说，其实，我们两个还挺厉害的哦。",
            "nextDialogs": [
              "40190610"
            ]
          },
          "40190610": {
            "id": "40190610",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "你看，我们一起经过了那么多地方，认识了那么多人。不断地旅行…不断地结识新的朋友。",
            "nextDialogs": [
              "40190611"
            ]
          },
          "40190611": {
            "id": "40190611",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "世界上有那么多麻烦，我们只是两个人，却一直在解决麻烦…不是很厉害吗？",
            "nextDialogs": [
              "40190612"
            ]
          },
          "40190612": {
            "id": "40190612",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "我们是最好的冒险家哦。",
            "nextDialogs": [
              "40190613"
            ]
          },
          "40190613": {
            "id": "40190613",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "我也算吗？只有你是冒险家吧。",
            "nextDialogs": [
              "40190614"
            ]
          },
          "40190614": {
            "id": "40190614",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "向导也算。",
            "nextDialogs": [
              "40190615"
            ]
          },
          "40190615": {
            "id": "40190615",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "那下次让凯瑟琳小姐给我也发个冒险家之证好啦！冒险家派蒙！",
            "nextDialogs": [
              "40190616"
            ]
          },
          "40190616": {
            "id": "40190616",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "想想就开心…我要睡啦，你也早点睡吧。",
            "nextDialogs": [
              "40190617"
            ]
          },
          "40190617": {
            "id": "40190617",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "上次睡在这里，一觉醒来外面都闹翻天了…胎海水也涨上来，好吓人…",
            "nextDialogs": [
              "40190618"
            ]
          },
          "40190618": {
            "id": "40190618",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "今天总不会了吧？",
            "nextDialogs": [
              "40190619"
            ]
          },
          "40190619": {
            "id": "40190619",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "不会的，放心睡吧。",
            "nextDialogs": [
              "40190620"
            ]
          },
          "40190620": {
            "id": "40190620",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "嗯，那先晚安啦。",
            "nextDialogs": [
              "40190621"
            ]
          },
          "40190621": {
            "id": "40190621",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "晚安派蒙。"
          }
        }
      }
    },
    {
      "subId": "401921",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "40192101"
        ],
        "dialogs": {
          "40192101": {
            "id": "40192101",
            "speakerId": 1001,
            "speakerName": "希格雯",
            "text": "有时间的话，欢迎你们在梅洛彼得堡多停留几天哦。"
          }
        }
      }
    },
    {
      "subId": "401922",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "40192201"
        ],
        "dialogs": {
          "40192201": {
            "id": "40192201",
            "speakerId": 1004,
            "speakerName": "琳妮特",
            "text": "下一次我们也准备茶会如何？",
            "nextDialogs": [
              "40192202"
            ]
          },
          "40192202": {
            "id": "40192202",
            "speakerId": 1002,
            "speakerName": "林尼",
            "text": "哦！不错，我支持。",
            "nextDialogs": [
              "40192203"
            ]
          },
          "40192203": {
            "id": "40192203",
            "speakerId": 1003,
            "speakerName": "菲米尼",
            "text": "我也来帮忙。"
          }
        }
      }
    },
    {
      "subId": "401923",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "40192301"
        ],
        "dialogs": {
          "40192301": {
            "id": "40192301",
            "speakerId": 1010,
            "speakerName": "莱欧斯利",
            "text": "不办手续你们的案底消不干净，所以别忘记刑满释放前来找我。"
          }
        }
      }
    },
    {
      "subId": "401924",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "40192401"
        ],
        "dialogs": {
          "40192401": {
            "id": "40192401",
            "speakerId": 1005,
            "speakerName": "库斯图",
            "text": "什么时候我们也跟那两个家伙一起吃顿饭好了。",
            "nextDialogs": [
              "40192402"
            ]
          },
          "40192402": {
            "id": "40192402",
            "speakerId": 1006,
            "speakerName": "拉韦兰",
            "text": "你要亲自下厨吗？",
            "nextDialogs": [
              "40192403"
            ]
          },
          "40192403": {
            "id": "40192403",
            "speakerId": 1005,
            "speakerName": "库斯图",
            "text": "可以啊，正好露一手。"
          }
        }
      }
    },
    {
      "subId": "401925",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "40192501"
        ],
        "dialogs": {
          "40192501": {
            "id": "40192501",
            "speakerId": 1007,
            "speakerName": "露尔薇",
            "text": "朱里厄，现在我们被传了这样的谣言，请你想办法处理这件事。",
            "nextDialogs": [
              "40192502"
            ]
          },
          "40192502": {
            "id": "40192502",
            "speakerId": 1008,
            "speakerName": "朱里厄",
            "text": "这可不是我一个人能造成的局面啊…好吧好吧，有空我会想想的。"
          }
        }
      }
    }
  ]

  },
  "subQuests": [
    {
      "subId": "7053801",
      "subQuestName": "(test)与商人对话$HIDDEN",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "705381401"
        ],
        "dialogs": {
          "705381401": {
            "id": "705381401",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "（身为荣誉骑士，不能坐视不理！）",
            "nextDialogs": [
              "705381402"
            ]
          },
          "705381402": {
            "id": "705381402",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "那…对不起了，热情的哲俩阿小姐！",
            "nextDialogs": [
              "705381403"
            ]
          },
          "705381403": {
            "id": "705381403",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "请你理解，毕竟你的无意中犯下的错，闯了很大的祸，事关蒙德的法律…我们只能出手了！",
            "nextDialogs": [
              "705381404"
            ]
          },
          "705381404": {
            "id": "705381404",
            "speakerId": 1001,
            "speakerName": "哲俩阿",
            "text": "欸？你们在说什么？",
            "nextDialogs": [
              "705381405"
            ]
          },
          "705381405": {
            "id": "705381405",
            "speakerId": 1001,
            "speakerName": "哲俩阿",
            "text": "等等！你们怎么在…摩拳擦掌？是要去打猎吗？",
            "nextDialogs": [
              "705381406"
            ]
          },
          "705381406": {
            "id": "705381406",
            "speakerId": 1001,
            "speakerName": "哲俩阿",
            "text": "不用的不用的，我这里的储备食材还很多…",
            "nextDialogs": [
              "705381407"
            ]
          },
          "705381407": {
            "id": "705381407",
            "speakerId": 1001,
            "speakerName": "哲俩阿",
            "text": "哇啊！"
          }
        }
      }
    },
    {
      "subId": "7053804",
      "subQuestName": "(test)没抓商人判定$HIDDEN",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "705360101"
        ],
        "dialogs": {
          "705360101": {
            "id": "705360101",
            "speakerId": 1002,
            "speakerName": "可莉",
            "text": "嘿嘿！嘟嘟可战胜了一大群坏坏的角角鱼士兵！角角鱼的大王也不是对手！",
            "nextDialogs": [
              "705360102"
            ]
          },
          "705360102": {
            "id": "705360102",
            "speakerId": 1002,
            "speakerName": "可莉",
            "text": "嘟嘟可，蹦蹦炸弹和轰轰火花的组合，是最厉害的！",
            "nextDialogs": [
              "705360105"
            ]
          },
          "705360105": {
            "id": "705360105",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "玩这个游戏的时候，我经常想到果酒湖的那件事呢…难道丽莎直接把那件事改编成了游戏的主题？",
            "nextDialogs": [
              "705360106"
            ]
          },
          "705360106": {
            "id": "705360106",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "不过话说回来，如果真的找不到那些外来的鱼…让小可莉去把可疑的礁石统统炸一遍，不就万事大吉了吗？",
            "nextDialogs": [
              "705360107"
            ]
          },
          "705360107": {
            "id": "705360107",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "实在不行，给我们几个炸弹，我们也能把这件事包办了！"
          }
        }
      }
    },
    {
      "subId": "7053802",
      "subQuestName": "(test)传送到蒙德城$HIDDEN",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [],
        "dialogs": {}
      }
    },
    {
      "subId": "7053803",
      "subQuestName": "(test)与卫兵对话$HIDDEN",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "705380301"
        ],
        "dialogs": {
          "705380301": {
            "id": "705380301",
            "speakerId": 1003,
            "speakerName": "波尔托",
            "text": "不愧是荣誉骑士和白色小帮手，两三下就找到了这个逃犯！",
            "nextDialogs": [
              "705380302"
            ]
          },
          "705380302": {
            "id": "705380302",
            "speakerId": 1003,
            "speakerName": "波尔托",
            "text": "之前，我的同僚们将她锁定为嫌疑人，确认她的身份和离开蒙德的时间点后，误以为她向荆夫港方向逃走了，准备乘船离境…",
            "nextDialogs": [
              "705380303"
            ]
          },
          "705380303": {
            "id": "705380303",
            "speakerId": 1003,
            "speakerName": "波尔托",
            "text": "没想到，她居然深入了明冠山地，难怪怎么都找不到她的踪迹…反侦察意识还挺强的嘛！",
            "nextDialogs": [
              "705380304"
            ]
          },
          "705380304": {
            "id": "705380304",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "呃，我觉得她根本没有躲避你们的意思，毕竟她根本没有意识到发生了什么事…",
            "nextDialogs": [
              "705380305"
            ]
          },
          "705380305": {
            "id": "705380305",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "总之，哲俩阿小姐虽然确确实实犯了错，但她应该不是出于恶意的！请你们也不要对她太凶哦！",
            "nextDialogs": [
              "705380306"
            ]
          },
          "705380306": {
            "id": "705380306",
            "speakerId": 1003,
            "speakerName": "波尔托",
            "text": "那是当然，我听说她态度还挺好的！对于积极配合的犯人，我们也会心平气和地讲道理。",
            "nextDialogs": [
              "705380307"
            ]
          },
          "705380307": {
            "id": "705380307",
            "speakerId": 1003,
            "speakerName": "波尔托",
            "text": "调查小队说目前的事态和损失完全可以控制，我们只需要走一遍正规的流程，评估她导致的损失，给她一笔适当的罚金就行了。",
            "nextDialogs": [
              "705380310"
            ]
          },
          "705380310": {
            "id": "705380310",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "呼…没想到我们也参与了这次的事件…作为骑士团抓到犯人，居然是这种感觉！",
            "nextDialogs": [
              "705380311"
            ]
          },
          "705380311": {
            "id": "705380311",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "话说回来，还好哲俩阿小姐是个冒失犯，而不是蓄意要破坏蒙德的酒业呢…",
            "nextDialogs": [
              "705380312"
            ]
          },
          "705380312": {
            "id": "705380312",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "不然，如果抓住了一个凶恶的家伙，那人死不悔改，还大声嚷嚷的话，我们一天的好心情也会被毁掉！",
            "nextDialogs": [
              "705380313"
            ]
          },
          "705380313": {
            "id": "705380313",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "希望哲俩阿小姐了解了自己的过失，受到惩罚后，不会太沮丧吧…"
          }
        }
      }
    },
    {
      "subId": "7053801",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "705380101"
        ],
        "dialogs": {
          "705380101": {
            "id": "705380101",
            "speakerId": 1001,
            "speakerName": "哲俩阿",
            "text": "真悠闲啊~蒙德的山林，确实是个露营的好地方！这趟生意跑得真值！",
            "nextDialogs": [
              "705380102"
            ]
          },
          "705380102": {
            "id": "705380102",
            "speakerId": 1001,
            "speakerName": "哲俩阿",
            "text": "湿度和温度正合适，不会随便干点活就浑身湿透，阳光也不刺眼，还有一股干爽的香气！"
          }
        }
      }
    },
    {
      "subId": "7053811",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "705381101"
        ],
        "dialogs": {
          "705381101": {
            "id": "705381101",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "你是？",
            "nextDialogs": [
              "705381102"
            ]
          },
          "705381102": {
            "id": "705381102",
            "speakerId": 1001,
            "speakerName": "哲俩阿",
            "text": "啊呀，有新朋友来了！请坐请坐，一起喝茶吃饭聊聊天！",
            "nextDialogs": [
              "705381103"
            ]
          },
          "705381103": {
            "id": "705381103",
            "speakerId": 1001,
            "speakerName": "哲俩阿",
            "text": "我叫哲俩阿，从须弥来，是个商人。最近我刚刚做完一单大生意，正在享受蒙德的自然风光！",
            "nextDialogs": [
              "705381104"
            ]
          },
          "705381104": {
            "id": "705381104",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "我们还是第一次碰见在这个地方露营的人呢…",
            "nextDialogs": [
              "705381105"
            ]
          },
          "705381105": {
            "id": "705381105",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "一般来说，商人不应该…守着自己的店铺和货物吗？你要是不直说，我们完全猜不到你的身份！",
            "nextDialogs": [
              "705381106"
            ]
          },
          "705381106": {
            "id": "705381106",
            "speakerId": 1001,
            "speakerName": "哲俩阿",
            "text": "哎呀，商人也要休息的嘛，谁还没几个兴趣爱好了？要劳逸结合，劳逸结合~",
            "nextDialogs": [
              "705381107"
            ]
          },
          "705381107": {
            "id": "705381107",
            "speakerId": 1001,
            "speakerName": "哲俩阿",
            "text": "要知道，在我们须弥，就连每时每刻都被学业折磨的学生，都很看重这一点，会自己发明游戏来解闷呢。",
            "nextDialogs": [
              "705381108"
            ]
          },
          "705381108": {
            "id": "705381108",
            "speakerId": 1001,
            "speakerName": "哲俩阿",
            "text": "我的第一桶金，就是代理一位学生发明的桌游「滚滚炸炸菇」赚到的。",
            "nextDialogs": [
              "705381109"
            ]
          },
          "705381109": {
            "id": "705381109",
            "speakerId": 1001,
            "speakerName": "哲俩阿",
            "text": "那位天才般的学生说过，「工作是做不完的，要适当抽点空…偷偷懒~」。",
            "nextDialogs": [
              "705381110"
            ]
          },
          "705381110": {
            "id": "705381110",
            "speakerId": 1001,
            "speakerName": "哲俩阿",
            "text": "她给我带来了以前不敢想的财富，所以，我把她的话当成了人生信条！果然，每天都过得很开心！",
            "nextDialogs": [
              "705381113"
            ]
          },
          "705381113": {
            "id": "705381113",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "哲哲哲，哲俩阿小姐，你能不能仔细说说，代理那个…「滚滚炸炸菇」的经过？",
            "nextDialogs": [
              "705381114"
            ]
          },
          "705381114": {
            "id": "705381114",
            "speakerId": 1001,
            "speakerName": "哲俩阿",
            "text": "咦？你们也听说过这个游戏吗？明明是好久以前的游戏了…几年还是十几年来着？时间过得真的好快啊…",
            "nextDialogs": [
              "705381115"
            ]
          },
          "705381115": {
            "id": "705381115",
            "speakerId": 1001,
            "speakerName": "哲俩阿",
            "text": "说来也巧，当时，那位学生正打算返回家乡，所以把不方便带走的东西都卖掉，其中就包括「滚滚炸炸菇」的棋子和棋盘。",
            "nextDialogs": [
              "705381116"
            ]
          },
          "705381116": {
            "id": "705381116",
            "speakerId": 1001,
            "speakerName": "哲俩阿",
            "text": "那时的我只是个收废品的杂货商，有幸遇见了她，问了问棋子的事，她才想起自己发明的游戏好像还有用，给我简单介绍了一下…",
            "nextDialogs": [
              "705381117"
            ]
          },
          "705381117": {
            "id": "705381117",
            "speakerId": 1001,
            "speakerName": "哲俩阿",
            "text": "她说，如果我有心力，可以试着继续运营这个游戏。我就试着复刻了几份，真的卖得很不错！我的收入「唰」的一下就涨了上去！",
            "nextDialogs": [
              "705381118"
            ]
          },
          "705381118": {
            "id": "705381118",
            "speakerId": 1001,
            "speakerName": "哲俩阿",
            "text": "虽然「滚滚炸炸菇」没能流行多久，就被其他游戏取代了，但我赚到了做大生意的本钱，再也不用靠卖杂货维持生计了。",
            "nextDialogs": [
              "705381119"
            ]
          },
          "705381119": {
            "id": "705381119",
            "speakerId": 1001,
            "speakerName": "哲俩阿",
            "text": "可以说，那位天才学生的无心之举，改变了我的命运！"
          }
        }
      }
    },
    {
      "subId": "7053812",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "705381201"
        ],
        "dialogs": {
          "705381201": {
            "id": "705381201",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "生意？",
            "nextDialogs": [
              "705381202"
            ]
          },
          "705381202": {
            "id": "705381202",
            "speakerId": 1001,
            "speakerName": "哲俩阿",
            "text": "哦？是本地人？要坐下来一起喝碗汤，吃点东西吗？",
            "nextDialogs": [
              "705381203"
            ]
          },
          "705381203": {
            "id": "705381203",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "好热情的人！你是一个…露营爱好者吗？",
            "nextDialogs": [
              "705381204"
            ]
          },
          "705381204": {
            "id": "705381204",
            "speakerId": 1001,
            "speakerName": "哲俩阿",
            "text": "啊哈，这么说也没错！我叫哲俩阿，本职是须弥的商人。说不定过段时间，你们就很熟悉我的名字了。",
            "nextDialogs": [
              "705381205"
            ]
          },
          "705381205": {
            "id": "705381205",
            "speakerId": 1001,
            "speakerName": "哲俩阿",
            "text": "因为审核通过后，你们就在布兰琪小姐那里买到我的商品了——很有须弥特色的食材、香料和餐具，物美价廉！",
            "nextDialogs": [
              "705381206"
            ]
          },
          "705381206": {
            "id": "705381206",
            "speakerId": 1001,
            "speakerName": "哲俩阿",
            "text": "不得不说，蒙德人都好平和啊，两三下就和我达成了交易，不怎么讲价。",
            "nextDialogs": [
              "705381207"
            ]
          },
          "705381207": {
            "id": "705381207",
            "speakerId": 1001,
            "speakerName": "哲俩阿",
            "text": "倒也不是说须弥人脾气不好，而是…相对注重逻辑和细节，商议大宗订单的价钱时，会有一段比较长的磋商期…",
            "nextDialogs": [
              "705381210"
            ]
          },
          "705381210": {
            "id": "705381210",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "对哦，每个地方都有各种各样的人，很难用一两句话来概括吧？",
            "nextDialogs": [
              "705381211"
            ]
          },
          "705381211": {
            "id": "705381211",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "说不定你以前做生意没那么顺利，只是有点倒霉，这次到蒙德来的时候，刚好走了大运。",
            "nextDialogs": [
              "705381212"
            ]
          },
          "705381212": {
            "id": "705381212",
            "speakerId": 1001,
            "speakerName": "哲俩阿",
            "text": "走了大运？",
            "nextDialogs": [
              "705381213"
            ]
          },
          "705381213": {
            "id": "705381213",
            "speakerId": 1001,
            "speakerName": "哲俩阿",
            "text": "确实！我刚来蒙德的时候，确实为了生意顺利，放生了几条鱼…就是这件事为我带来了好运，所以我碰见了理想的合作伙伴！",
            "nextDialogs": [
              "705381214"
            ]
          },
          "705381214": {
            "id": "705381214",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "放生了…几条鱼？",
            "nextDialogs": [
              "705381215"
            ]
          },
          "705381215": {
            "id": "705381215",
            "speakerId": 1001,
            "speakerName": "哲俩阿",
            "text": "没错！既然如此有缘，就悄悄告诉你们好了，这可是我从去过枫丹那里的商人听说的秘法，只有极少数须弥人知道——",
            "nextDialogs": [
              "705381216"
            ]
          },
          "705381216": {
            "id": "705381216",
            "speakerId": 1001,
            "speakerName": "哲俩阿",
            "text": "在做重要的事情之前，放生一些动物，会让自己的运气好转！甚至有人专门去购买动物来放生！",
            "nextDialogs": [
              "705381217"
            ]
          },
          "705381217": {
            "id": "705381217",
            "speakerId": 1001,
            "speakerName": "哲俩阿",
            "text": "如果你们从事过狩猎一类的工作，也可以考虑用这种方法来帮助自己！损失一小点摩拉，赚到大大的好运，很值吧！",
            "nextDialogs": [
              "705381218"
            ]
          },
          "705381218": {
            "id": "705381218",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "#（{NICKNAME}，难道说…果酒湖里突然出现了角鲀，是因为…）"
          }
        }
      }
    },
    {
      "subId": "7053813",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "705381301"
        ],
        "dialogs": {
          "705381301": {
            "id": "705381301",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "（看她好悠闲，不打扰她了…）",
            "nextDialogs": [
              "705381302"
            ]
          },
          "705381302": {
            "id": "705381302",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "（有道理，在这种偏僻地方露营的人，应该很不希望被打扰吧…我们悄悄离开好了。）"
          }
        }
      }
    },
    {
      "subId": "7053815",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "705381501"
        ],
        "dialogs": {
          "705381501": {
            "id": "705381501",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "（我不想越权行事…）",
            "nextDialogs": [
              "705381502"
            ]
          },
          "705381502": {
            "id": "705381502",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "（越权？怎么突然说出这么一个奇怪的词…又好像在哪里听到过…）",
            "nextDialogs": [
              "705381503"
            ]
          },
          "705381503": {
            "id": "705381503",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "（难道你的意思是，抓住犯人是其他骑士的职责？我们不能把自己分外的工作也干了…抢走别人的功劳？）",
            "nextDialogs": [
              "705381504"
            ]
          },
          "705381504": {
            "id": "705381504",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "（嗯…想想也有道理呢！哲俩阿小姐虽然犯下了错，但不像是凶恶的坏人…一般的骑士也能抓住她吧。）",
            "nextDialogs": [
              "705381505"
            ]
          },
          "705381505": {
            "id": "705381505",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "（对于一般的骑士来说，这是轻轻松松就能积累功绩的好机会，而这种功绩对于我们来说也没什么用，就让给他们好了…）",
            "nextDialogs": [
              "705381506"
            ]
          },
          "705381506": {
            "id": "705381506",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "（但哲俩阿小姐现在的地方又很偏，骑士们会不会一时半会儿找不到她？要想个办法让哲俩阿小姐回到蒙德城附近去才行。）",
            "nextDialogs": [
              "705381507"
            ]
          },
          "705381507": {
            "id": "705381507",
            "speakerId": 1001,
            "speakerName": "哲俩阿",
            "text": "你们在小声说什么呢？难道是对我的放生理论很感兴趣吗？",
            "nextDialogs": [
              "705381508"
            ]
          },
          "705381508": {
            "id": "705381508",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "啊！我们刚刚…听哲俩阿小姐说到鱼…突然在想晚餐该吃什么！",
            "nextDialogs": [
              "705381511"
            ]
          },
          "705381511": {
            "id": "705381511",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "咦？唔…哦！对对对！",
            "nextDialogs": [
              "705381512"
            ]
          },
          "705381512": {
            "id": "705381512",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "既然哲俩阿小姐都来到蒙德了，那一定不能错过蒙德烤鱼，吃起来又香又方便！还有…蜜酱胡萝卜煎肉，堆高高和火火肉酱面！",
            "nextDialogs": [
              "705381513"
            ]
          },
          "705381513": {
            "id": "705381513",
            "speakerId": 1001,
            "speakerName": "哲俩阿",
            "text": "哎呀！你们不说我都忘了！",
            "nextDialogs": [
              "705381514"
            ]
          },
          "705381514": {
            "id": "705381514",
            "speakerId": 1001,
            "speakerName": "哲俩阿",
            "text": "之前光顾着谈生意了，谈完生意就在游山玩水，完全没想起来在蒙德城内好好吃一顿饭。",
            "nextDialogs": [
              "705381515"
            ]
          },
          "705381515": {
            "id": "705381515",
            "speakerId": 1001,
            "speakerName": "哲俩阿",
            "text": "只是听说，本地一间叫「猎鹿人」的餐馆物美价廉，还有外送服务，就随手下了几天的订单。",
            "nextDialogs": [
              "705381516"
            ]
          },
          "705381516": {
            "id": "705381516",
            "speakerId": 1001,
            "speakerName": "哲俩阿",
            "text": "可当时我也忘了问，哪些是蒙德本地的特色菜，送餐的服务员也未必能找到我露营的这个地方…",
            "nextDialogs": [
              "705381517"
            ]
          },
          "705381517": {
            "id": "705381517",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "要不，你过段时间，还是回蒙德城里，去好好吃一顿大餐？",
            "nextDialogs": [
              "705381518"
            ]
          },
          "705381518": {
            "id": "705381518",
            "speakerId": 1001,
            "speakerName": "哲俩阿",
            "text": "嗯！我要顺带再找本地人问问蒙德的其他特产，带回去给朋友们当伴手礼！",
            "nextDialogs": [
              "705381519"
            ]
          },
          "705381519": {
            "id": "705381519",
            "speakerId": 1001,
            "speakerName": "哲俩阿",
            "text": "我记得城门旁边就有两个骑士在站岗，他们应该很在行，可以给我很好的建议！",
            "nextDialogs": [
              "705381520"
            ]
          },
          "705381520": {
            "id": "705381520",
            "speakerId": 1001,
            "speakerName": "哲俩阿",
            "text": "事不宜迟！我现在就回去一趟！",
            "nextDialogs": [
              "705381521"
            ]
          },
          "705381521": {
            "id": "705381521",
            "speakerId": 1004,
            "speakerName": "Black Screen",
            "text": "哲俩阿兴致勃勃地离开了营地，向着蒙德城的方向小跑离去了。",
            "nextDialogs": [
              "705381522"
            ]
          },
          "705381522": {
            "id": "705381522",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "结果哲俩阿小姐自己提出要去找骑士聊天了…不知道会不会在聊天的过程中直接被抓起来。",
            "nextDialogs": [
              "705381523"
            ]
          },
          "705381523": {
            "id": "705381523",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "不过，到时候骑士们应该也会意识到，她之前做的事是无心之举吧，毕竟，哪有蓄意搞破坏的犯人自己找上门来的事…"
          }
        }
      }
    },
    {
      "subId": "7053899",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "705389901"
        ],
        "dialogs": {
          "705389901": {
            "id": "705389901",
            "speakerId": 1004,
            "speakerName": "Black Screen",
            "text": "哲俩阿猝不及防之时，你与派蒙扑了上去，以恰到好处的力道将她打昏，扛回了西风骑士团的总部…"
          }
        }
      }
    }
  ]
}
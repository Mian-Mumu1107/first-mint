  "subQuests": [
    {
      "subId": "7105301",
      "subQuestName": "与海迪夫对话",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "710501401"
        ],
        "dialogs": {
          "710501401": {
            "id": "710501401",
            "speakerId": 1000,
            "speakerName": "海迪夫",
            "text": "先不说其他的了。",
            "nextDialogs": [
              "710501402"
            ]
          },
          "710501402": {
            "id": "710501402",
            "speakerId": 1000,
            "speakerName": "海迪夫",
            "text": "在层岩巨渊的这几天，你做了很多，我都不知道应该怎么感谢你了。",
            "nextDialogs": [
              "710501403"
            ]
          },
          "710501403": {
            "id": "710501403",
            "speakerId": 1000,
            "speakerName": "海迪夫",
            "text": "如果再给你钱，也实在是太过生分了。",
            "nextDialogs": [
              "710501404"
            ]
          },
          "710501404": {
            "id": "710501404",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "其实你一定要给的话…",
            "nextDialogs": [
              "710501405"
            ]
          },
          "710501405": {
            "id": "710501405",
            "speakerId": 1000,
            "speakerName": "海迪夫",
            "text": "别开玩笑了，我怎么能做出给你一笔钱了事，这种不解风情的行为。",
            "nextDialogs": [
              "710501406"
            ]
          },
          "710501406": {
            "id": "710501406",
            "speakerId": 1000,
            "speakerName": "海迪夫",
            "text": "那不是在污辱你吗！",
            "nextDialogs": [
              "710501407"
            ]
          },
          "710501407": {
            "id": "710501407",
            "speakerId": 1000,
            "speakerName": "海迪夫",
            "text": "来，收好这封信吧，如果你以后有机会去须弥，遇到了什么麻烦，或有什么需要帮助的，那就拿着这封信找普尔比鲁尼一门的人！",
            "nextDialogs": [
              "710501408"
            ]
          },
          "710501408": {
            "id": "710501408",
            "speakerId": 1000,
            "speakerName": "海迪夫",
            "text": "我们一定会尽全力帮助你的。",
            "nextDialogs": [
              "710501409"
            ]
          },
          "710501409": {
            "id": "710501409",
            "speakerId": 1000,
            "speakerName": "海迪夫",
            "text": "「往来的人情，比黄金还宝贵。」",
            "nextDialogs": [
              "710501410"
            ]
          },
          "710501410": {
            "id": "710501410",
            "speakerId": 1000,
            "speakerName": "海迪夫",
            "text": "这句须弥谚语，说的就是这样的情形吧。"
          }
        }
      }
    }
  ]
}
    },
    {
      "subId": "7012911",
      "subQuestName": "(test)废弃$HIDDEN",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "701291101"
        ],
        "dialogs": {
          "701291101": {
            "id": "701291101",
            "speakerId": 22746,
            "speakerName": "丘林",
            "text": "嗯…怎么了？冒险家，找我还有什么事吗？",
            "nextDialogs": [
              "701291103",
              "701291105"
            ]
          },
          "701291103": {
            "id": "701291103",
            "speakerId": 22746,
            "speakerName": "丘林",
            "text": "好、好吧，老师也说…这样的切磋对我来说有好处。"
          },
          "701291105": {
            "id": "701291105",
            "speakerId": 22746,
            "speakerName": "丘林",
            "text": "那就…那就不打扰了，我还得完成今天的雕塑呢。"
          }
        }
      }
    },

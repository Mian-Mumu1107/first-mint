    },
    {
      "subId": "7012909",
      "subQuestName": "(test)隐藏$HIDDEN",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "701290901"
        ],
        "dialogs": {
          "701290901": {
            "id": "701290901",
            "speakerId": 22748,
            "speakerName": "布拉金",
            "text": "了不起啊，冒险家，没想到还能遇到你这样的强者。",
            "nextDialogs": [
              "701290902"
            ]
          },
          "701290902": {
            "id": "701290902",
            "speakerId": 22748,
            "speakerName": "布拉金",
            "text": "跟你切磋过后，灵感也如泉水般涌出…了不起…",
            "nextDialogs": [
              "701290903"
            ]
          },
          "701290903": {
            "id": "701290903",
            "speakerId": 22748,
            "speakerName": "布拉金",
            "text": "这就是给您的酬劳…哈哈，打上这么一场，感觉筋骨也舒展开，身体也热了起来…",
            "nextDialogs": [
              "701290904"
            ]
          },
          "701290904": {
            "id": "701290904",
            "speakerId": 22748,
            "speakerName": "布拉金",
            "text": "不过其实我们当中，丘林其实是最能打的，只不过雕塑水平上他还需要练习…",
            "nextDialogs": [
              "701290905"
            ]
          },
          "701290905": {
            "id": "701290905",
            "speakerId": 22748,
            "speakerName": "布拉金",
            "text": "如果你想要和他进行切磋，就尽管找他吧！这对他来说也是好事。"
          }
        }
      }
    },
    {
      "subId": "7012910",
      "subQuestName": "(test)隐藏$HIDDEN",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "701291001"
        ],
        "dialogs": {
          "701291001": {
            "id": "701291001",
            "speakerId": 22747,
            "speakerName": "法捷夫",
            "text": "唉…老师，您的办法真的有用吗？",
            "nextDialogs": [
              "701291002"
            ]
          },
          "701291002": {
            "id": "701291002",
            "speakerId": 22747,
            "speakerName": "法捷夫",
            "text": "我也没觉得自己做臻冰雕塑的水平有提高…我只觉得自己做雕塑快了很多。",
            "nextDialogs": [
              "701291003"
            ]
          },
          "701291003": {
            "id": "701291003",
            "speakerId": 22748,
            "speakerName": "布拉金",
            "text": "这不就是进步吗？",
            "nextDialogs": [
              "701291004"
            ]
          },
          "701291004": {
            "id": "701291004",
            "speakerId": 22747,
            "speakerName": "法捷夫",
            "text": "啊？",
            "nextDialogs": [
              "701291005"
            ]
          },
          "701291005": {
            "id": "701291005",
            "speakerId": 22748,
            "speakerName": "布拉金",
            "text": "当初老师我就是因为做得快才被叫去白冕宫表演的啊。",
            "nextDialogs": [
              "701291006"
            ]
          },
          "701291006": {
            "id": "701291006",
            "speakerId": 22748,
            "speakerName": "布拉金",
            "text": "一尊雕像，瞬间就能做出来，不然怎么表演，让白沙皇陛下坐在那里看一天吗？",
            "nextDialogs": [
              "701291007"
            ]
          },
          "701291007": {
            "id": "701291007",
            "speakerId": 22747,
            "speakerName": "法捷夫",
            "text": "原、原来如此…"
          }
        }
      }
    },
    {
      "subId": "7012913",

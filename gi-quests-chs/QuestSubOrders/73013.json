{
  "lineCounts": {
    "Player": 24,
    "兰帕卡提": 58,
    "兰罗摩": 10,
    "兰茶荼": 4,
    "兰萨卡": 4,
    "兰阿帕斯": 3,
    "兰非拉": 3,
    "派蒙": 34
  },
  "subQuests": [
    {
      "subId": "7301301",
      "subQuestName": "",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "730130101"
        ],
        "dialogs": {
          "730130101": {
            "id": "730130101",
            "speakerId": 4191,
            "speakerName": "兰帕卡提",
            "text": "呀！是金色的那菈。噫…",
            "nextDialogs": [
              "730130102"
            ]
          },
          "730130102": {
            "id": "730130102",
            "speakerId": 20646,
            "speakerName": "兰罗摩",
            "text": "#兰帕卡提不害怕。那菈{NICKNAME}是好那菈，和故事里的那个那菈一样。那菈{NICKNAME}和派蒙，帮助了大家许多。",
            "nextDialogs": [
              "730130103"
            ]
          },
          "730130103": {
            "id": "730130103",
            "speakerId": 4191,
            "speakerName": "兰帕卡提",
            "text": "#嗯，不害怕了。兰罗摩，兰帕卡提相信你，也相信草、叶子和种子说的话，明白是好那菈。你们好，那菈{NICKNAME}和派蒙。",
            "nextDialogs": [
              "730130104"
            ]
          },
          "730130104": {
            "id": "730130104",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "兰帕卡提，你好！",
            "nextDialogs": [
              "730130106"
            ]
          },
          "730130106": {
            "id": "730130106",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "喂！别开这种玩笑！",
            "nextDialogs": [
              "730130107"
            ]
          },
          "730130107": {
            "id": "730130107",
            "speakerId": 4191,
            "speakerName": "兰帕卡提",
            "text": "不是的。兰帕卡提知道。",
            "nextDialogs": [
              "730130108"
            ]
          },
          "730130108": {
            "id": "730130108",
            "speakerId": 4191,
            "speakerName": "兰帕卡提",
            "text": "#很多风的地方，有小小的种子。它们和那菈一起来到桓那兰那。它们说，那菈{NICKNAME}很好。",
            "nextDialogs": [
              "730130109"
            ]
          },
          "730130109": {
            "id": "730130109",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "之前兰罗摩也说过类似的话呢！这么说来，很多风的地方来的种子…是指蒲公英吗？"
          }
        }
      }
    },
    {
      "subId": "7301302",
      "subQuestName": "",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "730130201"
        ],
        "dialogs": {
          "730130201": {
            "id": "730130201",
            "speakerId": 4191,
            "speakerName": "兰帕卡提",
            "text": "…和那菈说话，好困难。而且，好高喔。",
            "nextDialogs": [
              "730130202"
            ]
          },
          "730130202": {
            "id": "730130202",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "你好。",
            "nextDialogs": [
              "730130203"
            ]
          },
          "730130203": {
            "id": "730130203",
            "speakerId": 4191,
            "speakerName": "兰帕卡提",
            "text": "#噫！是那菈{NICKNAME}…",
            "nextDialogs": [
              "730130204"
            ]
          },
          "730130204": {
            "id": "730130204",
            "speakerId": 4191,
            "speakerName": "兰帕卡提",
            "text": "兰帕卡提不害怕。而且，哥哥们胆子大，一定也不害怕。",
            "nextDialogs": [
              "730130205"
            ]
          },
          "730130205": {
            "id": "730130205",
            "speakerId": 4191,
            "speakerName": "兰帕卡提",
            "text": "只要跟着<color=#00E1FFFF>烟柱</color>，应该就能找到他们。如果变得奇怪，就用<color=#00E1FFFF>草元素的力量</color>「啪叽」他们。"
          }
        }
      }
    },
    {
      "subId": "7301303",
      "subQuestName": "向兰帕卡提回报",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "730130301"
        ],
        "dialogs": {
          "730130301": {
            "id": "730130301",
            "speakerId": 4191,
            "speakerName": "兰帕卡提",
            "text": "兰帕卡提现在可是非常生气，哎呀呀，比非常生气还要生气一点！",
            "nextDialogs": [
              "730130302"
            ]
          },
          "730130302": {
            "id": "730130302",
            "speakerId": 4191,
            "speakerName": "兰帕卡提",
            "text": "森林里面多危险呀，「无留陀」在森林里肆虐。出发的时候，兰帕卡提还特意叮嘱几位哥哥要团结一心…",
            "nextDialogs": [
              "730130303"
            ]
          },
          "730130303": {
            "id": "730130303",
            "speakerId": 4191,
            "speakerName": "兰帕卡提",
            "text": "结果刚出门就大吵了一架，兰茶荼，你自己还吃了奇怪的东西。",
            "nextDialogs": [
              "730130304"
            ]
          },
          "730130304": {
            "id": "730130304",
            "speakerId": 4192,
            "speakerName": "兰茶荼",
            "text": "呜呜…",
            "nextDialogs": [
              "730130305"
            ]
          },
          "730130305": {
            "id": "730130305",
            "speakerId": 4191,
            "speakerName": "兰帕卡提",
            "text": "兰帕卡提决定，在十次日落果成熟的时间里，兰茶荼都不准采蘑菇了。",
            "nextDialogs": [
              "730130306"
            ]
          },
          "730130306": {
            "id": "730130306",
            "speakerId": 4192,
            "speakerName": "兰茶荼",
            "text": "怎么这样…呜呜…",
            "nextDialogs": [
              "730130307"
            ]
          },
          "730130307": {
            "id": "730130307",
            "speakerId": 4195,
            "speakerName": "兰非拉",
            "text": "就是，要是把坏孢子带进来了，让蘑菇怪物长出来，那怎么行嘛。",
            "nextDialogs": [
              "730130308"
            ]
          },
          "730130308": {
            "id": "730130308",
            "speakerId": 4191,
            "speakerName": "兰帕卡提",
            "text": "兰非拉哥哥也是，跑到离桓那兰那那么远的地方去采果子。那边有好坏好坏的东西！兰拉迦也特地说过的！",
            "nextDialogs": [
              "730130309"
            ]
          },
          "730130309": {
            "id": "730130309",
            "speakerId": 4195,
            "speakerName": "兰非拉",
            "text": "呜呜…",
            "nextDialogs": [
              "730130310"
            ]
          },
          "730130310": {
            "id": "730130310",
            "speakerId": 4194,
            "speakerName": "兰阿帕斯",
            "text": "就是就是。果实也要喝水，兰那罗也要喝水。所以，水是最好的。",
            "nextDialogs": [
              "730130311"
            ]
          },
          "730130311": {
            "id": "730130311",
            "speakerId": 4191,
            "speakerName": "兰帕卡提",
            "text": "兰阿帕斯哥哥，你非得去「法留纳神机」找水。难道不知道，就连那菈法留纳也说过，桓那兰那的水是最好喝的吗？",
            "nextDialogs": [
              "730130312"
            ]
          },
          "730130312": {
            "id": "730130312",
            "speakerId": 4194,
            "speakerName": "兰阿帕斯",
            "text": "呜呜…",
            "nextDialogs": [
              "730130313"
            ]
          },
          "730130313": {
            "id": "730130313",
            "speakerId": 4193,
            "speakerName": "兰萨卡",
            "text": "现、现在你们看见了吧，只有「开心的味道」，才能给妹妹带来幸福。",
            "nextDialogs": [
              "730130314"
            ]
          },
          "730130314": {
            "id": "730130314",
            "speakerId": 4191,
            "speakerName": "兰帕卡提",
            "text": "#兰萨卡哥哥，我听说，你为了你的「开心的味道」，给那菈{NICKNAME}增添了许多麻烦…",
            "nextDialogs": [
              "730130315"
            ]
          },
          "730130315": {
            "id": "730130315",
            "speakerId": 4193,
            "speakerName": "兰萨卡",
            "text": "那、那都是为了「至上珍馐」…",
            "nextDialogs": [
              "730130316"
            ]
          },
          "730130316": {
            "id": "730130316",
            "speakerId": 4191,
            "speakerName": "兰帕卡提",
            "text": "完成「至上珍馐」是为了得到「烹饪修行」的结果，哎呀呀，依靠他人的力量完成的修行，又有什么意义可言？",
            "nextDialogs": [
              "730130317"
            ]
          },
          "730130317": {
            "id": "730130317",
            "speakerId": 4191,
            "speakerName": "兰帕卡提",
            "text": "兰帕卡提觉得，兰萨卡哥哥最需要好好进行反省。",
            "nextDialogs": [
              "730130318"
            ]
          },
          "730130318": {
            "id": "730130318",
            "speakerId": 4193,
            "speakerName": "兰萨卡",
            "text": "呜呜…",
            "nextDialogs": [
              "730130319"
            ]
          },
          "730130319": {
            "id": "730130319",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "兰帕卡提！我们来啦！",
            "nextDialogs": [
              "730130320"
            ]
          },
          "730130320": {
            "id": "730130320",
            "speakerId": 4191,
            "speakerName": "兰帕卡提",
            "text": "哎呀呀，是你们。",
            "nextDialogs": [
              "730130321"
            ]
          },
          "730130321": {
            "id": "730130321",
            "speakerId": 4191,
            "speakerName": "兰帕卡提",
            "text": "#那菈{NICKNAME}和派蒙分享了兰帕卡提的烦恼，解决了烦恼的根源…",
            "nextDialogs": [
              "730130322"
            ]
          },
          "730130322": {
            "id": "730130322",
            "speakerId": 4191,
            "speakerName": "兰帕卡提",
            "text": "兰帕卡提终于不再为哥哥们错过无忧节，是否在外涉险而感到烦恼了。多亏你们了。",
            "nextDialogs": [
              "730130323"
            ]
          },
          "730130323": {
            "id": "730130323",
            "speakerId": 4191,
            "speakerName": "兰帕卡提",
            "text": "兰帕卡提和哥哥们，都很感谢。",
            "nextDialogs": [
              "730130324"
            ]
          },
          "730130324": {
            "id": "730130324",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "那就最好不过了！",
            "nextDialogs": [
              "730130325"
            ]
          },
          "730130325": {
            "id": "730130325",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "不过，有件事情，我一直很好奇…",
            "nextDialogs": [
              "730130326"
            ]
          },
          "730130326": {
            "id": "730130326",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "「那菈法留纳」到底是谁？",
            "nextDialogs": [
              "730130327"
            ]
          },
          "730130327": {
            "id": "730130327",
            "speakerId": 4191,
            "speakerName": "兰帕卡提",
            "text": "#{MATEAVATAR#SEXPRO[INFO_MALE_PRONOUN_HE|INFO_FEMALE_PRONOUN_SHE]}是我们的朋友。是桓那兰那的朋友。",
            "nextDialogs": [
              "730130328"
            ]
          },
          "730130328": {
            "id": "730130328",
            "speakerId": 4191,
            "speakerName": "兰帕卡提",
            "text": "#在好久好久好久以前，兰那罗的朋友。和那菈{NICKNAME}很像，是个金灿灿的那菈。",
            "nextDialogs": [
              "730130329"
            ]
          },
          "730130329": {
            "id": "730130329",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "原来如此。不过，我还有别的问题…",
            "nextDialogs": [
              "730130330"
            ]
          },
          "730130330": {
            "id": "730130330",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "关于「兄妹」的事情吗？",
            "nextDialogs": [
              "730130331"
            ]
          },
          "730130331": {
            "id": "730130331",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "嗯。兰帕卡提的哥哥们，究竟谁最大、谁最小呢？",
            "nextDialogs": [
              "730130332"
            ]
          },
          "730130332": {
            "id": "730130332",
            "speakerId": 4191,
            "speakerName": "兰帕卡提",
            "text": "嗯？大小？",
            "nextDialogs": [
              "730130336",
              "730130335"
            ]
          },
          "730130336": {
            "id": "730130336",
            "speakerId": 4191,
            "speakerName": "兰帕卡提",
            "text": "「年龄」…啊。兰帕卡提知道了，就像树的年轮。嗯，森林的孩子们，是不分「年龄」大小的。",
            "nextDialogs": [
              "730130337"
            ]
          },
          "730130337": {
            "id": "730130337",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "欸？那「哥哥」和「妹妹」又是怎么回事…",
            "nextDialogs": [
              "730130338"
            ]
          },
          "730130338": {
            "id": "730130338",
            "speakerId": 4191,
            "speakerName": "兰帕卡提",
            "text": "#这个啊。以前，我们有一个那菈朋友。那菈法留纳。{MATEAVATAR#SEXPRO[INFO_MALE_PRONOUN_HE|INFO_FEMALE_PRONOUN_SHE]}说，{MATEAVATAR#SEXPRO[INFO_MALE_PRONOUN_HE|INFO_FEMALE_PRONOUN_SHE]}有一个「{PLAYERAVATAR#SEXPRO[INFO_MALE_PRONOUN_BROTHER|INFO_FEMALE_PRONOUN_SISTER]}」。",
            "nextDialogs": [
              "730130339"
            ]
          },
          "730130339": {
            "id": "730130339",
            "speakerId": 4191,
            "speakerName": "兰帕卡提",
            "text": "#兰帕卡提和哥哥们听{MATEAVATAR#SEXPRO[INFO_MALE_PRONOUN_HE|INFO_FEMALE_PRONOUN_SHE]}说到那个「{PLAYERAVATAR#SEXPRO[INFO_MALE_PRONOUN_BROTHER|INFO_FEMALE_PRONOUN_SISTER]}」的时候，看起来都很幸福，又很难过。",
            "nextDialogs": [
              "730130340"
            ]
          },
          "730130340": {
            "id": "730130340",
            "speakerId": 4191,
            "speakerName": "兰帕卡提",
            "text": "所以，我们知道了。对「哥哥」来说，「妹妹」是很重要的那菈。对「妹妹」来说，「哥哥」是很重要的那菈。",
            "nextDialogs": [
              "730130341"
            ]
          },
          "730130341": {
            "id": "730130341",
            "speakerId": 4191,
            "speakerName": "兰帕卡提",
            "text": "我们觉得很好。所以，兰帕卡提和哥哥们也决定，要变成「哥哥」和「妹妹」。那菈法留纳说，这样很好。要珍惜亲人。",
            "nextDialogs": [
              "730130342"
            ]
          },
          "730130342": {
            "id": "730130342",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "没错，一定要珍惜自己的亲人。",
            "nextDialogs": [
              "730130343"
            ]
          },
          "730130343": {
            "id": "730130343",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "嗯…",
            "nextDialogs": [
              "730130344"
            ]
          },
          "730130344": {
            "id": "730130344",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "我还有一件事情很在意…兰那罗需要吃饭吗？",
            "nextDialogs": [
              "730130345"
            ]
          },
          "730130345": {
            "id": "730130345",
            "speakerId": 4191,
            "speakerName": "兰帕卡提",
            "text": "人类会把食材做成菜肴，森林的孩子也可以把食材做成菜肴。",
            "nextDialogs": [
              "730130346"
            ]
          },
          "730130346": {
            "id": "730130346",
            "speakerId": 4191,
            "speakerName": "兰帕卡提",
            "text": "因为那菈法留纳以前，教过我们，那菈吃东西的方法。兰帕卡提和哥哥们，才会开始「烹饪修行」…",
            "nextDialogs": [
              "730130347"
            ]
          },
          "730130347": {
            "id": "730130347",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "唔，还真是奇怪…"
          },
          "730130335": {
            "id": "730130335",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "喂！才不是啦，是问年龄。"
          }
        }
      }
    },
    {
      "subId": "7301304",
      "subQuestName": "",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "730130401"
        ],
        "dialogs": {
          "730130401": {
            "id": "730130401",
            "speakerId": 20649,
            "speakerName": "兰帕卡提",
            "text": "#这次多亏了那菈{NICKNAME}，等到无忧节的时候，那菈{NICKNAME}也一定要来呀！"
          }
        }
      }
    },
    {
      "subId": "7301305",
      "subQuestName": "",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "730130501"
        ],
        "dialogs": {
          "730130501": {
            "id": "730130501",
            "speakerId": 20650,
            "speakerName": "兰茶荼",
            "text": "十次日落果成熟的时间都不能采蘑菇，呜呜，虽然时间很短…",
            "nextDialogs": [
              "730130502"
            ]
          },
          "730130502": {
            "id": "730130502",
            "speakerId": 20650,
            "speakerName": "兰茶荼",
            "text": "但是不知道为什么，一想到不能摘蘑菇，时间就变长起来了…"
          }
        }
      }
    },
    {
      "subId": "7301306",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "730130601"
        ],
        "dialogs": {
          "730130601": {
            "id": "730130601",
            "speakerId": 20653,
            "speakerName": "兰非拉",
            "text": "兰帕卡提，生气的时候好可怕，希望待会儿吃了果子，就不要那么生气了…"
          }
        }
      }
    },
    {
      "subId": "7301307",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "730130701"
        ],
        "dialogs": {
          "730130701": {
            "id": "730130701",
            "speakerId": 16765,
            "speakerName": "兰阿帕斯",

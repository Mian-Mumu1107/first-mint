  },
  "subQuests": [
    {
      "subId": "300101",
      "subQuestName": "寻找柯莱",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "30010101"
        ],
        "dialogs": {
          "30010101": {
            "id": "30010101",
            "speakerId": 1050,
            "speakerName": "提纳里",
            "text": "好，接下来是右手…情况似乎还可以。",
            "nextDialogs": [
              "30010102"
            ]
          },
          "30010102": {
            "id": "30010102",
            "speakerId": 1050,
            "speakerName": "提纳里",
            "text": "不过还是小心行事，明白吗？",
            "nextDialogs": [
              "30010103"
            ]
          },
          "30010103": {
            "id": "30010103",
            "speakerId": 1051,
            "speakerName": "柯莱",
            "text": "嗯，我知道了。对了师父，我还没拿到今天的巡林路线图。",
            "nextDialogs": [
              "30010104"
            ]
          },
          "30010104": {
            "id": "30010104",
            "speakerId": 1050,
            "speakerName": "提纳里",
            "text": "今天的路程很远，你就不要跟我一起去了，而且还可能会有那些东西出现在这条路线上。",
            "nextDialogs": [
              "30010105"
            ]
          },
          "30010105": {
            "id": "30010105",
            "speakerId": 1051,
            "speakerName": "柯莱",
            "text": "我明明也有神之眼，却没办法帮上什么忙…",
            "nextDialogs": [
              "30010106"
            ]
          },
          "30010106": {
            "id": "30010106",
            "speakerId": 1050,
            "speakerName": "提纳里",
            "text": "别说这种话，这不是你现在应该考虑的事。",
            "nextDialogs": [
              "30010107"
            ]
          },
          "30010107": {
            "id": "30010107",
            "speakerId": 1050,
            "speakerName": "提纳里",
            "text": "你们来了，身体感觉还好吗？",
            "nextDialogs": [
              "30010108"
            ]
          },
          "30010108": {
            "id": "30010108",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "有什么需要帮忙的吗？",
            "nextDialogs": [
              "30010109"
            ]
          },
          "30010109": {
            "id": "30010109",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "对，既然留在这里，我们也想稍微找点事情做。",
            "nextDialogs": [
              "30010110"
            ]
          },
          "30010110": {
            "id": "30010110",
            "speakerId": 1050,
            "speakerName": "提纳里",
            "text": "你们是这种闲不下来的类型吗？好吧，既然这样，今天就让柯莱带你们去化城郭南边巡视吧。",
            "nextDialogs": [
              "30010111"
            ]
          },
          "30010111": {
            "id": "30010111",
            "speakerId": 1050,
            "speakerName": "提纳里",
            "text": "如果你们对体力有信心，七天神像的清洁也交给你们了。",
            "nextDialogs": [
              "30010112"
            ]
          },
          "30010112": {
            "id": "30010112",
            "speakerId": 4301,
            "speakerName": "阿米尔",
            "text": "提纳里先生，我们已经准备完毕了！",
            "nextDialogs": [
              "30010113"
            ]
          },
          "30010113": {
            "id": "30010113",
            "speakerId": 1050,
            "speakerName": "提纳里",
            "text": "马上就来——我们先出发去林子里了，剩下的事就让柯莱跟你们说明吧。",
            "nextDialogs": [
              "30010114"
            ]
          },
          "30010114": {
            "id": "30010114",
            "speakerId": 1051,
            "speakerName": "柯莱",
            "text": "是，交给我吧。",
            "nextDialogs": [
              "30010115"
            ]
          },
          "30010115": {
            "id": "30010115",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "柯莱，我们今天都要做些什么？",
            "nextDialogs": [
              "30010116"
            ]
          },
          "30010116": {
            "id": "30010116",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "刚才提纳里说要清洁七天神像，但我没想到，这也算巡林员的工作啊？",
            "nextDialogs": [
              "30010117"
            ]
          },
          "30010117": {
            "id": "30010117",
            "speakerId": 1051,
            "speakerName": "柯莱",
            "text": "嗯，其实巡林员的工作内容很广。",
            "nextDialogs": [
              "30010118"
            ]
          },
          "30010118": {
            "id": "30010118",
            "speakerId": 1051,
            "speakerName": "柯莱",
            "text": "检查道路状况、维护林间设施、排除火灾隐患、为旅客居民提供帮助…",
            "nextDialogs": [
              "30010119"
            ]
          },
          "30010119": {
            "id": "30010119",
            "speakerId": 1051,
            "speakerName": "柯莱",
            "text": "如果是师父的话，还经常要去处理雨林中危险的区域。",
            "nextDialogs": [
              "30010120"
            ]
          },
          "30010120": {
            "id": "30010120",
            "speakerId": 1051,
            "speakerName": "柯莱",
            "text": "在我们到达七天神像前，先检查一下沿途的路灯吧。"
          }
        }
      }
    },
    {
      "subId": "300102",
      "subQuestName": "检查沿途的路灯",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [],

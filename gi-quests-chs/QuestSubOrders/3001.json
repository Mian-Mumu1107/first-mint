      }
    },
    {
      "subId": "300108",
      "subQuestName": "检查沿途的路灯",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "30010801"
        ],
        "dialogs": {
          "30010801": {
            "id": "30010801",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "柯莱，我们回来啦。",
            "nextDialogs": [
              "30010802"
            ]
          },
          "30010802": {
            "id": "30010802",
            "speakerId": 1051,
            "speakerName": "柯莱",
            "text": "辛苦了，你们爬上爬下，一定累了吧。我们就在这里休息一会吧。",
            "nextDialogs": [
              "30010803"
            ]
          },
          "30010803": {
            "id": "30010803",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "柯莱，你有没有在附近见过一种小小的、有点像植物的生物？",
            "nextDialogs": [
              "30010804"
            ]
          },
          "30010804": {
            "id": "30010804",
            "speakerId": 1051,
            "speakerName": "柯莱",
            "text": "像植物的生物？唔…如果是师父的话，一定会回答「植物也是生物」吧。",
            "nextDialogs": [
              "30010805"
            ]
          },
          "30010805": {
            "id": "30010805",
            "speakerId": 1004,
            "speakerName": "Black Screen",
            "text": "对柯莱叙述了刚才看到的东西…",
            "nextDialogs": [
              "30010806"
            ]
          },
          "30010806": {
            "id": "30010806",
            "speakerId": 1051,
            "speakerName": "柯莱",
            "text": "欸，好神奇啊，听起来就像是小朋友们经常说起的一种幻想生物。下次我帮你们打听一下。",
            "nextDialogs": [
              "30010807"
            ]
          },
          "30010807": {
            "id": "30010807",
            "speakerId": 1051,
            "speakerName": "柯莱",
            "text": "哦，你们饿不饿？我带了水和食物来。"
          }
        }
      }
    },
    {
      "subId": "300109",
      "subQuestName": "检查沿途的路灯",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "30010901"
        ],
        "dialogs": {
          "30010901": {
            "id": "30010901",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "柯莱，我们回来啦。",
            "nextDialogs": [
              "30010902"
            ]
          },
          "30010902": {
            "id": "30010902",
            "speakerId": 1051,
            "speakerName": "柯莱",
            "text": "辛苦了，你们爬上爬下，一定累了吧。我们就在这里休息一会吧，我带了水和食物来。"
          }
        }
      }
    },
    {
      "subId": "300103",
      "subQuestName": "前往七天神像",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "30010501"
        ],
        "dialogs": {
          "30010501": {
            "id": "30010501",
            "speakerId": 1051,
            "speakerName": "柯莱",
            "text": "七天神像就在那块巨大的岩石上面，你们之前从这条路过来的时候，应该已经看到它了。",
            "nextDialogs": [
              "30010502"
            ]
          },
          "30010502": {
            "id": "30010502",
            "speakerId": 1051,
            "speakerName": "柯莱",
            "text": "位置是不是有点高？如果你觉得爬上去比较勉强，不打扫也没关系，师父不会介意的。",
            "nextDialogs": [
              "30010505"
            ]
          },
          "30010505": {
            "id": "30010505",
            "speakerId": 1051,
            "speakerName": "柯莱",
            "text": "是吗，那就交给你了。神像附近的空间很小，你在上面要小心一点。",
            "nextDialogs": [
              "30010506"
            ]
          },
          "30010506": {
            "id": "30010506",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "#{NICKNAME}，我也和你一起上去吧，我可以帮你打扫比较高的地方。",
            "nextDialogs": [
              "30010507"
            ]
          },
          "30010507": {
            "id": "30010507",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "对了柯莱，你知道草神是位什么样的神吗？",
            "nextDialogs": [
              "30010508"
            ]
          },
          "30010508": {
            "id": "30010508",
            "speakerId": 1051,
            "speakerName": "柯莱",
            "text": "你是问「大慈树王」还是「小吉祥草王」？",
            "nextDialogs": [
              "30010509"
            ]
          },
          "30010509": {
            "id": "30010509",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "咦，「大慈树王」？",
            "nextDialogs": [
              "30010510"
            ]
          },
          "30010510": {
            "id": "30010510",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "啊，难道说这是前代草神的名字？",
            "nextDialogs": [
              "30010511"
            ]
          },
          "30010511": {
            "id": "30010511",
            "speakerId": 1051,
            "speakerName": "柯莱",
            "text": "对。「大慈树王」是须弥的初代草神大人。她创造了雨林，在沙漠边缘建起防沙壁，大家这才获得了安宁的生活。",
            "nextDialogs": [
              "30010512"
            ]
          },
          "30010512": {
            "id": "30010512",
            "speakerId": 1051,
            "speakerName": "柯莱",
            "text": "在须弥人眼里，她是智慧、仁慈与无所不能的象征，但她却在几百年前的灾难中消失了。"
          }
        }
      }
    },

    {
      "subId": "300107",
      "subQuestName": "与草神像共鸣",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "3117801"
        ],
        "dialogs": {
          "3117801": {
            "id": "3117801",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "与草元素共鸣"
          }
        }
      }
    },
    {
      "subId": "300105",
      "subQuestName": "观察面前的草神像",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "30010601"
        ],
        "dialogs": {
          "30010601": {
            "id": "30010601",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "仔细看的话，这座神像雕刻出的神明，身材很小巧的样子。",
            "nextDialogs": [
              "30010602"
            ]
          },
          "30010602": {
            "id": "30010602",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "唔，你说她究竟是「大慈树王」，还是「小吉祥草王」？",
            "nextDialogs": [
              "30010604",
              "30010606"
            ]
          },
          "30010604": {
            "id": "30010604",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "嗯，很有可能，毕竟这座神像看起来很古老了。",
            "nextDialogs": [
              "30010607"
            ]
          },
          "30010607": {
            "id": "30010607",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "算啦，关于她们的事情，我们以后总会打听到的。好，接下来我们就来擦…",
            "nextDialogs": [
              "30010608"
            ]
          },
          "30010608": {
            "id": "30010608",
            "speakerId": 10205,
            "speakerName": "？？？",
            "text": "……",
            "nextDialogs": [
              "30010609"
            ]
          },
          "30010609": {
            "id": "30010609",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "……",
            "nextDialogs": [
              "30010610"
            ]
          },
          "30010610": {
            "id": "30010610",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "等一下，刚刚那是什么？是我的错觉吗？"
          },
          "30010606": {
            "id": "30010606",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "看这座神像的模样，倒是和这个名字挺相称呢。"
          }
        }
      }
    },
    {
      "subId": "300106",
      "subQuestName": "与柯莱汇合",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "30011001"
        ],
        "dialogs": {
          "30011001": {
            "id": "30011001",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "好耶！是什么好吃的呀？",
            "nextDialogs": [
              "30011002"
            ]
          },
          "30011002": {
            "id": "30011002",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "派蒙，矜持一点…",
            "nextDialogs": [
              "30011003"
            ]
          },
          "30011003": {
            "id": "30011003",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "有什么关系嘛，柯莱又不是外人。再说了，食客的热情可是对厨师最好的赞美呢。",
            "nextDialogs": [
              "30011004"
            ]
          },
          "30011004": {
            "id": "30011004",
            "speakerId": 1051,
            "speakerName": "柯莱",
            "text": "今天我带来的是一种巡林员常吃的便携食物，叫做「口袋饼」，不知道合不合你们的胃口。",
            "nextDialogs": [
              "30011005"
            ]
          },
          "30011005": {
            "id": "30011005",
            "speakerId": 1051,
            "speakerName": "柯莱",
            "text": "哇啊…！",
            "nextDialogs": [
              "30011006"
            ]
          },
          "30011006": {
            "id": "30011006",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "糟了，掉在地上了！",
            "nextDialogs": [
              "30011007"
            ]
          },
          "30011007": {
            "id": "30011007",
            "speakerId": 1051,
            "speakerName": "柯莱",
            "text": "没事没事，我在食物外面包了好几层油纸，应该没有弄脏。",
            "nextDialogs": [
              "30011008"
            ]
          },
          "30011008": {
            "id": "30011008",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "呼…刚才真是吓死我了。",
            "nextDialogs": [
              "30011009"
            ]
          },
          "30011009": {
            "id": "30011009",
            "speakerId": 1004,
            "speakerName": "Black Screen",
            "text": "和柯莱一起分享了食物…",
            "nextDialogs": [
              "30011010"
            ]
          },
          "30011010": {
            "id": "30011010",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "真是太好吃啦！柯莱，你的厨艺真好。",
            "nextDialogs": [
              "30011011"
            ]
          },
          "30011011": {
            "id": "30011011",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "幸好你之前把每块饼都仔细包了起来，要不然我肯定会心疼得晚上连觉都睡不着了。",
            "nextDialogs": [
              "30011012"
            ]
          },
          "30011012": {
            "id": "30011012",
            "speakerId": 1051,
            "speakerName": "柯莱",
            "text": "哈哈，这也太夸张了吧…",
            "nextDialogs": [
              "30011013"
            ]
          },
          "30011013": {
            "id": "30011013",
            "speakerId": 1051,
            "speakerName": "柯莱",
            "text": "不过既然你们喜欢，下次我给你们抄一份食谱吧。放心，我会把烹饪要点写上，你们很快就能学会的。",
            "nextDialogs": [
              "30011014"
            ]
          },
          "30011014": {
            "id": "30011014",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "谢谢你柯莱！嘻嘻，真难想象像你这么认真的人，竟然也会有毛手毛脚的时候。",
            "nextDialogs": [
              "30011015"
            ]
          },
          "30011015": {
            "id": "30011015",
            "speakerId": 1051,
            "speakerName": "柯莱",
            "text": "哈哈，可能是有那么一点吧…",
            "nextDialogs": [
              "30011016"
            ]
          },
          "30011016": {
            "id": "30011016",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "不过提纳里对你是不是管得太严了一点？东西都不让你碰…",
            "nextDialogs": [
              "30011017"
            ]
          },
          "30011017": {
            "id": "30011017",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "#我也偶尔会在飞的时候碰倒桌上的东西，但{NICKNAME}从来不会怪我，毕竟谁都会有不小心的时候嘛。",
            "nextDialogs": [
              "30011018"
            ]
          },
          "30011018": {
            "id": "30011018",
            "speakerId": 1051,
            "speakerName": "柯莱",
            "text": "不，不是这样的！如果你们和师父相处的时间更长一点，就会发现他其实是个很好的人。",
            "nextDialogs": [
              "30011019"
            ]
          },
          "30011019": {
            "id": "30011019",
            "speakerId": 1051,
            "speakerName": "柯莱",
            "text": "我听前辈们说，师父来自一个很古老神秘的种族。他们一族都很聪明，大多有些孤僻，但师父却是个很热心肠的人。",
            "nextDialogs": [
              "30011020"
            ]
          },
          "30011020": {
            "id": "30011020",
            "speakerId": 1051,
            "speakerName": "柯莱",
            "text": "对了，你们知道教令院吗，好像是叫做生…生什么派来着？",
            "nextDialogs": [
              "30011021"
            ]
          },
          "30011021": {
            "id": "30011021",
            "speakerId": 1051,
            "speakerName": "柯莱",
            "text": "总之，因为师父对植物很有研究，那个学院的贤者还好几次写信来，让他到教令院去任职。",
            "nextDialogs": [
              "30011022"
            ]
          },
          "30011022": {
            "id": "30011022",
            "speakerId": 1051,
            "speakerName": "柯莱",
            "text": "不过，却被师父以「须弥城太嘈杂对耳朵不好」为由拒绝了。",
            "nextDialogs": [
              "30011024",
              "30011027"
            ]
          },
          "30011024": {
            "id": "30011024",
            "speakerId": 1051,
            "speakerName": "柯莱",
            "text": "哈哈，是啊。不过贤者大人看到信，估计会生气吧。",
            "nextDialogs": [
              "30011025"
            ]
          },
          "30011025": {
            "id": "30011025",
            "speakerId": 1051,
            "speakerName": "柯莱",
            "text": "明明可以去教令院，师父却选择了做巡林官，每天都在为雨林的居民们提供帮助，也会教给下属们各种知识。",
            "nextDialogs": [
              "30011029"
            ]
          },
          "30011029": {
            "id": "30011029",
            "speakerId": 1051,
            "speakerName": "柯莱",
            "text": "就连口袋饼的做法，也是师父教给我的。",
            "nextDialogs": [
              "30011030"
            ]
          },
          "30011030": {
            "id": "30011030",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "真的吗？这我倒是完全没想到。",
            "nextDialogs": [
              "30011031"
            ]
          },
          "30011031": {
            "id": "30011031",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "唔…不过这么说来，昨天提纳里发现你晕倒后，倒是二话不说就对你实施救治，也是他把你背回化城郭的。",
            "nextDialogs": [
              "30011032"
            ]
          },
          "30011032": {
            "id": "30011032",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "不过我还是觉得有点不爽，因为他整整一路上都在拼命数落我呀！",
            "nextDialogs": [
              "30011033"
            ]
          },
          "30011033": {
            "id": "30011033",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "你做了什么？",
            "nextDialogs": [
              "30011034"
            ]
          },
          "30011034": {
            "id": "30011034",
            "speakerId": 1051,
            "speakerName": "柯莱",
            "text": "啊，真不好意思，这件事可能是师父不太对…",
            "nextDialogs": [
              "30011035"
            ]
          },
          "30011035": {
            "id": "30011035",
            "speakerId": 1051,
            "speakerName": "柯莱",
            "text": "#因为派蒙当时不停在喊「怎么办，{M#他}{F#她}是不是要死了？」，怎么劝都没用，把师父给惹毛了。",
            "nextDialogs": [
              "30011036"
            ]
          },
          "30011036": {
            "id": "30011036",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "喂，可恶，你不要笑啊！我还不都是因为关心你！",
            "nextDialogs": [
              "30011037"
            ]
          },
          "30011037": {
            "id": "30011037",
            "speakerId": 1051,
            "speakerName": "柯莱",
            "text": "噗…呵呵呵呵…",
            "nextDialogs": [
              "30011038"
            ]
          },
          "30011038": {
            "id": "30011038",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "怎么回事，为什么连柯莱也——",
            "nextDialogs": [
              "30011039"
            ]
          },
          "30011039": {
            "id": "30011039",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "啊啊啊，气死我啦！我要报复你们！看我把你们的脑袋都揉成鸟窝！",
            "nextDialogs": [
              "30011040"
            ]
          },
          "30011040": {
            "id": "30011040",
            "speakerId": 1051,
            "speakerName": "柯莱",
            "text": "别碰我！！"
          },
          "30011027": {
            "id": "30011027",
            "speakerId": 1051,
            "speakerName": "柯莱",
            "text": "对吧！我也是这么觉得…嗯，咳咳！",
            "nextDialogs": [
              "30011028"
            ]
          },
          "30011028": {
            "id": "30011028",
            "speakerId": 1051,
            "speakerName": "柯莱",
            "text": "总、总而言之，师父明明可以去教令院，却还是做了巡林官，每天都在为雨林的居民们提供帮助，也会教给下属们各种知识。"
          }
        }
      }
    },
    {
      "subId": "300110",
      "subQuestName": "返回化城郭",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "30011101"
        ],
        "dialogs": {
          "30011101": {
            "id": "30011101",
            "speakerId": 4302,
            "speakerName": "娜丝琳",
            "text": "哦，旅行者，你们回来了啊。",
            "nextDialogs": [
              "30011102"
            ]
          },
          "30011102": {
            "id": "30011102",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "你好，请问你看到柯莱了吗？",
            "nextDialogs": [
              "30011103"
            ]
          },
          "30011103": {
            "id": "30011103",
            "speakerId": 4302,
            "speakerName": "娜丝琳",
            "text": "柯莱啊，刚才看见她回房间去了。",
            "nextDialogs": [
              "30011104"
            ]
          },
          "30011104": {
            "id": "30011104",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "这样啊…看来我们只能明天再去找她了。"
          }
        }
      }
    },
    {
      "subId": "300111",
      "subQuestName": "等到第二天8点",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [],
        "dialogs": {}
      }
    },
    {
      "subId": "300107",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "30010701"
        ],
        "dialogs": {
          "30010701": {
            "id": "30010701",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "之前没怎么仔细观察，现在我才发现，这座神像雕刻出的神明，身材很小巧的样子。",
            "nextDialogs": [
              "30010702"
            ]
          },
          "30010702": {
            "id": "30010702",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "唔，你说她究竟是「大慈树王」，还是「小吉祥草王」？",
            "nextDialogs": [
              "30010704",
              "30010706"
            ]
          },
          "30010704": {
            "id": "30010704",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "嗯，很有可能，毕竟这座神像看起来很古老了。",
            "nextDialogs": [
              "30010707"
            ]
          },
          "30010707": {
            "id": "30010707",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "算啦，关于她们的事情，我们以后总会打听到的。",
            "nextDialogs": [
              "30010708"
            ]
          },
          "30010708": {
            "id": "30010708",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "我们来清洁神像吧，我飞到上面去，你就负责擦下面好了。",
            "nextDialogs": [
              "30010709"
            ]
          },
          "30010709": {
            "id": "30010709",
            "speakerId": 1004,
            "speakerName": "Black Screen",
            "text": "和派蒙一起仔细擦拭了神像…"
          },
          "30010706": {
            "id": "30010706",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "看这座神像的模样，倒是和这个名字挺相称的。"
          }
        }
      }
    },
    {
      "subId": "300151",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "30015101"
        ],
        "dialogs": {
          "30015101": {
            "id": "30015101",
            "speakerId": 1051,
            "speakerName": "柯莱",
            "text": "我不太擅长攀爬，神像的清洁就交给你们了。",
            "nextDialogs": [
              "30015102"
            ]
          },
          "30015102": {
            "id": "30015102",
            "speakerId": 1051,
            "speakerName": "柯莱",
            "text": "我去检查一下前面的设施。完工之后，如果可以的话…能和我再多聊聊吗？"
          }
        }
      }
    },
    {
      "subId": "300199",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "30019901"
        ],
        "dialogs": {
          "30019901": {
            "id": "30019901",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "天亮了。走，我们去找柯莱吧。",
            "nextDialogs": [
              "30019906"
            ]
          },
          "30019906": {
            "id": "30019906",
            "speakerId": 1051,
            "speakerName": "柯莱",
            "text": "好，这盏灯也没有问题。",
            "nextDialogs": [
              "30019907"
            ]
          },
          "30019907": {
            "id": "30019907",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "上面就是草神的七天神像，就像之前一样试着触摸一下神像吧。",
            "nextDialogs": [
              "30019908"
            ]
          },
          "30019908": {
            "id": "30019908",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "这次你也一定能获得草神的回应。",
            "nextDialogs": [
              "30019909"
            ]
          },
          "30019909": {
            "id": "30019909",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "神像已经清洁干净了，我们下去和柯莱会合吧。"
          }
        }
      }
    }
  ]
}
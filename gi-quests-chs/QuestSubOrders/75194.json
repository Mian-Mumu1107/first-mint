        "startDialogs": [
          "751940801"
        ],
        "dialogs": {
          "751940801": {
            "id": "751940801",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "等会再说。",
            "nextDialogs": [
              "751940802"
            ]
          },
          "751940802": {
            "id": "751940802",
            "speakerId": 1000,
            "speakerName": "库蕾玛娜",
            "text": "嗯嗯，我这边随时都可以开始。"
          }
        }
      }

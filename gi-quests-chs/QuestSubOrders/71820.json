          "718202301": {
            "id": "718202301",
            "speakerId": 2208,
            "speakerName": "菲尔戈黛特",
            "text": "唉，一到过节就忙得不可开交…"
          }
        }
      }
    },
    {
      "subId": "7182001",
      "subQuestName": "前往望舒客栈转转",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [],
        "dialogs": {}
      }
    },
    {
      "subId": "7182002",
      "subQuestName": "与老板对话",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "718200201"
        ],
        "dialogs": {
          "718200201": {
            "id": "718200201",
            "speakerId": 2208,
            "speakerName": "菲尔戈黛特",
            "text": "果然每年过节的时候都格外忙啊…",
            "nextDialogs": [
              "718200202"
            ]
          },
          "718200202": {
            "id": "718200202",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "怎么了？",
            "nextDialogs": [
              "718200203"
            ]
          },
          "718200203": {
            "id": "718200203",
            "speakerId": 2208,
            "speakerName": "菲尔戈黛特",
            "text": "还是客栈里的事，很多人都回去过海灯节了，客栈里的人手实在不足…",
            "nextDialogs": [
              "718200204"
            ]
          },
          "718200204": {
            "id": "718200204",
            "speakerId": 2208,
            "speakerName": "菲尔戈黛特",
            "text": "又要招呼客人，又要打扮客栈，还得准备点东西过节…",
            "nextDialogs": [
              "718200205"
            ]
          },
          "718200205": {
            "id": "718200205",
            "speakerId": 2208,
            "speakerName": "菲尔戈黛特",
            "text": "还有平常的一些事也不能搁置了…言笑都要忙不过来了…",
            "nextDialogs": [
              "718200206"
            ]
          },
          "718200206": {
            "id": "718200206",
            "speakerId": 2208,
            "speakerName": "菲尔戈黛特",
            "text": "旅行者，如果你愿意的话，能去帮他一下吗？",
            "nextDialogs": [
              "718200207"
            ]
          },
          "718200207": {
            "id": "718200207",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "交给我吧。",
            "nextDialogs": [
              "718200208"
            ]
          },
          "718200208": {
            "id": "718200208",
            "speakerId": 2208,
            "speakerName": "菲尔戈黛特",
            "text": "那就拜托你了，言笑就在厨房里，你直接去找他就好。",
            "nextDialogs": [
              "718200209"
            ]
          },
          "718200209": {
            "id": "718200209",
            "speakerId": 2208,
            "speakerName": "菲尔戈黛特",
            "text": "我还得在这处理一点事…"
          }
        }
      }
    },
    {
      "subId": "7182003",
      "subQuestName": "前往探望言笑",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "718200301"
        ],
        "dialogs": {
          "718200301": {
            "id": "718200301",
            "speakerId": 2204,
            "speakerName": "言笑",
            "text": "谁啊！不要随便…哦，是你啊…",
            "nextDialogs": [
              "718200302"
            ]
          },
          "718200302": {
            "id": "718200302",
            "speakerId": 2204,
            "speakerName": "言笑",
            "text": "有什么事吗？要点菜的话估计得等会了，我这正忙着呢。",
            "nextDialogs": [
              "718200305"
            ]
          },
          "718200305": {
            "id": "718200305",
            "speakerId": 2204,
            "speakerName": "言笑",
            "text": "你是来帮忙的？哦…那敢情好，我正好有一堆事要做…",
            "nextDialogs": [
              "718200306"
            ]
          },
          "718200306": {
            "id": "718200306",
            "speakerId": 2204,
            "speakerName": "言笑",
            "text": "你先去客栈下面，帮我把刚送过来的那些烹饪用材料拿上来，我急着要用。",
            "nextDialogs": [
              "718200307"
            ]
          },
          "718200307": {
            "id": "718200307",
            "speakerId": 2204,
            "speakerName": "言笑",
            "text": "然后，再顺便把这些霄灯挂到客栈门口的那两棵树上去…掌柜的念叨这事好久了…"
          }
        }
      }
    },

    {
      "subId": "7182015",
      "subQuestName": "和言笑对话",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "718201501"
        ],
        "dialogs": {
          "718201501": {
            "id": "718201501",
            "speakerId": 2204,
            "speakerName": "言笑",
            "text": "怎么样，事情都弄好了吗？",
            "nextDialogs": [
              "718201502"
            ]
          },
          "718201502": {
            "id": "718201502",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "都搞定了。",
            "nextDialogs": [
              "718201503"
            ]
          },
          "718201503": {
            "id": "718201503",
            "speakerId": 2204,
            "speakerName": "言笑",
            "text": "谢了，真是帮大忙了，我得赶紧把这几道菜给弄完，免得客人们等急了…"
          }
        }
      }
    },
    {
      "subId": "7182016",
      "subQuestName": "和老板对话",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "718201601"
        ],
        "dialogs": {
          "718201601": {
            "id": "718201601",
            "speakerId": 2208,
            "speakerName": "菲尔戈黛特",
            "text": "你回来了，言笑那边…",
            "nextDialogs": [
              "718201602"
            ]
          },
          "718201602": {
            "id": "718201602",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "现在应该轻松一些了。",
            "nextDialogs": [
              "718201603"
            ]
          },
          "718201603": {
            "id": "718201603",
            "speakerId": 2208,
            "speakerName": "菲尔戈黛特",
            "text": "那就好，那就好，谢谢你帮忙…",
            "nextDialogs": [
              "718201604"
            ]
          },
          "718201604": {
            "id": "718201604",
            "speakerId": 30039,
            "speakerName": "望雅",
            "text": "这里也没有啊…",
            "nextDialogs": [
              "718201607"
            ]
          },
          "718201607": {
            "id": "718201607",
            "speakerId": 30039,
            "speakerName": "望雅",
            "text": "旅行者？真是巧了，没想到能在这里遇见你…",
            "nextDialogs": [
              "718201608"
            ]
          },
          "718201608": {
            "id": "718201608",
            "speakerId": 30039,
            "speakerName": "望雅",
            "text": "送霄灯…算是吧，你知道轻策庄吗？那边离城里很远，里面住的居民也大多是老人和孩子。",
            "nextDialogs": [
              "718201609"
            ]
          },
          "718201609": {
            "id": "718201609",
            "speakerId": 30039,
            "speakerName": "望雅",
            "text": "所以每年海灯节的时候，总务司也会特别派人过去，给他们带一些节日用品。",
            "nextDialogs": [
              "718201610"
            ]
          },
          "718201610": {
            "id": "718201610",
            "speakerId": 30039,
            "speakerName": "望雅",
            "text": "第一批物资已经送过去了，但我还想再做点什么，让轻策庄里更有节日的氛围。",
            "nextDialogs": [
              "718201611"
            ]
          },
          "718201611": {
            "id": "718201611",
            "speakerId": 30039,
            "speakerName": "望雅",
            "text": "所以，我去请了那位诗人清昼，他答应我会准备一些灯谜去轻策庄里陪孩子们玩。"
          }
        }
      }
    },

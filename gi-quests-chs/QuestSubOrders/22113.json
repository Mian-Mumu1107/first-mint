    {
      "subId": "2211305",
      "subQuestName": "与淮安对话",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "221130501"
        ],
        "dialogs": {
          "221130501": {
            "id": "221130501",
            "speakerId": 1000,
            "speakerName": "淮安",
            "text": "这下子全部都修好了，怎么样，我的手艺还不错吧。",
            "nextDialogs": [
              "221130502"
            ]
          },
          "221130502": {
            "id": "221130502",
            "speakerId": 1000,
            "speakerName": "淮安",
            "text": "这样客栈的客人们也方便多了。哈哈哈。",
            "nextDialogs": [
              "221130503"
            ]
          },
          "221130503": {
            "id": "221130503",
            "speakerId": 1000,
            "speakerName": "淮安",
            "text": "对了，这些您拿好，实在是辛苦您了。",
            "nextDialogs": [
              "221130504"
            ]
          },
          "221130504": {
            "id": "221130504",
            "speakerId": 1000,
            "speakerName": "淮安",
            "text": "您有空的话，可以多来坐坐，喝杯茶，吃点点心，我们这厨子的手艺，还是不错的。"
          }
        }
      }
    }
  ]

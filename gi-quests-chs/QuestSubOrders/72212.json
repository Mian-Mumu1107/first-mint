  },
  "subQuests": [
    {
      "subId": "7221201",
      "subQuestName": "test 与寝子对话 隐藏$HIDDEN",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "722120101"
        ],
        "dialogs": {
          "722120101": {
            "id": "722120101",
            "speakerId": 1000,
            "speakerName": "「寝子」",
            "text": "汝等来得正好，来帮奴家做件事吧。",
            "nextDialogs": [
              "722120102"
            ]
          },
          "722120102": {
            "id": "722120102",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "什么事？",
            "nextDialogs": [
              "722120103"
            ]
          },
          "722120103": {
            "id": "722120103",
            "speakerId": 1000,
            "speakerName": "「寝子」",
            "text": "奴家想要…",
            "nextDialogs": [
              "722120104"
            ]
          },
          "722120104": {
            "id": "722120104",
            "speakerId": 1000,
            "speakerName": "「寝子」",
            "text": "在神社旁边，放一块很高很高，很大很大，和奴家一个样子的石头。",
            "nextDialogs": [
              "722120105"
            ]
          },
          "722120105": {
            "id": "722120105",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "上、上哪找这样的石头…",
            "nextDialogs": [
              "722120106"
            ]
          },
          "722120106": {
            "id": "722120106",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "是说雕像对吧。",
            "nextDialogs": [
              "722120107"
            ]
          },
          "722120107": {
            "id": "722120107",
            "speakerId": 1000,
            "speakerName": "「寝子」",
            "text": "总之，奴家要的东西，和好远好远的那个岛上的狐狸石头一样。",
            "nextDialogs": [
              "722120108"
            ]
          },
          "722120108": {
            "id": "722120108",
            "speakerId": 1000,
            "speakerName": "「寝子」",
            "text": "阿响说过，在那个岛上，有好多狐狸石头，还说，要不要给奴家也弄一个。",
            "nextDialogs": [
              "722120109"
            ]
          },
          "722120109": {
            "id": "722120109",
            "speakerId": 1000,
            "speakerName": "「寝子」",
            "text": "奴家觉得，阿响想要的，一定是好的。所以，汝等帮忙弄个石头吧。",
            "nextDialogs": [
              "722120111",
              "722120114"
            ]
          },
          "722120111": {
            "id": "722120111",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "唔，要怎么办呢…",
            "nextDialogs": [
              "722120112"
            ]
          },
          "722120112": {
            "id": "722120112",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "对了，去找大祐吧！他这么喜欢猫，说不定能为了寝子学会雕刻。"
          },
          "722120114": {
            "id": "722120114",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "有道理！他这么喜欢猫，说不定能帮得上忙。"
          }
        }
      }
    },
    {
      "subId": "7221202",
      "subQuestName": "询问大祐和悦子",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "722120201"
        ],
        "dialogs": {
          "722120201": {
            "id": "722120201",
            "speakerId": 1002,
            "speakerName": "大祐",
            "text": "喔！你好，今天又在忙什么呢？",
            "nextDialogs": [
              "722120202"
            ]
          },
          "722120202": {
            "id": "722120202",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "帮寝子做雕像。",
            "nextDialogs": [
              "722120203"
            ]
          },
          "722120203": {
            "id": "722120203",
            "speakerId": 1002,
            "speakerName": "大祐",
            "text": "哈…哈？做雕像，在这里？真的吗？",
            "nextDialogs": [
              "722120204"
            ]
          },
          "722120204": {
            "id": "722120204",
            "speakerId": 1002,
            "speakerName": "大祐",
            "text": "我、我这就去学雕刻技术！",
            "nextDialogs": [
              "722120205"
            ]
          },
          "722120205": {
            "id": "722120205",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "来、来不及吧…",
            "nextDialogs": [
              "722120206"
            ]
          },
          "722120206": {
            "id": "722120206",
            "speakerId": 1003,
            "speakerName": "悦子",
            "text": "又是那位寝子拜托你的吗？",
            "nextDialogs": [
              "722120207"
            ]
          },
          "722120207": {
            "id": "722120207",
            "speakerId": 1003,
            "speakerName": "悦子",
            "text": "说起来，因为踏鞴砂那边的问题，很多工匠都在找工作。",
            "nextDialogs": [
              "722120208"
            ]
          },
          "722120208": {
            "id": "722120208",
            "speakerId": 1003,
            "speakerName": "悦子",
            "text": "协会之前接到过不少相关的委托，据我所知，有人似乎还留在踏鞴砂附近，一直在找工作。",
            "nextDialogs": [
              "722120209"
            ]
          },
          "722120209": {
            "id": "722120209",
            "speakerId": 1003,
            "speakerName": "悦子",
            "text": "我之前去执行协会委托的时候，也见到了一个类似的营地。",
            "nextDialogs": [
              "722120210"
            ]
          },
          "722120210": {
            "id": "722120210",
            "speakerId": 1003,
            "speakerName": "悦子",
            "text": "如果你们愿意的话，倒是可以去那边碰碰运气。",
            "nextDialogs": [
              "722120214",
              "722120213"
            ]
          },
          "722120214": {
            "id": "722120214",
            "speakerId": 1003,
            "speakerName": "悦子",
            "text": "呵呵…不用在意，只不过是举手之劳而已。",
            "nextDialogs": [
              "722120215"
            ]
          },
          "722120215": {
            "id": "722120215",
            "speakerId": 1003,
            "speakerName": "悦子",
            "text": "我也很想看看，这座神社如果真能热闹起来的话…会发生什么。",
            "nextDialogs": [
              "722120216"
            ]
          },
          "722120216": {
            "id": "722120216",
            "speakerId": 1003,
            "speakerName": "悦子",
            "text": "特别是那位「阿响」…到底是一位怎么样的人，能让那位寝子这么在意呢？",
            "nextDialogs": [
              "722120217"
            ]
          },
          "722120217": {
            "id": "722120217",
            "speakerId": 1003,
            "speakerName": "悦子",
            "text": "好了，你也别在这听我自言自语了，快去找工匠吧。",
            "nextDialogs": [
              "722120218"
            ]
          },
          "722120218": {
            "id": "722120218",
            "speakerId": 1003,
            "speakerName": "悦子",
            "text": "至于你们找到的工匠会不会雕石雕…呵呵，那就全凭你们的运气了。",
            "nextDialogs": [
              "722120219"
            ]
          },
          "722120219": {
            "id": "722120219",
            "speakerId": 1002,
            "speakerName": "大祐",
            "text": "悦子小姐，其实你也是想帮帮寝子大人对吧？哈哈哈，你可真是…",
            "nextDialogs": [
              "722120220"
            ]
          },
          "722120220": {
            "id": "722120220",
            "speakerId": 1003,
            "speakerName": "悦子",
            "text": "大祐，调查计划写好了没有？",
            "nextDialogs": [
              "722120221"
            ]
          },
          "722120221": {
            "id": "722120221",
            "speakerId": 1002,
            "speakerName": "大祐",
            "text": "呃！马、马上就好，实在对不起…"
          },
          "722120213": {
            "id": "722120213",
            "speakerId": 1003,
            "speakerName": "悦子",
            "text": "怎么？我这么主动地给你们信息，你有些不习惯吗？"
          }
        }
      }
    },
    {
      "subId": "7221203",
      "subQuestName": "前往踏鞴砂，寻找工匠",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "722120301"
        ],
        "dialogs": {
          "722120301": {
            "id": "722120301",
            "speakerId": 1004,
            "speakerName": "？？？",
            "text": "唉，到底什么时候才能找到工作…",
            "nextDialogs": [
              "722120302"
            ]
          },
          "722120302": {
            "id": "722120302",
            "speakerId": 1004,
            "speakerName": "？？？",
            "text": "你们…是来找我的吗？有什么事？",
            "nextDialogs": [
              "722120305"
            ]
          },
          "722120305": {
            "id": "722120305",
            "speakerId": 1004,
            "speakerName": "？？？",
            "text": "咦？那…那太好了！",
            "nextDialogs": [
              "722120306"
            ]
          },
          "722120306": {
            "id": "722120306",
            "speakerId": 1004,
            "speakerName": "？？？",
            "text": "我都忘了自我介绍了…我叫大岛纯平，之前是在踏鞴砂干活的。",
            "nextDialogs": [
              "722120307"
            ]
          },
          "722120307": {
            "id": "722120307",
            "speakerId": 1005,
            "speakerName": "大岛纯平",
            "text": "出了意外之后，我和其他人也都被疏散了出去。",
            "nextDialogs": [
              "722120308"
            ]
          },
          "722120308": {
            "id": "722120308",
            "speakerId": 1005,
            "speakerName": "大岛纯平",
            "text": "但是…到现在我也没有接到复工的消息，就这么一直闲在这里。",
            "nextDialogs": [
              "722120309"
            ]
          },
          "722120309": {
            "id": "722120309",
            "speakerId": 1005,
            "speakerName": "大岛纯平",
            "text": "你们是在找做石雕的人对吧？我会一点石雕的手艺，虽然不是特别专业…",
            "nextDialogs": [
              "722120310"
            ]
          },
          "722120310": {
            "id": "722120310",
            "speakerId": 1005,
            "speakerName": "大岛纯平",
            "text": "你们要做怎么样的石雕？能告诉我吗？",
            "nextDialogs": [
              "722120311"
            ]
          },
          "722120311": {
            "id": "722120311",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "是这样的…",
            "nextDialogs": [
              "722120312"
            ]
          },
          "722120312": {
            "id": "722120312",
            "speakerId": 1005,
            "speakerName": "大岛纯平",
            "text": "呃，会说话的猫，要你们找一个工匠，帮它雕一座石雕？",
            "nextDialogs": [
              "722120313"
            ]
          },
          "722120313": {
            "id": "722120313",
            "speakerId": 1005,
            "speakerName": "大岛纯平",
            "text": "不、不是我不相信，是这件事实在有点…有点离谱…",
            "nextDialogs": [
              "722120314"
            ]
          },
          "722120314": {
            "id": "722120314",
            "speakerId": 1005,
            "speakerName": "大岛纯平",
            "text": "其他的不论，就算我答应了你们，那…那位「代宫司」大人，怎么支付报酬呢？我可不能做白工啊。",
            "nextDialogs": [
              "722120315"
            ]
          },
          "722120315": {
            "id": "722120315",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "放心吧。",
            "nextDialogs": [
              "722120316"
            ]
          },
          "722120316": {
            "id": "722120316",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "（真、真的可以放心吗…）",
            "nextDialogs": [
              "722120317"
            ]
          },
          "722120317": {
            "id": "722120317",
            "speakerId": 1005,
            "speakerName": "大岛纯平",
            "text": "这样啊，这…我总觉得你们在骗我…",
            "nextDialogs": [
              "722120318"
            ]
          },
          "722120318": {
            "id": "722120318",
            "speakerId": 1005,
            "speakerName": "大岛纯平",
            "text": "但是…算了，闲着也是闲着，我就和你们走一趟吧。",
            "nextDialogs": [
              "722120319"
            ]
          },
          "722120319": {
            "id": "722120319",
            "speakerId": 1005,
            "speakerName": "大岛纯平",
            "text": "希望对方真的能支付报酬…"
          }
        }
      }
    },
    {
      "subId": "7221204",
      "subQuestName": "与工匠对话",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [],
        "dialogs": {}
      }
    },
    {
      "subId": "7221205",
      "subQuestName": "和大岛纯平一起向寝子回报",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "722120601"
        ],
        "dialogs": {
          "722120601": {
            "id": "722120601",
            "speakerId": 1000,
            "speakerName": "「寝子」",
            "text": "不过，奴家还是很好奇。石头那么硬的东西，怎么会变成奴家的样子呢？",
            "nextDialogs": [
              "722120602"
            ]
          },
          "722120602": {
            "id": "722120602",
            "speakerId": 1000,
            "speakerName": "「寝子」",
            "text": "那个石头人类，是不是很厉害？是不是会什么妖术？",
            "nextDialogs": [
              "722120604",
              "722120606"
            ]
          },
          "722120604": {
            "id": "722120604",
            "speakerId": 1000,
            "speakerName": "「寝子」",
            "text": "原来如此，奴家很是期待哪。"
          },
          "722120606": {
            "id": "722120606",
            "speakerId": 1000,
            "speakerName": "「寝子」",
            "text": "原来如此，奴家明白了。汝做的饭和阿响做的饭，都是好东西。所以，石头人类做的石头，也是好东西。",
            "nextDialogs": [
              "722120607"
            ]
          },
          "722120607": {
            "id": "722120607",
            "speakerId": 1000,
            "speakerName": "「寝子」",
            "text": "人类有时候真厉害哪。这次，也谢谢汝了。"
          }
        }
      }
    },
    {
      "subId": "7221204",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "722120401"
        ],
        "dialogs": {
          "722120401": {
            "id": "722120401",
            "speakerId": 1000,
            "speakerName": "「寝子」",
            "text": "汝等回来了。这个人类想必便是石头人类，对吧。",
            "nextDialogs": [
              "722120404"
            ]
          },
          "722120404": {
            "id": "722120404",
            "speakerId": 1005,
            "speakerName": "大岛纯平",
            "text": "欸？欸！猫…猫说话了！",
            "nextDialogs": [
              "722120405"
            ]
          },
          "722120405": {
            "id": "722120405",
            "speakerId": 1000,
            "speakerName": "「寝子」",
            "text": "喵喵喵，汝可真是大惊小怪啊…奴家会说话很奇怪吗？"
          }
        }
      }
    },
    {
      "subId": "7221205",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "722120501"
        ],
        "dialogs": {
          "722120501": {
            "id": "722120501",
            "speakerId": 1000,
            "speakerName": "「寝子」",
            "text": "石头的事情，就交给汝等了。"
          }
        }
      }
    },
    {
      "subId": "7221299",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "722129901"
        ],
        "dialogs": {
          "722129901": {
            "id": "722129901",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "看前面，那就是悦子小姐给我们标注的营地了，里面还真有人！",
            "nextDialogs": [
              "722129902"
            ]
          },
          "722129902": {
            "id": "722129902",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "我们快上去问问吧，希望他会雕石雕…"
          }
        }
      }
    }
  ]
}
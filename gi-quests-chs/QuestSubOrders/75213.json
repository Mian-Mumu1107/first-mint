    {
      "subId": "7521301",
      "subQuestName": "(test)隐藏$HIDDEN",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "752130201"
        ],
        "dialogs": {
          "752130201": {
            "id": "752130201",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "需要帮忙吗？",
            "nextDialogs": [
              "752130202"
            ]
          },
          "752130202": {
            "id": "752130202",
            "speakerId": 6607,
            "speakerName": "哈雅库",
            "text": "欸？可以吗？小店的员工已经全派出去了，现在还有一份加急的外送订单。",
            "nextDialogs": [
              "752130203"
            ]
          },
          "752130203": {
            "id": "752130203",
            "speakerId": 6607,
            "speakerName": "哈雅库",
            "text": "订单上备注了送给一位<color=#00E1FFFF>沙滩上的蓝裤子客人</color>，只要及时送到就好。",
            "nextDialogs": [
              "752130204"
            ]
          },
          "752130204": {
            "id": "752130204",
            "speakerId": 6607,
            "speakerName": "哈雅库",
            "text": "实在感谢，除了这笔订单的外送费以外，小店的饮料配方也送给你当作酬金，就拜托了！"
          }
        }
      }
    },

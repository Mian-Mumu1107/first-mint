    {
      "subId": "7521304",
      "subQuestName": "(test)隐藏$HIDDEN",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "752130601"
        ],
        "dialogs": {
          "752130601": {
            "id": "752130601",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "你好，你的饮料到了。",
            "nextDialogs": [
              "752130607"
            ]
          },
          "752130607": {
            "id": "752130607",
            "speakerId": 6623,
            "speakerName": "阿考",
            "text": "噢！噢！原来你们是送饮料的啊，我说怎么这么半天没有收到。",
            "nextDialogs": [
              "752130608"
            ]
          },
          "752130608": {
            "id": "752130608",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "都怪你啦，在订单上留下「送给沙滩上蓝裤子客人」的备注，却偷偷躲在沙子里，害我们找了蓝裤子大半天。",
            "nextDialogs": [
              "752130609"
            ]
          },
          "752130609": {
            "id": "752130609",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "你应该给我们加倍的外送费！",
            "nextDialogs": [
              "752130610"
            ]
          },
          "752130610": {
            "id": "752130610",
            "speakerId": 6623,
            "speakerName": "阿考",
            "text": "啊，实在对不起，我忘记了这件事，我应该把裤子摆在一边，这样可能方便你们找到我。",
            "nextDialogs": [
              "752130611"
            ]
          },
          "752130611": {
            "id": "752130611",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "你为什么要埋在沙子里？",
            "nextDialogs": [
              "752130612"
            ]
          },
          "752130612": {
            "id": "752130612",
            "speakerId": 6623,
            "speakerName": "阿考",
            "text": "因为很有趣啊，我听说很多人度假的时候都会这么干，所以也想试试。",
            "nextDialogs": [
              "752130613"
            ]
          },
          "752130613": {
            "id": "752130613",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "可你的姿势不太对吧，你看起来像是萝卜扎在地里。",
            "nextDialogs": [
              "752130614"
            ]
          },
          "752130614": {
            "id": "752130614",
            "speakerId": 6623,
            "speakerName": "阿考",
            "text": "欸？这样会有什么坏处吗？",
            "nextDialogs": [
              "752130615"
            ]
          },
          "752130615": {
            "id": "752130615",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "容易绊倒别人，自己也会受伤。",
            "nextDialogs": [
              "752130617"
            ]
          },
          "752130617": {
            "id": "752130617",
            "speakerId": 6623,
            "speakerName": "阿考",
            "text": "明白了，我会考虑的，噢，这是你们的加倍外送费，谢谢！"
          }
        }
      }
    },
    {

{
  "lineCounts": {
    "Player": 18,
    "奥古斯都·洛夫莱斯": 72,
    "派蒙": 1
  },
  "subQuests": [
    {
      "subId": "7335001",
      "subQuestName": "与奥古斯都对话",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "733500101"
        ],
        "dialogs": {
          "733500101": {
            "id": "733500101",
            "speakerId": 4456,
            "speakerName": "奥古斯都·洛夫莱斯",
            "text": "啊…阿嚏！这些香料的味道真是太…啊…阿嚏！",
            "nextDialogs": [
              "733500102"
            ]
          },
          "733500102": {
            "id": "733500102",
            "speakerId": 4456,
            "speakerName": "奥古斯都·洛夫莱斯",
            "text": "还是快点留个影，回去屋里待着吧…",
            "nextDialogs": [
              "733500103"
            ]
          },
          "733500103": {
            "id": "733500103",
            "speakerId": 4456,
            "speakerName": "奥古斯都·洛夫莱斯",
            "text": "旅行者，嗨，旅行者！请您留步！",
            "nextDialogs": [
              "733500106"
            ]
          },
          "733500106": {
            "id": "733500106",
            "speakerId": 4456,
            "speakerName": "奥古斯都·洛夫莱斯",
            "text": "我想请您帮我在这里留个影，一张就好，不会花多长时间的。",
            "nextDialogs": [
              "733500109"
            ]
          },
          "733500109": {
            "id": "733500109",
            "speakerId": 4456,
            "speakerName": "奥古斯都·洛夫莱斯",
            "text": "这地方的香料味道对我来说，实在是太刺激了…",
            "nextDialogs": [
              "733500110"
            ]
          },
          "733500110": {
            "id": "733500110",
            "speakerId": 4456,
            "speakerName": "奥古斯都·洛夫莱斯",
            "text": "我在枫丹的时候，吃的菜里可是连一点辣味都不能有，最多放一点盐。",
            "nextDialogs": [
              "733500111"
            ]
          },
          "733500111": {
            "id": "733500111",
            "speakerId": 4456,
            "speakerName": "奥古斯都·洛夫莱斯",
            "text": "在这里，我喷嚏打得连…阿嚏！连留影机都要拿不稳了…",
            "nextDialogs": [
              "733500112"
            ]
          },
          "733500112": {
            "id": "733500112",
            "speakerId": 4456,
            "speakerName": "奥古斯都·洛夫莱斯",
            "text": "所以，我只能拜托…拜托其他人帮我留影。",
            "nextDialogs": [
              "733500113"
            ]
          },
          "733500113": {
            "id": "733500113",
            "speakerId": 4456,
            "speakerName": "奥古斯都·洛夫莱斯",
            "text": "您看上去就是个好心肠的人，所以…我就想请您来帮我这个忙。",
            "nextDialogs": [
              "733500114"
            ]
          },
          "733500114": {
            "id": "733500114",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "你来自枫丹？",
            "nextDialogs": [
              "733500115"
            ]
          },
          "733500115": {
            "id": "733500115",
            "speakerId": 4456,
            "speakerName": "奥古斯都·洛夫莱斯",
            "text": "没错，我都忘记自我介绍了，真是抱歉…",
            "nextDialogs": [
              "733500116"
            ]
          },
          "733500116": {
            "id": "733500116",
            "speakerId": 4456,
            "speakerName": "奥古斯都·洛夫莱斯",
            "text": "我的名字是奥古斯都·洛夫莱斯，「枫丹动能工程科学研究院」的一名研究员。"
          }
        }
      }
    },
    {
      "subId": "7335002",
      "subQuestName": "拍摄画片",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "733500201"
        ],
        "dialogs": {
          "733500201": {
            "id": "733500201",
            "speakerId": 4456,
            "speakerName": "奥古斯都·洛夫莱斯",
            "text": "您帮我拍完画片了吗？",
            "nextDialogs": [
              "733500202"
            ]
          },
          "733500202": {
            "id": "733500202",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "还没有。",
            "nextDialogs": [
              "733500203"
            ]
          },
          "733500203": {
            "id": "733500203",
            "speakerId": 4456,
            "speakerName": "奥古斯都·洛夫莱斯",
            "text": "唔，您慢慢来，拍摄画片确实不是一件简单的事。"
          }
        }
      }
    },
    {
      "subId": "7335003",
      "subQuestName": "向奥古斯都回报",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "733500301"
        ],
        "dialogs": {
          "733500301": {
            "id": "733500301",
            "speakerId": 4456,
            "speakerName": "奥古斯都·洛夫莱斯",
            "text": "这画片真不错，您在留影方面很有天赋。",
            "nextDialogs": [
              "733500302"
            ]
          },
          "733500302": {
            "id": "733500302",
            "speakerId": 4456,
            "speakerName": "奥古斯都·洛夫莱斯",
            "text": "自从开始旅行以来，对于构图与色彩把握有如此水准的人，我还是第一次见呢。",
            "nextDialogs": [
              "733500303"
            ]
          },
          "733500303": {
            "id": "733500303",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "你都到过什么地方？",
            "nextDialogs": [
              "733500304"
            ]
          },
          "733500304": {
            "id": "733500304",
            "speakerId": 4456,
            "speakerName": "奥古斯都·洛夫莱斯",
            "text": "这个啊，嗯…我本来可以直接从枫丹到须弥。毕竟枫丹有一条航线直通须弥的拜达港嘛。",
            "nextDialogs": [
              "733500312"
            ]
          },
          "733500312": {
            "id": "733500312",
            "speakerId": 4456,
            "speakerName": "奥古斯都·洛夫莱斯",
            "text": "但俗话说，旅行最重要的是过程嘛，所以我还是选择了一条…更具有趣味性的旅游路线。",
            "nextDialogs": [
              "733500313"
            ]
          },
          "733500313": {
            "id": "733500313",
            "speakerId": 4456,
            "speakerName": "奥古斯都·洛夫莱斯",
            "text": "首先，我先通过柔灯港来到了沉玉谷，并途经轻策庄到达了分隔蒙德与璃月的石门。",
            "nextDialogs": [
              "733500310"
            ]
          },
          "733500310": {
            "id": "733500310",
            "speakerId": 4456,
            "speakerName": "奥古斯都·洛夫莱斯",
            "text": "在拜访晨曦酒庄以后，我还是决定南下到璃月港看看。",
            "nextDialogs": [
              "733500305"
            ]
          },
          "733500305": {
            "id": "733500305",
            "speakerId": 4456,
            "speakerName": "奥古斯都·洛夫莱斯",
            "text": "在璃月港我搭上了去奥摩斯港的渡船，再经河道北上，就来到了这里，遇到了您。",
            "nextDialogs": [
              "733500306"
            ]
          },
          "733500306": {
            "id": "733500306",
            "speakerId": 4456,
            "speakerName": "奥古斯都·洛夫莱斯",
            "text": "毕竟，这次旅行的动机还是散心。倘若我是个热衷冒险的勇士…",
            "nextDialogs": [
              "733500311"
            ]
          },
          "733500311": {
            "id": "733500311",
            "speakerId": 4456,
            "speakerName": "奥古斯都·洛夫莱斯",
            "text": "或许我会乐意从海露港出发，走走古代的朝圣之路，向南深入沙漠吧。",
            "nextDialogs": [
              "733500307"
            ]
          },
          "733500307": {
            "id": "733500307",
            "speakerId": 4456,
            "speakerName": "奥古斯都·洛夫莱斯",
            "text": "…谁知道呢？或许返程时，我会试试穿越大沙漠。这么说来，现在经费还很充足，或许穿越沙漠去纳塔看看也不错…",
            "nextDialogs": [
              "733500308"
            ]
          },
          "733500308": {
            "id": "733500308",
            "speakerId": 4456,
            "speakerName": "奥古斯都·洛夫莱斯",
            "text": "好了，不耽误您的时间了。感谢您帮我留影，这些报酬请您收下。",
            "nextDialogs": [
              "733500309"
            ]
          },
          "733500309": {
            "id": "733500309",
            "speakerId": 4456,
            "speakerName": "奥古斯都·洛夫莱斯",
            "text": "我得赶紧去给泽维尔写信了，他再不来须弥，我就要回枫丹了…"
          }
        }
      }
    },

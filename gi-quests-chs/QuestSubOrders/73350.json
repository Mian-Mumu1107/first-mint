          },
          "733500414": {
            "id": "733500414",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "你来自枫丹？",
            "nextDialogs": [
              "733500415"
            ]
          },
          "733500415": {
            "id": "733500415",
            "speakerId": 4456,
            "speakerName": "奥古斯都·洛夫莱斯",
            "text": "没错，我都忘记自我介绍了，真是抱歉…",
            "nextDialogs": [
              "733500416"
            ]
          },
          "733500416": {
            "id": "733500416",
            "speakerId": 4456,
            "speakerName": "奥古斯都·洛夫莱斯",
            "text": "我的名字是奥古斯都·洛夫莱斯，「枫丹动能工程科学研究院」的一名研究员。"
          },
          "733500407": {
            "id": "733500407",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "旁边有那么多人呢。",
            "nextDialogs": [
              "733500408"
            ]
          },
          "733500408": {
            "id": "733500408",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "你怎么只叫住我了？"
          }
        }
      }
    },
    {
      "subId": "7335099",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "733509901"
        ],
        "dialogs": {
          "733509901": {
            "id": "733509901",
            "speakerId": 4456,
            "speakerName": "奥古斯都·洛夫莱斯",
            "text": "（唉，泽维尔是不是被那群稻妻人影响太深了？反正「社奉行」里的人也绝对不懂「映影」…）",
            "nextDialogs": [
              "733509902"
            ]
          },
          "733509902": {
            "id": "733509902",
            "speakerId": 4456,
            "speakerName": "奥古斯都·洛夫莱斯",
            "text": "（他就不能随便拍一段「映影」给「社奉行」，赶紧交差走人吗…）",
            "nextDialogs": [
              "733509903"
            ]
          },
          "733509903": {
            "id": "733509903",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "这样应该就算是拍好了，我们快把画片拿给那个人吧。"
          }
        }
      }
    }

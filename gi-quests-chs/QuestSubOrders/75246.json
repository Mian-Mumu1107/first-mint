  },
  "subQuests": [
    {
      "subId": "7524601",
      "subQuestName": "(test)隐藏$HIDDEN",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "752460101"
        ],
        "dialogs": {
          "752460101": {
            "id": "752460101",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "#{NICKNAME}，快看那边，有人在呢！",
            "nextDialogs": [
              "752460102"
            ]
          },
          "752460102": {
            "id": "752460102",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "唔？这两个背影是…",
            "nextDialogs": [
              "752460103"
            ]
          },
          "752460103": {
            "id": "752460103",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "欧洛伦和伊法！",
            "nextDialogs": [
              "752460104"
            ]
          },
          "752460104": {
            "id": "752460104",
            "speakerId": 1094,
            "speakerName": "欧洛伦",
            "text": "#熟悉的声音，是{M#爷爷}{F#奶奶}和派蒙。",
            "nextDialogs": [
              "752460105"
            ]
          },
          "752460105": {
            "id": "752460105",
            "speakerId": 14977,
            "speakerName": "咔库库",
            "text": "噢哥们！",
            "nextDialogs": [
              "752460106"
            ]
          },
          "752460106": {
            "id": "752460106",
            "speakerId": 1307,
            "speakerName": "伊法",
            "text": "好久不见，你们也来度假村了啊。",
            "nextDialogs": [
              "752460107"
            ]
          },
          "752460107": {
            "id": "752460107",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "恰斯卡说过你们来度假村工作的事，没想到突然就遇到啦。",
            "nextDialogs": [
              "752460108"
            ]
          },
          "752460108": {
            "id": "752460108",
            "speakerId": 1307,
            "speakerName": "伊法",
            "text": "是啊，这里氛围不错，听说大家都玩得很开心。",
            "nextDialogs": [
              "752460109"
            ]
          },
          "752460109": {
            "id": "752460109",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "嘿嘿，希望这里办得越来越好、游客越来越多！",
            "nextDialogs": [
              "752460110"
            ]
          },
          "752460110": {
            "id": "752460110",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "你们呢？工作还顺利吗？",
            "nextDialogs": [
              "752460111"
            ]
          },
          "752460111": {
            "id": "752460111",
            "speakerId": 1307,
            "speakerName": "伊法",
            "text": "还不错，我们负责照顾的龙员工和蜜虫都很健康，活力十足。托这个的福，我们也有空到处转转。",
            "nextDialogs": [
              "752460112"
            ]
          },
          "752460112": {
            "id": "752460112",
            "speakerId": 1094,
            "speakerName": "欧洛伦",
            "text": "…员工。",
            "nextDialogs": [
              "752460113"
            ]
          },
          "752460113": {
            "id": "752460113",
            "speakerId": 1307,
            "speakerName": "伊法",
            "text": "啊？",
            "nextDialogs": [
              "752460114"
            ]
          },
          "752460114": {
            "id": "752460114",
            "speakerId": 1094,
            "speakerName": "欧洛伦",
            "text": "蜜虫员工。龙员工和蜜虫员工，你说漏了。",
            "nextDialogs": [
              "752460115"
            ]
          },
          "752460115": {
            "id": "752460115",
            "speakerId": 14977,
            "speakerName": "咔库库",
            "text": "没错哥们！",
            "nextDialogs": [
              "752460116"
            ]
          },
          "752460116": {
            "id": "752460116",
            "speakerId": 1307,
            "speakerName": "伊法",
            "text": "哎…抱歉啊。那么感谢所有的员工，以及积极为各位员工服务的欧洛伦先生。",
            "nextDialogs": [
              "752460117"
            ]
          },
          "752460117": {
            "id": "752460117",
            "speakerId": 1094,
            "speakerName": "欧洛伦",
            "text": "早到几天，为重要的事物奋斗。嗯，很好。",
            "nextDialogs": [
              "752460118"
            ]
          },
          "752460118": {
            "id": "752460118",
            "speakerId": 1307,
            "speakerName": "伊法",
            "text": "这哥们第一次接到如此正式的邀请函，可积极了，你别见怪。",
            "nextDialogs": [
              "752460119"
            ]
          },
          "752460119": {
            "id": "752460119",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "保持热情是好事。",
            "nextDialogs": [
              "752460120"
            ]
          },
          "752460120": {
            "id": "752460120",
            "speakerId": 1094,
            "speakerName": "欧洛伦",
            "text": "#你看，{M#爷爷}{F#奶奶}也这么说。",
            "nextDialogs": [
              "752460121"
            ]
          },
          "752460121": {
            "id": "752460121",
            "speakerId": 1094,
            "speakerName": "欧洛伦",
            "text": "每一天都很重要，每一天的工作都是为守护重要的事物而战。这是咔库库教会我的。",
            "nextDialogs": [
              "752460122"
            ]
          },
          "752460122": {
            "id": "752460122",
            "speakerId": 14977,
            "speakerName": "咔库库",
            "text": "哈哈！",
            "nextDialogs": [
              "752460123"
            ]
          },
          "752460123": {
            "id": "752460123",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "可是…看样子你们是在钓鱼吧？钓鱼也算为重要的事而战？",
            "nextDialogs": [
              "752460124"
            ]
          },
          "752460124": {
            "id": "752460124",
            "speakerId": 14977,
            "speakerName": "咔库库",
            "text": "听听你说的话！",
            "nextDialogs": [
              "752460125"
            ]
          },
          "752460125": {
            "id": "752460125",
            "speakerId": 1094,
            "speakerName": "欧洛伦",
            "text": "很重要，因为钓鱼是一位朋友给我们的建议。他是蒙德有名的冒险家，运气极佳，听他的准没错。",
            "nextDialogs": [
              "752460126"
            ]
          },
          "752460126": {
            "id": "752460126",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "（啊…班尼特吗？）",
            "nextDialogs": [
              "752460127"
            ]
          },
          "752460127": {
            "id": "752460127",
            "speakerId": 1307,
            "speakerName": "伊法",
            "text": "那位哥们用树枝转了一圈，指向这片水池，欧洛伦说择运不如撞运，就过来钓鱼了。",
            "nextDialogs": [
              "752460128"
            ]
          },
          "752460128": {
            "id": "752460128",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "等一等等一等，我从刚才就想问了，这池子周围不都是豚兽嘛！真的能钓上鱼来？",
            "nextDialogs": [
              "752460129"
            ]
          },
          "752460129": {
            "id": "752460129",
            "speakerId": 1094,
            "speakerName": "欧洛伦",
            "text": "没问题的。豚兽性情温和，不太野，所以不需要警惕。有水就能野钓，这是奶奶的教诲。",
            "nextDialogs": [
              "752460130"
            ]
          },
          "752460130": {
            "id": "752460130",
            "speakerId": 1307,
            "speakerName": "伊法",
            "text": "奶奶还说有饭就吃，有台阶就下呢，你记住了没？",
            "nextDialogs": [
              "752460131"
            ]
          },
          "752460131": {
            "id": "752460131",
            "speakerId": 1094,
            "speakerName": "欧洛伦",
            "text": "#我现在正在给出台阶。{M#爷爷}{F#奶奶}，派蒙，来都来了，要不要一起钓鱼？",
            "nextDialogs": [
              "752460132"
            ]
          },
          "752460132": {
            "id": "752460132",
            "speakerId": 1307,
            "speakerName": "伊法",
            "text": "顺便一提，钓到最大的鱼的人，可以得到这家伙的蜜酒。",
            "nextDialogs": [
              "752460133"
            ]
          },
          "752460133": {
            "id": "752460133",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "有这种好事怎么不早说！",
            "nextDialogs": [
              "752460134"
            ]
          },
          "752460134": {
            "id": "752460134",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "#哼哼，看来你还不知道自己招惹了什么人…面对挑战、说干就干！遇到{NICKNAME}你可真是遇到对手啦！",
            "nextDialogs": [
              "752460136",
              "752460138"
            ]
          },
          "752460136": {
            "id": "752460136",
            "speakerId": 1307,
            "speakerName": "伊法",
            "text": "真有干劲，那我就奉陪了。"
          },
          "752460138": {
            "id": "752460138",
            "speakerId": 1094,
            "speakerName": "欧洛伦",
            "text": "没问题。赌上鱼的一切和蜜虫员工的酒，一决高下吧。"
          }
        }
      }
    },
    {
      "subId": "7524603",
      "subQuestName": "来一场惊心动魄的钓鱼赛",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "752460384"
        ],
        "dialogs": {
          "752460384": {
            "id": "752460384",
            "speakerId": 1094,
            "speakerName": "欧洛伦",
            "text": "#有请辈分最高的{M#爷爷}{F#奶奶}先来。",
            "nextDialogs": [
              "752460385"
            ]
          },
          "752460385": {
            "id": "752460385",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "那我就不客气了。",
            "nextDialogs": [
              "752460301"
            ]
          },
          "752460301": {
            "id": "752460301",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "#哇，一上来比赛就进入高潮！高手{NICKNAME}使出绝技，拉杆出水！甩出一条…",
            "nextDialogs": [
              "752460302"
            ]
          },
          "752460302": {
            "id": "752460302",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "呃…一只…一位…阿夏？",
            "nextDialogs": [
              "752460303"
            ]
          },
          "752460303": {
            "id": "752460303",
            "speakerId": 1307,
            "speakerName": "伊法",
            "text": "真不得了…一上来就钓到了意想不到的东西，直接对评分系统发起挑战。",
            "nextDialogs": [
              "752460304"
            ]
          },
          "752460304": {
            "id": "752460304",
            "speakerId": 1094,
            "speakerName": "欧洛伦",
            "text": "#不愧是{M#爷爷}{F#奶奶}！如果其他人不能钓到更特别的嘉宾，我觉得这就是冠军。",
            "nextDialogs": [
              "752460305"
            ]
          },
          "752460305": {
            "id": "752460305",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "谢谢强大的对手们，谢谢亲爱的观众们！借乖孙吉言，本人有望成为冠军。",
            "nextDialogs": [
              "752460306"
            ]
          },
          "752460306": {
            "id": "752460306",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "#真是太好了呢！{NICKNAME}旗开得胜，为另外两位选手带去压力了！",
            "nextDialogs": [
              "752460307"
            ]
          },
          "752460307": {
            "id": "752460307",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "伊法选手请就位！",
            "nextDialogs": [
              "752460308"
            ]
          },
          "752460308": {
            "id": "752460308",
            "speakerId": 14977,
            "speakerName": "咔库库",
            "text": "加油，哥们！搭把手哥们！",
            "nextDialogs": [
              "752460309"
            ]
          },
          "752460309": {
            "id": "752460309",
            "speakerId": 1094,
            "speakerName": "欧洛伦",
            "text": "抱歉，咔库库，现在不是互帮互助的时候。",
            "nextDialogs": [
              "752460310"
            ]
          },
          "752460310": {
            "id": "752460310",
            "speakerId": 1307,
            "speakerName": "伊法",
            "text": "你们消停点…等等，来了！",
            "nextDialogs": [
              "752460311"
            ]
          },
          "752460311": {
            "id": "752460311",
            "speakerId": 1004,
            "speakerName": "Black Screen",
            "text": "伊法拼尽全力拉动钓竿，看起来像是钓到了大的。",
            "nextDialogs": [
              "752460312"
            ]
          },
          "752460312": {
            "id": "752460312",
            "speakerId": 1004,
            "speakerName": "Black Screen",
            "text": "然而浮出水面的却是…"
          }
        }
      }
    },
    {

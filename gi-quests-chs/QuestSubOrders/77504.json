    {
      "subId": "7750401",
      "subQuestName": "开车$HIDDEN",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "775040101"
        ],
        "dialogs": {
          "775040101": {
            "id": "775040101",
            "speakerId": 10205,
            "speakerName": "？？？",
            "text": "咦？还有别的新人吗？",
            "nextDialogs": [
              "775040102"
            ]
          },
          "775040102": {
            "id": "775040102",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "欸？新人？在说我们俩？",
            "nextDialogs": [
              "775040103"
            ]
          },
          "775040103": {
            "id": "775040103",
            "speakerId": 10205,
            "speakerName": "？？？",
            "text": "你们穿得不像本地人，又在这附近转悠，难道是小松果和木头人的朋友？",
            "nextDialogs": [
              "775040104"
            ]
          },
          "775040104": {
            "id": "775040104",
            "speakerId": 10205,
            "speakerName": "？？？",
            "text": "不管那么多了，海屑镇的「强化互助会」欢迎你们！",
            "nextDialogs": [
              "775040105"
            ]
          },
          "775040105": {
            "id": "775040105",
            "speakerId": 17182,
            "speakerName": "琪琪科娃",
            "text": "就让我——得到了凯瑟琳大人的祝福，塔拉利欣大哥的肯定，还有「新锋」之眷顾的琪琪科娃，好好关照你们吧~",
            "nextDialogs": [
              "775040106"
            ]
          },
          "775040106": {
            "id": "775040106",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "强化…互助会？没听过的名字…",
            "nextDialogs": [
              "775040107"
            ]
          },
          "775040107": {
            "id": "775040107",
            "speakerId": 17182,
            "speakerName": "琪琪科娃",
            "text": "顾名思义，是帮助大家不断变强，成为高手的团队哦。",
            "nextDialogs": [
              "775040108"
            ]
          },
          "775040108": {
            "id": "775040108",
            "speakerId": 17182,
            "speakerName": "琪琪科娃",
            "text": "只要你有着闯出一片天地的志气，就能与我们同行！",
            "nextDialogs": [
              "775040111"
            ]
          },
          "775040111": {
            "id": "775040111",
            "speakerId": 17182,
            "speakerName": "琪琪科娃",
            "text": "那就跟着我走吧，带你们去和大家碰面。",
            "nextDialogs": [
              "775040112"
            ]
          },
          "775040112": {
            "id": "775040112",
            "speakerId": 17182,
            "speakerName": "琪琪科娃",
            "text": "正好，我们也要开始这一期的活动了，你们赶上了好时候！",
            "nextDialogs": [
              "775040113"
            ]
          },
          "775040113": {
            "id": "775040113",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "喂喂，你怎么就顺着她的话说下去了？",
            "nextDialogs": [
              "775040114"
            ]
          },
          "775040114": {
            "id": "775040114",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "我知道你有谦虚的时候，不过，真的要装成新人吗？"
          }
        }
      }
    },

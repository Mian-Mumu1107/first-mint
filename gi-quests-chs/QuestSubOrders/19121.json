            ]
          },
          "191211402": {
            "id": "191211402",
            "speakerId": 1001,
            "speakerName": "高志",
            "text": "托马不是一直很忙吗？每天都见不到他的人影。",
            "nextDialogs": [
              "191211403"
            ]
          },
          "191211403": {
            "id": "191211403",
            "speakerId": 1001,
            "speakerName": "高志",
            "text": "在社奉行所见到他的时候，他也在忙于打扫。",
            "nextDialogs": [
              "191211404"
            ]
          },
          "191211404": {
            "id": "191211404",
            "speakerId": 1001,
            "speakerName": "高志",
            "text": "我觉得托马继续这样下去就好了，每个人都有自己的生活方式，托马也不例外。"
          }

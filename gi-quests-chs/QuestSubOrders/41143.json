          "411430101"
        ],
        "dialogs": {
          "411430101": {
            "id": "411430101",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "我这就送过去。",
            "nextDialogs": [
              "411430102"
            ]
          },
          "411430102": {
            "id": "411430102",
            "speakerId": 1419,
            "speakerName": "莎拉",
            "text": "那就最好了，谢谢你。",
            "nextDialogs": [
              "411430103"
            ]
          },
          "411430103": {
            "id": "411430103",
            "speakerId": 1419,
            "speakerName": "莎拉",
            "text": "送的时候千万要小心一些，<color=#00E1FFFF>别让它沾了奇怪的元素</color>。",
            "nextDialogs": [
              "411430104"
            ]
          },
          "411430104": {
            "id": "411430104",
            "speakerId": 1419,
            "speakerName": "莎拉",
            "text": "还有<color=#00E1FFFF>千万绕着魔物走，别被它们把菜撞翻了</color>。",
            "nextDialogs": [
              "411430105"
            ]
          },
          "411430105": {
            "id": "411430105",
            "speakerId": 1419,
            "speakerName": "莎拉",
            "text": "好了，快点把这道菜送过去吧，凉了就不好吃了。"
          }
        }
      }
    },
    {

    {
      "subId": "7307403",
      "subQuestName": "与兰罗摩、兰陀娑对话",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "730740301"
        ],
        "dialogs": {
          "730740301": {
            "id": "730740301",
            "speakerId": 20667,
            "speakerName": "兰陀娑",
            "text": "……",
            "nextDialogs": [
              "730740302"
            ]
          },
          "730740302": {
            "id": "730740302",
            "speakerId": 20646,
            "speakerName": "兰罗摩",
            "text": "这就是兰雅玛留下的歌…",
            "nextDialogs": [
              "730740303"
            ]
          },
          "730740303": {
            "id": "730740303",
            "speakerId": 20667,
            "speakerName": "兰陀娑",
            "text": "「纵使那是铺满火的道路，也要欢歌前行…」",
            "nextDialogs": [
              "730740304"
            ]
          },
          "730740304": {
            "id": "730740304",
            "speakerId": 20667,
            "speakerName": "兰陀娑",
            "text": "「纵使那日的月色，如同垂死之兽的眼眸…」",
            "nextDialogs": [
              "730740305"
            ]
          },
          "730740305": {
            "id": "730740305",
            "speakerId": 20646,
            "speakerName": "兰罗摩",
            "text": "「因为我们确是生命之谷的居民，因为我们确是勇敢的种子。」",
            "nextDialogs": [
              "730740306"
            ]
          },
          "730740306": {
            "id": "730740306",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "这就是…我们找到的歌吗？",
            "nextDialogs": [
              "730740307"
            ]
          },
          "730740307": {
            "id": "730740307",
            "speakerId": 20667,
            "speakerName": "兰陀娑",
            "text": "「因为有想要结实的石榴，因为有想要盛放的蔷薇。」",
            "nextDialogs": [
              "730740308"
            ]
          },
          "730740308": {
            "id": "730740308",
            "speakerId": 20667,
            "speakerName": "兰陀娑",
            "text": "「遥远而比邻的天空…永不终结的约定…一定会归还梦的笼城。」",
            "nextDialogs": [
              "730740309"
            ]
          },
          "730740309": {
            "id": "730740309",
            "speakerId": 20646,
            "speakerName": "兰罗摩",
            "text": "…嗯。原来如此，我大致明白了。只要有兰雅玛的歌，就能消除前往觉树之堂通路上的阻碍。",
            "nextDialogs": [
              "730740311"
            ]
          },
          "730740311": {
            "id": "730740311",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "欸？你明白了什么…？",
            "nextDialogs": [
              "730740313"
            ]
          },
          "730740313": {
            "id": "730740313",
            "speakerId": 20646,
            "speakerName": "兰罗摩",
            "text": "当然是兰雅玛的歌。嗯，还是说，不是兰那罗的话，没那么容易听懂…？",
            "nextDialogs": [
              "730740314"
            ]
          },
          "730740314": {
            "id": "730740314",
            "speakerId": 20646,
            "speakerName": "兰罗摩",
            "text": "嗯，不管怎么说，兰陀娑，你先回去准备无忧节吧？觉树之堂交给我就好！",
            "nextDialogs": [
              "730740315"
            ]
          },
          "730740315": {
            "id": "730740315",
            "speakerId": 20667,
            "speakerName": "兰陀娑",
            "text": "♪~",
            "nextDialogs": [
              "730740316"
            ]
          },
          "730740316": {
            "id": "730740316",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "#我和{NICKNAME}也一起去！毕竟，说好了要帮忙拿到恒素果的！",
            "nextDialogs": [
              "730740317"
            ]
          },
          "730740317": {
            "id": "730740317",
            "speakerId": 20667,
            "speakerName": "兰陀娑",
            "text": "「…一定要欢歌前行。」"
          }
        }
      }
    },

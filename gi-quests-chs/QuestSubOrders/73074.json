    {
      "subId": "7307410",
      "subQuestName": "调查觉树之堂中的树木",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [],
        "dialogs": {}
      }
    },
    {
      "subId": "7307411",
      "subQuestName": "与兰罗摩对话",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "730741101"
        ],
        "dialogs": {
          "730741101": {
            "id": "730741101",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "这就是…莎兰树？看起来，好像没有想象中那么有生机…",
            "nextDialogs": [
              "730741102"
            ]
          },
          "730741102": {
            "id": "730741102",
            "speakerId": 20646,
            "speakerName": "兰罗摩",
            "text": "是因为无留陀的侵蚀吧…兰雅玛，对不起。我们一直都没发现，无留陀已经侵蚀到了这里。",
            "nextDialogs": [
              "730741103"
            ]
          },
          "730741103": {
            "id": "730741103",
            "speakerId": 20646,
            "speakerName": "兰罗摩",
            "text": "在我还是很小很小的种子的时候，就听大家说过兰穆护昆达和兰雅玛、兰拉吉他们的故事。",
            "nextDialogs": [
              "730741104"
            ]
          },
          "730741104": {
            "id": "730741104",
            "speakerId": 20646,
            "speakerName": "兰罗摩",
            "text": "兰雅玛本来很讨厌那菈，所以制造幻影的障碍。那菈被阻挠了，他就很开心。但是，有一个那菈，识破他的兰迦拉梨。",
            "nextDialogs": [
              "730741105"
            ]
          },
          "730741105": {
            "id": "730741105",
            "speakerId": 20646,
            "speakerName": "兰罗摩",
            "text": "他阻挠，那个那菈就破解。后来他们就慢慢成为了好朋友。",
            "nextDialogs": [
              "730741106"
            ]
          },
          "730741106": {
            "id": "730741106",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "确实也有这样的友情呢…那兰雅玛后来怎么样了？",
            "nextDialogs": [
              "730741107"
            ]
          },
          "730741107": {
            "id": "730741107",
            "speakerId": 20646,
            "speakerName": "兰罗摩",
            "text": "在故事的最后，发生了大灾难。在大灾难里，他保护了很多兰那罗和那菈。",
            "nextDialogs": [
              "730741108"
            ]
          },
          "730741108": {
            "id": "730741108",
            "speakerId": 20646,
            "speakerName": "兰罗摩",
            "text": "嗯！原来如此，难怪他留下的歌，能够消灭那种幻影。因为游戏已经结束了。",
            "nextDialogs": [
              "730741109"
            ]
          },
          "730741109": {
            "id": "730741109",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "要怎么取得恒素果？",
            "nextDialogs": [
              "730741110"
            ]
          },
          "730741110": {
            "id": "730741110",
            "speakerId": 20646,
            "speakerName": "兰罗摩",
            "text": "嗯。我们要先进入他的梦中，消除无留陀的影响。",
            "nextDialogs": [
              "730741111"
            ]
          },
          "730741111": {
            "id": "730741111",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "「他」是指…莎兰树吗？",
            "nextDialogs": [
              "730741112"
            ]
          },
          "730741112": {
            "id": "730741112",
            "speakerId": 20646,
            "speakerName": "兰罗摩",
            "text": "没错。如果准备好了，就伸出手，进入他的梦吧…"
          }
        }
      }
    },
    {
      "subId": "7307415",

            "text": "嗯！原来如此，难怪他留下的歌，能够消灭那种幻影。因为游戏已经结束了。",
            "nextDialogs": [
              "730741311"
            ]
          },
          "730741311": {
            "id": "730741311",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "我们进去吧。",
            "nextDialogs": [
              "730741312"
            ]
          },
          "730741312": {
            "id": "730741312",
            "speakerId": 20646,
            "speakerName": "兰罗摩",
            "text": "如果准备好了，就伸出手，进入他的梦吧…"
          }
        }
      }

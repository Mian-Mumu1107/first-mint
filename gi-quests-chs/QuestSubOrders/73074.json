    {
      "subId": "7307414",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "730741401"
        ],
        "dialogs": {
          "730741401": {
            "id": "730741401",
            "speakerId": 20646,
            "speakerName": "兰罗摩",
            "text": "#那菈{NICKNAME}，如果准备好进入他的梦了，那就伸出手吧。"
          }
        }
      }
    },
    {
      "subId": "7307419",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "730741901"
        ],
        "dialogs": {
          "730741901": {
            "id": "730741901",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "第三颗恒素果到手！按照兰拉迦之前说的，记得是三个就够了吧？",
            "nextDialogs": [
              "730741902"
            ]
          },
          "730741902": {
            "id": "730741902",
            "speakerId": 20646,
            "speakerName": "兰罗摩",
            "text": "#嗯！应该够了。谢谢你们，那菈{NICKNAME}、派蒙！",
            "nextDialogs": [
              "730741904"
            ]
          },
          "730741904": {
            "id": "730741904",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "…这么说来，明明是兰罗摩在帮我们，为什么要感谢我们呀？",
            "nextDialogs": [
              "730741906"
            ]
          },
          "730741906": {
            "id": "730741906",
            "speakerId": 20646,
            "speakerName": "兰罗摩",
            "text": "嗯。我想想，应该要这样说。因为你们也在帮助兰拉娜，兰拉娜是我的朋友，所以谢谢。",
            "nextDialogs": [
              "730741907"
            ]
          },
          "730741907": {
            "id": "730741907",
            "speakerId": 20646,
            "speakerName": "兰罗摩",
            "text": "#然后，那菈{NICKNAME}帮助兰耶娑、兰陀娑和兰修提袈，找到了古老的歌。他们也是我的朋友，所以谢谢。",
            "nextDialogs": [
              "730741908"
            ]
          },
          "730741908": {
            "id": "730741908",
            "speakerId": 20646,
            "speakerName": "兰罗摩",
            "text": "#最后，和那菈{NICKNAME}、派蒙一起冒险，我很开心，所以谢谢。",
            "nextDialogs": [
              "730741909"
            ]
          },
          "730741909": {
            "id": "730741909",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "我也很开心！谢谢你，兰罗摩！",
            "nextDialogs": [
              "730741910"
            ]
          },
          "730741910": {
            "id": "730741910",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "这么说来，觉树之堂看起来像很古老的遗迹…这边有什么故事吗？",
            "nextDialogs": [
              "730741911"
            ]
          },
          "730741911": {
            "id": "730741911",
            "speakerId": 20646,
            "speakerName": "兰罗摩",
            "text": "那是很久很久以前的故事，那时候我连种子都还不是。在很久很久以前，那菈都能看到兰那罗，兰那罗也不害怕那菈。",
            "nextDialogs": [
              "730741912"
            ]
          },
          "730741912": {
            "id": "730741912",
            "speakerId": 20646,
            "speakerName": "兰罗摩",
            "text": "#在那时候，那菈帮助兰那罗，兰那罗帮助那菈，我们一起玩，就像我和那菈{NICKNAME}一样，还经常一起唱歌。",
            "nextDialogs": [
              "730741913"
            ]
          },
          "730741913": {
            "id": "730741913",
            "speakerId": 20646,
            "speakerName": "兰罗摩",
            "text": "像兰耶娑他们那样的采歌者，原本也是兰那罗学习那菈得来的。",
            "nextDialogs": [
              "730741914"
            ]
          },
          "730741914": {
            "id": "730741914",
            "speakerId": 20646,
            "speakerName": "兰罗摩",
            "text": "觉树之堂，原本是兰那罗和那菈一起玩的地方。但那是很久很久以前的事。",
            "nextDialogs": [
              "730741915"
            ]
          },
          "730741915": {
            "id": "730741915",
            "speakerId": 20646,
            "speakerName": "兰罗摩",
            "text": "在发生了很可怕很可怕的灾难以后，桓那兰那毁灭了，觉树之堂也荒废了…",
            "nextDialogs": [
              "730741916"
            ]
          },
          "730741916": {
            "id": "730741916",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "原来是这样…",
            "nextDialogs": [
              "730741917"
            ]
          },
          "730741917": {
            "id": "730741917",
            "speakerId": 20646,
            "speakerName": "兰罗摩",
            "text": "嗯。那是很可怕的故事。但幸好，那只是故事，不是我的记忆。",
            "nextDialogs": [
              "730741918"
            ]
          },
          "730741918": {
            "id": "730741918",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "#别担心！以后会越来越好的，对吧，{NICKNAME}？"
          }
        }
      }
    },

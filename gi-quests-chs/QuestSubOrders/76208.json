        "dialogs": {
          "762080101": {
            "id": "762080101",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "咦？周围好像有一道透明的幕升起来了…是那棵树干的吗？",
            "nextDialogs": [
              "762080102"
            ]
          },
          "762080102": {
            "id": "762080102",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "感觉它像是在吐树脂呢，把这里变成了一块琥珀！",
            "nextDialogs": [
              "762080103"
            ]
          },
          "762080103": {
            "id": "762080103",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "那我们就成了琥珀里的小虫。",
            "nextDialogs": [
              "762080104"
            ]
          },
          "762080104": {
            "id": "762080104",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "装了你和我的琥珀，应该会在拍卖会上成为压轴的宝贝吧。",
            "nextDialogs": [
              "762080105"
            ]
          },
          "762080105": {
            "id": "762080105",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "那最后压台的宝贝呢？",
            "nextDialogs": [
              "762080106"
            ]
          },
          "762080106": {
            "id": "762080106",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "当然是这棵树啦，毕竟是它做的琥珀嘛，可惜看样子没法把它带走…",
            "nextDialogs": [
              "762080107"
            ]
          },
          "762080107": {
            "id": "762080107",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "不知道附近有没有留下关于它的线索。"

  "subQuests": [
    {
      "subId": "1102908",
      "subQuestName": "返回轻策庄西郊",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "110290801"
        ],
        "dialogs": {
          "110290801": {
            "id": "110290801",
            "speakerId": 10234,
            "speakerName": "白术",
            "text": "……",
            "nextDialogs": [
              "110290802"
            ]
          },
          "110290802": {
            "id": "110290802",
            "speakerId": 13136,
            "speakerName": "嘉良",
            "text": "唔…这种感觉…",
            "nextDialogs": [
              "110290803"
            ]
          },
          "110290803": {
            "id": "110290803",
            "speakerId": 13136,
            "speakerName": "嘉良",
            "text": "跟那天迷路的时候一样…好像身体里有什么东西，要带我去什么地方…",
            "nextDialogs": [
              "110290804"
            ]
          },
          "110290804": {
            "id": "110290804",
            "speakerId": 10234,
            "speakerName": "白术",
            "text": "「本体」的影响越来越强烈了，究竟是因为距离变近，还是泄露更严重了…",
            "nextDialogs": [
              "110290805"
            ]
          },
          "110290805": {
            "id": "110290805",
            "speakerId": 10234,
            "speakerName": "白术",
            "text": "嘉良，你能感觉到具体的方向吗？",
            "nextDialogs": [
              "110290806"
            ]
          },
          "110290806": {
            "id": "110290806",
            "speakerId": 13136,
            "speakerName": "嘉良",
            "text": "应该是…这边！"
          }
        }
      }
    },
    {
      "subId": "1102901",
      "subQuestName": "跟随嘉良",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [],
        "dialogs": {}
      }
    },
    {
      "subId": "1102902",
      "subQuestName": "与嘉良等人对话",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "110290201"
        ],
        "dialogs": {
          "110290201": {
            "id": "110290201",
            "speakerId": 10234,
            "speakerName": "白术",
            "text": "此地…似乎有不祥的气息，连我也能感觉到了。",
            "nextDialogs": [
              "110290202"
            ]
          },
          "110290202": {
            "id": "110290202",
            "speakerId": 13136,
            "speakerName": "嘉良",
            "text": "我对这里，有点印象…呃…！",
            "nextDialogs": [
              "110290203"
            ]
          },
          "110290203": {
            "id": "110290203",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "嘉良！你还好吧？要不然，你先在这里休息，我们下去找找？",
            "nextDialogs": [
              "110290204"
            ]
          },
          "110290204": {
            "id": "110290204",
            "speakerId": 13136,
            "speakerName": "嘉良",
            "text": "不行…江蓠她，一定还在等我…",
            "nextDialogs": [
              "110290205"
            ]
          },
          "110290205": {
            "id": "110290205",
            "speakerId": 13136,
            "speakerName": "嘉良",
            "text": "呼…快点出发吧！"
          }
        }
      }
    },
    {
      "subId": "1102912",
      "subQuestName": "前往地下",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "110291201"
        ],
        "dialogs": {
          "110291201": {
            "id": "110291201",
            "speakerId": 10204,
            "speakerName": "魈",
            "text": "嗯？看你的样子，「本体」的所在，已经有眉目了？",
            "nextDialogs": [
              "110291202"
            ]
          },
          "110291202": {
            "id": "110291202",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "是有一点了…",
            "nextDialogs": [
              "110291203"
            ]
          },
          "110291203": {
            "id": "110291203",
            "speakerId": 10204,
            "speakerName": "魈",
            "text": "是吗？那就好。",
            "nextDialogs": [
              "110291204"
            ]
          },
          "110291204": {
            "id": "110291204",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "魈你一直守在这儿吗？",
            "nextDialogs": [
              "110291205"
            ]
          },
          "110291205": {
            "id": "110291205",
            "speakerId": 10204,
            "speakerName": "魈",
            "text": "…事关「妖邪」，不能完全置之不理。",
            "nextDialogs": [
              "110291206"
            ]
          },
          "110291206": {
            "id": "110291206",
            "speakerId": 10204,
            "speakerName": "魈",
            "text": "况且，我能隐约感觉到，「妖邪」的气息正在孳生。",
            "nextDialogs": [
              "110291207"
            ]
          },
          "110291207": {
            "id": "110291207",
            "speakerId": 10204,
            "speakerName": "魈",
            "text": "…无论你想做什么，都尽快为好。",
            "nextDialogs": [
              "110291208"
            ]
          },
          "110291208": {
            "id": "110291208",
            "speakerId": 10204,
            "speakerName": "魈",
            "text": "若等到仙人出手，结果…未必能遂凡人所愿。"
          }
        }
      }
    },
    {
      "subId": "1102903",
      "subQuestName": "与白术等人对话",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "110290301"
        ],
        "dialogs": {
          "110290301": {
            "id": "110290301",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "哇…好阴森的感觉，不知道前面会有什么…",
            "nextDialogs": [
              "110290302"
            ]
          },
          "110290302": {
            "id": "110290302",
            "speakerId": 1004,
            "speakerName": "长生",
            "text": "这里的开凿痕迹很粗糙，年代也有些久远，看着像是个盗洞。",
            "nextDialogs": [
              "110290303"
            ]
          },
          "110290303": {
            "id": "110290303",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "盗洞？说起来，这附近确实有关于宝藏的传说，会不会是盗宝团的人挖的？",
            "nextDialogs": [
              "110290304"
            ]
          },
          "110290304": {
            "id": "110290304",
            "speakerId": 10234,
            "speakerName": "白术",
            "text": "看四处遗落的工具，确实有这可能。",
            "nextDialogs": [
              "110290305"
            ]
          },
          "110290305": {
            "id": "110290305",
            "speakerId": 10234,
            "speakerName": "白术",
            "text": "…不过他们为什么连工具也不收拾，就将这里荒废了呢？",
            "nextDialogs": [
              "110290306"
            ]
          },
          "110290306": {
            "id": "110290306",
            "speakerId": 13136,
            "speakerName": "嘉良",
            "text": "…我想起来了，她带我来过这里，说是在洞里发现了救我的方子…",
            "nextDialogs": [
              "110290307"
            ]
          },
          "110290307": {
            "id": "110290307",
            "speakerId": 13136,
            "speakerName": "嘉良",
            "text": "但是…但是她说，这种方法会让我…可恶，怎么想不起来了！可恶…！",
            "nextDialogs": [
              "110290308"
            ]
          },
          "110290308": {
            "id": "110290308",
            "speakerId": 10234,
            "speakerName": "白术",
            "text": "不必勉强自己，先往前探索吧。"
          }
        }
      }
    },
    {
      "subId": "1102909",
      "subQuestName": "向更深处探索",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [],
        "dialogs": {}
      }
    },
    {
      "subId": "1102910",
      "subQuestName": "与白术等人对话",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "110291001"
        ],
        "dialogs": {
          "110291001": {
            "id": "110291001",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "哇，这里居然还有香炉？那伙盗宝团，还挺懂享受的嘛。",
            "nextDialogs": [
              "110291013"
            ]
          },
          "110291013": {
            "id": "110291013",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "…这应该不是盗宝团留下的。",
            "nextDialogs": [
              "110291004"
            ]
          },
          "110291004": {
            "id": "110291004",
            "speakerId": 10234,
            "speakerName": "白术",
            "text": "…香炉中点的，似乎是驱逐魔物用的熏香。",
            "nextDialogs": [
              "110291005"
            ]
          },
          "110291005": {
            "id": "110291005",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "驱逐魔物？可我们刚刚不还遇到了一群吗？",
            "nextDialogs": [
              "110291006"
            ]
          },
          "110291006": {
            "id": "110291006",
            "speakerId": 10234,
            "speakerName": "白术",
            "text": "熏香已经燃尽多日。而方才遇到的魔物，恐怕，是被更深处的「某物」吸引而至的。",
            "nextDialogs": [
              "110291007"
            ]
          },
          "110291007": {
            "id": "110291007",
            "speakerId": 10234,
            "speakerName": "白术",
            "text": "想必当初开凿此洞的盗宝团，也是在深处与「它」不期而遇，才匆匆弃洞逃亡。",
            "nextDialogs": [
              "110291008"
            ]
          },
          "110291008": {
            "id": "110291008",
            "speakerId": 10234,
            "speakerName": "白术",
            "text": "后来师姐又发现了这里，将「它」视作医治嘉良的救命稻草…",
            "nextDialogs": [
              "110291009"
            ]
          },
          "110291009": {
            "id": "110291009",
            "speakerId": 13136,
            "speakerName": "嘉良",
            "text": "对了…这香炉…这香炉是江蓠的东西！…没错，就是在这里！",
            "nextDialogs": [
              "110291010"
            ]
          },
          "110291010": {
            "id": "110291010",
            "speakerId": 13136,
            "speakerName": "嘉良",
            "text": "就是在这里…我让江蓠…是我让她…对我下了…咳！咳咳！",
            "nextDialogs": [
              "110291011"
            ]
          },
          "110291011": {
            "id": "110291011",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "——嘉良！",
            "nextDialogs": [
              "110291012"
            ]
          },
          "110291012": {
            "id": "110291012",
            "speakerId": 13136,
            "speakerName": "嘉良",
            "text": "我没事…继续往下吧。我能感觉到，她…就在下面等我。"
          }
        }
      }
    },
    {
      "subId": "1102911",
      "subQuestName": "向更深处探索",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "110291101"
        ],
        "dialogs": {
          "110291101": {
            "id": "110291101",
            "speakerId": 10233,
            "speakerName": "七七",
            "text": "大家，一路小心。"
          }
        }
      }
    },
    {
      "subId": "1102904",
      "subQuestName": "与白术等人对话",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "110290401"
        ],
        "dialogs": {
          "110290401": {
            "id": "110290401",
            "speakerId": 13136,
            "speakerName": "嘉良",
            "text": "白先生，怎么样？江蓠她…",
            "nextDialogs": [
              "110290402"
            ]
          },
          "110290402": {
            "id": "110290402",
            "speakerId": 10234,
            "speakerName": "白术",
            "text": "还有脉象，但绝对谈不上乐观。",
            "nextDialogs": [
              "110290403"
            ]
          },
          "110290403": {
            "id": "110290403",
            "speakerId": 10234,
            "speakerName": "白术",
            "text": "与你身上的毒素一样，盘踞此地的魔神残渣，已经侵蚀了她的神志…",
            "nextDialogs": [
              "110290404"
            ]
          },
          "110290404": {
            "id": "110290404",
            "speakerId": 10234,
            "speakerName": "白术",
            "text": "若不尽快祛除，即使暂留一命，恐怕…也再难醒觉。",
            "nextDialogs": [
              "110290405"
            ]
          },
          "110290405": {
            "id": "110290405",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "那我们还等什么？赶快把魔神残渣除掉吧！",
            "nextDialogs": [
              "110290406"
            ]
          },
          "110290406": {
            "id": "110290406",
            "speakerId": 1004,
            "speakerName": "长生",
            "text": "…事情没有那么简单，还记得白术在上面说过的话吗？",
            "nextDialogs": [
              "110290407"
            ]
          },
          "110290407": {
            "id": "110290407",
            "speakerId": 1004,
            "speakerName": "长生",
            "text": "嘉良身上的毒，跟这里的魔神残渣遥相联系。",
            "nextDialogs": [
              "110290408"
            ]
          },
          "110290408": {
            "id": "110290408",
            "speakerId": 1004,
            "speakerName": "长生",
            "text": "…一旦祛除了魔神残渣，他身上的毒，也会一并失效。",
            "nextDialogs": [
              "110290409"
            ]
          },
          "110290409": {
            "id": "110290409",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "唔…嘉良身上的毒，不是用来压制心病的吗？那要是失效的话…",
            "nextDialogs": [
              "110290410"
            ]
          },
          "110290410": {
            "id": "110290410",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "欸！难不成——",
            "nextDialogs": [
              "110290411"
            ]
          },
          "110290411": {
            "id": "110290411",
            "speakerId": 10234,
            "speakerName": "白术",
            "text": "不错，如果祛除此地的魔神残渣，你的命数…也就到了尽头。",
            "nextDialogs": [
              "110290412"
            ]
          },
          "110290412": {
            "id": "110290412",
            "speakerId": 13136,
            "speakerName": "嘉良",
            "text": "…果然，会这样吗…",
            "nextDialogs": [
              "110290413"
            ]
          },
          "110290413": {
            "id": "110290413",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "等等！我们忙活这么久，不就是为了给嘉良治病吗！怎么能…怎么能这样！",
            "nextDialogs": [
              "110290414"
            ]
          },
          "110290414": {
            "id": "110290414",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "白术你见多识广，一定还有别的办法…对吧！",
            "nextDialogs": [
              "110290415"
            ]
          },
          "110290415": {
            "id": "110290415",
            "speakerId": 10234,
            "speakerName": "白术",
            "text": "…或者，你可以继续服用此毒，多争取一点时间。师姐的情况…我们另外再想办法。",
            "nextDialogs": [
              "110290416"
            ]
          },
          "110290416": {
            "id": "110290416",
            "speakerId": 1004,
            "speakerName": "长生",
            "text": "看江蓠的样子，恐怕一直到昏迷前，都一心在为你炼药吧——或许她也希望你这么做？",
            "nextDialogs": [
              "110290417"
            ]
          },
          "110290417": {
            "id": "110290417",
            "speakerId": 13136,
            "speakerName": "嘉良",
            "text": "…白先生，请你如实告诉我，江蓠她…还能撑多久？",
            "nextDialogs": [
              "110290418"
            ]
          },
          "110290418": {
            "id": "110290418",
            "speakerId": 10234,
            "speakerName": "白术",
            "text": "魔神残渣已经侵入肺腑，正常来说，不足三日，但如果我以秘法施救…",
            "nextDialogs": [
              "110290421"
            ]
          },
          "110290421": {
            "id": "110290421",
            "speakerId": 13136,
            "speakerName": "嘉良",
            "text": "…可那又有什么意义呢？",
            "nextDialogs": [
              "110290422"
            ]
          },
          "110290422": {
            "id": "110290422",
            "speakerId": 13136,
            "speakerName": "嘉良",
            "text": "白先生，来之前，已经有人向我说过魔神残渣的危害。",
            "nextDialogs": [
              "110290423"
            ]
          },
          "110290423": {
            "id": "110290423",
            "speakerId": 13136,
            "speakerName": "嘉良",
            "text": "如果继续靠这种东西活着，不仅江蓠要继续冒着危险给我炼药，将来要是失控，还会殃及周围，伤到江蓠跟阿雩…",
            "nextDialogs": [
              "110290424"
            ]
          },
          "110290424": {
            "id": "110290424",
            "speakerId": 13136,
            "speakerName": "嘉良",
            "text": "…反正我这条命，十几年前就该交代了。能活到现在，看见阿雩长大，都算是岩王爷保佑！",
            "nextDialogs": [
              "110290425"
            ]
          },
          "110290425": {
            "id": "110290425",
            "speakerId": 13136,
            "speakerName": "嘉良",
            "text": "如果最后能换江蓠回来…我就算是…就算是…",
            "nextDialogs": [
              "110290426"
            ]
          },
          "110290426": {
            "id": "110290426",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "嘉良…",
            "nextDialogs": [
              "110290427"
            ]
          },
          "110290427": {
            "id": "110290427",
            "speakerId": 13136,
            "speakerName": "嘉良",
            "text": "…哈，果然人该走的时候没走，就越来越贪心了啊。",
            "nextDialogs": [
              "110290428"
            ]
          },
          "110290428": {
            "id": "110290428",
            "speakerId": 13136,
            "speakerName": "嘉良",
            "text": "#白先生、{NICKNAME}，请再给我一点时间，让我…多看江蓠一眼吧，一眼就够了。",
            "nextDialogs": [
              "110290429"
            ]
          },
          "110290429": {
            "id": "110290429",
            "speakerId": 10234,
            "speakerName": "白术",
            "text": "…好。",
            "nextDialogs": [
              "110290430"
            ]
          },
          "110290430": {
            "id": "110290430",
            "speakerId": 13136,
            "speakerName": "嘉良",
            "text": "谢谢…抱歉，各位的恩情…得来世再报了。",
            "nextDialogs": [
              "110290431"
            ]
          },
          "110290431": {
            "id": "110290431",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "嘉良他…白术、长生，真的连你们也没有办法了吗？",
            "nextDialogs": [
              "110290432"
            ]
          },
          "110290432": {
            "id": "110290432",
            "speakerId": 10234,
            "speakerName": "白术",
            "text": "寻常手段，只怕师姐这些年里都已试遍了。别的方法，我也没有几成把握…",
            "nextDialogs": [
              "110290433"
            ]
          },
          "110290433": {
            "id": "110290433",
            "speakerId": 1004,
            "speakerName": "长生",
            "text": "生老病死，本就是凡人逃不开的宿命。若是轻易能救，江蓠也不必向非人之物伸手了。",
            "nextDialogs": [
              "110290434"
            ]
          },
          "110290434": {
            "id": "110290434",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "怎么会…江蓠好不容易才救了嘉良，嘉良又要牺牲自己去救江蓠…这、这到底有什么意义啊！"
          }
        }
      }
    },
    {
      "subId": "1102914",
      "subQuestName": "(test)(hide)删除中小晶石$HIDDEN",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [],
        "dialogs": {}
      }
    },
    {
      "subId": "1102905",
      "subQuestName": "返回不卜庐",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "110290501"
        ],
        "dialogs": {
          "110290501": {
            "id": "110290501",
            "speakerId": 10205,
            "speakerName": "？？？",
            "text": "…良…嘉良…！",
            "nextDialogs": [
              "110290502"
            ]
          },
          "110290502": {
            "id": "110290502",
            "speakerId": 13137,
            "speakerName": "江蓠",
            "text": "——嘉良！嘉良！",
            "nextDialogs": [
              "110290503"
            ]
          },
          "110290503": {
            "id": "110290503",
            "speakerId": 13135,
            "speakerName": "阿雩",
            "text": "——爹！你醒了吗？",
            "nextDialogs": [
              "110290504"
            ]
          },
          "110290504": {
            "id": "110290504",
            "speakerId": 13136,
            "speakerName": "嘉良",
            "text": "唔…江蓠…阿雩？",
            "nextDialogs": [
              "110290505"
            ]
          },
          "110290505": {
            "id": "110290505",
            "speakerId": 13136,
            "speakerName": "嘉良",
            "text": "…我不是…嗯？这些东西是…？",
            "nextDialogs": [
              "110290506"
            ]
          },
          "110290506": {
            "id": "110290506",
            "speakerId": 1004,
            "speakerName": "长生",
            "text": "——死而复生的感觉如何呀？",
            "nextDialogs": [
              "110290507"
            ]
          },
          "110290507": {
            "id": "110290507",
            "speakerId": 10234,
            "speakerName": "白术",
            "text": "若有什么不适或者异样…可否详细说与我听听？",
            "nextDialogs": [
              "110290508"
            ]
          },
          "110290508": {
            "id": "110290508",
            "speakerId": 13136,
            "speakerName": "嘉良",
            "text": "白先生！我…我不是应该…",
            "nextDialogs": [
              "110290509"
            ]
          },
          "110290509": {
            "id": "110290509",
            "speakerId": 10234,
            "speakerName": "白术",
            "text": "呵呵，你确实已经死过一回了。如今的你，比起人类，更接近一具僵尸。",
            "nextDialogs": [
              "110290510"
            ]
          },
          "110290510": {
            "id": "110290510",
            "speakerId": 13136,
            "speakerName": "嘉良",
            "text": "…僵尸？",
            "nextDialogs": [
              "110290511"
            ]
          },
          "110290511": {
            "id": "110290511",
            "speakerId": 10234,
            "speakerName": "白术",
            "text": "不错，在我们出发之前，我托七七准备了一帖…「不死之药」，将你的身体维系于生死的狭缝间。",
            "nextDialogs": [
              "110290512"
            ]
          },
          "110290512": {
            "id": "110290512",
            "speakerId": 10234,
            "speakerName": "白术",
            "text": "虽然距离真正的仙家之术还差得远，估计只能为你延续一点寿命。",
            "nextDialogs": [
              "110290513"
            ]
          },
          "110290513": {
            "id": "110290513",
            "speakerId": 10234,
            "speakerName": "白术",
            "text": "至于具体是几日、几月还是几年…我也想借此机会，再观察一下。",
            "nextDialogs": [
              "110290514"
            ]
          },
          "110290514": {
            "id": "110290514",
            "speakerId": 10234,
            "speakerName": "白术",
            "text": "但无论时间多久，应该都够你好好道完别，再安心上路了——不知胡堂主，可还接受这样的安排？",
            "nextDialogs": [
              "110290515"
            ]
          },
          "110290515": {
            "id": "110290515",
            "speakerId": 1021,
            "speakerName": "胡桃",
            "text": "「不死之药」…你究竟在背地里鼓捣了多久？居然连这种东西都给炼出来了？",
            "nextDialogs": [
              "110290516"
            ]
          },
          "110290516": {
            "id": "110290516",
            "speakerId": 10234,
            "speakerName": "白术",
            "text": "名不副实的半成品罢了，如果不是嘉良的意志坚定，恐怕也发挥不了几分效用。",
            "nextDialogs": [
              "110290517"
            ]
          },
          "110290517": {
            "id": "110290517",
            "speakerId": 10234,
            "speakerName": "白术",
            "text": "说到底，我只是一名医师而已，不懂那么多生死循环、阴阳守常的大道理。",
            "nextDialogs": [
              "110290518"
            ]
          },
          "110290518": {
            "id": "110290518",
            "speakerId": 10234,
            "speakerName": "白术",
            "text": "只知道眼前既然有一条值得拯救的生命，就没有理由不去拯救。",
            "nextDialogs": [
              "110290519"
            ]
          },
          "110290519": {
            "id": "110290519",
            "speakerId": 10234,
            "speakerName": "白术",
            "text": "——何况在我们出发之前，不就是胡堂主，让嘉良来帮忙引路的吗？",
            "nextDialogs": [
              "110290520"
            ]
          },
          "110290520": {
            "id": "110290520",
            "speakerId": 1021,
            "speakerName": "胡桃",
            "text": "——唔，果然暴露了吗。",
            "nextDialogs": [
              "110290521"
            ]
          },
          "110290521": {
            "id": "110290521",
            "speakerId": 10234,
            "speakerName": "白术",
            "text": "若非胡堂主特意提点，我们后来恐怕也不能及时找到师姐。",
            "nextDialogs": [
              "110290524"
            ]
          },
          "110290524": {
            "id": "110290524",
            "speakerId": 1021,
            "speakerName": "胡桃",
            "text": "难怪当时没提不死药的事，居然连那种时候都还在提防我…",
            "nextDialogs": [
              "110290525"
            ]
          },
          "110290525": {
            "id": "110290525",
            "speakerId": 13136,
            "speakerName": "嘉良",
            "text": "呃…哈哈，胡堂主还嘱咐我不要随便乱说，结果，还是瞒不过白先生啊。",
            "nextDialogs": [
              "110290526"
            ]
          },
          "110290526": {
            "id": "110290526",
            "speakerId": 1004,
            "speakerName": "长生",
            "text": "哼哼，可不要小瞧了我的鼻子啊！",
            "nextDialogs": [
              "110290527"
            ]
          },
          "110290527": {
            "id": "110290527",
            "speakerId": 1021,
            "speakerName": "胡桃",
            "text": "…我不过是看嘉良一直记挂着失踪的家人，想让他了却心愿，尽早上路而已，免得回头徘徊不去，还得费心超度…",
            "nextDialogs": [
              "110290528"
            ]
          },
          "110290528": {
            "id": "110290528",
            "speakerId": 1021,
            "speakerName": "胡桃",
            "text": "——就是没想到这单生意，最后还是被不卜庐截了胡！算了算了，就当作订单延期吧。",
            "nextDialogs": [
              "110290529"
            ]
          },
          "110290529": {
            "id": "110290529",
            "speakerId": 1021,
            "speakerName": "胡桃",
            "text": "唉，原本有个七七就已经够头疼了，现在居然又多了一个…早知道一开始就把他拉去往生堂该多好…",
            "nextDialogs": [
              "110290530"
            ]
          },
          "110290530": {
            "id": "110290530",
            "speakerId": 13135,
            "speakerName": "阿雩",
            "text": "我…我一定会成为比白先生和妈更好的药师，再治好老爹的！你…别再打我爹的主意了！",
            "nextDialogs": [
              "110290531"
            ]
          },
          "110290531": {
            "id": "110290531",
            "speakerId": 13136,
            "speakerName": "嘉良",
            "text": "……",
            "nextDialogs": [
              "110290532"
            ]
          },
          "110290532": {
            "id": "110290532",
            "speakerId": 1021,
            "speakerName": "胡桃",
            "text": "哦？想跟往生堂抢生意的人，两个云来海都装不下，那你可得多多努力咯。",
            "nextDialogs": [
              "110290533"
            ]
          },
          "110290533": {
            "id": "110290533",
            "speakerId": 1021,
            "speakerName": "胡桃",
            "text": "#{NICKNAME}，派蒙——我们改日再会啦！",
            "nextDialogs": [
              "110290534"
            ]
          },
          "110290534": {
            "id": "110290534",
            "speakerId": 10233,
            "speakerName": "七七",
            "text": "呼…终于，走了吗…",
            "nextDialogs": [
              "110290535"
            ]
          },
          "110290535": {
            "id": "110290535",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "总算告一段落了呢！为了难得的重聚，是不是该做点什么…"
          }
        }
      }
    },
    {
      "subId": "1102913",
      "subQuestName": "跟随江蓠",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "110291301"
        ],
        "dialogs": {
          "110291301": {
            "id": "110291301",
            "speakerId": 10233,
            "speakerName": "七七",
            "text": "你，刚变成，半个僵尸，要注意，几件事…",
            "nextDialogs": [
              "110291302"
            ]
          },
          "110291302": {
            "id": "110291302",
            "speakerId": 13136,
            "speakerName": "嘉良",
            "text": "呃，前辈…请说？",
            "nextDialogs": [
              "110291303"
            ]
          },
          "110291303": {
            "id": "110291303",
            "speakerId": 10233,
            "speakerName": "七七",
            "text": "第一，不要忘了，柔软体操…第二，不要忘了…",
            "nextDialogs": [
              "110291304"
            ]
          },
          "110291304": {
            "id": "110291304",
            "speakerId": 13136,
            "speakerName": "嘉良",
            "text": "嗯嗯…不要忘了什么？",
            "nextDialogs": [
              "110291305"
            ]
          },
          "110291305": {
            "id": "110291305",
            "speakerId": 10233,
            "speakerName": "七七",
            "text": "…忘了。"
          }
        }
      }
    },
    {
      "subId": "1102906",
      "subQuestName": "跟随江蓠",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [],
        "dialogs": {}
      }
    },
    {
      "subId": "1102907",
      "subQuestName": "与江蓠对话",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "110290701"
        ],
        "dialogs": {
          "110290701": {
            "id": "110290701",
            "speakerId": 13137,
            "speakerName": "江蓠",
            "text": "…我已看过你的不死药，其中药理，与我所炼之毒，有几分相似。",
            "nextDialogs": [
              "110290702"
            ]
          },
          "110290702": {
            "id": "110290702",
            "speakerId": 10234,
            "speakerName": "白术",
            "text": "…以毒素维系生前的状态，的确是个绝妙的构思。师姐不会是要怪我擅自效仿了吧？",
            "nextDialogs": [
              "110290703"
            ]
          },
          "110290703": {
            "id": "110290703",
            "speakerId": 13137,
            "speakerName": "江蓠",
            "text": "怎么会，以你的资质，即便没有先例，假以时日，也能自行推演出来吧。",
            "nextDialogs": [
              "110290704"
            ]
          },
          "110290704": {
            "id": "110290704",
            "speakerId": 13137,
            "speakerName": "江蓠",
            "text": "但从你与嘉良相遇至今，不过区区数日，就能将这毒研究得如此透彻…",
            "nextDialogs": [
              "110290705"
            ]
          },
          "110290705": {
            "id": "110290705",
            "speakerId": 13137,
            "speakerName": "江蓠",
            "text": "甚至还借它改进了原有的药方——这就不是资质可以解释的了。",
            "nextDialogs": [
              "110290706"
            ]
          },
          "110290706": {
            "id": "110290706",
            "speakerId": 13137,
            "speakerName": "江蓠",
            "text": "白术，你如实告诉我，你…可是亲自试过毒了？",
            "nextDialogs": [
              "110290707"
            ]
          },
          "110290707": {
            "id": "110290707",
            "speakerId": 1004,
            "speakerName": "长生",
            "text": "哈，我就说你藏不了多久。",
            "nextDialogs": [
              "110290708"
            ]
          },
          "110290708": {
            "id": "110290708",
            "speakerId": 13137,
            "speakerName": "江蓠",
            "text": "长生的契约，能转移的…恐怕不只是生机吧？",
            "nextDialogs": [
              "110290709"
            ]
          },
          "110290709": {
            "id": "110290709",
            "speakerId": 10234,
            "speakerName": "白术",
            "text": "…果然还是瞒不过师姐啊。",
            "nextDialogs": [
              "110290710"
            ]
          },
          "110290710": {
            "id": "110290710",
            "speakerId": 10234,
            "speakerName": "白术",
            "text": "不错，除了生机，长生的秘法，还能转移毒素与疾病。",
            "nextDialogs": [
              "110290711"
            ]
          },
          "110290711": {
            "id": "110290711",
            "speakerId": 10234,
            "speakerName": "白术",
            "text": "第二次为嘉良治疗时，我就向自己转移了部分毒素，聊以减轻他的负担，也利于深研其毒性…",
            "nextDialogs": [
              "110290712"
            ]
          },
          "110290712": {
            "id": "110290712",
            "speakerId": 10234,
            "speakerName": "白术",
            "text": "不过眼下所有余毒，皆已随魔神残渣而去，师姐也不必再担心了。",
            "nextDialogs": [
              "110290713"
            ]
          },
          "110290713": {
            "id": "110290713",
            "speakerId": 13137,
            "speakerName": "江蓠",
            "text": "…这也太冒险了。如果那时候没有除掉魔神残渣，就连你自己的身体也——",
            "nextDialogs": [
              "110290714"
            ]
          },
          "110290714": {
            "id": "110290714",
            "speakerId": 13137,
            "speakerName": "江蓠",
            "text": "…哈，我又有什么资格说你呢？",
            "nextDialogs": [
              "110290715"
            ]
          },
          "110290715": {
            "id": "110290715",
            "speakerId": 13137,
            "speakerName": "江蓠",
            "text": "当年我之所以远离师门、避而不见，就是不想让时日无多的师父继续折损寿命，来医治嘉良。",
            "nextDialogs": [
              "110290716"
            ]
          },
          "110290716": {
            "id": "110290716",
            "speakerId": 13137,
            "speakerName": "江蓠",
            "text": "却没想到最后，我冒险炼毒，一样是以命换命。而你以身试毒…一个两个，全走上了师父他们的老路。",
            "nextDialogs": [
              "110290717"
            ]
          },
          "110290717": {
            "id": "110290717",
            "speakerId": 13137,
            "speakerName": "江蓠",
            "text": "难道这就是我们这一脉的宿命吗？为了救人的执念短寿而终，执着于忤逆生死的奇迹…不可自拔。",
            "nextDialogs": [
              "110290718"
            ]
          },
          "110290718": {
            "id": "110290718",
            "speakerId": 10234,
            "speakerName": "白术",
            "text": "…宿命一说，可不该从一名医者口中讲出来啊。",
            "nextDialogs": [
              "110290719"
            ]
          },
          "110290719": {
            "id": "110290719",
            "speakerId": 13137,
            "speakerName": "江蓠",
            "text": "白术，我看得出来，这些年里，你已经用契约向自己转移了许多病与毒，其中有不少已经连我都看不透了…",
            "nextDialogs": [
              "110290720"
            ]
          },
          "110290720": {
            "id": "110290720",
            "speakerId": 13137,
            "speakerName": "江蓠",
            "text": "你…还可以收手吗？",
            "nextDialogs": [
              "110290721"
            ]
          },
          "110290721": {
            "id": "110290721",
            "speakerId": 10234,
            "speakerName": "白术",
            "text": "师姐，你是知道的，我们这一脉，个个都是这性格…",
            "nextDialogs": [
              "110290722"
            ]
          },
          "110290722": {
            "id": "110290722",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "喂——开饭啦——",
            "nextDialogs": [
              "110290723"
            ]
          },
          "110290723": {
            "id": "110290723",
            "speakerId": 13135,
            "speakerName": "阿雩",
            "text": "妈！来吃饭啦！",
            "nextDialogs": [
              "110290724"
            ]
          },
          "110290724": {
            "id": "110290724",
            "speakerId": 13135,
            "speakerName": "阿雩",
            "text": "#{M#大哥哥}{F#大姐姐}教我做了好多菜，说是连爹也能尝出味道！你也来试试吧！",
            "nextDialogs": [
              "110290725"
            ]
          },
          "110290725": {
            "id": "110290725",
            "speakerId": 13137,
            "speakerName": "江蓠",
            "text": "好好好，妈这就来…欸，慢点跑！",
            "nextDialogs": [
              "110290726"
            ]
          },
          "110290726": {
            "id": "110290726",
            "speakerId": 13137,
            "speakerName": "江蓠",
            "text": "…白术，我知道自己劝不动你，但…还请不要忘了，如果你不在…",
            "nextDialogs": [
              "110290727"
            ]
          },
          "110290727": {
            "id": "110290727",
            "speakerId": 13137,
            "speakerName": "江蓠",
            "text": "七七、阿桂…所有亲近你的朋友，都会为你伤心的。",
            "nextDialogs": [
              "110290728"
            ]
          },
          "110290728": {
            "id": "110290728",
            "speakerId": 10234,
            "speakerName": "白术",
            "text": "师姐不必挂心，我自有分寸。",
            "nextDialogs": [
              "110290729"
            ]
          },
          "110290729": {
            "id": "110290729",
            "speakerId": 13137,
            "speakerName": "江蓠",
            "text": "唉…但愿如此。",
            "nextDialogs": [
              "110290730"
            ]
          },
          "110290730": {
            "id": "110290730",
            "speakerId": 10234,
            "speakerName": "白术",
            "text": "……",
            "nextDialogs": [
              "110290731"
            ]
          },
          "110290731": {
            "id": "110290731",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "白术…江蓠她刚刚说，你不在了，是什么意思？你、你该不会有事吧？",
            "nextDialogs": [
              "110290734"
            ]
          },
          "110290734": {
            "id": "110290734",
            "speakerId": 1004,
            "speakerName": "长生",
            "text": "…包括他们的师父在内，我的历代契约者，无不短寿而终——",
            "nextDialogs": [
              "110290735"
            ]
          },
          "110290735": {
            "id": "110290735",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "怎——怎么会这样！长生你不是能让人延年益寿的吗！",
            "nextDialogs": [
              "110290736"
            ]
          },
          "110290736": {
            "id": "110290736",
            "speakerId": 10234,
            "speakerName": "白术",
            "text": "这就是，一个很长、很长的故事了…",
            "nextDialogs": [
              "110290737"
            ]
          },
          "110290737": {
            "id": "110290737",
            "speakerId": 1004,
            "speakerName": "长生",
            "text": "…继承契约，对心性也有要求。历代契约者，心性皆至纯。",
            "nextDialogs": [
              "110290738"
            ]
          },
          "110290738": {
            "id": "110290738",
            "speakerId": 10234,
            "speakerName": "白术",
            "text": "然而至善之人得此秘法，却比常人，更容易被这忤逆生死的奇迹吸引。",
            "nextDialogs": [
              "110290739"
            ]
          },
          "110290739": {
            "id": "110290739",
            "speakerId": 10234,
            "speakerName": "白术",
            "text": "即便他们比谁都清楚结果会如何，但面对芸芸众生的悲呼哀鸣，至亲挚友的生老病死，终究还是会动用非人的力量。",
            "nextDialogs": [
              "110290740"
            ]
          },
          "110290740": {
            "id": "110290740",
            "speakerId": 10234,
            "speakerName": "白术",
            "text": "…就如扑火的飞蛾，在众生皆苦的长夜中，追寻超脱生死的希望。",
            "nextDialogs": [
              "110290741"
            ]
          },
          "110290741": {
            "id": "110290741",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "那…白术你岂不是…",
            "nextDialogs": [
              "110290742"
            ]
          },
          "110290742": {
            "id": "110290742",
            "speakerId": 10234,
            "speakerName": "白术",
            "text": "呵呵…至于我，大概就是那只既想追寻光明，又不想被烧着的蛾子了吧？",
            "nextDialogs": [
              "110290743"
            ]
          },
          "110290743": {
            "id": "110290743",
            "speakerId": 10234,
            "speakerName": "白术",
            "text": "长生的秘法，只是转移了病痛，却无法减少世间疾苦——就像嘉良会为师姐的危情慌乱，师姐也会为嘉良的牺牲悲恸。",
            "nextDialogs": [
              "110290744"
            ]
          },
          "110290744": {
            "id": "110290744",
            "speakerId": 10234,
            "speakerName": "白术",
            "text": "…我尊敬那些为了理想献上生命的师长们，但我并不打算成为他们，也不希望这份契约，继续流传于后人。",
            "nextDialogs": [
              "110290745"
            ]
          },
          "110290745": {
            "id": "110290745",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "欸…可是，你都往身上转移了那么多病…",
            "nextDialogs": [
              "110290746"
            ]
          },
          "110290746": {
            "id": "110290746",
            "speakerId": 10234,
            "speakerName": "白术",
            "text": "——毒是什么？病又是什么？本质上，不都是一种影响人体的方式吗？",
            "nextDialogs": [
              "110290747"
            ]
          },
          "110290747": {
            "id": "110290747",
            "speakerId": 10234,
            "speakerName": "白术",
            "text": "如果说不同于「平常」的表现，就能被称之为「病」。那么「不死药」…会不会也是一种「毒」呢？",
            "nextDialogs": [
              "110290748"
            ]
          },
          "110290748": {
            "id": "110290748",
            "speakerId": 10234,
            "speakerName": "白术",
            "text": "穷究百毒百病，以达不死之境…即便在常人看来有悖天理，但于我而言，这跟先人们遍尝百草，克服百病并无区别。",
            "nextDialogs": [
              "110290749"
            ]
          },
          "110290749": {
            "id": "110290749",
            "speakerId": 10234,
            "speakerName": "白术",
            "text": "我既不想让后来者继续因契约而短寿，也不想让长生失去契约而逝…那么答案，不就只有一个了吗？",
            "nextDialogs": [
              "110290750"
            ]
          },
          "110290750": {
            "id": "110290750",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "不死之药…",
            "nextDialogs": [
              "110290751"
            ]
          },
          "110290751": {
            "id": "110290751",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "长生不老…",
            "nextDialogs": [
              "110290752"
            ]
          },
          "110290752": {
            "id": "110290752",
            "speakerId": 10234,
            "speakerName": "白术",
            "text": "不错——我会成为最后一任契约者，让契约的传承，在我身上终结。",
            "nextDialogs": [
              "110290753"
            ]
          },
          "110290753": {
            "id": "110290753",
            "speakerId": 1004,
            "speakerName": "长生",
            "text": "…真正的不死，就连当年的魔神们都难以企及。既想救人、又想救己，最后连我也想救，可真是太贪心了。",
            "nextDialogs": [
              "110290754"
            ]
          },
          "110290754": {
            "id": "110290754",
            "speakerId": 10234,
            "speakerName": "白术",
            "text": "呵，若不贪心，还是凡人吗？",
            "nextDialogs": [
              "110290755"
            ]
          },
          "110290755": {
            "id": "110290755",
            "speakerId": 10234,
            "speakerName": "白术",
            "text": "…畏惧烛火，却又向往光明，如此自私的蛾子——就只能往月亮上飞了啊。",
            "nextDialogs": [
              "110290756"
            ]
          },
          "110290756": {
            "id": "110290756",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "欸…我都不知道该说你什么好了。",
            "nextDialogs": [
              "110290757"
            ]
          },
          "110290757": {
            "id": "110290757",
            "speakerId": 13135,
            "speakerName": "阿雩",
            "text": "#白先生！{M#大哥哥}{F#大姐姐}！你们还在聊什么呢？快来吃饭啦！",
            "nextDialogs": [
              "110290758"
            ]
          },
          "110290758": {
            "id": "110290758",
            "speakerId": 10233,
            "speakerName": "七七",
            "text": "还有，长生、派蒙，可以来喝，椰奶…",
            "nextDialogs": [
              "110290759"
            ]
          },
          "110290759": {
            "id": "110290759",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "唔唔…算了，还是吃饭要紧！别的事情，就等吃饱了再想吧！"
          }
        }
      }
    },
    {
      "subId": "1102915",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "110291501"
        ],
        "dialogs": {
          "110291501": {
            "id": "110291501",
            "speakerId": 1004,
            "speakerName": "长生",
            "text": "江蓠还在等我们呢，先去跟她聊聊吧？"
          }
        }
      }
    },
    {
      "subId": "1102999",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "110299902"
        ],
        "dialogs": {
          "110299902": {
            "id": "110299902",
            "speakerId": 13136,
            "speakerName": "嘉良",
            "text": "…心脏，在隐隐作痛…方向没错。",
            "nextDialogs": [
              "110299903"
            ]
          },
          "110299903": {
            "id": "110299903",
            "speakerId": 13136,
            "speakerName": "嘉良",
            "text": "这个地方…我好像来过。",
            "nextDialogs": [
              "110299904"
            ]
          },
          "110299904": {
            "id": "110299904",
            "speakerId": 13136,
            "speakerName": "嘉良",
            "text": "我能感觉到…已经很近了…",
            "nextDialogs": [
              "110299905"
            ]
          },
          "110299905": {
            "id": "110299905",
            "speakerId": 13136,
            "speakerName": "嘉良",
            "text": "就是在这前面，我和她立下了约定…呃…",
            "nextDialogs": [
              "110299906"
            ]
          },
          "110299906": {
            "id": "110299906",
            "speakerId": 1004,
            "speakerName": "长生",
            "text": "……",
            "nextDialogs": [
              "110299907"
            ]
          },
          "110299907": {
            "id": "110299907",
            "speakerId": 13136,
            "speakerName": "嘉良",
            "text": "……",
            "nextDialogs": [
              "110299911"
            ]
          },
          "110299911": {
            "id": "110299911",
            "speakerId": 13137,
            "speakerName": "江蓠",
            "text": "自从谷中一别，不知不觉，都已经过去这么久了啊。",
            "nextDialogs": [
              "110299912"
            ]
          },
          "110299912": {
            "id": "110299912",
            "speakerId": 13137,
            "speakerName": "江蓠",
            "text": "长生还是老样子，一点儿都没变。",
            "nextDialogs": [
              "110299913"
            ]
          },
          "110299913": {
            "id": "110299913",
            "speakerId": 1004,
            "speakerName": "长生",
            "text": "你倒是变了不少呀。",
            "nextDialogs": [
              "110299914"
            ]
          },
          "110299914": {
            "id": "110299914",
            "speakerId": 13137,
            "speakerName": "江蓠",
            "text": "…是啊，当年的我，怎么都想不到，会有这么一天。",
            "nextDialogs": [
              "110299915"
            ]
          },
          "110299915": {
            "id": "110299915",
            "speakerId": 13137,
            "speakerName": "江蓠",
            "text": "…也想不到，连白术你也会变成这样。"
          }
        }
      }
    }
  ]
}
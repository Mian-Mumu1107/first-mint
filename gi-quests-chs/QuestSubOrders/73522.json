{
  "lineCounts": {
    "Player": 1,
    "丽什蒂": 14,
    "多莉": 9,
    "派蒙": 3
  },
  "subQuests": [
    {
      "subId": "7352201",
      "subQuestName": "向多莉打听情报",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "735220101"
        ],
        "dialogs": {
          "735220101": {
            "id": "735220101",
            "speakerId": 1055,
            "speakerName": "多莉",
            "text": "又到了桑歌玛哈巴依老爷的情报售卖时间！",
            "nextDialogs": [
              "735220102"
            ]
          },
          "735220102": {
            "id": "735220102",
            "speakerId": 1055,
            "speakerName": "多莉",
            "text": "两位客人要不要买一份最新的情报呢？让我看看，这次的情报不怎么重要，所以只卖五十万摩拉！",
            "nextDialogs": [
              "735220103"
            ]
          },
          "735220103": {
            "id": "735220103",
            "speakerId": 1055,
            "speakerName": "多莉",
            "text": "相较于之前的价格，竟然直接便宜了一半，真是太划算了！",
            "nextDialogs": [
              "735220104"
            ]
          },
          "735220104": {
            "id": "735220104",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "可以送我吗？",
            "nextDialogs": [
              "735220105"
            ]
          },
          "735220105": {
            "id": "735220105",
            "speakerId": 1055,
            "speakerName": "多莉",
            "text": "咳咳，竟然一口气砍到零摩拉，真是出我所料…",
            "nextDialogs": [
              "735220106"
            ]
          },
          "735220106": {
            "id": "735220106",
            "speakerId": 1055,
            "speakerName": "多莉",
            "text": "不过谁叫我是好心的桑歌玛哈巴依老爷呢？既然你如此感兴趣，那我就免费告诉你，但你可不能外传啦。",
            "nextDialogs": [
              "735220107"
            ]
          },
          "735220107": {
            "id": "735220107",
            "speakerId": 1055,
            "speakerName": "多莉",
            "text": "听说二十年前有一位参赛者，参加比赛后性格却突然发生了很大的转变！",
            "nextDialogs": [
              "735220108"
            ]
          },
          "735220108": {
            "id": "735220108",
            "speakerId": 1055,
            "speakerName": "多莉",
            "text": "然后呢，貌似有人曾在阿如村见过他哦。不知道他最后去了哪里呢？",
            "nextDialogs": [
              "735220109"
            ]
          },
          "735220109": {
            "id": "735220109",
            "speakerId": 1055,
            "speakerName": "多莉",
            "text": "免费消息到此为止，想听后续的话，请付两百万摩拉。谢谢惠顾！",
            "nextDialogs": [
              "735220110"
            ]
          },
          "735220110": {
            "id": "735220110",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "怎么想都不划算！我们自己去阿如村打听一下好了！"
          }
        }
      }
    },
    {
      "subId": "7352202",
      "subQuestName": "与阿如村的知情者聊天",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "735220201"
        ],
        "dialogs": {
          "735220201": {
            "id": "735220201",
            "speakerId": 30356,
            "speakerName": "丽什蒂",
            "text": "二十年前…确实有一位年轻人曾经来过。",
            "nextDialogs": [
              "735220202"
            ]
          },
          "735220202": {
            "id": "735220202",
            "speakerId": 30356,
            "speakerName": "丽什蒂",
            "text": "那时候，生活比现在要艰苦多了。贫穷、疾病、愚昧…时刻困扰着我们。",
            "nextDialogs": [
              "735220203"
            ]
          },
          "735220203": {
            "id": "735220203",
            "speakerId": 30356,
            "speakerName": "丽什蒂",
            "text": "那名年轻人，明明是教令院出身，有着大好的前程，却甘愿跑来我们这里受苦。",
            "nextDialogs": [
              "735220204"
            ]
          },
          "735220204": {
            "id": "735220204",
            "speakerId": 30356,
            "speakerName": "丽什蒂",
            "text": "他教给我们知识，告诉我们如何应对沙暴与魔物；他自掏腰包为我们添置了很多药材，照顾病人也是亲力亲为。",
            "nextDialogs": [
              "735220205"
            ]
          },
          "735220205": {
            "id": "735220205",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "听上去是个大好人！",
            "nextDialogs": [
              "735220206"
            ]
          },
          "735220206": {
            "id": "735220206",
            "speakerId": 30356,
            "speakerName": "丽什蒂",
            "text": "是啊…只可惜好人不长命。",
            "nextDialogs": [
              "735220207"
            ]
          },
          "735220207": {
            "id": "735220207",
            "speakerId": 30356,
            "speakerName": "丽什蒂",
            "text": "他总是皱着眉，没人知道他在为什么发愁。大家就想啊，会不会是他要离开了？这里太穷了，甚至没法好好招待他。",
            "nextDialogs": [
              "735220208"
            ]
          },
          "735220208": {
            "id": "735220208",
            "speakerId": 30356,
            "speakerName": "丽什蒂",
            "text": "不过，也有很多人说他原本就有些疯癫。比如他有时候还会给孩子们讲故事，讲自己小时候曾经教一种奇特生物写字的故事。",
            "nextDialogs": [
              "735220209"
            ]
          },
          "735220209": {
            "id": "735220209",
            "speakerId": 30356,
            "speakerName": "丽什蒂",
            "text": "后来，他经常离开村子，去沙漠里考察。有一次我问他在找什么，他说自己要与那伽什么团的人聊聊。",
            "nextDialogs": [
              "735220210"
            ]
          },
          "735220210": {
            "id": "735220210",
            "speakerId": 30356,
            "speakerName": "丽什蒂",
            "text": "再后来，听说他死在了流沙中。据说是考察的路上遇见了陷入流沙的商队，他救了很多人，自己却没回来…",
            "nextDialogs": [
              "735220211"
            ]
          },
          "735220211": {
            "id": "735220211",
            "speakerId": 30356,
            "speakerName": "丽什蒂",
            "text": "当时，家里还有他没写完的半封信，是写给他的孩子的。他死后，我的儿子将那封残信带在身上，想着今后或许有机会帮他转交。",
            "nextDialogs": [
              "735220212"
            ]
          },
          "735220212": {
            "id": "735220212",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "那封信…还在吗？",
            "nextDialogs": [
              "735220213"
            ]
          },
          "735220213": {
            "id": "735220213",
            "speakerId": 30356,
            "speakerName": "丽什蒂",
            "text": "不在啦。不在了…",
            "nextDialogs": [
              "735220214"
            ]
          },
          "735220214": {
            "id": "735220214",
            "speakerId": 30356,
            "speakerName": "丽什蒂",
            "text": "为了过上好一点的生活，我的儿子当了佣兵。几年前的一场混战里，他丢了命，身上的东西也被搜走了。",
            "nextDialogs": [
              "735220215"
            ]
          },
          "735220215": {
            "id": "735220215",
            "speakerId": 30356,
            "speakerName": "丽什蒂",
            "text": "一晃都过去这么些年了啊。不知道他的孩子有没有健健康康地长大、会不会记恨他呢？",
            "nextDialogs": [
              "735220216"
            ]
          },
          "735220216": {
            "id": "735220216",
            "speakerId": 30356,
            "speakerName": "丽什蒂",
            "text": "这些事，已经没有多少人知道了。我也老了，估计很快就会忘干净了吧。"
          }
        }
      }
    },
    {
      "subId": "7352203",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "735220301"
        ],
        "dialogs": {
          "735220301": {
            "id": "735220301",
            "speakerId": 1055,
            "speakerName": "多莉",
            "text": "嗯…你们应该也意识到什么了吧？"
          }
        }
      }
    }
  ]
}
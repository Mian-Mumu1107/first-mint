    {
      "subId": "7502501",
      "subQuestName": "等待龙伙伴玩耍归来$HIDDEN",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "750250101"
        ],
        "dialogs": {
          "750250101": {
            "id": "750250101",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "呜啊，这是什么神奇的地方？居然有这么多小嵴锋龙…",
            "nextDialogs": [
              "750250102"
            ]
          },
          "750250102": {
            "id": "750250102",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "难道是什么嵴锋龙的…聚集地？",
            "nextDialogs": [
              "750250103"
            ]
          },
          "750250103": {
            "id": "750250103",
            "speakerId": 14662,
            "speakerName": "#{REALNAME[ID(2)|SHOWHOST(true)]}",
            "text": "呀！…唔呀？",
            "nextDialogs": [
              "750250104"
            ]
          },
          "750250104": {
            "id": "750250104",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "#难得遇到这么多同伴，{REALNAME[ID(2)|SHOWHOST(true)]}看上去也显得很兴奋呢…",
            "nextDialogs": [
              "750250105"
            ]
          },
          "750250105": {
            "id": "750250105",
            "speakerId": 14662,
            "speakerName": "#{REALNAME[ID(2)|SHOWHOST(true)]}",
            "text": "呀？",
            "nextDialogs": [
              "750250106"
            ]
          },
          "750250106": {
            "id": "750250106",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "#哦，你是想去那边和它们一起玩吗？唔，{NICKNAME}，这么一想，{REALNAME[ID(2)|SHOWHOST(true)]}确实很少和小嵴锋龙们一起…",
            "nextDialogs": [
              "750250109"
            ]
          },
          "750250109": {
            "id": "750250109",
            "speakerId": 14662,
            "speakerName": "#{REALNAME[ID(2)|SHOWHOST(true)]}",
            "text": "呀！",
            "nextDialogs": [
              "750250110"
            ]
          },
          "750250110": {
            "id": "750250110",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "#虽然还是有点担心，不过现在我们就找个地方坐下来，边吃东西边聊天，等着{REALNAME[ID(2)|SHOWHOST(true)]}好了。",
            "nextDialogs": [
              "750250111"
            ]
          },
          "750250111": {
            "id": "750250111",
            "speakerId": 1002,
            "speakerName": "Black Screen",
            "text": "#你和派蒙在附近找到了一块不错的休息处，等待{REALNAME[ID(2)|SHOWHOST(true)]}结束游玩归来。",
            "nextDialogs": [
              "750250112"
            ]
          },
          "750250112": {
            "id": "750250112",
            "speakerId": 1002,
            "speakerName": "Black Screen",
            "text": "只不过，等待的时间似乎长了一些…",
            "nextDialogs": [
              "750250113"
            ]
          },
          "750250113": {
            "id": "750250113",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "#…咦，{REALNAME[ID(2)|SHOWHOST(true)]}怎么还没有回来？",
            "nextDialogs": [
              "750250114"
            ]
          },
          "750250114": {
            "id": "750250114",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "不会是出了什么事了吧…",
            "nextDialogs": [
              "750250115"
            ]
          },
          "750250115": {
            "id": "750250115",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "也许是玩得太开心了？",
            "nextDialogs": [
              "750250116"
            ]
          },
          "750250116": {
            "id": "750250116",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "要是这样，也得好好说说它，天都要黑了还不回来！",
            "nextDialogs": [
              "750250117"
            ]
          },
          "750250117": {
            "id": "750250117",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "唔…我们快点去找找它吧。"
          }
        }
      }
    },

        "dialogs": {
          "730750101": {
            "id": "730750101",
            "speakerId": 20607,
            "speakerName": "兰那库拉",
            "text": "#那菈{NICKNAME}和派蒙，谢谢你们，现在桓那兰那的苗圃生满了毗波耶。",
            "nextDialogs": [
              "730750102"

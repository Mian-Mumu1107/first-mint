          },
          "730750102": {
            "id": "730750102",
            "speakerId": 20816,
            "speakerName": "兰伽卢",
            "text": "这里的毗波耶都很高兴，所以，兰伽卢也高兴。",
            "nextDialogs": [
              "730750103"
            ]
          },
          "730750103": {
            "id": "730750103",
            "speakerId": 20607,
            "speakerName": "兰那库拉",
            "text": "无忧节已经结束，在金色的那菈离开桓那以前…",
            "nextDialogs": [
              "730750104"
            ]
          },
          "730750104": {
            "id": "730750104",
            "speakerId": 1002,
            "speakerName": "Black Screen",
            "text": "获得了一株毗波耶。",
            "nextDialogs": [
              "730750105"
            ]
          },
          "730750105": {
            "id": "730750105",
            "speakerId": 20607,
            "speakerName": "兰那库拉",
            "text": "#高兴的毗波耶，送给金色的那菈，希望那菈{NICKNAME}和派蒙也能高兴。虽然这株毗波耶不会凋零，但是…",
            "nextDialogs": [
              "730750106"
            ]
          },
          "730750106": {
            "id": "730750106",
            "speakerId": 20816,
            "speakerName": "兰伽卢",
            "text": "记得偶尔和它说话，最好能演奏乐曲给它听。",
            "nextDialogs": [
              "730750107"
            ]
          },
          "730750107": {
            "id": "730750107",
            "speakerId": 20607,
            "speakerName": "兰那库拉",
            "text": "#大地不会忘记，兰那罗不会忘记，希望那菈{NICKNAME}和派蒙也不要忘记…"
          }
        }
      }

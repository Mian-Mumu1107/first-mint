  "subQuests": [
    {
      "subId": "7614901",
      "subQuestName": "(test)隐藏$HIDDEN",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "761490101"
        ],
        "dialogs": {
          "761490101": {
            "id": "761490101",
            "speakerId": 1000,
            "speakerName": "？？？",
            "text": "是谁？是谁！？",
            "nextDialogs": [
              "761490102"
            ]
          },
          "761490102": {
            "id": "761490102",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "#{NICKNAME}。如今这个时代的人。",
            "nextDialogs": [
              "761490103"
            ]
          },
          "761490103": {
            "id": "761490103",
            "speakerId": 1001,
            "speakerName": "阿罗逻",
            "text": "虽然我不知道你们的时代，但是我叫阿罗逻，本是寂静期行者。",
            "nextDialogs": [
              "761490104"
            ]
          },
          "761490104": {
            "id": "761490104",
            "speakerId": 1001,
            "speakerName": "阿罗逻",
            "text": "来到这里已经记不得时间了。甚至这里把我的寂静之修行破掉了。",
            "nextDialogs": [
              "761490105"
            ]
          },
          "761490105": {
            "id": "761490105",
            "speakerId": 1001,
            "speakerName": "阿罗逻",
            "text": "果然，无念无想的修行会让人投生无想恶天啊。",
            "nextDialogs": [
              "761490106"
            ]
          },
          "761490106": {
            "id": "761490106",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "举手之劳。",
            "nextDialogs": [
              "761490107"
            ]
          },
          "761490107": {
            "id": "761490107",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "千万别谢谢我。",
            "nextDialogs": [
              "761490108"
            ]
          },
          "761490108": {
            "id": "761490108",
            "speakerId": 1001,
            "speakerName": "阿罗逻",
            "text": "谢谢啊！",
            "nextDialogs": [
              "761490109"
            ]
          },
          "761490109": {
            "id": "761490109",
            "speakerId": 1002,
            "speakerName": "伊斯托利亚",
            "text": "虽然救你是顺手而为。不过我们准备找找冥想之外的办法离开这里。",
            "nextDialogs": [
              "761490110"
            ]
          },
          "761490110": {
            "id": "761490110",
            "speakerId": 1001,
            "speakerName": "阿罗逻",
            "text": "你们不擅长冥想吗？或者你们的时代不教授这种技术？",
            "nextDialogs": [
              "761490111"
            ]
          },
          "761490111": {
            "id": "761490111",
            "speakerId": 1002,
            "speakerName": "伊斯托利亚",
            "text": "我第一次离开这里花了数百年的岁月。我舍弃了我对真理的追求，舍弃了见到亲朋的渴爱。",
            "nextDialogs": [
              "761490112"
            ]
          },
          "761490112": {
            "id": "761490112",
            "speakerId": 1002,
            "speakerName": "伊斯托利亚",
            "text": "这一次我不愿意再放弃这些了。",
            "nextDialogs": [
              "761490113"
            ]
          },
          "761490113": {
            "id": "761490113",
            "speakerId": 1001,
            "speakerName": "阿罗逻",
            "text": "算我一个。",
            "nextDialogs": [
              "761490114"
            ]
          },
          "761490114": {
            "id": "761490114",
            "speakerId": 1003,
            "speakerName": "小右",
            "text": "！",
            "nextDialogs": [
              "761490115"
            ]
          },
          "761490115": {
            "id": "761490115",
            "speakerId": 1002,
            "speakerName": "伊斯托利亚",
            "text": "小右又捡到一个「念亡碎片」。",
            "nextDialogs": [
              "761490116"
            ]
          },
          "761490116": {
            "id": "761490116",
            "speakerId": 1001,
            "speakerName": "阿罗逻",
            "text": "念亡？哦，死随念这种冥想技术我也知道。它能让人锻炼面对死亡之时的心境。",
            "nextDialogs": [
              "761490117"
            ]
          },
          "761490117": {
            "id": "761490117",
            "speakerId": 1002,
            "speakerName": "伊斯托利亚",
            "text": "既然找到琳德了。我们就去找找出去的办法吧。",
            "nextDialogs": [
              "761490118"
            ]
          },
          "761490118": {
            "id": "761490118",
            "speakerId": 1001,
            "speakerName": "阿罗逻",
            "text": "这里真的可以靠实力出去吗？",
            "nextDialogs": [
              "761490119"
            ]
          },
          "761490119": {
            "id": "761490119",
            "speakerId": 1002,
            "speakerName": "伊斯托利亚",
            "text": "既然梅兰塔和尼西里塔可以自由往来，通常都还会带人出入。那小右应该也可以。",
            "nextDialogs": [
              "761490120"
            ]
          },
          "761490120": {
            "id": "761490120",
            "speakerId": 1003,
            "speakerName": "小右",
            "text": "♪~",
            "nextDialogs": [
              "761490121"
            ]
          },
          "761490121": {
            "id": "761490121",
            "speakerId": 1002,
            "speakerName": "伊斯托利亚",
            "text": "现在收集到了三枚「念亡碎片」。",
            "nextDialogs": [
              "761490122"
            ]
          },
          "761490122": {
            "id": "761490122",
            "speakerId": 1002,
            "speakerName": "伊斯托利亚",
            "text": "哦，这个是暂定名。因为我也不知道小右收集这个要做什么。",
            "nextDialogs": [
              "761490123"
            ]
          },
          "761490123": {
            "id": "761490123",
            "speakerId": 1002,
            "speakerName": "伊斯托利亚",
            "text": "小右，接下来怎么办？",
            "nextDialogs": [
              "761490124"
            ]
          },
          "761490124": {
            "id": "761490124",
            "speakerId": 1003,
            "speakerName": "小右",
            "text": "！",
            "nextDialogs": [
              "761490125"
            ]
          },
          "761490125": {
            "id": "761490125",
            "speakerId": 1002,
            "speakerName": "伊斯托利亚",
            "text": "跟着它指示的方向走吧。"
          }
        }
      }
    },

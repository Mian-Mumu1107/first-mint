  },
  "subQuests": [
    {
      "subId": "1201201",
      "subQuestName": "拜访老夫妻，寻求帮助",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "120120101"
        ],
        "dialogs": {
          "120120101": {
            "id": "120120101",
            "speakerId": 1000,
            "speakerName": "今谷香里",
            "text": "欸，这不是宵宫嘛，快来快来，进屋坐坐。",
            "nextDialogs": [
              "120120102"
            ]
          },
          "120120102": {
            "id": "120120102",
            "speakerId": 1000,
            "speakerName": "今谷香里",
            "text": "这边的是你的朋友吗？",
            "nextDialogs": [
              "120120103"
            ]
          },
          "120120103": {
            "id": "120120103",
            "speakerId": 1001,
            "speakerName": "宵宫",
            "text": "对啊，是远道而来的旅行者，现在有外人到稻妻来很不容易。",
            "nextDialogs": [
              "120120104"
            ]
          },
          "120120104": {
            "id": "120120104",
            "speakerId": 1002,
            "speakerName": "今谷三郎",
            "text": "是啊，现在情况特殊，不过既然来了，我们作为本地人，就要好好招待。",
            "nextDialogs": [
              "120120105"
            ]
          },
          "120120105": {
            "id": "120120105",
            "speakerId": 1001,
            "speakerName": "宵宫",
            "text": "嗯。对了，你们两位之前定的烟花，我也带过来了。",
            "nextDialogs": [
              "120120106"
            ]
          },
          "120120106": {
            "id": "120120106",
            "speakerId": 1002,
            "speakerName": "今谷三郎",
            "text": "哦，谢谢啊，每年都要麻烦你们家，先是你的爸爸，现在轮到你了。",
            "nextDialogs": [
              "120120107"
            ]
          },
          "120120107": {
            "id": "120120107",
            "speakerId": 1002,
            "speakerName": "今谷三郎",
            "text": "不知道有生之年，能不能等到「长野原烟花店」的下一任接班人啊。",
            "nextDialogs": [
              "120120108"
            ]
          },
          "120120108": {
            "id": "120120108",
            "speakerId": 1001,
            "speakerName": "宵宫",
            "text": "没问题的，两位现在身子骨这么硬朗，就别说不吉利的话啦。",
            "nextDialogs": [
              "120120109"
            ]
          },
          "120120109": {
            "id": "120120109",
            "speakerId": 1000,
            "speakerName": "今谷香里",
            "text": "唉，身子这东西，确实不如以前啦。",
            "nextDialogs": [
              "120120110"
            ]
          },
          "120120110": {
            "id": "120120110",
            "speakerId": 1000,
            "speakerName": "今谷香里",
            "text": "以前种田挑水什么的一点都不费劲，现在稍微干点活就腰酸背痛的。",
            "nextDialogs": [
              "120120111"
            ]
          },
          "120120111": {
            "id": "120120111",
            "speakerId": 1000,
            "speakerName": "今谷香里",
            "text": "昨天本来想把杂草除一下，结果弯下腰去，就有点直不起来了。",
            "nextDialogs": [
              "120120112"
            ]
          },
          "120120112": {
            "id": "120120112",
            "speakerId": 1001,
            "speakerName": "宵宫",
            "text": "这样啊，没关系，交给我们吧！",
            "nextDialogs": [
              "120120113"
            ]
          },
          "120120113": {
            "id": "120120113",
            "speakerId": 1002,
            "speakerName": "今谷三郎",
            "text": "哎，别别别，好不容易来一趟，怎么能让你们干活呢。",
            "nextDialogs": [
              "120120114"
            ]
          },
          "120120114": {
            "id": "120120114",
            "speakerId": 1002,
            "speakerName": "今谷三郎",
            "text": "我去拿点心和茶，边吃边聊吧。",
            "nextDialogs": [
              "120120115"
            ]
          },
          "120120115": {
            "id": "120120115",
            "speakerId": 1001,
            "speakerName": "宵宫",
            "text": "没关系啦，我不是总来帮你们做家务的嘛。最近是因为烟花会的事在忙，之后我还会经常来的。",
            "nextDialogs": [
              "120120116"
            ]
          },
          "120120116": {
            "id": "120120116",
            "speakerId": 1003,
            "speakerName": "派蒙",
            "text": "对我们来说是小事情啦，不用客气。",
            "nextDialogs": [
              "120120117"
            ]
          },
          "120120117": {
            "id": "120120117",
            "speakerId": 1000,
            "speakerName": "今谷香里",
            "text": "哎呀，你们就是懂事，不像我家那孩子，也老大不小的了，还是一个人，也总是不回家。",
            "nextDialogs": [
              "120120118"
            ]
          },
          "120120118": {
            "id": "120120118",
            "speakerId": 1000,
            "speakerName": "今谷香里",
            "text": "既然你都这么说了，我这里还腌了点咸萝卜，你能顺便带给村那边的小聪嘛？",
            "nextDialogs": [
              "120120119"
            ]
          },
          "120120119": {
            "id": "120120119",
            "speakerId": 1001,
            "speakerName": "宵宫",
            "text": "好啊，我们去去就来。",
            "nextDialogs": [
              "120120120"
            ]
          },
          "120120120": {
            "id": "120120120",
            "speakerId": 1001,
            "speakerName": "宵宫",
            "text": "跟我来吧，爷爷奶奶腿脚不利索，我们帮帮忙吧，先<color=#00E1FFFF>除草</color>，再去<color=#00E1FFFF>送咸萝卜</color>。"
          }
        }
      }
    },
    {
      "subId": "1201208",
      "subQuestName": "",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "120120801"
        ],
        "dialogs": {
          "120120801": {
            "id": "120120801",
            "speakerId": 1004,
            "speakerName": "聪",
            "text": "马上就是「长野原烟花会」了吧，我家孩子早就跑出去了。",
            "nextDialogs": [
              "120120802"
            ]
          },
          "120120802": {
            "id": "120120802",
            "speakerId": 1004,
            "speakerName": "聪",
            "text": "特别迫不及待，心思全写在脸上，谁不知道她是惦记城里的那个臭小子…",
            "nextDialogs": [
              "120120803"
            ]
          },
          "120120803": {
            "id": "120120803",
            "speakerId": 1004,
            "speakerName": "聪",
            "text": "…唉，她开心就好吧。"
          }
        }
      }
    },
    {
      "subId": "1201209",
      "subQuestName": "",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "120120901"
        ],
        "dialogs": {
          "120120901": {
            "id": "120120901",
            "speakerId": 1002,
            "speakerName": "今谷三郎",
            "text": "对不起啊，没能帮上你们的忙。",
            "nextDialogs": [
              "120120902"
            ]
          },
          "120120902": {
            "id": "120120902",
            "speakerId": 1000,
            "speakerName": "今谷香里",
            "text": "不过，那个孩子，总要学会面对他的心事。",
            "nextDialogs": [
              "120120903"
            ]
          },
          "120120903": {
            "id": "120120903",
            "speakerId": 1000,
            "speakerName": "今谷香里",
            "text": "这是作父母的，没办法教他的东西啊。"
          }
        }
      }
    },
    {
      "subId": "1201202",
      "subQuestName": "帮助老夫妻清理庭院",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [],
        "dialogs": {}
      }
    },
    {
      "subId": "1201204",
      "subQuestName": "将咸萝卜送给村里的聪",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "120120401"
        ],
        "dialogs": {
          "120120401": {
            "id": "120120401",
            "speakerId": 1001,
            "speakerName": "宵宫",
            "text": "聪叔叔你好，最近身体怎么样？",
            "nextDialogs": [
              "120120402"
            ]
          },
          "120120402": {
            "id": "120120402",
            "speakerId": 1004,
            "speakerName": "聪",
            "text": "还是老样子啊，没什么变化。你看起来也还是那么活泼啊。",
            "nextDialogs": [
              "120120403"
            ]
          },
          "120120403": {
            "id": "120120403",
            "speakerId": 1001,
            "speakerName": "宵宫",
            "text": "托大家的福嘛，我家的生意越来越好了。",
            "nextDialogs": [
              "120120404"
            ]
          },
          "120120404": {
            "id": "120120404",
            "speakerId": 1001,
            "speakerName": "宵宫",
            "text": "上次卖到璃月去的烟花，听说广受好评，估计之后的订单又要增加了。",
            "nextDialogs": [
              "120120405"
            ]
          },
          "120120405": {
            "id": "120120405",
            "speakerId": 1004,
            "speakerName": "聪",
            "text": "那你不是更辛苦了，和龙之介先生还忙得过来嘛？",
            "nextDialogs": [
              "120120406"
            ]
          },
          "120120406": {
            "id": "120120406",
            "speakerId": 1004,
            "speakerName": "聪",
            "text": "实在吃力的话，记得叫我帮忙哦。",
            "nextDialogs": [
              "120120407"
            ]
          },
          "120120407": {
            "id": "120120407",
            "speakerId": 1001,
            "speakerName": "宵宫",
            "text": "没问题啦，烟花的事情，可以自己解决。",
            "nextDialogs": [
              "120120408"
            ]
          },
          "120120408": {
            "id": "120120408",
            "speakerId": 1001,
            "speakerName": "宵宫",
            "text": "对了对了，这是香里奶奶托我给你送过来的咸萝卜。",
            "nextDialogs": [
              "120120409"
            ]
          },
          "120120409": {
            "id": "120120409",
            "speakerId": 1004,
            "speakerName": "聪",
            "text": "哎呀，真是谢谢，本来我以前都吃不惯咸萝卜的。",
            "nextDialogs": [
              "120120410"
            ]
          },
          "120120410": {
            "id": "120120410",
            "speakerId": 1004,
            "speakerName": "聪",
            "text": "尝了她的手艺可就忘不掉咯，现在都成我们家里人的习惯了。",
            "nextDialogs": [
              "120120411"
            ]
          },
          "120120411": {
            "id": "120120411",
            "speakerId": 1001,
            "speakerName": "宵宫",
            "text": "家里现在都还好吗？",
            "nextDialogs": [
              "120120412"
            ]
          },
          "120120412": {
            "id": "120120412",
            "speakerId": 1004,
            "speakerName": "聪",
            "text": "好啊，不过，偶尔也会闹闹脾气吧，家人不就是这样吗？",
            "nextDialogs": [
              "120120413"
            ]
          },
          "120120413": {
            "id": "120120413",
            "speakerId": 1004,
            "speakerName": "聪",
            "text": "我觉得，有亲人一直陪在身边，就算有矛盾，也比一直见不到面要好。",
            "nextDialogs": [
              "120120414"
            ]
          },
          "120120414": {
            "id": "120120414",
            "speakerId": 1004,
            "speakerName": "聪",
            "text": "虽然叔叔阿姨的感情很好，但孩子总是不回来，也挺孤单的吧。",
            "nextDialogs": [
              "120120415"
            ]
          },
          "120120415": {
            "id": "120120415",
            "speakerId": 1001,
            "speakerName": "宵宫",
            "text": "看上去其实也不会，他们好像已经习惯这样的日子了。",
            "nextDialogs": [
              "120120416"
            ]
          },
          "120120416": {
            "id": "120120416",
            "speakerId": 1001,
            "speakerName": "宵宫",
            "text": "不过你说得也很有道理，那我以后多来看看好了，至少有人能聊聊天什么的，就不会无聊了。",
            "nextDialogs": [
              "120120417"
            ]
          },
          "120120417": {
            "id": "120120417",
            "speakerId": 1004,
            "speakerName": "聪",
            "text": "好啊，绀田村的大家都希望你能多来看看呢。",
            "nextDialogs": [
              "120120418"
            ]
          },
          "120120418": {
            "id": "120120418",
            "speakerId": 1001,
            "speakerName": "宵宫",
            "text": "嘿嘿，谢谢啦。"
          }
        }
      }
    },
    {
      "subId": "1201205",
      "subQuestName": "回报老夫妻",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "120120501"
        ],
        "dialogs": {
          "120120501": {
            "id": "120120501",
            "speakerId": 1000,
            "speakerName": "今谷香里",
            "text": "不愧是年轻人啊，干事情就是利索。",
            "nextDialogs": [
              "120120502"
            ]
          },
          "120120502": {
            "id": "120120502",
            "speakerId": 1001,
            "speakerName": "宵宫",
            "text": "年轻人的精神用不完，老人见多识广经验丰富，各有各的厉害之处嘛。",
            "nextDialogs": [
              "120120503"
            ]
          },
          "120120503": {
            "id": "120120503",
            "speakerId": 1002,
            "speakerName": "今谷三郎",
            "text": "说起来，今年就正好五十年了。",
            "nextDialogs": [
              "120120504"
            ]
          },
          "120120504": {
            "id": "120120504",
            "speakerId": 1000,
            "speakerName": "今谷香里",
            "text": "是啊，一年一年这么过去，其实没什么明显的感觉，但一晃眼，就五十年了。",
            "nextDialogs": [
              "120120505"
            ]
          },
          "120120505": {
            "id": "120120505",
            "speakerId": 1003,
            "speakerName": "派蒙",
            "text": "五十年？是什么重要的日子吗？",
            "nextDialogs": [
              "120120506"
            ]
          },
          "120120506": {
            "id": "120120506",
            "speakerId": 1002,
            "speakerName": "今谷三郎",
            "text": "哈哈，那就要讲，五十年之前，这老婆子追我的时候…",
            "nextDialogs": [
              "120120507"
            ]
          },
          "120120507": {
            "id": "120120507",
            "speakerId": 1000,
            "speakerName": "今谷香里",
            "text": "在外人面前乱讲什么，明明是你发了疯地追我好不好。",
            "nextDialogs": [
              "120120508"
            ]
          },
          "120120508": {
            "id": "120120508",
            "speakerId": 1002,
            "speakerName": "今谷三郎",
            "text": "那这一段略过去，不讲。总之，就是在那年的「长野原烟花会」上，我向老婆子求了婚，然后就一起过日子了。",
            "nextDialogs": [
              "120120511"
            ]
          },
          "120120511": {
            "id": "120120511",
            "speakerId": 1002,
            "speakerName": "今谷三郎",
            "text": "其实本来也没下定决心的，抱着有点犹豫的心态找长野原做了烟花。",
            "nextDialogs": [
              "120120512"
            ]
          },
          "120120512": {
            "id": "120120512",
            "speakerId": 1002,
            "speakerName": "今谷三郎",
            "text": "烟花升起来，就到那时候也不知道要怎么开口。",
            "nextDialogs": [
              "120120513"
            ]
          },
          "120120513": {
            "id": "120120513",
            "speakerId": 1002,
            "speakerName": "今谷三郎",
            "text": "结果声音砰砰砰的，烟花点亮了天空，再看她的侧脸，那眼睛啊，倒映出烟花的光，闪闪发亮…",
            "nextDialogs": [
              "120120514"
            ]
          },
          "120120514": {
            "id": "120120514",
            "speakerId": 1002,
            "speakerName": "今谷三郎",
            "text": "也不知道怎么回事，回过神来的时候，我好像已经开了口，她还答应了我。",
            "nextDialogs": [
              "120120515"
            ]
          },
          "120120515": {
            "id": "120120515",
            "speakerId": 1000,
            "speakerName": "今谷香里",
            "text": "五十年说长也长，说短也短，不是什么了不起的事。",
            "nextDialogs": [
              "120120516"
            ]
          },
          "120120516": {
            "id": "120120516",
            "speakerId": 1000,
            "speakerName": "今谷香里",
            "text": "但携手走过五十年，也值得纪念一下吧。",
            "nextDialogs": [
              "120120517"
            ]
          },
          "120120517": {
            "id": "120120517",
            "speakerId": 1001,
            "speakerName": "宵宫",
            "text": "我之前不知道是五十年这么特殊的日子，早知道，应该给你们做一个特殊的，豪华版的烟花。",
            "nextDialogs": [
              "120120518"
            ]
          },
          "120120518": {
            "id": "120120518",
            "speakerId": 1000,
            "speakerName": "今谷香里",
            "text": "不用不用，就是以前的那种就行，每次烟花会都看，看不到才会不习惯呢。",
            "nextDialogs": [
              "120120519"
            ]
          },
          "120120519": {
            "id": "120120519",
            "speakerId": 1000,
            "speakerName": "今谷香里",
            "text": "只要看了烟花，就能想起那段日子。哪怕是上了年纪，也不会觉得自己的过去有什么遗憾。",
            "nextDialogs": [
              "120120520"
            ]
          },
          "120120520": {
            "id": "120120520",
            "speakerId": 1003,
            "speakerName": "派蒙",
            "text": "他们的感情，真的很好呢…",
            "nextDialogs": [
              "120120521"
            ]
          },
          "120120521": {
            "id": "120120521",
            "speakerId": 1002,
            "speakerName": "今谷三郎",
            "text": "对了，我们的事先不提，宵宫你现在应该忙着办烟花会吧，到我们这里来，是有什么要紧事吗？",
            "nextDialogs": [
              "120120522"
            ]
          },
          "120120522": {
            "id": "120120522",
            "speakerId": 1001,
            "speakerName": "宵宫",
            "text": "哦，其实是个比较难以启齿的事，我先给你们讲讲吧。",
            "nextDialogs": [
              "120120523"
            ]
          },
          "120120523": {
            "id": "120120523",
            "speakerId": 1002,
            "speakerName": "今谷三郎",
            "text": "朔次郎，他…回来了啊。",
            "nextDialogs": [
              "120120524"
            ]
          },
          "120120524": {
            "id": "120120524",
            "speakerId": 1001,
            "speakerName": "宵宫",
            "text": "欸？你们认识他？",
            "nextDialogs": [
              "120120525"
            ]
          },
          "120120525": {
            "id": "120120525",
            "speakerId": 1000,
            "speakerName": "今谷香里",
            "text": "那是我家孩子，小时候最好的朋友啊。",
            "nextDialogs": [
              "120120526"
            ]
          },
          "120120526": {
            "id": "120120526",
            "speakerId": 1000,
            "speakerName": "今谷香里",
            "text": "唉，那时候他们一直一起玩，从小到大，无话不讲，到处跑，到处看。",
            "nextDialogs": [
              "120120527"
            ]
          },
          "120120527": {
            "id": "120120527",
            "speakerId": 1000,
            "speakerName": "今谷香里",
            "text": "结果呢，有一天突然吵了一架，吵得很厉害…",
            "nextDialogs": [
              "120120528"
            ]
          },
          "120120528": {
            "id": "120120528",
            "speakerId": 1002,
            "speakerName": "今谷三郎",
            "text": "我记得那时候的朔次郎，想要去外面的世界看看，他觉得稻妻太安稳了。",
            "nextDialogs": [
              "120120529"
            ]
          },
          "120120529": {
            "id": "120120529",
            "speakerId": 1002,
            "speakerName": "今谷三郎",
            "text": "可是我们家那孩子佳祐，从小就和我们一样，觉得安安稳稳的没什么不好。",
            "nextDialogs": [
              "120120530"
            ]
          },
          "120120530": {
            "id": "120120530",
            "speakerId": 1002,
            "speakerName": "今谷三郎",
            "text": "小孩子嘛，就是会因为对错而争论得很厉害，最后朔次郎就一气之下，独自离开了。",
            "nextDialogs": [
              "120120531"
            ]
          },
          "120120531": {
            "id": "120120531",
            "speakerId": 1001,
            "speakerName": "宵宫",
            "text": "原来是这样…",
            "nextDialogs": [
              "120120532"
            ]
          },
          "120120532": {
            "id": "120120532",
            "speakerId": 1002,
            "speakerName": "今谷三郎",
            "text": "那之后佳祐虽然什么都没跟我和老婆子说，但能看出来，他很伤心，但心里的想法，又不愿和我们讲。",
            "nextDialogs": [
              "120120533"
            ]
          },
          "120120533": {
            "id": "120120533",
            "speakerId": 1002,
            "speakerName": "今谷三郎",
            "text": "后来，不知道是赌气还是什么其他原因，他就去了天领奉行，很少回来了。",
            "nextDialogs": [
              "120120534"
            ]
          },
          "120120534": {
            "id": "120120534",
            "speakerId": 1000,
            "speakerName": "今谷香里",
            "text": "其他的忙，我们跟佳祐好好说说，他应该是会帮的。",
            "nextDialogs": [
              "120120535"
            ]
          },
          "120120535": {
            "id": "120120535",
            "speakerId": 1000,
            "speakerName": "今谷香里",
            "text": "但如果是朔次郎的事，我觉得…我们没有办法插手。",
            "nextDialogs": [
              "120120536"
            ]
          },
          "120120536": {
            "id": "120120536",
            "speakerId": 1003,
            "speakerName": "派蒙",
            "text": "没想到这么巧…",
            "nextDialogs": [
              "120120537"
            ]
          },
          "120120537": {
            "id": "120120537",
            "speakerId": 1001,
            "speakerName": "宵宫",
            "text": "我明白了。我问朔次郎他为什么回来的时候，他也不愿意细讲，只说是「以前犯了错」。",
            "nextDialogs": [
              "120120538"
            ]
          },
          "120120538": {
            "id": "120120538",
            "speakerId": 1001,
            "speakerName": "宵宫",
            "text": "我终于明白他为什么下不了决心了。",
            "nextDialogs": [
              "120120539"
            ]
          },
          "120120539": {
            "id": "120120539",
            "speakerId": 1003,
            "speakerName": "派蒙",
            "text": "明明是童年挚友，现在一个是天领奉行的人，一个在被天领奉行通缉…"
          }
        }
      }
    },
    {
      "subId": "1201206",
      "subQuestName": "将消息告诉朔次郎",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "120120601"
        ],
        "dialogs": {
          "120120601": {
            "id": "120120601",
            "speakerId": 1005,
            "speakerName": "长野原龙之介",
            "text": "丫头，不好了，刚刚天领奉行的人来过了。",
            "nextDialogs": [
              "120120602"
            ]
          },
          "120120602": {
            "id": "120120602",
            "speakerId": 1001,
            "speakerName": "宵宫",
            "text": "欸？为什么，他们这就知道了？",
            "nextDialogs": [
              "120120603"
            ]
          },
          "120120603": {
            "id": "120120603",
            "speakerId": 1001,
            "speakerName": "宵宫",
            "text": "老爹你没事吧？他们没对你做什么吧？",
            "nextDialogs": [
              "120120604"
            ]
          },
          "120120604": {
            "id": "120120604",
            "speakerId": 1005,
            "speakerName": "长野原龙之介",
            "text": "我说，烟花会，房子里都是烟花，不要随便进去看，免得火灾。",
            "nextDialogs": [
              "120120605"
            ]
          },
          "120120605": {
            "id": "120120605",
            "speakerId": 1005,
            "speakerName": "长野原龙之介",
            "text": "但他们不听，就觉得朔次郎那小子藏在里面。",
            "nextDialogs": [
              "120120606"
            ]
          },
          "120120606": {
            "id": "120120606",
            "speakerId": 1005,
            "speakerName": "长野原龙之介",
            "text": "不过幸好，朔次郎提前听到了动静，翻窗子跑掉了，天领奉行的人没有在这里抓到他。",
            "nextDialogs": [
              "120120607"
            ]
          },
          "120120607": {
            "id": "120120607",
            "speakerId": 1001,
            "speakerName": "宵宫",
            "text": "哎呀，这就麻烦了，朔次郎现在应该还在犹豫不决…",
            "nextDialogs": [
              "120120608"
            ]
          },
          "120120608": {
            "id": "120120608",
            "speakerId": 1001,
            "speakerName": "宵宫",
            "text": "老爹，你看到他往哪儿跑了吗？",
            "nextDialogs": [
              "120120609"
            ]
          },
          "120120609": {
            "id": "120120609",
            "speakerId": 1001,
            "speakerName": "宵宫",
            "text": "我觉得天领奉行的人一定会追上去的。",
            "nextDialogs": [
              "120120610"
            ]
          },
          "120120610": {
            "id": "120120610",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "你听到那个人的名字了吗？",
            "nextDialogs": [
              "120120611"
            ]
          },
          "120120611": {
            "id": "120120611",
            "speakerId": 1001,
            "speakerName": "宵宫",
            "text": "对对对，名字，名字！这么突然地就来抓人，很有可能就是那个佳祐！",
            "nextDialogs": [
              "120120612"
            ]
          },
          "120120612": {
            "id": "120120612",
            "speakerId": 1001,
            "speakerName": "宵宫",
            "text": "不然只是因为偷渡，应该还不至于这么兴师动众。",
            "nextDialogs": [
              "120120613"
            ]
          },
          "120120613": {
            "id": "120120613",
            "speakerId": 1005,
            "speakerName": "长野原龙之介",
            "text": "不行啊，我耳朵不好，也没看到。你们想问方向是吧，他们出城去了。",
            "nextDialogs": [
              "120120614"
            ]
          },
          "120120614": {
            "id": "120120614",
            "speakerId": 1005,
            "speakerName": "长野原龙之介",
            "text": "名字我没听到，唉，真的没听到…",
            "nextDialogs": [
              "120120615"
            ]
          },
          "120120615": {
            "id": "120120615",
            "speakerId": 1006,
            "speakerName": "森彦",
            "text": "名字的话，我好像听到了。",
            "nextDialogs": [
              "120120616"
            ]
          },
          "120120616": {
            "id": "120120616",
            "speakerId": 1006,
            "speakerName": "森彦",
            "text": "我刚刚又从朋友那里拿了点矿石，送过来的时候，刚好撞上。",
            "nextDialogs": [
              "120120617"
            ]
          },
          "120120617": {
            "id": "120120617",
            "speakerId": 1006,
            "speakerName": "森彦",
            "text": "领头的那个，好像就是你们说的，叫作佳祐。",
            "nextDialogs": [
              "120120618"
            ]
          },
          "120120618": {
            "id": "120120618",
            "speakerId": 1001,
            "speakerName": "宵宫",
            "text": "果然是这样！谢谢你！",
            "nextDialogs": [
              "120120619"
            ]
          },
          "120120619": {
            "id": "120120619",
            "speakerId": 1001,
            "speakerName": "宵宫",
            "text": "如果朔次郎还是没有下定决心，两个人见面不仅不能解决问题，还会让事情变得不可挽回。",
            "nextDialogs": [
              "120120620"
            ]
          },
          "120120620": {
            "id": "120120620",
            "speakerId": 1001,
            "speakerName": "宵宫",
            "text": "#这样肯定不行。{NICKNAME}，跟我来，我们沿路打听线索吧！"
          }
        }
      }
    },
    {
      "subId": "1201207",
      "subQuestName": "",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "120120701"
        ],
        "dialogs": {
          "120120701": {
            "id": "120120701",
            "speakerId": 1000,
            "speakerName": "今谷香里",
            "text": "谢谢你们能帮忙，唉，实在不好意思。",
            "nextDialogs": [
              "120120702"
            ]
          },
          "120120702": {
            "id": "120120702",
            "speakerId": 1002,
            "speakerName": "今谷三郎",
            "text": "趁这个时间，我去泡个茶，准备点心吧。"
          }
        }
      }
    },
    {
      "subId": "1201210",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "120121001"
        ],
        "dialogs": {
          "120121001": {
            "id": "120121001",
            "speakerId": 1007,
            "speakerName": "松坂",
            "text": "为什么刚刚走过去的叔叔，看起来好可怕？",
            "nextDialogs": [
              "120121002"
            ]
          },
          "120121002": {
            "id": "120121002",
            "speakerId": 1008,
            "speakerName": "彩香",
            "text": "他们不会要抢我们的武器吧？",
            "nextDialogs": [
              "120121003"
            ]
          },
          "120121003": {
            "id": "120121003",
            "speakerId": 1009,
            "speakerName": "岩夫",
            "text": "欸？没办法炸「大貉妖」了吗？"
          }
        }
      }
    },
    {
      "subId": "1201211",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "120121101"
        ],
        "dialogs": {
          "120121101": {
            "id": "120121101",
            "speakerId": 1005,
            "speakerName": "长野原龙之介",
            "text": "今天的丫头也这么有精神啊。",
            "nextDialogs": [
              "120121102"
            ]
          },
          "120121102": {
            "id": "120121102",
            "speakerId": 1005,
            "speakerName": "长野原龙之介",
            "text": "真好，真好…"
          }
        }
      }
    },
    {
      "subId": "1201299",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "120129901"
        ],
        "dialogs": {
          "120129901": {
            "id": "120129901",
            "speakerId": 1003,
            "speakerName": "派蒙",
            "text": "这里的植物长得太茂盛了吧。",
            "nextDialogs": [
              "120129902"
            ]
          },
          "120129902": {
            "id": "120129902",
            "speakerId": 1003,
            "speakerName": "派蒙",
            "text": "但，怎么说也是别人家的院子，全砍掉了是不是不太好…",
            "nextDialogs": [
              "120129907"
            ]
          },
          "120129907": {
            "id": "120129907",
            "speakerId": 1001,
            "speakerName": "宵宫",
            "text": "事情都干完啦，那我们回去找他们聊正事吧。",
            "nextDialogs": [
              "120129908"
            ]
          },
          "120129908": {
            "id": "120129908",
            "speakerId": 1001,
            "speakerName": "宵宫",
            "text": "唉，这样就没办法了。",
            "nextDialogs": [
              "120129909"
            ]
          },
          "120129909": {
            "id": "120129909",
            "speakerId": 1001,
            "speakerName": "宵宫",
            "text": "回去把这个消息告诉朔次郎吧。"
          }
        }
      }
    }
  ]
}
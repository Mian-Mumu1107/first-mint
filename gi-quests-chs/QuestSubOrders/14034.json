  },
  "subQuests": [
    {
      "subId": "1403401",
      "subQuestName": "前往「王城教堂」",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "140340101"
        ],
        "dialogs": {
          "140340101": {
            "id": "140340101",
            "speakerId": 6506,
            "speakerName": "主持人",
            "text": "终于，你们来到了那个教{RUBY#[D]地下室}堂附近。",
            "nextDialogs": [
              "140340102"
            ]
          },
          "140340102": {
            "id": "140340102",
            "speakerId": 6506,
            "speakerName": "主持人",
            "text": "周围散发着不祥的气息，你们已感觉到敌人几乎近在咫尺。",
            "nextDialogs": [
              "140340103"
            ]
          },
          "140340103": {
            "id": "140340103",
            "speakerId": 1073,
            "speakerName": "芙宁娜",
            "text": "（奇怪…还真有一股不舒服的感觉…这怎么做到的？）",
            "nextDialogs": [
              "140340104"
            ]
          },
          "140340104": {
            "id": "140340104",
            "speakerId": 6506,
            "speakerName": "主持人",
            "text": "接下来…就是决战的时刻了。",
            "nextDialogs": [
              "140340105"
            ]
          },
          "140340105": {
            "id": "140340105",
            "speakerId": 1071,
            "speakerName": "林尼",
            "text": "我们走吧。",
            "nextDialogs": [
              "140340106"
            ]
          },
          "140340106": {
            "id": "140340106",
            "speakerId": 1077,
            "speakerName": "克洛琳德",
            "text": "弗洛莱恩，等等。",
            "nextDialogs": [
              "140340107"
            ]
          },
          "140340107": {
            "id": "140340107",
            "speakerId": 14092,
            "speakerName": "弗洛莱恩",
            "text": "怎么了？",
            "nextDialogs": [
              "140340108"
            ]
          },
          "140340108": {
            "id": "140340108",
            "speakerId": 1077,
            "speakerName": "克洛琳德",
            "text": "你在外面等我们，别进去。你曾经被噬魂兽侵蚀过一次，它很容易就能再次进入你的意识，夺走你身体的控制权。",
            "nextDialogs": [
              "140340109"
            ]
          },
          "140340109": {
            "id": "140340109",
            "speakerId": 1077,
            "speakerName": "克洛琳德",
            "text": "而且还是离它本体这么近的位置，被侵蚀之后的身体变成什么样都有可能。",
            "nextDialogs": [
              "140340110"
            ]
          },
          "140340110": {
            "id": "140340110",
            "speakerId": 14092,
            "speakerName": "弗洛莱恩",
            "text": "正因如此，我才要去…我会走在最前面。",
            "nextDialogs": [
              "140340111"
            ]
          },
          "140340111": {
            "id": "140340111",
            "speakerId": 1077,
            "speakerName": "克洛琳德",
            "text": "…！你是想要…",
            "nextDialogs": [
              "140340112"
            ]
          },
          "140340112": {
            "id": "140340112",
            "speakerId": 14092,
            "speakerName": "弗洛莱恩",
            "text": "没错，我要引诱它进入我的身体。",
            "nextDialogs": [
              "140340113"
            ]
          },
          "140340113": {
            "id": "140340113",
            "speakerId": 1077,
            "speakerName": "克洛琳德",
            "text": "这太危险了。最坏情况下，我可能不得不杀死你。你明白这严重性吗？",
            "nextDialogs": [
              "140340114"
            ]
          },
          "140340114": {
            "id": "140340114",
            "speakerId": 14092,
            "speakerName": "弗洛莱恩",
            "text": "我明白，但这样一来，你们的目标就更明确了。",
            "nextDialogs": [
              "140340115"
            ]
          },
          "140340115": {
            "id": "140340115",
            "speakerId": 14092,
            "speakerName": "弗洛莱恩",
            "text": "它不会轻易从方便控制的身体中溜走，你也无需考虑同伴被附身的可能。",
            "nextDialogs": [
              "140340116"
            ]
          },
          "140340116": {
            "id": "140340116",
            "speakerId": 1077,
            "speakerName": "克洛琳德",
            "text": "……",
            "nextDialogs": [
              "140340117"
            ]
          },
          "140340117": {
            "id": "140340117",
            "speakerId": 14092,
            "speakerName": "弗洛莱恩",
            "text": "克洛琳德小姐，和我不同，你是位强大而正直的逐影猎人。这是我犯下的错，也理应由我自己来承担。",
            "nextDialogs": [
              "140340118"
            ]
          },
          "140340118": {
            "id": "140340118",
            "speakerId": 14092,
            "speakerName": "弗洛莱恩",
            "text": "不如说…我非这样做不可。",
            "nextDialogs": [
              "140340119"
            ]
          },
          "140340119": {
            "id": "140340119",
            "speakerId": 14092,
            "speakerName": "弗洛莱恩",
            "text": "你就当是我以自己的名誉，而向你发起的决斗吧。请一定不要手软。",
            "nextDialogs": [
              "140340120"
            ]
          },
          "140340120": {
            "id": "140340120",
            "speakerId": 1077,
            "speakerName": "克洛琳德",
            "text": "…好，我知道了。",
            "nextDialogs": [
              "140340121"
            ]
          },
          "140340121": {
            "id": "140340121",
            "speakerId": 1077,
            "speakerName": "克洛琳德",
            "text": "弗洛莱恩，我以决斗代理人的名义，接受你的「决斗申请」，并向你致以敬意。",
            "nextDialogs": [
              "140340122"
            ]
          },
          "140340122": {
            "id": "140340122",
            "speakerId": 14092,
            "speakerName": "弗洛莱恩",
            "text": "…谢谢你。",
            "nextDialogs": [
              "140340123"
            ]
          },
          "140340123": {
            "id": "140340123",
            "speakerId": 1077,
            "speakerName": "克洛琳德",
            "text": "走吧，该去做正事了。让那魔物再次颤抖于猎人的剑刃之下。"
          }
        }
      }
    },
    {
      "subId": "1403402",
      "subQuestName": "进入「王城教堂」",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "140340201"
        ],
        "dialogs": {
          "140340201": {
            "id": "140340201",
            "speakerId": 6506,
            "speakerName": "主持人",
            "text": "于是，「魔物」被击溃、「巫师」被讨伐…",
            "nextDialogs": [
              "140340202"
            ]
          },
          "140340202": {
            "id": "140340202",
            "speakerId": 6506,
            "speakerName": "主持人",
            "text": "在那之后，王城重新迎来了和平的日子。那些被蛊惑的王臣，也看清了自己犯下的罪…",
            "nextDialogs": [
              "140340203"
            ]
          },
          "140340203": {
            "id": "140340203",
            "speakerId": 6506,
            "speakerName": "主持人",
            "text": "有人记住了那几位英雄的名字，他们拯救了这个国家…当然，也有人一无所知地继续过着自己的日子…",
            "nextDialogs": [
              "140340204"
            ]
          },
          "140340204": {
            "id": "140340204",
            "speakerId": 6506,
            "speakerName": "主持人",
            "text": "这就是「逐影猎人」。他们追寻森森鬼影，并将其尽数驱逐、猎杀…",
            "nextDialogs": [
              "140340205"
            ]
          },
          "140340205": {
            "id": "140340205",
            "speakerId": 6506,
            "speakerName": "主持人",
            "text": "不论人们铭记与否，他们永远守护着这座城市，守护着人们的生活…",
            "nextDialogs": [
              "140340206"
            ]
          },
          "140340206": {
            "id": "140340206",
            "speakerId": 1073,
            "speakerName": "芙宁娜",
            "text": "呼…这就算正式结团了吧？",
            "nextDialogs": [
              "140340207"
            ]
          },
          "140340207": {
            "id": "140340207",
            "speakerId": 1077,
            "speakerName": "克洛琳德",
            "text": "嗯，你们完成了一个好结局。",
            "nextDialogs": [
              "140340208"
            ]
          },
          "140340208": {
            "id": "140340208",
            "speakerId": 1073,
            "speakerName": "芙宁娜",
            "text": "不错的故事。原本以为只是个普通的冒险剧本，但越到后面越觉得它设计巧妙，制作精良。",
            "nextDialogs": [
              "140340209"
            ]
          },
          "140340209": {
            "id": "140340209",
            "speakerId": 1073,
            "speakerName": "芙宁娜",
            "text": "特别是最后那场决战，做得也太逼真了。",
            "nextDialogs": [
              "140340210"
            ]
          },
          "140340210": {
            "id": "140340210",
            "speakerId": 1075,
            "speakerName": "娜维娅",
            "text": "呃…哈哈…",
            "nextDialogs": [
              "140340211"
            ]
          },
          "140340211": {
            "id": "140340211",
            "speakerId": 1071,
            "speakerName": "林尼",
            "text": "啊…的确呢，没想到我们从「宝藏」中得到的武器，还有着那样的效果。",
            "nextDialogs": [
              "140340212"
            ]
          },
          "140340212": {
            "id": "140340212",
            "speakerId": 1073,
            "speakerName": "芙宁娜",
            "text": "对啊，它们在我手上发光的时候，还吓了我一跳呢。我刚才研究了好一会儿，但再没见它亮起来过。",
            "nextDialogs": [
              "140340213"
            ]
          },
          "140340213": {
            "id": "140340213",
            "speakerId": 1073,
            "speakerName": "芙宁娜",
            "text": "哦，这些武器都是道具，要回收的对吧？我先放这儿了。",
            "nextDialogs": [
              "140340214"
            ]
          },
          "140340214": {
            "id": "140340214",
            "speakerId": 1077,
            "speakerName": "克洛琳德",
            "text": "芙宁娜玩得开心吗？",
            "nextDialogs": [
              "140340215"
            ]
          },
          "140340215": {
            "id": "140340215",
            "speakerId": 1073,
            "speakerName": "芙宁娜",
            "text": "当然，如果下次有类似的桌上剧团，也记得叫上我吧。",
            "nextDialogs": [
              "140340216"
            ]
          },
          "140340216": {
            "id": "140340216",
            "speakerId": 1077,
            "speakerName": "克洛琳德",
            "text": "行，没问题。",
            "nextDialogs": [
              "140340217"
            ]
          },
          "140340217": {
            "id": "140340217",
            "speakerId": 1073,
            "speakerName": "芙宁娜",
            "text": "那我就先回去了，路上还想好好回味一下呢。",
            "nextDialogs": [
              "140340218"
            ]
          },
          "140340218": {
            "id": "140340218",
            "speakerId": 1073,
            "speakerName": "芙宁娜",
            "text": "等弗洛莱恩先生醒过来，帮忙传达一下我的问候。真是辛苦他了，从刚才开始就累得睡了过去。",
            "nextDialogs": [
              "140340219"
            ]
          },
          "140340219": {
            "id": "140340219",
            "speakerId": 1077,
            "speakerName": "克洛琳德",
            "text": "你说得对，是挺辛苦的。",
            "nextDialogs": [
              "140340220"
            ]
          },
          "140340220": {
            "id": "140340220",
            "speakerId": 1073,
            "speakerName": "芙宁娜",
            "text": "嗯，那各位改天见！",
            "nextDialogs": [
              "140340221"
            ]
          },
          "140340221": {
            "id": "140340221",
            "speakerId": 1075,
            "speakerName": "娜维娅",
            "text": "…现在…总可以问了吧？",
            "nextDialogs": [
              "140340222"
            ]
          },
          "140340222": {
            "id": "140340222",
            "speakerId": 1071,
            "speakerName": "林尼",
            "text": "我觉得应该可以了吧。",
            "nextDialogs": [
              "140340223"
            ]
          },
          "140340223": {
            "id": "140340223",
            "speakerId": 1075,
            "speakerName": "娜维娅",
            "text": "这究竟是怎么一回事啊？",
            "nextDialogs": [
              "140340224"
            ]
          },
          "140340224": {
            "id": "140340224",
            "speakerId": 1077,
            "speakerName": "克洛琳德",
            "text": "…原来你们早就发现了吗？",
            "nextDialogs": [
              "140340225"
            ]
          },
          "140340225": {
            "id": "140340225",
            "speakerId": 1071,
            "speakerName": "林尼",
            "text": "啊哈哈…山洞里闭眼的那场…很难不被发现吧。",
            "nextDialogs": [
              "140340226"
            ]
          },
          "140340226": {
            "id": "140340226",
            "speakerId": 1075,
            "speakerName": "娜维娅",
            "text": "我可是忍到现在才问的！因为克洛琳德你一副无事发生的样子，而且芙宁娜看起来根本没有察觉到。",
            "nextDialogs": [
              "140340227"
            ]
          },
          "140340227": {
            "id": "140340227",
            "speakerId": 1071,
            "speakerName": "林尼",
            "text": "看来，我们谁都不希望揭开幻想的纱幕呢。",
            "nextDialogs": [
              "140340228"
            ]
          },
          "140340228": {
            "id": "140340228",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "欸？你们在说什么？",
            "nextDialogs": [
              "140340230",
              "140340232"
            ]
          },
          "140340230": {
            "id": "140340230",
            "speakerId": 1075,
            "speakerName": "娜维娅",
            "text": "什么！原来好搭档你也…！啊…抱歉抱歉，你现在捂起耳朵还来得及！干脆我来帮你捂！",
            "nextDialogs": [
              "140340233"
            ]
          },
          "140340233": {
            "id": "140340233",
            "speakerId": 1071,
            "speakerName": "林尼",
            "text": "这…再怎么也晚了点吧…",
            "nextDialogs": [
              "140340234"
            ]
          },
          "140340234": {
            "id": "140340234",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "欸？你们的意思难道是…刚才发生的那些，不是剧本里安排好的桥段？",
            "nextDialogs": [
              "140340235"
            ]
          },
          "140340235": {
            "id": "140340235",
            "speakerId": 1077,
            "speakerName": "克洛琳德",
            "text": "不如说从一开始，这就不是一个普通的桌上剧团。",
            "nextDialogs": [
              "140340236"
            ]
          },
          "140340236": {
            "id": "140340236",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "欸欸欸？！！",
            "nextDialogs": [
              "140340237"
            ]
          },
          "140340237": {
            "id": "140340237",
            "speakerId": 14092,
            "speakerName": "弗洛莱恩",
            "text": "…好吵…头好疼啊。",
            "nextDialogs": [
              "140340238"
            ]
          },
          "140340238": {
            "id": "140340238",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "你快给我起来！起来！这究竟是怎么回事啊！",
            "nextDialogs": [
              "140340239"
            ]
          },
          "140340239": {
            "id": "140340239",
            "speakerId": 14092,
            "speakerName": "弗洛莱恩",
            "text": "啊啊啊！不，不要摇！我的头…！",
            "nextDialogs": [
              "140340240"
            ]
          },
          "140340240": {
            "id": "140340240",
            "speakerId": 1007,
            "speakerName": "Black Screen",
            "text": "弗洛莱恩一五一十地向其他人解释了事情经过…",
            "nextDialogs": [
              "140340241"
            ]
          },
          "140340241": {
            "id": "140340241",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "我、我没听错吧？这剧本的后半段都是你们现场编出来的？",
            "nextDialogs": [
              "140340242"
            ]
          },
          "140340242": {
            "id": "140340242",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "骗人很可恶，但弗洛莱恩编故事好厉害。克洛琳德的临场发挥也是！",
            "nextDialogs": [
              "140340243"
            ]
          },
          "140340243": {
            "id": "140340243",
            "speakerId": 1071,
            "speakerName": "林尼",
            "text": "简直像魔术师上场发现忘带道具，临时创作了一段精彩的魔术一样。",
            "nextDialogs": [
              "140340244"
            ]
          },
          "140340244": {
            "id": "140340244",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "要是我知道宝库有问题，可能早就怕得要死，转头溜走了！",
            "nextDialogs": [
              "140340245"
            ]
          },
          "140340245": {
            "id": "140340245",
            "speakerId": 1077,
            "speakerName": "克洛琳德",
            "text": "都是小场面。",
            "nextDialogs": [
              "140340246"
            ]
          },
          "140340246": {
            "id": "140340246",
            "speakerId": 1075,
            "speakerName": "娜维娅",
            "text": "你口中就没有大场面，但随便挑一个说出来都能把人吓个不轻。",
            "nextDialogs": [
              "140340247"
            ]
          },
          "140340247": {
            "id": "140340247",
            "speakerId": 1077,
            "speakerName": "克洛琳德",
            "text": "可能我习惯了吧。",
            "nextDialogs": [
              "140340248"
            ]
          },
          "140340248": {
            "id": "140340248",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "呃…你的生活是有多刺激…难怪当主持人的时候，什么情况都应付得来。",
            "nextDialogs": [
              "140340249"
            ]
          },
          "140340249": {
            "id": "140340249",
            "speakerId": 1077,
            "speakerName": "克洛琳德",
            "text": "至于弗洛莱恩…",
            "nextDialogs": [
              "140340250"
            ]
          },
          "140340250": {
            "id": "140340250",
            "speakerId": 14092,
            "speakerName": "弗洛莱恩",
            "text": "…我没有什么好辩驳的。我这就前往警备队，陈述自己所犯的罪，接受惩罚。",
            "nextDialogs": [
              "140340251"
            ]
          },
          "140340251": {
            "id": "140340251",
            "speakerId": 1077,
            "speakerName": "克洛琳德",
            "text": "我倒觉得，你受的惩罚已经够多了。",
            "nextDialogs": [
              "140340252"
            ]
          },
          "140340252": {
            "id": "140340252",
            "speakerId": 14092,
            "speakerName": "弗洛莱恩",
            "text": "…什么？",
            "nextDialogs": [
              "140340253"
            ]
          },
          "140340253": {
            "id": "140340253",
            "speakerId": 1077,
            "speakerName": "克洛琳德",
            "text": "虽然一开始被功利所蒙蔽，但你在决战中的行为，证明了自己是位合格的逐影猎人。",
            "nextDialogs": [
              "140340254"
            ]
          },
          "140340254": {
            "id": "140340254",
            "speakerId": 14092,
            "speakerName": "弗洛莱恩",
            "text": "……",
            "nextDialogs": [
              "140340255"
            ]
          },
          "140340255": {
            "id": "140340255",
            "speakerId": 1077,
            "speakerName": "克洛琳德",
            "text": "对这座城市来说，你继续做好逐影猎人的工作或许更重要。",
            "nextDialogs": [
              "140340256"
            ]
          },
          "140340256": {
            "id": "140340256",
            "speakerId": 14092,
            "speakerName": "弗洛莱恩",
            "text": "可是…",
            "nextDialogs": [
              "140340257"
            ]
          },
          "140340257": {
            "id": "140340257",
            "speakerId": 1077,
            "speakerName": "克洛琳德",
            "text": "当然，你还是要带着钥匙，去向其他两位逐影猎人道歉，并且承担对方所提出的补偿条件。",
            "nextDialogs": [
              "140340258"
            ]
          },
          "140340258": {
            "id": "140340258",
            "speakerId": 14092,
            "speakerName": "弗洛莱恩",
            "text": "…我明白。",
            "nextDialogs": [
              "140340259"
            ]
          },
          "140340259": {
            "id": "140340259",
            "speakerId": 1077,
            "speakerName": "克洛琳德",
            "text": "但除此以外…你已经在和我的「决斗」中，证明了自己的名誉。",
            "nextDialogs": [
              "140340260"
            ]
          },
          "140340260": {
            "id": "140340260",
            "speakerId": 14092,
            "speakerName": "弗洛莱恩",
            "text": "…！行…就按你说的办。我…这就去归还那两把钥匙。",
            "nextDialogs": [
              "140340261"
            ]
          },
          "140340261": {
            "id": "140340261",
            "speakerId": 14092,
            "speakerName": "弗洛莱恩",
            "text": "谢谢你们。我不会辜负你们给予我的第二次机会，我以逐影猎人的身份起誓。",
            "nextDialogs": [
              "140340262"
            ]
          },
          "140340262": {
            "id": "140340262",
            "speakerId": 14092,
            "speakerName": "弗洛莱恩",
            "text": "那么…后会有期。"
          },
          "140340232": {
            "id": "140340232",
            "speakerId": 1075,
            "speakerName": "娜维娅",
            "text": "什么！原来派蒙也没发现？啊…抱歉抱歉，你现在捂起耳朵还来得及！干脆我来帮你捂！"
          }
        }
      }
    },
    {
      "subId": "1403404",
      "subQuestName": "",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "140340301"
        ],
        "dialogs": {
          "140340301": {
            "id": "140340301",
            "speakerId": 1071,
            "speakerName": "林尼",
            "text": "说到逐影猎人，那处洞窟里的「宝藏」要怎么处理？",
            "nextDialogs": [
              "140340302"
            ]
          },
          "140340302": {
            "id": "140340302",
            "speakerId": 1077,
            "speakerName": "克洛琳德",
            "text": "复归原样。",
            "nextDialogs": [
              "140340303"
            ]
          },
          "140340303": {
            "id": "140340303",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "真的吗？不让现在的人们来看看，记住他们吗？",
            "nextDialogs": [
              "140340304"
            ]
          },
          "140340304": {
            "id": "140340304",
            "speakerId": 1077,
            "speakerName": "克洛琳德",
            "text": "不了。这是他们的选择，这就是逐影猎人的道路。",
            "nextDialogs": [
              "140340305"
            ]
          },
          "140340305": {
            "id": "140340305",
            "speakerId": 1077,
            "speakerName": "克洛琳德",
            "text": "就算是我，也只希望以决斗代理人的身份继续工作。我从不希望人们记住我「逐影猎人」的身份。",
            "nextDialogs": [
              "140340306"
            ]
          },
          "140340306": {
            "id": "140340306",
            "speakerId": 1071,
            "speakerName": "林尼",
            "text": "这和「魔术师」的道路还真不一样。不过，我欣赏克洛琳德小姐的决定。",
            "nextDialogs": [
              "140340307"
            ]
          },
          "140340307": {
            "id": "140340307",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "咦？我突然想到，既然不是演出特效的话，那最后战斗时，我们的武器为什么会发光呀？",
            "nextDialogs": [
              "140340308"
            ]
          },
          "140340308": {
            "id": "140340308",
            "speakerId": 1077,
            "speakerName": "克洛琳德",
            "text": "因为以前的逐影猎人，会在自己的武器中附上克制魔物的术法。感应到魔物时，它们就会发出光芒。",
            "nextDialogs": [
              "140340309"
            ]
          },
          "140340309": {
            "id": "140340309",
            "speakerId": 1075,
            "speakerName": "娜维娅",
            "text": "哦！怪不得最后能封住那家伙的行动呢。我还以为召唤真的奏效了。",
            "nextDialogs": [
              "140340310"
            ]
          },
          "140340310": {
            "id": "140340310",
            "speakerId": 1077,
            "speakerName": "克洛琳德",
            "text": "可能多少也奏效了吧。",
            "nextDialogs": [
              "140340311"
            ]
          },
          "140340311": {
            "id": "140340311",
            "speakerId": 1071,
            "speakerName": "林尼",
            "text": "哦？这是什么意思？",
            "nextDialogs": [
              "140340312"
            ]
          },
          "140340312": {
            "id": "140340312",
            "speakerId": 1077,
            "speakerName": "克洛琳德",
            "text": "这个被封印的「噬魂兽」，我猜和那几位逐影猎人来自同一个时代。",
            "nextDialogs": [
              "140340313"
            ]
          },
          "140340313": {
            "id": "140340313",
            "speakerId": 1077,
            "speakerName": "克洛琳德",
            "text": "你们所念出的名字，都是斩杀了它无数同类、最为英勇的猎人的名字。听到这些名字后，它明显畏缩了。",
            "nextDialogs": [
              "140340314"
            ]
          },
          "140340314": {
            "id": "140340314",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "原来名字还有这样的作用…",
            "nextDialogs": [
              "140340315"
            ]
          },
          "140340315": {
            "id": "140340315",
            "speakerId": 1077,
            "speakerName": "克洛琳德",
            "text": "……",
            "nextDialogs": [
              "140340316"
            ]
          },
          "140340316": {
            "id": "140340316",
            "speakerId": 1077,
            "speakerName": "克洛琳德",
            "text": "…娜维娅，刚才在「召唤」的时候，你说——",
            "nextDialogs": [
              "140340317"
            ]
          },
          "140340317": {
            "id": "140340317",
            "speakerId": 1075,
            "speakerName": "娜维娅",
            "text": "啊？呃…啊啊啊！那、那些都是真话，啊不，是戏中的真话啦！你听听就好，别再让我重复了，怪不好意思的。",
            "nextDialogs": [
              "140340318"
            ]
          },
          "140340318": {
            "id": "140340318",
            "speakerId": 1077,
            "speakerName": "克洛琳德",
            "text": "谢谢你那么说。",
            "nextDialogs": [
              "140340319"
            ]
          },
          "140340319": {
            "id": "140340319",
            "speakerId": 1075,
            "speakerName": "娜维娅",
            "text": "哎呀好啦，咱俩谁跟谁嘛！",
            "nextDialogs": [
              "140340320"
            ]
          },
          "140340320": {
            "id": "140340320",
            "speakerId": 1075,
            "speakerName": "娜维娅",
            "text": "呃…不、不聊这个了！我走在前面，你们也要跟上啊！",
            "nextDialogs": [
              "140340321"
            ]
          },
          "140340321": {
            "id": "140340321",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "啊…她溜走了。",
            "nextDialogs": [
              "140340322"
            ]
          },
          "140340322": {
            "id": "140340322",
            "speakerId": 1071,
            "speakerName": "林尼",
            "text": "那我也就此告辞吧，今天收获了十分精彩的故事，可以回去和大家分享一整晚呢。",
            "nextDialogs": [
              "140340323"
            ]
          },
          "140340323": {
            "id": "140340323",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "后会有期。",
            "nextDialogs": [
              "140340324"
            ]
          },
          "140340324": {
            "id": "140340324",
            "speakerId": 1071,
            "speakerName": "林尼",
            "text": "嗯，改日再见。",
            "nextDialogs": [
              "140340325"
            ]
          },
          "140340325": {
            "id": "140340325",
            "speakerId": 1077,
            "speakerName": "克洛琳德",
            "text": "……",
            "nextDialogs": [
              "140340326"
            ]
          },
          "140340326": {
            "id": "140340326",
            "speakerId": 1077,
            "speakerName": "克洛琳德",
            "text": "#{NICKNAME}…若是你的名字不被人记住，你的旅途不被人歌颂，那么你觉得这趟旅途的意义何在？",
            "nextDialogs": [
              "140340327"
            ]
          },
          "140340327": {
            "id": "140340327",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "（……）",
            "nextDialogs": [
              "140340328"
            ]
          },
          "140340328": {
            "id": "140340328",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "就算不被记住，和同伴们共度的时光或许就是意义。和同伴们共同创造的未来，也是意义。",
            "nextDialogs": [
              "140340329"
            ]
          },
          "140340329": {
            "id": "140340329",
            "speakerId": 1077,
            "speakerName": "克洛琳德",
            "text": "…不错的回答。我记下了。",
            "nextDialogs": [
              "140340330"
            ]
          },
          "140340330": {
            "id": "140340330",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "那你又是怎么看待的呢？",
            "nextDialogs": [
              "140340331"
            ]
          },
          "140340331": {
            "id": "140340331",
            "speakerId": 1077,
            "speakerName": "克洛琳德",
            "text": "我吗…哈…",
            "nextDialogs": [
              "140340332"
            ]
          },
          "140340332": {
            "id": "140340332",
            "speakerId": 1077,
            "speakerName": "克洛琳德",
            "text": "「对于这个问题，那位逐影猎人没再说什么。」",
            "nextDialogs": [
              "140340333"
            ]
          },
          "140340333": {
            "id": "140340333",
            "speakerId": 1077,
            "speakerName": "克洛琳德",
            "text": "「就由这无声的夜色，来替她回答吧…」"
          }
        }
      }
    },

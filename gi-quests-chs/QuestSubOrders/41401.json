  "subQuests": [
    {
      "subId": "4140101",
      "subQuestName": "与季同对话",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "414010101"
        ],
        "dialogs": {
          "414010101": {
            "id": "414010101",
            "speakerId": 1000,
            "speakerName": "季同",
            "text": "奇了怪了，这架「留影机」是怎么回事…",
            "nextDialogs": [
              "414010102"
            ]
          },
          "414010102": {
            "id": "414010102",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "这架「留影机」怎么了？",
            "nextDialogs": [
              "414010103"
            ]
          },
          "414010103": {
            "id": "414010103",
            "speakerId": 1000,
            "speakerName": "季同",
            "text": "好像是坏了…还是什么，总之就是不灵了。",
            "nextDialogs": [
              "414010104"
            ]
          },
          "414010104": {
            "id": "414010104",
            "speakerId": 1000,
            "speakerName": "季同",
            "text": "我之前在枫丹那边订了一批「留影机」。",
            "nextDialogs": [
              "414010105"
            ]
          },
          "414010105": {
            "id": "414010105",
            "speakerId": 1000,
            "speakerName": "季同",
            "text": "卖「留影机」的人说，这批「留影机」是他们枫丹的最新技术。",
            "nextDialogs": [
              "414010106"
            ]
          },
          "414010106": {
            "id": "414010106",
            "speakerId": 1000,
            "speakerName": "季同",
            "text": "说是可以让印出来的画有特殊的色调，带有特殊的效果什么的，我就买了一台过来想要试试。",
            "nextDialogs": [
              "414010107"
            ]
          },
          "414010107": {
            "id": "414010107",
            "speakerId": 1000,
            "speakerName": "季同",
            "text": "结果不知道是我操作有问题，还是这台「留影机」本身就有问题，怎么弄都印不出来正常的画。",
            "nextDialogs": [
              "414010108"
            ]
          },
          "414010108": {
            "id": "414010108",
            "speakerId": 1000,
            "speakerName": "季同",
            "text": "难道，真是我用这机器的方法有问题…",
            "nextDialogs": [
              "414010109"
            ]
          },
          "414010109": {
            "id": "414010109",
            "speakerId": 1000,
            "speakerName": "季同",
            "text": "对了，你了解「留影机」吗？",
            "nextDialogs": [
              "414010111",
              "414010113"
            ]
          },
          "414010111": {
            "id": "414010111",
            "speakerId": 1000,
            "speakerName": "季同",
            "text": "那太好了，能请你帮我个忙吗？",
            "nextDialogs": [
              "414010114"
            ]
          },
          "414010114": {
            "id": "414010114",
            "speakerId": 1000,
            "speakerName": "季同",
            "text": "看你的样子，是旅行者对吧？一定去过很地方，见识也很广。",
            "nextDialogs": [
              "414010115"
            ]
          },
          "414010115": {
            "id": "414010115",
            "speakerId": 1000,
            "speakerName": "季同",
            "text": "我想请你帮我用这台「留影机」去拍点「颜色」很强烈的东西。",
            "nextDialogs": [
              "414010116"
            ]
          },
          "414010116": {
            "id": "414010116",
            "speakerId": 1000,
            "speakerName": "季同",
            "text": "拍好了之后，请再把印出来的画拿给我，我想看看，这「留影机」到底是哪里出了问题…",
            "nextDialogs": [
              "414010117"
            ]
          },
          "414010117": {
            "id": "414010117",
            "speakerId": 1000,
            "speakerName": "季同",
            "text": "实在不行，我就拿着这些画去找那个人问问去。有这些画做证据，我也不怕他不认账。"
          },
          "414010113": {
            "id": "414010113",
            "speakerId": 1000,
            "speakerName": "季同",
            "text": "唔…倒也没关系，这东西的操作还算简单…能请你帮我个忙吗？"
          }
        }
      }
    }
  ]
}
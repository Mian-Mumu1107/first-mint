      "dialogue": {
        "startDialogs": [
          "4690001"
        ],
        "dialogs": {
          "4690001": {
            "id": "4690001",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "是七天神像！",
            "nextDialogs": [
              "4690002"
            ]
          },
          "4690002": {
            "id": "4690002",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "#来看看{NICKNAME}的供奉，能不能得到神的回应吧。",
            "nextDialogs": [
              "4690003"
            ]
          },
          "4690003": {
            "id": "4690003",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "啊，是这种好像凝固的风一样的东西…",
            "nextDialogs": [
              "4690004"
            ]
          },
          "4690004": {
            "id": "4690004",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "#{NICKNAME}，我们去风起地的那座七天神像一趟吧！去把它供奉给神。",
            "nextDialogs": [
              "4690005"
            ]
          },
          "4690005": {
            "id": "4690005",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "嗯…总之先跟我来，详细的事我一会再告诉你。"
          }
        }
      }
    }
  ]

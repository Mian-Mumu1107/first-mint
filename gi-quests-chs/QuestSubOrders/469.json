          }
        }
      }
    },
    {
      "subId": "46902",
      "subQuestName": "将风神瞳供奉给神像",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "4690201"
        ],
        "dialogs": {
          "4690201": {
            "id": "4690201",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "感受到七天神像的赐福了吗？",
            "nextDialogs": [
              "4690202"
            ]
          },
          "4690202": {
            "id": "4690202",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "在蒙德，人们把那种凝固的风叫做「散失的风神瞳」。",
            "nextDialogs": [
              "4690203"
            ]
          },
          "4690203": {
            "id": "4690203",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "这个名字代表的是：它有资格被镶嵌在神像的眼眶里。",
            "nextDialogs": [
              "4690204"
            ]
          },
          "4690204": {
            "id": "4690204",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "有童话说，是燕子衔走了作为眼睛的宝石…",
            "nextDialogs": [
              "4690205"
            ]
          },
          "4690205": {
            "id": "4690205",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "但其实「散失的风神瞳」本来就没有实体。",
            "nextDialogs": [
              "4690207"
            ]
          },
          "4690207": {
            "id": "4690207",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "拥有「神之眼」的人会注意收集它们，送去七天神像，获取赐福。",
            "nextDialogs": [
              "4690208"
            ]
          },
          "4690208": {
            "id": "4690208",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "虽然你没有「神之眼」，但你超脱这个世界的常理…",
            "nextDialogs": [
              "4690209"
            ]
          },
          "4690209": {
            "id": "4690209",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "继续向神像供奉风神瞳，也许会获得更多赐福哦！"
          }
        }
      }
    },
    {

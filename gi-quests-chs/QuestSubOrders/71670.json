    {
      "subId": "7167002",
      "subQuestName": "前往地中之盐一带",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "716700201"
        ],
        "dialogs": {
          "716700201": {
            "id": "716700201",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "唔…不太对劲啊，远处那个地脉淤积的烟团，越看越邪门，它就是异常魔物的来源吗？",
            "nextDialogs": [
              "716700202"
            ]
          },
          "716700202": {
            "id": "716700202",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "看起来，千岩军专门为它建造了一个营地，还有好多巡逻的士兵和工事！",
            "nextDialogs": [
              "716700205"
            ]
          },
          "716700205": {
            "id": "716700205",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "嗯！就按以前的惯例办事吧——我们和千岩军并肩作战，把所有魔物咚咚打翻，然后想办法处理掉淤积点！",
            "nextDialogs": [
              "716700206"
            ]
          },
          "716700206": {
            "id": "716700206",
            "speakerId": 1001,
            "speakerName": "千岩军战士",
            "text": "两位旅人，前方危险，请止步。",
            "nextDialogs": [
              "716700207"
            ]
          },
          "716700207": {
            "id": "716700207",
            "speakerId": 1001,
            "speakerName": "千岩军战士",
            "text": "#等等…这种气势…莫非你是{NICKNAME}教头？",
            "nextDialogs": [
              "716700208"
            ]
          },
          "716700208": {
            "id": "716700208",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "#咦？{NICKNAME}，你难道趁我睡着的时候去千岩军打工了？"
          }
        }
      }
    },
    {
      "subId": "7167003",
      "subQuestName": "通过紊乱点前往秘境",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "716701101"
        ],
        "dialogs": {
          "716701101": {
            "id": "716701101",
            "speakerId": 1048,
            "speakerName": "夜兰",
            "text": "看来，经过之前的一番波动，这个紊乱点暂时安定下来了。",
            "nextDialogs": [
              "716701102"
            ]
          },
          "716701102": {
            "id": "716701102",
            "speakerId": 1016,
            "speakerName": "刻晴",
            "text": "不过，异象尚未完全消除，一段时间后，它必定会重归活跃。",
            "nextDialogs": [
              "716701103"
            ]
          },
          "716701103": {
            "id": "716701103",
            "speakerId": 1016,
            "speakerName": "刻晴",
            "text": "但无论如何，也算是有了难得的空档期，趁这个功夫好好休憩一番，为下次战斗做好准备吧。",
            "nextDialogs": [
              "716701104"
            ]
          },
          "716701104": {
            "id": "716701104",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "好，我们会认认真真，做好功课的！",
            "nextDialogs": [
              "716701105"
            ]
          },
          "716701105": {
            "id": "716701105",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "#{NICKNAME}，借着这个机会，我们吃饱喝足，好好休息，养足精神！再仔细思考一下战术和对策！"
          }
        }
      }
    }
  ]
}
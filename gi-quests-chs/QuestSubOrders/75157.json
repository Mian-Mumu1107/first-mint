  "subQuests": [
    {
      "subId": "7515701",
      "subQuestName": "（test）与倒霉蛋对话$HIDDEN",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "751570101"
        ],
        "dialogs": {
          "751570101": {
            "id": "751570101",
            "speakerId": 21614,
            "speakerName": "科奴拉芙",
            "text": "呜呜…没想到居然被关在这个笼子里，「烟谜主」部族成员的尊严真是荡然无存。",
            "nextDialogs": [
              "751570102"
            ]
          },
          "751570102": {
            "id": "751570102",
            "speakerId": 21614,
            "speakerName": "科奴拉芙",
            "text": "唉，唉，真是让部族蒙羞…",
            "nextDialogs": [
              "751570103"
            ]
          },
          "751570103": {
            "id": "751570103",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "是你？这次又是怎么回事？",
            "nextDialogs": [
              "751570104"
            ]
          },
          "751570104": {
            "id": "751570104",
            "speakerId": 21614,
            "speakerName": "科奴拉芙",
            "text": "哎呀，恩人…这次又见到您了，呜，这次真是让您看到了我的丑态。",
            "nextDialogs": [
              "751570105"
            ]
          },
          "751570105": {
            "id": "751570105",
            "speakerId": 21614,
            "speakerName": "科奴拉芙",
            "text": "哎呀恩人啊，上次我不是说过，我的名字叫科奴拉芙，是「烟谜主」的实习祭司…",
            "nextDialogs": [
              "751570106"
            ]
          },
          "751570106": {
            "id": "751570106",
            "speakerId": 21614,
            "speakerName": "科奴拉芙",
            "text": "现在正在祭司的修行途中，嗯…部族的长辈告诉我，我的先祖桑哈杰经常跟别的部族的人赌斗，还把他们骗得团团转。",
            "nextDialogs": [
              "751570107"
            ]
          },
          "751570107": {
            "id": "751570107",
            "speakerId": 21614,
            "speakerName": "科奴拉芙",
            "text": "所以长辈们对我说，「去跟人赌斗，然后获得胜利吧！这样才能称得上是合格的烟谜主的人呀！」",
            "nextDialogs": [
              "751570108"
            ]
          },
          "751570108": {
            "id": "751570108",
            "speakerId": 21614,
            "speakerName": "科奴拉芙",
            "text": "于是路过这里的时候，看到比赛，我、我也下注了，什么卫冕冠军嵴锋龙，什么十年来最强新秀绒翼龙…",
            "nextDialogs": [
              "751570109"
            ]
          },
          "751570109": {
            "id": "751570109",
            "speakerId": 21614,
            "speakerName": "科奴拉芙",
            "text": "最强的当然是我们「烟谜主」的暝视龙呀！",
            "nextDialogs": [
              "751570110"
            ]
          },
          "751570110": {
            "id": "751570110",
            "speakerId": 21614,
            "speakerName": "科奴拉芙",
            "text": "结果输得肝脑涂地…唔，不是，是输得一败涂地。",
            "nextDialogs": [
              "751570111"
            ]
          },
          "751570111": {
            "id": "751570111",
            "speakerId": 21614,
            "speakerName": "科奴拉芙",
            "text": "不仅因为赌暝视龙赢欠了钱，人还被关在这…",
            "nextDialogs": [
              "751570112"
            ]
          },
          "751570112": {
            "id": "751570112",
            "speakerId": 21614,
            "speakerName": "科奴拉芙",
            "text": "「嘿，暝视龙要是能得冠军，我们把钱十倍还给你，不然你就在这个笼子里待着吧！」",
            "nextDialogs": [
              "751570113"
            ]
          },
          "751570113": {
            "id": "751570113",
            "speakerId": 21614,
            "speakerName": "科奴拉芙",
            "text": "哎呀，这可怎么办呀！如果这时候有一只暝视龙把那两只龙都揍一顿就好了…",
            "nextDialogs": [
              "751570114"
            ]
          },
          "751570114": {
            "id": "751570114",
            "speakerId": 21614,
            "speakerName": "科奴拉芙",
            "text": "这样我就能从笼子里出来还能拿到十倍的摩拉…啊，最主要是，不能让两个部族的人轻视伟大的烟谜主的伟大暝视龙！",
            "nextDialogs": [
              "751570115"
            ]
          },
          "751570115": {
            "id": "751570115",
            "speakerId": 21614,
            "speakerName": "科奴拉芙",
            "text": "呜…求求了，恩人，如果您能找到这么一只暝视龙的话…",
            "nextDialogs": [
              "751570116"
            ]
          },
          "751570116": {
            "id": "751570116",
            "speakerId": 21614,
            "speakerName": "科奴拉芙",
            "text": "唉，真是说胡话了，恩人又不是烟谜主的人，到底从哪里能找到这样的暝视龙啊…",
            "nextDialogs": [
              "751570117"
            ]
          },
          "751570117": {
            "id": "751570117",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "我会尽力找找看…",
            "nextDialogs": [
              "751570118"
            ]
          },
          "751570118": {
            "id": "751570118",
            "speakerId": 21614,
            "speakerName": "科奴拉芙",
            "text": "真、真的吗，恩人啊，那我就在这个笼子里，等、等您的好消息…"
          }
        }
      }
    },

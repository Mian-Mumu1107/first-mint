    },
    {
      "subId": "7515704",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "751570401"
        ],
        "dialogs": {
          "751570401": {
            "id": "751570401",
            "speakerId": 21614,
            "speakerName": "科奴拉芙",
            "text": "伟大的桑哈杰啊，保佑你可怜的在外的子孙吧…求求您帮恩人<color=#00E1FFFF>找来一只强大的暝视龙…</color>",
            "nextDialogs": [
              "751570402"
            ]
          },
          "751570402": {
            "id": "751570402",
            "speakerId": 21614,
            "speakerName": "科奴拉芙",
            "text": "好让那些羞辱你子孙的其他部族人们开开眼界，呜呜…"
          }
        }
      }
    },
    {
      "subId": "7515706",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "751570601"
        ],
        "dialogs": {
          "751570601": {
            "id": "751570601",
            "speakerId": 21785,
            "speakerName": "冷静的「回声之子」战士",
            "text": "赔率是一比一点零五，嗯，两者的实力很接近…真希望「极钻」能赢啊。",
            "nextDialogs": [
              "751570602"
            ]
          },
          "751570602": {
            "id": "751570602",
            "speakerId": 21785,
            "speakerName": "冷静的「回声之子」战士",
            "text": "不过，刚才「赤舞者」将身子缩入了羽毛之中，不仅卸去了「极钻」招牌钻击的力道…还乘机进行了反打。",
            "nextDialogs": [
              "751570603"
            ]
          },
          "751570603": {
            "id": "751570603",
            "speakerId": 21785,
            "speakerName": "冷静的「回声之子」战士",
            "text": "局势，其实对「极钻」不是很乐观…"
          }
        }
      }
    },
    {
      "subId": "7515707",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "751570701"
        ],
        "dialogs": {
          "751570701": {
            "id": "751570701",
            "speakerId": 21782,
            "speakerName": "悠然的「花羽会」战士",
            "text": "嗯？生面孔啊，第一次来看比赛吗…这里没有其他规矩，但是，哼，如果下了注输了就得拿出摩拉…",
            "nextDialogs": [
              "751570702"
            ]
          },
          "751570702": {
            "id": "751570702",
            "speakerId": 21782,
            "speakerName": "悠然的「花羽会」战士",
            "text": "之前就有个「烟谜主」的小姑娘，输了以后拿不出摩拉，嘿，现在就被关在那个笼子里哇哇乱叫呢。"
          }
        }
      }
    },
    {
      "subId": "7515708",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "751570801"
        ],
        "dialogs": {
          "751570801": {
            "id": "751570801",
            "speakerId": 21783,
            "speakerName": "专注的「花羽会」战士",
            "text": "两方的精力都绷紧了，不过，维持这样的话，耐力的消耗会变得非常严重…",
            "nextDialogs": [
              "751570802"
            ]
          },
          "751570802": {
            "id": "751570802",
            "speakerId": 21783,
            "speakerName": "专注的「花羽会」战士",
            "text": "呵呵，最关键的胜负招…到底在什么时候才会…"
          }
        }
      }
    },

    {
      "subId": "7515702",
      "subQuestName": "附身龙$HIDDEN",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "751570201"
        ],
        "dialogs": {
          "751570201": {
            "id": "751570201",
            "speakerId": 1002,
            "speakerName": "Black Screen",
            "text": "突入战场的暝视龙干脆利落地击败了原胜者「赤舞者」。\\n根据约定，比赛的负责人将冒失的「烟谜主」少女放了出来…",
            "nextDialogs": [
              "751570202"
            ]
          },
          "751570202": {
            "id": "751570202",
            "speakerId": 21614,
            "speakerName": "科奴拉芙",
            "text": "呜呜，差点以为就要被关在笼子里押回「烟谜主」，向家里人要债了…",
            "nextDialogs": [
              "751570203"
            ]
          },
          "751570203": {
            "id": "751570203",
            "speakerId": 21614,
            "speakerName": "科奴拉芙",
            "text": "在笼子里我才想起来，故事里「烟谜主」的先祖每次都是自己做局，才能骗到别人…",
            "nextDialogs": [
              "751570204"
            ]
          },
          "751570204": {
            "id": "751570204",
            "speakerId": 21614,
            "speakerName": "科奴拉芙",
            "text": "一般好像没有参加别人的局还能轻易获胜的说法呢，哎呀，被关在笼子里的时候，小女子我也反省了很多呢。",
            "nextDialogs": [
              "751570205"
            ]
          },
          "751570205": {
            "id": "751570205",
            "speakerId": 21614,
            "speakerName": "科奴拉芙",
            "text": "虽然不知道恩人到底从哪里找来了那么厉害的暝视龙…",
            "nextDialogs": [
              "751570206"
            ]
          },
          "751570206": {
            "id": "751570206",
            "speakerId": 21614,
            "speakerName": "科奴拉芙",
            "text": "多亏有恩人帮助，这次不仅盘缠拿了回来，还获得了十倍的摩拉！",
            "nextDialogs": [
              "751570207"
            ]
          },
          "751570207": {
            "id": "751570207",
            "speakerId": 21614,
            "speakerName": "科奴拉芙",
            "text": "几乎全部都是恩人的功劳，哎呀，被笼子关了小半天，腰也酸背也痛，小女子我要找个柔软的床铺好好躺一躺。",
            "nextDialogs": [
              "751570208"
            ]
          },
          "751570208": {
            "id": "751570208",
            "speakerId": 21614,
            "speakerName": "科奴拉芙",
            "text": "这些赢来的东西，就交给恩人你吧！这种意外之财，长辈们跟我说，留在自己身边反而会招来不幸，得送出去呢！"
          }
        }
      }
    },
    {
      "subId": "7515703",
      "subQuestName": "附身龙与两只龙战斗$HIDDEN",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "751570301"
        ],
        "dialogs": {
          "751570301": {
            "id": "751570301",
            "speakerId": 21784,
            "speakerName": "兴奋的「回声之子」战士",
            "text": "上啊，「极钻」，你可是上一届的冠军，可别输给那只看上去就软绵绵的绒翼龙！",
            "nextDialogs": [
              "751570302"
            ]
          },
          "751570302": {
            "id": "751570302",
            "speakerId": 21784,
            "speakerName": "兴奋的「回声之子」战士",
            "text": "钻！对，就是这样，左右摇摆，要看准机会！"
          }
        }
      }
    },
    {
      "subId": "7515704",
      "subQuestName": "（test）再次和倒霉蛋对话$HIDDEN",
      "sceneId": null,
      "locations": [],

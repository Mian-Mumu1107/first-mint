  "subQuests": [
    {
      "subId": "302301",
      "subQuestName": "（test）隐藏子任务带闲置对话$HIDDEN",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "30230101"
        ],
        "dialogs": {
          "30230101": {
            "id": "30230101",
            "speakerId": 1000,
            "speakerName": "赛诺",
            "text": "…过去，我从没想过神明也会遭遇不幸。",
            "nextDialogs": [
              "30230102"
            ]
          },
          "30230102": {
            "id": "30230102",
            "speakerId": 1000,
            "speakerName": "赛诺",
            "text": "假如有什么办法能改变这一切…这个国家会因此变得更好吗？"
          }
        }
      }
    },
    {
      "subId": "302302",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "30230201"
        ],
        "dialogs": {
          "30230201": {
            "id": "30230201",
            "speakerId": 1001,
            "speakerName": "艾尔海森",
            "text": "别着急。这么大的事，不可能马上准备完毕。",
            "nextDialogs": [
              "30230202"
            ]
          },
          "30230202": {
            "id": "30230202",
            "speakerId": 1001,
            "speakerName": "艾尔海森",
            "text": "慢慢想，保证计划的合理性。",
            "nextDialogs": [
              "30230203"
            ]
          },
          "30230203": {
            "id": "30230203",
            "speakerId": 1002,
            "speakerName": "派蒙",
            "text": "说着又开始看书了，喂！你这个人！",
            "nextDialogs": [
              "30230204"
            ]
          },
          "30230204": {
            "id": "30230204",
            "speakerId": 1001,
            "speakerName": "艾尔海森",
            "text": "要我借本书给你吗？",
            "nextDialogs": [
              "30230205"
            ]
          },
          "30230205": {
            "id": "30230205",
            "speakerId": 1002,
            "speakerName": "派蒙",
            "text": "不要啦，你的书都不适合我…",
            "nextDialogs": [
              "30230206"
            ]
          },
          "30230206": {
            "id": "30230206",
            "speakerId": 1001,
            "speakerName": "艾尔海森",
            "text": "骗你的。我的书确实不适合你，恕不外借。",
            "nextDialogs": [
              "30230207"
            ]
          },
          "30230207": {
            "id": "30230207",
            "speakerId": 1002,
            "speakerName": "派蒙",
            "text": "啊——！气死我了…"
          }
        }
      }
    },
    {
      "subId": "302303",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "30230301"
        ],
        "dialogs": {
          "30230301": {
            "id": "30230301",
            "speakerId": 1003,
            "speakerName": "坎蒂丝",
            "text": "如果有什么我能为你们做的，一定要告诉我。",
            "nextDialogs": [
              "30230302"
            ]
          },
          "30230302": {
            "id": "30230302",
            "speakerId": 1003,
            "speakerName": "坎蒂丝",
            "text": "虽然无法离开阿如村，但看到你们的样子，不知为什么…我心跳加速了。",
            "nextDialogs": [
              "30230303"
            ]
          },
          "30230303": {
            "id": "30230303",
            "speakerId": 1003,
            "speakerName": "坎蒂丝",
            "text": "过去独自一人面对战斗，我都没有像今天这样沸腾…",
            "nextDialogs": [
              "30230304"
            ]
          },
          "30230304": {
            "id": "30230304",
            "speakerId": 1003,
            "speakerName": "坎蒂丝",
            "text": "我想，这就是同伴的力量吧。"
          }
        }
      }
    },
    {
      "subId": "302304",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "30230401"
        ],
        "dialogs": {
          "30230401": {
            "id": "30230401",
            "speakerId": 1004,
            "speakerName": "迪希雅",
            "text": "最近这些差事，难度可不小。",
            "nextDialogs": [
              "30230402"
            ]
          },
          "30230402": {
            "id": "30230402",
            "speakerId": 1004,
            "speakerName": "迪希雅",
            "text": "而且，这么高难度的工作竟然不会带来经济收益，真不敢相信。",
            "nextDialogs": [
              "30230403"
            ]
          },
          "30230403": {
            "id": "30230403",
            "speakerId": 1002,
            "speakerName": "派蒙",
            "text": "往好处想，说不定事成就发财了呢！",
            "nextDialogs": [
              "30230404"
            ]
          },
          "30230404": {
            "id": "30230404",
            "speakerId": 1004,
            "speakerName": "迪希雅",
            "text": "说得也是，唔，如果你一夜之间变成富翁，想做什么？",
            "nextDialogs": [
              "30230405"
            ]
          },
          "30230405": {
            "id": "30230405",
            "speakerId": 1002,
            "speakerName": "派蒙",
            "text": "我想买很多很多好吃的！",
            "nextDialogs": [
              "30230406"
            ]
          },
          "30230406": {
            "id": "30230406",
            "speakerId": 1004,
            "speakerName": "迪希雅",
            "text": "就这样？",
            "nextDialogs": [
              "30230407"
            ]
          },
          "30230407": {
            "id": "30230407",
            "speakerId": 1002,
            "speakerName": "派蒙",
            "text": "唔…再买点好喝的？",
            "nextDialogs": [
              "30230408"
            ]
          },
          "30230408": {
            "id": "30230408",
            "speakerId": 1004,
            "speakerName": "迪希雅",
            "text": "哈哈哈，好可爱啊。",
            "nextDialogs": [
              "30230409"
            ]
          },
          "30230409": {
            "id": "30230409",
            "speakerId": 1004,
            "speakerName": "迪希雅",
            "text": "那么，为了这些美好的幻想…我也会帮忙的。",
            "nextDialogs": [
              "30230410"
            ]
          },
          "30230410": {
            "id": "30230410",
            "speakerId": 1004,
            "speakerName": "迪希雅",
            "text": "希望接下去我们要做的一切都能让这个世界变好。"
          }
        }
      }
    }
  ]
}
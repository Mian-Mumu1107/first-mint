{
  "lineCounts": {
    "「木偶」": 13,
    "阿帽": 13
  },
  "subQuests": [
    {
      "subId": "7335601",
      "subQuestName": "前往兰巴德酒馆附近开启茶会",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "733560101"
        ],
        "dialogs": {
          "733560101": {
            "id": "733560101",
            "speakerId": 1000,
            "speakerName": "阿帽",
            "text": "真令人不敢相信，我居然有一天能喝上你泡的茶。",
            "nextDialogs": [
              "733560102"
            ]
          },
          "733560102": {
            "id": "733560102",
            "speakerId": 1001,
            "speakerName": "「木偶」",
            "text": "有那么稀奇吗？我不过是想感谢感谢你为「数秘阵列」提供的算力核心罢了。",
            "nextDialogs": [
              "733560103"
            ]
          },
          "733560103": {
            "id": "733560103",
            "speakerId": 1001,
            "speakerName": "「木偶」",
            "text": "另外，你干嘛老是说些好像很懂我们的话？看起来真的很自来熟欸。",
            "nextDialogs": [
              "733560104"
            ]
          },
          "733560104": {
            "id": "733560104",
            "speakerId": 1000,
            "speakerName": "阿帽",
            "text": "说过了，我只是恰好很会看人而已。",
            "nextDialogs": [
              "733560105"
            ]
          },
          "733560105": {
            "id": "733560105",
            "speakerId": 1000,
            "speakerName": "阿帽",
            "text": "不过…哈，你说得对。我不该再自认为很了解你们。",
            "nextDialogs": [
              "733560106"
            ]
          },
          "733560106": {
            "id": "733560106",
            "speakerId": 1001,
            "speakerName": "「木偶」",
            "text": "嗯？",
            "nextDialogs": [
              "733560107"
            ]
          },
          "733560107": {
            "id": "733560107",
            "speakerId": 1000,
            "speakerName": "阿帽",
            "text": "光是从上次见面算起，你看起来就变了很多。",
            "nextDialogs": [
              "733560108"
            ]
          },
          "733560108": {
            "id": "733560108",
            "speakerId": 1001,
            "speakerName": "「木偶」",
            "text": "不然你还要从多久前算起？哼，我不过是接受了自己核心中的「错谬」，看清了一些事情而已。",
            "nextDialogs": [
              "733560109"
            ]
          },
          "733560109": {
            "id": "733560109",
            "speakerId": 1001,
            "speakerName": "「木偶」",
            "text": "你呢？同为某种「人偶」的你，内心也会有什么时候出现解算的错谬吗？",
            "nextDialogs": [
              "733560110"
            ]
          },
          "733560110": {
            "id": "733560110",
            "speakerId": 1000,
            "speakerName": "阿帽",
            "text": "哈…何止是「错谬」呢？",
            "nextDialogs": [
              "733560111"
            ]
          },
          "733560111": {
            "id": "733560111",
            "speakerId": 1001,
            "speakerName": "「木偶」",
            "text": "说来听听？",
            "nextDialogs": [
              "733560112"
            ]
          },
          "733560112": {
            "id": "733560112",
            "speakerId": 1000,
            "speakerName": "阿帽",
            "text": "我们还没熟到那种地步。",
            "nextDialogs": [
              "733560113"
            ]
          },
          "733560113": {
            "id": "733560113",
            "speakerId": 1001,
            "speakerName": "「木偶」",
            "text": "哈，也对。我也就礼节性问问而已。",
            "nextDialogs": [
              "733560114"
            ]
          },
          "733560114": {
            "id": "733560114",
            "speakerId": 1001,
            "speakerName": "「木偶」",
            "text": "不管怎么说，人偶在寻找「心」这件事上，恐怕都会绕不少弯子。至少我是这样。",
            "nextDialogs": [
              "733560115"
            ]
          },
          "733560115": {
            "id": "733560115",
            "speakerId": 1000,
            "speakerName": "阿帽",
            "text": "你似乎同创造了你的人关系不错？",
            "nextDialogs": [
              "733560116"
            ]
          },
          "733560116": {
            "id": "733560116",
            "speakerId": 1001,
            "speakerName": "「木偶」",
            "text": "嗯，他给予了我很多帮助和指引，不论是生前还是死后。",
            "nextDialogs": [
              "733560117"
            ]
          },
          "733560117": {
            "id": "733560117",
            "speakerId": 1000,
            "speakerName": "阿帽",
            "text": "那这点上我就同你有根本性的区别。",
            "nextDialogs": [
              "733560118"
            ]
          },
          "733560118": {
            "id": "733560118",
            "speakerId": 1001,
            "speakerName": "「木偶」",
            "text": "…哦。这样吗。",
            "nextDialogs": [
              "733560119"
            ]
          },
          "733560119": {
            "id": "733560119",
            "speakerId": 1001,
            "speakerName": "「木偶」",
            "text": "抱歉，虽说在「人偶」这点上有些相似，但我也不该就此觉得理解了你什么。",
            "nextDialogs": [
              "733560120"
            ]
          },
          "733560120": {
            "id": "733560120",
            "speakerId": 1000,
            "speakerName": "阿帽",
            "text": "不，别在意。用你的说法，我也已经「接受」了曾经的「错谬」。",
            "nextDialogs": [
              "733560121"
            ]
          },
          "733560121": {
            "id": "733560121",
            "speakerId": 1000,
            "speakerName": "阿帽",
            "text": "只不过我走的弯路有些太多了。弥补它需要走更长的路。",
            "nextDialogs": [
              "733560122"
            ]
          },
          "733560122": {
            "id": "733560122",
            "speakerId": 1001,
            "speakerName": "「木偶」",
            "text": "那…加油？用你的说法，我也没和你熟到能给出更多建议。",
            "nextDialogs": [
              "733560123"
            ]
          },
          "733560123": {
            "id": "733560123",
            "speakerId": 1000,
            "speakerName": "阿帽",
            "text": "哈…彼此彼此吧。"
          }
        }
      }
    },
    {
      "subId": "7335602",
      "subQuestName": "前往兰巴德酒馆附近开启茶会",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "733560201"
        ],
        "dialogs": {
          "733560201": {
            "id": "733560201",
            "speakerId": 1000,
            "speakerName": "阿帽",
            "text": "各有各的路要走，不必多言。茶倒是不错。",
            "nextDialogs": [
              "733560202"
            ]
          },
          "733560202": {
            "id": "733560202",
            "speakerId": 1001,
            "speakerName": "「木偶」",
            "text": "（再这么坐一会儿吧。）",
            "nextDialogs": [
              "733560204"
            ]
          },
          "733560204": {
            "id": "733560204",
            "speakerId": 1000,
            "speakerName": "阿帽",
            "text": "行，再见。"
          }
        }
      }
    },

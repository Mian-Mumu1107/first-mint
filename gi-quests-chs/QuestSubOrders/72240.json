    "派蒙": 12,
    "？？？": 1
  },
  "subQuests": [
    {
      "subId": "7224001",
      "subQuestName": "与残影对话",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "722400101"
        ],
        "dialogs": {
          "722400101": {
            "id": "722400101",
            "speakerId": 10205,
            "speakerName": "？？？",
            "text": "哦哦，你们也是来品尝我杰作的吗？",
            "nextDialogs": [
              "722400102"
            ]
          },
          "722400102": {
            "id": "722400102",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "你是渊下宫的大厨吗？",
            "nextDialogs": [
              "722400103"
            ]
          },
          "722400103": {
            "id": "722400103",
            "speakerId": 20347,
            "speakerName": "伊达",
            "text": "我叫伊达，原本名字是代达洛斯，欧律达忒之子，是个迷宫艺术家！你们刚才经历的谜题就是我的杰作。",
            "nextDialogs": [
              "722400104"
            ]
          },
          "722400104": {
            "id": "722400104",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "原来是你整出来的。再！见！",
            "nextDialogs": [
              "722400105"
            ]
          },
          "722400105": {
            "id": "722400105",
            "speakerId": 20347,
            "speakerName": "伊达",
            "text": "喂，等等等等！我可不是那种只会在纸上画图的小鬼头。我不仅是迷宫艺术家，还是白夜国历史第二好的建筑师！",
            "nextDialogs": [
              "722400106"
            ]
          },
          "722400106": {
            "id": "722400106",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "第一是谁啊？",
            "nextDialogs": [
              "722400107"
            ]
          },
          "722400107": {
            "id": "722400107",
            "speakerId": 20347,
            "speakerName": "伊达",
            "text": "那必定是阿倍良久之命大人啊。大日御舆算第二的话，没别的建筑敢称第一了。",
            "nextDialogs": [
              "722400108"
            ]
          },
          "722400108": {
            "id": "722400108",
            "speakerId": 20347,
            "speakerName": "伊达",
            "text": "能见到我说明你已经通关了我的第一处新感觉派迷宫。",
            "nextDialogs": [
              "722400109"
            ]
          },
          "722400109": {
            "id": "722400109",
            "speakerId": 20347,
            "speakerName": "伊达",
            "text": "怎么样，有没有兴趣挑战一下我另一处的反本格派迷宫啊。和只用墙的迷宫完全不同哦。",
            "nextDialogs": [
              "722400110"
            ]
          },
          "722400110": {
            "id": "722400110",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "不必。已经品鉴得够多了。",
            "nextDialogs": [
              "722400111"
            ]
          },
          "722400111": {
            "id": "722400111",
            "speakerId": 20347,
            "speakerName": "伊达",
            "text": "别、别这样啊。这件迷宫杰作，是在空间和时间、资金都充裕的情况下做出来的。",
            "nextDialogs": [
              "722400112"
            ]
          },
          "722400112": {
            "id": "722400112",
            "speakerId": 20347,
            "speakerName": "伊达",
            "text": "因为已经有一部分人去海面海祇岛生活了，所以地下的土地挺富余的。",
            "nextDialogs": [
              "722400113"
            ]
          },
          "722400113": {
            "id": "722400113",
            "speakerId": 20347,
            "speakerName": "伊达",
            "text": "我特地借来了《白夜国水文考》，研究了承重和地下空间的最大利用，避开了可能的渗水问题，甚至还兼顾了风水！",
            "nextDialogs": [
              "722400114"
            ]
          },
          "722400114": {
            "id": "722400114",
            "speakerId": 20347,
            "speakerName": "伊达",
            "text": "虽然对不起绘真，书不小心被我落在奖励密室里了…",
            "nextDialogs": [
              "722400115"
            ]
          },
          "722400115": {
            "id": "722400115",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "你在小声说什么？",
            "nextDialogs": [
              "722400116"
            ]
          },
          "722400116": {
            "id": "722400116",
            "speakerId": 20347,
            "speakerName": "伊达",
            "text": "没什么！我隆重邀请您挑战我的迷宫杰作。",
            "nextDialogs": [
              "722400129"
            ]
          },
          "722400129": {
            "id": "722400129",
            "speakerId": 20347,
            "speakerName": "伊达",
            "text": "总之先收下这个钥匙吧。用它可以开启谜题。",
            "nextDialogs": [
              "722400117"
            ]
          },
          "722400117": {
            "id": "722400117",
            "speakerId": 20347,
            "speakerName": "伊达",
            "text": "挑战成功还能拿到我亲自制作的认可状纪念章哦。",
            "nextDialogs": [
              "722400118"
            ]
          },
          "722400118": {
            "id": "722400118",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "并不是那么稀罕就是了。",
            "nextDialogs": [
              "722400119"
            ]
          },
          "722400119": {
            "id": "722400119",
            "speakerId": 20347,
            "speakerName": "伊达",
            "text": "我的宝藏也藏在前面的密室里了！拿到两个认可状就可以打开宝库哦。",
            "nextDialogs": [
              "722400120"
            ]
          },
          "722400120": {
            "id": "722400120",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "这、这样啊。有空有心情的话我们会去试试的。",
            "nextDialogs": [
              "722400121"
            ]
          },
          "722400121": {
            "id": "722400121",
            "speakerId": 20347,
            "speakerName": "伊达",
            "text": "好的呀。期待你们的反馈。",
            "nextDialogs": [
              "722400122"
            ]
          },
          "722400122": {
            "id": "722400122",
            "speakerId": 20347,
            "speakerName": "伊达",
            "text": "啊，对了，既然你们通关了第一处迷宫，应该已经拿到第一枚认可状了吧！",
            "nextDialogs": [
              "722400123"
            ]
          },
          "722400123": {
            "id": "722400123",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "哦，哦…",
            "nextDialogs": [
              "722400124"
            ]
          },
          "722400124": {
            "id": "722400124",
            "speakerId": 20347,
            "speakerName": "伊达",
            "text": "有什么反馈吗？",
            "nextDialogs": [
              "722400125"
            ]
          },
          "722400125": {
            "id": "722400125",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "怎么说呢。感觉…",
            "nextDialogs": [
              "722400126"
            ]
          },
          "722400126": {
            "id": "722400126",
            "speakerId": 20347,
            "speakerName": "伊达",
            "text": "感觉？",
            "nextDialogs": [
              "722400127"
            ]
          },
          "722400127": {
            "id": "722400127",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "感觉缺少一点「噼咔」的感觉。",
            "nextDialogs": [
              "722400128"
            ]
          },
          "722400128": {
            "id": "722400128",
            "speakerId": 20347,
            "speakerName": "伊达",
            "text": "「噼咔」，「噼咔」又是什么感觉？"
          }
        }
      }
    },
    {
      "subId": "7224002",
      "subQuestName": "获得另一个「伊达的认可状」",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "722400201"
        ],
        "dialogs": {
          "722400201": {
            "id": "722400201",
            "speakerId": 20347,
            "speakerName": "伊达",
            "text": "那边的迷宫也通关了吗？不错不错。你们赢得了我的认可。",
            "nextDialogs": [
              "722400202"
            ]
          },
          "722400202": {
            "id": "722400202",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "哦，哦…",
            "nextDialogs": [
              "722400203"
            ]
          },
          "722400203": {
            "id": "722400203",
            "speakerId": 20347,
            "speakerName": "伊达",
            "text": "有什么评价吗？",
            "nextDialogs": [
              "722400204"
            ]
          },
          "722400204": {
            "id": "722400204",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "评价？这个嘛…",
            "nextDialogs": [
              "722400205"
            ]
          },
          "722400205": {
            "id": "722400205",
            "speakerId": 20347,
            "speakerName": "伊达",
            "text": "嗯嗯，是不是觉得非常精妙非常厉害？",
            "nextDialogs": [
              "722400206"
            ]
          },
          "722400206": {
            "id": "722400206",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "欸…欸嘿！",
            "nextDialogs": [
              "722400207"
            ]
          },
          "722400207": {
            "id": "722400207",
            "speakerId": 20347,
            "speakerName": "伊达",
            "text": "「欸嘿」是什么意思啊！",
            "nextDialogs": [
              "722400208"
            ]
          },
          "722400208": {
            "id": "722400208",
            "speakerId": 20347,
            "speakerName": "伊达",
            "text": "咳咳。既然你们已经收集了两枚认可状，密室的通道应该就打开了。",
            "nextDialogs": [
              "722400209"
            ]
          },
          "722400209": {
            "id": "722400209",
            "speakerId": 20347,
            "speakerName": "伊达",
            "text": "把认可状放进去就可以打开宝库门了。"
          }
        }
      }
    },

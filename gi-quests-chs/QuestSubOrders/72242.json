  "subQuests": [
    {
      "subId": "7224201",
      "subQuestName": "前往洞穴深处",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "722420101"
        ],
        "dialogs": {
          "722420101": {
            "id": "722420101",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "哦哦，走了这么久，终于有个像是文明遗迹的东西了。我们靠近看看吧。"
          }
        }
      }
    },
    {
      "subId": "7224202",
      "subQuestName": "",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "722420201"
        ],
        "dialogs": {
          "722420201": {
            "id": "722420201",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "这个大门上的五个符文，似乎就是「键纹」的样式啊。",
            "nextDialogs": [
              "722420202"
            ]
          },
          "722420202": {
            "id": "722420202",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "我们去周围看看吧。根据长久以来的经验，应该又得做点什么才行。"
          }
        }
      }
    },
    {
      "subId": "7224204",
      "subQuestName": "前往前方建筑物处",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "722420401"
        ],
        "dialogs": {
          "722420401": {
            "id": "722420401",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "原来海祇岛下面有这么巨大的空间嘛！",
            "nextDialogs": [
              "722420402"
            ]
          },
          "722420402": {
            "id": "722420402",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "看起来，我们的目标应该就是中间那个地方了吧。",
            "nextDialogs": [
              "722420403"
            ]
          },
          "722420403": {
            "id": "722420403",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "#好咧，{NICKNAME}，我们就稳步推进吧。",
            "nextDialogs": [
              "722420404"
            ]
          },
          "722420404": {
            "id": "722420404",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "那边的废墟看起来比较近，先从那块开始探索吧。",
            "nextDialogs": [
              "722420405"
            ]
          },
          "722420405": {
            "id": "722420405",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "有建筑物就说明曾经有人，有人的话就会留下那种纸条。",
            "nextDialogs": [
              "722420406"
            ]
          },
          "722420406": {
            "id": "722420406",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "纸多的地方最容易找到根本看不懂的提示了。"
          }
        }
      }
    },

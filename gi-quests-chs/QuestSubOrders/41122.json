  "subQuests": [
    {
      "subId": "4112201",
      "subQuestName": "与霍夫曼对话",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "411223101"
        ],
        "dialogs": {
          "411223101": {
            "id": "411223101",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "我知道了。",
            "nextDialogs": [
              "411223102"
            ]
          },
          "411223102": {
            "id": "411223102",
            "speakerId": 1000,
            "speakerName": "霍夫曼",
            "text": "那就拜托你了。"
          }
        }
      }
    },
    {
      "subId": "4112202",
      "subQuestName": "向麦克展示命令书",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "411220201"
        ],
        "dialogs": {
          "411220201": {
            "id": "411220201",
            "speakerId": 1001,
            "speakerName": "麦克",
            "text": "你好，请问你找我有事吗？",
            "nextDialogs": [
              "411220202"
            ]
          },
          "411220202": {
            "id": "411220202",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "这份命令书…",
            "nextDialogs": [
              "411220203"
            ]
          },
          "411220203": {
            "id": "411220203",
            "speakerId": 1001,
            "speakerName": "麦克",
            "text": "命令书？还真是，我看看…要我回城里协助处理各项事务…",
            "nextDialogs": [
              "411220204"
            ]
          },
          "411220204": {
            "id": "411220204",
            "speakerId": 1001,
            "speakerName": "麦克",
            "text": "哎呀，回城里倒也没问题，可是你看那两个孩子，他们一直不愿意回去城里。",
            "nextDialogs": [
              "411220205"
            ]
          },
          "411220205": {
            "id": "411220205",
            "speakerId": 1001,
            "speakerName": "麦克",
            "text": "也不知道他们家大人去哪了，我也不好把他们给强行带回去，所以只能一直在这守着他们。",
            "nextDialogs": [
              "411220206"
            ]
          },
          "411220206": {
            "id": "411220206",
            "speakerId": 1001,
            "speakerName": "麦克",
            "text": "现在这个情况，我要是回了城，这两个孩子出事了可怎么办。",
            "nextDialogs": [
              "411220207"
            ]
          },
          "411220207": {
            "id": "411220207",
            "speakerId": 1001,
            "speakerName": "麦克",
            "text": "唉，我去说了好几次，现在他们已经完全不听我说话了。",
            "nextDialogs": [
              "411220208"
            ]
          },
          "411220208": {
            "id": "411220208",
            "speakerId": 1001,
            "speakerName": "麦克",
            "text": "呃，不然…你去帮我说说？说不定他们能听你的话。",
            "nextDialogs": [
              "411220209"
            ]
          },
          "411220209": {
            "id": "411220209",
            "speakerId": 1001,
            "speakerName": "麦克",
            "text": "要是能把他们说动了，让他们乖乖回城去，那我也能安心回去了。",
            "nextDialogs": [
              "411220210"
            ]
          },
          "411220210": {
            "id": "411220210",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "我去试试看。",
            "nextDialogs": [
              "411220211"
            ]
          },
          "411220211": {
            "id": "411220211",
            "speakerId": 1001,
            "speakerName": "麦克",
            "text": "那就拜托你了。"
          }
        }
      }
    },
    {
      "subId": "4112203",
      "subQuestName": "劝说小吉",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "411220301"
        ],
        "dialogs": {
          "411220301": {
            "id": "411220301",
            "speakerId": 1002,
            "speakerName": "小吉",
            "text": "咦？有什么事吗？",
            "nextDialogs": [
              "411220302"
            ]
          },
          "411220302": {
            "id": "411220302",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "关于现在的情况…",
            "nextDialogs": [
              "411220303"
            ]
          },
          "411220303": {
            "id": "411220303",
            "speakerId": 1002,
            "speakerName": "小吉",
            "text": "陨石的事，我们知道哦。不过…我们都还没见过陨石落下来的样子。",
            "nextDialogs": [
              "411220304"
            ]
          },
          "411220304": {
            "id": "411220304",
            "speakerId": 1002,
            "speakerName": "小吉",
            "text": "小威说他知道个好位置看陨石，所以我们就来这里了。",
            "nextDialogs": [
              "411220305"
            ]
          },
          "411220305": {
            "id": "411220305",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "在城里也能看到。",
            "nextDialogs": [
              "411220306"
            ]
          },
          "411220306": {
            "id": "411220306",
            "speakerId": 1002,
            "speakerName": "小吉",
            "text": "可是在城里的话，要去很高的地方才能看见吧。",
            "nextDialogs": [
              "411220307"
            ]
          },
          "411220307": {
            "id": "411220307",
            "speakerId": 1002,
            "speakerName": "小吉",
            "text": "城里的卫兵叔叔们肯定不会让我们爬太高的…",
            "nextDialogs": [
              "411220308"
            ]
          },
          "411220308": {
            "id": "411220308",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "旁边的那位叔叔愿意帮忙。",
            "nextDialogs": [
              "411220309"
            ]
          },
          "411220309": {
            "id": "411220309",
            "speakerId": 1002,
            "speakerName": "小吉",
            "text": "咦？你说旁边那个奇怪的叔叔？可是他之前过来说话的时候，都好凶好凶。",
            "nextDialogs": [
              "411220310"
            ]
          },
          "411220310": {
            "id": "411220310",
            "speakerId": 1002,
            "speakerName": "小吉",
            "text": "也不说其他的，就是一个劲地要我们回去…",
            "nextDialogs": [
              "411220311"
            ]
          },
          "411220311": {
            "id": "411220311",
            "speakerId": 1002,
            "speakerName": "小吉",
            "text": "不过，如果他能答应带我们去很高的地方看陨石，那我觉得…回去也可以。",
            "nextDialogs": [
              "411220312"
            ]
          },
          "411220312": {
            "id": "411220312",
            "speakerId": 1002,
            "speakerName": "小吉",
            "text": "但还是请你和小威也说说吧，毕竟是他的主意。"
          }
        }
      }
    },
    {
      "subId": "4112204",
      "subQuestName": "劝说小威",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "411220401"
        ],
        "dialogs": {
          "411220401": {
            "id": "411220401",
            "speakerId": 1003,
            "speakerName": "小威",
            "text": "咦？你好，有什么事吗？",
            "nextDialogs": [
              "411220402"
            ]
          },
          "411220402": {
            "id": "411220402",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "关于现在的情况…",
            "nextDialogs": [
              "411220403"
            ]
          },
          "411220403": {
            "id": "411220403",
            "speakerId": 1003,
            "speakerName": "小威",
            "text": "我知道啊，我们就是出来看陨石的。只要看到了我们就回去了，不用担心。",
            "nextDialogs": [
              "411220404"
            ]
          },
          "411220404": {
            "id": "411220404",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "在城里也能看到。",
            "nextDialogs": [
              "411220405"
            ]
          },
          "411220405": {
            "id": "411220405",
            "speakerId": 1003,
            "speakerName": "小威",
            "text": "那得去个很高的地方才行啦，我试过了好几次，都被卫兵给叫下来了，还被训了一顿。",
            "nextDialogs": [
              "411220406"
            ]
          },
          "411220406": {
            "id": "411220406",
            "speakerId": 1003,
            "speakerName": "小威",
            "text": "所以我才带着小吉来这个地方啦。",
            "nextDialogs": [
              "411220407"
            ]
          },
          "411220407": {
            "id": "411220407",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "旁边的卫兵叔叔可以帮忙。",
            "nextDialogs": [
              "411220408"
            ]
          },
          "411220408": {
            "id": "411220408",
            "speakerId": 1003,
            "speakerName": "小威",
            "text": "帮忙？你是说，他能带我们去城里的高处看陨石吗？",
            "nextDialogs": [
              "411220409"
            ]
          },
          "411220409": {
            "id": "411220409",
            "speakerId": 1003,
            "speakerName": "小威",
            "text": "不可能吧…那个叔叔看着就很奇怪，还凶巴巴的…",
            "nextDialogs": [
              "411220410"
            ]
          },
          "411220410": {
            "id": "411220410",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "我带着命令书呢。",
            "nextDialogs": [
              "411220411"
            ]
          },
          "411220411": {
            "id": "411220411",
            "speakerId": 1003,
            "speakerName": "小威",
            "text": "真的？给我看看。哇…真的是骑士团的命令书。",
            "nextDialogs": [
              "411220412"
            ]
          },
          "411220412": {
            "id": "411220412",
            "speakerId": 1003,
            "speakerName": "小威",
            "text": "有了这个命令书，那个叔叔就能带我们去高处看陨石了吗？",
            "nextDialogs": [
              "411220413"
            ]
          },
          "411220413": {
            "id": "411220413",
            "speakerId": 1003,
            "speakerName": "小威",
            "text": "嘿嘿，能在城里看陨石，肯定是最好的了。",
            "nextDialogs": [
              "411220414"
            ]
          },
          "411220414": {
            "id": "411220414",
            "speakerId": 1003,
            "speakerName": "小威",
            "text": "那你去和那个叔叔说一声吧，我也和小吉说一下。",
            "nextDialogs": [
              "411220415"
            ]
          },
          "411220415": {
            "id": "411220415",
            "speakerId": 1003,
            "speakerName": "小威",
            "text": "哎呀，这么一想…我还挺期待看到陨石落下来的场景呢。"
          }
        }
      }
    },
    {
      "subId": "4112205",
      "subQuestName": "与麦克对话",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "411220501"
        ],
        "dialogs": {
          "411220501": {
            "id": "411220501",
            "speakerId": 1001,
            "speakerName": "麦克",
            "text": "怎么样，你说服他们了吗？",
            "nextDialogs": [
              "411220502"
            ]
          },
          "411220502": {
            "id": "411220502",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "感觉上像是说服了…",
            "nextDialogs": [
              "411220503"
            ]
          },
          "411220503": {
            "id": "411220503",
            "speakerId": 1001,
            "speakerName": "麦克",
            "text": "那就好，说服了就好！实在是多亏你了，呃…等会，什么叫「感觉上」？",
            "nextDialogs": [
              "411220504"
            ]
          },
          "411220504": {
            "id": "411220504",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "只要你愿意帮忙…",
            "nextDialogs": [
              "411220505"
            ]
          },
          "411220505": {
            "id": "411220505",
            "speakerId": 1001,
            "speakerName": "麦克",
            "text": "帮忙？帮什么忙…",
            "nextDialogs": [
              "411220506"
            ]
          },
          "411220506": {
            "id": "411220506",
            "speakerId": 1001,
            "speakerName": "麦克",
            "text": "啊？去蒙德城的最高处看陨石，那，那也有点危险吧。",
            "nextDialogs": [
              "411220507"
            ]
          },
          "411220507": {
            "id": "411220507",
            "speakerId": 1001,
            "speakerName": "麦克",
            "text": "而且还是两个孩子，这件事我还得去向骑士团打个报告…",
            "nextDialogs": [
              "411220508"
            ]
          },
          "411220508": {
            "id": "411220508",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "我可有命令书喔。",
            "nextDialogs": [
              "411220509"
            ]
          },
          "411220509": {
            "id": "411220509",
            "speakerId": 1001,
            "speakerName": "麦克",
            "text": "命令书压根不是这么个用法吧…",
            "nextDialogs": [
              "411220510"
            ]
          },
          "411220510": {
            "id": "411220510",
            "speakerId": 1001,
            "speakerName": "麦克",
            "text": "算了，只要能让那两个孩子乖乖回城里去，去高处的事…我来想办法就是。",
            "nextDialogs": [
              "411220511"
            ]
          },
          "411220511": {
            "id": "411220511",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "你真要带他们…",
            "nextDialogs": [
              "411220512"
            ]
          },
          "411220512": {
            "id": "411220512",
            "speakerId": 1001,
            "speakerName": "麦克",
            "text": "那当然，作为一名西风骑士，和一位，呃…成年人。",
            "nextDialogs": [
              "411220513"
            ]
          },
          "411220513": {
            "id": "411220513",
            "speakerId": 1001,
            "speakerName": "麦克",
            "text": "不管承诺的对象是谁，只要答应了的事情就要做到。",
            "nextDialogs": [
              "411220514"
            ]
          },
          "411220514": {
            "id": "411220514",
            "speakerId": 1001,
            "speakerName": "麦克",
            "text": "这次就麻烦你了，剩下的事交给我吧，待会我就去带他们回蒙德城。",
            "nextDialogs": [
              "411220515"
            ]
          },
          "411220515": {
            "id": "411220515",
            "speakerId": 1001,
            "speakerName": "麦克",
            "text": "然后…再想想怎么把他们带去蒙德城最高的地方…"
          }
        }
      }
    },
    {
      "subId": "4112206",
      "subQuestName": "向哈里展示命令书",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "411220601"
        ],
        "dialogs": {
          "411220601": {
            "id": "411220601",
            "speakerId": 1004,
            "speakerName": "哈里",
            "text": "你好，有什么需要帮忙的吗？",
            "nextDialogs": [
              "411220602"
            ]
          },
          "411220602": {
            "id": "411220602",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "这份命令书…",
            "nextDialogs": [
              "411220603"
            ]
          },
          "411220603": {
            "id": "411220603",
            "speakerId": 1004,
            "speakerName": "哈里",
            "text": "命令书？我看看，哦…是要我回城里吗？",
            "nextDialogs": [
              "411220604"
            ]
          },
          "411220604": {
            "id": "411220604",
            "speakerId": 1004,
            "speakerName": "哈里",
            "text": "抱歉，这份命令我得稍后再执行了，我还有更重要的事要做。",
            "nextDialogs": [
              "411220605"
            ]
          },
          "411220605": {
            "id": "411220605",
            "speakerId": 1004,
            "speakerName": "哈里",
            "text": "似乎是因为陨石的关系，这附近的魔物也受到了影响，变得格外暴躁，也格外危险。",
            "nextDialogs": [
              "411220606"
            ]
          },
          "411220606": {
            "id": "411220606",
            "speakerId": 1004,
            "speakerName": "哈里",
            "text": "为了保障这附近地区的安全，我得去把这些魔物解决掉。",
            "nextDialogs": [
              "411220607"
            ]
          },
          "411220607": {
            "id": "411220607",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "这里压根没人…",
            "nextDialogs": [
              "411220608"
            ]
          },
          "411220608": {
            "id": "411220608",
            "speakerId": 1004,
            "speakerName": "哈里",
            "text": "正是因为这附近没人，我才能放开手脚，把这群魔物彻底打倒。",
            "nextDialogs": [
              "411220609"
            ]
          },
          "411220609": {
            "id": "411220609",
            "speakerId": 1004,
            "speakerName": "哈里",
            "text": "这件事可是很重要的，不处理好的话，我可不能离开这里。",
            "nextDialogs": [
              "411220612"
            ]
          },
          "411220612": {
            "id": "411220612",
            "speakerId": 1004,
            "speakerName": "哈里",
            "text": "那太好了，这片区域里正好也有不止一个地方有魔物聚集。",
            "nextDialogs": [
              "411220613"
            ]
          },
          "411220613": {
            "id": "411220613",
            "speakerId": 1004,
            "speakerName": "哈里",
            "text": "我们分头行事，各自去解决一个地方的魔物，处理好之后，再来这里会合。"
          }
        }
      }
    },
    {
      "subId": "4112207",
      "subQuestName": "打倒所有魔物",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [],
        "dialogs": {}
      }
    },
    {
      "subId": "4112208",
      "subQuestName": "向哈里回报",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "411220801"
        ],
        "dialogs": {
          "411220801": {
            "id": "411220801",
            "speakerId": 1004,
            "speakerName": "哈里",
            "text": "那群魔物可真不好对付…",
            "nextDialogs": [
              "411220802"
            ]
          },
          "411220802": {
            "id": "411220802",
            "speakerId": 1004,
            "speakerName": "哈里",
            "text": "我已经全部处理好了，你那边怎么样？",
            "nextDialogs": [
              "411220803"
            ]
          },
          "411220803": {
            "id": "411220803",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "搞定了。",
            "nextDialogs": [
              "411220804"
            ]
          },
          "411220804": {
            "id": "411220804",
            "speakerId": 1004,
            "speakerName": "哈里",
            "text": "哈哈，你身手很利落嘛，谢谢你帮忙，这附近的魔物应该能消停一段时间了。",
            "nextDialogs": [
              "411220805"
            ]
          },
          "411220805": {
            "id": "411220805",
            "speakerId": 1004,
            "speakerName": "哈里",
            "text": "不过，我暂时还不能回去，除了这些魔物之外…在这片望风山地里，应该还有更多的魔物正在蠢蠢欲动。",
            "nextDialogs": [
              "411220806"
            ]
          },
          "411220806": {
            "id": "411220806",
            "speakerId": 1004,
            "speakerName": "哈里",
            "text": "我想留在这里继续搜集信息。而且，如果这附近还有人遇险，我也能及时援救。",
            "nextDialogs": [
              "411220807"
            ]
          },
          "411220807": {
            "id": "411220807",
            "speakerId": 1004,
            "speakerName": "哈里",
            "text": "毕竟不是每个人都知道，现在需要避难了嘛。",
            "nextDialogs": [
              "411220808"
            ]
          },
          "411220808": {
            "id": "411220808",
            "speakerId": 1004,
            "speakerName": "哈里",
            "text": "好了，你就把我说的话带回去吧，我相信霍夫曼先生会理解我的。"
          }
        }
      }
    },
    {
      "subId": "4112209",
      "subQuestName": "向霍夫曼回报",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "411226101"
        ],
        "dialogs": {
          "411226101": {
            "id": "411226101",
            "speakerId": 1000,
            "speakerName": "霍夫曼",
            "text": "对了，还得好好谢谢你。现在这样的情况，还让你到野外跑了一趟。",
            "nextDialogs": [
              "411226102"
            ]
          },
          "411226102": {
            "id": "411226102",
            "speakerId": 1000,
            "speakerName": "霍夫曼",
            "text": "这些请收下，就算是谢礼了。如果没有什么重要的事，请你也待在城里吧。"
          }
        }
      }
    },
    {
      "subId": "4112201",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "411220101"
        ],
        "dialogs": {
          "411220101": {
            "id": "411220101",
            "speakerId": 1000,
            "speakerName": "霍夫曼",
            "text": "唉，看来也没什么好办法了…",
            "nextDialogs": [
              "411220102"
            ]
          },
          "411220102": {
            "id": "411220102",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "怎么了？",
            "nextDialogs": [
              "411220103"
            ]
          },
          "411220103": {
            "id": "411220103",
            "speakerId": 1000,
            "speakerName": "霍夫曼",
            "text": "是你啊。是这样…最近从天而降的陨石，你应该也看见了。",
            "nextDialogs": [
              "411220104"
            ]
          },
          "411220104": {
            "id": "411220104",
            "speakerId": 1000,
            "speakerName": "霍夫曼",
            "text": "虽然城里运气好，一直没有被降落的陨石波及到，但是城外已经很混乱了。",
            "nextDialogs": [
              "411220105"
            ]
          },
          "411220105": {
            "id": "411220105",
            "speakerId": 1000,
            "speakerName": "霍夫曼",
            "text": "不少的人进城来避难，还有那些陷入莫名昏睡的人，城里的事务就快要忙不过来了。",
            "nextDialogs": [
              "411220106"
            ]
          },
          "411220106": {
            "id": "411220106",
            "speakerId": 1000,
            "speakerName": "霍夫曼",
            "text": "我想把在外执行任务的西风骑士们都召回来，先把城里的事务处理周全。",
            "nextDialogs": [
              "411220107"
            ]
          },
          "411220107": {
            "id": "411220107",
            "speakerId": 1000,
            "speakerName": "霍夫曼",
            "text": "但他们都分散在野外，骑士团现在也没人手出去找他们。",
            "nextDialogs": [
              "411220108"
            ]
          },
          "411220108": {
            "id": "411220108",
            "speakerId": 1000,
            "speakerName": "霍夫曼",
            "text": "你能帮我个忙，把这份命令书带过去给他们看看吗？"
          }
        }
      }
    },
    {
      "subId": "4112209",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "411220901"
        ],
        "dialogs": {
          "411220901": {
            "id": "411220901",
            "speakerId": 1000,
            "speakerName": "霍夫曼",
            "text": "怎么样，他们都看到命令书了吗？",
            "nextDialogs": [
              "411220902"
            ]
          },
          "411220902": {
            "id": "411220902",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "看到了，但是…",
            "nextDialogs": [
              "411220903"
            ]
          },
          "411220903": {
            "id": "411220903",
            "speakerId": 1000,
            "speakerName": "霍夫曼",
            "text": "但是？发生什么了吗？"
          }
        }
      }
    },
    {
      "subId": "4112232",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "411223201"
        ],
        "dialogs": {
          "411223201": {
            "id": "411223201",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "还有别的事。",
            "nextDialogs": [
              "411223202"
            ]
          },
          "411223202": {
            "id": "411223202",
            "speakerId": 1000,
            "speakerName": "霍夫曼",
            "text": "好吧，我再找别人帮忙…或者想想另外的办法。"
          }
        }
      }
    },
    {
      "subId": "4112251",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "411225101"
        ],
        "dialogs": {
          "411225101": {
            "id": "411225101",
            "speakerId": 1000,
            "speakerName": "霍夫曼",
            "text": "落下来的陨石居然没有波及到城里，真是万幸…"
          }
        }
      }
    },
    {
      "subId": "4112252",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "411225201"
        ],
        "dialogs": {
          "411225201": {
            "id": "411225201",
            "speakerId": 1001,
            "speakerName": "麦克",
            "text": "这两个孩子真是，这个时候了还想着玩…"
          }
        }
      }
    },
    {
      "subId": "4112253",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "411225301"
        ],
        "dialogs": {
          "411225301": {
            "id": "411225301",
            "speakerId": 1002,
            "speakerName": "小吉",
            "text": "那个叔叔真的很奇怪，一直跟着我们，上来说话的时候也凶巴巴的…"
          }
        }
      }
    },
    {
      "subId": "4112254",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "411225401"
        ],
        "dialogs": {
          "411225401": {
            "id": "411225401",
            "speakerId": 1003,
            "speakerName": "小威",
            "text": "陨石从天上落下来，到底是个怎么样的场景呢…"
          }
        }
      }
    },
    {
      "subId": "4112255",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "411225501"
        ],
        "dialogs": {
          "411225501": {
            "id": "411225501",
            "speakerId": 1001,
            "speakerName": "麦克",
            "text": "呃…蒙德城最高的地方是哪来着…"
          }
        }
      }
    },
    {
      "subId": "4112256",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "411225601"
        ],
        "dialogs": {
          "411225601": {
            "id": "411225601",
            "speakerId": 1004,
            "speakerName": "哈里",
            "text": "嗯？我待会就出发了，你先去吧。处理好之后，我们再来这里会合。"
          }
        }
      }
    },
    {
      "subId": "4112258",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "411225801"
        ],
        "dialogs": {
          "411225801": {
            "id": "411225801",
            "speakerId": 1004,
            "speakerName": "哈里",
            "text": "必须对那些魔物提高警惕…"
          }
        }
      }
    },
    {
      "subId": "4112259",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "411225901"
        ],
        "dialogs": {
          "411225901": {
            "id": "411225901",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "关于麦克…",
            "nextDialogs": [
              "411225902"
            ]
          },
          "411225902": {
            "id": "411225902",
            "speakerId": 1000,
            "speakerName": "霍夫曼",
            "text": "要去蒙德城的最高处看陨石？哈哈哈，好吧，好吧。",
            "nextDialogs": [
              "411225903"
            ]
          },
          "411225903": {
            "id": "411225903",
            "speakerId": 1000,
            "speakerName": "霍夫曼",
            "text": "只要能让那两个孩子乖乖回来，只要麦克给我打个报告就好了。",
            "nextDialogs": [
              "411225904"
            ]
          },
          "411225904": {
            "id": "411225904",
            "speakerId": 1000,
            "speakerName": "霍夫曼",
            "text": "这家伙一直不会和小孩子打交道，这次肯定被好好折腾了一顿。",
            "nextDialogs": [
              "411225905"
            ]
          },
          "411225905": {
            "id": "411225905",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "关于哈里…",
            "nextDialogs": [
              "411225906"
            ]
          },
          "411225906": {
            "id": "411225906",
            "speakerId": 1000,
            "speakerName": "霍夫曼",
            "text": "哈里…他还要在望风山地那边警戒吗？",
            "nextDialogs": [
              "411225907"
            ]
          },
          "411225907": {
            "id": "411225907",
            "speakerId": 1000,
            "speakerName": "霍夫曼",
            "text": "嗯…也好，如果那边出现了什么意外情况，他也可以迅速回报。",
            "nextDialogs": [
              "411225908"
            ]
          },
          "411225908": {
            "id": "411225908",
            "speakerId": 1000,
            "speakerName": "霍夫曼",
            "text": "不过，那家伙性格有些冲动…希望他别闹出什么乱子。"
          }
        }
      }
    },

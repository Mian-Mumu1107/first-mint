            "speakerId": 10095,
            "speakerName": "莫娜",
            "text": "真是个大家伙。"
          }
        }
      }
    },
    {
      "subId": "4111309",
      "subQuestName": "(test)与菲谢尔对话（隐藏）$HIDDEN",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "411130901"
        ],
        "dialogs": {
          "411130901": {
            "id": "411130901",
            "speakerId": 10095,
            "speakerName": "莫娜",
            "text": "就是它了。",
            "nextDialogs": [
              "411130902"
            ]
          },
          "411130902": {
            "id": "411130902",
            "speakerId": 10012,
            "speakerName": "奥兹",
            "text": "我能从中感受到空前强大的元素力。",
            "nextDialogs": [
              "411130903"
            ]
          },
          "411130903": {
            "id": "411130903",
            "speakerId": 10011,
            "speakerName": "菲谢尔",
            "text": "漆黑寂灭之根源…降临了。",
            "nextDialogs": [
              "411130904"
            ]
          },
          "411130904": {
            "id": "411130904",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "那些愚人众，难道是冲着元素力来的？",
            "nextDialogs": [
              "411130905"
            ]
          },
          "411130905": {
            "id": "411130905",
            "speakerId": 10095,
            "speakerName": "莫娜",
            "text": "不无可能。如果是这样，其他生物也会想要这股力量才对。",
            "nextDialogs": [
              "411130906"
            ]
          },
          "411130906": {
            "id": "411130906",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "我们靠近看看吧。"
          }
        }
      }
    },
    {
      "subId": "4111311",

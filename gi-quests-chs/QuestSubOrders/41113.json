        "dialogs": {}
      }
    },
    {
      "subId": "4111307",
      "subQuestName": "将陨石的信息告诉莫娜",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "411130701"
        ],
        "dialogs": {
          "411130701": {
            "id": "411130701",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "莫娜，我们问到了！",
            "nextDialogs": [
              "411130702"
            ]
          },
          "411130702": {
            "id": "411130702",
            "speakerId": 10011,
            "speakerName": "菲谢尔",
            "text": "高耸入云的雪山，想必那就是黑暗滋生的蘖芽。",
            "nextDialogs": [
              "411130703"
            ]
          },
          "411130703": {
            "id": "411130703",
            "speakerId": 10095,
            "speakerName": "莫娜",
            "text": "雪山？就这一条吗？",
            "nextDialogs": [
              "411130704"
            ]
          },
          "411130704": {
            "id": "411130704",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "所有人都梦见同一座雪山。",
            "nextDialogs": [
              "411130705"
            ]
          },
          "411130705": {
            "id": "411130705",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "高耸入云、见所未见的雪山，温度极低，而且，梦中所有人不受控制地想要登上山顶。",
            "nextDialogs": [
              "411130706"
            ]
          },
          "411130706": {
            "id": "411130706",
            "speakerId": 10095,
            "speakerName": "莫娜",
            "text": "登上山顶…登上山顶？",
            "nextDialogs": [
              "411130707"
            ]
          },
          "411130707": {
            "id": "411130707",
            "speakerId": 10095,
            "speakerName": "莫娜",
            "text": "什么人会想登上山顶？而且如此渴望，甚至能影响到他人？",
            "nextDialogs": [
              "411130708"
            ]
          },
          "411130708": {
            "id": "411130708",
            "speakerId": 10011,
            "speakerName": "菲谢尔",
            "text": "雪山上埋着被迫害致死的人吗？",
            "nextDialogs": [
              "411130709"
            ]
          },
          "411130709": {
            "id": "411130709",
            "speakerId": 10012,
            "speakerName": "奥兹",
            "text": "或者是…对雪山充满渴望的挑战者。",
            "nextDialogs": [
              "411130710"
            ]
          },
          "411130710": {
            "id": "411130710",
            "speakerId": 10095,
            "speakerName": "莫娜",
            "text": "我再算一次！",
            "nextDialogs": [
              "411130711"
            ]
          },
          "411130711": {
            "id": "411130711",
            "speakerId": 10095,
            "speakerName": "莫娜",
            "text": "有了！隐约能看到一点新线索，他的名字是…<color=#00E1FFFF>莱纳德</color>！",
            "nextDialogs": [
              "411130712"
            ]
          },
          "411130712": {
            "id": "411130712",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "哎？！这么快？！",
            "nextDialogs": [
              "411130713"
            ]
          },
          "411130713": {
            "id": "411130713",
            "speakerId": 10095,
            "speakerName": "莫娜",
            "text": "早就告诉过你了，我是天才呀！",
            "nextDialogs": [
              "411130714"
            ]
          },
          "411130714": {
            "id": "411130714",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "莱纳德…没听过的名字呢。"
          }
        }
      }
    },
    {
      "subId": "4111316",
      "subQuestName": "(test)保护我的传送$HIDDEN",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "411131601"
        ],
        "dialogs": {
          "411131601": {
            "id": "411131601",
            "speakerId": 10013,
            "speakerName": "「散兵」",
            "text": "嗨。"
          }
        }
      }
    },
    {
      "subId": "4111308",
      "subQuestName": "(test)散兵cs后的对话$HIDDEN",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "411130715"
        ],
        "dialogs": {
          "411130715": {
            "id": "411130715",
            "speakerId": 10095,
            "speakerName": "莫娜",
            "text": "即使用最简易的占卜，也能察知那个人…是「愚人众执行官」！太危险了，你们怎么会和他有来往？",
            "nextDialogs": [
              "411130716"
            ]
          },
          "411130716": {
            "id": "411130716",
            "speakerId": 10012,
            "speakerName": "奥兹",
            "text": "什么，那位少年是愚人众执行官？何等邪恶的人物…！",
            "nextDialogs": [
              "411130717"
            ]
          },
          "411130717": {
            "id": "411130717",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "居然是执行官？",
            "nextDialogs": [
              "411130718"
            ]
          },
          "411130718": {
            "id": "411130718",
            "speakerId": 10095,
            "speakerName": "莫娜",
            "text": "他接近你一定是有所图谋。",
            "nextDialogs": [
              "411130719"
            ]
          },
          "411130719": {
            "id": "411130719",
            "speakerId": 10095,
            "speakerName": "莫娜",
            "text": "而且他非常强！看上一眼就能感觉到，他的实力超乎想象。",
            "nextDialogs": [
              "411130720"
            ]
          },
          "411130720": {
            "id": "411130720",
            "speakerId": 10095,
            "speakerName": "莫娜",
            "text": "虽然不想承认，但…",
            "nextDialogs": [
              "411130721"
            ]
          },
          "411130721": {
            "id": "411130721",
            "speakerId": 10012,
            "speakerName": "奥兹",
            "text": "难道他比身为罕见占星天才的莫娜女士更强大？",
            "nextDialogs": [
              "411130722"
            ]
          },
          "411130722": {
            "id": "411130722",
            "speakerId": 10095,
            "speakerName": "莫娜",
            "text": "谁、谁说的！他不过是实力险胜一筹而已，单论占星术可比我差远了！",
            "nextDialogs": [
              "411130723"
            ]
          },
          "411130723": {
            "id": "411130723",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "对了对了，我们在望舒客栈附近也遇到过愚人众的人！",
            "nextDialogs": [
              "411130724"
            ]
          },
          "411130724": {
            "id": "411130724",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "愚人众为什么对陨石如此关心？",
            "nextDialogs": [
              "411130725"
            ]
          },
          "411130725": {
            "id": "411130725",
            "speakerId": 10095,
            "speakerName": "莫娜",
            "text": "果然是有什么阴谋吧。",
            "nextDialogs": [
              "411130726"
            ]
          },
          "411130726": {
            "id": "411130726",
            "speakerId": 10095,
            "speakerName": "莫娜",
            "text": "唔，难道说…",
            "nextDialogs": [
              "411130727"
            ]
          },
          "411130727": {
            "id": "411130727",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "啊！该不会，这批陨石就是愚人众搞出来的吧？",
            "nextDialogs": [
              "411130728"
            ]
          },
          "411130728": {
            "id": "411130728",
            "speakerId": 10095,
            "speakerName": "莫娜",
            "text": "派蒙！你竟敢抢我台词！",
            "nextDialogs": [
              "411130729"
            ]
          },
          "411130729": {
            "id": "411130729",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "哎嘿嘿…不好意思，还是我的嘴比较快。",
            "nextDialogs": [
              "411130730"
            ]
          },
          "411130730": {
            "id": "411130730",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "可是，世上有召唤陨石的法术吗？",
            "nextDialogs": [
              "411130731"
            ]
          },
          "411130731": {
            "id": "411130731",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "从天上拉下一颗星星，太夸张了！",
            "nextDialogs": [
              "411130732"
            ]
          },
          "411130732": {
            "id": "411130732",
            "speakerId": 10011,
            "speakerName": "菲谢尔",
            "text": "奥兹华尔多·赫芙那梵茵斯，你怎么看？",
            "nextDialogs": [
              "411130733"
            ]
          },
          "411130733": {
            "id": "411130733",
            "speakerId": 10012,
            "speakerName": "奥兹",
            "text": "小姐，我认为一切均有可能。",
            "nextDialogs": [
              "411130734"
            ]
          },
          "411130734": {
            "id": "411130734",
            "speakerId": 10011,
            "speakerName": "菲谢尔",
            "text": "只要投以同等的代价，不祥之种就会在任何地方扎根…愚人众，本皇女记住你们了。",
            "nextDialogs": [
              "411130735"
            ]
          },
          "411130735": {
            "id": "411130735",
            "speakerId": 10012,
            "speakerName": "奥兹",
            "text": "哈，奇迹也是可能发生的。",
            "nextDialogs": [
              "411130736"
            ]
          },
          "411130736": {
            "id": "411130736",
            "speakerId": 10011,
            "speakerName": "菲谢尔",
            "text": "群星的使者，不愧是我优秀的扈从！我会指派部下保护你，使你免遭黑暗的侵袭。",
            "nextDialogs": [
              "411130737"
            ]
          },
          "411130737": {
            "id": "411130737",
            "speakerId": 10012,
            "speakerName": "奥兹",
            "text": "比方说，我。",
            "nextDialogs": [
              "411130738"
            ]
          },
          "411130738": {
            "id": "411130738",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "不不不，我们的战斗力安排很合理，保持现在这样就好！",
            "nextDialogs": [
              "411130739"
            ]
          },
          "411130739": {
            "id": "411130739",
            "speakerId": 10095,
            "speakerName": "莫娜",
            "text": "菲谢尔，你在小看我吗？我可是很强的哦！",
            "nextDialogs": [
              "411130740"
            ]
          },
          "411130740": {
            "id": "411130740",
            "speakerId": 10012,
            "speakerName": "奥兹",
            "text": "没有比你更值得信赖的人了，女士。只不过，皇女也会担心你的安危。",
            "nextDialogs": [
              "411130741"
            ]
          },
          "411130741": {
            "id": "411130741",
            "speakerId": 10095,
            "speakerName": "莫娜",
            "text": "没那个必要。再说，你们所处的环境比我更危险，可能的话，我还想保护你们呢。",
            "nextDialogs": [
              "411130743",
              "411130745"
            ]
          },
          "411130743": {
            "id": "411130743",
            "speakerId": 10095,
            "speakerName": "莫娜",
            "text": "干、干嘛突然说这种话…",
            "nextDialogs": [
              "411130746"
            ]
          },
          "411130746": {
            "id": "411130746",
            "speakerId": 10095,
            "speakerName": "莫娜",
            "text": "先解决新的麻烦吧，星盘显示，有一颗<color=#00E1FFFF>巨大的陨石</color>落地了。"
          },
          "411130745": {
            "id": "411130745",
            "speakerId": 10011,
            "speakerName": "菲谢尔",
            "text": "那、那是当然的啦！"
          }
        }
      }
    },

  "subQuests": [
    {
      "subId": "4111301",
      "subQuestName": "和莫娜聊聊有关陨石和占卜的事",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "411130101"
        ],
        "dialogs": {
          "411130101": {
            "id": "411130101",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "莫娜！托你的福，我们清了好些陨石呢！",
            "nextDialogs": [
              "411130102"
            ]
          },
          "411130102": {
            "id": "411130102",
            "speakerId": 10095,
            "speakerName": "莫娜",
            "text": "啊，正好！有件事需要你们去办一下。",
            "nextDialogs": [
              "411130103"
            ]
          },
          "411130103": {
            "id": "411130103",
            "speakerId": 10095,
            "speakerName": "莫娜",
            "text": "记得吗？我说过这片陨石是某个人的命之座。",
            "nextDialogs": [
              "411130104"
            ]
          },
          "411130104": {
            "id": "411130104",
            "speakerId": 10095,
            "speakerName": "莫娜",
            "text": "距离遥远的星星突然坠落在地，按理说这不可能。但事实就是如此矛盾。",
            "nextDialogs": [
              "411130105"
            ]
          },
          "411130105": {
            "id": "411130105",
            "speakerId": 10095,
            "speakerName": "莫娜",
            "text": "想破解谜题，最好的办法就是查清命之座的主人。",
            "nextDialogs": [
              "411130106"
            ]
          },
          "411130106": {
            "id": "411130106",
            "speakerId": 10095,
            "speakerName": "莫娜",
            "text": "你说过被陨石影响的人会陷入梦境，而且似乎都梦见了一座雪山。",
            "nextDialogs": [
              "411130107"
            ]
          },
          "411130107": {
            "id": "411130107",
            "speakerId": 10095,
            "speakerName": "莫娜",
            "text": "未知的高山、覆雪之地…却又不是龙脊雪山，否则一定会有人认出山势的。",
            "nextDialogs": [
              "411130108"
            ]
          },
          "411130108": {
            "id": "411130108",
            "speakerId": 10095,
            "speakerName": "莫娜",
            "text": "是不是所有人都有着共通的梦境？梦中他们身处什么地方？这些都很重要。",
            "nextDialogs": [
              "411130109"
            ]
          },
          "411130109": {
            "id": "411130109",
            "speakerId": 10095,
            "speakerName": "莫娜",
            "text": "我需要你搜集更多关于梦境的信息。线索越多，越容易查到真相。",
            "nextDialogs": [
              "411130110"
            ]
          },
          "411130110": {
            "id": "411130110",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "看来，得找个人多的地方调查一下。",
            "nextDialogs": [
              "411130111"
            ]
          },
          "411130111": {
            "id": "411130111",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "再去找些患者问问话吧！",
            "nextDialogs": [
              "411130112"
            ]
          },
          "411130112": {
            "id": "411130112",
            "speakerId": 10095,
            "speakerName": "莫娜",
            "text": "我必须留在不受干扰的环境里，调查就拜托你们了。",
            "nextDialogs": [
              "411130113"
            ]
          },
          "411130113": {
            "id": "411130113",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "还有我们没去过的地方吗？",
            "nextDialogs": [
              "411130114"
            ]
          },
          "411130114": {
            "id": "411130114",
            "speakerId": 10012,
            "speakerName": "奥兹",
            "text": "在璃月，有一座<color=#00E1FFFF>轻策庄</color>…虽然那里并不是什么「人多的地方」。",
            "nextDialogs": [
              "411130115"
            ]
          },
          "411130115": {
            "id": "411130115",
            "speakerId": 10012,
            "speakerName": "奥兹",
            "text": "但我想，那里也许会像望舒客栈一样被千岩军临时征用，成为救治患者的场所吧。"
          }
        }
      }
    },
    {
      "subId": "4111318",
      "subQuestName": "前往轻策庄",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "411131801"
        ],
        "dialogs": {
          "411131801": {
            "id": "411131801",
            "speakerId": 30026,
            "speakerName": "高老六",
            "text": "这次多亏了你们几位，否则，我怕是要睡到饿死喽！"
          }
        }
      }
    },
    {
      "subId": "4111302",
      "subQuestName": "与千岩军对话",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "411130201"
        ],
        "dialogs": {
          "411130201": {
            "id": "411130201",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "你好，我们来自冒险家协会。请问轻策庄一带受陨石影响大吗？",
            "nextDialogs": [
              "411130202"
            ]
          },
          "411130202": {
            "id": "411130202",
            "speakerId": 30014,
            "speakerName": "经纶",
            "text": "是冒险家啊！太好了，正愁没人呢！",
            "nextDialogs": [
              "411130203"
            ]
          },
          "411130203": {
            "id": "411130203",
            "speakerId": 30014,
            "speakerName": "经纶",
            "text": "这几天，陨石动不动就从天上掉下来，别提有多麻烦了。",
            "nextDialogs": [
              "411130204"
            ]
          },
          "411130204": {
            "id": "411130204",
            "speakerId": 30014,
            "speakerName": "经纶",
            "text": "落在<color=#00E1FFFF>田里</color>，谁都不敢去收粮食，落在<color=#00E1FFFF>大门口</color>，进出又成了问题。",
            "nextDialogs": [
              "411130205"
            ]
          },
          "411130205": {
            "id": "411130205",
            "speakerId": 30014,
            "speakerName": "经纶",
            "text": "你们有办法清理这些陨石吗？实在是太碍事了！",
            "nextDialogs": [
              "411130206"
            ]
          },
          "411130206": {
            "id": "411130206",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "看来轻策庄也遇到了麻烦。",
            "nextDialogs": [
              "411130207"
            ]
          },
          "411130207": {
            "id": "411130207",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "没办法，该我们出手了。"
          }
        }
      }
    },
    {
      "subId": "4111303",
      "subQuestName": "清理田地里的陨石",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "411130301"
        ],
        "dialogs": {
          "411130301": {
            "id": "411130301",
            "speakerId": 30014,
            "speakerName": "经纶",
            "text": "清理陨石的事还请你多多帮忙了。"
          }
        }
      }
    },

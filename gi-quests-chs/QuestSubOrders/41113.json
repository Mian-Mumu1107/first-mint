    {
      "subId": "4111310",
      "subQuestName": "向经纶汇报",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "411131001"
        ],
        "dialogs": {
          "411131001": {
            "id": "411131001",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "陨石都清理完了！",
            "nextDialogs": [
              "411131002"
            ]
          },
          "411131002": {
            "id": "411131002",
            "speakerId": 30014,
            "speakerName": "经纶",
            "text": "几位真是帮大忙了！",
            "nextDialogs": [
              "411131003"
            ]
          },
          "411131003": {
            "id": "411131003",
            "speakerId": 10012,
            "speakerName": "奥兹",
            "text": "迄今为止有患者醒来吗？",
            "nextDialogs": [
              "411131004"
            ]
          },
          "411131004": {
            "id": "411131004",
            "speakerId": 30014,
            "speakerName": "经纶",
            "text": "哎呀，我也不清楚…您直接过去看看好了。"
          }
        }
      }
    },
    {
      "subId": "4111312",
      "subQuestName": "调查附近的病患（0/3）",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "411131201"
        ],
        "dialogs": {
          "411131201": {
            "id": "411131201",
            "speakerId": 10011,
            "speakerName": "菲谢尔",
            "text": "凡民！你也沉沦在苦难的境界之中？",
            "nextDialogs": [
              "411131202"
            ]
          },
          "411131202": {
            "id": "411131202",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "和其他两地的患者症状一样呢。",
            "nextDialogs": [
              "411131203"
            ]
          },
          "411131203": {
            "id": "411131203",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "你好，请问他有醒来过吗？",
            "nextDialogs": [
              "411131204"
            ]
          },
          "411131204": {
            "id": "411131204",
            "speakerId": 30008,
            "speakerName": "华清",
            "text": "没有，只是偶尔说些梦话。",
            "nextDialogs": [
              "411131205"
            ]
          },
          "411131205": {
            "id": "411131205",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "什么样的梦话？",
            "nextDialogs": [
              "411131206"
            ]
          },
          "411131206": {
            "id": "411131206",
            "speakerId": 30008,
            "speakerName": "华清",
            "text": "好冷…走不动了…之类的。",
            "nextDialogs": [
              "411131207"
            ]
          },
          "411131207": {
            "id": "411131207",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "冷？之前也有人提过。",
            "nextDialogs": [
              "411131208"
            ]
          },
          "411131208": {
            "id": "411131208",
            "speakerId": 10012,
            "speakerName": "奥兹",
            "text": "寒冷的地带，山脉…会是哪里？"
          }
        }
      }
    },
    {
      "subId": "4111313",
      "subQuestName": "调查附近的病患（1/3）",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "411131301"
        ],
        "dialogs": {
          "411131301": {
            "id": "411131301",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "请问这个患者醒来了吗？",
            "nextDialogs": [
              "411131302"
            ]
          },
          "411131302": {
            "id": "411131302",
            "speakerId": 30009,
            "speakerName": "阿阳",
            "text": "还没有。",
            "nextDialogs": [
              "411131303"
            ]
          },
          "411131303": {
            "id": "411131303",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "那他说梦话了吗？",
            "nextDialogs": [
              "411131304"
            ]
          },
          "411131304": {
            "id": "411131304",
            "speakerId": 30009,
            "speakerName": "阿阳",
            "text": "这么一说…昨天他似乎喊了一句「好高啊」，也不知道是什么意思。",
            "nextDialogs": [
              "411131305"
            ]
          },
          "411131305": {
            "id": "411131305",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "好高？是说雪山的高度很高吗？",
            "nextDialogs": [
              "411131306"
            ]
          },
          "411131306": {
            "id": "411131306",
            "speakerId": 10011,
            "speakerName": "菲谢尔",
            "text": "高耸的冷冽魔山，带来奔流的黑暗之力…",
            "nextDialogs": [
              "411131307"
            ]
          },
          "411131307": {
            "id": "411131307",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "再问问那边那个人吧。"
          }
        }
      }
    },
    {
      "subId": "4111314",
      "subQuestName": "调查附近的病患（2/3）",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "411131401"
        ],
        "dialogs": {
          "411131401": {
            "id": "411131401",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "你好，请问这里有醒来的病人吗？",
            "nextDialogs": [
              "411131402"
            ]
          },
          "411131402": {
            "id": "411131402",
            "speakerId": 30010,
            "speakerName": "大黄",
            "text": "巧了，<color=#00E1FFFF>高老六</color>刚刚醒来！",
            "nextDialogs": [
              "411131403"
            ]
          },
          "411131403": {
            "id": "411131403",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "我们就找他！",
            "nextDialogs": [
              "411131404"
            ]
          },
          "411131404": {
            "id": "411131404",
            "speakerId": 30010,
            "speakerName": "大黄",
            "text": "不过他昏睡至今，身体十分虚弱。你们若要问话，还请温柔一些。",
            "nextDialogs": [
              "411131405"
            ]
          },
          "411131405": {
            "id": "411131405",
            "speakerId": 10011,
            "speakerName": "菲谢尔",
            "text": "不幸的人，你将获得皇女的问候。",
            "nextDialogs": [
              "411131406"
            ]
          },
          "411131406": {
            "id": "411131406",
            "speakerId": 30026,
            "speakerName": "高老六",
            "text": "哎…好饿啊…",
            "nextDialogs": [
              "411131407"
            ]
          },
          "411131407": {
            "id": "411131407",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "你没事吧？是不是肚子饿得厉害？",
            "nextDialogs": [
              "411131408"
            ]
          },
          "411131408": {
            "id": "411131408",
            "speakerId": 30026,
            "speakerName": "高老六",
            "text": "哎…哎…",
            "nextDialogs": [
              "411131411"
            ]
          },
          "411131411": {
            "id": "411131411",
            "speakerId": 30026,
            "speakerName": "高老六",
            "text": "想吃…家…家乡…菜…",
            "nextDialogs": [
              "411131412"
            ]
          },
          "411131412": {
            "id": "411131412",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "轻策庄的家乡菜，一定就是<color=#00E1FFFF>轻策农家菜</color>啦！"
          }
        }
      }
    },
    {
      "subId": "4111320",
      "subQuestName": "做一份轻策农家菜",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "411132001"
        ],
        "dialogs": {
          "411132001": {
            "id": "411132001",
            "speakerId": 2138,
            "speakerName": "小白",
            "text": "试试轻策农家菜吧，美味又实惠哦！"
          }
        }
      }
    },
    {
      "subId": "4111311",
      "subQuestName": "为高老六送上轻策农家菜",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "411131101"
        ],
        "dialogs": {
          "411131101": {
            "id": "411131101",
            "speakerId": 30026,
            "speakerName": "高老六",
            "text": "呜啊…活过来了！",
            "nextDialogs": [
              "411131102"
            ]
          },
          "411131102": {
            "id": "411131102",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "请问，你昏睡期间做梦了吗？",
            "nextDialogs": [
              "411131103"
            ]
          },
          "411131103": {
            "id": "411131103",
            "speakerId": 30026,
            "speakerName": "高老六",
            "text": "做了做了！可把我累得！",
            "nextDialogs": [
              "411131104"
            ]
          },
          "411131104": {
            "id": "411131104",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "什么梦能把人累成这样？",
            "nextDialogs": [
              "411131106",
              "411131108"
            ]
          },
          "411131106": {
            "id": "411131106",
            "speakerId": 30026,
            "speakerName": "高老六",
            "text": "你怎么知道？那是座很高、很冷的雪山…我从没见过那么高的山峰。",
            "nextDialogs": [
              "411131109"
            ]
          },
          "411131109": {
            "id": "411131109",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "你去雪山干什么？",
            "nextDialogs": [
              "411131110"
            ]
          },
          "411131110": {
            "id": "411131110",
            "speakerId": 30026,
            "speakerName": "高老六",
            "text": "我也不清楚，就跟中邪一样，梦里只想着要爬山，要到最高峰去。",
            "nextDialogs": [
              "411131111"
            ]
          },
          "411131111": {
            "id": "411131111",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "山峰上有什么好东西吗？",
            "nextDialogs": [
              "411131112"
            ]
          },
          "411131112": {
            "id": "411131112",
            "speakerId": 30026,
            "speakerName": "高老六",
            "text": "谁知道呢？我一睡着就跟变了个人一样，你问原因，我也说不上来…",
            "nextDialogs": [
              "411131113"
            ]
          },
          "411131113": {
            "id": "411131113",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "不是你自己想爬吗？",
            "nextDialogs": [
              "411131114"
            ]
          },
          "411131114": {
            "id": "411131114",
            "speakerId": 30026,
            "speakerName": "高老六",
            "text": "怎么说呢…像是有人控制了我，让我产生这种爬山的念头，别提有多奇怪了。",
            "nextDialogs": [
              "411131115"
            ]
          },
          "411131115": {
            "id": "411131115",
            "speakerId": 10011,
            "speakerName": "菲谢尔",
            "text": "难道说，是黑暗心流？？？",
            "nextDialogs": [
              "411131116"
            ]
          },
          "411131116": {
            "id": "411131116",
            "speakerId": 10012,
            "speakerName": "奥兹",
            "text": "不是自发，而是下意识产生这种愿望。的确很像精神控制呢。"
          },
          "411131108": {
            "id": "411131108",
            "speakerId": 30026,
            "speakerName": "高老六",
            "text": "不是雪原，是雪山。非常高，而且很冷…我一睡着，就梦见自己站在山脚下。"
          }
        }
      }
    },
    {
      "subId": "4111315",
      "subQuestName": "(test)交付完成后的对话$HIDDEN",
      "sceneId": null,
      "locations": [],

  "subQuests": [
    {
      "subId": "7665602",
      "subQuestName": "与茜涅特对话",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "766562001"
        ],
        "dialogs": {
          "766562001": {
            "id": "766562001",
            "speakerId": 1000,
            "speakerName": "茜涅特",
            "text": "#你们好，{NICKNAME}和派蒙。多亏了你们的帮助，上次找回来的机器人已经调试好了。",
            "nextDialogs": [
              "766562002"
            ]
          },
          "766562002": {
            "id": "766562002",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "哦哦，它们都在这里呢。",
            "nextDialogs": [
              "766562003"
            ]
          },
          "766562003": {
            "id": "766562003",
            "speakerId": 1000,
            "speakerName": "茜涅特",
            "text": "目前没有出现新的故障，但我忽然有了一个新的想法…",
            "nextDialogs": [
              "766562004"
            ]
          },
          "766562004": {
            "id": "766562004",
            "speakerId": 1000,
            "speakerName": "茜涅特",
            "text": "#{NICKNAME}，你们去找回其他的机器人时，能不能帮我留意下它们的一些特殊表现？",
            "nextDialogs": [
              "766562005"
            ]
          },
          "766562005": {
            "id": "766562005",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "具体是指什么样的表现呢？",
            "nextDialogs": [
              "766562006"
            ]
          },
          "766562006": {
            "id": "766562006",
            "speakerId": 1000,
            "speakerName": "茜涅特",
            "text": "大概就是…彼此之间的交互？等找回的机器人足够多了之后，或许就会更明显一些。",
            "nextDialogs": [
              "766562007"
            ]
          },
          "766562007": {
            "id": "766562007",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "哦…交给我们吧！",
            "nextDialogs": [
              "766562008"
            ]
          },
          "766562008": {
            "id": "766562008",
            "speakerId": 1000,
            "speakerName": "茜涅特",
            "text": "真是辛苦了，非常感谢！我这就把下一片区域标在地图上。"
          }
        }
      }
    },

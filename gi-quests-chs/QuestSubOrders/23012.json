    {
      "subId": "2301201",
      "subQuestName": "与莎莉对话",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "230121101"
        ],
        "dialogs": {
          "230121101": {
            "id": "230121101",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "我之前和猫也正经交流过…",
            "nextDialogs": [
              "230121102"
            ]
          },
          "230121102": {
            "id": "230121102",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "你是说「寝子」吗？不过寝子可是能说人话的猫啊，应该也不算「猫语」吧。",
            "nextDialogs": [
              "230121103"
            ]
          },
          "230121103": {
            "id": "230121103",
            "speakerId": 4136,
            "speakerName": "莎莉",
            "text": "没错，但作为交换，你得去帮我把一只小猫带回来。",
            "nextDialogs": [
              "230121108",
              "230121106"
            ]
          },
          "230121108": {
            "id": "230121108",
            "speakerId": 4136,
            "speakerName": "莎莉",
            "text": "那么，你们是答应我了？那就太感谢你们了。",
            "nextDialogs": [
              "230121109"
            ]
          },
          "230121109": {
            "id": "230121109",
            "speakerId": 4136,
            "speakerName": "莎莉",
            "text": "咳，咳咳…那就请你们听好了，这是我总结了很长时间才总结出的「猫的定型语」。"
          },
          "230121106": {
            "id": "230121106",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "哈哈，哈…没错呢，这么一想，我们在好多城市里都帮人找过猫…",
            "nextDialogs": [
              "230121107"
            ]
          },
          "230121107": {
            "id": "230121107",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "是该说每个人都喜欢小猫呢，还是该说…每个养猫的人都会遇见一样的烦恼呢…"
          }
        }
      }
    },
    {
      "subId": "2301209",
      "subQuestName": "向莎莉确认小猫的信息",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "230121901"
        ],
        "dialogs": {
          "230121901": {
            "id": "230121901",
            "speakerId": 4136,
            "speakerName": "莎莉",
            "text": "那么就拜托你了，旅行者。我就在这里等着你回来。",
            "nextDialogs": [
              "230121902"
            ]
          },
          "230121902": {
            "id": "230121902",
            "speakerId": 4136,
            "speakerName": "莎莉",
            "text": "希望你能顺利和小猫说上话。"
          }
        }
      }
    },
    {
      "subId": "2301206",
      "subQuestName": "",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "230121501"
        ],
        "dialogs": {
          "230121501": {
            "id": "230121501",
            "speakerId": 4136,
            "speakerName": "莎莉",
            "text": "今天跑出去玩的贪玩小猫是一只「黑白色」的猫，它的名字是「拉勒」。",
            "nextDialogs": [
              "230121502"
            ]
          },
          "230121502": {
            "id": "230121502",
            "speakerId": 4136,
            "speakerName": "莎莉",
            "text": "用「猫语」呼唤它的话，应该是…喵，喵喵喵，喵——",
            "nextDialogs": [
              "230121503"
            ]
          },
          "230121503": {
            "id": "230121503",
            "speakerId": 4136,
            "speakerName": "莎莉",
            "text": "记得音调要先下后上，最后一声喵要高高扬起。",
            "nextDialogs": [
              "230121504"
            ]
          },
          "230121504": {
            "id": "230121504",
            "speakerId": 4136,
            "speakerName": "莎莉",
            "text": "唔…我给你写一张便签好了，请你稍等一下。"
          }
        }
      }
    },
    {
      "subId": "2301207",
      "subQuestName": "",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "230121601"
        ],
        "dialogs": {
          "230121601": {
            "id": "230121601",
            "speakerId": 4136,
            "speakerName": "莎莉",
            "text": "今天跑出去找零食吃的贪吃小猫是一只「深灰色」的猫，它的名字是「纳尔吉斯」。",
            "nextDialogs": [
              "230121602"
            ]
          },
          "230121602": {
            "id": "230121602",
            "speakerId": 4136,
            "speakerName": "莎莉",
            "text": "用「猫语」呼唤它的话，应该是…喵！喵喵，喵。",
            "nextDialogs": [
              "230121603"
            ]
          },
          "230121603": {
            "id": "230121603",
            "speakerId": 4136,
            "speakerName": "莎莉",
            "text": "记得第一声喵要发重音，后面的喵要快速发音。",
            "nextDialogs": [
              "230121604"
            ]
          },
          "230121604": {
            "id": "230121604",
            "speakerId": 4136,
            "speakerName": "莎莉",
            "text": "唔…我给你写一张便签好了，请你稍等一下。"
          }
        }
      }
    },
    {
      "subId": "2301208",

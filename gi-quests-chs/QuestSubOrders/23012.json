            "nextDialogs": [
              "230122113"
            ]
          },
          "230122113": {
            "id": "230122113",
            "speakerId": 1003,
            "speakerName": "Black Screen",
            "text": "拉勒掉过头，飞快地窜了出去…",
            "nextDialogs": [
              "230122114"
            ]
          },
          "230122114": {
            "id": "230122114",
            "speakerId": 1005,

    {
      "subId": "2301205",
      "subQuestName": "向莎莉回报",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "230120301"
        ],
        "dialogs": {
          "230120301": {
            "id": "230120301",
            "speakerId": 4136,
            "speakerName": "莎莉",
            "text": "你们已经把小猫带回来了啊，真是辛苦你们了。",
            "nextDialogs": [
              "230120302"
            ]
          },
          "230120302": {
            "id": "230120302",
            "speakerId": 4136,
            "speakerName": "莎莉",
            "text": "看样子，你们的「猫语」学得也不错嘛。",
            "nextDialogs": [
              "230120303"
            ]
          },
          "230120303": {
            "id": "230120303",
            "speakerId": 4136,
            "speakerName": "莎莉",
            "text": "这些报酬给你，请收下吧。",
            "nextDialogs": [
              "230120304"
            ]
          },
          "230120304": {
            "id": "230120304",
            "speakerId": 4136,
            "speakerName": "莎莉",
            "text": "能这么快学会「猫语」的人可真难得，说不定我下次还要麻烦你帮忙呢。",
            "nextDialogs": [
              "230120305"
            ]
          },
          "230120305": {
            "id": "230120305",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "喵！",
            "nextDialogs": [
              "230120306"
            ]
          },
          "230120306": {
            "id": "230120306",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "可以说人话啦！莎莉小姐又不是猫！",
            "nextDialogs": [
              "230120307"
            ]
          },
          "230120307": {
            "id": "230120307",
            "speakerId": 4136,
            "speakerName": "莎莉",
            "text": "我可以从你的表情里看出来，你想说的话是「没问题」，不过…这次你的发音可不对喔。",
            "nextDialogs": [
              "230120308"
            ]
          },
          "230120308": {
            "id": "230120308",
            "speakerId": 4136,
            "speakerName": "莎莉",
            "text": "不过没关系，我以后会继续教你「猫语」的，就让我们一起来学习吧！"
          }
        }
      }
    },

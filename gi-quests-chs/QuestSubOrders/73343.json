  "subQuests": [
    {
      "subId": "7334301",
      "subQuestName": "(test)首次看到花$HIDDEN",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "733430101"
        ],
        "dialogs": {
          "733430101": {
            "id": "733430101",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "哇，斯露莎还挺厉害的嘛，一下子就让周围焕发了生机！",
            "nextDialogs": [
              "733430102"
            ]
          },
          "733430102": {
            "id": "733430102",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "花灵的力量真奇妙。",
            "nextDialogs": [
              "733430103"
            ]
          },
          "733430103": {
            "id": "733430103",
            "speakerId": 1001,
            "speakerName": "斯露莎",
            "text": "大惊小怪！以吾之威能，拯救「净觉花」不过是举手之劳！",
            "nextDialogs": [
              "733430104"
            ]
          },
          "733430104": {
            "id": "733430104",
            "speakerId": 1001,
            "speakerName": "斯露莎",
            "text": "黯色的侵蚀还在扩张，这片「净觉花」只不过是诸多受害者之一…",
            "nextDialogs": [
              "733430105"
            ]
          },
          "733430105": {
            "id": "733430105",
            "speakerId": 1001,
            "speakerName": "斯露莎",
            "text": "其他花池也没法幸免于难，瑟法娜想必正手忙脚乱，惊慌失措吧。",
            "nextDialogs": [
              "733430106"
            ]
          },
          "733430106": {
            "id": "733430106",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "听起来，你说的瑟法娜，应该是个勤勤恳恳照顾花儿们的好花灵？",
            "nextDialogs": [
              "733430107"
            ]
          },
          "733430107": {
            "id": "733430107",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "#我们就帮帮那位花灵吧，{NICKNAME}？",
            "nextDialogs": [
              "733430108"
            ]
          },
          "733430108": {
            "id": "733430108",
            "speakerId": 1001,
            "speakerName": "斯露莎",
            "text": "这点功绩，作为伟业正道旁的小小装点倒也无妨。吾之「谒颂主」，你就多多留意这样的「净觉花」吧。",
            "nextDialogs": [
              "733430109"
            ]
          },
          "733430109": {
            "id": "733430109",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "下次看到了就通知你。",
            "nextDialogs": [
              "733430110"
            ]
          },
          "733430110": {
            "id": "733430110",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "嗯，我们一起拯救这些漂亮的花！"
          }
        }
      }
    },

  "subQuests": [
    {
      "subId": "7051501",
      "subQuestName": "与菲利斯·尤格对话",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "705150101"
        ],
        "dialogs": {
          "705150101": {
            "id": "705150101",
            "speakerId": 30217,
            "speakerName": "菲利斯·尤格",
            "text": "太棒了！整整六幅「恒动械画」部件！接下来，我们只需要再把他们全都拼起来…",
            "nextDialogs": [
              "705150102"
            ]
          },
          "705150102": {
            "id": "705150102",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "全、全都拼起来？",
            "nextDialogs": [
              "705150103"
            ]
          },
          "705150103": {
            "id": "705150103",
            "speakerId": 30217,
            "speakerName": "菲利斯·尤格",
            "text": "那是当然，这六幅小型的「恒动械画」部件可以再次组装！",
            "nextDialogs": [
              "705150104"
            ]
          },
          "705150104": {
            "id": "705150104",
            "speakerId": 30217,
            "speakerName": "菲利斯·尤格",
            "text": "拼接成一幅…庞大的！绝美的…大型「恒动械画」。",
            "nextDialogs": [
              "705150105"
            ]
          },
          "705150105": {
            "id": "705150105",
            "speakerId": 30217,
            "speakerName": "菲利斯·尤格",
            "text": "来吧，接下来我们只需要把它们都拼接起来就行了。",
            "nextDialogs": [
              "705150108"
            ]
          },
          "705150108": {
            "id": "705150108",
            "speakerId": 30217,
            "speakerName": "菲利斯·尤格",
            "text": "不，不不不不，绝对不，我的机器不是那种被笨拙地强捏在一起的金属垃圾。",
            "nextDialogs": [
              "705150109"
            ]
          },
          "705150109": {
            "id": "705150109",
            "speakerId": 30217,
            "speakerName": "菲利斯·尤格",
            "text": "每一个零件，都简洁又巧妙地拼接在一起，就像是…呃…就像是…",
            "nextDialogs": [
              "705150110"
            ]
          },
          "705150110": {
            "id": "705150110",
            "speakerId": 30217,
            "speakerName": "菲利斯·尤格",
            "text": "算了，打比方的事我从来不在行，我在修辞学方面的灵感全让泽维尔给偷走了。",
            "nextDialogs": [
              "705150111"
            ]
          },
          "705150111": {
            "id": "705150111",
            "speakerId": 30217,
            "speakerName": "菲利斯·尤格",
            "text": "总之，请您来亲手试试吧，相信我，这会很有趣的。"
          }
        }
      }
    },
    {
      "subId": "7051502",
      "subQuestName": "拼接「恒动械画」",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "705150201"
        ],
        "dialogs": {
          "705150201": {
            "id": "705150201",
            "speakerId": 30217,
            "speakerName": "菲利斯·尤格",
            "text": "完美，太美丽了！您的理解力和动手能力真不错，真是超乎我的预料。",
            "nextDialogs": [
              "705150202"
            ]
          },
          "705150202": {
            "id": "705150202",
            "speakerId": 30217,
            "speakerName": "菲利斯·尤格",
            "text": "哈，《蒸汽鸟日报》还有几篇荒谬的稿件把您形容地就像是一个…一个…",
            "nextDialogs": [
              "705150205"
            ]
          },
          "705150205": {
            "id": "705150205",
            "speakerId": 30217,
            "speakerName": "菲利斯·尤格",
            "text": "呵…呵呵…一个…乐于用剑来说服人的…直爽勇者…",
            "nextDialogs": [
              "705150206"
            ]
          },
          "705150206": {
            "id": "705150206",
            "speakerId": 30217,
            "speakerName": "菲利斯·尤格",
            "text": "荒谬，愚蠢！写这几篇稿件的记者简直是无事生非！您明明是一位敏锐、聪慧、谦逊…又直爽的勇者！",
            "nextDialogs": [
              "705150207"
            ]
          },
          "705150207": {
            "id": "705150207",
            "speakerId": 30217,
            "speakerName": "菲利斯·尤格",
            "text": "等我有空了，我一定要写封信去狠狠驳斥他们！",
            "nextDialogs": [
              "705150208"
            ]
          },
          "705150208": {
            "id": "705150208",
            "speakerId": 30217,
            "speakerName": "菲利斯·尤格",
            "text": "对了，这份机关就请您收下吧，无聊的时候，您可以用它来解闷。",
            "nextDialogs": [
              "705150209"
            ]
          },
          "705150209": {
            "id": "705150209",
            "speakerId": 30217,
            "speakerName": "菲利斯·尤格",
            "text": "而我嘛…嗯…我得开始筹措去璃月的路费了…"
          }
        }
      }
    },

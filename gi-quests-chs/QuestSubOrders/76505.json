  "subQuests": [
    {
      "subId": "7650501",
      "subQuestName": "(test)隐藏$HIDDEN",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "765050101"
        ],
        "dialogs": {
          "765050101": {
            "id": "765050101",
            "speakerId": 1000,
            "speakerName": "瓦雷莎",
            "text": "#{NICKNAME}和派蒙？真是巧呀！我之前听说你们出发去挪德卡莱了，没想到这么快就能在这里碰上！",
            "nextDialogs": [
              "765050102"
            ]
          },
          "765050102": {
            "id": "765050102",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "对啊对啊，我还以为我看错了呢！瓦雷莎，你怎么也跑到这么远的地方来啦？难道也是来旅行的吗？",
            "nextDialogs": [
              "765050103"
            ]
          },
          "765050103": {
            "id": "765050103",
            "speakerId": 1000,
            "speakerName": "瓦雷莎",
            "text": "嘿嘿，差不多吧！我这次是来帮家里的果园采购一批农用机械的。",
            "nextDialogs": [
              "765050104"
            ]
          },
          "765050104": {
            "id": "765050104",
            "speakerId": 1000,
            "speakerName": "瓦雷莎",
            "text": "爸爸说挪德卡莱这边有些好东西，能让果子长得更好，也能让我省点力气，这样我就有更多的时间睡觉…和健身了。",
            "nextDialogs": [
              "765050105"
            ]
          },
          "765050105": {
            "id": "765050105",
            "speakerId": 1000,
            "speakerName": "瓦雷莎",
            "text": "来了之后发现，这里有好多纳塔没有的好吃的！这几天除了办正事以外，我几乎所有时间都花在吃吃喝喝上面了！",
            "nextDialogs": [
              "765050106"
            ]
          },
          "765050106": {
            "id": "765050106",
            "speakerId": 1000,
            "speakerName": "瓦雷莎",
            "text": "不知不觉，马上就要到回程的时间，都有点不舍得了。",
            "nextDialogs": [
              "765050107"
            ]
          },
          "765050107": {
            "id": "765050107",
            "speakerId": 1000,
            "speakerName": "瓦雷莎",
            "text": "所以呀，我要抓紧最后的机会，再好好逛逛，把没吃过的都尝一遍，没看过的都看个够！",
            "nextDialogs": [
              "765050108"
            ]
          },
          "765050108": {
            "id": "765050108",
            "speakerId": 1000,
            "speakerName": "瓦雷莎",
            "text": "#你们呢？让我猜猜…我们无敌的大英雄{NICKNAME}，是不是又在这片新的土地上，忙着维护正义呀？",
            "nextDialogs": [
              "765050111"
            ]
          },
          "765050111": {
            "id": "765050111",
            "speakerId": 1000,
            "speakerName": "瓦雷莎",
            "text": "嘿嘿，我懂我懂！到了新的国家，看什么都新鲜得不得了，简直想把每个有趣的角落，都用留影机「咔擦」一下保存下来！",
            "nextDialogs": [
              "765050112"
            ]
          },
          "765050112": {
            "id": "765050112",
            "speakerId": 1000,
            "speakerName": "瓦雷莎",
            "text": "这么说来…哎呀！我应该也把在这里吃过的所有美食都仔仔细细地拍下来才对。",
            "nextDialogs": [
              "765050113"
            ]
          },
          "765050113": {
            "id": "765050113",
            "speakerId": 1000,
            "speakerName": "瓦雷莎",
            "text": "这样的话，等我回纳塔，说不定能让阿托力大叔照着画片，尝试把这些美味都给还原出来！",
            "nextDialogs": [
              "765050114"
            ]
          },
          "765050114": {
            "id": "765050114",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "瓦雷莎说不定能当美食摄影师呢。",
            "nextDialogs": [
              "765050115"
            ]
          },
          "765050115": {
            "id": "765050115",
            "speakerId": 1000,
            "speakerName": "瓦雷莎",
            "text": "嘿嘿，真的吗？美食摄影师啊…听起来就很棒！每天都能和好吃的打交道，还能把它们拍得让人看了就流口水！"
          }
        }
      }
    },

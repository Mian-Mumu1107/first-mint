  "subQuests": [
    {
      "subId": "1020201",
      "subQuestName": "回到西风骑士团向琴汇报",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "102020101"
        ],
        "dialogs": {
          "102020101": {
            "id": "102020101",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "啊，可莉也在这里！",
            "nextDialogs": [
              "102020102"
            ]
          },
          "102020102": {
            "id": "102020102",
            "speakerId": 10090,
            "speakerName": "可莉",
            "text": "我…呜呜呜，我自首。",
            "nextDialogs": [
              "102020103"
            ]
          },
          "102020103": {
            "id": "102020103",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "欸？！",
            "nextDialogs": [
              "102020104"
            ]
          },
          "102020104": {
            "id": "102020104",
            "speakerId": 10090,
            "speakerName": "可莉",
            "text": "我…我的炸弹…炸弹炸伤了人。",
            "nextDialogs": [
              "102020105"
            ]
          },
          "102020105": {
            "id": "102020105",
            "speakerId": 10090,
            "speakerName": "可莉",
            "text": "呜呜…违反了生存守则，我肯定看不到明天的太阳了…",
            "nextDialogs": [
              "102020106"
            ]
          },
          "102020106": {
            "id": "102020106",
            "speakerId": 1006,
            "speakerName": "琴",
            "text": "可莉，你先回答我。伤员呢，伤员人在哪里？",
            "nextDialogs": [
              "102020107"
            ]
          },
          "102020107": {
            "id": "102020107",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "等等，这里有误会。",
            "nextDialogs": [
              "102020108"
            ]
          },
          "102020108": {
            "id": "102020108",
            "speakerId": 1006,
            "speakerName": "琴",
            "text": "嗯？",
            "nextDialogs": [
              "102020109"
            ]
          },
          "102020109": {
            "id": "102020109",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "可莉炸飞的，是深渊法师。",
            "nextDialogs": [
              "102020110"
            ]
          },
          "102020110": {
            "id": "102020110",
            "speakerId": 10090,
            "speakerName": "可莉",
            "text": "但…但是毛茸茸只是偷了东西而已，我的炸弹却把他给…",
            "nextDialogs": [
              "102020111"
            ]
          },
          "102020111": {
            "id": "102020111",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "啊…我之前说深渊法师是「坏人」，只是一种比喻啦…",
            "nextDialogs": [
              "102020112"
            ]
          },
          "102020112": {
            "id": "102020112",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "深渊法师不是人类。它们是…唔，与人类为敌的坏家伙。",
            "nextDialogs": [
              "102020113"
            ]
          },
          "102020113": {
            "id": "102020113",
            "speakerId": 10090,
            "speakerName": "可莉",
            "text": "毛茸茸…与人类为敌？是坏家伙？",
            "nextDialogs": [
              "102020114"
            ]
          },
          "102020114": {
            "id": "102020114",
            "speakerId": 10090,
            "speakerName": "可莉",
            "text": "欸，欸？！脑…脑袋跟不上了…",
            "nextDialogs": [
              "102020115"
            ]
          },
          "102020115": {
            "id": "102020115",
            "speakerId": 1006,
            "speakerName": "琴",
            "text": "嗯，这是我的疏忽。",
            "nextDialogs": [
              "102020116"
            ]
          },
          "102020116": {
            "id": "102020116",
            "speakerId": 1006,
            "speakerName": "琴",
            "text": "因为你还太小，我之前从没有把这些告诉过你。",
            "nextDialogs": [
              "102020117"
            ]
          },
          "102020117": {
            "id": "102020117",
            "speakerId": 1006,
            "speakerName": "琴",
            "text": "实际上，深渊教团的怪物们，是侵扰着蒙德的威胁，最近格外活跃。",
            "nextDialogs": [
              "102020118"
            ]
          },
          "102020118": {
            "id": "102020118",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "难道是因为「最强的宝物」？",
            "nextDialogs": [
              "102020119"
            ]
          },
          "102020119": {
            "id": "102020119",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "对哦，我明白了！",
            "nextDialogs": [
              "102020120"
            ]
          },
          "102020120": {
            "id": "102020120",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "它们就是听到了宝物的流言，才盯上可莉的呀！",
            "nextDialogs": [
              "102020121"
            ]
          },
          "102020121": {
            "id": "102020121",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "就像，就像我最初也会想得到…啊不，想知道这宝贝一样！",
            "nextDialogs": [
              "102020122"
            ]
          },
          "102020122": {
            "id": "102020122",
            "speakerId": 10090,
            "speakerName": "可莉",
            "text": "所以…所以说！",
            "nextDialogs": [
              "102020123"
            ]
          },
          "102020123": {
            "id": "102020123",
            "speakerId": 1006,
            "speakerName": "琴",
            "text": "看在你这次的功劳上，下次的羽球节，就允许你一起参加吧。",
            "nextDialogs": [
              "102020124"
            ]
          },
          "102020124": {
            "id": "102020124",
            "speakerId": 10090,
            "speakerName": "可莉",
            "text": "羽球节！！哇！！",
            "nextDialogs": [
              "102020127"
            ]
          },
          "102020127": {
            "id": "102020127",
            "speakerId": 10090,
            "speakerName": "可莉",
            "text": "#{PLAYERAVATAR#SEXPRO[INFO_MALE_PRONOUN_BROTHER|INFO_FEMALE_PRONOUN_SISTERA]}到时候也一定要来哦！",
            "nextDialogs": [
              "102020128"
            ]
          },
          "102020128": {
            "id": "102020128",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "欸嘿，圆满的结局！",
            "nextDialogs": [
              "102020129"
            ]
          },
          "102020129": {
            "id": "102020129",
            "speakerId": 1006,
            "speakerName": "琴",
            "text": "不过…",
            "nextDialogs": [
              "102020131"
            ]
          },
          "102020131": {
            "id": "102020131",
            "speakerId": 1006,
            "speakerName": "琴",
            "text": "可莉，你原先的「宝物」，藏在了哪里？",
            "nextDialogs": [
              "102020132"
            ]
          },
          "102020132": {
            "id": "102020132",
            "speakerId": 10090,
            "speakerName": "可莉",
            "text": "唔唔！",
            "nextDialogs": [
              "102020133"
            ]
          },
          "102020133": {
            "id": "102020133",
            "speakerId": 1006,
            "speakerName": "琴",
            "text": "是不是又想去炸星落湖的鱼了？",
            "nextDialogs": [
              "102020134"
            ]
          },
          "102020134": {
            "id": "102020134",
            "speakerId": 10090,
            "speakerName": "可莉",
            "text": "我，我不是！",
            "nextDialogs": [
              "102020135"
            ]
          },
          "102020135": {
            "id": "102020135",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "（她在拼命给我们使眼色呢…）",
            "nextDialogs": [
              "102020136"
            ]
          },
          "102020136": {
            "id": "102020136",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "（可是琴团长也看得见啊…）",
            "nextDialogs": [
              "102020137"
            ]
          },
          "102020137": {
            "id": "102020137",
            "speakerId": 1006,
            "speakerName": "琴",
            "text": "可——莉——？",
            "nextDialogs": [
              "102020138"
            ]
          },
          "102020138": {
            "id": "102020138",
            "speakerId": 10090,
            "speakerName": "可莉",
            "text": "呀！可莉这就去<color=#00E1FFFF>禁闭室</color>报到…呜呜…",
            "nextDialogs": [
              "102020139"
            ]
          },
          "102020139": {
            "id": "102020139",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "不知道可莉一个人关禁闭，会不会无聊…"
          }
        }
      }
    },

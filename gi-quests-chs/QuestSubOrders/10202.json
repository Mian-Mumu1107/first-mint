    {
      "subId": "1020204",
      "subQuestName": "寻找骑士团禁闭室的门",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "102020401"
        ],
        "dialogs": {
          "102020401": {
            "id": "102020401",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "猜猜我是谁？",
            "nextDialogs": [
              "102020402"
            ]
          },
          "102020402": {
            "id": "102020402",
            "speakerId": 10205,
            "speakerName": "？？？",
            "text": "啊，是小派蒙的声音！",
            "nextDialogs": [
              "102020405"
            ]
          },
          "102020405": {
            "id": "102020405",
            "speakerId": 10090,
            "speakerName": "可莉",
            "text": "好呀那就——不，不对，可莉是真心在反省的，不要诱惑我！",
            "nextDialogs": [
              "102020406"
            ]
          },
          "102020406": {
            "id": "102020406",
            "speakerId": 10090,
            "speakerName": "可莉",
            "text": "禁闭期间，我会留在这里，做羽球节特制版的「宝物」…",
            "nextDialogs": [
              "102020407"
            ]
          },
          "102020407": {
            "id": "102020407",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "「宝物」…",
            "nextDialogs": [
              "102020408"
            ]
          },
          "102020408": {
            "id": "102020408",
            "speakerId": 10090,
            "speakerName": "可莉",
            "text": "嘿嘿…我专门做成了羽球的形状呢！很可爱的。"
          }
        }
      }
    }
  ]
}
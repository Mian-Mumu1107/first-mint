    {
      "subId": "7182302",
      "subQuestName": "与阿芷交谈",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "718230201"
        ],
        "dialogs": {
          "718230201": {
            "id": "718230201",
            "speakerId": 2139,
            "speakerName": "阿芷",
            "text": "唔，药材还是有点不够了呢…",
            "nextDialogs": [
              "718230202"
            ]
          },
          "718230202": {
            "id": "718230202",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "你要去采药吗？",
            "nextDialogs": [
              "718230203"
            ]
          },
          "718230203": {
            "id": "718230203",
            "speakerId": 2139,
            "speakerName": "阿芷",
            "text": "嗯，我正准备再去采点药呢。每年的这几天，我都会特意多准备一些药。",
            "nextDialogs": [
              "718230204"
            ]
          },
          "718230204": {
            "id": "718230204",
            "speakerId": 2139,
            "speakerName": "阿芷",
            "text": "也不是什么很厉害的药…只是一些治疗伤寒，或者帮助消化的药。",
            "nextDialogs": [
              "718230205"
            ]
          },
          "718230205": {
            "id": "718230205",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "为什么不直接去不卜庐抓药？",
            "nextDialogs": [
              "718230206"
            ]
          },
          "718230206": {
            "id": "718230206",
            "speakerId": 2139,
            "speakerName": "阿芷",
            "text": "因为不卜庐离这里很远啊，从这里去璃月港可要走很长时间。",
            "nextDialogs": [
              "718230207"
            ]
          },
          "718230207": {
            "id": "718230207",
            "speakerId": 2139,
            "speakerName": "阿芷",
            "text": "而且轻策庄里也都是老人小孩居多，可不比你这样的冒险家，他们可走不动那么远的路。",
            "nextDialogs": [
              "718230208"
            ]
          },
          "718230208": {
            "id": "718230208",
            "speakerId": 2139,
            "speakerName": "阿芷",
            "text": "所以，我才会提前预备着这些药来治疗一些小毛病。",
            "nextDialogs": [
              "718230209"
            ]
          },
          "718230209": {
            "id": "718230209",
            "speakerId": 2139,
            "speakerName": "阿芷",
            "text": "不过，如果真是那种很严重的病，需要正经的药方，那也只能去不卜庐了…唉，希望不会发生这种事…",
            "nextDialogs": [
              "718230210"
            ]
          },
          "718230210": {
            "id": "718230210",
            "speakerId": 2139,
            "speakerName": "阿芷",
            "text": "先不和你们聊了，我还要去采药呢，等会采完了还得拿回去处理一下才行…",
            "nextDialogs": [
              "718230211"
            ]
          },
          "718230211": {
            "id": "718230211",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "我来帮忙吧。",
            "nextDialogs": [
              "718230212"
            ]
          },
          "718230212": {
            "id": "718230212",
            "speakerId": 2139,
            "speakerName": "阿芷",
            "text": "咦？你愿意帮忙吗？那太好了，我正发愁一个人要采到什么时候呢…",
            "nextDialogs": [
              "718230213"
            ]
          },
          "718230213": {
            "id": "718230213",
            "speakerId": 2139,
            "speakerName": "阿芷",
            "text": "我看看啊…我还需要三味药材…",
            "nextDialogs": [
              "718230214"
            ]
          },
          "718230214": {
            "id": "718230214",
            "speakerId": 2139,
            "speakerName": "阿芷",
            "text": "嗯…一味是生长在山顶上的清心，用来养气消食最好。",
            "nextDialogs": [
              "718230215"
            ]
          },
          "718230215": {
            "id": "718230215",
            "speakerId": 2139,
            "speakerName": "阿芷",
            "text": "另外一味是生长在河滩上的新鲜嘟嘟莲，入药后可以祛湿散淤。",
            "nextDialogs": [
              "718230216"
            ]
          },
          "718230216": {
            "id": "718230216",
            "speakerId": 2139,
            "speakerName": "阿芷",
            "text": "在那边河滩上生长的嘟嘟莲质量最好，我一般只在那里采需要入药的嘟嘟莲，其他地方生长的嘟嘟莲，药效会差很多…",
            "nextDialogs": [
              "718230217"
            ]
          },
          "718230217": {
            "id": "718230217",
            "speakerId": 2139,
            "speakerName": "阿芷",
            "text": "最后一味是旁边水塘里的莲蓬，入药后可以用来强心安神，不过采摘的时间有些讲究，要在午夜时分至清晨六点之间采摘为好。"
          }
        }
      }
    },
    {
      "subId": "7182303",
      "subQuestName": "前往山顶，采摘清心",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "718230301"
        ],
        "dialogs": {
          "718230301": {
            "id": "718230301",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "终于采到了…真是性格独特的花呢…"
          }
        }
      }
    },
    {
      "subId": "7182304",
      "subQuestName": "前往河滩边采集新鲜的嘟嘟莲",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "718230401"
        ],
        "dialogs": {
          "718230401": {
            "id": "718230401",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "呜哇，好多史莱姆…等等，嘟嘟莲呢？怎么一株嘟嘟莲都没看见…"
          }
        }
      }
    },
    {
      "subId": "7182305",
      "subQuestName": "打倒史莱姆",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "718230501"
        ],
        "dialogs": {
          "718230501": {
            "id": "718230501",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "总算是…拿到嘟嘟莲了呢…"
          }
        }
      }
    },
    {
      "subId": "7182306",
      "subQuestName": "在午夜时分（0点至6点），前往采摘莲蓬",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "718230801"
        ],
        "dialogs": {
          "718230801": {
            "id": "718230801",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "这样就可以了，我们把莲蓬带回去吧。"
          }
        }
      }
    },
    {
      "subId": "7182307",
      "subQuestName": "(test)不合适的时间$HIDDEN",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "718230701"
        ],
        "dialogs": {
          "718230701": {
            "id": "718230701",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "等一下，现在采莲蓬的时间好像不太对呢。",
            "nextDialogs": [
              "718230702"
            ]
          },
          "718230702": {
            "id": "718230702",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "我想想…阿芷小姐让我们午夜时分至清晨六点采莲蓬来着，现在的时间不太对呢。"
          }
        }
      }
    },
    {
      "subId": "7182308",
      "subQuestName": "(test)合适的时间$HIDDEN",
      "sceneId": null,
      "locations": [],

        "dialogs": {}
      }
    },
    {
      "subId": "7182309",
      "subQuestName": "向阿芷回报",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "718230901"
        ],
        "dialogs": {
          "718230901": {
            "id": "718230901",
            "speakerId": 2139,
            "speakerName": "阿芷",
            "text": "你回来啦，药材都采到了吗？",
            "nextDialogs": [
              "718230902"
            ]
          },
          "718230902": {
            "id": "718230902",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "都采到了。",
            "nextDialogs": [
              "718230903"
            ]
          },
          "718230903": {
            "id": "718230903",
            "speakerId": 2139,
            "speakerName": "阿芷",
            "text": "谢谢你帮忙，我也请了小白来帮我处理药材，我们去磨坊那边，把这几份药材也送过去吧。"
          }
        }
      }
    },
    {
      "subId": "7182310",
      "subQuestName": "陪阿芷前往磨坊",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "718231001"
        ],
        "dialogs": {
          "718231001": {
            "id": "718231001",
            "speakerId": 2138,
            "speakerName": "小白",
            "text": "…唔，这些药材我就一起处理了吧，处理好了之后，你也能快点拿去做药了。",
            "nextDialogs": [
              "718231002"
            ]
          },
          "718231002": {
            "id": "718231002",
            "speakerId": 2139,
            "speakerName": "阿芷",
            "text": "嗯，谢谢你啦，我得再想想办法把药做得甜一些，不然那些孩子肯定又不肯吃了…",
            "nextDialogs": [
              "718231003"
            ]
          },
          "718231003": {
            "id": "718231003",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "你们每年这时候都这么忙吗？",
            "nextDialogs": [
              "718231004"
            ]
          },
          "718231004": {
            "id": "718231004",
            "speakerId": 2138,
            "speakerName": "小白",
            "text": "嗯…差不多吧，毕竟轻策庄里的年轻人实在没多少，那些能帮忙的事，我们还是尽量帮忙比较好。",
            "nextDialogs": [
              "718231005"
            ]
          },
          "718231005": {
            "id": "718231005",
            "speakerId": 2139,
            "speakerName": "阿芷",
            "text": "其实每年也就忙这么几天，没什么关系的，而且今年有你帮忙，我们也轻松了不少。",
            "nextDialogs": [
              "718231006"
            ]
          },
          "718231006": {
            "id": "718231006",
            "speakerId": 2139,
            "speakerName": "阿芷",
            "text": "之前几年，我每次采药都要花很多天，更别提做药了…",
            "nextDialogs": [
              "718231007"
            ]
          },
          "718231007": {
            "id": "718231007",
            "speakerId": 2139,
            "speakerName": "阿芷",
            "text": "好啦，谢谢你们帮忙，我们也要快点把药材处理好，然后去准备霄灯了。",
            "nextDialogs": [
              "718231008"
            ]
          },
          "718231008": {
            "id": "718231008",
            "speakerId": 2139,
            "speakerName": "阿芷",
            "text": "去年我就差点忘了放霄灯，今年可不能忘了…",
            "nextDialogs": [
              "718231009"
            ]
          },
          "718231009": {
            "id": "718231009",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "你想许什么愿望？",
            "nextDialogs": [
              "718231010"
            ]
          },
          "718231010": {
            "id": "718231010",
            "speakerId": 2139,
            "speakerName": "阿芷",
            "text": "唔…轻策庄里的人都身体健康？嘿嘿，差不多是类似的吧。",
            "nextDialogs": [
              "718231011"
            ]
          },
          "718231011": {
            "id": "718231011",
            "speakerId": 2139,
            "speakerName": "阿芷",
            "text": "不过，愿望说出来就不灵了，就不说给你听了。",
            "nextDialogs": [
              "718231012"
            ]
          },
          "718231012": {
            "id": "718231012",
            "speakerId": 2139,
            "speakerName": "阿芷",
            "text": "这些东西给你，今天谢谢你帮忙啦。"
          }
        }
      }
    }
  ]
}
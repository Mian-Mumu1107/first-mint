  "subQuests": [
    {
      "subId": "7369201",
      "subQuestName": "与帕兹对话",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "736920101"
        ],
        "dialogs": {
          "736920101": {
            "id": "736920101",
            "speakerId": 30350,
            "speakerName": "帕兹",
            "text": "啊…你好，旅行者，看样子，你也是来参加学院游乐会的吧。",
            "nextDialogs": [
              "736920102"
            ]
          },
          "736920102": {
            "id": "736920102",
            "speakerId": 30350,
            "speakerName": "帕兹",
            "text": "如果有兴趣的话，您愿意来试玩一下我们阿弥利多学院推出的小游戏吗？",
            "nextDialogs": [
              "736920103"
            ]
          },
          "736920103": {
            "id": "736920103",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "是什么小游戏？",
            "nextDialogs": [
              "736920104"
            ]
          },
          "736920104": {
            "id": "736920104",
            "speakerId": 30350,
            "speakerName": "帕兹",
            "text": "我们学院在学院游乐会期间推出了小游戏「仿生摹行」。",
            "nextDialogs": [
              "736920105"
            ]
          },
          "736920105": {
            "id": "736920105",
            "speakerId": 30350,
            "speakerName": "帕兹",
            "text": "在这个游戏中，我会向您介绍一些动物的规律性行为。",
            "nextDialogs": [
              "736920106"
            ]
          },
          "736920106": {
            "id": "736920106",
            "speakerId": 30350,
            "speakerName": "帕兹",
            "text": "当然了，这些「规律性」都经过了我们的简化和概括，很容易理解。",
            "nextDialogs": [
              "736920107"
            ]
          },
          "736920107": {
            "id": "736920107",
            "speakerId": 30350,
            "speakerName": "帕兹",
            "text": "您需要做的，就是用这个我们已经准备好的模型来模仿对应动物的行为。",
            "nextDialogs": [
              "736920110"
            ]
          },
          "736920110": {
            "id": "736920110",
            "speakerId": 30350,
            "speakerName": "帕兹",
            "text": "是的。「动物具有规律性的习性」是一句很容易理解和接受的话。",
            "nextDialogs": [
              "736920111"
            ]
          },
          "736920111": {
            "id": "736920111",
            "speakerId": 30350,
            "speakerName": "帕兹",
            "text": "但在这句看似简单的话背后，却包含着探究不尽的谜题。",
            "nextDialogs": [
              "736920112"
            ]
          },
          "736920112": {
            "id": "736920112",
            "speakerId": 30350,
            "speakerName": "帕兹",
            "text": "不过…这段时间内，我们就暂时放下学术性的观察眼光，轻松地体会一下动物们的习性吧。"
          }
        }
      }
    },
    {
      "subId": "7369299",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "736929901"
        ],
        "dialogs": {

    {
      "subId": "7517905",
      "subQuestName": "击败出现的怪物",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "751790501"
        ],
        "dialogs": {
          "751790501": {
            "id": "751790501",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "离开。"
          }
        }
      }
    },
    {
      "subId": "7517906",
      "subQuestName": "和伊扎娅交谈",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "751790601"
        ],
        "dialogs": {
          "751790601": {
            "id": "751790601",
            "speakerId": 1006,
            "speakerName": "伊扎娅",
            "text": "呼——这点子真扎手。可恶！我竟然差点被几头嵴锋龙打翻在地上，真是火大。",
            "nextDialogs": [
              "751790602"
            ]
          },
          "751790602": {
            "id": "751790602",
            "speakerId": 1004,
            "speakerName": "派蒙",
            "text": "你们都搞错啦，这明明是深渊变成的怪物啦！它们可比嵴锋龙凶多了，你把它们当成嵴锋龙，难怪会吃亏呢！",
            "nextDialogs": [
              "751790603"
            ]
          },
          "751790603": {
            "id": "751790603",
            "speakerId": 1006,
            "speakerName": "伊扎娅",
            "text": "哈哈，原来是这样？怪不得呢。这次我可得好好谢谢你们，要不是有你们，我这次肯定是栽了。",
            "nextDialogs": [
              "751790604"
            ]
          },
          "751790604": {
            "id": "751790604",
            "speakerId": 1006,
            "speakerName": "伊扎娅",
            "text": "说是这么说，但你得在这儿先等一下，我得先把那几个不成器的家伙都捞回来，等确认他们都没事了再跟你道谢。",
            "nextDialogs": [
              "751790605"
            ]
          },
          "751790605": {
            "id": "751790605",
            "speakerId": 1007,
            "speakerName": "Black Screen",
            "text": "在你的帮助下，商队的人们都陆陆续续地集中了过来。"
          }
        }
      }
    },
    {
      "subId": "7517907",
      "subQuestName": "和伊扎娅交谈",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "751790701"
        ],
        "dialogs": {
          "751790701": {
            "id": "751790701",
            "speakerId": 1000,
            "speakerName": "蒂兹洛",
            "text": "这么说来，全靠这三位的帮助，大姐你才安然无恙？",
            "nextDialogs": [
              "751790702"
            ]
          },
          "751790702": {
            "id": "751790702",
            "speakerId": 1006,
            "speakerName": "伊扎娅",
            "text": "哈哈，没错没错！你是没看到这些家伙有多厉害，两三下就把那几个怪物给放倒了！",
            "nextDialogs": [
              "751790703"
            ]
          },
          "751790703": {
            "id": "751790703",
            "speakerId": 1000,
            "speakerName": "蒂兹洛",
            "text": "你们救了队长，我无以回报。小小礼物，不成敬意，还请你们收下。",
            "nextDialogs": [
              "751790704"
            ]
          },
          "751790704": {
            "id": "751790704",
            "speakerId": 1006,
            "speakerName": "伊扎娅",
            "text": "小气，蒂兹洛你这家伙一直都这么小气？对救命恩人怎么能只给这么一点谢礼呢？"
          }
        }
      }
    },
    {
      "subId": "7517913",
      "subQuestName": "和伊扎娅交谈",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "751791301"
        ],
        "dialogs": {
          "751791301": {
            "id": "751791301",
            "speakerId": 1006,
            "speakerName": "伊扎娅",
            "text": "喂！胖子！保证商队的前路安全是你的职责对吧？结果你的事儿都让别人给代劳了，你有什么要说的吗？",
            "nextDialogs": [
              "751791302"
            ]
          },
          "751791302": {
            "id": "751791302",
            "speakerId": 1005,
            "speakerName": "戈奇胡",
            "text": "我…",
            "nextDialogs": [
              "751791303"
            ]
          },
          "751791303": {
            "id": "751791303",
            "speakerId": 1006,
            "speakerName": "伊扎娅",
            "text": "别婆婆妈妈的，要不是你乱了阵脚，区区几只怪物，怎么可能奈何得了我？这次你的报酬，自己乖乖交一部分当谢礼吧！",
            "nextDialogs": [
              "751791304"
            ]
          },
          "751791304": {
            "id": "751791304",
            "speakerId": 1005,
            "speakerName": "戈奇胡",
            "text": "我、我，我听老大的…"
          }
        }
      }
    },
    {
      "subId": "7517910",
      "subQuestName": "和伊扎娅交谈",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "751790301"
        ],
        "dialogs": {
          "751790301": {
            "id": "751790301",
            "speakerId": 1006,
            "speakerName": "伊扎娅",
            "text": "当然了，这点东西作为救命的谢礼，肯定还是太小家子气了，对不对？",
            "nextDialogs": [
              "751790304",
              "751790305"
            ]
          },
          "751790304": {
            "id": "751790304",
            "speakerId": 1006,
            "speakerName": "伊扎娅",
            "text": "哈哈哈，说得对！我就喜欢你这样的人，够直接！",
            "nextDialogs": [
              "751790306"
            ]
          },
          "751790306": {
            "id": "751790306",
            "speakerId": 1006,
            "speakerName": "伊扎娅",
            "text": "咳，总而言之。这是我个人给你们的谢礼，你就一并收下吧！就当是给小嵴锋龙多买点吃的吧，可千万别跟我客气啊！",
            "nextDialogs": [
              "751790307"
            ]
          },
          "751790307": {
            "id": "751790307",
            "speakerId": 1008,
            "speakerName": "#{REALNAME[ID(2)|SHOWHOST(true)]}",

  "subQuests": [
    {
      "subId": "7517915",
      "subQuestName": "",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "751790401"
        ],
        "dialogs": {
          "751790401": {
            "id": "751790401",
            "speakerId": 1000,
            "speakerName": "蒂兹洛",
            "text": "喂！你，对就是你，外面危险，快进来！",
            "nextDialogs": [
              "751790402"
            ]
          },
          "751790402": {
            "id": "751790402",
            "speakerId": 1000,
            "speakerName": "蒂兹洛",
            "text": "哎呀，你没看见这一路的惨相吗？这又是火山喷发，又是有怪物拦路的，可不敢再往前走了。",
            "nextDialogs": [
              "751790403"
            ]
          },
          "751790403": {
            "id": "751790403",
            "speakerId": 1000,
            "speakerName": "蒂兹洛",
            "text": "你呀，听我一句劝。先在这里等等，等一下跟我们商队的人一起走，这样也有个照应。要不然一个人走多危险啊？",
            "nextDialogs": [
              "751790405",
              "751790409"
            ]
          },
          "751790405": {
            "id": "751790405",
            "speakerId": 1000,
            "speakerName": "蒂兹洛",
            "text": "是一群紫色的嵴锋龙！一看就是被深渊污染了！破坏力特别强，说实话我从来没见过这么吓人的嵴锋龙！",
            "nextDialogs": [
              "751790406"
            ]
          },
          "751790406": {
            "id": "751790406",
            "speakerId": 1000,
            "speakerName": "蒂兹洛",
            "text": "我跟你说，那几个家伙随便扫了一下尾巴就把我们的大车给打坏了，力气比突角龙还大，这肯定不是一般人能处理的对手。",
            "nextDialogs": [
              "751790407"
            ]
          },
          "751790407": {
            "id": "751790407",
            "speakerId": 1000,
            "speakerName": "蒂兹洛",
            "text": "你听我一句，你可千万不要头脑一热跑去跟它们打架啊，见到它们还是绕开一点为好。"
          },
          "751790409": {
            "id": "751790409",
            "speakerId": 1000,
            "speakerName": "蒂兹洛",
            "text": "你，唉…好吧，那你路上小心…"
          }
        }
      }
    },
    {
      "subId": "7517916",
      "subQuestName": "",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "751791001"
        ],
        "dialogs": {
          "751791001": {
            "id": "751791001",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "分享燃素。",
            "nextDialogs": [
              "751791002"
            ]
          },
          "751791002": {
            "id": "751791002",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "（它眨了眨眼，似乎是在道谢。）"
          }
        }
      }
    },
    {
      "subId": "7517903",
      "subQuestName": "",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "751790201"
        ],
        "dialogs": {
          "751790201": {
            "id": "751790201",
            "speakerId": 1001,
            "speakerName": "扎什",
            "text": "吁吁——",
            "nextDialogs": [
              "751790203",
              "751790205"
            ]
          },
          "751790203": {
            "id": "751790203",
            "speakerId": 1001,
            "speakerName": "扎什",
            "text": "还、还好，就是刚刚跑得有点急，心、心慌得厉害，缓一缓就好了。"
          },
          "751790205": {
            "id": "751790205",
            "speakerId": 1001,
            "speakerName": "扎什",
            "text": "嗯，谢、谢谢关心…"
          }
        }
      }
    },
    {
      "subId": "7517901",
      "subQuestName": "(test)异色脊峰龙和沃陆商队$HIDDEN",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "751790101"
        ],
        "dialogs": {
          "751790101": {
            "id": "751790101",
            "speakerId": 1002,
            "speakerName": "马索瑟",
            "text": "那边的，住、住手！这些都是我们的！不许动！告诉你，我、我可是能参加「巡夜者战争」的！",
            "nextDialogs": [
              "751790102"
            ]
          },
          "751790102": {
            "id": "751790102",
            "speakerId": 1002,
            "speakerName": "马索瑟",
            "text": "你、你要是敢抢我们的东西，我一定让你吃不了兜着走！",
            "nextDialogs": [
              "751790103"
            ]
          },
          "751790103": {
            "id": "751790103",
            "speakerId": 1003,
            "speakerName": "伊察霍",
            "text": "唉…今天怎么回事儿啊？又是火山喷发，又是紫色嵴锋龙的…现在又冒出一堆劫道的来，真是倒霉…",
            "nextDialogs": [
              "751790104"
            ]
          },
          "751790104": {
            "id": "751790104",
            "speakerId": 1003,
            "speakerName": "伊察霍",
            "text": "#马索瑟，{M#他}{F#她}看起来蛮厉害的，打不过的，还是算了吧…而且，我们只是看比赛的，应该不算是参加了吧…",
            "nextDialogs": [
              "751790105"
            ]
          },
          "751790105": {
            "id": "751790105",
            "speakerId": 1002,
            "speakerName": "马索瑟",
            "text": "#伊察霍，你、你这家伙！你怎么能这样，这可是大家的东西！再、再说了，我、我们两个打{M#他}{F#她}一个，未必打不过。",
            "nextDialogs": [
              "751790106"
            ]
          },
          "751790106": {
            "id": "751790106",
            "speakerId": 1003,
            "speakerName": "伊察霍",
            "text": "谁说是两个人？要挨打你上，可别算上我…",
            "nextDialogs": [
              "751790107"
            ]
          },
          "751790107": {
            "id": "751790107",
            "speakerId": 1003,
            "speakerName": "伊察霍",
            "text": "#这位{M#大哥}{F#大姐}，东西我们不要了，你想要你就拿去。只要别动手就行…",
            "nextDialogs": [
              "751790111",
              "751790110"
            ]
          },
          "751790111": {
            "id": "751790111",
            "speakerId": 1004,
            "speakerName": "派蒙",
            "text": "你们都误会啦！我们可是乐于助人的好冒险家，才不是那种不明不白的坏人呢！",
            "nextDialogs": [
              "751790112"
            ]
          },
          "751790112": {
            "id": "751790112",
            "speakerId": 1002,
            "speakerName": "马索瑟",
            "text": "我、我凭什么相信你们！啊！好痛，伊察霍你为什么打我？",
            "nextDialogs": [
              "751790113"
            ]
          },
          "751790113": {
            "id": "751790113",
            "speakerId": 1003,
            "speakerName": "伊察霍",
            "text": "人家要不怀好意，早就揍你了，还用得着跟你在这里浪费口舌。",
            "nextDialogs": [
              "751790114"
            ]
          },
          "751790114": {
            "id": "751790114",
            "speakerId": 1003,
            "speakerName": "伊察霍",
            "text": "两位，实不相瞒，我们商队刚刚被打散了，既然你们是冒险家的话，不知道能不能帮我们通知一下老大，就说我们在这里等她。",
            "nextDialogs": [
              "751790115"
            ]
          },
          "751790115": {
            "id": "751790115",
            "speakerId": 1003,
            "speakerName": "伊察霍",
            "text": "箱子里的东西，就当是我们给的谢礼了。",
            "nextDialogs": [
              "751790116"
            ]
          },
          "751790116": {
            "id": "751790116",
            "speakerId": 1004,
            "speakerName": "派蒙",
            "text": "这个简单，就交给我们吧！"
          },
          "751790110": {
            "id": "751790110",
            "speakerId": 1004,
            "speakerName": "派蒙",
            "text": "喂！你这说法！别搞得我们像是那种坏人一样啊！"
          }
        }
      }
    },

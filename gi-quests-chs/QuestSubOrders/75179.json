    {
      "subId": "7517908",
      "subQuestName": "(test)分支2: 帮助商队开路$HIDDEN",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "751791101"
        ],
        "dialogs": {
          "751791101": {
            "id": "751791101",
            "speakerId": 1005,
            "speakerName": "戈奇胡",
            "text": "这可怎么办啊？这可怎么办啊？等回去，老大她非得打我一顿不可…",
            "nextDialogs": [
              "751791103",
              "751791107"
            ]
          },
          "751791103": {
            "id": "751791103",
            "speakerId": 1005,
            "speakerName": "戈奇胡",
            "text": "唉…我们商队原本在路上走得好好的，结果突然遇上了火山喷发，地里还钻出了好几头紫色的嵴锋龙。",
            "nextDialogs": [
              "751791104"
            ]
          },
          "751791104": {
            "id": "751791104",
            "speakerId": 1005,
            "speakerName": "戈奇胡",
            "text": "我一个不小心，让我的龙伙伴受了惊脱离了队伍。结果现在回头一看，发现路被堵了，跟大家没办法汇合了…",
            "nextDialogs": [
              "751791105"
            ]
          },
          "751791105": {
            "id": "751791105",
            "speakerId": 1005,
            "speakerName": "戈奇胡",
            "text": "唉…也不知道大家都怎么样了。我这样擅自脱队，老大现在一定很生气，完了完了，这下我可完蛋了…"
          },
          "751791107": {
            "id": "751791107",
            "speakerId": 1005,
            "speakerName": "戈奇胡",
            "text": "跑？不行不行，老大那人跟夜神之国一样，无处不在的。我跑到哪都会被她抓回来…",
            "nextDialogs": [
              "751791108"
            ]
          },
          "751791108": {
            "id": "751791108",
            "speakerId": 1005,
            "speakerName": "戈奇胡",
            "text": "我还是得跑回去道歉才行。可，怎么办啊…这路都堵上了…唉，我这次肯定是死定了…"
          }
        }
      }
    },
    {
      "subId": "7517909",
      "subQuestName": "清理拦路的冲撞岩",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "751790901"
        ],
        "dialogs": {
          "751790901": {
            "id": "751790901",
            "speakerId": 1002,
            "speakerName": "马索瑟",
            "text": "伊、伊察霍，清、清单上还差好多东西，你、你来帮忙找找！",
            "nextDialogs": [
              "751790902"
            ]
          },
          "751790902": {
            "id": "751790902",
            "speakerId": 1003,
            "speakerName": "伊察霍",
            "text": "唉…别费那个劲了，我都看过了。基本都是一些易损的东西，就之前又是火山又是翻车的，你觉得还能有得剩吗？",
            "nextDialogs": [
              "751790903"
            ]
          },
          "751790903": {
            "id": "751790903",
            "speakerId": 1003,
            "speakerName": "伊察霍",
            "text": "省点力气，好好歇一会。等大姐她们回来，还有好长的路要走呢！",
            "nextDialogs": [
              "751790904"
            ]
          },
          "751790904": {
            "id": "751790904",
            "speakerId": 1002,
            "speakerName": "马索瑟",
            "text": "不、不行！算、算了，你不去我去…"
          }
        }
      }
    },

        "dialogs": {
          "761360301": {
            "id": "761360301",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "（或许<color=#FFCC33FF>雅珂达</color>想看看箱子的情况…）",
            "nextDialogs": [
              "761360302"
            ]
          },
          "761360302": {
            "id": "761360302",
            "speakerId": 1003,
            "speakerName": "雅珂达",
            "text": "嘿嘿…让我看看最近赚了多少钱。",
            "nextDialogs": [
              "761360303"
            ]
          },
          "761360303": {
            "id": "761360303",
            "speakerId": 1003,
            "speakerName": "雅珂达",
            "text": "上次老板说要给我加奖金呢，不如我现在就…",
            "nextDialogs": [
              "761360304"
            ]
          },
          "761360304": {
            "id": "761360304",
            "speakerId": 1003,
            "speakerName": "雅珂达",
            "text": "里面怎么没钱啊？只有一张纸条…",
            "nextDialogs": [
              "761360305"
            ]
          },
          "761360305": {
            "id": "761360305",
            "speakerId": 1003,
            "speakerName": "雅珂达",
            "text": "「亲爱的雅珂达，把盒子关好。你的奖金不从这里面出。」",
            "nextDialogs": [
              "761360306"
            ]
          },
          "761360306": {
            "id": "761360306",
            "speakerId": 1003,
            "speakerName": "雅珂达",
            "text": "嘁，老板又在吓人了，是不是有夹层…",
            "nextDialogs": [
              "761360307"
            ]
          },
          "761360307": {
            "id": "761360307",
            "speakerId": 1001,
            "speakerName": "奈芙尔",
            "text": "没有夹层，你的奖金在这里。",
            "nextDialogs": [
              "761360308"
            ]
          },
          "761360308": {
            "id": "761360308",
            "speakerId": 1003,
            "speakerName": "雅珂达",
            "text": "喔，谢谢老板，我…",
            "nextDialogs": [
              "761360309"
            ]
          },
          "761360309": {
            "id": "761360309",
            "speakerId": 1003,
            "speakerName": "雅珂达",
            "text": "呜啊啊啊啊啊啊啊——老老老老板，我就是清点一下！",
            "nextDialogs": [
              "761360310"
            ]
          },
          "761360310": {
            "id": "761360310",
            "speakerId": 1003,
            "speakerName": "雅珂达",
            "text": "我这就去工作，马上去——",
            "nextDialogs": [
              "761360311"
            ]
          },
          "761360311": {
            "id": "761360311",
            "speakerId": 1001,
            "speakerName": "奈芙尔",
            "text": "站住。",
            "nextDialogs": [
              "761360312"
            ]
          },
          "761360312": {
            "id": "761360312",
            "speakerId": 1003,
            "speakerName": "雅珂达",
            "text": "是！",
            "nextDialogs": [
              "761360313"
            ]
          },
          "761360313": {
            "id": "761360313",
            "speakerId": 1001,
            "speakerName": "奈芙尔",
            "text": "锁好盒子。",
            "nextDialogs": [
              "761360314"
            ]
          },
          "761360314": {
            "id": "761360314",
            "speakerId": 1003,
            "speakerName": "雅珂达",
            "text": "是！",
            "nextDialogs": [
              "761360315"
            ]
          },
          "761360315": {
            "id": "761360315",
            "speakerId": 1001,
            "speakerName": "奈芙尔",
            "text": "去吧。",
            "nextDialogs": [
              "761360316"
            ]
          },
          "761360316": {
            "id": "761360316",
            "speakerId": 1003,
            "speakerName": "雅珂达",
            "text": "是！"
          }
        }

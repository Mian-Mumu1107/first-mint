          },
          "749040104": {
            "id": "749040104",
            "speakerId": 1000,
            "speakerName": "瑟萝",
            "text": "那悄悄告诉你，其实，我更喜欢没有潮水的时候哦。",
            "nextDialogs": [
              "749040105"
            ]
          },
          "749040105": {

            ]
          },
          "721230604": {
            "id": "721230604",
            "speakerId": 20244,
            "speakerName": "秀秋",
            "text": "别、别以为你们能唬住我，搅了我的买卖还想把我人也折进去，没门！我还有最后一招。"

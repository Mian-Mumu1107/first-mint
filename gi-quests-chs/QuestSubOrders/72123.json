    {
      "subId": "7212315",
      "subQuestName": "再次前往盗宝团营地调查",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "721230501"
        ],
        "dialogs": {
          "721230501": {
            "id": "721230501",
            "speakerId": 20244,
            "speakerName": "秀秋",
            "text": "哼，原来是你这个女人要妨碍我赚钱。",
            "nextDialogs": [
              "721230502"
            ]
          },
          "721230502": {
            "id": "721230502",
            "speakerId": 3163,
            "speakerName": "阿幸",
            "text": "你们真是不知好歹，雷樱树的主意也敢打，神子大人不会让你们好过的。",
            "nextDialogs": [
              "721230503"
            ]
          },
          "721230503": {
            "id": "721230503",
            "speakerId": 20244,
            "speakerName": "秀秋",
            "text": "少说大话了，你们也不看看惹到的是谁！",
            "nextDialogs": [
              "721230504"
            ]
          },
          "721230504": {
            "id": "721230504",
            "speakerId": 20244,
            "speakerName": "秀秋",
            "text": "大爷，妨碍您生意的就是那边那个旅行者，您不出手咱们的买卖就悬了。",
            "nextDialogs": [
              "721230505"
            ]
          },
          "721230505": {
            "id": "721230505",
            "speakerId": 10324,
            "speakerName": "愚人众先遣队",
            "text": "呵呵，就凭这弱不禁风的身板，也敢在我面前逞威风？"
          }
        }
      }
    },

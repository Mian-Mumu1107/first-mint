        "dialogs": {}
      }
    },
    {
      "subId": "4133503",
      "subQuestName": "与清昼对话",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "413350301"
        ],
        "dialogs": {
          "413350301": {
            "id": "413350301",
            "speakerId": 1000,
            "speakerName": "梵米尔",
            "text": "这里的景色还不错。咦，这位是…",
            "nextDialogs": [
              "413350302"
            ]
          },
          "413350302": {
            "id": "413350302",
            "speakerId": 1001,
            "speakerName": "清昼",
            "text": "在下清昼，自诩诗客。您是…",
            "nextDialogs": [
              "413350303"
            ]
          },
          "413350303": {
            "id": "413350303",
            "speakerId": 1000,
            "speakerName": "梵米尔",
            "text": "哈哈，你是个诗人吗？我是个画家，正在这附近取材呢。",
            "nextDialogs": [
              "413350304"
            ]
          },
          "413350304": {
            "id": "413350304",
            "speakerId": 1001,
            "speakerName": "清昼",
            "text": "取材？巧了，我也正在取材，敢问您是为何取材？",
            "nextDialogs": [
              "413350305"
            ]
          },
          "413350305": {
            "id": "413350305",
            "speakerId": 1000,
            "speakerName": "梵米尔",
            "text": "唔，我想要画一幅画来描绘海灯节和璃月港，正在和这位旅行者一起找最佳取景点。",
            "nextDialogs": [
              "413350306"
            ]
          },
          "413350306": {
            "id": "413350306",
            "speakerId": 1000,
            "speakerName": "梵米尔",
            "text": "对了，您又是为什么在这取材的？",
            "nextDialogs": [
              "413350307"
            ]
          },
          "413350307": {
            "id": "413350307",
            "speakerId": 1001,
            "speakerName": "清昼",
            "text": "嗯…这确实是巧了，我也正好想要写一首诗来描述海灯节和璃月港，也正在这里取材。",
            "nextDialogs": [
              "413350308"
            ]
          },
          "413350308": {
            "id": "413350308",
            "speakerId": 1000,
            "speakerName": "梵米尔",
            "text": "嗯…",
            "nextDialogs": [
              "413350309"
            ]
          },
          "413350309": {
            "id": "413350309",
            "speakerId": 1001,
            "speakerName": "清昼",
            "text": "唔…",
            "nextDialogs": [
              "413350310"
            ]
          },
          "413350310": {
            "id": "413350310",
            "speakerId": 1000,
            "speakerName": "梵米尔",
            "text": "一首诗…有点简单了吧，海灯节和璃月港用几行字怎么能描述得下来？",
            "nextDialogs": [
              "413350311"
            ]
          },
          "413350311": {
            "id": "413350311",
            "speakerId": 1000,
            "speakerName": "梵米尔",
            "text": "哈哈，要我说，还是得画一幅大画，才能把这些事物全部给描绘下来。",
            "nextDialogs": [
              "413350312"
            ]
          },
          "413350312": {
            "id": "413350312",
            "speakerId": 1001,
            "speakerName": "清昼",
            "text": "一幅大画？呵呵，我倒是觉得这样太费笔墨，反倒是把海灯节的神韵给遮盖了下来，也失了璃月之风。",
            "nextDialogs": [
              "413350313"
            ]
          },
          "413350313": {
            "id": "413350313",
            "speakerId": 1001,
            "speakerName": "清昼",
            "text": "再说了，如此大的璃月，又怎么能是一幅画能画下来的？",
            "nextDialogs": [
              "413350314"
            ]
          },
          "413350314": {
            "id": "413350314",
            "speakerId": 1000,
            "speakerName": "梵米尔",
            "text": "哈哈，我看，还是画好。",
            "nextDialogs": [
              "413350315"
            ]
          },
          "413350315": {
            "id": "413350315",
            "speakerId": 1001,
            "speakerName": "清昼",
            "text": "呵呵，我想，还是诗好。",
            "nextDialogs": [
              "413350316"
            ]
          },
          "413350316": {
            "id": "413350316",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "你们冷静点…",
            "nextDialogs": [
              "413350317"
            ]
          },
          "413350317": {
            "id": "413350317",
            "speakerId": 1000,
            "speakerName": "梵米尔",
            "text": "这么争下去也没个头，不如这样，我们各自去创作一番。",
            "nextDialogs": [
              "413350318"
            ]
          },
          "413350318": {
            "id": "413350318",
            "speakerId": 1000,
            "speakerName": "梵米尔",
            "text": "等创作完了，再把作品摆在一起，请个人来评判，怎么样？",
            "nextDialogs": [
              "413350319"
            ]
          },
          "413350319": {
            "id": "413350319",
            "speakerId": 1001,
            "speakerName": "清昼",
            "text": "这样也好，那等你画好了画，就来望舒客栈找我吧。然后我们再去找人评判。",
            "nextDialogs": [
              "413350320"
            ]
          },
          "413350320": {
            "id": "413350320",
            "speakerId": 1000,
            "speakerName": "梵米尔",
            "text": "好，那就一言为定。",
            "nextDialogs": [
              "413350321"
            ]
          },
          "413350321": {
            "id": "413350321",
            "speakerId": 1001,
            "speakerName": "清昼",
            "text": "一言为定，在下就先告辞了。",
            "nextDialogs": [
              "413350322"
            ]
          },
          "413350322": {
            "id": "413350322",
            "speakerId": 1000,
            "speakerName": "梵米尔",
            "text": "这个诗人真是大言不惭，凭几行字就想概括海灯节和璃月港…",
            "nextDialogs": [
              "413350323"
            ]
          },
          "413350323": {
            "id": "413350323",
            "speakerId": 1000,
            "speakerName": "梵米尔",
            "text": "哼，等我把画画出来了，这诗人肯定得认输。",
            "nextDialogs": [
              "413350324"
            ]
          },
          "413350324": {
            "id": "413350324",
            "speakerId": 1000,
            "speakerName": "梵米尔",
            "text": "这幅画我得好好画…画材也得特别准备一下才好。",
            "nextDialogs": [
              "413350325"
            ]
          },
          "413350325": {
            "id": "413350325",
            "speakerId": 1000,
            "speakerName": "梵米尔",
            "text": "旅行者，能请你帮我去搜集一点特别的材料吗？",
            "nextDialogs": [
              "413350327"
            ]
          },
          "413350327": {
            "id": "413350327",
            "speakerId": 1000,
            "speakerName": "梵米尔",
            "text": "那就拜托你了，我想想…",
            "nextDialogs": [
              "413350329"
            ]
          },
          "413350329": {
            "id": "413350329",
            "speakerId": 1000,
            "speakerName": "梵米尔",
            "text": "唔…请你帮我去从炽热骗骗花那里搜集一份骗骗花蜜吧。",
            "nextDialogs": [
              "413350330"
            ]
          },
          "413350330": {
            "id": "413350330",
            "speakerId": 1000,
            "speakerName": "梵米尔",
            "text": "有了它，我一定能做出一份特别的颜料…"
          }
        }
      }
    },
    {
      "subId": "4133506",
      "subQuestName": "搜集「炽热的骗骗花蜜」",
      "sceneId": null,
      "locations": [],

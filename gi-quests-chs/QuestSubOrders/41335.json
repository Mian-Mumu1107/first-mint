    {
      "subId": "4133501",
      "subQuestName": "与梵米尔对话",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "413350101"
        ],
        "dialogs": {
          "413350101": {
            "id": "413350101",
            "speakerId": 1000,
            "speakerName": "梵米尔",
            "text": "不对，这样也不对…",
            "nextDialogs": [
              "413350102"
            ]
          },
          "413350102": {
            "id": "413350102",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "怎么了？",
            "nextDialogs": [
              "413350103"
            ]
          },
          "413350103": {
            "id": "413350103",
            "speakerId": 1000,
            "speakerName": "梵米尔",
            "text": "啊，你好，我正在这附近取材呢。",
            "nextDialogs": [
              "413350104"
            ]
          },
          "413350104": {
            "id": "413350104",
            "speakerId": 1000,
            "speakerName": "梵米尔",
            "text": "现在不是正在海灯节期间吗？我正在想，怎么才能用一幅画来描绘海灯节和璃月港呢。",
            "nextDialogs": [
              "413350105"
            ]
          },
          "413350105": {
            "id": "413350105",
            "speakerId": 1000,
            "speakerName": "梵米尔",
            "text": "唉…不知道是我用的手法不对，还是什么原因…怎么画都感觉不对劲。",
            "nextDialogs": [
              "413350106"
            ]
          },
          "413350106": {
            "id": "413350106",
            "speakerId": 1000,
            "speakerName": "梵米尔",
            "text": "我在想，也许换个取景地能有些灵感，但我又实在找不到好取景地…",
            "nextDialogs": [
              "413350107"
            ]
          },
          "413350107": {
            "id": "413350107",
            "speakerId": 1000,
            "speakerName": "梵米尔",
            "text": "旅行者，你知道哪里有适合取景的地方吗？",
            "nextDialogs": [
              "413350108"
            ]
          },
          "413350108": {
            "id": "413350108",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "那我们去周围找找吧。",
            "nextDialogs": [
              "413350109"
            ]
          },
          "413350109": {
            "id": "413350109",
            "speakerId": 1000,
            "speakerName": "梵米尔",
            "text": "唔…也好，那我们一起去周围看看吧，说不定真能找到好取景地。"
          }
        }
      }
    },
    {
      "subId": "4133502",
      "subQuestName": "寻找合适的取景地",
      "sceneId": null,
      "locations": [],

      }
    },
    {
      "subId": "4133507",
      "subQuestName": "向梵米尔回报",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "413350701"
        ],
        "dialogs": {
          "413350701": {
            "id": "413350701",
            "speakerId": 1000,
            "speakerName": "梵米尔",
            "text": "怎么样，你拿到骗骗花蜜了吗？",
            "nextDialogs": [
              "413350702"
            ]
          },
          "413350702": {
            "id": "413350702",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "拿到了。",
            "nextDialogs": [
              "413350703"
            ]
          },
          "413350703": {
            "id": "413350703",
            "speakerId": 1000,
            "speakerName": "梵米尔",
            "text": "我看看，哎，就是这个，不错不错。",
            "nextDialogs": [
              "413350704"
            ]
          },
          "413350704": {
            "id": "413350704",
            "speakerId": 1000,
            "speakerName": "梵米尔",
            "text": "等我把颜料调制好，再找个取景点，我就开始画画。",
            "nextDialogs": [
              "413350705"
            ]
          },
          "413350705": {
            "id": "413350705",
            "speakerId": 1000,
            "speakerName": "梵米尔",
            "text": "哼，等那个诗人看到了我画的画，一定心服口服。",
            "nextDialogs": [
              "413350706"
            ]
          },
          "413350706": {
            "id": "413350706",
            "speakerId": 1000,
            "speakerName": "梵米尔",
            "text": "啊…对了！我记得，璃月的海灯节是要放「霄灯」，还要在上面写愿望什么的…对吧？",
            "nextDialogs": [
              "413350707"
            ]
          },
          "413350707": {
            "id": "413350707",
            "speakerId": 1000,
            "speakerName": "梵米尔",
            "text": "嘿嘿，我也把霄灯准备好了，愿望嘛…我就不告诉你了，不然说不定就不灵了。",
            "nextDialogs": [
              "413350708"
            ]
          },
          "413350708": {
            "id": "413350708",
            "speakerId": 1000,
            "speakerName": "梵米尔",
            "text": "哦，差点忘了…这些东西给你，就当是报酬吧，谢谢你帮我的忙。",
            "nextDialogs": [
              "413350709"
            ]
          },
          "413350709": {
            "id": "413350709",
            "speakerId": 1000,
            "speakerName": "梵米尔",
            "text": "我的这幅画，肯定会让那个诗人心服口服…"
          }
        }
      }
    },

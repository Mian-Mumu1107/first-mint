    },
    {
      "subId": "2070301",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "207030101"
        ],
        "dialogs": {
          "207030101": {
            "id": "207030101",
            "speakerId": 1000,
            "speakerName": "艾迪丝博士",
            "text": "…这个也不能作为写作素材，可惜了。",
            "nextDialogs": [
              "207030102"
            ]
          },
          "207030102": {
            "id": "207030102",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "你在做什么？",
            "nextDialogs": [
              "207030103"
            ]
          },
          "207030103": {
            "id": "207030103",
            "speakerId": 1000,
            "speakerName": "艾迪丝博士",
            "text": "我想写一本以「风」为主题，叙述蒙德历史的新书，正在这里寻找灵感呢。",
            "nextDialogs": [
              "207030104"
            ]
          },
          "207030104": {
            "id": "207030104",
            "speakerId": 1000,
            "speakerName": "艾迪丝博士",
            "text": "这里既有代表着风的「七天神像」，又有着与大英雄温妮莎相关的这棵树，在这里寻找灵感，再适合不过了。",
            "nextDialogs": [
              "207030105"
            ]
          },
          "207030105": {
            "id": "207030105",
            "speakerId": 1000,
            "speakerName": "艾迪丝博士",
            "text": "不过说来好笑，因为我没有「神之眼」，无论是想要寻找还是搜集「风」，都实在是太费力了。",
            "nextDialogs": [
              "207030106"
            ]
          },
          "207030106": {
            "id": "207030106",
            "speakerId": 1000,
            "speakerName": "艾迪丝博士",
            "text": "所谓的寻找灵感，也只不过是在这里发呆。仅有的一些素材，也都是从书籍里总结出来的一些二手材料。",
            "nextDialogs": [
              "207030107"
            ]
          },
          "207030107": {
            "id": "207030107",
            "speakerId": 1000,
            "speakerName": "艾迪丝博士",
            "text": "在这片大陆上，没有「神之眼」的人就是这样，做事永远事倍功半。",
            "nextDialogs": [
              "207030108"
            ]
          },
          "207030108": {
            "id": "207030108",
            "speakerId": 1000,
            "speakerName": "艾迪丝博士",
            "text": "没有「神之眼」，无法使用元素的力量…无论是研究还是生活，都活像个这世界里的局外人。",
            "nextDialogs": [
              "207030109"
            ]
          },
          "207030109": {
            "id": "207030109",
            "speakerId": 1000,
            "speakerName": "艾迪丝博士",
            "text": "哈哈哈，也许在神看来，拥有「神之眼」的人，才是这个世界的主角吧。",
            "nextDialogs": [
              "207030110"
            ]
          },
          "207030110": {
            "id": "207030110",
            "speakerId": 1000,
            "speakerName": "艾迪丝博士",
            "text": "抱歉，我说得有些多了。虽然话是这么说啦，但我不会放弃研究的。",
            "nextDialogs": [
              "207030111"
            ]
          },
          "207030111": {
            "id": "207030111",
            "speakerId": 1000,
            "speakerName": "艾迪丝博士",
            "text": "我没有「神之眼」，但绝不能在学术水平上再落下风。",
            "nextDialogs": [
              "207030112"
            ]
          },
          "207030112": {
            "id": "207030112",
            "speakerId": 1000,
            "speakerName": "艾迪丝博士",
            "text": "而且我听说，你虽然没有「神之眼」，但也能看到元素…",
            "nextDialogs": [
              "207030113"
            ]
          },
          "207030113": {
            "id": "207030113",
            "speakerId": 1000,
            "speakerName": "艾迪丝博士",
            "text": "如果能亲手拿到附着有「风」元素的东西，一定会对我的研究有帮助。",
            "nextDialogs": [
              "207030114"
            ]
          },
          "207030114": {
            "id": "207030114",
            "speakerId": 1000,
            "speakerName": "艾迪丝博士",
            "text": "旅行者，你能帮我去这棵大树上搜索一下吗？"
          }
        }
      }
    }
  ]
}
  "subQuests": [
    {
      "subId": "2070301",
      "subQuestName": "与艾迪丝对话",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "207030301"
        ],
        "dialogs": {
          "207030301": {
            "id": "207030301",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "具体要搜索什么？",
            "nextDialogs": [
              "207030303"
            ]
          },
          "207030303": {
            "id": "207030303",
            "speakerId": 1000,
            "speakerName": "艾迪丝博士",
            "text": "你能够看见「元素」，对吧？",
            "nextDialogs": [
              "207030304"
            ]
          },
          "207030304": {
            "id": "207030304",
            "speakerId": 1000,
            "speakerName": "艾迪丝博士",
            "text": "我想，只要循着「风」的痕迹搜索就好了。",
            "nextDialogs": [
              "207030305"
            ]
          },
          "207030305": {
            "id": "207030305",
            "speakerId": 1000,
            "speakerName": "艾迪丝博士",
            "text": "我就在树下等着你，有什么收获的话，就拿下来给我吧。"
          }
        }
      }
    },
    {
      "subId": "2070304",
      "subQuestName": "在大树上搜索三处「风」的痕迹",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "207030401"
        ],
        "dialogs": {
          "207030401": {
            "id": "207030401",
            "speakerId": 1000,
            "speakerName": "艾迪丝博士",
            "text": "不得不说，说到做研究，你这样的人明显才更加合适。",
            "nextDialogs": [
              "207030402"
            ]
          },
          "207030402": {
            "id": "207030402",
            "speakerId": 1000,
            "speakerName": "艾迪丝博士",
            "text": "既有丰富的冒险经验，体能也十分不错…",
            "nextDialogs": [
              "207030403"
            ]
          },
          "207030403": {
            "id": "207030403",
            "speakerId": 1000,
            "speakerName": "艾迪丝博士",
            "text": "最重要的是，虽然你没有「神之眼」，但也能够操纵元素。",
            "nextDialogs": [
              "207030404"
            ]
          },
          "207030404": {
            "id": "207030404",
            "speakerId": 1000,
            "speakerName": "艾迪丝博士",
            "text": "元素…在这片大地上，又有什么研究能绕开这两个字呢？对于学者来说，能不能操纵元素实在是…",
            "nextDialogs": [
              "207030405"
            ]
          },
          "207030405": {
            "id": "207030405",
            "speakerId": 1000,
            "speakerName": "艾迪丝博士",
            "text": "啊，我又自顾自说起来了…抱歉，请别放在心上。"
          }
        }
      }
    },
    {
      "subId": "2070305",
      "subQuestName": "在大树上搜索三处「风」的痕迹",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "207030501"
        ],
        "dialogs": {
          "207030501": {
            "id": "207030501",
            "speakerId": 1000,
            "speakerName": "艾迪丝博士",
            "text": "你有什么发现吗？",
            "nextDialogs": [
              "207030502"
            ]
          },
          "207030502": {
            "id": "207030502",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "找到了这些「树叶」。",
            "nextDialogs": [
              "207030503"
            ]
          },
          "207030503": {
            "id": "207030503",
            "speakerId": 1000,
            "speakerName": "艾迪丝博士",
            "text": "…树叶？请给我看看。您居然把它们装在这个盒子里...",
            "nextDialogs": [
              "207030504"
            ]
          },
          "207030504": {
            "id": "207030504",
            "speakerId": 1000,
            "speakerName": "艾迪丝博士",
            "text": "这些树叶…拿在手里的时候，确实能实实在在地感觉到「风」。",
            "nextDialogs": [
              "207030505"
            ]
          },
          "207030505": {
            "id": "207030505",
            "speakerId": 1000,
            "speakerName": "艾迪丝博士",
            "text": "这棵树上，居然真的有这种力量…要是我有「神之眼」的话，就不会浪费这么多时间了。",
            "nextDialogs": [
              "207030506"
            ]
          },
          "207030506": {
            "id": "207030506",
            "speakerId": 1000,
            "speakerName": "艾迪丝博士",
            "text": "谢谢，这是很宝贵的素材，我会好好利用的。",
            "nextDialogs": [
              "207030507"
            ]
          },
          "207030507": {
            "id": "207030507",
            "speakerId": 1000,
            "speakerName": "艾迪丝博士",
            "text": "不过，对这些「树叶」我也没什么保存手段，「风」也许很快就会消散，",
            "nextDialogs": [
              "207030508"
            ]
          },
          "207030508": {
            "id": "207030508",
            "speakerId": 1000,
            "speakerName": "艾迪丝博士",
            "text": "这些是给你的报酬，说不定下次还要麻烦你，再来帮我搜集素材了。"
          }
        }
      }
    },
    {
      "subId": "2070302",
      "subQuestName": "在大树上搜索三处「风」的痕迹",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "207030201"
        ],
        "dialogs": {
          "207030201": {
            "id": "207030201",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "交给我吧。",
            "nextDialogs": [
              "207030202"
            ]
          },
          "207030202": {
            "id": "207030202",
            "speakerId": 1000,
            "speakerName": "艾迪丝博士",
            "text": "太好了，那就拜托你了。"
          }
        }
      }
    },

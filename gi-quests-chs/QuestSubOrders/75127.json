  "subQuests": [
    {
      "subId": "7512701",
      "subQuestName": "(test)迷海结束后卫兵对话$HIDDEN",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "751270101"
        ],
        "dialogs": {
          "751270101": {
            "id": "751270101",
            "speakerId": 21705,
            "speakerName": "萨卡乌",
            "text": "哎呀，您也是来这里留影的吧。之前就有外国的旅客过来，想要在这里留影，毕竟海面上的浮岛是很好的景色呀…",
            "nextDialogs": [
              "751270102"
            ]
          },
          "751270102": {
            "id": "751270102",
            "speakerId": 21705,
            "speakerName": "萨卡乌",
            "text": "可惜之前没有留影机，我可是特地托认识的外国商人弄来了一台嘞。",
            "nextDialogs": [
              "751270103"
            ]
          },
          "751270103": {
            "id": "751270103",
            "speakerId": 21705,
            "speakerName": "萨卡乌",
            "text": "怎么样，客人，要不要试试拍张画片？不过得您自己动手，我拍照的技术可不怎么样呀…",
            "nextDialogs": [
              "751270104"
            ]
          },
          "751270104": {
            "id": "751270104",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "奇怪，海面上的雾…",
            "nextDialogs": [
              "751270105"
            ]
          },
          "751270105": {
            "id": "751270105",
            "speakerId": 21705,
            "speakerName": "萨卡乌",
            "text": "海面上的雾？客人你在说什么呀，这里海风可大咧，哪会有雾啊…",
            "nextDialogs": [
              "751270106"
            ]
          },
          "751270106": {
            "id": "751270106",
            "speakerId": 21705,
            "speakerName": "萨卡乌",
            "text": "从我出生到现在，可还没看到过海上有雾嘞。",
            "nextDialogs": [
              "751270107"
            ]
          },
          "751270107": {
            "id": "751270107",
            "speakerId": 21705,
            "speakerName": "萨卡乌",
            "text": "客人不会是把这里和镜璧山下那些全是雾的地方搞混了吧。",
            "nextDialogs": [
              "751270108"
            ]
          },
          "751270108": {
            "id": "751270108",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "大概吧…",
            "nextDialogs": [
              "751270109"
            ]
          },
          "751270109": {
            "id": "751270109",
            "speakerId": 21705,
            "speakerName": "萨卡乌",
            "text": "嘿嘿，要我说呀，客人你就是太紧张了。",
            "nextDialogs": [
              "751270110"
            ]
          },
          "751270110": {
            "id": "751270110",
            "speakerId": 21705,
            "speakerName": "萨卡乌",
            "text": "来纳塔旅游，还是要放松一些才行呀。"
          }
        }
      }
    }
  ]
}
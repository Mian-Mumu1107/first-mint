    {
      "subId": "1110202",
      "subQuestName": "与魈对话",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "111020201"
        ],
        "dialogs": {
          "111020201": {
            "id": "111020201",
            "speakerId": 1000,
            "speakerName": "魈",
            "text": "是你们…我还记得你们。",
            "nextDialogs": [
              "111020202"
            ]
          },
          "111020202": {
            "id": "111020202",
            "speakerId": 1000,
            "speakerName": "魈",
            "text": "我正在这一带清理沾染了「妖邪」的生物，看来，是妨碍到你们了。",
            "nextDialogs": [
              "111020203"
            ]
          },
          "111020203": {
            "id": "111020203",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "（咦，他的语气是不是有点太客气了…）",
            "nextDialogs": [
              "111020204"
            ]
          },
          "111020204": {
            "id": "111020204",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "你在这里降妖除魔，怎么能说是妨碍我们呢？",
            "nextDialogs": [
              "111020205"
            ]
          },
          "111020205": {
            "id": "111020205",
            "speakerId": 1000,
            "speakerName": "魈",
            "text": "因为这些魔物的异变，也是由我而起——是沾染我的「业障」所致。",
            "nextDialogs": [
              "111020206"
            ]
          },
          "111020206": {
            "id": "111020206",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "异变、业障…啊，难道…？",
            "nextDialogs": [
              "111020209"
            ]
          },
          "111020209": {
            "id": "111020209",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "是呀，我好像还记得魈有着「护法夜叉」的称呼…",
            "nextDialogs": [
              "111020210"
            ]
          },
          "111020210": {
            "id": "111020210",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "原来是这样…呜、呜呜…",
            "nextDialogs": [
              "111020211"
            ]
          },
          "111020211": {
            "id": "111020211",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "魈真是太可怜了哇…",
            "nextDialogs": [
              "111020212"
            ]
          },
          "111020212": {
            "id": "111020212",
            "speakerId": 1000,
            "speakerName": "魈",
            "text": "……？"
          }
        }
      }
    },
    {
      "subId": "1110203",

            "speakerId": 1004,
            "speakerName": "商人信众",
            "text": "这些丘丘人，以「星辰天君」的法力居然也制服不了吗…"
          }
        }
      }
    },
    {
      "subId": "1110223",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "111022301"
        ],
        "dialogs": {
          "111022301": {
            "id": "111022301",
            "speakerId": 1005,
            "speakerName": "掇星攫辰天君",
            "text": "本仙真的只是身体有恙，这次的事还望不要到处宣扬…"
          }
        }
      }
    },
    {
      "subId": "1110224",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "111022401"
        ],

  "subQuests": [
    {
      "subId": "7650601",
      "subQuestName": "(test)隐藏$HIDDEN",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "765060101"
        ],
        "dialogs": {
          "765060101": {
            "id": "765060101",
            "speakerId": 1055,
            "speakerName": "多莉",
            "text": "#哎呀，这不是{NICKNAME}和派蒙嘛！想不到在这里也能和两位相遇，这一定是能带来好运的奇妙缘分啊。",
            "nextDialogs": [
              "765060102"
            ]
          },
          "765060102": {
            "id": "765060102",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "多莉！你怎么一个人在这里呀？难道是摆摊卖东西吗？欸，不过我怎么没看到你的商品…",
            "nextDialogs": [
              "765060103"
            ]
          },
          "765060103": {
            "id": "765060103",
            "speakerId": 1055,
            "speakerName": "多莉",
            "text": "真是不好意思，今天大名鼎鼎的旅行商人多莉暂时歇业哦。",
            "nextDialogs": [
              "765060104"
            ]
          },
          "765060104": {
            "id": "765060104",
            "speakerId": 1055,
            "speakerName": "多莉",
            "text": "我现在啊，正学着那些挪德卡莱的本地人，在这座「乐园」里度过普普通通又自由自在的一天呢！",
            "nextDialogs": [
              "765060105"
            ]
          },
          "765060105": {
            "id": "765060105",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "哇，真的假的？没在忙着做买卖、赚摩拉的多莉，真是比沙漠里下雨还要少见啊！",
            "nextDialogs": [
              "765060106"
            ]
          },
          "765060106": {
            "id": "765060106",
            "speakerId": 1055,
            "speakerName": "多莉",
            "text": "哼哼，就算我本人在享受难得的假期，我那些店铺和勤劳能干的员工们，也依然在不停地为我赚取源源不断的摩拉呢！",
            "nextDialogs": [
              "765060107"
            ]
          },
          "765060107": {
            "id": "765060107",
            "speakerId": 1055,
            "speakerName": "多莉",
            "text": "只要我账户上的数字还在蹭蹭地往上涨，那就没什么可担心的啦。",
            "nextDialogs": [
              "765060108"
            ]
          },
          "765060108": {
            "id": "765060108",
            "speakerId": 1055,
            "speakerName": "多莉",
            "text": "这么说来，两位难道是遇到了什么难题吗？虽然我还在休假，但是对于送上门来的生意，我可是从来都不会拒绝的哦！",
            "nextDialogs": [
              "765060111"
            ]
          },
          "765060111": {
            "id": "765060111",
            "speakerId": 1055,
            "speakerName": "多莉",
            "text": "哦哦，原来是想记录下挪德卡莱的独特风光啊！那你们可算是问对人了。",
            "nextDialogs": [
              "765060112"
            ]
          },
          "765060112": {
            "id": "765060112",
            "speakerId": 1055,
            "speakerName": "多莉",
            "text": "我对这里的熟悉程度，虽然可能还比不上那些土生土长的地头蛇，但是说到风景独特的拍摄点，我还是能给你们推荐不少的！",
            "nextDialogs": [
              "765060113"
            ]
          },
          "765060113": {
            "id": "765060113",
            "speakerId": 1055,
            "speakerName": "多莉",
            "text": "看在咱们这么熟的份上，我亲自给你们当导游，费用就给你们打个骨折友情价，一天只收你们区区五十万摩拉！怎么样？",
            "nextDialogs": [
              "765060114"
            ]
          },
          "765060114": {
            "id": "765060114",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "呜哇…不愧是多莉，还是三句话离不开从我们的口袋里掏摩拉的事情呢。",
            "nextDialogs": [
              "765060115"
            ]
          },
          "765060115": {
            "id": "765060115",
            "speakerId": 1055,
            "speakerName": "多莉",
            "text": "哎呀呀，我这可都是为了让我最重要的客户，能在挪德卡莱留下一段最开心、最难忘的美好回忆嘛！"
          }
        }
      }
    },

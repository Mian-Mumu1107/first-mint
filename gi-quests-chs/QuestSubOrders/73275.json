        ],
        "dialogs": {
          "732750401": {
            "id": "732750401",
            "speakerId": 1000,
            "speakerName": "阿凡",
            "text": "♪…是你啊，来看看，这些花长得不错吧？"
          }
        }
      }
    },
    {
      "subId": "7327505",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "732750501"
        ],
        "dialogs": {
          "732750501": {
            "id": "732750501",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "关于歌谣…",
            "nextDialogs": [
              "732750502"
            ]
          },
          "732750502": {
            "id": "732750502",
            "speakerId": 1000,
            "speakerName": "阿凡",
            "text": "你还记得这首歌谣啊…又有一个年轻人记住了它，呵呵，是好事啊。",
            "nextDialogs": [
              "732750503"
            ]
          },
          "732750503": {
            "id": "732750503",
            "speakerId": 1000,
            "speakerName": "阿凡",
            "text": "「蔷薇啊蔷薇，实现我的愿望。花从石头中绽放，金蔷薇对我歌唱。」",
            "nextDialogs": [
              "732750504"
            ]
          },
          "732750504": {
            "id": "732750504",
            "speakerId": 1000,
            "speakerName": "阿凡",
            "text": "「没有土地承载我，唯有歌谣承载我。歌谣战胜敌视我的命运，战胜我的结局。」",
            "nextDialogs": [
              "732750505"
            ]
          },
          "732750505": {
            "id": "732750505",
            "speakerId": 1000,
            "speakerName": "阿凡",
            "text": "「战胜我战胜时间，战胜永不消逝的消逝…」"
          }
        }
      }
    },
    {
      "subId": "7327506",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "732750601"
        ],
        "dialogs": {
          "732750601": {
            "id": "732750601",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "再见。",
            "nextDialogs": [
              "732750602"
            ]
          },
          "732750602": {
            "id": "732750602",
            "speakerId": 1000,
            "speakerName": "阿凡",
            "text": "你是个善良的好孩子，神看到你的热心肠会庇护你的，再见。"
          }
        }
      }
    }

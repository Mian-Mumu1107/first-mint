  "subQuests": [
    {
      "subId": "7327501",
      "subQuestName": "",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "732750102"
        ],
        "dialogs": {
          "732750102": {
            "id": "732750102",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "种出了金蔷薇花苗。",
            "nextDialogs": [
              "732750103"
            ]
          },
          "732750103": {
            "id": "732750103",
            "speakerId": 1000,
            "speakerName": "阿凡",
            "text": "这些…嘿哟，你这小娃娃是在哪里找到这些花种的？",
            "nextDialogs": [
              "732750104"
            ]
          },
          "732750104": {
            "id": "732750104",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "在很远的地方捡到的。",
            "nextDialogs": [
              "732750105"
            ]
          },
          "732750105": {
            "id": "732750105",
            "speakerId": 1000,
            "speakerName": "阿凡",
            "text": "沙法卡特叔叔撒下的种子还真是去到了沙漠的各个角落，不过最后兜兜转转又回到这里来喽。",
            "nextDialogs": [
              "732750107"
            ]
          },
          "732750107": {
            "id": "732750107",
            "speakerId": 1000,
            "speakerName": "阿凡",
            "text": "这些花苗可得小心保存啊，我都要留给赛芭那孩子的。等到我也不在了，这些花就交给她了。",
            "nextDialogs": [
              "732750108"
            ]
          },
          "732750108": {
            "id": "732750108",
            "speakerId": 1000,
            "speakerName": "阿凡",
            "text": "孩子，谢谢你，我没什么好东西给你，就把这些果子和花送给你吧。"
          }
        }
      }
    },

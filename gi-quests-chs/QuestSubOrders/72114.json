            "speakerId": 3163,
            "speakerName": "阿幸",
            "text": "如果「御影炉心」里的「祟神」出了什么问题的话…",
            "nextDialogs": [
              "721141802"
            ]
          },
          "721141802": {
            "id": "721141802",
            "speakerId": 3163,
            "speakerName": "阿幸",
            "text": "…只能说，你趁早离开这座岛吧。"
          }
        }
      }

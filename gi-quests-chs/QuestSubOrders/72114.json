  "subQuests": [
    {
      "subId": "7211427",
      "subQuestName": "向两人询问情况$HIDDEN",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "721141601"
        ],
        "dialogs": {
          "721141601": {
            "id": "721141601",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "唔唔唔，这两个人好像在吵什么…气氛好紧张…",
            "nextDialogs": [
              "721141602"
            ]
          },
          "721141602": {
            "id": "721141602",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "不过，他们好像提到了什么「御影炉心」的事。",
            "nextDialogs": [
              "721141603"
            ]
          },
          "721141603": {
            "id": "721141603",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "难道，是这座岛上发生了什么问题吗？我们去找那两个人问问吧。"
          }
        }
      }
    },
    {
      "subId": "7211423",
      "subQuestName": "向两人询问情况",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "721140901"
        ],
        "dialogs": {
          "721140901": {
            "id": "721140901",
            "speakerId": 3185,
            "speakerName": "虎之助",
            "text": "你有什么事吗？",
            "nextDialogs": [
              "721140902"
            ]
          },
          "721140902": {
            "id": "721140902",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "你们说的「御影炉心」、「祟神」到底是…",
            "nextDialogs": [
              "721140903"
            ]
          },
          "721140903": {
            "id": "721140903",
            "speakerId": 3185,
            "speakerName": "虎之助",
            "text": "…只是一些需要花点时间解决的小问题。",
            "nextDialogs": [
              "721140904"
            ]
          },
          "721140904": {
            "id": "721140904",
            "speakerId": 3185,
            "speakerName": "虎之助",
            "text": "你是冒险者吧。这里不适合你「冒险」，赶快回去吧。"
          }
        }
      }
    },
    {
      "subId": "7211424",
      "subQuestName": "向两人询问情况",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "721141001"
        ],
        "dialogs": {
          "721141001": {
            "id": "721141001",
            "speakerId": 3163,
            "speakerName": "阿幸",
            "text": "真是的…事情怎么会变成这样…",
            "nextDialogs": [
              "721141002"
            ]
          },
          "721141002": {
            "id": "721141002",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "刚才你们说的「御影炉心」到底是…",
            "nextDialogs": [
              "721141003"
            ]
          },
          "721141003": {
            "id": "721141003",
            "speakerId": 3163,
            "speakerName": "阿幸",
            "text": "你是…外国的旅行者吧？在这样的时期来到稻妻，运气还真是不好…",
            "nextDialogs": [
              "721141004"
            ]
          },
          "721141004": {
            "id": "721141004",
            "speakerId": 3163,
            "speakerName": "阿幸",
            "text": "那座岛叫「踏鞴砂」，是生产锻造武器用的「玉钢」的冶炼厂。",
            "nextDialogs": [
              "721141005"
            ]
          },
          "721141005": {
            "id": "721141005",
            "speakerId": 3163,
            "speakerName": "阿幸",
            "text": "对了，既然你是外国人，应该听过稻妻刀剑的传说吧？",
            "nextDialogs": [
              "721141006"
            ]
          },
          "721141006": {
            "id": "721141006",
            "speakerId": 3163,
            "speakerName": "阿幸",
            "text": "正是因为这里生产的「玉钢」，稻妻的刀剑才会如此锋利、坚硬。",
            "nextDialogs": [
              "721141008",
              "721141010"
            ]
          },
          "721141008": {
            "id": "721141008",
            "speakerId": 3163,
            "speakerName": "阿幸",
            "text": "不用紧张，谈不上什么军事机密。",
            "nextDialogs": [
              "721141011"
            ]
          },
          "721141011": {
            "id": "721141011",
            "speakerId": 3163,
            "speakerName": "阿幸",
            "text": "毕竟，在天领奉行看来，能够锻造强力的武器也是一种值得夸耀的实力。",
            "nextDialogs": [
              "721141012"
            ]
          },
          "721141012": {
            "id": "721141012",
            "speakerId": 3163,
            "speakerName": "阿幸",
            "text": "前几年，为了扩大生产的规模，他们从枫丹请了一支顾问团队，建造了能充分利用「祟神」力量的「御影炉心」。",
            "nextDialogs": [
              "721141013"
            ]
          },
          "721141013": {
            "id": "721141013",
            "speakerId": 3163,
            "speakerName": "阿幸",
            "text": "虽然我们也多次提醒他们，不能对「祟神」掉以轻心。但他们还是打定了主意，依然推进着建造计划。",
            "nextDialogs": [
              "721141014"
            ]
          },
          "721141014": {
            "id": "721141014",
            "speakerId": 3163,
            "speakerName": "阿幸",
            "text": "「御影炉心」投产后，顾问团的成员大部分都回国了，只有刚刚提到的泽维尔还留在稻妻。",
            "nextDialogs": [
              "721141015"
            ]
          },
          "721141015": {
            "id": "721141015",
            "speakerId": 3163,
            "speakerName": "阿幸",
            "text": "但在前段时间的战事中，「御影炉心」似乎出了什么问题，存储「祟神」的部分变得十分不稳定…",
            "nextDialogs": [
              "721141016"
            ]
          },
          "721141016": {
            "id": "721141016",
            "speakerId": 3163,
            "speakerName": "阿幸",
            "text": "在那之后，踏鞴砂就停工了，里面的人也被疏散了。",
            "nextDialogs": [
              "721141017"
            ]
          },
          "721141017": {
            "id": "721141017",
            "speakerId": 3163,
            "speakerName": "阿幸",
            "text": "泽维尔进行了紧急处理，据说，他在「御影炉心」周围已经布置好了护罩。",
            "nextDialogs": [
              "721141018"
            ]
          },
          "721141018": {
            "id": "721141018",
            "speakerId": 3163,
            "speakerName": "阿幸",
            "text": "但这样做也不是长久之计。他应该还在岛上，研究彻底解决问题的方法。",
            "nextDialogs": [
              "721141019"
            ]
          },
          "721141019": {
            "id": "721141019",
            "speakerId": 3163,
            "speakerName": "阿幸",
            "text": "不过，幕府那边似乎还在一门心思地想着复产。我听说，他们甚至打算再次邀请枫丹顾问。",
            "nextDialogs": [
              "721141020"
            ]
          },
          "721141020": {
            "id": "721141020",
            "speakerId": 3163,
            "speakerName": "阿幸",
            "text": "但是，以稻妻现在这个情况，他们应该不太会愿意来吧…",
            "nextDialogs": [
              "721141021"
            ]
          },
          "721141021": {
            "id": "721141021",
            "speakerId": 3163,
            "speakerName": "阿幸",
            "text": "而且，负责管理这件事的居然还是那个范兵卫…",
            "nextDialogs": [
              "721141022"
            ]
          },
          "721141022": {
            "id": "721141022",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "范兵卫是…",
            "nextDialogs": [
              "721141023"
            ]
          },
          "721141023": {
            "id": "721141023",
            "speakerId": 3163,
            "speakerName": "阿幸",
            "text": "一个…管事的人，成天都念叨着流程、条文，申请之类的话。",
            "nextDialogs": [
              "721141024"
            ]
          },
          "721141024": {
            "id": "721141024",
            "speakerId": 3163,
            "speakerName": "阿幸",
            "text": "无论是办什么事，第一反应不是找到解决方法，而是应该递交什么文书，和城里的哪位大人预先知会一声。",
            "nextDialogs": [
              "721141025"
            ]
          },
          "721141025": {
            "id": "721141025",
            "speakerId": 3163,
            "speakerName": "阿幸",
            "text": "现在，他应该去了城里，准备把能递交的文书全部递交一遍吧。",
            "nextDialogs": [
              "721141026"
            ]
          },
          "721141026": {
            "id": "721141026",
            "speakerId": 3163,
            "speakerName": "阿幸",
            "text": "真是不知道，这…个人到底意没意识到「御影炉心」的问题到底有多严重。",
            "nextDialogs": [
              "721141027"
            ]
          },
          "721141027": {
            "id": "721141027",
            "speakerId": 3163,
            "speakerName": "阿幸",
            "text": "唉…只能希望我们的工匠，或者泽维尔先生能有什么解决的办法了。",
            "nextDialogs": [
              "721141028"
            ]
          },
          "721141028": {
            "id": "721141028",
            "speakerId": 3163,
            "speakerName": "阿幸",
            "text": "如果「御影炉心」里的「祟神」出了什么问题的话…",
            "nextDialogs": [
              "721141029"
            ]
          },
          "721141029": {
            "id": "721141029",
            "speakerId": 3163,
            "speakerName": "阿幸",
            "text": "…只能说，你趁早离开这座岛吧。"
          },
          "721141010": {
            "id": "721141010",
            "speakerId": 3163,
            "speakerName": "阿幸",
            "text": "也没有机密到这个地步。"
          }
        }
      }
    },
    {
      "subId": "7211425",
      "subQuestName": "",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "721141101"
        ],
        "dialogs": {
          "721141101": {
            "id": "721141101",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "听起来好像很严重啊…",
            "nextDialogs": [
              "721141104"
            ]
          },
          "721141104": {
            "id": "721141104",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "确实是这样呢…对了，她刚才说，有个「泽维尔」是不是正在想办法解决这个问题？",
            "nextDialogs": [
              "721141105"
            ]
          },
          "721141105": {
            "id": "721141105",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "不然，我们过去看看吧？要是我们真能帮上什么忙，让这件事顺利解决了的话，我们在这边待着的时候也会安心很多吧。"
          }
        }
      }
    },
    {
      "subId": "7211404",
      "subQuestName": "寻找泽维尔",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "721140304"
        ],
        "dialogs": {
          "721140304": {
            "id": "721140304",
            "speakerId": 3162,
            "speakerName": "泽维尔",
            "text": "已经没办法了…",
            "nextDialogs": [
              "721140305"
            ]
          },
          "721140305": {
            "id": "721140305",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "你好，请问你是泽维尔…",
            "nextDialogs": [
              "721140306"
            ]
          },
          "721140306": {
            "id": "721140306",
            "speakerId": 3162,
            "speakerName": "泽维尔",
            "text": "#不错，在下正是泽维尔，泽维尔正是在下！在这样的时间与地点相遇，究竟是幸或是不幸呢？那么，请问{PLAYERAVATAR#SEXPRO[INFO_MALE_PRONOUN_BOYC|INFO_FEMALE_PRONOUN_GIRLC]}您是？",
            "nextDialogs": [
              "721140308",
              "721140310"
            ]
          },
          "721140308": {
            "id": "721140308",
            "speakerId": 3162,
            "speakerName": "泽维尔",
            "text": "#冒险家？朝向星辰与深渊永不停歇的脚步，竟然将冒险家{PLAYERAVATAR#SEXPRO[INFO_MALE_PRONOUN_BOYC|INFO_FEMALE_PRONOUN_GIRLC]}带到了纷争与祟神的岛上！",
            "nextDialogs": [
              "721140312"
            ]
          },
          "721140312": {
            "id": "721140312",
            "speakerId": 3162,
            "speakerName": "泽维尔",
            "text": "您来的时候应该见到了一个…气泡一样的罩子吧。",
            "nextDialogs": [
              "721140313"
            ]
          },
          "721140313": {
            "id": "721140313",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "没有。",
            "nextDialogs": [
              "721140314"
            ]
          },
          "721140314": {
            "id": "721140314",
            "speakerId": 3162,
            "speakerName": "泽维尔",
            "text": "呃…好吧，这也正常，反正那个护罩一般也看不见，想要在远处看见的话，还得用什么特殊的观测方式…"
          },
          "721140310": {
            "id": "721140310",
            "speakerId": 3162,
            "speakerName": "泽维尔",
            "text": "#帮忙？看{PLAYERAVATAR#SEXPRO[INFO_MALE_PRONOUN_BOYC|INFO_FEMALE_PRONOUN_GIRLC]}您的穿着，也与我一样，是沉醉于稻妻异国风情的旅者吧，真是奇遇！",
            "nextDialogs": [
              "721140311"
            ]
          },
          "721140311": {
            "id": "721140311",
            "speakerId": 3162,
            "speakerName": "泽维尔",
            "text": "总而言之，非常感谢您的好意，但恕我直言，您应该帮不上我的忙…"
          }
        }
      }
    },
    {
      "subId": "7211405",
      "subQuestName": "观察「御影炉心」的情况",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [],
        "dialogs": {}
      }
    },
    {
      "subId": "7211406",
      "subQuestName": "观察「御影炉心」的情况",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [],
        "dialogs": {}
      }
    },
    {
      "subId": "7211407",
      "subQuestName": "观察「御影炉心」的情况",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "721140701"
        ],
        "dialogs": {
          "721140701": {
            "id": "721140701",
            "speakerId": 3162,
            "speakerName": "泽维尔",
            "text": "我看看…还好，还好，没有过大的破损点。",
            "nextDialogs": [
              "721140702"
            ]
          },
          "721140702": {
            "id": "721140702",
            "speakerId": 3162,
            "speakerName": "泽维尔",
            "text": "如果应急系统运转正常，现在装置内部大部分的能量通路应当已经封闭了，真是不幸中的万幸…",
            "nextDialogs": [
              "721140703"
            ]
          },
          "721140703": {
            "id": "721140703",
            "speakerId": 3162,
            "speakerName": "泽维尔",
            "text": "不过，想要完全搞定「御影炉心」的问题…我得再做些准备，也得再好好想想…",
            "nextDialogs": [
              "721140704"
            ]
          },
          "721140704": {
            "id": "721140704",
            "speakerId": 3162,
            "speakerName": "泽维尔",
            "text": "您过段时间再来找我吧…我们应该还有很多事要做。"
          }
        }
      }
    },
    {
      "subId": "7211408",
      "subQuestName": "",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "721140801"
        ],
        "dialogs": {
          "721140801": {
            "id": "721140801",
            "speakerId": 3162,
            "speakerName": "泽维尔",
            "text": "您回来了，刚才的动静可够大的，我的耳朵都被震痛了。",
            "nextDialogs": [
              "721140802"
            ]
          },
          "721140802": {
            "id": "721140802",
            "speakerId": 3162,
            "speakerName": "泽维尔",
            "text": "听到炮声后，愚人众们肯定会以为幕府的人发现他们的活动，然后疑神疑鬼。",
            "nextDialogs": [
              "721140803"
            ]
          },
          "721140803": {
            "id": "721140803",
            "speakerId": 3162,
            "speakerName": "泽维尔",
            "text": "不过，奇怪…为什么护罩被破坏了，「祟神」的能量却没有外泄…",
            "nextDialogs": [
              "721140804"
            ]
          },
          "721140804": {
            "id": "721140804",
            "speakerId": 3162,
            "speakerName": "泽维尔",
            "text": "难道「御影炉心」的部分系统还在运转，已经自己净化了一部分「祟神」能量？",
            "nextDialogs": [
              "721140805"
            ]
          },
          "721140805": {
            "id": "721140805",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "还是说…那些能量正在被愚人众搜集…",
            "nextDialogs": [
              "721140806"
            ]
          },
          "721140806": {
            "id": "721140806",
            "speakerId": 3162,
            "speakerName": "泽维尔",
            "text": "呃，不管怎么样，您就趁着这个时候，好好侦察一下…",
            "nextDialogs": [
              "721140807"
            ]
          },
          "721140807": {
            "id": "721140807",
            "speakerId": 3162,
            "speakerName": "泽维尔",
            "text": "小、小心！是愚人众！"
          }
        }
      }
    },
    {
      "subId": "7211410",
      "subQuestName": "向泽维尔回报",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "721140401"
        ],
        "dialogs": {
          "721140401": {
            "id": "721140401",
            "speakerId": 3162,
            "speakerName": "泽维尔",
            "text": "唔，看起来情况还算是稳定…",
            "nextDialogs": [
              "721140402"
            ]
          },
          "721140402": {
            "id": "721140402",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "是「御影炉心」的情况吗？",
            "nextDialogs": [
              "721140403"
            ]
          },
          "721140403": {
            "id": "721140403",
            "speakerId": 3162,
            "speakerName": "泽维尔",
            "text": "嗯，就我观察到的情况来看，内部淤积的「祟神」能量应该还不算太多。",
            "nextDialogs": [
              "721140404"
            ]
          },
          "721140404": {
            "id": "721140404",
            "speakerId": 3162,
            "speakerName": "泽维尔",
            "text": "当初依照指南启动护罩，其实主要还是为了防止有人误闯。毕竟，法律责任…",
            "nextDialogs": [
              "721140405"
            ]
          },
          "721140405": {
            "id": "721140405",
            "speakerId": 3162,
            "speakerName": "泽维尔",
            "text": "总而言之，要是内部的能量真的积累太多，那这护罩其实也派不上…",
            "nextDialogs": [
              "721140406"
            ]
          },
          "721140406": {
            "id": "721140406",
            "speakerId": 3162,
            "speakerName": "泽维尔",
            "text": "咳！咳咳…总之，现状很良好，不错不错。",
            "nextDialogs": [
              "721140407"
            ]
          },
          "721140407": {
            "id": "721140407",
            "speakerId": 3162,
            "speakerName": "泽维尔",
            "text": "这些细枝末节暂且不提，护罩的情况如何？",
            "nextDialogs": [
              "721140408"
            ]
          },
          "721140408": {
            "id": "721140408",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "有三道裂隙，周围还有愚人众。",
            "nextDialogs": [
              "721140409"
            ]
          },
          "721140409": {
            "id": "721140409",
            "speakerId": 3162,
            "speakerName": "泽维尔",
            "text": "裂隙…等等，愚、愚人众？这帮至冬人跑到这里来做什么？",
            "nextDialogs": [
              "721140411",
              "721140413"
            ]
          },
          "721140411": {
            "id": "721140411",
            "speakerId": 3162,
            "speakerName": "泽维尔",
            "text": "确实。但是，如果「御影炉心」的现状和愚人众有关的话，那事情就更复杂了…",
            "nextDialogs": [
              "721140414"
            ]
          },
          "721140414": {
            "id": "721140414",
            "speakerId": 3162,
            "speakerName": "泽维尔",
            "text": "呃啊——事情怎么会变成这样！",
            "nextDialogs": [
              "721140415"
            ]
          },
          "721140415": {
            "id": "721140415",
            "speakerId": 3162,
            "speakerName": "泽维尔",
            "text": "我不过就是一个普通的工程师，只是想留在这里搞点自己的研究，制作点「映影」，顺路体验体验稻妻充满魅力的风情…",
            "nextDialogs": [
              "721140416"
            ]
          },
          "721140416": {
            "id": "721140416",
            "speakerId": 3162,
            "speakerName": "泽维尔",
            "text": "为什么就…就被卷进了这种麻烦事里来！",
            "nextDialogs": [
              "721140417"
            ]
          },
          "721140417": {
            "id": "721140417",
            "speakerId": 3162,
            "speakerName": "泽维尔",
            "text": "本来这就是个简单的技术问题，到了那个士兵先生手上，莫名其妙地就变成了流程问题！",
            "nextDialogs": [
              "721140418"
            ]
          },
          "721140418": {
            "id": "721140418",
            "speakerId": 3162,
            "speakerName": "泽维尔",
            "text": "然后这个流程问题跑着跑着，突然又变成了「绝不允许外人插手」的稻妻内部事务责任归属问题。",
            "nextDialogs": [
              "721140419"
            ]
          },
          "721140419": {
            "id": "721140419",
            "speakerId": 3162,
            "speakerName": "泽维尔",
            "text": "到现在，又来了一帮愚人众，再这么下去，这个问题的性质马上又要变了！"
          },
          "721140413": {
            "id": "721140413",
            "speakerId": 3162,
            "speakerName": "泽维尔",
            "text": "会、会吗？如果真是这样的话，那事情就更复杂了…"
          }
        }
      }
    },
    {
      "subId": "7211411",
      "subQuestName": "启动「神居岛崩炮」击破裂隙",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [],
        "dialogs": {}
      }
    },
    {
      "subId": "7211412",
      "subQuestName": "启动「神居岛崩炮」击破裂隙",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "721141201"
        ],
        "dialogs": {
          "721141201": {
            "id": "721141201",
            "speakerId": 3162,
            "speakerName": "泽维尔",
            "text": "愚人众…到底在这里做什么呢……",
            "nextDialogs": [
              "721141203",
              "721141207",
              "721141216"
            ]
          },
          "721141203": {
            "id": "721141203",
            "speakerId": 3162,
            "speakerName": "泽维尔",
            "text": "我是随着技术顾问团来的稻妻，我在顾问团里其实就是一个普通的工程师。",
            "nextDialogs": [
              "721141204"
            ]
          },
          "721141204": {
            "id": "721141204",
            "speakerId": 3162,
            "speakerName": "泽维尔",
            "text": "说实话，其实我之所以会随团来，就是想要制作一部有关于「御影炉心」的「记录映影」，用来宣传祖国的技术。",
            "nextDialogs": [
              "721141205"
            ]
          },
          "721141205": {
            "id": "721141205",
            "speakerId": 3162,
            "speakerName": "泽维尔",
            "text": "但「御影炉心」成了现在这样，我看还是别制作比较好…"
          },
          "721141207": {
            "id": "721141207",
            "speakerId": 3162,
            "speakerName": "泽维尔",
            "text": "#{PLAYERAVATAR#SEXPRO[INFO_MALE_PRONOUN_BOYC|INFO_FEMALE_PRONOUN_GIRLC]}，这是个好问题！",
            "nextDialogs": [
              "721141208"
            ]
          },
          "721141208": {
            "id": "721141208",
            "speakerId": 3162,
            "speakerName": "泽维尔",
            "text": "我时常质问自己，仅仅凭借我贫乏的知识与词汇，要如何才能向他人传达我美丽的故乡…的魅力呢？",
            "nextDialogs": [
              "721141209"
            ]
          },
          "721141209": {
            "id": "721141209",
            "speakerId": 3162,
            "speakerName": "泽维尔",
            "text": "我首先应该向您描述什么呢？",
            "nextDialogs": [
              "721141210"
            ]
          },
          "721141210": {
            "id": "721141210",
            "speakerId": 3162,
            "speakerName": "泽维尔",
            "text": "譬如说，我在佩特莉可的书斋工作时，抬眼望向窗外——那永不停歇的瀑布，洗涤着我心灵中的每一寸皱褶。",
            "nextDialogs": [
              "721141211"
            ]
          },
          "721141211": {
            "id": "721141211",
            "speakerId": 3162,
            "speakerName": "泽维尔",
            "text": "还是说，我应当从枫丹廷说起：当我走在枫丹廷的街道上，如同云朵一般轻盈的淑女，从我的两边穿过…",
            "nextDialogs": [
              "721141212"
            ]
          },
          "721141212": {
            "id": "721141212",
            "speakerId": 3162,
            "speakerName": "泽维尔",
            "text": "抑或是如同镜面一般的湖泊中，倒映着的星空与月亮；当我走在水边时，就如同走在天上…",
            "nextDialogs": [
              "721141213"
            ]
          },
          "721141213": {
            "id": "721141213",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "你可真爱枫丹…",
            "nextDialogs": [
              "721141214"
            ]
          },
          "721141214": {
            "id": "721141214",
            "speakerId": 3162,
            "speakerName": "泽维尔",
            "text": "那是当然，将来或许有一天，我能得到令自己满意的答案。等到那时，我再向您慢慢讲述枫丹的美好吧！"
          },
          "721141216": {
            "id": "721141216",
            "speakerId": 3162,
            "speakerName": "泽维尔",
            "text": "噢，那个啊，是我研究「留影机」的时候做出的小成果。",
            "nextDialogs": [
              "721141217"
            ]
          },
          "721141217": {
            "id": "721141217",
            "speakerId": 3162,
            "speakerName": "泽维尔",
            "text": "我把「留影机」略微做出了些改良，做出了一种「映影机」，让它可以连续播放画片，产生会动的图像。",
            "nextDialogs": [
              "721141218"
            ]
          },
          "721141218": {
            "id": "721141218",
            "speakerId": 3162,
            "speakerName": "泽维尔",
            "text": "这项技术还很初级，也不完善，所以我还没有正式提交专利申请书。当然啦，现在这个情况我也没法去提交…",
            "nextDialogs": [
              "721141219"
            ]
          },
          "721141219": {
            "id": "721141219",
            "speakerId": 3162,
            "speakerName": "泽维尔",
            "text": "但我在离开枫丹之前，就听说我的某些同行似乎也对这种连续播放画片的技术很感兴趣…唉，我现在只能希望这群好先生们的动作别太快了…"
          }
        }
      }
    },
    {
      "subId": "7211413",
      "subQuestName": "启动「神居岛崩炮」击破裂隙",
      "sceneId": null,
      "locations": [],

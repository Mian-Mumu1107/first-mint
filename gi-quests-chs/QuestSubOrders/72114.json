    {
      "subId": "7211415",
      "subQuestName": "",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "721141501"
        ],
        "dialogs": {
          "721141501": {
            "id": "721141501",
            "speakerId": 3162,
            "speakerName": "泽维尔",
            "text": "请您去看看周围的情况吧。我总感觉，这些异常的读数…和「御影炉心」现在的情况有关。"
          }
        }
      }
    },
    {
      "subId": "7211416",
      "subQuestName": "向泽维尔回报",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [],
        "dialogs": {}
      }
    },
    {
      "subId": "7211417",
      "subQuestName": "打倒来袭的愚人众",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "721141701"
        ],
        "dialogs": {
          "721141701": {
            "id": "721141701",
            "speakerId": 3185,
            "speakerName": "虎之助",
            "text": "你有什么事吗？",
            "nextDialogs": [
              "721141702"
            ]
          },
          "721141702": {
            "id": "721141702",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "你们说的「御影炉心」、「祟神」到底是…",
            "nextDialogs": [
              "721141703"
            ]
          },
          "721141703": {
            "id": "721141703",
            "speakerId": 3185,
            "speakerName": "虎之助",
            "text": "…只是一些需要花点时间解决的小问题。",
            "nextDialogs": [
              "721141704"
            ]
          },
          "721141704": {
            "id": "721141704",
            "speakerId": 3185,
            "speakerName": "虎之助",
            "text": "你是冒险者吧。这里不适合你「冒险」，赶快回去吧。"
          }
        }
      }
    },
    {
      "subId": "7211418",
      "subQuestName": "与泽维尔对话",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "721140503"
        ],
        "dialogs": {
          "721140503": {
            "id": "721140503",
            "speakerId": 3162,
            "speakerName": "泽维尔",
            "text": "这帮家伙怎么敢直接…",
            "nextDialogs": [
              "721140505"
            ]
          },
          "721140505": {
            "id": "721140505",
            "speakerId": 3162,
            "speakerName": "泽维尔",
            "text": "居然完全不忌惮法律，真是令人…",
            "nextDialogs": [
              "721140506"
            ]
          },
          "721140506": {
            "id": "721140506",
            "speakerId": 3162,
            "speakerName": "泽维尔",
            "text": "…非常地…想要与之保持距离，咳。",
            "nextDialogs": [
              "721140508"
            ]
          },
          "721140508": {
            "id": "721140508",
            "speakerId": 3162,
            "speakerName": "泽维尔",
            "text": "看来他们的目标，确实就是「御影炉心」中的「祟神」能量。",
            "nextDialogs": [
              "721140509"
            ]
          },
          "721140509": {
            "id": "721140509",
            "speakerId": 3162,
            "speakerName": "泽维尔",
            "text": "趁着大部分愚人众被这动静吸引住注意力的功夫，请您快去里面，看看「御影炉心」里存储装置的状况吧。",
            "nextDialogs": [
              "721140510"
            ]
          },
          "721140510": {
            "id": "721140510",
            "speakerId": 3162,
            "speakerName": "泽维尔",
            "text": "如果遇见了愚人众的话…就请您直接出手吧。",
            "nextDialogs": [
              "721140511"
            ]
          },
          "721140511": {
            "id": "721140511",
            "speakerId": 3162,
            "speakerName": "泽维尔",
            "text": "我相信，您一定身手不凡。"
          }
        }
      }
    },
    {
      "subId": "7211419",
      "subQuestName": "接近「御影炉心」",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "721141901"
        ],
        "dialogs": {

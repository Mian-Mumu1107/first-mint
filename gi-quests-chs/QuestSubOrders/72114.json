          "721142001"
        ],
        "dialogs": {
          "721142001": {
            "id": "721142001",
            "speakerId": 3163,
            "speakerName": "阿幸",
            "text": "真是的…事情怎么会变成这样…",
            "nextDialogs": [
              "721142002"
            ]
          },
          "721142002": {
            "id": "721142002",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "刚才你们说的「御影炉心」到底是…",
            "nextDialogs": [
              "721142003"
            ]
          },
          "721142003": {
            "id": "721142003",
            "speakerId": 3163,
            "speakerName": "阿幸",
            "text": "是你啊，旅行者。在这样的时期来到踏鞴砂，运气还真是不好…",
            "nextDialogs": [
              "721142004"
            ]
          },
          "721142004": {
            "id": "721142004",
            "speakerId": 3163,
            "speakerName": "阿幸",
            "text": "那座岛叫「踏鞴砂」，是生产锻造武器用的「玉钢」的冶炼厂。",
            "nextDialogs": [
              "721142005"
            ]
          },
          "721142005": {
            "id": "721142005",
            "speakerId": 3163,
            "speakerName": "阿幸",
            "text": "对了，既然你是外国人，应该听过稻妻刀剑的传说吧？",
            "nextDialogs": [
              "721142006"
            ]
          },
          "721142006": {
            "id": "721142006",
            "speakerId": 3163,
            "speakerName": "阿幸",
            "text": "正是因为这里生产的「玉钢」，稻妻的刀剑才会如此锋利、坚硬。",
            "nextDialogs": [
              "721142008",
              "721142010"
            ]
          },
          "721142008": {
            "id": "721142008",
            "speakerId": 3163,
            "speakerName": "阿幸",
            "text": "不用紧张，谈不上什么军事机密。",
            "nextDialogs": [
              "721142011"
            ]
          },
          "721142011": {
            "id": "721142011",
            "speakerId": 3163,
            "speakerName": "阿幸",
            "text": "毕竟，在天领奉行看来，能够锻造强力的武器也是一种值得夸耀的实力。",
            "nextDialogs": [
              "721142012"
            ]
          },
          "721142012": {
            "id": "721142012",
            "speakerId": 3163,
            "speakerName": "阿幸",
            "text": "前几年，为了扩大生产的规模，他们从枫丹请了一支顾问团队，建造了能充分利用「祟神」力量的「御影炉心」。",
            "nextDialogs": [
              "721142013"
            ]
          },
          "721142013": {
            "id": "721142013",
            "speakerId": 3163,
            "speakerName": "阿幸",
            "text": "虽然我们也多次提醒他们，不能对「祟神」掉以轻心。但他们还是打定了主意，依然推进着建造计划。",
            "nextDialogs": [
              "721142014"
            ]
          },
          "721142014": {
            "id": "721142014",
            "speakerId": 3163,
            "speakerName": "阿幸",
            "text": "「御影炉心」投产后，顾问团的成员大部分都回国了，只有刚刚提到的泽维尔还留在稻妻。",
            "nextDialogs": [
              "721142015"
            ]
          },
          "721142015": {
            "id": "721142015",
            "speakerId": 3163,
            "speakerName": "阿幸",
            "text": "但在前段时间的战事中，「御影炉心」似乎出了什么问题，存储「祟神」的部分变得十分不稳定…",
            "nextDialogs": [
              "721142016"
            ]
          },
          "721142016": {
            "id": "721142016",
            "speakerId": 3163,
            "speakerName": "阿幸",
            "text": "在那之后，踏鞴砂就停工了，里面的人也被疏散了。",
            "nextDialogs": [
              "721142017"
            ]
          },
          "721142017": {
            "id": "721142017",
            "speakerId": 3163,
            "speakerName": "阿幸",
            "text": "泽维尔进行了紧急处理，据说，他在「御影炉心」周围已经布置好了护罩。",
            "nextDialogs": [
              "721142018"
            ]
          },
          "721142018": {
            "id": "721142018",
            "speakerId": 3163,
            "speakerName": "阿幸",
            "text": "但这样做也不是长久之计。他应该还在岛上，研究彻底解决问题的方法。",
            "nextDialogs": [
              "721142019"
            ]
          },
          "721142019": {
            "id": "721142019",
            "speakerId": 3163,
            "speakerName": "阿幸",
            "text": "不过，幕府那边似乎还在一门心思地想着复产。我听说，他们甚至打算再次邀请枫丹顾问。",
            "nextDialogs": [
              "721142020"
            ]
          },
          "721142020": {
            "id": "721142020",
            "speakerId": 3163,
            "speakerName": "阿幸",
            "text": "但是，以稻妻现在这个情况，他们应该不太会愿意来吧…",
            "nextDialogs": [
              "721142021"
            ]
          },
          "721142021": {
            "id": "721142021",
            "speakerId": 3163,
            "speakerName": "阿幸",
            "text": "而且，负责管理这件事的居然还是那个范兵卫…",
            "nextDialogs": [
              "721142022"
            ]
          },
          "721142022": {
            "id": "721142022",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "范兵卫是…",
            "nextDialogs": [
              "721142023"
            ]
          },
          "721142023": {
            "id": "721142023",
            "speakerId": 3163,
            "speakerName": "阿幸",
            "text": "一个…管事的人，成天都念叨着流程、条文，申请之类的话。",
            "nextDialogs": [
              "721142024"
            ]
          },
          "721142024": {
            "id": "721142024",
            "speakerId": 3163,
            "speakerName": "阿幸",
            "text": "无论是办什么事，第一反应不是找到解决方法，而是应该递交什么文书，和城里的哪位大人预先知会一声。",
            "nextDialogs": [
              "721142025"
            ]
          },
          "721142025": {
            "id": "721142025",
            "speakerId": 3163,
            "speakerName": "阿幸",
            "text": "现在，他应该去了城里，准备把能递交的文书全部递交一遍吧。",
            "nextDialogs": [
              "721142026"
            ]
          },
          "721142026": {
            "id": "721142026",
            "speakerId": 3163,
            "speakerName": "阿幸",
            "text": "真是不知道，这…个人到底意没意识到「御影炉心」的问题到底有多严重。",
            "nextDialogs": [
              "721142027"
            ]
          },
          "721142027": {
            "id": "721142027",
            "speakerId": 3163,
            "speakerName": "阿幸",
            "text": "唉…只能希望我们的工匠，或者泽维尔先生能有什么解决的办法了。",
            "nextDialogs": [
              "721142028"
            ]
          },
          "721142028": {
            "id": "721142028",
            "speakerId": 3163,
            "speakerName": "阿幸",
            "text": "如果「御影炉心」里的「祟神」出了什么问题的话…",
            "nextDialogs": [
              "721142029"
            ]
          },
          "721142029": {
            "id": "721142029",
            "speakerId": 3163,
            "speakerName": "阿幸",
            "text": "…只能说，你趁早离开这座岛吧。"
          },
          "721142010": {
            "id": "721142010",
            "speakerId": 3163,
            "speakerName": "阿幸",
            "text": "也没有机密到这个地步。"
          }
        }
      }
    },
    {
      "subId": "7211421",
      "subQuestName": "向泽维尔回报",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "721142101"
        ],
        "dialogs": {
          "721142101": {
            "id": "721142101",
            "speakerId": 3162,
            "speakerName": "泽维尔",
            "text": "已经没办法了…",
            "nextDialogs": [
              "721142102"
            ]
          },
          "721142102": {
            "id": "721142102",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "你遇见什么麻烦了吗？",
            "nextDialogs": [
              "721142103"
            ]
          },
          "721142103": {
            "id": "721142103",
            "speakerId": 3162,
            "speakerName": "泽维尔",
            "text": "#{NICKNAME}，没想到咱们还能在这个地方再次相会，真是奇妙！",
            "nextDialogs": [
              "721142104"
            ]
          },
          "721142104": {
            "id": "721142104",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "我是来帮忙的。",
            "nextDialogs": [
              "721142105"
            ]
          },
          "721142105": {
            "id": "721142105",
            "speakerId": 3162,
            "speakerName": "泽维尔",
            "text": "#帮忙？啊…我对您的好心万分感激，能在此时此地遇上您这样的{M#好先生}{F#好女士}，真称得上是神明恩眷了。",
            "nextDialogs": [
              "721142106"
            ]
          },
          "721142106": {
            "id": "721142106",
            "speakerId": 3162,
            "speakerName": "泽维尔",
            "text": "但恕我直言，就我当前面对的问题来说…即使您瞧着就身手不凡，应该也帮不上我的忙…",
            "nextDialogs": [
              "721142107"
            ]
          },
          "721142107": {
            "id": "721142107",
            "speakerId": 3162,
            "speakerName": "泽维尔",
            "text": "毕竟，咱俩就算有两副好心肠，也远远没法堵上「御影炉心」的缺啊…",
            "nextDialogs": [
              "721142108"
            ]
          },
          "721142108": {
            "id": "721142108",
            "speakerId": 3162,
            "speakerName": "泽维尔",
            "text": "您来的时候应该见到了一个…气泡一样的罩子吧。",
            "nextDialogs": [
              "721142109"
            ]
          },
          "721142109": {
            "id": "721142109",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "没有。",
            "nextDialogs": [
              "721142110"
            ]
          },
          "721142110": {
            "id": "721142110",
            "speakerId": 3162,
            "speakerName": "泽维尔",
            "text": "呃…好吧，这也正常，反正那个护罩一般也看不见，想要在远处看见的话，还得用什么特殊的观测方式…",
            "nextDialogs": [
              "721142113"
            ]
          },
          "721142113": {
            "id": "721142113",
            "speakerId": 3162,
            "speakerName": "泽维尔",
            "text": "我并不是用我的眼睛看见的。而是用这一本《御影炉心·应急处理流程指南试行版》…「看见」的。",
            "nextDialogs": [
              "721142114"
            ]
          },
          "721142114": {
            "id": "721142114",
            "speakerId": 3162,
            "speakerName": "泽维尔",
            "text": "我已经按照上面的步骤操作完毕，仪器读数显示，护罩应该也已经顺利启动了。",
            "nextDialogs": [
              "721142115"
            ]
          },
          "721142115": {
            "id": "721142115",
            "speakerId": 3162,
            "speakerName": "泽维尔",
            "text": "啊，值得一提的是，这护罩的正式名是「御影炉心专用应急阻隔护罩」。",
            "nextDialogs": [
              "721142116"
            ]
          },
          "721142116": {
            "id": "721142116",
            "speakerId": 3162,
            "speakerName": "泽维尔",
            "text": "而「御影炉心」，则是…",
            "nextDialogs": [
              "721142117"
            ]
          },
          "721142117": {
            "id": "721142117",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "阿幸小姐介绍过了。",
            "nextDialogs": [
              "721142118"
            ]
          },
          "721142118": {
            "id": "721142118",
            "speakerId": 3162,
            "speakerName": "泽维尔",
            "text": "甚好！能与阿幸小姐这样善解人意又坚强的淑女相识，真是一件幸事。",
            "nextDialogs": [
              "721142119"
            ]
          },
          "721142119": {
            "id": "721142119",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "请你长话短说。",
            "nextDialogs": [
              "721142120"
            ]
          },
          "721142120": {
            "id": "721142120",
            "speakerId": 3162,
            "speakerName": "泽维尔",
            "text": "…简单来说，是以枫丹技术建造，以八酝岛运来的「祟神」核心驱动的超级冶炼炉。",
            "nextDialogs": [
              "721142121"
            ]
          },
          "721142121": {
            "id": "721142121",
            "speakerId": 3162,
            "speakerName": "泽维尔",
            "text": "大概是因为战事波及，目前御影炉心正处于一个极不稳定的状态…",
            "nextDialogs": [
              "721142122"
            ]
          },
          "721142122": {
            "id": "721142122",
            "speakerId": 3162,
            "speakerName": "泽维尔",
            "text": "无论如何，我依照《御影炉心·应急处理流程指南试行版》的步骤启动了封锁护罩，姑且在一定程度上做了处理…",
            "nextDialogs": [
              "721142123"
            ]
          },
          "721142123": {
            "id": "721142123",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "「一定程度上」？",
            "nextDialogs": [
              "721142124"
            ]
          },
          "721142124": {
            "id": "721142124",
            "speakerId": 3162,
            "speakerName": "泽维尔",
            "text": "毕竟，即使厚达893页，《指南试行版》中也没有记录在战争情况下应当采取的应急措施…",
            "nextDialogs": [
              "721142125"
            ]
          },
          "721142125": {
            "id": "721142125",
            "speakerId": 3162,
            "speakerName": "泽维尔",
            "text": "下次要组织《指南试行版·第一次增补》编辑组，仔细研讨更多意外情况才行…",
            "nextDialogs": [
              "721142126"
            ]
          },
          "721142126": {
            "id": "721142126",
            "speakerId": 3162,
            "speakerName": "泽维尔",
            "text": "总而言之，虽然我采取了应急措施，但这些措施还是不太完善…护罩中的环境也变得有些…呃…不太理想。",
            "nextDialogs": [
              "721142127"
            ]
          },
          "721142127": {
            "id": "721142127",
            "speakerId": 3162,
            "speakerName": "泽维尔",
            "text": "现在「御影炉心」无限期停工，那位士兵先生为此可是十分恼火。",
            "nextDialogs": [
              "721142128"
            ]
          },
          "721142128": {
            "id": "721142128",
            "speakerId": 3162,
            "speakerName": "泽维尔",
            "text": "而且之前，据说阿幸小姐还用士兵先生的人组织了平民的疏散工作，他好像更恼火了，哈哈哈…",
            "nextDialogs": [
              "721142129"
            ]
          },
          "721142129": {
            "id": "721142129",
            "speakerId": 3162,
            "speakerName": "泽维尔",
            "text": "但如果这么持续下去的话，或许踏鞴砂会变成在我的故乡，美丽的佩特莉可镇也能看见的绚烂烟花吧…"
          }
        }
      }
    },

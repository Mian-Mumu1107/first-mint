      "subId": "7351701",
      "subQuestName": "与两位学者对话",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "735170101"
        ],
        "dialogs": {
          "735170101": {
            "id": "735170101",
            "speakerId": 1000,
            "speakerName": "维纳亚克",
            "text": "…所以就结论来说，还是要靠「对沙虫用杀虫炮」来消灭它们对吧？",
            "nextDialogs": [
              "735170102"
            ]
          },
          "735170102": {
            "id": "735170102",
            "speakerId": 1001,
            "speakerName": "施芮娅",
            "text": "这根本就不能同日而语！不要摆出那副「早听我的不就得了」的表情！",
            "nextDialogs": [
              "735170105"
            ]
          },
          "735170105": {
            "id": "735170105",
            "speakerId": 1001,
            "speakerName": "施芮娅",
            "text": "#啊，冒险家{M#先生}{F#小姐}！您听我说，我已经找出这起事件的原因了！",
            "nextDialogs": [
              "735170106"
            ]
          },
          "735170106": {
            "id": "735170106",
            "speakerId": 1001,
            "speakerName": "施芮娅",
            "text": "——是沙虫在地下的活动频繁，导致了这片区域内元素能量的紊乱。",
            "nextDialogs": [
              "735170107"
            ]
          },
          "735170107": {
            "id": "735170107",
            "speakerId": 1001,
            "speakerName": "施芮娅",
            "text": "而庞杂的能量又反过来影响了沙虫的习性，使得它们开始在地表上四处作乱，进一步加剧了环境的失衡。",
            "nextDialogs": [
              "735170108"
            ]
          },
          "735170108": {
            "id": "735170108",
            "speakerId": 1001,
            "speakerName": "施芮娅",
            "text": "「对沙虫用杀虫炮」充能装置的效率异常，也是环境中元素能量紊乱导致的。",
            "nextDialogs": [
              "735170109"
            ]
          },
          "735170109": {
            "id": "735170109",
            "speakerId": 1000,
            "speakerName": "维纳亚克",
            "text": "我就知道，我设计的机械，绝对不会这么轻易就出故障！",
            "nextDialogs": [
              "735170110"
            ]
          },
          "735170110": {
            "id": "735170110",
            "speakerId": 1002,
            "speakerName": "派蒙",
            "text": "没考虑到使用环境的问题，难道就不算设计问题吗…"
          }
        }
      }
    }
  ]
}
    {
      "subId": "7718501",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "771850101"
        ],
        "dialogs": {
          "771850101": {
            "id": "771850101",
            "speakerId": 1002,
            "speakerName": "安菲萨",
            "text": "嘿嘿…马上就可以用雪球堆雪人了，听起来就很好玩，老大！",
            "nextDialogs": [
              "771850102"
            ]
          },
          "771850102": {
            "id": "771850102",
            "speakerId": 1000,
            "speakerName": "米罗斯拉娃",
            "text": "这是件严肃的事情，安菲萨，我们需要合适大小的雪球，才能堆出最为完美的雪人——团队配合也要像堆雪人一样，精益求精。",
            "nextDialogs": [
              "771850103"
            ]
          },
          "771850103": {
            "id": "771850103",
            "speakerId": 1000,
            "speakerName": "米罗斯拉娃",
            "text": "不过，我们「野蛮熊」确实需要更多的人手了，至少，现在得找一个能制作完美雪球的人…"
          }
        }
      }
    },
    {
      "subId": "7718503",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "771850301"
        ],
        "dialogs": {
          "771850301": {
            "id": "771850301",
            "speakerId": 1000,
            "speakerName": "米罗斯拉娃",
            "text": "如此完美的雪球…只需要我稍加装饰——现在我将为这个雪人命名为「首领」，现在它是「野蛮熊」的重要成员了！",
            "nextDialogs": [
              "771850302"
            ]
          },
          "771850302": {
            "id": "771850302",
            "speakerId": 1000,
            "speakerName": "米罗斯拉娃",
            "text": "当然，现在还有两个雪人还亟待制作…现在你要继续尝试吗？"
          }
        }
      }
    },
    {
      "subId": "7718505",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "771850501"
        ],
        "dialogs": {
          "771850501": {
            "id": "771850501",
            "speakerId": 1000,
            "speakerName": "米罗斯拉娃",
            "text": "这个雪人就由克雷廖夫来装饰命名吧…雪人达到合格标准后，带点个人特色完全可以接受。",
            "nextDialogs": [
              "771850502"
            ]
          },
          "771850502": {
            "id": "771850502",
            "speakerId": 1001,
            "speakerName": "克雷廖夫",
            "text": "唔…我想好了，那它的名字就叫「克雷廖夫二号」。",
            "nextDialogs": [
              "771850503"
            ]
          },
          "771850503": {
            "id": "771850503",
            "speakerId": 1000,
            "speakerName": "米罗斯拉娃",
            "text": "呃啊，不错的想法，就差安菲萨的了，还请你继续帮帮忙。"
          }
        }
      }
    },

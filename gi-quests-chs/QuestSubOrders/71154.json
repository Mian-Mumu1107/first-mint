        ],
        "dialogs": {
          "711540802": {
            "id": "711540802",
            "speakerId": 1070,
            "speakerName": "夏洛蒂",
            "text": "拍完了？你校正镜头了没，光源也确定好了？焦距什么的也都搞定了？我看看…",
            "nextDialogs": [
              "711540803"
            ]
          },
          "711540803": {
            "id": "711540803",
            "speakerId": 1070,
            "speakerName": "夏洛蒂",
            "text": "呜哇，你还真的全部搞定了…拍得这么好，真厉害。",
            "nextDialogs": [
              "711540804"
            ]
          },
          "711540804": {
            "id": "711540804",
            "speakerId": 1070,
            "speakerName": "夏洛蒂",
            "text": "等我下次出去采访的时候，一定要把你叫上，我们一起留影，肯定能拍出不少好画片。",
            "nextDialogs": [
              "711540805",
              "711540808"
            ]
          },
          "711540805": {
            "id": "711540805",
            "speakerId": 1070,
            "speakerName": "夏洛蒂",
            "text": "我已经看到啦。我刚才为了留影，也放飞了好几盏霄灯呢。",
            "nextDialogs": [
              "711540806"
            ]
          },
          "711540806": {
            "id": "711540806",
            "speakerId": 1070,
            "speakerName": "夏洛蒂",
            "text": "心愿？啊…啊？！我光顾着留影，忘记写心愿了！不对不对，放飞那么多盏，许愿会不会不灵啊——"
          },
          "711540808": {
            "id": "711540808",
            "speakerId": 1070,
            "speakerName": "夏洛蒂",
            "text": "再见，你也要海灯节快乐啊！呃，这句话好像不太对…总之，要快快乐乐地玩喔。"
          }
        }
      }
    }
  ]

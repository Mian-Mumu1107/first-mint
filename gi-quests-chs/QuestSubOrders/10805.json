        "dialogs": {
          "698140101": {
            "id": "698140101",
            "speakerId": 1061,
            "speakerName": "迪奥娜",
            "text": "咻咻。",
            "nextDialogs": [
              "698140104"
            ]
          },
          "698140104": {
            "id": "698140104",
            "speakerId": 1061,
            "speakerName": "迪奥娜",
            "text": "哼，「凯茨莱茵家族」的猎手，就算独自出行也能圆满完成狩猎任务。",
            "nextDialogs": [
              "698140105"
            ]
          },
          "698140105": {
            "id": "698140105",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "可「咻咻」地喊不会惊动猎物吗？",
            "nextDialogs": [
              "698140106"
            ]
          },
          "698140106": {
            "id": "698140106",
            "speakerId": 1061,
            "speakerName": "迪奥娜",
            "text": "不…才不会啦！你没看到我的箭飞得比声音更快吗？",
            "nextDialogs": [
              "698140107"
            ]
          },
          "698140107": {
            "id": "698140107",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "原来「咻咻」只是为了可爱啊…",
            "nextDialogs": [
              "698140108"
            ]
          },
          "698140108": {
            "id": "698140108",
            "speakerId": 1061,
            "speakerName": "迪奥娜",
            "text": "好过分，就算你说得那么小声我也听见了！不要小看「凯茨莱茵家族」的耳朵！",
            "nextDialogs": [
              "698140109"
            ]
          },
          "698140109": {
            "id": "698140109",
            "speakerId": 1061,
            "speakerName": "迪奥娜",
            "text": "算了，不跟你计较。喏，这些兽肉给你。我抓太多了，带回去也是要跟大家一起分享的。"
          }
        }
      }
    }
  ]

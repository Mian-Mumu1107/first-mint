    {
      "subId": "7000702",
      "subQuestName": "去劝说约会者保持安静",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "700070201"
        ],
        "dialogs": {
          "700070201": {
            "id": "700070201",
            "speakerId": 10023,
            "speakerName": "热恋中的青年",
            "text": "真是感人的故事啊，可惜最后没有一个圆满的结局。",
            "nextDialogs": [
              "700070202"
            ]
          },
          "700070202": {
            "id": "700070202",
            "speakerId": 10024,
            "speakerName": "热恋中的少女",
            "text": "我们以后不会变成那样的，对吧？",
            "nextDialogs": [
              "700070203"
            ]
          },
          "700070203": {
            "id": "700070203",
            "speakerId": 10023,
            "speakerName": "热恋中的青年",
            "text": "那是当然的，就算我们天各一方，我也会想办法把你带回我的身边。",
            "nextDialogs": [
              "700070206"
            ]
          },
          "700070206": {
            "id": "700070206",
            "speakerId": 10024,
            "speakerName": "热恋中的少女",
            "text": "欸？我应该很克制我的声音了。",
            "nextDialogs": [
              "700070207"
            ]
          },
          "700070207": {
            "id": "700070207",
            "speakerId": 10023,
            "speakerName": "热恋中的青年",
            "text": "唉，或许这也是恋爱的阻碍吧…",
            "nextDialogs": [
              "700070208"
            ]
          },
          "700070208": {
            "id": "700070208",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "看过的故事书，也应该放回正确的地方。",
            "nextDialogs": [
              "700070209"
            ]
          },
          "700070209": {
            "id": "700070209",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "像现在这样随便乱放，负责整理书架的人会很头疼的。",
            "nextDialogs": [
              "700070210"
            ]
          },
          "700070210": {
            "id": "700070210",
            "speakerId": 10023,
            "speakerName": "热恋中的青年",
            "text": "知道了，知道了，请不要再打扰我们了，正在关键的时候呢。",
            "nextDialogs": [
              "700070211"
            ]
          },
          "700070211": {
            "id": "700070211",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "关键的时候…？",
            "nextDialogs": [
              "700070212"
            ]
          },
          "700070212": {
            "id": "700070212",
            "speakerId": 10024,
            "speakerName": "热恋中的少女",
            "text": "不管有多少阻碍，你都会像现在这样，永远不变吧？",
            "nextDialogs": [
              "700070213"
            ]
          },
          "700070213": {
            "id": "700070213",
            "speakerId": 10023,
            "speakerName": "热恋中的青年",
            "text": "是的，我以我的生命起誓。",
            "nextDialogs": [
              "700070214"
            ]
          },
          "700070214": {
            "id": "700070214",
            "speakerId": 10024,
            "speakerName": "热恋中的少女",
            "text": "也不用这么夸张…生命什么的，我会心疼的。",
            "nextDialogs": [
              "700070215"
            ]
          },
          "700070215": {
            "id": "700070215",
            "speakerId": 10023,
            "speakerName": "热恋中的青年",
            "text": "啊，就是你这样的温柔，令人沉醉…",
            "nextDialogs": [
              "700070216"
            ]
          },
          "700070216": {
            "id": "700070216",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "我觉得，他们完全没听进去。"
          }
        }
      }
    },
    {
      "subId": "7000703",
      "subQuestName": "去劝说约会者保持安静",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "700070301"
        ],
        "dialogs": {
          "700070301": {
            "id": "700070301",
            "speakerId": 10026,
            "speakerName": "陷入爱河的女性",
            "text": "嗯？请问有是什么事吗？",
            "nextDialogs": [
              "700070304"
            ]
          },
          "700070304": {
            "id": "700070304",
            "speakerId": 10026,
            "speakerName": "陷入爱河的女性",
            "text": "抱歉，我会注意的，但有时候，这都属于不可抗力。",
            "nextDialogs": [
              "700070305"
            ]
          },
          "700070305": {
            "id": "700070305",
            "speakerId": 10025,
            "speakerName": "变魔术的男性",
            "text": "比如，在你没注意到的时候，我从书页的背后取出了一朵玫瑰。",
            "nextDialogs": [
              "700070306"
            ]
          },
          "700070306": {
            "id": "700070306",
            "speakerId": 10025,
            "speakerName": "变魔术的男性",
            "text": "从书中诞生的玫瑰，就像你一样，充满了温柔和知性美…",
            "nextDialogs": [
              "700070307"
            ]
          },
          "700070307": {
            "id": "700070307",
            "speakerId": 10026,
            "speakerName": "陷入爱河的女性",
            "text": "哇？！好厉害！",
            "nextDialogs": [
              "700070308"
            ]
          },
          "700070308": {
            "id": "700070308",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "声音太大了！还有，不能用书本来变魔术！会折坏的！",
            "nextDialogs": [
              "700070309"
            ]
          },
          "700070309": {
            "id": "700070309",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "派蒙你的声音也大起来了…",
            "nextDialogs": [
              "700070310"
            ]
          },
          "700070310": {
            "id": "700070310",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "哦，对不起，一不小心就…",
            "nextDialogs": [
              "700070311"
            ]
          },
          "700070311": {
            "id": "700070311",
            "speakerId": 10026,
            "speakerName": "陷入爱河的女性",
            "text": "你也明白了吧，有时候这就是不可抗力。",
            "nextDialogs": [
              "700070312"
            ]
          },
          "700070312": {
            "id": "700070312",
            "speakerId": 10026,
            "speakerName": "陷入爱河的女性",
            "text": "我会注意控制我的声音的，实在不好意思。",
            "nextDialogs": [
              "700070313"
            ]
          },
          "700070313": {
            "id": "700070313",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "看起来，他们完全没听进去呢…"
          }
        }
      }
    },
    {
      "subId": "7000704",
      "subQuestName": "去劝说约会者保持安静",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "700070401"
        ],
        "dialogs": {
          "700070401": {
            "id": "700070401",
            "speakerId": 10028,
            "speakerName": "看似理性的女性",
            "text": "你所主张的「情感波动会影响研究分析的准确性」，还是没有确切的论据。",
            "nextDialogs": [
              "700070402"
            ]
          },
          "700070402": {
            "id": "700070402",
            "speakerId": 10027,
            "speakerName": "看似理性的男性",
            "text": "唉，我明白，我现在可能是陷入了一种奇怪的瓶颈…",
            "nextDialogs": [
              "700070403"
            ]
          },
          "700070403": {
            "id": "700070403",
            "speakerId": 10027,
            "speakerName": "看似理性的男性",
            "text": "你们来得正好，我有一个困扰需要听听看外人的意见。",
            "nextDialogs": [
              "700070404"
            ]
          },
          "700070404": {
            "id": "700070404",
            "speakerId": 10027,
            "speakerName": "看似理性的男性",
            "text": "如果我要证明我理论的正确性，就要保证我没有情感的波动。",
            "nextDialogs": [
              "700070405"
            ]
          },
          "700070405": {
            "id": "700070405",
            "speakerId": 10027,
            "speakerName": "看似理性的男性",
            "text": "但我总是做不到这件事，尤其是和她在讨论的时候，我总是不能冷静下来好好思考。",
            "nextDialogs": [
              "700070406"
            ]
          },
          "700070406": {
            "id": "700070406",
            "speakerId": 10028,
            "speakerName": "看似理性的女性",
            "text": "我也觉得有点奇怪，难道是睡眠不足吗？还是昨天酒精摄入过头了呢？",
            "nextDialogs": [
              "700070408"
            ]
          },
          "700070408": {
            "id": "700070408",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "总之，先压低音量吧。",
            "nextDialogs": [
              "700070409"
            ]
          },
          "700070409": {
            "id": "700070409",
            "speakerId": 10027,
            "speakerName": "看似理性的男性",
            "text": "抱歉，但在弄明白这件事之前，我就是不甘心。",
            "nextDialogs": [
              "700070410"
            ]
          },
          "700070410": {
            "id": "700070410",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "完、完全听不明白…",
            "nextDialogs": [
              "700070411"
            ]
          },
          "700070411": {
            "id": "700070411",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "呃，总之，不能打扰别人，还有，看过的书不能倒着塞进书架！",
            "nextDialogs": [
              "700070412"
            ]
          },
          "700070412": {
            "id": "700070412",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "好吧…他们好像不搭理我们了…"
          }
        }
      }
    },

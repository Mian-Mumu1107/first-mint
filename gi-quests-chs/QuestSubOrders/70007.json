  "subQuests": [
    {
      "subId": "7000701",
      "subQuestName": "(test)接取任务用隐藏任务$HIDDEN",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "700070101"
        ],
        "dialogs": {
          "700070101": {
            "id": "700070101",
            "speakerId": 1565,
            "speakerName": "艾拉·马斯克",
            "text": "Ye ika gusha mosi！",
            "nextDialogs": [
              "700070104"
            ]
          },
          "700070104": {
            "id": "700070104",
            "speakerId": 1565,
            "speakerName": "艾拉·马斯克",
            "text": "不好意思，因为最近图书馆实在非常吵闹，我很难安静下来研究丘丘人语。",
            "nextDialogs": [
              "700070105"
            ]
          },
          "700070105": {
            "id": "700070105",
            "speakerId": 1565,
            "speakerName": "艾拉·马斯克",
            "text": "风花节开始之后，有很多人到这里来约会。他们一开始还能保持安静地看看书，后来就聊起来了。",
            "nextDialogs": [
              "700070106"
            ]
          },
          "700070106": {
            "id": "700070106",
            "speakerId": 1565,
            "speakerName": "艾拉·马斯克",
            "text": "而且…而且他们还做了各种可怕的事…",
            "nextDialogs": [
              "700070107"
            ]
          },
          "700070107": {
            "id": "700070107",
            "speakerId": 1565,
            "speakerName": "艾拉·马斯克",
            "text": "把书的书角折坏…在书页里塞各种奇奇怪怪的东西…甚至、甚至他们还把书倒着插进书架！",
            "nextDialogs": [
              "700070108"
            ]
          },
          "700070108": {
            "id": "700070108",
            "speakerId": 1565,
            "speakerName": "艾拉·马斯克",
            "text": "图书馆可不是谈情说爱的地方！这样只会打扰到真正在这里看书做研究的人！"
          }
        }
      }
    },
    {
      "subId": "7000712",

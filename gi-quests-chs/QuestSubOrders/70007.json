    {
      "subId": "7000707",
      "subQuestName": "与派蒙商量对策",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "700070701"
        ],
        "dialogs": {
          "700070701": {
            "id": "700070701",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "唉，好像没人听我们的劝告。",
            "nextDialogs": [
              "700070702"
            ]
          },
          "700070702": {
            "id": "700070702",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "他们的用书习惯都不太好，我们只能去找威拉格商量一下了。"
          }
        }
      }
    },
    {
      "subId": "7000708",
      "subQuestName": "与威拉格交谈",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "700070801"
        ],
        "dialogs": {
          "700070801": {
            "id": "700070801",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "关于图书馆的吵闹声…",
            "nextDialogs": [
              "700070802"
            ]
          },
          "700070802": {
            "id": "700070802",
            "speakerId": 1648,
            "speakerName": "威拉格",
            "text": "原来如此，那应该可以用「那个办法」了。",
            "nextDialogs": [
              "700070803"
            ]
          },
          "700070803": {
            "id": "700070803",
            "speakerId": 1648,
            "speakerName": "威拉格",
            "text": "丽莎小姐说过，如果有人违反了图书馆的规定，就必须要受到惩罚…",
            "nextDialogs": [
              "700070804"
            ]
          },
          "700070804": {
            "id": "700070804",
            "speakerId": 1648,
            "speakerName": "威拉格",
            "text": "麻烦你们去图书馆里，传达一下丽莎小姐的意思吧。",
            "nextDialogs": [
              "700070805"
            ]
          },
          "700070805": {
            "id": "700070805",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "折坏书页、塞玫瑰花进书里、把书倒着插进书架…肯定算是违反了图书馆的规则吧。",
            "nextDialogs": [
              "700070806"
            ]
          },
          "700070806": {
            "id": "700070806",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "我们走，去向那些来图书馆却不读书的人传达一下丽莎小姐的意思吧。"
          }
        }
      }
    },
    {
      "subId": "7000709",
      "subQuestName": "传达丽莎小姐的意思",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [],
        "dialogs": {}
      }
    },
    {
      "subId": "7000710",
      "subQuestName": "(test)自动触发与派蒙的对话$HIDDEN",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "700071001"
        ],
        "dialogs": {
          "700071001": {
            "id": "700071001",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "欸——什么？丽莎小姐马上就要回来了？",
            "nextDialogs": [
              "700071002"
            ]
          },
          "700071002": {
            "id": "700071002",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "要是她知道，有人把书乱用乱放的话，还折页损坏，一定会很生气吧？",
            "nextDialogs": [
              "700071003"
            ]
          },
          "700071003": {
            "id": "700071003",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "是啊，怎么办呢，真是糟糕啊。",
            "nextDialogs": [
              "700071004"
            ]
          },
          "700071004": {
            "id": "700071004",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "要怎么办呢？如果现在开始收拾，还有机会补救吧？",
            "nextDialogs": [
              "700071005"
            ]
          },
          "700071005": {
            "id": "700071005",
            "speakerId": 1565,
            "speakerName": "艾拉·马斯克",
            "text": "没想到你们能想到这么好的办法。",
            "nextDialogs": [
              "700071006"
            ]
          },
          "700071006": {
            "id": "700071006",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "都是威拉格的主意…",
            "nextDialogs": [
              "700071007"
            ]
          },
          "700071007": {
            "id": "700071007",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "还是多亏了丽莎小姐…",
            "nextDialogs": [
              "700071008"
            ]
          },
          "700071008": {
            "id": "700071008",
            "speakerId": 1565,
            "speakerName": "艾拉·马斯克",
            "text": "不过要是丽莎小姐看到刚刚的场面，确实会生气吧，这可是图书馆，是学习的地方。",
            "nextDialogs": [
              "700071009"
            ]
          },
          "700071009": {
            "id": "700071009",
            "speakerId": 1565,
            "speakerName": "艾拉·马斯克",
            "text": "我终于可以安心做研究了，这是给你们的报酬，谢谢你们。"
          }
        }
      }
    },

  "subQuests": [
    {
      "subId": "7050201",
      "subQuestName": "与卢卡对话",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "705020116"
        ],
        "dialogs": {
          "705020116": {
            "id": "705020116",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "好吧，那就试试。",
            "nextDialogs": [
              "705020117"
            ]
          },
          "705020117": {
            "id": "705020117",
            "speakerId": 30112,
            "speakerName": "卢卡",
            "text": "欢迎欢迎。请进，查尔斯先生会教你基本的调制手法。"
          }
        }
      }
    },
    {
      "subId": "7050202",
      "subQuestName": "和卢卡对话，进入酒馆",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "705020201"
        ],
        "dialogs": {
          "705020201": {
            "id": "705020201",
            "speakerId": 30114,
            "speakerName": "查尔斯",
            "text": "没想到是老面孔，今天想喝点儿什么？",
            "nextDialogs": [
              "705020202"
            ]
          },
          "705020202": {
            "id": "705020202",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "你好，查尔斯。",
            "nextDialogs": [
              "705020203"
            ]
          },
          "705020203": {
            "id": "705020203",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "查尔斯，我们是来当酒保的！",
            "nextDialogs": [
              "705020204"
            ]
          },
          "705020204": {
            "id": "705020204",
            "speakerId": 30114,
            "speakerName": "查尔斯",
            "text": "当酒保…啊，原来卢卡招揽到了你们吗，他运气真够好的。",
            "nextDialogs": [
              "705020205"
            ]
          },
          "705020205": {
            "id": "705020205",
            "speakerId": 30114,
            "speakerName": "查尔斯",
            "text": "#{NICKNAME}，我很信任你处理问题的能力，不过，调酒毕竟是个技术活，希望你不要掉以轻心。",
            "nextDialogs": [
              "705020206"
            ]
          },
          "705020206": {
            "id": "705020206",
            "speakerId": 30114,
            "speakerName": "查尔斯",
            "text": "原料的配比，混合的手法…都会影响出品的质量。",
            "nextDialogs": [
              "705020207"
            ]
          },
          "705020207": {
            "id": "705020207",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "#没事，{M#他}{F#她}做的菜可好吃了，美食的原理是相通的！",
            "nextDialogs": [
              "705020208"
            ]
          },
          "705020208": {
            "id": "705020208",
            "speakerId": 30114,
            "speakerName": "查尔斯",
            "text": "好，还有一件事…",
            "nextDialogs": [
              "705020209"
            ]
          },
          "705020209": {
            "id": "705020209",
            "speakerId": 30114,
            "speakerName": "查尔斯",
            "text": "之前活动中有位实习生，凭自己的理解混合了三种烈酒，结果一杯就灌倒了客人。",
            "nextDialogs": [
              "705020210"
            ]
          },
          "705020210": {
            "id": "705020210",
            "speakerId": 30114,
            "speakerName": "查尔斯",
            "text": "从那之后，我们就不敢再向新人提供含酒精的材料了，这点请你见谅。",
            "nextDialogs": [
              "705020211"
            ]
          },
          "705020211": {
            "id": "705020211",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "能够理解。",
            "nextDialogs": [
              "705020212"
            ]
          },
          "705020212": {
            "id": "705020212",
            "speakerId": 30114,
            "speakerName": "查尔斯",
            "text": "好，那就全部交待完了。手法和技巧，就在实际调制过程中教你吧。"
          }
        }
      }
    },

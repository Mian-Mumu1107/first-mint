    {
      "subId": "7050201",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "705020101"
        ],
        "dialogs": {
          "705020101": {
            "id": "705020101",
            "speakerId": 30112,
            "speakerName": "卢卡",
            "text": "你好，想必你就是那位大名鼎鼎的旅行者吧。",
            "nextDialogs": [
              "705020104"
            ]
          },
          "705020104": {
            "id": "705020104",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "喂，还有我呢，我是大名鼎鼎的派蒙！",
            "nextDialogs": [
              "705020105"
            ]
          },
          "705020105": {
            "id": "705020105",
            "speakerId": 30112,
            "speakerName": "卢卡",
            "text": "是这样的。最近「天使的馈赠」酒馆在举行「酒保体验周」的活动，我想你或许会感兴趣。",
            "nextDialogs": [
              "705020106"
            ]
          },
          "705020106": {
            "id": "705020106",
            "speakerId": 30112,
            "speakerName": "卢卡",
            "text": "简单来说，你可以亲自参与调酒…或者调别的什么，原料随便用。",
            "nextDialogs": [
              "705020107"
            ]
          },
          "705020107": {
            "id": "705020107",
            "speakerId": 30112,
            "speakerName": "卢卡",
            "text": "只要不浪费，成品也供你们无限畅饮。",
            "nextDialogs": [
              "705020108"
            ]
          },
          "705020108": {
            "id": "705020108",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "无限畅饮！",
            "nextDialogs": [
              "705020109"
            ]
          },
          "705020109": {
            "id": "705020109",
            "speakerId": 30112,
            "speakerName": "卢卡",
            "text": "另外，如果能让顾客们满意，报酬肯定也不会少你们的。",
            "nextDialogs": [
              "705020110"
            ]
          },
          "705020110": {
            "id": "705020110",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "哇，还有报酬！",
            "nextDialogs": [
              "705020111"
            ]
          },
          "705020111": {
            "id": "705020111",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "派蒙彻底沦陷了…",
            "nextDialogs": [
              "705020112"
            ]
          },
          "705020112": {
            "id": "705020112",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "我们参加吧！好不好？",
            "nextDialogs": [
              "705020113"
            ]
          },
          "705020113": {
            "id": "705020113",
            "speakerId": 30112,
            "speakerName": "卢卡",
            "text": "虽说是「体验周」，其实对考勤没有要求…",
            "nextDialogs": [
              "705020114"
            ]
          },
          "705020114": {
            "id": "705020114",
            "speakerId": 30112,
            "speakerName": "卢卡",
            "text": "现在做不了决定也没关系，可以先来试一次。",
            "nextDialogs": [
              "705020115"
            ]
          },
          "705020115": {
            "id": "705020115",
            "speakerId": 30112,
            "speakerName": "卢卡",
            "text": "怎么样，你意下如何？"
          },
          "705020118": {
            "id": "705020118",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "请稍等一下。",
            "nextDialogs": [
              "705020119"
            ]
          },
          "705020119": {
            "id": "705020119",
            "speakerId": 30112,
            "speakerName": "卢卡",
            "text": "没问题，要是你想好了，随时来找我就行。"
          }
        }
      }
    }
  ]
}
    {
      "subId": "7050204",
      "subQuestName": "学习并调制指定饮品",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "705020401"
        ],
        "dialogs": {
          "705020401": {
            "id": "705020401",
            "speakerId": 30112,
            "speakerName": "卢卡",
            "text": "怎么样，你意下如何？"
          }
        }
      }
    },
    {
      "subId": "7050205",
      "subQuestName": "与查尔斯对话",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "705020301"
        ],
        "dialogs": {
          "705020301": {
            "id": "705020301",
            "speakerId": 30114,
            "speakerName": "查尔斯",
            "text": "你学得很快，味道也确实不错。",
            "nextDialogs": [
              "705020302"
            ]
          },
          "705020302": {
            "id": "705020302",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "嗯嗯，我也觉得好喝！",
            "nextDialogs": [
              "705020303"
            ]
          },
          "705020303": {
            "id": "705020303",
            "speakerId": 30114,
            "speakerName": "查尔斯",
            "text": "刚才只是情景模拟。实际上，顾客可能也会有一些个性化点单。",
            "nextDialogs": [
              "705020304"
            ]
          },
          "705020304": {
            "id": "705020304",
            "speakerId": 30114,
            "speakerName": "查尔斯",
            "text": "浓一点、酸一点，诸如此类。你只需要将对应口味的辅料加量就好。",
            "nextDialogs": [
              "705020305"
            ]
          },
          "705020305": {
            "id": "705020305",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "我想要一杯焦糖松果，甜一点，最大的杯子！",
            "nextDialogs": [
              "705020306"
            ]
          },
          "705020306": {
            "id": "705020306",
            "speakerId": 30114,
            "speakerName": "查尔斯",
            "text": "差不多就类似这样。但对一个优秀的酒保来说，除了具备调制技术，还需要掌握和客人聊天的技巧…",
            "nextDialogs": [
              "705020309"
            ]
          },
          "705020309": {
            "id": "705020309",
            "speakerId": 30114,
            "speakerName": "查尔斯",
            "text": "那好，这吧台的位置就交给你们了。遇到问题或者有什么需要，可以随时找我。",
            "nextDialogs": [
              "705020310"
            ]
          },
          "705020310": {
            "id": "705020310",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "呼…终于学完了！不对…我的焦糖松果呢？",
            "nextDialogs": [
              "705020311"
            ]
          },
          "705020311": {
            "id": "705020311",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "原来你真的在点单…"
          }
        }
      }
    },

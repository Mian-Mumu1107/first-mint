    {
      "subId": "7214102",
      "subQuestName": "（test）开始对话1$HIDDEN",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "721410601"
        ],
        "dialogs": {
          "721410601": {
            "id": "721410601",
            "speakerId": 20239,
            "speakerName": "鹫津",
            "text": "如何？「他」的教诲，你是否有幸听到？",
            "nextDialogs": [
              "721410604"
            ]
          },
          "721410604": {
            "id": "721410604",
            "speakerId": 20239,
            "speakerName": "鹫津",
            "text": "无妨，无妨，「他」在看着，「他」在听着。",
            "nextDialogs": [
              "721410605"
            ]
          },
          "721410605": {
            "id": "721410605",
            "speakerId": 20239,
            "speakerName": "鹫津",
            "text": "「他」很欣慰，而喜悦「他」的人，必获得奖赏。",
            "nextDialogs": [
              "721410606"
            ]
          },
          "721410606": {
            "id": "721410606",
            "speakerId": 20239,
            "speakerName": "鹫津",
            "text": "「他」的奖赏不在彼岸，就在明天。"
          }
        }
      }
    },

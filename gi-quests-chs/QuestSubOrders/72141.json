    {
      "subId": "7214118",
      "subQuestName": "（test）第四次参拜神像1$HIDDEN",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "721411901"
        ],
        "dialogs": {
          "721411901": {
            "id": "721411901",
            "speakerId": 20267,
            "speakerName": "异人龛",
            "text": "（看起来很普通的神龛，并没有任何奇特的元素痕迹。目睹了鹫津的狂态，你还要继续参拜吗？）",
            "nextDialogs": [
              "721411902"
            ]
          },
          "721411902": {
            "id": "721411902",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "参拜神龛",
            "nextDialogs": [
              "721411904"
            ]
          },
          "721411904": {
            "id": "721411904",
            "speakerId": 20267,
            "speakerName": "异人龛",
            "text": "（鹫津依然在旁边喃喃自语，模样很不妙。神龛则是岿然不动，全无反应。或许这一切不过是一场骗局？你努力倾听，但什么也没有发生。）"
          }
        }
      }
    },
    {
      "subId": "7214119",

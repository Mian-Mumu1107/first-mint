          }
        }
      }
    },
    {
      "subId": "7214102",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "721410201"
        ],
        "dialogs": {
          "721410201": {
            "id": "721410201",
            "speakerId": 20239,
            "speakerName": "鹫津",
            "text": "拜祭，祈祷，倾听…切记，切记。"
          }
        }
      }
    },
    {
      "subId": "7214107",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "721410701"
        ],
        "dialogs": {
          "721410701": {
            "id": "721410701",
            "speakerId": 20239,
            "speakerName": "鹫津",
            "text": "与「他」的莫大福泽相比，这只不过是一点小小赏赐。",
            "nextDialogs": [
              "721410702"
            ]
          },
          "721410702": {
            "id": "721410702",
            "speakerId": 20239,
            "speakerName": "鹫津",
            "text": "祈祷吧，拜祭吧，倾听「他」，并且让「他」倾听你！",
            "nextDialogs": [
              "721410703"
            ]
          },
          "721410703": {
            "id": "721410703",
            "speakerId": 20239,
            "speakerName": "鹫津",
            "text": "然后，你将同我一样，听到「他」的话语，从你的心内传出。",
            "nextDialogs": [
              "721410704"
            ]
          },
          "721410704": {
            "id": "721410704",
            "speakerId": 20239,
            "speakerName": "鹫津",
            "text": "然后，「他」将引你脱离苦痛，得大恩赏。",
            "nextDialogs": [
              "721410707"
            ]
          },
          "721410707": {
            "id": "721410707",
            "speakerId": 20239,
            "speakerName": "鹫津",
            "text": "记住，每日拜祭三番，必有回赐。",
            "nextDialogs": [
              "721410708"
            ]
          },
          "721410708": {
            "id": "721410708",
            "speakerId": 20239,
            "speakerName": "鹫津",
            "text": "切记，切记。"
          }
        }
      }
    },
    {
      "subId": "7214112",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "721411201"
        ],
        "dialogs": {
          "721411201": {
            "id": "721411201",
            "speakerId": 20239,
            "speakerName": "鹫津",
            "text": "「他」要来了！不要停止拜祭！不能停止拜祭！！",
            "nextDialogs": [
              "721411204"
            ]
          },
          "721411204": {
            "id": "721411204",
            "speakerId": 20239,
            "speakerName": "鹫津",
            "text": "「他」在愠怒，「他」要发怒了！"
          }
        }
      }
    },
    {
      "subId": "7214113",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "721411301"
        ],
        "dialogs": {
          "721411301": {
            "id": "721411301",
            "speakerId": 20239,
            "speakerName": "鹫津",
            "text": "倾听我，请不要离弃我…"
          }
        }
      }
    },
    {
      "subId": "7214118",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "721411801"
        ],
        "dialogs": {
          "721411801": {
            "id": "721411801",
            "speakerId": 20239,
            "speakerName": "鹫津",
            "text": "你来了。",
            "nextDialogs": [
              "721411802"
            ]
          },
          "721411802": {
            "id": "721411802",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "你还好吗？",
            "nextDialogs": [
              "721411803"
            ]
          },
          "721411803": {
            "id": "721411803",
            "speakerId": 20239,
            "speakerName": "鹫津",
            "text": "谢谢你宽恕我的罪恶，请让我回归于你…",
            "nextDialogs": [
              "721411804"
            ]
          },
          "721411804": {
            "id": "721411804",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "你在和我说话吗？",
            "nextDialogs": [
              "721411805"
            ]
          },
          "721411805": {
            "id": "721411805",
            "speakerId": 20239,
            "speakerName": "鹫津",
            "text": "什么…但为什么…",
            "nextDialogs": [
              "721411806"
            ]
          },
          "721411806": {
            "id": "721411806",
            "speakerId": 20239,
            "speakerName": "鹫津",
            "text": "我主持了每一次祭献，我接受了你的每一场恩典！",
            "nextDialogs": [
              "721411807"
            ]
          },
          "721411807": {
            "id": "721411807",
            "speakerId": 20239,
            "speakerName": "鹫津",
            "text": "而她，被你所标记，为你所成就，却逃离你的恩赐，背叛了我们！",
            "nextDialogs": [
              "721411808"
            ]
          },
          "721411808": {
            "id": "721411808",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "你在说什么…",
            "nextDialogs": [
              "721411809"
            ]
          },
          "721411809": {
            "id": "721411809",
            "speakerId": 20239,
            "speakerName": "鹫津",
            "text": "呀啊！唔呃…对不起…对不起…",
            "nextDialogs": [
              "721411810"
            ]
          },
          "721411810": {
            "id": "721411810",
            "speakerId": 20239,
            "speakerName": "鹫津",
            "text": "不应该怀疑「他」的选择，继续隐忍，继续拜祭…",
            "nextDialogs": [
              "721411811"
            ]
          },
          "721411811": {
            "id": "721411811",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "听得到我说话吗？",
            "nextDialogs": [
              "721411812"
            ]
          },
          "721411812": {
            "id": "721411812",
            "speakerId": 20239,
            "speakerName": "鹫津",
            "text": "继续隐忍…继续拜祭…",
            "nextDialogs": [
              "721411813"
            ]
          },
          "721411813": {
            "id": "721411813",
            "speakerId": 20239,
            "speakerName": "鹫津",
            "text": "继续隐忍…继续拜祭…"
          }
        }
      }
    }
  ]

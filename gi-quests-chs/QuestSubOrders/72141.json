        "dialogs": {
          "721410101": {
            "id": "721410101",
            "speakerId": 20239,
            "speakerName": "鹫津",
            "text": "…？",
            "nextDialogs": [
              "721410105"
            ]
          },
          "721410105": {
            "id": "721410105",
            "speakerId": 20239,
            "speakerName": "鹫津",
            "text": "...",
            "nextDialogs": [
              "721410106"
            ]
          },
          "721410106": {
            "id": "721410106",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "你在听我讲话吗？",
            "nextDialogs": [
              "721410107"
            ]
          },
          "721410107": {
            "id": "721410107",
            "speakerId": 20239,
            "speakerName": "鹫津",

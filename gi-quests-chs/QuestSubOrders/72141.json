    },
    {
      "subId": "7214108",
      "subQuestName": "（test）开始对话3$HIDDEN",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "721411701"
        ],
        "dialogs": {
          "721411701": {
            "id": "721411701",
            "speakerId": 20239,
            "speakerName": "鹫津",
            "text": "必须平息「他」的怒火，必须安抚「他」的愤怒…",
            "nextDialogs": [
              "721411702"
            ]
          },
          "721411702": {
            "id": "721411702",
            "speakerId": 20239,
            "speakerName": "鹫津",
            "text": "你做的很好，你做的很好！",
            "nextDialogs": [
              "721411703"
            ]
          },
          "721411703": {
            "id": "721411703",
            "speakerId": 20239,
            "speakerName": "鹫津",
            "text": "切记，有的人会戴着面具，欺骗你，但「他」会帮助你，「他」永远襄助你。",
            "nextDialogs": [
              "721411706"
            ]
          },
          "721411706": {
            "id": "721411706",
            "speakerId": 20239,
            "speakerName": "鹫津",
            "text": "那个女人就像传说中的狐狸妖怪，我放跑了她，「他」很生气。",
            "nextDialogs": [
              "721411707"
            ]
          },
          "721411707": {
            "id": "721411707",
            "speakerId": 20239,
            "speakerName": "鹫津",
            "text": "「他」现在又生气了…这是我的罪。",
            "nextDialogs": [
              "721411708"
            ]
          },
          "721411708": {
            "id": "721411708",
            "speakerId": 20239,
            "speakerName": "鹫津",
            "text": "请原谅我…我会再次献祭，我会为您寻找下一个「回归」的祭品…",
            "nextDialogs": [
              "721411709"
            ]
          },
          "721411709": {
            "id": "721411709",
            "speakerId": 20239,
            "speakerName": "鹫津",
            "text": "请原谅我，请原谅我…",
            "nextDialogs": [
              "721411710"
            ]
          },
          "721411710": {
            "id": "721411710",
            "speakerId": 20239,
            "speakerName": "鹫津",
            "text": "请原谅我，请原谅我…"
          }
        }
      }
    },

            "speakerId": 20267,
            "speakerName": "异人龛",
            "text": "（鹫津依然在旁边喃喃自语，模样很不妙。神龛则是岿然不动，全无反应。或许这一切不过是一场骗局？）",
            "nextDialogs": [
              "721412104"
            ]
          },
          "721412104": {
            "id": "721412104",
            "speakerId": 20267,
            "speakerName": "异人龛",
            "text": "「小心身后…」",
            "nextDialogs": [
              "721412105"
            ]
          },
          "721412105": {
            "id": "721412105",
            "speakerId": 20267,
            "speakerName": "异人龛",
            "text": "（身后传来脚步声，欲盖弥彰，过于清晰。）",
            "nextDialogs": [
              "721412106"
            ]
          },
          "721412106": {
            "id": "721412106",
            "speakerId": 20267,
            "speakerName": "异人龛",
            "text": "「小心…！」"
          }
        }
      }

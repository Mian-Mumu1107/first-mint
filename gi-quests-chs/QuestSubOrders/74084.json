    {
      "subId": "7408405",
      "subQuestName": "与派蒙对话",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "740840605"
        ],
        "dialogs": {
          "740840605": {
            "id": "740840605",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "快看！祭坛旁边有只龙蜥！它是不是睡着了？我们要小心点…",
            "nextDialogs": [
              "740840601"
            ]
          },
          "740840601": {
            "id": "740840601",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "咦？这里…这里怎么没有钥匙？难道这座祭坛已经被提前激活了？该不会已经有人拿走钥匙了吧？",
            "nextDialogs": [
              "740840602"
            ]
          },
          "740840602": {
            "id": "740840602",
            "speakerId": 1004,
            "speakerName": "暴怒的吼声",
            "text": "吼——",
            "nextDialogs": [
              "740840603"
            ]
          },
          "740840603": {
            "id": "740840603",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "不好了！那只龙蜥醒了！我们快跑！",
            "nextDialogs": [
              "740840604"
            ]
          },
          "740840604": {
            "id": "740840604",
            "speakerId": 1002,
            "speakerName": "Black Screen",
            "text": "祭坛旁的龙蜥摇晃着醒来，双眼喷出愤怒与恶意…\\n你们急忙向岸上游去…但它在后面紧追不舍…"
          }
        }
      }
    },
    {
      "subId": "7408407",
      "subQuestName": "制服暴怒的龙蜥",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "740840701"
        ],
        "dialogs": {
          "740840701": {
            "id": "740840701",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "我仔细观察了一下这个祭坛，它看起来像是已经被激活了，不过附近似乎也没有什么变化…",
            "nextDialogs": [
              "740840702"
            ]
          },
          "740840702": {
            "id": "740840702",
            "speakerId": 1004,
            "speakerName": "暴怒的吼声",
            "text": "吼——",
            "nextDialogs": [

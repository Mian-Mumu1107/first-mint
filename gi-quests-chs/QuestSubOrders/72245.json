  },
  "subQuests": [
    {
      "subId": "7224501",
      "subQuestName": "",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "722450101"
        ],
        "dialogs": {
          "722450101": {
            "id": "722450101",
            "speakerId": 1000,
            "speakerName": "离可琉",
            "text": "嗯？别来打扰我，我在想…",
            "nextDialogs": [
              "722450102"
            ]
          },
          "722450102": {
            "id": "722450102",
            "speakerId": 1000,
            "speakerName": "离可琉",
            "text": "我在想很重要的事！",
            "nextDialogs": [
              "722450103"
            ]
          },
          "722450103": {
            "id": "722450103",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "很重要的事？是什么事啊？",
            "nextDialogs": [
              "722450104"
            ]
          },
          "722450104": {
            "id": "722450104",
            "speakerId": 1000,
            "speakerName": "离可琉",
            "text": "你看到那个叫大日御舆的东西了吗？",
            "nextDialogs": [
              "722450105"
            ]
          },
          "722450105": {
            "id": "722450105",
            "speakerId": 1000,
            "speakerName": "离可琉",
            "text": "就整个白夜之国最高的建筑。",
            "nextDialogs": [
              "722450106"
            ]
          },
          "722450106": {
            "id": "722450106",
            "speakerId": 1000,
            "speakerName": "离可琉",
            "text": "我在想呀，要怎么做个更高的建筑，比大日御舆还高！",
            "nextDialogs": [
              "722450107"
            ]
          },
          "722450107": {
            "id": "722450107",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "嗯，可是大日御舆建那么高，是为了照亮白夜国。",
            "nextDialogs": [
              "722450108"
            ]
          },
          "722450108": {
            "id": "722450108",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "你的那个建筑做那么高是为了什么呀？",
            "nextDialogs": [
              "722450109"
            ]
          },
          "722450109": {
            "id": "722450109",
            "speakerId": 1000,
            "speakerName": "离可琉",
            "text": "当然是为了彰显我离可琉大人的声名啊！",
            "nextDialogs": [
              "722450110"
            ]
          },
          "722450110": {
            "id": "722450110",
            "speakerId": 1000,
            "speakerName": "离可琉",
            "text": "只有这样，就能证明我比阿倍良久那个大叔要厉害！",
            "nextDialogs": [
              "722450113"
            ]
          },
          "722450113": {
            "id": "722450113",
            "speakerId": 1000,
            "speakerName": "离可琉",
            "text": "那是当然了，建造大日御舆，让白夜国摆脱危机…我以前，正是因为崇拜他…",
            "nextDialogs": [
              "722450114"
            ]
          },
          "722450114": {
            "id": "722450114",
            "speakerId": 1000,
            "speakerName": "离可琉",
            "text": "可是，他居然想要图谋王位，要不是那些大人，说不定我就要丢掉性命了。",
            "nextDialogs": [
              "722450115"
            ]
          },
          "722450115": {
            "id": "722450115",
            "speakerId": 1000,
            "speakerName": "离可琉",
            "text": "哼，我一定要建造比大日御舆还高的建筑。",
            "nextDialogs": [
              "722450116"
            ]
          },
          "722450116": {
            "id": "722450116",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "那、那要建多久啊。",
            "nextDialogs": [
              "722450117"
            ]
          },
          "722450117": {
            "id": "722450117",
            "speakerId": 1000,
            "speakerName": "离可琉",
            "text": "我才不管呢！",
            "nextDialogs": [
              "722450118"
            ]
          },
          "722450118": {
            "id": "722450118",
            "speakerId": 1000,
            "speakerName": "离可琉",
            "text": "白夜之国的人民能受我谕令，建造一个留名青史的奇观，感恩戴德还来不及呢！",
            "nextDialogs": [
              "722450119"
            ]
          },
          "722450119": {
            "id": "722450119",
            "speakerId": 1000,
            "speakerName": "离可琉",
            "text": "好了，别打扰我了！",
            "nextDialogs": [
              "722450120"
            ]
          },
          "722450120": {
            "id": "722450120",
            "speakerId": 1000,
            "speakerName": "离可琉",
            "text": "让我想想，梁高如果…这样的话，承重和斗拱…"
          }
        }
      }
    },
    {
      "subId": "7224502",
      "subQuestName": "",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "722450201"
        ],
        "dialogs": {
          "722450201": {
            "id": "722450201",
            "speakerId": 1002,
            "speakerName": "依栖目那须",
            "text": "嗯？从未在白夜之国见过你们这样穿着的人。",
            "nextDialogs": [
              "722450202"
            ]
          },
          "722450202": {
            "id": "722450202",
            "speakerId": 1002,
            "speakerName": "依栖目那须",
            "text": "难道你们是从什么天外之处来的吗？",
            "nextDialogs": [
              "722450203"
            ]
          },
          "722450203": {
            "id": "722450203",
            "speakerId": 1002,
            "speakerName": "依栖目那须",
            "text": "原来世上不只有白夜之国，那，呈上你们通行使用的地图，给我一观吧！",
            "nextDialogs": [
              "722450204"
            ]
          },
          "722450204": {
            "id": "722450204",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "（给予地图…）",
            "nextDialogs": [
              "722450205"
            ]
          },
          "722450205": {
            "id": "722450205",
            "speakerId": 1002,
            "speakerName": "依栖目那须",
            "text": "哦哦，真是精巧，不仅陆地轮廓精确，连山川走势也隐隐所现。",
            "nextDialogs": [
              "722450206"
            ]
          },
          "722450206": {
            "id": "722450206",
            "speakerId": 1002,
            "speakerName": "依栖目那须",
            "text": "那么这名为提瓦特之国的国土大小，能和白夜之国相比吗？",
            "nextDialogs": [
              "722450207"
            ]
          },
          "722450207": {
            "id": "722450207",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "提瓦特是整片大陆的名字啦…",
            "nextDialogs": [
              "722450208"
            ]
          },
          "722450208": {
            "id": "722450208",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "还有，渊下宫，啊，也就是白夜国，在地图南边的这个小块。",
            "nextDialogs": [
              "722450209"
            ]
          },
          "722450209": {
            "id": "722450209",
            "speakerId": 1002,
            "speakerName": "依栖目那须",
            "text": "荒谬！我白夜国土如此辽阔，怎么可能才只有这点大小。",
            "nextDialogs": [
              "722450210"
            ]
          },
          "722450210": {
            "id": "722450210",
            "speakerId": 1002,
            "speakerName": "依栖目那须",
            "text": "此图看上去精巧，实为妄诞乱画之作，拿去拿去！",
            "nextDialogs": [
              "722450211"
            ]
          },
          "722450211": {
            "id": "722450211",
            "speakerId": 1002,
            "speakerName": "依栖目那须",
            "text": "我本还有些敬佩之心，没想到竟是伪作，真是污了我的眼睛！",
            "nextDialogs": [
              "722450212"
            ]
          },
          "722450212": {
            "id": "722450212",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "哼，你不信就算了！"
          }
        }
      }
    },
    {
      "subId": "7224503",
      "subQuestName": "",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "722450301"
        ],
        "dialogs": {
          "722450301": {
            "id": "722450301",
            "speakerId": 1003,
            "speakerName": "栖令比御",
            "text": "远方到来的旅者，咳咳，你看上去相当疲惫啊。",
            "nextDialogs": [
              "722450302"
            ]
          },
          "722450302": {
            "id": "722450302",
            "speakerId": 1003,
            "speakerName": "栖令比御",
            "text": "疲惫可不行，很多病，都是从疲惫开始的。",
            "nextDialogs": [
              "722450303"
            ]
          },
          "722450303": {
            "id": "722450303",
            "speakerId": 1003,
            "speakerName": "栖令比御",
            "text": "每日要保证足够的睡眠，才能，咳咳…",
            "nextDialogs": [
              "722450304"
            ]
          },
          "722450304": {
            "id": "722450304",
            "speakerId": 1003,
            "speakerName": "栖令比御",
            "text": "咳咳咳咳，咳咳咳…才能健康成长。",
            "nextDialogs": [
              "722450305"
            ]
          },
          "722450305": {
            "id": "722450305",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "总觉得你自己不是很健康呢…",
            "nextDialogs": [
              "722450306"
            ]
          },
          "722450306": {
            "id": "722450306",
            "speakerId": 1003,
            "speakerName": "栖令比御",
            "text": "哈哈，这是老毛病了。",
            "nextDialogs": [
              "722450307"
            ]
          },
          "722450307": {
            "id": "722450307",
            "speakerId": 1003,
            "speakerName": "栖令比御",
            "text": "旅者啊，只有完备健全的身躯，才可寄寓完备健全的魂魄。",
            "nextDialogs": [
              "722450308"
            ]
          },
          "722450308": {
            "id": "722450308",
            "speakerId": 1003,
            "speakerName": "栖令比御",
            "text": "唉，如果再有点时间就好了，我一定能够成为世上最好的医生…",
            "nextDialogs": [
              "722450309"
            ]
          },
          "722450309": {
            "id": "722450309",
            "speakerId": 1003,
            "speakerName": "栖令比御",
            "text": "这样，就算是我这样的身躯，恐怕也可以健康地走出房间，肆意玩耍了吧。"
          }
        }
      }
    },
    {
      "subId": "7224504",
      "subQuestName": "",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "722450401"
        ],
        "dialogs": {
          "722450401": {
            "id": "722450401",
            "speakerId": 1004,
            "speakerName": "里栖太御须",
            "text": "不许动！",
            "nextDialogs": [
              "722450402"
            ]
          },
          "722450402": {
            "id": "722450402",
            "speakerId": 1004,
            "speakerName": "里栖太御须",
            "text": "啊，不要动，不要动啊！诶呀，都说了不要动。",
            "nextDialogs": [
              "722450403"
            ]
          },
          "722450403": {
            "id": "722450403",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "诶，可是，突然让我不要动…",
            "nextDialogs": [
              "722450406"
            ]
          },
          "722450406": {
            "id": "722450406",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "才不会呢！",
            "nextDialogs": [
              "722450407"
            ]
          },
          "722450407": {
            "id": "722450407",
            "speakerId": 1004,
            "speakerName": "里栖太御须",
            "text": "哎呀，那就转个身吧，我可从来没见过这样的衣服。",
            "nextDialogs": [
              "722450408"
            ]
          },
          "722450408": {
            "id": "722450408",
            "speakerId": 1004,
            "speakerName": "里栖太御须",
            "text": "虽然有点丑陋，但也不是什么意思都没有。",
            "nextDialogs": [
              "722450409"
            ]
          },
          "722450409": {
            "id": "722450409",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "居然觉得丑，那还不如不要看…",
            "nextDialogs": [
              "722450410"
            ]
          },
          "722450410": {
            "id": "722450410",
            "speakerId": 1004,
            "speakerName": "里栖太御须",
            "text": "真是的，以往我让那些女官们给我作范本，可没有那么烦的。",
            "nextDialogs": [
              "722450411"
            ]
          },
          "722450411": {
            "id": "722450411",
            "speakerId": 1004,
            "speakerName": "里栖太御须",
            "text": "不过，白夜国的人啊，穿的衣服，长的样子我也全都看腻了。",
            "nextDialogs": [
              "722450412"
            ]
          },
          "722450412": {
            "id": "722450412",
            "speakerId": 1004,
            "speakerName": "里栖太御须",
            "text": "你们身上的倒是少见。",
            "nextDialogs": [
              "722450413"
            ]
          },
          "722450413": {
            "id": "722450413",
            "speakerId": 1004,
            "speakerName": "里栖太御须",
            "text": "嗯嗯，我知道了，原来这个衣服是这样的结构的…你们异乡还真是不知羞耻。",
            "nextDialogs": [
              "722450414"
            ]
          },
          "722450414": {
            "id": "722450414",
            "speakerId": 1004,
            "speakerName": "里栖太御须",
            "text": "原来如此，衣服结构若是这样的，那身躯就做成这个造型吧！",
            "nextDialogs": [
              "722450415"
            ]
          },
          "722450415": {
            "id": "722450415",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "你这是在做什么呢？",
            "nextDialogs": [
              "722450416"
            ]
          },
          "722450416": {
            "id": "722450416",
            "speakerId": 1004,
            "speakerName": "里栖太御须",
            "text": "造像啊，用泥水混合，用双手捏出造型。每每只有做这事的时候，内心才能平静。",
            "nextDialogs": [
              "722450417"
            ]
          },
          "722450417": {
            "id": "722450417",
            "speakerId": 1004,
            "speakerName": "里栖太御须",
            "text": "平时的议会，照本宣科地按着大人们写好的词句读，总让人不安。",
            "nextDialogs": [
              "722450418"
            ]
          },
          "722450418": {
            "id": "722450418",
            "speakerId": 1004,
            "speakerName": "里栖太御须",
            "text": "…好了，你的造型我也已经看腻了。",
            "nextDialogs": [
              "722450419"
            ]
          },
          "722450419": {
            "id": "722450419",
            "speakerId": 1004,
            "speakerName": "里栖太御须",
            "text": "别烦我，去做自己的事去吧。"
          }
        }
      }
    },
    {
      "subId": "7224505",
      "subQuestName": "",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "722450501"
        ],
        "dialogs": {
          "722450501": {
            "id": "722450501",
            "speakerId": 1005,
            "speakerName": "伊恩",
            "text": "哎呀，这位旅者，咱看你眉心发黑，不如让咱给你算个命吧！",
            "nextDialogs": [
              "722450502"
            ]
          },
          "722450502": {
            "id": "722450502",
            "speakerId": 1005,
            "speakerName": "伊恩",
            "text": "咱可是百算百灵的伊恩大人呀。",
            "nextDialogs": [
              "722450503"
            ]
          },
          "722450503": {
            "id": "722450503",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "真的吗？",
            "nextDialogs": [
              "722450504"
            ]
          },
          "722450504": {
            "id": "722450504",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "这在桥下拉客的人的语气。",
            "nextDialogs": [
              "722450505"
            ]
          },
          "722450505": {
            "id": "722450505",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "（而且，我记得他的墓碑上写着……）",
            "nextDialogs": [
              "722450506"
            ]
          },
          "722450506": {
            "id": "722450506",
            "speakerId": 1005,
            "speakerName": "伊恩",
            "text": "那是什么怀疑的眼神，好了好了，咱平时给别人算命。",
            "nextDialogs": [
              "722450507"
            ]
          },
          "722450507": {
            "id": "722450507",
            "speakerId": 1005,
            "speakerName": "伊恩",
            "text": "但是白夜国的国民…很少有幸福快乐的命运。",
            "nextDialogs": [
              "722450508"
            ]
          },
          "722450508": {
            "id": "722450508",
            "speakerId": 1005,
            "speakerName": "伊恩",
            "text": "所以咱就欺骗他们，说他们走了好运。",
            "nextDialogs": [
              "722450509"
            ]
          },
          "722450509": {
            "id": "722450509",
            "speakerId": 1005,
            "speakerName": "伊恩",
            "text": "咱觉得，这样他们好歹也能快乐一些嘛。",
            "nextDialogs": [
              "722450510"
            ]
          },
          "722450510": {
            "id": "722450510",
            "speakerId": 1005,
            "speakerName": "伊恩",
            "text": "结果他们就说咱根本就不会算，真是令人悲伤呀。",
            "nextDialogs": [
              "722450511"
            ]
          },
          "722450511": {
            "id": "722450511",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "真的吗？",
            "nextDialogs": [
              "722450512"
            ]
          },
          "722450512": {
            "id": "722450512",
            "speakerId": 1005,
            "speakerName": "伊恩",
            "text": "怎么样，小家伙，就让咱给你算一下吧！",
            "nextDialogs": [
              "722450513"
            ]
          },
          "722450513": {
            "id": "722450513",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "那、那好吧！",
            "nextDialogs": [
              "722450514"
            ]
          },
          "722450514": {
            "id": "722450514",
            "speakerId": 1005,
            "speakerName": "伊恩",
            "text": "嗯…让我仔细算算，咦，怎么牵涉的东西这么多…",
            "nextDialogs": [
              "722450515"
            ]
          },
          "722450515": {
            "id": "722450515",
            "speakerId": 1005,
            "speakerName": "伊恩",
            "text": "诶呀！",
            "nextDialogs": [
              "722450516"
            ]
          },
          "722450516": {
            "id": "722450516",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "怎、怎么了？",
            "nextDialogs": [
              "722450517"
            ]
          },
          "722450517": {
            "id": "722450517",
            "speakerId": 1005,
            "speakerName": "伊恩",
            "text": "算不出来…",
            "nextDialogs": [
              "722450518"
            ]
          },
          "722450518": {
            "id": "722450518",
            "speakerId": 1005,
            "speakerName": "伊恩",
            "text": "怎么会这样呢，咱平时算出来的虽然不准，但也不会到算不出来的地步啊。",
            "nextDialogs": [
              "722450519"
            ]
          },
          "722450519": {
            "id": "722450519",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "看来水平不是很高嘛。",
            "nextDialogs": [
              "722450520"
            ]
          },
          "722450520": {
            "id": "722450520",
            "speakerId": 1005,
            "speakerName": "伊恩",
            "text": "…所言甚是，看来，咱还得再努力学习呀。"
          }
        }
      }
    },
    {
      "subId": "7224506",
      "subQuestName": "",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "722450601"
        ],
        "dialogs": {
          "722450601": {
            "id": "722450601",
            "speakerId": 1006,
            "speakerName": "比螺梦门",
            "text": "啊，看你的样子，你是从异国而来的旅者吧！",
            "nextDialogs": [
              "722450602"
            ]
          },
          "722450602": {
            "id": "722450602",
            "speakerId": 1006,
            "speakerName": "比螺梦门",
            "text": "是从什么地方来的呀！",
            "nextDialogs": [
              "722450603"
            ]
          },
          "722450603": {
            "id": "722450603",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "我们是从蒙德来的。",
            "nextDialogs": [
              "722450604"
            ]
          },
          "722450604": {
            "id": "722450604",
            "speakerId": 1006,
            "speakerName": "比螺梦门",
            "text": "蒙德？",
            "nextDialogs": [
              "722450605"
            ]
          },
          "722450605": {
            "id": "722450605",
            "speakerId": 1007,
            "speakerName": "Black Screen",
            "text": "向比螺梦门简单讲述了蒙德城的风物…",
            "nextDialogs": [
              "722450606"
            ]
          },
          "722450606": {
            "id": "722450606",
            "speakerId": 1006,
            "speakerName": "比螺梦门",
            "text": "从来没有听说过的城邦，是嘛，了不起，居然还有这样的地方。",
            "nextDialogs": [
              "722450607"
            ]
          },
          "722450607": {
            "id": "722450607",
            "speakerId": 1006,
            "speakerName": "比螺梦门",
            "text": "哈哈哈，我就说世上怎么会只有白夜国那么大小。",
            "nextDialogs": [
              "722450608"
            ]
          },
          "722450608": {
            "id": "722450608",
            "speakerId": 1006,
            "speakerName": "比螺梦门",
            "text": "世上只有白夜国，嘿，那岂不是寂寞得要死了。",
            "nextDialogs": [
              "722450609"
            ]
          },
          "722450609": {
            "id": "722450609",
            "speakerId": 1006,
            "speakerName": "比螺梦门",
            "text": "看古籍的时候也有提到白夜成国之前的故事，那时我就觉得天外有天。",
            "nextDialogs": [
              "722450610"
            ]
          },
          "722450610": {
            "id": "722450610",
            "speakerId": 1006,
            "speakerName": "比螺梦门",
            "text": "不过，我原本还是害怕的，害怕白夜国之外其实空无一物。",
            "nextDialogs": [
              "722450611"
            ]
          },
          "722450611": {
            "id": "722450611",
            "speakerId": 1006,
            "speakerName": "比螺梦门",
            "text": "旅者，你的到来让我安心好多。哼，世上原来还有这么多有趣的地方。",
            "nextDialogs": [
              "722450612"
            ]
          },
          "722450612": {
            "id": "722450612",
            "speakerId": 1006,
            "speakerName": "比螺梦门",
            "text": "只可惜我现在还有一个叫归日之祭的祭典要完成。",
            "nextDialogs": [
              "722450613"
            ]
          },
          "722450613": {
            "id": "722450613",
            "speakerId": 1006,
            "speakerName": "比螺梦门",
            "text": "旅者啊，不如这样，你告诉我你进入此处的路吧。",
            "nextDialogs": [
              "722450614"
            ]
          },
          "722450614": {
            "id": "722450614",
            "speakerId": 1006,
            "speakerName": "比螺梦门",
            "text": "等到归日之祭的祭典礼成，我就找机会偷偷从大日御舆跑出去。",
            "nextDialogs": [
              "722450615"
            ]
          },
          "722450615": {
            "id": "722450615",
            "speakerId": 1006,
            "speakerName": "比螺梦门",
            "text": "到时候一起喝杯果汁吧！哈哈哈哈！"
          }
        }
      }
    },
    {
      "subId": "7224507",
      "subQuestName": "",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "722450701"
        ],
        "dialogs": {
          "722450701": {
            "id": "722450701",
            "speakerId": 1008,
            "speakerName": "御琉部栖",
            "text": "唉，你就是异乡的旅者吗…",
            "nextDialogs": [
              "722450702"
            ]
          },
          "722450702": {
            "id": "722450702",
            "speakerId": 1008,
            "speakerName": "御琉部栖",
            "text": "你是在追寻什么吗，你行走的姿势，实在是，令人感到忧伤啊。",
            "nextDialogs": [
              "722450703"
            ]
          },
          "722450703": {
            "id": "722450703",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "忧伤？有什么让人觉得忧伤的事吗？",
            "nextDialogs": [
              "722450704"
            ]
          },
          "722450704": {
            "id": "722450704",
            "speakerId": 1008,
            "speakerName": "御琉部栖",
            "text": "对于歌者来说，世界上任何事都是值得悲伤的事。",
            "nextDialogs": [
              "722450705"
            ]
          },
          "722450705": {
            "id": "722450705",
            "speakerId": 1008,
            "speakerName": "御琉部栖",
            "text": "譬如，结合就意味着分离，活着就意味着有一日会被埋入尘土之下…",
            "nextDialogs": [
              "722450706"
            ]
          },
          "722450706": {
            "id": "722450706",
            "speakerId": 1008,
            "speakerName": "御琉部栖",
            "text": "譬如，重逢短暂，消解不了别离之苦，这位旅者呀…",
            "nextDialogs": [
              "722450707"
            ]
          },
          "722450707": {
            "id": "722450707",
            "speakerId": 1008,
            "speakerName": "御琉部栖",
            "text": "只有追寻什么的人才会踏上远离故土的旅程。",
            "nextDialogs": [
              "722450708"
            ]
          },
          "722450708": {
            "id": "722450708",
            "speakerId": 1008,
            "speakerName": "御琉部栖",
            "text": "这旅程对于长住一地的居民来说想必相当浪漫，但对于旅者自己，或许是难言的苦楚。",
            "nextDialogs": [
              "722450709"
            ]
          },
          "722450709": {
            "id": "722450709",
            "speakerId": 1008,
            "speakerName": "御琉部栖",
            "text": "若是从前，我便要在此为你歌唱。",
            "nextDialogs": [
              "722450710"
            ]
          },
          "722450710": {
            "id": "722450710",
            "speakerId": 1008,
            "speakerName": "御琉部栖",
            "text": "只是，我在日前与人立下誓言，如果我听不到她的声音，那我也不再展露自己的歌喉。",
            "nextDialogs": [
              "722450711"
            ]
          },
          "722450711": {
            "id": "722450711",
            "speakerId": 1008,
            "speakerName": "御琉部栖",
            "text": "我只能祝福你，虽然你看上去也已比我年长许多…",
            "nextDialogs": [
              "722450712"
            ]
          },
          "722450712": {
            "id": "722450712",
            "speakerId": 1008,
            "speakerName": "御琉部栖",
            "text": "祝你如愿以偿。"
          }
        }
      }
    },
    {
      "subId": "7224508",
      "subQuestName": "",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "722450801"
        ],
        "dialogs": {
          "722450801": {
            "id": "722450801",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "感觉每个太阳之子的个性都不太一样呢…"
          }
        }
      }
    }
  ]
}
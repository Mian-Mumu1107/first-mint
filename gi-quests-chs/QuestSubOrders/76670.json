    "菈乌玛": 5
  },
  "subQuests": [
    {
      "subId": "7667001",
      "subQuestName": "",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "766700101"
        ],
        "dialogs": {
          "766700101": {
            "id": "766700101",
            "speakerId": 1000,
            "speakerName": "菈乌玛",
            "text": "莉莉希，最近情况如何？",
            "nextDialogs": [
              "766700102"
            ]
          },
          "766700102": {
            "id": "766700102",
            "speakerId": 1001,
            "speakerName": "莉莉希",
            "text": "啊！您好，菈乌玛大人，最近店里的事情一切顺利呢。",
            "nextDialogs": [
              "766700103"
            ]
          },
          "766700103": {
            "id": "766700103",
            "speakerId": 1001,
            "speakerName": "莉莉希",
            "text": "食材的供应没有断过，也没有人来捣乱，而且我做菜的手艺也越来越好了！",
            "nextDialogs": [
              "766700104"
            ]
          },
          "766700104": {
            "id": "766700104",
            "speakerId": 1001,
            "speakerName": "莉莉希",
            "text": "对了，上次您说的「朋友」，是…那些动物么？",
            "nextDialogs": [
              "766700105"
            ]
          },
          "766700105": {
            "id": "766700105",
            "speakerId": 1001,
            "speakerName": "莉莉希",
            "text": "它们都好乖喔，一直盯着排队的人，我想要喂它们一点吃的，它们都不吃…",
            "nextDialogs": [
              "766700106"
            ]
          },
          "766700106": {
            "id": "766700106",
            "speakerId": 1000,
            "speakerName": "菈乌玛",
            "text": "那些孩子都知道自己身负责任，在履职之时，自然会坚守岗位，聚精会神。",
            "nextDialogs": [
              "766700107"
            ]
          },
          "766700107": {
            "id": "766700107",
            "speakerId": 1000,
            "speakerName": "菈乌玛",
            "text": "不过，在它们交班之后，你就可以稍微款待一下它们了，呵呵，我想它们也会很高兴的。",
            "nextDialogs": [
              "766700108"
            ]
          },
          "766700108": {
            "id": "766700108",
            "speakerId": 1001,
            "speakerName": "莉莉希",
            "text": "好呀，那我今天可要做一顿好吃的，好好感谢一下它们。",
            "nextDialogs": [
              "766700109"
            ]
          },
          "766700109": {
            "id": "766700109",
            "speakerId": 1000,
            "speakerName": "菈乌玛",
            "text": "辛苦你了，莉莉希，若是需要人协助，直接告诉我就好。",
            "nextDialogs": [
              "766700110"
            ]
          },
          "766700110": {
            "id": "766700110",
            "speakerId": 1001,
            "speakerName": "莉莉希",
            "text": "不用的不用的，我打理得过来，况且还有坎托尔先生和雅珂达小姐帮忙呢。",
            "nextDialogs": [
              "766700111"
            ]
          },
          "766700111": {
            "id": "766700111",
            "speakerId": 1000,
            "speakerName": "菈乌玛",
            "text": "好吧，那我就不打扰了，再见，莉莉希。",
            "nextDialogs": [
              "766700112"
            ]
          },
          "766700112": {
            "id": "766700112",
            "speakerId": 1001,
            "speakerName": "莉莉希",
            "text": "嗯，我也要去把新一轮的餐食端出来了…对了，菈乌玛大人，请您也尝尝这份餐食吧，我刚做好的，可新鲜了。",
            "nextDialogs": [
              "766700113"
            ]
          },
          "766700113": {
            "id": "766700113",
            "speakerId": 1001,
            "speakerName": "莉莉希",
            "text": "好，接下来要把餐食摆在盘子里…咦？我刚刚洗好的盘子呢…"
          }
        }
      }
    }
  ]
}
  },
  "subQuests": [
    {
      "subId": "2203101",
      "subQuestName": "找到发布委托的朝仓",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "220310101"
        ],
        "dialogs": {
          "220310101": {
            "id": "220310101",
            "speakerId": 3060,
            "speakerName": "朝仓",
            "text": "枪扎一线...喝！",
            "nextDialogs": [
              "220310102"
            ]
          },
          "220310102": {
            "id": "220310102",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "我来和你对练了。",
            "nextDialogs": [
              "220310103"
            ]
          },
          "220310103": {
            "id": "220310103",
            "speakerId": 3060,
            "speakerName": "朝仓",
            "text": "噢！是您啊阁下，您又接下我的委托了吗？非常感谢！",
            "nextDialogs": [
              "220310104"
            ]
          },
          "220310104": {
            "id": "220310104",
            "speakerId": 3060,
            "speakerName": "朝仓",
            "text": "您这样武艺高强的人愿意和我对练，实在是太好了。",
            "nextDialogs": [
              "220310106",
              "220310111"
            ]
          },
          "220310106": {
            "id": "220310106",
            "speakerId": 3060,
            "speakerName": "朝仓",
            "text": "哈哈…您可不要再调侃我了。",
            "nextDialogs": [
              "220310107"
            ]
          },
          "220310107": {
            "id": "220310107",
            "speakerId": 3060,
            "speakerName": "朝仓",
            "text": "我听说，枪这种武器被发明的目的之一，就是让我这种不怎么精通武艺的人也能拿着它战斗。",
            "nextDialogs": [
              "220310108"
            ]
          },
          "220310108": {
            "id": "220310108",
            "speakerId": 3060,
            "speakerName": "朝仓",
            "text": "毕竟这种武器又长又尖，就算是拿着的人不懂枪法，只是单纯地戳刺和挥舞，看起来都很有气势。",
            "nextDialogs": [
              "220310109"
            ]
          },
          "220310109": {
            "id": "220310109",
            "speakerId": 3060,
            "speakerName": "朝仓",
            "text": "不过，按这种原则…其实我感觉那种前面有三个尖的草叉更有威力…"
          },
          "220310111": {
            "id": "220310111",
            "speakerId": 3060,
            "speakerName": "朝仓",
            "text": "武器虽然已经拿回来了，但并不能代表修炼就到此为止了。",
            "nextDialogs": [
              "220310112"
            ]
          },
          "220310112": {
            "id": "220310112",
            "speakerId": 3060,
            "speakerName": "朝仓",
            "text": "曾经会遇见海乱鬼这种家伙，未来很难说不会遇见更强大的敌人。",
            "nextDialogs": [
              "220310113"
            ]
          },
          "220310113": {
            "id": "220310113",
            "speakerId": 3060,
            "speakerName": "朝仓",
            "text": "绝不允许我的武器再次落入敌手，绝不允许武士荣耀再次受人践踏，这就是我追求的武士之道。"
          }
        }
      }
    },
    {
      "subId": "2203102",
      "subQuestName": "与朝仓对话",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "220310501"
        ],
        "dialogs": {
          "220310501": {
            "id": "220310501",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "好，那我们开始吧。",
            "nextDialogs": [
              "220310502"
            ]
          },
          "220310502": {
            "id": "220310502",
            "speakerId": 3060,
            "speakerName": "朝仓",
            "text": "没问题，您多小心了。"
          }
        }
      }
    },
    {
      "subId": "2203103",
      "subQuestName": "完成与朝仓的对练",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "220310301"
        ],
        "dialogs": {
          "220310301": {
            "id": "220310301",
            "speakerId": 3060,
            "speakerName": "朝仓",
            "text": "您刚才似乎走神了？步伐很混乱，攻击时的力道也时强时弱…",
            "nextDialogs": [
              "220310302"
            ]
          },
          "220310302": {
            "id": "220310302",
            "speakerId": 3060,
            "speakerName": "朝仓",
            "text": "这样可不行啊，请您再准备准备，我们等会再来一次吧。"
          }
        }
      }
    },
    {
      "subId": "2203104",
      "subQuestName": "与朝仓对话",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "220310401"
        ],
        "dialogs": {
          "220310401": {
            "id": "220310401",
            "speakerId": 3060,
            "speakerName": "朝仓",
            "text": "呼、呼…阁下的武艺真是远超于我…",
            "nextDialogs": [
              "220310402"
            ]
          },
          "220310402": {
            "id": "220310402",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "我下次轻点…",
            "nextDialogs": [
              "220310403"
            ]
          },
          "220310403": {
            "id": "220310403",
            "speakerId": 3060,
            "speakerName": "朝仓",
            "text": "不！请阁下还是使出全力吧，不经历磨砺，我就不会成长。",
            "nextDialogs": [
              "220310404"
            ]
          },
          "220310404": {
            "id": "220310404",
            "speakerId": 3060,
            "speakerName": "朝仓",
            "text": "您之所以如此强大，应该也是经历了无数锻炼吧…",
            "nextDialogs": [
              "220310405"
            ]
          },
          "220310405": {
            "id": "220310405",
            "speakerId": 3060,
            "speakerName": "朝仓",
            "text": "恕我唐突，我真的很好奇，您是…怎么锻炼自己的？",
            "nextDialogs": [
              "220310407",
              "220310409"
            ]
          },
          "220310407": {
            "id": "220310407",
            "speakerId": 3060,
            "speakerName": "朝仓",
            "text": "居、居然能和巨龙一起飞行，真是难以想象…",
            "nextDialogs": [
              "220310410"
            ]
          },
          "220310410": {
            "id": "220310410",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "就是…顺便而已。",
            "nextDialogs": [
              "220310411"
            ]
          },
          "220310411": {
            "id": "220310411",
            "speakerId": 3060,
            "speakerName": "朝仓",
            "text": "哈哈哈，是这样吗？那您可绝对算得上是天赋异禀了。",
            "nextDialogs": [
              "220310412"
            ]
          },
          "220310412": {
            "id": "220310412",
            "speakerId": 3060,
            "speakerName": "朝仓",
            "text": "谢谢您和我对练，这场比试，在下铭记在心。这些报酬，请您收下吧。"
          },
          "220310409": {
            "id": "220310409",
            "speakerId": 3060,
            "speakerName": "朝仓",
            "text": "听起来真是…勇武无匹。真想见识一下您和那匹巨狼战斗的场景啊…"
          }
        }
      }
    },
    {
      "subId": "2203102",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "220310201"
        ],
        "dialogs": {
          "220310201": {
            "id": "220310201",
            "speakerId": 3060,
            "speakerName": "朝仓",
            "text": "哎呀，闲话就不说了，我可不能浪费您的时间。"
          }
        }
      }
    },
    {
      "subId": "2203106",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "220310601"
        ],
        "dialogs": {
          "220310601": {
            "id": "220310601",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "还要准备一下。",
            "nextDialogs": [
              "220310602"
            ]
          },
          "220310602": {
            "id": "220310602",
            "speakerId": 12144,
            "speakerName": "朝仓",
            "text": "嗯，好好准备吧，准备好了和我说一声就行。"
          }
        }
      }
    },
    {
      "subId": "2203111",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "220311101"
        ],
        "dialogs": {
          "220311101": {
            "id": "220311101",
            "speakerId": 12144,
            "speakerName": "朝仓",
            "text": "还请阁下不要留手，全力施为啊。"
          }
        }
      }
    }
  ]
}
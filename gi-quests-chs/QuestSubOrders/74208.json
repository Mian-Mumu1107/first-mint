      "dialogue": {
        "startDialogs": [
          "742080301"
        ],
        "dialogs": {
          "742080301": {
            "id": "742080301",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "关于神秘的异色结晶石…",
            "nextDialogs": [
              "742080302"
            ]
          },
          "742080302": {
            "id": "742080302",
            "speakerId": 1000,
            "speakerName": "皮托",
            "text": "老规矩。",
            "nextDialogs": [
              "742080303"
            ]
          },
          "742080303": {
            "id": "742080303",
            "speakerId": 1000,
            "speakerName": "皮托",
            "text": "不错。不过我想之后我们应该没有机会再做这样愉快的买卖了。",
            "nextDialogs": [
              "742080304"
            ]
          },
          "742080304": {
            "id": "742080304",
            "speakerId": 1000,
            "speakerName": "皮托",
            "text": "神秘东西之所以神秘，就是因为稀少。在这之前，我也曾从冒险家手中收购过神秘的异色结晶石，但买卖只进行了三次。",
            "nextDialogs": [
              "742080305"
            ]
          },
          "742080305": {
            "id": "742080305",
            "speakerId": 1000,
            "speakerName": "皮托",
            "text": "据他说，在那之后就再也没有得到过类似的东西。或许这其中有什么我们所不知道的自然的奥妙呢。",
            "nextDialogs": [
              "742080306"
            ]
          },
          "742080306": {
            "id": "742080306",
            "speakerId": 1000,
            "speakerName": "皮托",
            "text": "要我说，为这个世界保留一点神秘也是不错的选择，对吧。"
          }
        }
      }
    }
  ]

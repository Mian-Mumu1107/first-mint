  "subQuests": [
    {
      "subId": "2004101",
      "subQuestName": "与帕琪对话",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "200410101"
        ],
        "dialogs": {
          "200410101": {
            "id": "200410101",
            "speakerId": 1589,
            "speakerName": "好奇的帕琪",
            "text": "冒险不可能有完美的方案！这么拖下去，什么时候才能有进展？",
            "nextDialogs": [
              "200410102"
            ]
          },
          "200410102": {
            "id": "200410102",
            "speakerId": 1591,
            "speakerName": "杜兰",
            "text": "就算没有完美的方案，也要做好万全的准备！",
            "nextDialogs": [
              "200410103"
            ]
          },
          "200410103": {
            "id": "200410103",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "你们在吵什么呢？",
            "nextDialogs": [
              "200410104"
            ]
          },
          "200410104": {
            "id": "200410104",
            "speakerId": 1589,
            "speakerName": "好奇的帕琪",
            "text": "我是研究古代遗迹的学者，想要去千风神殿里考察。但我不太擅长对付需要战斗的场合。",
            "nextDialogs": [
              "200410105"
            ]
          },
          "200410105": {
            "id": "200410105",
            "speakerId": 1589,
            "speakerName": "好奇的帕琪",
            "text": "杜兰先生说自己是个冒险家，把调查神殿的任务都揽了下来。",
            "nextDialogs": [
              "200410106"
            ]
          },
          "200410106": {
            "id": "200410106",
            "speakerId": 1589,
            "speakerName": "好奇的帕琪",
            "text": "我，我并不是说杜兰先生怎么样，我也知道那个遗迹守卫很麻烦，但是他说要制订一个完美的冒险方案，不停地拉着我开会研究…",
            "nextDialogs": [
              "200410107"
            ]
          },
          "200410107": {
            "id": "200410107",
            "speakerId": 1589,
            "speakerName": "好奇的帕琪",
            "text": "研究…调查…调整，然后再调查…研究…调整…我已经受不了了！",
            "nextDialogs": [
              "200410108"
            ]
          },
          "200410108": {
            "id": "200410108",
            "speakerId": 1589,
            "speakerName": "好奇的帕琪",
            "text": "他刚才又找到了一条线索，说是神殿旁边有一片怪物营地。",
            "nextDialogs": [
              "200410109"
            ]
          },
          "200410109": {
            "id": "200410109",
            "speakerId": 1589,
            "speakerName": "好奇的帕琪",
            "text": "拜托你，去把那片营地给清理掉吧！就算不能进神殿，把他的嘴堵住也好。",
            "nextDialogs": [
              "200410112"
            ]
          },
          "200410112": {
            "id": "200410112",
            "speakerId": 1589,
            "speakerName": "好奇的帕琪",
            "text": "谢谢你的好意，但是相信我…",
            "nextDialogs": [
              "200410113"
            ]
          },
          "200410113": {
            "id": "200410113",
            "speakerId": 1589,
            "speakerName": "好奇的帕琪",
            "text": "比起开会，你会更愿意对付魔物的。"
          }
        }
      }
    },
    {
      "subId": "2004102",
      "subQuestName": "清剿魔物营地",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "200410201"
        ],
        "dialogs": {
          "200410201": {
            "id": "200410201",
            "speakerId": 1589,
            "speakerName": "好奇的帕琪",
            "text": "你把那片怪物营地清理掉了吗？",
            "nextDialogs": [
              "200410202"
            ]
          },
          "200410202": {
            "id": "200410202",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "还没有…",
            "nextDialogs": [
              "200410203"
            ]
          },
          "200410203": {
            "id": "200410203",
            "speakerId": 1589,
            "speakerName": "好奇的帕琪",
            "text": "请您快点吧，再这么下去，杜兰先生又要找到新线索了…"
          }
        }
      }
    },
    {
      "subId": "2004103",
      "subQuestName": "与帕琪对话",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "200410301"
        ],
        "dialogs": {
          "200410301": {
            "id": "200410301",
            "speakerId": 1589,
            "speakerName": "好奇的帕琪",
            "text": "你把那片怪物营地清理掉了吗？",
            "nextDialogs": [
              "200410302"
            ]
          },
          "200410302": {
            "id": "200410302",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "清理掉了。",
            "nextDialogs": [
              "200410303"
            ]
          },
          "200410303": {
            "id": "200410303",
            "speakerId": 1589,
            "speakerName": "好奇的帕琪",
            "text": "太好了，我现在就去找他商量进入神殿的方法。",
            "nextDialogs": [
              "200410304"
            ]
          },
          "200410304": {
            "id": "200410304",
            "speakerId": 1589,
            "speakerName": "好奇的帕琪",
            "text": "这次他不能用其他的借口拉着我开会了！"
          }
        }
      }
    }
  ]
}
    {
      "subId": "2100440",
      "subQuestName": "取得宝藏",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "210044001"
        ],
        "dialogs": {
          "210044001": {
            "id": "210044001",
            "speakerId": 1612,
            "speakerName": "索拉雅",
            "text": "你们找到宝藏了吗？"
          }
        }
      }
    },
    {
      "subId": "2100450",
      "subQuestName": "与索拉雅对话",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "210045001"
        ],
        "dialogs": {
          "210045001": {
            "id": "210045001",
            "speakerId": 2211,
            "speakerName": "索拉雅",
            "text": "怎么样？你们找到宝藏了吗？",
            "nextDialogs": [
              "210045003"
            ]
          },
          "210045003": {
            "id": "210045003",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "找到了，确实是在「汇成之地」",
            "nextDialogs": [
              "210045004"
            ]
          },
          "210045004": {
            "id": "210045004",
            "speakerId": 2211,
            "speakerName": "索拉雅",
            "text": "原来如此…还真是和「归终四诫」里说的一样，宝藏在四诫的「汇成之地」啊。",
            "nextDialogs": [
              "210045005"
            ]
          },
          "210045005": {
            "id": "210045005",
            "speakerId": 2211,
            "speakerName": "索拉雅",
            "text": "设置谜题的那个人，一定很尊敬「归终」吧。",
            "nextDialogs": [
              "210045006"
            ]
          },
          "210045006": {
            "id": "210045006",
            "speakerId": 2211,
            "speakerName": "索拉雅",
            "text": "即使故乡被毁灭，也要以这种方式把「归终四诫」给流传下去。",
            "nextDialogs": [
              "210045007"
            ]
          },
          "210045007": {
            "id": "210045007",
            "speakerId": 2211,
            "speakerName": "索拉雅",
            "text": "而那位定下这四诫的「归终」，也一定深爱着她庇护着的子民。",
            "nextDialogs": [
              "210045008"
            ]
          },
          "210045008": {
            "id": "210045008",
            "speakerId": 2211,
            "speakerName": "索拉雅",
            "text": "她希望自己的子民们拥有智慧，用道德约束自己，祝福他们身体强健，而且团结一心，一同保护自己的家园「归离集」…",
            "nextDialogs": [
              "210045010",
              "210045017",
              "210045022"
            ]
          },
          "210045010": {
            "id": "210045010",
            "speakerId": 2211,
            "speakerName": "索拉雅",
            "text": "失败了？这么说也没错，她死去了…「归离集」被毁灭，她的子民们也流离失所。",
            "nextDialogs": [
              "210045011"
            ]
          },
          "210045011": {
            "id": "210045011",
            "speakerId": 2211,
            "speakerName": "索拉雅",
            "text": "不过，如今我们不是让她的「归终四诫」重见天日了吗？",
            "nextDialogs": [
              "210045012"
            ]
          },
          "210045012": {
            "id": "210045012",
            "speakerId": 2211,
            "speakerName": "索拉雅",
            "text": "这是那位「归终」为她的子民们亲手订下的诫语，和送上的祝福。",
            "nextDialogs": [
              "210045013"
            ]
          },
          "210045013": {
            "id": "210045013",
            "speakerId": 2211,
            "speakerName": "索拉雅",
            "text": "秉承着这份「归终四诫」，她曾经在这片大地上，和自己的子民们携手前进。",
            "nextDialogs": [
              "210045014"
            ]
          },
          "210045014": {
            "id": "210045014",
            "speakerId": 2211,
            "speakerName": "索拉雅",
            "text": "即使她已经死去了，但是她的信念和理想绝不会就此消失。",
            "nextDialogs": [
              "210045015"
            ]
          },
          "210045015": {
            "id": "210045015",
            "speakerId": 2211,
            "speakerName": "索拉雅",
            "text": "而且，那位崇敬着她的人可真是聪明，居然想到用「藏宝」的方式，把「归终四诫」给传下来。",
            "nextDialogs": [
              "210045028"
            ]
          },
          "210045028": {
            "id": "210045028",
            "speakerId": 2211,
            "speakerName": "索拉雅",
            "text": "不过，也不知道在那个人心中，真正的宝贝到底是金银珠宝，还是这份「归终四诫」呢…",
            "nextDialogs": [
              "210045029"
            ]
          },
          "210045029": {
            "id": "210045029",
            "speakerId": 2211,
            "speakerName": "索拉雅",
            "text": "哈哈，要我说，比起那些金银珠宝，这份「诫语」才是真正的宝物。",
            "nextDialogs": [
              "210045030"
            ]
          },
          "210045030": {
            "id": "210045030",
            "speakerId": 2211,
            "speakerName": "索拉雅",
            "text": "…但是，要真让人选，又有多少人会抛弃财宝，选这份「诫语」呢？唉…"
          },
          "210045017": {
            "id": "210045017",
            "speakerId": 2211,
            "speakerName": "索拉雅",
            "text": "用「温柔」来形容一位「魔神」，真是感觉有点不搭边际…",
            "nextDialogs": [
              "210045018"
            ]
          },
          "210045018": {
            "id": "210045018",
            "speakerId": 2211,
            "speakerName": "索拉雅",
            "text": "在很久很久之前，在那些引导着人们的魔神之中，也许真有「温柔」的魔神吧。",
            "nextDialogs": [
              "210045019"
            ]
          },
          "210045019": {
            "id": "210045019",
            "speakerId": 2211,
            "speakerName": "索拉雅",
            "text": "保护着自己的子民，和他们一同在这片大地上漫步，一同携手前进。",
            "nextDialogs": [
              "210045020"
            ]
          },
          "210045020": {
            "id": "210045020",
            "speakerId": 2211,
            "speakerName": "索拉雅",
            "text": "…不过这样温柔的魔神，最终还是什么也没能保护下来。就连她给自己子民的诫语，都要借助「宝藏」这种东西才能流传下来。"
          },
          "210045022": {
            "id": "210045022",
            "speakerId": 2211,
            "speakerName": "索拉雅",
            "text": "居然想要去见魔神，你还真是异想天开。",
            "nextDialogs": [
              "210045023"
            ]
          },
          "210045023": {
            "id": "210045023",
            "speakerId": 2211,
            "speakerName": "索拉雅",
            "text": "不过，如果你真见到了「归终」，你会做什么？",
            "nextDialogs": [
              "210045024"
            ]
          },
          "210045024": {
            "id": "210045024",
            "speakerId": 2211,
            "speakerName": "索拉雅",
            "text": "难道想要说「辛苦了」、「谢谢你」之类的话，来安慰她吗？",
            "nextDialogs": [
              "210045025"
            ]
          },
          "210045025": {
            "id": "210045025",
            "speakerId": 2211,
            "speakerName": "索拉雅",
            "text": "如果要我说的话，不如流利背诵一遍「归终四诫」吧。",
            "nextDialogs": [
              "210045026"
            ]
          },
          "210045026": {
            "id": "210045026",
            "speakerId": 2211,
            "speakerName": "索拉雅",
            "text": "然后告诉她，她的信念和理想还没有消失，这片大地上还有人牢记着她的教诲。",
            "nextDialogs": [
              "210045027"
            ]
          },
          "210045027": {
            "id": "210045027",
            "speakerId": 2211,
            "speakerName": "索拉雅",
            "text": "对于已经失去了一切的「归终」来说，也许…这才是最好的安慰吧。"
          }
        }
      }
    },
    {
      "subId": "2100409",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "210040901"
        ],
        "dialogs": {
          "210040901": {
            "id": "210040901",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "再见。",
            "nextDialogs": [
              "210040902"
            ]
          },
          "210040902": {
            "id": "210040902",
            "speakerId": 1612,
            "speakerName": "索拉雅",
            "text": "要走了吗？有什么新奇的故事，记得回来告诉我啊。"
          }
        }
      }
    },
    {
      "subId": "2100490",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "210049001"
        ],
        "dialogs": {
          "210049001": {
            "id": "210049001",
            "speakerId": 1612,
            "speakerName": "索拉雅",
            "text": "（Test）在这个「传说」里，究竟隐藏着什么秘密呢…",
            "nextDialogs": [
              "210049002"
            ]
          },
          "210049002": {
            "id": "210049002",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "（Test）关于「传说」的详情…",
            "nextDialogs": [
              "210049003"
            ]
          },
          "210049003": {
            "id": "210049003",
            "speakerId": 1612,
            "speakerName": "索拉雅",
            "text": "（Test）你也对这里的传说感兴趣吗？唔，这段「传说」是这样的…",
            "nextDialogs": [
              "210049004"
            ]
          },
          "210049004": {
            "id": "210049004",
            "speakerId": 1612,
            "speakerName": "索拉雅",
            "text": "（Test）「在智慧与意志、团结与坚毅如水汇聚之处，我将展露大地丰饶的宝藏。」",
            "nextDialogs": [
              "210049005"
            ]
          },
          "210049005": {
            "id": "210049005",
            "speakerId": 1612,
            "speakerName": "索拉雅",
            "text": "（Test）我猜测，「智慧」、「意志」，「团结」和「坚毅」这四个词，应该指代的是某些具体的事物。",
            "nextDialogs": [
              "210049006"
            ]
          },
          "210049006": {
            "id": "210049006",
            "speakerId": 1612,
            "speakerName": "索拉雅",
            "text": "（Test）我在探查山扉城往事的过程中，曾经到过一处遗迹…里面有和这个类似的文字。",
            "nextDialogs": [
              "210049007"
            ]
          },
          "210049007": {
            "id": "210049007",
            "speakerId": 1612,
            "speakerName": "索拉雅",
            "text": "如果我的猜想是对的，那四个词，指代的应该就是四处遗迹。",
            "nextDialogs": [
              "210049008"
            ]
          },
          "210049008": {
            "id": "210049008",
            "speakerId": 1612,
            "speakerName": "索拉雅",
            "text": "把这四处遗迹全部发现的话，说不定就能将那段「传说」完全解读。",
            "nextDialogs": [
              "210049009"
            ]
          },
          "210049009": {
            "id": "210049009",
            "speakerId": 1612,
            "speakerName": "索拉雅",
            "text": "不过，我的体力不太好…光是发现那一处遗迹，回来就歇了好多天。",
            "nextDialogs": [
              "210049010"
            ]
          },
          "210049010": {
            "id": "210049010",
            "speakerId": 1612,
            "speakerName": "索拉雅",
            "text": "如果你有兴趣的话，不如就去找找吧，也许…你会在我之前发现什么突破点呢。"
          }
        }
      }
    },
    {
      "subId": "2100492",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "210049201"
        ],
        "dialogs": {
          "210049201": {
            "id": "210049201",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "关于「归终四诫」…",
            "nextDialogs": [
              "210049202"
            ]
          },
          "210049202": {
            "id": "210049202",
            "speakerId": 1612,
            "speakerName": "索拉雅",
            "text": "哦，你有些记不清「归终四诫」了吗？没关系，这种东西确实挺难记，不过，我的记忆力还算不错。",
            "nextDialogs": [
              "210049203"
            ]
          },
          "210049203": {
            "id": "210049203",
            "speakerId": 1612,
            "speakerName": "索拉雅",
            "text": "「归终四诫」的内容是「教之以智、律之以德、坚其筋骨，众志一心，四者汇之而成『归离集』。」"
          }
        }
      }
    },
    {
      "subId": "2100493",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "210049301"
        ],
        "dialogs": {
          "210049301": {
            "id": "210049301",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "也许是魔神之间的领地争斗…",
            "nextDialogs": [
              "210049302"
            ]
          },
          "210049302": {
            "id": "210049302",
            "speakerId": 1612,
            "speakerName": "索拉雅",
            "text": "…领地吗？但是根据这里说的，「归离集」在「归终」的治理下，一直安稳地存在了很长时间。",
            "nextDialogs": [
              "210049303"
            ]
          },
          "210049303": {
            "id": "210049303",
            "speakerId": 1612,
            "speakerName": "索拉雅",
            "text": "虽然感觉「归终」并不是什么拥有强大力量的魔神…",
            "nextDialogs": [
              "210049304"
            ]
          },
          "210049304": {
            "id": "210049304",
            "speakerId": 1612,
            "speakerName": "索拉雅",
            "text": "但「归离集」里不仅有「归终」，似乎还存在着另外一位魔神，绝不会有人傻到对两位魔神一同发动攻击。"
          }
        }
      }
    },
    {
      "subId": "2100494",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "210049401"
        ],
        "dialogs": {
          "210049401": {
            "id": "210049401",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "因为…宝物？",
            "nextDialogs": [
              "210049402"
            ]
          },
          "210049402": {
            "id": "210049402",
            "speakerId": 1612,
            "speakerName": "索拉雅",
            "text": "那可是堂堂的魔神，绝不会因为一点财宝而轻易大动干戈。",
            "nextDialogs": [
              "210049403"
            ]
          },
          "210049403": {
            "id": "210049403",
            "speakerId": 1612,
            "speakerName": "索拉雅",
            "text": "而且，就算是以这个思路想下去，能够引起魔神彼此争斗的财宝…",
            "nextDialogs": [
              "210049404"
            ]
          },
          "210049404": {
            "id": "210049404",
            "speakerId": 1612,
            "speakerName": "索拉雅",
            "text": "…哈哈，我是想象不出来，到底是什么。"
          }
        }
      }
    },
    {
      "subId": "2100495",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "210049501"
        ],
        "dialogs": {
          "210049501": {
            "id": "210049501",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "呃，说不定是和另外哪位魔神…",
            "nextDialogs": [
              "210049502"
            ]
          },
          "210049502": {
            "id": "210049502",
            "speakerId": 1612,
            "speakerName": "索拉雅",
            "text": "你…到底是怎么会…这么想的，不要把璃月港里那些虚构的故事套入现实里来。",
            "nextDialogs": [
              "210049503"
            ]
          },
          "210049503": {
            "id": "210049503",
            "speakerId": 1612,
            "speakerName": "索拉雅",
            "text": "「归终」贵为魔神，怎么可能和凡人一样…",
            "nextDialogs": [
              "210049504"
            ]
          },
          "210049504": {
            "id": "210049504",
            "speakerId": 1612,
            "speakerName": "索拉雅",
            "text": "一…一定，呃，应该…不会吧…"
          }
        }
      }
    },
    {
      "subId": "2100496",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "210049601"
        ],
        "dialogs": {
          "210049601": {
            "id": "210049601",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "我也不知道为什么…",
            "nextDialogs": [
              "210049602"
            ]
          },
          "210049602": {
            "id": "210049602",
            "speakerId": 1612,
            "speakerName": "索拉雅",
            "text": "难道，还是因为那场「魔神战争」。",
            "nextDialogs": [
              "210049603"
            ]
          },
          "210049603": {
            "id": "210049603",
            "speakerId": 1612,
            "speakerName": "索拉雅",
            "text": "为了那七个天空岛上的神座，魔神们之间掀起的无尽争斗。",
            "nextDialogs": [
              "210049604"
            ]
          },
          "210049604": {
            "id": "210049604",
            "speakerId": 1612,
            "speakerName": "索拉雅",
            "text": "看来在那场战争里，这个世界上没有谁能真正置身事外。"
          }
        }
      }
    },
    {
      "subId": "2100497",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "210049701"
        ],
        "dialogs": {
          "210049701": {
            "id": "210049701",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "再见。",
            "nextDialogs": [
              "210049702"
            ]
          },
          "210049702": {
            "id": "210049702",
            "speakerId": 1612,
            "speakerName": "索拉雅",
            "text": "再见，如果有什么发现的话，就回来告诉我吧。"
          }
        }
      }
    }
  ]
}
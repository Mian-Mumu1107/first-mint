    {
      "subId": "2100420",
      "subQuestName": "询问索拉雅",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "210042001"
        ],
        "dialogs": {
          "210042001": {
            "id": "210042001",
            "speakerId": 2211,
            "speakerName": "索拉雅",
            "text": "即使是魔神，也有着逃不脱的命运…",
            "nextDialogs": [
              "210042002"
            ]
          },
          "210042002": {
            "id": "210042002",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "在四个遗迹里找到了四条线索。",
            "nextDialogs": [
              "210042003"
            ]
          },
          "210042003": {
            "id": "210042003",
            "speakerId": 2211,
            "speakerName": "索拉雅",
            "text": "四个遗迹，四条线索…刚好和「归终四诫」的诫语数量一样。",
            "nextDialogs": [
              "210042004"
            ]
          },
          "210042004": {
            "id": "210042004",
            "speakerId": 2211,
            "speakerName": "索拉雅",
            "text": "不过，这四句话都是关于「归终四诫」中某一条的解释。",
            "nextDialogs": [
              "210042005"
            ]
          },
          "210042005": {
            "id": "210042005",
            "speakerId": 2211,
            "speakerName": "索拉雅",
            "text": "想要正确解读，「归终四诫」的原文应该才是关键，这四条都是辅助。",
            "nextDialogs": [
              "210042006"
            ]
          },
          "210042006": {
            "id": "210042006",
            "speakerId": 2211,
            "speakerName": "索拉雅",
            "text": "要把这五段话都结合起来，但是到底该怎么理解呢？",
            "nextDialogs": [
              "210042007"
            ]
          },
          "210042007": {
            "id": "210042007",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "「汇之而成」…",
            "nextDialogs": [
              "210042008"
            ]
          },
          "210042008": {
            "id": "210042008",
            "speakerId": 2211,
            "speakerName": "索拉雅",
            "text": "汇之而成…听起来像是在说，这四段话可以用某种方式结合起来…",
            "nextDialogs": [
              "210042009"
            ]
          },
          "210042009": {
            "id": "210042009",
            "speakerId": 2211,
            "speakerName": "索拉雅",
            "text": "等等，我记得，这四段「诫语」都各自存在于某一处遗迹之中…",
            "nextDialogs": [
              "210042010"
            ]
          },
          "210042010": {
            "id": "210042010",
            "speakerId": 2211,
            "speakerName": "索拉雅",
            "text": "唔…我有一个不成熟的猜测。如果想要解读这四段「诫语」，也许还需要借助一下这些「诫语」各自所在的<color=#00E1FFFF>「遗迹」</color>…",
            "nextDialogs": [
              "210042011"
            ]
          },
          "210042011": {
            "id": "210042011",
            "speakerId": 2211,
            "speakerName": "索拉雅",
            "text": "不过，具体的解读方式，我还要再思考一下…你也可以想想，如果有什么好想法，直接去付诸实施也可以。",
            "nextDialogs": [
              "210042012"
            ]
          },
          "210042012": {
            "id": "210042012",
            "speakerId": 2211,
            "speakerName": "索拉雅",
            "text": "毕竟你不像我这个「弱不禁风」的学者，跑几步就没劲了…唉，真羡慕你，有这么好的体力…",
            "nextDialogs": [
              "210042013"
            ]
          },
          "210042013": {
            "id": "210042013",
            "speakerId": 2211,
            "speakerName": "索拉雅",
            "text": "好了，我再在这里仔细思考一下，如果你有什么想法，或者发现的话，就来告诉我吧。"
          }
        }
      }
    },
    {
      "subId": "2100421",
      "subQuestName": "找到最后的遗迹$HIDDEN",
      "sceneId": null,
      "locations": [],
      "dialogue": {

  "subQuests": [
    {
      "subId": "2100401",
      "subQuestName": "与索拉雅对话",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "210040101"
        ],
        "dialogs": {
          "210040101": {
            "id": "210040101",
            "speakerId": 2211,
            "speakerName": "索拉雅",
            "text": "「归终四诫」…到底是在暗示什么呢…",
            "nextDialogs": [
              "210040103",
              "210040105"
            ]
          },
          "210040103": {
            "id": "210040103",
            "speakerId": 2211,
            "speakerName": "索拉雅",
            "text": "哈哈哈，你可真有干劲，那好吧，我们开始解读一下这个「归终四诫」。",
            "nextDialogs": [
              "210040106"
            ]
          },
          "210040106": {
            "id": "210040106",
            "speakerId": 2211,
            "speakerName": "索拉雅",
            "text": "「教之以智、律之以德、坚其筋骨，众志一心，四者汇之而成『归离集』。」",
            "nextDialogs": [
              "210040107"
            ]
          },
          "210040107": {
            "id": "210040107",
            "speakerId": 2211,
            "speakerName": "索拉雅",
            "text": "从字面上来看，确实是类似于一种对于日常生活的「劝诫」。",
            "nextDialogs": [
              "210040108"
            ]
          },
          "210040108": {
            "id": "210040108",
            "speakerId": 2211,
            "speakerName": "索拉雅",
            "text": "不过，这句话哪里是在暗示着宝藏的线索呢…",
            "nextDialogs": [
              "210040109"
            ]
          },
          "210040109": {
            "id": "210040109",
            "speakerId": 2211,
            "speakerName": "索拉雅",
            "text": "…没办法了，还是用我们学者最笨，也是最自讨苦吃的方法吧。",
            "nextDialogs": [
              "210040110"
            ]
          },
          "210040110": {
            "id": "210040110",
            "speakerId": 2211,
            "speakerName": "索拉雅",
            "text": "先前，我们发现那七段话的地方，都是在各种形式的「遗迹」里。",
            "nextDialogs": [
              "210040111"
            ]
          },
          "210040111": {
            "id": "210040111",
            "speakerId": 2211,
            "speakerName": "索拉雅",
            "text": "既然现在我们不知道如何入手，那么，就继续去搜索「遗迹」看看吧。"
          },
          "210040105": {
            "id": "210040105",
            "speakerId": 2211,
            "speakerName": "索拉雅",
            "text": "一说到宝藏，感觉你就精神焕发…算了，我们开始解读这个「归终四诫」吧。"
          }
        }
      }
    },
    {
      "subId": "2100402",
      "subQuestName": "询问索拉雅关于附近的传说2$HIDDEN",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "210040201"
        ],
        "dialogs": {
          "210040201": {
            "id": "210040201",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "我有兴趣。",
            "nextDialogs": [
              "210040202"
            ]
          },
          "210040202": {
            "id": "210040202",
            "speakerId": 1612,
            "speakerName": "索拉雅",
            "text": "我把已经发现的那片遗迹标在你的地图上了，你先去那里看看吧。",
            "nextDialogs": [
              "210040203"
            ]
          },
          "210040203": {
            "id": "210040203",
            "speakerId": 1612,
            "speakerName": "索拉雅",
            "text": "对了，如果找到了什么线索，可别太兴奋，记得<color=#00E1FFFF>先记下来</color>，再慢慢解读啊。"
          }
        }
      }
    },

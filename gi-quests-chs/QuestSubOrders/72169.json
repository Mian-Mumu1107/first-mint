    {
      "subId": "7216904",
      "subQuestName": "与旭东对话",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "721690301"
        ],
        "dialogs": {
          "721690301": {
            "id": "721690301",
            "speakerId": 20268,
            "speakerName": "旭东",
            "text": "壳壳烧…为什么要叫壳壳烧呢…",
            "nextDialogs": [
              "721690302"
            ]
          },
          "721690302": {
            "id": "721690302",
            "speakerId": 20268,
            "speakerName": "旭东",
            "text": "算了，还是先做出来再说吧。",
            "nextDialogs": [
              "721690303"
            ]
          },
          "721690303": {
            "id": "721690303",
            "speakerId": 20268,
            "speakerName": "旭东",
            "text": "完成了！这就是「蟹黄壳壳烧」了。",
            "nextDialogs": [
              "721690304"
            ]
          },
          "721690304": {
            "id": "721690304",
            "speakerId": 20269,
            "speakerName": "朱莉",
            "text": "我要一个！嗯…就这个好了！",
            "nextDialogs": [
              "721690305"
            ]
          },
          "721690305": {
            "id": "721690305",
            "speakerId": 20270,
            "speakerName": "芭尔瓦涅",
            "text": "给我个小一点的，太大的我可吃不完…",
            "nextDialogs": [
              "721690306"
            ]
          },
          "721690306": {
            "id": "721690306",
            "speakerId": 20268,
            "speakerName": "旭东",
            "text": "喏，这一份是你的，旅行者。",
            "nextDialogs": [
              "721690307"
            ]
          },
          "721690307": {
            "id": "721690307",
            "speakerId": 20268,
            "speakerName": "旭东",
            "text": "还有这份「蟹黄壳壳烧」的制作方法，我也给你抄了一份。",
            "nextDialogs": [
              "721690308"
            ]
          },
          "721690308": {
            "id": "721690308",
            "speakerId": 20268,
            "speakerName": "旭东",
            "text": "这道菜做起来倒还算简单，你有空的话也自己试试看吧。",
            "nextDialogs": [
              "721690311"
            ]
          },
          "721690311": {
            "id": "721690311",
            "speakerId": 20268,
            "speakerName": "旭东",
            "text": "接下来我们准备去<color=#00E1FFFF>八酝岛</color>附近转转，如果你有空的话，可以来找我们。",
            "nextDialogs": [
              "721690309"
            ]
          },
          "721690309": {
            "id": "721690309",
            "speakerId": 20268,
            "speakerName": "旭东",
            "text": "好了，我也得去吃一点了…",
            "nextDialogs": [
              "721690310"
            ]
          },
          "721690310": {
            "id": "721690310",
            "speakerId": 20268,
            "speakerName": "旭东",
            "text": "喂！朱莉！给我留一个，别吃完了啊！"
          }
        }
      }
    },
    {

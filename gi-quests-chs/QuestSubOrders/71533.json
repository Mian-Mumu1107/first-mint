    {
      "subId": "7153301",
      "subQuestName": "与米卡对话",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "715330101"
        ],
        "dialogs": {
          "715330101": {
            "id": "715330101",
            "speakerId": 1000,
            "speakerName": "米卡",
            "text": "…唔，感觉也不太对，这种「祝柬」，真难做啊。",
            "nextDialogs": [
              "715330102"
            ]
          },
          "715330102": {
            "id": "715330102",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "米卡，你在做「祝柬」吗？",
            "nextDialogs": [
              "715330103"
            ]
          },
          "715330103": {
            "id": "715330103",
            "speakerId": 1000,
            "speakerName": "米卡",
            "text": "#欸？{NICKNAME}，居然能遇见你，真巧了。",
            "nextDialogs": [
              "715330104"
            ]
          },
          "715330104": {
            "id": "715330104",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "你是来璃月过海灯节的么？",
            "nextDialogs": [
              "715330105"
            ]
          },
          "715330105": {
            "id": "715330105",
            "speakerId": 1000,
            "speakerName": "米卡",
            "text": "欸？不是不是，我来璃月港本来是为了执行递送信件的任务，刚巧遇上了海灯节。",
            "nextDialogs": [
              "715330106"
            ]
          },
          "715330106": {
            "id": "715330106",
            "speakerId": 1000,
            "speakerName": "米卡",
            "text": "我来之前听可莉前辈说，她很想要一封海灯节的「祝柬」，就想着顺便买一封回去。",
            "nextDialogs": [
              "715330107"
            ]
          },
          "715330107": {
            "id": "715330107",
            "speakerId": 1000,
            "speakerName": "米卡",
            "text": "结果，没想到要自己做…",
            "nextDialogs": [
              "715330108"
            ]
          },
          "715330108": {
            "id": "715330108",
            "speakerId": 1000,
            "speakerName": "米卡",
            "text": "我做了半天，却总觉得做出来的「祝柬」不太对…但也不知道具体哪里不对…",
            "nextDialogs": [
              "715330109"
            ]
          },
          "715330109": {
            "id": "715330109",
            "speakerId": 1000,
            "speakerName": "米卡",
            "text": "#{NICKNAME}，你见多识广…能给我点制作「祝柬」的建议吗？",
            "nextDialogs": [
              "715330110"
            ]
          },
          "715330110": {
            "id": "715330110",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "让我思考一下…"
          }
        }
      }
    },

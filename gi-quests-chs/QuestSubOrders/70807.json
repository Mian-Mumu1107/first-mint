  "subQuests": [
    {
      "subId": "7080701",
      "subQuestName": "(test)隐藏$HIDDEN",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "618130101"
        ],
        "dialogs": {
          "618130101": {
            "id": "618130101",
            "speakerId": 1000,
            "speakerName": "「揭秘·星空的骗局」",
            "text": "（告示用一种极其显眼的荧光色颜料书写，对眼睛很不友好。）",
            "nextDialogs": [
              "618130102"
            ]
          },
          "618130102": {
            "id": "618130102",
            "speakerId": 1000,
            "speakerName": "「揭秘·星空的骗局」",
            "text": "蒙德市民们，当心了！",
            "nextDialogs": [
              "618130103"
            ]
          },
          "618130103": {
            "id": "618130103",
            "speakerId": 1000,
            "speakerName": "「揭秘·星空的骗局」",
            "text": "该社区住着一位自我标榜清贫高洁的占星术士，实则是潜伏在蒙德的头号危险人物。",
            "nextDialogs": [
              "618130104"
            ]
          },
          "618130104": {
            "id": "618130104",
            "speakerId": 1001,
            "speakerName": "回复",
            "text": "欸？是说我吗？你是不是搞错了，这是我老家的旧宅，我不常住这。",
            "nextDialogs": [
              "618130105"
            ]
          },
          "618130105": {
            "id": "618130105",
            "speakerId": 1000,
            "speakerName": "「揭秘·星空的骗局」",
            "text": "终于出现了吗！魔女A的盟友魔女B，或者我应该尊称您一声——梅姬斯图斯老太婆？",
            "nextDialogs": [
              "618130106"
            ]
          },
          "618130106": {
            "id": "618130106",
            "speakerId": 1000,
            "speakerName": "「揭秘·星空的骗局」",
            "text": "我已经查阅了艾莉丝的旧手稿（虽然只有半页）：许多年前，伟大的占星术士曾与她在提瓦特边界进行过一场惊天动地的魔法对决！",
            "nextDialogs": [
              "618130107"
            ]
          },
          "618130107": {
            "id": "618130107",
            "speakerId": 1001,
            "speakerName": "回复",
            "text": "谁是老太婆啊！「梅姬斯图斯」是名号，是传承！那个跟艾莉丝对决的是我的师父！她才是真正的老太婆，不是我！",
            "nextDialogs": [
              "618130108"
            ]
          },
          "618130108": {
            "id": "618130108",
            "speakerId": 1000,
            "speakerName": "「揭秘·星空的骗局」",
            "text": "别狡辩了！你那贫穷的生活，其实是因为你需要购买昂贵的炼金材料，用在禁忌的「返老还童」巫术中。",
            "nextDialogs": [
              "618130109"
            ]
          },
          "618130109": {
            "id": "618130109",
            "speakerId": 1000,
            "speakerName": "「揭秘·星空的骗局」",
            "text": "你把自己关在屋子里不肯出来，是不是因为一旦晒到太阳，你那苍老的真面目就会显露出来？",
            "nextDialogs": [
              "618130110"
            ]
          },
          "618130110": {
            "id": "618130110",
            "speakerId": 1000,
            "speakerName": "「揭秘·星空的骗局」",
            "text": "别躲了，老太婆！快出来面对我的审判！把你那张画皮撕下来，我知道你实际上已经几百岁了！",
            "nextDialogs": [
              "618130111"
            ]
          },
          "618130111": {
            "id": "618130111",
            "speakerId": 1001,
            "speakerName": "回复",
            "text": "我很年轻，那是胶原蛋白不是巫术！我穷是因为我买了最新款的星盘！还有，都说了我不住这，当然不会从这里的屋子里出来啊！",
            "nextDialogs": [
              "618130112"
            ]
          },
          "618130112": {
            "id": "618130112",
            "speakerId": 1000,
            "speakerName": "「揭秘·星空的骗局」",
            "text": "在此，我代表清醒的少数人发出最后通牒： 魔女B，交出你同伙的线索，别躲在里面不出声，我知道你在家！",
            "nextDialogs": [
              "618130113"
            ]
          },
          "618130113": {
            "id": "618130113",
            "speakerId": 1001,
            "speakerName": "回复",
            "text": "算了，我为什么要跟一个拿着荧光笔乱涂乱画的小鬼解释这些？",
            "nextDialogs": [
              "618130114"
            ]
          },
          "618130114": {
            "id": "618130114",
            "speakerId": 1002,
            "speakerName": "骑士团的留言",
            "text": "致莫娜小姐：您的举报我们已经收到。那个喊着「这就是大人的肮脏世界吗」并试图撬锁的孩子，已经被阿贝多先生领走了。",
            "nextDialogs": [
              "618130115"
            ]
          },
          "618130115": {
            "id": "618130115",
            "speakerId": 1002,
            "speakerName": "骑士团的留言",
            "text": "这张告示请您自行处理。另：关于清理荧光颜料的费用，骑士团无法报销。"
          }
        }
      }
    }
  ]
}
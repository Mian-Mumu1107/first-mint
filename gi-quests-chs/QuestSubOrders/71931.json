        "dialogs": {
          "719310101": {
            "id": "719310101",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "璃月的旅行感觉如何？",
            "nextDialogs": [
              "719310102"
            ]
          },
          "719310102": {
            "id": "719310102",
            "speakerId": 1612,
            "speakerName": "索拉雅",
            "text": "非常不错，除了诸多遗迹和历史之外，璃月本地的风土人情也很有意思。",
            "nextDialogs": [
              "719310103"
            ]
          },
          "719310103": {
            "id": "719310103",
            "speakerId": 1612,
            "speakerName": "索拉雅",
            "text": "毕竟很多风俗的由来也是有着历史故事，光是研究这些就能学到很多。",
            "nextDialogs": [
              "719310104"
            ]
          },
          "719310104": {
            "id": "719310104",
            "speakerId": 1612,
            "speakerName": "索拉雅",
            "text": "就像这本我们须弥学者出品的《璃月风土志·绣球》，里面记载的便是璃月地区婚姻相关的习俗。",
            "nextDialogs": [
              "719310105"
            ]
          },
          "719310105": {
            "id": "719310105",
            "speakerId": 1612,
            "speakerName": "索拉雅",
            "text": "如果感兴趣的话就拿去看看吧，还是很有趣的。"
          }
        }
      }
    }
  ]

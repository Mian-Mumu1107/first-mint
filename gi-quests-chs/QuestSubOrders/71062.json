    {
      "subId": "7106213",
      "subQuestName": "隐藏判断是否选择入战$HIDDEN",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "710620120"
        ],
        "dialogs": {
          "710620120": {
            "id": "710620120",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "（准备战斗）好吧，我只能帮你们束手就擒。"
          }
        }
      }
    },
    {
      "subId": "7106201",
      "subQuestName": "与愚人众对话$HIDDEN",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "710620137"
        ],
        "dialogs": {
          "710620137": {
            "id": "710620137",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "先告诉我你们的目的。",
            "nextDialogs": [
              "710620140"
            ]
          },
          "710620140": {
            "id": "710620140",
            "speakerId": 20536,
            "speakerName": "安东",
            "text": "这么说吧，不论你们怀着怎样的疑虑…我们的任务只针对层岩巨渊的灾难之源。",
            "nextDialogs": [
              "710620141"
            ]
          },
          "710620141": {
            "id": "710620141",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "什么灾难呀…层岩巨渊不是还好好的吗？",
            "nextDialogs": [
              "710620142"
            ]
          },
          "710620142": {
            "id": "710620142",
            "speakerId": 20536,
            "speakerName": "安东",
            "text": "五百年前的灾变，只是战争的前奏而已。对抗漆黑大敌的战争一直持续着，而战场之一就在我们的脚下。",
            "nextDialogs": [
              "710620143"
            ]
          },
          "710620143": {
            "id": "710620143",
            "speakerId": 20549,
            "speakerName": "达尼拉",
            "text": "唉，我们的上士连长都饿到说大话了…",
            "nextDialogs": [
              "710620144"
            ]
          },
          "710620144": {
            "id": "710620144",
            "speakerId": 20551,
            "speakerName": "提莫尔",
            "text": "他一直都爱说大话…可说胡话还是第一次。",
            "nextDialogs": [
              "710620145"
            ]
          },
          "710620145": {
            "id": "710620145",
            "speakerId": 20550,
            "speakerName": "拉多米尔",
            "text": "算啦，算啦…安托哈说的是这个道理。简单来说就是…你们，璃月人，不是我们的敌人。",
            "nextDialogs": [
              "710620146"
            ]
          },
          "710620146": {
            "id": "710620146",
            "speakerId": 20536,
            "speakerName": "安东",
            "text": "至少不是我们第九连队在这场行动中的敌人…不过，另一些被打散的弟兄就不一定了。",
            "nextDialogs": [
              "710620147"
            ]
          },
          "710620147": {
            "id": "710620147",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "出于人道我会帮你，但下不为例。",
            "nextDialogs": [
              "710620148"
            ]
          },
          "710620148": {
            "id": "710620148",
            "speakerId": 20536,
            "speakerName": "安东",
            "text": "谢谢…谢谢你们，我们是不会忘记的。"
          }
        }
      }
    },
    {
      "subId": "7106209",
      "subQuestName": "击败眼前的愚人众连队",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "710620901"
        ],
        "dialogs": {
          "710620901": {
            "id": "710620901",
            "speakerId": 20536,
            "speakerName": "安东",
            "text": "唉…真是抱歉。我们的指挥网络发生了一点小小的…故障…",
            "nextDialogs": [
              "710620902"
            ]
          },
          "710620902": {
            "id": "710620902",
            "speakerId": 20549,
            "speakerName": "达尼拉",
            "text": "「小小的」！「故障」？！我们在手足相残了！我们在眼睁睁看着外人把自己的战友打跑！",
            "nextDialogs": [
              "710620903"
            ]
          },
          "710620903": {
            "id": "710620903",
            "speakerId": 20551,
            "speakerName": "提莫尔",
            "text": "否则呢？我们要让他们把我们打跑，抢走我们的食物吗？我建议你把嘴里的东西都咽下去再说话！",
            "nextDialogs": [
              "710620904"
            ]
          },
          "710620904": {
            "id": "710620904",
            "speakerId": 20550,
            "speakerName": "拉多米尔",
            "text": "安托哈，不要轻描淡写了…我们的指挥网络被摧毁了，完蛋了。尉官以上的所有军官都牺牲或失踪了…除了撤退别无选择。",
            "nextDialogs": [
              "710620905"
            ]
          },
          "710620905": {
            "id": "710620905",
            "speakerId": 20536,
            "speakerName": "安东",
            "text": "但很多人还不愿意撤退…他们宁愿守着长官的遗物战到最后一人倒下。",
            "nextDialogs": [
              "710620906"
            ]
          },
          "710620906": {
            "id": "710620906",
            "speakerId": 20549,
            "speakerName": "达尼拉",
            "text": "是饿到最后一人…按照合作协议，上面给我们输送食物和命令，但我们很久没有接到上面的消息了。",
            "nextDialogs": [
              "710620907"
            ]
          },
          "710620907": {
            "id": "710620907",
            "speakerId": 20551,
            "speakerName": "提莫尔",
            "text": "我们对愚人众和执行官大人的忠诚不容质疑是没错，但我们也不是傻子…至于现在这种情况，唯有撤离才是上策。",
            "nextDialogs": [
              "710620908"
            ]
          },
          "710620908": {
            "id": "710620908",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "所以你们有何打算？",
            "nextDialogs": [
              "710620909"
            ]
          },
          "710620909": {
            "id": "710620909",
            "speakerId": 20536,
            "speakerName": "安东",
            "text": "嗯…我知道，这事可能与你无关。如果你想转头就走也悉听尊便，但我们确实陷入了绝境，急需你的帮助…",
            "nextDialogs": [
              "710620911"
            ]
          },
          "710620911": {
            "id": "710620911",
            "speakerId": 20536,
            "speakerName": "安东",
            "text": "好吧…前路请注意安全。还留在周围的其他战友们就不会像我们这样友好了。",
            "nextDialogs": [
              "710620913"
            ]
          },
          "710620913": {
            "id": "710620913",
            "speakerId": 20536,
            "speakerName": "安东",
            "text": "虽然告知你很不合适，但…在靠近地面的地方有一处补给站。负责为我们转运物资，有时也负责传送命令。",
            "nextDialogs": [
              "710620914"
            ]
          },
          "710620914": {
            "id": "710620914",
            "speakerId": 20536,
            "speakerName": "安东",
            "text": "此前派出了几位战友上去请求调拨食物，但他们一直没有回来…我担负不起再一次冒险了。",
            "nextDialogs": [
              "710620915"
            ]
          },
          "710620915": {
            "id": "710620915",
            "speakerId": 20536,
            "speakerName": "安东",
            "text": "而补给站那边也很久没有下来过人了…我们希望你能替我们前去侦查一下他们的情况。"
          }
        }
      }
    },
    {
      "subId": "7106202",
      "subQuestName": "将一些食物交给愚人众",
      "sceneId": null,

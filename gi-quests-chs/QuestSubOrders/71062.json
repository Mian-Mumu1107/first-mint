      }
    },
    {
      "subId": "7106201",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "710620101"
        ],
        "dialogs": {
          "710620101": {
            "id": "710620101",
            "speakerId": 20536,
            "speakerName": "安东",
            "text": "呼…如果你们在赶路的话抱歉打扰，我是安东·梅利尼科夫上士，第九连队的…代理连长。叫我安东就好。",
            "nextDialogs": [
              "710620102"
            ]
          },
          "710620102": {
            "id": "710620102",
            "speakerId": 20536,
            "speakerName": "安东",
            "text": "这几位，分别是达尼拉、提莫尔、拉多米尔和…呃，罗曼斯基，他现在不在这里，他在…卫生营地。",
            "nextDialogs": [
              "710620103"
            ]
          },
          "710620103": {
            "id": "710620103",
            "speakerId": 20549,
            "speakerName": "达尼拉",
            "text": "没有罗曼斯基了，也没有卫生营地了，安托哈…他没撑过今早。",
            "nextDialogs": [
              "710620104"
            ]
          },
          "710620104": {
            "id": "710620104",
            "speakerId": 20536,
            "speakerName": "安东",
            "text": "达尼拉，达尼拉…我说过多少次了，我是连长，叫我安东上士！",
            "nextDialogs": [
              "710620105"
            ]
          },
          "710620105": {
            "id": "710620105",
            "speakerId": 20551,
            "speakerName": "提莫尔",
            "text": "哈！连长！上士！安托哈你这家伙…自从大尉失踪以后，你这狐假虎威的家伙倒是把大尾巴竖起来了！哈！哈！",
            "nextDialogs": [
              "710620106"
            ]
          },
          "710620106": {
            "id": "710620106",
            "speakerId": 20550,
            "speakerName": "拉多米尔",
            "text": "够了，提莫尔老弟…你饿坏脑子了。省省体力吧。",
            "nextDialogs": [
              "710620107"
            ]
          },
          "710620107": {
            "id": "710620107",
            "speakerId": 20549,
            "speakerName": "达尼拉",
            "text": "是「代理连长」，安托哈。",
            "nextDialogs": [
              "710620149"
            ]
          },
          "710620149": {
            "id": "710620149",
            "speakerId": 20551,
            "speakerName": "提莫尔",
            "text": "「代理连长」！「代理连长」！我们还要跟着这个拿鸡毛当令箭的绣花枕头多久？",
            "nextDialogs": [
              "710620150"
            ]
          },
          "710620150": {
            "id": "710620150",
            "speakerId": 20550,
            "speakerName": "拉多米尔",
            "text": "我说，提莫尔你是饿坏脑子了，何不吃点拳头清醒一下呢！",
            "nextDialogs": [
              "710620151"
            ]
          },
          "710620151": {
            "id": "710620151",
            "speakerId": 20551,
            "speakerName": "提莫尔",
            "text": "好呀，来啊！也让我喂你几脚！",
            "nextDialogs": [
              "710620152"
            ]
          },
          "710620152": {
            "id": "710620152",
            "speakerId": 20549,
            "speakerName": "达尼拉",
            "text": "太好了，现在轮到把理智和耐心咽下肚子里消化殆尽了…真是太好了。耗尽了这点精神，我们剩下的能量可真的不多咯…",
            "nextDialogs": [
              "710620108"
            ]
          },
          "710620108": {
            "id": "710620108",
            "speakerId": 20536,
            "speakerName": "安东",
            "text": "咳咳…！给我安静！你们要打架吗？想打架的话就下去打！和黑泥巴里面冒出来的那些东西打！饿着肚子去啊！",
            "nextDialogs": [
              "710620109"
            ]
          },
          "710620109": {
            "id": "710620109",
            "speakerId": 20536,
            "speakerName": "安东",
            "text": "我们想要活下去，想要撤离这里，就必须团结一致！不要，再让我，重复，明白？",
            "nextDialogs": [
              "710620110"
            ]
          },
          "710620110": {
            "id": "710620110",
            "speakerId": 20536,
            "speakerName": "安东",
            "text": "一、二、口号！舍我其谁！",
            "nextDialogs": [
              "710620111"
            ]
          },
          "710620111": {
            "id": "710620111",
            "speakerId": 20549,
            "speakerName": "达尼拉",
            "text": "舍我其谁。",
            "nextDialogs": [
              "710620112"
            ]
          },
          "710620112": {
            "id": "710620112",
            "speakerId": 20550,
            "speakerName": "拉多米尔",
            "text": "舍我其谁…",
            "nextDialogs": [
              "710620113"
            ]
          },
          "710620113": {
            "id": "710620113",
            "speakerId": 20551,
            "speakerName": "提莫尔",
            "text": "……",
            "nextDialogs": [
              "710620153"
            ]
          },
          "710620153": {
            "id": "710620153",
            "speakerId": 20536,
            "speakerName": "安东",
            "text": "……",
            "nextDialogs": [
              "710620114"
            ]
          },
          "710620114": {
            "id": "710620114",
            "speakerId": 20536,
            "speakerName": "安东",
            "text": "呃，呵呵…朋友，你也看到了，我们稍微有点…咳咳，不在战斗状态。毕竟…最近遇到了一点小小的挫折。",
            "nextDialogs": [
              "710620115"
            ]
          },
          "710620115": {
            "id": "710620115",
            "speakerId": 20550,
            "speakerName": "拉多米尔",
            "text": "哼…「小小的挫折」！倒是跟大尉学得挺像…",
            "nextDialogs": [
              "710620116"
            ]
          },
          "710620116": {
            "id": "710620116",
            "speakerId": 20536,
            "speakerName": "安东",
            "text": "大尉不在这里，我就是连长！省省你的力气，给我闭嘴！",
            "nextDialogs": [
              "710620117"
            ]
          },
          "710620117": {
            "id": "710620117",
            "speakerId": 20536,
            "speakerName": "安东",
            "text": "抱歉…朋友，我们现在急需你的帮助。",
            "nextDialogs": [
              "710620118"
            ]
          },
          "710620118": {
            "id": "710620118",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "我们什么时候是「朋友」了？",
            "nextDialogs": [
              "710620121"
            ]
          },
          "710620121": {
            "id": "710620121",
            "speakerId": 20536,
            "speakerName": "安东",
            "text": "物资，武器，情报，或者摩拉？我们都不缺。只要你愿意帮忙，这些都可以作为报酬。",
            "nextDialogs": [
              "710620122"
            ]
          },
          "710620122": {
            "id": "710620122",
            "speakerId": 20551,
            "speakerName": "提莫尔",
            "text": "瞧瞧，我们的乞丐连长大人亲自揽了最丢人的活儿…真是太好了。我们所剩无几的脸面呀…",
            "nextDialogs": [
              "710620123"
            ]
          },
          "710620123": {
            "id": "710620123",
            "speakerId": 20549,
            "speakerName": "达尼拉",
            "text": "你也少说几句风凉话吧，讽刺可填不饱肚子。",
            "nextDialogs": [
              "710620124"
            ]
          },
          "710620124": {
            "id": "710620124",
            "speakerId": 20551,
            "speakerName": "提莫尔",
            "text": "「加入我等的行列，让军靴如雷撼动大地吧。愿随我等走向白夜极星者，我等绝对不会抛弃…」",
            "nextDialogs": [
              "710620125"
            ]
          },
          "710620125": {
            "id": "710620125",
            "speakerId": 20536,
            "speakerName": "安东",
            "text": "来个人让他闭嘴！",
            "nextDialogs": [
              "710620126"
            ]
          },
          "710620126": {
            "id": "710620126",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "唔…虽然他们都是坏东西，但看着也蛮可怜的。都饿成这样了…",
            "nextDialogs": [
              "710620127"
            ]
          },
          "710620127": {
            "id": "710620127",
            "speakerId": 20536,
            "speakerName": "安东",
            "text": "说来丢人…但如你所见，我们这些人已经失去了战斗能力，只是想讨要些食物而已。",
            "nextDialogs": [
              "710620119"
            ]
          },
          "710620119": {
            "id": "710620119",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "我凭什么帮你们？",
            "nextDialogs": [
              "710620128"
            ]
          },
          "710620128": {
            "id": "710620128",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "然后呢？",
            "nextDialogs": [
              "710620131"
            ]
          },
          "710620131": {
            "id": "710620131",
            "speakerId": 20536,
            "speakerName": "安东",
            "text": "之后我们会撤离这里，秋毫无犯，我保证。我…以第九特种连队的名誉，以捍卫至冬国土的祖先之名保证。",
            "nextDialogs": [
              "710620132"
            ]
          },
          "710620132": {
            "id": "710620132",
            "speakerId": 20551,
            "speakerName": "提莫尔",
            "text": "唉…这个小可怜蛋，都饿成什么样了…真可怜呀。",
            "nextDialogs": [
              "710620133"
            ]
          },
          "710620133": {
            "id": "710620133",
            "speakerId": 20550,
            "speakerName": "拉多米尔",
            "text": "别说了，你也好不到哪里去…",
            "nextDialogs": [
              "710620134"
            ]
          },
          "710620134": {
            "id": "710620134",
            "speakerId": 20549,
            "speakerName": "达尼拉",
            "text": "我们进来的时候是六十四人，六十四个人！现在只剩下了四个饿鬼，我们还能密谋什么？",
            "nextDialogs": [
              "710620135"
            ]
          },
          "710620135": {
            "id": "710620135",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "哇…你们是怎么把自己搞到这么惨的呀…",
            "nextDialogs": [
              "710620136"
            ]
          },
          "710620136": {
            "id": "710620136",
            "speakerId": 20536,
            "speakerName": "安东",
            "text": "那是后话了…但如果没有食物，第九连队最后的编制成员就危在旦夕了。",
            "nextDialogs": [
              "710620129"
            ]
          },
          "710620129": {
            "id": "710620129",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "你们就没有其他的图谋吗？",
            "nextDialogs": [
              "710620130"
            ]
          },
          "710620130": {
            "id": "710620130",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "（拔出武器）何不去吃监狱大餐呢？",
            "nextDialogs": [
              "710620138"
            ]
          },
          "710620138": {
            "id": "710620138",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "我该怎么信任你们？",
            "nextDialogs": [
              "710620139"
            ]
          },
          "710620139": {
            "id": "710620139",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "（放弃交流）我不喜欢你的帽子。"
          }
        }
      }
    },
    {
      "subId": "7106202",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "710620202"
        ],
        "dialogs": {
          "710620202": {
            "id": "710620202",
            "speakerId": 20536,
            "speakerName": "安东",
            "text": "请考虑一下我们的请求。"
          }
        }
      }
    },
    {
      "subId": "7106207",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "710620701"
        ],
        "dialogs": {
          "710620701": {
            "id": "710620701",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "这群家伙好弱呀，三拳两脚就解决了！",
            "nextDialogs": [
              "710620702"
            ]
          },
          "710620702": {
            "id": "710620702",
            "speakerId": 20536,
            "speakerName": "安东",
            "text": "请你们停下！求你们不要再打了！只要给我们分一点食物，我们愿意听从你们任意处置！",
            "nextDialogs": [
              "710620703"
            ]
          },
          "710620703": {
            "id": "710620703",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "哼…这些家伙看起来是真的饿得受不了了呢。",
            "nextDialogs": [
              "710620706"
            ]
          },
          "710620706": {
            "id": "710620706",
            "speakerId": 20536,
            "speakerName": "安东",
            "text": "这么说吧，不论你们怀着怎样的疑虑…我们的任务只是针对层岩巨渊的灾难之源的。",
            "nextDialogs": [
              "710620707"
            ]
          },
          "710620707": {
            "id": "710620707",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "什么灾难呀…层岩巨渊不是还好好的吗？",
            "nextDialogs": [
              "710620708"
            ]
          },
          "710620708": {
            "id": "710620708",
            "speakerId": 20536,
            "speakerName": "安东",
            "text": "五百年前的灾变，只是战争的前奏而已。对抗漆黑大敌的战争一直持续着，战场之一就在我们的脚下。",
            "nextDialogs": [
              "710620709"
            ]
          },
          "710620709": {
            "id": "710620709",
            "speakerId": 20549,
            "speakerName": "达尼拉",
            "text": "唉，我们的上士连长都饿到说大话了…",
            "nextDialogs": [
              "710620710"
            ]
          },
          "710620710": {
            "id": "710620710",
            "speakerId": 20551,
            "speakerName": "提莫尔",
            "text": "他一直都爱说大话…可说胡话还是第一次。",
            "nextDialogs": [
              "710620711"
            ]
          },
          "710620711": {
            "id": "710620711",
            "speakerId": 20550,
            "speakerName": "拉多米尔",
            "text": "算啦，算啦…安托哈说的不是没有道理，你们，璃月人，不是我们的敌人。",
            "nextDialogs": [
              "710620712"
            ]
          },
          "710620712": {
            "id": "710620712",
            "speakerId": 20536,
            "speakerName": "安东",
            "text": "至少不是我们这支部队的敌人…另一些被打散的弟兄就不一定了。",
            "nextDialogs": [
              "710620713"
            ]
          },
          "710620713": {
            "id": "710620713",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "好吧…我会帮你，但下不为例。"
          }
        }
      }
    }
  ]
}
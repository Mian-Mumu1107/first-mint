    {
      "subId": "7106206",
      "subQuestName": "前往补给站寻找线索",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "710622401"
        ],
        "dialogs": {
          "710622401": {
            "id": "710622401",
            "speakerId": 2171,
            "speakerName": "遗落的文件",
            "text": "「…玉京台秘书处紧急命令：近期群玉阁事件性质之恶劣，危机之紧急，已证明『愚人众』组织之危险性与不可信任…」",
            "nextDialogs": [
              "710622402"
            ]
          },
          "710622402": {
            "id": "710622402",
            "speakerId": 2171,
            "speakerName": "遗落的文件",
            "text": "「…与至冬国之合作协议就此作废，层岩巨渊之勘探工作改由璃月七星全权负责…」",
            "nextDialogs": [
              "710622403"
            ]
          },
          "710622403": {
            "id": "710622403",
            "speakerId": 2171,
            "speakerName": "遗落的文件",
            "text": "「…千岩军不可再与『愚人众』之任何成员交谈，一俟目击须当场逮捕，绝无宽赦！…」"
          }
        }
      }
    },
    {
      "subId": "7106210",
      "subQuestName": "击败来袭的盗宝团",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "710621001"
        ],
        "dialogs": {
          "710621001": {
            "id": "710621001",
            "speakerId": 20536,
            "speakerName": "安东",
            "text": "无论如何，多谢你分享食物。",
            "nextDialogs": [
              "710621002"
            ]
          },
          "710621002": {
            "id": "710621002",
            "speakerId": 20536,
            "speakerName": "安东",
            "text": "我们会想办法离开这里的。"
          }
        }
      }
    },
    {
      "subId": "7106211",
      "subQuestName": "阅读阅读物",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "710621101"
        ],
        "dialogs": {
          "710621101": {
            "id": "710621101",
            "speakerId": 20536,
            "speakerName": "安东",
            "text": "你们回来了，怎么样，有什么新的消息吗？",
            "nextDialogs": [
              "710621102"
            ]
          },
          "710621102": {
            "id": "710621102",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "补给站已经废弃了。",
            "nextDialogs": [
              "710621103"
            ]
          },
          "710621103": {
            "id": "710621103",
            "speakerId": 20536,
            "speakerName": "安东",
            "text": "这样吗…那么，你们有找到什么东西吗？",
            "nextDialogs": [
              "710621104"
            ]
          },
          "710621104": {
            "id": "710621104",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "璃月港不再欢迎你们了。",
            "nextDialogs": [
              "710621105"
            ]
          },
          "710621105": {
            "id": "710621105",
            "speakerId": 20536,
            "speakerName": "安东",
            "text": "……",
            "nextDialogs": [
              "710621106"
            ]
          },
          "710621106": {
            "id": "710621106",
            "speakerId": 20536,
            "speakerName": "安东",
            "text": "除此之外，还有什么消息吗…？",
            "nextDialogs": [
              "710621107"
            ]
          },
          "710621107": {
            "id": "710621107",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "唔…我们还找到了一封信，好像是留给你的呢。",
            "nextDialogs": [
              "710621108"
            ]
          },
          "710621108": {
            "id": "710621108",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "在这里…",
            "nextDialogs": [
              "710621109"
            ]
          },
          "710621109": {
            "id": "710621109",
            "speakerId": 1006,
            "speakerName": "Black Screen",
            "text": "信件在愚人众成员之间传递了一会…",
            "nextDialogs": [
              "710621110"
            ]
          },
          "710621110": {
            "id": "710621110",
            "speakerId": 20536,
            "speakerName": "安东",
            "text": "啊，是彦博老弟。我明白了…",
            "nextDialogs": [
              "710621111"
            ]
          },
          "710621111": {
            "id": "710621111",
            "speakerId": 20550,
            "speakerName": "拉多米尔",
            "text": "怎么了？千岩军都撤走了？给我也看看…",
            "nextDialogs": [
              "710621112"
            ]
          },
          "710621112": {
            "id": "710621112",
            "speakerId": 20549,
            "speakerName": "达尼拉",
            "text": "唉，这些家伙是怎么回事…我们是在为他们而战的！我们应该是盟友才对！",
            "nextDialogs": [
              "710621113"
            ]
          },
          "710621113": {
            "id": "710621113",
            "speakerId": 20550,
            "speakerName": "拉多米尔",
            "text": "现在没有「盟友」了！我们已经断交了…准确来说是作为「愚人众」的我们，已经和璃月断交了。",
            "nextDialogs": [
              "710621131"
            ]
          },
          "710621131": {
            "id": "710621131",
            "speakerId": 20551,
            "speakerName": "提莫尔",
            "text": "这是背叛！我们被璃月人背叛了！",
            "nextDialogs": [
              "710621132"
            ]
          },
          "710621132": {
            "id": "710621132",
            "speakerId": 20550,
            "speakerName": "拉多米尔",
            "text": "或许对璃月人来说恰恰相反呢？是我们，作为「愚人众」的我们背叛了他们…",
            "nextDialogs": [
              "710621114"
            ]
          },
          "710621114": {
            "id": "710621114",
            "speakerId": 20549,
            "speakerName": "达尼拉",
            "text": "开什么玩笑…我们是来保护璃月人的！还记得大尉在出发前说的话吗？这次远征无关任何小算盘和阴谋诡计！",
            "nextDialogs": [
              "710621115"
            ]
          },
          "710621115": {
            "id": "710621115",
            "speakerId": 20551,
            "speakerName": "提莫尔",
            "text": "但是拦不住小算盘和阴谋诡计上了我们的身…这事不是我们能控制得了的，达尼拉兄弟。",
            "nextDialogs": [
              "710621116"
            ]
          },
          "710621116": {
            "id": "710621116",
            "speakerId": 20536,
            "speakerName": "安东",
            "text": "好了，我明白了。呼…我决定了，我们需要撤离这里，越快越好。",
            "nextDialogs": [
              "710621117"
            ]
          },
          "710621117": {
            "id": "710621117",
            "speakerId": 20536,
            "speakerName": "安东",
            "text": "没关系，责任全由我承担就好。如果我们之中存在逃兵…如果有逃兵让第九连队蒙羞，那个逃兵就是我，只有我。",
            "nextDialogs": [
              "710621118"
            ]
          },
          "710621118": {
            "id": "710621118",
            "speakerId": 20550,
            "speakerName": "拉多米尔",
            "text": "达尼拉说得对，我们是来保护璃月人免遭黑灾侵染的，我们不能就这么灰溜溜离开。",
            "nextDialogs": [
              "710621119"
            ]
          },
          "710621119": {
            "id": "710621119",
            "speakerId": 20536,
            "speakerName": "安东",
            "text": "现在是谈个人自尊的时间吗，米尔卡？你还没看出来吗！",
            "nextDialogs": [
              "710621120"
            ]
          },
          "710621120": {
            "id": "710621120",
            "speakerId": 20536,
            "speakerName": "安东",
            "text": "璃月人不需要我们保护，璃月人也不欢迎我们！他们甚至击败了我们那些自鸣得意的战友！",
            "nextDialogs": [
              "710621123"
            ]
          },
          "710621123": {
            "id": "710621123",
            "speakerId": 20536,
            "speakerName": "安东",
            "text": "我们准备撤离吧，一定要尽可能悄无声息地走，不要惊动了本地的千岩军。",
            "nextDialogs": [
              "710621124"
            ]
          },
          "710621124": {
            "id": "710621124",
            "speakerId": 20550,
            "speakerName": "拉多米尔",
            "text": "大尉说我们是抱着不再回家的觉悟来的。我们至少也要…",
            "nextDialogs": [
              "710621125"
            ]
          },
          "710621125": {
            "id": "710621125",
            "speakerId": 20536,
            "speakerName": "安东",
            "text": "大尉一样说过，他不会让任何人的牺牲毫无意义！大尉一样说过，他不希望我把连队断送掉！",
            "nextDialogs": [
              "710621126"
            ]
          },
          "710621126": {
            "id": "710621126",
            "speakerId": 20536,
            "speakerName": "安东",
            "text": "至少我们还活着，就意味着第九连队的番号还存在，明白了吗！",
            "nextDialogs": [
              "710621127"
            ]
          },
          "710621127": {
            "id": "710621127",
            "speakerId": 20550,
            "speakerName": "拉多米尔",
            "text": "……",
            "nextDialogs": [
              "710621128"
            ]
          },
          "710621128": {
            "id": "710621128",
            "speakerId": 20550,
            "speakerName": "拉多米尔",
            "text": "明白，连长。",
            "nextDialogs": [
              "710621129"
            ]
          },
          "710621129": {
            "id": "710621129",
            "speakerId": 20536,
            "speakerName": "安东",
            "text": "好了，还有人有任何问题吗？我不想听到任何反对意见。解散！",
            "nextDialogs": [
              "710621130"
            ]
          },
          "710621130": {
            "id": "710621130",
            "speakerId": 20536,
            "speakerName": "安东",
            "text": "#无论如何，{NICKNAME}，感谢你们的帮忙。这些摩拉和物资请你收下吧。"
          }
        }
      }
    },
    {
      "subId": "7106207",
      "subQuestName": "将彦博的字条带回愚人众连队",

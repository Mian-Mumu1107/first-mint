  },
  "subQuests": [
    {
      "subId": "7113401",
      "subQuestName": "",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "711340101"
        ],
        "dialogs": {
          "711340101": {
            "id": "711340101",
            "speakerId": 2269,
            "speakerName": "玄机",
            "text": "唷！客官，看您这风尘仆仆的样子，在找喝茶歇脚的地儿吧？",
            "nextDialogs": [
              "711340102"
            ]
          },
          "711340102": {
            "id": "711340102",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "你这有茶喝？",
            "nextDialogs": [
              "711340103"
            ]
          },
          "711340103": {
            "id": "711340103",
            "speakerId": 2269,
            "speakerName": "玄机",
            "text": "可不是，方圆几里，就小的这一家茶摊。",
            "nextDialogs": [
              "711340104"
            ]
          },
          "711340104": {
            "id": "711340104",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "那都有什么茶呀？",
            "nextDialogs": [
              "711340105"
            ]
          },
          "711340105": {
            "id": "711340105",
            "speakerId": 2269,
            "speakerName": "玄机",
            "text": "呃…嗯…爆…火热爆裂甜甜花蜜茶，嗯，没错。",
            "nextDialogs": [
              "711340106"
            ]
          },
          "711340106": {
            "id": "711340106",
            "speakerId": 2269,
            "speakerName": "玄机",
            "text": "是一种用野生甜甜花和骗骗花蜜融合而成的特饮。入口火热，回味清凉，驱疲解累，别处可见不到。",
            "nextDialogs": [
              "711340107"
            ]
          },
          "711340107": {
            "id": "711340107",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "哦！是没听过的茶呢！感觉会很好喝！",
            "nextDialogs": [
              "711340108"
            ]
          },
          "711340108": {
            "id": "711340108",
            "speakerId": 2269,
            "speakerName": "玄机",
            "text": "不巧的是，小的手头原料用完了，但旁边的原料地很危险呢，既要摘甜甜花，又要对付神出鬼没的<color=#00E1FFFF>火骗骗花</color>。",
            "nextDialogs": [
              "711340118"
            ]
          },
          "711340118": {
            "id": "711340118",
            "speakerId": 2269,
            "speakerName": "玄机",
            "text": "假如能有足够的原料重新支撑小店，付出再多报酬小的又何惧？",
            "nextDialogs": [
              "711340109"
            ]
          },
          "711340109": {
            "id": "711340109",
            "speakerId": 2269,
            "speakerName": "玄机",
            "text": "但可惜现在…真是难为情啦，客官要不别处转转？小的回头去趟冒险家协会，请他们帮忙取些原料再…",
            "nextDialogs": [
              "711340110"
            ]
          },
          "711340110": {
            "id": "711340110",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "好消息，我们就是冒险家。",
            "nextDialogs": [
              "711340111"
            ]
          },
          "711340111": {
            "id": "711340111",
            "speakerId": 2269,
            "speakerName": "玄机",
            "text": "呃…咳咳…这…",
            "nextDialogs": [
              "711340112"
            ]
          },
          "711340112": {
            "id": "711340112",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "没错，爆裂甜甜花蜜茶，一定要喝到，让我们去帮你解决原料的问题吧。",
            "nextDialogs": [
              "711340113"
            ]
          },
          "711340113": {
            "id": "711340113",
            "speakerId": 2269,
            "speakerName": "玄机",
            "text": "那…那里的骗骗花，可就像暝垣山上的石头一样多哦！你们还是别冒这个险吧…",
            "nextDialogs": [
              "711340114"
            ]
          },
          "711340114": {
            "id": "711340114",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "…可如果真有那么多，这里不应该叫骗骗花山才对吗？",
            "nextDialogs": [
              "711340115"
            ]
          },
          "711340115": {
            "id": "711340115",
            "speakerId": 2269,
            "speakerName": "玄机",
            "text": "呃…我又想起来，其实我和冒险家协会有过合作协议…也就是说，这样贸然让两位接手，也不太好…",
            "nextDialogs": [
              "711340116"
            ]
          },
          "711340116": {
            "id": "711340116",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "你这个人好奇怪，有现成的冒险家给你帮忙你还不乐意…",
            "nextDialogs": [
              "711340117"
            ]
          },
          "711340117": {
            "id": "711340117",
            "speakerId": 2269,
            "speakerName": "玄机",
            "text": "总之，茶饮虽好，时机不巧，呵呵，客官请回吧。",
            "nextDialogs": [
              "711340119"
            ]
          },
          "711340119": {
            "id": "711340119",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "好吧，好吧…",
            "nextDialogs": [
              "711340120"
            ]
          },
          "711340120": {
            "id": "711340120",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "#（{NICKNAME}…你说我们要是不听他的，直接去把原料取来，是不是就有茶喝啦？）",
            "nextDialogs": [
              "711340121"
            ]
          },
          "711340121": {
            "id": "711340121",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "（好想试试他说的那个茶哦！）"
          }
        }
      }
    },
    {
      "subId": "7113403",
      "subQuestName": "",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "711340301"
        ],
        "dialogs": {
          "711340301": {
            "id": "711340301",
            "speakerId": 2269,
            "speakerName": "玄机",
            "text": "咦？客官你们…",
            "nextDialogs": [
              "711340302"
            ]
          },
          "711340302": {
            "id": "711340302",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "原料给你，上茶吧。",
            "nextDialogs": [
              "711340303"
            ]
          },
          "711340303": {
            "id": "711340303",
            "speakerId": 2269,
            "speakerName": "玄机",
            "text": "什么？你们真的去解决了那些<color=#00E1FFFF>火骗骗花</color>？",
            "nextDialogs": [
              "711340304"
            ]
          },
          "711340304": {
            "id": "711340304",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "确实有不少只哦，不过在我们面前还是不够看啦。",
            "nextDialogs": [
              "711340305"
            ]
          },
          "711340305": {
            "id": "711340305",
            "speakerId": 2269,
            "speakerName": "玄机",
            "text": "有不少只？啊不不，小的当然知道有不少只，哈哈，两位果真是艺高人胆大啊，佩服，佩服。",
            "nextDialogs": [
              "711340306"
            ]
          },
          "711340306": {
            "id": "711340306",
            "speakerId": 2269,
            "speakerName": "玄机",
            "text": "（还好这两位没事…不然我可就失职了…看来下次得换个说辞…）",
            "nextDialogs": [
              "711340307"
            ]
          },
          "711340307": {
            "id": "711340307",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "哼哼，这下你总不能推脱了吧，我们现在就想喝特别的火热爆裂甜甜花蜜茶！",
            "nextDialogs": [
              "711340308"
            ]
          },
          "711340308": {
            "id": "711340308",
            "speakerId": 2269,
            "speakerName": "玄机",
            "text": "咳咳…好…小的这就准备…",
            "nextDialogs": [
              "711340309"
            ]
          },
          "711340309": {
            "id": "711340309",
            "speakerId": 2269,
            "speakerName": "玄机",
            "text": "（可恶…要怎么做…应该不会很难吧？！应该把甜甜花和骗骗花蜜倒在一起就好吧？！）",
            "nextDialogs": [
              "711340310"
            ]
          },
          "711340310": {
            "id": "711340310",
            "speakerId": 1002,
            "speakerName": "Black Screen",
            "text": "玄机面露难色，但还是拿出你们带来的原料，一股脑放进了一个杯子。不到片刻后，他又取出了一些，但最后，还是都放了回去。",
            "nextDialogs": [
              "711340311"
            ]
          },
          "711340311": {
            "id": "711340311",
            "speakerId": 1002,
            "speakerName": "Black Screen",
            "text": "之后他盖上茶盖，使劲摇晃起来。不久，一碗漂浮着奇怪泡沫的褐色液体被端到你们面前。",
            "nextDialogs": [
              "711340312"
            ]
          },
          "711340312": {
            "id": "711340312",
            "speakerId": 1002,
            "speakerName": "Black Screen",
            "text": "你意识到有什么不太对，但派蒙接了过来，一饮而尽。",
            "nextDialogs": [
              "711340313"
            ]
          },
          "711340313": {
            "id": "711340313",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "啊呸呸呸——这是什么东西啊！我从来没有喝过这么难喝的东西…你这个茶摊子到底是怎么开下去的…",
            "nextDialogs": [
              "711340314"
            ]
          },
          "711340314": {
            "id": "711340314",
            "speakerId": 2269,
            "speakerName": "玄机",
            "text": "呃哈哈…真、抱歉！让客官的舌头受了委屈…",
            "nextDialogs": [
              "711340315"
            ]
          },
          "711340315": {
            "id": "711340315",
            "speakerId": 2269,
            "speakerName": "玄机",
            "text": "这点小心意，请收下吧！就当是对舌头的赔罪，还有为两位找来原料的报酬…",
            "nextDialogs": [
              "711340316"
            ]
          },
          "711340316": {
            "id": "711340316",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "唔…好吧。虽然你泡茶的手艺不行，人品还是很不赖的…",
            "nextDialogs": [
              "711340317"
            ]
          },
          "711340317": {
            "id": "711340317",
            "speakerId": 2269,
            "speakerName": "玄机",
            "text": "呵呵，哪里的话…总之，托两位的福，小的原料备齐了。",
            "nextDialogs": [
              "711340318"
            ]
          },
          "711340318": {
            "id": "711340318",
            "speakerId": 2269,
            "speakerName": "玄机",
            "text": "没什么事两位也尽早返回吧，毕竟是野外，难说还有什么危险。"
          }
        }
      }
    },

        "dialogs": {
          "732100501": {
            "id": "732100501",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "嗯…不知道这里会有什么宝藏呢？",
            "nextDialogs": [
              "732100502"
            ]
          },
          "732100502": {
            "id": "732100502",
            "speakerId": 1001,
            "speakerName": "Black Screen",
            "text": "柜子中放满了簿册，你们翻了翻，似乎是病历卡和账务记录之类的医院文件。\\n失望地关上了柜子。",
            "nextDialogs": [
              "732100503"
            ]
          },
          "732100503": {
            "id": "732100503",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "哼，我还以为里头有什么特别的宝藏呢…还不如我们平时冒险的时候，见到的木桶木箱呢！里面起码还有卷心菜和禽肉…",
            "nextDialogs": [
              "732100504"
            ]
          },
          "732100504": {
            "id": "732100504",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "欸，这是什么？好像从里头掉出来的…",
            "nextDialogs": [
              "732100505"
            ]
          },
          "732100505": {
            "id": "732100505",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "我看看…说不定有宝藏的线索…",
            "nextDialogs": [
              "732100507"
            ]
          },
          "732100507": {
            "id": "732100507",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "呜哇，「魔鳞病」看起来好可怕…",
            "nextDialogs": [
              "732100508"
            ]
          },
          "732100508": {
            "id": "732100508",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "另一份文件上写了什么呢…？",
            "nextDialogs": [
              "732100510"
            ]
          },
          "732100510": {
            "id": "732100510",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "嗯…完全没看懂！",
            "nextDialogs": [
              "732100511"
            ]
          },
          "732100511": {
            "id": "732100511",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "我也没看懂…",
            "nextDialogs": [
              "732100512"
            ]
          },
          "732100512": {
            "id": "732100512",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "我只看懂了什么「神的声音引导」…难道这里真的会出现奇特的声音，引导人吗？",
            "nextDialogs": [
              "732100515"
            ]
          },
          "732100515": {
            "id": "732100515",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "可能是「地下水脉或生物活动」…",
            "nextDialogs": [
              "732100516"
            ]
          },
          "732100516": {
            "id": "732100516",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "嗯！确实，说不定地下有什么遗迹呢！如果注意到什么声音，我们就去看看吧！"

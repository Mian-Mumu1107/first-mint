  },
  "subQuests": [
    {
      "subId": "7055101",
      "subQuestName": "(test)隐藏$HIDDEN",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "705510101"
        ],
        "dialogs": {
          "705510101": {
            "id": "705510101",
            "speakerId": 1090,
            "speakerName": "艾梅莉埃",
            "text": "#下午好，{NICKNAME}。",
            "nextDialogs": [
              "705510102"
            ]
          },
          "705510102": {
            "id": "705510102",
            "speakerId": 1090,
            "speakerName": "艾梅莉埃",
            "text": "…没想到，我会有幸在蒙德见识到你的「调和」才华。",
            "nextDialogs": [
              "705510105"
            ]
          },
          "705510105": {
            "id": "705510105",
            "speakerId": 1090,
            "speakerName": "艾梅莉埃",
            "text": "两者兼有。",
            "nextDialogs": [
              "705510106"
            ]
          },
          "705510106": {
            "id": "705510106",
            "speakerId": 1090,
            "speakerName": "艾梅莉埃",
            "text": "一位自称魔女的小姐，邀请我来经营她的小花铺。另外，我还接到了猫尾酒馆的委托，为该店调制了新的香氛。",
            "nextDialogs": [
              "705510107"
            ]
          },
          "705510107": {
            "id": "705510107",
            "speakerId": 1090,
            "speakerName": "艾梅莉埃",
            "text": "#以{NICKNAME}亲手调制的饮品为今天的忙碌划上句号，更是绝妙的收获。"
          }
        }
      }
    },
    {
      "subId": "7055102",
      "subQuestName": "(test)隐藏$HIDDEN",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [],
        "dialogs": {}
      }
    },
    {
      "subId": "7055103",
      "subQuestName": "(test)隐藏$HIDDEN",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "705510301"
        ],
        "dialogs": {
          "705510301": {
            "id": "705510301",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "请品尝，这杯专为艾梅莉埃改进的「七时柔灯」。不过，暂时还没想好它的名字…",
            "nextDialogs": [
              "705510302"
            ]
          },
          "705510302": {
            "id": "705510302",
            "speakerId": 1090,
            "speakerName": "艾梅莉埃",
            "text": "色彩更加清爽，散发而出的香气，也十分淡雅，符合青色的印象。",
            "nextDialogs": [
              "705510303"
            ]
          },
          "705510303": {
            "id": "705510303",
            "speakerId": 1090,
            "speakerName": "艾梅莉埃",
            "text": "表面这层斑斓的细末，来自风车菊的花瓣和叶片吗？",
            "nextDialogs": [
              "705510306"
            ]
          },
          "705510306": {
            "id": "705510306",
            "speakerId": 1090,
            "speakerName": "艾梅莉埃",
            "text": "味道肯定很不错…我试试哦。",
            "nextDialogs": [
              "705510307"
            ]
          },
          "705510307": {
            "id": "705510307",
            "speakerId": 1090,
            "speakerName": "艾梅莉埃",
            "text": "嗯…风车菊的花语是「看得见的风」。",
            "nextDialogs": [
              "705510308"
            ]
          },
          "705510308": {
            "id": "705510308",
            "speakerId": 1090,
            "speakerName": "艾梅莉埃",
            "text": "你不仅捕捉到了它们的形态，还将它们捎来的香气融入了这杯特调。",
            "nextDialogs": [
              "705510309"
            ]
          },
          "705510309": {
            "id": "705510309",
            "speakerId": 1090,
            "speakerName": "艾梅莉埃",
            "text": "我提议，这杯特调，就命名为「云风芳迹」。",
            "nextDialogs": [
              "705510310"
            ]
          },
          "705510310": {
            "id": "705510310",
            "speakerId": 1090,
            "speakerName": "艾梅莉埃",
            "text": "蒙德的云与风，在杯中旋绕，留下芬芳之痕。"
          }
        }
      }
    },
    {
      "subId": "7055104",

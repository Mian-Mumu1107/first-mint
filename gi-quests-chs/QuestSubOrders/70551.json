    {
      "subId": "7055106",
      "subQuestName": "(test)隐藏$HIDDEN",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "705510201"
        ],
        "dialogs": {
          "705510201": {
            "id": "705510201",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "先试试看，艾梅莉埃小姐？",
            "nextDialogs": [
              "705510202"
            ]
          },
          "705510202": {
            "id": "705510202",
            "speakerId": 1090,
            "speakerName": "艾梅莉埃",
            "text": "你的动作真是赏心悦目…",
            "nextDialogs": [
              "705510203"
            ]
          },
          "705510203": {
            "id": "705510203",
            "speakerId": 1090,
            "speakerName": "艾梅莉埃",
            "text": "嗯…这是一杯「七时柔灯」的本地版吧？",
            "nextDialogs": [
              "705510206"
            ]
          },
          "705510206": {
            "id": "705510206",
            "speakerId": 1090,
            "speakerName": "艾梅莉埃",
            "text": "柔和淡雅，层次分明的口感，结合了几分蒙德特色的香气，风味相当亲切，也避开了可能让我感到不谐的味觉成分…",
            "nextDialogs": [
              "705510207"
            ]
          },
          "705510207": {
            "id": "705510207",
            "speakerId": 1090,
            "speakerName": "艾梅莉埃",
            "text": "其实，不用这么谨慎，对于跳出常理框架的风味物质，我也有着不错的接受能力。"
          }
        }
      }
    },

{
  "lineCounts": {
    "Black Screen": 1,
    "凛角鹿": 5,
    "卡尼": 5,
    "明娜": 4,
    "明娜&卡尼": 1,
    "海崖鹦": 6,
    "菈乌玛": 16
  },
  "subQuests": [
    {
      "subId": "7666101",
      "subQuestName": "",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "766503601"
        ],
        "dialogs": {
          "766503601": {
            "id": "766503601",
            "speakerId": 1000,
            "speakerName": "菈乌玛",
            "text": "明娜，卡尼。就让我代为传话吧。",
            "nextDialogs": [
              "766503602"
            ]
          },
          "766503602": {
            "id": "766503602",
            "speakerId": 1001,
            "speakerName": "明娜",
            "text": "菈、菈乌玛姐姐！",
            "nextDialogs": [
              "766503603"
            ]
          },
          "766503603": {
            "id": "766503603",
            "speakerId": 1002,
            "speakerName": "卡尼",
            "text": "啊…那个…不用麻烦您的。莎莱卡奶奶说，菈乌玛姐姐每天都很忙，最好别因为小事打扰您…",
            "nextDialogs": [
              "766503604"
            ]
          },
          "766503604": {
            "id": "766503604",
            "speakerId": 1000,
            "speakerName": "菈乌玛",
            "text": "放心吧，此刻我恰好有些空闲。你们刚才的话，我已经听见了。",
            "nextDialogs": [
              "766503605"
            ]
          },
          "766503605": {
            "id": "766503605",
            "speakerId": 1000,
            "speakerName": "菈乌玛",
            "text": "容我问问这只海崖鹦，认不认识你们的那位朋友。",
            "nextDialogs": [
              "766503606"
            ]
          },
          "766503606": {
            "id": "766503606",
            "speakerId": 1000,
            "speakerName": "菈乌玛",
            "text": "好孩子，你认识明娜和卡尼之前所照顾的那只小海崖鹦么？",
            "nextDialogs": [
              "766503607"
            ]
          },
          "766503607": {
            "id": "766503607",
            "speakerId": 1003,
            "speakerName": "海崖鹦",
            "text": "（朋友，朋友！认识，认识，就在家里！离家太久，危险，危险！）",
            "nextDialogs": [
              "766503608"
            ]
          },
          "766503608": {
            "id": "766503608",
            "speakerId": 1003,
            "speakerName": "海崖鹦",
            "text": "（爸爸，妈妈，担心。爸爸，妈妈，拦住它！）",
            "nextDialogs": [
              "766503609"
            ]
          },
          "766503609": {
            "id": "766503609",
            "speakerId": 1000,
            "speakerName": "菈乌玛",
            "text": "…原来如此。明娜，看来你的推论实属正确。",
            "nextDialogs": [
              "766503610"
            ]
          },
          "766503610": {
            "id": "766503610",
            "speakerId": 1000,
            "speakerName": "菈乌玛",
            "text": "你们的那位小朋友，确实因为离家太久，而被家中长辈拦在家中训斥。",
            "nextDialogs": [
              "766503611"
            ]
          },
          "766503611": {
            "id": "766503611",
            "speakerId": 1002,
            "speakerName": "卡尼",
            "text": "哇，明娜真聪明！",
            "nextDialogs": [
              "766503612"
            ]
          },
          "766503612": {
            "id": "766503612",
            "speakerId": 1001,
            "speakerName": "明娜",
            "text": "嘿嘿，我平时可是看了不少书呢。",
            "nextDialogs": [
              "766503613"
            ]
          },
          "766503613": {
            "id": "766503613",
            "speakerId": 1003,
            "speakerName": "海崖鹦",
            "text": "（朋友，好！朋友，想见！快去家里吧，快去家里吧！）",
            "nextDialogs": [
              "766503614"
            ]
          },
          "766503614": {
            "id": "766503614",
            "speakerId": 1000,
            "speakerName": "菈乌玛",
            "text": "…欸？这只小海崖鹦说，你们的朋友也很想念你们。",
            "nextDialogs": [
              "766503615"
            ]
          },
          "766503615": {
            "id": "766503615",
            "speakerId": 1000,
            "speakerName": "菈乌玛",
            "text": "虽然它无法出门，但你们…可以去它家里做客？",
            "nextDialogs": [
              "766503616"
            ]
          },
          "766503616": {
            "id": "766503616",
            "speakerId": 1002,
            "speakerName": "卡尼",
            "text": "去它家里？可是，它住在哪里，我都不知道欸…",
            "nextDialogs": [
              "766503617"
            ]
          },
          "766503617": {
            "id": "766503617",
            "speakerId": 1001,
            "speakerName": "明娜",
            "text": "而且，如果我们离家太久，也会被爸爸妈妈训的…",
            "nextDialogs": [
              "766503618"
            ]
          },
          "766503618": {
            "id": "766503618",
            "speakerId": 1004,
            "speakerName": "凛角鹿",
            "text": "（菈乌玛大人。就由我来护送这两位孩子吧，路途并不遥远，来回用不着半日。）",
            "nextDialogs": [
              "766503619"
            ]
          },
          "766503619": {
            "id": "766503619",
            "speakerId": 1004,
            "speakerName": "凛角鹿",
            "text": "（旧友相见，实属善事，没有不成人之美之理。）",
            "nextDialogs": [
              "766503620"
            ]
          },
          "766503620": {
            "id": "766503620",
            "speakerId": 1003,
            "speakerName": "海崖鹦",
            "text": "（我带路！我带路！飞得高高，近路全知道！）",
            "nextDialogs": [
              "766503621"
            ]
          },
          "766503621": {
            "id": "766503621",
            "speakerId": 1002,
            "speakerName": "卡尼",
            "text": "菈乌玛姐姐，它们在说什么呀？",
            "nextDialogs": [
              "766503622"
            ]
          },
          "766503622": {
            "id": "766503622",
            "speakerId": 1000,
            "speakerName": "菈乌玛",
            "text": "看来你们刚才的顾虑，不成问题了。",
            "nextDialogs": [
              "766503623"
            ]
          },
          "766503623": {
            "id": "766503623",
            "speakerId": 1000,
            "speakerName": "菈乌玛",
            "text": "这只海崖鹦愿意带你们去见那位朋友，而这只凛角鹿，也愿意送你们往来。",
            "nextDialogs": [
              "766503624"
            ]
          },
          "766503624": {
            "id": "766503624",
            "speakerId": 1001,
            "speakerName": "明娜",
            "text": "哇！真的么？真的真的真的吗菈乌玛姐姐？",
            "nextDialogs": [
              "766503625"
            ]
          },
          "766503625": {
            "id": "766503625",
            "speakerId": 1000,
            "speakerName": "菈乌玛",
            "text": "当然是真的，我何时骗过你们？",
            "nextDialogs": [
              "766503626"
            ]
          },
          "766503626": {
            "id": "766503626",
            "speakerId": 1002,
            "speakerName": "卡尼",
            "text": "太好了！那…那个，谢谢你，也谢谢你！",
            "nextDialogs": [
              "766503627"
            ]
          },
          "766503627": {
            "id": "766503627",
            "speakerId": 1003,
            "speakerName": "海崖鹦",
            "text": "（小事，包在我身上！小事，包在我身上！）",
            "nextDialogs": [
              "766503628"
            ]
          },
          "766503628": {
            "id": "766503628",
            "speakerId": 1004,
            "speakerName": "凛角鹿",
            "text": "（嗯。良善有礼，是好孩子。菈乌玛大人，护送之事就交予我们吧。）",
            "nextDialogs": [
              "766503629"
            ]
          },
          "766503629": {
            "id": "766503629",
            "speakerId": 1000,
            "speakerName": "菈乌玛",
            "text": "那就有劳二位了。事了之后，请来书库一叙，我有谢礼相赠。",
            "nextDialogs": [
              "766503630"
            ]
          },
          "766503630": {
            "id": "766503630",
            "speakerId": 1004,
            "speakerName": "凛角鹿",
            "text": "（菈乌玛大人客气了，帮助家人，不需繁礼。）",
            "nextDialogs": [
              "766503631"
            ]
          },
          "766503631": {
            "id": "766503631",
            "speakerId": 1003,
            "speakerName": "海崖鹦",
            "text": "（我想吃果子，它也想吃果子！都想吃，不说！）",
            "nextDialogs": [
              "766503632"
            ]
          },
          "766503632": {
            "id": "766503632",
            "speakerId": 1004,
            "speakerName": "凛角鹿",
            "text": "（…唉。）",
            "nextDialogs": [
              "766503633"
            ]
          },
          "766503633": {
            "id": "766503633",
            "speakerId": 1000,
            "speakerName": "菈乌玛",
            "text": "呵呵，我自会准备最甜的果子招待二位。",
            "nextDialogs": [
              "766503634"
            ]
          },
          "766503634": {
            "id": "766503634",
            "speakerId": 1000,
            "speakerName": "菈乌玛",
            "text": "来，明娜，卡尼，待会坐上去的时候，一定要坐稳了。",
            "nextDialogs": [
              "766503635"
            ]
          },
          "766503635": {
            "id": "766503635",
            "speakerId": 1000,
            "speakerName": "菈乌玛",
            "text": "在树林穿行时，不要抬头，也不要伸手，俯下身子，稳稳坐好，好么？",
            "nextDialogs": [
              "766503636"
            ]
          },
          "766503636": {
            "id": "766503636",
            "speakerId": 1005,
            "speakerName": "明娜&卡尼",
            "text": "好的！菈乌玛姐姐！",
            "nextDialogs": [
              "766503637"
            ]
          },
          "766503637": {
            "id": "766503637",
            "speakerId": 1006,
            "speakerName": "Black Screen",
            "text": "明娜和卡尼爬上了凛角鹿的背。随后，海崖鹦振翅飞起，凛角鹿紧随其后，很快，两人一鹿一鹦就消失了…",
            "nextDialogs": [
              "766503638"
            ]
          },
          "766503638": {
            "id": "766503638",
            "speakerId": 1000,
            "speakerName": "菈乌玛",
            "text": "好孩子们，祝你们玩得开心。"
          }
        }
      }
    }
  ]
}
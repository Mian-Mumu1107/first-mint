    {
      "subId": "2250116",
      "subQuestName": "搜集霓裳花对话$HIDDEN",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "225011401"
        ],
        "dialogs": {
          "225011401": {
            "id": "225011401",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "霓裳花。",
            "nextDialogs": [
              "225011402"
            ]
          },
          "225011402": {
            "id": "225011402",
            "speakerId": 1000,
            "speakerName": "清昼",
            "text": "嗯，倒也不错。现在天有异象，霓裳花倒一如往常地盛开。",
            "nextDialogs": [
              "225011403"
            ]
          },
          "225011403": {
            "id": "225011403",
            "speakerId": 1000,
            "speakerName": "清昼",
            "text": "两相对比，说不定也会有些趣味…",
            "nextDialogs": [
              "225011404"
            ]
          },
          "225011404": {
            "id": "225011404",
            "speakerId": 1000,
            "speakerName": "清昼",
            "text": "能拜托你去采三朵霓裳花回来吗？有了实物，或许我就能有思路了。",
            "nextDialogs": [
              "225011405"
            ]
          },
          "225011405": {
            "id": "225011405",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "我知道了。",
            "nextDialogs": [
              "225011406"
            ]
          },
          "225011406": {
            "id": "225011406",
            "speakerId": 1000,
            "speakerName": "清昼",
            "text": "那就拜托你了。"
          }
        }
      }
    },
    {
      "subId": "2250117",
      "subQuestName": "搜集冰雾花对话$HIDDEN",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "225011501"
        ],
        "dialogs": {
          "225011501": {
            "id": "225011501",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "冰雾花。",
            "nextDialogs": [
              "225011502"
            ]
          },
          "225011502": {
            "id": "225011502",
            "speakerId": 1000,
            "speakerName": "清昼",
            "text": "冰雾花，嗯…假如能将天降的陨石与冰雾花两相对比，说不定能出一首好诗。",
            "nextDialogs": [
              "225011503"
            ]
          },
          "225011503": {
            "id": "225011503",
            "speakerId": 1000,
            "speakerName": "清昼",
            "text": "能拜托你去采三朵冰雾花回来吗？有了实物，或许我就能有思路了。",
            "nextDialogs": [
              "225011504"
            ]
          },
          "225011504": {
            "id": "225011504",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "我知道了。",
            "nextDialogs": [
              "225011505"
            ]
          },
          "225011505": {
            "id": "225011505",
            "speakerId": 1000,
            "speakerName": "清昼",
            "text": "那就拜托你了。"
          }
        }
      }
    },
    {
      "subId": "2250118",
      "subQuestName": "采摘3朵霓裳花",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "225011801"
        ],
        "dialogs": {
          "225011801": {
            "id": "225011801",
            "speakerId": 1000,
            "speakerName": "清昼",
            "text": "这就是陨石吗…怪了，怪了…",
            "nextDialogs": [

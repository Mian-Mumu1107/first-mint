    "影": 15
  },
  "subQuests": [
    {
      "subId": "1203201",
      "subQuestName": "",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "120320101"
        ],
        "dialogs": {
          "120320101": {
            "id": "120320101",
            "speakerId": 12076,
            "speakerName": "影",
            "text": "接下来，稻妻一定会迎来更多挑战，不过我已经做好准备了。",
            "nextDialogs": [
              "120320103",
              "120320108",
              "120320113",
              "120320118",
              "120320123"
            ]
          },
          "120320103": {
            "id": "120320103",
            "speakerId": 12076,
            "speakerName": "影",
            "text": "解除锁国令难免牵连众多，不能说只有积极效应而毫无损害。",
            "nextDialogs": [
              "120320104"
            ]
          },
          "120320104": {
            "id": "120320104",
            "speakerId": 12076,
            "speakerName": "影",
            "text": "比如可预见的，外界对稻妻商业造成冲击等问题。这些都是接下来我会着手处理的事。",
            "nextDialogs": [
              "120320105"
            ]
          },
          "120320105": {
            "id": "120320105",
            "speakerId": 1034,
            "speakerName": "八重神子",
            "text": "影真是认真啊。我考虑的只有，以后鸣神大社是不是可以卖门票了之类的事。",
            "nextDialogs": [
              "120320106"
            ]
          },
          "120320106": {
            "id": "120320106",
            "speakerId": 12076,
            "speakerName": "影",
            "text": "你啊…"
          },
          "120320108": {
            "id": "120320108",
            "speakerId": 12076,
            "speakerName": "影",
            "text": "真的视线一直在稻妻人民身上。我曾以为，这是她的责任。",
            "nextDialogs": [
              "120320109"
            ]
          },
          "120320109": {
            "id": "120320109",
            "speakerId": 12076,
            "speakerName": "影",
            "text": "可现在看来，这种注视饱含了赏识与期待，除了责任，她一定也乐在其中。她是非常爱人的。",
            "nextDialogs": [
              "120320110"
            ]
          },
          "120320110": {
            "id": "120320110",
            "speakerId": 1034,
            "speakerName": "八重神子",
            "text": "过去的人值得注视，现在与未来的人亦如此。",
            "nextDialogs": [
              "120320111"
            ]
          },
          "120320111": {
            "id": "120320111",
            "speakerId": 12076,
            "speakerName": "影",
            "text": "嗯，我不会再忽视他们的热情与梦想了。"
          },
          "120320113": {
            "id": "120320113",
            "speakerId": 12076,
            "speakerName": "影",
            "text": "坦白说，那是一场看不到尽头的折磨。",
            "nextDialogs": [
              "120320114"
            ]
          },
          "120320114": {
            "id": "120320114",
            "speakerId": 12076,
            "speakerName": "影",
            "text": "面对无尽的战斗，必须时刻集中注意力。稍有松懈，将军的刀就会要了我的命。",
            "nextDialogs": [
              "120320115"
            ]
          },
          "120320115": {
            "id": "120320115",
            "speakerId": 12076,
            "speakerName": "影",
            "text": "可以说，若是没有此前的经历与见闻，没有刀中之力，我定会落败。",
            "nextDialogs": [
              "120320116"
            ]
          },
          "120320116": {
            "id": "120320116",
            "speakerId": 12076,
            "speakerName": "影",
            "text": "这之中，也有你的功劳。"
          },
          "120320118": {
            "id": "120320118",
            "speakerId": 12076,
            "speakerName": "影",
            "text": "放心吧，我没有忘记，我会叮嘱天领奉行与社奉行。",
            "nextDialogs": [
              "120320119"
            ]
          },
          "120320119": {
            "id": "120320119",
            "speakerId": 12076,
            "speakerName": "影",
            "text": "除了魔物的威胁，我还在担心，神樱树中会不会逸散出其他东西。",
            "nextDialogs": [
              "120320120"
            ]
          },
          "120320120": {
            "id": "120320120",
            "speakerId": 1034,
            "speakerName": "八重神子",
            "text": "那可不好说，除了回忆，地脉里的东西还多着呢。",
            "nextDialogs": [
              "120320121"
            ]
          },
          "120320121": {
            "id": "120320121",
            "speakerId": 12076,
            "speakerName": "影",
            "text": "你也清楚的话，就不要偷懒。"
          },
          "120320123": {
            "id": "120320123",
            "speakerId": 1034,
            "speakerName": "八重神子",
            "text": "哎呀？是谁在胡言乱语当面造谣？",
            "nextDialogs": [
              "120320124"
            ]
          },
          "120320124": {
            "id": "120320124",
            "speakerId": 1034,
            "speakerName": "八重神子",
            "text": "有些话，是不可以随便复述的哦。",
            "nextDialogs": [
              "120320125"
            ]
          },
          "120320125": {
            "id": "120320125",
            "speakerId": 1034,
            "speakerName": "八重神子",
            "text": "出卖我要付出什么代价，你不会想知道的。把我说的话当成我和你的秘密就好，明白了吗？",
            "nextDialogs": [
              "120320126"
            ]
          },
          "120320126": {
            "id": "120320126",
            "speakerId": 12076,
            "speakerName": "影",
            "text": "你们在讨论什么？",
            "nextDialogs": [
              "120320127"
            ]
          },
          "120320127": {
            "id": "120320127",
            "speakerId": 1034,
            "speakerName": "八重神子",
            "text": "没什么，想吃油豆腐了。"
          }
        }
      }
    }
  ]
}
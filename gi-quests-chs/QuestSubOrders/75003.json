    {
      "subId": "7500302",
      "subQuestName": "(test)前往湖心岛$UNRELEASED",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "750030201"
        ],
        "dialogs": {
          "750030201": {
            "id": "750030201",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "test 废弃 哇，这块石碑，突然就亮起来了。$UNRELEASED",
            "nextDialogs": [
              "750030202"
            ]
          },
          "750030202": {
            "id": "750030202",
            "speakerId": 14662,
            "speakerName": "#{REALNAME[ID(2)|SHOWHOST(true)]}",
            "text": "test 废弃  呀！$UNRELEASED",
            "nextDialogs": [
              "750030203"
            ]
          },
          "750030203": {
            "id": "750030203",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "test 废弃 （触摸石碑…）$UNRELEASED",
            "nextDialogs": [
              "750030204"
            ]
          },
          "750030204": {
            "id": "750030204",
            "speakerId": 1002,
            "speakerName": "Black Screen",
            "text": "test 废弃 金色的纹路闪烁光亮之时，一些破碎的画面自你脑中浮现：$UNRELEASED",
            "nextDialogs": [
              "750030205"
            ]
          },
          "750030205": {
            "id": "750030205",
            "speakerId": 1002,
            "speakerName": "Black Screen",
            "text": "test 废弃 巨龙的眼瞳，在人之子的剑下，一分为二。\\n分裂的金印，刻写于白盘之中，是错分的窍孔。$UNRELEASED",
            "nextDialogs": [
              "750030206"
            ]
          },
          "750030206": {
            "id": "750030206",
            "speakerId": 1002,
            "speakerName": "Black Screen",
            "text": "test 废弃 其一被交予银龙的白爪，其一被交予复生的尸骸。\\n其一埋于巨碑之下，而其一受吞刚愎者的腹中。$UNRELEASED",
            "nextDialogs": [
              "750030207"
            ]
          },
          "750030207": {
            "id": "750030207",
            "speakerId": 1002,
            "speakerName": "Black Screen",
            "text": "test 废弃 一块白盘出现在你的脚下，另一块白盘被阴影遮蔽，那遮蔽者敛起双翼，你才能看得到它收拢竖立的瞳孔。$UNRELEASED",
            "nextDialogs": [
              "750030208"
            ]
          },
          "750030208": {
            "id": "750030208",
            "speakerId": 1002,
            "speakerName": "Black Screen",
            "text": "test 废弃 你听到声音，说：\\n「伟哉，伟哉，万年的帝国，奥奇卡纳塔」\\n你看到站在空王座前的人，捡起那块白盘，转头，看向你…$UNRELEASED",
            "nextDialogs": [
              "750030209"
            ]
          },
          "750030209": {
            "id": "750030209",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "#test 废弃 {NICKNAME}，快醒醒…$UNRELEASED",
            "nextDialogs": [
              "750030210"
            ]
          },
          "750030210": {
            "id": "750030210",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "test 废弃 啊，终于有点反应了，刚才你把手按在石碑上之后，又怎么叫都不听了…$UNRELEASED",
            "nextDialogs": [
              "750030211"
            ]
          },
          "750030211": {
            "id": "750030211",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "test 废弃 不过你看，地上出现了一个刻着金色纹路的圆盘，这个应该就是我们要找的信物了吧。$UNRELEASED",
            "nextDialogs": [
              "750030212"
            ]
          },
          "750030212": {
            "id": "750030212",
            "speakerId": 14662,
            "speakerName": "#{REALNAME[ID(2)|SHOWHOST(true)]}",
            "text": "test 废弃 呀！$UNRELEASED",
            "nextDialogs": [
              "750030213"
            ]
          },
          "750030213": {
            "id": "750030213",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "test 废弃 金印…刻写于白盘之中…$UNRELEASED",
            "nextDialogs": [
              "750030214"
            ]
          },
          "750030214": {
            "id": "750030214",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "test 废弃 嗯？你在说什么？$UNRELEASED",
            "nextDialogs": [
              "750030217"
            ]
          },
          "750030217": {
            "id": "750030217",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "#test 废弃 毕竟今天做了很多事，{NICKNAME}大概是累了吧。等我们上去以后，好好休息一下吧！$UNRELEASED",
            "nextDialogs": [
              "750030218"
            ]
          },
          "750030218": {
            "id": "750030218",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "test 废弃 这个信物，看上去就像是一个大的圆盘…这么说来，壁画上一人一龙拿的也都是个大圆盘呢…$UNRELEASED",
            "nextDialogs": [
              "750030219"
            ]
          },
          "750030219": {
            "id": "750030219",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "test 废弃 总之，我们成功获得了一个信物啦，带回去给曼科那家伙看看吧！$UNRELEASED",
            "nextDialogs": [
              "750030220"
            ]
          },
          "750030220": {
            "id": "750030220",
            "speakerId": 14662,
            "speakerName": "#{REALNAME[ID(2)|SHOWHOST(true)]}",
            "text": "test 废弃 呀！$UNRELEASED"
          }
        }
      }

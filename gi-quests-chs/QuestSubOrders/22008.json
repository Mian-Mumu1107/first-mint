            ]
          },
          "220080404": {
            "id": "220080404",
            "speakerId": 2027,
            "speakerName": "沉香",
            "text": "豆豆乖，吃了药你的病才能好，而且，这不是有杏仁豆腐了吗？",
            "nextDialogs": [

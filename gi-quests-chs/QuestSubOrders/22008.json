            ]
          },
          "220080405": {
            "id": "220080405",
            "speakerId": 2028,
            "speakerName": "红豆",
            "text": "呜…白术哥哥那么厉害的人，为什么不能把药做成杏仁豆腐味呢…"
          }
        }

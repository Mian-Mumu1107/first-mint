  "subQuests": [
    {
      "subId": "2200801",
      "subQuestName": "与沉香对话",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "220080101"
        ],
        "dialogs": {
          "220080101": {
            "id": "220080101",
            "speakerId": 2027,
            "speakerName": "沉香",
            "text": "豆豆乖，吃了药病才能好…",
            "nextDialogs": [
              "220080102"
            ]
          },
          "220080102": {
            "id": "220080102",
            "speakerId": 2028,
            "speakerName": "红豆",
            "text": "不嘛不嘛！药太苦了，我不想吃嘛！",
            "nextDialogs": [
              "220080103"
            ]
          },
          "220080103": {
            "id": "220080103",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "怎么了？",
            "nextDialogs": [
              "220080104"
            ]
          },
          "220080104": {
            "id": "220080104",
            "speakerId": 2027,
            "speakerName": "沉香",
            "text": "是旅行者吗…是这样，我家豆豆身子一直不太好，之前求着白先生给开了个方子治病。",
            "nextDialogs": [
              "220080105"
            ]
          },
          "220080105": {
            "id": "220080105",
            "speakerId": 2027,
            "speakerName": "沉香",
            "text": "可豆豆总说不卜庐的药太苦，怎么都不肯吃，唉，这世上的药哪有不苦的呢…",
            "nextDialogs": [
              "220080106"
            ]
          },
          "220080106": {
            "id": "220080106",
            "speakerId": 2027,
            "speakerName": "沉香",
            "text": "为了让这孩子吃药，我答应她，每次喝完药之后就能吃一份「杏仁豆腐」。",
            "nextDialogs": [
              "220080107"
            ]
          },
          "220080107": {
            "id": "220080107",
            "speakerId": 2027,
            "speakerName": "沉香",
            "text": "旅行者，如果您有空的话，能帮我去找份「杏仁豆腐」来吗？我还得再哄哄豆豆…",
            "nextDialogs": [
              "220080109",
              "220080111",
              "220080116"
            ]
          },
          "220080109": {
            "id": "220080109",
            "speakerId": 2027,
            "speakerName": "沉香",
            "text": "那就拜托您了，一份给豆豆吃就够了。"
          },
          "220080111": {
            "id": "220080111",
            "speakerId": 2027,
            "speakerName": "沉香",
            "text": "唉，我也说不好，但是据白先生说，这病极难治根，但就算只治表，也要一直吃药。",
            "nextDialogs": [
              "220080112"
            ]
          },
          "220080112": {
            "id": "220080112",
            "speakerId": 2027,
            "speakerName": "沉香",
            "text": "说不定，豆豆将来要吃一辈子的药，她才这么小…我真是想都不敢想…",
            "nextDialogs": [
              "220080113"
            ]
          },
          "220080113": {
            "id": "220080113",
            "speakerId": 2027,
            "speakerName": "沉香",
            "text": "我真是恨不得是我自己得病。但是…现在我也只能盼着豆豆能少遭点罪…",
            "nextDialogs": [
              "220080114"
            ]
          },
          "220080114": {
            "id": "220080114",
            "speakerId": 2027,
            "speakerName": "沉香",
            "text": "旅行者，拜托您了，帮我去找份杏仁豆腐回来吧，一份就够了。"
          },
          "220080116": {
            "id": "220080116",
            "speakerId": 2028,
            "speakerName": "红豆",
            "text": "那药太苦了！璐璐她们的药都没这么难吃…",
            "nextDialogs": [
              "220080117"
            ]
          },
          "220080117": {
            "id": "220080117",
            "speakerId": 2027,
            "speakerName": "沉香",
            "text": "豆豆，璐璐她们是在做游戏呀，那些都是杏仁豆腐的糖水，不是药。",
            "nextDialogs": [
              "220080118"
            ]
          },
          "220080118": {
            "id": "220080118",
            "speakerId": 2028,
            "speakerName": "红豆",
            "text": "那…那我吃杏仁豆腐不能治好病吗？非得吃那么苦的药…",
            "nextDialogs": [
              "220080119"
            ]
          },
          "220080119": {
            "id": "220080119",
            "speakerId": 2027,
            "speakerName": "沉香",
            "text": "豆豆乖，只要病好了，以后吃什么都可以。",
            "nextDialogs": [
              "220080120"
            ]
          },
          "220080120": {
            "id": "220080120",
            "speakerId": 2028,
            "speakerName": "红豆",
            "text": "为什么药不能和杏仁豆腐一样，都是甜的呢，真讨厌…",
            "nextDialogs": [
              "220080121"
            ]
          },
          "220080121": {
            "id": "220080121",
            "speakerId": 2027,
            "speakerName": "沉香",
            "text": "这孩子真是，唉…旅行者，麻烦您了，请帮我找份杏仁豆腐来吧，一份就够了。"
          }
        }
      }
    },

  },
  "subQuests": [
    {
      "subId": "7210001",
      "subQuestName": "完成「神樱大祓」",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "721000101"
        ],
        "dialogs": {
          "721000101": {
            "id": "721000101",
            "speakerId": 1000,
            "speakerName": "花散里",
            "text": "真是相当了不起。",
            "nextDialogs": [
              "721000102"
            ]
          },
          "721000102": {
            "id": "721000102",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "噫！你怎么…什么时候…为什么…",
            "nextDialogs": [
              "721000103"
            ]
          },
          "721000103": {
            "id": "721000103",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "噫！",
            "nextDialogs": [
              "721000104"
            ]
          },
          "721000104": {
            "id": "721000104",
            "speakerId": 1000,
            "speakerName": "花散里",
            "text": "我果然没看错人，您确实有「净化」的资质。",
            "nextDialogs": [
              "721000106",
              "721000108"
            ]
          },
          "721000106": {
            "id": "721000106",
            "speakerId": 1000,
            "speakerName": "花散里",
            "text": "我很关心您的行动，以及您能否治愈「树根」，所以多少观察了一下二位的行动。如有冒昧，还请您多多海涵。",
            "nextDialogs": [
              "721000110"
            ]
          },
          "721000110": {
            "id": "721000110",
            "speakerId": 1000,
            "speakerName": "花散里",
            "text": "您能够解开结界，真是帮了大忙。",
            "nextDialogs": [
              "721000111"
            ]
          },
          "721000111": {
            "id": "721000111",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "既然她一直在观察我们，也就是说…"
          },
          "721000108": {
            "id": "721000108",
            "speakerId": 1000,
            "speakerName": "花散里",
            "text": "我…",
            "nextDialogs": [
              "721000109"
            ]
          },
          "721000109": {
            "id": "721000109",
            "speakerId": 1000,
            "speakerName": "花散里",
            "text": "如您所见，我不过是一名希望能借助您的力量，祓除妖邪的巫女罢了。"
          }
        }
      }
    },
    {
      "subId": "7210002",
      "subQuestName": "（test）绀田村封印$HIDDEN",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "721000201"
        ],
        "dialogs": {
          "721000201": {
            "id": "721000201",
            "speakerId": 1000,
            "speakerName": "花散里",
            "text": "辛苦二位了。",
            "nextDialogs": [
              "721000202"
            ]
          },
          "721000202": {
            "id": "721000202",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "噫！",
            "nextDialogs": [
              "721000203"
            ]
          },
          "721000203": {
            "id": "721000203",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "怎么又来了…",
            "nextDialogs": [
              "721000204"
            ]
          },
          "721000204": {
            "id": "721000204",
            "speakerId": 1000,
            "speakerName": "花散里",
            "text": "实在抱歉。有的事情，应该说是「习惯」吧。",
            "nextDialogs": [
              "721000205"
            ]
          },
          "721000205": {
            "id": "721000205",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "不对！你怎么又在跟踪我们，还不来打个招呼。",
            "nextDialogs": [
              "721000208"
            ]
          },
          "721000208": {
            "id": "721000208",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "啊，对不起。我一定是跑来跑去太累了…态度不好，真不好意思。",
            "nextDialogs": [
              "721000209"
            ]
          },
          "721000209": {
            "id": "721000209",
            "speakerId": 1000,
            "speakerName": "花散里",
            "text": "不用在意。此处结界能成功解开，「大祓」的进度又推进了一些，实在多谢二位。",
            "nextDialogs": [
              "721000210"
            ]
          },
          "721000210": {
            "id": "721000210",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "话说回来，「神樱大祓」究竟是怎么一回事呀？和你之前让我们做的「净化」，是一回事吗？"
          }
        }
      }
    },

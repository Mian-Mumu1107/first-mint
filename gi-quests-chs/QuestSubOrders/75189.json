          },
          "751890505": {
            "id": "751890505",
            "speakerId": 1002,
            "speakerName": "秘源龙仆",
            "text": "「这次的名字属于『审议之庭』的书记官，实际上在秘源龙仆被发明出来以后，他已经很少亲自动笔。」",
            "nextDialogs": [
              "751890506"
            ]
          },
          "751890506": {
            "id": "751890506",
            "speakerId": 1002,
            "speakerName": "秘源龙仆",
            "text": "「阿万尤…你可以这么称呼。」",
            "nextDialogs": [
              "751890507"
            ]
          },
          "751890507": {
            "id": "751890507",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "好吧，阿万尤，这次你是来帮我们搞定那个什么进入「圣山之心」的许可的吗？",

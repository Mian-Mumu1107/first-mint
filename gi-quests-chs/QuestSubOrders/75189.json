    {
      "subId": "7518910",
      "subQuestName": "与「阿万尤」对话",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "751890401"
        ],
        "dialogs": {
          "751890401": {
            "id": "751890401",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "终于结束了…哼哼，这下我们总算拿到进入那个什么「圣山之心」的「许可」了吧！",
            "nextDialogs": [
              "751890402"
            ]
          },
          "751890402": {
            "id": "751890402",
            "speakerId": 1002,
            "speakerName": "秘源龙仆",
            "text": "「不，我之前说了，这个只是一个『许可』的空壳载体…」",
            "nextDialogs": [
              "751890403"
            ]
          },
          "751890403": {
            "id": "751890403",
            "speakerId": 1002,
            "speakerName": "秘源龙仆",
            "text": "「只是拿着这样一个鳞片做成的玩意儿，里面没有任何持有者的信息的话，是没有办法变成『许可』的。」",
            "nextDialogs": [
              "751890404"
            ]
          },
          "751890404": {
            "id": "751890404",
            "speakerId": 1002,
            "speakerName": "秘源龙仆",
            "text": "「不然这东西不就变成『只要是龙就能够使用』的万能钥匙了吗…」",
            "nextDialogs": [
              "751890405"
            ]
          },
          "751890405": {
            "id": "751890405",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "快，押来一条有身份的龙！",
            "nextDialogs": [
              "751890406"
            ]
          },
          "751890406": {
            "id": "751890406",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "#哪有这样的龙啦…唔，{REALNAME[ID(2)|SHOWHOST(true)]}也是龙，不行吗？",
            "nextDialogs": [
              "751890407"
            ]
          },
          "751890407": {
            "id": "751890407",
            "speakerId": 1003,
            "speakerName": "#{REALNAME[ID(2)|SHOWHOST(true)]}",
            "text": "唔嗯？",
            "nextDialogs": [
              "751890408"
            ]
          },
          "751890408": {
            "id": "751890408",
            "speakerId": 1002,
            "speakerName": "秘源龙仆",
            "text": "「它…现在还没有这样的权能。」",
            "nextDialogs": [
              "751890409"
            ]
          },
          "751890409": {
            "id": "751890409",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "那现在怎么办？",
            "nextDialogs": [
              "751890410"
            ]
          },
          "751890410": {
            "id": "751890410",
            "speakerId": 1002,
            "speakerName": "秘源龙仆",
            "text": "「在很久之前，在伟大的君主进入圣山之心以后，也有一些具备权力，却未曾激活这一『许可』的家伙。」",
            "nextDialogs": [
              "751890411"
            ]
          },
          "751890411": {
            "id": "751890411",
            "speakerId": 1002,
            "speakerName": "秘源龙仆",
            "text": "「或许，摆放如此显眼的『许可』其实是为此而留…」"
          }
        }
      }
    },

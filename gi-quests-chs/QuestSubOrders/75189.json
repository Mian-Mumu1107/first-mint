              "751890508"
            ]
          },
          "751890508": {
            "id": "751890508",
            "speakerId": 1000,
            "speakerName": "「阿万尤」",
            "text": "「不然『圣山之心』设置的『象拟聚星』会在无许可的进入者进入的瞬间进行攻击…」",
            "nextDialogs": [
              "751890509"
            ]
          },
          "751890509": {
            "id": "751890509",
            "speakerId": 1000,
            "speakerName": "「阿万尤」",
            "text": "「…我提取了这具『阿万尤』的记录，进入圣山之心的许可被放置在了审议之庭之上。」",
            "nextDialogs": [
              "751890510"
            ]
          },
          "751890510": {
            "id": "751890510",
            "speakerId": 1000,
            "speakerName": "「阿万尤」",
            "text": "「为此我不得不踏足这里…愚昧却自以为是者集合处，无能而为无能自傲者的聚集地。」",

{
  "lineCounts": {
    "Player": 1,
    "兰弥那离": 24,
    "派蒙": 3
  },
  "subQuests": [
    {
      "subId": "7310014",
      "subQuestName": "",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "731000101"
        ],
        "dialogs": {
          "731000101": {
            "id": "731000101",
            "speakerId": 4246,
            "speakerName": "兰弥那离",
            "text": "#那菈{NICKNAME}想要打开「宝箱」？但是…桓那还有很多兰那罗需要帮助，如果金色的那菈可以去帮助这些兰那罗…",
            "nextDialogs": [
              "731000102"
            ]
          },
          "731000102": {
            "id": "731000102",
            "speakerId": 4246,
            "speakerName": "兰弥那离",
            "text": "兰弥那离会准备好满满的「宝箱」！连同兰宁巴送回的「宝贝」一起，把「箱」喂得饱饱。"
          }
        }
      }
    },
    {
      "subId": "7310002",
      "subQuestName": "",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "731000201"
        ],
        "dialogs": {
          "731000201": {
            "id": "731000201",
            "speakerId": 4246,
            "speakerName": "兰弥那离",
            "text": "#金色的那菈，兰弥那离知道，是帮助过兰那罗的好那菈。所以，兰弥那离的「宝箱」，给那菈{NICKNAME}！"
          }
        }
      }
    },
    {
      "subId": "7310003",
      "subQuestName": "",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "731000301"
        ],
        "dialogs": {
          "731000301": {
            "id": "731000301",
            "speakerId": 4246,
            "speakerName": "兰弥那离",
            "text": "#兰弥那离听说了，那菈{NICKNAME}在桓那「大展身手」…",
            "nextDialogs": [
              "731000302"
            ]
          },
          "731000302": {
            "id": "731000302",
            "speakerId": 4246,
            "speakerName": "兰弥那离",
            "text": "#「宝」已经放进「箱」里，那菈{NICKNAME}可以打开「宝箱」，「不要客气」！"
          }
        }
      }
    },
    {
      "subId": "7310004",
      "subQuestName": "",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "731000401"
        ],
        "dialogs": {
          "731000401": {
            "id": "731000401",
            "speakerId": 4246,
            "speakerName": "兰弥那离",
            "text": "#那菈{NICKNAME}，还有派蒙，好慢！兰弥那离的「宝箱」，早早准备好了，和兰弥那离一起等了好久好久…",
            "nextDialogs": [
              "731000402"
            ]
          },
          "731000402": {
            "id": "731000402",
            "speakerId": 4246,
            "speakerName": "兰弥那离",
            "text": "兰那罗的好朋友，「宝箱」已经满满了，可以打开！"
          }
        }
      }
    },
    {
      "subId": "7310005",
      "subQuestName": "",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "731000501"
        ],
        "dialogs": {
          "731000501": {
            "id": "731000501",
            "speakerId": 4246,
            "speakerName": "兰弥那离",
            "text": "#很多兰那罗告诉兰弥那离，那菈{NICKNAME}和派蒙，做了很多好事…",
            "nextDialogs": [
              "731000502"
            ]
          },
          "731000502": {
            "id": "731000502",
            "speakerId": 4246,
            "speakerName": "兰弥那离",
            "text": "兰弥那离早就知道啦，那些夸奖的话，跑过林间的枝桠，趟过细细的水流，跟着微风一起，都吹进了兰弥那离的「快乐小窝」！",
            "nextDialogs": [
              "731000503"
            ]
          },
          "731000503": {
            "id": "731000503",
            "speakerId": 4246,
            "speakerName": "兰弥那离",
            "text": "#所以兰弥那离，这次也把「箱」塞得满满，就等那菈{NICKNAME}来打开啦。",
            "nextDialogs": [
              "731000504"
            ]
          },
          "731000504": {
            "id": "731000504",
            "speakerId": 4246,
            "speakerName": "兰弥那离",
            "text": "#兰宁巴送回了一些亮晶晶，兰弥那离也都塞进了「箱」里，也许那菈{NICKNAME}会喜欢？",
            "nextDialogs": [
              "731000505"
            ]
          },
          "731000505": {
            "id": "731000505",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "兰宁巴没有回来吗？",
            "nextDialogs": [
              "731000506"
            ]
          },
          "731000506": {
            "id": "731000506",
            "speakerId": 4246,
            "speakerName": "兰弥那离",
            "text": "嗯，兰宁巴不像大树，根扎得很深，他是停不下来的兰那罗。",
            "nextDialogs": [
              "731000507"
            ]
          },
          "731000507": {
            "id": "731000507",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "欸…那兰弥那离独自一个在这里不会寂寞吗？",
            "nextDialogs": [
              "731000508"
            ]
          },
          "731000508": {
            "id": "731000508",
            "speakerId": 4246,
            "speakerName": "兰弥那离",
            "text": "「寂寞」是什么意思？",
            "nextDialogs": [
              "731000509"
            ]
          },
          "731000509": {
            "id": "731000509",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "唔…就是，就是独自一个的时候，很想很想同伴在身边的感觉？",
            "nextDialogs": [
              "731000510"
            ]
          },
          "731000510": {
            "id": "731000510",
            "speakerId": 4246,
            "speakerName": "兰弥那离",
            "text": "桓那兰那有很多兰那罗，所以兰弥那离一点也不「寂寞」哦。",
            "nextDialogs": [
              "731000511"
            ]
          },
          "731000511": {
            "id": "731000511",
            "speakerId": 4246,
            "speakerName": "兰弥那离",
            "text": "不过，兰雅玛和兰宁巴都不在桓那兰那了。以前，三个兰那罗在一起，不管做什么都很开心。",
            "nextDialogs": [
              "731000512"
            ]
          },
          "731000512": {
            "id": "731000512",
            "speakerId": 4246,
            "speakerName": "兰弥那离",
            "text": "兰雅玛的兰迦拉梨很强，很弱的那菈没办法破解。兰宁巴很会画画，画各种各样的东西，好看。",
            "nextDialogs": [
              "731000513"
            ]
          },
          "731000513": {
            "id": "731000513",
            "speakerId": 4246,
            "speakerName": "兰弥那离",
            "text": "但是现在，只有兰弥那离和兰弥那离的「宝箱」…",
            "nextDialogs": [
              "731000514"
            ]
          },
          "731000514": {
            "id": "731000514",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "兰弥那离…",
            "nextDialogs": [
              "731000515"
            ]
          },
          "731000515": {
            "id": "731000515",
            "speakerId": 4246,
            "speakerName": "兰弥那离",
            "text": "没关系，兰弥那离有很多「宝箱」，虽然不知道为什么那菈这么喜欢开箱子…",
            "nextDialogs": [
              "731000516"
            ]
          },
          "731000516": {
            "id": "731000516",
            "speakerId": 4246,
            "speakerName": "兰弥那离",
            "text": "但是兰弥那离是「宝箱」的主人，喜欢宝箱的那菈，也会喜欢兰弥那离的，对吧？",
            "nextDialogs": [
              "731000517"
            ]
          },
          "731000517": {
            "id": "731000517",
            "speakerId": 4246,
            "speakerName": "兰弥那离",
            "text": "不过，兰弥那离没有更多「宝」了，唔…「箱」要过一段肚子空空的生活。",
            "nextDialogs": [
              "731000518"
            ]
          },
          "731000518": {
            "id": "731000518",
            "speakerId": 4246,
            "speakerName": "兰弥那离",
            "text": "#虽然兰弥那离的「宝箱」之后要空空了，那菈{NICKNAME}，还是要做兰那罗的好朋友呀。"
          }
        }
      }
    },
    {
      "subId": "7310006",
      "subQuestName": "",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "731000601"
        ],
        "dialogs": {
          "731000601": {
            "id": "731000601",
            "speakerId": 4246,
            "speakerName": "兰弥那离",
            "text": "#兰弥那离还没有准备好！「宝箱」也还没有吃饱。那菈{NICKNAME}和派蒙可以「游手好闲」…",
            "nextDialogs": [
              "731000602"
            ]
          },
          "731000602": {
            "id": "731000602",
            "speakerId": 4246,
            "speakerName": "兰弥那离",
            "text": "唔，不对，是「四处漫游」。这样，说不定会碰到需要帮助的兰那罗。"
          }
        }
      }
    },
    {
      "subId": "7310007",
      "subQuestName": "",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "731000701"
        ],
        "dialogs": {
          "731000701": {
            "id": "731000701",
            "speakerId": 4246,
            "speakerName": "兰弥那离",
            "text": "#兰弥那离饱饱，「宝箱」饿饿。饿，不好，那菈{NICKNAME}和派蒙走很多路，一定很饿，要多吃蘑菇，这样才有力气。"
          }
        }
      }
    }
  ]
}
    "夏温": 60,
    "派蒙": 21
  },
  "subQuests": [
    {
      "subId": "1501201",
      "subQuestName": "询问伊蜜的状况",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "150120101"
        ],
        "dialogs": {
          "150120101": {
            "id": "150120101",
            "speakerId": 1000,
            "speakerName": "伊蜜",
            "text": "还，还没有回来…夏温师父难道真的出了什么事…呜…",
            "nextDialogs": [
              "150120102"
            ]
          },
          "150120102": {
            "id": "150120102",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "那边的小朋友怎么在哭啊，是发生了什么吗？",
            "nextDialogs": [
              "150120103"
            ]
          },
          "150120103": {
            "id": "150120103",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "#{NICKNAME}，我们过去看看吧。",
            "nextDialogs": [
              "150120104"
            ]
          },
          "150120104": {
            "id": "150120104",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "小妹妹，你怎么了？",
            "nextDialogs": [
              "150120105"
            ]
          },
          "150120105": {
            "id": "150120105",
            "speakerId": 1000,
            "speakerName": "伊蜜",
            "text": "呜…是，是夏温师父…",
            "nextDialogs": [
              "150120106"
            ]
          },
          "150120106": {
            "id": "150120106",
            "speakerId": 1000,
            "speakerName": "伊蜜",
            "text": "她、她说要去那边采「火山晶石」…但是到现在也没回来。",
            "nextDialogs": [
              "150120107"
            ]
          },
          "150120107": {
            "id": "150120107",
            "speakerId": 1000,
            "speakerName": "伊蜜",
            "text": "我告诉了守卫叔叔，但叔叔们说，现在部族里实在抽不开来人手，而且那边的地形很危险，还待着好多魔物和坏蛋…",
            "nextDialogs": [
              "150120108"
            ]
          },
          "150120108": {
            "id": "150120108",
            "speakerId": 1000,
            "speakerName": "伊蜜",
            "text": "他们只能先尽量筹备着，等准备好之后再去营救夏温师父…但那样就来不及了。",
            "nextDialogs": [
              "150120111"
            ]
          },
          "150120111": {
            "id": "150120111",
            "speakerId": 1000,
            "speakerName": "伊蜜",
            "text": "你愿意帮我？太好了！我这就把守卫叔叔之前去过的地方画给你。",
            "nextDialogs": [
              "150120112"
            ]
          },
          "150120112": {
            "id": "150120112",
            "speakerId": 1000,
            "speakerName": "伊蜜",
            "text": "守卫叔叔们说，这可能就是夏温师父待过的地方。",
            "nextDialogs": [
              "150120113"
            ]
          },
          "150120113": {
            "id": "150120113",
            "speakerId": 1000,
            "speakerName": "伊蜜",
            "text": "说不定，她会被迫跑到了「缝影针」附近。如果…如果是那样的话…呜…",
            "nextDialogs": [
              "150120114"
            ]
          },
          "150120114": {
            "id": "150120114",
            "speakerId": 1000,
            "speakerName": "伊蜜",
            "text": "#拜托了，{M#大哥哥}{F#大姐姐}，救救夏温师父吧！"
          }
        }
      }
    },
    {
      "subId": "1501202",
      "subQuestName": "前往营救夏温",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "150120201"
        ],
        "dialogs": {
          "150120201": {
            "id": "150120201",
            "speakerId": 1000,
            "speakerName": "伊蜜",
            "text": "#拜托了，{M#大哥哥}{F#大姐姐}，救救夏温师父吧！"
          }
        }
      }
    },
    {
      "subId": "1501203",
      "subQuestName": "解救夏温",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [],
        "dialogs": {}
      }
    },
    {
      "subId": "1501204",
      "subQuestName": "与夏温对话",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "150120701"
        ],
        "dialogs": {
          "150120701": {
            "id": "150120701",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "她为什么不再打造「古名」了？",
            "nextDialogs": [
              "150120702"
            ]
          },
          "150120702": {
            "id": "150120702",
            "speakerId": 1002,
            "speakerName": "夏温",
            "text": "…因为她的女儿。可怜的小妮赫佳患了重病，特拉佐莉几乎抛下了一切，全心照顾着她。",
            "nextDialogs": [
              "150120703"
            ]
          },
          "150120703": {
            "id": "150120703",
            "speakerId": 1002,
            "speakerName": "夏温",
            "text": "在小妮赫佳病情最严重的那段时间，特拉佐莉就像是一束陷入泥潭的火炬。拼了命的发着光和热，底下的泥水却追逐得越来越近…",
            "nextDialogs": [
              "150120704"
            ]
          },
          "150120704": {
            "id": "150120704",
            "speakerId": 1002,
            "speakerName": "夏温",
            "text": "哎呀，但是还好！多亏了医生的药，还有大灵的保佑，小妮赫佳的生命之火还是重新燃了起来！",
            "nextDialogs": [
              "150120705"
            ]
          },
          "150120705": {
            "id": "150120705",
            "speakerId": 1002,
            "speakerName": "夏温",
            "text": "之后，小妮赫佳的病情也逐渐变好。虽然她身体还很虚弱，只能在家里静养，但这孩子已经有力气写信了。",
            "nextDialogs": [
              "150120706"
            ]
          },
          "150120706": {
            "id": "150120706",
            "speakerId": 1002,
            "speakerName": "夏温",
            "text": "我听说，她经常寄信给那位希诺宁，还梦想着成为一个锻造古名的工匠，接下她母亲曾经为之自豪的重任呢。",
            "nextDialogs": [
              "150120707"
            ]
          },
          "150120707": {
            "id": "150120707",
            "speakerId": 1002,
            "speakerName": "夏温",
            "text": "过几天就是小妮赫佳的生日了，特拉佐莉也特意来拜托我，帮她找一块足够纯净的「火山晶石」，用来给妮赫佳做生日礼物。",
            "nextDialogs": [
              "150120710"
            ]
          },
          "150120710": {
            "id": "150120710",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "确实是一块意义重大的矿石呀。有了这么漂亮的礼物，那个叫妮赫佳的小朋友一定能好得更快。",
            "nextDialogs": [
              "150120711"
            ]
          },
          "150120711": {
            "id": "150120711",
            "speakerId": 1002,
            "speakerName": "夏温",
            "text": "那我就替特拉佐莉和妮赫佳借你吉言了。",
            "nextDialogs": [
              "150120712"
            ]
          },
          "150120712": {
            "id": "150120712",
            "speakerId": 1002,
            "speakerName": "夏温",
            "text": "我们先回去吧，不能让伊蜜那孩子等急了。",
            "nextDialogs": [
              "150120713"
            ]
          },
          "150120713": {
            "id": "150120713",
            "speakerId": 1002,
            "speakerName": "夏温",
            "text": "对了，如果你愿意的话，明天和我一起去探望特拉佐莉吧。",
            "nextDialogs": [
              "150120714"
            ]
          },
          "150120714": {
            "id": "150120714",
            "speakerId": 1002,
            "speakerName": "夏温",
            "text": "多亏了你帮忙，这枚晶石才没被那群人抢走。",
            "nextDialogs": [
              "150120715"
            ]
          },
          "150120715": {
            "id": "150120715",
            "speakerId": 1002,
            "speakerName": "夏温",
            "text": "你保护了这么一枚意义重大的晶石，理应也拿到一份意义重大的礼物。",
            "nextDialogs": [
              "150120716"
            ]
          },
          "150120716": {
            "id": "150120716",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "希望能让妮赫佳开心。",
            "nextDialogs": [
              "150120717"
            ]
          },
          "150120717": {
            "id": "150120717",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "嗯，只要心情好，病就能好得更快！",
            "nextDialogs": [
              "150120718"
            ]
          },
          "150120718": {
            "id": "150120718",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "当然啦，那个…稍微给我们一点礼物，我们的心情也会很好…",
            "nextDialogs": [
              "150120719"
            ]
          },
          "150120719": {
            "id": "150120719",
            "speakerId": 1002,
            "speakerName": "夏温",
            "text": "哈哈哈，放心吧，这份礼物绝对能让你们满意。",
            "nextDialogs": [
              "150120720"
            ]
          },
          "150120720": {
            "id": "150120720",
            "speakerId": 1002,
            "speakerName": "夏温",
            "text": "至于它究竟是什么…就等明天特拉佐莉亲口告诉你们吧。"
          }
        }
      }
    },
    {
      "subId": "1501204",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "150120401"
        ],
        "dialogs": {
          "150120401": {
            "id": "150120401",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "呜哇，跑得好快，也好果断…",
            "nextDialogs": [
              "150120404"
            ]
          },
          "150120404": {
            "id": "150120404",
            "speakerId": 1002,
            "speakerName": "夏温",
            "text": "呼…太谢谢你们了。要不是你们帮忙，我肯定要被丢下山去了。",
            "nextDialogs": [
              "150120405"
            ]
          },
          "150120405": {
            "id": "150120405",
            "speakerId": 1002,
            "speakerName": "夏温",
            "text": "#能让{NICKNAME}出手搭救，我今天的运气也是够好的。",
            "nextDialogs": [
              "150120406"
            ]
          },
          "150120406": {
            "id": "150120406",
            "speakerId": 1002,
            "speakerName": "夏温",
            "text": "抱歉，我没做自我介绍，我是夏温，一个倒霉透顶，刚刚才撞了好运的宝石匠。",
            "nextDialogs": [
              "150120407"
            ]
          },
          "150120407": {
            "id": "150120407",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "是伊蜜拜托我们来的。",
            "nextDialogs": [
              "150120408"
            ]
          },
          "150120408": {
            "id": "150120408",
            "speakerId": 1002,
            "speakerName": "夏温",
            "text": "那孩子…唉，让她担心了。我离开铺子的时候，还以为最多两天就能回来。",
            "nextDialogs": [
              "150120409"
            ]
          },
          "150120409": {
            "id": "150120409",
            "speakerId": 1002,
            "speakerName": "夏温",
            "text": "我也没想到，居然能在「缝影针」附近发现一条新的「火山晶石」矿脉。里面的晶石格外纯净，矿量也足。",
            "nextDialogs": [
              "150120410"
            ]
          },
          "150120410": {
            "id": "150120410",
            "speakerId": 1002,
            "speakerName": "夏温",
            "text": "我挖出了许多纯净的「火山晶石」，正准备回去的时候，晶石里的燃素却吸引来了魔物…"
          }
        }
      }
    },
    {
      "subId": "1501205",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "150120501"
        ],
        "dialogs": {
          "150120501": {
            "id": "150120501",
            "speakerId": 1002,
            "speakerName": "夏温",
            "text": "我慌不择路，只能挑小路绕开它们。没想到刚出来的时候，却撞见了那些贼匪…幸好你们来得及时。",
            "nextDialogs": [
              "150120502"
            ]
          },
          "150120502": {
            "id": "150120502",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "你逃跑的时候，还带着这些晶石吗？都那么危险了，不能把这些石头丢掉吗？",
            "nextDialogs": [
              "150120503"
            ]
          },
          "150120503": {
            "id": "150120503",
            "speakerId": 1002,
            "speakerName": "夏温",
            "text": "我已经丢了很多了。只留下了一块最纯净的晶石。我无论如何都得把它带回去。",
            "nextDialogs": [
              "150120504"
            ]
          },
          "150120504": {
            "id": "150120504",
            "speakerId": 1002,
            "speakerName": "夏温",
            "text": "…为了特拉佐莉，也为了可怜的小妮赫佳。",
            "nextDialogs": [
              "150120505"
            ]
          },
          "150120505": {
            "id": "150120505",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "这两个人是…",
            "nextDialogs": [
              "150120506"
            ]
          },
          "150120506": {
            "id": "150120506",
            "speakerId": 1002,
            "speakerName": "夏温",
            "text": "喔，你不知道也正常。特拉佐莉…曾经是一位打造「古名」的工匠，妮赫佳是她的女儿。"
          }
        }
      }
    },
    {
      "subId": "1501206",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "150120601"
        ],
        "dialogs": {
          "150120601": {
            "id": "150120601",
            "speakerId": 1002,
            "speakerName": "夏温",
            "text": "不过…你也看见这周围的情况了吧。前段时间，一直在上面悬着的「缝影针」突然砸了下去，把周围砸出了一个大坑。",
            "nextDialogs": [
              "150120602"
            ]
          },
          "150120602": {
            "id": "150120602",
            "speakerId": 1002,
            "speakerName": "夏温",
            "text": "虽然我找到的那条矿脉靠外侧，勉强幸免于难…但周围的魔物全被惊了，到处都是发了狂的怪物。",
            "nextDialogs": [
              "150120603"
            ]
          },
          "150120603": {
            "id": "150120603",
            "speakerId": 1002,
            "speakerName": "夏温",
            "text": "我慌不择路，只能挑小路绕开它们。没想到刚出来的时候，却撞见了那些贼匪…幸好你们来得及时。",
            "nextDialogs": [
              "150120604"
            ]
          },
          "150120604": {
            "id": "150120604",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "你逃跑的时候，还带着这些晶石吗？都那么危险了，不能把这些石头丢掉吗？",
            "nextDialogs": [
              "150120605"
            ]
          },
          "150120605": {
            "id": "150120605",
            "speakerId": 1002,
            "speakerName": "夏温",
            "text": "我已经丢了很多了。只留下了一块最纯净的晶石。我无论如何都得把它带回去。",
            "nextDialogs": [
              "150120606"
            ]
          },
          "150120606": {
            "id": "150120606",
            "speakerId": 1002,
            "speakerName": "夏温",
            "text": "…为了特拉佐莉，也为了可怜的小妮赫佳。",
            "nextDialogs": [
              "150120607"
            ]
          },
          "150120607": {
            "id": "150120607",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "这两个人是…",
            "nextDialogs": [
              "150120608"
            ]
          },
          "150120608": {
            "id": "150120608",
            "speakerId": 1002,
            "speakerName": "夏温",
            "text": "喔，你不知道也正常。特拉佐莉…曾经是一位打造「古名」的工匠，妮赫佳是她的女儿。"
          }
        }
      }
    },

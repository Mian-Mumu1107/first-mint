        "dialogs": {
          "762260201": {
            "id": "762260201",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "欸？这不是梅拉吗？居然在月亮上碰面了，真是意想不到。",
            "nextDialogs": [
              "762260202"
            ]
          },
          "762260202": {
            "id": "762260202",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "一定是哥伦比娅带你来的吧？毕竟她说过要带你来月亮上办画展呢。",
            "nextDialogs": [
              "762260203"
            ]
          },
          "762260203": {
            "id": "762260203",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "对了，说到画展…你的画呢？",
            "nextDialogs": [
              "762260204"
            ]
          },
          "762260204": {
            "id": "762260204",
            "speakerId": 15603,
            "speakerName": "梅拉",
            "text": "！",
            "nextDialogs": [
              "762260205"
            ]
          },
          "762260205": {
            "id": "762260205",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "怎么了？难道…画丢了？",
            "nextDialogs": [
              "762260206"
            ]
          },
          "762260206": {
            "id": "762260206",
            "speakerId": 15603,
            "speakerName": "梅拉",
            "text": "！",

        "dialogs": {
          "762260101": {
            "id": "762260101",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "梅拉快看，我们把你的画都找回来啦。",
            "nextDialogs": [
              "762260102"
            ]
          },
          "762260102": {
            "id": "762260102",

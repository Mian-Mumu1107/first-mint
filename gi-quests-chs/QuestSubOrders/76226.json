            ]
          },
          "762260207": {
            "id": "762260207",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "怎么会这样？这可是在月亮上啊，总不能是被偷走了吧…",
            "nextDialogs": [
              "762260208"
            ]
          },
          "762260208": {
            "id": "762260208",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "不管怎么说，我们先帮帮梅拉找一找画吧，也有可能是落在了附近。"
          }
        }

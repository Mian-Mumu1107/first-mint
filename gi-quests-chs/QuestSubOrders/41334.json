    {
      "subId": "4133416",
      "subQuestName": "烹饪一份「美味的珍珠翡翠白玉汤」",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "413341601"
        ],
        "dialogs": {
          "413341601": {
            "id": "413341601",
            "speakerId": 2430,
            "speakerName": "朱老板",
            "text": "旅行者，辛苦你了，一起坐下吃饭吧。"
          }
        }
      }
    },
    {
      "subId": "4133407",
      "subQuestName": "将「美味的珍珠翡翠白玉汤」交给朱老板",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "413342201"
        ],
        "dialogs": {
          "413342201": {
            "id": "413342201",
            "speakerId": 2430,
            "speakerName": "朱老板",
            "text": "怎么样，菜做好了吗？",
            "nextDialogs": [
              "413342202"
            ]
          },
          "413342202": {
            "id": "413342202",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "准备好了。",
            "nextDialogs": [
              "413342203"
            ]
          },
          "413342203": {
            "id": "413342203",
            "speakerId": 2430,
            "speakerName": "朱老板",
            "text": "好，好，这样菜就齐了。谢谢你了。",
            "nextDialogs": [
              "413342204"
            ]
          },
          "413342204": {
            "id": "413342204",
            "speakerId": 2430,
            "speakerName": "朱老板",
            "text": "二位，久等了啊，哈哈哈，请慢用，请慢用。",
            "nextDialogs": [
              "413342205"
            ]
          },
          "413342205": {
            "id": "413342205",
            "speakerId": 2405,
            "speakerName": "鉴秋",
            "text": "谢谢老板。这位旅行者…帮忙跑前跑后的，很是辛苦，就请坐下一起吃吧。",
            "nextDialogs": [
              "413342206"
            ]
          },
          "413342206": {
            "id": "413342206",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "谢谢。",
            "nextDialogs": [
              "413342207"
            ]
          },
          "413342207": {
            "id": "413342207",
            "speakerId": 2405,
            "speakerName": "鉴秋",
            "text": "呵呵，看你模样，应该和我们一样也是远游之人，大过节的，大家一起吃一顿饭，好歹也有些热闹劲。",
            "nextDialogs": [
              "413342208"
            ]
          },
          "413342208": {
            "id": "413342208",
            "speakerId": 2420,
            "speakerName": "花初",
            "text": "嗯，请老板也一起吃吧。",
            "nextDialogs": [
              "413342209"
            ]
          },
          "413342209": {
            "id": "413342209",
            "speakerId": 2430,
            "speakerName": "朱老板",
            "text": "哎哟，那好，那我也就不客气了啊。"
          }
        }
      }
    },

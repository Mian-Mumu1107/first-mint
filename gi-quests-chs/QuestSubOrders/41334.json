  "subQuests": [
    {
      "subId": "4133426",
      "subQuestName": "",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "413342601"
        ],
        "dialogs": {
          "413342601": {
            "id": "413342601",
            "speakerId": 2405,
            "speakerName": "鉴秋",
            "text": "谢谢老板招待了，这是钱，您点一点。",
            "nextDialogs": [
              "413342602"
            ]
          },
          "413342602": {
            "id": "413342602",
            "speakerId": 1629,
            "speakerName": "朱老板",
            "text": "好好，这些钱够了…看二位的样子，是要接着赶路？还是说，要回去城里看看？",
            "nextDialogs": [
              "413342603"
            ]
          },
          "413342603": {
            "id": "413342603",
            "speakerId": 1629,
            "speakerName": "朱老板",
            "text": "我听说今年那「明霄灯」可不一般，神气得很呐。",
            "nextDialogs": [
              "413342604"
            ]
          },
          "413342604": {
            "id": "413342604",
            "speakerId": 2420,
            "speakerName": "花初",
            "text": "我们…",
            "nextDialogs": [
              "413342605"
            ]
          },
          "413342605": {
            "id": "413342605",
            "speakerId": 2405,
            "speakerName": "鉴秋",
            "text": "如果有机会的话，我们会去看的，谢谢老板提醒了。",
            "nextDialogs": [
              "413342606"
            ]
          },
          "413342606": {
            "id": "413342606",
            "speakerId": 2420,
            "speakerName": "花初",
            "text": "不过…老板，可否再卖我们一盏霄灯？",
            "nextDialogs": [
              "413342607"
            ]
          },
          "413342607": {
            "id": "413342607",
            "speakerId": 2420,
            "speakerName": "花初",
            "text": "就算是没机会去城里看「明霄灯」，放一放霄灯也是好的…对吗？",
            "nextDialogs": [
              "413342608"
            ]
          },
          "413342608": {
            "id": "413342608",
            "speakerId": 2405,
            "speakerName": "鉴秋",
            "text": "小姐说的是，海灯节当然应该放霄灯。",
            "nextDialogs": [
              "413342609"
            ]
          },
          "413342609": {
            "id": "413342609",
            "speakerId": 1629,
            "speakerName": "朱老板",
            "text": "那好说，没问题，我手头上正好有几盏新编的霄灯。",
            "nextDialogs": [
              "413342610"
            ]
          },
          "413342610": {
            "id": "413342610",
            "speakerId": 1629,
            "speakerName": "朱老板",
            "text": "喏，送给你们一盏了，大过节的，霄灯就不收你们钱了。",
            "nextDialogs": [
              "413342611"
            ]
          },
          "413342611": {
            "id": "413342611",
            "speakerId": 2405,
            "speakerName": "鉴秋",
            "text": "多谢老板了，那我再多问一句，这周围有什么适合放霄灯的地方吗？",
            "nextDialogs": [
              "413342612"
            ]
          },
          "413342612": {
            "id": "413342612",
            "speakerId": 1629,
            "speakerName": "朱老板",
            "text": "放霄灯的地方…那得高一点，沿着这条路往山上走，我记得有个适合放霄灯的地方。",
            "nextDialogs": [
              "413342613"
            ]
          },
          "413342613": {
            "id": "413342613",
            "speakerId": 1629,
            "speakerName": "朱老板",
            "text": "不过，我听说这山里有魔物出没，你们可要小心点啊。"
          }
        }
      }
    },
    {
      "subId": "4133401",
      "subQuestName": "与朱老板对话",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "413340101"
        ],
        "dialogs": {
          "413340101": {
            "id": "413340101",
            "speakerId": 2430,
            "speakerName": "朱老板",
            "text": "得想个办法…",
            "nextDialogs": [
              "413340102"
            ]
          },
          "413340102": {
            "id": "413340102",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "想什么办法？",
            "nextDialogs": [
              "413340103"
            ]
          },
          "413340103": {
            "id": "413340103",
            "speakerId": 2430,
            "speakerName": "朱老板",
            "text": "啊…是旅行者啊，这不是过海灯节了吗？我想要借着这次海灯节，让我这里的生意红火一点…",
            "nextDialogs": [
              "413340104"
            ]
          },
          "413340104": {
            "id": "413340104",
            "speakerId": 2430,
            "speakerName": "朱老板",
            "text": "你看，我这里的位置也不错，环境也挺好，菜色嘛…也不少。",
            "nextDialogs": [
              "413340105"
            ]
          },
          "413340105": {
            "id": "413340105",
            "speakerId": 2430,
            "speakerName": "朱老板",
            "text": "等城里放飞「明霄灯」的时候，坐在我这里，好景好酒好菜，感觉肯定很不错。",
            "nextDialogs": [
              "413340106"
            ]
          },
          "413340106": {
            "id": "413340106",
            "speakerId": 2430,
            "speakerName": "朱老板",
            "text": "我准备就以这个为卖点招揽客人，你觉得怎么样？",
            "nextDialogs": [
              "413340109"
            ]
          },
          "413340109": {
            "id": "413340109",
            "speakerId": 2430,
            "speakerName": "朱老板",
            "text": "呃…应该看得到吧，「明霄灯」那么大，怎么样都能看到一点…",
            "nextDialogs": [
              "413340110"
            ]
          },
          "413340110": {
            "id": "413340110",
            "speakerId": 2430,
            "speakerName": "朱老板",
            "text": "这个…没关系，到时候再说吧，我得先把店里打理打理…",
            "nextDialogs": [
              "413340111"
            ]
          },
          "413340111": {
            "id": "413340111",
            "speakerId": 2430,
            "speakerName": "朱老板",
            "text": "旅行者，能请你帮忙搜集些做霄灯的材料来吗？我想要挂点霄灯在店里。"
          }
        }
      }
    },
    {
      "subId": "4133411",
      "subQuestName": "",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "413341101"
        ],
        "dialogs": {
          "413341101": {
            "id": "413341101",
            "speakerId": 2430,
            "speakerName": "朱老板",
            "text": "好不容易来了贵客，「美味的珍珠翡翠白玉汤」还得拜托你赶紧准备上，不能怠慢了客人。"
          }
        }
      }
    },
    {
      "subId": "4133402",
      "subQuestName": "搜集两份制作「霄灯」的材料",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "413340201"
        ],
        "dialogs": {
          "413340201": {
            "id": "413340201",
            "speakerId": 2430,
            "speakerName": "朱老板",
            "text": "这里真看不见「明霄灯」吗…"
          }
        }
      }
    },
    {
      "subId": "4133403",
      "subQuestName": "搜集两份制作「霄灯」的材料",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "413340301"
        ],
        "dialogs": {
          "413340301": {
            "id": "413340301",
            "speakerId": 2451,
            "speakerName": "阿笨",
            "text": "还得再编些霄灯才行啊…"
          }
        }
      }
    },
    {
      "subId": "4133404",
      "subQuestName": "",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "413340401"
        ],
        "dialogs": {
          "413340401": {
            "id": "413340401",
            "speakerId": 2430,
            "speakerName": "朱老板",
            "text": "我接着去招揽招揽客人，稍后就算给你报酬。",
            "nextDialogs": [
              "413340402"
            ]
          },
          "413340402": {
            "id": "413340402",
            "speakerId": 2430,
            "speakerName": "朱老板",
            "text": "明华钱庄…明华钱庄…嗯…"
          }
        }
      }
    },
    {
      "subId": "4133405",
      "subQuestName": "",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "413340501"
        ],
        "dialogs": {
          "413340501": {
            "id": "413340501",
            "speakerId": 2451,
            "speakerName": "阿笨",
            "text": "我正发愁材料快不够了，谢谢你。",
            "nextDialogs": [
              "413340502"
            ]
          },
          "413340502": {
            "id": "413340502",
            "speakerId": 2451,
            "speakerName": "阿笨",
            "text": "请你稍等一下，我再编一些霄灯，请你一起把这些霄灯挂上去吧。",
            "nextDialogs": [
              "413340503"
            ]
          },
          "413340503": {
            "id": "413340503",
            "speakerId": 2451,
            "speakerName": "阿笨",
            "text": "好了，这些应该差不多了，请你把这些霄灯挂到店门上去吧。",
            "nextDialogs": [
              "413340504"
            ]
          },
          "413340504": {
            "id": "413340504",
            "speakerId": 2451,
            "speakerName": "阿笨",
            "text": "我还得再编一些，免得之后还要用…"
          }
        }
      }
    },
    {
      "subId": "4133406",
      "subQuestName": "将制作「霄灯」的材料交给阿笨",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "413340601"
        ],
        "dialogs": {
          "413340601": {
            "id": "413340601",
            "speakerId": 2451,
            "speakerName": "阿笨",
            "text": "霄灯…嗯…还得再编几个才行啊…",
            "nextDialogs": [
              "413340602"
            ]
          },
          "413340602": {
            "id": "413340602",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "关于制作霄灯的材料…",
            "nextDialogs": [
              "413340603"
            ]
          },
          "413340603": {
            "id": "413340603",
            "speakerId": 2451,
            "speakerName": "阿笨",
            "text": "对，这些材料给我就行，我来编就好。"
          }
        }
      }
    },

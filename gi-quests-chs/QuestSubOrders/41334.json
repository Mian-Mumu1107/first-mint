    {
      "subId": "4133419",
      "subQuestName": "与鉴秋对话",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "413342701"
        ],
        "dialogs": {
          "413342701": {
            "id": "413342701",
            "speakerId": 2405,
            "speakerName": "鉴秋",
            "text": "旅行者，抱歉打扰你，请问…你愿不愿意护送我们上山去放霄灯？",
            "nextDialogs": [
              "413342704"
            ]
          },
          "413342704": {
            "id": "413342704",
            "speakerId": 2405,
            "speakerName": "鉴秋",
            "text": "抱歉，因为一些事…我们暂时不好回城里。",
            "nextDialogs": [
              "413342705"
            ]
          },
          "413342705": {
            "id": "413342705",
            "speakerId": 2405,
            "speakerName": "鉴秋",
            "text": "那就拜托你护送一下我们了，快些出发吧。",
            "nextDialogs": [
              "413342706"
            ]
          },
          "413342706": {
            "id": "413342706",
            "speakerId": 2405,
            "speakerName": "鉴秋",
            "text": "放完霄灯后…我们就要接着赶路了。"
          }
        }
      }
    },
    {
      "subId": "4133420",
      "subQuestName": "护送两人前往高处放飞霄灯",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "413342001"
        ],
        "dialogs": {
          "413342001": {
            "id": "413342001",
            "speakerId": 2420,
            "speakerName": "花初",
            "text": "对不起…我只是…",
            "nextDialogs": [
              "413342002"
            ]
          },
          "413342002": {
            "id": "413342002",
            "speakerId": 2405,
            "speakerName": "鉴秋",
            "text": "小姐，不要这么说，现在再看看霄灯也好，以后…"
          }
        }
      }
    },
    {
      "subId": "4133421",
      "subQuestName": "护送两人前往高处放飞霄灯",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "413342101"
        ],
        "dialogs": {
          "413342101": {
            "id": "413342101",
            "speakerId": 2405,
            "speakerName": "鉴秋",
            "text": "在这里放霄灯确实不错，谢谢你，旅行者。",
            "nextDialogs": [
              "413342102"
            ]
          },
          "413342102": {
            "id": "413342102",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "不客气。",
            "nextDialogs": [
              "413342103"
            ]
          },
          "413342103": {
            "id": "413342103",
            "speakerId": 2405,
            "speakerName": "鉴秋",
            "text": "希望…小姐的愿望能够实现。",
            "nextDialogs": [
              "413342104"
            ]
          },
          "413342104": {
            "id": "413342104",
            "speakerId": 2420,
            "speakerName": "花初",
            "text": "……",
            "nextDialogs": [
              "413342105"
            ]
          },
          "413342105": {
            "id": "413342105",
            "speakerId": 2405,
            "speakerName": "鉴秋",
            "text": "谢谢你旅行者，我们这就接着去赶路了。"
          }
        }
      }
    },
    {
      "subId": "4133422",
      "subQuestName": "与朱老板对话",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "413342801"
        ],
        "dialogs": {
          "413342801": {
            "id": "413342801",
            "speakerId": 2430,
            "speakerName": "朱老板",
            "text": "你回来了啊，哎呀…这大过节的，是真的不好招揽客人…",
            "nextDialogs": [
              "413342802"
            ]
          },
          "413342802": {
            "id": "413342802",
            "speakerId": 2430,
            "speakerName": "朱老板",
            "text": "咦？刚才那两位呢，走了？",
            "nextDialogs": [
              "413342803"
            ]
          },
          "413342803": {
            "id": "413342803",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "接着赶路去了。",
            "nextDialogs": [
              "413342804"
            ]
          },
          "413342804": {
            "id": "413342804",
            "speakerId": 2430,
            "speakerName": "朱老板",
            "text": "噢，这样啊…大过节的还要赶路，也是挺辛苦的。",
            "nextDialogs": [
              "413342805"
            ]
          },
          "413342805": {
            "id": "413342805",
            "speakerId": 2430,
            "speakerName": "朱老板",
            "text": "不过，说起来倒也很怪啊，人家赶路要么是从璃月往外走，要么是从外面往璃月走，一路走个不停。",
            "nextDialogs": [
              "413342806"
            ]
          },
          "413342806": {
            "id": "413342806",
            "speakerId": 2430,
            "speakerName": "朱老板",
            "text": "我遇见这两位的时候，看他们的神情，完全是一副不知道该往哪里走的样子。",
            "nextDialogs": [
              "413342807"
            ]
          },
          "413342807": {
            "id": "413342807",
            "speakerId": 2430,
            "speakerName": "朱老板",
            "text": "我招呼他们的时候，他们还被吓了一跳。而且看他们的穿着打扮…我也总觉得哪里怪怪的…",
            "nextDialogs": [
              "413342808"
            ]
          },
          "413342808": {
            "id": "413342808",
            "speakerId": 2430,
            "speakerName": "朱老板",
            "text": "算了，不说这些了，这些是说好的报酬，收下吧。",
            "nextDialogs": [
              "413342809"
            ]
          },
          "413342809": {
            "id": "413342809",
            "speakerId": 2430,
            "speakerName": "朱老板",
            "text": "谢谢你帮我的忙，我要接着去打理生意了。"
          }
        }
      }
    },

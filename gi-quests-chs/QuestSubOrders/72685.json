  "subQuests": [
    {
      "subId": "7268501",
      "subQuestName": "与驹形对话",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "726850101"
        ],
        "dialogs": {
          "726850101": {
            "id": "726850101",
            "speakerId": 1000,
            "speakerName": "驹形",
            "text": "你好啊，容彩祭的客人！",
            "nextDialogs": [
              "726850102"
            ]
          },
          "726850102": {
            "id": "726850102",
            "speakerId": 1000,
            "speakerName": "驹形",
            "text": "来试试全新版本的「机关棋谭」吧！",
            "nextDialogs": [
              "726850104",
              "726850120"
            ]
          },
          "726850104": {
            "id": "726850104",
            "speakerId": 1000,
            "speakerName": "驹形",
            "text": "是一种来自璃月的桌上「游戏」，很有意思哦！",
            "nextDialogs": [
              "726850105"
            ]
          },
          "726850105": {
            "id": "726850105",
            "speakerId": 1000,
            "speakerName": "驹形",
            "text": "「机关棋谭」的发明者是瑞锦小姐，她给了我「海外代理」的资格，让我在稻妻推广这款「游戏」。",
            "nextDialogs": [
              "726850106"
            ]
          },
          "726850106": {
            "id": "726850106",
            "speakerId": 1000,
            "speakerName": "驹形",
            "text": "最近我一直在和瑞锦小姐书信来往，和她一起改进「机关棋谭」的玩法。",
            "nextDialogs": [
              "726850107"
            ]
          },
          "726850107": {
            "id": "726850107",
            "speakerId": 1000,
            "speakerName": "驹形",
            "text": "正巧，我们刚刚完成新的规划，就收到了「光华容彩祭」即将举办的消息。",
            "nextDialogs": [
              "726850108"
            ]
          },
          "726850108": {
            "id": "726850108",
            "speakerId": 1000,
            "speakerName": "驹形",
            "text": "决定参展后，过了一段时间，我听说会有一位大人物到场，考察「机关棋谭」的商业潜力。",
            "nextDialogs": [
              "726850109"
            ]
          },
          "726850109": {
            "id": "726850109",
            "speakerId": 1000,
            "speakerName": "驹形",
            "text": "那我就更得加把劲了！希望大家都能喜欢有趣的「机关棋谭」！",
            "nextDialogs": [
              "726850110"
            ]
          },
          "726850110": {
            "id": "726850110",
            "speakerId": 1000,
            "speakerName": "驹形",
            "text": "你们想体验一下「机关棋谭·巧策之局」吗？",
            "nextDialogs": [
              "726850111"
            ]
          },
          "726850111": {
            "id": "726850111",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "「巧策之局」？",
            "nextDialogs": [
              "726850112"
            ]
          },
          "726850112": {
            "id": "726850112",
            "speakerId": 1000,
            "speakerName": "驹形",
            "text": "简单来说，是「机关棋谭」的最新玩法，灵感来源于璃月棋类游戏中的「残局」。",
            "nextDialogs": [
              "726850113"
            ]
          },
          "726850113": {
            "id": "726850113",
            "speakerId": 1000,
            "speakerName": "驹形",
            "text": "在「巧策之局」的棋局揭晓之时，棋盘上已经布置了一些机关。",
            "nextDialogs": [
              "726850114"
            ]
          },
          "726850114": {
            "id": "726850114",
            "speakerId": 1000,
            "speakerName": "驹形",
            "text": "棋手们需要分析局势，决定如何利用这些机关，谨慎取舍，思考取胜的对策。",
            "nextDialogs": [
              "726850115"
            ]
          },
          "726850115": {
            "id": "726850115",
            "speakerId": 1000,
            "speakerName": "驹形",
            "text": "相比以前的版本，「巧策之局」的节奏更快，也更考验棋手的判断力，相当具有挑战性！",
            "nextDialogs": [
              "726850116"
            ]
          },
          "726850116": {
            "id": "726850116",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "那就试试看吧。",
            "nextDialogs": [
              "726850117"
            ]
          },
          "726850117": {
            "id": "726850117",
            "speakerId": 1000,
            "speakerName": "驹形",
            "text": "希望「巧策之局」能为你带来满意的体验！",
            "nextDialogs": [
              "726850118"
            ]
          },
          "726850118": {
            "id": "726850118",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "游玩「机关棋谭」。"
          },
          "726850120": {
            "id": "726850120",
            "speakerId": 1000,
            "speakerName": "驹形",
            "text": "啊呀，没想到你还记得我！",
            "nextDialogs": [
              "726850121"
            ]
          },
          "726850121": {
            "id": "726850121",
            "speakerId": 1000,
            "speakerName": "驹形",
            "text": "上次多亏了你！你发掘了很多奇妙的玩法，让我意识到「机关棋谭」还有很大的改进空间。",
            "nextDialogs": [
              "726850122"
            ]
          },
          "726850122": {
            "id": "726850122",
            "speakerId": 1000,
            "speakerName": "驹形",
            "text": "「灵妙之局」的推广活动结束后，我就写信给瑞锦小姐，表达了我的看法。",
            "nextDialogs": [
              "726850123"
            ]
          },
          "726850123": {
            "id": "726850123",
            "speakerId": 1000,
            "speakerName": "驹形",
            "text": "没想到瑞锦小姐的想法居然和我一样！我果然是个合格的「海外代理」啊，嘿嘿…",
            "nextDialogs": [
              "726850124"
            ]
          },
          "726850124": {
            "id": "726850124",
            "speakerId": 1000,
            "speakerName": "驹形",
            "text": "总之，我和瑞锦小姐多次交流后，一同推出了最新版的「机关棋谭」，就是现在这款「巧策之局」。",
            "nextDialogs": [
              "726850125"
            ]
          },
          "726850125": {
            "id": "726850125",
            "speakerId": 1000,
            "speakerName": "驹形",
            "text": "「巧策之局」的灵感来源于璃月棋类游戏中的「残局」。",
            "nextDialogs": [
              "726850126"
            ]
          },
          "726850126": {
            "id": "726850126",
            "speakerId": 1000,
            "speakerName": "驹形",
            "text": "在「巧策之局」的棋局揭晓之时，棋盘上已经布置了一些机关。",
            "nextDialogs": [
              "726850127"
            ]
          },
          "726850127": {
            "id": "726850127",
            "speakerId": 1000,
            "speakerName": "驹形",
            "text": "棋手们需要分析局势，决定如何利用这些机关，谨慎取舍，思考取胜的对策。",
            "nextDialogs": [
              "726850128"
            ]
          },
          "726850128": {
            "id": "726850128",
            "speakerId": 1000,
            "speakerName": "驹形",
            "text": "相比以前的版本，「巧策之局」的节奏更快，也更考验棋手的判断力，相当具有挑战性！",
            "nextDialogs": [
              "726850129"
            ]
          },
          "726850129": {
            "id": "726850129",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "听起来很有趣。",
            "nextDialogs": [
              "726850130"
            ]
          },
          "726850130": {
            "id": "726850130",
            "speakerId": 1000,
            "speakerName": "驹形",
            "text": "是吧是吧！我已经等不及要看客人们游玩后的反应了。",
            "nextDialogs": [
              "726850131"
            ]
          },
          "726850131": {
            "id": "726850131",
            "speakerId": 1000,
            "speakerName": "驹形",
            "text": "经过一段时间的代理，我也差不多上道了。所以我打算趁着容彩祭，让更多人熟悉这款「游戏」。",
            "nextDialogs": [
              "726850132"
            ]
          },
          "726850132": {
            "id": "726850132",
            "speakerId": 1000,
            "speakerName": "驹形",
            "text": "听说还会有大人物到场，考察「机关棋谭」的商业潜力呢！希望容彩祭能成为「机关棋谭」火爆的契机！",
            "nextDialogs": [
              "726850133"
            ]
          },
          "726850133": {
            "id": "726850133",
            "speakerId": 1000,
            "speakerName": "驹形",
            "text": "怎么样，现在就试试「巧策之局」吧？",
            "nextDialogs": [
              "726850134"
            ]
          },
          "726850134": {
            "id": "726850134",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "游玩「机关棋谭」。"
          }
        }
      }
    }
  ]
}
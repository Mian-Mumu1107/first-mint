    {
      "subId": "7904508",
      "subQuestName": "与「船员们」会合",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "790450801"
        ],
        "dialogs": {
          "790450801": {
            "id": "790450801",
            "speakerId": 1001,
            "speakerName": "来自喇叭的旁白",
            "text": "可喜可贺，可喜可贺！在两位新人水手的帮助下，威尔船长的老仇家落荒而逃。",
            "nextDialogs": [
              "790450802"
            ]
          },
          "790450802": {
            "id": "790450802",
            "speakerId": 1001,
            "speakerName": "来自喇叭的旁白",
            "text": "所有的困难险阻都已被突破，再也没有什么可以阻挡「黑水晶」号的众人！",
            "nextDialogs": [
              "790450803"
            ]
          },
          "790450803": {
            "id": "790450803",
            "speakerId": 1005,
            "speakerName": "威尔船长",
            "text": "不愧是我的好弟兄，被那些家伙伏击，也临危不乱…",
            "nextDialogs": [
              "790450804"
            ]
          },
          "790450804": {
            "id": "790450804",
            "speakerId": 1005,
            "speakerName": "威尔船长",
            "text": "当然，我们的新人也立下了大功！新人们一直在前方拔掉硬茬，才让我们顺顺利利地抵达终点。",
            "nextDialogs": [
              "790450805"
            ]
          },
          "790450805": {
            "id": "790450805",
            "speakerId": 1003,
            "speakerName": "派蒙",
            "text": "#那还用说！这样的坏海盗，再来两三船都不够我和{NICKNAME}打！",
            "nextDialogs": [
              "790450808"
            ]
          },
          "790450808": {
            "id": "790450808",
            "speakerId": 1003,
            "speakerName": "派蒙",
            "text": "还，还行吧！毕竟这一路还挺惊险的，我们也算是和威尔船长他们共渡难关了，当然要认真一点！",
            "nextDialogs": [
              "790450809"
            ]
          },
          "790450809": {
            "id": "790450809",
            "speakerId": 1005,
            "speakerName": "威尔船长",
            "text": "根据调查，打碎那堵石墙，就能找到传说中的宝藏了。",
            "nextDialogs": [
              "790450810"
            ]
          },
          "790450810": {
            "id": "790450810",
            "speakerId": 1005,
            "speakerName": "威尔船长",
            "text": "最关键的时候到了，这最重要的一步，就由我们的大功臣——两位新人来完成吧！",
            "nextDialogs": [
              "790450811"
            ]
          },
          "790450811": {
            "id": "790450811",
            "speakerId": 1005,
            "speakerName": "威尔船长",
            "text": "在这之后，我还有一个新的想法，要和大家谈一谈…",
            "nextDialogs": [
              "790450812"
            ]
          },
          "790450812": {
            "id": "790450812",
            "speakerId": 1003,
            "speakerName": "派蒙",
            "text": "#你看，{NICKNAME}！威尔船长越来越重视我们了，把这关键的一步都交给了我们！"
          }
        }
      }
    },
    {
      "subId": "7904509",
      "subQuestName": "开启「藏宝处」",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [],
        "dialogs": {}
      }
    },
    {
      "subId": "7904511",
      "subQuestName": "前往「藏宝地」",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "790451001"
        ],
        "dialogs": {
          "790451001": {
            "id": "790451001",
            "speakerId": 1003,
            "speakerName": "派蒙",
            "text": "成功啦！找到传说中的宝藏了！真的满眼都是摩拉，可以在里面游泳！",
            "nextDialogs": [
              "790451002"
            ]
          },
          "790451002": {
            "id": "790451002",
            "speakerId": 1003,
            "speakerName": "派蒙",
            "text": "可是，怎么感觉这些摩拉和平常见到的有点不一样？该不会…",
            "nextDialogs": [
              "790451003"
            ]
          },
          "790451003": {
            "id": "790451003",
            "speakerId": 1001,
            "speakerName": "来自喇叭的旁白",
            "text": "这是怎么回事？传说中的「摩拉浴池」中，居然都是一些装饰性的假金币？",
            "nextDialogs": [
              "790451004"
            ]
          },
          "790451004": {
            "id": "790451004",
            "speakerId": 1001,
            "speakerName": "来自喇叭的旁白",
            "text": "面对突如其来的意外，「黑水晶」号的众人会作何反应呢？",
            "nextDialogs": [
              "790451005"
            ]
          },
          "790451005": {
            "id": "790451005",
            "speakerId": 1002,
            "speakerName": "大副",
            "text": "船长！这和情报里说的不一样啊？传说中的宝藏，怎么全都是…假币？",
            "nextDialogs": [
              "790451006"
            ]
          },
          "790451006": {
            "id": "790451006",
            "speakerId": 1005,
            "speakerName": "威尔船长",
            "text": "唉…不祥的预感应验了。",
            "nextDialogs": [
              "790451007"
            ]
          },
          "790451007": {
            "id": "790451007",
            "speakerId": 1005,
            "speakerName": "威尔船长",
            "text": "传说中的宝藏可能是个幌子——某些别有用心的人将它当成了诱饵。",
            "nextDialogs": [
              "790451008"
            ]
          },
          "790451008": {
            "id": "790451008",
            "speakerId": 1005,
            "speakerName": "威尔船长",
            "text": "幕后黑手的目标，是突破重重困难，前来寻找宝藏的人…这些人所携带的精锐武器，性能绝佳的船舶，全都价值不菲。",
            "nextDialogs": [
              "790451009"
            ]
          },
          "790451009": {
            "id": "790451009",
            "speakerId": 1005,
            "speakerName": "威尔船长",
            "text": "俘获了这些筋疲力尽的战士后，幕后黑手也能将他们当成苦力贩卖。",
            "nextDialogs": [
              "790451010"
            ]
          },
          "790451010": {
            "id": "790451010",
            "speakerId": 1003,
            "speakerName": "派蒙",
            "text": "可恶啊…所有人都被骗了！怎么会有这种骗局！",
            "nextDialogs": [
              "790451013"
            ]
          },
          "790451013": {
            "id": "790451013",
            "speakerId": 1003,
            "speakerName": "派蒙",
            "text": "呃，也对哦，你这么一说我差点都忘了，我们还在参演话剧呢…",
            "nextDialogs": [
              "790451014"
            ]
          },
          "790451014": {
            "id": "790451014",
            "speakerId": 1003,
            "speakerName": "派蒙",
            "text": "虽然没有其他演员，布景也有点遗憾啦，但可以感觉到，幕后的工作人员还是非常努力的，我们也应该认真一点！",
            "nextDialogs": [
              "790451015"
            ]
          },
          "790451015": {
            "id": "790451015",
            "speakerId": 1003,
            "speakerName": "派蒙",
            "text": "让我们听听「黑水晶」号的大家都有什么想法吧。",
            "nextDialogs": [
              "790451016"
            ]
          },
          "790451016": {
            "id": "790451016",
            "speakerId": 1001,
            "speakerName": "来自喇叭的旁白",
            "text": "在虚假的宝藏前，威尔船长召集了沮丧的船员们。",
            "nextDialogs": [
              "790451017"
            ]
          },
          "790451017": {
            "id": "790451017",
            "speakerId": 1002,
            "speakerName": "大副",
            "text": "船长，难道说，你的仇家就在干这种勾当…",
            "nextDialogs": [
              "790451018"
            ]
          },
          "790451018": {
            "id": "790451018",
            "speakerId": 1005,
            "speakerName": "威尔船长",
            "text": "不，他们应该没有那种本事，要是我们不来，失望的就是他们了。",
            "nextDialogs": [
              "790451019"
            ]
          },
          "790451019": {
            "id": "790451019",
            "speakerId": 1005,
            "speakerName": "威尔船长",
            "text": "或许…幕后黑手正在赶来的路上。以我们目前的状态，迎击他们可不是个明智的选择。",
            "nextDialogs": [
              "790451020"
            ]
          },
          "790451020": {
            "id": "790451020",
            "speakerId": 1005,
            "speakerName": "威尔船长",
            "text": "打扫一下战场，看看有没有其他宝箱，然后准备撤离吧。",
            "nextDialogs": [
              "790451021"
            ]
          },
          "790451021": {
            "id": "790451021",
            "speakerId": 1005,
            "speakerName": "威尔船长",
            "text": "我们一向论功行赏，眼前的那个宝箱就是新人们的战利品了，哪怕空手而归，其他船员也不能和他们争抢！",
            "nextDialogs": [
              "790451022"
            ]
          },
          "790451022": {
            "id": "790451022",
            "speakerId": 1006,
            "speakerName": "众水手",
            "text": "可恶，这样算下来，我们这次出海根本就没赚到一分钱，反而赔了不少…",
            "nextDialogs": [
              "790451023"
            ]
          },
          "790451023": {
            "id": "790451023",
            "speakerId": 1006,
            "speakerName": "众水手",
            "text": "怎么办，难道我们又要继续打劫那些不良商人，东拼西凑筹钱去给海怪了吗？",
            "nextDialogs": [
              "790451024"
            ]
          },
          "790451024": {
            "id": "790451024",
            "speakerId": 1005,
            "speakerName": "威尔船长",
            "text": "我正想强调，这次出海，我们「黑水晶」号绝不是空手而归，我们其实找到了比摩拉更珍贵的宝藏——",
            "nextDialogs": [
              "790451025"
            ]
          },
          "790451025": {
            "id": "790451025",
            "speakerId": 1005,
            "speakerName": "威尔船长",
            "text": "穿越凶险海域的技巧，击败强大敌人的战法，还有克服困难的勇气。",
            "nextDialogs": [
              "790451026"
            ]
          },
          "790451026": {
            "id": "790451026",
            "speakerId": 1005,
            "speakerName": "威尔船长",
            "text": "你们仔细想一想，就算我们真的拿到了宝藏，获得了不计其数的摩拉，难道就能从海怪那里换取镇子的和平了吗？",
            "nextDialogs": [
              "790451027"
            ]
          },
          "790451027": {
            "id": "790451027",
            "speakerId": 1006,
            "speakerName": "众水手",
            "text": "…说来也是…",
            "nextDialogs": [
              "790451028"
            ]
          },
          "790451028": {
            "id": "790451028",
            "speakerId": 1006,
            "speakerName": "众水手",
            "text": "凭海怪贪婪的性格，它大概会变本加厉，要求我们献上更多财物吧。",
            "nextDialogs": [
              "790451029"
            ]
          },
          "790451029": {
            "id": "790451029",
            "speakerId": 1006,
            "speakerName": "众水手",
            "text": "听说最富裕的几个小镇上缴的财物是我们的好几十倍，也没有让海怪满足。"
          }
        }
      }
    },
    {
      "subId": "7904510",
      "subQuestName": "(test)废弃",

  },
  "subQuests": [
    {
      "subId": "7904501",
      "subQuestName": "聆听剧目告示",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "790450101"
        ],
        "dialogs": {
          "790450101": {
            "id": "790450101",
            "speakerId": 1000,
            "speakerName": "乐园告示喇叭",
            "text": "人员与设施准备停当，机关预热完毕。",
            "nextDialogs": [
              "790450102"
            ]
          },
          "790450102": {
            "id": "790450102",
            "speakerId": 1000,
            "speakerName": "乐园告示喇叭",
            "text": "「黛依阿的三日遐想」之「黑水晶号与吞金海怪」，正式开幕…",
            "nextDialogs": [
              "790450103"
            ]
          },
          "790450103": {
            "id": "790450103",
            "speakerId": 1001,
            "speakerName": "来自喇叭的旁白",
            "text": "距离藏宝地最近的海港中，海盗船「黑水晶」号正在补充人员与物资，为最后也是最关键的一段航行做准备…",
            "nextDialogs": [
              "790450104"
            ]
          },
          "790450104": {
            "id": "790450104",
            "speakerId": 1001,
            "speakerName": "来自喇叭的旁白",
            "text": "#经验丰富的冒险家们登上了「黑水晶」号的甲板。{M#他们}{F#她们}是杰出的战斗专家，但在航海领域尚且只是新人…",
            "nextDialogs": [
              "790450105"
            ]
          },
          "790450105": {
            "id": "790450105",
            "speakerId": 1002,
            "speakerName": "大副",
            "text": "那边的新人，快过来快过来！",
            "nextDialogs": [
              "790450106"
            ]
          },
          "790450106": {
            "id": "790450106",
            "speakerId": 1003,
            "speakerName": "派蒙",
            "text": "咦，喇叭里的声音变了，好像是个很严肃的人在朝我们这边呼喊…",
            "nextDialogs": [
              "790450107"
            ]
          },
          "790450107": {
            "id": "790450107",
            "speakerId": 1003,
            "speakerName": "派蒙",
            "text": "难道说，这个声音是在和我们互动？",
            "nextDialogs": [
              "790450108"
            ]
          },
          "790450108": {
            "id": "790450108",
            "speakerId": 1002,
            "speakerName": "大副",
            "text": "当然了！你们是新人里的骨干，少了你们可不行！",
            "nextDialogs": [
              "790450109"
            ]
          },
          "790450109": {
            "id": "790450109",
            "speakerId": 1002,
            "speakerName": "大副",
            "text": "我是这艘「黑水晶」号的大副。接下来这段时间，你们就要跟着我混了！",
            "nextDialogs": [
              "790450110"
            ]
          },
          "790450110": {
            "id": "790450110",
            "speakerId": 1002,
            "speakerName": "大副",
            "text": "打起精神来！今天你们刚到任，厨师长会用上好的肉脯、奶油、硬饼干和蒲公英酒招待你们！",
            "nextDialogs": [
              "790450111"
            ]
          },
          "790450111": {
            "id": "790450111",
            "speakerId": 1004,
            "speakerName": "Black Screen",
            "text": "来自喇叭的旁白继续述说着你们眼前的场景——\\n\\n出现在新人眼前的大副衣衫褴褛，全身上下打满绷带。\\n显然，不久之前，他才经历过一场激烈的战斗。\\n而放眼望去，甲板上的水手们大多身受重伤…\\n但他们精神饱满，斗志昂扬，完全没有气馁或退缩…\\n水手们将你们围在中间，鼓掌欢迎你们的加入，递上了见面礼和各种食物。",
            "nextDialogs": [
              "790450112"
            ]
          },
          "790450112": {
            "id": "790450112",
            "speakerId": 1003,
            "speakerName": "派蒙",
            "text": "原来如此，还有详细的旁白，让我们想象现在的情景呢——我们刚到这艘「黑水晶」号来报到，就受到了大家的热烈欢迎…",
            "nextDialogs": [
              "790450113"
            ]
          },
          "790450113": {
            "id": "790450113",
            "speakerId": 1003,
            "speakerName": "派蒙",
            "text": "那我们是不是应该配合一下？",
            "nextDialogs": [
              "790450114"
            ]
          },
          "790450114": {
            "id": "790450114",
            "speakerId": 1003,
            "speakerName": "派蒙",
            "text": "嘿嘿嘿，谢谢大家，谢谢大家！船上的肉脯和硬饼干，虽然没有尝过，但味道应该还不错？",
            "nextDialogs": [
              "790450117"
            ]
          },
          "790450117": {
            "id": "790450117",
            "speakerId": 1003,
            "speakerName": "派蒙",
            "text": "确实呢，这个游乐项目取名「三日遐想」，难道真的是要我们充分发挥「遐想」的力量吗？",
            "nextDialogs": [
              "790450118"
            ]
          },
          "790450118": {
            "id": "790450118",
            "speakerId": 1003,
            "speakerName": "派蒙",
            "text": "虽然出于节约成本的角度可以理解啦——真的搭建一艘海盗船，再准备好可以随意航行的场地，肯定要花很多摩拉…",
            "nextDialogs": [
              "790450119"
            ]
          },
          "790450119": {
            "id": "790450119",
            "speakerId": 1003,
            "speakerName": "派蒙",
            "text": "但完全只靠对白文字，未免也太勉强我们了嘛！"
          }
        }
      }
    },

    {
      "subId": "7411402",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "741140201"
        ],
        "dialogs": {
          "741140201": {
            "id": "741140201",
            "speakerId": 13489,
            "speakerName": "邱老板",
            "text": "唉，那些映影画片不会被水泡坏吧…",
            "nextDialogs": [
              "741140202"
            ]
          },
          "741140202": {
            "id": "741140202",
            "speakerId": 13491,
            "speakerName": "弈丰",
            "text": "放心吧老板，这个箱子可牢靠了，水渗不进去。",
            "nextDialogs": [
              "741140203"
            ]
          },
          "741140203": {
            "id": "741140203",
            "speakerId": 13490,
            "speakerName": "兴晔",
            "text": "还好我们的映影机没有掉进水里，不然可就完蛋了…"
          }
        }
      }
    },
    {
      "subId": "7411405",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "741140501"
        ],
        "dialogs": {
          "741140501": {
            "id": "741140501",
            "speakerId": 13489,
            "speakerName": "邱老板",
            "text": "#{NICKNAME}，您拿到茉洁草了吗？",
            "nextDialogs": [
              "741140502"
            ]
          },
          "741140502": {
            "id": "741140502",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "拿到了。"
          }
        }
      }
    }
  ]

  "subQuests": [
    {
      "subId": "7411402",
      "subQuestName": "与邱老板一行人对话$HIDDEN",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "741140101"
        ],
        "dialogs": {
          "741140101": {
            "id": "741140101",
            "speakerId": 13489,
            "speakerName": "邱老板",
            "text": "没关系，我们的那个箱子是防水的。现在我们只需要潜下去，把箱子捞上来…",
            "nextDialogs": [
              "741140102"
            ]
          },
          "741140102": {
            "id": "741140102",
            "speakerId": 13490,
            "speakerName": "兴晔",
            "text": "老板，但我们三个人里谁都不会潜水啊。",
            "nextDialogs": [
              "741140103"
            ]
          },
          "741140103": {
            "id": "741140103",
            "speakerId": 13491,
            "speakerName": "弈丰",
            "text": "我倒是会游泳，但潜水真的一窍不通啊。",
            "nextDialogs": [
              "741140104"
            ]
          },
          "741140104": {
            "id": "741140104",
            "speakerId": 13489,
            "speakerName": "邱老板",
            "text": "我们…上次去冒险家协会发布的委托，还挂在委托板上吗？",
            "nextDialogs": [
              "741140105"
            ]
          },
          "741140105": {
            "id": "741140105",
            "speakerId": 13491,
            "speakerName": "弈丰",
            "text": "老板，你上次不是说要我们赶紧去把那委托给撤了吗？",
            "nextDialogs": [
              "741140106"
            ]
          },
          "741140106": {
            "id": "741140106",
            "speakerId": 13490,
            "speakerName": "兴晔",
            "text": "我们昨天才把这件事给办了，协会那边说，今天就能把我们预付的委托费给退回来。",
            "nextDialogs": [
              "741140107"
            ]
          },
          "741140107": {
            "id": "741140107",
            "speakerId": 13489,
            "speakerName": "邱老板",
            "text": "呃…如果我们想重新发布委托，要交额外的手续费吗…",
            "nextDialogs": [
              "741140110"
            ]
          },
          "741140110": {
            "id": "741140110",
            "speakerId": 13489,
            "speakerName": "邱老板",
            "text": "#冒险家…{NICKNAME}，您真是我们的及时雨啊！",
            "nextDialogs": [
              "741140111"
            ]
          },
          "741140111": {
            "id": "741140111",
            "speakerId": 13489,
            "speakerName": "邱老板",
            "text": "您会潜水吗？或者说，您能帮忙找一位有空来帮忙的潜水员吗？",
            "nextDialogs": [
              "741140112"
            ]
          },
          "741140112": {
            "id": "741140112",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "你们要…到水下拍映影？",
            "nextDialogs": [
              "741140113"
            ]
          },
          "741140113": {
            "id": "741140113",
            "speakerId": 13491,
            "speakerName": "弈丰",
            "text": "我们可没那个本事，也买不起防水的映影设备。",
            "nextDialogs": [
              "741140114"
            ]
          },
          "741140114": {
            "id": "741140114",
            "speakerId": 13490,
            "speakerName": "兴晔",
            "text": "只是单纯因为，我们装映影画片的箱子掉进水里了。",
            "nextDialogs": [
              "741140115"
            ]
          },
          "741140115": {
            "id": "741140115",
            "speakerId": 13489,
            "speakerName": "邱老板",
            "text": "#好了，你们俩可少说两句吧！{NICKNAME}，请您务必帮帮忙啊。",
            "nextDialogs": [
              "741140116"
            ]
          },
          "741140116": {
            "id": "741140116",
            "speakerId": 13489,
            "speakerName": "邱老板",
            "text": "报酬的事您不用担心，和上次一样，当面给您结清。"
          }
        }
      }
    },
    {
      "subId": "7411403",
      "subQuestName": "取回装着「映影画片」的箱子",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "741140301"
        ],
        "dialogs": {
          "741140301": {
            "id": "741140301",
            "speakerId": 13489,
            "speakerName": "邱老板",
            "text": "#哎哟，还是您靠谱，{NICKNAME}。还是您靠谱！",
            "nextDialogs": [
              "741140302"
            ]
          },
          "741140302": {
            "id": "741140302",
            "speakerId": 13489,
            "speakerName": "邱老板",
            "text": "要是没您帮忙，这一整箱的映影画片全得泡汤。",
            "nextDialogs": [
              "741140303"
            ]
          },
          "741140303": {
            "id": "741140303",
            "speakerId": 13489,
            "speakerName": "邱老板",
            "text": "我们得先回城里，把这些映影画片交给热塞尔先生。",
            "nextDialogs": [
              "741140304"
            ]
          },
          "741140304": {
            "id": "741140304",
            "speakerId": 13489,
            "speakerName": "邱老板",
            "text": "#然后…再顺便吃顿饭。{NICKNAME}，如果您有兴趣的话，也请一起来吧。",
            "nextDialogs": [
              "741140305"
            ]
          },
          "741140305": {
            "id": "741140305",
            "speakerId": 13489,
            "speakerName": "邱老板",
            "text": "等吃完了饭，我再把报酬给您结清。",
            "nextDialogs": [
              "741140308"
            ]
          },
          "741140308": {
            "id": "741140308",
            "speakerId": 13489,
            "speakerName": "邱老板",
            "text": "行！那事情就这么定了。",
            "nextDialogs": [
              "741140309"
            ]
          },
          "741140309": {
            "id": "741140309",
            "speakerId": 13489,
            "speakerName": "邱老板",
            "text": "弈丰，等会你去把这箱子映影画片带去交给热塞尔先生。",
            "nextDialogs": [
              "741140310"
            ]
          },
          "741140310": {
            "id": "741140310",
            "speakerId": 13489,
            "speakerName": "邱老板",
            "text": "兴晔，你…去周围买点好菜。我最近研究了一下那道白淞鲜汤，今天正好给热塞尔先生露一手。",
            "nextDialogs": [
              "741140311"
            ]
          },
          "741140311": {
            "id": "741140311",
            "speakerId": 13490,
            "speakerName": "兴晔",
            "text": "老板，我们都去饭馆吃饭了。您为什么非得自己上手？",
            "nextDialogs": [
              "741140312"
            ]
          },
          "741140312": {
            "id": "741140312",
            "speakerId": 13489,
            "speakerName": "邱老板",
            "text": "这不是…便宜吗…",
            "nextDialogs": [
              "741140313"
            ]
          },
          "741140313": {
            "id": "741140313",
            "speakerId": 13489,
            "speakerName": "邱老板",
            "text": "咳！事情就这么定了，赶紧出发。",
            "nextDialogs": [
              "741140314"
            ]
          },
          "741140314": {
            "id": "741140314",
            "speakerId": 13489,
            "speakerName": "邱老板",
            "text": "#{NICKNAME}，您就跟着我走吧。"
          }
        }
      }
    },
    {
      "subId": "7411404",
      "subQuestName": "向邱老板一行人回报",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [],
        "dialogs": {}
      }
    },
    {
      "subId": "7411405",
      "subQuestName": "与邱老板对话",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "741140401"
        ],
        "dialogs": {
          "741140401": {
            "id": "741140401",
            "speakerId": 13489,
            "speakerName": "邱老板",
            "text": "这锅还真是奇特，唔…但用法应该和璃月的一样吧。",
            "nextDialogs": [
              "741140402"
            ]
          },
          "741140402": {
            "id": "741140402",
            "speakerId": 13490,
            "speakerName": "兴晔",
            "text": "老板，菜都买回来了，但那家店里的茉洁草都卖光了。",
            "nextDialogs": [
              "741140403"
            ]
          },
          "741140403": {
            "id": "741140403",
            "speakerId": 13490,
            "speakerName": "兴晔",
            "text": "我一时半会也找不到其他店卖这个…",
            "nextDialogs": [
              "741140404"
            ]
          },
          "741140404": {
            "id": "741140404",
            "speakerId": 13489,
            "speakerName": "邱老板",
            "text": "#这…就差这一份食材。那个，{NICKNAME}…",
            "nextDialogs": [
              "741140407"
            ]
          },
          "741140407": {
            "id": "741140407",
            "speakerId": 13489,
            "speakerName": "邱老板",
            "text": "多谢您帮忙。放心，我懂冒险家的规矩，绝不会让你白跑的。"
          }
        }
      }
    },
    {
      "subId": "7411406",
      "subQuestName": "将茉洁草交给邱老板",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "741140601"
        ],
        "dialogs": {
          "741140601": {
            "id": "741140601",
            "speakerId": 13489,
            "speakerName": "邱老板",
            "text": "#{NICKNAME}，向您介绍，这就是那位映影大师，热塞尔先生。",
            "nextDialogs": [
              "741140602"
            ]
          },
          "741140602": {
            "id": "741140602",
            "speakerId": 13489,
            "speakerName": "邱老板",
            "text": "#热塞尔先生，这是{NICKNAME}，一位身手高强的冒险家。",
            "nextDialogs": [
              "741140603"
            ]
          },
          "741140603": {
            "id": "741140603",
            "speakerId": 13489,
            "speakerName": "邱老板",
            "text": "#您要是以后准备拍武打类的映影，{NICKNAME}绝对能做一号演员！",
            "nextDialogs": [
              "741140604"
            ]
          },
          "741140604": {
            "id": "741140604",
            "speakerId": 13488,
            "speakerName": "热塞尔",
            "text": "呵呵，邱老板也说得太夸张了，我并不是什么映影大师。",
            "nextDialogs": [
              "741140605"
            ]
          },
          "741140605": {
            "id": "741140605",
            "speakerId": 13488,
            "speakerName": "热塞尔",
            "text": "我只不过是对映影中的光影运用方式略有研究罢了。",
            "nextDialogs": [
              "741140606"
            ]
          },
          "741140606": {
            "id": "741140606",
            "speakerId": 13489,
            "speakerName": "邱老板",
            "text": "哎呀，您太谦虚了。您那些映影里的光影，简直都能开口说话啦。",
            "nextDialogs": [
              "741140608",
              "741140610"
            ]
          },
          "741140608": {
            "id": "741140608",
            "speakerId": 13488,
            "speakerName": "热塞尔",
            "text": "是的。在我的映影理论中，光影的运用，即是情绪的运用。",
            "nextDialogs": [
              "741140611"
            ]
          },
          "741140611": {
            "id": "741140611",
            "speakerId": 13488,
            "speakerName": "热塞尔",
            "text": "但是…怎么说呢，现在枫丹的映影界里，我的这种理论暂时没有受到重视。",
            "nextDialogs": [
              "741140612"
            ]
          },
          "741140612": {
            "id": "741140612",
            "speakerId": 13488,
            "speakerName": "热塞尔",
            "text": "大部分导演还是更喜欢用直接的动作，或者场景来表达映影故事。",
            "nextDialogs": [
              "741140613"
            ]
          },
          "741140613": {
            "id": "741140613",
            "speakerId": 13488,
            "speakerName": "热塞尔",
            "text": "我拍摄了好几部用纯粹的光影变化叙事的映影，几乎没有人感兴趣。",
            "nextDialogs": [
              "741140614"
            ]
          },
          "741140614": {
            "id": "741140614",
            "speakerId": 13488,
            "speakerName": "热塞尔",
            "text": "但是现在，总算有一位导演认为我的光影理论有价值了。",
            "nextDialogs": [
              "741140615"
            ]
          },
          "741140615": {
            "id": "741140615",
            "speakerId": 13489,
            "speakerName": "邱老板",
            "text": "导演？我？哈哈哈，您别开玩笑了，我之前只是个卖茶叶的。",
            "nextDialogs": [
              "741140616"
            ]
          },
          "741140616": {
            "id": "741140616",
            "speakerId": 13488,
            "speakerName": "热塞尔",
            "text": "谁说卖茶叶的商人不能做导演？我之前还只是一位记者呢。",
            "nextDialogs": [
              "741140617"
            ]
          },
          "741140617": {
            "id": "741140617",
            "speakerId": 13489,
            "speakerName": "邱老板",
            "text": "记者…那您之前，肯定也很擅长写报道？就是报纸上的那种。",
            "nextDialogs": [
              "741140618"
            ]
          },
          "741140618": {
            "id": "741140618",
            "speakerId": 13488,
            "speakerName": "热塞尔",
            "text": "算是吧。怎么了？",
            "nextDialogs": [
              "741140619"
            ]
          },
          "741140619": {
            "id": "741140619",
            "speakerId": 13489,
            "speakerName": "邱老板",
            "text": "嗯…那正好…",
            "nextDialogs": [
              "741140620"
            ]
          },
          "741140620": {
            "id": "741140620",
            "speakerId": 13489,
            "speakerName": "邱老板",
            "text": "啊！没什么！没什么！咱们之后合作的时间还多的是啊，哈哈哈！",
            "nextDialogs": [
              "741140621"
            ]
          },
          "741140621": {
            "id": "741140621",
            "speakerId": 1004,
            "speakerName": "Black Screen",
            "text": "在邱老板爽朗的笑声中，大家都入了座。",
            "nextDialogs": [
              "741140622"
            ]
          },
          "741140622": {
            "id": "741140622",
            "speakerId": 1004,
            "speakerName": "Black Screen",
            "text": "吃完饭后，邱老板又额外做了一份食物，打包完后，塞进了你的包里…"
          },
          "741140610": {
            "id": "741140610",
            "speakerId": 13488,
            "speakerName": "热塞尔",
            "text": "当然了。在我的映影理论中，光影是表达画面情绪的重要方式。"
          }
        }
      }
    },
    {
      "subId": "7411408",
      "subQuestName": "与邱老板对话",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "741140701"
        ],
        "dialogs": {
          "741140701": {
            "id": "741140701",
            "speakerId": 13489,
            "speakerName": "邱老板",
            "text": "好，我这就开始做菜。必须得快点，热塞尔先生也快到了…"
          }
        }
      }
    },

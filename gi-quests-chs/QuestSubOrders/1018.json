{
  "lineCounts": {
    "Player": 4,
    "「公子」": 26,
    "派蒙": 6
  },
  "subQuests": [
    {
      "subId": "101801",
      "subQuestName": "回璃月寻找「公子」",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "10031801"
        ],
        "dialogs": {
          "10031801": {
            "id": "10031801",
            "speakerId": 10200,
            "speakerName": "「公子」",
            "text": "你们终于回来了，绝云间之行成果如何？",
            "nextDialogs": [
              "10031802"
            ]
          },
          "10031802": {
            "id": "10031802",
            "speakerId": 10200,
            "speakerName": "「公子」",
            "text": "…原来如此。"
          }
        }
      }
    },
    {
      "subId": "100318",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "10031803"
        ],
        "dialogs": {
          "10031803": {
            "id": "10031803",
            "speakerId": 10200,
            "speakerName": "「公子」",
            "text": "削月筑阳真君、理水叠山真君、留云借风真君、降魔大圣…",
            "nextDialogs": [
              "10031804"
            ]
          },
          "10031804": {
            "id": "10031804",
            "speakerId": 10200,
            "speakerName": "「公子」",
            "text": "嗯，这其中有些名号，在「愚人众」掌握的情报里都没出现过呢。",
            "nextDialogs": [
              "10031805"
            ]
          },
          "10031805": {
            "id": "10031805",
            "speakerId": 10200,
            "speakerName": "「公子」",
            "text": "作为回礼，我也有情报提供给你。",
            "nextDialogs": [
              "10031809"
            ]
          },
          "10031809": {
            "id": "10031809",
            "speakerId": 10200,
            "speakerName": "「公子」",
            "text": "对于神祇之死，璃月七星的反应，十分耐人寻味…",
            "nextDialogs": [
              "10031810"
            ]
          },
          "10031810": {
            "id": "10031810",
            "speakerId": 10200,
            "speakerName": "「公子」",
            "text": "他们对外宣称，由于尚未寻获真凶，不允许任何人瞻仰「仙祖法蜕」。",
            "nextDialogs": [
              "10031811"
            ]
          },
          "10031811": {
            "id": "10031811",
            "speakerId": 10200,
            "speakerName": "「公子」",
            "text": "甚至还试图封锁消息…但毕竟请仙典仪人来人往，即使七星也难以禁绝流言。",
            "nextDialogs": [
              "10031812"
            ]
          },
          "10031812": {
            "id": "10031812",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "仙祖法蜕？",
            "nextDialogs": [
              "10031813"
            ]
          },
          "10031813": {
            "id": "10031813",
            "speakerId": 10200,
            "speakerName": "「公子」",
            "text": "以璃月的常识而言，岩王帝君也是一位仙人嘛。",
            "nextDialogs": [
              "10031814"
            ]
          },
          "10031814": {
            "id": "10031814",
            "speakerId": 10200,
            "speakerName": "「公子」",
            "text": "岩神是契约之神，同时也被称作众仙之祖。",
            "nextDialogs": [
              "10031815"
            ]
          },
          "10031815": {
            "id": "10031815",
            "speakerId": 10200,
            "speakerName": "「公子」",
            "text": "如今的所有「三眼五显仙人」，当年都曾立下守望璃月的契约。",
            "nextDialogs": [
              "10031816"
            ]
          },
          "10031816": {
            "id": "10031816",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "这样啊…难怪他们对璃月的事这么上心。",
            "nextDialogs": [
              "10031817"
            ]
          },
          "10031817": {
            "id": "10031817",
            "speakerId": 10200,
            "speakerName": "「公子」",
            "text": "没错，他们既有责任，也有资格。",
            "nextDialogs": [
              "10031818"
            ]
          },
          "10031818": {
            "id": "10031818",
            "speakerId": 10200,
            "speakerName": "「公子」",
            "text": "——如果掌管璃月的七星出了问题，他们就有兴师问罪的资格。",
            "nextDialogs": [
              "10031819"
            ]
          },
          "10031819": {
            "id": "10031819",
            "speakerId": 10200,
            "speakerName": "「公子」",
            "text": "岩神灵魂升入高天，留下的躯壳，为何会被七星藏匿？实在可疑…",
            "nextDialogs": [
              "10031822"
            ]
          },
          "10031822": {
            "id": "10031822",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "啊！没错，我们本来就是来找那位神灵的！",
            "nextDialogs": [
              "10031823"
            ]
          },
          "10031823": {
            "id": "10031823",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "如果璃月七星把「仙祖法蜕」藏起来、不让人接近的话…",
            "nextDialogs": [
              "10031824"
            ]
          },
          "10031824": {
            "id": "10031824",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "#{NICKNAME}想要寻访全部七神的目标，就会完全落空了！",
            "nextDialogs": [
              "10031825"
            ]
          },
          "10031825": {
            "id": "10031825",
            "speakerId": 10200,
            "speakerName": "「公子」",
            "text": "喔？你们正在寻访七神？是为了什么呢？"
          },
          "10031806": {
            "id": "10031806",
            "speakerId": 10200,
            "speakerName": "「公子」",
            "text": "并没有见到所有仙人…按他们的话说就是「无缘得见」，对吧？",
            "nextDialogs": [
              "10031807"
            ]
          },
          "10031807": {
            "id": "10031807",
            "speakerId": 10200,
            "speakerName": "「公子」",
            "text": "没关系！最近如果有空的话，再去碰碰运气也无妨。",
            "nextDialogs": [
              "10031808"
            ]
          },
          "10031808": {
            "id": "10031808",
            "speakerId": 10200,
            "speakerName": "「公子」",
            "text": "而且，降魔大圣的情报已经很珍贵了。作为回礼，我也有情报提供给你。"
          }
        }
      }
    }
  ]
}
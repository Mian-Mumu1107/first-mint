{
  "lineCounts": {
    "Player": 6,
    "列斯诺娃": 5,
    "塔拉利欣": 18,
    "派蒙": 6
  },
  "subQuests": [
    {
      "subId": "7767401",
      "subQuestName": "与塔拉利欣对话",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "776740101"
        ],
        "dialogs": {
          "776740101": {
            "id": "776740101",
            "speakerId": 17015,
            "speakerName": "塔拉利欣",
            "text": "失败了？",
            "nextDialogs": [
              "776740102"
            ]
          },
          "776740102": {
            "id": "776740102",
            "speakerId": 7540,
            "speakerName": "列斯诺娃",
            "text": "又失败了…",
            "nextDialogs": [
              "776740103"
            ]
          },
          "776740103": {
            "id": "776740103",
            "speakerId": 7540,
            "speakerName": "列斯诺娃",
            "text": "你的数据绝对设计得有问题，就算把特殊任务营的那群战斗专家找过来，也没人能打通！",
            "nextDialogs": [
              "776740104"
            ]
          },
          "776740104": {
            "id": "776740104",
            "speakerId": 17015,
            "speakerName": "塔拉利欣",
            "text": "那就加强练习，仔细反思。模拟训练又不止射击，建造防御工事也很重要。",
            "nextDialogs": [
              "776740105"
            ]
          },
          "776740105": {
            "id": "776740105",
            "speakerId": 7540,
            "speakerName": "列斯诺娃",
            "text": "可你自己演示的时候，不也失误一次就全场崩盘了？",
            "nextDialogs": [
              "776740106"
            ]
          },
          "776740106": {
            "id": "776740106",
            "speakerId": 17015,
            "speakerName": "塔拉利欣",
            "text": "对啊，这才是「影域」该有的危险程度。",
            "nextDialogs": [
              "776740107"
            ]
          },
          "776740107": {
            "id": "776740107",
            "speakerId": 17015,
            "speakerName": "塔拉利欣",
            "text": "只要稍微简单一点，普通射手都会产生幻觉——「我有机会在影域里生存下来」。",
            "nextDialogs": [
              "776740108"
            ]
          },
          "776740108": {
            "id": "776740108",
            "speakerId": 17015,
            "speakerName": "塔拉利欣",
            "text": "不用最严苛的标准去训练，怎么能在严酷的环境中做到万无一失呢？",
            "nextDialogs": [
              "776740109"
            ]
          },
          "776740109": {
            "id": "776740109",
            "speakerId": 7540,
            "speakerName": "列斯诺娃",
            "text": "行…说得也有道理。",
            "nextDialogs": [
              "776740110"
            ]
          },
          "776740110": {
            "id": "776740110",
            "speakerId": 7540,
            "speakerName": "列斯诺娃",
            "text": "我再回去琢磨琢磨，我就不信了，一局都打不过？",
            "nextDialogs": [
              "776740111"
            ]
          },
          "776740111": {
            "id": "776740111",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "垂头丧气地走掉了啊…",
            "nextDialogs": [
              "776740112"
            ]
          },
          "776740112": {
            "id": "776740112",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "听起来，她好像被你设计的这种桌上游戏打得晕头转向？",
            "nextDialogs": [
              "776740115"
            ]
          },
          "776740115": {
            "id": "776740115",
            "speakerId": 17015,
            "speakerName": "塔拉利欣",
            "text": "游戏？对你们来说可能确实是轻松愉快的消遣。但「影域战况想定」的主题，就足以让知情人感到紧张了。",
            "nextDialogs": [
              "776740116"
            ]
          },
          "776740116": {
            "id": "776740116",
            "speakerId": 17015,
            "speakerName": "塔拉利欣",
            "text": "我制作它的本意，是从思维策略的层面进行模拟训练。",
            "nextDialogs": [
              "776740117"
            ]
          },
          "776740117": {
            "id": "776740117",
            "speakerId": 17015,
            "speakerName": "塔拉利欣",
            "text": "对于至冬的冒险家、猎人和战士而言，「影域」始终是隐藏在风雪深处的伤人利剑。",
            "nextDialogs": [
              "776740118"
            ]
          },
          "776740118": {
            "id": "776740118",
            "speakerId": 17015,
            "speakerName": "塔拉利欣",
            "text": "谁也不知道里面具体的情况，只能将零零碎碎的情报拼凑起来，去揣测内部有多凶险。",
            "nextDialogs": [
              "776740119"
            ]
          },
          "776740119": {
            "id": "776740119",
            "speakerId": 17015,
            "speakerName": "塔拉利欣",
            "text": "然后设想出一个战斗草案，以此磨练自己的本领。万一哪天不走运，真的掉进那种鬼地方了，至少有点存活的希望。",
            "nextDialogs": [
              "776740120"
            ]
          },
          "776740120": {
            "id": "776740120",
            "speakerId": 17015,
            "speakerName": "塔拉利欣",
            "text": "只不过，现在就连我都只能勉强在最佳状态下撑过几个回合，更别说他们了…",
            "nextDialogs": [
              "776740121"
            ]
          },
          "776740121": {
            "id": "776740121",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "呜…听起来比想象中严肃很多。",
            "nextDialogs": [
              "776740122"
            ]
          },
          "776740122": {
            "id": "776740122",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "#这方面，{NICKNAME}倒是经验丰富，应该能在至冬排得上前列？",
            "nextDialogs": [
              "776740123"
            ]
          },
          "776740123": {
            "id": "776740123",
            "speakerId": 17015,
            "speakerName": "塔拉利欣",
            "text": "…确实…但…"
          }
        }
      }
    }
  ]
}
    {
      "subId": "501308",
      "subQuestName": "与伙伴共享战场情报",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "50130801"
        ],
        "dialogs": {
          "50130801": {
            "id": "50130801",
            "speakerId": 1095,
            "speakerName": "希诺宁",
            "text": "回声之子这里的魔物已经被清理干净了。",
            "nextDialogs": [
              "50130802"
            ]
          },
          "50130802": {
            "id": "50130802",
            "speakerId": 1086,
            "speakerName": "卡齐娜",
            "text": "我去干掉了深渊瘤石！",
            "nextDialogs": [
              "50130803"
            ]
          },
          "50130803": {
            "id": "50130803",
            "speakerId": 1087,
            "speakerName": "玛拉妮",
            "text": "流泉之众也搞定了，一炮了事！",
            "nextDialogs": [
              "50130804"
            ]
          },
          "50130804": {
            "id": "50130804",
            "speakerId": 1096,
            "speakerName": "茜特菈莉",
            "text": "烟谜主的危险也解除了，需要去花羽会帮忙吗？",
            "nextDialogs": [
              "50130805"
            ]
          },
          "50130805": {
            "id": "50130805",
            "speakerId": 1094,
            "speakerName": "欧洛伦",
            "text": "那边的情况好像挺严重的，我已经在路上了。",
            "nextDialogs": [
              "50130806"
            ]
          },
          "50130806": {
            "id": "50130806",
            "speakerId": 1092,
            "speakerName": "恰斯卡",
            "text": "用不着，已经处理完了。",
            "nextDialogs": [
              "50130807"
            ]
          },
          "50130807": {
            "id": "50130807",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "这么快？！你刚刚还在竞技场啊！",
            "nextDialogs": [
              "50130808"
            ]
          },
          "50130808": {
            "id": "50130808",
            "speakerId": 1092,
            "speakerName": "恰斯卡",
            "text": "想找人揍一顿，你知道我忍了多久？",
            "nextDialogs": [
              "50130809"
            ]
          },
          "50130809": {
            "id": "50130809",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "好、好吧…",
            "nextDialogs": [
              "50130810"
            ]
          },
          "50130810": {
            "id": "50130810",
            "speakerId": 1087,
            "speakerName": "玛拉妮",
            "text": "伊安珊，沃陆之邦怎么办，你家离竞技场可远了。",
            "nextDialogs": [
              "50130811"
            ]
          },
          "50130811": {
            "id": "50130811",
            "speakerId": 1091,
            "speakerName": "伊安珊",
            "text": "哦，这个不用担心，刚刚瓦雷莎和我通信了，那边也解决了。",
            "nextDialogs": [
              "50130812"
            ]
          },
          "50130812": {
            "id": "50130812",
            "speakerId": 1088,
            "speakerName": "基尼奇",
            "text": "看来全都没事了呢，深渊似乎也示弱了。",
            "nextDialogs": [
              "50130813"
            ]
          },
          "50130813": {
            "id": "50130813",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "对啊，这家伙就知道用数量优势，和还魂诗比比，看看谁人更多吧！",
            "nextDialogs": [
              "50130814"
            ]
          },
          "50130814": {
            "id": "50130814",
            "speakerId": 1088,
            "speakerName": "基尼奇",
            "text": "等等，深渊好像集结了一批魔物，往竞技场的方向冲了。",
            "nextDialogs": [
              "50130815"
            ]
          },
          "50130815": {
            "id": "50130815",
            "speakerId": 1088,
            "speakerName": "基尼奇",
            "text": "看来它也意识到，还魂诗是最大的麻烦，想要去破坏圣火。",
            "nextDialogs": [
              "50130816"
            ]
          },
          "50130816": {
            "id": "50130816",
            "speakerId": 1087,
            "speakerName": "玛拉妮",
            "text": "怎么可能让它得逞，朋友们，竞技场集合！",
            "nextDialogs": [
              "50130817"
            ]
          },
          "50130817": {
            "id": "50130817",
            "speakerId": 1095,
            "speakerName": "希诺宁",
            "text": "我看到有新的深渊瘤石砸下来，都在竞技场附近，我们还是分头去击破吧。",
            "nextDialogs": [
              "50130818"
            ]
          },
          "50130818": {
            "id": "50130818",
            "speakerId": 1095,
            "speakerName": "希诺宁",
            "text": "对了，还需要有人去守住大门。",
            "nextDialogs": [
              "50130819"
            ]
          },
          "50130819": {
            "id": "50130819",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "交给我吧。",
            "nextDialogs": [
              "50130820"
            ]
          },
          "50130820": {
            "id": "50130820",
            "speakerId": 1087,
            "speakerName": "玛拉妮",
            "text": "好的，这就是最后的战斗了！"
          }
        }
      }
    },

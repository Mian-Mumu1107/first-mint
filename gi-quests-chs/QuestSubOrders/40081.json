      }
    },
    {
      "subId": "4008114",
      "subQuestName": "选择蕈兽的名字",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "400811501"
        ],
        "dialogs": {
          "400811501": {
            "id": "400811501",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "嘿嘿，这些名字都很不错吧？在赛场上大声喊出来的时候，肯定很威风！",
            "nextDialogs": [
              "400811504"
            ]
          },
          "400811504": {
            "id": "400811504",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "这种蕈兽头顶圆圆的帽子很像一个小小的鼓吧！我早就这么觉得了，敲它的脑袋时，肯定会发出咚咚锵锵的声音！"
          }
        }
      }
    },
    {
      "subId": "4008107",
      "subQuestName": "前往下个捕捉区域",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [],
        "dialogs": {}
      }
    },
    {
      "subId": "4008108",
      "subQuestName": "捕捉蕈兽",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [],
        "dialogs": {}
      }
    },
    {
      "subId": "4008110",
      "subQuestName": "帮助偶遇的少女",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "400811001"
        ],
        "dialogs": {
          "400811001": {
            "id": "400811001",
            "speakerId": 1004,
            "speakerName": "海妮耶",
            "text": "很好，四只蕈兽集齐了，下一步是用主办方提供的「花花琼脂」激发蕈兽们的能力，以便在比赛中使出强力的招式…",
            "nextDialogs": [
              "400811002"
            ]
          },
          "400811002": {
            "id": "400811002",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "进展比想象中要快得多呢！谢谢你啦，海妮耶！我们现在就回赛场吧…",
            "nextDialogs": [
              "400811003"
            ]
          },
          "400811003": {
            "id": "400811003",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "欸？你们快看，那边有个人在晃荡，身边还有个蕈兽围着她打转…难道是被攻击了？",
            "nextDialogs": [
              "400811004"
            ]
          },
          "400811004": {
            "id": "400811004",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "她突然倒地了！我们快过去看看吧！",
            "nextDialogs": [
              "400811005"
            ]
          },
          "400811005": {
            "id": "400811005",
            "speakerId": 1003,
            "speakerName": "？？？",
            "text": "呃…实在没有力气了，一步都挪不动…",
            "nextDialogs": [
              "400811006"
            ]
          },
          "400811006": {
            "id": "400811006",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "你受伤了吗？要不要紧？",
            "nextDialogs": [
              "400811007"
            ]
          },
          "400811007": {
            "id": "400811007",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "危险！",
            "nextDialogs": [
              "400811008"
            ]
          },
          "400811008": {
            "id": "400811008",
            "speakerId": 1004,
            "speakerName": "海妮耶",
            "text": "拿下它，「火一」。",
            "nextDialogs": [
              "400811009"
            ]
          },
          "400811009": {
            "id": "400811009",
            "speakerId": 1003,
            "speakerName": "？？？",
            "text": "等等！它不是敌人，是我的伙伴！",
            "nextDialogs": [
              "400811010"
            ]
          },
          "400811010": {
            "id": "400811010",
            "speakerId": 1003,
            "speakerName": "？？？",
            "text": "我只是有点累，走不动了而已…还要找到余下三个蘑菇伙伴，才能获得参赛的资格…",
            "nextDialogs": [
              "400811011"
            ]
          },
          "400811011": {
            "id": "400811011",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "蘑菇伙伴？",
            "nextDialogs": [
              "400811012"
            ]
          },
          "400811012": {
            "id": "400811012",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "莫非你也是参赛选手？",
            "nextDialogs": [
              "400811013"
            ]
          },
          "400811013": {
            "id": "400811013",
            "speakerId": 1003,
            "speakerName": "？？？",
            "text": "我也没想到会在这里碰见竞争对手…也许真的到此为止了，只凭「转转悠悠兽」也对付不了你们…",
            "nextDialogs": [
              "400811014"
            ]
          },
          "400811014": {
            "id": "400811014",
            "speakerId": 1003,
            "speakerName": "？？？",
            "text": "「转转悠悠兽」就拜托你们了，你们要带着它拿到好名次啊！",
            "nextDialogs": [
              "400811015"
            ]
          },
          "400811015": {
            "id": "400811015",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "不要自暴自弃啦！我们又不是拦路的镀金旅团，不会抢走你的蕈兽…蘑菇伙伴的，我们才没有那么卑鄙！",
            "nextDialogs": [
              "400811016"
            ]
          },
          "400811016": {
            "id": "400811016",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "就算你要和我们分个高下，也要等到上了赛场，堂堂正正地比试！",
            "nextDialogs": [
              "400811017"
            ]
          },
          "400811017": {
            "id": "400811017",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "就像我们身边这位驯兽师，海妮耶，她明知道我们可能成为强劲的对手，还是给了我们好多指导！",
            "nextDialogs": [
              "400811018"
            ]
          },
          "400811018": {
            "id": "400811018",
            "speakerId": 1004,
            "speakerName": "海妮耶",
            "text": "…这是在夸我吗？",
            "nextDialogs": [
              "400811021"
            ]
          },
          "400811021": {
            "id": "400811021",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "#报上你的名号和目标来吧，「黄金流星」{NICKNAME}和我「白银伴星」派蒙可以帮你哦！",
            "nextDialogs": [
              "400811022"
            ]
          },
          "400811022": {
            "id": "400811022",
            "speakerId": 1003,
            "speakerName": "？？？",
            "text": "真，真的吗？帮我集齐四个蘑菇伙伴？厄运突然倒转，变成好运了？",
            "nextDialogs": [
              "400811023"
            ]
          },
          "400811023": {
            "id": "400811023",
            "speakerId": 1005,
            "speakerName": "莱依拉",
            "text": "我…我叫莱依拉，是梨多梵谛学院的普通学员，没什么厉害的名号…我的目标是…打进这场比赛的八强赛。",
            "nextDialogs": [
              "400811024"
            ]
          },
          "400811024": {
            "id": "400811024",
            "speakerId": 1005,
            "speakerName": "莱依拉",
            "text": "要是能进入八强，我就可以把蘑菇伙伴带回家，让它们为我分担一些体力活了。当然，我会好好照顾它们的。",
            "nextDialogs": [
              "400811025"
            ]
          },
          "400811025": {
            "id": "400811025",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "唔，规则上好像确实有说过，所有进入八强赛的选手都能把想要的蕈兽带回家来着…",
            "nextDialogs": [
              "400811026"
            ]
          },
          "400811026": {
            "id": "400811026",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "不过，体力活？学员的日常不就是课业和论文么？",
            "nextDialogs": [
              "400811027"
            ]
          },
          "400811027": {
            "id": "400811027",
            "speakerId": 1005,
            "speakerName": "莱依拉",
            "text": "说出来有点难为情…我好像天生就有睡眠障碍，每天都休息不好，体力也很差。",
            "nextDialogs": [
              "400811028"
            ]
          },
          "400811028": {
            "id": "400811028",
            "speakerId": 1005,
            "speakerName": "莱依拉",
            "text": "平常我随便运动一下…就会像刚才那样累到虚脱，我说的体力活只不过是搬搬书，出门买点东西…",
            "nextDialogs": [
              "400811029"
            ]
          },
          "400811029": {
            "id": "400811029",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "#只是这点事吗？那就没什么啦！我也总是把杂活扔给{NICKNAME}！",
            "nextDialogs": [
              "400811030"
            ]
          },
          "400811030": {
            "id": "400811030",
            "speakerId": 1004,
            "speakerName": "海妮耶",
            "text": "不止把蕈兽当成伙伴，还想和它们一起生活…这种荒谬的想法…和埃尔欣根完全一样。",
            "nextDialogs": [
              "400811031"
            ]
          },
          "400811031": {
            "id": "400811031",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "（海妮耶的脸色不太好看？）",
            "nextDialogs": [
              "400811032"
            ]
          },
          "400811032": {
            "id": "400811032",
            "speakerId": 1004,
            "speakerName": "海妮耶",
            "text": "你们很快就理解了窍门，还有余力帮助别人，我为你们感到高兴。",
            "nextDialogs": [
              "400811033"
            ]
          },
          "400811033": {
            "id": "400811033",
            "speakerId": 1004,
            "speakerName": "海妮耶",
            "text": "祝你们一切顺利，我先失陪了。",
            "nextDialogs": [
              "400811034"
            ]
          },
          "400811034": {
            "id": "400811034",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "咦？海妮耶怎么突然就要走了？",
            "nextDialogs": [
              "400811035"
            ]
          },
          "400811035": {
            "id": "400811035",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "海妮耶，我们还没感谢你和「火一」呢！至少一起去吃好吃的…",
            "nextDialogs": [
              "400811036"
            ]
          },
          "400811036": {
            "id": "400811036",
            "speakerId": 1005,
            "speakerName": "莱依拉",
            "text": "没关系吗？怎么感觉那位驯兽师…好像生气了？",
            "nextDialogs": [
              "400811037"
            ]
          },
          "400811037": {
            "id": "400811037",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "唔…应该不会吧？海妮耶说话的方式很直接，确实给人一种不好亲近的感觉，不过，她的性格肯定不坏！否则怎么会帮我们呢？"
          }
        }
      }
    },
    {
      "subId": "4008111",
      "subQuestName": "返回「月莲杯」赛场",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [],
        "dialogs": {}
      }
    },
    {
      "subId": "4008112",
      "subQuestName": "与八重神子对话",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "400811201"
        ],
        "dialogs": {
          "400811201": {
            "id": "400811201",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "我看看我看看，预赛的安排…太好了！我们和莱依拉不在同一个小组里。这样就不至于早早对决了！",
            "nextDialogs": [
              "400811202"
            ]
          },
          "400811202": {
            "id": "400811202",
            "speakerId": 1005,
            "speakerName": "莱依拉",
            "text": "其实我希望…最后也不用和你们对抗啦…",
            "nextDialogs": [
              "400811203"
            ]
          },
          "400811203": {
            "id": "400811203",
            "speakerId": 1006,
            "speakerName": "八重神子",
            "text": "啊呀？这不是小家伙们吗？",
            "nextDialogs": [
              "400811204"
            ]
          },
          "400811204": {
            "id": "400811204",
            "speakerId": 1006,
            "speakerName": "八重神子",
            "text": "果然，你们又一次出现在了热点的前沿，还真是轻小说主角般的人物呢。",
            "nextDialogs": [
              "400811205"
            ]
          },
          "400811205": {
            "id": "400811205",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "神、神神神神子？我是不是眼花了？你为什么会在这里！",
            "nextDialogs": [
              "400811206"
            ]
          },
          "400811206": {
            "id": "400811206",
            "speakerId": 1006,
            "speakerName": "八重神子",
            "text": "呵呵，这场比赛的广告都打到稻妻来了呢，还特意在八重堂门口发了传单。",
            "nextDialogs": [
              "400811207"
            ]
          },
          "400811207": {
            "id": "400811207",
            "speakerId": 1006,
            "speakerName": "八重神子",
            "text": "你们不觉得，这样的比赛和轻小说是绝配吗？",
            "nextDialogs": [
              "400811210"
            ]
          },
          "400811210": {
            "id": "400811210",
            "speakerId": 1006,
            "speakerName": "八重神子",
            "text": "八重堂正在筹划「风靡下个五十年的杰作」，主题也是「伙伴和竞技」，所以我们就带上新锐作者左右加到现场来取材了。",
            "nextDialogs": [
              "400811211"
            ]
          },
          "400811211": {
            "id": "400811211",
            "speakerId": 1006,
            "speakerName": "八重神子",
            "text": "当然，为了更好地对作者们的稿子把关，我也会参加比赛，稍微体验一下身为选手的感觉。",
            "nextDialogs": [
              "400811212"
            ]
          },
          "400811212": {
            "id": "400811212",
            "speakerId": 1006,
            "speakerName": "八重神子",
            "text": "这位就是我的搭档，左右加为它起了个名字——「百雷遮罗」，我觉得还不错，有股独特的气势。",
            "nextDialogs": [
              "400811213"
            ]
          },
          "400811213": {
            "id": "400811213",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "没想到这次的阵仗这么大，连神子都被吸引过来了…",
            "nextDialogs": [
              "400811214"
            ]
          },
          "400811214": {
            "id": "400811214",
            "speakerId": 1006,
            "speakerName": "八重神子",
            "text": "#左右加，来认识一下小家伙们吧，{M#他们}{F#她们}一定会成为你最强的对手，可以把{M#他们}{F#她们}写成小说中举足轻重的角色哦。",
            "nextDialogs": [
              "400811215"
            ]
          },
          "400811215": {
            "id": "400811215",
            "speakerId": 1007,
            "speakerName": "左右加",
            "text": "是是是是是，主编大人！",
            "nextDialogs": [
              "400811216"
            ]
          },
          "400811216": {
            "id": "400811216",
            "speakerId": 1007,
            "speakerName": "左右加",
            "text": "为为为了写出深入人心的作品，我绝绝绝不会退缩，一定会会会击败你们的！",
            "nextDialogs": [
              "400811217"
            ]
          },
          "400811217": {
            "id": "400811217",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "那就在赛场上一决胜负吧！",
            "nextDialogs": [
              "400811218"
            ]
          },
          "400811218": {
            "id": "400811218",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "对…就算你是神子的心腹，我们也不会手下留情哦…",
            "nextDialogs": [
              "400811219"
            ]
          },
          "400811219": {
            "id": "400811219",
            "speakerId": 1006,
            "speakerName": "八重神子",
            "text": "就是这种气势！你找到那种感觉了吗，左右加？在比赛之前向最有分量的对手下战书，可是渲染气氛的关键桥段！",
            "nextDialogs": [
              "400811220"
            ]
          },
          "400811220": {
            "id": "400811220",
            "speakerId": 1007,
            "speakerName": "左右加",
            "text": "完完完全没感觉到！想到到到要和「陪伴将军视察花见坂的密友」对抗，我就超超超紧张…",
            "nextDialogs": [
              "400811221"
            ]
          },
          "400811221": {
            "id": "400811221",
            "speakerId": 1006,
            "speakerName": "八重神子",
            "text": "那你就先回旅馆吧，抓紧时间，把现在这种紧张的心情记录下来，这也是很好的素材哦。",
            "nextDialogs": [
              "400811222"
            ]
          },
          "400811222": {
            "id": "400811222",
            "speakerId": 1005,
            "speakerName": "莱依拉",
            "text": "这个人…好可怕…但好像很厉害，好想试着和她交个朋友…",
            "nextDialogs": [
              "400811223"
            ]
          },
          "400811223": {
            "id": "400811223",
            "speakerId": 1006,
            "speakerName": "八重神子",
            "text": "这位恬静的朋友是？",
            "nextDialogs": [
              "400811224"
            ]
          },
          "400811224": {
            "id": "400811224",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "她是我们在捕捉蕈兽时遇上的新同伴，莱依拉。",
            "nextDialogs": [
              "400811225"
            ]
          },
          "400811225": {
            "id": "400811225",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "莱依拉想把训练有素的蕈兽带回家里，和它们一起生活，所以才参加了这场比赛，她的目标是打进八强赛！",
            "nextDialogs": [
              "400811226"
            ]
          },
          "400811226": {
            "id": "400811226",
            "speakerId": 1006,
            "speakerName": "八重神子",
            "text": "训练蕈兽，作为生活中的伙伴？",
            "nextDialogs": [
              "400811227"
            ]
          },
          "400811227": {
            "id": "400811227",
            "speakerId": 1006,
            "speakerName": "八重神子",
            "text": "真有意思…你的身上似乎蕴藏着不少秘密，肯定能发掘出很有灵气的故事。",
            "nextDialogs": [
              "400811228"
            ]
          },
          "400811228": {
            "id": "400811228",
            "speakerId": 1006,
            "speakerName": "八重神子",
            "text": "我叫八重神子，一个兴趣使然的轻小说编辑。现在，对你就挺感兴趣的…还请多多关照哦。",
            "nextDialogs": [
              "400811229"
            ]
          },
          "400811229": {
            "id": "400811229",
            "speakerId": 1005,
            "speakerName": "莱依拉",
            "text": "呜…完全不知道该怎么回应…",
            "nextDialogs": [
              "400811230"
            ]
          },
          "400811230": {
            "id": "400811230",
            "speakerId": 1005,
            "speakerName": "莱依拉",
            "text": "两位！之前太感谢你们了！",
            "nextDialogs": [
              "400811231"
            ]
          },
          "400811231": {
            "id": "400811231",
            "speakerId": 1005,
            "speakerName": "莱依拉",
            "text": "我想好好了解四位蘑菇伙伴，为预赛做好准备…就先去训练了！",
            "nextDialogs": [
              "400811232"
            ]
          },
          "400811232": {
            "id": "400811232",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "注意体能啊，莱依拉，可别像上次一样累倒哦！",
            "nextDialogs": [
              "400811233"
            ]
          },
          "400811233": {
            "id": "400811233",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "感觉你的气势吓到她了啦，神子…",
            "nextDialogs": [
              "400811234"
            ]
          },
          "400811234": {
            "id": "400811234",
            "speakerId": 1006,
            "speakerName": "八重神子",
            "text": "哦？我有这么可怕吗？那我可得和她再多做一些交流，化解误会呐…",
            "nextDialogs": [
              "400811235"
            ]
          },
          "400811235": {
            "id": "400811235",
            "speakerId": 1006,
            "speakerName": "八重神子",
            "text": "不过，看你的眼神，似乎还有什么事想和我说呢，小家伙？"
          }
        }
      }
    },
    {
      "subId": "4008113",
      "subQuestName": "前往「花花琼脂」摊位",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "400811301"
        ],
        "dialogs": {
          "400811301": {
            "id": "400811301",
            "speakerId": 1008,
            "speakerName": "贝尔福",
            "text": "终于来了，夺冠大热门！赶快用「花花琼脂」激活蕈兽的潜能吧！",
            "nextDialogs": [
              "400811302"
            ]
          },
          "400811302": {
            "id": "400811302",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "夺冠大热门？我喜欢这个评价！你也听说过我们吗？",
            "nextDialogs": [
              "400811303"
            ]
          },
          "400811303": {
            "id": "400811303",
            "speakerId": 1008,
            "speakerName": "贝尔福",
            "text": "当然了，你们领取「意智宝珠」的时候，我就在旁边。海妮耶小姐为你们说明了情况，我根本插不上话…",
            "nextDialogs": [
              "400811304"
            ]
          },
          "400811304": {
            "id": "400811304",
            "speakerId": 1008,
            "speakerName": "贝尔福",
            "text": "有海妮耶小姐这样的专家指点，你们肯定也能成为耀眼的驯兽师新星！",
            "nextDialogs": [
              "400811305"
            ]
          },
          "400811305": {
            "id": "400811305",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "听起来，海妮耶好像很强？连主办方的工作人员都这么夸她…那我们更要加油了！"
          }
        }
      }
    },

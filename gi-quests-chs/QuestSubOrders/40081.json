    {
      "subId": "4008162",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "400816201"
        ],
        "dialogs": {
          "400816201": {
            "id": "400816201",
            "speakerId": 1008,
            "speakerName": "贝尔福",
            "text": "两位，你们要培养蕈兽吗？还是有什么疑问需要我为你们解答？"
          }
        }
      }
    },
    {
      "subId": "4008163",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "400816301"
        ],
        "dialogs": {
          "400816301": {
            "id": "400816301",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "我们想培养蕈兽。",
            "nextDialogs": [
              "400816302"
            ]
          },
          "400816302": {
            "id": "400816302",
            "speakerId": 1008,
            "speakerName": "贝尔福",
            "text": "好的，请按配方指南使用「花花琼脂」。"
          }
        }
      }
    },
    {
      "subId": "4008164",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "400816401"
        ],
        "dialogs": {
          "400816401": {
            "id": "400816401",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "你是…",
            "nextDialogs": [
              "400816402"
            ]
          },
          "400816402": {
            "id": "400816402",
            "speakerId": 1008,
            "speakerName": "贝尔福",
            "text": "不瞒你说，我原本只是个普通生意人。研究过商业活动的宣传原则，把握用户心理之类的要点。",
            "nextDialogs": [
              "400816403"
            ]
          },
          "400816403": {
            "id": "400816403",
            "speakerId": 1008,
            "speakerName": "贝尔福",
            "text": "埃尔欣根先生听说我的经历后，就招我来帮忙，协助他的员工和考特里亚筹备这场比赛。",
            "nextDialogs": [
              "400816404"
            ]
          },
          "400816404": {
            "id": "400816404",
            "speakerId": 1008,
            "speakerName": "贝尔福",
            "text": "他的员工们都很机灵，很快就把埃尔欣根先生的产业从传统生意转化成了适合举办比赛的类型。",
            "nextDialogs": [
              "400816405"
            ]
          },
          "400816405": {
            "id": "400816405",
            "speakerId": 1009,
            "speakerName": "<UNKNOWN>",
            "text": "传统生意？",
            "nextDialogs": [
              "400816406"
            ]
          },
          "400816406": {
            "id": "400816406",
            "speakerId": 1008,
            "speakerName": "贝尔福",
            "text": "嗯，听说埃尔欣根先生以前似乎主要靠出售杂货来赚钱，具体的内容我也不太清楚。",
            "nextDialogs": [
              "400816407"
            ]
          },
          "400816407": {
            "id": "400816407",
            "speakerId": 1008,
            "speakerName": "贝尔福",
            "text": "我觉得能从一个杂货商成长为这么有钱的大人物，实在了不起！",
            "nextDialogs": [
              "400816408"
            ]
          },
          "400816408": {
            "id": "400816408",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "埃尔欣根居然是这么开明的人吗…你也挺努力的呢！",
            "nextDialogs": [
              "400816409"
            ]
          },
          "400816409": {
            "id": "400816409",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "说起来，我们也是第一次见到枫丹的大富商呢，感觉他第一眼看上去，没什么特别的。",
            "nextDialogs": [
              "400816410"
            ]
          },
          "400816410": {
            "id": "400816410",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "虽然是个枫丹人，却穿着须弥商人的衣服，也没戴着什么贵重的东西，体现不出他多有钱…",
            "nextDialogs": [
              "400816411"
            ]
          },
          "400816411": {
            "id": "400816411",
            "speakerId": 1008,
            "speakerName": "贝尔福",
            "text": "你看，这就是埃尔欣根先生性格超好的一大证明。",
            "nextDialogs": [
              "400816412"
            ]
          },
          "400816412": {
            "id": "400816412",
            "speakerId": 1008,
            "speakerName": "贝尔福",
            "text": "他来须弥很久了，早就融入了我们本地的环境，做事很低调。",
            "nextDialogs": [
              "400816413"
            ]
          },
          "400816413": {
            "id": "400816413",
            "speakerId": 1008,
            "speakerName": "贝尔福",
            "text": "平常埃尔欣根先生，甚至会和我们这些小员工一起吃饭聊天，就像是朋友一样！",
            "nextDialogs": [
              "400816414"
            ]
          },
          "400816414": {
            "id": "400816414",
            "speakerId": 1008,
            "speakerName": "贝尔福",
            "text": "我想，他没有去找专业的商人帮忙，而是雇了我，也有防止恶性竞争的因素在里边。",
            "nextDialogs": [
              "400816415"
            ]
          },
          "400816415": {
            "id": "400816415",
            "speakerId": 1008,
            "speakerName": "贝尔福",
            "text": "如果他一开始就大张旗鼓地宣传这场比赛，说不定会有其他有钱人参和进来，想要分一杯羹，说不定比赛会因此失去原来的意义！",
            "nextDialogs": [
              "400816416"
            ]
          },
          "400816416": {
            "id": "400816416",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "真好！如果我也要找一份工作，希望能碰见这样的老板！",
            "nextDialogs": [
              "400816419"
            ]
          },
          "400816419": {
            "id": "400816419",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "说什么啦！你又不一样！",
            "nextDialogs": [
              "400816420"
            ]
          },
          "400816420": {
            "id": "400816420",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "难道，难道凭我们两个的关系，还要计较摩拉这点小事吗？"
          }
        }
      }
    },
    {
      "subId": "4008165",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "400816501"
        ],
        "dialogs": {
          "400816501": {
            "id": "400816501",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "「花花琼脂」这名字…",
            "nextDialogs": [
              "400816502"
            ]
          },
          "400816502": {
            "id": "400816502",
            "speakerId": 1008,
            "speakerName": "贝尔福",
            "text": "啊哈，我知道你想说什么！",
            "nextDialogs": [
              "400816503"
            ]
          },
          "400816503": {
            "id": "400816503",
            "speakerId": 1008,
            "speakerName": "贝尔福",
            "text": "听说，因论派的学者研究了提瓦特各地的文献，初步得出了一个结论，叠词能让一个名字听起来更可爱，我觉得有点道理。",
            "nextDialogs": [
              "400816504"
            ]
          },
          "400816504": {
            "id": "400816504",
            "speakerId": 1008,
            "speakerName": "贝尔福",
            "text": "考特里亚再三强调，他的研究内容「无比伟大」，名字必须具备足够的威慑力…但都被埃尔欣根先生婉言拒绝了。",
            "nextDialogs": [
              "400816505"
            ]
          },
          "400816505": {
            "id": "400816505",
            "speakerId": 1008,
            "speakerName": "贝尔福",
            "text": "埃尔欣根先生认为，很多人都觉得蕈兽很可爱，那么比赛中的专属名词也要让大家感到愉快才合适。",
            "nextDialogs": [
              "400816506"
            ]
          },
          "400816506": {
            "id": "400816506",
            "speakerId": 1008,
            "speakerName": "贝尔福",
            "text": "一番争论后，「花花琼脂」这个名字保留了下来，还有比较简单明了的「意智宝珠」。",
            "nextDialogs": [
              "400816507"
            ]
          },
          "400816507": {
            "id": "400816507",
            "speakerId": 1008,
            "speakerName": "贝尔福",
            "text": "不过，其他地方的名字，埃尔欣根先生还是让着考特里亚。好在那些名词大多是用来和将来的合作方沟通的，一般选手不用知道。",
            "nextDialogs": [
              "400816508"
            ]
          },
          "400816508": {
            "id": "400816508",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "这个考特里亚怎么回事，好像总是在强调自己很厉害，有点霸道。",
            "nextDialogs": [
              "400816511"
            ]
          },
          "400816511": {
            "id": "400816511",
            "speakerId": 1008,
            "speakerName": "贝尔福",
            "text": "你也这么觉得吗？",
            "nextDialogs": [
              "400816512"
            ]
          },
          "400816512": {
            "id": "400816512",
            "speakerId": 1008,
            "speakerName": "贝尔福",
            "text": "很多工作人员都和他相处不来，埃尔欣根先生也处处让着他。",
            "nextDialogs": [
              "400816513"
            ]
          },
          "400816513": {
            "id": "400816513",
            "speakerId": 1008,
            "speakerName": "贝尔福",
            "text": "要不是他的技术无可替代，加上埃尔欣根先生尽力安抚大家…大概这次比赛的主办团队早就解散了吧。",
            "nextDialogs": [
              "400816514"
            ]
          },
          "400816514": {
            "id": "400816514",
            "speakerId": 1008,
            "speakerName": "贝尔福",
            "text": "这么看来，在埃尔欣根先生出资赞助前，考特里亚什么事也没办成，不是没有道理的。"
          }
        }
      }
    },
    {
      "subId": "4008166",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "400816601"
        ],
        "dialogs": {
          "400816601": {
            "id": "400816601",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "关于这场比赛…",
            "nextDialogs": [
              "400816602"
            ]
          },
          "400816602": {
            "id": "400816602",
            "speakerId": 1008,
            "speakerName": "贝尔福",
            "text": "还有什么不清楚的地方，可以去宣传牌那边再看看！",
            "nextDialogs": [
              "400816603"
            ]
          },
          "400816603": {
            "id": "400816603",
            "speakerId": 1008,
            "speakerName": "贝尔福",
            "text": "工作人员会在宣传牌上更新比赛的进程。听说计划中还有一些互动活动，等到赛事的热度达标了，活动就会开始。",
            "nextDialogs": [
              "400816604"
            ]
          },
          "400816604": {
            "id": "400816604",
            "speakerId": 1008,
            "speakerName": "贝尔福",
            "text": "等到比赛有了一定的进展后，或许还会开始发售精彩赛事的「映影」呢。",
            "nextDialogs": [
              "400816605"
            ]
          },
          "400816605": {
            "id": "400816605",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "怎么样才算热度达标…",
            "nextDialogs": [
              "400816606"
            ]
          },
          "400816606": {
            "id": "400816606",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "听起来是个很苛刻的要求啊，比赛的场地明明不太显眼，真的没问题吗？",
            "nextDialogs": [
              "400816607"
            ]
          },
          "400816607": {
            "id": "400816607",
            "speakerId": 1008,
            "speakerName": "贝尔福",
            "text": "没问题没问题，赛场旁边可是维卡拉商栈，须弥的贸易重地。距离港口的栈桥也不远，来来往往的人们都能看到。",
            "nextDialogs": [
              "400816608"
            ]
          },
          "400816608": {
            "id": "400816608",
            "speakerId": 1008,
            "speakerName": "贝尔福",
            "text": "而且，我们还在须弥城的布置了宣传用的公告版，不少选手和观众都是看到广告后慕名而来的。",
            "nextDialogs": [
              "400816609"
            ]
          },
          "400816609": {
            "id": "400816609",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "我们也看到了，原来那块牌子上的宣传广告是你写的！",
            "nextDialogs": [
              "400816610"
            ]
          },
          "400816610": {
            "id": "400816610",
            "speakerId": 1008,
            "speakerName": "贝尔福",
            "text": "哈哈，还不错吧？在写宣传的文本这一点上，我也是很有自信的。",
            "nextDialogs": [
              "400816611"
            ]
          },
          "400816611": {
            "id": "400816611",
            "speakerId": 1008,
            "speakerName": "贝尔福",
            "text": "比赛过程的报道也有我的份，我会尽力把你们的比赛过程描写得惊心动魄！",
            "nextDialogs": [
              "400816612"
            ]
          },
          "400816612": {
            "id": "400816612",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "总感觉你一个人干了好多事呢，管理这些「花花琼脂」，给活动做规划，还要写宣传词和比赛报道…",
            "nextDialogs": [
              "400816613"
            ]
          },
          "400816613": {
            "id": "400816613",
            "speakerId": 1008,
            "speakerName": "贝尔福",
            "text": "这算什么，要知道埃尔欣根先生开给我的薪水，可是我原来收入的十倍…呃咳！",
            "nextDialogs": [
              "400816614"
            ]
          },
          "400816614": {
            "id": "400816614",
            "speakerId": 1008,
            "speakerName": "贝尔福",
            "text": "总之，埃尔欣根先生也说过，能者多劳，我愿意为这样的老板尽全力。"
          }
        }
      }
    },
    {
      "subId": "4008167",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "400816701"
        ],
        "dialogs": {
          "400816701": {
            "id": "400816701",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "再见。",
            "nextDialogs": [
              "400816702"
            ]
          },
          "400816702": {
            "id": "400816702",
            "speakerId": 1008,
            "speakerName": "贝尔福",
            "text": "下次再见，两位加油啊！"
          }
        }
      }
    }
  ]
}
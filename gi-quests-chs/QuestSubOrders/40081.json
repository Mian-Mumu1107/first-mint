  "subQuests": [
    {
      "subId": "4008101",
      "subQuestName": "在须弥城附近转一转",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "400810201"
        ],
        "dialogs": {
          "400810201": {
            "id": "400810201",
            "speakerId": 1000,
            "speakerName": "宣传板",
            "text": "首届「月莲杯驯兽师大赛」即将在奥摩斯港拉开帷幕，期待着各位的到来！",
            "nextDialogs": [
              "400810204"
            ]
          },
          "400810204": {
            "id": "400810204",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "蕈兽可是魔物啊！这种事情不管怎么想都很危险…",
            "nextDialogs": [
              "400810205"
            ]
          },
          "400810205": {
            "id": "400810205",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "我们先去比赛现场看看吧？假如真的有危险，至少我们能防止他们把事态搞得不可收拾。"
          }
        }
      }
    },
    {
      "subId": "4008103",
      "subQuestName": "前往「月莲杯」赛场",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "400810401"
        ],
        "dialogs": {
          "400810401": {
            "id": "400810401",
            "speakerId": 1002,
            "speakerName": "考特里亚",
            "text": "庆贺吧，各位参赛者！欢迎来到「月莲杯驯兽师大赛」！我是大赛负责人，生论派资深学者考特里亚。",
            "nextDialogs": [
              "400810402"
            ]
          },
          "400810402": {
            "id": "400810402",
            "speakerId": 1002,
            "speakerName": "考特里亚",
            "text": "各位想必对「指挥蕈兽作战」的概念很感兴趣，抑或期待着丰厚的奖励，但同时对比赛的安全措施不太放心。",
            "nextDialogs": [
              "400810403"
            ]
          },
          "400810403": {
            "id": "400810403",
            "speakerId": 1002,
            "speakerName": "考特里亚",
            "text": "我向各位保证！我们为本次大赛专门准备的「意智宝珠」运用了生论派最先进的「理性增幅」技术，绝对安全可靠！",
            "nextDialogs": [
              "400810404"
            ]
          },
          "400810404": {
            "id": "400810404",
            "speakerId": 1002,
            "speakerName": "考特里亚",
            "text": "请大家放下顾虑，大胆参与赛事！",
            "nextDialogs": [
              "400810405"
            ]
          },
          "400810405": {
            "id": "400810405",
            "speakerId": 1002,
            "speakerName": "考特里亚",
            "text": "此外，本次大赛还得到了枫丹大商人埃尔欣根先生的赞助，他为本次大赛提供了所有的奖金，总计六千万摩拉！",
            "nextDialogs": [
              "400810406"
            ]
          },
          "400810406": {
            "id": "400810406",
            "speakerId": 1002,
            "speakerName": "考特里亚",
            "text": "如果有人能在决赛之后，通过「最终考验」，证明自己有能力贯彻埃尔欣根先生的理念，他甚至愿意出让自己的全部资产！",
            "nextDialogs": [
              "400810407"
            ]
          },
          "400810407": {
            "id": "400810407",
            "speakerId": 1002,
            "speakerName": "考特里亚",
            "text": "此外附加的唯一要求是，这位选手必须接过埃尔欣根先生的衣钵，将这「月莲杯驯兽师大赛」继续举办下去…",
            "nextDialogs": [
              "400810408"
            ]
          },
          "400810408": {
            "id": "400810408",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "呜哇！那个富商随随便便就能投资六千万摩拉？还有，只需要继续支持这个驯兽师大赛…就能拿到他的全部财产？",
            "nextDialogs": [
              "400810409"
            ]
          },
          "400810409": {
            "id": "400810409",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "不对不对，主办方居然有教令院的学者站台，那我们二话不说就直接阻止，好像有点不太合适呢。",
            "nextDialogs": [
              "400810410"
            ]
          },
          "400810410": {
            "id": "400810410",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "要不然…我们先去参加比赛，试试他们说的「意智宝珠」到底管不管用吧？",
            "nextDialogs": [
              "400810413"
            ]
          },
          "400810413": {
            "id": "400810413",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "才没有啦！毕竟须弥好不容易才安定下来，现在这种时候，我们还和教令院对着干的话，也太不给纳西妲面子了嘛…",
            "nextDialogs": [
              "400810414"
            ]
          },
          "400810414": {
            "id": "400810414",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "而且听他说得信心满满，我也想见识一下能把蕈兽驯服的东西有多神奇！"
          }
        }
      }
    },
    {
      "subId": "4008115",
      "subQuestName": "领取「意智宝珠」",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "400811401"
        ],
        "dialogs": {
          "400811401": {
            "id": "400811401",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "咦，之前的人还没登记完吗？我们再等等吧。",
            "nextDialogs": [
              "400811402"
            ]
          },
          "400811402": {
            "id": "400811402",
            "speakerId": 1003,
            "speakerName": "？？？",
            "text": "#「黄金流星」{NICKNAME}和「白银伴星」派蒙…你们也要参加这场比赛？",
            "nextDialogs": [
              "400811403"
            ]
          },
          "400811403": {
            "id": "400811403",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "咦，你认识我们？突然就报出了从没听过的称号…",
            "nextDialogs": [
              "400811404"
            ]
          },
          "400811404": {
            "id": "400811404",
            "speakerId": 1003,
            "speakerName": "？？？",
            "text": "你们很强，从你们手下逃过一劫的佣兵画了你们的像，警告其他人别惹你们。",
            "nextDialogs": [
              "400811405"
            ]
          },
          "400811405": {
            "id": "400811405",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "呃…我们应该说「谢谢夸奖」，还是解释我们没有传闻中那么恐怖呢…",
            "nextDialogs": [
              "400811406"
            ]
          },
          "400811406": {
            "id": "400811406",
            "speakerId": 1003,
            "speakerName": "？？？",
            "text": "可惜，根据这场大赛的规则，驯兽师被禁止携带武器，不可以直接出手，你们无可挑剔的战斗力是不管用的。",
            "nextDialogs": [
              "400811407"
            ]
          },
          "400811407": {
            "id": "400811407",
            "speakerId": 1003,
            "speakerName": "？？？",
            "text": "比赛的重点是捕捉和训练蕈兽，指挥这些「棋子」去战斗，你们也未必能掌握指挥蕈兽的关键技巧。",
            "nextDialogs": [
              "400811408"
            ]
          },
          "400811408": {
            "id": "400811408",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "说得也有道理呢…我们还没试过捕捉蕈兽，也不知道指挥蕈兽战斗的要点。",
            "nextDialogs": [
              "400811409"
            ]
          },
          "400811409": {
            "id": "400811409",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "等等，你也不像工作人员啊？为什么你一副把握十足的样子在说教，你到底是什么人？",
            "nextDialogs": [
              "400811410"
            ]
          },
          "400811410": {
            "id": "400811410",
            "speakerId": 1004,
            "speakerName": "海妮耶",
            "text": "我叫海妮耶。曾为镀金旅团工作，负责驯服暴躁的驮兽，在此之前就被称为「驯兽师」，也因此参与了「意智宝珠」的初期测试。",
            "nextDialogs": [
              "400811411"
            ]
          },
          "400811411": {
            "id": "400811411",
            "speakerId": 1004,
            "speakerName": "海妮耶",
            "text": "不过，我这种不识字的粗人只能给佣兵们打杂，报出名号也没什么意义，你们就把我当成普通的参赛选手好了。",
            "nextDialogs": [
              "400811412"
            ]
          },
          "400811412": {
            "id": "400811412",
            "speakerId": 1004,
            "speakerName": "海妮耶",
            "text": "在驯兽这一行，我有不少心得，你们需要我指点一下吗？",
            "nextDialogs": [
              "400811415"
            ]
          },
          "400811415": {
            "id": "400811415",
            "speakerId": 1004,
            "speakerName": "海妮耶",
            "text": "无论作为盟友还是对手，你们都能在比赛中帮我排除阻碍，是值得结交的对象。当然，我个人希望是前者。",
            "nextDialogs": [
              "400811416"
            ]
          },
          "400811416": {
            "id": "400811416",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "说得好直白…不过还挺诚实的。",
            "nextDialogs": [
              "400811417"
            ]
          },
          "400811417": {
            "id": "400811417",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "有个懂行的人来指导，总归是比我们自己摸索要强的吧？不如先答应她？",
            "nextDialogs": [
              "400811418"
            ]
          },
          "400811418": {
            "id": "400811418",
            "speakerId": 1004,
            "speakerName": "海妮耶",
            "text": "那就收好这个「意智宝珠」吧，我们现在就启程，去主办方指定的区域捕捉蕈兽。",
            "nextDialogs": [
              "400811419"
            ]
          },
          "400811419": {
            "id": "400811419",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "真是个雷厉风行的人啊…"
          }
        }
      }
    },
    {
      "subId": "4008109",
      "subQuestName": "与海妮耶对话",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "400810901"
        ],
        "dialogs": {
          "400810901": {
            "id": "400810901",
            "speakerId": 1004,
            "speakerName": "海妮耶",
            "text": "这里就是捕捉区域了，这一带的蕈兽和「意智宝珠」的匹配度较高，适合训练与比赛。",
            "nextDialogs": [
              "400810902"
            ]
          },
          "400810902": {
            "id": "400810902",
            "speakerId": 1004,
            "speakerName": "海妮耶",
            "text": "「意智宝珠」能捕捉和收纳蕈兽，本身也是一个操纵装置。",
            "nextDialogs": [
              "400810903"
            ]
          },
          "400810903": {
            "id": "400810903",
            "speakerId": 1004,
            "speakerName": "海妮耶",
            "text": "我建议你们为每只蕈兽确认一个代号，这样便于指挥它们。比如我身边的这只，它叫「火一」，代表「火元素蕈兽一号」。",
            "nextDialogs": [
              "400810904"
            ]
          },
          "400810904": {
            "id": "400810904",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "元素种类加编号？总觉得这样的名字有点单薄呢…海妮耶的这只蕈兽看起来很有活力，不如就叫「蹦蹦开心菇」好了！",
            "nextDialogs": [
              "400810907"
            ]
          },
          "400810907": {
            "id": "400810907",
            "speakerId": 1004,
            "speakerName": "海妮耶",
            "text": "多此一…多谢了。我有自己习惯的起名方式，重要的是简单直观，便于指挥。",
            "nextDialogs": [
              "400810908"
            ]
          },
          "400810908": {
            "id": "400810908",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "也对哦，你大概已经习惯叫它「火一」了…我们就不给你出主意了。不过，听到我们起的厉害名字后，你也许会回心转意！"
          }
        }
      }
    },
    {
      "subId": "4008105",

{
  "lineCounts": {
    "愚人众行动日志·其一": 4,
    "愚人众行动日志·其三": 3,
    "愚人众行动日志·其二": 4,
    "愚人众行动日志·其四": 4
  },
  "subQuests": [
    {
      "subId": "7109402",
      "subQuestName": "",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "710360501"
        ],
        "dialogs": {
          "710360501": {
            "id": "710360501",
            "speakerId": 1000,
            "speakerName": "愚人众行动日志·其一",
            "text": "「…璃月人留下了他们的工程用大炮，有维护的痕迹，看来他们仍然没有放弃重开矿坑的打算…」",
            "nextDialogs": [
              "710360502"
            ]
          },
          "710360502": {
            "id": "710360502",
            "speakerId": 1000,
            "speakerName": "愚人众行动日志·其一",
            "text": "「…侦查了晶石碎片所在的空间，为后续人员扫清道路，回到此地待命…」",
            "nextDialogs": [
              "710360503"
            ]
          },
          "710360503": {
            "id": "710360503",
            "speakerId": 1000,
            "speakerName": "愚人众行动日志·其一",
            "text": "「…声波捕获器出现了反应…在矿坑的更深处传来了更大的搏动…宏大但暗哑…」",
            "nextDialogs": [
              "710360504"
            ]
          },
          "710360504": {
            "id": "710360504",
            "speakerId": 1000,
            "speakerName": "愚人众行动日志·其一",
            "text": "「…根据取样分析，晶石的年龄或许比层岩巨渊更为古老。但在附近并未发现成体系的古文明痕迹…」"
          }
        }
      }
    },
    {
      "subId": "7109403",
      "subQuestName": "",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "710360601"
        ],
        "dialogs": {
          "710360601": {
            "id": "710360601",
            "speakerId": 1001,
            "speakerName": "愚人众行动日志·其二",
            "text": "「…声波捕获器一直在嘎嘎乱响，响得就像安东中士的老祖母在打呼噜…没办法正常使用…」",
            "nextDialogs": [
              "710360602"
            ]
          },
          "710360602": {
            "id": "710360602",
            "speakerId": 1001,
            "speakerName": "愚人众行动日志·其二",
            "text": "「…不如就叫它『巴布什卡机器』算了，可能是因为晶石本身的辐射，以及那些黑色物质的影响…」",
            "nextDialogs": [
              "710360603"
            ]
          },
          "710360603": {
            "id": "710360603",
            "speakerId": 1001,
            "speakerName": "愚人众行动日志·其二",
            "text": "「…没有备件修复『巴布什卡』，只能拆卸…抱歉了，老奶奶。暂在此地扎营，以备补给之需。」",
            "nextDialogs": [
              "710360604"
            ]
          },
          "710360604": {
            "id": "710360604",
            "speakerId": 1001,
            "speakerName": "愚人众行动日志·其二",
            "text": "「…似乎有人在不远处的高地观察我们，看到了不自然的闪光。是望远镜（甚至火枪的瞄准镜）？需要尽快转移…」"
          }
        }
      }
    },
    {
      "subId": "7109404",
      "subQuestName": "",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "710360701"
        ],
        "dialogs": {
          "710360701": {
            "id": "710360701",
            "speakerId": 1002,
            "speakerName": "愚人众行动日志·其三",
            "text": "「…技术士官波格丹娜发现那些黑色的泥状物仍然在不断增生，我们需要加速行动了…」",
            "nextDialogs": [
              "710360702"
            ]
          },
          "710360702": {
            "id": "710360702",
            "speakerId": 1002,
            "speakerName": "愚人众行动日志·其三",
            "text": "「…层岩巨渊地下的异变在缓慢加速，为了阻止情况进一步恶化，我们需要尽快将『摩科什装置』运抵底部组装…」",
            "nextDialogs": [
              "710360703"
            ]
          },
          "710360703": {
            "id": "710360703",
            "speakerId": 1002,
            "speakerName": "愚人众行动日志·其三",
            "text": "「…安东中士报告说有一个女人一直在跟踪我们，有布下陷阱和警报装置的必要…」"
          }
        }
      }
    },
    {
      "subId": "7109405",
      "subQuestName": "",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "710360801"
        ],
        "dialogs": {
          "710360801": {
            "id": "710360801",
            "speakerId": 1003,
            "speakerName": "愚人众行动日志·其四",
            "text": "「…发生了不明原因的爆炸，理论上能够清除深渊污染的『摩科什装置』完全过载被毁…」",
            "nextDialogs": [
              "710360802"
            ]
          },
          "710360802": {
            "id": "710360802",
            "speakerId": 1003,
            "speakerName": "愚人众行动日志·其四",
            "text": "「…主碎片上的污黑物质又开始再生了，需要总结之前的教训…」",
            "nextDialogs": [
              "710360803"
            ]
          },
          "710360803": {
            "id": "710360803",
            "speakerId": 1003,
            "speakerName": "愚人众行动日志·其四",
            "text": "「…对准主碎片的恰当受力点，进行一次或多次重击，即可令晶石上的黑色物质退去…」",
            "nextDialogs": [
              "710360804"
            ]
          },
          "710360804": {
            "id": "710360804",
            "speakerId": 1003,
            "speakerName": "愚人众行动日志·其四",
            "text": "「…侦察队在不同位置发现有人影活动，不知人类还是什么生物…或许它们就是令那些黑色物质蔓延的真凶…」"
          }
        }
      }
    }
  ]
}
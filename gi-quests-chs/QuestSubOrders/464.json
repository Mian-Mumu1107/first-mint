    {
      "subId": "46409",
      "subQuestName": "与霍夫曼对话",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "4641201"
        ],
        "dialogs": {
          "4641201": {
            "id": "4641201",
            "speakerId": 1009,
            "speakerName": "霍夫曼",
            "text": "两位，刚刚我好像听到这边有什么响动…",
            "nextDialogs": [
              "4641202"
            ]
          },
          "4641202": {
            "id": "4641202",
            "speakerId": 1009,
            "speakerName": "霍夫曼",
            "text": "有发现什么异常吗？",
            "nextDialogs": [
              "4641203"
            ]
          },
          "4641203": {
            "id": "4641203",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "异常？没有哦。",
            "nextDialogs": [
              "4641204"
            ]
          },
          "4641204": {
            "id": "4641204",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "哦，难道你是指「暗夜英雄」，他…",
            "nextDialogs": [
              "4641207"
            ]
          },
          "4641207": {
            "id": "4641207",
            "speakerId": 1009,
            "speakerName": "霍夫曼",
            "text": "「暗夜英雄」？你们见到他了吗？",
            "nextDialogs": [
              "4641208"
            ]
          },
          "4641208": {
            "id": "4641208",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "#他…唔…他就是{NICKNAME}啦！",
            "nextDialogs": [
              "4641209"
            ]
          },
          "4641209": {
            "id": "4641209",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "……",
            "nextDialogs": [
              "4641210"
            ]
          },
          "4641210": {
            "id": "4641210",
            "speakerId": 1009,
            "speakerName": "霍夫曼",
            "text": "哦~！暗中守护蒙德的英雄就是你啊，我代表骑士团向你道谢。",
            "nextDialogs": [
              "4641211"
            ]
          },
          "4641211": {
            "id": "4641211",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "唔…不用这么郑重啦…我、我们都不好意思了…",
            "nextDialogs": [
              "4641212"
            ]
          },
          "4641212": {
            "id": "4641212",
            "speakerId": 1009,
            "speakerName": "霍夫曼",
            "text": "等等…不对。你们不是最近才来的旅行者吗？",
            "nextDialogs": [
              "4641213"
            ]
          },
          "4641213": {
            "id": "4641213",
            "speakerId": 1009,
            "speakerName": "霍夫曼",
            "text": "在你们来蒙德之前，暗夜英雄的传说就已经流传很久了。",
            "nextDialogs": [
              "4641214"
            ]
          },
          "4641214": {
            "id": "4641214",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "啊…",
            "nextDialogs": [
              "4641215"
            ]
          },
          "4641215": {
            "id": "4641215",
            "speakerId": 1009,
            "speakerName": "霍夫曼",
            "text": "…为什么要说这样的谎？"
          }
        }
      }
    },

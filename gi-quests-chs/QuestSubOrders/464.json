  "subQuests": [
    {
      "subId": "46401",
      "subQuestName": "向查尔斯打听最近的传闻",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "4640101"
        ],
        "dialogs": {
          "4640101": {
            "id": "4640101",
            "speakerId": 1000,
            "speakerName": "查尔斯",
            "text": "原来你也是那种爱凑热闹的性格啊。",
            "nextDialogs": [
              "4640102"
            ]
          },
          "4640102": {
            "id": "4640102",
            "speakerId": 1000,
            "speakerName": "查尔斯",
            "text": "不得不说，最近来光顾的客人确实都在谈论…",
            "nextDialogs": [
              "4640103"
            ]
          },
          "4640103": {
            "id": "4640103",
            "speakerId": 1000,
            "speakerName": "查尔斯",
            "text": "与其说是「热门话题」，不如说是「都市传说」一类的东西吧。",
            "nextDialogs": [
              "4640104"
            ]
          },
          "4640104": {
            "id": "4640104",
            "speakerId": 1000,
            "speakerName": "查尔斯",
            "text": "即使我没有刻意去听，耳朵也快听出茧来了。",
            "nextDialogs": [
              "4640105"
            ]
          },
          "4640105": {
            "id": "4640105",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "不会…不会是什么可怕的传说吧…",
            "nextDialogs": [
              "4640106"
            ]
          },
          "4640106": {
            "id": "4640106",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "先、先给我一点心理准备！",
            "nextDialogs": [
              "4640107"
            ]
          },
          "4640107": {
            "id": "4640107",
            "speakerId": 1000,
            "speakerName": "查尔斯",
            "text": "可怕倒没什么可怕的，至少对绝大部分的人来说是这样…",
            "nextDialogs": [
              "4640108"
            ]
          },
          "4640108": {
            "id": "4640108",
            "speakerId": 1000,
            "speakerName": "查尔斯",
            "text": "…是被称为「暗夜英雄」的人的传说。",
            "nextDialogs": [
              "4640109"
            ]
          },
          "4640109": {
            "id": "4640109",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "哇！！",
            "nextDialogs": [
              "4640111",
              "4640114"
            ]
          },
          "4640111": {
            "id": "4640111",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "唔嗯，刚才酒保先生说的什么？",
            "nextDialogs": [
              "4640112"
            ]
          },
          "4640112": {
            "id": "4640112",
            "speakerId": 1000,
            "speakerName": "查尔斯",
            "text": "原来你根本没在听啊…",
            "nextDialogs": [
              "4640116"
            ]
          },
          "4640116": {
            "id": "4640116",
            "speakerId": 1000,
            "speakerName": "查尔斯",
            "text": "我在说「暗夜英雄」。",
            "nextDialogs": [
              "4640117"
            ]
          },
          "4640117": {
            "id": "4640117",
            "speakerId": 1000,
            "speakerName": "查尔斯",
            "text": "传闻中只有在午夜时分才会出现，惩恶扬善的神秘人。",
            "nextDialogs": [
              "4640118"
            ]
          },
          "4640118": {
            "id": "4640118",
            "speakerId": 1000,
            "speakerName": "查尔斯",
            "text": "不过老实说，这种传说我没什么兴趣…",
            "nextDialogs": [
              "4640119"
            ]
          },
          "4640119": {
            "id": "4640119",
            "speakerId": 1000,
            "speakerName": "查尔斯",
            "text": "除非他能帮忙治理一下半夜醉酒闹事的酒客…",
            "nextDialogs": [
              "4640120"
            ]
          },
          "4640120": {
            "id": "4640120",
            "speakerId": 1000,
            "speakerName": "查尔斯",
            "text": "那我还是很愿意承认他存在的。"
          },
          "4640114": {
            "id": "4640114",
            "speakerId": 1000,
            "speakerName": "查尔斯",
            "text": "喂，你们啊，到底有没有在听我说什么…",
            "nextDialogs": [
              "4640115"
            ]
          },
          "4640115": {
            "id": "4640115",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "唔嗯，刚才酒保先生说的什么？"
          }
        }
      }
    },
    {
      "subId": "46402",
      "subQuestName": "向喷泉广场上的路人打听情报",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "4640201"
        ],
        "dialogs": {
          "4640201": {
            "id": "4640201",
            "speakerId": 1002,
            "speakerName": "玛格丽特",
            "text": "哦~你是来问「暗夜英雄」的事啊。",
            "nextDialogs": [
              "4640202"
            ]
          },
          "4640202": {
            "id": "4640202",
            "speakerId": 1002,
            "speakerName": "玛格丽特",
            "text": "「暗夜英雄」就是我哦。",
            "nextDialogs": [
              "4640204",
              "4640206"
            ]
          },
          "4640204": {
            "id": "4640204",
            "speakerId": 1002,
            "speakerName": "玛格丽特",
            "text": "是的，我是在开玩笑哦。",
            "nextDialogs": [
              "4640207"
            ]
          },
          "4640207": {
            "id": "4640207",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "……",
            "nextDialogs": [
              "4640208"
            ]
          },
          "4640208": {
            "id": "4640208",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "嗯……",
            "nextDialogs": [
              "4640209"
            ]
          },
          "4640209": {
            "id": "4640209",
            "speakerId": 1002,
            "speakerName": "玛格丽特",
            "text": "呵呵，其实我想说的是，在他身上我感觉到一种和我相似的气息哦。",
            "nextDialogs": [
              "4640210"
            ]
          },
          "4640210": {
            "id": "4640210",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "相似的气息？",
            "nextDialogs": [
              "4640211"
            ]
          },
          "4640211": {
            "id": "4640211",
            "speakerId": 1002,
            "speakerName": "玛格丽特",
            "text": "在数之不尽的夜晚里守护着蒙德，贯彻自己的正义，坚守自己的信念。",
            "nextDialogs": [
              "4640212"
            ]
          },
          "4640212": {
            "id": "4640212",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "原来玛格丽特女士也是这样了不起的人吗？",
            "nextDialogs": [
              "4640213"
            ]
          },
          "4640213": {
            "id": "4640213",
            "speakerId": 1002,
            "speakerName": "玛格丽特",
            "text": "不不，我的意思是，他一定很有钱吧。",
            "nextDialogs": [
              "4640214"
            ]
          },
          "4640214": {
            "id": "4640214",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "嗯？",
            "nextDialogs": [
              "4640215"
            ]
          },
          "4640215": {
            "id": "4640215",
            "speakerId": 1002,
            "speakerName": "玛格丽特",
            "text": "往往在物质富裕的基础上才会追求精神的富有…",
            "nextDialogs": [
              "4640216"
            ]
          },
          "4640216": {
            "id": "4640216",
            "speakerId": 1002,
            "speakerName": "玛格丽特",
            "text": "很多英雄故事也都是这样写的，不是吗？",
            "nextDialogs": [
              "4640217"
            ]
          },
          "4640217": {
            "id": "4640217",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "…原来你只是在炫富而已。",
            "nextDialogs": [
              "4640218"
            ]
          },
          "4640218": {
            "id": "4640218",
            "speakerId": 1002,
            "speakerName": "玛格丽特",
            "text": "呵呵，没有的事，我只是每天都很闲罢了。",
            "nextDialogs": [
              "4640219"
            ]
          },
          "4640219": {
            "id": "4640219",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "都差不多啦，毕竟是「猫尾酒馆」的老板娘。",
            "nextDialogs": [
              "4640220"
            ]
          },
          "4640220": {
            "id": "4640220",
            "speakerId": 1002,
            "speakerName": "玛格丽特",
            "text": "不如你们再去<color=#00E1FFFF>城门</color>的守卫那边问问看？",
            "nextDialogs": [
              "4640221"
            ]
          },
          "4640221": {
            "id": "4640221",
            "speakerId": 1002,
            "speakerName": "玛格丽特",
            "text": "经常值夜班的他们很可能见过些什么吧。"
          },
          "4640206": {
            "id": "4640206",
            "speakerId": 1002,
            "speakerName": "玛格丽特",
            "text": "嗯…抱歉我是在开玩笑的，请不要这么认真。"
          }
        }
      }
    },
    {
      "subId": "46403",
      "subQuestName": "向城门附近的卫兵打听情报",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "4640301"
        ],
        "dialogs": {
          "4640301": {
            "id": "4640301",
            "speakerId": 1003,
            "speakerName": "劳伦斯",
            "text": "你们也对「他」感兴趣啊。",
            "nextDialogs": [
              "4640302"
            ]
          },
          "4640302": {
            "id": "4640302",
            "speakerId": 1003,
            "speakerName": "劳伦斯",
            "text": "嘿嘿，不瞒你们说，我可是「暗夜英雄」的目击者之一。",
            "nextDialogs": [
              "4640303"
            ]
          },
          "4640303": {
            "id": "4640303",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "呜哇，这下找对人了。",
            "nextDialogs": [
              "4640304"
            ]
          },
          "4640304": {
            "id": "4640304",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "那么「暗夜英雄」到底是谁呢？",
            "nextDialogs": [
              "4640305"
            ]
          },
          "4640305": {
            "id": "4640305",
            "speakerId": 1003,
            "speakerName": "劳伦斯",
            "text": "欸~别急，等我慢慢讲。",
            "nextDialogs": [
              "4640306"
            ]
          },
          "4640306": {
            "id": "4640306",
            "speakerId": 1003,
            "speakerName": "劳伦斯",
            "text": "那晚我正在巡逻，被一点响动吸引，我赶忙过去查看。",
            "nextDialogs": [
              "4640307"
            ]
          },
          "4640307": {
            "id": "4640307",
            "speakerId": 1003,
            "speakerName": "劳伦斯",
            "text": "只见一伙儿人鬼鬼祟祟像是在密谋些什么。",
            "nextDialogs": [
              "4640308"
            ]
          },
          "4640308": {
            "id": "4640308",
            "speakerId": 1003,
            "speakerName": "劳伦斯",
            "text": "于是我赶忙躲了起来。",
            "nextDialogs": [
              "4640309"
            ]
          },
          "4640309": {
            "id": "4640309",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "喂，你不是守卫吗！",
            "nextDialogs": [
              "4640310"
            ]
          },
          "4640310": {
            "id": "4640310",
            "speakerId": 1003,
            "speakerName": "劳伦斯",
            "text": "而就在此时，「那个人」出现了。",
            "nextDialogs": [
              "4640311"
            ]
          },
          "4640311": {
            "id": "4640311",
            "speakerId": 1003,
            "speakerName": "劳伦斯",
            "text": "他一身黑袍，完美地隐藏在夜色里。",
            "nextDialogs": [
              "4640312"
            ]
          },
          "4640312": {
            "id": "4640312",
            "speakerId": 1003,
            "speakerName": "劳伦斯",
            "text": "对那些恶人来说，就像悄悄袭来的噩梦一样。",
            "nextDialogs": [
              "4640313"
            ]
          },
          "4640313": {
            "id": "4640313",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "哇……",
            "nextDialogs": [
              "4640314"
            ]
          },
          "4640314": {
            "id": "4640314",
            "speakerId": 1003,
            "speakerName": "劳伦斯",
            "text": "你们猜我这时候做了什么？",
            "nextDialogs": [
              "4640316",
              "4640319"
            ]
          },
          "4640316": {
            "id": "4640316",
            "speakerId": 1003,
            "speakerName": "劳伦斯",
            "text": "我又没做什么坏事，为什么要逃跑啊喂！",
            "nextDialogs": [
              "4640317"
            ]
          },
          "4640317": {
            "id": "4640317",
            "speakerId": 1003,
            "speakerName": "劳伦斯",
            "text": "不过…我确实从现场离开了，毕竟在「暗夜英雄」面前，我可能只是个累赘。",
            "nextDialogs": [
              "4640320"
            ]
          },
          "4640320": {
            "id": "4640320",
            "speakerId": 1003,
            "speakerName": "劳伦斯",
            "text": "于是…我去了骑士团宿舍。",
            "nextDialogs": [
              "4640321"
            ]
          },
          "4640321": {
            "id": "4640321",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "你认为「暗夜英雄」会是骑士团的人？",
            "nextDialogs": [
              "4640322"
            ]
          },
          "4640322": {
            "id": "4640322",
            "speakerId": 1003,
            "speakerName": "劳伦斯",
            "text": "没错，像他这样有正义感，自愿守护蒙德的人，加入骑士团是理所应当的吧？",
            "nextDialogs": [
              "4640323"
            ]
          },
          "4640323": {
            "id": "4640323",
            "speakerId": 1003,
            "speakerName": "劳伦斯",
            "text": "可事实上…好像是我自作聪明了。",
            "nextDialogs": [
              "4640324"
            ]
          },
          "4640324": {
            "id": "4640324",
            "speakerId": 1003,
            "speakerName": "劳伦斯",
            "text": "在宿舍检查一番以后，并没发现有人出门的迹象…",
            "nextDialogs": [
              "4640325"
            ]
          },
          "4640325": {
            "id": "4640325",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "那就是骑士团成员以外的人咯？",
            "nextDialogs": [
              "4640326"
            ]
          },
          "4640326": {
            "id": "4640326",
            "speakerId": 1003,
            "speakerName": "劳伦斯",
            "text": "是的。可我想不通…这样的人为何没有加入骑士团呢？",
            "nextDialogs": [
              "4640327"
            ]
          },
          "4640327": {
            "id": "4640327",
            "speakerId": 1003,
            "speakerName": "劳伦斯",
            "text": "以他的实力，应该很容易在骑士团有所作为的吧。",
            "nextDialogs": [
              "4640328"
            ]
          },
          "4640328": {
            "id": "4640328",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "到头来你还是不知道「暗夜英雄」的身份呀。",
            "nextDialogs": [
              "4640329"
            ]
          },
          "4640329": {
            "id": "4640329",
            "speakerId": 1003,
            "speakerName": "劳伦斯",
            "text": "别那么失望，至少缩小了范围嘛，哈哈。",
            "nextDialogs": [
              "4640330"
            ]
          },
          "4640330": {
            "id": "4640330",
            "speakerId": 1003,
            "speakerName": "劳伦斯",
            "text": "不如你再去<color=#00E1FFFF>花店</color>问问看，听说有位姑娘曾经受过他的帮助。"
          },
          "4640319": {
            "id": "4640319",
            "speakerId": 1003,
            "speakerName": "劳伦斯",
            "text": "嗯…在「暗夜英雄」面前，我可能只是个累赘，这点我还是有自知之明的。"
          }
        }
      }
    },
    {
      "subId": "46404",
      "subQuestName": "向满腹心事的少女打听情报",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "4640401"
        ],
        "dialogs": {
          "4640401": {
            "id": "4640401",
            "speakerId": 1004,
            "speakerName": "唐娜",
            "text": "唉…我真是个坏女人…",
            "nextDialogs": [
              "4640402"
            ]
          },
          "4640402": {
            "id": "4640402",
            "speakerId": 1004,
            "speakerName": "唐娜",
            "text": "怎么可以这样花心呢…",
            "nextDialogs": [
              "4640403"
            ]
          },
          "4640403": {
            "id": "4640403",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "喂喂？我们想问一下「暗~夜~英~雄」的事…",
            "nextDialogs": [
              "4640404"
            ]
          },
          "4640404": {
            "id": "4640404",
            "speakerId": 1004,
            "speakerName": "唐娜",
            "text": "「暗夜英雄」！？啊啊、不好意思，我刚才有些愣神…不过你们怎么知道我在想谁…",
            "nextDialogs": [
              "4640405"
            ]
          },
          "4640405": {
            "id": "4640405",
            "speakerId": 1004,
            "speakerName": "唐娜",
            "text": "啊…难道说…都写在脸上了？",
            "nextDialogs": [
              "4640406"
            ]
          },
          "4640406": {
            "id": "4640406",
            "speakerId": 1004,
            "speakerName": "唐娜",
            "text": "唔…怎么办，万一被迪卢克大人看到了，岂不是就…",
            "nextDialogs": [
              "4640407"
            ]
          },
          "4640407": {
            "id": "4640407",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "嗯？你说迪卢克大人？",
            "nextDialogs": [
              "4640408"
            ]
          },
          "4640408": {
            "id": "4640408",
            "speakerId": 1004,
            "speakerName": "唐娜",
            "text": "唔！…好吧，既然如此就全都告诉你们好了…",
            "nextDialogs": [
              "4640409"
            ]
          },
          "4640409": {
            "id": "4640409",
            "speakerId": 1004,
            "speakerName": "唐娜",
            "text": "本来我仰慕的人只有…嗯…迪卢克大人一个…",
            "nextDialogs": [
              "4640410"
            ]
          },
          "4640410": {
            "id": "4640410",
            "speakerId": 1004,
            "speakerName": "唐娜",
            "text": "可自从那晚，我被「暗夜英雄」所救…就好像再也不能确定自己的心意了…",
            "nextDialogs": [
              "4640411"
            ]
          },
          "4640411": {
            "id": "4640411",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "真的吗？那么「暗夜英雄」长什么样子呢？",
            "nextDialogs": [
              "4640412"
            ]
          },
          "4640412": {
            "id": "4640412",
            "speakerId": 1004,
            "speakerName": "唐娜",
            "text": "我当时太害怕了，没怎么看清楚…",
            "nextDialogs": [
              "4640413"
            ]
          },
          "4640413": {
            "id": "4640413",
            "speakerId": 1004,
            "speakerName": "唐娜",
            "text": "就只记得…令人感到安心的火光，莫名有些亲切的背影…",
            "nextDialogs": [
              "4640415",
              "4640418"
            ]
          },
          "4640415": {
            "id": "4640415",
            "speakerId": 1004,
            "speakerName": "唐娜",
            "text": "或许吧，你这么一说，确实很可能是火元素的「神之眼」。",
            "nextDialogs": [
              "4640416"
            ]
          },
          "4640416": {
            "id": "4640416",
            "speakerId": 1004,
            "speakerName": "唐娜",
            "text": "一下子照亮了四周的黑暗，所以印象很深刻。",
            "nextDialogs": [
              "4640421"
            ]
          },
          "4640421": {
            "id": "4640421",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "唔，好吧，谢谢你的情报，唐娜…",
            "nextDialogs": [
              "4640422"
            ]
          },
          "4640422": {
            "id": "4640422",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "整理一下现在所知的情报的话…",
            "nextDialogs": [
              "4640423"
            ]
          },
          "4640423": {
            "id": "4640423",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "「并非西风骑士，拥有神之眼的有钱人」…",
            "nextDialogs": [
              "4640424"
            ]
          },
          "4640424": {
            "id": "4640424",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "啊——还是想不明白啊。",
            "nextDialogs": [
              "4640425"
            ]
          },
          "4640425": {
            "id": "4640425",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "问了这么多，果然还是想亲眼见识一下呀…",
            "nextDialogs": [
              "4640426"
            ]
          },
          "4640426": {
            "id": "4640426",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "不如在夜晚的城里转转，运气好的话说不定会遇上「他」呢！"
          },
          "4640418": {
            "id": "4640418",
            "speakerId": 1004,
            "speakerName": "唐娜",
            "text": "嗯…这个我也不能确定。",
            "nextDialogs": [
              "4640419"
            ]
          },
          "4640419": {
            "id": "4640419",
            "speakerId": 1004,
            "speakerName": "唐娜",
            "text": "又或者…是命中注定的人？",
            "nextDialogs": [
              "4640420"
            ]
          },
          "4640420": {
            "id": "4640420",
            "speakerId": 1004,
            "speakerName": "唐娜",
            "text": "就像那种…命中注定的两人一见如故…"
          }
        }
      }
    },
    {
      "subId": "46405",
      "subQuestName": "在夜晚的蒙德转转（18点~6点）",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "4640501"
        ],
        "dialogs": {
          "4640501": {
            "id": "4640501",
            "speakerId": 1005,
            "speakerName": "迪卢克",
            "text": "尽管绕开了卫兵的巡逻路线…却没想到，会在这里撞上你们。",
            "nextDialogs": [
              "4640504"
            ]
          },
          "4640504": {
            "id": "4640504",
            "speakerId": 1005,
            "speakerName": "迪卢克",
            "text": "「暗夜英雄」？…这种俗套到不行的名字，难道是你起的？",
            "nextDialogs": [
              "4640505"
            ]
          },
          "4640505": {
            "id": "4640505",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "咦？你自己居然没听说过吗？整个蒙德都在谈论「暗夜英雄」呢！",
            "nextDialogs": [
              "4640506"
            ]
          },
          "4640506": {
            "id": "4640506",
            "speakerId": 1005,
            "speakerName": "迪卢克",
            "text": "无聊的传言…也罢，算是和平的证明吧。",
            "nextDialogs": [
              "4640507"
            ]
          },
          "4640507": {
            "id": "4640507",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "嘿嘿~这下「暗夜英雄」之谜终于解开啦！",
            "nextDialogs": [
              "4640508"
            ]
          },
          "4640508": {
            "id": "4640508",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "所以说，「暗夜英雄」先生…",
            "nextDialogs": [
              "4640509"
            ]
          },
          "4640509": {
            "id": "4640509",
            "speakerId": 1005,
            "speakerName": "迪卢克",
            "text": "…好了，别用那个名字叫我了，感觉很不自在。",
            "nextDialogs": [
              "4640510"
            ]
          },
          "4640510": {
            "id": "4640510",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "没错。「暗夜英雄」太土了！应该换一个更充满罗曼蒂克气息的称号。",
            "nextDialogs": [
              "4640552"
            ]
          },
          "4640552": {
            "id": "4640552",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "嗯…嗯……",
            "nextDialogs": [
              "4640553"
            ]
          },
          "4640553": {
            "id": "4640553",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "正…",
            "nextDialogs": [
              "4640554"
            ]
          },
          "4640554": {
            "id": "4640554",
            "speakerId": 1005,
            "speakerName": "迪卢克",
            "text": "正？",
            "nextDialogs": [
              "4640555"
            ]
          },
          "4640555": {
            "id": "4640555",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "正？",
            "nextDialogs": [
              "4640556"
            ]
          },
          "4640556": {
            "id": "4640556",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "「正，义，人」！",
            "nextDialogs": [
              "4640557"
            ]
          },
          "4640557": {
            "id": "4640557",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "「正义人」先生，刚才究竟发生了什么呢？",
            "nextDialogs": [
              "4640511"
            ]
          },
          "4640511": {
            "id": "4640511",
            "speakerId": 1005,
            "speakerName": "迪卢克",
            "text": "……",
            "nextDialogs": [
              "4640512"
            ]
          },
          "4640512": {
            "id": "4640512",
            "speakerId": 1005,
            "speakerName": "迪卢克",
            "text": "…是深渊教团。",
            "nextDialogs": [
              "4640513"
            ]
          },
          "4640513": {
            "id": "4640513",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "又是他们？",
            "nextDialogs": [
              "4640514"
            ]
          },
          "4640514": {
            "id": "4640514",
            "speakerId": 1005,
            "speakerName": "迪卢克",
            "text": "不知最近又在盘算些什么鬼主意，像是在做前期侦察的样子。",
            "nextDialogs": [
              "4640515"
            ]
          },
          "4640515": {
            "id": "4640515",
            "speakerId": 1005,
            "speakerName": "迪卢克",
            "text": "明明这段时间，他们的小动作已经被我识破很多次了…居然还不放弃。"
          }
        }
      }
    },

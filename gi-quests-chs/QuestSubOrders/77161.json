      }
    },
    {
      "subId": "7716108",
      "subQuestName": "(test)隐藏$HIDDEN",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "771611501"
        ],
        "dialogs": {
          "771611501": {
            "id": "771611501",
            "speakerId": 1002,
            "speakerName": "扎尔卡娅",
            "text": "咦，二位把这个「艺术品」做出来了啊。太好了，这是说好的酬劳，请收下。",
            "nextDialogs": [
              "771611502"
            ]
          },
          "771611502": {
            "id": "771611502",
            "speakerId": 1002,
            "speakerName": "扎尔卡娅",
            "text": "镇上还有些别的设计师，大概也在被「艺术」困扰。你们要是还想赚点外快，可以到处再看看。"
          }
        }
      }
    },
    {
      "subId": "7716110",
      "subQuestName": "(test)隐藏$HIDDEN",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "771610801"
        ],
        "dialogs": {
          "771610801": {
            "id": "771610801",
            "speakerId": 1003,
            "speakerName": "亚日娜",
            "text": "什、什么，你们竟然真的知道什么是「秩序感」！",
            "nextDialogs": [
              "771610802"
            ]
          },
          "771610802": {
            "id": "771610802",
            "speakerId": 1003,
            "speakerName": "亚日娜",
            "text": "好吧，愿赌服输。唉，看来，在这彩冰镇上，具备大师素养的人不只有我一个。"
          }
        }
      }
    },
    {

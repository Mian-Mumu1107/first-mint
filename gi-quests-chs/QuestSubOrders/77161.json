            "id": "771610301",
            "speakerId": 1000,
            "speakerName": "马列维奇",
            "text": "哦…不敢置信，这正是大师之作的样子。真是帮了大忙了。这是我的小小心意，请两位收下…"
          }
        }
      }
    },
    {
      "subId": "7716106",
      "subQuestName": "(test)隐藏$HIDDEN",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [],

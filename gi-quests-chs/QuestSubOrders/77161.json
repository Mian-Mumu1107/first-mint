{
  "lineCounts": {
    "<UNKNOWN>": 2,
    "Player": 36,
    "亚日娜": 48,
    "扎尔卡娅": 38,
    "派蒙": 14,
    "马列维奇": 50
  },
  "subQuests": [
    {
      "subId": "7716105",
      "subQuestName": "(test)隐藏$HIDDEN",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "771610101"
        ],
        "dialogs": {
          "771610101": {
            "id": "771610101",
            "speakerId": 1000,
            "speakerName": "马列维奇",
            "text": "这可糟了…大师的作品只用到了三块臻冰，而我却需要用五块才能勉强做出接近要求的形状…",
            "nextDialogs": [
              "771610102"
            ]
          },
          "771610102": {
            "id": "771610102",
            "speakerId": 1000,
            "speakerName": "马列维奇",
            "text": "唉，如果有人能帮我一起想想就好了…",
            "nextDialogs": [
              "771610103"
            ]
          },
          "771610103": {
            "id": "771610103",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "大师？",
            "nextDialogs": [
              "771610104"
            ]
          },
          "771610104": {
            "id": "771610104",
            "speakerId": 1000,
            "speakerName": "马列维奇",
            "text": "#是的，大师。哦…您好，尊敬的{M#先生}{F#女士}，哦…还有这位会飞的小姐。",
            "nextDialogs": [
              "771610105"
            ]
          },
          "771610105": {
            "id": "771610105",
            "speakerId": 1000,
            "speakerName": "马列维奇",
            "text": "您二位…莫非也听说过那位艺术家、那位被人誉为大师的卡西米尔·拉里奥诺夫吗？",
            "nextDialogs": [
              "771610107",
              "771610110"
            ]
          },
          "771610107": {
            "id": "771610107",
            "speakerId": 1000,
            "speakerName": "马列维奇",
            "text": "哦…二位看上去不太像彩冰镇人呢，或许不那么关注彩冰镇出身的艺术家，情有可原，情有可原。",
            "nextDialogs": [
              "771610108"
            ]
          },
          "771610108": {
            "id": "771610108",
            "speakerId": 1000,
            "speakerName": "马列维奇",
            "text": "他是一个有名的艺术大师，是「开创至冬先锋艺术的划时代大师」、「臻冰美学之父」，「冰星果派雕塑家唯一代表」。",
            "nextDialogs": [
              "771610112"
            ]
          },
          "771610112": {
            "id": "771610112",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "「冰星果派」？这个听起来还蛮好吃的，嘿嘿。",
            "nextDialogs": [
              "771610113"
            ]
          },
          "771610113": {
            "id": "771610113",
            "speakerId": 1000,
            "speakerName": "马列维奇",
            "text": "「冰星果派」可不是食物，会飞的小姐。唔，至冬堡的上流人会怎么说呢…哦，他们会说这是一种「艺术风格」。",
            "nextDialogs": [
              "771610114"
            ]
          },
          "771610114": {
            "id": "771610114",
            "speakerId": 1000,
            "speakerName": "马列维奇",
            "text": "最重要的是，他是从我们彩冰镇出来的！我们这小地方，也出了个「划时代大师」呢，真是令人骄傲啊…",
            "nextDialogs": [
              "771610115"
            ]
          },
          "771610115": {
            "id": "771610115",
            "speakerId": 1000,
            "speakerName": "马列维奇",
            "text": "据说大师出身平凡，家里也不富裕，没受过什么教育，年轻的时候，就在镇子上出些力气，拿采冰当活计…和我差不多。",
            "nextDialogs": [
              "771610116"
            ]
          },
          "771610116": {
            "id": "771610116",
            "speakerId": 1000,
            "speakerName": "马列维奇",
            "text": "可他没一辈子这样。他做了些漂亮的臻冰雕塑。后来…后来就被人发现，成了艺术家，从此离开小镇，去至冬堡做了上流人…",
            "nextDialogs": [
              "771610117"
            ]
          },
          "771610117": {
            "id": "771610117",
            "speakerId": 1000,
            "speakerName": "马列维奇",
            "text": "#我喜欢这个故事，尊敬的{M#先生}{F#女士}，还有会飞的小姐。这就是为什么我马列维奇最后也决定做这个行当…"
          },
          "771610110": {
            "id": "771610110",
            "speakerId": 1000,
            "speakerName": "马列维奇",
            "text": "当然，当然！哦，二位看上去不太像彩冰镇人呢，或许不那么关注彩冰镇出身的艺术家，也不太了解他的知名度…",
            "nextDialogs": [
              "771610111"
            ]
          },
          "771610111": {
            "id": "771610111",
            "speakerId": 1000,
            "speakerName": "马列维奇",
            "text": "人们都说他是「开创至冬先锋艺术的划时代大师」、「臻冰美学之父」，「冰星果派雕塑家唯一代表」。"
          }
        }
      }
    },
    {
      "subId": "7716107",
      "subQuestName": "(test)隐藏$HIDDEN",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "771610401"
        ],
        "dialogs": {
          "771610401": {
            "id": "771610401",
            "speakerId": 1002,
            "speakerName": "扎尔卡娅",
            "text": "艺术展的订单总是这样麻烦。他们最擅长的事，无非就是让简单的事变复杂。",
            "nextDialogs": [
              "771610402"
            ]
          },
          "771610402": {
            "id": "771610402",
            "speakerId": 1002,
            "speakerName": "扎尔卡娅",
            "text": "说实在的，如果有人能帮我把这订单做了，我愿意将所有关于臻冰艺术的职业荣誉相让。",
            "nextDialogs": [
              "771610403"
            ]
          },
          "771610403": {
            "id": "771610403",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "你怎么了？",
            "nextDialogs": [
              "771610404"
            ]
          },
          "771610404": {
            "id": "771610404",
            "speakerId": 1002,
            "speakerName": "扎尔卡娅",
            "text": "我？如您所见，我正为这名为「艺术」的廉价劳动所困。",
            "nextDialogs": [
              "771610405"
            ]
          },
          "771610405": {
            "id": "771610405",
            "speakerId": 1002,
            "speakerName": "扎尔卡娅",
            "text": "我手上有份来自至冬堡大师艺术展的雕塑订单。向来如此——至冬堡的订单报价低、难度大，还不能拒绝，所以他们交给我。",
            "nextDialogs": [
              "771610406"
            ]
          },
          "771610406": {
            "id": "771610406",
            "speakerId": 1002,
            "speakerName": "扎尔卡娅",
            "text": "如果我推辞，他们就会说：「扎尔卡娅，这是只有艺术家级别的设计师才能完成的作品，除了你我们谁都不放心」。",
            "nextDialogs": [
              "771610407"
            ]
          },
          "771610407": {
            "id": "771610407",
            "speakerId": 1002,
            "speakerName": "扎尔卡娅",
            "text": "艺术家？这么多年，我早想清楚了：雕刻臻冰只是一份工作，所以我情愿他们把我视作「万千平凡设计师之一」。您知道为什么吗？",
            "nextDialogs": [
              "771610408"
            ]
          },
          "771610408": {
            "id": "771610408",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "为什么？",
            "nextDialogs": [
              "771610409"
            ]
          },
          "771610409": {
            "id": "771610409",
            "speakerId": 1002,
            "speakerName": "扎尔卡娅",
            "text": "因为光是思考这种「艺术品」的基本构造…像这类事情花掉的时间，就足以让我完成五份不艺术的、但能给到同等报酬的订单了。",
            "nextDialogs": [
              "771610410"
            ]
          },
          "771610410": {
            "id": "771610410",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "听起来很亏的样子！",
            "nextDialogs": [
              "771610411"
            ]
          },
          "771610411": {
            "id": "771610411",
            "speakerId": 1002,
            "speakerName": "扎尔卡娅",
            "text": "不错，每当接到这样的订单，那句流传在臻冰设计师中的箴言就会在我的脑海里回响：「艺术还是吃饱，这是个问题。」",
            "nextDialogs": [
              "771610412"
            ]
          },
          "771610412": {
            "id": "771610412",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "派蒙会选吃饱吧。",
            "nextDialogs": [
              "771610414"
            ]
          },
          "771610414": {
            "id": "771610414",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "选艺术也不错。",
            "nextDialogs": [
              "771610415"
            ]
          },
          "771610415": {
            "id": "771610415",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "也不错！不过我们首先得在别的地方赚够摩拉。",
            "nextDialogs": [
              "771610416"
            ]
          },
          "771610416": {
            "id": "771610416",
            "speakerId": 1002,
            "speakerName": "扎尔卡娅",
            "text": "哦？既然如此，我倒是有一个提议——",
            "nextDialogs": [
              "771610417"
            ]
          },
          "771610417": {
            "id": "771610417",
            "speakerId": 1002,
            "speakerName": "扎尔卡娅",
            "text": "二位如果能帮我摆好下一块臻冰，我愿将这份订单的一半工钱拱手相让——连同「艺术家级别的设计师」这个称号。",
            "nextDialogs": [
              "771610418"
            ]
          },
          "771610418": {
            "id": "771610418",
            "speakerId": 1002,
            "speakerName": "扎尔卡娅",
            "text": "也就是说，二位如果愿意钻研「艺术」，帮我完成订单，就能能获得我提供的物质酬劳，以及获得大量精神回报。",
            "nextDialogs": [
              "771610419"
            ]
          },
          "771610419": {
            "id": "771610419",
            "speakerId": 1002,
            "speakerName": "扎尔卡娅",
            "text": "而我趁这个余裕解决其他工作，好真正填饱我的肚子。",
            "nextDialogs": [
              "771610420"
            ]
          },
          "771610420": {
            "id": "771610420",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "#哇！有物质酬劳呢，{NICKNAME}…",
            "nextDialogs": [
              "771610421"
            ]
          },
          "771610421": {
            "id": "771610421",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "我们恰好对「艺术」有些见地。",
            "nextDialogs": [
              "771610422"
            ]
          },
          "771610422": {
            "id": "771610422",
            "speakerId": 1002,
            "speakerName": "扎尔卡娅",
            "text": "太好了——那么这份工作交给你们正合适。",
            "nextDialogs": [
              "771610423"
            ]
          },
          "771610423": {
            "id": "771610423",
            "speakerId": 1002,
            "speakerName": "扎尔卡娅",
            "text": "根据订单要求，应该还要往这雕塑上再加一块臻冰。二位不妨看看示意图，有想法后直接动手就行。"
          }
        }
      }
    },
    {
      "subId": "7716109",
      "subQuestName": "(test)隐藏$HIDDEN",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "771610701"
        ],
        "dialogs": {
          "771610701": {
            "id": "771610701",
            "speakerId": 1003,
            "speakerName": "亚日娜",
            "text": "什么大师之作，哈！至冬堡的审美水平真是连年下降。这订单上的作品，竟然没有一个具有「秩序感」。",
            "nextDialogs": [
              "771610702"
            ]
          },
          "771610702": {
            "id": "771610702",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "「秩序感」？",
            "nextDialogs": [
              "771610703"
            ]
          },
          "771610703": {
            "id": "771610703",
            "speakerId": 1003,
            "speakerName": "亚日娜",
            "text": "对，「秩序感」，这是时代、是至冬臻冰艺术历经多年沉淀以后，给我们的最终审美答案。",
            "nextDialogs": [
              "771610704"
            ]
          },
          "771610704": {
            "id": "771610704",
            "speakerId": 1003,
            "speakerName": "亚日娜",
            "text": "想当年，我还在至冬堡艺术学校进修。那时，谁的作品里要是没有「秩序感」，一定会遭人耻笑。",
            "nextDialogs": [
              "771610705"
            ]
          },
          "771610705": {
            "id": "771610705",
            "speakerId": 1003,
            "speakerName": "亚日娜",
            "text": "真让人怀念啊！你知道吗，那是一个完全的艺术圣地，在那样的地方，天才和天才惺惺相惜。再看看这庸常的彩冰镇，唉…",
            "nextDialogs": [
              "771610706"
            ]
          },
          "771610706": {
            "id": "771610706",
            "speakerId": 1003,
            "speakerName": "亚日娜",
            "text": "说远了。反正我得告诉你，我到底遇上了一个多大的笑话。",
            "nextDialogs": [
              "771610707"
            ]
          },
          "771610707": {
            "id": "771610707",
            "speakerId": 1003,
            "speakerName": "亚日娜",
            "text": "我们这次收到了至冬堡的艺术展雕塑订单。可打开订单示意图一看，上面竟然全是一些失衡的无纪律之作！",
            "nextDialogs": [
              "771610708"
            ]
          },
          "771610708": {
            "id": "771610708",
            "speakerId": 1003,
            "speakerName": "亚日娜",
            "text": "全是倾斜，全是情绪化的切削！这些雕塑的语言根本是对自然的拙劣模仿，用以掩饰结构伦理与冰塑道德上的失败！",
            "nextDialogs": [
              "771610709"
            ]
          },
          "771610709": {
            "id": "771610709",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "呃…她说话好怪，我好像一句也听不懂。",
            "nextDialogs": [
              "771610711"
            ]
          },
          "771610711": {
            "id": "771610711",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "想学也学不会吧！",
            "nextDialogs": [
              "771610713"
            ]
          },
          "771610713": {
            "id": "771610713",
            "speakerId": 1003,
            "speakerName": "亚日娜",
            "text": "没关系，你们无需为此自惭形秽。毕竟，不是每个人都有条件赴至冬堡深造，也不是谁都能和圈子里的大人物们谈笑往来。",
            "nextDialogs": [
              "771610714"
            ]
          },
          "771610714": {
            "id": "771610714",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "哇，怎么回事，这个人好像还挺骄傲的！",
            "nextDialogs": [
              "771610715"
            ]
          },
          "771610715": {
            "id": "771610715",
            "speakerId": 1003,
            "speakerName": "亚日娜",
            "text": "骄傲？那是自然！我亚日娜既然被镇民们称为「未来的」大师，就应当有大师的骄傲与心气，更要有大师说话的深度。",
            "nextDialogs": [
              "771610716"
            ]
          },
          "771610716": {
            "id": "771610716",
            "speakerId": 1003,
            "speakerName": "亚日娜",
            "text": "嗯，反正！看在你们如此诚恳、谦逊，有自知之明的份上，我就简单为你们解释一下吧。",
            "nextDialogs": [
              "771610717"
            ]
          },
          "771610717": {
            "id": "771610717",
            "speakerId": 1003,
            "speakerName": "亚日娜",
            "text": "依照惯例，至冬堡每次举办大型臻冰雕塑艺术展，订单都会被送到彩冰镇，这次也不例外。",
            "nextDialogs": [
              "771610718"
            ]
          },
          "771610718": {
            "id": "771610718",
            "speakerId": 1003,
            "speakerName": "亚日娜",
            "text": "而此次艺术展的主题是「经典再冻结：冰星果派大师作品（复刻）特展」。",
            "nextDialogs": [
              "771610719"
            ]
          },
          "771610719": {
            "id": "771610719",
            "speakerId": 1003,
            "speakerName": "亚日娜",
            "text": "也就是说，作为臻冰设计师，我们被要求复刻那位冰星果派的什么拉、拉里奥诺夫的作品。",
            "nextDialogs": [
              "771610720"
            ]
          },
          "771610720": {
            "id": "771610720",
            "speakerId": 1003,
            "speakerName": "亚日娜",
            "text": "可是，多么令人失望啊！你一看订单就知道了。那些作品里没有一个真正对称的！就算相似，左右的臻冰数量也完全不一致。",
            "nextDialogs": [
              "771610721"
            ]
          },
          "771610721": {
            "id": "771610721",
            "speakerId": 1003,
            "speakerName": "亚日娜",
            "text": "这就是大师吗？要我看，若非此人在技术上有先天不足，便是他被时代所限，完全不懂得「秩序感」才是臻冰美学的永恒尺度！",
            "nextDialogs": [
              "771610722"
            ]
          },
          "771610722": {
            "id": "771610722",
            "speakerId": 1003,
            "speakerName": "亚日娜",
            "text": "还好他们把订单发到我亚日娜手里了。作为一个在至冬堡进修过的艺术创作者，我始终都在用大师水平进行自我要求。",
            "nextDialogs": [
              "771610723"
            ]
          },
          "771610723": {
            "id": "771610723",
            "speakerId": 1003,
            "speakerName": "亚日娜",
            "text": "正因如此，我不能让我、也不能让臻冰雕塑这门艺术的名誉受到一点损害。",
            "nextDialogs": [
              "771610724"
            ]
          },
          "771610724": {
            "id": "771610724",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "所以？",
            "nextDialogs": [
              "771610725"
            ]
          },
          "771610725": {
            "id": "771610725",
            "speakerId": 1003,
            "speakerName": "亚日娜",
            "text": "所以，我纠正了那个拉什么，哦，拉里奥诺夫，我纠正了他作品中所有背离秩序道德的部分，恢复了严谨的轴性结构伦理。",
            "nextDialogs": [
              "771610726"
            ]
          },
          "771610726": {
            "id": "771610726",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "又开始了！我又听不懂了。",
            "nextDialogs": [
              "771610727"
            ]
          },
          "771610727": {
            "id": "771610727",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "意思是她把所有作品都变成对称了。",
            "nextDialogs": [
              "771610728"
            ]
          },
          "771610728": {
            "id": "771610728",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "欸？这也可以吗！",
            "nextDialogs": [
              "771610729"
            ]
          },
          "771610729": {
            "id": "771610729",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "怎么感觉…这好像只是她自己的审美吧？",
            "nextDialogs": [
              "771610730"
            ]
          },
          "771610730": {
            "id": "771610730",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "在至冬待了这么久，从来没听过这个叫「秩序感」的标准呢。",
            "nextDialogs": [
              "771610731"
            ]
          },
          "771610731": {
            "id": "771610731",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "也可能是因为这个标准已经过时了。",
            "nextDialogs": [
              "771610732"
            ]
          },
          "771610732": {
            "id": "771610732",
            "speakerId": 1003,
            "speakerName": "亚日娜",
            "text": "哈！等等，你们说这种话，我可有些不爱听。",
            "nextDialogs": [
              "771610733"
            ]
          },
          "771610733": {
            "id": "771610733",
            "speakerId": 1003,
            "speakerName": "亚日娜",
            "text": "你们两个，难道也曾经在至冬堡的艺术学校进修过吗？你们对至冬堡艺术圈内部的事情，又知道多少呢？",
            "nextDialogs": [
              "771610734"
            ]
          },
          "771610734": {
            "id": "771610734",
            "speakerId": 1003,
            "speakerName": "亚日娜",
            "text": "如果要对我的观念进行批评，你们起码、起码首先要向我证明自己懂得何为「秩序感」！",
            "nextDialogs": [
              "771610735"
            ]
          },
          "771610735": {
            "id": "771610735",
            "speakerId": 1003,
            "speakerName": "亚日娜",
            "text": "我打赌，你们根本不懂得我的苦心！哎，正巧…这还有个没有完成的订单。",
            "nextDialogs": [
              "771610736"
            ]
          },
          "771610736": {
            "id": "771610736",
            "speakerId": 1003,
            "speakerName": "亚日娜",
            "text": "打个赌吧！你们要是能为这订单赋予「秩序感」，就算我亚日娜输了。赌注，唔，就是这订单的一半报酬！",
            "nextDialogs": [
              "771610737"
            ]
          },
          "771610737": {
            "id": "771610737",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "#呜哇，这个人不会生气了吧…{NICKNAME}，我们要和她打赌吗？",
            "nextDialogs": [
              "771610738"
            ]
          },
          "771610738": {
            "id": "771610738",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "订单一半的报酬喔…",
            "nextDialogs": [
              "771610739"
            ]
          },
          "771610739": {
            "id": "771610739",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "哼哼，我知道啦。那就让她见识见识我们的厉害！"
          }
        }
      }
    },

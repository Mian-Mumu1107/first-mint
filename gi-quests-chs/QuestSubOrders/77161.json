    {
      "subId": "7716106",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "771610601"
        ],
        "dialogs": {
          "771610601": {
            "id": "771610601",
            "speakerId": 1002,
            "speakerName": "扎尔卡娅",
            "text": "咦，二位把这个「艺术品」做出来了啊。太好了，这是说好的酬劳，请收下。"
          }
        }
      }
    },
    {
      "subId": "7716110",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "771611001"
        ],
        "dialogs": {
          "771611001": {
            "id": "771611001",
            "speakerId": 1000,
            "speakerName": "马列维奇",
            "text": "…大师的道路，果然没有那么好走。哦…是您啊。两位想出办法了吗？",
            "nextDialogs": [
              "771611003",
              "771611005"
            ]
          },
          "771611003": {
            "id": "771611003",
            "speakerId": 1000,
            "speakerName": "马列维奇",
            "text": "订单就在木板上，两位可以随时自行查看。"
          },
          "771611005": {
            "id": "771611005",
            "speakerId": 1000,
            "speakerName": "马列维奇",
            "text": "拜托您了。"
          }
        }
      }
    },
    {
      "subId": "7716111",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "771611101"
        ],
        "dialogs": {
          "771611101": {
            "id": "771611101",
            "speakerId": 1002,
            "speakerName": "扎尔卡娅",
            "text": "「艺术还是吃饱」？这从来不是个问题。哦，二位来了。怎么样，对这「艺术品」有什么头绪吗？",
            "nextDialogs": [
              "771611103",
              "771611105"
            ]
          },
          "771611103": {
            "id": "771611103",
            "speakerId": 1002,
            "speakerName": "扎尔卡娅",
            "text": "在木牌上，请自便。"
          },
          "771611105": {
            "id": "771611105",
            "speakerId": 1002,
            "speakerName": "扎尔卡娅",
            "text": "加油。"
          }
        }
      }
    },
    {
      "subId": "7716112",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "771611201"
        ],
        "dialogs": {
          "771611201": {
            "id": "771611201",
            "speakerId": 1000,
            "speakerName": "马列维奇",
            "text": "哦…不敢置信，这正是大师之作的样子。真是帮了大忙了。这是我的小小心意，请两位收下…",
            "nextDialogs": [
              "771611202"
            ]
          },
          "771611202": {
            "id": "771611202",
            "speakerId": 1000,
            "speakerName": "马列维奇",
            "text": "镇上还有些别的设计师，他们也在为各自的订单苦恼，您若是还有余裕，也可以四处瞧瞧…"
          }
        }
      }
    },
    {
      "subId": "7716113",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "771611301"
        ],
        "dialogs": {
          "771611301": {
            "id": "771611301",
            "speakerId": 1000,
            "speakerName": "马列维奇",
            "text": "我离大师是不是又近了一步呢…哦，是您！有什么事吗？",
            "nextDialogs": [
              "771611303",
              "771611311",
              "771611315"
            ]
          },
          "771611303": {
            "id": "771611303",
            "speakerId": 1000,
            "speakerName": "马列维奇",
            "text": "卡西米尔·拉里奥诺夫大师？这可是我们彩冰镇的骄傲。他原是镇上一名最普通不过的采冰工人，从没有接受过像样的艺术教育…",
            "nextDialogs": [
              "771611304"
            ]
          },
          "771611304": {
            "id": "771611304",
            "speakerId": 1000,
            "speakerName": "马列维奇",
            "text": "可艺术从来不看出身。据闻，当年他由于忍受不了臻冰作品的…哦，好像是什么…「美感」的缺失？",
            "nextDialogs": [
              "771611305"
            ]
          },
          "771611305": {
            "id": "771611305",
            "speakerId": 1000,
            "speakerName": "马列维奇",
            "text": "总之，报纸上说，在一次酒醉之后，大师把镇上所有的臻冰雕塑都动手改成了冰星果的模样。",
            "nextDialogs": [
              "771611306"
            ]
          },
          "771611306": {
            "id": "771611306",
            "speakerId": 1000,
            "speakerName": "马列维奇",
            "text": "「这些作品以粗犷的技法抹去了细节，一改往日臻冰雕塑的写实性，一送到至冬堡，就引起了当时主流艺术界的巨大轰动——」",
            "nextDialogs": [
              "771611307"
            ]
          },
          "771611307": {
            "id": "771611307",
            "speakerId": 1000,
            "speakerName": "马列维奇",
            "text": "「先锋！」「如同冰星果一般自然！」「重塑臻冰语言与现实的关系！」",
            "nextDialogs": [
              "771611308"
            ]
          },
          "771611308": {
            "id": "771611308",
            "speakerId": 1000,
            "speakerName": "马列维奇",
            "text": "啊，这样的评论…也都是我从报纸上读来的。虽然不知道是什么意思，但我估摸着都是好话。",
            "nextDialogs": [
              "771611309"
            ]
          },
          "771611309": {
            "id": "771611309",
            "speakerId": 1000,
            "speakerName": "马列维奇",
            "text": "要是哪天能被这样评论，就说明我也是一个大艺术家了。所以，我一定要努力模仿大师，成为艺术家，以后名扬至冬…"
          },
          "771611311": {
            "id": "771611311",
            "speakerId": 1000,
            "speakerName": "马列维奇",
            "text": "哦…这可是由皇都评议会组织的，了不得的大型艺术展。",
            "nextDialogs": [
              "771611312"
            ]
          },
          "771611312": {
            "id": "771611312",
            "speakerId": 1000,
            "speakerName": "马列维奇",
            "text": "对臻冰设计师来说，这也是难得的机会。我们根据订单做出来的雕塑，会在这个艺术展上展出…到时候会有很多人去看。",
            "nextDialogs": [
              "771611313"
            ]
          },
          "771611313": {
            "id": "771611313",
            "speakerId": 1000,
            "speakerName": "马列维奇",
            "text": "虽然至今没有机会前往至冬堡，但只要一想到自己的作品这次可能会被艺术界看到，我的心就像燃烧的克什尼克之炬一样火热…"
          },
          "771611315": {
            "id": "771611315",
            "speakerId": 1000,
            "speakerName": "马列维奇",
            "text": "您慢走！"
          }
        }
      }
    },
    {
      "subId": "7716114",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "771611401"
        ],
        "dialogs": {
          "771611401": {
            "id": "771611401",
            "speakerId": 1003,
            "speakerName": "亚日娜",
            "text": "怎么，你们要放弃这个赌约吗？",
            "nextDialogs": [
              "771611402"
            ]
          },
          "771611402": {
            "id": "771611402",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "当然不。",
            "nextDialogs": [
              "771611403"
            ]
          },
          "771611403": {
            "id": "771611403",
            "speakerId": 1003,
            "speakerName": "亚日娜",
            "text": "那我静候佳音。"
          }
        }
      }
    },
    {
      "subId": "7716116",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "771611601"
        ],
        "dialogs": {
          "771611601": {
            "id": "771611601",
            "speakerId": 1002,
            "speakerName": "扎尔卡娅",
            "text": "「艺术还是吃饱」？这种问题还需要思考吗。哦，是您，有什么事吗？",
            "nextDialogs": [
              "771611603",
              "771611611",
              "771611618",
              "771611622"
            ]
          },
          "771611603": {
            "id": "771611603",
            "speakerId": 1002,
            "speakerName": "扎尔卡娅",
            "text": "我是臻冰设计师，有时候也被人称为臻冰雕塑艺术家。",
            "nextDialogs": [
              "771611604"
            ]
          },
          "771611604": {
            "id": "771611604",
            "speakerId": 1002,
            "speakerName": "扎尔卡娅",
            "text": "不过，我们的实际工作只是是把采冰工人的劳动成果加工，增添一点附加的装饰价值，好让这东西变成个商品。",
            "nextDialogs": [
              "771611605"
            ]
          },
          "771611605": {
            "id": "771611605",
            "speakerId": 1002,
            "speakerName": "扎尔卡娅",
            "text": "说真的，这就是彩冰镇上最普通的工作之一，至少在我看来如此。",
            "nextDialogs": [
              "771611606"
            ]
          },
          "771611606": {
            "id": "771611606",
            "speakerId": 1002,
            "speakerName": "扎尔卡娅",
            "text": "但鉴于我们的工作依赖「手工」，还带了点「设计」的成分，不知道从哪天开始，就被当成是「艺术创作」了。",
            "nextDialogs": [
              "771611607"
            ]
          },
          "771611607": {
            "id": "771611607",
            "speakerId": 1002,
            "speakerName": "扎尔卡娅",
            "text": "任何东西一旦被包装成艺术，人们就会趋之若鹜。如果再加上一些概念、流派，以及关于品位的套话——",
            "nextDialogs": [
              "771611608"
            ]
          },
          "771611608": {
            "id": "771611608",
            "speakerId": 1002,
            "speakerName": "扎尔卡娅",
            "text": "啊，至冬堡的市民们最吃这一套。",
            "nextDialogs": [
              "771611609"
            ]
          },
          "771611609": {
            "id": "771611609",
            "speakerId": 1002,
            "speakerName": "扎尔卡娅",
            "text": "当然，我对此没有任何意见，只要这能给我们带来更多的酬劳。前提是：只要他们不会真的用「艺术家」的要求来要求我。"
          },
          "771611611": {
            "id": "771611611",
            "speakerId": 1002,
            "speakerName": "扎尔卡娅",
            "text": "您对这个感兴趣？报纸上应该有些官方介绍，您只需要在读报时抛开那些赞美市政的老话——",
            "nextDialogs": [
              "771611612"
            ]
          },
          "771611612": {
            "id": "771611612",
            "speakerId": 1002,
            "speakerName": "扎尔卡娅",
            "text": "不对，那好像确实没剩下什么有价值的信息了。好吧，那我给您讲讲。",
            "nextDialogs": [
              "771611613"
            ]
          },
          "771611613": {
            "id": "771611613",
            "speakerId": 1002,
            "speakerName": "扎尔卡娅",
            "text": "总的来说，这是至冬堡评议员想出来的点子：通过举办臻冰雕塑主题艺术展，丰富市民的精神生活，顺便带动带动旅游业。",
            "nextDialogs": [
              "771611614"
            ]
          },
          "771611614": {
            "id": "771611614",
            "speakerId": 1002,
            "speakerName": "扎尔卡娅",
            "text": "这次的主题是所谓的「经典再冻结：冰星果派大师作品（复刻）特展」。简单来说，就是展出一些大师之作的复制品。",
            "nextDialogs": [
              "771611615"
            ]
          },
          "771611615": {
            "id": "771611615",
            "speakerId": 1002,
            "speakerName": "扎尔卡娅",
            "text": "您也许会疑惑，究竟有谁会对复制品感兴趣呢？但评议会的老爷们不这么想。",
            "nextDialogs": [
              "771611616"
            ]
          },
          "771611616": {
            "id": "771611616",
            "speakerId": 1002,
            "speakerName": "扎尔卡娅",
            "text": "给老百姓们一个机会，让大家从复制品中自行领略高雅艺术的灵光——在他们看来，这件事本身就已经是莫大的仁慈了。"
          },
          "771611618": {
            "id": "771611618",
            "speakerId": 1002,
            "speakerName": "扎尔卡娅",
            "text": "您说「冰星果派大师」吗？",
            "nextDialogs": [
              "771611619"
            ]
          },
          "771611619": {
            "id": "771611619",
            "speakerId": 1002,
            "speakerName": "扎尔卡娅",
            "text": "是个叫拉里奥诺夫的雕塑家。有人说他是彩冰镇出身的平民天才——马列维奇是这么坚持的。但我觉得这可能是虚构。",
            "nextDialogs": [
              "771611620"
            ]
          },
          "771611620": {
            "id": "771611620",
            "speakerId": 1002,
            "speakerName": "扎尔卡娅",
            "text": "毕竟据我所知，彩冰镇的历史上，从来就没有拉奥里诺夫这个人。"
          },
          "771611622": {
            "id": "771611622",
            "speakerId": 1002,
            "speakerName": "扎尔卡娅",
            "text": "回见。"
          }
        }
      }
    },
    {
      "subId": "7716118",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "771611801"
        ],
        "dialogs": {
          "771611801": {
            "id": "771611801",
            "speakerId": 1003,
            "speakerName": "亚日娜",
            "text": "什、什么，你们竟然真的知道什么是「秩序感」！",
            "nextDialogs": [
              "771611802"
            ]
          },
          "771611802": {
            "id": "771611802",
            "speakerId": 1003,
            "speakerName": "亚日娜",
            "text": "好吧，愿赌服输。唉…看来，在这彩冰镇上，具备大师素养的人不只有我一个。",
            "nextDialogs": [
              "771611803"
            ]
          },
          "771611803": {
            "id": "771611803",
            "speakerId": 1003,
            "speakerName": "亚日娜",
            "text": "要我说，你们真应该去镇上教教其他设计师。他们要么只会模仿，要么根本不在乎艺术，多半都陷入了不能交付的困境…"
          }
        }
      }
    },
    {
      "subId": "7716119",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "771611901"
        ],
        "dialogs": {
          "771611901": {
            "id": "771611901",
            "speakerId": 1003,
            "speakerName": "亚日娜",
            "text": "没有秩序的艺术不成为艺术…哦，是你们两个。你们还有何见教？",
            "nextDialogs": [
              "771611903",
              "771611910",
              "771611917"
            ]
          },
          "771611903": {
            "id": "771611903",
            "speakerId": 1003,
            "speakerName": "亚日娜",
            "text": "这个嘛，不知道从哪天开始，镇上的设计师就都这么喊我了。",
            "nextDialogs": [
              "771611904"
            ]
          },
          "771611904": {
            "id": "771611904",
            "speakerId": 1003,
            "speakerName": "亚日娜",
            "text": "我想，大概是因为我在至冬堡的艺术学校进修过，不论是审美观念，还是雕塑水平，都明显胜过他们这些普通设计师吧？",
            "nextDialogs": [
              "771611905"
            ]
          },
          "771611905": {
            "id": "771611905",
            "speakerId": 1003,
            "speakerName": "亚日娜",
            "text": "我也帮了他们很多忙。比如镇上那个马列维奇，我早跟他说过了，要想混至冬艺术圈，模仿是没有出路的，可惜他听不懂。",
            "nextDialogs": [
              "771611906"
            ]
          },
          "771611906": {
            "id": "771611906",
            "speakerId": 1003,
            "speakerName": "亚日娜",
            "text": "还有扎尔卡娅，其实她是有水平的，只是可惜没在至冬堡进修过，接单子的眼光不行。我提点过她好几次，让她多接艺术单。",
            "nextDialogs": [
              "771611907"
            ]
          },
          "771611907": {
            "id": "771611907",
            "speakerId": 1003,
            "speakerName": "亚日娜",
            "text": "说真的，这种大师级别的建议，放到以前，彩冰镇上根本没人能提得出来！",
            "nextDialogs": [
              "771611908"
            ]
          },
          "771611908": {
            "id": "771611908",
            "speakerId": 1003,
            "speakerName": "亚日娜",
            "text": "至于为什么是「未来的」…总之，大家都说，以我的水平，名扬至冬在未来是迟早的事！"
          },
          "771611910": {
            "id": "771611910",
            "speakerId": 1003,
            "speakerName": "亚日娜",
            "text": "实话实说，这艺术展已经完全违背了最初的宗旨，说是要令艺术的珍宝荟萃，如今却变成了平庸之作的集会！",
            "nextDialogs": [
              "771611911"
            ]
          },
          "771611911": {
            "id": "771611911",
            "speakerId": 1003,
            "speakerName": "亚日娜",
            "text": "自我离开至冬堡，艺术界的眼光和审美一直在连年下降。唉，今年甚至出了一个什么复刻大师之作的主题。",
            "nextDialogs": [
              "771611912"
            ]
          },
          "771611912": {
            "id": "771611912",
            "speakerId": 1003,
            "speakerName": "亚日娜",
            "text": "他们说是要重现经典，打开订单一看，上面全是过时的东西！",
            "nextDialogs": [
              "771611913"
            ]
          },
          "771611913": {
            "id": "771611913",
            "speakerId": 1003,
            "speakerName": "亚日娜",
            "text": "要知道，经典之所以能成为经典，是因为这些作品本身具有穿越时代、打动人心的能力。",
            "nextDialogs": [
              "771611914"
            ]
          },
          "771611914": {
            "id": "771611914",
            "speakerId": 1003,
            "speakerName": "亚日娜",
            "text": "这拉什么夫，哦，拉里奥诺夫大师，一点秩序之美都不懂，他的作品又怎么会有漫长的生命力呢？",
            "nextDialogs": [
              "771611915"
            ]
          },
          "771611915": {
            "id": "771611915",
            "speakerId": 1003,
            "speakerName": "亚日娜",
            "text": "我看啊，这多半是哪个不懂艺术的家伙制造出来的大师神话，骗骗外行也就罢了。"
          },
          "771611917": {
            "id": "771611917",
            "speakerId": 1003,
            "speakerName": "亚日娜",
            "text": "拉里奥诺夫大师？说起这个人我就来气！他的作品里根本没有「秩序感」，不知道为什么就被冠上了大师的名号。",
            "nextDialogs": [
              "771611918"
            ]
          },
          "771611918": {
            "id": "771611918",
            "speakerId": 1003,
            "speakerName": "亚日娜",
            "text": "我得告诉你，我在至冬堡进修的时候，可从来没有听说过这个名字。",
            "nextDialogs": [
              "771611919"
            ]
          },
          "771611919": {
            "id": "771611919",
            "speakerId": 1003,
            "speakerName": "亚日娜",
            "text": "臻冰雕塑史上真的有这么号人物吗？我现在怀疑，可能是哪些三流设计师卖不出去自己的作品，所以假借了这么个虚构的名号…",
            "nextDialogs": [
              "771611920"
            ]
          },
          "771611920": {
            "id": "771611920",
            "speakerId": 1003,
            "speakerName": "亚日娜",
            "text": "这些粗糙的作品以艺术之名流入大众视野，久而久之，反倒让这个名号变得有名。恰逢这些年，臻冰艺术圈又没有大师出世…",
            "nextDialogs": [
              "771611921"
            ]
          },
          "771611921": {
            "id": "771611921",
            "speakerId": 1003,
            "speakerName": "亚日娜",
            "text": "唉，什么大师，真是审美的堕落，里面全是生意经！"
          }
        }
      }
    }
  ]
}
    {
      "subId": "7506407",
      "subQuestName": "(test)演员请登场",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "750640701"
        ],
        "dialogs": {
          "750640701": {
            "id": "750640701",
            "speakerId": 21586,
            "speakerName": "马尼菲科",
            "text": "去打光吧，我这里没什么需要你帮忙的。",
            "nextDialogs": [
              "750640702"
            ]
          },
          "750640702": {
            "id": "750640702",
            "speakerId": 21586,
            "speakerName": "马尼菲科",
            "text": "<color=#00E1FFFF>照亮它的左侧脸部和后背轮廓！</color>"
          }
        }
      }
    },
    {
      "subId": "7506406",
      "subQuestName": "与马尼菲科对话",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "750640601"
        ],
        "dialogs": {
          "750640601": {
            "id": "750640601",
            "speakerId": 21586,
            "speakerName": "马尼菲科",
            "text": "哈哈，很好！请我们的小模特不要动…真聪明。三、二、一，咔嚓！",
            "nextDialogs": [
              "750640602"
            ]
          },
          "750640602": {
            "id": "750640602",
            "speakerId": 21586,
            "speakerName": "马尼菲科",
            "text": "快看，真是杰作！是谁拍的？是我拍的！是谁拍的？是马尼菲科·德·拉·马尼菲桑斯！",
            "nextDialogs": [
              "750640603"
            ]
          },
          "750640603": {
            "id": "750640603",
            "speakerId": 21586,
            "speakerName": "马尼菲科",
            "text": "谢谢你们，真是太感谢了！哈哈！这里是答应你们的尾款！啊…还有这个，你看。",
            "nextDialogs": [
              "750640604"
            ]
          },
          "750640604": {
            "id": "750640604",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "哇…尾款！",
            "nextDialogs": [
              "750640605"
            ]
          },
          "750640605": {
            "id": "750640605",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "欸？只有一摩拉？",
            "nextDialogs": [
              "750640606"
            ]
          },
          "750640606": {
            "id": "750640606",
            "speakerId": 21586,
            "speakerName": "马尼菲科",
            "text": "太好了…接下来，我们真正的主角要登场了！别害羞！像明星一样登场吧！",
            "nextDialogs": [
              "750640607"
            ]
          },
          "750640607": {
            "id": "750640607",
            "speakerId": 21586,
            "speakerName": "马尼菲科",
            "text": "呼…完事了！这份副本送给你们做礼物，你们比枫丹的任何画廊都要更早得到这份杰作！",
            "nextDialogs": [
              "750640609",
              "750640611"
            ]
          },
          "750640609": {
            "id": "750640609",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "可是，尾款…尾款…！",
            "nextDialogs": [
              "750640613"
            ]
          },
          "750640613": {
            "id": "750640613",
            "speakerId": 21586,
            "speakerName": "马尼菲科",
            "text": "接下来我会去这个地点…来，让我在你的地图上标出来。嘿嘿，在接下来的旅程中，说不定我们又会相遇呢！",
            "nextDialogs": [
              "750640614"
            ]
          },
          "750640614": {
            "id": "750640614",
            "speakerId": 21586,
            "speakerName": "马尼菲科",
            "text": "说不定下一次，我还会麻烦你们帮忙哦！",
            "nextDialogs": [
              "750640615"
            ]
          },
          "750640615": {
            "id": "750640615",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "呜，不要把那种事情说得好像理所当然一样！",
            "nextDialogs": [
              "750640616"
            ]
          },
          "750640616": {
            "id": "750640616",
            "speakerId": 21586,
            "speakerName": "马尼菲科",
            "text": "哈哈，那不是我能决定的，是命运！是命运让我们相遇的！",
            "nextDialogs": [
              "750640617"
            ]
          },
          "750640617": {
            "id": "750640617",
            "speakerId": 21586,
            "speakerName": "马尼菲科",
            "text": "再见了，祝你们一路好运，朋友们！",
            "nextDialogs": [
              "750640618"
            ]
          },
          "750640618": {
            "id": "750640618",
            "speakerId": 14662,
            "speakerName": "#{REALNAME[ID(2)|SHOWHOST(true)]}",
            "text": "呀！",
            "nextDialogs": [
              "750640619"
            ]
          },
          "750640619": {
            "id": "750640619",
            "speakerId": 1003,
            "speakerName": "Black Screen",
            "text": "马尼菲科收拢起行李，飞快地跃上了热气球。\\n你们看到热气球先是剧烈地摇晃了两下，引得马尼菲科开怀大笑，然后很快恢复了稳定，向着远方飘去。"
          },
          "750640611": {
            "id": "750640611",
            "speakerId": 14662,
            "speakerName": "#{REALNAME[ID(2)|SHOWHOST(true)]}",
            "text": "唔嗯？呜呜…",
            "nextDialogs": [
              "750640612"
            ]
          },
          "750640612": {
            "id": "750640612",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "是呢…好失望…我还以为尾款会比定金多一点的…"
          }
        }
      }
    },
    {
      "subId": "7506414",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "750641401"
        ],
        "dialogs": {
          "750641401": {
            "id": "750641401",
            "speakerId": 21586,
            "speakerName": "马尼菲科",
            "text": "等等…为什么暝视龙在的时候，你就不见了？你在的时候，暝视龙就不会出现？",
            "nextDialogs": [
              "750641402"
            ]
          },
          "750641402": {
            "id": "750641402",
            "speakerId": 21586,
            "speakerName": "马尼菲科",
            "text": "难道说…",
            "nextDialogs": [
              "750641403"
            ]
          },
          "750641403": {
            "id": "750641403",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "#没错，{M#他}{F#她}上厕所去啦！",
            "nextDialogs": [
              "750641404"
            ]
          },
          "750641404": {
            "id": "750641404",
            "speakerId": 21586,
            "speakerName": "马尼菲科",
            "text": "？",
            "nextDialogs": [
              "750641405"
            ]
          },
          "750641405": {
            "id": "750641405",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "呃，你想想，我们总不能一块上厕所吧？那也太害臊啦！",
            "nextDialogs": [
              "750641406"
            ]
          },
          "750641406": {
            "id": "750641406",
            "speakerId": 21586,
            "speakerName": "马尼菲科",
            "text": "#对哦…哈哈，也对，总不可能是{NICKNAME}能变成龙吧！不过那样也好就是啦。"
          }
        }
      }
    }
  ]
}
  "subQuests": [
    {
      "subId": "7506404",
      "subQuestName": "前往马尼菲科的拍摄地点",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "750641501"
        ],
        "dialogs": {
          "750641501": {
            "id": "750641501",
            "speakerId": 21586,
            "speakerName": "马尼菲科",
            "text": "我刚刚仿佛听到有人提起我，没想到是你们！哈哈，真是太巧了！",
            "nextDialogs": [
              "750641502"
            ]
          },
          "750641502": {
            "id": "750641502",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "哇！我们怎么忘了你还有热气球呢！你也不载我们一程，真是小气！",
            "nextDialogs": [
              "750641503"
            ]
          },
          "750641503": {
            "id": "750641503",
            "speakerId": 14662,
            "speakerName": "#{REALNAME[ID(2)|SHOWHOST(true)]}",
            "text": "呜嗷！呜嗷！",
            "nextDialogs": [
              "750641504"
            ]
          },
          "750641504": {
            "id": "750641504",
            "speakerId": 21586,
            "speakerName": "马尼菲科",
            "text": "你们也没问过呀？",
            "nextDialogs": [
              "750641505"
            ]
          },
          "750641505": {
            "id": "750641505",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "我们怎么…唔，你也没有早点跟我们说呀！",
            "nextDialogs": [
              "750641507"
            ]
          },
          "750641507": {
            "id": "750641507",
            "speakerId": 21586,
            "speakerName": "马尼菲科",
            "text": "#真高兴再次见到你们！{NICKNAME}{M#先生}{F#小姐}，还有小派蒙！",
            "nextDialogs": [
              "750641508"
            ]
          },
          "750641508": {
            "id": "750641508",
            "speakerId": 21586,
            "speakerName": "马尼菲科",
            "text": "哈！我就说我们会再次相见的！正好有一件事需要拜托你们帮忙。",
            "nextDialogs": [
              "750641509"
            ]
          },
          "750641509": {
            "id": "750641509",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "在这里吗？是很麻烦的事情吗？",
            "nextDialogs": [
              "750641510"
            ]
          },
          "750641510": {
            "id": "750641510",
            "speakerId": 21586,
            "speakerName": "马尼菲科",
            "text": "其实也不麻烦，一会你们就知道了！",
            "nextDialogs": [
              "750641511"
            ]
          },
          "750641511": {
            "id": "750641511",
            "speakerId": 1003,
            "speakerName": "Black Screen",
            "text": "马尼菲科灵巧地从热气球上跳下来，从行李中解下映影机与支架，然后在空地组装了起来。\\n很快他便完成了手头的活计，自豪地站在你们面前。",
            "nextDialogs": [
              "750641506"
            ]
          },
          "750641506": {
            "id": "750641506",
            "speakerId": 21586,
            "speakerName": "马尼菲科",
            "text": "嘿嘿，请你们让一让，我要降落了！"
          }
        }
      }
    },
    {
      "subId": "7506412",
      "subQuestName": "前往马尼菲科的拍摄地点",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "750640412"
        ],
        "dialogs": {
          "750640412": {
            "id": "750640412",
            "speakerId": 21586,
            "speakerName": "马尼菲科",
            "text": "嗒哒！看吧，光与影的奇迹！枫丹的最新工业成果！",
            "nextDialogs": [
              "750640413"
            ]
          },
          "750640413": {
            "id": "750640413",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "这东西对我们来说已经不新鲜啦！你还没说要我们帮什么忙呢？",
            "nextDialogs": [
              "750640415",
              "750640417"
            ]
          },
          "750640415": {
            "id": "750640415",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "看样子，一定是要我们帮忙拍照吧？",
            "nextDialogs": [
              "750640418"
            ]
          },
          "750640418": {
            "id": "750640418",
            "speakerId": 21586,
            "speakerName": "马尼菲科",
            "text": "哦哦…好吧，好的！这里是你们的定金，请先拿好。",
            "nextDialogs": [
              "750640419"
            ]
          },
          "750640419": {
            "id": "750640419",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "这么多钱！！",
            "nextDialogs": [
              "750640420"
            ]
          },
          "750640420": {
            "id": "750640420",
            "speakerId": 14662,
            "speakerName": "#{REALNAME[ID(2)|SHOWHOST(true)]}",
            "text": "哇！！",
            "nextDialogs": [
              "750640421"
            ]
          },
          "750640421": {
            "id": "750640421",
            "speakerId": 21586,
            "speakerName": "马尼菲科",
            "text": "正如你们所见，我需要给本土的龙类拍几张画片，不是那种动物图鉴上的三视图…不，我要的是那种更有生命力的画片！",
            "nextDialogs": [
              "750640422"
            ]
          },
          "750640422": {
            "id": "750640422",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "嗯、嗯！",
            "nextDialogs": [
              "750640423"
            ]
          },
          "750640423": {
            "id": "750640423",
            "speakerId": 21586,
            "speakerName": "马尼菲科",
            "text": "只是…唉，有生命力的东西未必愿意听我指挥。假如方便的话，或许身为冒险家的你们可以帮我拍出足够理想的画片吧？",
            "nextDialogs": [
              "750640424"
            ]
          },
          "750640424": {
            "id": "750640424",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "嗯、嗯！",
            "nextDialogs": [
              "750640425"
            ]
          },
          "750640425": {
            "id": "750640425",
            "speakerId": 21586,
            "speakerName": "马尼菲科",
            "text": "当然，假如超出你们能力范围的话也不必勉强啦，不过我想你们至少能保护我不被这附近的生物攻击。",
            "nextDialogs": [
              "750640426"
            ]
          },
          "750640426": {
            "id": "750640426",
            "speakerId": 21586,
            "speakerName": "马尼菲科",
            "text": "所以，定金请尽管留着吧。帮不帮忙就全看你们咯！",
            "nextDialogs": [
              "750640427"
            ]
          },
          "750640427": {
            "id": "750640427",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "哇啊…这么多钱，沉甸甸的…真的可以给我们留着吗？",
            "nextDialogs": [
              "750640428"
            ]
          },
          "750640428": {
            "id": "750640428",
            "speakerId": 21586,
            "speakerName": "马尼菲科",
            "text": "那还有假！这点钱还需要我多加确认吗？",
            "nextDialogs": [
              "750640429"
            ]
          },
          "750640429": {
            "id": "750640429",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "哈！哈！那你算是找对人啦！我派蒙就是闻名全——纳塔的驯龙大师！",
            "nextDialogs": [
              "750640430"
            ]
          },
          "750640430": {
            "id": "750640430",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "#没问题，没问题！只要有我和{NICKNAME}在，你想要什么龙，我们都能帮你驯服！",
            "nextDialogs": [
              "750640431"
            ]
          },
          "750640431": {
            "id": "750640431",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "嵴锋龙？小意思！绒翼龙？太容易！暝视龙？明明白白！还有…呃，鳍游龙、匿叶龙、秃角龙…"
          },
          "750640417": {
            "id": "750640417",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "我们很酷，请先给钱。"
          }
        }
      }
    },

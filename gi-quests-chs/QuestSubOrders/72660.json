  },
  "subQuests": [
    {
      "subId": "7266001",
      "subQuestName": "与茅葺对话",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "726600101"
        ],
        "dialogs": {
          "726600101": {
            "id": "726600101",
            "speakerId": 1000,
            "speakerName": "茅葺一庆",
            "text": "嗨！那边那位异乡人，有兴趣战斗吗？",
            "nextDialogs": [
              "726600103",
              "726600105"
            ]
          },
          "726600103": {
            "id": "726600103",
            "speakerId": 1000,
            "speakerName": "茅葺一庆",
            "text": "太好了，我果然没看错人。",
            "nextDialogs": [
              "726600106"
            ]
          },
          "726600106": {
            "id": "726600106",
            "speakerId": 1000,
            "speakerName": "茅葺一庆",
            "text": "事情是这样的，最近似乎又有人在秘密举办「百人一揆」了。"
          },
          "726600105": {
            "id": "726600105",
            "speakerId": 1000,
            "speakerName": "茅葺一庆",
            "text": "也不算是委托吧。总之…"
          }
        }
      }
    },
    {
      "subId": "7266002",
      "subQuestName": "与茅葺对话",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "726600201"
        ],
        "dialogs": {
          "726600201": {
            "id": "726600201",
            "speakerId": 1000,
            "speakerName": "茅葺一庆",
            "text": "我们到了。",
            "nextDialogs": [
              "726600202"
            ]
          },
          "726600202": {
            "id": "726600202",
            "speakerId": 1000,
            "speakerName": "茅葺一庆",
            "text": "只要踏入这扇看起来十分可疑的大门，就能进入百人一揆的场馆。",
            "nextDialogs": [
              "726600205"
            ]
          },
          "726600205": {
            "id": "726600205",
            "speakerId": 1000,
            "speakerName": "茅葺一庆",
            "text": "虽然「天狗党」早已因为有违公序良俗而被取缔，但不时还会有人秘密举办百人一揆的乱斗大会。",
            "nextDialogs": [
              "726600206"
            ]
          },
          "726600206": {
            "id": "726600206",
            "speakerId": 1000,
            "speakerName": "茅葺一庆",
            "text": "而来自世界各地渴求争斗的魔物、冒险者、战士，冥冥之中也会被它吸引，在它的舞台上酣畅淋漓地大打出手。",
            "nextDialogs": [
              "726600207"
            ]
          },
          "726600207": {
            "id": "726600207",
            "speakerId": 1000,
            "speakerName": "茅葺一庆",
            "text": "你可以和志同道合的同伴、战友一起去参战。毕竟，所谓「百人」，自然是人数越多越好啦。",
            "nextDialogs": [
              "726600208"
            ]
          },
          "726600208": {
            "id": "726600208",
            "speakerId": 1000,
            "speakerName": "茅葺一庆",
            "text": "你看起来是云游四海的冒险家，想必有愿意与你一同参加的朋友吧。",
            "nextDialogs": [
              "726600209"
            ]
          },
          "726600209": {
            "id": "726600209",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "你不参加吗？",
            "nextDialogs": [
              "726600210"
            ]
          },
          "726600210": {
            "id": "726600210",
            "speakerId": 1000,
            "speakerName": "茅葺一庆",
            "text": "我吗？我会以旁观者的身份参与，为你喝彩。",
            "nextDialogs": [
              "726600211"
            ]
          },
          "726600211": {
            "id": "726600211",
            "speakerId": 1000,
            "speakerName": "茅葺一庆",
            "text": "其实，我的目的是写出最精彩的格斗小说，斩获八重堂的「这本小说真厉害」大奖。",
            "nextDialogs": [
              "726600212"
            ]
          },
          "726600212": {
            "id": "726600212",
            "speakerId": 1000,
            "speakerName": "茅葺一庆",
            "text": "而我的直觉告诉我，你一定会是格斗场上最耀眼的明星。"
          }
        }
      }
    },
    {

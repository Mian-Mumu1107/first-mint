  "subQuests": [
    {
      "subId": "7750501",
      "subQuestName": "与琪琪科娃对话",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "775050101"
        ],
        "dialogs": {
          "775050101": {
            "id": "775050101",
            "speakerId": 17182,
            "speakerName": "琪琪科娃",
            "text": "姐姐寄回来的拳谱真不错！",
            "nextDialogs": [
              "775050102"
            ]
          },
          "775050102": {
            "id": "775050102",
            "speakerId": 17182,
            "speakerName": "琪琪科娃",
            "text": "我刚刚去车站南边转了两圈，揍了揍不听话的极地熊，活动了一下筋骨…",
            "nextDialogs": [
              "775050103"
            ]
          },
          "775050103": {
            "id": "775050103",
            "speakerId": 17182,
            "speakerName": "琪琪科娃",
            "text": "突然，脑袋里「咔啦」一下，闪出了新的灵感，我想想要怎么用语言描述…最好让你们很快就能活用。",
            "nextDialogs": [
              "775050104"
            ]
          },
          "775050104": {
            "id": "775050104",
            "speakerId": 31121,
            "speakerName": "大喜儿",
            "text": "哦？是你提过的《枫丹搏击术概论》？我也想读读…",
            "nextDialogs": [
              "775050105"
            ]
          },
          "775050105": {
            "id": "775050105",
            "speakerId": 17182,
            "speakerName": "琪琪科娃",
            "text": "好啊，就放在那边，直接拿走都行，看完记得还给我。",
            "nextDialogs": [
              "775050106"
            ]
          },
          "775050106": {
            "id": "775050106",
            "speakerId": 30838,
            "speakerName": "「燃爆木头人」",
            "text": "新拳法！好东西！",
            "nextDialogs": [
              "775050107"
            ]
          },
          "775050107": {
            "id": "775050107",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "欸？完全没注意到琪琪科娃离开过呀？",
            "nextDialogs": [
              "775050108"
            ]
          },
          "775050108": {
            "id": "775050108",
            "speakerId": 17182,
            "speakerName": "琪琪科娃",
            "text": "嘿嘿，这不是显得我身法好，来无影去无踪吗？",
            "nextDialogs": [
              "775050109"
            ]
          },
          "775050109": {
            "id": "775050109",
            "speakerId": 17182,
            "speakerName": "琪琪科娃",
            "text": "让我瞧瞧，你们的探索计划完成得怎么样了…",
            "nextDialogs": [
              "775050110"
            ]
          },
          "775050110": {
            "id": "775050110",
            "speakerId": 17182,
            "speakerName": "琪琪科娃",
            "text": "这…这么厉害？你们才用了几天时间啊？大喜儿一个多月的进度还不到你们的两成…",
            "nextDialogs": [
              "775050113"
            ]
          },
          "775050113": {
            "id": "775050113",
            "speakerId": 17182,
            "speakerName": "琪琪科娃",
            "text": "还是头一次碰见…不，头一次听说，有这么神奇的新人！",
            "nextDialogs": [
              "775050114"
            ]
          },
          "775050114": {
            "id": "775050114",
            "speakerId": 17182,
            "speakerName": "琪琪科娃",
            "text": "请务必分享你们的心得，肯定能让新人们进步的速度达到以前的三倍以上！",
            "nextDialogs": [
              "775050115"
            ]
          },
          "775050115": {
            "id": "775050115",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "放心吧，我们本来也是这么打算的。",
            "nextDialogs": [
              "775050116"
            ]
          },
          "775050116": {
            "id": "775050116",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "#那，{NICKNAME}，我们商量一下，怎么样表达才更简单易懂…",
            "nextDialogs": [
              "775050117"
            ]
          },
          "775050117": {
            "id": "775050117",
            "speakerId": 1004,
            "speakerName": "Black Screen",
            "text": "和派蒙斟酌了措辞，在琪琪科娃的「冒险技巧共享手册」上，简单写下了这段时间在至冬游历的感悟，特别标注了需要注意的事项…\\n包括但不限于：如何预测野生动物们的动向、如何合理运用臻冰造物辅助探索未知区域、如何在暗中观察的状态下初步判断魔物集群的危险度和警戒圈…",
            "nextDialogs": [
              "775050118"
            ]
          },
          "775050118": {
            "id": "775050118",
            "speakerId": 1004,
            "speakerName": "Black Screen",
            "text": "从纳塔朋友的角度看，这或许也算是一种「大英雄的经验」？",
            "nextDialogs": [
              "775050119"
            ]
          },
          "775050119": {
            "id": "775050119",
            "speakerId": 17182,
            "speakerName": "琪琪科娃",
            "text": "我就说嘛，我的直觉真准，一下就发现了两个天才级的新人。",
            "nextDialogs": [
              "775050120"
            ]
          },
          "775050120": {
            "id": "775050120",
            "speakerId": 17182,
            "speakerName": "琪琪科娃",
            "text": "以后，你们就是互助协会的核心成员了！",
            "nextDialogs": [
              "775050121"
            ]
          },
          "775050121": {
            "id": "775050121",
            "speakerId": 17182,
            "speakerName": "琪琪科娃",
            "text": "哪天姐姐回来了，我带你们去见她，还能和姐姐学到更多秘密——愚人众精英的限定技巧哦~",
            "nextDialogs": [
              "775050122"
            ]
          },
          "775050122": {
            "id": "775050122",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "嘿呀，到时候…就请你的姐姐多多指教啦。"
          }
        }
      }
    }
  ]
}
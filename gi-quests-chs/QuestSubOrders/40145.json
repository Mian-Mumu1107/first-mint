    {
      "subId": "4014501",
      "subQuestName": "返回店铺",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "401450101"
        ],
        "dialogs": {
          "401450101": {
            "id": "401450101",
            "speakerId": 1000,
            "speakerName": "Black Screen",
            "text": "经过一段时间的试营业，炼金店铺红红火火地开起来了……",
            "nextDialogs": [
              "401450102"
            ]
          },
          "401450102": {
            "id": "401450102",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "呼，这段时间客人越来越多，我都要忙得头晕了…",
            "nextDialogs": [
              "401450105"
            ]
          },
          "401450105": {
            "id": "401450105",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "现在这个订单量，光靠我俩果然还是有点勉强吧？",
            "nextDialogs": [
              "401450106"
            ]
          },
          "401450106": {
            "id": "401450106",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "是不是该找点新的帮手了…",
            "nextDialogs": [
              "401450107"
            ]
          },
          "401450107": {
            "id": "401450107",
            "speakerId": 1002,
            "speakerName": "丽莎",
            "text": "小可爱，你们现在在休息吗？",
            "nextDialogs": [
              "401450108"
            ]
          },
          "401450108": {
            "id": "401450108",
            "speakerId": 1002,
            "speakerName": "丽莎",
            "text": "我刚刚看了最近的营收数据，你们果然很有经营天赋，这段时间卖出了不少药剂呢。",
            "nextDialogs": [
              "401450109"
            ]
          },
          "401450109": {
            "id": "401450109",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "丽莎你来了！我们正好在商量找帮手的事情呢。",
            "nextDialogs": [
              "401450110"
            ]
          },
          "401450110": {
            "id": "401450110",
            "speakerId": 1002,
            "speakerName": "丽莎",
            "text": "哦？是不是现在订单多起来了，你们逐渐忙不过来了？",
            "nextDialogs": [
              "401450111"
            ]
          },
          "401450111": {
            "id": "401450111",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "是啊，一开始没想到会有这么多客人…",
            "nextDialogs": [
              "401450112"
            ]
          },
          "401450112": {
            "id": "401450112",
            "speakerId": 1002,
            "speakerName": "丽莎",
            "text": "呵呵，我对此倒是有所预料呢。",
            "nextDialogs": [
              "401450113"
            ]
          },
          "401450113": {
            "id": "401450113",
            "speakerId": 1002,
            "speakerName": "丽莎",
            "text": "其实在你们忙着开店的同时，我和芙里达讨论了一下提升经营效率的事情。",
            "nextDialogs": [
              "401450114"
            ]
          },
          "401450114": {
            "id": "401450114",
            "speakerId": 1002,
            "speakerName": "丽莎",
            "text": "我观察了你们的经营情况，发现不管是炼金工艺，还是培育药材和售卖环节，都有不少的提升空间呢。",
            "nextDialogs": [
              "401450115"
            ]
          },
          "401450115": {
            "id": "401450115",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "哇，丽莎居然在悄悄关注这些事情吗？",
            "nextDialogs": [
              "401450116"
            ]
          },
          "401450116": {
            "id": "401450116",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "我还以为你一直在偷懒呢…",
            "nextDialogs": [
              "401450117"
            ]
          },
          "401450117": {
            "id": "401450117",
            "speakerId": 1002,
            "speakerName": "丽莎",
            "text": "说什么呢，姐姐在关键时候也是很可靠的哦。",
            "nextDialogs": [
              "401450118"
            ]
          },
          "401450118": {
            "id": "401450118",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "那你说的提升效率，具体要怎么做呀？",
            "nextDialogs": [
              "401450119"
            ]
          },
          "401450119": {
            "id": "401450119",
            "speakerId": 1002,
            "speakerName": "丽莎",
            "text": "这个嘛，具体的升级方案，我已经跟芙里达讨论过了。",
            "nextDialogs": [
              "401450120"
            ]
          },
          "401450120": {
            "id": "401450120",
            "speakerId": 1002,
            "speakerName": "丽莎",
            "text": "详细的情况，你们直接去找她聊聊吧。"
          }
        }
      }
    },

    {
      "subId": "4014503",
      "subQuestName": "与芙里达对话",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "401450201"
        ],
        "dialogs": {
          "401450201": {
            "id": "401450201",
            "speakerId": 1003,
            "speakerName": "芙里达",
            "text": "#{NICKNAME}和派蒙，你们好呀！有什么可以帮到你们吗？",
            "nextDialogs": [
              "401450202"
            ]
          },
          "401450202": {
            "id": "401450202",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "嗯，我们最近有点人手不足呢，丽莎建议我们提升一下经营效率…",
            "nextDialogs": [
              "401450203"
            ]
          },
          "401450203": {
            "id": "401450203",
            "speakerId": 1003,
            "speakerName": "芙里达",
            "text": "哦，这件事呀，丽莎已经跟我详细地探讨过了。",
            "nextDialogs": [
              "401450204"
            ]
          },
          "401450204": {
            "id": "401450204",
            "speakerId": 1003,
            "speakerName": "芙里达",
            "text": "目前可以提升的方向有炼金工艺、培育技术和销售规模。",
            "nextDialogs": [
              "401450205"
            ]
          },
          "401450205": {
            "id": "401450205",
            "speakerId": 1003,
            "speakerName": "芙里达",
            "text": "效率提升之后，你们经营起来也会更轻松哦。",
            "nextDialogs": [
              "401450206"
            ]
          },
          "401450206": {
            "id": "401450206",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "哇，听起来好厉害…我们赶快试试看吧！",
            "nextDialogs": [
              "401450208",
              "401450210",
              "401450212"
            ]
          },
          "401450208": {
            "id": "401450208",
            "speakerId": 1003,
            "speakerName": "芙里达",
            "text": "升级所需的准备已经做好了，请多多尝试！"
          },
          "401450210": {
            "id": "401450210",
            "speakerId": 1003,
            "speakerName": "芙里达",
            "text": "最近新到了一批物资，请看看有什么需要哦。"
          },
          "401450212": {
            "id": "401450212",
            "speakerId": 1003,
            "speakerName": "芙里达",
            "text": "祝你们经营顺利！"
          }
        }
      }
    }
  ]

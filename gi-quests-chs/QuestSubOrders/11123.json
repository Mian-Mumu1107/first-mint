            "speakerName": "矿工",
            "text": "呼…呼…"
          }
        }
      }
    },
    {
      "subId": "1112399",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "111239901"
        ],
        "dialogs": {
          "111239901": {
            "id": "111239901",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "咦，怎么把我们传到这里来了？得赶快回去看看刚才的工人！"
          }
        }
      }

  "subQuests": [
    {
      "subId": "1112309",
      "subQuestName": "与昆钧会合",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "111230901"
        ],
        "dialogs": {
          "111230901": {
            "id": "111230901",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "小昆——！该出发啦！",
            "nextDialogs": [
              "111230902"
            ]
          },
          "111230902": {
            "id": "111230902",
            "speakerId": 1001,
            "speakerName": "昆钧",
            "text": "好好，我这边也逛得差不多了。",
            "nextDialogs": [
              "111230903"
            ]
          },
          "111230903": {
            "id": "111230903",
            "speakerId": 1002,
            "speakerName": "钟离",
            "text": "昆兄可有什么收获？",
            "nextDialogs": [
              "111230904"
            ]
          },
          "111230904": {
            "id": "111230904",
            "speakerId": 1001,
            "speakerName": "昆钧",
            "text": "这一带的石头都很漂亮，不过没什么特别之处，把手放上去也没看到更多线索…",
            "nextDialogs": [
              "111230905"
            ]
          },
          "111230905": {
            "id": "111230905",
            "speakerId": 1001,
            "speakerName": "昆钧",
            "text": "果然，矿石的记忆也会随时间、环境而变化。",
            "nextDialogs": [
              "111230906"
            ]
          },
          "111230906": {
            "id": "111230906",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "有什么规律吗？",
            "nextDialogs": [
              "111230907"
            ]
          },
          "111230907": {
            "id": "111230907",
            "speakerId": 1001,
            "speakerName": "昆钧",
            "text": "呃，不太好归纳呢…我个人觉得，矿石中留存的，大多是近期的记忆。",
            "nextDialogs": [
              "111230908"
            ]
          },
          "111230908": {
            "id": "111230908",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "没有远古的记忆可以看吗？",
            "nextDialogs": [
              "111230909"
            ]
          },
          "111230909": {
            "id": "111230909",
            "speakerId": 1001,
            "speakerName": "昆钧",
            "text": "岩石恒久，可时光会将很多记忆抹去，能被长久保存下来的，只有那些极度强烈的情感或意念。",
            "nextDialogs": [
              "111230910"
            ]
          },
          "111230910": {
            "id": "111230910",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "好现实，根本就和人一样嘛。",
            "nextDialogs": [
              "111230911"
            ]
          },
          "111230911": {
            "id": "111230911",
            "speakerId": 1001,
            "speakerName": "昆钧",
            "text": "嗯，也有道理。走吧，去前面看看。"
          }
        }
      }
    },
    {
      "subId": "1112301",
      "subQuestName": "到古树下调查线索",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "111230101"
        ],
        "dialogs": {
          "111230101": {
            "id": "111230101",
            "speakerId": 1001,
            "speakerName": "昆钧",
            "text": "哇，好大一棵树！",
            "nextDialogs": [
              "111230102"
            ]
          },
          "111230102": {
            "id": "111230102",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "上面还有很多神秘的结晶，好奇妙。",
            "nextDialogs": [
              "111230103"
            ]
          },
          "111230103": {
            "id": "111230103",
            "speakerId": 1002,
            "speakerName": "钟离",
            "text": "这棵古树…",
            "nextDialogs": [
              "111230104"
            ]
          },
          "111230104": {
            "id": "111230104",
            "speakerId": 1002,
            "speakerName": "钟离",
            "text": "分头调查吧，那边交给我，这一带就拜托你们了。",
            "nextDialogs": [
              "111230107"
            ]
          },
          "111230107": {
            "id": "111230107",
            "speakerId": 1002,
            "speakerName": "钟离",
            "text": "嗯。",
            "nextDialogs": [
              "111230108"
            ]
          },
          "111230108": {
            "id": "111230108",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "小昆，你看到值得调查的东西了吗——？",
            "nextDialogs": [
              "111230109"
            ]
          },
          "111230109": {
            "id": "111230109",
            "speakerId": 1001,
            "speakerName": "昆钧",
            "text": "只有一块石碑。",
            "nextDialogs": [
              "111230110"
            ]
          },
          "111230110": {
            "id": "111230110",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "听起来没什么用，我去别处看看好了。",
            "nextDialogs": [
              "111230111"
            ]
          },
          "111230111": {
            "id": "111230111",
            "speakerId": 1001,
            "speakerName": "昆钧",
            "text": "唉，聊胜于无，试试吧。",
            "nextDialogs": [
              "111230112"
            ]
          },
          "111230112": {
            "id": "111230112",
            "speakerId": 1001,
            "speakerName": "昆钧",
            "text": "……",
            "nextDialogs": [
              "111230113"
            ]
          },
          "111230113": {
            "id": "111230113",
            "speakerId": 1001,
            "speakerName": "昆钧",
            "text": "……！",
            "nextDialogs": [
              "111230114"
            ]
          },
          "111230114": {
            "id": "111230114",
            "speakerId": 1001,
            "speakerName": "昆钧",
            "text": "（这是…）",
            "nextDialogs": [
              "111230115"
            ]
          },
          "111230115": {
            "id": "111230115",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "咦，你怎么了？",
            "nextDialogs": [
              "111230116"
            ]
          },
          "111230116": {
            "id": "111230116",
            "speakerId": 1001,
            "speakerName": "昆钧",
            "text": "…刚刚有些头晕而已，没关系，已经好了。",
            "nextDialogs": [
              "111230117"
            ]
          },
          "111230117": {
            "id": "111230117",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "有什么发现吗？",
            "nextDialogs": [
              "111230118"
            ]
          },
          "111230118": {
            "id": "111230118",
            "speakerId": 1001,
            "speakerName": "昆钧",
            "text": "暂时…嗯，暂时还没有。",
            "nextDialogs": [
              "111230119"
            ]
          },
          "111230119": {
            "id": "111230119",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "#没办法了，{NICKNAME}，我到那边再找找，你爬到树上去看看？",
            "nextDialogs": [
              "111230120"
            ]
          },
          "111230120": {
            "id": "111230120",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "你确定树上有线索？",
            "nextDialogs": [
              "111230121"
            ]
          },
          "111230121": {
            "id": "111230121",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "不试试怎么知道没有，再说，你还可以登高望远呀！",
            "nextDialogs": [
              "111230122"
            ]
          },
          "111230122": {
            "id": "111230122",
            "speakerId": 1001,
            "speakerName": "昆钧",
            "text": "……",
            "nextDialogs": [
              "111230123"
            ]
          },
          "111230123": {
            "id": "111230123",
            "speakerId": 1001,
            "speakerName": "昆钧",
            "text": "啊！是、是吗？",
            "nextDialogs": [
              "111230124"
            ]
          },
          "111230124": {
            "id": "111230124",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "对呀对呀，我想的办法一向很不错哦。",
            "nextDialogs": [
              "111230125"
            ]
          },
          "111230125": {
            "id": "111230125",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "等等，我会飞！哎呀，那还是我去吧，你们在这里等等哦，我马上…",
            "nextDialogs": [
              "111230126"
            ]
          },
          "111230126": {
            "id": "111230126",
            "speakerId": 1002,
            "speakerName": "钟离",
            "text": "各位，来这边。",
            "nextDialogs": [
              "111230127"
            ]
          },
          "111230127": {
            "id": "111230127",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "咦，钟离的声音…是从树后传来的，他是不是找到了新线索？",
            "nextDialogs": [
              "111230128"
            ]
          },
          "111230128": {
            "id": "111230128",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "快去看看，说不定是找到人了！"
          }
        }
      }
    },
    {
      "subId": "1112302",
      "subQuestName": "找到钟离",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "111230201"
        ],
        "dialogs": {
          "111230201": {
            "id": "111230201",
            "speakerId": 1002,
            "speakerName": "钟离",
            "text": "这条路是新挖的，看来，答案就在前方。",
            "nextDialogs": [
              "111230202"
            ]
          },
          "111230202": {
            "id": "111230202",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "地道里好像有声音？呜哇…我、我不要走第一个！",
            "nextDialogs": [
              "111230203"
            ]
          },
          "111230203": {
            "id": "111230203",
            "speakerId": 1002,
            "speakerName": "钟离",
            "text": "放心，我来打头阵。",
            "nextDialogs": [
              "111230204"
            ]
          },
          "111230204": {
            "id": "111230204",
            "speakerId": 1001,
            "speakerName": "昆钧",
            "text": "……",
            "nextDialogs": [
              "111230205"
            ]
          },
          "111230205": {
            "id": "111230205",
            "speakerId": 1002,
            "speakerName": "钟离",
            "text": "尽头有些不寻常的气息。谨慎起见，各位，请做好准备。"
          }
        }
      }
    },

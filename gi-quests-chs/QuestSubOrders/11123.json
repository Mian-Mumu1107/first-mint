            "speakerId": 1003,
            "speakerName": "矿工",
            "text": "唔…呜…",
            "nextDialogs": [
              "111221702"
            ]
          },
          "111221702": {
            "id": "111221702",
            "speakerId": 1003,
            "speakerName": "矿工",
            "text": "（他看起来似乎很疲惫。）"
          }
        }
      }
    },
    {
      "subId": "1112313",

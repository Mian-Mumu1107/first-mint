    {
      "subId": "503008",
      "subQuestName": "(test)救了愚人众关卡的人$HIDDEN",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "50300801"
        ],
        "dialogs": {
          "50300801": {
            "id": "50300801",
            "speakerId": 14511,
            "speakerName": "乌图伦库",
            "text": "是你们，太好了！谢谢你们一直鼓励我！",
            "nextDialogs": [
              "50300802"
            ]
          },
          "50300802": {
            "id": "50300802",
            "speakerId": 14511,
            "speakerName": "乌图伦库",
            "text": "纳塔有很多人都把对抗深渊视为荣耀，但他们也会被热血冲昏头脑，不知不觉就陷入险境之中。",
            "nextDialogs": [
              "50300803"
            ]
          },
          "50300803": {
            "id": "50300803",
            "speakerId": 14511,
            "speakerName": "乌图伦库",
            "text": "你们说得很对，战斗很重要，生命也很重要，我们为所爱之人战斗，所以我们还要去和所爱之人重逢。",
            "nextDialogs": [
              "50300804"
            ]
          },
          "50300804": {
            "id": "50300804",
            "speakerId": 14511,
            "speakerName": "乌图伦库",
            "text": "我转告了你们的想法之后，战友们都很认可，在战斗中也变得稳重了很多，我们取得了非常好的成果！",
            "nextDialogs": [
              "50300805"
            ]
          },
          "50300805": {
            "id": "50300805",
            "speakerId": 14511,
            "speakerName": "乌图伦库",
            "text": "真的要谢谢你们！"
          }
        }
      }
    },
    {
      "subId": "503009",
      "subQuestName": "(test)救了驯龙高手等人$HIDDEN",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "50300901"
        ],
        "dialogs": {
          "50300901": {
            "id": "50300901",
            "speakerId": 14511,
            "speakerName": "乌图伦库",
            "text": "…是你们啊，我还以为我们没办法再见了。",
            "nextDialogs": [
              "50300902"
            ]
          },
          "50300902": {
            "id": "50300902",
            "speakerId": 14511,
            "speakerName": "乌图伦库",
            "text": "我还是打了一场好仗，我们赢了，虽然付出了很多代价…",
            "nextDialogs": [
              "50300903"
            ]
          },
          "50300903": {
            "id": "50300903",
            "speakerId": 14511,
            "speakerName": "乌图伦库",
            "text": "你们还会继续战斗对吗？请千万要注意自己的安全。",
            "nextDialogs": [
              "50300904"
            ]
          },
          "50300904": {
            "id": "50300904",
            "speakerId": 14511,
            "speakerName": "乌图伦库",
            "text": "对抗深渊是一种荣耀，但能换来胜利的并不是荣耀，而是活下去…"
          }
        }
      }
    },
    {
      "subId": "503010",
      "subQuestName": "(test)救了驯龙高手的龙$HIDDEN",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "50301001"
        ],
        "dialogs": {
          "50301001": {
            "id": "50301001",
            "speakerId": 14403,
            "speakerName": "拉曼",
            "text": "是你们，你们回来了，谢谢你们救了我。",
            "nextDialogs": [
              "50301002"
            ]
          },
          "50301002": {
            "id": "50301002",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "你没事就好。对了，那些龙去哪里了？",
            "nextDialogs": [
              "50301003"
            ]
          },
          "50301003": {
            "id": "50301003",
            "speakerId": 14403,
            "speakerName": "拉曼",
            "text": "哦，它们又去帮忙了，去支援那些还能行动的讯使，到野外侦察和传递情报。",
            "nextDialogs": [
              "50301004"
            ]
          },
          "50301004": {
            "id": "50301004",
            "speakerId": 14403,
            "speakerName": "拉曼",
            "text": "我知道外面的情况很差，恨不得自己能多走两步，但…现在只能做点力所能及的事了。"
          }
        }
      }
    },
    {
      "subId": "503011",
      "subQuestName": "(test)悬木人哨站一阶段去过$HIDDEN",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "50301101"
        ],
        "dialogs": {
          "50301101": {
            "id": "50301101",
            "speakerId": 14413,
            "speakerName": "伊约芭",
            "text": "#是你们，感谢你们救了我们。来来，快来给{M#他}{F#她}们道谢。",
            "nextDialogs": [
              "50301102"
            ]
          },
          "50301102": {
            "id": "50301102",
            "speakerId": 14414,
            "speakerName": "欧莎薇",
            "text": "谢谢你们！",
            "nextDialogs": [
              "50301103"
            ]
          },
          "50301103": {
            "id": "50301103",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "不客气，不客气，你们没事就好。",
            "nextDialogs": [
              "50301104"
            ]
          },
          "50301104": {
            "id": "50301104",
            "speakerId": 14414,
            "speakerName": "欧莎薇",
            "text": "还要谢谢那些哥哥姐姐，他们叫…愚、愚…",
            "nextDialogs": [
              "50301105"
            ]
          },
          "50301105": {
            "id": "50301105",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "愚人众！",
            "nextDialogs": [
              "50301106"
            ]
          },
          "50301106": {
            "id": "50301106",
            "speakerId": 14414,
            "speakerName": "欧莎薇",
            "text": "没错，愚人众！他们也很厉害…",
            "nextDialogs": [
              "50301107"
            ]
          },
          "50301107": {
            "id": "50301107",
            "speakerId": 14413,
            "speakerName": "伊约芭",
            "text": "我也应该摒弃我的成见，即使是在这个势力之中，依然存在非常高尚的灵魂。"
          }
        }
      }
    },
    {
      "subId": "503012",
      "subQuestName": "(test)悬木人哨站一阶段没去过$HIDDEN",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "50301201"
        ],
        "dialogs": {
          "50301201": {
            "id": "50301201",
            "speakerId": 14415,
            "speakerName": "哈隆加",
            "text": "跟我回来的龙伙伴，不管怎么劝，都要跟着战士往外冲，拦都拦不住。",
            "nextDialogs": [
              "50301202"
            ]
          },
          "50301202": {
            "id": "50301202",
            "speakerId": 14415,
            "speakerName": "哈隆加",
            "text": "这样就显得我是那个最没用的家伙了，唉，幸好我还懂些龙的医术，可以帮它们治疗。"
          }
        }
      }
    },
    {
      "subId": "503013",
      "subQuestName": "(test)闲置部分回滚隔离$HIDDEN",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "50301301"
        ],
        "dialogs": {
          "50301301": {
            "id": "50301301",
            "speakerId": 14548,
            "speakerName": "幼小的匿叶龙",
            "text": "呜——♪",
            "nextDialogs": [
              "50301302"
            ]
          },
          "50301302": {
            "id": "50301302",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "是我们救下来的那只匿叶龙！你能安全回到这里，太好了，呜呜…",
            "nextDialogs": [
              "50301303"
            ]
          },
          "50301303": {
            "id": "50301303",
            "speakerId": 14548,
            "speakerName": "幼小的匿叶龙",
            "text": "呜、呜！"
          }
        }
      }
    },
    {
      "subId": "503014",
      "subQuestName": "(test)整体父任务完成环$HIDDEN",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "50301401"
        ],
        "dialogs": {
          "50301401": {
            "id": "50301401",
            "speakerId": 14514,
            "speakerName": "利别科",
            "text": "能看到你们安全归来，太好了。",
            "nextDialogs": [
              "50301402"
            ]
          },
          "50301402": {
            "id": "50301402",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "说好了要在竞技场见，对吧。",
            "nextDialogs": [
              "50301403"
            ]
          },
          "50301403": {
            "id": "50301403",
            "speakerId": 14513,
            "speakerName": "库纳克",
            "text": "嗯…我生平第一次战胜了深渊魔物，在我战胜它的瞬间，我觉得它也不过如此。",
            "nextDialogs": [
              "50301404"
            ]
          },
          "50301404": {
            "id": "50301404",
            "speakerId": 14513,
            "speakerName": "库纳克",
            "text": "我输给了我的恐惧，我错过了保护别人的机会。",
            "nextDialogs": [
              "50301405"
            ]
          },
          "50301405": {
            "id": "50301405",
            "speakerId": 14514,
            "speakerName": "利别科",
            "text": "不要太苛责自己，活下去才是最重要的事，只有活下去，我们才有机会和其他人讲起他们的故事。",
            "nextDialogs": [
              "50301406"
            ]
          },
          "50301406": {
            "id": "50301406",
            "speakerId": 14514,
            "speakerName": "利别科",
            "text": "他们永远会活在我们心中。"
          }
        }
      }
    },
    {
      "subId": "503015",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "50301501"
        ],
        "dialogs": {
          "50301501": {
            "id": "50301501",
            "speakerId": 14388,
            "speakerName": "阿奇亚库",
            "text": "太好了，我们还在担心你们！",
            "nextDialogs": [
              "50301502"
            ]
          },
          "50301502": {
            "id": "50301502",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "路上没遇到危险吧？",
            "nextDialogs": [
              "50301503"
            ]
          },
          "50301503": {
            "id": "50301503",
            "speakerId": 14388,
            "speakerName": "阿奇亚库",
            "text": "我们还是撞上了深渊魔物，说实话很危险，但他们很勇敢，很机敏，完全不输给合格的战士。",
            "nextDialogs": [
              "50301504"
            ]
          },
          "50301504": {
            "id": "50301504",
            "speakerId": 14514,
            "speakerName": "利别科",
            "text": "身体记住的东西，看来没那么容易忘，哈哈哈。",
            "nextDialogs": [
              "50301505"
            ]
          },
          "50301505": {
            "id": "50301505",
            "speakerId": 14513,
            "speakerName": "库纳克",
            "text": "能活下来，就是最幸运的事，只有活下来，才可能逐渐找回失去的东西。",
            "nextDialogs": [
              "50301506"
            ]
          },
          "50301506": {
            "id": "50301506",
            "speakerId": 14513,
            "speakerName": "库纳克",
            "text": "你们也一定要平安无事啊。"
          }
        }
      }
    },
    {
      "subId": "503016",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "50301601"

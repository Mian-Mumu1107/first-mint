  "subQuests": [
    {
      "subId": "503001",
      "subQuestName": "(test)竞技场护士-没救医生$HIDDEN",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "50300101"
        ],
        "dialogs": {
          "50300101": {
            "id": "50300101",
            "speakerId": 14584,
            "speakerName": "琪丝佩",
            "text": "天啊，人也不够，东西也不够，就我这三脚猫的技术，很多伤口根本处理不了…",
            "nextDialogs": [
              "50300102"
            ]
          },
          "50300102": {
            "id": "50300102",
            "speakerId": 14584,
            "speakerName": "琪丝佩",
            "text": "要是有更专业的人在就好了…不行不行，还不是叹气的时候，我得打起精神！"
          }
        }
      }
    },
    {
      "subId": "503002",
      "subQuestName": "(test)流泉之众商人闲置$HIDDEN",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "50300201"
        ],
        "dialogs": {
          "50300201": {
            "id": "50300201",
            "speakerId": 14393,
            "speakerName": "奥希娜",
            "text": "我看到你们把葵可女士送回来了…对此我很遗憾，葵可女士真的是一位前途无限光明的医生。",
            "nextDialogs": [
              "50300202"
            ]
          },
          "50300202": {
            "id": "50300202",
            "speakerId": 14393,
            "speakerName": "奥希娜",
            "text": "我们在业务上有很多合作，她对于药物的品质有很高的要求，有时候为了给别人治病，还会自掏腰包。",
            "nextDialogs": [
              "50300203"
            ]
          },
          "50300203": {
            "id": "50300203",
            "speakerId": 14393,
            "speakerName": "奥希娜",
            "text": "她和我说，比起赚钱，她更看重经验的积累。",
            "nextDialogs": [
              "50300204"
            ]
          },
          "50300204": {
            "id": "50300204",
            "speakerId": 14393,
            "speakerName": "奥希娜",
            "text": "只有掌握最精湛的医术，才能让她救最多的人，同时，也让她不会错过她最想救的那个人。",
            "nextDialogs": [
              "50300205"
            ]
          },
          "50300205": {
            "id": "50300205",
            "speakerId": 14393,
            "speakerName": "奥希娜",
            "text": "可惜，可惜，医者难自医，纳塔失去了如此杰出的一位英才…"
          }
        }
      }
    },
    {
      "subId": "503003",
      "subQuestName": "(test)医生和护士对话$HIDDEN",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "50300301"
        ],
        "dialogs": {
          "50300301": {
            "id": "50300301",
            "speakerId": 14512,
            "speakerName": "玛亚薇",
            "text": "药物还剩下多少，够用吗？",
            "nextDialogs": [
              "50300302"
            ]
          },
          "50300302": {
            "id": "50300302",
            "speakerId": 14584,
            "speakerName": "琪丝佩",
            "text": "见底了，紧急储备还剩一些，是留给医生和战士的，这些不能动。",
            "nextDialogs": [
              "50300303"
            ]
          },
          "50300303": {
            "id": "50300303",
            "speakerId": 14512,
            "speakerName": "玛亚薇",
            "text": "我知道，我知道…",
            "nextDialogs": [
              "50300304"
            ]
          },
          "50300304": {
            "id": "50300304",
            "speakerId": 14512,
            "speakerName": "玛亚薇",
            "text": "把我的那份拿出来。"
          }
        }
      }
    },

      "subQuestName": "(test)灰心哥鼓励成功$HIDDEN",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "50300501"
        ],
        "dialogs": {
          "50300501": {
            "id": "50300501",
            "speakerId": 14512,
            "speakerName": "玛亚薇",
            "text": "药物还剩下多少，够用吗？",
            "nextDialogs": [
              "50300502"
            ]
          },
          "50300502": {
            "id": "50300502",
            "speakerId": 14584,
            "speakerName": "琪丝佩",
            "text": "见底了，紧急储备还剩一些，是留给医生和战士的，这些不能动。",
            "nextDialogs": [
              "50300503"
            ]
          },
          "50300503": {
            "id": "50300503",
            "speakerId": 14512,
            "speakerName": "玛亚薇",
            "text": "我知道，我知道…",
            "nextDialogs": [
              "50300504"
            ]
          },
          "50300504": {
            "id": "50300504",
            "speakerId": 14512,
            "speakerName": "玛亚薇",
            "text": "把我的那份拿出来。",
            "nextDialogs": [
              "50300505"
            ]
          },
          "50300505": {
            "id": "50300505",
            "speakerId": 14512,
            "speakerName": "玛亚薇",
            "text": "原来是你们，很高兴看到你们没事。",
            "nextDialogs": [
              "50300506"
            ]
          },
          "50300506": {
            "id": "50300506",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "你儿子的情况如何？",
            "nextDialogs": [
              "50300507"
            ]
          },
          "50300507": {
            "id": "50300507",
            "speakerId": 14512,
            "speakerName": "玛亚薇",
            "text": "我不知道，通信基本断了，送来的伤员一个接一个，我必须集中精神。",
            "nextDialogs": [
              "50300508"
            ]
          },
          "50300508": {
            "id": "50300508",
            "speakerId": 14512,
            "speakerName": "玛亚薇",
            "text": "但我相信他，他一定能在关键的时候做出正确的判断，因为他是我的儿子，我始终都为他骄傲。"
          }
        }
      }
    },
    {
      "subId": "503006",
      "subQuestName": "(test)灰心哥鼓励失败$HIDDEN",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "50300601"
        ],
        "dialogs": {
          "50300601": {
            "id": "50300601",
            "speakerId": 14584,
            "speakerName": "琪丝佩",
            "text": "幸好有玛亚薇在，她真的很专业，治好了很多病人。",
            "nextDialogs": [
              "50300602"
            ]
          },
          "50300602": {
            "id": "50300602",
            "speakerId": 14584,
            "speakerName": "琪丝佩",
            "text": "但她也有点太拼命了，这么长时间没休息过。等下我找个理由，和她换一下班吧。"
          }
        }
      }
    },

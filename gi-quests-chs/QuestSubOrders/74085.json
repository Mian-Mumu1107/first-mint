        ],
        "dialogs": {
          "740851001": {
            "id": "740851001",
            "speakerId": 5325,
            "speakerName": "珀西芙",
            "text": "根…根…",
            "nextDialogs": [
              "740851002"
            ]
          },
          "740851002": {
            "id": "740851002",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "终于到了！这里有好多污秽啊…虽然附近好像没有人，但我有一种很熟悉的邪恶感觉…",
            "nextDialogs": [
              "740851003"
            ]
          },
          "740851003": {
            "id": "740851003",
            "speakerId": 5325,
            "speakerName": "珀西芙",
            "text": "垂柳…根…",
            "nextDialogs": [
              "740851004"
            ]
          },
          "740851004": {
            "id": "740851004",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "原来这里是之前那棵大树的根啊？",
            "nextDialogs": [
              "740851005"
            ]
          },
          "740851005": {
            "id": "740851005",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "我明白了，难怪之前看到的那棵大树像是枯萎了，全都因为根变成了这样！",
            "nextDialogs": [
              "740851006"
            ]
          },
          "740851006": {
            "id": "740851006",
            "speakerId": 5325,
            "speakerName": "珀西芙",
            "text": "根…美露莘…",
            "nextDialogs": [
              "740851007"
            ]
          },
          "740851007": {
            "id": "740851007",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "#{NICKNAME}，我们先把这些污秽清理掉吧…感觉就是它们让根变坏的。"
          }
        }
      }
    },

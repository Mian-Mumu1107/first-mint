    {
      "subId": "7408599",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "740859902"
        ],
        "dialogs": {
          "740859902": {
            "id": "740859902",
            "speakerId": 16210,
            "speakerName": "珀西芙",
            "text": "根，十分很前，十分很深…",
            "nextDialogs": [
              "740859903"
            ]
          },
          "740859903": {
            "id": "740859903",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "那我们就继续往前进发！",
            "nextDialogs": [
              "740859904"
            ]
          },
          "740859904": {
            "id": "740859904",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "对了，珀西芙，关于那个紫东西，你还知道什么吗？",
            "nextDialogs": [
              "740859905"
            ]
          },
          "740859905": {
            "id": "740859905",
            "speakerId": 16210,
            "speakerName": "珀西芙",
            "text": "紫东西，十分很可怕。珀西芙，靠近，不敢…",
            "nextDialogs": [
              "740859906"
            ]
          },
          "740859906": {
            "id": "740859906",
            "speakerId": 16210,
            "speakerName": "珀西芙",
            "text": "紫东西，蓝东西，战斗。",
            "nextDialogs": [
              "740859907"
            ]
          },
          "740859907": {
            "id": "740859907",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "蓝东西就是龙蜥对吧？龙蜥在和那家伙战斗？",
            "nextDialogs": [
              "740859908"
            ]
          },
          "740859908": {
            "id": "740859908",
            "speakerId": 16210,
            "speakerName": "珀西芙",
            "text": "珀西芙！但是…紫东西，十分很可怕。蓝东西，很多失去了。",
            "nextDialogs": [
              "740859911"
            ]
          },
          "740859911": {
            "id": "740859911",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "#你放心，{NICKNAME}也十分很厉害！什么花花绿绿的东西{M#他}{F#她}都教训过！",
            "nextDialogs": [
              "740859910"
            ]
          },
          "740859910": {
            "id": "740859910",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "失去了？对、对不起…"
          }
        }
      }
    }
  ]
}
    {
      "subId": "7408502",
      "subQuestName": "与美露莘对话",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "740850201"
        ],
        "dialogs": {
          "740850201": {
            "id": "740850201",
            "speakerId": 5325,
            "speakerName": "珀西芙",
            "text": "钥匙，雕像，钥匙，雕像，钥匙，雕像。",
            "nextDialogs": [
              "740850202"
            ]
          },
          "740850202": {
            "id": "740850202",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "嗯…你是说把钥匙放进雕像？这样倒是刚刚好，三把钥匙对三座雕像…",
            "nextDialogs": [
              "740850203"
            ]
          },
          "740850203": {
            "id": "740850203",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "我们先试试吧？",
            "nextDialogs": [
              "740850204"
            ]
          },
          "740850204": {
            "id": "740850204",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "放好钥匙后会发生什么？",
            "nextDialogs": [
              "740850205"
            ]
          },
          "740850205": {
            "id": "740850205",
            "speakerId": 5325,
            "speakerName": "珀西芙",
            "text": "门开，开门…",
            "nextDialogs": [
              "740850206"
            ]
          },
          "740850206": {
            "id": "740850206",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "门？哪儿呢？门后面有什么？",
            "nextDialogs": [
              "740850207"
            ]
          },
          "740850207": {
            "id": "740850207",
            "speakerId": 5325,
            "speakerName": "珀西芙",
            "text": "根，伊黎耶，十分很深…",
            "nextDialogs": [
              "740850208"
            ]
          },
          "740850208": {
            "id": "740850208",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "门通往伊黎耶岛的根？！珀西芙，你你…你知道的东西好多！",
            "nextDialogs": [
              "740850209"
            ]
          },
          "740850209": {
            "id": "740850209",
            "speakerId": 5325,
            "speakerName": "珀西芙",
            "text": "珀西芙，守护！",
            "nextDialogs": [
              "740850210"
            ]
          },
          "740850210": {
            "id": "740850210",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "还有什么需要我们知道的吗？",
            "nextDialogs": [
              "740850211"
            ]
          },
          "740850211": {
            "id": "740850211",
            "speakerId": 5325,
            "speakerName": "珀西芙",
            "text": "…啊？",
            "nextDialogs": [
              "740850212"
            ]
          },
          "740850212": {
            "id": "740850212",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "就是情报啦，信息啦，越多越好，知道的越多，我们就越有把握！",
            "nextDialogs": [
              "740850213"
            ]
          },
          "740850213": {
            "id": "740850213",
            "speakerId": 5325,
            "speakerName": "珀西芙",
            "text": "信…息？信…息…珀西芙！信息，十分很多…",
            "nextDialogs": [
              "740850214"
            ]
          },
          "740850214": {
            "id": "740850214",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "太好了！",
            "nextDialogs": [
              "740850215"
            ]
          },
          "740850215": {
            "id": "740850215",
            "speakerId": 5325,
            "speakerName": "珀西芙",
            "text": "伊黎耶，信息，十分很多。",
            "nextDialogs": [
              "740850216"
            ]
          },
          "740850216": {
            "id": "740850216",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "嗯…信息很多。",
            "nextDialogs": [
              "740850217"
            ]
          },
          "740850217": {
            "id": "740850217",
            "speakerId": 5325,
            "speakerName": "珀西芙",
            "text": "信息，水脉，十分很多。",
            "nextDialogs": [
              "740850218"
            ]
          },
          "740850218": {
            "id": "740850218",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "嗯…水脉很多。",
            "nextDialogs": [
              "740850219"
            ]
          },
          "740850219": {
            "id": "740850219",
            "speakerId": 5325,
            "speakerName": "珀西芙",
            "text": "水脉，那位来客，十分很多。",
            "nextDialogs": [
              "740850220"
            ]
          },
          "740850220": {
            "id": "740850220",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "嗯…嗯？！那位来客很多？！等等，我没懂…哪来的那么多位来客啊？那位来客会分身魔法？",
            "nextDialogs": [
              "740850221"
            ]
          },
          "740850221": {
            "id": "740850221",
            "speakerId": 5325,
            "speakerName": "珀西芙",
            "text": "美露莘！",
            "nextDialogs": [
              "740850222"
            ]
          },
          "740850222": {
            "id": "740850222",
            "speakerId": 5325,
            "speakerName": "珀西芙",
            "text": "水脉，那位来客，品尝。",
            "nextDialogs": [
              "740850223"
            ]
          },
          "740850223": {
            "id": "740850223",
            "speakerId": 5325,
            "speakerName": "珀西芙",
            "text": "邪恶，那位来客，感知。",
            "nextDialogs": [
              "740850224"
            ]
          },
          "740850224": {
            "id": "740850224",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "品尝水脉里的邪恶？这是什么奇怪的口味啊…",
            "nextDialogs": [
              "740850225"
            ]
          },
          "740850225": {
            "id": "740850225",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "那位来客能感知水脉里的信息？",
            "nextDialogs": [
              "740850226"
            ]
          },
          "740850226": {
            "id": "740850226",
            "speakerId": 5325,
            "speakerName": "珀西芙",
            "text": "珀西芙！",
            "nextDialogs": [
              "740850227"
            ]
          },
          "740850227": {
            "id": "740850227",
            "speakerId": 5325,
            "speakerName": "珀西芙",
            "text": "垂柳，收集。雾道，处理。泉眼，发送。",
            "nextDialogs": [
              "740850228"
            ]
          },
          "740850228": {
            "id": "740850228",
            "speakerId": 5325,
            "speakerName": "珀西芙",
            "text": "根，水脉，中心。",
            "nextDialogs": [
              "740850229"
            ]
          },
          "740850229": {
            "id": "740850229",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "伊黎耶岛是信息中心？",
            "nextDialogs": [
              "740850230"
            ]
          },
          "740850230": {
            "id": "740850230",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "你是说整个伊黎耶岛是那位来客的一个信息系统？他可以通过这个感知一些不好的东西？",
            "nextDialogs": [
              "740850231"
            ]
          },
          "740850231": {
            "id": "740850231",
            "speakerId": 5325,
            "speakerName": "珀西芙",
            "text": "#聪明派蒙！聪明{NICKNAME}！珀西芙！",
            "nextDialogs": [
              "740850232"
            ]
          },
          "740850232": {
            "id": "740850232",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "天呢，这个叫做那位来客的来客究竟是什么人物啊…",
            "nextDialogs": [
              "740850233"
            ]
          },
          "740850233": {
            "id": "740850233",
            "speakerId": 5325,
            "speakerName": "珀西芙",
            "text": "枫丹，那位来客，守护。",
            "nextDialogs": [
              "740850234"
            ]
          },
          "740850234": {
            "id": "740850234",
            "speakerId": 5325,
            "speakerName": "珀西芙",
            "text": "但是，那位来客，十分很忙。",
            "nextDialogs": [
              "740850235"
            ]
          },
          "740850235": {
            "id": "740850235",
            "speakerId": 5325,
            "speakerName": "珀西芙",
            "text": "紫东西，偷偷往根去。紫东西，偷偷破坏根。",
            "nextDialogs": [
              "740850236"
            ]
          },
          "740850236": {
            "id": "740850236",
            "speakerId": 5325,
            "speakerName": "珀西芙",
            "text": "珀西芙，偷偷偷看。珀西芙，偷偷磨石碑。",
            "nextDialogs": [
              "740850237"
            ]
          },
          "740850237": {
            "id": "740850237",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "啊，原来是你把石碑上的字抹掉的！是为了阻止那个家伙吗？",
            "nextDialogs": [
              "740850238"
            ]
          },
          "740850238": {
            "id": "740850238",
            "speakerId": 5325,
            "speakerName": "珀西芙",
            "text": "珀西芙！但是…",
            "nextDialogs": [
              "740850239"
            ]
          },
          "740850239": {
            "id": "740850239",
            "speakerId": 5325,
            "speakerName": "珀西芙",
            "text": "紫东西，还往根去。紫东西，十分很厉害。",
            "nextDialogs": [
              "740850240"
            ]
          },
          "740850240": {
            "id": "740850240",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "他找到了别的路？",
            "nextDialogs": [
              "740850241"
            ]
          },
          "740850241": {
            "id": "740850241",
            "speakerId": 5325,
            "speakerName": "珀西芙",
            "text": "珀西芙！",
            "nextDialogs": [
              "740850242"
            ]
          },
          "740850242": {
            "id": "740850242",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "看来这家伙真的有点难对付啊…破坏了根，信息系统就会失灵，那位来客的感知能力就会受到影响…",
            "nextDialogs": [
              "740850243"
            ]
          },
          "740850243": {
            "id": "740850243",
            "speakerId": 5325,
            "speakerName": "珀西芙",
            "text": "珀西芙，责任！珀西芙，守护！",
            "nextDialogs": [
              "740850244"
            ]
          },
          "740850244": {
            "id": "740850244",
            "speakerId": 5325,
            "speakerName": "珀西芙",
            "text": "#{NICKNAME}，邦邦。派蒙，邦邦。",
            "nextDialogs": [
              "740850245"
            ]
          },
          "740850245": {
            "id": "740850245",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "#{NICKNAME}，看来我们不能再等了！我们现在就要邦邦！",
            "nextDialogs": [
              "740850246"
            ]
          },
          "740850246": {
            "id": "740850246",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "珀西芙！现在就开门吧。",
            "nextDialogs": [
              "740850247"
            ]
          },
          "740850247": {
            "id": "740850247",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "太好了，我们出发！"
          }
        }
      }

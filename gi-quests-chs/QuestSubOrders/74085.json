    {
      "subId": "7408519",
      "subQuestName": "与派蒙对话",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "740851901"
        ],
        "dialogs": {
          "740851901": {
            "id": "740851901",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "糟了，就这么被冲上地面…我们还没找到珀西芙呢！",
            "nextDialogs": [
              "740851902"
            ]
          },
          "740851902": {
            "id": "740851902",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "别担心，珀西芙应该会游泳。",
            "nextDialogs": [
              "740851903"
            ]
          },
          "740851903": {
            "id": "740851903",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "说的也是…呜哇！快看那棵大树！",
            "nextDialogs": [
              "740851904"
            ]
          },
          "740851904": {
            "id": "740851904",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "好漂亮，这就是它本来的样子吗？如果珀西芙看见，一定也会开心吧？",
            "nextDialogs": [
              "740851905"
            ]
          },
          "740851905": {
            "id": "740851905",
            "speakerId": 21113,
            "speakerName": "珀西芙",
            "text": "#派蒙！珀西芙！{NICKNAME}！珀西芙！",
            "nextDialogs": [
              "740851906"
            ]
          },
          "740851906": {
            "id": "740851906",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "珀西芙？太好了，你刚才去哪了？我们还在担心你呢。",
            "nextDialogs": [
              "740851907"
            ]
          },
          "740851907": {
            "id": "740851907",
            "speakerId": 21113,
            "speakerName": "珀西芙",
            "text": "无影踪，珀西芙。",
            "nextDialogs": [
              "740851908"
            ]
          },
          "740851908": {
            "id": "740851908",
            "speakerId": 21113,
            "speakerName": "珀西芙",
            "text": "啊…箱子，珀西芙！",
            "nextDialogs": [
              "740851909"
            ]
          },
          "740851909": {
            "id": "740851909",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "欸？这是…宝箱？你去找宝箱了？",
            "nextDialogs": [
              "740851910"
            ]
          },
          "740851910": {
            "id": "740851910",
            "speakerId": 21113,
            "speakerName": "珀西芙",
            "text": "珀西芙！但是，金灿灿的，圆滚滚的，美露莘…",
            "nextDialogs": [
              "740851911"
            ]
          },
          "740851911": {
            "id": "740851911",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "摩拉没找到？完全没关系啦！光这些宝箱就足够了！",
            "nextDialogs": [
              "740851912"
            ]
          },
          "740851912": {
            "id": "740851912",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "真让人感动，你居然还记得我说过的话，谢谢你！",
            "nextDialogs": [
              "740851913"
            ]
          },
          "740851913": {
            "id": "740851913",
            "speakerId": 21113,
            "speakerName": "珀西芙",
            "text": "谢…谢？",
            "nextDialogs": [
              "740851916"
            ]
          },
          "740851916": {
            "id": "740851916",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "谢谢的意思是珀西芙！",
            "nextDialogs": [
              "740851917"
            ]
          },
          "740851917": {
            "id": "740851917",
            "speakerId": 21113,
            "speakerName": "珀西芙",
            "text": "#派蒙，谢谢！{NICKNAME}，谢谢！",
            "nextDialogs": [
              "740851918"
            ]
          },
          "740851918": {
            "id": "740851918",
            "speakerId": 21113,
            "speakerName": "珀西芙",
            "text": "#派蒙，好东西！{NICKNAME}，好东西！",
            "nextDialogs": [
              "740851919"
            ]
          },
          "740851919": {
            "id": "740851919",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "珀西芙！好东西！",
            "nextDialogs": [
              "740851920"
            ]
          },
          "740851920": {
            "id": "740851920",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "珀西芙！好东西！",
            "nextDialogs": [
              "740851921"
            ]
          },
          "740851921": {
            "id": "740851921",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "#{NICKNAME}，我们以后要是有空，就多来找珀西芙玩吧？再教她说更多话，就像那位来客一样。",
            "nextDialogs": [
              "740851922"
            ]
          },
          "740851922": {
            "id": "740851922",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "珀西芙！",
            "nextDialogs": [
              "740851923"
            ]
          },
          "740851923": {
            "id": "740851923",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "珀西芙，那你说呢，我们以后再来找你玩好不好？咦？！",
            "nextDialogs": [
              "740851924"
            ]
          },
          "740851924": {
            "id": "740851924",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "她怎么又不见了？！",
            "nextDialogs": [
              "740851925"
            ]
          },
          "740851925": {
            "id": "740851925",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "珀西芙，无影踪？",
            "nextDialogs": [
              "740851926"
            ]
          },
          "740851926": {
            "id": "740851926",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "真厉害啊！从来都没有见过这样的美露莘呢…或者说，她其实根本就不像美露莘，反而像一位神秘的野精灵。",
            "nextDialogs": [
              "740851927"
            ]
          },
          "740851927": {
            "id": "740851927",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "不过也许就是因为这样，她才能悄悄地盯住那个坏蛋紫东西吧…",
            "nextDialogs": [
              "740851928"
            ]
          },
          "740851928": {
            "id": "740851928",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "喂！珀西芙！再见啦！如果有下次，我们要教你怎么样好好道别哦！"
          }
        }
      }
    },
    {

            ]
          },
          "740851203": {
            "id": "740851203",
            "speakerId": 1004,
            "speakerName": "Black Screen",
            "text": "珀西芙伸手捂住了你的肚子，有一股暖意从她的掌心传来。\\n你感觉某个能力被强化了。",
            "nextDialogs": [
              "740851204"
            ]
          },
          "740851204": {
            "id": "740851204",
            "speakerId": 5325,
            "speakerName": "珀西芙",
            "text": "珀西芙，累累…",
            "nextDialogs": [
              "740851205"
            ]
          },
          "740851205": {
            "id": "740851205",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "#咦？珀西芙做了什么？{NICKNAME}，你现在看起来是一幅容光焕发的样子。"
          }
        }

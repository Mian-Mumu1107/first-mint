    {
      "subId": "7408516",
      "subQuestName": "与派蒙对话",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "740851701"
        ],
        "dialogs": {
          "740851701": {
            "id": "740851701",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "#呼——终于解决了这些家伙，我们简直是捅了兽境猎犬窝了。{NICKNAME}，你还好吗？",
            "nextDialogs": [
              "740851704"
            ]
          },
          "740851704": {
            "id": "740851704",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "嘿嘿，我相信你不是吹牛哦。看起来根正在恢复，这里的麻烦应该被解决了吧？",
            "nextDialogs": [
              "740851705"
            ]
          },
          "740851705": {
            "id": "740851705",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "不过刚刚是怎么回事？为什么会有一只龙蜥过来帮忙，珀西芙也不见了…",
            "nextDialogs": [
              "740851706"
            ]
          },
          "740851706": {
            "id": "740851706",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "喂——珀西芙！你在吗？能听见吗——",
            "nextDialogs": [
              "740851707"
            ]
          },
          "740851707": {
            "id": "740851707",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "好吧，她好像真的不见了。",
            "nextDialogs": [
              "740851708"
            ]
          },
          "740851708": {
            "id": "740851708",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "她身上还有不少秘密。",
            "nextDialogs": [
              "740851709"
            ]
          },
          "740851709": {
            "id": "740851709",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "唔…真是一个谜团重重的美露莘。虽然也没有想过报酬的事，但她就这么不见了，还是有点奇怪的感觉…",
            "nextDialogs": [
              "740851710"
            ]
          },
          "740851710": {
            "id": "740851710",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "什么感觉？",
            "nextDialogs": [
              "740851711"
            ]
          },
          "740851711": {
            "id": "740851711",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "就像…就像你一直很喜欢的一种料理，突然有天它对你说「我们的关系就到此为止吧」那样奇怪。"
          }
        }
      }
    },

    {
      "subId": "7524001",
      "subQuestName": "(test)隐藏$HIDDEN",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "752400101"
        ],
        "dialogs": {
          "752400101": {
            "id": "752400101",
            "speakerId": 6514,
            "speakerName": "纳瓦特拉利",
            "text": "朋友，欢迎来到阿亚尔英雄杯的比赛现场，我是这里的主持人。",
            "nextDialogs": [
              "752400102"
            ]
          },
          "752400102": {
            "id": "752400102",
            "speakerId": 6514,
            "speakerName": "纳瓦特拉利",
            "text": "今天已经是赛程的最后一天，如果你想夺冠，你必须连续击败排名前三的勇士。",
            "nextDialogs": [
              "752400107"
            ]
          },
          "752400107": {
            "id": "752400107",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "阿亚尔英雄杯是什么？",
            "nextDialogs": [
              "752400108"
            ]
          },
          "752400108": {
            "id": "752400108",
            "speakerId": 6514,
            "speakerName": "纳瓦特拉利",
            "text": "是角逐阿亚尔荣耀的战斗，用你的拳头或者武器或者任何方式击倒对手吧！",
            "nextDialogs": [
              "752400109"
            ]
          },
          "752400109": {
            "id": "752400109",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "阿亚尔又是什么人？",
            "nextDialogs": [
              "752400110"
            ]
          },
          "752400110": {
            "id": "752400110",
            "speakerId": 6514,
            "speakerName": "纳瓦特拉利",
            "text": "朋友，在这里只有冠军才有发问的资格。",
            "nextDialogs": [
              "752400111"
            ]
          },
          "752400111": {
            "id": "752400111",
            "speakerId": 6514,
            "speakerName": "纳瓦特拉利",
            "text": "上台吧，让我看看你有没有实力获得尊敬。"
          }
        }
      }
    },
    {

    {
      "subId": "301101",
      "subQuestName": "与纳西妲对话",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "30111113"
        ],
        "dialogs": {
          "30111113": {
            "id": "30111113",
            "speakerId": 1056,
            "speakerName": "纳西妲",
            "text": "嗯…",
            "nextDialogs": [
              "30111103"
            ]
          },
          "30111103": {
            "id": "30111103",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "对哦！每天晚上虚空的那个音效，说不定就是在删除我们当天的记忆…",
            "nextDialogs": [
              "30111104"
            ]
          },
          "30111104": {
            "id": "30111104",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "所以一觉醒来，所有人都以为花神诞祭还没有度过，明明已经是「明天」了，但都还以为是「昨天」。",
            "nextDialogs": [
              "30111105"
            ]
          },
          "30111105": {
            "id": "30111105",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "可身体记忆是删除不了的，所以迪希雅的新大剑才越用越熟练！这下就都说得通了！",
            "nextDialogs": [
              "30111106"
            ]
          },
          "30111106": {
            "id": "30111106",
            "speakerId": 1056,
            "speakerName": "纳西妲",
            "text": "…很巧妙的推论。",
            "nextDialogs": [
              "30111107"
            ]
          },
          "30111107": {
            "id": "30111107",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "那到底说对了没有呀，纳西妲！",
            "nextDialogs": [
              "30111108"
            ]
          },
          "30111108": {
            "id": "30111108",
            "speakerId": 1056,
            "speakerName": "纳西妲",
            "text": "简单来说的话，像是捉了火元素的晶蝶来当作萤火虫去照明，太过注重「感受」，而忽略了其「本质」。",
            "nextDialogs": [
              "30111109"
            ]
          },
          "30111109": {
            "id": "30111109",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "这一点都不简单…",
            "nextDialogs": [
              "30111110"
            ]
          },
          "30111110": {
            "id": "30111110",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "依旧是错误的结论吗…",
            "nextDialogs": [
              "30111111"
            ]
          },
          "30111111": {
            "id": "30111111",
            "speakerId": 1056,
            "speakerName": "纳西妲",
            "text": "不妨你们再去找那位迪希雅小姐聊聊吧，会有新的收获也说不定。",
            "nextDialogs": [
              "30111112"
            ]
          },
          "30111112": {
            "id": "30111112",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "嗯，毕竟新的线索是从她身上发现的…我们走吧？"
          }
        }
      }
    },
    {
      "subId": "301102",
      "subQuestName": "与迪希雅对话",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "30110201"
        ],
        "dialogs": {
          "30110201": {
            "id": "30110201",
            "speakerId": 1052,
            "speakerName": "迪希雅",
            "text": "…你们原来在这里，可算找到你们了。",
            "nextDialogs": [
              "30110202"
            ]
          },
          "30110202": {
            "id": "30110202",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "今天的迪希雅果然也没有受伤呢。",
            "nextDialogs": [
              "30110203"
            ]
          },
          "30110203": {
            "id": "30110203",
            "speakerId": 1052,
            "speakerName": "迪希雅",
            "text": "受伤？受什么伤？别太小瞧我了。",
            "nextDialogs": [
              "30110204"
            ]
          },
          "30110204": {
            "id": "30110204",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "你的新大剑毕竟不是那么趁手嘛…",
            "nextDialogs": [
              "30110205"
            ]
          },
          "30110205": {
            "id": "30110205",
            "speakerId": 1052,
            "speakerName": "迪希雅",
            "text": "其实我也觉得很奇怪，今天突然就变得趁手了起来…不对，你们怎么知道我换过大剑的事？我应该不可能透露过…",
            "nextDialogs": [
              "30110206"
            ]
          },
          "30110206": {
            "id": "30110206",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "唔，这次还是你来解释吧，我实在已经解释腻了…",
            "nextDialogs": [
              "30110209"
            ]
          },
          "30110209": {
            "id": "30110209",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "这样啊，也是。",
            "nextDialogs": [
              "30110210"
            ]
          },
          "30110210": {
            "id": "30110210",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "你的大剑忽然变得趁手的原因…"
          }
        }
      }
    },
    {
      "subId": "301103",
      "subQuestName": "前往查看迪希雅所说的「证据」",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "30110301"
        ],
        "dialogs": {
          "30110301": {
            "id": "30110301",
            "speakerId": 1052,
            "speakerName": "迪希雅",
            "text": "就是这个了。",
            "nextDialogs": [
              "30110302"
            ]
          },
          "30110302": {
            "id": "30110302",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "这什么呀，你练剑的木人桩吗？这个怎么了？",
            "nextDialogs": [
              "30110303"
            ]
          },
          "30110303": {
            "id": "30110303",
            "speakerId": 1052,
            "speakerName": "迪希雅",
            "text": "看到上面的痕迹了吗？是我这几天的积累。",
            "nextDialogs": [
              "30110304"
            ]
          },
          "30110304": {
            "id": "30110304",
            "speakerId": 1052,
            "speakerName": "迪希雅",
            "text": "假设贤者不会每天来把它换掉，它应该早就已经被砍的破破烂烂了对吧？",
            "nextDialogs": [
              "30110305"
            ]
          },
          "30110305": {
            "id": "30110305",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "对呀，那每天都换一个的情况呢？",
            "nextDialogs": [
              "30110306"
            ]
          },
          "30110306": {
            "id": "30110306",
            "speakerId": 1052,
            "speakerName": "迪希雅",
            "text": "那贤者每次都要在新的木人桩上复制出我之前练剑的剑痕。",
            "nextDialogs": [
              "30110307"
            ]
          },
          "30110307": {
            "id": "30110307",
            "speakerId": 1052,
            "speakerName": "迪希雅",
            "text": "好歹我也是武者，在我的武学流派里，对「控制」的讲求非常精细。",
            "nextDialogs": [
              "30110308"
            ]
          },
          "30110308": {
            "id": "30110308",
            "speakerId": 1052,
            "speakerName": "迪希雅",
            "text": "每一次挥剑，力度、角度、切入点都是用心控制过的，所以上面每一道伤痕我都记得，也记得挥出那一剑的心境。",
            "nextDialogs": [
              "30110309"
            ]
          },
          "30110309": {
            "id": "30110309",
            "speakerId": 1052,
            "speakerName": "迪希雅",
            "text": "正如有句话，武者之剑乃独一无二，没有人可以挥出完全相同的两剑。想要完全复制我的剑痕，绝对不可能。",
            "nextDialogs": [
              "30110310"
            ]
          },
          "30110310": {
            "id": "30110310",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "不可能吗？如果是用什么精细的仪器一点点「雕刻」呢？",
            "nextDialogs": [
              "30110311"
            ]
          },
          "30110311": {
            "id": "30110311",
            "speakerId": 1052,
            "speakerName": "迪希雅",
            "text": "常有人说，留影机的画片永远不能替代画家画出来的风景画，因为前者是没有灵魂的。",
            "nextDialogs": [
              "30110312"
            ]
          },
          "30110312": {
            "id": "30110312",
            "speakerId": 1052,
            "speakerName": "迪希雅",
            "text": "对我也一样，雕刻出的剑痕和作为武艺修炼结晶的剑痕…我一眼就能分辨得出。",
            "nextDialogs": [
              "30110315"
            ]
          },
          "30110315": {
            "id": "30110315",
            "speakerId": 1052,
            "speakerName": "迪希雅",
            "text": "呼…这回应该没什么疑问了吧？欸，这是不是最近学者之间流行的叫做「头脑急转弯」的游戏？想不到还挺有趣的。",
            "nextDialogs": [
              "30110316"
            ]
          },
          "30110316": {
            "id": "30110316",
            "speakerId": 1052,
            "speakerName": "迪希雅",
            "text": "那就这样吧，我看时候也不早了，我护送迪娜泽黛小姐去妮露那边了，回见。",
            "nextDialogs": [
              "30110317"
            ]
          },
          "30110317": {
            "id": "30110317",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "唉…又是一条走不通的路，「记忆删除」理论也是错误的吗？",
            "nextDialogs": [
              "30110318"
            ]
          },
          "30110318": {
            "id": "30110318",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "但至少我们也有了一些阶段性的结论吧？"
          }
        }
      }
    },
    {
      "subId": "301104",
      "subQuestName": "与纳西妲对话",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "30110401"
        ],
        "dialogs": {
          "30110401": {
            "id": "30110401",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "纳西妲，我们回来了。",
            "nextDialogs": [
              "30110402"
            ]
          },
          "30110402": {
            "id": "30110402",
            "speakerId": 1056,
            "speakerName": "纳西妲",
            "text": "今天回来得很早呢，莫非是有了什么新的收获。",
            "nextDialogs": [
              "30110403"
            ]
          },
          "30110403": {
            "id": "30110403",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "算是有吧，我们基本确定了时间并未循环，这里也应该不是现实…可同时我们又有了新的疑惑…",
            "nextDialogs": [
              "30110406"
            ]
          },
          "30110406": {
            "id": "30110406",
            "speakerId": 1056,
            "speakerName": "纳西妲",
            "text": "出城…在我印象里，有两次你们都提及过出城相关的计划…",
            "nextDialogs": [
              "30110407"
            ]
          },
          "30110407": {
            "id": "30110407",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "！？",
            "nextDialogs": [
              "30110408"
            ]
          },
          "30110408": {
            "id": "30110408",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "我们说过吗！我们怎么完全没有印象了，后来呢？我们回来之后怎么说？",
            "nextDialogs": [
              "30110409"
            ]
          },
          "30110409": {
            "id": "30110409",
            "speakerId": 1056,
            "speakerName": "纳西妲",
            "text": "让我想想…好像你们从未提起过出城计划的结果如何，哦，不如说，那两次出城计划的当晚你们都没有回来。",
            "nextDialogs": [
              "30110410"
            ]
          },
          "30110410": {
            "id": "30110410",
            "speakerId": 1056,
            "speakerName": "纳西妲",
            "text": "不过平时你们也有不少个晚上「夜不归宿」的，所以我当时也不觉得这能证明什么。",
            "nextDialogs": [
              "30110411"
            ]
          },
          "30110411": {
            "id": "30110411",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "确实有的时候会调查事情忘了时间，直接就到了第二天。可是你所说的出城当天的记忆，我们两个却都没有。",
            "nextDialogs": [
              "30110412"
            ]
          },
          "30110412": {
            "id": "30110412",
            "speakerId": 1056,
            "speakerName": "纳西妲",
            "text": "这样吗，这倒有些奇怪。理论上应该已经唤起了你们全部的记忆才对。"
          }
        }
      }
    },

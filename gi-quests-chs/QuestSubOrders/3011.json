    {
      "subId": "300803",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "30080301"
        ],
        "dialogs": {
          "30080301": {
            "id": "30080301",
            "speakerId": 12652,
            "speakerName": "阿玛尔",
            "text": "我昨天才去的森林里摘这些货，绝对新鲜，放心吧。"
          }
        }
      }
    },
    {
      "subId": "300810",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "30081001"
        ],
        "dialogs": {
          "30081001": {
            "id": "30081001",
            "speakerId": 4018,
            "speakerName": "齐米亚",
            "text": "这就是神明的智慧啊…"
          }
        }
      }
    },
    {
      "subId": "300811",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "30081101"
        ],
        "dialogs": {
          "30081101": {
            "id": "30081101",
            "speakerId": 12653,
            "speakerName": "毗伽尔",
            "text": "哟吼，年轻的兵士，还有什么要求吗？"
          }
        }
      }
    },
    {
      "subId": "300923",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "30092301"
        ],
        "dialogs": {
          "30092301": {
            "id": "30092301",
            "speakerId": 1056,
            "speakerName": "纳西妲",
            "text": "我们已经没有无数个花神诞祭可以浪费了，抓紧寻找真相吧。"
          }
        }
      }
    },
    {
      "subId": "301101",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "30110101"
        ],
        "dialogs": {
          "30110101": {
            "id": "30110101",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "…结果还是这一天吗！",
            "nextDialogs": [
              "30110102"
            ]
          },
          "30110102": {
            "id": "30110102",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "看来果然没有我们想的那么简单。",
            "nextDialogs": [
              "30110103"
            ]
          },
          "30110103": {
            "id": "30110103",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "纳西妲，其实昨晚你就知道「花神诞日的轮回」还是会继续的吧？怎么不直接和我们说呀！",
            "nextDialogs": [
              "30110104"
            ]
          },
          "30110104": {
            "id": "30110104",
            "speakerId": 1056,
            "speakerName": "纳西妲",
            "text": "说了又如何呢，你们只会在新的焦虑中度过昨晚，明天依旧不会到来。",
            "nextDialogs": [
              "30110105"
            ]
          },
          "30110105": {
            "id": "30110105",
            "speakerId": 1056,
            "speakerName": "纳西妲",
            "text": "反倒不如…在短暂的希望中彻底放松一下自己，这是难得的机会呀，说不定可以让你们的思维变得更加清醒呢。",
            "nextDialogs": [
              "30110106"
            ]
          },
          "30110106": {
            "id": "30110106",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "倒也是…纳西妲还是为我们在考虑的呀。",
            "nextDialogs": [
              "30110107"
            ]
          },
          "30110107": {
            "id": "30110107",
            "speakerId": 1056,
            "speakerName": "纳西妲",
            "text": "当然，至少最近这段时间里，你们就是我的全部嘛。",
            "nextDialogs": [
              "30110108"
            ]
          },
          "30110108": {
            "id": "30110108",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "唔…怎么突然说出这么肉麻的话呀？",
            "nextDialogs": [
              "30110109"
            ]
          },
          "30110109": {
            "id": "30110109",
            "speakerId": 1056,
            "speakerName": "纳西妲",
            "text": "呵呵呵…我的意思是，虽然是我在拜托你们两个破解谜团，但反过来，也只有你们两个才能看到我、感受到我。",
            "nextDialogs": [
              "30110110"
            ]
          },
          "30110110": {
            "id": "30110110",
            "speakerId": 1056,
            "speakerName": "纳西妲",
            "text": "换言之，如果不是有你们两个在的话，我就和「不存在」是没有区别的。所以你们就是我的全部，懂了吗？",
            "nextDialogs": [
              "30110111"
            ]
          },
          "30110111": {
            "id": "30110111",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "纳西妲又在讲些让人摸不着头脑的话了…",
            "nextDialogs": [
              "30110112"
            ]
          },
          "30110112": {
            "id": "30110112",
            "speakerId": 1056,
            "speakerName": "纳西妲",
            "text": "闲聊就到这里吧，根据昨天的新线索，旅行者对「现状」有新的认识了吗？",
            "nextDialogs": [
              "30110113"
            ]
          },
          "30110113": {
            "id": "30110113",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "「时间循环」的确是错误的结论。",
            "nextDialogs": [
              "30110114"
            ]
          },
          "30110114": {
            "id": "30110114",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "欸，为什么忽然否定了之前的想法呢？",
            "nextDialogs": [
              "30110117"
            ]
          },
          "30110117": {
            "id": "30110117",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "唔，是呀，之前好像没有留意这种地方，单纯的时间循环应该会完全重置身体状态…",
            "nextDialogs": [
              "30110118"
            ]
          },
          "30110118": {
            "id": "30110118",
            "speakerId": 1056,
            "speakerName": "纳西妲",
            "text": "那新的结论是什么呢？"
          }
        }
      }
    },
    {
      "subId": "301199",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "30119901"
        ],
        "dialogs": {
          "30119901": {
            "id": "30119901",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "想不到这次是迪希雅带我们去看「证据」，明明前两天还是我们带她去看…",
            "nextDialogs": [
              "30119902"
            ]
          },
          "30119902": {
            "id": "30119902",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "「月亮」、「虚幻」与「谎言」…意味着什么呢？",
            "nextDialogs": [
              "30119903"
            ]
          },
          "30119903": {
            "id": "30119903",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "眼前正在发生的事似乎曾经经历过的一种感觉，最近愈发强烈。",
            "nextDialogs": [
              "30119904"
            ]
          },
          "30119904": {
            "id": "30119904",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "大贤者说「你们就好好庆祝神明的诞生吧」，这句话有什么深意吗？",
            "nextDialogs": [
              "30119905"
            ]
          },
          "30119905": {
            "id": "30119905",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "迪希雅为了帮忙筹钱，卖掉了自己的大剑，并且因为不适应新的大剑而受了伤。",
            "nextDialogs": [
              "30119906"
            ]
          },
          "30119906": {
            "id": "30119906",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "没有进行过多的思考，却感觉头脑异常的疲惫，到底是怎么回事？",
            "nextDialogs": [
              "30119907"
            ]
          },
          "30119907": {
            "id": "30119907",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "我们已经连续度过了许多个花神诞日，花神诞日似乎在不断轮回。",
            "nextDialogs": [
              "30119908"
            ]
          },
          "30119908": {
            "id": "30119908",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "须弥人是不会做梦的，奇怪的现象。",
            "nextDialogs": [
              "30119909"
            ]
          },
          "30119909": {
            "id": "30119909",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "「虚空依靠神之心来运转，是智慧之神力量的具现。它统合全民的智慧，并将知识赐予人民」，纳西妲如是说。",
            "nextDialogs": [
              "30119910"
            ]
          },
          "30119910": {
            "id": "30119910",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "佣兵非常依赖身体记忆，这也让迪希雅在轮回中出现了没有受伤的情况。",
            "nextDialogs": [
              "30119911"
            ]
          },
          "30119911": {
            "id": "30119911",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "「嘀——」的一声，是虚空进行操作的提示音，即便摘掉虚空终端也会在每天的夜晚听到。",
            "nextDialogs": [
              "30119912"
            ]
          },
          "30119912": {
            "id": "30119912",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "出城后我看到的无数景象奇异的空间，它们的共同点是都没有人的气息。",
            "nextDialogs": [
              "30119913"
            ]
          },
          "30119913": {
            "id": "30119913",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "那些空间让我想到了梦境，似乎在道成林时做过这样的梦，只是其中都没有人的气息。",
            "nextDialogs": [
              "30119914"
            ]
          },
          "30119914": {
            "id": "30119914",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "空间在我眼前不断消失，虚空音效响起后，又会有许多空间重新诞生。",
            "nextDialogs": [
              "30119915"
            ]
          },
          "30119915": {
            "id": "30119915",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "那些梦境在不断消失，虚空音效响起后，又会诞生许多新的空间。",
            "nextDialogs": [
              "30119916"
            ]
          },
          "30119916": {
            "id": "30119916",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "难道说那个空间就是现实？可现实空间就这么消失了，应该很不妙吧？",
            "nextDialogs": [
              "30119917"
            ]
          },
          "30119917": {
            "id": "30119917",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "印象里，每一个昨天，都是在虚空音效响起后才结束的…",
            "nextDialogs": [
              "30119918"
            ]
          },
          "30119918": {
            "id": "30119918",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "是那种情况吧，时间的流动在同一天不断循环着。",
            "nextDialogs": [
              "30119919"
            ]
          },
          "30119919": {
            "id": "30119919",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "每过完一天，当天的记忆都会被删除的话，也会不自觉地一直过着同一天呢。",
            "nextDialogs": [
              "30119920"
            ]
          },
          "30119920": {
            "id": "30119920",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "我们都在梦里。须弥人并非不会做梦，只是梦境都被虚空夺走了。",
            "nextDialogs": [
              "30119921"
            ]
          },
          "30119921": {
            "id": "30119921",
            "speakerId": 1056,
            "speakerName": "纳西妲",
            "text": "虚空依靠神之心来运转。",
            "nextDialogs": [
              "30119922"
            ]
          },
          "30119922": {
            "id": "30119922",
            "speakerId": 1056,
            "speakerName": "纳西妲",
            "text": "是智慧之神力量的具现。",
            "nextDialogs": [
              "30119923"
            ]
          },
          "30119923": {
            "id": "30119923",
            "speakerId": 1056,
            "speakerName": "纳西妲",
            "text": "它统合全民的智慧。",
            "nextDialogs": [
              "30119924"
            ]
          },
          "30119924": {
            "id": "30119924",
            "speakerId": 1056,
            "speakerName": "纳西妲",
            "text": "并将知识赐予人民。",
            "nextDialogs": [
              "30119925"
            ]
          },
          "30119925": {
            "id": "30119925",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "炼金占卜据说是神明的启示，纳西妲又曾把自己比作「月亮」，看来…",
            "nextDialogs": [
              "30119926"
            ]
          },
          "30119926": {
            "id": "30119926",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "现在想来，「虚幻」是对我们在梦中这一现状的暗示吧？",
            "nextDialogs": [
              "30119927"
            ]
          },
          "30119927": {
            "id": "30119927",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "现在想来，指的应该是贤者对须弥人民的欺骗吧？",
            "nextDialogs": [
              "30119928"
            ]
          },
          "30119928": {
            "id": "30119928",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "好像不对…还是要再好好考虑一下…",
            "nextDialogs": [
              "30119929"
            ]
          },
          "30119929": {
            "id": "30119929",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "这之间…好像构不成什么有效的联想。"
          }
        }
      }
    }
  ]

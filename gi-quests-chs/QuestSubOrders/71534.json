        ],
        "dialogs": {
          "715340301": {
            "id": "715340301",
            "speakerId": 1038,
            "speakerName": "九条裟罗",
            "text": "原来如此。这样做出来的「祝柬」的确好看。",
            "nextDialogs": [
              "715340302"
            ]
          },
          "715340302": {
            "id": "715340302",
            "speakerId": 1038,
            "speakerName": "九条裟罗",
            "text": "谢谢你帮我做了这份「祝柬」。这样我也算是有了份纪念品，不算白来一趟。",
            "nextDialogs": [
              "715340303"
            ]
          },
          "715340303": {
            "id": "715340303",
            "speakerId": 1038,
            "speakerName": "九条裟罗",
            "text": "多谢你费心了，下次来稻妻，我请你喝茶。"
          }
        }
      }
    },

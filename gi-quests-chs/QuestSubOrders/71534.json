  "subQuests": [
    {
      "subId": "7153401",
      "subQuestName": "等待至次日的8时至18时",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "715340101"
        ],
        "dialogs": {
          "715340101": {
            "id": "715340101",
            "speakerId": 1038,
            "speakerName": "九条裟罗",
            "text": "唔，还是先参考一下其他「祝柬」吧…",
            "nextDialogs": [
              "715340102"
            ]
          },
          "715340102": {
            "id": "715340102",
            "speakerId": 1038,
            "speakerName": "九条裟罗",
            "text": "#{NICKNAME}，许久未见……你为什么一副惊讶的表情？",
            "nextDialogs": [
              "715340103"
            ]
          },
          "715340103": {
            "id": "715340103",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "不，就是没想到…",
            "nextDialogs": [
              "715340104"
            ]
          },
          "715340104": {
            "id": "715340104",
            "speakerId": 1038,
            "speakerName": "九条裟罗",
            "text": "没想到我一介武人，也有来海灯节的雅致？",
            "nextDialogs": [
              "715340105"
            ]
          },
          "715340105": {
            "id": "715340105",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "平时都没见你怎么放松过…",
            "nextDialogs": [
              "715340106"
            ]
          },
          "715340106": {
            "id": "715340106",
            "speakerId": 1038,
            "speakerName": "九条裟罗",
            "text": "「天领奉行」责任重大，我身为其中一员，平时容不得一丝一毫的放松。",
            "nextDialogs": [
              "715340107"
            ]
          },
          "715340107": {
            "id": "715340107",
            "speakerId": 1038,
            "speakerName": "九条裟罗",
            "text": "在旁人看来，我或许的确是一位不懂雅致的武人…与花见坂里的那些舞乐之声格格不入。",
            "nextDialogs": [
              "715340108"
            ]
          },
          "715340108": {
            "id": "715340108",
            "speakerId": 1038,
            "speakerName": "九条裟罗",
            "text": "但是，如果我在平日里随意放松心神，让宵小之徒有可乘之机，那…只怕不仅是我，整个花见坂的舞乐声都会沉寂下去吧。",
            "nextDialogs": [
              "715340109"
            ]
          },
          "715340109": {
            "id": "715340109",
            "speakerId": 1038,
            "speakerName": "九条裟罗",
            "text": "最多，就像这样见缝插针，勉强抽出些空闲来四处走走。",
            "nextDialogs": [
              "715340110"
            ]
          },
          "715340110": {
            "id": "715340110",
            "speakerId": 1038,
            "speakerName": "九条裟罗",
            "text": "抱歉，佳节当前，不该说这些严肃的事。",
            "nextDialogs": [
              "715340111"
            ]
          },
          "715340111": {
            "id": "715340111",
            "speakerId": 1038,
            "speakerName": "九条裟罗",
            "text": "我正在试着做一封「祝柬」，但始终不得其法，如果你愿意的话，能给我一些制作的建议么？",
            "nextDialogs": [
              "715340112"
            ]
          },
          "715340112": {
            "id": "715340112",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "好啊，让我想想…"
          }
        }
      }
    },

              "400400102"
            ]
          },
          "400400102": {
            "id": "400400102",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "「藏影灯」？是没听过的东西呢！",
            "nextDialogs": [
              "400400103"
            ]
          },
          "400400103": {
            "id": "400400103",
            "speakerId": 1000,
            "speakerName": "元蓉",
            "text": "那边两位，对我的新发明「藏影灯」有兴趣吗？是个很有趣的装置哦！",
            "nextDialogs": [
              "400400104"
            ]
          },
          "400400104": {
            "id": "400400104",
            "speakerId": 1000,
            "speakerName": "元蓉",
            "text": "只要用正确的方式转动「藏影灯」内的物件，让它们的影子彼此拼合，就能看到不可思议的影像。",
            "nextDialogs": [
              "400400106"
            ]
          },
          "400400106": {
            "id": "400400106",
            "speakerId": 1000,
            "speakerName": "元蓉",
            "text": "你要是感兴趣的话，不妨亲自尝试一次。装置就在这里，请试着使用吧。",
            "nextDialogs": [
              "400400107"
            ]
          },
          "400400107": {
            "id": "400400107",
            "speakerId": 1000,
            "speakerName": "元蓉",
            "text": "希望「藏影灯」也能让你看到奇妙的影像。",
            "nextDialogs": [
              "400400108"
            ]
          },
          "400400108": {
            "id": "400400108",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "听起来很有意思呀，我们也玩玩看吧！"
          }
        }
      }
    }

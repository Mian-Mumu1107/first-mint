        "dialogs": {
          "790501601": {
            "id": "790501601",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "好了，大功告成！",
            "nextDialogs": [
              "790501602"
            ]
          },
          "790501602": {
            "id": "790501602",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "「小水珠」们都很开心的样子，我也很有成就感！",
            "nextDialogs": [
              "790501605"
            ]
          },
          "790501605": {
            "id": "790501605",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "没错，看「小水珠」们的反应，它们都很重视那位画家呢。我们还没找齐所有日记，读完那个画家留下的信息…",
            "nextDialogs": [
              "790501606"
            ]
          },
          "790501606": {
            "id": "790501606",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "如果不忙的话，我们还可以在山洞里逛一逛，看看哪里还有其他的日记！",
            "nextDialogs": [
              "790501607"
            ]
          },
          "790501607": {
            "id": "790501607",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "话说回来，这幅画的风格还蛮特别的…看起来不算特别华丽，但也非常美观？",
            "nextDialogs": [
              "790501608"
            ]
          },
          "790501608": {
            "id": "790501608",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "重要的是，我也能看懂，说不定，模仿一下这幅壁画的风格，我也能画出很漂亮，很好懂的画！"
          }
        }

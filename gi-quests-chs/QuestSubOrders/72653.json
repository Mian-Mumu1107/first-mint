  "subQuests": [
    {
      "subId": "7265301",
      "subQuestName": "与慕珍对话",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "726530101"
        ],
        "dialogs": {
          "726530101": {
            "id": "726530101",
            "speakerId": 30055,
            "speakerName": "慕珍",
            "text": "旅行者，你回来了！",
            "nextDialogs": [
              "726530102"
            ]
          },
          "726530102": {
            "id": "726530102",
            "speakerId": 30055,
            "speakerName": "慕珍",
            "text": "你之前带回的那些晶片，我在船上研究了一番。看起来它们还很…「年轻」。",
            "nextDialogs": [
              "726530103"
            ]
          },
          "726530103": {
            "id": "726530103",
            "speakerId": 30055,
            "speakerName": "慕珍",
            "text": "这说明它们来自于新形成的元素结团…嗯，打个比方说，就像不久前才留在雪地上的、更深些的脚印。",
            "nextDialogs": [
              "726530104"
            ]
          },
          "726530104": {
            "id": "726530104",
            "speakerId": 30055,
            "speakerName": "慕珍",
            "text": "而现在呢，我希望你能帮我调查一下那些更「浅」的脚印…逆着它们的方向，往源头追查！",
            "nextDialogs": [
              "726530105"
            ]
          },
          "726530105": {
            "id": "726530105",
            "speakerId": 30055,
            "speakerName": "慕珍",
            "text": "所谓「更浅的脚印」呢，就是指那些已经凝结到一定程度，在地面附近沉积的雷元素聚合体。",
            "nextDialogs": [
              "726530106"
            ]
          },
          "726530106": {
            "id": "726530106",
            "speakerId": 30055,
            "speakerName": "慕珍",
            "text": "如果能够取得一定量的样本加以分类对比，或许能够画出大致的路线图…",
            "nextDialogs": [
              "726530107"
            ]
          },
          "726530107": {
            "id": "726530107",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "什么…深浅脚印、路线图的…没听懂呢…",
            "nextDialogs": [
              "726530108"
            ]
          },
          "726530108": {
            "id": "726530108",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "唔…确实难懂呢。",
            "nextDialogs": [
              "726530109"
            ]
          },
          "726530109": {
            "id": "726530109",
            "speakerId": 30055,
            "speakerName": "慕珍",
            "text": "哈哈，我打的比方可能有点不太贴切，不过你到了报告地点，自然就会知道了。",
            "nextDialogs": [
              "726530110"
            ]
          },
          "726530110": {
            "id": "726530110",
            "speakerId": 30055,
            "speakerName": "慕珍",
            "text": "好了，闲话不多说，快点出发吧！"
          }
        }
      }
    },
    {

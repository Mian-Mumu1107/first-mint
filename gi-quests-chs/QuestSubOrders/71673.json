{
  "lineCounts": {
    "Player": 3,
    "闻冀": 11
  },
  "subQuests": [
    {
      "subId": "7167301",
      "subQuestName": "与闻冀对话",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "716730101"
        ],
        "dialogs": {
          "716730101": {
            "id": "716730101",
            "speakerId": 1000,
            "speakerName": "闻冀",
            "text": "嗯…总感觉这幅画里缺了点什么，是不是应该再找点灵感呢…",
            "nextDialogs": [
              "716730102"
            ]
          },
          "716730102": {
            "id": "716730102",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "你是在…",
            "nextDialogs": [
              "716730103"
            ]
          },
          "716730103": {
            "id": "716730103",
            "speakerId": 1000,
            "speakerName": "闻冀",
            "text": "#哎，这不是{NICKNAME}么？久闻大名，久仰啊。",
            "nextDialogs": [
              "716730104"
            ]
          },
          "716730104": {
            "id": "716730104",
            "speakerId": 1000,
            "speakerName": "闻冀",
            "text": "如您所见，在下正遵照总务司的安排，在这里布置节日游乐之所。",
            "nextDialogs": [
              "716730105"
            ]
          },
          "716730105": {
            "id": "716730105",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "呃…你要教人画画？",
            "nextDialogs": [
              "716730106"
            ]
          },
          "716730106": {
            "id": "716730106",
            "speakerId": 1000,
            "speakerName": "闻冀",
            "text": "哎，非也非也，并非是「教人作画」，而是「替人作画」。",
            "nextDialogs": [
              "716730107"
            ]
          },
          "716730107": {
            "id": "716730107",
            "speakerId": 1000,
            "speakerName": "闻冀",
            "text": "这海灯节一年比一年盛大，来往的客人也越来越多，其中不乏从璃月之外远道而来的游客。",
            "nextDialogs": [
              "716730108"
            ]
          },
          "716730108": {
            "id": "716730108",
            "speakerId": 1000,
            "speakerName": "闻冀",
            "text": "虽然总务司也为他们安排了无偿的「纪念留影」，但留影嘛，毕竟还是缺少了点璃月风味。",
            "nextDialogs": [
              "716730109"
            ]
          },
          "716730109": {
            "id": "716730109",
            "speakerId": 1000,
            "speakerName": "闻冀",
            "text": "于是，总务司就命我来港口，替来往游客作画留念。",
            "nextDialogs": [
              "716730110"
            ]
          },
          "716730110": {
            "id": "716730110",
            "speakerId": 1000,
            "speakerName": "闻冀",
            "text": "我看最近在璃月港内，「白马仙人」的传说最为炙手可热，就想着干脆以此为主题作画好了。",
            "nextDialogs": [
              "716730111"
            ]
          },
          "716730111": {
            "id": "716730111",
            "speakerId": 1000,
            "speakerName": "闻冀",
            "text": "所谓龙腾虎跃，龙马精神，替各位客人以白马奔腾为题，作一幅「腾跃之画」，再吉利不过了啊。",
            "nextDialogs": [
              "716730112"
            ]
          },
          "716730112": {
            "id": "716730112",
            "speakerId": 1000,
            "speakerName": "闻冀",
            "text": "#怎么样，{NICKNAME}，你心中可有什么适合作画的意象？",
            "nextDialogs": [
              "716730113"
            ]
          },
          "716730113": {
            "id": "716730113",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "那还挺多的…",
            "nextDialogs": [
              "716730114"
            ]
          },
          "716730114": {
            "id": "716730114",
            "speakerId": 1000,
            "speakerName": "闻冀",
            "text": "噢？哈哈哈哈，那好啊，有灵感的话，就尽管说来，待我为你泼墨一番！"
          }
        }
      }
    }
  ]
}
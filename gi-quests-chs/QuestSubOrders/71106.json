    {
      "subId": "7110601",
      "subQuestName": "回翘英庄找罗叔$HIDDEN",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "711060101"
        ],
        "dialogs": {
          "711060101": {
            "id": "711060101",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "罗叔，我们回来啦！",
            "nextDialogs": [
              "711060102"
            ]
          },
          "711060102": {
            "id": "711060102",
            "speakerId": 2491,
            "speakerName": "罗叔",
            "text": "哦哦，辛苦你们了！维护茶釜的技师已经到了，正在那边鼓捣着呢。",
            "nextDialogs": [
              "711060103"
            ]
          },
          "711060103": {
            "id": "711060103",
            "speakerId": 2491,
            "speakerName": "罗叔",
            "text": "唉，也不知道是什么地方出了问题…",
            "nextDialogs": [
              "711060104"
            ]
          },
          "711060104": {
            "id": "711060104",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "呃…所以她在干什么？",
            "nextDialogs": [
              "711060105"
            ]
          },
          "711060105": {
            "id": "711060105",
            "speakerId": 2491,
            "speakerName": "罗叔",
            "text": "嗨，他们技师的行话我也听不懂，什么结构分析，什么键什么图的…反正就是在检查茶釜吧。",
            "nextDialogs": [
              "711060106"
            ]
          },
          "711060106": {
            "id": "711060106",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "啊，去那边了…",
            "nextDialogs": [
              "711060107"
            ]
          },
          "711060107": {
            "id": "711060107",
            "speakerId": 2491,
            "speakerName": "罗叔",
            "text": "……",
            "nextDialogs": [
              "711060111",
              "711060110"
            ]
          },
          "711060111": {
            "id": "711060111",
            "speakerId": 1002,
            "speakerName": "Black Screen",
            "text": "沃特蒙泰涅小姐身手轻盈地完成了检查…",
            "nextDialogs": [
              "711060112"
            ]
          },
          "711060112": {
            "id": "711060112",
            "speakerId": 2498,
            "speakerName": "沃特蒙泰涅",
            "text": "罗先生！茶釜的检查已经完成啦，目前来看…",
            "nextDialogs": [
              "711060113"
            ]
          },
          "711060113": {
            "id": "711060113",
            "speakerId": 2498,
            "speakerName": "沃特蒙泰涅",
            "text": "咦？你们两位也回来了呀！"
          },
          "711060110": {
            "id": "711060110",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "不，好像完全不是一回事吧！"
          }
        }
      }
    },
    {

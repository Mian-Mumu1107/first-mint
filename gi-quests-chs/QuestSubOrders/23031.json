      }
    },
    {
      "subId": "2303103",
      "subQuestName": "与凯万对话",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "230310601"
        ],
        "dialogs": {
          "230310601": {
            "id": "230310601",
            "speakerId": 4163,
            "speakerName": "凯万",
            "text": "好极了，材料齐全了，看我制作独一无二的鱼饵。",
            "nextDialogs": [
              "230310602"
            ]
          },
          "230310602": {
            "id": "230310602",
            "speakerId": 1001,
            "speakerName": "Black Screen",
            "text": "凯万熟练地制作了鱼饵",
            "nextDialogs": [
              "230310603"
            ]
          },
          "230310603": {
            "id": "230310603",
            "speakerId": 4163,
            "speakerName": "凯万",
            "text": "好，开始钓鱼了。",
            "nextDialogs": [
              "230310604"
            ]
          },
          "230310604": {
            "id": "230310604",
            "speakerId": 4163,
            "speakerName": "凯万",
            "text": "鱼钩入水深度合格…水流速度适中…",
            "nextDialogs": [
              "230310605"
            ]
          },
          "230310605": {
            "id": "230310605",
            "speakerId": 4163,
            "speakerName": "凯万",
            "text": "你们要保持安静，水里的鱼可是很敏感的。",
            "nextDialogs": [
              "230310606"
            ]
          },
          "230310606": {
            "id": "230310606",
            "speakerId": 4163,
            "speakerName": "凯万",
            "text": "岸边的脚步声也有可能惊动到它们。",
            "nextDialogs": [
              "230310609"
            ]
          },
          "230310609": {
            "id": "230310609",
            "speakerId": 4163,
            "speakerName": "凯万",
            "text": "那你们就沉住气，安心等待吧…",
            "nextDialogs": [
              "230310610"
            ]
          },
          "230310610": {
            "id": "230310610",
            "speakerId": 1001,
            "speakerName": "Black Screen",
            "text": "凯万钓到了一袋湿漉漉的东西",
            "nextDialogs": [
              "230310611"
            ]
          },
          "230310611": {
            "id": "230310611",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "这是什么嘛，根本不是鱼！",
            "nextDialogs": [
              "230310612"
            ]
          },
          "230310612": {
            "id": "230310612",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "确实没见过这种「鱼」。",
            "nextDialogs": [
              "230310613"
            ]
          },
          "230310613": {
            "id": "230310613",
            "speakerId": 4163,
            "speakerName": "凯万",
            "text": "果然还是这样啊，完全不意外。",
            "nextDialogs": [
              "230310614"
            ]
          },
          "230310614": {
            "id": "230310614",
            "speakerId": 4163,
            "speakerName": "凯万",
            "text": "咳咳，异乡人，心态放宽点，别太计较细节问题。",
            "nextDialogs": [
              "230310615"
            ]
          },
          "230310615": {
            "id": "230310615",
            "speakerId": 4163,
            "speakerName": "凯万",
            "text": "鱼钩带出水面的东西，都可以被看成是钓上来的「鱼」。",
            "nextDialogs": [
              "230310616"
            ]
          },
          "230310616": {
            "id": "230310616",
            "speakerId": 4163,
            "speakerName": "凯万",
            "text": "不瞒你说，我这最厉害的渔师可不是自封的。",
            "nextDialogs": [
              "230310617"
            ]
          },
          "230310617": {
            "id": "230310617",
            "speakerId": 4163,
            "speakerName": "凯万",
            "text": "毕竟每次都钓上这种不会咬钩的，不算活物的东西，也算是一种本事吧…",
            "nextDialogs": [
              "230310618"
            ]
          },
          "230310618": {
            "id": "230310618",
            "speakerId": 4163,
            "speakerName": "凯万",
            "text": "其他渔师也都赞叹过我，说我有着独一无二的才能。"
          }
        }
      }
    },
    {
      "subId": "2303104",
      "subQuestName": "寻找凯万需要的材料",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "230310401"
        ],
        "dialogs": {
          "230310401": {
            "id": "230310401",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "那你需要什么材料？",
            "nextDialogs": [
              "230310402"
            ]
          },
          "230310402": {
            "id": "230310402",
            "speakerId": 4163,
            "speakerName": "凯万",
            "text": "根据今天的直觉…就用我常采摘的一种蘑菇好了。",
            "nextDialogs": [
              "230310403"
            ]
          },
          "230310403": {
            "id": "230310403",
            "speakerId": 4163,
            "speakerName": "凯万",
            "text": "我经常使用的蘑菇生长在一片特别的地区，我给你们说明一下方位。",
            "nextDialogs": [
              "230310404"
            ]
          },
          "230310404": {
            "id": "230310404",
            "speakerId": 4163,
            "speakerName": "凯万",
            "text": "麻烦你们帮我找找这种材料了。"
          }
        }
      }
    },
    {
      "subId": "2303105",
      "subQuestName": "将鱼饵的材料交给凯万",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "230310501"
        ],
        "dialogs": {
          "230310501": {
            "id": "230310501",
            "speakerId": 4163,
            "speakerName": "凯万",
            "text": "这次的鱼饵需要日落果，小麦和墩墩桃，你准备好了吗？"
          }
        }
      }
    },

    {
      "subId": "2303101",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "230310101"
        ],
        "dialogs": {
          "230310101": {
            "id": "230310101",
            "speakerId": 4163,
            "speakerName": "凯万",
            "text": "哟，看你的样子…是旅行者吧？居然会来这种地方闲逛，很有闲情雅致啊。",
            "nextDialogs": [
              "230310102"
            ]
          },
          "230310102": {
            "id": "230310102",
            "speakerId": 4163,
            "speakerName": "凯万",
            "text": "还是说，你也是钓鱼客，相中了这片水域？",
            "nextDialogs": [
              "230310103"
            ]
          },
          "230310103": {
            "id": "230310103",
            "speakerId": 4163,
            "speakerName": "凯万",
            "text": "眼光不错！这里是附近最好的钓鱼点了。",
            "nextDialogs": [
              "230310104"
            ]
          },
          "230310104": {
            "id": "230310104",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "可这附近好像没有其他人在钓鱼啊？你怎么这么肯定？",
            "nextDialogs": [
              "230310105"
            ]
          },
          "230310105": {
            "id": "230310105",
            "speakerId": 4163,
            "speakerName": "凯万",
            "text": "那当然是因为我眼光独到了。",
            "nextDialogs": [
              "230310106"
            ]
          },
          "230310106": {
            "id": "230310106",
            "speakerId": 4163,
            "speakerName": "凯万",
            "text": "身为这一带最厉害的渔师，选择钓鱼点的方法当然也有讲究。",
            "nextDialogs": [
              "230310107"
            ]
          },
          "230310107": {
            "id": "230310107",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "真…真的吗？",
            "nextDialogs": [
              "230310108"
            ]
          },
          "230310108": {
            "id": "230310108",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "你好像没什么收获欸？",
            "nextDialogs": [
              "230310109"
            ]
          },
          "230310109": {
            "id": "230310109",
            "speakerId": 4163,
            "speakerName": "凯万",
            "text": "话都说到这份上了，就让你们见识一下「鱼钩上的绝景」吧。",
            "nextDialogs": [
              "230310112"
            ]
          },
          "230310112": {
            "id": "230310112",
            "speakerId": 4163,
            "speakerName": "凯万",
            "text": "你给我特别的材料，我手制鱼饵，钓出你从没见过的「鱼」。",
            "nextDialogs": [
              "230310113"
            ]
          },
          "230310113": {
            "id": "230310113",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "怎么感觉有点可疑？手制鱼饵真的靠谱吗？",
            "nextDialogs": [
              "230310114"
            ]
          },
          "230310114": {
            "id": "230310114",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "试试也无妨。",
            "nextDialogs": [
              "230310115"
            ]
          },
          "230310115": {
            "id": "230310115",
            "speakerId": 4163,
            "speakerName": "凯万",
            "text": "爽快，我就喜欢和这样的人打交道！",
            "nextDialogs": [
              "230310116"
            ]
          },
          "230310116": {
            "id": "230310116",
            "speakerId": 4163,
            "speakerName": "凯万",
            "text": "我的手制鱼饵除了作为基底的日落果和小麦以外，还有一种赋予其灵性的材料。"
          }
        }
      }
    },

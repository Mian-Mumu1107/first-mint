  "subQuests": [
    {
      "subId": "2303101",
      "subQuestName": "与凯万对话",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "230310201"
        ],
        "dialogs": {
          "230310201": {
            "id": "230310201",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "那你需要什么材料？",
            "nextDialogs": [
              "230310202"
            ]
          },
          "230310202": {
            "id": "230310202",
            "speakerId": 4163,
            "speakerName": "凯万",
            "text": "根据今天的直觉…就用墩墩桃好了。",
            "nextDialogs": [
              "230310203"
            ]
          },
          "230310203": {
            "id": "230310203",
            "speakerId": 4163,
            "speakerName": "凯万",
            "text": "虽然平时很常见，但很少有人把它当成鱼饵的材料。",
            "nextDialogs": [
              "230310204"
            ]
          },
          "230310204": {
            "id": "230310204",
            "speakerId": 4163,
            "speakerName": "凯万",
            "text": "麻烦你们帮我找找这种材料了。"
          }
        }
      }
    },
    {
      "subId": "2303102",
      "subQuestName": "将鱼饵的材料交给凯万",
      "sceneId": null,
      "locations": [],

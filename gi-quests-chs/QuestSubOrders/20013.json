          "200130101"
        ],
        "dialogs": {
          "200130101": {
            "id": "200130101",
            "speakerId": 141301,
            "speakerName": "杰克",
            "text": "快来救救我！"
          }
        }
      }
    },
    {
      "subId": "2001302",
      "subQuestName": "(test)击败附近怪物$HIDDEN",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "200130201"
        ],
        "dialogs": {
          "200130201": {
            "id": "200130201",
            "speakerId": 141301,
            "speakerName": "杰克",
            "text": "原来是旅行者，实在是太感谢了。",
            "nextDialogs": [
              "200130202"
            ]
          },
          "200130202": {
            "id": "200130202",
            "speakerId": 141301,
            "speakerName": "杰克",
            "text": "你能再帮我一个小忙吗…",
            "nextDialogs": [
              "200130203"
            ]
          },
          "200130203": {
            "id": "200130203",
            "speakerId": 141301,
            "speakerName": "杰克",
            "text": "这个路障竖在这里，把我的冒险之路给截断了…。",
            "nextDialogs": [
              "200130204"
            ]
          },
          "200130204": {
            "id": "200130204",
            "speakerId": 141301,
            "speakerName": "杰克",
            "text": "你能帮我把这个路障清理掉吗？",
            "nextDialogs": [
              "200130207",
              "200130208"
            ]
          },
          "200130207": {
            "id": "200130207",
            "speakerId": 141301,
            "speakerName": "杰克",
            "text": "唉，要是能像你一样，我早就成为个伟大的冒险家了。"
          },
          "200130208": {
            "id": "200130208",
            "speakerId": 141301,
            "speakerName": "杰克",
            "text": "别啊，我伟大的冒险之旅可不能终结在此，拜托你帮帮我吧！"
          }
        }
      }
    },
    {
      "subId": "2001303",
      "subQuestName": "消灭所有魔物并摧毁路障",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "200130301"
        ],
        "dialogs": {
          "200130301": {
            "id": "200130301",
            "speakerId": 1212,
            "speakerName": "杰克",
            "text": "太感谢你了，旅行者。",
            "nextDialogs": [
              "200130302"
            ]
          },
          "200130302": {
            "id": "200130302",
            "speakerId": 1212,
            "speakerName": "杰克",
            "text": "我本来是想去斯坦利先生冒险过的地方看看，但是没想到半路上遇见了这群家伙…",
            "nextDialogs": [
              "200130303"
            ]
          },
          "200130303": {
            "id": "200130303",
            "speakerId": 1212,
            "speakerName": "杰克",
            "text": "我的实力还是太弱了，假如是斯坦利先生，肯定能把这群家伙全部消灭。",
            "nextDialogs": [
              "200130304"
            ]
          },
          "200130304": {
            "id": "200130304",
            "speakerId": 1212,
            "speakerName": "杰克",
            "text": "要是你愿意和我一起去冒险…还是算了，不能事事都依靠别人。",
            "nextDialogs": [
              "200130305"
            ]
          },
          "200130305": {
            "id": "200130305",
            "speakerId": 1212,
            "speakerName": "杰克",
            "text": "我要接着往前走了，这个给你，我在路上摘了好多做干粮…",
            "nextDialogs": [
              "200130306"
            ]
          },
          "200130306": {
            "id": "200130306",
            "speakerId": 1212,
            "speakerName": "杰克",
            "text": "不过，这也不能叫「干粮」，对吧。"
          }
        }
      }
    },

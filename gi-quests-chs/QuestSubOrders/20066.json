  },
  "subQuests": [
    {
      "subId": "2006601",
      "subQuestName": "与艾琳对话",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "200660101"
        ],
        "dialogs": {
          "200660101": {
            "id": "200660101",
            "speakerId": 1605,
            "speakerName": "艾琳",
            "text": "伤脑筋…这里要怎么解决啊…",
            "nextDialogs": [
              "200660102"
            ]
          },
          "200660102": {
            "id": "200660102",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "你在做什么呢？",
            "nextDialogs": [
              "200660103"
            ]
          },
          "200660103": {
            "id": "200660103",
            "speakerId": 1605,
            "speakerName": "艾琳",
            "text": "为了下一次的骑士选拔，我正在训练呢。",
            "nextDialogs": [
              "200660104"
            ]
          },
          "200660104": {
            "id": "200660104",
            "speakerId": 1605,
            "speakerName": "艾琳",
            "text": "唔…不过，我可没有琴大人那样的力量。",
            "nextDialogs": [
              "200660105"
            ]
          },
          "200660105": {
            "id": "200660105",
            "speakerId": 1605,
            "speakerName": "艾琳",
            "text": "比起锻炼「力量」，我觉得学习「技巧」更适合我。",
            "nextDialogs": [
              "200660106"
            ]
          },
          "200660106": {
            "id": "200660106",
            "speakerId": 1605,
            "speakerName": "艾琳",
            "text": "比如，一口气把这些木桩全部破坏掉的方法…虽然看上去这些木桩不太结实…但是，好歹也是老爸辛苦找给我的，可不能辜负了他。",
            "nextDialogs": [
              "200660107"
            ]
          },
          "200660107": {
            "id": "200660107",
            "speakerId": 1605,
            "speakerName": "艾琳",
            "text": "你有空的话，也和我一起来想一想吧。",
            "nextDialogs": [
              "200660110",
              "200660112"
            ]
          },
          "200660110": {
            "id": "200660110",
            "speakerId": 1605,
            "speakerName": "艾琳",
            "text": "没关系，好好想喔，木桩不会自己跑掉。",
            "nextDialogs": [
              "200660111"
            ]
          },
          "200660111": {
            "id": "200660111",
            "speakerId": 1605,
            "speakerName": "艾琳",
            "text": "唯一会自己跑掉的只有被消耗的时间和生命，唔…",
            "nextDialogs": [
              "200660114"
            ]
          },
          "200660114": {
            "id": "200660114",
            "speakerId": 1605,
            "speakerName": "艾琳",
            "text": "这种距离，自己对付一边，丢个炸弹炸掉另外一边就是最好的选择啦！",
            "nextDialogs": [
              "200660115"
            ]
          },
          "200660115": {
            "id": "200660115",
            "speakerId": 1605,
            "speakerName": "艾琳",
            "text": "哈哈哈我开玩笑的，炸弹这种东西，怎么可能这么轻松找到啦。"
          },
          "200660112": {
            "id": "200660112",
            "speakerId": 1605,
            "speakerName": "艾琳",
            "text": "你习惯团体作战吗？真羡慕啊…随时都能叫到帮手的人。",
            "nextDialogs": [
              "200660113"
            ]
          },
          "200660113": {
            "id": "200660113",
            "speakerId": 1605,
            "speakerName": "艾琳",
            "text": "像我这样的，只能学习独自作战啦。"
          }
        }
      }
    },
    {
      "subId": "2006602",
      "subQuestName": "在2秒内摧毁所有木桩",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "200660201"
        ],
        "dialogs": {
          "200660201": {
            "id": "200660201",
            "speakerId": 1605,
            "speakerName": "艾琳",
            "text": "怎么样？想到好方法了吗？",
            "nextDialogs": [
              "200660202"
            ]
          },
          "200660202": {
            "id": "200660202",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "还没有想好…",
            "nextDialogs": [
              "200660203"
            ]
          },
          "200660203": {
            "id": "200660203",
            "speakerId": 1605,
            "speakerName": "艾琳",
            "text": "嗯…我之前遇见的冒险家，有些也偶尔会这样呢。",
            "nextDialogs": [
              "200660204"
            ]
          },
          "200660204": {
            "id": "200660204",
            "speakerId": 1605,
            "speakerName": "艾琳",
            "text": "面对怪物时能利落地战斗，打木桩的时候却手忙脚乱。",
            "nextDialogs": [
              "200660205"
            ]
          },
          "200660205": {
            "id": "200660205",
            "speakerId": 1605,
            "speakerName": "艾琳",
            "text": "而且还用各种手段加固木桩，就像生怕自己能轻松击碎一样…",
            "nextDialogs": [
              "200660206"
            ]
          },
          "200660206": {
            "id": "200660206",
            "speakerId": 1605,
            "speakerName": "艾琳",
            "text": "这么想寻求挑战的话，直接去野外找强大的魔物不就好了吗？"
          }
        }
      }
    },
    {
      "subId": "2006603",
      "subQuestName": "与艾琳对话",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "200660301"
        ],
        "dialogs": {
          "200660301": {
            "id": "200660301",
            "speakerId": 1605,
            "speakerName": "艾琳",
            "text": "做到了！",
            "nextDialogs": [
              "200660302"
            ]
          },
          "200660302": {
            "id": "200660302",
            "speakerId": 1605,
            "speakerName": "艾琳",
            "text": "原来还能这么解决…这种方法我想都没想过。",
            "nextDialogs": [
              "200660303"
            ]
          },
          "200660303": {
            "id": "200660303",
            "speakerId": 1605,
            "speakerName": "艾琳",
            "text": "谢谢你，我自己去再试试看！"
          }
        }
      }
    }
  ]
}
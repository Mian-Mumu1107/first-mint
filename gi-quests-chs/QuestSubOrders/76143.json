    {
      "subId": "7614305",
      "subQuestName": "打开月心通道",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "761430501"
        ],
        "dialogs": {
          "761430501": {
            "id": "761430501",
            "speakerId": 1001,
            "speakerName": "哥伦比娅",
            "text": "我们回来了。",
            "nextDialogs": [
              "761430502"
            ]
          },
          "761430502": {
            "id": "761430502",
            "speakerId": 1002,
            "speakerName": "派蒙",
            "text": "#{NICKNAME}，哥伦比娅，看来你们在月心的冒险很顺利！",
            "nextDialogs": [
              "761430503"
            ]
          },
          "761430503": {
            "id": "761430503",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "我们确实知道了很多。",
            "nextDialogs": [
              "761430504"
            ]
          },
          "761430504": {
            "id": "761430504",
            "speakerId": 1002,
            "speakerName": "派蒙",
            "text": "哦？黑蛋的来历，还有望月者计划的内容，都知道了吗？",
            "nextDialogs": [
              "761430505"
            ]
          },
          "761430505": {
            "id": "761430505",
            "speakerId": 1001,
            "speakerName": "哥伦比娅",
            "text": "嗯，还有打开望月者模块的钥匙，都在这里了。",
            "nextDialogs": [
              "761430506"
            ]
          },
          "761430506": {
            "id": "761430506",
            "speakerId": 1001,
            "speakerName": "哥伦比娅",
            "text": "宁宁，我现在把它交给你。",
            "nextDialogs": [
              "761430507"
            ]
          },
          "761430507": {
            "id": "761430507",
            "speakerId": 1001,
            "speakerName": "哥伦比娅",
            "text": "等你读取了这里的信息，就会知道你的使命是什么。",
            "nextDialogs": [
              "761430508"
            ]
          },
          "761430508": {
            "id": "761430508",
            "speakerId": 1003,
            "speakerName": "黑蛋",
            "text": "谢谢你！我一直在等待这一刻。",
            "nextDialogs": [
              "761430509"
            ]
          },
          "761430509": {
            "id": "761430509",
            "speakerId": 1001,
            "speakerName": "哥伦比娅",
            "text": "……",
            "nextDialogs": [
              "761430510"
            ]
          },
          "761430510": {
            "id": "761430510",
            "speakerId": 1002,
            "speakerName": "派蒙",
            "text": "#哥伦比娅？{NICKNAME}？你们的脸色怎么都那么沉重呀？",
            "nextDialogs": [
              "761430511"
            ]
          },
          "761430511": {
            "id": "761430511",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "因为她的使命中存在不可知的风险。",
            "nextDialogs": [
              "761430512"
            ]
          },
          "761430512": {
            "id": "761430512",
            "speakerId": 1003,
            "speakerName": "黑蛋",
            "text": "什么风险？",
            "nextDialogs": [
              "761430513"
            ]
          },
          "761430513": {
            "id": "761430513",
            "speakerId": 1001,
            "speakerName": "哥伦比娅",
            "text": "等你读取了这里面的信息，你就知道了。",
            "nextDialogs": [
              "761430514"
            ]
          },
          "761430514": {
            "id": "761430514",
            "speakerId": 1003,
            "speakerName": "黑蛋",
            "text": "……",
            "nextDialogs": [
              "761430515"
            ]
          },
          "761430515": {
            "id": "761430515",
            "speakerId": 1002,
            "speakerName": "派蒙",
            "text": "我有点不明白了，黑蛋的使命到底是什么呀？",
            "nextDialogs": [
              "761430516"
            ]
          },
          "761430516": {
            "id": "761430516",
            "speakerId": 1004,
            "speakerName": "Black Screen",
            "text": "在黑蛋读取信息的同时，你们将一切告诉了派蒙。",
            "nextDialogs": [
              "761430517"
            ]
          },
          "761430517": {
            "id": "761430517",
            "speakerId": 1002,
            "speakerName": "派蒙",
            "text": "向星空中发送信息？原来这就是望月者计划的内容…",
            "nextDialogs": [
              "761430518"
            ]
          },
          "761430518": {
            "id": "761430518",
            "speakerId": 1002,
            "speakerName": "派蒙",
            "text": "所以风险是…这可能会让提瓦特暴露？怎么会这样…好为难！",
            "nextDialogs": [
              "761430519"
            ]
          },
          "761430519": {
            "id": "761430519",
            "speakerId": 1002,
            "speakerName": "派蒙",
            "text": "黑蛋…你还好吗？",
            "nextDialogs": [
              "761430520"
            ]
          },
          "761430520": {
            "id": "761430520",
            "speakerId": 1003,
            "speakerName": "黑蛋",
            "text": "……",
            "nextDialogs": [
              "761430521"
            ]
          },
          "761430521": {
            "id": "761430521",
            "speakerId": 1002,
            "speakerName": "派蒙",
            "text": "哎呀，你先别伤心呀。我们还可以再商量一下对不对？",
            "nextDialogs": [
              "761430522"
            ]
          },
          "761430522": {
            "id": "761430522",
            "speakerId": 1002,
            "speakerName": "派蒙",
            "text": "给你零食，我们五五开！",
            "nextDialogs": [
              "761430523"
            ]
          },
          "761430523": {
            "id": "761430523",
            "speakerId": 1003,
            "speakerName": "黑蛋",
            "text": "不，我没有伤心。",
            "nextDialogs": [
              "761430524"
            ]
          },
          "761430524": {
            "id": "761430524",
            "speakerId": 1002,
            "speakerName": "派蒙",
            "text": "你都流眼泪了！",
            "nextDialogs": [
              "761430525"
            ]
          },
          "761430525": {
            "id": "761430525",
            "speakerId": 1003,
            "speakerName": "黑蛋",
            "text": "我不伤心，眼泪也没有流，这只是…这只是…",
            "nextDialogs": [
              "761430526"
            ]
          },
          "761430526": {
            "id": "761430526",
            "speakerId": 1003,
            "speakerName": "黑蛋",
            "text": "是敬给前辈们的酒。",
            "nextDialogs": [
              "761430527"
            ]
          },
          "761430527": {
            "id": "761430527",
            "speakerId": 1003,
            "speakerName": "黑蛋",
            "text": "#哥伦比娅，{NICKNAME}，派蒙。谢谢你们。",
            "nextDialogs": [
              "761430528"
            ]
          },
          "761430528": {
            "id": "761430528",
            "speakerId": 1003,
            "speakerName": "黑蛋",
            "text": "你们是我的朋友，我不想让朋友为难，所以我愿意…放弃这个使命。",
            "nextDialogs": [
              "761430529"
            ]
          },
          "761430529": {
            "id": "761430529",
            "speakerId": 1002,
            "speakerName": "派蒙",
            "text": "黑蛋…",
            "nextDialogs": [
              "761430530"
            ]
          },
          "761430530": {
            "id": "761430530",
            "speakerId": 1003,
            "speakerName": "黑蛋",
            "text": "没关系，派蒙。我不是第一个执行望月者计划的人。",
            "nextDialogs": [
              "761430531"
            ]
          },
          "761430531": {
            "id": "761430531",
            "speakerId": 1003,
            "speakerName": "黑蛋",
            "text": "我的前辈，早就向星空发出了属于我们的声音。",
            "nextDialogs": [
              "761430532"
            ]
          },
          "761430532": {
            "id": "761430532",
            "speakerId": 1003,
            "speakerName": "黑蛋",
            "text": "那些充满勇气的声音，一定已经传递到很远很远的星空深处了吧。",
            "nextDialogs": [
              "761430533"
            ]
          },
          "761430533": {
            "id": "761430533",
            "speakerId": 1003,
            "speakerName": "黑蛋",
            "text": "只要有那些声音在，星空就不会是一片死寂，那样就足够了。",
            "nextDialogs": [
              "761430534"
            ]
          },
          "761430534": {
            "id": "761430534",
            "speakerId": 1001,
            "speakerName": "哥伦比娅",
            "text": "#{NICKNAME}…你考虑好了吗？",
            "nextDialogs": [
              "761430536",
              "761430547"
            ]
          },
          "761430536": {
            "id": "761430536",
            "speakerId": 1001,
            "speakerName": "哥伦比娅",
            "text": "嗯，我也这么想。",
            "nextDialogs": [
              "761430537"
            ]
          },
          "761430537": {
            "id": "761430537",
            "speakerId": 1003,
            "speakerName": "黑蛋",
            "text": "真、真的吗？",
            "nextDialogs": [
              "761430538"
            ]
          },
          "761430538": {
            "id": "761430538",
            "speakerId": 1002,
            "speakerName": "派蒙",
            "text": "我们真的可以冒一次险吗？",
            "nextDialogs": [
              "761430539"
            ]
          },
          "761430539": {
            "id": "761430539",
            "speakerId": 1001,
            "speakerName": "哥伦比娅",
            "text": "迄今为止，望月者计划已经执行了不止一次。",
            "nextDialogs": [
              "761430540"
            ]
          },
          "761430540": {
            "id": "761430540",
            "speakerId": 1001,
            "speakerName": "哥伦比娅",
            "text": "用来隐藏提瓦特的虚假之天，也已经被打开了不止一次。",
            "nextDialogs": [
              "761430541"
            ]
          },
          "761430541": {
            "id": "761430541",
            "speakerId": 1001,
            "speakerName": "哥伦比娅",
            "text": "霜月曾在虚假之天外存在了数千年。现在月球上也并没有出现深渊污染的痕迹。",
            "nextDialogs": [
              "761430542"
            ]
          },
          "761430542": {
            "id": "761430542",
            "speakerId": 1002,
            "speakerName": "派蒙",
            "text": "哦？你是说，也许并没有想象中那么危险？",
            "nextDialogs": [
              "761430543"
            ]
          },
          "761430543": {
            "id": "761430543",
            "speakerId": 1001,
            "speakerName": "哥伦比娅",
            "text": "可能性有很多，也许深渊不是每时每刻都盯着这里，也许是高天的主宰做了其它措施…",
            "nextDialogs": [
              "761430544"
            ]
          },
          "761430544": {
            "id": "761430544",
            "speakerId": 1001,
            "speakerName": "哥伦比娅",
            "text": "而为了把风险降到最低，我也会用月神的力量，掩护宁宁发出的信息。",
            "nextDialogs": [
              "761430545"
            ]
          },
          "761430545": {
            "id": "761430545",
            "speakerId": 1002,
            "speakerName": "派蒙",
            "text": "欸？那是什么意思？",
            "nextDialogs": [
              "761430549"
            ]
          },
          "761430549": {
            "id": "761430549",
            "speakerId": 1001,
            "speakerName": "哥伦比娅",
            "text": "月矩力和古月之力本质上都是光界力，我可以将我的力量融入宁宁发出的信息中。",
            "nextDialogs": [
              "761430550"
            ]
          },
          "761430550": {
            "id": "761430550",
            "speakerId": 1001,
            "speakerName": "哥伦比娅",
            "text": "等到那些信息穿越虚假之天后，我还可以通过那些力量，监测附近的情况。",
            "nextDialogs": [
              "761430551"
            ]
          },
          "761430551": {
            "id": "761430551",
            "speakerId": 1001,
            "speakerName": "哥伦比娅",
            "text": "一旦有危险，我可以将信息抹除。这样一来，我们就不会被发现。",
            "nextDialogs": [
              "761430552"
            ]
          },
          "761430552": {
            "id": "761430552",
            "speakerId": 1002,
            "speakerName": "派蒙",
            "text": "哦？这好像是个好办法！但你的力量…可以一直维持吗？",
            "nextDialogs": [
              "761430553"
            ]
          },
          "761430553": {
            "id": "761430553",
            "speakerId": 1001,
            "speakerName": "哥伦比娅",
            "text": "唔，我的力量也有极限，只能坚持到一定距离。",
            "nextDialogs": [
              "761430554"
            ]
          },
          "761430554": {
            "id": "761430554",
            "speakerId": 1001,
            "speakerName": "哥伦比娅",
            "text": "我会尽全力，把它送去我能抵达的极限。届时它的来源也不会被轻易定位了吧。",
            "nextDialogs": [
              "761430555"
            ]
          },
          "761430555": {
            "id": "761430555",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "这样听起来比较可行。",
            "nextDialogs": [
              "761430556"
            ]
          },
          "761430556": {
            "id": "761430556",
            "speakerId": 1003,
            "speakerName": "黑蛋",
            "text": "可是…这会让你受伤吗？",
            "nextDialogs": [
              "761430557"
            ]
          },
          "761430557": {
            "id": "761430557",
            "speakerId": 1001,
            "speakerName": "哥伦比娅",
            "text": "放心。支持着我们的，是一整个月亮。",
            "nextDialogs": [
              "761430558"
            ]
          },
          "761430558": {
            "id": "761430558",
            "speakerId": 1002,
            "speakerName": "派蒙",
            "text": "那黑蛋你做好准备了吗？一旦决定，可就无法回头了！",
            "nextDialogs": [
              "761430559"
            ]
          },
          "761430559": {
            "id": "761430559",
            "speakerId": 1003,
            "speakerName": "黑蛋",
            "text": "…我能再问一个问题吗？",
            "nextDialogs": [
              "761430560"
            ]
          },
          "761430560": {
            "id": "761430560",
            "speakerId": 1001,
            "speakerName": "哥伦比娅",
            "text": "嗯？",
            "nextDialogs": [
              "761430561"
            ]
          },
          "761430561": {
            "id": "761430561",
            "speakerId": 1003,
            "speakerName": "黑蛋",
            "text": "为什么你们愿意为我做这些？",
            "nextDialogs": [
              "761430562"
            ]
          },
          "761430562": {
            "id": "761430562",
            "speakerId": 1001,
            "speakerName": "哥伦比娅",
            "text": "我们可是朋友啊。",
            "nextDialogs": [
              "761430563"
            ]
          },
          "761430563": {
            "id": "761430563",
            "speakerId": 1003,
            "speakerName": "黑蛋",
            "text": "就这个？",
            "nextDialogs": [
              "761430564"
            ]
          },
          "761430564": {
            "id": "761430564",
            "speakerId": 1001,
            "speakerName": "哥伦比娅",
            "text": "足够了。"
          },
          "761430547": {
            "id": "761430547",
            "speakerId": 1001,
            "speakerName": "哥伦比娅",
            "text": "如果说，我可以用月神的力量，掩护宁宁发出的信息呢？",
            "nextDialogs": [
              "761430548"
            ]
          },
          "761430548": {
            "id": "761430548",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "具体是什么意思？"
          }
        }
      }
    },

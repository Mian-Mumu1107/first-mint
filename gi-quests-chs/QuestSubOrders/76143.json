        "dialogs": {}
      }
    },
    {
      "subId": "7614301",
      "subQuestName": "前往月心",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "761430101"
        ],
        "dialogs": {
          "761430101": {
            "id": "761430101",
            "speakerId": 1001,
            "speakerName": "哥伦比娅",
            "text": "旅程的终点到了，她就是开启望月者计划的钥匙。",
            "nextDialogs": [
              "761430102"
            ]
          },
          "761430102": {
            "id": "761430102",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "她是谁？",
            "nextDialogs": [
              "761430103"
            ]
          },
          "761430103": {
            "id": "761430103",
            "speakerId": 1001,
            "speakerName": "哥伦比娅",
            "text": "是望月者计划的最后继承者，留在这里的印迹。",
            "nextDialogs": [
              "761430104"
            ]
          },
          "761430104": {
            "id": "761430104",
            "speakerId": 1001,
            "speakerName": "哥伦比娅",
            "text": "她会解释一切。",
            "nextDialogs": [
              "761430105"
            ]
          },
          "761430105": {
            "id": "761430105",
            "speakerId": 1005,
            "speakerName": "？？？",
            "text": "嘿！你好啊。",
            "nextDialogs": [
              "761430106"
            ]
          },
          "761430106": {
            "id": "761430106",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "你好？",
            "nextDialogs": [
              "761430107"
            ]
          },
          "761430107": {
            "id": "761430107",
            "speakerId": 1006,
            "speakerName": "宁希姬娅的印迹",
            "text": "我是宁希姬娅，你也可以叫我宁宁，是我的小名。",
            "nextDialogs": [
              "761430108"
            ]
          },
          "761430108": {
            "id": "761430108",
            "speakerId": 1006,
            "speakerName": "宁希姬娅的印迹",
            "text": "你叫什么名字？伊比尼伯龙？乌吉恩？玛歌？还是卢沙里姆？",
            "nextDialogs": [
              "761430109"
            ]
          },
          "761430109": {
            "id": "761430109",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "#我是{NICKNAME}。",
            "nextDialogs": [
              "761430110"
            ]
          },
          "761430110": {
            "id": "761430110",
            "speakerId": 1006,
            "speakerName": "宁希姬娅的印迹",
            "text": "嘿嘿，不用回答我，因为很遗憾，我已经不在了，这只是一段留言。",
            "nextDialogs": [
              "761430111"
            ]
          },
          "761430111": {
            "id": "761430111",
            "speakerId": 1006,
            "speakerName": "宁希姬娅的印迹",
            "text": "但反过来想，其实一点也不遗憾，因为你来到了这里，这说明计划成功了，你继承了我们的使命。",
            "nextDialogs": [
              "761430112"
            ]
          },
          "761430112": {
            "id": "761430112",
            "speakerId": 1006,
            "speakerName": "宁希姬娅的印迹",
            "text": "你一定还有很多疑惑，比如——「我到底是谁？」。",
            "nextDialogs": [
              "761430113"
            ]
          },
          "761430113": {
            "id": "761430113",
            "speakerId": 1006,
            "speakerName": "宁希姬娅的印迹",
            "text": "让我告诉你，你是由月球意志创生的新生命，你是望月者计划的重要一环。",
            "nextDialogs": [
              "761430114"
            ]
          },
          "761430114": {
            "id": "761430114",
            "speakerId": 1006,
            "speakerName": "宁希姬娅的印迹",
            "text": "「那这个计划究竟是什么呢？」，你肯定又在这么想…别着急，听我说。",
            "nextDialogs": [
              "761430115"
            ]
          },
          "761430115": {
            "id": "761430115",
            "speakerId": 1006,
            "speakerName": "宁希姬娅的印迹",
            "text": "首先，请感谢三月女神，她们容许了我们的僭越，借用了月球本源的创生之力。",
            "nextDialogs": [
              "761430116"
            ]
          },
          "761430116": {
            "id": "761430116",
            "speakerId": 1006,
            "speakerName": "宁希姬娅的印迹",
            "text": "其次，感谢我的老师卢沙里姆。他继承了所有人的研究成果，还成功搜集了大家的古月力信息。",
            "nextDialogs": [
              "761430117"
            ]
          },
          "761430117": {
            "id": "761430117",
            "speakerId": 1006,
            "speakerName": "宁希姬娅的印迹",
            "text": "这样一来，我才能把信息汇聚于这片月心之海，当本源的创生之力被激发时，「砰」的一下——",
            "nextDialogs": [
              "761430118"
            ]
          },
          "761430118": {
            "id": "761430118",
            "speakerId": 1006,
            "speakerName": "宁希姬娅的印迹",
            "text": "一只可爱的黑色月灵，也就是你，诞生了。",
            "nextDialogs": [
              "761430119"
            ]
          },
          "761430119": {
            "id": "761430119",
            "speakerId": 1006,
            "speakerName": "宁希姬娅的印迹",
            "text": "你可能会继承信息海洋中某位前辈的名字，也可能不会，但大概你能想起你有一个使命。",
            "nextDialogs": [
              "761430120"
            ]
          },
          "761430120": {
            "id": "761430120",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "原来这就是黑蛋的诞生…",
            "nextDialogs": [
              "761430121"
            ]
          },
          "761430121": {
            "id": "761430121",
            "speakerId": 1006,
            "speakerName": "宁希姬娅的印迹",
            "text": "接下来，还要感谢玛歌前辈，她揭开了那位星空访客的本质——一种信息生命，她的研究是你诞生的基石。",
            "nextDialogs": [
              "761430122"
            ]
          },
          "761430122": {
            "id": "761430122",
            "speakerId": 1006,
            "speakerName": "宁希姬娅的印迹",
            "text": "还有乌吉恩前辈，他付出生命，传递了那位访客所代表的文明最后向星空传递的消息。",
            "nextDialogs": [
              "761430123"
            ]
          },
          "761430123": {
            "id": "761430123",
            "speakerId": 1006,
            "speakerName": "宁希姬娅的印迹",
            "text": "然后，是最初的望月者，伊比尼伯龙，他带着我们登上月亮，睁大了我们的眼睛，永不疲倦地望向璀璨星空。",
            "nextDialogs": [
              "761430124"
            ]
          },
          "761430124": {
            "id": "761430124",
            "speakerId": 1006,
            "speakerName": "宁希姬娅的印迹",
            "text": "最后，继承者，还要感谢你，因为你即将献出自己，去望月者高塔启动计划的最后一环。",
            "nextDialogs": [
              "761430125"
            ]
          },
          "761430125": {
            "id": "761430125",
            "speakerId": 1006,
            "speakerName": "宁希姬娅的印迹",
            "text": "你的使命，就是继续向宇宙发送我们曾经接收到的信息。",
            "nextDialogs": [
              "761430126"
            ]
          },
          "761430126": {
            "id": "761430126",
            "speakerId": 1006,
            "speakerName": "宁希姬娅的印迹",
            "text": "「一束光很微弱，很容易被黑暗吞没，但只要在它消失前有另一束光亮起…」",
            "nextDialogs": [
              "761430127"
            ]
          },
          "761430127": {
            "id": "761430127",
            "speakerId": 1006,
            "speakerName": "宁希姬娅的印迹",
            "text": "「那么总有一天，总有一束光，会成为刺破夜幕的曙光。」",
            "nextDialogs": [
              "761430128"
            ]
          },
          "761430128": {
            "id": "761430128",
            "speakerId": 1006,
            "speakerName": "宁希姬娅的印迹",
            "text": "说到这里，你应该理解了吧？刚好，我的时间差不多也要到了…但没关系，我马上就来加入大家了。",
            "nextDialogs": [
              "761430129"
            ]
          },
          "761430129": {
            "id": "761430129",
            "speakerId": 1006,
            "speakerName": "宁希姬娅的印迹",
            "text": "这样一想，搞不好，你继承的可能会是我的名字呢，哈哈。",
            "nextDialogs": [
              "761430130"
            ]
          },
          "761430130": {
            "id": "761430130",
            "speakerId": 1006,
            "speakerName": "宁希姬娅的印迹",
            "text": "该说再见了，去完成你的使命吧。最后…向你和所有的望月{RUBY#[S]星空}者致意。",
            "nextDialogs": [
              "761430131"
            ]
          },
          "761430131": {
            "id": "761430131",
            "speakerId": 1001,
            "speakerName": "哥伦比娅",
            "text": "#就是这样。{NICKNAME}。",
            "nextDialogs": [
              "761430132"
            ]
          },
          "761430132": {
            "id": "761430132",
            "speakerId": 1001,
            "speakerName": "哥伦比娅",
            "text": "所有探寻过星空的学者，他们的信息都被融入了这片海洋，借着月球的意志，在未来的某天以黑蛋的模样再次诞生。",
            "nextDialogs": [
              "761430133"
            ]
          },
          "761430133": {
            "id": "761430133",
            "speakerId": 1001,
            "speakerName": "哥伦比娅",
            "text": "它们会本能地互相吞噬，来获取更多信息，直到脑海中的使命变清晰。",
            "nextDialogs": [
              "761430134"
            ]
          },
          "761430134": {
            "id": "761430134",
            "speakerId": 1001,
            "speakerName": "哥伦比娅",
            "text": "然后再走一遍我们所走过的路，来到这里，得知一切。",
            "nextDialogs": [
              "761430135"
            ]
          },
          "761430135": {
            "id": "761430135",
            "speakerId": 1001,
            "speakerName": "哥伦比娅",
            "text": "它们会用自己当作钥匙，打开伊比尼伯龙之眼的望月者模块。向宇宙重新发送消息。",
            "nextDialogs": [
              "761430136"
            ]
          },
          "761430136": {
            "id": "761430136",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "最后回归生命的循环…",
            "nextDialogs": [
              "761430137"
            ]
          },
          "761430137": {
            "id": "761430137",
            "speakerId": 1001,
            "speakerName": "哥伦比娅",
            "text": "嗯，这个循环可能已经不止发生过一次了。",
            "nextDialogs": [
              "761430138"
            ]
          },
          "761430138": {
            "id": "761430138",
            "speakerId": 1001,
            "speakerName": "哥伦比娅",
            "text": "但是，向未知的星空发出声音，未必是一件安全的事。",
            "nextDialogs": [
              "761430139"
            ]
          },
          "761430139": {
            "id": "761430139",
            "speakerId": 1001,
            "speakerName": "哥伦比娅",
            "text": "龙族的学者一定也意识到了这点，所以开始研究月幕工程。",
            "nextDialogs": [
              "761430140"
            ]
          },
          "761430140": {
            "id": "761430140",
            "speakerId": 1001,
            "speakerName": "哥伦比娅",
            "text": "而在宁宁的年代，世界因为两位至高者的争斗，已是将要毁灭的样子。",
            "nextDialogs": [
              "761430141"
            ]
          },
          "761430141": {
            "id": "761430141",
            "speakerId": 1001,
            "speakerName": "哥伦比娅",
            "text": "可现在，提瓦特已经恢复了平静，至少现在如此。",
            "nextDialogs": [
              "761430142"
            ]
          },
          "761430142": {
            "id": "761430142",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "（如果这次发出的信号，最后却让星空中的黑暗注意到这里…）",
            "nextDialogs": [
              "761430143"
            ]
          },
          "761430143": {
            "id": "761430143",
            "speakerId": 1001,
            "speakerName": "哥伦比娅",
            "text": "我会依照承诺，把钥匙和信息交给宁宁。",
            "nextDialogs": [
              "761430144"
            ]
          },
          "761430144": {
            "id": "761430144",
            "speakerId": 1001,
            "speakerName": "哥伦比娅",
            "text": "但你觉得我们应该阻止宁宁完成她的使命，还是支持她？",
            "nextDialogs": [
              "761430145"
            ]
          },
          "761430145": {
            "id": "761430145",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "我需要一点时间考虑。",
            "nextDialogs": [
              "761430146"
            ]
          },
          "761430146": {
            "id": "761430146",
            "speakerId": 1001,
            "speakerName": "哥伦比娅",
            "text": "嗯，我理解。那我们就返回那座最初的望月者高塔吧。",
            "nextDialogs": [
              "761430147"
            ]
          },
          "761430147": {
            "id": "761430147",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "派蒙和宁宁呢？",
            "nextDialogs": [
              "761430148"
            ]
          },
          "761430148": {
            "id": "761430148",
            "speakerId": 1001,
            "speakerName": "哥伦比娅",
            "text": "放心，玛歌会接上她们的。",
            "nextDialogs": [
              "761430149"
            ]
          },
          "761430149": {
            "id": "761430149",
            "speakerId": 1001,
            "speakerName": "哥伦比娅",
            "text": "去那里还有不短的路程。我们可以多考虑一下。",
            "nextDialogs": [
              "761430150"
            ]
          },
          "761430150": {
            "id": "761430150",
            "speakerId": 1001,
            "speakerName": "哥伦比娅",
            "text": "走吧。该离开这了。"
          }
        }
      }

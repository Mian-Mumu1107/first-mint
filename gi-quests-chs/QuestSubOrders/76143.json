  "subQuests": [
    {
      "subId": "7614312",
      "subQuestName": "跃入月心深坑",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "761431201"
        ],
        "dialogs": {
          "761431201": {
            "id": "761431201",
            "speakerId": 1000,
            "speakerName": "终端",
            "text": "…因为无法准确定位坐标…不知需要多久…回讯才能抵达你…",
            "nextDialogs": [
              "761431202"
            ]
          },
          "761431202": {
            "id": "761431202",
            "speakerId": 1000,
            "speakerName": "终端",
            "text": "…但我想要…在此时此刻…应答…",
            "nextDialogs": [
              "761431203"
            ]
          },
          "761431203": {
            "id": "761431203",
            "speakerId": 1000,
            "speakerName": "终端",
            "text": "…我们是在宇宙间…孤独穿行许久的旅者…而你们的声音…就像黑暗森林中突然燃起的篝火…",
            "nextDialogs": [
              "761431204"
            ]
          },
          "761431204": {
            "id": "761431204",
            "speakerId": 1000,
            "speakerName": "终端",
            "text": "…这很冒险…却又无畏…让我们感到振奋与温暖…",
            "nextDialogs": [
              "761431205"
            ]
          },
          "761431205": {
            "id": "761431205",
            "speakerId": 1000,
            "speakerName": "终端",
            "text": "…我相信…这个时刻…是星海与命运的引力…将你我连接在一起…",
            "nextDialogs": [
              "761431206"
            ]
          },
          "761431206": {
            "id": "761431206",
            "speakerId": 1000,
            "speakerName": "终端",
            "text": "…未来…我们会尝试…寻找你们…星球…但很遗憾不是现在…因为还有一些…的麻烦…",
            "nextDialogs": [
              "761431207"
            ]
          },
          "761431207": {
            "id": "761431207",
            "speakerId": 1000,
            "speakerName": "终端",
            "text": "（…一阵干扰的杂音…）",
            "nextDialogs": [
              "761431208"
            ]
          },
          "761431208": {
            "id": "761431208",
            "speakerId": 1000,
            "speakerName": "终端",
            "text": "#…{M#哥哥！好了吗？}{F#荧，怎么样了？}",
            "nextDialogs": [
              "761431209"
            ]
          },
          "761431209": {
            "id": "761431209",
            "speakerId": 1000,
            "speakerName": "终端",
            "text": "#…{M#荧，马上来}{F#哥哥，马上好}…",
            "nextDialogs": [
              "761431210"
            ]
          },
          "761431210": {
            "id": "761431210",
            "speakerId": 1000,
            "speakerName": "终端",
            "text": "（…一阵干扰的杂音…）",
            "nextDialogs": [
              "761431211"
            ]
          },
          "761431211": {
            "id": "761431211",
            "speakerId": 1000,
            "speakerName": "终端",
            "text": "…那么…向你致意…",
            "nextDialogs": [
              "761431212"
            ]
          },
          "761431212": {
            "id": "761431212",
            "speakerId": 1000,
            "speakerName": "终端",
            "text": "…就像你说的，星海广阔无垠，我们并不孤单…",
            "nextDialogs": [
              "761431213"
            ]
          },
          "761431213": {
            "id": "761431213",
            "speakerId": 1000,
            "speakerName": "终端",
            "text": "…愿我们有天能在星空下再见…"
          }
        }
      }
    },
    {
      "subId": "7614302",
      "subQuestName": "穿越发射井",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "761430201"
        ],
        "dialogs": {
          "761430201": {
            "id": "761430201",
            "speakerId": 1001,
            "speakerName": "哥伦比娅",
            "text": "我们下来了。",
            "nextDialogs": [
              "761430202"
            ]
          },
          "761430202": {
            "id": "761430202",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "这里就是月心吗？",
            "nextDialogs": [
              "761430203"
            ]
          },
          "761430203": {
            "id": "761430203",
            "speakerId": 1001,
            "speakerName": "哥伦比娅",
            "text": "不，月心还在前面。这次有你同行，我们就得用常规方法进入那里。",
            "nextDialogs": [
              "761430204"
            ]
          },
          "761430204": {
            "id": "761430204",
            "speakerId": 1001,
            "speakerName": "哥伦比娅",
            "text": "至于这里…是那位漆黑龙王的杰作。",
            "nextDialogs": [
              "761430205"
            ]
          },
          "761430205": {
            "id": "761430205",
            "speakerId": 1001,
            "speakerName": "哥伦比娅",
            "text": "他将月球改造成了可怕的武器，这里就是武器的发射井。",
            "nextDialogs": [
              "761430206"
            ]
          },
          "761430206": {
            "id": "761430206",
            "speakerId": 1001,
            "speakerName": "哥伦比娅",
            "text": "而月心中的月亮本源力量，就成了射向提瓦特的炮火。",
            "nextDialogs": [
              "761430207"
            ]
          },
          "761430207": {
            "id": "761430207",
            "speakerId": 1001,
            "speakerName": "哥伦比娅",
            "text": "不过，那位原初之主最终还是败于天理手中。现在这里已经不会再有威胁了。",
            "nextDialogs": [
              "761430208"
            ]
          },
          "761430208": {
            "id": "761430208",
            "speakerId": 1001,
            "speakerName": "哥伦比娅",
            "text": "我们往前走吧。"
          }
        }
      }
    },
    {
      "subId": "7614303",
      "subQuestName": "通过正确的路前进",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "761430301"
        ],
        "dialogs": {
          "761430301": {
            "id": "761430301",
            "speakerId": 1001,
            "speakerName": "哥伦比娅",
            "text": "这道门下面，就是我们要去的地方了。",
            "nextDialogs": [
              "761430302"
            ]
          },
          "761430302": {
            "id": "761430302",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "好像需要钥匙才能开门。",
            "nextDialogs": [
              "761430303"
            ]
          },
          "761430303": {
            "id": "761430303",
            "speakerId": 1001,
            "speakerName": "哥伦比娅",
            "text": "钥匙就在你身上。",
            "nextDialogs": [
              "761430304"
            ]
          },
          "761430304": {
            "id": "761430304",
            "speakerId": 1001,
            "speakerName": "哥伦比娅",
            "text": "这里是卢沙里姆最后的研究场所，而上一个是月幕实验室，也就是现在的月海。",
            "nextDialogs": [
              "761430305"
            ]
          },
          "761430305": {
            "id": "761430305",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "是…月海的古月之源？",
            "nextDialogs": [
              "761430306"
            ]
          },
          "761430306": {
            "id": "761430306",
            "speakerId": 1001,
            "speakerName": "哥伦比娅",
            "text": "就是这个。",
            "nextDialogs": [
              "761430307"
            ]
          },
          "761430307": {
            "id": "761430307",
            "speakerId": 1001,
            "speakerName": "哥伦比娅",
            "text": "嗯？是识别到了入侵者吗？",
            "nextDialogs": [
              "761430308"
            ]
          },
          "761430308": {
            "id": "761430308",
            "speakerId": 1001,
            "speakerName": "哥伦比娅",
            "text": "不过它们拦不住我们。"
          }
        }
      }
    },
    {
      "subId": "7614304",
      "subQuestName": "通过正确的路前进",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "761430401"
        ],
        "dialogs": {
          "761430401": {
            "id": "761430401",
            "speakerId": 1001,
            "speakerName": "哥伦比娅",
            "text": "玛歌已经带上派蒙和宁宁返回了，等你准备好了，我们也动身吧。",
            "nextDialogs": [
              "761430403",
              "761430405"
            ]
          },
          "761430403": {
            "id": "761430403",
            "speakerId": 1001,
            "speakerName": "哥伦比娅",
            "text": "那我们走吧。"
          },
          "761430405": {
            "id": "761430405",
            "speakerId": 1001,
            "speakerName": "哥伦比娅",
            "text": "嗯，最好不要耽误太久。"
          }
        }
      }
    },

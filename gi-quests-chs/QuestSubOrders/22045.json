  "subQuests": [
    {
      "subId": "2204501",
      "subQuestName": "与大岛纯平对话",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "220450101"
        ],
        "dialogs": {
          "220450101": {
            "id": "220450101",
            "speakerId": 3182,
            "speakerName": "大岛纯平",
            "text": "嗯…这种感觉不太对啊…",
            "nextDialogs": [
              "220450102"
            ]
          },
          "220450102": {
            "id": "220450102",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "怎么了？",
            "nextDialogs": [
              "220450103"
            ]
          },
          "220450103": {
            "id": "220450103",
            "speakerId": 3182,
            "speakerName": "大岛纯平",
            "text": "旅行者！你来得正好，我正想找你呢！",
            "nextDialogs": [
              "220450104"
            ]
          },
          "220450104": {
            "id": "220450104",
            "speakerId": 3182,
            "speakerName": "大岛纯平",
            "text": "最近我制作木雕的时候，总觉得…制作出来的木雕没有灵性…",
            "nextDialogs": [
              "220450106"
            ]
          },
          "220450106": {
            "id": "220450106",
            "speakerId": 3182,
            "speakerName": "大岛纯平",
            "text": "哎呀，不能这么说…",
            "nextDialogs": [
              "220450108"
            ]
          },
          "220450108": {
            "id": "220450108",
            "speakerId": 3182,
            "speakerName": "大岛纯平",
            "text": "嗯…怎么和你形容呢？简单来说，我想要的「灵性」就是一种…活力。",
            "nextDialogs": [
              "220450109"
            ]
          },
          "220450109": {
            "id": "220450109",
            "speakerId": 3182,
            "speakerName": "大岛纯平",
            "text": "你看，代宫司大人虽然平时都在睡觉，但偶尔也会起来转悠的。",
            "nextDialogs": [
              "220450110"
            ]
          },
          "220450110": {
            "id": "220450110",
            "speakerId": 3182,
            "speakerName": "大岛纯平",
            "text": "转悠的时候，代宫司大人偶尔就会跳一跳，扑扑落叶，或者是伸伸懒腰什么的…",
            "nextDialogs": [
              "220450111"
            ]
          },
          "220450111": {
            "id": "220450111",
            "speakerId": 3182,
            "speakerName": "大岛纯平",
            "text": "这些动作，就是我想要的那种活力。我想…以这种动作为原型制作的雕像，应该也有着我想要的那种「灵性」…"
          }
        }
      }
    },
    {
      "subId": "2204502",
      "subQuestName": "从右侧为寝子拍摄画片",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "220450201"
        ],
        "dialogs": {
          "220450201": {
            "id": "220450201",
            "speakerId": 3182,
            "speakerName": "大岛纯平",
            "text": "拍画片的事就拜托你了，拍到画片之后就快拿来给我吧。"
          }
        }
      }
    },
    {
      "subId": "2204503",
      "subQuestName": "从左侧为寝子拍摄画片",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "220450301"
        ],
        "dialogs": {
          "220450301": {
            "id": "220450301",
            "speakerId": 3189,
            "speakerName": "「寝子」",
            "text": "唔？汝等在做什么呢？",
            "nextDialogs": [
              "220450302"
            ]
          },
          "220450302": {
            "id": "220450302",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "在拍画片。",
            "nextDialogs": [
              "220450303"
            ]
          },
          "220450303": {
            "id": "220450303",
            "speakerId": 3189,
            "speakerName": "「寝子」",
            "text": "…那是什么？汝等，真是奇怪啊。",
            "nextDialogs": [
              "220450304"
            ]
          },
          "220450304": {
            "id": "220450304",
            "speakerId": 3189,
            "speakerName": "「寝子」",
            "text": "算了，汝等继续吧，只要别把神社弄乱了就行。"
          }
        }
      }
    },
    {
      "subId": "2204504",
      "subQuestName": "将画片交给大岛纯平",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "220450401"
        ],
        "dialogs": {
          "220450401": {
            "id": "220450401",
            "speakerId": 3182,
            "speakerName": "大岛纯平",
            "text": "怎么样，你们拍到画片了吗？",
            "nextDialogs": [
              "220450402"
            ]
          },
          "220450402": {
            "id": "220450402",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "已经拍到了。",
            "nextDialogs": [
              "220450403"
            ]
          },
          "220450403": {
            "id": "220450403",
            "speakerId": 3182,
            "speakerName": "大岛纯平",
            "text": "我看看…喔！这角度，这姿态，真不错！",
            "nextDialogs": [
              "220450406"
            ]
          },
          "220450406": {
            "id": "220450406",
            "speakerId": 3182,
            "speakerName": "大岛纯平",
            "text": "绝对没问题，这些画片用来做参考再好不过了。",
            "nextDialogs": [
              "220450407"
            ]
          },
          "220450407": {
            "id": "220450407",
            "speakerId": 3182,
            "speakerName": "大岛纯平",
            "text": "谢谢你帮忙旅行者，这些东西请你收下，我等会就去接着练习木雕。",
            "nextDialogs": [
              "220450408"
            ]
          },
          "220450408": {
            "id": "220450408",
            "speakerId": 3182,
            "speakerName": "大岛纯平",
            "text": "哎呀，真不错…"
          }
        }
      }
    }

        ],
        "dialogs": {
          "727350101": {
            "id": "727350101",
            "speakerId": 13090,
            "speakerName": "「千日喧哗大飞车」",
            "text": "你们三个，谁是老大？站出来面对我！",
            "nextDialogs": [
              "727350102"
            ]
          },
          "727350102": {
            "id": "727350102",
            "speakerId": 13090,
            "speakerName": "「千日喧哗大飞车」",
            "text": "我「千日喧哗大飞车」可是精锐中的精锐，代表「花角玉将」大人，来取你们荒泷派老大的首级！",
            "nextDialogs": [
              "727350103"
            ]
          },
          "727350103": {
            "id": "727350103",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "呜哇，好凶好凶！说话也好狠！这次好像真的来了个强人…",
            "nextDialogs": [
              "727350104"
            ]
          },
          "727350104": {
            "id": "727350104",
            "speakerId": 1044,
            "speakerName": "荒泷一斗",
            "text": "什么乱七八糟的！还有，你的称号里居然也用了「大」字，是想和本大爷抢风头吗？",
            "nextDialogs": [
              "727350105"
            ]
          },
          "727350105": {
            "id": "727350105",
            "speakerId": 1044,
            "speakerName": "荒泷一斗",
            "text": "本大爷揍的就是你这种精锐！",
            "nextDialogs": [
              "727350106"
            ]
          },
          "727350106": {
            "id": "727350106",
            "speakerId": 13090,
            "speakerName": "「千日喧哗大飞车」",
            "text": "好，好高的男人，居然还是…鬼族！",
            "nextDialogs": [
              "727350107"
            ]
          },
          "727350107": {
            "id": "727350107",
            "speakerId": 13090,
            "speakerName": "「千日喧哗大飞车」",
            "text": "如此豪气飒爽的家伙，怎么会玩斗虫这种小孩喜欢的游戏…真是见了鬼了！",
            "nextDialogs": [
              "727350108"
            ]
          },
          "727350108": {
            "id": "727350108",
            "speakerId": 1044,
            "speakerName": "荒泷一斗",
            "text": "你说什么？你在小瞧斗虫吗？真是胆大包天！",
            "nextDialogs": [
              "727350109"
            ]
          },
          "727350109": {
            "id": "727350109",
            "speakerId": 1044,
            "speakerName": "荒泷一斗",
            "text": "根本不懂斗虫精髓的家伙，必须由热爱斗虫的人来修正！本大爷就好好教训你一回！",
            "nextDialogs": [
              "727350112"
            ]
          },
          "727350112": {
            "id": "727350112",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "对对对，可不能让他一直这么嚣张！就看你的了，放牛的！",
            "nextDialogs": [
              "727350113"
            ]
          },
          "727350113": {
            "id": "727350113",
            "speakerId": 13090,
            "speakerName": "「千日喧哗大飞车」",
            "text": "没办法了…来就来，谁怕谁！"
          }
        }
      }
    }
  ]
}
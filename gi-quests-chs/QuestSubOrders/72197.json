  "subQuests": [
    {
      "subId": "7219723",
      "subQuestName": "检测时间任务$HIDDEN",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "721972301"
        ],
        "dialogs": {
          "721972301": {
            "id": "721972301",
            "speakerId": 1000,
            "speakerName": "长次",
            "text": "#{NICKNAME}，没想到又能在这里看见你！",
            "nextDialogs": [
              "721972302"
            ]
          },
          "721972302": {
            "id": "721972302",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "好久不见啦！八酝岛外的世界怎么样？",
            "nextDialogs": [
              "721972303"
            ]
          },
          "721972303": {
            "id": "721972303",
            "speakerId": 1000,
            "speakerName": "长次",
            "text": "这里比家乡富裕很多，也有更多好吃的料理、好玩的东西。但是…我不太喜欢。",
            "nextDialogs": [
              "721972304"
            ]
          },
          "721972304": {
            "id": "721972304",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "欸？为什么？",
            "nextDialogs": [
              "721972305"
            ]
          },
          "721972305": {
            "id": "721972305",
            "speakerId": 1000,
            "speakerName": "长次",
            "text": "这里的人都缺少了些什么…",
            "nextDialogs": [
              "721972306"
            ]
          },
          "721972306": {
            "id": "721972306",
            "speakerId": 1000,
            "speakerName": "长次",
            "text": "从前在八酝岛生活的时候，大御所大人对我来说遥远安详…我们不会在意她在哪里，但是我们相信她就在这里，注视保护着我们，规定我们怎么过日子，成为什么样的人…",
            "nextDialogs": [
              "721972307"
            ]
          },
          "721972307": {
            "id": "721972307",
            "speakerId": 1000,
            "speakerName": "长次",
            "text": "但是在这里，大御所大人覆盖一切，威压一切…",
            "nextDialogs": [
              "721972308"
            ]
          },
          "721972308": {
            "id": "721972308",
            "speakerId": 1000,
            "speakerName": "长次",
            "text": "唉，我也说不清楚啦…",
            "nextDialogs": [
              "721972309"
            ]
          },
          "721972309": {
            "id": "721972309",
            "speakerId": 1000,
            "speakerName": "长次",
            "text": "对了，关于我的妈妈…你有发现什么吗？",
            "nextDialogs": [
              "721972310"
            ]
          },
          "721972310": {
            "id": "721972310",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "我们还在努力。",
            "nextDialogs": [
              "721972311"
            ]
          },
          "721972311": {
            "id": "721972311",
            "speakerId": 1000,
            "speakerName": "长次",
            "text": "没关系的，有消息再告诉我也不迟。"
          }
        }
      }
    },
    {
      "subId": "7219722",
      "subQuestName": "继续和长次对话$HIDDEN",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "721971701"
        ],
        "dialogs": {
          "721971701": {
            "id": "721971701",
            "speakerId": 1000,
            "speakerName": "长次",
            "text": "#你好，{NICKNAME}！最近过得如何？",
            "nextDialogs": [
              "721971702"
            ]
          },
          "721971702": {
            "id": "721971702",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "挺好的，你呢！",
            "nextDialogs": [
              "721971703"
            ]
          },
          "721971703": {
            "id": "721971703",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "我的话被派蒙抢掉啦！",
            "nextDialogs": [
              "721971704"
            ]
          },
          "721971704": {
            "id": "721971704",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "哈哈，只怪你自己反应慢！",
            "nextDialogs": [
              "721971705"
            ]
          },
          "721971705": {
            "id": "721971705",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "我看派蒙是想加餐了吧？",
            "nextDialogs": [
              "721971706"
            ]
          },
          "721971706": {
            "id": "721971706",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "当然啦，我天天都想！",
            "nextDialogs": [
              "721971707"
            ]
          },
          "721971707": {
            "id": "721971707",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "我的意思是，你就是「加餐」。",
            "nextDialogs": [
              "721971708"
            ]
          },
          "721971708": {
            "id": "721971708",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "喂——！",
            "nextDialogs": [
              "721971709"
            ]
          },
          "721971709": {
            "id": "721971709",
            "speakerId": 1000,
            "speakerName": "长次",
            "text": "噗…哈哈哈哈哈！",
            "nextDialogs": [
              "721971710"
            ]
          },
          "721971710": {
            "id": "721971710",
            "speakerId": 1000,
            "speakerName": "长次",
            "text": "好啦好啦，你们别吵啦。",
            "nextDialogs": [
              "721971711"
            ]
          },
          "721971711": {
            "id": "721971711",
            "speakerId": 1000,
            "speakerName": "长次",
            "text": "我这边也还不错，不过还有件事想要拜托一下。",
            "nextDialogs": [
              "721971714"
            ]
          },
          "721971714": {
            "id": "721971714",
            "speakerId": 1000,
            "speakerName": "长次",
            "text": "#嗯，也没有别的要求啦，只是需要{NICKNAME}再帮我开采一些晶石。",
            "nextDialogs": [
              "721971715"
            ]
          },
          "721971715": {
            "id": "721971715",
            "speakerId": 1000,
            "speakerName": "长次",
            "text": "请相信我，我一定会好好报答你的…只要你相信我。",
            "nextDialogs": [
              "721971716"
            ]
          },
          "721971716": {
            "id": "721971716",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "我相信你，可是…",
            "nextDialogs": [
              "721971717"
            ]
          },
          "721971717": {
            "id": "721971717",
            "speakerId": 1000,
            "speakerName": "长次",
            "text": "可是…？"
          }
        }
      }
    },
    {
      "subId": "7219712",
      "subQuestName": "交付矿石$HIDDEN",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "721971201"
        ],
        "dialogs": {
          "721971201": {
            "id": "721971201",
            "speakerId": 1000,
            "speakerName": "长次",
            "text": "做好了吗？我们一起来尝尝看吧！",
            "nextDialogs": [
              "721971202"
            ]
          },
          "721971202": {
            "id": "721971202",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "（这样就可以了吧）",
            "nextDialogs": [
              "721971203"
            ]
          },
          "721971203": {
            "id": "721971203",
            "speakerId": 1000,
            "speakerName": "长次",
            "text": "唔嗯…呃…哈哈，是没尝过的异国风味呢。",
            "nextDialogs": [
              "721971204"
            ]
          },
          "721971204": {
            "id": "721971204",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "哪个「异国」呀！深渊吗？！",
            "nextDialogs": [
              "721971205"
            ]
          },
          "721971205": {
            "id": "721971205",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "长次请不要勉强啦！你还在长身体，就别吃这个了…",
            "nextDialogs": [
              "721971206"
            ]
          },
          "721971206": {
            "id": "721971206",
            "speakerId": 1000,
            "speakerName": "长次",
            "text": "唔嗯，唔嗯…嗯，很得要领，虽然厨艺不太熟练。但是很好吃。谢谢。",
            "nextDialogs": [
              "721971207"
            ]
          },
          "721971207": {
            "id": "721971207",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "#哼哼，{NICKNAME}的手艺那还用说！喂，你们也给我留点呀！",
            "nextDialogs": [
              "721971208"
            ]
          },
          "721971208": {
            "id": "721971208",
            "speakerId": 1000,
            "speakerName": "长次",
            "text": "#唔——嗯！好吃！{NICKNAME}有成为名厨的潜质呢！",
            "nextDialogs": [
              "721971209"
            ]
          },
          "721971209": {
            "id": "721971209",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "#哇…好香！{NICKNAME}，不如我们在这里合伙开家料亭好了！",
            "nextDialogs": [
              "721971210"
            ]
          },
          "721971210": {
            "id": "721971210",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "我是认真的哦！"
          }
        }
      }
    },
    {
      "subId": "7219721",
      "subQuestName": "交付完成后对话$HIDDEN",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "721971901"
        ],
        "dialogs": {
          "721971901": {
            "id": "721971901",
            "speakerId": 1000,
            "speakerName": "长次",
            "text": "这些晶石应该足够了。接下来我就要启程去冒险咯！",
            "nextDialogs": [
              "721971902"
            ]
          },
          "721971902": {
            "id": "721971902",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "还是好担心这孩子…",
            "nextDialogs": [
              "721971905"
            ]
          },
          "721971905": {
            "id": "721971905",
            "speakerId": 1000,
            "speakerName": "长次",
            "text": "嗯！",
            "nextDialogs": [
              "721971906"
            ]
          },
          "721971906": {
            "id": "721971906",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "喂，长次你不要再满嘴跑舌头啦！还好是遇上了我们…不然会被打的！",
            "nextDialogs": [
              "721971907"
            ]
          },
          "721971907": {
            "id": "721971907",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "还有还有，遇到坏人想要套话，也不要对他们讲实话！一定要乱胡诌！",
            "nextDialogs": [
              "721971908"
            ]
          },
          "721971908": {
            "id": "721971908",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "还有还有…",
            "nextDialogs": [
              "721971909"
            ]
          },
          "721971909": {
            "id": "721971909",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "派蒙变成老外婆了呢。",
            "nextDialogs": [
              "721971910"
            ]
          },
          "721971910": {
            "id": "721971910",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "这么小的孩子自己一个人出去冒险，谁会放心啦！",
            "nextDialogs": [
              "721971911"
            ]
          },
          "721971911": {
            "id": "721971911",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "我相信他。",
            "nextDialogs": [
              "721971912"
            ]
          },
          "721971912": {
            "id": "721971912",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "…真是的。",
            "nextDialogs": [
              "721971913"
            ]
          },
          "721971913": {
            "id": "721971913",
            "speakerId": 1000,
            "speakerName": "长次",
            "text": "哈哈哈哈！谢谢你们。",
            "nextDialogs": [
              "721971914"
            ]
          },
          "721971914": {
            "id": "721971914",
            "speakerId": 1000,
            "speakerName": "长次",
            "text": "希望我们以后还会见面。",
            "nextDialogs": [
              "721971915"
            ]
          },
          "721971915": {
            "id": "721971915",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "一定要注意安全呀…",
            "nextDialogs": [
              "721971916"
            ]
          },
          "721971916": {
            "id": "721971916",
            "speakerId": 1000,
            "speakerName": "长次",
            "text": "我没问题的！",
            "nextDialogs": [
              "721971917"
            ]
          },
          "721971917": {
            "id": "721971917",
            "speakerId": 1000,
            "speakerName": "长次",
            "text": "接下来我应该会去踏鞴砂，妈妈曾在那里工作过。或许还有人能告诉我她是否经过那边。",
            "nextDialogs": [
              "721971918"
            ]
          },
          "721971918": {
            "id": "721971918",
            "speakerId": 1000,
            "speakerName": "长次",
            "text": "再然后…我会想办法去鸣神岛。然后搭一艘至冬国的商船…之后的事情，随机应变。",
            "nextDialogs": [
              "721971919"
            ]
          },
          "721971919": {
            "id": "721971919",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "……"
          }
        }
      }
    },
    {
      "subId": "7219713",
      "subQuestName": "寻找妈妈的踪迹$HIDDEN",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "721971301"
        ],
        "dialogs": {
          "721971301": {
            "id": "721971301",
            "speakerId": 1000,
            "speakerName": "长次",
            "text": "谢谢你们，我好久没有吃过这道料理了…以前都是妈妈给我做的，她做的很好吃，谁做的也比不上。",
            "nextDialogs": [
              "721971302"
            ]
          },
          "721971302": {
            "id": "721971302",
            "speakerId": 1000,
            "speakerName": "长次",
            "text": "唔…真想每天都不用只吃堇瓜，每天都吃禽肉料理。",
            "nextDialogs": [
              "721971303"
            ]
          },
          "721971303": {
            "id": "721971303",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "嘿嘿，我也是！"
          }
        }
      }
    },
    {
      "subId": "7219714",
      "subQuestName": "在高炉偶遇小男孩$HIDDEN",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "721972001"
        ],
        "dialogs": {
          "721972001": {
            "id": "721972001",
            "speakerId": 1000,
            "speakerName": "长次",
            "text": "你们好，又见面了！",
            "nextDialogs": [
              "721972002"
            ]
          },
          "721972002": {
            "id": "721972002",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "且慢——让我猜猜…",
            "nextDialogs": [
              "721972003"
            ]
          },
          "721972003": {
            "id": "721972003",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "「拜托再给我弄来一大堆晶石…」",
            "nextDialogs": [
              "721972004"
            ]
          },
          "721972004": {
            "id": "721972004",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "「…我有急用，呜呜…」",
            "nextDialogs": [
              "721972005"
            ]
          },
          "721972005": {
            "id": "721972005",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "这就是你想说的吧！",
            "nextDialogs": [
              "721972006"
            ]
          },
          "721972006": {
            "id": "721972006",
            "speakerId": 1000,
            "speakerName": "长次",
            "text": "哈哈哈哈哈，当然不是啦！",
            "nextDialogs": [
              "721972007"
            ]
          },
          "721972007": {
            "id": "721972007",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "你的旅途如何？",
            "nextDialogs": [
              "721972008"
            ]
          },
          "721972008": {
            "id": "721972008",
            "speakerId": 1000,
            "speakerName": "长次",
            "text": "还好，只是还没有找到妈妈的踪迹…",
            "nextDialogs": [
              "721972009"
            ]
          },
          "721972009": {
            "id": "721972009",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "#没关系，我们也会帮忙的，对吧？{NICKNAME}？",
            "nextDialogs": [
              "721972010"
            ]
          },
          "721972010": {
            "id": "721972010",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "我们尽力而为。",
            "nextDialogs": [
              "721972011"
            ]
          },
          "721972011": {
            "id": "721972011",
            "speakerId": 1000,
            "speakerName": "长次",
            "text": "#嗯，我就知道{NICKNAME}可以信赖！"
          }
        }
      }
    },

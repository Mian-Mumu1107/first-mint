      "subQuestName": "与派蒙对话",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "760181601"
        ],
        "dialogs": {
          "760181601": {
            "id": "760181601",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "呜…「落落莓果冻」…和朋友们一起回到天上去了…",
            "nextDialogs": [
              "760181603"
            ]
          },
          "760181603": {
            "id": "760181603",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "听说花缨水母到了生命的尽头，只要回到天上去的话，就可以变成小水母再重新长大，也不知道是不是真的…",
            "nextDialogs": [
              "760181605",
              "760181607"
            ]
          },
          "760181605": {
            "id": "760181605",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "对哦，要是被关在屏障里面，就没办法飞到天上去了。",
            "nextDialogs": [
              "760181609"
            ]
          },
          "760181609": {
            "id": "760181609",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "所以之前救到的两个小家伙，现在也和「落落莓果冻」在一块儿了吧？",
            "nextDialogs": [
              "760181602"
            ]
          },
          "760181602": {
            "id": "760181602",
            "speakerId": 1004,
            "speakerName": "<UNKNOWN>",
            "text": "这里的坏机器都被我们打跑了，环境也都恢复成了原来的样子。所以不用再担心了！",
            "nextDialogs": [
              "760181610"
            ]
          },
          "760181610": {
            "id": "760181610",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "#唔…{NICKNAME}你说，等它再一次长大的时候，还会认得我们吗？"
          },
          "760181607": {
            "id": "760181607",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "#{NICKNAME}说得对！我也愿意相信！毕竟「落落莓果冻」真的拥有很神奇的力量。",
            "nextDialogs": [
              "760181608"
            ]
          },
          "760181608": {
            "id": "760181608",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "所以之前救到的两个小家伙，现在也和「落落莓果冻」在一块儿了吧？"
          }
        }

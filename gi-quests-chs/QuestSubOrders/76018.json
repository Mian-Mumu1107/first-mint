        ],
        "dialogs": {
          "760180801": {
            "id": "760180801",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "这里居然埋着一只水母，它还有气息！",
            "nextDialogs": [
              "760180802"
            ]
          },
          "760180802": {
            "id": "760180802",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "原来是希望我们帮忙救下自己的同伴吗？唔…我刚才好像完全理解错了「落落莓果冻」的意思…",
            "nextDialogs": [
              "760180803"
            ]
          },
          "760180803": {
            "id": "760180803",
            "speakerId": 21923,
            "speakerName": "「落落莓果冻」",
            "text": "……",
            "nextDialogs": [
              "760180804"
            ]
          },
          "760180804": {
            "id": "760180804",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "是愚人众的坏机器！走开啦，不许伤害「落落莓果冻」！"
          }
        }
      }
    },

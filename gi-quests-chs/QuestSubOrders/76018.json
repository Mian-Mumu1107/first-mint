    {
      "subId": "7601826",
      "subQuestName": "(test)隐藏$HIDDEN",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "760181301"
        ],
        "dialogs": {
          "760181301": {
            "id": "760181301",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "嗯？怎么打不开呢？难道不是这个钥匙吗…唔，现在要怎么办呢？",
            "nextDialogs": [
              "760181302"
            ]
          },
          "760181302": {
            "id": "760181302",
            "speakerId": 21923,
            "speakerName": "「落落莓果冻」",
            "text": "……",
            "nextDialogs": [
              "760181303"
            ]
          },
          "760181303": {
            "id": "760181303",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "哇！「落落莓果冻」竟然还有这种本领。这样的话，接下来的解救行动会很顺利的吧？",
            "nextDialogs": [
              "760181305"
            ]
          },
          "760181305": {
            "id": "760181305",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "唔…好像真是变浅了不少，看上去比刚才更虚弱了一点。",
            "nextDialogs": [
              "760181307"
            ]
          },
          "760181307": {
            "id": "760181307",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "难道是因为动用了刚才那种力量的关系吗？那、那怎么可以！「落落莓果冻」本来就已经快没有力气了…",
            "nextDialogs": [
              "760181308"
            ]
          },
          "760181308": {
            "id": "760181308",
            "speakerId": 21923,
            "speakerName": "「落落莓果冻」",
            "text": "……",
            "nextDialogs": [
              "760181309"
            ]
          },
          "760181309": {
            "id": "760181309",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "结果…还、还是没能赶上…",
            "nextDialogs": [
              "760181310"
            ]
          },
          "760181310": {
            "id": "760181310",
            "speakerId": 21923,
            "speakerName": "「落落莓果冻」",
            "text": "……",
            "nextDialogs": [
              "760181311"
            ]
          },
          "760181311": {
            "id": "760181311",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "你是在生气吗？还是难过？或许是不舒服？好像都不是…好着急呀，要怎么才能知道它到底想说什么呢？",
            "nextDialogs": [
              "760181312"
            ]
          },
          "760181312": {
            "id": "760181312",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "这似乎是只会对同伴做出的动作。",
            "nextDialogs": [
              "760181313"
            ]
          },
          "760181313": {
            "id": "760181313",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "也就是说…虽然我们没能帮它救出同伴，但还是想感谢我们吗？「落落莓果冻」…",
            "nextDialogs": [
              "760181314"
            ]
          },
          "760181314": {
            "id": "760181314",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "相比建造这些机器却对生命不管不顾的愚人众，水母反而更懂得关心别人。",
            "nextDialogs": [
              "760181315"
            ]
          },
          "760181315": {
            "id": "760181315",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "到底谁才没有大脑嘛！"
          }
        }
      }
    },

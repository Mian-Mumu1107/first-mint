              "760180904"
            ]
          },
          "760180904": {
            "id": "760180904",
            "speakerId": 1002,
            "speakerName": "Black Screen",
            "text": "光芒消退后，小家伙又像平时那样漂浮着，只是显得很虚弱的样子。",
            "nextDialogs": [
              "760180905"
            ]
          },
          "760180905": {
            "id": "760180905",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "哇！原来可以自己解除屏障的吗？真是的，有这么方便的本领，就应该早点使出来嘛。",
            "nextDialogs": [
              "760180919"
            ]
          },

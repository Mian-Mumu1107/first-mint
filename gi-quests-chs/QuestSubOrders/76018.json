  "subQuests": [
    {
      "subId": "7601801",
      "subQuestName": "(test)隐藏$HIDDEN",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "760180101"
        ],
        "dialogs": {
          "760180101": {
            "id": "760180101",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "完全瘫倒在地了呢…看上去像是被摔在地上的落落莓果冻。刚才路过的时候，差点没有发现。",
            "nextDialogs": [
              "760180102"
            ]
          },
          "760180102": {
            "id": "760180102",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "好像对我们的到来完全没有反应，是睡着了吗？",
            "nextDialogs": [
              "760180103"
            ]
          },
          "760180103": {
            "id": "760180103",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "水母没有大脑，好像不太需要睡眠？",
            "nextDialogs": [
              "760180104"
            ]
          },
          "760180104": {
            "id": "760180104",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "欸？！没、没有大脑…竟然存在这样的生物。",
            "nextDialogs": [
              "760180105"
            ]
          },
          "760180105": {
            "id": "760180105",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "不过即便没有大脑，好像也能感受到痛苦…它看起来很不舒服的样子。",
            "nextDialogs": [
              "760180106"
            ]
          },
          "760180106": {
            "id": "760180106",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "我们快把这里的屏障打开，确认一下它是不是还好吧！不过，这个装置要怎么才能打开呢？",
            "nextDialogs": [
              "760180108"
            ]
          },
          "760180108": {
            "id": "760180108",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "嗯？怎么说得好像我大脑空空一样…",
            "nextDialogs": [
              "760180110"
            ]
          },
          "760180110": {
            "id": "760180110",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "#哼，我只是不擅长解开机关这种事而已。要是找好吃的…{NICKNAME}肯定比不过我的！"
          }
        }
      }
    },
    {
      "subId": "7601802",
      "subQuestName": "解救瘫倒的水母",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "760180201"
        ],
        "dialogs": {
          "760180201": {
            "id": "760180201",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "没、没能赶上…唔，落落莓果冻是在悼念同伴吗？",
            "nextDialogs": [
              "760180202"
            ]
          },
          "760180202": {
            "id": "760180202",
            "speakerId": 21923,
            "speakerName": "「落落莓果冻」",
            "text": "……",
            "nextDialogs": [
              "760180203"
            ]
          },
          "760180203": {
            "id": "760180203",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "水母真的是没有思考能力的生物吗？它明明看上去很难过的样子…",
            "nextDialogs": [
              "760180204"
            ]
          },
          "760180204": {
            "id": "760180204",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "或许，拥有这种情绪并不需要思考。",
            "nextDialogs": [
              "760180205"
            ]
          },
          "760180205": {
            "id": "760180205",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "#{NICKNAME}说得对，难过的时候并不是靠思考就能停下来的。",
            "nextDialogs": [
              "760180206"
            ]
          },
          "760180206": {
            "id": "760180206",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "也许，这样的感情…是从我们心里很深很深的地方，自己浮现出来的吧。",
            "nextDialogs": [
              "760180207"
            ]
          },
          "760180207": {
            "id": "760180207",
            "speakerId": 21923,
            "speakerName": "「落落莓果冻」",
            "text": "……",
            "nextDialogs": [
              "760180208"
            ]
          },
          "760180208": {
            "id": "760180208",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "很难过么…不会哭、不会说话、甚至都叫不出声…还真是令人担心呢。有什么是我们能为你做的吗？",
            "nextDialogs": [
              "760180209"
            ]
          },
          "760180209": {
            "id": "760180209",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "说不定还有别的水母被困。",
            "nextDialogs": [
              "760180210"
            ]
          },
          "760180210": {
            "id": "760180210",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "对、对哦，这么多水母都倒下了…也就是说，那些愚人众根本不在乎它们会变成什么样子！",
            "nextDialogs": [
              "760180211"
            ]
          },
          "760180211": {
            "id": "760180211",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "这个基地那么大，肯定会有很多像刚才那样的坏机器。那么被困住的肯定不止落落莓果冻一只。",
            "nextDialogs": [
              "760180212"
            ]
          },
          "760180212": {
            "id": "760180212",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "我们一起去把它们都找出来吧！",
            "nextDialogs": [
              "760180213"
            ]
          },
          "760180213": {
            "id": "760180213",
            "speakerId": 21923,
            "speakerName": "「落落莓果冻」",
            "text": "……"
          }
        }
      }
    },
    {
      "subId": "7601803",
      "subQuestName": "与派蒙对话$HIDDEN",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "760180301"
        ],
        "dialogs": {
          "760180301": {
            "id": "760180301",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "真的就把钥匙放在了门边…这里的愚人众好像挺笨的呢。",
            "nextDialogs": [
              "760180303",
              "760180306"
            ]
          },
          "760180303": {
            "id": "760180303",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "对哦，要是遇到聪明又认真的家伙，我们找起钥匙来可就费劲了！",
            "nextDialogs": [
              "760180304"
            ]
          },
          "760180304": {
            "id": "760180304",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "那只水母…唔，不如就叫它「落落莓果冻」好了！说不定就来不及获救了…",
            "nextDialogs": [
              "760180308"
            ]
          },
          "760180308": {
            "id": "760180308",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "话说回来，现在屏障都已经打开了，它怎么还是不动呢？",
            "nextDialogs": [
              "760180309"
            ]
          },
          "760180309": {
            "id": "760180309",
            "speakerId": 1002,
            "speakerName": "Black Screen",
            "text": "被解救的水母挣扎着想要游动起来，却还是无力地瘫倒在地…",
            "nextDialogs": [
              "760180310"
            ]
          },
          "760180310": {
            "id": "760180310",
            "speakerId": 21923,
            "speakerName": "「落落莓果冻」",
            "text": "……",
            "nextDialogs": [
              "760180311"
            ]
          },
          "760180311": {
            "id": "760180311",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "怎、怎么还是很痛苦的样子…难道不光是因为被困住了吗？",
            "nextDialogs": [
              "760180312"
            ]
          },
          "760180312": {
            "id": "760180312",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "可能是由于这里的月矩力很稀薄。",
            "nextDialogs": [
              "760180313"
            ]
          },
          "760180313": {
            "id": "760180313",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "#{NICKNAME}感受不到足够的月矩力吗…",
            "nextDialogs": [
              "760180314"
            ]
          },
          "760180314": {
            "id": "760180314",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "#我们刚来到挪德卡莱的时候，{NICKNAME}就一直能感受到月矩力的存在。",
            "nextDialogs": [
              "760180315"
            ]
          },
          "760180315": {
            "id": "760180315",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "是不是因为这里的环境突然变了，它才这么不舒服的？",
            "nextDialogs": [
              "760180316"
            ]
          },
          "760180316": {
            "id": "760180316",
            "speakerId": 21923,
            "speakerName": "「落落莓果冻」",
            "text": "……",
            "nextDialogs": [
              "760180317"
            ]
          },
          "760180317": {
            "id": "760180317",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "再坚持一下，一定会救你出去的，我们来想办法！",
            "nextDialogs": [
              "760180318"
            ]
          },
          "760180318": {
            "id": "760180318",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "#{NICKNAME}，快想想办法吧！"
          },
          "760180306": {
            "id": "760180306",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "怎么听都不像是在好好夸我的样子…",
            "nextDialogs": [
              "760180307"
            ]
          },
          "760180307": {
            "id": "760180307",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "要不是我一开始发现了这滩落落莓果冻…嗯，不如就叫它这个名字好了！我们大概已经错过救援的机会了吧？"
          }
        }
      }
    },

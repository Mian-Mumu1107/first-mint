        "dialogs": {
          "760181501": {
            "id": "760181501",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "欸？屏障突然启动了！糟糕…被关在里面了！",
            "nextDialogs": [
              "760181502"
            ]
          },
          "760181502": {
            "id": "760181502",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "唔，连「落落莓果冻」它们也被摔在地上了…可恶！",
            "nextDialogs": [
              "760181503"
            ]
          },
          "760181503": {
            "id": "760181503",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "怎、怎么办哇！别说拯救水母了，现在连我们自己都被困在里面了…",
            "nextDialogs": [
              "760181506"
            ]
          },
          "760181506": {
            "id": "760181506",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "#和{NICKNAME}被关在一起，倒也不那么害怕。我只是在担心「落落莓果冻」它们…",
            "nextDialogs": [
              "760181507"
            ]
          },
          "760181507": {
            "id": "760181507",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "唔，既然我们都会飞，那「落落莓果冻」能够做到的事，说、说不定我也可以！",
            "nextDialogs": [
              "760181508"
            ]
          },
          "760181508": {
            "id": "760181508",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "……！",
            "nextDialogs": [
              "760181509"
            ]
          },
          "760181509": {
            "id": "760181509",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "打开了！竟然真的打开了！我们快去救「落落莓果冻」它们吧！"
          }
        }
      }

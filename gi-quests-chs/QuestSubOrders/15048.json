  "subQuests": [
    {
      "subId": "1504801",
      "subQuestName": "前往「阿夏快跑」",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "150480101"
        ],
        "dialogs": {
          "150480101": {
            "id": "150480101",
            "speakerId": 1000,
            "speakerName": "高恩",
            "text": "…我们不能让您承担这种风险。",
            "nextDialogs": [
              "150480102"
            ]
          },
          "150480102": {
            "id": "150480102",
            "speakerId": 1001,
            "speakerName": "班尼特",
            "text": "可您刚才还不是这么说的…",
            "nextDialogs": [
              "150480103"
            ]
          },
          "150480103": {
            "id": "150480103",
            "speakerId": 1000,
            "speakerName": "高恩",
            "text": "实在抱歉，虽然时间很紧张，但我们更需要考虑游客的人身安全，请您谅解。",
            "nextDialogs": [
              "150480104"
            ]
          },
          "150480104": {
            "id": "150480104",
            "speakerId": 1001,
            "speakerName": "班尼特",
            "text": "#{NICKNAME}，你来得正好，请帮我说服这位先生吧。",
            "nextDialogs": [
              "150480105"
            ]
          },
          "150480105": {
            "id": "150480105",
            "speakerId": 1001,
            "speakerName": "班尼特",
            "text": "他们急着等人测试，我好不容易向对方证明了我的冒险经验，也表明我愿意承担测试后果，本来很顺利…",
            "nextDialogs": [
              "150480106"
            ]
          },
          "150480106": {
            "id": "150480106",
            "speakerId": 1001,
            "speakerName": "班尼特",
            "text": "但一听到我的「过往危机经历」，这位先生就说什么都不肯了。",
            "nextDialogs": [
              "150480107"
            ]
          },
          "150480107": {
            "id": "150480107",
            "speakerId": 1000,
            "speakerName": "高恩",
            "text": "这位游客，我理解您的热心。",
            "nextDialogs": [
              "150480108"
            ]
          },
          "150480108": {
            "id": "150480108",
            "speakerId": 1000,
            "speakerName": "高恩",
            "text": "但如果您过桥的时候都会失足掉进水里，最好还是去参与更温和一点的项目…那边的沙滩躺椅怎么样？",
            "nextDialogs": [
              "150480109"
            ]
          },
          "150480109": {
            "id": "150480109",
            "speakerId": 1001,
            "speakerName": "班尼特",
            "text": "唉，可是，可是我确实是符合测试条件的冒险家！那只是因为…运气不好…",
            "nextDialogs": [
              "150480110"
            ]
          },
          "150480110": {
            "id": "150480110",
            "speakerId": 1001,
            "speakerName": "班尼特",
            "text": "我是真的很想帮上忙，请您相信我的实力是值得信任的…",
            "nextDialogs": [
              "150480113"
            ]
          },
          "150480113": {
            "id": "150480113",
            "speakerId": 1000,
            "speakerName": "高恩",
            "text": "既然拯救纳塔的大英雄都这么说了…这样吧，可否先让这位阿夏搭档完成第一轮测试呢？",
            "nextDialogs": [
              "150480114"
            ]
          },
          "150480114": {
            "id": "150480114",
            "speakerId": 1000,
            "speakerName": "高恩",
            "text": "您可以在一旁观看，提前熟悉整体路线。一切顺利无误的话，再来请您参与第二轮测试。",
            "nextDialogs": [
              "150480115"
            ]
          },
          "150480115": {
            "id": "150480115",
            "speakerId": 1001,
            "speakerName": "班尼特",
            "text": "阿夏，你愿意吗？",
            "nextDialogs": [
              "150480116"
            ]
          },
          "150480116": {
            "id": "150480116",
            "speakerId": 1002,
            "speakerName": "阿夏",
            "text": "♪",
            "nextDialogs": [
              "150480117"
            ]
          },
          "150480117": {
            "id": "150480117",
            "speakerId": 1001,
            "speakerName": "班尼特",
            "text": "好，那就交给你了哦，我的好搭档。"
          }
        }
      }
    },
    {
      "subId": "1504802",
      "subQuestName": "协助阿夏到达终点",
      "sceneId": null,
      "locations": [],

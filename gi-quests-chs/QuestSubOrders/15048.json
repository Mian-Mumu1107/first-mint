    {
      "subId": "1504803",
      "subQuestName": "与众人对话",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "150480301"
        ],
        "dialogs": {
          "150480301": {
            "id": "150480301",
            "speakerId": 1003,
            "speakerName": "派蒙",
            "text": "成功啦！也不算很难嘛。",
            "nextDialogs": [
              "150480302"
            ]
          },
          "150480302": {
            "id": "150480302",
            "speakerId": 1002,
            "speakerName": "阿夏",
            "text": "♪",
            "nextDialogs": [
              "150480303"
            ]
          },
          "150480303": {
            "id": "150480303",
            "speakerId": 1001,
            "speakerName": "班尼特",
            "text": "做得好，阿夏！你的运动能力超级棒啊，看得我目瞪口呆！",
            "nextDialogs": [
              "150480304"
            ]
          },
          "150480304": {
            "id": "150480304",
            "speakerId": 1003,
            "speakerName": "派蒙",
            "text": "接下去轮到班尼特测试了对吧？",
            "nextDialogs": [
              "150480305"
            ]
          },
          "150480305": {
            "id": "150480305",
            "speakerId": 1001,
            "speakerName": "班尼特",
            "text": "对！我已经做好热身运动，活动开全身的筋骨和肌肉了，包在我身上。",
            "nextDialogs": [
              "150480306"
            ]
          },
          "150480306": {
            "id": "150480306",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "也要注意安全。",
            "nextDialogs": [
              "150480307"
            ]
          },
          "150480307": {
            "id": "150480307",
            "speakerId": 1001,
            "speakerName": "班尼特",
            "text": "嗯！多谢关心！"
          }
        }
      }
    },
    {
      "subId": "1504804",
      "subQuestName": "与班尼特和阿夏对话",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "150480401"
        ],
        "dialogs": {
          "150480401": {
            "id": "150480401",
            "speakerId": 1002,
            "speakerName": "阿夏",
            "text": "♪",
            "nextDialogs": [
              "150480402"
            ]
          },
          "150480402": {
            "id": "150480402",
            "speakerId": 1001,
            "speakerName": "班尼特",
            "text": "阿夏，你的意思是，你愿意在前方引导我，当我的指导教练吗？",
            "nextDialogs": [
              "150480403"
            ]
          },
          "150480403": {
            "id": "150480403",
            "speakerId": 1002,
            "speakerName": "阿夏",
            "text": "♪",
            "nextDialogs": [
              "150480404"
            ]
          },
          "150480404": {
            "id": "150480404",
            "speakerId": 1001,
            "speakerName": "班尼特",
            "text": "太可靠了！有你领路我就更不担心会出意外了。我们走吧，教练先请！",
            "nextDialogs": [
              "150480405"
            ]
          },
          "150480405": {
            "id": "150480405",
            "speakerId": 1003,
            "speakerName": "派蒙",
            "text": "加油阿夏，加油班尼特！"
          }
        }
      }
    },
    {
      "subId": "1504805",
      "subQuestName": "跟随阿夏，前往终点",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [],
        "dialogs": {}
      }
    },
    {
      "subId": "1504806",
      "subQuestName": "前往终点",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "150480601"
        ],
        "dialogs": {
          "150480601": {
            "id": "150480601",
            "speakerId": 1001,
            "speakerName": "班尼特",
            "text": "…好，还差最后一点，沉住气…",
            "nextDialogs": [
              "150480602"
            ]
          },
          "150480602": {
            "id": "150480602",
            "speakerId": 1001,
            "speakerName": "班尼特",
            "text": "终点？！终点怎么飞走了啊——",
            "nextDialogs": [
              "150480603"
            ]
          },
          "150480603": {
            "id": "150480603",
            "speakerId": 1001,
            "speakerName": "班尼特",
            "text": "难道是我乌鸦嘴了？还是说我的好运突然用完了？不对，现在不是沮丧的时候。",
            "nextDialogs": [
              "150480604"
            ]
          },
          "150480604": {
            "id": "150480604",
            "speakerId": 1002,
            "speakerName": "阿夏",
            "text": "♪",
            "nextDialogs": [
              "150480605"
            ]
          },
          "150480605": {
            "id": "150480605",
            "speakerId": 1001,
            "speakerName": "班尼特",
            "text": "阿夏…对啊！只要我们心意相通…"
          }
        }
      }
    },
    {
      "subId": "1504807",
      "subQuestName": "追回「终点」",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [],
        "dialogs": {}
      }
    },
    {
      "subId": "1504808",
      "subQuestName": "与其他人会合",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "150480801"
        ],
        "dialogs": {
          "150480801": {
            "id": "150480801",
            "speakerId": 1001,
            "speakerName": "班尼特",
            "text": "我心跳好快，感觉还要好一阵才能恢复平稳…",
            "nextDialogs": [
              "150480802"
            ]
          },
          "150480802": {
            "id": "150480802",
            "speakerId": 1002,
            "speakerName": "阿夏",
            "text": "♪",
            "nextDialogs": [
              "150480803"
            ]
          },
          "150480803": {
            "id": "150480803",
            "speakerId": 1003,
            "speakerName": "派蒙",
            "text": "恭喜班尼特和阿夏呀！教练指导的好，学员完成的也好。",
            "nextDialogs": [
              "150480804"
            ]
          },
          "150480804": {
            "id": "150480804",
            "speakerId": 1003,
            "speakerName": "派蒙",
            "text": "尤其是最后的配合，你们的默契发挥了巨大的作用！",
            "nextDialogs": [
              "150480805"
            ]
          },
          "150480805": {
            "id": "150480805",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "靠合作突破了厄运的封锁。",
            "nextDialogs": [
              "150480806"
            ]
          },
          "150480806": {
            "id": "150480806",
            "speakerId": 1001,
            "speakerName": "班尼特",
            "text": "嗯！",
            "nextDialogs": [
              "150480807"
            ]
          },
          "150480807": {
            "id": "150480807",
            "speakerId": 1001,
            "speakerName": "班尼特",
            "text": "#我还想特别感谢你，{NICKNAME}。",
            "nextDialogs": [
              "150480808"
            ]
          },
          "150480808": {
            "id": "150480808",
            "speakerId": 1001,
            "speakerName": "班尼特",
            "text": "要不是你愿意相信我，帮我说服工作人员，我肯定不会有机会完成挑战，也就没有机会和它共渡难关…",
            "nextDialogs": [
              "150480809"
            ]
          },
          "150480809": {
            "id": "150480809",
            "speakerId": 1000,
            "speakerName": "高恩",
            "text": "班尼特先生，最后的安全测试已经完全通过了，「阿夏快跑」即刻起就可以投入正式运营，多谢您的协助！",
            "nextDialogs": [
              "150480810"
            ]
          },
          "150480810": {
            "id": "150480810",
            "speakerId": 1001,
            "speakerName": "班尼特",
            "text": "阿夏，听到了吗？我们成功了！",
            "nextDialogs": [
              "150480811"
            ]
          },
          "150480811": {
            "id": "150480811",
            "speakerId": 1000,
            "speakerName": "高恩",
            "text": "我会记得你的名字，热心而勇敢的冒险家班尼特先生。",
            "nextDialogs": [
              "150480812"
            ]
          },
          "150480812": {
            "id": "150480812",
            "speakerId": 1001,
            "speakerName": "班尼特",
            "text": "虽然冒险还在继续，可我总感觉，自己已经越来越舍不得离开它了…",
            "nextDialogs": [
              "150480813"
            ]
          },
          "150480813": {
            "id": "150480813",
            "speakerId": 1001,
            "speakerName": "班尼特",
            "text": "阿夏，我一定会想念你的。",
            "nextDialogs": [
              "150480814"
            ]
          },
          "150480814": {
            "id": "150480814",
            "speakerId": 1002,
            "speakerName": "阿夏",
            "text": "……",
            "nextDialogs": [
              "150480815"
            ]
          },
          "150480815": {
            "id": "150480815",
            "speakerId": 1001,
            "speakerName": "班尼特",
            "text": "不…怎么能让你安慰我呢，我可是团长啊。我才应该照顾团员、安慰团员才对。",
            "nextDialogs": [
              "150480816"
            ]
          },
          "150480816": {
            "id": "150480816",
            "speakerId": 1002,
            "speakerName": "阿夏",
            "text": "……",
            "nextDialogs": [
              "150480817"
            ]
          },
          "150480817": {
            "id": "150480817",
            "speakerId": 1001,
            "speakerName": "班尼特",
            "text": "奇怪，我这是太激动了吗？为什么眼眶突然变得好热，都有点语无伦次了，哈哈…",
            "nextDialogs": [
              "150480818"
            ]
          },
          "150480818": {
            "id": "150480818",
            "speakerId": 1001,
            "speakerName": "班尼特",
            "text": "回头我得请教最会写诗的温迪老师，让他教教我在这种时候，要用怎样的词句表达心情…",
            "nextDialogs": [
              "150480819"
            ]
          },
          "150480819": {
            "id": "150480819",
            "speakerId": 1003,
            "speakerName": "派蒙",
            "text": "卖唱的恐怕会说…",
            "nextDialogs": [
              "150480820"
            ]
          },
          "150480820": {
            "id": "150480820",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "自由传达你想说的就好。",
            "nextDialogs": [
              "150480821"
            ]
          },
          "150480821": {
            "id": "150480821",
            "speakerId": 1001,
            "speakerName": "班尼特",
            "text": "有你在真的太好了…谢谢你，阿夏…",
            "nextDialogs": [
              "150480822"
            ]
          },
          "150480822": {
            "id": "150480822",
            "speakerId": 1002,
            "speakerName": "阿夏",
            "text": "……"
          }
        }
      }
    },

    {
      "subId": "7217604",
      "subQuestName": "找到手鞠",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [],
        "dialogs": {}
      }
    },
    {
      "subId": "7217602",
      "subQuestName": "与鲸井小弟对话",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "721760202"
        ],
        "dialogs": {
          "721760202": {
            "id": "721760202",
            "speakerId": 20338,
            "speakerName": "鲸井小弟",
            "text": "欸，太难了吗…",
            "nextDialogs": [
              "721760203"
            ]
          },
          "721760203": {
            "id": "721760203",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "刚刚只是状态不好而已！",
            "nextDialogs": [
              "721760204"
            ]
          },
          "721760204": {
            "id": "721760204",
            "speakerId": 20338,
            "speakerName": "鲸井小弟",
            "text": "#{PLAYERAVATAR#SEXPRO[INFO_MALE_PRONOUN_BIGBROTHER|INFO_FEMALE_PRONOUN_BIGSISTER]}，你们要再试一次吗？",
            "nextDialogs": [
              "721760205"
            ]
          },
          "721760205": {
            "id": "721760205",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "#当然了！{NICKNAME}，我们要让鲸井小弟见识一下我们的厉害才行！",
            "nextDialogs": [
              "721760206"
            ]
          },
          "721760206": {
            "id": "721760206",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "再来一次！",
            "nextDialogs": [
              "721760207"
            ]
          },
          "721760207": {
            "id": "721760207",
            "speakerId": 20338,
            "speakerName": "鲸井小弟",
            "text": "好耶！目标是在限制时间内，找到手鞠哦！"
          }
        }
      }
    },
    {
      "subId": "7217605",
      "subQuestName": "与鲸井小弟对话",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "721760702"
        ],
        "dialogs": {
          "721760702": {
            "id": "721760702",
            "speakerId": 20338,
            "speakerName": "鲸井小弟",
            "text": "#{PLAYERAVATAR#SEXPRO[INFO_MALE_PRONOUN_BIGBROTHER|INFO_FEMALE_PRONOUN_BIGSISTER]}好厉害，一下就找到了！",
            "nextDialogs": [
              "721760703"
            ]
          },
          "721760703": {
            "id": "721760703",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "#哼哼，{NICKNAME}可是身经百战，去过很多国度的旅行者。",
            "nextDialogs": [
              "721760704"
            ]
          },
          "721760704": {
            "id": "721760704",
            "speakerId": 20338,
            "speakerName": "鲸井小弟",
            "text": "哇！难道，「蒙德」也去过？",
            "nextDialogs": [
              "721760705"
            ]
          },
          "721760705": {
            "id": "721760705",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "当然。",
            "nextDialogs": [
              "721760706"
            ]
          },
          "721760706": {
            "id": "721760706",
            "speakerId": 20338,
            "speakerName": "鲸井小弟",
            "text": "好厉害！听那个大姐姐说，蒙德有很多很漂亮的地方，像是有好高好高的塔的「风龙遗迹」…",
            "nextDialogs": [
              "721760709"
            ]
          },
          "721760709": {
            "id": "721760709",
            "speakerId": 20338,
            "speakerName": "鲸井小弟",
            "text": "嗯，不知道是那座塔比较高，还是将军大人的天守比较高呢…",
            "nextDialogs": [
              "721760710"
            ]
          },
          "721760710": {
            "id": "721760710",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "鲸井小弟，你为什么一个人在野外呢？",
            "nextDialogs": [
              "721760711"
            ]
          },
          "721760711": {
            "id": "721760711",
            "speakerId": 20338,
            "speakerName": "鲸井小弟",
            "text": "因为姐姐钓鱼的时候，嫌我会把鱼吓跑，就让我自己出去玩了。",
            "nextDialogs": [
              "721760712"
            ]
          },
          "721760712": {
            "id": "721760712",
            "speakerId": 20338,
            "speakerName": "鲸井小弟",
            "text": "有一次，遇到了那个冒险家大姐姐。她看我无聊，就送了好多手鞠，让我「找贪心的旅行者一起玩」。",
            "nextDialogs": [
              "721760713"
            ]
          },
          "721760713": {
            "id": "721760713",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "贪心的旅行者…",
            "nextDialogs": [
              "721760714"
            ]
          },
          "721760714": {
            "id": "721760714",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "才不是贪心！是担心！担心鲸井小弟一个人很无聊！",
            "nextDialogs": [
              "721760715"
            ]
          },
          "721760715": {
            "id": "721760715",
            "speakerId": 20338,
            "speakerName": "鲸井小弟",
            "text": "#是呀，我也觉得{PLAYERAVATAR#SEXPRO[INFO_MALE_PRONOUN_BIGBROTHER|INFO_FEMALE_PRONOUN_BIGSISTER]}你们好好心，我很开心哦。",
            "nextDialogs": [
              "721760716"
            ]
          },
          "721760716": {
            "id": "721760716",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "一个人呆在野外…",
            "nextDialogs": [
              "721760717"
            ]
          },
          "721760717": {
            "id": "721760717",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "你一个小孩子呆在野外，不怕遇到危险吗？而且身上还带着好东西。",
            "nextDialogs": [
              "721760718"
            ]
          },
          "721760718": {
            "id": "721760718",
            "speakerId": 20338,
            "speakerName": "鲸井小弟",
            "text": "#{PLAYERAVATAR#SEXPRO[INFO_MALE_PRONOUN_BIGBROTHER|INFO_FEMALE_PRONOUN_BIGSISTER]}真好心。不过不用担心，那个冒险家大姐姐教我，只要特别操作一下，手鞠就可以变成炸弹。",
            "nextDialogs": [
              "721760719"
            ]
          },
          "721760719": {
            "id": "721760719",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "好危险！",
            "nextDialogs": [
              "721760720"
            ]
          },
          "721760720": {
            "id": "721760720",
            "speakerId": 20338,
            "speakerName": "鲸井小弟",
            "text": "不危险哦！丘丘人呀，史莱姆呀，坏蛋呀，我都炸跑好多了。",
            "nextDialogs": [
              "721760721"
            ]
          },
          "721760721": {
            "id": "721760721",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "危险的是你！",
            "nextDialogs": [
              "721760722"
            ]
          },
          "721760722": {
            "id": "721760722",
            "speakerId": 20338,
            "speakerName": "鲸井小弟",
            "text": "#对了，{PLAYERAVATAR#SEXPRO[INFO_MALE_PRONOUN_BIGBROTHER|INFO_FEMALE_PRONOUN_BIGSISTER]}如果想要跟别的朋友玩手鞠的话…",
            "nextDialogs": [
              "721760723"
            ]
          },
          "721760723": {
            "id": "721760723",
            "speakerId": 20338,
            "speakerName": "鲸井小弟",
            "text": "我留个手鞠放在这里！它的规则是这样的…",
            "nextDialogs": [
              "721760724"
            ]
          },
          "721760724": {
            "id": "721760724",
            "speakerId": 20338,
            "speakerName": "鲸井小弟",
            "text": "藏手鞠的时候，要在一首手鞠歌的时间内藏好。找的人呢，也在一首歌的时间内找到。这样才公平嘛。",
            "nextDialogs": [
              "721760725"
            ]
          },
          "721760725": {
            "id": "721760725",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "我知道了。",
            "nextDialogs": [
              "721760726"
            ]
          },
          "721760726": {
            "id": "721760726",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "一想到我们玩的居然是炸弹，就觉得好害怕…",
            "nextDialogs": [
              "721760727"
            ]
          },
          "721760727": {
            "id": "721760727",
            "speakerId": 20338,
            "speakerName": "鲸井小弟",
            "text": "#{PLAYERAVATAR#SEXPRO[INFO_MALE_PRONOUN_BIGBROTHER|INFO_FEMALE_PRONOUN_BIGSISTER]}不用怕，她还跟我说过「只会炸坏人。大概」。",
            "nextDialogs": [
              "721760728"
            ]
          },
          "721760728": {
            "id": "721760728",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "「大概」？！",
            "nextDialogs": [
              "721760729"
            ]
          },
          "721760729": {
            "id": "721760729",
            "speakerId": 20338,
            "speakerName": "鲸井小弟",
            "text": "#那么，我去别的地方玩喽！{PLAYERAVATAR#SEXPRO[INFO_MALE_PRONOUN_BIGBROTHER|INFO_FEMALE_PRONOUN_BIGSISTER]}再见！"
          }
        }
      }
    }
  ]
}
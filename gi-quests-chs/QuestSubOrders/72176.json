{
  "lineCounts": {
    "Player": 11,
    "派蒙": 15,
    "鲸井小弟": 24
  },
  "subQuests": [
    {
      "subId": "7217601",
      "subQuestName": "（test）与鲸井小弟对话（隐藏）$HIDDEN",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "721760101"
        ],
        "dialogs": {
          "721760101": {
            "id": "721760101",
            "speakerId": 20338,
            "speakerName": "鲸井小弟",
            "text": "#嗨！{PLAYERAVATAR#SEXPRO[INFO_MALE_PRONOUN_BIGBROTHER|INFO_FEMALE_PRONOUN_BIGSISTER]}，我这有好东西…",
            "nextDialogs": [
              "721760102"
            ]
          },
          "721760102": {
            "id": "721760102",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "谢谢，没有兴趣。",
            "nextDialogs": [
              "721760103"
            ]
          },
          "721760103": {
            "id": "721760103",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "好可怜，年纪这么小就被人逼着干可疑的行当。",
            "nextDialogs": [
              "721760104"
            ]
          },
          "721760104": {
            "id": "721760104",
            "speakerId": 20338,
            "speakerName": "鲸井小弟",
            "text": "#不是啦！我是想和{PLAYERAVATAR#SEXPRO[INFO_MALE_PRONOUN_BIGBROTHER|INFO_FEMALE_PRONOUN_BIGSISTER]}玩手鞠。",
            "nextDialogs": [
              "721760105"
            ]
          },
          "721760105": {
            "id": "721760105",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "「手鞠」？",
            "nextDialogs": [
              "721760106"
            ]
          },
          "721760106": {
            "id": "721760106",
            "speakerId": 20338,
            "speakerName": "鲸井小弟",
            "text": "#简单来说，我会把手鞠藏在附近的某个地方。在一首手鞠歌的时间内，如果{PLAYERAVATAR#SEXPRO[INFO_MALE_PRONOUN_BIGBROTHER|INFO_FEMALE_PRONOUN_BIGSISTER]}能找到，那{PLAYERAVATAR#SEXPRO[INFO_MALE_PRONOUN_BIGBROTHER|INFO_FEMALE_PRONOUN_BIGSISTER]}就赢了。",
            "nextDialogs": [
              "721760107"
            ]
          },
          "721760107": {
            "id": "721760107",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "手鞠是这样玩的吗？",
            "nextDialogs": [
              "721760108"
            ]
          },
          "721760108": {
            "id": "721760108",
            "speakerId": 20338,
            "speakerName": "鲸井小弟",
            "text": "咦？是一个很厉害的大姐姐冒险家教我的。她还说…",
            "nextDialogs": [
              "721760109"
            ]
          },
          "721760109": {
            "id": "721760109",
            "speakerId": 20338,
            "speakerName": "鲸井小弟",
            "text": "「鲸井，好好记住。你一定要说，『如果你赢了，就可以得到好东西』。」",
            "nextDialogs": [
              "721760110"
            ]
          },
          "721760110": {
            "id": "721760110",
            "speakerId": 20338,
            "speakerName": "鲸井小弟",
            "text": "#所以，{PLAYERAVATAR#SEXPRO[INFO_MALE_PRONOUN_BIGBROTHER|INFO_FEMALE_PRONOUN_BIGSISTER]}，如果你赢了，就可以得到好东西。",
            "nextDialogs": [
              "721760111"
            ]
          },
          "721760111": {
            "id": "721760111",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "#是好东西！{NICKNAME}，我觉得陪小孩子玩是天经地义的事情！",
            "nextDialogs": [
              "721760113"
            ]
          },
          "721760113": {
            "id": "721760113",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "可能是只有当地人才知道的玩法，不要在意这种细节嘛。",
            "nextDialogs": [
              "721760114"
            ]
          },
          "721760114": {
            "id": "721760114",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "是鲸井小弟对吧？我们陪你玩！",
            "nextDialogs": [
              "721760116"
            ]
          },
          "721760116": {
            "id": "721760116",
            "speakerId": 20338,
            "speakerName": "鲸井小弟",
            "text": "好耶！"
          }
        }
      }
    },
    {

    {
      "subId": "7403301",
      "subQuestName": "与卡特皮拉对话",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "740330101"
        ],
        "dialogs": {
          "740330101": {
            "id": "740330101",
            "speakerId": 21048,
            "speakerName": "卡特皮拉",
            "text": "晶簇矿坑道封锁之后，这里就不太有人来了，这里的机械装置也不适合外行摆弄。",
            "nextDialogs": [
              "740330102"
            ]
          },
          "740330102": {
            "id": "740330102",
            "speakerId": 21048,
            "speakerName": "卡特皮拉",
            "text": "不过这次就是有人随意摆弄传动机阀，把自己的同伴关了起来…",
            "nextDialogs": [
              "740330103"
            ]
          },
          "740330103": {
            "id": "740330103",
            "speakerId": 21048,
            "speakerName": "卡特皮拉",
            "text": "总之，我们先操作传动机阀打开通向<color=#00E1FFFF>一号备品仓库</color>的连通路吧。如果待会儿他要请你喝什么饮料，最好还是婉拒。",
            "nextDialogs": [
              "740330104"
            ]
          },
          "740330104": {
            "id": "740330104",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "谁要请我们喝饮料？为什么不喝呢？",
            "nextDialogs": [
              "740330105"
            ]
          },
          "740330105": {
            "id": "740330105",
            "speakerId": 21048,
            "speakerName": "卡特皮拉",
            "text": "待会儿你就知道了。"
          }
        }
      }
    },
    {
      "subId": "7403305",

        "dialogs": {}
      }
    },
    {
      "subId": "4012909",
      "subQuestName": "和众人交谈",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "401290901"
        ],
        "dialogs": {
          "401290901": {
            "id": "401290901",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "这里就是菲米尼找到的水下遗迹吗？虽然有点壮观，但跟想象中还是有些不一样…",
            "nextDialogs": [
              "401290902"
            ]
          },
          "401290902": {
            "id": "401290902",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "不是水下遗迹，是水妖王国。",
            "nextDialogs": [
              "401290903"
            ]
          },
          "401290903": {
            "id": "401290903",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "知道啦，我是说…我还以为真的会看到一个童话世界呢，比如水妖们住的彩色房子，还有彩虹桥…",
            "nextDialogs": [
              "401290904"
            ]
          },
          "401290904": {
            "id": "401290904",
            "speakerId": 1074,
            "speakerName": "菲米尼",
            "text": "抱歉…其实我有想过做一些装饰，但是因为人力和时间关系…",
            "nextDialogs": [
              "401290905"
            ]
          },
          "401290905": {
            "id": "401290905",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "没关系，现在是幻想时间！",
            "nextDialogs": [
              "401290906"
            ]
          },
          "401290906": {
            "id": "401290906",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "#喂喂！{NICKNAME}，你一下就入戏好深哦。",
            "nextDialogs": [
              "401290907"
            ]
          },
          "401290907": {
            "id": "401290907",
            "speakerId": 13558,
            "speakerName": "祖莉亚·德斯特雷",
            "text": "#说明{NICKNAME}已经领会到精髓了，小派蒙也要加油。",
            "nextDialogs": [
              "401290908"
            ]
          },
          "401290908": {
            "id": "401290908",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "哼，不要小看我，我不会拖后腿的，现在就进入…进入幻想派蒙模式！",
            "nextDialogs": [
              "401290909"
            ]
          },
          "401290909": {
            "id": "401290909",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "咳咳…年轻的勇者们哟！我是守护此地的女神派蒙，诸位来此有何贵干哟？",
            "nextDialogs": [
              "401290910"
            ]
          },
          "401290910": {
            "id": "401290910",
            "speakerId": 1074,
            "speakerName": "菲米尼",
            "text": "…呃…",
            "nextDialogs": [
              "401290911"
            ]
          },
          "401290911": {
            "id": "401290911",
            "speakerId": 13558,
            "speakerName": "祖莉亚·德斯特雷",
            "text": "回禀女神大人，我们是王子特尔克西的伙伴，来到此地是要帮他寻回遗失的荣耀。",
            "nextDialogs": [
              "401290912"
            ]
          },
          "401290912": {
            "id": "401290912",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "喔——寻回荣耀哟！本女神这里有一个金荣耀，一个银荣耀和一个铜荣耀，哪一个才是王子遗失的呢？",
            "nextDialogs": [
              "401290913"
            ]
          },
          "401290913": {
            "id": "401290913",
            "speakerId": 13558,
            "speakerName": "祖莉亚·德斯特雷",
            "text": "咦？",
            "nextDialogs": [
              "401290914"
            ]
          },
          "401290914": {
            "id": "401290914",
            "speakerId": 1074,
            "speakerName": "菲米尼",
            "text": "唔…",
            "nextDialogs": [
              "401290915"
            ]
          },
          "401290915": {
            "id": "401290915",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "是不是串戏了？",
            "nextDialogs": [
              "401290916"
            ]
          },
          "401290916": {
            "id": "401290916",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "才没有！这是女神的测试哟！本女神已经测试出来，你们的内心没有一丝贪婪，是真正值得尊敬的勇者哟！",
            "nextDialogs": [
              "401290917"
            ]
          },
          "401290917": {
            "id": "401290917",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "那么请接受本女神的奖励吧，本女神要把金荣耀，银荣耀和铜荣耀全部奖励给你们！",
            "nextDialogs": [
              "401290918"
            ]
          },
          "401290918": {
            "id": "401290918",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "还有这位王子，本女神要额外再赐予你七彩的荣耀，愿你的未来充满明亮！",
            "nextDialogs": [
              "401290919"
            ]
          },
          "401290919": {
            "id": "401290919",
            "speakerId": 13587,
            "speakerName": "「特尔克西」",
            "text": "-.. -... .-- -...？",
            "nextDialogs": [
              "401290920"
            ]
          },
          "401290920": {
            "id": "401290920",
            "speakerId": 13558,
            "speakerName": "祖莉亚·德斯特雷",
            "text": "多谢女神大人的祝福，我现在感觉浑身充满了力量。",
            "nextDialogs": [
              "401290921"
            ]
          },
          "401290921": {
            "id": "401290921",
            "speakerId": 1074,
            "speakerName": "菲米尼",
            "text": "我…我也是…哇…这就是传说中的，女神的真言鼓舞吗？",
            "nextDialogs": [
              "401290922"
            ]
          },
          "401290922": {
            "id": "401290922",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "派蒙女神真是太厉害啦！",
            "nextDialogs": [
              "401290923"
            ]
          },
          "401290923": {
            "id": "401290923",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "哼哼，勇者们哟，现在就去打败侵占王国的魔物吧！你们一定能在此地找到想要的东西！"
          }
        }
      }
    },
    {
      "subId": "4012905",
      "subQuestName": "击败魔物",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [],
        "dialogs": {}
      }
    },
    {
      "subId": "4012906",
      "subQuestName": "与菲米尼对话",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "401290601"
        ],
        "dialogs": {
          "401290601": {
            "id": "401290601",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "呼——终于结束啦，这下就算我们打败了邪恶的魔物，顺利夺回了水妖王国对吧？",
            "nextDialogs": [
              "401290602"
            ]
          },
          "401290602": {
            "id": "401290602",
            "speakerId": 13558,
            "speakerName": "祖莉亚·德斯特雷",
            "text": "是的，到这里，本来应该为「特尔克西」举行加冕仪式了，只是…原以为不可能一次就闯入遗迹的最深处，没想到今天这么顺利…",
            "nextDialogs": [
              "401290603"
            ]
          },
          "401290603": {
            "id": "401290603",
            "speakerId": 13558,
            "speakerName": "祖莉亚·德斯特雷",
            "text": "是我的问题，我应该早点告诉菲米尼先生，还需要一个王冠…",
            "nextDialogs": [
              "401290604"
            ]
          },
          "401290604": {
            "id": "401290604",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "#是{NICKNAME}和本女神太厉害啦，一下就捅穿了魔物的老巢！",
            "nextDialogs": [
              "401290605"
            ]
          },
          "401290605": {
            "id": "401290605",
            "speakerId": 1074,
            "speakerName": "菲米尼",
            "text": "没关系，祖莉亚夫人，等做好王冠，我们还可以再来一趟。",
            "nextDialogs": [
              "401290606"
            ]
          },
          "401290606": {
            "id": "401290606",
            "speakerId": 13558,
            "speakerName": "祖莉亚·德斯特雷",
            "text": "那真要辛苦大家了，还有「特尔克西」，我的孩子，你也很棒。",
            "nextDialogs": [
              "401290607"
            ]
          },
          "401290607": {
            "id": "401290607",
            "speakerId": 13587,
            "speakerName": "「特尔克西」",
            "text": "-.-  ..-.   ..-  -...  .---  -.  ..-. -.  -...  -.  -...  ---",
            "nextDialogs": [
              "401290608"
            ]
          },
          "401290608": {
            "id": "401290608",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "确实没想到哦，「特尔克西」也很能打嘛！",
            "nextDialogs": [
              "401290609"
            ]
          },
          "401290609": {
            "id": "401290609",
            "speakerId": 1074,
            "speakerName": "菲米尼",
            "text": "他就像个真正的王子，我想…没有什么困难能够一直阻碍他。",
            "nextDialogs": [
              "401290610"
            ]
          },
          "401290610": {
            "id": "401290610",
            "speakerId": 13558,
            "speakerName": "祖莉亚·德斯特雷",
            "text": "菲米尼先生…嗯！我相信！",
            "nextDialogs": [
              "401290611"
            ]
          },
          "401290611": {
            "id": "401290611",
            "speakerId": 1074,
            "speakerName": "菲米尼",
            "text": "#先回营地吧，来的路上拜托了{NICKNAME}搜集材料，我想尽快把王冠做出来。",
            "nextDialogs": [
              "401290612"
            ]
          },
          "401290612": {
            "id": "401290612",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "正好回去把我们的旅程画下来，夺回了水妖王国，《特尔克西的奇幻历险》也可以更新啦。"
          }
        }
      }
    },
    {
      "subId": "4012913",
      "subQuestName": "离开水妖王国",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [],
        "dialogs": {}
      }
    },
    {
      "subId": "4012908",
      "subQuestName": "返回营地",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "401290801"
        ],
        "dialogs": {
          "401290801": {
            "id": "401290801",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "祖莉亚夫人，菲米尼，我们先来画画吧？比起王冠，我更想看看绘本的新内容！",
            "nextDialogs": [
              "401290802"
            ]
          },
          "401290802": {
            "id": "401290802",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "其实是在期待派蒙女神的样子吧？",
            "nextDialogs": [
              "401290803"
            ]
          },
          "401290803": {
            "id": "401290803",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "哎呀！你知道就行了，不用一定说出来的！",
            "nextDialogs": [
              "401290804"
            ]
          },
          "401290804": {
            "id": "401290804",
            "speakerId": 13558,
            "speakerName": "祖莉亚·德斯特雷",
            "text": "哈哈，好，我知道了，那么今天的故事应该是这样…",
            "nextDialogs": [
              "401290805"
            ]
          },
          "401290805": {
            "id": "401290805",
            "speakerId": 13558,
            "speakerName": "祖莉亚·德斯特雷",
            "text": "在历经千难万险后，王子与他的勇者们终于抵达了水妖王国的入口。",
            "nextDialogs": [
              "401290806"
            ]
          },
          "401290806": {
            "id": "401290806",
            "speakerId": 13558,
            "speakerName": "祖莉亚·德斯特雷",
            "text": "这时，同伴中的小精灵派蒙，向大家展现了她的真实身份——一位隐藏的女神。",
            "nextDialogs": [
              "401290807"
            ]
          },
          "401290807": {
            "id": "401290807",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "好耶！女神出场了！女神大大赞扬了勇者们的诚实，作为奖励，她洒下好多好多祝福，然后还许愿王子一定能够完成目标！",
            "nextDialogs": [
              "401290808"
            ]
          },
          "401290808": {
            "id": "401290808",
            "speakerId": 13558,
            "speakerName": "祖莉亚·德斯特雷",
            "text": "沐浴在女神的荣耀下，王子与勇者冲入了邪恶的巢穴，驱逐了魔物，拯救了被关押的可爱水妖。王子终于夺回了王国，但王冠…",
            "nextDialogs": [
              "401290809"
            ]
          },
          "401290809": {
            "id": "401290809",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "哎呀，王冠还没有做好！",
            "nextDialogs": [
              "401290810"
            ]
          },
          "401290810": {
            "id": "401290810",
            "speakerId": 1074,
            "speakerName": "菲米尼",
            "text": "不…王冠就在那，逃跑的魔物将它秘密带走了，邪恶仍不死心。但王子很快就会夺回王冠，绚烂的彩虹会重新降临在王国中。",
            "nextDialogs": [
              "401290811"
            ]
          },
          "401290811": {
            "id": "401290811",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "唔…这个解释…很有代入感！",
            "nextDialogs": [
              "401290812"
            ]
          },
          "401290812": {
            "id": "401290812",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "哇，真好…祖莉亚夫人画得真好…",
            "nextDialogs": [
              "401290813"
            ]
          },
          "401290813": {
            "id": "401290813",
            "speakerId": 13558,
            "speakerName": "祖莉亚·德斯特雷",
            "text": "谢谢，这下绘本的第二页也完成了，「特尔克西」的历险离终点越来越近，他会加冕为王…",
            "nextDialogs": [
              "401290814"
            ]
          },
          "401290814": {
            "id": "401290814",
            "speakerId": 13558,
            "speakerName": "祖莉亚·德斯特雷",
            "text": "而我的孩子，你一定也会在那时振作起来吧？",
            "nextDialogs": [
              "401290815"
            ]
          },
          "401290815": {
            "id": "401290815",
            "speakerId": 13587,
            "speakerName": "「特尔克西」",
            "text": "-.-  ..-.   ..-  -...  .---  -.  ..-. -.  -...  -.  -...  ---",
            "nextDialogs": [
              "401290816"
            ]
          },
          "401290816": {
            "id": "401290816",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "一定会的，祖莉亚夫人！而且，说不定今天你回家后，就能听见医生的好消息了呢。",
            "nextDialogs": [
              "401290817"
            ]
          },
          "401290817": {
            "id": "401290817",
            "speakerId": 13558,
            "speakerName": "祖莉亚·德斯特雷",
            "text": "借您吉言，女神大人。对了，菲米尼先生，关于王冠的制作…",
            "nextDialogs": [
              "401290818"
            ]
          },
          "401290818": {
            "id": "401290818",
            "speakerId": 1074,
            "speakerName": "菲米尼",
            "text": "一天的时间足够了，请放心。",
            "nextDialogs": [
              "401290819"
            ]
          },
          "401290819": {
            "id": "401290819",
            "speakerId": 13558,
            "speakerName": "祖莉亚·德斯特雷",
            "text": "麻烦你了，那么最后的历险，就还放在两天后吧，大家仍然在这里集合，好吗？",
            "nextDialogs": [
              "401290820"
            ]
          },
          "401290820": {
            "id": "401290820",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "没问题。",
            "nextDialogs": [
              "401290821"
            ]
          },
          "401290821": {
            "id": "401290821",
            "speakerId": 13558,
            "speakerName": "祖莉亚·德斯特雷",
            "text": "那两天后见了，可爱的朋友们。",
            "nextDialogs": [
              "401290822"
            ]
          },
          "401290822": {
            "id": "401290822",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "哎呀，夫人回去了，我们差不多也该回去了，菲米尼还有工作要做吧？",
            "nextDialogs": [
              "401290823"
            ]
          },
          "401290823": {
            "id": "401290823",
            "speakerId": 1074,
            "speakerName": "菲米尼",
            "text": "嗯，我待会要去城里买一些零件，用来制作王冠的底座。我打算做几个不同的方案，然后选出最合适的那个。",
            "nextDialogs": [
              "401290826"
            ]
          },
          "401290826": {
            "id": "401290826",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "是呀，我以前只知道菲米尼不会轻易接受别人的委托，没想到一旦接受了委托会这么用心呢。",
            "nextDialogs": [
              "401290827"
            ]
          },
          "401290827": {
            "id": "401290827",
            "speakerId": 1074,
            "speakerName": "菲米尼",
            "text": "…可能…因为…",
            "nextDialogs": [
              "401290828"
            ]
          },
          "401290828": {
            "id": "401290828",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "什么？",
            "nextDialogs": [
              "401290829"
            ]
          },
          "401290829": {
            "id": "401290829",
            "speakerId": 1074,
            "speakerName": "菲米尼",
            "text": "因为…我希望…",
            "nextDialogs": [
              "401290830"
            ]
          },
          "401290830": {
            "id": "401290830",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "哎呀，怎么吞吞吐吐的，那是什么表情呀？感觉立刻就要脸红戴上头盔躲起来了呢。",
            "nextDialogs": [
              "401290831"
            ]
          },
          "401290831": {
            "id": "401290831",
            "speakerId": 1074,
            "speakerName": "菲米尼",
            "text": "啊！我脸红了吗？",
            "nextDialogs": [
              "401290832"
            ]
          },
          "401290832": {
            "id": "401290832",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "不要为难菲米尼了。",
            "nextDialogs": [
              "401290833"
            ]
          },
          "401290833": {
            "id": "401290833",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "嘿嘿，好啦，菲米尼，那今天就不打扰你的工作了哦，我们两天后再见吧。",
            "nextDialogs": [
              "401290834"
            ]
          },
          "401290834": {
            "id": "401290834",
            "speakerId": 1074,
            "speakerName": "菲米尼",
            "text": "…谢谢…好…两天后见…",
            "nextDialogs": [
              "401290835"
            ]
          },
          "401290835": {
            "id": "401290835",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "两天后见。",
            "nextDialogs": [
              "401290836"
            ]
          },
          "401290836": {
            "id": "401290836",
            "speakerId": 1074,
            "speakerName": "菲米尼",
            "text": "…我希望，所有身处困境的人们，都能看到美好的东西，都能看到奇迹…"
          }
        }
      }
    },
    {
      "subId": "4012910",
      "subQuestName": "等待到两天后$HIDDEN",
      "sceneId": null,
      "locations": [],

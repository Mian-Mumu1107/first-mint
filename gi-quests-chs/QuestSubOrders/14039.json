    },
    {
      "subId": "1403923",
      "subQuestName": "前往德波大饭店二楼赴约",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "140390801"
        ],
        "dialogs": {
          "140390801": {
            "id": "140390801",
            "speakerId": 14262,
            "speakerName": "议论纷纷的群众",
            "text": "…你知道吗？艾梅莉埃小姐要推出新的香水了！",
            "nextDialogs": [
              "140390802"
            ]
          },
          "140390802": {
            "id": "140390802",
            "speakerId": 14262,
            "speakerName": "议论纷纷的群众",
            "text": "啊，我也听说了，名字好像是叫…「叶莲娜」…",
            "nextDialogs": [
              "140390803"
            ]
          },
          "140390803": {
            "id": "140390803",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "…感觉最近枫丹上下，都在讨论你还没出的新香水呢。",
            "nextDialogs": [
              "140390804"
            ]
          },
          "140390804": {
            "id": "140390804",
            "speakerId": 1090,
            "speakerName": "艾梅莉埃",
            "text": "我本来只想低调上架，没想到消息传得这么快。",
            "nextDialogs": [
              "140390805"
            ]
          },
          "140390805": {
            "id": "140390805",
            "speakerId": 1090,
            "speakerName": "艾梅莉埃",
            "text": "希望不要又成了另一个「神话」…不然就没有给「奥古斯都」祛魅的意义了。",
            "nextDialogs": [
              "140390808"
            ]
          },
          "140390808": {
            "id": "140390808",
            "speakerId": 1090,
            "speakerName": "艾梅莉埃",
            "text": "嗯，我后来又调整了一下配方，让它的香味能更持久宜人…今天正好带了一些样品过来，希望你们能喜欢。",
            "nextDialogs": [
              "140390809"
            ]
          },
          "140390809": {
            "id": "140390809",
            "speakerId": 1090,
            "speakerName": "艾梅莉埃",
            "text": "另外…我也想请你们在正式发售前试试香，再说说自己的感想。",
            "nextDialogs": [
              "140390810"
            ]
          },
          "140390810": {
            "id": "140390810",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "好嘞！我听说味觉灵敏的人，嗅觉也不会差，就交给我吧！",
            "nextDialogs": [
              "140390811"
            ]
          },
          "140390811": {
            "id": "140390811",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "…嗯…很香！非常好闻！",
            "nextDialogs": [
              "140390812"
            ]
          },
          "140390812": {
            "id": "140390812",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "这可不是什么有用的感想…",
            "nextDialogs": [
              "140390813"
            ]
          },
          "140390813": {
            "id": "140390813",
            "speakerId": 1090,
            "speakerName": "艾梅莉埃",
            "text": "呵呵，没关系，这也是一种值得纳入考量的用户反馈。",
            "nextDialogs": [
              "140390814"
            ]
          },
          "140390814": {
            "id": "140390814",
            "speakerId": 1090,
            "speakerName": "艾梅莉埃",
            "text": "而且对一款香水来说…「很香」就已经是最直达本质的评价了，不需要有多少深意。",
            "nextDialogs": [
              "140390815"
            ]
          },
          "140390815": {
            "id": "140390815",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "说起深意…基里亚最后的问题…",
            "nextDialogs": [
              "140390816"
            ]
          },
          "140390816": {
            "id": "140390816",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "对哦…那几种花…有什么特别的含义吗？好像他在听到这几个花名的时候，态度就有点变化了…",
            "nextDialogs": [
              "140390817"
            ]
          },
          "140390817": {
            "id": "140390817",
            "speakerId": 1090,
            "speakerName": "艾梅莉埃",
            "text": "大概…是因为「花语」吧。",
            "nextDialogs": [
              "140390818"
            ]
          },
          "140390818": {
            "id": "140390818",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "花语？啊，从前好像有听过，塞西莉亚花的「花语」是「浪子的真情」…之类的。",
            "nextDialogs": [
              "140390819"
            ]
          },
          "140390819": {
            "id": "140390819",
            "speakerId": 1090,
            "speakerName": "艾梅莉埃",
            "text": "每种花在不同的时期、不同人的口中，都会被赋予不同的花语…构成奥古斯都花香气的数种花卉也是这样。",
            "nextDialogs": [
              "140390820"
            ]
          },
          "140390820": {
            "id": "140390820",
            "speakerId": 1090,
            "speakerName": "艾梅莉埃",
            "text": "我回枫丹后去查了一下…然后发现，将它们的花语拆解组合之后，可以拼出一句话…",
            "nextDialogs": [
              "140390821"
            ]
          },
          "140390821": {
            "id": "140390821",
            "speakerId": 1090,
            "speakerName": "艾梅莉埃",
            "text": "「…忘记过往，坚强地活下去。」",
            "nextDialogs": [
              "140390822"
            ]
          },
          "140390822": {
            "id": "140390822",
            "speakerId": 1090,
            "speakerName": "艾梅莉埃",
            "text": "奥古斯都的花语，在世人的眼里是高贵、神圣，但在培育它的叶莲娜眼里…或许是这个意思吧。",
            "nextDialogs": [
              "140390823"
            ]
          },
          "140390823": {
            "id": "140390823",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "又或许…这才是她对弟弟的期许…",
            "nextDialogs": [
              "140390824"
            ]
          },
          "140390824": {
            "id": "140390824",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "对哦！那基里亚…他知道这件事了吗？",
            "nextDialogs": [
              "140390825"
            ]
          },
          "140390825": {
            "id": "140390825",
            "speakerId": 1090,
            "speakerName": "艾梅莉埃",
            "text": "我在开庭前去探视过一次，也说过这个猜想…但他看起来不是很在意。",
            "nextDialogs": [
              "140390826"
            ]
          },
          "140390826": {
            "id": "140390826",
            "speakerId": 1090,
            "speakerName": "艾梅莉埃",
            "text": "「谁知道呢？说不定她那时候，什么都没想呢？」——他是这么说的。",
            "nextDialogs": [
              "140390827"
            ]
          },
          "140390827": {
            "id": "140390827",
            "speakerId": 1090,
            "speakerName": "艾梅莉埃",
            "text": "「…姐姐已经不在了，她真正的想法已经无人能知。后人做的一切注解，都只是附会与猜测。」",
            "nextDialogs": [
              "140390828"
            ]
          },
          "140390828": {
            "id": "140390828",
            "speakerId": 1090,
            "speakerName": "艾梅莉埃",
            "text": "「就算她真是这么想的，我也没办法忘掉她活着。」",
            "nextDialogs": [
              "140390829"
            ]
          },
          "140390829": {
            "id": "140390829",
            "speakerId": 1090,
            "speakerName": "艾梅莉埃",
            "text": "「…为她复仇，就是我给自己的人生，赋予的意义。」",
            "nextDialogs": [
              "140390830"
            ]
          },
          "140390830": {
            "id": "140390830",
            "speakerId": 1090,
            "speakerName": "艾梅莉埃",
            "text": "…他已如自己所愿地绽放过，哪怕没有结出自己希望的果实。",
            "nextDialogs": [
              "140390831"
            ]
          },
          "140390831": {
            "id": "140390831",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "…基里亚。",
            "nextDialogs": [
              "140390832"
            ]
          },
          "140390832": {
            "id": "140390832",
            "speakerId": 1090,
            "speakerName": "艾梅莉埃",
            "text": "不过，老师还是托我给你们带了一句「谢谢」。",
            "nextDialogs": [
              "140390833"
            ]
          },
          "140390833": {
            "id": "140390833",
            "speakerId": 1090,
            "speakerName": "艾梅莉埃",
            "text": "「…谢谢你们，在那时让我活了下来。让我活着知道了…奥古斯都的『花语』，还有这种可能。」",
            "nextDialogs": [
              "140390834"
            ]
          },
          "140390834": {
            "id": "140390834",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "……",
            "nextDialogs": [
              "140390835"
            ]
          },
          "140390835": {
            "id": "140390835",
            "speakerId": 1090,
            "speakerName": "艾梅莉埃",
            "text": "无论是爱还是恨，都是生者的特权。",
            "nextDialogs": [
              "140390836"
            ]
          },
          "140390836": {
            "id": "140390836",
            "speakerId": 1090,
            "speakerName": "艾梅莉埃",
            "text": "逝者的思绪早已随生命而去，奥古斯都真正的花语，已经是永远的谜了。",
            "nextDialogs": [
              "140390837"
            ]
          },
          "140390837": {
            "id": "140390837",
            "speakerId": 1090,
            "speakerName": "艾梅莉埃",
            "text": "但…就算是附会猜测，我也还是愿意相信自己的解读。",
            "nextDialogs": [
              "140390838"
            ]
          },
          "140390838": {
            "id": "140390838",
            "speakerId": 1090,
            "speakerName": "艾梅莉埃",
            "text": "花语的寓意、香水的象征…尽管会在世事跌宕中不停地被曲解与利用…",
            "nextDialogs": [
              "140390839"
            ]
          },
          "140390839": {
            "id": "140390839",
            "speakerId": 1090,
            "speakerName": "艾梅莉埃",
            "text": "但最初的最初，它们的诞生，都源自人们最简单、最美好的愿望。"
          }
        }
      }
    },

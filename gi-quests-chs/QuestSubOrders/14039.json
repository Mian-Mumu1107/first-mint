  "subQuests": [
    {
      "subId": "1403907",
      "subQuestName": "追踪基里亚",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "140390701"
        ],
        "dialogs": {
          "140390701": {
            "id": "140390701",
            "speakerId": 1000,
            "speakerName": "基里亚",
            "text": "嗬…嗬…咳！咳咳…",
            "nextDialogs": [
              "140390702"
            ]
          },
          "140390702": {
            "id": "140390702",
            "speakerId": 1090,
            "speakerName": "艾梅莉埃",
            "text": "花香…浓烈…终点应该…",
            "nextDialogs": [
              "140390703"
            ]
          },
          "140390703": {
            "id": "140390703",
            "speakerId": 1000,
            "speakerName": "基里亚",
            "text": "…这么快就追上来了吗？",
            "nextDialogs": [
              "140390704"
            ]
          },
          "140390704": {
            "id": "140390704",
            "speakerId": 1000,
            "speakerName": "基里亚",
            "text": "不…是我已经没力气了啊…",
            "nextDialogs": [
              "140390705"
            ]
          },
          "140390705": {
            "id": "140390705",
            "speakerId": 1000,
            "speakerName": "基里亚",
            "text": "…不过到这里…就已经够了。",
            "nextDialogs": [
              "140390706"
            ]
          },
          "140390706": {
            "id": "140390706",
            "speakerId": 1000,
            "speakerName": "基里亚",
            "text": "哼…",
            "nextDialogs": [
              "140390707"
            ]
          },
          "140390707": {
            "id": "140390707",
            "speakerId": 1000,
            "speakerName": "基里亚",
            "text": "哈——",
            "nextDialogs": [
              "140390708"
            ]
          },
          "140390708": {
            "id": "140390708",
            "speakerId": 1000,
            "speakerName": "基里亚",
            "text": "…这里是…「奥古斯都」的花圃？",
            "nextDialogs": [
              "140390709"
            ]
          },
          "140390709": {
            "id": "140390709",
            "speakerId": 1000,
            "speakerName": "基里亚",
            "text": "…不是我的花圃…是那天在枫丹被烧毁的…",
            "nextDialogs": [
              "140390710"
            ]
          },
          "140390710": {
            "id": "140390710",
            "speakerId": 1000,
            "speakerName": "基里亚",
            "text": "…姐姐？",
            "nextDialogs": [
              "140390711"
            ]
          },
          "140390711": {
            "id": "140390711",
            "speakerId": 1000,
            "speakerName": "基里亚",
            "text": "——姐姐！",
            "nextDialogs": [
              "140390712"
            ]
          },
          "140390712": {
            "id": "140390712",
            "speakerId": 1000,
            "speakerName": "基里亚",
            "text": "我…其实一直都明白的！",
            "nextDialogs": [
              "140390713"
            ]
          },
          "140390713": {
            "id": "140390713",
            "speakerId": 1000,
            "speakerName": "基里亚",
            "text": "都是因为我，你才会继续用邪眼！都是因为我，你才会烧掉花圃！",
            "nextDialogs": [
              "140390714"
            ]
          },
          "140390714": {
            "id": "140390714",
            "speakerId": 1000,
            "speakerName": "基里亚",
            "text": "…那一天，我就不该听你说的，带钱离开枫丹廷…",
            "nextDialogs": [
              "140390715"
            ]
          },
          "140390715": {
            "id": "140390715",
            "speakerId": 1000,
            "speakerName": "基里亚",
            "text": "等我发现不对的时候…花圃也好…你也好…什么都没了…",
            "nextDialogs": [
              "140390716"
            ]
          },
          "140390716": {
            "id": "140390716",
            "speakerId": 1000,
            "speakerName": "基里亚",
            "text": "…我早该过来找你的…十多年前我就应该来找你的！",
            "nextDialogs": [
              "140390717"
            ]
          },
          "140390717": {
            "id": "140390717",
            "speakerId": 1000,
            "speakerName": "基里亚",
            "text": "我早该跟你…一起死在这一天的…",
            "nextDialogs": [
              "140390718"
            ]
          },
          "140390718": {
            "id": "140390718",
            "speakerId": 1002,
            "speakerName": "叶莲娜",
            "text": "……",
            "nextDialogs": [
              "140390719"
            ]
          },
          "140390719": {
            "id": "140390719",
            "speakerId": 1000,
            "speakerName": "基里亚",
            "text": "…姐姐？",
            "nextDialogs": [
              "140390720"
            ]
          },
          "140390720": {
            "id": "140390720",
            "speakerId": 1000,
            "speakerName": "基里亚",
            "text": "——！",
            "nextDialogs": [
              "140390721"
            ]
          },
          "140390721": {
            "id": "140390721",
            "speakerId": 1000,
            "speakerName": "基里亚",
            "text": "——姐姐！？",
            "nextDialogs": [
              "140390722"
            ]
          },
          "140390722": {
            "id": "140390722",
            "speakerId": 1002,
            "speakerName": "叶莲娜",
            "text": "……",
            "nextDialogs": [
              "140390723"
            ]
          },
          "140390723": {
            "id": "140390723",
            "speakerId": 1000,
            "speakerName": "基里亚",
            "text": "不要——不要留下我…",
            "nextDialogs": [
              "140390724"
            ]
          },
          "140390724": {
            "id": "140390724",
            "speakerId": 1000,
            "speakerName": "基里亚",
            "text": "叶莲娜——！！",
            "nextDialogs": [
              "140390725"
            ]
          },
          "140390725": {
            "id": "140390725",
            "speakerId": 1000,
            "speakerName": "基里亚",
            "text": "呃…唔…",
            "nextDialogs": [
              "140390726"
            ]
          },
          "140390726": {
            "id": "140390726",
            "speakerId": 1000,
            "speakerName": "基里亚",
            "text": "…艾梅莉埃？",
            "nextDialogs": [
              "140390727"
            ]
          },
          "140390727": {
            "id": "140390727",
            "speakerId": 1000,
            "speakerName": "基里亚",
            "text": "我…还没死？怎么可能？我明明…都见到她了…",
            "nextDialogs": [
              "140390728"
            ]
          },
          "140390728": {
            "id": "140390728",
            "speakerId": 1090,
            "speakerName": "艾梅莉埃",
            "text": "…只是你体内残留的毒素，和奥古斯都花粉引致的幻觉而已，并不致命。",
            "nextDialogs": [
              "140390729"
            ]
          },
          "140390729": {
            "id": "140390729",
            "speakerId": 1000,
            "speakerName": "基里亚",
            "text": "不可能…我服下的「奥古斯都」…剂量明明是够的…",
            "nextDialogs": [
              "140390732"
            ]
          },
          "140390732": {
            "id": "140390732",
            "speakerId": 1000,
            "speakerName": "基里亚",
            "text": "…仿制？这怎么可能…",
            "nextDialogs": [
              "140390733"
            ]
          },
          "140390733": {
            "id": "140390733",
            "speakerId": 1090,
            "speakerName": "艾梅莉埃",
            "text": "…从昨晚开始，我们就在着手准备了。",
            "nextDialogs": [
              "140390734"
            ]
          },
          "140390734": {
            "id": "140390734",
            "speakerId": 1090,
            "speakerName": "艾梅莉埃",
            "text": "——「奥古斯都」的谐{RUBY#[D]Accord}香。",
            "nextDialogs": [
              "140390735"
            ]
          },
          "140390735": {
            "id": "140390735",
            "speakerId": 1000,
            "speakerName": "基里亚",
            "text": "…那个时候，你就调换了「奥古斯都」吗？借着向我报告席尔万死讯的机会…",
            "nextDialogs": [
              "140390736"
            ]
          },
          "140390736": {
            "id": "140390736",
            "speakerId": 1090,
            "speakerName": "艾梅莉埃",
            "text": "那时候您以为复仇已经完成…是最容易放松戒备的时刻。",
            "nextDialogs": [
              "140390737"
            ]
          },
          "140390737": {
            "id": "140390737",
            "speakerId": 1000,
            "speakerName": "基里亚",
            "text": "不可能…就算有机会调换，又怎么调得出「奥古斯都」的谐香？",
            "nextDialogs": [
              "140390738"
            ]
          },
          "140390738": {
            "id": "140390738",
            "speakerId": 1000,
            "speakerName": "基里亚",
            "text": "如果它有那么容易仿制，姐姐就不会…",
            "nextDialogs": [
              "140390739"
            ]
          },
          "140390739": {
            "id": "140390739",
            "speakerId": 1090,
            "speakerName": "艾梅莉埃",
            "text": "我用了虹彩蔷薇、琉璃百合…还有塞西莉亚花…这在十多年前是个会互相冲突的配方。",
            "nextDialogs": [
              "140390740"
            ]
          },
          "140390740": {
            "id": "140390740",
            "speakerId": 1090,
            "speakerName": "艾梅莉埃",
            "text": "但现在，已经有办法互相协调了。",
            "nextDialogs": [
              "140390741"
            ]
          },
          "140390741": {
            "id": "140390741",
            "speakerId": 1000,
            "speakerName": "基里亚",
            "text": "…虹彩蔷薇…琉璃百合…塞西莉亚花…？",
            "nextDialogs": [
              "140390742"
            ]
          },
          "140390742": {
            "id": "140390742",
            "speakerId": 1090,
            "speakerName": "艾梅莉埃",
            "text": "…「奥古斯都」已经是十多年前的香水了，在这些年里，对它的分析和模仿从未停止。",
            "nextDialogs": [
              "140390743"
            ]
          },
          "140390743": {
            "id": "140390743",
            "speakerId": 1090,
            "speakerName": "艾梅莉埃",
            "text": "调香的技术也已经日新月异，除了古老的精油萃取、油脂离析…我们还发现了更多调和香味的手段。",
            "nextDialogs": [
              "140390744"
            ]
          },
          "140390744": {
            "id": "140390744",
            "speakerId": 1090,
            "speakerName": "艾梅莉埃",
            "text": "十多年前牢不可破的神话…现在也是时候成为过去了。",
            "nextDialogs": [
              "140390745"
            ]
          },
          "140390745": {
            "id": "140390745",
            "speakerId": 1000,
            "speakerName": "基里亚",
            "text": "「过去」…",
            "nextDialogs": [
              "140390746"
            ]
          },
          "140390746": {
            "id": "140390746",
            "speakerId": 1090,
            "speakerName": "艾梅莉埃",
            "text": "您这些年作为调香师并没有固步自封，理论上有没有可能，您其实很清楚。",
            "nextDialogs": [
              "140390747"
            ]
          },
          "140390747": {
            "id": "140390747",
            "speakerId": 1090,
            "speakerName": "艾梅莉埃",
            "text": "只是您太执着于自己给「奥古斯都」赋予的意义…就像陷入「香水狂热」时的人们一样。",
            "nextDialogs": [
              "140390748"
            ]
          },
          "140390748": {
            "id": "140390748",
            "speakerId": 1090,
            "speakerName": "艾梅莉埃",
            "text": "相信着它的「神圣」，相信着它的「高贵」，相信着它的「独一无二」…"
          }
        }
      }
    },
    {
      "subId": "1403908",
      "subQuestName": "询问目击者",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "140390201"
        ],
        "dialogs": {
          "140390201": {
            "id": "140390201",
            "speakerId": 4151,
            "speakerName": "巴巴尔",
            "text": "鬼…是鬼啊！",
            "nextDialogs": [
              "140390202"
            ]
          },
          "140390202": {
            "id": "140390202",
            "speakerId": 1090,
            "speakerName": "艾梅莉埃",
            "text": "请放松一些，做个深呼吸…能告诉我们你都看到什么了吗？",
            "nextDialogs": [
              "140390203"
            ]
          },
          "140390203": {
            "id": "140390203",
            "speakerId": 4151,
            "speakerName": "巴巴尔",
            "text": "哈…哈…我看到一个黑影…从这边过去了…",
            "nextDialogs": [
              "140390204"
            ]
          },
          "140390204": {
            "id": "140390204",
            "speakerId": 4151,
            "speakerName": "巴巴尔",
            "text": "大白天的…怎么会撞见这么邪门的东西…"
          }
        }
      }
    },
    {
      "subId": "1403909",
      "subQuestName": "询问目击者",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "140390101"
        ],
        "dialogs": {
          "140390101": {
            "id": "140390101",
            "speakerId": 4142,
            "speakerName": "巴巴克",
            "text": "…散发着不妙气息的黑影？",
            "nextDialogs": [
              "140390102"
            ]
          },
          "140390102": {
            "id": "140390102",
            "speakerId": 4142,
            "speakerName": "巴巴克",
            "text": "抱歉，我刚刚在专心清点货物，没有看见…"
          }
        }
      }
    },
    {
      "subId": "1403910",
      "subQuestName": "追踪基里亚",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "140390301"
        ],
        "dialogs": {
          "140390301": {
            "id": "140390301",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "呼…再往外跑，可就出奥摩斯港了！看到的人会更少吧…",
            "nextDialogs": [
              "140390302"
            ]
          },
          "140390302": {
            "id": "140390302",
            "speakerId": 1090,
            "speakerName": "艾梅莉埃",
            "text": "没关系，我已经能隐约闻到气味了，他应该刚经过这里不久。",
            "nextDialogs": [
              "140390303"
            ]
          },
          "140390303": {
            "id": "140390303",
            "speakerId": 1090,
            "speakerName": "艾梅莉埃",
            "text": "…是在这个方向，请往这边。"
          }
        }
      }
    },
    {
      "subId": "1403911",
      "subQuestName": "追踪基里亚",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "140391101"
        ],
        "dialogs": {
          "140391101": {
            "id": "140391101",
            "speakerId": 12451,
            "speakerName": "公告板",
            "text": "即日起至「花卉展」结束，旅店及周边建筑已由策展方临时租用，暂不接待外客，敬请见谅。"
          }
        }
      }
    },
    {
      "subId": "1403912",

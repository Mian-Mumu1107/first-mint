        "startDialogs": [],
        "dialogs": {}
      }
    },
    {
      "subId": "1403913",
      "subQuestName": "与奥乌兹对话",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "140390501"
        ],
        "dialogs": {
          "140390501": {
            "id": "140390501",
            "speakerId": 4120,
            "speakerName": "伊娜姆",
            "text": "啊——奥乌兹！",
            "nextDialogs": [
              "140390502"
            ]
          },
          "140390502": {
            "id": "140390502",
            "speakerId": 4120,
            "speakerName": "伊娜姆",
            "text": "你没事吧！是…是被谁袭击了吗？",
            "nextDialogs": [
              "140390503"
            ]
          },
          "140390503": {
            "id": "140390503",
            "speakerId": 4109,
            "speakerName": "奥乌兹",
            "text": "唔…没、没有…我只是一路追着那个黑影跑进来，然后突然就感觉很难受…",
            "nextDialogs": [
              "140390504"
            ]
          },
          "140390504": {
            "id": "140390504",
            "speakerId": 1090,
            "speakerName": "艾梅莉埃",
            "text": "让我来检查一下吧。",
            "nextDialogs": [
              "140390505"
            ]
          },
          "140390505": {
            "id": "140390505",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "这里的空气确实有种很压抑的感觉呢…虽然很香，却让人喘不过气…",
            "nextDialogs": [
              "140390506"
            ]
          },
          "140390506": {
            "id": "140390506",
            "speakerId": 1051,
            "speakerName": "柯莱",
            "text": "这种感觉…我好像在哪里遇到过…",
            "nextDialogs": [
              "140390507"
            ]
          },
          "140390507": {
            "id": "140390507",
            "speakerId": 1090,
            "speakerName": "艾梅莉埃",
            "text": "看起来没有什么大碍。应该只是追得太急，加上环境影响导致的身体不适，出去休息一下应该就会好。",
            "nextDialogs": [
              "140390508"
            ]
          },
          "140390508": {
            "id": "140390508",
            "speakerId": 4109,
            "speakerName": "奥乌兹",
            "text": "不行！艾德加先生肯定还在里面…他还教过我妹妹调香…",
            "nextDialogs": [
              "140390509"
            ]
          },
          "140390509": {
            "id": "140390509",
            "speakerId": 4109,
            "speakerName": "奥乌兹",
            "text": "——这样的好人，怎么能死在基里亚手上？",
            "nextDialogs": [
              "140390510"
            ]
          },
          "140390510": {
            "id": "140390510",
            "speakerId": 4169,
            "speakerName": "夏姆",
            "text": "奥乌兹…你冷静点听我说，艾德加…就是我们要追的基里亚。",
            "nextDialogs": [
              "140390511"
            ]
          },
          "140390511": {
            "id": "140390511",
            "speakerId": 4109,
            "speakerName": "奥乌兹",
            "text": "这…这怎么可能！不是说基里亚…是个三十多岁的青年吗？",
            "nextDialogs": [
              "140390512"
            ]
          },
          "140390512": {
            "id": "140390512",
            "speakerId": 4109,
            "speakerName": "奥乌兹",
            "text": "艾德加先生现在都七十来岁了…就算是易容，也装不出那副老态吧！",
            "nextDialogs": [
              "140390513"
            ]
          },
          "140390513": {
            "id": "140390513",
            "speakerId": 1090,
            "speakerName": "艾梅莉埃",
            "text": "嗯…所以基里亚动用了非常的手段，使自己的身体老化。",
            "nextDialogs": [
              "140390514"
            ]
          },
          "140390514": {
            "id": "140390514",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "…是邪眼。",
            "nextDialogs": [
              "140390515"
            ]
          },
          "140390515": {
            "id": "140390515",
            "speakerId": 1090,
            "speakerName": "艾梅莉埃",
            "text": "基里亚用邪眼培育了奥古斯都花，同时也损耗了自己的寿命…就跟他的姐姐一样。",
            "nextDialogs": [
              "140390516"
            ]
          },
          "140390516": {
            "id": "140390516",
            "speakerId": 4109,
            "speakerName": "奥乌兹",
            "text": "不…不会的，艾德加先生在奥摩斯港住了那么久！要是有人想伪装成他，我们一定能看出破绽！",
            "nextDialogs": [
              "140390517"
            ]
          },
          "140390517": {
            "id": "140390517",
            "speakerId": 1090,
            "speakerName": "艾梅莉埃",
            "text": "但如果这个伪装，从十几年前就开始了呢？",
            "nextDialogs": [
              "140390518"
            ]
          },
          "140390518": {
            "id": "140390518",
            "speakerId": 4109,
            "speakerName": "奥乌兹",
            "text": "这…",
            "nextDialogs": [
              "140390519"
            ]
          },
          "140390519": {
            "id": "140390519",
            "speakerId": 1090,
            "speakerName": "艾梅莉埃",
            "text": "…虽然还只是推测，但我怀疑真正的调香师艾德加…在枫丹出狱后不久，就已经被基里亚谋害了。",
            "nextDialogs": [
              "140390520"
            ]
          },
          "140390520": {
            "id": "140390520",
            "speakerId": 1090,
            "speakerName": "艾梅莉埃",
            "text": "艾德加尚在狱中的那几年里，基里亚就已经做好了顶替的准备：老化的身体、调香的知识…和后续的计划。",
            "nextDialogs": [
              "140390521"
            ]
          },
          "140390521": {
            "id": "140390521",
            "speakerId": 1090,
            "speakerName": "艾梅莉埃",
            "text": "当年的「艾德加」借口要忘却旧事，远赴须弥，甚至暂停调香，转而授课…都是为了避免被故人识破。",
            "nextDialogs": [
              "140390522"
            ]
          },
          "140390522": {
            "id": "140390522",
            "speakerId": 1090,
            "speakerName": "艾梅莉埃",
            "text": "在无人熟识的须弥，只要简单地易容，蓄起胡须，戴上眼镜…就能让人相信，他就是艾德加…",
            "nextDialogs": [
              "140390523"
            ]
          },
          "140390523": {
            "id": "140390523",
            "speakerId": 1090,
            "speakerName": "艾梅莉埃",
            "text": "十多年的漫长岁月里，再一点点地卸去易容，不断地精进自己的技术…周围不会有任何人发现异常。",
            "nextDialogs": [
              "140390524"
            ]
          },
          "140390524": {
            "id": "140390524",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "所以席尔万刚见到他的时候，才说他老得都认不出来了…",
            "nextDialogs": [
              "140390525"
            ]
          },
          "140390525": {
            "id": "140390525",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "为了复仇，把自己从一个青年，变成一个垂垂老矣的老人…这真的值得吗？",
            "nextDialogs": [
              "140390526"
            ]
          },
          "140390526": {
            "id": "140390526",
            "speakerId": 4109,
            "speakerName": "奥乌兹",
            "text": "我…我得去见艾德加先生…他不可能是这种人…咳…咳！",
            "nextDialogs": [
              "140390527"
            ]
          },
          "140390527": {
            "id": "140390527",
            "speakerId": 4169,
            "speakerName": "夏姆",
            "text": "喂，你还是赶紧出去休息吧！",
            "nextDialogs": [
              "140390528"
            ]
          },
          "140390528": {
            "id": "140390528",
            "speakerId": 4109,
            "speakerName": "奥乌兹",
            "text": "可是我还撑得住…！",
            "nextDialogs": [
              "140390529"
            ]
          },
          "140390529": {
            "id": "140390529",
            "speakerId": 1051,
            "speakerName": "柯莱",
            "text": "等等…这里的环境，大概也受到了邪眼的影响。就算现在只是轻微的不适，也不能掉以轻心。",
            "nextDialogs": [
              "140390530"
            ]
          },
          "140390530": {
            "id": "140390530",
            "speakerId": 1051,
            "speakerName": "柯莱",
            "text": "奥乌兹先生，我知道怎么缓解这类症状…请先跟我一起出去休息吧。",
            "nextDialogs": [
              "140390531"
            ]
          },
          "140390531": {
            "id": "140390531",
            "speakerId": 1051,
            "speakerName": "柯莱",
            "text": "我觉得基里亚…不，是艾德加先生…一定也不希望再牵连到无辜的人了。",
            "nextDialogs": [
              "140390532"
            ]
          },
          "140390532": {
            "id": "140390532",
            "speakerId": 1090,
            "speakerName": "艾梅莉埃",
            "text": "#柯莱说得对，后面的探索交给我跟{NICKNAME}就好。从我们少量接触「奥古斯都」而无碍的反应来看…",
            "nextDialogs": [
              "140390533"
            ]
          },
          "140390533": {
            "id": "140390533",
            "speakerId": 1090,
            "speakerName": "艾梅莉埃",
            "text": "受神之眼庇佑、或是本身就善用元素力的人，对异常元素力的耐受性也会强些，在这里会相对安全一点。",
            "nextDialogs": [
              "140390534"
            ]
          },
          "140390534": {
            "id": "140390534",
            "speakerId": 1090,
            "speakerName": "艾梅莉埃",
            "text": "夏姆先生，奥乌兹先生，这处据点说不定还会有其他出入口。万一目标从那里逃离，就很难再抓住了…",
            "nextDialogs": [
              "140390535"
            ]
          },
          "140390535": {
            "id": "140390535",
            "speakerId": 1090,
            "speakerName": "艾梅莉埃",
            "text": "…所以，能请你们在外面搜寻一下吗？",
            "nextDialogs": [
              "140390536"
            ]
          },
          "140390536": {
            "id": "140390536",
            "speakerId": 4109,
            "speakerName": "奥乌兹",
            "text": "我…",
            "nextDialogs": [
              "140390537"
            ]
          },
          "140390537": {
            "id": "140390537",
            "speakerId": 4169,
            "speakerName": "夏姆",
            "text": "呵…谢了。",
            "nextDialogs": [
              "140390538"
            ]
          },
          "140390538": {
            "id": "140390538",
            "speakerId": 4169,
            "speakerName": "夏姆",
            "text": "——喂，没听见吗？快跟我出去，我们还有的是事情要做！回奥摩斯港再多叫点人！",
            "nextDialogs": [
              "140390539"
            ]
          },
          "140390539": {
            "id": "140390539",
            "speakerId": 4109,
            "speakerName": "奥乌兹",
            "text": "我明白了…",
            "nextDialogs": [
              "140390540"
            ]
          },
          "140390540": {
            "id": "140390540",
            "speakerId": 1051,
            "speakerName": "柯莱",
            "text": "#{NICKNAME}、艾梅莉埃，还有派蒙，你们千万要小心。",
            "nextDialogs": [
              "140390541"
            ]
          },
          "140390541": {
            "id": "140390541",
            "speakerId": 1051,
            "speakerName": "柯莱",
            "text": "只为复仇而活的人…在这条路的最后，会做出什么事情…我不敢想象。",
            "nextDialogs": [
              "140390542"
            ]
          },
          "140390542": {
            "id": "140390542",
            "speakerId": 1090,
            "speakerName": "艾梅莉埃",
            "text": "放心吧，不管是我们，还是基里亚，都不应该在这里结束。",
            "nextDialogs": [
              "140390543"
            ]
          },
          "140390543": {
            "id": "140390543",
            "speakerId": 1090,
            "speakerName": "艾梅莉埃",
            "text": "…「奥古斯都」带来的死亡，是时候跟它的神话一起终结了。"
          }
        }
      }
    },
    {
      "subId": "1403914",
      "subQuestName": "继续深入",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [],
        "dialogs": {}
      }
    },
    {
      "subId": "1403915",
      "subQuestName": "继续深入",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "140390601"
        ],
        "dialogs": {
          "140390601": {
            "id": "140390601",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "哇…这些就是…奥古斯都花？",
            "nextDialogs": [
              "140390602"
            ]
          },
          "140390602": {
            "id": "140390602",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "居然有那么多…这得花多少时间啊？还都是一个人干的…",
            "nextDialogs": [
              "140390603"
            ]
          },
          "140390603": {
            "id": "140390603",
            "speakerId": 1090,
            "speakerName": "艾梅莉埃",
            "text": "比起开辟园圃的时间，使用邪眼需要付出的寿命，只怕还要更多…",
            "nextDialogs": [
              "140390604"
            ]
          },
          "140390604": {
            "id": "140390604",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "不过基里亚，真的需要这么多奥古斯都花吗？",
            "nextDialogs": [
              "140390605"
            ]
          },
          "140390605": {
            "id": "140390605",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "想完成他的计划，只要能制作出几瓶「奥古斯都」就够了吧？",
            "nextDialogs": [
              "140390606"
            ]
          },
          "140390606": {
            "id": "140390606",
            "speakerId": 1090,
            "speakerName": "艾梅莉埃",
            "text": "…也许除了仇恨以外，他还寄托了别的情感在「奥古斯都」上。",
            "nextDialogs": [
              "140390607"
            ]
          },
          "140390607": {
            "id": "140390607",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "…别的情感？",
            "nextDialogs": [
              "140390608"
            ]
          },
          "140390608": {
            "id": "140390608",
            "speakerId": 1090,
            "speakerName": "艾梅莉埃",
            "text": "不久前他跟我说过，不希望旅馆里的花，就这样凋零在异国的土地上。",
            "nextDialogs": [
              "140390609"
            ]
          },
          "140390609": {
            "id": "140390609",
            "speakerId": 1090,
            "speakerName": "艾梅莉埃",
            "text": "但对叛离了至冬，告别了枫丹，终生戴着假面生活在须弥的基里亚来说…到底哪里才算他的故乡呢？",
            "nextDialogs": [
              "140390610"
            ]
          },
          "140390610": {
            "id": "140390610",
            "speakerId": 1090,
            "speakerName": "艾梅莉埃",
            "text": "大概在他心里，跟姐姐一样，死在开满奥古斯都花的园圃里…才是最好的归宿吧。"
          }
        }
      }
    },

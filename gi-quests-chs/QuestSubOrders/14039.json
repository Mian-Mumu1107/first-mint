    },
    {
      "subId": "1403910",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "140391001"
        ],
        "dialogs": {
          "140391001": {
            "id": "140391001",
            "speakerId": 4151,
            "speakerName": "巴巴尔",
            "text": "大白天的…怎么会撞见这么邪门的东西…"
          }
        }
      }
    },
    {
      "subId": "1403999",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "140399901"
        ],
        "dialogs": {
          "140399901": {
            "id": "140399901",
            "speakerId": 4120,
            "speakerName": "伊娜姆",
            "text": "那道黑影当时往升降梯的方向跑了，我的同伴心里着急，立刻就追了过去…",
            "nextDialogs": [
              "140399902"
            ]
          },
          "140399902": {
            "id": "140399902",
            "speakerId": 1090,
            "speakerName": "艾梅莉埃",
            "text": "…希望还没发生正面冲突，我们快跟上去吧。",
            "nextDialogs": [
              "140399903"
            ]
          },
          "140399903": {
            "id": "140399903",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "他到底是往哪边跑了…唔，问一问附近的商户吧！",
            "nextDialogs": [
              "140399904"
            ]
          },
          "140399904": {
            "id": "140399904",
            "speakerId": 1090,
            "speakerName": "艾梅莉埃",
            "text": "气息越来越浓烈了，就是这里。",
            "nextDialogs": [
              "140399905"
            ]
          },
          "140399905": {
            "id": "140399905",
            "speakerId": 1012,
            "speakerName": "Black Screen",
            "text": "「奥古斯都」引起的风波就此告一段落…\\n几周后，你接到了艾梅莉埃的书信，邀你在枫丹一叙…",
            "nextDialogs": [
              "140399906"
            ]
          },
          "140399906": {
            "id": "140399906",
            "speakerId": 14258,
            "speakerName": "议论纷纷的群众",
            "text": "好可怕…",
            "nextDialogs": [
              "140399907"
            ]
          },
          "140399907": {
            "id": "140399907",
            "speakerId": 14258,
            "speakerName": "议论纷纷的群众",
            "text": "别…别过来！"
          }
        }
      }
    }
  ]
}
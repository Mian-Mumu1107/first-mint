    {
      "subId": "7268403",
      "subQuestName": "与天领奉行同心木村交谈",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "726840301"
        ],
        "dialogs": {
          "726840301": {
            "id": "726840301",
            "speakerId": 1000,
            "speakerName": "木村",
            "text": "有什么需要帮忙的吗？",
            "nextDialogs": [
              "726840302"
            ]
          },
          "726840302": {
            "id": "726840302",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "关于即将举办的祭典。",
            "nextDialogs": [
              "726840303"
            ]
          },
          "726840303": {
            "id": "726840303",
            "speakerId": 1000,
            "speakerName": "木村",
            "text": "什么？祭典？最近没听说要举办祭典。",
            "nextDialogs": [
              "726840304"
            ]
          },
          "726840304": {
            "id": "726840304",
            "speakerId": 1000,
            "speakerName": "木村",
            "text": "二位能说得更详细一些吗？比如名字之类的。",
            "nextDialogs": [
              "726840305"
            ]
          },
          "726840305": {
            "id": "726840305",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "名字是荒泷极上…",
            "nextDialogs": [
              "726840306"
            ]
          },
          "726840306": {
            "id": "726840306",
            "speakerId": 1000,
            "speakerName": "木村",
            "text": "荒泷极上？",
            "nextDialogs": [
              "726840309"
            ]
          },
          "726840309": {
            "id": "726840309",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "是荒泷派举办的荒泷极上盛世豪鼓大祭典！",
            "nextDialogs": [
              "726840310"
            ]
          },
          "726840310": {
            "id": "726840310",
            "speakerId": 1000,
            "speakerName": "木村",
            "text": "啊！是上次在容彩祭上捣乱的那个荒泷派吧？",
            "nextDialogs": [
              "726840311"
            ]
          },
          "726840311": {
            "id": "726840311",
            "speakerId": 1000,
            "speakerName": "木村",
            "text": "原来你们说的是那个三无活动…",
            "nextDialogs": [
              "726840312"
            ]
          },
          "726840312": {
            "id": "726840312",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "三无活动？不是不是，你搞错啦。是荒泷极上盛世豪鼓大祭典！",
            "nextDialogs": [
              "726840313"
            ]
          },
          "726840313": {
            "id": "726840313",
            "speakerId": 1000,
            "speakerName": "木村",
            "text": "好了，不用强调这个名字，我大概知道了，总之我来告诉你们吧。",
            "nextDialogs": [
              "726840314"
            ]
          },
          "726840314": {
            "id": "726840314",
            "speakerId": 1000,
            "speakerName": "木村",
            "text": "前几天我确实在这里看到了荒泷派的成员，他们在四处堆放一些毫无美感的东西。",
            "nextDialogs": [
              "726840315"
            ]
          },
          "726840315": {
            "id": "726840315",
            "speakerId": 1000,
            "speakerName": "木村",
            "text": "那个为首的家伙，还声称要在这里办一场超过容彩祭的大型祭典，应该就是你们说的那个。",
            "nextDialogs": [
              "726840316"
            ]
          },
          "726840316": {
            "id": "726840316",
            "speakerId": 1000,
            "speakerName": "木村",
            "text": "结果稍微查问了两句，发现他们既没有活动举办许可，也没有场地租用凭证，更不用说事先应该去奉行所准备好的报批记录了。",
            "nextDialogs": [
              "726840317"
            ]
          },
          "726840317": {
            "id": "726840317",
            "speakerId": 1000,
            "speakerName": "木村",
            "text": "这明显是板上钉钉的三无活动。按照规定，我们只好强制他们停止。",
            "nextDialogs": [
              "726840318"
            ]
          },
          "726840318": {
            "id": "726840318",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "欸？强制停止！难道他们已经被抓起来了？",
            "nextDialogs": [
              "726840319"
            ]
          },
          "726840319": {
            "id": "726840319",
            "speakerId": 1000,
            "speakerName": "木村",
            "text": "那倒没有，看在他们是没有经验，而且好歹准备了安全预案的份上。我们也只是对他们进行了简单的教育。",
            "nextDialogs": [
              "726840320"
            ]
          },
          "726840320": {
            "id": "726840320",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "安全预案，这帮家伙还是挺有安全意识的嘛...",
            "nextDialogs": [
              "726840321"
            ]
          },
          "726840321": {
            "id": "726840321",
            "speakerId": 1000,
            "speakerName": "木村",
            "text": "如果你们在找荒泷派，也许可以去甘金岛看看。",
            "nextDialogs": [
              "726840322"
            ]
          },
          "726840322": {
            "id": "726840322",
            "speakerId": 1000,
            "speakerName": "木村",
            "text": "甘金岛是社奉行给各种大小祭典常备的场地，初衷是为了培育各种来自民间的文化活动，手续和费用都是从简。",
            "nextDialogs": [
              "726840323"
            ]
          },
          "726840323": {
            "id": "726840323",
            "speakerId": 1000,
            "speakerName": "木村",
            "text": "我们把这个告知了荒泷派的那几位。",
            "nextDialogs": [
              "726840324"
            ]
          },
          "726840324": {
            "id": "726840324",
            "speakerId": 1000,
            "speakerName": "木村",
            "text": "如果他们仍然想要举办活动的话，那里是最合适的选择。",
            "nextDialogs": [
              "726840325"
            ]
          },
          "726840325": {
            "id": "726840325",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "#唔...{NICKNAME}，虽然已经感觉不太靠谱的样子…",
            "nextDialogs": [
              "726840326"
            ]
          },
          "726840326": {
            "id": "726840326",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "但是，来都来了...所以我们还是去甘金岛找找吧？"
          }
        }
      }
    },
    {
      "subId": "7268404",
      "subQuestName": "前往甘金岛寻找荒泷派",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "726840401"
        ],
        "dialogs": {
          "726840401": {
            "id": "726840401",
            "speakerId": 1000,
            "speakerName": "木村",
            "text": "两位还有什么问题吗？",
            "nextDialogs": [
              "726840402"
            ]
          },
          "726840402": {
            "id": "726840402",
            "speakerId": 1000,
            "speakerName": "木村",
            "text": "如果想要找荒泷派，也许可以去甘金岛看看。"
          }
        }
      }
    },
    {
      "subId": "7268405",
      "subQuestName": "与社奉行代行博彦交谈",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "726840501"
        ],
        "dialogs": {
          "726840501": {
            "id": "726840501",
            "speakerId": 1002,
            "speakerName": "博彦",
            "text": "二位有什么需要？",
            "nextDialogs": [
              "726840502"
            ]
          },
          "726840502": {
            "id": "726840502",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "我们来找荒泷派。",
            "nextDialogs": [
              "726840503"
            ]
          },
          "726840503": {
            "id": "726840503",
            "speakerId": 1002,
            "speakerName": "博彦",
            "text": "噢噢噢，我知道了，你们也是来参加那个荒泷极上什么什么大祭典的吧？",
            "nextDialogs": [
              "726840504"
            ]
          },
          "726840504": {
            "id": "726840504",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "也是？",
            "nextDialogs": [
              "726840505"
            ]
          },
          "726840505": {
            "id": "726840505",
            "speakerId": 1002,
            "speakerName": "博彦",
            "text": "嗯嗯，不久前，天领奉行的九条裟罗大人，还有长野原烟花店的宵宫小姐都来过。",
            "nextDialogs": [
              "726840506"
            ]
          },
          "726840506": {
            "id": "726840506",
            "speakerId": 1002,
            "speakerName": "博彦",
            "text": "宵宫小姐是过来送烟花时，碰巧看见那伙人在张罗场地，可能是感兴趣吧，所以过去看了看。",
            "nextDialogs": [
              "726840507"
            ]
          },
          "726840507": {
            "id": "726840507",
            "speakerId": 1002,
            "speakerName": "博彦",
            "text": "至于九条裟罗大人为什么过来，就不太清楚了。",
            "nextDialogs": [
              "726840508"
            ]
          },
          "726840508": {
            "id": "726840508",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "#{NICKNAME}，居然有人比我们先到了呢！嘿嘿嘿。",
            "nextDialogs": [
              "726840509"
            ]
          },
          "726840509": {
            "id": "726840509",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "所以荒泷派他们现在在哪里呀？",
            "nextDialogs": [
              "726840510"
            ]
          },
          "726840510": {
            "id": "726840510",
            "speakerId": 1002,
            "speakerName": "博彦",
            "text": "说来惭愧，因为最近岛上已经没有额外的空余场地了。",
            "nextDialogs": [
              "726840511"
            ]
          },
          "726840511": {
            "id": "726840511",
            "speakerId": 1002,
            "speakerName": "博彦",
            "text": "我们只好把他们安排在了西北边的小滩涂上。",
            "nextDialogs": [
              "726840512"
            ]
          },
          "726840512": {
            "id": "726840512",
            "speakerId": 1002,
            "speakerName": "博彦",
            "text": "如果他们能再早些申请，我可以为他们准备更好一些的位置。",
            "nextDialogs": [
              "726840513"
            ]
          },
          "726840513": {
            "id": "726840513",
            "speakerId": 1002,
            "speakerName": "博彦",
            "text": "你们往西北边走一走应该就能看见。"
          }
        }
      }
    },
    {
      "subId": "7268406",
      "subQuestName": "前往甘金岛西北边的滩涂",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "726840632"
        ],
        "dialogs": {
          "726840632": {
            "id": "726840632",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "祭典都有哪些内容？",
            "nextDialogs": [
              "726840633"
            ]
          },
          "726840633": {
            "id": "726840633",
            "speakerId": 1003,
            "speakerName": "荒泷一斗",
            "text": "哈哈哈哈！内容丰富的很！",
            "nextDialogs": [
              "726840634"
            ]
          },
          "726840634": {
            "id": "726840634",
            "speakerId": 1003,
            "speakerName": "荒泷一斗",
            "text": "看见那边的小山坡了吗？那是豪歌岭，你们可以站在上面，面对大海，自由歌唱。",
            "nextDialogs": [
              "726840635"
            ]
          },
          "726840635": {
            "id": "726840635",
            "speakerId": 1003,
            "speakerName": "荒泷一斗",
            "text": "还有这团篝火，用来烤堇瓜绰绰有余。",
            "nextDialogs": [
              "726840636"
            ]
          },
          "726840636": {
            "id": "726840636",
            "speakerId": 1003,
            "speakerName": "荒泷一斗",
            "text": "还有这堆箱子，不管是玩《七圣召唤》还是斗虫都不会感到拥挤。",
            "nextDialogs": [
              "726840637"
            ]
          },
          "726840637": {
            "id": "726840637",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "听起来还真是「丰富」呢。",
            "nextDialogs": [
              "726840638"
            ]
          },
          "726840638": {
            "id": "726840638",
            "speakerId": 1003,
            "speakerName": "荒泷一斗",
            "text": "当然，祭典的重头戏还是这个豪鼓祭演啦。来，你们看。",
            "nextDialogs": [
              "726840639"
            ]
          },
          "726840639": {
            "id": "726840639",
            "speakerId": 1003,
            "speakerName": "荒泷一斗",
            "text": "偷偷告诉你们，这可是我从秘密渠道搞来的好东西，说是一位大阴阳师留下的宝具小鼓，本来要价800万摩拉！",
            "nextDialogs": [
              "726840640"
            ]
          },
          "726840640": {
            "id": "726840640",
            "speakerId": 1003,
            "speakerName": "荒泷一斗",
            "text": "卖家说看我面目俊朗，与她有缘，于是给我打了个折，只要80万摩拉就卖给我了。",
            "nextDialogs": [
              "726840641"
            ]
          },
          "726840641": {
            "id": "726840641",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "800万摩拉变成80万摩拉，怎么听也像是骗人的吧？",
            "nextDialogs": [
              "726840642"
            ]
          },
          "726840642": {
            "id": "726840642",
            "speakerId": 1003,
            "speakerName": "荒泷一斗",
            "text": "当然！我怎么可能被这种低劣的手法骗到。",
            "nextDialogs": [
              "726840643"
            ]
          },
          "726840643": {
            "id": "726840643",
            "speakerId": 1003,
            "speakerName": "荒泷一斗",
            "text": "我一眼就看出了这个小鼓的边缘有些破损，这是瑕疵品！还说什么与我有缘，可笑！",
            "nextDialogs": [
              "726840644"
            ]
          },
          "726840644": {
            "id": "726840644",
            "speakerId": 1003,
            "speakerName": "荒泷一斗",
            "text": "于是本大爷又砍了她一刀，最后只要8万摩拉成交。哈哈哈哈哈！捡到大便宜了！",
            "nextDialogs": [
              "726840645"
            ]
          },
          "726840645": {
            "id": "726840645",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "总觉得是人家捡到大便宜了…",
            "nextDialogs": [
              "726840646"
            ]
          },
          "726840646": {
            "id": "726840646",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "话说回来，放牛的居然出得起8万摩拉，让人有点刮目相看啊。",
            "nextDialogs": [
              "726840647"
            ]
          },
          "726840647": {
            "id": "726840647",
            "speakerId": 1003,
            "speakerName": "荒泷一斗",
            "text": "不过是8万摩拉而已，不要随便看轻本大爷啊！",
            "nextDialogs": [
              "726840648"
            ]
          },
          "726840648": {
            "id": "726840648",
            "speakerId": 1004,
            "speakerName": "元太",
            "text": "我出了其中的2万...",
            "nextDialogs": [
              "726840649"
            ]
          },
          "726840649": {
            "id": "726840649",
            "speakerId": 1005,
            "speakerName": "阿守",
            "text": "我也…",
            "nextDialogs": [
              "726840650"
            ]
          },
          "726840650": {
            "id": "726840650",
            "speakerId": 1006,
            "speakerName": "阿晃",
            "text": "啊？老大，为什么我出的是3万？",
            "nextDialogs": [
              "726840651"
            ]
          },
          "726840651": {
            "id": "726840651",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "2万加2万加3万等于…",
            "nextDialogs": [
              "726840652"
            ]
          },
          "726840652": {
            "id": "726840652",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "好你个放牛的，居然自己不出一分钱，就从小弟那里搜刮了8万摩拉出来...",
            "nextDialogs": [
              "726840653"
            ]
          },
          "726840653": {
            "id": "726840653",
            "speakerId": 1003,
            "speakerName": "荒泷一斗",
            "text": "咳咳，你是怎么算的，我我我也是出了最后1万摩拉的啊！",
            "nextDialogs": [
              "726840665"
            ]
          },
          "726840665": {
            "id": "726840665",
            "speakerId": 1003,
            "speakerName": "荒泷一斗",
            "text": "好了，多的就不说了，看看时间，我也得回阿忍那里了。",
            "nextDialogs": [
              "726840666"
            ]
          },
          "726840666": {
            "id": "726840666",
            "speakerId": 1003,
            "speakerName": "荒泷一斗",
            "text": "祭典才刚刚开始，我们还得再努力拉一些人过来才热闹！",
            "nextDialogs": [
              "726840667"
            ]
          },
          "726840667": {
            "id": "726840667",
            "speakerId": 1003,
            "speakerName": "荒泷一斗",
            "text": "收好这个小鼓，如果准备好要开始豪鼓祭演，找元太就行。",
            "nextDialogs": [
              "726840668"
            ]
          },
          "726840668": {
            "id": "726840668",
            "speakerId": 1003,
            "speakerName": "荒泷一斗",
            "text": "回见了！我的挚友！"
          }
        }
      }
    },
    {
      "subId": "7268407",
      "subQuestName": "在元太那里开始豪鼓祭演",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "726840701"
        ],
        "dialogs": {
          "726840701": {
            "id": "726840701",
            "speakerId": 1004,
            "speakerName": "元太",
            "text": "我是荒泷豪鼓祭接引大使元太，准备好开始豪鼓祭演了吗？",
            "nextDialogs": [
              "726840702"
            ]
          },
          "726840702": {
            "id": "726840702",
            "speakerId": 1004,
            "speakerName": "元太",
            "text": "哦对了，关于这个小鼓，之前老大有一点忘记交代了。",
            "nextDialogs": [
              "726840703"
            ]
          },
          "726840703": {
            "id": "726840703",
            "speakerId": 1004,
            "speakerName": "元太",
            "text": "因为大家也不太懂乐器，所以您在开始之前，可以先调试一番。",
            "nextDialogs": [
              "726840704"
            ]
          },
          "726840704": {
            "id": "726840704",
            "speakerId": 1004,
            "speakerName": "元太",
            "text": "这样可以让最后的音色更加准确动听。",
            "nextDialogs": [
              "726840705"
            ]
          },
          "726840705": {
            "id": "726840705",
            "speakerId": 1004,
            "speakerName": "元太",
            "text": "来，请您试试吧。"
          }
        }
      }
    },
    {
      "subId": "7268406",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "726840601"
        ],
        "dialogs": {
          "726840601": {
            "id": "726840601",
            "speakerId": 1003,
            "speakerName": "荒泷一斗",
            "text": "哈哈哈哈哈哈哈！我的挚友啊！你终于到了！",
            "nextDialogs": [
              "726840602"
            ]
          },
          "726840602": {
            "id": "726840602",
            "speakerId": 1003,
            "speakerName": "荒泷一斗",
            "text": "刚刚还在想，什么时候才能见到你，果然你就到了，真是让本大爷高兴啊。",
            "nextDialogs": [
              "726840603"
            ]
          },
          "726840603": {
            "id": "726840603",
            "speakerId": 1003,
            "speakerName": "荒泷一斗",
            "text": "看看本大爷这场子，怎么样？是不是上佳的选择？",
            "nextDialogs": [
              "726840604"
            ]
          },
          "726840604": {
            "id": "726840604",
            "speakerId": 1005,
            "speakerName": "阿守",
            "text": "三面环海，空气清新，远离城市喧嚣，坐拥绝版景观资源。",
            "nextDialogs": [
              "726840605"
            ]
          },
          "726840605": {
            "id": "726840605",
            "speakerId": 1006,
            "speakerName": "阿晃",
            "text": "背靠甘金岛，独享祭典文化中心的顶级配套。",
            "nextDialogs": [
              "726840606"
            ]
          },
          "726840606": {
            "id": "726840606",
            "speakerId": 1004,
            "speakerName": "元太",
            "text": "水陆交通发达，无论是步行或是坐船都能便捷抵达。",
            "nextDialogs": [
              "726840609"
            ]
          },
          "726840609": {
            "id": "726840609",
            "speakerId": 1003,
            "speakerName": "荒泷一斗",
            "text": "当初看到这个场子的瞬间，本大爷就决定，就是它了！",
            "nextDialogs": [
              "726840610"
            ]
          },
          "726840610": {
            "id": "726840610",
            "speakerId": 1003,
            "speakerName": "荒泷一斗",
            "text": "那一刻，世界大有不同。",
            "nextDialogs": [
              "726840611"
            ]
          },
          "726840611": {
            "id": "726840611",
            "speakerId": 1007,
            "speakerName": "荒泷派成员",
            "text": "老大英明！！！",
            "nextDialogs": [
              "726840612"
            ]
          },
          "726840612": {
            "id": "726840612",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "明明是被天领奉行的人赶过来的吧。",
            "nextDialogs": [
              "726840613"
            ]
          },
          "726840613": {
            "id": "726840613",
            "speakerId": 1003,
            "speakerName": "荒泷一斗",
            "text": "咳咳…我们还是先说正事吧。",
            "nextDialogs": [
              "726840614"
            ]
          },
          "726840614": {
            "id": "726840614",
            "speakerId": 1003,
            "speakerName": "荒泷一斗",
            "text": "这次请你们过来，是想请你们参加我荒泷极上盛世豪鼓大祭典！这个祭典意义重大。",
            "nextDialogs": [
              "726840615"
            ]
          },
          "726840615": {
            "id": "726840615",
            "speakerId": 1004,
            "speakerName": "元太",
            "text": "老大说，一来是为了宣传我荒泷派的名头，方便未来招新。",
            "nextDialogs": [
              "726840616"
            ]
          },
          "726840616": {
            "id": "726840616",
            "speakerId": 1005,
            "speakerName": "阿守",
            "text": "二来是为了忍姐毕业庆功！",
            "nextDialogs": [
              "726840617"
            ]
          },
          "726840617": {
            "id": "726840617",
            "speakerId": 1006,
            "speakerName": "阿晃",
            "text": "最后还能补上前几次因为欠缺经费而延期的团建。",
            "nextDialogs": [
              "726840618"
            ]
          },
          "726840618": {
            "id": "726840618",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "还真是一典多用呢。",
            "nextDialogs": [
              "726840619"
            ]
          },
          "726840619": {
            "id": "726840619",
            "speakerId": 1003,
            "speakerName": "荒泷一斗",
            "text": "阿晃...最后一条不必再提。",
            "nextDialogs": [
              "726840620"
            ]
          },
          "726840620": {
            "id": "726840620",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "怎么没有看见阿忍？",
            "nextDialogs": [
              "726840621"
            ]
          },
          "726840621": {
            "id": "726840621",
            "speakerId": 1003,
            "speakerName": "荒泷一斗",
            "text": "祭典这种事，多多宣传才有更多的人来参加，所以阿忍去发传单了。",
            "nextDialogs": [
              "726840622"
            ]
          },
          "726840622": {
            "id": "726840622",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "喂！明明阿忍是主角吧？",
            "nextDialogs": [
              "726840623"
            ]
          },
          "726840623": {
            "id": "726840623",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "居然她在外面干活，你们在这里游手好闲。",
            "nextDialogs": [
              "726840624"
            ]
          },
          "726840624": {
            "id": "726840624",
            "speakerId": 1003,
            "speakerName": "荒泷一斗",
            "text": "本大爷也有在认真…认真在这里接待你们啊！",
            "nextDialogs": [
              "726840625"
            ]
          },
          "726840625": {
            "id": "726840625",
            "speakerId": 1004,
            "speakerName": "元太",
            "text": "老大其实是刚刚回来啦。",
            "nextDialogs": [
              "726840626"
            ]
          },
          "726840626": {
            "id": "726840626",
            "speakerId": 1005,
            "speakerName": "阿守",
            "text": "说是估算着你们可能要到了，才特地回来迎接的。",
            "nextDialogs": [
              "726840627"
            ]
          },
          "726840627": {
            "id": "726840627",
            "speakerId": 1006,
            "speakerName": "阿晃",
            "text": "本来他和忍姐一起，也在外面努力拉人参加祭典呢。",
            "nextDialogs": [
              "726840628"
            ]
          },
          "726840628": {
            "id": "726840628",
            "speakerId": 1003,
            "speakerName": "荒泷一斗",
            "text": "不用夸我，不用夸我。",
            "nextDialogs": [
              "726840629"
            ]
          },
          "726840629": {
            "id": "726840629",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "哟，放牛的居然也在认真做事了。难得的靠谱了起来。",
            "nextDialogs": [
              "726840630"
            ]
          },
          "726840630": {
            "id": "726840630",
            "speakerId": 1003,
            "speakerName": "荒泷一斗",
            "text": "哼，不跟你这飞行矮堇瓜一般见识！",
            "nextDialogs": [
              "726840631"
            ]
          },
          "726840631": {
            "id": "726840631",
            "speakerId": 1003,
            "speakerName": "荒泷一斗",
            "text": "话说回来，我的挚友啊，关于这次祭典，你还有什么疑问吗？"
          },
          "726840654": {
            "id": "726840654",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "听说九条裟罗也来了？",
            "nextDialogs": [
              "726840655"
            ]
          },
          "726840655": {
            "id": "726840655",
            "speakerId": 1003,
            "speakerName": "荒泷一斗",
            "text": "哦，你说那个臭天狗啊。",
            "nextDialogs": [
              "726840656"
            ]
          },
          "726840656": {
            "id": "726840656",
            "speakerId": 1003,
            "speakerName": "荒泷一斗",
            "text": "我也勉强给她送了一封邀请函啦。",
            "nextDialogs": [
              "726840657"
            ]
          },
          "726840657": {
            "id": "726840657",
            "speakerId": 1003,
            "speakerName": "荒泷一斗",
            "text": "不过这家伙居然不领情，还特地过来竖了一块告示板，留下了一些扯淡的话，美其名曰是对游客的警示。",
            "nextDialogs": [
              "726840658"
            ]
          },
          "726840658": {
            "id": "726840658",
            "speakerId": 1003,
            "speakerName": "荒泷一斗",
            "text": "还警告我们不许涂改，这样针对我荒泷派，实在可恶…",
            "nextDialogs": [
              "726840659"
            ]
          },
          "726840659": {
            "id": "726840659",
            "speakerId": 1003,
            "speakerName": "荒泷一斗",
            "text": "总有一天我要在大街上堂堂正正地击败这个臭天狗！好好惩罚她一下！",
            "nextDialogs": [
              "726840660"
            ]
          },
          "726840660": {
            "id": "726840660",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "听说宵宫也来了？",
            "nextDialogs": [
              "726840661"
            ]
          },
          "726840661": {
            "id": "726840661",
            "speakerId": 1003,
            "speakerName": "荒泷一斗",
            "text": "那位长野原烟花店的老板吗？",
            "nextDialogs": [
              "726840662"
            ]
          },
          "726840662": {
            "id": "726840662",
            "speakerId": 1003,
            "speakerName": "荒泷一斗",
            "text": "真是一位热情健谈的女士啊，她是来甘金岛送货的路上，巧合才知道我们的祭典。",
            "nextDialogs": [
              "726840663"
            ]
          },
          "726840663": {
            "id": "726840663",
            "speakerId": 1003,
            "speakerName": "荒泷一斗",
            "text": "她很喜欢我们的祭典，过来祝福了一番，还说下次会提前给我们准备烟花呢。",
            "nextDialogs": [
              "726840664"
            ]
          },
          "726840664": {
            "id": "726840664",
            "speakerId": 1003,
            "speakerName": "荒泷一斗",
            "text": "看来以后我荒泷派，应该也要和长野原烟花店多多走动。"
          }
        }
      }
    },
    {
      "subId": "7268471",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "726847101"
        ],
        "dialogs": {
          "726847101": {
            "id": "726847101",
            "speakerId": 1006,
            "speakerName": "阿晃",
            "text": "我是荒泷豪鼓祭反馈大使阿晃，您有什么要反馈的吗？",
            "nextDialogs": [
              "726847105"
            ]
          },
          "726847105": {
            "id": "726847105",
            "speakerId": 1006,
            "speakerName": "阿晃",
            "text": "好的，您的反馈我收到了。",
            "nextDialogs": [
              "726847106"
            ]
          },
          "726847106": {
            "id": "726847106",
            "speakerId": 1006,
            "speakerName": "阿晃",
            "text": "欸？您问别的？我没有别的话要说了。",
            "nextDialogs": [
              "726847107"
            ]
          },
          "726847107": {
            "id": "726847107",
            "speakerId": 1006,
            "speakerName": "阿晃",
            "text": "啊…老大的意思是，我的工作只要说，「您有什么要反馈的吗？」，「您的反馈我们收到了」这两句话就可以了。",
            "nextDialogs": [
              "726847108"
            ]
          },
          "726847108": {
            "id": "726847108",
            "speakerId": 1006,
            "speakerName": "阿晃",
            "text": "如果客人还要追问什么时候反馈才有消息，那就再加一句，「请您耐心等待」。",
            "nextDialogs": [
              "726847109"
            ]
          },
          "726847109": {
            "id": "726847109",
            "speakerId": 1006,
            "speakerName": "阿晃",
            "text": "他说他在其他地方参加的活动都是这样的，想必是借鉴了一下优秀的经验吧？",
            "nextDialogs": [
              "726847110"
            ]
          },
          "726847110": {
            "id": "726847110",
            "speakerId": 1006,
            "speakerName": "阿晃",
            "text": "不过后来忍姐说这样实在太敷衍了啦，所以又给我准备了一个小本子。",
            "nextDialogs": [
              "726847111"
            ]
          },
          "726847111": {
            "id": "726847111",
            "speakerId": 1006,
            "speakerName": "阿晃",
            "text": "瞧，您的意见我已经记下来了，等忍姐回来了再给她看看。"
          }
        }
      }
    },
    {
      "subId": "7268472",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "726847201"
        ],
        "dialogs": {
          "726847201": {
            "id": "726847201",
            "speakerId": 1005,
            "speakerName": "阿守",
            "text": "我是荒泷豪鼓祭氛围大使阿守，您有什么需要吗？",
            "nextDialogs": [
              "726847202"
            ]
          },
          "726847202": {
            "id": "726847202",
            "speakerId": 1005,
            "speakerName": "阿守",
            "text": "您问我的工作？",
            "nextDialogs": [
              "726847203"
            ]
          },
          "726847203": {
            "id": "726847203",
            "speakerId": 1005,
            "speakerName": "阿守",
            "text": "啊，氛围大使嘛，主要就是营造火热的氛围，让参加祭典的人们产生「我快要嗨到不行了」的感觉。",
            "nextDialogs": [
              "726847204"
            ]
          },
          "726847204": {
            "id": "726847204",
            "speakerId": 1005,
            "speakerName": "阿守",
            "text": "您有那种感觉吗？",
            "nextDialogs": [
              "726847207"
            ]
          },
          "726847207": {
            "id": "726847207",
            "speakerId": 1005,
            "speakerName": "阿守",
            "text": "请…请不要说这种话啊！",
            "nextDialogs": [
              "726847208"
            ]
          },
          "726847208": {
            "id": "726847208",
            "speakerId": 1005,
            "speakerName": "阿守",
            "text": "不要这样冷漠地打击我的积极性啊！这样我的工作不就失去了意义吗？",
            "nextDialogs": [
              "726847209"
            ]
          },
          "726847209": {
            "id": "726847209",
            "speakerId": 1005,
            "speakerName": "阿守",
            "text": "您是老大的挚友，请代替老大给我一些支持吧。拜托了，对我说那句话吧！",
            "nextDialogs": [
              "726847210"
            ]
          },
          "726847210": {
            "id": "726847210",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "哪句话？",
            "nextDialogs": [
              "726847211"
            ]
          },
          "726847211": {
            "id": "726847211",
            "speakerId": 1005,
            "speakerName": "阿守",
            "text": "「我快要嗨到不行了」那句话。"
          }
        }
      }
    },
    {
      "subId": "7268499",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "726849906"
        ],
        "dialogs": {
          "726849906": {
            "id": "726849906",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "还是和刚刚一样，没有看见荒泷派的人呢。",
            "nextDialogs": [
              "726849907"
            ]
          },
          "726849907": {
            "id": "726849907",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "这里应该有社奉行的代行在管理，我们去问问他吧。"
          }
        }
      }
    }
  ]
}
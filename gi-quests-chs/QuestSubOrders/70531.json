  },
  "subQuests": [
    {
      "subId": "7053101",
      "subQuestName": "与奥妮对话",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "705310101"
        ],
        "dialogs": {
          "705310101": {
            "id": "705310101",
            "speakerId": 1000,
            "speakerName": "奥妮",
            "text": "前辈，请稍等一下！您也是来参加「召唤王大奖赛」的吗？",
            "nextDialogs": [
              "705310102"
            ]
          },
          "705310102": {
            "id": "705310102",
            "speakerId": 1000,
            "speakerName": "奥妮",
            "text": "如果您有空的话，我想向您介绍一下我们冒险家协会正在举办的「诸景巡礼」。",
            "nextDialogs": [
              "705310105"
            ]
          },
          "705310105": {
            "id": "705310105",
            "speakerId": 1000,
            "speakerName": "奥妮",
            "text": "谢谢前辈！我就简单为您介绍一下本次协会所举办的「诸景巡礼」。",
            "nextDialogs": [
              "705310106"
            ]
          },
          "705310106": {
            "id": "705310106",
            "speakerId": 1000,
            "speakerName": "奥妮",
            "text": "简单来说，我们冒险家协会在蒙德的各处放置了许多「巡景台」。",
            "nextDialogs": [
              "705310107"
            ]
          },
          "705310107": {
            "id": "705310107",
            "speakerId": 1000,
            "speakerName": "奥妮",
            "text": "您要做的，就是找到这些「巡景台」，并且用「巡景台」上的印章，在我们发给您的「巡景手册」上盖上纪念章。",
            "nextDialogs": [
              "705310108"
            ]
          },
          "705310108": {
            "id": "705310108",
            "speakerId": 1000,
            "speakerName": "奥妮",
            "text": "只要找到所有「巡景台」，并且集齐所有的纪念章…您就算是完成挑战啦。",
            "nextDialogs": [
              "705310109"
            ]
          },
          "705310109": {
            "id": "705310109",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "这活动…还真是有冒险家协会的风格…",
            "nextDialogs": [
              "705310110"
            ]
          },
          "705310110": {
            "id": "705310110",
            "speakerId": 1000,
            "speakerName": "奥妮",
            "text": "嘿嘿…放置那些「巡景台」的位置，我们可是专门设计过的。",
            "nextDialogs": [
              "705310111"
            ]
          },
          "705310111": {
            "id": "705310111",
            "speakerId": 1000,
            "speakerName": "奥妮",
            "text": "虽然…有些「巡景台」的位置有点偏僻，说不定周围还有魔物出现…",
            "nextDialogs": [
              "705310112"
            ]
          },
          "705310112": {
            "id": "705310112",
            "speakerId": 1000,
            "speakerName": "奥妮",
            "text": "但我觉得，以前辈的身手，对付那些魔物肯定也是轻轻松松啦。",
            "nextDialogs": [
              "705310113"
            ]
          },
          "705310113": {
            "id": "705310113",
            "speakerId": 1000,
            "speakerName": "奥妮",
            "text": "那么，我马上把「巡景手册」给您，祝前辈玩得开心！"
          }
        }
      }
    }
  ]
}
      }
    },
    {
      "subId": "1302503",
      "subQuestName": "前往「阿赫玛尔之须」所在地",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "130250301"
        ],
        "dialogs": {
          "130250301": {
            "id": "130250301",
            "speakerId": 1052,
            "speakerName": "迪希雅",
            "text": "看来我们运气不错，就是那个营地。",
            "nextDialogs": [
              "130250302"
            ]
          },
          "130250302": {
            "id": "130250302",
            "speakerId": 1052,
            "speakerName": "迪希雅",
            "text": "走吧，去把所有的事都问清楚。"
          }
        }
      }
    },
    {
      "subId": "1302504",
      "subQuestName": "冲破阻拦",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [],
        "dialogs": {}
      }
    },
    {
      "subId": "1302505",
      "subQuestName": "与伊德里西等人交谈",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "130250501"
        ],
        "dialogs": {
          "130250501": {
            "id": "130250501",
            "speakerId": 13107,
            "speakerName": "巴沙尔",
            "text": "好、好厉害…",
            "nextDialogs": [
              "130250502"
            ]
          },
          "130250502": {
            "id": "130250502",
            "speakerId": 1052,
            "speakerName": "迪希雅",
            "text": "再打下去也没用，大家都互相认识，我也不想撕破脸皮。",
            "nextDialogs": [
              "130250503"
            ]
          },
          "130250503": {
            "id": "130250503",
            "speakerId": 1052,
            "speakerName": "迪希雅",
            "text": "快让库塞拉出来见我，别再躲躲藏藏的了！",
            "nextDialogs": [
              "130250504"
            ]
          },
          "130250504": {
            "id": "130250504",
            "speakerId": 13108,
            "speakerName": "提克里蒂",
            "text": "……",
            "nextDialogs": [
              "130250505"
            ]
          },
          "130250505": {
            "id": "130250505",
            "speakerId": 1052,
            "speakerName": "迪希雅",
            "text": "听不懂我说的话吗？还是说没打够啊？",
            "nextDialogs": [
              "130250506"
            ]
          },
          "130250506": {
            "id": "130250506",
            "speakerId": 13065,
            "speakerName": "伊德里西",
            "text": "行了行了，就这样吧，都冷静一下。",
            "nextDialogs": [
              "130250507"
            ]
          },
          "130250507": {
            "id": "130250507",
            "speakerId": 13065,
            "speakerName": "伊德里西",
            "text": "团长他没办法见你，迪希雅。",
            "nextDialogs": [
              "130250508"
            ]
          },
          "130250508": {
            "id": "130250508",
            "speakerId": 13065,
            "speakerName": "伊德里西",
            "text": "他早就死了。",
            "nextDialogs": [
              "130250509"
            ]
          },
          "130250509": {
            "id": "130250509",
            "speakerId": 1052,
            "speakerName": "迪希雅",
            "text": "什么…？",
            "nextDialogs": [
              "130250510"
            ]
          },
          "130250510": {
            "id": "130250510",
            "speakerId": 13107,
            "speakerName": "巴沙尔",
            "text": "看来你是完全不关心这边的消息啊，不过这也是团长生前的期望。",
            "nextDialogs": [
              "130250511"
            ]
          },
          "130250511": {
            "id": "130250511",
            "speakerId": 1052,
            "speakerName": "迪希雅",
            "text": "那是什么时候的事？到底发生了什么？",
            "nextDialogs": [
              "130250512"
            ]
          },
          "130250512": {
            "id": "130250512",
            "speakerId": 13108,
            "speakerName": "提克里蒂",
            "text": "几年前，库塞拉团长一个人去了「神王之遗」的总部，还解散了「阿赫玛尔之须」。",
            "nextDialogs": [
              "130250513"
            ]
          },
          "130250513": {
            "id": "130250513",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "难道说…就是你们开始闹事的时候？",
            "nextDialogs": [
              "130250514"
            ]
          },
          "130250514": {
            "id": "130250514",
            "speakerId": 13107,
            "speakerName": "巴沙尔",
            "text": "我们更愿意称它为「复仇」，「神王之遗」的家伙，必须血债血偿，一个都不留！",
            "nextDialogs": [
              "130250517"
            ]
          },
          "130250517": {
            "id": "130250517",
            "speakerId": 13065,
            "speakerName": "伊德里西",
            "text": "还是我来从头讲吧。迪希雅，你知道「神王之遗」的老大，是怎么维持内部秩序的吗？",
            "nextDialogs": [
              "130250518"
            ]
          },
          "130250518": {
            "id": "130250518",
            "speakerId": 1052,
            "speakerName": "迪希雅",
            "text": "压倒性的武力，还有不容置疑的威严？",
            "nextDialogs": [
              "130250519"
            ]
          },
          "130250519": {
            "id": "130250519",
            "speakerId": 13065,
            "speakerName": "伊德里西",
            "text": "嗯，确实如此，但光有这些还不够，他们还有另一个武器，名为「案底」。",
            "nextDialogs": [
              "130250520"
            ]
          },
          "130250520": {
            "id": "130250520",
            "speakerId": 13065,
            "speakerName": "伊德里西",
            "text": "「神王之遗」的人，无论是自愿加入的，还是被迫效忠的，都必须留下一次记录。",
            "nextDialogs": [
              "130250521"
            ]
          },
          "130250521": {
            "id": "130250521",
            "speakerId": 13065,
            "speakerName": "伊德里西",
            "text": "肮脏的，不道德的，罪无可恕的记录，这既是忠诚的象征，也是要挟时的底牌。"
          }
        }
      }
    },
    {
      "subId": "1302520",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "130252001"
        ],
        "dialogs": {
          "130252001": {
            "id": "130252001",
            "speakerId": 13066,
            "speakerName": "哲瓦德",
            "text": "放心，我不会乱跑的…"
          }
        }
      }
    },
    {
      "subId": "1302521",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "130252101"
        ],
        "dialogs": {
          "130252101": {
            "id": "130252101",
            "speakerId": 12179,
            "speakerName": "观察",
            "text": "（萨塔尔伤情不重，不过多久应该就会醒过来，就这么放在这里也没事吧？）"
          }
        }
      }
    },
    {
      "subId": "1302599",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "130259901"
        ],
        "dialogs": {
          "130259901": {
            "id": "130259901",
            "speakerId": 1052,
            "speakerName": "迪希雅",
            "text": "让库塞拉出来，我要见他！",
            "nextDialogs": [
              "130259902"
            ]
          },
          "130259902": {
            "id": "130259902",
            "speakerId": 13108,
            "speakerName": "提克里蒂",
            "text": "迪希雅，怎么是你？",
            "nextDialogs": [
              "130259903"
            ]
          },
          "130259903": {
            "id": "130259903",
            "speakerId": 1052,
            "speakerName": "迪希雅",
            "text": "糊涂事已经做够了吧！",
            "nextDialogs": [
              "130259904"
            ]
          },
          "130259904": {
            "id": "130259904",
            "speakerId": 13065,
            "speakerName": "伊德里西",
            "text": "你也是来阻止我们的吗？",
            "nextDialogs": [
              "130259905"
            ]
          },
          "130259905": {
            "id": "130259905",
            "speakerId": 13107,
            "speakerName": "巴沙尔",
            "text": "这件事和你没关系！"
          }
        }
      }
    }
  ]
}
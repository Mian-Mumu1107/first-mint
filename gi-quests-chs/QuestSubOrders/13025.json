  },
  "subQuests": [
    {
      "subId": "1302501",
      "subQuestName": "回须弥城见迪娜泽黛",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "130250101"
        ],
        "dialogs": {
          "130250101": {
            "id": "130250101",
            "speakerId": 1052,
            "speakerName": "迪希雅",
            "text": "我们回来了，小姐。",
            "nextDialogs": [
              "130250102"
            ]
          },
          "130250102": {
            "id": "130250102",
            "speakerId": 13013,
            "speakerName": "迪娜泽黛",
            "text": "哦，比我想象中快很多啊！看样子应该没遇到麻烦，怎么样，事情调查清楚了吗？",
            "nextDialogs": [
              "130250103"
            ]
          },
          "130250103": {
            "id": "130250103",
            "speakerId": 1052,
            "speakerName": "迪希雅",
            "text": "其实还在调查中，遇到了一些比较…奇怪的事。",
            "nextDialogs": [
              "130250104"
            ]
          },
          "130250104": {
            "id": "130250104",
            "speakerId": 13013,
            "speakerName": "迪娜泽黛",
            "text": "我明白了，线索是回到了须弥城这边，对吗？",
            "nextDialogs": [
              "130250105"
            ]
          },
          "130250105": {
            "id": "130250105",
            "speakerId": 1052,
            "speakerName": "迪希雅",
            "text": "嗯，差不多吧。",
            "nextDialogs": [
              "130250106"
            ]
          },
          "130250106": {
            "id": "130250106",
            "speakerId": 13013,
            "speakerName": "迪娜泽黛",
            "text": "感觉你们情绪不高的样子，事情的走向，果然不太好吗？",
            "nextDialogs": [
              "130250107"
            ]
          },
          "130250107": {
            "id": "130250107",
            "speakerId": 13013,
            "speakerName": "迪娜泽黛",
            "text": "要不然也和我说说看吧，说不定我可以分享一些积极的看法呢。",
            "nextDialogs": [
              "130250108"
            ]
          },
          "130250108": {
            "id": "130250108",
            "speakerId": 1052,
            "speakerName": "迪希雅",
            "text": "不是的，小姐，没有在烦恼我自己的事，怎么说呢，嗯…",
            "nextDialogs": [
              "130250109"
            ]
          },
          "130250109": {
            "id": "130250109",
            "speakerId": 13013,
            "speakerName": "迪娜泽黛",
            "text": "果然有点不对劲，你们两个人从刚刚开始也不说话。",
            "nextDialogs": [
              "130250110"
            ]
          },
          "130250110": {
            "id": "130250110",
            "speakerId": 13013,
            "speakerName": "迪娜泽黛",
            "text": "派蒙的话，平时都会很有精神地朝我招手，「喂，迪娜泽黛——！」",
            "nextDialogs": [
              "130250111"
            ]
          },
          "130250111": {
            "id": "130250111",
            "speakerId": 13013,
            "speakerName": "迪娜泽黛",
            "text": "肯定是发生了什么吧？",
            "nextDialogs": [
              "130250112"
            ]
          },
          "130250112": {
            "id": "130250112",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "这、这个…",
            "nextDialogs": [
              "130250113"
            ]
          },
          "130250113": {
            "id": "130250113",
            "speakerId": 1052,
            "speakerName": "迪希雅",
            "text": "小姐，接下来的事，需要你有一点心理准备，是关于老爷的…",
            "nextDialogs": [
              "130250114"
            ]
          },
          "130250114": {
            "id": "130250114",
            "speakerId": 13013,
            "speakerName": "迪娜泽黛",
            "text": "父亲的事？",
            "nextDialogs": [
              "130250115"
            ]
          },
          "130250115": {
            "id": "130250115",
            "speakerId": 13013,
            "speakerName": "迪娜泽黛",
            "text": "我知道了，我会认真听的，不用担心我。",
            "nextDialogs": [
              "130250116"
            ]
          },
          "130250116": {
            "id": "130250116",
            "speakerId": 1003,
            "speakerName": "Black Screen",
            "text": "迪希雅有些为难地和迪娜泽黛讲述了调查结果。",
            "nextDialogs": [
              "130250117"
            ]
          },
          "130250117": {
            "id": "130250117",
            "speakerId": 13013,
            "speakerName": "迪娜泽黛",
            "text": "父亲他把物资送去了「阿赫玛尔之须」？",
            "nextDialogs": [
              "130250118"
            ]
          },
          "130250118": {
            "id": "130250118",
            "speakerId": 1052,
            "speakerName": "迪希雅",
            "text": "嗯，我们实在是一头雾水。",
            "nextDialogs": [
              "130250119"
            ]
          },
          "130250119": {
            "id": "130250119",
            "speakerId": 1052,
            "speakerName": "迪希雅",
            "text": "我从不怀疑老爷的人品，所以更是百思不得其解，他为什么要帮助坏人呢？",
            "nextDialogs": [
              "130250120"
            ]
          },
          "130250120": {
            "id": "130250120",
            "speakerId": 1052,
            "speakerName": "迪希雅",
            "text": "或许他只是偶然参与到交易中，对背后的事不知情。",
            "nextDialogs": [
              "130250121"
            ]
          },
          "130250121": {
            "id": "130250121",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "但这个可能性不高。",
            "nextDialogs": [
              "130250122"
            ]
          },
          "130250122": {
            "id": "130250122",
            "speakerId": 13013,
            "speakerName": "迪娜泽黛",
            "text": "是的，我也这么觉得。",
            "nextDialogs": [
              "130250123"
            ]
          },
          "130250123": {
            "id": "130250123",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "欸？你也觉得？",
            "nextDialogs": [
              "130250124"
            ]
          },
          "130250124": {
            "id": "130250124",
            "speakerId": 13013,
            "speakerName": "迪娜泽黛",
            "text": "谢谢你们，愿意告诉我这些。",
            "nextDialogs": [
              "130250125"
            ]
          },
          "130250125": {
            "id": "130250125",
            "speakerId": 13013,
            "speakerName": "迪娜泽黛",
            "text": "既然你们毫无保留，我也应该把我一直以来的疑惑都告诉你们。",
            "nextDialogs": [
              "130250126"
            ]
          },
          "130250126": {
            "id": "130250126",
            "speakerId": 13013,
            "speakerName": "迪娜泽黛",
            "text": "我以前觉得，父亲会给我安排贴身保镖，是为了看好我，让我不要到处乱跑。",
            "nextDialogs": [
              "130250127"
            ]
          },
          "130250127": {
            "id": "130250127",
            "speakerId": 13013,
            "speakerName": "迪娜泽黛",
            "text": "可是，城里的「三十人团」有那么多合适的人选，为什么父亲他会选上迪希雅呢？",
            "nextDialogs": [
              "130250128"
            ]
          },
          "130250128": {
            "id": "130250128",
            "speakerId": 1052,
            "speakerName": "迪希雅",
            "text": "这个嘛…因为之前呼玛伊家需要护卫，就找了我们「炽光猎兽」。",
            "nextDialogs": [
              "130250129"
            ]
          },
          "130250129": {
            "id": "130250129",
            "speakerId": 1052,
            "speakerName": "迪希雅",
            "text": "后来老爷说对我的身手印象深刻，说什么都要请我来当保镖。",
            "nextDialogs": [
              "130250130"
            ]
          },
          "130250130": {
            "id": "130250130",
            "speakerId": 1052,
            "speakerName": "迪希雅",
            "text": "因为价钱非常诱人，我就答应了…",
            "nextDialogs": [
              "130250131"
            ]
          },
          "130250131": {
            "id": "130250131",
            "speakerId": 13013,
            "speakerName": "迪娜泽黛",
            "text": "那还是同样的问题，我父亲怎么会联系上「炽光猎兽」？",
            "nextDialogs": [
              "130250132"
            ]
          },
          "130250132": {
            "id": "130250132",
            "speakerId": 1052,
            "speakerName": "迪希雅",
            "text": "「三十人团」人手有限，或者是有熟人介绍，我之前没细想…",
            "nextDialogs": [
              "130250133"
            ]
          },
          "130250133": {
            "id": "130250133",
            "speakerId": 1052,
            "speakerName": "迪希雅",
            "text": "我明白了，你是想说，如果这一切都不是偶然？",
            "nextDialogs": [
              "130250134"
            ]
          },
          "130250134": {
            "id": "130250134",
            "speakerId": 13013,
            "speakerName": "迪娜泽黛",
            "text": "是的，一切看起来都顺理成章，但细想的话，这里面有很多难理解的地方。",
            "nextDialogs": [
              "130250135"
            ]
          },
          "130250135": {
            "id": "130250135",
            "speakerId": 13013,
            "speakerName": "迪娜泽黛",
            "text": "但如果父亲他一直和「阿赫玛尔之须」保持某种联系，迪希雅你会来我家，就不是巧合了。",
            "nextDialogs": [
              "130250136"
            ]
          },
          "130250136": {
            "id": "130250136",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "不会吧，请迪希雅来当保镖才是目的？",
            "nextDialogs": [
              "130250137"
            ]
          },
          "130250137": {
            "id": "130250137",
            "speakerId": 1052,
            "speakerName": "迪希雅",
            "text": "不不不，这也想得太过头了。我和我父亲很久没联系了，我做什么也都和他无关。",
            "nextDialogs": [
              "130250138"
            ]
          },
          "130250138": {
            "id": "130250138",
            "speakerId": 13013,
            "speakerName": "迪娜泽黛",
            "text": "但也不排除你的父亲单方面做了什么吧。",
            "nextDialogs": [
              "130250139"
            ]
          },
          "130250139": {
            "id": "130250139",
            "speakerId": 1052,
            "speakerName": "迪希雅",
            "text": "嗯…",
            "nextDialogs": [
              "130250140"
            ]
          },
          "130250140": {
            "id": "130250140",
            "speakerId": 1052,
            "speakerName": "迪希雅",
            "text": "这么看来，老爷他不太可能只是个不知情的受害者了吧。",
            "nextDialogs": [
              "130250141"
            ]
          },
          "130250141": {
            "id": "130250141",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "结果还是变成了这样。",
            "nextDialogs": [
              "130250142"
            ]
          },
          "130250142": {
            "id": "130250142",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "对不起，把麻烦引到了你的身上。",
            "nextDialogs": [
              "130250143"
            ]
          },
          "130250143": {
            "id": "130250143",
            "speakerId": 13013,
            "speakerName": "迪娜泽黛",
            "text": "你不用道歉，派蒙，倒是我应该感谢你们。",
            "nextDialogs": [
              "130250144"
            ]
          },
          "130250144": {
            "id": "130250144",
            "speakerId": 13013,
            "speakerName": "迪娜泽黛",
            "text": "无论背后的原因是什么，如果我父亲真的在资助恶人，我都应该尽早让他清醒过来。",
            "nextDialogs": [
              "130250145"
            ]
          },
          "130250145": {
            "id": "130250145",
            "speakerId": 1052,
            "speakerName": "迪希雅",
            "text": "这样…真的好吗？",
            "nextDialogs": [
              "130250146"
            ]
          },
          "130250146": {
            "id": "130250146",
            "speakerId": 1052,
            "speakerName": "迪希雅",
            "text": "我父亲犯下了那么多暴行，理应受到责罚，我一点都不同情他，就算说我不孝也没关系。",
            "nextDialogs": [
              "130250147"
            ]
          },
          "130250147": {
            "id": "130250147",
            "speakerId": 1052,
            "speakerName": "迪希雅",
            "text": "但呼玛伊家的人，给了我待遇特别好的工作不说，还很照顾我。",
            "nextDialogs": [
              "130250148"
            ]
          },
          "130250148": {
            "id": "130250148",
            "speakerId": 1052,
            "speakerName": "迪希雅",
            "text": "而这件事的结果，很可能牵连到整个呼玛伊家，这样的话，我不就是在恩将仇报吗？",
            "nextDialogs": [
              "130250149"
            ]
          },
          "130250149": {
            "id": "130250149",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "迪希雅…",
            "nextDialogs": [
              "130250150"
            ]
          },
          "130250150": {
            "id": "130250150",
            "speakerId": 13013,
            "speakerName": "迪娜泽黛",
            "text": "没关系，迪希雅，你就说是我要求你这么做的。",
            "nextDialogs": [
              "130250151"
            ]
          },
          "130250151": {
            "id": "130250151",
            "speakerId": 1052,
            "speakerName": "迪希雅",
            "text": "别这样，小姐，我不是害怕承担责任，而且现在更痛苦的应该是你才对。",
            "nextDialogs": [
              "130250152"
            ]
          },
          "130250152": {
            "id": "130250152",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "还、还没到这种时候嘛！那句话怎么说的来着？",
            "nextDialogs": [
              "130250153"
            ]
          },
          "130250153": {
            "id": "130250153",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "这是「信任」。",
            "nextDialogs": [
              "130250154"
            ]
          },
          "130250154": {
            "id": "130250154",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "对，信任！这可是迪希雅你自己说的。",
            "nextDialogs": [
              "130250155"
            ]
          },
          "130250155": {
            "id": "130250155",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "在知道真相之前，想东想西都没有意义！",
            "nextDialogs": [
              "130250158"
            ]
          },
          "130250158": {
            "id": "130250158",
            "speakerId": 1052,
            "speakerName": "迪希雅",
            "text": "有道理，谢谢你们，我明白了。「信任」无论何时都很重要。",
            "nextDialogs": [
              "130250159"
            ]
          },
          "130250159": {
            "id": "130250159",
            "speakerId": 1052,
            "speakerName": "迪希雅",
            "text": "那么，能麻烦小姐你把老爷约出来，我们一起谈谈吗？",
            "nextDialogs": [
              "130250160"
            ]
          },
          "130250160": {
            "id": "130250160",
            "speakerId": 13013,
            "speakerName": "迪娜泽黛",
            "text": "好的，希望他能给我们一个合理的解释。那我们老地方见。",
            "nextDialogs": [
              "130250161"
            ]
          },
          "130250161": {
            "id": "130250161",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "老地方？哦，我知道了！"
          }
        }
      }
    },
    {
      "subId": "1302506",
      "subQuestName": "去老地方等待迪娜泽黛",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "130250601"
        ],
        "dialogs": {
          "130250601": {
            "id": "130250601",
            "speakerId": 1052,
            "speakerName": "迪希雅",
            "text": "您来了，老爷。",
            "nextDialogs": [
              "130250602"
            ]
          },
          "130250602": {
            "id": "130250602",
            "speakerId": 1052,
            "speakerName": "迪希雅",
            "text": "#我来介绍一下吧，这位是旅行者{NICKNAME}，身边是{M#他}{F#她}的向导派蒙。",
            "nextDialogs": [
              "130250603"
            ]
          },
          "130250603": {
            "id": "130250603",
            "speakerId": 13064,
            "speakerName": "沙扎曼",
            "text": "#之前{M#他}{F#她}们和我女儿做的事，我略有耳闻，今天有机会见到，也是我的荣幸。",
            "nextDialogs": [
              "130250604"
            ]
          },
          "130250604": {
            "id": "130250604",
            "speakerId": 13064,
            "speakerName": "沙扎曼",
            "text": "我们长话短说吧，重要的事情是指？",
            "nextDialogs": [
              "130250605"
            ]
          },
          "130250605": {
            "id": "130250605",
            "speakerId": 1052,
            "speakerName": "迪希雅",
            "text": "先请您看一张交易清单，我们有一件比较好奇的事。",
            "nextDialogs": [
              "130250606"
            ]
          },
          "130250606": {
            "id": "130250606",
            "speakerId": 1003,
            "speakerName": "Black Screen",
            "text": "迪希雅将事由向沙扎曼说明，并道出了心中的疑点。",
            "nextDialogs": [
              "130250607"
            ]
          },
          "130250607": {
            "id": "130250607",
            "speakerId": 13064,
            "speakerName": "沙扎曼",
            "text": "果然是这件事…看来没有多少隐瞒的余地了。",
            "nextDialogs": [
              "130250608"
            ]
          },
          "130250608": {
            "id": "130250608",
            "speakerId": 1052,
            "speakerName": "迪希雅",
            "text": "那老爷您能和我们解释一下吗？",
            "nextDialogs": [
              "130250609"
            ]
          },
          "130250609": {
            "id": "130250609",
            "speakerId": 13064,
            "speakerName": "沙扎曼",
            "text": "这是非常复杂的故事，我也不知道我的做法是对是错。",
            "nextDialogs": [
              "130250610"
            ]
          },
          "130250610": {
            "id": "130250610",
            "speakerId": 13064,
            "speakerName": "沙扎曼",
            "text": "但我能确定的是，迪希雅，这段故事对你来说，毫无益处，还很可能会伤害到你。",
            "nextDialogs": [
              "130250611"
            ]
          },
          "130250611": {
            "id": "130250611",
            "speakerId": 1052,
            "speakerName": "迪希雅",
            "text": "我？",
            "nextDialogs": [
              "130250612"
            ]
          },
          "130250612": {
            "id": "130250612",
            "speakerId": 13064,
            "speakerName": "沙扎曼",
            "text": "是的，我非常理解你们来找我的原因，你们表现出的正义感也令我感动。",
            "nextDialogs": [
              "130250613"
            ]
          },
          "130250613": {
            "id": "130250613",
            "speakerId": 13064,
            "speakerName": "沙扎曼",
            "text": "但知识绝不是越多越好，被隐藏起来的真相，有可能会让人更加幸福。",
            "nextDialogs": [
              "130250614"
            ]
          },
          "130250614": {
            "id": "130250614",
            "speakerId": 13064,
            "speakerName": "沙扎曼",
            "text": "无论是我，还是你的父亲库塞拉，都希望这样做。",
            "nextDialogs": [
              "130250615"
            ]
          },
          "130250615": {
            "id": "130250615",
            "speakerId": 13064,
            "speakerName": "沙扎曼",
            "text": "你有知晓真相的权利，但我必须对你发出警告…",
            "nextDialogs": [
              "130250616"
            ]
          },
          "130250616": {
            "id": "130250616",
            "speakerId": 13064,
            "speakerName": "沙扎曼",
            "text": "这个真相，可能让你人生路上累积的一切，都化为被风吹散的黄沙。",
            "nextDialogs": [
              "130250617"
            ]
          },
          "130250617": {
            "id": "130250617",
            "speakerId": 13064,
            "speakerName": "沙扎曼",
            "text": "而库塞拉的心血，也会在你追寻真相的路上，化为泡影。",
            "nextDialogs": [
              "130250618"
            ]
          },
          "130250618": {
            "id": "130250618",
            "speakerId": 1052,
            "speakerName": "迪希雅",
            "text": "他的心血？我不是很明白，老爷。",
            "nextDialogs": [
              "130250619"
            ]
          },
          "130250619": {
            "id": "130250619",
            "speakerId": 1052,
            "speakerName": "迪希雅",
            "text": "我一路闯过来，可没有享受过那家伙的半分关照。",
            "nextDialogs": [
              "130250620"
            ]
          },
          "130250620": {
            "id": "130250620",
            "speakerId": 1052,
            "speakerName": "迪希雅",
            "text": "我有我的信念与善恶标准，也有珍视的人与事，这些都与他无关。",
            "nextDialogs": [
              "130250621"
            ]
          },
          "130250621": {
            "id": "130250621",
            "speakerId": 1052,
            "speakerName": "迪希雅",
            "text": "况且，我是来帮助老爷的。在这件事上，我不会后退，也不会动摇。",
            "nextDialogs": [
              "130250622"
            ]
          },
          "130250622": {
            "id": "130250622",
            "speakerId": 13064,
            "speakerName": "沙扎曼",
            "text": "行吧，我明白了。那就听我说一小段故事吧。",
            "nextDialogs": [
              "130250623"
            ]
          },
          "130250623": {
            "id": "130250623",
            "speakerId": 13064,
            "speakerName": "沙扎曼",
            "text": "迪娜泽黛刚出生不久，我们家有事要去一趟沙漠，结果在路上遇到了强盗。",
            "nextDialogs": [
              "130250624"
            ]
          },
          "130250624": {
            "id": "130250624",
            "speakerId": 13064,
            "speakerName": "沙扎曼",
            "text": "对方人数众多，我们的保镖都被打散，这时候，是路过的镀金旅团救了我们。",
            "nextDialogs": [
              "130250625"
            ]
          },
          "130250625": {
            "id": "130250625",
            "speakerId": 13064,
            "speakerName": "沙扎曼",
            "text": "那就是「阿赫玛尔之须」，库塞拉率领的团。",
            "nextDialogs": [
              "130250626"
            ]
          },
          "130250626": {
            "id": "130250626",
            "speakerId": 13064,
            "speakerName": "沙扎曼",
            "text": "他们告诉我，抢劫我们的人也是镀金旅团，我很诧异，为什么这帮人不惜对自己人动手，也要帮我们解围。",
            "nextDialogs": [
              "130250627"
            ]
          },
          "130250627": {
            "id": "130250627",
            "speakerId": 13064,
            "speakerName": "沙扎曼",
            "text": "库塞拉他笑了笑，走到我们身边开始逗弄那时还是婴儿的迪娜泽黛，差点把她吓哭了。",
            "nextDialogs": [
              "130250628"
            ]
          },
          "130250628": {
            "id": "130250628",
            "speakerId": 13013,
            "speakerName": "迪娜泽黛",
            "text": "还…还有这种事？",
            "nextDialogs": [
              "130250629"
            ]
          },
          "130250629": {
            "id": "130250629",
            "speakerId": 13064,
            "speakerName": "沙扎曼",
            "text": "他说，帮助我们也没什么特别的原因，只是因为他的孩子和迪娜泽黛看上去差不多大。",
            "nextDialogs": [
              "130250630"
            ]
          },
          "130250630": {
            "id": "130250630",
            "speakerId": 13064,
            "speakerName": "沙扎曼",
            "text": "我们顺着孩子的话题聊了起来，我能感觉他是个心地善良的父亲。",
            "nextDialogs": [
              "130250631"
            ]
          },
          "130250631": {
            "id": "130250631",
            "speakerId": 13064,
            "speakerName": "沙扎曼",
            "text": "为了报答他的恩情，我雇佣他的旅团到我们家帮了一段时间的忙，给了他们丰厚的报酬。",
            "nextDialogs": [
              "130250632"
            ]
          },
          "130250632": {
            "id": "130250632",
            "speakerId": 1052,
            "speakerName": "迪希雅",
            "text": "居然是这样…",
            "nextDialogs": [
              "130250633"
            ]
          },
          "130250633": {
            "id": "130250633",
            "speakerId": 13064,
            "speakerName": "沙扎曼",
            "text": "再次见面的时候是很多年之后了。那天有人敲门，我一开始根本没认出他来。",
            "nextDialogs": [
              "130250634"
            ]
          },
          "130250634": {
            "id": "130250634",
            "speakerId": 13064,
            "speakerName": "沙扎曼",
            "text": "原本健康强壮的他变得既憔悴又虚弱，走路都得拄拐。",
            "nextDialogs": [
              "130250635"
            ]
          },
          "130250635": {
            "id": "130250635",
            "speakerId": 1052,
            "speakerName": "迪希雅",
            "text": "怎么会这样，我走的时候他还很健康啊？",
            "nextDialogs": [
              "130250636"
            ]
          },
          "130250636": {
            "id": "130250636",
            "speakerId": 13064,
            "speakerName": "沙扎曼",
            "text": "我也不知道。唯一没变的，是他爽朗的表情，他说不用担心，只是被人打了而已。",
            "nextDialogs": [
              "130250637"
            ]
          },
          "130250637": {
            "id": "130250637",
            "speakerId": 13064,
            "speakerName": "沙扎曼",
            "text": "他突然就问我，迪娜泽黛已经长大了，是不是需要一个贴身保镖？",
            "nextDialogs": [
              "130250638"
            ]
          },
          "130250638": {
            "id": "130250638",
            "speakerId": 13064,
            "speakerName": "沙扎曼",
            "text": "那时候迪娜泽黛的魔鳞病愈发严重，很难有机会出门，当然用不上保镖。",
            "nextDialogs": [
              "130250639"
            ]
          },
          "130250639": {
            "id": "130250639",
            "speakerId": 13064,
            "speakerName": "沙扎曼",
            "text": "他就有一搭没一搭地说，「他觉得有必要」，「总会用得上」之类的话。",
            "nextDialogs": [
              "130250640"
            ]
          },
          "130250640": {
            "id": "130250640",
            "speakerId": 13064,
            "speakerName": "沙扎曼",
            "text": "我一开始还没听懂，直到他推荐了「炽光猎兽」，一个名叫迪希雅的佣兵…",
            "nextDialogs": [
              "130250641"
            ]
          },
          "130250641": {
            "id": "130250641",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "是他给你推荐的啊？",
            "nextDialogs": [
              "130250642"
            ]
          },
          "130250642": {
            "id": "130250642",
            "speakerId": 13064,
            "speakerName": "沙扎曼",
            "text": "嗯，他很隐晦地表达了他的用意：「神王之遗」里都是十恶不赦的恶徒，待在里面的人迟早会做坏事。",
            "nextDialogs": [
              "130250643"
            ]
          },
          "130250643": {
            "id": "130250643",
            "speakerId": 13064,
            "speakerName": "沙扎曼",
            "text": "他已经没救了，但他希望自己的女儿可以离身不由己的佣兵世界远一点。",
            "nextDialogs": [
              "130250644"
            ]
          },
          "130250644": {
            "id": "130250644",
            "speakerId": 13064,
            "speakerName": "沙扎曼",
            "text": "如果迪希雅能在我家一直做保镖，那她就可以远离沙漠，一点点变成普通人。",
            "nextDialogs": [
              "130250645"
            ]
          },
          "130250645": {
            "id": "130250645",
            "speakerId": 13013,
            "speakerName": "迪娜泽黛",
            "text": "所以父亲才开了那么高的报酬？",
            "nextDialogs": [
              "130250646"
            ]
          },
          "130250646": {
            "id": "130250646",
            "speakerId": 13064,
            "speakerName": "沙扎曼",
            "text": "也不完全是——从他拜托我的时候开始，我就已经把迪希雅当成自己的女儿了。",
            "nextDialogs": [
              "130250647"
            ]
          },
          "130250647": {
            "id": "130250647",
            "speakerId": 13064,
            "speakerName": "沙扎曼",
            "text": "所以迪希雅你说要走的时候，我怎么都想把你留下来，花再多的钱都行…",
            "nextDialogs": [
              "130250648"
            ]
          },
          "130250648": {
            "id": "130250648",
            "speakerId": 13064,
            "speakerName": "沙扎曼",
            "text": "因为库塞拉在沙漠里救了我和迪娜泽黛，现在他把女儿托付给我，我肯定不能拒绝。",
            "nextDialogs": [
              "130250649"
            ]
          },
          "130250649": {
            "id": "130250649",
            "speakerId": 1052,
            "speakerName": "迪希雅",
            "text": "那个家伙，他总是这样…自作聪明，自以为是…",
            "nextDialogs": [
              "130250650"
            ]
          },
          "130250650": {
            "id": "130250650",
            "speakerId": 13064,
            "speakerName": "沙扎曼",
            "text": "库塞拉说，他会出一部分雇佣迪希雅的钱，我坚持不收，但他还是经常寄钱过来。",
            "nextDialogs": [
              "130250651"
            ]
          },
          "130250651": {
            "id": "130250651",
            "speakerId": 13064,
            "speakerName": "沙扎曼",
            "text": "我心想这也是他的一份心意，就收下了。直到几年前，我又收到了他的一封信。",
            "nextDialogs": [
              "130250652"
            ]
          },
          "130250652": {
            "id": "130250652",
            "speakerId": 13064,
            "speakerName": "沙扎曼",
            "text": "他请求我帮他购买食物，武器，药物，甚至还有爆炸物的原料。",
            "nextDialogs": [
              "130250653"
            ]
          },
          "130250653": {
            "id": "130250653",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "那不就是「阿赫玛尔之须」开始兴风作浪的时候嘛！",
            "nextDialogs": [
              "130250654"
            ]
          },
          "130250654": {
            "id": "130250654",
            "speakerId": 13064,
            "speakerName": "沙扎曼",
            "text": "嗯，联系到那些不好的传闻，我也警觉起来，想要当面和他谈一谈。",
            "nextDialogs": [
              "130250655"
            ]
          },
          "130250655": {
            "id": "130250655",
            "speakerId": 13064,
            "speakerName": "沙扎曼",
            "text": "但那时候的他已经拒绝和我见面了，可能是不想牵连到迪希雅吧。",
            "nextDialogs": [
              "130250656"
            ]
          },
          "130250656": {
            "id": "130250656",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "那也不该来找你要物资才对。",
            "nextDialogs": [
              "130250657"
            ]
          },
          "130250657": {
            "id": "130250657",
            "speakerId": 13064,
            "speakerName": "沙扎曼",
            "text": "我也想到了这一点，所以判断他实在是走投无路了，才会向我求助。",
            "nextDialogs": [
              "130250658"
            ]
          },
          "130250658": {
            "id": "130250658",
            "speakerId": 13064,
            "speakerName": "沙扎曼",
            "text": "于是权衡之后，我还是给他提供了食物和药品，危险的东西全都拒绝了。",
            "nextDialogs": [
              "130250659"
            ]
          },
          "130250659": {
            "id": "130250659",
            "speakerId": 13064,
            "speakerName": "沙扎曼",
            "text": "我知道，就算只是这样的帮助，也可能会间接伤害到他人，但我同样也无法对往日的恩人置之不顾。",
            "nextDialogs": [
              "130250660"
            ]
          },
          "130250660": {
            "id": "130250660",
            "speakerId": 13064,
            "speakerName": "沙扎曼",
            "text": "果然，这么做是错的吧。我只是对一些事情充耳不闻，选择了自己内心最轻松的做法而已。",
            "nextDialogs": [
              "130250681"
            ]
          },
          "130250681": {
            "id": "130250681",
            "speakerId": 1052,
            "speakerName": "迪希雅",
            "text": "…把他的行踪告诉我吧，老爷。",
            "nextDialogs": [
              "130250661"
            ]
          },
          "130250661": {
            "id": "130250661",
            "speakerId": 1052,
            "speakerName": "迪希雅",
            "text": "如果他真的只是不想连累我，那现在做的所有事逻辑上都讲不通…",
            "nextDialogs": [
              "130250662"
            ]
          },
          "130250662": {
            "id": "130250662",
            "speakerId": 1052,
            "speakerName": "迪希雅",
            "text": "如果他只是想和我撇清关系，那当初就不要随随便便把我带到这个世界上啊。",
            "nextDialogs": [
              "130250663"
            ]
          },
          "130250663": {
            "id": "130250663",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "不要难过，迪希雅，不要难过…",
            "nextDialogs": [
              "130250664"
            ]
          },
          "130250664": {
            "id": "130250664",
            "speakerId": 1052,
            "speakerName": "迪希雅",
            "text": "我只是愤怒，完全搞不懂他在干什么。",
            "nextDialogs": [
              "130250666",
              "130250668"
            ]
          },
          "130250666": {
            "id": "130250666",
            "speakerId": 1052,
            "speakerName": "迪希雅",
            "text": "别的解读？我不知道…他既幼稚又粗鲁，我理解不了他的想法…",
            "nextDialogs": [
              "130250669"
            ]
          },
          "130250669": {
            "id": "130250669",
            "speakerId": 1052,
            "speakerName": "迪希雅",
            "text": "但你说的有道理，真相还没完全揭开，我们还要搞清楚这几年他在干什么，想什么。",
            "nextDialogs": [
              "130250670"
            ]
          },
          "130250670": {
            "id": "130250670",
            "speakerId": 13064,
            "speakerName": "沙扎曼",
            "text": "我会帮忙的，你们父女之间遗留的问题，还得你们当面解决。",
            "nextDialogs": [
              "130250671"
            ]
          },
          "130250671": {
            "id": "130250671",
            "speakerId": 13064,
            "speakerName": "沙扎曼",
            "text": "不过我也不知道他在哪里，我只提供物资，并不想保持更深的关系。",
            "nextDialogs": [
              "130250672"
            ]
          },
          "130250672": {
            "id": "130250672",
            "speakerId": 13064,
            "speakerName": "沙扎曼",
            "text": "但清单上有个叫<color=#00E1FFFF>哲瓦德</color>的人，他在「三十人团」，听说以前是沙漠的佣兵。",
            "nextDialogs": [
              "130250673"
            ]
          },
          "130250673": {
            "id": "130250673",
            "speakerId": 13064,
            "speakerName": "沙扎曼",
            "text": "他负责提供武器，还会和商队接头，我觉得他应该知道库塞拉他们的下落。",
            "nextDialogs": [
              "130250674"
            ]
          },
          "130250674": {
            "id": "130250674",
            "speakerId": 13064,
            "speakerName": "沙扎曼",
            "text": "我听说他喜欢<color=#00E1FFFF>晚上</color>一个人在<color=#00E1FFFF>酒馆外</color>坐着喝点东西，吹吹晚风，你们可以去看看。",
            "nextDialogs": [
              "130250675"
            ]
          },
          "130250675": {
            "id": "130250675",
            "speakerId": 1052,
            "speakerName": "迪希雅",
            "text": "好的，谢谢老爷。那您和迪娜泽黛…",
            "nextDialogs": [
              "130250676"
            ]
          },
          "130250676": {
            "id": "130250676",
            "speakerId": 13013,
            "speakerName": "迪娜泽黛",
            "text": "父亲的事就交给我吧…说实话我现在脑子有点乱，还是没有冷静下来。",
            "nextDialogs": [
              "130250677"
            ]
          },
          "130250677": {
            "id": "130250677",
            "speakerId": 13013,
            "speakerName": "迪娜泽黛",
            "text": "父亲他确实是做了错事，但这件事，好像也没有什么正确的做法。",
            "nextDialogs": [
              "130250678"
            ]
          },
          "130250678": {
            "id": "130250678",
            "speakerId": 13013,
            "speakerName": "迪娜泽黛",
            "text": "我觉得，只能把所有的真相都告诉「三十人团」，让他们来判断…",
            "nextDialogs": [
              "130250679"
            ]
          },
          "130250679": {
            "id": "130250679",
            "speakerId": 13064,
            "speakerName": "沙扎曼",
            "text": "嗯，无论结果如何，我都愿意承受。",
            "nextDialogs": [
              "130250680"
            ]
          },
          "130250680": {
            "id": "130250680",
            "speakerId": 13064,
            "speakerName": "沙扎曼",
            "text": "也到了承认错误的时候了…"
          },
          "130250668": {
            "id": "130250668",
            "speakerId": 1052,
            "speakerName": "迪希雅",
            "text": "我不知道，我真的不知道…应该不行吧，我做不到。"
          }
        }
      }
    },
    {
      "subId": "1302502",
      "subQuestName": "<color=#00E1FFFF>晚上</color>在酒馆外寻找<color=#00E1FFFF>哲瓦德</color>",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "130250201"
        ],
        "dialogs": {
          "130250201": {
            "id": "130250201",
            "speakerId": 13066,
            "speakerName": "哲瓦德",
            "text": "嗯？你们是？",
            "nextDialogs": [
              "130250202"
            ]
          },
          "130250202": {
            "id": "130250202",
            "speakerId": 1052,
            "speakerName": "迪希雅",
            "text": "作为官方组织，把武器走私给沙漠的暴力团，你好大的胆子嘛。",
            "nextDialogs": [
              "130250203"
            ]
          },
          "130250203": {
            "id": "130250203",
            "speakerId": 13066,
            "speakerName": "哲瓦德",
            "text": "嘘，小声点！你怎么知道的！",
            "nextDialogs": [
              "130250204"
            ]
          },
          "130250204": {
            "id": "130250204",
            "speakerId": 13066,
            "speakerName": "哲瓦德",
            "text": "你们跟我过来，换个地方，有话好说，有话好说。",
            "nextDialogs": [
              "130250205"
            ]
          },
          "130250205": {
            "id": "130250205",
            "speakerId": 13066,
            "speakerName": "哲瓦德",
            "text": "这里应该差不多…好了，你们到底是怎么知道的？",
            "nextDialogs": [
              "130250206"
            ]
          },
          "130250206": {
            "id": "130250206",
            "speakerId": 1052,
            "speakerName": "迪希雅",
            "text": "这你别管，你知道这件事被上报之后，会有什么惩罚在等你吧。",
            "nextDialogs": [
              "130250207"
            ]
          },
          "130250207": {
            "id": "130250207",
            "speakerId": 13066,
            "speakerName": "哲瓦德",
            "text": "没必要啊，还没到那一步，我这不是打算和你们商量商量嘛。",
            "nextDialogs": [
              "130250208"
            ]
          },
          "130250208": {
            "id": "130250208",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "你就只是为了摩拉？",
            "nextDialogs": [
              "130250209"
            ]
          },
          "130250209": {
            "id": "130250209",
            "speakerId": 13066,
            "speakerName": "哲瓦德",
            "text": "唔，那段时间手头确实紧，以前库塞拉又给过我不少照顾。",
            "nextDialogs": [
              "130250210"
            ]
          },
          "130250210": {
            "id": "130250210",
            "speakerId": 13066,
            "speakerName": "哲瓦德",
            "text": "这一来一回，我没有理由拒绝这样的交易啊，又能帮忙，又能赚钱…",
            "nextDialogs": [
              "130250211"
            ]
          },
          "130250211": {
            "id": "130250211",
            "speakerId": 1052,
            "speakerName": "迪希雅",
            "text": "我给你指条明路吧，现在我们正在调查「阿赫玛尔之须」，打算阻止他们的行动。",
            "nextDialogs": [
              "130250212"
            ]
          },
          "130250212": {
            "id": "130250212",
            "speakerId": 1052,
            "speakerName": "迪希雅",
            "text": "假如你为我们提供了帮助，那我想之后对你的处罚应该也会相应地减轻一些。",
            "nextDialogs": [
              "130250213"
            ]
          },
          "130250213": {
            "id": "130250213",
            "speakerId": 13066,
            "speakerName": "哲瓦德",
            "text": "就没有其他的解决办法吗？我这次赚了不少摩拉，要不然你开个数…",
            "nextDialogs": [
              "130250214"
            ]
          },
          "130250214": {
            "id": "130250214",
            "speakerId": 1052,
            "speakerName": "迪希雅",
            "text": "不行。",
            "nextDialogs": [
              "130250215"
            ]
          },
          "130250215": {
            "id": "130250215",
            "speakerId": 1052,
            "speakerName": "迪希雅",
            "text": "我的耐心是有限的，佣兵是不是为了钱而来，你应该一眼就知道。",
            "nextDialogs": [
              "130250216"
            ]
          },
          "130250216": {
            "id": "130250216",
            "speakerId": 13066,
            "speakerName": "哲瓦德",
            "text": "好啦好啦，真是的，那你们到时候一定要给我作证啊。",
            "nextDialogs": [
              "130250217"
            ]
          },
          "130250217": {
            "id": "130250217",
            "speakerId": 13066,
            "speakerName": "哲瓦德",
            "text": "他们的营地一直在换，上次我送货的时候，他们在沙漠的这个位置。",
            "nextDialogs": [
              "130250218"
            ]
          },
          "130250218": {
            "id": "130250218",
            "speakerId": 13066,
            "speakerName": "哲瓦德",
            "text": "你们去看看吧，不过我先说，如果他们不见了那也不怪我。",
            "nextDialogs": [
              "130250219"
            ]
          },
          "130250219": {
            "id": "130250219",
            "speakerId": 1052,
            "speakerName": "迪希雅",
            "text": "行啊，那为你作证这事也别想了。",
            "nextDialogs": [
              "130250220"
            ]
          },
          "130250220": {
            "id": "130250220",
            "speakerId": 13066,
            "speakerName": "哲瓦德",
            "text": "喂，怎么这样！",
            "nextDialogs": [
              "130250221"
            ]
          },
          "130250221": {
            "id": "130250221",
            "speakerId": 1052,
            "speakerName": "迪希雅",
            "text": "不然怎么保证你没有撒谎？搞清楚，你没有和我讨价还价的资格。",
            "nextDialogs": [
              "130250222"
            ]
          },
          "130250222": {
            "id": "130250222",
            "speakerId": 13066,
            "speakerName": "哲瓦德",
            "text": "好好好，我知道了…你们先去看看吧，要是他们不见了，我再帮你们想办法。",
            "nextDialogs": [
              "130250223"
            ]
          },
          "130250223": {
            "id": "130250223",
            "speakerId": 1052,
            "speakerName": "迪希雅",
            "text": "这还差不多，我们走吧。",
            "nextDialogs": [
              "130250224"
            ]
          },
          "130250224": {
            "id": "130250224",
            "speakerId": 1052,
            "speakerName": "迪希雅",
            "text": "你就老实在城里待着，别到时候还要我们找「三十人团」的人把你抓回来。"
          }
        }
      }
    },
    {
      "subId": "1302509",
      "subQuestName": "前往「阿赫玛尔之须」所在地",
      "sceneId": null,
      "locations": [],

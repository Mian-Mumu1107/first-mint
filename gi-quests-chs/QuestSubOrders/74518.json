{
  "lineCounts": {
    "Player": 4,
    "昂吉安妮": 6,
    "蒂蕾娜": 11
  },
  "subQuests": [
    {
      "subId": "7451801",
      "subQuestName": "和「执律庭」队员们对话",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "745180101"
        ],
        "dialogs": {
          "745180101": {
            "id": "745180101",
            "speakerId": 1000,
            "speakerName": "蒂蕾娜",
            "text": "嗯…对敌人的强硬支撑点开展进攻时，机动组的路径选择，和屏卫单位的配合调度，确实值得深入研究。",
            "nextDialogs": [
              "745180102"
            ]
          },
          "745180102": {
            "id": "745180102",
            "speakerId": 1001,
            "speakerName": "昂吉安妮",
            "text": "#主要还是{NICKNAME}指挥得太离谱，根本不按常理出牌…",
            "nextDialogs": [
              "745180105"
            ]
          },
          "745180105": {
            "id": "745180105",
            "speakerId": 1000,
            "speakerName": "蒂蕾娜",
            "text": "的确！如您所见，主攻部队一旦展开，短时间内很难脱离接触，这个时候，掩护侧方、截断敌方增援的兵力就显得至关重要了。",
            "nextDialogs": [
              "745180106"
            ]
          },
          "745180106": {
            "id": "745180106",
            "speakerId": 1000,
            "speakerName": "蒂蕾娜",
            "text": "但在兵力有限的情况下，分出多少单位去屏卫，一直是个难题。",
            "nextDialogs": [
              "745180107"
            ]
          },
          "745180107": {
            "id": "745180107",
            "speakerId": 1001,
            "speakerName": "昂吉安妮",
            "text": "哎呀…人多了有可能削弱主力，人少了可能没法形成遮断，每次行动派多少人去屏卫，谁都说不准。",
            "nextDialogs": [
              "745180108"
            ]
          },
          "745180108": {
            "id": "745180108",
            "speakerId": 1001,
            "speakerName": "昂吉安妮",
            "text": "按照惯例，特巡队会以约四分之一主攻部队的兵力组成屏卫力量，在敌方潜在增援到来的方向上巡逻…",
            "nextDialogs": [
              "745180109"
            ]
          },
          "745180109": {
            "id": "745180109",
            "speakerId": 1001,
            "speakerName": "昂吉安妮",
            "text": "一般情况下，这样安排就够用了，但也出现过邪门的情况…屏卫搁那边悠闲散步，没敌人来，主力反倒缺人，打得气喘吁吁…",
            "nextDialogs": [
              "745180110"
            ]
          },
          "745180110": {
            "id": "745180110",
            "speakerId": 1000,
            "speakerName": "蒂蕾娜",
            "text": "而您，准领队，您有时会将主力部队机动组的进攻路径安排得万分巧妙，与屏卫部队相互照应。",
            "nextDialogs": [
              "745180111"
            ]
          },
          "745180111": {
            "id": "745180111",
            "speakerId": 1000,
            "speakerName": "蒂蕾娜",
            "text": "如此一来，主力部队机动组和屏卫部队可以在合适的时机互相支援，最大程度利用兵力。",
            "nextDialogs": [
              "745180112"
            ]
          },
          "745180112": {
            "id": "745180112",
            "speakerId": 1000,
            "speakerName": "蒂蕾娜",
            "text": "进攻受阻时，屏卫就适当辅助机动组，敌方强大增援来袭时，机动组也可以就地与屏卫一同对其拦截，堪称攻守一体！"
          }
        }
      }
    }
  ]
}
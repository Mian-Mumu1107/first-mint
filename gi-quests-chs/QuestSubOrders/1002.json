    {
      "subId": "100205",
      "subQuestName": "自动与仙人对话（隐藏）$HIDDEN",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "10020501"
        ],
        "dialogs": {
          "10020501": {
            "id": "10020501",
            "speakerId": 2002801,
            "speakerName": "削月筑阳真君",
            "text": "那么，重归正题——旅者，说出你的来意。",
            "nextDialogs": [
              "10020502"
            ]
          },
          "10020502": {
            "id": "10020502",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "其实…",
            "nextDialogs": [
              "10020503"
            ]
          },
          "10020503": {
            "id": "10020503",
            "speakerId": 2002801,
            "speakerName": "削月筑阳真君",
            "text": "岂有此理…",
            "nextDialogs": [
              "10020504"
            ]
          },
          "10020504": {
            "id": "10020504",
            "speakerId": 2002801,
            "speakerName": "削月筑阳真君",
            "text": "岂有此理！！！",
            "nextDialogs": [
              "10020505"
            ]
          },
          "10020505": {
            "id": "10020505",
            "speakerId": 2002801,
            "speakerName": "削月筑阳真君",
            "text": "璃月七星…实在令人失望。",
            "nextDialogs": [
              "10020506"
            ]
          },
          "10020506": {
            "id": "10020506",
            "speakerId": 2002801,
            "speakerName": "削月筑阳真君",
            "text": "「请仙典仪」上，如何能有人行刺帝君…",
            "nextDialogs": [
              "10020507"
            ]
          },
          "10020507": {
            "id": "10020507",
            "speakerId": 2002801,
            "speakerName": "削月筑阳真君",
            "text": "帝君遇刺之后…又如何能将嫌疑推给观礼凡民？！",
            "nextDialogs": [
              "10020508"
            ]
          },
          "10020508": {
            "id": "10020508",
            "speakerId": 2002801,
            "speakerName": "削月筑阳真君",
            "text": "……",
            "nextDialogs": [
              "10020509"
            ]
          },
          "10020509": {
            "id": "10020509",
            "speakerId": 2002801,
            "speakerName": "削月筑阳真君",
            "text": "旅者，你受诬为刺客的冤情，我也已然知晓。",
            "nextDialogs": [
              "10020510"
            ]
          },
          "10020510": {
            "id": "10020510",
            "speakerId": 2002801,
            "speakerName": "削月筑阳真君",
            "text": "此事我心已有判断。然我独断，或有差错，尚需知会众仙。",
            "nextDialogs": [
              "10020511"
            ]
          },
          "10020511": {
            "id": "10020511",
            "speakerId": 2002801,
            "speakerName": "削月筑阳真君",
            "text": "去吧。拿着你的「百无禁忌箓」，为我去传口信。",
            "nextDialogs": [
              "10020513"
            ]
          },
          "10020513": {
            "id": "10020513",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "我该去哪里呢？",
            "nextDialogs": [
              "10020514"
            ]
          },
          "10020514": {
            "id": "10020514",
            "speakerId": 2002801,
            "speakerName": "削月筑阳真君",
            "text": "理水叠山真君、留云借风真君，这两位常在此间，但你未必有缘相遇——随缘即可。",
            "nextDialogs": [
              "10020515"
            ]
          },
          "10020515": {
            "id": "10020515",
            "speakerId": 2002801,
            "speakerName": "削月筑阳真君",
            "text": "还有一位降魔大圣、护法夜叉。去往「望舒客栈」，或可觅其踪迹。"
          }
        }
      }
    }
  ]
}
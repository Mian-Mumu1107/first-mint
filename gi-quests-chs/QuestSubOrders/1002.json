    {
      "subId": "100202",
      "subQuestName": "（test）与仙人对话$HIDDEN",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "10020201"
        ],
        "dialogs": {
          "10020201": {
            "id": "10020201",
            "speakerId": 10205,
            "speakerName": "？？？",
            "text": "尔是何人，因何擅闯「绝云间」？",
            "nextDialogs": [
              "10020203"
            ]
          },
          "10020203": {
            "id": "10020203",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "请您看看这个…",
            "nextDialogs": [
              "10020204"
            ]
          },
          "10020204": {
            "id": "10020204",
            "speakerId": 10205,
            "speakerName": "？？？",
            "text": "「百无禁忌箓」…多年不见这东西了，原来凡人手中还有残余。",
            "nextDialogs": [
              "10020205"
            ]
          },
          "10020205": {
            "id": "10020205",
            "speakerId": 2002801,
            "speakerName": "削月筑阳真君",
            "text": "我乃三眼五显仙人，削月筑阳真君。旅者，说出你的来意。",
            "nextDialogs": [
              "10020206"
            ]
          },
          "10020206": {
            "id": "10020206",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "其实…",
            "nextDialogs": [
              "10020207"
            ]
          },
          "10020207": {
            "id": "10020207",
            "speakerId": 2003004,
            "speakerName": "千岩军教头",
            "text": "是刺客！他们居然潜逃到了这里！",
            "nextDialogs": [
              "10020208"
            ]
          },
          "10020208": {
            "id": "10020208",
            "speakerId": 2003001,
            "speakerName": "千岩军士兵",
            "text": "头儿，我们已经太深入「绝云间」了…",
            "nextDialogs": [
              "10020209"
            ]
          },
          "10020209": {
            "id": "10020209",
            "speakerId": 2003004,
            "speakerName": "千岩军教头",
            "text": "这…没法子，捉拿刺客是头等大事，硬着头皮也要上啊！",
            "nextDialogs": [
              "10020210"
            ]
          },
          "10020210": {
            "id": "10020210",
            "speakerId": 2002801,
            "speakerName": "削月筑阳真君",
            "text": "…滋扰清境。",
            "nextDialogs": [
              "10020211"
            ]
          },
          "10020211": {
            "id": "10020211",
            "speakerId": 2002801,
            "speakerName": "削月筑阳真君",
            "text": "送走他们，莫要杀生。"
          }
        }
      }
    },
    {

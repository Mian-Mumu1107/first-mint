  "subQuests": [
    {
      "subId": "7250001",
      "subQuestName": "与阿守交谈",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "725000101"
        ],
        "dialogs": {
          "725000101": {
            "id": "725000101",
            "speakerId": 1000,
            "speakerName": "阿守",
            "text": "出事了！",
            "nextDialogs": [
              "725000102"
            ]
          },
          "725000102": {
            "id": "725000102",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "怎么了？",
            "nextDialogs": [
              "725000103"
            ]
          },
          "725000103": {
            "id": "725000103",
            "speakerId": 1000,
            "speakerName": "阿守",
            "text": "老大又进去了！",
            "nextDialogs": [
              "725000104"
            ]
          },
          "725000104": {
            "id": "725000104",
            "speakerId": 1000,
            "speakerName": "阿守",
            "text": "就在刚才，天领奉行派人过来，在留言板上贴了一张告示，说是要暂停我们的祭典。",
            "nextDialogs": [
              "725000105"
            ]
          },
          "725000105": {
            "id": "725000105",
            "speakerId": 1000,
            "speakerName": "阿守",
            "text": "不知道怎么回事，老大他好像把宣传广告发进了天守阁。",
            "nextDialogs": [
              "725000106"
            ]
          },
          "725000106": {
            "id": "725000106",
            "speakerId": 1000,
            "speakerName": "阿守",
            "text": "还说将军大人一定想要参加荒泷极上盛世豪鼓大祭典！",
            "nextDialogs": [
              "725000107"
            ]
          },
          "725000107": {
            "id": "725000107",
            "speakerId": 1001,
            "speakerName": "阿晃",
            "text": "欸？这么说的话，我觉得老大说的没错呀。我也觉得将军大人肯定想参加。",
            "nextDialogs": [
              "725000108"
            ]
          },
          "725000108": {
            "id": "725000108",
            "speakerId": 1002,
            "speakerName": "元太",
            "text": "对呀，难道你不是这么认为的吗？",
            "nextDialogs": [
              "725000109"
            ]
          },
          "725000109": {
            "id": "725000109",
            "speakerId": 1000,
            "speakerName": "阿守",
            "text": "哎呀，谁会管我们怎么觉得呀。",
            "nextDialogs": [
              "725000110"
            ]
          },
          "725000110": {
            "id": "725000110",
            "speakerId": 1000,
            "speakerName": "阿守",
            "text": "总之老大就是被看守的奥诘众当场抓获，送去了天领奉行。",
            "nextDialogs": [
              "725000111"
            ]
          },
          "725000111": {
            "id": "725000111",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "那要怎么办呢？",
            "nextDialogs": [
              "725000112"
            ]
          },
          "725000112": {
            "id": "725000112",
            "speakerId": 1000,
            "speakerName": "阿守",
            "text": "忍姐应该已经在处理了吧。",
            "nextDialogs": [
              "725000113"
            ]
          },
          "725000113": {
            "id": "725000113",
            "speakerId": 1000,
            "speakerName": "阿守",
            "text": "据说奥诘众对老大的指控是涉嫌扰乱军事禁区。",
            "nextDialogs": [
              "725000114"
            ]
          },
          "725000114": {
            "id": "725000114",
            "speakerId": 1000,
            "speakerName": "阿守",
            "text": "后来被九条裟罗大人改成了涉嫌妨碍公共秩序。",
            "nextDialogs": [
              "725000115"
            ]
          },
          "725000115": {
            "id": "725000115",
            "speakerId": 1002,
            "speakerName": "元太",
            "text": "呀呀呀呀呀，这个可恶的九条天狗，居然给老大定了这种重罪！",
            "nextDialogs": [
              "725000116"
            ]
          },
          "725000116": {
            "id": "725000116",
            "speakerId": 1000,
            "speakerName": "阿守",
            "text": "哎呀，你傻啦！这是变成了轻罪，一般在所里教育教育就好…",
            "nextDialogs": [
              "725000117"
            ]
          },
          "725000117": {
            "id": "725000117",
            "speakerId": 1000,
            "speakerName": "阿守",
            "text": "至于祭典这边，就只能等老大出来之后再说啦。",
            "nextDialogs": [
              "725000118"
            ]
          },
          "725000118": {
            "id": "725000118",
            "speakerId": 1000,
            "speakerName": "阿守",
            "text": "旅行者，您也不用担心，有忍姐在那边处理，肯定不会有大问题。",
            "nextDialogs": [
              "725000119"
            ]
          },
          "725000119": {
            "id": "725000119",
            "speakerId": 1000,
            "speakerName": "阿守",
            "text": "您对我们的祭典这么支持，等老大出来，他一定会来当面感谢你的！",
            "nextDialogs": [
              "725000120"
            ]
          },
          "725000120": {
            "id": "725000120",
            "speakerId": 1000,
            "speakerName": "阿守",
            "text": "希望您的旅途和我们的祭典一样，都能越来越好。",
            "nextDialogs": [
              "725000121"
            ]
          },
          "725000121": {
            "id": "725000121",
            "speakerId": 1003,
            "speakerName": "荒泷派成员",
            "text": "越来越好！！"
          }
        }
      }
    }
  ]
}
  },
  "subQuests": [
    {
      "subId": "1012001",
      "subQuestName": "与骑士团的琴交谈",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "101200101"
        ],
        "dialogs": {
          "101200101": {
            "id": "101200101",
            "speakerId": 1006,
            "speakerName": "琴",
            "text": "荣誉骑士，感谢你在百忙中抽空过来。",
            "nextDialogs": [
              "101200102"
            ]
          },
          "101200102": {
            "id": "101200102",
            "speakerId": 1006,
            "speakerName": "琴",
            "text": "长话短说吧，骑士团现在有一件比较特殊的事想要拜托你。",
            "nextDialogs": [
              "101200104",
              "101200106"
            ]
          },
          "101200104": {
            "id": "101200104",
            "speakerId": 1006,
            "speakerName": "琴",
            "text": "嗯，近日风波不断，无论是我，还是所有留驻蒙德的骑士团成员，都不敢有片刻懈怠。",
            "nextDialogs": [
              "101200107"
            ]
          },
          "101200107": {
            "id": "101200107",
            "speakerId": 1006,
            "speakerName": "琴",
            "text": "最近我收到了很多骑士团成员的汇报，说劳伦斯家族的人，和愚人众往来密切。",
            "nextDialogs": [
              "101200108"
            ]
          },
          "101200108": {
            "id": "101200108",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "愚人众，又是他们！",
            "nextDialogs": [
              "101200109"
            ]
          },
          "101200109": {
            "id": "101200109",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "不过这个劳伦斯家族，又是什么人？",
            "nextDialogs": [
              "101200110"
            ]
          },
          "101200110": {
            "id": "101200110",
            "speakerId": 1006,
            "speakerName": "琴",
            "text": "过去的蒙德，曾有一段被旧贵族统治的昏暗时期。从高塔孤王那里夺回的自由又被套上枷锁，奴隶制大行其道。",
            "nextDialogs": [
              "101200111"
            ]
          },
          "101200111": {
            "id": "101200111",
            "speakerId": 1006,
            "speakerName": "琴",
            "text": "初代「蒲公英骑士」温妮莎引领了革命，推翻了旧贵族的统治，建立了西风骑士团，蒙德这才拥有了现在这番景象。",
            "nextDialogs": [
              "101200112"
            ]
          },
          "101200112": {
            "id": "101200112",
            "speakerId": 1006,
            "speakerName": "琴",
            "text": "而当年为蒙德带来苦难的旧贵族，就是劳伦斯家族了。",
            "nextDialogs": [
              "101200113"
            ]
          },
          "101200113": {
            "id": "101200113",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "啊，我好像听明白了。那现在这帮坏人的后代，又想和愚人众一起做坏事了？",
            "nextDialogs": [
              "101200114"
            ]
          },
          "101200114": {
            "id": "101200114",
            "speakerId": 1006,
            "speakerName": "琴",
            "text": "目前只是怀疑，还没有什么确切的证据。我请你们来，就是为了调查这件事。"
          },
          "101200106": {
            "id": "101200106",
            "speakerId": 1006,
            "speakerName": "琴",
            "text": "如果状况允许，我也想和你多寒暄两句。但蒙德城的安全，还是要放在首位。"
          }
        }
      }
    },
    {
      "subId": "1012002",
      "subQuestName": "在城内寻找旧贵族",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "101200201"
        ],
        "dialogs": {
          "101200201": {
            "id": "101200201",
            "speakerId": 10423,
            "speakerName": "？？？",
            "text": "嗯？谁啊？",
            "nextDialogs": [
              "101200202"
            ]
          },
          "101200202": {
            "id": "101200202",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "你好，我们是来…",
            "nextDialogs": [
              "101200203"
            ]
          },
          "101200203": {
            "id": "101200203",
            "speakerId": 10423,
            "speakerName": "？？？",
            "text": "你好？",
            "nextDialogs": [
              "101200205",
              "101200207"
            ]
          },
          "101200205": {
            "id": "101200205",
            "speakerId": 10423,
            "speakerName": "？？？",
            "text": "你好？我没听错吧？",
            "nextDialogs": [
              "101200208"
            ]
          },
          "101200208": {
            "id": "101200208",
            "speakerId": 10423,
            "speakerName": "？？？",
            "text": "哼，粗鲁又轻浮，竟然随随便便就走上来打招呼。",
            "nextDialogs": [
              "101200209"
            ]
          },
          "101200209": {
            "id": "101200209",
            "speakerId": 10386,
            "speakerName": "舒伯特",
            "text": "果然是无知的外来者，连我都不认识。我可是舒伯特·劳伦斯，货真价实的贵族后裔。",
            "nextDialogs": [
              "101200210"
            ]
          },
          "101200210": {
            "id": "101200210",
            "speakerId": 10386,
            "speakerName": "舒伯特",
            "text": "想跟我打招呼，要好好注意你的遣词造句，这样随意又懒散的言语简直不堪入耳。",
            "nextDialogs": [
              "101200211"
            ]
          },
          "101200211": {
            "id": "101200211",
            "speakerId": 10386,
            "speakerName": "舒伯特",
            "text": "若是听懂了我的话，你现在就该单膝跪地，谦卑地呈上自我介绍与歉意，这才是符合标准的礼仪！",
            "nextDialogs": [
              "101200212"
            ]
          },
          "101200212": {
            "id": "101200212",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "欸？这么复杂的礼仪，完全没有听说过？！",
            "nextDialogs": [
              "101200213"
            ]
          },
          "101200213": {
            "id": "101200213",
            "speakerId": 10386,
            "speakerName": "舒伯特",
            "text": "哼，在那个大家都尊礼重道的时代，这种基础礼仪，可是面见贵族的常识！",
            "nextDialogs": [
              "101200214"
            ]
          },
          "101200214": {
            "id": "101200214",
            "speakerId": 10386,
            "speakerName": "舒伯特",
            "text": "若在礼仪上怠慢了贵族，至少都是一顿鞭刑。",
            "nextDialogs": [
              "101200215"
            ]
          },
          "101200215": {
            "id": "101200215",
            "speakerId": 10386,
            "speakerName": "舒伯特",
            "text": "再看看如今的世道，规矩废了，礼仪也忘了，腐坏到不堪入目。"
          },
          "101200207": {
            "id": "101200207",
            "speakerId": 10423,
            "speakerName": "？？？",
            "text": "怎么了吗？我没听错吧？"
          }
        }
      }
    },
    {
      "subId": "1012003",
      "subQuestName": "与城墙边的人交谈",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [],
        "dialogs": {}
      }
    },
    {
      "subId": "1012004",
      "subQuestName": "回骑士团商讨对策",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "101200401"
        ],
        "dialogs": {
          "101200401": {
            "id": "101200401",
            "speakerId": 10205,
            "speakerName": "？？？",
            "text": "你们下手可真快，他们都是我追踪了很长时间的目标。",
            "nextDialogs": [
              "101200402"
            ]
          },
          "101200402": {
            "id": "101200402",
            "speakerId": 10205,
            "speakerName": "？？？",
            "text": "这下子功劳都归你们了，这就是「先下手为强」吗？…可恶，这个仇，我记下了！",
            "nextDialogs": [
              "101200403"
            ]
          },
          "101200403": {
            "id": "101200403",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "…嗯？",
            "nextDialogs": [
              "101200404"
            ]
          },
          "101200404": {
            "id": "101200404",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "等等，记仇？",
            "nextDialogs": [
              "101200405"
            ]
          },
          "101200405": {
            "id": "101200405",
            "speakerId": 10205,
            "speakerName": "？？？",
            "text": "是啊，我听到这边有很大的动静，连忙赶过来，发现你正在和愚人众战斗，还占据了上风。",
            "nextDialogs": [
              "101200406"
            ]
          },
          "101200406": {
            "id": "101200406",
            "speakerId": 10205,
            "speakerName": "？？？",
            "text": "如果我还不出手，别说是功劳，就连光都沾不上了。",
            "nextDialogs": [
              "101200407"
            ]
          },
          "101200407": {
            "id": "101200407",
            "speakerId": 10205,
            "speakerName": "？？？",
            "text": "不过，幸好你没有受伤，和这么多愚人众交战，可是很危险的。",
            "nextDialogs": [
              "101200410"
            ]
          },
          "101200410": {
            "id": "101200410",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "虽然没怎么听懂，但你是在关心我们的安危吧，谢谢你。",
            "nextDialogs": [
              "101200411"
            ]
          },
          "101200411": {
            "id": "101200411",
            "speakerId": 10205,
            "speakerName": "？？？",
            "text": "啊？为什么我要关心仇人的安危？",
            "nextDialogs": [
              "101200412"
            ]
          },
          "101200412": {
            "id": "101200412",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "可是你刚刚说，「幸好你没有受伤」…",
            "nextDialogs": [
              "101200413"
            ]
          },
          "101200413": {
            "id": "101200413",
            "speakerId": 10205,
            "speakerName": "？？？",
            "text": "哦，我的意思是，如果你们有人受伤了，我不光是被抢了功劳，还要负责把你们带回蒙德城——",
            "nextDialogs": [
              "101200414"
            ]
          },
          "101200414": {
            "id": "101200414",
            "speakerId": 10205,
            "speakerName": "？？？",
            "text": "那你们就又给我添了一笔麻烦！这个仇就更是结下了！",
            "nextDialogs": [
              "101200415"
            ]
          },
          "101200415": {
            "id": "101200415",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "居然是这种解读方式吗？！",
            "nextDialogs": [
              "101200416"
            ]
          },
          "101200416": {
            "id": "101200416",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "你该不会就是优菈吧？",
            "nextDialogs": [
              "101200417"
            ]
          },
          "101200417": {
            "id": "101200417",
            "speakerId": 1029,
            "speakerName": "优菈",
            "text": "对啊，没错。",
            "nextDialogs": [
              "101200418"
            ]
          },
          "101200418": {
            "id": "101200418",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "果然，我就觉得她怪怪的！虽然，也没有怪到无法交流的程度…",
            "nextDialogs": [
              "101200419"
            ]
          },
          "101200419": {
            "id": "101200419",
            "speakerId": 1029,
            "speakerName": "优菈",
            "text": "上来就点评陌生人「怪怪的」，不说贵族礼仪，在普通人之间也是很不礼貌的吧？",
            "nextDialogs": [
              "101200420"
            ]
          },
          "101200420": {
            "id": "101200420",
            "speakerId": 1029,
            "speakerName": "优菈",
            "text": "说起来，为什么你们知道我的名字？",
            "nextDialogs": [
              "101200421"
            ]
          },
          "101200421": {
            "id": "101200421",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "#就是你说的礼仪问题啦。{PLAYERAVATAR#SEXPRO[INFO_MALE_PRONOUN_HE|INFO_FEMALE_PRONOUN_SHE]}是西风骑士团的荣誉骑士，我们正想调查一位名叫舒伯特·劳伦斯的贵族。",
            "nextDialogs": [
              "101200422"
            ]
          },
          "101200422": {
            "id": "101200422",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "可是他非常讲究礼仪，完全不愿意和我们说话。",
            "nextDialogs": [
              "101200423"
            ]
          },
          "101200423": {
            "id": "101200423",
            "speakerId": 1029,
            "speakerName": "优菈",
            "text": "哈哈哈，我明白了，他是我的叔父，就是这样的人。",
            "nextDialogs": [
              "101200424"
            ]
          },
          "101200424": {
            "id": "101200424",
            "speakerId": 1029,
            "speakerName": "优菈",
            "text": "不过，为什么要调查他呢？",
            "nextDialogs": [
              "101200425"
            ]
          },
          "101200425": {
            "id": "101200425",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "他好像和愚人众有些密谋。",
            "nextDialogs": [
              "101200426"
            ]
          },
          "101200426": {
            "id": "101200426",
            "speakerId": 1029,
            "speakerName": "优菈",
            "text": "原来如此，哈哈，真是好胆量，当着我的面，说我家里人的坏话。这个仇，又值得记一笔了。",
            "nextDialogs": [
              "101200427"
            ]
          },
          "101200427": {
            "id": "101200427",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "不是啦，这个是琴团长的委托！而且只是怀疑而已！"
          }
        }
      }
    },
    {
      "subId": "1012005",
      "subQuestName": "与安柏交谈",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "101200301"
        ],
        "dialogs": {
          "101200301": {
            "id": "101200301",
            "speakerId": 1002,
            "speakerName": "安柏",
            "text": "这不是「荣誉骑士」嘛！我刚刚打算去侦察，没想到会在这里碰到你！",
            "nextDialogs": [
              "101200302"
            ]
          },
          "101200302": {
            "id": "101200302",
            "speakerId": 1002,
            "speakerName": "安柏",
            "text": "欸？看你的表情，遇上什么不开心的事了吗？",
            "nextDialogs": [
              "101200303"
            ]
          },
          "101200303": {
            "id": "101200303",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "琴团长委托我们去办事，结果…好像有点搞砸了。",
            "nextDialogs": [
              "101200306"
            ]
          },
          "101200306": {
            "id": "101200306",
            "speakerId": 1002,
            "speakerName": "安柏",
            "text": "不要灰心啦，失败是常有的事。我也不能保证每次都找到有用的情报。",
            "nextDialogs": [
              "101200307"
            ]
          },
          "101200307": {
            "id": "101200307",
            "speakerId": 1002,
            "speakerName": "安柏",
            "text": "所以，打起精神来嘛！"
          }
        }
      }
    },
    {
      "subId": "1012006",
      "subQuestName": "前往望风山地寻找优菈",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "101200601"
        ],
        "dialogs": {
          "101200601": {
            "id": "101200601",
            "speakerId": 1006,
            "speakerName": "琴",
            "text": "舒伯特这个人有些情绪化，不太容易相处。",
            "nextDialogs": [
              "101200602"
            ]
          },
          "101200602": {
            "id": "101200602",
            "speakerId": 1006,
            "speakerName": "琴",
            "text": "不过只要能平心静气，应该可以建立起友善的关系。"
          }
        }
      }
    },
    {
      "subId": "1012007",
      "subQuestName": "击败附近的愚人众",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "101200701"
        ],
        "dialogs": {
          "101200701": {
            "id": "101200701",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "关于舒伯特…",
            "nextDialogs": [
              "101200702"
            ]
          },
          "101200702": {
            "id": "101200702",
            "speakerId": 15231,
            "speakerName": "赫塔",
            "text": "你说的是那位古怪的旧贵族吧，不好意思，我没有见到他。",
            "nextDialogs": [
              "101200703"
            ]
          },
          "101200703": {
            "id": "101200703",
            "speakerId": 15231,
            "speakerName": "赫塔",
            "text": "劳伦斯家族的人，很多都不愿意主动出现在西风骑士的面前。",
            "nextDialogs": [
              "101200704"
            ]
          },
          "101200704": {
            "id": "101200704",
            "speakerId": 15231,
            "speakerName": "赫塔",
            "text": "这样也好，影响了军需品的调配，反倒是麻烦事。",
            "nextDialogs": [
              "101200705"
            ]
          },
          "101200705": {
            "id": "101200705",
            "speakerId": 15231,
            "speakerName": "赫塔",
            "text": "你们去上面看看吧，说不定能找到他。"
          }
        }
      }
    },
    {
      "subId": "1012008",
      "subQuestName": "目睹少女击败最后的愚人众",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "101200801"
        ],
        "dialogs": {
          "101200801": {
            "id": "101200801",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "你好，你在附近见过一位叫舒伯特的贵族吗？",
            "nextDialogs": [
              "101200802"
            ]
          },
          "101200802": {
            "id": "101200802",
            "speakerId": 1421,
            "speakerName": "米歇尔",
            "text": "嗯…这个名字我没什么印象，不过最近这里总是有个古怪的人逛来逛去。",
            "nextDialogs": [
              "101200803"
            ]
          },
          "101200803": {
            "id": "101200803",
            "speakerId": 1421,
            "speakerName": "米歇尔",
            "text": "到处看看，有时候还在写写画画，不知道想干什么…",
            "nextDialogs": [
              "101200804"
            ]
          },
          "101200804": {
            "id": "101200804",
            "speakerId": 1421,
            "speakerName": "米歇尔",
            "text": "如果他就是你们要找的人的话，你们往城墙那边走就能遇到他了。"
          }
        }
      }
    },
    {
      "subId": "1012009",
      "subQuestName": "与优菈交谈",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [],
        "dialogs": {}
      }
    },
    {
      "subId": "1012011",
      "subQuestName": "Additional",
      "sceneId": null,

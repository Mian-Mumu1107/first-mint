      "dialogue": {
        "startDialogs": [
          "750490401"
        ],
        "dialogs": {
          "750490401": {
            "id": "750490401",
            "speakerId": 21715,
            "speakerName": "夜魂之灵",
            "text": "嗯…没有想到你居然能找到这里的入口，这里已，许久未有人来了…",
            "nextDialogs": [
              "750490402"
            ]
          },
          "750490402": {
            "id": "750490402",
            "speakerId": 21715,
            "speakerName": "夜魂之灵",
            "text": "此处，嗯，此处是夜魂们游荡之处…呵呵，不过，太阳所照的大地之上，恐怕就连夜魂的名讳业已无人记得。",
            "nextDialogs": [
              "750490403"
            ]
          },
          "750490403": {
            "id": "750490403",
            "speakerId": 21715,
            "speakerName": "夜魂之灵",
            "text": "夜魂啊…在我们的主人睡着时，我们就是她的梦。在我们的神偶尔醒来时，我们就是她思绪的一缕。",
            "nextDialogs": [
              "750490404"
            ]
          },
          "750490404": {
            "id": "750490404",
            "speakerId": 21715,
            "speakerName": "夜魂之灵",
            "text": "竟然有能来到此处的生人，呵呵，那些渴求战斗的家伙们已按捺不住…异邦的勇者，受宠爱之人…",
            "nextDialogs": [
              "750490405"
            ]
          },
          "750490405": {
            "id": "750490405",
            "speakerId": 21715,
            "speakerName": "夜魂之灵",
            "text": "用炽烈的战斗安抚这些躁动不安的魂灵吧，取得胜利，而深眠此处的灵必有嘉奖…如何？"
          }
        }
      }
    },

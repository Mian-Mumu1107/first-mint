    {
      "subId": "7405407",
      "subQuestName": "调查终端",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "740540801"
        ],
        "dialogs": {
          "740540801": {
            "id": "740540801",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "拉动拉杆。",
            "nextDialogs": [
              "740540802"
            ]
          },
          "740540802": {
            "id": "740540802",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "#呜哇！{NICKNAME}，你在干什么啦！",
            "nextDialogs": [
              "740540803"
            ]
          },
          "740540803": {
            "id": "740540803",
            "speakerId": 1001,
            "speakerName": "Black Screen",
            "text": "你毫不犹豫地拉动了拉杆。\\n下一个瞬间，伴随着宛若雷霆的震耳轰鸣，整座高塔开始剧烈地晃动起来，仿佛天为之崩、地为之裂…",
            "nextDialogs": [
              "740540804"
            ]
          },
          "740540804": {
            "id": "740540804",
            "speakerId": 1001,
            "speakerName": "Black Screen",
            "text": "然后…噗地一声，机器吐出了一叠纸带，正好掉在你的手中。\\n一切重归沉寂。",
            "nextDialogs": [
              "740540805"
            ]
          },
          "740540805": {
            "id": "740540805",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "就…就这？",
            "nextDialogs": [
              "740540806"
            ]
          },
          "740540806": {
            "id": "740540806",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "唔…完全看不懂上面刻了什么东西，但看上去好像挺重要的…",
            "nextDialogs": [
              "740540807"
            ]
          },
          "740540807": {
            "id": "740540807",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "#{NICKNAME}，我们还是先留着这些纸带吧？说不定之后会在什么地方用上…"
          }
        }
      }
    },
    {
      "subId": "7405407",

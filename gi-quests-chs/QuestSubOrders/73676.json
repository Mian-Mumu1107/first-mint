        ],
        "dialogs": {
          "736769901": {
            "id": "736769901",
            "speakerId": 1000,
            "speakerName": "芭努",
            "text": "#我就知道不会有那么顺利，{M#大哥哥}{F#大姐姐}你能行吗？快跟我一起躲起来。",
            "nextDialogs": [
              "736769902"
            ]
          },
          "736769902": {
            "id": "736769902",
            "speakerId": 1002,
            "speakerName": "？？？",
            "text": "吼——",
            "nextDialogs": [
              "736769903"
            ]
          },
          "736769903": {
            "id": "736769903",
            "speakerId": 1000,
            "speakerName": "芭努",
            "text": "#是「苹果」！她来帮我们了。{M#大哥哥}{F#大姐姐}，那只长鬓虎就是「苹果」。",
            "nextDialogs": [
              "736769904"
            ]
          },
          "736769904": {
            "id": "736769904",
            "speakerId": 1000,
            "speakerName": "芭努",
            "text": "她特别厉害的，你不用害怕。哈哈，「苹果」！快揍扁它们！"
          }
        }
      }
    }
  ]
}
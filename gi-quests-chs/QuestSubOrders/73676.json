        "startDialogs": [],
        "dialogs": {}
      }
    },
    {
      "subId": "7367604",
      "subQuestName": "与芭努对话",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "736760401"
        ],
        "dialogs": {
          "736760401": {
            "id": "736760401",
            "speakerId": 1002,
            "speakerName": "？？？",
            "text": "芭努，你没受伤吧？",
            "nextDialogs": [
              "736760402"
            ]
          },
          "736760402": {
            "id": "736760402",
            "speakerId": 1000,
            "speakerName": "芭努",
            "text": "才这点程度，没什么好怕的啦。你写的书里教过：打不过立刻就跑。我早就躲到一边去了。",
            "nextDialogs": [
              "736760403"
            ]
          },
          "736760403": {
            "id": "736760403",
            "speakerId": 1000,
            "speakerName": "芭努",
            "text": "对了沙尔玛，你怎么还把「苹果」带来了呀，她现在应该在好好看家才对。",
            "nextDialogs": [
              "736760404"
            ]
          },
          "736760404": {
            "id": "736760404",
            "speakerId": 1003,
            "speakerName": "沙尔玛",
            "text": "「苹果」有点担心你，就跟着我出来了。你知道的嘛，她只听你和妈妈的话，我劝她她也不回去。",
            "nextDialogs": [
              "736760407"
            ]
          },
          "736760407": {
            "id": "736760407",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "芭努好像认识那只突然蹿出来的长鬓虎，还叫它「苹果」…还有这个跟长鬓虎一起突然出现的人，到底怎么回事啊？",
            "nextDialogs": [
              "736760408"
            ]
          },
          "736760408": {
            "id": "736760408",
            "speakerId": 1000,
            "speakerName": "芭努",
            "text": "#{M#大哥哥}{F#大姐姐}，我来给你介绍。",
            "nextDialogs": [
              "736760409"
            ]
          },
          "736760409": {
            "id": "736760409",
            "speakerId": 1000,
            "speakerName": "芭努",
            "text": "这个冒冒失失的家伙就是沙尔玛，我借给你的那本《游学者不可不知的五十件事》就是沙尔玛写的哦。",
            "nextDialogs": [
              "736760410"
            ]
          },
          "736760410": {
            "id": "736760410",
            "speakerId": 1000,
            "speakerName": "芭努",
            "text": "我本来想等到大未来星召唤仪式之后再把沙尔玛和「苹果」一起介绍给你的，但是果然，这次也碰到了意外情况。",
            "nextDialogs": [
              "736760411"
            ]
          },
          "736760411": {
            "id": "736760411",
            "speakerId": 1000,
            "speakerName": "芭努",
            "text": "也好，这样就不用费力气去找人啦，这次的意外发生得正正好，不错不错。希望下次也有这么好的运气！",
            "nextDialogs": [
              "736760412"
            ]
          },
          "736760412": {
            "id": "736760412",
            "speakerId": 1003,
            "speakerName": "沙尔玛",
            "text": "你好，本人是芭努生物学意义上的父亲，沙尔玛。",
            "nextDialogs": [
              "736760413"
            ]
          },
          "736760413": {
            "id": "736760413",
            "speakerId": 1003,
            "speakerName": "沙尔玛",
            "text": "至于「苹果」，她是我们家庭中的另一位重要家庭成员，一只优雅的雌性长鬓虎。",
            "nextDialogs": [
              "736760414"
            ]
          },
          "736760414": {
            "id": "736760414",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "生、生物学意义上的父亲？呃…这是什么意思？难道在别的地方，你就不是芭努的父亲了吗？",
            "nextDialogs": [
              "736760415"
            ]
          },
          "736760415": {
            "id": "736760415",
            "speakerId": 1003,
            "speakerName": "沙尔玛",
            "text": "的确如此。在本人的心目中，本人是和芭努平等的朋友；在日常生活中，本人是和芭努平摊家务的伙伴。",
            "nextDialogs": [
              "736760416"
            ]
          },
          "736760416": {
            "id": "736760416",
            "speakerId": 1003,
            "speakerName": "沙尔玛",
            "text": "父亲不过是这些身份中微不足道的一个而已，比起父亲，本人更愿意做芭努的朋友。",
            "nextDialogs": [
              "736760417"
            ]
          },
          "736760417": {
            "id": "736760417",
            "speakerId": 1003,
            "speakerName": "沙尔玛",
            "text": "刚才本人一直躲在机关下方的地洞里听你们的对话，你们如此愿意帮助芭努，本人万分感激。",
            "nextDialogs": [
              "736760418"
            ]
          },
          "736760418": {
            "id": "736760418",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "不客气。",
            "nextDialogs": [
              "736760419"
            ]
          },
          "736760419": {
            "id": "736760419",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "呃，这个郑重过头的说话口气…我知道刚见面的时候芭努为什么会那样和我们说话了。",
            "nextDialogs": [
              "736760420"
            ]
          },
          "736760420": {
            "id": "736760420",
            "speakerId": 1003,
            "speakerName": "沙尔玛",
            "text": "芭努的措辞和处事方式的确和本人有相似之处，但总体来说，芭努都是个比本人优秀万分的孩子。",
            "nextDialogs": [
              "736760421"
            ]
          },
          "736760421": {
            "id": "736760421",
            "speakerId": 1003,
            "speakerName": "沙尔玛",
            "text": "比如：她做的拌饭比本人做的足足好吃一万倍。仅仅是这一点，就已经足够了不起了。",
            "nextDialogs": [
              "736760422"
            ]
          },
          "736760422": {
            "id": "736760422",
            "speakerId": 1003,
            "speakerName": "沙尔玛",
            "text": "因此，本人十分珍惜和这样快乐活泼的优秀孩子相处的时光。",
            "nextDialogs": [
              "736760423"
            ]
          },
          "736760423": {
            "id": "736760423",
            "speakerId": 1003,
            "speakerName": "沙尔玛",
            "text": "每每想到她即将进入教令院，过上每天泡在教研室里抓头发到半夜、没到四十岁头发就提前变白、长期不按时吃饭导致营养不良的生活…",
            "nextDialogs": [
              "736760424"
            ]
          },
          "736760424": {
            "id": "736760424",
            "speakerId": 1003,
            "speakerName": "沙尔玛",
            "text": "本人就感到十分痛心。",
            "nextDialogs": [
              "736760425"
            ]
          },
          "736760425": {
            "id": "736760425",
            "speakerId": 1003,
            "speakerName": "沙尔玛",
            "text": "在芭努还没进入教令院之前，本人当然需要抓住一切机会，为芭努留下有趣的回忆。这次的寻星之旅就是为了这个目的设计的。",
            "nextDialogs": [
              "736760460"
            ]
          },
          "736760460": {
            "id": "736760460",
            "speakerId": 1003,
            "speakerName": "沙尔玛",
            "text": "由于本人对地脉与机关术有些小小的研究，所以利用这片土地上早已有之的机关做了些小小的布置。",
            "nextDialogs": [
              "736760461"
            ]
          },
          "736760461": {
            "id": "736760461",
            "speakerId": 1000,
            "speakerName": "芭努",
            "text": "沙尔玛，我问你，之前找未来星的时候也好，刚才也好，那些魔物都是你招出来的吗？",
            "nextDialogs": [
              "736760462"
            ]
          },
          "736760462": {
            "id": "736760462",
            "speakerId": 1003,
            "speakerName": "沙尔玛",
            "text": "不不不，这个…这个都是意外。怪我考虑不周，让你们遇到危险了…",
            "nextDialogs": [
              "736760463"
            ]
          },
          "736760463": {
            "id": "736760463",
            "speakerId": 1003,
            "speakerName": "沙尔玛",
            "text": "#我…我其实有让「苹果」暗中跟着你，至于这位冒险家{M#先生}{F#小姐}，我看{M#他}{F#她}的身手那么夸张，就…",
            "nextDialogs": [
              "736760464"
            ]
          },
          "736760464": {
            "id": "736760464",
            "speakerId": 1000,
            "speakerName": "芭努",
            "text": "唉，沙尔玛真是个不靠谱的爸爸，没有我和「苹果」的话，你该怎么办呢？",
            "nextDialogs": [
              "736760426"
            ]
          },
          "736760426": {
            "id": "736760426",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "#{NICKNAME}和我也旅行了好久了，你这种奇怪的父亲我还是第一次见。",
            "nextDialogs": [
              "736760427"
            ]
          },
          "736760427": {
            "id": "736760427",
            "speakerId": 1003,
            "speakerName": "沙尔玛",
            "text": "奇怪吗？奇怪正是本人的人设之一，这个评价真是对本人最好的赞扬。",
            "nextDialogs": [
              "736760428"
            ]
          },
          "736760428": {
            "id": "736760428",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "这也是设定的一部分？",
            "nextDialogs": [
              "736760429"
            ]
          },
          "736760429": {
            "id": "736760429",
            "speakerId": 1003,
            "speakerName": "沙尔玛",
            "text": "是的。否则，在这个拥挤的世界里，本人和庸庸碌碌的其他人又有什么区别呢？",
            "nextDialogs": [
              "736760430"
            ]
          },
          "736760430": {
            "id": "736760430",
            "speakerId": 1003,
            "speakerName": "沙尔玛",
            "text": "虽然不论本人言行有多奇怪，依然不过是偌大世界中的普通人，但本人却拥有位高权重的贤者所无法拥有的胡说八道的自由。",
            "nextDialogs": [
              "736760431"
            ]
          },
          "736760431": {
            "id": "736760431",
            "speakerId": 1003,
            "speakerName": "沙尔玛",
            "text": "啊！这多是一件乐事啊。",
            "nextDialogs": [
              "736760432"
            ]
          },
          "736760432": {
            "id": "736760432",
            "speakerId": 1000,
            "speakerName": "芭努",
            "text": "#{M#大哥哥}{F#大姐姐}别被沙尔玛搞昏头了，每次他想把什么事情糊弄过去的时候，就会像这样胡说八道。",
            "nextDialogs": [
              "736760433"
            ]
          },
          "736760433": {
            "id": "736760433",
            "speakerId": 1000,
            "speakerName": "芭努",
            "text": "沙尔玛，我问你，我的大未来星呢？",
            "nextDialogs": [
              "736760434"
            ]
          },
          "736760434": {
            "id": "736760434",
            "speakerId": 1000,
            "speakerName": "芭努",
            "text": "你之前说集齐六颗未来星、解开最终机关，就可以召唤大未来星的，大未来星在哪里呢？",
            "nextDialogs": [
              "736760435"
            ]
          },
          "736760435": {
            "id": "736760435",
            "speakerId": 1003,
            "speakerName": "沙尔玛",
            "text": "放心放心，这次我绝对没有糊弄芭努。你看，大未来星就在这里。",
            "nextDialogs": [
              "736760436"
            ]
          },
          "736760436": {
            "id": "736760436",
            "speakerId": 1004,
            "speakerName": "Black Screen",
            "text": "沙尔玛从口袋中掏出了一枚星螺递给芭努。",
            "nextDialogs": [
              "736760437"
            ]
          },
          "736760437": {
            "id": "736760437",
            "speakerId": 1003,
            "speakerName": "沙尔玛",
            "text": "这就是集齐未来星之后，跨越了无穷广阔的星海来到芭努身边的大未来星。你看，它表面是不是有一颗闪亮的白色星星？",
            "nextDialogs": [
              "736760438"
            ]
          },
          "736760438": {
            "id": "736760438",
            "speakerId": 1003,
            "speakerName": "沙尔玛",
            "text": "这颗星星就是你们收集的未来星凝成的，它是你的大未来星哦。你把耳朵凑到那个黑色的开口听听看，星海在对你说话呢。",
            "nextDialogs": [
              "736760439"
            ]
          },
          "736760439": {
            "id": "736760439",
            "speakerId": 1000,
            "speakerName": "芭努",
            "text": "喔！这就是大未来星啊！"
          }
        }
      }
    },
    {
      "subId": "7367699",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [

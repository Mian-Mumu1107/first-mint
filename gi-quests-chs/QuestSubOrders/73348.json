  "subQuests": [
    {
      "subId": "7334808",
      "subQuestName": "",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "733480801"
        ],
        "dialogs": {
          "733480801": {
            "id": "733480801",
            "speakerId": 21043,
            "speakerName": "赛达菲",
            "text": "再次感谢您的帮助，如果您以后需要我的帮助，请尽管开口。"
          }
        }
      }
    },
    {
      "subId": "7334806",
      "subQuestName": "寻找普尔比鲁尼一门的学者",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "733480901"
        ],
        "dialogs": {
          "733480901": {
            "id": "733480901",
            "speakerId": 4002,
            "speakerName": "伊丽丝",
            "text": "唉，就这么一点经费，我怎么推进研究…",
            "nextDialogs": [
              "733480904"
            ]
          },
          "733480904": {
            "id": "733480904",
            "speakerId": 4002,
            "speakerName": "伊丽丝",
            "text": "普尔比鲁尼一门的学者？喔，你是来找赛达菲的吧，真稀奇…居然有人来找他。",
            "nextDialogs": [
              "733480905"
            ]
          },
          "733480905": {
            "id": "733480905",
            "speakerId": 4002,
            "speakerName": "伊丽丝",
            "text": "他最近正好在教令院里办事，应该就在附近…你找他有什么事吗？",
            "nextDialogs": [
              "733480906"
            ]
          },
          "733480906": {
            "id": "733480906",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "关于海迪夫的举荐信…",
            "nextDialogs": [
              "733480907"
            ]
          },
          "733480907": {
            "id": "733480907",
            "speakerId": 4002,
            "speakerName": "伊丽丝",
            "text": "海迪夫？他的研究已经结束了吗？有钱真是好啊，能够请一整支队伍陪着自己去考察…",
            "nextDialogs": [
              "733480908"
            ]
          },
          "733480908": {
            "id": "733480908",
            "speakerId": 4002,
            "speakerName": "伊丽丝",
            "text": "而我，连田野考察的补贴都申请不下来…",
            "nextDialogs": [
              "733480909"
            ]
          },
          "733480909": {
            "id": "733480909",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "你知道海迪夫？",
            "nextDialogs": [
              "733480910"
            ]
          },
          "733480910": {
            "id": "733480910",
            "speakerId": 4002,
            "speakerName": "伊丽丝",
            "text": "当然了，我们这些为经费头疼，又不怎么会赚钱的学者，早就对他的财力广有耳闻了。",
            "nextDialogs": [
              "733480911"
            ]
          },
          "733480911": {
            "id": "733480911",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "呜哇，那…这个海迪夫…他们家族的学者，是不是都特别有钱呀？",
            "nextDialogs": [
              "733480912"
            ]
          },
          "733480912": {
            "id": "733480912",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "那我们是不是可以拿到很多报酬了？",
            "nextDialogs": [
              "733480913"
            ]
          },
          "733480913": {
            "id": "733480913",
            "speakerId": 4002,
            "speakerName": "伊丽丝",
            "text": "才没有呢，海迪夫这家伙是个特例，你可别对普尔比鲁尼和普尔希娜两家的学者产生什么错觉。",
            "nextDialogs": [
              "733480914"
            ]
          },
          "733480914": {
            "id": "733480914",
            "speakerId": 4002,
            "speakerName": "伊丽丝",
            "text": "特别是主修星象学，辅修历史和生物的那一支…就凭这几个研究方向，运气不好连经费都申请不下来。",
            "nextDialogs": [
              "733480915"
            ]
          },
          "733480915": {
            "id": "733480915",
            "speakerId": 4002,
            "speakerName": "伊丽丝",
            "text": "而且他们还说什么「金钱不能作为智慧的报酬」…",
            "nextDialogs": [
              "733480916"
            ]
          },
          "733480916": {
            "id": "733480916",
            "speakerId": 4002,
            "speakerName": "伊丽丝",
            "text": "咳，我好像说太多了…赛达菲就在那边，其他的事你就去问问他吧。"
          }
        }
      }
    },
    {
      "subId": "7334801",
      "subQuestName": "寻找赛达菲",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "733480101"
        ],
        "dialogs": {
          "733480101": {
            "id": "733480101",
            "speakerId": 21043,
            "speakerName": "赛达菲",
            "text": "但是…如果没有那些样本的话…",
            "nextDialogs": [
              "733480104"
            ]
          },
          "733480104": {
            "id": "733480104",
            "speakerId": 21043,
            "speakerName": "赛达菲",
            "text": "是的。我是普尔比鲁尼一门现在的「诃般荼」，请问您找我有什么事？",
            "nextDialogs": [
              "733480105"
            ]
          },
          "733480105": {
            "id": "733480105",
            "speakerId": 21043,
            "speakerName": "赛达菲",
            "text": "是关于学术问题吗？但看您的装束，并不像是教令院里的学者…",
            "nextDialogs": [
              "733480106"
            ]
          },
          "733480106": {
            "id": "733480106",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "关于海迪夫的举荐信…",
            "nextDialogs": [
              "733480107"
            ]
          },
          "733480107": {
            "id": "733480107",
            "speakerId": 21043,
            "speakerName": "赛达菲",
            "text": "这是海迪夫…海迪夫学弟的亲笔信？稍等，容我看一看…",
            "nextDialogs": [
              "733480108"
            ]
          },
          "733480108": {
            "id": "733480108",
            "speakerId": 21043,
            "speakerName": "赛达菲",
            "text": "嗯，看来他在层岩巨渊的研究推进得很顺利。",
            "nextDialogs": [
              "733480109"
            ]
          },
          "733480109": {
            "id": "733480109",
            "speakerId": 21043,
            "speakerName": "赛达菲",
            "text": "…菌类调查…水生环境…古代生物化石…特殊的地质环境…样本…",
            "nextDialogs": [
              "733480110"
            ]
          },
          "733480110": {
            "id": "733480110",
            "speakerId": 21043,
            "speakerName": "赛达菲",
            "text": "很好，很好，很好！他的学术嗅觉和考察能力还是如此优秀，果然没令我失望！",
            "nextDialogs": [
              "733480111"
            ]
          },
          "733480111": {
            "id": "733480111",
            "speakerId": 21043,
            "speakerName": "赛达菲",
            "text": "哼…虽然不是太愿意在外人面前承认，但普尔希娜门人的学术能力，还是值得信任的呀…",
            "nextDialogs": [
              "733480112"
            ]
          },
          "733480112": {
            "id": "733480112",
            "speakerId": 21043,
            "speakerName": "赛达菲",
            "text": "而且，海迪夫在信里也强调了很多次您对他的巨大帮助。",
            "nextDialogs": [
              "733480113"
            ]
          },
          "733480113": {
            "id": "733480113",
            "speakerId": 21043,
            "speakerName": "赛达菲",
            "text": "在您的帮助下，他的研究就如同「猛虎插上了翅膀一样顺利」啊！"
          }
        }
      }
    },
    {
      "subId": "7334802",
      "subQuestName": "寻找赛达菲的箱子",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "733480201"
        ],
        "dialogs": {
          "733480201": {
            "id": "733480201",
            "speakerId": 21044,
            "speakerName": "达拉",
            "text": "等一下！等一下！停手！别打了！",
            "nextDialogs": [
              "733480202"
            ]
          },
          "733480202": {
            "id": "733480202",
            "speakerId": 21044,
            "speakerName": "达拉",
            "text": "呼…呼…就一箱子书，没必要下这么狠的手，你要的话，全都给你。",
            "nextDialogs": [
              "733480205"
            ]
          },
          "733480205": {
            "id": "733480205",
            "speakerId": 21044,
            "speakerName": "达拉",
            "text": "我对天发誓！我们在这里就只挖到了这一个箱子！",
            "nextDialogs": [
              "733480206"
            ]
          },
          "733480206": {
            "id": "733480206",
            "speakerId": 21044,
            "speakerName": "达拉",
            "text": "除了书之外，里面还有一些石头和装在瓶子里的泥巴…石头里面嘛，倒是有些好看的宝石…",
            "nextDialogs": [
              "733480207"
            ]
          },
          "733480207": {
            "id": "733480207",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "你们把这些宝石拿走了吗？",
            "nextDialogs": [
              "733480208"
            ]
          },
          "733480208": {
            "id": "733480208",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "喂！把那些宝石全部还回来！那都是珍贵的地质样本！",
            "nextDialogs": [
              "733480209"
            ]
          },
          "733480209": {
            "id": "733480209",
            "speakerId": 21044,
            "speakerName": "达拉",
            "text": "地质…样本…"
          }
        }
      }
    },
    {
      "subId": "7334807",

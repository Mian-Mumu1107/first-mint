    {
      "subId": "7334805",
      "subQuestName": "向赛达菲回报",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "733480301"
        ],
        "dialogs": {
          "733480301": {
            "id": "733480301",
            "speakerId": 21043,
            "speakerName": "赛达菲",
            "text": "旅行者，您回来了，请问我的箱子…",
            "nextDialogs": [
              "733480304"
            ]
          },
          "733480304": {
            "id": "733480304",
            "speakerId": 21043,
            "speakerName": "赛达菲",
            "text": "太好了！非常感谢您…唉，您拿着举荐信来来访，我却让您如此辛劳，真是太不好意思了…这些摩拉还请您收下。"
          }
        }
      }
    },
    {
      "subId": "7334804",
      "subQuestName": "向海迪夫回报",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "733480401"
        ],
        "dialogs": {
          "733480401": {
            "id": "733480401",
            "speakerId": 2618,
            "speakerName": "海迪夫",
            "text": "欸，你怎么回来了，找到普尔比鲁尼一门的人了吗？应该没费多大劲吧。",
            "nextDialogs": [
              "733480404"
            ]
          },
          "733480404": {
            "id": "733480404",
            "speakerId": 2618,
            "speakerName": "海迪夫",
            "text": "嗯？你怎么一副欲言又止的样子，你不会被人给为难了吧？",
            "nextDialogs": [
              "733480405"
            ]
          },
          "733480405": {
            "id": "733480405",
            "speakerId": 1005,
            "speakerName": "Black Screen",
            "text": "向海迪夫讲述了和赛达菲有关的事…",
            "nextDialogs": [
              "733480406"
            ]
          },
          "733480406": {
            "id": "733480406",
            "speakerId": 2618,
            "speakerName": "海迪夫",
            "text": "赛达菲学长啊…他可是出了名的死心眼，有时候连老师都对付不来他…",
            "nextDialogs": [
              "733480407"
            ]
          },
          "733480407": {
            "id": "733480407",
            "speakerId": 2618,
            "speakerName": "海迪夫",
            "text": "而且还拒绝所有资助，坚持自己研究，说要保持自己研究的纯洁性…",
            "nextDialogs": [
              "733480408"
            ]
          },
          "733480408": {
            "id": "733480408",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "这就是「金钱不能作为智慧的报酬」吗…",
            "nextDialogs": [
              "733480409"
            ]
          },
          "733480409": {
            "id": "733480409",
            "speakerId": 2618,
            "speakerName": "海迪夫",
            "text": "这是他们普尔比鲁尼一门学者的研究原则…哈哈，我们普尔希娜一门没有这么迂腐就是啦。",
            "nextDialogs": [
              "733480410"
            ]
          },
          "733480410": {
            "id": "733480410",
            "speakerId": 2618,
            "speakerName": "海迪夫",
            "text": "唔…也不能这么说，只是我比较有钱而已。"
          }
        }
      }
    },
    {
      "subId": "7334805",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "733480501"
        ],
        "dialogs": {
          "733480501": {
            "id": "733480501",
            "speakerId": 21043,
            "speakerName": "赛达菲",
            "text": "那就拜托您了，我稍后就去准备报酬。"
          }
        }
      }
    },
    {
      "subId": "7334810",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "733481001"
        ],
        "dialogs": {
          "733481001": {
            "id": "733481001",
            "speakerId": 4002,
            "speakerName": "伊丽丝",
            "text": "到底怎么才能把经费申请下来呢…唉…"
          }
        }
      }
    },
    {
      "subId": "7334811",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "733481101"
        ],
        "dialogs": {
          "733481101": {
            "id": "733481101",
            "speakerId": 4086,
            "speakerName": "哈瓦",
            "text": "我还是去休息一下吧。看了太多文献，头都有些晕了…"
          }
        }
      }
    },
    {
      "subId": "7334899",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "733489901"
        ],
        "dialogs": {
          "733489901": {
            "id": "733489901",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "既然来了教令院，那我们…顺便找找海迪夫说的「普尔比鲁尼一门」吧。但是，从哪里开始呢…",
            "nextDialogs": [
              "733489902"
            ]
          },
          "733489902": {
            "id": "733489902",
            "speakerId": 4002,
            "speakerName": "伊丽丝",
            "text": "（不行不行，不能再去尝试交易期货了，再这样赔下去，我连饭都要吃不起了…）",
            "nextDialogs": [
              "733489903"
            ]
          },
          "733489903": {
            "id": "733489903",
            "speakerId": 4086,
            "speakerName": "哈瓦",
            "text": "（这些古文字…彼此交叠…）",
            "nextDialogs": [
              "733489904"
            ]
          },
          "733489904": {
            "id": "733489904",
            "speakerId": 21043,
            "speakerName": "赛达菲",
            "text": "（海迪夫…好像是普尔希娜那边的来着？这位旅行者怎么会有他的亲笔信…）",
            "nextDialogs": [
              "733489905"
            ]
          },
          "733489905": {
            "id": "733489905",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "唔，应该就在这附近了。我们…开始挖吧…",
            "nextDialogs": [
              "733489906"
            ]
          },
          "733489906": {
            "id": "733489906",
            "speakerId": 21043,
            "speakerName": "赛达菲",
            "text": "（太好了，没有被破坏太多…）",
            "nextDialogs": [
              "733489907"
            ]
          },
          "733489907": {
            "id": "733489907",
            "speakerId": 21043,
            "speakerName": "赛达菲",
            "text": "（如果没有那些样本的话…）"
          }
        }
      }
    }
  ]
}
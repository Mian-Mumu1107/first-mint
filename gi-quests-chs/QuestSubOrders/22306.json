            "id": "223060401",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "不用了。",
            "nextDialogs": [
              "223060402"
            ]
          },
          "223060402": {
            "id": "223060402",
            "speakerId": 1001,
            "speakerName": "博来",
            "text": "那也行，都凭您自己的主意。",
            "nextDialogs": [
              "223060403"
            ]
          },
          "223060403": {
            "id": "223060403",
            "speakerId": 1001,
            "speakerName": "博来",
            "text": "您走好，拿到宝藏之后，记得拿回来我们一起分啊。"
          }
        }
      }

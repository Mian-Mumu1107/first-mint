    {
      "subId": "2230641",
      "subQuestName": "",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "223060201"
        ],
        "dialogs": {
          "223060201": {
            "id": "223060201",
            "speakerId": 1001,
            "speakerName": "博来",
            "text": "喂，朋友，货要不要？",
            "nextDialogs": [
              "223060202"
            ]
          },
          "223060202": {
            "id": "223060202",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "要藏宝图。",
            "nextDialogs": [
              "223060203"
            ]
          },
          "223060203": {
            "id": "223060203",
            "speakerId": 1001,
            "speakerName": "博来",
            "text": "藏宝图？哦…你是说张顺押在我这的那些是吧。",
            "nextDialogs": [
              "223060204"
            ]
          },
          "223060204": {
            "id": "223060204",
            "speakerId": 1001,
            "speakerName": "博来",
            "text": "嚯，你还真想去看看藏着什么宝贝？我还是权当收着玩玩呢…",
            "nextDialogs": [
              "223060205"
            ]
          },
          "223060205": {
            "id": "223060205",
            "speakerId": 1001,
            "speakerName": "博来",
            "text": "一看你就是个实打实的冒险家，听见宝藏两个字眼睛都在放光。",
            "nextDialogs": [
              "223060206"
            ]
          },
          "223060206": {
            "id": "223060206",
            "speakerId": 1001,
            "speakerName": "博来",
            "text": "反正这些藏宝图我要了也没用，给你也没关系。",
            "nextDialogs": [
              "223060207"
            ]
          },
          "223060207": {
            "id": "223060207",
            "speakerId": 1001,
            "speakerName": "博来",
            "text": "不过，你要是真找到了宝贝，咱们得匀一匀。",
            "nextDialogs": [
              "223060208"
            ]
          },
          "223060208": {
            "id": "223060208",
            "speakerId": 1001,
            "speakerName": "博来",
            "text": "毕竟这藏宝图在我这放了这么久，仓储费那也得付点不是…"
          }
        }
      }
    },

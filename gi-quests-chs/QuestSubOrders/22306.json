    {
      "subId": "2230605",
      "subQuestName": "与博来对话",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "223060601"
        ],
        "dialogs": {
          "223060601": {
            "id": "223060601",
            "speakerId": 1001,
            "speakerName": "博来",
            "text": "您回来了，宝藏找着了吗？",
            "nextDialogs": [
              "223060602"
            ]
          },
          "223060602": {
            "id": "223060602",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "找到了。",
            "nextDialogs": [
              "223060603"
            ]
          },
          "223060603": {
            "id": "223060603",
            "speakerId": 1001,
            "speakerName": "博来",
            "text": "不愧是实打实的冒险家，手脚这个麻利。",
            "nextDialogs": [
              "223060604"
            ]
          },
          "223060604": {
            "id": "223060604",
            "speakerId": 1001,
            "speakerName": "博来",
            "text": "那行，我看看啊，这个盒子…哼，没啥用的东西…",
            "nextDialogs": [
              "223060605"
            ]
          },
          "223060605": {
            "id": "223060605",
            "speakerId": 1001,
            "speakerName": "博来",
            "text": "不过还是辛苦你了，这份是您的，张顺的那份我留着，等他过来拿。",
            "nextDialogs": [
              "223060606"
            ]
          },
          "223060606": {
            "id": "223060606",
            "speakerId": 1001,
            "speakerName": "博来",
            "text": "唉，还是没找着，那群家伙别是把我给蒙了吧…"
          }
        }
      }
    },
    {
      "subId": "2230605",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "223060501"
        ],
        "dialogs": {
          "223060501": {
            "id": "223060501",
            "speakerId": 1000,
            "speakerName": "张顺",
            "text": "要是没受伤…肯定能和大姐头一起，找到更多宝藏吧…",
            "nextDialogs": [
              "223060502"
            ]
          },
          "223060502": {
            "id": "223060502",
            "speakerId": 1000,
            "speakerName": "张顺",
            "text": "唉，真想再去船上看看…"
          }
        }
      }
    },
    {
      "subId": "2230607",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "223060701"
        ],
        "dialogs": {
          "223060701": {
            "id": "223060701",
            "speakerId": 1001,
            "speakerName": "博来",
            "text": "您真不需要？就是一点小小的消息…"
          }
        }
      }
    },
    {
      "subId": "2230609",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "223060901"
        ],
        "dialogs": {
          "223060901": {
            "id": "223060901",
            "speakerId": 1001,
            "speakerName": "博来",
            "text": "您回来了，宝藏找着了吗？",
            "nextDialogs": [
              "223060902"
            ]
          },
          "223060902": {
            "id": "223060902",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "找到了。",
            "nextDialogs": [
              "223060903"
            ]
          },
          "223060903": {
            "id": "223060903",
            "speakerId": 1001,
            "speakerName": "博来",
            "text": "不愧是实打实的冒险家，手脚这个麻利。",
            "nextDialogs": [
              "223060904"
            ]
          },
          "223060904": {
            "id": "223060904",
            "speakerId": 1001,
            "speakerName": "博来",
            "text": "那行，我看看啊，这个盒子…这是什么，地图的残片？",
            "nextDialogs": [
              "223060905"
            ]
          },
          "223060905": {
            "id": "223060905",
            "speakerId": 1001,
            "speakerName": "博来",
            "text": "那群家伙说的居然是真的，在那些破烂藏宝图里面，藏着真宝藏的线索…",
            "nextDialogs": [
              "223060906"
            ]
          },
          "223060906": {
            "id": "223060906",
            "speakerId": 1001,
            "speakerName": "博来",
            "text": "咦？您怎么还在这，这份是您的，您…您赶紧忙您的去吧，张顺那一份我留着等他来拿。"
          }
        }
      }
    }
  ]

    {
      "subId": "1112206",
      "subQuestName": "救下被围攻的学者",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [],
        "dialogs": {}
      }
    },
    {
      "subId": "1112207",
      "subQuestName": "与学者对话",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "111220701"
        ],
        "dialogs": {
          "111220701": {
            "id": "111220701",
            "speakerId": 10395,
            "speakerName": "琬玉",
            "text": "这些怪物太暴躁了，只是走过都会被它们发现，二话不说就往人身上扑…多亏各位救了我，谢谢。",
            "nextDialogs": [
              "111220702"
            ]
          },
          "111220702": {
            "id": "111220702",
            "speakerId": 10395,
            "speakerName": "琬玉",
            "text": "我叫琬玉，隶属于璃月盛露厅，负责人文古迹的研究工作。",
            "nextDialogs": [
              "111220703"
            ]
          },
          "111220703": {
            "id": "111220703",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "哎呀？不是矿工…",
            "nextDialogs": [
              "111220704"
            ]
          },
          "111220704": {
            "id": "111220704",
            "speakerId": 10395,
            "speakerName": "琬玉",
            "text": "矿工？",
            "nextDialogs": [
              "111220705"
            ]
          },
          "111220705": {
            "id": "111220705",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "嗯，我们在找矿工，一共四个！都是个子高高大大的男性，带着采矿工具。",
            "nextDialogs": [
              "111220706"
            ]
          },
          "111220706": {
            "id": "111220706",
            "speakerId": 10395,
            "speakerName": "琬玉",
            "text": "你说的人，我好像见过。",
            "nextDialogs": [
              "111220707"
            ]
          },
          "111220707": {
            "id": "111220707",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "真的吗？",
            "nextDialogs": [
              "111220708"
            ]
          },
          "111220708": {
            "id": "111220708",
            "speakerId": 10395,
            "speakerName": "琬玉",
            "text": "对，我是前天从南天门出发的，要往灵矩关方向去。半路上遇到一队人，是一个小孩和几个大人。",
            "nextDialogs": [
              "111220709"
            ]
          },
          "111220709": {
            "id": "111220709",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "能说得详细一点吗？",
            "nextDialogs": [
              "111220710"
            ]
          },
          "111220710": {
            "id": "111220710",
            "speakerId": 10395,
            "speakerName": "琬玉",
            "text": "我走得比较急，没能细看。面貌特征什么的都记不清了…抱歉。",
            "nextDialogs": [
              "111220711"
            ]
          },
          "111220711": {
            "id": "111220711",
            "speakerId": 10232,
            "speakerName": "钟离",
            "text": "这些就足够了，谢谢你。",
            "nextDialogs": [
              "111220712"
            ]
          },
          "111220712": {
            "id": "111220712",
            "speakerId": 10395,
            "speakerName": "琬玉",
            "text": "能帮上忙就好。",
            "nextDialogs": [
              "111220713"
            ]
          },
          "111220713": {
            "id": "111220713",
            "speakerId": 10395,
            "speakerName": "琬玉",
            "text": "那我就先走一步了，还有学术会议要参加，再次感谢几位。",
            "nextDialogs": [
              "111220714"
            ]
          },
          "111220714": {
            "id": "111220714",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "根据那位学者的说法，这些人应该是往南天门方向去了。",
            "nextDialogs": [
              "111220715"
            ]
          },
          "111220715": {
            "id": "111220715",
            "speakerId": 10376,
            "speakerName": "昆钧",
            "text": "不过，能确定是同一批人吗？",
            "nextDialogs": [
              "111220716"
            ]
          },
          "111220716": {
            "id": "111220716",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "小孩跟大人的组合，没那么常见吧！",
            "nextDialogs": [
              "111220717"
            ]
          },
          "111220717": {
            "id": "111220717",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "还是挺常见的。",
            "nextDialogs": [
              "111220718"
            ]
          },
          "111220718": {
            "id": "111220718",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "呃…那、那…",
            "nextDialogs": [
              "111220719"
            ]
          },
          "111220719": {
            "id": "111220719",
            "speakerId": 10376,
            "speakerName": "昆钧",
            "text": "喂，你们看那边那块石头！",
            "nextDialogs": [
              "111220720"
            ]
          },
          "111220720": {
            "id": "111220720",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "哦哦，还有这一招呀！",
            "nextDialogs": [
              "111220721"
            ]
          },
          "111220721": {
            "id": "111220721",
            "speakerId": 10376,
            "speakerName": "昆钧",
            "text": "应该能用，我来试试。",
            "nextDialogs": [
              "111220722"
            ]
          },
          "111220722": {
            "id": "111220722",
            "speakerId": 10376,
            "speakerName": "昆钧",
            "text": "唔。",
            "nextDialogs": [
              "111220723"
            ]
          },
          "111220723": {
            "id": "111220723",
            "speakerId": 10376,
            "speakerName": "昆钧",
            "text": "……",
            "nextDialogs": [
              "111220724"
            ]
          },
          "111220724": {
            "id": "111220724",
            "speakerId": 10376,
            "speakerName": "昆钧",
            "text": "没错，是同一批人。他们沿着这条路走过去了。",
            "nextDialogs": [
              "111220725"
            ]
          },
          "111220725": {
            "id": "111220725",
            "speakerId": 10232,
            "speakerName": "钟离",
            "text": "昆兄读取石块回忆的场面，无论看几次都觉得有趣。",
            "nextDialogs": [
              "111220726"
            ]
          },
          "111220726": {
            "id": "111220726",
            "speakerId": 10376,
            "speakerName": "昆钧",
            "text": "这所谓的本事，平时还真用不上。能让钟离先生消遣，也算有些意义。",
            "nextDialogs": [
              "111220727"
            ]
          },
          "111220727": {
            "id": "111220727",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "小昆简直是我们的指南针！有你在，才好确定方向呀。",
            "nextDialogs": [
              "111220728"
            ]
          },
          "111220728": {
            "id": "111220728",
            "speakerId": 10376,
            "speakerName": "昆钧",
            "text": "哈哈哈哈，是吗？那我也就不枉来此一遭了。",
            "nextDialogs": [
              "111220729"
            ]
          },
          "111220729": {
            "id": "111220729",
            "speakerId": 10376,
            "speakerName": "昆钧",
            "text": "嗯，这感觉…像在办案一样，好有意思。",
            "nextDialogs": [
              "111220730"
            ]
          },
          "111220730": {
            "id": "111220730",
            "speakerId": 10232,
            "speakerName": "钟离",
            "text": "有趣之余，别忘了保持警惕。",
            "nextDialogs": [
              "111220731"
            ]
          },
          "111220731": {
            "id": "111220731",
            "speakerId": 10232,
            "speakerName": "钟离",
            "text": "四名成年人面容呆滞地跟着一个孩童日夜赶路，翻山越岭…此事绝不简单。",
            "nextDialogs": [
              "111220732"
            ]
          },
          "111220732": {
            "id": "111220732",
            "speakerId": 10376,
            "speakerName": "昆钧",
            "text": "噢噢！说得也是，钟离先生当真谨慎。",
            "nextDialogs": [
              "111220733"
            ]
          },
          "111220733": {
            "id": "111220733",
            "speakerId": 10232,
            "speakerName": "钟离",
            "text": "另外，刚才那位学者是被幼岩龙蜥袭击了，但这种怪物不该有这么强的攻击性才对。",
            "nextDialogs": [
              "111220734"
            ]
          },
          "111220734": {
            "id": "111220734",
            "speakerId": 10232,
            "speakerName": "钟离",
            "text": "一路走来诸多线索，冥冥之中似乎都有联系…",
            "nextDialogs": [
              "111220735"
            ]
          },
          "111220735": {
            "id": "111220735",
            "speakerId": 10232,
            "speakerName": "钟离",
            "text": "工人们是前天往南天门方向去的。从这里过去，要经过一段艰险的山路。假如他们的目的地就是南天门，我们应该还能赶上。",
            "nextDialogs": [
              "111220736"
            ]
          },
          "111220736": {
            "id": "111220736",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "嗯，马上出发吧！",
            "nextDialogs": [
              "111220737"
            ]
          },
          "111220737": {
            "id": "111220737",
            "speakerId": 10232,
            "speakerName": "钟离",
            "text": "方才我在附近做了记号，万一老戴追来，也能循着记号找到我们。",
            "nextDialogs": [
              "111220738"
            ]
          },
          "111220738": {
            "id": "111220738",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "不愧是钟离！"
          }
        }
      }
    },
    {
      "subId": "1112212",

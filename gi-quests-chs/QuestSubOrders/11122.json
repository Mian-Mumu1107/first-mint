  "subQuests": [
    {
      "subId": "1112201",
      "subQuestName": "前往灵矩关一带调查线索",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "111229901"
        ],
        "dialogs": {
          "111229901": {
            "id": "111229901",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "等等，地上有线索！",
            "nextDialogs": [
              "111229902"
            ]
          },
          "111229902": {
            "id": "111229902",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "一定是那些矿工留下的！",
            "nextDialogs": [
              "111229903"
            ]
          },
          "111229903": {
            "id": "111229903",
            "speakerId": 10232,
            "speakerName": "钟离",
            "text": "我们到灵矩关出口去。如果那里没有脚印，就说明他们还在灵矩关内，如果有新线索，就继续追查。"
          }
        }
      }
    },
    {
      "subId": "1112202",
      "subQuestName": "在附近寻找更多线索",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "111220201"
        ],
        "dialogs": {
          "111220201": {
            "id": "111220201",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "呀，脚印！",
            "nextDialogs": [
              "111220202"
            ]
          },
          "111220202": {
            "id": "111220202",
            "speakerId": 10232,
            "speakerName": "钟离",
            "text": "看来他们穿过了灵矩关，继续向前步行。",
            "nextDialogs": [
              "111220203"
            ]
          },
          "111220203": {
            "id": "111220203",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "跟着脚印就能找到他们的去处了，对吧？"
          }
        }
      }
    },
    {
      "subId": "1112203",
      "subQuestName": "跟着脚印继续追踪",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [],
        "dialogs": {}
      }
    },
    {
      "subId": "1112210",
      "subQuestName": "向附近的人们打听情报",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "111220401"
        ],
        "dialogs": {
          "111220401": {
            "id": "111220401",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "请问你在这附近见过矿工打扮的人吗？",
            "nextDialogs": [
              "111220402"
            ]
          },
          "111220402": {
            "id": "111220402",
            "speakerId": 10381,
            "speakerName": "小玲",
            "text": "大约是四五天前吧，有几个人从这里走过，背着篓子，提着铁镐什么的…和你说的差不多。",
            "nextDialogs": [
              "111220403"
            ]
          },
          "111220403": {
            "id": "111220403",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "对对，就是他们！",
            "nextDialogs": [
              "111220404"
            ]
          },
          "111220404": {
            "id": "111220404",
            "speakerId": 10232,
            "speakerName": "钟离",
            "text": "四五天前？看来他们走得远不如我们想象中快，恐怕是被灵矩关的地形耗去了不少时间。",
            "nextDialogs": [
              "111220405"
            ]
          },
          "111220405": {
            "id": "111220405",
            "speakerId": 10381,
            "speakerName": "小玲",
            "text": "哎呀，那些人可奇怪了，四个大男人，个个面色呆滞，都像没睡醒一样！前面还有个小孩，晃晃悠悠的…",
            "nextDialogs": [
              "111220406"
            ]
          },
          "111220406": {
            "id": "111220406",
            "speakerId": 10232,
            "speakerName": "钟离",
            "text": "你看清那个小孩的模样了吗？",
            "nextDialogs": [
              "111220407"
            ]
          },
          "111220407": {
            "id": "111220407",
            "speakerId": 10381,
            "speakerName": "小玲",
            "text": "只扫了一眼，蓝色头发，个子很矮，好像…好像是个女孩儿！还有，她表情也很严肃，一点笑意都没有。",
            "nextDialogs": [
              "111220408"
            ]
          },
          "111220408": {
            "id": "111220408",
            "speakerId": 10232,
            "speakerName": "钟离",
            "text": "他们走的是这条路吗？",
            "nextDialogs": [
              "111220409"
            ]
          },
          "111220409": {
            "id": "111220409",
            "speakerId": 10381,
            "speakerName": "小玲",
            "text": "是啊，从这儿一直往前走了。",
            "nextDialogs": [
              "111220410"
            ]
          },
          "111220410": {
            "id": "111220410",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "我们追吧！"
          }
        }
      }
    },

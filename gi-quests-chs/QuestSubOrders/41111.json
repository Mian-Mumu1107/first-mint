    {
      "subId": "4111105",
      "subQuestName": "(test)自动触发与菲谢尔对话（隐藏）$HIDDEN",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "411110501"
        ],
        "dialogs": {
          "411110501": {
            "id": "411110501",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "这里就是凯瑟琳所说离蒙德最近的事发地点，清泉镇。",
            "nextDialogs": [
              "411110502"
            ]
          },
          "411110502": {
            "id": "411110502",
            "speakerId": 1003,
            "speakerName": "奥兹",
            "text": "看来，情况比预想还严重。",
            "nextDialogs": [
              "411110503"
            ]
          },
          "411110503": {
            "id": "411110503",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "许多人倒下了。",
            "nextDialogs": [
              "411110504"
            ]
          },
          "411110504": {
            "id": "411110504",
            "speakerId": 1002,
            "speakerName": "菲谢尔",
            "text": "祝圣之钟当鸣！断罪之时已至！赞颂吧，呼唤救赎的人，只因「断罪皇女」降临此间！",
            "nextDialogs": [
              "411110505"
            ]
          },
          "411110505": {
            "id": "411110505",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "这位皇女还真是有干劲啊！"
          }
        }
      }
    },
    {
      "subId": "4111106",
      "subQuestName": "调查附近的病患（0/3）",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "411110601"
        ],
        "dialogs": {
          "411110601": {
            "id": "411110601",
            "speakerId": 1002,
            "speakerName": "菲谢尔",
            "text": "凡人，本皇女恩许你免却礼节，就这样将机要线索悉数禀报吧。",
            "nextDialogs": [
              "411110602"
            ]
          },
          "411110602": {
            "id": "411110602",
            "speakerId": 1004,
            "speakerName": "乔伊斯",
            "text": "哎？你是？",
            "nextDialogs": [
              "411110603"
            ]
          },
          "411110603": {
            "id": "411110603",
            "speakerId": 1003,
            "speakerName": "奥兹",
            "text": "无意冒犯，先生。只是想请您透露一些有关病患的信息。",
            "nextDialogs": [
              "411110604"
            ]
          },
          "411110604": {
            "id": "411110604",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "啊啊请不要误会！我们是冒险家协会成员，受委托前来调查情况的！",
            "nextDialogs": [
              "411110605"
            ]
          },
          "411110605": {
            "id": "411110605",
            "speakerId": 1004,
            "speakerName": "乔伊斯",
            "text": "噢，好的。昨天晚上，这个人摸了地上的陨石，很快便昏睡过去。",
            "nextDialogs": [
              "411110606"
            ]
          },
          "411110606": {
            "id": "411110606",
            "speakerId": 1004,
            "speakerName": "乔伊斯",
            "text": "所以，你们调查时千万不能直接触碰陨石。",
            "nextDialogs": [
              "411110607"
            ]
          },
          "411110607": {
            "id": "411110607",
            "speakerId": 1002,
            "speakerName": "菲谢尔",
            "text": "粗莽的进谏。本皇女自有渊色秘珠秘法加护，区区黑晶可奈我何？",
            "nextDialogs": [
              "411110608"
            ]
          },
          "411110608": {
            "id": "411110608",
            "speakerId": 1003,
            "speakerName": "奥兹",
            "text": "不不，小姐，您是皇女，有必要听取正确的谏言。",
            "nextDialogs": [
              "411110609"
            ]
          },
          "411110609": {
            "id": "411110609",
            "speakerId": 1002,
            "speakerName": "菲谢尔",
            "text": "是吗…看来只能照办了。",
            "nextDialogs": [
              "411110610"
            ]
          },
          "411110610": {
            "id": "411110610",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "#{NICKNAME}，您是…您是冒险家，有必要听取正确的谏言！",
            "nextDialogs": [
              "411110611"
            ]
          },
          "411110611": {
            "id": "411110611",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "好、好吧。",
            "nextDialogs": [
              "411110612"
            ]
          },
          "411110612": {
            "id": "411110612",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "难得说说这种话，感觉还不错呢！",
            "nextDialogs": [
              "411110613"
            ]
          },
          "411110613": {
            "id": "411110613",
            "speakerId": 1002,
            "speakerName": "菲谢尔",
            "text": "是在模仿本皇女吗？哼，一千世界寂灭的悲愿岂是凡人所能领会！",
            "nextDialogs": [
              "411110614"
            ]
          },
          "411110614": {
            "id": "411110614",
            "speakerId": 1002,
            "speakerName": "菲谢尔",
            "text": "不过也好。毕竟对你而言，「断罪皇女」的命运还是太过沉重了。",
            "nextDialogs": [
              "411110615"
            ]
          },
          "411110615": {
            "id": "411110615",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "请、请皇女移驾。"
          }
        }
      }
    },
    {
      "subId": "4111115",
      "subQuestName": "调查附近的病患（1/3）",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "411111501"
        ],
        "dialogs": {
          "411111501": {
            "id": "411111501",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "这里也有人倒下了！",
            "nextDialogs": [
              "411111502"
            ]
          },
          "411111502": {
            "id": "411111502",
            "speakerId": 1002,
            "speakerName": "菲谢尔",
            "text": "骑士，请回应本皇女的询查。这个不幸之人情况如何？",
            "nextDialogs": [
              "411111503"
            ]
          },
          "411111503": {
            "id": "411111503",
            "speakerId": 1005,
            "speakerName": "阿德勒",
            "text": "呃，他…他已经睡了一整天，还没有醒来的迹象。",
            "nextDialogs": [
              "411111505",
              "411111507"
            ]
          },
          "411111505": {
            "id": "411111505",
            "speakerId": 1005,
            "speakerName": "阿德勒",
            "text": "是的。睡得很沉，还有梦话。",
            "nextDialogs": [
              "411111508"
            ]
          },
          "411111508": {
            "id": "411111508",
            "speakerId": 1006,
            "speakerName": "昏睡的病患",
            "text": "走不动了…真的，休息一会儿吧…",
            "nextDialogs": [
              "411111509"
            ]
          },
          "411111509": {
            "id": "411111509",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "他…他这是在干什么呀…",
            "nextDialogs": [
              "411111510"
            ]
          },
          "411111510": {
            "id": "411111510",
            "speakerId": 1002,
            "speakerName": "菲谢尔",
            "text": "黑暗之梦正如同衔着艾登果实的凶兽，它夤夜般深黑的双目会使弱小之辈坠入深渊…",
            "nextDialogs": [
              "411111511"
            ]
          },
          "411111511": {
            "id": "411111511",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "意思是，梦中有什么东西在引诱他？",
            "nextDialogs": [
              "411111512"
            ]
          },
          "411111512": {
            "id": "411111512",
            "speakerId": 1003,
            "speakerName": "奥兹",
            "text": "虽然还没有证据，但皇女的直觉一向准确。",
            "nextDialogs": [
              "411111513"
            ]
          },
          "411111513": {
            "id": "411111513",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "唔…还是再打听一下吧！"
          },
          "411111507": {
            "id": "411111507",
            "speakerId": 1005,
            "speakerName": "阿德勒",
            "text": "暂时没有。不过，他偶尔会说梦话。"
          }
        }
      }
    },
    {
      "subId": "4111116",
      "subQuestName": "调查附近的病患（2/3）",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "411111601"
        ],
        "dialogs": {
          "411111601": {
            "id": "411111601",
            "speakerId": 1007,
            "speakerName": "艾德娜",
            "text": "你们好，我是负责看护工作的修女艾德娜。",
            "nextDialogs": [
              "411111602"
            ]
          },
          "411111602": {
            "id": "411111602",
            "speakerId": 1002,
            "speakerName": "菲谢尔",
            "text": "报上名来，梦魇的狂徒。",
            "nextDialogs": [
              "411111603"
            ]
          },
          "411111603": {
            "id": "411111603",
            "speakerId": 1003,
            "speakerName": "奥兹",
            "text": "抱歉，不是说您。地上这位先生有说过什么话吗？",
            "nextDialogs": [
              "411111604"
            ]
          },
          "411111604": {
            "id": "411111604",
            "speakerId": 1007,
            "speakerName": "艾德娜",
            "text": "似乎有说过要回去工作什么的…",
            "nextDialogs": [
              "411111605"
            ]
          },
          "411111605": {
            "id": "411111605",
            "speakerId": 1008,
            "speakerName": "哈特曼",
            "text": "啊…酒，酒还…",
            "nextDialogs": [
              "411111606"
            ]
          },
          "411111606": {
            "id": "411111606",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "是与酒有关的工人吗？",
            "nextDialogs": [
              "411111607"
            ]
          },
          "411111607": {
            "id": "411111607",
            "speakerId": 1003,
            "speakerName": "奥兹",
            "text": "他看起来睡得很沉。",
            "nextDialogs": [
              "411111608"
            ]
          },
          "411111608": {
            "id": "411111608",
            "speakerId": 1002,
            "speakerName": "菲谢尔",
            "text": "这不是一般的梦…是诅咒！",
            "nextDialogs": [
              "411111609"
            ]
          },
          "411111609": {
            "id": "411111609",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "能叫醒他吗？",
            "nextDialogs": [
              "411111610"
            ]
          },
          "411111610": {
            "id": "411111610",
            "speakerId": 1007,
            "speakerName": "艾德娜",
            "text": "我试过。他短暂地醒来过一会儿，可没多久又睡着了。",
            "nextDialogs": [
              "411111611"
            ]
          },
          "411111611": {
            "id": "411111611",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "醒来后他有没有透露什么信息？",
            "nextDialogs": [
              "411111612"
            ]
          },
          "411111612": {
            "id": "411111612",
            "speakerId": 1007,
            "speakerName": "艾德娜",
            "text": "他说梦见自己在山上，觉得很冷。",
            "nextDialogs": [
              "411111613"
            ]
          },
          "411111613": {
            "id": "411111613",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "山上？冷？嗯…？",
            "nextDialogs": [
              "411111614"
            ]
          },
          "411111614": {
            "id": "411111614",
            "speakerId": 1002,
            "speakerName": "菲谢尔",
            "text": "莫非是雪山之恶魔的冷冽诅咒…泉水精灵守护的清泉小镇，也终于成为被恶魔盯上的土地了吗？",
            "nextDialogs": [
              "411111615"
            ]
          },
          "411111615": {
            "id": "411111615",
            "speakerId": 1002,
            "speakerName": "菲谢尔",
            "text": "真是棘手的事态，但无妨，只要由我断罪…",
            "nextDialogs": [
              "411111616"
            ]
          },
          "411111616": {
            "id": "411111616",
            "speakerId": 1009,
            "speakerName": "杜拉夫",
            "text": "抱歉打扰各位，你们现在有空吗？",
            "nextDialogs": [
              "411111617"
            ]
          },
          "411111617": {
            "id": "411111617",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "是杜拉夫先生！出什么事了吗？",
            "nextDialogs": [
              "411111618"
            ]
          },
          "411111618": {
            "id": "411111618",
            "speakerId": 1009,
            "speakerName": "杜拉夫",
            "text": "呃，真是不好开口啊…",
            "nextDialogs": [
              "411111619"
            ]
          },
          "411111619": {
            "id": "411111619",
            "speakerId": 1009,
            "speakerName": "杜拉夫",
            "text": "我们这儿的<color=#00E1FFFF>后山</color>上也有<color=#00E1FFFF>陨石</color>，村里那个<color=#00E1FFFF>艾伦</color>，吵着要去见识一下，一个人就冲出去了。",
            "nextDialogs": [
              "411111620"
            ]
          },
          "411111620": {
            "id": "411111620",
            "speakerId": 1009,
            "speakerName": "杜拉夫",
            "text": "陨石的危险性你们也看到了，我担心他出什么意外，想请各位跟我走一趟，把他接回来。",
            "nextDialogs": [
              "411111621"
            ]
          },
          "411111621": {
            "id": "411111621",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "都这么危险了，他还去凑什么热闹呀！",
            "nextDialogs": [
              "411111622"
            ]
          },
          "411111622": {
            "id": "411111622",
            "speakerId": 1009,
            "speakerName": "杜拉夫",
            "text": "就是！等这小子回来，一定要狠狠骂他一顿！",
            "nextDialogs": [
              "411111623"
            ]
          },
          "411111623": {
            "id": "411111623",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "说得对，那我们现在就去找他吧！"
          }
        }
      }
    },
    {
      "subId": "4111107",
      "subQuestName": "前往后山寻找艾伦",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [],
        "dialogs": {}
      }
    },
    {
      "subId": "4111102",
      "subQuestName": "解救被怪物围攻的艾伦",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [],
        "dialogs": {}
      }
    },
    {
      "subId": "4111117",
      "subQuestName": "(test)与伤员对话（隐藏）$HIDDEN",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "411111701"
        ],
        "dialogs": {
          "411111701": {
            "id": "411111701",
            "speakerId": 1010,
            "speakerName": "艾伦",
            "text": "啊！我还以为我会死在那里！",
            "nextDialogs": [
              "411111702"
            ]
          },
          "411111702": {
            "id": "411111702",
            "speakerId": 1009,
            "speakerName": "杜拉夫",
            "text": "臭小子！非常时期，还敢惹麻烦！",
            "nextDialogs": [
              "411111703"
            ]
          },
          "411111703": {
            "id": "411111703",
            "speakerId": 1010,
            "speakerName": "艾伦",
            "text": "我错了，我再也不敢了！",
            "nextDialogs": [
              "411111704"
            ]
          },
          "411111704": {
            "id": "411111704",
            "speakerId": 1009,
            "speakerName": "杜拉夫",
            "text": "实在是非常抱歉，我一定好好教训他！",
            "nextDialogs": [
              "411111705"
            ]
          },
          "411111705": {
            "id": "411111705",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "下次可别乱跑了哦！",
            "nextDialogs": [
              "411111706"
            ]
          },
          "411111706": {
            "id": "411111706",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "陨石就在那边。",
            "nextDialogs": [
              "411111707"
            ]
          },
          "411111707": {
            "id": "411111707",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "我去看看有什么…咦？皇女，你的<color=#00E1FFFF>神之眼</color>在<color=#00E1FFFF>闪</color>哦！",
            "nextDialogs": [
              "411111708"
            ]
          },
          "411111708": {
            "id": "411111708",
            "speakerId": 1002,
            "speakerName": "菲谢尔",
            "text": "咦？难道说，冷冽诅咒已经意识到，这渊色秘珠里流淌的能量，正在奏响它命运的挽歌？",
            "nextDialogs": [
              "411111709"
            ]
          },
          "411111709": {
            "id": "411111709",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "唔，神之眼会对什么东西起反应吗？",
            "nextDialogs": [
              "411111710"
            ]
          },
          "411111710": {
            "id": "411111710",
            "speakerId": 1002,
            "speakerName": "菲谢尔",
            "text": "世界的幽邃，群星的低语。魔骸的诅咒，还有…",
            "nextDialogs": [
              "411111711"
            ]
          },
          "411111711": {
            "id": "411111711",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "都是些什么呀！你说话真的很难懂！",
            "nextDialogs": [
              "411111712"
            ]
          },
          "411111712": {
            "id": "411111712",
            "speakerId": 1003,
            "speakerName": "奥兹",
            "text": "失礼了，皇女对凡人的语言并不熟悉。",
            "nextDialogs": [
              "411111713"
            ]
          },
          "411111713": {
            "id": "411111713",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "所以才要靠你翻译吗？",
            "nextDialogs": [
              "411111714"
            ]
          },
          "411111714": {
            "id": "411111714",
            "speakerId": 1003,
            "speakerName": "奥兹",
            "text": "在下惶恐，这不是翻译，只是代传皇女的意旨。我想周遭会对<color=#00E1FFFF>神之眼</color>造成影响的，恐怕只有<color=#00E1FFFF>元素力</color>。",
            "nextDialogs": [
              "411111715"
            ]
          },
          "411111715": {
            "id": "411111715",
            "speakerId": 1002,
            "speakerName": "菲谢尔",
            "text": "嗯，辛苦你了，奥兹。被尘世凡俗掩没双眼之人，总是无法像你这样，第一时间领会本皇女的真意…",
            "nextDialogs": [
              "411111716"
            ]
          },
          "411111716": {
            "id": "411111716",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "陨石中含有元素力？神之眼会发光，是在回应元素力的呼唤吗？",
            "nextDialogs": [
              "411111719"
            ]
          },
          "411111719": {
            "id": "411111719",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "感觉…也许可以？要不我们就先试试，能不能利用<color=#00E1FFFF>神之眼</color>来搜索<color=#00E1FFFF>陨石碎片</color>、清理危害吧？"
          }
        }
      }
    },

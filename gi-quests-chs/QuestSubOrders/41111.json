  "subQuests": [
    {
      "subId": "4111101",
      "subQuestName": "前往蒙德冒险家协会找凯瑟琳",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "411110101"
        ],
        "dialogs": {
          "411110101": {
            "id": "411110101",
            "speakerId": 1000,
            "speakerName": "凯瑟琳",
            "text": "旅行者，你来得正好。",
            "nextDialogs": [
              "411110102"
            ]
          },
          "411110102": {
            "id": "411110102",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "凯瑟琳，出什么事了吗？",
            "nextDialogs": [
              "411110103"
            ]
          },
          "411110103": {
            "id": "411110103",
            "speakerId": 1000,
            "speakerName": "凯瑟琳",
            "text": "是的，发生了一件不得不请冒险家们出手相助的大事。",
            "nextDialogs": [
              "411110104"
            ]
          },
          "411110104": {
            "id": "411110104",
            "speakerId": 1000,
            "speakerName": "凯瑟琳",
            "text": "有非常紧急的任务要委托给你，旅行者。",
            "nextDialogs": [
              "411110142"
            ]
          },
          "411110142": {
            "id": "411110142",
            "speakerId": 1000,
            "speakerName": "凯瑟琳",
            "text": "(test)陨石坠落Cutscene",
            "nextDialogs": [
              "411110105"
            ]
          },
          "411110105": {
            "id": "411110105",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "呜哇…听起来很严重的样子…",
            "nextDialogs": [
              "411110106"
            ]
          },
          "411110106": {
            "id": "411110106",
            "speakerId": 1000,
            "speakerName": "凯瑟琳",
            "text": "实不相瞒，我们也是第一次遇到这种事。",
            "nextDialogs": [
              "411110107"
            ]
          },
          "411110107": {
            "id": "411110107",
            "speakerId": 1000,
            "speakerName": "凯瑟琳",
            "text": "协会里忙得不可开交，也要靠各位在外游历的冒险家齐心协力了。",
            "nextDialogs": [
              "411110110"
            ]
          },
          "411110110": {
            "id": "411110110",
            "speakerId": 1000,
            "speakerName": "凯瑟琳",
            "text": "请稍等，安全起见…",
            "nextDialogs": [
              "411110111"
            ]
          },
          "411110111": {
            "id": "411110111",
            "speakerId": 1002,
            "speakerName": "菲谢尔",
            "text": "凯瑟琳！幽夜净土的子民啊，莫非是你在虔诚地高呼本皇女之尊名？",
            "nextDialogs": [
              "411110112"
            ]
          },
          "411110112": {
            "id": "411110112",
            "speakerId": 1000,
            "speakerName": "凯瑟琳",
            "text": "啊，来了来了。",
            "nextDialogs": [
              "411110113"
            ]
          },
          "411110113": {
            "id": "411110113",
            "speakerId": 1003,
            "speakerName": "奥兹",
            "text": "又见面了，凯瑟琳女士。",
            "nextDialogs": [
              "411110114"
            ]
          },
          "411110114": {
            "id": "411110114",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "啊！这只乌鸦会说话？！",
            "nextDialogs": [
              "411110115"
            ]
          },
          "411110115": {
            "id": "411110115",
            "speakerId": 1003,
            "speakerName": "奥兹",
            "text": "哈哈，何必为这等小事惊讶呢，我的朋友。",
            "nextDialogs": [
              "411110116"
            ]
          },
          "411110116": {
            "id": "411110116",
            "speakerId": 1002,
            "speakerName": "菲谢尔",
            "text": "我忠诚的臣属，看你一脸忧虑，想必是那些罪愆邪佞又一次妄图染指蒙德的安宁吧。",
            "nextDialogs": [
              "411110117"
            ]
          },
          "411110117": {
            "id": "411110117",
            "speakerId": 1000,
            "speakerName": "凯瑟琳",
            "text": "旅行者，这位是蒙德冒险家协会的资深成员菲谢尔。",
            "nextDialogs": [
              "411110118"
            ]
          },
          "411110118": {
            "id": "411110118",
            "speakerId": 1000,
            "speakerName": "凯瑟琳",
            "text": "菲谢尔，奥兹，这位就是我提起过的旅行者。",
            "nextDialogs": [
              "411110119"
            ]
          },
          "411110119": {
            "id": "411110119",
            "speakerId": 1002,
            "speakerName": "菲谢尔",
            "text": "哦？就是你吗？哼…眼神不错。",
            "nextDialogs": [
              "411110120"
            ]
          },
          "411110120": {
            "id": "411110120",
            "speakerId": 1003,
            "speakerName": "奥兹",
            "text": "西风骑士团荣誉骑士与其旅伴派蒙。久仰了，很高兴见到二位。",
            "nextDialogs": [
              "411110121"
            ]
          },
          "411110121": {
            "id": "411110121",
            "speakerId": 1002,
            "speakerName": "菲谢尔",
            "text": "旅人，你也想要对抗那无边深邃的黑暗结晶吗？",
            "nextDialogs": [
              "411110122"
            ]
          },
          "411110122": {
            "id": "411110122",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "对抗…什么什么黑暗？黑暗什么？",
            "nextDialogs": [
              "411110123"
            ]
          },
          "411110123": {
            "id": "411110123",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "凯瑟琳，你刚才说的不是这个。",
            "nextDialogs": [
              "411110125"
            ]
          },
          "411110125": {
            "id": "411110125",
            "speakerId": 1003,
            "speakerName": "奥兹",
            "text": "小姐说的，就是那些<color=#00E1FFFF>陨石</color>。",
            "nextDialogs": [
              "411110126"
            ]
          },
          "411110126": {
            "id": "411110126",
            "speakerId": 1000,
            "speakerName": "凯瑟琳",
            "text": "协会方面还不能确定陨石雨的成因及副作用。因此，我们希望冒险家能够组成二人小队。",
            "nextDialogs": [
              "411110127"
            ]
          },
          "411110127": {
            "id": "411110127",
            "speakerId": 1000,
            "speakerName": "凯瑟琳",
            "text": "旅行者，菲谢尔，希望你们能彼此关照，在保证自身安全的前提下行动。",
            "nextDialogs": [
              "411110128"
            ]
          },
          "411110128": {
            "id": "411110128",
            "speakerId": 1002,
            "speakerName": "菲谢尔",
            "text": "哼，既然是忠诚的凯瑟琳的请求，本皇女也只能允诺了。",
            "nextDialogs": [
              "411110129"
            ]
          },
          "411110129": {
            "id": "411110129",
            "speakerId": 1002,
            "speakerName": "菲谢尔",
            "text": "雀跃吧！能与断罪的皇女菲谢尔一同踏上征途，你之余生都应为此感到骄傲！",
            "nextDialogs": [
              "411110130"
            ]
          },
          "411110130": {
            "id": "411110130",
            "speakerId": 1003,
            "speakerName": "奥兹",
            "text": "这位是我的主人，来自异界·幽夜净土的皇女菲谢尔，我是她的眷属夜鸦，奥兹。",
            "nextDialogs": [
              "411110131"
            ]
          },
          "411110131": {
            "id": "411110131",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "好、好有来头的人呢…",
            "nextDialogs": [
              "411110132"
            ]
          },
          "411110132": {
            "id": "411110132",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "#我是派蒙，{PLAYERAVATAR#SEXPRO[INFO_MALE_PRONOUN_HE|INFO_FEMALE_PRONOUN_SHE]}是{NICKNAME}，请多关照啦！"
          }
        }
      }
    },
    {
      "subId": "4111104",
      "subQuestName": "前往清泉镇查看情况",
      "sceneId": null,
      "locations": [],

    {
      "subId": "4111118",
      "subQuestName": "(test)与菲谢尔对话（隐藏）$HIDDEN",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "411111801"
        ],
        "dialogs": {
          "411111801": {
            "id": "411111801",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "这样一来应该就清理得差不多了。会对清泉镇的村民有帮助吗？",
            "nextDialogs": [
              "411111802"
            ]
          },
          "411111802": {
            "id": "411111802",
            "speakerId": 1003,
            "speakerName": "奥兹",
            "text": "含有元素力的陨石…它就是事件的元凶吗？",
            "nextDialogs": [
              "411111803"
            ]
          },
          "411111803": {
            "id": "411111803",
            "speakerId": 1002,
            "speakerName": "菲谢尔",
            "text": "以祝圣的圣约起誓，这些陨石正是梦魇的根源！",
            "nextDialogs": [
              "411111804"
            ]
          },
          "411111804": {
            "id": "411111804",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "回镇上确认一下吧。",
            "nextDialogs": [
              "411111805"
            ]
          },
          "411111805": {
            "id": "411111805",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "嗯！！"
          }
        }
      }
    },
    {
      "subId": "4111114",
      "subQuestName": "回清泉镇确认病患的状况",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "411111401"
        ],
        "dialogs": {
          "411111401": {
            "id": "411111401",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "艾德娜小姐，我们把后山上的陨石清掉啦，请问病人有好转吗？",
            "nextDialogs": [
              "411111402"
            ]
          },
          "411111402": {
            "id": "411111402",
            "speakerId": 1007,
            "speakerName": "艾德娜",
            "text": "多亏你们，刚才已经有两名患者醒来了！",
            "nextDialogs": [
              "411111403"
            ]
          },
          "411111403": {
            "id": "411111403",
            "speakerId": 1008,
            "speakerName": "哈特曼",
            "text": "还有点困…呼啊~",
            "nextDialogs": [
              "411111404"
            ]
          },
          "411111404": {
            "id": "411111404",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "太好了，这个办法奏效！",
            "nextDialogs": [
              "411111405"
            ]
          },
          "411111405": {
            "id": "411111405",
            "speakerId": 1007,
            "speakerName": "艾德娜",
            "text": "如果能把附近的<color=#00E1FFFF>陨石</color>都清理干净…",
            "nextDialogs": [
              "411111406"
            ]
          },
          "411111406": {
            "id": "411111406",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "大家就会从梦中醒来。",
            "nextDialogs": [
              "411111407"
            ]
          },
          "411111407": {
            "id": "411111407",
            "speakerId": 1003,
            "speakerName": "奥兹",
            "text": "啊，真是个振奋人心的好消息。",
            "nextDialogs": [
              "411111408"
            ]
          },
          "411111408": {
            "id": "411111408",
            "speakerId": 1002,
            "speakerName": "菲谢尔",
            "text": "哼哼，劳烦本皇女亲自出马，有这种结果也是应该的嘛！",
            "nextDialogs": [
              "411111409"
            ]
          },
          "411111409": {
            "id": "411111409",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "那位醒来的先生，你在梦里看到了什么呀？",
            "nextDialogs": [
              "411111410"
            ]
          },
          "411111410": {
            "id": "411111410",
            "speakerId": 1008,
            "speakerName": "哈特曼",
            "text": "只记得很冷，我在不停地走山路…是<color=#00E1FFFF>雪山</color>吧…",
            "nextDialogs": [
              "411111411"
            ]
          },
          "411111411": {
            "id": "411111411",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "走山路…？没有目的吗？",
            "nextDialogs": [
              "411111412"
            ]
          },
          "411111412": {
            "id": "411111412",
            "speakerId": 1008,
            "speakerName": "哈特曼",
            "text": "呃，我也不知道呢，梦里的我，似乎不完全受我控制。",
            "nextDialogs": [
              "411111413"
            ]
          },
          "411111413": {
            "id": "411111413",
            "speakerId": 1002,
            "speakerName": "菲谢尔",
            "text": "果然是诅咒，何等可悲的土地啊…",
            "nextDialogs": [
              "411111414"
            ]
          },
          "411111414": {
            "id": "411111414",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "（诅咒？真是如此吗？）",
            "nextDialogs": [
              "411111415"
            ]
          },
          "411111415": {
            "id": "411111415",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "不管怎么说，清理陨石的做法有效。看来，我们需要加大力度！"
          }
        }
      }
    },

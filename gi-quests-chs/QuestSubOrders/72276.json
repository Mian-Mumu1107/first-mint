    {
      "subId": "7227623",
      "subQuestName": "与派蒙对话",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "722760701"
        ],
        "dialogs": {
          "722760701": {
            "id": "722760701",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "呜啊！",
            "nextDialogs": [
              "722760702"
            ]
          },
          "722760702": {
            "id": "722760702",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "我也期待过拼好之后密室会怎么打开…比如说出现传送门啊，或者石壁开出一个密道啊。",
            "nextDialogs": [
              "722760703"
            ]
          },
          "722760703": {
            "id": "722760703",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "结果是图案变成真的门了！",
            "nextDialogs": [
              "722760704"
            ]
          },
          "722760704": {
            "id": "722760704",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "下面不就是之前的房间…",
            "nextDialogs": [
              "722760705"
            ]
          },
          "722760705": {
            "id": "722760705",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "也不能这么说，这个大洞可是「呼！叮！」一下出现的，肯定非比寻常。",
            "nextDialogs": [
              "722760706"
            ]
          },
          "722760706": {
            "id": "722760706",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "仔细想想，矢部好像确实也说过密室是用「阳炎幻法」封住的。",
            "nextDialogs": [
              "722760707"
            ]
          },
          "722760707": {
            "id": "722760707",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "我们下去看看吧。"
          }
        }
      }
    },

    {
      "subId": "7227618",
      "subQuestName": "与派蒙对话",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "722760301"
        ],
        "dialogs": {
          "722760301": {
            "id": "722760301",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "咦，你听到了吗？上面似乎传来了什么奇怪的声音。",
            "nextDialogs": [
              "722760302"
            ]
          },
          "722760302": {
            "id": "722760302",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "顺着声音的方向抬头看，天花板上还有个奇怪的纹路。",
            "nextDialogs": [
              "722760303"
            ]
          },
          "722760303": {
            "id": "722760303",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "唔，我们去上面看看吧。"
          }
        }
      }
    },
    {
      "subId": "7227619",
      "subQuestName": "前往声音源头，寻找线索",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [],

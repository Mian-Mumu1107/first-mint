    {
      "subId": "7227612",
      "subQuestName": "与矢部对话",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "722761201"
        ],
        "dialogs": {
          "722761201": {
            "id": "722761201",
            "speakerId": 1000,
            "speakerName": "矢部",
            "text": "你们回来啦。",
            "nextDialogs": [
              "722761202"
            ]
          },
          "722761202": {
            "id": "722761202",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "你好，什么来着…",
            "nextDialogs": [
              "722761203"
            ]
          },
          "722761203": {
            "id": "722761203",
            "speakerId": 1000,
            "speakerName": "矢部",
            "text": "矢部啊矢部！我叫矢部！",
            "nextDialogs": [
              "722761204"
            ]
          },
          "722761204": {
            "id": "722761204",
            "speakerId": 1000,
            "speakerName": "矢部",
            "text": "唉，好好把我名字记住啊。我说，你该不会把我委托的事情忘了吧？",
            "nextDialogs": [
              "722761205"
            ]
          },
          "722761205": {
            "id": "722761205",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "#{NICKNAME}在开玩笑啦。我们已经找到了文谷秘宝的真相了。",
            "nextDialogs": [
              "722761206"
            ]
          },
          "722761206": {
            "id": "722761206",
            "speakerId": 1003,
            "speakerName": "Black Screen",
            "text": "和矢部讲述了整个事情的经过…",
            "nextDialogs": [
              "722761207"
            ]
          },
          "722761207": {
            "id": "722761207",
            "speakerId": 1000,
            "speakerName": "矢部",
            "text": "所以说，阳炎幻法和宝藏密室确有其事？但是中途还发生过别的故事？",
            "nextDialogs": [
              "722761208"
            ]
          },
          "722761208": {
            "id": "722761208",
            "speakerId": 1000,
            "speakerName": "矢部",
            "text": "怨灵和污秽也确有其事，还能控制人的心智。哎哟，吓坏我了。还好没和你们一起去。",
            "nextDialogs": [
              "722761209"
            ]
          },
          "722761209": {
            "id": "722761209",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "害怕伤害我们？",
            "nextDialogs": [
              "722761210"
            ]
          },
          "722761210": {
            "id": "722761210",
            "speakerId": 1000,
            "speakerName": "矢部",
            "text": "害怕被你们摁在地上打。",
            "nextDialogs": [
              "722761211"
            ]
          },
          "722761211": {
            "id": "722761211",
            "speakerId": 1000,
            "speakerName": "矢部",
            "text": "总之有点满足又有点遗憾，谢谢你们啦。虽然确实很玄乎，但是好像也都是元素力能解释的，有点不带劲儿啊。",
            "nextDialogs": [
              "722761212"
            ]
          },
          "722761212": {
            "id": "722761212",
            "speakerId": 1000,
            "speakerName": "矢部",
            "text": "文谷的迷案终于可以结掉了，我回去就让全世界知道。"
          }
        }
      }
    },
    {
      "subId": "7227611",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {

      }
    },
    {
      "subId": "7227603",
      "subQuestName": "调查前方的秘密通道",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "722760401"
        ],
        "dialogs": {
          "722760401": {
            "id": "722760401",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "看起来，通向藏宝室的关键就是这个了。",
            "nextDialogs": [
              "722760402"
            ]
          },
          "722760402": {
            "id": "722760402",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "石板的大小也还算合适。刚好是…唔，三分之一？",
            "nextDialogs": [
              "722760403"
            ]
          },
          "722760403": {
            "id": "722760403",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "九分之一。",
            "nextDialogs": [
              "722760404"
            ]
          },
          "722760404": {
            "id": "722760404",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "哎呀，我就是这个意思啦。你明白就好。",
            "nextDialogs": [
              "722760405"
            ]
          },
          "722760405": {
            "id": "722760405",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "也就是只要再找到八个石板放进这里就行了吧。",
            "nextDialogs": [
              "722760408"
            ]
          },
          "722760408": {
            "id": "722760408",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "烦欸，知道了啦！",
            "nextDialogs": [
              "722760409"
            ]
          },
          "722760409": {
            "id": "722760409",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "那我们多留心一点，看到了这样的石板就收起来吧。",
            "nextDialogs": [
              "722760410"
            ]
          },
          "722760410": {
            "id": "722760410",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "不过现在没有一点线索，找起来完全没有头绪啊。"
          }
        }
      }
    },
    {

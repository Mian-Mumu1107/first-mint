    {
      "subId": "7227620",
      "subQuestName": "与矢部对话",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "722760501"
        ],
        "dialogs": {
          "722760501": {
            "id": "722760501",
            "speakerId": 1000,
            "speakerName": "矢部",
            "text": "你们回来了，有什么发现吗？",
            "nextDialogs": [
              "722760502"
            ]
          },
          "722760502": {
            "id": "722760502",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "确实有个密室。",
            "nextDialogs": [
              "722760503"
            ]
          },
          "722760503": {
            "id": "722760503",
            "speakerId": 1000,
            "speakerName": "矢部",
            "text": "哦哦，那看起来确有其事咯？",
            "nextDialogs": [
              "722760504"
            ]
          },
          "722760504": {
            "id": "722760504",
            "speakerId": 1000,
            "speakerName": "矢部",
            "text": "根据说明上的描述，剩下的石板都被集中放在了三个区域里。",
            "nextDialogs": [
              "722760505"
            ]
          },
          "722760505": {
            "id": "722760505",
            "speakerId": 1000,
            "speakerName": "矢部",
            "text": "你手上有阿祇小姐的简易地图吧？我来给你指指。",
            "nextDialogs": [
              "722760506"
            ]
          },
          "722760506": {
            "id": "722760506",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "你为什么刚才不说？",
            "nextDialogs": [
              "722760507"
            ]
          },
          "722760507": {
            "id": "722760507",
            "speakerId": 1000,
            "speakerName": "矢部",
            "text": "这不是因为这三片地都位于险境之中嘛？要是密室本身就是无稽之谈，后面当然就不用看了。",
            "nextDialogs": [
              "722760508"
            ]
          },
          "722760508": {
            "id": "722760508",
            "speakerId": 1000,
            "speakerName": "矢部",
            "text": "如果这只是先祖大人们留下的恶作剧，我哪好意思让你深入黑雾呢。",
            "nextDialogs": [
              "722760509"
            ]
          },
          "722760509": {
            "id": "722760509",
            "speakerId": 1000,
            "speakerName": "矢部",
            "text": "好了，就是这些地方。",
            "nextDialogs": [
              "722760510"
            ]
          },
          "722760510": {
            "id": "722760510",
            "speakerId": 1000,
            "speakerName": "矢部",
            "text": "希、希望我没理解错吧…"
          }
        }
      }
    },

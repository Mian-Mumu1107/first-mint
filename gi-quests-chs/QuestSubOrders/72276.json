    {
      "subId": "7227610",
      "subQuestName": "前往下方的房间",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "722761001"
        ],
        "dialogs": {
          "722761001": {
            "id": "722761001",
            "speakerId": 1002,
            "speakerName": "小柳",
            "text": "怎么…怎么会这样…",
            "nextDialogs": [
              "722761002"
            ]
          },
          "722761002": {
            "id": "722761002",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "发生了什么？",
            "nextDialogs": [
              "722761003"
            ]
          },
          "722761003": {
            "id": "722761003",
            "speakerId": 1002,
            "speakerName": "小柳",
            "text": "我居然对我的朋友下手了…",
            "nextDialogs": [
              "722761004"
            ]
          },
          "722761004": {
            "id": "722761004",
            "speakerId": 1002,
            "speakerName": "小柳",
            "text": "一定是文谷布下的怨灵上了我的身，控制了我的神智…",
            "nextDialogs": [
              "722761005"
            ]
          },
          "722761005": {
            "id": "722761005",
            "speakerId": 1002,
            "speakerName": "小柳",
            "text": "这么点秘宝，如何能比得上我和他的友谊。我、我绝对不会因为这么点财宝就动了歹念的。",
            "nextDialogs": [
              "722761006"
            ]
          },
          "722761006": {
            "id": "722761006",
            "speakerId": 1002,
            "speakerName": "小柳",
            "text": "他那么信任我，找到了文谷之宝都会约我一同前来见证…我…",
            "nextDialogs": [
              "722761007"
            ]
          },
          "722761007": {
            "id": "722761007",
            "speakerId": 1002,
            "speakerName": "小柳",
            "text": "我不是这样的人…",
            "nextDialogs": [
              "722761008"
            ]
          },
          "722761008": {
            "id": "722761008",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "唔，所以最后一块碎片掩盖了这个真相吗？",
            "nextDialogs": [
              "722761009"
            ]
          },
          "722761009": {
            "id": "722761009",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "让他自己静一静吧。",
            "nextDialogs": [
              "722761010"
            ]
          },
          "722761010": {
            "id": "722761010",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "说的也是呢。",
            "nextDialogs": [
              "722761011"
            ]
          },
          "722761011": {
            "id": "722761011",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "我们回去和矢部说一声吧。"
          }
        }
      }
    },

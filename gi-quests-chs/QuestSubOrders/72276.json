        ],
        "dialogs": {
          "722761101": {
            "id": "722761101",
            "speakerId": 1002,
            "speakerName": "小柳",
            "text": "呵呵哈哈哈——反正现在是百年一次的三界交汇天象。只要藏起来，藏起来就能把它变成迷案了…",
            "nextDialogs": [
              "722761102"
            ]
          },
          "722761102": {
            "id": "722761102",
            "speakerId": 1002,
            "speakerName": "小柳",
            "text": "我，我不是…"
          }
        }
      }
    }
  ]

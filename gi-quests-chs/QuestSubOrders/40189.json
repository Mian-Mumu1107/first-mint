          }
        }
      }
    },
    {
      "subId": "4018903",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "401890301"
        ],
        "dialogs": {
          "401890301": {
            "id": "401890301",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "还有别的事要处理。",
            "nextDialogs": [
              "401890302"
            ]
          },
          "401890302": {
            "id": "401890302",
            "speakerId": 1000,
            "speakerName": "娜维娅",
            "text": "好，随时等着你！"
          }
        }
      }
    },
    {
      "subId": "4018911",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "401891101"
        ],
        "dialogs": {
          "401891101": {
            "id": "401891101",
            "speakerId": 1002,
            "speakerName": "爱可菲",
            "text": "嗯…",
            "nextDialogs": [
              "401891102"
            ]
          },
          "401891102": {
            "id": "401891102",
            "speakerId": 1002,
            "speakerName": "爱可菲",
            "text": "餐厅的条件很不错，水畔用餐的氛围相当特别。映影的景观能让食客们的兴致高涨，更细致地品味美食…",
            "nextDialogs": [
              "401891103"
            ]
          },
          "401891103": {
            "id": "401891103",
            "speakerId": 1002,
            "speakerName": "爱可菲",
            "text": "食材也就位了，准备好厨具，马上就能开工。",
            "nextDialogs": [
              "401891104"
            ]
          },
          "401891104": {
            "id": "401891104",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "你好呀，爱可菲！",
            "nextDialogs": [
              "401891105"
            ]
          },
          "401891105": {
            "id": "401891105",
            "speakerId": 1002,
            "speakerName": "爱可菲",
            "text": "哦？我的雇主们来了。",
            "nextDialogs": [
              "401891106"
            ]
          },
          "401891106": {
            "id": "401891106",
            "speakerId": 1002,
            "speakerName": "爱可菲",
            "text": "#刺玫会的老板，加上著名的{NICKNAME}和派蒙…这样的阵容运营一个映影乐园，有点奢华。",
            "nextDialogs": [
              "401891107"
            ]
          },
          "401891107": {
            "id": "401891107",
            "speakerId": 1000,
            "speakerName": "娜维娅",
            "text": "德波大饭店的前主厨才和「奢华」这个词关联最紧密吧？不管你走到哪，都会带来一股精致料理的香气哦。",
            "nextDialogs": [
              "401891108"
            ]
          },
          "401891108": {
            "id": "401891108",
            "speakerId": 1002,
            "speakerName": "爱可菲",
            "text": "咳咳…正事要紧。",
            "nextDialogs": [
              "401891109"
            ]
          },
          "401891109": {
            "id": "401891109",
            "speakerId": 1002,
            "speakerName": "爱可菲",
            "text": "#看来，娜维娅是想让{NICKNAME}决定各个时期的「主题料理」吧？",
            "nextDialogs": [
              "401891110"
            ]
          },
          "401891110": {
            "id": "401891110",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "「主题料理」？",
            "nextDialogs": [
              "401891111"
            ]
          },
          "401891111": {
            "id": "401891111",
            "speakerId": 1000,
            "speakerName": "娜维娅",
            "text": "这就是我之前提到的经营策略——用顶级厨师的料理，为「海薇玛映影欢乐城」吸引额外的客源！",
            "nextDialogs": [
              "401891112"
            ]
          },
          "401891112": {
            "id": "401891112",
            "speakerId": 1000,
            "speakerName": "娜维娅",
            "text": "不…不止吸引客源，爱可菲的杰作肯定还能发挥其他惊喜的效果！",
            "nextDialogs": [
              "401891113"
            ]
          },
          "401891113": {
            "id": "401891113",
            "speakerId": 1000,
            "speakerName": "娜维娅",
            "text": "你想想，派蒙，假如只需要一张乐园的门票，不仅能玩个痛快，还能吃到传说中的美食，你不心动吗？",
            "nextDialogs": [
              "401891114"
            ]
          },
          "401891114": {
            "id": "401891114",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "那那那！那我一定天天来！",
            "nextDialogs": [
              "401891117"
            ]
          },
          "401891117": {
            "id": "401891117",
            "speakerId": 1002,
            "speakerName": "爱可菲",
            "text": "不过，要是公开菜单，吸引客人的效果就会减半了。",
            "nextDialogs": [
              "401891118"
            ]
          },
          "401891118": {
            "id": "401891118",
            "speakerId": 1002,
            "speakerName": "爱可菲",
            "text": "根据一位美食品牌顾问的调查，许多餐馆采用了「主厨随机料理」。",
            "nextDialogs": [
              "401891119"
            ]
          },
          "401891119": {
            "id": "401891119",
            "speakerId": 1002,
            "speakerName": "爱可菲",
            "text": "所以，每过几个经营周期，就由你来给我灵感，决定我应当制作什么「主题料理」。",
            "nextDialogs": [
              "401891120"
            ]
          },
          "401891120": {
            "id": "401891120",
            "speakerId": 1002,
            "speakerName": "爱可菲",
            "text": "把手给我。"
          }
        }
      }
    },
    {
      "subId": "4018912",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "401891201"
        ],
        "dialogs": {
          "401891201": {
            "id": "401891201",
            "speakerId": 1002,
            "speakerName": "爱可菲",
            "text": "来吧，看看你所带来的「力量」灵感，最终会凝聚成怎样的料理。"
          }
        }
      }
    },
    {
      "subId": "4018913",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "401891301"
        ],
        "dialogs": {
          "401891301": {
            "id": "401891301",
            "speakerId": 1000,
            "speakerName": "娜维娅",
            "text": "啊呀，是爱可菲的经典即兴烹饪——「关键原料触发神秘料理」！"
          }
        }
      }
    },
    {
      "subId": "4018915",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "401891501"
        ],
        "dialogs": {
          "401891501": {
            "id": "401891501",
            "speakerId": 1000,
            "speakerName": "娜维娅",
            "text": "一切进行得非常顺利，是时候好好改良设施了！"
          }
        }
      }
    },
    {
      "subId": "4018999",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "401899901"
        ],
        "dialogs": {
          "401899901": {
            "id": "401899901",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "有了「主题料理」的帮忙，工匠们干劲满满呢。",
            "nextDialogs": [
              "401899902"
            ]
          },
          "401899902": {
            "id": "401899902",
            "speakerId": 1000,
            "speakerName": "娜维娅",
            "text": "正好，我们就抓住这个窗口，进一步改良「缤纷蹈险奇行」的设施吧。",
            "nextDialogs": [
              "401899903"
            ]
          },
          "401899903": {
            "id": "401899903",
            "speakerId": 1000,
            "speakerName": "娜维娅",
            "text": "如你们所见，现在的欢乐城有点像没加糖的马卡龙，多个区域还在建设中。",
            "nextDialogs": [
              "401899904"
            ]
          },
          "401899904": {
            "id": "401899904",
            "speakerId": 1000,
            "speakerName": "娜维娅",
            "text": "刺玫会聘请的工匠数量有限，我们的经验也不足以支撑太复杂的多线工作。",
            "nextDialogs": [
              "401899905"
            ]
          },
          "401899905": {
            "id": "401899905",
            "speakerId": 1000,
            "speakerName": "娜维娅",
            "text": "所以说，我采用了「工作时间段」的规划方法——每段时间专心做好特定的工作。",
            "nextDialogs": [
              "401899906"
            ]
          },
          "401899906": {
            "id": "401899906",
            "speakerId": 1000,
            "speakerName": "娜维娅",
            "text": "改良设施、扩建场地、雇佣员工…这些事都需要我们花费「资金」和「工作时间段」去完成。",
            "nextDialogs": [
              "401899907"
            ]
          },
          "401899907": {
            "id": "401899907",
            "speakerId": 1000,
            "speakerName": "娜维娅",
            "text": "在每一个「经营周期」内，我们要将宝贵的「工作时间段」分配到最有价值的事务上。",
            "nextDialogs": [
              "401899908"
            ]
          },
          "401899908": {
            "id": "401899908",
            "speakerId": 1000,
            "speakerName": "娜维娅",
            "text": "随着我们吸引更多客人，赚到更多「资金」，工作愈发熟练…",
            "nextDialogs": [
              "401899909"
            ]
          },
          "401899909": {
            "id": "401899909",
            "speakerId": 1000,
            "speakerName": "娜维娅",
            "text": "相同周期内，能划分的「工作时间段」也会更细致，到时候，我们就能完成更多经营工作了！",
            "nextDialogs": [
              "401899910"
            ]
          },
          "401899910": {
            "id": "401899910",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "也就是说，我们在每一段时间内，能够做出的决定、专心去做的工作并不多。",
            "nextDialogs": [
              "401899911"
            ]
          },
          "401899911": {
            "id": "401899911",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "要用有限的行动次数和摩拉，去赚到更多摩拉！",
            "nextDialogs": [
              "401899912"
            ]
          },
          "401899912": {
            "id": "401899912",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "其实和下棋、玩牌戏有一些相像的地方呢，先考虑好行动策略最重要。",
            "nextDialogs": [
              "401899913"
            ]
          },
          "401899913": {
            "id": "401899913",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "这个摊位改良以后，应该能吸引更多顾客吧？",
            "nextDialogs": [
              "401899914"
            ]
          },
          "401899914": {
            "id": "401899914",
            "speakerId": 1000,
            "speakerName": "娜维娅",
            "text": "没错，我根据刺玫会商业合作的经验，量化评估了「服务值」，以便你们直观理解摊位让顾客满意的水准——",
            "nextDialogs": [
              "401899915"
            ]
          },
          "401899915": {
            "id": "401899915",
            "speakerId": 1000,
            "speakerName": "娜维娅",
            "text": "项目的「服务值」达到预期时，才能获得最理想的收益。随着我们改良和扩建设施，这个预期值也会相应提高。",
            "nextDialogs": [
              "401899916"
            ]
          },
          "401899916": {
            "id": "401899916",
            "speakerId": 1000,
            "speakerName": "娜维娅",
            "text": "这种时候，我们可以安排能力更强的员工上阵，或者花费一定的资金培训员工，提升员工的工作水准！"
          }
        }
      }
    }
  ]
}
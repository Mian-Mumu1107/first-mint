      }
    },
    {
      "subId": "4018907",
      "subQuestName": "选择制作主题料理",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "401890701"
        ],
        "dialogs": {
          "401890701": {
            "id": "401890701",
            "speakerId": 1000,
            "speakerName": "娜维娅",
            "text": "查看简历的时候，要注意对方擅长的工作哦！"
          }
        }
      }
    },
    {
      "subId": "4018908",
      "subQuestName": "与爱可菲对话",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "401891401"
        ],
        "dialogs": {
          "401891401": {
            "id": "401891401",
            "speakerId": 1002,
            "speakerName": "爱可菲",
            "text": "这款「香烤肋排」使用了改良配比的酱汁，口感相比经典款更为饱满，但不油腻。",
            "nextDialogs": [
              "401891402"
            ]
          },
          "401891402": {
            "id": "401891402",
            "speakerId": 1002,
            "speakerName": "爱可菲",
            "text": "佐料中的薄荷提取物还能给人神清气爽的回甘，适合在尽情游玩后吃个痛快。",
            "nextDialogs": [
              "401891403"
            ]
          },
          "401891403": {
            "id": "401891403",
            "speakerId": 1002,
            "speakerName": "爱可菲",
            "text": "不过，相比客人，我觉得工匠们更需要这些料理。",
            "nextDialogs": [
              "401891404"
            ]
          },
          "401891404": {
            "id": "401891404",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "工匠？",
            "nextDialogs": [
              "401891405"
            ]
          },
          "401891405": {
            "id": "401891405",
            "speakerId": 1002,
            "speakerName": "爱可菲",
            "text": "这座乐园还没建设到最理想的状态吧？工匠们吃了这些「香烤肋排」，应当能更快地补充体力，消除疲惫。",
            "nextDialogs": [
              "401891406"
            ]
          },
          "401891406": {
            "id": "401891406",
            "speakerId": 1002,
            "speakerName": "爱可菲",
            "text": "作为负责人，你们本来也要为工匠们提供伙食，不如就请他们来这里就餐？",
            "nextDialogs": [
              "401891407"
            ]
          },
          "401891407": {
            "id": "401891407",
            "speakerId": 1002,
            "speakerName": "爱可菲",
            "text": "说不定，还能提升工匠们的士气，提升施工的效率呢。",
            "nextDialogs": [
              "401891408"
            ]
          },
          "401891408": {
            "id": "401891408",
            "speakerId": 1000,
            "speakerName": "娜维娅",
            "text": "哦？我依稀记得，你以前也给灰河的搬运工们提供过特制的炸鱼薯条…",
            "nextDialogs": [
              "401891409"
            ]
          },
          "401891409": {
            "id": "401891409",
            "speakerId": 1000,
            "speakerName": "娜维娅",
            "text": "结果那几天，工人们的效率超高，只用五小时就忙完了八小时的任务，提前下班休息，第二天也精神饱满。",
            "nextDialogs": [
              "401891410"
            ]
          },
          "401891410": {
            "id": "401891410",
            "speakerId": 1002,
            "speakerName": "爱可菲",
            "text": "事不宜迟，趁着「香烤肋排」还热腾腾，去邀请工匠们吧，我这边再准备一些配菜和餐后甜点。",
            "nextDialogs": [
              "401891411"
            ]
          },
          "401891411": {
            "id": "401891411",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "真有道理！不愧是爱可菲！",
            "nextDialogs": [
              "401891412"
            ]
          },
          "401891412": {
            "id": "401891412",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "这样看来，「主题料理」一定能发挥超强的作用，每过一段时间，我们都要来找你！",
            "nextDialogs": [
              "401891413"
            ]
          },
          "401891413": {
            "id": "401891413",
            "speakerId": 1003,
            "speakerName": "Black Screen",
            "text": "与娜维娅一起邀请了工匠们，请他们享用了特别的「香烤肋排」大餐…"
          }
        }
      }
    },
    {
      "subId": "4018909",
      "subQuestName": "前往升级设施",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "401890901"
        ],
        "dialogs": {
          "401890901": {
            "id": "401890901",
            "speakerId": 1000,
            "speakerName": "娜维娅",
            "text": "这段时间的经营开了个好头，是时候进入下一个周期啦！"
          }
        }
      }
    },
    {
      "subId": "4018910",
      "subQuestName": "与娜维娅对话",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "401891601"
        ],
        "dialogs": {
          "401891601": {
            "id": "401891601",
            "speakerId": 1000,
            "speakerName": "娜维娅",
            "text": "呼…万事俱备！运营「海薇玛映影欢乐城」的要点，已经全都被你们掌握了！",
            "nextDialogs": [
              "401891602"
            ]
          },
          "401891602": {
            "id": "401891602",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "欸？掌握了吗？",
            "nextDialogs": [
              "401891603"
            ]
          },
          "401891603": {
            "id": "401891603",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "不知不觉，好像确实学会了不少事？",
            "nextDialogs": [
              "401891606"
            ]
          },
          "401891606": {
            "id": "401891606",
            "speakerId": 1000,
            "speakerName": "娜维娅",
            "text": "没有啦，没有啦，其实我也没教你们什么东西，你们自己的悟性才最关键！",
            "nextDialogs": [
              "401891607"
            ]
          },
          "401891607": {
            "id": "401891607",
            "speakerId": 1000,
            "speakerName": "娜维娅",
            "text": "初听「长期经营」这个词，好像很吓人，对不对？",
            "nextDialogs": [
              "401891608"
            ]
          },
          "401891608": {
            "id": "401891608",
            "speakerId": 1000,
            "speakerName": "娜维娅",
            "text": "但是不用怕，只要把复杂的东西拆成小事，一件一件做下去，就算没什么天赋，不是聪明绝顶的人，也一定能做到！",
            "nextDialogs": [
              "401891609"
            ]
          },
          "401891609": {
            "id": "401891609",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "喔喔喔！感觉到了自己的进步，动力源源不断涌上来了！我要把娜维娅鼓励人的话记在笔记本里！",
            "nextDialogs": [
              "401891610"
            ]
          },
          "401891610": {
            "id": "401891610",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "接下来，我们就和娜维娅一起，好好经营这座「海薇玛映影欢乐城」吧！"
          }
        }
      }
    },

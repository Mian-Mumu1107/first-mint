  "subQuests": [
    {
      "subId": "4018901",
      "subQuestName": "与娜维娅对话",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "401890429"
        ],
        "dialogs": {
          "401890429": {
            "id": "401890429",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "准备好了。",
            "nextDialogs": [
              "401890401"
            ]
          },
          "401890401": {
            "id": "401890401",
            "speakerId": 1000,
            "speakerName": "娜维娅",
            "text": "接下来，我的好搭档和派蒙，我们要进入「海薇玛映影欢乐城」的正题了…",
            "nextDialogs": [
              "401890402"
            ]
          },
          "401890402": {
            "id": "401890402",
            "speakerId": 1000,
            "speakerName": "娜维娅",
            "text": "之前说过，这次的「海薇玛映影欢乐城」由爱好者们发起，刺玫会负责统筹、建造和运营。",
            "nextDialogs": [
              "401890403"
            ]
          },
          "401890403": {
            "id": "401890403",
            "speakerId": 1000,
            "speakerName": "娜维娅",
            "text": "不过，爱好者毕竟不是全能的专业人士，通常只负责活动展位的设计。",
            "nextDialogs": [
              "401890404"
            ]
          },
          "401890404": {
            "id": "401890404",
            "speakerId": 1000,
            "speakerName": "娜维娅",
            "text": "我们的任务，就是进行「长期经营规划」，定制「标准玩法攻略」。",
            "nextDialogs": [
              "401890405"
            ]
          },
          "401890405": {
            "id": "401890405",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "长期、经营、规划…听起来好高深！",
            "nextDialogs": [
              "401890406"
            ]
          },
          "401890406": {
            "id": "401890406",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "我们两个平时都在冒险，甚至都没怎么摆摊卖过东西，能搞懂吗？",
            "nextDialogs": [
              "401890409"
            ]
          },
          "401890409": {
            "id": "401890409",
            "speakerId": 1000,
            "speakerName": "娜维娅",
            "text": "没错，就是这种气势！我的好搭档什么风浪都见过，影响过不少提瓦特的商业大事件！",
            "nextDialogs": [
              "401890410"
            ]
          },
          "401890410": {
            "id": "401890410",
            "speakerId": 1000,
            "speakerName": "娜维娅",
            "text": "总之，我们先来看看欢乐城的基本情况…",
            "nextDialogs": [
              "401890411"
            ]
          },
          "401890411": {
            "id": "401890411",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "#好像大概明白了，{NICKNAME}，你感觉怎么样？"
          }
        }
      }
    },
    {
      "subId": "4018902",
      "subQuestName": "前往制定攻略",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [],

      }
    },
    {
      "subId": "4018911",
      "subQuestName": "与娜维娅对话",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "401890801"
        ],
        "dialogs": {
          "401890801": {
            "id": "401890801",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "好，看起来这位员工已经进入工作状态了呢。",
            "nextDialogs": [
              "401890804"
            ]
          },
          "401890804": {
            "id": "401890804",
            "speakerId": 1000,
            "speakerName": "娜维娅",
            "text": "哈哈哈，你们也不赖嘛，比我更有老板的气势！",
            "nextDialogs": [
              "401890805"
            ]
          },
          "401890805": {
            "id": "401890805",
            "speakerId": 1000,
            "speakerName": "娜维娅",
            "text": "现在，「海薇玛映影欢乐城」就算正式开张了！",
            "nextDialogs": [
              "401890806"
            ]
          },
          "401890806": {
            "id": "401890806",
            "speakerId": 1000,
            "speakerName": "娜维娅",
            "text": "经营乐园是个长期的过程，心急赚不了大笔摩拉。",
            "nextDialogs": [
              "401890807"
            ]
          },
          "401890807": {
            "id": "401890807",
            "speakerId": 1000,
            "speakerName": "娜维娅",
            "text": "这次的工作布置已经差不多了，我们就小小休息一会儿，等待着这个周期的营收财报出炉吧。"
          }
        }
      }
    },
    {
      "subId": "4018905",
      "subQuestName": "结束当前经营周期",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "401890501"
        ],
        "dialogs": {
          "401890501": {
            "id": "401890501",
            "speakerId": 1000,
            "speakerName": "娜维娅",
            "text": "好，接下来就试试「缤纷蹈险奇行」吧，「标准玩法攻略」就由你们来制定啦！"
          }
        }
      }
    },
    {
      "subId": "4018912",
      "subQuestName": "与娜维娅对话",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "401891001"
        ],
        "dialogs": {
          "401891001": {
            "id": "401891001",
            "speakerId": 1000,
            "speakerName": "娜维娅",
            "text": "哎呀，虽然数据不是很夸张，但考虑到刚刚开张，是个不错的开端！",
            "nextDialogs": [
              "401891002"
            ]
          },
          "401891002": {
            "id": "401891002",
            "speakerId": 1000,
            "speakerName": "娜维娅",
            "text": "趁着这个势头，我们要在新一个周期里考虑更特别的经营策略了！",
            "nextDialogs": [
              "401891003"
            ]
          },
          "401891003": {
            "id": "401891003",
            "speakerId": 1000,
            "speakerName": "娜维娅",
            "text": "为了欢乐城的人气，我专门请来了枫丹知名的厨师，我的好朋友爱可菲！",
            "nextDialogs": [
              "401891004"
            ]
          },
          "401891004": {
            "id": "401891004",
            "speakerId": 1000,
            "speakerName": "娜维娅",
            "text": "乐园里的餐厅就是她表演的舞台，我们这就去找她聊聊！",
            "nextDialogs": [
              "401891005"
            ]
          },
          "401891005": {
            "id": "401891005",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "餐厅也是经营策略的一环吗？还真是深奥呢…"
          }
        }
      }
    },
    {
      "subId": "4018906",
      "subQuestName": "前往主题餐厅",
      "sceneId": null,
      "locations": [],
      "dialogue": {

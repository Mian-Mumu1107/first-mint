      }
    },
    {
      "subId": "4018903",
      "subQuestName": "与娜维娅对话",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "401890601"
        ],
        "dialogs": {
          "401890601": {
            "id": "401890601",
            "speakerId": 1000,
            "speakerName": "娜维娅",
            "text": "你们似乎比之前更有兴致了…看来第一次试玩没让你们失望！",
            "nextDialogs": [
              "401890604"
            ]
          },
          "401890604": {
            "id": "401890604",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "虽然没看过多少映影，但试过这次的玩法后，我好像…来劲了？很想了解一下相关的作品！",
            "nextDialogs": [
              "401890605"
            ]
          },
          "401890605": {
            "id": "401890605",
            "speakerId": 1000,
            "speakerName": "娜维娅",
            "text": "派蒙真不错，领会到了爱好者们最纯粹的目标！",
            "nextDialogs": [
              "401890606"
            ]
          },
          "401890606": {
            "id": "401890606",
            "speakerId": 1000,
            "speakerName": "娜维娅",
            "text": "如果能让客人们对游乐项目的原型映影感兴趣，这些淳朴的爱好者就再快乐不过了！",
            "nextDialogs": [
              "401890607"
            ]
          },
          "401890607": {
            "id": "401890607",
            "speakerId": 1000,
            "speakerName": "娜维娅",
            "text": "在开销允许的范围内，他们甚至愿意多多自掏腰包！",
            "nextDialogs": [
              "401890608"
            ]
          },
          "401890608": {
            "id": "401890608",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "自…自掏腰包？",
            "nextDialogs": [
              "401890609"
            ]
          },
          "401890609": {
            "id": "401890609",
            "speakerId": 1000,
            "speakerName": "娜维娅",
            "text": "没错，基本的摊位建材和地租由刺玫会负责，许多爱好者自己出钱制作了宣传物料和相关商品哦！",
            "nextDialogs": [
              "401890610"
            ]
          },
          "401890610": {
            "id": "401890610",
            "speakerId": 1000,
            "speakerName": "娜维娅",
            "text": "对他们来说，展位的费用并不是大头，有人已经开始自行设计映影角色的衍生产品了。",
            "nextDialogs": [
              "401890611"
            ]
          },
          "401890611": {
            "id": "401890611",
            "speakerId": 1000,
            "speakerName": "娜维娅",
            "text": "比如这次的代言人海薇玛夫人，她在上次漫画映影的人气角色投票中取得了亚军，评语是「圆圆弹弹终极可爱」。",
            "nextDialogs": [
              "401890612"
            ]
          },
          "401890612": {
            "id": "401890612",
            "speakerId": 1000,
            "speakerName": "娜维娅",
            "text": "许多人都想以她的形象设计抱枕，用最顶级的布料，请最手巧的工匠来批量生产…",
            "nextDialogs": [
              "401890613"
            ]
          },
          "401890613": {
            "id": "401890613",
            "speakerId": 1000,
            "speakerName": "娜维娅",
            "text": "下一届展会上，这种抱枕就会正式发售，类似的商品还有很多！"
          }
        }
      }
    },
    {
      "subId": "4018904",
      "subQuestName": "前往聘用员工",
      "sceneId": null,
      "locations": [],

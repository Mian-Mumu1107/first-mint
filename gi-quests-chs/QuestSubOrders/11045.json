  "subQuests": [
    {
      "subId": "1104501",
      "subQuestName": "前往智能实验的地点",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "110450101"
        ],
        "dialogs": {
          "110450101": {
            "id": "110450101",
            "speakerId": 1000,
            "speakerName": "阿贝多",
            "text": "想必在旅行的过程中，你也遇到过很多的谜题。",
            "nextDialogs": [
              "110450102"
            ]
          },
          "110450102": {
            "id": "110450102",
            "speakerId": 1000,
            "speakerName": "阿贝多",
            "text": "和体能测试类似，我想通过实验观察你的智能水平。",
            "nextDialogs": [
              "110450105"
            ]
          },
          "110450105": {
            "id": "110450105",
            "speakerId": 1000,
            "speakerName": "阿贝多",
            "text": "我希望你能探索一番这里的遗迹，之后给我你所得到的答案。",
            "nextDialogs": [
              "110450106"
            ]
          },
          "110450106": {
            "id": "110450106",
            "speakerId": 1000,
            "speakerName": "阿贝多",
            "text": "在这遗迹的两侧，各有一处谜题，完成之后，应该就可以启动中央的机关了。",
            "nextDialogs": [
              "110450107"
            ]
          },
          "110450107": {
            "id": "110450107",
            "speakerId": 1000,
            "speakerName": "阿贝多",
            "text": "还是像体能测试那样，不限制方式，你所做的一切都是我想要观察的内容。"
          }
        }
      }
    },

    {
      "subId": "1104504",
      "subQuestName": "调查排水之后的区域",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "110450461"
        ],
        "dialogs": {
          "110450461": {
            "id": "110450461",
            "speakerId": 1000,
            "speakerName": "阿贝多",
            "text": "这是…",
            "nextDialogs": [
              "110450401"
            ]
          },
          "110450401": {
            "id": "110450401",
            "speakerId": 1000,
            "speakerName": "阿贝多",
            "text": "据我所知，这个是一种文字，虽然遍布提瓦特大陆，但又谜团重重。",
            "nextDialogs": [
              "110450402"
            ]
          },
          "110450402": {
            "id": "110450402",
            "speakerId": 1000,
            "speakerName": "阿贝多",
            "text": "无法理解的地方还有很多，而且，为什么要将这几个符文留在这里，也很奇怪。",
            "nextDialogs": [
              "110450403"
            ]
          },
          "110450403": {
            "id": "110450403",
            "speakerId": 1000,
            "speakerName": "阿贝多",
            "text": "总之，我先将它抄录下来，等对你的研究结束之后，我会抽时间看看的。",
            "nextDialogs": [
              "110450404"
            ]
          },
          "110450404": {
            "id": "110450404",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "唉，又是看不懂的东西。我完全不知道这些很奇怪的问题和实验，能得到什么结果…",
            "nextDialogs": [
              "110450405"
            ]
          },
          "110450405": {
            "id": "110450405",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "但看来想要赚取报酬，都要付出与之对应的代价啊。",
            "nextDialogs": [
              "110450406"
            ]
          },
          "110450406": {
            "id": "110450406",
            "speakerId": 1000,
            "speakerName": "阿贝多",
            "text": "这次我实在是收获了很多很多，相较于此，提供微不足道的报酬，实在是不足挂齿的事。",
            "nextDialogs": [
              "110450407"
            ]
          },
          "110450407": {
            "id": "110450407",
            "speakerId": 1000,
            "speakerName": "阿贝多",
            "text": "我先回之前的营地去了，等你们回来的时候，我应该能让你们见证一个奇妙的瞬间。"
          }
        }
      }
    },
    {
      "subId": "1104505",
      "subQuestName": "返回营地，获取阿贝多的结论",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "110450501"
        ],
        "dialogs": {
          "110450501": {
            "id": "110450501",
            "speakerId": 1000,
            "speakerName": "阿贝多",
            "text": "你们回来了，正好这里差不多有结论了。",
            "nextDialogs": [
              "110450502"
            ]
          },
          "110450502": {
            "id": "110450502",
            "speakerId": 1000,
            "speakerName": "阿贝多",
            "text": "不过你们好像花了挺多时间的，难道是路上发生了什么吗？",
            "nextDialogs": [
              "110450506",
              "110450505"
            ]
          },
          "110450506": {
            "id": "110450506",
            "speakerId": 1000,
            "speakerName": "阿贝多",
            "text": "还是来说结论吧，今天获得了海量的数据，很难一次性将研究全部完成。",
            "nextDialogs": [
              "110450507"
            ]
          },
          "110450507": {
            "id": "110450507",
            "speakerId": 1000,
            "speakerName": "阿贝多",
            "text": "但可以给你一个整体性的初步结论，那就是——你非常像这个世界的人类。"
          },
          "110450505": {
            "id": "110450505",
            "speakerId": 1000,
            "speakerName": "阿贝多",
            "text": "那没关系，她只是在完成工作。"
          }
        }
      }
    },

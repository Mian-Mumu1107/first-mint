{
  "lineCounts": {
    "Player": 8,
    "卷舒": 16,
    "派蒙": 12
  },
  "subQuests": [
    {
      "subId": "7153201",
      "subQuestName": "与卷舒对话",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "715320101"
        ],
        "dialogs": {
          "715320101": {
            "id": "715320101",
            "speakerId": 30459,
            "speakerName": "卷舒",
            "text": "两位，说书人学徒卷舒恳请你们留步——",
            "nextDialogs": [
              "715320102"
            ]
          },
          "715320102": {
            "id": "715320102",
            "speakerId": 30459,
            "speakerName": "卷舒",
            "text": "你们可曾听说过这样一则传闻？「海灯节的良宵之时，曾有蹈跃的焰光在夜空中挥笔作画，描绘盛美的图卷…」",
            "nextDialogs": [
              "715320103"
            ]
          },
          "715320103": {
            "id": "715320103",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "没，没听懂！",
            "nextDialogs": [
              "715320104"
            ]
          },
          "715320104": {
            "id": "715320104",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "焰光？在天空中作画？一般人根本做不到这种事吧…就算坐着那什么飞艇，也没有可以浮在天上的神奇颜料。",
            "nextDialogs": [
              "715320105"
            ]
          },
          "715320105": {
            "id": "715320105",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "听起来像是很夸张的比方！",
            "nextDialogs": [
              "715320108"
            ]
          },
          "715320108": {
            "id": "715320108",
            "speakerId": 30459,
            "speakerName": "卷舒",
            "text": "#总之！这则传闻的主角就是你们两位，闻名遐迩的旅行者{NICKNAME}和{M#他}{F#她}的伙伴派蒙！",
            "nextDialogs": [
              "715320109"
            ]
          },
          "715320109": {
            "id": "715320109",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "咦？怎么话题突然转向了我们？",
            "nextDialogs": [
              "715320110"
            ]
          },
          "715320110": {
            "id": "715320110",
            "speakerId": 30459,
            "speakerName": "卷舒",
            "text": "也许你们已经忘记了，去年你们接受了冒险家甜甜的委托，参与了一场特别的竞速挑战。",
            "nextDialogs": [
              "715320111"
            ]
          },
          "715320111": {
            "id": "715320111",
            "speakerId": 30459,
            "speakerName": "卷舒",
            "text": "那场竞速挑战被漂亮的烟花点缀，蔚为壮观，成了难得一见的美景。",
            "nextDialogs": [
              "715320112"
            ]
          },
          "715320112": {
            "id": "715320112",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "这么说来，我隐约记得，当时我们只是举手之劳，帮了帮那位冒险家协会的宣传员…",
            "nextDialogs": [
              "715320113"
            ]
          },
          "715320113": {
            "id": "715320113",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "她说要借助那场活动来吸引新的成员，也不知道她后来有没有成功。"
          }
        }
      }
    }
  ]
}
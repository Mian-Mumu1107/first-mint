  "subQuests": [
    {
      "subId": "2211201",
      "subQuestName": "与淮安对话",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "221120101"
        ],
        "dialogs": {
          "221120101": {
            "id": "221120101",
            "speakerId": 1000,
            "speakerName": "淮安",
            "text": "看来还是不修不行啊…",
            "nextDialogs": [
              "221120102"
            ]
          },
          "221120102": {
            "id": "221120102",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "",
            "nextDialogs": [
              "221120103"
            ]
          },
          "221120103": {
            "id": "221120103",
            "speakerId": 1000,
            "speakerName": "淮安",
            "text": "哦，是您啊。瞧瞧，这上客栈的楼梯断了。",
            "nextDialogs": [
              "221120104"
            ]
          },
          "221120104": {
            "id": "221120104",
            "speakerId": 1000,
            "speakerName": "淮安",
            "text": "这么大的一截断口，路过的人太容易摔下去了…",
            "nextDialogs": [
              "221120105"
            ]
          },
          "221120105": {
            "id": "221120105",
            "speakerId": 1000,
            "speakerName": "淮安",
            "text": "怎么断的？哦，之前有一群怪物想要冲进客栈，我就出去处理了一下。",
            "nextDialogs": [
              "221120106"
            ]
          },
          "221120106": {
            "id": "221120106",
            "speakerId": 1000,
            "speakerName": "淮安",
            "text": "结果没收住手，把一个大块头怪物打了过来，一下子就把楼梯给砸烂了。",
            "nextDialogs": [
              "221120107"
            ]
          },
          "221120107": {
            "id": "221120107",
            "speakerId": 1000,
            "speakerName": "淮安",
            "text": "说要修，结果一直没空出时间来，现在客人越来越多，这楼梯实在是不修不行了。",
            "nextDialogs": [
              "221120108"
            ]
          },
          "221120108": {
            "id": "221120108",
            "speakerId": 1000,
            "speakerName": "淮安",
            "text": "这里还算好修，我一个人就能修好了。",
            "nextDialogs": [
              "221120109"
            ]
          },
          "221120109": {
            "id": "221120109",
            "speakerId": 1000,
            "speakerName": "淮安",
            "text": "如果有空的话，您能帮我去拿点木板来吗？我在这守着，免得又有人失足…",
            "nextDialogs": [
              "221120111",
              "221120114"
            ]
          },
          "221120111": {
            "id": "221120111",
            "speakerId": 1000,
            "speakerName": "淮安",
            "text": "那就麻烦您了，我专门买了一批木板来修这里，就放在客栈底下了。",
            "nextDialogs": [
              "221120112"
            ]
          },
          "221120112": {
            "id": "221120112",
            "speakerId": 1000,
            "speakerName": "淮安",
            "text": "您去看看，然后拿几块给我吧。"
          },
          "221120114": {
            "id": "221120114",
            "speakerId": 1000,
            "speakerName": "淮安",
            "text": "那不能，我又不是年轻的时候了…再来一次，我绝对能收住手。",
            "nextDialogs": [
              "221120115"
            ]
          },
          "221120115": {
            "id": "221120115",
            "speakerId": 1000,
            "speakerName": "淮安",
            "text": "不过，还是先得修好再说。为了这，我还专门买了一批木板，就放在客栈底下。",
            "nextDialogs": [
              "221120116"
            ]
          },
          "221120116": {
            "id": "221120116",
            "speakerId": 1000,
            "speakerName": "淮安",
            "text": "劳烦您，帮我下去拿点上来吧。"
          }
        }
      }
    },
    {
      "subId": "2211202",
      "subQuestName": "搜集5块木板",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "221120201"
        ],
        "dialogs": {
          "221120201": {
            "id": "221120201",
            "speakerId": 1000,
            "speakerName": "淮安",
            "text": "您找到了吗？",
            "nextDialogs": [
              "221120202"
            ]
          },
          "221120202": {
            "id": "221120202",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "还没有。",
            "nextDialogs": [
              "221120203"
            ]
          },
          "221120203": {
            "id": "221120203",
            "speakerId": 1000,
            "speakerName": "淮安",
            "text": "木板我都放在客栈底下了，应该挺好找的。",
            "nextDialogs": [
              "221120204"
            ]
          },
          "221120204": {
            "id": "221120204",
            "speakerId": 1000,
            "speakerName": "淮安",
            "text": "您去找找吧，我在这守着，免得又有人急匆匆地过来，一个不小心就下去了…"
          }
        }
      }
    },
    {
      "subId": "2211203",
      "subQuestName": "与淮安对话",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "221120301"
        ],
        "dialogs": {
          "221120301": {
            "id": "221120301",
            "speakerId": 1000,
            "speakerName": "淮安",
            "text": "您找到了吗？",
            "nextDialogs": [
              "221120302"
            ]
          },
          "221120302": {
            "id": "221120302",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "找到了。",
            "nextDialogs": [
              "221120303"
            ]
          },
          "221120303": {
            "id": "221120303",
            "speakerId": 1000,
            "speakerName": "淮安",
            "text": "我看看…差不多够了，辛苦您了。",
            "nextDialogs": [
              "221120304"
            ]
          },
          "221120304": {
            "id": "221120304",
            "speakerId": 1000,
            "speakerName": "淮安",
            "text": "我这就开工，得赶紧把这修好了…"
          }
        }
      }
    },
    {

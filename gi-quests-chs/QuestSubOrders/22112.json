    {
      "subId": "2211205",
      "subQuestName": "与淮安对话",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "221120501"
        ],
        "dialogs": {
          "221120501": {
            "id": "221120501",
            "speakerId": 1000,
            "speakerName": "淮安",
            "text": "行了，这样就可以走人了，应该也不会有人摔下去了。",
            "nextDialogs": [
              "221120502"
            ]
          },
          "221120502": {
            "id": "221120502",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "和楼梯看着不太搭…",
            "nextDialogs": [
              "221120503"
            ]
          },
          "221120503": {
            "id": "221120503",
            "speakerId": 1000,
            "speakerName": "淮安",
            "text": "不太搭？这也没办法，我也不是专业的木匠。",
            "nextDialogs": [
              "221120504"
            ]
          },
          "221120504": {
            "id": "221120504",
            "speakerId": 1000,
            "speakerName": "淮安",
            "text": "呼…不过，这还只是第一个，还有一个断口得修。",
            "nextDialogs": [
              "221120505"
            ]
          },
          "221120505": {
            "id": "221120505",
            "speakerId": 1000,
            "speakerName": "淮安",
            "text": "不过，今天就到这吧，客栈还开着，我还得去接待客人。",
            "nextDialogs": [
              "221120506"
            ]
          },
          "221120506": {
            "id": "221120506",
            "speakerId": 1000,
            "speakerName": "淮安",
            "text": "楼梯得修，生意也得做啊…辛苦您了，这些您拿着吧。"
          }
        }
      }
    }
  ]

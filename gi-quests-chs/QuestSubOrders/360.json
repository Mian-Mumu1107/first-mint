  "subQuests": [
    {
      "subId": "36001",
      "subQuestName": "消灭游荡的丘丘人",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "3600101"
        ],
        "dialogs": {
          "3600101": {
            "id": "3600101",
            "speakerId": 1002,
            "speakerName": "安柏",
            "text": "呼，小菜一碟。",
            "nextDialogs": [
              "3600102"
            ]
          },
          "3600102": {
            "id": "3600102",
            "speakerId": 1002,
            "speakerName": "安柏",
            "text": "不过没想到，原来你也不是没有战斗能力的路人…",
            "nextDialogs": [
              "3600103"
            ]
          },
          "3600103": {
            "id": "3600103",
            "speakerId": 1002,
            "speakerName": "安柏",
            "text": "谢谢你刚才的支援啦，这一战感觉如何？",
            "nextDialogs": [
              "3600106"
            ]
          },
          "3600106": {
            "id": "3600106",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "说起来，「丘丘人」怎么会出现在这里呢？",
            "nextDialogs": [
              "3600107"
            ]
          },
          "3600107": {
            "id": "3600107",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "这种生物，一般不会在离城市这么近的地方建立营地吧？",
            "nextDialogs": [
              "3600108"
            ]
          },
          "3600108": {
            "id": "3600108",
            "speakerId": 1002,
            "speakerName": "安柏",
            "text": "是啊。它们本该只在荒野游荡才对。",
            "nextDialogs": [
              "3600109"
            ]
          },
          "3600109": {
            "id": "3600109",
            "speakerId": 1002,
            "speakerName": "安柏",
            "text": "但最近风魔龙经常出现，果园被摧毁，商路也受到了影响。",
            "nextDialogs": [
              "3600110"
            ]
          },
          "3600110": {
            "id": "3600110",
            "speakerId": 1002,
            "speakerName": "安柏",
            "text": "风暴爆发时又经常有人受伤…所以骑士团要分心防御。",
            "nextDialogs": [
              "3600111"
            ]
          },
          "3600111": {
            "id": "3600111",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "所以这些烦人的生物，活动范围就越来越近？",
            "nextDialogs": [
              "3600112"
            ]
          },
          "3600112": {
            "id": "3600112",
            "speakerId": 1002,
            "speakerName": "安柏",
            "text": "是呀。不过今天又清理了一个营地，还是很有收获的。",
            "nextDialogs": [
              "3600113"
            ]
          },
          "3600113": {
            "id": "3600113",
            "speakerId": 1002,
            "speakerName": "安柏",
            "text": "跟我来吧！认真负责的好骑士要护送你们进城了。"
          }
        }
      }
    },

{
  "lineCounts": {
    "派蒙": 1,
    "漂流瓶": 7
  },
  "subQuests": [
    {
      "subId": "7012801",
      "subQuestName": "(test)(隐藏)漂流瓶3$HIDDEN",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "701280101"
        ],
        "dialogs": {
          "701280101": {
            "id": "701280101",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "欸，这个瓶子沉甸甸的，好像里面有什么东西…",
            "nextDialogs": [
              "701280102"
            ]
          },
          "701280102": {
            "id": "701280102",
            "speakerId": 20214,
            "speakerName": "漂流瓶",
            "text": "「我们的老朋友昨天来了，带来了坏消息…」",
            "nextDialogs": [
              "701280103"
            ]
          },
          "701280103": {
            "id": "701280103",
            "speakerId": 20214,
            "speakerName": "漂流瓶",
            "text": "「很久以来一直没有得到回应。或许他说的对，我应该接受现实。」",
            "nextDialogs": [
              "701280104"
            ]
          },
          "701280104": {
            "id": "701280104",
            "speakerId": 20214,
            "speakerName": "漂流瓶",
            "text": "「但无论如何。假如你还在东奔西走，假如你收到了这条信息，希望你能回应我。」",
            "nextDialogs": [
              "701280105"
            ]
          },
          "701280105": {
            "id": "701280105",
            "speakerId": 20214,
            "speakerName": "漂流瓶",
            "text": "「随信附上你的徽章，以便到时候我会借它认出你。」",
            "nextDialogs": [
              "701280106"
            ]
          },
          "701280106": {
            "id": "701280106",
            "speakerId": 20214,
            "speakerName": "漂流瓶",
            "text": "「还记得『乌有亭』吗？我们会在那里相聚，酒钱也随信寄来了。」",
            "nextDialogs": [
              "701280107"
            ]
          },
          "701280107": {
            "id": "701280107",
            "speakerId": 20214,
            "speakerName": "漂流瓶",
            "text": "「如果收到这封信的您，并不是我所期待的人…」",
            "nextDialogs": [
              "701280108"
            ]
          },
          "701280108": {
            "id": "701280108",
            "speakerId": 20214,
            "speakerName": "漂流瓶",
            "text": "「也希望您留下这枚信物，或许您能帮助我寻得它的旧主，这些摩拉权作谢意。」"
          }
        }
      }
    }
  ]
}
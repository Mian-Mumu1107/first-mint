{
  "lineCounts": {
    "Black Screen": 1,
    "Player": 4,
    "奈芙尔": 24,
    "德文特？": 7,
    "派蒙": 4,
    "雅珂达": 7
  },
  "subQuests": [
    {
      "subId": "7611501",
      "subQuestName": "前往「旗舰」",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "761150101"
        ],
        "dialogs": {
          "761150101": {
            "id": "761150101",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "欸？奈芙尔和雅珂达！你们怎么在这里？",
            "nextDialogs": [
              "761150102"
            ]
          },
          "761150102": {
            "id": "761150102",
            "speakerId": 1317,
            "speakerName": "雅珂达",
            "text": "当然是为了工作咯。之前一直没有线索的悬赏目标，已经被我们找到啦。",
            "nextDialogs": [
              "761150103"
            ]
          },
          "761150103": {
            "id": "761150103",
            "speakerId": 1002,
            "speakerName": "Black Screen",
            "text": "听雅珂达大致介绍了悬赏目标「裂颚」哈尔克，以及此前「秘闻馆」调查到的信息…",
            "nextDialogs": [
              "761150104"
            ]
          },
          "761150104": {
            "id": "761150104",
            "speakerId": 1316,
            "speakerName": "奈芙尔",
            "text": "先说结论吧，真正的隐者德文特多半已经遇害，而现在占据了隐者小屋的就是悬赏目标「裂颚」哈尔克。",
            "nextDialogs": [
              "761150105"
            ]
          },
          "761150105": {
            "id": "761150105",
            "speakerId": 1316,
            "speakerName": "奈芙尔",
            "text": "雅珂达找到的日志残片也可以作为旁证，德文特在知道一切的情况下依然收留了他。",
            "nextDialogs": [
              "761150106"
            ]
          },
          "761150106": {
            "id": "761150106",
            "speakerId": 1316,
            "speakerName": "奈芙尔",
            "text": "毫不意外，哈尔克故态复萌，在了结了德文特之后又窃取了他的身份。",
            "nextDialogs": [
              "761150107"
            ]
          },
          "761150107": {
            "id": "761150107",
            "speakerId": 1317,
            "speakerName": "雅珂达",
            "text": "虽然之前去调查的时候没见上面，但小屋里的家伙不管怎么想都不可能是德文特先生。",
            "nextDialogs": [
              "761150108"
            ]
          },
          "761150108": {
            "id": "761150108",
            "speakerId": 1317,
            "speakerName": "雅珂达",
            "text": "而且只要自称隐者，就算做些奇怪的事也不会被怀疑。那面罩肯定不是为了修行，而是为了遮盖下巴上的伤疤。",
            "nextDialogs": [
              "761150109"
            ]
          },
          "761150109": {
            "id": "761150109",
            "speakerId": 1316,
            "speakerName": "奈芙尔",
            "text": "至于下落不明的游商，做最坏的考虑，可能也已经遇害。",
            "nextDialogs": [
              "761150110"
            ]
          },
          "761150110": {
            "id": "761150110",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "做了这么多坏事，还两次恩将仇报，到底是什么样的恶棍啊…",
            "nextDialogs": [
              "761150111"
            ]
          },
          "761150111": {
            "id": "761150111",
            "speakerId": 1316,
            "speakerName": "奈芙尔",
            "text": "我推测，「流浪之环」货品失窃案确实与哈尔克无关，作案的动机太薄弱了。",
            "nextDialogs": [
              "761150112"
            ]
          },
          "761150112": {
            "id": "761150112",
            "speakerId": 1316,
            "speakerName": "奈芙尔",
            "text": "他在这十年间从未逾矩，失窃货品的价值足以让他放弃辛苦构筑的一切吗？我看未必。",
            "nextDialogs": [
              "761150113"
            ]
          },
          "761150113": {
            "id": "761150113",
            "speakerId": 1316,
            "speakerName": "奈芙尔",
            "text": "那么我们不妨做一些假设。",
            "nextDialogs": [
              "761150114"
            ]
          },
          "761150114": {
            "id": "761150114",
            "speakerId": 1316,
            "speakerName": "奈芙尔",
            "text": "已知在事发后，他回到阿特拉号的残骸附近，攻击了来寻宝的宝藏猎人。当人身处困境，回归起点便是一种本能。",
            "nextDialogs": [
              "761150115"
            ]
          },
          "761150115": {
            "id": "761150115",
            "speakerId": 1316,
            "speakerName": "奈芙尔",
            "text": "当他还在阿特拉号上当舵手时，声名、财富，都不在话下。但加入「流浪之环」后又如何？",
            "nextDialogs": [
              "761150116"
            ]
          },
          "761150116": {
            "id": "761150116",
            "speakerId": 1316,
            "speakerName": "奈芙尔",
            "text": "哪怕十年间都循规蹈矩，当窃案发生时，人们依然将怀疑的目光和言语投向他。",
            "nextDialogs": [
              "761150117"
            ]
          },
          "761150117": {
            "id": "761150117",
            "speakerId": 1316,
            "speakerName": "奈芙尔",
            "text": "而更让他难以接受的，恐怕是与他出身相同，但过去只是无名之辈的朱亚尼现在反倒如鱼得水。",
            "nextDialogs": [
              "761150118"
            ]
          },
          "761150118": {
            "id": "761150118",
            "speakerId": 1316,
            "speakerName": "奈芙尔",
            "text": "即使他当面指控朱亚尼，也无人采信他的说辞。",
            "nextDialogs": [
              "761150119"
            ]
          },
          "761150119": {
            "id": "761150119",
            "speakerId": 1316,
            "speakerName": "奈芙尔",
            "text": "被失望和愤怒裹挟，他犯下了第一个错。这次事件，就是他人生的转折点。",
            "nextDialogs": [
              "761150120"
            ]
          },
          "761150120": {
            "id": "761150120",
            "speakerId": 1316,
            "speakerName": "奈芙尔",
            "text": "之后在隐者小屋发生的事应该也大同小异…哪怕是微小的矛盾也会引发致命的冲突。",
            "nextDialogs": [
              "761150121"
            ]
          },
          "761150121": {
            "id": "761150121",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "#{NICKNAME}，这么危险的家伙，我们也不能放着不管吧？",
            "nextDialogs": [
              "761150124"
            ]
          },
          "761150124": {
            "id": "761150124",
            "speakerId": 1316,
            "speakerName": "奈芙尔",
            "text": "#既然{NICKNAME}主动请缨，那就让雅珂达休息一个回合吧。",
            "nextDialogs": [
              "761150125"
            ]
          },
          "761150125": {
            "id": "761150125",
            "speakerId": 1317,
            "speakerName": "雅珂达",
            "text": "之前调查我也出了不少力嘛！就当给我放个假。",
            "nextDialogs": [
              "761150126"
            ]
          },
          "761150126": {
            "id": "761150126",
            "speakerId": 1316,
            "speakerName": "奈芙尔",
            "text": "至于前面所说的假设是否无误，待我们会一会他便知分晓。"
          }
        }
      }
    },
    {
      "subId": "7611502",
      "subQuestName": "前往隐者小屋",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "761150201"
        ],
        "dialogs": {
          "761150201": {
            "id": "761150201",
            "speakerId": 1004,
            "speakerName": "德文特？",
            "text": "…我没招惹过你们。",
            "nextDialogs": [
              "761150202"
            ]
          },
          "761150202": {
            "id": "761150202",
            "speakerId": 1316,
            "speakerName": "奈芙尔",
            "text": "看来你很清楚我们为什么来。",
            "nextDialogs": [
              "761150203"
            ]
          },
          "761150203": {
            "id": "761150203",
            "speakerId": 1004,
            "speakerName": "德文特？",
            "text": "…那都是过去的事，现在我只想过平静的生活。",
            "nextDialogs": [
              "761150204"
            ]
          },
          "761150204": {
            "id": "761150204",
            "speakerId": 1316,
            "speakerName": "奈芙尔",
            "text": "靠夺取他人的身份吗？先是朱亚尼，但没有成功，之后又是德文特。",
            "nextDialogs": [
              "761150205"
            ]
          },
          "761150205": {
            "id": "761150205",
            "speakerId": 1316,
            "speakerName": "奈芙尔",
            "text": "不过拙劣的扮演迟早被揭穿，不会再有下一个受害者了。",
            "nextDialogs": [
              "761150206"
            ]
          },
          "761150206": {
            "id": "761150206",
            "speakerId": 1004,
            "speakerName": "德文特？",
            "text": "…朱亚尼？我想要夺取他的身份？",
            "nextDialogs": [
              "761150207"
            ]
          },
          "761150207": {
            "id": "761150207",
            "speakerId": 1004,
            "speakerName": "德文特？",
            "text": "那不是他的…那凭什么是他的？就因为他长得更讨人喜欢，说话更会奉承吗？",
            "nextDialogs": [
              "761150208"
            ]
          },
          "761150208": {
            "id": "761150208",
            "speakerId": 1004,
            "speakerName": "德文特？",
            "text": "我们明明是一样的！…被他拿走的东西，本来就是属于我的！",
            "nextDialogs": [
              "761150209"
            ]
          },
          "761150209": {
            "id": "761150209",
            "speakerId": 1317,
            "speakerName": "雅珂达",
            "text": "那德文特先生和游商呢？他们又对你做了什么？",
            "nextDialogs": [
              "761150210"
            ]
          },
          "761150210": {
            "id": "761150210",
            "speakerId": 1004,
            "speakerName": "德文特？",
            "text": "…他们？他们问了不该问的问题，就像你们一样。",
            "nextDialogs": [
              "761150211"
            ]
          },
          "761150211": {
            "id": "761150211",
            "speakerId": 1004,
            "speakerName": "德文特？",
            "text": "受死吧！"
          }
        }
      }
    },
    {
      "subId": "7611503",
      "subQuestName": "击败「裂颚」哈尔克",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "761150301"
        ],
        "dialogs": {
          "761150301": {
            "id": "761150301",
            "speakerId": 1316,
            "speakerName": "奈芙尔",
            "text": "只知重复昨日之我的可悲之人，和预想的一样，不得不说也有些无趣。",
            "nextDialogs": [
              "761150302"
            ]
          },
          "761150302": {
            "id": "761150302",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "他明明都坚持不做坏事那么久了，最后却还是…还是说，他天生就是坏人，坏人是不会变好的？",
            "nextDialogs": [
              "761150305"
            ]
          },
          "761150305": {
            "id": "761150305",
            "speakerId": 1316,
            "speakerName": "奈芙尔",
            "text": "选择的权利始终都在，哪怕是刚才，他也可以选择认错忏悔。只是他又一次选错了。",
            "nextDialogs": [
              "761150306"
            ]
          },
          "761150306": {
            "id": "761150306",
            "speakerId": 1316,
            "speakerName": "奈芙尔",
            "text": "落子皆错，方有今日这盘死局。",
            "nextDialogs": [
              "761150307"
            ]
          },
          "761150307": {
            "id": "761150307",
            "speakerId": 1316,
            "speakerName": "奈芙尔",
            "text": "#不说这些了，总归是又了结了一桩工作。悬赏的证物就依约定，由{NICKNAME}交给勒塞克吧。",
            "nextDialogs": [
              "761150308"
            ]
          },
          "761150308": {
            "id": "761150308",
            "speakerId": 1317,
            "speakerName": "雅珂达",
            "text": "#有老板和{NICKNAME}出马就是叫人放心！这次我真的放假啦。",
            "nextDialogs": [
              "761150309"
            ]
          },
          "761150309": {
            "id": "761150309",
            "speakerId": 1316,
            "speakerName": "奈芙尔",
            "text": "呵呵，既然休息的一回合已经结束，雅珂达也该开始新的工作了吧？",
            "nextDialogs": [
              "761150310"
            ]
          },
          "761150310": {
            "id": "761150310",
            "speakerId": 1317,
            "speakerName": "雅珂达",
            "text": "欸——"
          }
        }
      }
    },
    {
      "subId": "7611504",
      "subQuestName": "与奈芙尔对话",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [],
        "dialogs": {}
      }
    }
  ]
}
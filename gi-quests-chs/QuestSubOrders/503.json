  "subQuests": [
    {
      "subId": "50301",
      "subQuestName": "",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "5030101"
        ],
        "dialogs": {
          "5030101": {
            "id": "5030101",
            "speakerId": 1000,
            "speakerName": "吃虎岩公告板",
            "text": "此乃吃虎岩公告板，街区新闻、店铺广告，无论大小，皆以公示。闲人如无要事，请勿擅自张贴。",
            "nextDialogs": [
              "5030102"
            ]
          },
          "5030102": {
            "id": "5030102",
            "speakerId": 1001,
            "speakerName": "千岩军公告",
            "text": "「水澈无瑕，瘴毒避之。擅浊其源，大疫出之。无心之失，尚可宽之。滥觞浊淖，严惩毋恕。」",
            "nextDialogs": [
              "5030103"
            ]
          },
          "5030103": {
            "id": "5030103",
            "speakerId": 1001,
            "speakerName": "千岩军公告",
            "text": "近来绯云坡水源污染，玉京台已遣专业人员紧急处理，不日将洁净如初。",
            "nextDialogs": [
              "5030104"
            ]
          },
          "5030104": {
            "id": "5030104",
            "speakerId": 1001,
            "speakerName": "千岩军公告",
            "text": "千岩军特此提示，来吃虎岩取水者请务必自觉维持秩序，保护水质清洁。",
            "nextDialogs": [
              "5030105"
            ]
          },
          "5030105": {
            "id": "5030105",
            "speakerId": 1001,
            "speakerName": "千岩军公告",
            "text": "如有破坏秩序、脏污水源者，当报知千岩军，必加以严惩。"
          }
        }
      }
    },
    {
      "subId": "50302",
      "subQuestName": "",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "5030201"
        ],
        "dialogs": {
          "5030201": {
            "id": "5030201",
            "speakerId": 1000,
            "speakerName": "吃虎岩公告板",
            "text": "此乃吃虎岩公告板，街区新闻、店铺广告，无论大小，皆以公示。闲人如无要事，请勿擅自张贴。",
            "nextDialogs": [
              "5030202"
            ]
          },
          "5030202": {
            "id": "5030202",
            "speakerId": 1002,
            "speakerName": "万民堂广告",
            "text": "万民百味，众口能调！",
            "nextDialogs": [
              "5030203"
            ]
          },
          "5030203": {
            "id": "5030203",
            "speakerId": 1002,
            "speakerName": "万民堂广告",
            "text": "用全新的美味，唤起您的美好回忆！",
            "nextDialogs": [
              "5030204"
            ]
          },
          "5030204": {
            "id": "5030204",
            "speakerId": 1002,
            "speakerName": "万民堂广告",
            "text": "万民堂，静候您的光临！",
            "nextDialogs": [
              "5030205"
            ]
          },
          "5030205": {
            "id": "5030205",
            "speakerId": 1003,
            "speakerName": "留言",
            "text": "「今天也是香菱下厨吗？」",
            "nextDialogs": [
              "5030206"
            ]
          },
          "5030206": {
            "id": "5030206",
            "speakerId": 1004,
            "speakerName": "回复",
            "text": "「实在抱歉，小女近日正遍游七国修习厨艺，颇需时日才能回来。」"
          }
        }
      }
    },
    {
      "subId": "50303",
      "subQuestName": "",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "5030301"
        ],
        "dialogs": {
          "5030301": {
            "id": "5030301",
            "speakerId": 1000,
            "speakerName": "吃虎岩公告板",
            "text": "此乃吃虎岩公告板，街区新闻、店铺广告，无论大小，皆以公示。闲人如无要事，请勿擅自张贴。",
            "nextDialogs": [
              "5030302"
            ]
          },
          "5030302": {
            "id": "5030302",
            "speakerId": 1005,
            "speakerName": "快刀陈广告",
            "text": "名门手艺，快刀利民！",
            "nextDialogs": [
              "5030303"
            ]
          },
          "5030303": {
            "id": "5030303",
            "speakerId": 1005,
            "speakerName": "快刀陈广告",
            "text": "疾刃猛火，地道烤鱼！",
            "nextDialogs": [
              "5030304"
            ]
          },
          "5030304": {
            "id": "5030304",
            "speakerId": 1005,
            "speakerName": "快刀陈广告",
            "text": "想吃全璃月最地道的烤吃虎鱼，找我快刀陈！",
            "nextDialogs": [
              "5030305"
            ]
          },
          "5030305": {
            "id": "5030305",
            "speakerId": 1003,
            "speakerName": "留言",
            "text": "「师兄生意可好？近来可有空闲？我们古华派老人也该一聚叙旧了。」",
            "nextDialogs": [
              "5030306"
            ]
          },
          "5030306": {
            "id": "5030306",
            "speakerId": 1004,
            "speakerName": "回复",
            "text": "「好！就等贤弟安排了！或者来敝店也好，酒菜由我买单！」"
          }
        }
      }
    },
    {
      "subId": "50304",
      "subQuestName": "",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "5030401"
        ],
        "dialogs": {
          "5030401": {
            "id": "5030401",
            "speakerId": 1000,
            "speakerName": "吃虎岩公告板",
            "text": "此乃吃虎岩公告板，街区新闻、店铺广告，无论大小，皆以公示。闲人如无要事，请勿擅自张贴。",
            "nextDialogs": [
              "5030402"
            ]
          },
          "5030402": {
            "id": "5030402",
            "speakerId": 1006,
            "speakerName": "寒锋铁器广告",
            "text": "寒锋冰刃，千磨万砺！",
            "nextDialogs": [
              "5030403"
            ]
          },
          "5030403": {
            "id": "5030403",
            "speakerId": 1006,
            "speakerName": "寒锋铁器广告",
            "text": "寒锋铁器，大众的铁匠！不论您是剑客大侠，还是市井阿婆，包您满意而归！"
          }
        }
      }
    },
    {
      "subId": "50305",
      "subQuestName": "",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "5030501"
        ],
        "dialogs": {
          "5030501": {
            "id": "5030501",
            "speakerId": 1000,
            "speakerName": "吃虎岩公告板",
            "text": "此乃吃虎岩公告板，街区新闻、店铺广告，无论大小，皆以公示。闲人如无要事，请勿擅自张贴。",
            "nextDialogs": [
              "5030502"
            ]
          },
          "5030502": {
            "id": "5030502",
            "speakerId": 1003,
            "speakerName": "留言",
            "text": "「敝人近日丢失长枪一杆，外形恰好与千岩军制式略同。望好心人提供帮助，必有重谢！」",
            "nextDialogs": [
              "5030503"
            ]
          },
          "5030503": {
            "id": "5030503",
            "speakerId": 1003,
            "speakerName": "留言",
            "text": "「如有好心人寻回长枪或愿提供相关线索，请前往船厂附近与我碰面。」",
            "nextDialogs": [
              "5030504"
            ]
          },
          "5030504": {
            "id": "5030504",
            "speakerId": 1003,
            "speakerName": "留言",
            "text": "「无论您是外地人还是璃月市民，敝人均感激不尽！」"
          }
        }
      }
    },
    {
      "subId": "50306",
      "subQuestName": "",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "5030601"
        ],
        "dialogs": {
          "5030601": {
            "id": "5030601",
            "speakerId": 1000,
            "speakerName": "吃虎岩公告板",
            "text": "此乃吃虎岩公告板，街区新闻、店铺广告，无论大小，皆以公示。闲人如无要事，请勿擅自张贴。",
            "nextDialogs": [
              "5030602"
            ]
          },
          "5030602": {
            "id": "5030602",
            "speakerId": 1007,
            "speakerName": "冒险家协会公告",
            "text": "向着星辰与深渊！冒险家协会璃月分会欢迎您的光临！",
            "nextDialogs": [
              "5030603"
            ]
          },
          "5030603": {
            "id": "5030603",
            "speakerId": 1007,
            "speakerName": "冒险家协会公告",
            "text": "在仰望星辰时，您是否热望着天幕深处的胜景？",
            "nextDialogs": [
              "5030604"
            ]
          },
          "5030604": {
            "id": "5030604",
            "speakerId": 1007,
            "speakerName": "冒险家协会公告",
            "text": "在俯视山涧时，您是否渴求着深渊之下的秘宝？",
            "nextDialogs": [
              "5030605"
            ]
          },
          "5030605": {
            "id": "5030605",
            "speakerId": 1007,
            "speakerName": "冒险家协会公告",
            "text": "请报名冒险家协会，与我们一同征服所有险境，揭开一切神秘！",
            "nextDialogs": [
              "5030606"
            ]
          },
          "5030606": {
            "id": "5030606",
            "speakerId": 1007,
            "speakerName": "冒险家协会公告",
            "text": "详情敬请咨询凯瑟琳小姐。"
          }
        }
      }
    },
    {
      "subId": "50307",
      "subQuestName": "",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "5030701"
        ],
        "dialogs": {
          "5030701": {
            "id": "5030701",
            "speakerId": 1000,
            "speakerName": "吃虎岩公告板",
            "text": "此乃吃虎岩公告板，街区新闻、店铺广告，无论大小，皆以公示。闲人如无要事，请勿擅自张贴。",
            "nextDialogs": [
              "5030702"
            ]
          },
          "5030702": {
            "id": "5030702",
            "speakerId": 1008,
            "speakerName": "新鲜鱼摊广告",
            "text": "新鲜鱼摊，绝对新鲜！一分价钱一分货，谢绝还价！",
            "nextDialogs": [
              "5030703"
            ]
          },
          "5030703": {
            "id": "5030703",
            "speakerId": 1009,
            "speakerName": "超·新鲜鱼摊广告",
            "text": "超·新鲜鱼摊，给您超一流的服务！价格低廉，绝对超鲜！"
          }
        }
      }
    },
    {
      "subId": "50308",
      "subQuestName": "",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "5030801"
        ],
        "dialogs": {
          "5030801": {
            "id": "5030801",
            "speakerId": 1000,
            "speakerName": "吃虎岩公告板",
            "text": "此乃吃虎岩公告板，街区新闻、店铺广告，无论大小，皆以公示。闲人如无要事，请勿擅自张贴。",
            "nextDialogs": [
              "5030802"
            ]
          },
          "5030802": {
            "id": "5030802",
            "speakerId": 1010,
            "speakerName": "三碗不过港广告",
            "text": "三碗不过港，百年老店，古法酿造！",
            "nextDialogs": [
              "5030803"
            ]
          },
          "5030803": {
            "id": "5030803",
            "speakerId": 1010,
            "speakerName": "三碗不过港广告",
            "text": "纯正酒酿圆子，三碗包您不舍出港！"
          }
        }
      }
    },
    {
      "subId": "50309",
      "subQuestName": "",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "5030901"
        ],
        "dialogs": {
          "5030901": {
            "id": "5030901",
            "speakerId": 1000,
            "speakerName": "吃虎岩公告板",
            "text": "此乃吃虎岩公告板，街区新闻、店铺广告，无论大小，皆以公示。闲人如无要事，请勿擅自张贴。",
            "nextDialogs": [
              "5030902"
            ]
          },
          "5030902": {
            "id": "5030902",
            "speakerId": 1003,
            "speakerName": "留言",
            "text": "「大姐我也不太会打广告，就直接写张纸条贴在留言板上吧！」",
            "nextDialogs": [
              "5030903"
            ]
          },
          "5030903": {
            "id": "5030903",
            "speakerId": 1003,
            "speakerName": "留言",
            "text": "「我家中原杂碎，好吃不贵！又香又辣，准保味儿足！」",
            "nextDialogs": [
              "5030904"
            ]
          },
          "5030904": {
            "id": "5030904",
            "speakerId": 1011,
            "speakerName": "千岩军回复",
            "text": "「苏二娘，这是公告板，不是留言板…」",
            "nextDialogs": [
              "5030905"
            ]
          },
          "5030905": {
            "id": "5030905",
            "speakerId": 1011,
            "speakerName": "千岩军回复",
            "text": "「刊登广告请找千岩军登记，请不要张贴无关内容。」",
            "nextDialogs": [
              "5030906"
            ]
          },
          "5030906": {
            "id": "5030906",
            "speakerId": 1003,
            "speakerName": "留言",
            "text": "「辛苦小伙子们了，等换班一起来吃点吧！大姐给优惠！」"
          }
        }
      }
    },
    {
      "subId": "50310",
      "subQuestName": "",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "5031001"
        ],
        "dialogs": {
          "5031001": {
            "id": "5031001",
            "speakerId": 1000,
            "speakerName": "吃虎岩公告板",
            "text": "此乃吃虎岩公告板，街区新闻、店铺广告，无论大小，皆以公示。闲人如无要事，请勿擅自张贴。",
            "nextDialogs": [
              "5031002"
            ]
          },
          "5031002": {
            "id": "5031002",
            "speakerId": 1003,
            "speakerName": "留言",
            "text": "「在一年的每一天中，每一次潮起潮落，大海泛起的每一朵浪花都有所不同。」",
            "nextDialogs": [
              "5031003"
            ]
          },
          "5031003": {
            "id": "5031003",
            "speakerId": 1003,
            "speakerName": "留言",
            "text": "「今天的我，依然在看着一朵朵浪花形成复又破碎，思念着你。」",
            "nextDialogs": [
              "5031004"
            ]
          },
          "5031004": {
            "id": "5031004",
            "speakerId": 1003,
            "speakerName": "留言",
            "text": "「我把我的思念写在这里，不知远洋归来的你，何时能够看到？」",
            "nextDialogs": [
              "5031005"
            ]
          },
          "5031005": {
            "id": "5031005",
            "speakerId": 1003,
            "speakerName": "留言",
            "text": "「不知与我重逢的你，何时能够兑现承诺？」",
            "nextDialogs": [
              "5031006"
            ]
          },
          "5031006": {
            "id": "5031006",
            "speakerId": 1011,
            "speakerName": "千岩军回复",
            "text": "「请不要在公告板上张贴情书，谢谢合作。」"
          }
        }
      }
    },
    {
      "subId": "50311",
      "subQuestName": "",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "5031101"
        ],
        "dialogs": {
          "5031101": {
            "id": "5031101",
            "speakerId": 1000,
            "speakerName": "吃虎岩公告板",
            "text": "此乃吃虎岩公告板，街区新闻、店铺广告，无论大小，皆以公示。闲人如无要事，请勿擅自张贴。",
            "nextDialogs": [
              "5031102"
            ]
          },
          "5031102": {
            "id": "5031102",
            "speakerId": 1001,
            "speakerName": "千岩军公告",
            "text": "层岩巨渊诸多矿藏均已停工，但近来盗运原矿活动风头又起。",
            "nextDialogs": [
              "5031103"
            ]
          },
          "5031103": {
            "id": "5031103",
            "speakerId": 1001,
            "speakerName": "千岩军公告",
            "text": "望璃月市民多加小心，积极配合千岩军缉拿走私犯。",
            "nextDialogs": [
              "5031104"
            ]
          },
          "5031104": {
            "id": "5031104",
            "speakerId": 1001,
            "speakerName": "千岩军公告",
            "text": "玉石商铺等亦当严格遵守法度，不得私购非法矿石。如有查出，从重罚款。"
          }
        }
      }
    },
    {
      "subId": "50312",
      "subQuestName": "",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "5031201"
        ],
        "dialogs": {
          "5031201": {
            "id": "5031201",
            "speakerId": 1000,
            "speakerName": "吃虎岩公告板",
            "text": "此乃吃虎岩公告板，街区新闻、店铺广告，无论大小，皆以公示。闲人如无要事，请勿擅自张贴。",
            "nextDialogs": [
              "5031202"
            ]
          },
          "5031202": {
            "id": "5031202",
            "speakerId": 1012,
            "speakerName": "解翠行广告",
            "text": "人生有命，正如玉隐石中。若不当机立断，若无慧眼快刀，便要追悔莫及。",
            "nextDialogs": [
              "5031203"
            ]
          },
          "5031203": {
            "id": "5031203",
            "speakerId": 1012,
            "speakerName": "解翠行广告",
            "text": "只不过，人生只有一次，解翠之戏却还能再来。令人心跳加速的冒险与赢得美玉的欣喜交汇，何种游戏能超越这等刺激？",
            "nextDialogs": [
              "5031204"
            ]
          },
          "5031204": {
            "id": "5031204",
            "speakerId": 1012,
            "speakerName": "解翠行广告",
            "text": "小小的代价，大大的惊喜。",
            "nextDialogs": [
              "5031205"
            ]
          },
          "5031205": {
            "id": "5031205",
            "speakerId": 1012,
            "speakerName": "解翠行广告",
            "text": "刺激与好运，尽在解翠行！",
            "nextDialogs": [
              "5031206"
            ]
          },
          "5031206": {
            "id": "5031206",
            "speakerId": 1012,
            "speakerName": "解翠行广告",
            "text": "敝店近来又进一车璞石，欢迎贵客赏光同乐。"
          }
        }
      }
    },
    {
      "subId": "50313",
      "subQuestName": "",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "5031301"
        ],
        "dialogs": {
          "5031301": {
            "id": "5031301",
            "speakerId": 1000,
            "speakerName": "吃虎岩公告板",
            "text": "此乃吃虎岩公告板，街区新闻、店铺广告，无论大小，皆以公示。闲人如无要事，请勿擅自张贴。",
            "nextDialogs": [
              "5031302"
            ]
          },
          "5031302": {
            "id": "5031302",
            "speakerId": 1013,
            "speakerName": "春香窑广告",
            "text": "曼曼袅娜，悦君星目。如瑶如瑰，轻抚细摩。",
            "nextDialogs": [
              "5031303"
            ]
          },
          "5031303": {
            "id": "5031303",
            "speakerId": 1013,
            "speakerName": "春香窑广告",
            "text": "珠圆玉润，温软生香。清露泠泠，声出幽媚。",
            "nextDialogs": [
              "5031304"
            ]
          },
          "5031304": {
            "id": "5031304",
            "speakerId": 1013,
            "speakerName": "春香窑广告",
            "text": "春香一缕，难忘一生。君子美器，正自相宜。"
          }
        }
      }
    },
    {
      "subId": "50314",
      "subQuestName": "",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "5031401"
        ],
        "dialogs": {
          "5031401": {
            "id": "5031401",
            "speakerId": 1000,
            "speakerName": "吃虎岩公告板",
            "text": "此乃吃虎岩公告板，街区新闻、店铺广告，无论大小，皆以公示。闲人如无要事，请勿擅自张贴。",
            "nextDialogs": [
              "5031402"
            ]
          },
          "5031402": {
            "id": "5031402",
            "speakerId": 1014,
            "speakerName": "岩上茶室广告",
            "text": "卸去一天的劳累，岩上茶室是您的夜生活避风港！",
            "nextDialogs": [
              "5031403"
            ]
          },
          "5031403": {
            "id": "5031403",
            "speakerId": 1014,
            "speakerName": "岩上茶室广告",
            "text": "本店专供上等好茶，贵客须缴纳押金方可入店，敬请谅解。"
          }
        }
      }
    },
    {
      "subId": "50315",
      "subQuestName": "",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "5031501"
        ],
        "dialogs": {
          "5031501": {
            "id": "5031501",
            "speakerId": 1000,
            "speakerName": "吃虎岩公告板",
            "text": "此乃吃虎岩公告板，街区新闻、店铺广告，无论大小，皆以公示。闲人如无要事，请勿擅自张贴。",
            "nextDialogs": [
              "5031502"
            ]
          },
          "5031502": {
            "id": "5031502",
            "speakerId": 1003,
            "speakerName": "留言",
            "text": "「明天我就要正式入伍了，今天大家不醉不休！」",
            "nextDialogs": [
              "5031503"
            ]
          },
          "5031503": {
            "id": "5031503",
            "speakerId": 1003,
            "speakerName": "留言",
            "text": "「我那个臭老爹说我永远也当不了兵，明天开始我就要证明给他看，什么叫好兵！」",
            "nextDialogs": [
              "5031504"
            ]
          },
          "5031504": {
            "id": "5031504",
            "speakerId": 1004,
            "speakerName": "回复",
            "text": "「这位新兵，明早请来巡逻站报到，自领检查记过处分。」",
            "nextDialogs": [
              "5031505"
            ]
          },
          "5031505": {
            "id": "5031505",
            "speakerId": 1004,
            "speakerName": "回复",
            "text": "「千岩军同侪应当以身作则，认真对待公告板，不可招贴与公告无关的信息。」"
          }
        }
      }
    },
    {
      "subId": "50316",
      "subQuestName": "",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "5031601"
        ],
        "dialogs": {
          "5031601": {
            "id": "5031601",
            "speakerId": 1000,
            "speakerName": "吃虎岩公告板",
            "text": "此乃吃虎岩公告板，街区新闻、店铺广告，无论大小，皆以公示。闲人如无要事，请勿擅自张贴。",
            "nextDialogs": [
              "5031602"
            ]
          },
          "5031602": {
            "id": "5031602",
            "speakerId": 1001,
            "speakerName": "千岩军公告",
            "text": "近来碧波鱼市一带似有走私商贩活动，望市民加以注意，积极报知千岩军。",
            "nextDialogs": [
              "5031603"
            ]
          },
          "5031603": {
            "id": "5031603",
            "speakerId": 1001,
            "speakerName": "千岩军公告",
            "text": "另：循七星新令，千岩军将对碧波鱼市商贩执照加紧盘查，望商贩做好准备。"
          }
        }
      }
    },
    {
      "subId": "50317",
      "subQuestName": "",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "5031701"
        ],
        "dialogs": {
          "5031701": {
            "id": "5031701",
            "speakerId": 1000,
            "speakerName": "吃虎岩公告板",
            "text": "此乃吃虎岩公告板，街区新闻、店铺广告，无论大小，皆以公示。闲人如无要事，请勿擅自张贴。",
            "nextDialogs": [
              "5031702"
            ]
          },
          "5031702": {
            "id": "5031702",
            "speakerId": 1001,
            "speakerName": "千岩军公告",
            "text": "近期因市民与千岩军同侪呼声愈盛，特在南码头划定空旷场地，供新锐乐手辛焱演出使用。",
            "nextDialogs": [
              "5031703"
            ]
          },
          "5031703": {
            "id": "5031703",
            "speakerId": 1001,
            "speakerName": "千岩军公告",
            "text": "喜爱枫丹音乐的市民可前往观看演出，万望注意维持秩序，以免拥挤踩踏受伤。",
            "nextDialogs": [
              "5031704"
            ]
          },
          "5031704": {
            "id": "5031704",
            "speakerId": 1003,
            "speakerName": "留言",
            "text": "「请不要羞辱我的艺术！那是属于我自己的声音，不是什么『枫丹音乐』！」"
          }
        }
      }
    },
    {
      "subId": "50318",
      "subQuestName": "",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "5031801"
        ],
        "dialogs": {
          "5031801": {
            "id": "5031801",
            "speakerId": 1000,
            "speakerName": "吃虎岩公告板",
            "text": "此乃吃虎岩公告板，街区新闻、店铺广告，无论大小，皆以公示。闲人如无要事，请勿擅自张贴。",
            "nextDialogs": [
              "5031802"
            ]
          },
          "5031802": {
            "id": "5031802",
            "speakerId": 1003,
            "speakerName": "留言",
            "text": "「岩上茶室的那个女狐狸是什么来头！上次晦气与她同桌，我的钱全搭在里面了！」",
            "nextDialogs": [
              "5031803"
            ]
          },
          "5031803": {
            "id": "5031803",
            "speakerId": 1003,
            "speakerName": "留言",
            "text": "「一想到她那双狐狸眼睛，我就咽不下这口气！想来这人不是老千，就是收买了茶室的管事！」",
            "nextDialogs": [
              "5031804"
            ]
          },
          "5031804": {
            "id": "5031804",
            "speakerId": 1003,
            "speakerName": "留言",
            "text": "「女狐狸若看到这张告示就请回个话，等我叫齐兄弟们，看你如何嚣张！」",
            "nextDialogs": [
              "5031805"
            ]
          },
          "5031805": {
            "id": "5031805",
            "speakerId": 1015,
            "speakerName": "另一张便条",
            "text": "「这位大哥不必费心了，你的兄弟们正在码头等你。顺带一提，金创药钱也帮你付了，宜先自去取药。」"
          }
        }
      }
    }
  ]
}
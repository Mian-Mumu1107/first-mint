    {
      "subId": "7153502",
      "subQuestName": "与迪希雅对话",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "715350201"
        ],
        "dialogs": {
          "715350201": {
            "id": "715350201",
            "speakerId": 1000,
            "speakerName": "迪希雅",
            "text": "#{NICKNAME}，真巧，你也来海灯节玩么？",
            "nextDialogs": [
              "715350202"
            ]
          },
          "715350202": {
            "id": "715350202",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "你正在做「祝柬」么？",
            "nextDialogs": [
              "715350203"
            ]
          },
          "715350203": {
            "id": "715350203",
            "speakerId": 1000,
            "speakerName": "迪希雅",
            "text": "是啊，我想要做一张「祝柬」送给坎蒂丝，可是一直没做出满意的，正打算再做一张新的呢。",
            "nextDialogs": [
              "715350204"
            ]
          },
          "715350204": {
            "id": "715350204",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "坎蒂丝没来么？",
            "nextDialogs": [
              "715350205"
            ]
          },
          "715350205": {
            "id": "715350205",
            "speakerId": 1000,
            "speakerName": "迪希雅",
            "text": "她要来，不过…还要过一段时间。",
            "nextDialogs": [
              "715350206"
            ]
          },
          "715350206": {
            "id": "715350206",
            "speakerId": 1000,
            "speakerName": "迪希雅",
            "text": "本来她都没答应和我一起来璃月，说自己还要守着村子。",
            "nextDialogs": [
              "715350207"
            ]
          },
          "715350207": {
            "id": "715350207",
            "speakerId": 1000,
            "speakerName": "迪希雅",
            "text": "我和她说，一年到头了，就让自己轻松一下，我正好要护送一支商队来璃月，干脆就和我一起来璃月过海灯节。",
            "nextDialogs": [
              "715350208"
            ]
          },
          "715350208": {
            "id": "715350208",
            "speakerId": 1000,
            "speakerName": "迪希雅",
            "text": "要是她不放心村子，我就让团里的弟兄们帮她守着村子。",
            "nextDialogs": [
              "715350209"
            ]
          },
          "715350209": {
            "id": "715350209",
            "speakerId": 1000,
            "speakerName": "迪希雅",
            "text": "可坎蒂丝就是不答应，最后还是村里的人劝了她好久，她才答应给自己放放假。",
            "nextDialogs": [
              "715350210"
            ]
          },
          "715350210": {
            "id": "715350210",
            "speakerId": 1000,
            "speakerName": "迪希雅",
            "text": "不过，她还要亲自安排一些事情，等一切安排妥当后，她才会过来。",
            "nextDialogs": [
              "715350211"
            ]
          },
          "715350211": {
            "id": "715350211",
            "speakerId": 1000,
            "speakerName": "迪希雅",
            "text": "没办法，商队也不会等我们…所以我就先行来了璃月，在这里等着她。",
            "nextDialogs": [
              "715350212"
            ]
          },
          "715350212": {
            "id": "715350212",
            "speakerId": 1000,
            "speakerName": "迪希雅",
            "text": "这不，我想着先给她买点礼物，可是璃月的好东西太多，我都快挑花眼了。",
            "nextDialogs": [
              "715350213"
            ]
          },
          "715350213": {
            "id": "715350213",
            "speakerId": 1000,
            "speakerName": "迪希雅",
            "text": "最后，我挑了一条项链，又听说璃月人在海灯节的时候，送礼都要附上一张特别的「祝柬」，所以我就打算给自己设计一张。",
            "nextDialogs": [
              "715350214"
            ]
          },
          "715350214": {
            "id": "715350214",
            "speakerId": 1000,
            "speakerName": "迪希雅",
            "text": "结果…就和之前说的一样，做来做去都不满意。",
            "nextDialogs": [
              "715350215"
            ]
          },
          "715350215": {
            "id": "715350215",
            "speakerId": 1000,
            "speakerName": "迪希雅",
            "text": "#正好你来了，{NICKNAME}，你懂得多，能给我点做「祝柬」的建议么？",
            "nextDialogs": [
              "715350216"
            ]
          },
          "715350216": {
            "id": "715350216",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "没问题，让我研究一下…"
          }
        }
      }
    },
    {
      "subId": "7153503",
      "subQuestName": "和迪希雅一同完成祝柬",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "715350301"
        ],
        "dialogs": {
          "715350301": {
            "id": "715350301",
            "speakerId": 1000,
            "speakerName": "迪希雅",
            "text": "#正好你来了，{NICKNAME}，你懂得多，能给我点做「祝柬」的建议么？",
            "nextDialogs": [
              "715350302"
            ]
          },
          "715350302": {
            "id": "715350302",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "没问题，让我研究一下…"
          }
        }
      }
    },
    {
      "subId": "7153504",
      "subQuestName": "与迪希雅对话",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "715350401"
        ],
        "dialogs": {
          "715350401": {
            "id": "715350401",
            "speakerId": 1000,
            "speakerName": "迪希雅",
            "text": "喔？你果然心灵手巧啊，这张「祝柬」真好看，谢啦。",
            "nextDialogs": [
              "715350402"
            ]
          },
          "715350402": {
            "id": "715350402",
            "speakerId": 1000,
            "speakerName": "迪希雅",
            "text": "这封「祝柬」就算是你送我的，现在我手头没带宝贝，等回了须弥之后，给你寄回礼。",
            "nextDialogs": [
              "715350403"
            ]
          },
          "715350403": {
            "id": "715350403",
            "speakerId": 1000,
            "speakerName": "迪希雅",
            "text": "我还要再做一封。等坎蒂丝来了，再把项链和「祝柬」一起送出去，她一定会很高兴的。",
            "nextDialogs": [
              "715350404"
            ]
          },
          "715350404": {
            "id": "715350404",
            "speakerId": 1000,
            "speakerName": "迪希雅",
            "text": "不过说起来，都过这么长时间了，坎蒂丝怎么还没来…"
          }
        }
      }
    }
  ]
}
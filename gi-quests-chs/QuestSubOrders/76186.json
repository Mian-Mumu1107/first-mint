  "subQuests": [
    {
      "subId": "7618601",
      "subQuestName": "前往霜月之坊开启茶会",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "761860101"
        ],
        "dialogs": {
          "761860101": {
            "id": "761860101",
            "speakerId": 1315,
            "speakerName": "菈乌玛",
            "text": "……",
            "nextDialogs": [
              "761860102"
            ]
          },
          "761860102": {
            "id": "761860102",
            "speakerId": 1319,
            "speakerName": "「木偶」",
            "text": "……",
            "nextDialogs": [
              "761860103"
            ]
          },
          "761860103": {
            "id": "761860103",
            "speakerId": 1319,
            "speakerName": "「木偶」",
            "text": "…「霜月之子」，最近还好吗？",
            "nextDialogs": [
              "761860104"
            ]
          },
          "761860104": {
            "id": "761860104",
            "speakerId": 1315,
            "speakerName": "菈乌玛",
            "text": "还不错。月神的回归，也让我们坚定了自己应走的道路。",
            "nextDialogs": [
              "761860105"
            ]
          },
          "761860105": {
            "id": "761860105",
            "speakerId": 1319,
            "speakerName": "「木偶」",
            "text": "是吗？那就好。",
            "nextDialogs": [
              "761860106"
            ]
          },
          "761860106": {
            "id": "761860106",
            "speakerId": 1319,
            "speakerName": "「木偶」",
            "text": "……",
            "nextDialogs": [
              "761860107"
            ]
          },
          "761860107": {
            "id": "761860107",
            "speakerId": 1315,
            "speakerName": "菈乌玛",
            "text": "……",
            "nextDialogs": [
              "761860108"
            ]
          },
          "761860108": {
            "id": "761860108",
            "speakerId": 1319,
            "speakerName": "「木偶」",
            "text": "哈…果然我们之间还是聊不了什么吗？",
            "nextDialogs": [
              "761860109"
            ]
          },
          "761860109": {
            "id": "761860109",
            "speakerId": 1315,
            "speakerName": "菈乌玛",
            "text": "这…恐怕是因为「霜月之子」与「愚人众」之间，有过太多不愉快的过往了吧。",
            "nextDialogs": [
              "761860110"
            ]
          },
          "761860110": {
            "id": "761860110",
            "speakerId": 1315,
            "speakerName": "菈乌玛",
            "text": "从我个人的角度来说，自然是感激桑多涅小姐你在保护挪德卡莱和迎回月神上的付出。但对其他人…",
            "nextDialogs": [
              "761860111"
            ]
          },
          "761860111": {
            "id": "761860111",
            "speakerId": 1319,
            "speakerName": "「木偶」",
            "text": "我懂。曾经的种种原因，让我们没能建立良好的友谊，哪怕是互利关系也没有。",
            "nextDialogs": [
              "761860112"
            ]
          },
          "761860112": {
            "id": "761860112",
            "speakerId": 1319,
            "speakerName": "「木偶」",
            "text": "可现在「愚人众」不再从「霜月之子」手中渴求什么了，我也提醒过自己的部下不要对「霜月之子」有所刁难。",
            "nextDialogs": [
              "761860113"
            ]
          },
          "761860113": {
            "id": "761860113",
            "speakerId": 1319,
            "speakerName": "「木偶」",
            "text": "从我个人的角度来说，既然大家都是邻居，就算做不到和谐共处，也还是以互相尊重的态度交往为好。",
            "nextDialogs": [
              "761860114"
            ]
          },
          "761860114": {
            "id": "761860114",
            "speakerId": 1315,
            "speakerName": "菈乌玛",
            "text": "这恐怕需要时间…",
            "nextDialogs": [
              "761860115"
            ]
          },
          "761860115": {
            "id": "761860115",
            "speakerId": 1319,
            "speakerName": "「木偶」",
            "text": "当然。但不如从一次次尝试开始吧。尝尝我泡的香草茶？",
            "nextDialogs": [
              "761860116"
            ]
          },
          "761860116": {
            "id": "761860116",
            "speakerId": 1315,
            "speakerName": "菈乌玛",
            "text": "香草茶？哈…",
            "nextDialogs": [
              "761860117"
            ]
          },
          "761860117": {
            "id": "761860117",
            "speakerId": 1315,
            "speakerName": "菈乌玛",
            "text": "嗯…居然能做到如此醇厚，是「霜月之子」的泡法？我记得外面的人不喜欢这种喝法，你是怎么…",
            "nextDialogs": [
              "761860118"
            ]
          },
          "761860118": {
            "id": "761860118",
            "speakerId": 1319,
            "speakerName": "「木偶」",
            "text": "学习。还有尊重。",
            "nextDialogs": [
              "761860119"
            ]
          },
          "761860119": {
            "id": "761860119",
            "speakerId": 1315,
            "speakerName": "菈乌玛",
            "text": "哈…看来，这的确是一次不错的尝试。",
            "nextDialogs": [
              "761860120"
            ]
          },
          "761860120": {
            "id": "761860120",
            "speakerId": 1319,
            "speakerName": "「木偶」",
            "text": "希望合你口味。",
            "nextDialogs": [
              "761860121"
            ]
          },
          "761860121": {
            "id": "761860121",
            "speakerId": 1315,
            "speakerName": "菈乌玛",
            "text": "嗯，我很喜欢。",
            "nextDialogs": [
              "761860122"
            ]
          },
          "761860122": {
            "id": "761860122",
            "speakerId": 1315,
            "speakerName": "菈乌玛",
            "text": "茶饮间的礼尚往来，向来都是邻居间友好相处的良好开端。",
            "nextDialogs": [
              "761860123"
            ]
          },
          "761860123": {
            "id": "761860123",
            "speakerId": 1315,
            "speakerName": "菈乌玛",
            "text": "我想，这次也不例外呢。"
          }
        }
      }
    },
    {
      "subId": "7618602",
      "subQuestName": "前往霜月之坊开启茶会",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "761860201"
        ],
        "dialogs": {
          "761860201": {
            "id": "761860201",
            "speakerId": 1315,
            "speakerName": "菈乌玛",
            "text": "十分美味的香草茶，桑多涅小姐。我从中感受到了你的用心。",
            "nextDialogs": [
              "761860202"
            ]
          },
          "761860202": {
            "id": "761860202",
            "speakerId": 1319,
            "speakerName": "「木偶」",
            "text": "（再这么坐一会儿吧。）",
            "nextDialogs": [
              "761860204"
            ]
          },
          "761860204": {
            "id": "761860204",
            "speakerId": 1315,
            "speakerName": "菈乌玛",
            "text": "好。下次就换我邀请你来「霜月之子」品茶吧。"
          }
        }
      }
    },

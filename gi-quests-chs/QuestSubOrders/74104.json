    {
      "subId": "7410439",
      "subQuestName": "(test)齿轮镜头2$HIDDEN",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "741043901"
        ],
        "dialogs": {
          "741043901": {
            "id": "741043901",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "话说回来，我们乱动这里的终端之类的仪器设备，真的没问题吗？",
            "nextDialogs": [
              "741043902"
            ]
          },
          "741043902": {

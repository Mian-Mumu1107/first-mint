    {
      "subId": "7410427",
      "subQuestName": "(test)前往枫科院",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [],
        "dialogs": {}
      }
    },
    {
      "subId": "7410428",
      "subQuestName": "与布里科勒对话",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "741042802"
        ],
        "dialogs": {
          "741042802": {
            "id": "741042802",
            "speakerId": 1003,
            "speakerName": "库特罗",
            "text": "还是你们…技高一筹。是我见过的所有素材里最好的！但也远非我能驾驭的…是我输了。",
            "nextDialogs": [
              "741042803"
            ]
          },
          "741042803": {
            "id": "741042803",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "这人真是莫名其妙！",
            "nextDialogs": [
              "741042804"
            ]
          },
          "741042804": {
            "id": "741042804",
            "speakerId": 1007,
            "speakerName": "布里科勒",
            "text": "莫名其妙就对了，他之前就是因为做了一些…呃，做了一些「莫名其妙」的研究，才被枫丹科学院除名的。",
            "nextDialogs": [
              "741042805"
            ]
          },
          "741042805": {
            "id": "741042805",
            "speakerId": 1003,
            "speakerName": "库特罗",
            "text": "那不是什么莫名其妙的研究…",
            "nextDialogs": [
              "741042806"
            ]
          },
          "741042806": {
            "id": "741042806",
            "speakerId": 1007,
            "speakerName": "布里科勒",
            "text": "是啊，当初你和伦理委员会的人也是这么说的，你看有人信你吗？",
            "nextDialogs": [
              "741042807"
            ]
          },
          "741042807": {
            "id": "741042807",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "所以到底是什么研究？",
            "nextDialogs": [
              "741042808"
            ]
          },
          "741042808": {
            "id": "741042808",
            "speakerId": 1007,
            "speakerName": "布里科勒",
            "text": "咳，如果您希望获取这方面的信息，可以自行前往新枫丹科学院办理相关的合规手续。",
            "nextDialogs": [
              "741042809"
            ]
          },
          "741042809": {
            "id": "741042809",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "听起来就好麻烦…",
            "nextDialogs": [
              "741042810"
            ]
          },
          "741042810": {
            "id": "741042810",
            "speakerId": 1007,
            "speakerName": "布里科勒",
            "text": "这事真难办啊，虽然他已经被除名了，可我调查的资材失窃案又和他有关…",
            "nextDialogs": [
              "741042811"
            ]
          },
          "741042811": {
            "id": "741042811",
            "speakerId": 1003,
            "speakerName": "库特罗",
            "text": "哈，这次要把我送去梅洛彼得堡吗？",
            "nextDialogs": [
              "741042812"
            ]
          },
          "741042812": {
            "id": "741042812",
            "speakerId": 1007,
            "speakerName": "布里科勒",
            "text": "这不由我决定，而是由法律决定。很遗憾，这次可不会像上次那样只是简单的除名就能了事了。",
            "nextDialogs": [
              "741042813"
            ]
          },
          "741042813": {
            "id": "741042813",
            "speakerId": 1007,
            "speakerName": "布里科勒",
            "text": "不管怎么说，感谢两位的协助，如果只有我一个人恐怕没法制服他…之后的事就交给我吧，我保证，这次他会受到应有的惩罚。",
            "nextDialogs": [
              "741042814"
            ]
          },
          "741042814": {
            "id": "741042814",
            "speakerId": 1007,
            "speakerName": "布里科勒",
            "text": "唉，之后我恐怕还得回到这里继续善后工作，这么多资产，得写多少报告啊…"
          }
        }
      }
    },
    {
      "subId": "7410440",
      "subQuestName": "(test)牢门无电门有电$HIDDEN",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "741044001"
        ],
        "dialogs": {
          "741044001": {
            "id": "741044001",
            "speakerId": 1003,
            "speakerName": "库特罗",
            "text": "请相信我，只要替我一小会儿，我会很快解除触发装置回来的。",
            "nextDialogs": [
              "741044002"
            ]
          },
          "741044002": {
            "id": "741044002",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "唔…那好吧。不过你要快点哦！",
            "nextDialogs": [
              "741044003"
            ]
          },
          "741044003": {
            "id": "741044003",
            "speakerId": 1004,
            "speakerName": "Black Screen",
            "text": "小心翼翼地和奎瑟尔交换了位置…",
            "nextDialogs": [
              "741044004"
            ]
          },
          "741044004": {
            "id": "741044004",
            "speakerId": 1004,
            "speakerName": "Black Screen",
            "text": "等待了一段时间，他没有如约返回。还听到奇怪的说话声…",
            "nextDialogs": [
              "741044005"
            ]
          },
          "741044005": {
            "id": "741044005",
            "speakerId": 1004,
            "speakerName": "Black Screen",
            "text": "决定先设法离开牢笼…",
            "nextDialogs": [
              "741044006"
            ]
          },
          "741044006": {
            "id": "741044006",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "不过幸好我没有和你一起被关进笼子…唔，按照和刚才一样的方法应该可以把门打开吧？就让我试一试好了！"
          }
        }
      }
    },

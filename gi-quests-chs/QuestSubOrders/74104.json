    {
      "subId": "7410425",
      "subQuestName": "与奎瑟尔对话",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "741042501"
        ],
        "dialogs": {
          "741042501": {
            "id": "741042501",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "奎瑟尔！找到你了！",
            "nextDialogs": [
              "741042502"
            ]
          },
          "741042502": {
            "id": "741042502",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "那旁边的…肯定就是奎瑟尔说的坏蛋研究伙伴库特罗了吧！",
            "nextDialogs": [
              "741042503"
            ]
          },
          "741042503": {
            "id": "741042503",
            "speakerId": 1007,
            "speakerName": "布里科勒",
            "text": "…什么？我叫布里科勒，他才是库特罗。",
            "nextDialogs": [
              "741042504"
            ]
          },
          "741042504": {
            "id": "741042504",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "欸？他不是奎瑟尔吗？",
            "nextDialogs": [
              "741042505"
            ]
          },
          "741042505": {
            "id": "741042505",
            "speakerId": 1003,
            "speakerName": "库特罗",
            "text": "奎瑟尔…只是一个方便的角色。两位突破了重重考验，我想现在没有必要对两位隐瞒了，我叫库特罗，是这座工坊真正的主人。",
            "nextDialogs": [
              "741042506"
            ]
          },
          "741042506": {
            "id": "741042506",
            "speakerId": 1003,
            "speakerName": "库特罗",
            "text": "哈，两位真是…作为素材来说再好不过了，如果两位愿意协助我的研究…",
            "nextDialogs": [
              "741042507"
            ]
          },
          "741042507": {
            "id": "741042507",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "什么研究，说来听听。",
            "nextDialogs": [
              "741042508"
            ]
          },
          "741042508": {
            "id": "741042508",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "不会吧？！难道你真要协助这种可疑的家伙？",
            "nextDialogs": [
              "741042510"
            ]
          },
          "741042510": {
            "id": "741042510",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "这里看起来一点也不像什么正规的工坊呀！而且你又是骗人又是让发条机关攻击我们…根本就是危险分子！",
            "nextDialogs": [
              "741042511"
            ]
          },
          "741042511": {
            "id": "741042511",
            "speakerId": 1007,
            "speakerName": "布里科勒",
            "text": "对！你们可千万别上当了！他…他是个穷凶极恶的歹徒！",
            "nextDialogs": [
              "741042512"
            ]
          },
          "741042512": {
            "id": "741042512",
            "speakerId": 1007,
            "speakerName": "布里科勒",
            "text": "我在调查时顺着线索找到了这里，没想到你在被除名之后仍在继续危险的研究，甚至还为此盗窃了枫丹科学院的资产…",
            "nextDialogs": [
              "741042513"
            ]
          },
          "741042513": {
            "id": "741042513",
            "speakerId": 1007,
            "speakerName": "布里科勒",
            "text": "你已经犯罪了！",
            "nextDialogs": [
              "741042514"
            ]
          },
          "741042514": {
            "id": "741042514",
            "speakerId": 1003,
            "speakerName": "库特罗",
            "text": "真多嘴啊，布里科勒，明明只是个不堪一用的庸才…等我评估完两位贵宾的真正价值之后再来料理你。",
            "nextDialogs": [
              "741042515"
            ]
          },
          "741042515": {
            "id": "741042515",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "两位贵宾…该不会是指我们吧？",
            "nextDialogs": [
              "741042516"
            ]
          },
          "741042516": {
            "id": "741042516",
            "speakerId": 1003,
            "speakerName": "库特罗",
            "text": "当然。距离两位证明自己真正的价值，还差最后一场考验…",
            "nextDialogs": [
              "741042517"
            ]
          },
          "741042517": {
            "id": "741042517",
            "speakerId": 1003,
            "speakerName": "库特罗",
            "text": "让我亲眼见识一下两位的本领吧！"
          }
        }
      }
    },

    {
      "subId": "7410404",
      "subQuestName": "与被困的人对话",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "741040401"
        ],
        "dialogs": {
          "741040401": {
            "id": "741040401",
            "speakerId": 1000,
            "speakerName": "？？？",
            "text": "两、两位是来应募研究助手的吗？抱、抱歉，我现在有些脱不开身…",
            "nextDialogs": [
              "741040405",
              "741040404"
            ]
          },
          "741040405": {
            "id": "741040405",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "先别管这些了，你怎么被关在笼子里了呀？",
            "nextDialogs": [
              "741040406"
            ]
          },
          "741040406": {
            "id": "741040406",
            "speakerId": 1002,
            "speakerName": "奎瑟尔",
            "text": "和研究伙伴有些意见分歧…库特罗…他让我在这里冷静一下。对、对了，还没有自我介绍，两位就叫我…叫我奎瑟尔好了。",
            "nextDialogs": [
              "741040407"
            ]
          },
          "741040407": {
            "id": "741040407",
            "speakerId": 1002,
            "speakerName": "奎瑟尔",
            "text": "呃，就是…就是奎瑟尔的发条工坊，那个奎瑟尔。",
            "nextDialogs": [
              "741040408"
            ]
          },
          "741040408": {
            "id": "741040408",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "#我是派蒙，{M#他}{F#她}是{NICKNAME}…说起来刚才的确听到吵架的声音，原来那个听起来很凶的家伙是你的研究伙伴啊。"
          },
          "741040404": {
            "id": "741040404",
            "speakerId": 1000,
            "speakerName": "？？？",
            "text": "参、参观吗？当、当然也是很欢迎的。"
          }
        }
      }
    },
    {
      "subId": "7410405",
      "subQuestName": "操作迁能终端打开牢笼",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "741040501"
        ],
        "dialogs": {
          "741040501": {
            "id": "741040501",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "门已经打开了，你不出来吗？",
            "nextDialogs": [
              "741040502"
            ]
          },
          "741040502": {
            "id": "741040502",
            "speakerId": 1003,
            "speakerName": "库特罗",
            "text": "其、其实还有件难以启齿的事…如果我现在走出牢笼，恐、恐怕这里会爆炸。",
            "nextDialogs": [
              "741040503"
            ]
          },
          "741040503": {
            "id": "741040503",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "爆炸？",
            "nextDialogs": [
              "741040504"
            ]
          },
          "741040504": {
            "id": "741040504",
            "speakerId": 1003,
            "speakerName": "库特罗",
            "text": "是、是的…之前也说了，研究伙伴他是个…暴脾气，所以在牢笼下加装了特殊的触发装置。",
            "nextDialogs": [
              "741040505"
            ]
          },
          "741040505": {
            "id": "741040505",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "欸？！那现在该怎么办？",
            "nextDialogs": [
              "741040507",
              "741040509"
            ]
          },
          "741040507": {
            "id": "741040507",
            "speakerId": 1003,
            "speakerName": "库特罗",
            "text": "普、普通的重物恐怕不行…中间的原理很复杂，呃…",
            "nextDialogs": [
              "741040510"
            ]
          },
          "741040510": {
            "id": "741040510",
            "speakerId": 1003,
            "speakerName": "库特罗",
            "text": "#好心的{NICKNAME}{M#先生}{F#小姐}，如果能暂时代替我…在笼中稍候。我、我可以去解除这个特殊的触发装置。",
            "nextDialogs": [
              "741040511"
            ]
          },
          "741040511": {
            "id": "741040511",
            "speakerId": 1003,
            "speakerName": "库特罗",
            "text": "毕、毕竟是多年共同研究的伙伴，他的心里想些什么，我一清二楚。"
          },
          "741040509": {
            "id": "741040509",
            "speakerId": 1003,
            "speakerName": "库特罗",
            "text": "倒、倒不用这么麻烦…"
          }
        }
      }
    },

      "subQuestName": "(test)与派蒙讨论现状",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "741040701"
        ],
        "dialogs": {
          "741040701": {
            "id": "741040701",
            "speakerId": 1004,
            "speakerName": "Black Screen",
            "text": "(test)等待了很久，奎瑟尔还是没有回来。",
            "nextDialogs": [
              "741040702"
            ]
          },
          "741040702": {
            "id": "741040702",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "(test)该怎么办呢，不管怎么样先把你救出来！",
            "nextDialogs": [
              "741040703"
            ]
          },
          "741040703": {
            "id": "741040703",

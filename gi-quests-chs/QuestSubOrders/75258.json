      "dialogue": {
        "startDialogs": [
          "752580101"
        ],
        "dialogs": {
          "752580101": {
            "id": "752580101",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "欸？这里怎么有一个晕倒的人？",
            "nextDialogs": [
              "752580102"
            ]
          },
          "752580102": {
            "id": "752580102",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "喂！你听得见吗？你怎么啦？",
            "nextDialogs": [
              "752580103"
            ]
          },
          "752580103": {
            "id": "752580103",
            "speakerId": 1001,
            "speakerName": "Black Screen",
            "text": "你们扶起了地上的人，他慢慢醒了过来…",
            "nextDialogs": [
              "752580104"
            ]
          },
          "752580104": {
            "id": "752580104",
            "speakerId": 21981,
            "speakerName": "晕倒的员工",
            "text": "哎哟哟哟…",
            "nextDialogs": [
              "752580107"
            ]
          },
          "752580107": {
            "id": "752580107",
            "speakerId": 21981,
            "speakerName": "晕倒的员工",
            "text": "头好晕…这是怎么回事…让我想想…",
            "nextDialogs": [
              "752580108"
            ]
          },
          "752580108": {
            "id": "752580108",
            "speakerId": 21981,
            "speakerName": "晕倒的员工",
            "text": "啊！想起来了！我好像是被人打晕了…但是我没见着是谁动手的。等等…不会就是你们动的手吧？！",
            "nextDialogs": [
              "752580109"
            ]
          },
          "752580109": {
            "id": "752580109",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "喂！我们可是好心扶你起来的人啊，你可不要碰瓷！",
            "nextDialogs": [
              "752580110"
            ]
          },
          "752580110": {
            "id": "752580110",
            "speakerId": 21981,
            "speakerName": "晕倒的员工",
            "text": "噢噢，对不起，呃…我是「醅蜜」酒吧的员工，本来要去北边的港口送货，嗯…挪德卡莱的商会跟我们采购了一些蜜酿。",
            "nextDialogs": [
              "752580111"
            ]
          },
          "752580111": {
            "id": "752580111",
            "speakerId": 21981,
            "speakerName": "晕倒的员工",
            "text": "哎呀！完了，我的货呢？蜜酿没了！难道是被抢走了？等等…不会就是你们抢走的吧？！",
            "nextDialogs": [
              "752580112"
            ]
          },
          "752580112": {
            "id": "752580112",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "都说了我们是好心扶你起来的人啊！",
            "nextDialogs": [
              "752580113"
            ]
          },
          "752580113": {
            "id": "752580113",
            "speakerId": 21981,
            "speakerName": "晕倒的员工",
            "text": "哦对对对，对不起，我现在有点头晕。非常感谢你们，但我得立刻回酒吧报告一下情况…",
            "nextDialogs": [
              "752580114"
            ]
          },
          "752580114": {
            "id": "752580114",
            "speakerId": 21981,
            "speakerName": "晕倒的员工",
            "text": "如果真的有强盗，你们也不要往北边的港口去了，可能会有危险。"
          }
        }
      }
    }
  ]
}
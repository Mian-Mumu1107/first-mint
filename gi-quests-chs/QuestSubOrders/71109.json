    {
      "subId": "7110902",
      "subQuestName": "与派蒙对话",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "711090201"
        ],
        "dialogs": {
          "711090201": {
            "id": "711090201",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "哇啊，没想到这破破烂烂的王山厅里，居然还真的藏了这么深的秘密…",
            "nextDialogs": [
              "711090204"
            ]
          },
          "711090204": {
            "id": "711090204",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "而且，黄三爷好像也不知道有这种地方…等等，难道这里就是传说中的「古华藏宝室」吗？！",
            "nextDialogs": [
              "711090205"
            ]
          },
          "711090205": {
            "id": "711090205",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "#而且…{NICKNAME}你看，那边的台子上好像有什么东西在发光！"
          }
        }
      }
    },

            "nextDialogs": [
              "100069903"
            ]
          },
          "100069903": {
            "id": "100069903",
            "speakerId": 1320,
            "speakerName": "杜林",
            "text": "身体里的力量似乎正在逐渐释放出来…",
            "nextDialogs": [
              "100069904"
            ]
          },
          "100069904": {
            "id": "100069904",
            "speakerId": 1320,
            "speakerName": "杜林",
            "text": "感觉越来越轻松了呢！"
          }
        }

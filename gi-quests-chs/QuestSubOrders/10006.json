    {
      "subId": "1000602",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "100060201"
        ],
        "dialogs": {
          "100060201": {
            "id": "100060201",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "呜啊，这是哪里啦？这本辞典又把我们带到什么奇怪的地方来了！",
            "nextDialogs": [
              "100060202"
            ]
          },
          "100060202": {
            "id": "100060202",
            "speakerId": 1320,
            "speakerName": "杜林",
            "text": "这里好像有…妈妈的味道。",
            "nextDialogs": [
              "100060203"
            ]
          },
          "100060203": {
            "id": "100060203",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "哇，有一只奇怪的猫出现了。"
          }
        }
      }
    },
    {
      "subId": "1000606",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "100060601"
        ],
        "dialogs": {
          "100060601": {
            "id": "100060601",
            "speakerId": 16025,
            "speakerName": "「莱茵多特」",
            "text": "「嗯，看来这次阿贝多没有搞错嘛。」",
            "nextDialogs": [
              "100060602"
            ]
          },
          "100060602": {
            "id": "100060602",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "喂，下次能不能不要再搞这种突然袭击了啊！",
            "nextDialogs": [
              "100060603"
            ]
          },
          "100060603": {
            "id": "100060603",
            "speakerId": 1320,
            "speakerName": "杜林",
            "text": "不过感觉击败它们之后，我好像能更自如地控制身体里的力量了。",
            "nextDialogs": [
              "100060604"
            ]
          },
          "100060604": {
            "id": "100060604",
            "speakerId": 16025,
            "speakerName": "「莱茵多特」",
            "text": "「其实，听说了你的事情后，我原本准备了能够封印住你血液中那些黑暗力量的术式，打算趁此机会交给你。」",
            "nextDialogs": [
              "100060605"
            ]
          },
          "100060605": {
            "id": "100060605",
            "speakerId": 16025,
            "speakerName": "「莱茵多特」",
            "text": "「当然，使用那个术式会付出相应的代价，它虽然能维持你在提瓦特的存在，但却会削弱你与世界的联系。」",
            "nextDialogs": [
              "100060606"
            ]
          },
          "100060606": {
            "id": "100060606",
            "speakerId": 16025,
            "speakerName": "「莱茵多特」",
            "text": "「毕竟你可是M的孩子，要是因为那些没有处理好的力量，而使你步上和那孩子同样的命运，可就太对不起她了。」",
            "nextDialogs": [
              "100060607"
            ]
          },
          "100060607": {
            "id": "100060607",
            "speakerId": 16025,
            "speakerName": "「莱茵多特」",
            "text": "「不过现在看来我的担心是多余的。M是个了不起的母亲呢，比我要称职多了。」",
            "nextDialogs": [
              "100060608"
            ]
          },
          "100060608": {
            "id": "100060608",
            "speakerId": 16025,
            "speakerName": "「莱茵多特」",
            "text": "「现在，我很期待你能成长到什么样的地步。一个真正融入这个世界的炼金生命，要如何在人类社会找到属于自己的位置。」",
            "nextDialogs": [
              "100060609"
            ]
          },
          "100060609": {
            "id": "100060609",
            "speakerId": 16025,
            "speakerName": "「莱茵多特」",
            "text": "「这样的实验我还从没做过，或许从你的身上，我能得到意料之外的『答案』。」",
            "nextDialogs": [
              "100060610"
            ]
          },
          "100060610": {
            "id": "100060610",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "唔，不过杜林可不是什么实验，他是我们重要的朋友。",
            "nextDialogs": [
              "100060611"
            ]
          },
          "100060611": {
            "id": "100060611",
            "speakerId": 1320,
            "speakerName": "杜林",
            "text": "虽然不是很明白，不过谢谢你的好意，莱茵多特阿姨。"
          }
        }
      }
    },
    {
      "subId": "1000699",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {

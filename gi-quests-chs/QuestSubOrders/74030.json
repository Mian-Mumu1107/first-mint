  "subQuests": [
    {
      "subId": "7403001",
      "subQuestName": "与嘉维娅对话$HIDDEN",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "740300101"
        ],
        "dialogs": {
          "740300101": {
            "id": "740300101",
            "speakerId": 5214,
            "speakerName": "嘉维娅",
            "text": "你们好，有什么事吗？",
            "nextDialogs": [
              "740300103",
              "740300106"
            ]
          },
          "740300103": {
            "id": "740300103",
            "speakerId": 5214,
            "speakerName": "嘉维娅",
            "text": "怎么连你也学起莉诺尔了？有什么话就直说吧。",
            "nextDialogs": [
              "740300104"
            ]
          },
          "740300104": {
            "id": "740300104",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "我们需要很多特许券！想问问有没有什么我们能做的工作…",
            "nextDialogs": [
              "740300107"
            ]
          },
          "740300107": {
            "id": "740300107",
            "speakerId": 5214,
            "speakerName": "嘉维娅",
            "text": "你们该不会是加入了艾蒂安的游戏吧？玩闹也要适可而止哦。",
            "nextDialogs": [
              "740300108"
            ]
          },
          "740300108": {
            "id": "740300108",
            "speakerId": 5214,
            "speakerName": "嘉维娅",
            "text": "…说起来，的确有件事想要拜托你们。",
            "nextDialogs": [
              "740300109"
            ]
          },
          "740300109": {
            "id": "740300109",
            "speakerId": 5214,
            "speakerName": "嘉维娅",
            "text": "克兰茨现在应该正在海蚀裂隙那边修理他的什么装置…你们去帮帮他吧。",
            "nextDialogs": [
              "740300110"
            ]
          },
          "740300110": {
            "id": "740300110",
            "speakerId": 5214,
            "speakerName": "嘉维娅",
            "text": "至于报酬，就直接找他索取好了。他不会有异议的。",
            "nextDialogs": [
              "740300111"
            ]
          },
          "740300111": {
            "id": "740300111",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "嗯嗯，交给我们吧！"
          },
          "740300106": {
            "id": "740300106",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "最好是有报酬的那种！"
          }
        }
      }
    },
    {
      "subId": "7403002",
      "subQuestName": "前往海蚀裂隙寻找克兰茨",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "740300201"
        ],
        "dialogs": {
          "740300201": {
            "id": "740300201",
            "speakerId": 5252,
            "speakerName": "克兰茨",
            "text": "你们来得正好，来帮个忙。",
            "nextDialogs": [
              "740300203",
              "740300207"
            ]
          },
          "740300203": {
            "id": "740300203",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "嘉维娅让我们来帮忙…你是怎么知道的！",
            "nextDialogs": [
              "740300204"
            ]
          },
          "740300204": {
            "id": "740300204",
            "speakerId": 5252,
            "speakerName": "克兰茨",
            "text": "啊？因为这里只有你们能帮忙啊。",
            "nextDialogs": [
              "740300205"
            ]
          },
          "740300205": {
            "id": "740300205",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "…也对哦！",
            "nextDialogs": [
              "740300210"
            ]
          },
          "740300210": {
            "id": "740300210",
            "speakerId": 5252,
            "speakerName": "克兰茨",
            "text": "反正不是什么难事，这儿的研察终端需要两个人同时操作。具体的指令我已经录入完毕了，你们过去拉下拉杆就好。",
            "nextDialogs": [
              "740300211"
            ]
          },
          "740300211": {
            "id": "740300211",
            "speakerId": 5252,
            "speakerName": "克兰茨",
            "text": "差点忘了…储能装置应该就在附近，麻烦你们先把储能装置安装上再开启吧。",
            "nextDialogs": [
              "740300212"
            ]
          },
          "740300212": {
            "id": "740300212",
            "speakerId": 5252,
            "speakerName": "克兰茨",
            "text": "以及…我先确认一下，你们不是什么机械杀手吧？"
          },
          "740300207": {
            "id": "740300207",
            "speakerId": 5252,
            "speakerName": "克兰茨",
            "text": "待会儿让嘉维娅给你们申请。",
            "nextDialogs": [
              "740300208"
            ]
          },
          "740300208": {
            "id": "740300208",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "欸？可是她让我们直接找你索取报酬…",
            "nextDialogs": [
              "740300209"
            ]
          },
          "740300209": {
            "id": "740300209",
            "speakerId": 5252,
            "speakerName": "克兰茨",
            "text": "她是这么说的？那好吧。在这儿申请一点经费比在枫丹科学院还难…"
          }
        }
      }
    },
    {
      "subId": "7403003",
      "subQuestName": "协助克兰茨操作终端",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "740300301"
        ],
        "dialogs": {
          "740300301": {
            "id": "740300301",
            "speakerId": 5252,
            "speakerName": "克兰茨",
            "text": "怎么了，有哪里不明白吗？只需要配合我拉动拉杆就可以了，很简单的。"
          }
        }
      }
    },
    {
      "subId": "7403004",
      "subQuestName": "与克兰茨对话",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "740300401"
        ],
        "dialogs": {
          "740300401": {
            "id": "740300401",
            "speakerId": 5252,
            "speakerName": "克兰茨",
            "text": "你们还挺熟练的。要不是在这种地方，我都想雇你们当助手了。",
            "nextDialogs": [
              "740300402"
            ]
          },
          "740300402": {
            "id": "740300402",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "哼哼，这点小事怎么可能难倒我们。话说回来，这个装置到底是做什么用的？",
            "nextDialogs": [
              "740300403"
            ]
          },
          "740300403": {
            "id": "740300403",
            "speakerId": 5252,
            "speakerName": "克兰茨",
            "text": "这里原本有条通往外部的裂隙需要看守看管，现在用闭锁装置把路封上就可以节省一些人力了。",
            "nextDialogs": [
              "740300404"
            ]
          },
          "740300404": {
            "id": "740300404",
            "speakerId": 5252,
            "speakerName": "克兰茨",
            "text": "这技术在枫丹科学院也不是什么新鲜玩意儿，不过反正闲着也是闲着，我就稍微做了点改造。",
            "nextDialogs": [
              "740300405"
            ]
          },
          "740300405": {
            "id": "740300405",
            "speakerId": 5252,
            "speakerName": "克兰茨",
            "text": "你们现在看到的还不是完全版，完全版被用在晶簇矿坑道…咳，好像说太多了。你们就当没听到吧。",
            "nextDialogs": [
              "740300407",
              "740300409"
            ]
          },
          "740300407": {
            "id": "740300407",
            "speakerId": 5252,
            "speakerName": "克兰茨",
            "text": "唉，是啊，你可真是太聪明了，如果更聪明一点，就应该把这句话放在心里，而不是直接说出来。",
            "nextDialogs": [
              "740300411"
            ]
          },
          "740300411": {
            "id": "740300411",
            "speakerId": 5252,
            "speakerName": "克兰茨",
            "text": "好了，这下问题也算解决了，嘉维娜可以不用那么常来这里看守，我也可以歇会儿了。",
            "nextDialogs": [
              "740300412"
            ]
          },
          "740300412": {
            "id": "740300412",
            "speakerId": 5252,
            "speakerName": "克兰茨",
            "text": "…差点忘了，这些是给你们的报酬。谢啦。"
          },
          "740300409": {
            "id": "740300409",
            "speakerId": 5252,
            "speakerName": "克兰茨",
            "text": "那当然了，完全版还加装了配件…你打听这么多干什么？",
            "nextDialogs": [
              "740300410"
            ]
          },
          "740300410": {
            "id": "740300410",
            "speakerId": 5252,
            "speakerName": "克兰茨",
            "text": "你要是想知道完全版的具体情况，可以自己去试试…被抓了别说是我怂恿你去的就行。"
          }
        }
      }
    }
  ]
}
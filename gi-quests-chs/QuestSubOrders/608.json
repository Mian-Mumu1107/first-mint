    {
      "subId": "60801",
      "subQuestName": "(test)隐藏$HIDDEN",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "6080101"
        ],
        "dialogs": {
          "6080101": {
            "id": "6080101",
            "speakerId": 1000,
            "speakerName": "丽莎",
            "text": "呼，好久没在风花节期间尽情电什么人了呢。",
            "nextDialogs": [
              "6080102"
            ]
          },
          "6080102": {
            "id": "6080102",
            "speakerId": 1001,
            "speakerName": "雷泽",
            "text": "老师，以前难道很多？",
            "nextDialogs": [
              "6080103"
            ]
          },
          "6080103": {
            "id": "6080103",
            "speakerId": 1000,
            "speakerName": "丽莎",
            "text": "你说电人？当然不多了，啊哈哈，只是偶尔啦。不过还挺解压的呢。",
            "nextDialogs": [
              "6080104"
            ]
          },
          "6080104": {
            "id": "6080104",
            "speakerId": 1000,
            "speakerName": "丽莎",
            "text": "啊对了，前些日子老师给我写信还问起这件事呢，我当时说的可是「温柔待人」。",
            "nextDialogs": [
              "6080105"
            ]
          },
          "6080105": {
            "id": "6080105",
            "speakerId": 1000,
            "speakerName": "丽莎",
            "text": "学生继承老师的风格，很合理吧？我的老师也是一个温柔的素论派老爷子呢。",
            "nextDialogs": [
              "6080106"
            ]
          },
          "6080106": {
            "id": "6080106",
            "speakerId": 1000,
            "speakerName": "丽莎",
            "text": "所以这次也只用了很温柔的电法哦？就算琴看到都不方便阻止我的那种。",
            "nextDialogs": [
              "6080107"
            ]
          },
          "6080107": {
            "id": "6080107",
            "speakerId": 1001,
            "speakerName": "雷泽",
            "text": "原来，可以温柔地电人…",
            "nextDialogs": [
              "6080108"
            ]
          },
          "6080108": {
            "id": "6080108",
            "speakerId": 1002,
            "speakerName": "阿贝多",
            "text": "看起来丽莎小姐状态很不错，真是太好了。",
            "nextDialogs": [
              "6080109"
            ]
          },
          "6080109": {
            "id": "6080109",
            "speakerId": 1000,
            "speakerName": "丽莎",
            "text": "是啊，活动一下身体，对健康也很有益处呢。"
          }
        }
      }
    },

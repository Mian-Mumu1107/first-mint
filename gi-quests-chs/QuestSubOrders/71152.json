      "dialogue": {
        "startDialogs": [
          "711520802"
        ],
        "dialogs": {
          "711520802": {
            "id": "711520802",
            "speakerId": 1038,
            "speakerName": "九条裟罗",
            "text": "很不错的画片，用来作纪念再合适不过了。",
            "nextDialogs": [
              "711520803"
            ]
          },
          "711520803": {
            "id": "711520803",
            "speakerId": 1038,
            "speakerName": "九条裟罗",
            "text": "#谢谢，{NICKNAME}，我会把它作为私人物品，好好保存的。",
            "nextDialogs": [
              "711520804",
              "711520807"
            ]
          },
          "711520804": {
            "id": "711520804",
            "speakerId": 1038,
            "speakerName": "九条裟罗",
            "text": "嗯。我看见了，稍后我也会去买几盏霄灯带回稻妻。挂在天领奉行的门口，应该也会很好看的。",
            "nextDialogs": [
              "711520805"
            ]
          },
          "711520805": {
            "id": "711520805",
            "speakerId": 1038,
            "speakerName": "九条裟罗",
            "text": "有鹿野院同心在，想必贼匪也不敢对这几盏霄灯有贪念。"
          },
          "711520807": {
            "id": "711520807",
            "speakerId": 1038,
            "speakerName": "九条裟罗",
            "text": "多谢，也祝你节日愉快…但我多问一句，往常的海灯节里，千岩军们也是如此严格值守的么？",
            "nextDialogs": [
              "711520808"
            ]
          },
          "711520808": {
            "id": "711520808",
            "speakerId": 1038,
            "speakerName": "九条裟罗",
            "text": "在节日期间，他们的纪律也能如此严明，实在让人佩服。"
          }
        }
      }
    }
  ]

    {
      "subId": "4002507",
      "subQuestName": "追查声音的来源",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "400250401"
        ],
        "dialogs": {
          "400250401": {
            "id": "400250401",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "到这里为止，声音完全消失了…",
            "nextDialogs": [
              "400250402"
            ]
          },
          "400250402": {
            "id": "400250402",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "看来是跟丢了。",
            "nextDialogs": [
              "400250403"
            ]
          },
          "400250403": {
            "id": "400250403",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "可我们的跟踪技术不是已经在那么多次旅行中练得炉火纯青了吗？居然还会跟丢？",
            "nextDialogs": [
              "400250404"
            ]
          },
          "400250404": {
            "id": "400250404",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "要不然，就是对方比我们想的还厉害，那他得是什么人呀？",
            "nextDialogs": [
              "400250405"
            ]
          },
          "400250405": {
            "id": "400250405",
            "speakerId": 1008,
            "speakerName": "？？？",
            "text": "这个声音是…",
            "nextDialogs": [
              "400250406"
            ]
          },
          "400250406": {
            "id": "400250406",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "嗯？欸？",
            "nextDialogs": [
              "400250407"
            ]
          },
          "400250407": {
            "id": "400250407",
            "speakerId": 1009,
            "speakerName": "阿贝多",
            "text": "怎么有空到雪山来？",
            "nextDialogs": [
              "400250408"
            ]
          },
          "400250408": {
            "id": "400250408",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "原来是你啊。",
            "nextDialogs": [
              "400250409"
            ]
          },
          "400250409": {
            "id": "400250409",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "哦！原来是阿贝多啊！",
            "nextDialogs": [
              "400250410"
            ]
          },
          "400250410": {
            "id": "400250410",
            "speakerId": 1009,
            "speakerName": "阿贝多",
            "text": "「原来」？你指的是…？",
            "nextDialogs": [
              "400250411"
            ]
          },
          "400250411": {
            "id": "400250411",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "刚才我们一路走来，总能感觉到视线和声音，像是周围有人一样…没想到，居然是你在这里。",
            "nextDialogs": [
              "400250412"
            ]
          },
          "400250412": {
            "id": "400250412",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "那种气氛，害得我都紧张起来了，真是的，没事不要装神弄鬼啦！",
            "nextDialogs": [
              "400250413"
            ]
          },
          "400250413": {
            "id": "400250413",
            "speakerId": 1009,
            "speakerName": "阿贝多",
            "text": "雪山上的视线和声音也有可能来自动物或盗贼。在这里最好保持警惕，否则或许会遭受各种意想不到的损失。",
            "nextDialogs": [
              "400250414"
            ]
          },
          "400250414": {
            "id": "400250414",
            "speakerId": 1009,
            "speakerName": "阿贝多",
            "text": "两位来雪山有什么事吗？",
            "nextDialogs": [
              "400250415"
            ]
          },
          "400250415": {
            "id": "400250415",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "说来话长…",
            "nextDialogs": [
              "400250416"
            ]
          },
          "400250416": {
            "id": "400250416",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "其实我们一开始是想来找你，后来又决定要找安柏，结果又先遇上了你…",
            "nextDialogs": [
              "400250417"
            ]
          },
          "400250417": {
            "id": "400250417",
            "speakerId": 1009,
            "speakerName": "阿贝多",
            "text": "嗯，思维和语言表达都相当混乱。",
            "nextDialogs": [
              "400250418"
            ]
          },
          "400250418": {
            "id": "400250418",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "你、你这家伙！我是说！我们就是来找你的啦！",
            "nextDialogs": [
              "400250419"
            ]
          },
          "400250419": {
            "id": "400250419",
            "speakerId": 1009,
            "speakerName": "阿贝多",
            "text": "哦？是吗？",
            "nextDialogs": [
              "400250420"
            ]
          },
          "400250420": {
            "id": "400250420",
            "speakerId": 1009,
            "speakerName": "阿贝多",
            "text": "那一定是有重要的事了，我洗耳恭听。",
            "nextDialogs": [
              "400250421"
            ]
          },
          "400250421": {
            "id": "400250421",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "其实…也没有…",
            "nextDialogs": [
              "400250422"
            ]
          },
          "400250422": {
            "id": "400250422",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "总觉得他心情还不错？难道他并没有介意蒂玛乌斯太笨的事？",
            "nextDialogs": [
              "400250423"
            ]
          },
          "400250423": {
            "id": "400250423",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "不会是我们多心了吧。",
            "nextDialogs": [
              "400250424"
            ]
          },
          "400250424": {
            "id": "400250424",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "呃啊…装、装作不知道好了！",
            "nextDialogs": [
              "400250425"
            ]
          },
          "400250425": {
            "id": "400250425",
            "speakerId": 1009,
            "speakerName": "阿贝多",
            "text": "不方便说也没关系，就当是来雪山散散步，看看风景。",
            "nextDialogs": [
              "400250426"
            ]
          },
          "400250426": {
            "id": "400250426",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "啊哈哈，那就直接说重点吧…其实，我们是在履行身为冒险家的职责哦。",
            "nextDialogs": [
              "400250427"
            ]
          },
          "400250427": {
            "id": "400250427",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "将冒险家协会举办活动一事告知阿贝多…",
            "nextDialogs": [
              "400250428"
            ]
          },
          "400250428": {
            "id": "400250428",
            "speakerId": 1009,
            "speakerName": "阿贝多",
            "text": "原来如此，你们把那位新人交给优菈，自己跑出来偷懒了？",
            "nextDialogs": [
              "400250429"
            ]
          },
          "400250429": {
            "id": "400250429",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "怎么能叫偷懒呢，我们这是谦让哦。",
            "nextDialogs": [
              "400250430"
            ]
          },
          "400250430": {
            "id": "400250430",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "倒是你，今天来雪山做什么呀？",
            "nextDialogs": [
              "400250431"
            ]
          },
          "400250431": {
            "id": "400250431",
            "speakerId": 1009,
            "speakerName": "阿贝多",
            "text": "最近有些朋友委托的稿子还没画完，我来僻静之地找找灵感，顺便搜集些原材料。",
            "nextDialogs": [
              "400250432"
            ]
          },
          "400250432": {
            "id": "400250432",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "什么的原材料？",
            "nextDialogs": [
              "400250433"
            ]
          },
          "400250433": {
            "id": "400250433",
            "speakerId": 1009,
            "speakerName": "阿贝多",
            "text": "颜料。",
            "nextDialogs": [
              "400250434"
            ]
          },
          "400250434": {
            "id": "400250434",
            "speakerId": 1009,
            "speakerName": "阿贝多",
            "text": "星银矿能用于制作高级银色颜料，我自制的银色颜料刚巧用完了，过来采点矿石。",
            "nextDialogs": [
              "400250435"
            ]
          },
          "400250435": {
            "id": "400250435",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "原来矿石还能做颜料呀！",
            "nextDialogs": [
              "400250436"
            ]
          },
          "400250436": {
            "id": "400250436",
            "speakerId": 1009,
            "speakerName": "阿贝多",
            "text": "嗯。不过，开采时要注意区分。",
            "nextDialogs": [
              "400250437"
            ]
          },
          "400250437": {
            "id": "400250437",
            "speakerId": 1009,
            "speakerName": "阿贝多",
            "text": "有些杂质含量高的星银矿乍看也含有银色细颗粒，但光泽较差，制成颜料显色度也低，这种一般会被归为赝品或次品。",
            "nextDialogs": [
              "400250438"
            ]
          },
          "400250438": {
            "id": "400250438",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "嗯嗯，那除了颜料，能不能再分享一些找灵感的方法？我也想学！",
            "nextDialogs": [
              "400250439"
            ]
          },
          "400250439": {
            "id": "400250439",
            "speakerId": 1009,
            "speakerName": "阿贝多",
            "text": "你也想画画？",
            "nextDialogs": [
              "400250440"
            ]
          },
          "400250440": {
            "id": "400250440",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "#不不，我自己就不用了，是想让{NICKNAME}这家伙学学啦！",
            "nextDialogs": [
              "400250441"
            ]
          },
          "400250441": {
            "id": "400250441",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "我们到处旅行，偶尔也会遇上无事可做的夜晚。有时闲着，就想做点有纪念意义的事…",
            "nextDialogs": [
              "400250442"
            ]
          },
          "400250442": {
            "id": "400250442",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "画画是件好事啊，可以留住瞬间，所以我认为，学画画一定不亏。",
            "nextDialogs": [
              "400250443"
            ]
          },
          "400250443": {
            "id": "400250443",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "也就是要我学的意思。",
            "nextDialogs": [
              "400250444"
            ]
          },
          "400250444": {
            "id": "400250444",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "对啊，你学一学怎么了嘛！学会了就能画我啦！",
            "nextDialogs": [
              "400250445"
            ]
          },
          "400250445": {
            "id": "400250445",
            "speakerId": 1009,
            "speakerName": "阿贝多",
            "text": "想法不错。既然两位想多了解关于绘画的事，不妨跟我到营地去，那里有画材，可以边讲解边练习。",
            "nextDialogs": [
              "400250446"
            ]
          },
          "400250446": {
            "id": "400250446",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "好呀好呀！",
            "nextDialogs": [
              "400250447"
            ]
          },
          "400250447": {
            "id": "400250447",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "那安柏…？",
            "nextDialogs": [
              "400250448"
            ]
          },
          "400250448": {
            "id": "400250448",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "安柏可是堂堂西风骑士，一定没问题的，我们就不要管那些事啦，先去阿贝多那边吧。",
            "nextDialogs": [
              "400250449"
            ]
          },
          "400250449": {
            "id": "400250449",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "好吧好吧…",
            "nextDialogs": [
              "400250450"
            ]
          },
          "400250450": {
            "id": "400250450",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "走吧，外面这么冷，我想快点到营地去烤火！"
          }
        }
      }
    },
    {
      "subId": "4002508",
      "subQuestName": "前往阿贝多的营地",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "400250601"
        ],
        "dialogs": {
          "400250601": {
            "id": "400250601",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "哇啊！",
            "nextDialogs": [
              "400250602"
            ]
          },
          "400250602": {
            "id": "400250602",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "这是…？！",
            "nextDialogs": [
              "400250603"
            ]
          },
          "400250603": {
            "id": "400250603",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "小偷！一定是小偷！",
            "nextDialogs": [
              "400250604"
            ]
          },
          "400250604": {
            "id": "400250604",
            "speakerId": 1009,
            "speakerName": "阿贝多",
            "text": "……",
            "nextDialogs": [
              "400250605"
            ]
          },
          "400250605": {
            "id": "400250605",
            "speakerId": 1009,
            "speakerName": "阿贝多",
            "text": "少了一些东西。",
            "nextDialogs": [
              "400250606"
            ]
          },
          "400250606": {
            "id": "400250606",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "难道是财物？",
            "nextDialogs": [
              "400250607"
            ]
          },
          "400250607": {
            "id": "400250607",
            "speakerId": 1009,
            "speakerName": "阿贝多",
            "text": "很难说它的价值如何，但…",
            "nextDialogs": [
              "400250608"
            ]
          },
          "400250608": {
            "id": "400250608",
            "speakerId": 1009,
            "speakerName": "阿贝多",
            "text": "我的一些炼金术笔记不见了。",
            "nextDialogs": [
              "400250609"
            ]
          },
          "400250609": {
            "id": "400250609",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "……",
            "nextDialogs": [
              "400250610"
            ]
          },
          "400250610": {
            "id": "400250610",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "炼金术笔记，能卖出高价吗？",
            "nextDialogs": [
              "400250611"
            ]
          },
          "400250611": {
            "id": "400250611",
            "speakerId": 1009,
            "speakerName": "阿贝多",
            "text": "对外行人来说，不过是一堆废纸，但对懂行的人而言…里面记录的知识比宝藏更珍贵。",
            "nextDialogs": [
              "400250612"
            ]
          },
          "400250612": {
            "id": "400250612",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "也就是说，是懂炼金术的人偷的？可这里是雪山啊，只有冒险家、盗贼和魔物，谁会需要炼金术笔记呢？",
            "nextDialogs": [
              "400250613"
            ]
          },
          "400250613": {
            "id": "400250613",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "我觉得事情没那么简单。",
            "nextDialogs": [
              "400250614"
            ]
          },
          "400250614": {
            "id": "400250614",
            "speakerId": 1009,
            "speakerName": "阿贝多",
            "text": "我也有同感。不过，雪山上曾有过丘丘人入室捣乱之类的事件，单凭眼前这些线索很难下结论。",
            "nextDialogs": [
              "400250615"
            ]
          },
          "400250615": {
            "id": "400250615",
            "speakerId": 1009,
            "speakerName": "阿贝多",
            "text": "……",
            "nextDialogs": [
              "400250616"
            ]
          },
          "400250616": {
            "id": "400250616",
            "speakerId": 1009,
            "speakerName": "阿贝多",
            "text": "嗯？这是…",
            "nextDialogs": [
              "400250617"
            ]
          },
          "400250617": {
            "id": "400250617",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "是脚印？",
            "nextDialogs": [
              "400250618"
            ]
          },
          "400250618": {
            "id": "400250618",
            "speakerId": 1009,
            "speakerName": "阿贝多",
            "text": "脚印很新，看来嫌犯还没走远。",
            "nextDialogs": [
              "400250619"
            ]
          },
          "400250619": {
            "id": "400250619",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "我们追吧，别让小偷跑了！"
          }
        }
      }
    },
    {
      "subId": "4002507",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "400250701"
        ],
        "dialogs": {
          "400250701": {
            "id": "400250701",
            "speakerId": 1004,
            "speakerName": "塞琉斯",
            "text": "总觉得插不上话啊。难道说，还是年轻小姑娘的请求更有吸引力吗？",
            "nextDialogs": [
              "400250702"
            ]
          },
          "400250702": {
            "id": "400250702",
            "speakerId": 1005,
            "speakerName": "冒失的帕拉德",
            "text": "不要伤心，塞琉斯会长，您就是最棒的！",
            "nextDialogs": [
              "400250703"
            ]
          },
          "400250703": {
            "id": "400250703",
            "speakerId": 1004,
            "speakerName": "塞琉斯",
            "text": "……",
            "nextDialogs": [
              "400250704"
            ]
          },
          "400250704": {
            "id": "400250704",
            "speakerId": 1004,
            "speakerName": "塞琉斯",
            "text": "你这家伙也别整天忙着休息了。物资准备好了吗？热身运动做了吗？还不赶紧！",
            "nextDialogs": [
              "400250705"
            ]
          },
          "400250705": {
            "id": "400250705",

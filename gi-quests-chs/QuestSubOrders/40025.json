  "subQuests": [
    {
      "subId": "4002501",
      "subQuestName": "前往蒙德炼金铺",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "400250101"
        ],
        "dialogs": {
          "400250101": {
            "id": "400250101",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "喂，蒂玛…咦，那是阿贝多吗？他怎么走了？",
            "nextDialogs": [
              "400250104"
            ]
          },
          "400250104": {
            "id": "400250104",
            "speakerId": 1001,
            "speakerName": "蒂玛乌斯",
            "text": "哎呀？是旅行者和派蒙！",
            "nextDialogs": [
              "400250105"
            ]
          },
          "400250105": {
            "id": "400250105",
            "speakerId": 1002,
            "speakerName": "砂糖",
            "text": "两位，你们好！好久不见了呢！",
            "nextDialogs": [
              "400250106"
            ]
          },
          "400250106": {
            "id": "400250106",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "你们刚刚是在讨论什么重要的事吗？",
            "nextDialogs": [
              "400250107"
            ]
          },
          "400250107": {
            "id": "400250107",
            "speakerId": 1001,
            "speakerName": "蒂玛乌斯",
            "text": "我们一般都会约在这里见面，例行交流最近的研究课题。",
            "nextDialogs": [
              "400250108"
            ]
          },
          "400250108": {
            "id": "400250108",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "可恶，来晚一步，要是能叫住阿贝多该多好…",
            "nextDialogs": [
              "400250109"
            ]
          },
          "400250109": {
            "id": "400250109",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "不过看他刚才那个表情，比平时冷淡一点，该不会是遇到什么不高兴的事了吧？要是那样，估计也没心情帮我。",
            "nextDialogs": [
              "400250110"
            ]
          },
          "400250110": {
            "id": "400250110",
            "speakerId": 1002,
            "speakerName": "砂糖",
            "text": "那个…请问你说的不高兴，是指阿贝多先生吗？",
            "nextDialogs": [
              "400250111"
            ]
          },
          "400250111": {
            "id": "400250111",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "对呀，我看他刚才表情和平时不太一样。",
            "nextDialogs": [
              "400250112"
            ]
          },
          "400250112": {
            "id": "400250112",
            "speakerId": 1002,
            "speakerName": "砂糖",
            "text": "不高兴…呃，该不会是…",
            "nextDialogs": [
              "400250113"
            ]
          },
          "400250113": {
            "id": "400250113",
            "speakerId": 1001,
            "speakerName": "蒂玛乌斯",
            "text": "你、你看我干什么？",
            "nextDialogs": [
              "400250114"
            ]
          },
          "400250114": {
            "id": "400250114",
            "speakerId": 1002,
            "speakerName": "砂糖",
            "text": "难道是蒂玛乌斯最近想出来的研究课题太无聊，激怒了阿贝多先生？",
            "nextDialogs": [
              "400250115"
            ]
          },
          "400250115": {
            "id": "400250115",
            "speakerId": 1001,
            "speakerName": "蒂玛乌斯",
            "text": "不、不至于这么无聊吧！",
            "nextDialogs": [
              "400250116"
            ]
          },
          "400250116": {
            "id": "400250116",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "不会吧？我还想让蒂玛乌斯帮忙来着！",
            "nextDialogs": [
              "400250117"
            ]
          },
          "400250117": {
            "id": "400250117",
            "speakerId": 1001,
            "speakerName": "蒂玛乌斯",
            "text": "帮忙？哈哈，可以啊，请问是什么事需要我帮忙呢？",
            "nextDialogs": [
              "400250118"
            ]
          },
          "400250118": {
            "id": "400250118",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "是这样的，前些日子我在山上捡到一批特别特别甜的日落果，但这么甜的果子，吃完就没了，很舍不得…",
            "nextDialogs": [
              "400250119"
            ]
          },
          "400250119": {
            "id": "400250119",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "所以，我想让你帮我做个装置，果子放进去直接变成果汁，这样就能一直保存了吧！"
          }
        }
      }
    },
    {
      "subId": "4002502",
      "subQuestName": "与众人对话",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [],
        "dialogs": {}
      }
    },
    {
      "subId": "4002503",
      "subQuestName": "前往雪山",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "400250201"
        ],
        "dialogs": {
          "400250201": {
            "id": "400250201",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "嗯？那边好热闹，我们过去看看吧！",
            "nextDialogs": [
              "400250202"
            ]
          },
          "400250202": {
            "id": "400250202",
            "speakerId": 1003,
            "speakerName": "安柏",
            "text": "啊，是旅行者和派蒙！没想到会在雪山遇见你们。",
            "nextDialogs": [
              "400250203"
            ]
          },
          "400250203": {
            "id": "400250203",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "居然是安柏，还有塞琉斯会长、帕拉德…大家怎么都跑到雪山来了？不怕冷吗？",
            "nextDialogs": [
              "400250204"
            ]
          },
          "400250204": {
            "id": "400250204",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "各位，好久不见。",
            "nextDialogs": [
              "400250205"
            ]
          },
          "400250205": {
            "id": "400250205",
            "speakerId": 1004,
            "speakerName": "塞琉斯",
            "text": "哦？连旅行者也要加入了啊。好事，天大的好事！哈哈哈，人就是要越多越好。",
            "nextDialogs": [
              "400250206"
            ]
          },
          "400250206": {
            "id": "400250206",
            "speakerId": 1005,
            "speakerName": "冒失的帕拉德",
            "text": "是啊，一下就放心了呢，旅行者一定会是可靠的同伴。",
            "nextDialogs": [
              "400250209"
            ]
          },
          "400250209": {
            "id": "400250209",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "对哦！仔细看看好多都是冒险家协会的人，其中还混进了一位侦察骑士。",
            "nextDialogs": [
              "400250210"
            ]
          },
          "400250210": {
            "id": "400250210",
            "speakerId": 1004,
            "speakerName": "塞琉斯",
            "text": "哈哈哈…还是让我来解释吧。",
            "nextDialogs": [
              "400250211"
            ]
          },
          "400250211": {
            "id": "400250211",
            "speakerId": 1004,
            "speakerName": "塞琉斯",
            "text": "我们冒险家协会最近在雪山举办了一个冬季特训。",
            "nextDialogs": [
              "400250212"
            ]
          },
          "400250212": {
            "id": "400250212",
            "speakerId": 1004,
            "speakerName": "塞琉斯",
            "text": "你们也知道，成员的冒险经验各不相同，为了寻求突破独自冲进雪山是很危险的。",
            "nextDialogs": [
              "400250213"
            ]
          },
          "400250213": {
            "id": "400250213",
            "speakerId": 1004,
            "speakerName": "塞琉斯",
            "text": "所以我们提前做好安排，让前辈带领后辈，行家陪同菜鸟。大家一起进入雪山，在有保护的环境下进行训练。",
            "nextDialogs": [
              "400250214"
            ]
          },
          "400250214": {
            "id": "400250214",
            "speakerId": 1004,
            "speakerName": "塞琉斯",
            "text": "这样，冒险家们就能共同进步了。这就是我筹备了半年的伟大计划！很棒对不对！",
            "nextDialogs": [
              "400250215"
            ]
          },
          "400250215": {
            "id": "400250215",
            "speakerId": 1004,
            "speakerName": "塞琉斯",
            "text": "#{NICKNAME}，你作为优秀冒险家，当然也会愿意加入我们，助我们一臂之力，对吧？",
            "nextDialogs": [
              "400250216"
            ]
          },
          "400250216": {
            "id": "400250216",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "呃…安柏，你怎么在这里？",
            "nextDialogs": [
              "400250217"
            ]
          },
          "400250217": {
            "id": "400250217",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "难道是冒险家协会的前辈人手不够了？",
            "nextDialogs": [
              "400250218"
            ]
          },
          "400250218": {
            "id": "400250218",
            "speakerId": 1003,
            "speakerName": "安柏",
            "text": "也、也有一部分原因…",
            "nextDialogs": [
              "400250219"
            ]
          },
          "400250219": {
            "id": "400250219",
            "speakerId": 1003,
            "speakerName": "安柏",
            "text": "我这次巡逻经过了雪山边界，发现一个叫乔尔的孩子独自迷路了。",
            "nextDialogs": [
              "400250220"
            ]
          },
          "400250220": {
            "id": "400250220",
            "speakerId": 1003,
            "speakerName": "安柏",
            "text": "我听说他长期住在这个营地，就把他送了回来。"
          }
        }
      }
    },
    {
      "subId": "4002504",
      "subQuestName": "与寂寞的乔尔对话",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "400250301"
        ],
        "dialogs": {
          "400250301": {
            "id": "400250301",
            "speakerId": 1003,
            "speakerName": "安柏",
            "text": "乔尔，我们来啦。",
            "nextDialogs": [
              "400250304"
            ]
          },
          "400250304": {
            "id": "400250304",
            "speakerId": 1006,
            "speakerName": "乔尔",
            "text": "你们好啊。哈哈，难得有这么多人聚在一起，真开心。",
            "nextDialogs": [
              "400250305"
            ]
          },
          "400250305": {
            "id": "400250305",
            "speakerId": 1006,
            "speakerName": "乔尔",
            "text": "骑士大姐姐，你也是来堆雪人的吗？",
            "nextDialogs": [
              "400250306"
            ]
          },
          "400250306": {
            "id": "400250306",
            "speakerId": 1007,
            "speakerName": "优菈",
            "text": "堆…堆雪人？",
            "nextDialogs": [
              "400250307"
            ]
          },
          "400250307": {
            "id": "400250307",
            "speakerId": 1003,
            "speakerName": "安柏",
            "text": "啊，抱歉抱歉，我还没来得及做介绍。",
            "nextDialogs": [
              "400250308"
            ]
          },
          "400250308": {
            "id": "400250308",
            "speakerId": 1003,
            "speakerName": "安柏",
            "text": "这位是浪花骑士优菈，西风骑士团游击小队的队长…",
            "nextDialogs": [
              "400250309"
            ]
          },
          "400250309": {
            "id": "400250309",
            "speakerId": 1007,
            "speakerName": "优菈",
            "text": "安柏，你这样介绍太过正式了，人家很难记住吧。",
            "nextDialogs": [
              "400250310"
            ]
          },
          "400250310": {
            "id": "400250310",
            "speakerId": 1007,
            "speakerName": "优菈",
            "text": "小朋友，叫我优菈就好了。",
            "nextDialogs": [
              "400250311"
            ]
          },
          "400250311": {
            "id": "400250311",
            "speakerId": 1006,
            "speakerName": "乔尔",
            "text": "嗯，优菈姐姐！你也叫我乔尔就好了。",
            "nextDialogs": [
              "400250312"
            ]
          },
          "400250312": {
            "id": "400250312",
            "speakerId": 1007,
            "speakerName": "优菈",
            "text": "优菈…姐姐…",
            "nextDialogs": [
              "400250313"
            ]
          },
          "400250313": {
            "id": "400250313",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "完了，优菈要对小孩子记仇了。",
            "nextDialogs": [
              "400250314"
            ]
          },
          "400250314": {
            "id": "400250314",
            "speakerId": 1007,
            "speakerName": "优菈",
            "text": "…算了，既然你想这样叫的话，就这样叫吧。",
            "nextDialogs": [
              "400250315"
            ]
          },
          "400250315": {
            "id": "400250315",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "居然就这么放过去了！",
            "nextDialogs": [
              "400250316"
            ]
          },
          "400250316": {
            "id": "400250316",
            "speakerId": 1007,
            "speakerName": "优菈",
            "text": "那么，安柏，堆雪人又是怎么回事？我可是听你说冒险家协会人手不足才来帮忙的。",
            "nextDialogs": [
              "400250317"
            ]
          },
          "400250317": {
            "id": "400250317",
            "speakerId": 1003,
            "speakerName": "安柏",
            "text": "帮忙是另一件事啦。但你看，乔尔现在正是应该开心玩耍的年纪，雪山上又没有什么玩具。",
            "nextDialogs": [
              "400250318"
            ]
          },
          "400250318": {
            "id": "400250318",
            "speakerId": 1003,
            "speakerName": "安柏",
            "text": "从前是和爸爸一起堆雪人，现在爸爸不在身边，那就由我们来陪他吧。",
            "nextDialogs": [
              "400250319"
            ]
          },
          "400250319": {
            "id": "400250319",
            "speakerId": 1003,
            "speakerName": "安柏",
            "text": "况且优菈你独自在雪山上泡澡，不也挺无聊的嘛。",
            "nextDialogs": [
              "400250320"
            ]
          },
          "400250320": {
            "id": "400250320",
            "speakerId": 1003,
            "speakerName": "安柏",
            "text": "大家共同努力堆一个大雪人，嘿嘿，一定会很有趣的。",
            "nextDialogs": [
              "400250321"
            ]
          },
          "400250321": {
            "id": "400250321",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "我赞同。",
            "nextDialogs": [
              "400250322"
            ]
          },
          "400250322": {
            "id": "400250322",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "对哦对哦，我也会出力的！",
            "nextDialogs": [
              "400250323"
            ]
          },
          "400250323": {
            "id": "400250323",
            "speakerId": 1007,
            "speakerName": "优菈",
            "text": "……",
            "nextDialogs": [
              "400250324"
            ]
          },
          "400250324": {
            "id": "400250324",
            "speakerId": 1006,
            "speakerName": "乔尔",
            "text": "优菈姐姐，是有其他的事情要做吗？",
            "nextDialogs": [
              "400250325"
            ]
          },
          "400250325": {
            "id": "400250325",
            "speakerId": 1006,
            "speakerName": "乔尔",
            "text": "没关系的哦，如果你…",
            "nextDialogs": [
              "400250326"
            ]
          },
          "400250326": {
            "id": "400250326",
            "speakerId": 1007,
            "speakerName": "优菈",
            "text": "不，并不是这样。我只是在想别的事情而已。和乔尔一起堆雪人，当然没什么问题了。",
            "nextDialogs": [
              "400250327"
            ]
          },
          "400250327": {
            "id": "400250327",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "优菈？",
            "nextDialogs": [
              "400250328"
            ]
          },
          "400250328": {
            "id": "400250328",
            "speakerId": 1003,
            "speakerName": "安柏",
            "text": "那我们就行动起来，现在就开始分组找素材吧！",
            "nextDialogs": [
              "400250329"
            ]
          },
          "400250329": {
            "id": "400250329",
            "speakerId": 1003,
            "speakerName": "安柏",
            "text": "#我和乔尔一组，{NICKNAME}，优菈就拜托你了。",
            "nextDialogs": [
              "400250330"
            ]
          },
          "400250330": {
            "id": "400250330",
            "speakerId": 1003,
            "speakerName": "安柏",
            "text": "乔尔，你知道那边有棵巨大的大树吗？我们以它为终点，看看谁先跑到好不好？",
            "nextDialogs": [
              "400250331"
            ]
          },
          "400250331": {
            "id": "400250331",
            "speakerId": 1006,
            "speakerName": "乔尔",
            "text": "啊，啊，好的！",
            "nextDialogs": [
              "400250332"
            ]
          },
          "400250332": {
            "id": "400250332",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "啊，两个人一下子就跑远了。",
            "nextDialogs": [
              "400250333"
            ]
          },
          "400250333": {
            "id": "400250333",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "都说不准他们俩到底是谁玩得比较开心了。",
            "nextDialogs": [
              "400250334"
            ]
          },
          "400250334": {
            "id": "400250334",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "等等，你们俩，为什么互相看着不说话。"
          }
        }
      }
    },
    {
      "subId": "4002505",
      "subQuestName": "进入雪山寻找安柏",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "400250501"
        ],
        "dialogs": {
          "400250501": {
            "id": "400250501",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "奇怪，他们不是说要往这边跑吗？怎么完全没看见人影。",
            "nextDialogs": [
              "400250502"
            ]
          },
          "400250502": {
            "id": "400250502",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "难道是我们来太晚了，他们已经去了别的地方？",
            "nextDialogs": [
              "400250505"
            ]
          },
          "400250505": {
            "id": "400250505",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "那…那他们不会有危险吧！",
            "nextDialogs": [
              "400250506"
            ]
          },
          "400250506": {
            "id": "400250506",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "我们快点追上去看看！"
          }
        }
      }
    },

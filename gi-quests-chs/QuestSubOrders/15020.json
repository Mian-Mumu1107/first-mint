  "subQuests": [
    {
      "subId": "1502001",
      "subQuestName": "去找场地工作人员",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "150200101"
        ],
        "dialogs": {
          "150200101": {
            "id": "150200101",
            "speakerId": 6247,
            "speakerName": "因卡纳克",
            "text": "欸，恰斯卡？是阿尔帕长老让你来的吗？",
            "nextDialogs": [
              "150200102"
            ]
          },
          "150200102": {
            "id": "150200102",
            "speakerId": 1092,
            "speakerName": "恰斯卡",
            "text": "嗯，她还有其他事要做，这边的情况怎么样？",
            "nextDialogs": [
              "150200103"
            ]
          },
          "150200103": {
            "id": "150200103",
            "speakerId": 6247,
            "speakerName": "因卡纳克",
            "text": "唔…根据调查结果，应该是过去的几次深渊入侵，导致了地脉紊乱，在试炼场地里形成了各种各样的「阻塞」。",
            "nextDialogs": [
              "150200104"
            ]
          },
          "150200104": {
            "id": "150200104",
            "speakerId": 6247,
            "speakerName": "因卡纳克",
            "text": "理论上只要清理掉这些阻塞，就能让气态燃素再次充盈，但实际操作起来却各有各的问题…",
            "nextDialogs": [
              "150200105"
            ]
          },
          "150200105": {
            "id": "150200105",
            "speakerId": 6247,
            "speakerName": "因卡纳克",
            "text": "具体情况，你们可以直接下去看看？也可以问问在场的工作人员。"
          }
        }
      }
    },
    {
      "subId": "1502013",
      "subQuestName": "(test)靠近后触发对话$HIDDEN",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "150201001"
        ],
        "dialogs": {
          "150201001": {
            "id": "150201001",
            "speakerId": 21711,
            "speakerName": "大胆的调查员",
            "text": "咦，你们是来帮忙的吗？谢天谢地！我正愁没人配合呢。",
            "nextDialogs": [
              "150201002"
            ]
          },
          "150201002": {
            "id": "150201002",
            "speakerId": 21711,
            "speakerName": "大胆的调查员",
            "text": "这里的「阻塞」要用特制的炸弹来清理，但是带着炸药爬上这么陡峭的山峰…",
            "nextDialogs": [
              "150201003"
            ]
          },
          "150201003": {
            "id": "150201003",
            "speakerId": 21711,
            "speakerName": "大胆的调查员",
            "text": "磕一下碰一下，一条小命就没了！所以我打算把炸药运到对面，再用热气球送过来…",
            "nextDialogs": [
              "150201004"
            ]
          },
          "150201004": {
            "id": "150201004",
            "speakerId": 21711,
            "speakerName": "大胆的调查员",
            "text": "只要有人能在这里<color=#00E1FFFF>看准时机击中热气球，让炸药刚刚好落在喷口上…</color>问题就解决了！",
            "nextDialogs": [
              "150201005"
            ]
          },
          "150201005": {
            "id": "150201005",
            "speakerId": 21711,
            "speakerName": "大胆的调查员",
            "text": "怎么样？很简单易懂对吧？",
            "nextDialogs": [
              "150201006"
            ]
          },
          "150201006": {
            "id": "150201006",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "确实挺简单的…",
            "nextDialogs": [
              "150201007"
            ]
          },
          "150201007": {
            "id": "150201007",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "所以上面那个热气球也是你放的？",
            "nextDialogs": [
              "150201008"
            ]
          },
          "150201008": {
            "id": "150201008",
            "speakerId": 21711,
            "speakerName": "大胆的调查员",
            "text": "嗯？你说那个啊…我也不知道是谁放的，居然能升得这么高。",
            "nextDialogs": [
              "150201009"
            ]
          },
          "150201009": {
            "id": "150201009",
            "speakerId": 21711,
            "speakerName": "大胆的调查员",
            "text": "要是能飞上去看看它是用了什么技术就好了…不过现在修理场地的事更重要。",
            "nextDialogs": [
              "150201010"
            ]
          },
          "150201010": {
            "id": "150201010",
            "speakerId": 21711,
            "speakerName": "大胆的调查员",
            "text": "我这就去对面布置，你们准备好了，就喊我一声！"
          }
        }
      }
    },
    {
      "subId": "1502009",
      "subQuestName": "清理场地内的阻塞",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "150200901"
        ],
        "dialogs": {
          "150200901": {
            "id": "150200901",
            "speakerId": 21709,
            "speakerName": "疑惑的调查员",
            "text": "你！你看到了吗！刚刚有一头嵴锋龙突然出现了！",
            "nextDialogs": [
              "150200902"
            ]
          },
          "150200902": {
            "id": "150200902",
            "speakerId": 21710,
            "speakerName": "迷惑的调查员",
            "text": "难…难道是路过的…？不管了，喷口清理完了就好…"
          }
        }
      }
    },
    {
      "subId": "1502010",
      "subQuestName": "清理场地内的阻塞",
      "sceneId": null,

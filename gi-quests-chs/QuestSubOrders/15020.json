    {
      "subId": "1502011",
      "subQuestName": "清理场地内的阻塞",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "150201101"
        ],
        "dialogs": {
          "150201101": {
            "id": "150201101",
            "speakerId": 21711,
            "speakerName": "大胆的调查员",
            "text": "咦？你们怎么跑过来了？在这边可不好看清位置啊。",
            "nextDialogs": [
              "150201102"
            ]
          },
          "150201102": {
            "id": "150201102",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "能重新说明一下计划吗？",
            "nextDialogs": [
              "150201103"
            ]
          },
          "150201103": {
            "id": "150201103",
            "speakerId": 21711,
            "speakerName": "大胆的调查员",
            "text": "哦，我打算用热气球把炸药送到对面的喷口上空…",
            "nextDialogs": [
              "150201104"
            ]
          },
          "150201104": {
            "id": "150201104",
            "speakerId": 21711,
            "speakerName": "大胆的调查员",
            "text": "只要你<color=#00E1FFFF>看准时机击中热气球，让炸药刚刚好落在喷口上…</color>问题就解决了！"
          }
        }
      }
    },
    {
      "subId": "1502012",

    {
      "subId": "1502002",
      "subQuestName": "清理场地内的阻塞$HIDDEN",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "150200201"
        ],
        "dialogs": {
          "150200201": {
            "id": "150200201",
            "speakerId": 21708,
            "speakerName": "谨慎的调查员",
            "text": "嗯…看起来这个喷口，<color=#00E1FFFF>只要进行多次打击就能清理掉。</color>",
            "nextDialogs": [
              "150200202"
            ]
          },
          "150200202": {
            "id": "150200202",
            "speakerId": 21708,
            "speakerName": "谨慎的调查员",
            "text": "不过这里头似乎有奇怪的生命活动迹象，不知道直接动手会不会有危险啊…"
          }
        }
      }
    },
    {
      "subId": "1502003",
      "subQuestName": "返回高处与因卡纳克对话",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "150200301"
        ],
        "dialogs": {
          "150200301": {
            "id": "150200301",
            "speakerId": 21708,
            "speakerName": "谨慎的调查员",
            "text": "哈哈…我还以为自己要完了！这儿的喷口已经没事了，多谢你们。"
          }
        }
      }
    },
    {
      "subId": "1502004",
      "subQuestName": "与因卡纳克对话",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "150200401"
        ],
        "dialogs": {
          "150200401": {
            "id": "150200401",
            "speakerId": 6247,
            "speakerName": "因卡纳克",
            "text": "居然用这么短的时间就清理完了…真不愧是你们！",
            "nextDialogs": [
              "150200402"
            ]
          },
          "150200402": {
            "id": "150200402",
            "speakerId": 6247,
            "speakerName": "因卡纳克",
            "text": "接下来只要等气态燃素逐渐充盈，飞行试炼就能正常举办了。",
            "nextDialogs": [
              "150200403"
            ]
          },
          "150200403": {
            "id": "150200403",
            "speakerId": 1092,
            "speakerName": "恰斯卡",
            "text": "唔…因卡纳克，我想先试飞一下，看看还有没有遗漏，能帮我安排一下吗？",
            "nextDialogs": [
              "150200404"
            ]
          },
          "150200404": {
            "id": "150200404",
            "speakerId": 6247,
            "speakerName": "因卡纳克",
            "text": "欸？可是场地才刚刚清理完，万一有什么危险没发现…",
            "nextDialogs": [
              "150200405"
            ]
          },
          "150200405": {
            "id": "150200405",
            "speakerId": 1092,
            "speakerName": "恰斯卡",
            "text": "所以才更应该由我来检查吧。",
            "nextDialogs": [
              "150200406"
            ]
          },
          "150200406": {
            "id": "150200406",
            "speakerId": 6247,
            "speakerName": "因卡纳克",
            "text": "啊…也对，以你的飞行技巧，就算有什么遗漏，也不会是致命的危险…",
            "nextDialogs": [
              "150200407"
            ]
          },
          "150200407": {
            "id": "150200407",
            "speakerId": 1092,
            "speakerName": "恰斯卡",
            "text": "这片区域里的环境还不稳定，不亲自试飞一下，很难检查出问题。",
            "nextDialogs": [
              "150200408"
            ]
          },
          "150200408": {
            "id": "150200408",
            "speakerId": 6247,
            "speakerName": "因卡纳克",
            "text": "那我这就去安排。你准备好的话，就随时跟我说一声吧。"
          }
        }
      }
    },
    {
      "subId": "1502014",
      "subQuestName": "与因卡纳克对话",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "150201401"
        ],
        "dialogs": {
          "150201401": {
            "id": "150201401",
            "speakerId": 21716,
            "speakerName": "好奇的调查员",
            "text": "奇怪…明明已经铆足了力气，怎么还是敲不破…",
            "nextDialogs": [
              "150201402"
            ]
          },
          "150201402": {
            "id": "150201402",
            "speakerId": 21716,
            "speakerName": "好奇的调查员",
            "text": "难道真像因卡纳克说的，固态燃素内部已经形成稳定结构…需要同时击中所有弱点才能清理？",
            "nextDialogs": [
              "150201403"
            ]
          },
          "150201403": {
            "id": "150201403",
            "speakerId": 21716,
            "speakerName": "好奇的调查员",
            "text": "——可是要怎么才能<color=#00E1FFFF>同时击中这些弱点</color>呢？"
          }
        }
      }
    },
    {
      "subId": "1502005",
      "subQuestName": "完成飞行挑战",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "150200501"
        ],
        "dialogs": {
          "150200501": {
            "id": "150200501",
            "speakerId": 6247,
            "speakerName": "因卡纳克",
            "text": "准备好了吗？虽然对恰斯卡来说不是什么难事，不过还是要注意安全。",
            "nextDialogs": [
              "150200503"
            ]
          },
          "150200503": {
            "id": "150200503",
            "speakerId": 6247,
            "speakerName": "因卡纳克",
            "text": "嗯，那就大胆地飞吧！"
          }
        }
      }
    },
    {
      "subId": "1502006",
      "subQuestName": "与恰斯卡对话",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "150200601"
        ],
        "dialogs": {
          "150200601": {
            "id": "150200601",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "好精彩的飞行！我连眼睛都不舍得眨！",
            "nextDialogs": [
              "150200602"
            ]
          },
          "150200602": {
            "id": "150200602",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "还有什么遗漏吗？",
            "nextDialogs": [
              "150200603"
            ]
          },
          "150200603": {
            "id": "150200603",
            "speakerId": 1092,
            "speakerName": "恰斯卡",
            "text": "嗯…没什么大问题，只要再过几天，就能正常举行试炼了。",
            "nextDialogs": [
              "150200604"
            ]
          },
          "150200604": {
            "id": "150200604",
            "speakerId": 15005,
            "speakerName": "伊西多尔",
            "text": "救——救命啊——",
            "nextDialogs": [
              "150200605"
            ]
          },
          "150200605": {
            "id": "150200605",
            "speakerId": 15005,
            "speakerName": "伊西多尔",
            "text": "你们…你们是花羽会的人吧？快…快来帮帮我们！",
            "nextDialogs": [
              "150200606"
            ]
          },
          "150200606": {
            "id": "150200606",
            "speakerId": 1092,
            "speakerName": "恰斯卡",
            "text": "冷静点，出什么事了？",
            "nextDialogs": [
              "150200607"
            ]
          },
          "150200607": {
            "id": "150200607",
            "speakerId": 15005,
            "speakerName": "伊西多尔",
            "text": "有…有一只绒翼龙，突然袭击了我们！",
            "nextDialogs": [
              "150200608"
            ]
          },
          "150200608": {
            "id": "150200608",
            "speakerId": 15005,
            "speakerName": "伊西多尔",
            "text": "我的同伴跟货物都还在大道上…求求你们，快去救救他们吧！",
            "nextDialogs": [
              "150200609"
            ]
          },
          "150200609": {
            "id": "150200609",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "欸？绒翼龙…有这么凶猛吗？一只直接袭击了一群人？",
            "nextDialogs": [
              "150200610"
            ]
          },
          "150200610": {
            "id": "150200610",
            "speakerId": 1092,
            "speakerName": "恰斯卡",
            "text": "按理说应该不会…但凡事总有例外，先过去看看！"
          }
        }
      }
    },
    {
      "subId": "1502007",
      "subQuestName": "前去救助商队",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "150200701"
        ],
        "dialogs": {
          "150200701": {
            "id": "150200701",
            "speakerId": 21709,
            "speakerName": "疑惑的调查员",
            "text": "奇了怪了…这里怎么会出现那么多固态燃素？",
            "nextDialogs": [
              "150200702"
            ]
          },
          "150200702": {
            "id": "150200702",
            "speakerId": 21710,
            "speakerName": "迷惑的调查员",
            "text": "是不是因为地脉紊乱，把「回声之子」的什么东西给卷进来了？<color=#00E1FFFF>我刚刚在悬崖上就有看见奇怪的印记…</color>",
            "nextDialogs": [
              "150200703"
            ]
          },
          "150200703": {
            "id": "150200703",
            "speakerId": 21709,
            "speakerName": "疑惑的调查员",
            "text": "不会吧？难道我们还得去「回声之子」借一头<color=#00E1FFFF>嵴锋龙</color>来清理吗？"
          }
        }
      }
    },
    {
      "subId": "1502008",
      "subQuestName": "与阿尔帕对话",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "150200801"
        ],
        "dialogs": {
          "150200801": {
            "id": "150200801",
            "speakerId": 21648,
            "speakerName": "阿尔帕",
            "text": "#嗯？恰斯卡、{NICKNAME}，你们也来了？",
            "nextDialogs": [
              "150200802"
            ]
          },
          "150200802": {
            "id": "150200802",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "阿尔帕长老？咦？他们说的绒翼龙呢？",
            "nextDialogs": [
              "150200803"
            ]
          },
          "150200803": {
            "id": "150200803",
            "speakerId": 21648,
            "speakerName": "阿尔帕",
            "text": "已经先我们一步飞走了，看来是知道救兵要到，率先撤退了。",
            "nextDialogs": [
              "150200804"
            ]
          },
          "150200804": {
            "id": "150200804",
            "speakerId": 1092,
            "speakerName": "恰斯卡",
            "text": "那它突然袭击人类的目的…是商队运送的食物吗？",
            "nextDialogs": [
              "150200805"
            ]
          },
          "150200805": {
            "id": "150200805",
            "speakerId": 21648,
            "speakerName": "阿尔帕",
            "text": "不，这支商队运送的不是食物…",
            "nextDialogs": [
              "150200806"
            ]
          },
          "150200806": {
            "id": "150200806",
            "speakerId": 21713,
            "speakerName": "年轻的行商",
            "text": "——哦！谢天谢地！「燃素翼」都还没事！",
            "nextDialogs": [
              "150200807"
            ]
          },
          "150200807": {
            "id": "150200807",
            "speakerId": 1092,
            "speakerName": "恰斯卡",
            "text": "…「燃素翼」？",
            "nextDialogs": [
              "150200808"
            ]
          },
          "150200808": {
            "id": "150200808",
            "speakerId": 21712,
            "speakerName": "伊西多尔",
            "text": "哎呀，太感谢了。这批「燃素翼」是我们最重要的货物，万一有什么闪失，可真不知道该怎么办！",
            "nextDialogs": [
              "150200809"
            ]
          },
          "150200809": {
            "id": "150200809",
            "speakerId": 21648,
            "speakerName": "阿尔帕",
            "text": "…你们就是之前瓦尔米说的，要来跟我们谈合作的商队？",
            "nextDialogs": [
              "150200810"
            ]
          },
          "150200810": {
            "id": "150200810",
            "speakerId": 21712,
            "speakerName": "伊西多尔",
            "text": "啊，没错没错，那…您就是阿尔帕长老咯？",
            "nextDialogs": [
              "150200811"
            ]
          },
          "150200811": {
            "id": "150200811",
            "speakerId": 21648,
            "speakerName": "阿尔帕",
            "text": "是我。各位舟车劳顿，又受了惊吓，就先跟我一起回花羽会好好休息吧，有什么事，可以之后再谈。",
            "nextDialogs": [
              "150200812"
            ]
          },
          "150200812": {
            "id": "150200812",
            "speakerId": 1092,
            "speakerName": "恰斯卡",
            "text": "阿尔帕长老，那绒翼龙袭击的事…",
            "nextDialogs": [
              "150200813"
            ]
          },
          "150200813": {
            "id": "150200813",
            "speakerId": 21648,
            "speakerName": "阿尔帕",
            "text": "唔，我看这些朋友并没有受重伤，货物也没什么损失…或许只是那只绒翼龙，偶然间受到了什么刺激吧。",
            "nextDialogs": [
              "150200814"
            ]
          },
          "150200814": {
            "id": "150200814",
            "speakerId": 21648,
            "speakerName": "阿尔帕",
            "text": "这附近的绒翼龙那么多，出现一两次意外也不奇怪，就不用费心去追查了…倒是飞行试炼那边，修整得怎么样了？",
            "nextDialogs": [
              "150200817"
            ]
          },
          "150200817": {
            "id": "150200817",
            "speakerId": 21712,
            "speakerName": "伊西多尔",
            "text": "哦？飞行试炼？——那可真是巧了！阿尔帕长老，我们的「燃素翼」一定能在试炼上给您一个惊喜！",
            "nextDialogs": [
              "150200818"
            ]
          },
          "150200818": {
            "id": "150200818",
            "speakerId": 21648,
            "speakerName": "阿尔帕",
            "text": "是吗？…听起来倒是挺有趣的。",
            "nextDialogs": [
              "150200819"
            ]
          },
          "150200819": {
            "id": "150200819",
            "speakerId": 21712,
            "speakerName": "伊西多尔",
            "text": "嘿嘿，那绒翼龙的事就放一边…我们快回去谈谈「燃素翼」的合作吧！",
            "nextDialogs": [
              "150200820"
            ]
          },
          "150200820": {
            "id": "150200820",
            "speakerId": 1092,
            "speakerName": "恰斯卡",
            "text": "……",
            "nextDialogs": [
              "150200821"
            ]
          },
          "150200821": {
            "id": "150200821",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "问题好像都解决了？还怪顺利的嘛…那我们也走吧…咦？恰斯卡？",
            "nextDialogs": [
              "150200822"
            ]
          },
          "150200822": {
            "id": "150200822",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "你在看什么呢？",
            "nextDialogs": [
              "150200823"
            ]
          },
          "150200823": {
            "id": "150200823",
            "speakerId": 1092,
            "speakerName": "恰斯卡",
            "text": "……",
            "nextDialogs": [
              "150200824"
            ]
          },
          "150200824": {
            "id": "150200824",
            "speakerId": 1092,
            "speakerName": "恰斯卡",
            "text": "染血的…羽毛？",
            "nextDialogs": [
              "150200825"
            ]
          },
          "150200825": {
            "id": "150200825",
            "speakerId": 1012,
            "speakerName": "Black Screen",
            "text": "这起风波最终不了了之，花羽会再次恢复了往日的平静。\\n在波澜不惊的日常中，飞行试炼也在紧锣密鼓地筹备…"
          }
        }
      }

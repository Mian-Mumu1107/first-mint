    {
      "subId": "7620403",
      "subQuestName": "与尼可对话",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "762040301"
        ],
        "dialogs": {
          "762040301": {
            "id": "762040301",
            "speakerId": 1322,
            "speakerName": "尼可",
            "text": "恭喜你们。让我看看…像这样！",
            "nextDialogs": [
              "762040302"
            ]
          },
          "762040302": {
            "id": "762040302",
            "speakerId": 1322,
            "speakerName": "尼可",
            "text": "不同于现在魔女的花园，这是从前我还是天使时待过的神殿，我在那住了很长一段时间。",
            "nextDialogs": [
              "762040303"
            ]
          },
          "762040303": {
            "id": "762040303",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "有好多天使啊，而且尼可看起来好受欢迎。",
            "nextDialogs": [
              "762040304"
            ]
          },
          "762040304": {
            "id": "762040304",
            "speakerId": 1322,
            "speakerName": "尼可",
            "text": "不是我炫耀，朋友们可爱听我讲故事呢，尤其是那类与人类同行、布下征兆，带领他们兴建文明的故事。",
            "nextDialogs": [
              "762040305"
            ]
          },
          "762040305": {
            "id": "762040305",
            "speakerId": 1322,
            "speakerName": "尼可",
            "text": "每次讲到关键时候，在场的天使们都会屏息凝神，连琴弦都不再震颤，画笔都不再抖动…",
            "nextDialogs": [
              "762040306"
            ]
          },
          "762040306": {
            "id": "762040306",
            "speakerId": 1322,
            "speakerName": "尼可",
            "text": "然后，交织的色彩绽开了。伴着乐声，金色的光芒遍及万物，那是我们的欢歌和喜悦。",
            "nextDialogs": [
              "762040307"
            ]
          },
          "762040307": {
            "id": "762040307",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "听上去真美好！",
            "nextDialogs": [
              "762040308"
            ]
          },
          "762040308": {
            "id": "762040308",
            "speakerId": 1322,
            "speakerName": "尼可",
            "text": "谁说不是呢？",
            "nextDialogs": [
              "762040309"
            ]
          },
          "762040309": {
            "id": "762040309",
            "speakerId": 1322,
            "speakerName": "尼可",
            "text": "虽然现在旧时的美好全然消逝了，但如今的生活随时都有新的惊喜。",
            "nextDialogs": [
              "762040310"
            ]
          },
          "762040310": {
            "id": "762040310",
            "speakerId": 1322,
            "speakerName": "尼可",
            "text": "有个家伙看我在读报纸竟然想偷我的雕塑品？他完蛋了！我今天就指引他去梅洛彼得堡的路要怎么走！",
            "nextDialogs": [
              "762040311"
            ]
          },
          "762040311": {
            "id": "762040311",
            "speakerId": 1003,
            "speakerName": "<UNKNOWN>",
            "text": "有个家伙看我在读报纸竟然想偷我的雕塑品？",
            "nextDialogs": [
              "762040312"
            ]
          },
          "762040312": {
            "id": "762040312",
            "speakerId": 1003,
            "speakerName": "<UNKNOWN>",
            "text": "他完蛋了！",
            "nextDialogs": [
              "762040313"
            ]
          },
          "762040313": {
            "id": "762040313",
            "speakerId": 1003,
            "speakerName": "<UNKNOWN>",
            "text": "我今天就指引他去梅洛彼得堡的路要怎么走！"
          }
        }
      }
    },
    {
      "subId": "7620499",

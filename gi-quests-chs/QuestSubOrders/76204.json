    {
      "subId": "7620402",
      "subQuestName": "进入房间",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "762040201"
        ],
        "dialogs": {
          "762040201": {
            "id": "762040201",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "尼可——奇怪，这里也没人。",
            "nextDialogs": [
              "762040202"
            ]
          },
          "762040202": {
            "id": "762040202",
            "speakerId": 1322,
            "speakerName": "尼可",
            "text": "你们已经到我的工作室了吗，有没有看到我从各地收集并栽培下的花草？",
            "nextDialogs": [
              "762040203"
            ]
          },
          "762040203": {
            "id": "762040203",
            "speakerId": 1322,
            "speakerName": "尼可",
            "text": "唉，好巧不巧我这会儿没法赶过来，我在枫丹摆摊卖雕塑呢。",
            "nextDialogs": [
              "762040204"
            ]
          },
          "762040204": {
            "id": "762040204",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "呃…需要我们帮忙吗？",
            "nextDialogs": [
              "762040205"
            ]
          },
          "762040205": {
            "id": "762040205",
            "speakerId": 1322,
            "speakerName": "尼可",
            "text": "别，这可是我唯一提笔写字的机会，尽管写的多数都是数字…",
            "nextDialogs": [
              "762040206"
            ]
          },
          "762040206": {
            "id": "762040206",
            "speakerId": 1322,
            "speakerName": "尼可",
            "text": "难得你们来一趟，不如就先玩起来。",
            "nextDialogs": [
              "762040207"
            ]
          },
          "762040207": {
            "id": "762040207",
            "speakerId": 1322,
            "speakerName": "尼可",
            "text": "我记得我在西边，团雀雕塑旁边留了一份卷轴，你们看见了吗？",
            "nextDialogs": [
              "762040208"
            ]
          },
          "762040208": {
            "id": "762040208",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "看见了！",
            "nextDialogs": [
              "762040209"
            ]
          },
          "762040209": {
            "id": "762040209",
            "speakerId": 1322,
            "speakerName": "尼可",
            "text": "那就让这位沉默的向导为你们提供帮助吧，加油！"
          }
        }
      }
    },

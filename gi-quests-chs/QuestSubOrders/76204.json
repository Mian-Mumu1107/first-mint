          "762040801"
        ],
        "dialogs": {
          "762040801": {
            "id": "762040801",
            "speakerId": 1000,
            "speakerName": "查看提示",
            "text": "那蔚蓝的当<color=#00E1FFFF>接近天穹。</color>",
            "nextDialogs": [
              "762040802"
            ]
          },
          "762040802": {
            "id": "762040802",
            "speakerId": 1000,
            "speakerName": "查看提示",
            "text": "那幽粉的当<color=#00E1FFFF>安于暗隅。</color>",
            "nextDialogs": [
              "762040803"
            ]
          },
          "762040803": {
            "id": "762040803",
            "speakerId": 1000,
            "speakerName": "查看提示",
            "text": "那薄黄的当与<color=#00E1FFFF>树根</color>比邻。",
            "nextDialogs": [
              "762040807"
            ]
          },
          "762040807": {
            "id": "762040807",
            "speakerId": 1000,
            "speakerName": "查看提示",
            "text": "歌者二人<color=#00E1FFFF>循声望去</color>，殿宇已无人吟唱。"
          }
        }
      }
    },

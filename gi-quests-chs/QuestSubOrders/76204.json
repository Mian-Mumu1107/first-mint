        "dialogs": {
          "762049901": {
            "id": "762049901",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "我还以为尼可在屋子里等我们呢，今天她不在家吗？",
            "nextDialogs": [
              "762049902"
            ]
          },
          "762049902": {
            "id": "762049902",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "不过这扇门似乎可以推开了，她难道是在房间里？我们进去找她吧。"
          }
        }
      }
    }

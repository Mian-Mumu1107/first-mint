        "dialogs": {
          "721170301": {
            "id": "721170301",
            "speakerId": 3162,
            "speakerName": "泽维尔",
            "text": "怎么样？信标都回收齐全了吗？",
            "nextDialogs": [
              "721170302"
            ]
          },
          "721170302": {
            "id": "721170302",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "已经回收齐全了。",
            "nextDialogs": [
              "721170303"
            ]
          },
          "721170303": {
            "id": "721170303",
            "speakerId": 3162,
            "speakerName": "泽维尔",
            "text": "太好了。我稍后就根据这些数据来改造一下这个装置。",
            "nextDialogs": [
              "721170304"
            ]
          },
          "721170304": {
            "id": "721170304",
            "speakerId": 3162,
            "speakerName": "泽维尔",
            "text": "不过，最近那些愚人众的活动越来越怪异了，他们似乎都集中在核心的区域。",
            "nextDialogs": [
              "721170305"
            ]
          },
          "721170305": {
            "id": "721170305",
            "speakerId": 3162,
            "speakerName": "泽维尔",
            "text": "希望这群家伙别是又在打什么鬼主意…或者说，不要做什么我们收拾不了的事情…"
          }
        }
      }
    },

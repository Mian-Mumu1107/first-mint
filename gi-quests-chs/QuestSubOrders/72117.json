        ],
        "dialogs": {
          "721170101": {
            "id": "721170101",
            "speakerId": 20624,
            "speakerName": "泽维尔",
            "text": "旅行者，您来得正好。数据应该搜集得差不多了，是去回收那些信标的时候了。",
            "nextDialogs": [
              "721170103",
              "721170105"
            ]
          },
          "721170103": {
            "id": "721170103",
            "speakerId": 20624,
            "speakerName": "泽维尔",
            "text": "那就交给您了，快去快回吧，别让那些愚人众发现了。"
          },
          "721170105": {
            "id": "721170105",
            "speakerId": 20624,
            "speakerName": "泽维尔",
            "text": "这种信标在制作的时候，一般会附带详细的使用说明手册。",
            "nextDialogs": [
              "721170106"
            ]
          },
          "721170106": {
            "id": "721170106",
            "speakerId": 20624,
            "speakerName": "泽维尔",
            "text": "针对不同的情况，说明书上也标明了不同的推荐搜集数据时长。",
            "nextDialogs": [
              "721170107"
            ]
          },
          "721170107": {
            "id": "721170107",
            "speakerId": 20624,
            "speakerName": "泽维尔",
            "text": "「祟神」这种属于「未知能量」的东西，我就直接按照最长的时间来算了…总之，回收信标的事就拜托您了。"
          }
        }
      }
    },

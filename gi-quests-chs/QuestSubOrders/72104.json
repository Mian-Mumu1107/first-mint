    {
      "subId": "7210423",
      "subQuestName": "（test）判定说过特殊分支1$HIDDEN",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "721043801"
        ],
        "dialogs": {
          "721043801": {
            "id": "721043801",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "玄冬小姐今天心情很好？",
            "nextDialogs": [
              "721043802"
            ]
          },
          "721043802": {
            "id": "721043802",
            "speakerId": 15465,
            "speakerName": "玄冬林檎",
            "text": "嗯？有什么问题吗？",
            "nextDialogs": [
              "721043803"
            ]
          },
          "721043803": {
            "id": "721043803",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "感觉和平时的气场不太一样…",
            "nextDialogs": [
              "721043804"
            ]
          },
          "721043804": {
            "id": "721043804",
            "speakerId": 15465,
            "speakerName": "玄冬林檎",
            "text": "欸，是这样吗？我会注意的！",
            "nextDialogs": [
              "721043805"
            ]
          },
          "721043805": {
            "id": "721043805",
            "speakerId": 15465,
            "speakerName": "玄冬林檎",
            "text": "可能是因为今天我抽到了「大吉」的签吧，感觉心情很好呢！也很想把这份心情跟您分享。",
            "nextDialogs": [
              "721043806"
            ]
          },
          "721043806": {
            "id": "721043806",
            "speakerId": 15465,
            "speakerName": "玄冬林檎",
            "text": "不过，对于某些人来说的「大吉」，对另一些人来说却可能意味着「大凶」。",
            "nextDialogs": [
              "721043807"
            ]
          },
          "721043807": {
            "id": "721043807",
            "speakerId": 15465,
            "speakerName": "玄冬林檎",
            "text": "那些抽到「大凶」的人…会有什么样的「御签挂」等着他们呢？",
            "nextDialogs": [
              "721043808"
            ]
          },
          "721043808": {
            "id": "721043808",
            "speakerId": 15465,
            "speakerName": "玄冬林檎",
            "text": "运势真是很值得玩味呢！再见。"
          }
        }
      }
    },

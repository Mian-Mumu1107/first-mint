    {
      "subId": "1303805",
      "subQuestName": "前往仪式之厅",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "130380301"
        ],
        "dialogs": {
          "130380301": {
            "id": "130380301",
            "speakerId": 14003,
            "speakerName": "杜安雷",
            "text": "今日，当着众贤之至贤，赫曼努比斯大人权柄与威能的见证，我等将再次举行决斗之仪。",
            "nextDialogs": [
              "130380302"
            ]
          },
          "130380302": {
            "id": "130380302",
            "speakerId": 14003,
            "speakerName": "杜安雷",
            "text": "此为至圣的仪式，观礼者将不可打扰，百般恭敬，庄严地观看全过程。",
            "nextDialogs": [
              "130380303"
            ]
          },
          "130380303": {
            "id": "130380303",
            "speakerId": 14003,
            "speakerName": "杜安雷",
            "text": "缄默之殿的代表。防守方。",
            "nextDialogs": [
              "130380304"
            ]
          },
          "130380304": {
            "id": "130380304",
            "speakerId": 1085,
            "speakerName": "赛索斯",
            "text": "爷爷，你来了。",
            "nextDialogs": [
              "130380305"
            ]
          },
          "130380305": {
            "id": "130380305",
            "speakerId": 13995,
            "speakerName": "巴穆恩",
            "text": "…咳…多少年了，你竟然举办这个仪式，赛索斯。",
            "nextDialogs": [
              "130380306"
            ]
          },
          "130380306": {
            "id": "130380306",
            "speakerId": 1085,
            "speakerName": "赛索斯",
            "text": "我知道我在做什么，爷爷，放心看着吧。",
            "nextDialogs": [
              "130380307"
            ]
          },
          "130380307": {
            "id": "130380307",
            "speakerId": 14003,
            "speakerName": "杜安雷",
            "text": "教令院的代表。进攻方。",
            "nextDialogs": [
              "130380308"
            ]
          },
          "130380308": {
            "id": "130380308",
            "speakerId": 1058,
            "speakerName": "赛诺",
            "text": "准备好了。今天我们会用实力赢下话语权。",
            "nextDialogs": [
              "130380309"
            ]
          },
          "130380309": {
            "id": "130380309",
            "speakerId": 14003,
            "speakerName": "杜安雷",
            "text": "那么，请双方就位，决定出战顺序。",
            "nextDialogs": [
              "130380310"
            ]
          },
          "130380310": {
            "id": "130380310",
            "speakerId": 14003,
            "speakerName": "杜安雷",
            "text": "在这里，我等将不问来者何来，去者何去，赌上赫曼努比斯的力量，战斗直到决出胜负！",
            "nextDialogs": [
              "130380311"
            ]
          },
          "130380311": {
            "id": "130380311",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "我打头阵吧。",
            "nextDialogs": [
              "130380312"
            ]
          },
          "130380312": {
            "id": "130380312",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "哎？真的吗？",
            "nextDialogs": [
              "130380313"
            ]
          },
          "130380313": {
            "id": "130380313",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "真的。士气很重要。",
            "nextDialogs": [
              "130380314"
            ]
          },
          "130380314": {
            "id": "130380314",
            "speakerId": 1050,
            "speakerName": "提纳里",
            "text": "#我同意，{NICKNAME}很强，率先出战能震慑对手。",
            "nextDialogs": [
              "130380315"
            ]
          },
          "130380315": {
            "id": "130380315",
            "speakerId": 1058,
            "speakerName": "赛诺",
            "text": "那你第二个。",
            "nextDialogs": [
              "130380316"
            ]
          },
          "130380316": {
            "id": "130380316",
            "speakerId": 1050,
            "speakerName": "提纳里",
            "text": "嗯。",
            "nextDialogs": [
              "130380317"
            ]
          },
          "130380317": {
            "id": "130380317",
            "speakerId": 1058,
            "speakerName": "赛诺",
            "text": "决定好了。",
            "nextDialogs": [
              "130380318"
            ]
          },
          "130380318": {
            "id": "130380318",
            "speakerId": 1085,
            "speakerName": "赛索斯",
            "text": "我们也决定好了，开始吧。"
          }
        }
      }
    },
    {

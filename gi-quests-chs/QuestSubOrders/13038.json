    {
      "subId": "1303808",
      "subQuestName": "准备第三回合",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "130380501"
        ],
        "dialogs": {
          "130380501": {
            "id": "130380501",
            "speakerId": 14003,
            "speakerName": "杜安雷",
            "text": "第二回合也结束了。第三回合的选手，请上前。",
            "nextDialogs": [
              "130380502"
            ]
          },
          "130380502": {
            "id": "130380502",
            "speakerId": 1058,
            "speakerName": "赛诺",
            "text": "我准备好了。",
            "nextDialogs": [
              "130380503"
            ]
          },
          "130380503": {
            "id": "130380503",
            "speakerId": 1085,
            "speakerName": "赛索斯",
            "text": "我也是。",
            "nextDialogs": [
              "130380504"
            ]
          },
          "130380504": {
            "id": "130380504",
            "speakerId": 14003,
            "speakerName": "杜安雷",
            "text": "这是本次仪式的最后一环，请记住你们双方开出的条件。",
            "nextDialogs": [
              "130380505"
            ]
          },
          "130380505": {
            "id": "130380505",
            "speakerId": 14003,
            "speakerName": "杜安雷",
            "text": "准备好的话，随时可以开始。",
            "nextDialogs": [
              "130380506"
            ]
          },
          "130380506": {
            "id": "130380506",
            "speakerId": 1085,
            "speakerName": "赛索斯",
            "text": "……",
            "nextDialogs": [
              "130380507"
            ]
          },
          "130380507": {
            "id": "130380507",
            "speakerId": 1085,
            "speakerName": "赛索斯",
            "text": "我是赫曼努比斯力量的适合者，现任缄默之殿首领巴穆恩之孙，赛索斯。",
            "nextDialogs": [
              "130380508"
            ]
          },
          "130380508": {
            "id": "130380508",
            "speakerId": 1085,
            "speakerName": "赛索斯",
            "text": "长久以来，我们缄默之殿谨遵赫曼努比斯大人的要求保守秘密，亦为求自保之力而于走投无路之时进行实验。",
            "nextDialogs": [
              "130380509"
            ]
          },
          "130380509": {
            "id": "130380509",
            "speakerId": 1085,
            "speakerName": "赛索斯",
            "text": "我们追随他的真知与力量，渴求他的灵魂与光明一同降下。",
            "nextDialogs": [
              "130380510"
            ]
          },
          "130380510": {
            "id": "130380510",
            "speakerId": 1085,
            "speakerName": "赛索斯",
            "text": "现在，我要为争夺这份力量而战！",
            "nextDialogs": [
              "130380511"
            ]
          },
          "130380511": {
            "id": "130380511",
            "speakerId": 1058,
            "speakerName": "赛诺",
            "text": "我是大风纪官赛诺，贤者居勒什的学生与继承者，为捍卫我的力量、我的老师与我的国家而战。",
            "nextDialogs": [
              "130380512"
            ]
          },
          "130380512": {
            "id": "130380512",
            "speakerId": 1058,
            "speakerName": "赛诺",
            "text": "你呢？还有没说出口的话吧。既然是崇高的决斗，就在赫曼努比斯眼前展露你的真心。",
            "nextDialogs": [
              "130380513"
            ]
          },
          "130380513": {
            "id": "130380513",
            "speakerId": 1085,
            "speakerName": "赛索斯",
            "text": "……",
            "nextDialogs": [
              "130380514"
            ]
          },
          "130380514": {
            "id": "130380514",
            "speakerId": 1085,
            "speakerName": "赛索斯",
            "text": "（所有人…不论男女老少，都在期待着这场战斗的结果。）",
            "nextDialogs": [
              "130380515"
            ]
          },
          "130380515": {
            "id": "130380515",
            "speakerId": 1085,
            "speakerName": "赛索斯",
            "text": "爷爷是贤明的领导者，也是背负了血腥之名的首领。我知道他怎么想，也知道他怎么期待我。",
            "nextDialogs": [
              "130380516"
            ]
          },
          "130380516": {
            "id": "130380516",
            "speakerId": 1085,
            "speakerName": "赛索斯",
            "text": "但我们已经被信仰束缚了很久，后来我去了一趟雨林，见到了城里的人。",
            "nextDialogs": [
              "130380517"
            ]
          },
          "130380517": {
            "id": "130380517",
            "speakerId": 1085,
            "speakerName": "赛索斯",
            "text": "时代变了，现在的须弥人似乎更快乐自由一些。我站在高处，俯瞰着脚下的街景。",
            "nextDialogs": [
              "130380518"
            ]
          },
          "130380518": {
            "id": "130380518",
            "speakerId": 1085,
            "speakerName": "赛索斯",
            "text": "然后我想到你。赛诺，你也拥有这份力量，却过着与我截然不同的人生。",
            "nextDialogs": [
              "130380519"
            ]
          },
          "130380519": {
            "id": "130380519",
            "speakerId": 1085,
            "speakerName": "赛索斯",
            "text": "赫曼努比斯的跋灵各有象征，威能、荣光…以及诸多未解之秘。",
            "nextDialogs": [
              "130380520"
            ]
          },
          "130380520": {
            "id": "130380520",
            "speakerId": 1085,
            "speakerName": "赛索斯",
            "text": "我想过，大概是因为我们获得的跋灵象征不同，才会有这种区别。又或者…你已经找到了我不曾拥有的答案。",
            "nextDialogs": [
              "130380521"
            ]
          },
          "130380521": {
            "id": "130380521",
            "speakerId": 1058,
            "speakerName": "赛诺",
            "text": "我不仅是一个战士，更是我自己。",
            "nextDialogs": [
              "130380522"
            ]
          },
          "130380522": {
            "id": "130380522",
            "speakerId": 1050,
            "speakerName": "提纳里",
            "text": "…对。",
            "nextDialogs": [
              "130380523"
            ]
          },
          "130380523": {
            "id": "130380523",
            "speakerId": 1085,
            "speakerName": "赛索斯",
            "text": "……",
            "nextDialogs": [
              "130380524"
            ]
          },
          "130380524": {
            "id": "130380524",
            "speakerId": 1085,
            "speakerName": "赛索斯",
            "text": "你我都是赫曼努比斯的容器，也不全是。他的名字影响了你我，改变了我们的人生。",
            "nextDialogs": [
              "130380525"
            ]
          },
          "130380525": {
            "id": "130380525",
            "speakerId": 1085,
            "speakerName": "赛索斯",
            "text": "如果是你，一定可以回答我的问题——在这份力量与信仰之外，我还能带来什么！",
            "nextDialogs": [
              "130380526"
            ]
          },
          "130380526": {
            "id": "130380526",
            "speakerId": 1085,
            "speakerName": "赛索斯",
            "text": "来吧！",
            "nextDialogs": [
              "130380527"
            ]
          },
          "130380527": {
            "id": "130380527",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "怎么样？感觉还好吧？",
            "nextDialogs": [
              "130380528"
            ]
          },
          "130380528": {
            "id": "130380528",
            "speakerId": 1058,
            "speakerName": "赛诺",
            "text": "……",
            "nextDialogs": [
              "130380529"
            ]
          },
          "130380529": {
            "id": "130380529",
            "speakerId": 1085,
            "speakerName": "赛索斯",
            "text": "……"
          }
        }
      }
    },
    {
      "subId": "1303851",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "130385101"
        ],
        "dialogs": {
          "130385101": {
            "id": "130385101",
            "speakerId": 1085,
            "speakerName": "赛索斯",
            "text": "我很期待这场暌违已久的决斗之仪。",
            "nextDialogs": [
              "130385102"
            ]
          },
          "130385102": {
            "id": "130385102",
            "speakerId": 1085,
            "speakerName": "赛索斯",
            "text": "不仅是为了跋灵，更是为了许多人。",
            "nextDialogs": [
              "130385103"
            ]
          },
          "130385103": {
            "id": "130385103",
            "speakerId": 1085,
            "speakerName": "赛索斯",
            "text": "…爷爷…"
          }
        }
      }
    },
    {
      "subId": "1303899",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "130389901"
        ],
        "dialogs": {
          "130389901": {
            "id": "130389901",
            "speakerId": 1085,
            "speakerName": "赛索斯",
            "text": "（…你一定要坚持下去，爷爷。）",
            "nextDialogs": [
              "130389902"
            ]
          },
          "130389902": {
            "id": "130389902",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "别急，安全至上。",
            "nextDialogs": [
              "130389903"
            ]
          },
          "130389903": {
            "id": "130389903",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "#啊那边那个讨厌鬼，敢打到{M#他}{F#她}我就跟你拼了！",
            "nextDialogs": [
              "130389904"
            ]
          },
          "130389904": {
            "id": "130389904",
            "speakerId": 1085,
            "speakerName": "赛索斯",
            "text": "那边的观众席有点吵闹了哦。",
            "nextDialogs": [
              "130389905"
            ]
          },
          "130389905": {
            "id": "130389905",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "你别管嘛！",
            "nextDialogs": [
              "130389906"
            ]
          },
          "130389906": {
            "id": "130389906",
            "speakerId": 1058,
            "speakerName": "赛诺",
            "text": "小心，注意闪避！",
            "nextDialogs": [
              "130389907"
            ]
          },
          "130389907": {
            "id": "130389907",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "提纳里加油啊！！",
            "nextDialogs": [
              "130389908"
            ]
          },
          "130389908": {
            "id": "130389908",
            "speakerId": 1058,
            "speakerName": "赛诺",
            "text": "赛前补充了水分，应该没问题吧。"
          }
        }
      }
    }
  ]
}
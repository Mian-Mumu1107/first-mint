    {
      "subId": "7906703",
      "subQuestName": "在「幽谈窟」中前进",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [],
        "dialogs": {}
      }
    },
    {
      "subId": "7906706",
      "subQuestName": "尝试解开「幽谈窟」中的「试炼」",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "790670601"
        ],
        "dialogs": {
          "790670601": {
            "id": "790670601",
            "speakerId": 1002,
            "speakerName": "福罗贝尔",
            "text": "嗷…我的腿，它踩在地面上吗？我都要感觉不到它了。",
            "nextDialogs": [
              "790670604"
            ]
          },
          "790670604": {
            "id": "790670604",
            "speakerId": 1000,
            "speakerName": "西梅",
            "text": "…之前那些公主，看来也都离开了。希望她们真正从那个「幽谈窟」中离开了。",
            "nextDialogs": [
              "790670605"
            ]
          },
          "790670605": {
            "id": "790670605",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "嘿嘿，这一趟「幽谈窟」之旅也不算白跑，圣物亮起来了，公主殿下的王国也有救了呢。",
            "nextDialogs": [
              "790670606"
            ]
          },
          "790670606": {
            "id": "790670606",
            "speakerId": 1000,
            "speakerName": "西梅",
            "text": "嗯。圣物亮起，就意味着它已经找到了值得被认可的「守护者」。",
            "nextDialogs": [
              "790670607"
            ]
          },
          "790670607": {
            "id": "790670607",
            "speakerId": 1000,
            "speakerName": "西梅",
            "text": "圣物所要寻找的「守护者」，并非是寻常意义上的勇猛之士。",
            "nextDialogs": [
              "790670608"
            ]
          },
          "790670608": {
            "id": "790670608",
            "speakerId": 1000,
            "speakerName": "西梅",
            "text": "真正的值得认可的「守护者」，是始终守护着自己的「内心」，不断往前迈进的无畏之人。",
            "nextDialogs": [
              "790670609"
            ]
          },
          "790670609": {
            "id": "790670609",
            "speakerId": 1000,
            "speakerName": "西梅",
            "text": "这枚圣物一直是答案，但我们却始终把它当做问题。",
            "nextDialogs": [
              "790670610"
            ]
          },
          "790670610": {
            "id": "790670610",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "洞窟里的那些稿件，一直在等待。",
            "nextDialogs": [
              "790670611"
            ]
          },
          "790670611": {
            "id": "790670611",
            "speakerId": 1000,
            "speakerName": "西梅",
            "text": "他们在等待着属于自己的「路途」出现…一直等待到了如今。",
            "nextDialogs": [
              "790670612"
            ]
          },
          "790670612": {
            "id": "790670612",
            "speakerId": 1000,
            "speakerName": "西梅",
            "text": "但是，等待只会带来等待。呵呵，没人能从问题本身里找到能解决这个问题的答案。",
            "nextDialogs": [
              "790670613"
            ]
          },
          "790670613": {
            "id": "790670613",
            "speakerId": 1000,
            "speakerName": "西梅",
            "text": "就像…如果你想要摘一片树叶，你就不能待在那片树叶上。",
            "nextDialogs": [
              "790670614"
            ]
          },
          "790670614": {
            "id": "790670614",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "唔…脑袋晕晕的，好复杂…",
            "nextDialogs": [
              "790670615"
            ]
          },
          "790670615": {
            "id": "790670615",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "总之，他们都不是圣物愿意认可的「守护者」，公主殿下和福罗贝尔先生才是！",
            "nextDialogs": [
              "790670616"
            ]
          },
          "790670616": {
            "id": "790670616",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "现在圣物也亮起来，「守护者」也找到了，问题是不是都解决了呀，公主殿下？",
            "nextDialogs": [
              "790670617"
            ]
          },
          "790670617": {
            "id": "790670617",
            "speakerId": 1000,
            "speakerName": "西梅",
            "text": "唔，可以这么说吧。但我也没想到，圣物会这么亮起…又得劳烦萨博兰和苏法什去图书馆研究了。",
            "nextDialogs": [
              "790670618"
            ]
          },
          "790670618": {
            "id": "790670618",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "对了，既然现在「守护者」已经选拔出来了，那…圣物前面的那些试炼，是不是也没有意义了？"
          }
        }
      }
    },
    {
      "subId": "7906717",
      "subQuestName": "尝试解开「幽谈窟」中的「试炼」",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "790671201"
        ],
        "dialogs": {
          "790671201": {
            "id": "790671201",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "好欸！这就算是通过一段试炼了吧，嘿嘿，还挺顺利的嘛。",
            "nextDialogs": [
              "790671204"
            ]
          },
          "790671204": {
            "id": "790671204",
            "speakerId": 1002,
            "speakerName": "福罗贝尔",
            "text": "您的身手可真好，唉，要是我也能有您这样的天赋就好了。",
            "nextDialogs": [
              "790671205"
            ]
          },
          "790671205": {
            "id": "790671205",
            "speakerId": 1002,
            "speakerName": "福罗贝尔",
            "text": "咦？我好像听见了什么动静…",
            "nextDialogs": [
              "790671206"
            ]
          },
          "790671206": {
            "id": "790671206",
            "speakerId": 1003,
            "speakerName": "？？？",
            "text": "「故事循规蹈矩，往复来回，但每一篇都应当有自己的路途。」",
            "nextDialogs": [
              "790671207"
            ]
          },
          "790671207": {
            "id": "790671207",
            "speakerId": 1003,
            "speakerName": "？？？",
            "text": "「…很久很久以前，有一只想要拥有一双翅膀的纸蛙。」",
            "nextDialogs": [
              "790671208"
            ]
          },
          "790671208": {
            "id": "790671208",
            "speakerId": 1003,
            "speakerName": "？？？",
            "text": "「他向女神祈祷，女神告诉他，只要你跳得比所有纸蛙都高，就能够拥有一对翅膀…」",
            "nextDialogs": [
              "790671209"
            ]
          },
          "790671209": {
            "id": "790671209",
            "speakerId": 1003,
            "speakerName": "？？？",
            "text": "「在很久之前，有一位公主殿下，在王国中亲手设下试炼…」",
            "nextDialogs": [
              "790671210"
            ]
          },
          "790671210": {
            "id": "790671210",
            "speakerId": 1003,
            "speakerName": "？？？",
            "text": "「她等待良久。守护者啊，你究竟在何处…」",
            "nextDialogs": [
              "790671211"
            ]
          },
          "790671211": {
            "id": "790671211",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "呜哇！稿纸说话了！"
          }
        }
      }
    },
    {
      "subId": "7906718",
      "subQuestName": "尝试解开「幽谈窟」中的「试炼」",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [],
        "dialogs": {}
      }
    },
    {
      "subId": "7906707",
      "subQuestName": "尝试解开「幽谈窟」中的「试炼」",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "790670501"
        ],
        "dialogs": {
          "790670501": {
            "id": "790670501",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "这样子，我们应该就算是通过所有试炼了吧？",
            "nextDialogs": [
              "790670541"
            ]
          },
          "790670541": {
            "id": "790670541",
            "speakerId": 1000,
            "speakerName": "西梅",
            "text": "…我拿过来的圣物，也没什么反应。",
            "nextDialogs": [
              "790670504"
            ]
          },
          "790670504": {
            "id": "790670504",
            "speakerId": 1002,
            "speakerName": "福罗贝尔",
            "text": "难道我们真要在这里一直等着？但…但我们到底要等什么？",
            "nextDialogs": [
              "790670505"
            ]
          },
          "790670505": {
            "id": "790670505",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "总不能等着有哪位神明大人，突然给我们启示吧…",
            "nextDialogs": [
              "790670506"
            ]
          },
          "790670506": {
            "id": "790670506",
            "speakerId": 1004,
            "speakerName": "疲惫的手稿",
            "text": "我们愿做的。只有等待，我们能做的，只有等待。",
            "nextDialogs": [
              "790670507"
            ]
          },
          "790670507": {
            "id": "790670507",
            "speakerId": 1005,
            "speakerName": "陈旧的手稿",
            "text": "等待是意义，未来是未知。",
            "nextDialogs": [
              "790670508"
            ]
          },
          "790670508": {
            "id": "790670508",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "它们什么时候出现的？而且还一个劲地要我们等着…到底要我们等着什么啦！",
            "nextDialogs": [
              "790670509"
            ]
          },
          "790670509": {
            "id": "790670509",
            "speakerId": 1000,
            "speakerName": "西梅",
            "text": "或许，它们也不知道。所以…"
          }
        }
      }
    },

    },
    {
      "subId": "7906707",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "790670701"
        ],
        "dialogs": {
          "790670701": {
            "id": "790670701",
            "speakerId": 1006,
            "speakerName": "萨博兰",
            "text": "尊敬的守护者，您有什么事吗？",
            "nextDialogs": [
              "790670702"
            ]
          },
          "790670702": {
            "id": "790670702",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "关于那些没有完成使命的王国…",
            "nextDialogs": [
              "790670703"
            ]
          },
          "790670703": {
            "id": "790670703",
            "speakerId": 1007,
            "speakerName": "苏法什",
            "text": "您…好吧。既然您是公主亲自认可的「铃风卫士」，那这些事也理应告诉您。",
            "nextDialogs": [
              "790670704"
            ]
          },
          "790670704": {
            "id": "790670704",
            "speakerId": 1007,
            "speakerName": "苏法什",
            "text": "在我们这一代铃风王国之前，这片大地上还曾经存在过许多王国。",
            "nextDialogs": [
              "790670705"
            ]
          },
          "790670705": {
            "id": "790670705",
            "speakerId": 1007,
            "speakerName": "苏法什",
            "text": "和我们一样，他们的「使命」就是寻找到能够被圣物认可的「王国守护者」。",
            "nextDialogs": [
              "790670706"
            ]
          },
          "790670706": {
            "id": "790670706",
            "speakerId": 1006,
            "speakerName": "萨博兰",
            "text": "但是，这些王国都为了实现「使命」建立，又在追寻「使命」的过程中消逝。",
            "nextDialogs": [
              "790670707"
            ]
          },
          "790670707": {
            "id": "790670707",
            "speakerId": 1006,
            "speakerName": "萨博兰",
            "text": "没有任何一代，寻找到过那位可以拯救整个王国的「王国守护者」。",
            "nextDialogs": [
              "790670708"
            ]
          },
          "790670708": {
            "id": "790670708",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "消逝？",
            "nextDialogs": [
              "790670709"
            ]
          },
          "790670709": {
            "id": "790670709",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "难道…不能完成「使命」的话，就会发生不好的事情？",
            "nextDialogs": [
              "790670710"
            ]
          },
          "790670710": {
            "id": "790670710",
            "speakerId": 1006,
            "speakerName": "萨博兰",
            "text": "是的。有些王国的所有臣民突然失去了声音，有些王国的所有水源一夜干涸…",
            "nextDialogs": [
              "790670711"
            ]
          },
          "790670711": {
            "id": "790670711",
            "speakerId": 1006,
            "speakerName": "萨博兰",
            "text": "这些失去了「未来」的王国，最终都走向了消逝。",
            "nextDialogs": [
              "790670712"
            ]
          },
          "790670712": {
            "id": "790670712",
            "speakerId": 1007,
            "speakerName": "苏法什",
            "text": "如果我们不能完成「使命」，这也…将是我们的结局。",
            "nextDialogs": [
              "790670713"
            ]
          },
          "790670713": {
            "id": "790670713",
            "speakerId": 1007,
            "speakerName": "苏法什",
            "text": "…无论如何，都祝您好运。卫士阁下。"
          }
        }
      }
    },
    {
      "subId": "7906711",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "790671101"
        ],
        "dialogs": {
          "790671101": {
            "id": "790671101",
            "speakerId": 1008,
            "speakerName": "奥雷卢",
            "text": "喔！很高兴见到您，哈哈哈，看来您很受欢迎啊，就连西梅公主殿下也知道您。",
            "nextDialogs": [
              "790671103",
              "790671117",
              "790671120"
            ]
          },
          "790671103": {
            "id": "790671103",
            "speakerId": 1008,
            "speakerName": "奥雷卢",
            "text": "噢…您要谈这么沉重的话题。好吧…既然您这么问起，那我就得回答了。",
            "nextDialogs": [
              "790671104"
            ]
          },
          "790671104": {
            "id": "790671104",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "唔，可是…感觉雨歌塘一切正常呀。大家都在开开心心地办比赛，跳来跳去。",
            "nextDialogs": [
              "790671105"
            ]
          },
          "790671105": {
            "id": "790671105",
            "speakerId": 1008,
            "speakerName": "奥雷卢",
            "text": "从这一方面来说，的确如此。雨歌塘的水从未干涸，比赛也从未间断。",
            "nextDialogs": [
              "790671106"
            ]
          },
          "790671106": {
            "id": "790671106",
            "speakerId": 1008,
            "speakerName": "奥雷卢",
            "text": "每一届组委会，每一位纸蛙，都在为了迎接那位公主而努力锻炼，拼搏不止。",
            "nextDialogs": [
              "790671107"
            ]
          },
          "790671107": {
            "id": "790671107",
            "speakerId": 1008,
            "speakerName": "奥雷卢",
            "text": "但…那些拼搏着的纸蛙，就是我们雨歌塘所付出的「代价」。",
            "nextDialogs": [
              "790671108"
            ]
          },
          "790671108": {
            "id": "790671108",
            "speakerId": 1008,
            "speakerName": "奥雷卢",
            "text": "从诞生起，我们的「使命」即是锻炼跳跃，迎接公主…整个雨歌塘的一切事务，也是为此而生。",
            "nextDialogs": [
              "790671109"
            ]
          },
          "790671109": {
            "id": "790671109",
            "speakerId": 1008,
            "speakerName": "奥雷卢",
            "text": "雨歌塘的组委会已经换了无数纸蛙。我们也选出了无数冠军…但迄今为止，我们却始终找不到那位需要迎接的公主。",
            "nextDialogs": [
              "790671110"
            ]
          },
          "790671110": {
            "id": "790671110",
            "speakerId": 1008,
            "speakerName": "奥雷卢",
            "text": "一代又一代的冠军只能无奈老去，他们怀抱着「使命」，却不知道如何履行。",
            "nextDialogs": [
              "790671111"
            ]
          },
          "790671111": {
            "id": "790671111",
            "speakerId": 1008,
            "speakerName": "奥雷卢",
            "text": "只能眼睁睁地看着健壮的后腿变得无力，优美的脚蹼逐渐蜷缩。",
            "nextDialogs": [
              "790671112"
            ]
          },
          "790671112": {
            "id": "790671112",
            "speakerId": 1008,
            "speakerName": "奥雷卢",
            "text": "哈…最无奈的是，无论如何冠军都会老去，为了迎接公主，我们必须时刻准备好最强的纸蛙。",
            "nextDialogs": [
              "790671113"
            ]
          },
          "790671113": {
            "id": "790671113",
            "speakerId": 1008,
            "speakerName": "奥雷卢",
            "text": "于是雨歌塘的比赛不断举办。只是再也没蛙记得那些曾经怀抱使命，却不得不无奈老去的冠军们。",
            "nextDialogs": [
              "790671114"
            ]
          },
          "790671114": {
            "id": "790671114",
            "speakerId": 1008,
            "speakerName": "奥雷卢",
            "text": "借用西梅公主的话来说，奋勇者空有壮志，却只能无奈故去。这比王国的没落更加残酷。",
            "nextDialogs": [
              "790671115"
            ]
          },
          "790671115": {
            "id": "790671115",
            "speakerId": 1008,
            "speakerName": "奥雷卢",
            "text": "好啦！二位，现在的气氛实在有些沉重，就让我们信任福罗贝尔和西梅公主殿下吧。他们一定能搞定这个问题。"
          },
          "790671117": {
            "id": "790671117",
            "speakerId": 1008,
            "speakerName": "奥雷卢",
            "text": "他？那位好先生说要去周围散散心，现在也许正忙着跳水呢。",
            "nextDialogs": [
              "790671118"
            ]
          },
          "790671118": {
            "id": "790671118",
            "speakerId": 1008,
            "speakerName": "奥雷卢",
            "text": "唉，要是埃斯唐普能把他的轻松心态分给福罗贝尔一些就好了。哪怕五分之一呢…"
          },
          "790671120": {
            "id": "790671120",
            "speakerId": 1008,
            "speakerName": "奥雷卢",
            "text": "行。请您照顾好自己，我会在这里等着各位回来的。"
          }
        }
      }
    },

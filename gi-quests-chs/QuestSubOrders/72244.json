    {
      "subId": "7224411",
      "subQuestName": "到达引魂之地",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "722441101"
        ],
        "dialogs": {
          "722441101": {
            "id": "722441101",
            "speakerId": 1002,
            "speakerName": "派蒙",
            "text": "#一二三……唔，{NICKNAME}，好像已经完成七座墓石的凭吊了！",
            "nextDialogs": [
              "722441102"
            ]
          },
          "722441102": {
            "id": "722441102",
            "speakerId": 1002,
            "speakerName": "派蒙",
            "text": "我们回到石头神龛那边，告诉等待在石龛边上的那个残魂吧。"
          }
        }
      }
    },
    {
      "subId": "7224412",
      "subQuestName": "",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "722441201"
        ],
        "dialogs": {
          "722441201": {
            "id": "722441201",
            "speakerId": 1001,
            "speakerName": "久利由卖",
            "text": "啊啊…比螺梦门，你喜欢读书，常言有天外之地，那时妾身并不相信…",
            "nextDialogs": [
              "722441202"
            ]
          },
          "722441202": {
            "id": "722441202",
            "speakerId": 1001,
            "speakerName": "久利由卖",
            "text": "对你的绮言狂想，每每都只是笑着摇头。妾身该相信你的呀，该相信你的呀！",
            "nextDialogs": [
              "722441203"
            ]
          },
          "722441203": {
            "id": "722441203",
            "speakerId": 1001,
            "speakerName": "久利由卖",
            "text": "你说，如有机会，一定要逃出大日御舆，去天外之地冒险…",
            "nextDialogs": [
              "722441204"
            ]
          },
          "722441204": {
            "id": "722441204",
            "speakerId": 1001,
            "speakerName": "久利由卖",
            "text": "比螺梦门，现在已不再有人会束缚你了，去吧，去吧！",
            "nextDialogs": [
              "722441205"
            ]
          },
          "722441205": {
            "id": "722441205",
            "speakerId": 1001,
            "speakerName": "久利由卖",
            "text": "还有，御琉部栖，御琉部栖，妾身好想再听你歌上一曲啊。",
            "nextDialogs": [
              "722441206"
            ]
          },
          "722441206": {
            "id": "722441206",
            "speakerId": 1001,
            "speakerName": "久利由卖",
            "text": "听到你唱歌，听到你那样纯净清澈的歌喉，有谁不悄悄在内心里跟你一起唱呢？",
            "nextDialogs": [
              "722441207"
            ]
          },
          "722441207": {
            "id": "722441207",
            "speakerId": 1001,
            "speakerName": "久利由卖",
            "text": "归日之祭前夜，你突然想听妾身的声音，无论如何都想让妾身开口唱给你听。",
            "nextDialogs": [
              "722441208"
            ]
          },
          "722441208": {
            "id": "722441208",
            "speakerId": 1001,
            "speakerName": "久利由卖",
            "text": "说没有关系，不管唱多难听，你都不会笑的。",
            "nextDialogs": [
              "722441209"
            ]
          },
          "722441209": {
            "id": "722441209",
            "speakerId": 1001,
            "speakerName": "久利由卖",
            "text": "你那个时候是不是已经知道…已经知道归日之祭其实正是自己的终期？",
            "nextDialogs": [
              "722441210"
            ]
          },
          "722441210": {
            "id": "722441210",
            "speakerId": 1001,
            "speakerName": "久利由卖",
            "text": "呜…可是妾身到最后也…",
            "nextDialogs": [
              "722441211"
            ]
          },
          "722441211": {
            "id": "722441211",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "久利由卖？",
            "nextDialogs": [
              "722441212"
            ]
          },
          "722441212": {
            "id": "722441212",
            "speakerId": 1001,
            "speakerName": "久利由卖",
            "text": "啊啊，不好意思，旅者，妾身失态了。",
            "nextDialogs": [
              "722441213"
            ]
          },
          "722441213": {
            "id": "722441213",
            "speakerId": 1001,
            "speakerName": "久利由卖",
            "text": "侍奉太阳之子的女官，为保自身的洁净无瑕…终生不可嫁予他人。",
            "nextDialogs": [
              "722441214"
            ]
          },
          "722441214": {
            "id": "722441214",
            "speakerId": 1001,
            "speakerName": "久利由卖",
            "text": "所以妾身一生都没有自己的孩子。",
            "nextDialogs": [
              "722441215"
            ]
          },
          "722441215": {
            "id": "722441215",
            "speakerId": 1001,
            "speakerName": "久利由卖",
            "text": "这些孩子，这些由妾身侍奉，看着长大的孩子，不知何时已变得比血脉还要亲近。",
            "nextDialogs": [
              "722441216"
            ]
          },
          "722441216": {
            "id": "722441216",
            "speakerId": 1001,
            "speakerName": "久利由卖",
            "text": "多谢你，旅者，多谢你找回了御辔。",
            "nextDialogs": [
              "722441217"
            ]
          },
          "722441217": {
            "id": "722441217",
            "speakerId": 1001,
            "speakerName": "久利由卖",
            "text": "这御辔经由每位太阳之子之手，其上承载的记忆足以补全残缺魂魄。",
            "nextDialogs": [
              "722441218"
            ]
          },
          "722441218": {
            "id": "722441218",
            "speakerId": 1001,
            "speakerName": "久利由卖",
            "text": "即使，这些记忆也是双面的。",
            "nextDialogs": [
              "722441221"
            ]
          },
          "722441221": {
            "id": "722441221",
            "speakerId": 1001,
            "speakerName": "久利由卖",
            "text": "自然，记忆分为两类，一类是自身之记忆，一类是他人对自身的记忆。",
            "nextDialogs": [
              "722441222"
            ]
          },
          "722441222": {
            "id": "722441222",
            "speakerId": 1001,
            "speakerName": "久利由卖",
            "text": "补全他们存在的，既有御辔之上，太阳之子自身的记忆…",
            "nextDialogs": [
              "722441223"
            ]
          },
          "722441223": {
            "id": "722441223",
            "speakerId": 1001,
            "speakerName": "久利由卖",
            "text": "也有御辔作为被白夜国怪罪的孩童们的象征，承载的身为罪孽之子的记忆。",
            "nextDialogs": [
              "722441224"
            ]
          },
          "722441224": {
            "id": "722441224",
            "speakerId": 1001,
            "speakerName": "久利由卖",
            "text": "妾身的记忆，并不足以补全他们的魂魄，便只能靠白夜之国诸民的记忆了。",
            "nextDialogs": [
              "722441225"
            ]
          },
          "722441225": {
            "id": "722441225",
            "speakerId": 1001,
            "speakerName": "久利由卖",
            "text": "这些孩童们，应这些归咎于他们身上的罪孽，才重新被白夜国记起，留下残影。",
            "nextDialogs": [
              "722441226"
            ]
          },
          "722441226": {
            "id": "722441226",
            "speakerId": 1001,
            "speakerName": "久利由卖",
            "text": "多谢你了，旅者…妾身大愿已了。",
            "nextDialogs": [
              "722441227"
            ]
          },
          "722441227": {
            "id": "722441227",
            "speakerId": 1001,
            "speakerName": "久利由卖",
            "text": "也终于能…稍微…安心一下了。",
            "nextDialogs": [
              "722441228"
            ]
          },
          "722441228": {
            "id": "722441228",
            "speakerId": 1001,
            "speakerName": "久利由卖",
            "text": "终于能…再和那些孩子们一起…"
          }
        }
      }
    },

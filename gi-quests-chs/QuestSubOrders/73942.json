        "dialogs": {
          "739420101": {
            "id": "739420101",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "眼见未必为实…",
            "nextDialogs": [
              "739420102"
            ]
          },
          "739420102": {
            "id": "739420102",
            "speakerId": 1000,
            "speakerName": "阿什克",
            "text": "的确，人的目光实在太容易被转移，也太容易被蒙蔽了。",
            "nextDialogs": [
              "739420103"
            ]
          },
          "739420103": {
            "id": "739420103",
            "speakerId": 1000,
            "speakerName": "阿什克",
            "text": "如果我是风纪官的话，那我可能会告诉你，无知也是一种庇佑。",
            "nextDialogs": [
              "739420104"
            ]
          },
          "739420104": {
            "id": "739420104",
            "speakerId": 1000,
            "speakerName": "阿什克",
            "text": "但人的无知，并不会影响真实之理的存在。盲目地遮蔽双眼…",
            "nextDialogs": [
              "739420105"
            ]
          },
          "739420105": {
            "id": "739420105",
            "speakerId": 1000,
            "speakerName": "阿什克",
            "text": "哎呀，我好像说得太多了。你就当是一阵风，吹过就散了吧。"
          }
        }
      }
    }
  ]

  "subQuests": [
    {
      "subId": "7166601",
      "subQuestName": "前往万民堂",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "716660101"
        ],
        "dialogs": {
          "716660101": {
            "id": "716660101",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "咦？火锅摊那边的人…好眼熟！",
            "nextDialogs": [
              "716660102"
            ]
          },
          "716660102": {
            "id": "716660102",
            "speakerId": 1049,
            "speakerName": "久岐忍",
            "text": "……",
            "nextDialogs": [
              "716660103"
            ]
          },
          "716660103": {
            "id": "716660103",
            "speakerId": 1030,
            "speakerName": "烟绯",
            "text": "#{NICKNAME}和派蒙？你们也来了？",
            "nextDialogs": [
              "716660104"
            ]
          },
          "716660104": {
            "id": "716660104",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "烟绯和阿忍？你们两个都在！怎么还坐在这里…吃火锅？",
            "nextDialogs": [
              "716660107"
            ]
          },
          "716660107": {
            "id": "716660107",
            "speakerId": 1030,
            "speakerName": "烟绯",
            "text": "不是啦不是啦，万民堂这两天要暂时停业！",
            "nextDialogs": [
              "716660108"
            ]
          },
          "716660108": {
            "id": "716660108",
            "speakerId": 1030,
            "speakerName": "烟绯",
            "text": "而且，苏二娘的火锅，和万民堂的饭菜，是两种不同的口味嘛，换着吃也很不错。",
            "nextDialogs": [
              "716660109"
            ]
          },
          "716660109": {
            "id": "716660109",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "停业？万民堂为什么突然停业了？",
            "nextDialogs": [
              "716660110"
            ]
          },
          "716660110": {
            "id": "716660110",
            "speakerId": 1049,
            "speakerName": "久岐忍",
            "text": "说来也有我们的责任…",
            "nextDialogs": [
              "716660111"
            ]
          },
          "716660111": {
            "id": "716660111",
            "speakerId": 1049,
            "speakerName": "久岐忍",
            "text": "最近，同文学塾的同学举办了一场聚会，邀请我一起来玩。",
            "nextDialogs": [
              "716660112"
            ]
          },
          "716660112": {
            "id": "716660112",
            "speakerId": 1049,
            "speakerName": "久岐忍",
            "text": "按资历，烟绯师姐是我们的大前辈，所以聚餐的地点，就由烟绯师姐来安排了。",
            "nextDialogs": [
              "716660113"
            ]
          },
          "716660113": {
            "id": "716660113",
            "speakerId": 1049,
            "speakerName": "久岐忍",
            "text": "没想到，我们人太多，老大的胃口又特别好，吃得有点过火…两天就把万民堂一个礼拜的储备食材都消耗完了。",
            "nextDialogs": [
              "716660114"
            ]
          },
          "716660114": {
            "id": "716660114",
            "speakerId": 1030,
            "speakerName": "烟绯",
            "text": "卯师傅累虽累，倒是笑开了花，这可能是他半年来最大的一单生意了。",
            "nextDialogs": [
              "716660115"
            ]
          },
          "716660115": {
            "id": "716660115",
            "speakerId": 1030,
            "speakerName": "烟绯",
            "text": "就是补充食材，可就不止要忙一两天啦。"
          }
        }
      }
    },
    {
      "subId": "7166602",
      "subQuestName": "前往孤云阁寻找香菱等人",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "716660201"
        ],
        "dialogs": {
          "716660201": {
            "id": "716660201",
            "speakerId": 1044,
            "speakerName": "荒泷一斗",
            "text": "我明白了！",
            "nextDialogs": [
              "716660202"
            ]
          },
          "716660202": {
            "id": "716660202",
            "speakerId": 1044,
            "speakerName": "荒泷一斗",
            "text": "螃蟹有坚硬的甲壳，有很多腿，看起来战斗力很强，和鬼兜虫也差不多嘛！肯定能成为鬼兜虫的劲敌！",
            "nextDialogs": [
              "716660203"
            ]
          },
          "716660203": {
            "id": "716660203",
            "speakerId": 13019,
            "speakerName": "「花角玉将」",
            "text": "没错，鬼王！不管螃蟹理论上属于什么谱系，和这种对手交锋，一定能让鬼兜虫的力量飞速进步！",
            "nextDialogs": [
              "716660204"
            ]
          },
          "716660204": {
            "id": "716660204",
            "speakerId": 1012,
            "speakerName": "香菱",
            "text": "那你们可要让「赤红一杵」和「金刚身怒面虫王」多出点力哦，争取斗翻附近的所有螃蟹！",
            "nextDialogs": [
              "716660205"
            ]
          },
          "716660205": {
            "id": "716660205",
            "speakerId": 1012,
            "speakerName": "香菱",
            "text": "到时候，我们就只用弯腰捡螃蟹了，不用追着它们到处跑！",
            "nextDialogs": [
              "716660206"
            ]
          },
          "716660206": {
            "id": "716660206",
            "speakerId": 1043,
            "speakerName": "锅巴",
            "text": "♪♫♩♪♬~",
            "nextDialogs": [
              "716660207"
            ]
          },
          "716660207": {
            "id": "716660207",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "看样子，他们完全打成一片了…",
            "nextDialogs": [
              "716660210"
            ]
          },
          "716660210": {
            "id": "716660210",
            "speakerId": 1012,
            "speakerName": "香菱",
            "text": "#啊呀？是{NICKNAME}和派蒙！你们这是来孤云阁散心吗？",
            "nextDialogs": [
              "716660211"
            ]
          },
          "716660211": {
            "id": "716660211",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "香菱，锅巴，你们好呀！",
            "nextDialogs": [
              "716660212"
            ]
          },
          "716660212": {
            "id": "716660212",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "我们本来想到万民堂解解馋，结果从烟绯和阿忍那里听说了你们暂时停业的事，就想过来看看，能不能帮上什么忙…",
            "nextDialogs": [
              "716660213"
            ]
          },
          "716660213": {
            "id": "716660213",
            "speakerId": 1012,
            "speakerName": "香菱",
            "text": "嘿嘿！感谢捧场，感谢你们热心相助！",
            "nextDialogs": [
              "716660214"
            ]
          },
          "716660214": {
            "id": "716660214",
            "speakerId": 1012,
            "speakerName": "香菱",
            "text": "这两天，有一斗先生和玉将两位帮手在，食材已经补充得差不多了，只差这些最新鲜的螃蟹。",
            "nextDialogs": [
              "716660215"
            ]
          },
          "716660215": {
            "id": "716660215",
            "speakerId": 1012,
            "speakerName": "香菱",
            "text": "不出意外的话，有「赤红一杵」和「金刚身怒面虫王」帮忙，两三下就能搞定！",
            "nextDialogs": [
              "716660216"
            ]
          },
          "716660216": {
            "id": "716660216",
            "speakerId": 1012,
            "speakerName": "香菱",
            "text": "不出意外…",
            "nextDialogs": [
              "716660217"
            ]
          },
          "716660217": {
            "id": "716660217",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "是幼岩龙蜥！小心啊，放牛的，还有花角玉将！",
            "nextDialogs": [
              "716660218"
            ]
          },
          "716660218": {
            "id": "716660218",
            "speakerId": 1044,
            "speakerName": "荒泷一斗",
            "text": "且慢，有本大爷在，不必惊慌！",
            "nextDialogs": [
              "716660219"
            ]
          },
          "716660219": {
            "id": "716660219",
            "speakerId": 1044,
            "speakerName": "荒泷一斗",
            "text": "这个大家伙也有坚硬的甲壳，虽然没有很多腿，但会滚来滚去，看起来战斗力特别强，也可以来当鬼兜虫的对手！",
            "nextDialogs": [
              "716660220"
            ]
          },
          "716660220": {
            "id": "716660220",
            "speakerId": 13019,
            "speakerName": "「花角玉将」",
            "text": "呃咳咳…所，所言极是，鬼王！和这种对手交锋，想必能让鬼兜虫的力量达到极致！",
            "nextDialogs": [
              "716660221"
            ]
          },
          "716660221": {
            "id": "716660221",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "欸？他们两个是认真的吗？",
            "nextDialogs": [
              "716660222"
            ]
          },
          "716660222": {
            "id": "716660222",
            "speakerId": 1012,
            "speakerName": "香菱",
            "text": "我对那条幼岩龙蜥有印象！",
            "nextDialogs": [
              "716660223"
            ]
          },
          "716660223": {
            "id": "716660223",
            "speakerId": 1012,
            "speakerName": "香菱",
            "text": "它总是在附近的一座小岛上打转，有人叫它「水晶岛梆梆旋风」，算是孤云阁的有名龙…蜥！"
          }
        }
      }
    },
    {
      "subId": "7166603",
      "subQuestName": "返回万民堂",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "716660301"
        ],
        "dialogs": {
          "716660301": {
            "id": "716660301",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "烟绯，阿忍，我们回来啦！",
            "nextDialogs": [
              "716660302"
            ]
          },
          "716660302": {
            "id": "716660302",
            "speakerId": 1030,
            "speakerName": "烟绯",
            "text": "#锅巴，香菱，{NICKNAME}和派蒙…咦？怎么少了两个人？",
            "nextDialogs": [
              "716660303"
            ]
          },
          "716660303": {
            "id": "716660303",
            "speakerId": 1049,
            "speakerName": "久岐忍",
            "text": "老大和玉将…该不会又在瞎折腾了吧？",
            "nextDialogs": [
              "716660304"
            ]
          },
          "716660304": {
            "id": "716660304",
            "speakerId": 1012,
            "speakerName": "香菱",
            "text": "待会儿再说这个！保存螃蟹的冰雾花花朵快要撑不住了，我们先处理上好的食材！",
            "nextDialogs": [
              "716660305"
            ]
          },
          "716660305": {
            "id": "716660305",
            "speakerId": 1012,
            "speakerName": "香菱",
            "text": "#{NICKNAME}和派蒙是客人，还盼着开开心心吃上一顿大餐呢，我这就下厨，我们边吃边聊…",
            "nextDialogs": [
              "716660306"
            ]
          },
          "716660306": {
            "id": "716660306",
            "speakerId": 1007,
            "speakerName": "Black Screen",
            "text": "香菱和锅巴麻利地取出一路上采获的食材，稍作准备就开始了烹饪…不多时，几道上好的菜肴就被端了上来。",
            "nextDialogs": [
              "716660307"
            ]
          },
          "716660307": {
            "id": "716660307",
            "speakerId": 1007,
            "speakerName": "Black Screen",
            "text": "经过漫长的等待，烟绯和久岐忍也都饿了，大家好好享用了香菱制作的大餐。",
            "nextDialogs": [
              "716660308"
            ]
          },
          "716660308": {
            "id": "716660308",
            "speakerId": 1007,
            "speakerName": "Black Screen",
            "text": "在此期间，你们向烟绯和久岐忍讲述了荒泷一斗、「花角玉将」和「水晶岛梆梆旋风」之间的较量，以及「荒泷甲光烈烈斗虫大修行」的计划…",
            "nextDialogs": [
              "716660309"
            ]
          },
          "716660309": {
            "id": "716660309",
            "speakerId": 1049,
            "speakerName": "久岐忍",
            "text": "「荒泷甲光烈烈斗虫大修行」？他们又开始闹腾了…",
            "nextDialogs": [
              "716660310"
            ]
          },
          "716660310": {
            "id": "716660310",
            "speakerId": 1049,
            "speakerName": "久岐忍",
            "text": "这次我们是客人，怎么说都不该乱来，还是由我去叫停他们吧。",
            "nextDialogs": [
              "716660311"
            ]
          },
          "716660311": {
            "id": "716660311",
            "speakerId": 1030,
            "speakerName": "烟绯",
            "text": "我倒是觉得挺有意思的呀，不用紧张嘛！斗虫大会听起来就是个很不错的活动！",
            "nextDialogs": [
              "716660312"
            ]
          },
          "716660312": {
            "id": "716660312",
            "speakerId": 1030,
            "speakerName": "烟绯",
            "text": "《璃月会典律例总辑要》里说，这种活动只需要向总务司下属一个部门报备，等上片刻，就可以拿到举办许可了。",
            "nextDialogs": [
              "716660313"
            ]
          },
          "716660313": {
            "id": "716660313",
            "speakerId": 1030,
            "speakerName": "烟绯",
            "text": "说不定，你们还能通过这次活动结识更多朋友呢！下次再来璃月玩的时候，就能叫上更多朋友了！",
            "nextDialogs": [
              "716660314"
            ]
          },
          "716660314": {
            "id": "716660314",
            "speakerId": 1012,
            "speakerName": "香菱",
            "text": "对哦，还可以多多光顾我们家的店，吃得开心，玩得痛快！",
            "nextDialogs": [
              "716660315"
            ]
          },
          "716660315": {
            "id": "716660315",
            "speakerId": 1043,
            "speakerName": "锅巴",
            "text": "♪~",
            "nextDialogs": [
              "716660316"
            ]
          },
          "716660316": {
            "id": "716660316",
            "speakerId": 1049,
            "speakerName": "久岐忍",
            "text": "烟绯师姐，香菱小姐，还有锅巴先生…你们已经开始帮我们思考下次的行程了吗？",
            "nextDialogs": [
              "716660317"
            ]
          },
          "716660317": {
            "id": "716660317",
            "speakerId": 1049,
            "speakerName": "久岐忍",
            "text": "但荒泷派的经费…",
            "nextDialogs": [
              "716660318"
            ]
          },
          "716660318": {
            "id": "716660318",
            "speakerId": 1030,
            "speakerName": "烟绯",
            "text": "当然了，快乐生活很重要！多见见老朋友，多结交新朋友，多多聚会、聊天和放松，不是挺开心的嘛！",
            "nextDialogs": [
              "716660319"
            ]
          },
          "716660319": {
            "id": "716660319",
            "speakerId": 1030,
            "speakerName": "烟绯",
            "text": "正好，我待会儿要去总务司办点事，就顺带帮一斗先生问问熟人吧。",
            "nextDialogs": [
              "716660320"
            ]
          },
          "716660320": {
            "id": "716660320",
            "speakerId": 1030,
            "speakerName": "烟绯",
            "text": "我们分头行动，你们先去一斗先生那边帮他们准备会场，过段时间，我就带着活动许可过来。",
            "nextDialogs": [
              "716660321"
            ]
          },
          "716660321": {
            "id": "716660321",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "烟绯好像特别开心呢，这就直接开始筹备活动了…",
            "nextDialogs": [
              "716660322"
            ]
          },
          "716660322": {
            "id": "716660322",
            "speakerId": 1012,
            "speakerName": "香菱",
            "text": "毕竟之前烟绯也担任过厨王争霸赛的公证员嘛，她的人脉又很广，也算是这种热闹活动的专家了。",
            "nextDialogs": [
              "716660323"
            ]
          },
          "716660323": {
            "id": "716660323",
            "speakerId": 1012,
            "speakerName": "香菱",
            "text": "这段时间她正在休假，刚好很久没见的师妹来作客，肯定想好好放松一下~",
            "nextDialogs": [
              "716660324"
            ]
          },
          "716660324": {
            "id": "716660324",
            "speakerId": 1049,
            "speakerName": "久岐忍",
            "text": "事到如今，经费的问题已经说不出口了，只能直接解决老大。",
            "nextDialogs": [
              "716660325"
            ]
          },
          "716660325": {
            "id": "716660325",
            "speakerId": 1049,
            "speakerName": "久岐忍",
            "text": "#{NICKNAME}，派蒙，之前有劳你们两位了。下次再见面时，我会尽量给你们准备谢礼的！",
            "nextDialogs": [
              "716660326"
            ]
          },
          "716660326": {
            "id": "716660326",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "咦？接下来不需要我们一起跟着去吗？",
            "nextDialogs": [
              "716660327"
            ]
          },
          "716660327": {
            "id": "716660327",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "一斗真打算用鬼兜虫战胜那只幼岩龙蜥的话，你们要怎么处理之后的事，反而让我有点好奇了…",
            "nextDialogs": [
              "716660330"
            ]
          },
          "716660330": {
            "id": "716660330",
            "speakerId": 1049,
            "speakerName": "久岐忍",
            "text": "这么一说…我记得，之前举办「荒泷极意堂堂斗虫大试合」的时候，你们好像帮了老大不少忙？",
            "nextDialogs": [
              "716660331"
            ]
          },
          "716660331": {
            "id": "716660331",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "倒也谈不上帮忙，只是一起玩了几盘斗虫而已…确实挺开心的。",
            "nextDialogs": [
              "716660332"
            ]
          },
          "716660332": {
            "id": "716660332",
            "speakerId": 1049,
            "speakerName": "久岐忍",
            "text": "那你们应该非常理解老大关注的重点，能帮我更顺利地说服他。实在有劳你们了。",
            "nextDialogs": [
              "716660333"
            ]
          },
          "716660333": {
            "id": "716660333",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "话说回来…我们好像也不一定非得说服一斗吧？"
          }
        }
      }
    },
    {
      "subId": "7166604",
      "subQuestName": "再度前往孤云阁",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "716660401"
        ],
        "dialogs": {
          "716660401": {
            "id": "716660401",
            "speakerId": 1049,
            "speakerName": "久岐忍",
            "text": "喂，老大。在璃月开心闹腾的日子结束了，跟我回去吧。",
            "nextDialogs": [
              "716660402"
            ]
          },
          "716660402": {
            "id": "716660402",
            "speakerId": 1044,
            "speakerName": "荒泷一斗",
            "text": "阿忍？你…你听我解释！",
            "nextDialogs": [
              "716660403"
            ]
          },
          "716660403": {
            "id": "716660403",
            "speakerId": 1049,
            "speakerName": "久岐忍",
            "text": "别解释了，没钱了。",
            "nextDialogs": [
              "716660404"
            ]
          },
          "716660404": {
            "id": "716660404",
            "speakerId": 1049,
            "speakerName": "久岐忍",
            "text": "这次我们在璃月待得太久，买完返程船票后，荒泷派的经费池里只剩两位数的摩拉了，怎么可能举办比赛？",
            "nextDialogs": [
              "716660405"
            ]
          },
          "716660405": {
            "id": "716660405",
            "speakerId": 1049,
            "speakerName": "久岐忍",
            "text": "烟绯师姐还在热情地帮我们走流程，难道要人家掏腰包吗？在事态变得不可收拾前，赶快停手吧。",
            "nextDialogs": [
              "716660406"
            ]
          },
          "716660406": {
            "id": "716660406",
            "speakerId": 1044,
            "speakerName": "荒泷一斗",
            "text": "这！这次的情况不一样！平时我可以听你的，但我们荒泷派最强的两位斗虫王者全败给了那家{RUBY#[D]「水晶岛梆梆旋风」}伙！",
            "nextDialogs": [
              "716660407"
            ]
          },
          "716660407": {
            "id": "716660407",
            "speakerId": 1044,
            "speakerName": "荒泷一斗",
            "text": "你看，我们连擂台都准备好了！要是现在逃走，岂不是成了整个斗虫界的笑话！",
            "nextDialogs": [
              "716660408"
            ]
          },
          "716660408": {
            "id": "716660408",
            "speakerId": 1049,
            "speakerName": "久岐忍",
            "text": "你们斗虫输掉的次数又不少，之前我随便玩玩都赢过你，干嘛还在意输给一只幼岩龙蜥的事？",
            "nextDialogs": [
              "716660409"
            ]
          },
          "716660409": {
            "id": "716660409",
            "speakerId": 1044,
            "speakerName": "荒泷一斗",
            "text": "阿忍！你！",
            "nextDialogs": [
              "716660410"
            ]
          },
          "716660410": {
            "id": "716660410",
            "speakerId": 1044,
            "speakerName": "荒泷一斗",
            "text": "都是好久以前的事了！现在的我早已凌驾于所有斗虫者之上，打败那家伙可不是说大话，不信你就来试试看！",
            "nextDialogs": [
              "716660411"
            ]
          },
          "716660411": {
            "id": "716660411",
            "speakerId": 1049,
            "speakerName": "久岐忍",
            "text": "那好吧，果然还是要由我来亲自解决老大。",
            "nextDialogs": [
              "716660412"
            ]
          },
          "716660412": {
            "id": "716660412",
            "speakerId": 1049,
            "speakerName": "久岐忍",
            "text": "「花角玉将」，给我和老大一只虫，我就用他认可的方式打败他，让他心服口服。",
            "nextDialogs": [
              "716660413"
            ]
          },
          "716660413": {
            "id": "716660413",
            "speakerId": 1049,
            "speakerName": "久岐忍",
            "text": "如果我斗赢了，你们就要乖乖跟着我回去，不能再给烟绯师姐添麻烦了。",
            "nextDialogs": [
              "716660414"
            ]
          },
          "716660414": {
            "id": "716660414",
            "speakerId": 13019,
            "speakerName": "「花角玉将」",
            "text": "忍姐！鬼王！我…",
            "nextDialogs": [
              "716660415"
            ]
          },
          "716660415": {
            "id": "716660415",
            "speakerId": 1044,
            "speakerName": "荒泷一斗",
            "text": "还真来啊？这个气势…没想到阿忍居然会这么认真！",
            "nextDialogs": [
              "716660416"
            ]
          },
          "716660416": {
            "id": "716660416",
            "speakerId": 1044,
            "speakerName": "荒泷一斗",
            "text": "那…破破…「破空白铁小堇瓜」！就由你来应对阿忍的考验吧！",
            "nextDialogs": [
              "716660417"
            ]
          },
          "716660417": {
            "id": "716660417",
            "speakerId": 1049,
            "speakerName": "久岐忍",
            "text": "让派蒙和我斗虫？",
            "nextDialogs": [
              "716660418"
            ]
          },
          "716660418": {
            "id": "716660418",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "哼哼，这次我一点也不意外~",
            "nextDialogs": [
              "716660421"
            ]
          },
          "716660421": {
            "id": "716660421",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "放牛{RUBY#[D]「真剑斗虫大鬼王」}的接下来要说的话大概是…「想打败鬼王，还得先过破空白铁小堇瓜这关，不然可没有资格呀！」",
            "nextDialogs": [
              "716660422"
            ]
          },
          "716660422": {
            "id": "716660422",
            "speakerId": 1044,
            "speakerName": "荒泷一斗",
            "text": "没错，「破空白铁小堇瓜」虽然是我们荒泷派的斗虫干将，但还是比本大爷逊色一点的，阿忍要打败这位堇瓜，证明自己！",
            "nextDialogs": [
              "716660423"
            ]
          },
          "716660423": {
            "id": "716660423",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "但是——我拒绝！",
            "nextDialogs": [
              "716660424"
            ]
          },
          "716660424": {
            "id": "716660424",
            "speakerId": 1044,
            "speakerName": "荒泷一斗",
            "text": "什么？！",
            "nextDialogs": [
              "716660425"
            ]
          },
          "716660425": {
            "id": "716660425",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "就算是我也明白，总是麻烦别人可不好哦。既然没钱了，就要尽量节俭一点。",
            "nextDialogs": [
              "716660426"
            ]
          },
          "716660426": {
            "id": "716660426",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "#不然，我和{NICKNAME}帮你，岂不是在给烟绯添麻烦，让阿忍欠人情么？",
            "nextDialogs": [
              "716660427"
            ]
          },
          "716660427": {
            "id": "716660427",
            "speakerId": 1044,
            "speakerName": "荒泷一斗",
            "text": "这倒确实…说得有道理…",
            "nextDialogs": [
              "716660428"
            ]
          },
          "716660428": {
            "id": "716660428",
            "speakerId": 1044,
            "speakerName": "荒泷一斗",
            "text": "不过！我也是想过对策的！",
            "nextDialogs": [
              "716660429"
            ]
          },
          "716660429": {
            "id": "716660429",
            "speakerId": 1044,
            "speakerName": "荒泷一斗",
            "text": "资金真的不够的时候，我就…晚上打夜工，白天来斗虫，用工钱来补贴这场赛事！",
            "nextDialogs": [
              "716660430"
            ]
          },
          "716660430": {
            "id": "716660430",
            "speakerId": 1044,
            "speakerName": "荒泷一斗",
            "text": "嗯，之前玉将也有帮我物色过几份不错的差事，只要能出大力气，报酬都好说，再适合我不过了！",
            "nextDialogs": [
              "716660431"
            ]
          },
          "716660431": {
            "id": "716660431",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "这还差不多嘛！看得出来，你是真的下定了决心！"
          }
        }
      }
    },
    {
      "subId": "7166606",
      "subQuestName": "与久岐忍斗虫",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [],
        "dialogs": {}
      }
    },
    {
      "subId": "7166605",
      "subQuestName": "返回斗虫会场",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "716660501"
        ],
        "dialogs": {
          "716660501": {
            "id": "716660501",
            "speakerId": 1007,
            "speakerName": "Black Screen",
            "text": "经过一番激烈的较量，久岐忍的鬼兜虫略逊于派蒙指挥的「赤红一杵」…",
            "nextDialogs": [
              "716660502"
            ]
          },
          "716660502": {
            "id": "716660502",
            "speakerId": 1049,
            "speakerName": "久岐忍",
            "text": "居然…输掉了？",
            "nextDialogs": [
              "716660503"
            ]
          },
          "716660503": {
            "id": "716660503",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "好，好惊险，差一点就被阿忍给抓住破绽了…",
            "nextDialogs": [
              "716660506"
            ]
          },
          "716660506": {
            "id": "716660506",
            "speakerId": 1044,
            "speakerName": "荒泷一斗",
            "text": "哦哟？哦哟哟！「破空白铁小堇瓜」一次就赢了阿忍…难道你真的是斗虫天才？",
            "nextDialogs": [
              "716660507"
            ]
          },
          "716660507": {
            "id": "716660507",
            "speakerId": 13019,
            "speakerName": "「花角玉将」",
            "text": "这样一来，忍姐也会答应我们举办「荒泷甲光烈烈斗虫大修行」了！",
            "nextDialogs": [
              "716660508"
            ]
          },
          "716660508": {
            "id": "716660508",
            "speakerId": 1049,
            "speakerName": "久岐忍",
            "text": "太久没斗虫，果然还是生疏了…",
            "nextDialogs": [
              "716660509"
            ]
          },
          "716660509": {
            "id": "716660509",
            "speakerId": 1049,
            "speakerName": "久岐忍",
            "text": "没办法，只能退而求其次了。争取控制总成本，不能什么都麻烦烟绯师姐…",
            "nextDialogs": [
              "716660510"
            ]
          },
          "716660510": {
            "id": "716660510",
            "speakerId": 1049,
            "speakerName": "久岐忍",
            "text": "老大，你必须说到做到！晚上打夜工，自己为活动挣点经费，白天再折腾比赛的事。",
            "nextDialogs": [
              "716660511"
            ]
          },
          "716660511": {
            "id": "716660511",
            "speakerId": 1049,
            "speakerName": "久岐忍",
            "text": "而且…因为我们早就订好了返程的船票，最多改签到几天以后，时间只够你们和四五位对手较量，别太贪心。",
            "nextDialogs": [
              "716660512"
            ]
          },
          "716660512": {
            "id": "716660512",
            "speakerId": 1044,
            "speakerName": "荒泷一斗",
            "text": "好！一定！肯定！绝对不食言！你就放心吧，阿忍！",
            "nextDialogs": [
              "716660513"
            ]
          },
          "716660513": {
            "id": "716660513",
            "speakerId": 1049,
            "speakerName": "久岐忍",
            "text": "我就先去港口那边打个招呼…你们千万注意控制成本！",
            "nextDialogs": [
              "716660514"
            ]
          },
          "716660514": {
            "id": "716660514",
            "speakerId": 1044,
            "speakerName": "荒泷一斗",
            "text": "只用五场斗虫修炼，就将实力提升到锅巴兄认可的地步，再向锅巴兄好好学习，打败那个嚣张的{RUBY#[D]「水晶岛梆梆旋风」}家伙…",
            "nextDialogs": [
              "716660515"
            ]
          },
          "716660515": {
            "id": "716660515",
            "speakerId": 1044,
            "speakerName": "荒泷一斗",
            "text": "阿忍这是给我们出了一个大难题啊！",
            "nextDialogs": [
              "716660516"
            ]
          },
          "716660516": {
            "id": "716660516",
            "speakerId": 1044,
            "speakerName": "荒泷一斗",
            "text": "不过，这种超有挑战性的事，我最喜欢不过了！哈哈！",
            "nextDialogs": [
              "716660517"
            ]
          },
          "716660517": {
            "id": "716660517",
            "speakerId": 13019,
            "speakerName": "「花角玉将」",
            "text": "请放心，鬼王，我一定会好好感应附近的斗虫强者，邀请他们来参加这场大修行。",
            "nextDialogs": [
              "716660518"
            ]
          },
          "716660518": {
            "id": "716660518",
            "speakerId": 13019,
            "speakerName": "「花角玉将」",
            "text": "虽说来到璃月的时间不长，但我非常确信，这广袤的土地上，到处都是不凡之士…每天找来一人，完全不在话下！",
            "nextDialogs": [
              "716660519"
            ]
          },
          "716660519": {
            "id": "716660519",
            "speakerId": 13019,
            "speakerName": "「花角玉将」",
            "text": "至于「鬼王的左膀右臂」殿下和「破空白铁小堇瓜」大人…",
            "nextDialogs": [
              "716660520"
            ]
          },
          "716660520": {
            "id": "716660520",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "我们可是帮你们说服了阿忍哦！看你们慌张的表情就知道，你们两个肯定不是她的对手！"
          }
        }
      }
    },
    {
      "subId": "7166607",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "716660701"
        ],
        "dialogs": {
          "716660701": {
            "id": "716660701",
            "speakerId": 1008,
            "speakerName": "万民堂通知",
            "text": "「因店内食材短缺，万民堂将停业七天…」",
            "nextDialogs": [
              "716660702"
            ]
          },
          "716660702": {
            "id": "716660702",
            "speakerId": 1008,
            "speakerName": "万民堂通知",
            "text": "「感谢各位客人的理解和支持，我们会尽快重新开张，继续为大家提供可口的菜肴！」"
          }
        }
      }
    },
    {
      "subId": "7166610",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "716661001"
        ],
        "dialogs": {
          "716661001": {
            "id": "716661001",
            "speakerId": 1049,
            "speakerName": "久岐忍",
            "text": "唔…是因为最近吃了太多香辣的料理吗？感觉有些燥热…",
            "nextDialogs": [
              "716661002"
            ]
          },
          "716661002": {
            "id": "716661002",
            "speakerId": 1030,
            "speakerName": "烟绯",
            "text": "啊呀，可能是上火了，或者湿气太重！我去给你买两碗凉茶吧，清火祛湿！"
          }
        }
      }
    },
    {
      "subId": "7166611",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "716661101"
        ],
        "dialogs": {
          "716661101": {
            "id": "716661101",
            "speakerId": 10033,
            "speakerName": "香菱",
            "text": "这个月，店里的收入已经超出预期了。等老爹采购完食材回来，应该还有不少时间，我们还能好好休息一下。",
            "nextDialogs": [
              "716661102"
            ]
          },
          "716661102": {
            "id": "716661102",
            "speakerId": 10033,
            "speakerName": "香菱",
            "text": "接下来就要回归正常营业了，不会像前几天那么忙。我们也可以抽空去一斗先生的斗虫大会看一看，玩一玩！",
            "nextDialogs": [
              "716661103"
            ]
          },
          "716661103": {
            "id": "716661103",
            "speakerId": 1043,
            "speakerName": "锅巴",
            "text": "♪~"
          }
        }
      }
    },
    {
      "subId": "7166699",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "716669901"
        ],
        "dialogs": {
          "716669901": {
            "id": "716669901",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "唔…说起来，最近这段时间，好像没怎么去过万民堂呢…",
            "nextDialogs": [
              "716669902"
            ]
          },
          "716669902": {
            "id": "716669902",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "#我突然有点想吃香香辣辣的料理了，{NICKNAME}，我们回万民堂去看看吧？"
          }
        }
      }
    }
  ]
}
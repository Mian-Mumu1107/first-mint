    {
      "subId": "200806",
      "subQuestName": "前往木漏茶室",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "20080301"
        ],
        "dialogs": {
          "20080301": {
            "id": "20080301",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "奇怪，今天怎么这么安静，和平时完全不一样。",
            "nextDialogs": [
              "20080302"
            ]
          },
          "20080302": {
            "id": "20080302",
            "speakerId": 3009,
            "speakerName": "太郎丸",
            "text": "汪汪…汪！",
            "nextDialogs": [
              "20080303"
            ]
          },
          "20080303": {
            "id": "20080303",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "难道说，又是这种双簧演出吗？",
            "nextDialogs": [
              "20080304"
            ]
          },
          "20080304": {
            "id": "20080304",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "托马——托马——",
            "nextDialogs": [
              "20080305"
            ]
          },
          "20080305": {
            "id": "20080305",
            "speakerId": 3009,
            "speakerName": "太郎丸",
            "text": "汪！汪！…汪！",
            "nextDialogs": [
              "20080306"
            ]
          },
          "20080306": {
            "id": "20080306",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "喂——不要再躲了，我已经看见你啦——",
            "nextDialogs": [
              "20080307"
            ]
          },
          "20080307": {
            "id": "20080307",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "嗯？完全没有人回应，托马跑到哪里去了？",
            "nextDialogs": [
              "20080308"
            ]
          },
          "20080308": {
            "id": "20080308",
            "speakerId": 3009,
            "speakerName": "太郎丸",
            "text": "汪汪汪！汪！",
            "nextDialogs": [
              "20080309"
            ]
          },
          "20080309": {
            "id": "20080309",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "咦？平时一直那么老实的太郎丸，今天好像很急躁的样子…",
            "nextDialogs": [
              "20080310"
            ]
          },
          "20080310": {
            "id": "20080310",
            "speakerId": 1013,
            "speakerName": "神里绫华",
            "text": "两位，有看到托马吗？",
            "nextDialogs": [
              "20080311"
            ]
          },
          "20080311": {
            "id": "20080311",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "我们还以为他跟你在一起呢，发生什么事了吗？",
            "nextDialogs": [
              "20080312"
            ]
          },
          "20080312": {
            "id": "20080312",
            "speakerId": 1013,
            "speakerName": "神里绫华",
            "text": "糟糕…我在来这里的路上，听说托马被天领奉行的人抓走了。",
            "nextDialogs": [
              "20080313"
            ]
          },
          "20080313": {
            "id": "20080313",
            "speakerId": 1013,
            "speakerName": "神里绫华",
            "text": "我没办法判断消息是真是假，就立刻跑过来确认。如果托马没有按照约定出现在这里，意味着传闻大概率是真的。",
            "nextDialogs": [
              "20080314"
            ]
          },
          "20080314": {
            "id": "20080314",
            "speakerId": 1013,
            "speakerName": "神里绫华",
            "text": "雷电将军会在千手百眼神像前，举办第一百颗神之眼的「狩眼仪式」。",
            "nextDialogs": [
              "20080315"
            ]
          },
          "20080315": {
            "id": "20080315",
            "speakerId": 1013,
            "speakerName": "神里绫华",
            "text": "而那第一百颗神之眼的持有者…也就是即将被公开狩眼的对象，恐怕…就是托马。",
            "nextDialogs": [
              "20080316"
            ]
          },
          "20080316": {
            "id": "20080316",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "难道托马之前听说的，天领奉行正在筹备的「仪式」，刚好就是为他准备的「狩眼仪式」？",
            "nextDialogs": [
              "20080317"
            ]
          },
          "20080317": {
            "id": "20080317",
            "speakerId": 1013,
            "speakerName": "神里绫华",
            "text": "应该…是的，将军和天领奉行的人准备以第一百颗神之眼的「狩眼仪式」，来证明眼狩令的阶段性成果。",
            "nextDialogs": [
              "20080318"
            ]
          },
          "20080318": {
            "id": "20080318",
            "speakerId": 1013,
            "speakerName": "神里绫华",
            "text": "…不行，我必须去救他！",
            "nextDialogs": [
              "20080319"
            ]
          },
          "20080319": {
            "id": "20080319",
            "speakerId": 3009,
            "speakerName": "太郎丸",
            "text": "汪汪！汪！",
            "nextDialogs": [
              "20080320"
            ]
          },
          "20080320": {
            "id": "20080320",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "冷静。",
            "nextDialogs": [
              "20080321"
            ]
          },
          "20080321": {
            "id": "20080321",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "但「白鹭公主」也代表了社奉行。",
            "nextDialogs": [
              "20080322"
            ]
          },
          "20080322": {
            "id": "20080322",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "是呀，如果你亲自过去的话，不就代表社奉行要和雷电将军为敌了吗？",
            "nextDialogs": [
              "20080323"
            ]
          },
          "20080323": {
            "id": "20080323",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "公然反抗雷电将军的话，社奉行那些普通人也会被牵连进来吧…",
            "nextDialogs": [
              "20080324"
            ]
          },
          "20080324": {
            "id": "20080324",
            "speakerId": 1013,
            "speakerName": "神里绫华",
            "text": "这也是没办法的事…时间已经不多了，仪式就要开始，我不能就这样放弃托马。",
            "nextDialogs": [
              "20080325"
            ]
          },
          "20080325": {
            "id": "20080325",
            "speakerId": 1013,
            "speakerName": "神里绫华",
            "text": "他是我的朋友，明明不久之前，我们大家还一起…",
            "nextDialogs": [
              "20080326"
            ]
          },
          "20080326": {
            "id": "20080326",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "他也是我的朋友，我去救他。",
            "nextDialogs": [
              "20080327"
            ]
          },
          "20080327": {
            "id": "20080327",
            "speakerId": 1013,
            "speakerName": "神里绫华",
            "text": "可是…",
            "nextDialogs": [
              "20080328"
            ]
          },
          "20080328": {
            "id": "20080328",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "你刚才说过吧？——时间不多了。",
            "nextDialogs": [
              "20080329"
            ]
          },
          "20080329": {
            "id": "20080329",
            "speakerId": 1013,
            "speakerName": "神里绫华",
            "text": "……",
            "nextDialogs": [
              "20080330"
            ]
          },
          "20080330": {
            "id": "20080330",
            "speakerId": 1013,
            "speakerName": "神里绫华",
            "text": "…嗯，我会…等你们平安回来。",
            "nextDialogs": [
              "20080331"
            ]
          },
          "20080331": {
            "id": "20080331",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "放心吧，绫华，事关朋友的性命，我们绝对不会失手的！"
          }
        }
      }
    },

    },
    {
      "subId": "200899",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "20089901"
        ],
        "dialogs": {
          "20089901": {
            "id": "20089901",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "在稻妻城的日子好像也还不错呢，不过…好像到了托马和绫华所说的「下一步行动」的时间了吧？",
            "nextDialogs": [
              "20089902"
            ]
          },
          "20089902": {
            "id": "20089902",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "还是到木漏茶室集合，准备好了就去见他们吧？"
          }
        }
      }
    },
    {
      "subId": "4002015",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "400201501"
        ],
        "dialogs": {
          "400201501": {
            "id": "400201501",
            "speakerId": 12172,
            "speakerName": "渡部",
            "text": "唉！这次的失败，真是耻辱！",
            "nextDialogs": [
              "400201502"
            ]
          },
          "400201502": {
            "id": "400201502",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "关于天领奉行…",
            "nextDialogs": [
              "400201503"
            ]
          },
          "400201503": {
            "id": "400201503",
            "speakerId": 12172,
            "speakerName": "渡部",
            "text": "如你所见，时局改变了，天领奉行正对稻妻全境重新布防。",
            "nextDialogs": [
              "400201504"
            ]
          },
          "400201504": {
            "id": "400201504",
            "speakerId": 12172,
            "speakerName": "渡部",
            "text": "虽说我们远不如九条裟罗大人那般迅捷骁勇，但也要倾尽全力，守护稻妻，绝不能让魔物再猖狂下去了…"
          }
        }
      }
    },
    {
      "subId": "4002115",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "400211501"
        ],
        "dialogs": {
          "400211501": {
            "id": "400211501",
            "speakerId": 12172,
            "speakerName": "渡部",
            "text": "不愧是九条裟罗大人！她抽调来的人手，全都是战斗经验丰富的老兵！",
            "nextDialogs": [
              "400211502"
            ]
          },
          "400211502": {
            "id": "400211502",
            "speakerId": 12172,
            "speakerName": "渡部",
            "text": "有这些老兵坐镇，再多魔物也没法攻破这道关口！",
            "nextDialogs": [
              "400211503"
            ]
          },
          "400211503": {
            "id": "400211503",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "关于你的伤势…",
            "nextDialogs": [
              "400211504"
            ]
          },
          "400211504": {
            "id": "400211504",
            "speakerId": 12172,
            "speakerName": "渡部",
            "text": "这点轻伤不碍事！关键时刻，天领奉行的武士可不能退缩！",
            "nextDialogs": [
              "400211505"
            ]
          },
          "400211505": {
            "id": "400211505",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "好强的气势！真让人安心呢！"
          }
        }
      }
    },
    {
      "subId": "4002212",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "400221201"
        ],
        "dialogs": {
          "400221201": {
            "id": "400221201",
            "speakerId": 12172,
            "speakerName": "渡部",
            "text": "局势似乎稳定下来了…这样一来，九条裟罗大人就不必心急了。",
            "nextDialogs": [
              "400221202"
            ]
          },
          "400221202": {
            "id": "400221202",
            "speakerId": 12172,
            "speakerName": "渡部",
            "text": "稳妥第一，等到九条裟罗大人将城中事务都处理好，我们再发起总攻，一举拿下这座秘境！",
            "nextDialogs": [
              "400221203"
            ]
          },
          "400221203": {
            "id": "400221203",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "他们还真是斗志昂扬啊，我们得抓紧时间了…"
          }
        }
      }
    },
    {
      "subId": "4002303",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "400230301"
        ],
        "dialogs": {
          "400230301": {
            "id": "400230301",
            "speakerId": 30067,
            "speakerName": "「式大将」",
            "text": "追求极致武艺的人，都能在这座「诀箓阴阳寮」中，得到最有效的锤炼。",
            "nextDialogs": [
              "400230302"
            ]
          },
          "400230302": {
            "id": "400230302",
            "speakerId": 30067,
            "speakerName": "「式大将」",
            "text": "当然，要是急于挑战强敌，反而有可能遭遇挫折。还请量力而行，不必勉强自己。"
          }
        }
      }
    }
  ]
}
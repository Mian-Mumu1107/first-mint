        ],
        "dialogs": {
          "411560101": {
            "id": "411560101",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "我这就送过去。",
            "nextDialogs": [
              "411560102"
            ]
          },
          "411560102": {
            "id": "411560102",
            "speakerId": 2204,
            "speakerName": "言笑",
            "text": "那麻烦你了。这爆炒肉要做好讲究一个步骤周全，不多节外生枝。",
            "nextDialogs": [
              "411560103"
            ]
          },
          "411560103": {
            "id": "411560103",
            "speakerId": 2204,
            "speakerName": "言笑",
            "text": "所以<color=#00E1FFFF>中途不要沾了奇怪的元素，也别跑动步子太大</color>。"
          }
        }
      }
    },

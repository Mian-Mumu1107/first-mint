  "subQuests": [
    {
      "subId": "7565901",
      "subQuestName": "与「战备联络人」对话",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "756590101"
        ],
        "dialogs": {
          "756590101": {
            "id": "756590101",
            "speakerId": 15129,
            "speakerName": "伊拉德",
            "text": "您终于来了，英雄大人。",
            "nextDialogs": [
              "756590102"
            ]
          },
          "756590102": {
            "id": "756590102",
            "speakerId": 15129,
            "speakerName": "伊拉德",
            "text": "卑职在此等候多时，见到您的身影，疲惫竟一扫而空！",
            "nextDialogs": [
              "756590105"
            ]
          },
          "756590105": {
            "id": "756590105",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "气氛突然变得好正式！我，我也要用正经的语气说话么？",
            "nextDialogs": [
              "756590106"
            ]
          },
          "756590106": {
            "id": "756590106",
            "speakerId": 15129,
            "speakerName": "伊拉德",
            "text": "啊，请别紧张，英雄大人和尊贵的向导，我简单介绍一下情况。",
            "nextDialogs": [
              "756590107"
            ]
          },
          "756590107": {
            "id": "756590107",
            "speakerId": 15129,
            "speakerName": "伊拉德",
            "text": "卑职是话事处的员工，战备联络人伊拉德，负责协助火神大人处理各部族巡逻队的训练事务。",
            "nextDialogs": [
              "756590108"
            ]
          },
          "756590108": {
            "id": "756590108",
            "speakerId": 15129,
            "speakerName": "伊拉德",
            "text": "根据传统，每过一段时间，各部族都会从年轻人中选拔新的战士，加入巡逻队。",
            "nextDialogs": [
              "756590109"
            ]
          },
          "756590109": {
            "id": "756590109",
            "speakerId": 15129,
            "speakerName": "伊拉德",
            "text": "同时，还要为老成员们设计较高难度的考核，以便他们挑战自我，不断进步。",
            "nextDialogs": [
              "756590110"
            ]
          },
          "756590110": {
            "id": "756590110",
            "speakerId": 15129,
            "speakerName": "伊拉德",
            "text": "相关的选拔与考核关卡，就是由战备联络人联合各部族的优秀战士一同设计的…",
            "nextDialogs": [
              "756590111"
            ]
          },
          "756590111": {
            "id": "756590111",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "哦呀，我听懂了！",
            "nextDialogs": [
              "756590112"
            ]
          },
          "756590112": {
            "id": "756590112",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "#聊到战斗、竞速之类的挑战，{NICKNAME}的确是专家，应该能帮你设计很多有意思的关卡。"
          }
        }
      }
    }
  ]
}
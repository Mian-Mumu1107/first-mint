  },
  "subQuests": [
    {
      "subId": "1401601",
      "subQuestName": "前往枫丹廷取货",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "140160101"
        ],
        "dialogs": {
          "140160101": {
            "id": "140160101",
            "speakerId": 1075,
            "speakerName": "娜维娅",
            "text": "路德温，我来了，这两天生意怎么样？",
            "nextDialogs": [
              "140160102"
            ]
          },
          "140160102": {
            "id": "140160102",
            "speakerId": 13772,
            "speakerName": "路德温",
            "text": "等不到刺玫会大小姐的光顾，我这小店马上就要关门倒闭啦。",
            "nextDialogs": [
              "140160103"
            ]
          },
          "140160103": {
            "id": "140160103",
            "speakerId": 13709,
            "speakerName": "科尔特",
            "text": "呵呵，都知道你路子广办法多，你开这种玩笑没人信的。不过现在她已经是老板了哦。",
            "nextDialogs": [
              "140160104"
            ]
          },
          "140160104": {
            "id": "140160104",
            "speakerId": 13772,
            "speakerName": "路德温",
            "text": "失敬失敬，哎呀，顺口了嘛。",
            "nextDialogs": [
              "140160105"
            ]
          },
          "140160105": {
            "id": "140160105",
            "speakerId": 13772,
            "speakerName": "路德温",
            "text": "你们是来取衣服的吗？",
            "nextDialogs": [
              "140160106"
            ]
          },
          "140160106": {
            "id": "140160106",
            "speakerId": 1075,
            "speakerName": "娜维娅",
            "text": "对，之前在枫丹廷办事的时候忘记了。",
            "nextDialogs": [
              "140160107"
            ]
          },
          "140160107": {
            "id": "140160107",
            "speakerId": 13772,
            "speakerName": "路德温",
            "text": "这点小事，请手下来办也没问题啊，大小姐竟然亲自跑一趟。",
            "nextDialogs": [
              "140160108"
            ]
          },
          "140160108": {
            "id": "140160108",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "小题大做一直是娜维娅的风格。",
            "nextDialogs": [
              "140160109"
            ]
          },
          "140160109": {
            "id": "140160109",
            "speakerId": 1075,
            "speakerName": "娜维娅",
            "text": "可不是小题大做，散心也是行程中很重要的目的。",
            "nextDialogs": [
              "140160110"
            ]
          },
          "140160110": {
            "id": "140160110",
            "speakerId": 1075,
            "speakerName": "娜维娅",
            "text": "没有什么比踏上一段新的旅程更能治愈身心的了。",
            "nextDialogs": [
              "140160111"
            ]
          },
          "140160111": {
            "id": "140160111",
            "speakerId": 13709,
            "speakerName": "科尔特",
            "text": "呵呵，老板说的是，至少比一个人闷着要好。",
            "nextDialogs": [
              "140160112"
            ]
          },
          "140160112": {
            "id": "140160112",
            "speakerId": 13772,
            "speakerName": "路德温",
            "text": "那你们稍等，我这就去取。",
            "nextDialogs": [
              "140160113"
            ]
          },
          "140160113": {
            "id": "140160113",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "对了，为什么阿黛尔想要加入刺玫会呢？",
            "nextDialogs": [
              "140160114"
            ]
          },
          "140160114": {
            "id": "140160114",
            "speakerId": 1075,
            "speakerName": "娜维娅",
            "text": "嘿嘿，她还说不清具体的理由，只是说因为很喜欢我。",
            "nextDialogs": [
              "140160115"
            ]
          },
          "140160115": {
            "id": "140160115",
            "speakerId": 1075,
            "speakerName": "娜维娅",
            "text": "在那件事之后，她变得开朗了不少，估计是因为她终于知道，她的父亲并不是个让她失望的人。",
            "nextDialogs": [
              "140160116"
            ]
          },
          "140160116": {
            "id": "140160116",
            "speakerId": 1075,
            "speakerName": "娜维娅",
            "text": "她说她很害怕我的老爹，所以觉得刺玫会里都是可怕的人。",
            "nextDialogs": [
              "140160117"
            ]
          },
          "140160117": {
            "id": "140160117",
            "speakerId": 1075,
            "speakerName": "娜维娅",
            "text": "但现在刺玫会的氛围不一样了，她有勇气和我说话，也觉得我能理解她。",
            "nextDialogs": [
              "140160118"
            ]
          },
          "140160118": {
            "id": "140160118",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "你们有相似的遭遇。",
            "nextDialogs": [
              "140160119"
            ]
          },
          "140160119": {
            "id": "140160119",
            "speakerId": 1075,
            "speakerName": "娜维娅",
            "text": "嗯，或许是吧，我在寻找真相的同时也帮助了她。",
            "nextDialogs": [
              "140160120"
            ]
          },
          "140160120": {
            "id": "140160120",
            "speakerId": 1075,
            "speakerName": "娜维娅",
            "text": "她说也想要像我一样，去帮助别人，而不是继续等在原地，期待别人朝她伸出援手。",
            "nextDialogs": [
              "140160121"
            ]
          },
          "140160121": {
            "id": "140160121",
            "speakerId": 13709,
            "speakerName": "科尔特",
            "text": "听上去，她会成为一个优秀的刺玫会成员。",
            "nextDialogs": [
              "140160122"
            ]
          },
          "140160122": {
            "id": "140160122",
            "speakerId": 1075,
            "speakerName": "娜维娅",
            "text": "我也这么认为，但首先，还是要创造一个能让她健康成长的环境吧。等她长大，再把选择权交给她。",
            "nextDialogs": [
              "140160123"
            ]
          },
          "140160123": {
            "id": "140160123",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "（果然不是错觉…）",
            "nextDialogs": [
              "140160124"
            ]
          },
          "140160124": {
            "id": "140160124",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "嗯，你怎么了？",
            "nextDialogs": [
              "140160127"
            ]
          },
          "140160127": {
            "id": "140160127",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "欸？跟、跟踪？！我来了！",
            "nextDialogs": [
              "140160128"
            ]
          },
          "140160128": {
            "id": "140160128",
            "speakerId": 1075,
            "speakerName": "娜维娅",
            "text": "我也去看看！科尔特，衣服你帮我拿一下！",
            "nextDialogs": [
              "140160129"
            ]
          },
          "140160129": {
            "id": "140160129",
            "speakerId": 13709,
            "speakerName": "科尔特",
            "text": "哦，好、好的！"
          }
        }
      }
    },
    {
      "subId": "1401602",
      "subQuestName": "追上跟踪者",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "140160201"
        ],
        "dialogs": {
          "140160201": {
            "id": "140160201",
            "speakerId": 13710,
            "speakerName": "马蒂纳",
            "text": "嘁，果然麻烦。",
            "nextDialogs": [
              "140160202"
            ]
          },
          "140160202": {
            "id": "140160202",
            "speakerId": 1075,
            "speakerName": "娜维娅",
            "text": "看来不给点教训，他们是不打算好好说话了。",
            "nextDialogs": [
              "140160203"
            ]
          },
          "140160203": {
            "id": "140160203",
            "speakerId": 13710,
            "speakerName": "马蒂纳",
            "text": "#兄弟们，不绕弯子了，干掉{M#他们}{F#她们}！"
          }
        }
      }
    },
    {
      "subId": "1401603",
      "subQuestName": "击退跟踪者",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [],
        "dialogs": {}
      }
    },
    {
      "subId": "1401604",
      "subQuestName": "与马蒂纳等人交谈",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "140160401"
        ],
        "dialogs": {
          "140160401": {
            "id": "140160401",
            "speakerId": 1075,
            "speakerName": "娜维娅",
            "text": "老实交代，你们是什么人，为什么要跟踪我们！",
            "nextDialogs": [
              "140160402"
            ]
          },
          "140160402": {
            "id": "140160402",
            "speakerId": 13710,
            "speakerName": "马蒂纳",
            "text": "……",
            "nextDialogs": [
              "140160403"
            ]
          },
          "140160403": {
            "id": "140160403",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "别以为不说话就能蒙混过关！",
            "nextDialogs": [
              "140160406"
            ]
          },
          "140160406": {
            "id": "140160406",
            "speakerId": 13710,
            "speakerName": "马蒂纳",
            "text": "……！",
            "nextDialogs": [
              "140160407"
            ]
          },
          "140160407": {
            "id": "140160407",
            "speakerId": 13709,
            "speakerName": "科尔特",
            "text": "老板，怎么样，你们没受伤吧？",
            "nextDialogs": [
              "140160408"
            ]
          },
          "140160408": {
            "id": "140160408",
            "speakerId": 1075,
            "speakerName": "娜维娅",
            "text": "这种程度的敌人，怎么能奈何得了我们呢？",
            "nextDialogs": [
              "140160409"
            ]
          },
          "140160409": {
            "id": "140160409",
            "speakerId": 1075,
            "speakerName": "娜维娅",
            "text": "好了，不要拖拖拉拉的，赶紧交代。要是执律庭介入，这件事可就没有商量的余地了。",
            "nextDialogs": [
              "140160410"
            ]
          },
          "140160410": {
            "id": "140160410",
            "speakerId": 13710,
            "speakerName": "马蒂纳",
            "text": "我们…是来找刺玫会寻仇的。",
            "nextDialogs": [
              "140160411"
            ]
          },
          "140160411": {
            "id": "140160411",
            "speakerId": 13710,
            "speakerName": "马蒂纳",
            "text": "被发现了，又打不过你们，我们认栽。",
            "nextDialogs": [
              "140160412"
            ]
          },
          "140160412": {
            "id": "140160412",
            "speakerId": 1075,
            "speakerName": "娜维娅",
            "text": "寻仇？难道…你们是那个什么，罗默夫的人吗？",
            "nextDialogs": [
              "140160413"
            ]
          },
          "140160413": {
            "id": "140160413",
            "speakerId": 13710,
            "speakerName": "马蒂纳",
            "text": "你居然知道这个名字…",
            "nextDialogs": [
              "140160414"
            ]
          },
          "140160414": {
            "id": "140160414",
            "speakerId": 13710,
            "speakerName": "马蒂纳",
            "text": "那你就应该知道我们的恨来自何处！",
            "nextDialogs": [
              "140160415"
            ]
          },
          "140160415": {
            "id": "140160415",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "劝你冷静。",
            "nextDialogs": [
              "140160416"
            ]
          },
          "140160416": {
            "id": "140160416",
            "speakerId": 13709,
            "speakerName": "科尔特",
            "text": "是的，你们现在毫无胜算。",
            "nextDialogs": [
              "140160417"
            ]
          },
          "140160417": {
            "id": "140160417",
            "speakerId": 13710,
            "speakerName": "马蒂纳",
            "text": "嘁…",
            "nextDialogs": [
              "140160418"
            ]
          },
          "140160418": {
            "id": "140160418",
            "speakerId": 13710,
            "speakerName": "马蒂纳",
            "text": "我们喝了点酒，在街上看到了娜维娅，气不打一处来，就想找机会找你们的麻烦。",
            "nextDialogs": [
              "140160419"
            ]
          },
          "140160419": {
            "id": "140160419",
            "speakerId": 13710,
            "speakerName": "马蒂纳",
            "text": "结果，反倒是被你们先拎出来了。",
            "nextDialogs": [
              "140160420"
            ]
          },
          "140160420": {
            "id": "140160420",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "你在撒谎。",
            "nextDialogs": [
              "140160421"
            ]
          },
          "140160421": {
            "id": "140160421",
            "speakerId": 13710,
            "speakerName": "马蒂纳",
            "text": "啊…？"
          }
        }
      }
    },
    {
      "subId": "1401605",
      "subQuestName": "前往灰河",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "140160501"
        ],
        "dialogs": {
          "140160501": {
            "id": "140160501",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "再次来到这个地方，总觉得有点亲切感了呢。",
            "nextDialogs": [
              "140160502"
            ]
          },
          "140160502": {
            "id": "140160502",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "如果刺玫会在枫丹廷的据点是像沫芒宫那样富丽堂皇的地方，反而会觉得很不搭调。",
            "nextDialogs": [
              "140160503"
            ]
          },
          "140160503": {
            "id": "140160503",
            "speakerId": 1075,
            "speakerName": "娜维娅",
            "text": "哈哈哈，的确如此，我也这么觉得。",
            "nextDialogs": [
              "140160504"
            ]
          },
          "140160504": {
            "id": "140160504",
            "speakerId": 1075,
            "speakerName": "娜维娅",
            "text": "只不过在我老爹的畅想中，等刺玫会越来越好，白淞镇也会成为不输给枫丹廷的大城市。",
            "nextDialogs": [
              "140160505"
            ]
          },
          "140160505": {
            "id": "140160505",
            "speakerId": 1075,
            "speakerName": "娜维娅",
            "text": "他是个野心很旺盛的人，很少低头去看，所以他才会有很多异于常人的特质。",
            "nextDialogs": [
              "140160506"
            ]
          },
          "140160506": {
            "id": "140160506",
            "speakerId": 13709,
            "speakerName": "科尔特",
            "text": "也就是这一点，人们对卡雷斯先生总是又爱又恨。",
            "nextDialogs": [
              "140160507"
            ]
          },
          "140160507": {
            "id": "140160507",
            "speakerId": 1075,
            "speakerName": "娜维娅",
            "text": "好啦，你们去店里等我，我去里面做些准备，顺便也叫人把你们的住处整理一下。",
            "nextDialogs": [
              "140160508"
            ]
          },
          "140160508": {
            "id": "140160508",
            "speakerId": 1075,
            "speakerName": "娜维娅",
            "text": "房间还和上次一样，没忘记是哪一间吧？",
            "nextDialogs": [
              "140160509"
            ]
          },
          "140160509": {
            "id": "140160509",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "嗯，反正又没几间房！",
            "nextDialogs": [
              "140160510"
            ]
          },
          "140160510": {
            "id": "140160510",
            "speakerId": 1075,
            "speakerName": "娜维娅",
            "text": "你这家伙，想说这地方寒酸对吧！我现在就去把你的枕头塞满水草！",
            "nextDialogs": [
              "140160511"
            ]
          },
          "140160511": {
            "id": "140160511",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "对不起，对不起，那真要睡不着了！",
            "nextDialogs": [
              "140160512"
            ]
          },
          "140160512": {
            "id": "140160512",
            "speakerId": 1075,
            "speakerName": "娜维娅",
            "text": "哈哈哈，开玩笑的，你们先过去吧。"
          }
        }
      }
    },
    {
      "subId": "1401609",
      "subQuestName": "在屋内坐下，等待宴会",
      "sceneId": null,
      "locations": [],
      "dialogue": {

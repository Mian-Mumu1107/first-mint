    {
      "subId": "1401606",
      "subQuestName": "参加宴会",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "140160601"
        ],
        "dialogs": {
          "140160601": {
            "id": "140160601",
            "speakerId": 1005,
            "speakerName": "Black Screen",
            "text": "享用晚餐，观看表演，热闹的夜晚渐渐过去。",
            "nextDialogs": [
              "140160602"
            ]
          },
          "140160602": {
            "id": "140160602",
            "speakerId": 1005,
            "speakerName": "Black Screen",
            "text": "一切转为安宁，你和派蒙回到房中，却听见敲门声…",
            "nextDialogs": [
              "140160603"
            ]
          },
          "140160603": {
            "id": "140160603",
            "speakerId": 1075,
            "speakerName": "娜维娅",
            "text": "睡了吗？还没有吧？",
            "nextDialogs": [
              "140160606"
            ]
          },
          "140160606": {
            "id": "140160606",
            "speakerId": 1075,
            "speakerName": "娜维娅",
            "text": "没什么，只是觉得难得有这样的夜晚，不应该就这么结束，对吧？",
            "nextDialogs": [
              "140160607"
            ]
          },
          "140160607": {
            "id": "140160607",
            "speakerId": 1075,
            "speakerName": "娜维娅",
            "text": "想去钓鱼吗？我已经准备好装备了。",
            "nextDialogs": [
              "140160608"
            ]
          },
          "140160608": {
            "id": "140160608",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "这就是你晚餐之前说的「准备」吧！那我们马上来！",
            "nextDialogs": [
              "140160609"
            ]
          },
          "140160609": {
            "id": "140160609",
            "speakerId": 1075,
            "speakerName": "娜维娅",
            "text": "嘿嘿，没打扰到你们的休息吧。"
          }
        }
      }
    },
    {
      "subId": "1401607",
      "subQuestName": "与娜维娅钓鱼",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "140160701"
        ],
        "dialogs": {
          "140160701": {
            "id": "140160701",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "用自动鱼竿钓鱼，还算钓鱼吗？！",
            "nextDialogs": [
              "140160702"
            ]
          },
          "140160702": {
            "id": "140160702",
            "speakerId": 1075,
            "speakerName": "娜维娅",
            "text": "嗯，怎么了？这种鱼竿在白淞镇很常见啊。",
            "nextDialogs": [
              "140160703"
            ]
          },
          "140160703": {
            "id": "140160703",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "钓鱼，不应该是…呃，非常投入地看着浮漂，等鱼咬钩，体会鱼出水那一瞬间的惊喜吗？",
            "nextDialogs": [
              "140160704"
            ]
          },
          "140160704": {
            "id": "140160704",
            "speakerId": 1075,
            "speakerName": "娜维娅",
            "text": "#那也是一种方式啦。{NICKNAME}，你怎么看呢？",
            "nextDialogs": [
              "140160706",
              "140160708"
            ]
          },
          "140160706": {
            "id": "140160706",
            "speakerId": 1075,
            "speakerName": "娜维娅",
            "text": "那下次我们就用普通的鱼竿钓鱼吧，比一比谁钓得更多。",
            "nextDialogs": [
              "140160709"
            ]
          },
          "140160709": {
            "id": "140160709",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "比起这个，我更想问为什么娜维娅你这么有精神，这种时候我都…哈啊…想睡觉了。",
            "nextDialogs": [
              "140160710"
            ]
          },
          "140160710": {
            "id": "140160710",
            "speakerId": 1075,
            "speakerName": "娜维娅",
            "text": "天生的吧。",
            "nextDialogs": [
              "140160711"
            ]
          },
          "140160711": {
            "id": "140160711",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "就这样？",
            "nextDialogs": [
              "140160712"
            ]
          },
          "140160712": {
            "id": "140160712",
            "speakerId": 1075,
            "speakerName": "娜维娅",
            "text": "展开来讲的话你会更想睡觉的。我想，应该是多亏了刺玫会，还有我的母亲吧。",
            "nextDialogs": [
              "140160713"
            ]
          },
          "140160713": {
            "id": "140160713",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "母亲？",
            "nextDialogs": [
              "140160714"
            ]
          },
          "140160714": {
            "id": "140160714",
            "speakerId": 1075,
            "speakerName": "娜维娅",
            "text": "我老爹从小就对我有很多不切实际的期待，他越是想要我和他一样，我就越不想听他的话。",
            "nextDialogs": [
              "140160715"
            ]
          },
          "140160715": {
            "id": "140160715",
            "speakerId": 1075,
            "speakerName": "娜维娅",
            "text": "我母亲就不一样了，我听说她对我只有一个期望，就是能开开心心地长大。",
            "nextDialogs": [
              "140160716"
            ]
          },
          "140160716": {
            "id": "140160716",
            "speakerId": 1075,
            "speakerName": "娜维娅",
            "text": "刺玫会的成员都很尊重她的想法，无论我去哪里胡闹，他们都愿意惯着我。",
            "nextDialogs": [
              "140160717"
            ]
          },
          "140160717": {
            "id": "140160717",
            "speakerId": 1075,
            "speakerName": "娜维娅",
            "text": "你们能想象吗？我因为闯祸挨骂的时候，所有人站成两排，迈勒斯和西尔弗也在，只有我老爹一个人大发雷霆。",
            "nextDialogs": [
              "140160718"
            ]
          },
          "140160718": {
            "id": "140160718",
            "speakerId": 1075,
            "speakerName": "娜维娅",
            "text": "大家都默不作声，渐渐地，就显得为了小事而对我发脾气的老爹很小气，他也就只好闭嘴了。",
            "nextDialogs": [
              "140160719"
            ]
          },
          "140160719": {
            "id": "140160719",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "还有这种事啊？",
            "nextDialogs": [
              "140160720"
            ]
          },
          "140160720": {
            "id": "140160720",
            "speakerId": 1075,
            "speakerName": "娜维娅",
            "text": "是啊，现在想想，他们真的都是一群很温柔的人。",
            "nextDialogs": [
              "140160721"
            ]
          },
          "140160721": {
            "id": "140160721",
            "speakerId": 1075,
            "speakerName": "娜维娅",
            "text": "小时候的我一直认为，我可以想做什么就做什么，因为总会有人帮我善后。",
            "nextDialogs": [
              "140160722"
            ]
          },
          "140160722": {
            "id": "140160722",
            "speakerId": 1075,
            "speakerName": "娜维娅",
            "text": "但是有一次迈勒斯他受伤了，他不告诉我原因，但我能感觉到，是因为我的缘故。",
            "nextDialogs": [
              "140160723"
            ]
          },
          "140160723": {
            "id": "140160723",
            "speakerId": 1075,
            "speakerName": "娜维娅",
            "text": "——总会有人为错误承担责任，越是珍视周围的人，就越不要去做错事。",
            "nextDialogs": [
              "140160724"
            ]
          },
          "140160724": {
            "id": "140160724",
            "speakerId": 1075,
            "speakerName": "娜维娅",
            "text": "因为当错误的惩罚降临时，那些人真的会不顾一切地为你挺身而出，为你付出代价…"
          },
          "140160708": {
            "id": "140160708",
            "speakerId": 1075,
            "speakerName": "娜维娅",
            "text": "哈哈，你也这么觉得吧，不管怎么样，能钓到鱼就开心。"
          }
        }
      }
    },
    {
      "subId": "1401608",
      "subQuestName": "返回灰河休息",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "140160801"
        ],
        "dialogs": {
          "140160801": {
            "id": "140160801",
            "speakerId": 13710,
            "speakerName": "马蒂纳",
            "text": "别再浪费时间了，老大耐心有限。",
            "nextDialogs": [
              "140160802"
            ]
          },
          "140160802": {
            "id": "140160802",
            "speakerId": 13710,
            "speakerName": "马蒂纳",
            "text": "明天就行动，你自求多福吧。",
            "nextDialogs": [
              "140160803"
            ]
          },
          "140160803": {
            "id": "140160803",
            "speakerId": 1075,
            "speakerName": "娜维娅",
            "text": "发条装置不会动也是因为少装了一个零件，这么想的话，好像我们也算公平？",
            "nextDialogs": [
              "140160804"
            ]
          },
          "140160804": {
            "id": "140160804",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "只讨论数量倒是没错啦…哈啊，不行了，我实在是熬不住了。",
            "nextDialogs": [
              "140160805"
            ]
          },
          "140160805": {
            "id": "140160805",
            "speakerId": 1075,
            "speakerName": "娜维娅",
            "text": "哈哈哈，快去休息吧，今天我玩得很开心！",
            "nextDialogs": [
              "140160806"
            ]
          },
          "140160806": {
            "id": "140160806",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "明天见，娜维娅。",
            "nextDialogs": [
              "140160807"
            ]
          },
          "140160807": {
            "id": "140160807",
            "speakerId": 1075,
            "speakerName": "娜维娅",
            "text": "嗯，明天见！",
            "nextDialogs": [
              "140160808"
            ]
          },
          "140160808": {
            "id": "140160808",
            "speakerId": 1075,
            "speakerName": "娜维娅",
            "text": "怎么样，昨天睡了好觉吗？",
            "nextDialogs": [
              "140160809"
            ]
          },
          "140160809": {
            "id": "140160809",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "我梦见在和海星跳舞…应该算「还行」吧。",
            "nextDialogs": [
              "140160810"
            ]
          },
          "140160810": {
            "id": "140160810",
            "speakerId": 1075,
            "speakerName": "娜维娅",
            "text": "……",
            "nextDialogs": [
              "140160811"
            ]
          },
          "140160811": {
            "id": "140160811",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "…你从哪里学来的？",
            "nextDialogs": [
              "140160812"
            ]
          },
          "140160812": {
            "id": "140160812",
            "speakerId": 13709,
            "speakerName": "科尔特",
            "text": "哈哈，没想到你还挺幽默。",
            "nextDialogs": [
              "140160813"
            ]
          },
          "140160813": {
            "id": "140160813",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "你看，还是有人能欣赏的嘛！",
            "nextDialogs": [
              "140160814"
            ]
          },
          "140160814": {
            "id": "140160814",
            "speakerId": 1075,
            "speakerName": "娜维娅",
            "text": "那我们走吧，回白淞镇就坐船好了，我来安排。阿黛尔应该也想和你们见一面。",
            "nextDialogs": [
              "140160815"
            ]
          },
          "140160815": {
            "id": "140160815",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "希望她喜欢你给她准备的礼物。",
            "nextDialogs": [
              "140160816"
            ]
          },
          "140160816": {
            "id": "140160816",
            "speakerId": 1075,
            "speakerName": "娜维娅",
            "text": "那就最好了，嘿嘿。"
          }
        }
      }
    },
    {
      "subId": "1401699",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "140169901"
        ],
        "dialogs": {
          "140169901": {
            "id": "140169901",
            "speakerId": 1075,
            "speakerName": "娜维娅",
            "text": "收拾好了，我们继续出发吧。",
            "nextDialogs": [
              "140169902"
            ]
          },
          "140169902": {
            "id": "140169902",
            "speakerId": 1075,
            "speakerName": "娜维娅",
            "text": "阿黛尔未来的制服，我拜托了城里的老熟人订做，我们直接去取吧。",
            "nextDialogs": [
              "140169903"
            ]
          },
          "140169903": {
            "id": "140169903",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "确实有人，他们往上面去了！",
            "nextDialogs": [
              "140169904"
            ]
          },
          "140169904": {
            "id": "140169904",
            "speakerId": 1075,
            "speakerName": "娜维娅",
            "text": "别跑，给我站住！"
          }
        }
      }
    }
  ]
}
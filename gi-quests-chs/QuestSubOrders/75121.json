    {
      "subId": "7512101",
      "subQuestName": "(test)八重堂对话挂接$HIDDEN",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "751210101"
        ],
        "dialogs": {
          "751210101": {
            "id": "751210101",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "有人托我来找两本书…",
            "nextDialogs": [
              "751210102"
            ]
          },
          "751210102": {
            "id": "751210102",
            "speakerId": 1003,
            "speakerName": "Black Screen",
            "text": "你向黑田描述了茜特菈莉想要的绝版书。",
            "nextDialogs": [
              "751210103"
            ]
          },
          "751210103": {
            "id": "751210103",
            "speakerId": 3029,
            "speakerName": "黑田",
            "text": "《转生成为雷电将军，然后天下无敌》的第一版和《拜托了我的狐仙宫司》的限量精装版…",
            "nextDialogs": [
              "751210104"
            ]
          },
          "751210104": {
            "id": "751210104",
            "speakerId": 3029,
            "speakerName": "黑田",
            "text": "不得不说，你的这位朋友真的很专业，谈到收藏价值，目前八重堂发行的书籍都比不上这两本。",
            "nextDialogs": [
              "751210105"
            ]
          },
          "751210105": {
            "id": "751210105",
            "speakerId": 3029,
            "speakerName": "黑田",
            "text": "这样的读者我竟然不认识，真是遗憾…",
            "nextDialogs": [
              "751210106"
            ]
          },
          "751210106": {
            "id": "751210106",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "现在还能找到吗？",
            "nextDialogs": [
              "751210107"
            ]
          },
          "751210107": {
            "id": "751210107",
            "speakerId": 3029,
            "speakerName": "黑田",
            "text": "无论哪一本，都不可能再从市面上找到了，库存更不用说，早就被抢购光了。",
            "nextDialogs": [
              "751210108"
            ]
          },
          "751210108": {
            "id": "751210108",
            "speakerId": 3029,
            "speakerName": "黑田",
            "text": "不过，我这里刚好各有一本…",
            "nextDialogs": [
              "751210109"
            ]
          },
          "751210109": {
            "id": "751210109",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "我可以花钱买。",
            "nextDialogs": [
              "751210110"
            ]
          },
          "751210110": {
            "id": "751210110",
            "speakerId": 3029,
            "speakerName": "黑田",
            "text": "不不，这两本藏书还是在你那位朋友手里更能体现它们的价值。",
            "nextDialogs": [
              "751210111"
            ]
          },
          "751210111": {
            "id": "751210111",
            "speakerId": 3029,
            "speakerName": "黑田",
            "text": "就让我把它们作为礼物送给你吧。"
          }
        }
      }
    },

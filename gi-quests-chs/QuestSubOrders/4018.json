  "subQuests": [
    {
      "subId": "401801",
      "subQuestName": "起床与派蒙对话",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "40180101"
        ],
        "dialogs": {
          "40180101": {
            "id": "40180101",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "我们已经调查了两种「隐秘规矩」了，没想到这座监狱里有这么多…奇奇怪怪的事情。",
            "nextDialogs": [
              "40180102"
            ]
          },
          "40180102": {
            "id": "40180102",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "最好还是加快调查的脚步吧，不然总感觉没完没了。",
            "nextDialogs": [
              "40180103"
            ]
          },
          "40180103": {
            "id": "40180103",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "花特许券免除劳务，然后去调查吧。",
            "nextDialogs": [
              "40180104"
            ]
          },
          "40180104": {
            "id": "40180104",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "嗯！先不去打工啦，我们抓紧时间！"
          }
        }
      }
    },
    {
      "subId": "401802",
      "subQuestName": "继续找人询问线索",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "40181301"
        ],
        "dialogs": {
          "40181301": {
            "id": "40181301",
            "speakerId": 1001,
            "speakerName": "维多克",
            "text": "哟，这个时间见到你，说明已经攒了不少特许券，都舍得拿来免除劳务了嘛，看来你们适应得不错。",
            "nextDialogs": [
              "40181304"
            ]
          },
          "40181304": {
            "id": "40181304",
            "speakerId": 1001,
            "speakerName": "维多克",
            "text": "了不起…了不起…",
            "nextDialogs": [
              "40181305"
            ]
          },
          "40181305": {
            "id": "40181305",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "现在可以告诉我们你所知道的「隐秘规矩」了吗？",
            "nextDialogs": [
              "40181306"
            ]
          },
          "40181306": {
            "id": "40181306",
            "speakerId": 1001,
            "speakerName": "维多克",
            "text": "的确是好时机啊，刚刚好。",
            "nextDialogs": [
              "40181307"
            ]
          },
          "40181307": {
            "id": "40181307",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "怎么了，什么好时机？",
            "nextDialogs": [
              "40181308"
            ]
          },
          "40181308": {
            "id": "40181308",
            "speakerId": 1001,
            "speakerName": "维多克",
            "text": "莱奥尼德他们那几个惹人讨厌的穷鬼都不在，跑到生产区打工去了，这么秘密的情报我可不想让他们占了便宜。",
            "nextDialogs": [
              "40181309"
            ]
          },
          "40181309": {
            "id": "40181309",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "好啦你快说啊…",
            "nextDialogs": [
              "40181310"
            ]
          },
          "40181310": {
            "id": "40181310",
            "speakerId": 1001,
            "speakerName": "维多克",
            "text": "千万…千万不要在半夜来到发出怪声的管道附近，就算你躲过了看守，也可能会撞上更加可怕的东西…",
            "nextDialogs": [
              "40181311"
            ]
          },
          "40181311": {
            "id": "40181311",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "更加可怕的东西…会是什么？",
            "nextDialogs": [
              "40181312"
            ]
          },
          "40181312": {
            "id": "40181312",
            "speakerId": 1001,
            "speakerName": "维多克",
            "text": "「食人族的集会」。",
            "nextDialogs": [
              "40181313"
            ]
          },
          "40181313": {
            "id": "40181313",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "「食人族」？？在梅洛彼得堡？",
            "nextDialogs": [
              "40181314"
            ]
          },
          "40181314": {
            "id": "40181314",
            "speakerId": 1001,
            "speakerName": "维多克",
            "text": "他们每个月都会有几次半夜期间的集会，传闻中在梅洛彼得堡失踪的人都与他们有关。",
            "nextDialogs": [
              "40181315"
            ]
          },
          "40181315": {
            "id": "40181315",
            "speakerId": 1001,
            "speakerName": "维多克",
            "text": "更可怕的是，他们还有一种特殊的癖好…",
            "nextDialogs": [
              "40181316"
            ]
          },
          "40181316": {
            "id": "40181316",
            "speakerId": 1001,
            "speakerName": "维多克",
            "text": "受害者剩下的血和肉，因为无法处理，会被他们想办法转化为各种形式，永远留在梅洛彼得堡。",
            "nextDialogs": [
              "40181317"
            ]
          },
          "40181317": {
            "id": "40181317",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "我想，我们可能见过你所说的「各种形式」…原来真相是这样，我、我胃里好像有东西在翻腾…"
          }
        }
      }
    },

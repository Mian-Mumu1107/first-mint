    {
      "subId": "401813",
      "subQuestName": "询问经常在一起的三个人",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "40181201"
        ],
        "dialogs": {
          "40181201": {
            "id": "40181201",
            "speakerId": 1002,
            "speakerName": "普里耶",
            "text": "……",
            "nextDialogs": [
              "40181202"
            ]
          },
          "40181202": {
            "id": "40181202",
            "speakerId": 1002,
            "speakerName": "普里耶",
            "text": "离我远点。"
          }
        }
      }
    },
    {
      "subId": "401811",
      "subQuestName": "询问经常在一起的三个人",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "40180201"
        ],
        "dialogs": {
          "40180201": {
            "id": "40180201",
            "speakerId": 1003,
            "speakerName": "莱奥尼德",
            "text": "…你们在说什么，我劝你们别多管闲事。"
          }
        }
      }
    },
    {
      "subId": "401812",
      "subQuestName": "询问经常在一起的三个人",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "40181101"
        ],
        "dialogs": {
          "40181101": {
            "id": "40181101",
            "speakerId": 1004,
            "speakerName": "亚历克塞",
            "text": "你们什么意思！？别在我面前提这种莫名其妙的东西。"
          }
        }
      }
    },
    {
      "subId": "401814",
      "subQuestName": "",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "40181401"
        ],
        "dialogs": {
          "40181401": {
            "id": "40181401",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "我们已经调查了两种「隐秘规矩」了，没想到这座监狱里有这么多…奇奇怪怪的事情。",
            "nextDialogs": [
              "40181402"
            ]
          },
          "40181402": {
            "id": "40181402",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "最好还是加快调查的脚步吧，不然总感觉没完没了。",
            "nextDialogs": [
              "40181403"
            ]
          },
          "40181403": {
            "id": "40181403",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "可是我的特许券不够了。",
            "nextDialogs": [
              "40181404"
            ]
          },
          "40181404": {
            "id": "40181404",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "欸，居然全都用掉了吗？",
            "nextDialogs": [
              "40181405"
            ]
          },
          "40181405": {
            "id": "40181405",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "唔…好吧，我其实偷偷藏了一些特许券，本来想换点梅洛彼得堡的特产什么的，还是都贡献出来好了！",
            "nextDialogs": [
              "40181406"
            ]
          },
          "40181406": {
            "id": "40181406",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "你的特许券哪里来的…",
            "nextDialogs": [
              "40181407"
            ]
          },
          "40181407": {
            "id": "40181407",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "我明明也有在工作的呀，只是赚得很少罢了…",
            "nextDialogs": [
              "40181408"
            ]
          },
          "40181408": {
            "id": "40181408",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "好啦，总之就拿这些钱免除劳务吧，我们抓紧时间去调查！"
          }
        }
      }
    },
    {
      "subId": "401803",
      "subQuestName": "根据情报进行总结",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "40180301"
        ],
        "dialogs": {
          "40180301": {
            "id": "40180301",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "他们几个的态度，有点奇怪，好像在躲着我们…",
            "nextDialogs": [
              "40180304"
            ]
          },
          "40180304": {
            "id": "40180304",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "但是…这么明显的不自然，难道是为了引我们上钩？",
            "nextDialogs": [
              "40180305"
            ]
          },
          "40180305": {
            "id": "40180305",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "不行，越想越恐怖了…"
          }
        }
      }
    },
    {
      "subId": "401806",
      "subQuestName": "询问监舍区守卫",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "40180601"
        ],
        "dialogs": {
          "40180601": {
            "id": "40180601",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "你好呀，菲尔汀先生。",
            "nextDialogs": [
              "40180602"
            ]
          },
          "40180602": {
            "id": "40180602",
            "speakerId": 1005,
            "speakerName": "菲尔汀",
            "text": "干什么？身为犯人不好好赚特许券，找我做什么？",
            "nextDialogs": [
              "40180603"
            ]
          },
          "40180603": {
            "id": "40180603",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "想问一点简单的问题…",
            "nextDialogs": [
              "40180604"
            ]
          },
          "40180604": {
            "id": "40180604",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "您晚上巡逻的时候有发现过什么吗？",
            "nextDialogs": [
              "40180605"
            ]
          },
          "40180605": {
            "id": "40180605",
            "speakerId": 1005,
            "speakerName": "菲尔汀",
            "text": "怎么关心起这个，不管晚上发生什么，都不是你们该操心的事吧，只管睡你们的觉就好了。",
            "nextDialogs": [
              "40180606"
            ]
          },
          "40180606": {
            "id": "40180606",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "啊…这个…",
            "nextDialogs": [
              "40180609"
            ]
          },
          "40180609": {
            "id": "40180609",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "对，对的，就是一个月有那么几次吧，搞得我睡不好觉，我的耳朵很敏感的！",
            "nextDialogs": [
              "40180610"
            ]
          },
          "40180610": {
            "id": "40180610",
            "speakerId": 1005,
            "speakerName": "菲尔汀",
            "text": "还有这种事？嗯…不过我也不是每天晚上都值班的。",
            "nextDialogs": [
              "40180611"
            ]
          },
          "40180611": {
            "id": "40180611",
            "speakerId": 1005,
            "speakerName": "菲尔汀",
            "text": "这么说来，也的确听同事提起过，「管道清洁日」的晚上容易有怪事发生，很多人都不乐意在那几天值班。",
            "nextDialogs": [
              "40180612"
            ]
          },
          "40180612": {
            "id": "40180612",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "「管道清洁日」是干什么的？",
            "nextDialogs": [
              "40180613"
            ]
          },
          "40180613": {
            "id": "40180613",
            "speakerId": 1005,
            "speakerName": "菲尔汀",
            "text": "就是梅洛彼得堡排水设施进行定期清洁的日子。",
            "nextDialogs": [
              "40180614"
            ]
          },
          "40180614": {
            "id": "40180614",
            "speakerId": 1005,
            "speakerName": "菲尔汀",
            "text": "每个月有三天…好像今天正巧就是其中的一天吧，你们可以确认一下，如果情况属实我可以替你们向上级汇报。",
            "nextDialogs": [
              "40180615"
            ]
          },
          "40180615": {
            "id": "40180615",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "啊，好的，我们今晚会注意的。",
            "nextDialogs": [
              "40180616"
            ]
          },
          "40180616": {
            "id": "40180616",
            "speakerId": 1005,
            "speakerName": "菲尔汀",
            "text": "那没什么事的话我就走了，我奉劝你们别动什么歪心思，即便今晚我不值班，也会有人盯着你们的。",
            "nextDialogs": [
              "40180617"
            ]
          },
          "40180617": {
            "id": "40180617",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "放心吧，我们绝对不想增加刑期的！",
            "nextDialogs": [
              "40180618"
            ]
          },
          "40180618": {
            "id": "40180618",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "#他走了，关于「管道清洁日」…{NICKNAME}你怎么看？"
          }
        }
      }
    },
    {
      "subId": "401807",
      "subQuestName": "回到监舍区，休息到夜间",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "40180701"
        ],
        "dialogs": {
          "40180701": {
            "id": "40180701",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "好困好累…可是还不能睡吧？今晚就是管道清洁日的夜晚，重要的调查时间…",
            "nextDialogs": [
              "40180704"
            ]
          },
          "40180704": {
            "id": "40180704",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "是啊，如果我睡着了的话，你可要记得叫我，我怕你一个人出事…",
            "nextDialogs": [
              "40180705"
            ]
          },
          "40180705": {
            "id": "40180705",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "#嗯？{NICKNAME}？不会吧，你这就睡着了？{NICKNAME}？",
            "nextDialogs": [
              "40180706"
            ]
          },
          "40180706": {
            "id": "40180706",
            "speakerId": 1006,
            "speakerName": "Black Screen",
            "text": "「有什么东西在呼唤我，我必须去。」",
            "nextDialogs": [
              "40180707"
            ]
          },
          "40180707": {
            "id": "40180707",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "#{NICKNAME}！不能再睡啦！快醒醒！"
          }
        }
      }
    },
    {
      "subId": "401816",
      "subQuestName": "前往传闻中的管道处",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [],

    {
      "subId": "7330501",
      "subQuestName": "(test)隐藏 7个棋子全激活$HIDDEN",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "733050101"
        ],
        "dialogs": {
          "733050101": {
            "id": "733050101",
            "speakerId": 17013,
            "speakerName": "利露帕尔",
            "text": "…小心，在地下深处，有奇特的震动。",
            "nextDialogs": [

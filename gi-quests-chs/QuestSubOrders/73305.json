    {
      "subId": "7330522",
      "subQuestName": "与利露帕尔对话",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "733052201"
        ],
        "dialogs": {
          "733052201": {
            "id": "733052201",
            "speakerId": 20846,
            "speakerName": "利露帕尔",
            "text": "请将我与那座「棋子」相连吧。",
            "nextDialogs": [
              "733052202"
            ]
          },
          "733052202": {
            "id": "733052202",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "相…相连…？那是什么意思…",
            "nextDialogs": [
              "733052203"
            ]
          },
          "733052203": {
            "id": "733052203",
            "speakerId": 20846,
            "speakerName": "利露帕尔",
            "text": "从它的表面找到突出物，然后插入我瓶子的插槽里，就这么简单。",
            "nextDialogs": [
              "733052204"
            ]
          },
          "733052204": {
            "id": "733052204",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "欸…还有那种东西吗？你的瓶子看起来明明挺光滑的…也没有能插的地方呀！",
            "nextDialogs": [
              "733052205"
            ]
          },
          "733052205": {
            "id": "733052205",
            "speakerId": 20846,
            "speakerName": "利露帕尔",
            "text": "你看不到而已。",
            "nextDialogs": [
              "733052206"
            ]
          },
          "733052206": {
            "id": "733052206",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "哦…",
            "nextDialogs": [
              "733052207"
            ]
          },
          "733052207": {
            "id": "733052207",
            "speakerId": 20846,
            "speakerName": "利露帕尔",
            "text": "因为是我刚刚胡编的。",
            "nextDialogs": [
              "733052208"
            ]
          },
          "733052208": {
            "id": "733052208",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "哦…喂——！",
            "nextDialogs": [
              "733052209"
            ]
          },
          "733052209": {
            "id": "733052209",
            "speakerId": 20846,
            "speakerName": "利露帕尔",
            "text": "噗…好了，不开玩笑了。我的大人，您只需要带着我，接触那座「棋子」即可。"
          }
        }
      }
    },
    {

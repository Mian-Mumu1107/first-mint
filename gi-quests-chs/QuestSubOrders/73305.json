    {
      "subId": "7330504",
      "subQuestName": "与利露帕尔对话",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "733050401"
        ],
        "dialogs": {
          "733050401": {
            "id": "733050401",
            "speakerId": 20846,
            "speakerName": "利露帕尔",
            "text": "……",
            "nextDialogs": [
              "733050402"
            ]
          },
          "733050402": {
            "id": "733050402",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "唔…利露帕尔，你还好吗？怎么突然没反应啦…？",
            "nextDialogs": [
              "733050405"
            ]
          },
          "733050405": {
            "id": "733050405",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "等等，你看…她在发光呢。和平时不太一样…",
            "nextDialogs": [
              "733050406"
            ]
          },
          "733050406": {
            "id": "733050406",
            "speakerId": 1002,
            "speakerName": "Black Screen",
            "text": "镇灵的魔瓶微微闪光，似乎与「棋子」的振动同调。\\n你听到时间在流逝，就像监牢中的水滴声…似乎长达一生，又或短则一瞬。\\n而利露帕尔没有说话。",
            "nextDialogs": [
              "733050407"
            ]
          },
          "733050407": {
            "id": "733050407",
            "speakerId": 1002,
            "speakerName": "Black Screen",
            "text": "然后，迷雾中你看到了那座巨城，庞大、臃肿而冷漠。\\n大地张开裂口，吞没了居尔城的一切…\\n而它的城门就在那里，镶嵌在山壁之上，它如此丑陋，仿佛集聚了古老世界的一切污秽，却免于为众目所观…",
            "nextDialogs": [
              "733050408"
            ]
          },
          "733050408": {
            "id": "733050408",
            "speakerId": 20846,
            "speakerName": "利露帕尔",
            "text": "它在那里，居尔城。我记起来了。",
            "nextDialogs": [
              "733050409"
            ]
          },
          "733050409": {
            "id": "733050409",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "我的头好痛…",
            "nextDialogs": [
              "733050410"
            ]
          },
          "733050410": {
            "id": "733050410",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "呜哇，你们怎么回事啦…下次再这样提前通知我呀！不要总是吓我一跳！"
          }
        }
      }
    },
    {
      "subId": "7330505",
      "subQuestName": "接触「棋子」",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "733050501"
        ],
        "dialogs": {
          "733050501": {
            "id": "733050501",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "呜哇！刚刚我们还在「棋子」旁边，「唰——」的一下就到这里啦！",
            "nextDialogs": [
              "733050502"
            ]
          },
          "733050502": {
            "id": "733050502",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "这是怎么回事呀，好厉害！",
            "nextDialogs": [
              "733050503"
            ]
          },
          "733050503": {
            "id": "733050503",
            "speakerId": 20846,
            "speakerName": "利露帕尔",
            "text": "呵呵，还想再来一遍吗？",
            "nextDialogs": [
              "733050505",
              "733050507"
            ]
          },
          "733050505": {
            "id": "733050505",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "收敛点啦！你是小孩子吗！",
            "nextDialogs": [
              "733050508"
            ]
          },
          "733050508": {
            "id": "733050508",
            "speakerId": 20846,
            "speakerName": "利露帕尔",
            "text": "很正常，坐标偏转了。可能是因为老化的原因…",
            "nextDialogs": [
              "733050509"
            ]
          },
          "733050509": {
            "id": "733050509",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "欸…这不是我们最初来过的那座峡谷吗？你带我们来这里干什么呀？这里有什么值得一看的东西吗？",
            "nextDialogs": [
              "733050510"
            ]
          },
          "733050510": {
            "id": "733050510",
            "speakerId": 20846,
            "speakerName": "利露帕尔",
            "text": "问题太多了，小家伙。",
            "nextDialogs": [
              "733050511"
            ]
          },
          "733050511": {
            "id": "733050511",
            "speakerId": 20846,
            "speakerName": "利露帕尔",
            "text": "奇怪…应该就在这里的…啊，在这！"
          },
          "733050507": {
            "id": "733050507",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "唔…这么说来，我也有点晕晕的…"
          }
        }
      }
    },

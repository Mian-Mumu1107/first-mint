    {
      "subId": "7330507",
      "subQuestName": "打开居尔城的大门",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "733050701"
        ],
        "dialogs": {
          "733050701": {
            "id": "733050701",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "哇……",
            "nextDialogs": [
              "733050702"
            ]
          },
          "733050702": {
            "id": "733050702",
            "speakerId": 17013,
            "speakerName": "利露帕尔",
            "text": "沉入大地裂口的居尔城，如今重现在您的面前。",
            "nextDialogs": [
              "733050703"
            ]
          },
          "733050703": {
            "id": "733050703",
            "speakerId": 17013,
            "speakerName": "利露帕尔",
            "text": "哦…看来这里又被另一批住民占据了，除掉它们吧，我的大人。"
          }
        }
      }
    },
    {
      "subId": "7330513",
      "subQuestName": "击败元能构装体",
      "sceneId": null,
      "locations": [],

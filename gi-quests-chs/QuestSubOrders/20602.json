        "dialogs": {
          "206020501": {
            "id": "206020501",
            "speakerId": 1000,
            "speakerName": "塞琉斯",
            "text": "你回来了，情况怎么样？",
            "nextDialogs": [
              "206020502"
            ]
          },
          "206020502": {
            "id": "206020502",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "魔物似乎还在活跃…",
            "nextDialogs": [
              "206020503"
            ]
          },
          "206020503": {
            "id": "206020503",
            "speakerId": 1000,
            "speakerName": "塞琉斯",
            "text": "居然还有魔物在周围活跃吗？看来那场风暴的影响还远没有消散…",
            "nextDialogs": [
              "206020504"
            ]
          },
          "206020504": {
            "id": "206020504",
            "speakerId": 1000,
            "speakerName": "塞琉斯",
            "text": "哈哈哈，还有机会！还有机会让人们感受到冒险家协会的力量。",
            "nextDialogs": [
              "206020505"
            ]
          },
          "206020505": {
            "id": "206020505",
            "speakerId": 1000,
            "speakerName": "塞琉斯",
            "text": "西风骑士团依旧在专注于防守城内和蒙德城附近，看来野外的这些魔物，还是得我们冒险家协会出手了。",
            "nextDialogs": [
              "206020506"
            ]
          },
          "206020506": {
            "id": "206020506",
            "speakerId": 1000,
            "speakerName": "塞琉斯",
            "text": "我知道了，谢谢你帮忙调查，我会重新考虑发布的委托，这些东西请收下吧。"
          }
        }
      }
    },

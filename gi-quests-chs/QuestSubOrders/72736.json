          },
          "727360102": {
            "id": "727360102",
            "speakerId": 1000,
            "speakerName": "「花角玉将」",
            "text": "真没想到，荒泷派居然能打败这么多斗虫强者。看来你们对斗虫也有着独特的理解…",
            "nextDialogs": [
              "727360103"
            ]
          },
          "727360103": {
            "id": "727360103",
            "speakerId": 1000,
            "speakerName": "「花角玉将」",
            "text": "我收回之前的成见。接下来，我会将你们当成值得尊敬的对手，全力和你们比试一场！",
            "nextDialogs": [
              "727360104"
            ]
          },
          "727360104": {
            "id": "727360104",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "放牛的，到你这个老大登场的时候啦！",
            "nextDialogs": [
              "727360105"
            ]
          },
          "727360105": {
            "id": "727360105",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "可别把之前的话当真！",
            "nextDialogs": [
              "727360108"
            ]
          },
          "727360108": {
            "id": "727360108",
            "speakerId": 1002,
            "speakerName": "荒泷一斗",
            "text": "哈哈哈哈哈哈哈，那是当然了！最后对决，也一定会是我赢！",
            "nextDialogs": [
              "727360109"
            ]
          },
          "727360109": {
            "id": "727360109",
            "speakerId": 1002,
            "speakerName": "荒泷一斗",
            "text": "虽然不知道你到底是怎么指导部下的，但结果已经没有悬念了，是本大爷的荒泷派更胜一筹！",
            "nextDialogs": [
              "727360110"
            ]
          },
          "727360110": {
            "id": "727360110",
            "speakerId": 1002,
            "speakerName": "荒泷一斗",
            "text": "准备接招吧！「花角玉将」！"
          }
        }
      }
    },
    {

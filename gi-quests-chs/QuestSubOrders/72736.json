              "727360205"
            ]
          },
          "727360205": {
            "id": "727360205",
            "speakerId": 1002,
            "speakerName": "荒泷一斗",
            "text": "不过…看穿本大爷斗虫的秘技？你可别痴心妄想啊！",
            "nextDialogs": [
              "727360206"
            ]
          },
          "727360206": {

        "dialogs": {
          "756730101": {
            "id": "756730101",
            "speakerId": 1000,
            "speakerName": "班尼特",
            "text": "看来，调色家阿夏已经心满意足了…",
            "nextDialogs": [
              "756730102"
            ]
          },
          "756730102": {
            "id": "756730102",
            "speakerId": 1000,
            "speakerName": "班尼特",
            "text": "我们成功帮助神奇的阿夏，完成了又一个特别的挑战！",
            "nextDialogs": [
              "756730103"
            ]
          },
          "756730103": {
            "id": "756730103",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "好耶，收集颜料大成功~",
            "nextDialogs": [
              "756730104"
            ]
          },
          "756730104": {
            "id": "756730104",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "这只阿夏是马上就来灵感了嘛，等不及要去作画？",
            "nextDialogs": [
              "756730107"
            ]
          },
          "756730107": {
            "id": "756730107",
            "speakerId": 1000,
            "speakerName": "班尼特",
            "text": "#啊，它还留下了不少自己收集的财宝呢…都给{NICKNAME}和派蒙当辛苦费才对！",
            "nextDialogs": [
              "756730108"
            ]
          },
          "756730108": {
            "id": "756730108",
            "speakerId": 1000,
            "speakerName": "班尼特",
            "text": "说不定，过段时间我们再来，就能看见调色家阿夏的新杰作了。",
            "nextDialogs": [
              "756730109"
            ]
          },
          "756730109": {
            "id": "756730109",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "普通的阿夏就能喷出很好看的色彩了，这种特别的阿夏，会有多厉害呢。",
            "nextDialogs": [
              "756730110"
            ]
          },
          "756730110": {
            "id": "756730110",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "哎呀，感觉已经开始期待了，说不定真能被它们调出什么…一般语言形容不出来的…",
            "nextDialogs": [
              "756730111"
            ]
          },
          "756730111": {
            "id": "756730111",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "燃素啊，月亮啊，星空深处的颜色？",
            "nextDialogs": [
              "756730112"
            ]
          },
          "756730112": {
            "id": "756730112",
            "speakerId": 1000,
            "speakerName": "班尼特",
            "text": "对嘛，在冒险过程中，只要遇见了遭遇困难的生灵，就尽可能给对方最真诚的帮助…",
            "nextDialogs": [
              "756730113"
            ]
          },
          "756730113": {
            "id": "756730113",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "嗯嗯！说不定哪天，还能得到意想不到的回报呢！"
          }
        }
      }
    }

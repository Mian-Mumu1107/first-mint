{
  "lineCounts": {
    "Player": 7,
    "布洛克": 12,
    "杜拉夫": 12,
    "派蒙": 8,
    "香菱": 21
  },
  "subQuests": [
    {
      "subId": "1100101",
      "subQuestName": "陪香菱去清泉镇",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [],
        "dialogs": {}
      }
    },
    {
      "subId": "1100102",
      "subQuestName": "向杜拉夫道歉",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "110010201"
        ],
        "dialogs": {
          "110010201": {
            "id": "110010201",
            "speakerId": 1537,
            "speakerName": "杜拉夫",
            "text": "你就是香菱，是吧？",
            "nextDialogs": [
              "110010202"
            ]
          },
          "110010202": {
            "id": "110010202",
            "speakerId": 1012,
            "speakerName": "香菱",
            "text": "对不起，杜拉夫先生，是我的不对。",
            "nextDialogs": [
              "110010203"
            ]
          },
          "110010203": {
            "id": "110010203",
            "speakerId": 1537,
            "speakerName": "杜拉夫",
            "text": "你做的那些事我都听说了。既然你人都来了——",
            "nextDialogs": [
              "110010204"
            ]
          },
          "110010204": {
            "id": "110010204",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "好、好可怕！",
            "nextDialogs": [
              "110010207"
            ]
          },
          "110010207": {
            "id": "110010207",
            "speakerId": 1537,
            "speakerName": "杜拉夫",
            "text": "——请帮帮我们推广我们的肉产品吧！",
            "nextDialogs": [
              "110010208"
            ]
          },
          "110010208": {
            "id": "110010208",
            "speakerId": 1012,
            "speakerName": "香菱",
            "text": "…啊？",
            "nextDialogs": [
              "110010209"
            ]
          },
          "110010209": {
            "id": "110010209",
            "speakerId": 1537,
            "speakerName": "杜拉夫",
            "text": "不好意思，唐突了点，我这就跟你们解释。",
            "nextDialogs": [
              "110010210"
            ]
          },
          "110010210": {
            "id": "110010210",
            "speakerId": 1537,
            "speakerName": "杜拉夫",
            "text": "清泉镇向来以高品质的肉类闻名，但它的名声不应该只局限在蒙德。",
            "nextDialogs": [
              "110010211"
            ]
          },
          "110010211": {
            "id": "110010211",
            "speakerId": 1537,
            "speakerName": "杜拉夫",
            "text": "正好我听说大厨香菱来了蒙德，我就马上叫艾伦把你请过来了。",
            "nextDialogs": [
              "110010212"
            ]
          },
          "110010212": {
            "id": "110010212",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "大厨？",
            "nextDialogs": [
              "110010213"
            ]
          },
          "110010213": {
            "id": "110010213",
            "speakerId": 1537,
            "speakerName": "杜拉夫",
            "text": "你没听过吗？在璃月港独树一帜，主打平民菜品的「万民堂」，就是香菱掌厨。",
            "nextDialogs": [
              "110010214"
            ]
          },
          "110010214": {
            "id": "110010214",
            "speakerId": 1537,
            "speakerName": "杜拉夫",
            "text": "她对食材有独特的理解，做出来的菜深受当地居民喜爱，在游客中也是好评如潮。",
            "nextDialogs": [
              "110010215"
            ]
          },
          "110010215": {
            "id": "110010215",
            "speakerId": 1012,
            "speakerName": "香菱",
            "text": "嘿嘿，说得太夸张啦。我只是想做出便宜又好吃的东西而已。",
            "nextDialogs": [
              "110010216"
            ]
          },
          "110010216": {
            "id": "110010216",
            "speakerId": 1537,
            "speakerName": "杜拉夫",
            "text": "像香菱这样一流的大厨，用一流的肉做出一流的料理，我们清泉镇的肉就能声名远扬了。",
            "nextDialogs": [
              "110010217"
            ]
          },
          "110010217": {
            "id": "110010217",
            "speakerId": 1012,
            "speakerName": "香菱",
            "text": "可是…这个请求我觉得我做不到。",
            "nextDialogs": [
              "110010218"
            ]
          },
          "110010218": {
            "id": "110010218",
            "speakerId": 1012,
            "speakerName": "香菱",
            "text": "我只考虑过怎么做出好吃的菜，没限制过食材，更没做过宣传。",
            "nextDialogs": [
              "110010219"
            ]
          },
          "110010219": {
            "id": "110010219",
            "speakerId": 1537,
            "speakerName": "杜拉夫",
            "text": "反正肉也是你想用的食材，我觉得没什么区别吧。",
            "nextDialogs": [
              "110010220"
            ]
          },
          "110010220": {
            "id": "110010220",
            "speakerId": 1012,
            "speakerName": "香菱",
            "text": "有区别，有很大的区别！比如我要加史莱姆凝液进去你会同意吗？",
            "nextDialogs": [
              "110010221"
            ]
          },
          "110010221": {
            "id": "110010221",
            "speakerId": 1537,
            "speakerName": "杜拉夫",
            "text": "这、这确实有点…不能用稍微正常一点的食材吗？",
            "nextDialogs": [
              "110010222"
            ]
          },
          "110010222": {
            "id": "110010222",
            "speakerId": 1012,
            "speakerName": "香菱",
            "text": "食材是没有正常不正常的！无论是什么只要方法得当，都能做出美味佳肴！",
            "nextDialogs": [
              "110010223"
            ]
          },
          "110010223": {
            "id": "110010223",
            "speakerId": 1012,
            "speakerName": "香菱",
            "text": "我不能让材料束缚我的灵感，那样做出来的东西注定是无聊的。"
          }
        }
      }
    },
    {
      "subId": "1100103",
      "subQuestName": "跟上打算离开的香菱",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "110010301"
        ],
        "dialogs": {
          "110010301": {
            "id": "110010301",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "其实也不用拒绝得这么坚决吧…我们不是来道歉的吗？"
          }
        }
      }
    },
    {
      "subId": "1100104",
      "subQuestName": "在香味的源头和香菱对话",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "110010401"
        ],
        "dialogs": {
          "110010401": {
            "id": "110010401",
            "speakerId": 1012,
            "speakerName": "香菱",
            "text": "你好，你做的这个料理我可以尝尝看吗？",
            "nextDialogs": [
              "110010402"
            ]
          },
          "110010402": {
            "id": "110010402",
            "speakerId": 1541,
            "speakerName": "布洛克",
            "text": "不好意思，这几天的份都预定满了，想吃的话要排到七天以后，可以吗？",
            "nextDialogs": [
              "110010403"
            ]
          },
          "110010403": {
            "id": "110010403",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "这么受欢迎啊…那一定很好吃！",
            "nextDialogs": [
              "110010404"
            ]
          },
          "110010404": {
            "id": "110010404",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "奇怪，明明有这么受欢迎的厨师…",
            "nextDialogs": [
              "110010405"
            ]
          },
          "110010405": {
            "id": "110010405",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "对哦，为什么杜拉夫先生还要找香菱啊？",
            "nextDialogs": [
              "110010406"
            ]
          },
          "110010406": {
            "id": "110010406",
            "speakerId": 1541,
            "speakerName": "布洛克",
            "text": "唉…可能是他觉得蒙德比起璃月港那种全大陆的商业枢纽，口味不够大众吧。",
            "nextDialogs": [
              "110010407"
            ]
          },
          "110010407": {
            "id": "110010407",
            "speakerId": 1541,
            "speakerName": "布洛克",
            "text": "但我不服气！我从来不觉得我做出来的肉会输给谁！",
            "nextDialogs": [
              "110010408"
            ]
          },
          "110010408": {
            "id": "110010408",
            "speakerId": 1012,
            "speakerName": "香菱",
            "text": "那就破例给我露一手嘛，或许我还能提一些建议什么的。",
            "nextDialogs": [
              "110010409"
            ]
          },
          "110010409": {
            "id": "110010409",
            "speakerId": 1541,
            "speakerName": "布洛克",
            "text": "普通人只会说「好吃」之类没用的话，你又不是呃…等等…你就是香菱？！",
            "nextDialogs": [
              "110010410"
            ]
          },
          "110010410": {
            "id": "110010410",
            "speakerId": 1012,
            "speakerName": "香菱",
            "text": "嗯，对啊。",
            "nextDialogs": [
              "110010411"
            ]
          },
          "110010411": {
            "id": "110010411",
            "speakerId": 1541,
            "speakerName": "布洛克",
            "text": "原来就是你！那你一定也很会做肉了。",
            "nextDialogs": [
              "110010412"
            ]
          },
          "110010412": {
            "id": "110010412",
            "speakerId": 1541,
            "speakerName": "布洛克",
            "text": "其实我这里还留了一块今天最好的肉，如果让你来做烤肉，你会怎么做？",
            "nextDialogs": [
              "110010413"
            ]
          },
          "110010413": {
            "id": "110010413",
            "speakerId": 1012,
            "speakerName": "香菱",
            "text": "那要看肉质和脂肪含量了，这块肉我应该会岩烤，搭配海盐，绝云椒椒和清心花。",
            "nextDialogs": [
              "110010414"
            ]
          },
          "110010414": {
            "id": "110010414",
            "speakerId": 1541,
            "speakerName": "布洛克",
            "text": "清心花？！它遇热油香味会大量释放，比生冷时浓郁好几倍，肉的香味都会被盖掉的！",
            "nextDialogs": [
              "110010415"
            ]
          },
          "110010415": {
            "id": "110010415",
            "speakerId": 1012,
            "speakerName": "香菱",
            "text": "我知道的哦，但这清心花不是肉排的香料，而是配菜。",
            "nextDialogs": [
              "110010416"
            ]
          },
          "110010416": {
            "id": "110010416",
            "speakerId": 1012,
            "speakerName": "香菱",
            "text": "我尝试过，只要火候得当，过了油的清心花花瓣的苦味会被去除，变成口感爽脆的点心。",
            "nextDialogs": [
              "110010417"
            ]
          },
          "110010417": {
            "id": "110010417",
            "speakerId": 1012,
            "speakerName": "香菱",
            "text": "再选取长在高山上的绝云椒椒。低湿度和大温差，使得它能够产生特殊的干香风味。",
            "nextDialogs": [
              "110010418"
            ]
          },
          "110010418": {
            "id": "110010418",
            "speakerId": 1012,
            "speakerName": "香菱",
            "text": "海盐的咸，绝云椒椒的辣，肉排油脂的鲜香，汇聚在花瓣上，咬下去还有植物的清香。",
            "nextDialogs": [
              "110010419"
            ]
          },
          "110010419": {
            "id": "110010419",
            "speakerId": 1541,
            "speakerName": "布洛克",
            "text": "花里胡哨的，这不是喧宾夺主了吗？！",
            "nextDialogs": [
              "110010420"
            ]
          },
          "110010420": {
            "id": "110010420",
            "speakerId": 1541,
            "speakerName": "布洛克",
            "text": "烤肉就是烤肉，肉香被盖住了还吃什么？",
            "nextDialogs": [
              "110010421"
            ]
          },
          "110010421": {
            "id": "110010421",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "呜哇，别吵架，不要吵架啊！",
            "nextDialogs": [
              "110010424"
            ]
          },
          "110010424": {
            "id": "110010424",
            "speakerId": 1012,
            "speakerName": "香菱",
            "text": "哼，既然这样，烹饪的问题就用烹饪来解决好了！",
            "nextDialogs": [
              "110010425"
            ]
          },
          "110010425": {
            "id": "110010425",
            "speakerId": 1012,
            "speakerName": "香菱",
            "text": "我要和你切磋厨艺！",
            "nextDialogs": [
              "110010426"
            ]
          },
          "110010426": {
            "id": "110010426",
            "speakerId": 1541,
            "speakerName": "布洛克",
            "text": "完全没问题，要是连我的料理都比不过，那就证明杜拉夫是看走眼了。",
            "nextDialogs": [
              "110010427"
            ]
          },
          "110010427": {
            "id": "110010427",
            "speakerId": 1012,
            "speakerName": "香菱",
            "text": "好啊，那这样吧，如果我赢了，我获胜的料理就用来宣传清泉镇！",
            "nextDialogs": [
              "110010428"
            ]
          },
          "110010428": {
            "id": "110010428",
            "speakerId": 1541,
            "speakerName": "布洛克",
            "text": "你输了的话，就在「万民堂」的菜单上加上我的这道菜。",
            "nextDialogs": [
              "110010429"
            ]
          },
          "110010429": {
            "id": "110010429",
            "speakerId": 1541,
            "speakerName": "布洛克",
            "text": "上面还要写上，清泉镇肉类大师布洛克之作。",
            "nextDialogs": [
              "110010430"
            ]
          },
          "110010430": {
            "id": "110010430",
            "speakerId": 1012,
            "speakerName": "香菱",
            "text": "一言为定！",
            "nextDialogs": [
              "110010431"
            ]
          },
          "110010431": {
            "id": "110010431",
            "speakerId": 1012,
            "speakerName": "香菱",
            "text": "我先走一步去找食材了！在璃月等你们！",
            "nextDialogs": [
              "110010432"
            ]
          },
          "110010432": {
            "id": "110010432",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "喂，等等啊！",
            "nextDialogs": [
              "110010433"
            ]
          },
          "110010433": {
            "id": "110010433",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "#{NICKNAME}，只能跟上去了。"
          }
        }
      }
    }
  ]
}
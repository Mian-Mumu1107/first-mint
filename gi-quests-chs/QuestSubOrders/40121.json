  },
  "subQuests": [
    {
      "subId": "4012101",
      "subQuestName": "",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "401002601"
        ],
        "dialogs": {
          "401002601": {
            "id": "401002601",
            "speakerId": 1000,
            "speakerName": "艾尔海森",
            "text": "看来已经有第三位参赛者带回了迅捷飞蝶。",
            "nextDialogs": [
              "401002602"
            ]
          },
          "401002602": {
            "id": "401002602",
            "speakerId": 1000,
            "speakerName": "艾尔海森",
            "text": "第一轮比赛到此结束，希望各位第二轮再接再厉。好了，解散。",
            "nextDialogs": [
              "401002603"
            ]
          },
          "401002603": {
            "id": "401002603",
            "speakerId": 1001,
            "speakerName": "妮露",
            "text": "呃、呃啊，艾尔海森先生的结束语还是那么果断…",
            "nextDialogs": [
              "401002604"
            ]
          },
          "401002604": {
            "id": "401002604",
            "speakerId": 1000,
            "speakerName": "艾尔海森",
            "text": "你也可以参考这种作风获得更自在的生活，妮露小姐。",
            "nextDialogs": [
              "401002605"
            ]
          },
          "401002605": {
            "id": "401002605",
            "speakerId": 1002,
            "speakerName": "派蒙",
            "text": "等一下！前两名是谁？",
            "nextDialogs": [
              "401002606"
            ]
          },
          "401002606": {
            "id": "401002606",
            "speakerId": 1001,
            "speakerName": "妮露",
            "text": "第一名是提纳里先生。第二名…还在商量。",
            "nextDialogs": [
              "401002607"
            ]
          },
          "401002607": {
            "id": "401002607",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "还在商量？",
            "nextDialogs": [
              "401002608"
            ]
          },
          "401002608": {
            "id": "401002608",
            "speakerId": 1003,
            "speakerName": "卡维",
            "text": "喂，艾尔海森，刚刚我想到一个好办法。",
            "nextDialogs": [
              "401002609"
            ]
          },
          "401002609": {
            "id": "401002609",
            "speakerId": 1003,
            "speakerName": "卡维",
            "text": "第二名不是可以获得两点积分吗？我和珐露珊前辈平分不就好了？",
            "nextDialogs": [
              "401002610"
            ]
          },
          "401002610": {
            "id": "401002610",
            "speakerId": 1000,
            "speakerName": "艾尔海森",
            "text": "佩服你的想象力，争霸赛手册从头到尾都没有这条规则。",
            "nextDialogs": [
              "401002611"
            ]
          },
          "401002611": {
            "id": "401002611",
            "speakerId": 1003,
            "speakerName": "卡维",
            "text": "那就现在加一条。",
            "nextDialogs": [
              "401002612"
            ]
          },
          "401002612": {
            "id": "401002612",
            "speakerId": 1000,
            "speakerName": "艾尔海森",
            "text": "你觉得我可能这样做吗？",
            "nextDialogs": [
              "401002613"
            ]
          },
          "401002613": {
            "id": "401002613",
            "speakerId": 1003,
            "speakerName": "卡维",
            "text": "你总不会阻挠我夺冠吧？",
            "nextDialogs": [
              "401002614"
            ]
          },
          "401002614": {
            "id": "401002614",
            "speakerId": 1000,
            "speakerName": "艾尔海森",
            "text": "你可以将你天真的想法落实成书面申请交给赛事委员会，他们三个工作日内就会给出答复。",
            "nextDialogs": [
              "401002615"
            ]
          },
          "401002615": {
            "id": "401002615",
            "speakerId": 1003,
            "speakerName": "卡维",
            "text": "那也太晚了吧！",
            "nextDialogs": [
              "401002616"
            ]
          },
          "401002616": {
            "id": "401002616",
            "speakerId": 1000,
            "speakerName": "艾尔海森",
            "text": "没办法，做梦也是要花时间的。",
            "nextDialogs": [
              "401002617"
            ]
          },
          "401002617": {
            "id": "401002617",
            "speakerId": 1002,
            "speakerName": "派蒙",
            "text": "我听明白了。原来第二只迅捷飞蝶是卡维与珐露珊一起找到的。但是比赛规定只能有一个人拿到积分…",
            "nextDialogs": [
              "401002618"
            ]
          },
          "401002618": {
            "id": "401002618",
            "speakerId": 1004,
            "speakerName": "珐露珊",
            "text": "没办法。看在你尊称我为前辈、虚心向我请教过的份上，这次的分数就让给你吧。",
            "nextDialogs": [
              "401002619"
            ]
          },
          "401002619": {
            "id": "401002619",
            "speakerId": 1001,
            "speakerName": "妮露",
            "text": "那我就将分数记在卡维先生身上了？",
            "nextDialogs": [
              "401002620"
            ]
          },
          "401002620": {
            "id": "401002620",
            "speakerId": 1003,
            "speakerName": "卡维",
            "text": "不行。如果我拿走积分，不就意味着珐露珊前辈的功劳完全被抹掉了吗？",
            "nextDialogs": [
              "401002621"
            ]
          },
          "401002621": {
            "id": "401002621",
            "speakerId": 1003,
            "speakerName": "卡维",
            "text": "前辈也许觉得无所谓，但我不能就这么心安理得地接受。",
            "nextDialogs": [
              "401002622"
            ]
          },
          "401002622": {
            "id": "401002622",
            "speakerId": 1004,
            "speakerName": "珐露珊",
            "text": "其实我倒是不在意，反正还有两场比赛，就算先失一局也没关系。",
            "nextDialogs": [
              "401002623"
            ]
          },
          "401002623": {
            "id": "401002623",
            "speakerId": 1004,
            "speakerName": "珐露珊",
            "text": "不过既然你这么坚持，我也有个办法：我们抽签来决定积分归谁吧。",
            "nextDialogs": [
              "401002624"
            ]
          },
          "401002624": {
            "id": "401002624",
            "speakerId": 1003,
            "speakerName": "卡维",
            "text": "抽，抽签吗…",
            "nextDialogs": [
              "401002625"
            ]
          },
          "401002625": {
            "id": "401002625",
            "speakerId": 1004,
            "speakerName": "珐露珊",
            "text": "有什么问题吗？",
            "nextDialogs": [
              "401002626"
            ]
          },
          "401002626": {
            "id": "401002626",
            "speakerId": 1003,
            "speakerName": "卡维",
            "text": "…没事，就用这个方法吧。",
            "nextDialogs": [
              "401002627"
            ]
          },
          "401002627": {
            "id": "401002627",
            "speakerId": 1001,
            "speakerName": "妮露",
            "text": "那我来制作抽签要用的纸团吧，请稍等。",
            "nextDialogs": [
              "401002628"
            ]
          },
          "401002628": {
            "id": "401002628",
            "speakerId": 1005,
            "speakerName": "Black Screen",
            "text": "在大家的见证下，卡维在抽签中光荣落败。",
            "nextDialogs": [
              "401002629"
            ]
          },
          "401002629": {
            "id": "401002629",
            "speakerId": 1003,
            "speakerName": "卡维",
            "text": "唉…这真是…",
            "nextDialogs": [
              "401002630"
            ]
          },
          "401002630": {
            "id": "401002630",
            "speakerId": 1004,
            "speakerName": "珐露珊",
            "text": "抱歉了，后辈，看来运气还是站在我这边呢。",
            "nextDialogs": [
              "401002631"
            ]
          },
          "401002631": {
            "id": "401002631",
            "speakerId": 1003,
            "speakerName": "卡维",
            "text": "这是前辈应得的…我只是在感慨自己的运气不好…唉，可能就是因为这样，生活中才会有很多烦恼吧。",
            "nextDialogs": [
              "401002632"
            ]
          },
          "401002632": {
            "id": "401002632",
            "speakerId": 1000,
            "speakerName": "艾尔海森",
            "text": "确实很少见到运气不好还愿意用抽签定胜负的人。",
            "nextDialogs": [
              "401002633"
            ]
          },
          "401002633": {
            "id": "401002633",
            "speakerId": 1003,
            "speakerName": "卡维",
            "text": "你懂什么？我只是…",
            "nextDialogs": [
              "401002634"
            ]
          },
          "401002634": {
            "id": "401002634",
            "speakerId": 1000,
            "speakerName": "艾尔海森",
            "text": "辩论以后再说。分数记在珐露珊身上，这样第一轮比赛正式结束了。",
            "nextDialogs": [
              "401002635"
            ]
          },
          "401002635": {
            "id": "401002635",
            "speakerId": 1000,
            "speakerName": "艾尔海森",
            "text": "第二轮比赛会在沙漠中举行，到时候我们评论席也会转移到阿如村。",
            "nextDialogs": [
              "401002636"
            ]
          },
          "401002636": {
            "id": "401002636",
            "speakerId": 1000,
            "speakerName": "艾尔海森",
            "text": "等时间到了，就去阿如村集合吧，到时候我会宣布第二轮的比赛内容。",
            "nextDialogs": [
              "401002637"
            ]
          },
          "401002637": {
            "id": "401002637",
            "speakerId": 1000,
            "speakerName": "艾尔海森",
            "text": "在那之前是自由活动时间。我也下班了，再见。",
            "nextDialogs": [
              "401002638"
            ]
          },
          "401002638": {
            "id": "401002638",
            "speakerId": 1003,
            "speakerName": "卡维",
            "text": "艾尔海森！…唉！",
            "nextDialogs": [
              "401002639"
            ]
          },
          "401002639": {
            "id": "401002639",
            "speakerId": 1001,
            "speakerName": "妮露",
            "text": "卡维先生，别难过，叹气也会让运气流失哦。",
            "nextDialogs": [
              "401002640"
            ]
          },
          "401002640": {
            "id": "401002640",
            "speakerId": 1003,
            "speakerName": "卡维",
            "text": "是这样吗？那我现在深呼吸，应该能把流失的运气再补回来吧。",
            "nextDialogs": [
              "401002641"
            ]
          },
          "401002641": {
            "id": "401002641",
            "speakerId": 1003,
            "speakerName": "卡维",
            "text": "呼…也不是什么大事，不就是两点积分嘛，又不会直接决定胜负。",
            "nextDialogs": [
              "401002642"
            ]
          },
          "401002642": {
            "id": "401002642",
            "speakerId": 1003,
            "speakerName": "卡维",
            "text": "下一轮我就会赢回来的，你们好好看着吧！",
            "nextDialogs": [
              "401002643"
            ]
          },
          "401002643": {
            "id": "401002643",
            "speakerId": 1004,
            "speakerName": "珐露珊",
            "text": "看来后辈你已经振作起来了。不过沙漠那地方我可是很熟悉的，到时候可不要再输给我了。",
            "nextDialogs": [
              "401002644"
            ]
          },
          "401002644": {
            "id": "401002644",
            "speakerId": 1003,
            "speakerName": "卡维",
            "text": "沙漠我也不是第一次去，没什么的。好了，话就说到这里，我先过去熟悉一下环境。",
            "nextDialogs": [
              "401002645"
            ]
          },
          "401002645": {
            "id": "401002645",
            "speakerId": 1002,
            "speakerName": "派蒙",
            "text": "嗯…现在的排名是，提纳里第一，珐露珊第二，莱依拉第三。",
            "nextDialogs": [
              "401002646"
            ]
          },
          "401002646": {
            "id": "401002646",
            "speakerId": 1002,
            "speakerName": "派蒙",
            "text": "下一轮比赛之前，我们应该也可以好好休息一下了。先去哪里逛逛比较好呢？让我想想…",
            "nextDialogs": [
              "401002647"
            ]
          },
          "401002647": {
            "id": "401002647",
            "speakerId": 1006,
            "speakerName": "摩婕娜",
            "text": "两位好像很苦恼呀。不知道要从哪里开始逛学院庆典的话，我倒是有个好建议——去跟我们会长聊聊怎么样？",
            "nextDialogs": [
              "401002648"
            ]
          },
          "401002648": {
            "id": "401002648",
            "speakerId": 1002,
            "speakerName": "派蒙",
            "text": "咦，你说的会长是谁？我们认识吗？",
            "nextDialogs": [
              "401002649"
            ]
          },
          "401002649": {
            "id": "401002649",
            "speakerId": 1006,
            "speakerName": "摩婕娜",
            "text": "呵呵，当然是须弥最有名的商人——无人不知无人不晓的桑歌玛哈巴依老爷啦！",
            "nextDialogs": [
              "401002650"
            ]
          },
          "401002650": {
            "id": "401002650",
            "speakerId": 1002,
            "speakerName": "派蒙",
            "text": "原来是多莉！",
            "nextDialogs": [
              "401002651"
            ]
          },
          "401002651": {
            "id": "401002651",
            "speakerId": 1006,
            "speakerName": "摩婕娜",
            "text": "是呀。会长大人特地派我来通知两位，她就在须弥城北门等你们哦。"
          }
        }
      }
    },
    {
      "subId": "4012102",
      "subQuestName": "",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "401011301"
        ],
        "dialogs": {
          "401011301": {
            "id": "401011301",
            "speakerId": 1001,
            "speakerName": "妮露",
            "text": "看来第二轮比赛结束了。不知道珐露珊小姐和卡维先生谁更快一些呢？…嗯？珐露珊小姐呢？",
            "nextDialogs": [
              "401011302"
            ]
          },
          "401011302": {
            "id": "401011302",
            "speakerId": 1003,
            "speakerName": "卡维",
            "text": "珐露珊前辈去喝水了，马上就来。我们几乎是同时找到，所以想再抽一次签。",
            "nextDialogs": [
              "401011303"
            ]
          },
          "401011303": {
            "id": "401011303",
            "speakerId": 1000,
            "speakerName": "艾尔海森",
            "text": "你很容易沉迷于一些事物，比如抽签。",
            "nextDialogs": [
              "401011304"
            ]
          },
          "401011304": {
            "id": "401011304",
            "speakerId": 1003,
            "speakerName": "卡维",
            "text": "我没有沉迷！不要把运气不好说成是我自己乐意！",
            "nextDialogs": [
              "401011305"
            ]
          },
          "401011305": {
            "id": "401011305",
            "speakerId": 1000,
            "speakerName": "艾尔海森",
            "text": "是吗？那换个说法，你与抽签有着奇妙的缘分。",
            "nextDialogs": [
              "401011306"
            ]
          },
          "401011306": {
            "id": "401011306",
            "speakerId": 1001,
            "speakerName": "妮露",
            "text": "那我去准备抽签用到的盒子与纸条，两位稍等…",
            "nextDialogs": [
              "401011307"
            ]
          },
          "401011307": {
            "id": "401011307",
            "speakerId": 1003,
            "speakerName": "卡维",
            "text": "……",
            "nextDialogs": [
              "401011308"
            ]
          },
          "401011308": {
            "id": "401011308",
            "speakerId": 1004,
            "speakerName": "珐露珊",
            "text": "噢，又要抽签了呢，看看前辈我的手气。",
            "nextDialogs": [
              "401011309"
            ]
          },
          "401011309": {
            "id": "401011309",
            "speakerId": 1005,
            "speakerName": "Black Screen",
            "text": "在紧张却短暂的抽签过后，卡维顺利中签…",
            "nextDialogs": [
              "401011310"
            ]
          },
          "401011310": {
            "id": "401011310",
            "speakerId": 1003,
            "speakerName": "卡维",
            "text": "我中签了！你们看到了吗？这次是我抽中了！",
            "nextDialogs": [
              "401011311"
            ]
          },
          "401011311": {
            "id": "401011311",
            "speakerId": 1001,
            "speakerName": "妮露",
            "text": "恭喜卡维先生。",
            "nextDialogs": [
              "401011312"
            ]
          },
          "401011312": {
            "id": "401011312",
            "speakerId": 1002,
            "speakerName": "派蒙",
            "text": "卡维的运气变好了呢！",
            "nextDialogs": [
              "401011313"
            ]
          },
          "401011313": {
            "id": "401011313",
            "speakerId": 1003,
            "speakerName": "卡维",
            "text": "真是太不容易了。呜呜…",
            "nextDialogs": [
              "401011314"
            ]
          },
          "401011314": {
            "id": "401011314",
            "speakerId": 1004,
            "speakerName": "珐露珊",
            "text": "不枉你在沙漠里吃了那么多苦头呢，这次的分数就归你啦。",
            "nextDialogs": [
              "401011315"
            ]
          },
          "401011315": {
            "id": "401011315",
            "speakerId": 1000,
            "speakerName": "艾尔海森",
            "text": "……",
            "nextDialogs": [
              "401011316"
            ]
          },
          "401011316": {
            "id": "401011316",
            "speakerId": 1001,
            "speakerName": "妮露",
            "text": "这样完成第二轮比赛的，分别是赛诺、莱依拉、卡维三位选手。",
            "nextDialogs": [
              "401011317"
            ]
          },
          "401011317": {
            "id": "401011317",
            "speakerId": 1001,
            "speakerName": "妮露",
            "text": "目前排名的话，让我算算…",
            "nextDialogs": [
              "401011318"
            ]
          },
          "401011318": {
            "id": "401011318",
            "speakerId": 1001,
            "speakerName": "妮露",
            "text": "赛诺先生和莱依拉小姐各有4点积分，并列第一。往后依次是提纳里、珐露珊、卡维和阿帽选手。",
            "nextDialogs": [
              "401011319"
            ]
          },
          "401011319": {
            "id": "401011319",
            "speakerId": 1001,
            "speakerName": "妮露",
            "text": "下一轮比赛将会是最后一轮。在那之前，希望大家好好休息。",
            "nextDialogs": [
              "401011320"
            ]
          },
          "401011320": {
            "id": "401011320",
            "speakerId": 1001,
            "speakerName": "妮露",
            "text": "我听说学院游乐会的摊位推出了一些新的玩法，如果感兴趣的话也可以去逛逛。我们下一轮比赛再见了。"
          }
        }
      }
    },
    {
      "subId": "4012103",
      "subQuestName": "",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "401040701"
        ],
        "dialogs": {
          "401040701": {
            "id": "401040701",
            "speakerId": 1007,
            "speakerName": "卡莉娜",
            "text": "感谢每一位选手的精彩发挥，本届学院争霸赛顺利落幕！",
            "nextDialogs": [
              "401040702"
            ]
          },
          "401040702": {
            "id": "401040702",
            "speakerId": 1007,
            "speakerName": "卡莉娜",
            "text": "最后，让我们有请身为冠军的卡维选手上台领奖。",
            "nextDialogs": [
              "401040703"
            ]
          },
          "401040703": {
            "id": "401040703",
            "speakerId": 1007,
            "speakerName": "卡莉娜",
            "text": "原本在这里，我们会为卡维选手戴上冠冕、送上奖金。",
            "nextDialogs": [
              "401040704"
            ]
          },
          "401040704": {
            "id": "401040704",
            "speakerId": 1007,
            "speakerName": "卡莉娜",
            "text": "然而不久前我们刚刚得知了一个消息，卡维选手继承了萨齐因先生的产业，并将它们全部捐了出去。",
            "nextDialogs": [
              "401040705"
            ]
          },
          "401040705": {
            "id": "401040705",
            "speakerId": 1008,
            "speakerName": "玛尔瓦",
            "text": "萨齐因的产业…被捐掉了？",
            "nextDialogs": [
              "401040706"
            ]
          },
          "401040706": {
            "id": "401040706",
            "speakerId": 1009,
            "speakerName": "阿莱",
            "text": "那么多钱，他还真舍得…",
            "nextDialogs": [
              "401040707"
            ]
          },
          "401040707": {
            "id": "401040707",
            "speakerId": 1007,
            "speakerName": "卡莉娜",
            "text": "由于卡维选手的善举，许多贫困的家庭将获得改变命运的机会。",
            "nextDialogs": [
              "401040708"
            ]
          },
          "401040708": {
            "id": "401040708",
            "speakerId": 1007,
            "speakerName": "卡莉娜",
            "text": "少了冠冕与奖金，颁奖仪式也将从简。卡维选手有什么想说的话吗？我想大家肯定和我一样，很好奇你将这笔巨款捐掉的原因。",
            "nextDialogs": [
              "401040709"
            ]
          },
          "401040709": {
            "id": "401040709",
            "speakerId": 1003,
            "speakerName": "卡维",
            "text": "我…我也不确定这种场合下应该说些什么。很高兴能拿到冠军，虽然里面也有不少运气成分。",
            "nextDialogs": [
              "401040710"
            ]
          },
          "401040710": {
            "id": "401040710",
            "speakerId": 1003,
            "speakerName": "卡维",
            "text": "至于为什么要捐掉这笔钱…我不认同萨齐因的观点，也不想要他的钱。许多事必须亲身体验，他也好我也好，都没有资格做出定论。",
            "nextDialogs": [
              "401040711"
            ]
          },
          "401040711": {
            "id": "401040711",
            "speakerId": 1003,
            "speakerName": "卡维",
            "text": "不过那些说起来就太复杂沉重了，不该在这个场合展开。至于其他…其他没什么了，就这样吧，谢谢。",
            "nextDialogs": [
              "401040712"
            ]
          },
          "401040712": {
            "id": "401040712",
            "speakerId": 1007,
            "speakerName": "卡莉娜",
            "text": "啊，卡维选手，请稍等。",
            "nextDialogs": [
              "401040713"
            ]
          },
          "401040713": {
            "id": "401040713",
            "speakerId": 1007,
            "speakerName": "卡莉娜",
            "text": "虽然这次颁奖仪式少了很多内容，但还是有奖品在的。这枚限定版七圣召唤卡牌，请卡维选手收下。",
            "nextDialogs": [
              "401040714"
            ]
          },
          "401040714": {
            "id": "401040714",
            "speakerId": 1007,
            "speakerName": "卡莉娜",
            "text": "另外——冠军的荣誉，也已经记录在卡维选手的档案中了。今后卡维选手如果在教令院申请课题，贤者大人会酌情予以优待。",
            "nextDialogs": [
              "401040715"
            ]
          },
          "401040715": {
            "id": "401040715",
            "speakerId": 1003,
            "speakerName": "卡维",
            "text": "好的，我收下了。不过课题什么的…算了吧。",
            "nextDialogs": [
              "401040716"
            ]
          },
          "401040716": {
            "id": "401040716",
            "speakerId": 1007,
            "speakerName": "卡莉娜",
            "text": "那么——颁奖仪式到此结束。让我们再次将掌声送给卡维选手！",
            "nextDialogs": [
              "401040717"
            ]
          },
          "401040717": {
            "id": "401040717",
            "speakerId": 1010,
            "speakerName": "艾莎",
            "text": "果然我还是没法理解。有这么一笔钱，足够我逍遥快活一辈子了。",
            "nextDialogs": [
              "401040718"
            ]
          },
          "401040718": {
            "id": "401040718",
            "speakerId": 1011,
            "speakerName": "贝西",
            "text": "这说明你还不够奇怪，理解不了人家那种天才的想法。走，我们继续去参加学院游乐会吧！",
            "nextDialogs": [
              "401040719"
            ]
          },
          "401040719": {
            "id": "401040719",
            "speakerId": 1003,
            "speakerName": "卡维",
            "text": "呼——！终于结束了，我觉得我还挺擅长演讲的，但就是说得很疲惫…",
            "nextDialogs": [
              "401040720"
            ]
          },
          "401040720": {
            "id": "401040720",
            "speakerId": 1002,
            "speakerName": "派蒙",
            "text": "是不是比赛太累了？总觉得你看上去也不怎么高兴…不管怎么说，你现在已经是冠军啦，这不是值得骄傲的事情吗？",
            "nextDialogs": [
              "401040721"
            ]
          },
          "401040721": {
            "id": "401040721",
            "speakerId": 1003,
            "speakerName": "卡维",
            "text": "也是。唉…对了，我记得赛诺说过他想要那张限定卡牌。这东西现在在我手上哦！",
            "nextDialogs": [
              "401040722"
            ]
          },
          "401040722": {
            "id": "401040722",
            "speakerId": 1002,
            "speakerName": "派蒙",
            "text": "你打算转让给他吗？如果是很珍贵的卡牌，应该能大赚一笔吧！",
            "nextDialogs": [
              "401040723"
            ]
          },
          "401040723": {
            "id": "401040723",
            "speakerId": 1003,
            "speakerName": "卡维",
            "text": "怎么可能。卡牌放在我这里一点用都没有，不如送给他。你们要是方便的话，帮我带给他吧。",
            "nextDialogs": [
              "401040724"
            ]
          },
          "401040724": {
            "id": "401040724",
            "speakerId": 1002,
            "speakerName": "派蒙",
            "text": "喂喂，这么重要的事肯定是亲自去比较好啦！走，我们一起去找赛诺吧！",
            "nextDialogs": [
              "401040725"
            ]
          },
          "401040725": {
            "id": "401040725",
            "speakerId": 1003,
            "speakerName": "卡维",
            "text": "欸？可是我本来还想休息一会儿的…哎哎别拽我头发！"
          }
        }
      }
    }
  ]
}
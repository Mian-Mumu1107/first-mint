{
  "lineCounts": {
    "Black Screen": 2,
    "Player": 1,
    "卡维": 30,
    "卡莉娜": 10,
    "妮露": 13,
    "摩婕娜": 3,
    "派蒙": 10,
    "玛尔瓦": 1,
    "珐露珊": 8,

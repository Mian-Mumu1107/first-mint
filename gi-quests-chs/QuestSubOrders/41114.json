{
  "lineCounts": {
    "Player": 20,
    "「散兵」": 12,
    "凯瑟琳": 3,
    "奥兹": 6,
    "派蒙": 43,
    "莫娜": 48,
    "菲谢尔": 8
  },
  "subQuests": [
    {
      "subId": "4111401",
      "subQuestName": "向莫娜打听占卜的进度",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "411140101"
        ],
        "dialogs": {
          "411140101": {
            "id": "411140101",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "咦，菲谢尔在等我们吗？",
            "nextDialogs": [
              "411140102"
            ]
          },
          "411140102": {
            "id": "411140102",
            "speakerId": 1001,
            "speakerName": "奥兹",
            "text": "来得可真是时候。虽然不舍，也必须和各位说出这番话了。",
            "nextDialogs": [
              "411140103"
            ]
          },
          "411140103": {
            "id": "411140103",
            "speakerId": 1002,
            "speakerName": "菲谢尔",
            "text": "暂且与本皇女辞别吧，同行者。一路上你展现了非凡的勇气，这股嘉奖的风正是为你而起。",
            "nextDialogs": [
              "411140104"
            ]
          },
          "411140104": {
            "id": "411140104",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "哎哎哎？怎么突然道别呀？",
            "nextDialogs": [
              "411140105"
            ]
          },
          "411140105": {
            "id": "411140105",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "菲谢尔，你要走了吗？",
            "nextDialogs": [
              "411140106"
            ]
          },
          "411140106": {
            "id": "411140106",
            "speakerId": 1001,
            "speakerName": "奥兹",
            "text": "大陨石加剧了昏睡现象，连身强体壮的士兵也支撑不住。现在到处都缺乏人手。",
            "nextDialogs": [
              "411140107"
            ]
          },
          "411140107": {
            "id": "411140107",
            "speakerId": 1001,
            "speakerName": "奥兹",
            "text": "皇女与我要代替士兵看护那些患者，剩下的事就交给你们了。",
            "nextDialogs": [
              "411140108"
            ]
          },
          "411140108": {
            "id": "411140108",
            "speakerId": 1002,
            "speakerName": "菲谢尔",
            "text": "#{NICKNAME}…再见了。",
            "nextDialogs": [
              "411140109"
            ]
          },
          "411140109": {
            "id": "411140109",
            "speakerId": 1002,
            "speakerName": "菲谢尔",
            "text": "你是很好的聆听者，愿意陪我聊天。",
            "nextDialogs": [
              "411140110"
            ]
          },
          "411140110": {
            "id": "411140110",
            "speakerId": 1002,
            "speakerName": "菲谢尔",
            "text": "平时，即使在协会里，许多冒险家愿意跟我搭档，也只是为了从我的话里听出奥兹侦察的结果而已…",
            "nextDialogs": [
              "411140111"
            ]
          },
          "411140111": {
            "id": "411140111",
            "speakerId": 1002,
            "speakerName": "菲谢尔",
            "text": "这次的一小段旅途，是一场很好的冒险。突然说要走，我也…",
            "nextDialogs": [
              "411140112"
            ]
          },
          "411140112": {
            "id": "411140112",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "咦？菲谢尔的说话方式，是不是有点不像平常的那种…？",
            "nextDialogs": [
              "411140113"
            ]
          },
          "411140113": {
            "id": "411140113",
            "speakerId": 1002,
            "speakerName": "菲谢尔",
            "text": "！！！",
            "nextDialogs": [
              "411140114"
            ]
          },
          "411140114": {
            "id": "411140114",
            "speakerId": 1002,
            "speakerName": "菲谢尔",
            "text": "（啊——啊啊啊刚才不小心出神了…！）",
            "nextDialogs": [
              "411140115"
            ]
          },
          "411140115": {
            "id": "411140115",
            "speakerId": 1001,
            "speakerName": "奥兹",
            "text": "小，小姐的意思是…你们是如此勇敢，又有常人难及的智慧，任何谜题在你们面前都会化为乌有！",
            "nextDialogs": [
              "411140116"
            ]
          },
          "411140116": {
            "id": "411140116",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "怎么这次奥兹「翻译」的方向完全反过来了。",
            "nextDialogs": [
              "411140117"
            ]
          },
          "411140117": {
            "id": "411140117",
            "speakerId": 1001,
            "speakerName": "奥兹",
            "text": "咳，咳咳…小姐想说，如果是你们几位，一定可以抵达幻象背后的真相。",
            "nextDialogs": [
              "411140118"
            ]
          },
          "411140118": {
            "id": "411140118",
            "speakerId": 1002,
            "speakerName": "菲谢尔",
            "text": "咳咳…唔，没错。你们是皇女的扈从。断罪的骑士，你要带领他们走出黑暗，回归光明之地。",
            "nextDialogs": [
              "411140119"
            ]
          },
          "411140119": {
            "id": "411140119",
            "speakerId": 1003,
            "speakerName": "莫娜",
            "text": "谁是你的扈从啊…",
            "nextDialogs": [
              "411140120"
            ]
          },
          "411140120": {
            "id": "411140120",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "奥兹，菲谢尔，谢谢你们。",
            "nextDialogs": [
              "411140121"
            ]
          },
          "411140121": {
            "id": "411140121",
            "speakerId": 1001,
            "speakerName": "奥兹",
            "text": "还会再见的，等一切结束，再约着喝杯酒吧。",
            "nextDialogs": [
              "411140122"
            ]
          },
          "411140122": {
            "id": "411140122",
            "speakerId": 1003,
            "speakerName": "莫娜",
            "text": "哎，可惜了两个好帮手。",
            "nextDialogs": [
              "411140123"
            ]
          },
          "411140123": {
            "id": "411140123",
            "speakerId": 1003,
            "speakerName": "莫娜",
            "text": "别愁眉苦脸的，说个好消息吧，我有新发现了。",
            "nextDialogs": [
              "411140124"
            ]
          },
          "411140124": {
            "id": "411140124",
            "speakerId": 1003,
            "speakerName": "莫娜",
            "text": "我从大陨石上刮来一些粉末帮助占卜，卓有成效哦！",
            "nextDialogs": [
              "411140125"
            ]
          },
          "411140125": {
            "id": "411140125",
            "speakerId": 1003,
            "speakerName": "莫娜",
            "text": "这些坠落的石头已经存在成百上千年，莱纳德应该是很久之前的人了。",
            "nextDialogs": [
              "411140126"
            ]
          },
          "411140126": {
            "id": "411140126",
            "speakerId": 1003,
            "speakerName": "莫娜",
            "text": "陨石传递着他的意志，也就是说，千百年来他的愿望一直没有减弱。",
            "nextDialogs": [
              "411140127"
            ]
          },
          "411140127": {
            "id": "411140127",
            "speakerId": 1003,
            "speakerName": "莫娜",
            "text": "一个热切渴望登上山顶的古人…我敢断定，他和你一样，也是冒险家。",
            "nextDialogs": [
              "411140128"
            ]
          },
          "411140128": {
            "id": "411140128",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "冒险家？难怪这么想爬上雪山！",
            "nextDialogs": [
              "411140129"
            ]
          },
          "411140129": {
            "id": "411140129",
            "speakerId": 1003,
            "speakerName": "莫娜",
            "text": "目前的办法几乎是跟时间赛跑，我们很被动。必须转换思路，从根本上解决问题。",
            "nextDialogs": [
              "411140130"
            ]
          },
          "411140130": {
            "id": "411140130",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "我支持！我认为现在应该把重心放在莱纳德身上！",
            "nextDialogs": [
              "411140131"
            ]
          },
          "411140131": {
            "id": "411140131",
            "speakerId": 1003,
            "speakerName": "莫娜",
            "text": "嗯…如果陨石承载了某种愿望，那这些石头就正如菲谢尔所说，算是某种形式的「诅咒」…",
            "nextDialogs": [
              "411140132"
            ]
          },
          "411140132": {
            "id": "411140132",
            "speakerId": 1003,
            "speakerName": "莫娜",
            "text": "真难得，她蒙对了…咳咳，算了，优雅的占星术士不该这样评价别人。",
            "nextDialogs": [
              "411140133"
            ]
          },
          "411140133": {
            "id": "411140133",
            "speakerId": 1003,
            "speakerName": "莫娜",
            "text": "总之，我们只要去解开诅咒就好。",
            "nextDialogs": [
              "411140134"
            ]
          },
          "411140134": {
            "id": "411140134",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "现在就出发吧，派蒙。",
            "nextDialogs": [
              "411140135"
            ]
          },
          "411140135": {
            "id": "411140135",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "好！",
            "nextDialogs": [
              "411140136"
            ]
          },
          "411140136": {
            "id": "411140136",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "既然要调查从前的冒险家，就该从<color=#00E1FFFF>冒险家协会</color>入手！"
          }
        }
      }
    },
    {
      "subId": "4111407",
      "subQuestName": "询问蒙德的凯瑟琳",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "411140701"
        ],
        "dialogs": {
          "411140701": {
            "id": "411140701",
            "speakerId": 1004,
            "speakerName": "凯瑟琳",
            "text": "叫这个名字的冒险家有好几个，我也不敢断论。",
            "nextDialogs": [
              "411140702"
            ]
          },
          "411140702": {
            "id": "411140702",
            "speakerId": 1004,
            "speakerName": "凯瑟琳",
            "text": "但我有印象看过叫这个名字的人写的书，不如去图书馆看看吧？",
            "nextDialogs": [
              "411140703"
            ]
          },
          "411140703": {
            "id": "411140703",
            "speakerId": 1004,
            "speakerName": "凯瑟琳",
            "text": "但我记得，有一本作者名叫莱纳德的书，你们不如去<color=#00E1FFFF>图书馆</color>看看吧？"
          }
        }
      }
    },
    {
      "subId": "4111408",
      "subQuestName": "前往蒙德图书馆寻找线索",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "411140801"
        ],
        "dialogs": {
          "411140801": {
            "id": "411140801",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "作者，莱纳德…莱纳德…有了！",
            "nextDialogs": [
              "411140802"
            ]
          },
          "411140802": {
            "id": "411140802",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "索引上说，莱纳德的冒险家手册在图书馆<color=#00E1FFFF>一楼</color>的<color=#00E1FFFF>西北角</color>。",
            "nextDialogs": [
              "411140803"
            ]
          },
          "411140803": {
            "id": "411140803",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "西北角…应该就是那边吧！"
          }
        }
      }
    },
    {
      "subId": "4111403",
      "subQuestName": "查看丽莎桌前的索引目录",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [],
        "dialogs": {}
      }
    },
    {
      "subId": "4111414",
      "subQuestName": "(test)与派蒙对话$HIDDEN",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [],
        "dialogs": {}
      }
    },
    {
      "subId": "4111404",
      "subQuestName": "搜寻莱纳德的著作",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [],
        "dialogs": {}
      }
    },
    {
      "subId": "4111405",
      "subQuestName": "(test)与派蒙对话$HIDDEN",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "411141401"
        ],
        "dialogs": {
          "411141401": {
            "id": "411141401",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "找到了！冒险家手册《山与海之书》，作者莱纳德！",
            "nextDialogs": [
              "411141402"
            ]
          },
          "411141402": {
            "id": "411141402",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "可是，这本书居然缺字少页，根本看不懂！",
            "nextDialogs": [
              "411141403"
            ]
          },
          "411141403": {
            "id": "411141403",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "怎么这样，呜…该不会白来了吧…",
            "nextDialogs": [
              "411141404"
            ]
          },
          "411141404": {
            "id": "411141404",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "别放弃，拿给莫娜看看。",
            "nextDialogs": [
              "411141405"
            ]
          },
          "411141405": {
            "id": "411141405",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "啊，对哦，说不定她有办法。"
          }
        }
      }
    },
    {
      "subId": "4111409",
      "subQuestName": "将莱纳德的著作带给莫娜",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "411140901"
        ],
        "dialogs": {
          "411140901": {
            "id": "411140901",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "找到他的书了！",
            "nextDialogs": [
              "411140902"
            ]
          },
          "411140902": {
            "id": "411140902",
            "speakerId": 1003,
            "speakerName": "莫娜",
            "text": "快给我看看！",
            "nextDialogs": [
              "411140903"
            ]
          },
          "411140903": {
            "id": "411140903",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "内容有缺损，完全不连贯。",
            "nextDialogs": [
              "411140904"
            ]
          },
          "411140904": {
            "id": "411140904",
            "speakerId": 1003,
            "speakerName": "莫娜",
            "text": "哼哼，我就知道会这样。",
            "nextDialogs": [
              "411140905"
            ]
          },
          "411140905": {
            "id": "411140905",
            "speakerId": 1003,
            "speakerName": "莫娜",
            "text": "如果是一般的占星术士，多半已经投降了！",
            "nextDialogs": [
              "411140906"
            ]
          },
          "411140906": {
            "id": "411140906",
            "speakerId": 1003,
            "speakerName": "莫娜",
            "text": "但我莫娜可是未来的占星术第一人，没有什么东西能难倒我。",
            "nextDialogs": [
              "411140907"
            ]
          },
          "411140907": {
            "id": "411140907",
            "speakerId": 1003,
            "speakerName": "莫娜",
            "text": "用星盘推算缺漏的部分填入其中，再进行解读…",
            "nextDialogs": [
              "411140908"
            ]
          },
          "411140908": {
            "id": "411140908",
            "speakerId": 1003,
            "speakerName": "莫娜",
            "text": "呼——！终于看完了…",
            "nextDialogs": [
              "411140909"
            ]
          },
          "411140909": {
            "id": "411140909",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "说了什么呀！",
            "nextDialogs": [
              "411140910"
            ]
          },
          "411140910": {
            "id": "411140910",
            "speakerId": 1003,
            "speakerName": "莫娜",
            "text": "和我想的一样，莱纳德是一名两千年前的冒险家。",
            "nextDialogs": [
              "411140911"
            ]
          },
          "411140911": {
            "id": "411140911",
            "speakerId": 1003,
            "speakerName": "莫娜",
            "text": "他毕生的梦想就是登上一座名叫「尖帽子峰」的雪山。",
            "nextDialogs": [
              "411140912"
            ]
          },
          "411140912": {
            "id": "411140912",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "两千年？这些陨石是…古代人的「命之座」？！",
            "nextDialogs": [
              "411140913"
            ]
          },
          "411140913": {
            "id": "411140913",
            "speakerId": 1003,
            "speakerName": "莫娜",
            "text": "他的命之座由于某种原因被召唤到大地上。关于这点，我认为和愚人众有关。",
            "nextDialogs": [
              "411140914"
            ]
          },
          "411140914": {
            "id": "411140914",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "同意，稀奇古怪的事情就数他们干得最多。",
            "nextDialogs": [
              "411140915"
            ]
          },
          "411140915": {
            "id": "411140915",
            "speakerId": 1003,
            "speakerName": "莫娜",
            "text": "这些陨石内含元素力，以一种精神暗示的方式辐射了周围居民，使他们陷入梦境。",
            "nextDialogs": [
              "411140916"
            ]
          },
          "411140916": {
            "id": "411140916",
            "speakerId": 1003,
            "speakerName": "莫娜",
            "text": "另外如果我猜得没错，这批陨石中应该有一颗类似核心的存在，是莱纳德精神的结晶。",
            "nextDialogs": [
              "411140917"
            ]
          },
          "411140917": {
            "id": "411140917",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "它会在哪里呢？",
            "nextDialogs": [
              "411140918"
            ]
          },
          "411140918": {
            "id": "411140918",
            "speakerId": 1003,
            "speakerName": "莫娜",
            "text": "如果我是莱纳德，这颗核心一定会按我所想，从空中抵达生前没能登上的山顶。",
            "nextDialogs": [
              "411140919"
            ]
          },
          "411140919": {
            "id": "411140919",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "核心会在尖帽子峰吗？可是…尖帽子峰在哪里呀？我都没听说过这个地方。",
            "nextDialogs": [
              "411140920"
            ]
          },
          "411140920": {
            "id": "411140920",
            "speakerId": 1003,
            "speakerName": "莫娜",
            "text": "我也是第一次知道。对比书中地图与现在的蒙德地形，我发现，尖帽子峰已经不存在了。",
            "nextDialogs": [
              "411140921"
            ]
          },
          "411140921": {
            "id": "411140921",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "那么大一座雪山也会消失吗？！",
            "nextDialogs": [
              "411140922"
            ]
          },
          "411140922": {
            "id": "411140922",
            "speakerId": 1003,
            "speakerName": "莫娜",
            "text": "我在书上读到过，风神巴巴托斯为了他的人民，曾经动用神力吹散冰雪，也改变了蒙德的地貌。",
            "nextDialogs": [
              "411140923"
            ]
          },
          "411140923": {
            "id": "411140923",
            "speakerId": 1003,
            "speakerName": "莫娜",
            "text": "过去的山峰被一望无垠的大海取代了。但若将那座山放入海中，以它曾经的高度，还是会留下一些痕迹的。",
            "nextDialogs": [
              "411140924"
            ]
          },
          "411140924": {
            "id": "411140924",
            "speakerId": 1003,
            "speakerName": "莫娜",
            "text": "——峰顶露出水面的部分，如今叫做…",
            "nextDialogs": [
              "411140925"
            ]
          },
          "411140925": {
            "id": "411140925",
            "speakerId": 1003,
            "speakerName": "莫娜",
            "text": "<color=#00E1FFFF>「马斯克礁」</color>。"
          }
        }
      }
    },
    {
      "subId": "4111410",
      "subQuestName": "根据书中提示，前往马斯克礁",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [],
        "dialogs": {}
      }
    },
    {
      "subId": "4111411",
      "subQuestName": "(test)与散兵对话$HIDDEN",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "411141101"
        ],
        "dialogs": {
          "411141101": {
            "id": "411141101",
            "speakerId": 1003,
            "speakerName": "莫娜",
            "text": "哦？这就是从前的尖帽子峰吗？变得好小呢。",
            "nextDialogs": [
              "411141102"
            ]
          },
          "411141102": {
            "id": "411141102",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "哎，有人先到了？这里是什么观光景点吗？",
            "nextDialogs": [
              "411141103"
            ]
          },
          "411141103": {
            "id": "411141103",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "啊！是你！",
            "nextDialogs": [
              "411141104"
            ]
          },
          "411141104": {
            "id": "411141104",
            "speakerId": 1005,
            "speakerName": "「散兵」",
            "text": "唔…嗯？是你们？",
            "nextDialogs": [
              "411141107"
            ]
          },
          "411141107": {
            "id": "411141107",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "他这个样子，难道是刚从梦境里出来？",
            "nextDialogs": [
              "411141108"
            ]
          },
          "411141108": {
            "id": "411141108",
            "speakerId": 1003,
            "speakerName": "莫娜",
            "text": "竟然有人能凭自己的力量苏醒过来…怎么可能？",
            "nextDialogs": [
              "411141109"
            ]
          },
          "411141109": {
            "id": "411141109",
            "speakerId": 1005,
            "speakerName": "「散兵」",
            "text": "哼，你们做不到，不代表我也做不到。",
            "nextDialogs": [
              "411141110"
            ]
          },
          "411141110": {
            "id": "411141110",
            "speakerId": 1005,
            "speakerName": "「散兵」",
            "text": "你们来晚了一步，我的「研究」已经完成了。",
            "nextDialogs": [
              "411141111"
            ]
          },
          "411141111": {
            "id": "411141111",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "果然这一切都是你们愚人众搞的花样吗？！",
            "nextDialogs": [
              "411141112"
            ]
          },
          "411141112": {
            "id": "411141112",
            "speakerId": 1005,
            "speakerName": "「散兵」",
            "text": "别那么紧张，我今天没时间陪你们玩。下回再找你的麻烦也不迟。",
            "nextDialogs": [
              "411141113"
            ]
          },
          "411141113": {
            "id": "411141113",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "等等！你到底有什么目的！",
            "nextDialogs": [
              "411141114"
            ]
          },
          "411141114": {
            "id": "411141114",
            "speakerId": 1003,
            "speakerName": "莫娜",
            "text": "你刚才进入了那个众人共通的雪山梦境吧？你对莱纳德的事知道多少？",
            "nextDialogs": [
              "411141115"
            ]
          },
          "411141115": {
            "id": "411141115",
            "speakerId": 1005,
            "speakerName": "「散兵」",
            "text": "莱纳德？什么莱纳德…哼，不管了，现在可不是关心杂鱼的时候。",
            "nextDialogs": [
              "411141116"
            ]
          },
          "411141116": {
            "id": "411141116",
            "speakerId": 1005,
            "speakerName": "「散兵」",
            "text": "我发现了…更可怕、更重要的事呀。",
            "nextDialogs": [
              "411141117"
            ]
          },
          "411141117": {
            "id": "411141117",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "嗯？",
            "nextDialogs": [
              "411141118"
            ]
          },
          "411141118": {
            "id": "411141118",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "是什么？",
            "nextDialogs": [
              "411141119"
            ]
          },
          "411141119": {
            "id": "411141119",
            "speakerId": 1005,
            "speakerName": "「散兵」",
            "text": "星空本身，就是个巨大的谎言。",
            "nextDialogs": [
              "411141120"
            ]
          },
          "411141120": {
            "id": "411141120",
            "speakerId": 1003,
            "speakerName": "莫娜",
            "text": "星空…谎言？这是什么意思？",
            "nextDialogs": [
              "411141121"
            ]
          },
          "411141121": {
            "id": "411141121",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "是想反驳莫娜的什么占星术理论吗？那也不用说「星空本身是谎言」吧。",
            "nextDialogs": [
              "411141122"
            ]
          },
          "411141122": {
            "id": "411141122",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "在夜里，抬头往天上看，不就能直接看到星星吗？这种常识…",
            "nextDialogs": [
              "411141123"
            ]
          },
          "411141123": {
            "id": "411141123",
            "speakerId": 1005,
            "speakerName": "「散兵」",
            "text": "哈…哈哈哈哈哈哈！还在说这种天真的话！",
            "nextDialogs": [
              "411141124"
            ]
          },
          "411141124": {
            "id": "411141124",
            "speakerId": 1005,
            "speakerName": "「散兵」",
            "text": "不过，这也不是你的错，因为直到不久之前，我也是这样相信的…",
            "nextDialogs": [
              "411141125"
            ]
          },
          "411141125": {
            "id": "411141125",
            "speakerId": 1003,
            "speakerName": "莫娜",
            "text": "直到刚才？你是指…",
            "nextDialogs": [
              "411141126"
            ]
          },
          "411141126": {
            "id": "411141126",
            "speakerId": 1005,
            "speakerName": "「散兵」",
            "text": "哼，我可没空再陪你们探讨这些了。",
            "nextDialogs": [
              "411141127"
            ]
          },
          "411141127": {
            "id": "411141127",
            "speakerId": 1005,
            "speakerName": "「散兵」",
            "text": "「丑角」那家伙…把这种任务交给我，居然不事先预警可能的「发现」…是想故意吓我一跳吗？！",
            "nextDialogs": [
              "411141128"
            ]
          },
          "411141128": {
            "id": "411141128",
            "speakerId": 1005,
            "speakerName": "「散兵」",
            "text": "我现在必须去确认「真相」。那么，再见了，菜鸟们！"
          }
        }
      }
    },
    {
      "subId": "4111412",
      "subQuestName": "击败散兵的手下",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [],
        "dialogs": {}
      }
    },
    {
      "subId": "4111415",
      "subQuestName": "(test)战斗后的对话$HIDDEN",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "411141501"
        ],
        "dialogs": {
          "411141501": {
            "id": "411141501",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "真是一场恶战啊！",
            "nextDialogs": [
              "411141502"
            ]
          },
          "411141502": {
            "id": "411141502",
            "speakerId": 1003,
            "speakerName": "莫娜",
            "text": "这就是惹恼我的下场！",
            "nextDialogs": [
              "411141503"
            ]
          },
          "411141503": {
            "id": "411141503",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "莫娜真厉害。",
            "nextDialogs": [
              "411141504"
            ]
          },
          "411141504": {
            "id": "411141504",
            "speakerId": 1003,
            "speakerName": "莫娜",
            "text": "当然了！派蒙，你也觉得我很厉害对吧？对吧对吧？",
            "nextDialogs": [
              "411141505"
            ]
          },
          "411141505": {
            "id": "411141505",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "是啊是啊，没有莫娜，我们恐怕会陷入更大的麻烦。",
            "nextDialogs": [
              "411141506"
            ]
          },
          "411141506": {
            "id": "411141506",
            "speakerId": 1003,
            "speakerName": "莫娜",
            "text": "哼，听见没有！愚人众执行官！坏男人！",
            "nextDialogs": [
              "411141507"
            ]
          },
          "411141507": {
            "id": "411141507",
            "speakerId": 1003,
            "speakerName": "莫娜",
            "text": "不过看他刚才那么震惊的样子，也不像在撒谎。难道师父教导我占星术时所说的「虚假之天」还有其他含义？",
            "nextDialogs": [
              "411141508"
            ]
          },
          "411141508": {
            "id": "411141508",
            "speakerId": 1003,
            "speakerName": "莫娜",
            "text": "啊…咳咳，我走神了。那么，去完成我们最重要的工作吧。",
            "nextDialogs": [
              "411141509"
            ]
          },
          "411141509": {
            "id": "411141509",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "<color=#00E1FFFF>陨石的核心</color>，一定就在这里附近！"
          }
        }
      }
    },
    {
      "subId": "4111413",
      "subQuestName": "销毁陨石核心",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [],
        "dialogs": {}
      }
    },
    {
      "subId": "4111416",
      "subQuestName": "(test)摧毁陨石后的对话$HIDDEN",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "411141601"
        ],
        "dialogs": {
          "411141601": {
            "id": "411141601",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "哇，这就是核心吗，和其他陨石不太一样呢！有种…明亮的感觉？",
            "nextDialogs": [
              "411141602"
            ]
          },
          "411141602": {
            "id": "411141602",
            "speakerId": 1003,
            "speakerName": "莫娜",
            "text": "这块石头上有着惊人的元素力和意念。确实是核心没错。",
            "nextDialogs": [
              "411141603"
            ]
          },
          "411141603": {
            "id": "411141603",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "我们…应该破坏它吗？",
            "nextDialogs": [
              "411141604"
            ]
          },
          "411141604": {
            "id": "411141604",
            "speakerId": 1003,
            "speakerName": "莫娜",
            "text": "嗯，不把它清理掉，人们就不会醒来……这块核心就是一切事件的根源。",
            "nextDialogs": [
              "411141605"
            ]
          },
          "411141605": {
            "id": "411141605",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "#{NICKNAME}，加油啊！",
            "nextDialogs": [
              "411141606"
            ]
          },
          "411141606": {
            "id": "411141606",
            "speakerId": 1003,
            "speakerName": "莫娜",
            "text": "没想到，原来是这么一回事…",
            "nextDialogs": [
              "411141609"
            ]
          },
          "411141609": {
            "id": "411141609",
            "speakerId": 1003,
            "speakerName": "莫娜",
            "text": "人类的信念，竟然可以在天空中留存千年…",
            "nextDialogs": [
              "411141610"
            ]
          },
          "411141610": {
            "id": "411141610",
            "speakerId": 1003,
            "speakerName": "莫娜",
            "text": "哎，果然占星学是个厉害的东西呀！",
            "nextDialogs": [
              "411141611"
            ]
          },
          "411141611": {
            "id": "411141611",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "为什么突然说到这上面去了？",
            "nextDialogs": [
              "411141612"
            ]
          },
          "411141612": {
            "id": "411141612",
            "speakerId": 1003,
            "speakerName": "莫娜",
            "text": "能和星星交流，就能掌握从古到今所有秘密，当然啦，能做到这种事的占星术士除了我也没有几个。",
            "nextDialogs": [
              "411141613"
            ]
          },
          "411141613": {
            "id": "411141613",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "莫娜，这次太谢谢你了。",
            "nextDialogs": [
              "411141614"
            ]
          },
          "411141614": {
            "id": "411141614",
            "speakerId": 1003,
            "speakerName": "莫娜",
            "text": "干、干嘛啊，突然这么认真…",
            "nextDialogs": [
              "411141615"
            ]
          },
          "411141615": {
            "id": "411141615",
            "speakerId": 1003,
            "speakerName": "莫娜",
            "text": "话说回来，那个叫菲谢尔的女孩子，还真是神奇。",
            "nextDialogs": [
              "411141616"
            ]
          },
          "411141616": {
            "id": "411141616",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "我也觉得！她明明…呃…怎么说呢…"
          }
        }
      }
    },

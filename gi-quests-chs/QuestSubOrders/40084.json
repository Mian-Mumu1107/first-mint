    {
      "subId": "4008404",
      "subQuestName": "击败对手",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "400840401"
        ],
        "dialogs": {
          "400840401": {
            "id": "400840401",
            "speakerId": 12861,
            "speakerName": "铁骨双刀",
            "text": "是你们，见识浅薄的鼠辈。",
            "nextDialogs": [
              "400840402"
            ]
          },
          "400840402": {
            "id": "400840402",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "好大的口气！凭什么这么说！",
            "nextDialogs": [
              "400840403"
            ]
          },
          "400840403": {
            "id": "400840403",
            "speakerId": 12861,
            "speakerName": "铁骨双刀",
            "text": "对蕈兽投入多余的情感，何其软弱，何其可笑！这有悖于最强的驯兽师，海妮耶大人的理念。",
            "nextDialogs": [
              "400840404"
            ]
          },
          "400840404": {
            "id": "400840404",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "最强的驯兽师…",
            "nextDialogs": [
              "400840405"
            ]
          },
          "400840405": {
            "id": "400840405",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "我们会纠正海妮耶的想法。",
            "nextDialogs": [
              "400840406"
            ]
          },
          "400840406": {
            "id": "400840406",
            "speakerId": 12861,
            "speakerName": "铁骨双刀",
            "text": "别妄想了！软弱之人没有资格和海妮耶大人对阵，你们会止步于此！"
          }
        }
      }
    },
    {
      "subId": "4008405",
      "subQuestName": "击败对手",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [],
        "dialogs": {}
      }
    },
    {
      "subId": "4008414",
      "subQuestName": "与对手对话",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "400841401"
        ],
        "dialogs": {
          "400841401": {
            "id": "400841401",
            "speakerId": 12861,
            "speakerName": "铁骨双刀",
            "text": "不可能！这绝无可能…难道是我对蕈兽的训练还不够严格吗？",
            "nextDialogs": [
              "400841402"
            ]
          },
          "400841402": {
            "id": "400841402",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "唔…虽然打败了他，但总感觉高兴不起来呢。"
          }
        }
      }
    },
    {
      "subId": "4008402",
      "subQuestName": "离开赛场",

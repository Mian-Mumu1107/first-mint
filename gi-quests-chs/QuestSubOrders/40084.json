    {
      "subId": "4008415",
      "subQuestName": "与派蒙进行讨论",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "400841501"
        ],
        "dialogs": {
          "400841501": {
            "id": "400841501",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "结果还是失败了，只有在赛场上打败海妮耶这一个选择了…",
            "nextDialogs": [
              "400841504"
            ]
          },
          "400841504": {
            "id": "400841504",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "海妮耶好像说过，以前也有学者尝试遏制蕈兽造成的灾害？这本笔记还有不少内容，我们再好好读一读吧。",
            "nextDialogs": [
              "400841506"
            ]
          },
          "400841506": {
            "id": "400841506",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "这是海妮耶的祖辈收集的…学者们的研究记录？",
            "nextDialogs": [
              "400841507"
            ]
          },
          "400841507": {
            "id": "400841507",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "唔，这部分的内容好复杂，字迹潦草，还有很多术语，怎么想都看不懂吧…",
            "nextDialogs": [
              "400841508"
            ]
          },
          "400841508": {
            "id": "400841508",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "不过，有很多眼熟的词语欸…好像在之前多莉给我们的文件上见过！"
          }
        }
      }
    }
  ]
}
        "dialogs": {}
      }
    },
    {
      "subId": "4008406",
      "subQuestName": "与莱依拉交谈",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "400840601"
        ],
        "dialogs": {
          "400840601": {
            "id": "400840601",
            "speakerId": 1063,
            "speakerName": "莱依拉",
            "text": "#{NICKNAME}，派蒙，我成功晋级了！",
            "nextDialogs": [
              "400840602"
            ]
          },
          "400840602": {
            "id": "400840602",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "太好了，莱依拉！你顺利完成了参赛的目标！",
            "nextDialogs": [
              "400840603"
            ]
          },
          "400840603": {
            "id": "400840603",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "可喜可贺！",
            "nextDialogs": [
              "400840604"
            ]
          },
          "400840604": {
            "id": "400840604",
            "speakerId": 1063,
            "speakerName": "莱依拉",
            "text": "我听说你们打败了那个一路过关斩将的「铁骨双刀」…为什么我感觉，你们好像有点不开心？",
            "nextDialogs": [
              "400840605"
            ]
          },
          "400840605": {
            "id": "400840605",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "怎么说呢…这个对手不太友善，说了很多奇怪的话…",
            "nextDialogs": [
              "400840606"
            ]
          },
          "400840606": {
            "id": "400840606",
            "speakerId": 1003,
            "speakerName": "Black Screen",
            "text": "向莱依拉讲述了对决中的细节…",
            "nextDialogs": [
              "400840607"
            ]
          },
          "400840607": {
            "id": "400840607",
            "speakerId": 1063,
            "speakerName": "莱依拉",
            "text": "原来是这样…总觉得这样的驯兽师有点…悲哀？",
            "nextDialogs": [
              "400840608"
            ]
          },
          "400840608": {
            "id": "400840608",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "悲哀？",
            "nextDialogs": [
              "400840609"
            ]
          },
          "400840609": {
            "id": "400840609",
            "speakerId": 1063,
            "speakerName": "莱依拉",
            "text": "嗯，那个人明明不了解海妮耶，只凭一个朦胧的印象去揣测她，甚至效仿她。海妮耶要是知道了这种事，大概也会苦恼的吧。",
            "nextDialogs": [
              "400840610"
            ]
          },
          "400840610": {
            "id": "400840610",
            "speakerId": 1063,
            "speakerName": "莱依拉",
            "text": "而且，那个驯兽师对原本可以成为好朋友的蘑菇伙伴这么严苛，不止自己受到了损失，还会影响其他选手的心态…",
            "nextDialogs": [
              "400840611"
            ]
          },
          "400840611": {
            "id": "400840611",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "对啊，我觉得莱依拉的心态就很好！大家都和你一样的话，比赛的气氛也会更和谐，更欢乐！",
            "nextDialogs": [
              "400840612"
            ]
          },
          "400840612": {
            "id": "400840612",
            "speakerId": 1063,
            "speakerName": "莱依拉",
            "text": "只是因为我的目标不高吧…只要能把「转转悠悠兽」带回去一起生活，我就很满足了。",
            "nextDialogs": [
              "400840613"
            ]
          },
          "400840613": {
            "id": "400840613",
            "speakerId": 1063,
            "speakerName": "莱依拉",
            "text": "接下来就轮到我们较量了。我们要友好、开心地比试一场，输赢不重要，当成朋友间的切磋就行。",
            "nextDialogs": [
              "400840614"
            ]
          },
          "400840614": {
            "id": "400840614",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "一言为定！",
            "nextDialogs": [
              "400840615"
            ]
          },
          "400840615": {
            "id": "400840615",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "好哦！让我们看看「转转悠悠兽」和「咚咚小圆帽」谁更厉害！赢了的一边要请输了的吃饭！",
            "nextDialogs": [
              "400840616"
            ]
          },
          "400840616": {
            "id": "400840616",
            "speakerId": 1034,
            "speakerName": "八重神子",
            "text": "看你们开开心心地作出约定，难道我错过了什么关键的讨论吗？",
            "nextDialogs": [
              "400840617"
            ]
          },
          "400840617": {
            "id": "400840617",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "神子，你总算出现了！上次你不声不响就走了，我们还有些线索…呃咳，还有些事想要和你商量！",
            "nextDialogs": [
              "400840618"
            ]
          },
          "400840618": {
            "id": "400840618",
            "speakerId": 1034,
            "speakerName": "八重神子",
            "text": "我也很苦恼呢，我抱着随便玩玩的想法参赛，结果反而进入了半决赛，只能挤出时间陪着左右加他们取材了。",
            "nextDialogs": [
              "400840619"
            ]
          },
          "400840619": {
            "id": "400840619",
            "speakerId": 1034,
            "speakerName": "八重神子",
            "text": "你们两个倒是不必担心，想必会进行一场非常和谐的比赛。我倒是要稍微认真一点了，毕竟对手是那个无比偏执的家伙呢。",
            "nextDialogs": [
              "400840620"
            ]
          },
          "400840620": {
            "id": "400840620",
            "speakerId": 1063,
            "speakerName": "莱依拉",
            "text": "确实，没想到情况会变成这样，八重小姐居然要和海妮耶对阵了…",
            "nextDialogs": [
              "400840621"
            ]
          },
          "400840621": {
            "id": "400840621",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "乐观一点，说不定神子就帮我们把海妮耶打败了呢！",
            "nextDialogs": [
              "400840622"
            ]
          },
          "400840622": {
            "id": "400840622",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "虽然那样就不能亲自说服海妮耶了，但我还是不希望神子输掉！"
          }
        }
      }
    },

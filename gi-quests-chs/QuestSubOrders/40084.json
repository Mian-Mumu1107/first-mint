    {
      "subId": "4008408",
      "subQuestName": "与莱依拉切磋",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "400840801"
        ],
        "dialogs": {
          "400840801": {
            "id": "400840801",
            "speakerId": 1063,
            "speakerName": "莱依拉",
            "text": "我有点紧张，但也很期待！",
            "nextDialogs": [
              "400840802"
            ]
          },
          "400840802": {
            "id": "400840802",
            "speakerId": 1063,
            "speakerName": "莱依拉",
            "text": "请你们不要太拘束，「转转悠悠兽」带领的队伍经历过不少考验，实力也是不错的！让你们的伙伴拿出全力吧！",
            "nextDialogs": [
              "400840803"
            ]
          },
          "400840803": {
            "id": "400840803",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "那就接招吧，莱依拉，还有「转转悠悠兽」！"
          }
        }
      }
    },
    {
      "subId": "4008409",
      "subQuestName": "与莱依拉切磋",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [],
        "dialogs": {}
      }
    },
    {
      "subId": "4008413",
      "subQuestName": "与莱依拉对话",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "400841301"
        ],
        "dialogs": {
          "400841301": {
            "id": "400841301",
            "speakerId": 1063,
            "speakerName": "莱依拉",
            "text": "结果还是输了呀…",
            "nextDialogs": [
              "400841302"
            ]
          },
          "400841302": {
            "id": "400841302",
            "speakerId": 1063,
            "speakerName": "莱依拉",
            "text": "不过你和同伴们发挥得比平常还好，「转转悠悠兽」！我很尽兴，很开心！",
            "nextDialogs": [
              "400841303"
            ]
          },
          "400841303": {
            "id": "400841303",
            "speakerId": 1063,
            "speakerName": "莱依拉",
            "text": "谢谢你们！我和「转转悠悠兽」的比赛完美落幕了，如果被你以外的人打败，也许我们还会有点不服气呢。",
            "nextDialogs": [
              "400841304"
            ]
          },
          "400841304": {
            "id": "400841304",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "莱依拉和「转转悠悠兽」也很强哦，我们差一点就被你们压倒了呢！",
            "nextDialogs": [
              "400841305"
            ]
          },
          "400841305": {
            "id": "400841305",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "不在乎胜负，只是尽情发挥蕈兽们的本领，好好比拼一场…这种感觉真的很畅快。",
            "nextDialogs": [
              "400841306"
            ]
          },
          "400841306": {
            "id": "400841306",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "也许这才是比赛该有的样子…",
            "nextDialogs": [
              "400841307"
            ]
          },
          "400841307": {
            "id": "400841307",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "要是每场比赛都像这样，不用在意其他因素就好了。但是现在神子还在和海妮耶对决！我超级不安！我们赶紧去看看吧！"
          }
        }
      }
    },
    {
      "subId": "4008412",
      "subQuestName": "离开赛场",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "400841201"
        ],
        "dialogs": {
          "400841201": {
            "id": "400841201",
            "speakerId": 12855,
            "speakerName": "海妮耶",
            "text": "嗯？你们是怎么找到这里的…",
            "nextDialogs": [
              "400841202"
            ]
          },
          "400841202": {
            "id": "400841202",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "我们是追着「火一」的痕迹找过来的，看见你刚才的状态，我们很不安！",
            "nextDialogs": [
              "400841203"
            ]
          },
          "400841203": {
            "id": "400841203",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "等等…你这是在安慰「火一」吗？",
            "nextDialogs": [
              "400841204"
            ]
          },
          "400841204": {
            "id": "400841204",
            "speakerId": 12855,
            "speakerName": "海妮耶",
            "text": "还真是讽刺…如果「火一」不是蕈兽，而是普通的动物，我大概会为此感到高兴。",
            "nextDialogs": [
              "400841205"
            ]
          },
          "400841205": {
            "id": "400841205",
            "speakerId": 12855,
            "speakerName": "海妮耶",
            "text": "下次见面就是决赛了，有什么想说的，就等到打败我以后再唠叨…",
            "nextDialogs": [
              "400841208"
            ]
          },
          "400841208": {
            "id": "400841208",
            "speakerId": 12855,
            "speakerName": "海妮耶",
            "text": "你们的说辞和那个狐狸女人预测的完全一样…你们确实很单纯，很善良，把一些事情想得太过美好。",
            "nextDialogs": [
              "400841209"
            ]
          },
          "400841209": {
            "id": "400841209",
            "speakerId": 12855,
            "speakerName": "海妮耶",
            "text": "只凭我简单的转述，是不能让你们理解的。看看这个吧…",
            "nextDialogs": [
              "400841210"
            ]
          },
          "400841210": {
            "id": "400841210",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "这是？",
            "nextDialogs": [
              "400841212"
            ]
          },
          "400841212": {
            "id": "400841212",
            "speakerId": 12855,
            "speakerName": "海妮耶",
            "text": "这是我的祖辈们的记事簿，当年，他们在雨林中遭到了蕈兽的攻击，许多人身受重伤。",
            "nextDialogs": [
              "400841213"
            ]
          },
          "400841213": {
            "id": "400841213",
            "speakerId": 12855,
            "speakerName": "海妮耶",
            "text": "这件事在当时不值一提，甚至没有被任何文献记载。但我的家族成员自我小时候起，就反复把它念给我听，教导我蕈兽的威胁。",
            "nextDialogs": [
              "400841214"
            ]
          },
          "400841214": {
            "id": "400841214",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "原来以前发生过这样的事，难怪你这么仇视蕈兽…"
          }
        }
      }
    },
    {
      "subId": "4008410",
      "subQuestName": "与八重神子对话",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "400841001"
        ],
        "dialogs": {
          "400841001": {
            "id": "400841001",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "咦…难道比赛已经结束了？这凝重的气氛…是神子赢了吗！",
            "nextDialogs": [
              "400841002"
            ]
          },
          "400841002": {
            "id": "400841002",
            "speakerId": 1034,
            "speakerName": "八重神子",
            "text": "你们的比赛也完满落幕了？花费了这么长的时间，看来是一场旗鼓相当的对决呢…",
            "nextDialogs": [
              "400841003"
            ]
          },
          "400841003": {
            "id": "400841003",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "嘿嘿，看神子这轻松的口吻，肯定赢得很轻松！",
            "nextDialogs": [
              "400841004"
            ]
          },
          "400841004": {
            "id": "400841004",
            "speakerId": 1034,
            "speakerName": "八重神子",
            "text": "啊呀呀，我们这边的比赛确实没有任何悬念呢，我和「百雷遮罗」只用短短几招就——",
            "nextDialogs": [
              "400841005"
            ]
          },
          "400841005": {
            "id": "400841005",
            "speakerId": 1034,
            "speakerName": "八重神子",
            "text": "被海妮耶打败了。",
            "nextDialogs": [
              "400841006"
            ]
          },
          "400841006": {
            "id": "400841006",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "欸？",
            "nextDialogs": [
              "400841007"
            ]
          },
          "400841007": {
            "id": "400841007",
            "speakerId": 12855,
            "speakerName": "海妮耶",
            "text": "你那散漫的态度…是在戏弄我吗？",
            "nextDialogs": [
              "400841008"
            ]
          },
          "400841008": {
            "id": "400841008",
            "speakerId": 1034,
            "speakerName": "八重神子",
            "text": "呵呵，我可不敢轻视你，海妮耶小姐。毕竟你的意志格外坚定，甚至想要毁灭一整个物种，我怎么敢对你随便开玩笑呢？",
            "nextDialogs": [
              "400841009"
            ]
          },
          "400841009": {
            "id": "400841009",
            "speakerId": 1034,
            "speakerName": "八重神子",
            "text": "不过，要是你沿着这条路继续走下去，发现沿途所见的景象和想象的完全不同，你的执着又会转变成什么？我很期待哦…",
            "nextDialogs": [
              "400841010"
            ]
          },
          "400841010": {
            "id": "400841010",
            "speakerId": 12855,
            "speakerName": "海妮耶",
            "text": "不劳你操心。",
            "nextDialogs": [
              "400841011"
            ]
          },
          "400841011": {
            "id": "400841011",
            "speakerId": 1034,
            "speakerName": "八重神子",
            "text": "这就逃走了？",
            "nextDialogs": [
              "400841012"
            ]
          },
          "400841012": {
            "id": "400841012",
            "speakerId": 1063,
            "speakerName": "莱依拉",
            "text": "输掉比赛的明明是八重小姐，反而好像是海妮耶受到的打击更大？",
            "nextDialogs": [
              "400841013"
            ]
          },
          "400841013": {
            "id": "400841013",
            "speakerId": 1034,
            "speakerName": "八重神子",
            "text": "事态变得愈发有趣了，比赛刚开始，「百雷遮罗」就伤到了「火一」，海妮耶明显有些慌乱。",
            "nextDialogs": [
              "400841014"
            ]
          },
          "400841014": {
            "id": "400841014",
            "speakerId": 1034,
            "speakerName": "八重神子",
            "text": "我只不过是点破她还在自我欺骗的这个事实，她的心理防线就快要崩溃了，出人意料的脆弱呢。",
            "nextDialogs": [
              "400841017"
            ]
          },
          "400841017": {
            "id": "400841017",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "莫非，海妮耶并不像她说的那样绝情？她其实是关心「火一」的，只不过在神子面前暴露了？",
            "nextDialogs": [
              "400841018"
            ]
          },
          "400841018": {
            "id": "400841018",
            "speakerId": 1034,
            "speakerName": "八重神子",
            "text": "答对啦，现在正是深入她内心世界的好时机。能改变她的，就只有小家伙们啦。",
            "nextDialogs": [
              "400841019"
            ]
          },
          "400841019": {
            "id": "400841019",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "但现在海妮耶已经走远了，我们要去哪里找她呢？",
            "nextDialogs": [
              "400841020"
            ]
          },
          "400841020": {
            "id": "400841020",
            "speakerId": 1034,
            "speakerName": "八重神子",
            "text": "这种时候，她想必在怀疑，一直以来无比决绝的自己究竟受到了什么影响，居然有些动摇？",
            "nextDialogs": [
              "400841021"
            ]
          },
          "400841021": {
            "id": "400841021",
            "speakerId": 1034,
            "speakerName": "八重神子",
            "text": "答案就在你们三位身上。你们很清楚，她会去什么地方。"
          }
        }
      }
    },

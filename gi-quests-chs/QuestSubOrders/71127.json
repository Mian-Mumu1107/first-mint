      }
    },
    {
      "subId": "7112704",
      "subQuestName": "寻找浮锦",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "711270501"
        ],
        "dialogs": {
          "711270501": {
            "id": "711270501",
            "speakerId": 1003,
            "speakerName": "浮锦的声音",
            "text": "#欸？{NICKNAME}和派蒙，还有灵渊…为什么会到这里来呀？",
            "nextDialogs": [
              "711270502"
            ]
          },
          "711270502": {
            "id": "711270502",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "哇啊，是浮锦的声音！好像是…从这下面传上来的？",
            "nextDialogs": [
              "711270504",
              "711270506"
            ]
          },
          "711270504": {
            "id": "711270504",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "是呀，我们都很担心你的身体状况，所以没打招呼就来了——不过，浮锦一开始不也没打招呼就把我们拉过来了嘛，这样我们就算是扯平啦！",
            "nextDialogs": [
              "711270509"
            ]
          },
          "711270509": {
            "id": "711270509",
            "speakerId": 1003,
            "speakerName": "浮锦的声音",
            "text": "欸？啊！抱歉！我回锦落庭休息的时候，好像忘了解除门口的封锁了…！对不起，你们明明是来探望我的，却给你们添了那么多麻烦…",
            "nextDialogs": [
              "711270510"
            ]
          },
          "711270510": {
            "id": "711270510",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "也算不上是添麻烦啦。不过，为什么你要躲在这个…呃，水坑里呀？",
            "nextDialogs": [
              "711270511"
            ]
          },
          "711270511": {
            "id": "711270511",
            "speakerId": 1003,
            "speakerName": "浮锦的声音",
            "text": "怎么说呢…因为我现在还没能恢复我最喜欢的形态，总是让你们看到鲤鱼的样子，稍微觉得有些…不好意思…"
          },
          "711270506": {
            "id": "711270506",
            "speakerId": 1000,
            "speakerName": "灵渊",
            "text": "我没有。我只是…",
            "nextDialogs": [
              "711270507"
            ]
          },
          "711270507": {
            "id": "711270507",
            "speakerId": 1000,
            "speakerName": "灵渊",
            "text": "……",
            "nextDialogs": [
              "711270508"
            ]
          },
          "711270508": {
            "id": "711270508",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "你看，灵渊这都担心得说不出话了，所以我们没打招呼就来了——不过，浮锦一开始不也没打招呼就把我们拉过来了嘛，这样我们就算是扯平啦！"
          }
        }
      }
    },
    {
      "subId": "7112708",

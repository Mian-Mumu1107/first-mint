    {
      "subId": "7112705",
      "subQuestName": "与灵渊对话",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "711270401"
        ],
        "dialogs": {
          "711270401": {
            "id": "711270401",
            "speakerId": 1000,
            "speakerName": "灵渊",
            "text": "#{NICKNAME}，还有派蒙。你们来了。",
            "nextDialogs": [
              "711270402"
            ]
          },
          "711270402": {
            "id": "711270402",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "欸，灵渊？为什么你会在这里？",
            "nextDialogs": [
              "711270403"
            ]
          },
          "711270403": {
            "id": "711270403",
            "speakerId": 1000,
            "speakerName": "灵渊",
            "text": "因为我进不去。",
            "nextDialogs": [
              "711270404"
            ]
          },
          "711270404": {
            "id": "711270404",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "进不去？是说进不去什么地方呀？",
            "nextDialogs": [
              "711270405"
            ]
          },
          "711270405": {
            "id": "711270405",
            "speakerId": 1000,
            "speakerName": "灵渊",
            "text": "锦落庭。浮锦现在休息的地方。",
            "nextDialogs": [
              "711270406"
            ]
          },
          "711270406": {
            "id": "711270406",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "锦落庭…唔，就是浮锦一开始把我们拉进去的那个地方吗？",
            "nextDialogs": [
              "711270407"
            ]
          },
          "711270407": {
            "id": "711270407",
            "speakerId": 1000,
            "speakerName": "灵渊",
            "text": "那里是她用仙力封锁的居所。我没有她的仙力，去不到她的身边。",
            "nextDialogs": [
              "711270408"
            ]
          },
          "711270408": {
            "id": "711270408",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "啊？可是她之前回去休息的时候，你也没提这件事…",
            "nextDialogs": [
              "711270409"
            ]
          },
          "711270409": {
            "id": "711270409",
            "speakerId": 1000,
            "speakerName": "灵渊",
            "text": "我没想起来。",
            "nextDialogs": [
              "711270411",
              "711270413"
            ]
          },
          "711270411": {
            "id": "711270411",
            "speakerId": 1000,
            "speakerName": "灵渊",
            "text": "你们拥有她的仙力，能够开启锦落庭的大门。是的，希望你们帮助我。",
            "nextDialogs": [
              "711270416"
            ]
          },
          "711270416": {
            "id": "711270416",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "欸？等一下，所以你是一直在这里等我们吗？",
            "nextDialogs": [
              "711270417"
            ]
          },
          "711270417": {
            "id": "711270417",
            "speakerId": 1000,
            "speakerName": "灵渊",
            "text": "我不是在等你们。我是在寻找进入锦落庭的办法。",
            "nextDialogs": [
              "711270418"
            ]
          },
          "711270418": {
            "id": "711270418",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "好像没什么区别…总、总之，我们也有些在意浮锦的身体状况，那灵渊，我们一起去探望她吧？",
            "nextDialogs": [
              "711270419"
            ]
          },
          "711270419": {
            "id": "711270419",
            "speakerId": 1000,
            "speakerName": "灵渊",
            "text": "好。谢谢你们。",
            "nextDialogs": [
              "711270420"
            ]
          },
          "711270420": {
            "id": "711270420",
            "speakerId": 1000,
            "speakerName": "灵渊",
            "text": "跟我来。"
          },
          "711270413": {
            "id": "711270413",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "就是就是！为什么连这么重要的事情都能忘啦！真是的！",
            "nextDialogs": [
              "711270414"
            ]
          },
          "711270414": {
            "id": "711270414",
            "speakerId": 1000,
            "speakerName": "灵渊",
            "text": "因为我只是愚钝的野兽。见到她，想了很多事情，忘了很多事情。是我的错。",
            "nextDialogs": [
              "711270415"
            ]
          },
          "711270415": {
            "id": "711270415",
            "speakerId": 1000,
            "speakerName": "灵渊",
            "text": "你们拥有她的仙力，能够开启锦落庭的大门。希望你们帮助我。"
          }
        }
      }
    },
    {
      "subId": "7112703",
      "subQuestName": "前往锦落庭",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "711270301"
        ],
        "dialogs": {
          "711270301": {
            "id": "711270301",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "话说回来，这里就是浮锦的洞天吧？总觉得和我们见过的其他洞天不太一样，怎么说呢，好像更…有现实感？",
            "nextDialogs": [
              "711270302"
            ]
          },
          "711270302": {
            "id": "711270302",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "既没有什么奇奇怪怪的机关，也没有什么透明的浮空桥…",
            "nextDialogs": [
              "711270303"
            ]
          },
          "711270303": {
            "id": "711270303",
            "speakerId": 1002,
            "speakerName": "浮锦",
            "text": "实在是对不起…之前觉得太丢人了，一直没能解释清楚。",
            "nextDialogs": [
              "711270304"
            ]
          },
          "711270304": {
            "id": "711270304",
            "speakerId": 1002,
            "speakerName": "浮锦",
            "text": "我没办法像南方众仙那样，创造出新的空间来。「锦落庭」不是什么「洞天」，充其量也就只是个「洞穴」而已…",
            "nextDialogs": [
              "711270305"
            ]
          },
          "711270305": {
            "id": "711270305",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "「洞天」也好，「洞穴」也好，不都是仙家的「洞府」嘛！不过，也不知道浮锦什么时候才能变回人形呢…",
            "nextDialogs": [
              "711270306"
            ]
          },
          "711270306": {
            "id": "711270306",
            "speakerId": 1000,
            "speakerName": "灵渊",
            "text": "她积攒的力量已经全部逸散到了这片土地上。短时间内应该没办法再恢复人形了。",
            "nextDialogs": [
              "711270307"
            ]
          },
          "711270307": {
            "id": "711270307",
            "speakerId": 1000,
            "speakerName": "灵渊",
            "text": "我耗尽力量的时候也是一样。主人死去后，从雪落到雪融，再从雪融到雪落，如此反复不知多少次，我才能再度化为人的模样。",
            "nextDialogs": [
              "711270308"
            ]
          },
          "711270308": {
            "id": "711270308",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "原来是这样…欸？等一下，原来灵渊也能化成人形吗？！",
            "nextDialogs": [
              "711270309"
            ]
          },
          "711270309": {
            "id": "711270309",
            "speakerId": 1002,
            "speakerName": "浮锦",
            "text": "哼哼，那是当然！二位有所不知，想当初，在药君山的时候，灵渊的姿容可是——",
            "nextDialogs": [
              "711270310"
            ]
          },
          "711270310": {
            "id": "711270310",
            "speakerId": 1000,
            "speakerName": "灵渊",
            "text": "浮锦。没必要说下去。这和现在的话题没有任何关系。",
            "nextDialogs": [
              "711270311"
            ]
          },
          "711270311": {
            "id": "711270311",
            "speakerId": 1002,
            "speakerName": "浮锦",
            "text": "欸？那化为人形以后，因为在庙会上吃了太多茶糕，哭着跑去求药君帮自己调配减肥茶的事情…",
            "nextDialogs": [
              "711270312"
            ]
          },
          "711270312": {
            "id": "711270312",
            "speakerId": 1002,
            "speakerName": "浮锦",
            "text": "或者不小心把庆典上的酒当作茶水喝了下去，拽着山间的林猪，问「药君和我谁更美」的事情，果然还是没必要说下去了吧？",
            "nextDialogs": [
              "711270313"
            ]
          },
          "711270313": {
            "id": "711270313",
            "speakerId": 1000,
            "speakerName": "灵渊",
            "text": "…浮锦！",
            "nextDialogs": [
              "711270314"
            ]
          },
          "711270314": {
            "id": "711270314",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "呜啊，你这么一说，我开始好奇灵渊化成的人形到底是什么样的了！会是像现在一样蓝蓝的吗？还是会…呃，更白一点？",
            "nextDialogs": [
              "711270316",
              "711270318"
            ]
          },
          "711270316": {
            "id": "711270316",
            "speakerId": 1000,
            "speakerName": "灵渊",
            "text": "我不理解你好奇的原因。你也是人。对人的形态感兴趣，看看自己就好。",
            "nextDialogs": [
              "711270321"
            ]
          },
          "711270321": {
            "id": "711270321",
            "speakerId": 1002,
            "speakerName": "浮锦",
            "text": "#呵呵…总之，谢谢你们，{NICKNAME}和派蒙。我也没有想到，有朝一日，还能像这样和其他人交流…",
            "nextDialogs": [
              "711270322"
            ]
          },
          "711270322": {
            "id": "711270322",
            "speakerId": 1002,
            "speakerName": "浮锦",
            "text": "咳咳——既然小仙我心情大悦，不妨就护佑二位，接下来的旅途能够一帆风顺，时通运泰…",
            "nextDialogs": [
              "711270323"
            ]
          },
          "711270323": {
            "id": "711270323",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "？",
            "nextDialogs": [
              "711270324"
            ]
          },
          "711270324": {
            "id": "711270324",
            "speakerId": 1002,
            "speakerName": "浮锦",
            "text": "…对不起是我得意忘形了。我刚才想要像仙人那样，说一下这句话试试看…",
            "nextDialogs": [
              "711270325"
            ]
          },
          "711270325": {
            "id": "711270325",
            "speakerId": 1002,
            "speakerName": "浮锦",
            "text": "无论如何，我都会在这里祈愿，愿你们接下来的旅途一帆风顺。"
          },
          "711270318": {
            "id": "711270318",
            "speakerId": 1000,
            "speakerName": "灵渊",
            "text": "我拒绝。人类的身躯过于羸弱。没有撕碎猎物的尖牙，没有逐狩仇敌的利爪。除非浮锦命令，我不会做那种事。",
            "nextDialogs": [
              "711270319"
            ]
          },
          "711270319": {
            "id": "711270319",
            "speakerId": 1002,
            "speakerName": "浮锦",
            "text": "…欸？这、这个，我觉得还是应该尊重灵渊的想法吧…？",
            "nextDialogs": [
              "711270320"
            ]
          },
          "711270320": {
            "id": "711270320",
            "speakerId": 1000,
            "speakerName": "灵渊",
            "text": "我没有什么想法。你要是有想法的话，可以直接告诉我。"
          }
        }
      }
    },
    {
      "subId": "7112707",

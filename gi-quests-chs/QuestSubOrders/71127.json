    {
      "subId": "7112709",
      "subQuestName": "（test）灵渊和小茂$HIDDEN",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "711270901"
        ],
        "dialogs": {
          "711270901": {
            "id": "711270901",
            "speakerId": 1004,
            "speakerName": "小茂",
            "text": "阿蓝，阿蓝，你上次给我讲的那个故事，还没有结尾呢！",
            "nextDialogs": [
              "711270902"
            ]
          },
          "711270902": {
            "id": "711270902",
            "speakerId": 1000,
            "speakerName": "灵渊",
            "text": "嗯。我记得。不过，我改变主意了。",
            "nextDialogs": [
              "711270903"
            ]
          },
          "711270903": {
            "id": "711270903",
            "speakerId": 1004,
            "speakerName": "小茂",
            "text": "「改变主意」是什么意思呀？",
            "nextDialogs": [
              "711270904"
            ]
          },
          "711270904": {
            "id": "711270904",
            "speakerId": 1000,
            "speakerName": "灵渊",
            "text": "这个故事的结尾，就交给你来讲吧。",
            "nextDialogs": [
              "711270905"
            ]
          },
          "711270905": {
            "id": "711270905",
            "speakerId": 1004,
            "speakerName": "小茂",
            "text": "欸？！阿蓝也太耍赖啦！明明说好的，我给你讲一个故事，你给我讲一个故事，怎么现在两个故事全都变成我来讲啦！",
            "nextDialogs": [
              "711270906"
            ]
          },
          "711270906": {
            "id": "711270906",
            "speakerId": 1000,
            "speakerName": "灵渊",
            "text": "我只是愚钝的野兽。想不出好的结局。",
            "nextDialogs": [
              "711270907"
            ]
          },
          "711270907": {
            "id": "711270907",
            "speakerId": 1000,
            "speakerName": "灵渊",
            "text": "我想出的结局是坏结局，故事也是没有人会欢笑的坏故事。所以，你来讲故事的结局。",
            "nextDialogs": [
              "711270908"
            ]
          },
          "711270908": {
            "id": "711270908",
            "speakerId": 1004,
            "speakerName": "小茂",
            "text": "可这还是在耍赖嘛！",
            "nextDialogs": [
              "711270909"
            ]
          },
          "711270909": {
            "id": "711270909",
            "speakerId": 1000,
            "speakerName": "灵渊",
            "text": "我不否认。作为补偿，我可以带你去看灵濛山中隐藏的绝景。",
            "nextDialogs": [
              "711270910"
            ]
          },
          "711270910": {
            "id": "711270910",
            "speakerId": 1000,
            "speakerName": "灵渊",
            "text": "……",
            "nextDialogs": [
              "711270911"
            ]
          },
          "711270911": {
            "id": "711270911",
            "speakerId": 1000,
            "speakerName": "灵渊",
            "text": "不要露出那种表情。我特别允许你…坐在我背上，五分钟左右。十分钟也可以。",
            "nextDialogs": [
              "711270912"
            ]
          },
          "711270912": {
            "id": "711270912",
            "speakerId": 1004,
            "speakerName": "小茂",
            "text": "那…那就这样说好了，我想想这个故事该怎么结尾…"
          }
        }
      }
    },
    {
      "subId": "7112710",
      "subQuestName": "（test）灵渊$HIDDEN",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "711271001"
        ],
        "dialogs": {
          "711271001": {
            "id": "711271001",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "欸，这不是灵渊吗？",
            "nextDialogs": [
              "711271002"
            ]
          },
          "711271002": {
            "id": "711271002",
            "speakerId": 1000,
            "speakerName": "灵渊",
            "text": "……",
            "nextDialogs": [
              "711271003"
            ]
          },
          "711271003": {
            "id": "711271003",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "啊，对不起！难道说你是在狩猎，我们不小心打扰了你…",
            "nextDialogs": [
              "711271004"
            ]
          },
          "711271004": {
            "id": "711271004",
            "speakerId": 1000,
            "speakerName": "灵渊",
            "text": "我没有在狩猎。你们也没有打扰我。",
            "nextDialogs": [
              "711271005"
            ]
          },
          "711271005": {
            "id": "711271005",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "呃，那你这是在…发呆？比方说，在想好吃的？",
            "nextDialogs": [
              "711271006"
            ]
          },
          "711271006": {
            "id": "711271006",
            "speakerId": 1000,
            "speakerName": "灵渊",
            "text": "我也没在想你的事情。我在思考。",
            "nextDialogs": [
              "711271007"
            ]
          },
          "711271007": {
            "id": "711271007",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "思考…不对，你前半句话是什么意思啦！",
            "nextDialogs": [
              "711271008"
            ]
          },
          "711271008": {
            "id": "711271008",
            "speakerId": 1000,
            "speakerName": "灵渊",
            "text": "#我在思考{NICKNAME}之前的问题。",
            "nextDialogs": [
              "711271009"
            ]
          },
          "711271009": {
            "id": "711271009",
            "speakerId": 1000,
            "speakerName": "灵渊",
            "text": "「如果人类活动也是自然法则的一部分，该如何看待人类。」",
            "nextDialogs": [
              "711271010"
            ]
          },
          "711271010": {
            "id": "711271010",
            "speakerId": 1000,
            "speakerName": "灵渊",
            "text": "浮锦和蛇，她们离开后，我太久没有接触过组成聚落的人类了。",
            "nextDialogs": [
              "711271011"
            ]
          },
          "711271011": {
            "id": "711271011",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "你这话说的，小茂不也是人类嘛！",
            "nextDialogs": [
              "711271012"
            ]
          },
          "711271012": {
            "id": "711271012",
            "speakerId": 1000,
            "speakerName": "灵渊",
            "text": "#小茂是属于聚落的人类，而不是组成聚落的人类。你和{NICKNAME}「组成」了旅行的同伴，而不「属于」{NICKNAME}。这就是区别。",
            "nextDialogs": [
              "711271014",
              "711271016"
            ]
          },
          "711271014": {
            "id": "711271014",
            "speakerId": 1000,
            "speakerName": "灵渊",
            "text": "还没有完全成为这种秩序的一部分。人类的幼崽几乎都是这样，直到他们被这种秩序彻底涂抹，就像是自然那样。",
            "nextDialogs": [
              "711271017"
            ]
          },
          "711271017": {
            "id": "711271017",
            "speakerId": 1000,
            "speakerName": "灵渊",
            "text": "我太久没有接触过组成聚落的人类了。或许是出于厌恶，或许是出于恐惧，或许两者皆有。"
          },
          "711271016": {
            "id": "711271016",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "喂！不要说这么奇怪的话啦！"
          }
        }
      }
    },
    {
      "subId": "7112711",
      "subQuestName": "（test）大山和小茂$HIDDEN",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "711271101"
        ],
        "dialogs": {
          "711271101": {
            "id": "711271101",
            "speakerId": 1004,
            "speakerName": "小茂",
            "text": "听大山这么讲，我感觉枫丹的「歌剧」和我们这边的戏好像也差不多呢！",
            "nextDialogs": [
              "711271102"
            ]
          },
          "711271102": {
            "id": "711271102",
            "speakerId": 1004,
            "speakerName": "小茂",
            "text": "骑士呀，巫师呀，勇士呀，恶龙呀，你杀我，我杀你的，最后大家都死了！",
            "nextDialogs": [
              "711271103"
            ]
          },
          "711271103": {
            "id": "711271103",
            "speakerId": 1005,
            "speakerName": "沃特蒙泰涅",
            "text": "重要的不是结局啦，而是过程，过程！不是所有悲剧都能当武打戏那么看的！",
            "nextDialogs": [
              "711271104"
            ]
          },
          "711271104": {
            "id": "711271104",
            "speakerId": 1004,
            "speakerName": "小茂",
            "text": "还有还有，大山刚才说的「累牡蛎牙魔像」，听上去好像很有趣！不知道和阿蓝比起来哪个更大呢？",
            "nextDialogs": [
              "711271105"
            ]
          },
          "711271105": {
            "id": "711271105",
            "speakerId": 1005,
            "speakerName": "沃特蒙泰涅",
            "text": "欸？阿兰？",
            "nextDialogs": [
              "711271106"
            ]
          },
          "711271106": {
            "id": "711271106",
            "speakerId": 1004,
            "speakerName": "小茂",
            "text": "对喔，我好像还没给大山讲过阿蓝的事情…这样吧，你再给我讲一讲「累牡蛎牙」的魔像，我就给你讲阿蓝的故事好啦！"
          }
        }
      }
    },
    {
      "subId": "7112712",
      "subQuestName": "（test）浮锦和灵渊$HIDDEN",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "711271201"
        ],
        "dialogs": {
          "711271201": {
            "id": "711271201",
            "speakerId": 1000,
            "speakerName": "灵渊",
            "text": "……",
            "nextDialogs": [
              "711271202"
            ]
          },
          "711271202": {
            "id": "711271202",
            "speakerId": 1002,
            "speakerName": "浮锦",
            "text": "怎么了，灵渊？一直盯着我看，我身上有什么奇怪的东西吗？",
            "nextDialogs": [
              "711271203"
            ]
          },
          "711271203": {
            "id": "711271203",
            "speakerId": 1000,
            "speakerName": "灵渊",
            "text": "我只是在想…不，没什么。",
            "nextDialogs": [
              "711271204"
            ]
          },
          "711271204": {
            "id": "711271204",
            "speakerId": 1000,
            "speakerName": "灵渊",
            "text": "就算你和蛇一起要求，我也不会再化成人形了。",
            "nextDialogs": [
              "711271205"
            ]
          },
          "711271205": {
            "id": "711271205",
            "speakerId": 1002,
            "speakerName": "浮锦",
            "text": "呵呵，我也没要求过你呀？",
            "nextDialogs": [
              "711271206"
            ]
          },
          "711271206": {
            "id": "711271206",
            "speakerId": 1000,
            "speakerName": "灵渊",
            "text": "…算了。走吧。你不是还要去看现在的茶园吗。"
          }
        }
      }
    },
    {
      "subId": "7112713",
      "subQuestName": "（test）浮锦和小茂$HIDDEN",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "711271301"
        ],
        "dialogs": {
          "711271301": {
            "id": "711271301",
            "speakerId": 1004,
            "speakerName": "小茂",
            "text": "浮锦姐姐！祝贺你重新变回来！",
            "nextDialogs": [
              "711271302"
            ]
          },
          "711271302": {
            "id": "711271302",
            "speakerId": 1004,
            "speakerName": "小茂",
            "text": "我已经听阿蓝说过啦！浮锦姐姐好像很喜欢喝茶的样子，我就专门拜托了陆爷爷，为浮锦姐姐准备了超级美味的茶糕！",
            "nextDialogs": [
              "711271303"
            ]
          },
          "711271303": {
            "id": "711271303",
            "speakerId": 1002,
            "speakerName": "浮锦",
            "text": "嗯，我已经完全变回来啦！小茂，谢谢你专门为我准备茶糕，我好开心！",
            "nextDialogs": [
              "711271304"
            ]
          },
          "711271304": {
            "id": "711271304",
            "speakerId": 1004,
            "speakerName": "小茂",
            "text": "#{NICKNAME}{M#哥哥}{F#姐姐}，派蒙姐姐，我也准备了你们的份喔！大家一起吃茶糕，庆祝浮锦姐姐恢复精神吧！",
            "nextDialogs": [
              "711271306",
              "711271308"
            ]
          },
          "711271306": {
            "id": "711271306",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "嘿嘿，谢谢小茂！既然如此，那我也拿两块吧！"
          },
          "711271308": {
            "id": "711271308",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "嘿嘿，谢谢小茂！既然如此，那我也…呜啊，只剩下一块啦！"
          }
        }
      }
    }
  ]
}
  },
  "subQuests": [
    {
      "subId": "1001201",
      "subQuestName": "",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "100120101"
        ],
        "dialogs": {
          "100120101": {
            "id": "100120101",
            "speakerId": 16498,
            "speakerName": "阿多诺",
            "text": "唉，可惜，我已经提不动剑了，就算跟着你们去，恐怕也只会跟昨天一样碍事吧。",
            "nextDialogs": [
              "100120102"
            ]
          },
          "100120102": {
            "id": "100120102",
            "speakerId": 16498,
            "speakerName": "阿多诺",
            "text": "看来今天的日常工作，只有我一个人来干了呀。"
          }
        }
      }
    },
    {
      "subId": "1001202",
      "subQuestName": "前往阿多诺住所",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "100120201"
        ],
        "dialogs": {
          "100120201": {
            "id": "100120201",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "嘿！阿多诺爷爷！",
            "nextDialogs": [
              "100120202"
            ]
          },
          "100120202": {
            "id": "100120202",
            "speakerId": 16498,
            "speakerName": "阿多诺",
            "text": "哦哦，是小派蒙和荣誉骑士呀。",
            "nextDialogs": [
              "100120203"
            ]
          },
          "100120203": {
            "id": "100120203",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "您已经没事了吗？",
            "nextDialogs": [
              "100120204"
            ]
          },
          "100120204": {
            "id": "100120204",
            "speakerId": 16498,
            "speakerName": "阿多诺",
            "text": "哈哈，没事了，昨天本来就没真受伤，请希奥多帮我看了看，就更没事了！",
            "nextDialogs": [
              "100120205"
            ]
          },
          "100120205": {
            "id": "100120205",
            "speakerId": 16498,
            "speakerName": "阿多诺",
            "text": "我这把老骨头现在还能到处乱跑，也多亏了他平时帮忙调理呀。要不然，怕是早就埋进土里咯。",
            "nextDialogs": [
              "100120206"
            ]
          },
          "100120206": {
            "id": "100120206",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "希奥多…就是那位第八小队的见习医师？看不出来他居然这么厉害…",
            "nextDialogs": [
              "100120207"
            ]
          },
          "100120207": {
            "id": "100120207",
            "speakerId": 16498,
            "speakerName": "阿多诺",
            "text": "虽然他曾经立志成为在前线奋战的骑士，但或许医师，才是更适合他的道路吧。",
            "nextDialogs": [
              "100120208"
            ]
          },
          "100120208": {
            "id": "100120208",
            "speakerId": 16498,
            "speakerName": "阿多诺",
            "text": "嗨，先不说这个了，你们过来是想找洛恩吗？",
            "nextDialogs": [
              "100120209"
            ]
          },
          "100120209": {
            "id": "100120209",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "嗯，他昨天试过「模拟训练泡」之后就没影了，在哪都找不到他…",
            "nextDialogs": [
              "100120210"
            ]
          },
          "100120210": {
            "id": "100120210",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "他有回来过吗？",
            "nextDialogs": [
              "100120211"
            ]
          },
          "100120211": {
            "id": "100120211",
            "speakerId": 16498,
            "speakerName": "阿多诺",
            "text": "嗯，他早上确实丢了张字条过来…说是想为昨天的事道歉。",
            "nextDialogs": [
              "100120212"
            ]
          },
          "100120212": {
            "id": "100120212",
            "speakerId": 16498,
            "speakerName": "阿多诺",
            "text": "他承认昨天都是在演戏，也无法忍受枯燥的日常，但作为代替…",
            "nextDialogs": [
              "100120213"
            ]
          },
          "100120213": {
            "id": "100120213",
            "speakerId": 1326,
            "speakerName": "洛恩",
            "text": "「…我会去把那些碍事的魔物都杀干净。」",
            "nextDialogs": [
              "100120214"
            ]
          },
          "100120214": {
            "id": "100120214",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "这么个道歉法吗？还真有他的风格。",
            "nextDialogs": [
              "100120217"
            ]
          },
          "100120217": {
            "id": "100120217",
            "speakerId": 16498,
            "speakerName": "阿多诺",
            "text": "嗯…寻常魔物对他构不成什么威胁，但我有些担心，他像昨天那样…",
            "nextDialogs": [
              "100120218"
            ]
          },
          "100120218": {
            "id": "100120218",
            "speakerId": 16498,
            "speakerName": "阿多诺",
            "text": "能有你们照看一下，就再好不过了。",
            "nextDialogs": [
              "100120219"
            ]
          },
          "100120219": {
            "id": "100120219",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "嗯，我会留意的。"
          }
        }
      }
    },
    {
      "subId": "1001203",
      "subQuestName": "寻找洛恩",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "100120301"
        ],
        "dialogs": {
          "100120301": {
            "id": "100120301",
            "speakerId": 1003,
            "speakerName": "Black Screen",
            "text": "稍早之前…",
            "nextDialogs": [
              "100120302"
            ]
          },
          "100120302": {
            "id": "100120302",
            "speakerId": 1326,
            "speakerName": "洛恩",
            "text": "最后一只…可要让我好好尽兴呀！",
            "nextDialogs": [
              "100120303"
            ]
          },
          "100120303": {
            "id": "100120303",
            "speakerId": 1004,
            "speakerName": "实验魔物",
            "text": "——！",
            "nextDialogs": [
              "100120304"
            ]
          },
          "100120304": {
            "id": "100120304",
            "speakerId": 1326,
            "speakerName": "洛恩",
            "text": "…嗯？谁！",
            "nextDialogs": [
              "100120305"
            ]
          },
          "100120305": {
            "id": "100120305",
            "speakerId": 1004,
            "speakerName": "实验魔物",
            "text": "……！",
            "nextDialogs": [
              "100120306"
            ]
          },
          "100120306": {
            "id": "100120306",
            "speakerId": 1326,
            "speakerName": "洛恩",
            "text": "嘁…逃跑了吗…",
            "nextDialogs": [
              "100120307"
            ]
          },
          "100120307": {
            "id": "100120307",
            "speakerId": 1326,
            "speakerName": "洛恩",
            "text": "——没想到一位酒庄老板，居然对猎杀魔物这么上心？",
            "nextDialogs": [
              "100120308"
            ]
          },
          "100120308": {
            "id": "100120308",
            "speakerId": 1326,
            "speakerName": "洛恩",
            "text": "还是说你追猎的目标，不只是魔物？",
            "nextDialogs": [
              "100120309"
            ]
          },
          "100120309": {
            "id": "100120309",
            "speakerId": 1009,
            "speakerName": "迪卢克",
            "text": "那你想清除的，难道也只有「魔物」而已吗？",
            "nextDialogs": [
              "100120310"
            ]
          },
          "100120310": {
            "id": "100120310",
            "speakerId": 1009,
            "speakerName": "迪卢克",
            "text": "以之前现场被清理的程度来看，可「什么」都没被留下。",
            "nextDialogs": [
              "100120311"
            ]
          },
          "100120311": {
            "id": "100120311",
            "speakerId": 1326,
            "speakerName": "洛恩",
            "text": "哦，这我还是头一次听说。",
            "nextDialogs": [
              "100120312"
            ]
          },
          "100120312": {
            "id": "100120312",
            "speakerId": 1009,
            "speakerName": "迪卢克",
            "text": "那我们不妨一起检查一下这里的魔物，看看它们究竟有什么异常，值得这么多人关注。",
            "nextDialogs": [
              "100120313"
            ]
          },
          "100120313": {
            "id": "100120313",
            "speakerId": 1326,
            "speakerName": "洛恩",
            "text": "…算啦，我还是去追剩下那头漏网之鱼吧。调查什么的，还是不太适合我呀。",
            "nextDialogs": [
              "100120314"
            ]
          },
          "100120314": {
            "id": "100120314",
            "speakerId": 1326,
            "speakerName": "洛恩",
            "text": "再会了，迪卢克…「前辈」。",
            "nextDialogs": [
              "100120315"
            ]
          },
          "100120315": {
            "id": "100120315",
            "speakerId": 1009,
            "speakerName": "迪卢克",
            "text": "…在你们来之前发生的事，差不多就是这些了。",
            "nextDialogs": [
              "100120316"
            ]
          },
          "100120316": {
            "id": "100120316",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "洛恩那家伙…葫芦里到底卖的什么药？我都有点想把「扛揍骑士」给升级成「欠揍骑士」了。",
            "nextDialogs": [
              "100120319"
            ]
          },
          "100120319": {
            "id": "100120319",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "对呀！昨天听阿多诺说…它们虽然有点古怪，但到现在也没出现过什么伤人记录？",
            "nextDialogs": [
              "100120320"
            ]
          },
          "100120320": {
            "id": "100120320",
            "speakerId": 1009,
            "speakerName": "迪卢克",
            "text": "一方面可能是有人一直在暗中清理它们；另一方面…似乎是因为它们在饥饿时，会优先攻击自己的同伴。",
            "nextDialogs": [
              "100120321"
            ]
          },
          "100120321": {
            "id": "100120321",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "攻击…自己的同伴？",
            "nextDialogs": [
              "100120322"
            ]
          },
          "100120322": {
            "id": "100120322",
            "speakerId": 1009,
            "speakerName": "迪卢克",
            "text": "嗯，之前只能收到少量的目击情报，还不能确信。但留在这里的魔物残骸，身上确实有大量彼此攻击的痕迹。",
            "nextDialogs": [
              "100120323"
            ]
          },
          "100120323": {
            "id": "100120323",
            "speakerId": 1009,
            "speakerName": "迪卢克",
            "text": "明明结伴成群、却又自相残杀…这不像是自然产生的魔物。",
            "nextDialogs": [
              "100120324"
            ]
          },
          "100120324": {
            "id": "100120324",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "确实诡异…",
            "nextDialogs": [
              "100120325"
            ]
          },
          "100120325": {
            "id": "100120325",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "欸？可是如果这些魔物会彼此攻击，那等它们自生自灭不就行了吗？为什么还要这么提防？",
            "nextDialogs": [
              "100120326"
            ]
          },
          "100120326": {
            "id": "100120326",
            "speakerId": 1310,
            "speakerName": "法尔伽",
            "text": "因为这种身具「乌萨血肉」的魔物，不止出现过一次。",
            "nextDialogs": [
              "100120327"
            ]
          },
          "100120327": {
            "id": "100120327",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "——法尔伽！",
            "nextDialogs": [
              "100120328"
            ]
          },
          "100120328": {
            "id": "100120328",
            "speakerId": 1310,
            "speakerName": "法尔伽",
            "text": "哟，真巧啊，荣誉骑士，派蒙，还有迪卢克。",
            "nextDialogs": [
              "100120329"
            ]
          },
          "100120329": {
            "id": "100120329",
            "speakerId": 1009,
            "speakerName": "迪卢克",
            "text": "…看来骑士团对这次的异常，并非一无所知。",
            "nextDialogs": [
              "100120330"
            ]
          },
          "100120330": {
            "id": "100120330",
            "speakerId": 1310,
            "speakerName": "法尔伽",
            "text": "嗯…伊洛克的悲剧，决不能、也不会再上演一次。",
            "nextDialogs": [
              "100120331"
            ]
          },
          "100120331": {
            "id": "100120331",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "你刚才说的…是「乌萨血肉」？这也跟那个伊洛克有关吗？",
            "nextDialogs": [
              "100120332"
            ]
          },
          "100120332": {
            "id": "100120332",
            "speakerId": 1310,
            "speakerName": "法尔伽",
            "text": "为了谋取超凡的力量，伊洛克曾经跟多托雷的切片合谋，从魔龙乌萨的血肉中提取蕴含其力量的血清。",
            "nextDialogs": [
              "100120333"
            ]
          },
          "100120333": {
            "id": "100120333",
            "speakerId": 1310,
            "speakerName": "法尔伽",
            "text": "在我们决定清算伊洛克的时候，他跟他的党羽都注射了那种血清…给骑士团造成过不小的麻烦。",
            "nextDialogs": [
              "100120334"
            ]
          },
          "100120334": {
            "id": "100120334",
            "speakerId": 1310,
            "speakerName": "法尔伽",
            "text": "力量大增、嗜血成性，陷入疯狂之时，甚至会彼此攻击。",
            "nextDialogs": [
              "100120335"
            ]
          },
          "100120335": {
            "id": "100120335",
            "speakerId": 1310,
            "speakerName": "法尔伽",
            "text": "讽刺的是，伊洛克最后没能控制住那份力量，不仅向着自己的党羽挥剑，也在疯狂中走向了自毁。",
            "nextDialogs": [
              "100120336"
            ]
          },
          "100120336": {
            "id": "100120336",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "魔龙乌萨…究竟是什么来头？能有这么可怕的力量？"
          }
        }
      }
    },
    {
      "subId": "1001204",
      "subQuestName": "前往目标所在地",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "100120401"
        ],
        "dialogs": {
          "100120401": {
            "id": "100120401",
            "speakerId": 1326,
            "speakerName": "洛恩",
            "text": "果然，骑士团已经行动起来了…",
            "nextDialogs": [
              "100120402"
            ]
          },
          "100120402": {
            "id": "100120402",
            "speakerId": 16499,
            "speakerName": "希奥多",
            "text": "前面围了这么多人？气氛好像有些不对劲…",
            "nextDialogs": [
              "100120403"
            ]
          },
          "100120403": {
            "id": "100120403",
            "speakerId": 1326,
            "speakerName": "洛恩",
            "text": "那是…阿多诺！",
            "nextDialogs": [
              "100120404"
            ]
          },
          "100120404": {
            "id": "100120404",
            "speakerId": 1003,
            "speakerName": "Black Screen",
            "text": "数小时前…",
            "nextDialogs": [
              "100120405"
            ]
          },
          "100120405": {
            "id": "100120405",
            "speakerId": 16498,
            "speakerName": "阿多诺",
            "text": "哈…可算找到你咯！",
            "nextDialogs": [
              "100120406"
            ]
          },
          "100120406": {
            "id": "100120406",
            "speakerId": 16617,
            "speakerName": "北地猫",
            "text": "喵…",
            "nextDialogs": [
              "100120407"
            ]
          },
          "100120407": {
            "id": "100120407",
            "speakerId": 16498,
            "speakerName": "阿多诺",
            "text": "好好看住它吧，别再让它跑到这么远的地方了。",
            "nextDialogs": [
              "100120408"
            ]
          },
          "100120408": {
            "id": "100120408",
            "speakerId": 1774,
            "speakerName": "莫里兹提尔",
            "text": "谢谢…谢谢阿多诺爷爷！",
            "nextDialogs": [
              "100120409"
            ]
          },
          "100120409": {
            "id": "100120409",
            "speakerId": 16498,
            "speakerName": "阿多诺",
            "text": "也别再一个人跑到城外找它了，你担心它，汉娜洛蕾也会担心你呀。这次我就先替你保密了，下不为例啊。",
            "nextDialogs": [
              "100120410"
            ]
          },
          "100120410": {
            "id": "100120410",
            "speakerId": 1774,
            "speakerName": "莫里兹提尔",
            "text": "嗯…我知道了。",
            "nextDialogs": [
              "100120411"
            ]
          },
          "100120411": {
            "id": "100120411",
            "speakerId": 16617,
            "speakerName": "北地猫",
            "text": "喵…！",
            "nextDialogs": [
              "100120412"
            ]
          },
          "100120412": {
            "id": "100120412",
            "speakerId": 1004,
            "speakerName": "实验魔物",
            "text": "咕…！",
            "nextDialogs": [
              "100120413"
            ]
          },
          "100120413": {
            "id": "100120413",
            "speakerId": 1774,
            "speakerName": "莫里兹提尔",
            "text": "啊！那…那是…魔物？",
            "nextDialogs": [
              "100120414"
            ]
          },
          "100120414": {
            "id": "100120414",
            "speakerId": 16498,
            "speakerName": "阿多诺",
            "text": "魔物？怎么会跑到这里…样子也不太对劲…",
            "nextDialogs": [
              "100120415"
            ]
          },
          "100120415": {
            "id": "100120415",
            "speakerId": 1774,
            "speakerName": "莫里兹提尔",
            "text": "啊…啊…",
            "nextDialogs": [
              "100120416"
            ]
          },
          "100120416": {
            "id": "100120416",
            "speakerId": 16498,
            "speakerName": "阿多诺",
            "text": "不要怕！有我在呢！站起来！跑回去！",
            "nextDialogs": [
              "100120417"
            ]
          },
          "100120417": {
            "id": "100120417",
            "speakerId": 1774,
            "speakerName": "莫里兹提尔",
            "text": "可…可是…",
            "nextDialogs": [
              "100120418"
            ]
          },
          "100120418": {
            "id": "100120418",
            "speakerId": 16498,
            "speakerName": "阿多诺",
            "text": "快回去——爷爷我…可是骑士啊！"
          }
        }
      }
    },
    {
      "subId": "1001205",
      "subQuestName": "了解阿多诺的情况",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "100120501"
        ],
        "dialogs": {
          "100120501": {
            "id": "100120501",
            "speakerId": 1310,
            "speakerName": "法尔伽",
            "text": "…随后赶到的骑士们，解决了闯入近郊的魔物…它的力量远超寻常。",
            "nextDialogs": [
              "100120502"
            ]
          },
          "100120502": {
            "id": "100120502",
            "speakerId": 1310,
            "speakerName": "法尔伽",
            "text": "而阿多诺为了拖延时间，拼命跟它缠斗到了最后。",
            "nextDialogs": [
              "100120503"
            ]
          },
          "100120503": {
            "id": "100120503",
            "speakerId": 16499,
            "speakerName": "希奥多",
            "text": "阿多诺…阿多诺！",
            "nextDialogs": [
              "100120504"
            ]
          },
          "100120504": {
            "id": "100120504",
            "speakerId": 16498,
            "speakerName": "阿多诺",
            "text": "哈…",
            "nextDialogs": [
              "100120505"
            ]
          },
          "100120505": {
            "id": "100120505",
            "speakerId": 16498,
            "speakerName": "阿多诺",
            "text": "…没事的，我的身体你也知道…要不是有你，早就撑不到今天了。",
            "nextDialogs": [
              "100120506"
            ]
          },
          "100120506": {
            "id": "100120506",
            "speakerId": 16498,
            "speakerName": "阿多诺",
            "text": "能为了救人再拼一把，可比躺在床上…更像个骑士！…咳咳！",
            "nextDialogs": [
              "100120507"
            ]
          },
          "100120507": {
            "id": "100120507",
            "speakerId": 16498,
            "speakerName": "阿多诺",
            "text": "就是可惜…你帮我调理了那么久…辛苦了啊。",
            "nextDialogs": [
              "100120508"
            ]
          },
          "100120508": {
            "id": "100120508",
            "speakerId": 16499,
            "speakerName": "希奥多",
            "text": "呜…",
            "nextDialogs": [
              "100120509"
            ]
          },
          "100120509": {
            "id": "100120509",
            "speakerId": 16498,
            "speakerName": "阿多诺",
            "text": "洛恩…「仁蔼骑士」的名号，还有第五小队的队长…",
            "nextDialogs": [
              "100120510"
            ]
          },
          "100120510": {
            "id": "100120510",
            "speakerId": 1326,
            "speakerName": "洛恩",
            "text": "我…",
            "nextDialogs": [
              "100120511"
            ]
          },
          "100120511": {
            "id": "100120511",
            "speakerId": 16498,
            "speakerName": "阿多诺",
            "text": "——要是不喜欢，就都别管啦。你没必要…活成任何人的样子。",
            "nextDialogs": [
              "100120512"
            ]
          },
          "100120512": {
            "id": "100120512",
            "speakerId": 1326,
            "speakerName": "洛恩",
            "text": "……",
            "nextDialogs": [
              "100120513"
            ]
          },
          "100120513": {
            "id": "100120513",
            "speakerId": 1310,
            "speakerName": "法尔伽",
            "text": "…洛恩，跟我来一下吧。",
            "nextDialogs": [
              "100120514"
            ]
          },
          "100120514": {
            "id": "100120514",
            "speakerId": 1310,
            "speakerName": "法尔伽",
            "text": "调查小队的分析结果已经出来了：袭击阿多诺的魔物，身上带着乌萨的气息。",
            "nextDialogs": [
              "100120515"
            ]
          },
          "100120515": {
            "id": "100120515",
            "speakerId": 1326,
            "speakerName": "洛恩",
            "text": "……！",
            "nextDialogs": [
              "100120516"
            ]
          },
          "100120516": {
            "id": "100120516",
            "speakerId": 1310,
            "speakerName": "法尔伽",
            "text": "事到如今，你还打算保持沉默吗？",
            "nextDialogs": [
              "100120517"
            ]
          },
          "100120517": {
            "id": "100120517",
            "speakerId": 1326,
            "speakerName": "洛恩",
            "text": "……",
            "nextDialogs": [
              "100120518"
            ]
          },
          "100120518": {
            "id": "100120518",
            "speakerId": 1310,
            "speakerName": "法尔伽",
            "text": "这不是审讯，你可以继续沉默，但我希望你能好好坦白。",
            "nextDialogs": [
              "100120519"
            ]
          },
          "100120519": {
            "id": "100120519",
            "speakerId": 1326,
            "speakerName": "洛恩",
            "text": "——我说。",
            "nextDialogs": [
              "100120520"
            ]
          },
          "100120520": {
            "id": "100120520",
            "speakerId": 1326,
            "speakerName": "洛恩",
            "text": "…我会交代一切，也会接受任何处置。但…",
            "nextDialogs": [
              "100120521"
            ]
          },
          "100120521": {
            "id": "100120521",
            "speakerId": 1326,
            "speakerName": "洛恩",
            "text": "请再给我一晚上的时间吧。等到明天，我会去骑士团说明一切。",
            "nextDialogs": [
              "100120522"
            ]
          },
          "100120522": {
            "id": "100120522",
            "speakerId": 1326,
            "speakerName": "洛恩",
            "text": "…这是一个骑士的誓言。",
            "nextDialogs": [
              "100120523"
            ]
          },
          "100120523": {
            "id": "100120523",
            "speakerId": 1310,
            "speakerName": "法尔伽",
            "text": "唉——",
            "nextDialogs": [
              "100120524"
            ]
          },
          "100120524": {
            "id": "100120524",
            "speakerId": 1310,
            "speakerName": "法尔伽",
            "text": "…跟你共事了这么久，还是头一次听你用骑士之名起誓。",
            "nextDialogs": [
              "100120525"
            ]
          },
          "100120525": {
            "id": "100120525",
            "speakerId": 1326,
            "speakerName": "洛恩",
            "text": "哈，我知道自己的骑士之名没多少信用。",
            "nextDialogs": [
              "100120526"
            ]
          },
          "100120526": {
            "id": "100120526",
            "speakerId": 1310,
            "speakerName": "法尔伽",
            "text": "但如果算上「仁蔼骑士」的愿望，就够分量了。",
            "nextDialogs": [
              "100120527"
            ]
          },
          "100120527": {
            "id": "100120527",
            "speakerId": 1310,
            "speakerName": "法尔伽",
            "text": "这一次，就请你信守这个承诺吧，洛恩骑士。",
            "nextDialogs": [
              "100120528"
            ]
          },
          "100120528": {
            "id": "100120528",
            "speakerId": 16498,
            "speakerName": "阿多诺",
            "text": "…抱歉啊，希奥多…",
            "nextDialogs": [
              "100120529"
            ]
          },
          "100120529": {
            "id": "100120529",
            "speakerId": 16498,
            "speakerName": "阿多诺",
            "text": "我本来想把队长的位置交给洛恩，把「仁蔼」的名号留给你…我知道你从小就憧憬这个称号…",
            "nextDialogs": [
              "100120530"
            ]
          },
          "100120530": {
            "id": "100120530",
            "speakerId": 16499,
            "speakerName": "希奥多",
            "text": "这不是您的错，阿多诺先生…",
            "nextDialogs": [
              "100120531"
            ]
          },
          "100120531": {
            "id": "100120531",
            "speakerId": 16499,
            "speakerName": "希奥多",
            "text": "我没有洛恩那样的天分，轻而易举就能通过骑士团的考核…",
            "nextDialogs": [
              "100120532"
            ]
          },
          "100120532": {
            "id": "100120532",
            "speakerId": 16499,
            "speakerName": "希奥多",
            "text": "努力了那么多年，都还只是个见习医师…又怎么继承骑士的名号呢？",
            "nextDialogs": [
              "100120533"
            ]
          },
          "100120533": {
            "id": "100120533",
            "speakerId": 16498,
            "speakerName": "阿多诺",
            "text": "咳…医师也好，骑士也罢，不都一样是在保护大家吗？",
            "nextDialogs": [
              "100120534"
            ]
          },
          "100120534": {
            "id": "100120534",
            "speakerId": 16498,
            "speakerName": "阿多诺",
            "text": "在我心里，你一直配得上「仁蔼」的称号…",
            "nextDialogs": [
              "100120535"
            ]
          },
          "100120535": {
            "id": "100120535",
            "speakerId": 16499,
            "speakerName": "希奥多",
            "text": "…不，我其实做过很多错事。",
            "nextDialogs": [
              "100120536"
            ]
          },
          "100120536": {
            "id": "100120536",
            "speakerId": 16499,
            "speakerName": "希奥多",
            "text": "接下来…还要去做一件更大的错事。",
            "nextDialogs": [
              "100120537"
            ]
          },
          "100120537": {
            "id": "100120537",
            "speakerId": 1009,
            "speakerName": "迪卢克",
            "text": "…这么轻易就答应他了吗？",
            "nextDialogs": [
              "100120538"
            ]
          },
          "100120538": {
            "id": "100120538",
            "speakerId": 1310,
            "speakerName": "法尔伽",
            "text": "不然呢？难道还要他打份报告让我批准？这可饶了我们吧。",
            "nextDialogs": [
              "100120539"
            ]
          },
          "100120539": {
            "id": "100120539",
            "speakerId": 1310,
            "speakerName": "法尔伽",
            "text": "我知道阿多诺在他心里的分量，所以也相信这句誓言的重量。",
            "nextDialogs": [
              "100120540"
            ]
          },
          "100120540": {
            "id": "100120540",
            "speakerId": 1009,
            "speakerName": "迪卢克",
            "text": "从前也有个家伙，用骑士的名义向我父亲承诺过许多事，却在最后背叛了他们的友情。",
            "nextDialogs": [
              "100120541"
            ]
          },
          "100120541": {
            "id": "100120541",
            "speakerId": 1009,
            "speakerName": "迪卢克",
            "text": "「歪曲的执念和时间的变迁，会让朋友变成敌人，就像风改变它的方向那样简单。」",
            "nextDialogs": [
              "100120542"
            ]
          },
          "100120542": {
            "id": "100120542",
            "speakerId": 1310,
            "speakerName": "法尔伽",
            "text": "…是克利普斯说过的话？真让人怀念。",
            "nextDialogs": [
              "100120543"
            ]
          },
          "100120543": {
            "id": "100120543",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "你们从前…都互相认识？",
            "nextDialogs": [
              "100120544"
            ]
          },
          "100120544": {
            "id": "100120544",
            "speakerId": 1310,
            "speakerName": "法尔伽",
            "text": "三个意气风发的年轻人，曾一起畅想过各自的未来。",
            "nextDialogs": [
              "100120545"
            ]
          },
          "100120545": {
            "id": "100120545",
            "speakerId": 1310,
            "speakerName": "法尔伽",
            "text": "一名想成为骑士的富家{RUBY#[D]克利普斯}少爷，最后继承了酒庄的生意。",
            "nextDialogs": [
              "100120546"
            ]
          },
          "100120546": {
            "id": "100120546",
            "speakerId": 1310,
            "speakerName": "法尔伽",
            "text": "一个总是坏规矩的愣头{RUBY#[S]法尔伽}青，最后统领了整个骑士团。",
            "nextDialogs": [
              "100120547"
            ]
          },
          "100120547": {
            "id": "100120547",
            "speakerId": 1310,
            "speakerName": "法尔伽",
            "text": "最后那一{RUBY#[S]伊洛克}位…既没有获得向往的财富，也没有获得憧憬的力量。",
            "nextDialogs": [
              "100120548"
            ]
          },
          "100120548": {
            "id": "100120548",
            "speakerId": 1310,
            "speakerName": "法尔伽",
            "text": "只有执念，日复一日，堆积成塔。",
            "nextDialogs": [
              "100120551"
            ]
          },
          "100120551": {
            "id": "100120551",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "这就是伊洛克…被「博士」趁虚而入的原因吗？",
            "nextDialogs": [
              "100120552"
            ]
          },
          "100120552": {
            "id": "100120552",
            "speakerId": 1310,
            "speakerName": "法尔伽",
            "text": "不管那个家伙对他说了什么，做出选择的都是伊洛克自己。",
            "nextDialogs": [
              "100120553"
            ]
          },
          "100120553": {
            "id": "100120553",
            "speakerId": 1310,
            "speakerName": "法尔伽",
            "text": "理解他的想法不代表怜悯他，更不代表，我会重蹈什么覆辙。",
            "nextDialogs": [
              "100120554"
            ]
          },
          "100120554": {
            "id": "100120554",
            "speakerId": 1310,
            "speakerName": "法尔伽",
            "text": "这一次，我一定会看住我的部下…",
            "nextDialogs": [
              "100120555"
            ]
          },
          "100120555": {
            "id": "100120555",
            "speakerId": 1771,
            "speakerName": "列兹伯格",
            "text": "不——不好啦！",
            "nextDialogs": [
              "100120556"
            ]
          },
          "100120556": {
            "id": "100120556",
            "speakerId": 1310,
            "speakerName": "法尔伽",
            "text": "——我话都没说完啊？",
            "nextDialogs": [
              "100120557"
            ]
          },
          "100120557": {
            "id": "100120557",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "这声音…是从阿多诺那儿传来的？"
          }
        }
      }
    },
    {
      "subId": "1001299",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "100129901"
        ],
        "dialogs": {
          "100129901": {
            "id": "100129901",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "洛恩那家伙，昨天怎么一声不吭地就消失了…",
            "nextDialogs": [
              "100129902"
            ]
          },
          "100129902": {
            "id": "100129902",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "要不要再去阿多诺爷爷那儿找找？",
            "nextDialogs": [
              "100129903"
            ]
          },
          "100129903": {
            "id": "100129903",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "好多魔物的…咦？前面那是…迪卢克？"
          }
        }
      }
    }
  ]
}
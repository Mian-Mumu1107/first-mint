    {
      "subId": "7721101",
      "subQuestName": "靠近冰上的木屋",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "772110101"
        ],
        "dialogs": {
          "772110101": {
            "id": "772110101",
            "speakerId": 1000,
            "speakerName": "下沉的房屋",
            "text": "……",
            "nextDialogs": [
              "772110102"
            ]
          },
          "772110102": {
            "id": "772110102",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "#{NICKNAME}，你听到了吗？窸窸窣窣的声音，好像是从木房子里面传出来的…",
            "nextDialogs": [
              "772110103"
            ]
          },
          "772110103": {
            "id": "772110103",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "喂——你还在吗，丘尔卡图林！",
            "nextDialogs": [
              "772110104"
            ]
          },
          "772110104": {
            "id": "772110104",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "你还在吗——",
            "nextDialogs": [
              "772110105"
            ]
          },
          "772110105": {
            "id": "772110105",
            "speakerId": 1002,
            "speakerName": "丘尔卡图林",
            "text": "是你们，岸上的旅者。",
            "nextDialogs": [
              "772110106"
            ]
          },
          "772110106": {
            "id": "772110106",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "你还在里面！快出来吧，冰块要融化了，你的房子要沉了！",
            "nextDialogs": [
              "772110107"
            ]
          },
          "772110107": {
            "id": "772110107",
            "speakerId": 1002,
            "speakerName": "丘尔卡图林",
            "text": "是啊，冰块要融化了。",
            "nextDialogs": [
              "772110110"
            ]
          },
          "772110110": {
            "id": "772110110",
            "speakerId": 1002,
            "speakerName": "丘尔卡图林",
            "text": "上岸…谢谢你们，岸上的旅者。但是…",
            "nextDialogs": [
              "772110111"
            ]
          },
          "772110111": {
            "id": "772110111",
            "speakerId": 1002,
            "speakerName": "丘尔卡图林",
            "text": "不，我不会离开这间房屋。",
            "nextDialogs": [
              "772110112"
            ]
          },
          "772110112": {
            "id": "772110112",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "都什么时候了！不上岸的话，就要跟着这木房子一起沉到水下面去了呀。",
            "nextDialogs": [
              "772110113"
            ]
          },
          "772110113": {
            "id": "772110113",
            "speakerId": 1002,
            "speakerName": "丘尔卡图林",
            "text": "若是这片最后的、属于我的立足之地，终要在此刻，走向不可抗的下沉，那么我接受了：这也同样是我的命运。",
            "nextDialogs": [
              "772110114"
            ]
          },
          "772110114": {
            "id": "772110114",
            "speakerId": 1002,
            "speakerName": "丘尔卡图林",
            "text": "本就是我执意要增加它的重量：为了扩建、为了我对往昔荣光和体面的一点点贪恋，终让那冰块不堪重负…",
            "nextDialogs": [
              "772110115"
            ]
          },
          "772110115": {
            "id": "772110115",
            "speakerId": 1002,
            "speakerName": "丘尔卡图林",
            "text": "可这房屋…不论如何，它是我最后的栖息之所了。它承载我的肉身，也承载我身上的所有历史。",
            "nextDialogs": [
              "772110116"
            ]
          },
          "772110116": {
            "id": "772110116",
            "speakerId": 1002,
            "speakerName": "丘尔卡图林",
            "text": "它与我，本就同是旧时代仅存的遗物。如果踏出这间房屋，我也再不能找到自己在这世界上的根系。",
            "nextDialogs": [
              "772110117"
            ]
          },
          "772110117": {
            "id": "772110117",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "什么呀！那、那你不要命了！",
            "nextDialogs": [
              "772110118"
            ]
          },
          "772110118": {
            "id": "772110118",
            "speakerId": 1002,
            "speakerName": "丘尔卡图林",
            "text": "我本就是历史的幽灵，岸上的旅者。我承载着不可抛却的过去，已经度过了足够漫长的时间。",
            "nextDialogs": [
              "772110119"
            ]
          },
          "772110119": {
            "id": "772110119",
            "speakerId": 1002,
            "speakerName": "丘尔卡图林",
            "text": "除我以外，人人都可以靠岸，旅者。因为他们仍有新的生活可言。",
            "nextDialogs": [
              "772110120"
            ]
          },
          "772110120": {
            "id": "772110120",
            "speakerId": 1002,
            "speakerName": "丘尔卡图林",
            "text": "可我不同。要想开始新的生活，就必须抵偿过去，而这过去太沉重，太顽固，早已变成我生命中的一部分，难以切割。",
            "nextDialogs": [
              "772110121"
            ]
          },
          "772110121": {
            "id": "772110121",
            "speakerId": 1002,
            "speakerName": "丘尔卡图林",
            "text": "如果沉没要在此刻来临，那便让它来临。这本是我等待已久的命运。",
            "nextDialogs": [
              "772110122"
            ]
          },
          "772110122": {
            "id": "772110122",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "你还有机会选择你的命运…",
            "nextDialogs": [
              "772110123"
            ]
          },
          "772110123": {
            "id": "772110123",
            "speakerId": 1002,
            "speakerName": "丘尔卡图林",
            "text": "这就是我的「选择」，旅者。",
            "nextDialogs": [
              "772110124"
            ]
          },
          "772110124": {
            "id": "772110124",
            "speakerId": 1002,
            "speakerName": "丘尔卡图林",
            "text": "在河流上，只要知晓了风的规律，你总归大致知道，自己将漂向水域的何方。",
            "nextDialogs": [
              "772110125"
            ]
          },
          "772110125": {
            "id": "772110125",
            "speakerId": 1002,
            "speakerName": "丘尔卡图林",
            "text": "可在陆地上——陆地上的风，虽然几百年没有改变过它的轨迹，可这土地的未来，却不可以预测。",
            "nextDialogs": [
              "772110126"
            ]
          },
          "772110126": {
            "id": "772110126",
            "speakerId": 1002,
            "speakerName": "丘尔卡图林",
            "text": "如果踏上陆地…在这没有归属的土地，和它看不见尽头的未来里，我做出的选择，又有多少还属于「我」？",
            "nextDialogs": [
              "772110127"
            ]
          },
          "772110127": {
            "id": "772110127",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "糟了，冰块好像又多融化了一点…",
            "nextDialogs": [
              "772110128"
            ]
          },
          "772110128": {
            "id": "772110128",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "哎呀，别管什么选择了，快点下来吧！以后的事情以后再说。"
          }
        }
      }
    },

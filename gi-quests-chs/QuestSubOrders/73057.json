  "subQuests": [
    {
      "subId": "7305701",
      "subQuestName": "到达兰纳真所在的地区$HIDDEN",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "730570101"
        ],
        "dialogs": {
          "730570101": {
            "id": "730570101",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "唔，不见了…也是呢，他不记得我们曾经一起冒险了呀。",
            "nextDialogs": [
              "730570104"
            ]
          },
          "730570104": {
            "id": "730570104",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "嗯，你说得对…唔，对哦！",
            "nextDialogs": [
              "730570105"
            ]
          },
          "730570105": {
            "id": "730570105",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "上次兰纳真不是教给过我们一首曲子吗！我们弹奏一下，说不定他能认出来呢！"
          }
        }
      }
    },
    {
      "subId": "7305708",
      "subQuestName": "和派蒙对话 $HIDDEN",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [],
        "dialogs": {}
      }
    },
    {
      "subId": "7305702",
      "subQuestName": "弹奏兰纳真的曲调",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "730570201"
        ],
        "dialogs": {
          "730570201": {
            "id": "730570201",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "哈哈，他来啦！你好呀，小东西！",
            "nextDialogs": [
              "730570202"
            ]
          },
          "730570202": {
            "id": "730570202",
            "speakerId": 20576,
            "speakerName": "兰纳真",
            "text": "兰纳真不是小东西！你这个飞飞的白家伙才是小东西！",
            "nextDialogs": [
              "730570203"
            ]
          },
          "730570203": {
            "id": "730570203",
            "speakerId": 20576,
            "speakerName": "兰纳真",
            "text": "…话说回来，金色的「沙」…那菈，你们为什么会弹这首曲子呀？",
            "nextDialogs": [
              "730570204"
            ]
          },
          "730570204": {
            "id": "730570204",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "这个嘛…",
            "nextDialogs": [
              "730570206",
              "730570208"
            ]
          },
          "730570206": {
            "id": "730570206",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "对呀，这首曲子是我们上一次在一起冒险时，你教给我们的呀！",
            "nextDialogs": [
              "730570209"
            ]
          },
          "730570209": {
            "id": "730570209",
            "speakerId": 20576,
            "speakerName": "兰纳真",
            "text": "这样…吗？哼，兰纳真不聪明，但你们看起来不像「沙子」。",
            "nextDialogs": [
              "730570210"
            ]
          },
          "730570210": {
            "id": "730570210",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "嗯！「沙子」是「巴螺迦」，是坏蛋那菈。而我们呢，是好那菈！你告诉我们的嘛！",
            "nextDialogs": [
              "730570211"
            ]
          },
          "730570211": {
            "id": "730570211",
            "speakerId": 20576,
            "speakerName": "兰纳真",
            "text": "欸！我还和你们说过这些吗？",
            "nextDialogs": [
              "730570212"
            ]
          },
          "730570212": {
            "id": "730570212",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "#哈哈，对呀！{NICKNAME}，我们把之前的故事再给他讲一遍吧！",
            "nextDialogs": [
              "730570213"
            ]
          },
          "730570213": {
            "id": "730570213",
            "speakerId": 1002,
            "speakerName": "Black Screen",
            "text": "你们为兰纳真复述了一同冒险，最终平息「死域」的经历。",
            "nextDialogs": [
              "730570214"
            ]
          },
          "730570214": {
            "id": "730570214",
            "speakerId": 20576,
            "speakerName": "兰纳真",
            "text": "…这样啊。",
            "nextDialogs": [
              "730570215"
            ]
          },
          "730570215": {
            "id": "730570215",
            "speakerId": 20576,
            "speakerName": "兰纳真",
            "text": "兰纳真不聪明，但你们说的，应该是真的。兰纳真不记得了，对不起。",
            "nextDialogs": [
              "730570216"
            ]
          },
          "730570216": {
            "id": "730570216",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "没有必要对不起呀！唔，记不得事情很正常啦…况且，我们还可以重新交朋友呀？"
          },
          "730570208": {
            "id": "730570208",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "#嘿嘿，{NICKNAME}弹得怎么样？我们还记得你教的曲谱哦！"
          }
        }
      }
    },

      }
    },
    {
      "subId": "7305710",
      "subQuestName": "调查树屋$HIDDEN",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "730571001"
        ],
        "dialogs": {
          "730571001": {
            "id": "730571001",
            "speakerId": 20576,
            "speakerName": "兰纳真",
            "text": "#谢谢那菈{NICKNAME}和白飞飞！我要去兰纳迦那边啦，请去那边找我吧！"
          }
        }
      }
    },
    {
      "subId": "7305712",
      "subQuestName": "和兰纳真对话 $HIDDEN",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "730570401"
        ],
        "dialogs": {
          "730570401": {
            "id": "730570401",
            "speakerId": 20576,
            "speakerName": "兰纳真",
            "text": "这是那菈的琴，兰纳真一直留着。但它应该唱不出歌来了…上面的弦已经走调了。",
            "nextDialogs": [
              "730570402"
            ]
          },
          "730570402": {
            "id": "730570402",
            "speakerId": 1003,
            "speakerName": "古旧的乌德琴",
            "text": "（一柄古旧的乌德琴，其上有几处断裂的痕迹，但看起来被修补和保存得很妥善。）"
          }
        }
      }
    },
    {
      "subId": "7305711",
      "subQuestName": "调查树屋$HIDDEN",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [],
        "dialogs": {}
      }
    },
    {
      "subId": "7305713",
      "subQuestName": "调查后的对话 $HIDDEN",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "730570501"
        ],
        "dialogs": {
          "730570501": {
            "id": "730570501",
            "speakerId": 20576,
            "speakerName": "兰纳真",
            "text": "那菈的…嗯，那个叫什么？兰纳真不需要这个睡觉，所以不知道这个词…",
            "nextDialogs": [
              "730570502"
            ]
          },
          "730570502": {
            "id": "730570502",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "是「床」，看起来还很新呢…之前有人在这里睡过吗？",
            "nextDialogs": [
              "730570503"
            ]
          },
          "730570503": {
            "id": "730570503",
            "speakerId": 20576,
            "speakerName": "兰纳真",
            "text": "嘿嘿，兰纳真一直在整理…你们想要在这里睡觉，也是可以的哦！"
          }
        }
      }
    },
    {
      "subId": "7305715",
      "subQuestName": "调查树屋",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [],
        "dialogs": {}
      }
    },
    {
      "subId": "7305714",
      "subQuestName": "和兰纳真对话",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "730570601"
        ],
        "dialogs": {
          "730570601": {
            "id": "730570601",
            "speakerId": 20576,
            "speakerName": "兰纳真",
            "text": "楼上还有那菈留下的叶子，但是…我看不懂，看不明白…",
            "nextDialogs": [
              "730570602"
            ]
          },
          "730570602": {
            "id": "730570602",
            "speakerId": 20576,
            "speakerName": "兰纳真",
            "text": "那个是…那菈用来留下记忆的叶子，在这样的叶子上面写下文字，收拢在一起。但那菈的文字，兰纳真不明白。",
            "nextDialogs": [
              "730570606"
            ]
          },
          "730570606": {
            "id": "730570606",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "你是不是说…「记事本」呀？",
            "nextDialogs": [
              "730570603"
            ]
          },
          "730570603": {
            "id": "730570603",
            "speakerId": 20576,
            "speakerName": "兰纳真",
            "text": "「记事本」…？那就是那菈用来留下记忆的东西吗？",
            "nextDialogs": [
              "730570604"
            ]
          },
          "730570604": {
            "id": "730570604",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "嗯，是呀…兰纳真介意我们上楼去，一起看看里面写了什么吗？",
            "nextDialogs": [
              "730570605"
            ]
          },
          "730570605": {
            "id": "730570605",
            "speakerId": 20576,
            "speakerName": "兰纳真",
            "text": "我吗？不介意的！"
          }
        }
      }
    },
    {
      "subId": "7305705",
      "subQuestName": "阅读树屋二楼的笔记",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "730570901"
        ],
        "dialogs": {
          "730570901": {
            "id": "730570901",
            "speakerId": 20765,
            "speakerName": "古旧的记事本",
            "text": "「…修好了被巴克尔伯伯摔坏的乌德琴，请不要自己一个人哭了，好吗？不开心的话，就同我和海亚姆讲吧…」",
            "nextDialogs": [
              "730570902"
            ]
          },
          "730570902": {
            "id": "730570902",
            "speakerId": 20765,
            "speakerName": "古旧的记事本",
            "text": "「…我被教令院录取了，恭喜我吧！我才不要当什么『战士的新娘』，我将来要做的是『大贤者熙蔓』！」",
            "nextDialogs": [
              "730570903"
            ]
          },
          "730570903": {
            "id": "730570903",
            "speakerId": 20765,
            "speakerName": "古旧的记事本",
            "text": "「…嘿嘿，『大乐师』伊尔凡和聪明鬼海亚姆！分别了可不要忘记我呀！尤其是你，海亚姆，不要忘了我！」",
            "nextDialogs": [
              "730570904"
            ]
          },
          "730570904": {
            "id": "730570904",
            "speakerId": 20765,
            "speakerName": "古旧的记事本",
            "text": "「…再会，记事本！再会，伊尔凡，熙蔓，我最好的朋友！愿森林永远记得我们的故事，希望我们记得对方…」",
            "nextDialogs": [
              "730570905"
            ]
          },
          "730570905": {
            "id": "730570905",
            "speakerId": 20765,
            "speakerName": "古旧的记事本",
            "text": "（…接下来的内容杂乱而热闹，充满了孩子们快乐与悲伤的回忆…）",
            "nextDialogs": [
              "730570906"
            ]
          },
          "730570906": {
            "id": "730570906",
            "speakerId": 20765,
            "speakerName": "古旧的记事本",
            "text": "「…兰纳真不见了，不知从什么时候，不见了。我也是时候告别乌德琴了，做个匠人吧，像父亲期望的那样…」",
            "nextDialogs": [
              "730570907"
            ]
          },
          "730570907": {
            "id": "730570907",
            "speakerId": 20765,
            "speakerName": "古旧的记事本",
            "text": "（下面似乎还写了什么内容，但都被划去涂黑了。）",
            "nextDialogs": [
              "730570908"
            ]
          },
          "730570908": {
            "id": "730570908",
            "speakerId": 20765,
            "speakerName": "古旧的记事本",
            "text": "「…正在阅读这个记事本的，多年以后的我，如果还能奇迹般地遇见兰纳真他们，就请把这朵花送还给他吧…」",
            "nextDialogs": [
              "730570909"
            ]
          },
          "730570909": {
            "id": "730570909",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "欸…好像有什么从书里掉出来了！",
            "nextDialogs": [
              "730570910"
            ]
          },
          "730570910": {
            "id": "730570910",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "好像是…一朵花？和我们拿到的…一样呢。"
          }
        }
      }
    },
    {
      "subId": "7305706",
      "subQuestName": "和兰纳真对话",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "730570701"
        ],
        "dialogs": {
          "730570701": {
            "id": "730570701",
            "speakerId": 20576,
            "speakerName": "兰纳真",
            "text": "里面有什么样的记忆呢？你们看到什么了吗？",
            "nextDialogs": [
              "730570702"
            ]
          },
          "730570702": {
            "id": "730570702",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "记事本的主人似乎认识你。",
            "nextDialogs": [
              "730570703"
            ]
          },
          "730570703": {
            "id": "730570703",
            "speakerId": 20576,
            "speakerName": "兰纳真",
            "text": "这样吗…我不记得了呀…",
            "nextDialogs": [
              "730570704"
            ]
          },
          "730570704": {
            "id": "730570704",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "他说…他也看不见你了，是因为长大了吧…",
            "nextDialogs": [
              "730570705"
            ]
          },
          "730570705": {
            "id": "730570705",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "唔…长大还真是会有很多苦恼呢。",
            "nextDialogs": [
              "730570706"
            ]
          },
          "730570706": {
            "id": "730570706",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "对了，他还在记事本里说…这朵花留给你！",
            "nextDialogs": [
              "730570707"
            ]
          },
          "730570707": {
            "id": "730570707",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "在这里。",
            "nextDialogs": [
              "730570708"
            ]
          },
          "730570708": {
            "id": "730570708",
            "speakerId": 20576,
            "speakerName": "兰纳真",
            "text": "咦…？呀！这是很重要的花！你怎么会…他怎么会有的？",
            "nextDialogs": [
              "730570709"
            ]
          },
          "730570709": {
            "id": "730570709",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "同样的花，其实你也给过我们哦…只是你不记得了。",
            "nextDialogs": [
              "730570710"
            ]
          },
          "730570710": {
            "id": "730570710",
            "speakerId": 20576,
            "speakerName": "兰纳真",
            "text": "这样吗…我能和你们重新做朋友。可是…他的话，我连他的样子都记不得了…",
            "nextDialogs": [
              "730570711"
            ]
          },
          "730570711": {
            "id": "730570711",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "没、没关系啦…你不要伤心呀，我们还有这朵花，一定能给你更多回忆的，对吧？",
            "nextDialogs": [
              "730570712"
            ]
          },
          "730570712": {
            "id": "730570712",
            "speakerId": 20576,
            "speakerName": "兰纳真",
            "text": "嗯，白飞飞说得对。",
            "nextDialogs": [
              "730570713"
            ]
          },
          "730570713": {
            "id": "730570713",
            "speakerId": 20576,
            "speakerName": "兰纳真",
            "text": "我要把这朵花带回去，「无郁夷摩」应该知道怎样才能让她醒来。",
            "nextDialogs": [
              "730570714"
            ]
          },
          "730570714": {
            "id": "730570714",
            "speakerId": 20576,
            "speakerName": "兰纳真",
            "text": "#唔…那菈{NICKNAME}和白飞飞，我要回兰纳迦那边了，把她种下，听她的歌。如果你们有空的话，也请来吧！",
            "nextDialogs": [
              "730570715"
            ]
          },
          "730570715": {
            "id": "730570715",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "嗯嗯，一定！"
          }
        }
      }
    },
    {

        ],
        "dialogs": {
          "411480601": {
            "id": "411480601",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "这是您订的餐。",
            "nextDialogs": [
              "411480602"
            ]
          },
          "411480602": {
            "id": "411480602",
            "speakerId": 30029,
            "speakerName": "好奇的子瑞",
            "text": "总算送到了，谢谢，谢谢。",
            "nextDialogs": [
              "411480603"
            ]
          },
          "411480603": {
            "id": "411480603",
            "speakerId": 30029,
            "speakerName": "好奇的子瑞",
            "text": "吃饱了之后我还得去周围逛逛。",
            "nextDialogs": [
              "411480604"
            ]
          },
          "411480604": {
            "id": "411480604",
            "speakerId": 30029,
            "speakerName": "好奇的子瑞",
            "text": "唉，这周围也没几块能入眼的石头…"
          }
        }
      }
    },
    {
      "subId": "4114803",

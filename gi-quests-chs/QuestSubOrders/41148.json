          },
          "411480302": {
            "id": "411480302",
            "speakerId": 2045,
            "speakerName": "卯师傅",
            "text": "对，一位叫子瑞的小伙子在我们这订了一份摩拉肉，钱已经付好了。",
            "nextDialogs": [
              "411480303"
            ]
          },
          "411480303": {
            "id": "411480303",
            "speakerId": 2045,
            "speakerName": "卯师傅",
            "text": "然后…他让我们晚些时候送到渌华池附近的一个地方。",
            "nextDialogs": [
              "411480304"
            ]
          },
          "411480304": {
            "id": "411480304",
            "speakerId": 2045,
            "speakerName": "卯师傅",
            "text": "我还要在这看着店，你愿意帮我去跑一趟吗？"
          }
        }

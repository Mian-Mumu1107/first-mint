    {
      "subId": "4114801",
      "subQuestName": "与卯师傅对话",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "411480101"
        ],
        "dialogs": {
          "411480101": {
            "id": "411480101",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "我这就送过去。",
            "nextDialogs": [
              "411480102"
            ]
          },
          "411480102": {
            "id": "411480102",
            "speakerId": 2045,
            "speakerName": "卯师傅",
            "text": "那就拜托你了。",
            "nextDialogs": [
              "411480103"
            ]
          },
          "411480103": {
            "id": "411480103",
            "speakerId": 2045,
            "speakerName": "卯师傅",
            "text": "记得送的时候小心着点，<color=#00E1FFFF>不要沾了奇怪的东西。还有千万别用风之翼</color>。",
            "nextDialogs": [
              "411480104"
            ]
          },
          "411480104": {
            "id": "411480104",
            "speakerId": 2045,
            "speakerName": "卯师傅",
            "text": "不然这摩拉肉里的肉，非全被颠出来不可…"
          }
        }
      }
    },
    {
      "subId": "4114802",
      "subQuestName": "将餐品送给好奇的子瑞",
      "sceneId": null,

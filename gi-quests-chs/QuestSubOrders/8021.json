  "subQuests": [
    {
      "subId": "802106",
      "subQuestName": "返回维摩庄",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "80210601"
        ],
        "dialogs": {
          "80210601": {
            "id": "80210601",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "这里这里！它们难道是睡着了吗…",
            "nextDialogs": [
              "80210602"
            ]
          },
          "80210602": {
            "id": "80210602",
            "speakerId": 1001,
            "speakerName": "谜之声",
            "text": "…在最后，他轻轻地说道，",
            "nextDialogs": [
              "80210603"
            ]
          },
          "80210603": {
            "id": "80210603",
            "speakerId": 1001,
            "speakerName": "谜之声",
            "text": "「安睡吧，父亲。安睡吧，我爱的人们。」",
            "nextDialogs": [
              "80210604"
            ]
          },
          "80210604": {
            "id": "80210604",
            "speakerId": 1001,
            "speakerName": "谜之声",
            "text": "「再次醒来的时候，我们不再区分彼此。」"
          }
        }
      }
    },
    {
      "subId": "802107",
      "subQuestName": "查看丘丘人的状态",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "80210101"
        ],
        "dialogs": {
          "80210101": {
            "id": "80210101",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "#欸，{NICKNAME}，你看那边的丘丘人…",
            "nextDialogs": [
              "80210102"
            ]
          },
          "80210102": {
            "id": "80210102",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "似乎有些…安静？",
            "nextDialogs": [
              "80210103"
            ]
          },
          "80210103": {
            "id": "80210103",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "之前不是还格外躁动不安的吗？现在怎么又变得格外安静了…",
            "nextDialogs": [
              "80210104"
            ]
          },
          "80210104": {
            "id": "80210104",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "（…等等，好像有什么声音…）",
            "nextDialogs": [
              "80210105"
            ]
          },
          "80210105": {
            "id": "80210105",
            "speakerId": 1001,
            "speakerName": "谜之声",
            "text": "…在新的世界，他们告别蒙尘的太阳，",
            "nextDialogs": [
              "80210106"
            ]
          },
          "80210106": {
            "id": "80210106",
            "speakerId": 1001,
            "speakerName": "谜之声",
            "text": "终于不再思考那些苦难，不必再甄别关于亵渎的概念。",
            "nextDialogs": [
              "80210107"
            ]
          },
          "80210107": {
            "id": "80210107",
            "speakerId": 1001,
            "speakerName": "谜之声",
            "text": "以此为代价，灵魂变得纯净而透明。"
          }
        }
      }
    },
    {
      "subId": "802108",
      "subQuestName": "查看丘丘人的状态",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "80210301"
        ],
        "dialogs": {
          "80210301": {
            "id": "80210301",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "还有这边的丘丘人，它们也安静下来了…",
            "nextDialogs": [
              "80210302"
            ]
          },
          "80210302": {
            "id": "80210302",
            "speakerId": 1001,
            "speakerName": "谜之声",
            "text": "…看啊，你我都在呢。",
            "nextDialogs": [
              "80210303"
            ]
          },
          "80210303": {
            "id": "80210303",
            "speakerId": 1001,
            "speakerName": "谜之声",
            "text": "我们换回了无尽的时间去爱，",
            "nextDialogs": [
              "80210304"
            ]
          },
          "80210304": {
            "id": "80210304",
            "speakerId": 1001,
            "speakerName": "谜之声",
            "text": "悲伤时也不需要再握住任何一滴眼泪。"
          }
        }
      }
    },
    {
      "subId": "802109",
      "subQuestName": "查看丘丘人的状态",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [],
        "dialogs": {}
      }
    },
    {
      "subId": "802110",
      "subQuestName": "与阿玛兹亚对话",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "80210701"
        ],
        "dialogs": {
          "80210701": {
            "id": "80210701",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "阿玛兹亚爷爷，你们没事吧？附近的深渊教团好像在活动…",
            "nextDialogs": [
              "80210702"
            ]
          },
          "80210702": {
            "id": "80210702",
            "speakerId": 14313,
            "speakerName": "阿玛兹亚",
            "text": "深渊教团在活动？这倒是头一次听说…",
            "nextDialogs": [
              "80210703"
            ]
          },
          "80210703": {
            "id": "80210703",
            "speakerId": 14313,
            "speakerName": "阿玛兹亚",
            "text": "谢谢你们的关心，至少在我看来，今天的维摩庄一如往常。",
            "nextDialogs": [
              "80210704"
            ]
          },
          "80210704": {
            "id": "80210704",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "是吗，那就好。",
            "nextDialogs": [
              "80210705"
            ]
          },
          "80210705": {
            "id": "80210705",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "哦对了，今天我们不在的时候，有发现什么关于失踪者的线索吗？",
            "nextDialogs": [
              "80210706"
            ]
          },
          "80210706": {
            "id": "80210706",
            "speakerId": 14313,
            "speakerName": "阿玛兹亚",
            "text": "失踪者…？你们指的是谁？谁失踪了？",
            "nextDialogs": [
              "80210707"
            ]
          },
          "80210707": {
            "id": "80210707",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "啊…？",
            "nextDialogs": [
              "80210710"
            ]
          },
          "80210710": {
            "id": "80210710",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "就是…就是你们一直在找的那个，维摩庄的年轻人呀，还去须弥的冒险家协会发布了委托。",
            "nextDialogs": [
              "80210711"
            ]
          },
          "80210711": {
            "id": "80210711",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "若不是接到那个寻人委托，我们也不会到维摩庄来。",
            "nextDialogs": [
              "80210712"
            ]
          },
          "80210712": {
            "id": "80210712",
            "speakerId": 14313,
            "speakerName": "阿玛兹亚",
            "text": "…实在不好意思，你们先不要着急。有可能是我年纪大了，忘记了什么…",
            "nextDialogs": [
              "80210713"
            ]
          },
          "80210713": {
            "id": "80210713",
            "speakerId": 14313,
            "speakerName": "阿玛兹亚",
            "text": "但至少此时此刻，我对你们所说的这些事都一概不知…不如你们再找别人问问看？",
            "nextDialogs": [
              "80210714"
            ]
          },
          "80210714": {
            "id": "80210714",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "怎么会…唔，好吧，真是打扰你了，阿玛兹亚爷爷。",
            "nextDialogs": [
              "80210715"
            ]
          },
          "80210715": {
            "id": "80210715",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "肯定有蹊跷，我们之前刚和阿玛兹亚爷爷聊过那个失踪者的事，不可能今天就突然忘记了呀…",
            "nextDialogs": [
              "80210716"
            ]
          },
          "80210716": {
            "id": "80210716",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "#你怎么看，{NICKNAME}，难道说维摩庄的大家关于失踪者的记忆又被抹除了？"
          }
        }
      }
    },
    {
      "subId": "802111",
      "subQuestName": "与巴兰对话",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "80210801"
        ],
        "dialogs": {
          "80210801": {
            "id": "80210801",
            "speakerId": 14314,
            "speakerName": "巴兰",
            "text": "失踪者？谁呀？",
            "nextDialogs": [
              "80210802"
            ]
          },
          "80210802": {
            "id": "80210802",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "呃…果然也是这种反应吗…",
            "nextDialogs": [
              "80210803"
            ]
          },
          "80210803": {
            "id": "80210803",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "就是那位你还夸过他的，经常和你聊天的小伙子…",
            "nextDialogs": [
              "80210804"
            ]
          },
          "80210804": {
            "id": "80210804",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "二十多岁，你说他又和善又热情…",
            "nextDialogs": [
              "80210805"
            ]
          },
          "80210805": {
            "id": "80210805",
            "speakerId": 14314,
            "speakerName": "巴兰",
            "text": "哦~！我知道你们说的是谁了…",
            "nextDialogs": [
              "80210806"
            ]
          },
          "80210806": {
            "id": "80210806",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "欸！你确定吗？现在想起来了？",
            "nextDialogs": [
              "80210807"
            ]
          },
          "80210807": {
            "id": "80210807",
            "speakerId": 14314,
            "speakerName": "巴兰",
            "text": "我很少对现在的年轻人评价这么高，如果你确定那是我给出的评价的话…",
            "nextDialogs": [
              "80210808"
            ]
          },
          "80210808": {
            "id": "80210808",
            "speakerId": 14314,
            "speakerName": "巴兰",
            "text": "答案应该就只有「他」了，不会错…可你们为什么说他失踪了？",
            "nextDialogs": [
              "80210811"
            ]
          },
          "80210811": {
            "id": "80210811",
            "speakerId": 14314,
            "speakerName": "巴兰",
            "text": "哦，我刚刚才看到他和别人一起出村去了，应该不会走很远。"
          }
        }
      }
    },
    {
      "subId": "802112",
      "subQuestName": "对现状进行推理",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "80211901"
        ],
        "dialogs": {
          "80211901": {
            "id": "80211901",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "我…我想起来了！阿托莎是这么说过…",
            "nextDialogs": [
              "80211902"
            ]
          },
          "80211902": {
            "id": "80211902",
            "speakerId": 14074,
            "speakerName": "阿托莎",
            "text": "这么说来，好像每次和他聊天，也都是在这样的黄昏时分。",
            "nextDialogs": [
              "80211903"
            ]
          },
          "80211903": {
            "id": "80211903",
            "speakerId": 14074,
            "speakerName": "阿托莎",
            "text": "在记忆里，时间会变得很慢很慢，有时候感觉明明聊了很久很久，可是天却还没有暗下来…",
            "nextDialogs": [
              "80211904"
            ]
          },
          "80211904": {
            "id": "80211904",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "没错！这就是关键了，这里毫无疑问就是阿托莎的记忆！",
            "nextDialogs": [
              "80211907"
            ]
          },
          "80211907": {
            "id": "80211907",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "嗯！他和阿托莎一定在那里！"
          }
        }
      }
    },
    {
      "subId": "802113",
      "subQuestName": "前往阿托莎曾经指引的地方",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "80212101"
        ],
        "dialogs": {
          "80212101": {
            "id": "80212101",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "你是…卡利贝尔·亚尔伯里奇。",
            "nextDialogs": [
              "80212102"
            ]
          },
          "80212102": {
            "id": "80212102",
            "speakerId": 13170,
            "speakerName": "卡利贝尔",
            "text": "啊…你认识我？真是令人惊讶，我明明没有见过你…",
            "nextDialogs": [
              "80212103"
            ]
          },
          "80212103": {
            "id": "80212103",
            "speakerId": 13170,
            "speakerName": "卡利贝尔",
            "text": "哦，我明白了，是「记忆」吧？通过你血亲的记忆…见到过「那个时期」的我。",
            "nextDialogs": [
              "80212104"
            ]
          },
          "80212104": {
            "id": "80212104",
            "speakerId": 13170,
            "speakerName": "卡利贝尔",
            "text": "这里是阿托莎的记忆，本来我是想来向她道别的…",
            "nextDialogs": [
              "80212105"
            ]
          },
          "80212105": {
            "id": "80212105",
            "speakerId": 13170,
            "speakerName": "卡利贝尔",
            "text": "我们还是换个地方聊吧，至于道别的事…就稍微留下些信息给阿托莎好了。"
          }
        }
      }
    },

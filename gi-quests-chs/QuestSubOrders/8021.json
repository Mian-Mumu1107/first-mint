    {
      "subId": "802102",
      "subQuestName": "与卡利贝尔对话",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "80212201"
        ],
        "dialogs": {
          "80212201": {
            "id": "80212201",
            "speakerId": 13170,
            "speakerName": "卡利贝尔",
            "text": "呼…呼…",
            "nextDialogs": [
              "80212202"
            ]
          },
          "80212202": {
            "id": "80212202",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "这里是…？",
            "nextDialogs": [
              "80212203"
            ]
          },
          "80212203": {
            "id": "80212203",
            "speakerId": 13170,
            "speakerName": "卡利贝尔",
            "text": "你可以理解为，是我的「意识空间」吧，毕竟你们已经知道我在现实中「并不存在」了。",
            "nextDialogs": [
              "80212204"
            ]
          },
          "80212204": {
            "id": "80212204",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "你看起来很累。",
            "nextDialogs": [
              "80212205"
            ]
          },
          "80212205": {
            "id": "80212205",
            "speakerId": 13170,
            "speakerName": "卡利贝尔",
            "text": "没关系，招待客人的力气我还是有的。一直都希望能有机会和你这样聊聊天，这个愿望终于实现了。",
            "nextDialogs": [
              "80212206"
            ]
          },
          "80212206": {
            "id": "80212206",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "（对我来说，现在同样是个难得的机会，尽可能地从卡利贝尔身上获取情报吧。）",
            "nextDialogs": [
              "80212209"
            ]
          },
          "80212209": {
            "id": "80212209",
            "speakerId": 13170,
            "speakerName": "卡利贝尔",
            "text": "极度的悲伤与苦痛，血脉中流淌的期望与悔恨，再加上量级超乎常识的深渊力量…",
            "nextDialogs": [
              "80212210"
            ]
          },
          "80212210": {
            "id": "80212210",
            "speakerId": 13170,
            "speakerName": "卡利贝尔",
            "text": "父亲曾说，具备了这一切，我便会成为命运的织机。",
            "nextDialogs": [
              "80212211"
            ]
          },
          "80212211": {
            "id": "80212211",
            "speakerId": 13170,
            "speakerName": "卡利贝尔",
            "text": "但事实上，并不能说是我成为了命运的织机，命运的织机只是利用我「搭建」了起来…",
            "nextDialogs": [
              "80212212"
            ]
          },
          "80212212": {
            "id": "80212212",
            "speakerId": 13170,
            "speakerName": "卡利贝尔",
            "text": "其实在那一刻，卡利贝尔·亚尔伯里奇就已经死了。",
            "nextDialogs": [
              "80212213"
            ]
          },
          "80212213": {
            "id": "80212213",
            "speakerId": 13170,
            "speakerName": "卡利贝尔",
            "text": "现在在你面前的我，不过是命运的织机中残留的一个意识罢了。",
            "nextDialogs": [
              "80212214"
            ]
          },
          "80212214": {
            "id": "80212214",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "（卡利贝尔已经死了…所以才不存在于现实中。）",
            "nextDialogs": [
              "80212215"
            ]
          },
          "80212215": {
            "id": "80212215",
            "speakerId": 13170,
            "speakerName": "卡利贝尔",
            "text": "至于「命运的织机」…则是可以用来编织地脉的机器。",
            "nextDialogs": [
              "80212216"
            ]
          },
          "80212216": {
            "id": "80212216",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "编织…地脉？",
            "nextDialogs": [
              "80212217"
            ]
          },
          "80212217": {
            "id": "80212217",
            "speakerId": 13170,
            "speakerName": "卡利贝尔",
            "text": "起初只能用来创造和投放一些记忆，随着命运的织机逐渐完成，效果会越来越强…直至可以编织出真正的地脉。",
            "nextDialogs": [
              "80212218"
            ]
          },
          "80212218": {
            "id": "80212218",
            "speakerId": 13170,
            "speakerName": "卡利贝尔",
            "text": "而当命运的织机彻底完成，能够编织地脉的一刻，低层次的影响记忆的能力便会消失…",
            "nextDialogs": [
              "80212219"
            ]
          },
          "80212219": {
            "id": "80212219",
            "speakerId": 13170,
            "speakerName": "卡利贝尔",
            "text": "…从而成为真正「世界级」的工具。",
            "nextDialogs": [
              "80212220"
            ]
          },
          "80212220": {
            "id": "80212220",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "这就是你投放记忆的能力的根源？",
            "nextDialogs": [
              "80212221"
            ]
          },
          "80212221": {
            "id": "80212221",
            "speakerId": 13170,
            "speakerName": "卡利贝尔",
            "text": "嗯，在命运的织机完成之前，操纵这台半成品的权限对我来说也算是一种补偿吧。",
            "nextDialogs": [
              "80212222"
            ]
          },
          "80212222": {
            "id": "80212222",
            "speakerId": 13170,
            "speakerName": "卡利贝尔",
            "text": "…毕竟我曾为它献出生命。",
            "nextDialogs": [
              "80212223"
            ]
          },
          "80212223": {
            "id": "80212223",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "（看来当时突然出现在戴因头脑里的记忆，就是卡利贝尔这样通过命运的织机半成品来投放的…）",
            "nextDialogs": [
              "80212224"
            ]
          },
          "80212224": {
            "id": "80212224",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "（这一点算是搞清楚了…但依旧令人费解的是，关于维摩庄的村民们…）"
          }
        }
      }
    },
    {
      "subId": "802103",
      "subQuestName": "与卡利贝尔对话",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [],
        "dialogs": {}
      }
    },
    {
      "subId": "802104",
      "subQuestName": "与你的血亲对话",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "80210401"
        ],
        "dialogs": {
          "80210401": {
            "id": "80210401",
            "speakerId": 1006,
            "speakerName": "Sibling",
            "text": "我们随便聊聊吧。",
            "nextDialogs": [
              "80210402"
            ]
          },
          "80210402": {
            "id": "80210402",
            "speakerId": 1006,
            "speakerName": "Sibling",
            "text": "能有机会像这样停下脚步，和你放松地聊天，是多么难得的一件事…你应该也是这么想的吧？",
            "nextDialogs": [
              "80210405"
            ]
          },
          "80210405": {
            "id": "80210405",
            "speakerId": 1006,
            "speakerName": "Sibling",
            "text": "刚才那场战斗可真是够呛…",
            "nextDialogs": [
              "80210406"
            ]
          },
          "80210406": {
            "id": "80210406",
            "speakerId": 1006,
            "speakerName": "Sibling",
            "text": "哦，我是说我和戴因。",
            "nextDialogs": [
              "80210407"
            ]
          },
          "80210407": {
            "id": "80210407",
            "speakerId": 1006,
            "speakerName": "Sibling",
            "text": "想不到如今，他向我挥剑的时候仍会有所犹豫…",
            "nextDialogs": [
              "80210408"
            ]
          },
          "80210408": {
            "id": "80210408",
            "speakerId": 1006,
            "speakerName": "Sibling",
            "text": "否则我恐怕依然不是「末光之剑」的对手，五百年前更是如此。"
          }
        }
      }
    },
    {
      "subId": "802105",
      "subQuestName": "回到维摩庄",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "80210501"
        ],
        "dialogs": {
          "80210501": {
            "id": "80210501",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "哈欠——好困，感觉头还是昏沉沉的…",
            "nextDialogs": [
              "80210502"
            ]
          },
          "80210502": {
            "id": "80210502",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "我比你醒来得稍微早一点，维摩庄的村民说，他们看到昨天咱们两个睡在村子附近，怎么也喊不醒…所以就把我们带回来了。",
            "nextDialogs": [
              "80210503"
            ]
          },
          "80210503": {
            "id": "80210503",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "哦对了，刚刚戴因来过了，好像受了点伤…",
            "nextDialogs": [
              "80210504"
            ]
          },
          "80210504": {
            "id": "80210504",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "确认你没事之后就心事重重地离开了，没关系吧，那家伙…",
            "nextDialogs": [
              "80210507"
            ]
          },
          "80210507": {
            "id": "80210507",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "等等…让我回想回想，记忆中好像我们两个一起见到了那位…被你称呼为「卡利贝尔」的人？",
            "nextDialogs": [
              "80210508"
            ]
          },
          "80210508": {
            "id": "80210508",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "他就是这次我们要找的失踪者吗？后来怎么样了，我没有印象了…"
          }
        }
      }
    },
    {
      "subId": "802114",
      "subQuestName": "寻找阿托莎",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "80211101"
        ],
        "dialogs": {
          "80211101": {
            "id": "80211101",
            "speakerId": 14074,
            "speakerName": "阿托莎",
            "text": "……",
            "nextDialogs": [
              "80211102"
            ]
          },
          "80211102": {
            "id": "80211102",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "阿托莎，你是在这里发呆吗？",
            "nextDialogs": [
              "80211103"
            ]
          },
          "80211103": {
            "id": "80211103",
            "speakerId": 14074,
            "speakerName": "阿托莎",
            "text": "啊，是你们啊，我还想去找你们道谢呢。",
            "nextDialogs": [
              "80211104"
            ]
          },
          "80211104": {
            "id": "80211104",
            "speakerId": 14074,
            "speakerName": "阿托莎",
            "text": "我参加了搜索小队，在路上也想起来卡利贝尔先生的事了。",
            "nextDialogs": [
              "80211105"
            ]
          },
          "80211105": {
            "id": "80211105",
            "speakerId": 14074,
            "speakerName": "阿托莎",
            "text": "真是的…明明是这么重要的回忆，我怎么会说忘就忘记了呢…",
            "nextDialogs": [
              "80211107",
              "80211109"
            ]
          },
          "80211107": {
            "id": "80211107",
            "speakerId": 14074,
            "speakerName": "阿托莎",
            "text": "对我来说，他是那样匆匆出现，又匆匆离开…",
            "nextDialogs": [
              "80211126"
            ]
          },
          "80211126": {
            "id": "80211126",
            "speakerId": 14074,
            "speakerName": "阿托莎",
            "text": "如果卡利贝尔先生想要试着否定这段时光的话，我会试试看的。",
            "nextDialogs": [
              "80211127"
            ]
          },
          "80211127": {
            "id": "80211127",
            "speakerId": 14074,
            "speakerName": "阿托莎",
            "text": "从心底里对他产生的那些依赖，只要时间过得足够久，总有一天可以「戒掉」的吧。",
            "nextDialogs": [
              "80211128"
            ]
          },
          "80211128": {
            "id": "80211128",
            "speakerId": 1007,
            "speakerName": "Black Screen",
            "text": "「要好好相处呀，你们兄妹两个。」"
          },
          "80211109": {
            "id": "80211109",
            "speakerId": 14074,
            "speakerName": "阿托莎",
            "text": "我好像隐约有印象，他是这样告诉过我…是什么时候来着？算了…",
            "nextDialogs": [
              "80211110"
            ]
          },
          "80211110": {
            "id": "80211110",
            "speakerId": 14074,
            "speakerName": "阿托莎",
            "text": "人的一生是由回忆组成的，有关他的回忆已经是我人生的一部分了。",
            "nextDialogs": [
              "80211111"
            ]
          },
          "80211111": {
            "id": "80211111",
            "speakerId": 14074,
            "speakerName": "阿托莎",
            "text": "只要我能因为遇见过他而感到幸运就够了，至于未来…谁在乎呢？",
            "nextDialogs": [
              "80211112"
            ]
          },
          "80211112": {
            "id": "80211112",
            "speakerId": 14074,
            "speakerName": "阿托莎",
            "text": "……",
            "nextDialogs": [
              "80211113"
            ]
          },
          "80211113": {
            "id": "80211113",
            "speakerId": 14074,
            "speakerName": "阿托莎",
            "text": "好啦，我承认我是在嘴硬。",
            "nextDialogs": [
              "80211114"
            ]
          },
          "80211114": {
            "id": "80211114",
            "speakerId": 14074,
            "speakerName": "阿托莎",
            "text": "我其实…是被甩了吧？",
            "nextDialogs": [
              "80211115"
            ]
          },
          "80211115": {
            "id": "80211115",
            "speakerId": 14074,
            "speakerName": "阿托莎",
            "text": "…不然卡利贝尔先生怎么会不来和我当面道别，而是直接离开了呢？",
            "nextDialogs": [
              "80211116"
            ]
          },
          "80211116": {
            "id": "80211116",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "他…有自己的原因吧。",
            "nextDialogs": [
              "80211117"
            ]
          },
          "80211117": {
            "id": "80211117",
            "speakerId": 14074,
            "speakerName": "阿托莎",
            "text": "呵呵，不用安慰我，我没事的。",
            "nextDialogs": [
              "80211118"
            ]
          },
          "80211118": {
            "id": "80211118",
            "speakerId": 14074,
            "speakerName": "阿托莎",
            "text": "就像卡利贝尔先生常说的，正是因为会有这样那样的事情发生，人生才显得可贵。",
            "nextDialogs": [
              "80211119"
            ]
          },
          "80211119": {
            "id": "80211119",
            "speakerId": 14074,
            "speakerName": "阿托莎",
            "text": "嗯…如果他有良心的话，希望他能有机会回来看看我。",
            "nextDialogs": [
              "80211120"
            ]
          },
          "80211120": {
            "id": "80211120",
            "speakerId": 14074,
            "speakerName": "阿托莎",
            "text": "最近真是辛苦你们啦，我要去给婕叶婆婆帮忙了，再见二位。",
            "nextDialogs": [
              "80211121"
            ]
          },
          "80211121": {
            "id": "80211121",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "这样…应该就可以了吧？大家的生活也会回到正轨…",
            "nextDialogs": [
              "80211122"
            ]
          },
          "80211122": {
            "id": "80211122",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "欸对了，你前面说…和卡利贝尔聊完，发生了什么来着？",
            "nextDialogs": [
              "80211123"
            ]
          },
          "80211123": {
            "id": "80211123",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "（是啊…想不起来了，发生了什么来着？）",
            "nextDialogs": [
              "80211124"
            ]
          },
          "80211124": {
            "id": "80211124",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "（嗯…？等等，口袋里好像有什么东西…）",
            "nextDialogs": [
              "80211125"
            ]
          },
          "80211125": {
            "id": "80211125",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "嗯？画片？哪里来的，让我看看…"
          }
        }
      }
    },
    {
      "subId": "802116",
      "subQuestName": "(test)判断玩家是男 发任务道具$HIDDEN",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [],
        "dialogs": {}
      }
    },
    {
      "subId": "802117",
      "subQuestName": "(test)判断玩家是女 发任务道具$HIDDEN",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "80211701"
        ],
        "dialogs": {
          "80211701": {
            "id": "80211701",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "我们在某人的记忆里…对哦，我怎么忘记地脉扰动的问题了。",
            "nextDialogs": [
              "80211702"
            ]
          },
          "80211702": {
            "id": "80211702",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "就像你上次进入了血亲的记忆一样，我们现在也身处某人的记忆中了吗…",
            "nextDialogs": [
              "80211703"
            ]
          },
          "80211703": {
            "id": "80211703",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "而且这么说的话，也能够解释这里的时间点为何是那个人失踪之前的过去了…毕竟是「记忆」嘛。",
            "nextDialogs": [
              "80211706"
            ]
          },
          "80211706": {
            "id": "80211706",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "是呀！「只存在于记忆中的人」…现在终于有机会找到他了。",
            "nextDialogs": [
              "80211707"
            ]
          },
          "80211707": {
            "id": "80211707",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "可是刚才巴兰说他和别人出村去了，这下要到哪里找呢…",
            "nextDialogs": [
              "80211708"
            ]
          },
          "80211708": {
            "id": "80211708",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "也不知道地脉扰动现象会持续多久，时间够不够…这里是谁的记忆也还无法确定…",
            "nextDialogs": [
              "80211709"
            ]
          },
          "80211709": {
            "id": "80211709",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "回忆并整理一下现有的情报吧…",
            "nextDialogs": [
              "80211710"
            ]
          },
          "80211710": {
            "id": "80211710",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "嗯，这是最有效率的方法了。",
            "nextDialogs": [
              "80211711"
            ]
          },
          "80211711": {
            "id": "80211711",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "我们之前基本确定了失踪者所拥有的能力是…",
            "nextDialogs": [
              "80211712"
            ]
          },
          "80211712": {
            "id": "80211712",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "向脑海中投放记忆。",
            "nextDialogs": [
              "80211713"
            ]
          },
          "80211713": {
            "id": "80211713",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "对！就是这个，如果从他能力的角度出发，有没有什么线索可以让我们更接近他呢…",
            "nextDialogs": [
              "80211714"
            ]
          },
          "80211714": {
            "id": "80211714",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "比如，这种能力会不会有什么破绽？",
            "nextDialogs": [
              "80211715"
            ]
          },
          "80211715": {
            "id": "80211715",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "（嗯…向他人脑海里投放的记忆，不可能完美地融入原本的记忆之中，一定会存在某种破绽…）"
          }
        }
      }
    },
    {
      "subId": "802102",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "80210201"
        ],
        "dialogs": {
          "80210201": {
            "id": "80210201",
            "speakerId": 14313,
            "speakerName": "阿玛兹亚",
            "text": "有人失踪...应该算是大事啊，如果我真的忘了的话...那可真是太失职了。"
          }
        }
      }
    },
    {
      "subId": "802109",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "80210901"
        ],
        "dialogs": {
          "80210901": {
            "id": "80210901",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "奇怪…巴兰还记得他，甚至刚刚还见过…",
            "nextDialogs": [
              "80210902"
            ]
          },
          "80210902": {
            "id": "80210902",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "让我想想…难道说并不是记忆出了问题，而是我们回到那个人失踪之前的时间了？",
            "nextDialogs": [
              "80210903"
            ]
          },
          "80210903": {
            "id": "80210903",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "（回到过去…可没那么容易办到。）",
            "nextDialogs": [
              "80210904"
            ]
          },
          "80210904": {
            "id": "80210904",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "（结合戴因所说的地脉扰动问题，现状应该还是和「记忆」有关…）",
            "nextDialogs": [
              "80210905"
            ]
          },
          "80210905": {
            "id": "80210905",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "（认真思考一下…我们所处的「现状」究竟是…？）"
          }
        }
      }
    },
    {
      "subId": "802110",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "80211001"
        ],
        "dialogs": {
          "80211001": {
            "id": "80211001",
            "speakerId": 14074,
            "speakerName": "阿托莎",
            "text": "…所以婕叶婆婆啊，真的是年轻时候当佣兵养成的口癖，并不是要故意吓唬孩子们，呵呵…",
            "nextDialogs": [
              "80211002"
            ]
          },
          "80211002": {
            "id": "80211002",
            "speakerId": 14074,
            "speakerName": "阿托莎",
            "text": "唔，对了…感觉总是我在分享我的事情，你呢？有什么想要告诉我的吗？",
            "nextDialogs": [
              "80211003"
            ]
          },
          "80211003": {
            "id": "80211003",
            "speakerId": 14074,
            "speakerName": "阿托莎",
            "text": "那个…实在没什么的话，就比如…嗯…谈谈对我的感觉？",
            "nextDialogs": [
              "80211004"
            ]
          },
          "80211004": {
            "id": "80211004",
            "speakerId": 10205,
            "speakerName": "？？？",
            "text": "你…你是一个虽然坚强，但又十分细腻的女孩子。",
            "nextDialogs": [
              "80211005"
            ]
          },
          "80211005": {
            "id": "80211005",
            "speakerId": 10205,
            "speakerName": "？？？",
            "text": "你会遇上很多很好的人，拥有很幸福的生活…不再惦念一个像我这样的人…",
            "nextDialogs": [
              "80211006"
            ]
          },
          "80211006": {
            "id": "80211006",
            "speakerId": 14074,
            "speakerName": "阿托莎",
            "text": "欸…那边的，是你的朋友吗？",
            "nextDialogs": [
              "80211007"
            ]
          },
          "80211007": {
            "id": "80211007",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "（终于见到他了，感觉他的样子…有点眼熟…）",
            "nextDialogs": [
              "80211008"
            ]
          },
          "80211008": {
            "id": "80211008",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "记忆里的阿托莎，这时候还不认识我们吧…",
            "nextDialogs": [
              "80211009"
            ]
          },
          "80211009": {
            "id": "80211009",
            "speakerId": 10205,
            "speakerName": "？？？",
            "text": "算是吧，是我的朋友，他们应该花了一些功夫才找到我…",
            "nextDialogs": [
              "80211010"
            ]
          },
          "80211010": {
            "id": "80211010",
            "speakerId": 10205,
            "speakerName": "？？？",
            "text": "所以说…实在很不好意思，阿托莎，这个话题我们未来再继续吧，我要先招待一下我的朋友了。",
            "nextDialogs": [
              "80211011"
            ]
          },
          "80211011": {
            "id": "80211011",
            "speakerId": 14074,
            "speakerName": "阿托莎",
            "text": "未来…啊，好的，那我就先回维摩庄了，我们下次再聊哦。",
            "nextDialogs": [
              "80211012"
            ]
          },
          "80211012": {
            "id": "80211012",
            "speakerId": 10205,
            "speakerName": "？？？",
            "text": "#很高兴见到你，{NICKNAME}。我们应该是初次见面吧？",
            "nextDialogs": [
              "80211013"
            ]
          },
          "80211013": {
            "id": "80211013",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "你是…",
            "nextDialogs": [
              "80211014"
            ]
          },
          "80211014": {
            "id": "80211014",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "（唯一能够将记忆、深渊教团、命运的织机等等全部串联起来的那个人——）"
          }
        }
      }
    },

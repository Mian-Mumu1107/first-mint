    {
      "subId": "2006008",
      "subQuestName": "找吉丽安娜配药",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "200600801"
        ],
        "dialogs": {
          "200600801": {
            "id": "200600801",
            "speakerId": 1003,
            "speakerName": "吉丽安娜",
            "text": "药已经配好了， 但是这种药治标不治本，想要彻底根除的话，要一直服药静养才行。",
            "nextDialogs": [
              "200600802"
            ]
          },
          "200600802": {
            "id": "200600802",
            "speakerId": 1003,
            "speakerName": "吉丽安娜",
            "text": "我和他说过很多次，他似乎都没听进去，一直说这样就可以了，无论是谁都劝不动。",
            "nextDialogs": [
              "200600803"
            ]
          },
          "200600803": {
            "id": "200600803",
            "speakerId": 1003,
            "speakerName": "吉丽安娜",
            "text": "好了，请你们快点把药带给特纳先生吧。",
            "nextDialogs": [
              "200600804"
            ]
          },
          "200600804": {
            "id": "200600804",
            "speakerId": 1003,
            "speakerName": "吉丽安娜",
            "text": "谢谢你。",
            "nextDialogs": [
              "200600805"
            ]
          },
          "200600805": {
            "id": "200600805",
            "speakerId": 1003,
            "speakerName": "吉丽安娜",
            "text": "不客气，我只是做了分内的事而已。"
          }
        }
      }
    },
    {
      "subId": "2006009",
      "subQuestName": "(test)$HIDDEN",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [],
        "dialogs": {}
      }
    },
    {
      "subId": "2006010",
      "subQuestName": "向特纳回报",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "200600901"
        ],
        "dialogs": {
          "200600901": {
            "id": "200600901",
            "speakerId": 1000,
            "speakerName": "特纳",
            "text": "这个老毛病啊，到底什么时候能好呢…",
            "nextDialogs": [
              "200600903",
              "200600905"
            ]
          },
          "200600903": {
            "id": "200600903",
            "speakerId": 1000,
            "speakerName": "特纳",
            "text": "好，谢谢你。",
            "nextDialogs": [
              "200600907"
            ]
          },
          "200600907": {
            "id": "200600907",
            "speakerId": 1000,
            "speakerName": "特纳",
            "text": "惭愧啊，孩子在奋斗，我却什么忙都帮不上。",
            "nextDialogs": [
              "200600908"
            ]
          },
          "200600908": {
            "id": "200600908",
            "speakerId": 1000,
            "speakerName": "特纳",
            "text": "唯一能做到的事，就是不给孩子添麻烦了吧…",
            "nextDialogs": [
              "200600909"
            ]
          },
          "200600909": {
            "id": "200600909",
            "speakerId": 1000,
            "speakerName": "特纳",
            "text": "哦，对了，这些给您，请您收下吧，这是老头子我的一点谢礼。"
          },
          "200600905": {
            "id": "200600905",
            "speakerId": 1000,
            "speakerName": "特纳",
            "text": "静养的话，就必须让盖伊那臭小子回来了吧。",
            "nextDialogs": [
              "200600906"
            ]
          },
          "200600906": {
            "id": "200600906",
            "speakerId": 1000,
            "speakerName": "特纳",
            "text": "没事，我这把老骨头还不会散架。"
          }
        }
      }
    },
    {
      "subId": "2006003",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "200600301"
        ],
        "dialogs": {
          "200600301": {
            "id": "200600301",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "这些就应该足够了，我们去找<color=#00E1FFFF>吉丽安娜修女</color>吧。"
          }
        }
      }
    },
    {
      "subId": "2006006",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "200600601"
        ],
        "dialogs": {
          "200600601": {
            "id": "200600601",
            "speakerId": 1003,
            "speakerName": "吉丽安娜",
            "text": "虽然只是个小毛病，但是这么拖下去，还是会出大问题呢…"
          }
        }
      }
    },
    {
      "subId": "2006007",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "200600701"
        ],
        "dialogs": {
          "200600701": {
            "id": "200600701",
            "speakerId": 1003,
            "speakerName": "吉丽安娜",
            "text": "特纳先生可真是…",
            "nextDialogs": [
              "200600702"
            ]
          },
          "200600702": {
            "id": "200600702",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "我是来配药的。",
            "nextDialogs": [
              "200600703"
            ]
          },
          "200600703": {
            "id": "200600703",
            "speakerId": 1003,
            "speakerName": "吉丽安娜",
            "text": "咦？不是摩可和海莉来吗，怎么今天是你？",
            "nextDialogs": [
              "200600704"
            ]
          },
          "200600704": {
            "id": "200600704",
            "speakerId": 1003,
            "speakerName": "吉丽安娜",
            "text": "材料已经搜集到了吧，我来看看…"
          }
        }
      }
    },
    {
      "subId": "2006010",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "200601001"
        ],
        "dialogs": {
          "200601001": {
            "id": "200601001",
            "speakerId": 1000,
            "speakerName": "特纳",
            "text": "虽然是修女，但是吉丽安娜小姐做事真利索。也不大费周章折腾，我这老毛病，她看一眼就知道是怎么回事，开的药也便宜好用。",
            "nextDialogs": [
              "200601002"
            ]
          },
          "200601002": {
            "id": "200601002",
            "speakerId": 1000,
            "speakerName": "特纳",
            "text": "哈哈哈，就我老头子看来，她的作风不像个修女，反倒像个常年在野外摸爬滚打的猎人了…",
            "nextDialogs": [
              "200601003"
            ]
          },
          "200601003": {
            "id": "200601003",
            "speakerId": 1000,
            "speakerName": "特纳",
            "text": "哎呀，你看我这张嘴，净胡说八道…快去找她配药吧，可千万别和她说啊。"
          }
        }
      }
    }
  ]
}
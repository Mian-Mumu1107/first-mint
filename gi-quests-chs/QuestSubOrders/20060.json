{
  "lineCounts": {
    "Player": 6,
    "吉丽安娜": 9,
    "派蒙": 4,
    "特纳": 22,
    "盖伊": 7
  },
  "subQuests": [
    {
      "subId": "2006001",
      "subQuestName": "与特纳对话",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "200600101"
        ],
        "dialogs": {
          "200600101": {
            "id": "200600101",
            "speakerId": 1000,
            "speakerName": "特纳",
            "text": "你好，客人，你知道我儿子盖伊吗？咳…咳咳…",
            "nextDialogs": [
              "200600102"
            ]
          },
          "200600102": {
            "id": "200600102",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "你怎么了？",
            "nextDialogs": [
              "200600103"
            ]
          },
          "200600103": {
            "id": "200600103",
            "speakerId": 1000,
            "speakerName": "特纳",
            "text": "没事没事，老毛病了，没什么大问题，但就是一直好不了。",
            "nextDialogs": [
              "200600104"
            ]
          },
          "200600104": {
            "id": "200600104",
            "speakerId": 1000,
            "speakerName": "特纳",
            "text": "之前去<color=#00E1FFFF>教会</color>里也看过了，修女们也不能一口气治好，只能开药缓解。",
            "nextDialogs": [
              "200600105"
            ]
          },
          "200600105": {
            "id": "200600105",
            "speakerId": 1000,
            "speakerName": "特纳",
            "text": "唉，我年纪大了，也走不了太长的路，之前都是请摩可和海莉帮我去配药。",
            "nextDialogs": [
              "200600106"
            ]
          },
          "200600106": {
            "id": "200600106",
            "speakerId": 1000,
            "speakerName": "特纳",
            "text": "她们今天刚好有事…咳咳…我已经和<color=#00E1FFFF>吉丽安娜小姐</color>说好了。",
            "nextDialogs": [
              "200600107"
            ]
          },
          "200600107": {
            "id": "200600107",
            "speakerId": 1000,
            "speakerName": "特纳",
            "text": "只要带着材料过去，她就会把药配好。只要<color=#00E1FFFF>三份甜甜花</color>就好。",
            "nextDialogs": [
              "200600108"
            ]
          },
          "200600108": {
            "id": "200600108",
            "speakerId": 1000,
            "speakerName": "特纳",
            "text": "好的。",
            "nextDialogs": [
              "200600109"
            ]
          },
          "200600109": {
            "id": "200600109",
            "speakerId": 1000,
            "speakerName": "特纳",
            "text": "咳咳，咳…那就拜托你了。",
            "nextDialogs": [
              "200600112"
            ]
          },
          "200600112": {
            "id": "200600112",
            "speakerId": 1000,
            "speakerName": "特纳",
            "text": "就三份甜甜花，然后去教会找吉丽安娜修女配药，<color=#00E1FFFF>千万别让盖伊知道。</color>",
            "nextDialogs": [
              "200600113"
            ]
          },
          "200600113": {
            "id": "200600113",
            "speakerId": 1000,
            "speakerName": "特纳",
            "text": "我听说，教会和西风骑士团也有关系吧，那小子是西风骑士，可要时刻注意自己的言行…",
            "nextDialogs": [
              "200600114"
            ]
          },
          "200600114": {
            "id": "200600114",
            "speakerId": 1000,
            "speakerName": "特纳",
            "text": "要是为了我这个老头子犯了什么错，那就糟糕了。",
            "nextDialogs": [
              "200600115"
            ]
          },
          "200600115": {
            "id": "200600115",
            "speakerId": 1000,
            "speakerName": "特纳",
            "text": "抱歉，让你听我唠叨了半天，快点去吧，路上小心。"
          }
        }
      }
    },
    {
      "subId": "2006002",
      "subQuestName": "收集甜甜花",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "200600201"
        ],
        "dialogs": {
          "200600201": {
            "id": "200600201",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "唔…那我们快点去找<color=#00E1FFFF>甜甜花</color>吧。"
          }
        }
      }
    },
    {
      "subId": "2006004",
      "subQuestName": "(test)$HIDDEN",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "200600401"
        ],
        "dialogs": {
          "200600401": {
            "id": "200600401",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "等等…我看看，我们带着的甜甜花好像已经够数了。",
            "nextDialogs": [
              "200600402"
            ]
          },
          "200600402": {
            "id": "200600402",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "要直接拿去给<color=#00E1FFFF>吉丽安娜修女</color>吗？还是去再找一些？"
          }
        }
      }
    },
    {
      "subId": "2006005",
      "subQuestName": "(test)$HIDDEN",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "200600501"
        ],
        "dialogs": {
          "200600501": {
            "id": "200600501",
            "speakerId": 1002,
            "speakerName": "盖伊",
            "text": "呃，你好！你手上拿的是甜甜花吧。虽然很唐突，你能不能卖给我一份？",
            "nextDialogs": [
              "200600502"
            ]
          },
          "200600502": {
            "id": "200600502",
            "speakerId": 1002,
            "speakerName": "盖伊",
            "text": "我老爹一直在咳嗽，我问吉丽安娜小姐要了份止咳的药方，但是她那边材料已经用光了…",
            "nextDialogs": [
              "200600504",
              "200600507"
            ]
          },
          "200600504": {
            "id": "200600504",
            "speakerId": 1002,
            "speakerName": "盖伊",
            "text": "是，是这样吗？那还是算了…",
            "nextDialogs": [
              "200600505"
            ]
          },
          "200600505": {
            "id": "200600505",
            "speakerId": 1002,
            "speakerName": "盖伊",
            "text": "抱歉，耽误了你的时间，赶紧去教堂吧，吉丽安娜小姐还在呢。"
          },
          "200600507": {
            "id": "200600507",
            "speakerId": 1002,
            "speakerName": "盖伊",
            "text": "啊？哦…我知道，但是我还要守门呢，实在是抽不开身。",
            "nextDialogs": [
              "200600508"
            ]
          },
          "200600508": {
            "id": "200600508",
            "speakerId": 1002,
            "speakerName": "盖伊",
            "text": "就是去问吉丽安娜小姐，我也只能趁着午休的时候赶紧问了问。",
            "nextDialogs": [
              "200600509"
            ]
          },
          "200600509": {
            "id": "200600509",
            "speakerId": 1002,
            "speakerName": "盖伊",
            "text": "算了，看你的样子，应该也是去配药的吧…不耽误你了，快点去教堂吧，吉丽安娜小姐应该还在呢。"
          }
        }
      }
    },
    {
      "subId": "2006006",
      "subQuestName": "(test)$HIDDEN",
      "sceneId": null,
      "locations": [],
      "dialogue": {

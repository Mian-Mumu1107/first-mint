  "subQuests": [
    {
      "subId": "2051601",
      "subQuestName": "与安东尼对话",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "205160101"
        ],
        "dialogs": {
          "205160101": {
            "id": "205160101",
            "speakerId": 1408,
            "speakerName": "安东尼",
            "text": "这丫头，又跑到哪去了…",
            "nextDialogs": [
              "205160102"
            ]
          },
          "205160102": {
            "id": "205160102",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "安娜又出去玩了？",
            "nextDialogs": [
              "205160103"
            ]
          },
          "205160103": {
            "id": "205160103",
            "speakerId": 1408,
            "speakerName": "安东尼",
            "text": "我说啊，你怎么一副习以为常的表情。",
            "nextDialogs": [
              "205160104"
            ]
          },
          "205160104": {
            "id": "205160104",
            "speakerId": 1408,
            "speakerName": "安东尼",
            "text": "安娜是越来越不听话了，我一个不留神，她又溜出去了。",
            "nextDialogs": [
              "205160105"
            ]
          },
          "205160105": {
            "id": "205160105",
            "speakerId": 1408,
            "speakerName": "安东尼",
            "text": "她的病还没有好全呢，你快点帮我找找安娜吧。",
            "nextDialogs": [
              "205160107",
              "205160109",
              "205160112"
            ]
          },
          "205160107": {
            "id": "205160107",
            "speakerId": 1408,
            "speakerName": "安东尼",
            "text": "那就拜托你了。",
            "nextDialogs": [
              "205160115"
            ]
          },
          "205160115": {
            "id": "205160115",
            "speakerId": 1408,
            "speakerName": "安东尼",
            "text": "对了，之前安娜一直和我说，想要去看看风神像。",
            "nextDialogs": [
              "205160116"
            ]
          },
          "205160116": {
            "id": "205160116",
            "speakerId": 1408,
            "speakerName": "安东尼",
            "text": "我记得，葛瑞丝修女经常呆在那。",
            "nextDialogs": [
              "205160117"
            ]
          },
          "205160117": {
            "id": "205160117",
            "speakerId": 1408,
            "speakerName": "安东尼",
            "text": "你可以先去问问她，说不定她会注意到什么…"
          },
          "205160109": {
            "id": "205160109",
            "speakerId": 1408,
            "speakerName": "安东尼",
            "text": "我当然找过了，连城外都去过了。",
            "nextDialogs": [
              "205160110"
            ]
          },
          "205160110": {
            "id": "205160110",
            "speakerId": 1408,
            "speakerName": "安东尼",
            "text": "就是找不到，才只能拜托你啊。"
          },
          "205160112": {
            "id": "205160112",
            "speakerId": 1408,
            "speakerName": "安东尼",
            "text": "哦，她喜欢吃…喂！都说了不要把我妹妹当成猫！",
            "nextDialogs": [
              "205160113"
            ]
          },
          "205160113": {
            "id": "205160113",
            "speakerId": 1408,
            "speakerName": "安东尼",
            "text": "再说了，她喜欢吃的东西多了去了，我数得过来吗？",
            "nextDialogs": [
              "205160114"
            ]
          },
          "205160114": {
            "id": "205160114",
            "speakerId": 1408,
            "speakerName": "安东尼",
            "text": "好了，拜托你快去找找吧，我就在这等你。找了一圈，我都快累死了…"
          }
        }
      }
    },
    {
      "subId": "2051602",
      "subQuestName": "寻找安娜",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "205160201"
        ],
        "dialogs": {
          "205160201": {
            "id": "205160201",
            "speakerId": 1405,
            "speakerName": "安娜",
            "text": "原来从这里可以看到整个蒙德城…",
            "nextDialogs": [
              "205160202"
            ]
          },
          "205160202": {
            "id": "205160202",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "别着凉了。",
            "nextDialogs": [
              "205160203"
            ]
          },
          "205160203": {
            "id": "205160203",
            "speakerId": 1405,
            "speakerName": "安娜",
            "text": "哇！吓我一跳，你是从哪冒出来的？",
            "nextDialogs": [
              "205160204"
            ]
          },
          "205160204": {
            "id": "205160204",
            "speakerId": 1405,
            "speakerName": "安娜",
            "text": "准是哥哥又在找我了吧，哼哼，这地方他果然找不到。",
            "nextDialogs": [
              "205160205"
            ]
          },
          "205160205": {
            "id": "205160205",
            "speakerId": 1405,
            "speakerName": "安娜",
            "text": "好啦，好啦，我知道了，等会我就会回去啦。不会让哥哥担心的。"
          }
        }
      }
    },
    {
      "subId": "2051603",
      "subQuestName": "与安东尼对话",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "205160301"
        ],
        "dialogs": {
          "205160301": {
            "id": "205160301",
            "speakerId": 1408,
            "speakerName": "安东尼",
            "text": "你找到安娜了吗？",
            "nextDialogs": [
              "205160302"
            ]
          },
          "205160302": {
            "id": "205160302",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "在风神像的手上呢。",
            "nextDialogs": [
              "205160303"
            ]
          },
          "205160303": {
            "id": "205160303",
            "speakerId": 1408,
            "speakerName": "安东尼",
            "text": "风，风神像的手上？！她到底是怎么爬上去的…",
            "nextDialogs": [
              "205160304"
            ]
          },
          "205160304": {
            "id": "205160304",
            "speakerId": 1408,
            "speakerName": "安东尼",
            "text": "我马上去那边，把她给叫下来好好教训一下。",
            "nextDialogs": [
              "205160305"
            ]
          },
          "205160305": {
            "id": "205160305",
            "speakerId": 1408,
            "speakerName": "安东尼",
            "text": "辛苦你了，这些就收下吧。"
          }
        }
      }
    },
    {
      "subId": "2051604",
      "subQuestName": "与葛瑞丝对话$HIDDEN",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "205160401"
        ],
        "dialogs": {
          "205160401": {
            "id": "205160401",
            "speakerId": 1429,
            "speakerName": "葛瑞丝",
            "text": "这孩子，不是一直在生病吗？怎么…",
            "nextDialogs": [
              "205160402"
            ]
          },
          "205160402": {
            "id": "205160402",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "请问您看见过一个女孩…",
            "nextDialogs": [
              "205160403"
            ]
          },
          "205160403": {
            "id": "205160403",
            "speakerId": 1429,
            "speakerName": "葛瑞丝",
            "text": "呼…您是在找安娜吧，您往上看，她就在风神像的手上呢。",
            "nextDialogs": [
              "205160404"
            ]
          },
          "205160404": {
            "id": "205160404",
            "speakerId": 1429,
            "speakerName": "葛瑞丝",
            "text": "她跑过来的时候，我还在奇怪，这孩子不还是在生病吗？怎么突然这么有活力。",
            "nextDialogs": [
              "205160405"
            ]
          },
          "205160405": {
            "id": "205160405",
            "speakerId": 1429,
            "speakerName": "葛瑞丝",
            "text": "我就是一个愣神，这孩子就爬到风神像手上去了。",
            "nextDialogs": [
              "205160406"
            ]
          },
          "205160406": {
            "id": "205160406",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "您…为什么不生气？",
            "nextDialogs": [
              "205160407"
            ]
          },
          "205160407": {
            "id": "205160407",
            "speakerId": 1429,
            "speakerName": "葛瑞丝",
            "text": "生气？啊…当然是有一些的，不过，那孩子之前一直被病痛折磨…",
            "nextDialogs": [
              "205160408"
            ]
          },
          "205160408": {
            "id": "205160408",
            "speakerId": 1429,
            "speakerName": "葛瑞丝",
            "text": "现在看见她这么健康的样子，怎么说呢，我反而生气不起来了。",
            "nextDialogs": [
              "205160409"
            ]
          },
          "205160409": {
            "id": "205160409",
            "speakerId": 1429,
            "speakerName": "葛瑞丝",
            "text": "不过，上面风很大，这孩子别着凉了…"
          }
        }
      }
    },
    {
      "subId": "2051605",
      "subQuestName": "寻找安娜",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "205160501"
        ],
        "dialogs": {
          "205160501": {
            "id": "205160501",
            "speakerId": 1405,
            "speakerName": "安娜",
            "text": "原来从这里可以看到整个蒙德城…",
            "nextDialogs": [
              "205160502"
            ]
          },
          "205160502": {
            "id": "205160502",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "别着凉了。",
            "nextDialogs": [
              "205160503"
            ]
          },
          "205160503": {
            "id": "205160503",
            "speakerId": 1405,
            "speakerName": "安娜",
            "text": "哇！吓我一跳，你是从哪冒出来的，怎么找到我的？",
            "nextDialogs": [
              "205160504"
            ]
          },
          "205160504": {
            "id": "205160504",
            "speakerId": 1405,
            "speakerName": "安娜",
            "text": "我还以为，没人能找到这个地方呢…",
            "nextDialogs": [
              "205160505"
            ]
          },
          "205160505": {
            "id": "205160505",
            "speakerId": 1405,
            "speakerName": "安娜",
            "text": "啊，对了，一定是葛瑞丝修女告诉你的吧，她一直在这附近。",
            "nextDialogs": [
              "205160506"
            ]
          },
          "205160506": {
            "id": "205160506",
            "speakerId": 1405,
            "speakerName": "安娜",
            "text": "之前我吃的药，也有很多是她送过来的。",
            "nextDialogs": [
              "205160507"
            ]
          },
          "205160507": {
            "id": "205160507",
            "speakerId": 1405,
            "speakerName": "安娜",
            "text": "葛瑞丝修女真是个好人哪，不过我可不想一直呆在蒙德城…",
            "nextDialogs": [
              "205160508"
            ]
          },
          "205160508": {
            "id": "205160508",
            "speakerId": 1405,
            "speakerName": "安娜",
            "text": "好啦，我知道哥哥在找我，等会我就会回去啦。不会让哥哥担心的。"
          }
        }
      }
    },

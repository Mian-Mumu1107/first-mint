  "subQuests": [
    {
      "subId": "2204101",
      "subQuestName": "与寝子对话",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "220410101"
        ],
        "dialogs": {
          "220410101": {
            "id": "220410101",
            "speakerId": 3189,
            "speakerName": "「寝子」",
            "text": "汝等来了啊，来得正好，奴家正在发愁呢。",
            "nextDialogs": [
              "220410102"
            ]
          },
          "220410102": {
            "id": "220410102",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "发生什么事了？",
            "nextDialogs": [
              "220410103"
            ]
          },
          "220410103": {
            "id": "220410103",
            "speakerId": 3189,
            "speakerName": "「寝子」",
            "text": "汝等还记得「昆布丸」这个孩子吧？",
            "nextDialogs": [
              "220410104"
            ]
          },
          "220410104": {
            "id": "220410104",
            "speakerId": 3189,
            "speakerName": "「寝子」",
            "text": "这孩子去附近玩了之后，到现在也没有回来，奴家很担心。",
            "nextDialogs": [
              "220410105"
            ]
          },
          "220410105": {
            "id": "220410105",
            "speakerId": 3189,
            "speakerName": "「寝子」",
            "text": "拜托汝等，去附近找找「昆布丸」，再把它带回来吧。",
            "nextDialogs": [
              "220410107",
              "220410109"
            ]
          },
          "220410107": {
            "id": "220410107",
            "speakerId": 3189,
            "speakerName": "「寝子」",
            "text": "那就拜托汝了，快点找到「昆布丸」，把它带回神社来吧。"
          },
          "220410109": {
            "id": "220410109",
            "speakerId": 3189,
            "speakerName": "「寝子」",
            "text": "只有这孩子…也许是上次奴家训斥了它，让它不高兴了吧。",
            "nextDialogs": [
              "220410110"
            ]
          },
          "220410110": {
            "id": "220410110",
            "speakerId": 3189,
            "speakerName": "「寝子」",
            "text": "这孩子，为什么总是这么不听话呢…",
            "nextDialogs": [
              "220410111"
            ]
          },
          "220410111": {
            "id": "220410111",
            "speakerId": 3189,
            "speakerName": "「寝子」",
            "text": "拜托汝了，快点找到「昆布丸」，把它带回神社来吧。"
          }
        }
      }
    },
    {
      "subId": "2204102",
      "subQuestName": "寻找「昆布丸」",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "220410201"
        ],
        "dialogs": {
          "220410201": {
            "id": "220410201",
            "speakerId": 3189,
            "speakerName": "「寝子」",
            "text": "拜托汝了，找到「昆布丸」后，就把它带回神社来吧。"
          }
        }
      }
    },
    {
      "subId": "2204103",
      "subQuestName": "与寝子对话",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "220410301"
        ],
        "dialogs": {
          "220410301": {
            "id": "220410301",
            "speakerId": 3189,
            "speakerName": "「寝子」",
            "text": "怎么样，汝等找到昆布丸了吗？",
            "nextDialogs": [
              "220410302"
            ]
          },
          "220410302": {
            "id": "220410302",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "已经找到了。",
            "nextDialogs": [
              "220410303"
            ]
          },
          "220410303": {
            "id": "220410303",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "欸！它又跑不见了！",
            "nextDialogs": [
              "220410306"
            ]
          },
          "220410306": {
            "id": "220410306",
            "speakerId": 3189,
            "speakerName": "「寝子」",
            "text": "汝等，不用去找它了。",
            "nextDialogs": [
              "220410307"
            ]
          },
          "220410307": {
            "id": "220410307",
            "speakerId": 3189,
            "speakerName": "「寝子」",
            "text": "这孩子果然还在和奴家赌气…等会奴家自己再去教训一下那孩子。",
            "nextDialogs": [
              "220410308"
            ]
          },
          "220410308": {
            "id": "220410308",
            "speakerId": 3189,
            "speakerName": "「寝子」",
            "text": "明明都快成为一只大猫了，怎么还是这么任性，到时候要是惊到了来神社的人类可怎么办。",
            "nextDialogs": [
              "220410309"
            ]
          },
          "220410309": {
            "id": "220410309",
            "speakerId": 3189,
            "speakerName": "「寝子」",
            "text": "喔，这些东西给汝等，谢谢汝等帮忙了。",
            "nextDialogs": [
              "220410310"
            ]
          },
          "220410310": {
            "id": "220410310",
            "speakerId": 3189,
            "speakerName": "「寝子」",
            "text": "唉，为什么这孩子不能和「阿饭」一样听话呢…"
          }
        }
      }
    }
  ]
}
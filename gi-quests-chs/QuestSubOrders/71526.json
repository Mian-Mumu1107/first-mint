    {
      "subId": "7152601",
      "subQuestName": "(test)斗虫二期-畅畅关卡$HIDDEN",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "716663001"
        ],
        "dialogs": {
          "716663001": {
            "id": "716663001",
            "speakerId": 30472,
            "speakerName": "「恐怖猫爪草」",
            "text": "鬼兜虫…也可以当成猫猫狗狗一样的朋友！",
            "nextDialogs": [
              "716663002"
            ]
          },
          "716663002": {
            "id": "716663002",
            "speakerId": 1044,
            "speakerName": "荒泷一斗",
            "text": "这次也找来了一个孩子？",
            "nextDialogs": [
              "716663003"
            ]
          },
          "716663003": {
            "id": "716663003",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "唔，不过「花角玉将」也年纪轻轻，我记得上次还有一位小朋友，看来斗虫的本领和年龄完全无关嘛。",
            "nextDialogs": [
              "716663004"
            ]
          },
          "716663004": {
            "id": "716663004",
            "speakerId": 13019,
            "speakerName": "「花角玉将」",
            "text": "虽然这位人称…「恐怖猫爪草」的斗虫选手没有斗虫经验，但她的鬼兜虫伙伴散发出了极强的气势！",
            "nextDialogs": [
              "716663005"
            ]
          },
          "716663005": {
            "id": "716663005",
            "speakerId": 30472,
            "speakerName": "「恐怖猫爪草」",
            "text": "畅畅不懂你在说什么。",
            "nextDialogs": [
              "716663006"
            ]
          },
          "716663006": {
            "id": "716663006",
            "speakerId": 30472,
            "speakerName": "「恐怖猫爪草」",
            "text": "畅畅的鬼兜虫是爸爸上次带回来的礼物，是爸爸在旅行中交到的朋友送给他的。",
            "nextDialogs": [
              "716663007"
            ]
          },
          "716663007": {
            "id": "716663007",
            "speakerId": 1044,
            "speakerName": "荒泷一斗",
            "text": "哦哟，看来你的爸爸很懂行嘛！",
            "nextDialogs": [
              "716663008"
            ]
          },
          "716663008": {
            "id": "716663008",
            "speakerId": 1044,
            "speakerName": "荒泷一斗",
            "text": "那我们这边就派出「破空白铁小堇瓜」来参战，免得像是在欺负人家。",
            "nextDialogs": [
              "716663009"
            ]
          },
          "716663009": {
            "id": "716663009",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "哼，怎么说得我好像是最弱的那个一样…",
            "nextDialogs": [
              "716663010"
            ]
          },
          "716663010": {
            "id": "716663010",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "不过，你们两个斗虫狂人有可能把握不好轻重，确实应该由我来和她较量。",
            "nextDialogs": [
              "716663011"
            ]
          },
          "716663011": {
            "id": "716663011",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "别紧张哦，这位小朋友，只是游戏而已，开心就好！"
          }
        }
      }
    },
    {
      "subId": "7152602",
      "subQuestName": "(test)挑战畅畅$HIDDEN",
      "sceneId": null,
      "locations": [],

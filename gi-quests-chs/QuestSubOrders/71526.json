    {
      "subId": "7152603",
      "subQuestName": "(test)成功挑战一次畅畅$HIDDEN",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "716663101"
        ],
        "dialogs": {
          "716663101": {
            "id": "716663101",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "呼啊…还好没有失误！",
            "nextDialogs": [
              "716663102"
            ]
          },
          "716663102": {
            "id": "716663102",
            "speakerId": 1044,
            "speakerName": "荒泷一斗",
            "text": "吓，吓死我了！还…还挺生猛的，换我也不好对付！",
            "nextDialogs": [
              "716663103"
            ]
          },
          "716663103": {
            "id": "716663103",
            "speakerId": 1044,
            "speakerName": "荒泷一斗",
            "text": "璃月的斗虫强者都是无师自通的鬼才吗！",
            "nextDialogs": [
              "716663104"
            ]
          },
          "716663104": {
            "id": "716663104",
            "speakerId": 30472,
            "speakerName": "「恐怖猫爪草」",
            "text": "原来鬼兜虫之间，是这么一起玩的吗？畅畅完全明白了！",
            "nextDialogs": [
              "716663105"
            ]
          },
          "716663105": {
            "id": "716663105",
            "speakerId": 30472,
            "speakerName": "「恐怖猫爪草」",
            "text": "你们有时间的话，可以和畅畅再玩几局嘛？我也会继续看你们一起玩，好好学一学的！",
            "nextDialogs": [
              "716663106"
            ]
          },
          "716663106": {
            "id": "716663106",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "看来…「恐怖猫爪草」的天分，确实很恐怖！",
            "nextDialogs": [
              "716663107"
            ]
          },
          "716663107": {
            "id": "716663107",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "要是放牛的有这种天分，说不定只是听着锅巴和「水晶岛梆梆旋风」交流，就能明白甲壳生物的交流方式呢。",
            "nextDialogs": [
              "716663108"
            ]
          },
          "716663108": {
            "id": "716663108",
            "speakerId": 1044,
            "speakerName": "荒泷一斗",
            "text": "哈…哈哈哈…我也希望自己有那么强啊！"
          }
        }
      }
    }
  ]
}
        "startDialogs": [
          "790640701"
        ],
        "dialogs": {
          "790640701": {
            "id": "790640701",
            "speakerId": 21545,
            "speakerName": "巨人卫兵",
            "text": "逮捕可疑人士若干，以及混在可疑人士里的奥比奇！跟我走一趟！"
          }
        }

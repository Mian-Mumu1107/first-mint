    },
    {
      "subId": "7906406",
      "subQuestName": "（test）被巨人赶出去3的对话$HIDDEN",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "790640601"
        ],
        "dialogs": {
          "790640601": {
            "id": "790640601",
            "speakerId": 21539,
            "speakerName": "巨人卫兵",
            "text": "发现可疑人士！虽然不知道你们犯了什么法，但是现在最高戒备，走，和我们去自首！",
            "nextDialogs": [
              "790640602"
            ]
          },
          "790640602": {
            "id": "790640602",
            "speakerId": 1002,
            "speakerName": "Black Screen",
            "text": "你们四散逃开。卡佩喊了一句「各凭本事！」 \\n甩开守卫之后，你们在原地重新集合了。好在没有人被抓…",
            "nextDialogs": [
              "790640603"
            ]
          },
          "790640603": {
            "id": "790640603",
            "speakerId": 12674,
            "speakerName": "旁白",
            "text": "再试试吧。"
          }
        }
      }
    },

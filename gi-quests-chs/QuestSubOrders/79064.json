    {
      "subId": "7906403",
      "subQuestName": "（test）被巨人赶出去1的对话$HIDDEN",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "790640301"
        ],
        "dialogs": {
          "790640301": {
            "id": "790640301",
            "speakerId": 21439,
            "speakerName": "奥比奇",
            "text": "#大家，是我回来了。我带着预言中的侯爵和{M#他}{F#她}的随从一起回来寻找家族的失落原典了！",
            "nextDialogs": [
              "790640302"
            ]
          },
          "790640302": {
            "id": "790640302",
            "speakerId": 21544,
            "speakerName": "巨人卫兵",
            "text": "我们今早并没有听说有这样的事情。赶紧离开，不要给我们添麻烦。",
            "nextDialogs": [
              "790640303"
            ]
          },
          "790640303": {
            "id": "790640303",
            "speakerId": 1002,
            "speakerName": "Black Screen",
            "text": "巨大的卫兵拎起了众人，丢出了外面。\\n大家无法反抗…"
          }
        }
      }
    },
    {
      "subId": "7906401",
      "subQuestName": "（test）被巨人赶出去2$HIDDEN",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "790640101"
        ],
        "dialogs": {
          "790640101": {
            "id": "790640101",
            "speakerId": 21544,
            "speakerName": "巨人卫兵",
            "text": "谢谢你诚实地自首。我们一样会有礼貌地将您请出禁地的。",
            "nextDialogs": [
              "790640102"
            ]
          },
          "790640102": {
            "id": "790640102",
            "speakerId": 1002,
            "speakerName": "Black Screen",
            "text": "巨大的卫兵拎起了众人，放到了外面。\\n整个过程非常文明…"
          }
        }
      }
    },
    {
      "subId": "7906411",
      "subQuestName": "（test）和科学怪人对话$HIDDEN",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [],
        "dialogs": {}
      }
    },
    {
      "subId": "7906410",
      "subQuestName": "（test）和科学怪人对话$HIDDEN",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "790640801"
        ],
        "dialogs": {
          "790640801": {
            "id": "790640801",
            "speakerId": 1719,
            "speakerName": "奥比奇",
            "text": "这个是警卫室总部，只要和他们说清楚，一定可以解除巨大化卫兵的警戒。",
            "nextDialogs": [
              "790640802"
            ]
          },
          "790640802": {
            "id": "790640802",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "您好…",
            "nextDialogs": [
              "790640803"
            ]
          },
          "790640803": {
            "id": "790640803",
            "speakerId": 21537,
            "speakerName": "门后的声音",
            "text": "干什么，我正拿着我朋友的照片思念旧日时光呢。",
            "nextDialogs": [
              "790640804"
            ]
          },
          "790640804": {
            "id": "790640804",
            "speakerId": 1719,
            "speakerName": "奥比奇",
            "text": "这声音，是温斯顿吗？",
            "nextDialogs": [
              "790640805"
            ]
          },
          "790640805": {
            "id": "790640805",
            "speakerId": 1004,
            "speakerName": "温斯顿",
            "text": "哼哼，你终于灰溜溜地跑回来了啊。都说了你只有我一个朋友，为什么要接下和两个陌生人一起的任务？",
            "nextDialogs": [
              "790640806"
            ]
          },
          "790640806": {
            "id": "790640806",
            "speakerId": 1004,
            "speakerName": "温斯顿",
            "text": "当时你一脸天真：「我一定会和他们成为朋友的！」结果到最后也只有我还在等着你，只有我还是你朋友。",
            "nextDialogs": [
              "790640807"
            ]
          },
          "790640807": {
            "id": "790640807",
            "speakerId": 1719,
            "speakerName": "奥比奇",
            "text": "#那倒不是…不仅他们两个一起来了，还有{NICKNAME}侯爵和{M#他}{F#她}的伙伴呢。",
            "nextDialogs": [
              "790640808"
            ]
          },
          "790640808": {
            "id": "790640808",
            "speakerId": 1004,
            "speakerName": "温斯顿",
            "text": "…你居然背着我在外面交了朋友？长大了啊，奥比奇。够了，你滚吧，我再也不想见到你了！",
            "nextDialogs": [
              "790640809"
            ]
          },
          "790640809": {
            "id": "790640809",
            "speakerId": 1719,
            "speakerName": "奥比奇",
            "text": "欸，不是。你倒是解除一下戒严状态啊。现在我带着重要人物回来了，马上就可以解开圣地之谜了。",
            "nextDialogs": [
              "790640810"
            ]
          },
          "790640810": {
            "id": "790640810",
            "speakerId": 1004,
            "speakerName": "温斯顿",
            "text": "给我滚！",
            "nextDialogs": [
              "790640811"
            ]
          },
          "790640811": {
            "id": "790640811",
            "speakerId": 1005,
            "speakerName": "黑屏文字",
            "text": "温斯顿敲响了警报。巨大的卫兵过来拎起了众人，放到了外面。\\n「现在把你和温斯顿分开一下比较好，你们的友谊也需要冷静期。」\\n巨大卫兵人很好，还给出了情感建议。\\n整个过程异常文明。"
          }
        }
      }
    },

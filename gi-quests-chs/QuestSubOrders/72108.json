      }
    },
    {
      "subId": "7210816",
      "subQuestName": "（test）与天狐雕像对话$HIDDEN",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "721080401"
        ],
        "dialogs": {
          "721080401": {
            "id": "721080401",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "保管镇物的天狐雕像…的里面是空的。",
            "nextDialogs": [
              "721080402"
            ]
          },
          "721080402": {
            "id": "721080402",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "说不定是被那位面女的「老朋友」藏起来了吧。去问问看吧！",
            "nextDialogs": [
              "721080403"
            ]
          },
          "721080403": {
            "id": "721080403",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "面…面女？",
            "nextDialogs": [
              "721080404"
            ]
          },
          "721080404": {
            "id": "721080404",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "刚刚给她想的绰号。怎么样，是不是很好记？",
            "nextDialogs": [
              "721080407"
            ]
          },
          "721080407": {
            "id": "721080407",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "唔嗯，那还是算了…总之，我们先找找线索吧！"
          }
        }
      }
    },
    {
      "subId": "7210813",
      "subQuestName": "击败丘丘人",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "721081301"
        ],
        "dialogs": {
          "721081301": {
            "id": "721081301",
            "speakerId": 3159,
            "speakerName": "五百藏",
            "text": "吾辈以前可是名震天下的妖狸五百藏。总有一天吾辈要用八叠大的…",
            "nextDialogs": [
              "721081302"
            ]
          },
          "721081302": {
            "id": "721081302",
            "speakerId": 3159,
            "speakerName": "五百藏",
            "text": "咳咳。是你啊，小辈。看你与吾等缘分不浅，有什么想问的就尽管问吧。",
            "nextDialogs": [
              "721081304",
              "721081307",
              "721081312",
              "721081318",
              "721081320",
              "721081331",
              "721081338",
              "721081345"
            ]
          },
          "721081304": {
            "id": "721081304",
            "speakerId": 3159,
            "speakerName": "五百藏",
            "text": "别看现在成了石像，以前吾辈也是大御所大人封的官，是人称「隐神保生司正五百藏」的大人物。",
            "nextDialogs": [
              "721081305"
            ]
          },
          "721081305": {
            "id": "721081305",
            "speakerId": 3159,
            "speakerName": "五百藏",
            "text": "吾辈的职责就是保护镇守之森。保护这里的水土、灵脉。你看，在吾辈的关照下，守护之森多好。"
          },
          "721081307": {
            "id": "721081307",
            "speakerId": 3159,
            "speakerName": "五百藏",
            "text": "呶？你误会了。丘丘人对吾辈没什么害处。因为变成了石头，没办法到处找人玩，所以都是丘丘人陪着我。",
            "nextDialogs": [
              "721081308"
            ]
          },
          "721081308": {
            "id": "721081308",
            "speakerId": 3159,
            "speakerName": "五百藏",
            "text": "一开始吾辈看你是人，还以为你也是来害我的，所以就叫它们帮忙对付你了。你没事就好。",
            "nextDialogs": [
              "721081309"
            ]
          },
          "721081309": {
            "id": "721081309",
            "speakerId": 3159,
            "speakerName": "五百藏",
            "text": "虽然语言不通，头脑又笨，但变成石头的这些岁月里，它们多少也算是成了吾辈的伙伴吧。",
            "nextDialogs": [
              "721081310"
            ]
          },
          "721081310": {
            "id": "721081310",
            "speakerId": 3159,
            "speakerName": "五百藏",
            "text": "说来也怪，以前稻妻是没多少丘丘人的。从哪天开始，就到处都是了。"
          },
          "721081312": {
            "id": "721081312",
            "speakerId": 3159,
            "speakerName": "五百藏",
            "text": "吾辈一开始也是个自由自在的妖狸。虽然名气不大，但自由自在得很哪。经常和那个臭狐狸比赛斗法。",
            "nextDialogs": [
              "721081313"
            ]
          },
          "721081313": {
            "id": "721081313",
            "speakerId": 3159,
            "speakerName": "五百藏",
            "text": "有一天，那个臭狐狸跟我打赌，说吾辈不能偷到将军御苑里长的鸣草。吾辈当然接受挑战，结果害得我差点被将军一刀削了去，变得跟八酝岛似的。",
            "nextDialogs": [
              "721081314"
            ]
          },
          "721081314": {
            "id": "721081314",
            "speakerId": 3159,
            "speakerName": "五百藏",
            "text": "最后…",
            "nextDialogs": [
              "721081315"
            ]
          },
          "721081315": {
            "id": "721081315",
            "speakerId": 3159,
            "speakerName": "五百藏",
            "text": "最后还是那个臭狐狸帮我说情，将军才网开一面。不但放吾辈一条生路，还赐我「保生司正」之职。",
            "nextDialogs": [
              "721081316"
            ]
          },
          "721081316": {
            "id": "721081316",
            "speakerId": 3159,
            "speakerName": "五百藏",
            "text": "这种事情，吾辈怎么会忘记呢。吾辈可是欠了那个臭狐狸一条命呶…"
          },
          "721081318": {
            "id": "721081318",
            "speakerId": 3159,
            "speakerName": "五百藏",
            "text": "吾等妖狸一族自古就在鸣神的土地上活跃。有什么问题吗？"
          },
          "721081320": {
            "id": "721081320",
            "speakerId": 3159,
            "speakerName": "五百藏",
            "text": "呶，吾辈怎么知道——",
            "nextDialogs": [
              "721081321"
            ]
          },
          "721081321": {
            "id": "721081321",
            "speakerId": 3159,
            "speakerName": "五百藏",
            "text": "不对，应该就是因为偷了那把梳子吧。",
            "nextDialogs": [
              "721081322"
            ]
          },
          "721081322": {
            "id": "721081322",
            "speakerId": 3159,
            "speakerName": "五百藏",
            "text": "谁知道这把梳子是用来做「神樱大福」的嘛！",
            "nextDialogs": [
              "721081323"
            ]
          },
          "721081323": {
            "id": "721081323",
            "speakerId": 3159,
            "speakerName": "五百藏",
            "text": "那个臭狐狸从挑战吾辈捉迷藏的那天开始，就再也没现身过了。",
            "nextDialogs": [
              "721081324"
            ]
          },
          "721081324": {
            "id": "721081324",
            "speakerId": 3159,
            "speakerName": "五百藏",
            "text": "为了把那家伙引出来，吾辈想尽各种办法。因为那家伙过去喜欢跟吾辈斗法，所以吾辈就到处捣乱。",
            "nextDialogs": [
              "721081325"
            ]
          },
          "721081325": {
            "id": "721081325",
            "speakerId": 3159,
            "speakerName": "五百藏",
            "text": "把绀田村的菫瓜变成土豆、把日落果变成老虎。以前，一般这时候，臭狐狸就会冲过来找吾辈麻烦了。但这次不一样。",
            "nextDialogs": [
              "721081326"
            ]
          },
          "721081326": {
            "id": "721081326",
            "speakerId": 3159,
            "speakerName": "五百藏",
            "text": "后来，吾辈就觉得，「好生气！」干脆把那家伙眷属的雕像破坏掉。这时候吾辈就发现了里面的梳子。",
            "nextDialogs": [
              "721081327"
            ]
          },
          "721081327": {
            "id": "721081327",
            "speakerId": 3159,
            "speakerName": "五百藏",
            "text": "「只要把这个偷走，那个臭狐狸肯定会着急。那就会现身了吧。呶。」吾辈这么想，就把梳子偷走了。",
            "nextDialogs": [
              "721081328"
            ]
          },
          "721081328": {
            "id": "721081328",
            "speakerId": 3159,
            "speakerName": "五百藏",
            "text": "结果，臭狐狸没有出现，却来了个人类小辈，我记得以前是和影向天狗学法术的三人组之一。",
            "nextDialogs": [
              "721081329"
            ]
          },
          "721081329": {
            "id": "721081329",
            "speakerId": 3159,
            "speakerName": "五百藏",
            "text": "不知怎么力量这么强，居然把吾辈和孩子们一并封印在石像里了。"
          },
          "721081331": {
            "id": "721081331",
            "speakerId": 3159,
            "speakerName": "五百藏",
            "text": "呶，很过分吧？那时候臭狐狸居然敢用捉迷藏挑战吾辈。",
            "nextDialogs": [
              "721081332"
            ]
          },
          "721081332": {
            "id": "721081332",
            "speakerId": 3159,
            "speakerName": "五百藏",
            "text": "说什么「绝对不要现身」、「如果发生了什么事，那就是我在用法术挑拨你」之类的，口气很奇怪得很呶。",
            "nextDialogs": [
              "721081333"
            ]
          },
          "721081333": {
            "id": "721081333",
            "speakerId": 3159,
            "speakerName": "五百藏",
            "text": "但吾辈可是妖狸，又是将军大人亲自封的「保生司正」，在镇守之森用捉迷藏挑战吾辈，那自然接受。得好好教训教训那家伙。",
            "nextDialogs": [
              "721081334"
            ]
          },
          "721081334": {
            "id": "721081334",
            "speakerId": 3159,
            "speakerName": "五百藏",
            "text": "吾辈找了个好地方，变成了一只鬼兜虫，想看那家伙在林子里着急地到处乱找的丑态！",
            "nextDialogs": [
              "721081335"
            ]
          },
          "721081335": {
            "id": "721081335",
            "speakerId": 3159,
            "speakerName": "五百藏",
            "text": "结果，那臭狐狸一直没来。这个胜负，到现在还没有分出来。",
            "nextDialogs": [
              "721081336"
            ]
          },
          "721081336": {
            "id": "721081336",
            "speakerId": 3159,
            "speakerName": "五百藏",
            "text": "吾辈会一直等下去，等那个臭狐狸回来，然后，对吾辈道歉。呶，那家伙要道歉的东西太多了，吾辈天天都在算这笔账呢。"
          },
          "721081338": {
            "id": "721081338",
            "speakerId": 3159,
            "speakerName": "五百藏",
            "text": "呶，镇守之森原本是吾辈「隐神保生司正五百藏」与同族的土地，直到吾等被那个人类小姓变成石像。",
            "nextDialogs": [
              "721081339"
            ]
          },
          "721081339": {
            "id": "721081339",
            "speakerId": 3159,
            "speakerName": "五百藏",
            "text": "如果你看到了狸子石像，那多半也是被封印的妖狸。",
            "nextDialogs": [
              "721081340"
            ]
          },
          "721081340": {
            "id": "721081340",
            "speakerId": 3159,
            "speakerName": "五百藏",
            "text": "不过这些时日，有些封印已经松动了。比如「吉法师」他们，已经恢复了原状，所以吾等还是有希望的。",
            "nextDialogs": [
              "721081341"
            ]
          },
          "721081341": {
            "id": "721081341",
            "speakerId": 3159,
            "speakerName": "五百藏",
            "text": "呶，小辈哟，答应吾辈一件事。",
            "nextDialogs": [
              "721081342"
            ]
          },
          "721081342": {
            "id": "721081342",
            "speakerId": 3159,
            "speakerName": "五百藏",
            "text": "如果在外头看到了吾辈同族的小狸子，要对他们好一点。",
            "nextDialogs": [
              "721081343"
            ]
          },
          "721081343": {
            "id": "721081343",
            "speakerId": 3159,
            "speakerName": "五百藏",
            "text": "他们都陪吾辈被封印了…不知道多久岁月，现在就想看看外面的世界。"
          },
          "721081345": {
            "id": "721081345",
            "speakerId": 3159,
            "speakerName": "五百藏",
            "text": "再见了，小辈。如果是那家伙的话，这时候就会念个难懂的诗吧。",
            "nextDialogs": [
              "721081346"
            ]
          },
          "721081346": {
            "id": "721081346",
            "speakerId": 3159,
            "speakerName": "五百藏",
            "text": "有时间要来找吾辈玩。毕竟，吾辈现在可是石头，时间可是多得很呶。"
          }
        }
      }
    },
    {
      "subId": "7210814",
      "subQuestName": "与「奇怪的雕像」对话",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "721080701"
        ],
        "dialogs": {
          "721080701": {
            "id": "721080701",
            "speakerId": 3159,
            "speakerName": "五百藏",
            "text": "噫——我…吾吾吾辈正是五百藏，要、要杀要剐悉听尊便！",
            "nextDialogs": [
              "721080702"
            ]
          },
          "721080702": {
            "id": "721080702",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "哇，石像在说话！还吓得话都说不清了耶。",
            "nextDialogs": [
              "721080703"
            ]
          },
          "721080703": {
            "id": "721080703",
            "speakerId": 3159,
            "speakerName": "五百藏",
            "text": "吾辈才不是什么石像！只是暂时被人封印，变成了这个样子罢了！吾辈乃是名震天下的妖狸五百藏！",
            "nextDialogs": [
              "721080706"
            ]
          },
          "721080706": {
            "id": "721080706",
            "speakerId": 3159,
            "speakerName": "五百藏",
            "text": "什么嘛，现在的小辈连五百藏的名号都不知道了吗？",
            "nextDialogs": [
              "721080707"
            ]
          },
          "721080707": {
            "id": "721080707",
            "speakerId": 3159,
            "speakerName": "五百藏",
            "text": "《御苑狸戏画》、《五百藏茶壶》、《隐神大囃子》、《影向山骚动狸合战》…这些故事没听过吗？嗯？",
            "nextDialogs": [
              "721080708"
            ]
          },
          "721080708": {
            "id": "721080708",
            "speakerId": 3159,
            "speakerName": "五百藏",
            "text": "吾辈到底被那个混小子封印了多少年呀…"
          }
        }
      }
    },
    {
      "subId": "7210803",
      "subQuestName": "寻找「小狸子」",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "721080301"
        ],
        "dialogs": {
          "721080301": {
            "id": "721080301",
            "speakerId": 1002,
            "speakerName": "大狸猫",
            "text": "(test)非常感谢你旅行者",
            "nextDialogs": [
              "721080302"
            ]
          },
          "721080302": {
            "id": "721080302",
            "speakerId": 1002,
            "speakerName": "大狸猫",
            "text": "(test)这个是当年撒比狐狸托付给我保管的祭具",
            "nextDialogs": [
              "721080303"
            ]
          },
          "721080303": {
            "id": "721080303",
            "speakerId": 1002,
            "speakerName": "大狸猫",
            "text": "(test)",
            "nextDialogs": [
              "721080304"
            ]
          },
          "721080304": {
            "id": "721080304",
            "speakerId": 1002,
            "speakerName": "大狸猫",
            "text": "(test)陪你",
            "nextDialogs": [
              "721080305"
            ]
          },
          "721080305": {
            "id": "721080305",
            "speakerId": 1002,
            "speakerName": "大狸猫",
            "text": "去吧"
          }
        }
      }
    },
    {

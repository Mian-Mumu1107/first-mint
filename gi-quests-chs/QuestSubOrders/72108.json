    {
      "subId": "7210807",
      "subQuestName": "向五百藏复命",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "721080901"
        ],
        "dialogs": {
          "721080901": {
            "id": "721080901",
            "speakerId": 3159,
            "speakerName": "五百藏",
            "text": "嗯嗯。干得很好，他们都很开心。",
            "nextDialogs": [
              "721080902"
            ]
          },
          "721080902": {
            "id": "721080902",
            "speakerId": 3159,
            "speakerName": "五百藏",
            "text": "…嗯？哦，没问题，吾辈帮你问问他们。",
            "nextDialogs": [
              "721080903"
            ]
          },
          "721080903": {
            "id": "721080903",
            "speakerId": 3159,
            "speakerName": "五百藏",
            "text": "「刑部小判」想问你们：「你们明明是人类，为啥身上却有狸子的气息哩？」",
            "nextDialogs": [
              "721080904"
            ]
          },
          "721080904": {
            "id": "721080904",
            "speakerId": 3159,
            "speakerName": "五百藏",
            "text": "…对啊！给吾辈交待清楚！你们身上为什么有吾等的气味？",
            "nextDialogs": [
              "721080905"
            ]
          },
          "721080905": {
            "id": "721080905",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "欸？现在才问吗…",
            "nextDialogs": [
              "721080908"
            ]
          },
          "721080908": {
            "id": "721080908",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "对了！是有这么回事呢！",
            "nextDialogs": [
              "721080909"
            ]
          },
          "721080909": {
            "id": "721080909",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "之前面具巫女小姐给我们吃了一顿好丰盛的大餐，说是用从妖狸一族那偷学来的法术，做出来的。",
            "nextDialogs": [
              "721080910"
            ]
          },
          "721080910": {
            "id": "721080910",
            "speakerId": 3159,
            "speakerName": "五百藏",
            "text": "什么？竟然敢偷学吾等的法术…",
            "nextDialogs": [
              "721080911"
            ]
          },
          "721080911": {
            "id": "721080911",
            "speakerId": 3159,
            "speakerName": "五百藏",
            "text": "唔，难道说…",
            "nextDialogs": [
              "721080912"
            ]
          },
          "721080912": {
            "id": "721080912",
            "speakerId": 3159,
            "speakerName": "五百藏",
            "text": "什么嘛，那个臭狐狸。如果还活着的话，那早点来跟吾辈打个招呼嘛。",
            "nextDialogs": [
              "721080913"
            ]
          },
          "721080913": {
            "id": "721080913",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "是个戴着面具的巫女，说你是「老朋友」。",
            "nextDialogs": [
              "721080914"
            ]
          },
          "721080914": {
            "id": "721080914",
            "speakerId": 3159,
            "speakerName": "五百藏",
            "text": "面具？吾辈不知道什么面具，也不认识什么巫女。狐狸倒晓得一匹。",
            "nextDialogs": [
              "721080915"
            ]
          },
          "721080915": {
            "id": "721080915",
            "speakerId": 3159,
            "speakerName": "五百藏",
            "text": "说起来，那个臭狐狸倒也用巫女的形象示人过。你说的那个巫女，长什么样子？",
            "nextDialogs": [
              "721080916"
            ]
          },
          "721080916": {
            "id": "721080916",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "戴着白狐面具…",
            "nextDialogs": [
              "721080917"
            ]
          },
          "721080917": {
            "id": "721080917",
            "speakerId": 3159,
            "speakerName": "五百藏",
            "text": "别的呢？"
          }
        }
      }
    },
    {
      "subId": "7210815",
      "subQuestName": "向五百藏复命",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "721080931"
        ],
        "dialogs": {
          "721080931": {
            "id": "721080931",
            "speakerId": 3159,
            "speakerName": "五百藏",
            "text": "什么嘛，原来是这么重要的东西，早说嘛…",
            "nextDialogs": [
              "721080932"
            ]
          },
          "721080932": {
            "id": "721080932",
            "speakerId": 3159,
            "speakerName": "五百藏",
            "text": "弄得吾辈被莫名其妙封印了…",
            "nextDialogs": [
              "721080936"
            ]
          },
          "721080936": {
            "id": "721080936",
            "speakerId": 3159,
            "speakerName": "五百藏",
            "text": "呶！别说风凉话了！",
            "nextDialogs": [
              "721080937"
            ]
          },
          "721080937": {
            "id": "721080937",
            "speakerId": 3159,
            "speakerName": "五百藏",
            "text": "算了算了，都是过去的事了。森林附近的结界的事情，吾辈也有点眉目。",
            "nextDialogs": [
              "721080938"
            ]
          },
          "721080938": {
            "id": "721080938",
            "speakerId": 3159,
            "speakerName": "五百藏",
            "text": "以前跟那个臭狐狸斗法的时候，吾辈曾在东方海边见到过。是棵雷樱树的模样，加上鸟居对吧？",
            "nextDialogs": [
              "721080939"
            ]
          },
          "721080939": {
            "id": "721080939",
            "speakerId": 3159,
            "speakerName": "五百藏",
            "text": "以前因为看过那家伙在那和什么妖怪战斗，吾辈担心会有别的妖怪从里面跑出来害我的树林，就用法术把那个地方封起来了。",
            "nextDialogs": [
              "721080940"
            ]
          },
          "721080940": {
            "id": "721080940",
            "speakerId": 3159,
            "speakerName": "五百藏",
            "text": "我想想。封印在东边的崖壁下…「吉法师」，你去那边，帮他们把封印解开。",
            "nextDialogs": [
              "721080941"
            ]
          },
          "721080941": {
            "id": "721080941",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "谢谢你，五百藏。",
            "nextDialogs": [
              "721080942"
            ]
          },
          "721080942": {
            "id": "721080942",
            "speakerId": 3159,
            "speakerName": "五百藏",
            "text": "好了好了，别说这些。快去吧。",
            "nextDialogs": [
              "721080943"
            ]
          },
          "721080943": {
            "id": "721080943",
            "speakerId": 3159,
            "speakerName": "五百藏",
            "text": "如果见到了那个臭狐狸，记得帮吾辈带个好。就说…我想想…",
            "nextDialogs": [
              "721080944"
            ]
          },
          "721080944": {
            "id": "721080944",
            "speakerId": 3159,
            "speakerName": "五百藏",
            "text": "「混账东西，气死我了。快回来跟吾辈斗法，我们之间的胜负还没分清呢！顺便帮吾辈解开封印！对了，倒不是吾辈自己不能解除封印，只是臭狐狸你还欠吾辈几个人情呢！『刑部小判』说他想你了！」",
            "nextDialogs": [
              "721080945"
            ]
          },
          "721080945": {
            "id": "721080945",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "好长！太长啦！谁记得住啦！"
          }
        }
      }
    },
    {
      "subId": "7210808",
      "subQuestName": "前往「结界」的所在",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "721080801"
        ],
        "dialogs": {
          "721080801": {
            "id": "721080801",
            "speakerId": 3159,
            "speakerName": "五百藏",
            "text": "呜呶呶…好想挠肚皮…",
            "nextDialogs": [
              "721080802"
            ]
          },
          "721080802": {
            "id": "721080802",
            "speakerId": 3159,
            "speakerName": "五百藏",
            "text": "呶？你这小辈怎么又回来了。帮吾辈找到「证城」、「刑部小判」和「吉法师」这<color=#00E1FFFF>三个小狸子</color>，陪他们玩玩吧。",
            "nextDialogs": [
              "721080803"
            ]
          },
          "721080803": {
            "id": "721080803",
            "speakerId": 3159,
            "speakerName": "五百藏",
            "text": "好了好了，快去吧！"
          }
        }
      }
    },
    {
      "subId": "7210809",
      "subQuestName": "等待「吉法师」",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "721081101"
        ],
        "dialogs": {
          "721081101": {
            "id": "721081101",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "就是这里吗？光秃秃的石头…",
            "nextDialogs": [
              "721081102"
            ]
          },
          "721081102": {
            "id": "721081102",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "嗯？他好像在用什么法术…",
            "nextDialogs": [
              "721081103"
            ]
          },
          "721081103": {
            "id": "721081103",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "哇！石头消失了！",
            "nextDialogs": [
              "721081106"
            ]
          },
          "721081106": {
            "id": "721081106",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "这就是妖狸的法术吗！感觉很好玩的样子！",
            "nextDialogs": [
              "721081107"
            ]
          },
          "721081107": {
            "id": "721081107",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "谢谢你，「吉法师」！下次我们再一起玩捉迷藏吧。",
            "nextDialogs": [
              "721081108"
            ]
          },
          "721081108": {
            "id": "721081108",
            "speakerId": 3160,
            "speakerName": "「吉法师」",
            "text": "呶！"
          }
        }
      }
    },
    {
      "subId": "7210817",
      "subQuestName": "破除「结界」",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [],
        "dialogs": {}
      }
    },
    {
      "subId": "7210820",
      "subQuestName": "",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "721082001"
        ],
        "dialogs": {
          "721082001": {
            "id": "721082001",
            "speakerId": 20221,
            "speakerName": "花散里",
            "text": "相当漂亮，无论是五百藏的障眼法，还是您击败妖物的手段。",
            "nextDialogs": [
              "721082002"
            ]
          },
          "721082002": {
            "id": "721082002",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "「噫！」",
            "nextDialogs": [
              "721082003"
            ]
          },
          "721082003": {
            "id": "721082003",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "…我本想这么说，但其实已经习惯了。面具巫女小姐可真没新意。",
            "nextDialogs": [
              "721082004"
            ]
          },
          "721082004": {
            "id": "721082004",
            "speakerId": 20221,
            "speakerName": "花散里",
            "text": "这样啊。让您失望了，非常抱歉。下次我会加油的。",
            "nextDialogs": [
              "721082005"
            ]
          },
          "721082005": {
            "id": "721082005",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "别这种事情上加油…",
            "nextDialogs": [
              "721082006"
            ]
          },
          "721082006": {
            "id": "721082006",
            "speakerId": 20221,
            "speakerName": "花散里",
            "text": "说得也是。那么，五百藏…他是否还安好呢？",
            "nextDialogs": [
              "721082008",
              "721082010"
            ]
          },
          "721082008": {
            "id": "721082008",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "虽然变成了石头。",
            "nextDialogs": [
              "721082011"
            ]
          },
          "721082011": {
            "id": "721082011",
            "speakerId": 20221,
            "speakerName": "花散里",
            "text": "原来是这样…",
            "nextDialogs": [
              "721082012"
            ]
          },
          "721082012": {
            "id": "721082012",
            "speakerId": 20221,
            "speakerName": "花散里",
            "text": "一般来说，妖狸作乱这种事情，只要不太过火，是不会派人去专门退治的。毕竟妖狸一族虽然顽皮，但心地善良单纯，和小孩子一样。",
            "nextDialogs": [
              "721082013"
            ]
          },
          "721082013": {
            "id": "721082013",
            "speakerId": 20221,
            "speakerName": "花散里",
            "text": "但是，连「大祓」所需的镇物也敢偷，那确实会受到惩罚呢。听你们的说法，既然是「影向役者三人组」，那多半是惟神…过去一名阴阳师下的手。"
          },
          "721082010": {
            "id": "721082010",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "但很有精神呢！"
          }
        }
      }
    },
    {
      "subId": "7210818",
      "subQuestName": "与花散里交谈",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "721000301"
        ],
        "dialogs": {
          "721000301": {
            "id": "721000301",
            "speakerId": 20221,
            "speakerName": "花散里",
            "text": "相当漂亮，无论是五百藏的障眼法，还是您击败妖物的手段。",
            "nextDialogs": [
              "721000302"
            ]
          },
          "721000302": {
            "id": "721000302",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "「噫！」",
            "nextDialogs": [
              "721000303"
            ]
          },
          "721000303": {
            "id": "721000303",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "…我本想这么说，但其实已经习惯了。面具巫女小姐可真没新意。",
            "nextDialogs": [
              "721000304"
            ]
          },
          "721000304": {
            "id": "721000304",
            "speakerId": 20221,
            "speakerName": "花散里",
            "text": "这样啊。让您失望了，非常抱歉。下次我会加油的。",
            "nextDialogs": [
              "721000305"
            ]
          },
          "721000305": {
            "id": "721000305",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "别在这种事情上加油…",
            "nextDialogs": [
              "721000306"
            ]
          },
          "721000306": {
            "id": "721000306",
            "speakerId": 20221,
            "speakerName": "花散里",
            "text": "说得也是。那么，五百藏…他是否还安好呢？",
            "nextDialogs": [
              "721000308",
              "721000310"
            ]
          },
          "721000308": {
            "id": "721000308",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "虽然变成了石头。",
            "nextDialogs": [
              "721000311"
            ]
          },
          "721000311": {
            "id": "721000311",
            "speakerId": 20221,
            "speakerName": "花散里",
            "text": "原来是这样…",
            "nextDialogs": [
              "721000312"
            ]
          },
          "721000312": {
            "id": "721000312",
            "speakerId": 20221,
            "speakerName": "花散里",
            "text": "一般来说，妖狸作乱这种事情，只要不太过火，是不会派人去专门退治的。毕竟妖狸一族虽然顽皮，但心地善良单纯，和小孩子一样。",
            "nextDialogs": [
              "721000313"
            ]
          },
          "721000313": {
            "id": "721000313",
            "speakerId": 20221,
            "speakerName": "花散里",
            "text": "但是，连「大祓」所需的镇物也敢偷，那确实会受到惩罚呢。听你们的说法，既然是「影向役者三人组」，那多半是惟神…过去一名阴阳师下的手。"
          },
          "721000310": {
            "id": "721000310",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "但很有精神呢！"
          }
        }
      }
    }
  ]
}
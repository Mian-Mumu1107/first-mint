    {
      "subId": "45205",
      "subQuestName": "与齐格芙丽雅对话",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "4520301"
        ],
        "dialogs": {
          "4520301": {
            "id": "4520301",
            "speakerId": 1002,
            "speakerName": "齐格芙丽雅",
            "text": "谢，谢谢你们！",
            "nextDialogs": [
              "4520302"
            ]
          },
          "4520302": {
            "id": "4520302",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "小事一桩啦。",
            "nextDialogs": [
              "4520303"
            ]
          },
          "4520303": {
            "id": "4520303",
            "speakerId": 1000,
            "speakerName": "安柏",
            "text": "最近借着狼群的威风，丘丘人都嚣张跋扈了起来。",
            "nextDialogs": [
              "4520304"
            ]
          },
          "4520304": {
            "id": "4520304",
            "speakerId": 1002,
            "speakerName": "齐格芙丽雅",
            "text": "是这样的。但是我觉得相比丘丘人，还是狼群更肆无忌惮一些。",
            "nextDialogs": [
              "4520305"
            ]
          },
          "4520305": {
            "id": "4520305",
            "speakerId": 1002,
            "speakerName": "齐格芙丽雅",
            "text": "它们…上午刚袭击了清泉镇。",
            "nextDialogs": [
              "4520306"
            ]
          },
          "4520306": {
            "id": "4520306",
            "speakerId": 1000,
            "speakerName": "安柏",
            "text": "什么？袭击镇上？！这也太嚣张了！",
            "nextDialogs": [
              "4520307"
            ]
          },
          "4520307": {
            "id": "4520307",
            "speakerId": 1002,
            "speakerName": "齐格芙丽雅",
            "text": "是啊。",
            "nextDialogs": [
              "4520308"
            ]
          },
          "4520308": {
            "id": "4520308",
            "speakerId": 1002,
            "speakerName": "齐格芙丽雅",
            "text": "我心想狼群闹够了，兴许可以上路，没想到就遇到了丘丘人…",
            "nextDialogs": [
              "4520309"
            ]
          },
          "4520309": {
            "id": "4520309",
            "speakerId": 1000,
            "speakerName": "安柏",
            "text": "那我们现在赶过去，说不定还能看到残留的现场。",
            "nextDialogs": [
              "4520310"
            ]
          },
          "4520310": {
            "id": "4520310",
            "speakerId": 1000,
            "speakerName": "安柏",
            "text": "先走一步了！你就赶快检查一下损失吧。货车还能动吗？",
            "nextDialogs": [
              "4520311"
            ]
          },
          "4520311": {
            "id": "4520311",
            "speakerId": 1002,
            "speakerName": "齐格芙丽雅",
            "text": "啊，好…"
          }
        }
      }
    }
  ]

  "subQuests": [
    {
      "subId": "45201",
      "subQuestName": "询问安柏奔狼领男孩的事情",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "4520101"
        ],
        "dialogs": {
          "4520101": {
            "id": "4520101",
            "speakerId": 1000,
            "speakerName": "安柏",
            "text": "#啊，派蒙和{NICKNAME}，找我有什么事情吗？",
            "nextDialogs": [
              "4520102"
            ]
          },
          "4520102": {
            "id": "4520102",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "你好啊，安柏。",
            "nextDialogs": [
              "4520104",
              "4520125"
            ]
          },
          "4520104": {
            "id": "4520104",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "安柏，你认识奔狼领的男孩吗？",
            "nextDialogs": [
              "4520105"
            ]
          },
          "4520105": {
            "id": "4520105",
            "speakerId": 1000,
            "speakerName": "安柏",
            "text": "啊？",
            "nextDialogs": [
              "4520106"
            ]
          },
          "4520106": {
            "id": "4520106",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "就是和你关系很好的那位啊？",
            "nextDialogs": [
              "4520107"
            ]
          },
          "4520107": {
            "id": "4520107",
            "speakerId": 1000,
            "speakerName": "安柏",
            "text": "你在说什么啊？",
            "nextDialogs": [
              "4520108"
            ]
          },
          "4520108": {
            "id": "4520108",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "奇怪了，他说在老地方等你。难道你已经把他忘记了吗？",
            "nextDialogs": [
              "4520109"
            ]
          },
          "4520109": {
            "id": "4520109",
            "speakerId": 1000,
            "speakerName": "安柏",
            "text": "小派蒙你才是，该不会吃错了蘑菇产生幻觉了吧？",
            "nextDialogs": [
              "4520110"
            ]
          },
          "4520110": {
            "id": "4520110",
            "speakerId": 1000,
            "speakerName": "安柏",
            "text": "我完全不明白啊。",
            "nextDialogs": [
              "4520111"
            ]
          },
          "4520111": {
            "id": "4520111",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "呃……不能吃的蘑菇是什么颜色的？",
            "nextDialogs": [
              "4520112"
            ]
          },
          "4520112": {
            "id": "4520112",
            "speakerId": 1000,
            "speakerName": "安柏",
            "text": "紫色的。",
            "nextDialogs": [
              "4520113"
            ]
          },
          "4520113": {
            "id": "4520113",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "……好像前两天真的吃过。",
            "nextDialogs": [
              "4520114"
            ]
          },
          "4520114": {
            "id": "4520114",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "这不是重点！我现在没傻——！",
            "nextDialogs": [
              "4520115"
            ]
          },
          "4520115": {
            "id": "4520115",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "你不会真的不认识那个和狼群一起生活的男孩子吧？",
            "nextDialogs": [
              "4520116"
            ]
          },
          "4520116": {
            "id": "4520116",
            "speakerId": 1000,
            "speakerName": "安柏",
            "text": "你在说什么啊——不明白——",
            "nextDialogs": [
              "4520117"
            ]
          },
          "4520117": {
            "id": "4520117",
            "speakerId": 1000,
            "speakerName": "安柏",
            "text": "不过，说到狼。 我最近在调查一件事情。",
            "nextDialogs": [
              "4520118"
            ]
          },
          "4520118": {
            "id": "4520118",
            "speakerId": 1000,
            "speakerName": "安柏",
            "text": "本来只在「奔狼领」活动的狼群，最近胆子变大了。",
            "nextDialogs": [
              "4520119"
            ]
          },
          "4520119": {
            "id": "4520119",
            "speakerId": 1000,
            "speakerName": "安柏",
            "text": "据说，袭击了「醉汉峡」附近的车队…",
            "nextDialogs": [
              "4520120"
            ]
          },
          "4520120": {
            "id": "4520120",
            "speakerId": 1000,
            "speakerName": "安柏",
            "text": "如果有空的话，来协助我调查一下，可以吗？"
          },
          "4520125": {
            "id": "4520125",
            "speakerId": 1000,
            "speakerName": "安柏",
            "text": "啊，你看起来挺闲的。",
            "nextDialogs": [
              "4520126"
            ]
          },
          "4520126": {
            "id": "4520126",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "呃，一般说了这句话之后——",
            "nextDialogs": [
              "4520127"
            ]
          },
          "4520127": {
            "id": "4520127",
            "speakerId": 1000,
            "speakerName": "安柏",
            "text": "我最近很忙哦。毕竟侦察骑士责任重大嘛——你要来帮忙吗？",
            "nextDialogs": [
              "4520129"
            ]
          },
          "4520129": {
            "id": "4520129",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "果然是这句话！"
          }
        }
      }
    },
    {
      "subId": "45202",
      "subQuestName": "前往醉汉峡",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "4520201"
        ],
        "dialogs": {
          "4520201": {
            "id": "4520201",
            "speakerId": 1000,
            "speakerName": "安柏",
            "text": "前方有骚乱！",
            "nextDialogs": [
              "4520202"
            ]
          },
          "4520202": {
            "id": "4520202",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "不是狼群，好像是丘丘人部落在袭击货车！",
            "nextDialogs": [
              "4520203"
            ]
          },
          "4520203": {
            "id": "4520203",
            "speakerId": 1000,
            "speakerName": "安柏",
            "text": "唔…这倒不是什么罕见的情况呢。",
            "nextDialogs": [
              "4520204"
            ]
          },
          "4520204": {
            "id": "4520204",
            "speakerId": 1000,
            "speakerName": "安柏",
            "text": "好啦，闲话少说，我们赶快去帮忙吧。"
          }
        }
      }
    },

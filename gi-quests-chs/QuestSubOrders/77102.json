  "subQuests": [
    {
      "subId": "7710201",
      "subQuestName": "前往礼堂",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "771020701"
        ],
        "dialogs": {
          "771020701": {
            "id": "771020701",
            "speakerId": 1000,
            "speakerName": "娜斯佳",
            "text": "前面就是通往礼堂的桥了，怎么还没见到弗瑞奥萨姐姐，平时总能在这碰到她…",
            "nextDialogs": [
              "771020702"
            ]
          },
          "771020702": {
            "id": "771020702",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "唔…弗瑞奥萨是娜斯佳很重要的人吗？听你提起好几次啦。",
            "nextDialogs": [
              "771020703"
            ]
          },
          "771020703": {
            "id": "771020703",
            "speakerId": 1000,
            "speakerName": "娜斯佳",
            "text": "#她可是我的偶像！当然，现在她还是我的偶像一号，{NICKNAME}{M#大哥哥}{F#大姐姐}暂居二位。",
            "nextDialogs": [
              "771020704"
            ]
          },
          "771020704": {
            "id": "771020704",
            "speakerId": 1000,
            "speakerName": "娜斯佳",
            "text": "等有时间你们切磋切磋，或许就能重新排名了！",
            "nextDialogs": [
              "771020706",
              "771020708"
            ]
          },
          "771020706": {
            "id": "771020706",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "#没错，我们{NICKNAME}可是很能打的！",
            "nextDialogs": [
              "771020709"
            ]
          },
          "771020709": {
            "id": "771020709",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "不过，我明白了，娜斯佳喜欢打架厉害的人，越厉害越好！",
            "nextDialogs": [
              "771020710"
            ]
          },
          "771020710": {
            "id": "771020710",
            "speakerId": 1000,
            "speakerName": "娜斯佳",
            "text": "不对不对，小小派蒙误会了哦，我喜欢能保护别人的人，所以弗瑞奥萨姐姐、扎拉、医生，还有你们，我都喜欢呢！",
            "nextDialogs": [
              "771020711"
            ]
          },
          "771020711": {
            "id": "771020711",
            "speakerId": 1000,
            "speakerName": "娜斯佳",
            "text": "只不过能力越大，能保护的人也就越多…我觉得这就是弗瑞奥萨姐姐愿意长出树枝的原因！",
            "nextDialogs": [
              "771020712"
            ]
          },
          "771020712": {
            "id": "771020712",
            "speakerId": 1000,
            "speakerName": "娜斯佳",
            "text": "…据说，她是镇上第一个长出树枝的人，医生让她长出树枝后，她有了新的、更有力气的手臂，打架也更厉害了。",
            "nextDialogs": [
              "771020713"
            ]
          },
          "771020713": {
            "id": "771020713",
            "speakerId": 1000,
            "speakerName": "娜斯佳",
            "text": "后来，大家大部分时间都呆在礼堂里，她就呆在礼堂外保护大家了…"
          },
          "771020708": {
            "id": "771020708",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "喂喂，怎么还没有开始切磋就要逃跑了？我可是相信你的实力的！"
          }
        }
      }
    },
    {
      "subId": "7710229",
      "subQuestName": "击败弗瑞奥萨",
      "sceneId": null,
      "locations": [],

      }
    },
    {
      "subId": "7710236",
      "subQuestName": "(test)废弃$HIDDEN",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "771021301"
        ],
        "dialogs": {
          "771021301": {
            "id": "771021301",
            "speakerId": 1000,
            "speakerName": "娜斯佳",
            "text": "怎么还没见到弗瑞奥萨姐姐，平时她应该都在这块啊…好想见到她！",
            "nextDialogs": [
              "771021302"
            ]
          },
          "771021302": {
            "id": "771021302",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "唔…弗瑞奥萨是娜斯佳很重要的姐姐吗？",
            "nextDialogs": [
              "771021303"
            ]
          },
          "771021303": {
            "id": "771021303",
            "speakerId": 1000,
            "speakerName": "娜斯佳",
            "text": "#她可是我的偶像！当然，现在她是我的偶像一号，{NICKNAME}{M#大哥哥}{F#大姐姐}是偶像二号。",
            "nextDialogs": [
              "771021304"
            ]
          },
          "771021304": {
            "id": "771021304",
            "speakerId": 1000,
            "speakerName": "娜斯佳",
            "text": "不过这是暂定的排名，等什么时候你们有机会能切磋切磋，或许就有重新排名的机会了！",
            "nextDialogs": [
              "771021306",
              "771021308"
            ]
          },
          "771021306": {
            "id": "771021306",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "#没错没错，我们{NICKNAME}可是很能打的！",
            "nextDialogs": [
              "771021309"
            ]
          },
          "771021309": {
            "id": "771021309",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "不过我明白了，娜斯佳喜欢打架厉害的人，越厉害越好！",
            "nextDialogs": [
              "771021310"
            ]
          },
          "771021310": {
            "id": "771021310",
            "speakerId": 1000,
            "speakerName": "娜斯佳",
            "text": "不对不对，小小派蒙误会了哦，我喜欢能保护别人的人，所以弗瑞奥萨姐姐、安卡、医生，还有你们，我都喜欢呢！",
            "nextDialogs": [
              "771021311"
            ]
          },
          "771021311": {
            "id": "771021311",
            "speakerId": 1000,
            "speakerName": "娜斯佳",
            "text": "只不过能力越大，能保护的人也就越多…我觉得这就是弗瑞奥萨姐姐愿意长出树枝的原因！",
            "nextDialogs": [
              "771021312"
            ]
          },
          "771021312": {
            "id": "771021312",
            "speakerId": 1000,
            "speakerName": "娜斯佳",
            "text": "…据说，她是镇上第一个长出树枝的人，医生让她长出树枝后，她之前的毛病都没有啦…打架也更厉害了…",
            "nextDialogs": [
              "771021313"
            ]
          },
          "771021313": {
            "id": "771021313",
            "speakerId": 1000,
            "speakerName": "娜斯佳",
            "text": "后来，大家大部分时间都呆在礼堂里，她就呆在礼堂外保护大家了…",
            "nextDialogs": [
              "771021314"
            ]
          },
          "771021314": {
            "id": "771021314",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "所以娜斯佳想要长出树枝，也是因为想要保护更多人吗？",
            "nextDialogs": [
              "771021315"
            ]
          },
          "771021315": {
            "id": "771021315",
            "speakerId": 1000,
            "speakerName": "娜斯佳",
            "text": "那我倒是没有这么想过啦…毕竟我小小的，就算变得更厉害，也不会太厉害，我只是想要变得和家人一模一样啦…",
            "nextDialogs": [
              "771021316"
            ]
          },
          "771021316": {
            "id": "771021316",
            "speakerId": 1000,
            "speakerName": "娜斯佳",
            "text": "唔，等下如果见到弗瑞奥萨姐姐，不知道她还会不会认得我呢…",
            "nextDialogs": [
              "771021317"
            ]
          },
          "771021317": {
            "id": "771021317",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "肯定认得你，但她有概率像安卡一样把我们当坏虫了，暴揍一顿然后把我们烧了。",
            "nextDialogs": [
              "771021318"
            ]
          },
          "771021318": {
            "id": "771021318",
            "speakerId": 1000,
            "speakerName": "娜斯佳",
            "text": "唔，倒是不用担心这些，就算不是坏虫，弗瑞奥萨姐姐也会想要和你切磋切磋的。",
            "nextDialogs": [
              "771021319"
            ]
          },
          "771021319": {
            "id": "771021319",
            "speakerId": 1000,
            "speakerName": "娜斯佳",
            "text": "至于烧掉坏虫，这不归她管啦…所以就算你们真被当成了坏虫，应该也没有关系。",
            "nextDialogs": [
              "771021320"
            ]
          },
          "771021320": {
            "id": "771021320",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "最好是没有关系啦！"
          },
          "771021308": {
            "id": "771021308",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "喂喂，怎么还没有开始打就要逃跑了…我可是相信你的实力的！"
          }
        }
      }
    },

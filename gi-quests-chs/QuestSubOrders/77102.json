    {
      "subId": "7710202",
      "subQuestName": "进入礼堂",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "771020201"
        ],
        "dialogs": {
          "771020201": {
            "id": "771020201",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "怎么没有反应？不会是因为太久没用，开关坏掉了吧！",
            "nextDialogs": [
              "771020202"
            ]
          },
          "771020202": {
            "id": "771020202",
            "speakerId": 1000,
            "speakerName": "娜斯佳",
            "text": "唔，我记得还有个开关在另一边，同时打开开关，就可以打开幕布了。",
            "nextDialogs": [
              "771020203"
            ]
          },
          "771020203": {
            "id": "771020203",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "那我飞过去，你们留在这里打开这边的开关…",
            "nextDialogs": [
              "771020206"
            ]
          },
          "771020206": {
            "id": "771020206",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "喂喂！瞧不起谁呢，只是一个小小开关…嗯…呃啊…这开关一定是被卡住了！",
            "nextDialogs": [
              "771020207"
            ]
          },
          "771020207": {
            "id": "771020207",
            "speakerId": 1000,
            "speakerName": "娜斯佳",
            "text": "#我来帮帮小小派蒙吧，我们两个加起来，一定能顶上一个{NICKNAME}{M#大哥哥}{F#大姐姐}。",
            "nextDialogs": [
              "771020208"
            ]
          },
          "771020208": {
            "id": "771020208",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "真得顶得上吗？等等…一起用力…三，二，一…",
            "nextDialogs": [
              "771020209"
            ]
          },
          "771020209": {
            "id": "771020209",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "成功了！我和娜斯佳留在这边，你去对面，到时候，我一声令下，我们同时打开机关…",
            "nextDialogs": [
              "771020210"
            ]
          },
          "771020210": {
            "id": "771020210",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "明白，谨遵长官指令！",
            "nextDialogs": [
              "771020211"
            ]
          },
          "771020211": {
            "id": "771020211",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "我看看…从那边应该可以过去。",
            "nextDialogs": [
              "771020212"
            ]
          },
          "771020212": {
            "id": "771020212",
            "speakerId": 1000,
            "speakerName": "娜斯佳",
            "text": "#好危险的路！{NICKNAME}{M#大哥哥}{F#大姐姐}要小心哦…现在你还没有长出树枝，摔一跤会很痛！"
          }
        }
      }
    },
    {
      "subId": "7710203",
      "subQuestName": "寻找进入礼堂内部的方法",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "771020301"
        ],
        "dialogs": {
          "771020301": {
            "id": "771020301",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "#好像可以了！唔，这里有升降梯，我们和{NICKNAME}在下面会合吧。",
            "nextDialogs": [
              "771020302"
            ]
          },
          "771020302": {
            "id": "771020302",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "#喂，{NICKNAME}——我们到楼下会合——"
          }
        }
      }
    },
    {
      "subId": "7710204",
      "subQuestName": "(test)与娜斯佳对话",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "771020101"
        ],
        "dialogs": {
          "771020101": {
            "id": "771020101",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "这边打不开…那边也是…",
            "nextDialogs": [
              "771020102"
            ]
          },
          "771020102": {
            "id": "771020102",
            "speakerId": 1000,
            "speakerName": "娜斯佳",
            "text": "#小小派蒙，{NICKNAME}{M#大哥哥}{F#大姐姐}，我们平时都走中间这扇门，但现在它好像从里面被关上了…",
            "nextDialogs": [
              "771020103"
            ]
          },
          "771020103": {
            "id": "771020103",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "这边好像可以进去。",
            "nextDialogs": [
              "771020104"
            ]
          },
          "771020104": {
            "id": "771020104",
            "speakerId": 1000,
            "speakerName": "娜斯佳",
            "text": "唔，我好像…刚好可以从这里钻进去？你们等等我，我去帮你们开门。",
            "nextDialogs": [
              "771020105"
            ]
          },
          "771020105": {
            "id": "771020105",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "好哦，那娜斯佳有什么麻烦就喊我们，至少我也能钻过来帮忙！"
          }
        }
      }
    },
    {
      "subId": "7710205",
      "subQuestName": "等待娜斯佳开门",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "771020501"
        ],
        "dialogs": {
          "771020501": {
            "id": "771020501",
            "speakerId": 1000,
            "speakerName": "娜斯佳",
            "text": "呼…大家都没事就好！我都没想到，这里还有这么多人…藏在架子的后面。",
            "nextDialogs": [
              "771020502"
            ]
          },
          "771020502": {
            "id": "771020502",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "我们也没想到…上一秒还静悄悄的，下一秒，呼啦呼啦全跑出来了！",
            "nextDialogs": [
              "771020503"
            ]
          },
          "771020503": {
            "id": "771020503",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "不过，这里出现了一条新的路。",
            "nextDialogs": [
              "771020504"
            ]
          },
          "771020504": {
            "id": "771020504",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "像是通往「家」的道路。",
            "nextDialogs": [
              "771020505"
            ]
          },
          "771020505": {
            "id": "771020505",
            "speakerId": 1000,
            "speakerName": "娜斯佳",
            "text": "我不知道，但这看起来像是唯一的道路，医生说过，「唯一的道路就是正确的道路」。",
            "nextDialogs": [
              "771020506"
            ]
          },
          "771020506": {
            "id": "771020506",
            "speakerId": 1000,
            "speakerName": "娜斯佳",
            "text": "那只要沿着这条路走，我一定能回到妈妈的身边，成为「完全树」…",
            "nextDialogs": [
              "771020507"
            ]
          },
          "771020507": {
            "id": "771020507",
            "speakerId": 1000,
            "speakerName": "娜斯佳",
            "text": "医生应该也在「家」里，他不会离开「家」的，扎拉在守护他，就证明了这一点。",
            "nextDialogs": [
              "771020508"
            ]
          },
          "771020508": {
            "id": "771020508",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "答案似乎快要揭晓了…",
            "nextDialogs": [
              "771020509"
            ]
          },
          "771020509": {
            "id": "771020509",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "那我们还是继续前进吧…等到了「家」，见到了卡谢依…不对，那个莫罗医生之后，应该就能得到我们想要的答案了。"
          }
        }
      }
    },
    {
      "subId": "7710235",
      "subQuestName": "(test)与娜斯佳对话",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "771021401"
        ],
        "dialogs": {
          "771021401": {
            "id": "771021401",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "哇，这里…好壮观…",
            "nextDialogs": [
              "771021402"
            ]
          },
          "771021402": {
            "id": "771021402",
            "speakerId": 1000,
            "speakerName": "娜斯佳",
            "text": "是啊，很漂亮对吧…只不过我有时候不大喜欢这里呢。",
            "nextDialogs": [
              "771021403"
            ]
          },
          "771021403": {
            "id": "771021403",
            "speakerId": 1000,
            "speakerName": "娜斯佳",
            "text": "在这里的时候，我们拿着莫罗医生写的小册子，听他讲故事…大人们都听得很认真，所以我们小孩也不能说话。",
            "nextDialogs": [
              "771021404"
            ]
          },
          "771021404": {
            "id": "771021404",
            "speakerId": 1000,
            "speakerName": "娜斯佳",
            "text": "但莫罗医生讲的故事我不能完全听懂，有时候，我就会偷偷睡觉，或者发呆，看着周围的布置。",
            "nextDialogs": [
              "771021405"
            ]
          },
          "771021405": {
            "id": "771021405",
            "speakerId": 1000,
            "speakerName": "娜斯佳",
            "text": "所以这里大部分地方，我都很有印象…嗯？现在怎么好像有些地方和我脑子里想的不一样了呢，我想想…",
            "nextDialogs": [
              "771021406"
            ]
          },
          "771021406": {
            "id": "771021406",
            "speakerId": 1000,
            "speakerName": "娜斯佳",
            "text": "对哦！这里的幕布怎么拉上了？我们得穿过这里…后面有路。",
            "nextDialogs": [
              "771021407"
            ]
          },
          "771021407": {
            "id": "771021407",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "看那里！好像那里有连着幕布的机关！",
            "nextDialogs": [
              "771021408"
            ]
          },
          "771021408": {
            "id": "771021408",
            "speakerId": 1000,
            "speakerName": "娜斯佳",
            "text": "观察好仔细！应该就是那个机关了，我们一起去打开它吧！不过那里好高，我没办法上去…",
            "nextDialogs": [
              "771021409"
            ]
          },
          "771021409": {
            "id": "771021409",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "娜斯佳可以在这里等我们哦。",
            "nextDialogs": [
              "771021410"
            ]
          },
          "771021410": {
            "id": "771021410",
            "speakerId": 1000,
            "speakerName": "娜斯佳",
            "text": "…不要不要，想要和你们一起走呢，家人就是要在一起的呀。",
            "nextDialogs": [
              "771021411"
            ]
          },
          "771021411": {
            "id": "771021411",
            "speakerId": 1000,
            "speakerName": "娜斯佳",
            "text": "就让我跟着吧…放心，我会和小小派蒙一样，跟得紧紧的…",
            "nextDialogs": [
              "771021412"
            ]
          },
          "771021412": {
            "id": "771021412",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "好、好吧，那你等一下哦，我们想想办法。"
          }
        }
      }
    },

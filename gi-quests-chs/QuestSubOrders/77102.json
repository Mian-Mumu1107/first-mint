    {
      "subId": "7710216",
      "subQuestName": "乘坐升降梯",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "771021601"
        ],
        "dialogs": {
          "771021601": {
            "id": "771021601",
            "speakerId": 1000,
            "speakerName": "娜斯佳",
            "text": "唔，只要穿过门扉，就能回「家」了，可是…",
            "nextDialogs": [
              "771021603"
            ]
          },
          "771021603": {
            "id": "771021603",
            "speakerId": 1000,
            "speakerName": "娜斯佳",
            "text": "没、没有，不知道为什么，我的心里有点乱糟糟的，像是堆满了落叶一样…",
            "nextDialogs": [
              "771021604"
            ]
          },
          "771021604": {
            "id": "771021604",
            "speakerId": 1000,
            "speakerName": "娜斯佳",
            "text": "医生以前教过我「近乡情怯」这个词，当时我总是不懂，现在突然有点明白了呢…",
            "nextDialogs": [
              "771021606"
            ]
          },
          "771021606": {
            "id": "771021606",
            "speakerId": 1000,
            "speakerName": "娜斯佳",
            "text": "好、好哦，我相信你。"
          }
        }
      }
    },
    {

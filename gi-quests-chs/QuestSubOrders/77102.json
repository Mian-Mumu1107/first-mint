    {
      "subId": "7710211",
      "subQuestName": "同时启动两处幕布开关",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "771021101"
        ],
        "dialogs": {
          "771021101": {
            "id": "771021101",
            "speakerId": 1000,
            "speakerName": "娜斯佳",
            "text": "我们能一起上去打开开关了吗？",
            "nextDialogs": [
              "771021104"
            ]
          },
          "771021104": {
            "id": "771021104",
            "speakerId": 1000,
            "speakerName": "娜斯佳",
            "text": "好哦…那你加油。"
          }
        }
      }
    },

    {
      "subId": "7710230",
      "subQuestName": "(test)击败弗瑞奥萨后对话",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "771020801"
        ],
        "dialogs": {
          "771020801": {
            "id": "771020801",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "她离开了…我们可以进入礼堂了吧！",
            "nextDialogs": [
              "771020802"
            ]
          },
          "771020802": {
            "id": "771020802",
            "speakerId": 1000,
            "speakerName": "娜斯佳",
            "text": "……",
            "nextDialogs": [
              "771020803"
            ]
          },
          "771020803": {
            "id": "771020803",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "娜斯佳？怎么了，马上就可以到「家」了哦…",
            "nextDialogs": [
              "771020804"
            ]
          },
          "771020804": {
            "id": "771020804",
            "speakerId": 1000,
            "speakerName": "娜斯佳",
            "text": "我只是不理解，弗瑞奥萨姐姐为什么会阻止我…为什么她还没变成「完全树」呢…"
          }
        }
      }
    },

      }
    },
    {
      "subId": "7904612",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "790461201"
        ],
        "dialogs": {
          "790461201": {
            "id": "790461201",
            "speakerId": 21011,
            "speakerName": "落单的水形幻灵",
            "text": "通过那部机关，就有可能找到密室的钥匙…拜托你们两位了！"
          }
        }
      }
    },
    {
      "subId": "7904613",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "790461301"
        ],
        "dialogs": {
          "790461301": {
            "id": "790461301",
            "speakerId": 20976,
            "speakerName": "来自喇叭的旁白",
            "text": "两位智者注视着眼前的水形幻灵，可惜它已变成了冰冷的石像，不会再回应智者们的呼唤…",
            "nextDialogs": [
              "790461302"
            ]
          },
          "790461302": {
            "id": "790461302",
            "speakerId": 20976,
            "speakerName": "来自喇叭的旁白",
            "text": "但这一切努力不会白费，它会这样主动冒险，当然是因为深信着两位智者！"
          }
        }
      }
    }
  ]
}
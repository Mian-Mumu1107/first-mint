  "subQuests": [
    {
      "subId": "7904601",
      "subQuestName": "聆听剧目告示",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "790460101"
        ],
        "dialogs": {
          "790460101": {
            "id": "790460101",
            "speakerId": 20975,
            "speakerName": "乐园告示喇叭",
            "text": "参演人员已就位，所有机关运转正常。",
            "nextDialogs": [
              "790460102"
            ]
          },
          "790460102": {
            "id": "790460102",
            "speakerId": 20975,
            "speakerName": "乐园告示喇叭",
            "text": "「黛依阿的三日遐想」之「瞳孔里的固形魔咒」，正式开幕…",
            "nextDialogs": [
              "790460103"
            ]
          },
          "790460103": {
            "id": "790460103",
            "speakerId": 20977,
            "speakerName": "来自喇叭的旁白",
            "text": "在幽深诡异的密林边缘，两位兼具学识与胆量的智者，发现了一位落单的水形幻灵…",
            "nextDialogs": [
              "790460104"
            ]
          },
          "790460104": {
            "id": "790460104",
            "speakerId": 21011,
            "speakerName": "落单的水形幻灵",
            "text": "谁来帮帮我…我不想抛弃我的伙伴…",
            "nextDialogs": [
              "790460105"
            ]
          },
          "790460105": {
            "id": "790460105",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "「小水珠」？「小水珠」居然说话了！",
            "nextDialogs": [
              "790460108"
            ]
          },
          "790460108": {
            "id": "790460108",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "原来如此，这位「小水珠」就是话剧里的关键演员了，要和我们配合？",
            "nextDialogs": [
              "790460109"
            ]
          },
          "790460109": {
            "id": "790460109",
            "speakerId": 20977,
            "speakerName": "来自喇叭的旁白",
            "text": "真是万幸，两位智者对于水形幻灵的言语早有研究，听懂了水形幻灵的求助。",
            "nextDialogs": [
              "790460110"
            ]
          },
          "790460110": {
            "id": "790460110",
            "speakerId": 20977,
            "speakerName": "来自喇叭的旁白",
            "text": "这简直是命运的安排！如此令人感动的相逢，岂有不帮水形幻灵的道理？",
            "nextDialogs": [
              "790460111"
            ]
          },
          "790460111": {
            "id": "790460111",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "我们也有新的设定吗？听起来蛮厉害的！"
          }
        }
      }
    },

    {
      "subId": "7904610",
      "subQuestName": "设法应对幽魂的诡计",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "790461001"
        ],
        "dialogs": {
          "790461001": {
            "id": "790461001",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "可恶，根本不可能躲开这一大片视线，这是耍赖，耍赖！",
            "nextDialogs": [
              "790461002"
            ]
          },
          "790461002": {
            "id": "790461002",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "好想把那些幽魂的机关一脚踢翻！",
            "nextDialogs": [
              "790461003"
            ]
          },
          "790461003": {
            "id": "790461003",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "等等，「小水珠」，你要干什么？那边是幽魂的视野，危险！",
            "nextDialogs": [
              "790461004"
            ]
          },
          "790461004": {
            "id": "790461004",
            "speakerId": 21012,
            "speakerName": "愤怒的幽魂头领",
            "text": "吵闹的家伙，你疯了吗？还是你已经放弃希望了，想要和你的同伴在另一个世界相见？",
            "nextDialogs": [
              "790461005"
            ]
          },
          "790461005": {
            "id": "790461005",
            "speakerId": 21013,
            "speakerName": "愉悦的幽魂头领",
            "text": "不对，它要用身体遮挡视线…怎么会有这么古典的献身思想！",
            "nextDialogs": [
              "790461006"
            ]
          },
          "790461006": {
            "id": "790461006",
            "speakerId": 20977,
            "speakerName": "来自喇叭的旁白",
            "text": "事态出现了转机！落单的水形幻灵拦在了幽魂前方，慢慢化为了石像，用自己的身体挡住了致命的视线！",
            "nextDialogs": [
              "790461007"
            ]
          },
          "790461007": {
            "id": "790461007",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "「小水珠」…主动变成石头了…全都是为了让我们拿到钥匙…",
            "nextDialogs": [
              "790461010"
            ]
          },
          "790461010": {
            "id": "790461010",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "对，对哦！只要被幽魂盯住的时间不长，应该没有问题的！",
            "nextDialogs": [
              "790461011"
            ]
          },
          "790461011": {
            "id": "790461011",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "难道「小水珠」反过来利用了这一点？好聪明，好勇敢！",
            "nextDialogs": [
              "790461012"
            ]
          },
          "790461012": {
            "id": "790461012",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "#{NICKNAME}，我们赶快去找钥匙，拿回解药，不要让「小水珠」难受太久！"
          }
        }
      }
    },
    {
      "subId": "7904611",
      "subQuestName": "使用「聚流映灯」取得钥匙",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "790461101"
        ],
        "dialogs": {
          "790461101": {
            "id": "790461101",
            "speakerId": 1006,
            "speakerName": "Black Screen",
            "text": "来自喇叭的旁白继续描述着眼前的神奇景象——\\n两位智者将药剂轻轻滴在水形幻灵的石像上，奇妙的现象发生了…\\n时间仿佛发生了倒转，石化的水形幻灵恢复如初…",
            "nextDialogs": [
              "790461102"
            ]
          },
          "790461102": {
            "id": "790461102",
            "speakerId": 21011,
            "speakerName": "落单的水形幻灵",
            "text": "呜…原来彻底变成石头是这样的感觉…好难受好难受，不能让同伴们继续忍受这种委屈了。",
            "nextDialogs": [
              "790461103"
            ]
          },
          "790461103": {
            "id": "790461103",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "「小水珠」，你怎么一声不吭就冲了上去，吓死我了啦！还好我们马上就拿到了解药…",
            "nextDialogs": [
              "790461104"
            ]
          },
          "790461104": {
            "id": "790461104",
            "speakerId": 21011,
            "speakerName": "落单的水形幻灵",
            "text": "刚才那些幽魂一直在怪叫，我好害怕，完全不敢说话…",
            "nextDialogs": [
              "790461105"
            ]
          },
          "790461105": {
            "id": "790461105",
            "speakerId": 21011,
            "speakerName": "落单的水形幻灵",
            "text": "而且你们是智者，我觉得，根本不用我来提醒你们。",
            "nextDialogs": [
              "790461106"
            ]
          },
          "790461106": {
            "id": "790461106",
            "speakerId": 21011,
            "speakerName": "落单的水形幻灵",
            "text": "就算我彻底变成了石头，拿到解药后，你们也会第一时间救我的，和之前没什么区别，不用这么焦急！",
            "nextDialogs": [
              "790461107"
            ]
          },
          "790461107": {
            "id": "790461107",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "呃啊…难道，难道是我太投入了吗？只顾着担心「小水珠」了…",
            "nextDialogs": [
              "790461110"
            ]
          },
          "790461110": {
            "id": "790461110",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "噫！明明是来玩的游客，自己却演上头了，有点难为情…",
            "nextDialogs": [
              "790461111"
            ]
          },
          "790461111": {
            "id": "790461111",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "总之…我们已经成功了，接下来，你就拿着这份解药，去拯救你的同伴吧！",
            "nextDialogs": [
              "790461112"
            ]
          },
          "790461112": {
            "id": "790461112",
            "speakerId": 21011,
            "speakerName": "落单的水形幻灵",
            "text": "谢谢，太谢谢你们了，我…无比感激你们！",
            "nextDialogs": [
              "790461113"
            ]
          },
          "790461113": {
            "id": "790461113",
            "speakerId": 21011,
            "speakerName": "落单的水形幻灵",
            "text": "我和伙伴们会一直牢记你们的恩情的！"
          }
        }
      }
    },

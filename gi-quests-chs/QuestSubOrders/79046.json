    {
      "subId": "7904609",
      "subQuestName": "解救落单的水形幻灵",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "790460901"
        ],
        "dialogs": {
          "790460901": {
            "id": "790460901",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "「小水珠」变成不能动的石头了，还能喝下解药吗？而且，水要怎么喝水…",
            "nextDialogs": [
              "790460902"
            ]
          },
          "790460902": {
            "id": "790460902",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "难道说，这种药剂是外用的？我们快试试看！"
          }
        }
      }
    },
    {
      "subId": "7904612",

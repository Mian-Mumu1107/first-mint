        ],
        "dialogs": {
          "740630701": {
            "id": "740630701",
            "speakerId": 1000,
            "speakerName": "格兰维尔",
            "text": "在生产区需要遵守劳动纪律，安全第一。没什么问题的话不要打扰我工作。"
          }
        }
      }
    },
    {
      "subId": "7406302",
      "subQuestName": "与奈莉对话",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "740630201"
        ],
        "dialogs": {
          "740630201": {
            "id": "740630201",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "嗯？这里怎么会有留影机？",
            "nextDialogs": [
              "740630202"
            ]
          },
          "740630202": {
            "id": "740630202",
            "speakerId": 1002,
            "speakerName": "奈莉",
            "text": "「有新闻的地方就有留影机」，你们没听过这句话吗？",
            "nextDialogs": [
              "740630204",
              "740630207"
            ]
          },
          "740630204": {
            "id": "740630204",
            "speakerId": 1002,
            "speakerName": "奈莉",
            "text": "可是这句话是我刚编的欸，你是在哪里听过的？",
            "nextDialogs": [
              "740630205"
            ]
          },
          "740630205": {
            "id": "740630205",
            "speakerId": 1002,
            "speakerName": "奈莉",
            "text": "唉，果然这世上根本没有什么新鲜东西。不管说什么、写什么，都只能是对他者的戏仿。",
            "nextDialogs": [
              "740630208"
            ]
          },
          "740630208": {
            "id": "740630208",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "留影机有了，新闻在哪儿？",
            "nextDialogs": [
              "740630209"
            ]
          },
          "740630209": {
            "id": "740630209",
            "speakerId": 1002,
            "speakerName": "奈莉",
            "text": "新闻…就像钓鱼一样。需要耐心的等待，在准确的时机做出正确的判断，这样才能钓上大鱼…",
            "nextDialogs": [
              "740630210"
            ]
          },
          "740630210": {
            "id": "740630210",
            "speakerId": 1002,
            "speakerName": "奈莉",
            "text": "哦，不，我是说，这样才能钓到大新闻。嗯？好像也不对，算了，不管了！"
          },
          "740630207": {
            "id": "740630207",
            "speakerId": 1002,
            "speakerName": "奈莉",
            "text": "哦哦！那你们现在听过了。请记住，如果要在别处引用，一定要注明来源！也就是我！"
          }
        }
      }
    },
    {
      "subId": "7406303",
      "subQuestName": "关闭扩音机",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "740630301"
        ],
        "dialogs": {
          "740630301": {
            "id": "740630301",
            "speakerId": 1002,
            "speakerName": "奈莉",
            "text": "我一定要拍出让前辈刮目相看的画片！",
            "nextDialogs": [
              "740630302"
            ]
          },
          "740630302": {
            "id": "740630302",
            "speakerId": 1002,
            "speakerName": "奈莉",
            "text": "可恶，还是好想要白金典藏型…"
          }
        }
      }
    },
    {
      "subId": "7406304",
      "subQuestName": "与看守对话",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "740630401"
        ],
        "dialogs": {
          "740630401": {
            "id": "740630401",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "你好，我们发现扩音机好像出了点小问题…就在那边。",
            "nextDialogs": [
              "740630402"
            ]
          },
          "740630402": {
            "id": "740630402",
            "speakerId": 1000,
            "speakerName": "格兰维尔",
            "text": "又故障了？真是怪事…明明之前找克兰茨修过。看来他这水平还不如我呢，明明过去都是锤两下就好。",
            "nextDialogs": [
              "740630403"
            ]
          },
          "740630403": {
            "id": "740630403",
            "speakerId": 1000,
            "speakerName": "格兰维尔",
            "text": "谢谢你们，我过去看看。",
            "nextDialogs": [
              "740630404"
            ]
          },
          "740630404": {
            "id": "740630404",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "辛苦啦！"
          }
        }
      }
    },
    {
      "subId": "7406306",
      "subQuestName": "等待看守到达指定位置",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "740630601"
        ],
        "dialogs": {
          "740630601": {
            "id": "740630601",
            "speakerId": 1000,
            "speakerName": "格兰维尔",
            "text": "到底哪里有问题？唔…"
          }
        }
      }
    },
    {
      "subId": "7406305",
      "subQuestName": "与奈莉对话",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "740630501"
        ],
        "dialogs": {
          "740630501": {
            "id": "740630501",
            "speakerId": 1002,
            "speakerName": "奈莉",
            "text": "这下前辈交给我的课题总算能完成了，我也是个独当一面的记者了！谢谢你们！",
            "nextDialogs": [
              "740630502"
            ]
          },
          "740630502": {
            "id": "740630502",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "看来是拍到了生动的画片呢。",
            "nextDialogs": [
              "740630503"
            ]
          },
          "740630503": {
            "id": "740630503",
            "speakerId": 1002,
            "speakerName": "奈莉",
            "text": "是啊，你们瞧。",
            "nextDialogs": [
              "740630505",
              "740630507"
            ]
          },
          "740630505": {
            "id": "740630505",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "是我完全看不懂的艺术…",
            "nextDialogs": [
              "740630508"
            ]
          },
          "740630508": {
            "id": "740630508",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "真的这样就可以了吗？",
            "nextDialogs": [
              "740630509"
            ]
          },
          "740630509": {
            "id": "740630509",
            "speakerId": 1002,
            "speakerName": "奈莉",
            "text": "哪里有问题吗？我觉得拍得很棒！前辈一定想不到我会拍出这样的画片来，肯定会大吃一惊的。",
            "nextDialogs": [
              "740630510"
            ]
          },
          "740630510": {
            "id": "740630510",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "真搞不懂你的评价标准…",
            "nextDialogs": [
              "740630511"
            ]
          },
          "740630511": {
            "id": "740630511",
            "speakerId": 1002,
            "speakerName": "奈莉",
            "text": "哎呀，这就是所谓的「象征意义大于实质内容」。我相信前辈肯定能读懂背后的含义！",
            "nextDialogs": [
              "740630512"
            ]
          },
          "740630512": {
            "id": "740630512",
            "speakerId": 1002,
            "speakerName": "奈莉",
            "text": "不管怎么说，谢谢你们帮忙，这些是给你们的。嘿嘿，下次要是能在可以钓鱼的地方聊天就好啦！"
          },
          "740630507": {
            "id": "740630507",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "唔唔，感觉多看一会儿就会头晕…"
          }
        }
      }
    },
    {

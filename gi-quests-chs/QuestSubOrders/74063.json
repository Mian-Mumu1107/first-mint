          },
          "740630005": {
            "id": "740630005",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "总之先去把扩音机关掉好了。",
            "nextDialogs": [
              "740630006"
            ]
          },
          "740630006": {
            "id": "740630006",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "接下来去找格兰维尔报告吧？就说扩音机出了点小问题…",
            "nextDialogs": [
              "740630007"
            ]
          },
          "740630007": {
            "id": "740630007",
            "speakerId": 1001,

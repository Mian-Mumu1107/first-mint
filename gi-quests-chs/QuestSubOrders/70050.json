    {
      "subId": "7005005",
      "subQuestName": "跟随逃跑的小猫",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "700500501"
        ],
        "dialogs": {
          "700500501": {
            "id": "700500501",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "…你看，都说了只是一只普通的小猫啦。",
            "nextDialogs": [
              "700500502"
            ]
          },
          "700500502": {
            "id": "700500502",
            "speakerId": 1000,
            "speakerName": "吉雅罗",
            "text": "居然…",
            "nextDialogs": [
              "700500503"
            ]
          },
          "700500503": {
            "id": "700500503",
            "speakerId": 1002,
            "speakerName": "陷入迷惑的小猫",
            "text": "喵？喵…喵喵？",
            "nextDialogs": [
              "700500505",
              "700500507"
            ]
          },
          "700500505": {
            "id": "700500505",
            "speakerId": 1002,
            "speakerName": "陷入迷惑的小猫",
            "text": "喵…？",
            "nextDialogs": [
              "700500508"
            ]
          },
          "700500508": {
            "id": "700500508",
            "speakerId": 1003,
            "speakerName": "Black Screen",
            "text": "小猫无奈地转身离开了…",
            "nextDialogs": [
              "700500509"
            ]
          },
          "700500509": {
            "id": "700500509",
            "speakerId": 1000,
            "speakerName": "吉雅罗",
            "text": "不过…你们说，这只小猫会不会就是玄文兽的幼体？它就这么潜伏在翘英庄里，等到成年，就把所有的茶树席卷一空…",
            "nextDialogs": [
              "700500510"
            ]
          },
          "700500510": {
            "id": "700500510",
            "speakerId": 1004,
            "speakerName": "洪分",
            "text": "吉雅罗小姐，怎么又是你…我都和你说过了，玄文兽不是这种温和的野兽。",
            "nextDialogs": [
              "700500511"
            ]
          },
          "700500511": {
            "id": "700500511",
            "speakerId": 1000,
            "speakerName": "吉雅罗",
            "text": "哎呀，洪分小姐，真是太巧了，您怎么也来了？",
            "nextDialogs": [
              "700500512"
            ]
          },
          "700500512": {
            "id": "700500512",
            "speakerId": 1004,
            "speakerName": "洪分",
            "text": "唉…请不要总是在我们这里念叨什么「罪案事件」，孩子们要是当真了可怎么办？",
            "nextDialogs": [
              "700500513"
            ]
          },
          "700500513": {
            "id": "700500513",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "你们俩认识？",
            "nextDialogs": [
              "700500514"
            ]
          },
          "700500514": {
            "id": "700500514",
            "speakerId": 1000,
            "speakerName": "吉雅罗",
            "text": "是啊，我来这里的时候，正是请这位小姐帮忙搬运行李的呢。还请教了很多有关民俗传说的问题。",
            "nextDialogs": [
              "700500515"
            ]
          },
          "700500515": {
            "id": "700500515",
            "speakerId": 1004,
            "speakerName": "洪分",
            "text": "我都说了很多次，玄文兽是不会在庄里出现，但吉雅罗小姐却总是不信，还说什么…",
            "nextDialogs": [
              "700500516"
            ]
          },
          "700500516": {
            "id": "700500516",
            "speakerId": 1000,
            "speakerName": "吉雅罗",
            "text": "不出现，也有不出现的取材方式。",
            "nextDialogs": [
              "700500517"
            ]
          },
          "700500517": {
            "id": "700500517",
            "speakerId": 1004,
            "speakerName": "洪分",
            "text": "又来了…唉，吉雅罗小姐，我是劝不动你了。但无论如何，请你一定不要离开庄里到处乱跑。",
            "nextDialogs": [
              "700500518"
            ]
          },
          "700500518": {
            "id": "700500518",
            "speakerId": 1004,
            "speakerName": "洪分",
            "text": "玄文兽是真实存在的猛兽，如果遇见它的话…唉，请您一定，务必不要独自离开庄里！",
            "nextDialogs": [
              "700500519"
            ]
          },
          "700500519": {
            "id": "700500519",
            "speakerId": 1003,
            "speakerName": "Black Screen",
            "text": "洪分无奈地离去了，看起来比刚才的小猫更疲惫一些…",
            "nextDialogs": [
              "700500520"
            ]
          },
          "700500520": {
            "id": "700500520",
            "speakerId": 1000,
            "speakerName": "吉雅罗",
            "text": "好啦，既然洪分小姐都这么说了，我们也只能去另外一个地方取材了，走，跟着我。"
          },
          "700500507": {
            "id": "700500507",
            "speakerId": 1002,
            "speakerName": "陷入迷惑的小猫",
            "text": "喵…"
          }
        }
      }
    },
    {
      "subId": "7005006",
      "subQuestName": "和吉雅罗一起继续取材",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "700500601"
        ],
        "dialogs": {
          "700500601": {
            "id": "700500601",
            "speakerId": 1000,
            "speakerName": "吉雅罗",
            "text": "怎么样？这个…",
            "nextDialogs": [
              "700500602"
            ]
          },
          "700500602": {
            "id": "700500602",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "茶釜。",
            "nextDialogs": [
              "700500603"
            ]
          },
          "700500603": {
            "id": "700500603",
            "speakerId": 1000,
            "speakerName": "吉雅罗",
            "text": "没错！就是茶…茶什么？总之…是一个很别致的东西啦！而且还在庄里的最中央，我觉得，它肯定有着特别的意义。",
            "nextDialogs": [
              "700500604"
            ]
          },
          "700500604": {
            "id": "700500604",
            "speakerId": 1000,
            "speakerName": "吉雅罗",
            "text": "唔…你们说，玄文兽会不会就住在这里面？",
            "nextDialogs": [
              "700500607"
            ]
          },
          "700500607": {
            "id": "700500607",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "如果这么写的话，总感觉你的小说里还会出现仙人之类的元素呢…",
            "nextDialogs": [
              "700500608"
            ]
          },
          "700500608": {
            "id": "700500608",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "这种主题的罪案小说，总觉得…",
            "nextDialogs": [
              "700500609"
            ]
          },
          "700500609": {
            "id": "700500609",
            "speakerId": 1000,
            "speakerName": "吉雅罗",
            "text": "…喔！你们的表情不错，是不是感觉，如果以玄文兽为主题写罪案小说的话，这份罪案会十分「荒谬」？",
            "nextDialogs": [
              "700500610"
            ]
          },
          "700500610": {
            "id": "700500610",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "欸？是、是有一点点这个感觉。无论如何，罪案小说都不可能以这种主题来发展剧情的吧？",
            "nextDialogs": [
              "700500611"
            ]
          },
          "700500611": {
            "id": "700500611",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "等等，难道你…",
            "nextDialogs": [
              "700500612"
            ]
          },
          "700500612": {
            "id": "700500612",
            "speakerId": 1000,
            "speakerName": "吉雅罗",
            "text": "#嗯，很敏锐嘛{NICKNAME}。不愧于你的大名。",
            "nextDialogs": [
              "700500613"
            ]
          },
          "700500613": {
            "id": "700500613",
            "speakerId": 1000,
            "speakerName": "吉雅罗",
            "text": "没错，我想要写的正是一篇「荒谬到不可能发生的罪案」。洪分小姐和你们的反应很有趣，我会写进小说里的。",
            "nextDialogs": [
              "700500614"
            ]
          },
          "700500614": {
            "id": "700500614",
            "speakerId": 1000,
            "speakerName": "吉雅罗",
            "text": "至于玄文兽嘛…它是我设计中的「犯案者」。一种传说中会吞噬庄内的恶人，却从未有人真正见过的「玄文兽」。",
            "nextDialogs": [
              "700500615"
            ]
          },
          "700500615": {
            "id": "700500615",
            "speakerId": 1000,
            "speakerName": "吉雅罗",
            "text": "在某一次节日中，有一位庄内人被人发现在野外遇害，看起来像是被猛兽袭击…",
            "nextDialogs": [
              "700500616"
            ]
          },
          "700500616": {
            "id": "700500616",
            "speakerId": 1000,
            "speakerName": "吉雅罗",
            "text": "但在第二天的庆典里，我的主角却再次遇见了本该死去的那位遇害者，随后，又一位死者出现了…",
            "nextDialogs": [
              "700500617"
            ]
          },
          "700500617": {
            "id": "700500617",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "之后呢？之后呢！",
            "nextDialogs": [
              "700500618"
            ]
          },
          "700500618": {
            "id": "700500618",
            "speakerId": 1000,
            "speakerName": "吉雅罗",
            "text": "没想好。",
            "nextDialogs": [
              "700500619"
            ]
          },
          "700500619": {
            "id": "700500619",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "…我要离开了。",
            "nextDialogs": [
              "700500620"
            ]
          },
          "700500620": {
            "id": "700500620",
            "speakerId": 1000,
            "speakerName": "吉雅罗",
            "text": "别呀，等我写完之后，肯定给你们寄两本。我还要有一个大忙想请你们帮我呢！",
            "nextDialogs": [
              "700500621"
            ]
          },
          "700500621": {
            "id": "700500621",
            "speakerId": 1000,
            "speakerName": "吉雅罗",
            "text": "洪分小姐不是一直说，我绝对不能独自离开庄里吗？这句话我可是好好听进去了。",
            "nextDialogs": [
              "700500622"
            ]
          },
          "700500622": {
            "id": "700500622",
            "speakerId": 1000,
            "speakerName": "吉雅罗",
            "text": "但现在嘛…既然你们来了，那我就不算是「独自一人」，也可以去庄外逛逛了。",
            "nextDialogs": [
              "700500623"
            ]
          },
          "700500623": {
            "id": "700500623",
            "speakerId": 1000,
            "speakerName": "吉雅罗",
            "text": "当然，我也不会去太远的地方！你们愿意帮我这个忙吗？"
          }
        }
      }
    },
    {
      "subId": "7005008",
      "subQuestName": "跟随吉雅罗前进",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "700500801"
        ],
        "dialogs": {
          "700500801": {
            "id": "700500801",
            "speakerId": 1000,
            "speakerName": "吉雅罗",
            "text": "这些东西是「灯笼」吗？看起来像是鱼的灯笼，真有意思。",
            "nextDialogs": [
              "700500802"
            ]
          },
          "700500802": {
            "id": "700500802",
            "speakerId": 1000,
            "speakerName": "吉雅罗",
            "text": "这些把手，是用来抬起这只灯笼的吗？嗯…这种拆卸式结构，只要设计的合理，悄悄加上一两节也不会被人发现…",
            "nextDialogs": [
              "700500803"
            ]
          },
          "700500803": {
            "id": "700500803",
            "speakerId": 1000,
            "speakerName": "吉雅罗",
            "text": "里面的空间很大，应该能轻松地装进去一些…",
            "nextDialogs": [
              "700500804"
            ]
          },
          "700500804": {
            "id": "700500804",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "停！把念头放在心里！",
            "nextDialogs": [
              "700500805"
            ]
          },
          "700500805": {
            "id": "700500805",
            "speakerId": 1000,
            "speakerName": "吉雅罗",
            "text": "欸？喔…喔！哈哈哈，看见有趣的东西，不由自主地又把念头说出来了。",
            "nextDialogs": [
              "700500806"
            ]
          },
          "700500806": {
            "id": "700500806",
            "speakerId": 1000,
            "speakerName": "吉雅罗",
            "text": "有了「灯笼」这种元素，我的小说一定会更有质感。",
            "nextDialogs": [
              "700500807"
            ]
          },
          "700500807": {
            "id": "700500807",
            "speakerId": 1000,
            "speakerName": "吉雅罗",
            "text": "#{NICKNAME}，能请你去给旁边这只大大的「鱼灯笼」留个影吗，我想要留下一些画片做参考。",
            "nextDialogs": [
              "700500810"
            ]
          },
          "700500810": {
            "id": "700500810",
            "speakerId": 1000,
            "speakerName": "吉雅罗",
            "text": "那留影的事就拜托你了…对了！你在留影的时候，请务必把这个灯笼完整记录下来，这对我来说很重要！",
            "nextDialogs": [
              "700500811"
            ]
          },
          "700500811": {
            "id": "700500811",
            "speakerId": 1000,
            "speakerName": "吉雅罗",
            "text": "…运用「尺寸」这种元素来设计诡计，好像很有趣的样子。唔，但是重量问题怎么解决呢…"
          }
        }
      }
    },
    {
      "subId": "7005009",
      "subQuestName": "为灯笼留影",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [],
        "dialogs": {}
      }
    },
    {
      "subId": "7005010",
      "subQuestName": "寻找吉雅罗",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "700501001"
        ],
        "dialogs": {
          "700501001": {
            "id": "700501001",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "咦？吉雅罗小姐人呢？她刚才还在这里的…",
            "nextDialogs": [
              "700501004"
            ]
          },
          "700501004": {
            "id": "700501004",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "不要说这种可怕的话啦！她肯定又是一边想着小说情节，一边到处乱跑了，我们去周围找找她吧。",
            "nextDialogs": [
              "700501005"
            ]
          },
          "700501005": {
            "id": "700501005",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "旁边茶田的地势很高，先从那边找。",
            "nextDialogs": [
              "700501006"
            ]
          },
          "700501006": {
            "id": "700501006",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "先从高处找起啊，嗯！就这么办！"
          }
        }
      }
    },
    {
      "subId": "7005011",
      "subQuestName": "寻找吉雅罗",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [],
        "dialogs": {}
      }
    },
    {
      "subId": "7005012",
      "subQuestName": "与吉雅罗对话",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "700501201"
        ],
        "dialogs": {
          "700501201": {
            "id": "700501201",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "吉雅罗小姐！你怎么在这里呀？",
            "nextDialogs": [
              "700501202"
            ]
          },
          "700501202": {
            "id": "700501202",
            "speakerId": 1000,
            "speakerName": "吉雅罗",
            "text": "…不对，不对，这种突然找到线索的方式也太唐突了。而且一个人被捆在这里一整晚，真的还能思考吗？",
            "nextDialogs": [
              "700501203"
            ]
          },
          "700501203": {
            "id": "700501203",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "呜哇…完全陷入思考了，她是找到什么重要的灵感了吗？",
            "nextDialogs": [
              "700501204"
            ]
          },
          "700501204": {
            "id": "700501204",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "不如说是遇见了重大的阻碍吧。",
            "nextDialogs": [
              "700501205"
            ]
          },
          "700501205": {
            "id": "700501205",
            "speakerId": 1000,
            "speakerName": "吉雅罗",
            "text": "#…{NICKNAME}，派蒙，你们来得正好。",
            "nextDialogs": [
              "700501206"
            ]
          },
          "700501206": {
            "id": "700501206",
            "speakerId": 1000,
            "speakerName": "吉雅罗",
            "text": "可以请你们把我捆在木桩上吗？",
            "nextDialogs": [
              "700501207"
            ]
          },
          "700501207": {
            "id": "700501207",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "我、我听错了？",
            "nextDialogs": [
              "700501208"
            ]
          },
          "700501208": {
            "id": "700501208",
            "speakerId": 1000,
            "speakerName": "吉雅罗",
            "text": "请你们二位，把我的双手捆起来，然后把我以「吊起双手」的姿势，吊在一棵树上。呃…反正都是木头，也差不多啦。",
            "nextDialogs": [
              "700501209"
            ]
          },
          "700501209": {
            "id": "700501209",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "我不想成为你小说里的嫌疑犯。",
            "nextDialogs": [
              "700501210"
            ]
          },
          "700501210": {
            "id": "700501210",
            "speakerId": 1000,
            "speakerName": "吉雅罗",
            "text": "请放心，我已经把责任书全部写好了，在此期间出现的一切意外，都由我本人负责。",
            "nextDialogs": [
              "700501211"
            ]
          },
          "700501211": {
            "id": "700501211",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "不是这个问题啦，你为什么突然要我们捆住你？你又没犯什么罪…",
            "nextDialogs": [
              "700501212"
            ]
          },
          "700501212": {
            "id": "700501212",
            "speakerId": 1000,
            "speakerName": "吉雅罗",
            "text": "但我小说里的主角，要在这里被村民们吊起双手，待在野外一整晚，等待着「玄文兽」的审判。",
            "nextDialogs": [
              "700501213"
            ]
          },
          "700501213": {
            "id": "700501213",
            "speakerId": 1000,
            "speakerName": "吉雅罗",
            "text": "后面的情节是，早就预料到这种情况的主角用某些手段活了下来，安全地度过了一晚，随后揭露一切的真相…",
            "nextDialogs": [
              "700501214"
            ]
          },
          "700501214": {
            "id": "700501214",
            "speakerId": 1000,
            "speakerName": "吉雅罗",
            "text": "…但是，我完全不知道被绑了一个晚上的人究竟是一种怎样的感觉，无论是语气，思考方式，行动能力，我都完全不知道！",
            "nextDialogs": [
              "700501215"
            ]
          },
          "700501215": {
            "id": "700501215",
            "speakerId": 1000,
            "speakerName": "吉雅罗",
            "text": "所以，我想要请你们把我捆起来，让我在这个地方待上一整晚，这样的话，我就能体验到这种感觉了。",
            "nextDialogs": [
              "700501218"
            ]
          },
          "700501218": {
            "id": "700501218",
            "speakerId": 1000,
            "speakerName": "吉雅罗",
            "text": "…唔。还有另外一种方式，但这种方式的效果不一定好。",
            "nextDialogs": [
              "700501219"
            ]
          },
          "700501219": {
            "id": "700501219",
            "speakerId": 1000,
            "speakerName": "吉雅罗",
            "text": "那就是，我以「高举双手」的姿势，在这里站着待上一整晚。",
            "nextDialogs": [
              "700501220"
            ]
          },
          "700501220": {
            "id": "700501220",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "不然…还是别写那本小说了吧，这样也太容易招人误解了…",
            "nextDialogs": [
              "700501221"
            ]
          },
          "700501221": {
            "id": "700501221",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "你的小说主角也太惨了…",
            "nextDialogs": [
              "700501222"
            ]
          },
          "700501222": {
            "id": "700501222",
            "speakerId": 1000,
            "speakerName": "吉雅罗",
            "text": "拜托了！这是最关键的一步，我的小说就快完成了！如果用这种方式的话，你们不用犯罪…",
            "nextDialogs": [
              "700501223"
            ]
          },
          "700501223": {
            "id": "700501223",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "我们本来也不用！",
            "nextDialogs": [
              "700501224"
            ]
          },
          "700501224": {
            "id": "700501224",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "我们本来也不用！",
            "nextDialogs": [
              "700501225"
            ]
          },
          "700501225": {
            "id": "700501225",
            "speakerId": 1000,
            "speakerName": "吉雅罗",
            "text": "啊…那个，不用那么麻烦，只要守在我旁边就好，免得我取材到半路被人拖走…或者被野兽拖走。",
            "nextDialogs": [
              "700501226"
            ]
          },
          "700501226": {
            "id": "700501226",
            "speakerId": 1000,
            "speakerName": "吉雅罗",
            "text": "我看看…考虑到小说里的氛围，果然还得去最上面才行…",
            "nextDialogs": [
              "700501227"
            ]
          },
          "700501227": {
            "id": "700501227",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "欸？你等等我们呀！",
            "nextDialogs": [
              "700501228"
            ]
          },
          "700501228": {
            "id": "700501228",
            "speakerId": 1003,
            "speakerName": "Black Screen",
            "text": "你们和吉雅罗一起爬到了茶田的最上一层…",
            "nextDialogs": [
              "700501229"
            ]
          },
          "700501229": {
            "id": "700501229",
            "speakerId": 1000,
            "speakerName": "吉雅罗",
            "text": "呼…有、有点冷…但是很有代入感…",
            "nextDialogs": [
              "700501230"
            ]
          },
          "700501230": {
            "id": "700501230",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "你真的要举着双手，在这里站一整夜吗？",
            "nextDialogs": [
              "700501231"
            ]
          },
          "700501231": {
            "id": "700501231",
            "speakerId": 1000,
            "speakerName": "吉雅罗",
            "text": "没错，我已经决定好了。写小说总得付出一些代价…",
            "nextDialogs": [
              "700501232"
            ]
          },
          "700501232": {
            "id": "700501232",
            "speakerId": 1000,
            "speakerName": "吉雅罗",
            "text": "那就拜托你们守在我旁边了，只要一晚上就好…只要一晚上就好…"
          }
        }
      }
    },
    {
      "subId": "7005013",
      "subQuestName": "等待至次日早上（6点到8点）",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [],
        "dialogs": {}
      }
    },
    {
      "subId": "7005015",
      "subQuestName": "与吉雅罗对话",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "700501501"
        ],
        "dialogs": {
          "700501501": {
            "id": "700501501",
            "speakerId": 1000,
            "speakerName": "吉雅罗",
            "text": "…在这种状态下，他应该没办法一个人走回村子…",
            "nextDialogs": [
              "700501502"
            ]
          },
          "700501502": {
            "id": "700501502",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "吉雅罗小姐！",
            "nextDialogs": [
              "700501503"
            ]
          },
          "700501503": {
            "id": "700501503",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "先把她扶起来吧…",
            "nextDialogs": [
              "700501504"
            ]
          },
          "700501504": {
            "id": "700501504",
            "speakerId": 1003,
            "speakerName": "Black Screen",
            "text": "把吉雅罗扶起来，让她好好坐在了地上…",
            "nextDialogs": [
              "700501505"
            ]
          },
          "700501505": {
            "id": "700501505",
            "speakerId": 1000,
            "speakerName": "吉雅罗",
            "text": "原来是这种感觉…还真是够难受的，不仅身子很疲惫，就连思考也变迟钝了…",
            "nextDialogs": [
              "700501506"
            ]
          },
          "700501506": {
            "id": "700501506",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "这算是取材成功了吗？",
            "nextDialogs": [
              "700501507"
            ]
          },
          "700501507": {
            "id": "700501507",
            "speakerId": 1000,
            "speakerName": "吉雅罗",
            "text": "当然，取材非常成功，我终于弄清被捆起来吊在野外一晚上，究竟是一种怎样的感觉了…",
            "nextDialogs": [
              "700501508"
            ]
          },
          "700501508": {
            "id": "700501508",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "你那本小说的主角，真的很有韧性呢…",
            "nextDialogs": [
              "700501509"
            ]
          },
          "700501509": {
            "id": "700501509",
            "speakerId": 1000,
            "speakerName": "吉雅罗",
            "text": "没错。我也想好了主角驱走那只「玄文兽」的方法，用这种手法结尾，一定…一定…",
            "nextDialogs": [
              "700501510"
            ]
          },
          "700501510": {
            "id": "700501510",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "喔！有什么厉害的手法吗？",
            "nextDialogs": [
              "700501511"
            ]
          },
          "700501511": {
            "id": "700501511",
            "speakerId": 1000,
            "speakerName": "吉雅罗",
            "text": "一定…不错…",
            "nextDialogs": [
              "700501512"
            ]
          },
          "700501512": {
            "id": "700501512",
            "speakerId": 1003,
            "speakerName": "Black Screen",
            "text": "吉雅罗再次晕倒在了地上…",
            "nextDialogs": [
              "700501513"
            ]
          },
          "700501513": {
            "id": "700501513",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "呜哇！吉雅罗小姐，你…",
            "nextDialogs": [
              "700501514"
            ]
          },
          "700501514": {
            "id": "700501514",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "你把手法说出来再晕倒啊！",
            "nextDialogs": [
              "700501515"
            ]
          },
          "700501515": {
            "id": "700501515",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "总、总而言之，先送她去找医生…先送去庄里吧！",
            "nextDialogs": [
              "700501516"
            ]
          },
          "700501516": {
            "id": "700501516",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "洪分小姐果然说得没错，吉雅罗小姐就不该离开翘英庄啦——"
          }
        }
      }
    },
    {
      "subId": "7005097",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "700509701"
        ],
        "dialogs": {
          "700509701": {
            "id": "700509701",
            "speakerId": 1000,
            "speakerName": "吉雅罗",
            "text": "…只有这些「灯笼」的话，诡计还是不太成立，这可怎么办…"
          }
        }
      }
    },
    {
      "subId": "7005098",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "700509801"
        ],
        "dialogs": {
          "700509801": {
            "id": "700509801",
            "speakerId": 1000,
            "speakerName": "吉雅罗",
            "text": "让我想想，用什么姿势举起手才好…嗯…"
          }
        }
      }
    }
  ]
}
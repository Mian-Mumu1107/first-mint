  "subQuests": [
    {
      "subId": "7005001",
      "subQuestName": "与吉雅罗对话$HIDDEN",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "700500101"
        ],
        "dialogs": {
          "700500101": {
            "id": "700500101",
            "speakerId": 1000,
            "speakerName": "吉雅罗",
            "text": "…这只小猫…没错，一定是这样！太棒了，我就知道！",
            "nextDialogs": [
              "700500103",
              "700500105"
            ]
          },
          "700500103": {
            "id": "700500103",
            "speakerId": 1000,
            "speakerName": "吉雅罗",
            "text": "#欸？{NICKNAME}，派蒙，这么巧，你们也来翘英庄玩吗？",
            "nextDialogs": [
              "700500106"
            ]
          },
          "700500106": {
            "id": "700500106",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "你…写完小说了吗？不会还在想那些奇奇怪怪的事吧…"
          },
          "700500105": {
            "id": "700500105",
            "speakerId": 1000,
            "speakerName": "吉雅罗",
            "text": "#我认为它就是…欸？欸？{NICKNAME}，派蒙，这么巧，你们也来翘英庄玩吗？"
          }
        }
      }
    },

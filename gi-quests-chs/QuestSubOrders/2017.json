    {
      "subId": "201709",
      "subQuestName": "与神里绫华对话",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "20170901"
        ],
        "dialogs": {
          "20170901": {
            "id": "20170901",
            "speakerId": 1005,
            "speakerName": "神里绫华",
            "text": "#怎么样{NICKNAME}，计划还顺利吗？",
            "nextDialogs": [
              "20170904"
            ]
          },
          "20170904": {
            "id": "20170904",
            "speakerId": 1005,
            "speakerName": "神里绫华",
            "text": "辛苦了，接下来就等早柚的消息吧。",
            "nextDialogs": [
              "20170905"
            ]
          },
          "20170905": {
            "id": "20170905",
            "speakerId": 1007,
            "speakerName": "黑屏",
            "text": "一段时间后…",
            "nextDialogs": [
              "20170906"
            ]
          },
          "20170906": {
            "id": "20170906",
            "speakerId": 1001,
            "speakerName": "早柚",
            "text": "呼…呼…",
            "nextDialogs": [
              "20170907"
            ]
          },
          "20170907": {
            "id": "20170907",
            "speakerId": 1001,
            "speakerName": "早柚",
            "text": "虽然运动有助于长高，但好像有些运动过头了…",
            "nextDialogs": [
              "20170908"
            ]
          },
          "20170908": {
            "id": "20170908",
            "speakerId": 1001,
            "speakerName": "早柚",
            "text": "晕乎乎的…大家…都在旋转…",
            "nextDialogs": [
              "20170909"
            ]
          },
          "20170909": {
            "id": "20170909",
            "speakerId": 1001,
            "speakerName": "早柚",
            "text": "不行，睡觉前，好像还有重要的事情…对了，我拿到了哦。",
            "nextDialogs": [
              "20170910"
            ]
          },
          "20170910": {
            "id": "20170910",
            "speakerId": 1001,
            "speakerName": "早柚",
            "text": "我也不知道你们说的「公文」到底长什么样子，就把所有可疑的东西都偷回来了。",
            "nextDialogs": [
              "20170911"
            ]
          },
          "20170911": {
            "id": "20170911",
            "speakerId": 1001,
            "speakerName": "早柚",
            "text": "给你们…我要去睡觉了…",
            "nextDialogs": [
              "20170912"
            ]
          },
          "20170912": {
            "id": "20170912",
            "speakerId": 1003,
            "speakerName": "托马",
            "text": "小姐，这些是…",
            "nextDialogs": [
              "20170913"
            ]
          },
          "20170913": {
            "id": "20170913",
            "speakerId": 1005,
            "speakerName": "神里绫华",
            "text": "这一卷密封的，应该是天领奉行要呈给将军的「上奏公文」。",
            "nextDialogs": [
              "20170914"
            ]
          },
          "20170914": {
            "id": "20170914",
            "speakerId": 1005,
            "speakerName": "神里绫华",
            "text": "除此之外，这是…他们与愚人众来往的信件。",
            "nextDialogs": [
              "20170915"
            ]
          },
          "20170915": {
            "id": "20170915",
            "speakerId": 1005,
            "speakerName": "神里绫华",
            "text": "看来那位八重宫司的判断是正确的。如今稻妻的纷争，确实是他们推波助澜的结果。",
            "nextDialogs": [
              "20170916"
            ]
          },
          "20170916": {
            "id": "20170916",
            "speakerId": 1005,
            "speakerName": "神里绫华",
            "text": "#{NICKNAME}，这些当证据应该足够了。接下来还请你将它们带给<color=#00E1FFFF>八重宫司</color>，相信她会有接下来的计划。",
            "nextDialogs": [
              "20170917"
            ]
          },
          "20170917": {
            "id": "20170917",
            "speakerId": 1005,
            "speakerName": "神里绫华",
            "text": "我也会召集人手，争取挖出更多潜伏在稻妻的愚人众。",
            "nextDialogs": [
              "20170918"
            ]
          },
          "20170918": {
            "id": "20170918",
            "speakerId": 1003,
            "speakerName": "托马",
            "text": "不过，还是要小心将军大人，一想到她之前出刀的样子，我就浑身鸡皮疙瘩。",
            "nextDialogs": [
              "20170919"
            ]
          },
          "20170919": {
            "id": "20170919",
            "speakerId": 1005,
            "speakerName": "神里绫华",
            "text": "也只能相信八重宫司了。她与将军关系密切，或许会有办法…",
            "nextDialogs": [
              "20170920"
            ]
          },
          "20170920": {
            "id": "20170920",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "我记得，快到与八重神子约定的日期了吧。",
            "nextDialogs": [
              "20170921"
            ]
          },
          "20170921": {
            "id": "20170921",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "我们还是快点收拾一下，准备赶往<color=#00E1FFFF>鸣神大社</color>吧。"
          }
        }
      }
    },

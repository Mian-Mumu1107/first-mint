    {
      "subId": "201704",
      "subQuestName": "与托马对话",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "20170403"
        ],
        "dialogs": {
          "20170403": {
            "id": "20170403",
            "speakerId": 1003,
            "speakerName": "托马",
            "text": "#{NICKNAME}，你们怎么来了？",
            "nextDialogs": [
              "20170404"
            ]
          },
          "20170404": {
            "id": "20170404",
            "speakerId": 1003,
            "speakerName": "托马",
            "text": "见到反抗军了吗？现在战场情况如何？我能从这出去了吗？",
            "nextDialogs": [
              "20170405"
            ]
          },
          "20170405": {
            "id": "20170405",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "大概还不行…我们来的时候还看到附近有人在巡逻呢。",
            "nextDialogs": [
              "20170406"
            ]
          },
          "20170406": {
            "id": "20170406",
            "speakerId": 1003,
            "speakerName": "托马",
            "text": "看来还没结束啊…这么说来，你们出现在这里，应该是有事要找我们商量吧。",
            "nextDialogs": [
              "20170407"
            ]
          },
          "20170407": {
            "id": "20170407",
            "speakerId": 1003,
            "speakerName": "托马",
            "text": "我去找人叫小姐过来，稍等一下。",
            "nextDialogs": [
              "20170408"
            ]
          },
          "20170408": {
            "id": "20170408",
            "speakerId": 1004,
            "speakerName": "黑屏文字",
            "text": "将现状告诉了绫华与托马…",
            "nextDialogs": [
              "20170409"
            ]
          },
          "20170409": {
            "id": "20170409",
            "speakerId": 1005,
            "speakerName": "神里绫华",
            "text": "原来如此，你们也经历了许多事情呢。",
            "nextDialogs": [
              "20170410"
            ]
          },
          "20170410": {
            "id": "20170410",
            "speakerId": 1005,
            "speakerName": "神里绫华",
            "text": "情况我已经了解了，总之是要找到天领奉行叛变的证据，让我想想…",
            "nextDialogs": [
              "20170411"
            ]
          },
          "20170411": {
            "id": "20170411",
            "speakerId": 1005,
            "speakerName": "神里绫华",
            "text": "这么说来，确实有一点让我很在意。幕府军与反抗军交战已久，但将军却从未过问此事。",
            "nextDialogs": [
              "20170412"
            ]
          },
          "20170412": {
            "id": "20170412",
            "speakerId": 1005,
            "speakerName": "神里绫华",
            "text": "我曾以为将军对此事并不在意，但现在来看，或许是天领奉行给将军的<color=#00E1FFFF>「上奏公文」</color>，从一开始就有问题。",
            "nextDialogs": [
              "20170413"
            ]
          },
          "20170413": {
            "id": "20170413",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "绫华的意思是…",
            "nextDialogs": [
              "20170414"
            ]
          },
          "20170414": {
            "id": "20170414",
            "speakerId": 1005,
            "speakerName": "神里绫华",
            "text": "天领奉行执掌国内军事事务，如果他们有瞒报的想法，我们也无从得知。",
            "nextDialogs": [
              "20170415"
            ]
          },
          "20170415": {
            "id": "20170415",
            "speakerId": 1005,
            "speakerName": "神里绫华",
            "text": "其结果，是将军错估眼狩令的危害，继续一意孤行。如果能拿到天领奉行的上奏公文，一看便知。",
            "nextDialogs": [
              "20170416"
            ]
          },
          "20170416": {
            "id": "20170416",
            "speakerId": 1003,
            "speakerName": "托马",
            "text": "可我记得，有权力碰触上奏公文的，只有九条孝行一个人。",
            "nextDialogs": [
              "20170417"
            ]
          },
          "20170417": {
            "id": "20170417",
            "speakerId": 1003,
            "speakerName": "托马",
            "text": "而且那里有重兵把守，就算有早柚帮忙，想悄悄拿走公文也是一件难事。",
            "nextDialogs": [
              "20170418"
            ]
          },
          "20170418": {
            "id": "20170418",
            "speakerId": 1005,
            "speakerName": "神里绫华",
            "text": "如果有什么东西，能够暂时引开那些守卫就好了。",
            "nextDialogs": [
              "20170419"
            ]
          },
          "20170419": {
            "id": "20170419",
            "speakerId": 1005,
            "speakerName": "神里绫华",
            "text": "嗯…",
            "nextDialogs": [
              "20170422"
            ]
          },
          "20170422": {
            "id": "20170422",
            "speakerId": 1003,
            "speakerName": "托马",
            "text": "宵宫的烟花！",
            "nextDialogs": [
              "20170423"
            ]
          },
          "20170423": {
            "id": "20170423",
            "speakerId": 1005,
            "speakerName": "神里绫华",
            "text": "果然是托马会提出来的建议呢…",
            "nextDialogs": [
              "20170424"
            ]
          },
          "20170424": {
            "id": "20170424",
            "speakerId": 1005,
            "speakerName": "神里绫华",
            "text": "倒也不无道理。天领奉行旁边就是千手百眼神像，如果能在神像周围点燃烟花，天领奉行不会不管。",
            "nextDialogs": [
              "20170425"
            ]
          },
          "20170425": {
            "id": "20170425",
            "speakerId": 1005,
            "speakerName": "神里绫华",
            "text": "到时早柚就可以顺利潜入天领奉行，拿到公文和其他证据…",
            "nextDialogs": [
              "20170426"
            ]
          },
          "20170426": {
            "id": "20170426",
            "speakerId": 1003,
            "speakerName": "托马",
            "text": "好！我感觉我离自由的日子越来越近了。",
            "nextDialogs": [
              "20170427"
            ]
          },
          "20170427": {
            "id": "20170427",
            "speakerId": 1003,
            "speakerName": "托马",
            "text": "呼…像这样坐在一起聊天，总感觉已经是好久之前的事情了。",
            "nextDialogs": [
              "20170428"
            ]
          },
          "20170428": {
            "id": "20170428",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "好像也没有很久…",
            "nextDialogs": [
              "20170429"
            ]
          },
          "20170429": {
            "id": "20170429",
            "speakerId": 1003,
            "speakerName": "托马",
            "text": "对我来说已经很久了，我每天都在这里盼着你们啊！",
            "nextDialogs": [
              "20170430"
            ]
          },
          "20170430": {
            "id": "20170430",
            "speakerId": 1003,
            "speakerName": "托马",
            "text": "以前这里确实是我最喜欢的秘密场所，但这次进来之后，我已经不知道多久没有迈出茶室一步了。",
            "nextDialogs": [
              "20170431"
            ]
          },
          "20170431": {
            "id": "20170431",
            "speakerId": 1003,
            "speakerName": "托马",
            "text": "可恶，好想去泡温泉啊！",
            "nextDialogs": [
              "20170432"
            ]
          },
          "20170432": {
            "id": "20170432",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "托马，好可怜…",
            "nextDialogs": [
              "20170433"
            ]
          },
          "20170433": {
            "id": "20170433",
            "speakerId": 1005,
            "speakerName": "神里绫华",
            "text": "我们还是先解决眼下的问题吧。废除眼狩令之后，托马就自由了。",
            "nextDialogs": [
              "20170434"
            ]
          },
          "20170434": {
            "id": "20170434",
            "speakerId": 1005,
            "speakerName": "神里绫华",
            "text": "虽然是再度重逢，但没有多少叙旧的时间呢。等一切结束，我们再好好庆祝一番。",
            "nextDialogs": [
              "20170435"
            ]
          },
          "20170435": {
            "id": "20170435",
            "speakerId": 1003,
            "speakerName": "托马",
            "text": "到时候我们再一起玩火锅游戏好了！",
            "nextDialogs": [
              "20170436"
            ]
          },
          "20170436": {
            "id": "20170436",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "你还惦记着那个啊！",
            "nextDialogs": [
              "20170437"
            ]
          },
          "20170437": {
            "id": "20170437",
            "speakerId": 1005,
            "speakerName": "神里绫华",
            "text": "天领奉行附近的守卫很多，你们靠近的时候务必小心。之后我们再在这里碰面吧。",
            "nextDialogs": [
              "20170438"
            ]
          },
          "20170438": {
            "id": "20170438",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "#那{NICKNAME}，我们就先去<color=#00E1FFFF>花见坂</color>找<color=#00E1FFFF>宵宫</color>吧。"
          }
        }
      }
    },
    {
      "subId": "201710",
      "subQuestName": "前往寻求宵宫的帮助",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "20171000"
        ],
        "dialogs": {
          "20171000": {
            "id": "20171000",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "宵宫，我们想要一个特大号烟花！超级超级大的那种！",
            "nextDialogs": [
              "20171001"
            ]
          },
          "20171001": {
            "id": "20171001",
            "speakerId": 1006,
            "speakerName": "宵宫",
            "text": "「特大号烟花」？",
            "nextDialogs": [
              "20171002"
            ]
          },
          "20171002": {
            "id": "20171002",
            "speakerId": 1006,
            "speakerName": "宵宫",
            "text": "嘿嘿，这你们可就问对人了。",
            "nextDialogs": [
              "20171003"
            ]
          },
          "20171003": {
            "id": "20171003",
            "speakerId": 1006,
            "speakerName": "宵宫",
            "text": "其实前两天啊，我正好做出来了一个特别厉害的好东西。",
            "nextDialogs": [
              "20171004"
            ]
          },
          "20171004": {
            "id": "20171004",
            "speakerId": 1006,
            "speakerName": "宵宫",
            "text": "不过因为威力太大，一直找不到合适的地方做实验…正好送给你们，让你们帮我看看效果。",
            "nextDialogs": [
              "20171005"
            ]
          },
          "20171005": {
            "id": "20171005",
            "speakerId": 1006,
            "speakerName": "宵宫",
            "text": "记住，点着了之后一定要快点跑，别把衣服烧了。还有最好把耳朵也捂住…",
            "nextDialogs": [
              "20171006"
            ]
          },
          "20171006": {
            "id": "20171006",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "我，我怎么觉得有点可怕…",
            "nextDialogs": [
              "20171007"
            ]
          },
          "20171007": {
            "id": "20171007",
            "speakerId": 1006,
            "speakerName": "宵宫",
            "text": "哈哈哈，没关系的，只是烟花啦，烟花而已。不会有什么问题的！",
            "nextDialogs": [
              "20171008"
            ]
          },
          "20171008": {
            "id": "20171008",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "那我们就去试试好了…谢谢你啦，宵宫。"
          }
        }
      }
    },

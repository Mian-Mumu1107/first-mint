    {
      "subId": "201702",
      "subQuestName": "找到八重神子所说的帮手",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "20170201"
        ],
        "dialogs": {
          "20170201": {
            "id": "20170201",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "狸、狸猫玩偶变成人类了！",
            "nextDialogs": [
              "20170202"
            ]
          },
          "20170202": {
            "id": "20170202",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "这是什么，我还是第一次见到！",
            "nextDialogs": [
              "20170203"
            ]
          },
          "20170203": {
            "id": "20170203",
            "speakerId": 1001,
            "speakerName": "早柚",
            "text": "不是狸猫…是貉…呼噜…",
            "nextDialogs": [
              "20170204"
            ]
          },
          "20170204": {
            "id": "20170204",
            "speakerId": 1001,
            "speakerName": "早柚",
            "text": "好困…睡不饱的话…会长不高的…",
            "nextDialogs": [
              "20170205"
            ]
          },
          "20170205": {
            "id": "20170205",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "难道说这位就是八重小姐所说的「专业人士」吗？",
            "nextDialogs": [
              "20170206"
            ]
          },
          "20170206": {
            "id": "20170206",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "看上去完全不像呢。",
            "nextDialogs": [
              "20170207"
            ]
          },
          "20170207": {
            "id": "20170207",
            "speakerId": 1002,
            "speakerName": "八重神子",
            "text": "呵呵…这位可是「终末番」的成员，是货真价实的「忍者」哦。",
            "nextDialogs": [
              "20170208"
            ]
          },
          "20170208": {
            "id": "20170208",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "忍者！那刚刚的，难道就是传说中的替身术？",
            "nextDialogs": [
              "20170209"
            ]
          },
          "20170209": {
            "id": "20170209",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "不过，「终末番」又是什么呢？",
            "nextDialogs": [
              "20170210"
            ]
          },
          "20170210": {
            "id": "20170210",
            "speakerId": 1002,
            "speakerName": "八重神子",
            "text": "终末番隶属于社奉行，是神里绫人的秘密部队。",
            "nextDialogs": [
              "20170211"
            ]
          },
          "20170211": {
            "id": "20170211",
            "speakerId": 1002,
            "speakerName": "八重神子",
            "text": "目前神里绫人和社奉行秉持中立态度，我也无法调动终末番。",
            "nextDialogs": [
              "20170212"
            ]
          },
          "20170212": {
            "id": "20170212",
            "speakerId": 1002,
            "speakerName": "八重神子",
            "text": "不过，抓一个常年偷懒的终末番成员过来帮忙，还是可以做到的。",
            "nextDialogs": [
              "20170213"
            ]
          },
          "20170213": {
            "id": "20170213",
            "speakerId": 1001,
            "speakerName": "早柚",
            "text": "咕…",
            "nextDialogs": [
              "20170214"
            ]
          },
          "20170214": {
            "id": "20170214",
            "speakerId": 1002,
            "speakerName": "八重神子",
            "text": "就是这样，就拜托你们进城，去寻找天领奉行叛变的证据了。",
            "nextDialogs": [
              "20170215"
            ]
          },
          "20170215": {
            "id": "20170215",
            "speakerId": 1002,
            "speakerName": "八重神子",
            "text": "毕竟在那样的场合，我不适合露面嘛。",
            "nextDialogs": [
              "20170216"
            ]
          },
          "20170216": {
            "id": "20170216",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "就算你这么说…",
            "nextDialogs": [
              "20170219"
            ]
          },
          "20170219": {
            "id": "20170219",
            "speakerId": 1002,
            "speakerName": "八重神子",
            "text": "欸？我还以为你已经想到了呢。好吧，那我就再给你一点点提示。",
            "nextDialogs": [
              "20170220"
            ]
          },
          "20170220": {
            "id": "20170220",
            "speakerId": 1002,
            "speakerName": "八重神子",
            "text": "对外人来说，想要摸清楚天领奉行的底细确实很难。",
            "nextDialogs": [
              "20170221"
            ]
          },
          "20170221": {
            "id": "20170221",
            "speakerId": 1002,
            "speakerName": "八重神子",
            "text": "但三奉行共同辅佐将军，关系来往密切，想必其他奉行更容易察觉其中的蹊跷…",
            "nextDialogs": [
              "20170222"
            ]
          },
          "20170222": {
            "id": "20170222",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "社奉行！",
            "nextDialogs": [
              "20170223"
            ]
          },
          "20170223": {
            "id": "20170223",
            "speakerId": 1002,
            "speakerName": "八重神子",
            "text": "呵呵…看来你已经想到了。",
            "nextDialogs": [
              "20170224"
            ]
          },
          "20170224": {
            "id": "20170224",
            "speakerId": 1002,
            "speakerName": "八重神子",
            "text": "幕府军对你的搜捕，应该还没有结束。不过有这位终末番的忍者相助，相信你可以顺利与朋友再会。",
            "nextDialogs": [
              "20170225"
            ]
          },
          "20170225": {
            "id": "20170225",
            "speakerId": 1002,
            "speakerName": "八重神子",
            "text": "别忘了在约定的时间之前，把证据带回来哦。"
          }
        }
      }
    },

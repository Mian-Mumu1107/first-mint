      }
    },
    {
      "subId": "7600504",
      "subQuestName": "调查雷图礁",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "760050401"
        ],
        "dialogs": {
          "760050401": {
            "id": "760050401",
            "speakerId": 1003,
            "speakerName": "？？？",
            "text": "咦？克莱卡三号，这么快就回来了吗？",
            "nextDialogs": [
              "760050402"
            ]
          },
          "760050402": {
            "id": "760050402",
            "speakerId": 1003,
            "speakerName": "？？？",
            "text": "奇怪，不应该呀？明明没有收集到碎片，为什么会提前…",
            "nextDialogs": [
              "760050403"
            ]
          },
          "760050403": {
            "id": "760050403",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "呃，你好？",
            "nextDialogs": [
              "760050404"
            ]
          },
          "760050404": {
            "id": "760050404",
            "speakerId": 1003,
            "speakerName": "？？？",
            "text": "啊！对不起对不起对不起请听我解释我会穿成这样是有很深刻的理由绝对不是什么亵渎的异端行为…",
            "nextDialogs": [
              "760050405"
            ]
          },
          "760050405": {
            "id": "760050405",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "哇，我还什么都没问呢！",
            "nextDialogs": [
              "760050406"
            ]
          },
          "760050406": {
            "id": "760050406",
            "speakerId": 1003,
            "speakerName": "？？？",
            "text": "…嗯？什、什么嘛，原来是外面来的冒险家，呼——我还以为是…欸不对！你们怎么穿成这样！而且若无其事的样子！",
            "nextDialogs": [
              "760050409"
            ]
          },
          "760050409": {
            "id": "760050409",
            "speakerId": 1003,
            "speakerName": "？？？",
            "text": "…难、难道是！月之{RUBY#[D]库塔尔}少女钟爱之人，天赋异禀，即使在<color=#00E1FFFF>月矩力紊乱</color>的环境里也镇定自若…",
            "nextDialogs": [
              "760050410"
            ]
          },
          "760050410": {
            "id": "760050410",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "唔…感觉解释起来也很麻烦，你就当是这样好了。倒是你，你为什么穿成这样，又在这里干什么呀？还有月矩力紊乱到底是…",
            "nextDialogs": [
              "760050411"
            ]
          },
          "760050411": {
            "id": "760050411",
            "speakerId": 1003,
            "speakerName": "？？？",
            "text": "哎呀，瞧瞧我，居然失了礼数。咳，「我乃霜月之侍仆，潮汐之女，领受月秩的大执祭，月下世界的凡名为维娜琴卡。」",
            "nextDialogs": [
              "760050412"
            ]
          },
          "760050412": {
            "id": "760050412",
            "speakerId": 1002,
            "speakerName": "维娜",
            "text": "两位叫我维娜就好啦！我呢，正在执行一项秘密的任务，目的是让紊乱的月矩力恢复正常，所以还请两位…不知怎么称呼？"
          }
        }
      }
    },
    {
      "subId": "7600526",
      "subQuestName": "深入洞穴，寻找碎片",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [],
        "dialogs": {}
      }
    },
    {
      "subId": "7600505",
      "subQuestName": "将碎片投掷到石头上",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "760050501"
        ],
        "dialogs": {
          "760050501": {
            "id": "760050501",
            "speakerId": 1002,
            "speakerName": "维娜",
            "text": "啊，终于找到了！怎么样怎么样，我就说还是要相信科学的力量嘛…",
            "nextDialogs": [
              "760050502"
            ]
          },
          "760050502": {
            "id": "760050502",
            "speakerId": 1003,
            "speakerName": "？？？",
            "text": "…你终于来了，「乐园」的英雄…",
            "nextDialogs": [
              "760050503"
            ]
          },
          "760050503": {
            "id": "760050503",
            "speakerId": 1002,
            "speakerName": "维娜",
            "text": "呜哇！怎么还会有其他人在这里啊！",
            "nextDialogs": [
              "760050504"
            ]
          },
          "760050504": {
            "id": "760050504",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "你是什么人？",
            "nextDialogs": [
              "760050505"
            ]
          },
          "760050505": {
            "id": "760050505",
            "speakerId": 1003,
            "speakerName": "？？？",
            "text": "我是清晨的第一缕微光，也是苦泉的最后一滴蜜酒，我是所有人的母亲，也是所有人的女儿…",
            "nextDialogs": [
              "760050507",
              "760050509"
            ]
          },
          "760050507": {
            "id": "760050507",
            "speakerId": 1002,
            "speakerName": "维娜",
            "text": "欸？让我想想，好像确实是有这一段，不过那可是只有咏月使才能使用的…",
            "nextDialogs": [
              "760050510"
            ]
          },
          "760050510": {
            "id": "760050510",
            "speakerId": 1002,
            "speakerName": "维娜",
            "text": "哼，真正的祭司可不会搞错祷文的序阶。果然又是个伪装成祭司的骗子吧，这种事我也不是第一次见了！",
            "nextDialogs": [
              "760050511"
            ]
          },
          "760050511": {
            "id": "760050511",
            "speakerId": 1002,
            "speakerName": "维娜",
            "text": "之前有个叫希丁芭的女人，也是像这样伪装成祭司，到处招摇撞骗…",
            "nextDialogs": [
              "760050512"
            ]
          },
          "760050512": {
            "id": "760050512",
            "speakerId": 1002,
            "speakerName": "维娜",
            "text": "不过真是不巧，现在正好有个真货在这里呢，不然可就让你糊弄过去了！",
            "nextDialogs": [
              "760050513"
            ]
          },
          "760050513": {
            "id": "760050513",
            "speakerId": 1003,
            "speakerName": "？？？",
            "text": "…是真是假又有什么区别呢，重要的是她正坐在那个位置上，扮演那个角色…",
            "nextDialogs": [
              "760050514"
            ]
          },
          "760050514": {
            "id": "760050514",
            "speakerId": 1003,
            "speakerName": "？？？",
            "text": "月下世界的人们，每个人不都戴着面具吗，只不过有的显形，有的无形罢了…",
            "nextDialogs": [
              "760050515"
            ]
          },
          "760050515": {
            "id": "760050515",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "唔，听着好深奥，总感觉这个人说话比维娜更像祭司呢…",
            "nextDialogs": [
              "760050516"
            ]
          },
          "760050516": {
            "id": "760050516",
            "speakerId": 1002,
            "speakerName": "维娜",
            "text": "喂！你这话是什么意思啦！"
          },
          "760050509": {
            "id": "760050509",
            "speakerId": 1002,
            "speakerName": "维娜",
            "text": "听起来像是祷文？不过这可是只有咏月使才能使用的…"
          }
        }
      }
    },
    {
      "subId": "7600506",
      "subQuestName": "深入洞穴，寻找碎片",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "760050601"
        ],
        "dialogs": {
          "760050601": {
            "id": "760050601",
            "speakerId": 1003,
            "speakerName": "？？？",
            "text": "…我们又见面了呢，「乐园」的英雄。",
            "nextDialogs": [
              "760050602"
            ]
          },
          "760050602": {
            "id": "760050602",
            "speakerId": 1002,
            "speakerName": "维娜",
            "text": "哼，是「我们」来了！冒牌货，快把东西交出来！",
            "nextDialogs": [
              "760050605"
            ]
          },
          "760050605": {
            "id": "760050605",
            "speakerId": 1003,
            "speakerName": "？？？",
            "text": "…你要找的东西不是近在眼前吗？",
            "nextDialogs": [
              "760050606"
            ]
          },
          "760050606": {
            "id": "760050606",
            "speakerId": 1002,
            "speakerName": "维娜",
            "text": "早料到了！既然不愿意交出来，那就先好好教训…欸？等等，你说什么？",
            "nextDialogs": [
              "760050607"
            ]
          },
          "760050607": {
            "id": "760050607",
            "speakerId": 1002,
            "speakerName": "维娜",
            "text": "就…就这么直接给我们了？那你刚才让我们上来是为了什么？",
            "nextDialogs": [
              "760050608"
            ]
          },
          "760050608": {
            "id": "760050608",
            "speakerId": 1003,
            "speakerName": "？？？",
            "text": "当然是因为命运，一切都是为了迎接「神明」的降生…为了这一刻我准备了太久，也忍受了太多…",
            "nextDialogs": [
              "760050609"
            ]
          },
          "760050609": {
            "id": "760050609",
            "speakerId": 1003,
            "speakerName": "？？？",
            "text": "不过无妨，很快就要结束了，而新生的「神明」会为我们带来真正的喜悦…",
            "nextDialogs": [
              "760050610"
            ]
          },
          "760050610": {
            "id": "760050610",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "你到底在说什么？",
            "nextDialogs": [
              "760050611"
            ]
          },
          "760050611": {
            "id": "760050611",
            "speakerId": 1003,
            "speakerName": "？？？",
            "text": "…维娅，我看到了哦，在「神明」存在的世界里，没有她的位置…",
            "nextDialogs": [
              "760050612"
            ]
          },
          "760050612": {
            "id": "760050612",
            "speakerId": 1002,
            "speakerName": "维娜",
            "text": "首先我的名字是维娜，不是维娅！叫错别人的名字也太失礼了吧…欸不对，好像不是在说我？",
            "nextDialogs": [
              "760050613"
            ]
          },
          "760050613": {
            "id": "760050613",
            "speakerId": 1003,
            "speakerName": "？？？",
            "text": "确实如此，为了你所期望的结局，请动手吧…",
            "nextDialogs": [
              "760050614"
            ]
          },
          "760050614": {
            "id": "760050614",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "我们倒是也没有想对你做什么啦！每次说话都迷迷糊糊的，我都有点火大了！",
            "nextDialogs": [
              "760050615"
            ]
          },
          "760050615": {
            "id": "760050615",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "这附近的月矩力紊乱究竟是怎么回事，为什么那枚碎片会在你手里…你根本什么都没说吧！",
            "nextDialogs": [
              "760050616"
            ]
          },
          "760050616": {
            "id": "760050616",
            "speakerId": 1003,
            "speakerName": "？？？",
            "text": "…不要这么着急，一切结束之后，我们还会再见的。",
            "nextDialogs": [
              "760050617"
            ]
          },
          "760050617": {
            "id": "760050617",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "欸？",
            "nextDialogs": [
              "760050618"
            ]
          },
          "760050618": {
            "id": "760050618",
            "speakerId": 1003,
            "speakerName": "？？？",
            "text": "你不是想知道答案吗，等到那时，前方的道路便会敞开…",
            "nextDialogs": [
              "760050619"
            ]
          },
          "760050619": {
            "id": "760050619",
            "speakerId": 1003,
            "speakerName": "？？？",
            "text": "那么，我就在初谕之庭那里等着你了。",
            "nextDialogs": [
              "760050620"
            ]
          },
          "760050620": {
            "id": "760050620",
            "speakerId": 1002,
            "speakerName": "维娜",
            "text": "哎？但是初谕之庭不是早就被…",
            "nextDialogs": [
              "760050621"
            ]
          },
          "760050621": {
            "id": "760050621",
            "speakerId": 1001,
            "speakerName": "Black Screen",
            "text": "「…夜莺啊，夜莺啊，飞过苍白的山岭与冻原…」\\n「…你可曾听到晚祷的铃歌？我心爱的夜莺啊…」",
            "nextDialogs": [
              "760050622"
            ]
          },
          "760050622": {
            "id": "760050622",
            "speakerId": 1002,
            "speakerName": "维娜",
            "text": "等、等一下，别跑！",
            "nextDialogs": [
              "760050623"
            ]
          },
          "760050623": {
            "id": "760050623",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "#哇，{NICKNAME}小心，好像有什么东西被唤醒了！"
          }
        }
      }
    },
    {
      "subId": "7600508",
      "subQuestName": "深入洞穴，寻找碎片",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "760050801"
        ],
        "dialogs": {
          "760050801": {
            "id": "760050801",
            "speakerId": 1002,
            "speakerName": "维娜",
            "text": "啊啊啊，气死我了气死我了！怎么会有这么坏的坏家伙！明明是个冒牌货，还敢操控神圣的霜夜灵嗣攻击我们！",
            "nextDialogs": [
              "760050806",
              "760050804"
            ]
          },
          "760050806": {
            "id": "760050806",
            "speakerId": 1002,
            "speakerName": "维娜",
            "text": "总之，先把岛上剩下的月灵引到这里来，从盈月之镜里取出最后一枚碎片，解决紊乱的问题吧！"
          },
          "760050804": {
            "id": "760050804",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "是、是呀，我感觉那个霜夜灵嗣好像是被刚才的落雷唤醒的…",
            "nextDialogs": [
              "760050805"
            ]
          },
          "760050805": {
            "id": "760050805",
            "speakerId": 1002,
            "speakerName": "维娜",
            "text": "哎呀，那就说明落雷也是她造成的嘛！既然她也会用月矩力，对我们的祷文也这么熟悉，想要做这种事情也很容易吧？"
          }
        }
      }
    },
    {
      "subId": "7600509",
      "subQuestName": "深入洞穴，寻找碎片",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "760050901"
        ],
        "dialogs": {
          "760050901": {
            "id": "760050901",
            "speakerId": 1002,
            "speakerName": "维娜",
            "text": "总之，先把岛上剩下的月灵引到这里来，从盈月之镜里取出最后一枚碎片，解决紊乱的问题吧！"
          }
        }
      }
    },
    {
      "subId": "7600527",
      "subQuestName": "(test)隐藏$HIDDEN",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "760050701"
        ],
        "dialogs": {
          "760050701": {
            "id": "760050701",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "怎、怎么办，这边好像出不去了…不过那里好像有光的样子，说不定可以绕出去？"
          }
        }
      }
    },
    {
      "subId": "7600503",

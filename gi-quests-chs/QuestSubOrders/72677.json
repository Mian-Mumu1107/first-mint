    {
      "subId": "7267702",
      "subQuestName": "将1个「烈焰花花蕊」交给吉法师",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "726770201"
        ],
        "dialogs": {
          "726770201": {
            "id": "726770201",
            "speakerId": 3160,
            "speakerName": "「吉法师」",
            "text": "#{NICKNAME}，想要着火的花。谢谢。"
          }
        }
      }
    },
    {
      "subId": "7267708",
      "subQuestName": "与吉法师对话",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "726770801"
        ],
        "dialogs": {
          "726770801": {
            "id": "726770801",
            "speakerId": 3160,
            "speakerName": "「吉法师」",
            "text": "好温暖。",
            "nextDialogs": [
              "726770802"
            ]
          },
          "726770802": {
            "id": "726770802",
            "speakerId": 3160,
            "speakerName": "「吉法师」",
            "text": "如果去雪山的时候，有烈焰花就好了哩。",
            "nextDialogs": [
              "726770803"
            ]
          },
          "726770803": {
            "id": "726770803",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "这么说来，当时确实应该准备一些保暖的东西…",
            "nextDialogs": [
              "726770804"
            ]
          },
          "726770804": {
            "id": "726770804",
            "speakerId": 3160,
            "speakerName": "「吉法师」",
            "text": "派蒙，如果有很大的这种花，能不能把雪山变得没有雪？",
            "nextDialogs": [
              "726770805"
            ]
          },
          "726770805": {
            "id": "726770805",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "恐、恐怕不太能吧…",
            "nextDialogs": [
              "726770806"
            ]
          },
          "726770806": {
            "id": "726770806",
            "speakerId": 3160,
            "speakerName": "「吉法师」",
            "text": "呶。",
            "nextDialogs": [
              "726770807"
            ]
          },
          "726770807": {
            "id": "726770807",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "可以带吉法师看「很大的烈焰花」。",
            "nextDialogs": [
              "726770808"
            ]
          },
          "726770808": {
            "id": "726770808",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "欸，说的难道是…",
            "nextDialogs": [
              "726770811"
            ]
          },
          "726770811": {
            "id": "726770811",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "嗯！就当吉法师今天的修行吧！"
          }
        }
      }
    },
    {
      "subId": "7267703",
      "subQuestName": "前往爆炎树所在的洞窟深处",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "726770301"
        ],
        "dialogs": {
          "726770301": {
            "id": "726770301",
            "speakerId": 3160,
            "speakerName": "「吉法师」",
            "text": "好大喔！好热！竟然有这么大的着火的花！",
            "nextDialogs": [
              "726770302"
            ]
          },
          "726770302": {
            "id": "726770302",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "对吧！啊，对了…",
            "nextDialogs": [
              "726770303"
            ]
          },
          "726770303": {
            "id": "726770303",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "吉法师你等一下，我们给你拍照！",
            "nextDialogs": [
              "726770304"
            ]
          },
          "726770304": {
            "id": "726770304",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "在这么热的地方？",
            "nextDialogs": [
              "726770305"
            ]
          },
          "726770305": {
            "id": "726770305",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "就是这么热才好！",
            "nextDialogs": [
              "726770306"
            ]
          },
          "726770306": {
            "id": "726770306",
            "speakerId": 3160,
            "speakerName": "「吉法师」",
            "text": "呜呶呶…好…"
          }
        }
      }
    },
    {
      "subId": "7267704",
      "subQuestName": "为吉法师拍照",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "726770401"
        ],
        "dialogs": {
          "726770401": {
            "id": "726770401",
            "speakerId": 3160,
            "speakerName": "「吉法师」",
            "text": "呜呶呶…好热…",
            "nextDialogs": [
              "726770402"
            ]
          },
          "726770402": {
            "id": "726770402",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "哼哼，吉法师，这下知道了吧！",
            "nextDialogs": [
              "726770403"
            ]
          },
          "726770403": {
            "id": "726770403",
            "speakerId": 3160,
            "speakerName": "「吉法师」",
            "text": "呶？",
            "nextDialogs": [
              "726770404"
            ]
          },
          "726770404": {
            "id": "726770404",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "知道什么了？",
            "nextDialogs": [
              "726770405"
            ]
          },
          "726770405": {
            "id": "726770405",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "如果是画画的话，就要花更多时间了！",
            "nextDialogs": [
              "726770406"
            ]
          },
          "726770406": {
            "id": "726770406",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "所以，选择拍照，而不是画画，并不是因为缺乏心意，而是体贴！是体贴啦！",
            "nextDialogs": [
              "726770410"
            ]
          },
          "726770410": {
            "id": "726770410",
            "speakerId": 3160,
            "speakerName": "「吉法师」",
            "text": "明白了。拍照，好。好热喔…",
            "nextDialogs": [
              "726770411"
            ]
          },
          "726770411": {
            "id": "726770411",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "我去把热源快速处理掉。很快就好。",
            "nextDialogs": [
              "726770412"
            ]
          },
          "726770412": {
            "id": "726770412",
            "speakerId": 3160,
            "speakerName": "「吉法师」",
            "text": "呜呶呶…"
          }
        }
      }
    },

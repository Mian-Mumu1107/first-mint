    {
      "subId": "7111110",
      "subQuestName": "与文华交谈",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "711111001"
        ],
        "dialogs": {
          "711111001": {
            "id": "711111001",
            "speakerId": 2488,
            "speakerName": "文华",
            "text": "大家都看到了吧？椒宝的精神状态一看就很好！反观云宝，萎靡的让人心疼。",
            "nextDialogs": [
              "711111002"
            ]
          },
          "711111002": {
            "id": "711111002",
            "speakerId": 2231,
            "speakerName": "土生",
            "text": "老头，你是不是眼神不好？要我说反过来才对吧？",
            "nextDialogs": [
              "711111003"
            ]
          },
          "711111003": {
            "id": "711111003",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "唔…我怎么看不出来…我觉得它们看起来差不多，可能还是要走一走才行。",
            "nextDialogs": [
              "711111004"
            ]
          },
          "711111004": {
            "id": "711111004",
            "speakerId": 2488,
            "speakerName": "文华",
            "text": "两位好心人，就请你们当裁判可以吗？老夫相信你们一定是公正的。",
            "nextDialogs": [
              "711111005"
            ]
          },
          "711111005": {
            "id": "711111005",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "那具体规则是什么呢？",
            "nextDialogs": [
              "711111006"
            ]
          },
          "711111006": {
            "id": "711111006",
            "speakerId": 2488,
            "speakerName": "文华",
            "text": "就看云宝和椒宝谁先顺利走到终点！老夫会让助手去终点等着。",
            "nextDialogs": [
              "711111007"
            ]
          },
          "711111007": {
            "id": "711111007",
            "speakerId": 2488,
            "speakerName": "文华",
            "text": "明礼，你现在就可以过去了。",
            "nextDialogs": [
              "711111008"
            ]
          },
          "711111008": {
            "id": "711111008",
            "speakerId": 2254,
            "speakerName": "明礼",
            "text": "是，老板。",
            "nextDialogs": [
              "711111009"
            ]
          },
          "711111009": {
            "id": "711111009",
            "speakerId": 2231,
            "speakerName": "土生",
            "text": "老头，你不觉得这样很为难驮兽吗？特别是你的椒宝，它都饿成这样了。",
            "nextDialogs": [
              "711111010"
            ]
          },
          "711111010": {
            "id": "711111010",
            "speakerId": 2488,
            "speakerName": "文华",
            "text": "哈哈哈，小年轻，你害怕了吧？你开始找借口了！",
            "nextDialogs": [
              "711111011"
            ]
          },
          "711111011": {
            "id": "711111011",
            "speakerId": 2231,
            "speakerName": "土生",
            "text": "我是在为你考虑啊，真是好心当成驴肝肺，那就比嘛！谁怕谁啊？",
            "nextDialogs": [
              "711111012"
            ]
          },
          "711111012": {
            "id": "711111012",
            "speakerId": 2488,
            "speakerName": "文华",
            "text": "哼哼，现在就开始吧。老夫要给你这种年轻人好好上一课。",
            "nextDialogs": [
              "711111013"
            ]
          },
          "711111013": {
            "id": "711111013",
            "speakerId": 2254,
            "speakerName": "明礼",
            "text": "老板，可以开始了！",
            "nextDialogs": [
              "711111014"
            ]
          },
          "711111014": {
            "id": "711111014",
            "speakerId": 2488,
            "speakerName": "文华",
            "text": "好，开始！"
          }
        }
      }
    },
    {
      "subId": "7111104",
      "subQuestName": "旁观云云和椒椒的比赛",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [],
        "dialogs": {}
      }
    },
    {
      "subId": "7111105",
      "subQuestName": "查看椒椒的状况",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "711110501"
        ],
        "dialogs": {
          "711110501": {
            "id": "711110501",
            "speakerId": 2488,
            "speakerName": "文华",
            "text": "椒宝你怎么也不走了！是不是想吃绝云椒椒了？",
            "nextDialogs": [
              "711110502"
            ]
          },
          "711110502": {
            "id": "711110502",
            "speakerId": 2488,
            "speakerName": "文华",
            "text": "来，老夫准备了很多绝云椒椒。快吃吧，今天你可以敞开了吃！",
            "nextDialogs": [
              "711110503"
            ]
          },
          "711110503": {
            "id": "711110503",
            "speakerId": 2488,
            "speakerName": "文华",
            "text": "吃饱了才有力气好好比赛！",
            "nextDialogs": [
              "711110504"
            ]
          },
          "711110504": {
            "id": "711110504",
            "speakerId": 2494,
            "speakerName": "椒椒",
            "text": "（椒椒似乎知道文华拿出了什么，看都没有看一眼。）",
            "nextDialogs": [
              "711110505"
            ]
          },
          "711110505": {
            "id": "711110505",
            "speakerId": 2488,
            "speakerName": "文华",
            "text": "这…这是怎么回事？你怎么也不吃了…"
          }
        }
      }
    },
    {
      "subId": "7111107",
      "subQuestName": "查看云云的状况",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "711110701"
        ],
        "dialogs": {
          "711110701": {
            "id": "711110701",
            "speakerId": 2231,
            "speakerName": "土生",
            "text": "小家伙，你不是才吃饭没多久吗？这就饿了啊？",
            "nextDialogs": [
              "711110702"
            ]
          },
          "711110702": {
            "id": "711110702",
            "speakerId": 2231,
            "speakerName": "土生",
            "text": "真是拿你没办法，树莓已经吃完了哦，不过还有日落果，喏，这个你应该也很喜欢吧。",
            "nextDialogs": [
              "711110703"
            ]
          },
          "711110703": {
            "id": "711110703",
            "speakerId": 1007,
            "speakerName": "Black Screen",
            "text": "土生掏出了一堆日落果放在地上。",
            "nextDialogs": [
              "711110704"
            ]
          },
          "711110704": {
            "id": "711110704",
            "speakerId": 2232,
            "speakerName": "云云",
            "text": "（云云开始进食…）",
            "nextDialogs": [
              "711110705"
            ]
          },
          "711110705": {
            "id": "711110705",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "快看！椒椒也凑过来了！它好像也想吃日落果！",
            "nextDialogs": [
              "711110706"
            ]
          },
          "711110706": {
            "id": "711110706",
            "speakerId": 2488,
            "speakerName": "文华",
            "text": "椒宝！怎么你也…",
            "nextDialogs": [
              "711110707"
            ]
          },
          "711110707": {
            "id": "711110707",
            "speakerId": 2231,
            "speakerName": "土生",
            "text": "我早就说过了，只有你在一厢情愿地认为它们喜欢绝云椒椒吧。",
            "nextDialogs": [
              "711110708"
            ]
          },
          "711110708": {
            "id": "711110708",
            "speakerId": 2488,
            "speakerName": "文华",
            "text": "怎么会这样…",
            "nextDialogs": [
              "711110709"
            ]
          },
          "711110709": {
            "id": "711110709",
            "speakerId": 2231,
            "speakerName": "土生",
            "text": "算了，跟你这种人没什么好说的，等它们吃饱了再接着比吧。",
            "nextDialogs": [
              "711110710"
            ]
          },
          "711110710": {
            "id": "711110710",
            "speakerId": 2488,
            "speakerName": "文华",
            "text": "算了…唉…",
            "nextDialogs": [
              "711110711"
            ]
          },
          "711110711": {
            "id": "711110711",
            "speakerId": 2488,
            "speakerName": "文华",
            "text": "老夫明白了…不必再比了…老夫认输…",
            "nextDialogs": [
              "711110712"
            ]
          },
          "711110712": {
            "id": "711110712",
            "speakerId": 2231,
            "speakerName": "土生",
            "text": "咦？",
            "nextDialogs": [
              "711110713"
            ]
          },
          "711110713": {
            "id": "711110713",
            "speakerId": 2488,
            "speakerName": "文华",
            "text": "或许老夫是有点自以为是了…但老夫绝不是那种拘泥的老顽固！",
            "nextDialogs": [
              "711110714"
            ]
          },
          "711110714": {
            "id": "711110714",
            "speakerId": 2488,
            "speakerName": "文华",
            "text": "年轻人，你赢了。看来云宝和椒宝已经长大了，既然现在它们不爱吃绝云椒椒，就随它们去吧…",
            "nextDialogs": [
              "711110715"
            ]
          },
          "711110715": {
            "id": "711110715",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "它们应该从来就没有爱吃过吧…",
            "nextDialogs": [
              "711110716"
            ]
          },
          "711110716": {
            "id": "711110716",
            "speakerId": 2231,
            "speakerName": "土生",
            "text": "老头，你还挺让人意外的…不管怎么说，知错能改的老头也算好老头吧。",
            "nextDialogs": [
              "711110717"
            ]
          },
          "711110717": {
            "id": "711110717",
            "speakerId": 2488,
            "speakerName": "文华",
            "text": "年轻人，我还想问问你，你怎么这么熟悉驮兽的习性？",
            "nextDialogs": [
              "711110718"
            ]
          },
          "711110718": {
            "id": "711110718",
            "speakerId": 2231,
            "speakerName": "土生",
            "text": "我喜欢小动物啊，驮兽小时候很可爱的。不过我家里比较穷，养不起。",
            "nextDialogs": [
              "711110719"
            ]
          },
          "711110719": {
            "id": "711110719",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "所以你就和你的同伙们偷走了云宝？",
            "nextDialogs": [
              "711110720"
            ]
          },
          "711110720": {
            "id": "711110720",
            "speakerId": 2231,
            "speakerName": "土生",
            "text": "我都说了，是这只驮兽自己跑来的！我们可没偷哦！",
            "nextDialogs": [
              "711110721"
            ]
          },
          "711110721": {
            "id": "711110721",
            "speakerId": 2231,
            "speakerName": "土生",
            "text": "上头说这驮兽正好用得上，我们最近有笔大买卖，要运的都是大件儿。我们就把它养在营地里了。",
            "nextDialogs": [
              "711110722"
            ]
          },
          "711110722": {
            "id": "711110722",
            "speakerId": 2488,
            "speakerName": "文华",
            "text": "哼，这样…那、那你们也不能占为己有啊！",
            "nextDialogs": [
              "711110723"
            ]
          },
          "711110723": {
            "id": "711110723",
            "speakerId": 2231,
            "speakerName": "土生",
            "text": "我们怎么知道这高山僻岭的地方居然还有人养驮兽呢…早知道会遇到这么麻烦的家伙，我们早就送还给你了！",
            "nextDialogs": [
              "711110724"
            ]
          },
          "711110724": {
            "id": "711110724",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "若不是因为我们，你不会轻易还吧。",
            "nextDialogs": [
              "711110725"
            ]
          },
          "711110725": {
            "id": "711110725",
            "speakerId": 2488,
            "speakerName": "文华",
            "text": "原来是这样…哼，亡羊补牢，犹未晚矣！那个，小子，有没有想过跳槽，来商队做工？",
            "nextDialogs": [
              "711110726"
            ]
          },
          "711110726": {
            "id": "711110726",
            "speakerId": 2231,
            "speakerName": "土生",
            "text": "什么啊…跟你混未必就能比现在吃得更饱吧？",
            "nextDialogs": [
              "711110727"
            ]
          },
          "711110727": {
            "id": "711110727",
            "speakerId": 2488,
            "speakerName": "文华",
            "text": "吃饱？吃饱！哈哈哈哈哈…你还想吃饱！哈哈哈哈哈！",
            "nextDialogs": [
              "711110728"
            ]
          },
          "711110728": {
            "id": "711110728",
            "speakerId": 2231,
            "speakerName": "土生",
            "text": "……",
            "nextDialogs": [
              "711110729"
            ]
          },
          "711110729": {
            "id": "711110729",
            "speakerId": 2488,
            "speakerName": "文华",
            "text": "你看，在这里的各位都能证明，你是盗宝团的犯罪分子。只要我一纸文书交给千岩军的捕头，你就得吃牢饭。",
            "nextDialogs": [
              "711110730"
            ]
          },
          "711110730": {
            "id": "711110730",
            "speakerId": 2488,
            "speakerName": "文华",
            "text": "但是老夫心善，不光免了你的罪责，而且还给你一份工作，让你有吃有住。你看如何？",
            "nextDialogs": [
              "711110731"
            ]
          },
          "711110731": {
            "id": "711110731",
            "speakerId": 2231,
            "speakerName": "土生",
            "text": "工钱多少？",
            "nextDialogs": [
              "711110732"
            ]
          },
          "711110732": {
            "id": "711110732",
            "speakerId": 2488,
            "speakerName": "文华",
            "text": "啊？啊…工钱啊…工钱…那你问千岩军吧！",
            "nextDialogs": [
              "711110733"
            ]
          },
          "711110733": {
            "id": "711110733",
            "speakerId": 2231,
            "speakerName": "土生",
            "text": "别，别…！工钱您来定行了吧！",
            "nextDialogs": [
              "711110734"
            ]
          },
          "711110734": {
            "id": "711110734",
            "speakerId": 2488,
            "speakerName": "文华",
            "text": "嗯…老夫现在很认可你的能力。如果你愿意，以后老夫的驮兽就由你负责照料。",
            "nextDialogs": [
              "711110735"
            ]
          },
          "711110735": {
            "id": "711110735",
            "speakerId": 2488,
            "speakerName": "文华",
            "text": "老夫保证，你不仅能填饱肚子，还能让才华得到充分的发挥。",
            "nextDialogs": [
              "711110736"
            ]
          },
          "711110736": {
            "id": "711110736",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "呜哇，我还是第一次见到挖盗宝团墙脚的！",
            "nextDialogs": [
              "711110739"
            ]
          },
          "711110739": {
            "id": "711110739",
            "speakerId": 2231,
            "speakerName": "土生",
            "text": "你们也这么觉得吗…？坦白说，我挺喜欢和驮兽待在一起的…",
            "nextDialogs": [
              "711110740"
            ]
          },
          "711110740": {
            "id": "711110740",
            "speakerId": 2231,
            "speakerName": "土生",
            "text": "让我先考虑考虑吧，等考虑周全了，我再告诉你我的决定。",
            "nextDialogs": [
              "711110741"
            ]
          },
          "711110741": {
            "id": "711110741",
            "speakerId": 2488,
            "speakerName": "文华",
            "text": "年轻人，我相信你会做出正确的选择。",
            "nextDialogs": [
              "711110742"
            ]
          },
          "711110742": {
            "id": "711110742",
            "speakerId": 2488,
            "speakerName": "文华",
            "text": "（得找个人给我好好盯着他！）",
            "nextDialogs": [
              "711110743"
            ]
          },
          "711110743": {
            "id": "711110743",
            "speakerId": 2488,
            "speakerName": "文华",
            "text": "好呀，好啊！两位好心人，多谢你们带回了老夫的云宝，还让老夫知道了它们都不喜欢绝云椒椒…欸…让你们受苦了！",
            "nextDialogs": [
              "711110744"
            ]
          },
          "711110744": {
            "id": "711110744",
            "speakerId": 2488,
            "speakerName": "文华",
            "text": "总之，一点心意，请收下吧。你们这些年轻人，未来要每天都能吃到喜欢的东西才行啊！"
          }
        }
      }
    },
    {
      "subId": "7111108",
      "subQuestName": "(隐藏)在地上刷日落果$HIDDEN",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [],
        "dialogs": {}
      }
    },
    {
      "subId": "7111151",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "711115101"
        ],
        "dialogs": {
          "711115101": {
            "id": "711115101",
            "speakerId": 2254,
            "speakerName": "明礼",
            "text": "两位好，我是老板的助手明礼。",
            "nextDialogs": [
              "711115102"
            ]
          },
          "711115102": {
            "id": "711115102",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "你怎么也有点愁眉苦脸的？",
            "nextDialogs": [
              "711115103"
            ]
          },
          "711115103": {
            "id": "711115103",
            "speakerId": 2254,
            "speakerName": "明礼",
            "text": "我是在为老板发愁呢，他又弄丢了一只驮兽…要知道，我们总共就三只，丢到现在就只剩下一只了！",
            "nextDialogs": [
              "711115104"
            ]
          },
          "711115104": {
            "id": "711115104",
            "speakerId": 2254,
            "speakerName": "明礼",
            "text": "驮兽可不便宜，老板和我又都不太懂喂养，这样下去我们一定会亏损的。",
            "nextDialogs": [
              "711115105"
            ]
          },
          "711115105": {
            "id": "711115105",
            "speakerId": 2254,
            "speakerName": "明礼",
            "text": "你们说，老板是不是年纪大了，开始健忘了？"
          }
        }
      }
    },
    {
      "subId": "7111152",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "711115201"
        ],
        "dialogs": {
          "711115201": {
            "id": "711115201",
            "speakerId": 2254,
            "speakerName": "明礼",
            "text": "还没有结束吗？是不是中间出什么意外了？",
            "nextDialogs": [
              "711115202"
            ]
          },
          "711115202": {
            "id": "711115202",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "已经结束了。",
            "nextDialogs": [
              "711115203"
            ]
          },
          "711115203": {
            "id": "711115203",
            "speakerId": 2254,
            "speakerName": "明礼",
            "text": "欸？！老板忘了我还在等在终点吗？！他是不是真的上年纪了…",
            "nextDialogs": [
              "711115204"
            ]
          },
          "711115204": {
            "id": "711115204",
            "speakerId": 2254,
            "speakerName": "明礼",
            "text": "也许我该考虑另谋出路了…"
          }
        }
      }
    },
    {
      "subId": "7111199",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "711119901"
        ],
        "dialogs": {
          "711119901": {
            "id": "711119901",
            "speakerId": 2488,
            "speakerName": "文华",
            "text": "就是这里啦！好汉请动手！",
            "nextDialogs": [
              "711119902"
            ]
          },
          "711119902": {
            "id": "711119902",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "呜哇，谁才是强盗啦！",
            "nextDialogs": [
              "711119903"
            ]
          },
          "711119903": {
            "id": "711119903",
            "speakerId": 21271,
            "speakerName": "惊慌的盗宝团",
            "text": "嗯？！你们是谁？我们可是铁盐帮的人！动手前可要想清楚！",
            "nextDialogs": [
              "711119904"
            ]
          },
          "711119904": {
            "id": "711119904",
            "speakerId": 2488,
            "speakerName": "文华",
            "text": "哦，我的云宝！坏蛋盗宝团有没有欺负你？",
            "nextDialogs": [
              "711119905"
            ]
          },
          "711119905": {
            "id": "711119905",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "噫…称呼驮兽用不着这样肉麻吧！",
            "nextDialogs": [
              "711119906"
            ]
          },
          "711119906": {
            "id": "711119906",
            "speakerId": 21271,
            "speakerName": "惊慌的盗宝团",
            "text": "嗯？！你们是谁？我们可是铁盐帮的人！动手前可要想清楚！",
            "nextDialogs": [
              "711119907"
            ]
          },
          "711119907": {
            "id": "711119907",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "怎么这里也有盗宝团！",
            "nextDialogs": [
              "711119908"
            ]
          },
          "711119908": {
            "id": "711119908",
            "speakerId": 1005,
            "speakerName": "派蒙",

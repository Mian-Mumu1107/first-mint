  "subQuests": [
    {
      "subId": "7111101",
      "subQuestName": "与商人交谈$HIDDEN",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "711110101"
        ],
        "dialogs": {
          "711110101": {
            "id": "711110101",
            "speakerId": 2488,
            "speakerName": "文华",
            "text": "路过的好心人啊，求求你们，帮老夫一把吧？",
            "nextDialogs": [
              "711110102"
            ]
          },
          "711110102": {
            "id": "711110102",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "发生什么事了？",
            "nextDialogs": [
              "711110103"
            ]
          },
          "711110103": {
            "id": "711110103",
            "speakerId": 2488,
            "speakerName": "文华",
            "text": "老夫的云宝失踪了，附近找遍了，都不见踪影…只有一伙盗宝团的营地，那里老夫不敢去…",
            "nextDialogs": [
              "711110104"
            ]
          },
          "711110104": {
            "id": "711110104",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "云宝？",
            "nextDialogs": [
              "711110105"
            ]
          },
          "711110105": {
            "id": "711110105",
            "speakerId": 2488,
            "speakerName": "文华",
            "text": "是老夫的宝贝！老夫的云宝！一只叫云云的驮兽！",
            "nextDialogs": [
              "711110106"
            ]
          },
          "711110106": {
            "id": "711110106",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "驮兽…？原来璃月人也养驮兽的吗？",
            "nextDialogs": [
              "711110107"
            ]
          },
          "711110107": {
            "id": "711110107",
            "speakerId": 2488,
            "speakerName": "文华",
            "text": "我们长途跑商的人呀，大宗货物走山地总是难题。牛太慢，骡子、矮马载货又少，人工管吃管喝太贵了…",
            "nextDialogs": [
              "711110108"
            ]
          },
          "711110108": {
            "id": "711110108",
            "speakerId": 2488,
            "speakerName": "文华",
            "text": "于是我就想了个好主意，嘿嘿，从须弥高价买进几头好品种的驮兽，大宗运货就不用愁了！",
            "nextDialogs": [
              "711110109"
            ]
          },
          "711110109": {
            "id": "711110109",
            "speakerId": 2488,
            "speakerName": "文华",
            "text": "可没想到，这刚进沉玉谷，驮兽就让人给偷了！唉…我的云宝，我的摩拉！",
            "nextDialogs": [
              "711110110"
            ]
          },
          "711110110": {
            "id": "711110110",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "呜哇，别哭了，都多大人啦！",
            "nextDialogs": [
              "711110112",
              "711110116"
            ]
          },
          "711110112": {
            "id": "711110112",
            "speakerId": 2488,
            "speakerName": "文华",
            "text": "帐不能这么算，你看，我买的驮兽都是成对的，品种又好。只要我能配种成功，接下来两到三代就能适应我们璃月的环境。",
            "nextDialogs": [
              "711110113"
            ]
          },
          "711110113": {
            "id": "711110113",
            "speakerId": 2488,
            "speakerName": "文华",
            "text": "嘿嘿，等二三代长成了，我再往外出租自家的成年驮兽，或者卖出良种幼崽、种兽，不就把成本都收回来了嘛！",
            "nextDialogs": [
              "711110114"
            ]
          },
          "711110114": {
            "id": "711110114",
            "speakerId": 2488,
            "speakerName": "文华",
            "text": "唉…只可惜现在，你瞧瞧…这不是亏大发了，我的云宝…",
            "nextDialogs": [
              "711110119"
            ]
          },
          "711110119": {
            "id": "711110119",
            "speakerId": 2488,
            "speakerName": "文华",
            "text": "老夫买的这三头驮兽宝贝，个个暂不说养出感情来，也是灌注了心血的呀…",
            "nextDialogs": [
              "711110120"
            ]
          },
          "711110120": {
            "id": "711110120",
            "speakerId": 2488,
            "speakerName": "文华",
            "text": "椒宝最乖，它一直在这。绝宝很调皮，很久之前就走失了…",
            "nextDialogs": [
              "711110121"
            ]
          },
          "711110121": {
            "id": "711110121",
            "speakerId": 2488,
            "speakerName": "文华",
            "text": "如果连云宝也离我而去…这是生命中不可承受之重！",
            "nextDialogs": [
              "711110122"
            ]
          },
          "711110122": {
            "id": "711110122",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "啊…这样说来，剩下的那只驮兽确实好可怜啊，孤孤单单，没有伙伴…",
            "nextDialogs": [
              "711110123"
            ]
          },
          "711110123": {
            "id": "711110123",
            "speakerId": 2488,
            "speakerName": "文华",
            "text": "两位好心人，你们一定会帮老夫的吧？老夫在这里发愁了半天，只有你们过来问问…"
          },
          "711110116": {
            "id": "711110116",
            "speakerId": 2488,
            "speakerName": "文华",
            "text": "嗯，这个嘛…倒是没有…啊，有！我不是说过，附近有一处盗宝团设下的营地吗？云宝的失踪，一定和他们有关！",
            "nextDialogs": [
              "711110117"
            ]
          },
          "711110117": {
            "id": "711110117",
            "speakerId": 2488,
            "speakerName": "文华",
            "text": "那些盗宝团一直在附近活动，若不是买驮兽花光了给护镖准备的预算，我也不至于…唉…",
            "nextDialogs": [
              "711110118"
            ]
          },
          "711110118": {
            "id": "711110118",
            "speakerId": 2488,
            "speakerName": "文华",
            "text": "你看，盗宝团，顾名思义，专盗宝贝，依我看一定就是他们偷走了云宝！"
          }
        }
      }
    },
    {
      "subId": "7111106",
      "subQuestName": "前往盗宝团营地$HIDDEN",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "711110601"
        ],
        "dialogs": {
          "711110601": {
            "id": "711110601",
            "speakerId": 2488,
            "speakerName": "文华",
            "text": "云宝啊！云宝！老夫来接你回家了！",
            "nextDialogs": [
              "711110602"
            ]
          },
          "711110602": {
            "id": "711110602",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "云宝？",
            "nextDialogs": [
              "711110603"
            ]
          },
          "711110603": {
            "id": "711110603",
            "speakerId": 2488,
            "speakerName": "文华",
            "text": "是老夫的宝贝！就是这只叫云云的驮兽！它被这伙盗宝团偷走了！",
            "nextDialogs": [
              "711110604"
            ]
          },
          "711110604": {
            "id": "711110604",
            "speakerId": 2488,
            "speakerName": "文华",
            "text": "老夫行商多年，也就攒下了三只驮兽宝贝。椒宝最乖，它一直陪在老夫身边。绝宝很调皮，很久之前就走失了…",
            "nextDialogs": [
              "711110605"
            ]
          },
          "711110605": {
            "id": "711110605",
            "speakerId": 2488,
            "speakerName": "文华",
            "text": "如果连云宝也离我而去…那是生命中不可承受之重！多亏了你们两位好心人，实在是太感谢你们了！",
            "nextDialogs": [
              "711110606"
            ]
          },
          "711110606": {
            "id": "711110606",
            "speakerId": 2488,
            "speakerName": "文华",
            "text": "云宝啊，这几天你一定受苦了吧？来，老夫带了你最爱的绝云椒椒！快吃吧！",
            "nextDialogs": [
              "711110607"
            ]
          },
          "711110607": {
            "id": "711110607",
            "speakerId": 2488,
            "speakerName": "文华",
            "text": "咦？云宝你怎么又不吃了呢…？你是不是出来学坏了？你快吃呀！",
            "nextDialogs": [
              "711110608"
            ]
          },
          "711110608": {
            "id": "711110608",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "唔…驮兽…会吃绝云椒椒吗？",
            "nextDialogs": [
              "711110609"
            ]
          },
          "711110609": {
            "id": "711110609",
            "speakerId": 2488,
            "speakerName": "文华",
            "text": "老夫一直都是这么喂的！云宝爱吃什么老夫能不知道吗？",
            "nextDialogs": [
              "711110610"
            ]
          },
          "711110610": {
            "id": "711110610",
            "speakerId": 10205,
            "speakerName": "？？？",
            "text": "你这老头，真现眼…驮兽喜欢吃的是水果…",
            "nextDialogs": [
              "711110611"
            ]
          },
          "711110611": {
            "id": "711110611",
            "speakerId": 10205,
            "speakerName": "？？？",
            "text": "除非饿极了，不然不可能吃绝云椒椒，那是有害驮兽健康的东西。",
            "nextDialogs": [
              "711110612"
            ]
          },
          "711110612": {
            "id": "711110612",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "欸？！你又是谁！",
            "nextDialogs": [
              "711110614",
              "711110618"
            ]
          },
          "711110614": {
            "id": "711110614",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "哦…我还以为是什么重要人物呢…",
            "nextDialogs": [
              "711110615"
            ]
          },
          "711110615": {
            "id": "711110615",
            "speakerId": 2488,
            "speakerName": "文华",
            "text": "好，既然我的云宝找到了，我们就先回去吧…",
            "nextDialogs": [
              "711110616"
            ]
          },
          "711110616": {
            "id": "711110616",
            "speakerId": 10205,
            "speakerName": "？？？",
            "text": "喂！不要无视我！",
            "nextDialogs": [
              "711110622"
            ]
          },
          "711110622": {
            "id": "711110622",
            "speakerId": 2488,
            "speakerName": "文华",
            "text": "哼哼，好啊…你这个小偷。",
            "nextDialogs": [
              "711110623"
            ]
          },
          "711110623": {
            "id": "711110623",
            "speakerId": 2488,
            "speakerName": "文华",
            "text": "你的同伙都被我们绳之以法了，你还有胆对我家宝贝指手画脚，指指点点…",
            "nextDialogs": [
              "711110624"
            ]
          },
          "711110624": {
            "id": "711110624",
            "speakerId": 2488,
            "speakerName": "文华",
            "text": "…指鹿为马，指天誓日，指点乾坤，指桑骂槐…"
          },
          "711110618": {
            "id": "711110618",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "呜哇，好可怕！",
            "nextDialogs": [
              "711110619"
            ]
          },
          "711110619": {
            "id": "711110619",
            "speakerId": 2488,
            "speakerName": "文华",
            "text": "好可怕！",
            "nextDialogs": [
              "711110620"
            ]
          },
          "711110620": {
            "id": "711110620",
            "speakerId": 2232,
            "speakerName": "云云",
            "text": "哞！",
            "nextDialogs": [
              "711110621"
            ]
          },
          "711110621": {
            "id": "711110621",
            "speakerId": 10205,
            "speakerName": "？？？",
            "text": "喂！也太大惊小怪了吧！"
          }
        }
      }
    },

          },
          "761390203": {
            "id": "761390203",
            "speakerId": 7008,
            "speakerName": "萨维特",
            "text": "好嘞，2000摩拉一张，每周结算一次，相信我，这一定是…一笔…",
            "nextDialogs": [
              "761390204"
            ]
          },
          "761390204": {
            "id": "761390204",
            "speakerId": 7008,
            "speakerName": "萨维特",
            "text": "奈、奈芙尔老板，没想到您居然大驾光临…您…您也想买张投资券吗？",
            "nextDialogs": [
              "761390205"
            ]
          },
          "761390205": {
            "id": "761390205",
            "speakerId": 1316,
            "speakerName": "奈芙尔",
            "text": "我就不了，只是陪我这位朋友过来看看而已。",
            "nextDialogs": [
              "761390206"
            ]
          },
          "761390206": {
            "id": "761390206",
            "speakerId": 1316,
            "speakerName": "奈芙尔",
            "text": "听说萨维特老板的投资生意做得有声有色，今天一看，果然如此。",
            "nextDialogs": [
              "761390207"
            ]
          },
          "761390207": {
            "id": "761390207",
            "speakerId": 7008,
            "speakerName": "萨维特",
            "text": "一般！一般，哈哈哈…小本生意，糊口罢了。",
            "nextDialogs": [
              "761390210"
            ]
          },
          "761390210": {
            "id": "761390210",
            "speakerId": 1316,
            "speakerName": "奈芙尔",
            "text": "毕竟是投资，无论盈亏都算正常。",
            "nextDialogs": [
              "761390211"
            ]
          },
          "761390211": {
            "id": "761390211",
            "speakerId": 1316,
            "speakerName": "奈芙尔",
            "text": "不过…呵，你倒是不用太担心了。",
            "nextDialogs": [
              "761390212"
            ]
          },
          "761390212": {
            "id": "761390212",
            "speakerId": 1316,
            "speakerName": "奈芙尔",
            "text": "萨维特老板可是位优秀的生意人，跟着他投资，不会亏的。",
            "nextDialogs": [
              "761390213"
            ]
          },
          "761390213": {
            "id": "761390213",
            "speakerId": 7008,
            "speakerName": "萨维特",
            "text": "咳…！是、是…奈芙尔老板说的是。",
            "nextDialogs": [
              "761390214"
            ]
          },
          "761390214": {
            "id": "761390214",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "看看我今天运气怎么样…",
            "nextDialogs": [
              "761390215"
            ]
          },
          "761390215": {
            "id": "761390215",
            "speakerId": 7008,
            "speakerName": "萨维特",
            "text": "今天…我正想恭喜您呢！您上次买的投资券，可是大大的赚了一笔啊！",
            "nextDialogs": [
              "761390216"
            ]
          },
          "761390216": {
            "id": "761390216",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "你的表情好可疑喔…不会这些话都是你刚刚才编出来的吧？",
            "nextDialogs": [
              "761390217"
            ]
          },
          "761390217": {
            "id": "761390217",
            "speakerId": 7008,
            "speakerName": "萨维特",
            "text": "#呃…嗨！我说的这都是真的，不愧是{NICKNAME}，真是慧眼独具啊！",
            "nextDialogs": [
              "761390218"
            ]
          },
          "761390218": {
            "id": "761390218",
            "speakerId": 7008,
            "speakerName": "萨维特",
            "text": "来，这是您的投资回报，祝您拥有美好的一天！"
          }
        }
      }
    }
  ]

  "subQuests": [
    {
      "subId": "7613901",
      "subQuestName": "与萨维特对话",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "761390101"
        ],
        "dialogs": {
          "761390101": {
            "id": "761390101",
            "speakerId": 7008,
            "speakerName": "萨维特",
            "text": "出版业也不挣钱哪，要不干脆只做投资算了…",
            "nextDialogs": [
              "761390102"
            ]
          },
          "761390102": {
            "id": "761390102",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "想看看投资券…",
            "nextDialogs": [
              "761390103"
            ]
          },
          "761390103": {
            "id": "761390103",
            "speakerId": 7008,
            "speakerName": "萨维特",
            "text": "好嘞，投资券2000摩拉一张，每周结算一次，嘿嘿，这小袋子里…",
            "nextDialogs": [
              "761390104"
            ]
          },
          "761390104": {
            "id": "761390104",
            "speakerId": 7008,
            "speakerName": "萨维特",
            "text": "…呃！",
            "nextDialogs": [
              "761390105"
            ]
          },
          "761390105": {
            "id": "761390105",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "怎么了？",
            "nextDialogs": [
              "761390106"
            ]
          },
          "761390106": {
            "id": "761390106",
            "speakerId": 7008,
            "speakerName": "萨维特",
            "text": "没、没什么，就是不知道奈芙尔老板也大驾光临，您…您也想买张投资券吗？",
            "nextDialogs": [
              "761390107"
            ]
          },
          "761390107": {
            "id": "761390107",
            "speakerId": 1316,
            "speakerName": "奈芙尔",
            "text": "我就不了，只是陪我这位朋友过来看看而已。",
            "nextDialogs": [
              "761390108"
            ]
          },
          "761390108": {
            "id": "761390108",
            "speakerId": 1316,
            "speakerName": "奈芙尔",
            "text": "听说萨维特老板的投资生意做得有声有色，今天一看，果然如此。",
            "nextDialogs": [
              "761390109"
            ]
          },
          "761390109": {
            "id": "761390109",
            "speakerId": 7008,
            "speakerName": "萨维特",
            "text": "一般！一般，哈哈哈…小本生意，糊口罢了。",
            "nextDialogs": [
              "761390110"
            ]
          },
          "761390110": {
            "id": "761390110",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "这真的能赚钱吗？",
            "nextDialogs": [
              "761390111"
            ]
          },
          "761390111": {
            "id": "761390111",
            "speakerId": 1316,
            "speakerName": "奈芙尔",
            "text": "那是当然，萨维特老板可是位优秀的生意人，跟着他投资，不会亏的。",
            "nextDialogs": [
              "761390112"
            ]
          },
          "761390112": {
            "id": "761390112",
            "speakerId": 7008,
            "speakerName": "萨维特",
            "text": "是…是…哈哈哈…",
            "nextDialogs": [
              "761390113"
            ]
          },
          "761390113": {
            "id": "761390113",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "看看我今天运气怎么样…",
            "nextDialogs": [
              "761390114"
            ]
          },
          "761390114": {
            "id": "761390114",
            "speakerId": 7008,
            "speakerName": "萨维特",
            "text": "今天！就在今天，您刚才买的是我们刚刚推出的…短线投资券！盈亏立即结算！",
            "nextDialogs": [
              "761390115"
            ]
          },
          "761390115": {
            "id": "761390115",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "怎么感觉这些话都是你刚刚才编出来的…",
            "nextDialogs": [
              "761390116"
            ]
          },
          "761390116": {
            "id": "761390116",
            "speakerId": 7008,
            "speakerName": "萨维特",
            "text": "呃…总、总之，感谢您购买短线投资券！",
            "nextDialogs": [
              "761390117"
            ]
          },
          "761390117": {
            "id": "761390117",
            "speakerId": 7008,
            "speakerName": "萨维特",
            "text": "这是您的投资回报，祝您拥有美好的一天！",
            "nextDialogs": [
              "761390120"
            ]
          },
          "761390120": {
            "id": "761390120",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "真的？嘿嘿嘿，那你给我买一个小鸟形状的，我就喜欢那样的！",
            "nextDialogs": [
              "761390121"
            ]
          },
          "761390121": {
            "id": "761390121",
            "speakerId": 1316,
            "speakerName": "奈芙尔",
            "text": "那我也告辞了，萨维特老板果然是个有信誉的好商人，祝您生意兴隆。",
            "nextDialogs": [
              "761390122"
            ]
          },
          "761390122": {
            "id": "761390122",
            "speakerId": 7008,
            "speakerName": "萨维特",
            "text": "借奈芙尔老板吉言…",
            "nextDialogs": [
              "761390123"
            ]
          },
          "761390123": {
            "id": "761390123",
            "speakerId": 7008,
            "speakerName": "萨维特",
            "text": "…然后，奈芙尔老板，上次我拜托您帮忙找的那个…",
            "nextDialogs": [
              "761390124"
            ]
          },
          "761390124": {
            "id": "761390124",
            "speakerId": 1316,
            "speakerName": "奈芙尔",
            "text": "东西是已经找到了，但…",
            "nextDialogs": [
              "761390125"
            ]
          },
          "761390125": {
            "id": "761390125",
            "speakerId": 1316,
            "speakerName": "奈芙尔",
            "text": "萨维特先生，不要心急。事情，要一步一步地做才稳当。",
            "nextDialogs": [
              "761390126"
            ]
          },
          "761390126": {
            "id": "761390126",
            "speakerId": 7008,
            "speakerName": "萨维特",
            "text": "是、是，奈芙尔老板说的是…那就麻烦了，我就指望您了…"
          }
        }
      }
    },
    {

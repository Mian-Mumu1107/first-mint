    {
      "subId": "601110",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "60111001"
        ],
        "dialogs": {
          "60111001": {
            "id": "60111001",
            "speakerId": 1006,
            "speakerName": "爱诺",
            "text": "修灯，修灯，那可太简单了，三两下的工夫。",
            "nextDialogs": [
              "60111002"
            ]
          },
          "60111002": {
            "id": "60111002",
            "speakerId": 1006,
            "speakerName": "爱诺",
            "text": "要是每个人都能知道自己在干什么就好了。",
            "nextDialogs": [
              "60111003"
            ]
          },
          "60111003": {
            "id": "60111003",
            "speakerId": 1006,
            "speakerName": "爱诺",
            "text": "就像辛查那家伙，别人拿什么零件过来他都修，最后修出来一个集成控制器，又是大炮又是屏障，搞出一堆麻烦。",
            "nextDialogs": [
              "60111004"
            ]
          },
          "60111004": {
            "id": "60111004",
            "speakerId": 1006,
            "speakerName": "爱诺",
            "text": "我骂过他了，他以后会按期给我提交报告，我要检查他最近都在干什么。唉，也、也算我有不对的地方啦！"
          }
        }
      }
    },
    {
      "subId": "601111",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "60111101"
        ],
        "dialogs": {
          "60111101": {
            "id": "60111101",
            "speakerId": 1007,
            "speakerName": "菲林斯",
            "text": "#{NICKNAME}，竟然能在这里见到你。大战之后，我觉得应该进行一次深度维修与保养。",
            "nextDialogs": [
              "60111102"
            ]
          },
          "60111102": {
            "id": "60111102",
            "speakerId": 1007,
            "speakerName": "菲林斯",
            "text": "——感谢你知道那么多，还愿意为我保守秘密。",
            "nextDialogs": [
              "60111105"
            ]
          },
          "60111105": {
            "id": "60111105",
            "speakerId": 1007,
            "speakerName": "菲林斯",
            "text": "因为不想被执灯长找麻烦。如果没办法被感应到，估计上面会硬塞给我一盏执灯士的灯。",
            "nextDialogs": [
              "60111106"
            ]
          },
          "60111106": {
            "id": "60111106",
            "speakerId": 1007,
            "speakerName": "菲林斯",
            "text": "会手提两盏灯的执灯士，实在是太怪异了。审美上实在难以容忍呢，呵呵。"
          }
        }
      }
    },
    {
      "subId": "601199",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "60119901"
        ],
        "dialogs": {
          "60119901": {
            "id": "60119901",
            "speakerId": 1003,
            "speakerName": "派蒙",
            "text": "欸，是努昂诺塔…我们要跟上去吗？还是说，你还有想见见的人呢？"
          }
        }
      }
    }
  ]
}
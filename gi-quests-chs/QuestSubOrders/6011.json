    {
      "subId": "601106",
      "subQuestName": "与「少女」交谈",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "60110601"
        ],
        "dialogs": {
          "60110601": {
            "id": "60110601",
            "speakerId": 1003,
            "speakerName": "派蒙",
            "text": "哥伦比娅！你怎么到这里来了？",
            "nextDialogs": [
              "60110602"
            ]
          },
          "60110602": {
            "id": "60110602",
            "speakerId": 1009,
            "speakerName": "「少女」",
            "text": "嗯？不是你们推荐我出来走走的吗？",
            "nextDialogs": [
              "60110603"
            ]
          },
          "60110603": {
            "id": "60110603",
            "speakerId": 1003,
            "speakerName": "派蒙",
            "text": "是倒是啦，你不怕被「愚人众」发现吗？",
            "nextDialogs": [
              "60110604"
            ]
          },
          "60110604": {
            "id": "60110604",
            "speakerId": 1009,
            "speakerName": "「少女」",
            "text": "桑多涅没兴趣抓我，其他「愚人众」现在也不会冒险来找我。他们有更棘手的问题需要解决。",
            "nextDialogs": [
              "60110605"
            ]
          },
          "60110605": {
            "id": "60110605",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "（是指「猎月人」吗…他现在是威胁着挪德卡莱所有人的问题。）",
            "nextDialogs": [
              "60110606"
            ]
          },
          "60110606": {
            "id": "60110606",
            "speakerId": 1003,
            "speakerName": "派蒙",
            "text": "好吧，出来走走总是好事，感觉怎么样？喜欢那夏镇吗？",
            "nextDialogs": [
              "60110607"
            ]
          },
          "60110607": {
            "id": "60110607",
            "speakerId": 1009,
            "speakerName": "「少女」",
            "text": "唔…月矩力的流动有些紊乱，人们心中很不安。",
            "nextDialogs": [
              "60110608"
            ]
          },
          "60110608": {
            "id": "60110608",
            "speakerId": 1009,
            "speakerName": "「少女」",
            "text": "不过…",
            "nextDialogs": [
              "60110609"
            ]
          },
          "60110609": {
            "id": "60110609",
            "speakerId": 1003,
            "speakerName": "派蒙",
            "text": "不过什么？",
            "nextDialogs": [
              "60110610"
            ]
          },
          "60110610": {
            "id": "60110610",
            "speakerId": 1009,
            "speakerName": "「少女」",
            "text": "你们上次「请客」的菜，是在这边买的吗？",
            "nextDialogs": [
              "60110611"
            ]
          },
          "60110611": {
            "id": "60110611",
            "speakerId": 1003,
            "speakerName": "派蒙",
            "text": "（在意的居然是这个吗！她该不是为了吃浆果煎肉才来的吧！）",
            "nextDialogs": [
              "60110612"
            ]
          },
          "60110612": {
            "id": "60110612",
            "speakerId": 1003,
            "speakerName": "派蒙",
            "text": "呃，你，你喜欢的话我们下次带你去吃就是了，还有很多在家里吃不到的好东西哟。",
            "nextDialogs": [
              "60110613"
            ]
          },
          "60110613": {
            "id": "60110613",
            "speakerId": 1009,
            "speakerName": "「少女」",
            "text": "…嗯？你从刚才开始就很沉默呢。是心中有什么疑问吗？",
            "nextDialogs": [
              "60110615"
            ]
          },
          "60110615": {
            "id": "60110615",
            "speakerId": 1009,
            "speakerName": "「少女」",
            "text": "唔…我当时没能洞悉他的计划。",
            "nextDialogs": [
              "60110616"
            ]
          },
          "60110616": {
            "id": "60110616",
            "speakerId": 1009,
            "speakerName": "「少女」",
            "text": "如今他取得了形体，力量不容小觑。",
            "nextDialogs": [
              "60110617"
            ]
          },
          "60110617": {
            "id": "60110617",
            "speakerId": 1009,
            "speakerName": "「少女」",
            "text": "但那力量中有一股「执念」，近乎疯狂的「执念」。",
            "nextDialogs": [
              "60110618"
            ]
          },
          "60110618": {
            "id": "60110618",
            "speakerId": 1009,
            "speakerName": "「少女」",
            "text": "我不清楚那执念是为月亮而来，还是为别的什么…",
            "nextDialogs": [
              "60110619"
            ]
          },
          "60110619": {
            "id": "60110619",
            "speakerId": 1009,
            "speakerName": "「少女」",
            "text": "或许弄清这股执念的所指，也是今后对抗他的关键…"
          }
        }
      }
    },
    {
      "subId": "601107",
      "subQuestName": "尾声",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "60110701"
        ],
        "dialogs": {
          "60110701": {
            "id": "60110701",
            "speakerId": 1010,
            "speakerName": "猎月人",
            "text": "…有趣。",
            "nextDialogs": [
              "60110702"
            ]
          },
          "60110702": {
            "id": "60110702",
            "speakerId": 1010,
            "speakerName": "猎月人",
            "text": "都跟到这里了，不如亮明身份吧。",
            "nextDialogs": [
              "60110703"
            ]
          },
          "60110703": {
            "id": "60110703",
            "speakerId": 1011,
            "speakerName": "？？？",
            "text": "哈哈，对啊，忘了自我介绍了。",
            "nextDialogs": [
              "60110704"
            ]
          },
          "60110704": {
            "id": "60110704",
            "speakerId": 1012,
            "speakerName": "法尔伽",
            "text": "我是西风骑士团「北风骑士」兼「团长」，法尔伽。"
          }
        }
      }
    },
    {
      "subId": "601108",
      "subQuestName": "尾声",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [],
        "dialogs": {}
      }

    {
      "subId": "7300103",
      "subQuestName": "与拉娜对话",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "730010401"
        ],
        "dialogs": {
          "730010401": {
            "id": "730010401",
            "speakerId": 4198,
            "speakerName": "拉娜",
            "text": "啊呀，怎么才这么几天，这里就出现了新的「死域」…而且还在这么靠近大路的地方…",
            "nextDialogs": [
              "730010402"
            ]
          },
          "730010402": {
            "id": "730010402",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "啊，又是死域…",
            "nextDialogs": [
              "730010406",
              "730010405"
            ]
          },
          "730010406": {
            "id": "730010406",
            "speakerId": 4198,
            "speakerName": "拉娜",
            "text": "#原来{NICKNAME}和提纳里前辈一起处理过死域吗？那死域的危险性，我就不多说了。",
            "nextDialogs": [
              "730010407"
            ]
          },
          "730010407": {
            "id": "730010407",
            "speakerId": 4198,
            "speakerName": "拉娜",
            "text": "无论如何，暂时先记下死域的位置与影响半径吧。把你们带到维摩庄，我就去化城郭向前辈报告，请他来帮忙。",
            "nextDialogs": [
              "730010408"
            ]
          },
          "730010408": {
            "id": "730010408",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "拉娜不用担心！这种事情交给我们就行了。",
            "nextDialogs": [
              "730010409"
            ]
          },
          "730010409": {
            "id": "730010409",
            "speakerId": 4198,
            "speakerName": "拉娜",
            "text": "这怎么行！死域真的会危及生命。就算是经验老到的巡林官，也不会轻易接近死域…",
            "nextDialogs": [
              "730010410"
            ]
          },
          "730010410": {
            "id": "730010410",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "#{NICKNAME}不是能驾驭元素的力量吗？有了这个，应该多少能抵挡死域侵袭吧！",
            "nextDialogs": [
              "730010411"
            ]
          },
          "730010411": {
            "id": "730010411",
            "speakerId": 4198,
            "speakerName": "拉娜",
            "text": "#欸？这么说来，之前{NICKNAME}帮忙击退蕈兽的时候，确实使用了元素的力量…",
            "nextDialogs": [
              "730010412"
            ]
          },
          "730010412": {
            "id": "730010412",
            "speakerId": 4198,
            "speakerName": "拉娜",
            "text": "不过，还是不应该这么做。如果你们远道而来，却因为死域受伤…",
            "nextDialogs": [
              "730010413"
            ]
          },
          "730010413": {
            "id": "730010413",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "#拉娜不用担心！{NICKNAME}真的很可靠的，我们在旅行的过程中，遇到过许多事情…"
          },
          "730010405": {
            "id": "730010405",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "嗯嗯！之前我们和提纳里一起处理过死域！我记得，是在化城郭附近吧？"
          }
        }
      }
    },
    {
      "subId": "7300104",
      "subQuestName": "消除死域",
      "sceneId": null,
      "locations": [],

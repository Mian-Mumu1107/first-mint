    {
      "subId": "7300105",
      "subQuestName": "与拉娜对话",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "730010501"
        ],
        "dialogs": {
          "730010501": {
            "id": "730010501",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "#拉娜你看，{NICKNAME}很厉害吧。",
            "nextDialogs": [
              "730010502"
            ]
          },
          "730010502": {
            "id": "730010502",
            "speakerId": 4198,
            "speakerName": "拉娜",
            "text": "#太厉害了！{NICKNAME}，你真是…太厉害了！",
            "nextDialogs": [
              "730010504"
            ]
          },
          "730010504": {
            "id": "730010504",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "拉娜，你太激动了…",
            "nextDialogs": [
              "730010506"
            ]
          },
          "730010506": {
            "id": "730010506",
            "speakerId": 4198,
            "speakerName": "拉娜",
            "text": "#啊，不好意思…咳咳！{NICKNAME}…呃…{M#先生}{F#小姐}…"
          }
        }
      }
    },
    {
      "subId": "7300106",
      "subQuestName": "前往维摩庄",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "730010601"
        ],
        "dialogs": {
          "730010601": {
            "id": "730010601",
            "speakerId": 16701,
            "speakerName": "拉娜",
            "text": "（test)这里就到了。",
            "nextDialogs": [
              "730010602"
            ]
          },
          "730010602": {
            "id": "730010602",
            "speakerId": 16701,
            "speakerName": "拉娜",
            "text": "（test)我们出发吧。"
          }
        }
      }
    },
    {
      "subId": "7300121",
      "subQuestName": "(test)【隐藏】播开车用$HIDDEN",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "730012101"
        ],
        "dialogs": {
          "730012101": {
            "id": "730012101",
            "speakerId": 20655,
            "speakerName": "耶沙法特",
            "text": "是你们啊，欢迎欢迎。有机会的话，跟拉娜和那群小老虎一起来吃饭吧。今天的收获很好。"
          }
        }
      }
    },
    {
      "subId": "7300118",
      "subQuestName": "与村中长者对话",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "730011601"
        ],
        "dialogs": {
          "730011601": {
            "id": "730011601",
            "speakerId": 16701,
            "speakerName": "拉娜",
            "text": "阿玛兹亚爷爷，我回来啦！",
            "nextDialogs": [
              "730011602"
            ]
          },
          "730011602": {
            "id": "730011602",
            "speakerId": 20644,
            "speakerName": "阿玛兹亚",
            "text": "哦哦。是拉娜啊，辛苦了。虽然巡林官的工作很重要，但是平时也要多回来嘛。",
            "nextDialogs": [
              "730011603"
            ]
          },
          "730011603": {
            "id": "730011603",
            "speakerId": 16701,
            "speakerName": "拉娜",
            "text": "嗯，知道啦。巡林也是为了让那群「小老虎」能安安全全地在外面玩嘛。现在的状况，实在是让人心里不踏实。",
            "nextDialogs": [
              "730011604"
            ]
          },
          "730011604": {
            "id": "730011604",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "…维摩庄有老虎？",
            "nextDialogs": [
              "730011605"
            ]
          },
          "730011605": {
            "id": "730011605",
            "speakerId": 20644,
            "speakerName": "阿玛兹亚",
            "text": "「小老虎」哪，指的是优丹他们那些，活泼机灵的孩子们…这么说来，是没听过的声音呢。是客人吗？",
            "nextDialogs": [
              "730011606"
            ]
          },
          "730011606": {
            "id": "730011606",
            "speakerId": 16701,
            "speakerName": "拉娜",
            "text": "啊，是这样的，阿玛兹亚爷爷，这两位是…",
            "nextDialogs": [
              "730011607"
            ]
          },
          "730011607": {
            "id": "730011607",
            "speakerId": 1004,
            "speakerName": "Black Screen",
            "text": "拉娜向阿玛兹亚介绍了之前的经历。",
            "nextDialogs": [
              "730011608"
            ]
          },
          "730011608": {
            "id": "730011608",
            "speakerId": 20644,
            "speakerName": "阿玛兹亚",
            "text": "哦哦，原来如此。两位欢迎来到维摩庄。也麻烦你们多照顾拉娜了。",
            "nextDialogs": [
              "730011609"
            ]
          },
          "730011609": {
            "id": "730011609",
            "speakerId": 16701,
            "speakerName": "拉娜",
            "text": "阿玛兹亚爷爷，我打算组织一下夜警团。叫上艾方索、巴兰和奥雷乌斯他们一起，加强村子周围的戒备。",
            "nextDialogs": [
              "730011610"
            ]
          },
          "730011610": {
            "id": "730011610",
            "speakerId": 20644,
            "speakerName": "阿玛兹亚",
            "text": "嗯，嗯。就按照你的想法去做吧，毕竟，都是为了孩子们好。",
            "nextDialogs": [
              "730011611"
            ]
          },
          "730011611": {
            "id": "730011611",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "最近维摩庄发生了什么事吗？",
            "nextDialogs": [
              "730011612"
            ]
          },
          "730011612": {
            "id": "730011612",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "欸？这么说来，会不会和我们先前看到的那种，圆圆的、看起来像植物的东西有关呢？",
            "nextDialogs": [
              "730011613"
            ]
          },
          "730011613": {
            "id": "730011613",
            "speakerId": 20644,
            "speakerName": "阿玛兹亚",
            "text": "你们在说什么呀？听小客人的描述，感觉像卷心菜。",
            "nextDialogs": [
              "730011614"
            ]
          },
          "730011614": {
            "id": "730011614",
            "speakerId": 16701,
            "speakerName": "拉娜",
            "text": "没关系啦。只是最近发生了一些事情，大家有点不安。",
            "nextDialogs": [
              "730011615"
            ]
          },
          "730011615": {
            "id": "730011615",
            "speakerId": 20644,
            "speakerName": "阿玛兹亚",
            "text": "一辈子住在维摩庄，从来没发生过这样的事情，唉…",
            "nextDialogs": [
              "730011616"
            ]
          },
          "730011616": {
            "id": "730011616",
            "speakerId": 20644,
            "speakerName": "阿玛兹亚",
            "text": "爷爷就不耽误你们时间了。两位小客人，也麻烦你们多照顾拉娜。这孩子，从小就让人不省心…",
            "nextDialogs": [
              "730011617"
            ]
          },
          "730011617": {
            "id": "730011617",
            "speakerId": 20644,
            "speakerName": "阿玛兹亚",
            "text": "七八岁的时候，有一次在林子走失了，当时两三天…",
            "nextDialogs": [
              "730011618"
            ]
          },
          "730011618": {
            "id": "730011618",
            "speakerId": 16701,
            "speakerName": "拉娜",
            "text": "喂！阿玛兹亚爷爷！",
            "nextDialogs": [
              "730011619"
            ]
          },
          "730011619": {
            "id": "730011619",
            "speakerId": 20644,
            "speakerName": "阿玛兹亚",
            "text": "好啦好啦，知道了。拉娜，你要好好承担向导的职责，不要让两位小客人失望。",
            "nextDialogs": [
              "730011620"
            ]
          },
          "730011620": {
            "id": "730011620",
            "speakerId": 16701,
            "speakerName": "拉娜",
            "text": "嗯，当然！"
          }
        }
      }
    },
    {
      "subId": "7300107",
      "subQuestName": "跟随拉娜",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "730010701"
        ],
        "dialogs": {
          "730010701": {
            "id": "730010701",
            "speakerId": 4198,
            "speakerName": "拉娜",
            "text": "我来介绍一下。这两位本领高强的旅人，之前帮了我不少忙呢。这位是艾方索，差不多是我们维摩庄最可靠的人吧！",
            "nextDialogs": [
              "730010702"
            ]
          },
          "730010702": {
            "id": "730010702",
            "speakerId": 20593,
            "speakerName": "艾方索",
            "text": "哈哈，真是的，拉娜你又在开玩笑了。总之，两位幸会。也谢谢你们照顾拉娜了。",
            "nextDialogs": [
              "730010703"
            ]
          },
          "730010703": {
            "id": "730010703",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "艾方索看起来不像本地人，也是旅人吗？",
            "nextDialogs": [
              "730010704"
            ]
          },
          "730010704": {
            "id": "730010704",
            "speakerId": 20593,
            "speakerName": "艾方索",
            "text": "哈哈哈，不愧是见多识广的旅行者，一眼就看出来了。",
            "nextDialogs": [
              "730010705"
            ]
          },
          "730010705": {
            "id": "730010705",
            "speakerId": 20593,
            "speakerName": "艾方索",
            "text": "我原本是枫丹的技师学徒。因为喜欢这里的氛围，就住下来了。",
            "nextDialogs": [
              "730010706"
            ]
          },
          "730010706": {
            "id": "730010706",
            "speakerId": 4198,
            "speakerName": "拉娜",
            "text": "一晃过去好几年了呢！现在，艾方索已经完全是我们维摩庄的壮丁了，嘿嘿。",
            "nextDialogs": [
              "730010707"
            ]
          },
          "730010707": {
            "id": "730010707",
            "speakerId": 4198,
            "speakerName": "拉娜",
            "text": "总之，孩子们的情况如何？没有乱跑吧？毕竟，最近情况不太好…",
            "nextDialogs": [
              "730010708"
            ]
          },
          "730010708": {
            "id": "730010708",
            "speakerId": 20593,
            "speakerName": "艾方索",
            "text": "现在都待在庄里，等着你回来呢。之前卡乌斯回来以后…",
            "nextDialogs": [
              "730010709"
            ]
          },
          "730010709": {
            "id": "730010709",
            "speakerId": 20593,
            "speakerName": "艾方索",
            "text": "…在客人面前，说这个没问题吗？不然我们之后再聊…",
            "nextDialogs": [
              "730010710"
            ]
          },
          "730010710": {
            "id": "730010710",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "是什么重要的事情吗？我们可以先走…",
            "nextDialogs": [
              "730010711"
            ]
          },
          "730010711": {
            "id": "730010711",
            "speakerId": 4198,
            "speakerName": "拉娜",
            "text": "哎呀，放心吧！他们可是在外边救了我一命的恩人喔！",
            "nextDialogs": [
              "730010713",
              "730010715"
            ]
          },
          "730010713": {
            "id": "730010713",
            "speakerId": 4198,
            "speakerName": "拉娜",
            "text": "时间就是生命，你们帮我节约了时间，所以确实是救命恩人！",
            "nextDialogs": [
              "730010718"
            ]
          },
          "730010718": {
            "id": "730010718",
            "speakerId": 4198,
            "speakerName": "拉娜",
            "text": "总之，维摩庄的孩子们，最近时不时地会失踪。"
          },
          "730010715": {
            "id": "730010715",
            "speakerId": 4198,
            "speakerName": "拉娜",
            "text": "真的很厉害！",
            "nextDialogs": [
              "730010716"
            ]
          },
          "730010716": {
            "id": "730010716",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "不过看拉娜战斗的架势，应该自己也能解决吧。毕竟，身为巡林官，应该会遇到很多猛兽？",
            "nextDialogs": [
              "730010717"
            ]
          },
          "730010717": {
            "id": "730010717",
            "speakerId": 4198,
            "speakerName": "拉娜",
            "text": "嗯，确实是这样。不过，时间就是生命，你们帮我节约了时间，所以确实是救命恩人！"
          }
        }
      }
    },
    {
      "subId": "7300119",
      "subQuestName": "跟随拉娜",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [],
        "dialogs": {}
      }
    },
    {
      "subId": "7300120",
      "subQuestName": "跟随拉娜",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "730012001"
        ],
        "dialogs": {
          "730012001": {
            "id": "730012001",
            "speakerId": 14313,
            "speakerName": "阿玛兹亚",
            "text": "是拉娜带来的小客人哪。之前真是抱歉，我年纪大了，眼神不好。",
            "nextDialogs": [
              "730012003",
              "730012009",
              "730012012"
            ]
          },
          "730012003": {
            "id": "730012003",
            "speakerId": 14313,
            "speakerName": "阿玛兹亚",
            "text": "就是你们之前说的，圆圆的、像植物一样的小精灵吧。以前我好像见到过，但究竟是什么时候，又是什么东西呢…",
            "nextDialogs": [
              "730012004"
            ]
          },
          "730012004": {
            "id": "730012004",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "是叫「兰那罗」吗？",
            "nextDialogs": [
              "730012005"
            ]
          },
          "730012005": {
            "id": "730012005",
            "speakerId": 14313,
            "speakerName": "阿玛兹亚",
            "text": "「兰那罗」…或许是吧。以前好像听过兰那罗的故事…但是，我年纪大了，已经记不清了。",
            "nextDialogs": [
              "730012006"
            ]
          },
          "730012006": {
            "id": "730012006",
            "speakerId": 14313,
            "speakerName": "阿玛兹亚",
            "text": "我们须弥的森林很大，里面有数不清的奇妙生灵。如果有缘分，你要找的东西，终究是不会错过的吧。",
            "nextDialogs": [
              "730012007"
            ]
          },
          "730012007": {
            "id": "730012007",
            "speakerId": 14313,
            "speakerName": "阿玛兹亚",
            "text": "不过，假使果真有缘分，见过了不应该忘记吧。究竟是什么时候呢…"
          },
          "730012009": {
            "id": "730012009",
            "speakerId": 14313,
            "speakerName": "阿玛兹亚",
            "text": "拉娜是个好孩子。为了我这把老骨头，为了维摩庄的孩子们，她每天都在努力。",
            "nextDialogs": [
              "730012010"
            ]
          },
          "730012010": {
            "id": "730012010",
            "speakerId": 14313,
            "speakerName": "阿玛兹亚",
            "text": "哈哈哈，不知道什么时候才能找个好人家安顿下来。"
          },
          "730012012": {
            "id": "730012012",
            "speakerId": 14313,
            "speakerName": "阿玛兹亚",
            "text": "嗯，再见。"
          }
        }
      }
    },
    {
      "subId": "7300108",
      "subQuestName": "与男子对话",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [],
        "dialogs": {}
      }
    },
    {
      "subId": "7300109",
      "subQuestName": "追随孩子们，前往拉娜的家",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "730010901"
        ],
        "dialogs": {
          "730010901": {
            "id": "730010901",
            "speakerId": 20594,
            "speakerName": "优丹",
            "text": "我想听龙的故事！艾方索哥哥以前跟我说过，世界上是有龙的！他说，在叫「蒙德」的地方，就有一个好大好坏的龙！",
            "nextDialogs": [
              "730010903"
            ]
          },
          "730010903": {
            "id": "730010903",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "嗯，我们知道这个故事哦！",
            "nextDialogs": [
              "730010905"
            ]
          },
          "730010905": {
            "id": "730010905",
            "speakerId": 20594,
            "speakerName": "优丹",
            "text": "哇！龙是什么样的呢？艾方索哥哥说，龙很可怕，还攻击蒙德！",
            "nextDialogs": [
              "730010906"
            ]
          },
          "730010906": {
            "id": "730010906",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "嗯…这个故事，要怎么说才好呢？"
          }
        }
      }
    },
    {
      "subId": "7300116",
      "subQuestName": "(test)跟上优丹$HIDDEN",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [],
        "dialogs": {}
      }
    },
    {
      "subId": "7300117",
      "subQuestName": "(test)跟上优丹$HIDDEN",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "730011701"
        ],
        "dialogs": {
          "730011701": {
            "id": "730011701",
            "speakerId": 16701,
            "speakerName": "拉娜",
            "text": "啊呀，怎么才这么几天，这里就出现了新的「死域」…而且还在这么靠近大路的地方…",
            "nextDialogs": [
              "730011702"
            ]
          },
          "730011702": {
            "id": "730011702",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "「死域」？",
            "nextDialogs": [
              "730011703"
            ]
          },
          "730011703": {
            "id": "730011703",
            "speakerId": 16701,
            "speakerName": "拉娜",
            "text": "啊，应该说是我们须弥特有的「灾害」吧。会自发地出现，夺走其中的生命力。",
            "nextDialogs": [
              "730011704"
            ]
          },
          "730011704": {
            "id": "730011704",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "真的，里面的植物，都失去了生机…",
            "nextDialogs": [
              "730011705"
            ]
          },
          "730011705": {
            "id": "730011705",
            "speakerId": 16701,
            "speakerName": "拉娜",
            "text": "嗯。如果提纳里前辈在，应该可以顺利消除死域。不过，像我这样没有神之眼、不能操控元素的人进入死域的话，会非常危险。",
            "nextDialogs": [
              "730011706"
            ]
          },
          "730011706": {
            "id": "730011706",
            "speakerId": 16701,
            "speakerName": "拉娜",
            "text": "无论如何，暂时先记下死域的位置与影响半径吧。把你们带到维摩庄，我就去化城郭向前辈报告，请他来帮忙。",
            "nextDialogs": [
              "730011708",
              "730011711"
            ]
          },
          "730011708": {
            "id": "730011708",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "#不过，{NICKNAME}不是能驾驭元素的力量吗？像是什么…对了，「随风而去吧！」",
            "nextDialogs": [
              "730011709"
            ]
          },
          "730011709": {
            "id": "730011709",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "既然能驱使元素的力量，应该也能帮上忙吧！",
            "nextDialogs": [
              "730011714"
            ]
          },
          "730011714": {
            "id": "730011714",
            "speakerId": 16701,
            "speakerName": "拉娜",
            "text": "#欸？这么说来，之前{NICKNAME}帮忙击退蕈兽的时候，确实有这么一回事…",
            "nextDialogs": [
              "730011715"
            ]
          },
          "730011715": {
            "id": "730011715",
            "speakerId": 16701,
            "speakerName": "拉娜",
            "text": "不过，还是不应该这么做。死域真的会危及生命。就算是经验老到的巡林官，也不会轻易接近死域…",
            "nextDialogs": [
              "730011716"
            ]
          },
          "730011716": {
            "id": "730011716",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "#虽然这么说，不过{NICKNAME}真的很可靠！我们在旅行的过程中，遇到过许多事情…"
          },
          "730011711": {
            "id": "730011711",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "#不过，{NICKNAME}不是能驾驭元素的力量吗？像是什么…对了，「随风而去吧！」",
            "nextDialogs": [
              "730011712"
            ]
          },
          "730011712": {
            "id": "730011712",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "我们也帮帮忙吧！"
          }
        }
      }
    },
    {
      "subId": "7300110",
      "subQuestName": "追随孩子们，前往拉娜的家",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "730010801"
        ],
        "dialogs": {
          "730010801": {
            "id": "730010801",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "这些小家伙，跑得比飞的都快…",
            "nextDialogs": [
              "730010802"
            ]
          },
          "730010802": {
            "id": "730010802",
            "speakerId": 4198,
            "speakerName": "拉娜",
            "text": "嘿咻。你们啊，越来越能跑了。真是的，以后你们要是跑掉了就伤脑筋喽。",
            "nextDialogs": [
              "730010803"
            ]
          },
          "730010803": {
            "id": "730010803",
            "speakerId": 20594,
            "speakerName": "优丹",
            "text": "拉娜姐姐在这里，我们不会跑掉的！",
            "nextDialogs": [
              "730010804"
            ]
          },
          "730010804": {
            "id": "730010804",
            "speakerId": 20595,
            "speakerName": "素达蓓",
            "text": "等素达蓓长大了，要和拉娜姐姐结婚！",
            "nextDialogs": [
              "730010805"
            ]
          },
          "730010805": {
            "id": "730010805",
            "speakerId": 20596,
            "speakerName": "卡乌斯",
            "text": "哇，不是说好了要和哥哥结婚吗？骗子！",
            "nextDialogs": [
              "730010806"
            ]
          },
          "730010806": {
            "id": "730010806",
            "speakerId": 4198,
            "speakerName": "拉娜",
            "text": "哈哈哈哈，这些东西以后再说吧。等你们长大了，会遇到很多不同的人喔！会有很多比拉娜姐姐更厉害、更好的人。",
            "nextDialogs": [
              "730010807"
            ]
          },
          "730010807": {
            "id": "730010807",
            "speakerId": 4198,
            "speakerName": "拉娜",
            "text": "#这个金发的{M#哥哥}{F#姐姐}就比拉娜姐姐厉害，是从很远的地方来的。在旅途中，也遇到了很多好人，对吧？",
            "nextDialogs": [
              "730010812",
              "730010811"
            ]
          },
          "730010812": {
            "id": "730010812",
            "speakerId": 20596,
            "speakerName": "卡乌斯",
            "text": "#{M#大哥哥}{F#大姐姐}，旅行了很长很长时间吗？",
            "nextDialogs": [
              "730010813"
            ]
          },
          "730010813": {
            "id": "730010813",
            "speakerId": 20595,
            "speakerName": "素达蓓",
            "text": "拉娜姐姐说，你给我们说故事！"
          },
          "730010811": {
            "id": "730010811",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "嘿嘿。"
          }
        }
      }
    },
    {
      "subId": "7300111",
      "subQuestName": "和孩子们对话",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [],
        "dialogs": {}
      }
    },
    {
      "subId": "7300112",
      "subQuestName": "和孩子们对话",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "730011001"
        ],
        "dialogs": {
          "730011001": {
            "id": "730011001",
            "speakerId": 20596,
            "speakerName": "卡乌斯",
            "text": "我想听大海怪的故事！他们说，在海里有好多好大好奇怪的怪物…",
            "nextDialogs": [
              "730011002"
            ]
          },
          "730011002": {
            "id": "730011002",
            "speakerId": 20596,
            "speakerName": "卡乌斯",
            "text": "像是，有一个岛那么大的鱼、像是有一条河那么长的大乌贼，还有那个，木头人和大鲸鱼的故事！还有背上站着大象的大乌龟！",
            "nextDialogs": [
              "730011003"
            ]
          },
          "730011003": {
            "id": "730011003",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "卡乌斯听过的故事真多呢！为什么对大海怪这么感兴趣呀？",
            "nextDialogs": [
              "730011004"
            ]
          },
          "730011004": {
            "id": "730011004",
            "speakerId": 20596,
            "speakerName": "卡乌斯",
            "text": "等我长大了，我要当大航海家，七次出航，去发现没人发现过的岛、大陆！所以，我要听大海怪的故事，以后去打败它们！",
            "nextDialogs": [
              "730011007"
            ]
          },
          "730011007": {
            "id": "730011007",
            "speakerId": 20596,
            "speakerName": "卡乌斯",
            "text": "哇！好厉害！他们发现了什么宝藏吗？有没有什么冒险故事？",
            "nextDialogs": [
              "730011008"
            ]
          },
          "730011008": {
            "id": "730011008",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "不清楚，不过，大海怪的话，之前倒是有这样的故事…",
            "nextDialogs": [
              "730011009"
            ]
          },
          "730011009": {
            "id": "730011009",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "咳咳！好久好久以前，在海里，有一个有好多个头的巨大水蛇！大水蛇要是把脖子伸长了，比山还高…",
            "nextDialogs": [
              "730011010"
            ]
          },
          "730011010": {
            "id": "730011010",
            "speakerId": 1004,
            "speakerName": "Black Screen",
            "text": "「大水蛇很坏，所以神用石头把它压在海底，让它不要掀起海浪，破坏港口。」\\n「过了好久好久，它从海里醒来，说：『可恶的神、可恶的小人！气死我了！』」\\n「『我要把你们、你们的房子，还有你们的金银财宝全部冲到海里，变成我的东西！』它说，并且补充道：『嗷嗷！』」\\n「然后它就抬起头来，变得比山还高，让大海像沸水一样翻腾…」",
            "nextDialogs": [
              "730011011"
            ]
          },
          "730011011": {
            "id": "730011011",
            "speakerId": 1004,
            "speakerName": "Black Screen",
            "text": "以小孩子也不会失去兴趣的方式，讲述了人们在飞天的城堡里，团结一心与多首水蛇进行战斗的故事。",
            "nextDialogs": [
              "730011012"
            ]
          },
          "730011012": {
            "id": "730011012",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "…就这样，大家齐心协力一起打败了大水蛇，保护了城市！",
            "nextDialogs": [
              "730011013"
            ]
          },
          "730011013": {
            "id": "730011013",
            "speakerId": 20596,
            "speakerName": "卡乌斯",
            "text": "欸，原来大水蛇已经被打败了呀，真没劲。本来，我还想长大以后，自己去打败它呢！"
          }
        }
      }
    },
    {
      "subId": "7300113",
      "subQuestName": "和孩子们对话",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "730011101"
        ],
        "dialogs": {
          "730011101": {
            "id": "730011101",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "素达蓓，你想听什么样的故事呢？",
            "nextDialogs": [
              "730011102"
            ]
          },
          "730011102": {
            "id": "730011102",
            "speakerId": 20595,
            "speakerName": "素达蓓",
            "text": "什么样的故事都可以！不过，素达蓓想要故事里有很聪明、很厉害的大姐姐。或者，不是大姐姐也行。但是，要有决心和爱。",
            "nextDialogs": [
              "730011103"
            ]
          },
          "730011103": {
            "id": "730011103",
            "speakerId": 20595,
            "speakerName": "素达蓓",
            "text": "就像故事里的辛娜梦公主，和老虎一起离开了宫殿！",
            "nextDialogs": [
              "730011104"
            ]
          },
          "730011104": {
            "id": "730011104",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "要求好多…",
            "nextDialogs": [
              "730011105"
            ]
          },
          "730011105": {
            "id": "730011105",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "嗯…倒是有这么一些大姐姐，不过都和雷元素有关…",
            "nextDialogs": [
              "730011106"
            ]
          },
          "730011106": {
            "id": "730011106",
            "speakerId": 20595,
            "speakerName": "素达蓓",
            "text": "雷元素好，能让植物生长得更加茁壮，让果实更加饱满。",
            "nextDialogs": [
              "730011107"
            ]
          },
          "730011107": {
            "id": "730011107",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "素达蓓懂得真多！故事应该怎么开头呢…",
            "nextDialogs": [
              "730011109"
            ]
          },
          "730011109": {
            "id": "730011109",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "丽莎小姐的故事也可以啦，不过我想说的是另一个…",
            "nextDialogs": [
              "730011110"
            ]
          },
          "730011110": {
            "id": "730011110",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "咳咳！在很遥远很遥远，在大海的另一边，有一个将军大姐姐，和巫女大姐姐。",
            "nextDialogs": [
              "730011112"
            ]
          },
          "730011112": {
            "id": "730011112",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "啊——对了，巫女就是祭司，将军就是女王，这样说素达蓓应该比较好理解吧？",
            "nextDialogs": [
              "730011113"
            ]
          },
          "730011113": {
            "id": "730011113",
            "speakerId": 20595,
            "speakerName": "素达蓓",
            "text": "都是大姐姐吗？",
            "nextDialogs": [
              "730011114"
            ]
          },
          "730011114": {
            "id": "730011114",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "嗯，都是大姐姐！",
            "nextDialogs": [
              "730011115"
            ]
          },
          "730011115": {
            "id": "730011115",
            "speakerId": 1004,
            "speakerName": "Black Screen",
            "text": "「好久好久以前，在很远很远的王国里有一个又漂亮、又厉害的女王。但是，后来发生了战争，女王虽然赢了，但是失去了很多朋友。」\\n「『呜呜，』她太伤心啦，说，『我要做一个机器人，帮我工作。然后，我要一辈子住在王宫里，再也不交朋友，这样就不会失去朋友。呜呜。』」\\n「『哔哔，我知道了。开始工作。』机器人说，于是替女王治理王国。结果，有一些坏人开始蠢蠢欲动，要干坏事！」",
            "nextDialogs": [
              "730011116"
            ]
          },
          "730011116": {
            "id": "730011116",
            "speakerId": 20595,
            "speakerName": "素达蓓",
            "text": "等等，祭司大姐姐呢？",
            "nextDialogs": [
              "730011117"
            ]
          },
          "730011117": {
            "id": "730011117",
            "speakerId": 1004,
            "speakerName": "Black Screen",
            "text": "#「咳咳，话说回来，女王还有一个又漂亮，又厉害的祭司朋友，她不忍心看到朋友一直关在宫殿里。」\\n「这时候，旅人来到了这个王国。{M#他}{F#她}和{M#他}{F#她}的同伴既聪明、又勇敢。」\\n「祭司心想：『叮叮叮，这些旅人身手矫健、意志坚强。如果有他们的帮助的话…』」",
            "nextDialogs": [
              "730011118"
            ]
          },
          "730011118": {
            "id": "730011118",
            "speakerId": 1004,
            "speakerName": "Black Screen",
            "text": "以小孩子也不会失去兴趣的方式，讲述了女王与祭司（两人都是大姐姐）的故事。",
            "nextDialogs": [
              "730011119"
            ]
          },
          "730011119": {
            "id": "730011119",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "…总之，到了最后，孤独的机器人还在努力工作就是了。但是，那就是另一个故事了。",
            "nextDialogs": [
              "730011120"
            ]
          },
          "730011120": {
            "id": "730011120",
            "speakerId": 20595,
            "speakerName": "素达蓓",
            "text": "#大家都好厉害！那个旅人{M#哥哥}{F#姐姐}虽然不是大姐姐，但也好厉害。素达蓓长大了也要变成这样的人。",
            "nextDialogs": [
              "730011121"
            ]
          },
          "730011121": {
            "id": "730011121",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "没问题的，一定能行！但是，如果不好好听话，在外面乱跑，走丢了的话，就不能变成厉害的大姐姐了哦。"
          }
        }
      }
    },
    {
      "subId": "7300114",
      "subQuestName": "(test)(隐藏)拉妮家对话2$HIDDEN",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "730011201"
        ],
        "dialogs": {
          "730011201": {
            "id": "730011201",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "唉，这些孩子，看上去应该知道我们要问的神秘生物是什么，就是不愿意说…",
            "nextDialogs": [
              "730011203",
              "730011205"
            ]
          },
          "730011203": {
            "id": "730011203",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "真是的，又不是对付什么坏蛋，别想这些！就当做是小孩子之间不愿意让大人知道的秘密吧。",
            "nextDialogs": [
              "730011207"
            ]
          },
          "730011207": {
            "id": "730011207",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "我们在须弥应该会待上一段时间，之后慢慢探索吧！",
            "nextDialogs": [
              "730011208"
            ]
          },
          "730011208": {
            "id": "730011208",
            "speakerId": 4198,
            "speakerName": "拉娜",
            "text": "我回来啦！怎么样？你们玩得开心吗？",
            "nextDialogs": [
              "730011209"
            ]
          },
          "730011209": {
            "id": "730011209",
            "speakerId": 20594,
            "speakerName": "优丹",
            "text": "#开心！{M#哥哥姐姐}{F#两个姐姐}跟我们讲了故事！拉娜姐姐，巨龙原来是不会吃人的！",
            "nextDialogs": [
              "730011210"
            ]
          },
          "730011210": {
            "id": "730011210",
            "speakerId": 4198,
            "speakerName": "拉娜",
            "text": "哎呀，是这样吗？那就好，拉娜姐姐还怕哪天啊，有头龙飞过来，嗷的一下把你们都吃掉喽！",
            "nextDialogs": [
              "730011211"
            ]
          },
          "730011211": {
            "id": "730011211",
            "speakerId": 1009,
            "speakerName": "孩子们",
            "text": "哇！",
            "nextDialogs": [
              "730011212"
            ]
          },
          "730011212": {
            "id": "730011212",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "讲故事挺开心的呢！"
          },
          "730011205": {
            "id": "730011205",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "真是的，又不是对付什么坏蛋，别想这些！就当做是小孩子之间不愿意让大人知道的秘密吧。"
          }
        }
      }
    },

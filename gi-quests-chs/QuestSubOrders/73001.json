            ]
          },
          "730012603": {
            "id": "730012603",
            "speakerId": 20593,
            "speakerName": "艾方索",
            "text": "…刚刚拉娜有介绍过吧。不管怎么说，希望你在维摩庄的时间过得愉快。"
          }

    {
      "subId": "7221503",
      "subQuestName": "向寝子回报",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "722150301"
        ],
        "dialogs": {
          "722150301": {
            "id": "722150301",
            "speakerId": 1000,
            "speakerName": "「寝子」",
            "text": "都挂上去了吗？",
            "nextDialogs": [
              "722150302"
            ]
          },
          "722150302": {
            "id": "722150302",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "都挂好了。",
            "nextDialogs": [
              "722150303"
            ]
          },
          "722150303": {
            "id": "722150303",
            "speakerId": 1000,
            "speakerName": "「寝子」",
            "text": "喵喵，太好了，这样子神社就会热闹一些了。",
            "nextDialogs": [
              "722150304"
            ]
          },
          "722150304": {
            "id": "722150304",
            "speakerId": 1000,
            "speakerName": "「寝子」",
            "text": "……",
            "nextDialogs": [
              "722150305"
            ]
          },
          "722150305": {
            "id": "722150305",
            "speakerId": 1000,
            "speakerName": "「寝子」",
            "text": "咦？怎么还没有好多好多人类来？",
            "nextDialogs": [
              "722150308"
            ]
          },
          "722150308": {
            "id": "722150308",
            "speakerId": 1000,
            "speakerName": "「寝子」",
            "text": "哎，人类好难懂啊。当然，汝不一样，汝很有悟性。",
            "nextDialogs": [
              "722150309"
            ]
          },
          "722150309": {
            "id": "722150309",
            "speakerId": 1000,
            "speakerName": "「寝子」",
            "text": "虽然暂时还没人…但有了铁球的叮当声，至少那些小家伙就不会迷路了，喵喵。",
            "nextDialogs": [
              "722150310"
            ]
          },
          "722150310": {
            "id": "722150310",
            "speakerId": 1000,
            "speakerName": "「寝子」",
            "text": "那个石头人类说，石头奴家很快就能好，一定要来。",
            "nextDialogs": [
              "722150311"
            ]
          },
          "722150311": {
            "id": "722150311",
            "speakerId": 1000,
            "speakerName": "「寝子」",
            "text": "啊，对了。还有件怪事。",
            "nextDialogs": [
              "722150312"
            ]
          },
          "722150312": {
            "id": "722150312",
            "speakerId": 1000,
            "speakerName": "「寝子」",
            "text": "奴家去问了那两个绿绿的人类，阿响和百目鬼的事情。",
            "nextDialogs": [
              "722150313"
            ]
          },
          "722150313": {
            "id": "722150313",
            "speakerId": 1000,
            "speakerName": "「寝子」",
            "text": "但那两个绿绿的人类，都说不认识阿响，也不记得和阿响有关的事。",
            "nextDialogs": [
              "722150314"
            ]
          },
          "722150314": {
            "id": "722150314",
            "speakerId": 1000,
            "speakerName": "「寝子」",
            "text": "但高高的绿绿的人类说，他读到过「赤穗百目鬼」的事。",
            "nextDialogs": [
              "722150315"
            ]
          },
          "722150315": {
            "id": "722150315",
            "speakerId": 1000,
            "speakerName": "「寝子」",
            "text": "不过他说什么…「贼」、什么「讨伐」来着…意思好像说，百目鬼是个坏人。",
            "nextDialogs": [
              "722150316"
            ]
          },
          "722150316": {
            "id": "722150316",
            "speakerId": 1000,
            "speakerName": "「寝子」",
            "text": "肯定是弄错了。阿响和他经常在一起玩。所以，百目鬼也是很好的人。",
            "nextDialogs": [
              "722150317"
            ]
          },
          "722150317": {
            "id": "722150317",
            "speakerId": 1000,
            "speakerName": "「寝子」",
            "text": "一定是那个人类悟性不行。归根到底，还是汝比较可靠哪。",
            "nextDialogs": [
              "722150318"
            ]
          },
          "722150318": {
            "id": "722150318",
            "speakerId": 1000,
            "speakerName": "「寝子」",
            "text": "阿响…到底什么时候才会回来呢…"
          }
        }
      }
    }
  ]
}
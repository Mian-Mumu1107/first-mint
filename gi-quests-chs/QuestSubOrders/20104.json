  "subQuests": [
    {
      "subId": "2010401",
      "subQuestName": "与摩可和海莉对话",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "201040101"
        ],
        "dialogs": {
          "201040101": {
            "id": "201040101",
            "speakerId": 1000,
            "speakerName": "摩可",
            "text": "怎么办…",
            "nextDialogs": [
              "201040102"
            ]
          },
          "201040102": {
            "id": "201040102",
            "speakerId": 1001,
            "speakerName": "海莉",
            "text": "又要挨女仆长骂了…",
            "nextDialogs": [
              "201040103"
            ]
          },
          "201040103": {
            "id": "201040103",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "怎么了？",
            "nextDialogs": [
              "201040104"
            ]
          },
          "201040104": {
            "id": "201040104",
            "speakerId": 1000,
            "speakerName": "摩可",
            "text": "爱德琳小姐本来是让我们打扫酒庄的外围…",
            "nextDialogs": [
              "201040105"
            ]
          },
          "201040105": {
            "id": "201040105",
            "speakerId": 1001,
            "speakerName": "海莉",
            "text": "其他的地方还好，但是，周围还有很多堆起来的草垛。",
            "nextDialogs": [
              "201040106"
            ]
          },
          "201040106": {
            "id": "201040106",
            "speakerId": 1000,
            "speakerName": "摩可",
            "text": "这些是康纳先生特意堆在这，说是有用处的…",
            "nextDialogs": [
              "201040107"
            ]
          },
          "201040107": {
            "id": "201040107",
            "speakerId": 1001,
            "speakerName": "海莉",
            "text": "虽然因为捆得很牢，暴风的时候这些草垛没有被吹走，但是，有很多落叶被吹到了草垛里面…",
            "nextDialogs": [
              "201040108"
            ]
          },
          "201040108": {
            "id": "201040108",
            "speakerId": 1000,
            "speakerName": "摩可",
            "text": "我们费了好大的劲，也没有把落叶从草垛里清理干净。",
            "nextDialogs": [
              "201040109"
            ]
          },
          "201040109": {
            "id": "201040109",
            "speakerId": 1001,
            "speakerName": "海莉",
            "text": "再这么耗下去，女仆长非得骂我们不可，这可怎么办啊…",
            "nextDialogs": [
              "201040111",
              "201040113"
            ]
          },
          "201040111": {
            "id": "201040111",
            "speakerId": 1000,
            "speakerName": "摩可",
            "text": "咦？可以交给你吗！太好了，那就拜托你了！"
          },
          "201040113": {
            "id": "201040113",
            "speakerId": 1001,
            "speakerName": "海莉",
            "text": "落叶和草垛都搅一起了，我们只能用手慢慢地分开，实在是太慢了…",
            "nextDialogs": [
              "201040114"
            ]
          },
          "201040114": {
            "id": "201040114",
            "speakerId": 1001,
            "speakerName": "海莉",
            "text": "如果你有什么好办法，就请帮帮我们吧。"
          }
        }
      }
    },
    {
      "subId": "2010402",
      "subQuestName": "扫清落叶堆",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "201040201"
        ],
        "dialogs": {
          "201040201": {
            "id": "201040201",
            "speakerId": 1000,
            "speakerName": "摩可",
            "text": "怎么样？",
            "nextDialogs": [
              "201040202"
            ]
          },
          "201040202": {
            "id": "201040202",
            "speakerId": 1001,
            "speakerName": "海莉",
            "text": "打扫干净了吗？",
            "nextDialogs": [
              "201040203"
            ]
          },
          "201040203": {
            "id": "201040203",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "已经打扫干净了。",
            "nextDialogs": [
              "201040204"
            ]
          },
          "201040204": {
            "id": "201040204",
            "speakerId": 1000,
            "speakerName": "摩可",
            "text": "太厉害了！",
            "nextDialogs": [
              "201040205"
            ]
          },
          "201040205": {
            "id": "201040205",
            "speakerId": 1001,
            "speakerName": "海莉",
            "text": "不愧是旅行者！",
            "nextDialogs": [
              "201040206"
            ]
          },
          "201040206": {
            "id": "201040206",
            "speakerId": 1000,
            "speakerName": "摩可",
            "text": "这样就不用被女仆长骂了，谢谢你。",
            "nextDialogs": [
              "201040207"
            ]
          },
          "201040207": {
            "id": "201040207",
            "speakerId": 1001,
            "speakerName": "海莉",
            "text": "这些请收下，就算是谢礼吧。",
            "nextDialogs": [
              "201040208"
            ]
          },
          "201040208": {
            "id": "201040208",
            "speakerId": 1000,
            "speakerName": "摩可",
            "text": "我们得赶紧打扫别的地方去了…再次谢谢你帮忙！"
          }
        }
      }
    },
    {
      "subId": "2010403",
      "subQuestName": "(test)判断烧掉草垛$HIDDEN",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "201040301"
        ],
        "dialogs": {
          "201040301": {
            "id": "201040301",
            "speakerId": 1000,
            "speakerName": "摩可",
            "text": "你，你做什么呀，怎么把整个草垛都烧掉了！",
            "nextDialogs": [
              "201040302"
            ]
          },
          "201040302": {
            "id": "201040302",
            "speakerId": 1001,
            "speakerName": "海莉",
            "text": "这回不是被骂就能了事了，一定会被开除…",
            "nextDialogs": [
              "201040303"
            ]
          },
          "201040303": {
            "id": "201040303",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "一不小心就…",
            "nextDialogs": [
              "201040304"
            ]
          },
          "201040304": {
            "id": "201040304",
            "speakerId": 1000,
            "speakerName": "摩可",
            "text": "早知道，我们还不如慢慢地一点点把落叶挑出来了…",
            "nextDialogs": [
              "201040305"
            ]
          },
          "201040305": {
            "id": "201040305",
            "speakerId": 1001,
            "speakerName": "海莉",
            "text": "完了…这下子全完了…",
            "nextDialogs": [
              "201040306"
            ]
          },
          "201040306": {
            "id": "201040306",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "那个…",
            "nextDialogs": [
              "201040307"
            ]
          },
          "201040307": {
            "id": "201040307",
            "speakerId": 1000,
            "speakerName": "摩可",
            "text": "旅行者，请你快点离开吧，这件事是我们的责任…",
            "nextDialogs": [
              "201040308"
            ]
          },
          "201040308": {
            "id": "201040308",
            "speakerId": 1001,
            "speakerName": "海莉",
            "text": "我们不该让不懂得打扫方法的人来帮忙，是我们错了…",
            "nextDialogs": [
              "201040309"
            ]
          },
          "201040309": {
            "id": "201040309",
            "speakerId": 1000,
            "speakerName": "摩可",
            "text": "女仆长会怎么处置我们呢…",
            "nextDialogs": [
              "201040310"
            ]
          },
          "201040310": {
            "id": "201040310",
            "speakerId": 1001,
            "speakerName": "海莉",
            "text": "这下子，全都完了…"
          }
        }
      }
    },

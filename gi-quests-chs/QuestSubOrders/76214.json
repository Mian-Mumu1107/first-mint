        ],
        "dialogs": {
          "762140401": {
            "id": "762140401",
            "speakerId": 1000,
            "speakerName": "「灰猫先生」",
            "text": "#喵喵！这样一来，大家就到齐了喵！感谢黄金的旅人{M#先生}{F#小姐}，开心的茶会终于可以开始了喵！",
            "nextDialogs": [
              "762140402"
            ]
          },
          "762140402": {
            "id": "762140402",
            "speakerId": 1001,
            "speakerName": "「橘猫小姐」",
            "text": "……",
            "nextDialogs": [
              "762140403"
            ]
          },
          "762140403": {
            "id": "762140403",
            "speakerId": 1004,
            "speakerName": "「淑女犬小姐」",
            "text": "呵呵，不要总是苦着脸嘛，橘猫小姐。喝些甜甜的东西，心情自然也会好起来喔？"
          }
        }
      }

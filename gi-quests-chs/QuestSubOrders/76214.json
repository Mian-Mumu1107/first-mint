        ],
        "dialogs": {
          "762140601": {
            "id": "762140601",
            "speakerId": 1000,
            "speakerName": "「灰猫先生」",
            "text": "原本约定的碰面地点是这里…但是我的朋友们都没有来喵。",
            "nextDialogs": [
              "762140602"
            ]
          },
          "762140602": {
            "id": "762140602",
            "speakerId": 1000,
            "speakerName": "「灰猫先生」",
            "text": "#被选中的勇者{M#先生}{F#小姐}，可以请您在这附近帮忙找找她们吗？"
          }
        }
      }
    },

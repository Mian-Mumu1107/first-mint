  "subQuests": [
    {
      "subId": "7621401",
      "subQuestName": "(test)隐藏$HIDDEN",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "762140101"
        ],
        "dialogs": {
          "762140101": {
            "id": "762140101",
            "speakerId": 1000,
            "speakerName": "「灰猫先生」",
            "text": "喵呜…已经是茶会的时间了喵，她们会不会迷路了喵…",
            "nextDialogs": [
              "762140102"
            ]
          },
          "762140102": {
            "id": "762140102",
            "speakerId": 1000,
            "speakerName": "「灰猫先生」",
            "text": "#啊，黄金的旅人{M#先生}{F#小姐}，您一定是被选中的勇者喵！能请您帮我找找看我的两位朋友吗？",
            "nextDialogs": [
              "762140106",
              "762140105"
            ]
          },
          "762140106": {
            "id": "762140106",
            "speakerId": 1000,
            "speakerName": "「灰猫先生」",
            "text": "还没有到场的两位小姐，一位是和我一样、会说话的猫，不过是橘色的喵。",
            "nextDialogs": [
              "762140107"
            ]
          },
          "762140107": {
            "id": "762140107",
            "speakerId": 1000,
            "speakerName": "「灰猫先生」",
            "text": "另一位则是很有礼貌的淑女犬，虽然是犬类，但是很温柔喵。",
            "nextDialogs": [
              "762140108"
            ]
          },
          "762140108": {
            "id": "762140108",
            "speakerId": 1000,
            "speakerName": "「灰猫先生」",
            "text": "就算一方是猫，一方是狗，只要能坐在一起喝茶，大家就一定会很开心喵！",
            "nextDialogs": [
              "762140109"
            ]
          },
          "762140109": {
            "id": "762140109",
            "speakerId": 1000,
            "speakerName": "「灰猫先生」",
            "text": "为了喵呜兰诺珀里斯的和平，请您帮帮我喵！"
          },
          "762140105": {
            "id": "762140105",
            "speakerId": 1000,
            "speakerName": "「灰猫先生」",
            "text": "不要在意那种细节喵。就算没有传说中的圣剑，就算没有找到传说中的纯水之杯，勇者也是勇者喵。"
          }
        }
      }
    },
    {
      "subId": "7621406",
      "subQuestName": "(test)隐藏$HIDDEN",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [

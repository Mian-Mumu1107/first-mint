    {
      "subId": "7621402",
      "subQuestName": "(test)隐藏$HIDDEN",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "762140201"
        ],
        "dialogs": {
          "762140201": {
            "id": "762140201",
            "speakerId": 1001,
            "speakerName": "「橘猫小姐」",
            "text": "…喵。你的剑技…令猫印象深刻。",
            "nextDialogs": [
              "762140209"
            ]
          },
          "762140209": {
            "id": "762140209",
            "speakerId": 1001,
            "speakerName": "「橘猫小姐」",
            "text": "感谢你，可敬的异邦骑士。那些高傲而强大的凶恶之徒不会再侵扰我子民的家园了。",
            "nextDialogs": [
              "762140210"
            ]
          },
          "762140210": {
            "id": "762140210",
            "speakerId": 1001,
            "speakerName": "「橘猫小姐」",
            "text": "那么，请说吧。阁下为何来到我的王庭？",
            "nextDialogs": [
              "762140203",
              "762140205"
            ]
          },
          "762140203": {
            "id": "762140203",
            "speakerId": 1002,
            "speakerName": "派蒙",
            "text": "呃…既然是童话，那这个应该也是设定的一部分吧？",
            "nextDialogs": [
              "762140206"
            ]
          },
          "762140206": {
            "id": "762140206",
            "speakerId": 1003,
            "speakerName": "Black Screen",
            "text": "向橘猫小姐转达了灰猫先生的茶会邀请…",
            "nextDialogs": [
              "762140207"
            ]
          },
          "762140207": {
            "id": "762140207",
            "speakerId": 1001,
            "speakerName": "「橘猫小姐」",
            "text": "……",
            "nextDialogs": [
              "762140208"
            ]
          },
          "762140208": {
            "id": "762140208",
            "speakerId": 1001,
            "speakerName": "「橘猫小姐」",
            "text": "…我知道了。谢谢你，可敬的异邦骑士。那么，我便听从你的良言，动身前往吧。"
          },
          "762140205": {
            "id": "762140205",
            "speakerId": 1002,
            "speakerName": "派蒙",
            "text": "入戏好快！咳咳，既然是设定的一部分…"
          }
        }
      }
    },
    {
      "subId": "7621403",
      "subQuestName": "(test)隐藏$HIDDEN",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "762140301"
        ],
        "dialogs": {
          "762140301": {
            "id": "762140301",
            "speakerId": 1004,
            "speakerName": "「淑女犬小姐」",
            "text": "#呜汪？怎么了，黄金的旅人{M#先生}{F#小姐}？有什么我可以帮您做的事吗？",
            "nextDialogs": [
              "762140302"
            ]
          },
          "762140302": {
            "id": "762140302",
            "speakerId": 1003,
            "speakerName": "Black Screen",
            "text": "向淑女犬小姐转达了灰猫先生的茶会邀请…",
            "nextDialogs": [
              "762140303"
            ]
          },
          "762140303": {
            "id": "762140303",
            "speakerId": 1004,
            "speakerName": "「淑女犬小姐」",
            "text": "欸？原来已经到这个时间了吗？！",
            "nextDialogs": [
              "762140304"
            ]
          },
          "762140304": {
            "id": "762140304",
            "speakerId": 1004,
            "speakerName": "「淑女犬小姐」",
            "text": "谢谢您！呜汪，要不是太忙，我就亲自去邀请橘猫小姐了…那样的话，灰猫先生说不定也不会…",
            "nextDialogs": [
              "762140305"
            ]
          },
          "762140305": {
            "id": "762140305",
            "speakerId": 1004,
            "speakerName": "「淑女犬小姐」",
            "text": "无论是猫还是狗，大家都是可以和平共处的…一定可以的。总之，我现在就去参加茶会啦，谢谢您提醒！"
          }
        }
      }
    },
    {
      "subId": "7621404",
      "subQuestName": "(test)隐藏$HIDDEN",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [

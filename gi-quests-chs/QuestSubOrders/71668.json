{
  "lineCounts": {
    "Player": 4,
    "拉米雅": 6,
    "振尘": 25
  },
  "subQuests": [
    {
      "subId": "7166801",
      "subQuestName": "和「飞云商会」的工作人员对话",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "716680101"
        ],
        "dialogs": {
          "716680101": {
            "id": "716680101",
            "speakerId": 30673,
            "speakerName": "振尘",
            "text": "欢迎大家加入「伴爪同行」动物救助会…",
            "nextDialogs": [
              "716680102"
            ]
          },
          "716680102": {
            "id": "716680102",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "你好。",
            "nextDialogs": [
              "716680104"
            ]
          },
          "716680104": {
            "id": "716680104",
            "speakerId": 30673,
            "speakerName": "振尘",
            "text": "#是{NICKNAME}啊，你好你好。",
            "nextDialogs": [
              "716680105"
            ]
          },
          "716680105": {
            "id": "716680105",
            "speakerId": 30673,
            "speakerName": "振尘",
            "text": "我们商会正在办活动，有没有兴趣来看看？",
            "nextDialogs": [
              "716680106"
            ]
          },
          "716680106": {
            "id": "716680106",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "是什么样的活动？",
            "nextDialogs": [
              "716680107"
            ]
          },
          "716680107": {
            "id": "716680107",
            "speakerId": 30673,
            "speakerName": "振尘",
            "text": "简单来说，是加入飞云商会资助的「伴爪同行」动物救助会，和我们一起认养被抛弃或者濒危的动物。",
            "nextDialogs": [
              "716680108"
            ]
          },
          "716680108": {
            "id": "716680108",
            "speakerId": 30673,
            "speakerName": "振尘",
            "text": "飞云商会一直在和世界各国的志愿者合作，通过社会认养的方式解决广泛存在的流浪动物问题。",
            "nextDialogs": [
              "716680109"
            ]
          },
          "716680109": {
            "id": "716680109",
            "speakerId": 30673,
            "speakerName": "振尘",
            "text": "最近这几年救助会越做越大，我们开始考虑和拉米雅女士这样的学者合作，接触濒危动物保护领域。",
            "nextDialogs": [
              "716680110"
            ]
          },
          "716680110": {
            "id": "716680110",
            "speakerId": 30672,
            "speakerName": "拉米雅",
            "text": "能把研究成果用在这种地方，我也很开心啦。",
            "nextDialogs": [
              "716680111"
            ]
          },
          "716680111": {
            "id": "716680111",
            "speakerId": 30673,
            "speakerName": "振尘",
            "text": "哈哈，能和您合作，对我们来说也是乐事。",
            "nextDialogs": [
              "716680112"
            ]
          },
          "716680112": {
            "id": "716680112",
            "speakerId": 30673,
            "speakerName": "振尘",
            "text": "多亏我们的志愿者和拉米雅女士这样有远见的研究人员，很多流浪动物有了一个家，濒危动物得到了保护。",
            "nextDialogs": [
              "716680113"
            ]
          },
          "716680113": {
            "id": "716680113",
            "speakerId": 30673,
            "speakerName": "振尘",
            "text": "除了璃月本土，还有蒙德、须弥…只要是飞云商会活跃的国家，到处都有「伴爪同行」的动物饲养点。",
            "nextDialogs": [
              "716680114"
            ]
          },
          "716680114": {
            "id": "716680114",
            "speakerId": 30673,
            "speakerName": "振尘",
            "text": "为了感谢志愿者们，也为了让大家都知道，「伴爪同行」的伙伴有很多很多，我们举办了这个活动。",
            "nextDialogs": [
              "716680115"
            ]
          },
          "716680115": {
            "id": "716680115",
            "speakerId": 30673,
            "speakerName": "振尘",
            "text": "你可以前往被认养动物栖息的区域找一找，去看看它们实际的生活状态，顺便领取一份小礼物。",
            "nextDialogs": [
              "716680116"
            ]
          },
          "716680116": {
            "id": "716680116",
            "speakerId": 30673,
            "speakerName": "振尘",
            "text": "礼物是由救助会工作人员和其他认养人共同准备的，当然，在领取礼物之前，你也得给其他的认养人准备点东西。",
            "nextDialogs": [
              "716680117"
            ]
          },
          "716680117": {
            "id": "716680117",
            "speakerId": 30673,
            "speakerName": "振尘",
            "text": "届时，礼物会有专人回收，并传递给原本的认养人。礼物不需要多贵重，只要能传递心意就好。",
            "nextDialogs": [
              "716680118"
            ]
          },
          "716680118": {
            "id": "716680118",
            "speakerId": 30673,
            "speakerName": "振尘",
            "text": "#怎么样，{NICKNAME}，有兴趣参加吗？",
            "nextDialogs": [
              "716680121"
            ]
          },
          "716680121": {
            "id": "716680121",
            "speakerId": 30673,
            "speakerName": "振尘",
            "text": "太好了，有你这样的社会名人参与，我们也很高兴。",
            "nextDialogs": [
              "716680122"
            ]
          },
          "716680122": {
            "id": "716680122",
            "speakerId": 30673,
            "speakerName": "振尘",
            "text": "你准备好了的话，现在就可以把礼物交给我，由我们的工作人员在活动结束后分送给认养人。",
            "nextDialogs": [
              "716680123"
            ]
          },
          "716680123": {
            "id": "716680123",
            "speakerId": 30673,
            "speakerName": "振尘",
            "text": "对了，以我和认养人打交道的经验来看，有些认养人对地区特产感兴趣，有些比较喜欢美食。"
          }
        }
      }
    },
    {
      "subId": "7166802",
      "subQuestName": "交付合适的礼物",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "716680201"
        ],
        "dialogs": {
          "716680201": {
            "id": "716680201",
            "speakerId": 30673,
            "speakerName": "振尘",
            "text": "可以在准备礼物的时候分两袋给我…"
          }
        }
      }
    },
    {
      "subId": "7166803",
      "subQuestName": "交付合适的礼物",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "716680301"
        ],
        "dialogs": {
          "716680301": {
            "id": "716680301",
            "speakerId": 30673,
            "speakerName": "振尘",
            "text": "好，这些特产我们会用礼物盒分装好。"
          }
        }
      }
    },
    {
      "subId": "7166804",
      "subQuestName": "和「飞云商会」的工作人员对话",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "716680401"
        ],
        "dialogs": {
          "716680401": {
            "id": "716680401",
            "speakerId": 30673,
            "speakerName": "振尘",
            "text": "好，这些食物我们会用食盒装好送出。",
            "nextDialogs": [
              "716680402"
            ]
          },
          "716680402": {
            "id": "716680402",
            "speakerId": 30673,
            "speakerName": "振尘",
            "text": "每一只动物都有自己独特的习性，我们并不会把动物关在笼子里，而是雇佣专业的饲养人员跟踪监控它们的身体状况。",
            "nextDialogs": [
              "716680403"
            ]
          },
          "716680403": {
            "id": "716680403",
            "speakerId": 30673,
            "speakerName": "振尘",
            "text": "要找到它们不是容易的事情，你会需要拉米雅女士研制的特殊器材「铭随流镜」。",
            "nextDialogs": [
              "716680404"
            ]
          },
          "716680404": {
            "id": "716680404",
            "speakerId": 30673,
            "speakerName": "振尘",
            "text": "这方面我不如她本人懂行，还是请她向你解释吧。",
            "nextDialogs": [
              "716680405"
            ]
          },
          "716680405": {
            "id": "716680405",
            "speakerId": 30672,
            "speakerName": "拉米雅",
            "text": "嗯，还是让我来说明吧。",
            "nextDialogs": [
              "716680406"
            ]
          },
          "716680406": {
            "id": "716680406",
            "speakerId": 30672,
            "speakerName": "拉米雅",
            "text": "「铭随流镜」这种装置的底层技术和虚空有一定关联，具体的运行逻辑可能有点复杂，总之你放心，是实测安全的装置。",
            "nextDialogs": [
              "716680407"
            ]
          },
          "716680407": {
            "id": "716680407",
            "speakerId": 30672,
            "speakerName": "拉米雅",
            "text": "使用的时候，因为我们已经在动物身上绑上了微型发讯装置，只要读取装置信号，镜子里就能显露动物视角中的事物。",
            "nextDialogs": [
              "716680408"
            ]
          },
          "716680408": {
            "id": "716680408",
            "speakerId": 30672,
            "speakerName": "拉米雅",
            "text": "尽管这个装置还有需要改进的地方，但这些影像暂时够我们定位活跃中的动物了。",
            "nextDialogs": [
              "716680409"
            ]
          },
          "716680409": {
            "id": "716680409",
            "speakerId": 30673,
            "speakerName": "振尘",
            "text": "大体来说就是这样，如果你准备好了，欢迎加入「伴爪同行」！",
            "nextDialogs": [
              "716680410"
            ]
          },
          "716680410": {
            "id": "716680410",
            "speakerId": 30673,
            "speakerName": "振尘",
            "text": "用「铭随流镜」找一找我们的动物朋友吧，认养人的礼物和小动物们都在等着和你打招呼。"
          }
        }
      }
    },
    {
      "subId": "7166806",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "716680601"
        ],
        "dialogs": {
          "716680601": {
            "id": "716680601",
            "speakerId": 13356,
            "speakerName": "拉米雅",
            "text": "要不我也认养一只动物…？要是有长鬓虎就好了。"
          }
        }
      }
    }
  ]
}
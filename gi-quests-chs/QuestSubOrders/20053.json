  "subQuests": [
    {
      "subId": "2005301",
      "subQuestName": "前往询问艾琳",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "200530101"
        ],
        "dialogs": {
          "200530101": {
            "id": "200530101",
            "speakerId": 1000,
            "speakerName": "艾琳",
            "text": "伤脑筋…这里要怎么解决啊…",
            "nextDialogs": [
              "200530102"
            ]
          },
          "200530102": {
            "id": "200530102",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "你在做什么呢？",
            "nextDialogs": [
              "200530103"
            ]
          },
          "200530103": {
            "id": "200530103",
            "speakerId": 1000,
            "speakerName": "艾琳",
            "text": "为了下一次的骑士选拔，我正在训练呢。",
            "nextDialogs": [
              "200530104"
            ]
          },
          "200530104": {
            "id": "200530104",
            "speakerId": 1000,
            "speakerName": "艾琳",
            "text": "唔…不过，我可没有琴大人那样的力量。",
            "nextDialogs": [
              "200530105"
            ]
          },
          "200530105": {
            "id": "200530105",
            "speakerId": 1000,
            "speakerName": "艾琳",
            "text": "比起锻炼「力量」，我觉得学习「技巧」更适合我。",
            "nextDialogs": [
              "200530106"
            ]
          },
          "200530106": {
            "id": "200530106",
            "speakerId": 1000,
            "speakerName": "艾琳",
            "text": "比如，一口气把这些木桩全部破坏掉的方法…",
            "nextDialogs": [
              "200530107"
            ]
          },
          "200530107": {
            "id": "200530107",
            "speakerId": 1000,
            "speakerName": "艾琳",
            "text": "你有空的话，也和我一起来想一想吧。",
            "nextDialogs": [
              "200530110",
              "200530112"
            ]
          },
          "200530110": {
            "id": "200530110",
            "speakerId": 1000,
            "speakerName": "艾琳",
            "text": "没关系，好好想喔，木桩不会自己跑掉。",
            "nextDialogs": [
              "200530111"
            ]
          },
          "200530111": {
            "id": "200530111",
            "speakerId": 1000,
            "speakerName": "艾琳",
            "text": "唯一会自己跑掉的只有被消耗的时间和生命，唔…",
            "nextDialogs": [
              "200530114"
            ]
          },
          "200530114": {
            "id": "200530114",
            "speakerId": 1000,
            "speakerName": "艾琳",
            "text": "这种距离，自己对付一边，丢个炸弹炸掉另外一边就是最好的选择啦！",
            "nextDialogs": [
              "200530115"
            ]
          },
          "200530115": {
            "id": "200530115",
            "speakerId": 1000,
            "speakerName": "艾琳",
            "text": "哈哈哈我开玩笑的，炸弹这种东西，怎么可能这么轻松找到啦。"
          },
          "200530112": {
            "id": "200530112",
            "speakerId": 1000,
            "speakerName": "艾琳",
            "text": "你习惯团体作战吗？真羡慕啊…随时都能叫到帮手的人。",
            "nextDialogs": [
              "200530113"
            ]
          },
          "200530113": {
            "id": "200530113",
            "speakerId": 1000,
            "speakerName": "艾琳",
            "text": "像我这样的，只能学习独自作战啦。"
          }
        }
      }
    },
    {
      "subId": "2005302",
      "subQuestName": "在2秒内摧毁所有木桩",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "200530201"
        ],
        "dialogs": {
          "200530201": {
            "id": "200530201",
            "speakerId": 1000,
            "speakerName": "艾琳",
            "text": "怎么样？想到好方法了吗？",
            "nextDialogs": [
              "200530202"
            ]
          },
          "200530202": {
            "id": "200530202",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "还没有想好…",
            "nextDialogs": [
              "200530203"
            ]
          },
          "200530203": {
            "id": "200530203",
            "speakerId": 1000,
            "speakerName": "艾琳",
            "text": "嗯…我之前遇见的冒险家，有些也偶尔会这样呢。",
            "nextDialogs": [
              "200530204"
            ]
          },
          "200530204": {
            "id": "200530204",
            "speakerId": 1000,
            "speakerName": "艾琳",
            "text": "面对怪物时能利落地战斗，打木桩的时候却手忙脚乱。",
            "nextDialogs": [
              "200530205"
            ]
          },
          "200530205": {
            "id": "200530205",
            "speakerId": 1000,
            "speakerName": "艾琳",
            "text": "而且还用各种手段加固木桩，就像生怕自己能轻松击碎一样…",
            "nextDialogs": [
              "200530206"
            ]
          },
          "200530206": {
            "id": "200530206",
            "speakerId": 1000,
            "speakerName": "艾琳",
            "text": "这么想寻求挑战的话，直接去野外找强大的魔物不就好了吗？"
          }
        }
      }
    },
    {
      "subId": "2005303",
      "subQuestName": "返回对话艾琳",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "200530301"
        ],
        "dialogs": {
          "200530301": {
            "id": "200530301",
            "speakerId": 1000,
            "speakerName": "艾琳",
            "text": "做到了！",
            "nextDialogs": [
              "200530302"
            ]
          },
          "200530302": {
            "id": "200530302",
            "speakerId": 1000,
            "speakerName": "艾琳",
            "text": "原来还能这么解决…这种方法我想都没想过。",
            "nextDialogs": [
              "200530303"
            ]
          },
          "200530303": {
            "id": "200530303",
            "speakerId": 1000,
            "speakerName": "艾琳",
            "text": "谢谢你，我自己去再试试看！"
          }
        }
      }
    }
  ]
}
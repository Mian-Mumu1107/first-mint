    {
      "subId": "2002603",
      "subQuestName": "找到两颗鸟蛋",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "200260301"
        ],
        "dialogs": {
          "200260301": {
            "id": "200260301",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "这是你点的餐。",
            "nextDialogs": [
              "200260302"
            ]
          },
          "200260302": {
            "id": "200260302",
            "speakerId": 1535,
            "speakerName": "恩内斯特",
            "text": "哦！是按照我的要求特制的<color=#00E1FFFF>炸萝卜丸子</color>啊。",
            "nextDialogs": [
              "200260303"
            ]
          },
          "200260303": {
            "id": "200260303",
            "speakerId": 1535,
            "speakerName": "恩内斯特",
            "text": "果然，加了蛋类之后，口感和香气都更好了。",
            "nextDialogs": [
              "200260304"
            ]
          },
          "200260304": {
            "id": "200260304",
            "speakerId": 1535,
            "speakerName": "恩内斯特",
            "text": "哈哈哈，我的品味果然是最棒的！",
            "nextDialogs": [
              "200260305"
            ]
          },
          "200260305": {
            "id": "200260305",
            "speakerId": 1535,
            "speakerName": "恩内斯特",
            "text": "对了，这是餐费，辛苦你了。"
          }
        }
      }
    },
    {
      "subId": "2002604",
      "subQuestName": "取得制作好的餐品",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "200260201"
        ],
        "dialogs": {
          "200260201": {
            "id": "200260201",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "已经找好了。",
            "nextDialogs": [
              "200260202"
            ]
          },
          "200260202": {
            "id": "200260202",
            "speakerId": 10002,
            "speakerName": "莎拉",
            "text": "这下子材料就够了，稍等一下…",
            "nextDialogs": [
              "200260203"
            ]
          },
          "200260203": {
            "id": "200260203",
            "speakerId": 10002,
            "speakerName": "莎拉",
            "text": "好啦，拜托你把这份特制的<color=#00E1FFFF>炸萝卜丸子</color>送给恩内斯特先生吧。",
            "nextDialogs": [
              "200260204"
            ]
          },
          "200260204": {
            "id": "200260204",
            "speakerId": 10002,
            "speakerName": "莎拉",
            "text": "别这么看着我嘛，我知道你肚子很饿了。",
            "nextDialogs": [
              "200260205"
            ]
          },
          "200260205": {
            "id": "200260205",
            "speakerId": 10002,
            "speakerName": "莎拉",
            "text": "回来的时候，我会用猎鹿人餐馆特制料理来答谢你的！"
          }
        }
      }
    },

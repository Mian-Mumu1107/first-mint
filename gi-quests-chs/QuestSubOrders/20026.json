  "subQuests": [
    {
      "subId": "2002601",
      "subQuestName": "前往猎鹿人餐馆询问莎拉",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "200260101"
        ],
        "dialogs": {
          "200260101": {
            "id": "200260101",
            "speakerId": 10002,
            "speakerName": "莎拉",
            "text": "餐品外送订单",
            "nextDialogs": [
              "200260102"
            ]
          },
          "200260102": {
            "id": "200260102",
            "speakerId": 10002,
            "speakerName": "莎拉",
            "text": "旅行者，你来的正好——",
            "nextDialogs": [
              "200260103"
            ]
          },
          "200260103": {
            "id": "200260103",
            "speakerId": 10002,
            "speakerName": "莎拉",
            "text": "咦？你说你只是来吃东西的…",
            "nextDialogs": [
              "200260104"
            ]
          },
          "200260104": {
            "id": "200260104",
            "speakerId": 10002,
            "speakerName": "莎拉",
            "text": "我，我知道了，但是请你帮我个忙吧，我一定会把最好吃的料理给你！",
            "nextDialogs": [
              "200260105"
            ]
          },
          "200260105": {
            "id": "200260105",
            "speakerId": 10002,
            "speakerName": "莎拉",
            "text": "晨曦酒庄的恩内斯特先生经常在我们这里订下酒菜，而且总是会提出各种奇怪的加料要求。",
            "nextDialogs": [
              "200260106"
            ]
          },
          "200260106": {
            "id": "200260106",
            "speakerId": 10002,
            "speakerName": "莎拉",
            "text": "嗯…这次他虽然订的是<color=#00E1FFFF>炸萝卜丸子</color>，但他一定要我们多加蛋类，可我们的蛋类料理材料都用光了。",
            "nextDialogs": [
              "200260107"
            ]
          },
          "200260107": {
            "id": "200260107",
            "speakerId": 10002,
            "speakerName": "莎拉",
            "text": "所以，请你帮我们找两颗鸟蛋回来吧。",
            "nextDialogs": [
              "200260109",
              "200260112"
            ]
          },
          "200260109": {
            "id": "200260109",
            "speakerId": 10002,
            "speakerName": "莎拉",
            "text": "在风起地，应该可以找到很多鸟蛋。",
            "nextDialogs": [
              "200260110"
            ]
          },
          "200260110": {
            "id": "200260110",
            "speakerId": 10002,
            "speakerName": "莎拉",
            "text": "那么，就拜托你了！"
          },
          "200260112": {
            "id": "200260112",
            "speakerId": 10002,
            "speakerName": "莎拉",
            "text": "在风起地，应该可以找到很多鸟蛋。",
            "nextDialogs": [
              "200260113"
            ]
          },
          "200260113": {
            "id": "200260113",
            "speakerId": 10002,
            "speakerName": "莎拉",
            "text": "等你帮完我的忙之后，我，我就请你吃猎鹿人特制料理，就拜托你了！"
          }
        }
      }
    },
    {

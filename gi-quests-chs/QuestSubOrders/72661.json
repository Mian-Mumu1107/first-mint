    {
      "subId": "7266107",
      "subQuestName": "跟踪盗宝团",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "726610701"
        ],
        "dialogs": {
          "726610701": {
            "id": "726610701",
            "speakerId": 1002,
            "speakerName": "老黑七",
            "text": "嘿，你们说，这破石头值钱吗？居然藏在矿石里，真稀罕。",
            "nextDialogs": [
              "726610702"
            ]
          },
          "726610702": {
            "id": "726610702",
            "speakerId": 1003,
            "speakerName": "林逃山",
            "text": "笑死了，什么叫破石头，你读过书吗？这叫化石，化石懂吗？",
            "nextDialogs": [
              "726610703"
            ]
          },
          "726610703": {
            "id": "726610703",
            "speakerId": 1003,
            "speakerName": "林逃山",
            "text": "值钱死了，光这一颗就能买下半个璃月港！快回去多读点书吧！",
            "nextDialogs": [
              "726610704"
            ]
          },
          "726610704": {
            "id": "726610704",
            "speakerId": 1004,
            "speakerName": "巴子",
            "text": "真的吗？有这么值钱吗？那加上营地里的这些，我们岂不是要平步乌云了？！",
            "nextDialogs": [
              "726610705"
            ]
          },
          "726610705": {
            "id": "726610705",
            "speakerId": 1003,
            "speakerName": "林逃山",
            "text": "是平步青云！你也回去多读点书吧！",
            "nextDialogs": [
              "726610706"
            ]
          },
          "726610706": {
            "id": "726610706",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "喂！那边的家伙，把化石交出来！",
            "nextDialogs": [
              "726610707"
            ]
          },
          "726610707": {
            "id": "726610707",
            "speakerId": 1003,
            "speakerName": "林逃山",
            "text": "啊！是谁？！该死…被发现了，兄弟们上！"
          }
        }
      }
    },

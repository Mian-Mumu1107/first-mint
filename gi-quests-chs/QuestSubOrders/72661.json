    {
      "subId": "7266105",
      "subQuestName": "调查矿堆",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "726610501"
        ],
        "dialogs": {
          "726610501": {
            "id": "726610501",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "怎么都是些都是矿渣，感觉里面有东西被人取走了一样。",
            "nextDialogs": [
              "726610502"
            ]
          },
          "726610502": {
            "id": "726610502",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "咦？！那个人是...盗宝团？",
            "nextDialogs": [
              "726610503"
            ]
          },
          "726610503": {
            "id": "726610503",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "不会是他们拿走了矿石里的东西吧？",
            "nextDialogs": [
              "726610504"
            ]
          },
          "726610504": {
            "id": "726610504",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "快跟上他们，周围肯定有他们的营地，矿石里的东西一定都在那里！",
            "nextDialogs": [
              "726610505"
            ]
          },
          "726610505": {
            "id": "726610505",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "我们走。",
            "nextDialogs": [
              "726610506"
            ]
          },
          "726610506": {
            "id": "726610506",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "我们要偷偷的，偷偷的，别被发现了。"
          }
        }
      }
    },
    {
      "subId": "7266106",

    {
      "subId": "7266109",
      "subQuestName": "与鲸井椛对话",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "726610601"
        ],
        "dialogs": {
          "726610601": {
            "id": "726610601",
            "speakerId": 1005,
            "speakerName": "鲸井椛",
            "text": "你们终于回来了，欸？嘉玮没来吗?",
            "nextDialogs": [
              "726610602"
            ]
          },
          "726610602": {
            "id": "726610602",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "他掉进了温柔乡。",
            "nextDialogs": [
              "726610603"
            ]
          },
          "726610603": {
            "id": "726610603",
            "speakerId": 1005,
            "speakerName": "鲸井椛",
            "text": "啊？他成家了？哈哈！确实像他会做的事。",
            "nextDialogs": [
              "726610604"
            ]
          },
          "726610604": {
            "id": "726610604",
            "speakerId": 1005,
            "speakerName": "鲸井椛",
            "text": "毕竟之前他的愿望就是这个…好吧，既然是这个理由就原谅他了。",
            "nextDialogs": [
              "726610605"
            ]
          },
          "726610605": {
            "id": "726610605",
            "speakerId": 1005,
            "speakerName": "鲸井椛",
            "text": "那楠塔克呢？你们找到了吗？",
            "nextDialogs": [
              "726610606"
            ]
          },
          "726610606": {
            "id": "726610606",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "他写了本畅销书。",
            "nextDialogs": [
              "726610607"
            ]
          },
          "726610607": {
            "id": "726610607",
            "speakerId": 1005,
            "speakerName": "鲸井椛",
            "text": "欸？没想到他真的成了作家啊？还挺能的啊这老小子，写了什么？",
            "nextDialogs": [
              "726610608"
            ]
          },
          "726610608": {
            "id": "726610608",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "我知道我知道！书名叫作《关于「海中月」的真身其实是大海龟这件事》。",
            "nextDialogs": [
              "726610609"
            ]
          },
          "726610609": {
            "id": "726610609",
            "speakerId": 1005,
            "speakerName": "鲸井椛",
            "text": "哦，挺长的名字啊，是轻小说吗？不错…我也去买一本看看…嗯？等等。",
            "nextDialogs": [
              "726610610"
            ]
          },
          "726610610": {
            "id": "726610610",
            "speakerId": 1005,
            "speakerName": "鲸井椛",
            "text": "关于「海中月」的真身…「海中月」的真身？！",
            "nextDialogs": [
              "726610611"
            ]
          },
          "726610611": {
            "id": "726610611",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "嗯…其实是大海龟。",
            "nextDialogs": [
              "726610612"
            ]
          },
          "726610612": {
            "id": "726610612",
            "speakerId": 1005,
            "speakerName": "鲸井椛",
            "text": "这家伙在说什么呢？怎么可能是大海龟？他忘了我们当年亲眼看到了「海中月」吗？",
            "nextDialogs": [
              "726610613"
            ]
          },
          "726610613": {
            "id": "726610613",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "我们开始也不相信啦…然后就去雪山上找来了「海中月」的化石… 这本书，还有化石，喏，给你。",
            "nextDialogs": [
              "726610614"
            ]
          },
          "726610614": {
            "id": "726610614",
            "speakerId": 1005,
            "speakerName": "鲸井椛",
            "text": "不，我不相信，这不是真的…",
            "nextDialogs": [
              "726610615"
            ]
          },
          "726610615": {
            "id": "726610615",
            "speakerId": 1005,
            "speakerName": "鲸井椛",
            "text": "你们不知道，我们「鲸井」家是渔师世家，我的父亲也是稻妻闻名的渔师。",
            "nextDialogs": [
              "726610616"
            ]
          },
          "726610616": {
            "id": "726610616",
            "speakerId": 1005,
            "speakerName": "鲸井椛",
            "text": "他曾花费了数十年在大海上追捕「海中月」，有一次，他差点就成功了。",
            "nextDialogs": [
              "726610617"
            ]
          },
          "726610617": {
            "id": "726610617",
            "speakerId": 1005,
            "speakerName": "鲸井椛",
            "text": "虽然最后还是功亏一篑，但我父亲没有放弃，如果能够捕上传说中的「海中月」，对渔师来说是无上的荣耀。",
            "nextDialogs": [
              "726610618"
            ]
          },
          "726610618": {
            "id": "726610618",
            "speakerId": 1005,
            "speakerName": "鲸井椛",
            "text": "但就在下一次出海后…他就再没有回来。",
            "nextDialogs": [
              "726610619"
            ]
          },
          "726610619": {
            "id": "726610619",
            "speakerId": 1005,
            "speakerName": "鲸井椛",
            "text": "…",
            "nextDialogs": [
              "726610620"
            ]
          },
          "726610620": {
            "id": "726610620",
            "speakerId": 1005,
            "speakerName": "鲸井椛",
            "text": "所以，我不会轻易相信这种话的，请你帮我一把！",
            "nextDialogs": [
              "726610621"
            ]
          },
          "726610621": {
            "id": "726610621",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "那你打算怎么办？",
            "nextDialogs": [
              "726610622"
            ]
          },
          "726610622": {
            "id": "726610622",
            "speakerId": 1005,
            "speakerName": "鲸井椛",
            "text": "我现在回去找父亲留下的物品，他追逐「海中月」一生，留下了很多资料。一定能在里面找到办法。",
            "nextDialogs": [
              "726610623"
            ]
          },
          "726610623": {
            "id": "726610623",
            "speakerId": 1005,
            "speakerName": "鲸井椛",
            "text": "我为你准备了一些钓鱼训练，请等我的好消息吧，到时候还要拜托你。"
          }
        }
      }
    },

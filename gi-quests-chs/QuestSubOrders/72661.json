  "subQuests": [
    {
      "subId": "7266101",
      "subQuestName": "与蒙德渔师楠塔克对话",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "726610101"
        ],
        "dialogs": {
          "726610101": {
            "id": "726610101",
            "speakerId": 1000,
            "speakerName": "楠塔克",
            "text": "哦，年轻的钓鱼家，见到你可真高兴啊。怎么，遇上了麻烦吗？",
            "nextDialogs": [
              "726610102"
            ]
          },
          "726610102": {
            "id": "726610102",
            "speakerId": 1000,
            "speakerName": "楠塔克",
            "text": "来来来，我可是你的钓鱼领路人了，有什么事说给我听听。",
            "nextDialogs": [
              "726610103"
            ]
          },
          "726610103": {
            "id": "726610103",
            "speakerId": 1000,
            "speakerName": "楠塔克",
            "text": "居然是「海中月」啊，鲸井还在执着这件事，也难怪，毕竟她的愿望是…",
            "nextDialogs": [
              "726610104"
            ]
          },
          "726610104": {
            "id": "726610104",
            "speakerId": 1000,
            "speakerName": "楠塔克",
            "text": "唉，她要是知道了「海中月」的真相，一定会很失望吧。",
            "nextDialogs": [
              "726610105"
            ]
          },
          "726610105": {
            "id": "726610105",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "什么真相？",
            "nextDialogs": [
              "726610106"
            ]
          },
          "726610106": {
            "id": "726610106",
            "speakerId": 1000,
            "speakerName": "楠塔克",
            "text": "其实当年返航之后，我也没有停止关于「海中月」的调查，后来终于在一本古籍中找到了线索。",
            "nextDialogs": [
              "726610107"
            ]
          },
          "726610107": {
            "id": "726610107",
            "speakerId": 1000,
            "speakerName": "楠塔克",
            "text": "根据那些线索，我又去实地调研，终于发现了一些惊人的事。",
            "nextDialogs": [
              "726610108"
            ]
          },
          "726610108": {
            "id": "726610108",
            "speakerId": 1000,
            "speakerName": "楠塔克",
            "text": "我把这些发现都写进了我的作品里，最近似乎销路还不错呢。",
            "nextDialogs": [
              "726610109"
            ]
          },
          "726610109": {
            "id": "726610109",
            "speakerId": 1000,
            "speakerName": "楠塔克",
            "text": "来，刚好手边有编辑留下的赠本，给你们看看，关于「海中月」的真相全在里面了。",
            "nextDialogs": [
              "726610110"
            ]
          },
          "726610110": {
            "id": "726610110",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "我也要看，让我也看看！",
            "nextDialogs": [
              "726610111"
            ]
          },
          "726610111": {
            "id": "726610111",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "《关于「海中月」的真身其实是大海龟这件事》…好长的书名啊… 欸？！",
            "nextDialogs": [
              "726610112"
            ]
          },
          "726610112": {
            "id": "726610112",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "大海龟？「海中月」是大海龟？",
            "nextDialogs": [
              "726610113"
            ]
          },
          "726610113": {
            "id": "726610113",
            "speakerId": 1000,
            "speakerName": "楠塔克",
            "text": "没错，「海中月」就是一只大海龟。",
            "nextDialogs": [
              "726610114"
            ]
          },
          "726610114": {
            "id": "726610114",
            "speakerId": 1000,
            "speakerName": "楠塔克",
            "text": "当年那个晚上，我们看见的，就是一只背后长满了类似小灯草这种发光植物的大海龟。",
            "nextDialogs": [
              "726610115"
            ]
          },
          "726610115": {
            "id": "726610115",
            "speakerId": 1000,
            "speakerName": "楠塔克",
            "text": "它是一位怀孕的母亲，正在上岸产卵的路上，因此我们才得以找到回家的路。",
            "nextDialogs": [
              "726610116"
            ]
          },
          "726610116": {
            "id": "726610116",
            "speakerId": 1000,
            "speakerName": "楠塔克",
            "text": "所以，请回去把我的话转告鲸井吧。不论如何，人终究要面对现实。",
            "nextDialogs": [
              "726610117"
            ]
          },
          "726610117": {
            "id": "726610117",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "可是，虽然这也能说通...",
            "nextDialogs": [
              "726610118"
            ]
          },
          "726610118": {
            "id": "726610118",
            "speakerId": 1000,
            "speakerName": "楠塔克",
            "text": "看你的表情，还有点不相信吧？但我的研究是有证据的。",
            "nextDialogs": [
              "726610119"
            ]
          },
          "726610119": {
            "id": "726610119",
            "speakerId": 1000,
            "speakerName": "楠塔克",
            "text": "古籍中提到，「海中月」是一种古老的生物，在很久很久以前，很多生物还在陆地上生活的时候。",
            "nextDialogs": [
              "726610120"
            ]
          },
          "726610120": {
            "id": "726610120",
            "speakerId": 1000,
            "speakerName": "楠塔克",
            "text": "它们的祖先，就活跃在如今的龙脊雪山地区，现在还能够找到一些化石。",
            "nextDialogs": [
              "726610121"
            ]
          },
          "726610121": {
            "id": "726610121",
            "speakerId": 1000,
            "speakerName": "楠塔克",
            "text": "我上次就在<color=#00E1FFFF>眠龙谷西侧</color>的矿堆里发现了一些，你们如果还不相信，可以去找找看。"
          }
        }
      }
    },
    {
      "subId": "7266102",
      "subQuestName": "前往雪山寻找「海中月」化石",
      "sceneId": null,

  "subQuests": [
    {
      "subId": "7651201",
      "subQuestName": "与万叶对话",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "765120101"
        ],
        "dialogs": {
          "765120101": {
            "id": "765120101",
            "speakerId": 1032,
            "speakerName": "枫原万叶",
            "text": "#比试进行到现在，{NICKNAME}应该已经心中有数了。",
            "nextDialogs": [
              "765120102"
            ]
          },
          "765120102": {
            "id": "765120102",
            "speakerId": 15494,
            "speakerName": "泽西切",
            "text": "咳咳，让我回忆一下台词…",
            "nextDialogs": [
              "765120103"
            ]
          },
          "765120103": {
            "id": "765120103",
            "speakerId": 15494,
            "speakerName": "泽西切",
            "text": "精妙绝伦的比赛总算落下了帷幕，现在，到了公布比赛结果的环节。",
            "nextDialogs": [
              "765120104"
            ]
          },
          "765120104": {
            "id": "765120104",
            "speakerId": 15494,
            "speakerName": "泽西切",
            "text": "#有请我们的最终试炼者{NICKNAME}，选出你心目中的冠军。",
            "nextDialogs": [
              "765120105"
            ]
          },
          "765120105": {
            "id": "765120105",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "#这次是由{NICKNAME}来决定冠军？喔…还真是头一回，{NICKNAME}成了最关键的评委！",
            "nextDialogs": [
              "765120107",
              "765120113",
              "765120120"
            ]
          },
          "765120107": {
            "id": "765120107",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "嗯嗯，我也觉得「咕咕丸」最厉害，有着「太郎丸」的风范！",
            "nextDialogs": [
              "765120108"
            ]
          },
          "765120108": {
            "id": "765120108",
            "speakerId": 31061,
            "speakerName": "「咕咕丸」",
            "text": "呜嗷！嗷！",
            "nextDialogs": [
              "765120109"
            ]
          },
          "765120109": {
            "id": "765120109",
            "speakerId": 30963,
            "speakerName": "堇葵",
            "text": "太棒了，「咕咕丸」！你的努力开花结果，得到了最华丽的回应！",
            "nextDialogs": [
              "765120110"
            ]
          },
          "765120110": {
            "id": "765120110",
            "speakerId": 31024,
            "speakerName": "「缟玛瑙」",
            "text": "意料之中的结果，恭喜两位稻妻朋友。",
            "nextDialogs": [
              "765120111"
            ]
          },
          "765120111": {
            "id": "765120111",
            "speakerId": 31025,
            "speakerName": "「减七琶音」",
            "text": "飒爽的忍犬先生的确很强，我支持。",
            "nextDialogs": [
              "765120125"
            ]
          },
          "765120125": {
            "id": "765120125",
            "speakerId": 15494,
            "speakerName": "泽西切",
            "text": "虽说没有热闹的颁奖环节，但诸位注重实战，平日也低调行事。",
            "nextDialogs": [
              "765120126"
            ]
          },
          "765120126": {
            "id": "765120126",
            "speakerId": 15494,
            "speakerName": "泽西切",
            "text": "#来自{NICKNAME}的认可，是挪德卡莱最高一级的荣耀，远超普普通通的镀金奖杯与勋章。",
            "nextDialogs": [
              "765120127"
            ]
          },
          "765120127": {
            "id": "765120127",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "#哼哼~你们可能是全提瓦特头一回被{NICKNAME}这样颁奖的战士哦。",
            "nextDialogs": [
              "765120128"
            ]
          },
          "765120128": {
            "id": "765120128",
            "speakerId": 31024,
            "speakerName": "「缟玛瑙」",
            "text": "无需更多奖励点缀，我们已经尽兴了。",
            "nextDialogs": [
              "765120129"
            ]
          },
          "765120129": {
            "id": "765120129",
            "speakerId": 31024,
            "speakerName": "「缟玛瑙」",
            "text": "是吧，布达诺娃？",
            "nextDialogs": [
              "765120130"
            ]
          },
          "765120130": {
            "id": "765120130",
            "speakerId": 31025,
            "speakerName": "「减七琶音」",
            "text": "当然，下次不妨由我们役人部队出资，把比赛办得更热闹。",
            "nextDialogs": [
              "765120131"
            ]
          },
          "765120131": {
            "id": "765120131",
            "speakerId": 31025,
            "speakerName": "「减七琶音」",
            "text": "最好有着百人级别的初赛，这样，最后说不定会出现许多情报之外，且暂无归属的高人。",
            "nextDialogs": [
              "765120132"
            ]
          },
          "765120132": {
            "id": "765120132",
            "speakerId": 31024,
            "speakerName": "「缟玛瑙」",
            "text": "有道理。掷弹兵们也乐于赞助这种赛事，我会提前给瓦列里少校写好方案的。",
            "nextDialogs": [
              "765120133"
            ]
          },
          "765120133": {
            "id": "765120133",
            "speakerId": 30963,
            "speakerName": "堇葵",
            "text": "终末番也…呃…如果经费达到千万摩拉级，就不谈出钱的问题了，忍犬部队还会积极参与赛事的。",
            "nextDialogs": [
              "765120134"
            ]
          },
          "765120134": {
            "id": "765120134",
            "speakerId": 31061,
            "speakerName": "「咕咕丸」",
            "text": "呜…",
            "nextDialogs": [
              "765120135"
            ]
          },
          "765120135": {
            "id": "765120135",
            "speakerId": 1032,
            "speakerName": "枫原万叶",
            "text": "感谢各位的好意，我想，如果这类比拼有着个别强势的出资方，性质可能就变了。",
            "nextDialogs": [
              "765120136"
            ]
          },
          "765120136": {
            "id": "765120136",
            "speakerId": 1032,
            "speakerName": "枫原万叶",
            "text": "三位能否抵抗诱惑，不向名次靠前的强者抛出橄榄枝，招募那些自由之士？",
            "nextDialogs": [
              "765120137"
            ]
          },
          "765120137": {
            "id": "765120137",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "啊，万叶的意思难道是…",
            "nextDialogs": [
              "765120138"
            ]
          },
          "765120138": {
            "id": "765120138",
            "speakerId": 1032,
            "speakerName": "枫原万叶",
            "text": "正是因此，由相对中立的冒险家协会来承办，才是最佳的选择。"
          },
          "765120113": {
            "id": "765120113",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "个子高高，拿大剑的愚人众…确实很难对付呢…",
            "nextDialogs": [
              "765120114"
            ]
          },
          "765120114": {
            "id": "765120114",
            "speakerId": 31024,
            "speakerName": "「缟玛瑙」",
            "text": "我？感谢你的认可，这是对我最大的鼓舞。",
            "nextDialogs": [
              "765120115"
            ]
          },
          "765120115": {
            "id": "765120115",
            "speakerId": 31024,
            "speakerName": "「缟玛瑙」",
            "text": "#大家打得都不赖，可能我更走运，对上了{NICKNAME}的节奏。",
            "nextDialogs": [
              "765120116"
            ]
          },
          "765120116": {
            "id": "765120116",
            "speakerId": 31061,
            "speakerName": "「咕咕丸」",
            "text": "嗷！",
            "nextDialogs": [
              "765120117"
            ]
          },
          "765120117": {
            "id": "765120117",
            "speakerId": 30963,
            "speakerName": "堇葵",
            "text": "看到了吗，「咕咕丸」？要好好向「缟玛瑙」学习哦。",
            "nextDialogs": [
              "765120118"
            ]
          },
          "765120118": {
            "id": "765120118",
            "speakerId": 31025,
            "speakerName": "「减七琶音」",
            "text": "不愧是斯捷潘尼扬中尉，瓦列里少校也会为你骄傲的。"
          },
          "765120120": {
            "id": "765120120",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "唔…说起来，和我们在枫丹较量过的礼帽愚人众，有一些就是这位小姐教导出来的？那确实厉害！",
            "nextDialogs": [
              "765120121"
            ]
          },
          "765120121": {
            "id": "765120121",
            "speakerId": 31025,
            "speakerName": "「减七琶音」",
            "text": "#啊呀，这可真是承蒙厚爱…以后得多为{NICKNAME}准备豪华甜点才行了。",
            "nextDialogs": [
              "765120122"
            ]
          },
          "765120122": {
            "id": "765120122",
            "speakerId": 31061,
            "speakerName": "「咕咕丸」",
            "text": "咕？",
            "nextDialogs": [
              "765120123"
            ]
          },
          "765120123": {
            "id": "765120123",
            "speakerId": 30963,
            "speakerName": "堇葵",
            "text": "如果你也想吃布达诺娃小姐的蛋糕，那可得加油变强哦。",
            "nextDialogs": [
              "765120124"
            ]
          },
          "765120124": {
            "id": "765120124",
            "speakerId": 31024,
            "speakerName": "「缟玛瑙」",
            "text": "哎呀，到底是役人部队的老教官，拼不过，拼不过。"
          }
        }
      }
    }
  ]
}
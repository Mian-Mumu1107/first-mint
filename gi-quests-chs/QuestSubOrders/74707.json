        ],
        "dialogs": {
          "747070101": {
            "id": "747070101",
            "speakerId": 1000,
            "speakerName": "芙宁娜",
            "text": "…好，没问题！再来一条——",
            "nextDialogs": [
              "747070102"
            ]
          },
          "747070102": {
            "id": "747070102",
            "speakerId": 1000,
            "speakerName": "芙宁娜",
            "text": "好。停——！",
            "nextDialogs": [
              "747070103"
            ]
          },
          "747070103": {
            "id": "747070103",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "芙宁娜！还有哥伦比娅和千织，又见面了！",
            "nextDialogs": [
              "747070104"
            ]
          },
          "747070104": {
            "id": "747070104",
            "speakerId": 1000,
            "speakerName": "芙宁娜",
            "text": "嗯，我们刚好拍完上次说的氛围镜头。",
            "nextDialogs": [
              "747070105"
            ]
          },
          "747070105": {
            "id": "747070105",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "哦！就是让鱼儿来当演员的那个吧，怎么样怎么样？",
            "nextDialogs": [
              "747070106"
            ]
          },
          "747070106": {
            "id": "747070106",
            "speakerId": 1000,
            "speakerName": "芙宁娜",
            "text": "多亏你们的帮助，我们找到了一位合适的「演员」。拍摄很顺利！",
            "nextDialogs": [
              "747070107"
            ]
          },
          "747070107": {
            "id": "747070107",
            "speakerId": 1002,
            "speakerName": "千织",
            "text": "你们布置水族箱也很有一套。芙宁娜导演刚才还说看得她想去拍部水下纪录片了。",
            "nextDialogs": [
              "747070110"
            ]
          },
          "747070110": {
            "id": "747070110",
            "speakerId": 1003,
            "speakerName": "哥伦比娅",
            "text": "嗯，我也很喜欢。我能感觉到鱼儿们游得很惬意，很满足，你们照料得很好。",
            "nextDialogs": [
              "747070111"
            ]
          },
          "747070111": {
            "id": "747070111",
            "speakerId": 1000,
            "speakerName": "芙宁娜",
            "text": "真希望这水族馆一直留在这里呢，这样就能时不时来看看这些鱼了。",
            "nextDialogs": [
              "747070112"
            ]
          },
          "747070112": {
            "id": "747070112",
            "speakerId": 1002,
            "speakerName": "千织",
            "text": "真舍不得的话，就多剪几个镜头到映影里呗。",
            "nextDialogs": [
              "747070113"
            ]
          },
          "747070113": {
            "id": "747070113",
            "speakerId": 1000,
            "speakerName": "芙宁娜",
            "text": "你说得对。那干脆再补几条吧！",
            "nextDialogs": [
              "747070114"
            ]
          },
          "747070114": {
            "id": "747070114",
            "speakerId": 1004,
            "speakerName": "「少女」",
            "text": "补几条鱼？",
            "nextDialogs": [
              "747070115"
            ]
          },
          "747070115": {
            "id": "747070115",
            "speakerId": 1000,
            "speakerName": "芙宁娜",
            "text": "补镜头啦…灯光师，摄影师，还有场记就位！",
            "nextDialogs": [
              "747070116"
            ]
          },
          "747070116": {
            "id": "747070116",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "来啦！不过为鱼儿们打板还真是头一回呢…"
          }
        }
      }
    }
  ]
}
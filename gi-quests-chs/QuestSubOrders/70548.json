  "subQuests": [
    {
      "subId": "7054801",
      "subQuestName": "(test)隐藏$HIDDEN",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "705480101"
        ],
        "dialogs": {
          "705480101": {
            "id": "705480101",
            "speakerId": 1000,
            "speakerName": "丽莎",
            "text": "啊呀，看样子，赫塔回去忙了，格兰菲狄也不在…饮品小站完全由小可爱接管了？",
            "nextDialogs": [
              "705480104"
            ]
          },
          "705480104": {
            "id": "705480104",
            "speakerId": 1000,
            "speakerName": "丽莎",
            "text": "好呀~我可以放心点单啦，而不用担心…喝到后勤小队的神奇特调，整夜翻来覆去，完全没有睡意，只好熬夜工作。"
          }
        }
      }
    },
    {
      "subId": "7054802",
      "subQuestName": "(test)隐藏$HIDDEN",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [],
        "dialogs": {}
      }
    },
    {
      "subId": "7054803",
      "subQuestName": "(test)隐藏$HIDDEN",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "705480301"
        ],
        "dialogs": {
          "705480301": {
            "id": "705480301",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "完成了，专为丽莎调制的新品…",
            "nextDialogs": [
              "705480302"
            ]
          },
          "705480302": {
            "id": "705480302",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "目标是让丽莎早早入睡，做个安稳踏实的梦，就叫它「安梦蔷薇」好了。",
            "nextDialogs": [
              "705480303"
            ]
          },
          "705480303": {
            "id": "705480303",
            "speakerId": 1000,
            "speakerName": "丽莎",
            "text": "从色彩搭配到杯型都有调整，和第一杯的风格完全不同了…",
            "nextDialogs": [
              "705480304"
            ]
          },
          "705480304": {
            "id": "705480304",
            "speakerId": 1000,
            "speakerName": "丽莎",
            "text": "单论外观，的确是我喜欢的类型，就让我尝尝它的风味吧。",
            "nextDialogs": [
              "705480305"
            ]
          },
          "705480305": {
            "id": "705480305",
            "speakerId": 1000,
            "speakerName": "丽莎",
            "text": "嗯…满分。",
            "nextDialogs": [
              "705480306"
            ]
          },
          "705480306": {
            "id": "705480306",
            "speakerId": 1000,
            "speakerName": "丽莎",
            "text": "就像是…享用了贵重的甜品后，沿着果酒湖畔散步，吹着轻柔的湖风，松弛而悠闲…",
            "nextDialogs": [
              "705480307"
            ]
          },
          "705480307": {
            "id": "705480307",
            "speakerId": 1000,
            "speakerName": "丽莎",
            "text": "真真切切驱离了疲惫感，又不至于太过亢奋。",
            "nextDialogs": [
              "705480308"
            ]
          },
          "705480308": {
            "id": "705480308",
            "speakerId": 1000,
            "speakerName": "丽莎",
            "text": "呵~困意已经上来了，作为睡前的饮品，效果实在太棒…",
            "nextDialogs": [
              "705480309"
            ]
          },
          "705480309": {
            "id": "705480309",
            "speakerId": 1000,
            "speakerName": "丽莎",
            "text": "值得我专门写一篇短文，来称赞这杯特调，并将小可爱的名字冠上「调饮新天才」的称号。",
            "nextDialogs": [
              "705480312"
            ]
          },
          "705480312": {
            "id": "705480312",
            "speakerId": 1000,
            "speakerName": "丽莎",
            "text": "说起来，确实可以找个天气晴朗干爽，阳光又不太燥热的日子，在湖边散散步呢。",
            "nextDialogs": [
              "705480313"
            ]
          },
          "705480313": {
            "id": "705480313",
            "speakerId": 1000,
            "speakerName": "丽莎",
            "text": "要是有小可爱陪着我，边走边聊天，一定更闲适…",
            "nextDialogs": [
              "705480314"
            ]
          },
          "705480314": {
            "id": "705480314",
            "speakerId": 1000,
            "speakerName": "丽莎",
            "text": "等到归来的时候，再为我调上这么一杯「安梦蔷薇」，就无可挑剔啦。"
          }
        }
      }
    },
    {

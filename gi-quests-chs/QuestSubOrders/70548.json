    {
      "subId": "7054806",
      "subQuestName": "(test)隐藏$HIDDEN",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "705480201"
        ],
        "dialogs": {
          "705480201": {
            "id": "705480201",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "这杯是「雪韵晨晖」，请慢用。",
            "nextDialogs": [
              "705480202"
            ]
          },
          "705480202": {
            "id": "705480202",
            "speakerId": 1000,
            "speakerName": "丽莎",
            "text": "真不错，小可爱~",
            "nextDialogs": [
              "705480203"
            ]
          },
          "705480203": {
            "id": "705480203",
            "speakerId": 1000,
            "speakerName": "丽莎",
            "text": "酸度适中，甜而不腻，入口温润，回甘轻快。",
            "nextDialogs": [
              "705480204"
            ]
          },
          "705480204": {
            "id": "705480204",
            "speakerId": 1000,
            "speakerName": "丽莎",
            "text": "不过，我感觉，喝完这杯特调后，好像更有精神了…",
            "nextDialogs": [
              "705480205"
            ]
          },
          "705480205": {
            "id": "705480205",
            "speakerId": 1000,
            "speakerName": "丽莎",
            "text": "说不定，你在冥冥之中破解了格兰菲狄的秘密，调出了比她更厉害的提神饮品？",
            "nextDialogs": [
              "705480208"
            ]
          },
          "705480208": {
            "id": "705480208",
            "speakerId": 1000,
            "speakerName": "丽莎",
            "text": "没事，不着急~你的眼神里充满好奇，好像还有许多想问我的事？",
            "nextDialogs": [
              "705480209"
            ]
          },
          "705480209": {
            "id": "705480209",
            "speakerId": 1000,
            "speakerName": "丽莎",
            "text": "我们聊聊天，你慢慢想想，很快就有灵感啦。",
            "nextDialogs": [
              "705480210"
            ]
          },
          "705480210": {
            "id": "705480210",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "今天丽莎追回了哪些书？",
            "nextDialogs": [
              "705480211"
            ]
          },
          "705480211": {
            "id": "705480211",
            "speakerId": 1000,
            "speakerName": "丽莎",
            "text": "让我有点烦恼，又有些哭笑不得的问题呀。",
            "nextDialogs": [
              "705480212"
            ]
          },
          "705480212": {
            "id": "705480212",
            "speakerId": 1000,
            "speakerName": "丽莎",
            "text": "一位刚刚出师，从枫丹来到歌德大饭店任职的厨师，借走了最贵重的那本《千年蒙德甜品全书》。",
            "nextDialogs": [
              "705480213"
            ]
          },
          "705480213": {
            "id": "705480213",
            "speakerId": 1000,
            "speakerName": "丽莎",
            "text": "她居然想用制作甜品的思路，来改良各种肉菜，减轻油腻感…"
          }
        }
      }
    },

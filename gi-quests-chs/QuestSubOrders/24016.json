    "派蒙": 3
  },
  "subQuests": [
    {
      "subId": "2401601",
      "subQuestName": "与沙尔梅对话",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "240160101"
        ],
        "dialogs": {
          "240160101": {
            "id": "240160101",
            "speakerId": 5256,
            "speakerName": "沙尔梅",
            "text": "这样就差不多了…希望这些资料真能派上用场。",
            "nextDialogs": [
              "240160102"
            ]
          },
          "240160102": {
            "id": "240160102",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "你还在这里整理资料？",
            "nextDialogs": [
              "240160103"
            ]
          },
          "240160103": {
            "id": "240160103",
            "speakerId": 5256,
            "speakerName": "沙尔梅",
            "text": "哎呀，很高兴见到您，荣誉高级研究员。",
            "nextDialogs": [
              "240160104"
            ]
          },
          "240160104": {
            "id": "240160104",
            "speakerId": 5256,
            "speakerName": "沙尔梅",
            "text": "没错，按照雷蒙多先生的指示，我还在继续整理资料和卷宗呢…欸，我之前是不是说过一遍了？",
            "nextDialogs": [
              "240160105"
            ]
          },
          "240160105": {
            "id": "240160105",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "这地方这么大，就你一个人工作的话也太辛苦了，雷蒙多怎么都没派人来帮你呀。",
            "nextDialogs": [
              "240160106"
            ]
          },
          "240160106": {
            "id": "240160106",
            "speakerId": 5256,
            "speakerName": "沙尔梅",
            "text": "科学院现在诸事繁忙，分不出人来帮我也是情理之中。",
            "nextDialogs": [
              "240160107"
            ]
          },
          "240160107": {
            "id": "240160107",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "亏你还是「主任」呢…",
            "nextDialogs": [
              "240160108"
            ]
          },
          "240160108": {
            "id": "240160108",
            "speakerId": 5256,
            "speakerName": "沙尔梅",
            "text": "您是说「枫丹科学院文材回收组主任」这个头衔吗？唉，还请您别笑话我…",
            "nextDialogs": [
              "240160109"
            ]
          },
          "240160109": {
            "id": "240160109",
            "speakerId": 5256,
            "speakerName": "沙尔梅",
            "text": "我哪里是什么「主任」呀。从一开始，我就只是一个负责整理卷宗的普通职员。",
            "nextDialogs": [
              "240160110"
            ]
          },
          "240160110": {
            "id": "240160110",
            "speakerId": 5256,
            "speakerName": "沙尔梅",
            "text": "自从被雷蒙多先生指派来这里整理之后，就突然被告知，多了这么一个头衔。",
            "nextDialogs": [
              "240160111"
            ]
          },
          "240160111": {
            "id": "240160111",
            "speakerId": 5256,
            "speakerName": "沙尔梅",
            "text": "有人告诉我，这是舒瓦瑟尔先生的意见，说他觉得我们工作很辛苦，这么做主要是方便给我们多发点补贴…",
            "nextDialogs": [
              "240160112"
            ]
          },
          "240160112": {
            "id": "240160112",
            "speakerId": 5256,
            "speakerName": "沙尔梅",
            "text": "哎呀！您可别告诉别人，我…我怎么说出来了…",
            "nextDialogs": [
              "240160113"
            ]
          },
          "240160113": {
            "id": "240160113",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "我不会告诉别人的，放心。",
            "nextDialogs": [
              "240160114"
            ]
          },
          "240160114": {
            "id": "240160114",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "听起来像是好事呢。辛苦做了很多事的人，拿多一点报酬也没问题呀。",
            "nextDialogs": [
              "240160115"
            ]
          },
          "240160115": {
            "id": "240160115",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "不过，为什么要用这么绕的方法呢？直接把报酬发给大家不就好了吗？",
            "nextDialogs": [
              "240160118"
            ]
          },
          "240160118": {
            "id": "240160118",
            "speakerId": 5256,
            "speakerName": "沙尔梅",
            "text": "唉，我是不能理解舒瓦瑟尔先生和雷蒙多先生在想什么呢…",
            "nextDialogs": [
              "240160119"
            ]
          },
          "240160119": {
            "id": "240160119",
            "speakerId": 5256,
            "speakerName": "沙尔梅",
            "text": "但无论如何，我都得继续工作才行，还有很多事要做。",
            "nextDialogs": [
              "240160120"
            ]
          },
          "240160120": {
            "id": "240160120",
            "speakerId": 5256,
            "speakerName": "沙尔梅",
            "text": "荣誉高级研究员，如果您愿意的话，能帮帮我吗？"
          }
        }
      }
    },
    {
      "subId": "2401602",
      "subQuestName": "清理污渍",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "240160201"
        ],
        "dialogs": {
          "240160201": {
            "id": "240160201",
            "speakerId": 5256,
            "speakerName": "沙尔梅",
            "text": "唉，平时我怎么没觉得院里有这么多卷宗…"
          }
        }
      }
    },
    {
      "subId": "2401603",
      "subQuestName": "(test)隐藏任务，判断是否击中资料$HIDDEN",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "240160301"
        ],
        "dialogs": {
          "240160301": {
            "id": "240160301",
            "speakerId": 5256,
            "speakerName": "沙尔梅",
            "text": "呼…多谢您帮忙。要是没您帮忙，我都不知道要收拾到什么时候去了。",
            "nextDialogs": [
              "240160302"
            ]
          },
          "240160302": {
            "id": "240160302",
            "speakerId": 5256,
            "speakerName": "沙尔梅",
            "text": "真不愧是荣誉高级研究员，无论做什么事都这么利落。",
            "nextDialogs": [
              "240160306",
              "240160305"
            ]
          },
          "240160306": {
            "id": "240160306",
            "speakerId": 5256,
            "speakerName": "沙尔梅",
            "text": "再次感谢您帮忙啦，荣誉高级研究员，这些东西请收下吧。"
          },
          "240160305": {
            "id": "240160305",
            "speakerId": 5256,
            "speakerName": "沙尔梅",
            "text": "欸？那您还真是多才多艺。不愧是荣誉高级研究员！"
          }
        }
      }
    },
    {
      "subId": "2401604",
      "subQuestName": "向沙尔梅回报",
      "sceneId": null,
      "locations": [],

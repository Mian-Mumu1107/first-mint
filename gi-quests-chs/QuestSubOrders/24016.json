      }
    },
    {
      "subId": "2401604",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "240160401"
        ],
        "dialogs": {
          "240160401": {
            "id": "240160401",
            "speakerId": 5256,
            "speakerName": "沙尔梅",
            "text": "呼…多谢您帮忙。要是没您帮忙，我都不知道要收拾到什么时候去了。",
            "nextDialogs": [
              "240160402"
            ]
          },
          "240160402": {
            "id": "240160402",
            "speakerId": 5256,
            "speakerName": "沙尔梅",
            "text": "不过，要是您帮忙时用的力度能小一点的话，就更好了…",
            "nextDialogs": [
              "240160405"
            ]
          },
          "240160405": {
            "id": "240160405",
            "speakerId": 5256,
            "speakerName": "沙尔梅",
            "text": "您别误会！我没有责怪的意思，这已经帮了我大忙了。",
            "nextDialogs": [
              "240160406"
            ]
          },
          "240160406": {
            "id": "240160406",
            "speakerId": 5256,
            "speakerName": "沙尔梅",
            "text": "这些东西给您，多谢您帮忙了，荣誉高级研究员。"
          }
        }
      }
    }
  ]
}
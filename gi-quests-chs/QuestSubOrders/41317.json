      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "413111101"
        ],
        "dialogs": {
          "413111101": {
            "id": "413111101",
            "speakerId": 30039,
            "speakerName": "望雅",
            "text": "你们回来了，怎么样，宜年做的菜味道还不错吧？",
            "nextDialogs": [
              "413111102"
            ]
          },
          "413111102": {
            "id": "413111102",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "很好吃！",
            "nextDialogs": [
              "413111103"
            ]
          },
          "413111103": {
            "id": "413111103",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "他说不会参考那份文件…",
            "nextDialogs": [
              "413111104"
            ]
          },
          "413111104": {
            "id": "413111104",
            "speakerId": 30039,
            "speakerName": "望雅",
            "text": "是吗？他去年也是这么说的…要是他愿意根据我们的建议打广告的话，营收应该会更多才对。",
            "nextDialogs": [
              "413111105"
            ]
          },
          "413111105": {
            "id": "413111105",
            "speakerId": 30039,
            "speakerName": "望雅",
            "text": "算了，不用在意这些。来，之前说好的礼物，这个「霄灯」给你们。",
            "nextDialogs": [
              "413111106"
            ]
          },
          "413111106": {
            "id": "413111106",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "哇，好漂亮的灯，这是怎么做的呀？",
            "nextDialogs": [
              "413111107"
            ]
          },
          "413111107": {
            "id": "413111107",
            "speakerId": 30039,
            "speakerName": "望雅",
            "text": "唔…编制的方法我一时半会也讲不明白。",
            "nextDialogs": [
              "413111108"
            ]
          },
          "413111108": {
            "id": "413111108",
            "speakerId": 30039,
            "speakerName": "望雅",
            "text": "如果你们对「霄灯」感兴趣的话，可以去旁边问问<color=#00E1FFFF>景明</color>，他是负责「霄灯」和「明霄灯」的人。",
            "nextDialogs": [
              "413111109"
            ]
          },
          "413111109": {
            "id": "413111109",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "那个好大好大的灯，也是他在负责吗？",
            "nextDialogs": [
              "413111110"
            ]
          },
          "413111110": {
            "id": "413111110",
            "speakerId": 30039,
            "speakerName": "望雅",
            "text": "对，他应该就在旁边不远，应该很容易就能找到。",
            "nextDialogs": [
              "413111111"
            ]
          },
          "413111111": {
            "id": "413111111",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "要是能亲手编个「霄灯」带给魈的话，他也许会变得开心一点…",
            "nextDialogs": [
              "413111112"
            ]
          },
          "413111112": {
            "id": "413111112",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "我们快去找那位<color=#00E1FFFF>景明</color>问问看吧。"
          }
        }
      }
    }
  ]
}
    {
      "subId": "4008601",
      "subQuestName": "与莱依拉会合",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "400860101"
        ],
        "dialogs": {
          "400860101": {
            "id": "400860101",
            "speakerId": 1000,
            "speakerName": "莱依拉",
            "text": "#{NICKNAME}，派蒙，还有「咚咚小圆帽」，我们在这里！",
            "nextDialogs": [
              "400860102"
            ]
          },
          "400860102": {
            "id": "400860102",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "莱依拉！这几天和「转转悠悠兽」玩得还开心吗？",
            "nextDialogs": [
              "400860103"
            ]
          },
          "400860103": {
            "id": "400860103",
            "speakerId": 1000,
            "speakerName": "莱依拉",
            "text": "当然了！有「转转悠悠兽」帮我拖行李，我们去了很远的地方露营，见识到了不一样的星空美景，还推进了论文！",
            "nextDialogs": [
              "400860104"
            ]
          },
          "400860104": {
            "id": "400860104",
            "speakerId": 1000,
            "speakerName": "莱依拉",
            "text": "不过，清单上提到的东西都快做完了，面粉这样的食材经常呛得我不停咳嗽…我还是没能找到「转转悠悠兽」的最爱。",
            "nextDialogs": [
              "400860105"
            ]
          },
          "400860105": {
            "id": "400860105",
            "speakerId": 1000,
            "speakerName": "莱依拉",
            "text": "如果改进后的「意智宝珠」能让我们和蕈兽直接对话就好了…嗯！我把这件事也写进信里，托人问问生论派的资深学者吧！",
            "nextDialogs": [
              "400860106"
            ]
          },
          "400860106": {
            "id": "400860106",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "莱依拉好像拿出了前所未有的干劲！说了这么多话还很精神…为了伙伴居然能做到这种程度！",
            "nextDialogs": [
              "400860107"
            ]
          },
          "400860107": {
            "id": "400860107",
            "speakerId": 1000,
            "speakerName": "莱依拉",
            "text": "呃啊，力气消耗过度了，我们赶快去见八重小姐吧…不然我又撑不住了…"
          }
        }
      }
    },
    {
      "subId": "4008602",
      "subQuestName": "与八重神子会合",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "400860201"
        ],
        "dialogs": {
          "400860201": {
            "id": "400860201",
            "speakerId": 1002,
            "speakerName": "八重神子",
            "text": "嗯？来得还挺早啊…",
            "nextDialogs": [
              "400860202"
            ]
          },
          "400860202": {
            "id": "400860202",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "神子，你这就要走了吗？总感觉你都没好好在须弥玩玩…",
            "nextDialogs": [
              "400860203"
            ]
          },
          "400860203": {
            "id": "400860203",
            "speakerId": 1002,
            "speakerName": "八重神子",
            "text": "我早就尽兴了哦。托你们的福，这次的取材很顺利，不止得到了宝贵的参赛体验，还有破坏阴谋的精彩戏码…",
            "nextDialogs": [
              "400860204"
            ]
          },
          "400860204": {
            "id": "400860204",
            "speakerId": 1002,
            "speakerName": "八重神子",
            "text": "嗯，不如直接让左右加放弃自己原创的人物，以你们为主角创作下一部小说好了！",
            "nextDialogs": [
              "400860207"
            ]
          },
          "400860207": {
            "id": "400860207",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "对哦！现在我终于明白了，原来你之前给过我们好多次暗示！",
            "nextDialogs": [
              "400860208"
            ]
          },
          "400860208": {
            "id": "400860208",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "明明早点揭穿埃尔欣根就可以了，为什么要绕这么大的弯子啊？",
            "nextDialogs": [
              "400860209"
            ]
          },
          "400860209": {
            "id": "400860209",
            "speakerId": 1002,
            "speakerName": "八重神子",
            "text": "一开始就点破真相，岂不是太无聊了？我很想见识一下，你们会如何应对这种局面呢。结果你们给了我一个莫大的惊喜…",
            "nextDialogs": [
              "400860210"
            ]
          },
          "400860210": {
            "id": "400860210",
            "speakerId": 1002,
            "speakerName": "八重神子",
            "text": "我原以为，你们和蕈兽之间的故事，会是「主人」与「仆从」的展开，但你们有了在这之上的答案…平等默契的「伙伴」。",
            "nextDialogs": [
              "400860211"
            ]
          },
          "400860211": {
            "id": "400860211",
            "speakerId": 1002,
            "speakerName": "八重神子",
            "text": "从另一个角度考虑，总是念及「主人」的埃尔欣根，会栽在你们手里，也是情理之中。当然，以他的手腕，也许还会闹腾一会儿…",
            "nextDialogs": [
              "400860212"
            ]
          },
          "400860212": {
            "id": "400860212",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "我又开始听不懂了…下次还是把神子的话写下来，拿回去好好研究吧。",
            "nextDialogs": [
              "400860213"
            ]
          },
          "400860213": {
            "id": "400860213",
            "speakerId": 1002,
            "speakerName": "八重神子",
            "text": "闲聊到此为止，「百雷遮罗」就交给你们了。记得照顾好它哟。",
            "nextDialogs": [
              "400860214"
            ]
          },
          "400860214": {
            "id": "400860214",
            "speakerId": 1002,
            "speakerName": "八重神子",
            "text": "你们和海妮耶都要加把劲啊，这样有趣的大赛能否继续举办下去，全都取决于你们今后的作为了，我还有点期待呢。"
          }
        }
      }
    },
    {
      "subId": "4008603",
      "subQuestName": "与海妮耶会合",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "400860301"
        ],
        "dialogs": {
          "400860301": {
            "id": "400860301",
            "speakerId": 1003,
            "speakerName": "海妮耶",
            "text": "你们来了，时间正好。",
            "nextDialogs": [
              "400860302"
            ]
          },
          "400860302": {
            "id": "400860302",
            "speakerId": 1003,
            "speakerName": "海妮耶",
            "text": "我收集了其他参赛选手的「意智宝珠」，选好了适合蕈兽伙伴生活的地点，绝不会对周围的生态环境造成恶劣影响。",
            "nextDialogs": [
              "400860303"
            ]
          },
          "400860303": {
            "id": "400860303",
            "speakerId": 1003,
            "speakerName": "海妮耶",
            "text": "向大家问好吧，「欢腾之火」。",
            "nextDialogs": [
              "400860304"
            ]
          },
          "400860304": {
            "id": "400860304",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "「欢腾之火」？",
            "nextDialogs": [
              "400860305"
            ]
          },
          "400860305": {
            "id": "400860305",
            "speakerId": 1003,
            "speakerName": "海妮耶",
            "text": "这是「火一」的新名字。最初和它相遇时，我发现它如此乖巧，其实也有过欢腾的心情。",
            "nextDialogs": [
              "400860306"
            ]
          },
          "400860306": {
            "id": "400860306",
            "speakerId": 1003,
            "speakerName": "海妮耶",
            "text": "要是早点破除那种固有的偏见，不再压制自己的真情实感，不去憎恨蕈兽…或许这种心情会一直持续下去吧。",
            "nextDialogs": [
              "400860307"
            ]
          },
          "400860307": {
            "id": "400860307",
            "speakerId": 1000,
            "speakerName": "莱依拉",
            "text": "海妮耶总算彻底解开心结了…",
            "nextDialogs": [
              "400860308"
            ]
          },
          "400860308": {
            "id": "400860308",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "这样才对嘛！虽然我也有点习惯「火一」这个名字了，可这个新名字的意义无比重大！",
            "nextDialogs": [
              "400860311"
            ]
          },
          "400860311": {
            "id": "400860311",
            "speakerId": 1003,
            "speakerName": "海妮耶",
            "text": "我决定以最严格的标准要求自己，务必照顾好这些性情温和的蕈兽。请放心将伙伴们交给我吧。",
            "nextDialogs": [
              "400860312"
            ]
          },
          "400860312": {
            "id": "400860312",
            "speakerId": 1000,
            "speakerName": "莱依拉",
            "text": "这样一来，就到了分别的时候了…",
            "nextDialogs": [
              "400860313"
            ]
          },
          "400860313": {
            "id": "400860313",
            "speakerId": 1000,
            "speakerName": "莱依拉",
            "text": "去吧，「转转悠悠兽」，要好好听海妮耶的话哦…",
            "nextDialogs": [
              "400860314"
            ]
          },
          "400860314": {
            "id": "400860314",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "「百雷遮罗」，等到下次举办「驯兽师大赛」，神子还会来看你的哦。",
            "nextDialogs": [
              "400860315"
            ]
          },
          "400860315": {
            "id": "400860315",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "「咚咚小圆帽」…我们再来击掌吧！这段时间我很开心，你也要高高兴兴地生活，期待着和我们重逢的那天啊！",
            "nextDialogs": [
              "400860316"
            ]
          },
          "400860316": {
            "id": "400860316",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "一定会再见的！",
            "nextDialogs": [
              "400860317"
            ]
          },
          "400860317": {
            "id": "400860317",
            "speakerId": 1003,
            "speakerName": "海妮耶",
            "text": "希望人和蕈兽和谐共处的那天能尽早到来。",
            "nextDialogs": [
              "400860318"
            ]
          },
          "400860318": {
            "id": "400860318",
            "speakerId": 1003,
            "speakerName": "海妮耶",
            "text": "我相信你们！等着你们的好消息！"
          }
        }
      }
    }
  ]
}
{
  "lineCounts": {
    "Player": 36,
    "古田": 22,
    "天目十五": 27,
    "宏达": 7,
    "泽维尔": 24,
    "派蒙": 34
  },
  "subQuests": [
    {
      "subId": "303002",
      "subQuestName": "与天目十五对话",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "30300201"
        ],
        "dialogs": {
          "30300201": {
            "id": "30300201",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "到天目锻冶屋了！",
            "nextDialogs": [
              "30300202"
            ]
          },
          "30300202": {
            "id": "30300202",
            "speakerId": 1001,
            "speakerName": "天目十五",
            "text": "噢，许久不见了。",
            "nextDialogs": [
              "30300203"
            ]
          },
          "30300203": {
            "id": "30300203",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "您好，我想打听一些消息。",
            "nextDialogs": [
              "30300204"
            ]
          },
          "30300204": {
            "id": "30300204",
            "speakerId": 1001,
            "speakerName": "天目十五",
            "text": "当然可以啦，请说。",
            "nextDialogs": [
              "30300207"
            ]
          },
          "30300207": {
            "id": "30300207",
            "speakerId": 1001,
            "speakerName": "天目十五",
            "text": "噢，没想到你会问起这些…也好，想知道的话，我就再说说。",
            "nextDialogs": [
              "30300208"
            ]
          },
          "30300208": {
            "id": "30300208",
            "speakerId": 1001,
            "speakerName": "天目十五",
            "text": "曾享誉稻妻的「雷电五传」，乃是这五支：天目、经津、一心、百目、千手。",
            "nextDialogs": [
              "30300209"
            ]
          },
          "30300209": {
            "id": "30300209",
            "speakerId": 1001,
            "speakerName": "天目十五",
            "text": "五方所用的锻造技艺，最初是由将军大人亲自传下，经诸多天赋异禀的工匠改进后变得越发优异。",
            "nextDialogs": [
              "30300210"
            ]
          },
          "30300210": {
            "id": "30300210",
            "speakerId": 1001,
            "speakerName": "天目十五",
            "text": "后来，这些锻刀世家渐渐都没落了。流传至今的，原本只有我们「天目」一脉。",
            "nextDialogs": [
              "30300211"
            ]
          },
          "30300211": {
            "id": "30300211",
            "speakerId": 1001,
            "speakerName": "天目十五",
            "text": "但好在近期枫原万叶回到稻妻，继承了「一心传」的技艺。如此一来，五传算是还剩两家。",
            "nextDialogs": [
              "30300212"
            ]
          },
          "30300212": {
            "id": "30300212",
            "speakerId": 1001,
            "speakerName": "天目十五",
            "text": "要是我没记错，他锻刀那次，你也在场呢。",
            "nextDialogs": [
              "30300213"
            ]
          },
          "30300213": {
            "id": "30300213",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "这么一说我也想起来了，是有这回事！",
            "nextDialogs": [
              "30300214"
            ]
          },
          "30300214": {
            "id": "30300214",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "当时就听说了雷电五传没落的事，听得我好唏嘘呀…",
            "nextDialogs": [
              "30300215"
            ]
          },
          "30300215": {
            "id": "30300215",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "那没落的原因是…？",
            "nextDialogs": [
              "30300216"
            ]
          },
          "30300216": {
            "id": "30300216",
            "speakerId": 1001,
            "speakerName": "天目十五",
            "text": "…唉。如此说起来，又是一段伤心事。",
            "nextDialogs": [
              "30300217"
            ]
          },
          "30300217": {
            "id": "30300217",
            "speakerId": 1001,
            "speakerName": "天目十五",
            "text": "本来，那都不是我能知道的东西，但我多年来只听说各家衰落，至今不清楚缘由…在意之下，就请教了枫原万叶。",
            "nextDialogs": [
              "30300218"
            ]
          },
          "30300218": {
            "id": "30300218",
            "speakerId": 1001,
            "speakerName": "天目十五",
            "text": "他告诉我，同为雷电五传后人，他认为我应当知道这些。",
            "nextDialogs": [
              "30300219"
            ]
          },
          "30300219": {
            "id": "30300219",
            "speakerId": 1001,
            "speakerName": "天目十五",
            "text": "…告诉你也无妨。只不过，这个故事并不让人高兴就是了。",
            "nextDialogs": [
              "30300220"
            ]
          },
          "30300220": {
            "id": "30300220",
            "speakerId": 1001,
            "speakerName": "天目十五",
            "text": "——雷电五传，是被一个杀红了眼的刀匠后人给报复了。",
            "nextDialogs": [
              "30300221"
            ]
          },
          "30300221": {
            "id": "30300221",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "报复？为什么呢？",
            "nextDialogs": [
              "30300222"
            ]
          },
          "30300222": {
            "id": "30300222",
            "speakerId": 1001,
            "speakerName": "天目十五",
            "text": "传说四百余年前踏鞴砂的炉心发生事故。某位刀匠当时在场，为救众人，不顾自己安危冲入炉中…",
            "nextDialogs": [
              "30300223"
            ]
          },
          "30300223": {
            "id": "30300223",
            "speakerId": 1001,
            "speakerName": "天目十五",
            "text": "踏鞴砂的锻造冶炼技术十分了得，而当年负责管理踏鞴砂的造兵司正姓丹羽，丹羽与枫原有姻亲。",
            "nextDialogs": [
              "30300224"
            ]
          },
          "30300224": {
            "id": "30300224",
            "speakerId": 1001,
            "speakerName": "天目十五",
            "text": "造兵司正丹羽大人与那名刀匠一同跃入炉中，这之后，炉心似乎安稳下来，但他们二人也…",
            "nextDialogs": [
              "30300225"
            ]
          },
          "30300225": {
            "id": "30300225",
            "speakerId": 1001,
            "speakerName": "天目十五",
            "text": "刀匠家一落千丈，他的儿子因而成了无人照看的孤儿，每一天都活在憎恨之中。",
            "nextDialogs": [
              "30300226"
            ]
          },
          "30300226": {
            "id": "30300226",
            "speakerId": 1001,
            "speakerName": "天目十五",
            "text": "他将此事归咎于整个稻妻，憎恨将军大人对父亲的死不闻不问，憎恨一切未能挽救他父亲的人…",
            "nextDialogs": [
              "30300227"
            ]
          },
          "30300227": {
            "id": "30300227",
            "speakerId": 1001,
            "speakerName": "天目十五",
            "text": "他很无力，只能将落魄之恨传给子孙。这户人家便世世代代背负着恨意，过着苦闷的生活。",
            "nextDialogs": [
              "30300228"
            ]
          },
          "30300228": {
            "id": "30300228",
            "speakerId": 1001,
            "speakerName": "天目十五",
            "text": "原本，故事到这里就可以结束了。但百年前那代家主对现状极为不满，又无力翻身。",
            "nextDialogs": [
              "30300229"
            ]
          },
          "30300229": {
            "id": "30300229",
            "speakerId": 1001,
            "speakerName": "天目十五",
            "text": "最终…他做出一个极为偏激的决定——向雷电五传复仇，泄愤之余还能动摇稻妻的锻造业根基。",
            "nextDialogs": [
              "30300230"
            ]
          },
          "30300230": {
            "id": "30300230",
            "speakerId": 1001,
            "speakerName": "天目十五",
            "text": "那人来自百目家族，却连自家的其他匠人都杀。近百年前，就是他主导了一切攻击。",
            "nextDialogs": [
              "30300231"
            ]
          },
          "30300231": {
            "id": "30300231",
            "speakerId": 1001,
            "speakerName": "天目十五",
            "text": "然而，对付枫原家与神里家的后人与刀匠时，因有旁人在场，他遭到猛烈反击，当场死去了。",
            "nextDialogs": [
              "30300232"
            ]
          },
          "30300232": {
            "id": "30300232",
            "speakerId": 1001,
            "speakerName": "天目十五",
            "text": "也是因为这样，枫原所代表的「一心流」才未遭到灭绝，姑且能说是不幸中的万幸。",
            "nextDialogs": [
              "30300233"
            ]
          },
          "30300233": {
            "id": "30300233",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "（有关雷电五传的传说变得不一样了，当时加害诸位刀匠的竟然另有其人？）",
            "nextDialogs": [
              "30300234"
            ]
          },
          "30300234": {
            "id": "30300234",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "（看来，散兵确实对世界树做了什么。但…丹羽似乎还是死去了。）",
            "nextDialogs": [
              "30300235"
            ]
          },
          "30300235": {
            "id": "30300235",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "#{NICKNAME}，你还有其他要问的吗？",
            "nextDialogs": [
              "30300236"
            ]
          },
          "30300236": {
            "id": "30300236",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "您这几天见过万叶吗？",
            "nextDialogs": [
              "30300237"
            ]
          },
          "30300237": {
            "id": "30300237",
            "speakerId": 1001,
            "speakerName": "天目十五",
            "text": "枫原万叶啊，昨天还来我这坐了坐，聊了会儿天，喝了杯茶。看他的样子，精神还不错呢。",
            "nextDialogs": [
              "30300238"
            ]
          },
          "30300238": {
            "id": "30300238",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "（太好了，人还存在…而且没有什么异样，怎么说都比昨晚想的极端情况好得多。）",
            "nextDialogs": [
              "30300239"
            ]
          },
          "30300239": {
            "id": "30300239",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "我没有其他问题了，谢谢您。",
            "nextDialogs": [
              "30300240"
            ]
          },
          "30300240": {
            "id": "30300240",
            "speakerId": 1001,
            "speakerName": "天目十五",
            "text": "不用客气。",
            "nextDialogs": [
              "30300241"
            ]
          },
          "30300241": {
            "id": "30300241",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "看你的表情，是不是还要去其他地方呀？哼哼，我可是很会察言观色的哦！",
            "nextDialogs": [
              "30300242"
            ]
          },
          "30300242": {
            "id": "30300242",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "那么出发吧，前往下一站！你走前面，我跟着就是。"
          }
        }
      }
    },
    {
      "subId": "303010",
      "subQuestName": "前往社奉行府",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "30301201"
        ],
        "dialogs": {
          "30301201": {
            "id": "30301201",
            "speakerId": 1002,
            "speakerName": "古田",
            "text": "都是实话。",
            "nextDialogs": [
              "30301202"
            ]
          },
          "30301202": {
            "id": "30301202",
            "speakerId": 1002,
            "speakerName": "古田",
            "text": "平日奉行大人用膳，托马大人总会陪伴左右。在旁服侍顺道听听他们闲聊，是我最放松的时刻之一。",
            "nextDialogs": [
              "30301203"
            ]
          },
          "30301203": {
            "id": "30301203",
            "speakerId": 1002,
            "speakerName": "古田",
            "text": "公务不由人，奉行大人有时不得不在外用餐，可若能回来，他还是比较喜欢在府内用膳。",
            "nextDialogs": [
              "30301204"
            ]
          },
          "30301204": {
            "id": "30301204",
            "speakerId": 1002,
            "speakerName": "古田",
            "text": "据说是因为托马大人的料理能力比一般厨师更出众，呵呵，奉行大人心中总是有「家」。",
            "nextDialogs": [
              "30301205"
            ]
          },
          "30301205": {
            "id": "30301205",
            "speakerId": 1002,
            "speakerName": "古田",
            "text": "您或许还不知道，他们也会聊到您。那种口气，像是说一个认识挺久，能谈得来的朋友。",
            "nextDialogs": [
              "30301206"
            ]
          },
          "30301206": {
            "id": "30301206",
            "speakerId": 1002,
            "speakerName": "古田",
            "text": "大小姐偶尔也会陪着一起，而最近几次家族团聚的时刻，免不了说到有趣的人事与见闻。这其中，总是有您一份。",
            "nextDialogs": [
              "30301207"
            ]
          },
          "30301207": {
            "id": "30301207",
            "speakerId": 1002,
            "speakerName": "古田",
            "text": "…前代奉行大人与夫人过世至今，神里家也走过了许多个年头啊。",
            "nextDialogs": [
              "30301208"
            ]
          },
          "30301208": {
            "id": "30301208",
            "speakerId": 1002,
            "speakerName": "古田",
            "text": "老婆子我看着奉行大人与大小姐长大，像他们这般身份能结交到有趣又可靠的朋友，真是太好啦。",
            "nextDialogs": [
              "30301209"
            ]
          },
          "30301209": {
            "id": "30301209",
            "speakerId": 1002,
            "speakerName": "古田",
            "text": "所以，您若有时间，欢迎常来奉行府走走。就当是老婆子我冒昧的请求了。",
            "nextDialogs": [
              "30301212"
            ]
          },
          "30301212": {
            "id": "30301212",
            "speakerId": 1002,
            "speakerName": "古田",
            "text": "那真是太好了，呵呵，谢谢您。",
            "nextDialogs": [
              "30301213"
            ]
          },
          "30301213": {
            "id": "30301213",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "嘿嘿，我也很喜欢来这里哦，而且听婆婆刚才说的，社奉行府的饭菜是不是很棒？",
            "nextDialogs": [
              "30301214"
            ]
          },
          "30301214": {
            "id": "30301214",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "说得我都心痒了，下次我们来蹭…啊不是不是，来拜访吧！最好挑个饭点！",
            "nextDialogs": [
              "30301215"
            ]
          },
          "30301215": {
            "id": "30301215",
            "speakerId": 1002,
            "speakerName": "古田",
            "text": "当然好，欢迎呀。",
            "nextDialogs": [
              "30301401"
            ]
          },
          "30301401": {
            "id": "30301401",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "那我们就先不打扰啦，不过…呃，我们接下来要去哪里呀？",
            "nextDialogs": [
              "30301402"
            ]
          },
          "30301402": {
            "id": "30301402",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "踏鞴砂。",
            "nextDialogs": [
              "30301403"
            ]
          },
          "30301403": {
            "id": "30301403",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "好的好的，那婆婆再见！不用送我们啦！",
            "nextDialogs": [
              "30301404"
            ]
          },
          "30301404": {
            "id": "30301404",
            "speakerId": 1002,
            "speakerName": "古田",
            "text": "哎哎，好，再会。",
            "nextDialogs": [
              "30301405"
            ]
          },
          "30301405": {
            "id": "30301405",
            "speakerId": 1003,
            "speakerName": "宏达",
            "text": "二位这就要走了吗？",
            "nextDialogs": [
              "30301406"
            ]
          },
          "30301406": {
            "id": "30301406",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "对对，事办完了，你不用担心哦！",
            "nextDialogs": [
              "30301407"
            ]
          },
          "30301407": {
            "id": "30301407",
            "speakerId": 1003,
            "speakerName": "宏达",
            "text": "好，祝二位旅途顺利。再见。"
          }
        }
      }
    },
    {
      "subId": "303004",
      "subQuestName": "前往踏鞴砂寻找线索",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [],
        "dialogs": {}
      }
    },
    {
      "subId": "303006",
      "subQuestName": "与泽维尔对话",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "30300602"
        ],
        "dialogs": {
          "30300602": {
            "id": "30300602",
            "speakerId": 1004,
            "speakerName": "泽维尔",
            "text": "当然啦，我研究过这一带的炉心。",
            "nextDialogs": [
              "30300603"
            ]
          },
          "30300603": {
            "id": "30300603",
            "speakerId": 1004,
            "speakerName": "泽维尔",
            "text": "有什么要问的，尽管问吧！",
            "nextDialogs": [
              "30300604"
            ]
          },
          "30300604": {
            "id": "30300604",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "了解这里的历史吗？",
            "nextDialogs": [
              "30300605"
            ]
          },
          "30300605": {
            "id": "30300605",
            "speakerId": 1004,
            "speakerName": "泽维尔",
            "text": "了若指掌！要知道，我可是在附近来回走动过许多次的人。",
            "nextDialogs": [
              "30300606"
            ]
          },
          "30300606": {
            "id": "30300606",
            "speakerId": 1004,
            "speakerName": "泽维尔",
            "text": "而且，我还在别处遇到过以前在踏鞴砂居住过的人的后代呢。亲属所说，均是真实历史啊。",
            "nextDialogs": [
              "30300607"
            ]
          },
          "30300607": {
            "id": "30300607",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "还请介绍一下。",
            "nextDialogs": [
              "30300608"
            ]
          },
          "30300608": {
            "id": "30300608",
            "speakerId": 1004,
            "speakerName": "泽维尔",
            "text": "唔？突然这么说，三言两语可说不清啊，您应该知道吧？踏鞴砂这地方很有年头了。",
            "nextDialogs": [
              "30300609"
            ]
          },
          "30300609": {
            "id": "30300609",
            "speakerId": 1004,
            "speakerName": "泽维尔",
            "text": "据我所知，踏鞴砂作为锻造冶炼业的核心地区之一，已经有上千年历史，只不过炉心似乎出过两次问题…",
            "nextDialogs": [
              "30300610"
            ]
          },
          "30300610": {
            "id": "30300610",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "两次？哪两次呢？",
            "nextDialogs": [
              "30300611"
            ]
          },
          "30300611": {
            "id": "30300611",
            "speakerId": 1004,
            "speakerName": "泽维尔",
            "text": "最近这些年一次，几百年前还有一次。说到这个，我听稻妻人提过，踏鞴砂以前也有枫丹工匠来过。",
            "nextDialogs": [
              "30300612"
            ]
          },
          "30300612": {
            "id": "30300612",
            "speakerId": 1004,
            "speakerName": "泽维尔",
            "text": "看起来，两个国家交流技术由来已久了，那个枫丹工匠据说还是踏鞴砂的重要客人。",
            "nextDialogs": [
              "30300613"
            ]
          },
          "30300613": {
            "id": "30300613",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "（是「博士」。看来「博士」故意毁坏炉心引发动乱的历史似乎也没有受到影响…）",
            "nextDialogs": [
              "30300614"
            ]
          },
          "30300614": {
            "id": "30300614",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "喂，你到踏鞴砂来是要打听什么，要不要直接问泽维尔？",
            "nextDialogs": [
              "30300615"
            ]
          },
          "30300615": {
            "id": "30300615",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "已经在问了哦。",
            "nextDialogs": [
              "30300616"
            ]
          },
          "30300616": {
            "id": "30300616",
            "speakerId": 1004,
            "speakerName": "泽维尔",
            "text": "哦，原来二位是来研究历史的啊。",
            "nextDialogs": [
              "30300617"
            ]
          },
          "30300617": {
            "id": "30300617",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "对，这家伙今天不知道怎么了，一直在打听各种历史…",
            "nextDialogs": [
              "30300618"
            ]
          },
          "30300618": {
            "id": "30300618",
            "speakerId": 1004,
            "speakerName": "泽维尔",
            "text": "嗯？该不会是突然迸发了对历史的兴趣吧？",
            "nextDialogs": [
              "30300619"
            ]
          },
          "30300619": {
            "id": "30300619",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "是啊。所以，想再问一个问题。",
            "nextDialogs": [
              "30300620"
            ]
          },
          "30300620": {
            "id": "30300620",
            "speakerId": 1004,
            "speakerName": "泽维尔",
            "text": "好啊，请说。",
            "nextDialogs": [
              "30300621"
            ]
          },
          "30300621": {
            "id": "30300621",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "你听说过踏鞴砂有一个「倾奇者」吗？",
            "nextDialogs": [
              "30300622"
            ]
          },
          "30300622": {
            "id": "30300622",
            "speakerId": 1004,
            "speakerName": "泽维尔",
            "text": "倾奇者？唔…好像没听过呢。",
            "nextDialogs": [
              "30300623"
            ]
          },
          "30300623": {
            "id": "30300623",
            "speakerId": 1004,
            "speakerName": "泽维尔",
            "text": "我知道这个词在稻妻一般指那些特立独行、衣饰特殊的人，倒是一直想见见配得上这个说辞的人。",
            "nextDialogs": [
              "30300624"
            ]
          },
          "30300624": {
            "id": "30300624",
            "speakerId": 1004,
            "speakerName": "泽维尔",
            "text": "但很可惜，既没见过这类人，也没在与踏鞴砂有关的说法里听过相关事宜。",
            "nextDialogs": [
              "30300625"
            ]
          },
          "30300625": {
            "id": "30300625",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "（没有倾奇者…难道说散兵在世界树里做了什么，成功抹去了有关自己的记录？）",
            "nextDialogs": [
              "30300626"
            ]
          },
          "30300626": {
            "id": "30300626",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "（如果是那样，他应该是想改变世界，让一切回到原点吧。但是，目前看来所有影响只跟他自己有关？）",
            "nextDialogs": [
              "30300627"
            ]
          },
          "30300627": {
            "id": "30300627",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "谢谢你，泽维尔。",
            "nextDialogs": [
              "30300628"
            ]
          },
          "30300628": {
            "id": "30300628",
            "speakerId": 1004,
            "speakerName": "泽维尔",
            "text": "没什么，不用客气。",
            "nextDialogs": [
              "30300629"
            ]
          },
          "30300629": {
            "id": "30300629",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "要走了吗？那再见啦泽维尔！",
            "nextDialogs": [
              "30300630"
            ]
          },
          "30300630": {
            "id": "30300630",
            "speakerId": 1004,
            "speakerName": "泽维尔",
            "text": "噢！不必客气，我能帮上忙就好。",
            "nextDialogs": [
              "30300631"
            ]
          },
          "30300631": {
            "id": "30300631",
            "speakerId": 1004,
            "speakerName": "泽维尔",
            "text": "那就再会了。",
            "nextDialogs": [
              "30300632"
            ]
          },
          "30300632": {
            "id": "30300632",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "看来，你想问的事都打听到了呢。",
            "nextDialogs": [
              "30300633"
            ]
          },
          "30300633": {
            "id": "30300633",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "回去见小吉祥草王吧。",
            "nextDialogs": [
              "30300634"
            ]
          },
          "30300634": {
            "id": "30300634",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "好啊，不过，不知道你今天到底怎么了…看上去心事重重的。",
            "nextDialogs": [
              "30300635"
            ]
          },
          "30300635": {
            "id": "30300635",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "打起精神来呀！无论发生什么我都会陪着你的。",
            "nextDialogs": [
              "30300637",
              "30300639"
            ]
          },
          "30300637": {
            "id": "30300637",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "要振作哦，不行的话就吃点东西！空腹的人无法战胜生活！",
            "nextDialogs": [
              "30300640"
            ]
          },
          "30300640": {
            "id": "30300640",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "那么，出发去见纳西妲吧！"
          },
          "30300639": {
            "id": "30300639",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "我们之间客气什么嘛，嘿嘿。"
          }
        }
      }
    },
    {
      "subId": "303009",
      "subQuestName": "(test）控制泽维尔初见任务$HIDDEN",
      "sceneId": null,
      "locations": [],

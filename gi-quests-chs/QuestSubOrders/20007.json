        "dialogs": {}
      }
    },
    {
      "subId": "2000708",
      "subQuestName": "将绳索交给艾伦",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "200070601"
        ],
        "dialogs": {
          "200070601": {
            "id": "200070601",
            "speakerId": 1000,
            "speakerName": "艾伦",
            "text": "这样就可以了，虽然感觉随时可能散架，但只要能撑到蒙德城就好。",
            "nextDialogs": [
              "200070602"
            ]
          },
          "200070602": {
            "id": "200070602",
            "speakerId": 1000,
            "speakerName": "艾伦",
            "text": "谢谢你！那么我先出发了，以后来清泉镇记得来找我，我们好好喝一杯。",
            "nextDialogs": [
              "200070603"
            ]
          },
          "200070603": {
            "id": "200070603",
            "speakerId": 1000,
            "speakerName": "艾伦",
            "text": "…只要别喝得像杜拉夫先生一样就行。"
          }
        }
      }
    },
    {
      "subId": "2000702",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "200070201"
        ],
        "dialogs": {
          "200070201": {
            "id": "200070201",
            "speakerId": 1000,
            "speakerName": "艾伦",
            "text": "只需要修理几个小地方，能让车撑到蒙德城就好了。",
            "nextDialogs": [
              "200070202"
            ]
          },
          "200070202": {
            "id": "200070202",
            "speakerId": 1000,
            "speakerName": "艾伦",
            "text": "周围的树林里应该就有合适的木材。"
          }
        }
      }
    },
    {
      "subId": "2000704",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "200070401"
        ],
        "dialogs": {
          "200070401": {
            "id": "200070401",
            "speakerId": 1000,
            "speakerName": "艾伦",
            "text": "太感谢了，这帮家伙也太执着了，这些猎物有这么大的吸引力吗？",
            "nextDialogs": [
              "200070402"
            ]
          },
          "200070402": {
            "id": "200070402",
            "speakerId": 1000,
            "speakerName": "艾伦",
            "text": "也亏得杜拉夫先生能猎到这么好的猎物，要是我也能成为这样的猎人就好了。",
            "nextDialogs": [
              "200070403"
            ]
          },
          "200070403": {
            "id": "200070403",
            "speakerId": 1000,
            "speakerName": "艾伦",
            "text": "唉，在此之前，我还是先把车给弄进城吧。",
            "nextDialogs": [
              "200070404"
            ]
          },
          "200070404": {
            "id": "200070404",
            "speakerId": 1000,
            "speakerName": "艾伦",
            "text": "抱歉，旅行者，本来车都快修好了，结果刚才一阵折腾，又有个小地方出问题了。",
            "nextDialogs": [
              "200070405"
            ]
          },
          "200070405": {
            "id": "200070405",
            "speakerId": 1000,
            "speakerName": "艾伦",
            "text": "但是再呆在这只会更危险，必须把车快点修好，我记得车上有绳索，一定是被那群丘丘人给丢掉了。",
            "nextDialogs": [
              "200070406"
            ]
          },
          "200070406": {
            "id": "200070406",
            "speakerId": 1000,
            "speakerName": "艾伦",
            "text": "旅行者，能请你去帮我去周围找找<color=#00E1FFFF>绳索</color>吗？"
          }
        }
      }
    },
    {
      "subId": "2000708",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "200070801"
        ],
        "dialogs": {
          "200070801": {
            "id": "200070801",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "还有别的急事。",
            "nextDialogs": [
              "200070802"
            ]
          },
          "200070802": {
            "id": "200070802",
            "speakerId": 1000,
            "speakerName": "艾伦",
            "text": "别啊！那群家伙说不定还在附近，你就再帮我一把，让我快点离开这吧，拜托了！"
          }
        }
      }
    },
    {
      "subId": "2000710",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "200071001"
        ],
        "dialogs": {
          "200071001": {
            "id": "200071001",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "还有别的事。",
            "nextDialogs": [
              "200071002"
            ]
          },
          "200071002": {
            "id": "200071002",
            "speakerId": 1000,
            "speakerName": "艾伦",
            "text": "最——后一步了，只要把绳索拿过来就好，剩下的我自己搞定，辛苦你了！"
          }
        }
      }
    }

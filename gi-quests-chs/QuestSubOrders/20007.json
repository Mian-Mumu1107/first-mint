  "subQuests": [
    {
      "subId": "2000709",
      "subQuestName": "前去查看详情",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "200070901"
        ],
        "dialogs": {
          "200070901": {
            "id": "200070901",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "没问题。",
            "nextDialogs": [
              "200070902"
            ]
          },
          "200070902": {
            "id": "200070902",
            "speakerId": 1000,
            "speakerName": "艾伦",
            "text": "太感谢了，应该就在周围的树林里。"
          }
        }
      }
    },
    {
      "subId": "2000701",
      "subQuestName": "消灭所有魔物",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "200070101"
        ],
        "dialogs": {
          "200070101": {
            "id": "200070101",
            "speakerId": 1000,
            "speakerName": "艾伦",
            "text": "#谢，谢谢你，{NICKNAME}，太好了，我还以为这次完蛋了…",
            "nextDialogs": [
              "200070102"
            ]
          },
          "200070102": {
            "id": "200070102",
            "speakerId": 1000,
            "speakerName": "艾伦",
            "text": "这车上都是猎手们辛苦狩猎的成果，杜拉夫先生要我送去蒙德城。",
            "nextDialogs": [
              "200070103"
            ]
          },
          "200070103": {
            "id": "200070103",
            "speakerId": 1000,
            "speakerName": "艾伦",
            "text": "虽然我不…太擅长狩猎，但是押送这么简单的活，应该还是能做的，我开始是这么想的…",
            "nextDialogs": [
              "200070104"
            ]
          },
          "200070104": {
            "id": "200070104",
            "speakerId": 1000,
            "speakerName": "艾伦",
            "text": "但还是差点搞砸了。突然被这么袭击，肯定是因为这些猎物太好了，那群家伙也想要，还好你来了。",
            "nextDialogs": [
              "200070105"
            ]
          },
          "200070105": {
            "id": "200070105",
            "speakerId": 1000,
            "speakerName": "艾伦",
            "text": "呃，虽然很不好意思，但是…刚才被袭击的时候，货车也被弄坏了，想要离开这，我必须把车修好。",
            "nextDialogs": [
              "200070106"
            ]
          },
          "200070106": {
            "id": "200070106",
            "speakerId": 1000,
            "speakerName": "艾伦",
            "text": "周围的树林里应该有能用的材料。但是猎物还在车里，走开的话我实在很担心。",
            "nextDialogs": [
              "200070107"
            ]
          },
          "200070107": {
            "id": "200070107",
            "speakerId": 1000,
            "speakerName": "艾伦",
            "text": "如果可以的话，你能帮我从周围找一块<color=#00E1FFFF>结实的木板</color>来吗？"
          }
        }
      }
    },
    {
      "subId": "2000702",
      "subQuestName": "和艾伦对话",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "200070701"
        ],
        "dialogs": {
          "200070701": {
            "id": "200070701",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "我明白了。",
            "nextDialogs": [
              "200070702"
            ]
          },
          "200070702": {
            "id": "200070702",
            "speakerId": 1000,
            "speakerName": "艾伦",
            "text": "太好了，那我就在这等你，请你快一些，不然那群家伙说不定又要回来了…"
          }
        }
      }
    },
    {
      "subId": "2000703",
      "subQuestName": "收集木材",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "200070301"
        ],
        "dialogs": {
          "200070301": {
            "id": "200070301",
            "speakerId": 1000,
            "speakerName": "艾伦",
            "text": "这些就足够了，只要一小会我就能…",
            "nextDialogs": [
              "200070302"
            ]
          },
          "200070302": {
            "id": "200070302",
            "speakerId": 1000,
            "speakerName": "艾伦",
            "text": "咦…旅行者，那群家伙又来了！"
          }
        }
      }
    },
    {

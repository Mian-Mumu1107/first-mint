{
  "lineCounts": {
    "Player": 7,
    "北斗": 32,
    "派蒙": 2,
    "芭比洛斯": 17
  },
  "subQuests": [
    {
      "subId": "7469401",
      "subQuestName": "与北斗对话",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "746940101"
        ],
        "dialogs": {
          "746940101": {
            "id": "746940101",
            "speakerId": 1031,
            "speakerName": "北斗",
            "text": "那这么说来，我抽到的这张牌还算得上是一张好牌啊。",
            "nextDialogs": [
              "746940102"
            ]
          },
          "746940102": {
            "id": "746940102",
            "speakerId": 16101,
            "speakerName": "芭比洛斯",
            "text": "呵呵，命运就只是命运，从来都不分什么好坏。",
            "nextDialogs": [
              "746940103"
            ]
          },
          "746940103": {
            "id": "746940103",
            "speakerId": 16101,
            "speakerName": "芭比洛斯",
            "text": "不过，单单从你抽到的这张正位「力量」来说，其中的一层含义，倒是很适合你的职业。",
            "nextDialogs": [
              "746940104"
            ]
          },
          "746940104": {
            "id": "746940104",
            "speakerId": 16101,
            "speakerName": "芭比洛斯",
            "text": "这张牌象征热情、勇气、自信与渴望，也象征完美的、不迷失的爱。",
            "nextDialogs": [
              "746940105"
            ]
          },
          "746940105": {
            "id": "746940105",
            "speakerId": 16101,
            "speakerName": "芭比洛斯",
            "text": "无论面对何种突发事态，想必你都一定能主导并掌控局面吧。",
            "nextDialogs": [
              "746940106"
            ]
          },
          "746940106": {
            "id": "746940106",
            "speakerId": 1031,
            "speakerName": "北斗",
            "text": "哈哈哈哈哈哈，您别夸了，按照我们的规矩，抽到了好卦，要多多的给卦钱。",
            "nextDialogs": [
              "746940107"
            ]
          },
          "746940107": {
            "id": "746940107",
            "speakerId": 1031,
            "speakerName": "北斗",
            "text": "喏，我把钱袋子放桌上了，要是您有空，不如帮我们船上的兄弟都看看？",
            "nextDialogs": [
              "746940108"
            ]
          },
          "746940108": {
            "id": "746940108",
            "speakerId": 16101,
            "speakerName": "芭比洛斯",
            "text": "呵，我还是第一次听到这种请求。",
            "nextDialogs": [
              "746940109"
            ]
          },
          "746940109": {
            "id": "746940109",
            "speakerId": 1031,
            "speakerName": "北斗",
            "text": "我这一船的兄弟走南闯北，风里来浪里去的，这么多年了，每个人都揣着一肚子的难题。",
            "nextDialogs": [
              "746940110"
            ]
          },
          "746940110": {
            "id": "746940110",
            "speakerId": 1031,
            "speakerName": "北斗",
            "text": "我虽然是他们的老大，但有些问题，我也没办法帮他们解决。",
            "nextDialogs": [
              "746940111"
            ]
          },
          "746940111": {
            "id": "746940111",
            "speakerId": 1031,
            "speakerName": "北斗",
            "text": "如今遇见了您这么一位卦师，才想着请您去船上，帮他们多少开导一下心结。",
            "nextDialogs": [
              "746940112"
            ]
          },
          "746940112": {
            "id": "746940112",
            "speakerId": 1031,
            "speakerName": "北斗",
            "text": "报酬的话好说，反正我们这一趟过来，也做了几笔大生意，赚了不少…",
            "nextDialogs": [
              "746940113"
            ]
          },
          "746940113": {
            "id": "746940113",
            "speakerId": 16101,
            "speakerName": "芭比洛斯",
            "text": "虽然听着很有趣，但还是免了。我这个牌盒里，可没有那么多牌。",
            "nextDialogs": [
              "746940114"
            ]
          },
          "746940114": {
            "id": "746940114",
            "speakerId": 1031,
            "speakerName": "北斗",
            "text": "#咦，{NICKNAME}，派蒙？真是好久不见，你们也来这里算卦么？",
            "nextDialogs": [
              "746940117"
            ]
          },
          "746940117": {
            "id": "746940117",
            "speakerId": 1031,
            "speakerName": "北斗",
            "text": "当然是来做生意的，顺便来帮某人查探一下新生意的商路。"
          }
        }
      }
    },

    {
      "subId": "7425403",
      "subQuestName": "享受茶会时光",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "742540501"
        ],
        "dialogs": {
          "742540501": {
            "id": "742540501",
            "speakerId": 1000,
            "speakerName": "安",
            "text": "西摩尔！好久不见！还有玛梅赫也是！",
            "nextDialogs": [
              "742540502"
            ]
          },
          "742540502": {
            "id": "742540502",
            "speakerId": 1001,
            "speakerName": "玛梅赫",
            "text": "哈哈，西摩尔在旅途中也经常和我说他很想你们。",
            "nextDialogs": [
              "742540503"
            ]
          },
          "742540503": {
            "id": "742540503",
            "speakerId": 1002,
            "speakerName": "西摩尔",
            "text": "肯定。我无时不在思念着玛丽安小姐。",
            "nextDialogs": [
              "742540504"
            ]
          },
          "742540504": {
            "id": "742540504",
            "speakerId": 1003,
            "speakerName": "玛丽安",
            "text": "也多谢桑多涅小姐愿意举办这样一场茶会，让我们有机会重新聚在一起，聊聊旅途的见闻。",
            "nextDialogs": [
              "742540505"
            ]
          },
          "742540505": {
            "id": "742540505",
            "speakerId": 1004,
            "speakerName": "「木偶」",
            "text": "没什么。我只是觉得大家多少也算是有历史渊源的一家人。呃，应该能算吧。所以有空就聚聚没什么不好的。",
            "nextDialogs": [
              "742540506"
            ]
          },
          "742540506": {
            "id": "742540506",
            "speakerId": 1000,
            "speakerName": "安",
            "text": "一家人？不知道为什么，听到这样的说法我好高兴。",
            "nextDialogs": [
              "742540507"
            ]
          },
          "742540507": {
            "id": "742540507",
            "speakerId": 1003,
            "speakerName": "玛丽安",
            "text": "那桑多涅小姐算是家里的…妹妹？",
            "nextDialogs": [
              "742540508"
            ]
          },
          "742540508": {
            "id": "742540508",
            "speakerId": 1004,
            "speakerName": "「木偶」",
            "text": "呃…虽说是「一家人」，但算辈分这种事要不还是免了吧…",
            "nextDialogs": [
              "742540509"
            ]
          },
          "742540509": {
            "id": "742540509",
            "speakerId": 1002,
            "speakerName": "西摩尔",
            "text": "肯定。作为阿兰先生创造的原型机，桑多涅小姐应该称呼我为「大哥」。",
            "nextDialogs": [
              "742540510"
            ]
          },
          "742540510": {
            "id": "742540510",
            "speakerId": 1004,
            "speakerName": "「木偶」",
            "text": "啧…",
            "nextDialogs": [
              "742540511"
            ]
          },
          "742540511": {
            "id": "742540511",
            "speakerId": 1001,
            "speakerName": "玛梅赫",
            "text": "真好呀。我也能算是你们的家庭成员吗？",
            "nextDialogs": [
              "742540512"
            ]
          },
          "742540512": {
            "id": "742540512",
            "speakerId": 1004,
            "speakerName": "「木偶」",
            "text": "当然可以，这个「家庭」看起来什么都有了，再来一只美露莘也没什么奇怪的。",
            "nextDialogs": [
              "742540513"
            ]
          },
          "742540513": {
            "id": "742540513",
            "speakerId": 1002,
            "speakerName": "西摩尔",
            "text": "肯定。玛梅赫小姐就是我的家人。",
            "nextDialogs": [
              "742540514"
            ]
          },
          "742540514": {
            "id": "742540514",
            "speakerId": 1001,
            "speakerName": "玛梅赫",
            "text": "嘿嘿。真开心。那不如，我来为这个「家庭」画一幅画吧？",
            "nextDialogs": [
              "742540515"
            ]
          },
          "742540515": {
            "id": "742540515",
            "speakerId": 1003,
            "speakerName": "玛丽安",
            "text": "全家福？真是好久没有过了呢。",
            "nextDialogs": [
              "742540516"
            ]
          },
          "742540516": {
            "id": "742540516",
            "speakerId": 1000,
            "speakerName": "安",
            "text": "可要把我画得看起来厉害一点哦！就像家里的姐姐一样！",
            "nextDialogs": [
              "742540517"
            ]
          },
          "742540517": {
            "id": "742540517",
            "speakerId": 1001,
            "speakerName": "玛梅赫",
            "text": "嗯！",
            "nextDialogs": [
              "742540518"
            ]
          },
          "742540518": {
            "id": "742540518",
            "speakerId": 1004,
            "speakerName": "「木偶」",
            "text": "哈…随你们便吧…"
          }
        }
      }
    },
    {
      "subId": "7425404",
      "subQuestName": "享受茶会时光",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "742540601"
        ],
        "dialogs": {
          "742540601": {
            "id": "742540601",
            "speakerId": 1003,
            "speakerName": "玛丽安",
            "text": "真是平静惬意的日子。",
            "nextDialogs": [
              "742540602"
            ]
          },
          "742540602": {
            "id": "742540602",
            "speakerId": 1004,
            "speakerName": "「木偶」",
            "text": "（再这么坐一会儿吧。）",
            "nextDialogs": [
              "742540604"
            ]
          },
          "742540604": {
            "id": "742540604",
            "speakerId": 1003,
            "speakerName": "玛丽安",
            "text": "嗯，感谢你的邀请。桑多涅…妹妹？"
          }
        }
      }
    }
  ]
}
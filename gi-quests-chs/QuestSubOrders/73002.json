      }
    },
    {
      "subId": "7300229",
      "subQuestName": "与拉娜对话",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "730022001"
        ],
        "dialogs": {
          "730022001": {
            "id": "730022001",
            "speakerId": 1000,
            "speakerName": "拉娜",
            "text": "#啊，{NICKNAME}，你回来了！我担心死了…",
            "nextDialogs": [
              "730022002"
            ]
          },
          "730022002": {
            "id": "730022002",
            "speakerId": 1000,
            "speakerName": "拉娜",
            "text": "我还怕你和派蒙跑了…或者，更糟的情况是，之前我们教训的鳄鱼跑过来报复你们，把你们给拖走了！",
            "nextDialogs": [
              "730022003"
            ]
          },
          "730022003": {
            "id": "730022003",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "鳄鱼有这么可怕吗！？我们是看你睡着了，就去处理了一些别的事情…",
            "nextDialogs": [
              "730022004"
            ]
          },
          "730022004": {
            "id": "730022004",
            "speakerId": 1000,
            "speakerName": "拉娜",
            "text": "不知不觉就睡着了，真是不好意思，嘿嘿…",
            "nextDialogs": [
              "730022007"
            ]
          },
          "730022007": {
            "id": "730022007",
            "speakerId": 1000,
            "speakerName": "拉娜",
            "text": "倒没有很累啦。只是吃得很饱，加上觉得很安心，不知不觉就…",
            "nextDialogs": [
              "730022008"
            ]
          },
          "730022008": {
            "id": "730022008",
            "speakerId": 1000,
            "speakerName": "拉娜",
            "text": "咳咳！这里倒是有个巡林官的小知识喔。我们有时会搜索在森林里迷失的人，如果找到了，一定要给他们吃容易消化的东西。",
            "nextDialogs": [
              "730022009"
            ]
          },
          "730022009": {
            "id": "730022009",
            "speakerId": 1000,
            "speakerName": "拉娜",
            "text": "因为消化是会消耗体力的，这也是吃饱以后，容易犯困的原因啦。至少，教令院的学者是这么说的。",
            "nextDialogs": [
              "730022010"
            ]
          },
          "730022010": {
            "id": "730022010",
            "speakerId": 1000,
            "speakerName": "拉娜",
            "text": "#{NICKNAME}、派蒙，你们休息了吗？毕竟，昨天那么辛苦…"
          }
        }
      }
    },
    {
      "subId": "7300205",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "730020519"
        ],
        "dialogs": {
          "730020519": {
            "id": "730020519",
            "speakerId": 1000,
            "speakerName": "拉娜",
            "text": "#这里的物资，除了薪柴都还挺充足的…啊，{NICKNAME}，你回来了！捡够柴禾了吗？",
            "nextDialogs": [
              "730020520"
            ]
          },
          "730020520": {
            "id": "730020520",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "还没有…",
            "nextDialogs": [
              "730020521"
            ]
          },
          "730020521": {
            "id": "730020521",
            "speakerId": 1000,
            "speakerName": "拉娜",
            "text": "嗯，没关系的。交给我吧，你在这里好好休息就行了！我收拾一下营地，马上就去！",
            "nextDialogs": [
              "730020524"
            ]
          },
          "730020524": {
            "id": "730020524",
            "speakerId": 1000,
            "speakerName": "拉娜",
            "text": "好吧。辛苦你啦。"
          }
        }
      }
    },

    {
      "subId": "7300219",
      "subQuestName": "收集柴禾",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "730021901"
        ],
        "dialogs": {
          "730021901": {
            "id": "730021901",
            "speakerId": 1000,
            "speakerName": "拉娜",
            "text": "啊——睡得真香！不知不觉就睡着了，真是不好意思，嘿嘿…",
            "nextDialogs": [
              "730021904"
            ]
          },
          "730021904": {
            "id": "730021904",
            "speakerId": 1000,
            "speakerName": "拉娜",
            "text": "倒没有很累啦。只是吃得很饱，加上觉得很安心，不知不觉就…",
            "nextDialogs": [
              "730021905"
            ]
          },
          "730021905": {
            "id": "730021905",
            "speakerId": 1000,
            "speakerName": "拉娜",
            "text": "咳咳！这里倒是有个巡林官的小知识喔。搜索在森林里迷失的人的时候，如果找到了，一定要给他们吃容易消化的东西。",
            "nextDialogs": [
              "730021906"
            ]
          },
          "730021906": {
            "id": "730021906",
            "speakerId": 1000,
            "speakerName": "拉娜",
            "text": "因为消化是会消耗体力的，这也是吃饱以后，容易犯困的原因啦。至少，教令院的学者是这么说的。",
            "nextDialogs": [
              "730021907"
            ]
          },
          "730021907": {
            "id": "730021907",
            "speakerId": 1000,
            "speakerName": "拉娜",
            "text": "#{NICKNAME}、派蒙，你们休息了吗？毕竟，昨天那么辛苦…"
          }
        }
      }
    },
    {
      "subId": "7300209",
      "subQuestName": "收集柴禾$HIDDEN",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "730020901"
        ],
        "dialogs": {
          "730020901": {
            "id": "730020901",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "嗯，这个量应该够了吧！",
            "nextDialogs": [
              "730020902"
            ]
          },
          "730020902": {
            "id": "730020902",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "我们回去找拉娜吧！"
          }
        }
      }

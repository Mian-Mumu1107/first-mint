    {
      "subId": "7418905",
      "subQuestName": "(test)与女仆对话1$HIDDEN",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "741890501"
        ],
        "dialogs": {
          "741890501": {
            "id": "741890501",
            "speakerId": 1000,
            "speakerName": "佩尔曼雅",
            "text": "稍等，客人。你想要知道一个有关宝藏的「秘密」吗？",
            "nextDialogs": [
              "741890502"
            ]
          },
          "741890502": {
            "id": "741890502",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "什么秘密？",
            "nextDialogs": [
              "741890503"
            ]
          },
          "741890503": {
            "id": "741890503",
            "speakerId": 1000,
            "speakerName": "佩尔曼雅",
            "text": "宝藏。和打开宝藏门的钥匙…怎么样？客人，你对此有兴趣吗？",
            "nextDialogs": [
              "741890506"
            ]
          },
          "741890506": {
            "id": "741890506",
            "speakerId": 1000,
            "speakerName": "佩尔曼雅",
            "text": "怎么会呢？我们酒馆从来不差遣客人，至少…我们不会差遣客人。",
            "nextDialogs": [
              "741890507"
            ]
          },
          "741890507": {
            "id": "741890507",
            "speakerId": 1000,
            "speakerName": "佩尔曼雅",
            "text": "您看见我身边的这门「舰炮」，和这门炮所正对着的那堆碎石了吗？",
            "nextDialogs": [
              "741890508"
            ]
          },
          "741890508": {
            "id": "741890508",
            "speakerId": 1000,
            "speakerName": "佩尔曼雅",
            "text": "只要启动这门炮，用炮弹轰开石头，碎石后的宝藏就归您了。",
            "nextDialogs": [
              "741890509"
            ]
          },
          "741890509": {
            "id": "741890509",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "这大炮的名字谁取的…",
            "nextDialogs": [
              "741890510"
            ]
          },
          "741890510": {
            "id": "741890510",
            "speakerId": 1000,
            "speakerName": "佩尔曼雅",
            "text": "是掌舵人取的。这门炮也是他不知道从什么地方捞起来的。"
          }
        }
      }
    },
    {

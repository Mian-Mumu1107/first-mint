        "dialogs": {
          "741890301": {
            "id": "741890301",
            "speakerId": 1000,
            "speakerName": "佩尔曼雅",
            "text": "全部答对了，恭喜您，可以去启动大炮了。",
            "nextDialogs": [
              "741890302"
            ]
          },
          "741890302": {
            "id": "741890302",
            "speakerId": 1000,
            "speakerName": "佩尔曼雅",
            "text": "稍等，我先去旁边捂住耳朵。"
          }
        }
      }
    },
    {
      "subId": "7418904",
      "subQuestName": "(test)击碎山石$HIDDEN",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "741890401"
        ],
        "dialogs": {
          "741890401": {
            "id": "741890401",
            "speakerId": 1000,
            "speakerName": "佩尔曼雅",
            "text": "您找到问题的答案了吗？容我提醒您一下问题本身。",
            "nextDialogs": [
              "741890402"
            ]
          },
          "741890402": {
            "id": "741890402",
            "speakerId": 1000,
            "speakerName": "佩尔曼雅",
            "text": "第一个问题是，在我们「锈舵」酒馆之内，有几张桌子？",
            "nextDialogs": [
              "741890403"
            ]
          },
          "741890403": {
            "id": "741890403",
            "speakerId": 1000,
            "speakerName": "佩尔曼雅",
            "text": "第二个问题是，我们「锈舵」酒馆，有几位工作人员？",
            "nextDialogs": [
              "741890404"
            ]
          },
          "741890404": {
            "id": "741890404",
            "speakerId": 1000,
            "speakerName": "佩尔曼雅",
            "text": "第三个问题是，有什么东西，是我们「锈舵」酒馆不供应的？",
            "nextDialogs": [
              "741890405"
            ]
          },
          "741890405": {
            "id": "741890405",
            "speakerId": 1000,
            "speakerName": "佩尔曼雅",
            "text": "您准备好回答问题了吗？",
            "nextDialogs": [
              "741890409",
              "741890408"
            ]
          },
          "741890409": {
            "id": "741890409",
            "speakerId": 1000,
            "speakerName": "佩尔曼雅",
            "text": "那我们就开始吧。首先是第一个问题。在我们「锈舵」酒馆之内，有几张桌子？"
          },
          "741890408": {
            "id": "741890408",
            "speakerId": 1000,
            "speakerName": "佩尔曼雅",
            "text": "那就请您去寻找那几个问题的答案吧，我就在这里等着您。"
          }
        }
      }
    }
  ]

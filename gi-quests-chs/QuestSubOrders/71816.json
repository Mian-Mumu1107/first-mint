    {
      "subId": "7181608",
      "subQuestName": "将编好的霄灯交给黄衫",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "718160701"
        ],
        "dialogs": {
          "718160701": {
            "id": "718160701",
            "speakerId": 1000,
            "speakerName": "黄衫",
            "text": "哦？这霄灯真不错，多谢你了。我想想，霄灯里的愿望该怎么写…",
            "nextDialogs": [
              "718160702"
            ]
          },
          "718160702": {
            "id": "718160702",
            "speakerId": 1000,
            "speakerName": "黄衫",
            "text": "我这人也琢磨不出多好听的愿望…那就写个「万事如意」吧。",
            "nextDialogs": [
              "718160703"
            ]
          },
          "718160703": {
            "id": "718160703",
            "speakerId": 1000,
            "speakerName": "黄衫",
            "text": "只要所有事都能像预料的那样走，我就谢谢岩王爷了。",
            "nextDialogs": [
              "718160704"
            ]
          },
          "718160704": {
            "id": "718160704",
            "speakerId": 1000,
            "speakerName": "黄衫",
            "text": "对了，这些是报酬，收下吧，多谢你帮我的忙，还有你送我的那盏霄灯。"
          }
        }
      }
    },
    {
      "subId": "7181607",
      "subQuestName": "(test)对话刷霄灯$HIDDEN",
      "sceneId": null,

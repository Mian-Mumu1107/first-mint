          "718160301": {
            "id": "718160301",
            "speakerId": 1001,
            "speakerName": "弗朗西斯",
            "text": "货怎么还没来，我的肚子已经饿得咕咕叫了。"
          }
        }
      }
    },
    {
      "subId": "7181608",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "718160801"
        ],
        "dialogs": {
          "718160801": {
            "id": "718160801",
            "speakerId": 1000,
            "speakerName": "黄衫",
            "text": "你真打算帮我准备霄灯么？"
          }
        }
      }

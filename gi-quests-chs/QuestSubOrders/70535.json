          "705350201": {
            "id": "705350201",
            "speakerId": 1000,
            "speakerName": "可莉",
            "text": "嗯嗯！可莉知道了！",
            "nextDialogs": [
              "705350202"
            ]
          },
          "705350202": {
            "id": "705350202",
            "speakerId": 1000,
            "speakerName": "可莉",
            "text": "但是…鱼还是刚刚炸上来的最新鲜嘛，放火上烤一烤，又脆又香又好吃！",
            "nextDialogs": [
              "705350203"
            ]
          },
          "705350203": {
            "id": "705350203",
            "speakerId": 1001,
            "speakerName": "丽莎",
            "text": "不用担心，小可莉，琴早就和我叮嘱过了。",
            "nextDialogs": [
              "705350204"
            ]
          },
          "705350204": {
            "id": "705350204",
            "speakerId": 1001,
            "speakerName": "丽莎",
            "text": "我已经向「猎鹿人」下单了，这几天，大厨会挑选刚从湖里钓上来的好鱼，快快入锅烹饪。",
            "nextDialogs": [
              "705350205"
            ]
          },
          "705350205": {
            "id": "705350205",
            "speakerId": 1001,
            "speakerName": "丽莎",
            "text": "配上可莉最喜欢的调味粉和酱料，还有我准备的特制茶点，肯定和你炸鱼时的收获一样美味~",
            "nextDialogs": [
              "705350206"
            ]
          },
          "705350206": {
            "id": "705350206",
            "speakerId": 1000,
            "speakerName": "可莉",
            "text": "好！那就听丽莎阿…丽莎姐姐的！",
            "nextDialogs": [
              "705350207"
            ]
          },
          "705350207": {
            "id": "705350207",
            "speakerId": 1000,
            "speakerName": "可莉",
            "text": "这几天，可莉一定专心在城里玩「嘟嘟可轰轰奇遇记」，不去炸鱼，不给阿贝多哥哥的朋友添麻烦！",
            "nextDialogs": [
              "705350208"
            ]
          },
          "705350208": {
            "id": "705350208",
            "speakerId": 1000,
            "speakerName": "可莉",
            "text": "#那可莉出发去找荣誉骑士{M#哥哥}{F#姐姐}和小派蒙了！",
            "nextDialogs": [
              "705350209"
            ]
          },
          "705350209": {
            "id": "705350209",
            "speakerId": 1002,
            "speakerName": "派蒙",
            "text": "嘿嘿，谁要找我们呀？",
            "nextDialogs": [
              "705350212"
            ]
          },
          "705350212": {
            "id": "705350212",
            "speakerId": 1000,
            "speakerName": "可莉",
            "text": "#荣誉骑士{M#哥哥}{F#姐姐}！还有小派蒙！",
            "nextDialogs": [
              "705350213"
            ]
          },
          "705350213": {
            "id": "705350213",
            "speakerId": 1000,
            "speakerName": "可莉",
            "text": "可莉刚刚在想你们，你们就出现了，是有什么魔法帮可莉把消息传给了你们吗？",
            "nextDialogs": [
              "705350214"
            ]
          },
          "705350214": {
            "id": "705350214",
            "speakerId": 1001,
            "speakerName": "丽莎",
            "text": "啊呀？小可爱和派蒙，你们来得可真是时候，都不用辛苦我写信了。"
          }
        }
      }
    },
    {

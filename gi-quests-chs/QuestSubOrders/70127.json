  "subQuests": [
    {
      "subId": "7012701",
      "subQuestName": "(test)(隐藏)漂流瓶1$HIDDEN",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "701270101"
        ],
        "dialogs": {
          "701270101": {
            "id": "701270101",
            "speakerId": 20214,
            "speakerName": "漂流瓶",
            "text": "「如果您读到这条信息的话，希望您是我所期待的那个人。」",
            "nextDialogs": [
              "701270102"
            ]
          },
          "701270102": {
            "id": "701270102",
            "speakerId": 20214,
            "speakerName": "漂流瓶",
            "text": "「这是第几封信了呢？这封信漂流了多远，又在哪里搁浅了呢？」",
            "nextDialogs": [
              "701270103"
            ]
          },
          "701270103": {
            "id": "701270103",
            "speakerId": 20214,
            "speakerName": "漂流瓶",
            "text": "「等有机会再见面，再为我讲讲岩港的山、北国的风雪，或者蒲公英与酒，如何？」",
            "nextDialogs": [
              "701270104"
            ]
          },
          "701270104": {
            "id": "701270104",
            "speakerId": 20214,
            "speakerName": "漂流瓶",
            "text": "「我会等着你的回信，像往常一样。」"
          }
        }
      }
    },
    {
      "subId": "7012702",
      "subQuestName": "(test)(隐藏)漂流瓶2$HIDDEN",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "701270201"
        ],
        "dialogs": {
          "701270201": {
            "id": "701270201",
            "speakerId": 20214,
            "speakerName": "漂流瓶",
            "text": "「如果您读到这条信息的话，希望您是我所期待的那个人。」",
            "nextDialogs": [
              "701270202"
            ]
          },
          "701270202": {
            "id": "701270202",
            "speakerId": 20214,
            "speakerName": "漂流瓶",
            "text": "「我们曾以为战争只是童话和传说里才会发生的事，但如今，我们每个人都在大御所大人的雷霆震怒之下战栗。」",
            "nextDialogs": [
              "701270203"
            ]
          },
          "701270203": {
            "id": "701270203",
            "speakerId": 20214,
            "speakerName": "漂流瓶",
            "text": "「我们常去的那片海滩被封闭了，但我还是想办法投出了这封信。」",
            "nextDialogs": [
              "701270204"
            ]
          },
          "701270204": {
            "id": "701270204",
            "speakerId": 20214,
            "speakerName": "漂流瓶",
            "text": "「请不要为此担心责备。对于曾和你一同冒险的我来说，这种小事轻而易举。」",
            "nextDialogs": [
              "701270205"
            ]
          },
          "701270205": {
            "id": "701270205",
            "speakerId": 20214,
            "speakerName": "漂流瓶",
            "text": "「我等待着你的回信，哪怕只有一句话也好。」"
          }
        }
      }
    },
    {

    {
      "subId": "2006118",
      "subQuestName": "把信件送给莎拉",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "200611201"
        ],
        "dialogs": {
          "200611201": {
            "id": "200611201",
            "speakerId": 1002,
            "speakerName": "莎拉",
            "text": "有你的信…",
            "nextDialogs": [
              "200611202"
            ]
          },
          "200611202": {
            "id": "200611202",
            "speakerId": 1002,
            "speakerName": "莎拉",
            "text": "咦？怎么是你送来的？",
            "nextDialogs": [
              "200611203"
            ]
          },
          "200611203": {
            "id": "200611203",
            "speakerId": 1002,
            "speakerName": "莎拉",
            "text": "我还以为和平时一样，是信鸽直接送到城里呢…",
            "nextDialogs": [
              "200611204"
            ]
          },
          "200611204": {
            "id": "200611204",
            "speakerId": 1002,
            "speakerName": "莎拉",
            "text": "不过信送到了就好，谢谢你，麻烦了。"
          }
        }
      }
    },
    {
      "subId": "2006119",
      "subQuestName": "向杜拉夫回报",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "200611301"
        ],
        "dialogs": {
          "200611301": {
            "id": "200611301",
            "speakerId": 1000,
            "speakerName": "杜拉夫",
            "text": "关于鸽子…",
            "nextDialogs": [
              "200611302"
            ]
          },
          "200611302": {
            "id": "200611302",
            "speakerId": 1000,
            "speakerName": "杜拉夫",
            "text": "真是…没事给自己找事做。",
            "nextDialogs": [
              "200611303"
            ]
          },
          "200611303": {
            "id": "200611303",
            "speakerId": 1000,
            "speakerName": "杜拉夫",
            "text": "好了好了，这次就原谅你了，赶紧走吧。"
          }
        }
      }
    },
    {
      "subId": "2006110",
      "subQuestName": "赶走鸽子",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "200611001"
        ],
        "dialogs": {
          "200611001": {
            "id": "200611001",
            "speakerId": 1000,
            "speakerName": "杜拉夫",
            "text": "关于鸽子…",
            "nextDialogs": [
              "200611002"
            ]
          },
          "200611002": {
            "id": "200611002",
            "speakerId": 1000,
            "speakerName": "杜拉夫",
            "text": "是吗？鸽子们都被丘丘人抓走了啊…",
            "nextDialogs": [
              "200611003"
            ]
          },
          "200611003": {
            "id": "200611003",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "这封信…",
            "nextDialogs": [
              "200611004"
            ]
          },
          "200611004": {
            "id": "200611004",
            "speakerId": 1000,
            "speakerName": "杜拉夫",
            "text": "信…谢谢你，这封信确实是我寄的，本来是要寄给蒙德城里的葛瑞丝修女…",
            "nextDialogs": [
              "200611005"
            ]
          },
          "200611005": {
            "id": "200611005",
            "speakerId": 1000,
            "speakerName": "杜拉夫",
            "text": "你没看吧？没事，看了也没关系，只是一些陈年旧事而已。",
            "nextDialogs": [
              "200611006"
            ]
          },
          "200611006": {
            "id": "200611006",
            "speakerId": 1000,
            "speakerName": "杜拉夫",
            "text": "有些事情，也不可能永远瞒住啊…",
            "nextDialogs": [
              "200611007"
            ]
          },
          "200611007": {
            "id": "200611007",
            "speakerId": 1000,
            "speakerName": "杜拉夫",
            "text": "谢谢你把这封信带回来，我过段时间自己送过去吧。这是给你的酬劳，收下吧。",
            "nextDialogs": [
              "200611008"
            ]
          },
          "200611008": {
            "id": "200611008",
            "speakerId": 1000,
            "speakerName": "杜拉夫",
            "text": "提米，唉…"
          }
        }
      }
    },
    {
      "subId": "2006111",
      "subQuestName": "调查前方",
      "sceneId": null,
      "locations": [],

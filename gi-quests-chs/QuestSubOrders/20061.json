    {
      "subId": "2006102",
      "subQuestName": "去树林里找到鸽子群",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "200610201"
        ],
        "dialogs": {
          "200610201": {
            "id": "200610201",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "好多鸽子在偷懒，快点去把它们赶起来，让它们乖乖去送信吧！"
          }
        }
      }
    },
    {
      "subId": "2006103",
      "subQuestName": "(test)$HIDDEN",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "200610301"
        ],
        "dialogs": {
          "200610301": {
            "id": "200610301",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "这下，这些鸽子们应该就不会偷懒了。"
          }
        }
      }
    },
    {
      "subId": "2006104",
      "subQuestName": "(test)$HIDDEN",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "200610401"
        ],
        "dialogs": {
          "200610401": {
            "id": "200610401",
            "speakerId": 1000,
            "speakerName": "杜拉夫",
            "text": "关于鸽子…",
            "nextDialogs": [
              "200610402"
            ]
          },
          "200610402": {
            "id": "200610402",
            "speakerId": 1000,
            "speakerName": "杜拉夫",
            "text": "这样子，那些鸽子也许就会乖乖送信了吧…",
            "nextDialogs": [
              "200610403"
            ]
          },
          "200610403": {
            "id": "200610403",
            "speakerId": 1000,
            "speakerName": "杜拉夫",
            "text": "但我也不能跟着看，不过总之先这样吧。",
            "nextDialogs": [
              "200610404"
            ]
          },
          "200610404": {
            "id": "200610404",
            "speakerId": 1000,
            "speakerName": "杜拉夫",
            "text": "辛苦你了，这是答谢，以后要寄信的话就过来打个招呼吧。"
          }
        }
      }
    },
    {
      "subId": "2006105",
      "subQuestName": "(test)$HIDDEN",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "200610501"
        ],
        "dialogs": {
          "200610501": {
            "id": "200610501",
            "speakerId": 1000,
            "speakerName": "杜拉夫",
            "text": "关于鸽子…",
            "nextDialogs": [
              "200610502"
            ]
          },
          "200610502": {
            "id": "200610502",
            "speakerId": 1000,
            "speakerName": "杜拉夫",
            "text": "喂！你做了什么，这些鸽子都是用来寄信的！",
            "nextDialogs": [
              "200610503"
            ]
          },
          "200610503": {
            "id": "200610503",
            "speakerId": 1000,
            "speakerName": "杜拉夫",
            "text": "真是的，你到底哪根脑筋不对了…我这里还有很多信要寄啊！",
            "nextDialogs": [
              "200610505",
              "200610507"
            ]
          },
          "200610505": {
            "id": "200610505",
            "speakerId": 1000,
            "speakerName": "杜拉夫",
            "text": "光道歉起作用的话，那要西风骑士团做什么？！",
            "nextDialogs": [
              "200610508"
            ]
          },
          "200610508": {
            "id": "200610508",
            "speakerId": 1000,
            "speakerName": "杜拉夫",
            "text": "犯错了就要有惩罚，你就代替鸽子们把信送过去吧。"
          },
          "200610507": {
            "id": "200610507",
            "speakerId": 1000,
            "speakerName": "杜拉夫",
            "text": "赶鸽子？你是拿着锅铲去赶的吗！"
          }
        }
      }
    },
    {
      "subId": "2006106",
      "subQuestName": "赶走鸽子",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "200610601"
        ],
        "dialogs": {
          "200610601": {
            "id": "200610601",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "鸽子不见了，奇怪，刚才还看见的…"
          }
        }
      }
    },
    {
      "subId": "2006107",
      "subQuestName": "赶走鸽子",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "200610701"
        ],
        "dialogs": {
          "200610701": {
            "id": "200610701",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "那群丘丘人围着的锅里好像煮着什么，旁边还堆着一堆肉…"
          }
        }
      }
    },
    {
      "subId": "2006108",
      "subQuestName": "赶走鸽子",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "200610801"
        ],
        "dialogs": {
          "200610801": {
            "id": "200610801",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "咦？这是…一封信？",
            "nextDialogs": [
              "200610802"
            ]
          },
          "200610802": {
            "id": "200610802",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "糟了，一定是哪只鸽子正在送出去的信。",
            "nextDialogs": [
              "200610803"
            ]
          },
          "200610803": {
            "id": "200610803",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "#{NICKNAME}，快点看看是谁寄的，说不定我们能帮帮忙呢。"
          }
        }
      }

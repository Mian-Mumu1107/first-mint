            "speakerId": 22785,
            "speakerName": "偷东西霜精",
            "text": "呀吼？",
            "nextDialogs": [
              "772380602"
            ]
          },
          "772380602": {
            "id": "772380602",
            "speakerId": 22737,
            "speakerName": "克列娃",
            "text": "呃，真是气死我了，你要说多少遍才懂啊！",
            "nextDialogs": [
              "772380603"
            ]
          },
          "772380603": {
            "id": "772380603",
            "speakerId": 22737,
            "speakerName": "克列娃",
            "text": "别在这里发呆了！快点快点，手动起来啦！",
            "nextDialogs": [
              "772380604"
            ]
          },
          "772380604": {
            "id": "772380604",
            "speakerId": 22785,
            "speakerName": "偷东西霜精",
            "text": "呀吼…呀吼…"
          }
        }
      }
    }
  ]
}
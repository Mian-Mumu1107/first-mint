  "subQuests": [
    {
      "subId": "7723801",
      "subQuestName": "(test)隐藏$HIDDEN",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "772380101"
        ],
        "dialogs": {
          "772380101": {
            "id": "772380101",
            "speakerId": 22784,
            "speakerName": "？？？",
            "text": "该死的，怎么、怎么会有人在野外的温泉偷…",
            "nextDialogs": [
              "772380102"
            ]
          },
          "772380102": {
            "id": "772380102",
            "speakerId": 22784,
            "speakerName": "？？？",
            "text": "等我拿回了衣服，我一定要把那个臭小偷大卸八块！",
            "nextDialogs": [
              "772380103"
            ]
          },
          "772380103": {
            "id": "772380103",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "咦，怎么有人在、在木桶里面？",
            "nextDialogs": [
              "772380104"
            ]
          },
          "772380104": {
            "id": "772380104",
            "speakerId": 22784,
            "speakerName": "？？？",
            "text": "外、外面有人吗，难道也是来泡温泉的客人？",
            "nextDialogs": [
              "772380105"
            ]
          },
          "772380105": {
            "id": "772380105",
            "speakerId": 22784,
            "speakerName": "？？？",
            "text": "唉…我能不能拜托你们一件事，我刚才泡温泉结束，却发现衣服不见了，又听到有人来…",
            "nextDialogs": [
              "772380106"
            ]
          },
          "772380106": {
            "id": "772380106",
            "speakerId": 22784,
            "speakerName": "？？？",
            "text": "才不得不躲进木桶里，能不能…帮我把我的衣服找回来？",
            "nextDialogs": [
              "772380107"
            ]
          },
          "772380107": {
            "id": "772380107",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "唔，好吧，我们尽量在周围找找…"
          }
        }
      }
    },
    {
      "subId": "7723802",
      "subQuestName": "(test)隐藏$HIDDEN",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "772380201"
        ],
        "dialogs": {
          "772380201": {
            "id": "772380201",
            "speakerId": 10205,
            "speakerName": "？？？",
            "text": "气死我了，气死我了…",
            "nextDialogs": [
              "772380202"
            ]
          },
          "772380202": {
            "id": "772380202",
            "speakerId": 10205,
            "speakerName": "？？？",
            "text": "该死的、该死的，偷衣服的小贼！"
          }
        }
      }
    },
    {
      "subId": "7723803",
      "subQuestName": "(test)隐藏$HIDDEN",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "772380301"
        ],
        "dialogs": {
          "772380301": {
            "id": "772380301",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "啊，果然，刚才你就在翻什么，果然是在翻别人的衣服！",
            "nextDialogs": [
              "772380302"
            ]
          },
          "772380302": {
            "id": "772380302",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "你…唉，你把别人的衣服偷走干什么啦！",
            "nextDialogs": [
              "772380303"
            ]
          },
          "772380303": {
            "id": "772380303",
            "speakerId": 22785,
            "speakerName": "偷东西霜精",
            "text": "呜呜…呀吼！呀吼！",
            "nextDialogs": [
              "772380304"
            ]
          },
          "772380304": {
            "id": "772380304",
            "speakerId": 1003,
            "speakerName": "Black Screen",
            "text": "在霜精的手舞足蹈下，终于明白了它的意思…",
            "nextDialogs": [
              "772380305"
            ]
          },
          "772380305": {
            "id": "772380305",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "呃，你是说，看到雪人没有衣服，感到很可怜。",
            "nextDialogs": [
              "772380306"
            ]
          },
          "772380306": {
            "id": "772380306",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "…被偷衣服的人也很可怜啦！再怎么样也不能偷别人的衣服给雪人穿上！",
            "nextDialogs": [
              "772380307"
            ]
          },
          "772380307": {
            "id": "772380307",
            "speakerId": 22785,
            "speakerName": "偷东西霜精",
            "text": "呜呜…",
            "nextDialogs": [
              "772380308"
            ]
          },
          "772380308": {
            "id": "772380308",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "快，把偷走的衣服还回来！",
            "nextDialogs": [
              "772380309"
            ]
          },
          "772380309": {
            "id": "772380309",
            "speakerId": 22785,
            "speakerName": "偷东西霜精",
            "text": "呀吼…",
            "nextDialogs": [
              "772380310"
            ]
          },
          "772380310": {
            "id": "772380310",
            "speakerId": 1003,
            "speakerName": "Black Screen",
            "text": "偷走衣服的霜精将衣服递到了你们手上。\\n但这件衣服让你觉得有点奇怪…",
            "nextDialogs": [
              "772380311"
            ]
          },
          "772380311": {
            "id": "772380311",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "好，我们去把衣服还给木桶里的人吧，那个人在木桶里一定等急了。"
          }
        }
      }
    },
    {
      "subId": "7723804",
      "subQuestName": "(test)隐藏$HIDDEN",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "772380401"
        ],
        "dialogs": {
          "772380401": {
            "id": "772380401",
            "speakerId": 22784,
            "speakerName": "？？？",
            "text": "怎么样？",
            "nextDialogs": [
              "772380402"
            ]
          },
          "772380402": {
            "id": "772380402",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "我们找到偷你衣服的家伙啦，还有，还有你的衣服！",
            "nextDialogs": [
              "772380403"
            ]
          },
          "772380403": {
            "id": "772380403",
            "speakerId": 22784,
            "speakerName": "？？？",
            "text": "我要看看是哪个胆大包天的家伙，呜，不过得先穿好衣服才行，好、好冷…",
            "nextDialogs": [
              "772380404"
            ]
          },
          "772380404": {
            "id": "772380404",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "那我们要怎么把衣服给你…",
            "nextDialogs": [
              "772380405"
            ]
          },
          "772380405": {
            "id": "772380405",
            "speakerId": 22784,
            "speakerName": "？？？",
            "text": "放在桶边上就好，谢谢。然后、还、还请几位转过身去…",
            "nextDialogs": [
              "772380406"
            ]
          },
          "772380406": {
            "id": "772380406",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "（将衣服放在桶边…）",
            "nextDialogs": [
              "772380407"
            ]
          },
          "772380407": {
            "id": "772380407",
            "speakerId": 1003,
            "speakerName": "Black Screen",
            "text": "你转过身去，然后听到身后传来穿衣服的窸窸窣窣声…\\n毛发摩擦的声音有些多，这你之前就有所察觉。\\n丢失了衣服的其实是…",
            "nextDialogs": [
              "772380408"
            ]
          },
          "772380408": {
            "id": "772380408",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "啊…原来是兽怪。",
            "nextDialogs": [
              "772380409"
            ]
          },
          "772380409": {
            "id": "772380409",
            "speakerId": 22737,
            "speakerName": "克列娃",
            "text": "是的，我是这个温泉的管理人克列娃…其实也就是老板啦，不过这边倒也不收摩拉就是了。",
            "nextDialogs": [
              "772380410"
            ]
          },
          "772380410": {
            "id": "772380410",
            "speakerId": 22737,
            "speakerName": "克列娃",
            "text": "欢迎两位尽情享受这个温泉…虽然温泉其实是克什尼克之炬的地暖管道泄露产生的，这点还请不要举报给能源协会…",
            "nextDialogs": [
              "772380411"
            ]
          },
          "772380411": {
            "id": "772380411",
            "speakerId": 22737,
            "speakerName": "克列娃",
            "text": "啊，对了，你、你就是偷走我衣服的家伙！！",
            "nextDialogs": [
              "772380412"
            ]
          },
          "772380412": {
            "id": "772380412",
            "speakerId": 22785,
            "speakerName": "偷东西霜精",
            "text": "呀吼…呀吼…",
            "nextDialogs": [
              "772380413"
            ]
          },
          "772380413": {
            "id": "772380413",
            "speakerId": 22737,
            "speakerName": "克列娃",
            "text": "唉，这一脸蠢像！居然把我的衣服拿去给雪人穿？雪人会感冒吗？",
            "nextDialogs": [
              "772380414"
            ]
          },
          "772380414": {
            "id": "772380414",
            "speakerId": 22785,
            "speakerName": "偷东西霜精",
            "text": "呜呜…呀吼！",
            "nextDialogs": [
              "772380415"
            ]
          },
          "772380415": {
            "id": "772380415",
            "speakerId": 22737,
            "speakerName": "克列娃",
            "text": "装无辜也没有用，你…你要给我留下来干活！给我洗满一百件衣服才能走！",
            "nextDialogs": [
              "772380416"
            ]
          },
          "772380416": {
            "id": "772380416",
            "speakerId": 22785,
            "speakerName": "偷东西霜精",
            "text": "哇？呀吼！"
          }
        }
      }
    },

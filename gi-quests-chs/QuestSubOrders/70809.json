    {
      "subId": "7080904",
      "subQuestName": "(test)隐藏$HIDDEN",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "708090301"
        ],
        "dialogs": {
          "708090301": {
            "id": "708090301",
            "speakerId": 1000,
            "speakerName": "Black Screen",
            "text": "（鸟巢内有许多零散的碎纸条，似乎还有七零八落的字迹…）",
            "nextDialogs": [
              "708090302"
            ]
          },
          "708090302": {
            "id": "708090302",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "这些纸条…不会是它们为了筑巢特意撕开的吧？",
            "nextDialogs": [
              "708090303"
            ]
          },
          "708090303": {
            "id": "708090303",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "上面好像还有字呢，要不要拼起来看看写了什么？",
            "nextDialogs": [
              "708090304"
            ]
          },
          "708090304": {
            "id": "708090304",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "搞半天还是要自己拼…",
            "nextDialogs": [
              "708090305"
            ]
          },
          "708090305": {
            "id": "708090305",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "你就不好奇吗？说不定是什么藏宝图呢！",
            "nextDialogs": [
              "708090306"
            ]
          },
          "708090306": {
            "id": "708090306",
            "speakerId": 1000,
            "speakerName": "Black Screen",
            "text": "在派蒙的连声催促下拼好了纸条…",
            "nextDialogs": [
              "708090307"
            ]
          },
          "708090307": {
            "id": "708090307",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "让我看看…这是…",
            "nextDialogs": [
              "708090308"
            ]
          },
          "708090308": {
            "id": "708090308",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "这…这难道是…「犯罪计划书」吗！",
            "nextDialogs": [
              "708090310",
              "708090312"
            ]
          },
          "708090310": {
            "id": "708090310",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "但…但是小说里经常有这种情节吧！万无一失的计划，偏偏就在最不可能的地方出了疏漏…",
            "nextDialogs": [
              "708090313"
            ]
          },
          "708090313": {
            "id": "708090313",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "我们去附近的酒馆里打听一下吧？看看有没有谁听说过，「最近有人要犯罪了！」什么的…"
          },
          "708090312": {
            "id": "708090312",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "你…你说得对，不怕一万，就怕万一…如果真有人打算犯罪，回头后悔可就晚了！"
          }
        }
      }
    },
    {
      "subId": "7080902",
      "subQuestName": "(test)隐藏$HIDDEN",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "708090201"
        ],
        "dialogs": {
          "708090201": {
            "id": "708090201",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "我在鸟巢里找到了这个…"
          }
        }
      }
    },
    {
      "subId": "7080903",
      "subQuestName": "(test)隐藏$HIDDEN",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [],
        "dialogs": {}
      }
    },
    {
      "subId": "7080907",
      "subQuestName": "(test)隐藏$HIDDEN",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "708090401"
        ],
        "dialogs": {
          "708090401": {
            "id": "708090401",
            "speakerId": 1768,
            "speakerName": "内田幸太郎",
            "text": "这…这是…我的「作案手法」！",
            "nextDialogs": [
              "708090402"
            ]
          },
          "708090402": {
            "id": "708090402",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "#{NICKNAME}！他居然直接就承认了！",
            "nextDialogs": [
              "708090403"
            ]
          },
          "708090403": {
            "id": "708090403",
            "speakerId": 1768,
            "speakerName": "内田幸太郎",
            "text": "啊！请别误会，这是我打算写进下一部小说里的诡计，是我之前喝酒的时候想出来的。",
            "nextDialogs": [
              "708090404"
            ]
          },
          "708090404": {
            "id": "708090404",
            "speakerId": 1768,
            "speakerName": "内田幸太郎",
            "text": "没想到酒一醒这页纸就消失了…我差点以为自己是在做梦呢。",
            "nextDialogs": [
              "708090405"
            ]
          },
          "708090405": {
            "id": "708090405",
            "speakerId": 1768,
            "speakerName": "内田幸太郎",
            "text": "总之，多谢你帮忙找回它啦。这下我的小说应该就能顺产了，到时候我先送你一本！带签名的！"
          }
        }
      }
    },
    {
      "subId": "7080906",
      "subQuestName": "(test)隐藏$HIDDEN",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "708090501"
        ],
        "dialogs": {
          "708090501": {
            "id": "708090501",
            "speakerId": 1326,
            "speakerName": "洛恩",
            "text": "哦？有点意思，让我看看…嗯，创意可以给六分，可行性大概就四分吧…",
            "nextDialogs": [
              "708090502"
            ]
          },
          "708090502": {
            "id": "708090502",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "这…这是「犯罪计划书」吗？",
            "nextDialogs": [
              "708090503"
            ]
          },
          "708090503": {
            "id": "708090503",
            "speakerId": 1326,
            "speakerName": "洛恩",
            "text": "哈哈，其实我从驻地跑来这里，就是听说了有人在这儿盘算一些稀奇古怪的「犯罪计划」。",
            "nextDialogs": [
              "708090504"
            ]
          },
          "708090504": {
            "id": "708090504",
            "speakerId": 1326,
            "speakerName": "洛恩",
            "text": "…不过看过这页笔记之后，我大概知道那些流言是怎么起来的了。",
            "nextDialogs": [
              "708090505"
            ]
          },
          "708090505": {
            "id": "708090505",
            "speakerId": 1326,
            "speakerName": "洛恩",
            "text": "这份「犯罪计划书」就交给骑士团来处理吧，回头要是有空就来我的驻地逛逛？没准会有好戏呢。"
          }
        }
      }
    },
    {
      "subId": "7080905",
      "subQuestName": "(test)隐藏$HIDDEN",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "618011501"
        ],
        "dialogs": {
          "618011501": {
            "id": "618011501",
            "speakerId": 1768,
            "speakerName": "内田幸太郎",
            "text": "…骑士先生！那真的就只是一个小说里的点子而已！不是什么「犯罪计划」。",
            "nextDialogs": [
              "618011502"
            ]
          },
          "618011502": {
            "id": "618011502",
            "speakerId": 1326,
            "speakerName": "洛恩",
            "text": "嗯嗯我明白，不必那么激动，内田先生，先喝杯茶冷静一下吧。",
            "nextDialogs": [
              "618011503"
            ]
          },
          "618011503": {
            "id": "618011503",
            "speakerId": 1326,
            "speakerName": "洛恩",
            "text": "根据重要线人提供的情报…你的手稿确实不像「犯罪计划」，毕竟那要实施起来可太不现实了。",
            "nextDialogs": [
              "618011505"
            ]
          },
          "618011505": {
            "id": "618011505",
            "speakerId": 1768,
            "speakerName": "内田幸太郎",
            "text": "什么——哪…哪里不现实了！你倒是说说啊？",
            "nextDialogs": [
              "618011506"
            ]
          },
          "618011506": {
            "id": "618011506",
            "speakerId": 1326,
            "speakerName": "洛恩",
            "text": "条件太多，环节太杂，既要有符合你需求的毒药，又得有符合你需求的建筑…",
            "nextDialogs": [
              "618011507"
            ]
          },
          "618011507": {
            "id": "618011507",
            "speakerId": 1768,
            "speakerName": "内田幸太郎",
            "text": "呃…唔…",
            "nextDialogs": [
              "618011508"
            ]
          },
          "618011508": {
            "id": "618011508",
            "speakerId": 1326,
            "speakerName": "洛恩",
            "text": "哪一步出了纰漏都会马上败露，不是么？更别说还掺了这么多设定，理解起来都困难。",
            "nextDialogs": [
              "618011509"
            ]
          },
          "618011509": {
            "id": "618011509",
            "speakerId": 1768,
            "speakerName": "内田幸太郎",
            "text": "…你这么一说，还真有点道理？那该怎么完善这个手法呢？",
            "nextDialogs": [
              "618011510"
            ]
          },
          "618011510": {
            "id": "618011510",
            "speakerId": 1326,
            "speakerName": "洛恩",
            "text": "嗯，我碰巧也对药物有点兴趣，不如就这样…再那样…",
            "nextDialogs": [
              "618011511"
            ]
          },
          "618011511": {
            "id": "618011511",
            "speakerId": 1768,
            "speakerName": "内田幸太郎",
            "text": "…哦哦！您当骑士可真是屈才了！骑士先生！"
          }
        }
      }
    }
  ]
}
    {
      "subId": "801103",
      "subQuestName": "跟着丘丘人进入洞窟",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "80110301"
        ],
        "dialogs": {
          "80110301": {
            "id": "80110301",
            "speakerId": 10205,
            "speakerName": "？？？",
            "text": "停下，人类。汝等并未获准来此地探寻「命运」…",
            "nextDialogs": [
              "80110302"
            ]
          },
          "80110302": {
            "id": "80110302",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "（深渊使徒？不对，好像从未在深渊教团见过这样的家伙…）",
            "nextDialogs": [
              "80110303"
            ]
          },
          "80110303": {
            "id": "80110303",
            "speakerId": 10205,
            "speakerName": "？？？",
            "text": "怎么，汝等执意要「觐见」么？",
            "nextDialogs": [
              "80110304"
            ]
          },
          "80110304": {
            "id": "80110304",
            "speakerId": 10205,
            "speakerName": "？？？",
            "text": "…也无妨，那就赐予汝等「命运的试炼」吧。"
          }
        }
      }
    },
    {
      "subId": "801104",
      "subQuestName": "与埃德对话",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [],
        "dialogs": {}
      }
    },
    {
      "subId": "801105",
      "subQuestName": "向前继续探索",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "80110501"
        ],
        "dialogs": {
          "80110501": {
            "id": "80110501",
            "speakerId": 13072,
            "speakerName": "埃德",
            "text": "这里就是…终点？",
            "nextDialogs": [
              "80110502"
            ]
          },
          "80110502": {
            "id": "80110502",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "那个东西是！？",
            "nextDialogs": [
              "80110503"
            ]
          },
          "80110503": {
            "id": "80110503",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "（锁链层层缠绕，悬吊在空中，散发着不祥的气息…没错，和「污秽逆位神像」非常类似！）",
            "nextDialogs": [
              "80110504"
            ]
          },
          "80110504": {
            "id": "80110504",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "（果然和深渊教团有关系吗，这些正在膜拜的丘丘人，也像极了当时的「那个家伙」…）",
            "nextDialogs": [
              "80110505"
            ]
          },
          "80110505": {
            "id": "80110505",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "埃德，这里很不吉利，快走！",
            "nextDialogs": [
              "80110506"
            ]
          },
          "80110506": {
            "id": "80110506",
            "speakerId": 13072,
            "speakerName": "埃德",
            "text": "……",
            "nextDialogs": [
              "80110507"
            ]
          },
          "80110507": {
            "id": "80110507",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "埃德？",
            "nextDialogs": [
              "80110508"
            ]
          },
          "80110508": {
            "id": "80110508",
            "speakerId": 1002,
            "speakerName": "脑海中回荡的声音",
            "text": "…生命啊，为何在跪拜呢，因恐惧未知而跪拜？因贪图力量而跪拜？",
            "nextDialogs": [
              "80110509"
            ]
          },
          "80110509": {
            "id": "80110509",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "（什么声音，好像从我头脑里传来的…埃德，好像听不到？）",
            "nextDialogs": [
              "80110510"
            ]
          },
          "80110510": {
            "id": "80110510",
            "speakerId": 1002,
            "speakerName": "脑海中回荡的声音",
            "text": "…生命啊，为何在跪拜呢，我又不是什么神明，我只是——「罪人」。",
            "nextDialogs": [
              "80110511"
            ]
          },
          "80110511": {
            "id": "80110511",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "（「罪人」…）",
            "nextDialogs": [
              "80110512"
            ]
          },
          "80110512": {
            "id": "80110512",
            "speakerId": 1002,
            "speakerName": "脑海中回荡的声音",
            "text": "诞生于罪孽，但尚且无垢的花朵啊，我通晓你的命运。",
            "nextDialogs": [
              "80110513"
            ]
          },
          "80110513": {
            "id": "80110513",
            "speakerId": 1002,
            "speakerName": "脑海中回荡的声音",
            "text": "无需压抑你一切的不甘，无需容忍那全部的谎言。",
            "nextDialogs": [
              "80110514"
            ]
          },
          "80110514": {
            "id": "80110514",
            "speakerId": 1002,
            "speakerName": "脑海中回荡的声音",
            "text": "去成为「超然」的存在吧，超越一切「被赋予的命运」。",
            "nextDialogs": [
              "80110515"
            ]
          },
          "80110515": {
            "id": "80110515",
            "speakerId": 1002,
            "speakerName": "脑海中回荡的声音",
            "text": "我将在时间的尽头垂泪…回望你的一切。",
            "nextDialogs": [
              "80110516"
            ]
          },
          "80110516": {
            "id": "80110516",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "（…你究竟是谁，这些话是什么意思？）",
            "nextDialogs": [
              "80110517"
            ]
          },
          "80110517": {
            "id": "80110517",
            "speakerId": 1002,
            "speakerName": "脑海中回荡的声音",
            "text": "……",
            "nextDialogs": [
              "80110518"
            ]
          },
          "80110518": {
            "id": "80110518",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "（声音…消失了么…）",
            "nextDialogs": [
              "80110519"
            ]
          },
          "80110519": {
            "id": "80110519",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "！！",
            "nextDialogs": [
              "80110520"
            ]
          },
          "80110520": {
            "id": "80110520",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "…埃德？",
            "nextDialogs": [
              "80110521"
            ]
          },
          "80110521": {
            "id": "80110521",
            "speakerId": 13072,
            "speakerName": "埃德",
            "text": "呼…呼…刚才发生了什么？",
            "nextDialogs": [
              "80110522"
            ]
          },
          "80110522": {
            "id": "80110522",
            "speakerId": 13072,
            "speakerName": "埃德",
            "text": "我好像见到那东西的瞬间，内心所有的情绪都平息了，只剩下说不出是敬畏…还是幸福的感觉。",
            "nextDialogs": [
              "80110523"
            ]
          },
          "80110523": {
            "id": "80110523",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "你现在没事了么？",
            "nextDialogs": [
              "80110524"
            ]
          },
          "80110524": {
            "id": "80110524",
            "speakerId": 13072,
            "speakerName": "埃德",
            "text": "没事，我感觉很好，不如说…比刚进来这里的时候要好多了，真是奇怪…",
            "nextDialogs": [
              "80110525"
            ]
          },
          "80110525": {
            "id": "80110525",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "这里有问题，我们赶紧离开吧。",
            "nextDialogs": [
              "80110526"
            ]
          },
          "80110526": {
            "id": "80110526",
            "speakerId": 13072,
            "speakerName": "埃德",
            "text": "是、是吗…好吧，那先听你的。"
          }
        }
      }
    },

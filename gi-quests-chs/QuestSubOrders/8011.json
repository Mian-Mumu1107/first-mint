    {
      "subId": "801112",
      "subQuestName": "",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "80110601"
        ],
        "dialogs": {
          "80110601": {
            "id": "80110601",
            "speakerId": 13072,
            "speakerName": "埃德",
            "text": "卡利贝尔，谢天谢地，这里一切如常。",
            "nextDialogs": [
              "80110604"
            ]
          },
          "80110604": {
            "id": "80110604",
            "speakerId": 13072,
            "speakerName": "埃德",
            "text": "我…只是隐隐有种感觉，刚刚的事是某种命运的安排。",
            "nextDialogs": [
              "80110605"
            ]
          },
          "80110605": {
            "id": "80110605",
            "speakerId": 13072,
            "speakerName": "埃德",
            "text": "在我最不想祭拜神像的时候，发生了刚才的那件事，仿佛是对我的某种引导…",
            "nextDialogs": [
              "80110606"
            ]
          },
          "80110606": {
            "id": "80110606",
            "speakerId": 13072,
            "speakerName": "埃德",
            "text": "听你说，我好像在「那个东西」前跪拜了，说不定…效果也差不多呢？"
          }
        }
      }
    },

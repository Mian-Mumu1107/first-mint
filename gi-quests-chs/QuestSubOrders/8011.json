    {
      "subId": "801101",
      "subQuestName": "跟上丘丘人",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "80110101"
        ],
        "dialogs": {
          "80110101": {
            "id": "80110101",
            "speakerId": 13072,
            "speakerName": "埃德",
            "text": "好像…不是卡利贝尔。",
            "nextDialogs": [
              "80110104"
            ]
          },
          "80110104": {
            "id": "80110104",
            "speakerId": 13072,
            "speakerName": "埃德",
            "text": "嗯。卡利贝尔胳膊上的丝巾是我曾经送给他母亲的礼物，如今被我拿来做记号。",
            "nextDialogs": [
              "80110105"
            ]
          },
          "80110105": {
            "id": "80110105",
            "speakerId": 13072,
            "speakerName": "埃德",
            "text": "我怕是眼睛也快撑不住了，连自己的儿子都认不清了，这副身体…唉。"
          }
        }
      }
    },
    {
      "subId": "801102",
      "subQuestName": "跟上丘丘人",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "80110201"
        ],
        "dialogs": {
          "80110201": {
            "id": "80110201",
            "speakerId": 13072,
            "speakerName": "埃德",
            "text": "这里好阴森，这个地方…以前也存在吗？好像从来没有发现过这里。",
            "nextDialogs": [
              "80110204"
            ]
          },
          "80110204": {
            "id": "80110204",
            "speakerId": 13072,
            "speakerName": "埃德",
            "text": "啊？他们…他们是在膜拜什么吗？一边走，一边跪拜…看起来很虔诚。",
            "nextDialogs": [
              "80110205"
            ]
          },
          "80110205": {
            "id": "80110205",
            "speakerId": 13072,
            "speakerName": "埃德",
            "text": "我从未见过这样的景象，这个地方究竟藏了些什么…",
            "nextDialogs": [
              "80110206"
            ]
          },
          "80110206": {
            "id": "80110206",
            "speakerId": 13072,
            "speakerName": "埃德",
            "text": "只有一探究竟了。",
            "nextDialogs": [
              "80110207"
            ]
          },
          "80110207": {
            "id": "80110207",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "（这里的气氛，诡异的情景，难道…）"
          }
        }
      }
    },
    {
      "subId": "801114",
      "subQuestName": "跟着丘丘人进入洞窟",
      "sceneId": null,
      "locations": [],

    {
      "subId": "801108",
      "subQuestName": "与埃德对话",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "80110401"
        ],
        "dialogs": {
          "80110401": {
            "id": "80110401",
            "speakerId": 13072,
            "speakerName": "埃德",
            "text": "刚才那个家伙到底是什么？简直是…",
            "nextDialogs": [
              "80110404"
            ]
          },
          "80110404": {
            "id": "80110404",
            "speakerId": 13072,
            "speakerName": "埃德",
            "text": "…简直是完美的生命体，令人赞叹。",
            "nextDialogs": [
              "80110405"
            ]
          },
          "80110405": {
            "id": "80110405",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "嗯？",
            "nextDialogs": [
              "80110406"
            ]
          },
          "80110406": {
            "id": "80110406",
            "speakerId": 13072,
            "speakerName": "埃德",
            "text": "他身上透露着的那股神秘的气息，危险却又优雅的力量，真是太吸引人了。",
            "nextDialogs": [
              "80110407"
            ]
          },
          "80110407": {
            "id": "80110407",
            "speakerId": 13072,
            "speakerName": "埃德",
            "text": "真亏你能将这样的存在击败，你的实力有些超乎我的想象了。"
          }
        }
      }
    },
    {

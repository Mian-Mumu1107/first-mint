  },
  "subQuests": [
    {
      "subId": "1503001",
      "subQuestName": "前往「豪宴热斗」的会场",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "150300101"
        ],
        "dialogs": {
          "150300101": {
            "id": "150300101",
            "speakerId": 1091,
            "speakerName": "伊安珊",
            "text": "哦，你们来了啊，欢迎欢迎。",
            "nextDialogs": [
              "150300102"
            ]
          },
          "150300102": {
            "id": "150300102",
            "speakerId": 6305,
            "speakerName": "阿卡特",
            "text": "好久不见，听瓦雷莎说你们打算参加「豪宴热斗」，我还吓了一跳呢。",
            "nextDialogs": [
              "150300103"
            ]
          },
          "150300103": {
            "id": "150300103",
            "speakerId": 6305,
            "speakerName": "阿卡特",
            "text": "看来瓦雷莎终于又要碰上强有力的对手了。",
            "nextDialogs": [
              "150300104"
            ]
          },
          "150300104": {
            "id": "150300104",
            "speakerId": 1098,
            "speakerName": "瓦雷莎",
            "text": "啊…不至于，我也没那么厉害…",
            "nextDialogs": [
              "150300105"
            ]
          },
          "150300105": {
            "id": "150300105",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "你怎么了，感觉就像是有点没睡醒？",
            "nextDialogs": [
              "150300106"
            ]
          },
          "150300106": {
            "id": "150300106",
            "speakerId": 1098,
            "speakerName": "瓦雷莎",
            "text": "肚子饿了，我饿肚子来的，要比赛，就要挨饿…",
            "nextDialogs": [
              "150300107"
            ]
          },
          "150300107": {
            "id": "150300107",
            "speakerId": 6305,
            "speakerName": "阿卡特",
            "text": "稍微再等一下，瓦雷莎，阿托力已经在热火朝天地准备了，很快就会开始。",
            "nextDialogs": [
              "150300108"
            ]
          },
          "150300108": {
            "id": "150300108",
            "speakerId": 1098,
            "speakerName": "瓦雷莎",
            "text": "嗯，我知道，我忍耐一下…",
            "nextDialogs": [
              "150300109"
            ]
          },
          "150300109": {
            "id": "150300109",
            "speakerId": 6305,
            "speakerName": "阿卡特",
            "text": "对了，按照规则，如果「豪宴热斗」的参赛者没能完成挑战，是需要正常支付饭钱的。",
            "nextDialogs": [
              "150300110"
            ]
          },
          "150300110": {
            "id": "150300110",
            "speakerId": 6305,
            "speakerName": "阿卡特",
            "text": "但听说你们要参加，我和阿托力商量了一下，已经把你们这部分费用完全免除了！",
            "nextDialogs": [
              "150300111"
            ]
          },
          "150300111": {
            "id": "150300111",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "欸，这么好？也就是说可以免费吃？！",
            "nextDialogs": [
              "150300112"
            ]
          },
          "150300112": {
            "id": "150300112",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "太好了，这样就算吃不完也能放放心心打包带走。",
            "nextDialogs": [
              "150300113"
            ]
          },
          "150300113": {
            "id": "150300113",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "谢谢你的招待。",
            "nextDialogs": [
              "150300114"
            ]
          },
          "150300114": {
            "id": "150300114",
            "speakerId": 6305,
            "speakerName": "阿卡特",
            "text": "不用客气，和你们为纳塔做的事相比，这简直无足轻重，就当是我们表达一下心意吧。",
            "nextDialogs": [
              "150300115"
            ]
          },
          "150300115": {
            "id": "150300115",
            "speakerId": 6305,
            "speakerName": "阿卡特",
            "text": "在深渊入侵的时候，虽然「沃陆之邦」出现的魔物不多，但火山突然变得异常活跃。",
            "nextDialogs": [
              "150300116"
            ]
          },
          "150300116": {
            "id": "150300116",
            "speakerId": 6305,
            "speakerName": "阿卡特",
            "text": "作为「图兰的看守者」，我们不可能放着不管，于是我们立刻派出小队，往山顶进发。",
            "nextDialogs": [
              "150300117"
            ]
          },
          "150300117": {
            "id": "150300117",
            "speakerId": 6305,
            "speakerName": "阿卡特",
            "text": "瓦雷莎也是其中的重要一员。",
            "nextDialogs": [
              "150300118"
            ]
          },
          "150300118": {
            "id": "150300118",
            "speakerId": 6305,
            "speakerName": "阿卡特",
            "text": "瓦雷莎？",
            "nextDialogs": [
              "150300119"
            ]
          },
          "150300119": {
            "id": "150300119",
            "speakerId": 1098,
            "speakerName": "瓦雷莎",
            "text": "啊…哦，是的，我在，我在，当时我带了很多「龙龙饼干」…啊，不对，不是说这个…",
            "nextDialogs": [
              "150300120"
            ]
          },
          "150300120": {
            "id": "150300120",
            "speakerId": 1098,
            "speakerName": "瓦雷莎",
            "text": "山顶有「深渊瘤石」，它不仅能唤出魔物，还能激发岩浆的运动。",
            "nextDialogs": [
              "150300121"
            ]
          },
          "150300121": {
            "id": "150300121",
            "speakerId": 1098,
            "speakerName": "瓦雷莎",
            "text": "幸好后来有火神大人帮忙，我们打碎了那个东西。",
            "nextDialogs": [
              "150300122"
            ]
          },
          "150300122": {
            "id": "150300122",
            "speakerId": 1091,
            "speakerName": "伊安珊",
            "text": "现在想来，这也是深渊的计划，只要拖住「沃陆之邦」的脚步，竞技场附近就无法得到支援。",
            "nextDialogs": [
              "150300123"
            ]
          },
          "150300123": {
            "id": "150300123",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "有道理，你们这儿的人都很喜欢锻炼，肯定也特别能打…深渊太狡猾了。",
            "nextDialogs": [
              "150300124"
            ]
          },
          "150300124": {
            "id": "150300124",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "不过，「图兰的看守者」是什么意思？",
            "nextDialogs": [
              "150300125"
            ]
          },
          "150300125": {
            "id": "150300125",
            "speakerId": 6305,
            "speakerName": "阿卡特",
            "text": "哈哈哈，这是「沃陆之邦」从古至今传承下来的使命。",
            "nextDialogs": [
              "150300126"
            ]
          },
          "150300126": {
            "id": "150300126",
            "speakerId": 6305,
            "speakerName": "阿卡特",
            "text": "这座火山对我们来说是非常重要的存在，它所带来的不只有灾难，还有机遇。",
            "nextDialogs": [
              "150300127"
            ]
          },
          "150300127": {
            "id": "150300127",
            "speakerId": 6305,
            "speakerName": "阿卡特",
            "text": "肥沃的土地，富饶的生态…这些都是迎接「挑战」才能收获的回报。",
            "nextDialogs": [
              "150300128"
            ]
          },
          "150300128": {
            "id": "150300128",
            "speakerId": 1091,
            "speakerName": "伊安珊",
            "text": "没错，「挑战」本身也很契合纳塔人的气质。",
            "nextDialogs": [
              "150300129"
            ]
          },
          "150300129": {
            "id": "150300129",
            "speakerId": 1091,
            "speakerName": "伊安珊",
            "text": "一旦火山的运动不同寻常，我们也能以最快的速度向竞技场汇报。",
            "nextDialogs": [
              "150300130"
            ]
          },
          "150300130": {
            "id": "150300130",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "原来是这样，我就说嘛，应该不只是因为种的东西好吃才住在这里。",
            "nextDialogs": [
              "150300131"
            ]
          },
          "150300131": {
            "id": "150300131",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "欸，瓦雷莎呢？怎么不见了？",
            "nextDialogs": [
              "150300132"
            ]
          },
          "150300132": {
            "id": "150300132",
            "speakerId": 1091,
            "speakerName": "伊安珊",
            "text": "她刚刚突然走了，我还以为是有人叫她呢。",
            "nextDialogs": [
              "150300133"
            ]
          },
          "150300133": {
            "id": "150300133",
            "speakerId": 6305,
            "speakerName": "阿卡特",
            "text": "我猜是去厨房了吧，香味一直从那个方向飘过来。",
            "nextDialogs": [
              "150300134"
            ]
          },
          "150300134": {
            "id": "150300134",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "那我们去看看她吧，我知道的，饿着肚子的感觉很不好受。",
            "nextDialogs": [
              "150300135"
            ]
          },
          "150300135": {
            "id": "150300135",
            "speakerId": 1091,
            "speakerName": "伊安珊",
            "text": "我们一起去好了。"
          }
        }
      }
    },
    {
      "subId": "1503006",
      "subQuestName": "前往厨房，查看瓦雷莎的状态",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "150300701"
        ],
        "dialogs": {
          "150300701": {
            "id": "150300701",
            "speakerId": 1098,
            "speakerName": "瓦雷莎",
            "text": "好香啊…",
            "nextDialogs": [
              "150300702"
            ]
          },
          "150300702": {
            "id": "150300702",
            "speakerId": 1098,
            "speakerName": "瓦雷莎",
            "text": "香喷喷的肉排，融化的芝士，多汁的蘑菇…唔。",
            "nextDialogs": [
              "150300703"
            ]
          },
          "150300703": {
            "id": "150300703",
            "speakerId": 6393,
            "speakerName": "阿托力",
            "text": "果然是你啊，瓦雷莎。",
            "nextDialogs": [
              "150300704"
            ]
          },
          "150300704": {
            "id": "150300704",
            "speakerId": 6393,
            "speakerName": "阿托力",
            "text": "我在房间里都能感觉到外面有什么气势汹汹的东西，压迫力相当不一般，哈哈哈哈。",
            "nextDialogs": [
              "150300705"
            ]
          },
          "150300705": {
            "id": "150300705",
            "speakerId": 6393,
            "speakerName": "阿托力",
            "text": "马上就开饭了，还要等几分钟的时间，你先尝尝这个。",
            "nextDialogs": [
              "150300706"
            ]
          },
          "150300706": {
            "id": "150300706",
            "speakerId": 1098,
            "speakerName": "瓦雷莎",
            "text": "这个香味，是炖肉汤吗？谢谢阿托力叔叔！",
            "nextDialogs": [
              "150300707"
            ]
          },
          "150300707": {
            "id": "150300707",
            "speakerId": 1098,
            "speakerName": "瓦雷莎",
            "text": "唔…哈啊——",
            "nextDialogs": [
              "150300708"
            ]
          },
          "150300708": {
            "id": "150300708",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "你果然在这里啊，怎么不打个招呼呢？",
            "nextDialogs": [
              "150300709"
            ]
          },
          "150300709": {
            "id": "150300709",
            "speakerId": 1098,
            "speakerName": "瓦雷莎",
            "text": "啊是你们，对不起，对不起，刚刚我脑子一片空白。",
            "nextDialogs": [
              "150300710"
            ]
          },
          "150300710": {
            "id": "150300710",
            "speakerId": 1098,
            "speakerName": "瓦雷莎",
            "text": "不知道怎么回事，就已经到这里来了，手里还有一碗炖肉汤。",
            "nextDialogs": [
              "150300711"
            ]
          },
          "150300711": {
            "id": "150300711",
            "speakerId": 14736,
            "speakerName": "阿卡特",
            "text": "哈哈哈，不用在意，我们都知道怎么回事。",
            "nextDialogs": [
              "150300712"
            ]
          },
          "150300712": {
            "id": "150300712",
            "speakerId": 6393,
            "speakerName": "阿托力",
            "text": "实在抱歉，今天准备的时间长了点，开餐也不得不延迟，让你饿肚子了。",
            "nextDialogs": [
              "150300713"
            ]
          },
          "150300713": {
            "id": "150300713",
            "speakerId": 1098,
            "speakerName": "瓦雷莎",
            "text": "没关系，喝下这么美味的肉汤之后，我已经好了很多。",
            "nextDialogs": [
              "150300714"
            ]
          },
          "150300714": {
            "id": "150300714",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "嘿嘿，你好像终于恢复我们刚见面时候的样子啦。",
            "nextDialogs": [
              "150300715"
            ]
          },
          "150300715": {
            "id": "150300715",
            "speakerId": 1098,
            "speakerName": "瓦雷莎",
            "text": "肚子饿的时候，我就管不了那么多了。我也很想集中精神听你们说话，但是…很难。",
            "nextDialogs": [
              "150300716"
            ]
          },
          "150300716": {
            "id": "150300716",
            "speakerId": 1091,
            "speakerName": "伊安珊",
            "text": "这很正常，瓦雷莎，因为你平时运动量很大，消耗量也很大，身体需要补充更多的能量。",
            "nextDialogs": [
              "150300717"
            ]
          },
          "150300717": {
            "id": "150300717",
            "speakerId": 1091,
            "speakerName": "伊安珊",
            "text": "你们应该也有过类似的经历吧，如果没吃东西就去运动，很快就会觉得头晕和没力气。",
            "nextDialogs": [
              "150300718"
            ]
          },
          "150300718": {
            "id": "150300718",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "这倒是，我很能理解。",
            "nextDialogs": [
              "150300719"
            ]
          },
          "150300719": {
            "id": "150300719",
            "speakerId": 1098,
            "speakerName": "瓦雷莎",
            "text": "所以，「豪宴热斗」还有多久开始呢，我已经等不及了。",
            "nextDialogs": [
              "150300720"
            ]
          },
          "150300720": {
            "id": "150300720",
            "speakerId": 6393,
            "speakerName": "阿托力",
            "text": "稍等，我回去看看。",
            "nextDialogs": [
              "150300721"
            ]
          },
          "150300721": {
            "id": "150300721",
            "speakerId": 6393,
            "speakerName": "阿托力",
            "text": "没问题了！阿卡特，召集大家，准备开始比赛！",
            "nextDialogs": [
              "150300722"
            ]
          },
          "150300722": {
            "id": "150300722",
            "speakerId": 14736,
            "speakerName": "阿卡特",
            "text": "知道了！",
            "nextDialogs": [
              "150300723"
            ]
          },
          "150300723": {
            "id": "150300723",
            "speakerId": 14736,
            "speakerName": "阿卡特",
            "text": "那我们去会场就位吧，美食很快就会端上桌。",
            "nextDialogs": [
              "150300724"
            ]
          },
          "150300724": {
            "id": "150300724",
            "speakerId": 1098,
            "speakerName": "瓦雷莎",
            "text": "终于可以吃饭啦——"
          }
        }
      }
    },
    {
      "subId": "1503002",
      "subQuestName": "参与「豪宴热斗」",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "150300201"
        ],
        "dialogs": {
          "150300201": {
            "id": "150300201",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "好香，好香！我终于知道为什么瓦雷莎宁愿饿肚子也要等这一餐了！",
            "nextDialogs": [
              "150300204"
            ]
          },
          "150300204": {
            "id": "150300204",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "是啊，我觉得我们两个人勉强能吃完一份，但一人吃一份实在是…",
            "nextDialogs": [
              "150300205"
            ]
          },
          "150300205": {
            "id": "150300205",
            "speakerId": 1098,
            "speakerName": "瓦雷莎",
            "text": "我要开饭了，谢谢阿托力叔叔！",
            "nextDialogs": [
              "150300206"
            ]
          },
          "150300206": {
            "id": "150300206",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "哇啊？！等等，瓦雷莎的那一份，明显不一样吧！",
            "nextDialogs": [
              "150300207"
            ]
          },
          "150300207": {
            "id": "150300207",
            "speakerId": 14736,
            "speakerName": "阿卡特",
            "text": "哈哈哈，先前忘记告诉你们了，这个「豪宴热斗」分为两个等级——「普通级」和「瓦雷莎级」。",
            "nextDialogs": [
              "150300208"
            ]
          },
          "150300208": {
            "id": "150300208",
            "speakerId": 14736,
            "speakerName": "阿卡特",
            "text": "第一次参赛的人只能参加「普通级」，成功完成挑战，才能尝试「瓦雷莎级」。",
            "nextDialogs": [
              "150300209"
            ]
          },
          "150300209": {
            "id": "150300209",
            "speakerId": 14736,
            "speakerName": "阿卡特",
            "text": "之所以用瓦雷莎的名字冠名，也是因为这个分量目前只有瓦雷莎完成过。",
            "nextDialogs": [
              "150300210"
            ]
          },
          "150300210": {
            "id": "150300210",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "太、太夸张了…居然专门为她开设了一个级别。",
            "nextDialogs": [
              "150300211"
            ]
          },
          "150300211": {
            "id": "150300211",
            "speakerId": 14736,
            "speakerName": "阿卡特",
            "text": "是啊，如果让普通人和她在一个级别里较量，那冠军只可能是她，这样的比赛还有什么吸引力呢？",
            "nextDialogs": [
              "150300212"
            ]
          },
          "150300212": {
            "id": "150300212",
            "speakerId": 14736,
            "speakerName": "阿卡特",
            "text": "要说最接近完成「瓦雷莎级」的人，我想应该是火神玛薇卡大人。",
            "nextDialogs": [
              "150300213"
            ]
          },
          "150300213": {
            "id": "150300213",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "她也来挑战过？",
            "nextDialogs": [
              "150300214"
            ]
          },
          "150300214": {
            "id": "150300214",
            "speakerId": 14736,
            "speakerName": "阿卡特",
            "text": "没错，普通的挑战对她来说不在话下，但是「瓦雷莎级」的分量依然是严峻的考验。",
            "nextDialogs": [
              "150300215"
            ]
          },
          "150300215": {
            "id": "150300215",
            "speakerId": 14736,
            "speakerName": "阿卡特",
            "text": "据说她刚来的时候是想调查，为什么每次「归火圣夜巡礼」的前夜，瓦雷莎都能在「倦意之屋」吃掉几十人份的饭。",
            "nextDialogs": [
              "150300216"
            ]
          },
          "150300216": {
            "id": "150300216",
            "speakerId": 14736,
            "speakerName": "阿卡特",
            "text": "话事处的工作人员认为这个账单背后有猫腻，是「倦意之屋」的工作人员统计失误，甚至是为了报假账…",
            "nextDialogs": [
              "150300217"
            ]
          },
          "150300217": {
            "id": "150300217",
            "speakerId": 14736,
            "speakerName": "阿卡特",
            "text": "但玛薇卡大人真的在现场见识过瓦雷莎的饭量之后，一切误会都解除了。",
            "nextDialogs": [
              "150300218"
            ]
          },
          "150300218": {
            "id": "150300218",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "哇…这可真是…",
            "nextDialogs": [
              "150300219"
            ]
          },
          "150300219": {
            "id": "150300219",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "对玛薇卡来说，我们面前的这个分量还是…「不在话下」吗？"
          }
        }
      }
    },
    {
      "subId": "1503003",
      "subQuestName": "返回果园",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "150300301"
        ],
        "dialogs": {
          "150300301": {
            "id": "150300301",
            "speakerId": 1098,
            "speakerName": "瓦雷莎",
            "text": "吃饱了以后再干活都变得有劲了。",
            "nextDialogs": [
              "150300302"
            ]
          },
          "150300302": {
            "id": "150300302",
            "speakerId": 1098,
            "speakerName": "瓦雷莎",
            "text": "怎么了，还在想绿蘑菇的事吗？放心啦，只是阿托力叔叔喜欢故弄玄虚，语气稍微有点浮夸而已。",
            "nextDialogs": [
              "150300303"
            ]
          },
          "150300303": {
            "id": "150300303",
            "speakerId": 1098,
            "speakerName": "瓦雷莎",
            "text": "那种蘑菇只是偶尔出现一下，我每天都会来果园，只要发现了就会吃掉。",
            "nextDialogs": [
              "150300304"
            ]
          },
          "150300304": {
            "id": "150300304",
            "speakerId": 1098,
            "speakerName": "瓦雷莎",
            "text": "我还希望它能多长一点呢，这样我也能多吃几个。",
            "nextDialogs": [
              "150300305"
            ]
          },
          "150300305": {
            "id": "150300305",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "欸，你看…绿蘑菇就是那个吗？恰恰就是这个时机冒出来，有点太巧了吧…",
            "nextDialogs": [
              "150300306"
            ]
          },
          "150300306": {
            "id": "150300306",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "真的是绿蘑菇。",
            "nextDialogs": [
              "150300307"
            ]
          },
          "150300307": {
            "id": "150300307",
            "speakerId": 1098,
            "speakerName": "瓦雷莎",
            "text": "你们看，其实除了颜色之外，没什么特别的地方，对吧。",
            "nextDialogs": [
              "150300308"
            ]
          },
          "150300308": {
            "id": "150300308",
            "speakerId": 1098,
            "speakerName": "瓦雷莎",
            "text": "等下哦，我来生个火，赶紧把它烤来吃了。",
            "nextDialogs": [
              "150300309"
            ]
          },
          "150300309": {
            "id": "150300309",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "啊，就不要做我的那一份了，我现在还吃不下任何东西…",
            "nextDialogs": [
              "150300310"
            ]
          },
          "150300310": {
            "id": "150300310",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "我还是很好奇背后的原因。",
            "nextDialogs": [
              "150300311"
            ]
          },
          "150300311": {
            "id": "150300311",
            "speakerId": 1098,
            "speakerName": "瓦雷莎",
            "text": "你是说，为什么绿色的蘑菇就一定要吃掉吗？",
            "nextDialogs": [
              "150300312"
            ]
          },
          "150300312": {
            "id": "150300312",
            "speakerId": 1098,
            "speakerName": "瓦雷莎",
            "text": "嗯…说实话我也很好奇，那个学者当时只留下了这句话，神情很严肃，但没有讲明原因。",
            "nextDialogs": [
              "150300313"
            ]
          },
          "150300313": {
            "id": "150300313",
            "speakerId": 1098,
            "speakerName": "瓦雷莎",
            "text": "我也赞同阿托力叔叔的说法，好奇并不总是一件好事，如果不照着那句话去做，很可能会造成更大的影响。",
            "nextDialogs": [
              "150300314"
            ]
          },
          "150300314": {
            "id": "150300314",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "那就要放着不管吗？如果是冒险家，一定会调查下去的。",
            "nextDialogs": [
              "150300315"
            ]
          },
          "150300315": {
            "id": "150300315",
            "speakerId": 1098,
            "speakerName": "瓦雷莎",
            "text": "嗯，我明白，但是…我很喜欢「沃陆之邦」，这里对我很重要，所以我只想保持眼前这样就够了。",
            "nextDialogs": [
              "150300316"
            ]
          },
          "150300316": {
            "id": "150300316",
            "speakerId": 1098,
            "speakerName": "瓦雷莎",
            "text": "真相固然重要，但我也不应该自作主张，做出可能会让这里的人遇到危险的决定。",
            "nextDialogs": [
              "150300317"
            ]
          },
          "150300317": {
            "id": "150300317",
            "speakerId": 1098,
            "speakerName": "瓦雷莎",
            "text": "或者换句话说…唉，可能还是我内心深处有点害怕吧，害怕这种「改变」会失去控制…",
            "nextDialogs": [
              "150300320"
            ]
          },
          "150300320": {
            "id": "150300320",
            "speakerId": 1098,
            "speakerName": "瓦雷莎",
            "text": "欸，掌控？"
          }
        }
      }
    },
    {
      "subId": "1503008",
      "subQuestName": "",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "150300801"
        ],
        "dialogs": {
          "150300801": {
            "id": "150300801",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "这里是绿蘑菇…果然，变成蕈兽了。这次我有心理准备，吓不到我！",
            "nextDialogs": [
              "150300802"
            ]
          },
          "150300802": {
            "id": "150300802",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "先下手为强吧。喂，「食物，神圣！」这句话是什么意思？",
            "nextDialogs": [
              "150300803"
            ]
          },
          "150300803": {
            "id": "150300803",
            "speakerId": 15142,
            "speakerName": "爱茜蘑",
            "text": "贤主大人应该提示过你们，想要获得答案，必须先展示你们的智慧。所以，该提出问题的是我，而不是你。",
            "nextDialogs": [
              "150300804"
            ]
          },
          "150300804": {
            "id": "150300804",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "这次突然又伶牙俐齿起来了，好吧好吧，看来想要得到这个蕈兽的情报，还是要乖乖地解个谜才行。",
            "nextDialogs": [
              "150300805"
            ]
          },
          "150300805": {
            "id": "150300805",
            "speakerId": 1098,
            "speakerName": "瓦雷莎",
            "text": "解谜吗？我不是很擅长…可以简单一点吗？",
            "nextDialogs": [
              "150300806"
            ]
          },
          "150300806": {
            "id": "150300806",
            "speakerId": 15142,
            "speakerName": "爱茜蘑",
            "text": "我又不是你的同伴，怎么还和我商量起来了！",
            "nextDialogs": [
              "150300809"
            ]
          },
          "150300809": {
            "id": "150300809",
            "speakerId": 15142,
            "speakerName": "爱茜蘑",
            "text": "算了，准备好了吗，我要提出问题了。",
            "nextDialogs": [
              "150300810"
            ]
          },
          "150300810": {
            "id": "150300810",
            "speakerId": 15142,
            "speakerName": "爱茜蘑",
            "text": "为什么这片果园中的蘑菇，都甘愿成为「蕈之贤主」的臣民？",
            "nextDialogs": [
              "150300811"
            ]
          },
          "150300811": {
            "id": "150300811",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "呃，这我怎么知道…",
            "nextDialogs": [
              "150300812"
            ]
          },
          "150300812": {
            "id": "150300812",
            "speakerId": 1098,
            "speakerName": "瓦雷莎",
            "text": "因为…你们是它的分身吗？这好像是它说过的话。",
            "nextDialogs": [
              "150300813"
            ]
          },
          "150300813": {
            "id": "150300813",
            "speakerId": 15142,
            "speakerName": "爱茜蘑",
            "text": "真不机灵啊，当然不会是这么简单的答案。",
            "nextDialogs": [
              "150300814"
            ]
          },
          "150300814": {
            "id": "150300814",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "因为你们被「蕈」化了。",
            "nextDialogs": [
              "150300815"
            ]
          },
          "150300815": {
            "id": "150300815",
            "speakerId": 15142,
            "speakerName": "爱茜蘑",
            "text": "呃，为什么你一下子就想到了答案！",
            "nextDialogs": [
              "150300816"
            ]
          },
          "150300816": {
            "id": "150300816",
            "speakerId": 1098,
            "speakerName": "瓦雷莎",
            "text": "…好冷啊。",
            "nextDialogs": [
              "150300817"
            ]
          },
          "150300817": {
            "id": "150300817",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "可恶，我掉以轻心了。须弥的蕈兽…我本来该想到这种可能性的。",
            "nextDialogs": [
              "150300818"
            ]
          },
          "150300818": {
            "id": "150300818",
            "speakerId": 1098,
            "speakerName": "瓦雷莎",
            "text": "你的意思是，须弥人都很喜欢冷笑话吗？因为那边的天气很热？",
            "nextDialogs": [
              "150300819"
            ]
          },
          "150300819": {
            "id": "150300819",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "不不不，只是我们…呃，有些这方面的经验。",
            "nextDialogs": [
              "150300820"
            ]
          },
          "150300820": {
            "id": "150300820",
            "speakerId": 15142,
            "speakerName": "爱茜蘑",
            "text": "好吧，你们成功证明了你们的智慧，我也来回答你们的问题吧。",
            "nextDialogs": [
              "150300821"
            ]
          },
          "150300821": {
            "id": "150300821",
            "speakerId": 15142,
            "speakerName": "爱茜蘑",
            "text": "进食这一行为，并非只是满足生理需求的行为，它还是一种神圣的仪式。",
            "nextDialogs": [
              "150300822"
            ]
          },
          "150300822": {
            "id": "150300822",
            "speakerId": 15142,
            "speakerName": "爱茜蘑",
            "text": "我们这样的蘑菇，是「蕈之贤主」的媒介，焚灭我们的肉体，就可以和「蕈之贤主」建立精神之桥。",
            "nextDialogs": [
              "150300823"
            ]
          },
          "150300823": {
            "id": "150300823",
            "speakerId": 1098,
            "speakerName": "瓦雷莎",
            "text": "原来如此，之前已经体验过一次了。",
            "nextDialogs": [
              "150300824"
            ]
          },
          "150300824": {
            "id": "150300824",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "也就是说，我们想要再听到它的声音，就要…吃更多的蘑菇？",
            "nextDialogs": [
              "150300825"
            ]
          },
          "150300825": {
            "id": "150300825",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "喂，别跑！怎么又变成普通的蘑菇了，这不等于什么都没说嘛！",
            "nextDialogs": [
              "150300826"
            ]
          },
          "150300826": {
            "id": "150300826",
            "speakerId": 1098,
            "speakerName": "瓦雷莎",
            "text": "对它们来说，进食是仪式…那是不是还需要特定的仪式工具或者流程呢？",
            "nextDialogs": [
              "150300827"
            ]
          },
          "150300827": {
            "id": "150300827",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "有道理，你脑子转得也很快嘛！我们再去和其他的蘑菇确认一下吧。",
            "nextDialogs": [
              "150300828"
            ]
          },
          "150300828": {
            "id": "150300828",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "对了，它是绿蘑菇，别忘记摘掉它！"
          }
        }
      }
    },
    {
      "subId": "1503004",
      "subQuestName": "尝试调查神秘的蘑菇",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "150300601"
        ],
        "dialogs": {
          "150300601": {
            "id": "150300601",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "这里有一个红蘑菇…哇啊啊啊啊！",
            "nextDialogs": [
              "150300602"
            ]
          },
          "150300602": {
            "id": "150300602",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "蕈兽，它变成蕈兽了，纳塔为什么会有蕈兽！",
            "nextDialogs": [
              "150300603"
            ]
          },
          "150300603": {
            "id": "150300603",
            "speakerId": 1098,
            "speakerName": "瓦雷莎",
            "text": "这就是…臣民？嘿嘿，样子还挺可爱的呢。",
            "nextDialogs": [
              "150300604"
            ]
          },
          "150300604": {
            "id": "150300604",
            "speakerId": 15141,
            "speakerName": "蘑瓦塔里",
            "text": "牛战士，说话好听，嘉奖。",
            "nextDialogs": [
              "150300605"
            ]
          },
          "150300605": {
            "id": "150300605",
            "speakerId": 15141,
            "speakerName": "蘑瓦塔里",
            "text": "不对，牛战士，天敌，食物，反抗！",
            "nextDialogs": [
              "150300606"
            ]
          },
          "150300606": {
            "id": "150300606",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "小心啊，瓦雷莎，这是一种须弥的魔物，别看它长得可爱，会突然打人的。",
            "nextDialogs": [
              "150300607"
            ]
          },
          "150300607": {
            "id": "150300607",
            "speakerId": 1098,
            "speakerName": "瓦雷莎",
            "text": "是魔物吗？真可惜，那好像就没办法了，本来想好好相处的。",
            "nextDialogs": [
              "150300610"
            ]
          },
          "150300610": {
            "id": "150300610",
            "speakerId": 15141,
            "speakerName": "蘑瓦塔里",
            "text": "……",
            "nextDialogs": [
              "150300611"
            ]
          },
          "150300611": {
            "id": "150300611",
            "speakerId": 15141,
            "speakerName": "蘑瓦塔里",
            "text": "投降，投降！",
            "nextDialogs": [
              "150300612"
            ]
          },
          "150300612": {
            "id": "150300612",
            "speakerId": 15141,
            "speakerName": "蘑瓦塔里",
            "text": "食物，神圣！除此之外，浪费！",
            "nextDialogs": [
              "150300613"
            ]
          },
          "150300613": {
            "id": "150300613",
            "speakerId": 15141,
            "speakerName": "蘑瓦塔里",
            "text": "别的，不知道！不知道！",
            "nextDialogs": [
              "150300614"
            ]
          },
          "150300614": {
            "id": "150300614",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "变回普通的蘑菇了…呃，到底怎么回事啊。",
            "nextDialogs": [
              "150300615"
            ]
          },
          "150300615": {
            "id": "150300615",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "它好像只知道这么多。",
            "nextDialogs": [
              "150300616"
            ]
          },
          "150300616": {
            "id": "150300616",
            "speakerId": 1098,
            "speakerName": "瓦雷莎",
            "text": "「食物，神圣！」是这句话吗？",
            "nextDialogs": [
              "150300617"
            ]
          },
          "150300617": {
            "id": "150300617",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "光听这一个蘑菇的话，还是什么都理解不了啊，去别的地方看看吧。"
          }
        }
      }
    },
    {
      "subId": "1503007",
      "subQuestName": "继续调查神秘的蘑菇",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [],
        "dialogs": {}
      }
    },
    {
      "subId": "1503005",
      "subQuestName": "继续调查神秘的蘑菇",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "150300401"
        ],
        "dialogs": {
          "150300401": {
            "id": "150300401",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "那边有两只蕈兽好像在讨论什么呢。",
            "nextDialogs": [
              "150300402"
            ]
          },
          "150300402": {
            "id": "150300402",
            "speakerId": 15143,
            "speakerName": "菇兹亚",
            "text": "你想好等下要怎么考验那几个人类了吗？",
            "nextDialogs": [
              "150300403"
            ]
          },
          "150300403": {
            "id": "150300403",
            "speakerId": 15144,
            "speakerName": "阿蘑娜",
            "text": "#当然了，{M#他}{F#她}们看上去就不是很聪明，我随便出道题就能难倒{M#他}{F#她}们了。",
            "nextDialogs": [
              "150300404"
            ]
          },
          "150300404": {
            "id": "150300404",
            "speakerId": 15143,
            "speakerName": "菇兹亚",
            "text": "哇，好厉害，不愧和贤主大人一样，都有绿色的伞盖，我好羡慕。",
            "nextDialogs": [
              "150300405"
            ]
          },
          "150300405": {
            "id": "150300405",
            "speakerId": 15144,
            "speakerName": "阿蘑娜",
            "text": "#哼哼，一切都在我意料之中，等下{M#他}{F#她}们肯定会问——",
            "nextDialogs": [
              "150300406"
            ]
          },
          "150300406": {
            "id": "150300406",
            "speakerId": 15144,
            "speakerName": "阿蘑娜",
            "text": "「哎呀，求求你们告诉我们，要怎么进行仪式吧！」",
            "nextDialogs": [
              "150300407"
            ]
          },
          "150300407": {
            "id": "150300407",
            "speakerId": 15144,
            "speakerName": "阿蘑娜",
            "text": "「哼，这个世界从来不存在免费的答案，这样吧，天上的星月和地底的黑渊，你更擅长解答哪个问题？」",
            "nextDialogs": [
              "150300408"
            ]
          },
          "150300408": {
            "id": "150300408",
            "speakerId": 15143,
            "speakerName": "菇兹亚",
            "text": "「太难了太难了，难到我的伞盖都要喷出孢子了。」",
            "nextDialogs": [
              "150300409"
            ]
          },
          "150300409": {
            "id": "150300409",
            "speakerId": 15144,
            "speakerName": "阿蘑娜",
            "text": "#{M#他}{F#她}们是人类，怎么会有孢子，笨！",
            "nextDialogs": [
              "150300410"
            ]
          },
          "150300410": {
            "id": "150300410",
            "speakerId": 15143,
            "speakerName": "菇兹亚",
            "text": "哦，你说得对…",
            "nextDialogs": [
              "150300411"
            ]
          },
          "150300411": {
            "id": "150300411",
            "speakerId": 15144,
            "speakerName": "阿蘑娜",
            "text": "「连这种初级中的初级问题都答不上来，赶紧回去再学几十年吧！」",
            "nextDialogs": [
              "150300412"
            ]
          },
          "150300412": {
            "id": "150300412",
            "speakerId": 15143,
            "speakerName": "菇兹亚",
            "text": "再学几十年吧！",
            "nextDialogs": [
              "150300413"
            ]
          },
          "150300413": {
            "id": "150300413",
            "speakerId": 15144,
            "speakerName": "阿蘑娜",
            "text": "可能真的要几十年，那几个笨蛋才会反应过来，进食是一种仪式，那仪式手段当然是烹饪啦。",
            "nextDialogs": [
              "150300414"
            ]
          },
          "150300414": {
            "id": "150300414",
            "speakerId": 15143,
            "speakerName": "菇兹亚",
            "text": "当然是烹饪啦！",
            "nextDialogs": [
              "150300415"
            ]
          },
          "150300415": {
            "id": "150300415",
            "speakerId": 1098,
            "speakerName": "瓦雷莎",
            "text": "它们好像直接讲出来了…",
            "nextDialogs": [
              "150300416"
            ]
          },
          "150300416": {
            "id": "150300416",
            "speakerId": 15144,
            "speakerName": "阿蘑娜",
            "text": "喂，谁在那边？！",
            "nextDialogs": [
              "150300417"
            ]
          },
          "150300417": {
            "id": "150300417",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "一直笨笨笨的，到底谁才是笨蛋！",
            "nextDialogs": [
              "150300418"
            ]
          },
          "150300418": {
            "id": "150300418",
            "speakerId": 15143,
            "speakerName": "菇兹亚",
            "text": "可怕的白飘飘！可怕到伞盖要喷出孢子了！",
            "nextDialogs": [
              "150300419"
            ]
          },
          "150300419": {
            "id": "150300419",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "哪里可怕了，喂，还没说清楚就要逃跑吗！",
            "nextDialogs": [
              "150300422"
            ]
          },
          "150300422": {
            "id": "150300422",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "明明通过了考验，结果一点成就感都没有…",
            "nextDialogs": [
              "150300423"
            ]
          },
          "150300423": {
            "id": "150300423",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "说是要用「智慧」去获得线索，结果三条线索都不是靠「智慧」拿到的。",
            "nextDialogs": [
              "150300424"
            ]
          },
          "150300424": {
            "id": "150300424",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "算了，不纠结这种古怪的问题。总之，「蕈之贤主」希望我们使用烹饪的方式，在精神上与它建立更强的联系？",
            "nextDialogs": [
              "150300425"
            ]
          },
          "150300425": {
            "id": "150300425",
            "speakerId": 1098,
            "speakerName": "瓦雷莎",
            "text": "听上去好像是这样…我记得阿托力叔叔说过，这种蘑菇的烹饪温度越高，香味就越浓烈…",
            "nextDialogs": [
              "150300426"
            ]
          },
          "150300426": {
            "id": "150300426",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "对哦，之前在果园里你烹饪这种蘑菇的时候，好像也是这样，加热之后蘑菇变得很香很香。"
          }
        }
      }
    }
  ]
}
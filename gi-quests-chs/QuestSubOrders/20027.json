  "subQuests": [
    {
      "subId": "2002701",
      "subQuestName": "前去查看详请",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "200270101"
        ],
        "dialogs": {
          "200270101": {
            "id": "200270101",
            "speakerId": 153301,
            "speakerName": "特纳",
            "text": "#谢谢，谢谢你，{NICKNAME}…",
            "nextDialogs": [
              "200270102"
            ]
          },
          "200270102": {
            "id": "200270102",
            "speakerId": 153301,
            "speakerName": "特纳",
            "text": "我本来是想去看看葡萄藤的情况，结果却撞上这倒霉事…",
            "nextDialogs": [
              "200270103"
            ]
          },
          "200270103": {
            "id": "200270103",
            "speakerId": 153301,
            "speakerName": "特纳",
            "text": "唉，请你别告诉我儿子，他是城里的西风骑士。他平时工作肯定也很辛苦吧。",
            "nextDialogs": [
              "200270104"
            ]
          },
          "200270104": {
            "id": "200270104",
            "speakerId": 153301,
            "speakerName": "特纳",
            "text": "我这个老头子的一点小麻烦，就不要让他再烦心了。",
            "nextDialogs": [
              "200270105"
            ]
          },
          "200270105": {
            "id": "200270105",
            "speakerId": 153301,
            "speakerName": "特纳",
            "text": "但是最近，酒庄附近总是会出现史莱姆，我每天都在担心葡萄藤会被史莱姆给毁了，睡也睡不好。",
            "nextDialogs": [
              "200270106"
            ]
          },
          "200270106": {
            "id": "200270106",
            "speakerId": 153301,
            "speakerName": "特纳",
            "text": "如果你们有空的话，就帮我老头子一个忙，再去周围看看，把史莱姆都赶走，别让它们再来破坏了。",
            "nextDialogs": [
              "200270109",
              "200270110"
            ]
          },
          "200270109": {
            "id": "200270109",
            "speakerId": 153301,
            "speakerName": "特纳",
            "text": "太好了，我总算能休息一下了。"
          },
          "200270110": {
            "id": "200270110",
            "speakerId": 153301,
            "speakerName": "特纳",
            "text": "唉，本来说我自己来也行…但是老头子我真的动不了了，年轻人，你就帮帮我吧。"
          }
        }
      }
    },
    {
      "subId": "2002702",
      "subQuestName": "消灭史莱姆",
      "sceneId": null,
      "locations": [],

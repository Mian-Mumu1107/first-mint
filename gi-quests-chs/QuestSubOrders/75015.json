    },
    {
      "subId": "7501504",
      "subQuestName": "将鱼带回岸边",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "750150401"
        ],
        "dialogs": {
          "750150401": {
            "id": "750150401",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "#锵锵！真不愧是{NICKNAME}，把这条嚣张的鱼抓到咯！",
            "nextDialogs": [
              "750150402"
            ]
          },
          "750150402": {
            "id": "750150402",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "说起来，如果一次把饵全部洒进去，让鱼吃到翻肚皮，自动漂上来，是不是也算一种「钓鱼」呢？",
            "nextDialogs": [
              "750150403"
            ]
          },
          "750150403": {
            "id": "750150403",
            "speakerId": 1001,
            "speakerName": "#{REALNAME[ID(2)|SHOWHOST(true)]}",
            "text": "啊…啊呜…",
            "nextDialogs": [
              "750150404"
            ]
          },
          "750150404": {
            "id": "750150404",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "#{REALNAME[ID(2)|SHOWHOST(true)]}也觉得这样可以吗？看你的眼神很期待呢！嘿嘿，下次我们一起试试呀…",
            "nextDialogs": [
              "750150405"
            ]
          },
          "750150405": {
            "id": "750150405",
            "speakerId": 1001,
            "speakerName": "#{REALNAME[ID(2)|SHOWHOST(true)]}",
            "text": "啊呜…",
            "nextDialogs": [
              "750150406"
            ]
          },
          "750150406": {
            "id": "750150406",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "#哇！还没有烤呢，得等{NICKNAME}做好才能吃啦！",
            "nextDialogs": [
              "750150407"
            ]
          },
          "750150407": {
            "id": "750150407",
            "speakerId": 1002,
            "speakerName": "Black Screen",
            "text": "做完了烤鱼，大家一起饱餐了一顿。",
            "nextDialogs": [
              "750150408"
            ]
          },
          "750150408": {
            "id": "750150408",
            "speakerId": 1001,
            "speakerName": "#{REALNAME[ID(2)|SHOWHOST(true)]}",
            "text": "呀！",
            "nextDialogs": [
              "750150409"
            ]
          },
          "750150409": {
            "id": "750150409",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "总觉得这顿烤鱼格外的香呢，不愧是我钓起来的鱼！",
            "nextDialogs": [
              "750150410"
            ]
          },
          "750150410": {
            "id": "750150410",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "不愧是派蒙，以后都交给你了！",
            "nextDialogs": [
              "750150411"
            ]
          },
          "750150411": {
            "id": "750150411",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "哎…",
            "nextDialogs": [
              "750150412"
            ]
          },
          "750150412": {
            "id": "750150412",
            "speakerId": 1001,
            "speakerName": "#{REALNAME[ID(2)|SHOWHOST(true)]}",
            "text": "呀！",
            "nextDialogs": [
              "750150413"
            ]
          },
          "750150413": {
            "id": "750150413",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "#别想着不劳而获，如果要吃到鱼，那{REALNAME[ID(2)|SHOWHOST(true)]}你下次也得帮忙才行！",
            "nextDialogs": [
              "750150414"
            ]
          },
          "750150414": {
            "id": "750150414",
            "speakerId": 1001,
            "speakerName": "#{REALNAME[ID(2)|SHOWHOST(true)]}",
            "text": "唔嗯？",
            "nextDialogs": [
              "750150415"
            ]
          },
          "750150415": {
            "id": "750150415",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "这种时候就开始装傻了，你这家伙！"
          }
        }
      }
    }
  ]
}
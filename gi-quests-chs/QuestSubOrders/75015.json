    {
      "subId": "7501505",
      "subQuestName": "等待派蒙钓鱼",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "750150501"
        ],
        "dialogs": {
          "750150501": {
            "id": "750150501",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "呼，总算清理完了，那、那我就要开始钓鱼了！",
            "nextDialogs": [
              "750150502"
            ]
          },
          "750150502": {
            "id": "750150502",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "唔，我一定要钓上条大鱼给你们看看！",
            "nextDialogs": [
              "750150503"
            ]
          },
          "750150503": {
            "id": "750150503",
            "speakerId": 1002,
            "speakerName": "Black Screen",
            "text": "但可惜水面一动不动，没有波澜。",
            "nextDialogs": [
              "750150504"
            ]
          },
          "750150504": {
            "id": "750150504",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "唔…是不是这里的水质太好了？鱼儿根本不想从里面出来嘛！",
            "nextDialogs": [
              "750150506",
              "750150509"
            ]
          },
          "750150506": {
            "id": "750150506",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "就是这样，「胜利就在眼前！」…不对，这才刚开始，离胜利还早着呢！",
            "nextDialogs": [
              "750150507"
            ]
          },
          "750150507": {
            "id": "750150507",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "不要在这种时候胡乱鼓励啦！",
            "nextDialogs": [
              "750150511"
            ]
          },
          "750150511": {
            "id": "750150511",
            "speakerId": 1001,
            "speakerName": "#{REALNAME[ID(2)|SHOWHOST(true)]}",
            "text": "唔…",
            "nextDialogs": [
              "750150512"
            ]
          },
          "750150512": {
            "id": "750150512",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "要成功了，要成功了！",
            "nextDialogs": [
              "750150513"
            ]
          },
          "750150513": {
            "id": "750150513",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "哎呀，你别在这个时候说话啦…真是的！",
            "nextDialogs": [
              "750150514"
            ]
          },
          "750150514": {
            "id": "750150514",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "怎么了怎么了？哇！鱼竿动了，让我看看是什么好东西？",
            "nextDialogs": [
              "750150515"
            ]
          },
          "750150515": {
            "id": "750150515",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "#什么嘛，不是鱼，是个漂流瓶，而且还用线绑在了钓点的木板上…说起来，{NICKNAME}也经常钓上来奇怪的东西。",
            "nextDialogs": [
              "750150516"
            ]
          },
          "750150516": {
            "id": "750150516",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "钓鱼的什么都能钓到，除了鱼…",
            "nextDialogs": [
              "750150517"
            ]
          },
          "750150517": {
            "id": "750150517",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "#{NICKNAME}不也经常钓到些奇怪的东西嘛，毕竟是钓上来的，让我看看里面塞了什么…",
            "nextDialogs": [
              "750150518"
            ]
          },
          "750150518": {
            "id": "750150518",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "沉迷钓鱼的人，好可怕，难道刚才那堆乱七八糟的东西都是这两个人留下的？",
            "nextDialogs": [
              "750150519"
            ]
          },
          "750150519": {
            "id": "750150519",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "我们还是把这个瓶子扔回去吧，看来这就是他们互相联络的工具了…",
            "nextDialogs": [
              "750150520"
            ]
          },
          "750150520": {
            "id": "750150520",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "唔，我有预感，下次肯定能够钓到鱼的！",
            "nextDialogs": [
              "750150521"
            ]
          },
          "750150521": {
            "id": "750150521",
            "speakerId": 1002,
            "speakerName": "Black Screen",
            "text": "鱼竿猛地一沉，剧烈地抖动了起来，\\n水底下是个分量不轻的「大家伙」，恶狠狠地咬上了钩。",
            "nextDialogs": [
              "750150522"
            ]
          },
          "750150522": {
            "id": "750150522",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "终于吃钩了！这回一定是大鱼，给我上来——啊！",
            "nextDialogs": [
              "750150523"
            ]
          },
          "750150523": {
            "id": "750150523",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "给我上来——啊！",
            "nextDialogs": [
              "750150524"
            ]
          },
          "750150524": {
            "id": "750150524",
            "speakerId": 1001,
            "speakerName": "#{REALNAME[ID(2)|SHOWHOST(true)]}",
            "text": "呀呀！！",
            "nextDialogs": [
              "750150525"
            ]
          },
          "750150525": {
            "id": "750150525",
            "speakerId": 1002,
            "speakerName": "Black Screen",
            "text": "#看到派蒙很吃力。\\n你和{REALNAME[ID(2)|SHOWHOST(true)]}一起抱住了派蒙…\\n但是，钓竿对面传来了巨大的拉力！",
            "nextDialogs": [
              "750150526"
            ]
          },
          "750150526": {
            "id": "750150526",
            "speakerId": 1002,
            "speakerName": "Black Screen",
            "text": "「砰」的一声，鱼脱钩了…",
            "nextDialogs": [
              "750150527"
            ]
          },
          "750150527": {
            "id": "750150527",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "呜呜！这一定是一条好大的鱼，鱼钩才会脱钩啦！",
            "nextDialogs": [
              "750150528"
            ]
          },
          "750150528": {
            "id": "750150528",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "真是气死了…啊，它居然还在水面上游来游去，岂有此理！",
            "nextDialogs": [
              "750150529"
            ]
          },
          "750150529": {
            "id": "750150529",
            "speakerId": 1001,
            "speakerName": "#{REALNAME[ID(2)|SHOWHOST(true)]}",
            "text": "呀呀——",
            "nextDialogs": [
              "750150530"
            ]
          },
          "750150530": {
            "id": "750150530",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "不行不行，海里太危险了，你游得也没有鱼快啦…",
            "nextDialogs": [
              "750150531"
            ]
          },
          "750150531": {
            "id": "750150531",
            "speakerId": 1001,
            "speakerName": "#{REALNAME[ID(2)|SHOWHOST(true)]}",
            "text": "唔…",
            "nextDialogs": [
              "750150532"
            ]
          },
          "750150532": {
            "id": "750150532",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "#要是有什么办法抓住那条鱼就好了，{NICKNAME}…"
          },
          "750150509": {
            "id": "750150509",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "嗯嗯，鱼儿吃钩的时机，像甜甜花里蹿出来一朵骗骗花一样突然，完全没法预测…",
            "nextDialogs": [
              "750150510"
            ]
          },
          "750150510": {
            "id": "750150510",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "只能专注地等待——再等待——"
          }
        }
      }
    },
    {
      "subId": "7501503",
      "subQuestName": "追回逃跑的鱼",
      "sceneId": null,
      "locations": [],
      "dialogue": {

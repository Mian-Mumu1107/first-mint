  "subQuests": [
    {
      "subId": "7501501",
      "subQuestName": "(test)触发关卡演出完成剧情$HIDDEN",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "750150101"
        ],
        "dialogs": {
          "750150101": {
            "id": "750150101",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "这条鱼的力气好大，刚才和我们拉扯了那么久，居然还能游得这么快。",
            "nextDialogs": [
              "750150102"
            ]
          },
          "750150102": {
            "id": "750150102",
            "speakerId": 1001,
            "speakerName": "#{REALNAME[ID(2)|SHOWHOST(true)]}",
            "text": "呀呀…",
            "nextDialogs": [
              "750150103"
            ]
          },
          "750150103": {
            "id": "750150103",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "#嗯嗯，没关系，{NICKNAME}一定会把鱼抓回来的。"
          }
        }
      }
    },
    {
      "subId": "7501506",
      "subQuestName": "与龙伙伴对话",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "750150601"
        ],
        "dialogs": {
          "750150601": {
            "id": "750150601",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "这片浅水海滩很不错呢！又暖和又明亮，还有人在这里支着钓竿，说不定这是个很好的钓点呢！",
            "nextDialogs": [
              "750150602"
            ]
          },
          "750150602": {
            "id": "750150602",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "不如我们在这里钓钓看吧！",
            "nextDialogs": [
              "750150603"
            ]
          },
          "750150603": {
            "id": "750150603",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "说不定能钓上另一个向导…",
            "nextDialogs": [
              "750150604"
            ]
          },
          "750150604": {
            "id": "750150604",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "不许钓，而且世上哪有那么多的我能给你钓上来啦！",
            "nextDialogs": [
              "750150605"
            ]
          },
          "750150605": {
            "id": "750150605",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "#还是钓点鱼吧，我们好像有段时间没吃{NICKNAME}做的鱼了，就让{REALNAME[ID(2)|SHOWHOST(true)]}也尝尝你的手艺嘛！",
            "nextDialogs": [
              "750150606"
            ]
          },
          "750150606": {
            "id": "750150606",
            "speakerId": 1001,
            "speakerName": "#{REALNAME[ID(2)|SHOWHOST(true)]}",
            "text": "呀！",
            "nextDialogs": [
              "750150607"
            ]
          },
          "750150607": {
            "id": "750150607",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "#嘿嘿，都是为了{REALNAME[ID(2)|SHOWHOST(true)]}嘛。",
            "nextDialogs": [
              "750150608"
            ]
          },
          "750150608": {
            "id": "750150608",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "那派蒙也为它做点什么吧…",
            "nextDialogs": [
              "750150609"
            ]
          },
          "750150609": {
            "id": "750150609",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "不如这次就由派蒙来钓鱼！",
            "nextDialogs": [
              "750150610"
            ]
          },
          "750150610": {
            "id": "750150610",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "欸，我…我来钓鱼？",
            "nextDialogs": [
              "750150611"
            ]
          },
          "750150611": {
            "id": "750150611",
            "speakerId": 1001,
            "speakerName": "#{REALNAME[ID(2)|SHOWHOST(true)]}",
            "text": "呀！呀！",
            "nextDialogs": [
              "750150612"
            ]
          },
          "750150612": {
            "id": "750150612",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "#都是为了{REALNAME[ID(2)|SHOWHOST(true)]}嘛。",
            "nextDialogs": [
              "750150613"
            ]
          },
          "750150613": {
            "id": "750150613",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "唔…居然拿我说的话来堵我！",
            "nextDialogs": [
              "750150614"
            ]
          },
          "750150614": {
            "id": "750150614",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "那好吧…不过先说好了，我都不知道自己能钓起来什么东西！",
            "nextDialogs": [
              "750150615"
            ]
          },
          "750150615": {
            "id": "750150615",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "以及在那之前…大钓手派蒙需要一个干净的钓鱼环境，你看水面上有这么多东西，要是把线勾住了怎么办！",
            "nextDialogs": [
              "750150616"
            ]
          },
          "750150616": {
            "id": "750150616",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "还是先收拾一下吧！"
          }
        }
      }
    },
    {
      "subId": "7501502",
      "subQuestName": "清理附近的水域",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [],

    {
      "subId": "7601116",
      "subQuestName": "调查初谕之庭",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "760111601"
        ],
        "dialogs": {
          "760111601": {
            "id": "760111601",
            "speakerId": 22161,
            "speakerName": "爱依菈",
            "text": "啊，您来了…等一下，这样会把祭坛弄脏的…",
            "nextDialogs": [
              "760111602"
            ]
          },
          "760111602": {
            "id": "760111602",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "欸？！你…你是什么时候进来的？明明是我们先打开的封印…",
            "nextDialogs": [
              "760111604",
              "760111606"
            ]
          },
          "760111604": {
            "id": "760111604",
            "speakerId": 21835,
            "speakerName": "维娜",
            "text": "#{NICKNAME}说的对…不过，已经不只是有些不对劲的问题了，看样子，这个应该是通过月神大人的祝{RUBY#[D]月矩力}福留下的残像…",
            "nextDialogs": [
              "760111610"
            ]
          },
          "760111610": {
            "id": "760111610",
            "speakerId": 21835,
            "speakerName": "维娜",
            "text": "而且还是在初谕之庭里留下的残像…说不定，这、这位就是最初的咏月使，爱依菈大人…"
          },
          "760111606": {
            "id": "760111606",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "嗯嗯，那倒也是…不对，现在好像不是说这个的时候吧！那个…你到底是什么人呀？",
            "nextDialogs": [
              "760111607"
            ]
          },
          "760111607": {
            "id": "760111607",
            "speakerId": 21835,
            "speakerName": "维娜",
            "text": "那个…恐怕已经不是人了…",
            "nextDialogs": [
              "760111608"
            ]
          },
          "760111608": {
            "id": "760111608",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "噫！不、不要突然说这么可怕的事情呀！难道说…",
            "nextDialogs": [
              "760111609"
            ]
          },
          "760111609": {
            "id": "760111609",
            "speakerId": 21835,
            "speakerName": "维娜",
            "text": "不是那个意思啦！这世上又没有鬼魂之类的东西…应、应该吧？看样子，这个是通过月神大人的祝{RUBY#[D]月矩力}福留下的残像…"
          }
        }
      }
    },
    {
      "subId": "7601111",
      "subQuestName": "调查爱依菈留下的剑",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "760111101"
        ],
        "dialogs": {
          "760111101": {
            "id": "760111101",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "#唔，爱依菈说的应该就是这把剑了吧？怎么样，{NICKNAME}，理解什么了吗？",
            "nextDialogs": [
              "760111105",
              "760111104"
            ]
          },
          "760111105": {
            "id": "760111105",
            "speakerId": 21842,
            "speakerName": "维娜",
            "text": "呜啊，果然还是得把这里彻底调查一遍才行吗…但要是拖得太久，说不定安洛丝和科罗德大叔他们也会发现入口…",
            "nextDialogs": [
              "760111106"
            ]
          },
          "760111106": {
            "id": "760111106",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "呃，刚才闹出这么大的动静，整个希汐岛上应该没人不被引到这边来了吧…",
            "nextDialogs": [
              "760111107"
            ]
          },
          "760111107": {
            "id": "760111107",
            "speakerId": 21842,
            "speakerName": "维娜",
            "text": "呜呜，没办法了…既然拿到剑了，爱依菈大人又没有说接下来要做什么，我们还是先离开这里再好好研究吧！"
          },
          "760111104": {
            "id": "760111104",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "#噫！{NICKNAME}，怎么会这——不对，你这演技也太烂啦，好歹别自己笑出来啊！而且不要在这种时候吓人啦！"
          }
        }
      }
    },

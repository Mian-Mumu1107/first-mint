    {
      "subId": "7601109",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "760110901"
        ],
        "dialogs": {
          "760110901": {
            "id": "760110901",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "唔，爱依菈说的应该就是这把剑了吧？",
            "nextDialogs": [
              "760110902"
            ]
          },
          "760110902": {
            "id": "760110902",
            "speakerId": 21842,
            "speakerName": "维娜",
            "text": "没错没错！这就是传说中最初的咏月使大人向新月奉上第一滴银血的圣刃，是真正蒙受了祝福的无垢之剑！",
            "nextDialogs": [
              "760110903"
            ]
          },
          "760110903": {
            "id": "760110903",
            "speakerId": 21842,
            "speakerName": "维娜",
            "text": "呜啊，好想把这里仔仔细细调查一遍…但要是拖得太久，说不定安洛丝和科罗德大叔他们也会发现入口…",
            "nextDialogs": [
              "760110904"
            ]
          },
          "760110904": {
            "id": "760110904",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "呃，刚才闹出这么大的动静，整个希汐岛上应该没人不被引到这边来了吧…",
            "nextDialogs": [
              "760110905"
            ]
          },
          "760110905": {
            "id": "760110905",
            "speakerId": 21842,
            "speakerName": "维娜",
            "text": "呜呜，没办法了…既然已经拿到剑了，封印也已经解除了，之后再找机会来好好研究吧！"
          }
        }
      }
    },
    {
      "subId": "7601128",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "760112801"
        ],
        "dialogs": {
          "760112801": {
            "id": "760112801",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "说起来，你还记不记得，之前在雷图礁的时候，维娜提过一个叫初谕之庭的地方…",
            "nextDialogs": [
              "760112802"
            ]
          },
          "760112802": {
            "id": "760112802",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "好像是在希汐岛那边？要是有空的话，我们回去看看吧？"
          }
        }
      }
    }

    "莱赫妲尔": 12,
    "陌生的声音": 20,
    "？？？": 2
  },
  "subQuests": [
    {
      "subId": "7601101",
      "subQuestName": "与维娜对话",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "760110101"
        ],
        "dialogs": {
          "760110101": {
            "id": "760110101",
            "speakerId": 10205,
            "speakerName": "？？？",
            "text": "#啊，是{NICKNAME}和派蒙！又见面啦！",
            "nextDialogs": [
              "760110102"
            ]
          },
          "760110102": {
            "id": "760110102",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "咦？那个…这位祭司姐姐，我们在什么地方见过吗？我好像完全没有印象了…",
            "nextDialogs": [
              "760110127"
            ]
          },
          "760110127": {
            "id": "760110127",
            "speakerId": 10205,
            "speakerName": "？？？",
            "text": "是我啦，是我！真是的，明明不久之前才在那个地方见过面，听声音也该听出来了吧？",
            "nextDialogs": [
              "760110128"
            ]
          },
          "760110128": {
            "id": "760110128",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "哦哦，原来是你呀，在那个地方见过的——呃，所以你是哪一位来着？总觉得这个对话听着像是什么奇怪的诈骗一样…",
            "nextDialogs": [
              "760110130"
            ]
          },
          "760110130": {
            "id": "760110130",
            "speakerId": 21842,
            "speakerName": "维娜",
            "text": "唉，派蒙连我都认不出来，好伤心。算了，看在你叫我祭司姐姐的份上就原谅你啦，毕竟在雷图礁的时候我也没摘过头盔…",
            "nextDialogs": [
              "760110129"
            ]
          },
          "760110129": {
            "id": "760110129",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "欸？等一下，你该不会是维娜吧？原来你真的是霜月之子的祭司吗！",
            "nextDialogs": [
              "760110103"
            ]
          },
          "760110103": {
            "id": "760110103",
            "speakerId": 21842,
            "speakerName": "维娜",
            "text": "这、这是什么奇怪的说法啦！真是的，很少有比我更可靠的执祭了吧？从一开始就没必要怀疑啦！",
            "nextDialogs": [
              "760110104"
            ]
          },
          "760110104": {
            "id": "760110104",
            "speakerId": 21842,
            "speakerName": "维娜",
            "text": "咳咳，总之，这也一定是月之{RUBY#[D]库塔尔}少女的指引，否则怎么会这么巧合，恰好让我在这种时候遇到两位呢？",
            "nextDialogs": [
              "760110106",
              "760110108"
            ]
          },
          "760110106": {
            "id": "760110106",
            "speakerId": 21842,
            "speakerName": "维娜",
            "text": "没错没错，这就是所谓的命运啦。「她用银梭将不同的道途纺于一处，无论是贫者亦或…」呃，亦或…",
            "nextDialogs": [
              "760110109"
            ]
          },
          "760110109": {
            "id": "760110109",
            "speakerId": 21842,
            "speakerName": "维娜",
            "text": "#算了，先不管那个啦！{NICKNAME}和派蒙应该还记得之前那个可恶的冒牌货说过的话吧？",
            "nextDialogs": [
              "760110110"
            ]
          },
          "760110110": {
            "id": "760110110",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "欸？我想想哦，那个比维娜更像祭司的姐姐好像是说，要在被封锁的初谕之庭等我们…之类的？",
            "nextDialogs": [
              "760110111"
            ]
          },
          "760110111": {
            "id": "760110111",
            "speakerId": 21842,
            "speakerName": "维娜",
            "text": "「比维娜更像祭司」的部分是多余的哦。不过因为派蒙的记性很好，而且接下来会好心帮助我，所以我就当没听到吧。",
            "nextDialogs": [
              "760110112"
            ]
          },
          "760110112": {
            "id": "760110112",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "「接下来会好心帮助我」的部分我倒是没办法当作没听到！怎么回事，总觉得每次和维娜说话都会让我开始怀疑记忆…",
            "nextDialogs": [
              "760110113"
            ]
          },
          "760110113": {
            "id": "760110113",
            "speakerId": 21842,
            "speakerName": "维娜",
            "text": "那种小事就先别在意啦。总之，我已经想出了一个超级可靠、万无一失的计划，很快就能抓住那个冒牌货了！",
            "nextDialogs": [
              "760110114"
            ]
          },
          "760110114": {
            "id": "760110114",
            "speakerId": 21842,
            "speakerName": "维娜",
            "text": "你看，既然那家伙声称，要在根本进不去的、被封锁的圣所里等我们，那事情的真相就很简单了…",
            "nextDialogs": [
              "760110115"
            ]
          },
          "760110115": {
            "id": "760110115",
            "speakerId": 21842,
            "speakerName": "维娜",
            "text": "没错！那个冒牌货的意图，就是借助我们的好奇心，解除圣所的封印，好趁机夺取里面的宝藏！",
            "nextDialogs": [
              "760110116"
            ]
          },
          "760110116": {
            "id": "760110116",
            "speakerId": 21842,
            "speakerName": "维娜",
            "text": "所以呀，我的计划就是「将计就计」！只要打开圣所的大门，她就必定会现身，如此一来就能将她当场抓获啦！",
            "nextDialogs": [
              "760110117"
            ]
          },
          "760110117": {
            "id": "760110117",
            "speakerId": 21842,
            "speakerName": "维娜",
            "text": "怎么样，是相当可靠的计划吧？就算是和「扳手老爹」给我的书里那些名侦探相比也丝毫不落下风！",
            "nextDialogs": [
              "760110118"
            ]
          },
          "760110118": {
            "id": "760110118",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "听上去比之前在雷图礁的计划还离谱啊！别的先不提，你之前不是说圣所的封印一直没人能打开吗？",
            "nextDialogs": [
              "760110119"
            ]
          },
          "760110119": {
            "id": "760110119",
            "speakerId": 21842,
            "speakerName": "维娜",
            "text": "#哼哼，那是因为没遇到可靠的我，还有超级可靠的{NICKNAME}和派蒙啦。",
            "nextDialogs": [
              "760110120"
            ]
          },
          "760110120": {
            "id": "760110120",
            "speakerId": 21842,
            "speakerName": "维娜",
            "text": "上次分别以后我就一直在想，既然圣所也是由月矩力封锁起来的，那就可以用雷图礁类似的方法扰动封锁…",
            "nextDialogs": [
              "760110121"
            ]
          },
          "760110121": {
            "id": "760110121",
            "speakerId": 21842,
            "speakerName": "维娜",
            "text": "所以——锵锵！你们看，我让可爱的小克莱卡们去找了很多类似的碎片，把它们拼在一起啦！",
            "nextDialogs": [
              "760110122"
            ]
          },
          "760110122": {
            "id": "760110122",
            "speakerId": 21842,
            "speakerName": "维娜",
            "text": "而且我刚把爱维琳想办法支开，你们就出现了！怎么样怎么样，听上去就很有宿命感吧？",
            "nextDialogs": [
              "760110123"
            ]
          },
          "760110123": {
            "id": "760110123",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "与其说是宿命感，倒不如说是要命感吧！真的不会把希汐岛的天气也变得和雷图礁之前一样奇怪吗？",
            "nextDialogs": [
              "760110124"
            ]
          },
          "760110124": {
            "id": "760110124",
            "speakerId": 21842,
            "speakerName": "维娜",
            "text": "不会不会，和上次不一样，这次的我可是能正常使用月矩力的！而且上次的事最后也完美解决了，所以不用担心啦。",
            "nextDialogs": [
              "760110125"
            ]
          },
          "760110125": {
            "id": "760110125",
            "speakerId": 21842,
            "speakerName": "维娜",
            "text": "#那么接下来，{NICKNAME}和派蒙，就请见证名为「科学」的奇迹——",
            "nextDialogs": [
              "760110126"
            ]
          },
          "760110126": {
            "id": "760110126",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "等、等一下！如果非得要投的话，好歹让我们来投吧！总觉得要是让你来做的话，会导致这个不可靠的计划更不可靠…"
          },
          "760110108": {
            "id": "760110108",
            "speakerId": 21842,
            "speakerName": "维娜",
            "text": "哎呀，怎么会是不妙的预感呢？既然是月神大人的指引，就一定是吉兆才对啦，吉兆！"
          }
        }
      }
    },
    {
      "subId": "7601102",
      "subQuestName": "投掷碎片以打开封锁的圣所",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "760110201"
        ],
        "dialogs": {
          "760110201": {
            "id": "760110201",
            "speakerId": 21842,
            "speakerName": "维娜",
            "text": "哼哼，怎么样怎么样！和我预测的完全一样吧？只要沿着月神大人的指引前进，不管什么问题都能迎刃而解啦！",
            "nextDialogs": [
              "760110202"
            ]
          },
          "760110202": {
            "id": "760110202",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "虽然我是不懂什么指引的事啦…不过就这样把封锁了几百年的圣地给打开，真的没问题吗？",
            "nextDialogs": [
              "760110203"
            ]
          },
          "760110203": {
            "id": "760110203",
            "speakerId": 21842,
            "speakerName": "维娜",
            "text": "哎呀，没问题没问题！霜月的执祭都这么说了，完全没必要担——",
            "nextDialogs": [
              "760110204"
            ]
          },
          "760110204": {
            "id": "760110204",
            "speakerId": 16136,
            "speakerName": "安洛丝",
            "text": "喂，科罗德，你看到刚才那几个鬼鬼祟祟的家伙逃到哪里去了吗？",
            "nextDialogs": [
              "760110205"
            ]
          },
          "760110205": {
            "id": "760110205",
            "speakerId": 7097,
            "speakerName": "科罗德",
            "text": "逃得还挺快。看样子是冲着初谕之庭去的，毕竟这附近也没有什么其他可供藏身的地方了。",
            "nextDialogs": [
              "760110206"
            ]
          },
          "760110206": {
            "id": "760110206",
            "speakerId": 7106,
            "speakerName": "莱赫妲尔",
            "text": "哼，就算想逃又能逃到什么地方？你们几个先去确认一下初谕之庭的封印，我去通知咏月使大人。",
            "nextDialogs": [
              "760110207"
            ]
          },
          "760110207": {
            "id": "760110207",
            "speakerId": 7106,
            "speakerName": "莱赫妲尔",
            "text": "竟然有人敢在霜月祝福的神圣土地上如此放肆，我看也是活腻了！除非是库塔{RUBY#[D]月之少女}尔大人莅临，否则…",
            "nextDialogs": [
              "760110208"
            ]
          },
          "760110208": {
            "id": "760110208",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "呃…维娜，你刚才是不是想说「完全没必要担心」之类的话来着？",
            "nextDialogs": [
              "760110209"
            ]
          },
          "760110209": {
            "id": "760110209",
            "speakerId": 21842,
            "speakerName": "维娜",
            "text": "哼…哼哼！没错，完全没必要担心！既然封印已经打开了，接下来只要在里面布下陷阱，等那个入侵的冒牌货现身——",
            "nextDialogs": [
              "760110210"
            ]
          },
          "760110210": {
            "id": "760110210",
            "speakerId": 21842,
            "speakerName": "维娜",
            "text": "#…对不起对不起对不起我知道错了我不该随便解开封印的现在要怎么办呀，{NICKNAME}救救我，呜…",
            "nextDialogs": [
              "760110212",
              "760110214"
            ]
          },
          "760110212": {
            "id": "760110212",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "就是就是！唉，算了，既然都已经打开封印了，还是先进去看看吧…不过维娜之后一定要记得向霜月的大家好好道歉！"
          },
          "760110214": {
            "id": "760110214",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "是呀，既然都已经打开封印了，还是先进去看看吧…不过维娜之后一定要记得向霜月的大家好好道歉！"
          }
        }
      }
    },
    {
      "subId": "7601103",
      "subQuestName": "与维娜对话",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "760110301"
        ],
        "dialogs": {
          "760110301": {
            "id": "760110301",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "呃…维娜，这是什么地方？看上去不太像什么圣所…",
            "nextDialogs": [
              "760110302"
            ]
          },
          "760110302": {
            "id": "760110302",
            "speakerId": 21835,
            "speakerName": "维娜",
            "text": "我看着也不像…咳，不对，没关系，别担心！既然这里也有和月灵旅路一样的东西，就说明月神大人还在指引着我们…大、大概！",
            "nextDialogs": [
              "760110303"
            ]
          },
          "760110303": {
            "id": "760110303",
            "speakerId": 21835,
            "speakerName": "维娜",
            "text": "只要沿着月光照耀的道路前行就好，剩下的事情就交给月的意志吧。",
            "nextDialogs": [
              "760110304"
            ]
          },
          "760110304": {
            "id": "760110304",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "咦？维娜突然说出了很像正经祭司的话…不对，仔细想想，这不就是「我也不知道怎么办，听天由命吧」的意思吗！",
            "nextDialogs": [
              "760110305"
            ]
          },
          "760110305": {
            "id": "760110305",
            "speakerId": 21835,
            "speakerName": "维娜",
            "text": "什么叫「很像正经祭司」啦，真是的。派蒙难道还见过什么不正经的祭司吗？",
            "nextDialogs": [
              "760110306"
            ]
          },
          "760110306": {
            "id": "760110306",
            "speakerId": 21835,
            "speakerName": "维娜",
            "text": "要像相信科学的力量一样，相信月神大人的指引！…况且现在也找不到其他下去的办法了嘛。"
          }
        }
      }
    },
    {
      "subId": "7601104",
      "subQuestName": "与维娜对话",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "760110401"
        ],
        "dialogs": {
          "760110401": {
            "id": "760110401",
            "speakerId": 21842,
            "speakerName": "维娜",
            "text": "真是的，都说了没必要担心嘛！这就是科学的力量！",
            "nextDialogs": [
              "760110402"
            ]
          },
          "760110402": {
            "id": "760110402",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "#原来如此，不愧是科学的…咦，好像和科学完全没有关系，这不纯粹是靠着{NICKNAME}扔上去的嘛！",
            "nextDialogs": [
              "760110403"
            ]
          },
          "760110403": {
            "id": "760110403",
            "speakerId": 21842,
            "speakerName": "维娜",
            "text": "#哎呀，因为超级可靠的{NICKNAME}也是相信科学的人，所以这种说法也没有问题啦。",
            "nextDialogs": [
              "760110404"
            ]
          },
          "760110404": {
            "id": "760110404",
            "speakerId": 21842,
            "speakerName": "维娜",
            "text": "好，「既然月之{RUBY#[D]库塔尔}少女已经为我等纺就了银白的通途，等待在门扉彼端的便也唯有」…唯有…",
            "nextDialogs": [
              "760110405"
            ]
          },
          "760110405": {
            "id": "760110405",
            "speakerId": 21842,
            "speakerName": "维娜",
            "text": "咳，总之就是…既然出现了月灵旅路，就说明我们的计划是没问题的，只要沿着它前进就好。这就是月神大人的指引，嗯！",
            "nextDialogs": [
              "760110406"
            ]
          },
          "760110406": {
            "id": "760110406",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "真、真的没问题吗？总觉得这条路好像不是通往圣所里的，而是朝着更高的地方去了…",
            "nextDialogs": [
              "760110407"
            ]
          },
          "760110407": {
            "id": "760110407",
            "speakerId": 21842,
            "speakerName": "维娜",
            "text": "#没问题没问题！有我这么可靠的执祭，还有{NICKNAME}这样比我更可靠的冒险家，不用担心啦。",
            "nextDialogs": [
              "760110408"
            ]
          },
          "760110408": {
            "id": "760110408",
            "speakerId": 21842,
            "speakerName": "维娜",
            "text": "事不宜迟，趁着其他执祭还没有赶过来…咳，我的意思是说，趁着月神大人为我们指出了道路，我们快点上去吧！"
          }
        }
      }
    },
    {
      "subId": "7601105",
      "subQuestName": "沿月灵旅路前进",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "760110501"
        ],
        "dialogs": {
          "760110501": {
            "id": "760110501",
            "speakerId": 21835,
            "speakerName": "维娜",
            "text": "咦？感觉好安静啊，安洛丝和科罗德大叔也不在，明明刚才一起朝着这边过来了…",
            "nextDialogs": [
              "760110502"
            ]
          },
          "760110502": {
            "id": "760110502",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "可能是因为刚才在上面闹出的动静实在是太大，所以他们被引到别处去调查了吧…",
            "nextDialogs": [
              "760110503"
            ]
          },
          "760110503": {
            "id": "760110503",
            "speakerId": 21835,
            "speakerName": "维娜",
            "text": "#哼…哼哼！原来如此，这也是爱依菈大人的指引吧？果然，只要和可靠的{NICKNAME}一起行动，连运气也会变得更可靠——",
            "nextDialogs": [
              "760110504"
            ]
          },
          "760110504": {
            "id": "760110504",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "现在不是庆幸的时候啦。维娜应该还记得要向霜月的大家好好道歉的事吧？",
            "nextDialogs": [
              "760110505"
            ]
          },
          "760110505": {
            "id": "760110505",
            "speakerId": 21835,
            "speakerName": "维娜",
            "text": "欸？道什么…咳，当、当然记得啦！真是的，我才不是那种因为看到圣女留下的记录太兴奋，就把其他事忘在一边的人呢！",
            "nextDialogs": [
              "760110506"
            ]
          },
          "760110506": {
            "id": "760110506",
            "speakerId": 21835,
            "speakerName": "维娜",
            "text": "我以月下世界的凡名保证，一定会诚心实意地认错的！只是…呃，该怎么开口，我得先好好想想才行…",
            "nextDialogs": [
              "760110507"
            ]
          },
          "760110507": {
            "id": "760110507",
            "speakerId": 21835,
            "speakerName": "维娜",
            "text": "啊，对了！就在刚才，我想出了一个讲科学的计划！",
            "nextDialogs": [
              "760110508"
            ]
          },
          "760110508": {
            "id": "760110508",
            "speakerId": 21835,
            "speakerName": "维娜",
            "text": "既然都是要道歉的，那不如让我先把圣所仔细调查一遍，再去向菈乌玛道歉。这样一来就可以节约时间，提高道歉的效率——",
            "nextDialogs": [
              "760110509"
            ]
          },
          "760110509": {
            "id": "760110509",
            "speakerId": 7106,
            "speakerName": "莱赫妲尔",
            "text": "原来如此，计划倒是不错。",
            "nextDialogs": [
              "760110510"
            ]
          },
          "760110510": {
            "id": "760110510",
            "speakerId": 21835,
            "speakerName": "维娜",
            "text": "哼哼，怎么样，科学的力量很了不…咦？啊！莱、莱赫妲尔阿姨？！你什么时候在这里的？！",
            "nextDialogs": [
              "760110511"
            ]
          },
          "760110511": {
            "id": "760110511",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "哇啊！也吓了我一跳…不对，那个，我们其实不是故意闯入初谕之庭的！因为维娜说…",
            "nextDialogs": [
              "760110512"
            ]
          },
          "760110512": {
            "id": "760110512",
            "speakerId": 7106,
            "speakerName": "莱赫妲尔",
            "text": "两位不必解释。初谕之庭只是被封锁的圣地，而非禁忌的秘所，既然两位作为外人能踏足其中，那便也是月光的意旨。",
            "nextDialogs": [
              "760110513"
            ]
          },
          "760110513": {
            "id": "760110513",
            "speakerId": 21835,
            "speakerName": "维娜",
            "text": "没、没错！这都是月之{RUBY#[D]库塔尔}少女神圣的指引！正如诗中所说——",
            "nextDialogs": [
              "760110514"
            ]
          },
          "760110514": {
            "id": "760110514",
            "speakerId": 7106,
            "speakerName": "莱赫妲尔",
            "text": "至于你，维娜琴卡，你先跟我来一趟，咏月使大人要亲自见你。",
            "nextDialogs": [
              "760110515"
            ]
          },
          "760110515": {
            "id": "760110515",
            "speakerId": 21835,
            "speakerName": "维娜",
            "text": "欸？！等等等等！可是莱赫妲尔阿姨，你刚才不是还说——",
            "nextDialogs": [
              "760110516"
            ]
          },
          "760110516": {
            "id": "760110516",
            "speakerId": 7106,
            "speakerName": "莱赫妲尔",
            "text": "身为执祭，擅自行动，破坏律则，触碰禁忌。除了没有滥杀以外，这里能犯的重罪已经全被你犯过一遍了。",
            "nextDialogs": [
              "760110517"
            ]
          },
          "760110517": {
            "id": "760110517",
            "speakerId": 7106,
            "speakerName": "莱赫妲尔",
            "text": "走吧。还是说，你想让咏月使大人亲自来请你？",
            "nextDialogs": [
              "760110518"
            ]
          },
          "760110518": {
            "id": "760110518",
            "speakerId": 21835,
            "speakerName": "维娜",
            "text": "#那个…{NICKNAME}，派蒙！之后…之后我再跟你们解释！我、我先——",
            "nextDialogs": [
              "760110519"
            ]
          },
          "760110519": {
            "id": "760110519",
            "speakerId": 1006,
            "speakerName": "Black Screen",
            "text": "维娜的话还没说完，就被莱赫妲尔强行拖走了…",
            "nextDialogs": [
              "760110520"
            ]
          },
          "760110520": {
            "id": "760110520",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "……",
            "nextDialogs": [
              "760110521"
            ]
          },
          "760110521": {
            "id": "760110521",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "……",
            "nextDialogs": [
              "760110522"
            ]
          },
          "760110522": {
            "id": "760110522",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "怎么说呢…总觉得也算是一种自作自受…",
            "nextDialogs": [
              "760110523"
            ]
          },
          "760110523": {
            "id": "760110523",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "虽然还是搞不清那位叫爱依菈的圣女究竟要让我们做什么，但她留给我们的这把剑…",
            "nextDialogs": [
              "760110524"
            ]
          },
          "760110524": {
            "id": "760110524",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "呃，应该是留给我们的吧？先保管起来好了，看上去也是霜月的圣物呢。"
          }
        }
      }
    },
    {
      "subId": "7601106",
      "subQuestName": "沿月灵旅路前进",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "760110601"
        ],
        "dialogs": {
          "760110601": {
            "id": "760110601",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "唔，总觉得这里和我印象里的「圣所」好像不太一样…怎么说呢，没有什么神圣的感觉？反而有一股奇怪的味道…",
            "nextDialogs": [
              "760110602"
            ]
          },
          "760110602": {
            "id": "760110602",
            "speakerId": 21835,
            "speakerName": "维娜",
            "text": "啊哈哈…毕竟是被封锁了五百年的地方，从科学的角度来说，金属生锈以后，会有这种类似血的腥味也很正常啦。",
            "nextDialogs": [
              "760110603"
            ]
          },
          "760110603": {
            "id": "760110603",
            "speakerId": 21835,
            "speakerName": "维娜",
            "text": "不过根据祷歌中的记载，爱依菈大人封闭圣所前，这里可是霜月的追随者们举行所有典仪的场所！超神圣的！真的！",
            "nextDialogs": [
              "760110604"
            ]
          },
          "760110604": {
            "id": "760110604",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "「超神圣的」这种随便的说法听起来就很不神圣啦！",
            "nextDialogs": [
              "760110605"
            ]
          },
          "760110605": {
            "id": "760110605",
            "speakerId": 21835,
            "speakerName": "维娜",
            "text": "哎呀，这种说辞上的小问题就不要在意了嘛！你们看那边的苍林之穗，就是传说中见证了月之{RUBY#[D]库塔尔}少女诞生的圣树喔！",
            "nextDialogs": [
              "760110606"
            ]
          },
          "760110606": {
            "id": "760110606",
            "speakerId": 21835,
            "speakerName": "维娜",
            "text": "然后就是那边的水池…呃，要是我没猜错的话，那个应该就是爱依菈大人祝福过的、永不枯竭的白{RUBY#[D]维拉莫之泉}泉了吧！",
            "nextDialogs": [
              "760110607"
            ]
          },
          "760110607": {
            "id": "760110607",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "这种事情还需要猜吗！另外这些名字真的不是你现编出来的吗？",
            "nextDialogs": [
              "760110608"
            ]
          },
          "760110608": {
            "id": "760110608",
            "speakerId": 21835,
            "speakerName": "维娜",
            "text": "不是啦！就算我是相当可靠的执祭，也没有亲眼见过祷歌里五百年前的那些圣物嘛！",
            "nextDialogs": [
              "760110609"
            ]
          },
          "760110609": {
            "id": "760110609",
            "speakerId": 21835,
            "speakerName": "维娜",
            "text": "#呜啊，没想到真的能在有生之年见到只存在于历史里的东西…我真是太幸运了，谢谢你们，{NICKNAME}和派蒙！",
            "nextDialogs": [
              "760110612"
            ]
          },
          "760110612": {
            "id": "760110612",
            "speakerId": 21835,
            "speakerName": "维娜",
            "text": "#嗯嗯，没问题没问题！{NICKNAME}说什么我都听！",
            "nextDialogs": [
              "760110613"
            ]
          },
          "760110613": {
            "id": "760110613",
            "speakerId": 21835,
            "speakerName": "维娜",
            "text": "不过，只是待在这里也有点可惜…来都来了，要不然在这附近随便走走看？"
          }
        }
      }
    },
    {
      "subId": "7601118",
      "subQuestName": "与维娜对话",
      "sceneId": null,
      "locations": [],

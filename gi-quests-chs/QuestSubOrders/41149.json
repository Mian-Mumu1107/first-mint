        "dialogs": {
          "411490401": {
            "id": "411490401",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "还有别的事。",
            "nextDialogs": [
              "411490402"
            ]
          },
          "411490402": {
            "id": "411490402",
            "speakerId": 10002,
            "speakerName": "莎拉",
            "text": "咦？好吧…那我去找别人帮忙。最近是怎么回事啊，怎么大家突然都开始要求外送餐品了…"
          }
        }
      }
    },
    {
      "subId": "4114901",
      "subQuestName": "与莎拉对话",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "411490101"
        ],
        "dialogs": {
          "411490101": {
            "id": "411490101",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "我这就送过去。",
            "nextDialogs": [
              "411490102"
            ]
          },
          "411490102": {
            "id": "411490102",
            "speakerId": 1419,
            "speakerName": "莎拉",
            "text": "那就太好了，谢谢你愿意帮忙。",
            "nextDialogs": [
              "411490103"
            ]
          },
          "411490103": {
            "id": "411490103",
            "speakerId": 1419,
            "speakerName": "莎拉",
            "text": "送的时候记得<color=#00E1FFFF>小心点别被撞到，也别跑得太快</color>。要是烤松饼散了的话，那瓦里特先生肯定不会收下的。"
          }
        }
      }
    },
    {
      "subId": "4114902",
      "subQuestName": "将餐品送给急躁的瓦里特",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "411490201"
        ],
        "dialogs": {
          "411490201": {
            "id": "411490201",
            "speakerId": 1576,
            "speakerName": "急躁的瓦里特",
            "text": "怎么还没送来，我还有正事要做呢！"
          }
        }
      }
    },
    {
      "subId": "4114903",
      "subQuestName": "与急躁的瓦里特对话",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "411490601"
        ],
        "dialogs": {
          "411490601": {
            "id": "411490601",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "这是您订的餐。",
            "nextDialogs": [
              "411490602"
            ]
          },
          "411490602": {
            "id": "411490602",
            "speakerId": 1576,
            "speakerName": "急躁的瓦里特",
            "text": "总算送来了，快给我，吃完了我还有正事要做。",
            "nextDialogs": [
              "411490603"
            ]
          },
          "411490603": {
            "id": "411490603",
            "speakerId": 1576,
            "speakerName": "急躁的瓦里特",
            "text": "这附近，说不定能找到合适的酿酒材料…"
          }
        }
      }
    },
    {
      "subId": "4114903",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "411490301"
        ],
        "dialogs": {
          "411490301": {
            "id": "411490301",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "听说有特别订单…",
            "nextDialogs": [
              "411490302"
            ]
          },
          "411490302": {
            "id": "411490302",
            "speakerId": 10002,
            "speakerName": "莎拉",
            "text": "对啊，你来得正好。早些时候，瓦里特先生在我们这订了一份庄园烤松饼，钱也已经预付好了。",
            "nextDialogs": [
              "411490303"
            ]
          },
          "411490303": {
            "id": "411490303",
            "speakerId": 10002,
            "speakerName": "莎拉",
            "text": "然后，他让我们晚些时候把餐送到明冠峡南面的一个地方…",
            "nextDialogs": [
              "411490304"
            ]
          },
          "411490304": {
            "id": "411490304",
            "speakerId": 10002,
            "speakerName": "莎拉",
            "text": "但不知道为什么，最近要求外送的餐品越来越多，我们的人手都不够了。",
            "nextDialogs": [
              "411490305"
            ]
          },
          "411490305": {
            "id": "411490305",
            "speakerId": 10002,
            "speakerName": "莎拉",
            "text": "如果你愿意的话，就请帮忙跑一趟吧。"
          }
        }
      }
    },

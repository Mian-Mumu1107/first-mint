  "subQuests": [
    {
      "subId": "2300601",
      "subQuestName": "与戈尔珊对话",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "230060101"
        ],
        "dialogs": {
          "230060101": {
            "id": "230060101",
            "speakerId": 4072,
            "speakerName": "戈尔珊",
            "text": "唉，现在怎么可能找得到人…",
            "nextDialogs": [
              "230060102"
            ]
          },
          "230060102": {
            "id": "230060102",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "怎么了？",
            "nextDialogs": [
              "230060103"
            ]
          },
          "230060103": {
            "id": "230060103",
            "speakerId": 4072,
            "speakerName": "戈尔珊",
            "text": "啊！您，您好，旅行者，请问您是需要治疗吗？",
            "nextDialogs": [
              "230060106"
            ]
          },
          "230060106": {
            "id": "230060106",
            "speakerId": 4072,
            "speakerName": "戈尔珊",
            "text": "哈哈…看起来有那么明显吗？不过，我确实也很发愁啦。",
            "nextDialogs": [
              "230060107"
            ]
          },
          "230060107": {
            "id": "230060107",
            "speakerId": 4072,
            "speakerName": "戈尔珊",
            "text": "不知道为什么，最近来我们「健康之家」请求治疗的人越来越多，我们的全部人手几乎都投入在照顾病患里了。",
            "nextDialogs": [
              "230060108"
            ]
          },
          "230060108": {
            "id": "230060108",
            "speakerId": 4072,
            "speakerName": "戈尔珊",
            "text": "但扎卡里亚医生还是坚持让我想办法去打扫周围…",
            "nextDialogs": [
              "230060109"
            ]
          },
          "230060109": {
            "id": "230060109",
            "speakerId": 4072,
            "speakerName": "戈尔珊",
            "text": "他说，为了让大家更容易接受草神大人的福佑，必须时刻保持病人身心和医院内外的洁净。",
            "nextDialogs": [
              "230060110"
            ]
          },
          "230060110": {
            "id": "230060110",
            "speakerId": 4072,
            "speakerName": "戈尔珊",
            "text": "唉，但现在压根找不到人，我总不能拜托那些症状轻微的病人起来帮忙吧…"
          }
        }
      }
    },
    {
      "subId": "2300602",
      "subQuestName": "清扫「健康之家」附近的污渍",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [],
        "dialogs": {}
      }
    },
    {
      "subId": "2300603",
      "subQuestName": "与戈尔珊对话",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "230060401"
        ],
        "dialogs": {
          "230060401": {
            "id": "230060401",
            "speakerId": 4072,
            "speakerName": "戈尔珊",
            "text": "请问您把周围都清理完了吗？",
            "nextDialogs": [
              "230060402"
            ]
          },
          "230060402": {
            "id": "230060402",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "都清理完了。",
            "nextDialogs": [
              "230060403"
            ]
          },
          "230060403": {
            "id": "230060403",
            "speakerId": 4072,
            "speakerName": "戈尔珊",
            "text": "真是太感谢您了，旅行者，这些酬劳请务必收下。",
            "nextDialogs": [
              "230060404"
            ]
          },
          "230060404": {
            "id": "230060404",
            "speakerId": 4072,
            "speakerName": "戈尔珊",
            "text": "话说回来，古尔根先生最近又在勉强自己干活了，我是不是要多花些时间劝劝他呢…",
            "nextDialogs": [
              "230060405"
            ]
          },
          "230060405": {
            "id": "230060405",
            "speakerId": 4072,
            "speakerName": "戈尔珊",
            "text": "近期还有不少要花精力的事，下次清理可能还要麻烦您了。"
          }
        }
      }
    },
    {
      "subId": "2300603",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "230060301"
        ],
        "dialogs": {
          "230060301": {
            "id": "230060301",
            "speakerId": 4072,
            "speakerName": "戈尔珊",
            "text": "旅行者，你有什么想问我的吗？",
            "nextDialogs": [
              "230060303",
              "230060307"
            ]
          },
          "230060303": {
            "id": "230060303",
            "speakerId": 4072,
            "speakerName": "戈尔珊",
            "text": "扎卡里亚医生是一位很厉害的医生，也是一位很虔诚的草神信徒呢。",
            "nextDialogs": [
              "230060304"
            ]
          },
          "230060304": {
            "id": "230060304",
            "speakerId": 4072,
            "speakerName": "戈尔珊",
            "text": "他经常不眠不休地治疗病人，就连吃饭都顾不上。",
            "nextDialogs": [
              "230060305"
            ]
          },
          "230060305": {
            "id": "230060305",
            "speakerId": 4072,
            "speakerName": "戈尔珊",
            "text": "扎卡里亚医生还说，让草神大人的福佑能恩泽到更多人，是他义不容辞的使命。"
          },
          "230060307": {
            "id": "230060307",
            "speakerId": 4072,
            "speakerName": "戈尔珊",
            "text": "准确地来说，「治疗病症」这件事，就是草神的恩泽喔。",
            "nextDialogs": [
              "230060308"
            ]
          },
          "230060308": {
            "id": "230060308",
            "speakerId": 4072,
            "speakerName": "戈尔珊",
            "text": "草神护佑着我们，让我们能找到治疗病患的方法，培育治疗病症的药草…",
            "nextDialogs": [
              "230060309"
            ]
          },
          "230060309": {
            "id": "230060309",
            "speakerId": 4072,
            "speakerName": "戈尔珊",
            "text": "感谢草神大人的恩泽，愿大家都能够远离病恙…"
          }
        }
      }
    },

  "subQuests": [
    {
      "subId": "502001",
      "subQuestName": "(test)子任务描述Test$HIDDEN",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "50202001"
        ],
        "dialogs": {
          "50202001": {
            "id": "50202001",
            "speakerId": 14733,
            "speakerName": "阿米娜",
            "text": "阿伽娅…对我来说也是一位可敬的长辈。",
            "nextDialogs": [
              "50202002"
            ]
          },
          "50202002": {
            "id": "50202002",
            "speakerId": 14733,
            "speakerName": "阿米娜",
            "text": "祖父过世后，我是许多长辈们推举着成为了「部族首领」。",
            "nextDialogs": [
              "50202003"
            ]
          },
          "50202003": {
            "id": "50202003",
            "speakerId": 14733,
            "speakerName": "阿米娜",
            "text": "因为我总是有许多新奇的想法，大家相信我能将「流泉之众」带向「不一样的未来」。",
            "nextDialogs": [
              "50202004"
            ]
          },
          "50202004": {
            "id": "50202004",
            "speakerId": 14733,
            "speakerName": "阿米娜",
            "text": "但是，在很长一段时间里，我也不知道自己该做什么。",
            "nextDialogs": [
              "50202005"
            ]
          },
          "50202005": {
            "id": "50202005",
            "speakerId": 14733,
            "speakerName": "阿米娜",
            "text": "阿伽娅阿姨经常勉励我，哪怕我犯了错，她也从不会跟我说「怎么做成这个样子」。她会很认真地陪我分析问题出在哪里，让我能做得更好。",
            "nextDialogs": [
              "50202006"
            ]
          },
          "50202006": {
            "id": "50202006",
            "speakerId": 14733,
            "speakerName": "阿米娜",
            "text": "我很尊敬她。所以…我会记住她教给我的一切，努力做好我该做的事情。"
          }
        }
      }
    }
  ]
}
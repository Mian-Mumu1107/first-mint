      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "750399901"
        ],
        "dialogs": {
          "750399901": {
            "id": "750399901",
            "speakerId": 10205,
            "speakerName": "？？？",
            "text": "咳咳…救…救命…",
            "nextDialogs": [
              "750399902"
            ]
          },
          "750399902": {
            "id": "750399902",
            "speakerId": 14662,
            "speakerName": "#{REALNAME[ID(2)|SHOWHOST(true)]}",
            "text": "唔…？呀！呀！",
            "nextDialogs": [
              "750399903"
            ]
          },
          "750399903": {
            "id": "750399903",
            "speakerId": 10205,
            "speakerName": "？？？",
            "text": "有…有人吗？",
            "nextDialogs": [
              "750399904"
            ]
          },
          "750399904": {
            "id": "750399904",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "欸，你有听到吗？好像有人在求救呢！",
            "nextDialogs": [
              "750399905"
            ]
          },
          "750399905": {
            "id": "750399905",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "咦，他在哪里呢？怎么只有一个小孩子躺在这里…",
            "nextDialogs": [
              "750399906"
            ]
          },
          "750399906": {
            "id": "750399906",
            "speakerId": 14662,
            "speakerName": "#{REALNAME[ID(2)|SHOWHOST(true)]}",
            "text": "嗯…唔？呀，呀！"
          }
        }
      }
    }
  ]
}
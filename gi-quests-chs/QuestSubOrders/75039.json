    {
      "subId": "7503903",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "750390301"
        ],
        "dialogs": {
          "750390301": {
            "id": "750390301",
            "speakerId": 1003,
            "speakerName": "Black Screen",
            "text": "设法帮助了干渴的路人，你们注意到，浸水之后他的体型仿佛大了一圈。",
            "nextDialogs": [
              "750390302"
            ]
          },
          "750390302": {
            "id": "750390302",
            "speakerId": 10205,
            "speakerName": "？？？",
            "text": "呼…哈…哈…咳咳…！谢谢，谢谢你们…差点就出人命了…呜呜…",
            "nextDialogs": [
              "750390303"
            ]
          },
          "750390303": {
            "id": "750390303",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "所以说这家伙……差点守在水源边上把自己渴死吗？",
            "nextDialogs": [
              "750390304"
            ]
          },
          "750390304": {
            "id": "750390304",
            "speakerId": 10205,
            "speakerName": "？？？",
            "text": "欸？原来水源就在这么近的地方吗！唉呀呀…不管怎样，谢谢你们救了我一命！",
            "nextDialogs": [
              "750390305"
            ]
          },
          "750390305": {
            "id": "750390305",
            "speakerId": 21586,
            "speakerName": "马尼菲科",
            "text": "马尼菲科·德·拉·马尼菲桑斯，叫我马尼菲科就好。正如你们所见，我出身枫丹贵胄。",
            "nextDialogs": [
              "750390306"
            ]
          },
          "750390306": {
            "id": "750390306",
            "speakerId": 21586,
            "speakerName": "马尼菲科",
            "text": "我的老朋友们有时叫我「警探」，有时叫我「布鲁图斯」，有时叫我「磁先生」…但你们的话，随便什么称呼都行。",
            "nextDialogs": [
              "750390307"
            ]
          },
          "750390307": {
            "id": "750390307",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "哇…好奇怪的家伙…",
            "nextDialogs": [
              "750390308"
            ]
          },
          "750390308": {
            "id": "750390308",
            "speakerId": 14662,
            "speakerName": "#{REALNAME[ID(2)|SHOWHOST(true)]}",
            "text": "哼…",
            "nextDialogs": [
              "750390310",
              "750390315",
              "750390326"
            ]
          },
          "750390310": {
            "id": "750390310",
            "speakerId": 21586,
            "speakerName": "马尼菲科",
            "text": "我曾经在逐影庭做过几年警探，跟随法兰克·德雷宾警督办过几件大案，后来他升任警司，而我退役了。",
            "nextDialogs": [
              "750390311"
            ]
          },
          "750390311": {
            "id": "750390311",
            "speakerId": 21586,
            "speakerName": "马尼菲科",
            "text": "那可真是让人难忘的时光…",
            "nextDialogs": [
              "750390312"
            ]
          },
          "750390312": {
            "id": "750390312",
            "speakerId": 21586,
            "speakerName": "马尼菲科",
            "text": "是啊…男孩遇见女孩，男孩失去女孩，女孩寻找男孩，男孩忘记女孩，男孩记起女孩，女孩被千灵节的映影花车碾压了三遍…",
            "nextDialogs": [
              "750390313"
            ]
          },
          "750390313": {
            "id": "750390313",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "那种乱七八糟的时光还是不要回顾啦…",
            "nextDialogs": [
              "750390332"
            ]
          },
          "750390332": {
            "id": "750390332",
            "speakerId": 21586,
            "speakerName": "马尼菲科",
            "text": "咳咳，总之，从逐影庭退役以后，我无所事事了一段时间，最终决定还是做个摄影家，描摹人与物所固有的生命力…",
            "nextDialogs": [
              "750390333"
            ]
          },
          "750390333": {
            "id": "750390333",
            "speakerId": 21586,
            "speakerName": "马尼菲科",
            "text": "所以我来到了这里，纳塔！诸元素生命力最为璀璨惊心的国度！",
            "nextDialogs": [
              "750390334"
            ]
          },
          "750390334": {
            "id": "750390334",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "是挺惊心啦…你差点就干死在这里了。",
            "nextDialogs": [
              "750390335"
            ]
          },
          "750390335": {
            "id": "750390335",
            "speakerId": 21586,
            "speakerName": "马尼菲科",
            "text": "嘿嘿，实在是不好意思。我是不会忘记你们救我一命的。",
            "nextDialogs": [
              "750390336"
            ]
          },
          "750390336": {
            "id": "750390336",
            "speakerId": 21586,
            "speakerName": "马尼菲科",
            "text": "唔…对了，借你们的地图看一下。嗯…我看看接下来我的目的地在哪里来着？",
            "nextDialogs": [
              "750390348"
            ]
          },
          "750390348": {
            "id": "750390348",
            "speakerId": 21586,
            "speakerName": "马尼菲科",
            "text": "对…这里、这里和…这里！不好意思…地图还给你。",
            "nextDialogs": [
              "750390337"
            ]
          },
          "750390337": {
            "id": "750390337",
            "speakerId": 21586,
            "speakerName": "马尼菲科",
            "text": "啊！对了…我的礼貌哪里去了！还不知道你们的名字？",
            "nextDialogs": [
              "750390338"
            ]
          },
          "750390338": {
            "id": "750390338",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "#我是{NICKNAME}。",
            "nextDialogs": [
              "750390339"
            ]
          },
          "750390339": {
            "id": "750390339",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "#叫我派蒙就好！还有它，它叫{REALNAME[ID(2)|SHOWHOST(true)]}！",
            "nextDialogs": [
              "750390340"
            ]
          },
          "750390340": {
            "id": "750390340",
            "speakerId": 14662,
            "speakerName": "#{REALNAME[ID(2)|SHOWHOST(true)]}",
            "text": "嗯唔！",
            "nextDialogs": [
              "750390341"
            ]
          },
          "750390341": {
            "id": "750390341",
            "speakerId": 21586,
            "speakerName": "马尼菲科",
            "text": "#很好，{NICKNAME}和派蒙，我记住了！",
            "nextDialogs": [
              "750390342"
            ]
          },
          "750390342": {
            "id": "750390342",
            "speakerId": 14662,
            "speakerName": "#{REALNAME[ID(2)|SHOWHOST(true)]}",
            "text": "嗯？唔？吓——！",
            "nextDialogs": [
              "750390343"
            ]
          },
          "750390343": {
            "id": "750390343",
            "speakerId": 21586,
            "speakerName": "马尼菲科",
            "text": "#哈哈，别急别急！还有{REALNAME[ID(2)|SHOWHOST(true)]}！",
            "nextDialogs": [
              "750390344"
            ]
          },
          "750390344": {
            "id": "750390344",
            "speakerId": 21586,
            "speakerName": "马尼菲科",
            "text": "希望不久后我们能在旅途中再次相见，说不定下次我又要拜托你们帮忙，又说不定我能帮上你们的忙呢！",
            "nextDialogs": [
              "750390345"
            ]
          },
          "750390345": {
            "id": "750390345",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "哇…你要去这么远的地方呀…那小心不要再把自己渴瘪了！",
            "nextDialogs": [
              "750390346"
            ]
          },
          "750390346": {
            "id": "750390346",
            "speakerId": 21586,
            "speakerName": "马尼菲科",
            "text": "哈哈，不会的！我们有机会再见咯！",
            "nextDialogs": [
              "750390347"
            ]
          },
          "750390347": {
            "id": "750390347",
            "speakerId": 1003,
            "speakerName": "Black Screen",
            "text": "马尼菲科飞快地打包好行李与饮水，向你们摆手告别。\\n不一会儿，他矮小的身影便从你们的视野中消失了。"
          },
          "750390315": {
            "id": "750390315",
            "speakerId": 21586,
            "speakerName": "马尼菲科",
            "text": "啊，你可能不知道，我曾在逐影庭做过几年警探，那时候是法兰克·德雷宾警督的部下。",
            "nextDialogs": [
              "750390316"
            ]
          },
          "750390316": {
            "id": "750390316",
            "speakerId": 21586,
            "speakerName": "马尼菲科",
            "text": "当时我们在公园里看到五个穿托加长袍的家伙在一百多人面前用刀袭击一个老头，于是「砰、砰、砰、砰、砰！」",
            "nextDialogs": [
              "750390317"
            ]
          },
          "750390317": {
            "id": "750390317",
            "speakerId": 21586,
            "speakerName": "马尼菲科",
            "text": "我们把他们全放倒了，地上没有一个喘气的。哈，你觉得自己很幸运吗，小贼！",
            "nextDialogs": [
              "750390318"
            ]
          },
          "750390318": {
            "id": "750390318",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "哇……",
            "nextDialogs": [
              "750390319"
            ]
          },
          "750390319": {
            "id": "750390319",
            "speakerId": 14662,
            "speakerName": "#{REALNAME[ID(2)|SHOWHOST(true)]}",
            "text": "哇……",
            "nextDialogs": [
              "750390320"
            ]
          },
          "750390320": {
            "id": "750390320",
            "speakerId": 21586,
            "speakerName": "马尼菲科",
            "text": "后来警长告诉我，那是一帮科学院的行政科员，正在排练《雷穆利亚》。",
            "nextDialogs": [
              "750390321"
            ]
          },
          "750390321": {
            "id": "750390321",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "欸？！",
            "nextDialogs": [
              "750390322"
            ]
          },
          "750390322": {
            "id": "750390322",
            "speakerId": 21586,
            "speakerName": "马尼菲科",
            "text": "所以，「布鲁图斯」！",
            "nextDialogs": [
              "750390323"
            ]
          },
          "750390323": {
            "id": "750390323",
            "speakerId": 14662,
            "speakerName": "#{REALNAME[ID(2)|SHOWHOST(true)]}",
            "text": "呜嗷？！",
            "nextDialogs": [
              "750390324"
            ]
          },
          "750390324": {
            "id": "750390324",
            "speakerId": 21586,
            "speakerName": "马尼菲科",
            "text": "不过反正没什么关系，当时科学院正在裁撤冗员，他们早晚得下岗。"
          },
          "750390326": {
            "id": "750390326",
            "speakerId": 21586,
            "speakerName": "马尼菲科",
            "text": "当然是说我超凡的人格魅力，每个认识我的人都会不可避免地被我所吸引！",
            "nextDialogs": [
              "750390327"
            ]
          },
          "750390327": {
            "id": "750390327",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "噫……！",
            "nextDialogs": [
              "750390328"
            ]
          },
          "750390328": {
            "id": "750390328",
            "speakerId": 21586,
            "speakerName": "马尼菲科",
            "text": "以及…所有不起眼的金属小物件、零散摩拉、细小首饰什么的，都会莫名其妙被吸引到我的裤兜里！",
            "nextDialogs": [
              "750390329"
            ]
          },
          "750390329": {
            "id": "750390329",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "那应该叫「盗窃癖」！",
            "nextDialogs": [
              "750390330"
            ]
          },
          "750390330": {
            "id": "750390330",
            "speakerId": 21586,
            "speakerName": "马尼菲科",
            "text": "没错，那正是我们家族的美德之一！",
            "nextDialogs": [
              "750390331"
            ]
          },
          "750390331": {
            "id": "750390331",
            "speakerId": 14662,
            "speakerName": "#{REALNAME[ID(2)|SHOWHOST(true)]}",
            "text": "咿——！"
          }
        }
      }
    },
    {
      "subId": "7503999",

    {
      "subId": "7503901",
      "subQuestName": "(test)隐藏踩圈$HIDDEN",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "750390101"
        ],
        "dialogs": {
          "750390101": {
            "id": "750390101",
            "speakerId": 10205,
            "speakerName": "？？？",
            "text": "你好，黑暗，我的老朋友…",
            "nextDialogs": [
              "750390102"
            ]
          },
          "750390102": {
            "id": "750390102",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "呜哇…是一个…说话像大人的小孩子，好奇怪！",
            "nextDialogs": [
              "750390103"
            ]
          },
          "750390103": {
            "id": "750390103",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "欸？等等，这不是「了不起的马尼菲科」吗！",
            "nextDialogs": [
              "750390105",
              "750390108",
              "750390111"
            ]
          },
          "750390105": {
            "id": "750390105",
            "speakerId": 21586,
            "speakerName": "马尼菲科",
            "text": "马…马尼菲科，了不起的马尼菲科！",
            "nextDialogs": [
              "750390106"
            ]
          },
          "750390106": {
            "id": "750390106",
            "speakerId": 21586,
            "speakerName": "马尼菲科",
            "text": "呃…我知道我现在的样子有那么一点点落魄，但请给我点水，救救我。",
            "nextDialogs": [
              "750390119"
            ]
          },
          "750390119": {
            "id": "750390119",
            "speakerId": 21586,
            "speakerName": "马尼菲科",
            "text": "水…请给我水…谢谢…",
            "nextDialogs": [
              "750390120"
            ]
          },
          "750390120": {
            "id": "750390120",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "哇…这家伙又变回半死不活的样子了…我们救救他吧？"
          },
          "750390108": {
            "id": "750390108",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "变得像小鱼干一样了，真可怜。",
            "nextDialogs": [
              "750390109"
            ]
          },
          "750390109": {
            "id": "750390109",
            "speakerId": 21586,
            "speakerName": "马尼菲科",
            "text": "喂！有点身为人类的同理心好吗！"
          },
          "750390111": {
            "id": "750390111",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "什么…？",
            "nextDialogs": [
              "750390112"
            ]
          },
          "750390112": {
            "id": "750390112",
            "speakerId": 21586,
            "speakerName": "马尼菲科",
            "text": "哈！对，就是那首歌！我也喜欢那个！",
            "nextDialogs": [
              "750390113"
            ]
          },
          "750390113": {
            "id": "750390113",
            "speakerId": 21586,
            "speakerName": "马尼菲科",
            "text": "啊…西梅翁和卡本克尔兄弟，怎么也听不倦…说起来，我上一个工作还是因为他们丢的。所以我才会到这里来，冒这该死的险…",
            "nextDialogs": [
              "750390114"
            ]
          },
          "750390114": {
            "id": "750390114",
            "speakerId": 21586,
            "speakerName": "马尼菲科",
            "text": "呃…不过那就是后话啦，嘿嘿。现在要紧的是，给我整点水喝，好吗？",
            "nextDialogs": [
              "750390115"
            ]
          },
          "750390115": {
            "id": "750390115",
            "speakerId": 21586,
            "speakerName": "马尼菲科",
            "text": "毕竟，嗯，嘿嘿…就是，呵呵，真不好意思，我要渴死了，嘿嘿…",
            "nextDialogs": [
              "750390116"
            ]
          },
          "750390116": {
            "id": "750390116",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "性命关天的事，你傻笑个什么劲啦！",
            "nextDialogs": [
              "750390117"
            ]
          },
          "750390117": {
            "id": "750390117",
            "speakerId": 21586,
            "speakerName": "马尼菲科",
            "text": "不知道，回光返照吧。",
            "nextDialogs": [
              "750390118"
            ]
          },
          "750390118": {
            "id": "750390118",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "哦…啊？！"
          }
        }
      }
    },
    {
      "subId": "7503902",
      "subQuestName": "(test)与晕倒的画家对话$HIDDEN",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "750390201"
        ],
        "dialogs": {
          "750390201": {
            "id": "750390201",
            "speakerId": 10205,
            "speakerName": "？？？",
            "text": "你好，黑暗，我的老朋友…",
            "nextDialogs": [
              "750390202"
            ]
          },
          "750390202": {
            "id": "750390202",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "呜哇…是一个…说话像大人的小孩子，好奇怪！",
            "nextDialogs": [
              "750390203"
            ]
          },
          "750390203": {
            "id": "750390203",
            "speakerId": 10205,
            "speakerName": "？？？",
            "text": "喂，你的父母没有教过你尊重我这样的人吗？要知道，小小的人也能做出大大的事来！",
            "nextDialogs": [
              "750390204"
            ]
          },
          "750390204": {
            "id": "750390204",
            "speakerId": 10205,
            "speakerName": "？？？",
            "text": "事实上，许多大大的事，正是由像我这样小小的人所成就的…",
            "nextDialogs": [
              "750390205"
            ]
          },
          "750390205": {
            "id": "750390205",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "他还有胡子！噫…看起来有点恶心…",
            "nextDialogs": [
              "750390206"
            ]
          },
          "750390206": {
            "id": "750390206",
            "speakerId": 10205,
            "speakerName": "？？？",
            "text": "至少不要拿胡子羞辱我！",
            "nextDialogs": [
              "750390208",
              "750390221"
            ]
          },
          "750390208": {
            "id": "750390208",
            "speakerId": 10205,
            "speakerName": "？？？",
            "text": "呃…不，你不用这样配合我，我的意思是我…我快死了。"
          },
          "750390221": {
            "id": "750390221",
            "speakerId": 10205,
            "speakerName": "？？？",
            "text": "水…请给我水…谢谢…"
          }
        }
      }
    },

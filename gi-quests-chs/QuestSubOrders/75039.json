      }
    },
    {
      "subId": "7503917",
      "subQuestName": "(test)尝试把画家弄醒-水元素攻击$HIDDEN",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "750391701"
        ],
        "dialogs": {
          "750391701": {
            "id": "750391701",
            "speakerId": 1003,
            "speakerName": "Black Screen",
            "text": "设法帮助了干渴的路人，你们注意到，浸水之后他的体型仿佛大了一圈。",
            "nextDialogs": [
              "750391702"
            ]
          },
          "750391702": {
            "id": "750391702",
            "speakerId": 21586,
            "speakerName": "马尼菲科",
            "text": "呼…咳咳！咳咳！谢谢你们…但是，咳咳…救人的方式可以少点攻击性啦…我可不会游泳…",
            "nextDialogs": [
              "750391703"
            ]
          },
          "750391703": {
            "id": "750391703",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "没关系，到时候我们再想办法把你捞回来！",
            "nextDialogs": [
              "750391704"
            ]
          },
          "750391704": {
            "id": "750391704",
            "speakerId": 21586,
            "speakerName": "马尼菲科",
            "text": "我宁愿你们不要到时候再想办法…不过不管怎么样，谢谢你们救了我一命！",
            "nextDialogs": [
              "750391705"
            ]
          },
          "750391705": {
            "id": "750391705",
            "speakerId": 21586,
            "speakerName": "马尼菲科",
            "text": "马尼菲科·德·拉·马尼菲桑斯，叫我马尼菲科就好。正如你们所见，我出身枫丹贵胄。",
            "nextDialogs": [
              "750391706"
            ]
          },
          "750391706": {
            "id": "750391706",
            "speakerId": 21586,
            "speakerName": "马尼菲科",
            "text": "我的老朋友们有时叫我「警探」，有时叫我「布鲁图斯」，有时叫我「磁先生」…但你们的话，随便什么称呼都行。",
            "nextDialogs": [
              "750391707"
            ]
          },
          "750391707": {
            "id": "750391707",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "哇…好奇怪的家伙…",
            "nextDialogs": [
              "750391708"
            ]
          },
          "750391708": {
            "id": "750391708",
            "speakerId": 14662,
            "speakerName": "#{REALNAME[ID(2)|SHOWHOST(true)]}",
            "text": "哼…",
            "nextDialogs": [
              "750391710",
              "750391715",
              "750391726"
            ]
          },
          "750391710": {
            "id": "750391710",
            "speakerId": 21586,
            "speakerName": "马尼菲科",
            "text": "我曾经在逐影庭做过几年警探，跟随法兰克·德雷宾警督办过几件大案，后来他升任警司，而我退役了。",
            "nextDialogs": [
              "750391711"
            ]
          },
          "750391711": {
            "id": "750391711",
            "speakerId": 21586,
            "speakerName": "马尼菲科",
            "text": "那可真是让人难忘的时光…",
            "nextDialogs": [
              "750391712"
            ]
          },
          "750391712": {
            "id": "750391712",
            "speakerId": 21586,
            "speakerName": "马尼菲科",
            "text": "是啊…男孩遇见女孩，男孩失去女孩，女孩寻找男孩，男孩忘记女孩，男孩记起女孩，女孩被千灵节的映影花车碾压了三遍…",
            "nextDialogs": [
              "750391713"
            ]
          },
          "750391713": {
            "id": "750391713",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "那种乱七八糟的时光还是不要回顾啦…",
            "nextDialogs": [
              "750391732"
            ]
          },
          "750391732": {
            "id": "750391732",
            "speakerId": 21586,
            "speakerName": "马尼菲科",
            "text": "咳咳，总之，从逐影庭退役以后，我无所事事了一段时间，最终决定还是做个摄影家，描摹人与物所固有的生命力…",
            "nextDialogs": [
              "750391733"
            ]
          },
          "750391733": {
            "id": "750391733",
            "speakerId": 21586,
            "speakerName": "马尼菲科",
            "text": "所以我来到了这里，纳塔！诸元素生命力最为璀璨惊心的国度！",
            "nextDialogs": [
              "750391734"
            ]
          },
          "750391734": {
            "id": "750391734",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "是挺惊心啦…你差点就干死在这里了。",
            "nextDialogs": [
              "750391735"
            ]
          },
          "750391735": {
            "id": "750391735",
            "speakerId": 21586,
            "speakerName": "马尼菲科",
            "text": "嘿嘿，实在是不好意思。我是不会忘记你们救我一命的。",
            "nextDialogs": [
              "750391736"
            ]
          },
          "750391736": {
            "id": "750391736",
            "speakerId": 21586,
            "speakerName": "马尼菲科",
            "text": "这样，我接下来要去的地方…让我在你的地图上标记出来…嗯，在这里。",
            "nextDialogs": [
              "750391737"
            ]
          },
          "750391737": {
            "id": "750391737",
            "speakerId": 21586,
            "speakerName": "马尼菲科",
            "text": "啊！对了…我的礼貌哪里去了！还不知道你们的名字？",
            "nextDialogs": [
              "750391738"
            ]
          },
          "750391738": {
            "id": "750391738",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "#我是{NICKNAME}。",
            "nextDialogs": [
              "750391739"
            ]
          },
          "750391739": {
            "id": "750391739",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "#叫我派蒙就好！还有它，它叫{REALNAME[ID(2)|SHOWHOST(true)]}！",
            "nextDialogs": [
              "750391740"
            ]
          },
          "750391740": {
            "id": "750391740",
            "speakerId": 14662,
            "speakerName": "#{REALNAME[ID(2)|SHOWHOST(true)]}",
            "text": "嗯唔！",
            "nextDialogs": [
              "750391741"
            ]
          },
          "750391741": {
            "id": "750391741",
            "speakerId": 21586,
            "speakerName": "马尼菲科",
            "text": "#很好，{NICKNAME}和派蒙，我记住了！",
            "nextDialogs": [
              "750391742"
            ]
          },
          "750391742": {
            "id": "750391742",
            "speakerId": 14662,
            "speakerName": "#{REALNAME[ID(2)|SHOWHOST(true)]}",
            "text": "嗯？唔？吓——！",
            "nextDialogs": [
              "750391743"
            ]
          },
          "750391743": {
            "id": "750391743",
            "speakerId": 21586,
            "speakerName": "马尼菲科",
            "text": "#哈哈，别急别急！还有{REALNAME[ID(2)|SHOWHOST(true)]}！",
            "nextDialogs": [
              "750391744"
            ]
          },
          "750391744": {
            "id": "750391744",
            "speakerId": 21586,
            "speakerName": "马尼菲科",
            "text": "希望不久后我们能在旅途中再次相见，说不定下次我又要拜托你们帮忙，又说不定我能帮上你们的忙呢！",
            "nextDialogs": [
              "750391745"
            ]
          },
          "750391745": {
            "id": "750391745",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "哇…你要去这么远的地方呀…那小心不要再把自己渴瘪了！",
            "nextDialogs": [
              "750391746"
            ]
          },
          "750391746": {
            "id": "750391746",
            "speakerId": 21586,
            "speakerName": "马尼菲科",
            "text": "哈哈，不会的！我们有机会再见咯！",
            "nextDialogs": [
              "750391747"
            ]
          },
          "750391747": {
            "id": "750391747",
            "speakerId": 1003,
            "speakerName": "Black Screen",
            "text": "马尼菲科飞快地打包好行李与饮水，向你们摆手告别。\\n不一会儿，他矮小的身影便从你们的视野中消失了。"
          },
          "750391715": {
            "id": "750391715",
            "speakerId": 21586,
            "speakerName": "马尼菲科",
            "text": "啊，你可能不知道，我曾在逐影庭做过几年警探，那时候是法兰克·德雷宾警督的部下。",
            "nextDialogs": [
              "750391716"
            ]
          },
          "750391716": {
            "id": "750391716",
            "speakerId": 21586,
            "speakerName": "马尼菲科",
            "text": "当时我们在公园里看到五个穿托加长袍的家伙在一百多人面前用刀袭击一个老头，于是「砰、砰、砰、砰、砰！」",
            "nextDialogs": [
              "750391717"
            ]
          },
          "750391717": {
            "id": "750391717",
            "speakerId": 21586,
            "speakerName": "马尼菲科",
            "text": "我们把他们全放倒了，地上没有一个喘气的。哈，你觉得自己很幸运吗，小贼！",
            "nextDialogs": [
              "750391718"
            ]
          },
          "750391718": {
            "id": "750391718",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "哇……",
            "nextDialogs": [
              "750391719"
            ]
          },
          "750391719": {
            "id": "750391719",
            "speakerId": 14662,
            "speakerName": "#{REALNAME[ID(2)|SHOWHOST(true)]}",
            "text": "哇……",
            "nextDialogs": [
              "750391720"
            ]
          },
          "750391720": {
            "id": "750391720",
            "speakerId": 21586,
            "speakerName": "马尼菲科",
            "text": "后来警长告诉我，那是一帮科学院的行政科员，正在排练《雷穆利亚》。",
            "nextDialogs": [
              "750391721"
            ]
          },
          "750391721": {
            "id": "750391721",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "欸？！",
            "nextDialogs": [
              "750391722"
            ]
          },
          "750391722": {
            "id": "750391722",
            "speakerId": 21586,
            "speakerName": "马尼菲科",
            "text": "所以，「布鲁图斯」！",
            "nextDialogs": [
              "750391723"
            ]
          },
          "750391723": {
            "id": "750391723",
            "speakerId": 14662,
            "speakerName": "#{REALNAME[ID(2)|SHOWHOST(true)]}",
            "text": "呜嗷？！",
            "nextDialogs": [
              "750391724"
            ]
          },
          "750391724": {
            "id": "750391724",
            "speakerId": 21586,
            "speakerName": "马尼菲科",
            "text": "不过反正没什么关系，当时科学院正在裁撤冗员，他们早晚得下岗。"
          },
          "750391726": {
            "id": "750391726",
            "speakerId": 21586,
            "speakerName": "马尼菲科",
            "text": "当然是说我超凡的人格魅力，每个认识我的人都会不可避免地被我所吸引！",
            "nextDialogs": [
              "750391727"
            ]
          },
          "750391727": {
            "id": "750391727",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "噫……！",
            "nextDialogs": [
              "750391728"
            ]
          },
          "750391728": {
            "id": "750391728",
            "speakerId": 21586,
            "speakerName": "马尼菲科",
            "text": "以及…所有不起眼的金属小物件、零散摩拉、细小首饰什么的，都会莫名其妙被吸引到我的裤兜里！",
            "nextDialogs": [
              "750391729"
            ]
          },
          "750391729": {
            "id": "750391729",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "那应该叫「盗窃癖」！",
            "nextDialogs": [
              "750391730"
            ]
          },
          "750391730": {
            "id": "750391730",
            "speakerId": 21586,
            "speakerName": "马尼菲科",
            "text": "没错，那正是我们家族的美德之一！",
            "nextDialogs": [
              "750391731"
            ]
          },
          "750391731": {
            "id": "750391731",
            "speakerId": 14662,
            "speakerName": "#{REALNAME[ID(2)|SHOWHOST(true)]}",
            "text": "咿——！"
          }
        }
      }
    },
    {
      "subId": "7503918",
      "subQuestName": "(test)尝试把画家弄醒-灵视龙创生$HIDDEN",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "750391801"
        ],
        "dialogs": {
          "750391801": {
            "id": "750391801",
            "speakerId": 1003,
            "speakerName": "Black Screen",
            "text": "设法帮助了干渴的路人，你们注意到，浸水之后他的体型仿佛大了一圈。",
            "nextDialogs": [
              "750391802"
            ]
          },
          "750391802": {
            "id": "750391802",
            "speakerId": 10205,
            "speakerName": "？？？",
            "text": "咳咳…呼…呼…哈哈，原来是暝视龙的小招数…这也是我来这里的原因之一。",
            "nextDialogs": [
              "750391803"
            ]
          },
          "750391803": {
            "id": "750391803",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "你先顺顺气，多喝点水再说话啦！",
            "nextDialogs": [
              "750391804"
            ]
          },
          "750391804": {
            "id": "750391804",
            "speakerId": 10205,
            "speakerName": "？？？",
            "text": "咳咳…！我没事的，谢谢你们救了我一命！",
            "nextDialogs": [
              "750391805"
            ]
          },
          "750391805": {
            "id": "750391805",
            "speakerId": 21586,
            "speakerName": "马尼菲科",
            "text": "马尼菲科·德·拉·马尼菲桑斯，叫我马尼菲科就好。正如你们所见，我出身枫丹贵胄。",
            "nextDialogs": [
              "750391806"
            ]
          },
          "750391806": {
            "id": "750391806",
            "speakerId": 21586,
            "speakerName": "马尼菲科",
            "text": "我的老朋友们有时叫我「警探」，有时叫我「布鲁图斯」，有时叫我「磁先生」…但你们的话，随便什么称呼都行。",
            "nextDialogs": [
              "750391807"
            ]
          },
          "750391807": {
            "id": "750391807",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "唔…这么多乱七八糟的名字，听起来好可疑！",
            "nextDialogs": [
              "750391808"
            ]
          },
          "750391808": {
            "id": "750391808",
            "speakerId": 14662,
            "speakerName": "#{REALNAME[ID(2)|SHOWHOST(true)]}",
            "text": "哼…",
            "nextDialogs": [
              "750391810",
              "750391815",
              "750391826"
            ]
          },
          "750391810": {
            "id": "750391810",
            "speakerId": 21586,
            "speakerName": "马尼菲科",
            "text": "我曾经在逐影庭做过几年警探，跟随法兰克·德雷宾警督办过几件大案，后来他升任警司，而我退役了。",
            "nextDialogs": [
              "750391811"
            ]
          },
          "750391811": {
            "id": "750391811",
            "speakerId": 21586,
            "speakerName": "马尼菲科",
            "text": "那可真是让人难忘的时光…",
            "nextDialogs": [
              "750391812"
            ]
          },
          "750391812": {
            "id": "750391812",
            "speakerId": 21586,
            "speakerName": "马尼菲科",
            "text": "是啊…男孩遇见女孩，男孩失去女孩，女孩寻找男孩，男孩忘记女孩，男孩记起女孩，女孩被千灵节的映影花车碾压了三遍…",
            "nextDialogs": [
              "750391813"
            ]
          },
          "750391813": {
            "id": "750391813",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "那种乱七八糟的时光还是不要回顾啦…",
            "nextDialogs": [
              "750391832"
            ]
          },
          "750391832": {
            "id": "750391832",
            "speakerId": 21586,
            "speakerName": "马尼菲科",
            "text": "咳咳，总之，从逐影庭退役以后，我无所事事了一段时间，最终决定还是做个摄影家，描摹人与物所固有的生命力…",
            "nextDialogs": [
              "750391833"
            ]
          },
          "750391833": {
            "id": "750391833",
            "speakerId": 21586,
            "speakerName": "马尼菲科",
            "text": "所以我来到了这里，纳塔！诸元素生命力最为璀璨惊心的国度！",
            "nextDialogs": [
              "750391834"
            ]
          },
          "750391834": {
            "id": "750391834",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "是挺惊心啦…你差点就干死在这里了。",
            "nextDialogs": [
              "750391835"
            ]
          },
          "750391835": {
            "id": "750391835",
            "speakerId": 21586,
            "speakerName": "马尼菲科",
            "text": "嘿嘿，实在是不好意思。我是不会忘记你们救我一命的。",
            "nextDialogs": [
              "750391836"
            ]
          },
          "750391836": {
            "id": "750391836",
            "speakerId": 21586,
            "speakerName": "马尼菲科",
            "text": "唔…对了，借你们的地图看一下。嗯…我看看接下来我的目的地在哪里来着？",
            "nextDialogs": [
              "750391837"
            ]
          },
          "750391837": {
            "id": "750391837",
            "speakerId": 21586,
            "speakerName": "马尼菲科",
            "text": "啊！对了…我的礼貌哪里去了！还不知道你们的名字？",
            "nextDialogs": [
              "750391838"
            ]
          },
          "750391838": {
            "id": "750391838",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "#我是{NICKNAME}。",
            "nextDialogs": [
              "750391839"
            ]
          },
          "750391839": {
            "id": "750391839",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "#叫我派蒙就好！还有它，它叫{REALNAME[ID(2)|SHOWHOST(true)]}！",
            "nextDialogs": [
              "750391840"
            ]
          },
          "750391840": {
            "id": "750391840",
            "speakerId": 14662,
            "speakerName": "#{REALNAME[ID(2)|SHOWHOST(true)]}",
            "text": "嗯唔！",
            "nextDialogs": [
              "750391841"
            ]
          },
          "750391841": {
            "id": "750391841",
            "speakerId": 21586,
            "speakerName": "马尼菲科",
            "text": "#很好，{NICKNAME}和派蒙，我记住了！",
            "nextDialogs": [
              "750391842"
            ]
          },
          "750391842": {
            "id": "750391842",
            "speakerId": 14662,
            "speakerName": "#{REALNAME[ID(2)|SHOWHOST(true)]}",
            "text": "嗯？唔？吓——！",
            "nextDialogs": [
              "750391843"
            ]
          },
          "750391843": {
            "id": "750391843",
            "speakerId": 21586,
            "speakerName": "马尼菲科",
            "text": "#哈哈，别急别急！还有{REALNAME[ID(2)|SHOWHOST(true)]}！",
            "nextDialogs": [
              "750391844"
            ]
          },
          "750391844": {
            "id": "750391844",
            "speakerId": 21586,
            "speakerName": "马尼菲科",
            "text": "希望不久后我们能在旅途中再次相见，说不定下次我又要拜托你们帮忙，又说不定我能帮上你们的忙呢！",
            "nextDialogs": [
              "750391845"
            ]
          },
          "750391845": {
            "id": "750391845",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "哇…你要去这么远的地方呀…那小心不要再把自己渴瘪了！",
            "nextDialogs": [
              "750391846"
            ]
          },
          "750391846": {
            "id": "750391846",
            "speakerId": 21586,
            "speakerName": "马尼菲科",
            "text": "哈哈，不会的！我们有机会再见咯！",
            "nextDialogs": [
              "750391847"
            ]
          },
          "750391847": {
            "id": "750391847",
            "speakerId": 1003,
            "speakerName": "Black Screen",
            "text": "马尼菲科飞快地打包好行李与饮水，向你们摆手告别。\\n不一会儿，他矮小的身影便从你们的视野中消失了。"
          },
          "750391815": {
            "id": "750391815",
            "speakerId": 21586,
            "speakerName": "马尼菲科",
            "text": "啊，你可能不知道，我曾在逐影庭做过几年警探，那时候是法兰克·德雷宾警督的部下。",
            "nextDialogs": [
              "750391816"
            ]
          },
          "750391816": {
            "id": "750391816",
            "speakerId": 21586,
            "speakerName": "马尼菲科",
            "text": "当时我们在公园里看到五个穿托加长袍的家伙在一百多人面前用刀袭击一个老头，于是「砰、砰、砰、砰、砰！」",
            "nextDialogs": [
              "750391817"
            ]
          },
          "750391817": {
            "id": "750391817",
            "speakerId": 21586,
            "speakerName": "马尼菲科",
            "text": "我们把他们全放倒了，地上没有一个喘气的。哈，你觉得自己很幸运吗，小贼！",
            "nextDialogs": [
              "750391818"
            ]
          },
          "750391818": {
            "id": "750391818",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "哇……",
            "nextDialogs": [
              "750391819"
            ]
          },
          "750391819": {
            "id": "750391819",
            "speakerId": 14662,
            "speakerName": "#{REALNAME[ID(2)|SHOWHOST(true)]}",
            "text": "哇……",
            "nextDialogs": [
              "750391820"
            ]
          },
          "750391820": {
            "id": "750391820",
            "speakerId": 21586,
            "speakerName": "马尼菲科",
            "text": "后来警长告诉我，那是一帮科学院的行政科员，正在排练《雷穆利亚》。",
            "nextDialogs": [
              "750391821"
            ]
          },
          "750391821": {
            "id": "750391821",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "欸？！",
            "nextDialogs": [
              "750391822"
            ]
          },
          "750391822": {
            "id": "750391822",
            "speakerId": 21586,
            "speakerName": "马尼菲科",
            "text": "所以，「布鲁图斯」！",
            "nextDialogs": [
              "750391823"
            ]
          },
          "750391823": {
            "id": "750391823",
            "speakerId": 14662,
            "speakerName": "#{REALNAME[ID(2)|SHOWHOST(true)]}",
            "text": "呜嗷？！",
            "nextDialogs": [
              "750391824"
            ]
          },
          "750391824": {
            "id": "750391824",
            "speakerId": 21586,
            "speakerName": "马尼菲科",
            "text": "不过反正没什么关系，当时科学院正在裁撤冗员，他们早晚得下岗。"
          },
          "750391826": {
            "id": "750391826",
            "speakerId": 21586,
            "speakerName": "马尼菲科",
            "text": "当然是说我超凡的人格魅力，每个认识我的人都会不可避免地被我所吸引！",
            "nextDialogs": [
              "750391827"
            ]
          },
          "750391827": {
            "id": "750391827",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "噫……！",
            "nextDialogs": [
              "750391828"
            ]
          },
          "750391828": {
            "id": "750391828",
            "speakerId": 21586,
            "speakerName": "马尼菲科",
            "text": "以及…所有不起眼的金属小物件、零散摩拉、细小首饰什么的，都会莫名其妙被吸引到我的裤兜里！",
            "nextDialogs": [
              "750391829"
            ]
          },
          "750391829": {
            "id": "750391829",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "那应该叫「盗窃癖」！",
            "nextDialogs": [
              "750391830"
            ]
          },
          "750391830": {
            "id": "750391830",
            "speakerId": 21586,
            "speakerName": "马尼菲科",
            "text": "没错，那正是我们家族的美德之一！",
            "nextDialogs": [
              "750391831"
            ]
          },
          "750391831": {
            "id": "750391831",
            "speakerId": 14662,
            "speakerName": "#{REALNAME[ID(2)|SHOWHOST(true)]}",
            "text": "咿——！"
          }
        }
      }
    },

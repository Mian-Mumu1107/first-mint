  "subQuests": [
    {
      "subId": "2304306",
      "subQuestName": "",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "230430601"
        ],
        "dialogs": {
          "230430601": {
            "id": "230430601",
            "speakerId": 1000,
            "speakerName": "拉玛",
            "text": "怎么样，要在我这里订货吗？",
            "nextDialogs": [
              "230430603",
              "230430605"
            ]
          },
          "230430603": {
            "id": "230430603",
            "speakerId": 1000,
            "speakerName": "拉玛",
            "text": "谢谢惠顾，等我准备好之后，就雇人把货物运过去。"
          },
          "230430605": {
            "id": "230430605",
            "speakerId": 1000,
            "speakerName": "拉玛",
            "text": "好吧…你可得看快点啊，可别等到我香料都卖光了还没做好决定。"
          }
        }
      }
    },
    {
      "subId": "2304301",
      "subQuestName": "与阿扎莱对话",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "230430101"
        ],
        "dialogs": {
          "230430101": {
            "id": "230430101",
            "speakerId": 1001,
            "speakerName": "阿扎莱",
            "text": "还是得拜托里夫帮忙找个人啊…",
            "nextDialogs": [
              "230430102"
            ]
          },
          "230430102": {
            "id": "230430102",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "你怎么愁眉苦脸的…",
            "nextDialogs": [
              "230430103"
            ]
          },
          "230430103": {
            "id": "230430103",
            "speakerId": 1001,
            "speakerName": "阿扎莱",
            "text": "旅行者，你是想买什么吗？抱歉，现在店里可能有些缺货…",
            "nextDialogs": [
              "230430104"
            ]
          },
          "230430104": {
            "id": "230430104",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "你就是为这个发愁吗？",
            "nextDialogs": [
              "230430105"
            ]
          },
          "230430105": {
            "id": "230430105",
            "speakerId": 1001,
            "speakerName": "阿扎莱",
            "text": "是啊…我们这村子在沙漠里，运送货物本来就很不方便。",
            "nextDialogs": [
              "230430106"
            ]
          },
          "230430106": {
            "id": "230430106",
            "speakerId": 1001,
            "speakerName": "阿扎莱",
            "text": "我如果想进货，还得先拜托外出的人帮我去订货，然后再和里夫他们一起把货接进村里。",
            "nextDialogs": [
              "230430107"
            ]
          },
          "230430107": {
            "id": "230430107",
            "speakerId": 1001,
            "speakerName": "阿扎莱",
            "text": "这么一来二去的，我做生意的成本蹭蹭地往上涨，为了维持生计，我也只能把这些货物稍微卖贵一些。",
            "nextDialogs": [
              "230430108"
            ]
          },
          "230430108": {
            "id": "230430108",
            "speakerId": 1001,
            "speakerName": "阿扎莱",
            "text": "还好村里的人都理解我，也愿意光顾我的生意，不然…我这小店铺，估计早就倒闭了。",
            "nextDialogs": [
              "230430109"
            ]
          },
          "230430109": {
            "id": "230430109",
            "speakerId": 1001,
            "speakerName": "阿扎莱",
            "text": "但是…唉，我也不是随时都能找到准备出村的人，里夫他们也不是随时都有空…",
            "nextDialogs": [
              "230430110"
            ]
          },
          "230430110": {
            "id": "230430110",
            "speakerId": 1001,
            "speakerName": "阿扎莱",
            "text": "如果运气不好，某些存量少的货物就会断货…",
            "nextDialogs": [
              "230430112",
              "230430115"
            ]
          },
          "230430112": {
            "id": "230430112",
            "speakerId": 1001,
            "speakerName": "阿扎莱",
            "text": "都是一些和日常用度有关的货物，这些东西我进得虽然不慢，但卖得更快啊。",
            "nextDialogs": [
              "230430113"
            ]
          },
          "230430113": {
            "id": "230430113",
            "speakerId": 1001,
            "speakerName": "阿扎莱",
            "text": "我这里本来就是小本生意，也不可能经常大批量进货…",
            "nextDialogs": [
              "230430117"
            ]
          },
          "230430117": {
            "id": "230430117",
            "speakerId": 1001,
            "speakerName": "阿扎莱",
            "text": "咳，先不说这些。旅行者，你是准备出村子去吧？",
            "nextDialogs": [
              "230430118"
            ]
          },
          "230430118": {
            "id": "230430118",
            "speakerId": 1001,
            "speakerName": "阿扎莱",
            "text": "我最近想要进一批香料，需要有人帮我去下订单…你能帮我这个忙吗？"
          },
          "230430115": {
            "id": "230430115",
            "speakerId": 1001,
            "speakerName": "阿扎莱",
            "text": "哈哈哈…我也想过，但你看看周围。",
            "nextDialogs": [
              "230430116"
            ]
          },
          "230430116": {
            "id": "230430116",
            "speakerId": 1001,
            "speakerName": "阿扎莱",
            "text": "往这个村子里运货做生意，可不是一件容易的事啊。"
          }
        }
      }
    },
    {

    {
      "subId": "2304312",
      "subQuestName": "(test)获得拉玛的订单$HIDDEN",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "230431201"
        ],
        "dialogs": {
          "230431201": {
            "id": "230431201",
            "speakerId": 1002,
            "speakerName": "贾汉吉尔",
            "text": "喂，决定了没？要在我这里买的话，我就去开锅了。",
            "nextDialogs": [
              "230431203",
              "230431205"
            ]
          },
          "230431203": {
            "id": "230431203",
            "speakerId": 1002,
            "speakerName": "贾汉吉尔",
            "text": "行！我这就开始做鱼干，做好了之后就雇人送过去。"
          },
          "230431205": {
            "id": "230431205",
            "speakerId": 1002,
            "speakerName": "贾汉吉尔",
            "text": "欸？都说了，你去别处可找不到味道这么好的鱼干了，你就在我这里买吧…"
          }
        }
      }
    },

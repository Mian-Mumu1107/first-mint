    {
      "subId": "2304311",
      "subQuestName": "向阿扎莱回报",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "230431101"
        ],
        "dialogs": {
          "230431101": {
            "id": "230431101",
            "speakerId": 1002,
            "speakerName": "贾汉吉尔",
            "text": "欢迎光临，客人想要吃点啥？都是现做的。",
            "nextDialogs": [
              "230431102"
            ]
          },
          "230431102": {
            "id": "230431102",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "关于阿扎莱的订单…",
            "nextDialogs": [
              "230431103"
            ]
          },
          "230431103": {
            "id": "230431103",
            "speakerId": 1002,
            "speakerName": "贾汉吉尔",
            "text": "哈哈哈，行啊！我都和他说了，我的鱼干味道远近闻名，肯定能卖个好价钱。",
            "nextDialogs": [
              "230431104"
            ]
          },
          "230431104": {
            "id": "230431104",
            "speakerId": 1002,
            "speakerName": "贾汉吉尔",
            "text": "这些摩拉够买一些鱼干了，确定要买的话，我现在就去做！",
            "nextDialogs": [
              "230431105"
            ]
          },
          "230431105": {
            "id": "230431105",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "你是要开始晒吗？",
            "nextDialogs": [
              "230431106"
            ]
          },
          "230431106": {
            "id": "230431106",
            "speakerId": 1002,
            "speakerName": "贾汉吉尔",
            "text": "那怎么会，我是去把仓库里的那些鱼干拿出来再加工一下，那样味道才好。",
            "nextDialogs": [
              "230431107"
            ]
          },
          "230431107": {
            "id": "230431107",
            "speakerId": 1002,
            "speakerName": "贾汉吉尔",
            "text": "咦？等等，算上所有成本的话…这些摩拉也许不能买很多鱼干了…",
            "nextDialogs": [
              "230431109",
              "230431111"
            ]
          },
          "230431109": {
            "id": "230431109",
            "speakerId": 1002,
            "speakerName": "贾汉吉尔",
            "text": "行！我这就开始做鱼干，做好了之后就雇人送过去。"
          },
          "230431111": {
            "id": "230431111",
            "speakerId": 1002,
            "speakerName": "贾汉吉尔",
            "text": "欸？别走啊，价钱好商量，你去别处可找不到味道这么好的鱼干了啊！"
          }
        }
      }
    },
    {
      "subId": "2304317",
      "subQuestName": "向阿扎莱回报",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "230431503"
        ],
        "dialogs": {
          "230431503": {
            "id": "230431503",
            "speakerId": 1003,
            "speakerName": "Black Screen",
            "text": "向阿扎莱讲述了订货的经过…",
            "nextDialogs": [
              "230431504"
            ]
          },
          "230431504": {
            "id": "230431504",
            "speakerId": 1001,
            "speakerName": "阿扎莱",
            "text": "我知道了，布特罗斯的鱼干质量一向是很靠谱的，数量…也还不错。",
            "nextDialogs": [
              "230431505"
            ]
          },
          "230431505": {
            "id": "230431505",
            "speakerId": 1001,
            "speakerName": "阿扎莱",
            "text": "等货到了之后，我还得送几条给马鲁夫医生，上次可多亏他帮我治疗腿伤了…",
            "nextDialogs": [
              "230431506"
            ]
          },
          "230431506": {
            "id": "230431506",
            "speakerId": 1001,
            "speakerName": "阿扎莱",
            "text": "还有里夫和福迪尔，上次他们俩还帮我卸过货呢…",
            "nextDialogs": [
              "230431507"
            ]
          },
          "230431507": {
            "id": "230431507",
            "speakerId": 1001,
            "speakerName": "阿扎莱",
            "text": "咳！多谢你帮忙了，旅行者。这些报酬是给你的。还有这些摩拉，也请你一起收下吧。",
            "nextDialogs": [
              "230431508"
            ]
          },
          "230431508": {
            "id": "230431508",
            "speakerId": 1001,
            "speakerName": "阿扎莱",
            "text": "还好是在布特罗斯那边订的货，这么多鱼干，送点出去也不成问题…"
          }
        }
      }
    },
    {
      "subId": "2304314",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "230431403"
        ],
        "dialogs": {
          "230431403": {
            "id": "230431403",
            "speakerId": 1003,
            "speakerName": "Black Screen",
            "text": "向阿扎莱讲述了订货的经过…",
            "nextDialogs": [
              "230431404"
            ]
          },
          "230431404": {
            "id": "230431404",
            "speakerId": 1001,
            "speakerName": "阿扎莱",
            "text": "在朱特的店里订的？价格很高吗？唔…那我只能把香料的价钱定得稍微高点啊…",
            "nextDialogs": [
              "230431405"
            ]
          },
          "230431405": {
            "id": "230431405",
            "speakerId": 1001,
            "speakerName": "阿扎莱",
            "text": "不过这些香料看上去质量很不错，应该不愁卖不出去吧…",
            "nextDialogs": [
              "230431406"
            ]
          },
          "230431406": {
            "id": "230431406",
            "speakerId": 1001,
            "speakerName": "阿扎莱",
            "text": "对了，这些报酬请你收下吧，旅行者。"
          }
        }
      }
    },
    {
      "subId": "2304316",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "230431603"
        ],
        "dialogs": {
          "230431603": {
            "id": "230431603",
            "speakerId": 1003,
            "speakerName": "Black Screen",
            "text": "向阿扎莱讲述了订货的经过…",
            "nextDialogs": [
              "230431604"
            ]
          },
          "230431604": {
            "id": "230431604",
            "speakerId": 1001,
            "speakerName": "阿扎莱",
            "text": "在贾汉吉尔那里买的啊。价格是…呃！居然这么贵，他到底用了什么香料啊…",
            "nextDialogs": [
              "230431605"
            ]
          },
          "230431605": {
            "id": "230431605",
            "speakerId": 1001,
            "speakerName": "阿扎莱",
            "text": "不过也没关系，实在不行，我把那些鱼干都切开卖…",
            "nextDialogs": [
              "230431606"
            ]
          },
          "230431606": {
            "id": "230431606",
            "speakerId": 1001,
            "speakerName": "阿扎莱",
            "text": "啊…呃，这些报酬是给你的，旅行者，多谢你帮忙了…",
            "nextDialogs": [
              "230431607"
            ]
          },
          "230431607": {
            "id": "230431607",
            "speakerId": 1001,
            "speakerName": "阿扎莱",
            "text": "这能切成多少块呢…"
          }
        }
      }
    },

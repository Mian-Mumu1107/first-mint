    {
      "subId": "2304305",
      "subQuestName": "向阿扎莱回报",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "230430501"
        ],
        "dialogs": {
          "230430501": {
            "id": "230430501",
            "speakerId": 1000,
            "speakerName": "拉玛",
            "text": "欢迎光临！要买些常用的香料吗？价格很实惠哦！",
            "nextDialogs": [
              "230430502"
            ]
          },
          "230430502": {
            "id": "230430502",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "关于阿扎莱的订单…",
            "nextDialogs": [
              "230430503"
            ]
          },
          "230430503": {
            "id": "230430503",
            "speakerId": 1000,
            "speakerName": "拉玛",
            "text": "欸？阿扎莱拜托你来订货吗？倒是没问题…",
            "nextDialogs": [
              "230430504"
            ]
          },
          "230430504": {
            "id": "230430504",
            "speakerId": 1000,
            "speakerName": "拉玛",
            "text": "不过之前他都是拜托镀金旅团的人把货款带来，这次怎么拜托了一个冒险家…",
            "nextDialogs": [
              "230430505"
            ]
          },
          "230430505": {
            "id": "230430505",
            "speakerId": 1000,
            "speakerName": "拉玛",
            "text": "咳！这次他有多少货金？我看看…嚯，不少啊。",
            "nextDialogs": [
              "230430506"
            ]
          },
          "230430506": {
            "id": "230430506",
            "speakerId": 1000,
            "speakerName": "拉玛",
            "text": "唔，如果在我这里进香料的话，我给他提供的货，应该能足够他卖很长时间了。",
            "nextDialogs": [
              "230430507"
            ]
          },
          "230430507": {
            "id": "230430507",
            "speakerId": 1000,
            "speakerName": "拉玛",
            "text": "至于售价嘛…我还是建议和之前一样定的稍微低一些。这样才容易卖出去嘛。",
            "nextDialogs": [
              "230430509",
              "230430511"
            ]
          },
          "230430509": {
            "id": "230430509",
            "speakerId": 1000,
            "speakerName": "拉玛",
            "text": "喔！谢谢惠顾，等我准备好之后，就雇人把货物运过去。"
          },
          "230430511": {
            "id": "230430511",
            "speakerId": 1000,
            "speakerName": "拉玛",
            "text": "好吧…如果你还是想在我这里订货，过来和我说一声就行。"
          }
        }
      }
    },
    {
      "subId": "2304316",
      "subQuestName": "向阿扎莱回报",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "230431303"
        ],
        "dialogs": {
          "230431303": {
            "id": "230431303",
            "speakerId": 1003,
            "speakerName": "Black Screen",
            "text": "向阿扎莱讲述了订货的经过…",
            "nextDialogs": [
              "230431304"
            ]
          },
          "230431304": {
            "id": "230431304",
            "speakerId": 1001,
            "speakerName": "阿扎莱",
            "text": "唔…在拉玛的店订的啊，应该没什么问题。",
            "nextDialogs": [
              "230431305"
            ]
          },
          "230431305": {
            "id": "230431305",
            "speakerId": 1001,
            "speakerName": "阿扎莱",
            "text": "她的香料既便宜又好用，很受村里人的欢迎。货来了之后肯定不愁销路。",
            "nextDialogs": [
              "230431306"
            ]
          },
          "230431306": {
            "id": "230431306",
            "speakerId": 1001,
            "speakerName": "阿扎莱",
            "text": "多谢你帮忙了，旅行者，这些报酬是给你的…还有这些摩拉，也请一起收下吧。",
            "nextDialogs": [
              "230431307"
            ]
          },
          "230431307": {
            "id": "230431307",
            "speakerId": 1001,
            "speakerName": "阿扎莱",
            "text": "不过拉玛这家伙，我都订了这么多次了，她也没有给我打打折…"
          }
        }
      }
    },
    {
      "subId": "2304307",
      "subQuestName": "与阿扎莱对话",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "230430701"
        ],
        "dialogs": {
          "230430701": {
            "id": "230430701",
            "speakerId": 1004,
            "speakerName": "布特罗斯",
            "text": "欢迎！你是想买鱼吗？那你可来对地方了，我的鱼可是最新鲜的，不信你问问旁边的猫…",
            "nextDialogs": [
              "230430702"
            ]
          },
          "230430702": {
            "id": "230430702",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "关于阿扎莱的订单…",
            "nextDialogs": [
              "230430703"
            ]
          },
          "230430703": {
            "id": "230430703",
            "speakerId": 1004,
            "speakerName": "布特罗斯",
            "text": "喔…阿扎莱想找我买鱼干啊…没问题。",
            "nextDialogs": [
              "230430704"
            ]
          },
          "230430704": {
            "id": "230430704",
            "speakerId": 1004,
            "speakerName": "布特罗斯",
            "text": "这些摩拉能买很多鱼干了，足够他卖一段时间。",
            "nextDialogs": [
              "230430705"
            ]
          },
          "230430705": {
            "id": "230430705",
            "speakerId": 1004,
            "speakerName": "布特罗斯",
            "text": "不过，我的鱼干可都是…呃…忠实原味！不会放香料之类的东西啊。",
            "nextDialogs": [
              "230430707",
              "230430709"
            ]
          },
          "230430707": {
            "id": "230430707",
            "speakerId": 1004,
            "speakerName": "布特罗斯",
            "text": "好嘞！嘿嘿…我这就去挑一挑鱼干，等会就雇人给他送过去。"
          },
          "230430709": {
            "id": "230430709",
            "speakerId": 1004,
            "speakerName": "布特罗斯",
            "text": "欸？也行吧…你要比价就去吧…",
            "nextDialogs": [
              "230430710"
            ]
          },
          "230430710": {
            "id": "230430710",
            "speakerId": 1004,
            "speakerName": "布特罗斯",
            "text": "不过我这小本生意，可不能给你再打折了啊，不然我生意做不做了…"
          }
        }
      }
    },
    {
      "subId": "2304308",
      "subQuestName": "（test）回滚用任务环$HIDDEN",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "230430801"
        ],
        "dialogs": {
          "230430801": {
            "id": "230430801",
            "speakerId": 1004,
            "speakerName": "布特罗斯",
            "text": "怎么说？要在我这里订鱼干吗？",
            "nextDialogs": [
              "230430803",
              "230430805"
            ]
          },
          "230430803": {
            "id": "230430803",
            "speakerId": 1004,
            "speakerName": "布特罗斯",
            "text": "好嘞！嘿嘿…我这就去挑一挑鱼干，等会就雇人给他送过去。"
          },
          "230430805": {
            "id": "230430805",
            "speakerId": 1004,
            "speakerName": "布特罗斯",
            "text": "你可得快点啊，不然我的鱼干可都要卖光了。"
          }
        }
      }
    },
    {
      "subId": "2304309",
      "subQuestName": "向布特罗斯询问情况",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "230430901"
        ],
        "dialogs": {
          "230430901": {
            "id": "230430901",
            "speakerId": 1005,
            "speakerName": "朱特",
            "text": "你好，是要选购香料吗？",
            "nextDialogs": [
              "230430902"
            ]
          },
          "230430902": {
            "id": "230430902",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "关于阿扎莱的订单…",
            "nextDialogs": [
              "230430903"
            ]
          },
          "230430903": {
            "id": "230430903",
            "speakerId": 1005,
            "speakerName": "朱特",
            "text": "这个数额的货金…我能卖给他的香料数量可能不会太多…不过，这些香料可都是值钱货。",
            "nextDialogs": [
              "230430904"
            ]
          },
          "230430904": {
            "id": "230430904",
            "speakerId": 1005,
            "speakerName": "朱特",
            "text": "唔…既然是他的生意，我就多说两句。从朋友的角度来说，我并不太建议他从我这里进货。",
            "nextDialogs": [
              "230430905"
            ]
          },
          "230430905": {
            "id": "230430905",
            "speakerId": 1005,
            "speakerName": "朱特",
            "text": "我了解过阿如村的生意市场…我的判断是，在那里卖东西，最好的方式就是「薄利多销」。",
            "nextDialogs": [
              "230430906"
            ]
          },
          "230430906": {
            "id": "230430906",
            "speakerId": 1005,
            "speakerName": "朱特",
            "text": "简单来说，就是售卖质量过关，但价格相对低廉的货物，迅速卖出大批量的货物，以此快速回本。",
            "nextDialogs": [
              "230430907"
            ]
          },
          "230430907": {
            "id": "230430907",
            "speakerId": 1005,
            "speakerName": "朱特",
            "text": "但是，如果他试图在阿如村售卖质量上好，价格也偏高的货物…可能回本的速度就会很慢了。",
            "nextDialogs": [
              "230430908"
            ]
          },
          "230430908": {
            "id": "230430908",
            "speakerId": 1005,
            "speakerName": "朱特",
            "text": "不过，这也就是我的建议而已，具体他要进什么货，还是得看他的判断。",
            "nextDialogs": [
              "230430910",
              "230430912"
            ]
          },
          "230430910": {
            "id": "230430910",
            "speakerId": 1005,
            "speakerName": "朱特",
            "text": "好的。我这就去准备货物。"
          },
          "230430912": {
            "id": "230430912",
            "speakerId": 1005,
            "speakerName": "朱特",
            "text": "没问题，如果你还是想在我这里订货的话，欢迎随时回来。"
          }
        }
      }
    },
    {
      "subId": "2304310",

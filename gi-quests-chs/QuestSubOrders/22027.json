    "翔太": 27
  },
  "subQuests": [
    {
      "subId": "2202701",
      "subQuestName": "与翔太对话",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "220270101"
        ],
        "dialogs": {
          "220270101": {
            "id": "220270101",
            "speakerId": 1000,
            "speakerName": "翔太",
            "text": "漆器…到底是怎么做的呢…",
            "nextDialogs": [
              "220270102"
            ]
          },
          "220270102": {
            "id": "220270102",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "你做漆器干什么？",
            "nextDialogs": [
              "220270103"
            ]
          },
          "220270103": {
            "id": "220270103",
            "speakerId": 1000,
            "speakerName": "翔太",
            "text": "#是你啊…{PLAYERAVATAR#SEXPRO[INFO_MALE_PRONOUN_BIGBROTHER|INFO_FEMALE_PRONOUN_BIGSISTER]}，是这样的，你听说过神龛显灵的事吗？",
            "nextDialogs": [
              "220270104"
            ]
          },
          "220270104": {
            "id": "220270104",
            "speakerId": 1000,
            "speakerName": "翔太",
            "text": "我听人家说，如果向神龛献上珍贵的供品，也许就能实现自己的愿望。",
            "nextDialogs": [
              "220270105"
            ]
          },
          "220270105": {
            "id": "220270105",
            "speakerId": 1000,
            "speakerName": "翔太",
            "text": "我想，漂亮的漆器特别值钱，用漆器来供奉神龛的话，肯定能得到回应吧！",
            "nextDialogs": [
              "220270106"
            ]
          },
          "220270106": {
            "id": "220270106",
            "speakerId": 1000,
            "speakerName": "翔太",
            "text": "我没钱买漆器，所以就想要自己做一个。",
            "nextDialogs": [
              "220270107"
            ]
          },
          "220270107": {
            "id": "220270107",
            "speakerId": 1000,
            "speakerName": "翔太",
            "text": "我听说，「弥生漆器」的七月姐姐很擅长做漆器…",
            "nextDialogs": [
              "220270108"
            ]
          },
          "220270108": {
            "id": "220270108",
            "speakerId": 1000,
            "speakerName": "翔太",
            "text": "#{PLAYERAVATAR#SEXPRO[INFO_MALE_PRONOUN_BIGBROTHER|INFO_FEMALE_PRONOUN_BIGSISTER]}，你能陪我去找七月姐姐问一下漆器的事吗？",
            "nextDialogs": [
              "220270110",
              "220270112"
            ]
          },
          "220270110": {
            "id": "220270110",
            "speakerId": 1000,
            "speakerName": "翔太",
            "text": "#谢谢{PLAYERAVATAR#SEXPRO[INFO_MALE_PRONOUN_BIGBROTHER|INFO_FEMALE_PRONOUN_BIGSISTER]}！"
          },
          "220270112": {
            "id": "220270112",
            "speakerId": 1000,
            "speakerName": "翔太",
            "text": "七月姐姐她平时…很严肃的，我不太敢去向她请教…",
            "nextDialogs": [
              "220270113"
            ]
          },
          "220270113": {
            "id": "220270113",
            "speakerId": 1000,
            "speakerName": "翔太",
            "text": "#有{PLAYERAVATAR#SEXPRO[INFO_MALE_PRONOUN_BIGBROTHER|INFO_FEMALE_PRONOUN_BIGSISTER]}在旁边的话，应该会好一些吧…"
          }
        }
      }
    },
    {
      "subId": "2202702",
      "subQuestName": "与弥生七月对话",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "220270201"
        ],
        "dialogs": {
          "220270201": {
            "id": "220270201",
            "speakerId": 1001,
            "speakerName": "弥生七月",
            "text": "你们好，找我有什么事吗？",
            "nextDialogs": [
              "220270202"
            ]
          },
          "220270202": {
            "id": "220270202",
            "speakerId": 1000,
            "speakerName": "翔太",
            "text": "那、那个…",
            "nextDialogs": [
              "220270203"
            ]
          },
          "220270203": {
            "id": "220270203",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "关于漆器的事…",
            "nextDialogs": [
              "220270204"
            ]
          },
          "220270204": {
            "id": "220270204",
            "speakerId": 1001,
            "speakerName": "弥生七月",
            "text": "…想要向神龛供奉漆器，所以想要自己来做一个？",
            "nextDialogs": [
              "220270205"
            ]
          },
          "220270205": {
            "id": "220270205",
            "speakerId": 1000,
            "speakerName": "翔太",
            "text": "拜托了，七月姐姐，我有很想实现的愿望！而且我…我一定不会把你的秘方告诉别人的！",
            "nextDialogs": [
              "220270206"
            ]
          },
          "220270206": {
            "id": "220270206",
            "speakerId": 1001,
            "speakerName": "弥生七月",
            "text": "这不是涂料配方的问题。要制作出精美的漆器，除了涂料之外，还需要长年累月的练习。",
            "nextDialogs": [
              "220270207"
            ]
          },
          "220270207": {
            "id": "220270207",
            "speakerId": 1001,
            "speakerName": "弥生七月",
            "text": "这不仅是时间问题，更是…财力问题。我家的漆器手艺传到我这里，已经是第四代了。",
            "nextDialogs": [
              "220270208"
            ]
          },
          "220270208": {
            "id": "220270208",
            "speakerId": 1001,
            "speakerName": "弥生七月",
            "text": "为了研究漆器，我甚至还去须弥游学过。所以，你想要一下子学会制作漆器…实在是不太可能。",
            "nextDialogs": [
              "220270209"
            ]
          },
          "220270209": {
            "id": "220270209",
            "speakerId": 1000,
            "speakerName": "翔太",
            "text": "是…是这样吗？可是，我也想不到去给神龛供奉什么好东西了…",
            "nextDialogs": [
              "220270210"
            ]
          },
          "220270210": {
            "id": "220270210",
            "speakerId": 1001,
            "speakerName": "弥生七月",
            "text": "我觉得，向神龛供奉物品这种事，最重要的并不是物品的价值，而是这个物品所代表的「心意」才对。",
            "nextDialogs": [
              "220270211"
            ]
          },
          "220270211": {
            "id": "220270211",
            "speakerId": 1001,
            "speakerName": "弥生七月",
            "text": "只要诚心诚意，供奉你最喜欢的东西，应该就能得到神明的回应了。",
            "nextDialogs": [
              "220270212"
            ]
          },
          "220270212": {
            "id": "220270212",
            "speakerId": 1000,
            "speakerName": "翔太",
            "text": "诚心诚意…我最喜欢的东西…",
            "nextDialogs": [
              "220270213"
            ]
          },
          "220270213": {
            "id": "220270213",
            "speakerId": 1000,
            "speakerName": "翔太",
            "text": "唔，好像明白了…又好像不明白，但还是谢谢你了，七月姐姐。",
            "nextDialogs": [
              "220270214"
            ]
          },
          "220270214": {
            "id": "220270214",
            "speakerId": 1000,
            "speakerName": "翔太",
            "text": "#{PLAYERAVATAR#SEXPRO[INFO_MALE_PRONOUN_BIGBROTHER|INFO_FEMALE_PRONOUN_BIGSISTER]}，我们先回神龛去吧，我还想请你帮我参考一下，应该供奉什么。"
          }
        }
      }
    },
    {
      "subId": "2202703",
      "subQuestName": "帮助翔太供奉神龛",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "220270301"
        ],
        "dialogs": {
          "220270301": {
            "id": "220270301",
            "speakerId": 1000,
            "speakerName": "翔太",
            "text": "唉，虽然七月姐姐那么说了，但我到底该供奉什么呢…",
            "nextDialogs": [
              "220270302"
            ]
          },
          "220270302": {
            "id": "220270302",
            "speakerId": 1000,
            "speakerName": "翔太",
            "text": "说到我喜欢的东西，那肯定就是「三彩团子」了，我可喜欢吃了…",
            "nextDialogs": [
              "220270303"
            ]
          },
          "220270303": {
            "id": "220270303",
            "speakerId": 1000,
            "speakerName": "翔太",
            "text": "但是用「三彩团子」来供奉，是不是太不严肃了呢？而且我之前用金平糖供奉，神明大人也没有回复…",
            "nextDialogs": [
              "220270304"
            ]
          },
          "220270304": {
            "id": "220270304",
            "speakerId": 1000,
            "speakerName": "翔太",
            "text": "我还听说，有些人会把新鲜的花瓣做成香包，用这种香包来供奉的。这好像比团子严肃一点…",
            "nextDialogs": [
              "220270305"
            ]
          },
          "220270305": {
            "id": "220270305",
            "speakerId": 1000,
            "speakerName": "翔太",
            "text": "#怎么办？{PLAYERAVATAR#SEXPRO[INFO_MALE_PRONOUN_BIGBROTHER|INFO_FEMALE_PRONOUN_BIGSISTER]}，你觉得我应该供奉哪种东西呢？"
          }
        }
      }
    },
    {
      "subId": "2202705",
      "subQuestName": "",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "220270401"
        ],
        "dialogs": {
          "220270401": {
            "id": "220270401",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "还是供奉「三彩团子」吧。",
            "nextDialogs": [
              "220270402"
            ]
          },
          "220270402": {
            "id": "220270402",
            "speakerId": 1000,
            "speakerName": "翔太",
            "text": "这样吗…好！我刚好带着一个「三彩团子」，这是妈妈做给我的，我还没舍得吃呢…",
            "nextDialogs": [
              "220270403"
            ]
          },
          "220270403": {
            "id": "220270403",
            "speakerId": 1000,
            "speakerName": "翔太",
            "text": "就…就供奉给神明大人吧！",
            "nextDialogs": [
              "220270601"
            ]
          },
          "220270601": {
            "id": "220270601",
            "speakerId": 1000,
            "speakerName": "翔太",
            "text": "希望神明能保佑我，帮我实现愿望…",
            "nextDialogs": [
              "220270602"
            ]
          },
          "220270602": {
            "id": "220270602",
            "speakerId": 1000,
            "speakerName": "翔太",
            "text": "#谢谢你陪我到现在，{PLAYERAVATAR#SEXPRO[INFO_MALE_PRONOUN_BIGBROTHER|INFO_FEMALE_PRONOUN_BIGSISTER]}，这些东西给你，就当做是谢礼啦。",
            "nextDialogs": [
              "220270603"
            ]
          },
          "220270603": {
            "id": "220270603",
            "speakerId": 1000,
            "speakerName": "翔太",
            "text": "明天我会再来这里看看的，希望…神明大人会有些回复…"
          }
        }
      }
    },
    {
      "subId": "2202704",
      "subQuestName": "帮助翔太供奉神龛",
      "sceneId": null,
      "locations": [],

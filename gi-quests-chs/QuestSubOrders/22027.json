        "dialogs": {}
      }
    },
    {
      "subId": "2202705",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "220270501"
        ],
        "dialogs": {
          "220270501": {
            "id": "220270501",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "还是供奉香包吧。",
            "nextDialogs": [
              "220270502"
            ]
          },
          "220270502": {
            "id": "220270502",
            "speakerId": 1000,
            "speakerName": "翔太",
            "text": "好，我听你的。"
          }
        }
      }
    }
  ]
}
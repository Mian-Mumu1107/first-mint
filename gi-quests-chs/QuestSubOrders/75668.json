{
  "lineCounts": {
    "Player": 2,
    "阿维苏菈": 12
  },
  "subQuests": [
    {
      "subId": "7566801",
      "subQuestName": "与阿维苏菈对话",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "756680101"
        ],
        "dialogs": {
          "756680101": {
            "id": "756680101",
            "speakerId": 30875,
            "speakerName": "阿维苏菈",
            "text": "加点蘑菇…再加点野菜根…",
            "nextDialogs": [
              "756680102"
            ]
          },
          "756680102": {
            "id": "756680102",
            "speakerId": 30875,
            "speakerName": "阿维苏菈",
            "text": "#饮料调好了，{NICKNAME}，你要尝尝么？",
            "nextDialogs": [
              "756680103"
            ]
          },
          "756680103": {
            "id": "756680103",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "你，你往里面加了什么？",
            "nextDialogs": [
              "756680104"
            ]
          },
          "756680104": {
            "id": "756680104",
            "speakerId": 30875,
            "speakerName": "阿维苏菈",
            "text": "都是一些普通的香料和调味品，它们能让饮料变得更好喝。",
            "nextDialogs": [
              "756680105"
            ]
          },
          "756680105": {
            "id": "756680105",
            "speakerId": 30875,
            "speakerName": "阿维苏菈",
            "text": "后面的乐台已经搭建完成，普通的饮料可配不上它奏出来的音乐。",
            "nextDialogs": [
              "756680106"
            ]
          },
          "756680106": {
            "id": "756680106",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "话是这么说没错…",
            "nextDialogs": [
              "756680107"
            ]
          },
          "756680107": {
            "id": "756680107",
            "speakerId": 30875,
            "speakerName": "阿维苏菈",
            "text": "放心吧，在你之前已经有不少人喝过了。",
            "nextDialogs": [
              "756680108"
            ]
          },
          "756680108": {
            "id": "756680108",
            "speakerId": 30875,
            "speakerName": "阿维苏菈",
            "text": "喏，他们都已经拿着饮料去乐台旁边跳舞了。",
            "nextDialogs": [
              "756680109"
            ]
          },
          "756680109": {
            "id": "756680109",
            "speakerId": 30875,
            "speakerName": "阿维苏菈",
            "text": "#来吧{NICKNAME}，拿上一杯，和我们一起跳舞！",
            "nextDialogs": [
              "756680110"
            ]
          },
          "756680110": {
            "id": "756680110",
            "speakerId": 30875,
            "speakerName": "阿维苏菈",
            "text": "把糟心事都甩到一旁，尽情享受音乐吧！",
            "nextDialogs": [
              "756680111"
            ]
          },
          "756680111": {
            "id": "756680111",
            "speakerId": 30875,
            "speakerName": "阿维苏菈",
            "text": "对了，你跳舞的时候，也记得稍微控制一下，别用力过头了啊。",
            "nextDialogs": [
              "756680112"
            ]
          },
          "756680112": {
            "id": "756680112",
            "speakerId": 30875,
            "speakerName": "阿维苏菈",
            "text": "之前就有几个人因为跳太久差点晕过去了，被人扶下来的时候，还嘟嘟囔囔什么…",
            "nextDialogs": [
              "756680113"
            ]
          },
          "756680113": {
            "id": "756680113",
            "speakerId": 30875,
            "speakerName": "阿维苏菈",
            "text": "「我…我真看见了！那个…丘丘人…和我一起跳舞…」",
            "nextDialogs": [
              "756680114"
            ]
          },
          "756680114": {
            "id": "756680114",
            "speakerId": 30875,
            "speakerName": "阿维苏菈",
            "text": "咳，不说这些耽误你时间了，快去台上玩个痛快吧！"
          }
        }
      }
    }
  ]
}
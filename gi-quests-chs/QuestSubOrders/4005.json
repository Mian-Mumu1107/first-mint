      }
    },
    {
      "subId": "400504",
      "subQuestName": "与公子对话",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "40050401"
        ],
        "dialogs": {
          "40050401": {
            "id": "40050401",
            "speakerId": 1005,
            "speakerName": "图昂",
            "text": "你小子是什么来头，强得也太过分了吧…至冬的北国银行…难道你是——！",
            "nextDialogs": [
              "40050402"
            ]
          },
          "40050402": {
            "id": "40050402",
            "speakerId": 1006,
            "speakerName": "「公子」",
            "text": "现在意识到，也没有什么意义了，你只要记得北国银行是你惹不起的就好了…",
            "nextDialogs": [
              "40050403"
            ]
          },
          "40050403": {
            "id": "40050403",
            "speakerId": 1006,
            "speakerName": "「公子」",
            "text": "…嗯？",
            "nextDialogs": [
              "40050404"
            ]
          },
          "40050404": {
            "id": "40050404",
            "speakerId": 1005,
            "speakerName": "图昂",
            "text": "…有机会！",
            "nextDialogs": [
              "40050405"
            ]
          },
          "40050405": {
            "id": "40050405",
            "speakerId": 1006,
            "speakerName": "「公子」",
            "text": "呼…真是奇怪…",
            "nextDialogs": [
              "40050408"
            ]
          },
          "40050408": {
            "id": "40050408",
            "speakerId": 1006,
            "speakerName": "「公子」",
            "text": "我也不知道…刚才在准备出手的一瞬间，水元素力好像忽然不听我的掌控了，难道是神之眼出了问题…？",
            "nextDialogs": [
              "40050409"
            ]
          },
          "40050409": {
            "id": "40050409",
            "speakerId": 1002,
            "speakerName": "派蒙",
            "text": "还会发生这种事吗？神之眼失去控制…我还是头一次听说，好奇怪。",
            "nextDialogs": [
              "40050410"
            ]
          },
          "40050410": {
            "id": "40050410",
            "speakerId": 1006,
            "speakerName": "「公子」",
            "text": "…算了，也无所谓吧，过度依赖神之眼的元素力，人会变得不够锋利的。更何况我还有邪眼可以用。"
          }
        }
      }
    },
    {
      "subId": "400505",
      "subQuestName": "前往书报亭",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "40050501"
        ],
        "dialogs": {
          "40050501": {
            "id": "40050501",
            "speakerId": 1002,
            "speakerName": "派蒙",
            "text": "…呜哇，真相居然会是这样，一直没什么存在感的记者居然会是凶手！",
            "nextDialogs": [
              "40050504"
            ]
          },
          "40050504": {
            "id": "40050504",
            "speakerId": 1002,
            "speakerName": "派蒙",
            "text": "啊…对不起，我有点太惊讶了，没顾及这些…可是这里的推理小说真的非常好看啊！"
          }
        }
      }
    },

    {
      "subId": "400507",
      "subQuestName": "乘坐「娜维娅线」前往伊黎耶岛",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [],
        "dialogs": {}
      }
    },
    {
      "subId": "400509",
      "subQuestName": "前往歌剧院前的喷泉广场",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "40050901"
        ],
        "dialogs": {
          "40050901": {
            "id": "40050901",
            "speakerId": 1002,
            "speakerName": "派蒙",
            "text": "真是很气派的地方呢，欧庇克莱歌剧院…能在这里演出果然很厉害，怪不得林尼他们那么期待…",
            "nextDialogs": [
              "40050902"
            ]
          },
          "40050902": {
            "id": "40050902",
            "speakerId": 1002,
            "speakerName": "派蒙",
            "text": "咦？前面那个喷泉好像有很多人的样子。",
            "nextDialogs": [
              "40050903"
            ]
          },
          "40050903": {
            "id": "40050903",
            "speakerId": 1007,
            "speakerName": "约里奥",
            "text": "…神明啊，请保佑我们拥有一个聪慧而健康的孩子…",
            "nextDialogs": [
              "40050904"
            ]
          },
          "40050904": {
            "id": "40050904",
            "speakerId": 1008,
            "speakerName": "伊莉米娅",
            "text": "不要奢求那么多，我觉得我们的孩子能健健康康就足够了，平安度过一生才是最大的福气。",
            "nextDialogs": [
              "40050905"
            ]
          },
          "40050905": {
            "id": "40050905",
            "speakerId": 1007,
            "speakerName": "约里奥",
            "text": "呵呵，不过如果是我们两个的孩子的话，应该不可能不聪明的…",
            "nextDialogs": [
              "40050906"
            ]
          },
          "40050906": {
            "id": "40050906",
            "speakerId": 1002,
            "speakerName": "派蒙",
            "text": "这是什么枫丹的习俗么，好多夫妇在这里。",
            "nextDialogs": [
              "40050907"
            ]
          },
          "40050907": {
            "id": "40050907",
            "speakerId": 1009,
            "speakerName": "？？？",
            "text": "「…瓦谢…」",
            "nextDialogs": [
              "40050908"
            ]
          },
          "40050908": {
            "id": "40050908",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "嗯？",
            "nextDialogs": [
              "40050909"
            ]
          },
          "40050909": {
            "id": "40050909",
            "speakerId": 1002,
            "speakerName": "派蒙",
            "text": "#怎么了？{NICKNAME}…",
            "nextDialogs": [
              "40050910"
            ]
          },
          "40050910": {
            "id": "40050910",
            "speakerId": 1009,
            "speakerName": "？？？",
            "text": "「…瓦谢…瓦谢…」",
            "nextDialogs": [
              "40050911"
            ]
          },
          "40050911": {
            "id": "40050911",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "你刚刚…有跟我说话吗？",
            "nextDialogs": [
              "40050912"
            ]
          },
          "40050912": {
            "id": "40050912",
            "speakerId": 1002,
            "speakerName": "派蒙",
            "text": "没有啊，你是听到什么了吗？",
            "nextDialogs": [
              "40050915"
            ]
          },
          "40050915": {
            "id": "40050915",
            "speakerId": 1003,
            "speakerName": "琳妮特",
            "text": "这个喷泉叫做「露景泉」，是枫丹所有水流的交汇之处。枫丹的新婚夫妇都有来到这里求子的习俗。",
            "nextDialogs": [
              "40050916"
            ]
          },
          "40050916": {
            "id": "40050916",
            "speakerId": 1002,
            "speakerName": "派蒙",
            "text": "琳妮特！吓我一跳，你什么时候出现的…",
            "nextDialogs": [
              "40050917"
            ]
          },
          "40050917": {
            "id": "40050917",
            "speakerId": 1003,
            "speakerName": "琳妮特",
            "text": "是哥哥说要我在喷泉广场等你们的，不记得了吗？",
            "nextDialogs": [
              "40050918"
            ]
          },
          "40050918": {
            "id": "40050918",
            "speakerId": 1002,
            "speakerName": "派蒙",
            "text": "记得是记得…"
          }
        }
      }
    },
    {
      "subId": "400510",
      "subQuestName": "进入欧庇克莱歌剧院",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "40051001"
        ],
        "dialogs": {
          "40051001": {
            "id": "40051001",
            "speakerId": 1000,
            "speakerName": "林尼",
            "text": "#你们果然没有爽约啊，{NICKNAME}和派蒙，见到你们可真好。",
            "nextDialogs": [
              "40051002"
            ]
          },
          "40051002": {
            "id": "40051002",
            "speakerId": 1002,
            "speakerName": "派蒙",
            "text": "别开玩笑啦，我们怎么会错过你的演出呢，我都已经期待好久啦。",
            "nextDialogs": [
              "40051003"
            ]
          },
          "40051003": {
            "id": "40051003",
            "speakerId": 1000,
            "speakerName": "林尼",
            "text": "呵呵，我相信你，看你们来得这么早我就知道了。",
            "nextDialogs": [
              "40051004"
            ]
          },
          "40051004": {
            "id": "40051004",
            "speakerId": 1000,
            "speakerName": "林尼",
            "text": "正好，现在观众还基本没有入场，机会难得，我来给你们安排最好的座位吧…等等，我去拿票…",
            "nextDialogs": [
              "40051005"
            ]
          },
          "40051005": {
            "id": "40051005",
            "speakerId": 1000,
            "speakerName": "林尼",
            "text": "歌剧院一直是专号专座，需要提前登记的。来，我已经登记好了，这是你们的票。",
            "nextDialogs": [
              "40051006"
            ]
          },
          "40051006": {
            "id": "40051006",
            "speakerId": 1002,
            "speakerName": "派蒙",
            "text": "哦~！看起来是最前排的位置！谢谢你，林尼！",
            "nextDialogs": [
              "40051007"
            ]
          },
          "40051007": {
            "id": "40051007",
            "speakerId": 1000,
            "speakerName": "林尼",
            "text": "这没什么，不用这么客气…",
            "nextDialogs": [
              "40051008"
            ]
          },
          "40051008": {
            "id": "40051008",
            "speakerId": 1010,
            "speakerName": "考威尔",
            "text": "喂——林尼先生，麻烦帮我看一下这边…",
            "nextDialogs": [
              "40051009"
            ]
          },
          "40051009": {
            "id": "40051009",
            "speakerId": 1000,
            "speakerName": "林尼",
            "text": "知道了——舞台道具的布置那边似乎有点问题，我的助手考威尔先生在叫我，我先去帮忙看看…",
            "nextDialogs": [
              "40051012"
            ]
          },
          "40051012": {
            "id": "40051012",
            "speakerId": 1002,
            "speakerName": "派蒙",
            "text": "嗯，我们两个就先去自己的座位上好了，你的事情要紧。"
          }
        }
      }
    },
    {
      "subId": "400511",
      "subQuestName": "前往林尼安排的座位",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "40053001"
        ],
        "dialogs": {
          "40053001": {
            "id": "40053001",
            "speakerId": 1002,
            "speakerName": "派蒙",
            "text": "看座位号应该就是这里了吧…我们先坐吧。",
            "nextDialogs": [
              "40053002"
            ]
          },
          "40053002": {
            "id": "40053002",
            "speakerId": 1009,
            "speakerName": "？？？",
            "text": "……",
            "nextDialogs": [
              "40053003"
            ]
          },
          "40053003": {
            "id": "40053003",
            "speakerId": 1002,
            "speakerName": "派蒙",
            "text": "唔…",
            "nextDialogs": [
              "40053004"
            ]
          },
          "40053004": {
            "id": "40053004",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "……",
            "nextDialogs": [
              "40053005"
            ]
          },
          "40053005": {
            "id": "40053005",
            "speakerId": 1002,
            "speakerName": "派蒙",
            "text": "嗯…",
            "nextDialogs": [
              "40053006"
            ]
          },
          "40053006": {
            "id": "40053006",
            "speakerId": 1009,
            "speakerName": "？？？",
            "text": "……",
            "nextDialogs": [
              "40053007"
            ]
          },
          "40053007": {
            "id": "40053007",
            "speakerId": 1002,
            "speakerName": "派蒙",
            "text": "#喂，{NICKNAME}…我们是不是该跟旁边那个人搭个话比较好，没什么人的情况下，座位挨在一起好尴尬啊…",
            "nextDialogs": [
              "40053010"
            ]
          },
          "40053010": {
            "id": "40053010",
            "speakerId": 1002,
            "speakerName": "派蒙",
            "text": "你…我就知道你这家伙…",
            "nextDialogs": [
              "40053011"
            ]
          },
          "40053011": {
            "id": "40053011",
            "speakerId": 1009,
            "speakerName": "？？？",
            "text": "不好意思，我刚刚没有意识到气氛上的问题，是我疏忽了。",
            "nextDialogs": [
              "40053012"
            ]
          },
          "40053012": {
            "id": "40053012",
            "speakerId": 1009,
            "speakerName": "？？？",
            "text": "有必要的话我们直接聊天就好，没关系的。",
            "nextDialogs": [
              "40053013"
            ]
          },
          "40053013": {
            "id": "40053013",
            "speakerId": 1002,
            "speakerName": "派蒙",
            "text": "啊…你、你难道都听见了吗，你的耳朵好厉害，我明明把声音压得那么低…",
            "nextDialogs": [
              "40053014"
            ]
          },
          "40053014": {
            "id": "40053014",
            "speakerId": 1002,
            "speakerName": "派蒙",
            "text": "啊不对不对，是我太不礼貌了，偷偷嘀咕这些…我们、我们还是聊天吧，呃…聊什么呢…",
            "nextDialogs": [
              "40053015"
            ]
          },
          "40053015": {
            "id": "40053015",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "（感觉气氛更加尴尬了…）",
            "nextDialogs": [
              "40053016"
            ]
          },
          "40053016": {
            "id": "40053016",
            "speakerId": 1002,
            "speakerName": "派蒙",
            "text": "哦，对了！你也来得这么早，而且也坐在最前排的位置，你跟我们一样都是林尼的朋友吗？",
            "nextDialogs": [
              "40053017"
            ]
          },
          "40053017": {
            "id": "40053017",
            "speakerId": 1009,
            "speakerName": "？？？",
            "text": "朋友…如果林尼先生希望的话，我会十分乐意做他的朋友。",
            "nextDialogs": [
              "40053018"
            ]
          },
          "40053018": {
            "id": "40053018",
            "speakerId": 1002,
            "speakerName": "派蒙",
            "text": "那、那看来不是吗，糟糕，气氛更怪了…哦对了对了，我怎么忘了自我介绍…",
            "nextDialogs": [
              "40053019"
            ]
          },
          "40053019": {
            "id": "40053019",
            "speakerId": 1002,
            "speakerName": "派蒙",
            "text": "#你好，先生，我是派蒙，这位是{NICKNAME}，我们都刚刚来到枫丹。",
            "nextDialogs": [
              "40053020"
            ]
          },
          "40053020": {
            "id": "40053020",
            "speakerId": 1009,
            "speakerName": "？？？",
            "text": "你们好，很荣幸见到你们，我之前听说过二位的事迹。",
            "nextDialogs": [
              "40053021"
            ]
          },
          "40053021": {
            "id": "40053021",
            "speakerId": 1009,
            "speakerName": "？？？",
            "text": "遵照礼节，我也自我介绍一下，我是…",
            "nextDialogs": [
              "40053022"
            ]
          },
          "40053022": {
            "id": "40053022",
            "speakerId": 1000,
            "speakerName": "林尼",
            "text": "…那维莱特先生！您居然也赏光来看我的表演了，真是太荣幸了！",
            "nextDialogs": [
              "40053023"
            ]
          },
          "40053023": {
            "id": "40053023",
            "speakerId": 1011,
            "speakerName": "那维莱特",
            "text": "哦，林尼先生，能亲临现场观看你的演出，应该是我的荣幸才对。",
            "nextDialogs": [
              "40053024"
            ]
          },
          "40053024": {
            "id": "40053024",
            "speakerId": 1002,
            "speakerName": "派蒙",
            "text": "那维莱特？难道是…",
            "nextDialogs": [
              "40053025"
            ]
          },
          "40053025": {
            "id": "40053025",
            "speakerId": 1000,
            "speakerName": "林尼",
            "text": "欸？我看你们刚才在聊天，居然还不知道那维莱特先生的身份吗？",
            "nextDialogs": [
              "40053026"
            ]
          },
          "40053026": {
            "id": "40053026",
            "speakerId": 1000,
            "speakerName": "林尼",
            "text": "他是我们枫丹的最高审判官，看，那个位置一直都是那维莱特先生的，说他是枫丹「公正」的象征也不为过。",
            "nextDialogs": [
              "40053027"
            ]
          },
          "40053027": {
            "id": "40053027",
            "speakerId": 1002,
            "speakerName": "派蒙",
            "text": "唔哇，失敬失敬，我们刚才是有点太冒失了，原来先生你是这么厉害的人物…",
            "nextDialogs": [
              "40053028"
            ]
          },
          "40053028": {
            "id": "40053028",
            "speakerId": 1011,
            "speakerName": "那维莱特",
            "text": "不用那么在意，「最高审判官」也不过是个工作而已，正如每个人都会有自己的「位置」，我并不特殊。",
            "nextDialogs": [
              "40053029"
            ]
          },
          "40053029": {
            "id": "40053029",
            "speakerId": 1011,
            "speakerName": "那维莱特",
            "text": "哦对了，虽然稍微有些不情愿，但我还是姑且提醒你们一下…",
            "nextDialogs": [
              "40053030"
            ]
          },
          "40053030": {
            "id": "40053030",
            "speakerId": 1011,
            "speakerName": "那维莱特",
            "text": "那边那个家伙已经在高处的贵宾席位上摆了很久的姿势了…",
            "nextDialogs": [
              "40053031"
            ]
          },
          "40053031": {
            "id": "40053031",
            "speakerId": 1011,
            "speakerName": "那维莱特",
            "text": "就是为了让你们第一眼看到她的时候，她能展现出自以为最帅气的样子。",
            "nextDialogs": [
              "40053032"
            ]
          },
          "40053032": {
            "id": "40053032",
            "speakerId": 1011,
            "speakerName": "那维莱特",
            "text": "你们还是赶紧注意到吧，不然她要沮丧了。",
            "nextDialogs": [
              "40053033"
            ]
          },
          "40053033": {
            "id": "40053033",
            "speakerId": 1012,
            "speakerName": "芙宁娜",
            "text": "呵呵呵呵…",
            "nextDialogs": [
              "40053034"
            ]
          },
          "40053034": {
            "id": "40053034",
            "speakerId": 1002,
            "speakerName": "派蒙",
            "text": "呃…水神芙宁娜…她的表情好像一脸骄傲自满的样子，看来完全不知道你戳穿她的事。",
            "nextDialogs": [
              "40053035"
            ]
          },
          "40053035": {
            "id": "40053035",
            "speakerId": 1011,
            "speakerName": "那维莱特",
            "text": "嗯，这样就好了，我们不用管她，看自己的演出就好。",
            "nextDialogs": [
              "40053036"
            ]
          },
          "40053036": {
            "id": "40053036",
            "speakerId": 1002,
            "speakerName": "派蒙",
            "text": "…这就是枫丹水神与最高审判官之间的关系吗…",
            "nextDialogs": [
              "40053037"
            ]
          },
          "40053037": {
            "id": "40053037",
            "speakerId": 1000,
            "speakerName": "林尼",
            "text": "好了，各位再稍坐片刻，我那边的准备也基本完成了，等观众都进场以后，演出就会开始。",
            "nextDialogs": [
              "40053038"
            ]
          },
          "40053038": {
            "id": "40053038",
            "speakerId": 1002,
            "speakerName": "派蒙",
            "text": "终于要来了吗！我还没在现场看过魔术表演呢，真是期待！",
            "nextDialogs": [
              "40053039"
            ]
          },
          "40053039": {
            "id": "40053039",
            "speakerId": 1013,
            "speakerName": "Black Screen",
            "text": "一段时间后，观众陆续入场了，演出终于拉开帷幕。",
            "nextDialogs": [
              "40053040"
            ]
          },
          "40053040": {
            "id": "40053040",
            "speakerId": 1002,
            "speakerName": "派蒙",
            "text": "#哦！{NICKNAME}，灯黑下来了，是不是演出马上就开始了！",
            "nextDialogs": [
              "40053041"
            ]
          },
          "40053041": {
            "id": "40053041",
            "speakerId": 1011,
            "speakerName": "那维莱特",
            "text": "……",
            "nextDialogs": [
              "40053042"
            ]
          },
          "40053042": {
            "id": "40053042",
            "speakerId": 1002,
            "speakerName": "派蒙",
            "text": "对不起，我小声一点。",
            "nextDialogs": [
              "40053043"
            ]
          },
          "40053043": {
            "id": "40053043",
            "speakerId": 1000,
            "speakerName": "林尼",
            "text": "欢迎各位在百忙之中造访「欧庇克莱歌剧院」，我是今天的表演者林尼。",
            "nextDialogs": [
              "40053044"
            ]
          },
          "40053044": {
            "id": "40053044",
            "speakerId": 1000,
            "speakerName": "林尼",
            "text": "这边是我的妹妹，也是我最重要的助演，琳妮特。来，给大家打个招呼吧。",
            "nextDialogs": [
              "40053045"
            ]
          },
          "40053045": {
            "id": "40053045",
            "speakerId": 1003,
            "speakerName": "琳妮特",
            "text": "大家好。",
            "nextDialogs": [
              "40053046"
            ]
          },
          "40053046": {
            "id": "40053046",
            "speakerId": 1000,
            "speakerName": "林尼",
            "text": "哈哈，别看她一副没睡醒的样子，这是她在紧张的标志啦。",
            "nextDialogs": [
              "40053047"
            ]
          },
          "40053047": {
            "id": "40053047",
            "speakerId": 1003,
            "speakerName": "琳妮特",
            "text": "随便吧。",
            "nextDialogs": [
              "40053048"
            ]
          },
          "40053048": {
            "id": "40053048",
            "speakerId": 1000,
            "speakerName": "林尼",
            "text": "可能你们会觉得，我们这些拥有「神之眼」的人可以自由使用元素力，变个魔术有什么难的。",
            "nextDialogs": [
              "40053049"
            ]
          },
          "40053049": {
            "id": "40053049",
            "speakerId": 1000,
            "speakerName": "林尼",
            "text": "所以我在此做出的承诺便是——今天在舞台上发生的一切，都和元素力无关。",
            "nextDialogs": [
              "40053050"
            ]
          },
          "40053050": {
            "id": "40053050",
            "speakerId": 1000,
            "speakerName": "林尼",
            "text": "无论是我，还是琳妮特，都已经取下了「神之眼」。呵呵，这下神就帮不上忙啦。",
            "nextDialogs": [
              "40053051"
            ]
          },
          "40053051": {
            "id": "40053051",
            "speakerId": 1002,
            "speakerName": "派蒙",
            "text": "有道理啊，这就是魔术和魔法的区别吧。",
            "nextDialogs": [
              "40053052"
            ]
          },
          "40053052": {
            "id": "40053052",
            "speakerId": 1000,
            "speakerName": "林尼",
            "text": "相信大家都有些不耐烦了，表演马上就会开始。琳妮特会暂时离开做一些准备。",
            "nextDialogs": [
              "40053053"
            ]
          },
          "40053053": {
            "id": "40053053",
            "speakerId": 1000,
            "speakerName": "林尼",
            "text": "不用想念她哦，她很快就会以意料之外的方式重新登场，成为我们视线的焦点。",
            "nextDialogs": [
              "40053054"
            ]
          },
          "40053054": {
            "id": "40053054",
            "speakerId": 1000,
            "speakerName": "林尼",
            "text": "哦对了对了，还有最后一个注意事项。",
            "nextDialogs": [
              "40053055"
            ]
          },
          "40053055": {
            "id": "40053055",
            "speakerId": 1000,
            "speakerName": "林尼",
            "text": "请谨慎挑选眨眼的时机。"
          }
        }
      }
    },
    {
      "subId": "400516",
      "subQuestName": "",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "40051601"
        ],
        "dialogs": {
          "40051601": {
            "id": "40051601",
            "speakerId": 1002,
            "speakerName": "派蒙",
            "text": "呜哇？怎么回事，发生了什么？我什么都没有看见！",
            "nextDialogs": [
              "40051602"
            ]
          },
          "40051602": {
            "id": "40051602",
            "speakerId": 1002,
            "speakerName": "派蒙",
            "text": "琳妮特不是跳进去了吗？怎么就不见了，又是怎么出来的？",
            "nextDialogs": [
              "40051605"
            ]
          },
          "40051605": {
            "id": "40051605",
            "speakerId": 1011,
            "speakerName": "那维莱特",
            "text": "若是能轻易被我们识破，就说明他的技巧还需要继续精进。",
            "nextDialogs": [
              "40051606"
            ]
          },
          "40051606": {
            "id": "40051606",
            "speakerId": 1011,
            "speakerName": "那维莱特",
            "text": "魔术的欣赏，应该集中在舞台上呈现的过程，而不是被刻意隐藏的手法。",
            "nextDialogs": [
              "40051607"
            ]
          },
          "40051607": {
            "id": "40051607",
            "speakerId": 1002,
            "speakerName": "派蒙",
            "text": "有道理，琳妮特出现的时候真的吓了我一跳，好厉害啊。",
            "nextDialogs": [
              "40051608"
            ]
          },
          "40051608": {
            "id": "40051608",
            "speakerId": 1000,
            "speakerName": "林尼",
            "text": "感谢大家的掌声，刚刚的表演还满意吧。",
            "nextDialogs": [
              "40051609"
            ]
          },
          "40051609": {
            "id": "40051609",
            "speakerId": 1000,
            "speakerName": "林尼",
            "text": "不过，我们的神奇之旅还远远没有结束。我准备了能让各位更加惊讶的瞬间。",
            "nextDialogs": [
              "40051610"
            ]
          },
          "40051610": {
            "id": "40051610",
            "speakerId": 1000,
            "speakerName": "林尼",
            "text": "转移与消失的魔术，在此之上仍然能够进化。",
            "nextDialogs": [
              "40051611"
            ]
          },
          "40051611": {
            "id": "40051611",
            "speakerId": 1000,
            "speakerName": "林尼",
            "text": "想必各位会认为，水箱逃生的魔术就算看上去没有破绽，但说到底琳妮特还是我的助演。",
            "nextDialogs": [
              "40051612"
            ]
          },
          "40051612": {
            "id": "40051612",
            "speakerId": 1000,
            "speakerName": "林尼",
            "text": "这种情况下，我依然有充分的空间去做前期准备。",
            "nextDialogs": [
              "40051613"
            ]
          },
          "40051613": {
            "id": "40051613",
            "speakerId": 1000,
            "speakerName": "林尼",
            "text": "所以下一个魔术，我需要现场的一位幸运观众参与。",
            "nextDialogs": [
              "40051614"
            ]
          },
          "40051614": {
            "id": "40051614",
            "speakerId": 1000,
            "speakerName": "林尼",
            "text": "来吧，麻烦我的同伴们把充满魔力的箱子推上来。",
            "nextDialogs": [
              "40051615"
            ]
          },
          "40051615": {
            "id": "40051615",
            "speakerId": 1000,
            "speakerName": "林尼",
            "text": "像这样的箱子，一共有两个，一个在这里，一个在观众席的中央通道上。",
            "nextDialogs": [
              "40051616"
            ]
          },
          "40051616": {
            "id": "40051616",
            "speakerId": 1000,
            "speakerName": "林尼",
            "text": "想必聪明的观众应该已经猜到了——下一个魔术，就是交换！",
            "nextDialogs": [
              "40051617"
            ]
          },
          "40051617": {
            "id": "40051617",
            "speakerId": 1000,
            "speakerName": "林尼",
            "text": "被选出的幸运观众，会和我分别进入这两个箱子，一分钟后，我们会从对方的箱子里走出来。",
            "nextDialogs": [
              "40051618"
            ]
          },
          "40051618": {
            "id": "40051618",
            "speakerId": 1000,
            "speakerName": "林尼",
            "text": "在场的每一个人，请盯紧你们视线内的箱子，不要给我任何动手脚的机会哦。",
            "nextDialogs": [
              "40051619"
            ]
          },
          "40051619": {
            "id": "40051619",
            "speakerId": 1002,
            "speakerName": "派蒙",
            "text": "哇，这、这要怎么做到…",
            "nextDialogs": [
              "40051620"
            ]
          },
          "40051620": {
            "id": "40051620",
            "speakerId": 1002,
            "speakerName": "派蒙",
            "text": "#喂喂，{NICKNAME}，你说林尼他是不是真的会用法术啊。"
          }
        }
      }
    },
    {
      "subId": "400512",
      "subQuestName": "观看魔术表演",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [],
        "dialogs": {}
      }
    },
    {
      "subId": "400513",
      "subQuestName": "观看魔术表演",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "40051201"
        ],
        "dialogs": {
          "40051201": {
            "id": "40051201",
            "speakerId": 1012,
            "speakerName": "芙宁娜",
            "text": "……！",
            "nextDialogs": [
              "40051202"
            ]
          },
          "40051202": {
            "id": "40051202",
            "speakerId": 1014,
            "speakerName": "兴奋的观众",
            "text": "这、这也是魔术的一部分吗？",
            "nextDialogs": [
              "40051203"
            ]
          },
          "40051203": {
            "id": "40051203",
            "speakerId": 1014,
            "speakerName": "兴奋的观众",
            "text": "林尼先生，你接下来就要把舞台复原对吗？",
            "nextDialogs": [
              "40051204"
            ]
          },
          "40051204": {
            "id": "40051204",
            "speakerId": 1000,
            "speakerName": "林尼",
            "text": "怎么会这样…",
            "nextDialogs": [
              "40051205"
            ]
          },
          "40051205": {
            "id": "40051205",
            "speakerId": 1002,
            "speakerName": "派蒙",
            "text": "难道，真的是事故？那个箱子里还有人…对吧？",
            "nextDialogs": [
              "40051206"
            ]
          },
          "40051206": {
            "id": "40051206",
            "speakerId": 1011,
            "speakerName": "那维莱特",
            "text": "演出中止！医护人员随我来，警备队保护现场，控制所有参演者，暂时封锁歌剧院的出入口！",
            "nextDialogs": [
              "40051207"
            ]
          },
          "40051207": {
            "id": "40051207",
            "speakerId": 1012,
            "speakerName": "芙宁娜",
            "text": "说、说的没错！如果是事故，就要查出原因。如果不是事故，那、那就逃不过正义之神的审判！",
            "nextDialogs": [
              "40051208"
            ]
          },
          "40051208": {
            "id": "40051208",
            "speakerId": 1011,
            "speakerName": "那维莱特",
            "text": "两位不用慌张，我们很快就能调查清楚发生了什么。",
            "nextDialogs": [
              "40051209"
            ]
          },
          "40051209": {
            "id": "40051209",
            "speakerId": 1013,
            "speakerName": "Black Screen",
            "text": "一段时间过去，警备队的调查有了结果。",
            "nextDialogs": [
              "40051210"
            ]
          },
          "40051210": {
            "id": "40051210",
            "speakerId": 1011,
            "speakerName": "那维莱特",
            "text": "魔术箱里的人已经不幸遇难，死者名为考威尔，是林尼魔术团中的助演之一。",
            "nextDialogs": [
              "40051211"
            ]
          },
          "40051211": {
            "id": "40051211",
            "speakerId": 1011,
            "speakerName": "那维莱特",
            "text": "舞台上的烟花点燃了水箱上方的绳索，这是水箱坠落的直接原因。",
            "nextDialogs": [
              "40051212"
            ]
          },
          "40051212": {
            "id": "40051212",
            "speakerId": 1011,
            "speakerName": "那维莱特",
            "text": "至于为何箱中人是考威尔而非之前被选中的观众，此事暂且不知。",
            "nextDialogs": [
              "40051213"
            ]
          },
          "40051213": {
            "id": "40051213",
            "speakerId": 1011,
            "speakerName": "那维莱特",
            "text": "但在搜索之后，警备队确认那位少女宛如人间蒸发，已经不知所踪。",
            "nextDialogs": [
              "40051214"
            ]
          },
          "40051214": {
            "id": "40051214",
            "speakerId": 1011,
            "speakerName": "那维莱特",
            "text": "——此种状况，就并非是单纯的舞台意外了…",
            "nextDialogs": [
              "40051215"
            ]
          },
          "40051215": {
            "id": "40051215",
            "speakerId": 1011,
            "speakerName": "那维莱特",
            "text": "…也兼有许多属于「少女连环失踪案」的案件特征。",
            "nextDialogs": [
              "40051216"
            ]
          },
          "40051216": {
            "id": "40051216",
            "speakerId": 1015,
            "speakerName": "惊讶的观众",
            "text": "少、少女失踪案？！",
            "nextDialogs": [
              "40051217"
            ]
          },
          "40051217": {
            "id": "40051217",
            "speakerId": 1002,
            "speakerName": "派蒙",
            "text": "「少女连环失踪案」…我记得是夏洛蒂提到的那个事件！",
            "nextDialogs": [
              "40051220"
            ]
          },
          "40051220": {
            "id": "40051220",
            "speakerId": 1012,
            "speakerName": "芙宁娜",
            "text": "呵呵呵，我知道了，我知道了哦。拿这种一眼就能看穿的谜底来「压轴」，是不是有些小看我们了？",
            "nextDialogs": [
              "40051221"
            ]
          },
          "40051221": {
            "id": "40051221",
            "speakerId": 1012,
            "speakerName": "芙宁娜",
            "text": "这位技艺精湛，无所不能的魔术师林尼先生，不就是「少女连环失踪案」的罪魁祸首吗？",
            "nextDialogs": [
              "40051222"
            ]
          },
          "40051222": {
            "id": "40051222",
            "speakerId": 1000,
            "speakerName": "林尼",
            "text": "为什么是我？这完全就是一场意外！",
            "nextDialogs": [
              "40051223"
            ]
          },
          "40051223": {
            "id": "40051223",
            "speakerId": 1012,
            "speakerName": "芙宁娜",
            "text": "整个事件都在魔术表演的时候发生，少女被选中然后消失，死去的人还是你的助演…",
            "nextDialogs": [
              "40051224"
            ]
          },
          "40051224": {
            "id": "40051224",
            "speakerId": 1012,
            "speakerName": "芙宁娜",
            "text": "现在想来，开场所说「从有到无，从无到有」都像是一种挑衅了呢。",
            "nextDialogs": [
              "40051225"
            ]
          },
          "40051225": {
            "id": "40051225",
            "speakerId": 1002,
            "speakerName": "派蒙",
            "text": "不会吧？真的是林尼？",
            "nextDialogs": [
              "40051226"
            ]
          },
          "40051226": {
            "id": "40051226",
            "speakerId": 1002,
            "speakerName": "派蒙",
            "text": "他一直都在台上的箱子里啊，还在跟我们说话呢。",
            "nextDialogs": [
              "40051227"
            ]
          },
          "40051227": {
            "id": "40051227",
            "speakerId": 1002,
            "speakerName": "派蒙",
            "text": "而且，遇到他的时候他就说，想要抓到「少女连环失踪案」的凶手，总不会要抓住自己吧！"
          }
        }
      }
    },
    {
      "subId": "400540",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "40054001"
        ],
        "dialogs": {
          "40054001": {
            "id": "40054001",
            "speakerId": 1001,
            "speakerName": "菲米尼",
            "text": "谢谢你们，那位大姐我真的应付不来…"
          }
        }
      }
    },
    {
      "subId": "400599",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "40059901"
        ],
        "dialogs": {
          "40059901": {
            "id": "40059901",
            "speakerId": 1013,
            "speakerName": "Black Screen",
            "text": "在兴致勃勃的派蒙的带领下，你们几乎逛完了整个枫丹廷…",
            "nextDialogs": [
              "40059902"
            ]
          },
          "40059902": {
            "id": "40059902",
            "speakerId": 1002,
            "speakerName": "派蒙",
            "text": "记得林尼说歌剧院是在伊黎耶岛，我们还是坐巡轨船去吧！"
          }
        }
      }
    }
  ]
}
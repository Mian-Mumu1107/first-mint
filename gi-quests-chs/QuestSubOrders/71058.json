  "subQuests": [
    {
      "subId": "7105801",
      "subQuestName": "击败雷莹术士$HIDDEN",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "710580101"
        ],
        "dialogs": {
          "710580101": {
            "id": "710580101",
            "speakerId": 1000,
            "speakerName": "？？？",
            "text": "咳咳…呼…等等，请先停手…！你是谁？为什么会在这里…？",
            "nextDialogs": [
              "710580102"
            ]
          },
          "710580102": {
            "id": "710580102",
            "speakerId": 1000,
            "speakerName": "？？？",
            "text": "以及…为什么要攻击我？",
            "nextDialogs": [
              "710580103"
            ]
          },
          "710580103": {
            "id": "710580103",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "我们还想问你咧！谁让你在这里鬼鬼祟祟的！",
            "nextDialogs": [
              "710580104"
            ]
          },
          "710580104": {
            "id": "710580104",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "你是坏人，你先说。",
            "nextDialogs": [
              "710580105"
            ]
          },
          "710580105": {
            "id": "710580105",
            "speakerId": 1000,
            "speakerName": "？？？",
            "text": "…卡塔琳娜，卡塔琳娜·雪奈茨芙娜。",
            "nextDialogs": [
              "710580106"
            ]
          },
          "710580106": {
            "id": "710580106",
            "speakerId": 1002,
            "speakerName": "卡塔琳娜",
            "text": "名字是我们最不值得保守的情报，我只能透露这些，抱歉啦。",
            "nextDialogs": [
              "710580107"
            ]
          },
          "710580107": {
            "id": "710580107",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "唔…我们只是想问问情况而已，又没想拷问你啦！",
            "nextDialogs": [
              "710580108"
            ]
          },
          "710580108": {
            "id": "710580108",
            "speakerId": 1002,
            "speakerName": "卡塔琳娜",
            "text": "抱歉、抱歉，这是我能透露的全部情报了。",
            "nextDialogs": [
              "710580109"
            ]
          },
          "710580109": {
            "id": "710580109",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "为什么愚人众会在这里活动？",
            "nextDialogs": [
              "710580110"
            ]
          },
          "710580110": {
            "id": "710580110",
            "speakerId": 1002,
            "speakerName": "卡塔琳娜",
            "text": "机密。",
            "nextDialogs": [
              "710580111"
            ]
          },
          "710580111": {
            "id": "710580111",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "……",
            "nextDialogs": [
              "710580112"
            ]
          },
          "710580112": {
            "id": "710580112",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "什么啦！你们这些神神秘秘的坏家伙！",
            "nextDialogs": [
              "710580113"
            ]
          },
          "710580113": {
            "id": "710580113",
            "speakerId": 1002,
            "speakerName": "卡塔琳娜",
            "text": "呵呵，对呀，我们就是这种坏家伙哦。",
            "nextDialogs": [
              "710580114"
            ]
          },
          "710580114": {
            "id": "710580114",
            "speakerId": 1002,
            "speakerName": "卡塔琳娜",
            "text": "好了，好奇宝宝时间结束…我们有麻烦了。"
          }
        }
      }
    },
    {

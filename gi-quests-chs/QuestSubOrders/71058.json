    {
      "subId": "7105804",
      "subQuestName": "与愚人众术士继续被打断的对话",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "710580201"
        ],
        "dialogs": {
          "710580201": {
            "id": "710580201",
            "speakerId": 1002,
            "speakerName": "卡塔琳娜",
            "text": "谢谢…不论如何，我很开心你没有趁机在我背后捅刀。",
            "nextDialogs": [
              "710580204"
            ]
          },
          "710580204": {
            "id": "710580204",
            "speakerId": 1002,
            "speakerName": "卡塔琳娜",
            "text": "噗…虽然不知道你对愚人众有何成见，但在这种地方搭话可一点也不浪漫…有什么话就请来我的藏身点一叙吧。",
            "nextDialogs": [
              "710580207"
            ]
          },
          "710580207": {
            "id": "710580207",
            "speakerId": 1003,
            "speakerName": "Black Screen",
            "text": "卡塔琳娜离开了。",
            "nextDialogs": [
              "710580205"
            ]
          },
          "710580205": {
            "id": "710580205",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "欸？她可是愚人众呀，我们就这样把她放走了吗？不把她交给千岩军吗？",
            "nextDialogs": [
              "710580206"
            ]
          },
          "710580206": {
            "id": "710580206",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "哼…我知道啦，算啦，反正她也没有伤到我们，就当是饶她一命好啦！"
          }
        }
      }
    },
    {
      "subId": "7105805",
      "subQuestName": "前往愚人众术士藏身的营地",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "710580501"
        ],
        "dialogs": {
          "710580501": {
            "id": "710580501",
            "speakerId": 1002,
            "speakerName": "卡塔琳娜",
            "text": "你们两个果然来了，请找个地方休息一下吧。",
            "nextDialogs": [
              "710580502"
            ]
          },
          "710580502": {
            "id": "710580502",
            "speakerId": 1002,
            "speakerName": "卡塔琳娜",
            "text": "我这里还有些嗯…红茶，没有了…砂糖，也没了…嗯，牛奶，呕——酸掉了，我稍后丢掉好了…真是不好意思。",
            "nextDialogs": [
              "710580503"
            ]
          },
          "710580503": {
            "id": "710580503",
            "speakerId": 1002,
            "speakerName": "卡塔琳娜",
            "text": "不过火水还多得是…也有硬饼干做茶点，还有点酸果酱…嗯，足够开个茶会了。",
            "nextDialogs": [
              "710580504"
            ]
          },
          "710580504": {
            "id": "710580504",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "哇啊…！你们都用火水开茶会吗？",
            "nextDialogs": [
              "710580505"
            ]
          },
          "710580505": {
            "id": "710580505",
            "speakerId": 1002,
            "speakerName": "卡塔琳娜",
            "text": "对啊，很奇怪吗？",
            "nextDialogs": [
              "710580507",
              "710580509"
            ]
          },
          "710580507": {
            "id": "710580507",
            "speakerId": 1002,
            "speakerName": "卡塔琳娜",
            "text": "怎么？嘿嘿，在这里是没有人管你喝酒的。不要拘谨啦！"
          },
          "710580509": {
            "id": "710580509",
            "speakerId": 1002,
            "speakerName": "卡塔琳娜",
            "text": "我知道，我知道…别想那么多啦。"
          }
        }
      }
    },

  "subQuests": [
    {
      "subId": "102701",
      "subQuestName": "众人闲置对话$HIDDEN",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "10270101"
        ],
        "dialogs": {
          "10270101": {
            "id": "10270101",
            "speakerId": 1000,
            "speakerName": "荒泷一斗",
            "text": "不行，我要再去看一次。拿出我荒泷天下独尊…",
            "nextDialogs": [
              "10270102"
            ]
          },
          "10270102": {
            "id": "10270102",
            "speakerId": 1001,
            "speakerName": "久岐忍",
            "text": "老大。",
            "nextDialogs": [
              "10270103"
            ]
          },
          "10270103": {
            "id": "10270103",
            "speakerId": 1000,
            "speakerName": "荒泷一斗",
            "text": "噫！干嘛那么严肃嘛。",
            "nextDialogs": [
              "10270104"
            ]
          },
          "10270104": {
            "id": "10270104",
            "speakerId": 1001,
            "speakerName": "久岐忍",
            "text": "烤堇瓜。",
            "nextDialogs": [
              "10270105"
            ]
          },
          "10270105": {
            "id": "10270105",
            "speakerId": 1000,
            "speakerName": "荒泷一斗",
            "text": "哈？发生了那么大的事情，你就叫我在这烤堇瓜？",
            "nextDialogs": [
              "10270106"
            ]
          },
          "10270106": {
            "id": "10270106",
            "speakerId": 1002,
            "speakerName": "阿丑",
            "text": "哞！哞。",
            "nextDialogs": [
              "10270107"
            ]
          },
          "10270107": {
            "id": "10270107",
            "speakerId": 1000,
            "speakerName": "荒泷一斗",
            "text": "听见没，阿丑都说你说得对…等等，阿丑你又是帮哪边的？",
            "nextDialogs": [
              "10270108"
            ]
          },
          "10270108": {
            "id": "10270108",
            "speakerId": 1002,
            "speakerName": "阿丑",
            "text": "哞…",
            "nextDialogs": [
              "10270109"
            ]
          },
          "10270109": {
            "id": "10270109",
            "speakerId": 1001,
            "speakerName": "久岐忍",
            "text": "后勤是很重要的。保持充沛的体力和稳定的精神状态，才能应对未知。",
            "nextDialogs": [
              "10270110"
            ]
          },
          "10270110": {
            "id": "10270110",
            "speakerId": 1001,
            "speakerName": "久岐忍",
            "text": "阿丑也知道这个道理。",
            "nextDialogs": [
              "10270111"
            ]
          },
          "10270111": {
            "id": "10270111",
            "speakerId": 1000,
            "speakerName": "荒泷一斗",
            "text": "好啊，你们一个两个的…这就已经吃上了？",
            "nextDialogs": [
              "10270112"
            ]
          },
          "10270112": {
            "id": "10270112",
            "speakerId": 1000,
            "speakerName": "荒泷一斗",
            "text": "等等，已经熟了？香倒是挺香的…嗯…",
            "nextDialogs": [
              "10270113"
            ]
          },
          "10270113": {
            "id": "10270113",
            "speakerId": 1000,
            "speakerName": "荒泷一斗",
            "text": "好吧，那就先垫垫肚子再想办法。别把堇瓜吃完了，也给我留两个啊！"
          }
        }
      }
    },
    {
      "subId": "102806",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "10280601"
        ],
        "dialogs": {
          "10280601": {
            "id": "10280601",
            "speakerId": 1003,
            "speakerName": "烟绯",
            "text": "没想到我们会被困在这个地方，这下可真是难办了。",
            "nextDialogs": [
              "10280602"
            ]
          },
          "10280602": {
            "id": "10280602",
            "speakerId": 1003,
            "speakerName": "烟绯",
            "text": "就算我博学广闻，那也是在律法领域之内。我可不懂什么「越狱」的知识…",
            "nextDialogs": [
              "10280603"
            ]
          },
          "10280603": {
            "id": "10280603",
            "speakerId": 1003,
            "speakerName": "烟绯",
            "text": "亏我还和老爹定过「要快乐生活」的契约呢…唉，至少我不能消沉。",
            "nextDialogs": [
              "10280604"
            ]
          },
          "10280604": {
            "id": "10280604",
            "speakerId": 1003,
            "speakerName": "烟绯",
            "text": "往好处想，能来新地方开开眼界，还能和旧友重逢，都是好事。",
            "nextDialogs": [
              "10280605"
            ]
          },
          "10280605": {
            "id": "10280605",
            "speakerId": 1003,
            "speakerName": "烟绯",
            "text": "嗯嗯…对，好事。嗯…"
          }
        }
      }
    },
    {
      "subId": "102807",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "10280701"
        ],
        "dialogs": {
          "10280701": {
            "id": "10280701",
            "speakerId": 1004,
            "speakerName": "夜兰",
            "text": "现在情况严峻，暂时找不到出口。要做好多待一段时间的心理准备。",
            "nextDialogs": [
              "10280702"
            ]
          },
          "10280702": {
            "id": "10280702",
            "speakerId": 1004,
            "speakerName": "夜兰",
            "text": "好在物资看起来还不缺。这支拼拼凑凑的队伍里，也有擅于应对危机的人。",
            "nextDialogs": [
              "10280703"
            ]
          },
          "10280703": {
            "id": "10280703",
            "speakerId": 1004,
            "speakerName": "夜兰",
            "text": "照顾好你们自己。剩下的，我来想办法。"
          }
        }
      }
    },

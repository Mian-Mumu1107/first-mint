  "subQuests": [
    {
      "subId": "2503601",
      "subQuestName": "与凯塔对话$HIDDEN",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "250360101"
        ],
        "dialogs": {
          "250360101": {
            "id": "250360101",
            "speakerId": 6019,
            "speakerName": "凯塔",
            "text": "…果然这个问题还是太简单了吗？",
            "nextDialogs": [
              "250360102"
            ]
          },
          "250360102": {
            "id": "250360102",
            "speakerId": 6019,
            "speakerName": "凯塔",
            "text": "喔。真不好意思，我刚才在思考，没注意到您过来了。",
            "nextDialogs": [
              "250360103"
            ]
          },
          "250360103": {
            "id": "250360103",
            "speakerId": 6019,
            "speakerName": "凯塔",
            "text": "向您问好。我是「烟谜主」的凯塔，正在这里做学徒，负责管理资料。",
            "nextDialogs": [
              "250360104"
            ]
          },
          "250360104": {
            "id": "250360104",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "你在思考什么问题？",
            "nextDialogs": [
              "250360105"
            ]
          },
          "250360105": {
            "id": "250360105",
            "speakerId": 6019,
            "speakerName": "凯塔",
            "text": "啊…只是一些有关纳塔的过去，当下和未来的简单问题，不值一提。",
            "nextDialogs": [
              "250360106"
            ]
          },
          "250360106": {
            "id": "250360106",
            "speakerId": 6019,
            "speakerName": "凯塔",
            "text": "您看起来是一位来自远方的旅者。我能感觉到，你交游良多，所思甚广…",
            "nextDialogs": [
              "250360107"
            ]
          },
          "250360107": {
            "id": "250360107",
            "speakerId": 6019,
            "speakerName": "凯塔",
            "text": "如果您愿意的话，可以试试体验一下我已经记录在册的问题。",
            "nextDialogs": [
              "250360108"
            ]
          },
          "250360108": {
            "id": "250360108",
            "speakerId": 6019,
            "speakerName": "凯塔",
            "text": "这些问题的答案就在您的旅途之中——无论过去，当下还是未来的旅途。"
          }
        }
      }
    },
    {

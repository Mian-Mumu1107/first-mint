        ],
        "dialogs": {
          "790590101": {
            "id": "790590101",
            "speakerId": 21110,
            "speakerName": "片场备注",
            "text": "此处为短剧《东行·旅途的开始》片场的弃用场景",
            "nextDialogs": [
              "790590102"
            ]
          },
          "790590102": {
            "id": "790590102",
            "speakerId": 21110,
            "speakerName": "片场备注",
            "text": "原本构想的是试图从枫丹出发，向东前往须弥城寻找智慧宫不智之智的旅者的故事。",
            "nextDialogs": [
              "790590103"
            ]
          },
          "790590103": {
            "id": "790590103",
            "speakerId": 21110,
            "speakerName": "片场备注",
            "text": "这一幕是他在路上解救了被巨岩压身的「变幻大师」，与之一起踏上旅途的情节。",
            "nextDialogs": [
              "790590104"
            ]
          },
          "790590104": {
            "id": "790590104",
            "speakerId": 21110,
            "speakerName": "片场备注",
            "text": "啊不过，不管是饰演旅者的水形幻灵，还是饰演「变幻大师」的水形幻灵都不知道到哪去了。",
            "nextDialogs": [
              "790590105"
            ]
          },
          "790590105": {
            "id": "790590105",
            "speakerId": 21110,
            "speakerName": "片场备注",
            "text": "如果能<color=#00E1FFFF>把他们全都找回来</color>，捕捉到在巨岩边练习的时刻…"
          }
        }
      }
    },

        ],
        "dialogs": {
          "413401401": {
            "id": "413401401",
            "speakerId": 2001,
            "speakerName": "志华",
            "text": "哎哟，我得再歇一会…"
          }
        }
      }
    },
    {
      "subId": "4134001",
      "subQuestName": "与阿桂对话",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "413401101"
        ],
        "dialogs": {
          "413401101": {
            "id": "413401101",
            "speakerId": 2103,
            "speakerName": "阿桂",
            "text": "所以送药的事就只能拜托你帮忙了，旅行者。",
            "nextDialogs": [
              "413401102"
            ]
          },
          "413401102": {
            "id": "413401102",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "我明白了。",
            "nextDialogs": [
              "413401103"
            ]
          },
          "413401103": {
            "id": "413401103",
            "speakerId": 2103,
            "speakerName": "阿桂",
            "text": "谢谢你，这里是药，麻烦你们尽快送到观海和志华的手上吧。"
          }
        }
      }
    },
    {
      "subId": "4134003",
      "subQuestName": "给周围居民送药",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "413400201"
        ],
        "dialogs": {
          "413400201": {
            "id": "413400201",
            "speakerId": 2001,
            "speakerName": "志华",
            "text": "是不是吃了什么不干净的东西…",
            "nextDialogs": [
              "413400202"
            ]
          },
          "413400202": {
            "id": "413400202",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "关于阿桂的药…",
            "nextDialogs": [
              "413400203"
            ]
          },
          "413400203": {
            "id": "413400203",
            "speakerId": 2001,
            "speakerName": "志华",
            "text": "哦！谢谢，这个就是我找阿桂开的胃药吧？我确实有些消化不良…这肚子难受得紧…",
            "nextDialogs": [
              "413400204"
            ]
          },
          "413400204": {
            "id": "413400204",
            "speakerId": 2001,
            "speakerName": "志华",
            "text": "我其实就在市集里逛了一会，吃了一会，一不小心就吃多了…",
            "nextDialogs": [
              "413400205"
            ]
          },
          "413400205": {
            "id": "413400205",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "你都吃了些什么…",
            "nextDialogs": [
              "413400206"
            ]
          },
          "413400206": {
            "id": "413400206",
            "speakerId": 2001,
            "speakerName": "志华",
            "text": "唔…炒饭，鱼生，水果，好多好多虾，对了，还有很好喝的酒！",
            "nextDialogs": [
              "413400209"
            ]
          },
          "413400209": {
            "id": "413400209",
            "speakerId": 2001,
            "speakerName": "志华",
            "text": "所以才需要吃药嘛。但是你想，要是过节都不能想吃什么就吃什么，日子过得是不是就太没意思了？",
            "nextDialogs": [
              "413400210"
            ]
          },
          "413400210": {
            "id": "413400210",
            "speakerId": 2001,
            "speakerName": "志华",
            "text": "总之，谢谢你们的药，我也趁这个机会，稍微歇一会儿吧。"
          }
        }
      }
    },
    {
      "subId": "4134004",
      "subQuestName": "给周围居民送药",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "413400301"
        ],
        "dialogs": {
          "413400301": {
            "id": "413400301",
            "speakerId": 2036,
            "speakerName": "观海",
            "text": "唔唔，哎哟…真难受…你、你有什么事吗？",
            "nextDialogs": [
              "413400302"
            ]
          },
          "413400302": {
            "id": "413400302",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "关于阿桂的药…",
            "nextDialogs": [
              "413400303"
            ]
          },
          "413400303": {
            "id": "413400303",
            "speakerId": 2036,
            "speakerName": "观海",
            "text": "哦哦，谢谢你们！是我订的…来得真及时。",
            "nextDialogs": [
              "413400304"
            ]
          },
          "413400304": {
            "id": "413400304",
            "speakerId": 2036,
            "speakerName": "观海",
            "text": "哎呀，有药吃就好多了，我估计我是晚上吹海风引了风寒…",
            "nextDialogs": [
              "413400305"
            ]
          },
          "413400305": {
            "id": "413400305",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "不是消化不良吗…",
            "nextDialogs": [
              "413400306"
            ]
          },
          "413400306": {
            "id": "413400306",
            "speakerId": 2036,
            "speakerName": "观海",
            "text": "怎么可能？我的肠胃好得很，给你讲，我之前一顿饭能吃下三条烤鱼呢。",
            "nextDialogs": [
              "413400307"
            ]
          },
          "413400307": {
            "id": "413400307",
            "speakerId": 2036,
            "speakerName": "观海",
            "text": "就算是现在，吃饭喝酒的时候，周围的朋友也没有谁是我的对手。",
            "nextDialogs": [
              "413400308"
            ]
          },
          "413400308": {
            "id": "413400308",
            "speakerId": 2036,
            "speakerName": "观海",
            "text": "好了，不说了，我赶快吃药，接下来还有一场酒局呢。",
            "nextDialogs": [
              "413400311"
            ]
          },
          "413400311": {
            "id": "413400311",
            "speakerId": 2036,
            "speakerName": "观海",
            "text": "哈哈哈，没关系啦，又不是老头子。",
            "nextDialogs": [
              "413400312"
            ]
          },
          "413400312": {
            "id": "413400312",
            "speakerId": 2036,
            "speakerName": "观海",
            "text": "不过谢谢你的好意，我会注意的。"
          }
        }
      }
    },
    {
      "subId": "4134005",
      "subQuestName": "",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "413400501"
        ],
        "dialogs": {
          "413400501": {
            "id": "413400501",
            "speakerId": 2103,
            "speakerName": "阿桂",
            "text": "你来了，霄灯已经做好了吗？",
            "nextDialogs": [
              "413400502"
            ]
          },
          "413400502": {
            "id": "413400502",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "这是霄灯。",
            "nextDialogs": [
              "413400503"
            ]
          },
          "413400503": {
            "id": "413400503",
            "speakerId": 2103,
            "speakerName": "阿桂",
            "text": "辛苦你了。"
          }
        }
      }
    },
    {
      "subId": "4134006",
      "subQuestName": "",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "413400601"
        ],
        "dialogs": {
          "413400601": {
            "id": "413400601",
            "speakerId": 2103,
            "speakerName": "阿桂",
            "text": "这霄灯又规整又结实，呵呵，我的手艺可比这差远了。",
            "nextDialogs": [
              "413400602"
            ]
          },
          "413400602": {
            "id": "413400602",
            "speakerId": 2103,
            "speakerName": "阿桂",
            "text": "那等到晚上，我们就去把这盏霄灯放起来吧，我知道一个不错的地方。",
            "nextDialogs": [
              "413400603"
            ]
          },
          "413400603": {
            "id": "413400603",
            "speakerId": 2103,
            "speakerName": "阿桂",
            "text": "放灯之前的这段时间，我要好好想想，究竟许什么愿望…"
          }
        }
      }
    },
    {
      "subId": "4134007",
      "subQuestName": "向阿桂回报",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "413400401"
        ],
        "dialogs": {
          "413400401": {
            "id": "413400401",
            "speakerId": 2103,
            "speakerName": "阿桂",
            "text": "辛苦你们了，药应该都送到了吧？",
            "nextDialogs": [
              "413400404"
            ]
          },
          "413400404": {
            "id": "413400404",
            "speakerId": 2103,
            "speakerName": "阿桂",
            "text": "没办法，如果不注意生活习惯，肠胃病很难根治，只有再次生病的时候再对症下药。",
            "nextDialogs": [
              "413400405"
            ]
          },
          "413400405": {
            "id": "413400405",
            "speakerId": 2103,
            "speakerName": "阿桂",
            "text": "不过这下子，我也终于可以喘口气了…",
            "nextDialogs": [
              "413400406"
            ]
          },
          "413400406": {
            "id": "413400406",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "关于霄灯…",
            "nextDialogs": [
              "413400407"
            ]
          },
          "413400407": {
            "id": "413400407",
            "speakerId": 2103,
            "speakerName": "阿桂",
            "text": "放霄灯？我们…一般不会放啦，放霄灯是为了许愿的，「不卜庐」能许什么愿呢？",
            "nextDialogs": [
              "413400408"
            ]
          },
          "413400408": {
            "id": "413400408",
            "speakerId": 2103,
            "speakerName": "阿桂",
            "text": "别的商家都希望生意兴隆，但治病救人的药庐总不能期待这种事吧。"
          }
        }
      }
    },
    {
      "subId": "4134008",
      "subQuestName": "帮阿桂制作霄灯",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "413400801"
        ],
        "dialogs": {
          "413400801": {
            "id": "413400801",
            "speakerId": 2103,
            "speakerName": "阿桂",
            "text": "我的愿望，果然还是希望所有的璃月的居民，都能无病无灾。",
            "nextDialogs": [
              "413400802"
            ]
          },
          "413400802": {
            "id": "413400802",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "那「不卜庐」的生意…",
            "nextDialogs": [
              "413400803"
            ]
          },
          "413400803": {
            "id": "413400803",
            "speakerId": 2103,
            "speakerName": "阿桂",
            "text": "哈哈，所以说是我个人的愿望嘛。",
            "nextDialogs": [
              "413400804"
            ]
          },
          "413400804": {
            "id": "413400804",
            "speakerId": 2103,
            "speakerName": "阿桂",
            "text": "我愿意为人抓药，是因为我不想看到有人因为病痛而受折磨。",
            "nextDialogs": [
              "413400805"
            ]
          },
          "413400805": {
            "id": "413400805",
            "speakerId": 2103,
            "speakerName": "阿桂",
            "text": "老话说得好，「但愿世间人无病，何愁架上药生尘」。",
            "nextDialogs": [
              "413400806"
            ]
          },
          "413400806": {
            "id": "413400806",
            "speakerId": 2103,
            "speakerName": "阿桂",
            "text": "哈哈，而且只要大家都健健康康的，我也不会那么忙了，应该也是件好事…",
            "nextDialogs": [
              "413400807"
            ]
          },
          "413400807": {
            "id": "413400807",
            "speakerId": 2103,
            "speakerName": "阿桂",
            "text": "啊，糟了！我想起来，还有一家的药没有送到！",
            "nextDialogs": [
              "413400808"
            ]
          },
          "413400808": {
            "id": "413400808",
            "speakerId": 2103,
            "speakerName": "阿桂",
            "text": "抱歉，我要先走了！祝你们海灯节快乐！"
          }
        }
      }
    },
    {
      "subId": "4134009",
      "subQuestName": "将霄灯带给阿桂",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "413400901"
        ],
        "dialogs": {
          "413400901": {
            "id": "413400901",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "白术先生和七七呢？",
            "nextDialogs": [
              "413400902"
            ]
          },
          "413400902": {
            "id": "413400902",
            "speakerId": 2103,
            "speakerName": "阿桂",
            "text": "七七出去采药了，现在还没有回来，可能因为记性不好，又在哪里迷路了吧…",
            "nextDialogs": [
              "413400903"
            ]
          },
          "413400903": {
            "id": "413400903",
            "speakerId": 2103,
            "speakerName": "阿桂",
            "text": "至于白术先生，可能是在钻研医术，还是在做什么其他的事吧，总之也不是我应该过问的事。"
          }
        }
      }
    },
    {
      "subId": "4134010",
      "subQuestName": "向阿桂回报",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [],
        "dialogs": {}
      }
    },
    {
      "subId": "4134011",
      "subQuestName": "等到第二天晚上（20点~24点）",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [],
        "dialogs": {}
      }
    },
    {
      "subId": "4134013",
      "subQuestName": "前往约定地点寻找阿桂",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "413400701"
        ],
        "dialogs": {
          "413400701": {
            "id": "413400701",
            "speakerId": 2103,
            "speakerName": "阿桂",
            "text": "你们来啦，愿望我已经写在霄灯上了。",
            "nextDialogs": [
              "413400702"
            ]
          },
          "413400702": {
            "id": "413400702",
            "speakerId": 2103,
            "speakerName": "阿桂",
            "text": "现在时候也正好…我们马上放飞霄灯吧。"
          }
        }
      }
    },
    {
      "subId": "4134012",
      "subQuestName": "",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "413401201"
        ],
        "dialogs": {
          "413401201": {
            "id": "413401201",
            "speakerId": 2103,
            "speakerName": "阿桂",
            "text": "唔…药还够不够啊…"
          }
        }
      }
    },
    {
      "subId": "4134001",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "413400101"
        ],
        "dialogs": {
          "413400101": {
            "id": "413400101",
            "speakerId": 2103,
            "speakerName": "阿桂",
            "text": "不好意思，过节还要麻烦你，每年海灯节「不卜庐」的患者都会变多，实在是有点忙不过来。",
            "nextDialogs": [
              "413400102"
            ]
          },
          "413400102": {
            "id": "413400102",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "为什么会这样…",
            "nextDialogs": [
              "413400103"
            ]
          },
          "413400103": {
            "id": "413400103",
            "speakerId": 2103,
            "speakerName": "阿桂",
            "text": "海灯节的时候，大家都会放下工作陪伴家人，自然也少不了各种饭宴，香醇美酒，鸡鸭鱼肉…",
            "nextDialogs": [
              "413400104"
            ]
          },
          "413400104": {
            "id": "413400104",
            "speakerId": 2103,
            "speakerName": "阿桂",
            "text": "这样一来，难免消化不良，或者闹出这样那样的病症…",
            "nextDialogs": [
              "413400105"
            ]
          },
          "413400105": {
            "id": "413400105",
            "speakerId": 2103,
            "speakerName": "阿桂",
            "text": "虽然我总是劝人「切忌暴饮暴食」，但逢上了佳节良宵，这种劝告实在是没什么效用。",
            "nextDialogs": [
              "413400106"
            ]
          },
          "413400106": {
            "id": "413400106",
            "speakerId": 2103,
            "speakerName": "阿桂",
            "text": "刚刚又有几家人联系我，让我去送治消化不良和胃病的药。可「不卜庐」的事也不能放下…",
            "nextDialogs": [
              "413400107"
            ]
          },
          "413400107": {
            "id": "413400107",
            "speakerId": 2103,
            "speakerName": "阿桂",
            "text": "旅行者，如果你愿意的话，能帮忙去送几份药吗？"
          }
        }
      }
    },
    {
      "subId": "4134010",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "413401001"
        ],
        "dialogs": {
          "413401001": {
            "id": "413401001",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "没有其他帮忙的人吗？",
            "nextDialogs": [
              "413401002"
            ]
          },
          "413401002": {
            "id": "413401002",
            "speakerId": 2103,
            "speakerName": "阿桂",
            "text": "这个…现在店里暂时没人有空…"
          }
        }
      }
    },
    {
      "subId": "4134013",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "413401301"
        ],
        "dialogs": {
          "413401301": {
            "id": "413401301",
            "speakerId": 2103,
            "speakerName": "阿桂",
            "text": "嗯…还有多少家要送药的来着…"
          }
        }
      }
    },
    {
      "subId": "4134015",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "413401501"
        ],
        "dialogs": {
          "413401501": {
            "id": "413401501",
            "speakerId": 2036,
            "speakerName": "观海",
            "text": "哎呀，总算舒服了…等会吃点什么好呢…"
          }
        }
      }
    },
    {
      "subId": "4134016",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "413401601"
        ],
        "dialogs": {
          "413401601": {
            "id": "413401601",
            "speakerId": 2103,
            "speakerName": "阿桂",
            "text": "到底许什么愿望好呢…"
          }
        }
      }
    }
  ]
}
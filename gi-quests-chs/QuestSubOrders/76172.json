    },
    {
      "subId": "7617201",
      "subQuestName": "前往「斯佩兰扎」",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "761720101"
        ],
        "dialogs": {
          "761720101": {
            "id": "761720101",
            "speakerId": 1000,
            "speakerName": "米科",
            "text": "和摩拉一样金灿灿的，简直就是鳅鳅界的大黄金鳅鳅！",
            "nextDialogs": [
              "761720102"
            ]
          },
          "761720102": {
            "id": "761720102",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "摩拉？哪里有摩拉？",
            "nextDialogs": [
              "761720103"
            ]
          },
          "761720103": {
            "id": "761720103",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "好像还听到了黄金什么的…",
            "nextDialogs": [
              "761720104"
            ]
          },
          "761720104": {
            "id": "761720104",
            "speakerId": 1002,
            "speakerName": "莉奈娅",
            "text": "嗯！其实是前阵子在北边调查时发现了颜色独特的金鳅鳅，那一带就只有这么一只颜色不一样。",
            "nextDialogs": [
              "761720105"
            ]
          },
          "761720105": {
            "id": "761720105",
            "speakerId": 1002,
            "speakerName": "莉奈娅",
            "text": "它现在状态不错，我也找了更熟悉动物生态的医生看过，应该不是病理性的颜色改变。",
            "nextDialogs": [
              "761720106"
            ]
          },
          "761720106": {
            "id": "761720106",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "那它的颜色为什么会这么不一样呢？",
            "nextDialogs": [
              "761720107"
            ]
          },
          "761720107": {
            "id": "761720107",
            "speakerId": 1002,
            "speakerName": "莉奈娅",
            "text": "可能的原因有很多，比如栖息地的环境，包括水源和气候…对了，还有摄入的食物之类的。",
            "nextDialogs": [
              "761720108"
            ]
          },
          "761720108": {
            "id": "761720108",
            "speakerId": 1002,
            "speakerName": "莉奈娅",
            "text": "不过要问究竟是哪个特定的原因，我也答不上来了。",
            "nextDialogs": [
              "761720109"
            ]
          },
          "761720109": {
            "id": "761720109",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "你也有这种不求甚解的时候啊。",
            "nextDialogs": [
              "761720110"
            ]
          },
          "761720110": {
            "id": "761720110",
            "speakerId": 1002,
            "speakerName": "莉奈娅",
            "text": "因为是很偶然的现象嘛！光是能遇到就已经非常幸运了。",
            "nextDialogs": [
              "761720111"
            ]
          },
          "761720111": {
            "id": "761720111",
            "speakerId": 1002,
            "speakerName": "莉奈娅",
            "text": "能够记录发现，再作出一些推论和猜想，我就已经心满意足了。",
            "nextDialogs": [
              "761720112"
            ]
          },
          "761720112": {
            "id": "761720112",
            "speakerId": 1003,
            "speakerName": "玫熙",
            "text": "就像粉色的霜鳍鲸…",
            "nextDialogs": [
              "761720113"
            ]
          },
          "761720113": {
            "id": "761720113",
            "speakerId": 1003,
            "speakerName": "玫熙",
            "text": "大家都说如果能有机会看到粉色的霜鳍鲸，想要实现的愿望就能成真，可是真的真的很难遇到。",
            "nextDialogs": [
              "761720114"
            ]
          },
          "761720114": {
            "id": "761720114",
            "speakerId": 1003,
            "speakerName": "玫熙",
            "text": "不过我们有见到哦，和莉奈娅姐姐一起。我觉得，说不定是莉奈娅姐姐给我们带来的好运。",
            "nextDialogs": [
              "761720115"
            ]
          },
          "761720115": {
            "id": "761720115",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "#哇，{NICKNAME}，我们有机会也去找找看吧！我有好多愿望呢，要先许哪个好呢…",
            "nextDialogs": [
              "761720116"
            ]
          },
          "761720116": {
            "id": "761720116",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "颜色不一样就有这么神奇的能力吗？",
            "nextDialogs": [
              "761720117"
            ]
          },
          "761720117": {
            "id": "761720117",
            "speakerId": 1002,
            "speakerName": "莉奈娅",
            "text": "只是一种美好的愿望吧。",
            "nextDialogs": [
              "761720118"
            ]
          },
          "761720118": {
            "id": "761720118",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "居然没有神奇能力吗！",
            "nextDialogs": [
              "761720119"
            ]
          },
          "761720119": {
            "id": "761720119",
            "speakerId": 1002,
            "speakerName": "莉奈娅",
            "text": "的确有这样的例子，颜色特殊的个体也有着特别的能力，不过那只霜鳍鲸多半不是。",
            "nextDialogs": [
              "761720120"
            ]
          },
          "761720120": {
            "id": "761720120",
            "speakerId": 1002,
            "speakerName": "莉奈娅",
            "text": "如果只是向它许愿还好…就怕有人因此而伤害它。",
            "nextDialogs": [
              "761720121"
            ]
          },
          "761720121": {
            "id": "761720121",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "欸？还有这种事吗？",
            "nextDialogs": [
              "761720122"
            ]
          },
          "761720122": {
            "id": "761720122",
            "speakerId": 1000,
            "speakerName": "米科",
            "text": "我知道！以前听卡嘉说过，有些很坏的宝藏猎人会捕猎颜色特别的动物卖给收藏家之类的。",
            "nextDialogs": [
              "761720123"
            ]
          },
          "761720123": {
            "id": "761720123",
            "speakerId": 1002,
            "speakerName": "莉奈娅",
            "text": "嗯，有段时间纳塔的动物在黑市上很受追捧，活物自不必说，骨头和皮毛也有相当的市场。",
            "nextDialogs": [
              "761720124"
            ]
          },
          "761720124": {
            "id": "761720124",
            "speakerId": 1002,
            "speakerName": "莉奈娅",
            "text": "有些商人为了将走私的货品卖出高价，甚至不惜加工和改造，将其包装成一种「幻想」再兜售给客户。",
            "nextDialogs": [
              "761720125"
            ]
          },
          "761720125": {
            "id": "761720125",
            "speakerId": 1002,
            "speakerName": "莉奈娅",
            "text": "曾经还发生过这样的事，盗猎者为了美观和方便运输，在制作绒翼龙的标本时去除了它们的脚…",
            "nextDialogs": [
              "761720126"
            ]
          },
          "761720126": {
            "id": "761720126",
            "speakerId": 1002,
            "speakerName": "莉奈娅",
            "text": "而从未见过绒翼龙的收藏家竟然以为这种龙天生就是没有脚的，它们一生都在空中翱翔，餐风饮露，并对此啧啧称奇。",
            "nextDialogs": [
              "761720127"
            ]
          },
          "761720127": {
            "id": "761720127",
            "speakerId": 1002,
            "speakerName": "莉奈娅",
            "text": "他们轻率的追捧也反过来助长了盗猎者的恶行，一个基于贪婪和谎言而生的走私链条，造成了多少伤害和痛苦…",
            "nextDialogs": [
              "761720128"
            ]
          },
          "761720128": {
            "id": "761720128",
            "speakerId": 1004,
            "speakerName": "露米",
            "text": "呀吼…",
            "nextDialogs": [
              "761720129"
            ]
          },
          "761720129": {
            "id": "761720129",
            "speakerId": 1002,
            "speakerName": "莉奈娅",
            "text": "在许多的恶行里，哪怕是比较轻度的染色，总归也是不好的。",
            "nextDialogs": [
              "761720130"
            ]
          },
          "761720130": {
            "id": "761720130",
            "speakerId": 1003,
            "speakerName": "玫熙",
            "text": "那…那我们要给它洗澡吗？那只银色的豚兽，它也是被坏人染成这个颜色的吗？",
            "nextDialogs": [
              "761720131"
            ]
          },
          "761720131": {
            "id": "761720131",
            "speakerId": 1002,
            "speakerName": "莉奈娅",
            "text": "不用不用，我发现它的时候，它正泡在丘丘人的锅里呢，不知道是不是当作泡温泉了。",
            "nextDialogs": [
              "761720132"
            ]
          },
          "761720132": {
            "id": "761720132",
            "speakerId": 1002,
            "speakerName": "莉奈娅",
            "text": "它应该是非常罕见的，天生就是这个毛色，也是因为这样才会被走私者抓住吧。",
            "nextDialogs": [
              "761720133"
            ]
          },
          "761720133": {
            "id": "761720133",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "感觉完全能想象豚兽泡在锅里的样子…",
            "nextDialogs": [
              "761720134"
            ]
          },
          "761720134": {
            "id": "761720134",
            "speakerId": 1002,
            "speakerName": "莉奈娅",
            "text": "是吧？虽然颜色很特别，但天性还是和其他豚兽一样。",
            "nextDialogs": [
              "761720135"
            ]
          },
          "761720135": {
            "id": "761720135",
            "speakerId": 1000,
            "speakerName": "米科",
            "text": "说起来，我们之前也抓到过白色的盗宝鼬。",
            "nextDialogs": [
              "761720136"
            ]
          },
          "761720136": {
            "id": "761720136",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "是摩拉小偷！对哦，它现在怎么样了？",
            "nextDialogs": [
              "761720137"
            ]
          },
          "761720137": {
            "id": "761720137",
            "speakerId": 1002,
            "speakerName": "莉奈娅",
            "text": "已经放归了。希望它也得到了教训，不要再靠近愚人众的研究设施了…",
            "nextDialogs": [
              "761720138"
            ]
          },
          "761720138": {
            "id": "761720138",
            "speakerId": 1002,
            "speakerName": "莉奈娅",
            "text": "和豚兽不同，它的毛色变化应该是后天的，很有可能是暴露在过高浓度的月矩力环境里导致的。",
            "nextDialogs": [
              "761720139"
            ]
          },
          "761720139": {
            "id": "761720139",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "居然是这样…",
            "nextDialogs": [
              "761720140"
            ]
          },
          "761720140": {
            "id": "761720140",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "这样看来，「特别」也不见得全是好事呢。",
            "nextDialogs": [
              "761720141"
            ]
          },
          "761720141": {
            "id": "761720141",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "一想到它们中有些可能因为「特别」而遭遇不幸，或者原本就是因为不幸的事而变得「特别」的…",
            "nextDialogs": [
              "761720142"
            ]
          },
          "761720142": {
            "id": "761720142",
            "speakerId": 1002,
            "speakerName": "莉奈娅",
            "text": "虽然这么说可能会有点自私，不过，如果不是因为露米也是「特别」的霜精，或许我们就不会结成伙伴了…",
            "nextDialogs": [
              "761720143"
            ]
          },
          "761720143": {
            "id": "761720143",
            "speakerId": 1004,
            "speakerName": "露米",
            "text": "呀吼！呀吼吼！",
            "nextDialogs": [
              "761720144"
            ]
          },
          "761720144": {
            "id": "761720144",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "可是它看起来好像没什么意见。",
            "nextDialogs": [
              "761720145"
            ]
          },
          "761720145": {
            "id": "761720145",
            "speakerId": 1000,
            "speakerName": "米科",
            "text": "所以也不全是坏事吧？",
            "nextDialogs": [
              "761720146"
            ]
          },
          "761720146": {
            "id": "761720146",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "如果「特别」带来的是美好的相遇，当然是好事了。",
            "nextDialogs": [
              "761720147"
            ]
          },
          "761720147": {
            "id": "761720147",
            "speakerId": 1000,
            "speakerName": "米科",
            "text": "而且我记得之前赫卡寄回来的信里说过，璃月有句什么古话，福什么祸什么…",
            "nextDialogs": [
              "761720148"
            ]
          },
          "761720148": {
            "id": "761720148",
            "speakerId": 1003,
            "speakerName": "玫熙",
            "text": "是「祸兮福之所倚，福兮祸之所伏」。",
            "nextDialogs": [
              "761720149"
            ]
          },
          "761720149": {
            "id": "761720149",
            "speakerId": 1000,
            "speakerName": "米科",
            "text": "哦哦，就是这句！话说回来，你可是老师呀，怎么能在上课的时候消沉，快打起精神来吧。",
            "nextDialogs": [
              "761720150"
            ]
          },
          "761720150": {
            "id": "761720150",
            "speakerId": 1002,
            "speakerName": "莉奈娅",
            "text": "没想到我也有被米科鼓励的一天…",
            "nextDialogs": [
              "761720151"
            ]
          },
          "761720151": {
            "id": "761720151",
            "speakerId": 1000,
            "speakerName": "米科",
            "text": "那、那也是看在你以前也是海螺帮的份上！哎，这些复杂的道理先放一边，还是给我们讲讲兽怪的事吧！",
            "nextDialogs": [
              "761720152"
            ]
          },
          "761720152": {
            "id": "761720152",
            "speakerId": 1000,
            "speakerName": "米科",
            "text": "他们真的那么强吗？和雪精还有树妖相比呢？",
            "nextDialogs": [
              "761720153"
            ]
          },
          "761720153": {
            "id": "761720153",
            "speakerId": 1002,
            "speakerName": "莉奈娅",
            "text": "嗯嗯，兽怪也有很多精彩的故事可以讲哦，不过嘛…就留到下次再说了。",
            "nextDialogs": [
              "761720154"
            ]
          },
          "761720154": {
            "id": "761720154",
            "speakerId": 1000,
            "speakerName": "米科",
            "text": "又是下次吗？那下次一定！"
          }
        }
      }
    },
    {
      "subId": "7617203",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "761720301"
        ],
        "dialogs": {
          "761720301": {
            "id": "761720301",
            "speakerId": 1002,
            "speakerName": "莉奈娅",
            "text": "又让你看到不好意思的一面了…",
            "nextDialogs": [
              "761720302"
            ]
          },
          "761720302": {
            "id": "761720302",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "这没什么，今天我也学到了不少。",
            "nextDialogs": [
              "761720303"
            ]
          },
          "761720303": {
            "id": "761720303",
            "speakerId": 1002,
            "speakerName": "莉奈娅",
            "text": "真的吗？那就太好了…"
          }
        }
      }
    },
    {
      "subId": "7617204",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "761720401"
        ],
        "dialogs": {
          "761720401": {
            "id": "761720401",
            "speakerId": 1000,
            "speakerName": "米科",
            "text": "我刚刚想起来，你们去看霜鳍鲸的时候居然没叫上我！",
            "nextDialogs": [
              "761720402"
            ]
          },
          "761720402": {
            "id": "761720402",
            "speakerId": 1003,
            "speakerName": "玫熙",
            "text": "明明是你自己睡过头了…",
            "nextDialogs": [
              "761720403"
            ]
          },
          "761720403": {
            "id": "761720403",
            "speakerId": 1000,
            "speakerName": "米科",
            "text": "是这样吗？那、那下次一定要叫上我…"
          }
        }
      }
    }
  ]
}
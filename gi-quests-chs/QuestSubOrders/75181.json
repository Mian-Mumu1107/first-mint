      }
    },
    {
      "subId": "7518101",
      "subQuestName": "重新启动「象拟聚星」",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "751810101"
        ],
        "dialogs": {
          "751810101": {
            "id": "751810101",
            "speakerId": 1000,
            "speakerName": "Black Screen",
            "text": "那是如旧日回忆般浮现在眼前的场景。",
            "nextDialogs": [
              "751810102"
            ]
          },
          "751810102": {
            "id": "751810102",
            "speakerId": 1000,
            "speakerName": "Black Screen",
            "text": "层叠的高台上，无数卷积的运算图形随着分光通路的变化而不断流转…\\n聚流的燃素在巨大的压力下，形成了悬浮可控的高热球状体。\\n「成功了！」围观的同族发出喜悦的惊呼。\\n而这不亚于铸星之功的主导者，此刻却仿佛无关人士般，站在实验发生场的外围。",
            "nextDialogs": [
              "751810103"
            ]
          },
          "751810103": {
            "id": "751810103",
            "speakerId": 1001,
            "speakerName": "冰冷的声音",
            "text": "恭喜你，居然真的造出了能与微缩星体等价的东西…「象拟聚星」呵呵，简直就是能和重铸空月相媲美的伟业。",
            "nextDialogs": [
              "751810104"
            ]
          },
          "751810104": {
            "id": "751810104",
            "speakerId": 1001,
            "speakerName": "冰冷的声音",
            "text": "如果「那一位」还留存于世的话，说不定也会收拢翅膀，对你颔首以示庆贺吧。",
            "nextDialogs": [
              "751810105"
            ]
          },
          "751810105": {
            "id": "751810105",
            "speakerId": 1002,
            "speakerName": "厚重却疲惫的声音",
            "text": "「…如果你愿意帮忙的话，它应该在更早的时候就完成了。」",
            "nextDialogs": [
              "751810106"
            ]
          },
          "751810106": {
            "id": "751810106",
            "speakerId": 1001,
            "speakerName": "冰冷的声音",
            "text": "我对此没有兴趣。",
            "nextDialogs": [
              "751810107"
            ]
          },
          "751810107": {
            "id": "751810107",
            "speakerId": 1002,
            "speakerName": "厚重却疲惫的声音",
            "text": "「…你应该帮我的，库库尔坎。抢掠一切者的使者被我们驱逐入最深的山谷的罅隙，可一旦它的主人醒转——」",
            "nextDialogs": [
              "751810108"
            ]
          },
          "751810108": {
            "id": "751810108",
            "speakerId": 1002,
            "speakerName": "厚重却疲惫的声音",
            "text": "「对我们的族裔来说，将会是另一场灭顶之灾。」",
            "nextDialogs": [
              "751810109"
            ]
          },
          "751810109": {
            "id": "751810109",
            "speakerId": 1001,
            "speakerName": "冰冷的声音",
            "text": "啊…真是伟大，您造出了此物，以保护您可怜的同胞…",
            "nextDialogs": [
              "751810110"
            ]
          },
          "751810110": {
            "id": "751810110",
            "speakerId": 1002,
            "speakerName": "厚重却疲惫的声音",
            "text": "「是『我们』可怜的同胞。」",
            "nextDialogs": [
              "751810111"
            ]
          },
          "751810111": {
            "id": "751810111",
            "speakerId": 1002,
            "speakerName": "厚重却疲惫的声音",
            "text": "「这只是一个开端，我已时日无多，我需要在漆黑的翳影将我完全遮蔽之前，为所有的龙裔打造新的道路。」",
            "nextDialogs": [
              "751810112"
            ]
          },
          "751810112": {
            "id": "751810112",
            "speakerId": 1001,
            "speakerName": "冰冷的声音",
            "text": "或许您应该让他们自己去寻找…恕我直言，您现在企图打造的道路，对于我们的族裔来说，未免略微狭窄了一些。",
            "nextDialogs": [
              "751810113"
            ]
          },
          "751810113": {
            "id": "751810113",
            "speakerId": 1002,
            "speakerName": "厚重却疲惫的声音",
            "text": "「总需要去行狭窄的道的。当你拥有的时间已没有那么多…等待已变得那样奢侈的时候。」",
            "nextDialogs": [
              "751810114"
            ]
          },
          "751810114": {
            "id": "751810114",
            "speakerId": 1002,
            "speakerName": "厚重却疲惫的声音",
            "text": "「我已经受够了等待，总有一日，库库尔坎，总有一日你会理解我的，做出与我相同的决定，当你也…时日无多的时候…」",
            "nextDialogs": [
              "751810115"
            ]
          },
          "751810115": {
            "id": "751810115",
            "speakerId": 1001,
            "speakerName": "冰冷的声音",
            "text": "…我的君王，我的兄长，在你诞生之日令我诞生的主人，唯有这点，我实在无法苟同。",
            "nextDialogs": [
              "751810116"
            ]
          },
          "751810116": {
            "id": "751810116",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "咦，刚才那个是…看上去像是这个大火球被造出来的时候的场景…",
            "nextDialogs": [
              "751810117"
            ]
          },
          "751810117": {
            "id": "751810117",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "派蒙也看见了吗？",
            "nextDialogs": [
              "751810118"
            ]
          },
          "751810118": {
            "id": "751810118",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "嗯，这次我也看得一清二楚…那个时候围在这个蛋糕台子周围的，应该就是以前在这里生活的龙吧…",
            "nextDialogs": [
              "751810119"
            ]
          },
          "751810119": {
            "id": "751810119",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "真奇怪，那两个说话的人又是谁呢？",
            "nextDialogs": [
              "751810120"
            ]
          },
          "751810120": {
            "id": "751810120",
            "speakerId": 14662,
            "speakerName": "#{REALNAME[ID(2)|SHOWHOST(true)]}",
            "text": "呀…唔…",
            "nextDialogs": [
              "751810121"
            ]
          },
          "751810121": {
            "id": "751810121",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "总之，这里的「象拟聚星」的封印应该就算被打破了吧！"
          }
        }
      }
    }
  ]
}
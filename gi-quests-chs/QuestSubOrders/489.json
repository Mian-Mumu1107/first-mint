    {
      "subId": "48901",
      "subQuestName": "找莎拉听取委托内容",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "4890101"
        ],
        "dialogs": {
          "4890101": {
            "id": "4890101",
            "speakerId": 1000,
            "speakerName": "安柏",
            "text": "我知道啦，我马上就出发！",
            "nextDialogs": [
              "4890102"
            ]
          },
          "4890102": {
            "id": "4890102",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "是安柏！你是来处理委托的吗？",
            "nextDialogs": [
              "4890103"
            ]
          },
          "4890103": {
            "id": "4890103",
            "speakerId": 1000,
            "speakerName": "安柏",
            "text": "哇，是你们。我正准备去呢，清理商路上的丘丘人什么的，交给侦察骑士再合适不过了！",
            "nextDialogs": [
              "4890104"
            ]
          },
          "4890104": {
            "id": "4890104",
            "speakerId": 1002,
            "speakerName": "莎拉",
            "text": "唉…",
            "nextDialogs": [
              "4890105"
            ]
          },
          "4890105": {
            "id": "4890105",
            "speakerId": 1000,
            "speakerName": "安柏",
            "text": "莎拉小姐…为什么还是很苦恼的样子？放心啦，侦察骑士的实力不会让你失望的！",
            "nextDialogs": [
              "4890106"
            ]
          },
          "4890106": {
            "id": "4890106",
            "speakerId": 1002,
            "speakerName": "莎拉",
            "text": "哦、哦不是这样的，我没有怀疑你的实力，只是眼下的订单实在太多了。",
            "nextDialogs": [
              "4890107"
            ]
          },
          "4890107": {
            "id": "4890107",
            "speakerId": 1002,
            "speakerName": "莎拉",
            "text": "就在刚才，又新来了一份奇怪的订单，看起来好像是要准备一整场宴会的量…",
            "nextDialogs": [
              "4890108"
            ]
          },
          "4890108": {
            "id": "4890108",
            "speakerId": 1000,
            "speakerName": "安柏",
            "text": "咳咳。",
            "nextDialogs": [
              "4890109"
            ]
          },
          "4890109": {
            "id": "4890109",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "还有什么可以帮忙的吗？",
            "nextDialogs": [
              "4890110"
            ]
          },
          "4890110": {
            "id": "4890110",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "其实我也可以帮忙做饭！",
            "nextDialogs": [
              "4890111"
            ]
          },
          "4890111": {
            "id": "4890111",
            "speakerId": 1002,
            "speakerName": "莎拉",
            "text": "真的吗！你愿意帮忙吗？",
            "nextDialogs": [
              "4890112"
            ]
          },
          "4890112": {
            "id": "4890112",
            "speakerId": 1002,
            "speakerName": "莎拉",
            "text": "太好了，你简直就是「猎鹿人」的恩人！",
            "nextDialogs": [
              "4890113"
            ]
          },
          "4890113": {
            "id": "4890113",
            "speakerId": 1000,
            "speakerName": "安柏",
            "text": "唔…我怎么觉得我的风头被抢了？",
            "nextDialogs": [
              "4890114"
            ]
          },
          "4890114": {
            "id": "4890114",
            "speakerId": 1002,
            "speakerName": "莎拉",
            "text": "那这份新的订单就交给你了，先从收集食材开始吧！",
            "nextDialogs": [
              "4890115"
            ]
          },
          "4890115": {
            "id": "4890115",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "#可是…{NICKNAME}真的可以吗，料理的口味什么的…",
            "nextDialogs": [
              "4890116"
            ]
          },
          "4890116": {
            "id": "4890116",
            "speakerId": 1002,
            "speakerName": "莎拉",
            "text": "顾不上那么多啦，这可是事关「猎鹿人」声誉的战斗，挑三拣四什么的是不行的！",
            "nextDialogs": [
              "4890117"
            ]
          },
          "4890117": {
            "id": "4890117",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "战、战斗？",
            "nextDialogs": [
              "4890118"
            ]
          },
          "4890118": {
            "id": "4890118",
            "speakerId": 1002,
            "speakerName": "莎拉",
            "text": "料理需要<color=#00E1FFFF>三份甜甜花和三份禽肉</color>。",
            "nextDialogs": [
              "4890119"
            ]
          },
          "4890119": {
            "id": "4890119",
            "speakerId": 1002,
            "speakerName": "莎拉",
            "text": "好了快去准备吧，还有安柏小姐那边也是，我在这里等你们哦！",
            "nextDialogs": [
              "4890120"
            ]
          },
          "4890120": {
            "id": "4890120",
            "speakerId": 1000,
            "speakerName": "安柏",
            "text": "哦…哦、哦！"
          }
        }
      }
    },
    {

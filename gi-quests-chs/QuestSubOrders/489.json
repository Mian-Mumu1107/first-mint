              "4890305"
            ]
          },
          "4890305": {
            "id": "4890305",
            "speakerId": 1002,
            "speakerName": "莎拉",
            "text": "没错，这可是「猎鹿人」的保留菜品，是「猎鹿人」的骄傲。",

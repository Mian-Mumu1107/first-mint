          },
          "4890307": {
            "id": "4890307",
            "speakerId": 1002,
            "speakerName": "莎拉",
            "text": "那现在就先把<color=#00E1FFFF>蜜酱胡萝卜煎肉</color>的菜谱教给你…",
            "nextDialogs": [
              "4890308"
            ]
          },
          "4890308": {
            "id": "4890308",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "等等，不是说这是「猎鹿人」的保留菜品吗，就这样教给我们？",
            "nextDialogs": [
              "4890309"
            ]
          },
          "4890309": {
            "id": "4890309",
            "speakerId": 1002,
            "speakerName": "莎拉",
            "text": "以你的手艺的话，应该不会砸了「猎鹿人」的招牌吧，嘿嘿。",
            "nextDialogs": [
              "4890310"
            ]
          },
          "4890310": {
            "id": "4890310",
            "speakerId": 1002,
            "speakerName": "莎拉",
            "text": "那一份<color=#00E1FFFF>蜜酱胡萝卜煎肉</color>，等做好就端过来吧。"
          }
        }
      }

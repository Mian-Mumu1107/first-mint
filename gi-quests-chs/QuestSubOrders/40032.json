    {
      "subId": "4003201",
      "subQuestName": "前往万端珊瑚侦探社",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "400320101"
        ],
        "dialogs": {
          "400320101": {
            "id": "400320101",
            "speakerId": 3042,
            "speakerName": "龙二",
            "text": "你们来了。",
            "nextDialogs": [
              "400320102"
            ]
          },
          "400320102": {
            "id": "400320102",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "找到线索了吗？",
            "nextDialogs": [
              "400320103"
            ]
          },
          "400320103": {
            "id": "400320103",
            "speakerId": 3042,
            "speakerName": "龙二",
            "text": "嗯。这次多亏珊瑚社长了。",
            "nextDialogs": [
              "400320104"
            ]
          },
          "400320104": {
            "id": "400320104",
            "speakerId": 3042,
            "speakerName": "龙二",
            "text": "根据她的「演绎」，大致上确定了几处地点。",
            "nextDialogs": [
              "400320105"
            ]
          },
          "400320105": {
            "id": "400320105",
            "speakerId": 3042,
            "speakerName": "龙二",
            "text": "目前来看，有一处营地是由昨天那个「帽子狗」看守的，需要格外小心应对。",
            "nextDialogs": [
              "400320106"
            ]
          },
          "400320106": {
            "id": "400320106",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "感觉像派蒙会起的外号。",
            "nextDialogs": [
              "400320107"
            ]
          },
          "400320107": {
            "id": "400320107",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "喂！派蒙才不会起这样的外号。如果是我的话，应该会叫…",
            "nextDialogs": [
              "400320108"
            ]
          },
          "400320108": {
            "id": "400320108",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "嗯——就叫「刀子狗」吧！",
            "nextDialogs": [
              "400320109"
            ]
          },
          "400320109": {
            "id": "400320109",
            "speakerId": 3042,
            "speakerName": "龙二",
            "text": "……",
            "nextDialogs": [
              "400320110"
            ]
          },
          "400320110": {
            "id": "400320110",
            "speakerId": 3042,
            "speakerName": "龙二",
            "text": "总之，我在那边设置了一些一样的机关。希望这次也能凑效吧。",
            "nextDialogs": [
              "400320111"
            ]
          },
          "400320111": {
            "id": "400320111",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "哇！竟然被无视了！",
            "nextDialogs": [
              "400320112"
            ]
          },
          "400320112": {
            "id": "400320112",
            "speakerId": 3042,
            "speakerName": "龙二",
            "text": "那么，就拜托你们了。",
            "nextDialogs": [
              "400320113"
            ]
          },
          "400320113": {
            "id": "400320113",
            "speakerId": 3042,
            "speakerName": "龙二",
            "text": "还有什么问题吗？",
            "nextDialogs": [
              "400320114"
            ]
          },
          "400320114": {
            "id": "400320114",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "地点可靠吗？",
            "nextDialogs": [
              "400320115"
            ]
          },
          "400320115": {
            "id": "400320115",
            "speakerId": 3042,
            "speakerName": "龙二",
            "text": "绝对可靠。毕竟，我去实地考察过了。",
            "nextDialogs": [
              "400320116"
            ]
          },
          "400320116": {
            "id": "400320116",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "龙二为什么这次不和我们一起去呢？",
            "nextDialogs": [
              "400320117"
            ]
          },
          "400320117": {
            "id": "400320117",
            "speakerId": 3042,
            "speakerName": "龙二",
            "text": "虽然我也很想和你们一起，但今天不巧有珊瑚社长给我安排的其他任务。",
            "nextDialogs": [
              "400320118"
            ]
          },
          "400320118": {
            "id": "400320118",
            "speakerId": 3042,
            "speakerName": "龙二",
            "text": "大体来说，她对「帽子狗」的来历有些想法。所以委托我顺便去调查一下。",
            "nextDialogs": [
              "400320119"
            ]
          },
          "400320119": {
            "id": "400320119",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "「刀子狗」。",
            "nextDialogs": [
              "400320120"
            ]
          },
          "400320120": {
            "id": "400320120",
            "speakerId": 3042,
            "speakerName": "龙二",
            "text": "「帽子狗」。",
            "nextDialogs": [
              "400320122"
            ]
          },
          "400320122": {
            "id": "400320122",
            "speakerId": 3042,
            "speakerName": "龙二",
            "text": "好奇怪。",
            "nextDialogs": [
              "400320123"
            ]
          },
          "400320123": {
            "id": "400320123",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "这是什么外号，好奇怪。",
            "nextDialogs": [
              "400320125"
            ]
          },
          "400320125": {
            "id": "400320125",
            "speakerId": 3042,
            "speakerName": "龙二",
            "text": "…算了，还是叫它「黑影」吧。",
            "nextDialogs": [
              "400320126"
            ]
          },
          "400320126": {
            "id": "400320126",
            "speakerId": 3042,
            "speakerName": "龙二",
            "text": "无论如何，小动物就拜托了。"
          }
        }
      }
    },

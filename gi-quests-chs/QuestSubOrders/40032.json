      }
    },
    {
      "subId": "4003252",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "400325201"
        ],
        "dialogs": {
          "400325201": {
            "id": "400325201",
            "speakerId": 3041,
            "speakerName": "珊瑚",
            "text": "龙二告诉你们具体位置了吗？快去吧。这次你们和龙二就兵分两路吧。",
            "nextDialogs": [
              "400325202"
            ]
          },
          "400325202": {
            "id": "400325202",
            "speakerId": 3041,
            "speakerName": "珊瑚",
            "text": "因为关于「黑影」的来历我有一些有趣的猜想，还要龙二去验证一番才行。"
          }
        }
      }
    }
  ]
}
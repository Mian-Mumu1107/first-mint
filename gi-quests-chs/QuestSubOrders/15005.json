        "startDialogs": [],
        "dialogs": {}
      }
    },
    {
      "subId": "1500503",
      "subQuestName": "与被解救的游客对话",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "150050101"
        ],
        "dialogs": {
          "150050101": {
            "id": "150050101",
            "speakerId": 1002,
            "speakerName": "Black Screen",
            "text": "落败的鳍游龙四散逃走了。",
            "nextDialogs": [
              "150050102"
            ]
          },
          "150050102": {
            "id": "150050102",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "你们这身打扮，难道是须弥来的学者？",
            "nextDialogs": [
              "150050103"
            ]
          },
          "150050103": {
            "id": "150050103",
            "speakerId": 1001,
            "speakerName": "卡嘉",
            "text": "嗯，我是卡嘉，这位是我的前辈维兰德。真的非常感谢你们，刚刚太危险了…",
            "nextDialogs": [
              "150050104"
            ]
          },
          "150050104": {
            "id": "150050104",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "#不用谢，对我们来说只是小事一桩啦。我是派蒙，这位是{NICKNAME}。",
            "nextDialogs": [
              "150050105"
            ]
          },
          "150050105": {
            "id": "150050105",
            "speakerId": 1003,
            "speakerName": "维兰德",
            "text": "唉…那些鳍游龙全都跑了，至少要活捉一只啊。",
            "nextDialogs": [
              "150050106"
            ]
          },
          "150050106": {
            "id": "150050106",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "活捉？",
            "nextDialogs": [
              "150050107"
            ]
          },
          "150050107": {
            "id": "150050107",
            "speakerId": 1003,
            "speakerName": "维兰德",
            "text": "对了，我看你们身手不错，要不我来做诱饵吸引那些鳍游龙，你们帮我活捉一只，我会支付报酬的！",
            "nextDialogs": [
              "150050108"
            ]
          },
          "150050108": {
            "id": "150050108",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "这…",
            "nextDialogs": [
              "150050109"
            ]
          },
          "150050109": {
            "id": "150050109",
            "speakerId": 1001,
            "speakerName": "卡嘉",
            "text": "非常抱歉，维兰德只是太专注于他的研究了，还请不要见怪…",
            "nextDialogs": [
              "150050110"
            ]
          },
          "150050110": {
            "id": "150050110",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "没关系没关系！话说回来，你们为什么要招惹野生的鳍游龙呢？还要活捉…",
            "nextDialogs": [
              "150050111"
            ]
          },
          "150050111": {
            "id": "150050111",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "难道你们也想合影？",
            "nextDialogs": [
              "150050112"
            ]
          },
          "150050112": {
            "id": "150050112",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "肯定跟这个没关系啦！",
            "nextDialogs": [
              "150050113"
            ]
          },
          "150050113": {
            "id": "150050113",
            "speakerId": 1001,
            "speakerName": "卡嘉",
            "text": "让两位见笑了，其实我和维兰德正在寻找传说中的神秘岛。据说有一条重要的线索就在这些鳍游龙身上，所以…",
            "nextDialogs": [
              "150050114"
            ]
          },
          "150050114": {
            "id": "150050114",
            "speakerId": 1001,
            "speakerName": "卡嘉",
            "text": "没有来自「流泉之众」的向导帮助，就贸然接触它们，果然很不明智啊。",
            "nextDialogs": [
              "150050115"
            ]
          },
          "150050115": {
            "id": "150050115",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "神秘岛？",
            "nextDialogs": [
              "150050116"
            ]
          },
          "150050116": {
            "id": "150050116",
            "speakerId": 1001,
            "speakerName": "卡嘉",
            "text": "嗯，一个来自「流泉之众」的传说提到了一座神秘的岛屿，维兰德相信他的研究目标就在这座岛上。",
            "nextDialogs": [
              "150050117"
            ]
          },
          "150050117": {
            "id": "150050117",
            "speakerId": 1003,
            "speakerName": "维兰德",
            "text": "咳咳…你们真的不考虑一下我刚刚的提议吗？",
            "nextDialogs": [
              "150050118"
            ]
          },
          "150050118": {
            "id": "150050118",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "刚刚的提议…我们才不会把一个大活人当诱饵呢！",
            "nextDialogs": [
              "150050119"
            ]
          },
          "150050119": {
            "id": "150050119",
            "speakerId": 1003,
            "speakerName": "维兰德",
            "text": "那继续谈也是浪费时间，得想想别的办法…",
            "nextDialogs": [
              "150050120"
            ]
          },
          "150050120": {
            "id": "150050120",
            "speakerId": 1001,
            "speakerName": "卡嘉",
            "text": "前辈！",
            "nextDialogs": [
              "150050121"
            ]
          },
          "150050121": {
            "id": "150050121",
            "speakerId": 1003,
            "speakerName": "维兰德",
            "text": "好吧…刚刚你们确实救了我和卡嘉，于情于理，我是该向你们道谢…非常感谢。",
            "nextDialogs": [
              "150050122"
            ]
          },
          "150050122": {
            "id": "150050122",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "好别扭啊…",
            "nextDialogs": [
              "150050123"
            ]
          },
          "150050123": {
            "id": "150050123",
            "speakerId": 1003,
            "speakerName": "维兰德",
            "text": "卡嘉，我们该走了。",
            "nextDialogs": [
              "150050124"
            ]
          },
          "150050124": {
            "id": "150050124",
            "speakerId": 1001,
            "speakerName": "卡嘉",
            "text": "真的非常抱歉，维兰德确实不太擅长处理人际关系…",
            "nextDialogs": [
              "150050125"
            ]
          },
          "150050125": {
            "id": "150050125",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "没关系，再见！",
            "nextDialogs": [
              "150050126"
            ]
          },
          "150050126": {
            "id": "150050126",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "真是稀奇，这样的两个人竟然能够结伴探险。",
            "nextDialogs": [
              "150050127"
            ]
          },
          "150050127": {
            "id": "150050127",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "不过话说回来，那位大姐姐提到的神秘岛真的让我很好奇呢。",
            "nextDialogs": [
              "150050128"
            ]
          },
          "150050128": {
            "id": "150050128",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "派蒙也想去？",
            "nextDialogs": [
              "150050129"
            ]
          },
          "150050129": {
            "id": "150050129",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "嗯，或许会有宝藏哦！",
            "nextDialogs": [
              "150050130"
            ]
          },
          "150050130": {
            "id": "150050130",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "这一路上，我们一起探索了那么多神奇的地方，找到这个神秘岛对我们来说也绝对不在话下！",
            "nextDialogs": [
              "150050131"
            ]
          },
          "150050131": {
            "id": "150050131",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "但是什么情报都没有。",
            "nextDialogs": [
              "150050132"
            ]
          },
          "150050132": {
            "id": "150050132",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "也是…对了，那位大姐姐说这个神秘岛是「流泉之众」传说中的一座岛屿，或许我们可以到那里找人问问？",
            "nextDialogs": [
              "150050133"
            ]
          },
          "150050133": {
            "id": "150050133",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "事不宜迟，现在就开始我们的下一段冒险吧！",
            "nextDialogs": [
              "150050134"
            ]
          },
          "150050134": {
            "id": "150050134",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "虽说计划好了找人问问，但具体该找谁是个问题。",
            "nextDialogs": [
              "150050135"
            ]
          },
          "150050135": {
            "id": "150050135",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "或许可以直接找首领？",
            "nextDialogs": [
              "150050136"
            ]
          },
          "150050136": {
            "id": "150050136",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "嗯…也对，那位大姐姐提到这个神秘岛和「流泉之众」的一个传说有关，那「流泉之众」的首领肯定知道。"
          }
        }
      }
    },

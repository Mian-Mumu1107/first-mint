            ]
          },
          "150059902": {
            "id": "150059902",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "不要慌，再坚持一下！",
            "nextDialogs": [
              "150059903"
            ]
          },
          "150059903": {
            "id": "150059903",
            "speakerId": 1001,
            "speakerName": "卡嘉",
            "text": "终于有人来了…救命！"
          }

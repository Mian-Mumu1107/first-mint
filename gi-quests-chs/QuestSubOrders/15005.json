  "subQuests": [
    {
      "subId": "1500501",
      "subQuestName": "前往流泉之众驻地的野外游玩",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "150050201"
        ],
        "dialogs": {
          "150050201": {
            "id": "150050201",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "这里的景色很不错，还能偶尔看到鳍游龙，我们找几头野生的鳍游龙来合影吧？",
            "nextDialogs": [
              "150050202"
            ]
          },
          "150050202": {
            "id": "150050202",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "野生的咬人怎么办？",
            "nextDialogs": [
              "150050203"
            ]
          },
          "150050203": {
            "id": "150050203",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "这…反正我觉得鳍游龙挺可爱的…",
            "nextDialogs": [
              "150050204"
            ]
          },
          "150050204": {
            "id": "150050204",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "哎？那里是…",
            "nextDialogs": [
              "150050205"
            ]
          },
          "150050205": {
            "id": "150050205",
            "speakerId": 1001,
            "speakerName": "卡嘉",
            "text": "救命！谁来帮帮我们？",
            "nextDialogs": [
              "150050206"
            ]
          },
          "150050206": {
            "id": "150050206",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "哇，野生的鳍游龙真的在咬人！",
            "nextDialogs": [
              "150050208",
              "150050210"
            ]
          },
          "150050208": {
            "id": "150050208",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "#对，那两个人有危险，大名鼎鼎的{NICKNAME}和{M#他}{F#她}的搭档绝不会袖手旁观！"
          },
          "150050210": {
            "id": "150050210",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "是啊，没时间讲这个了。有人在呼救，我们不能袖手旁观吧？"
          }
        }
      }
    },
    {
      "subId": "1500502",
      "subQuestName": "击退鳍游龙",
      "sceneId": null,
      "locations": [],

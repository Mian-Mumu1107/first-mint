      }
    },
    {
      "subId": "7601006",
      "subQuestName": "与佩卡尼对话",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "760100601"
        ],
        "dialogs": {
          "760100601": {
            "id": "760100601",
            "speakerId": 21840,
            "speakerName": "佩卡尼",
            "text": "喂，你们看到了吗？刚才不知道发生了什么事，我一不留神，那块大石头就突然飞走了！",
            "nextDialogs": [
              "760100602"
            ]
          },
          "760100602": {
            "id": "760100602",
            "speakerId": 1002,
            "speakerName": "Black Screen",
            "text": "讲述了之前的事…",
            "nextDialogs": [
              "760100603"
            ]
          },
          "760100603": {
            "id": "760100603",
            "speakerId": 21840,
            "speakerName": "佩卡尼",
            "text": "唔哦！虽然完全没听懂怎么回事，但既然能展现这般奇迹，你们一定是受到月之{RUBY#[D]库塔尔}少女宠爱的人吧！",
            "nextDialogs": [
              "760100604"
            ]
          },
          "760100604": {
            "id": "760100604",
            "speakerId": 21840,
            "speakerName": "佩卡尼",
            "text": "月神大人保佑，月神大人保佑！这样一来，我就能在这里大钓特钓了！只要那个讨厌的游吟诗人不再带着他的宠物过来唱歌…",
            "nextDialogs": [
              "760100605"
            ]
          },
          "760100605": {
            "id": "760100605",
            "speakerId": 21840,
            "speakerName": "佩卡尼",
            "text": "来，这是说好的报酬！虽说我最近都没钓上鱼，但其他的小玩意儿倒是钓了不少，有的应该还挺值钱的…",
            "nextDialogs": [
              "760100606"
            ]
          },
          "760100606": {
            "id": "760100606",
            "speakerId": 21840,
            "speakerName": "佩卡尼",
            "text": "只是希汐岛这边也用不上什么摩拉，所以就全都送给你们吧。谢谢你们帮忙，接下来就让我一个人安心钓鱼吧！"
          }
        }
      }
    },
    {

        "startDialogs": [
          "710100201"
        ],
        "dialogs": {
          "710100201": {
            "id": "710100201",
            "speakerId": 1000,
            "speakerName": "遗迹宝藏",
            "text": "师兄已获『神之眼』，本应荡涤世间魔物，但他却问我，世间魔物是否生而为恶？这些魔物祸乱世间，滥害无辜，难道不是恶劣至极？我看师兄真是修炼得人都傻了！",
            "nextDialogs": [
              "710100202"
            ]
          },
          "710100202": {
            "id": "710100202",
            "speakerId": 1000,
            "speakerName": "遗迹宝藏",
            "text": "算了，就算没有『神之眼』，我一个人也能去扫清魔物！"
          }
        }
      }
    },
    {
      "subId": "7101003",
      "subQuestName": "Additional",
      "sceneId": null,

      "dialogue": {
        "startDialogs": [
          "710100301"
        ],
        "dialogs": {
          "710100301": {
            "id": "710100301",
            "speakerId": 1000,
            "speakerName": "遗迹宝藏",
            "text": "世间魔物，本就是祸害，我等习武良久，除魔卫道是本责。",
            "nextDialogs": [
              "710100302"
            ]
          },
          "710100302": {
            "id": "710100302",
            "speakerId": 1000,
            "speakerName": "遗迹宝藏",
            "text": "对付那些魔物，心中只需念着除恶务尽就是！"
          }
        }
      }
    },

  "subQuests": [
    {
      "subId": "7265401",
      "subQuestName": "与慕珍对话",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "726540101"
        ],
        "dialogs": {
          "726540101": {
            "id": "726540101",
            "speakerId": 30055,
            "speakerName": "慕珍",
            "text": "感谢你带回来的线索，现在我已经基本可以定位那些遗迹机械的所在了。",
            "nextDialogs": [
              "726540102"
            ]
          },
          "726540102": {
            "id": "726540102",
            "speakerId": 30055,
            "speakerName": "慕珍",
            "text": "不过，在此之前，我们还有一些小麻烦需要处理…",
            "nextDialogs": [
              "726540103"
            ]
          },
          "726540103": {
            "id": "726540103",
            "speakerId": 30055,
            "speakerName": "慕珍",
            "text": "附近分布的一些雷元素特异点仍然在干扰着精确定位，这些异常点的位置稍后我会告诉你…希望你能帮忙解决它们。",
            "nextDialogs": [
              "726540104"
            ]
          },
          "726540104": {
            "id": "726540104",
            "speakerId": 30055,
            "speakerName": "慕珍",
            "text": "这次还是一样，要辛苦你带回一些样本…我们收集这些东西首先自然是研究如何为我所用。",
            "nextDialogs": [
              "726540105"
            ]
          },
          "726540105": {
            "id": "726540105",
            "speakerId": 30055,
            "speakerName": "慕珍",
            "text": "其次…毕竟我们是商船队嘛，当然是好好研究一下商业价值啦！",
            "nextDialogs": [
              "726540106"
            ]
          },
          "726540106": {
            "id": "726540106",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "那你们现在成果如何？",
            "nextDialogs": [
              "726540107"
            ]
          },
          "726540107": {
            "id": "726540107",
            "speakerId": 30055,
            "speakerName": "慕珍",
            "text": "唔…你所交付的样品，善加利用的话，或许可以让「南十字」不再只依赖机动力，就能轻松躲避海上的雷暴。",
            "nextDialogs": [
              "726540108"
            ]
          },
          "726540108": {
            "id": "726540108",
            "speakerId": 30055,
            "speakerName": "慕珍",
            "text": "这样的话，来往稻妻的商路也会更加巩固，更能保障效率。",
            "nextDialogs": [
              "726540109"
            ]
          },
          "726540109": {
            "id": "726540109",
            "speakerId": 30055,
            "speakerName": "慕珍",
            "text": "不过…既然「锁国令」是将军的意志，或许我们这样做多少会让她老人家不悦吧…",
            "nextDialogs": [
              "726540110"
            ]
          },
          "726540110": {
            "id": "726540110",
            "speakerId": 30055,
            "speakerName": "慕珍",
            "text": "当然啦，最直接的研究成果，自然是通过雷元素异常增生物的「寿命」与「年龄」，估算出雷元素异常的范围与起始点。",
            "nextDialogs": [
              "726540111"
            ]
          },
          "726540111": {
            "id": "726540111",
            "speakerId": 30055,
            "speakerName": "慕珍",
            "text": "而起始点呢，就是我们的订单目标啦，神奇的古代机械生物！",
            "nextDialogs": [
              "726540112"
            ]
          },
          "726540112": {
            "id": "726540112",
            "speakerId": 30055,
            "speakerName": "慕珍",
            "text": "嘿嘿，不好意思…有点太兴奋了。",
            "nextDialogs": [
              "726540113"
            ]
          },
          "726540113": {
            "id": "726540113",
            "speakerId": 30055,
            "speakerName": "慕珍",
            "text": "好啦，为了最后一番勘测，现在就出发吧！"
          }
        }
      }
    },
    {

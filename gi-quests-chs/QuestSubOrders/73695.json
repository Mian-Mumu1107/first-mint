    {
      "subId": "7369502",
      "subQuestName": "与丹纳对话",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "736950201"
        ],
        "dialogs": {
          "736950201": {
            "id": "736950201",
            "speakerId": 1000,
            "speakerName": "丹纳",
            "text": "喔？你已经把所有「文物模型」都找到了吗？",
            "nextDialogs": [
              "736950202"
            ]
          },
          "736950202": {
            "id": "736950202",
            "speakerId": 1000,
            "speakerName": "丹纳",
            "text": "了不起！你很有考古方面的天赋嘛。",
            "nextDialogs": [
              "736950203"
            ]
          },
          "736950203": {
            "id": "736950203",
            "speakerId": 1000,
            "speakerName": "丹纳",
            "text": "那么，这份礼物就送给你了，感谢你来参加我们学院举办的活动。",
            "nextDialogs": [
              "736950204"
            ]
          },
          "736950204": {
            "id": "736950204",
            "speakerId": 1000,
            "speakerName": "丹纳",
            "text": "希望你从这次的活动里感受到了一些考古的乐趣啊，旅行者。",
            "nextDialogs": [
              "736950205"
            ]
          },
          "736950205": {
            "id": "736950205",
            "speakerId": 1000,
            "speakerName": "丹纳",
            "text": "虽然在真实的考古工作里，大部分时候都枯燥乏味又辛苦…",
            "nextDialogs": [
              "736950206"
            ]
          },
          "736950206": {
            "id": "736950206",
            "speakerId": 1000,
            "speakerName": "丹纳",
            "text": "但在挖掘到关键性文物的那一刹那，又会感觉到一切的辛苦都是值得的。",
            "nextDialogs": [
              "736950209"
            ]
          },
          "736950209": {
            "id": "736950209",
            "speakerId": 1000,
            "speakerName": "丹纳",
            "text": "没挖出来的话…那就和俗话说的一样，这一趟「白忙活」了。",
            "nextDialogs": [
              "736950210"
            ]
          },
          "736950210": {
            "id": "736950210",
            "speakerId": 1000,
            "speakerName": "丹纳",
            "text": "而且这种白忙活的情况才是常态，能顺利挖到关键性文物的次数少之又少。",
            "nextDialogs": [
              "736950211"
            ]
          },
          "736950211": {
            "id": "736950211",
            "speakerId": 1000,
            "speakerName": "丹纳",
            "text": "不过做考古工作嘛，就是要习惯这种情况，时刻保持着乐观的心态，不然工作不了多长时间，就要撑不住喽。"
          }
        }
      }
    }
  ]
}
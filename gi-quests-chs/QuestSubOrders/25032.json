    {
      "subId": "2503206",
      "subQuestName": "向子澄回报",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "250320601"
        ],
        "dialogs": {
          "250320601": {
            "id": "250320601",
            "speakerId": 14443,
            "speakerName": "子澄",
            "text": "你回来了，画片拍好了吗？",
            "nextDialogs": [
              "250320602"
            ]
          },
          "250320602": {
            "id": "250320602",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "拍好了。",
            "nextDialogs": [
              "250320603"
            ]
          },
          "250320603": {
            "id": "250320603",
            "speakerId": 14443,
            "speakerName": "子澄",
            "text": "嚯…你拍得可真好，比我的那个助手拍得好多了。他每次给勘测地点拍画片留证的时候，都要拍好几次。",
            "nextDialogs": [
              "250320604"
            ]
          },
          "250320604": {
            "id": "250320604",
            "speakerId": 14443,
            "speakerName": "子澄",
            "text": "要是你能和我一起去丈量土地，我肯定能少用坏几台留影机。",
            "nextDialogs": [
              "250320605"
            ]
          },
          "250320605": {
            "id": "250320605",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "这些画片真能用来写诗吗？",
            "nextDialogs": [
              "250320606"
            ]
          },
          "250320606": {
            "id": "250320606",
            "speakerId": 14443,
            "speakerName": "子澄",
            "text": "应该…能吧。哎呀，如果我实在写不出来，就把这些画片当成明信片。",
            "nextDialogs": [
              "250320607"
            ]
          },
          "250320607": {
            "id": "250320607",
            "speakerId": 14443,
            "speakerName": "子澄",
            "text": "在它们背面写上一些祝福的话，然后寄回总务司。那群家伙收到礼物之后，肯定也没什么话好说了！",
            "nextDialogs": [
              "250320608"
            ]
          },
          "250320608": {
            "id": "250320608",
            "speakerId": 14443,
            "speakerName": "子澄",
            "text": "咳…但是，这是没办法的办法。在那之前，我还是先想想怎么写一首好诗吧…",
            "nextDialogs": [
              "250320609"
            ]
          },
          "250320609": {
            "id": "250320609",
            "speakerId": 14443,
            "speakerName": "子澄",
            "text": "激荡…不对，鼓荡五部风云…哎哟，等等，纳塔总共有几个部族来着？"
          }
        }
      }
    },

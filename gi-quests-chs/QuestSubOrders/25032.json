  "subQuests": [
    {
      "subId": "2503201",
      "subQuestName": "与子澄对话",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "250321001"
        ],
        "dialogs": {
          "250321001": {
            "id": "250321001",
            "speakerId": 14443,
            "speakerName": "子澄",
            "text": "对了！我听人家说，「流泉之众」那边的店铺招牌很特色，其中一家好像名为「金贝乐棚」。",
            "nextDialogs": [
              "250321002"
            ]
          },
          "250321002": {
            "id": "250321002",
            "speakerId": 14443,
            "speakerName": "子澄",
            "text": "拜托你，帮我去拍摄一下清晨的「金贝乐棚」吧！"
          }
        }
      }
    },

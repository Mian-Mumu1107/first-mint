        ],
        "dialogs": {
          "726550301": {
            "id": "726550301",
            "speakerId": 30055,
            "speakerName": "慕珍",
            "text": "怎么，还需要点准备运动吗？",
            "nextDialogs": [
              "726550304"
            ]
          },
          "726550304": {
            "id": "726550304",
            "speakerId": 30055,
            "speakerName": "慕珍",
            "text": "毕竟我是航船技术官，陆地上的历史我了解的不太多，抱歉啦。",
            "nextDialogs": [
              "726550305"
            ]
          },
          "726550305": {
            "id": "726550305",
            "speakerId": 30055,
            "speakerName": "慕珍",
            "text": "不过这些遗迹，我想都与五百年前那场大灾难有关…",
            "nextDialogs": [
              "726550306"
            ]
          },
          "726550306": {
            "id": "726550306",
            "speakerId": 30055,
            "speakerName": "慕珍",
            "text": "我也是从小听老水手们提起过那场大灾，据说不论海陆都没有幸免深渊的侵袭…",
            "nextDialogs": [
              "726550307"
            ]
          },
          "726550307": {
            "id": "726550307",
            "speakerId": 30055,
            "speakerName": "慕珍",
            "text": "不过对我来说，和吓唬小孩的鬼故事差不多啦。",
            "nextDialogs": [
              "726550308"
            ]
          },
          "726550308": {
            "id": "726550308",
            "speakerId": 30055,
            "speakerName": "慕珍",
            "text": "毕竟亲眼所见的可怕，才是真的可怕！"
          }
        }
      }
    }

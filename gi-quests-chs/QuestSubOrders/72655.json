  "subQuests": [
    {
      "subId": "7265501",
      "subQuestName": "与慕珍对话",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "726550101"
        ],
        "dialogs": {
          "726550101": {
            "id": "726550101",
            "speakerId": 30055,
            "speakerName": "慕珍",
            "text": "我们终于找到目标的位置了！好耶，可以回船上睡觉了！",
            "nextDialogs": [
              "726550102"
            ]
          },
          "726550102": {
            "id": "726550102",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "欸——？这就事不关己了吗！",
            "nextDialogs": [
              "726550103"
            ]
          },
          "726550103": {
            "id": "726550103",
            "speakerId": 30055,
            "speakerName": "慕珍",
            "text": "怎么可能啦，既然离我们所需的东西只剩一步之遥了，我们现在就出发，捕猎遗迹机械吧！",
            "nextDialogs": [
              "726550104"
            ]
          },
          "726550104": {
            "id": "726550104",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "刚刚还以为你要回船上！",
            "nextDialogs": [
              "726550105"
            ]
          },
          "726550105": {
            "id": "726550105",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "唉，算了，我们也一起去吧！"
          }
        }
      }
    },
    {
      "subId": "7265502",
      "subQuestName": "前往遗迹地点",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "726550201"
        ],
        "dialogs": {
          "726550201": {
            "id": "726550201",
            "speakerId": 30055,
            "speakerName": "慕珍",
            "text": "哈哈，就是这里啦！",
            "nextDialogs": [
              "726550202"
            ]
          },
          "726550202": {
            "id": "726550202",
            "speakerId": 30055,
            "speakerName": "慕珍",
            "text": "原来在这里也有地下遗迹…唔。",
            "nextDialogs": [
              "726550205"
            ]
          },
          "726550205": {
            "id": "726550205",
            "speakerId": 30055,
            "speakerName": "慕珍",
            "text": "没、没什么。",
            "nextDialogs": [
              "726550206"
            ]
          },
          "726550206": {
            "id": "726550206",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "咦，是身体不舒服了吗？",
            "nextDialogs": [
              "726550207"
            ]
          },
          "726550207": {
            "id": "726550207",
            "speakerId": 30055,
            "speakerName": "慕珍",
            "text": "哈哈，我平时不怎么下船，看到遗迹入口这种大场面，还有点心虚罢了。",
            "nextDialogs": [
              "726550208"
            ]
          },
          "726550208": {
            "id": "726550208",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "这算什么大场面啦！",
            "nextDialogs": [
              "726550209"
            ]
          },
          "726550209": {
            "id": "726550209",
            "speakerId": 30055,
            "speakerName": "慕珍",
            "text": "好啦，大姐头的订单还等着完成，想必旅行者你也很好奇遗迹里潜藏的秘密吧！",
            "nextDialogs": [
              "726550210"
            ]
          },
          "726550210": {
            "id": "726550210",
            "speakerId": 30055,
            "speakerName": "慕珍",
            "text": "所以，就请冒险经验丰富的旅行者来打头阵吧？",
            "nextDialogs": [
              "726550211"
            ]
          },
          "726550211": {
            "id": "726550211",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "真拿你没办法…",
            "nextDialogs": [
              "726550212"
            ]
          },
          "726550212": {
            "id": "726550212",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "真是拿你没办法，我们走吧！"
          }
        }
      }
    },

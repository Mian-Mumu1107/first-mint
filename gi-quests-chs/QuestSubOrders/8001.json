{
  "lineCounts": {
    "Player": 43,
    "戴因斯雷布": 74,
    "派蒙": 57
  },
  "subQuests": [
    {
      "subId": "800101",
      "subQuestName": "与戴因对话",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "80010101"
        ],
        "dialogs": {
          "80010101": {
            "id": "80010101",
            "speakerId": 1022,
            "speakerName": "戴因斯雷布",
            "text": "重逢…比我想象的来得更早些。",
            "nextDialogs": [
              "80010102"
            ]
          },
          "80010102": {
            "id": "80010102",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "呀，是戴因！",
            "nextDialogs": [
              "80010103"
            ]
          },
          "80010103": {
            "id": "80010103",
            "speakerId": 1022,
            "speakerName": "戴因斯雷布",
            "text": "看你们的表情，好像刚经历过什么怪异的事。",
            "nextDialogs": [
              "80010104"
            ]
          },
          "80010104": {
            "id": "80010104",
            "speakerId": 1022,
            "speakerName": "戴因斯雷布",
            "text": "难道是在那座遗迹里，和「深渊使徒」打过照面了？",
            "nextDialogs": [
              "80010105"
            ]
          },
          "80010105": {
            "id": "80010105",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "欸，戴因怎么会知道？！",
            "nextDialogs": [
              "80010106"
            ]
          },
          "80010106": {
            "id": "80010106",
            "speakerId": 1022,
            "speakerName": "戴因斯雷布",
            "text": "我仍在继续追猎「深渊使徒」，也没料到会在这里遇上你们。",
            "nextDialogs": [
              "80010109"
            ]
          },
          "80010109": {
            "id": "80010109",
            "speakerId": 1022,
            "speakerName": "戴因斯雷布",
            "text": "倒挂的神像…手中的深渊能量？不，我在与深渊对抗时，也没见过类似的事物。但…我有所猜测。",
            "nextDialogs": [
              "80010110"
            ]
          },
          "80010110": {
            "id": "80010110",
            "speakerId": 1022,
            "speakerName": "戴因斯雷布",
            "text": "先把你们的经历说完吧。你们逃离了深渊能量弥漫的遗迹底层，然后呢？",
            "nextDialogs": [
              "80010111"
            ]
          },
          "80010111": {
            "id": "80010111",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "然后我们在接近遗迹出口的时候，被突然出现的「深渊使徒」拦截了。",
            "nextDialogs": [
              "80010112"
            ]
          },
          "80010112": {
            "id": "80010112",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "我们和那家伙大战了一番，说不定它现在还没走远？",
            "nextDialogs": [
              "80010113"
            ]
          },
          "80010113": {
            "id": "80010113",
            "speakerId": 1022,
            "speakerName": "戴因斯雷布",
            "text": "嗯，机会难得，随我一起追上去吧。"
          }
        }
      }
    },
    {
      "subId": "800102",
      "subQuestName": "追查深渊教团的踪迹",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "80010201"
        ],
        "dialogs": {
          "80010201": {
            "id": "80010201",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "刚才那些深渊法师…是准备埋伏我们的吗？",
            "nextDialogs": [
              "80010202"
            ]
          },
          "80010202": {
            "id": "80010202",
            "speakerId": 1022,
            "speakerName": "戴因斯雷布",
            "text": "不，他们只是在那些遗迹守卫的遗骸里，翻找着什么东西而已。",
            "nextDialogs": [
              "80010203"
            ]
          },
          "80010203": {
            "id": "80010203",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "是这样吗…旅行者好像也经常这么做呢…",
            "nextDialogs": [
              "80010204"
            ]
          },
          "80010204": {
            "id": "80010204",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "什么「混沌装置」、「混沌回路」之类的。",
            "nextDialogs": [
              "80010207"
            ]
          },
          "80010207": {
            "id": "80010207",
            "speakerId": 1022,
            "speakerName": "戴因斯雷布",
            "text": "不会是这么普通的东西。",
            "nextDialogs": [
              "80010208"
            ]
          },
          "80010208": {
            "id": "80010208",
            "speakerId": 1022,
            "speakerName": "戴因斯雷布",
            "text": "我之所以在附近调查，就是因为从那座遗迹里，时不时会有深渊法师外出探索。",
            "nextDialogs": [
              "80010209"
            ]
          },
          "80010209": {
            "id": "80010209",
            "speakerId": 1022,
            "speakerName": "戴因斯雷布",
            "text": "它们似乎是想要从遗迹守卫的遗骸中，找到一件「特定的珍贵之物」，带回遗迹。",
            "nextDialogs": [
              "80010210"
            ]
          },
          "80010210": {
            "id": "80010210",
            "speakerId": 1022,
            "speakerName": "戴因斯雷布",
            "text": "不过，看它们失望的样子，至少目前应该还没找到…",
            "nextDialogs": [
              "80010211"
            ]
          },
          "80010211": {
            "id": "80010211",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "那么刚才怎么不抓住它们好好问问呢？"
          }
        }
      }
    },
    {
      "subId": "800103",
      "subQuestName": "与戴因对话",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [],
        "dialogs": {}
      }
    },
    {
      "subId": "800104",
      "subQuestName": "追查深渊教团的踪迹",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "80010401"
        ],
        "dialogs": {
          "80010401": {
            "id": "80010401",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "欸，从这个深渊法师身上冒出的这段符咒是…难道会是「信」吗？",
            "nextDialogs": [
              "80010402"
            ]
          },
          "80010402": {
            "id": "80010402",
            "speakerId": 1022,
            "speakerName": "戴因斯雷布",
            "text": "嗯，这股气息，无疑与「深渊使徒」有关。既然带在深渊法师身上…",
            "nextDialogs": [
              "80010403"
            ]
          },
          "80010403": {
            "id": "80010403",
            "speakerId": 1022,
            "speakerName": "戴因斯雷布",
            "text": "或许，真的会有关于它们行动的信息。",
            "nextDialogs": [
              "80010404"
            ]
          },
          "80010404": {
            "id": "80010404",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "可是，上面的文字好像读不懂欸，是坎瑞亚的文字吗？",
            "nextDialogs": [
              "80010405"
            ]
          },
          "80010405": {
            "id": "80010405",
            "speakerId": 1022,
            "speakerName": "戴因斯雷布",
            "text": "#「…将敌人的信仰作为薪柴，为高贵的{PLAYERAVATAR#SEXPRO[INFO_MALE_PRONOUN_GIRLD|INFO_FEMALE_PRONOUN_BOYD]}殿下献上荣光…」",
            "nextDialogs": [
              "80010406"
            ]
          },
          "80010406": {
            "id": "80010406",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "啊，这是…信里的内容？",
            "nextDialogs": [
              "80010407"
            ]
          },
          "80010407": {
            "id": "80010407",
            "speakerId": 1022,
            "speakerName": "戴因斯雷布",
            "text": "「——『命运的织机』，原动计划。」",
            "nextDialogs": [
              "80010408"
            ]
          },
          "80010408": {
            "id": "80010408",
            "speakerId": 1022,
            "speakerName": "戴因斯雷布",
            "text": "它们…「深渊」，似乎正在执行一个计划。计划的关键词是…「命运的织机」。",
            "nextDialogs": [
              "80010409"
            ]
          },
          "80010409": {
            "id": "80010409",
            "speakerId": 1022,
            "speakerName": "戴因斯雷布",
            "text": "目前似乎还在启动阶段，或者说，还在进行最初的试验…",
            "nextDialogs": [
              "80010410"
            ]
          },
          "80010410": {
            "id": "80010410",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "「命运的织机」？那是什么？字面意思感觉是…「纺织命运的机器」？",
            "nextDialogs": [
              "80010413"
            ]
          },
          "80010413": {
            "id": "80010413",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "欸，这么一说，从气氛上讲，那座诡异的遗迹，和这个计划有关联的可能性很大呢。",
            "nextDialogs": [
              "80010414"
            ]
          },
          "80010414": {
            "id": "80010414",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "所以戴因，信里面究竟是怎么讲的呀？",
            "nextDialogs": [
              "80010415"
            ]
          },
          "80010415": {
            "id": "80010415",
            "speakerId": 1022,
            "speakerName": "戴因斯雷布",
            "text": "我正在读…",
            "nextDialogs": [
              "80010416"
            ]
          },
          "80010416": {
            "id": "80010416",
            "speakerId": 1022,
            "speakerName": "戴因斯雷布",
            "text": "嗯…天马行空的计划，也有些难以理解的部分。",
            "nextDialogs": [
              "80010417"
            ]
          },
          "80010417": {
            "id": "80010417",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "怎么？",
            "nextDialogs": [
              "80010418"
            ]
          },
          "80010418": {
            "id": "80010418",
            "speakerId": 1022,
            "speakerName": "戴因斯雷布",
            "text": "一言以概之，初步的计划，与「漩涡之魔神」奥赛尔有关。",
            "nextDialogs": [
              "80010419"
            ]
          },
          "80010419": {
            "id": "80010419",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "「漩涡之魔神」！是海里的那个魔神吗！"
          }
        }
      }
    },
    {
      "subId": "800105",
      "subQuestName": "与戴因对话",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "80010301"
        ],
        "dialogs": {
          "80010301": {
            "id": "80010301",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "呼…除了深渊教团，遗迹守卫在这一带也很活跃呢…",
            "nextDialogs": [
              "80010302"
            ]
          },
          "80010302": {
            "id": "80010302",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "感觉深渊法师蛰伏的地方，也经常会有遗迹守卫游荡，这是什么巧合吗？",
            "nextDialogs": [
              "80010303"
            ]
          },
          "80010303": {
            "id": "80010303",
            "speakerId": 1022,
            "speakerName": "戴因斯雷布",
            "text": "世上没有什么巧合，一切都是在久远的过去埋下的种子。",
            "nextDialogs": [
              "80010304"
            ]
          },
          "80010304": {
            "id": "80010304",
            "speakerId": 1022,
            "speakerName": "戴因斯雷布",
            "text": "就像那间酒馆里你的出现一样…时间只是等它发芽。",
            "nextDialogs": [
              "80010307"
            ]
          },
          "80010307": {
            "id": "80010307",
            "speakerId": 1022,
            "speakerName": "戴因斯雷布",
            "text": "没事，一些不必要的感慨。",
            "nextDialogs": [
              "80010308"
            ]
          },
          "80010308": {
            "id": "80010308",
            "speakerId": 1022,
            "speakerName": "戴因斯雷布",
            "text": "深渊教团和遗迹守卫的联系，当然不是巧合。",
            "nextDialogs": [
              "80010309"
            ]
          },
          "80010309": {
            "id": "80010309",
            "speakerId": 1022,
            "speakerName": "戴因斯雷布",
            "text": "应该说，是同一根系延展而出的枝杈。",
            "nextDialogs": [
              "80010310"
            ]
          },
          "80010310": {
            "id": "80010310",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "根系？枝杈？你的意思是…",
            "nextDialogs": [
              "80010311"
            ]
          },
          "80010311": {
            "id": "80010311",
            "speakerId": 1022,
            "speakerName": "戴因斯雷布",
            "text": "它们都源自五百年前覆灭的古国——「坎瑞亚」。",
            "nextDialogs": [
              "80010312"
            ]
          },
          "80010312": {
            "id": "80010312",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "欸？坎瑞亚？！",
            "nextDialogs": [
              "80010313"
            ]
          },
          "80010313": {
            "id": "80010313",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "居然是这样…深渊教团和遗迹守卫，居然是坎瑞亚灭国之后的残余吗？！",
            "nextDialogs": [
              "80010314"
            ]
          },
          "80010314": {
            "id": "80010314",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "说到坎瑞亚，那真是一个非常久远的名字了…",
            "nextDialogs": [
              "80010315"
            ]
          },
          "80010315": {
            "id": "80010315",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "哦，对了。作为向导，我还是跟旅行者解释一下吧。「坎瑞亚」这个国度，是…",
            "nextDialogs": [
              "80010316"
            ]
          },
          "80010316": {
            "id": "80010316",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "我知道「坎瑞亚」这个名字。",
            "nextDialogs": [
              "80010317"
            ]
          },
          "80010317": {
            "id": "80010317",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "欸…？",
            "nextDialogs": [
              "80010318"
            ]
          },
          "80010318": {
            "id": "80010318",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "因为，我有在坎瑞亚的记忆。",
            "nextDialogs": [
              "80010319"
            ]
          },
          "80010319": {
            "id": "80010319",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "你有记忆？可那是五百年前就已经覆灭的国度…",
            "nextDialogs": [
              "80010320"
            ]
          },
          "80010320": {
            "id": "80010320",
            "speakerId": 1022,
            "speakerName": "戴因斯雷布",
            "text": "……",
            "nextDialogs": [
              "80010321"
            ]
          },
          "80010321": {
            "id": "80010321",
            "speakerId": 1022,
            "speakerName": "戴因斯雷布",
            "text": "是吗，人皆有秘密，你没有追问过我时间的事，我也不会追问你…",
            "nextDialogs": [
              "80010322"
            ]
          },
          "80010322": {
            "id": "80010322",
            "speakerId": 1022,
            "speakerName": "戴因斯雷布",
            "text": "但若你愿意对我说，我也会听。那么——你所见到的坎瑞亚，是怎样的一副景象？"
          }
        }
      }
    },
    {
      "subId": "800109",
      "subQuestName": "追查深渊教团的踪迹",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [],
        "dialogs": {}
      }
    },
    {
      "subId": "800108",
      "subQuestName": "与戴因对话",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "80010501"
        ],
        "dialogs": {
          "80010501": {
            "id": "80010501",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "看那边，又是遗迹守卫和深渊法师。",
            "nextDialogs": [
              "80010502"
            ]
          },
          "80010502": {
            "id": "80010502",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "戴因刚才说，这些古代机器也是源于坎瑞亚…",
            "nextDialogs": [
              "80010503"
            ]
          },
          "80010503": {
            "id": "80010503",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "莫非，坎瑞亚有很多遗迹需要保护？",
            "nextDialogs": [
              "80010504"
            ]
          },
          "80010504": {
            "id": "80010504",
            "speakerId": 1022,
            "speakerName": "戴因斯雷布",
            "text": "不。「遗迹守卫」这个名字，是现代人根据现代的「印象」取的。五百年前没有人这样称呼它们。",
            "nextDialogs": [
              "80010505"
            ]
          },
          "80010505": {
            "id": "80010505",
            "speakerId": 1022,
            "speakerName": "戴因斯雷布",
            "text": "现在被称作遗迹守卫的这些机器，当年在坎瑞亚的代号是，「耕地机」。",
            "nextDialogs": [
              "80010506"
            ]
          },
          "80010506": {
            "id": "80010506",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "耕地机？好奇怪的名字。",
            "nextDialogs": [
              "80010509"
            ]
          },
          "80010509": {
            "id": "80010509",
            "speakerId": 1022,
            "speakerName": "戴因斯雷布",
            "text": "并不是你们想的那样。所谓「耕地机」，其实是一种代号。当年的坎瑞亚人会为兵器创造代号。",
            "nextDialogs": [
              "80010510"
            ]
          },
          "80010510": {
            "id": "80010510",
            "speakerId": 1022,
            "speakerName": "戴因斯雷布",
            "text": "「土地不是用农具去犁的，而是用铁与血去争夺的。」——基于这样的理念，「耕地机」诞生了。",
            "nextDialogs": [
              "80010511"
            ]
          },
          "80010511": {
            "id": "80010511",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "用铁与血去争夺土地？坎瑞亚人居然这样理解「耕地」…感觉不是什么好的含义呢。",
            "nextDialogs": [
              "80010512"
            ]
          },
          "80010512": {
            "id": "80010512",
            "speakerId": 1022,
            "speakerName": "戴因斯雷布",
            "text": "……",
            "nextDialogs": [
              "80010513"
            ]
          },
          "80010513": {
            "id": "80010513",
            "speakerId": 1022,
            "speakerName": "戴因斯雷布",
            "text": "在坎瑞亚覆灭以后，这些失去主人的「耕地机」便纷纷脱离了控制。",
            "nextDialogs": [
              "80010514"
            ]
          },
          "80010514": {
            "id": "80010514",
            "speakerId": 1022,
            "speakerName": "戴因斯雷布",
            "text": "在漫长的时光中不断游荡，逐渐散落在了提瓦特大陆的各个角落。",
            "nextDialogs": [
              "80010515"
            ]
          },
          "80010515": {
            "id": "80010515",
            "speakerId": 1022,
            "speakerName": "戴因斯雷布",
            "text": "可能是与同样覆灭了的其它古文明，同病相怜的缘故，它们才常常驻留在各类遗迹中，休眠假寐。",
            "nextDialogs": [
              "80010516"
            ]
          },
          "80010516": {
            "id": "80010516",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "听上去…感觉很可怜…"
          }
        }
      }

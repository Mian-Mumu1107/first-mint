  "subQuests": [
    {
      "subId": "2204901",
      "subQuestName": "与长野原龙之介对话",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "220490101"
        ],
        "dialogs": {
          "220490101": {
            "id": "220490101",
            "speakerId": 3035,
            "speakerName": "长野原龙之介",
            "text": "哦呀，这不是丫头的新朋友吗？今天又来玩啦。",
            "nextDialogs": [
              "220490103",
              "220490106"
            ]
          },
          "220490103": {
            "id": "220490103",
            "speakerId": 3035,
            "speakerName": "长野原龙之介",
            "text": "很好，很好！哈哈哈，都是我那丫头把烟花鼓捣得好啊！",
            "nextDialogs": [
              "220490104"
            ]
          },
          "220490104": {
            "id": "220490104",
            "speakerId": 3035,
            "speakerName": "长野原龙之介",
            "text": "你们今天，是来找她的吗？",
            "nextDialogs": [
              "220490107"
            ]
          },
          "220490107": {
            "id": "220490107",
            "speakerId": 3035,
            "speakerName": "长野原龙之介",
            "text": "真不巧，那丫头说，她要去外面找做烟花的材料，已经出门去啦！",
            "nextDialogs": [
              "220490108"
            ]
          },
          "220490108": {
            "id": "220490108",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "那她去哪了？",
            "nextDialogs": [
              "220490109"
            ]
          },
          "220490109": {
            "id": "220490109",
            "speakerId": 3035,
            "speakerName": "长野原龙之介",
            "text": "什、什么？你说什么？",
            "nextDialogs": [
              "220490110"
            ]
          },
          "220490110": {
            "id": "220490110",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "宵宫，她去哪里了！",
            "nextDialogs": [
              "220490111"
            ]
          },
          "220490111": {
            "id": "220490111",
            "speakerId": 3035,
            "speakerName": "长野原龙之介",
            "text": "喔，哎呀…这个我可不太清楚哟，那丫头也许说过了，但我这耳朵啊，真是听不清…",
            "nextDialogs": [
              "220490112"
            ]
          },
          "220490112": {
            "id": "220490112",
            "speakerId": 3035,
            "speakerName": "长野原龙之介",
            "text": "你们找那丫头有什么事吗？是想要，买点烟花玩玩？"
          },
          "220490106": {
            "id": "220490106",
            "speakerId": 3035,
            "speakerName": "长野原龙之介",
            "text": "哎呀，你们今天是来找她的吗？"
          }
        }
      }
    },
    {
      "subId": "2204902",
      "subQuestName": "去城外试玩烟花",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "220490201"
        ],
        "dialogs": {
          "220490201": {
            "id": "220490201",
            "speakerId": 3035,
            "speakerName": "长野原龙之介",
            "text": "快点去吧，你们放烟花的时候可要在城外放。在城里放烟花啊，又要招来好些人了…"
          }
        }
      }
    },
    {
      "subId": "2204903",
      "subQuestName": "向长野原龙之介回报",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "220490301"
        ],
        "dialogs": {
          "220490301": {
            "id": "220490301",
            "speakerId": 3035,
            "speakerName": "长野原龙之介",
            "text": "你们回来了，烟花怎么样？",
            "nextDialogs": [
              "220490303",
              "220490305"
            ]
          },
          "220490303": {
            "id": "220490303",
            "speakerId": 3035,
            "speakerName": "长野原龙之介",
            "text": "你们喜欢就好，哈哈哈。",
            "nextDialogs": [
              "220490306"
            ]
          },
          "220490306": {
            "id": "220490306",
            "speakerId": 3035,
            "speakerName": "长野原龙之介",
            "text": "好了，我也该去打理打理店里了，最近来买烟花的人真是越来越多了。",
            "nextDialogs": [
              "220490307"
            ]
          },
          "220490307": {
            "id": "220490307",
            "speakerId": 3035,
            "speakerName": "长野原龙之介",
            "text": "那丫头怎么到现在还没回来，到底去哪鼓捣了…"
          },
          "220490305": {
            "id": "220490305",
            "speakerId": 3035,
            "speakerName": "长野原龙之介",
            "text": "你们很喜欢吗？那就好，下次你们再来拿点去玩吧。"
          }
        }
      }
    }
  ]
}
{
  "lineCounts": {
    "Player": 17,
    "凯瑟琳": 6,
    "帕特里克": 35,
    "派蒙": 24
  },
  "subQuests": [
    {
      "subId": "7166401",
      "subQuestName": "前往璃月的冒险家协会",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "716640101"
        ],
        "dialogs": {
          "716640101": {
            "id": "716640101",
            "speakerId": 1000,
            "speakerName": "凯瑟琳",
            "text": "总算等到你了，旅行者。",
            "nextDialogs": [
              "716640102"
            ]
          },
          "716640102": {
            "id": "716640102",
            "speakerId": 1000,
            "speakerName": "凯瑟琳",
            "text": "最近冒险家协会接到了一份相当重要的委托，根据我的经验，你是最合适的人选。",
            "nextDialogs": [
              "716640105"
            ]
          },
          "716640105": {
            "id": "716640105",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "不用这么客气啦，凯瑟琳小姐，我们早就习惯了！",
            "nextDialogs": [
              "716640106"
            ]
          },
          "716640106": {
            "id": "716640106",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "如果委托的报酬不够丰厚，凯瑟琳小姐也不会来麻烦我们的，对吧？",
            "nextDialogs": [
              "716640107"
            ]
          },
          "716640107": {
            "id": "716640107",
            "speakerId": 1000,
            "speakerName": "凯瑟琳",
            "text": "咳咳，倒也没错呢…不愧是你们，每次都这么爽快。",
            "nextDialogs": [
              "716640108"
            ]
          },
          "716640108": {
            "id": "716640108",
            "speakerId": 1000,
            "speakerName": "凯瑟琳",
            "text": "那我就直说好了，这次的委托人名叫帕特里克，是一位来自枫丹的科研专家。",
            "nextDialogs": [
              "716640109"
            ]
          },
          "716640109": {
            "id": "716640109",
            "speakerId": 1000,
            "speakerName": "凯瑟琳",
            "text": "他希望能雇佣几位助手，帮助他进行科研，目前他正在层岩巨渊外围进行考察。",
            "nextDialogs": [
              "716640110"
            ]
          },
          "716640110": {
            "id": "716640110",
            "speakerId": 1000,
            "speakerName": "凯瑟琳",
            "text": "虽然不清楚科研的详细内容，但你们对这种委托已经是轻车熟路了吧。",
            "nextDialogs": [
              "716640111"
            ]
          },
          "716640111": {
            "id": "716640111",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "确实如此…",
            "nextDialogs": [
              "716640112"
            ]
          },
          "716640112": {
            "id": "716640112",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "那就按照惯例办事吧，我们先去层岩巨渊附近看看！"
          }
        }
      }
    },
    {
      "subId": "7166402",
      "subQuestName": "前往层岩巨渊外围，寻找帕特里克",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "716640201"
        ],
        "dialogs": {
          "716640201": {
            "id": "716640201",
            "speakerId": 1002,
            "speakerName": "帕特里克",
            "text": "不能再拖延下去了，必须尽快进入验证环节…实在不行，我就只能亲自上阵了。",
            "nextDialogs": [
              "716640202"
            ]
          },
          "716640202": {
            "id": "716640202",
            "speakerId": 1002,
            "speakerName": "帕特里克",
            "text": "「意外受伤，被迫中止研究。」靠这个借口应该能多拖延一会儿…",
            "nextDialogs": [
              "716640203"
            ]
          },
          "716640203": {
            "id": "716640203",
            "speakerId": 1002,
            "speakerName": "帕特里克",
            "text": "反正只要不把命给搭上，就比回去接受审判要划算！",
            "nextDialogs": [
              "716640204"
            ]
          },
          "716640204": {
            "id": "716640204",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "#他在这里自言自语什么呢？打个招呼吧，{NICKNAME}。",
            "nextDialogs": [
              "716640205"
            ]
          },
          "716640205": {
            "id": "716640205",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "你好，请问是帕特里克先生吗？",
            "nextDialogs": [
              "716640206"
            ]
          },
          "716640206": {
            "id": "716640206",
            "speakerId": 1002,
            "speakerName": "帕特里克",
            "text": "吓死我了！你们两个是从哪冒出来的…怎么还知道我的名字？",
            "nextDialogs": [
              "716640207"
            ]
          },
          "716640207": {
            "id": "716640207",
            "speakerId": 1002,
            "speakerName": "帕特里克",
            "text": "等等，你们不会也是便衣的千岩军吧？还要来驱赶我吗？我已经出示过实地考察的许可了！",
            "nextDialogs": [
              "716640208"
            ]
          },
          "716640208": {
            "id": "716640208",
            "speakerId": 1002,
            "speakerName": "帕特里克",
            "text": "我保证，绝对不会深入禁区的！不信你去问那位杀气腾腾的、黑色短发的小姐！",
            "nextDialogs": [
              "716640209"
            ]
          },
          "716640209": {
            "id": "716640209",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "虽然不知道你说的人是谁，但别紧张啦。",
            "nextDialogs": [
              "716640210"
            ]
          },
          "716640210": {
            "id": "716640210",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "我们是友善、专业的冒险家。我们接到了协会的委托，来帮你解决麻烦啦。",
            "nextDialogs": [
              "716640211"
            ]
          },
          "716640211": {
            "id": "716640211",
            "speakerId": 1002,
            "speakerName": "帕特里克",
            "text": "原来是救兵？太好了！你们总算到了，我的研究项目终于有救了，要不然我早晚有一天要被它害死…",
            "nextDialogs": [
              "716640212"
            ]
          },
          "716640212": {
            "id": "716640212",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "看来你被你的研究项目给折磨得不轻啊。",
            "nextDialogs": [
              "716640213"
            ]
          },
          "716640213": {
            "id": "716640213",
            "speakerId": 1002,
            "speakerName": "帕特里克",
            "text": "这是什么话！研究这一行为本身是神圣而高洁的！折磨我的只是一些「附加因素」罢了。",
            "nextDialogs": [
              "716640214"
            ]
          },
          "716640214": {
            "id": "716640214",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "「附加因素」？比如说？",
            "nextDialogs": [
              "716640215"
            ]
          },
          "716640215": {
            "id": "716640215",
            "speakerId": 1002,
            "speakerName": "帕特里克",
            "text": "科研失败就会死。",
            "nextDialogs": [
              "716640216"
            ]
          },
          "716640216": {
            "id": "716640216",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "……？",
            "nextDialogs": [
              "716640219"
            ]
          },
          "716640219": {
            "id": "716640219",
            "speakerId": 1002,
            "speakerName": "帕特里克",
            "text": "唉，我可没在开玩笑。",
            "nextDialogs": [
              "716640220"
            ]
          },
          "716640220": {
            "id": "716640220",
            "speakerId": 1002,
            "speakerName": "帕特里克",
            "text": "独立的研究者进行科研需要申请资金，只要使用这笔资金，就等于承担了枫丹的社会责任。",
            "nextDialogs": [
              "716640221"
            ]
          },
          "716640221": {
            "id": "716640221",
            "speakerId": 1002,
            "speakerName": "帕特里克",
            "text": "花费了大笔资金还没能取得成果，就无异于罪人，可是会被审判的！",
            "nextDialogs": [
              "716640222"
            ]
          },
          "716640222": {
            "id": "716640222",
            "speakerId": 1002,
            "speakerName": "帕特里克",
            "text": "要是我空手而归，等待着我的大概不止「浪费公共财产」，还有占用「学术资源」等好几十项罪名。",
            "nextDialogs": [
              "716640223"
            ]
          },
          "716640223": {
            "id": "716640223",
            "speakerId": 1002,
            "speakerName": "帕特里克",
            "text": "这些罪名会给我带来最严重的惩罚…财产亏空，身败名裂还是小事，被审判的话，真的有可能会死掉！",
            "nextDialogs": [
              "716640224"
            ]
          },
          "716640224": {
            "id": "716640224",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "欸？这也太过分了吧！",
            "nextDialogs": [
              "716640225"
            ]
          },
          "716640225": {
            "id": "716640225",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "所以你才那么慌张，花一大笔钱聘请助手么？"
          }
        }
      }
    }
  ]
}
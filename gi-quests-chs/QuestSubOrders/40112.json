      }
    },
    {
      "subId": "4011202",
      "subQuestName": "与骑士团众人交谈",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "401120201"
        ],
        "dialogs": {
          "401120201": {
            "id": "401120201",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "琴团长，我们来啦——",
            "nextDialogs": [
              "401120202"
            ]
          },
          "401120202": {
            "id": "401120202",
            "speakerId": 1006,
            "speakerName": "琴",
            "text": "两位好，等你们多时了。",
            "nextDialogs": [
              "401120203"
            ]
          },
          "401120203": {
            "id": "401120203",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "哇，出现在这里的人比我想象中要多…竟然还有小可莉和凯亚…",
            "nextDialogs": [
              "401120204"
            ]
          },
          "401120204": {
            "id": "401120204",
            "speakerId": 10090,
            "speakerName": "可莉",
            "text": "#原来是小派蒙和荣誉骑士{M#哥哥}{F#姐姐}！好久不见！",
            "nextDialogs": [
              "401120205"
            ]
          },
          "401120205": {
            "id": "401120205",
            "speakerId": 1004,
            "speakerName": "凯亚",
            "text": "哎哟，没想到是你们。",
            "nextDialogs": [
              "401120206"
            ]
          },
          "401120206": {
            "id": "401120206",
            "speakerId": 1004,
            "speakerName": "凯亚",
            "text": "真是让人措手不及…该怎么说，两位的出现总是会带来意想不到的惊喜。",
            "nextDialogs": [
              "401120207"
            ]
          },
          "401120207": {
            "id": "401120207",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "嘿嘿，一想到能见老朋友，兴奋得忘记敲门了，没吓到你们吧？",
            "nextDialogs": [
              "401120208"
            ]
          },
          "401120208": {
            "id": "401120208",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "等等，你们不会是在聊什么我们不该听到的机密吧！",
            "nextDialogs": [
              "401120210",
              "401120212"
            ]
          },
          "401120210": {
            "id": "401120210",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "好狡猾，居然一下子就装成了猎鹿人餐馆的送餐员！",
            "nextDialogs": [
              "401120213"
            ]
          },
          "401120213": {
            "id": "401120213",
            "speakerId": 1006,
            "speakerName": "琴",
            "text": "#许久不见，派蒙和{NICKNAME}的关系还是一如既往的融洽。",
            "nextDialogs": [
              "401120214"
            ]
          },
          "401120214": {
            "id": "401120214",
            "speakerId": 1006,
            "speakerName": "琴",
            "text": "请别担心，我们没在谈什么机密话题。",
            "nextDialogs": [
              "401120215"
            ]
          },
          "401120215": {
            "id": "401120215",
            "speakerId": 1006,
            "speakerName": "琴",
            "text": "不如说，我们正好谈到你们几位…",
            "nextDialogs": [
              "401120216"
            ]
          },
          "401120216": {
            "id": "401120216",
            "speakerId": 1004,
            "speakerName": "凯亚",
            "text": "就让事件的主角亲自讲讲吧？",
            "nextDialogs": [
              "401120217"
            ]
          },
          "401120217": {
            "id": "401120217",
            "speakerId": 10090,
            "speakerName": "可莉",
            "text": "嗯嗯，可莉来说！",
            "nextDialogs": [
              "401120218"
            ]
          },
          "401120218": {
            "id": "401120218",
            "speakerId": 10090,
            "speakerName": "可莉",
            "text": "前几天，可莉在禁闭室里读《嘟嘟可故事集》的时候…从窗户外飞来了一封信。",
            "nextDialogs": [
              "401120219"
            ]
          },
          "401120219": {
            "id": "401120219",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "一封信，信要怎么飞呀？",
            "nextDialogs": [
              "401120220"
            ]
          },
          "401120220": {
            "id": "401120220",
            "speakerId": 10090,
            "speakerName": "可莉",
            "text": "像小鸟一样，扇动着翅膀就进来了，它还会说话呢！",
            "nextDialogs": [
              "401120221"
            ]
          },
          "401120221": {
            "id": "401120221",
            "speakerId": 10090,
            "speakerName": "可莉",
            "text": "说了一些…嗯，说了一些不明白的话…",
            "nextDialogs": [
              "401120222"
            ]
          },
          "401120222": {
            "id": "401120222",
            "speakerId": 1004,
            "speakerName": "凯亚",
            "text": "不明白的话？我猜应该是提到什么禁闭室之类的…",
            "nextDialogs": [
              "401120223"
            ]
          },
          "401120223": {
            "id": "401120223",
            "speakerId": 1006,
            "speakerName": "琴",
            "text": "呃…凯亚…",
            "nextDialogs": [
              "401120224"
            ]
          },
          "401120224": {
            "id": "401120224",
            "speakerId": 1004,
            "speakerName": "凯亚",
            "text": "适当的教育指导很有意义哦。",
            "nextDialogs": [
              "401120225"
            ]
          },
          "401120225": {
            "id": "401120225",
            "speakerId": 10090,
            "speakerName": "可莉",
            "text": "呜，好吧，那封信开头说的是：「可莉呀，你怎么又在禁闭室了…」对不起嘛。",
            "nextDialogs": [
              "401120226"
            ]
          },
          "401120226": {
            "id": "401120226",
            "speakerId": 10090,
            "speakerName": "可莉",
            "text": "上面还写着：「最近妈妈有事要忙，没法带你出去玩，不过妈妈有个朋友很欢迎你，邀请你到她家去做客哦！」",
            "nextDialogs": [
              "401120227"
            ]
          },
          "401120227": {
            "id": "401120227",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "啊，是艾莉丝女士！",
            "nextDialogs": [
              "401120228"
            ]
          },
          "401120228": {
            "id": "401120228",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "这不是挺好的嘛。",
            "nextDialogs": [
              "401120229"
            ]
          },
          "401120229": {
            "id": "401120229",
            "speakerId": 1006,
            "speakerName": "琴",
            "text": "按理说应该不会有什么危险，但要去的地方…实在是有点远。",
            "nextDialogs": [
              "401120230"
            ]
          },
          "401120230": {
            "id": "401120230",
            "speakerId": 10090,
            "speakerName": "可莉",
            "text": "嗯，信上说，妈妈朋友的家在须弥…",
            "nextDialogs": [
              "401120231"
            ]
          },
          "401120231": {
            "id": "401120231",
            "speakerId": 1004,
            "speakerName": "凯亚",
            "text": "骑士团自然不可能同意可莉一个人去须弥，但可莉出门拜访那位朋友的意愿也很坚定。",
            "nextDialogs": [
              "401120232"
            ]
          },
          "401120232": {
            "id": "401120232",
            "speakerId": 10090,
            "speakerName": "可莉",
            "text": "对！",
            "nextDialogs": [
              "401120233"
            ]
          },
          "401120233": {
            "id": "401120233",
            "speakerId": 1004,
            "speakerName": "凯亚",
            "text": "于是我们想，谁能一起出远门呢？假如有一位可靠的英雄，甚至一度拯救过蒙德——",
            "nextDialogs": [
              "401120234"
            ]
          },
          "401120234": {
            "id": "401120234",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "喔！原来就是因为这个把我们叫过来的。",
            "nextDialogs": [
              "401120235"
            ]
          },
          "401120235": {
            "id": "401120235",
            "speakerId": 1006,
            "speakerName": "琴",
            "text": "#非常抱歉，{NICKNAME}，但可莉跟你关系比较好…我们认为你确实是合适的人选。",
            "nextDialogs": [
              "401120236"
            ]
          },
          "401120236": {
            "id": "401120236",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "#那当然没关系啦，{NICKNAME}，我们就接下这个委托吧！",
            "nextDialogs": [
              "401120237"
            ]
          },
          "401120237": {
            "id": "401120237",
            "speakerId": 10090,
            "speakerName": "可莉",
            "text": "#嘿嘿，荣誉骑士{M#哥哥}{F#姐姐}…可以吗？"
          },
          "401120212": {
            "id": "401120212",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "这路还用你带？"
          }
        }
      }
    },
    {
      "subId": "4011203",
      "subQuestName": "与众人交谈",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "401120301"
        ],
        "dialogs": {
          "401120301": {
            "id": "401120301",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "吓、吓死我了，我还以为要被送到奇怪的地方去了。",
            "nextDialogs": [
              "401120302"
            ]
          },
          "401120302": {
            "id": "401120302",
            "speakerId": 10090,
            "speakerName": "可莉",
            "text": "欸嘿嘿，可莉不是故意的…",
            "nextDialogs": [
              "401120303"
            ]
          },
          "401120303": {
            "id": "401120303",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "我知道啦，不过，没想到那个「神奇邀请函」居然真的有用。",
            "nextDialogs": [
              "401120304"
            ]
          },
          "401120304": {
            "id": "401120304",
            "speakerId": 1004,
            "speakerName": "凯亚",
            "text": "有意思，真的在一瞬间抵达了须弥。",
            "nextDialogs": [
              "401120305"
            ]
          },
          "401120305": {
            "id": "401120305",
            "speakerId": 10090,
            "speakerName": "可莉",
            "text": "原来这就是妈妈的朋友住的地方，有好多好大的花，还有好多会跳的蘑菇。",
            "nextDialogs": [
              "401120306"
            ]
          },
          "401120306": {
            "id": "401120306",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "须弥还有好多神奇的东西呢！",
            "nextDialogs": [
              "401120307"
            ]
          },
          "401120307": {
            "id": "401120307",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "比如，嗯…",
            "nextDialogs": [
              "401120309",
              "401120311"
            ]
          },
          "401120309": {
            "id": "401120309",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "对对，第一次看到的时候我都吓了一跳呢。",
            "nextDialogs": [
              "401120312"
            ]
          },
          "401120312": {
            "id": "401120312",
            "speakerId": 1004,
            "speakerName": "凯亚",
            "text": "可莉，这种会跳的蘑菇叫蕈兽，看上去可爱，但在你靠近的时候，它会故意用帽子把你撞倒。",
            "nextDialogs": [
              "401120313"
            ]
          },
          "401120313": {
            "id": "401120313",
            "speakerId": 10090,
            "speakerName": "可莉",
            "text": "真的吗？那可莉也要用帽子和它对撞！",
            "nextDialogs": [
              "401120314"
            ]
          },
          "401120314": {
            "id": "401120314",
            "speakerId": 10090,
            "speakerName": "可莉",
            "text": "可莉有脑袋上的帽子和衣服后面的帽子，一定能赢的。",
            "nextDialogs": [
              "401120315"
            ]
          },
          "401120315": {
            "id": "401120315",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "可莉，强！",
            "nextDialogs": [
              "401120316"
            ]
          },
          "401120316": {
            "id": "401120316",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "用帽子至少比用炸弹好多了…不过还好我们跟可莉熟，可以劝阻她用炸弹，对吧？",
            "nextDialogs": [
              "401120317"
            ]
          },
          "401120317": {
            "id": "401120317",
            "speakerId": 10090,
            "speakerName": "可莉",
            "text": "嗯！可莉会注意，不用炸弹炸周围的东西！呃…尽量不用…",
            "nextDialogs": [
              "401120318"
            ]
          },
          "401120318": {
            "id": "401120318",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "真的？好体贴，小可莉长大了呢！",
            "nextDialogs": [
              "401120319"
            ]
          },
          "401120319": {
            "id": "401120319",
            "speakerId": 10090,
            "speakerName": "可莉",
            "text": "嗯！是很懂事的火花骑士可莉！",
            "nextDialogs": [
              "401120320"
            ]
          },
          "401120320": {
            "id": "401120320",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "那么懂事的火花骑士就跟我们去化城郭见一位名叫提纳里的朋友吧！"
          },
          "401120311": {
            "id": "401120311",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "咦，有这样的东西吗…喂！你不会是在说我吧！"
          }
        }
      }
    },
    {
      "subId": "4011204",
      "subQuestName": "前往化城郭",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [],
        "dialogs": {}
      }
    },
    {
      "subId": "4011205",
      "subQuestName": "与柯莱、优菈交谈",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "401120501"
        ],
        "dialogs": {
          "401120501": {
            "id": "401120501",
            "speakerId": 1051,
            "speakerName": "柯莱",
            "text": "穿着那样衣服的人，确实之前听其他巡林员提到过…",
            "nextDialogs": [
              "401120502"
            ]
          },
          "401120502": {
            "id": "401120502",
            "speakerId": 1029,
            "speakerName": "优菈",
            "text": "是嘛…那看来我的推断并没有错…咦？那是…",
            "nextDialogs": [
              "401120503"
            ]
          },
          "401120503": {
            "id": "401120503",
            "speakerId": 1051,
            "speakerName": "柯莱",
            "text": "#{NICKNAME}，派蒙，凯亚先生，还有，可莉！",
            "nextDialogs": [
              "401120504"
            ]
          },
          "401120504": {
            "id": "401120504",
            "speakerId": 10090,
            "speakerName": "可莉",
            "text": "柯莱姐姐，好久不见啦！",
            "nextDialogs": [
              "401120505"
            ]
          },
          "401120505": {
            "id": "401120505",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "柯莱，还有优菈！你们怎么在这里？",
            "nextDialogs": [
              "401120506"
            ]
          },
          "401120506": {
            "id": "401120506",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "呃，我主要是在问优菈啦。",
            "nextDialogs": [
              "401120507"
            ]
          },
          "401120507": {
            "id": "401120507",
            "speakerId": 1004,
            "speakerName": "凯亚",
            "text": "没想到出趟远门还能撞上外出度假的游击小队队长，真巧啊。",
            "nextDialogs": [
              "401120508"
            ]
          },
          "401120508": {
            "id": "401120508",
            "speakerId": 1029,
            "speakerName": "优菈",
            "text": "…怎么都来了？啧…",
            "nextDialogs": [
              "401120509"
            ]
          },
          "401120509": {
            "id": "401120509",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "她刚刚是不是露出了很为难的表情…",
            "nextDialogs": [
              "401120512"
            ]
          },
          "401120512": {
            "id": "401120512",
            "speakerId": 1051,
            "speakerName": "柯莱",
            "text": "啊对对，好的好的！我们走吧！",
            "nextDialogs": [
              "401120513"
            ]
          },
          "401120513": {
            "id": "401120513",
            "speakerId": 1029,
            "speakerName": "优菈",
            "text": "就算要照顾我的感受也不必这样，你们搞错了，我不会觉得尴尬的。",
            "nextDialogs": [
              "401120514"
            ]
          },
          "401120514": {
            "id": "401120514",
            "speakerId": 1051,
            "speakerName": "柯莱",
            "text": "你最好是…",
            "nextDialogs": [
              "401120515"
            ]
          },
          "401120515": {
            "id": "401120515",
            "speakerId": 1004,
            "speakerName": "凯亚",
            "text": "那太好了！你会不远千里跑到须弥来，原因一定很有趣吧，快跟我们分享分享。",
            "nextDialogs": [
              "401120516"
            ]
          },
          "401120516": {
            "id": "401120516",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "（一副看热闹不嫌事大的表情呢…）",
            "nextDialogs": [
              "401120517"
            ]
          },
          "401120517": {
            "id": "401120517",
            "speakerId": 1029,
            "speakerName": "优菈",
            "text": "真要说的话也有点复杂…概括一下吧，我在找劳伦斯家的一位表亲。",
            "nextDialogs": [
              "401120518"
            ]
          },
          "401120518": {
            "id": "401120518",
            "speakerId": 1029,
            "speakerName": "优菈",
            "text": "不久前，那位劳伦斯突然失踪，从他家里调查的结果来看，他似乎是想前来须弥寻找复兴家族的办法。",
            "nextDialogs": [
              "401120519"
            ]
          },
          "401120519": {
            "id": "401120519",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "大老远跑到别的国家去找办法？他难道打算在须弥读书？",
            "nextDialogs": [
              "401120520"
            ]
          },
          "401120520": {
            "id": "401120520",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "那实在有些迂回了。",
            "nextDialogs": [
              "401120521"
            ]
          },
          "401120521": {
            "id": "401120521",
            "speakerId": 1029,
            "speakerName": "优菈",
            "text": "那倒不会，他早就不在基础教育的年龄段了。至于深造…以我对他的认识，他多半也没那个心思。",
            "nextDialogs": [
              "401120522"
            ]
          },
          "401120522": {
            "id": "401120522",
            "speakerId": 1029,
            "speakerName": "优菈",
            "text": "他在乎家族名誉多过其他。复兴这个想法不能说有错，但我不清楚他的执念到了哪种地步，会不会惹出什么麻烦。",
            "nextDialogs": [
              "401120523"
            ]
          },
          "401120523": {
            "id": "401120523",
            "speakerId": 1029,
            "speakerName": "优菈",
            "text": "于情于理，都不能放着他不管。",
            "nextDialogs": [
              "401120524"
            ]
          },
          "401120524": {
            "id": "401120524",
            "speakerId": 1004,
            "speakerName": "凯亚",
            "text": "如果这事属实，你的那位表亲在劳伦斯家也算是了不起的行动派了。一路从蒙德到须弥可不容易。",
            "nextDialogs": [
              "401120525"
            ]
          },
          "401120525": {
            "id": "401120525",
            "speakerId": 1029,
            "speakerName": "优菈",
            "text": "而且竟然还劳烦我为他的人身安危操心，哼，好大的胆子啊。",
            "nextDialogs": [
              "401120526"
            ]
          },
          "401120526": {
            "id": "401120526",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "嘿嘿，优菈人真好。",
            "nextDialogs": [
              "401120527"
            ]
          },
          "401120527": {
            "id": "401120527",
            "speakerId": 10090,
            "speakerName": "可莉",
            "text": "对！优菈姐姐上次还带了月亮派给可莉吃！",
            "nextDialogs": [
              "401120528"
            ]
          },
          "401120528": {
            "id": "401120528",
            "speakerId": 1029,
            "speakerName": "优菈",
            "text": "咳！毕竟是同一个家族的人…总之我会找到他，在确保安全的前提下带他回去。"
          }
        }
      }
    },
    {
      "subId": "4011206",
      "subQuestName": "寻找秘境的入口",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "401120601"
        ],
        "dialogs": {
          "401120601": {
            "id": "401120601",
            "speakerId": 10090,
            "speakerName": "可莉",
            "text": "哇，是大沙漠——",
            "nextDialogs": [
              "401120602"
            ]
          },
          "401120602": {
            "id": "401120602",
            "speakerId": 1051,
            "speakerName": "柯莱",
            "text": "亲眼看到还是很震撼…",
            "nextDialogs": [
              "401120603"
            ]
          },
          "401120603": {
            "id": "401120603",
            "speakerId": 1004,
            "speakerName": "凯亚",
            "text": "确实是相当壮观的景象。",
            "nextDialogs": [
              "401120604"
            ]
          },
          "401120604": {
            "id": "401120604",
            "speakerId": 1029,
            "speakerName": "优菈",
            "text": "……",
            "nextDialogs": [
              "401120605"
            ]
          },
          "401120605": {
            "id": "401120605",
            "speakerId": 1051,
            "speakerName": "柯莱",
            "text": "怎么了，觉得不舒服吗？",
            "nextDialogs": [
              "401120606"
            ]
          },
          "401120606": {
            "id": "401120606",
            "speakerId": 1029,
            "speakerName": "优菈",
            "text": "不，只是一瞬间有点难适应，这里的空气有些干燥…相较于蒙德…",
            "nextDialogs": [
              "401120607"
            ]
          },
          "401120607": {
            "id": "401120607",
            "speakerId": 1029,
            "speakerName": "优菈",
            "text": "这里可不像能住人的样子，如果真的有个秘境…附近似乎也没见到入口？",
            "nextDialogs": [
              "401120608"
            ]
          },
          "401120608": {
            "id": "401120608",
            "speakerId": 1051,
            "speakerName": "柯莱",
            "text": "难道是因为我、我刚才念错了…应该不至于吧…",
            "nextDialogs": [
              "401120609"
            ]
          },
          "401120609": {
            "id": "401120609",
            "speakerId": 10090,
            "speakerName": "可莉",
            "text": "没有错哦！绝对不是因为柯莱姐姐！",
            "nextDialogs": [
              "401120610"
            ]
          },
          "401120610": {
            "id": "401120610",
            "speakerId": 10090,
            "speakerName": "可莉",
            "text": "之前可莉也不小心念错，但还是到了化城郭！",
            "nextDialogs": [
              "401120611"
            ]
          },
          "401120611": {
            "id": "401120611",
            "speakerId": 1004,
            "speakerName": "凯亚",
            "text": "按照之前的经验，目的地不会有错。",
            "nextDialogs": [
              "401120612"
            ]
          },
          "401120612": {
            "id": "401120612",
            "speakerId": 1051,
            "speakerName": "柯莱",
            "text": "呼…",
            "nextDialogs": [
              "401120613"
            ]
          },
          "401120613": {
            "id": "401120613",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "那是不是藏在附近沙丘下面了呢？",
            "nextDialogs": [
              "401120614"
            ]
          },
          "401120614": {
            "id": "401120614",
            "speakerId": 1029,
            "speakerName": "优菈",
            "text": "…没有办法，只能先寻找一下看看了。",
            "nextDialogs": [
              "401120615"
            ]
          },
          "401120615": {
            "id": "401120615",
            "speakerId": 1006,
            "speakerName": "Black Screen",
            "text": "众人分头寻找，可惜找了许久还是没有头绪。",
            "nextDialogs": [
              "401120616"
            ]
          },
          "401120616": {
            "id": "401120616",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "好累，而且好渴…",
            "nextDialogs": [
              "401120617"
            ]
          },
          "401120617": {
            "id": "401120617",
            "speakerId": 1004,
            "speakerName": "凯亚",
            "text": "不应该。难道「神奇邀请函」突然出了问题？",
            "nextDialogs": [
              "401120618"
            ]
          },
          "401120618": {
            "id": "401120618",
            "speakerId": 10090,
            "speakerName": "可莉",
            "text": "咦？怎么会这样…",
            "nextDialogs": [
              "401120619"
            ]
          },
          "401120619": {
            "id": "401120619",
            "speakerId": 10090,
            "speakerName": "可莉",
            "text": "啊，不会是被可莉弄坏了吧？但可莉什么都没做呀…嘟嘟可能作证的！",
            "nextDialogs": [
              "401120620"
            ]
          },
          "401120620": {
            "id": "401120620",
            "speakerId": 1051,
            "speakerName": "柯莱",
            "text": "肯定也不是可莉的问题，你看，这张纸都没有皱。",
            "nextDialogs": [
              "401120621"
            ]
          },
          "401120621": {
            "id": "401120621",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "如果那个秘境在附近…",
            "nextDialogs": [
              "401120622"
            ]
          },
          "401120622": {
            "id": "401120622",
            "speakerId": 10090,
            "speakerName": "可莉",
            "text": "#嗯？难道荣誉骑士{M#哥哥}{F#姐姐}有办法了吗！",
            "nextDialogs": [
              "401120623"
            ]
          },
          "401120623": {
            "id": "401120623",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "与其让我们找秘境！",
            "nextDialogs": [
              "401120624"
            ]
          },
          "401120624": {
            "id": "401120624",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "#啊，我明白了{NICKNAME}的意思了！",
            "nextDialogs": [
              "401120625"
            ]
          },
          "401120625": {
            "id": "401120625",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "嗯，不如让秘境来找我们。",
            "nextDialogs": [
              "401120626"
            ]
          },
          "401120626": {
            "id": "401120626",
            "speakerId": 1004,
            "speakerName": "凯亚",
            "text": "这倒是个有趣的思路，既然「神奇邀请函」就在这里…",
            "nextDialogs": [
              "401120627"
            ]
          },
          "401120627": {
            "id": "401120627",
            "speakerId": 1004,
            "speakerName": "凯亚",
            "text": "送出邀请函的秘境，与它也必然存在联系。",
            "nextDialogs": [
              "401120628"
            ]
          },
          "401120628": {
            "id": "401120628",
            "speakerId": 10090,
            "speakerName": "可莉",
            "text": "噢，那可莉明白了。其实可莉也有绝招的！",
            "nextDialogs": [
              "401120629"
            ]
          },
          "401120629": {
            "id": "401120629",
            "speakerId": 1029,
            "speakerName": "优菈",
            "text": "什么样的绝招？我们能学吗？",
            "nextDialogs": [
              "401120630"
            ]
          },
          "401120630": {
            "id": "401120630",
            "speakerId": 10090,
            "speakerName": "可莉",
            "text": "可以的！妈妈提过，需要帮助的时候就这样大声喊出来——",
            "nextDialogs": [
              "401120631"
            ]
          },
          "401120631": {
            "id": "401120631",
            "speakerId": 10090,
            "speakerName": "可莉",
            "text": "「神奇邀请函」，「神奇邀请函」，可莉需要帮助！想想办法吧！",
            "nextDialogs": [
              "401120632"
            ]
          },
          "401120632": {
            "id": "401120632",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "#快看！{NICKNAME}，有什么东西真的飞过来了！",
            "nextDialogs": [
              "401120633"
            ]
          },
          "401120633": {
            "id": "401120633",
            "speakerId": 1029,
            "speakerName": "优菈",
            "text": "欸？那是…一个瓶子？",
            "nextDialogs": [
              "401120634"
            ]
          },
          "401120634": {
            "id": "401120634",
            "speakerId": 1004,
            "speakerName": "凯亚",
            "text": "很有效呢，我打算学学这招傍身用。你也学一下吧。",
            "nextDialogs": [
              "401120635"
            ]
          },
          "401120635": {
            "id": "401120635",
            "speakerId": 1029,
            "speakerName": "优菈",
            "text": "不要！太不适合我了。",
            "nextDialogs": [
              "401120636"
            ]
          },
          "401120636": {
            "id": "401120636",
            "speakerId": 1051,
            "speakerName": "柯莱",
            "text": "瓶子在须弥也算是经常出现在传说中的东西了…难道这个就是秘境的入口吗？",
            "nextDialogs": [
              "401120637"
            ]
          },
          "401120637": {
            "id": "401120637",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "秘境在瓶子里，听上去也是在璃月发生过的事。",
            "nextDialogs": [
              "401120638"
            ]
          },
          "401120638": {
            "id": "401120638",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "#真是这样的话，那进去的方法就只有一种了！来吧，伸出你的手{NICKNAME}！",
            "nextDialogs": [
              "401120639"
            ]
          },
          "401120639": {
            "id": "401120639",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "（触碰瓶子…）"
          }
        }
      }
    },
    {
      "subId": "4011207",
      "subQuestName": "向前探索秘境",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "401120701"
        ],
        "dialogs": {
          "401120701": {
            "id": "401120701",
            "speakerId": 10090,
            "speakerName": "可莉",
            "text": "快看，这里，这里有好大一个花园！",
            "nextDialogs": [
              "401120702"
            ]
          },
          "401120702": {
            "id": "401120702",
            "speakerId": 1029,
            "speakerName": "优菈",
            "text": "太不可思议了…刚才的瓶子看上去明明那么小…",
            "nextDialogs": [
              "401120703"
            ]
          },
          "401120703": {
            "id": "401120703",
            "speakerId": 1029,
            "speakerName": "优菈",
            "text": "各位，我建议先在这里稍作休整，分析目前形势后再确定下一步行动。",
            "nextDialogs": [
              "401120704"
            ]
          },
          "401120704": {
            "id": "401120704",
            "speakerId": 1004,
            "speakerName": "凯亚",
            "text": "说起来，「魔瓶」的故事，有人知道吗？",
            "nextDialogs": [
              "401120705"
            ]
          },
          "401120705": {
            "id": "401120705",
            "speakerId": 1051,
            "speakerName": "柯莱",
            "text": "啊，是赤王与瓶中镇灵的故事吗？我读过，虽然不是所有的字都认识…",
            "nextDialogs": [
              "401120706"
            ]
          },
          "401120706": {
            "id": "401120706",
            "speakerId": 10090,
            "speakerName": "可莉",
            "text": "凯亚哥哥，那是什么样的故事啊？",
            "nextDialogs": [
              "401120707"
            ]
          },
          "401120707": {
            "id": "401120707",
            "speakerId": 10090,
            "speakerName": "可莉",
            "text": "以前妈妈也给我讲过冒险队到瓶子国冒险的故事…不过，那个好像不叫魔瓶…",
            "nextDialogs": [
              "401120708"
            ]
          },
          "401120708": {
            "id": "401120708",
            "speakerId": 1004,
            "speakerName": "凯亚",
            "text": "嗯…我可以慢慢讲给可莉听哦。但如果可莉还是喜欢一个人往前跑的话，可能只能听到一半呢。",
            "nextDialogs": [
              "401120709"
            ]
          },
          "401120709": {
            "id": "401120709",
            "speakerId": 10090,
            "speakerName": "可莉",
            "text": "唔…可莉知道了。我会和大家一起往前的…",
            "nextDialogs": [
              "401120710"
            ]
          },
          "401120710": {
            "id": "401120710",
            "speakerId": 1051,
            "speakerName": "柯莱",
            "text": "……",
            "nextDialogs": [
              "401120711"
            ]
          },
          "401120711": {
            "id": "401120711",
            "speakerId": 1029,
            "speakerName": "优菈",
            "text": "柯莱，你也觉得哪里不对劲吧。",
            "nextDialogs": [
              "401120712"
            ]
          },
          "401120712": {
            "id": "401120712",
            "speakerId": 1051,
            "speakerName": "柯莱",
            "text": "嗯，虽然这里风景很好看，但有点安静过头了。可莉妈妈的朋友也没有出现…",
            "nextDialogs": [
              "401120713"
            ]
          },
          "401120713": {
            "id": "401120713",
            "speakerId": 10090,
            "speakerName": "可莉",
            "text": "沙漠阿姨会不会住在很里面呀？房间很大很大，就像菲谢尔姐姐的幽夜净土那样。我们现在才到最外面一层呢！",
            "nextDialogs": [
              "401120714"
            ]
          },
          "401120714": {
            "id": "401120714",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "没办法，那就先往里走走吧。",
            "nextDialogs": [
              "401120715"
            ]
          },
          "401120715": {
            "id": "401120715",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "说不定之后就能遇上了！"
          }
        }
      }
    },
    {
      "subId": "4011299",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "401129903"
        ],
        "dialogs": {
          "401129903": {
            "id": "401129903",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "快看，那边是柯莱…咦，还有优菈！优菈怎么会在化城郭？",
            "nextDialogs": [
              "401129904"
            ]
          },
          "401129904": {
            "id": "401129904",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "还真传到秘境里了…",
            "nextDialogs": [
              "401129905"
            ]
          },
          "401129905": {
            "id": "401129905",
            "speakerId": 10090,
            "speakerName": "可莉",
            "text": "那边有条路，可莉去看看！",
            "nextDialogs": [
              "401129906"
            ]
          },
          "401129906": {
            "id": "401129906",
            "speakerId": 1004,
            "speakerName": "凯亚",
            "text": "哎呀，这下哥哥姐姐们都要被丢在后面了。"
          }
        }
      }
    }
  ]
}
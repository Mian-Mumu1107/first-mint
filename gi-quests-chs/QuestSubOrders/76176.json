    {
      "subId": "7617603",
      "subQuestName": "(test)隐藏$HIDDEN",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "761760301"
        ],
        "dialogs": {
          "761760301": {
            "id": "761760301",
            "speakerId": 1000,
            "speakerName": "桑娜妲",
            "text": "…艾莉亚姐姐，卡侬姐姐。",
            "nextDialogs": [
              "761760302"
            ]
          },
          "761760302": {
            "id": "761760302",
            "speakerId": 1000,
            "speakerName": "桑娜妲",
            "text": "这已经不是第一次了。这已经…远超「惩罚」的范围了。",
            "nextDialogs": [
              "761760303"
            ]
          },
          "761760303": {
            "id": "761760303",
            "speakerId": 1000,
            "speakerName": "桑娜妲",
            "text": "无论是王托付给我们的、属于龙的城市，还是那些小小的人类建立起的、脆弱却又美丽的家园…",
            "nextDialogs": [
              "761760304"
            ]
          },
          "761760304": {
            "id": "761760304",
            "speakerId": 1000,
            "speakerName": "桑娜妲",
            "text": "你们还要看着多少无辜的生灵死去，才能不再袖手旁观？",
            "nextDialogs": [
              "761760305"
            ]
          },
          "761760305": {
            "id": "761760305",
            "speakerId": 1000,
            "speakerName": "桑娜妲",
            "text": "要是我们的王还在——",
            "nextDialogs": [
              "761760306"
            ]
          },
          "761760306": {
            "id": "761760306",
            "speakerId": 1001,
            "speakerName": "艾莉亚",
            "text": "——我们的王不在，桑娜妲妹妹。",
            "nextDialogs": [
              "761760307"
            ]
          },
          "761760307": {
            "id": "761760307",
            "speakerId": 1001,
            "speakerName": "艾莉亚",
            "text": "如果那位远非全能的主宰将苍白可怖的命运视为「秩序」，如果这是让这个注定毁灭的世界免遭吞噬的唯一可能，那么…",
            "nextDialogs": [
              "761760308"
            ]
          },
          "761760308": {
            "id": "761760308",
            "speakerId": 1001,
            "speakerName": "艾莉亚",
            "text": "不管它索取的代价多么沉重…也不管这代价多么让我悲伤，它都远比漆黑的死寂要好得多。",
            "nextDialogs": [
              "761760309"
            ]
          },
          "761760309": {
            "id": "761760309",
            "speakerId": 1000,
            "speakerName": "桑娜妲",
            "text": "既然世界注定要迎来毁灭…那对抗漆黑又有什么意义呢？",
            "nextDialogs": [
              "761760310"
            ]
          },
          "761760310": {
            "id": "761760310",
            "speakerId": 1001,
            "speakerName": "艾莉亚",
            "text": "…桑娜妲？",
            "nextDialogs": [
              "761760311"
            ]
          },
          "761760311": {
            "id": "761760311",
            "speakerId": 1000,
            "speakerName": "桑娜妲",
            "text": "没、没什么，艾莉亚姐姐！我什么都没说！",
            "nextDialogs": [
              "761760312"
            ]
          },
          "761760312": {
            "id": "761760312",
            "speakerId": 1000,
            "speakerName": "桑娜妲",
            "text": "我只是觉得，我们不该坐视那位暴君屠戮信任着我们的生灵…无论是龙，还是那些小小的人类。",
            "nextDialogs": [
              "761760313"
            ]
          },
          "761760313": {
            "id": "761760313",
            "speakerId": 1000,
            "speakerName": "桑娜妲",
            "text": "我们…难道不该救他们吗？",
            "nextDialogs": [
              "761760314"
            ]
          },
          "761760314": {
            "id": "761760314",
            "speakerId": 1002,
            "speakerName": "卡侬",
            "text": "……",
            "nextDialogs": [
              "761760315"
            ]
          },
          "761760315": {
            "id": "761760315",
            "speakerId": 1002,
            "speakerName": "卡侬",
            "text": "…我能理解桑娜妲的愤怒，艾莉亚。在我看来，那位主宰的所作所为，也未免过于残忍。",
            "nextDialogs": [
              "761760316"
            ]
          },
          "761760316": {
            "id": "761760316",
            "speakerId": 1002,
            "speakerName": "卡侬",
            "text": "哪怕只有一丝可能…我也希望竭尽全力，救下那些能得救的生命。",
            "nextDialogs": [
              "761760317"
            ]
          },
          "761760317": {
            "id": "761760317",
            "speakerId": 1000,
            "speakerName": "桑娜妲",
            "text": "可是…那些没有得救的呢？",
            "nextDialogs": [
              "761760318"
            ]
          },
          "761760318": {
            "id": "761760318",
            "speakerId": 1000,
            "speakerName": "桑娜妲",
            "text": "那些没有被救下的人，没有被救下的生命…他们的血泪与哀泣，难道就理应消失得无影无踪吗？",
            "nextDialogs": [
              "761760319"
            ]
          },
          "761760319": {
            "id": "761760319",
            "speakerId": 1000,
            "speakerName": "桑娜妲",
            "text": "不…不应该是这样的。我希望人人都能得救，没有一人沉沦。",
            "nextDialogs": [
              "761760320"
            ]
          },
          "761760320": {
            "id": "761760320",
            "speakerId": 1000,
            "speakerName": "桑娜妲",
            "text": "只要它的「秩序」与它一同死去…",
            "nextDialogs": [
              "761760321"
            ]
          },
          "761760321": {
            "id": "761760321",
            "speakerId": 1001,
            "speakerName": "艾莉亚",
            "text": "…桑娜妲。请你不要忘记，我们最初诞生的理由。",
            "nextDialogs": [
              "761760322"
            ]
          },
          "761760322": {
            "id": "761760322",
            "speakerId": 1001,
            "speakerName": "艾莉亚",
            "text": "我们的使命只有维系这个世界，直到赐予我们生命的王从远方归来。",
            "nextDialogs": [
              "761760323"
            ]
          },
          "761760323": {
            "id": "761760323",
            "speakerId": 1001,
            "speakerName": "艾莉亚",
            "text": "从一开始，我们就清楚这种秩序的代价…因为我们无法放任这个世界行往毁灭。",
            "nextDialogs": [
              "761760324"
            ]
          },
          "761760324": {
            "id": "761760324",
            "speakerId": 1002,
            "speakerName": "卡侬",
            "text": "…不，这甚至与秩序无关，艾莉亚。",
            "nextDialogs": [
              "761760325"
            ]
          },
          "761760325": {
            "id": "761760325",
            "speakerId": 1002,
            "speakerName": "卡侬",
            "text": "桑娜妲，对我们来说…对我来说，你是最重要的妹妹。",
            "nextDialogs": [
              "761760326"
            ]
          },
          "761760326": {
            "id": "761760326",
            "speakerId": 1002,
            "speakerName": "卡侬",
            "text": "所以…请不要做出会让艾莉亚和我痛苦的事。",
            "nextDialogs": [
              "761760327"
            ]
          },
          "761760327": {
            "id": "761760327",
            "speakerId": 1002,
            "speakerName": "卡侬",
            "text": "不要直接与高天的秩序相抗。至少…不是世界依然脆弱不堪的现在。",
            "nextDialogs": [
              "761760328"
            ]
          },
          "761760328": {
            "id": "761760328",
            "speakerId": 1000,
            "speakerName": "桑娜妲",
            "text": "卡侬姐姐…我…",
            "nextDialogs": [
              "761760329"
            ]
          },
          "761760329": {
            "id": "761760329",
            "speakerId": 1002,
            "speakerName": "卡侬",
            "text": "伊斯塔露和我说过一个只属于人类的词语…「希望」。",
            "nextDialogs": [
              "761760330"
            ]
          },
          "761760330": {
            "id": "761760330",
            "speakerId": 1002,
            "speakerName": "卡侬",
            "text": "只要有生命，就会有希望…总会有希望。"
          }
        }
      }
    },

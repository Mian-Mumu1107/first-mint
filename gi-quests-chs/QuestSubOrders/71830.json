    {
      "subId": "7183011",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "718301101"
        ],
        "dialogs": {
          "718301101": {
            "id": "718301101",
            "speakerId": 1000,
            "speakerName": "王平安",
            "text": "唉，这庙真是够破的…柱子也坏了，梁也断了，还好这雕像没坏…",
            "nextDialogs": [
              "718301102"
            ]
          },
          "718301102": {
            "id": "718301102",
            "speakerId": 1000,
            "speakerName": "王平安",
            "text": "真是的，怎么一直没人修呢…"
          }
        }
      }
    }
  ]
}
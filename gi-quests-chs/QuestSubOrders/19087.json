            "speakerId": 1002,
            "speakerName": "诺艾尔",
            "text": "唔…还不能松懈…",
            "nextDialogs": [
              "190870902"
            ]
          },
          "190870902": {
            "id": "190870902",
            "speakerId": 1002,
            "speakerName": "诺艾尔",
            "text": "至少…要先把这本书看完…再去休息…"
          }
        }
      }

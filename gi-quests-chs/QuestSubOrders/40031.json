      }
    },
    {
      "subId": "4003105",
      "subQuestName": "向龙二回报",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "400310501"
        ],
        "dialogs": {
          "400310501": {
            "id": "400310501",
            "speakerId": 1003,
            "speakerName": "龙二",
            "text": "真是可靠！你的身法，我都看在眼里。",
            "nextDialogs": [
              "400310502"
            ]
          },
          "400310502": {
            "id": "400310502",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "#哼哼，{NICKNAME}很厉害的，小事一桩啦！",
            "nextDialogs": [
              "400310503"
            ]
          },
          "400310503": {
            "id": "400310503",
            "speakerId": 1003,
            "speakerName": "龙二",
            "text": "那么，向下一个目标进发吧。",
            "nextDialogs": [
              "400310504"
            ]
          },
          "400310504": {
            "id": "400310504",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "欸？还有吗？",
            "nextDialogs": [
              "400310505"
            ]
          },
          "400310505": {
            "id": "400310505",
            "speakerId": 1003,
            "speakerName": "龙二",
            "text": "当然了。从珊瑚社长接到的委托数量来看，这可是稻妻史上最大的小动物失踪案。",
            "nextDialogs": [
              "400310506"
            ]
          },
          "400310506": {
            "id": "400310506",
            "speakerId": 1003,
            "speakerName": "龙二",
            "text": "…话虽如此，不过平时一般也不会同时有这么多小动物走失就是了。这个事件，无论怎么说都很不寻常呢。",
            "nextDialogs": [
              "400310507"
            ]
          },
          "400310507": {
            "id": "400310507",
            "speakerId": 1003,
            "speakerName": "龙二",
            "text": "早些时候，我还循着踪迹在别的地方，发现了被困住的小动物。",
            "nextDialogs": [
              "400310508"
            ]
          },
          "400310508": {
            "id": "400310508",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "还需要「潜入」吗？",
            "nextDialogs": [
              "400310509"
            ]
          },
          "400310509": {
            "id": "400310509",
            "speakerId": 1003,
            "speakerName": "龙二",
            "text": "这次不用了。",
            "nextDialogs": [
              "400310510"
            ]
          },
          "400310510": {
            "id": "400310510",
            "speakerId": 1003,
            "speakerName": "龙二",
            "text": "放心，依你的身法来看，应该不是什么难缠的对手，到了你就知道了。"
          }
        }
      }
    },
    {
      "subId": "4003106",
      "subQuestName": "前往另一处调查地点",
      "sceneId": null,
      "locations": [],

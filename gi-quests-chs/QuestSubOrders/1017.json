    {
      "subId": "101604",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "10160401"
        ],
        "dialogs": {
          "10160401": {
            "id": "10160401",
            "speakerId": 1000,
            "speakerName": "观察夜泊石",
            "text": "（至少要「烛照」级的夜泊石，才能配得上正式的「送仙典仪」。）",
            "nextDialogs": [
              "10160402"
            ]
          },
          "10160402": {
            "id": "10160402",
            "speakerId": 1000,
            "speakerName": "观察夜泊石",
            "text": "（谁能想到，达达乌帕谷的大锅，可以用来甄别夜泊石的品质呢…）",
            "nextDialogs": [
              "10160411"
            ]
          },
          "10160411": {
            "id": "10160411",
            "speakerId": 1001,
            "speakerName": "观察风筝",
            "text": "（用在仪式上，据说象征着七神的风筝。）",
            "nextDialogs": [
              "10160412"
            ]
          },
          "10160412": {
            "id": "10160412",
            "speakerId": 1001,
            "speakerName": "观察风筝",
            "text": "#（究竟什么时候，才能找到夺走了{MATEAVATAR#SEXPRO[INFO_MALE_PRONOUN_BROTHER|INFO_FEMALE_PRONOUN_SISTER]}的神…）",
            "nextDialogs": [
              "10160421"
            ]
          },
          "10160421": {
            "id": "10160421",
            "speakerId": 1002,
            "speakerName": "观察香炉",
            "text": "（经过了一番波折得来的「永生香」。）",
            "nextDialogs": [
              "10160422"
            ]
          },
          "10160422": {
            "id": "10160422",
            "speakerId": 1002,
            "speakerName": "观察香炉",
            "text": "（在「送仙典仪」正式开始时，会点燃吧…？）",
            "nextDialogs": [
              "10160423"
            ]
          },
          "10160423": {
            "id": "10160423",
            "speakerId": 1002,
            "speakerName": "观察香炉",
            "text": "（能看见价值二百九十九万摩拉的烟气，袅袅飘起吧…？）",
            "nextDialogs": [
              "10160431"
            ]
          },
          "10160431": {
            "id": "10160431",
            "speakerId": 1003,
            "speakerName": "观察香膏",
            "text": "（用特殊霓裳花制成的香膏，散发着淡淡的芳香气息。）",
            "nextDialogs": [
              "10160432"
            ]
          },
          "10160432": {
            "id": "10160432",
            "speakerId": 1003,
            "speakerName": "观察香膏",
            "text": "（为什么「岩王帝君」会钟情于这种成熟女性喜欢的香气呢…？）",
            "nextDialogs": [
              "10160441"
            ]
          },
          "10160441": {
            "id": "10160441",
            "speakerId": 1004,
            "speakerName": "观察铃铛",
            "text": "（「送仙典仪」必备的器具。大概是以涤净凡尘的铃声为仙家送行吧…？）",
            "nextDialogs": [
              "10160442"
            ]
          },
          "10160442": {
            "id": "10160442",
            "speakerId": 1004,
            "speakerName": "观察铃铛",
            "text": "（这样的珍贵道具，很难想象之前放在一个布满蜘蛛网的茶壶里。）"
          }
        }
      }
    }
  ]

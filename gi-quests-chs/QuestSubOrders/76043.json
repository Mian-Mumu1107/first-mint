{
  "lineCounts": {
    "奈芙尔": 4,
    "库莉艾卡": 19,
    "海勒姆": 5,
    "雅珂达": 15
  },
  "subQuests": [
    {
      "subId": "7604301",
      "subQuestName": "前往「秘闻馆」",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "760430101"
        ],
        "dialogs": {
          "760430101": {
            "id": "760430101",
            "speakerId": 1000,
            "speakerName": "奈芙尔",
            "text": "「流浪之环」的案子，如果我没记错的话，当时并没有定论。",
            "nextDialogs": [
              "760430102"
            ]
          },
          "760430102": {
            "id": "760430102",
            "speakerId": 1001,
            "speakerName": "雅珂达",
            "text": "是的，商队的货品失窃，被怀疑是犯人的那人不仅不承认，还打死了人，最后逃跑了。",
            "nextDialogs": [
              "760430103"
            ]
          },
          "760430103": {
            "id": "760430103",
            "speakerId": 1000,
            "speakerName": "奈芙尔",
            "text": "据说这两人都是海盗出身，原本是同伴，十年来相安无事，最后却落得如此下场，不免令人唏嘘。",
            "nextDialogs": [
              "760430104"
            ]
          },
          "760430104": {
            "id": "760430104",
            "speakerId": 1001,
            "speakerName": "雅珂达",
            "text": "可是老板，这在挪德卡莱也不是什么稀罕的事吧。",
            "nextDialogs": [
              "760430105"
            ]
          },
          "760430105": {
            "id": "760430105",
            "speakerId": 1000,
            "speakerName": "奈芙尔",
            "text": "呵…寻常不代表没有价值。要知道，线索往往藏于幽微处。",
            "nextDialogs": [
              "760430106"
            ]
          },
          "760430106": {
            "id": "760430106",
            "speakerId": 1001,
            "speakerName": "雅珂达",
            "text": "哦…",
            "nextDialogs": [
              "760430107"
            ]
          },
          "760430107": {
            "id": "760430107",
            "speakerId": 1000,
            "speakerName": "奈芙尔",
            "text": "雅珂达，你去找「信使」打听一下。应该能收获不少被忽视的细节。",
            "nextDialogs": [
              "760430108"
            ]
          },
          "760430108": {
            "id": "760430108",
            "speakerId": 1001,
            "speakerName": "雅珂达",
            "text": "好的，老板，就交给我吧！"
          }
        }
      }
    },
    {
      "subId": "7604302",
      "subQuestName": "与「信使」海勒姆和库莉艾卡对话",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "760430201"
        ],
        "dialogs": {
          "760430201": {
            "id": "760430201",
            "speakerId": 1001,
            "speakerName": "雅珂达",
            "text": "库莉艾卡、海勒姆，最近怎么样？",
            "nextDialogs": [
              "760430202"
            ]
          },
          "760430202": {
            "id": "760430202",
            "speakerId": 1002,
            "speakerName": "海勒姆",
            "text": "没想到我还能听到你说出这种话。寒暄不是你的习惯，幼獾。也许这就是你来这里的原因，为蛇吐信…或为了蛇能吐信。",
            "nextDialogs": [
              "760430203"
            ]
          },
          "760430203": {
            "id": "760430203",
            "speakerId": 1003,
            "speakerName": "库莉艾卡",
            "text": "呃，还是别管前辈了。托你的福，还是老样子。怎么了，有什么事吗？",
            "nextDialogs": [
              "760430204"
            ]
          },
          "760430204": {
            "id": "760430204",
            "speakerId": 1001,
            "speakerName": "雅珂达",
            "text": "嗯，想跟你们打听一下「流浪之环」的事。当时不是闹得挺大的吗，说是最后也没抓到盗走货品的犯人。",
            "nextDialogs": [
              "760430205"
            ]
          },
          "760430205": {
            "id": "760430205",
            "speakerId": 1003,
            "speakerName": "库莉艾卡",
            "text": "虽然想说那得看你觉得谁是犯人了…当时被指控的哈尔克坚称自己是无辜的，他大闹一通，还失手打死了一个叫朱亚尼的。",
            "nextDialogs": [
              "760430206"
            ]
          },
          "760430206": {
            "id": "760430206",
            "speakerId": 1003,
            "speakerName": "库莉艾卡",
            "text": "听说他俩以前都是海盗船上的，后来遇到事故，同伴大都丧生，船也没了，他们就一起加入了「流浪之环」。",
            "nextDialogs": [
              "760430207"
            ]
          },
          "760430207": {
            "id": "760430207",
            "speakerId": 1003,
            "speakerName": "库莉艾卡",
            "text": "哈尔克打死朱亚尼之后就逃跑了，当时没人想到他会下这么狠的手，朱亚尼跟他是老相识，平日里也很照顾他。",
            "nextDialogs": [
              "760430208"
            ]
          },
          "760430208": {
            "id": "760430208",
            "speakerId": 1003,
            "speakerName": "库莉艾卡",
            "text": "听说那之后他流窜到伦波岛北部继续作恶，唉，害我每次从那边经过都提心吊胆的。",
            "nextDialogs": [
              "760430209"
            ]
          },
          "760430209": {
            "id": "760430209",
            "speakerId": 1002,
            "speakerName": "海勒姆",
            "text": "除你以外，没有信使会选择那条穿过回廊的孤独之路。他们会尽他们所能地避开那些想象中的危险，尽管那没有意义。",
            "nextDialogs": [
              "760430210"
            ]
          },
          "760430210": {
            "id": "760430210",
            "speakerId": 1003,
            "speakerName": "库莉艾卡",
            "text": "是是是，前辈你说得都对。不过说起来，最近好像没怎么听说他的消息了，不知道是不是去别处避风头了。",
            "nextDialogs": [
              "760430211"
            ]
          },
          "760430211": {
            "id": "760430211",
            "speakerId": 1001,
            "speakerName": "雅珂达",
            "text": "不过听你的意思，也有人觉得哈尔克不是犯人？",
            "nextDialogs": [
              "760430212"
            ]
          },
          "760430212": {
            "id": "760430212",
            "speakerId": 1003,
            "speakerName": "库莉艾卡",
            "text": "是，毕竟还是有几处疑点。当时怀疑他是货品失窃案的犯人的理由是，货品失窃之后不久，他就在「旗舰」大手大脚请人吃喝。",
            "nextDialogs": [
              "760430213"
            ]
          },
          "760430213": {
            "id": "760430213",
            "speakerId": 1003,
            "speakerName": "库莉艾卡",
            "text": "还吹嘘自己搞定了重要的交易对象，商队主人相当赏识他，给他分了不少奖金，前途一片光明云云。",
            "nextDialogs": [
              "760430214"
            ]
          },
          "760430214": {
            "id": "760430214",
            "speakerId": 1003,
            "speakerName": "库莉艾卡",
            "text": "可是据「流浪之环」的人说，那并不是他的功劳。既然是这样，奖金肯定也是骗人的，这些花销肯定有别的来路。",
            "nextDialogs": [
              "760430215"
            ]
          },
          "760430215": {
            "id": "760430215",
            "speakerId": 1001,
            "speakerName": "雅珂达",
            "text": "但这也不是直接证据。唔，难道不是因为他的出身吗？毕竟他以前是海盗。",
            "nextDialogs": [
              "760430216"
            ]
          },
          "760430216": {
            "id": "760430216",
            "speakerId": 1003,
            "speakerName": "库莉艾卡",
            "text": "要说没有这方面因素，那就是骗人了。不过别忘了，朱亚尼也曾经是海盗呀，但两人的口碑可太不一样了。",
            "nextDialogs": [
              "760430217"
            ]
          },
          "760430217": {
            "id": "760430217",
            "speakerId": 1003,
            "speakerName": "库莉艾卡",
            "text": "当时，面对众人的怀疑，哈尔克反倒指控起朱亚尼来了，说他亲眼看到朱亚尼把商队的货品一点点转移走了。",
            "nextDialogs": [
              "760430218"
            ]
          },
          "760430218": {
            "id": "760430218",
            "speakerId": 1003,
            "speakerName": "库莉艾卡",
            "text": "还大声叫嚷说去朱亚尼在那夏镇的住处说不定能查到些什么。不过朱亚尼矢口否认，其他人也都不相信这套说辞。",
            "nextDialogs": [
              "760430219"
            ]
          },
          "760430219": {
            "id": "760430219",
            "speakerId": 1001,
            "speakerName": "雅珂达",
            "text": "让我猜猜，他们宁可相信是哈尔克栽赃陷害朱亚尼。",
            "nextDialogs": [
              "760430220"
            ]
          },
          "760430220": {
            "id": "760430220",
            "speakerId": 1003,
            "speakerName": "库莉艾卡",
            "text": "没错。虽然后来没找到哈尔克倒卖货品的证据，但他失手杀了朱亚尼，又逃之夭夭，这事就成了一笔糊涂账啦。",
            "nextDialogs": [
              "760430221"
            ]
          },
          "760430221": {
            "id": "760430221",
            "speakerId": 1001,
            "speakerName": "雅珂达",
            "text": "唔，总觉得还有什么遗漏的…",
            "nextDialogs": [
              "760430222"
            ]
          },
          "760430222": {
            "id": "760430222",
            "speakerId": 1002,
            "speakerName": "海勒姆",
            "text": "你看得没错，幼獾。生锈的金属拼接在一起，并非出于关怀与善意，而是出于对无意义的恐惧。恐惧不是火，不会熔铸金属。",
            "nextDialogs": [
              "760430223"
            ]
          },
          "760430223": {
            "id": "760430223",
            "speakerId": 1002,
            "speakerName": "海勒姆",
            "text": "「流浪之环」是一个将无归者固定住的象征，但劣品不会成为铆钉。它只会在必要的时刻将其撕裂，锈蚀不是一夜间完成的。",
            "nextDialogs": [
              "760430224"
            ]
          },
          "760430224": {
            "id": "760430224",
            "speakerId": 1003,
            "speakerName": "库莉艾卡",
            "text": "虽然听不懂前辈在说什么，不过商队的主人也真够倒霉的。你也知道，「流浪之环」过去向来是不问出身的。",
            "nextDialogs": [
              "760430225"
            ]
          },
          "760430225": {
            "id": "760430225",
            "speakerId": 1003,
            "speakerName": "库莉艾卡",
            "text": "那些有难言之隐的人，「流浪之环」也愿意为他们提供一个机会。听说过去十年里，商队对哈尔克就和对其他人一样…",
            "nextDialogs": [
              "760430226"
            ]
          },
          "760430226": {
            "id": "760430226",
            "speakerId": 1001,
            "speakerName": "雅珂达",
            "text": "…对了！为什么是现在？哈尔克在「流浪之环」的十年间都相安无事，怎么到了现在突然重操旧业？",
            "nextDialogs": [
              "760430227"
            ]
          },
          "760430227": {
            "id": "760430227",
            "speakerId": 1001,
            "speakerName": "雅珂达",
            "text": "按理说，这是他好不容易才获得的新的开始，他有什么理由要将这一切亲手破坏掉呢…",
            "nextDialogs": [
              "760430228"
            ]
          },
          "760430228": {
            "id": "760430228",
            "speakerId": 1001,
            "speakerName": "雅珂达",
            "text": "（如果是我的话…）",
            "nextDialogs": [
              "760430229"
            ]
          },
          "760430229": {
            "id": "760430229",
            "speakerId": 1003,
            "speakerName": "库莉艾卡",
            "text": "谁知道呢，说不定其实他这十年间一直在做坏事，只是没被发现，又或者是他认为现在时机到了，可以借机除掉朱亚尼。",
            "nextDialogs": [
              "760430230"
            ]
          },
          "760430230": {
            "id": "760430230",
            "speakerId": 1003,
            "speakerName": "库莉艾卡",
            "text": "街头巷尾说什么的都有，但谁也说服不了谁，毕竟关键的哈尔克本人音讯杳然。",
            "nextDialogs": [
              "760430231"
            ]
          },
          "760430231": {
            "id": "760430231",
            "speakerId": 1003,
            "speakerName": "库莉艾卡",
            "text": "而且，就算货品失窃的案子与他无关，他在那之后犯下的罪行可比盗窃严重多啦。事到如今，也无法回头了吧。",
            "nextDialogs": [
              "760430232"
            ]
          },
          "760430232": {
            "id": "760430232",
            "speakerId": 1001,
            "speakerName": "雅珂达",
            "text": "你说的对。不管怎么说，他都该为自己的所作所为付出代价。",
            "nextDialogs": [
              "760430233"
            ]
          },
          "760430233": {
            "id": "760430233",
            "speakerId": 1001,
            "speakerName": "雅珂达",
            "text": "好了，该问的也问完了，就不耽搁你们工作了。谢啦。",
            "nextDialogs": [
              "760430234"
            ]
          },
          "760430234": {
            "id": "760430234",
            "speakerId": 1003,
            "speakerName": "库莉艾卡",
            "text": "小意思，我们也没少受「秘闻馆」的关照，这点小忙不算什么。",
            "nextDialogs": [
              "760430235"
            ]
          },
          "760430235": {
            "id": "760430235",
            "speakerId": 1002,
            "speakerName": "海勒姆",
            "text": "保持警惕吧，幼獾。别让那生锈的金属把你划伤。"
          }
        }
      }
    }
  ]
}
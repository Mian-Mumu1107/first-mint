        "dialogs": {
          "727340101": {
            "id": "727340101",
            "speakerId": 13089,
            "speakerName": "「金龟奇术番长」",
            "text": "不严谨，不优雅，不精彩，不奇妙，什么都不搭。",
            "nextDialogs": [
              "727340102"
            ]
          },
          "727340102": {
            "id": "727340102",
            "speakerId": 1044,
            "speakerName": "荒泷一斗",
            "text": "你在神神叨叨什么，评价你那些败下阵来的同伴吗？",
            "nextDialogs": [
              "727340103"
            ]
          },
          "727340103": {
            "id": "727340103",
            "speakerId": 13089,
            "speakerName": "「金龟奇术番长」",
            "text": "……",
            "nextDialogs": [
              "727340104"
            ]
          },
          "727340104": {
            "id": "727340104",
            "speakerId": 13089,
            "speakerName": "「金龟奇术番长」",
            "text": "说的是你们斗虫的风格。",
            "nextDialogs": [
              "727340105"
            ]
          },
          "727340105": {
            "id": "727340105",
            "speakerId": 1044,
            "speakerName": "荒泷一斗",
            "text": "啊？你的脑袋被漂浮灵砸过吗？本大爷又不是来表演节目的！本大爷讲究的是热血、强劲和势不可当！你要来领教一下吗？",
            "nextDialogs": [
              "727340106"
            ]
          },
          "727340106": {
            "id": "727340106",
            "speakerId": 13089,
            "speakerName": "「金龟奇术番长」",
            "text": "想起了不好的回忆…我不能和你这种大大咧咧的家伙对阵。",
            "nextDialogs": [
              "727340107"
            ]
          },
          "727340107": {
            "id": "727340107",
            "speakerId": 13089,
            "speakerName": "「金龟奇术番长」",
            "text": "#唔，这位金发的{M#先生}{F#小姐}看起来很好对付…决定了！我要挑战{M#他}{F#她}！",
            "nextDialogs": [
              "727340108"
            ]
          },
          "727340108": {
            "id": "727340108",
            "speakerId": 1044,
            "speakerName": "荒泷一斗",
            "text": "噗…哈哈哈哈哈哈哈！",
            "nextDialogs": [
              "727340109"
            ]
          },
          "727340109": {
            "id": "727340109",
            "speakerId": 1044,
            "speakerName": "荒泷一斗",
            "text": "我的挚友，听见了吗？他说你好对付！你快来好好招待这家伙！",
            "nextDialogs": [
              "727340112"
            ]
          },
          "727340112": {
            "id": "727340112",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "真是让人看不懂呢，这些人根本就没有收集对手的情报嘛，一个接一个地过来送战果。",
            "nextDialogs": [
              "727340113"
            ]
          },
          "727340113": {
            "id": "727340113",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "「花角玉将」的团队简直就像是散装的！策略这方面远远不如我们三个嘛！"
          }
        }
      }
    }
  ]

  },
  "subQuests": [
    {
      "subId": "2003001",
      "subQuestName": "(test)派蒙开车$HIDDEN",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "200300101"
        ],
        "dialogs": {
          "200300101": {
            "id": "200300101",
            "speakerId": 1000,
            "speakerName": "凯瑟琳",
            "text": "欢迎来到<color=#00E1FFFF>冒险家协会</color>，我已经观察你很久了。",
            "nextDialogs": [
              "200300102"
            ]
          },
          "200300102": {
            "id": "200300102",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "#观察{NICKNAME}？难道我的伙伴做了什么奇怪的事吗？",
            "nextDialogs": [
              "200300103"
            ]
          },
          "200300103": {
            "id": "200300103",
            "speakerId": 1000,
            "speakerName": "凯瑟琳",
            "text": "没有没有，发现优秀的冒险者，这也是我的工作之一。",
            "nextDialogs": [
              "200300104"
            ]
          },
          "200300104": {
            "id": "200300104",
            "speakerId": 1000,
            "speakerName": "凯瑟琳",
            "text": "从你的身上，我能看到与那些传说中的冒险家比肩的资质。",
            "nextDialogs": [
              "200300105"
            ]
          },
          "200300105": {
            "id": "200300105",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "嘿嘿，这个我也看得出来。",
            "nextDialogs": [
              "200300106"
            ]
          },
          "200300106": {
            "id": "200300106",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "#跟着{NICKNAME}冒险，总感觉很安心。",
            "nextDialogs": [
              "200300107"
            ]
          },
          "200300107": {
            "id": "200300107",
            "speakerId": 1000,
            "speakerName": "凯瑟琳",
            "text": "嗯嗯，不过对冒险家来说，阅历比资质更加重要。",
            "nextDialogs": [
              "200300108"
            ]
          },
          "200300108": {
            "id": "200300108",
            "speakerId": 1000,
            "speakerName": "凯瑟琳",
            "text": "只有不断积累<color=#00E1FFFF>「冒险阅历」</color>，才能提高<color=#00E1FFFF>「冒险等阶」</color>的评定。",
            "nextDialogs": [
              "200300109"
            ]
          },
          "200300109": {
            "id": "200300109",
            "speakerId": 1000,
            "speakerName": "凯瑟琳",
            "text": "事不宜迟，就由我为刚入籍的冒险家介绍一下…",
            "nextDialogs": [
              "200300110"
            ]
          },
          "200300110": {
            "id": "200300110",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "等一下！我们已经成为正式冒险家了吗？",
            "nextDialogs": [
              "200300111"
            ]
          },
          "200300111": {
            "id": "200300111",
            "speakerId": 1000,
            "speakerName": "凯瑟琳",
            "text": "放心，冒险家协会无需会费，也更不会强制冒险家履行什么义务。",
            "nextDialogs": [
              "200300112"
            ]
          },
          "200300112": {
            "id": "200300112",
            "speakerId": 1000,
            "speakerName": "凯瑟琳",
            "text": "换句话说，加入协会是只有好处，没有坏处的哦。",
            "nextDialogs": [
              "200300116",
              "200300115"
            ]
          },
          "200300116": {
            "id": "200300116",
            "speakerId": 1000,
            "speakerName": "凯瑟琳",
            "text": "总之，每当「冒险等阶」提升，冒险家协会都会提供奖励。",
            "nextDialogs": [
              "200300117"
            ]
          },
          "200300117": {
            "id": "200300117",
            "speakerId": 1000,
            "speakerName": "凯瑟琳",
            "text": "这就当做协会的新人礼了，请你亲自确认一下吧。",
            "nextDialogs": [
              "200300118"
            ]
          },
          "200300118": {
            "id": "200300118",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "冒险等阶奖励"
          },
          "200300115": {
            "id": "200300115",
            "speakerId": 1000,
            "speakerName": "凯瑟琳",
            "text": "哈哈…现在的新人怎么变得这么直接了…"
          }
        }
      }
    },
    {
      "subId": "2003002",
      "subQuestName": "(test)与凯瑟琳对话，询问详情$HIDDEN",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [],
        "dialogs": {}
      }
    },
    {
      "subId": "2003003",
      "subQuestName": "(test)与凯瑟琳对话，询问详情$HIDDEN",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "200300201"
        ],
        "dialogs": {
          "200300201": {
            "id": "200300201",
            "speakerId": 1000,
            "speakerName": "凯瑟琳",
            "text": "那么容我正式欢迎你的加入，冒险家新星！",
            "nextDialogs": [
              "200300202"
            ]
          },
          "200300202": {
            "id": "200300202",
            "speakerId": 1000,
            "speakerName": "凯瑟琳",
            "text": "这是你的<color=#00E1FFFF>「冒险之证」</color>。",
            "nextDialogs": [
              "200300204",
              "200300206"
            ]
          },
          "200300204": {
            "id": "200300204",
            "speakerId": 1000,
            "speakerName": "凯瑟琳",
            "text": "新人加入这么重要的事，当然要有仪式感。",
            "nextDialogs": [
              "200300207"
            ]
          },
          "200300207": {
            "id": "200300207",
            "speakerId": 1000,
            "speakerName": "凯瑟琳",
            "text": "这上面记载了很多关于协会的委托和奖励的信息。",
            "nextDialogs": [
              "200300208"
            ]
          },
          "200300208": {
            "id": "200300208",
            "speakerId": 1000,
            "speakerName": "凯瑟琳",
            "text": "同时这也是会员的证明，记得多多查看并妥善保管哦。",
            "nextDialogs": [
              "200300209"
            ]
          },
          "200300209": {
            "id": "200300209",
            "speakerId": 1000,
            "speakerName": "凯瑟琳",
            "text": "对了，还有一件事。",
            "nextDialogs": [
              "200300210"
            ]
          },
          "200300210": {
            "id": "200300210",
            "speakerId": 1000,
            "speakerName": "凯瑟琳",
            "text": "「冒险等阶」的提升是会有瓶颈存在的。",
            "nextDialogs": [
              "200300211"
            ]
          },
          "200300211": {
            "id": "200300211",
            "speakerId": 1000,
            "speakerName": "凯瑟琳",
            "text": "到那时就需要完成一些「令人印象深刻的任务」来得到协会的进一步认可。",
            "nextDialogs": [
              "200300212"
            ]
          },
          "200300212": {
            "id": "200300212",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "令人印象深刻…的任务？",
            "nextDialogs": [
              "200300213"
            ]
          },
          "200300213": {
            "id": "200300213",
            "speakerId": 1000,
            "speakerName": "凯瑟琳",
            "text": "可以说是用来突破「冒险等阶」上限的「突破任务」吧。",
            "nextDialogs": [
              "200300214"
            ]
          },
          "200300214": {
            "id": "200300214",
            "speakerId": 1000,
            "speakerName": "凯瑟琳",
            "text": "现在还不是时候，当你的「阅历」足够丰富，自然就会有博得大家认可的机会。",
            "nextDialogs": [
              "200300215"
            ]
          },
          "200300215": {
            "id": "200300215",
            "speakerId": 1000,
            "speakerName": "凯瑟琳",
            "text": "那么今天就先这样吧，以后我们应该还会经常见面的。",
            "nextDialogs": [
              "200300216"
            ]
          },
          "200300216": {
            "id": "200300216",
            "speakerId": 1000,
            "speakerName": "凯瑟琳",
            "text": "努力吧冒险家，向着星辰与深渊！"
          },
          "200300206": {
            "id": "200300206",
            "speakerId": 1000,
            "speakerName": "凯瑟琳",
            "text": "这么说也可以，但它的功能性更强。"
          }
        }
      }
    },

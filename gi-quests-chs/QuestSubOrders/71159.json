            ]
          },
          "711590305": {
            "id": "711590305",
            "speakerId": 1000,
            "speakerName": "魈",
            "text": "是。之前我从魔物手下救出一人，她将手中的霄灯骨架与工具赠予我，作为酬谢。",
            "nextDialogs": [
              "711590306"

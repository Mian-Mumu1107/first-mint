              "711590307"
            ]
          },
          "711590307": {
            "id": "711590307",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "亲手做一盏霄灯，也很不错。",
            "nextDialogs": [
              "711590308"
            ]
          },
          "711590308": {
            "id": "711590308",
            "speakerId": 1000,
            "speakerName": "魈",
            "text": "是，我也…尽力做了一盏。",

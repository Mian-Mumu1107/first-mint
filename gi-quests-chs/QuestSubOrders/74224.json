    {
      "subId": "7422402",
      "subQuestName": "(test)和塔耶芙尔对话$HIDDEN",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "742240201"
        ],
        "dialogs": {
          "742240201": {
            "id": "742240201",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "欸？这不是塔耶芙尔姐姐吗？没想到又见面啦！",
            "nextDialogs": [
              "742240202"
            ]
          },
          "742240202": {
            "id": "742240202",
            "speakerId": 21083,
            "speakerName": "塔耶芙尔",
            "text": "啊呀，是你们，冒险家和他的小助手，上次忘记问你们的名字…",
            "nextDialogs": [
              "742240203"
            ]
          },
          "742240203": {
            "id": "742240203",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "#我是派蒙，{M#他}{F#她}是{NICKNAME}。上次多亏了你，我们才成功用「海螺琴」演奏了古代的乐谱。",
            "nextDialogs": [
              "742240204"
            ]
          },
          "742240204": {
            "id": "742240204",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "不过塔耶芙尔姐姐怎么到佩特莉可镇来了？",
            "nextDialogs": [
              "742240205"
            ]
          },
          "742240205": {
            "id": "742240205",
            "speakerId": 21083,
            "speakerName": "塔耶芙尔",
            "text": "这个问题我也想问你们呢，我可是一听到风声就赶过来了。不过既然你们是冒险家，会捷足先登也是理所当然了。",
            "nextDialogs": [
              "742240206"
            ]
          },
          "742240206": {
            "id": "742240206",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "风声，你说什么风声啦？",
            "nextDialogs": [
              "742240207"
            ]
          },
          "742240207": {
            "id": "742240207",
            "speakerId": 21083,
            "speakerName": "塔耶芙尔",
            "text": "说到佩特莉可镇，最近最大的新闻不就是那个吗…",
            "nextDialogs": [
              "742240210"
            ]
          },
          "742240210": {
            "id": "742240210",
            "speakerId": 21083,
            "speakerName": "塔耶芙尔",
            "text": "嗯？你在说什么啦，当然是传说中的褪色城堡被再度发现的事情啊。",
            "nextDialogs": [
              "742240211"
            ]
          },
          "742240211": {
            "id": "742240211",
            "speakerId": 21083,
            "speakerName": "塔耶芙尔",
            "text": "上一次有关于褪色城堡的记载还是几百年前的事情，我还以为你们是为了这个才来的呢！",
            "nextDialogs": [
              "742240212"
            ]
          },
          "742240212": {
            "id": "742240212",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "这个嘛，虽然和我们好像是有一些关系啦…",
            "nextDialogs": [
              "742240213"
            ]
          },
          "742240213": {
            "id": "742240213",
            "speakerId": 21083,
            "speakerName": "塔耶芙尔",
            "text": "你们应该知道的吧？褪色城堡曾经属于枫丹历史上最重要的音乐家波爱修斯。",
            "nextDialogs": [
              "742240214"
            ]
          },
          "742240214": {
            "id": "742240214",
            "speakerId": 21083,
            "speakerName": "塔耶芙尔",
            "text": "无论是波爱修斯所创作的歌剧，还是他整理的古雷穆利亚的乐谱，在音乐史上都有着特殊的地位。",
            "nextDialogs": [
              "742240215"
            ]
          },
          "742240215": {
            "id": "742240215",
            "speakerId": 21083,
            "speakerName": "塔耶芙尔",
            "text": "既然是他曾经居住过的城堡，一定保存了大量的资料。这对于我们音乐家协会来说可是重要的文献。",
            "nextDialogs": [
              "742240216"
            ]
          },
          "742240216": {
            "id": "742240216",
            "speakerId": 21083,
            "speakerName": "塔耶芙尔",
            "text": "因此一听到这个消息，我就赶紧跑过来了。想着能赶在其它冒险者之前，把重要的文献保存起来。",
            "nextDialogs": [
              "742240217"
            ]
          },
          "742240217": {
            "id": "742240217",
            "speakerId": 21083,
            "speakerName": "塔耶芙尔",
            "text": "没想到还是让你们先了一步呢。",
            "nextDialogs": [
              "742240218"
            ]
          },
          "742240218": {
            "id": "742240218",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "（怎么办？要不要告诉她，那个波爱修斯其实是个大坏蛋，还利用那些音乐做了一大堆坏事…）",
            "nextDialogs": [
              "742240219"
            ]
          },
          "742240219": {
            "id": "742240219",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "（她要是知道了真相，该不会伤心吧…）"
          }
        }
      }
    },

      }
    },
    {
      "subId": "7901330",
      "subQuestName": "与派蒙对话",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "790133501"
        ],
        "dialogs": {
          "790133501": {
            "id": "790133501",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "这次也是一样，沃尔夫冈还没留下笔记，他还没有到这里来。",
            "nextDialogs": [
              "790133502"
            ]
          },
          "790133502": {
            "id": "790133502",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "我们这次也留下如何解开密室的提示吧！",
            "nextDialogs": [
              "790133505"
            ]
          },
          "790133505": {
            "id": "790133505",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "对啊，如果沃尔夫冈没法使用元素力量的话…",
            "nextDialogs": [
              "790133506"
            ]
          },
          "790133506": {
            "id": "790133506",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "就算知道解法也没有用。那该怎么办呀…"
          }
        }
      }
    },
    {
      "subId": "7901315",
      "subQuestName": "选择合适地点留下提示刻痕",
      "sceneId": null,
      "locations": [],

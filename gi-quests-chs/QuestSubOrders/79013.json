    {
      "subId": "7901324",
      "subQuestName": "与派蒙对话",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "790132501"
        ],
        "dialogs": {
          "790132501": {
            "id": "790132501",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "这个笔记…啊，是「沃尔夫冈」。",
            "nextDialogs": [
              "790132504"
            ]
          },
          "790132504": {
            "id": "790132504",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "只有吃到苦头的人才能吸取到教训呢…",
            "nextDialogs": [
              "790132505"
            ]
          },
          "790132505": {
            "id": "790132505",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "#这个海底的建筑…应该就是水池那一边岛上，山上的遗迹…{NICKNAME}，我们去水池里的岛上看看吧。"
          }
        }
      }
    },
    {
      "subId": "7901312",
      "subQuestName": "前往水池中岛上的笔记遗留之处",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "790131201"
        ],
        "dialogs": {
          "790131201": {
            "id": "790131201",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "留在这里应该够显眼了吧！",
            "nextDialogs": [
              "790131202"
            ]
          },
          "790131202": {
            "id": "790131202",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "希望沃尔夫冈能够看到，不要再跑到这个遗迹的密室里来了…",
            "nextDialogs": [
              "790131203"
            ]
          },
          "790131203": {
            "id": "790131203",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "我们回去看看吧，说不定这次笔记也会有变化啦。"
          }
        }
      }
    },

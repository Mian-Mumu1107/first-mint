    {
      "subId": "7901306",
      "subQuestName": "找到打开密室的办法",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "790130601"
        ],
        "dialogs": {
          "790130601": {
            "id": "790130601",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "嗯！就在这里留言吧，这下他应该能看得见了！",
            "nextDialogs": [
              "790130602"
            ]
          },
          "790130602": {
            "id": "790130602",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "我们现在回到水池外的岛上吧…说不定就没有那本笔记了！"
          }
        }
      }
    },
    {
      "subId": "7901329",
      "subQuestName": "与派蒙对话",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "790131101"
        ],
        "dialogs": {
          "790131101": {
            "id": "790131101",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "门打开了！真是有点麻烦的机关…",
            "nextDialogs": [
              "790131102"
            ]
          },
          "790131102": {
            "id": "790131102",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "#{NICKNAME}，这里好像还没有沃尔夫冈的笔记…",
            "nextDialogs": [
              "790131103"
            ]
          },
          "790131103": {
            "id": "790131103",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "说明他还没来过…",
            "nextDialogs": [
              "790131104"
            ]
          },
          "790131104": {
            "id": "790131104",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "那我们就算提前帮他解开密室了…这下他就不会被关起来了吧！",
            "nextDialogs": [
              "790131107"
            ]
          },
          "790131107": {
            "id": "790131107",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "那怎么办呀…唔，不如我们给他留言！",
            "nextDialogs": [
              "790131108"
            ]
          },
          "790131108": {
            "id": "790131108",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "我们用刻痕，把留言留在比较显眼的地方，告诉他解开机关的方法吧！"
          }
        }
      }
    },

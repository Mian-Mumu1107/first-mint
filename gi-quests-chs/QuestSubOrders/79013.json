    {
      "subId": "7901323",
      "subQuestName": "与派蒙对话",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "790132401"
        ],
        "dialogs": {
          "790132401": {
            "id": "790132401",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "他居然真的从那个密室里逃出来了诶！居然还夸自己细心…留言的刻痕明明就是我们特意留在显眼处的！",
            "nextDialogs": [
              "790132410"
            ]
          },
          "790132410": {
            "id": "790132410",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "还有，这个人到底随身带着多少本笔记本啊…",
            "nextDialogs": [
              "790132402"
            ]
          },
          "790132402": {
            "id": "790132402",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "唉…没想到他被关密室，居然没有回去，还敢继续冒险…",
            "nextDialogs": [
              "790132405"
            ]
          },
          "790132405": {
            "id": "790132405",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "是哦，原本将他一直困着的密室，现在就变成了他轻易克服的困难之一啦…",
            "nextDialogs": [
              "790132406"
            ]
          },
          "790132406": {
            "id": "790132406",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "不过，他说的山上的遗迹，在水池外的岛上就看不见了。",
            "nextDialogs": [
              "790132407"
            ]
          },
          "790132407": {
            "id": "790132407",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "毕竟过了很久嘛…",
            "nextDialogs": [
              "790132408"
            ]
          },
          "790132408": {
            "id": "790132408",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "不会是崩塌了，然后落到海里去了吧…总觉得好像在外面的海面上看到过类似的建筑…",
            "nextDialogs": [
              "790132409"
            ]
          },
          "790132409": {
            "id": "790132409",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "我们有空的时候就到附近的海上看看吧！"
          }
        }
      }
    },
    {
      "subId": "7901311",
      "subQuestName": "前往海面遗迹寻找沃尔夫冈的踪迹",
      "sceneId": null,
      "locations": [],

    {
      "subId": "7901302",
      "subQuestName": "与派蒙对话",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "790130201"
        ],
        "dialogs": {
          "790130201": {
            "id": "790130201",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "嗯，甜甜花酿鸡真的很好吃。",
            "nextDialogs": [
              "790130202"
            ]
          },
          "790130202": {
            "id": "790130202",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "确实能理解为什么这个叫「沃尔夫冈」的冒险家会念念不忘呢！",
            "nextDialogs": [
              "790130203"
            ]
          },
          "790130203": {
            "id": "790130203",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "不过被关在这里，最后连甜甜花酿鸡都吃不到，真是可怜…",
            "nextDialogs": [
              "790130206"
            ]
          },
          "790130206": {
            "id": "790130206",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "#是哦…但是这么说来…{NICKNAME}，还记得我们从岛上的水池那样的东西进入另一边的岛吗…",
            "nextDialogs": [
              "790130217"
            ]
          },
          "790130217": {
            "id": "790130217",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "水池里岛上的建筑比起水池外的岛，看上去要完整很多。",
            "nextDialogs": [
              "790130218"
            ]
          },
          "790130218": {
            "id": "790130218",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "现在岛上的建筑跟那里的建筑比起来，就像遗迹一样…"
          }
        }
      }
    },

        "dialogs": {
          "739180101": {
            "id": "739180101",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "巡林官可能会有异议。",
            "nextDialogs": [
              "739180102"
            ]
          },
          "739180102": {
            "id": "739180102",
            "speakerId": 4171,
            "speakerName": "古拉布吉尔",
            "text": "那…当然是不能让他们知道的咯！",
            "nextDialogs": [
              "739180103"
            ]
          },
          "739180103": {
            "id": "739180103",
            "speakerId": 4171,
            "speakerName": "古拉布吉尔",
            "text": "有次不小心被一个长着大尾巴的巡林官碰到，我被狠狠敲了一通脑壳，可疼了。",
            "nextDialogs": [
              "739180104"
            ]
          },
          "739180104": {
            "id": "739180104",
            "speakerId": 4171,
            "speakerName": "古拉布吉尔",
            "text": "但你别说，被搜救犬们一路拖行到化城郭，也算是非常独特的记忆了。你也可以试试看。",
            "nextDialogs": [
              "739180105"
            ]
          },
          "739180105": {
            "id": "739180105",
            "speakerId": 4171,
            "speakerName": "古拉布吉尔",
            "text": "…开玩笑的！为了你自己的安全，还是要听巡林官的话。",
            "nextDialogs": [
              "739180106"
            ]
          },
          "739180106": {
            "id": "739180106",
            "speakerId": 4171,
            "speakerName": "古拉布吉尔",
            "text": "毕竟雨林里不光只有不能吃的东西，安全的食材也能做出美味的佳肴。"
          }
        }
      }
    }
  ]
}
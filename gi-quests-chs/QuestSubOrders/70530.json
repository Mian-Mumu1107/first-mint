  "subQuests": [
    {
      "subId": "7053001",
      "subQuestName": "前往蒙德城侧门，寻找法斯宾",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [],
        "dialogs": {}
      }
    },
    {
      "subId": "7053002",
      "subQuestName": "与法斯宾对话",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "705300201"
        ],
        "dialogs": {
          "705300201": {
            "id": "705300201",
            "speakerId": 1000,
            "speakerName": "法斯宾",
            "text": "旅行者！旅行者，请留步！",
            "nextDialogs": [
              "705300202"
            ]
          },
          "705300202": {
            "id": "705300202",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "你这里在举办什么活动？",
            "nextDialogs": [
              "705300203"
            ]
          },
          "705300203": {
            "id": "705300203",
            "speakerId": 1000,
            "speakerName": "法斯宾",
            "text": "举办活动？不不不，我可没那个精力，也没那个能力。",
            "nextDialogs": [
              "705300204"
            ]
          },
          "705300204": {
            "id": "705300204",
            "speakerId": 1000,
            "speakerName": "法斯宾",
            "text": "我就是对「留影」这件事很有兴趣，前段时间还托人弄了一台「留影机」回来，拍了好多画片。",
            "nextDialogs": [
              "705300205"
            ]
          },
          "705300205": {
            "id": "705300205",
            "speakerId": 1000,
            "speakerName": "法斯宾",
            "text": "但协会里的人似乎还挺喜欢这种画片…塞琉斯先生说，可以把这些画片整理成册，以后当做纪念品送出去。",
            "nextDialogs": [
              "705300206"
            ]
          },
          "705300206": {
            "id": "705300206",
            "speakerId": 1000,
            "speakerName": "法斯宾",
            "text": "最近正好是风花节，塞琉斯先生就让我去蒙德各处拍一些和风花节有关的画片回来。",
            "nextDialogs": [
              "705300207"
            ]
          },
          "705300207": {
            "id": "705300207",
            "speakerId": 1000,
            "speakerName": "法斯宾",
            "text": "他想要整理一本风花节纪念画片集，送给协会里的各位冒险家。",
            "nextDialogs": [
              "705300208"
            ]
          },
          "705300208": {
            "id": "705300208",
            "speakerId": 1000,
            "speakerName": "法斯宾",
            "text": "但是…蒙德虽然有很多可以拍的地方，但我只有一个人…",
            "nextDialogs": [
              "705300209"
            ]
          },
          "705300209": {
            "id": "705300209",
            "speakerId": 1000,
            "speakerName": "法斯宾",
            "text": "协会里的冒险家们也都去忙自己的事了，没有空帮我。",
            "nextDialogs": [
              "705300210"
            ]
          },
          "705300210": {
            "id": "705300210",
            "speakerId": 1000,
            "speakerName": "法斯宾",
            "text": "虽然在风花节期间拜托人帮忙很不应该啦…但是旅行者！我听说你很擅长摆弄「留影机」，请你帮帮我吧！",
            "nextDialogs": [
              "705300212",
              "705300214"
            ]
          },
          "705300212": {
            "id": "705300212",
            "speakerId": 1000,
            "speakerName": "法斯宾",
            "text": "呼…那就好那就好，还好我打听得没错…",
            "nextDialogs": [
              "705300216"
            ]
          },
          "705300216": {
            "id": "705300216",
            "speakerId": 1000,
            "speakerName": "法斯宾",
            "text": "咳，说正事…旅行者，那我就正式拜托你，帮我去蒙德各处用「留影机」拍画片了。",
            "nextDialogs": [
              "705300217"
            ]
          },
          "705300217": {
            "id": "705300217",
            "speakerId": 1000,
            "speakerName": "法斯宾",
            "text": "对了，你就用我的这台「留影机」去拍画片吧，我平时一直在维护它，用起来很顺手的。",
            "nextDialogs": [
              "705300218"
            ]
          },
          "705300218": {
            "id": "705300218",
            "speakerId": 1000,
            "speakerName": "法斯宾",
            "text": "想要拍出好画片，那首先就要有一台好「留影机」，你说对吧？",
            "nextDialogs": [
              "705300219"
            ]
          },
          "705300219": {
            "id": "705300219",
            "speakerId": 1000,
            "speakerName": "法斯宾",
            "text": "那就辛苦你了啊，只要和风花节有关，无论什么画片都行！",
            "nextDialogs": [
              "705300220"
            ]
          },
          "705300220": {
            "id": "705300220",
            "speakerId": 1000,
            "speakerName": "法斯宾",
            "text": "报酬什么的你也不用担心，我会按照协会里的规矩算给你，保证不让你白跑。",
            "nextDialogs": [
              "705300221"
            ]
          },
          "705300221": {
            "id": "705300221",
            "speakerId": 1000,
            "speakerName": "法斯宾",
            "text": "我得先在这里整理一下画片，先分个类…"
          },
          "705300214": {
            "id": "705300214",
            "speakerId": 1000,
            "speakerName": "法斯宾",
            "text": "我是听协会里的冒险家们说的。他们之中也有不少「留影机」爱好者。",
            "nextDialogs": [
              "705300215"
            ]
          },
          "705300215": {
            "id": "705300215",
            "speakerId": 1000,
            "speakerName": "法斯宾",
            "text": "我们还准备搞个「留影机」爱好协会呢，也不知道塞琉斯先生同不同意…"
          }
        }
      }
    }
  ]
}
    {
      "subId": "7303203",
      "subQuestName": "在梦中的桓那兰那，与兰那罗共度无忧节",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "730320301"
        ],
        "dialogs": {
          "730320301": {
            "id": "730320301",
            "speakerId": 1003,
            "speakerName": "Black Screen",
            "text": "合唱结束后，兰那罗们陆陆续续散开了…",
            "nextDialogs": [
              "730320302"
            ]
          },
          "730320302": {
            "id": "730320302",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "#呜哇…好厉害哦！无论是{NICKNAME}的演奏，还是兰那罗的歌，都好好听！",
            "nextDialogs": [
              "730320303"
            ]
          },
          "730320303": {
            "id": "730320303",
            "speakerId": 1004,
            "speakerName": "兰修提袈",
            "text": "#嗯！那菈{NICKNAME}好厉害哦！好想和你一起旅行，记录你的歌！",
            "nextDialogs": [
              "730320307"
            ]
          },
          "730320307": {
            "id": "730320307",
            "speakerId": 1005,
            "speakerName": "兰加惟",
            "text": "#真是太精彩了，这样金光灿灿的歌！那菈{NICKNAME}和派蒙，还有你们的歌…真是值得写成叙事诗的好故事。",
            "nextDialogs": [
              "730320308"
            ]
          },
          "730320308": {
            "id": "730320308",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "不叫我「金色的那菈」了？",
            "nextDialogs": [
              "730320309"
            ]
          },
          "730320309": {
            "id": "730320309",
            "speakerId": 1005,
            "speakerName": "兰加惟",
            "text": "我经历过的时间很少…如果故事都属实，那菈法留纳的歌发出的光芒，或许也不如你的歌呢！",
            "nextDialogs": [
              "730320310"
            ]
          },
          "730320310": {
            "id": "730320310",
            "speakerId": 1006,
            "speakerName": "兰陀娑",
            "text": "♪~",
            "nextDialogs": [
              "730320311"
            ]
          },
          "730320311": {
            "id": "730320311",
            "speakerId": 1005,
            "speakerName": "兰加惟",
            "text": "#…嗯！兰陀娑说得对。这些是我们的心意，那菈{NICKNAME}、派蒙，收下吧。",
            "nextDialogs": [
              "730320312"
            ]
          },
          "730320312": {
            "id": "730320312",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "啊，好多小花…",
            "nextDialogs": [
              "730320313"
            ]
          },
          "730320313": {
            "id": "730320313",
            "speakerId": 1007,
            "speakerName": "兰耶娑",
            "text": "「尽管地平线如此灰暗…能与你相遇，是何等幸福…」",
            "nextDialogs": [
              "730320314"
            ]
          },
          "730320314": {
            "id": "730320314",
            "speakerId": 1006,
            "speakerName": "兰陀娑",
            "text": "「…将你的歌永远唱下去，这是我与你之间的约定。」"
          }
        }
      }
    },
    {
      "subId": "7303212",
      "subQuestName": "",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "730321201"
        ],
        "dialogs": {
          "730321201": {
            "id": "730321201",
            "speakerId": 1008,
            "speakerName": "兰难世",
            "text": "兰梨娄，那菈有个咒语，可以找到藏起来的那菈。是这样的：「咖喱~咖喱的香味~就是孩子们回家的信号~♪」",
            "nextDialogs": [
              "730321202"
            ]
          },
          "730321202": {
            "id": "730321202",
            "speakerId": 1009,
            "speakerName": "兰梨娄",
            "text": "但是，「咖喱」是什么呀？",
            "nextDialogs": [
              "730321203"
            ]
          },
          "730321203": {
            "id": "730321203",
            "speakerId": 1008,
            "speakerName": "兰难世",
            "text": "唔…不知道耶，但是，听说小那菈听到这个咒语，就会跑出来！所以，如果要找小那菈，就可以用这个咒语！"
          }
        }
      }
    },
    {
      "subId": "7303213",
      "subQuestName": "",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "730321301"
        ],
        "dialogs": {
          "730321301": {
            "id": "730321301",
            "speakerId": 1010,
            "speakerName": "兰伊舍",
            "text": "无忧节有兰伊舍的好吃的谜语，也「香甜可口」！听说那菈都喜欢「香甜可口」的东西…",
            "nextDialogs": [
              "730321302"
            ]
          },
          "730321302": {
            "id": "730321302",
            "speakerId": 1010,
            "speakerName": "兰伊舍",
            "text": "这次的「香甜可口」的无忧节，那菈一定也喜欢吧？"
          }
        }
      }
    },
    {
      "subId": "7303214",
      "subQuestName": "",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "730321401"
        ],
        "dialogs": {
          "730321401": {
            "id": "730321401",
            "speakerId": 1011,
            "speakerName": "兰犍多",
            "text": "谢谢你，那菈！兰犍多好快乐！"
          }
        }
      }
    },
    {
      "subId": "7303215",
      "subQuestName": "",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "730321501"
        ],
        "dialogs": {
          "730321501": {
            "id": "730321501",
            "speakerId": 1005,
            "speakerName": "兰加惟",
            "text": "#哦？是那菈{NICKNAME}！全靠你、派蒙和兰罗摩，我们学到了许多原本已经失落的曲子。",
            "nextDialogs": [
              "730321502"
            ]
          },
          "730321502": {
            "id": "730321502",
            "speakerId": 1005,
            "speakerName": "兰加惟",
            "text": "你对「歌」的艺术，也有深刻的理解吧！",
            "nextDialogs": [
              "730321507",
              "730321506"
            ]
          },
          "730321507": {
            "id": "730321507",
            "speakerId": 1005,
            "speakerName": "兰加惟",
            "text": "那就请你…用那菈的话怎么说来着？「把耳朵洗干净好好听着」…什么的。"
          },
          "730321506": {
            "id": "730321506",
            "speakerId": 1005,
            "speakerName": "兰加惟",
            "text": "#哈哈哈，那菈{NICKNAME}真风趣。"
          }
        }
      }
    },
    {
      "subId": "7303216",
      "subQuestName": "",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "730321601"
        ],
        "dialogs": {
          "730321601": {
            "id": "730321601",
            "speakerId": 1007,
            "speakerName": "兰耶娑",
            "text": "#「即使你要让{M#她}{F#他}的双眸蒙上阴霾，也无法从{M#她}{F#他}的心中夺走光…」"
          }
        }
      }
    },
    {
      "subId": "7303217",

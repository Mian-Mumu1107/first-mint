  "subQuests": [
    {
      "subId": "7303201",
      "subQuestName": "",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "730320101"
        ],
        "dialogs": {
          "730320101": {
            "id": "730320101",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "兰拉迦！我们回来啦！",
            "nextDialogs": [
              "730320102"
            ]
          },
          "730320102": {
            "id": "730320102",
            "speakerId": 1001,
            "speakerName": "兰拉迦",
            "text": "哎呀…你们回来了。大家已经等不及了。",
            "nextDialogs": [
              "730320103"
            ]
          },
          "730320103": {
            "id": "730320103",
            "speakerId": 1002,
            "speakerName": "兰罗摩",
            "text": "嗯。无忧节已经开始了，但又没有完全开始。因为，那菈朋友才刚刚回来。",
            "nextDialogs": [
              "730320107",
              "730320106"
            ]
          },
          "730320107": {
            "id": "730320107",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "#一直在外面冒险也挺累的，我们一起好好过无忧节吧，{NICKNAME}！",
            "nextDialogs": [
              "730320108"
            ]
          },
          "730320108": {
            "id": "730320108",
            "speakerId": 1002,
            "speakerName": "兰罗摩",
            "text": "#那菈{NICKNAME}、派蒙，一定要尽兴喔。",
            "nextDialogs": [
              "730320109"
            ]
          },
          "730320109": {
            "id": "730320109",
            "speakerId": 1001,
            "speakerName": "兰拉迦",
            "text": "嗯。我们稍后再见吧。"
          },
          "730320106": {
            "id": "730320106",
            "speakerId": 1001,
            "speakerName": "兰拉迦",
            "text": "依老身所知，就是这么一回事…"
          }
        }
      }
    },

      }
    },
    {
      "subId": "7303218",
      "subQuestName": "",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "730321801"
        ],
        "dialogs": {
          "730321801": {
            "id": "730321801",
            "speakerId": 1004,
            "speakerName": "兰修提袈",
            "text": "#那菈{NICKNAME}，你回来啦！和你一起过无忧节，是能变成歌的故事！"
          }
        }
      }
    },
    {
      "subId": "7303219",
      "subQuestName": "",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "730321901"
        ],
        "dialogs": {
          "730321901": {
            "id": "730321901",
            "speakerId": 1001,
            "speakerName": "兰拉迦",
            "text": "哎呀，老身十分感动…"
          }
        }
      }
    },
    {
      "subId": "7303220",
      "subQuestName": "",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "730322001"
        ],
        "dialogs": {
          "730322001": {
            "id": "730322001",
            "speakerId": 1005,
            "speakerName": "兰加惟",
            "text": "「金色的那菈」，接下来我们要一起歌唱。我们的大乐章，就由你开始吧！"
          }
        }
      }
    },
    {
      "subId": "7303221",
      "subQuestName": "",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "730322101"
        ],
        "dialogs": {
          "730322101": {
            "id": "730322101",
            "speakerId": 1004,
            "speakerName": "兰修提袈",
            "text": "让这首歌永远在桓那兰那回响吧！"
          }
        }
      }
    },
    {
      "subId": "7303211",
      "subQuestName": "与兰加惟对话",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "730321101"
        ],
        "dialogs": {
          "730321101": {
            "id": "730321101",
            "speakerId": 1012,
            "speakerName": "兰帕卡提",
            "text": "那菈的「快乐的味道」很怪…但是那菈开心，兰帕卡提和哥哥们也开心！",
            "nextDialogs": [
              "730321102"
            ]
          },
          "730321102": {
            "id": "730321102",
            "speakerId": 1013,
            "speakerName": "兰萨卡",
            "text": "「快乐的味道」当然是很好的，但、但是不只是「糖」的功劳。",
            "nextDialogs": [
              "730321103"
            ]
          },
          "730321103": {
            "id": "730321103",
            "speakerId": 1014,
            "speakerName": "兰茶荼",
            "text": "「一头菇」也是有功劳的！我朝思暮想的「一头菇」，它的芬芳，哈！",
            "nextDialogs": [
              "730321104"
            ]
          },
          "730321104": {
            "id": "730321104",
            "speakerId": 1015,
            "speakerName": "兰非拉",
            "text": "还有…还有「鲜嫩无朋之果」…",
            "nextDialogs": [
              "730321105"
            ]
          },
          "730321105": {
            "id": "730321105",
            "speakerId": 1016,
            "speakerName": "兰阿帕斯",
            "text": "还有桓那兰那的水！有了最好的水，才能烧出有「快乐的味道」的汤呢！"
          }
        }
      }
    },
    {
      "subId": "7303225",
      "subQuestName": "与兰加惟对话",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "730320201"
        ],
        "dialogs": {
          "730320201": {
            "id": "730320201",
            "speakerId": 1005,
            "speakerName": "兰加惟",
            "text": "哦哦，是金色的那菈呀。来得正好！",
            "nextDialogs": [
              "730320204"
            ]
          },
          "730320204": {
            "id": "730320204",
            "speakerId": 1005,
            "speakerName": "兰加惟",
            "text": "金色是很美好的颜色，它和阳光的颜色是一样的。在这么重要的场合，我想这样称呼你！",
            "nextDialogs": [
              "730320205"
            ]
          },
          "730320205": {
            "id": "730320205",
            "speakerId": 1004,
            "speakerName": "兰修提袈",
            "text": "#不过，在歌里，也会把你的名字记下来。那菈{NICKNAME}，这是很好的名字。很有音律感！",
            "nextDialogs": [
              "730320206"
            ]
          },
          "730320206": {
            "id": "730320206",
            "speakerId": 1006,
            "speakerName": "兰陀娑",
            "text": "♪~",
            "nextDialogs": [
              "730320207"
            ]
          },
          "730320207": {
            "id": "730320207",
            "speakerId": 1007,
            "speakerName": "兰耶娑",
            "text": "#「无论是瞳色还是心灵都如同黄金的太阳一般的{M#少年}{F#少女}…其名为那菈{NICKNAME}。」",
            "nextDialogs": [
              "730320208"
            ]
          },
          "730320208": {
            "id": "730320208",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "喂！还有我呢？不要忘记派蒙！",
            "nextDialogs": [
              "730320209"
            ]
          },
          "730320209": {
            "id": "730320209",
            "speakerId": 1007,
            "speakerName": "兰耶娑",
            "text": "「月光下的珍珠，白银一般纯净的那位，其名为派蒙…」",
            "nextDialogs": [
              "730320210"
            ]
          },
          "730320210": {
            "id": "730320210",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "嗯嗯！再多说一点？可以强调一下我们的友情…"
          }
        }
      }
    },
    {
      "subId": "7303205",
      "subQuestName": "在「舞台」旁，弹奏曲调",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "730320501"
        ],
        "dialogs": {
          "730320501": {
            "id": "730320501",
            "speakerId": 1002,
            "speakerName": "兰罗摩",
            "text": "嗯。其实我一直很想知道，为什么那菈要睡觉呢？",
            "nextDialogs": [
              "730320505",
              "730320504"
            ]
          },
          "730320505": {
            "id": "730320505",
            "speakerId": 1002,
            "speakerName": "兰罗摩",
            "text": "是这样喔！兰那罗只有在很危险、很危险的时候，才会「休眠」。我们会把自己变成小小的种子，然后进入没有梦的睡眠。",
            "nextDialogs": [
              "730320506"
            ]
          },
          "730320506": {
            "id": "730320506",
            "speakerId": 1002,
            "speakerName": "兰罗摩",
            "text": "但是，这样的话，就不能和大家在一起，所以是很可怕的事情。而且，要再变回来，还要感受到很多「回忆」才行…",
            "nextDialogs": [
              "730320507"
            ]
          },
          "730320507": {
            "id": "730320507",
            "speakerId": 1002,
            "speakerName": "兰罗摩",
            "text": "但你们那菈不同，要经常睡觉，而且，这样才能做梦。梦很宝贵，所以我理解。但是，好奇怪，最近大那菈都好少做梦了…",
            "nextDialogs": [
              "730320508"
            ]
          },
          "730320508": {
            "id": "730320508",
            "speakerId": 1002,
            "speakerName": "兰罗摩",
            "text": "不管怎么说，在这里可以放心睡觉。我们会看护好你们的梦，不让桓那吉之类的坏东西进来的。",
            "nextDialogs": [
              "730320509"
            ]
          },
          "730320509": {
            "id": "730320509",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "嗯，但是…",
            "nextDialogs": [
              "730320510"
            ]
          },
          "730320510": {
            "id": "730320510",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "都怪你们，老说「梦」的东西。我害怕遇到你们，和你们过无忧节，都是吃了蘑菇以后梦到的。如果醒来了，所有事情都会不见…",
            "nextDialogs": [
              "730320511"
            ]
          },
          "730320511": {
            "id": "730320511",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "醒来以后，我们还能见到你吗？",
            "nextDialogs": [
              "730320512"
            ]
          },
          "730320512": {
            "id": "730320512",
            "speakerId": 1002,
            "speakerName": "兰罗摩",
            "text": "当然！"
          },
          "730320504": {
            "id": "730320504",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "#咦？{NICKNAME}不觉得，睡觉是很舒服的事情吗？"
          }
        }
      }
    },
    {
      "subId": "7303209",
      "subQuestName": "",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "730320901"
        ],
        "dialogs": {
          "730320901": {
            "id": "730320901",
            "speakerId": 1017,
            "speakerName": "兰迦鲁",
            "text": "嘿嘿，无忧节好热闹，桓那兰那到处都是快乐！",
            "nextDialogs": [
              "730320902"
            ]
          },
          "730320902": {
            "id": "730320902",
            "speakerId": 1018,
            "speakerName": "兰纳真",
            "text": "但是无忧节会结束。兰那罗的那菈朋友，可能也会离开。",
            "nextDialogs": [
              "730320903"
            ]
          },
          "730320903": {
            "id": "730320903",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "森林会记住一切。",
            "nextDialogs": [
              "730320904"
            ]
          },
          "730320904": {
            "id": "730320904",
            "speakerId": 1019,
            "speakerName": "兰纳迦",
            "text": "森林会记住一切。但是…",
            "nextDialogs": [
              "730320905"
            ]
          },
          "730320905": {
            "id": "730320905",
            "speakerId": 1017,
            "speakerName": "兰迦鲁",
            "text": "希望不要有风，吹走快乐，让快乐多留一下。希望有雨，淋湿大地，留住那菈朋友，多停一下…"
          }
        }
      }
    },
    {
      "subId": "7303210",
      "subQuestName": "与「舞台」边的兰那罗们对话$HIDDEN",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [],
        "dialogs": {}
      }
    },
    {
      "subId": "7303206",
      "subQuestName": "寻找兰拉迦与兰罗摩",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "730320601"
        ],
        "dialogs": {
          "730320601": {
            "id": "730320601",
            "speakerId": 1001,
            "speakerName": "兰拉迦",
            "text": "哎呀，真是太开心了…希望你们也能开心。在无忧节当中，那菈朋友开心，就是我们最大的心愿。",
            "nextDialogs": [
              "730320602"
            ]
          },
          "730320602": {
            "id": "730320602",
            "speakerId": 1001,
            "speakerName": "兰拉迦",
            "text": "那菈的时间比兰那罗珍贵许多，老身便不耽误你们了，尽情享受吧。晚点你们去找找兰加惟，他也在准备无忧节的仪式。"
          }
        }
      }
    },
    {
      "subId": "7303224",
      "subQuestName": "寻找兰拉迦与兰罗摩$HIDDEN",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "730320401"
        ],
        "dialogs": {
          "730320401": {
            "id": "730320401",
            "speakerId": 1002,
            "speakerName": "兰罗摩",
            "text": "…上一次无忧节，是那菈法留纳的时候吧！在许多故事里、许多记忆里，那时候遍地都是无留陀。",
            "nextDialogs": [
              "730320402"
            ]
          },
          "730320402": {
            "id": "730320402",
            "speakerId": 1002,
            "speakerName": "兰罗摩",
            "text": "许多大树枯萎了，绿野变得枯黄。雨水也变成了很脏很坏的红色，和苹果的红色完全不同。很可怕很可怕！",
            "nextDialogs": [
              "730320403"
            ]
          },
          "730320403": {
            "id": "730320403",
            "speakerId": 1001,
            "speakerName": "兰拉迦",
            "text": "幸亏老身已经不记得了。当时许多孩子还没长成莎兰树，就回归了沙恒。但那时候有那菈法留纳，还有无忧节。",
            "nextDialogs": [
              "730320404"
            ]
          },
          "730320404": {
            "id": "730320404",
            "speakerId": 1002,
            "speakerName": "兰罗摩",
            "text": "嗯！那时候，你和我一样，是像种子一样，小小的兰那罗吧！",
            "nextDialogs": [
              "730320405"
            ]
          },
          "730320405": {
            "id": "730320405",
            "speakerId": 1001,
            "speakerName": "兰拉迦",
            "text": "#对。老身失去了很多记忆，但还记得那菈流泪的样子。从{M#她}{F#他}的眼睛里，掉下来有盐的水。但是，感觉却不可怕。",
            "nextDialogs": [
              "730320406"
            ]
          },
          "730320406": {
            "id": "730320406",
            "speakerId": 1001,
            "speakerName": "兰拉迦",
            "text": "#{M#她}{F#他}和老身说了很久很久，我们一起在森林里冒险的故事，所以那些故事没有失落。再后来，{M#她}{F#他}就离开了。",
            "nextDialogs": [
              "730320407"
            ]
          },
          "730320407": {
            "id": "730320407",
            "speakerId": 1001,
            "speakerName": "兰拉迦",
            "text": "#不知道{M#她}{F#他}在什么地方呢？和那菈{NICKNAME}很像。虽然都是那菈，但又像太阳一样温暖，金灿灿的。",
            "nextDialogs": [
              "730320408"
            ]
          },
          "730320408": {
            "id": "730320408",
            "speakerId": 1002,
            "speakerName": "兰罗摩",
            "text": "漂泊的种子一定会在好的土地发芽，那菈也一样！总有一天，在那菈心里吹的风会停止，然后那菈就会停下脚步。",
            "nextDialogs": [
              "730320409"
            ]
          },
          "730320409": {
            "id": "730320409",
            "speakerId": 1002,
            "speakerName": "兰罗摩",
            "text": "#但是，那菈{NICKNAME}和一般的那菈不一样。一定会一直漂泊，然后，有一天那菈{NICKNAME}也能遇到那菈法留纳吧！",
            "nextDialogs": [
              "730320410"
            ]
          },
          "730320410": {
            "id": "730320410",
            "speakerId": 1001,
            "speakerName": "兰拉迦",
            "text": "对，但是兰罗摩，你忘记了，那菈和兰那罗不一样，他们的时间很少。",
            "nextDialogs": [
              "730320411"
            ]
          },
          "730320411": {
            "id": "730320411",
            "speakerId": 1001,
            "speakerName": "兰拉迦",
            "text": "那菈法留纳的生命没有树木那么长久，梦和记忆也无法像我们那样结成果实互相分享。那菈是多么孤独、多么悲伤的生命啊。",
            "nextDialogs": [
              "730320412"
            ]
          },
          "730320412": {
            "id": "730320412",
            "speakerId": 1002,
            "speakerName": "兰罗摩",
            "text": "#…嗯。如果那菈{NICKNAME}是兰那罗该有多好！如果是那样的话，我们早就认识了，而且还有好多好多回忆在一起。",
            "nextDialogs": [
              "730320413"
            ]
          },
          "730320413": {
            "id": "730320413",
            "speakerId": 1001,
            "speakerName": "兰拉迦",
            "text": "森林会记住一切。老身终将会带着桓那兰那的所有记忆，与兰穆护昆达他们在沙恒中相会，就像河流进入大海。",
            "nextDialogs": [
              "730320414"
            ]
          },
          "730320414": {
            "id": "730320414",
            "speakerId": 1001,
            "speakerName": "兰拉迦",
            "text": "很久很久以前，桓那兰那因为那菈的灾难毁灭了，在此之后兰那罗就以梦为家园，不再亲近那菈。",
            "nextDialogs": [
              "730320415"
            ]
          },
          "730320415": {
            "id": "730320415",
            "speakerId": 1001,
            "speakerName": "兰拉迦",
            "text": "只有那菈法留纳，一直与兰那罗为友，在毁灭之后也一直帮助大家，兰那罗才一点一点再次相信那菈的。",
            "nextDialogs": [
              "730320416"
            ]
          },
          "730320416": {
            "id": "730320416",
            "speakerId": 1001,
            "speakerName": "兰拉迦",
            "text": "#分别的时候，{M#她}{F#他}对老身说，或许有一天会有一名与我一样的金色那菈来到你们身边。{M#他}{F#她}能带来更多更美好的记忆。",
            "nextDialogs": [
              "730320417"
            ]
          },
          "730320417": {
            "id": "730320417",
            "speakerId": 1001,
            "speakerName": "兰拉迦",
            "text": "#老身觉得，有你，还有那菈{NICKNAME}，也许我们已经准备好再次和那菈一起行走在森林里，一起唱歌、一起玩耍了。",
            "nextDialogs": [
              "730320418"
            ]
          },
          "730320418": {
            "id": "730320418",
            "speakerId": 1002,
            "speakerName": "兰罗摩",
            "text": "#不过，大家会相信那菈{NICKNAME}、派蒙，是因为他们真的很好。如果那菈都像那菈{NICKNAME}、那菈法留纳那么好，就没问题！",
            "nextDialogs": [
              "730320419"
            ]
          },
          "730320419": {
            "id": "730320419",
            "speakerId": 1002,
            "speakerName": "兰罗摩",
            "text": "兰拉迦好像老那菈哦，说这些事情！",
            "nextDialogs": [
              "730320420"
            ]
          },
          "730320420": {
            "id": "730320420",
            "speakerId": 1001,
            "speakerName": "兰拉迦",
            "text": "哎呀…能够过上无忧节，能够把花送给金灿灿的那菈，老身很高兴。但是，高兴之外，又想到了很多很多的事情…",
            "nextDialogs": [
              "730320421"
            ]
          },
          "730320421": {
            "id": "730320421",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "兰罗摩、兰拉迦！你们怎么在这里呀？",
            "nextDialogs": [
              "730320422"
            ]
          },
          "730320422": {
            "id": "730320422",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "#你们…该不会觉得那菈{NICKNAME}演奏不好听，所以跑了吧！",
            "nextDialogs": [
              "730320423"
            ]
          },
          "730320423": {
            "id": "730320423",
            "speakerId": 1002,
            "speakerName": "兰罗摩",
            "text": "#怎么会！听了那菈{NICKNAME}和大家一起的合唱，就像照着阳光一样，感觉很好很好。",
            "nextDialogs": [
              "730320424"
            ]
          },
          "730320424": {
            "id": "730320424",
            "speakerId": 1002,
            "speakerName": "兰罗摩",
            "text": "#但是，为了兰拉娜和那菈{NICKNAME}的愿望，惟耶之实很重要。所以，我要做准备。",
            "nextDialogs": [
              "730320425"
            ]
          },
          "730320425": {
            "id": "730320425",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "对哦！还有惟耶之实…",
            "nextDialogs": [
              "730320429",
              "730320428"
            ]
          },
          "730320429": {
            "id": "730320429",
            "speakerId": 1002,
            "speakerName": "兰罗摩",
            "text": "嗯！我刚刚去找「觉王之殿」了。唱歌结束以后，就走了。",
            "nextDialogs": [
              "730320430"
            ]
          },
          "730320430": {
            "id": "730320430",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "听起来像是和之前我们去过的那些「觉树之堂」有关的名字呢…",
            "nextDialogs": [
              "730320431"
            ]
          },
          "730320431": {
            "id": "730320431",
            "speakerId": 1001,
            "speakerName": "兰拉迦",
            "text": "呵呵…派蒙就像月光一样敏锐。「觉王的梦之树」就在那里，它是很古老、很强壮的莎兰树，有结出惟耶之实的力量。",
            "nextDialogs": [
              "730320432"
            ]
          },
          "730320432": {
            "id": "730320432",
            "speakerId": 1001,
            "speakerName": "兰拉迦",
            "text": "不过，老身不记得在什么地方了，又无法离开桓那兰那的梦，所以只能靠兰罗摩去找了。",
            "nextDialogs": [
              "730320433"
            ]
          },
          "730320433": {
            "id": "730320433",
            "speakerId": 1002,
            "speakerName": "兰罗摩",
            "text": "#嗯！不用担心！就像那菈{NICKNAME}和派蒙说的那样，「交给我吧」！"
          },
          "730320428": {
            "id": "730320428",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "#哼，都怪{NICKNAME}做的「无忧节大餐」太好吃，我都差点忘了。"
          }
        }
      }
    },
    {

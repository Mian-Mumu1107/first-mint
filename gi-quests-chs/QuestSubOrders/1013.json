    {
      "subId": "101317",
      "subQuestName": "（test）判断讲价1结束$HIDDEN",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "10131701"
        ],
        "dialogs": {
          "10131701": {
            "id": "10131701",
            "speakerId": 1006,
            "speakerName": "「公子」",
            "text": "哟？事办妥了？余下的钱就不用还了，自己拿去吧，替愚人众办事的人是不会吃亏的。",
            "nextDialogs": [
              "10131702"
            ]
          },
          "10131702": {
            "id": "10131702",
            "speakerId": 1002,
            "speakerName": "派蒙",
            "text": "哼，这种嗟来之食，难道能收买我——下一笔资金你什么时候给？",
            "nextDialogs": [
              "10131703"
            ]
          },
          "10131703": {
            "id": "10131703",
            "speakerId": 1006,
            "speakerName": "「公子」",
            "text": "哈哈，有一个消息，只要你们能告诉我，我就把「北国银行」的金库，对你开放半小时。",
            "nextDialogs": [
              "10131704"
            ]
          },
          "10131704": {
            "id": "10131704",
            "speakerId": 1002,
            "speakerName": "派蒙",
            "text": "什么消息？！",
            "nextDialogs": [
              "10131705"
            ]
          },
          "10131705": {
            "id": "10131705",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "不行。",
            "nextDialogs": [
              "10131706"
            ]
          },
          "10131706": {
            "id": "10131706",
            "speakerId": 1002,
            "speakerName": "派蒙",
            "text": "#咦？你知道他想要什么吗，{NICKNAME}？",
            "nextDialogs": [
              "10131709"
            ]
          },
          "10131709": {
            "id": "10131709",
            "speakerId": 1002,
            "speakerName": "派蒙",
            "text": "啊！在蒙德，愚人众的「女士」…",
            "nextDialogs": [
              "10131710"
            ]
          },
          "10131710": {
            "id": "10131710",
            "speakerId": 1006,
            "speakerName": "「公子」",
            "text": "……",
            "nextDialogs": [
              "10131711"
            ]
          },
          "10131711": {
            "id": "10131711",
            "speakerId": 1006,
            "speakerName": "「公子」",
            "text": "#好了好了，真是的，{NICKNAME}在说什么呢。",
            "nextDialogs": [
              "10131712"
            ]
          },
          "10131712": {
            "id": "10131712",
            "speakerId": 1006,
            "speakerName": "「公子」",
            "text": "我们这是怎么了？刚才的气氛好奇怪啊。",
            "nextDialogs": [
              "10131713"
            ]
          },
          "10131713": {
            "id": "10131713",
            "speakerId": 1002,
            "speakerName": "派蒙",
            "text": "呜…",
            "nextDialogs": [
              "10131714"
            ]
          },
          "10131714": {
            "id": "10131714",
            "speakerId": 1001,
            "speakerName": "钟离",
            "text": "接下来为了「永生香」，我们要去一趟「不卜庐」。那是璃月港里最有名的药庐——嗯？",
            "nextDialogs": [
              "10131715"
            ]
          },
          "10131715": {
            "id": "10131715",
            "speakerId": 1001,
            "speakerName": "钟离",
            "text": "你们怎么了？",
            "nextDialogs": [
              "10131716"
            ]
          },
          "10131716": {
            "id": "10131716",
            "speakerId": 1006,
            "speakerName": "「公子」",
            "text": "呵…没什么。我正在跟他们说余下的钱不用还了。",
            "nextDialogs": [
              "10131717"
            ]
          },
          "10131717": {
            "id": "10131717",
            "speakerId": 1006,
            "speakerName": "「公子」",
            "text": "那么，我们就此别过吧。"
          }
        }
      }
    },

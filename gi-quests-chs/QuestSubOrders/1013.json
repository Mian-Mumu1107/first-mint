    {
      "subId": "101304",
      "subQuestName": "与阿大沟通",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "10130401"
        ],
        "dialogs": {
          "10130401": {
            "id": "10130401",
            "speakerId": 1003,
            "speakerName": "阿大",
            "text": "算了算了！看来是我太好说话了！两万摩拉！一摩拉不少！不行的话就别雇老子了！",
            "nextDialogs": [
              "10130402"
            ]
          },
          "10130402": {
            "id": "10130402",
            "speakerId": 1002,
            "speakerName": "派蒙",
            "text": "#别，别动气呀…唉，{NICKNAME}，没办法，这下我们只能付全额了吧。"
          }
        }
      }
    },

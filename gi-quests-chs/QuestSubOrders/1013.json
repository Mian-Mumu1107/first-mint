  "subQuests": [
    {
      "subId": "101301",
      "subQuestName": "前往购买风筝",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "10130101"
        ],
        "dialogs": {
          "10130101": {
            "id": "10130101",
            "speakerId": 1000,
            "speakerName": "阿山婆",
            "text": "客人，来啦？之前预定的七只风筝都已经扎好了，是现在要取么？",
            "nextDialogs": [
              "10130102"
            ]
          },
          "10130102": {
            "id": "10130102",
            "speakerId": 1001,
            "speakerName": "钟离",
            "text": "是的，辛苦了。",
            "nextDialogs": [
              "10130103"
            ]
          },
          "10130103": {
            "id": "10130103",
            "speakerId": 1000,
            "speakerName": "阿山婆",
            "text": "这年头，愿意买这式样风筝的客人，还真少见。要说早年间，倒是有些三教九流的朋友会用上…",
            "nextDialogs": [
              "10130104"
            ]
          },
          "10130104": {
            "id": "10130104",
            "speakerId": 1002,
            "speakerName": "派蒙",
            "text": "嗯，这位钟离先生是「往生堂」的客卿，所以他对三教九流的游戏规则也都能理解吧。",
            "nextDialogs": [
              "10130105"
            ]
          },
          "10130105": {
            "id": "10130105",
            "speakerId": 1002,
            "speakerName": "派蒙",
            "text": "不过，这次旅途里跟钟离闲聊的东西，还远远不止这些…",
            "nextDialogs": [
              "10130108"
            ]
          },
          "10130108": {
            "id": "10130108",
            "speakerId": 1002,
            "speakerName": "派蒙",
            "text": "唔…他好像也能接上璃月人最爱的金融和政治话题，但却更喜欢说那些比较「无用」的知识呢。",
            "nextDialogs": [
              "10130109"
            ]
          },
          "10130109": {
            "id": "10130109",
            "speakerId": 1001,
            "speakerName": "钟离",
            "text": "哈哈…因为我更愿意把这些趣事分享给你们。",
            "nextDialogs": [
              "10130110"
            ]
          },
          "10130110": {
            "id": "10130110",
            "speakerId": 1000,
            "speakerName": "阿山婆",
            "text": "哎呀，孩子的玩具就是很有趣的东西嘛。不过…虽然我也挺喜欢看孩子笑，但毕竟，还有点别的念想。",
            "nextDialogs": [
              "10130111"
            ]
          },
          "10130111": {
            "id": "10130111",
            "speakerId": 1000,
            "speakerName": "阿山婆",
            "text": "精巧的玩意，总能讨孩子喜欢。但这份「精巧」也是千多年的积淀，背后都是有「意义」的。",
            "nextDialogs": [
              "10130112"
            ]
          },
          "10130112": {
            "id": "10130112",
            "speakerId": 1000,
            "speakerName": "阿山婆",
            "text": "我在璃月做了四十年风筝，对祖上传下的式样一清二楚。这位客人订的七只风筝，意义可不一般。",
            "nextDialogs": [
              "10130113"
            ]
          },
          "10130113": {
            "id": "10130113",
            "speakerId": 1001,
            "speakerName": "钟离",
            "text": "没错。这是「送仙典仪」用的饰物，七只风筝…象征七神。",
            "nextDialogs": [
              "10130114"
            ]
          },
          "10130114": {
            "id": "10130114",
            "speakerId": 1000,
            "speakerName": "阿山婆",
            "text": "呵呵呵…敬献风神的纹样，我特意把颜色「自由」地涂出了界。",
            "nextDialogs": [
              "10130115"
            ]
          },
          "10130115": {
            "id": "10130115",
            "speakerId": 1000,
            "speakerName": "阿山婆",
            "text": "至于敬献岩神的，就要好好按照「契约」来画咯。这种花纹是很古的，在「黄金屋」里也找得到呢。",
            "nextDialogs": [
              "10130116"
            ]
          },
          "10130116": {
            "id": "10130116",
            "speakerId": 1002,
            "speakerName": "派蒙",
            "text": "啊，「黄金屋」，这个名字我最近听过——"
          }
        }
      }
    },
    {

            ]
          },
          "10130509": {
            "id": "10130509",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "请你去找一个叫「公子」的人…",
            "nextDialogs": [
              "10130510"
            ]
          },
          "10130510": {
            "id": "10130510",
            "speakerId": 1003,
            "speakerName": "阿大",
            "text": "「公子」？不去不去。他要帮你报销？那也不去。本来跑一趟腿的，这不是要变成跑两趟了么。",
            "nextDialogs": [
              "10130511"
            ]
          },
          "10130511": {
            "id": "10130511",
            "speakerId": 1003,
            "speakerName": "阿大",
            "text": "这样吧，我们一码归一码。你剩的这些钱我都先收了，然后…",
            "nextDialogs": [
              "10130512"
            ]
          },
          "10130512": {
            "id": "10130512",
            "speakerId": 1003,
            "speakerName": "阿大",
            "text": "给我一朵<color=#00E1FFFF>清心</color>，我就当做抵了这段额外路费，再去找那个什么「公子」，怎样？",
            "nextDialogs": [
              "10130513"
            ]
          },
          "10130513": {
            "id": "10130513",
            "speakerId": 1002,
            "speakerName": "派蒙",
            "text": "唔…看来只能这样了吧。"
          }
        }
      }
    },
    {
      "subId": "101306",
      "subQuestName": "将清心带给阿大",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "10139301"
        ],
        "dialogs": {
          "10139301": {
            "id": "10139301",
            "speakerId": 1003,
            "speakerName": "阿大",
            "text": "东西带来了么？",
            "nextDialogs": [
              "10139302"
            ]
          },
          "10139302": {
            "id": "10139302",
            "speakerId": 1003,
            "speakerName": "阿大",
            "text": "嘿，挺好。这玩意还挺少见的，我自己可不知道上哪采…",
            "nextDialogs": [
              "10139303"
            ]
          },
          "10139303": {
            "id": "10139303",
            "speakerId": 1003,
            "speakerName": "阿大",
            "text": "有这「清心」，晚上回家，小姑娘大概就不会那么闹了吧。嗯…回家以前，我就先为你走一遭。"
          }
        }
      }
    },
    {
      "subId": "101307",
      "subQuestName": "寻找三位工人$HIDDEN",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "10130701"
        ],
        "dialogs": {
          "10130701": {
            "id": "10130701",
            "speakerId": 1004,
            "speakerName": "阿二",
            "text": "去玉京台做一天杂活是吧？我没问题。一天<color=#00E1FFFF>两万五</color>，公平交易。",
            "nextDialogs": [
              "10130702"
            ]
          },
          "10130702": {
            "id": "10130702",
            "speakerId": 1002,
            "speakerName": "派蒙",
            "text": "哇，这个出价有点贵耶…可不可以看在这位「拯救蒙德的英雄」的面子上，稍微便宜一点？",
            "nextDialogs": [
              "10130703"
            ]
          },
          "10130703": {
            "id": "10130703",
            "speakerId": 1004,
            "speakerName": "阿二",
            "text": "拯救蒙德的英雄？没听说过。",
            "nextDialogs": [
              "10130704"
            ]
          },
          "10130704": {
            "id": "10130704",
            "speakerId": 1001,
            "speakerName": "钟离",
            "text": "英雄没听说过，没关系，摩拉总听说过吧？我全额付。"
          }
        }
      }
    },

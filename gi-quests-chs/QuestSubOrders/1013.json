    {
      "subId": "101303",
      "subQuestName": "寻找三位工人$HIDDEN",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "10130301"
        ],
        "dialogs": {
          "10130301": {
            "id": "10130301",
            "speakerId": 1003,
            "speakerName": "阿大",
            "text": "哦？帮工？可以啊，我阿大做事一向百分百出力。当然，要百分之一百二出力的话，价钱另算。",
            "nextDialogs": [
              "10130302"
            ]
          },
          "10130302": {
            "id": "10130302",
            "speakerId": 1003,
            "speakerName": "阿大",
            "text": "说说看，你们要做什么？",
            "nextDialogs": [
              "10130303"
            ]
          },
          "10130303": {
            "id": "10130303",
            "speakerId": 1001,
            "speakerName": "钟离",
            "text": "我想想…玉京台那边，还缺些木制的用具。因为不是什么稀罕物件，我就没特地准备了。",
            "nextDialogs": [
              "10130304"
            ]
          },
          "10130304": {
            "id": "10130304",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "勇士！50根树枝、20捆木材！",
            "nextDialogs": [
              "10130305"
            ]
          },
          "10130305": {
            "id": "10130305",
            "speakerId": 1003,
            "speakerName": "阿大",
            "text": "没问题。跑一趟只收<color=#00E1FFFF>两万摩拉</color>，如何？",
            "nextDialogs": [
              "10130306"
            ]
          },
          "10130306": {
            "id": "10130306",
            "speakerId": 1001,
            "speakerName": "钟离",
            "text": "好，成交。"
          }
        }
      }
    },
    {
      "subId": "101321",
      "subQuestName": "寻找三位工人",
      "sceneId": null,
      "locations": [],

    {
      "subId": "101311",
      "subQuestName": "寻找三位工人$HIDDEN",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "10131101"
        ],
        "dialogs": {
          "10131101": {
            "id": "10131101",
            "speakerId": 1005,
            "speakerName": "阿三",
            "text": "帮工？行呀，但我可先说好，我阿三是冒险家协会的候补成员，欢迎冒险委托，谢绝文书工作。",
            "nextDialogs": [
              "10131102"
            ]
          },
          "10131102": {
            "id": "10131102",
            "speakerId": 1001,
            "speakerName": "钟离",
            "text": "冒险…去深山里抓几只仪式上用的晶蝶，似乎是有那么些冒险意味。",
            "nextDialogs": [
              "10131103"
            ]
          },
          "10131103": {
            "id": "10131103",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "勇敢的冒险者啊，我要5只晶蝶。",
            "nextDialogs": [
              "10131104"
            ]
          },
          "10131104": {
            "id": "10131104",
            "speakerId": 1005,
            "speakerName": "阿三",
            "text": "哎？这活也不算难，有失我候补冒险家的身份…算了，那我就只收<color=#00E1FFFF>一万五千摩拉</color>吧，怎么样？",
            "nextDialogs": [
              "10131105"
            ]
          },
          "10131105": {
            "id": "10131105",
            "speakerId": 1001,
            "speakerName": "钟离",
            "text": "很公道的价格。"
          }
        }
      }
    },
    {
      "subId": "101323",
      "subQuestName": "寻找三位工人",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [],
        "dialogs": {}
      }
    },
    {
      "subId": "101312",
      "subQuestName": "与阿三沟通",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "10131201"
        ],
        "dialogs": {
          "10131201": {
            "id": "10131201",
            "speakerId": 1005,
            "speakerName": "阿三",
            "text": "一万五千摩拉！一摩拉不少！一万五已经很低了！这都不行？嗯？！",
            "nextDialogs": [
              "10131202"
            ]
          },
          "10131202": {
            "id": "10131202",
            "speakerId": 1002,
            "speakerName": "派蒙",
            "text": "#别，别动气呀…唉，{NICKNAME}，没办法，这下我们只能付全额了吧。"
          }
        }
      }
    },
    {
      "subId": "101313",
      "subQuestName": "收集铁块",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "10131301"
        ],
        "dialogs": {
          "10131301": {
            "id": "10131301",
            "speakerId": 1005,
            "speakerName": "阿三",
            "text": "帮工？行呀，但我可先说好，我阿三是冒险家协会的候补成员，欢迎冒险委托，谢绝文书工作。",
            "nextDialogs": [
              "10131302"
            ]
          },
          "10131302": {
            "id": "10131302",
            "speakerId": 1001,
            "speakerName": "钟离",
            "text": "冒险…去深山里抓几只仪式上用的晶蝶，似乎是有那么些冒险意味。",
            "nextDialogs": [
              "10131303"
            ]
          },
          "10131303": {
            "id": "10131303",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "勇敢的冒险者啊，我要5只晶蝶。",
            "nextDialogs": [
              "10131304"
            ]
          },
          "10131304": {
            "id": "10131304",
            "speakerId": 1005,
            "speakerName": "阿三",
            "text": "哎？这活也不算难，有失我候补冒险家的身份…算了，那我就只收<color=#00E1FFFF>一万五千摩拉</color>吧，怎么样？",
            "nextDialogs": [
              "10131305"
            ]
          },
          "10131305": {
            "id": "10131305",
            "speakerId": 1001,
            "speakerName": "钟离",
            "text": "很公道的价格。",
            "nextDialogs": [
              "10131306"
            ]
          },
          "10131306": {
            "id": "10131306",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "不…带的钱好像太少了…",
            "nextDialogs": [
              "10131307"
            ]
          },
          "10131307": {
            "id": "10131307",
            "speakerId": 1005,
            "speakerName": "阿三",
            "text": "就这点？那就没办法了。",
            "nextDialogs": [
              "10131308"
            ]
          },
          "10131308": {
            "id": "10131308",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "请你去找一个叫「公子」的人…",
            "nextDialogs": [
              "10131309"
            ]
          },
          "10131309": {
            "id": "10131309",
            "speakerId": 1005,
            "speakerName": "阿三",
            "text": "「公子」？不去不去。他要帮你报销？那也不去。本来跑一趟腿的，这不是要变成跑两趟了么。",
            "nextDialogs": [
              "10131310"
            ]
          },
          "10131310": {
            "id": "10131310",
            "speakerId": 1005,
            "speakerName": "阿三",
            "text": "这样吧，我们一码归一码。你剩的这些钱我都先收了，然后…",
            "nextDialogs": [
              "10131311"
            ]
          },
          "10131311": {
            "id": "10131311",
            "speakerId": 1005,
            "speakerName": "阿三",
            "text": "给我一块<color=#00E1FFFF>铁矿</color>，我就当做抵了这段额外路费，再去找那个什么「公子」，怎样？",
            "nextDialogs": [
              "10131312"
            ]
          },
          "10131312": {
            "id": "10131312",
            "speakerId": 1002,
            "speakerName": "派蒙",
            "text": "唔…看来只能这样了吧。"
          }
        }
      }
    },
    {
      "subId": "101314",
      "subQuestName": "将铁块带给阿三",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "10137901"
        ],
        "dialogs": {
          "10137901": {
            "id": "10137901",
            "speakerId": 1005,
            "speakerName": "阿三",
            "text": "东西带来了么？",
            "nextDialogs": [
              "10137902"
            ]
          },
          "10137902": {
            "id": "10137902",
            "speakerId": 1005,
            "speakerName": "阿三",
            "text": "嗯，是块好矿。为了今后的冒险家生涯，我得为顺手的武器做好准备…",
            "nextDialogs": [
              "10137903"
            ]
          },
          "10137903": {
            "id": "10137903",
            "speakerId": 1005,
            "speakerName": "阿三",
            "text": "行吧，做完事以后，我会去拿我那份工资的。"
          }
        }
      }
    },

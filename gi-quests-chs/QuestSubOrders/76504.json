            "id": "765040501",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "没问题，我们开始留影吧！"
          }
        }
      }
    },
    {
      "subId": "7650406",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {

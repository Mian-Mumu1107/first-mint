  "subQuests": [
    {
      "subId": "7650401",
      "subQuestName": "(test)隐藏$HIDDEN",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "765040101"
        ],
        "dialogs": {
          "765040101": {
            "id": "765040101",
            "speakerId": 1000,
            "speakerName": "伊涅芙",
            "text": "#{NICKNAME}，派蒙，你们好。吃了吗？",
            "nextDialogs": [
              "765040102"
            ]
          },
          "765040102": {
            "id": "765040102",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "伊涅芙？你怎么也跑到屋顶上来啦。难道是…在观察云的形状，计算下雨的概率？",
            "nextDialogs": [
              "765040103"
            ]
          },
          "765040103": {
            "id": "765040103",
            "speakerId": 1000,
            "speakerName": "伊涅芙",
            "text": "我正在执行一项…意外偏离预定轨道的任务。",
            "nextDialogs": [
              "765040104"
            ]
          },
          "765040104": {
            "id": "765040104",
            "speakerId": 1000,
            "speakerName": "伊涅芙",
            "text": "原定计划是为爱诺采购她清单上指定的「高精度齿轮」和「特制六角螺丝」。",
            "nextDialogs": [
              "765040105"
            ]
          },
          "765040105": {
            "id": "765040105",
            "speakerId": 1000,
            "speakerName": "伊涅芙",
            "text": "但在返回工坊的途中，遭遇了一次…不可预见的物资拦截事件。一只鹰隼，以极快的速度，从我的手中叼走了那枚特制螺丝。",
            "nextDialogs": [
              "765040106"
            ]
          },
          "765040106": {
            "id": "765040106",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "所以你就跑到屋顶上来找鹰隼了？",
            "nextDialogs": [
              "765040107"
            ]
          },
          "765040107": {
            "id": "765040107",
            "speakerId": 1000,
            "speakerName": "伊涅芙",
            "text": "是的。根据该生物的习性，屋顶是其可能的临时停落点。我正在进行全方位的视觉扫描与声音探测，试图定位目标。",
            "nextDialogs": [
              "765040108"
            ]
          },
          "765040108": {
            "id": "765040108",
            "speakerId": 1000,
            "speakerName": "伊涅芙",
            "text": "不过，截至目前，并未捕捉到有效踪迹。初步推测，目标已逃离我的追踪范围，或已将「猎物」转移至更隐蔽的巢穴。",
            "nextDialogs": [
              "765040109"
            ]
          },
          "765040109": {
            "id": "765040109",
            "speakerId": 1000,
            "speakerName": "伊涅芙",
            "text": "后备计划已启动：重新前往指定供应商处，采购一枚同型号螺丝。",
            "nextDialogs": [
              "765040110"
            ]
          },
          "765040110": {
            "id": "765040110",
            "speakerId": 1000,
            "speakerName": "伊涅芙",
            "text": "话说回来。你们出现在高处，难道也在…追踪某种小动物吗？",
            "nextDialogs": [
              "765040113"
            ]
          },
          "765040113": {
            "id": "765040113",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "对呀对呀，我们本来是想找个视野开阔的地方，拍一拍那夏镇的全景照片，记录下这里繁忙又有活力的样子。",
            "nextDialogs": [
              "765040114"
            ]
          },
          "765040114": {
            "id": "765040114",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "想不到竟然会在这里遇上正在「追捕小偷」的伊涅芙！这也是一种超小概率的「偏离轨道的惊喜事件」吧！"
          }
        }
      }
    },
    {

          "765040601"
        ],
        "dialogs": {
          "765040601": {
            "id": "765040601",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "请稍等，我再找找灵感。"
          }
        }
      }
    },
    {
      "subId": "7650407",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "765040701"
        ],
        "dialogs": {
          "765040701": {
            "id": "765040701",
            "speakerId": 1000,
            "speakerName": "伊涅芙",
            "text": "#{NICKNAME}，派蒙，你们好。吃了吗？今天有什么特别的预定安排吗？",
            "nextDialogs": [
              "765040704"
            ]
          },
          "765040704": {
            "id": "765040704",
            "speakerId": 1000,
            "speakerName": "伊涅芙",
            "text": "了解了。四处走走，用镜头记录见闻，是不错的放松方式。",
            "nextDialogs": [
              "765040705"
            ]
          },
          "765040705": {
            "id": "765040705",
            "speakerId": 1000,
            "speakerName": "伊涅芙",
            "text": "不过，我没有在你身上检测到留影机呢。是不是出门的时候太匆忙，把它忘在什么地方了？"
          }
        }
      }
    },
    {
      "subId": "7650408",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "765040801"
        ],
        "dialogs": {
          "765040801": {
            "id": "765040801",
            "speakerId": 1000,
            "speakerName": "伊涅芙",
            "text": "找到合适的拍摄素材了吗？不必着急，美好的事物总是值得耐心发掘的。",
            "nextDialogs": [
              "765040804"
            ]
          },
          "765040804": {
            "id": "765040804",
            "speakerId": 1000,
            "speakerName": "伊涅芙",
            "text": "了解了。不过，我没有在你身上检测到留影机呢。是不是出门的时候太匆忙，把它忘在什么地方了？"
          }
        }
      }
    }

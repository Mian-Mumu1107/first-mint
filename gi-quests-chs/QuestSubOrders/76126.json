{
  "lineCounts": {
    "祖潘科": 18,
    "莉莉希": 7,
    "雅珂达": 14
  },
  "subQuests": [
    {
      "subId": "7612601",
      "subQuestName": "(test)隐藏$HIDDEN",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "761260101"
        ],
        "dialogs": {
          "761260101": {
            "id": "761260101",
            "speakerId": 16125,
            "speakerName": "莉莉希",
            "text": "雅珂达？还有…祖潘科先生，请问您有什么事么？",
            "nextDialogs": [
              "761260102"
            ]
          },
          "761260102": {
            "id": "761260102",
            "speakerId": 16440,
            "speakerName": "祖潘科",
            "text": "我…呃…那个…",
            "nextDialogs": [
              "761260103"
            ]
          },
          "761260103": {
            "id": "761260103",
            "speakerId": 1317,
            "speakerName": "雅珂达",
            "text": "他想去「霜月之子」里玩一玩，但又不好意思，所以想要拜托你帮忙啦。",
            "nextDialogs": [
              "761260104"
            ]
          },
          "761260104": {
            "id": "761260104",
            "speakerId": 16440,
            "speakerName": "祖潘科",
            "text": "是！是，就是这样。",
            "nextDialogs": [
              "761260105"
            ]
          },
          "761260105": {
            "id": "761260105",
            "speakerId": 16440,
            "speakerName": "祖潘科",
            "text": "您好，莉莉希小姐！很高兴见到您，呃…这是我从纳塔带来的…化石标本！",
            "nextDialogs": [
              "761260106"
            ]
          },
          "761260106": {
            "id": "761260106",
            "speakerId": 16125,
            "speakerName": "莉莉希",
            "text": "谢谢您，可…祖潘科先生，我早就认识您了呀，您真的不用这么客气的。",
            "nextDialogs": [
              "761260107"
            ]
          },
          "761260107": {
            "id": "761260107",
            "speakerId": 16440,
            "speakerName": "祖潘科",
            "text": "啊？您又是怎么发现我的？",
            "nextDialogs": [
              "761260108"
            ]
          },
          "761260108": {
            "id": "761260108",
            "speakerId": 16125,
            "speakerName": "莉莉希",
            "text": "我之前发放餐食的时候，您不是在旁边看吗？转悠来，转悠去，但就是不站进队里。",
            "nextDialogs": [
              "761260109"
            ]
          },
          "761260109": {
            "id": "761260109",
            "speakerId": 16125,
            "speakerName": "莉莉希",
            "text": "我还以为您也想拿，但又不好意思上前，所以还特意悄悄留了一份给您了。",
            "nextDialogs": [
              "761260110"
            ]
          },
          "761260110": {
            "id": "761260110",
            "speakerId": 16125,
            "speakerName": "莉莉希",
            "text": "但…您从来也没来拿过餐。要是您今天不来，我也要拜托人去问问您，有什么需要帮助的了。",
            "nextDialogs": [
              "761260111"
            ]
          },
          "761260111": {
            "id": "761260111",
            "speakerId": 16440,
            "speakerName": "祖潘科",
            "text": "这…这…真是抱歉，我是在犹豫，到底怎么打招呼呢…",
            "nextDialogs": [
              "761260112"
            ]
          },
          "761260112": {
            "id": "761260112",
            "speakerId": 16440,
            "speakerName": "祖潘科",
            "text": "所以，莉莉希小姐，我能去「霜月之子」看看么？",
            "nextDialogs": [
              "761260113"
            ]
          },
          "761260113": {
            "id": "761260113",
            "speakerId": 16125,
            "speakerName": "莉莉希",
            "text": "可以呀，我们「霜月之子」里本来也有几位外来的客人。但您要去做什么？",
            "nextDialogs": [
              "761260114"
            ]
          },
          "761260114": {
            "id": "761260114",
            "speakerId": 16440,
            "speakerName": "祖潘科",
            "text": "留个影，查查资料，如果可能的话…再找人询问一下传说故事！",
            "nextDialogs": [
              "761260115"
            ]
          },
          "761260115": {
            "id": "761260115",
            "speakerId": 16440,
            "speakerName": "祖潘科",
            "text": "我是纳塔「龙遗物研究协会」的成员，如果能搜集到一些和我的研究方向有关的资料，那就最好了！",
            "nextDialogs": [
              "761260116"
            ]
          },
          "761260116": {
            "id": "761260116",
            "speakerId": 16125,
            "speakerName": "莉莉希",
            "text": "喔…那你就是要去看书喽？我想想啊…",
            "nextDialogs": [
              "761260117"
            ]
          },
          "761260117": {
            "id": "761260117",
            "speakerId": 1317,
            "speakerName": "雅珂达",
            "text": "你们聊的这么开心，那这趟委托就算结束喽，我也要回去给老板汇报了。",
            "nextDialogs": [
              "761260118"
            ]
          },
          "761260118": {
            "id": "761260118",
            "speakerId": 16440,
            "speakerName": "祖潘科",
            "text": "谢谢你，雅珂达小姐！那个…费用我还是会付的，怎么能让您白跑一趟呢。",
            "nextDialogs": [
              "761260119"
            ]
          },
          "761260119": {
            "id": "761260119",
            "speakerId": 16440,
            "speakerName": "祖潘科",
            "text": "回去的时候，也请务必向奈芙尔老板转达我的谢意。",
            "nextDialogs": [
              "761260120"
            ]
          },
          "761260120": {
            "id": "761260120",
            "speakerId": 1317,
            "speakerName": "雅珂达",
            "text": "好说好说，那我就先走了，两位聊得开心啊。"
          }
        }
      }
    },
    {
      "subId": "7612602",
      "subQuestName": "与祖潘科对话",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "761260201"
        ],
        "dialogs": {
          "761260201": {
            "id": "761260201",
            "speakerId": 7046,
            "speakerName": "祖潘科",
            "text": "啊…雅珂达？你怎么来了？呃…奈芙尔老板现在有空吗？",
            "nextDialogs": [
              "761260202"
            ]
          },
          "761260202": {
            "id": "761260202",
            "speakerId": 1317,
            "speakerName": "雅珂达",
            "text": "（果然想去找奈姐…哼哼，这么点小事，我自己就能搞定。）",
            "nextDialogs": [
              "761260203"
            ]
          },
          "761260203": {
            "id": "761260203",
            "speakerId": 1317,
            "speakerName": "雅珂达",
            "text": "不用这么麻烦啦，就是老板派我来帮你的。",
            "nextDialogs": [
              "761260204"
            ]
          },
          "761260204": {
            "id": "761260204",
            "speakerId": 7046,
            "speakerName": "祖潘科",
            "text": "欸？您、您说什么，难道奈芙尔老板已经…",
            "nextDialogs": [
              "761260205"
            ]
          },
          "761260205": {
            "id": "761260205",
            "speakerId": 1317,
            "speakerName": "雅珂达",
            "text": "你一直想要去「霜月之子」那边拜访，没错吧？",
            "nextDialogs": [
              "761260206"
            ]
          },
          "761260206": {
            "id": "761260206",
            "speakerId": 1317,
            "speakerName": "雅珂达",
            "text": "所以，你想先和莉莉希搞好关系，再拜托她把你带去「霜月之子」。",
            "nextDialogs": [
              "761260207"
            ]
          },
          "761260207": {
            "id": "761260207",
            "speakerId": 7046,
            "speakerName": "祖潘科",
            "text": "啊？！奈芙尔老板都知道了？我明明都把这事憋在心里，没怎么和人说呢…",
            "nextDialogs": [
              "761260208"
            ]
          },
          "761260208": {
            "id": "761260208",
            "speakerId": 1317,
            "speakerName": "雅珂达",
            "text": "（这个时候就要说那句特别帅的话！奈姐怎么说的来着…嗯…噢！）",
            "nextDialogs": [
              "761260209"
            ]
          },
          "761260209": {
            "id": "761260209",
            "speakerId": 1317,
            "speakerName": "雅珂达",
            "text": "哼哼，祖潘科先生，人在保守秘密时，也要学会隐瞒「正在保守秘密」这件事。",
            "nextDialogs": [
              "761260210"
            ]
          },
          "761260210": {
            "id": "761260210",
            "speakerId": 1317,
            "speakerName": "雅珂达",
            "text": "不然的话，你在心里竖起的那道墙，迟早会开始漏风。",
            "nextDialogs": [
              "761260211"
            ]
          },
          "761260211": {
            "id": "761260211",
            "speakerId": 7046,
            "speakerName": "祖潘科",
            "text": "唉，我在家乡的时候，就不怎么会隐瞒心思…",
            "nextDialogs": [
              "761260212"
            ]
          },
          "761260212": {
            "id": "761260212",
            "speakerId": 1317,
            "speakerName": "雅珂达",
            "text": "（说出来了！不亏我练了那么久，嘿嘿嘿嘿嘿——）",
            "nextDialogs": [
              "761260213"
            ]
          },
          "761260213": {
            "id": "761260213",
            "speakerId": 7046,
            "speakerName": "祖潘科",
            "text": "算了，既然您都知道了，那您能帮我引荐一下吗？我是外乡人，贸然去打扰莉莉希小姐…",
            "nextDialogs": [
              "761260214"
            ]
          },
          "761260214": {
            "id": "761260214",
            "speakerId": 1317,
            "speakerName": "雅珂达",
            "text": "放心啦，莉莉希可好了，别说来访者是外乡人，就算不是人，她都会温柔地接待。",
            "nextDialogs": [
              "761260215"
            ]
          },
          "761260215": {
            "id": "761260215",
            "speakerId": 7046,
            "speakerName": "祖潘科",
            "text": "啊？真的假的…",
            "nextDialogs": [
              "761260216"
            ]
          },
          "761260216": {
            "id": "761260216",
            "speakerId": 7046,
            "speakerName": "祖潘科",
            "text": "但无论如何，贸然打搅总是不太礼貌…呃，您要是认识她的话…",
            "nextDialogs": [
              "761260217"
            ]
          },
          "761260217": {
            "id": "761260217",
            "speakerId": 1317,
            "speakerName": "雅珂达",
            "text": "当然认识喽，现在她们应该刚好发放完了餐食，我们现在就去吧。",
            "nextDialogs": [
              "761260218"
            ]
          },
          "761260218": {
            "id": "761260218",
            "speakerId": 1317,
            "speakerName": "雅珂达",
            "text": "啊…老板还说，这一次就不用收费了。",
            "nextDialogs": [
              "761260219"
            ]
          },
          "761260219": {
            "id": "761260219",
            "speakerId": 7046,
            "speakerName": "祖潘科",
            "text": "谢谢您！我这就去收拾东西…"
          }
        }
      }
    },
    {
      "subId": "7612603",

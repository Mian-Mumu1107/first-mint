    {
      "subId": "7602104",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "760210401"
        ],
        "dialogs": {
          "760210401": {
            "id": "760210401",
            "speakerId": 21924,
            "speakerName": "伊尔玛里",
            "text": "今天也是空手而归啊。",
            "nextDialogs": [
              "760210403",
              "760210406",
              "760210413",
              "760210418",
              "760210422"
            ]
          },
          "760210403": {
            "id": "760210403",
            "speakerId": 21924,
            "speakerName": "伊尔玛里",
            "text": "钓鱼。不过到目前为止只钓到些不是鱼的玩意儿。",
            "nextDialogs": [
              "760210404"
            ]
          },
          "760210404": {
            "id": "760210404",
            "speakerId": 21924,
            "speakerName": "伊尔玛里",
            "text": "要是沉船里的小物件之类的倒好，游商会收。之前钓起过靴子上还连着半截…唉，不说了，说多了鱼都给吓跑了。"
          },
          "760210406": {
            "id": "760210406",
            "speakerId": 21924,
            "speakerName": "伊尔玛里",
            "text": "你又来寻宝了？什么只有在月之东，日之西才能找到的「伟大财宝」之类的…听也知道不会是这里。",
            "nextDialogs": [
              "760210407"
            ]
          },
          "760210407": {
            "id": "760210407",
            "speakerId": 21924,
            "speakerName": "伊尔玛里",
            "text": "过去这里的确发生过不少船难，沉船里或许的确有值钱的东西，不过那可不容易找啊。",
            "nextDialogs": [
              "760210408"
            ]
          },
          "760210408": {
            "id": "760210408",
            "speakerId": 21924,
            "speakerName": "伊尔玛里",
            "text": "在酒馆也听幸存的水手说起过，那天晚上没有月亮，在滔天的巨浪中却能看到发光的东西。",
            "nextDialogs": [
              "760210409"
            ]
          },
          "760210409": {
            "id": "760210409",
            "speakerId": 21924,
            "speakerName": "伊尔玛里",
            "text": "他们说那一定就是独眼的刻拉蒂了，是连月亮都能吞食的怪兽在同海中的巨蛇争夺地盘。",
            "nextDialogs": [
              "760210410"
            ]
          },
          "760210410": {
            "id": "760210410",
            "speakerId": 21924,
            "speakerName": "伊尔玛里",
            "text": "那之后很长一段时间，这块儿都像账房的墨水瓶似的黑黢黢一片，没有船敢冒险从这里经过，都怕被水下的亡魂缠上。",
            "nextDialogs": [
              "760210411"
            ]
          },
          "760210411": {
            "id": "760210411",
            "speakerId": 21924,
            "speakerName": "伊尔玛里",
            "text": "不管那些亡魂现在是不是还在附近徘徊，反正我看不见。"
          },
          "760210413": {
            "id": "760210413",
            "speakerId": 21924,
            "speakerName": "伊尔玛里",
            "text": "那玩意儿是真的有点邪乎。这儿原本有个漩涡，水手们管它叫刻拉蒂之眼，但突然有那么一天这树就这么长出来了。",
            "nextDialogs": [
              "760210414"
            ]
          },
          "760210414": {
            "id": "760210414",
            "speakerId": 21924,
            "speakerName": "伊尔玛里",
            "text": "不过那阵子发生的怪事也不止这么一件，想想看，都是在那些石头从天上掉下来之后…搞不好这树也跟石头一样来自天外。",
            "nextDialogs": [
              "760210415"
            ]
          },
          "760210415": {
            "id": "760210415",
            "speakerId": 21924,
            "speakerName": "伊尔玛里",
            "text": "还有那些偶尔能见到的亮晶晶的小东西，稀罕得很。想着说不定也会有新品种的鱼吧，我就是为了这个才来碰碰运气。",
            "nextDialogs": [
              "760210416"
            ]
          },
          "760210416": {
            "id": "760210416",
            "speakerId": 21924,
            "speakerName": "伊尔玛里",
            "text": "原本有个钓友和我一起，但他老说听到奇怪的歌声，吓得不敢再来了。哼，虽然他只算半个霜月之子，但臭毛病是一点不少。"
          },
          "760210418": {
            "id": "760210418",
            "speakerId": 21924,
            "speakerName": "伊尔玛里",
            "text": "什么「识者之证」，什么只有在月之东，日之西才能找到的「伟大财宝」，要我说啊…",
            "nextDialogs": [
              "760210419"
            ]
          },
          "760210419": {
            "id": "760210419",
            "speakerId": 21924,
            "speakerName": "伊尔玛里",
            "text": "被贪欲驱使，追逐本不属于自己的东西，肯定不会有好下场。就像阿特拉号，听说船长格瑞蒂尔就是为这些东西着了魔。",
            "nextDialogs": [
              "760210420"
            ]
          },
          "760210420": {
            "id": "760210420",
            "speakerId": 21924,
            "speakerName": "伊尔玛里",
            "text": "最后落得个葬身海底的下场，宝藏却不会永远与他同眠，真是白忙活。"
          },
          "760210422": {
            "id": "760210422",
            "speakerId": 21924,
            "speakerName": "伊尔玛里",
            "text": "不打紧。现在是一点鱼的影子都看不到。"
          }
        }
      }
    }
  ]
}
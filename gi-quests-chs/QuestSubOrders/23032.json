    {
      "subId": "2303201",
      "subQuestName": "与维克多对话",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "230320101"
        ],
        "dialogs": {
          "230320101": {
            "id": "230320101",
            "speakerId": 1000,
            "speakerName": "维克多",
            "text": "旅行者，你来得正好。",
            "nextDialogs": [
              "230320102"
            ]
          },
          "230320102": {
            "id": "230320102",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "你的木雕怎么样了？",
            "nextDialogs": [
              "230320103"
            ]
          },
          "230320103": {
            "id": "230320103",
            "speakerId": 1000,
            "speakerName": "维克多",
            "text": "呃…我偷偷做木雕的事被弗谢沃洛德先生给发现了…",
            "nextDialogs": [
              "230320104"
            ]
          },
          "230320104": {
            "id": "230320104",
            "speakerId": 1000,
            "speakerName": "维克多",
            "text": "不过，他倒是也没怎么发脾气，就是让我工作的时候别做闲事…还找我要了个小兔子的木雕。",
            "nextDialogs": [
              "230320107"
            ]
          },
          "230320107": {
            "id": "230320107",
            "speakerId": 1000,
            "speakerName": "维克多",
            "text": "弗谢沃洛德先生说，我做的木雕很有至冬的风格，他很喜欢。",
            "nextDialogs": [
              "230320108"
            ]
          },
          "230320108": {
            "id": "230320108",
            "speakerId": 1000,
            "speakerName": "维克多",
            "text": "我听人说，弗谢沃洛德先生一直因为命令在外奔波，已经很久没有回过至冬陪过家人了。",
            "nextDialogs": [
              "230320109"
            ]
          },
          "230320109": {
            "id": "230320109",
            "speakerId": 1000,
            "speakerName": "维克多",
            "text": "我觉得，也许他和我不一样，是真的想家了吧…",
            "nextDialogs": [
              "230320110"
            ]
          },
          "230320110": {
            "id": "230320110",
            "speakerId": 1000,
            "speakerName": "维克多",
            "text": "唉，闲话就说到这，旅行者，我又找哈马维订了一批木头，请你帮我去看看吧。"
          }
        }
      }
    },
    {
      "subId": "2303202",
      "subQuestName": "与哈马维对话",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "230320201"
        ],
        "dialogs": {
          "230320201": {
            "id": "230320201",
            "speakerId": 1001,
            "speakerName": "哈马维",
            "text": "真是倒霉…",
            "nextDialogs": [
              "230320202"
            ]
          },
          "230320202": {
            "id": "230320202",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "关于维克多的木头…",
            "nextDialogs": [
              "230320203"
            ]
          },
          "230320203": {
            "id": "230320203",
            "speakerId": 1001,
            "speakerName": "哈马维",
            "text": "你是说那个愚人众找我订的木头吧。",
            "nextDialogs": [
              "230320204"
            ]
          },
          "230320204": {
            "id": "230320204",
            "speakerId": 1001,
            "speakerName": "哈马维",
            "text": "唉，别提了，我就说和愚人众做生意不会有好运气。",
            "nextDialogs": [
              "230320205"
            ]
          },
          "230320205": {
            "id": "230320205",
            "speakerId": 1001,
            "speakerName": "哈马维",
            "text": "那批木头运到一半就被魔物袭击了，人是全跑回来了，但车毁了，木头都丢在了半路上。",
            "nextDialogs": [
              "230320206"
            ]
          },
          "230320206": {
            "id": "230320206",
            "speakerId": 1001,
            "speakerName": "哈马维",
            "text": "唉，现在这情况，我是不敢过去了，一时半会也找不到人去赶走那些魔物…",
            "nextDialogs": [
              "230320208"
            ]
          },
          "230320208": {
            "id": "230320208",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "我不是愚人众…",
            "nextDialogs": [
              "230320209"
            ]
          },
          "230320209": {
            "id": "230320209",
            "speakerId": 1001,
            "speakerName": "哈马维",
            "text": "你不是愚人众吗？那你怎么帮他做事？奇怪…",
            "nextDialogs": [
              "230320210"
            ]
          },
          "230320210": {
            "id": "230320210",
            "speakerId": 1001,
            "speakerName": "哈马维",
            "text": "无论如何，那辆车我暂时是拉不回来了，我只能等到能雇到人之后再想办法。",
            "nextDialogs": [
              "230320211"
            ]
          },
          "230320211": {
            "id": "230320211",
            "speakerId": 1001,
            "speakerName": "哈马维",
            "text": "如果你着急要木头的话，我把那辆车大概的地方给你标在地图上，你自己过去看看吧。",
            "nextDialogs": [
              "230320212"
            ]
          },
          "230320212": {
            "id": "230320212",
            "speakerId": 1001,
            "speakerName": "哈马维",
            "text": "唉，只要和愚人众沾边果然就遇不上好事…"
          }
        }
      }
    },
    {
      "subId": "2303218",
      "subQuestName": "打倒所有蕈兽$HIDDEN",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "230321801"
        ],
        "dialogs": {
          "230321801": {
            "id": "230321801",
            "speakerId": 1000,
            "speakerName": "维克多",
            "text": "旅行者，事情怎么样了？",
            "nextDialogs": [
              "230321802"
            ]
          },
          "230321802": {
            "id": "230321802",
            "speakerId": 1002,
            "speakerName": "Black Screen",
            "text": "向维克多叙述了事情的经过…",
            "nextDialogs": [
              "230321803"
            ]
          },
          "230321803": {
            "id": "230321803",
            "speakerId": 1000,
            "speakerName": "维克多",
            "text": "太好了，多谢你帮忙，旅行者。",
            "nextDialogs": [
              "230321804"
            ]
          },
          "230321804": {
            "id": "230321804",
            "speakerId": 1000,
            "speakerName": "维克多",
            "text": "这些报酬是给你的，收下吧，我要继续去给莉莉写信了。",
            "nextDialogs": [
              "230321805"
            ]
          },
          "230321805": {
            "id": "230321805",
            "speakerId": 1000,
            "speakerName": "维克多",
            "text": "唉，我给这丫头写信的时候，简直比向弗谢沃洛德先生做报告还紧张…"
          }
        }
      }
    },
    {
      "subId": "2303203",
      "subQuestName": "前往货车所在地点",
      "sceneId": null,
      "locations": [],
      "dialogue": {

            "id": "230321905",
            "speakerId": 1000,
            "speakerName": "维克多",
            "text": "喏，这是说好的报酬，好好数一数吧。",
            "nextDialogs": [
              "230321906"
            ]
          },
          "230321906": {
            "id": "230321906",
            "speakerId": 1000,
            "speakerName": "维克多",
            "text": "还有…那个，莉…",

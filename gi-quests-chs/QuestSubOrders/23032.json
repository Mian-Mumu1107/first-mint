    {
      "subId": "2303211",
      "subQuestName": "与兰巴德对话",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "230321101"
        ],
        "dialogs": {
          "230321101": {
            "id": "230321101",
            "speakerId": 1003,
            "speakerName": "兰巴德",
            "text": "太好了，这些就足够了，请你稍等一下…",
            "nextDialogs": [
              "230321102"
            ]
          },
          "230321102": {
            "id": "230321102",
            "speakerId": 1002,
            "speakerName": "Black Screen",
            "text": "兰巴德开始了烹饪…",
            "nextDialogs": [
              "230321103"
            ]
          },
          "230321103": {
            "id": "230321103",
            "speakerId": 1003,
            "speakerName": "兰巴德",
            "text": "完成了，这份「绿汁脆球」是给你的，其余两份「绿汁脆球」你就带回去给那两个人吧。"
          }
        }
      }
    },
    {
      "subId": "2303208",
      "subQuestName": "与维克多对话",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "230321201"
        ],
        "dialogs": {
          "230321201": {
            "id": "230321201",
            "speakerId": 1000,
            "speakerName": "维克多",
            "text": "怎么样，兰巴德怎么说？",
            "nextDialogs": [
              "230321202"
            ]
          },
          "230321202": {
            "id": "230321202",
            "speakerId": 1002,
            "speakerName": "Black Screen",
            "text": "向维克多叙述了事情的过程…",
            "nextDialogs": [
              "230321203"
            ]
          },
          "230321203": {
            "id": "230321203",
            "speakerId": 1000,
            "speakerName": "维克多",
            "text": "兰巴德果然是个靠谱的老板啊，人也很好。",
            "nextDialogs": [
              "230321204"
            ]
          },
          "230321204": {
            "id": "230321204",
            "speakerId": 1000,
            "speakerName": "维克多",
            "text": "不像其他人，一看见我们是愚人众，本能地就开始提防我们。",
            "nextDialogs": [
              "230321207"
            ]
          },
          "230321207": {
            "id": "230321207",
            "speakerId": 1000,
            "speakerName": "维克多",
            "text": "哎，这道菜闻着真不错啊，弗谢沃洛德先生应该也会很喜欢的。",
            "nextDialogs": [
              "230321208"
            ]
          },
          "230321208": {
            "id": "230321208",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "你这家伙…",
            "nextDialogs": [
              "230321209"
            ]
          },
          "230321209": {
            "id": "230321209",
            "speakerId": 1000,
            "speakerName": "维克多",
            "text": "这是说好的报酬，数一数吧旅行者，好好数一数。"
          }
        }
      }
    },
    {
      "subId": "2303209",
      "subQuestName": "与朱特对话",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "230321501"
        ],
        "dialogs": {
          "230321501": {
            "id": "230321501",
            "speakerId": 1004,
            "speakerName": "朱特",
            "text": "风车菊会是什么气味呢…",
            "nextDialogs": [
              "230321502"
            ]
          },
          "230321502": {
            "id": "230321502",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "关于维克多的委托…",
            "nextDialogs": [
              "230321503"
            ]
          },
          "230321503": {
            "id": "230321503",
            "speakerId": 1004,
            "speakerName": "朱特",
            "text": "没错，我确实和他约定好了，他帮我去找各种稀奇的植物，我则帮他想办法做香包。",
            "nextDialogs": [
              "230321504"
            ]
          },
          "230321504": {
            "id": "230321504",
            "speakerId": 1004,
            "speakerName": "朱特",
            "text": "你是他请来帮忙的人吧，如果拿到风车菊的话，直接给我就行了。"
          }
        }
      }
    },
    {
      "subId": "2303217",
      "subQuestName": "与朱特对话",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "230321701"
        ],
        "dialogs": {
          "230321701": {
            "id": "230321701",
            "speakerId": 1004,
            "speakerName": "朱特",

    {
      "subId": "2303205",
      "subQuestName": "向哈马维回报",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "230320501"
        ],
        "dialogs": {
          "230320501": {
            "id": "230320501",
            "speakerId": 1001,
            "speakerName": "哈马维",
            "text": "唉，只要和愚人众沾边果然就遇不上好事…",
            "nextDialogs": [
              "230320502"
            ]
          },
          "230320502": {
            "id": "230320502",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "关于维克多的木头…",
            "nextDialogs": [
              "230320503"
            ]
          },
          "230320503": {
            "id": "230320503",
            "speakerId": 1001,
            "speakerName": "哈马维",
            "text": "这木头是…你已经把魔物都赶走了？看不出来，你还挺能打的…",
            "nextDialogs": [
              "230320504"
            ]
          },
          "230320504": {
            "id": "230320504",
            "speakerId": 1001,
            "speakerName": "哈马维",
            "text": "多谢你了，我等会就找人和我一起过去，把木头给弄回来。",
            "nextDialogs": [
              "230320505"
            ]
          },
          "230320505": {
            "id": "230320505",
            "speakerId": 1001,
            "speakerName": "哈马维",
            "text": "唉，只要和愚人众沾边果然就遇不上好事…"
          }
        }
      }
    },
    {
      "subId": "2303206",
      "subQuestName": "与维克多对话",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "230320601"
        ],
        "dialogs": {
          "230320601": {
            "id": "230320601",
            "speakerId": 1000,
            "speakerName": "维克多",
            "text": "怎么样，我买的木头已经到了吗？",
            "nextDialogs": [
              "230320602"
            ]
          },
          "230320602": {
            "id": "230320602",
            "speakerId": 1002,
            "speakerName": "Black Screen",
            "text": "向维克多叙述了事情的过程…",
            "nextDialogs": [
              "230320603"
            ]
          },
          "230320603": {
            "id": "230320603",
            "speakerId": 1000,
            "speakerName": "维克多",
            "text": "又是魔物？我怎么感觉全世界的货车都很容易被魔物袭击…",
            "nextDialogs": [
              "230320604"
            ]
          },
          "230320604": {
            "id": "230320604",
            "speakerId": 1000,
            "speakerName": "维克多",
            "text": "算了，反正木头能送回来就行。",
            "nextDialogs": [
              "230320605"
            ]
          },
          "230320605": {
            "id": "230320605",
            "speakerId": 1000,
            "speakerName": "维克多",
            "text": "喏，这是说好的报酬，好好数一数吧。",
            "nextDialogs": [
              "230320606"
            ]
          },
          "230320606": {
            "id": "230320606",
            "speakerId": 1000,
            "speakerName": "维克多",
            "text": "还有…那个，莉莉还好吗？",
            "nextDialogs": [
              "230320607"
            ]
          },
          "230320607": {
            "id": "230320607",
            "speakerId": 1000,
            "speakerName": "维克多",
            "text": "我走的时候也没和那丫头当面道别，她没生气吧？",
            "nextDialogs": [
              "230320609",
              "230320611"
            ]
          },
          "230320609": {
            "id": "230320609",
            "speakerId": 1000,
            "speakerName": "维克多",
            "text": "那就行，咳…你别这么看着我，我就是关心一下啊！",
            "nextDialogs": [
              "230320614"
            ]
          },
          "230320614": {
            "id": "230320614",
            "speakerId": 1000,
            "speakerName": "维克多",
            "text": "不说这些了，再数数报酬吧，旅行者，我可是一分都没少你的。"
          },
          "230320611": {
            "id": "230320611",
            "speakerId": 1000,
            "speakerName": "维克多",
            "text": "那弗谢沃洛德先生非得踢我不可，算了吧。",
            "nextDialogs": [
              "230320612"
            ]
          },
          "230320612": {
            "id": "230320612",
            "speakerId": 1000,
            "speakerName": "维克多",
            "text": "我也不太敢直接寄信过去。",
            "nextDialogs": [
              "230320613"
            ]
          },
          "230320613": {
            "id": "230320613",
            "speakerId": 1000,
            "speakerName": "维克多",
            "text": "收到一封来自愚人众的信，听起来就不像什么好事，哈哈哈…"
          }
        }
      }
    },
    {
      "subId": "2303207",
      "subQuestName": "与兰巴德对话",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "230320901"
        ],
        "dialogs": {
          "230320901": {
            "id": "230320901",
            "speakerId": 1003,
            "speakerName": "兰巴德",
            "text": "你好，请问有什么事吗？",
            "nextDialogs": [
              "230320902"
            ]
          },
          "230320902": {
            "id": "230320902",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "关于维克多的委托…",
            "nextDialogs": [
              "230320903"
            ]
          },
          "230320903": {
            "id": "230320903",
            "speakerId": 1003,
            "speakerName": "兰巴德",
            "text": "噢，你是说他拜托我采购的香料吧，都已经采购好了，过会我就把东西送过去。",
            "nextDialogs": [
              "230320904"
            ]
          },
          "230320904": {
            "id": "230320904",
            "speakerId": 1003,
            "speakerName": "兰巴德",
            "text": "午饭嘛…哎呀，今天的客人有点多，食材都用得差不多了…",
            "nextDialogs": [
              "230320905"
            ]
          },
          "230320905": {
            "id": "230320905",
            "speakerId": 1003,
            "speakerName": "兰巴德",
            "text": "这样好了，旅行者，请你帮我去拿两个土豆回来吧。",
            "nextDialogs": [
              "230320906"
            ]
          },
          "230320906": {
            "id": "230320906",
            "speakerId": 1003,
            "speakerName": "兰巴德",
            "text": "作为回报…我也会给你做一道「绿汁脆球」的，拜托你了。"
          }
        }
      }
    },
    {
      "subId": "2303216",
      "subQuestName": "与兰巴德对话",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "230321601"
        ],
        "dialogs": {
          "230321601": {

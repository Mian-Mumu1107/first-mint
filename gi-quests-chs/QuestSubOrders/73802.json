  "subQuests": [
    {
      "subId": "7380201",
      "subQuestName": "对话凯瑟琳",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "738020101"
        ],
        "dialogs": {
          "738020101": {
            "id": "738020101",
            "speakerId": 4019,
            "speakerName": "凯瑟琳",
            "text": "向着星辰与深渊！欢迎来到冒险家协会。",
            "nextDialogs": [
              "738020102"
            ]
          },
          "738020102": {
            "id": "738020102",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "你好呀，凯瑟琳小姐。",
            "nextDialogs": [
              "738020103"
            ]
          },
          "738020103": {
            "id": "738020103",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "你好，凯瑟琳…",
            "nextDialogs": [
              "738020104"
            ]
          },
          "738020104": {
            "id": "738020104",
            "speakerId": 4019,
            "speakerName": "凯瑟琳",
            "text": "你们好，看起来两位今天的状态很不错啊。请问您是来接取委托的吗？还是来处理其他事务的呢？",
            "nextDialogs": [
              "738020105"
            ]
          },
          "738020105": {
            "id": "738020105",
            "speakerId": 4019,
            "speakerName": "凯瑟琳",
            "text": "嗯…两位为什么一直盯着我？是…有什么事要问我吗？",
            "nextDialogs": [
              "738020108"
            ]
          },
          "738020108": {
            "id": "738020108",
            "speakerId": 4019,
            "speakerName": "凯瑟琳",
            "text": "这样啊…看您的样子，冒险的经验应该很丰富了吧？",
            "nextDialogs": [
              "738020109"
            ]
          },
          "738020109": {
            "id": "738020109",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "算是吧。",
            "nextDialogs": [
              "738020110"
            ]
          },
          "738020110": {
            "id": "738020110",
            "speakerId": 4019,
            "speakerName": "凯瑟琳",
            "text": "那么，想必你也已经很熟悉冒险家协会的运作模式了，我就不多赘述，以免耽误您的时间。",
            "nextDialogs": [
              "738020111"
            ]
          },
          "738020111": {
            "id": "738020111",
            "speakerId": 4019,
            "speakerName": "凯瑟琳",
            "text": "如果您对协会内的事务有任何疑问，都欢迎来找我。",
            "nextDialogs": [
              "738020112"
            ]
          },
          "738020112": {
            "id": "738020112",
            "speakerId": 4019,
            "speakerName": "凯瑟琳",
            "text": "在须弥城里，也请您多多完成委托吧。像您这样实力强大的冒险家，一定能帮上人们不少忙。",
            "nextDialogs": [
              "738020113"
            ]
          },
          "738020113": {
            "id": "738020113",
            "speakerId": 4019,
            "speakerName": "凯瑟琳",
            "text": "请继续勇敢冒险吧，向着星辰与深渊！"
          }
        }
      }
    }
  ]
}
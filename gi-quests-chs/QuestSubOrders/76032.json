        "dialogs": {
          "760320201": {
            "id": "760320201",
            "speakerId": 1000,
            "speakerName": "特辖队士兵",
            "text": "你小子，知道擅闯禁地是什么下场吗？",
            "nextDialogs": [
              "760320202"
            ]
          },
          "760320202": {
            "id": "760320202",
            "speakerId": 22115,
            "speakerName": "可疑的人",
            "text": "…我这不是刚知道么！到底是初犯没有经验，你看要不这样，你再给我一次机会！",
            "nextDialogs": [
              "760320203"
            ]
          },
          "760320203": {
            "id": "760320203",
            "speakerId": 22115,
            "speakerName": "可疑的人",
            "text": "再给我一次机会，下次我保证不被你逮到！",
            "nextDialogs": [
              "760320204"
            ]
          },
          "760320204": {
            "id": "760320204",
            "speakerId": 1000,
            "speakerName": "特辖队士兵",
            "text": "开什么玩笑，<color=#00E1FFFF>觊觎宝物的老鼠</color>，一只也不能放走！",
            "nextDialogs": [
              "760320205"
            ]
          },
          "760320205": {
            "id": "760320205",
            "speakerId": 22115,
            "speakerName": "可疑的人",
            "text": "哎！就现在，说不定那小妮子已经把东西都给搬走了，你跟我在这儿较什么劲哪！",
            "nextDialogs": [
              "760320206"
            ]
          },
          "760320206": {
            "id": "760320206",
            "speakerId": 1000,
            "speakerName": "特辖队士兵",
            "text": "她是什么下场轮不到你操心。束手就擒吧！"
          }
        }
      }
    }
  ]

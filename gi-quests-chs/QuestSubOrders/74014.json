              "740141703"
            ]
          },
          "740141703": {
            "id": "740141703",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "那些愚人众已经被赶跑了。",
            "nextDialogs": [
              "740141704"
            ]
          },
          "740141704": {
            "id": "740141704",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "而且，你要的那些数据，我们也已经拿到了…",
            "nextDialogs": [
              "740141705"
            ]
          },
          "740141705": {
            "id": "740141705",
            "speakerId": 1003,
            "speakerName": "Black Screen",
            "text": "向布罗意出示了先前拿到的纸带…",
            "nextDialogs": [
              "740141706"
            ]
          },
          "740141706": {
            "id": "740141706",
            "speakerId": 1000,
            "speakerName": "布罗意",
            "text": "啊啊啊，没错，就是这个，就是这个！两位简直就是上天派来救我脱离苦海，重新过上美好幸福清闲生活的天使——",
            "nextDialogs": [
              "740141707"
            ]
          },
          "740141707": {
            "id": "740141707",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "喂！已经完全不提科学的事情了啊！",
            "nextDialogs": [
              "740141708"
            ]
          },
          "740141708": {
            "id": "740141708",
            "speakerId": 1000,
            "speakerName": "布罗意",
            "text": "#总之，事不宜迟，好心的{M#先生}{F#小姐}，请您陪我回枫丹科学院，找主管申请中枢处理站的钥匙吧！"
          }
        }
      }
    },

    {
      "subId": "7401416",
      "subQuestName": "操作研察终端，获取水文研究数据",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "740140801"
        ],
        "dialogs": {
          "740140801": {
            "id": "740140801",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "好耶！这样一来，就可以启动控制台啦！",
            "nextDialogs": [
              "740140802"
            ]
          },
          "740140802": {
            "id": "740140802",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "让我看看操作指南…接下来只要拉下写着「千万不要动！」的拉杆，就可以输出记录的数据…",
            "nextDialogs": [
              "740140803"
            ]
          },
          "740140803": {
            "id": "740140803",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "千万不要动？",
            "nextDialogs": [
              "740140804"
            ]
          },
          "740140804": {
            "id": "740140804",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "唔，指南上说，是为了防止其他人误操作？好奇怪的做法…",
            "nextDialogs": [
              "740140805"
            ]
          },
          "740140805": {
            "id": "740140805",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "（拉动拉杆。）",
            "nextDialogs": [
              "740140806"
            ]
          },
          "740140806": {
            "id": "740140806",
            "speakerId": 1003,
            "speakerName": "Black Screen",
            "text": "你拉下了拉杆。\\n一阵轰鸣和晃动后，机器吐出了一叠纸带…",
            "nextDialogs": [
              "740140807"
            ]
          },
          "740140807": {
            "id": "740140807",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "唔，布罗意要的监测数据，应该就是这个了…",
            "nextDialogs": [
              "740140808"
            ]
          },
          "740140808": {
            "id": "740140808",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "虽然完全看不懂上面写的是什么，但只要拿回去给他就好了吧！"
          }
        }
      }
    },

    {
      "subId": "2101902",
      "subQuestName": "观察铭文$UNRELEASED",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "210060201"
        ],
        "dialogs": {
          "210060201": {
            "id": "210060201",
            "speakerId": 1000,
            "speakerName": "残缺的文字",
            "text": "「轻策即已无螭，缚龙妙法亦无用。…」",
            "nextDialogs": [
              "210060202"
            ]
          },
          "210060202": {
            "id": "210060202",
            "speakerId": 1000,
            "speakerName": "残缺的文字",
            "text": "「…然螭身不死，其血凝于地，结之为石，污害世间…」",
            "nextDialogs": [
              "210060203"
            ]
          },
          "210060203": {
            "id": "210060203",
            "speakerId": 1000,
            "speakerName": "残缺的文字",
            "text": "「…故镇之以尊像，其数为三…」",
            "nextDialogs": [
              "210060204"
            ]
          },
          "210060204": {
            "id": "210060204",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "…好难读的三段话，璃月的传说都这么难懂的吗…",
            "nextDialogs": [
              "210060205"
            ]
          },
          "210060205": {
            "id": "210060205",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "不过，里面说<color=#00E1FFFF>「…其血凝于地，结之为石…」</color>，难道是在说某种<color=#00E1FFFF>奇怪的石头</color>吗？",
            "nextDialogs": [
              "210060206"
            ]
          },
          "210060206": {
            "id": "210060206",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "唔，我们四处找找，留意一下周围的<color=#00E1FFFF>石头</color>吧，说不定能找到什么线索呢。"
          }
        }
      }
    },

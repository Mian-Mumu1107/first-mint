    {
      "subId": "2060304",
      "subQuestName": "前往可疑点调查并消除威胁",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "206030401"
        ],
        "dialogs": {
          "206030401": {
            "id": "206030401",
            "speakerId": 1409,
            "speakerName": "塞琉斯",
            "text": "被风吹走的告示牌…被风吹走的花…走失的猫…唉…果然不出我所料…"
          }
        }
      }
    },
    {
      "subId": "2060305",
      "subQuestName": "(test)调查点进度记录（隐藏）$HIDDEN",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "206030501"
        ],
        "dialogs": {
          "206030501": {
            "id": "206030501",
            "speakerId": 1409,
            "speakerName": "塞琉斯",
            "text": "你们这么快就回来了，看来确实没什么大事…",
            "nextDialogs": [
              "206030502"
            ]
          },
          "206030502": {
            "id": "206030502",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "还有不少魔物在活跃。",
            "nextDialogs": [
              "206030503"
            ]
          },
          "206030503": {
            "id": "206030503",
            "speakerId": 1409,
            "speakerName": "塞琉斯",
            "text": "什么？还有魔物在游荡，数量比原来的还多了？",
            "nextDialogs": [
              "206030504"
            ]
          },
          "206030504": {
            "id": "206030504",
            "speakerId": 1409,
            "speakerName": "塞琉斯",
            "text": "奇怪，先前来攻击蒙德城的大部队都已经被击退了，为什么它们还在蒙德城附近游荡？",
            "nextDialogs": [
              "206030505"
            ]
          },
          "206030505": {
            "id": "206030505",
            "speakerId": 1409,
            "speakerName": "塞琉斯",
            "text": "难道它们还有什么计划…不行，我得把冒险家们都召集回来，重新发布委托，不能对这些魔物掉以轻心。",
            "nextDialogs": [
              "206030506"
            ]
          },
          "206030506": {
            "id": "206030506",
            "speakerId": 1409,
            "speakerName": "塞琉斯",
            "text": "对野外游荡的魔物进行秘密调查，这可是冒险家协会的专业范围…是时候展现冒险家协会的力量了！",
            "nextDialogs": [
              "206030507"
            ]
          },
          "206030507": {
            "id": "206030507",
            "speakerId": 1409,
            "speakerName": "塞琉斯",
            "text": "对了，这是给你的谢礼，收下吧。"
          }
        }
      }
    },

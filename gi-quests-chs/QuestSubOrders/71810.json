    {
      "subId": "7181004",
      "subQuestName": "使用元素视野寻找史莱姆",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "718100401"
        ],
        "dialogs": {
          "718100401": {
            "id": "718100401",
            "speakerId": 20088,
            "speakerName": "爱拉尼",
            "text": "哦！你已经开启「元素视野」了吗？",
            "nextDialogs": [
              "718100402"
            ]
          },
          "718100402": {
            "id": "718100402",
            "speakerId": 20088,
            "speakerName": "爱拉尼",
            "text": "哎呀，这附近有元素的痕迹吗？怎么…感觉和周围没什么区别…"
          }
        }
      }

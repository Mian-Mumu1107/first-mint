    {
      "subId": "2503007",
      "subQuestName": "挖掘出埋藏着的目标机关",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "250300701"
        ],
        "dialogs": {
          "250300701": {
            "id": "250300701",
            "speakerId": 14366,
            "speakerName": "阿蕾梅",
            "text": "塔莫蕾姐姐，我训练得怎么样？可以做考古学家了吗？",
            "nextDialogs": [
              "250300702"
            ]
          },
          "250300702": {
            "id": "250300702",
            "speakerId": 6087,
            "speakerName": "塔莫蕾",
            "text": "嗯，阿蕾梅训练得很好，只要再巩固一下，姐姐就可以开始教你正式的课程的。",
            "nextDialogs": [
              "250300703"
            ]
          },
          "250300703": {
            "id": "250300703",
            "speakerId": 6088,
            "speakerName": "阿基约",
            "text": "你的塔莫蕾姐姐可是专门为你整理了一遍资料，等训练结束后，要好好学习喔。",
            "nextDialogs": [
              "250300704"
            ]
          },
          "250300704": {
            "id": "250300704",
            "speakerId": 6087,
            "speakerName": "塔莫蕾",
            "text": "#{NICKNAME}，你来得正好。阿蕾梅，准备和{M#大哥哥}{F#大姐姐}去训练吧。"
          }
        }
      }
    },

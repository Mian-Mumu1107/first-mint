    {
      "subId": "2503010",
      "subQuestName": "为阿蕾梅示范「耐久力」训练",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "250301001"
        ],
        "dialogs": {
          "250301001": {
            "id": "250301001",
            "speakerId": 6088,
            "speakerName": "阿基约",
            "text": "咳。咱们到了，这里是「耐久力」的训练场。",
            "nextDialogs": [
              "250301002"
            ]
          },
          "250301002": {
            "id": "250301002",
            "speakerId": 6088,
            "speakerName": "阿基约",
            "text": "呃…这个场地还是咱们部族请「悬木人」那边的人过来，专门改造了一番。",
            "nextDialogs": [
              "250301003"
            ]
          },
          "250301003": {
            "id": "250301003",
            "speakerId": 6088,
            "speakerName": "阿基约",
            "text": "简单来说，在这场训练中，无论你用什么方法，只要以尽可能快的速度到达终点就好！",
            "nextDialogs": [
              "250301004"
            ]
          },
          "250301004": {
            "id": "250301004",
            "speakerId": 6088,
            "speakerName": "阿基约",
            "text": "#接下来！就请{NICKNAME}示范一下，如何快速到达终点吧。"
          }
        }
      }
    },
    {
      "subId": "2503011",
      "subQuestName": "迅速抵达目标点",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "250301101"
        ],
        "dialogs": {
          "250301101": {
            "id": "250301101",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "今天训练一下「观察力」吧。",
            "nextDialogs": [
              "250301102"
            ]
          },
          "250301102": {
            "id": "250301102",
            "speakerId": 14366,
            "speakerName": "阿蕾梅",
            "text": "我准备好啦！",
            "nextDialogs": [
              "250301103"
            ]
          },
          "250301103": {
            "id": "250301103",
            "speakerId": 6088,
            "speakerName": "阿基约",
            "text": "状态很好嘛，阿蕾梅。那咱们现在就去训练场地吧。"
          }
        }
      }
    },
    {
      "subId": "2503012",
      "subQuestName": "向塔莫蕾回报",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "250301201"
        ],
        "dialogs": {
          "250301201": {
            "id": "250301201",
            "speakerId": 1003,
            "speakerName": "Black Screen",
            "text": "过了一会，塔莫蕾三人才从旁边的小路钻了出来…",
            "nextDialogs": [
              "250301202"
            ]
          },
          "250301202": {
            "id": "250301202",
            "speakerId": 6088,
            "speakerName": "阿基约",
            "text": "你跑得也太快了，我们抄小路都没追上你。",
            "nextDialogs": [
              "250301203"
            ]
          },
          "250301203": {
            "id": "250301203",
            "speakerId": 6087,
            "speakerName": "塔莫蕾",
            "text": "谢天谢地，我们真是运气好，居然能遇见你这么厉害的人…",
            "nextDialogs": [
              "250301204"
            ]
          },
          "250301204": {
            "id": "250301204",
            "speakerId": 14366,
            "speakerName": "阿蕾梅",
            "text": "我看明白了，可以开始跑了吗？我已经准备好了！",
            "nextDialogs": [
              "250301205"
            ]
          },
          "250301205": {
            "id": "250301205",
            "speakerId": 6087,
            "speakerName": "塔莫蕾",
            "text": "等一下阿蕾梅，不要着急。等一下阿基约哥哥还要调整一下场地里的设施。让这个场地…更加适合你发挥。",
            "nextDialogs": [
              "250301206"
            ]
          },
          "250301206": {
            "id": "250301206",
            "speakerId": 6088,
            "speakerName": "阿基约",
            "text": "在那之前，你就先在姐姐旁边，千万不要到处乱跑，也不要抢跑喔。",
            "nextDialogs": [
              "250301207"
            ]
          },
          "250301207": {
            "id": "250301207",
            "speakerId": 14366,
            "speakerName": "阿蕾梅",
            "text": "我知道啦。我很听话的，绝对不抢跑。",
            "nextDialogs": [
              "250301208"
            ]
          },
          "250301208": {
            "id": "250301208",
            "speakerId": 6087,
            "speakerName": "塔莫蕾",
            "text": "阿蕾梅真乖，来姐姐这边，姐姐给你把衣服整理一下，免得你跑到一半被衣服绊倒…",
            "nextDialogs": [
              "250301209"
            ]
          },
          "250301209": {
            "id": "250301209",
            "speakerId": 6088,
            "speakerName": "阿基约",
            "text": "#呼…感谢你的协助，{NICKNAME}。要是没你帮忙，我们都不知道怎么办了…",
            "nextDialogs": [
              "250301210"
            ]
          },
          "250301210": {
            "id": "250301210",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "你自己做示范就行了。",
            "nextDialogs": [
              "250301211"
            ]
          },
          "250301211": {
            "id": "250301211",
            "speakerId": 6088,
            "speakerName": "阿基约",
            "text": "我？你就别开玩笑了。没了我的龙伙伴，就凭我的腿脚可跑不了多快。",
            "nextDialogs": [
              "250301212"
            ]
          },
          "250301212": {
            "id": "250301212",
            "speakerId": 6088,
            "speakerName": "阿基约",
            "text": "唉，要是能再挖到点宝贝就好了。也不知道塔莫蕾小姐准备什么时候再次开展考古…",
            "nextDialogs": [
              "250301213"
            ]
          },
          "250301213": {
            "id": "250301213",
            "speakerId": 6088,
            "speakerName": "阿基约",
            "text": "不对不对，要是考古完成，她就要回须弥了。这样的话…",
            "nextDialogs": [
              "250301214"
            ]
          },
          "250301214": {
            "id": "250301214",
            "speakerId": 6088,
            "speakerName": "阿基约",
            "text": "咳！我，我什么也没说啊。这些报酬是给你的，快收下快收下，别和我们客气。",
            "nextDialogs": [
              "250301215"
            ]
          },
          "250301215": {
            "id": "250301215",
            "speakerId": 6088,
            "speakerName": "阿基约",
            "text": "好了，我得去布置场地了。呃…这次布什么好呢？"
          }
        }
      }
    },
    {
      "subId": "2503001",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "250300101"
        ],
        "dialogs": {
          "250300101": {
            "id": "250300101",
            "speakerId": 14366,
            "speakerName": "阿蕾梅",
            "text": "塔莫蕾姐姐！我也想做考古学家！",
            "nextDialogs": [
              "250300102"
            ]
          },
          "250300102": {
            "id": "250300102",
            "speakerId": 6087,
            "speakerName": "塔莫蕾",
            "text": "小阿蕾梅，考古学家可不是只用到处挖石头就行，要学习很多东西的喔。",
            "nextDialogs": [
              "250300103"
            ]
          },
          "250300103": {
            "id": "250300103",
            "speakerId": 14366,
            "speakerName": "阿蕾梅",
            "text": "可是，考古学家可以和小龙一起玩！妈妈都不让我去找自己的龙！",
            "nextDialogs": [
              "250300104"
            ]
          },
          "250300104": {
            "id": "250300104",
            "speakerId": 6088,
            "speakerName": "阿基约",
            "text": "阿蕾梅，你妈妈不是说过了吗？这件事要等你长大之后再说。",
            "nextDialogs": [
              "250300105"
            ]
          },
          "250300105": {
            "id": "250300105",
            "speakerId": 14366,
            "speakerName": "阿蕾梅",
            "text": "我就在长大呀！塔莫蕾姐姐都说了，只有头脑的成长，才算是真正的成长。",
            "nextDialogs": [
              "250300106"
            ]
          },
          "250300106": {
            "id": "250300106",
            "speakerId": 14366,
            "speakerName": "阿蕾梅",
            "text": "我找塔莫蕾姐姐学习知识，就是要快快长大。这是塔莫蕾姐姐亲口告诉我的！",
            "nextDialogs": [
              "250300107"
            ]
          },
          "250300107": {
            "id": "250300107",
            "speakerId": 6087,
            "speakerName": "塔莫蕾",
            "text": "这确实…是我说的。哈哈哈…你这孩子还挺聪明的…",
            "nextDialogs": [
              "250300108"
            ]
          },
          "250300108": {
            "id": "250300108",
            "speakerId": 6088,
            "speakerName": "阿基约",
            "text": "塔莫蕾小姐，这可怎么办…",
            "nextDialogs": [
              "250300112",
              "250300111"
            ]
          },
          "250300112": {
            "id": "250300112",
            "speakerId": 6087,
            "speakerName": "塔莫蕾",
            "text": "我们…咳，阿蕾梅，这确实是我亲口说的，而且姐姐也没有骗你。",
            "nextDialogs": [
              "250300113"
            ]
          },
          "250300113": {
            "id": "250300113",
            "speakerId": 6087,
            "speakerName": "塔莫蕾",
            "text": "但在你正式学习考古学家相关的课程之前，还要接受…那个…课前…课前培训。",
            "nextDialogs": [
              "250300114"
            ]
          },
          "250300114": {
            "id": "250300114",
            "speakerId": 6087,
            "speakerName": "塔莫蕾",
            "text": "#这位{M#大哥哥}{F#大姐姐}，就是我专门请来为你培训的…课程导师！",
            "nextDialogs": [
              "250300115"
            ]
          },
          "250300115": {
            "id": "250300115",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "#我是{NICKNAME}。",
            "nextDialogs": [
              "250300116"
            ]
          },
          "250300116": {
            "id": "250300116",
            "speakerId": 14366,
            "speakerName": "阿蕾梅",
            "text": "好欸！",
            "nextDialogs": [
              "250300117"
            ]
          },
          "250300117": {
            "id": "250300117",
            "speakerId": 6087,
            "speakerName": "塔莫蕾",
            "text": "…抱歉。总之拜托你先配合我一下，拜托拜托，我会给你准备好报酬的。"
          },
          "250300111": {
            "id": "250300111",
            "speakerId": 6088,
            "speakerName": "阿基约",
            "text": "这位朋友，你已经不用长大了。你看起来够成熟了。"
          }
        }
      }
    },
    {
      "subId": "2503006",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "250300601"
        ],
        "dialogs": {
          "250300601": {
            "id": "250300601",
            "speakerId": 6088,
            "speakerName": "阿基约",
            "text": "大灵原谅，大灵原谅，我们也不是出于恶意…那些机关顶多是把人掀翻，绝对不会让人受到大伤…大灵原谅，大灵原谅…"
          }
        }
      }
    },
    {
      "subId": "2503008",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "250300801"
        ],
        "dialogs": {
          "250300801": {
            "id": "250300801",
            "speakerId": 14366,
            "speakerName": "阿蕾梅",
            "text": "我准备好了，阿基约哥哥！",
            "nextDialogs": [
              "250300802"
            ]
          },
          "250300802": {
            "id": "250300802",
            "speakerId": 6088,
            "speakerName": "阿基约",
            "text": "你这丫头，还催起我来了…我马上就去调整场地，你别着急啊。",
            "nextDialogs": [
              "250300803"
            ]
          },
          "250300803": {
            "id": "250300803",
            "speakerId": 6087,
            "speakerName": "塔莫蕾",
            "text": "你的身手还是那么高超啊…这么快就把埋着的那些机关挖出来了。",
            "nextDialogs": [
              "250300804"
            ]
          },
          "250300804": {
            "id": "250300804",
            "speakerId": 6087,
            "speakerName": "塔莫蕾",
            "text": "也许，就是因为有你这样厉害的榜样做示范，阿蕾梅才会这么有劲头训练吧。",
            "nextDialogs": [
              "250300805"
            ]
          },
          "250300805": {
            "id": "250300805",
            "speakerId": 6087,
            "speakerName": "塔莫蕾",
            "text": "…看阿蕾梅这孩子的劲头。我也在想，也许她真的能做一个优秀的考古学家。",
            "nextDialogs": [
              "250300807",
              "250300810"
            ]
          },
          "250300807": {
            "id": "250300807",
            "speakerId": 6087,
            "speakerName": "塔莫蕾",
            "text": "那些啊。只是我的一些笔记和心得，还有一些乱七八糟的故事而已。",
            "nextDialogs": [
              "250300808"
            ]
          },
          "250300808": {
            "id": "250300808",
            "speakerId": 6087,
            "speakerName": "塔莫蕾",
            "text": "我真没想到，阿蕾梅这孩子能看得下去。",
            "nextDialogs": [
              "250300812"
            ]
          },
          "250300812": {
            "id": "250300812",
            "speakerId": 6087,
            "speakerName": "塔莫蕾",
            "text": "好了，这些报酬给你，请收下吧。等会我还要给阿蕾梅整理新一批资料。",
            "nextDialogs": [
              "250300813"
            ]
          },
          "250300813": {
            "id": "250300813",
            "speakerId": 6087,
            "speakerName": "塔莫蕾",
            "text": "在我离开纳塔前，会把一切能教的知识都教给阿蕾梅。",
            "nextDialogs": [
              "250300814"
            ]
          },
          "250300814": {
            "id": "250300814",
            "speakerId": 6087,
            "speakerName": "塔莫蕾",
            "text": "呵呵…希望未来的纳塔，真的会出现一颗考古学界的新星。"
          },
          "250300810": {
            "id": "250300810",
            "speakerId": 6087,
            "speakerName": "塔莫蕾",
            "text": "「培养」这个词也太重了。就凭我的资质，最多给阿蕾梅做一个考古学启蒙。",
            "nextDialogs": [
              "250300811"
            ]
          },
          "250300811": {
            "id": "250300811",
            "speakerId": 6087,
            "speakerName": "塔莫蕾",
            "text": "要是再往深了教，我肯定会误人子弟…"
          }
        }
      }
    },
    {
      "subId": "2503013",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "250301301"
        ],
        "dialogs": {
          "250301301": {
            "id": "250301301",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "今天训练一下「耐久力」吧。",
            "nextDialogs": [
              "250301302"
            ]
          },
          "250301302": {
            "id": "250301302",
            "speakerId": 14366,
            "speakerName": "阿蕾梅",
            "text": "我准备好啦！",
            "nextDialogs": [
              "250301303"
            ]
          },
          "250301303": {
            "id": "250301303",
            "speakerId": 14813,
            "speakerName": "阿基约",
            "text": "状态很好嘛，阿蕾梅。那咱们现在就去训练场地吧。"
          }
        }
      }
    },
    {
      "subId": "2503014",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "250301401"
        ],
        "dialogs": {
          "250301401": {
            "id": "250301401",
            "speakerId": 14366,
            "speakerName": "阿蕾梅",
            "text": "塔莫蕾姐姐，我已经把上次你给我的那本书看完了，也做好了笔记，你看看。",
            "nextDialogs": [
              "250301402"
            ]
          },
          "250301402": {
            "id": "250301402",
            "speakerId": 6087,
            "speakerName": "塔莫蕾",
            "text": "喔…哦，这笔记做得…真不错。",
            "nextDialogs": [
              "250301403"
            ]
          },
          "250301403": {
            "id": "250301403",
            "speakerId": 14366,
            "speakerName": "阿蕾梅",
            "text": "嗯，因为塔莫蕾姐姐说，只有认真学习，才能做考古学家。",
            "nextDialogs": [
              "250301404"
            ]
          },
          "250301404": {
            "id": "250301404",
            "speakerId": 6087,
            "speakerName": "塔莫蕾",
            "text": "…这样啊。",
            "nextDialogs": [
              "250301405"
            ]
          },
          "250301405": {
            "id": "250301405",
            "speakerId": 6087,
            "speakerName": "塔莫蕾",
            "text": "阿蕾梅。姐姐相信，你肯定能成为最优秀的考古学家。"
          }
        }
      }
    },
    {
      "subId": "2503015",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "250301501"
        ],
        "dialogs": {
          "250301501": {
            "id": "250301501",
            "speakerId": 14813,
            "speakerName": "阿基约",
            "text": "和上次一样，这里的场地底下埋藏着不少机关。",
            "nextDialogs": [
              "250301502"
            ]
          },
          "250301502": {
            "id": "250301502",
            "speakerId": 14813,
            "speakerName": "阿基约",
            "text": "考虑到阿蕾梅的实力已经很强了，所以…我稍微增加了一些难度，埋藏了更多的机关。",
            "nextDialogs": [
              "250301503"
            ]
          },
          "250301503": {
            "id": "250301503",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "…你埋了新的机关？",
            "nextDialogs": [
              "250301504"
            ]
          },
          "250301504": {
            "id": "250301504",
            "speakerId": 14813,
            "speakerName": "阿基约",
            "text": "…嘘，嘘！是上次的爆炸机关还没拆完啊…",
            "nextDialogs": [
              "250301505"
            ]
          },
          "250301505": {
            "id": "250301505",
            "speakerId": 14813,
            "speakerName": "阿基约",
            "text": "#总之，{NICKNAME}，示范就交给你了。我相信那些机关肯定难不倒你。"
          }
        }
      }
    },
    {
      "subId": "2503016",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "250301601"
        ],
        "dialogs": {
          "250301601": {
            "id": "250301601",
            "speakerId": 14813,
            "speakerName": "阿基约",
            "text": "阿蕾梅这孩子…难道是认真的…"
          }
        }
      }
    },
    {
      "subId": "2503017",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "250301701"
        ],
        "dialogs": {
          "250301701": {
            "id": "250301701",
            "speakerId": 14813,
            "speakerName": "阿基约",
            "text": "咱们到了，这里是「耐久力」的训练场。",
            "nextDialogs": [
              "250301702"
            ]
          },
          "250301702": {
            "id": "250301702",
            "speakerId": 14813,
            "speakerName": "阿基约",
            "text": "和上次一样，无论你用什么方法，只要以尽可能快的速度到达终点就好！",
            "nextDialogs": [
              "250301703"
            ]
          },
          "250301703": {
            "id": "250301703",
            "speakerId": 14813,
            "speakerName": "阿基约",
            "text": "#{NICKNAME}，示范就交给你了。让我们看看你的实力吧。"
          }
        }
      }
    },
    {
      "subId": "2503018",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "250301801"
        ],
        "dialogs": {
          "250301801": {
            "id": "250301801",
            "speakerId": 14366,
            "speakerName": "阿蕾梅",
            "text": "跑步我最擅长了。我跑得可快了，有时候妈妈都追不上我呢。",
            "nextDialogs": [
              "250301802"
            ]
          },
          "250301802": {
            "id": "250301802",
            "speakerId": 6087,
            "speakerName": "塔莫蕾",
            "text": "等一下，等一下阿蕾梅，我们还是先看完示范吧。做考古学家，耐心也是很重要的！",
            "nextDialogs": [
              "250301803"
            ]
          },
          "250301803": {
            "id": "250301803",
            "speakerId": 14366,
            "speakerName": "阿蕾梅",
            "text": "喔…好吧，那等一下我要第一个开始跑！"
          }
        }
      }
    },
    {
      "subId": "2503019",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "250301901"
        ],
        "dialogs": {
          "250301901": {
            "id": "250301901",
            "speakerId": 14366,
            "speakerName": "阿蕾梅",
            "text": "塔莫蕾姐姐，你上次给我的那份笔记，我有些地方看不明白…",
            "nextDialogs": [
              "250301902"
            ]
          },
          "250301902": {
            "id": "250301902",
            "speakerId": 6087,
            "speakerName": "塔莫蕾",
            "text": "我看看…欸？这，这里的问题…",
            "nextDialogs": [
              "250301903"
            ]
          },
          "250301903": {
            "id": "250301903",
            "speakerId": 14366,
            "speakerName": "阿蕾梅",
            "text": "姐姐，你能详细讲给我听听吗？",
            "nextDialogs": [
              "250301904"
            ]
          },
          "250301904": {
            "id": "250301904",
            "speakerId": 6087,
            "speakerName": "塔莫蕾",
            "text": "啊？哈哈哈…好啊，你稍等一下喔，我整理一下思路…"
          }
        }
      }
    },
    {
      "subId": "2503020",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "250302001"
        ],
        "dialogs": {
          "250302001": {
            "id": "250302001",
            "speakerId": 14813,
            "speakerName": "阿基约",
            "text": "大灵原谅，大灵原谅，我们也不是出于恶意…"
          }
        }
      }
    },
    {
      "subId": "2503021",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "250302101"
        ],
        "dialogs": {
          "250302101": {
            "id": "250302101",
            "speakerId": 14813,
            "speakerName": "阿基约",
            "text": "阿蕾梅这孩子…难道是认真的…"
          }
        }
      }
    },
    {
      "subId": "2503022",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "250302201"
        ],
        "dialogs": {
          "250302201": {
            "id": "250302201",
            "speakerId": 1003,
            "speakerName": "Black Screen",
            "text": "过了一会，塔莫蕾三人才从旁边的小路钻了出来…",
            "nextDialogs": [
              "250302202"
            ]
          },
          "250302202": {
            "id": "250302202",
            "speakerId": 14366,
            "speakerName": "阿蕾梅",
            "text": "我觉得…可以直接跑，不用调整场地了，阿基约哥哥。",
            "nextDialogs": [
              "250302203"
            ]
          },
          "250302203": {
            "id": "250302203",
            "speakerId": 14813,
            "speakerName": "阿基约",
            "text": "哎哟，你这丫头。别着急啊，路上那些枯枝石头都得收拾一下，你等一下被绊倒了怎么办？",
            "nextDialogs": [
              "250302204"
            ]
          },
          "250302204": {
            "id": "250302204",
            "speakerId": 6087,
            "speakerName": "塔莫蕾",
            "text": "你的速度可真快，我看…无论怎么抄小路，我们都追不上你了。",
            "nextDialogs": [
              "250302205"
            ]
          },
          "250302205": {
            "id": "250302205",
            "speakerId": 6087,
            "speakerName": "塔莫蕾",
            "text": "也许，就是因为有你这样厉害的榜样做示范，阿蕾梅才会这么有劲头训练吧。",
            "nextDialogs": [
              "250302206"
            ]
          },
          "250302206": {
            "id": "250302206",
            "speakerId": 6087,
            "speakerName": "塔莫蕾",
            "text": "…看阿蕾梅这孩子的劲头。我也在想，也许她真的能做一个优秀的考古学家。",
            "nextDialogs": [
              "250302208",
              "250302211"
            ]
          },
          "250302208": {
            "id": "250302208",
            "speakerId": 6087,
            "speakerName": "塔莫蕾",
            "text": "那些啊。只是我的一些笔记和心得，还有一些乱七八糟的故事而已。",
            "nextDialogs": [
              "250302209"
            ]
          },
          "250302209": {
            "id": "250302209",
            "speakerId": 6087,
            "speakerName": "塔莫蕾",
            "text": "我真没想到，阿蕾梅这孩子能看得下去。",
            "nextDialogs": [
              "250302213"
            ]
          },
          "250302213": {
            "id": "250302213",
            "speakerId": 6087,
            "speakerName": "塔莫蕾",
            "text": "好了，这些报酬给你，请收下吧。等会我还要给阿蕾梅整理新一批资料。",
            "nextDialogs": [
              "250302214"
            ]
          },
          "250302214": {
            "id": "250302214",
            "speakerId": 6087,
            "speakerName": "塔莫蕾",
            "text": "在我离开纳塔前，会把一切能教的知识都教给阿蕾梅。",
            "nextDialogs": [
              "250302215"
            ]
          },
          "250302215": {
            "id": "250302215",
            "speakerId": 6087,
            "speakerName": "塔莫蕾",
            "text": "呵呵…希望未来的纳塔，真的会出现一颗考古学界的新星。"
          },
          "250302211": {
            "id": "250302211",
            "speakerId": 6087,
            "speakerName": "塔莫蕾",
            "text": "「培养」这个词也太重了。就凭我的资质，最多给阿蕾梅做一个考古学启蒙。",
            "nextDialogs": [
              "250302212"
            ]
          },
          "250302212": {
            "id": "250302212",
            "speakerId": 6087,
            "speakerName": "塔莫蕾",
            "text": "要是再往深了教，我肯定会误人子弟…"
          }
        }
      }
    }
  ]
}
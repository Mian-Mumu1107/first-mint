  "subQuests": [
    {
      "subId": "2503001",
      "subQuestName": "听听阿蕾梅的话",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "250300201"
        ],
        "dialogs": {
          "250300201": {
            "id": "250300201",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "先训练一下「观察力」。",
            "nextDialogs": [
              "250300202"
            ]
          },
          "250300202": {
            "id": "250300202",
            "speakerId": 6088,
            "speakerName": "阿基约",
            "text": "没问题。那我们现在就出发去训练场地吧。",
            "nextDialogs": [
              "250300203"
            ]
          },
          "250300203": {
            "id": "250300203",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "…真有训练场地？",
            "nextDialogs": [
              "250300204"
            ]
          },
          "250300204": {
            "id": "250300204",
            "speakerId": 6088,
            "speakerName": "阿基约",
            "text": "…咳，你小声点，这可是我好不容易找到的地方。那个场地本来是我们部族用来训练的，这段时间正在维修。",
            "nextDialogs": [
              "250300205"
            ]
          },
          "250300205": {
            "id": "250300205",
            "speakerId": 6088,
            "speakerName": "阿基约",
            "text": "虽然有些机关失去了作用…有些机关拆了一半…但那个场地作为训练场来说，绝对足够了…",
            "nextDialogs": [
              "250300208"
            ]
          },
          "250300208": {
            "id": "250300208",
            "speakerId": 6088,
            "speakerName": "阿基约",
            "text": "抱歉，抱歉…唉，这也是没办法的事啊。我好不容易才找到了这么一个相对安全的场地，但以我的实力，又没法做出漂亮的示范说服阿蕾梅…",
            "nextDialogs": [
              "250300209"
            ]
          },
          "250300209": {
            "id": "250300209",
            "speakerId": 6088,
            "speakerName": "阿基约",
            "text": "#我们就只能指望你了，{NICKNAME}！就算是为了阿蕾梅，也请你帮帮忙。",
            "nextDialogs": [
              "250300210"
            ]
          },
          "250300210": {
            "id": "250300210",
            "speakerId": 6088,
            "speakerName": "阿基约",
            "text": "要是不给这孩子一个准话，让她有点事情做，她说不定会一个人跑去部族外瞎鼓捣…",
            "nextDialogs": [
              "250300211"
            ]
          },
          "250300211": {
            "id": "250300211",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "行吧…",
            "nextDialogs": [
              "250300212"
            ]
          },
          "250300212": {
            "id": "250300212",
            "speakerId": 6088,
            "speakerName": "阿基约",
            "text": "谢谢你，呼…我总算是安心点了…",
            "nextDialogs": [
              "250300213"
            ]
          },
          "250300213": {
            "id": "250300213",
            "speakerId": 6087,
            "speakerName": "塔莫蕾",
            "text": "#好了！咱们快点出发吧。阿蕾梅，你等会可要好好看着{M#大哥哥}{F#大姐姐}的动作喔。",
            "nextDialogs": [
              "250300214"
            ]
          },
          "250300214": {
            "id": "250300214",
            "speakerId": 14366,
            "speakerName": "阿蕾梅",
            "text": "我知道了！",
            "nextDialogs": [
              "250300215"
            ]
          },
          "250300215": {
            "id": "250300215",
            "speakerId": 6088,
            "speakerName": "阿基约",
            "text": "…唉，居然对这么一个孩子撒谎。大灵可别怪罪我，我也是没办法啊…"
          }
        }
      }
    },
    {
      "subId": "2503002",

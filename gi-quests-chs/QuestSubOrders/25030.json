    {
      "subId": "2503003",
      "subQuestName": "为阿蕾梅示范「观察力」训练",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "250300301"
        ],
        "dialogs": {
          "250300301": {
            "id": "250300301",
            "speakerId": 6088,
            "speakerName": "阿基约",
            "text": "咳。咱们到了，这里是「观察力」训练场。",
            "nextDialogs": [
              "250300302"
            ]
          },
          "250300302": {
            "id": "250300302",
            "speakerId": 6088,
            "speakerName": "阿基约",
            "text": "虽然看起来很平坦，但是地底下实际上埋藏着不少爆炸机关。",
            "nextDialogs": [
              "250300303"
            ]
          },
          "250300303": {
            "id": "250300303",
            "speakerId": 6088,
            "speakerName": "阿基约",
            "text": "如果不经判断贸然前进，说不定就会踩爆机关，整个人都被掀倒在地。",
            "nextDialogs": [
              "250300304"
            ]
          },
          "250300304": {
            "id": "250300304",
            "speakerId": 6088,
            "speakerName": "阿基约",
            "text": "一般来说，我们「回声之子」都会借助嵴锋龙伙伴的帮助，避开干扰机关，找到并挖掘出埋藏着的目标机关。",
            "nextDialogs": [
              "250300305"
            ]
          },
          "250300305": {
            "id": "250300305",
            "speakerId": 6088,
            "speakerName": "阿基约",
            "text": "但是，作为一名考古学家，我们必须要考虑各种极端情况。",
            "nextDialogs": [
              "250300306"
            ]
          },
          "250300306": {
            "id": "250300306",
            "speakerId": 6088,
            "speakerName": "阿基约",
            "text": "所以…在这次训练中，你只能依靠自己的观察力找到，并挖掘出埋藏着的目标机关。",
            "nextDialogs": [
              "250300307"
            ]
          },
          "250300307": {
            "id": "250300307",
            "speakerId": 6088,
            "speakerName": "阿基约",
            "text": "#接下来！就请{NICKNAME}示范一下，如何以正确的方式挖掘出那些机关吧！"
          }
        }
      }
    },
    {
      "subId": "2503004",
      "subQuestName": "挖掘出埋藏着的目标机关",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "250300401"
        ],
        "dialogs": {
          "250300401": {
            "id": "250300401",
            "speakerId": 14366,
            "speakerName": "阿蕾梅",
            "text": "塔莫蕾姐姐，你们考古学家，真的要学这么辛苦的课程吗？",
            "nextDialogs": [
              "250300402"
            ]
          },
          "250300402": {
            "id": "250300402",
            "speakerId": 6087,
            "speakerName": "塔莫蕾",
            "text": "那是当然啦。这都不算什么，等你真正开始学习，才知道什么是真正辛苦的课程…",
            "nextDialogs": [
              "250300403"
            ]
          },
          "250300403": {
            "id": "250300403",
            "speakerId": 14366,
            "speakerName": "阿蕾梅",
            "text": "喔…"
          }
        }
      }
    },
    {
      "subId": "2503005",
      "subQuestName": "向阿基约回报",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "250300501"
        ],
        "dialogs": {
          "250300501": {
            "id": "250300501",
            "speakerId": 6087,
            "speakerName": "塔莫蕾",
            "text": "你的身手真不错啊…这么快就把埋着的那些机关挖出来了，而且…衣服看起来也很整洁，应该也没被爆炸机关掀翻多少次。",
            "nextDialogs": [
              "250300502"
            ]
          },
          "250300502": {
            "id": "250300502",
            "speakerId": 6087,
            "speakerName": "塔莫蕾",
            "text": "谢天谢地，我们真是运气好，居然能遇见你这么厉害的人…",
            "nextDialogs": [
              "250300503"
            ]
          },
          "250300503": {
            "id": "250300503",
            "speakerId": 14366,
            "speakerName": "阿蕾梅",
            "text": "好厉害！我也要试试，阿基约哥哥，也让我试试！",
            "nextDialogs": [
              "250300504"
            ]
          },
          "250300504": {
            "id": "250300504",
            "speakerId": 6088,
            "speakerName": "阿基约",
            "text": "别急啊阿蕾梅，场地需要重新布置一下。等布置好了之后，我会陪着你一步步熟悉课程的。",
            "nextDialogs": [
              "250300505"
            ]
          },
          "250300505": {
            "id": "250300505",
            "speakerId": 6088,
            "speakerName": "阿基约",
            "text": "但是，在布置好场地之前，你可要乖乖地留在塔莫蕾姐姐旁边，不能乱跑。",
            "nextDialogs": [
              "250300506"
            ]
          },
          "250300506": {
            "id": "250300506",
            "speakerId": 14366,
            "speakerName": "阿蕾梅",
            "text": "我知道啦。我很听话的，绝对不乱跑。",
            "nextDialogs": [
              "250300507"
            ]
          },
          "250300507": {
            "id": "250300507",
            "speakerId": 6087,
            "speakerName": "塔莫蕾",
            "text": "阿蕾梅真乖，来姐姐这边，姐姐给你先念一段和考古有关的文章，你可要听好了喔…",
            "nextDialogs": [
              "250300508"
            ]
          },
          "250300508": {
            "id": "250300508",
            "speakerId": 6088,
            "speakerName": "阿基约",
            "text": "#呼…感谢你的协助，{NICKNAME}。要是没你帮忙，我们都不知道怎么办了…",
            "nextDialogs": [
              "250300509"
            ]
          },
          "250300509": {
            "id": "250300509",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "你自己做示范就行了。",
            "nextDialogs": [
              "250300510"
            ]
          },
          "250300510": {
            "id": "250300510",
            "speakerId": 6088,
            "speakerName": "阿基约",
            "text": "我？唉，你就别开玩笑了。要是我没能挖出来那些宝贝，只怕连塔莫蕾小姐的安全都没法保护好。",
            "nextDialogs": [
              "250300511"
            ]
          },
          "250300511": {
            "id": "250300511",
            "speakerId": 6088,
            "speakerName": "阿基约",
            "text": "也不知道塔莫蕾小姐准备什么时候再次开展考古…不对不对，要是考古完成，她就要回须弥了，这样的话…",
            "nextDialogs": [
              "250300512"
            ]
          },
          "250300512": {
            "id": "250300512",
            "speakerId": 6088,
            "speakerName": "阿基约",
            "text": "咳！我，我什么也没说啊。这些报酬是给你的，快收下快收下，别和我们客气。",
            "nextDialogs": [
              "250300513"
            ]
          },
          "250300513": {
            "id": "250300513",
            "speakerId": 6088,
            "speakerName": "阿基约",
            "text": "好了，我得去布置场地了。呃…这次埋什么好呢？不然，埋点颗粒果好了…"
          }
        }
      }
    },

    {
      "subId": "7322011",
      "subQuestName": "与婕德对话",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "732201101"
        ],
        "dialogs": {
          "732201101": {
            "id": "732201101",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "哇…没想到在沙漠中间，还会有这样的地方…",
            "nextDialogs": [
              "732201102"
            ]
          },
          "732201102": {
            "id": "732201102",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "欸？原来我们从地下出来的时候，太阳已经快落山了吗？",
            "nextDialogs": [
              "732201103"
            ]
          },
          "732201103": {
            "id": "732201103",
            "speakerId": 20846,
            "speakerName": "利露帕尔",
            "text": "不…这里是女主人的乐园，水天相接的永恒一刻，是「机巧」与「慈爱」的媾合之时，此刻即是永恒。",
            "nextDialogs": [
              "732201104"
            ]
          },
          "732201104": {
            "id": "732201104",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "唔…虽然听不明白你在说什么，但应该是这里所有东西都静止不动的原因吧？",
            "nextDialogs": [
              "732201105"
            ]
          },
          "732201105": {
            "id": "732201105",
            "speakerId": 4296,
            "speakerName": "婕德",
            "text": "我的父母…所以说，他们会将这里视为归宿吗？",
            "nextDialogs": [
              "732201106"
            ]
          },
          "732201106": {
            "id": "732201106",
            "speakerId": 20846,
            "speakerName": "利露帕尔",
            "text": "我没这么说哦…唉，随便你怎么理解吧，可怜的孩子。"
          }
        }
      }
    },
    {

    {
      "subId": "7322009",
      "subQuestName": "拾取利露帕尔的碎片",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [],
        "dialogs": {}
      }
    },
    {
      "subId": "7322012",
      "subQuestName": "与利露帕尔对话",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "732201201"
        ],
        "dialogs": {
          "732201201": {
            "id": "732201201",
            "speakerId": 20846,
            "speakerName": "利露帕尔",
            "text": "我的女主人…她不在这里。",
            "nextDialogs": [
              "732201202"
            ]
          },
          "732201202": {
            "id": "732201202",
            "speakerId": 20846,
            "speakerName": "利露帕尔",
            "text": "但我却在这里寻到了自己的碎片…",
            "nextDialogs": [
              "732201203"
            ]
          },
          "732201203": {
            "id": "732201203",
            "speakerId": 20846,
            "speakerName": "利露帕尔",
            "text": "……"
          }
        }
      }
    },
    {
      "subId": "7322013",
      "subQuestName": "与利露帕尔对话",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "732201301"
        ],
        "dialogs": {
          "732201301": {
            "id": "732201301",
            "speakerId": 1003,
            "speakerName": "Black Screen",
            "text": "随着闪光的碎片汇入利露帕尔的魔瓶，你感到自身的力量也被抽离了少许…但很快，一股温暖的感觉充实了你。",
            "nextDialogs": [
              "732201302"
            ]
          },
          "732201302": {
            "id": "732201302",
            "speakerId": 1003,
            "speakerName": "Black Screen",
            "text": "从镇灵恍惚的目光中，你看到了红玉堆砌的宫阙与花园…千万种花儿盛开，万千鸟儿鸣啭。\\n镇灵们是女主人富有灵性的仆从，是她的乐师与斟酒者。\\n她的花园中，发疯的僧人与破落的旅人伴着萨吉的水仙旋舞，啜饮着葡萄藤女儿的鲜血…\\n这是世上无二的花园，曾是花之女主人的居所，如今是她长眠的陵墓…",
            "nextDialogs": [
              "732201303"
            ]
          },
          "732201303": {
            "id": "732201303",
            "speakerId": 1003,
            "speakerName": "Black Screen",
            "text": "「玫瑰绽放如火，将夜莺的生命点燃。蜡烛灿然微笑，却给飞蛾带来灾难。」",
            "nextDialogs": [
              "732201304"
            ]
          },
          "732201304": {
            "id": "732201304",
            "speakerId": 1003,
            "speakerName": "Black Screen",
            "text": "你看见她伸出手来，肤色如月光般透明。你望见她的脸庞，难以言喻的美丽。仿佛每一个美妙的镇灵都是她的花瓣，每一缕馨香都来自她一般…\\n然后，你对上了她的目光——",
            "nextDialogs": [
              "732201305"
            ]
          },
          "732201305": {
            "id": "732201305",
            "speakerId": 1003,
            "speakerName": "Black Screen",
            "text": "那里什么都没有。\\n只有无垠的虚空，令你坠落其中，恐惧不已…",
            "nextDialogs": [
              "732201306"
            ]
          },
          "732201306": {
            "id": "732201306",
            "speakerId": 1003,
            "speakerName": "Black Screen",
            "text": "你的意识逐渐恢复，婕德正握着你的手，神情担忧。",
            "nextDialogs": [
              "732201307"
            ]
          },
          "732201307": {
            "id": "732201307",
            "speakerId": 4296,
            "speakerName": "婕德",
            "text": "你醒了…你还好吗？",
            "nextDialogs": [
              "732201308"
            ]
          },
          "732201308": {
            "id": "732201308",
            "speakerId": 4296,
            "speakerName": "婕德",
            "text": "你刚刚…唉，算了。你没事就好…",
            "nextDialogs": [
              "732201309"
            ]
          },
          "732201309": {
            "id": "732201309",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "你都看到了什么呀…就像做了一个长梦一样，看起来蛮吓人的…",
            "nextDialogs": [
              "732201312"
            ]
          },
          "732201312": {
            "id": "732201312",
            "speakerId": 20846,
            "speakerName": "利露帕尔",
            "text": "……",
            "nextDialogs": [
              "732201313"
            ]
          },
          "732201313": {
            "id": "732201313",
            "speakerId": 20846,
            "speakerName": "利露帕尔",
            "text": "她已经不在这里了，他骗了我们，骗了我们所有人。",
            "nextDialogs": [
              "732201314"
            ]
          },
          "732201314": {
            "id": "732201314",
            "speakerId": 4296,
            "speakerName": "婕德",
            "text": "你说什么…？",
            "nextDialogs": [
              "732201315"
            ]
          },
          "732201315": {
            "id": "732201315",
            "speakerId": 20846,
            "speakerName": "利露帕尔",
            "text": "没什么，一个很久以前的契约取消了。我想…我自由了？",
            "nextDialogs": [
              "732201316"
            ]
          },
          "732201316": {
            "id": "732201316",
            "speakerId": 20846,
            "speakerName": "利露帕尔",
            "text": "沙海的王曾向我们承诺，花的女主人沉眠在此处，终有一日会从这里醒来…但…",
            "nextDialogs": [
              "732201317"
            ]
          },
          "732201317": {
            "id": "732201317",
            "speakerId": 20846,
            "speakerName": "利露帕尔",
            "text": "真是奇怪…女主人已经死去了，他骗了我…骗了我的族人。",
            "nextDialogs": [
              "732201318"
            ]
          },
          "732201318": {
            "id": "732201318",
            "speakerId": 20846,
            "speakerName": "利露帕尔",
            "text": "我本应该发了疯般地恨他，为了这片沙漠，为了女主人的死去…就像我曾爱他和仰视他…",
            "nextDialogs": [
              "732201319"
            ]
          },
          "732201319": {
            "id": "732201319",
            "speakerId": 20846,
            "speakerName": "利露帕尔",
            "text": "但…我却失去了憎恨的动力…为什么会这样…"
          }
        }
      }
    },
    {
      "subId": "7322005",
      "subQuestName": "前去寻找婕德",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [],
        "dialogs": {}
      }
    },
    {
      "subId": "7322014",
      "subQuestName": "与婕德对话",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "732201401"
        ],
        "dialogs": {
          "732201401": {
            "id": "732201401",
            "speakerId": 4296,
            "speakerName": "婕德",
            "text": "……",
            "nextDialogs": [
              "732201402"
            ]
          },
          "732201402": {
            "id": "732201402",
            "speakerId": 4296,
            "speakerName": "婕德",
            "text": "这个地方…和母亲日志里的古代草图能够对应上。应该就是这里了。",
            "nextDialogs": [
              "732201403"
            ]
          },
          "732201403": {
            "id": "732201403",
            "speakerId": 20846,
            "speakerName": "利露帕尔",
            "text": "是个安眠的好地方，对吧…？",
            "nextDialogs": [
              "732201404"
            ]
          },
          "732201404": {
            "id": "732201404",
            "speakerId": 4296,
            "speakerName": "婕德",
            "text": "…嗯。",
            "nextDialogs": [
              "732201405"
            ]
          },
          "732201405": {
            "id": "732201405",
            "speakerId": 4296,
            "speakerName": "婕德",
            "text": "危机四伏的沙漠，背叛和阴谋…无法原谅的事情，无法释怀的事情，明明刚发生了不久…",
            "nextDialogs": [
              "732201406"
            ]
          },
          "732201406": {
            "id": "732201406",
            "speakerId": 4296,
            "speakerName": "婕德",
            "text": "但在这里，我却很平静…很开心。我不知道…为什么会这样。",
            "nextDialogs": [
              "732201407"
            ]
          },
          "732201407": {
            "id": "732201407",
            "speakerId": 20846,
            "speakerName": "利露帕尔",
            "text": "因为这里是花的女主人最后的领域…天空的馈赠在地下深处维持着它的静止，这里保存了她最后的精魄…",
            "nextDialogs": [
              "732201408"
            ]
          },
          "732201408": {
            "id": "732201408",
            "speakerId": 20846,
            "speakerName": "利露帕尔",
            "text": "所以即使她已经死去，这里依然平静如初，就像从未有人来过。所以，进入这片领域的人…只会感受到平静与快乐。",
            "nextDialogs": [
              "732201409"
            ]
          },
          "732201409": {
            "id": "732201409",
            "speakerId": 20846,
            "speakerName": "利露帕尔",
            "text": "因为女主人是疯癫僧人与歧途旅客的保护者…这里对于他们来说，曾是归宿的乐园。",
            "nextDialogs": [
              "732201410"
            ]
          },
          "732201410": {
            "id": "732201410",
            "speakerId": 4296,
            "speakerName": "婕德",
            "text": "……",
            "nextDialogs": [
              "732201411"
            ]
          },
          "732201411": {
            "id": "732201411",
            "speakerId": 1003,
            "speakerName": "Black Screen",
            "text": "婕德没有说话，默默上前放下母亲的笔记，又将哲伯莱勒的大斧斜倚在一旁…\\n就仿佛他们从未走远一样。"
          }
        }
      }
    },
    {
      "subId": "7322004",
      "subQuestName": "陪伴婕德",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [],
        "dialogs": {}
      }
    },
    {
      "subId": "7322006",
      "subQuestName": "与婕德对话",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "732200601"
        ],
        "dialogs": {
          "732200601": {
            "id": "732200601",
            "speakerId": 4296,
            "speakerName": "婕德",
            "text": "抱歉…我一时有点不知该说什么。",
            "nextDialogs": [
              "732200602"
            ]
          },
          "732200602": {
            "id": "732200602",
            "speakerId": 4296,
            "speakerName": "婕德",
            "text": "时间就像忘记流动了一样，一切都是静止的。不知为什么，我甚至忘记了惊叹这里的奇异景色…只感到了平静。",
            "nextDialogs": [
              "732200603"
            ]
          },
          "732200603": {
            "id": "732200603",
            "speakerId": 4296,
            "speakerName": "婕德",
            "text": "在这种地方，伴着已死的神长眠…唉，虽然我宁愿他们从没有离开过。",
            "nextDialogs": [
              "732200604"
            ]
          },
          "732200604": {
            "id": "732200604",
            "speakerId": 4296,
            "speakerName": "婕德",
            "text": "真希望他们能永远留驻这里，不再被时间遗忘。",
            "nextDialogs": [
              "732200605"
            ]
          },
          "732200605": {
            "id": "732200605",
            "speakerId": 20846,
            "speakerName": "利露帕尔",
            "text": "……",
            "nextDialogs": [
              "732200606"
            ]
          },
          "732200606": {
            "id": "732200606",
            "speakerId": 20846,
            "speakerName": "利露帕尔",
            "text": "起初进来时，我们搅扰了碎片的力量，也破坏了维持稳定的机关…这里早晚会崩毁，被黄沙吞没。",
            "nextDialogs": [
              "732200607"
            ]
          },
          "732200607": {
            "id": "732200607",
            "speakerId": 20846,
            "speakerName": "利露帕尔",
            "text": "到那时候，女主人维持这片绿洲静止的残力也会回归诸天…这是无可挽回的结局。",
            "nextDialogs": [
              "732200608"
            ]
          },
          "732200608": {
            "id": "732200608",
            "speakerId": 4296,
            "speakerName": "婕德",
            "text": "嗯…我知道。但至少在那之前，至少在那之前…我的父母终于重聚了，就像他们从没离开彼此。",
            "nextDialogs": [
              "732200609"
            ]
          },
          "732200609": {
            "id": "732200609",
            "speakerId": 4296,
            "speakerName": "婕德",
            "text": "或许终有一天，我也会回到这里吧…等到我厌倦了所有冒险，离开了所有能称之为「家」的地方之后。",
            "nextDialogs": [
              "732200610"
            ]
          },
          "732200610": {
            "id": "732200610",
            "speakerId": 4296,
            "speakerName": "婕德",
            "text": "到那时候，再从容地说一句「我回来咯！」然后，躺在父母中间沉沉睡去。",
            "nextDialogs": [
              "732200611"
            ]
          },
          "732200611": {
            "id": "732200611",
            "speakerId": 4296,
            "speakerName": "婕德",
            "text": "……",
            "nextDialogs": [
              "732200612"
            ]
          },
          "732200612": {
            "id": "732200612",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "婕德…那一天一定还很远呢！现在…唔…现在哲伯莱勒肯定很高兴，虽然板着脸，但是肯定很高兴的…",
            "nextDialogs": [
              "732200613"
            ]
          },
          "732200613": {
            "id": "732200613",
            "speakerId": 4296,
            "speakerName": "婕德",
            "text": "谢谢你，派蒙…",
            "nextDialogs": [
              "732200614"
            ]
          },
          "732200614": {
            "id": "732200614",
            "speakerId": 4296,
            "speakerName": "婕德",
            "text": "#还有{NICKNAME}，很感谢你愿意一路陪我，完成这个小小的任性心愿…但现在我一个人想多陪父母一会…",
            "nextDialogs": [
              "732200616",
              "732200618"
            ]
          },
          "732200616": {
            "id": "732200616",
            "speakerId": 4296,
            "speakerName": "婕德",
            "text": "嗯…谢谢你。"
          },
          "732200618": {
            "id": "732200618",
            "speakerId": 4296,
            "speakerName": "婕德",
            "text": "不用管我…我随后会跟上来的。哈，现在还不是在这里定居的好时候呢，对吧？"
          }
        }
      }
    },
    {
      "subId": "7322022",
      "subQuestName": "与利露帕尔对话",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [],
        "dialogs": {}
      }
    },
    {
      "subId": "7322018",
      "subQuestName": "与利露帕尔对话",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "732201801"
        ],
        "dialogs": {
          "732201801": {
            "id": "732201801",
            "speakerId": 20846,
            "speakerName": "利露帕尔",
            "text": "她是个好孩子，我的大人。",
            "nextDialogs": [
              "732201802"
            ]
          },
          "732201802": {
            "id": "732201802",
            "speakerId": 20846,
            "speakerName": "利露帕尔",
            "text": "这孩子是一头天生的猛兽。她可能头脑不是很聪明，但生存直觉却敏锐无比…",
            "nextDialogs": [
              "732201803"
            ]
          },
          "732201803": {
            "id": "732201803",
            "speakerId": 20846,
            "speakerName": "利露帕尔",
            "text": "她知道谁想让她受伤流血，而一旦她嗅到这一点…就会拼命反击，毫不留情，无论对方有着多么亲密的掩饰…",
            "nextDialogs": [
              "732201804"
            ]
          },
          "732201804": {
            "id": "732201804",
            "speakerId": 20846,
            "speakerName": "利露帕尔",
            "text": "唉…但她还不知道，有什么样的罗网在等着她呢。她还不知道，她想要争取的那个家园…究竟是个多么虚伪的东西。",
            "nextDialogs": [
              "732201805"
            ]
          },
          "732201805": {
            "id": "732201805",
            "speakerId": 20846,
            "speakerName": "利露帕尔",
            "text": "我的大人，如果您在乎她，请好好保护她吧。",
            "nextDialogs": [
              "732201806"
            ]
          },
          "732201806": {
            "id": "732201806",
            "speakerId": 20846,
            "speakerName": "利露帕尔",
            "text": "我的小小建议，您就当作是…我不知道，就当是身为母亲，一点小小的补偿吧…"
          }
        }
      }
    },
    {
      "subId": "7322015",
      "subQuestName": "与婕德对话",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "732201501"
        ],
        "dialogs": {
          "732201501": {
            "id": "732201501",
            "speakerId": 4296,
            "speakerName": "婕德",
            "text": "……",
            "nextDialogs": [
              "732201502"
            ]
          },
          "732201502": {
            "id": "732201502",
            "speakerId": 4296,
            "speakerName": "婕德",
            "text": "（她只是静静地坐在这里，享受着与父母独处的时光。）",
            "nextDialogs": [
              "732201504",
              "732201506"
            ]
          },
          "732201504": {
            "id": "732201504",
            "speakerId": 4296,
            "speakerName": "婕德",
            "text": "……"
          },
          "732201506": {
            "id": "732201506",
            "speakerId": 4296,
            "speakerName": "婕德",
            "text": "如果你不介意的话，我还想多在这里待一会…抱歉。"
          }
        }
      }
    },
    {
      "subId": "7322007",
      "subQuestName": "离开「永恒绿洲」",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [],
        "dialogs": {}
      }
    },
    {
      "subId": "7322016",
      "subQuestName": "与婕德对话",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "732201601"
        ],
        "dialogs": {
          "732201601": {
            "id": "732201601",
            "speakerId": 4296,
            "speakerName": "婕德",
            "text": "我感觉好多了。谢谢你们。",
            "nextDialogs": [
              "732201602"
            ]
          },
          "732201602": {
            "id": "732201602",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "真的没事了吗？再休息一下也没关系的…",
            "nextDialogs": [
              "732201603"
            ]
          },
          "732201603": {
            "id": "732201603",
            "speakerId": 4296,
            "speakerName": "婕德",
            "text": "我们回去吧。去跟芭别尔主母报告我们一路上的消息。",
            "nextDialogs": [
              "732201604"
            ]
          },
          "732201604": {
            "id": "732201604",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "嗯，既然你这样说…那我们走吧！"
          }
        }
      }
    },
    {
      "subId": "7322008",
      "subQuestName": "向芭别尔回报情况",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "732200801"
        ],
        "dialogs": {
          "732200801": {
            "id": "732200801",
            "speakerId": 4296,
            "speakerName": "婕德",
            "text": "我们安全回来了，芭别尔主母。",
            "nextDialogs": [
              "732200802"
            ]
          },
          "732200802": {
            "id": "732200802",
            "speakerId": 4296,
            "speakerName": "婕德",
            "text": "我们探明了「永恒绿洲」的秘密，为部族打开了通道。",
            "nextDialogs": [
              "732200803"
            ]
          },
          "732200803": {
            "id": "732200803",
            "speakerId": 4296,
            "speakerName": "婕德",
            "text": "感谢您给我这次机会，让我得以完成父母的夙愿…即使他们并不受塔尼特的祜佑。",
            "nextDialogs": [
              "732200804"
            ]
          },
          "732200804": {
            "id": "732200804",
            "speakerId": 4291,
            "speakerName": "芭别尔",
            "text": "请不要这么说，孩子。你的夙愿，我一直记在心里。满足孩子们的愿望，也是我作为主母的职责。",
            "nextDialogs": [
              "732200805"
            ]
          },
          "732200805": {
            "id": "732200805",
            "speakerId": 4296,
            "speakerName": "婕德",
            "text": "谢谢…",
            "nextDialogs": [
              "732200806"
            ]
          },
          "732200806": {
            "id": "732200806",
            "speakerId": 4291,
            "speakerName": "芭别尔",
            "text": "很好，婕德。那么，阿萨里格的事情…",
            "nextDialogs": [
              "732200807"
            ]
          },
          "732200807": {
            "id": "732200807",
            "speakerId": 4296,
            "speakerName": "婕德",
            "text": "您的判断是正确的…他是叛徒无疑。",
            "nextDialogs": [
              "732200808"
            ]
          },
          "732200808": {
            "id": "732200808",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "欸，所以你们早就知道阿萨里格会反水了吗…？",
            "nextDialogs": [
              "732200809"
            ]
          },
          "732200809": {
            "id": "732200809",
            "speakerId": 4296,
            "speakerName": "婕德",
            "text": "不，之前还只是怀疑而已，一路上我都在监视着他…但我没想到阿萨里格会这么快摊牌。",
            "nextDialogs": [
              "732200810"
            ]
          },
          "732200810": {
            "id": "732200810",
            "speakerId": 4296,
            "speakerName": "婕德",
            "text": "芭别尔主母警告过我，但我那时宁愿选择相信他。",
            "nextDialogs": [
              "732200811"
            ]
          },
          "732200811": {
            "id": "732200811",
            "speakerId": 4296,
            "speakerName": "婕德",
            "text": "请看，这里是有关他与愚人众勾结的证据。",
            "nextDialogs": [
              "732200812"
            ]
          },
          "732200812": {
            "id": "732200812",
            "speakerId": 1003,
            "speakerName": "Black Screen",
            "text": "婕德将阿德菲的信件交给了芭别尔主母。",
            "nextDialogs": [
              "732200813"
            ]
          },
          "732200813": {
            "id": "732200813",
            "speakerId": 4291,
            "speakerName": "芭别尔",
            "text": "……",
            "nextDialogs": [
              "732200814"
            ]
          },
          "732200814": {
            "id": "732200814",
            "speakerId": 4296,
            "speakerName": "婕德",
            "text": "请不要悲伤，芭别尔主母…",
            "nextDialogs": [
              "732200815"
            ]
          },
          "732200815": {
            "id": "732200815",
            "speakerId": 4291,
            "speakerName": "芭别尔",
            "text": "嗯…我早就察觉到他怀有异心，只可惜没能亲手处决他…我曾经那么看重他。",
            "nextDialogs": [
              "732200816"
            ]
          },
          "732200816": {
            "id": "732200816",
            "speakerId": 4291,
            "speakerName": "芭别尔",
            "text": "但现在，部族的环境愈发凶险…我失去了两个曾精心培养的人物，以后部族的大事小情，就要多多要你承担了。",
            "nextDialogs": [
              "732200817"
            ]
          },
          "732200817": {
            "id": "732200817",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "欸…所以说，婕德是晋升了呀？恭喜你啦，婕德！",
            "nextDialogs": [
              "732200818"
            ]
          },
          "732200818": {
            "id": "732200818",
            "speakerId": 4291,
            "speakerName": "芭别尔",
            "text": "晋升？哈哈…这个词在沙漠里可不多见。",
            "nextDialogs": [
              "732200819"
            ]
          },
          "732200819": {
            "id": "732200819",
            "speakerId": 4291,
            "speakerName": "芭别尔",
            "text": "在我们沙漠人眼中可没有什么官僚层级。只是谁负责的事情更多了，谁就更有可能在未来掌握更多权力。",
            "nextDialogs": [
              "732200820"
            ]
          },
          "732200820": {
            "id": "732200820",
            "speakerId": 4291,
            "speakerName": "芭别尔",
            "text": "婕德…塔尼特的未来在你身上，请不要辜负族人们的希望。",
            "nextDialogs": [
              "732200821"
            ]
          },
          "732200821": {
            "id": "732200821",
            "speakerId": 4296,
            "speakerName": "婕德",
            "text": "族人…所以，您也承认我是塔尼特真正的族人了吗？",
            "nextDialogs": [
              "732200822"
            ]
          },
          "732200822": {
            "id": "732200822",
            "speakerId": 4291,
            "speakerName": "芭别尔",
            "text": "别犯傻，我一直这样认为。不论之前发生过什么，你是塔尼特的女儿，你的身上永远流着与我们相同的血。",
            "nextDialogs": [
              "732200823"
            ]
          },
          "732200823": {
            "id": "732200823",
            "speakerId": 4296,
            "speakerName": "婕德",
            "text": "嗯…谢谢。",
            "nextDialogs": [
              "732200824"
            ]
          },
          "732200824": {
            "id": "732200824",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "唔，总觉得有什么不太对劲的东西没有提到呢…",
            "nextDialogs": [
              "732200825"
            ]
          },
          "732200825": {
            "id": "732200825",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "#{NICKNAME}，我们之前遇到过什么可疑的东西来着？",
            "nextDialogs": [
              "732200827",
              "732200846"
            ]
          },
          "732200827": {
            "id": "732200827",
            "speakerId": 20846,
            "speakerName": "利露帕尔",
            "text": "你曾往绿洲派出过其他族人，并且任由他们死在了那里，然后以「禁忌」的借口禁止后来人进入，对吧？",
            "nextDialogs": [
              "732200828"
            ]
          },
          "732200828": {
            "id": "732200828",
            "speakerId": 20846,
            "speakerName": "利露帕尔",
            "text": "但你却鼓励我们深入险地，对这些东西只字不提，这是怎么回事？",
            "nextDialogs": [
              "732200829"
            ]
          },
          "732200829": {
            "id": "732200829",
            "speakerId": 4296,
            "speakerName": "婕德",
            "text": "……",
            "nextDialogs": [
              "732200830"
            ]
          },
          "732200830": {
            "id": "732200830",
            "speakerId": 4291,
            "speakerName": "芭别尔",
            "text": "……",
            "nextDialogs": [
              "732200831"
            ]
          },
          "732200831": {
            "id": "732200831",
            "speakerId": 4291,
            "speakerName": "芭别尔",
            "text": "尊敬的利露帕尔，此前的种种不便与误会，请容我向您致歉。",
            "nextDialogs": [
              "732200832"
            ]
          },
          "732200832": {
            "id": "732200832",
            "speakerId": 4291,
            "speakerName": "芭别尔",
            "text": "但塔尼特部族的确并非最近才开始探索居尔城的遗迹，以及「永恒绿洲」之所在…我此前已经派出过许多族人前往。",
            "nextDialogs": [
              "732200833"
            ]
          },
          "732200833": {
            "id": "732200833",
            "speakerId": 4291,
            "speakerName": "芭别尔",
            "text": "今人之所以能够确定这几处地点的位置与地形情况，也是多亏了他们的探险…",
            "nextDialogs": [
              "732200834"
            ]
          },
          "732200834": {
            "id": "732200834",
            "speakerId": 4291,
            "speakerName": "芭别尔",
            "text": "只是由于风险巨大，人员往往十不存一，而考察结果寥寥…",
            "nextDialogs": [
              "732200835"
            ]
          },
          "732200835": {
            "id": "732200835",
            "speakerId": 4291,
            "speakerName": "芭别尔",
            "text": "我才要求停止这种行动，将这些地方划为部族的禁忌区域。",
            "nextDialogs": [
              "732200836"
            ]
          },
          "732200836": {
            "id": "732200836",
            "speakerId": 4291,
            "speakerName": "芭别尔",
            "text": "阿萨里格那个叛徒…也曾经带队考察过那些峡谷与遗迹，我以为我能信任他给你们开路…但却没想到他…",
            "nextDialogs": [
              "732200837"
            ]
          },
          "732200837": {
            "id": "732200837",
            "speakerId": 4296,
            "speakerName": "婕德",
            "text": "但你没跟我们说过这些。",
            "nextDialogs": [
              "732200838"
            ]
          },
          "732200838": {
            "id": "732200838",
            "speakerId": 4291,
            "speakerName": "芭别尔",
            "text": "因为我从一开始就知道，你们会安然无恙地回来。你是我所信托的后辈，婕德。",
            "nextDialogs": [
              "732200839"
            ]
          },
          "732200839": {
            "id": "732200839",
            "speakerId": 4291,
            "speakerName": "芭别尔",
            "text": "你的勇敢无畏，你的凶猛和机智，你对待族人和朋友的真诚和温柔，我都看在眼里。",
            "nextDialogs": [
              "732200840"
            ]
          },
          "732200840": {
            "id": "732200840",
            "speakerId": 4291,
            "speakerName": "芭别尔",
            "text": "如果我的女儿未曾被沙漠带走，我想她一定也会长成你的样子。任何危险都打不倒她，任何沙暴都无法吞没她…",
            "nextDialogs": [
              "732200841"
            ]
          },
          "732200841": {
            "id": "732200841",
            "speakerId": 4291,
            "speakerName": "芭别尔",
            "text": "所以，我也这样相信着你，一直在默默为你祈祷。",
            "nextDialogs": [
              "732200842"
            ]
          },
          "732200842": {
            "id": "732200842",
            "speakerId": 4296,
            "speakerName": "婕德",
            "text": "……",
            "nextDialogs": [
              "732200843"
            ]
          },
          "732200843": {
            "id": "732200843",
            "speakerId": 4296,
            "speakerName": "婕德",
            "text": "…抱歉，芭别尔主母，是我顶撞您了。",
            "nextDialogs": [
              "732200844"
            ]
          },
          "732200844": {
            "id": "732200844",
            "speakerId": 4291,
            "speakerName": "芭别尔",
            "text": "不，引起了你们的误解和疑虑，应该是我要请求你们的原谅才对。",
            "nextDialogs": [
              "732200864"
            ]
          },
          "732200864": {
            "id": "732200864",
            "speakerId": 20846,
            "speakerName": "利露帕尔",
            "text": "……",
            "nextDialogs": [
              "732200865"
            ]
          },
          "732200865": {
            "id": "732200865",
            "speakerId": 20846,
            "speakerName": "利露帕尔",
            "text": "抱歉，我的大人，是我多虑了。",
            "nextDialogs": [
              "732200866"
            ]
          },
          "732200866": {
            "id": "732200866",
            "speakerId": 4291,
            "speakerName": "芭别尔",
            "text": "#那么，很高兴大家都能解开误会。{NICKNAME}，作为贵客，塔尼特部族永远欢迎你们。",
            "nextDialogs": [
              "732200867"
            ]
          },
          "732200867": {
            "id": "732200867",
            "speakerId": 4291,
            "speakerName": "芭别尔",
            "text": "尊贵的「镇灵主人」，无论您提出什么样的要求，请尽管与我相谈，我将尽全力满足。",
            "nextDialogs": [
              "732200868"
            ]
          },
          "732200868": {
            "id": "732200868",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "任何要求吗？",
            "nextDialogs": [
              "732200869"
            ]
          },
          "732200869": {
            "id": "732200869",
            "speakerId": 4291,
            "speakerName": "芭别尔",
            "text": "任何要求。"
          },
          "732200846": {
            "id": "732200846",
            "speakerId": 20846,
            "speakerName": "利露帕尔",
            "text": "阿萨里格和阿德菲的信里提及，他们反叛的原因是你将婕德这个「叛徒的女儿」当做掌中宝和继承人…",
            "nextDialogs": [
              "732200847"
            ]
          },
          "732200847": {
            "id": "732200847",
            "speakerId": 4296,
            "speakerName": "婕德",
            "text": "……",
            "nextDialogs": [
              "732200848"
            ]
          },
          "732200848": {
            "id": "732200848",
            "speakerId": 20846,
            "speakerName": "利露帕尔",
            "text": "另外，你也在部族中刻意清理「外人」的党羽，即使之前你曾依赖他们和「北方人」交流？",
            "nextDialogs": [
              "732200849"
            ]
          },
          "732200849": {
            "id": "732200849",
            "speakerId": 20846,
            "speakerName": "利露帕尔",
            "text": "我听不懂你们的黑话，但方才这些话是什么意思…我很好奇呢。",
            "nextDialogs": [
              "732200850"
            ]
          },
          "732200850": {
            "id": "732200850",
            "speakerId": 4291,
            "speakerName": "芭别尔",
            "text": "……",
            "nextDialogs": [
              "732200851"
            ]
          },
          "732200851": {
            "id": "732200851",
            "speakerId": 4291,
            "speakerName": "芭别尔",
            "text": "尊敬的利露帕尔，此前的种种不便与误会，请容我向您致歉。",
            "nextDialogs": [
              "732200852"
            ]
          },
          "732200852": {
            "id": "732200852",
            "speakerId": 4291,
            "speakerName": "芭别尔",
            "text": "但塔尼特部族的经营与生存，必须依赖多方贸易才能维持。这之中就包括那些来自北方的家伙。",
            "nextDialogs": [
              "732200853"
            ]
          },
          "732200853": {
            "id": "732200853",
            "speakerId": 4291,
            "speakerName": "芭别尔",
            "text": "纵我忙于处理部落事务的方方面面，也难以料定他们居心叵测…",
            "nextDialogs": [
              "732200854"
            ]
          },
          "732200854": {
            "id": "732200854",
            "speakerId": 4291,
            "speakerName": "芭别尔",
            "text": "但后来，我逐渐发现他们带来的风险多于益处…也就只能先从内部下手清理叛徒了。",
            "nextDialogs": [
              "732200855"
            ]
          },
          "732200855": {
            "id": "732200855",
            "speakerId": 4291,
            "speakerName": "芭别尔",
            "text": "这也正是我需要婕德的原因，她总能够坚定迅速地为部族排除叛徒，我欣赏她的忠诚和能力。",
            "nextDialogs": [
              "732200856"
            ]
          },
          "732200856": {
            "id": "732200856",
            "speakerId": 4296,
            "speakerName": "婕德",
            "text": "但你没跟我们说过这些。",
            "nextDialogs": [
              "732200857"
            ]
          },
          "732200857": {
            "id": "732200857",
            "speakerId": 4291,
            "speakerName": "芭别尔",
            "text": "因为我从一开始就知道，你们会安然无恙地回来。你是我所信托的后辈，婕德。",
            "nextDialogs": [
              "732200858"
            ]
          },
          "732200858": {
            "id": "732200858",
            "speakerId": 4291,
            "speakerName": "芭别尔",
            "text": "你的勇敢无畏，你的凶猛和机智，你对待族人和朋友的真诚和温柔，我都看在眼里。",
            "nextDialogs": [
              "732200859"
            ]
          },
          "732200859": {
            "id": "732200859",
            "speakerId": 4291,
            "speakerName": "芭别尔",
            "text": "如果我的女儿未曾被沙漠带走，我想她一定也会长成你的样子。任何危险都打不倒她，任何沙暴都无法吞没她…",
            "nextDialogs": [
              "732200860"
            ]
          },
          "732200860": {
            "id": "732200860",
            "speakerId": 4291,
            "speakerName": "芭别尔",
            "text": "所以，我也这样相信着你，一直在默默为你祈祷。",
            "nextDialogs": [

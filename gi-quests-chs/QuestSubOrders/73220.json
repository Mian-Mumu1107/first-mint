            "speakerId": 4296,
            "speakerName": "婕德",
            "text": "…抱歉，芭别尔主母，是我顶撞您了。",
            "nextDialogs": [
              "732200863"
            ]
          },
          "732200863": {
            "id": "732200863",
            "speakerId": 4291,
            "speakerName": "芭别尔",
            "text": "不，引起了你们的误解和疑虑，应该是我要请求你们的原谅才对。"
          }
        }
      }

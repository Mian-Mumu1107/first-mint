      "dialogue": {
        "startDialogs": [
          "200671401"
        ],
        "dialogs": {
          "200671401": {
            "id": "200671401",
            "speakerId": 1405,
            "speakerName": "安娜",
            "text": "你操纵风之翼的手法可真是太厉害了，怪不得安柏小姐要我来请教你呢。",
            "nextDialogs": [
              "200671402"
            ]
          },
          "200671402": {
            "id": "200671402",
            "speakerId": 1405,
            "speakerName": "安娜",
            "text": "嘿嘿，有你给我辅导，我肯定能通过飞行执照的考试。",
            "nextDialogs": [
              "200671403"
            ]
          },
          "200671403": {
            "id": "200671403",
            "speakerId": 1405,
            "speakerName": "安娜",
            "text": "谢谢你啦，这些东西请你收下，我先回去复习了。",
            "nextDialogs": [
              "200671404"
            ]
          },
          "200671404": {
            "id": "200671404",
            "speakerId": 1405,
            "speakerName": "安娜",
            "text": "唔…我的风之翼用什么颜色比较好呢…",
            "nextDialogs": [
              "200671405"
            ]
          },
          "200671405": {
            "id": "200671405",
            "speakerId": 1405,
            "speakerName": "安娜",
            "text": "蓝色？绿色？不然都要一点好了…"
          }
        }
      }
    },
    {

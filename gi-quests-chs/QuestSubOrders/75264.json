    {
      "subId": "7526404",
      "subQuestName": "(test)隐藏$HIDDEN",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "752640401"
        ],
        "dialogs": {
          "752640401": {
            "id": "752640401",
            "speakerId": 1000,
            "speakerName": "扎卡",
            "text": "你们抓错人了…你们看，我师傅叫卡内，我叫扎卡…你们应该去抓他才对…",
            "nextDialogs": [
              "752640402"
            ]
          },
          "752640402": {
            "id": "752640402",
            "speakerId": 1000,
            "speakerName": "扎卡",
            "text": "我根本做不出我师傅那种等级的玩偶…",
            "nextDialogs": [
              "752640403"
            ]
          },
          "752640403": {
            "id": "752640403",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "你是被人抓来的？",
            "nextDialogs": [
              "752640404"
            ]
          },
          "752640404": {
            "id": "752640404",
            "speakerId": 1000,
            "speakerName": "扎卡",
            "text": "欸？你们和他们不是一伙的？",
            "nextDialogs": [
              "752640405"
            ]
          },
          "752640405": {
            "id": "752640405",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "当然不是，你没看见吗？我们把他们都打跑啦！",
            "nextDialogs": [
              "752640406"
            ]
          },
          "752640406": {
            "id": "752640406",
            "speakerId": 1000,
            "speakerName": "扎卡",
            "text": "原来是这样？太好了！我终于自由了吗？",
            "nextDialogs": [
              "752640407"
            ]
          },
          "752640407": {
            "id": "752640407",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "当然，你可以回家咯。不过…这里到底是怎么回事啊？",
            "nextDialogs": [
              "752640408"
            ]
          },
          "752640408": {
            "id": "752640408",
            "speakerId": 1000,
            "speakerName": "扎卡",
            "text": "这帮家伙不知道是哪里的，跑来伪造度假村的玩偶。但是他们的水平很差，所以密谋把我的师傅卡内抓来当顾问。",
            "nextDialogs": [
              "752640409"
            ]
          },
          "752640409": {
            "id": "752640409",
            "speakerId": 1000,
            "speakerName": "扎卡",
            "text": "但是不知道哪里出了问题，居然把我抓了过来…老天，我才跟师傅学了三天颜料的手艺…根本达不到要求…",
            "nextDialogs": [
              "752640410"
            ]
          },
          "752640410": {
            "id": "752640410",
            "speakerId": 1000,
            "speakerName": "扎卡",
            "text": "不管怎么说，太感谢你们了！",
            "nextDialogs": [
              "752640411"
            ]
          },
          "752640411": {
            "id": "752640411",
            "speakerId": 1000,
            "speakerName": "扎卡",
            "text": "阿扎卡，我们回家！",
            "nextDialogs": [
              "752640412"
            ]
          },
          "752640412": {
            "id": "752640412",
            "speakerId": 1002,
            "speakerName": "阿扎卡",
            "text": "~~~！"
          }
        }
      }
    }
  ]

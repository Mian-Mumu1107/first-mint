    {
      "subId": "2074103",
      "subQuestName": "把蒲公英籽交给葛瑞丝",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "207411001"
        ],
        "dialogs": {
          "207411001": {
            "id": "207411001",
            "speakerId": 1429,
            "speakerName": "葛瑞丝",
            "text": "您搜集到蒲公英了吗？",
            "nextDialogs": [
              "207411002"
            ]
          },
          "207411002": {
            "id": "207411002",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "搜集到了。",
            "nextDialogs": [
              "207411003"
            ]
          },
          "207411003": {
            "id": "207411003",
            "speakerId": 1429,
            "speakerName": "葛瑞丝",
            "text": "这些就足够了，请您在这里稍等一下…",
            "nextDialogs": [
              "207411004"
            ]
          },
          "207411004": {
            "id": "207411004",
            "speakerId": 1429,
            "speakerName": "葛瑞丝",
            "text": "…巴巴托斯大人，请您聆听我…",
            "nextDialogs": [
              "207411005"
            ]
          },
          "207411005": {
            "id": "207411005",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "呜哇…她好虔诚啊，说了好多话。",
            "nextDialogs": [
              "207411006"
            ]
          },
          "207411006": {
            "id": "207411006",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "…也不知道那个「卖唱的」能不能听到…",
            "nextDialogs": [
              "207411007"
            ]
          },
          "207411007": {
            "id": "207411007",
            "speakerId": 1429,
            "speakerName": "葛瑞丝",
            "text": "好了，这些蒲公英籽交给您，请您帮我上去播撒一下吧。",
            "nextDialogs": [
              "207411008"
            ]
          },
          "207411008": {
            "id": "207411008",
            "speakerId": 1429,
            "speakerName": "葛瑞丝",
            "text": "其实是应该我自己去的，但是…以我的身手，就算能爬上去，应该也难得下来了…",
            "nextDialogs": [
              "207411009"
            ]
          },
          "207411009": {
            "id": "207411009",
            "speakerId": 1429,
            "speakerName": "葛瑞丝",
            "text": "所以，就拜托您了。"
          }
        }
      }
    },
    {
      "subId": "2074104",
      "subQuestName": "在风神像手上播撒蒲公英",
      "sceneId": null,
      "locations": [],

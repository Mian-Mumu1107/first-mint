      }
    },
    {
      "subId": "2074105",
      "subQuestName": "与葛瑞丝对话",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "207412001"
        ],
        "dialogs": {
          "207412001": {
            "id": "207412001",
            "speakerId": 1429,
            "speakerName": "葛瑞丝",
            "text": "您把蒲公英播撒出去了吗？",
            "nextDialogs": [
              "207412005",
              "207412004"
            ]
          },
          "207412005": {
            "id": "207412005",
            "speakerId": 1429,
            "speakerName": "葛瑞丝",
            "text": "无论如何，希望巴巴托斯大人能够听到我的声音。",
            "nextDialogs": [
              "207412006"
            ]
          },
          "207412006": {
            "id": "207412006",
            "speakerId": 1429,
            "speakerName": "葛瑞丝",
            "text": "谢谢您愿意帮忙，这是谢礼，请收下吧。愿风神护佑您。"
          },
          "207412004": {
            "id": "207412004",
            "speakerId": 1429,
            "speakerName": "葛瑞丝",
            "text": "那样就太好了，巴巴托斯大人也会更容易注意到。"
          }
        }
      }
    },
    {
      "subId": "2074190",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [

    {
      "subId": "7417899",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "741789906"
        ],
        "dialogs": {
          "741789906": {
            "id": "741789906",
            "speakerId": 1012,
            "speakerName": "鲁热",
            "text": "时间差不多了，我们走吧，去南边的盗宝团据点。",
            "nextDialogs": [
              "741789908"
            ]
          },
          "741789908": {
            "id": "741789908",
            "speakerId": 1012,
            "speakerName": "鲁热",
            "text": "又见面了！之前说要送些骨折挫伤给我们？谢谢，不过还是你们自己留着受用吧！",
            "nextDialogs": [
              "741789909"
            ]
          },
          "741789909": {
            "id": "741789909",
            "speakerId": 21275,
            "speakerName": "金格尔",
            "text": "你这满嘴谎话的骗子，根本没想放过我们！",
            "nextDialogs": [
              "741789910"
            ]
          },

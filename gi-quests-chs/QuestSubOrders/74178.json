    },
    {
      "subId": "7417804",
      "subQuestName": "寻找盗宝团与红发青年$HIDDEN",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "741780401"
        ],
        "dialogs": {
          "741780401": {
            "id": "741780401",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "看到他们了！我们先躲起来观察一下情况吧。",
            "nextDialogs": [
              "741780402"
            ]
          },
          "741780402": {
            "id": "741780402",
            "speakerId": 21273,
            "speakerName": "看似懦弱的红发青年",
            "text": "…这些就是约定好的货品了，虽然不多，但是应该足够帮助你们度过这段困难的时间了吧？",
            "nextDialogs": [
              "741780403"
            ]
          },
          "741780403": {
            "id": "741780403",
            "speakerId": 21275,
            "speakerName": "金格尔",
            "text": "我点点货…哈，确实不多不少，正好是你说的数。",
            "nextDialogs": [
              "741780404"
            ]
          },
          "741780404": {
            "id": "741780404",
            "speakerId": 21276,
            "speakerName": "哈维沙姆",
            "text": "你是个爽快人，我们就喜欢爽快人。",
            "nextDialogs": [
              "741780405"
            ]
          },
          "741780405": {
            "id": "741780405",
            "speakerId": 21275,
            "speakerName": "金格尔",
            "text": "既然你出手这么爽快，那我们再多取一点也没问题吧？",
            "nextDialogs": [
              "741780406"
            ]
          },
          "741780406": {
            "id": "741780406",
            "speakerId": 21276,
            "speakerName": "哈维沙姆",
            "text": "毕竟你的钱财太多，你不珍惜，不如交给我们。",
            "nextDialogs": [
              "741780407"
            ]
          },
          "741780407": {
            "id": "741780407",
            "speakerId": 21273,
            "speakerName": "看似懦弱的红发青年",
            "text": "…唉。原本以为能听到什么新鲜说辞，结果还是老一套啊。",
            "nextDialogs": [
              "741780408"
            ]
          },
          "741780408": {
            "id": "741780408",
            "speakerId": 21276,
            "speakerName": "哈维沙姆",
            "text": "老一套有用，为什么不用老一套？",
            "nextDialogs": [
              "741780409"
            ]
          },
          "741780409": {
            "id": "741780409",
            "speakerId": 21275,
            "speakerName": "金格尔",
            "text": "得让你吃点苦头，我正想学学，求饶有什么新鲜说辞可用。看招！",
            "nextDialogs": [
              "741780410"
            ]
          },
          "741780410": {
            "id": "741780410",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "#（{NICKNAME}，怎么办？我们要去救他吗？）",
            "nextDialogs": [
              "741780411"
            ]
          },
          "741780411": {
            "id": "741780411",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "（再看看情况吧。）",
            "nextDialogs": [
              "741780412"
            ]
          },
          "741780412": {
            "id": "741780412",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "（欸？可是…唔，那就听你的。）",
            "nextDialogs": [
              "741780413"
            ]
          },
          "741780413": {
            "id": "741780413",
            "speakerId": 1006,
            "speakerName": "Black Screen",
            "text": "红发青年吹了一声口哨，从树林的隐蔽处跃出两个青年…",
            "nextDialogs": [
              "741780414"
            ]
          },
          "741780414": {
            "id": "741780414",
            "speakerId": 21274,
            "speakerName": "红发青年",
            "text": "求饶的新鲜说辞我们是一句也没有。不过倒是有不少老套办法让你们把之前打劫无辜路人夺得的钱财吐出来。",
            "nextDialogs": [
              "741780415"
            ]
          },
          "741780415": {
            "id": "741780415",
            "speakerId": 1008,
            "speakerName": "金发青年",
            "text": "大哥的意思是，这是最后的机会，你们现在照做的话，我们就不用继续把老套戏码演完啦。",
            "nextDialogs": [
              "741780416"
            ]
          },
          "741780416": {
            "id": "741780416",
            "speakerId": 1009,
            "speakerName": "棕发青年",
            "text": "想吃苦头的话，我随时奉陪。",
            "nextDialogs": [
              "741780417"
            ]
          },
          "741780417": {
            "id": "741780417",
            "speakerId": 21275,
            "speakerName": "金格尔",
            "text": "啊？你们又是哪里冒出来的？还有你…你什么时候换了身衣服？！",
            "nextDialogs": [
              "741780418"
            ]
          },
          "741780418": {
            "id": "741780418",
            "speakerId": 21276,
            "speakerName": "哈维沙姆",
            "text": "不过是马戏团的小丑，要吃苦头的是你们才对。"
          }
        }
      }
    },
    {
      "subId": "7417805",
      "subQuestName": "帮助红发青年，或静观事态发展",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [],
        "dialogs": {}
      }
    },
    {
      "subId": "7417806",
      "subQuestName": "与红发青年对话",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "741780601"
        ],
        "dialogs": {
          "741780601": {
            "id": "741780601",
            "speakerId": 21275,
            "speakerName": "金格尔",
            "text": "你们以多胜少！",
            "nextDialogs": [
              "741780602"
            ]
          },
          "741780602": {
            "id": "741780602",
            "speakerId": 21276,
            "speakerName": "哈维沙姆",
            "text": "你们卑鄙！",
            "nextDialogs": [
              "741780603"
            ]
          },
          "741780603": {
            "id": "741780603",
            "speakerId": 5232,
            "speakerName": "布勒",
            "text": "大哥，拿他们怎么办？",
            "nextDialogs": [
              "741780604"
            ]
          },
          "741780604": {
            "id": "741780604",
            "speakerId": 21274,
            "speakerName": "红发青年",
            "text": "不如问问那边的朋友吧。",
            "nextDialogs": [
              "741780605"
            ]
          },
          "741780605": {
            "id": "741780605",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "你们也是打劫的？",
            "nextDialogs": [
              "741780606"
            ]
          },
          "741780606": {
            "id": "741780606",
            "speakerId": 21274,
            "speakerName": "红发青年",
            "text": "哈哈，该怎么说呢，是也不是。",
            "nextDialogs": [
              "741780607"
            ]
          },
          "741780607": {
            "id": "741780607",
            "speakerId": 5233,
            "speakerName": "布朗什",
            "text": "毕竟我们只打劫坏人，就像这两个家伙这么坏的人。",
            "nextDialogs": [
              "741780608"
            ]
          },
          "741780608": {
            "id": "741780608",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "#我都糊涂了…他们两个之前拦住我和{NICKNAME}想要打劫，所以肯定是坏人！",
            "nextDialogs": [
              "741780609"
            ]
          },
          "741780609": {
            "id": "741780609",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "红头发的说会白送两个坏人值钱的货物，然后把坏人骗到这里来，结果居然有红头发的同伙在这里埋伏！",
            "nextDialogs": [
              "741780610"
            ]
          },
          "741780610": {
            "id": "741780610",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "所以红头发的和他的同伙应该是…",
            "nextDialogs": [
              "741780612",
              "741780616"
            ]
          },
          "741780612": {
            "id": "741780612",
            "speakerId": 21275,
            "speakerName": "金格尔",
            "text": "原来是执律庭的走狗…呸！",
            "nextDialogs": [
              "741780613"
            ]
          },
          "741780613": {
            "id": "741780613",
            "speakerId": 21274,
            "speakerName": "红发青年",
            "text": "很遗憾，我现在不是。我不认同执律庭追求正义的手段…但他们的目标毕竟还是正义。",
            "nextDialogs": [
              "741780614"
            ]
          },
          "741780614": {
            "id": "741780614",
            "speakerId": 21274,
            "speakerName": "红发青年",
            "text": "又怎么是你们这样恃强凌弱、满口谎言的家伙能够相比的…",
            "nextDialogs": [
              "741780617"
            ]
          },
          "741780617": {
            "id": "741780617",
            "speakerId": 21274,
            "speakerName": "红发青年",
            "text": "总之，我们只是些小人物，但是小人物也可以有自己坚持的正义。所以对于眼前的恶行，我们是不能放过的。",
            "nextDialogs": [
              "741780618"
            ]
          },
          "741780618": {
            "id": "741780618",
            "speakerId": 21274,
            "speakerName": "红发青年",
            "text": "且不论他们此前已经在这里行过恶事，刚才他们嘴上说要放过你们，心里可不是这么想的。",
            "nextDialogs": [
              "741780619"
            ]
          },
          "741780619": {
            "id": "741780619",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "他们心里怎么想，你怎么知道？",
            "nextDialogs": [
              "741780620"
            ]
          },
          "741780620": {
            "id": "741780620",
            "speakerId": 21274,
            "speakerName": "红发青年",
            "text": "要听明白别人真正想说的，不能用耳朵听，要用脑袋听。",
            "nextDialogs": [
              "741780621"
            ]
          },
          "741780621": {
            "id": "741780621",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "（说起来之前听佩妮说过…）",
            "nextDialogs": [
              "741780622"
            ]
          },
          "741780622": {
            "id": "741780622",
            "speakerId": 1006,
            "speakerName": "Black Screen",
            "text": "深呼吸数次之后，尝试清空多余的思绪，直到脑海中一片澄明…",
            "nextDialogs": [
              "741780623"
            ]
          },
          "741780623": {
            "id": "741780623",
            "speakerId": 21274,
            "speakerName": "红发青年",
            "text": "你们回忆一下，他们当时是这样说的…",
            "nextDialogs": [
              "741780624"
            ]
          },
          "741780624": {
            "id": "741780624",
            "speakerId": 21274,
            "speakerName": "红发青年",
            "text": "「居然为了{RUBY#[D]真够白痴的}素不相识的人…真是金子{RUBY#[D]你的心要是真有金子那么值钱}一般的心啊，我真是{RUBY#[D]怎么说我也得给你剜出来}太感动了。」",
            "nextDialogs": [
              "741780625"
            ]
          },
          "741780625": {
            "id": "741780625",
            "speakerId": 21274,
            "speakerName": "红发青年",
            "text": "#「我们是{RUBY#[D]口头约定值几个子}信守承诺的人，今天就先放过带{RUBY#[D]先榨完这傻小子的钱财再回来干这一票}宠物散步的{M#小兄弟}{F#小妹妹}。」"
          },
          "741780616": {
            "id": "741780616",
            "speakerId": 21274,
            "speakerName": "红发青年",
            "text": "哈哈！要惩治恶人，必得比恶人心肠更硬。看来你已经懂得这个道理了。"
          }
        }
      }
    },

    {
      "subId": "7417810",
      "subQuestName": "与鲁热对话",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "741781001"
        ],
        "dialogs": {
          "741781001": {
            "id": "741781001",
            "speakerId": 1012,
            "speakerName": "鲁热",
            "text": "这里的货变多了，看来他们的手下之前也没闲着。不过这次，他们应该真的吃到教训了。",
            "nextDialogs": [
              "741781002"
            ]
          },
          "741781002": {
            "id": "741781002",
            "speakerId": 1012,
            "speakerName": "鲁热",
            "text": "对了，你也出了不少力，这些财货也应该分你一部分才是。",
            "nextDialogs": [
              "741781003"
            ]
          },
          "741781003": {
            "id": "741781003",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "感觉怪怪的，还是不要了。",
            "nextDialogs": [
              "741781004"
            ]
          },
          "741781004": {
            "id": "741781004",
            "speakerId": 1012,
            "speakerName": "鲁热",
            "text": "哈哈，好吧。那就谢谢你了，除了感谢，我也没有别的东西可以给你了。",
            "nextDialogs": [
              "741781005"
            ]
          },
          "741781005": {
            "id": "741781005",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "这些财货你准备怎么处理？",
            "nextDialogs": [
              "741781006"
            ]
          },
          "741781006": {
            "id": "741781006",
            "speakerId": 1012,
            "speakerName": "鲁热",
            "text": "嗯？当然是交给真正需要它们的人。",
            "nextDialogs": [
              "741781007"
            ]
          },
          "741781007": {
            "id": "741781007",
            "speakerId": 1012,
            "speakerName": "鲁热",
            "text": "哦！这场景看起来像是我要独吞财富，我的所作所为也和他们没什么两样。",
            "nextDialogs": [
              "741781008"
            ]
          },
          "741781008": {
            "id": "741781008",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "那、那你到底是怎么打算的？不如说，你到底是怎么想的？",
            "nextDialogs": [
              "741781009"
            ]
          },
          "741781009": {
            "id": "741781009",
            "speakerId": 1012,
            "speakerName": "鲁热",
            "text": "之前对哈维沙姆和金格尔所说的话也是出自我的真心，现在的你们应该能够听得出来吧。",
            "nextDialogs": [
              "741781010"
            ]
          },
          "741781010": {
            "id": "741781010",
            "speakerId": 1012,
            "speakerName": "鲁热",
            "text": "这个世界上充满了不均衡，过度的贫乏和过度的贪婪…",
            "nextDialogs": [
              "741781011"
            ]
          },
          "741781011": {
            "id": "741781011",
            "speakerId": 1012,
            "speakerName": "鲁热",
            "text": "有些人沉沦、困顿，仅仅只是因为他们遇到了仅靠自己的力量难以越过的困境，我想为这样的人提供一点帮助。",
            "nextDialogs": [
              "741781012"
            ]
          },
          "741781012": {
            "id": "741781012",
            "speakerId": 1012,
            "speakerName": "鲁热",
            "text": "可惜哈维沙姆和金格尔则是另一类，过度的贪婪，想要靠暴力从弱者身上攫取本不属于他们的东西。",
            "nextDialogs": [
              "741781013"
            ]
          },
          "741781013": {
            "id": "741781013",
            "speakerId": 1012,
            "speakerName": "鲁热",
            "text": "并且枫丹的律法尚未给与他们应得的惩罚，我无法原谅…不管你们怎么说，我会做我认为正确的事。",
            "nextDialogs": [
              "741781014"
            ]
          },
          "741781014": {
            "id": "741781014",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "你有你的理由。",
            "nextDialogs": [
              "741781015"
            ]
          },
          "741781015": {
            "id": "741781015",
            "speakerId": 1012,
            "speakerName": "鲁热",
            "text": "或许也可以被称作是自负，或者另一种形式的贪婪吧。",
            "nextDialogs": [
              "741781016"
            ]
          },
          "741781016": {
            "id": "741781016",
            "speakerId": 1012,
            "speakerName": "鲁热",
            "text": "所幸在这条道路上我并非独行，有志同道合的伙伴同我一道。即使我们只能为世界带来一些微小的改变…",
            "nextDialogs": [
              "741781017"
            ]
          },
          "741781017": {
            "id": "741781017",
            "speakerId": 1012,
            "speakerName": "鲁热",
            "text": "无论如何，这次就多谢了，后会有期！"
          }
        }
      }
    },

    {
      "subId": "7417802",
      "subQuestName": "与关在笼子里的人对话$HIDDEN",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "741780201"
        ],
        "dialogs": {
          "741780201": {
            "id": "741780201",
            "speakerId": 1000,
            "speakerName": "看似沉稳的盗宝团",
            "text": "#你好，{M#小兄弟}{F#小妹妹}。",
            "nextDialogs": [
              "741780202"
            ]
          },
          "741780202": {
            "id": "741780202",
            "speakerId": 1001,
            "speakerName": "看似凶狠的盗宝团",
            "text": "今天可真是糟糕的一天啊，你说对吧？",
            "nextDialogs": [
              "741780203"
            ]
          },
          "741780203": {
            "id": "741780203",
            "speakerId": 1000,
            "speakerName": "看似沉稳的盗宝团",
            "text": "你不走运，我们也倒霉。",
            "nextDialogs": [
              "741780204"
            ]
          },
          "741780204": {
            "id": "741780204",
            "speakerId": 1001,
            "speakerName": "看似凶狠的盗宝团",
            "text": "你带宠物散步，遇上我们。",
            "nextDialogs": [
              "741780205"
            ]
          },
          "741780205": {
            "id": "741780205",
            "speakerId": 1000,
            "speakerName": "看似沉稳的盗宝团",
            "text": "你不走运。",
            "nextDialogs": [
              "741780206"
            ]
          },
          "741780206": {
            "id": "741780206",
            "speakerId": 1001,
            "speakerName": "看似凶狠的盗宝团",
            "text": "我们本想差不多收工了，但遇上你，也只好打起精神再干一票。",
            "nextDialogs": [
              "741780207"
            ]
          },
          "741780207": {
            "id": "741780207",
            "speakerId": 1000,
            "speakerName": "看似沉稳的盗宝团",
            "text": "我们倒霉。",
            "nextDialogs": [
              "741780208"
            ]
          },
          "741780208": {
            "id": "741780208",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "派蒙，怎么办，我们被打劫了。",
            "nextDialogs": [
              "741780209"
            ]
          },
          "741780209": {
            "id": "741780209",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "难道不应该先反驳我不是什么需要带到户外散步的宠物吗！",
            "nextDialogs": [
              "741780210"
            ]
          },
          "741780210": {
            "id": "741780210",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "算了…这种时候就要表现得比对方更凶狠才行，看我的。",
            "nextDialogs": [
              "741780211"
            ]
          },
          "741780211": {
            "id": "741780211",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "#我们可是大名鼎鼎的{NICKNAME}和派蒙，你们这些不法之徒，要是不想吃不了兜着走，就赶紧退下吧！",
            "nextDialogs": [
              "741780212"
            ]
          },
          "741780212": {
            "id": "741780212",
            "speakerId": 1001,
            "speakerName": "看似凶狠的盗宝团",
            "text": "多稀罕哪，这么能说会道的宠物，要是我们抓了…",
            "nextDialogs": [
              "741780213"
            ]
          },
          "741780213": {
            "id": "741780213",
            "speakerId": 1000,
            "speakerName": "看似沉稳的盗宝团",
            "text": "肯定能卖个大价钱。",
            "nextDialogs": [
              "741780214"
            ]
          },
          "741780214": {
            "id": "741780214",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "欸——",
            "nextDialogs": [
              "741780215"
            ]
          },
          "741780215": {
            "id": "741780215",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "话不多说，这就开打吧。",
            "nextDialogs": [
              "741780216"
            ]
          },
          "741780216": {
            "id": "741780216",
            "speakerId": 21273,
            "speakerName": "看似懦弱的红发青年",
            "text": "请、请等一下！",
            "nextDialogs": [
              "741780217"
            ]
          },
          "741780217": {
            "id": "741780217",
            "speakerId": 21273,
            "speakerName": "看似懦弱的红发青年",
            "text": "哈维沙姆先生、金格尔先生，我们不是说好了吗？只要我交出手上这批货物，两位这段时间就不再为难来往的无辜行人和小动物…",
            "nextDialogs": [
              "741780218"
            ]
          },
          "741780218": {
            "id": "741780218",
            "speakerId": 21275,
            "speakerName": "金格尔",
            "text": "这么说来我们认识尚浅，还没给你讲过我们的经历。从前我们在枫丹廷当学徒，后来被赶走了，你知道为什么吗？",
            "nextDialogs": [
              "741780219"
            ]
          },
          "741780219": {
            "id": "741780219",
            "speakerId": 21276,
            "speakerName": "哈维沙姆",
            "text": "他们说，不够上进。",
            "nextDialogs": [
              "741780220"
            ]
          },
          "741780220": {
            "id": "741780220",
            "speakerId": 21275,
            "speakerName": "金格尔",
            "text": "对！可是不管怎么说，我们哥俩都是知错能改的人。既然上一份工作因为不够上进丢了，那对现在的工作就得十二分上进。",
            "nextDialogs": [
              "741780221"
            ]
          },
          "741780221": {
            "id": "741780221",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "我对打击恶势力也十五分有兴趣。",
            "nextDialogs": [
              "741780222"
            ]
          },
          "741780222": {
            "id": "741780222",
            "speakerId": 21275,
            "speakerName": "金格尔",
            "text": "#看不出来，{M#小兄弟}{F#小妹妹}个头不高，志气不小。看来今天是非打不可了，也好，让你见识一下我们哥俩的本领。",
            "nextDialogs": [
              "741780223"
            ]
          },
          "741780223": {
            "id": "741780223",
            "speakerId": 21276,
            "speakerName": "哈维沙姆",
            "text": "十八分厉害的本领。",
            "nextDialogs": [
              "741780224"
            ]
          },
          "741780224": {
            "id": "741780224",
            "speakerId": 21273,
            "speakerName": "看似懦弱的红发青年",
            "text": "停一停，请停一停。听我一句劝吧，几位，这样无谓的争斗对你们双方又有什么益处呢。",
            "nextDialogs": [
              "741780225"
            ]
          },
          "741780225": {
            "id": "741780225",
            "speakerId": 21273,
            "speakerName": "看似懦弱的红发青年",
            "text": "无论是两败俱伤，还是其中一方殒命，这样的结局都是我所不乐见的。",
            "nextDialogs": [
              "741780226"
            ]
          },
          "741780226": {
            "id": "741780226",
            "speakerId": 21273,
            "speakerName": "看似懦弱的红发青年",
            "text": "所幸我的钱财够多，虽然没有二十分那么多，但我愿意多付一份赎金，只求你们双方不要再纠缠。",
            "nextDialogs": [
              "741780227"
            ]
          },
          "741780227": {
            "id": "741780227",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "你…你没事吧？",
            "nextDialogs": [
              "741780228"
            ]
          },
          "741780228": {
            "id": "741780228",
            "speakerId": 21273,
            "speakerName": "看似懦弱的红发青年",
            "text": "啊，谢谢关心，除了暂时少了一些活动的余裕，其他一切都好。",
            "nextDialogs": [
              "741780229"
            ]
          },
          "741780229": {
            "id": "741780229",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "是他们把你关起来的对吧？为什么你不仅不向我们求救，还要再多向他们付一份赎金…",
            "nextDialogs": [
              "741780230"
            ]
          },
          "741780230": {
            "id": "741780230",
            "speakerId": 21273,
            "speakerName": "看似懦弱的红发青年",
            "text": "好心的朋友，生活中总有些困境是仅靠自己的力量难以克服的，我相信哈维沙姆先生和金格尔先生现在就在这样的困境中。",
            "nextDialogs": [
              "741780231"
            ]
          },
          "741780231": {
            "id": "741780231",
            "speakerId": 21273,
            "speakerName": "看似懦弱的红发青年",
            "text": "如果能用一点微不足道的钱财，拯救两个，或者甚至是四个人，还有比这更便宜的买卖吗？",
            "nextDialogs": [
              "741780232"
            ]
          },
          "741780232": {
            "id": "741780232",
            "speakerId": 21273,
            "speakerName": "看似懦弱的红发青年",
            "text": "至于我，不劳两位费心，我已与哈维沙姆先生和金格尔先生约定好。",
            "nextDialogs": [
              "741780233"
            ]
          },
          "741780233": {
            "id": "741780233",
            "speakerId": 21273,
            "speakerName": "看似懦弱的红发青年",
            "text": "我带他们取走一批货品，届时他们就会将我释放。而他们也便有了本金，可以换个营生，不用再与无辜行人和小动物为难。",
            "nextDialogs": [
              "741780234"
            ]
          },
          "741780234": {
            "id": "741780234",
            "speakerId": 21275,
            "speakerName": "金格尔",
            "text": "你的确是这么说的。",
            "nextDialogs": [
              "741780235"
            ]
          },
          "741780235": {
            "id": "741780235",
            "speakerId": 21276,
            "speakerName": "哈维沙姆",
            "text": "我们的确是这么听见的。",
            "nextDialogs": [
              "741780236"
            ]
          },
          "741780236": {
            "id": "741780236",
            "speakerId": 21275,
            "speakerName": "金格尔",
            "text": "居然为了素不相识的人…真是金子一般的心啊，我真是太感动了。",
            "nextDialogs": [
              "741780237"
            ]
          },
          "741780237": {
            "id": "741780237",
            "speakerId": 21276,
            "speakerName": "哈维沙姆",
            "text": "#我们是信守承诺的人，今天就先放过带宠物散步的{M#小兄弟}{F#小妹妹}。",
            "nextDialogs": [
              "741780238"
            ]
          },
          "741780238": {
            "id": "741780238",
            "speakerId": 21273,
            "speakerName": "看似懦弱的红发青年",
            "text": "#那太好了，{NICKNAME}{M#弟弟}{F#妹妹}和派蒙，你们可以回家了。",
            "nextDialogs": [
              "741780239"
            ]
          },
          "741780239": {
            "id": "741780239",
            "speakerId": 21273,
            "speakerName": "看似懦弱的红发青年",
            "text": "不用担心我，我这就带哈维沙姆先生和金格尔先生去取走要给他们的货物…很轻松的任务。",
            "nextDialogs": [
              "741780240"
            ]
          },
          "741780240": {
            "id": "741780240",
            "speakerId": 1006,
            "speakerName": "Black Screen",
            "text": "盗宝团将红发青年从笼子里解放出来，三人一道向东边去了…",
            "nextDialogs": [
              "741780241"
            ]
          },
          "741780241": {
            "id": "741780241",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "#他们居然就这样走了…{NICKNAME}，你说那两个盗宝团真的会放过那个人吗？我感觉他笨笨的…",
            "nextDialogs": [
              "741780243",
              "741780245"
            ]
          },
          "741780243": {
            "id": "741780243",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "可能他是那种连蚂蚁都不忍心伤害的人吧！真的有这种人吗…",
            "nextDialogs": [
              "741780246"
            ]
          },
          "741780246": {
            "id": "741780246",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "好在意到底是怎么回事！他们刚才往东边去了…不如我们跟上去看看吧？"
          },
          "741780245": {
            "id": "741780245",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "啊！你是说他们三个其实是一伙的吗？可是现在他们三个都走了欸，如果只是为了骗我们…"
          }
        }
      }
    },
    {
      "subId": "7417803",
      "subQuestName": "寻找盗宝团与红发青年",
      "sceneId": null,
      "locations": [],

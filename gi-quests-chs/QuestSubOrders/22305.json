  "subQuests": [
    {
      "subId": "2230501",
      "subQuestName": "与石头对话",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "223050101"
        ],
        "dialogs": {
          "223050101": {
            "id": "223050101",
            "speakerId": 2054,
            "speakerName": "石头",
            "text": "客官，哎，客官！您要不要来块石头，试试手气？",
            "nextDialogs": [
              "223050103",
              "223050105",
              "223050109"
            ]
          },
          "223050103": {
            "id": "223050103",
            "speakerId": 2054,
            "speakerName": "石头",
            "text": "好嘞！客官，我看您今天气色不错，看上去就要赚钱哪，哈哈哈。",
            "nextDialogs": [
              "223050116"
            ]
          },
          "223050116": {
            "id": "223050116",
            "speakerId": 2054,
            "speakerName": "石头",
            "text": "客官，您这边上眼！"
          },
          "223050105": {
            "id": "223050105",
            "speakerId": 2054,
            "speakerName": "石头",
            "text": "当然是我店里这些上好的璞石。",
            "nextDialogs": [
              "223050106"
            ]
          },
          "223050106": {
            "id": "223050106",
            "speakerId": 2054,
            "speakerName": "石头",
            "text": "只要开石后能出玉，我就付给您摩拉，当然，如果什么也没有，那自然也没有摩拉了。",
            "nextDialogs": [
              "223050107"
            ]
          },
          "223050107": {
            "id": "223050107",
            "speakerId": 2054,
            "speakerName": "石头",
            "text": "客官，您自己来一块石头玩玩，就什么都明白了！"
          },
          "223050109": {
            "id": "223050109",
            "speakerId": 2054,
            "speakerName": "石头",
            "text": "我们店里这些璞石，个个那都是从「层岩巨渊」里凿出来的顶尖货…",
            "nextDialogs": [
              "223050110"
            ]
          },
          "223050110": {
            "id": "223050110",
            "speakerId": 2054,
            "speakerName": "石头",
            "text": "嘿嘿，您别不信，我们「解翠行」做了好几辈的玉器生意。看石头的眼光，那是独一无二！",
            "nextDialogs": [
              "223050111"
            ]
          },
          "223050111": {
            "id": "223050111",
            "speakerId": 2054,
            "speakerName": "石头",
            "text": "嗨，不过这些风光都是原来，现在…总务司不是把「层岩巨渊」给封了吗？",
            "nextDialogs": [
              "223050112"
            ]
          },
          "223050112": {
            "id": "223050112",
            "speakerId": 2054,
            "speakerName": "石头",
            "text": "这原料地一封，卖一块石头少一块，这么一来二去，这些石头反而比做好的玉器更值钱了…",
            "nextDialogs": [
              "223050113"
            ]
          },
          "223050113": {
            "id": "223050113",
            "speakerId": 2054,
            "speakerName": "石头",
            "text": "我一想，那不如直接把店里的璞石拿来卖算了，不仅省了道工序，开石的时候，还有股刺激感，嘿嘿…",
            "nextDialogs": [
              "223050114"
            ]
          },
          "223050114": {
            "id": "223050114",
            "speakerId": 2054,
            "speakerName": "石头",
            "text": "客官，您来一块石头玩玩，自己体验体验吧。",
            "nextDialogs": [
              "223050115"
            ]
          },
          "223050115": {
            "id": "223050115",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "来一块试试。"
          }
        }
      }
    },
    {
      "subId": "2230502",
      "subQuestName": "和石头玩一把",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "223050201"
        ],
        "dialogs": {
          "223050201": {
            "id": "223050201",
            "speakerId": 2054,
            "speakerName": "石头",
            "text": "我们「解翠行」璞石众多，要是挨个挑，客官您的眼睛都得挑花了。",
            "nextDialogs": [
              "223050202"
            ]
          },
          "223050202": {
            "id": "223050202",
            "speakerId": 2054,
            "speakerName": "石头",
            "text": "我先粗略地看了一遍璞石，把璞石分好了，客官您看，来块什么价钱的璞石玩玩？"
          }
        }
      }
    },
    {
      "subId": "2230503",
      "subQuestName": "",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "223050301"
        ],
        "dialogs": {
          "223050301": {
            "id": "223050301",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "200摩拉。",
            "nextDialogs": [
              "223050302"
            ]
          },
          "223050302": {
            "id": "223050302",
            "speakerId": 2054,
            "speakerName": "石头",
            "text": "您这还挺谨慎的哈…也行，您看那边，选一块吧。",
            "nextDialogs": [
              "223050303"
            ]
          },
          "223050303": {
            "id": "223050303",
            "speakerId": 2054,
            "speakerName": "石头",
            "text": "您可看仔细了，200摩拉呢，好歹也是钱…",
            "nextDialogs": [
              "223050304"
            ]
          },
          "223050304": {
            "id": "223050304",
            "speakerId": 2054,
            "speakerName": "石头",
            "text": "看上哪一块您和我说，我来把璞石给开了。"
          }
        }
      }
    },
    {
      "subId": "2230504",
      "subQuestName": "",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "223050401"
        ],
        "dialogs": {
          "223050401": {
            "id": "223050401",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "400摩拉。",
            "nextDialogs": [
              "223050402"
            ]
          },
          "223050402": {
            "id": "223050402",
            "speakerId": 2054,
            "speakerName": "石头",
            "text": "看您就知道，您心里有数，这钱不多不少玩玩正好。",
            "nextDialogs": [
              "223050403"
            ]
          },
          "223050403": {
            "id": "223050403",
            "speakerId": 2054,
            "speakerName": "石头",
            "text": "您来这边。这几块璞石，您自己挑一块。",
            "nextDialogs": [
              "223050404"
            ]
          },
          "223050404": {
            "id": "223050404",
            "speakerId": 2054,
            "speakerName": "石头",
            "text": "不用着急，挑好了您和我说，我来帮您开石。"
          }
        }
      }
    },
    {
      "subId": "2230505",
      "subQuestName": "",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "223050501"
        ],
        "dialogs": {
          "223050501": {
            "id": "223050501",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "600摩拉。",
            "nextDialogs": [
              "223050502"
            ]
          },
          "223050502": {
            "id": "223050502",
            "speakerId": 2054,
            "speakerName": "石头",
            "text": "好！大气，瞧您这风姿仪态，那是要赚大钱！",
            "nextDialogs": [
              "223050503"
            ]
          },
          "223050503": {
            "id": "223050503",
            "speakerId": 2054,
            "speakerName": "石头",
            "text": "您这边请，这几块璞石您上眼！",
            "nextDialogs": [
              "223050504"
            ]
          },
          "223050504": {
            "id": "223050504",
            "speakerId": 2054,
            "speakerName": "石头",
            "text": "您慢慢看，这可都是上好的璞石，绝不会亏了您的。",
            "nextDialogs": [
              "223050505"
            ]
          },
          "223050505": {
            "id": "223050505",
            "speakerId": 2054,
            "speakerName": "石头",
            "text": "挑好了您和我说，我来开石，不劳您动手。"
          }
        }
      }
    },
    {
      "subId": "2230506",
      "subQuestName": "选择璞石种类",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "223050601"
        ],
        "dialogs": {
          "223050601": {
            "id": "223050601",
            "speakerId": 2054,
            "speakerName": "石头",
            "text": "对了，这判断璞石价值几何啊，每个人都各有手段。",
            "nextDialogs": [
              "223050602"
            ]
          },
          "223050602": {
            "id": "223050602",
            "speakerId": 2054,
            "speakerName": "石头",
            "text": "有的人讲究「一眼之缘」，就是看到哪块，就是哪块。有的人就要细细观看，每一个细节都不放过。",
            "nextDialogs": [
              "223050603"
            ]
          },
          "223050603": {
            "id": "223050603",
            "speakerId": 2054,
            "speakerName": "石头",
            "text": "我也不知道您挑璞石有什么独门手段。不过璞石就放在这，是<color=#00E1FFFF>细细观察</color>，还是<color=#00E1FFFF>任凭缘分</color>，都随您的喜好。"
          }
        }
      }
    },
    {
      "subId": "2230507",
      "subQuestName": "",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "223050701"
        ],
        "dialogs": {
          "223050701": {
            "id": "223050701",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "黄色布上的那块…",
            "nextDialogs": [
              "223050702"
            ]
          },
          "223050702": {
            "id": "223050702",
            "speakerId": 2054,
            "speakerName": "石头",
            "text": "好嘞，我来给您开石。"
          }
        }
      }
    },
    {
      "subId": "2230508",
      "subQuestName": "",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "223050801"
        ],
        "dialogs": {
          "223050801": {
            "id": "223050801",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "蓝色布上的那块…",
            "nextDialogs": [
              "223050802"
            ]
          },
          "223050802": {
            "id": "223050802",
            "speakerId": 2054,
            "speakerName": "石头",
            "text": "好嘞，我来给您开石。"
          }
        }
      }
    },
    {
      "subId": "2230509",
      "subQuestName": "",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "223050901"
        ],
        "dialogs": {
          "223050901": {
            "id": "223050901",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "红白布上的那块…",
            "nextDialogs": [
              "223050902"
            ]
          },
          "223050902": {
            "id": "223050902",
            "speakerId": 2054,
            "speakerName": "石头",
            "text": "好嘞，我来给您开石。"
          }
        }
      }
    },
    {
      "subId": "2230510",
      "subQuestName": "",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "223051001"
        ],
        "dialogs": {
          "223051001": {
            "id": "223051001",
            "speakerId": 2054,
            "speakerName": "石头",
            "text": "您这石头，这里头没多少玉…",
            "nextDialogs": [
              "223051002"
            ]
          },
          "223051002": {
            "id": "223051002",
            "speakerId": 2054,
            "speakerName": "石头",
            "text": "嗨，没事，就是玩玩嘛，权当花钱买个开心。",
            "nextDialogs": [
              "223051003"
            ]
          },
          "223051003": {
            "id": "223051003",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "你说你们没有坏的…",
            "nextDialogs": [
              "223051004"
            ]
          },
          "223051004": {
            "id": "223051004",
            "speakerId": 2054,
            "speakerName": "石头",
            "text": "那是没有坏的啊，那璞石就是璞石，哪里有坏石一说？",
            "nextDialogs": [
              "223051005"
            ]
          },
          "223051005": {
            "id": "223051005",
            "speakerId": 2054,
            "speakerName": "石头",
            "text": "您啊，也别上心，这璞石，就是我有时候也会看走眼…",
            "nextDialogs": [
              "223051006"
            ]
          },
          "223051006": {
            "id": "223051006",
            "speakerId": 2054,
            "speakerName": "石头",
            "text": "我先帮您收着，您如果想接着看，我们就接着来，到此为止，我们就马上结账。",
            "nextDialogs": [
              "223051007"
            ]
          },
          "223051007": {
            "id": "223051007",
            "speakerId": 2054,
            "speakerName": "石头",
            "text": "<color=#00E1FFFF>最后，我再一起算给您钱</color>，免得我一份份地给您，我算糊涂，您也算糊涂。",
            "nextDialogs": [
              "223051008"
            ]
          },
          "223051008": {
            "id": "223051008",
            "speakerId": 2054,
            "speakerName": "石头",
            "text": "怎么样客官，您再玩几块？"
          }
        }
      }
    },
    {
      "subId": "2230511",
      "subQuestName": "",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "223051101"
        ],
        "dialogs": {
          "223051101": {
            "id": "223051101",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "再来一次！",
            "nextDialogs": [
              "223051102"
            ]
          },
          "223051102": {
            "id": "223051102",
            "speakerId": 2054,
            "speakerName": "石头",
            "text": "好！您这性情看着就是来赚钱的。",
            "nextDialogs": [
              "223051103"
            ]
          },
          "223051103": {
            "id": "223051103",
            "speakerId": 2054,
            "speakerName": "石头",
            "text": "「今天不来明天来，总有一天好运来！」，您这边请！"
          }
        }
      }
    },
    {
      "subId": "2230512",
      "subQuestName": "",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "223051201"
        ],
        "dialogs": {
          "223051201": {
            "id": "223051201",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "还是不玩了…",
            "nextDialogs": [
              "223051202"
            ]
          },
          "223051202": {
            "id": "223051202",
            "speakerId": 2054,
            "speakerName": "石头",
            "text": "也是，老是在这玩石头也不像话，那您自便吧。"
          }
        }
      }
    },
    {
      "subId": "2230513",
      "subQuestName": "与石头对话",
      "sceneId": null,
      "locations": [],

    {
      "subId": "1202210",
      "subQuestName": "调查心海的秘密基地",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "120221001"
        ],
        "dialogs": {
          "120221001": {
            "id": "120221001",
            "speakerId": 1001,
            "speakerName": "珊瑚宫心海",
            "text": "呜呜…完全不想动弹…",
            "nextDialogs": [
              "120221002"
            ]
          },
          "120221002": {
            "id": "120221002",
            "speakerId": 1001,
            "speakerName": "珊瑚宫心海",
            "text": "如果工作能够自动完成，该有多好啊…"
          }
        }
      }
    },
    {
      "subId": "1202217",
      "subQuestName": "与派蒙交谈",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "120220301"
        ],
        "dialogs": {
          "120220301": {
            "id": "120220301",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "#{NICKNAME}你看，这个会不会就是心海在找的兵书呢？",
            "nextDialogs": [
              "120220302"
            ]
          },
          "120220302": {
            "id": "120220302",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "今天剑鱼二番队的队长回来了，能量值+4——",
            "nextDialogs": [
              "120220303"
            ]
          },
          "120220303": {
            "id": "120220303",
            "speakerId": 1001,
            "speakerName": "珊瑚宫心海",
            "text": "啊啊…那个是…",
            "nextDialogs": [
              "120220306"
            ]
          },
          "120220306": {
            "id": "120220306",
            "speakerId": 1001,
            "speakerName": "珊瑚宫心海",
            "text": "还——给——我——",
            "nextDialogs": [
              "120220307"
            ]
          },
          "120220307": {
            "id": "120220307",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "唔唔，看来这个也不是呢，我们还是再找找吧。"
          }
        }
      }
    },
    {
      "subId": "1202211",
      "subQuestName": "调查心海的秘密基地",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "120221101"
        ],
        "dialogs": {
          "120221101": {
            "id": "120221101",
            "speakerId": 1001,
            "speakerName": "珊瑚宫心海",
            "text": "能量回满的时候，我也很擅长社交。",
            "nextDialogs": [
              "120221102"
            ]
          },
          "120221102": {
            "id": "120221102",
            "speakerId": 1001,
            "speakerName": "珊瑚宫心海",
            "text": "不过对我来说，跟不熟的人说话是一件消耗能量的事情呢…"
          }
        }
      }
    },
    {
      "subId": "1202213",
      "subQuestName": "与派蒙交谈",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "120220601"
        ],
        "dialogs": {
          "120220601": {
            "id": "120220601",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "#{NICKNAME}，我觉得应该就是这一本吧？",
            "nextDialogs": [
              "120220602"
            ]
          },
          "120220602": {
            "id": "120220602",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "你看，这里还有心海放进去的书签呢。像这一些就没有书签，应该是已经读完了吧。",
            "nextDialogs": [
              "120220603"
            ]
          },
          "120220603": {
            "id": "120220603",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "感觉里面的内容好难懂，完全看不明白…",
            "nextDialogs": [
              "120220604"
            ]
          },
          "120220604": {
            "id": "120220604",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "我们现在就把这本兵书带过去，读给她听吧？"
          }
        }
      }
    },
    {
      "subId": "1202207",
      "subQuestName": "设置任务全局变量$HIDDEN",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "120220701"
        ],
        "dialogs": {
          "120220701": {
            "id": "120220701",
            "speakerId": 1002,
            "speakerName": "柴田",
            "text": "你要见珊瑚宫大人？",
            "nextDialogs": [
              "120220702"
            ]
          },
          "120220702": {
            "id": "120220702",
            "speakerId": 1002,
            "speakerName": "柴田",
            "text": "不好意思，珊瑚宫大人不在这里，我也不知道她去了哪。",
            "nextDialogs": [
              "120220703"
            ]
          },
          "120220703": {
            "id": "120220703",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "怎么这样…那我们只能回去了吗？",
            "nextDialogs": [
              "120220704"
            ]
          },
          "120220704": {
            "id": "120220704",
            "speakerId": 1002,
            "speakerName": "柴田",
            "text": "倒也不是。我记得珊瑚宫大人留下来的常备锦囊中，好像有应对这种情况的解决办法。",
            "nextDialogs": [
              "120220705"
            ]
          },
          "120220705": {
            "id": "120220705",
            "speakerId": 1002,
            "speakerName": "柴田",
            "text": "让我想想。第九十八条…<color=#00E1FFFF>「有客远来，寻我不见；可来南边，紫叶树前」</color>。",
            "nextDialogs": [
              "120220706"
            ]
          },
          "120220706": {
            "id": "120220706",
            "speakerId": 1002,
            "speakerName": "柴田",
            "text": "备注上还写了，只有珊瑚宫大人没有留下任何其他交代，且客人身份很特别时，才能适用这一条。",
            "nextDialogs": [
              "120220707"
            ]
          },
          "120220707": {
            "id": "120220707",
            "speakerId": 1002,
            "speakerName": "柴田",
            "text": "两位应该算远道而来的客人吧。这锦囊我一直带着，应该不会有错。",
            "nextDialogs": [
              "120220708"
            ]
          },
          "120220708": {
            "id": "120220708",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "心海果然什么情况都考虑到了，那我们到她说的地方找找看吧！"
          }
        }
      }
    },
    {
      "subId": "1202212",
      "subQuestName": "为心海朗读兵书",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "120220401"
        ],
        "dialogs": {
          "120220401": {
            "id": "120220401",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "心海，你在找的是这一本吗？",
            "nextDialogs": [
              "120220402"
            ]
          },
          "120220402": {
            "id": "120220402",
            "speakerId": 1001,
            "speakerName": "珊瑚宫心海",
            "text": "我也有点记不清了…可以读两句让我听听吗？",
            "nextDialogs": [
              "120220405"
            ]
          },
          "120220405": {
            "id": "120220405",
            "speakerId": 1001,
            "speakerName": "珊瑚宫心海",
            "text": "嗯嗯，就是这个！拜托你啦。",
            "nextDialogs": [
              "120220406"
            ]
          },
          "120220406": {
            "id": "120220406",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "心海…心海…",
            "nextDialogs": [
              "120220407"
            ]
          },
          "120220407": {
            "id": "120220407",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "#怎么办呀，{NICKNAME}，心海她好像睡着了。",
            "nextDialogs": [
              "120220408"
            ]
          },
          "120220408": {
            "id": "120220408",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "今天晚上还有庆功晚会呢！而且马上就要和谈了，还有很多事没有做…"
          }
        }
      }
    },

  "subQuests": [
    {
      "subId": "1202201",
      "subQuestName": "等待到第二天上午10点 - 12点",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "120220101"
        ],
        "dialogs": {
          "120220101": {
            "id": "120220101",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "咦，心海还没来吗？",
            "nextDialogs": [
              "120220102"
            ]
          },
          "120220102": {
            "id": "120220102",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "好奇怪啊，总感觉心海不像是那种会迟到的人…我们再多等一会儿吧。",
            "nextDialogs": [
              "120220103"
            ]
          },
          "120220103": {
            "id": "120220103",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "心海怎么还没来，会不会是遇到什么麻烦了？",
            "nextDialogs": [
              "120220104"
            ]
          },
          "120220104": {
            "id": "120220104",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "我们去找那边的士兵打听一下吧！"
          }
        }
      }
    },

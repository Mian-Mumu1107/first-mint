    {
      "subId": "2002025",
      "subQuestName": "向安娜回报",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "200201001"
        ],
        "dialogs": {
          "200201001": {
            "id": "200201001",
            "speakerId": 1000,
            "speakerName": "安娜",
            "text": "旅行者，你已经回来了啊，怎么样？你拍到画片了吗？",
            "nextDialogs": [
              "200201002"
            ]
          },
          "200201002": {
            "id": "200201002",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "全部拍好了，还都采来了。",
            "nextDialogs": [
              "200201003"
            ]
          },
          "200201003": {
            "id": "200201003",
            "speakerId": 1000,
            "speakerName": "安娜",
            "text": "哇！你怎么能这么快全部拍好的…这就是经验丰富的冒险家吗？真厉害啊…",
            "nextDialogs": [
              "200201004"
            ]
          },
          "200201004": {
            "id": "200201004",
            "speakerId": 1000,
            "speakerName": "安娜",
            "text": "谢谢你，旅行者！嗯…这样吧，为了感谢你，我来亲手做一道好菜给你吧。",
            "nextDialogs": [
              "200201005"
            ]
          },
          "200201005": {
            "id": "200201005",
            "speakerId": 1000,
            "speakerName": "安娜",
            "text": "怎么样，看起来还不错吧，要好好品尝啊。",
            "nextDialogs": [
              "200201006"
            ]
          },
          "200201006": {
            "id": "200201006",
            "speakerId": 1000,
            "speakerName": "安娜",
            "text": "我回去接着写笔记去了。嗯…这些植物的话…",
            "nextDialogs": [
              "200201007"
            ]
          },
          "200201007": {
            "id": "200201007",
            "speakerId": 1000,
            "speakerName": "安娜",
            "text": "我得去问问杰克，看他知不知道怎么做植物标本。",
            "nextDialogs": [
              "200201008"
            ]
          },
          "200201008": {
            "id": "200201008",
            "speakerId": 1000,
            "speakerName": "安娜",
            "text": "塞西莉亚花就不做标本了，插在花瓶里好了…"
          }
        }
      }

    "安娜": 31
  },
  "subQuests": [
    {
      "subId": "2002001",
      "subQuestName": "与安娜对话",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "200200101"
        ],
        "dialogs": {
          "200200101": {
            "id": "200200101",
            "speakerId": 1000,
            "speakerName": "安娜",
            "text": "原来如此，原来如此…",
            "nextDialogs": [
              "200200102"
            ]
          },
          "200200102": {
            "id": "200200102",
            "speakerId": 1000,
            "speakerName": "安娜",
            "text": "哥，你知道这些植物除了做菜之外的用途吗？",
            "nextDialogs": [
              "200200103"
            ]
          },
          "200200103": {
            "id": "200200103",
            "speakerId": 1001,
            "speakerName": "安东尼",
            "text": "我怎么可能知道…",
            "nextDialogs": [
              "200200104"
            ]
          },
          "200200104": {
            "id": "200200104",
            "speakerId": 1001,
            "speakerName": "安东尼",
            "text": "我只知道在哪可以采到它们，还有它们到底能不能吃。",
            "nextDialogs": [
              "200200105"
            ]
          },
          "200200105": {
            "id": "200200105",
            "speakerId": 1000,
            "speakerName": "安娜",
            "text": "唔…那我就自己出去看看好了，放心啦哥，我只是去采集植物，绝对不会靠近魔物的。",
            "nextDialogs": [
              "200200106"
            ]
          },
          "200200106": {
            "id": "200200106",
            "speakerId": 1001,
            "speakerName": "安东尼",
            "text": "唉，你自己心里有点数就好。",
            "nextDialogs": [
              "200200107"
            ]
          },
          "200200107": {
            "id": "200200107",
            "speakerId": 1000,
            "speakerName": "安娜",
            "text": "我知道啦。那我今天可要晚点回来了。",
            "nextDialogs": [
              "200200110"
            ]
          },
          "200200110": {
            "id": "200200110",
            "speakerId": 1000,
            "speakerName": "安娜",
            "text": "旅行者！你来得正好，我正准备去野外观察植物呢。",
            "nextDialogs": [
              "200200111"
            ]
          },
          "200200111": {
            "id": "200200111",
            "speakerId": 1000,
            "speakerName": "安娜",
            "text": "塞琉斯叔叔和我说，冒险家会经常在野外露宿，寻找食物是一项很重要的能力。",
            "nextDialogs": [
              "200200112"
            ]
          },
          "200200112": {
            "id": "200200112",
            "speakerId": 1000,
            "speakerName": "安娜",
            "text": "所以，我打算先去观察一下野外的植物，把它们的分布点和特性都记录好，再慢慢背下来。",
            "nextDialogs": [
              "200200113"
            ]
          },
          "200200113": {
            "id": "200200113",
            "speakerId": 1000,
            "speakerName": "安娜",
            "text": "这样子，以后我在野外寻找食物的时候，至少知道哪些植物能吃，哪些植物不能吃了。",
            "nextDialogs": [
              "200200114"
            ]
          },
          "200200114": {
            "id": "200200114",
            "speakerId": 1000,
            "speakerName": "安娜",
            "text": "但是…光用文字描述的话，我觉得实在不够直观。",
            "nextDialogs": [
              "200200115"
            ]
          },
          "200200115": {
            "id": "200200115",
            "speakerId": 1000,
            "speakerName": "安娜",
            "text": "旅行者，我听说你有一种叫做「留影机」的东西，对吧？",
            "nextDialogs": [
              "200200116"
            ]
          },
          "200200116": {
            "id": "200200116",
            "speakerId": 1000,
            "speakerName": "安娜",
            "text": "能不能请你帮我用「留影机」记录一下几种植物的生长环境？",
            "nextDialogs": [
              "200200117"
            ]
          },
          "200200117": {
            "id": "200200117",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "没问题。",
            "nextDialogs": [
              "200200118"
            ]
          },
          "200200118": {
            "id": "200200118",
            "speakerId": 1000,
            "speakerName": "安娜",
            "text": "那就请你先帮我去记录一下嘟嘟莲，小灯草，还有塞西莉亚花的生长环境吧。",
            "nextDialogs": [
              "200200119"
            ]
          },
          "200200119": {
            "id": "200200119",
            "speakerId": 1000,
            "speakerName": "安娜",
            "text": "然后再把这三种植物采下来带给我，我要把它们做成标本保存下来。",
            "nextDialogs": [
              "200200120"
            ]
          },
          "200200120": {
            "id": "200200120",
            "speakerId": 1000,
            "speakerName": "安娜",
            "text": "植物生长环境的记录画片、真实的植物标本，还有详细的文字说明…",
            "nextDialogs": [
              "200200121"
            ]
          },
          "200200121": {
            "id": "200200121",
            "speakerId": 1000,
            "speakerName": "安娜",
            "text": "我的「冒险家植物笔记」读起来一定会很不错的！",
            "nextDialogs": [
              "200200122"
            ]
          },
          "200200122": {
            "id": "200200122",
            "speakerId": 1000,
            "speakerName": "安娜",
            "text": "那就拜托你啦，旅行者。",
            "nextDialogs": [
              "200200123"
            ]
          },
          "200200123": {
            "id": "200200123",
            "speakerId": 1000,
            "speakerName": "安娜",
            "text": "清泉镇的那潭泉水旁应该有很多嘟嘟莲，小灯草能在奔狼领里找到。",
            "nextDialogs": [
              "200200124"
            ]
          },
          "200200124": {
            "id": "200200124",
            "speakerId": 1000,
            "speakerName": "安娜",
            "text": "塞西莉亚花嘛…那当然要去摘星崖啦。",
            "nextDialogs": [
              "200200125"
            ]
          },
          "200200125": {
            "id": "200200125",
            "speakerId": 1000,
            "speakerName": "安娜",
            "text": "我得去其他的地方继续观察植物。",
            "nextDialogs": [
              "200200126"
            ]
          },
          "200200126": {
            "id": "200200126",
            "speakerId": 1000,
            "speakerName": "安娜",
            "text": "等你拍到了画片，我们还是在城里碰头。"
          }
        }
      }
    },

          },
          "200201202": {
            "id": "200201202",
            "speakerId": 1000,
            "speakerName": "安娜",
            "text": "我回去接着写笔记去了。嗯…这些植物的话…",
            "nextDialogs": [
              "200201203"
            ]
          },
          "200201203": {
            "id": "200201203",
            "speakerId": 1000,
            "speakerName": "安娜",
            "text": "我得去问问杰克，看他知不知道怎么做植物标本。",
            "nextDialogs": [
              "200201204"
            ]
          },
          "200201204": {
            "id": "200201204",
            "speakerId": 1000,
            "speakerName": "安娜",
            "text": "塞西莉亚花就不做标本了，插在花瓶里好了…"
          }
        }
      }

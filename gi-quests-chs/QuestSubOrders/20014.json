  "subQuests": [
    {
      "subId": "2001401",
      "subQuestName": "与安东尼对话",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "200140101"
        ],
        "dialogs": {
          "200140101": {
            "id": "200140101",
            "speakerId": 1408,
            "speakerName": "安东尼",
            "text": "安娜，你再好好想想，这件事我认为要从长计议才好…",
            "nextDialogs": [
              "200140102"
            ]
          },
          "200140102": {
            "id": "200140102",
            "speakerId": 1405,
            "speakerName": "安娜",
            "text": "哎呀，你就别担心我了，我肯定没问题的！",
            "nextDialogs": [
              "200140105"
            ]
          },
          "200140105": {
            "id": "200140105",
            "speakerId": 1408,
            "speakerName": "安东尼",
            "text": "旅行者！你来得正好，快帮我劝劝安娜吧，她要去做冒险家！",
            "nextDialogs": [
              "200140106"
            ]
          },
          "200140106": {
            "id": "200140106",
            "speakerId": 1405,
            "speakerName": "安娜",
            "text": "我为什么不能做冒险家？我现在身体很健康，塞琉斯叔叔也说我脑子很灵活，很适合做冒险家！",
            "nextDialogs": [
              "200140107"
            ]
          },
          "200140107": {
            "id": "200140107",
            "speakerId": 1408,
            "speakerName": "安东尼",
            "text": "你病才好了多久？如果你去做冒险家，又折腾出病来怎么办？而且，爸妈也不会同意…",
            "nextDialogs": [
              "200140108"
            ]
          },
          "200140108": {
            "id": "200140108",
            "speakerId": 1405,
            "speakerName": "安娜",
            "text": "我和爸爸妈妈已经说过了，他们说，只要我能通过冒险家协会的考试，他们就同意我做冒险家。",
            "nextDialogs": [
              "200140109"
            ]
          },
          "200140109": {
            "id": "200140109",
            "speakerId": 1408,
            "speakerName": "安东尼",
            "text": "啊…啊？！"
          }
        }
      }
    },
    {
      "subId": "2001402",
      "subQuestName": "打倒所有魔物",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "200140201"
        ],
        "dialogs": {
          "200140201": {
            "id": "200140201",
            "speakerId": 1405,
            "speakerName": "安娜",
            "text": "魔物全都被打倒啦，你可真厉害。",
            "nextDialogs": [
              "200140202"
            ]
          },
          "200140202": {
            "id": "200140202",
            "speakerId": 1405,
            "speakerName": "安娜",
            "text": "冒险手册上面写的果然没错，可以使用各种方式来打倒魔物…",
            "nextDialogs": [
              "200140203"
            ]
          },
          "200140203": {
            "id": "200140203",
            "speakerId": 1405,
            "speakerName": "安娜",
            "text": "不过…说实话，离这些魔物这么近，我还是有些害怕…幸好有你陪着我。",
            "nextDialogs": [
              "200140204"
            ]
          },
          "200140204": {
            "id": "200140204",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "你还得多多训练。",
            "nextDialogs": [
              "200140205"
            ]
          },
          "200140205": {
            "id": "200140205",
            "speakerId": 1405,
            "speakerName": "安娜",
            "text": "嗯，我知道。要成为冒险家可不是一件容易的事。",
            "nextDialogs": [
              "200140206"
            ]
          },
          "200140206": {
            "id": "200140206",
            "speakerId": 1405,
            "speakerName": "安娜",
            "text": "谢谢你旅行者，我先回去城里啦。出来这么长时间，我哥哥又要着急了。",
            "nextDialogs": [
              "200140207"
            ]
          },
          "200140207": {
            "id": "200140207",
            "speakerId": 1405,
            "speakerName": "安娜",
            "text": "今后的训练，我得再努力一点才行。"
          }
        }
      }
    },

        "startDialogs": [
          "200180601"
        ],
        "dialogs": {
          "200180601": {
            "id": "200180601",
            "speakerId": 1000,
            "speakerName": "害怕的玛伽",
            "text": "谢谢你，旅行者，就先这样吧。",
            "nextDialogs": [
              "200180602"
            ]
          },
          "200180602": {
            "id": "200180602",
            "speakerId": 1000,
            "speakerName": "害怕的玛伽",
            "text": "勉强能到清泉镇，把货卸了之后，我再回去向酒庄报告情况。",
            "nextDialogs": [
              "200180603"
            ]
          },
          "200180603": {
            "id": "200180603",
            "speakerId": 1000,
            "speakerName": "害怕的玛伽",
            "text": "就是不知道埃泽先生看见车被破坏成这样，我会不会被当场开除啊…"
          }
        }
      }
    },
    {
      "subId": "2001802",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "200180201"
        ],
        "dialogs": {
          "200180201": {
            "id": "200180201",
            "speakerId": 1000,
            "speakerName": "害怕的玛伽",
            "text": "树林里应该就能找到<color=#00E1FFFF>结实的木板</color>了，找到后就给我吧。"
          }
        }
      }
    },
    {
      "subId": "2001804",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "200180401"
        ],
        "dialogs": {
          "200180401": {
            "id": "200180401",
            "speakerId": 1000,
            "speakerName": "害怕的玛伽",
            "text": "呼…谢谢，旅行者，还好有你在。",
            "nextDialogs": [
              "200180402"
            ]
          },
          "200180402": {
            "id": "200180402",
            "speakerId": 1000,
            "speakerName": "害怕的玛伽",
            "text": "不过这么一折腾，这车我已经不知道怎么修了…",
            "nextDialogs": [
              "200180403"
            ]
          },
          "200180403": {
            "id": "200180403",
            "speakerId": 1000,
            "speakerName": "害怕的玛伽",
            "text": "这里是坏的，那里也是坏的…这就算是勉强修好了，走着走着也会散架。",
            "nextDialogs": [
              "200180404"
            ]
          },
          "200180404": {
            "id": "200180404",
            "speakerId": 1000,
            "speakerName": "害怕的玛伽",
            "text": "算了，总之先把车弄到镇里去，再慢慢想办法吧。",
            "nextDialogs": [
              "200180405"
            ]
          },
          "200180405": {
            "id": "200180405",
            "speakerId": 1000,
            "speakerName": "害怕的玛伽",
            "text": "我记得车上有绳子来着…准是被那群家伙拿走了。",
            "nextDialogs": [
              "200180406"
            ]
          },
          "200180406": {
            "id": "200180406",
            "speakerId": 1000,
            "speakerName": "害怕的玛伽",
            "text": "旅行者，帮我去旁边树林里找找看吧，如果<color=#00E1FFFF>绳子</color>在那就好了。"
          }
        }
      }
    },

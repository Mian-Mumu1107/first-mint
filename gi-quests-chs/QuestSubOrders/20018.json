  "subQuests": [
    {
      "subId": "2001809",
      "subQuestName": "前去查看详情",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "200180901"
        ],
        "dialogs": {
          "200180901": {
            "id": "200180901",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "明白了。",
            "nextDialogs": [
              "200180902"
            ]
          },
          "200180902": {
            "id": "200180902",
            "speakerId": 1000,
            "speakerName": "害怕的玛伽",
            "text": "那就麻烦你了，我，我接着看看车的状况。"
          }
        }
      }
    },
    {
      "subId": "2001801",
      "subQuestName": "消灭所有魔物",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "200180101"
        ],
        "dialogs": {
          "200180101": {
            "id": "200180101",
            "speakerId": 1000,
            "speakerName": "害怕的玛伽",
            "text": "谢谢你，旅行者，呜…我就知道，我肯定会把工作给搞砸…",
            "nextDialogs": [
              "200180102"
            ]
          },
          "200180102": {
            "id": "200180102",
            "speakerId": 1000,
            "speakerName": "害怕的玛伽",
            "text": "就是运一车酒而已我都能搞砸，我到底能做成什么事情呀。",
            "nextDialogs": [
              "200180103"
            ]
          },
          "200180103": {
            "id": "200180103",
            "speakerId": 1000,
            "speakerName": "害怕的玛伽",
            "text": "这么下去肯定会被酒庄开除，康纳先生说不定早就觉得我工作能力不行，埃泽先生也许把我的辞退信都拟好了，完了，全都完了…",
            "nextDialogs": [
              "200180104"
            ]
          },
          "200180104": {
            "id": "200180104",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "你…你冷静点…",
            "nextDialogs": [
              "200180105"
            ]
          },
          "200180105": {
            "id": "200180105",
            "speakerId": 1000,
            "speakerName": "害怕的玛伽",
            "text": "唉，我肯定完蛋了，但是这车酒还是要运到才行。",
            "nextDialogs": [
              "200180106"
            ]
          },
          "200180106": {
            "id": "200180106",
            "speakerId": 1000,
            "speakerName": "害怕的玛伽",
            "text": "车也被打坏了…旅行者，能麻烦你帮我找点材料来吗？只要一块<color=#00E1FFFF>结实的木板</color>就行了。"
          }
        }
      }
    },
    {
      "subId": "2001802",
      "subQuestName": "和玛伽对话",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "200180701"
        ],
        "dialogs": {
          "200180701": {
            "id": "200180701",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "好的，别担心…",
            "nextDialogs": [
              "200180702"
            ]
          },
          "200180702": {
            "id": "200180702",
            "speakerId": 1000,
            "speakerName": "害怕的玛伽",
            "text": "那就拜托你了，我…我想想怎么才能把车修好。"
          }
        }
      }
    },
    {
      "subId": "2001803",
      "subQuestName": "收集木材",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "200180301"
        ],
        "dialogs": {
          "200180301": {
            "id": "200180301",
            "speakerId": 1000,
            "speakerName": "害怕的玛伽",
            "text": "这些就足够了，我应该，应该很快就能把车修好…",
            "nextDialogs": [
              "200180302"
            ]
          },
          "200180302": {
            "id": "200180302",
            "speakerId": 1000,
            "speakerName": "害怕的玛伽",
            "text": "那群家伙怎么又来了！旅行者，帮帮我！"
          }
        }
      }
    },
    {

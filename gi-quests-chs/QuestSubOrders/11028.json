  "subQuests": [
    {
      "subId": "1102801",
      "subQuestName": "前往轻策庄西郊",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "110280101"
        ],
        "dialogs": {
          "110280101": {
            "id": "110280101",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "哇，这边竟然还有间屋子？好隐蔽，之前都没发现过…",
            "nextDialogs": [
              "110280102"
            ]
          },
          "110280102": {
            "id": "110280102",
            "speakerId": 10234,
            "speakerName": "白术",
            "text": "我常到轻策庄附近出诊，也没有留意过这里，或许…是师姐不想被旁人发现吧。",
            "nextDialogs": [
              "110280103"
            ]
          },
          "110280103": {
            "id": "110280103",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "对哦，之前急着赶路都忘记问了，失踪的江蓠…原来是你的师姐吗？",
            "nextDialogs": [
              "110280104"
            ]
          },
          "110280104": {
            "id": "110280104",
            "speakerId": 10234,
            "speakerName": "白术",
            "text": "嗯，当年我与师姐一起随师父，在沉玉谷附近学医。",
            "nextDialogs": [
              "110280105"
            ]
          },
          "110280105": {
            "id": "110280105",
            "speakerId": 10234,
            "speakerName": "白术",
            "text": "师姐长我数岁，很早就独自出去游历了，所以，我与她相处的时间并不算多。",
            "nextDialogs": [
              "110280106"
            ]
          },
          "110280106": {
            "id": "110280106",
            "speakerId": 1002,
            "speakerName": "长生",
            "text": "听说她在游历期间，跟一名采药人成了家，看来就是嘉良那小子了。",
            "nextDialogs": [
              "110280107"
            ]
          },
          "110280107": {
            "id": "110280107",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "欸？听长生这说法…你们以前没见过嘉良和阿雩吗？",
            "nextDialogs": [
              "110280108"
            ]
          },
          "110280108": {
            "id": "110280108",
            "speakerId": 10234,
            "speakerName": "白术",
            "text": "…师姐偶尔会回沉玉谷看望我跟师父，但不知为何，很少提及自己的家事。",
            "nextDialogs": [
              "110280109"
            ]
          },
          "110280109": {
            "id": "110280109",
            "speakerId": 10234,
            "speakerName": "白术",
            "text": "最后一次回谷时，师姐似乎跟师父起了争执…自那以后，她便不再与我们联系，连踪迹也被刻意隐藏了。",
            "nextDialogs": [
              "110280110"
            ]
          },
          "110280110": {
            "id": "110280110",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "欸？争执？发生了什么？",
            "nextDialogs": [
              "110280111"
            ]
          },
          "110280111": {
            "id": "110280111",
            "speakerId": 1002,
            "speakerName": "长生",
            "text": "不知道。那时候，就连我也不在场。",
            "nextDialogs": [
              "110280112"
            ]
          },
          "110280112": {
            "id": "110280112",
            "speakerId": 10234,
            "speakerName": "白术",
            "text": "师父从未解释过此事，只是嘱咐我，若将来有缘能再见师姐或其家人…就尽可能地施以援手吧。",
            "nextDialogs": [
              "110280113"
            ]
          },
          "110280113": {
            "id": "110280113",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "哦…所以白术你才会冒着这么大的风险来救嘉良啊。",
            "nextDialogs": [
              "110280114"
            ]
          },
          "110280114": {
            "id": "110280114",
            "speakerId": 10234,
            "speakerName": "白术",
            "text": "不，即使没有师父的遗愿，救死扶伤也是医者的天职，我一样会这么做。",
            "nextDialogs": [
              "110280115"
            ]
          },
          "110280115": {
            "id": "110280115",
            "speakerId": 1002,
            "speakerName": "长生",
            "text": "…唉。",
            "nextDialogs": [
              "110280116"
            ]
          },
          "110280116": {
            "id": "110280116",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "原来白术你人这么好…抱歉，以前还总觉得你在算计什么。",
            "nextDialogs": [
              "110280117"
            ]
          },
          "110280117": {
            "id": "110280117",
            "speakerId": 10234,
            "speakerName": "白术",
            "text": "呵呵，只凭一句话就打消掉疑虑了吗？那你可得小心了，要知道所谓好人…也是可以为自己做打算的。",
            "nextDialogs": [
              "110280118"
            ]
          },
          "110280118": {
            "id": "110280118",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "欸欸——突然又变得话里有话了！",
            "nextDialogs": [
              "110280119"
            ]
          },
          "110280119": {
            "id": "110280119",
            "speakerId": 10234,
            "speakerName": "白术",
            "text": "哈哈，闲话就先说到这里，此地既然是师姐隐居之处，应该会留下一些线索。",
            "nextDialogs": [
              "110280120"
            ]
          },
          "110280120": {
            "id": "110280120",
            "speakerId": 10234,
            "speakerName": "白术",
            "text": "我们分头搜寻，如果有什么发现，再一起看看吧。"
          }
        }
      }
    },
    {
      "subId": "1102802",
      "subQuestName": "在附近收集线索",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "110280201"
        ],
        "dialogs": {
          "110280201": {
            "id": "110280201",
            "speakerId": 13138,
            "speakerName": "观察梁柱",
            "text": "（梁柱上刻着道道浅浅的划痕，或许是用来记录阿雩身高的。）",
            "nextDialogs": [
              "110280202"
            ]
          },
          "110280202": {
            "id": "110280202",
            "speakerId": 13138,
            "speakerName": "观察梁柱",
            "text": "（「阿雩快快长…早早走…」靠近底部的划痕旁，刻着已经模糊的小字。）",
            "nextDialogs": [
              "110280203"
            ]
          },
          "110280203": {
            "id": "110280203",
            "speakerId": 13138,
            "speakerName": "观察梁柱",
            "text": "（…从划痕的数量推断，一家人已经在此隐居许久。）"
          }
        }
      }
    },
    {
      "subId": "1102803",
      "subQuestName": "在附近收集线索",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "110280301"
        ],
        "dialogs": {
          "110280301": {
            "id": "110280301",
            "speakerId": 13139,
            "speakerName": "观察柴堆",
            "text": "（木柴码放得整整齐齐，剖面平整利落…劈柴人平日的气力应该不错。）",
            "nextDialogs": [
              "110280302"
            ]
          },
          "110280302": {
            "id": "110280302",
            "speakerId": 13139,
            "speakerName": "观察柴堆",
            "text": "（…底部的一些木柴已经受潮，似乎有一阵子未添新柴了。）"
          }
        }
      }
    },
    {
      "subId": "1102804",
      "subQuestName": "在附近收集线索",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "110280401"
        ],
        "dialogs": {
          "110280401": {
            "id": "110280401",
            "speakerId": 13140,
            "speakerName": "字迹稚嫩的日志",
            "text": "「…屋顶的瓦片坏了，我和妈都够不着。还好有爹在，马上就修好了！」",
            "nextDialogs": [
              "110280402"
            ]
          },
          "110280402": {
            "id": "110280402",
            "speakerId": 13140,
            "speakerName": "字迹稚嫩的日志",
            "text": "「…今天吃饭的时候，桌子有点摇，爹想修，却反而掰坏了桌子腿…」",
            "nextDialogs": [
              "110280403"
            ]
          },
          "110280403": {
            "id": "110280403",
            "speakerId": 13140,
            "speakerName": "字迹稚嫩的日志",
            "text": "「…爹又开始忘事了，我得帮他把这些事都记下来，等他病好些，再念给他听…」"
          }
        }
      }
    },
    {
      "subId": "1102811",
      "subQuestName": "(test)(hide)回滚隔离$HIDDEN",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "110281101"
        ],
        "dialogs": {
          "110281101": {
            "id": "110281101",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "……",
            "nextDialogs": [
              "110281104"
            ]
          },
          "110281104": {
            "id": "110281104",
            "speakerId": 10204,
            "speakerName": "魈",
            "text": "唤我何事？",
            "nextDialogs": [
              "110281105"
            ]
          },
          "110281105": {
            "id": "110281105",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "呜哇！",
            "nextDialogs": [
              "110281106"
            ]
          },
          "110281106": {
            "id": "110281106",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "…每次都要被你吓一跳！",
            "nextDialogs": [
              "110281107"
            ]
          },
          "110281107": {
            "id": "110281107",
            "speakerId": 1002,
            "speakerName": "长生",
            "text": "…仙人都喜欢这么出现吗？",
            "nextDialogs": [
              "110281108"
            ]
          },
          "110281108": {
            "id": "110281108",
            "speakerId": 10234,
            "speakerName": "白术",
            "text": "竟然是这位…",
            "nextDialogs": [
              "110281109"
            ]
          },
          "110281109": {
            "id": "110281109",
            "speakerId": 10204,
            "speakerName": "魈",
            "text": "…嗯？是你？",
            "nextDialogs": [
              "110281110"
            ]
          },
          "110281110": {
            "id": "110281110",
            "speakerId": 10234,
            "speakerName": "白术",
            "text": "不卜庐白术，见过仙师。",
            "nextDialogs": [
              "110281111"
            ]
          },
          "110281111": {
            "id": "110281111",
            "speakerId": 10234,
            "speakerName": "白术",
            "text": "…当年的海灯节，不识仙师真身，如果有什么怠慢的地方，还请见谅。",
            "nextDialogs": [
              "110281112"
            ]
          },
          "110281112": {
            "id": "110281112",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "欸，原来你们俩以前见过吗？",
            "nextDialogs": [
              "110281113"
            ]
          },
          "110281113": {
            "id": "110281113",
            "speakerId": 10204,
            "speakerName": "魈",
            "text": "一面之缘。",
            "nextDialogs": [
              "110281114"
            ]
          },
          "110281114": {
            "id": "110281114",
            "speakerId": 10204,
            "speakerName": "魈",
            "text": "…有「妖邪」的气息。你找我来，可是为了此事？"
          }
        }
      }
    },
    {
      "subId": "1102805",
      "subQuestName": "与白术对话",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [],
        "dialogs": {}
      }
    },
    {
      "subId": "1102806",
      "subQuestName": "返回不卜庐",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "110280601"
        ],
        "dialogs": {
          "110280601": {
            "id": "110280601",
            "speakerId": 13135,
            "speakerName": "阿雩",
            "text": "爹！你怎么了？爹！",
            "nextDialogs": [
              "110280602"
            ]
          },
          "110280602": {
            "id": "110280602",
            "speakerId": 13136,
            "speakerName": "嘉良",
            "text": "唔…唔…",
            "nextDialogs": [
              "110280603"
            ]
          },
          "110280603": {
            "id": "110280603",
            "speakerId": 10233,
            "speakerName": "七七",
            "text": "不要怕，白先生，会回来。",
            "nextDialogs": [
              "110280604"
            ]
          },
          "110280604": {
            "id": "110280604",
            "speakerId": 10234,
            "speakerName": "白术",
            "text": "情况怎么样了？",
            "nextDialogs": [
              "110280605"
            ]
          },
          "110280605": {
            "id": "110280605",
            "speakerId": 13135,
            "speakerName": "阿雩",
            "text": "白先生！爹他刚刚还好好的，突然就咳出血了！然后…然后就又连话都说不清了…",
            "nextDialogs": [
              "110280606"
            ]
          },
          "110280606": {
            "id": "110280606",
            "speakerId": 10233,
            "speakerName": "七七",
            "text": "阿桂，出门的时候，还有意识，现在…",
            "nextDialogs": [
              "110280607"
            ]
          },
          "110280607": {
            "id": "110280607",
            "speakerId": 10234,
            "speakerName": "白术",
            "text": "…阿桂，先把嘉良扶去内室诊治吧。",
            "nextDialogs": [
              "110280608"
            ]
          },
          "110280608": {
            "id": "110280608",
            "speakerId": 2103,
            "speakerName": "阿桂",
            "text": "好、好的！",
            "nextDialogs": [
              "110280609"
            ]
          },
          "110280609": {
            "id": "110280609",
            "speakerId": 10234,
            "speakerName": "白术",
            "text": "阿雩，你放心，我会治好你父亲的。"
          }
        }
      }
    },
    {
      "subId": "1102807",
      "subQuestName": "等待至次日早晨（8-10点）",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "110280701"
        ],
        "dialogs": {
          "110280701": {
            "id": "110280701",
            "speakerId": 1002,
            "speakerName": "长生",
            "text": "真没想到，连江蓠的孩子都长这么大了…",
            "nextDialogs": [
              "110280702"
            ]
          },
          "110280702": {
            "id": "110280702",
            "speakerId": 10234,
            "speakerName": "白术",
            "text": "不知道师姐这些年里，变了多少？"
          }
        }
      }
    },
    {
      "subId": "1102808",
      "subQuestName": "与阿雩等人对话",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "110280801"
        ],
        "dialogs": {
          "110280801": {
            "id": "110280801",
            "speakerId": 13135,
            "speakerName": "阿雩",
            "text": "爹，你感觉怎么样…？还有哪里不舒服吗？不会又突然病倒吧…",
            "nextDialogs": [
              "110280802"
            ]
          },
          "110280802": {
            "id": "110280802",
            "speakerId": 13136,
            "speakerName": "嘉良",
            "text": "好多了，已经好多了。虽然，说不上是怎么回事…但总感觉，身体比之前还要轻快。",
            "nextDialogs": [
              "110280803"
            ]
          },
          "110280803": {
            "id": "110280803",
            "speakerId": 13136,
            "speakerName": "嘉良",
            "text": "嗯？说起来…白先生在哪儿？我还没跟他道谢呢。才一清醒过来，人就已经在这里了。",
            "nextDialogs": [
              "110280804"
            ]
          },
          "110280804": {
            "id": "110280804",
            "speakerId": 2103,
            "speakerName": "阿桂",
            "text": "师父说自己想先休息会儿，嘱托我扶您出了内室…然后他就没再出来过了。",
            "nextDialogs": [
              "110280805"
            ]
          },
          "110280805": {
            "id": "110280805",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "……",
            "nextDialogs": [
              "110280806"
            ]
          },
          "110280806": {
            "id": "110280806",
            "speakerId": 13136,
            "speakerName": "嘉良",
            "text": "这样吗…也是，这都让白先生操劳两夜了。",
            "nextDialogs": [
              "110280807"
            ]
          },
          "110280807": {
            "id": "110280807",
            "speakerId": 13136,
            "speakerName": "嘉良",
            "text": "唉，这份大恩，可真不知道该怎么报了。等找到江蓠，我们得好好谈谈…",
            "nextDialogs": [
              "110280808"
            ]
          },
          "110280808": {
            "id": "110280808",
            "speakerId": 13136,
            "speakerName": "嘉良",
            "text": "唔…说起来，现在有她的消息了吗？",
            "nextDialogs": [
              "110280809"
            ]
          },
          "110280809": {
            "id": "110280809",
            "speakerId": 13135,
            "speakerName": "阿雩",
            "text": "冒险家协会还没有给我回信，一会儿我再去看看吧。",
            "nextDialogs": [
              "110280810"
            ]
          },
          "110280810": {
            "id": "110280810",
            "speakerId": 13136,
            "speakerName": "嘉良",
            "text": "那我也…呃！",
            "nextDialogs": [
              "110280811"
            ]
          },
          "110280811": {
            "id": "110280811",
            "speakerId": 2103,
            "speakerName": "阿桂",
            "text": "师父吩咐过，您现在的情况还不稳定，还请您先在不卜庐里歇息吧。至于阿雩这边，我会陪着一起去的。",
            "nextDialogs": [
              "110280812"
            ]
          },
          "110280812": {
            "id": "110280812",
            "speakerId": 13136,
            "speakerName": "嘉良",
            "text": "…唉，只能这样了吗…真是麻烦你们了。",
            "nextDialogs": [
              "110280813"
            ]
          },
          "110280813": {
            "id": "110280813",
            "speakerId": 13136,
            "speakerName": "嘉良",
            "text": "也好，等白术先生休息完，还得当面向他道谢啊。",
            "nextDialogs": [
              "110280814"
            ]
          },
          "110280814": {
            "id": "110280814",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "#{NICKNAME}，白术一直没露面，难道说…",
            "nextDialogs": [
              "110280815"
            ]
          },
          "110280815": {
            "id": "110280815",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "…我们去找他。",
            "nextDialogs": [
              "110280816"
            ]
          },
          "110280816": {
            "id": "110280816",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "欸？等等我！"
          }
        }
      }
    },
    {
      "subId": "1102809",
      "subQuestName": "在内室门外等待白术",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "110280901"
        ],
        "dialogs": {
          "110280901": {
            "id": "110280901",
            "speakerId": 10234,
            "speakerName": "白术",
            "text": "……",
            "nextDialogs": [
              "110280902"
            ]
          },
          "110280902": {
            "id": "110280902",
            "speakerId": 1002,
            "speakerName": "长生",
            "text": "…醒了吗？就算有我调息，你这么做，也还是太冒险了。",
            "nextDialogs": [
              "110280903"
            ]
          },
          "110280903": {
            "id": "110280903",
            "speakerId": 10234,
            "speakerName": "白术",
            "text": "…时间紧迫，不得不为。况且，不算没有收获。",
            "nextDialogs": [
              "110280904"
            ]
          },
          "110280904": {
            "id": "110280904",
            "speakerId": 10234,
            "speakerName": "白术",
            "text": "师姐的构思实属精妙，有不少值得借鉴的地方…唉，可惜了。",
            "nextDialogs": [
              "110280905"
            ]
          },
          "110280905": {
            "id": "110280905",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "…你说，白术他还得睡上多久啊…",
            "nextDialogs": [
              "110280906"
            ]
          },
          "110280906": {
            "id": "110280906",
            "speakerId": 1002,
            "speakerName": "长生",
            "text": "#你睡觉的时候，{M#他们}{F#她们}一直在外面守着，出去看看{M#他们}{F#她们}吧？",
            "nextDialogs": [
              "110280907"
            ]
          },
          "110280907": {
            "id": "110280907",
            "speakerId": 10234,
            "speakerName": "白术",
            "text": "…嗯。"
          }
        }
      }
    },
    {
      "subId": "1102810",
      "subQuestName": "与白术对话",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "110281001"
        ],
        "dialogs": {
          "110281001": {
            "id": "110281001",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "他不会…不会就这么…",
            "nextDialogs": [
              "110281002"
            ]
          },
          "110281002": {
            "id": "110281002",
            "speakerId": 1002,
            "speakerName": "长生",
            "text": "——是谁在背后念叨呢？",
            "nextDialogs": [
              "110281003"
            ]
          },
          "110281003": {
            "id": "110281003",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "啊！白术！长生！",
            "nextDialogs": [
              "110281004"
            ]
          },
          "110281004": {
            "id": "110281004",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "你们没事吧？",
            "nextDialogs": [
              "110281005"
            ]
          },
          "110281005": {
            "id": "110281005",
            "speakerId": 10234,
            "speakerName": "白术",
            "text": "没事，只是抽调了不少生机，需要一点时间，让长生帮我调养而已。",
            "nextDialogs": [
              "110281006"
            ]
          },
          "110281006": {
            "id": "110281006",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "嘉良昨天不还是好好的吗？怎么突然就又要用这法子来医治了…",
            "nextDialogs": [
              "110281007"
            ]
          },
          "110281007": {
            "id": "110281007",
            "speakerId": 10234,
            "speakerName": "白术",
            "text": "是我最开始的判断有误——嘉良身上的病，不止一种。",
            "nextDialogs": [
              "110281008"
            ]
          },
          "110281008": {
            "id": "110281008",
            "speakerId": 10234,
            "speakerName": "白术",
            "text": "…所以生机消耗的速度，也超乎了我的预期。",
            "nextDialogs": [
              "110281009"
            ]
          },
          "110281009": {
            "id": "110281009",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "——什么？除了魔神残渣炼的毒…居然还有别的吗？",
            "nextDialogs": [
              "110281010"
            ]
          },
          "110281010": {
            "id": "110281010",
            "speakerId": 10234,
            "speakerName": "白术",
            "text": "不如说，他所中的毒，从一开始，就是为了压制原有的病情而施用的。",
            "nextDialogs": [
              "110281011"
            ]
          },
          "110281011": {
            "id": "110281011",
            "speakerId": 10234,
            "speakerName": "白术",
            "text": "嘉良天生患有罕见的心病，必须设法护住心脉，不然轻则喋血昏迷，重则伤及肺腑。",
            "nextDialogs": [
              "110281012"
            ]
          },
          "110281012": {
            "id": "110281012",
            "speakerId": 10234,
            "speakerName": "白术",
            "text": "…魔神残渣于他而言，不是毒，而是药。",
            "nextDialogs": [
              "110281013"
            ]
          },
          "110281013": {
            "id": "110281013",
            "speakerId": 1002,
            "speakerName": "长生",
            "text": "如果没有这剂药，他怕是好些年前就已经死了吧。",
            "nextDialogs": [
              "110281014"
            ]
          },
          "110281014": {
            "id": "110281014",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "所以江蓠才会…",
            "nextDialogs": [
              "110281015"
            ]
          },
          "110281015": {
            "id": "110281015",
            "speakerId": 10234,
            "speakerName": "白术",
            "text": "但以毒攻毒，也非长久之计。时间一长，毒物在其心脉中淤积，便损害了他的神志。",
            "nextDialogs": [
              "110281016"
            ]
          },
          "110281016": {
            "id": "110281016",
            "speakerId": 10234,
            "speakerName": "白术",
            "text": "而且长期用毒，会令嘉良的身体产生抗性，药效愈减…师姐必须不断为其炼药，来延续他的生命。",
            "nextDialogs": [
              "110281017"
            ]
          },
          "110281017": {
            "id": "110281017",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "阿雩最开始说的…嘉良情况变差、江蓠出门采药…原来是这么一回事吗？",
            "nextDialogs": [
              "110281018"
            ]
          },
          "110281018": {
            "id": "110281018",
            "speakerId": 10234,
            "speakerName": "白术",
            "text": "魔神残渣凶煞至极，非常人可以抵御。以凡人之躯，如此频繁地接触…",
            "nextDialogs": [
              "110281019"
            ]
          },
          "110281019": {
            "id": "110281019",
            "speakerId": 10234,
            "speakerName": "白术",
            "text": "只怕就如那位仙师所言，为了挽回嘉良的性命，师姐…已将一切置之度外了。",
            "nextDialogs": [
              "110281020"
            ]
          },
          "110281020": {
            "id": "110281020",
            "speakerId": 1002,
            "speakerName": "长生",
            "text": "没想到，就连江蓠，最后也走上了这条老路，这就是宿命吗…",
            "nextDialogs": [
              "110281021"
            ]
          },
          "110281021": {
            "id": "110281021",
            "speakerId": 1002,
            "speakerName": "长生",
            "text": "为了救人，不惜害己；为了人力难为的奇迹，不惜一切追寻非人之力…",
            "nextDialogs": [
              "110281022"
            ]
          },
          "110281022": {
            "id": "110281022",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "宿命…？",
            "nextDialogs": [
              "110281023"
            ]
          },
          "110281023": {
            "id": "110281023",
            "speakerId": 10234,
            "speakerName": "白术",
            "text": "…现在就说什么宿命，未免也太早了。",
            "nextDialogs": [
              "110281024"
            ]
          },
          "110281024": {
            "id": "110281024",
            "speakerId": 10234,
            "speakerName": "白术",
            "text": "眼下嘉良的情况我已设法稳住，当务之急，是回轻策庄找到师姐。",
            "nextDialogs": [
              "110281025"
            ]
          },
          "110281025": {
            "id": "110281025",
            "speakerId": 10234,
            "speakerName": "白术",
            "text": "频繁接触魔神残渣，对她自己的身体也有极大的损伤。",
            "nextDialogs": [
              "110281026"
            ]
          },
          "110281026": {
            "id": "110281026",
            "speakerId": 10234,
            "speakerName": "白术",
            "text": "如今失踪多日，我怕凶多吉少…",
            "nextDialogs": [
              "110281029"
            ]
          },
          "110281029": {
            "id": "110281029",
            "speakerId": 13136,
            "speakerName": "嘉良",
            "text": "…是我，白先生，旅行者。",
            "nextDialogs": [
              "110281030"
            ]
          },
          "110281030": {
            "id": "110281030",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "嘉良！你…不会都听到了吧…",
            "nextDialogs": [
              "110281031"
            ]
          },
          "110281031": {
            "id": "110281031",
            "speakerId": 13136,
            "speakerName": "嘉良",
            "text": "白先生…请您带上我吧！",
            "nextDialogs": [
              "110281032"
            ]
          },
          "110281032": {
            "id": "110281032",
            "speakerId": 13136,
            "speakerName": "嘉良",
            "text": "您已经帮了我们一家太多，我不能再干看着您为江蓠冒险了。",
            "nextDialogs": [
              "110281033"
            ]
          },
          "110281033": {
            "id": "110281033",
            "speakerId": 13136,
            "speakerName": "嘉良",
            "text": "况且就是因为我，江蓠才会陷入这种境地…我知道自己没有救她的本事，但我至少能为你们引路。",
            "nextDialogs": [
              "110281034"
            ]
          },
          "110281034": {
            "id": "110281034",
            "speakerId": 13136,
            "speakerName": "嘉良",
            "text": "…我能想起来的，她每次都是去哪里「采药」…是在哪里跟我告别…我必须想起来！可恶…咳！",
            "nextDialogs": [
              "110281035"
            ]
          },
          "110281035": {
            "id": "110281035",
            "speakerId": 1002,
            "speakerName": "长生",
            "text": "当心！气血上涌，会伤到你的心脉，还是先留在这里吧。",
            "nextDialogs": [
              "110281036"
            ]
          },
          "110281036": {
            "id": "110281036",
            "speakerId": 13136,
            "speakerName": "嘉良",
            "text": "不行！得快点…快点…",
            "nextDialogs": [
              "110281037"
            ]
          },
          "110281037": {
            "id": "110281037",
            "speakerId": 13136,
            "speakerName": "嘉良",
            "text": "在我把这些事，再次忘掉之前…！",
            "nextDialogs": [
              "110281038"
            ]
          },
          "110281038": {
            "id": "110281038",
            "speakerId": 10234,
            "speakerName": "白术",
            "text": "唉…",
            "nextDialogs": [
              "110281039"
            ]
          },
          "110281039": {
            "id": "110281039",
            "speakerId": 10234,
            "speakerName": "白术",
            "text": "…此行可能有诸多凶险，你可有赴死的觉悟？",
            "nextDialogs": [
              "110281040"
            ]
          },
          "110281040": {
            "id": "110281040",
            "speakerId": 13136,
            "speakerName": "嘉良",
            "text": "哈…好些年前我就该上路了，现在还有什么可怕的？",
            "nextDialogs": [
              "110281041"
            ]
          },
          "110281041": {
            "id": "110281041",
            "speakerId": 13136,
            "speakerName": "嘉良",
            "text": "我只怕…在找到她之前，再一次，忘掉她的事…",
            "nextDialogs": [
              "110281042"
            ]
          },
          "110281042": {
            "id": "110281042",
            "speakerId": 10234,
            "speakerName": "白术",
            "text": "…既然如此，就随我来吧。",
            "nextDialogs": [
              "110281043"
            ]
          },
          "110281043": {
            "id": "110281043",
            "speakerId": 10233,
            "speakerName": "七七",
            "text": "白先生，又要出门了吗？",
            "nextDialogs": [
              "110281044"
            ]
          },
          "110281044": {
            "id": "110281044",
            "speakerId": 10234,
            "speakerName": "白术",
            "text": "嗯，一趟远门。七七，能托你准备一下平时那副药吗？",
            "nextDialogs": [
              "110281045"
            ]
          },
          "110281045": {
            "id": "110281045",
            "speakerId": 10234,
            "speakerName": "白术",
            "text": "多添一份雾虚花粉，再加上药匣第三格，和第五格里的东西…希望能起效。",
            "nextDialogs": [
              "110281046"
            ]
          },
          "110281046": {
            "id": "110281046",
            "speakerId": 10233,
            "speakerName": "七七",
            "text": "白先生…这是…",
            "nextDialogs": [
              "110281047"
            ]
          },
          "110281047": {
            "id": "110281047",
            "speakerId": 10234,
            "speakerName": "白术",
            "text": "去吧，记得看好药炉，不要再被烧着了。",
            "nextDialogs": [
              "110281048"
            ]
          },
          "110281048": {
            "id": "110281048",
            "speakerId": 10233,
            "speakerName": "七七",
            "text": "…好。"
          }
        }
      }
    },
    {
      "subId": "1102805",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "110280501"
        ],
        "dialogs": {
          "110280501": {
            "id": "110280501",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "这是…什么东西？",
            "nextDialogs": [
              "110280502"
            ]
          },
          "110280502": {
            "id": "110280502",
            "speakerId": 10234,
            "speakerName": "白术",
            "text": "刚才我与长生在屋内发现了一处暗格，里面装的…就是此物。",
            "nextDialogs": [
              "110280503"
            ]
          },
          "110280503": {
            "id": "110280503",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "魔神残渣…的气息？",
            "nextDialogs": [
              "110280504"
            ]
          },
          "110280504": {
            "id": "110280504",
            "speakerId": 1002,
            "speakerName": "长生",
            "text": "看来你们也感觉到了？没错，这是用魔神残渣炼制的毒药。",
            "nextDialogs": [
              "110280505"
            ]
          },
          "110280505": {
            "id": "110280505",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "呜呃——它、它是不是还在呼吸？我没有看错吧？",
            "nextDialogs": [
              "110280506"
            ]
          },
          "110280506": {
            "id": "110280506",
            "speakerId": 10234,
            "speakerName": "白术",
            "text": "嗯…恐怕，这还是一瓶「活着」的毒药。",
            "nextDialogs": [
              "110280507"
            ]
          },
          "110280507": {
            "id": "110280507",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "「活着」？",
            "nextDialogs": [
              "110280508"
            ]
          },
          "110280508": {
            "id": "110280508",
            "speakerId": 10234,
            "speakerName": "白术",
            "text": "带有「生命」特质的毒，我在《诸病源候杂记》中见过：古有诡毒，性分子母…虽隔千里，息息相连…",
            "nextDialogs": [
              "110280509"
            ]
          },
          "110280509": {
            "id": "110280509",
            "speakerId": 10234,
            "speakerName": "白术",
            "text": "如果这毒真是仿照此法炼制，那嘉良身上所中之毒，以及我们眼前所见的，应该都是「子毒」…只是一个分体而已。",
            "nextDialogs": [
              "110280510"
            ]
          },
          "110280510": {
            "id": "110280510",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "分体？还会有本体吗？",
            "nextDialogs": [
              "110280511"
            ]
          },
          "110280511": {
            "id": "110280511",
            "speakerId": 10234,
            "speakerName": "白术",
            "text": "嗯，施毒之人可以通过本体，间接影响中毒者的行为，或是心智。而中毒者，也会在一定程度上受到本体的感召。",
            "nextDialogs": [
              "110280512"
            ]
          },
          "110280512": {
            "id": "110280512",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "感召…啊！难道说，嘉良他一开始失踪的方向！",
            "nextDialogs": [
              "110280513"
            ]
          },
          "110280513": {
            "id": "110280513",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "——是往轻策庄来的！",
            "nextDialogs": [
              "110280514"
            ]
          },
          "110280514": {
            "id": "110280514",
            "speakerId": 10234,
            "speakerName": "白术",
            "text": "吸引着他的…想来就是这毒的本体——作为炼制原料的魔神残渣了。",
            "nextDialogs": [
              "110280515"
            ]
          },
          "110280515": {
            "id": "110280515",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "居然会有这种事情？这、这到底是谁下的毒啊！",
            "nextDialogs": [
              "110280516"
            ]
          },
          "110280516": {
            "id": "110280516",
            "speakerId": 10234,
            "speakerName": "白术",
            "text": "……",
            "nextDialogs": [
              "110280517"
            ]
          },
          "110280517": {
            "id": "110280517",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "……",
            "nextDialogs": [
              "110280518"
            ]
          },
          "110280518": {
            "id": "110280518",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "怎、怎么一下子都不说话了？",
            "nextDialogs": [
              "110280519"
            ]
          },
          "110280519": {
            "id": "110280519",
            "speakerId": 1002,
            "speakerName": "长生",
            "text": "…既然这毒被妥善保存在暗格里，那么施毒的人，大概就是这间屋子的主人了。",
            "nextDialogs": [
              "110280520"
            ]
          },
          "110280520": {
            "id": "110280520",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "你是说嘉良？可他干嘛要对自己用毒啊？",
            "nextDialogs": [
              "110280521"
            ]
          },
          "110280521": {
            "id": "110280521",
            "speakerId": 1002,
            "speakerName": "长生",
            "text": "你再好好想想，精通药石，又常住在这儿的人…",
            "nextDialogs": [
              "110280522"
            ]
          },
          "110280522": {
            "id": "110280522",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "啊？你的意思是…江蓠！",
            "nextDialogs": [
              "110280523"
            ]
          },
          "110280523": {
            "id": "110280523",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "不对不对！江蓠也没有理由对自己的丈夫用毒啊！",
            "nextDialogs": [
              "110280524"
            ]
          },
          "110280524": {
            "id": "110280524",
            "speakerId": 10234,
            "speakerName": "白术",
            "text": "…我也不觉得，师姐会做出这种事。",
            "nextDialogs": [
              "110280525"
            ]
          },
          "110280525": {
            "id": "110280525",
            "speakerId": 1002,
            "speakerName": "长生",
            "text": "但是有能力拿魔神残渣来炼毒的人，翻遍璃月怕是也找不出几个了吧？",
            "nextDialogs": [
              "110280526"
            ]
          },
          "110280526": {
            "id": "110280526",
            "speakerId": 10234,
            "speakerName": "白术",
            "text": "…现在妄加猜测，还为时过早。我们大可等医好了嘉良，再问问他能否想起更多线索。",
            "nextDialogs": [
              "110280527"
            ]
          },
          "110280527": {
            "id": "110280527",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "已经找到解毒的方法了吗？",
            "nextDialogs": [
              "110280528"
            ]
          },
          "110280528": {
            "id": "110280528",
            "speakerId": 10234,
            "speakerName": "白术",
            "text": "嗯，据《诸病源候杂记》所述，母毒既清，子毒自除…",
            "nextDialogs": [
              "110280529"
            ]
          },
          "110280529": {
            "id": "110280529",
            "speakerId": 10234,
            "speakerName": "白术",
            "text": "只要清除掉作为本体的魔神残渣，嘉良身上的毒，多半就能不药而愈了。",
            "nextDialogs": [
              "110280530"
            ]
          },
          "110280530": {
            "id": "110280530",
            "speakerId": 10234,
            "speakerName": "白术",
            "text": "#{NICKNAME}，关于轻策庄的魔神残渣，你有什么了解吗？",
            "nextDialogs": [
              "110280533"
            ]
          },
          "110280533": {
            "id": "110280533",
            "speakerId": 1002,
            "speakerName": "长生",
            "text": "唉，这种史书上都没影的事，估计也就只有那帮活了千百岁的老家伙们还有印象了。",
            "nextDialogs": [
              "110280534"
            ]
          },
          "110280534": {
            "id": "110280534",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "咦？长生你不是说，当年连仙人们都得给你面子吗？难道你没听说过这里的事？",
            "nextDialogs": [
              "110280535"
            ]
          },
          "110280535": {
            "id": "110280535",
            "speakerId": 1002,
            "speakerName": "长生",
            "text": "这个么…呃…",
            "nextDialogs": [
              "110280536"
            ]
          },
          "110280536": {
            "id": "110280536",
            "speakerId": 10234,
            "speakerName": "白术",
            "text": "长生的记忆与法力，较其鼎盛时已经消散了许多。",
            "nextDialogs": [
              "110280537"
            ]
          },
          "110280537": {
            "id": "110280537",
            "speakerId": 10234,
            "speakerName": "白术",
            "text": "现在甚至要靠与凡人签订契约、共享生机来维持生命，恐怕已经记不起这些旧事了。",
            "nextDialogs": [
              "110280538"
            ]
          },
          "110280538": {
            "id": "110280538",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "——啊？签订契约、共享生机…听着怎么像是妖魔鬼怪会做的事…？",
            "nextDialogs": [
              "110280539"
            ]
          },
          "110280539": {
            "id": "110280539",
            "speakerId": 1002,
            "speakerName": "长生",
            "text": "喂！请仙上身这种事，多少人求都求不来？",
            "nextDialogs": [
              "110280540"
            ]
          },
          "110280540": {
            "id": "110280540",
            "speakerId": 1002,
            "speakerName": "长生",
            "text": "有我帮忙调理气息，不仅延年益寿，还能强身健体，吃什么东西都不会闹肚子！",
            "nextDialogs": [
              "110280541"
            ]
          },
          "110280541": {
            "id": "110280541",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "强身健体！哦哦——原来是这么回事…",
            "nextDialogs": [
              "110280542"
            ]
          },
          "110280542": {
            "id": "110280542",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "嘿嘿，白术你哪天要是退休了，能不能让长生也跟我签几天契约…",
            "nextDialogs": [
              "110280543"
            ]
          },
          "110280543": {
            "id": "110280543",
            "speakerId": 10234,
            "speakerName": "白术",
            "text": "可惜，继承这门契约，对心性亦有要求，历代契约者莫不如是，怕是不能如派蒙所愿了。",
            "nextDialogs": [
              "110280544"
            ]
          },
          "110280544": {
            "id": "110280544",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "…心性？喂，你们没在绕着圈子损我吧？",
            "nextDialogs": [
              "110280545"
            ]
          },
          "110280545": {
            "id": "110280545",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "（从前听说，白术平时的身体并不好…）",
            "nextDialogs": [
              "110280546"
            ]
          },
          "110280546": {
            "id": "110280546",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "（而且他们的师父已逝，似乎也没有延寿至今…）",
            "nextDialogs": [
              "110280547"
            ]
          },
          "110280547": {
            "id": "110280547",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "唔唔唔…气死我了！我要给你们起难听的绰号——蛇架子！白绳子！",
            "nextDialogs": [
              "110280548"
            ]
          },
          "110280548": {
            "id": "110280548",
            "speakerId": 1002,
            "speakerName": "长生",
            "text": "唉，所以才说你心性不佳呀！",
            "nextDialogs": [
              "110280549"
            ]
          },
          "110280549": {
            "id": "110280549",
            "speakerId": 10234,
            "speakerName": "白术",
            "text": "#好了好了，话归正题，{NICKNAME}，你可有别的办法，能从哪位仙人处求问线索吗？",
            "nextDialogs": [
              "110280550"
            ]
          },
          "110280550": {
            "id": "110280550",
            "speakerId": 1002,
            "speakerName": "长生",
            "text": "——仙人哪是想见就能见的？这群老家伙，个个恨不得一辈子不见人…"
          }
        }
      }
    },
    {
      "subId": "1102812",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "110281201"
        ],
        "dialogs": {
          "110281201": {
            "id": "110281201",
            "speakerId": 2103,
            "speakerName": "阿桂",
            "text": "师父您打算出发了吗？",
            "nextDialogs": [
              "110281202"
            ]
          },
          "110281202": {
            "id": "110281202",
            "speakerId": 10234,
            "speakerName": "白术",
            "text": "嗯，我不在的时间里，不卜庐就交给你和七七照看了。",
            "nextDialogs": [
              "110281203"
            ]
          },
          "110281203": {
            "id": "110281203",
            "speakerId": 2103,
            "speakerName": "阿桂",
            "text": "放心吧师父，万一有什么情况，我会马上去通知你的。"
          }
        }
      }
    },
    {
      "subId": "1102813",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "110281301"
        ],
        "dialogs": {
          "110281301": {
            "id": "110281301",
            "speakerId": 10233,
            "speakerName": "七七",
            "text": "呼…她终于走了，不会再，回来吧…"
          }
        }
      }
    },
    {
      "subId": "1102814",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "110281401"
        ],
        "dialogs": {
          "110281401": {
            "id": "110281401",
            "speakerId": 1021,
            "speakerName": "胡桃",
            "text": "唔…在这种地方都能碰上，还真巧啊。",
            "nextDialogs": [
              "110281402"
            ]
          },
          "110281402": {
            "id": "110281402",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "你在这里做什么？",
            "nextDialogs": [
              "110281403"
            ]
          },
          "110281403": {
            "id": "110281403",
            "speakerId": 1021,
            "speakerName": "胡桃",
            "text": "没什么啊？诗作到一半没灵感了到处逛逛而已…嗯嗯…「打草惊蛇去，烧钱引鬼来…」",
            "nextDialogs": [
              "110281405",
              "110281407"
            ]
          },
          "110281405": {
            "id": "110281405",
            "speakerId": 1021,
            "speakerName": "胡桃",
            "text": "反正有人会代我管账…唔，你这么一说，倒还真不能在这儿待太久…"
          },
          "110281407": {
            "id": "110281407",
            "speakerId": 1021,
            "speakerName": "胡桃",
            "text": "…你可别跟白术打小报告哦。"
          }
        }
      }
    },
    {
      "subId": "1102815",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "110281501"
        ],
        "dialogs": {
          "110281501": {
            "id": "110281501",
            "speakerId": 13136,
            "speakerName": "嘉良",
            "text": "唉，你妈妈都失踪好些日子了，我却只能留在这里…",
            "nextDialogs": [
              "110281502"
            ]
          },
          "110281502": {
            "id": "110281502",
            "speakerId": 13135,
            "speakerName": "阿雩",
            "text": "老爹，先别多想了，安心休息吧。我们都有好几年没这么说过话了。",
            "nextDialogs": [
              "110281503"
            ]
          },
          "110281503": {
            "id": "110281503",
            "speakerId": 13136,
            "speakerName": "嘉良",
            "text": "是啊，一晃眼，你都已经长这么大了…"
          }
        }
      }
    },
    {
      "subId": "1102816",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "110281601"
        ],
        "dialogs": {
          "110281601": {
            "id": "110281601",
            "speakerId": 10233,
            "speakerName": "七七",
            "text": "请，别担心。白先生，有办法…",
            "nextDialogs": [
              "110281602"
            ]
          },
          "110281602": {
            "id": "110281602",
            "speakerId": 13135,
            "speakerName": "阿雩",
            "text": "可是、可是…呜…"
          }
        }
      }
    },
    {
      "subId": "1102817",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "110281701"
        ],
        "dialogs": {
          "110281701": {
            "id": "110281701",
            "speakerId": 2103,
            "speakerName": "阿桂",
            "text": "白术师父正在内室治疗，还请耐心等待。"
          }
        }
      }
    },
    {
      "subId": "1102899",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "110289901"
        ],
        "dialogs": {
          "110289901": {
            "id": "110289901",
            "speakerId": 1002,
            "speakerName": "长生",
            "text": "#{NICKNAME}！派蒙！你们快过来——",
            "nextDialogs": [
              "110289903"
            ]
          },
          "110289903": {
            "id": "110289903",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "白术他…不会又想用长生的秘法…",
            "nextDialogs": [
              "110289904"
            ]
          },
          "110289904": {
            "id": "110289904",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "真的，没有别的办法了吗？"
          }
        }
      }
    }
  ]
}
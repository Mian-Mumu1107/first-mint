    {
      "subId": "7501102",
      "subQuestName": "探索浮岛",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "750110201"
        ],
        "dialogs": {
          "750110201": {
            "id": "750110201",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "唔，这已经是最后一个机关了吧…",
            "nextDialogs": [
              "750110202"
            ]
          },
          "750110202": {
            "id": "750110202",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "看上去和其他的机关也没什么区别嘛，奇科娅，你不会是被骗了吧？",
            "nextDialogs": [
              "750110203"
            ]
          },
          "750110203": {
            "id": "750110203",
            "speakerId": 1002,
            "speakerName": "#{REALNAME[ID(2)|SHOWHOST(true)]}",
            "text": "唔…",
            "nextDialogs": [
              "750110204"
            ]
          },
          "750110204": {
            "id": "750110204",
            "speakerId": 1000,
            "speakerName": "奇科娅",
            "text": "怎么会呢，对于古卷织物的解读啊，姐姐我可是很有信心…一些信心…呃，可是很有一点点信心的！",
            "nextDialogs": [
              "750110205"
            ]
          },
          "750110205": {
            "id": "750110205",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "信心被越说越小了！救救信心啊！",
            "nextDialogs": [
              "750110206"
            ]
          },
          "750110206": {
            "id": "750110206",
            "speakerId": 1000,
            "speakerName": "奇科娅",
            "text": "不过，这个应该不是最后一个机关，在我的印象里，机关的形状应该更大，也…更完整一点？",
            "nextDialogs": [
              "750110207"
            ]
          },
          "750110207": {
            "id": "750110207",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "「中空之岛」…",
            "nextDialogs": [
              "750110208"
            ]
          },
          "750110208": {
            "id": "750110208",
            "speakerId": 1000,
            "speakerName": "奇科娅",
            "text": "#听不懂啦，前途无量的{M#少年}{F#少女}，只是说出一个专有名词来，别人可是没法理解的。",
            "nextDialogs": [
              "750110209"
            ]
          },
          "750110209": {
            "id": "750110209",
            "speakerId": 1000,
            "speakerName": "奇科娅",
            "text": "…到底有宝藏还是没有宝藏，有秘药还是没有秘药，其实，试试看不就知道了。",
            "nextDialogs": [
              "750110210"
            ]
          },
          "750110210": {
            "id": "750110210",
            "speakerId": 1002,
            "speakerName": "#{REALNAME[ID(2)|SHOWHOST(true)]}",
            "text": "呀！",
            "nextDialogs": [
              "750110211"
            ]
          },
          "750110211": {
            "id": "750110211",
            "speakerId": 1000,
            "speakerName": "奇科娅",
            "text": "这次不行还有下次，这里不行还有其他的地方，只要试下去就会出现奇迹！",
            "nextDialogs": [
              "750110213",
              "750110215"
            ]
          },
          "750110213": {
            "id": "750110213",
            "speakerId": 1000,
            "speakerName": "奇科娅",
            "text": "我就当你是夸我咯！",
            "nextDialogs": [
              "750110216"
            ]
          },
          "750110216": {
            "id": "750110216",
            "speakerId": 1002,
            "speakerName": "#{REALNAME[ID(2)|SHOWHOST(true)]}",
            "text": "呀！",
            "nextDialogs": [
              "750110217"
            ]
          },
          "750110217": {
            "id": "750110217",
            "speakerId": 1000,
            "speakerName": "奇科娅",
            "text": "#嘿嘿，{REALNAME[ID(2)|SHOWHOST(true)]}也很兴奋嘛，来，{NICKNAME}，用燃素启动机关吧！"
          },
          "750110215": {
            "id": "750110215",
            "speakerId": 1000,
            "speakerName": "奇科娅",
            "text": "不许在这里泼冷水啦！"
          }
        }
      }
    },

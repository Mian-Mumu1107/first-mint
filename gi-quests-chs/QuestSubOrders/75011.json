    {
      "subId": "7501199",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "750119901"
        ],
        "dialogs": {
          "750119901": {
            "id": "750119901",
            "speakerId": 1000,
            "speakerName": "奇科娅",
            "text": "有点愉快呢，不如说，十分高兴…嘿嘿，没想到真的能够上到「浮土静界」。",
            "nextDialogs": [
              "750119902"
            ]
          },
          "750119902": {
            "id": "750119902",
            "speakerId": 1000,
            "speakerName": "奇科娅",
            "text": "本来以为自己能到下面的门前看看就差不多了…",
            "nextDialogs": [
              "750119903"
            ]
          },
          "750119903": {
            "id": "750119903",
            "speakerId": 1000,
            "speakerName": "奇科娅",
            "text": "#多亏了{NICKNAME}{M#少年}{F#少女}啊，不然偷偷跑出来一趟什么都没看到就太亏了。",
            "nextDialogs": [
              "750119904"
            ]
          },
          "750119904": {
            "id": "750119904",
            "speakerId": 1002,
            "speakerName": "#{REALNAME[ID(2)|SHOWHOST(true)]}",
            "text": "呀？",
            "nextDialogs": [
              "750119905"
            ]
          },
          "750119905": {
            "id": "750119905",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "欸…什么叫偷偷跑出来一趟？",
            "nextDialogs": [
              "750119906"
            ]
          },
          "750119906": {
            "id": "750119906",
            "speakerId": 1000,
            "speakerName": "奇科娅",
            "text": "是这样啦，我没有告诉部族里的朋友和亲人就出来了…",
            "nextDialogs": [
              "750119907"
            ]
          },
          "750119907": {
            "id": "750119907",
            "speakerId": 1000,
            "speakerName": "奇科娅",
            "text": "咦，我之前没跟你们说过吗？",
            "nextDialogs": [
              "750119908"
            ]
          },
          "750119908": {
            "id": "750119908",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "等等，这不就是离家出走嘛！",
            "nextDialogs": [
              "750119909"
            ]
          },
          "750119909": {
            "id": "750119909",
            "speakerId": 1000,
            "speakerName": "奇科娅",
            "text": "小孩才会离家出走，大人只是会突然消失啦。",
            "nextDialogs": [
              "750119910"
            ]
          },
          "750119910": {
            "id": "750119910",
            "speakerId": 1002,
            "speakerName": "#{REALNAME[ID(2)|SHOWHOST(true)]}",
            "text": "呀…嗯？",
            "nextDialogs": [
              "750119911"
            ]
          },
          "750119911": {
            "id": "750119911",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "#咦，{NICKNAME}，是我看错了吗，怎么感觉中间的部分，多出了一座浮岛？",
            "nextDialogs": [
              "750119912"
            ]
          },
          "750119912": {
            "id": "750119912",
            "speakerId": 1000,
            "speakerName": "奇科娅",
            "text": "没有看错，派蒙，那就是…「浮土静界」的中心。",
            "nextDialogs": [
              "750119913"
            ]
          },
          "750119913": {
            "id": "750119913",
            "speakerId": 1000,
            "speakerName": "奇科娅",
            "text": "啊，难道之前的镌光铭印，其实都是为了…",
            "nextDialogs": [
              "750119915"
            ]
          },
          "750119915": {
            "id": "750119915",
            "speakerId": 1000,
            "speakerName": "奇科娅",
            "text": "啊，小心！结果最终试炼果然还是战斗吗…",
            "nextDialogs": [
              "750119916"
            ]
          },
          "750119916": {
            "id": "750119916",
            "speakerId": 1002,
            "speakerName": "#{REALNAME[ID(2)|SHOWHOST(true)]}",
            "text": "呜呜…",
            "nextDialogs": [
              "750119917"
            ]
          },
          "750119917": {
            "id": "750119917",
            "speakerId": 1000,
            "speakerName": "奇科娅",
            "text": "#{NICKNAME}，要注意它们的拳头哦！"
          }
        }
      }
    }
  ]
}
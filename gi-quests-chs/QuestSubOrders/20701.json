    },
    {
      "subId": "2070101",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "207010101"
        ],
        "dialogs": {
          "207010101": {
            "id": "207010101",
            "speakerId": 1631,
            "speakerName": "齐格芙丽雅",
            "text": "肚子怎么又饿了…",
            "nextDialogs": [
              "207010102"
            ]
          },
          "207010102": {
            "id": "207010102",
            "speakerId": 1631,
            "speakerName": "齐格芙丽雅",
            "text": "咦，是你啊！太好了，你还记得我吗？",
            "nextDialogs": [
              "207010103"
            ]
          },
          "207010103": {
            "id": "207010103",
            "speakerId": 1631,
            "speakerName": "齐格芙丽雅",
            "text": "香菱，料理对决，是我呀，齐格芙丽雅！",
            "nextDialogs": [
              "207010104"
            ]
          },
          "207010104": {
            "id": "207010104",
            "speakerId": 1631,
            "speakerName": "齐格芙丽雅",
            "text": "嘿嘿，记起来了吗，你来得正好，我能不能…拜托你一件事…",
            "nextDialogs": [
              "207010105"
            ]
          },
          "207010105": {
            "id": "207010105",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "什么事？",
            "nextDialogs": [
              "207010106"
            ]
          },
          "207010106": {
            "id": "207010106",
            "speakerId": 1631,
            "speakerName": "齐格芙丽雅",
            "text": "你还记得，你上次做的那道「翡玉什锦袋」吗？",
            "nextDialogs": [
              "207010107"
            ]
          },
          "207010107": {
            "id": "207010107",
            "speakerId": 1631,
            "speakerName": "齐格芙丽雅",
            "text": "我一直记得那个味道，实在是太好吃了。",
            "nextDialogs": [
              "207010108"
            ]
          },
          "207010108": {
            "id": "207010108",
            "speakerId": 1631,
            "speakerName": "齐格芙丽雅",
            "text": "所以，我想要自己也来做一做看，但是…感觉做出来的味道始终都差一点点…",
            "nextDialogs": [
              "207010109"
            ]
          },
          "207010109": {
            "id": "207010109",
            "speakerId": 1631,
            "speakerName": "齐格芙丽雅",
            "text": "我觉得，只要再仔细品尝几次，我就能重现那个味道！",
            "nextDialogs": [
              "207010110"
            ]
          },
          "207010110": {
            "id": "207010110",
            "speakerId": 1631,
            "speakerName": "齐格芙丽雅",
            "text": "能不能拜托你，再把「翡玉什锦袋」做给我尝尝看？"
          }
        }
      }
    },
    {
      "subId": "2070104",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "207010401"
        ],
        "dialogs": {
          "207010401": {
            "id": "207010401",
            "speakerId": 1631,
            "speakerName": "齐格芙丽雅",
            "text": "太好了，总算可以再吃到你做的「翡玉什锦袋」了。",
            "nextDialogs": [
              "207010402"
            ]
          },
          "207010402": {
            "id": "207010402",
            "speakerId": 1631,
            "speakerName": "齐格芙丽雅",
            "text": "虽然我知道菜谱，也摸索清楚了做法，但就是一直还原不了你做的那种味道。",
            "nextDialogs": [
              "207010403"
            ]
          },
          "207010403": {
            "id": "207010403",
            "speakerId": 1631,
            "speakerName": "齐格芙丽雅",
            "text": "唉，要是你能多做几次「翡玉什锦袋」给我吃就好了，这道菜里，我还有很多细节想要弄清楚呢…"
          }
        }
      }
    },
    {
      "subId": "2070105",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "207010501"
        ],
        "dialogs": {
          "207010501": {
            "id": "207010501",
            "speakerId": 1631,
            "speakerName": "齐格芙丽雅",
            "text": "「翡玉什锦袋」做好了吗？"
          }
        }
      }
    }
  ]

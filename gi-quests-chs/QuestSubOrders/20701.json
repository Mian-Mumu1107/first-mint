      }
    },
    {
      "subId": "2070103",
      "subQuestName": "将「翡玉什锦袋」交给齐格芙丽雅",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "207010301"
        ],
        "dialogs": {
          "207010301": {
            "id": "207010301",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "不吃点别的吗？",
            "nextDialogs": [
              "207010302"
            ]
          },
          "207010302": {
            "id": "207010302",
            "speakerId": 1631,
            "speakerName": "齐格芙丽雅",
            "text": "唔…别的我也想吃，但要是什么都想吃，那就什么都吃不过来啦。",
            "nextDialogs": [
              "207010303"
            ]
          },
          "207010303": {
            "id": "207010303",
            "speakerId": 1631,
            "speakerName": "齐格芙丽雅",
            "text": "总之，我还是先弄清「翡玉什锦袋」的味道吧。"
          }
        }
      }
    },
    {
      "subId": "2070104",
      "subQuestName": "",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "207010502"
        ],
        "dialogs": {
          "207010502": {
            "id": "207010502",
            "speakerId": 1631,
            "speakerName": "齐格芙丽雅",
            "text": "…啊，已经吃完了。",
            "nextDialogs": [
              "207010503"
            ]
          },
          "207010503": {
            "id": "207010503",
            "speakerId": 1631,
            "speakerName": "齐格芙丽雅",
            "text": "那个蔬菜的口感…火腿和莲子之间的味道搭配…还有这个高汤…",
            "nextDialogs": [
              "207010504"
            ]
          },
          "207010504": {
            "id": "207010504",
            "speakerId": 1631,
            "speakerName": "齐格芙丽雅",
            "text": "就是这个味道，这就是我上次吃到的味道！",
            "nextDialogs": [
              "207010531"
            ]
          },
          "207010531": {
            "id": "207010531",
            "speakerId": 1631,
            "speakerName": "齐格芙丽雅",
            "text": "谢谢你专门过来给我做菜，我要赶紧回去做笔记了。",
            "nextDialogs": [
              "207010532"
            ]
          },
          "207010532": {
            "id": "207010532",
            "speakerId": 1631,
            "speakerName": "齐格芙丽雅",
            "text": "下次，我一定能做出完美的「翡玉什锦袋」。",
            "nextDialogs": [
              "207010533"
            ]
          },
          "207010533": {
            "id": "207010533",
            "speakerId": 1631,
            "speakerName": "齐格芙丽雅",
            "text": "到时候，你一定要来尝尝看啊。"
          }
        }
      }
    },
    {
      "subId": "2070105",
      "subQuestName": "",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "207010510"
        ],
        "dialogs": {
          "207010510": {
            "id": "207010510",
            "speakerId": 1631,
            "speakerName": "齐格芙丽雅",
            "text": "这火腿的鲜味，蔬菜的口感也刚刚好，还有这微微的辣味…",
            "nextDialogs": [
              "207010511"
            ]
          },
          "207010511": {
            "id": "207010511",
            "speakerId": 1631,
            "speakerName": "齐格芙丽雅",
            "text": "嗯，味道真不错，是一份很不错的「翡玉什锦袋」呢！"
          }
        }
      }
    },
    {
      "subId": "2070106",
      "subQuestName": "",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "207010520"
        ],
        "dialogs": {
          "207010520": {
            "id": "207010520",
            "speakerId": 1631,
            "speakerName": "齐格芙丽雅",
            "text": "唔…菜叶的口感好干…里面好像还有食材没熟透…",
            "nextDialogs": [
              "207010521"
            ]
          },
          "207010521": {
            "id": "207010521",
            "speakerId": 1631,
            "speakerName": "齐格芙丽雅",
            "text": "和之前吃到的味道差太多了…难道，这是你琢磨出的什么新做法？",
            "nextDialogs": [
              "207010522"
            ]
          },
          "207010522": {
            "id": "207010522",
            "speakerId": 1631,
            "speakerName": "齐格芙丽雅",
            "text": "总感觉这道菜味道有些不对…不过，也可以作为参考。"
          }
        }
      }
    },
    {
      "subId": "2070107",
      "subQuestName": "与齐格芙丽雅对话",
      "sceneId": null,
      "locations": [],

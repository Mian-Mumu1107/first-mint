  "subQuests": [
    {
      "subId": "2070101",
      "subQuestName": "与齐格芙丽雅对话",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "207010201"
        ],
        "dialogs": {
          "207010201": {
            "id": "207010201",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "交给我吧。",
            "nextDialogs": [
              "207010202"
            ]
          },
          "207010202": {
            "id": "207010202",
            "speakerId": 1631,
            "speakerName": "齐格芙丽雅",
            "text": "太好了！那就拜托你了，我就在这等着你！",
            "nextDialogs": [
              "207010203"
            ]
          },
          "207010203": {
            "id": "207010203",
            "speakerId": 1631,
            "speakerName": "齐格芙丽雅",
            "text": "嘿嘿，「翡玉什锦袋」…又可以吃到了…"
          }
        }
      }
    },
    {
      "subId": "2070102",
      "subQuestName": "制作翡玉什锦袋",
      "sceneId": null,

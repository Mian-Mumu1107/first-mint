        "dialogs": {
          "739160101": {
            "id": "739160101",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "身边的景色…",
            "nextDialogs": [
              "739160102"
            ]
          },
          "739160102": {
            "id": "739160102",
            "speakerId": 4166,
            "speakerName": "拜伊",
            "text": "我年轻时常年随着船队奔波各地，最懂得珍惜身边的每一滴水、每一朵花。",
            "nextDialogs": [
              "739160103"
            ]
          },
          "739160103": {
            "id": "739160103",
            "speakerId": 4166,
            "speakerName": "拜伊",
            "text": "无论是汹涌的海浪，翱翔的海鸥，还是岸边飘摇的海草，都是万物生长的证明。",
            "nextDialogs": [
              "739160104"
            ]
          },
          "739160104": {
            "id": "739160104",
            "speakerId": 4166,
            "speakerName": "拜伊",
            "text": "等你见过的东西和我一样多时，自然也就明白这个道理了——可不能像那个老东西一样没出息啊！"
          }
        }
      }
    }
  ]

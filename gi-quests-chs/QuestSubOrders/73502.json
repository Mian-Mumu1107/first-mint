      }
    },
    {
      "subId": "7350206",
      "subQuestName": "",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "735020601"
        ],
        "dialogs": {
          "735020601": {
            "id": "735020601",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "「无镜之镜，照见诸戏。」",
            "nextDialogs": [
              "735020602"
            ]
          },
          "735020602": {
            "id": "735020602",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "照见诸戏，原来指的是这个大剧场啊…",
            "nextDialogs": [
              "735020603"
            ]
          },
          "735020603": {
            "id": "735020603",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "无镜之镜，指的是剧院后面那个池塘…",
            "nextDialogs": [
              "735020604"
            ]
          },
          "735020604": {
            "id": "735020604",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "这地方一点都不厉害啊！为什么要用看上去那么厉害的谜语，形容这么一个普普通通的地方啦！",
            "nextDialogs": [
              "735020605"
            ]
          },
          "735020605": {
            "id": "735020605",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "这箱子里还有纸条喔。",
            "nextDialogs": [
              "735020606"
            ]
          },
          "735020606": {
            "id": "735020606",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "又是谜语吗？这是什么连环解谜啊…",
            "nextDialogs": [
              "735020607"
            ]
          },
          "735020607": {
            "id": "735020607",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "「通往知识的必经之路。」",
            "nextDialogs": [
              "735020608"
            ]
          },
          "735020608": {
            "id": "735020608",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "这个看上去…好像没什么难度…",
            "nextDialogs": [
              "735020609"
            ]
          },
          "735020609": {
            "id": "735020609",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "毕竟，在须弥城里能够代表「知识」的地方，也只有那里了呢…"
          }
        }
      }
    },
    {
      "subId": "7350203",
      "subQuestName": "（test）跟最终NPC对话$HIDDEN",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "735020301"
        ],
        "dialogs": {
          "735020301": {
            "id": "735020301",
            "speakerId": 1004,
            "speakerName": "德鲁苏",
            "text": "今天也没人来吗…",
            "nextDialogs": [
              "735020302"
            ]
          },
          "735020302": {
            "id": "735020302",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "这就是「知识殿堂的正门」吗？",
            "nextDialogs": [
              "735020303"
            ]
          },
          "735020303": {
            "id": "735020303",
            "speakerId": 1004,
            "speakerName": "德鲁苏",
            "text": "没错！这里就是「知识殿堂的正门」，您…看来是解开了我所有的谜语啊。",
            "nextDialogs": [
              "735020304"
            ]
          },
          "735020304": {
            "id": "735020304",
            "speakerId": 1004,
            "speakerName": "德鲁苏",
            "text": "太好了！我还以为今天也没人能做到这件事呢！再等一会我可就要回去吃午饭了…",
            "nextDialogs": [
              "735020305"
            ]
          },
          "735020305": {
            "id": "735020305",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "你为什么要写这些谜语？",
            "nextDialogs": [
              "735020306"
            ]
          },
          "735020306": {
            "id": "735020306",
            "speakerId": 1004,
            "speakerName": "德鲁苏",
            "text": "当然是因为「有趣」啊。",
            "nextDialogs": [
              "735020307"
            ]
          },
          "735020307": {
            "id": "735020307",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "回答得好快！",
            "nextDialogs": [
              "735020308"
            ]
          },
          "735020308": {
            "id": "735020308",
            "speakerId": 1004,
            "speakerName": "德鲁苏",
            "text": "除了这个理由之外，你们觉得我又为什么会写下这些谜语呢？",
            "nextDialogs": [
              "735020309"
            ]
          },
          "735020309": {
            "id": "735020309",
            "speakerId": 1004,
            "speakerName": "德鲁苏",
            "text": "难道你们以为，我就是单纯地在享受刁难人的感觉吗？",
            "nextDialogs": [
              "735020312"
            ]
          },
          "735020312": {
            "id": "735020312",
            "speakerId": 1004,
            "speakerName": "德鲁苏",
            "text": "哈哈哈，那你们就和教令院里的某些人一样误解我了。",
            "nextDialogs": [
              "735020313"
            ]
          },
          "735020313": {
            "id": "735020313",
            "speakerId": 1004,
            "speakerName": "德鲁苏",
            "text": "我之所以写下这些谜语，就是单纯地喜爱解读谜语时的那种思辨感。",
            "nextDialogs": [
              "735020314"
            ]
          },
          "735020314": {
            "id": "735020314",
            "speakerId": 1004,
            "speakerName": "德鲁苏",
            "text": "你们现在回过头来看我的谜语，里面总是有一个能够解开谜语的「关键词」。",
            "nextDialogs": [
              "735020315"
            ]
          },
          "735020315": {
            "id": "735020315",
            "speakerId": 1004,
            "speakerName": "德鲁苏",
            "text": "只要以这个关键词为突破口不断思考，就一定能解开谜语。",
            "nextDialogs": [
              "735020316"
            ]
          },
          "735020316": {
            "id": "735020316",
            "speakerId": 1004,
            "speakerName": "德鲁苏",
            "text": "如果我是单纯地想要刁难人，那我只要抹去一切线索，把这段谜语变成真正的「无解之题」就好了。",
            "nextDialogs": [
              "735020317"
            ]
          },
          "735020317": {
            "id": "735020317",
            "speakerId": 1004,
            "speakerName": "德鲁苏",
            "text": "先不说这些了，既然你们解开了我所有的谜语，那这些东西你们就拿着吧。",
            "nextDialogs": [
              "735020318"
            ]
          },
          "735020318": {
            "id": "735020318",
            "speakerId": 1004,
            "speakerName": "德鲁苏",
            "text": "这是你们用自己的「思辨」赢来的奖励，可要收好了啊。"
          }
        }
      }
    }
  ]
}
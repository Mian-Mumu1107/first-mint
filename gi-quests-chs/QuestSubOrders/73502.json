    {
      "subId": "7350204",
      "subQuestName": "(test)控制学院宝箱开启$HIDDEN",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "735020401"
        ],
        "dialogs": {
          "735020401": {
            "id": "735020401",
            "speakerId": 1004,
            "speakerName": "德鲁苏",
            "text": "（test）时间不对，按照纸条的时间来！"
          }
        }
      }
    },
    {
      "subId": "7350205",
      "subQuestName": "(test)控制荷花宝箱开启$HIDDEN",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "735020501"
        ],
        "dialogs": {
          "735020501": {
            "id": "735020501",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "「刚吃过早餐的正午，与白昼交班的白昼。」",
            "nextDialogs": [
              "735020502"
            ]
          },
          "735020502": {
            "id": "735020502",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "原来…意思就是：在大中午的时候去灯塔顶上啊！",
            "nextDialogs": [
              "735020503"
            ]
          },
          "735020503": {
            "id": "735020503",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "费了这么大的劲！原来就这么简单啊！",
            "nextDialogs": [
              "735020504"
            ]
          },
          "735020504": {
            "id": "735020504",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "算了，能找到宝藏就好…快看看箱子里有什么吧。",
            "nextDialogs": [
              "735020505"
            ]
          },
          "735020505": {
            "id": "735020505",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "这还有一张纸条…",
            "nextDialogs": [
              "735020506"
            ]
          },
          "735020506": {
            "id": "735020506",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "欸？上面写着什么？给我看看。",
            "nextDialogs": [
              "735020507"
            ]
          },
          "735020507": {
            "id": "735020507",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "「无镜之镜，照见诸戏。」",
            "nextDialogs": [
              "735020508"
            ]
          },
          "735020508": {
            "id": "735020508",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "难道，这是在暗示下一个藏宝地吗？",
            "nextDialogs": [
              "735020509"
            ]
          },
          "735020509": {
            "id": "735020509",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "这里面提到了「戏」，难道是说宝藏的所在地和「剧场」有关吗？",
            "nextDialogs": [
              "735020510"
            ]
          },
          "735020510": {
            "id": "735020510",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "不明白…但感觉上，好像是在暗示一个很厉害的地方啊。"
          }
        }
      }
    },
    {
      "subId": "7350202",
      "subQuestName": "（test）获得全部小信物$HIDDEN",
      "sceneId": null,
      "locations": [],

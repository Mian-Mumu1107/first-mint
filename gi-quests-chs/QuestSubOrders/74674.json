  "subQuests": [
    {
      "subId": "7467401",
      "subQuestName": "与乌尔曼对话",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "746740101"
        ],
        "dialogs": {
          "746740101": {
            "id": "746740101",
            "speakerId": 1000,
            "speakerName": "乌尔曼",
            "text": "古铁钱…古铁钱…不错，非常不错！",
            "nextDialogs": [
              "746740102"
            ]
          },
          "746740102": {
            "id": "746740102",
            "speakerId": 1000,
            "speakerName": "乌尔曼",
            "text": "#这么多古铁钱，肯定够我赚一笔小钱，多谢你们了啊，{NICKNAME}，还有派蒙。",
            "nextDialogs": [
              "746740103"
            ]
          },
          "746740103": {
            "id": "746740103",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "你接下来准备做什么？",
            "nextDialogs": [
              "746740104"
            ]
          },
          "746740104": {
            "id": "746740104",
            "speakerId": 1000,
            "speakerName": "乌尔曼",
            "text": "当然是…想想怎么把这些古铁钱换成一些摩拉，或者是其他方便日常使用的东西。",
            "nextDialogs": [
              "746740105"
            ]
          },
          "746740105": {
            "id": "746740105",
            "speakerId": 1000,
            "speakerName": "乌尔曼",
            "text": "说真的，我真不想和之前那个中间人再做纠缠了，他每次的抽成都高的吓人。",
            "nextDialogs": [
              "746740106"
            ]
          },
          "746740106": {
            "id": "746740106",
            "speakerId": 1000,
            "speakerName": "乌尔曼",
            "text": "而且，钱到我手里的时间也非常晚，真不知道他在做什么…",
            "nextDialogs": [
              "746740107"
            ]
          },
          "746740107": {
            "id": "746740107",
            "speakerId": 1000,
            "speakerName": "乌尔曼",
            "text": "不过…我现在除了他之外，也根本找不到其他靠谱的人合作，唉…",
            "nextDialogs": [
              "746740108"
            ]
          },
          "746740108": {
            "id": "746740108",
            "speakerId": 1000,
            "speakerName": "乌尔曼",
            "text": "不说这些了！这些东西给你们，算是咱们长期合作的额外雇佣金吧。",
            "nextDialogs": [
              "746740109"
            ]
          },
          "746740109": {
            "id": "746740109",
            "speakerId": 1000,
            "speakerName": "乌尔曼",
            "text": "等枫丹的生意结束，我也要想想下一步怎么走了。总不能继续旅行吧…那也太累了…"
          }
        }
      }
    }
  ]
}
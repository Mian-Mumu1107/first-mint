    {
      "subId": "7014125",
      "subQuestName": "（test）派蒙对话$HIDDEN",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "701419701"
        ],
        "dialogs": {
          "701419701": {
            "id": "701419701",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "呜哇！有什么东西飞起来了，好像…是往山顶那边飞了。",
            "nextDialogs": [
              "701419702"
            ]
          },
          "701419702": {
            "id": "701419702",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "要去山顶附近看看吗？或者说…还是先回去找人问问情况？"
          }
        }
      }
    },
    {
      "subId": "7014126",
      "subQuestName": "继续向上调查",
      "sceneId": null,
      "locations": [],

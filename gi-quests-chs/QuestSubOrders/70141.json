      }
    },
    {
      "subId": "7014130",
      "subQuestName": "（test）派蒙对话$HIDDEN",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "701419501"
        ],
        "dialogs": {
          "701419501": {
            "id": "701419501",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "好…好…好冷…要被冻成冰块了…",
            "nextDialogs": [
              "701419502"
            ]
          },
          "701419502": {
            "id": "701419502",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "这里到底…到底是什么情况啊…",
            "nextDialogs": [
              "701419503"
            ]
          },
          "701419503": {
            "id": "701419503",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "我们…我们还是去山脚下的营地里找人问问吧…"
          }
        }
      }
    },
    {
      "subId": "7014127",
      "subQuestName": "向玉霞回报",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "701411201"
        ],
        "dialogs": {
          "701411201": {
            "id": "701411201",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "这座雪山可真危险…",
            "nextDialogs": [
              "701411202"
            ]
          },
          "701411202": {
            "id": "701411202",
            "speakerId": 1000,
            "speakerName": "玉霞",
            "text": "嗯？你回来了，怎么样，看到那些冰了吧，呃…你怎么这么一副样子…",
            "nextDialogs": [
              "701411203"
            ]
          },
          "701411203": {
            "id": "701411203",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "关于洞窟中的气流…",
            "nextDialogs": [
              "701411204"
            ]
          },
          "701411204": {
            "id": "701411204",
            "speakerId": 1000,
            "speakerName": "玉霞",
            "text": "你已经到那么高的地方了？你还真是厉害啊。不过…被奇怪气流封堵的洞窟？唔，我想想…",
            "nextDialogs": [
              "701411205"
            ]
          },
          "701411205": {
            "id": "701411205",
            "speakerId": 1000,
            "speakerName": "玉霞",
            "text": "哦…我想起来了，之前有一支冒险队运气好，一直探索到了山顶附近。",
            "nextDialogs": [
              "701411206"
            ]
          },
          "701411206": {
            "id": "701411206",
            "speakerId": 1000,
            "speakerName": "玉霞",
            "text": "虽然他们还是没能靠太近，但是据他们说，山顶附近的一个洞窟里确实有一股奇怪的强气流涌出…",
            "nextDialogs": [
              "701411207"
            ]
          },
          "701411207": {
            "id": "701411207",
            "speakerId": 1000,
            "speakerName": "玉霞",
            "text": "但按道理来说，那种地方即使有气流，也不该那么强才对，到现在也没人能找出原因…",
            "nextDialogs": [
              "701411208"
            ]
          },
          "701411208": {
            "id": "701411208",
            "speakerId": 1000,
            "speakerName": "玉霞",
            "text": "而且除了那股奇怪的气流之外，雪山中还有一些奇怪的冰。",
            "nextDialogs": [
              "701411209"
            ]
          },
          "701411209": {
            "id": "701411209",
            "speakerId": 1000,
            "speakerName": "玉霞",
            "text": "那些冰难以击碎，用火烤也不会融化，对我们的探索造成了很大的阻碍。",
            "nextDialogs": [
              "701411210"
            ]
          },
          "701411210": {
            "id": "701411210",
            "speakerId": 1000,
            "speakerName": "玉霞",
            "text": "我们也一直找不到对付那些冰的办法，只能尽量绕开走…",
            "nextDialogs": [
              "701411211"
            ]
          },
          "701411211": {
            "id": "701411211",
            "speakerId": 1000,
            "speakerName": "玉霞",
            "text": "而且在一些冰旁边，还生长着许多蓝色的植物。",
            "nextDialogs": [
              "701411212"
            ]
          },
          "701411212": {
            "id": "701411212",
            "speakerId": 1000,
            "speakerName": "玉霞",
            "text": "虽然我能隐约看见那些冰里似乎冻着什么，但我也没办法让那些冰解冻，也只能看看罢了…",
            "nextDialogs": [
              "701411213"
            ]
          },
          "701411213": {
            "id": "701411213",
            "speakerId": 1000,
            "speakerName": "玉霞",
            "text": "你有兴趣的话，可以循着那种蓝色植物，去看看那些冰。",
            "nextDialogs": [
              "701411214"
            ]
          },
          "701411214": {
            "id": "701411214",
            "speakerId": 1000,
            "speakerName": "玉霞",
            "text": "嗯…我想想，<color=#00E1FFFF>「雪葬之都·近郊」</color>和<color=#00E1FFFF>「星荧洞窟」</color>周围就长着很多那种植物，你可以去那里看看。",
            "nextDialogs": [
              "701411215"
            ]
          },
          "701411215": {
            "id": "701411215",
            "speakerId": 1000,
            "speakerName": "玉霞",
            "text": "奇怪的强气流、和奇怪的冰，还有奇怪的植物…",
            "nextDialogs": [
              "701411216"
            ]
          },
          "701411216": {
            "id": "701411216",
            "speakerId": 1000,
            "speakerName": "玉霞",
            "text": "哈哈哈，要是在一般的探险故事里，这三者之间说不定会有什么关联。",
            "nextDialogs": [
              "701411217"
            ]
          },
          "701411217": {
            "id": "701411217",
            "speakerId": 1000,
            "speakerName": "玉霞",
            "text": "但在现实里，探险还是要脚踏实地…你要进雪山的话，记得也要做好充足的准备啊。"
          }
        }
      }
    },

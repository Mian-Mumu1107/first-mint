    {
      "subId": "7014106",
      "subQuestName": "（test）发现通往山顶的封印$HIDDEN",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "701410601"
        ],
        "dialogs": {
          "701410601": {
            "id": "701410601",
            "speakerId": 1000,
            "speakerName": "玉霞",
            "text": "这里的情况可真是棘手…",
            "nextDialogs": [
              "701410602"
            ]
          },
          "701410602": {
            "id": "701410602",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "关于雪山的情况…",
            "nextDialogs": [
              "701410603"
            ]
          },
          "701410603": {
            "id": "701410603",
            "speakerId": 1000,
            "speakerName": "玉霞",
            "text": "雪山的情况？我只能说，这里的环境比蒙德任何地方都要凶险。",
            "nextDialogs": [
              "701410604"
            ]
          },
          "701410604": {
            "id": "701410604",
            "speakerId": 1000,
            "speakerName": "玉霞",
            "text": "除了恶劣的环境之外，这座山里还有一些奇怪的…冰。",
            "nextDialogs": [
              "701410605"
            ]
          },
          "701410605": {
            "id": "701410605",
            "speakerId": 1000,
            "speakerName": "玉霞",
            "text": "那些冰难以击碎，用火烤也不会融化，对我们的探索造成了很大的阻碍。",
            "nextDialogs": [
              "701410606"
            ]
          },
          "701410606": {
            "id": "701410606",
            "speakerId": 1000,
            "speakerName": "玉霞",
            "text": "但是，我们也一直找不到对付那些冰的办法，只能尽量绕开走…",
            "nextDialogs": [
              "701410607"
            ]
          },
          "701410607": {
            "id": "701410607",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "我想去看看那些冰。",
            "nextDialogs": [
              "701410608"
            ]
          },
          "701410608": {
            "id": "701410608",
            "speakerId": 1000,
            "speakerName": "玉霞",
            "text": "你只是想去看看那些冰吧？我记得雪山的外围也有一大块类似的冰，不知道里面冻着什么…",
            "nextDialogs": [
              "701410609"
            ]
          },
          "701410609": {
            "id": "701410609",
            "speakerId": 1000,
            "speakerName": "玉霞",
            "text": "你可以去那附近看一看，不过记住，千万不要再往里走了。"
          }
        }
      }
    },

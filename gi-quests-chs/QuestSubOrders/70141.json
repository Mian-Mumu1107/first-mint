    {
      "subId": "7014109",
      "subQuestName": "（test）古树碎片进度记录$HIDDEN",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "701410901"
        ],
        "dialogs": {
          "701410901": {
            "id": "701410901",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "关于那些冰…",
            "nextDialogs": [
              "701410902"
            ]
          },
          "701410902": {
            "id": "701410902",
            "speakerId": 1000,
            "speakerName": "玉霞",
            "text": "不知道你注意到没有，在那块冰的周围，生长着很多蓝色的植物。",
            "nextDialogs": [
              "701410903"
            ]
          },
          "701410903": {
            "id": "701410903",
            "speakerId": 1000,
            "speakerName": "玉霞",
            "text": "我在想，这些植物说不定和那块被冻在冰里的碎片有所关联…",
            "nextDialogs": [
              "701410904"
            ]
          },
          "701410904": {
            "id": "701410904",
            "speakerId": 1000,
            "speakerName": "玉霞",
            "text": "如果你想要在雪山里继续寻找那些碎片的话，也许，你可以循着那些蓝色植物找找看。",
            "nextDialogs": [
              "701410905"
            ]
          },
          "701410905": {
            "id": "701410905",
            "speakerId": 1000,
            "speakerName": "玉霞",
            "text": "在<color=#00E1FFFF>「雪葬之都·近郊」</color>和<color=#00E1FFFF>「星荧洞窟」</color>附近，我记得有很多这种植物，你不妨去那里看看，说不定会有什么收获。"
          }
        }
      }
    },

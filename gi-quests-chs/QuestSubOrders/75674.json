{
  "lineCounts": {
    "Player": 6,
    "努斯妲": 14,
    "昂吉安妮": 18,
    "派蒙": 9
  },
  "subQuests": [
    {
      "subId": "7567401",
      "subQuestName": "前往悠悠度假村",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "756740101"
        ],
        "dialogs": {
          "756740101": {
            "id": "756740101",
            "speakerId": 31075,
            "speakerName": "昂吉安妮",
            "text": "如此如此…这般这般…小贼们肯定会跪地哭号…",
            "nextDialogs": [
              "756740102"
            ]
          },
          "756740102": {
            "id": "756740102",
            "speakerId": 31075,
            "speakerName": "昂吉安妮",
            "text": "这种时候「失误放跑」一个小贼，他肯定会惊恐地回去通风报信，你再悄悄尾随…",
            "nextDialogs": [
              "756740103"
            ]
          },
          "756740103": {
            "id": "756740103",
            "speakerId": 31075,
            "speakerName": "昂吉安妮",
            "text": "就能在小贼们商量对策的时候，踹开他们老巢的大门，给他们恐怖映影般的惊吓！",
            "nextDialogs": [
              "756740104"
            ]
          },
          "756740104": {
            "id": "756740104",
            "speakerId": 31091,
            "speakerName": "努斯妲",
            "text": "您说得很有道理，昂吉安妮小姐。对付油盐不进的恶人，的确要用超出常理的手段。",
            "nextDialogs": [
              "756740105"
            ]
          },
          "756740105": {
            "id": "756740105",
            "speakerId": 31091,
            "speakerName": "努斯妲",
            "text": "纳塔不像枫丹，有那么繁琐…咳，「严格的执法程序」！我会好好利用这个优势。",
            "nextDialogs": [
              "756740106"
            ]
          },
          "756740106": {
            "id": "756740106",
            "speakerId": 31091,
            "speakerName": "努斯妲",
            "text": "之前我抓到了几个漏网的龙贩子，就用您说的办法，再把北边的走私犯也一窝端掉。",
            "nextDialogs": [
              "756740107"
            ]
          },
          "756740107": {
            "id": "756740107",
            "speakerId": 31075,
            "speakerName": "昂吉安妮",
            "text": "到时候记得给我捷报哦，我超期待的！",
            "nextDialogs": [
              "756740108"
            ]
          },
          "756740108": {
            "id": "756740108",
            "speakerId": 31075,
            "speakerName": "昂吉安妮",
            "text": "嗨呀…现在我不再是执律庭的成员了，按照保密条例，蒂蕾娜也不能向我汇报她的工作情况。",
            "nextDialogs": [
              "756740109"
            ]
          },
          "756740109": {
            "id": "756740109",
            "speakerId": 31075,
            "speakerName": "昂吉安妮",
            "text": "总感觉，自己还有一些本领没和有需要的人分享…要不要，干脆写一本回忆录？",
            "nextDialogs": [
              "756740110"
            ]
          },
          "756740110": {
            "id": "756740110",
            "speakerId": 31075,
            "speakerName": "昂吉安妮",
            "text": "嗯，只对各国执法人员发售的回忆录！我这150年的工作经验应该能帮上忙。",
            "nextDialogs": [
              "756740111"
            ]
          },
          "756740111": {
            "id": "756740111",
            "speakerId": 31091,
            "speakerName": "努斯妲",
            "text": "我支持！等你好好享受这次派对，玩得身心舒畅，创作起来肯定也必定更顺利…",
            "nextDialogs": [
              "756740112"
            ]
          },
          "756740112": {
            "id": "756740112",
            "speakerId": 31091,
            "speakerName": "努斯妲",
            "text": "到时候请给我留一本签名版的！",
            "nextDialogs": [
              "756740113"
            ]
          },
          "756740113": {
            "id": "756740113",
            "speakerId": 31075,
            "speakerName": "昂吉安妮",
            "text": "第一个送你！这次跳舞跳个尽兴，我回去就租一台打字机，立刻开写！",
            "nextDialogs": [
              "756740114"
            ]
          },
          "756740114": {
            "id": "756740114",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "美露莘和…努斯妲？",
            "nextDialogs": [
              "756740115"
            ]
          },
          "756740115": {
            "id": "756740115",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "又一对没想过的组合，在聊什么呢？",
            "nextDialogs": [
              "756740118"
            ]
          },
          "756740118": {
            "id": "756740118",
            "speakerId": 31091,
            "speakerName": "努斯妲",
            "text": "好呀，我们的「杜麦尼」登场了！领舞者就位，派对进入正题！",
            "nextDialogs": [
              "756740119"
            ]
          },
          "756740119": {
            "id": "756740119",
            "speakerId": 31091,
            "speakerName": "努斯妲",
            "text": "当务之急是告诉你们特大好消息——我们第二次「舞力聚会」已经开始了！",
            "nextDialogs": [
              "756740120"
            ]
          },
          "756740120": {
            "id": "756740120",
            "speakerId": 31091,
            "speakerName": "努斯妲",
            "text": "还有全新的参与者：来自枫丹旅游团的昂吉安妮小姐，和她的三位伙伴！",
            "nextDialogs": [
              "756740121"
            ]
          },
          "756740121": {
            "id": "756740121",
            "speakerId": 31091,
            "speakerName": "努斯妲",
            "text": "另外，多亏「乌沙博蒂」卡齐娜和蒙德的偶像小姐，枫丹客人和这边的阿夏都学会了全新的舞步！",
            "nextDialogs": [
              "756740122"
            ]
          },
          "756740122": {
            "id": "756740122",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "等等等等，信息一下子接受得太多了…",
            "nextDialogs": [
              "756740123"
            ]
          },
          "756740123": {
            "id": "756740123",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "意思是，除了之前跳舞的大家和小龙，还有美露莘和…阿夏？",
            "nextDialogs": [
              "756740124"
            ]
          },
          "756740124": {
            "id": "756740124",
            "speakerId": 31091,
            "speakerName": "努斯妲",
            "text": "对哦！所以我们能在更新更欢快的音乐里，跳出更尽兴的舞蹈。",
            "nextDialogs": [
              "756740125"
            ]
          },
          "756740125": {
            "id": "756740125",
            "speakerId": 31091,
            "speakerName": "努斯妲",
            "text": "作为领舞的「杜麦尼」也能展现自己对所有节拍的适应力！"
          }
        }
      }
    },
    {
      "subId": "7567499",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "756749901"
        ],
        "dialogs": {
          "756749901": {
            "id": "756749901",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "纳塔的讯使在冒险家协会留了言，说是「流泉之众」、「回声之子」和「花羽会」正在悠悠度假村举办派对。",
            "nextDialogs": [
              "756749902"
            ]
          },
          "756749902": {
            "id": "756749902",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "有种熟悉的感觉呢…应该会非常好玩！我们抽空过去看看吧？"
          }
        }
      }
    }
  ]
}
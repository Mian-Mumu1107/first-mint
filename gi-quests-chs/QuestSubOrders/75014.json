    {
      "subId": "7501412",
      "subQuestName": "准备前往营地",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "750141201"
        ],
        "dialogs": {
          "750141201": {
            "id": "750141201",
            "speakerId": 1002,
            "speakerName": "葵莉娅",
            "text": "咦？小家伙，你是迷路了吗？",
            "nextDialogs": [
              "750141202"
            ]
          },
          "750141202": {
            "id": "750141202",
            "speakerId": 1003,
            "speakerName": "#{REALNAME[ID(2)|SHOWHOST(true)]}",
            "text": "呀！呀呀！",
            "nextDialogs": [
              "750141203"
            ]
          },
          "750141203": {
            "id": "750141203",
            "speakerId": 1002,
            "speakerName": "葵莉娅",
            "text": "很有活力，看起来很健康。角上有特别的花纹…真不错。",
            "nextDialogs": [
              "750141204"
            ]
          },
          "750141204": {
            "id": "750141204",
            "speakerId": 1002,
            "speakerName": "葵莉娅",
            "text": "不过你们为什么会一起出现在这里？是我的管教出了问题？不，这不可能。",
            "nextDialogs": [
              "750141205"
            ]
          },
          "750141205": {
            "id": "750141205",
            "speakerId": 1003,
            "speakerName": "#{REALNAME[ID(2)|SHOWHOST(true)]}",
            "text": "唔？呀呀！",
            "nextDialogs": [
              "750141206"
            ]
          },
          "750141206": {
            "id": "750141206",
            "speakerId": 1002,
            "speakerName": "葵莉娅",
            "text": "嗯？它怎么了？是它带你来的？",
            "nextDialogs": [
              "750141207"
            ]
          },
          "750141207": {
            "id": "750141207",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "（不能被她发现…）",
            "nextDialogs": [
              "750141210"
            ]
          },
          "750141210": {
            "id": "750141210",
            "speakerId": 1002,
            "speakerName": "葵莉娅",
            "text": "怎么会发出这么奇怪的叫声，难道是生病了？行为也有反常的地方，看来得好好检查一下。",
            "nextDialogs": [
              "750141211"
            ]
          },
          "750141211": {
            "id": "750141211",
            "speakerId": 1003,
            "speakerName": "#{REALNAME[ID(2)|SHOWHOST(true)]}",
            "text": "呀！",
            "nextDialogs": [
              "750141212"
            ]
          },
          "750141212": {
            "id": "750141212",
            "speakerId": 1002,
            "speakerName": "葵莉娅",
            "text": "小家伙，别心急，待会儿就轮到你了。",
            "nextDialogs": [
              "750141221"
            ]
          },
          "750141221": {
            "id": "750141221",
            "speakerId": 1002,
            "speakerName": "葵莉娅",
            "text": "首先是你，你得跟我走，能听懂指令吗？"
          }
        }
      }
    },
    {
      "subId": "7501406",
      "subQuestName": "魂附暝视龙，潜入营地深处",
      "sceneId": null,
      "locations": [],

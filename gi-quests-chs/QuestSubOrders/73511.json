  "subQuests": [
    {
      "subId": "7351101",
      "subQuestName": "与神色焦急的学者对话",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "735110101"
        ],
        "dialogs": {
          "735110101": {
            "id": "735110101",
            "speakerId": 30343,
            "speakerName": "施芮娅",
            "text": "那个笨蛋…居然就这么冲进沙漠了！福迪尔大哥，求求你们，快去救救他吧！",
            "nextDialogs": [
              "735110102"
            ]
          },
          "735110102": {
            "id": "735110102",
            "speakerId": 4403,
            "speakerName": "福迪尔",
            "text": "很抱歉，村子里的守备力量有限，还要防着「它们」乱来，暂时没有那么多余力。",
            "nextDialogs": [
              "735110103"
            ]
          },
          "735110103": {
            "id": "735110103",
            "speakerId": 30343,
            "speakerName": "施芮娅",
            "text": "可那个笨蛋那么拼命，也是为了对付「它们」啊！至少看在利害一致的份上…",
            "nextDialogs": [
              "735110104"
            ]
          },
          "735110104": {
            "id": "735110104",
            "speakerId": 4403,
            "speakerName": "福迪尔",
            "text": "唉，也不是我们不想去找。但是守卫们现在分散在沙漠各处，提防「它们」的动向，召集人手也需要时间…",
            "nextDialogs": [
              "735110105"
            ]
          },
          "735110105": {
            "id": "735110105",
            "speakerId": 30343,
            "speakerName": "施芮娅",
            "text": "怎么会这样…现在回喀万驿找人帮忙，肯定也来不及了…",
            "nextDialogs": [
              "735110108"
            ]
          },
          "735110108": {
            "id": "735110108",
            "speakerId": 30343,
            "speakerName": "施芮娅",
            "text": "嗯？你们是…？",
            "nextDialogs": [
              "735110109"
            ]
          },
          "735110109": {
            "id": "735110109",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "一名路过的冒险家。",
            "nextDialogs": [
              "735110110"
            ]
          },
          "735110110": {
            "id": "735110110",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "#——以及{M#他}{F#她}最要好的伙伴派蒙！",
            "nextDialogs": [
              "735110111"
            ]
          },
          "735110111": {
            "id": "735110111",
            "speakerId": 30343,
            "speakerName": "施芮娅",
            "text": "冒险家？真的吗！谢天谢地，维纳亚克那家伙，终于有救了！",
            "nextDialogs": [
              "735110112"
            ]
          },
          "735110112": {
            "id": "735110112",
            "speakerId": 30343,
            "speakerName": "施芮娅",
            "text": "#冒险家{M#先生}{F#小姐}！请您救救维纳亚克吧，报酬绝对不成问题！",
            "nextDialogs": [
              "735110113"
            ]
          },
          "735110113": {
            "id": "735110113",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "先说说是什么情况？",
            "nextDialogs": [
              "735110114"
            ]
          },
          "735110114": {
            "id": "735110114",
            "speakerId": 4403,
            "speakerName": "福迪尔",
            "text": "嗯，沙漠里现在有「它们」作乱，比平时要危险不少，最好先听完情况说明再作打算。",
            "nextDialogs": [
              "735110115"
            ]
          },
          "735110115": {
            "id": "735110115",
            "speakerId": 30343,
            "speakerName": "施芮娅",
            "text": "呃…你们说得对，抱歉，我有点儿心急了…",
            "nextDialogs": [
              "735110116"
            ]
          },
          "735110116": {
            "id": "735110116",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "从刚才起就一直听你们在说了，「它们」究竟是什么东西啊？",
            "nextDialogs": [
              "735110117"
            ]
          },
          "735110117": {
            "id": "735110117",
            "speakerId": 4403,
            "speakerName": "福迪尔",
            "text": "——是一群沙虫。也不知道为什么，它们的性情最近变得异常凶暴，还会潜藏在沙暴里袭击过往的猎物。"
          }
        }
      }
    },
    {
      "subId": "7351102",
      "subQuestName": "寻找维纳亚克",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [],
        "dialogs": {}
      }
    },
    {
      "subId": "7351103",
      "subQuestName": "与维纳亚克对话",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "735110301"
        ],
        "dialogs": {
          "735110301": {
            "id": "735110301",
            "speakerId": 30342,
            "speakerName": "维纳亚克",
            "text": "从这个角度潜入，利用地形进行遮蔽…只要太阳高度角不高于…我的速度不低于…嗯，果然还是无解！",
            "nextDialogs": [
              "735110302"
            ]
          },
          "735110302": {
            "id": "735110302",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "你在算什么？",
            "nextDialogs": [
              "735110303"
            ]
          },
          "735110303": {
            "id": "735110303",
            "speakerId": 30342,
            "speakerName": "维纳亚克",
            "text": "「在不正面接触魔物的情况下回收零件的可行路线」…拜沙虫所赐，我的宝贝零件全被卷进附近的魔物堆里了…",
            "nextDialogs": [
              "735110304"
            ]
          },
          "735110304": {
            "id": "735110304",
            "speakerId": 30342,
            "speakerName": "维纳亚克",
            "text": "——呜哇！你们是谁？是什么时候来的！",
            "nextDialogs": [
              "735110305"
            ]
          },
          "735110305": {
            "id": "735110305",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "都在边上听你嘀咕好久了…",
            "nextDialogs": [
              "735110306"
            ]
          },
          "735110306": {
            "id": "735110306",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "放心吧，我们不是坏人。是你的同伴让我们来的哦！",
            "nextDialogs": [
              "735110307"
            ]
          },
          "735110307": {
            "id": "735110307",
            "speakerId": 30342,
            "speakerName": "维纳亚克",
            "text": "同伴？难道是施芮娅？不对啊，她明明说，就算我被魔物抓走也不管我了…",
            "nextDialogs": [
              "735110308"
            ]
          },
          "735110308": {
            "id": "735110308",
            "speakerId": 30342,
            "speakerName": "维纳亚克",
            "text": "啊——我明白了，她是让你们俩来回收零件的吧！",
            "nextDialogs": [
              "735110309"
            ]
          },
          "735110309": {
            "id": "735110309",
            "speakerId": 30342,
            "speakerName": "维纳亚克",
            "text": "我有没有被抓走无所谓，零件没人回收了可是大事…嗯，像是她会说的话，合情合理。",
            "nextDialogs": [
              "735110310"
            ]
          },
          "735110310": {
            "id": "735110310",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "…你就当是这样吧。",
            "nextDialogs": [
              "735110311"
            ]
          },
          "735110311": {
            "id": "735110311",
            "speakerId": 30342,
            "speakerName": "维纳亚克",
            "text": "不过还是得多谢你们啦，刚才我怎么算都求不出解，都想直接冲出去，走一步再算一步了。",
            "nextDialogs": [
              "735110312"
            ]
          },
          "735110312": {
            "id": "735110312",
            "speakerId": 30342,
            "speakerName": "维纳亚克",
            "text": "…搞不好一步算错，就真要被魔物逮着了。",
            "nextDialogs": [
              "735110313"
            ]
          },
          "735110313": {
            "id": "735110313",
            "speakerId": 30342,
            "speakerName": "维纳亚克",
            "text": "唉，要是没我在，施芮娅又那么笨手笨脚的…还有谁能照料好这些机械啊！",
            "nextDialogs": [
              "735110314"
            ]
          },
          "735110314": {
            "id": "735110314",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "我算是理解施芮娅为什么那么担心了…这个人脑子里真的全是机械零件…",
            "nextDialogs": [
              "735110315"
            ]
          },
          "735110315": {
            "id": "735110315",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "#{NICKNAME}，我们快把零件给收集起来吧！免得他又想冒险了！"
          }
        }
      }
    },
    {
      "subId": "7351105",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "735110501"
        ],
        "dialogs": {
          "735110501": {
            "id": "735110501",
            "speakerId": 30343,
            "speakerName": "施芮娅",
            "text": "希望他的脑袋，还没生锈到直接冲进魔物堆里捡零件…"
          }
        }
      }
    },
    {
      "subId": "7351106",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "735110601"
        ],
        "dialogs": {
          "735110601": {
            "id": "735110601",
            "speakerId": 4403,
            "speakerName": "福迪尔",
            "text": "这些沙虫最近变得非常凶暴，一定要加倍小心。"
          }
        }
      }
    }
  ]
}
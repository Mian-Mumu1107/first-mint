  },
  "subQuests": [
    {
      "subId": "7054901",
      "subQuestName": "(test)隐藏$HIDDEN",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "705490101"
        ],
        "dialogs": {
          "705490101": {
            "id": "705490101",
            "speakerId": 1077,
            "speakerName": "克洛琳德",
            "text": "嗯，确认了。",
            "nextDialogs": [
              "705490102"
            ]
          },
          "705490102": {
            "id": "705490102",
            "speakerId": 1077,
            "speakerName": "克洛琳德",
            "text": "在附近徘徊时，我就察觉到熟悉的气息，走近一看，果然是你。",
            "nextDialogs": [
              "705490105"
            ]
          },
          "705490105": {
            "id": "705490105",
            "speakerId": 1077,
            "speakerName": "克洛琳德",
            "text": "要是夏洛蒂小姐看见了这一幕，肯定会为你连拍数百张画片，并写下如下报道——",
            "nextDialogs": [
              "705490106"
            ]
          },
          "705490106": {
            "id": "705490106",
            "speakerId": 1077,
            "speakerName": "克洛琳德",
            "text": "#《辉煌执剑者{NICKNAME}的兼职生活，每杯调饮都千金难求》…",
            "nextDialogs": [
              "705490107"
            ]
          },
          "705490107": {
            "id": "705490107",
            "speakerId": 1077,
            "speakerName": "克洛琳德",
            "text": "第二天，你就会登上各大报纸的头条，可能还会有大量枫丹游客慕名而来，将这里挤得水泄不通。"
          }
        }
      }
    },
    {
      "subId": "7054902",
      "subQuestName": "(test)隐藏$HIDDEN",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [],
        "dialogs": {}
      }
    },
    {
      "subId": "7054903",
      "subQuestName": "(test)隐藏$HIDDEN",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "705490301"
        ],
        "dialogs": {
          "705490301": {
            "id": "705490301",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "这杯新作品…就叫「悠闲雷光」好了。",
            "nextDialogs": [
              "705490302"
            ]
          },
          "705490302": {
            "id": "705490302",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "决斗代理人专享特调，请用！",
            "nextDialogs": [
              "705490303"
            ]
          },
          "705490303": {
            "id": "705490303",
            "speakerId": 1077,
            "speakerName": "克洛琳德",
            "text": "呼…",
            "nextDialogs": [
              "705490304"
            ]
          },
          "705490304": {
            "id": "705490304",
            "speakerId": 1077,
            "speakerName": "克洛琳德",
            "text": "嗯？是用了果味的淡酒吗？这种口感非常不错，对我来说恰到好处…",
            "nextDialogs": [
              "705490305"
            ]
          },
          "705490305": {
            "id": "705490305",
            "speakerId": 1077,
            "speakerName": "克洛琳德",
            "text": "盐雕的淡淡咸味，和入口时的果酸，柔和的焦糖甜味混合在一起，每种都处于最佳的边界线上。",
            "nextDialogs": [
              "705490306"
            ]
          },
          "705490306": {
            "id": "705490306",
            "speakerId": 1077,
            "speakerName": "克洛琳德",
            "text": "名字和酒的颜色很搭，雷光这个词的意象，也对上了「烈焰焦糖长诗」的火元素…",
            "nextDialogs": [
              "705490307"
            ]
          },
          "705490307": {
            "id": "705490307",
            "speakerId": 1077,
            "speakerName": "克洛琳德",
            "text": "不过，「悠闲」是怎么回事？",
            "nextDialogs": [
              "705490310"
            ]
          },
          "705490310": {
            "id": "705490310",
            "speakerId": 1077,
            "speakerName": "克洛琳德",
            "text": "原来如此…确实很契合这杯酒给我的感受。",
            "nextDialogs": [
              "705490311"
            ]
          },
          "705490311": {
            "id": "705490311",
            "speakerId": 1077,
            "speakerName": "克洛琳德",
            "text": "它独特的香气和口感，会在我对蒙德的记忆中，占据最关键的位置。"
          }
        }
      }
    },
    {

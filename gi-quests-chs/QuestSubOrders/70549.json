    {
      "subId": "7054906",
      "subQuestName": "(test)隐藏$HIDDEN",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "705490201"
        ],
        "dialogs": {
          "705490201": {
            "id": "705490201",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "你点的「烈焰焦糖长诗」完成了，请慢用…",
            "nextDialogs": [
              "705490202"
            ]
          },
          "705490202": {
            "id": "705490202",
            "speakerId": 1077,
            "speakerName": "克洛琳德",
            "text": "还真是酒如其名，色泽如火…散发着侵略性的香气。",
            "nextDialogs": [
              "705490203"
            ]
          },
          "705490203": {
            "id": "705490203",
            "speakerId": 1077,
            "speakerName": "克洛琳德",
            "text": "咳…似乎有点烈了。",
            "nextDialogs": [
              "705490206"
            ]
          },
          "705490206": {
            "id": "705490206",
            "speakerId": 1077,
            "speakerName": "克洛琳德",
            "text": "没关系，只是需要时间来适应。",
            "nextDialogs": [
              "705490207"
            ]
          },
          "705490207": {
            "id": "705490207",
            "speakerId": 1077,
            "speakerName": "克洛琳德",
            "text": "印象里，上次喝酒还是去年，被娜维娅邀请去了一次品酒会，浅尝过一小口希斯嘉葡萄酒，力道远远不如这杯。"
          }
        }
      }
    },

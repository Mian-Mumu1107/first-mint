        "dialogs": {
          "719440101": {
            "id": "719440101",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "你说的也不是没有道理…",
            "nextDialogs": [
              "719440102"
            ]
          },
          "719440102": {
            "id": "719440102",
            "speakerId": 2116,
            "speakerName": "一阔",
            "text": "对吧？而且人生苦短，每天都那么拼命也不是不行…但这一切值得吗？",
            "nextDialogs": [
              "719440103"
            ]
          },
          "719440103": {
            "id": "719440103",
            "speakerId": 2116,
            "speakerName": "一阔",
            "text": "与其像我的同僚那样把一切都奉献给工作，这样忙里偷闲才更好吧？",
            "nextDialogs": [
              "719440104"
            ]
          },
          "719440104": {
            "id": "719440104",
            "speakerId": 2116,
            "speakerName": "一阔",
            "text": "人生何其漫长，何必忙忙碌碌、奋力追赶？",
            "nextDialogs": [
              "719440105"
            ]
          },
          "719440105": {
            "id": "719440105",
            "speakerId": 2116,
            "speakerName": "一阔",
            "text": "所以啊，你也不用那么着急，坐下休息休息，喝喝茶、尝尝这炸萝卜丸子…知足常乐，何必庸人自扰？"
          }
        }
      }
    }
  ]

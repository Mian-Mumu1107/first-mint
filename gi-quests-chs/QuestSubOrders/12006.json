  "subQuests": [
    {
      "subId": "1200601",
      "subQuestName": "与木南杏奈对话",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "120060101"
        ],
        "dialogs": {
          "120060101": {
            "id": "120060101",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "是这间店对吧？真的是临街的开放式店铺呢，好亲切呀。",
            "nextDialogs": [
              "120060102"
            ]
          },
          "120060102": {
            "id": "120060102",
            "speakerId": 1001,
            "speakerName": "木南杏奈",
            "text": "欢迎光临！",
            "nextDialogs": [
              "120060103"
            ]
          },
          "120060103": {
            "id": "120060103",
            "speakerId": 1002,
            "speakerName": "神里绫华",
            "text": "木南小姐，你好。",
            "nextDialogs": [
              "120060104"
            ]
          },
          "120060104": {
            "id": "120060104",
            "speakerId": 1001,
            "speakerName": "木南杏奈",
            "text": "哎呀神里小姐，来得真准时！我们约定的差不多就是这个时间。",
            "nextDialogs": [
              "120060105"
            ]
          },
          "120060105": {
            "id": "120060105",
            "speakerId": 1002,
            "speakerName": "神里绫华",
            "text": "是的。",
            "nextDialogs": [
              "120060106"
            ]
          },
          "120060106": {
            "id": "120060106",
            "speakerId": 1002,
            "speakerName": "神里绫华",
            "text": "点单就按之前我预约的内容，另外，和你说好的那件事…也拜托了。",
            "nextDialogs": [
              "120060107"
            ]
          },
          "120060107": {
            "id": "120060107",
            "speakerId": 1001,
            "speakerName": "木南杏奈",
            "text": "好好，没问题，你要的东西我都准备好了。",
            "nextDialogs": [
              "120060108"
            ]
          },
          "120060108": {
            "id": "120060108",
            "speakerId": 1001,
            "speakerName": "木南杏奈",
            "text": "旅行者和这位小小的客人请在这边稍等一下，我去备菜。",
            "nextDialogs": [
              "120060109"
            ]
          },
          "120060109": {
            "id": "120060109",
            "speakerId": 1002,
            "speakerName": "神里绫华",
            "text": "旅行者，派蒙，先入座吧。我稍稍失陪一会儿，马上就来。",
            "nextDialogs": [
              "120060112"
            ]
          },
          "120060112": {
            "id": "120060112",
            "speakerId": 1002,
            "speakerName": "神里绫华",
            "text": "咳咳…不是那种情况啦。",
            "nextDialogs": [
              "120060113"
            ]
          },
          "120060113": {
            "id": "120060113",
            "speakerId": 1002,
            "speakerName": "神里绫华",
            "text": "只是处理一些小事，马上就来。",
            "nextDialogs": [
              "120060114"
            ]
          },
          "120060114": {
            "id": "120060114",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "走掉了…好像是有什么急事的样子。",
            "nextDialogs": [
              "120060115"
            ]
          },
          "120060115": {
            "id": "120060115",
            "speakerId": 1001,
            "speakerName": "木南杏奈",
            "text": "二位是神里小姐的朋友吧？",
            "nextDialogs": [
              "120060116"
            ]
          },
          "120060116": {
            "id": "120060116",
            "speakerId": 1001,
            "speakerName": "木南杏奈",
            "text": "哈哈，我们店做的都是民间菜色，不敢说形式有多高级…啊不过，味道是很好的哦！希望你们能喜欢。",
            "nextDialogs": [
              "120060117"
            ]
          },
          "120060117": {
            "id": "120060117",
            "speakerId": 1001,
            "speakerName": "木南杏奈",
            "text": "我们店开了很多年，与神里家的各位大人还算是有些交情。",
            "nextDialogs": [
              "120060118"
            ]
          },
          "120060118": {
            "id": "120060118",
            "speakerId": 1001,
            "speakerName": "木南杏奈",
            "text": "神里家两兄妹都挺喜欢我们店的菜，以前总是请人来店里下单，买回府上享用。",
            "nextDialogs": [
              "120060119"
            ]
          },
          "120060119": {
            "id": "120060119",
            "speakerId": 1001,
            "speakerName": "木南杏奈",
            "text": "不过没想到，这次她亲自过来店里，还带了朋友。我还是头一次听说神里小姐请朋友吃饭呢！",
            "nextDialogs": [
              "120060120"
            ]
          },
          "120060120": {
            "id": "120060120",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "居然是第一次，我们真有面子！",
            "nextDialogs": [
              "120060121"
            ]
          },
          "120060121": {
            "id": "120060121",
            "speakerId": 1001,
            "speakerName": "木南杏奈",
            "text": "是啊，虽然这话说起来有些冒犯…我也就跟你们说说，据我所知，神里小姐朋友似乎不多。",
            "nextDialogs": [
              "120060122"
            ]
          },
          "120060122": {
            "id": "120060122",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "真叫人意外…",
            "nextDialogs": [
              "120060123"
            ]
          },
          "120060123": {
            "id": "120060123",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "怎么会？她人很好，又有礼貌，应该很受欢迎才对吧？",
            "nextDialogs": [
              "120060124"
            ]
          },
          "120060124": {
            "id": "120060124",
            "speakerId": 1001,
            "speakerName": "木南杏奈",
            "text": "原本我也这么想，但人际的规律却不是这样。",
            "nextDialogs": [
              "120060125"
            ]
          },
          "120060125": {
            "id": "120060125",
            "speakerId": 1001,
            "speakerName": "木南杏奈",
            "text": "街坊邻里都说，神里小姐相貌美丽，出身高贵，举止优雅得体，简直像是高岭之花一样。",
            "nextDialogs": [
              "120060126"
            ]
          },
          "120060126": {
            "id": "120060126",
            "speakerId": 1001,
            "speakerName": "木南杏奈",
            "text": "太过完美，反而给人强烈的距离感。普通人家的孩子，几乎都不敢跟她随便搭话。",
            "nextDialogs": [
              "120060127"
            ]
          },
          "120060127": {
            "id": "120060127",
            "speakerId": 1001,
            "speakerName": "木南杏奈",
            "text": "这么好的女孩子，反而难交到朋友呢…",
            "nextDialogs": [
              "120060128"
            ]
          },
          "120060128": {
            "id": "120060128",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "居然是这样…",
            "nextDialogs": [
              "120060129"
            ]
          },
          "120060129": {
            "id": "120060129",
            "speakerId": 1001,
            "speakerName": "木南杏奈",
            "text": "我跟她聊天不多，但也算是认识挺久了，一直很钦佩她年纪轻轻就肩负起了那么多责任。",
            "nextDialogs": [
              "120060130"
            ]
          },
          "120060130": {
            "id": "120060130",
            "speakerId": 1001,
            "speakerName": "木南杏奈",
            "text": "今天看她带人过来，我也很开心哦！",
            "nextDialogs": [
              "120060131"
            ]
          },
          "120060131": {
            "id": "120060131",
            "speakerId": 1001,
            "speakerName": "木南杏奈",
            "text": "你们今天可要多吃点！可以的话，请多陪她聊聊天。",
            "nextDialogs": [
              "120060132"
            ]
          },
          "120060132": {
            "id": "120060132",
            "speakerId": 1001,
            "speakerName": "木南杏奈",
            "text": "就当是我们街坊邻居的请求，拜托了。",
            "nextDialogs": [
              "120060133"
            ]
          },
          "120060133": {
            "id": "120060133",
            "speakerId": 1003,
            "speakerName": "？？？",
            "text": "啊…！",
            "nextDialogs": [
              "120060134"
            ]
          },
          "120060134": {
            "id": "120060134",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "嗯？绫华的声音？",
            "nextDialogs": [
              "120060135"
            ]
          },
          "120060135": {
            "id": "120060135",
            "speakerId": 1002,
            "speakerName": "神里绫华",
            "text": "抱歉，旅行者…呃、呃…"
          }
        }
      }
    },
    {
      "subId": "1200602",
      "subQuestName": "将披萨交给神里绫华",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "120060201"
        ],
        "dialogs": {
          "120060201": {
            "id": "120060201",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "烤好啦烤好啦！",
            "nextDialogs": [
              "120060202"
            ]
          },
          "120060202": {
            "id": "120060202",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "嗯，这就是成品。",
            "nextDialogs": [
              "120060203"
            ]
          },
          "120060203": {
            "id": "120060203",
            "speakerId": 1002,
            "speakerName": "神里绫华",
            "text": "好香…旅行者，你做料理真有一手。",
            "nextDialogs": [
              "120060204"
            ]
          },
          "120060204": {
            "id": "120060204",
            "speakerId": 1002,
            "speakerName": "神里绫华",
            "text": "我也想成为会做各地料理的厨房高手…",
            "nextDialogs": [
              "120060205"
            ]
          },
          "120060205": {
            "id": "120060205",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "只要有菜谱就能学会了，有机会我们再带些菜谱给你。",
            "nextDialogs": [
              "120060206"
            ]
          },
          "120060206": {
            "id": "120060206",
            "speakerId": 1002,
            "speakerName": "神里绫华",
            "text": "好啊，我很期待能与你们交流料理心得。",
            "nextDialogs": [
              "120060207"
            ]
          },
          "120060207": {
            "id": "120060207",
            "speakerId": 1001,
            "speakerName": "木南杏奈",
            "text": "几位，忙得如何？",
            "nextDialogs": [
              "120060208"
            ]
          },
          "120060208": {
            "id": "120060208",
            "speakerId": 1001,
            "speakerName": "木南杏奈",
            "text": "呀，这是…神里小姐，这就是你想要的料理吗？",
            "nextDialogs": [
              "120060209"
            ]
          },
          "120060209": {
            "id": "120060209",
            "speakerId": 1002,
            "speakerName": "神里绫华",
            "text": "是的，这是旅行者帮忙制作的异国料理。",
            "nextDialogs": [
              "120060210"
            ]
          },
          "120060210": {
            "id": "120060210",
            "speakerId": 1002,
            "speakerName": "神里绫华",
            "text": "可以请你帮我打包吗？",
            "nextDialogs": [
              "120060211"
            ]
          },
          "120060211": {
            "id": "120060211",
            "speakerId": 1001,
            "speakerName": "木南杏奈",
            "text": "当然可以啦！",
            "nextDialogs": [
              "120060212"
            ]
          },
          "120060212": {
            "id": "120060212",
            "speakerId": 1001,
            "speakerName": "木南杏奈",
            "text": "唔~真香！一定是道非常美味的料理，啊，我也好想要一道这样的菜放在我们店里呀…",
            "nextDialogs": [
              "120060213"
            ]
          },
          "120060213": {
            "id": "120060213",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "哼哼，需要教你做法吗？",
            "nextDialogs": [
              "120060214"
            ]
          },
          "120060214": {
            "id": "120060214",
            "speakerId": 1002,
            "speakerName": "神里绫华",
            "text": "哎？可以吗？",
            "nextDialogs": [
              "120060215"
            ]
          },
          "120060215": {
            "id": "120060215",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "可以哦。",
            "nextDialogs": [
              "120060216"
            ]
          },
          "120060216": {
            "id": "120060216",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "食物本来就是大家一起享用才更美味的东西，我想，蒙德的大家也不会介意我们把这道料理传播到稻妻的吧。",
            "nextDialogs": [
              "120060217"
            ]
          },
          "120060217": {
            "id": "120060217",
            "speakerId": 1001,
            "speakerName": "木南杏奈",
            "text": "真的可以吗？哎呀，我早就想学做异国料理了！",
            "nextDialogs": [
              "120060218"
            ]
          },
          "120060218": {
            "id": "120060218",
            "speakerId": 1001,
            "speakerName": "木南杏奈",
            "text": "如果你们愿意抄一份菜谱给我的话，我会在店里制作并售卖这道菜，还要把它的广告贴在最显眼的位置！",
            "nextDialogs": [
              "120060219"
            ]
          },
          "120060219": {
            "id": "120060219",
            "speakerId": 1001,
            "speakerName": "木南杏奈",
            "text": "自从锁国以来，大家好久没有尝过新菜式了。旅行者，真是太谢谢你啦！",
            "nextDialogs": [
              "120060220"
            ]
          },
          "120060220": {
            "id": "120060220",
            "speakerId": 1001,
            "speakerName": "木南杏奈",
            "text": "我先去给神里小姐的食物打包，几位忙完就到用餐区来吧，菜都好啦。",
            "nextDialogs": [
              "120060221"
            ]
          },
          "120060221": {
            "id": "120060221",
            "speakerId": 1002,
            "speakerName": "神里绫华",
            "text": "明明是可以高价售卖的东西，却愿意这样无私奉献…",
            "nextDialogs": [
              "120060222"
            ]
          },
          "120060222": {
            "id": "120060222",
            "speakerId": 1002,
            "speakerName": "神里绫华",
            "text": "…你真好。",
            "nextDialogs": [
              "120060223"
            ]
          },
          "120060223": {
            "id": "120060223",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "绫华总是在夸我…",
            "nextDialogs": [
              "120060224"
            ]
          },
          "120060224": {
            "id": "120060224",
            "speakerId": 1002,
            "speakerName": "神里绫华",
            "text": "我是真心的。我…很敬佩你，也为能结交你这样高洁的朋友而骄傲。",
            "nextDialogs": [
              "120060225"
            ]
          },
          "120060225": {
            "id": "120060225",
            "speakerId": 1002,
            "speakerName": "神里绫华",
            "text": "啊对，是不是该把菜谱抄下来？",
            "nextDialogs": [
              "120060226"
            ]
          },
          "120060226": {
            "id": "120060226",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "#{NICKNAME}，把我们喜欢的配方写下来，送给店主吧！",
            "nextDialogs": [
              "120060227"
            ]
          },
          "120060227": {
            "id": "120060227",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "来做披萨吧！先来选择第一份原料组合！",
            "nextDialogs": [
              "120060229",
              "120060231"
            ]
          },
          "120060229": {
            "id": "120060229",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "没错，就是这个！",
            "nextDialogs": [
              "120060232"
            ]
          },
          "120060232": {
            "id": "120060232",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "然后选择第二份原料组合！"
          },
          "120060231": {
            "id": "120060231",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "哎？你是认真的吗？好吧…"
          }
        }
      }
    },

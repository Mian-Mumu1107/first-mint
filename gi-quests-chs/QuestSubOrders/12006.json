    {
      "subId": "1200606",
      "subQuestName": "与木南杏奈对话",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "120060601"
        ],
        "dialogs": {
          "120060601": {
            "id": "120060601",
            "speakerId": 1002,
            "speakerName": "神里绫华",
            "text": "写好啦！",
            "nextDialogs": [
              "120060602"
            ]
          },
          "120060602": {
            "id": "120060602",
            "speakerId": 1001,
            "speakerName": "木南杏奈",
            "text": "谢谢！",
            "nextDialogs": [
              "120060603"
            ]
          },
          "120060603": {
            "id": "120060603",
            "speakerId": 1001,
            "speakerName": "木南杏奈",
            "text": "哇…真期待啊，好想马上去做新菜。",
            "nextDialogs": [
              "120060604"
            ]
          },
          "120060604": {
            "id": "120060604",
            "speakerId": 1002,
            "speakerName": "神里绫华",
            "text": "旅行者，派蒙，抱歉耽搁了你们的用餐时间。",
            "nextDialogs": [
              "120060605"
            ]
          },
          "120060605": {
            "id": "120060605",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "嘿嘿，劳动后的食物更美味！",
            "nextDialogs": [
              "120060606"
            ]
          },
          "120060606": {
            "id": "120060606",
            "speakerId": 1002,
            "speakerName": "神里绫华",
            "text": "让我们趁热吃吧。",
            "nextDialogs": [
              "120060607"
            ]
          },
          "120060607": {
            "id": "120060607",
            "speakerId": 1002,
            "speakerName": "神里绫华",
            "text": "怎么样，稻妻的料理合你们口味吗？",
            "nextDialogs": [
              "120060608"
            ]
          },
          "120060608": {
            "id": "120060608",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "好吃！这个好吃，还有那边那个，也特别好吃…",
            "nextDialogs": [
              "120060611"
            ]
          },
          "120060611": {
            "id": "120060611",
            "speakerId": 1002,
            "speakerName": "神里绫华",
            "text": "哈哈，那我就放心了。",
            "nextDialogs": [
              "120060612"
            ]
          },
          "120060612": {
            "id": "120060612",
            "speakerId": 1002,
            "speakerName": "神里绫华",
            "text": "对了，刚才我在那边试做料理的时候，你们有跟店主闲聊吗？",
            "nextDialogs": [
              "120060613"
            ]
          },
          "120060613": {
            "id": "120060613",
            "speakerId": 1002,
            "speakerName": "神里绫华",
            "text": "她、她有没有说什么…有关我的事？",
            "nextDialogs": [
              "120060614"
            ]
          },
          "120060614": {
            "id": "120060614",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "说了一些哦，不过她是为你高兴，没有别的意思。",
            "nextDialogs": [
              "120060615"
            ]
          },
          "120060615": {
            "id": "120060615",
            "speakerId": 1002,
            "speakerName": "神里绫华",
            "text": "为我…高兴？",
            "nextDialogs": [
              "120060616"
            ]
          },
          "120060616": {
            "id": "120060616",
            "speakerId": 1002,
            "speakerName": "神里绫华",
            "text": "呜…果然说了吧！她、她是不是…",
            "nextDialogs": [
              "120060617"
            ]
          },
          "120060617": {
            "id": "120060617",
            "speakerId": 1002,
            "speakerName": "神里绫华",
            "text": "唉，算了，我就是朋友很少，我自己也知道啦…",
            "nextDialogs": [
              "120060618"
            ]
          },
          "120060618": {
            "id": "120060618",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "不奇怪哦，别人只是还没有找到跟你多说话的机会而已。",
            "nextDialogs": [
              "120060619"
            ]
          },
          "120060619": {
            "id": "120060619",
            "speakerId": 1002,
            "speakerName": "神里绫华",
            "text": "谢谢你安慰我，派蒙。",
            "nextDialogs": [
              "120060620"
            ]
          },
          "120060620": {
            "id": "120060620",
            "speakerId": 1002,
            "speakerName": "神里绫华",
            "text": "那些都是实话，我这个人…朋友确实比较少。",
            "nextDialogs": [
              "120060621"
            ]
          },
          "120060621": {
            "id": "120060621",
            "speakerId": 1002,
            "speakerName": "神里绫华",
            "text": "平日跟我走得近的只有家人和下属。所以，看见我约你出来吃饭，大家应该会很震惊吧…"
          }
        }
      }
    },

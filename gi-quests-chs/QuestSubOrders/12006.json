    {
      "subId": "1200607",
      "subQuestName": "(test)判断是特色菜谱$HIDDEN",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "120060401"
        ],
        "dialogs": {
          "120060401": {
            "id": "120060401",
            "speakerId": 1004,
            "speakerName": "小仓澪",
            "text": "神里小姐，这里是您定制的着物，已经为您叠好装入礼盒了。",
            "nextDialogs": [
              "120060402"
            ]
          },
          "120060402": {
            "id": "120060402",
            "speakerId": 1004,
            "speakerName": "小仓澪",
            "text": "啊对，还有您特别安排的那件物品，也准备好了哦！",
            "nextDialogs": [
              "120060403"
            ]
          },
          "120060403": {
            "id": "120060403",
            "speakerId": 1002,
            "speakerName": "神里绫华",
            "text": "非常感谢。",
            "nextDialogs": [
              "120060404"
            ]
          },
          "120060404": {
            "id": "120060404",
            "speakerId": 1004,
            "speakerName": "小仓澪",
            "text": "真是非常可爱的衣服，我们制作得很开心，也谢谢你！欢迎下次再来！",
            "nextDialogs": [
              "120060405"
            ]
          },
          "120060405": {
            "id": "120060405",
            "speakerId": 1002,
            "speakerName": "神里绫华",
            "text": "旅行者，我有一件给你的礼物。",
            "nextDialogs": [
              "120060406"
            ]
          },
          "120060406": {
            "id": "120060406",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "咦？真的吗？",
            "nextDialogs": [
              "120060407"
            ]
          },
          "120060407": {
            "id": "120060407",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "呜哇…看起来好高级的东西，是发饰吗？",
            "nextDialogs": [
              "120060408"
            ]
          },
          "120060408": {
            "id": "120060408",
            "speakerId": 1002,
            "speakerName": "神里绫华",
            "text": "是以白鹭为主题制作的发簪，既可以当成发饰，也可以当做摆件。",
            "nextDialogs": [
              "120060409"
            ]
          },
          "120060409": {
            "id": "120060409",
            "speakerId": 1002,
            "speakerName": "神里绫华",
            "text": "不能白白让你帮我的忙，这个…送给你。",
            "nextDialogs": [
              "120060412"
            ]
          },
          "120060412": {
            "id": "120060412",
            "speakerId": 1002,
            "speakerName": "神里绫华",
            "text": "嗯！",
            "nextDialogs": [
              "120060413"
            ]
          },
          "120060413": {
            "id": "120060413",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "说起来，绫华的称号就是「白鹭公主」对吧？这件礼物也像你一样优美呢。",
            "nextDialogs": [
              "120060414"
            ]
          },
          "120060414": {
            "id": "120060414",
            "speakerId": 1002,
            "speakerName": "神里绫华",
            "text": "派蒙过奖了。如果看见它能让你们想起我，自然是再好不过。",
            "nextDialogs": [
              "120060415"
            ]
          },
          "120060415": {
            "id": "120060415",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "嘿嘿，一定会的。",
            "nextDialogs": [
              "120060416"
            ]
          },
          "120060416": {
            "id": "120060416",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "好，既然拿到东西，就可以出发啦。",
            "nextDialogs": [
              "120060417"
            ]
          },
          "120060417": {
            "id": "120060417",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "到「椿」的住处去看看吧！"
          }
        }
      }
    },

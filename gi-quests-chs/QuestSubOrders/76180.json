    {
      "subId": "7618004",
      "subQuestName": "享受茶会时光",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "761800601"
        ],
        "dialogs": {
          "761800601": {
            "id": "761800601",
            "speakerId": 1319,
            "speakerName": "「木偶」",
            "text": "什…什么？怎么可能！",
            "nextDialogs": [
              "761800602"
            ]
          },
          "761800602": {
            "id": "761800602",
            "speakerId": 1318,
            "speakerName": "「少女」",
            "text": "是你输了呢，桑多涅。",
            "nextDialogs": [
              "761800603"
            ]
          },
          "761800603": {
            "id": "761800603",
            "speakerId": 1319,
            "speakerName": "「木偶」",
            "text": "我…我这是让你的！",
            "nextDialogs": [
              "761800604"
            ]
          },
          "761800604": {
            "id": "761800604",
            "speakerId": 1318,
            "speakerName": "「少女」",
            "text": "真的吗？你明明很不甘心的样子。",
            "nextDialogs": [
              "761800605"
            ]
          },
          "761800605": {
            "id": "761800605",
            "speakerId": 1319,
            "speakerName": "「木偶」",
            "text": "可恶…再来！",
            "nextDialogs": [
              "761800606"
            ]
          },
          "761800606": {
            "id": "761800606",
            "speakerId": 1319,
            "speakerName": "「木偶」",
            "text": "哼，轻轻松松。",
            "nextDialogs": [
              "761800607"
            ]
          },
          "761800607": {
            "id": "761800607",
            "speakerId": 1318,
            "speakerName": "「少女」",
            "text": "是我输了。你果然很厉害呢，桑多涅。",
            "nextDialogs": [
              "761800608"
            ]
          },
          "761800608": {
            "id": "761800608",
            "speakerId": 1319,
            "speakerName": "「木偶」",
            "text": "下次带你玩些更有难度的吧。我知道很多好玩的数理游戏。",
            "nextDialogs": [
              "761800609"
            ]
          },
          "761800609": {
            "id": "761800609",
            "speakerId": 1318,
            "speakerName": "「少女」",
            "text": "好呀。哈哈。",
            "nextDialogs": [
              "761800610"
            ]
          },
          "761800610": {
            "id": "761800610",
            "speakerId": 1319,
            "speakerName": "「木偶」",
            "text": "你笑什么？",
            "nextDialogs": [
              "761800611"
            ]
          },
          "761800611": {
            "id": "761800611",
            "speakerId": 1318,
            "speakerName": "「少女」",
            "text": "以前很少看到桑多涅这么开心的样子，你也不怎么邀请我玩游戏，还会把我赶走。",
            "nextDialogs": [
              "761800612"
            ]
          },
          "761800612": {
            "id": "761800612",
            "speakerId": 1319,
            "speakerName": "「木偶」",
            "text": "喂…别把我说得像是经常欺负你一样好不好！我以后多找你开几次茶会总行了吧！",
            "nextDialogs": [
              "761800613"
            ]
          },
          "761800613": {
            "id": "761800613",
            "speakerId": 1318,
            "speakerName": "「少女」",
            "text": "嗯，好啊。我很喜欢这种和桑多涅你一起度过的茶会时光。"
          }
        }
      }
    },
    {
      "subId": "7618001",
      "subQuestName": "享受茶会时光",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "761800801"
        ],
        "dialogs": {
          "761800801": {
            "id": "761800801",
            "speakerId": 1318,
            "speakerName": "「少女」",
            "text": "和桑多涅玩游戏真开心。下次也一起玩吧。",
            "nextDialogs": [
              "761800802"
            ]
          },
          "761800802": {
            "id": "761800802",
            "speakerId": 1319,
            "speakerName": "「木偶」",
            "text": "（再这么坐一会儿吧。）",
            "nextDialogs": [
              "761800804"
            ]
          },
          "761800804": {
            "id": "761800804",
            "speakerId": 1318,
            "speakerName": "「少女」",
            "text": "要走了吗？好吧，那我们下次见。"
          }
        }
      }
    },
    {
      "subId": "7618004",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "761800401"
        ],
        "dialogs": {
          "761800401": {
            "id": "761800401",
            "speakerId": 1318,
            "speakerName": "「少女」",
            "text": "以前都是到桑多涅的庭院去聚会，现在换成桑多涅你到我的庭院来喝茶，感觉真新奇。",
            "nextDialogs": [
              "761800402"
            ]
          },
          "761800402": {
            "id": "761800402",
            "speakerId": 1319,
            "speakerName": "「木偶」",
            "text": "但茶和茶点还是我来准备，感觉也没变多少…",
            "nextDialogs": [
              "761800403"
            ]
          },
          "761800403": {
            "id": "761800403",
            "speakerId": 1318,
            "speakerName": "「少女」",
            "text": "嗯，还是和以前一样美味。",
            "nextDialogs": [
              "761800404"
            ]
          },
          "761800404": {
            "id": "761800404",
            "speakerId": 1319,
            "speakerName": "「木偶」",
            "text": "#哼。不过，听说{NICKNAME}也会经常来这边看你，你们这种时候都会干嘛？",
            "nextDialogs": [
              "761800405"
            ]
          },
          "761800405": {
            "id": "761800405",
            "speakerId": 1318,
            "speakerName": "「少女」",
            "text": "#唔…有时会聊聊天，有时会和月灵一起玩游戏，看月灵画画。哦，我还会和{M#他}{F#她}下月亮棋呢。",
            "nextDialogs": [
              "761800406"
            ]
          },
          "761800406": {
            "id": "761800406",
            "speakerId": 1319,
            "speakerName": "「木偶」",
            "text": "「月亮棋」？就是那种三个子连成一条线的游戏？你们谁赢得多？",
            "nextDialogs": [
              "761800407"
            ]
          },
          "761800407": {
            "id": "761800407",
            "speakerId": 1318,
            "speakerName": "「少女」",
            "text": "#我没有数过，但{NICKNAME}挺会下棋的。",
            "nextDialogs": [
              "761800408"
            ]
          },
          "761800408": {
            "id": "761800408",
            "speakerId": 1319,
            "speakerName": "「木偶」",
            "text": "哼哼，那你是没和我玩过。要来一局吗？让你见识一下什么是真正的厉害。平局算我输。",
            "nextDialogs": [
              "761800409"
            ]
          },
          "761800409": {
            "id": "761800409",
            "speakerId": 1318,
            "speakerName": "「少女」",
            "text": "好呀。"
          }
        }
      }
    }
  ]

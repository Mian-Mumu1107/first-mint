  "subQuests": [
    {
      "subId": "7907201",
      "subQuestName": "与德维特对话",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "790720101"
        ],
        "dialogs": {
          "790720101": {
            "id": "790720101",
            "speakerId": 1000,
            "speakerName": "德维特",
            "text": "#哎呀，真是荣幸。您就是那位{NICKNAME}吧，旁边这位一定是您的同伴派蒙小姐。",
            "nextDialogs": [
              "790720102"
            ]
          },
          "790720102": {
            "id": "790720102",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "嘿嘿，没错，就是我们啦！",
            "nextDialogs": [
              "790720103"
            ]
          },
          "790720103": {
            "id": "790720103",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "我们有这么出名？",
            "nextDialogs": [
              "790720104"
            ]
          },
          "790720104": {
            "id": "790720104",
            "speakerId": 1000,
            "speakerName": "德维特",
            "text": "星轨王城里的消息，总是比其他地方更灵通一些。",
            "nextDialogs": [
              "790720105"
            ]
          },
          "790720105": {
            "id": "790720105",
            "speakerId": 1000,
            "speakerName": "德维特",
            "text": "不得不说，您来得正好，我正好做完了这副名为「飞帽」的游戏。",
            "nextDialogs": [
              "790720106"
            ]
          },
          "790720106": {
            "id": "790720106",
            "speakerId": 1000,
            "speakerName": "德维特",
            "text": "虽然我不能像那篇《飞帽匠》里的帽子匠一样，让所有人都拥有一顶漂亮的帽子。",
            "nextDialogs": [
              "790720107"
            ]
          },
          "790720107": {
            "id": "790720107",
            "speakerId": 1000,
            "speakerName": "德维特",
            "text": "但我相信，这副「飞帽」游戏，一定能将欢乐带给所有游玩它的人。",
            "nextDialogs": [
              "790720108"
            ]
          },
          "790720108": {
            "id": "790720108",
            "speakerId": 1000,
            "speakerName": "德维特",
            "text": "我还为这款游戏设计了三种完全不同的玩法…呃，当然！规则也绝不复杂。",
            "nextDialogs": [
              "790720109"
            ]
          },
          "790720109": {
            "id": "790720109",
            "speakerId": 1000,
            "speakerName": "德维特",
            "text": "我相信，您只要玩上一局，就能完全理解了。",
            "nextDialogs": [
              "790720111",
              "790720113"
            ]
          },
          "790720111": {
            "id": "790720111",
            "speakerId": 1000,
            "speakerName": "德维特",
            "text": "没问题，请到这边来。"
          },
          "790720113": {
            "id": "790720113",
            "speakerId": 1000,
            "speakerName": "德维特",
            "text": "别担心，等您有空了再来找我吧，我这段时间会一直待在这里。"
          }
        }
      }
    }
  ]
}
    {
      "subId": "7002301",
      "subQuestName": "与另一个愿意交流的丘丘人对话",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "700230101"
        ],
        "dialogs": {
          "700230101": {
            "id": "700230101",
            "speakerId": 1000,
            "speakerName": "勤劳的丘丘人",
            "text": "Ya!",
            "nextDialogs": [
              "700230102"
            ]
          },
          "700230102": {
            "id": "700230102",
            "speakerId": 1001,
            "speakerName": "艾拉·马斯克",
            "text": "Mimi ika yaya nye! Mimi tomo, mimi mani ye.",
            "nextDialogs": [
              "700230103"
            ]
          },
          "700230103": {
            "id": "700230103",
            "speakerId": 1000,
            "speakerName": "勤劳的丘丘人",
            "text": "Mani. Mi muhe mani. Unu du mani! Hahahahaha.",
            "nextDialogs": [
              "700230104"
            ]
          },
          "700230104": {
            "id": "700230104",
            "speakerId": 1001,
            "speakerName": "艾拉·马斯克",
            "text": "这家伙讲了一个丘丘人语言的笑话，把自己乐到了。它们精神太贫瘠了，看着真可怜。",
            "nextDialogs": [
              "700230105"
            ]
          },
          "700230105": {
            "id": "700230105",
            "speakerId": 1000,
            "speakerName": "勤劳的丘丘人",
            "text": "Mi muhe <color=#00E1FFFF>kucha gusha</color>. Kucha gusha dada. Unu gusha dada!",
            "nextDialogs": [
              "700230106"
            ]
          },
          "700230106": {
            "id": "700230106",
            "speakerId": 1001,
            "speakerName": "艾拉·马斯克",
            "text": "它想要…唔…不管了，只要查看我的手册就能找到的！"
          }
        }
      }
    },
    {
      "subId": "7002302",
      "subQuestName": "向丘丘人交付物品",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "700230301"
        ],
        "dialogs": {
          "700230301": {
            "id": "700230301",
            "speakerId": 1000,
            "speakerName": "勤劳的丘丘人",
            "text": "Yeye dada! Mosi mita!",
            "nextDialogs": [
              "700230302"
            ]
          },
          "700230302": {
            "id": "700230302",
            "speakerId": 1000,
            "speakerName": "勤劳的丘丘人",
            "text": "Hahahaha, kucha gusha unu gusha. Unu kucha si!",
            "nextDialogs": [
              "700230303"
            ]
          },
          "700230303": {
            "id": "700230303",
            "speakerId": 1000,
            "speakerName": "勤劳的丘丘人",
            "text": "Wei? Odomu tomo zido mi! <color=#00E1FFFF>Mosi aba nunu</color>！",
            "nextDialogs": [
              "700230304"
            ]
          },
          "700230304": {
            "id": "700230304",
            "speakerId": 1002,
            "speakerName": "派蒙",
            "text": "<color=#00E1FFFF>Mosi aba nunu</color>…手册上有写这句话的含义吗…？",
            "nextDialogs": [
              "700230307"
            ]
          },
          "700230307": {
            "id": "700230307",
            "speakerId": 1000,
            "speakerName": "勤劳的丘丘人",
            "text": "Valo, mi tomo!"
          }
        }
      }
    },

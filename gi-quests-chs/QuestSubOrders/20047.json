  "subQuests": [
    {
      "subId": "2004701",
      "subQuestName": "与杜兰对话",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "200470101"
        ],
        "dialogs": {
          "200470101": {
            "id": "200470101",
            "speakerId": 1589,
            "speakerName": "好奇的帕琪",
            "text": "冒险不可能有完美的方案！这么拖下去，什么时候才能有进展？",
            "nextDialogs": [
              "200470102"
            ]
          },
          "200470102": {
            "id": "200470102",
            "speakerId": 1591,
            "speakerName": "杜兰",
            "text": "就算没有完美的方案，也要做好万全的准备！",
            "nextDialogs": [
              "200470103"
            ]
          },
          "200470103": {
            "id": "200470103",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "你们在吵什么呢？",
            "nextDialogs": [
              "200470104"
            ]
          },
          "200470104": {
            "id": "200470104",
            "speakerId": 1591,
            "speakerName": "杜兰",
            "text": "哦，我们打算去<color=#00E1FFFF>千风神殿</color>内部探险，但帕琪小姐实在是没有冒险经验…",
            "nextDialogs": [
              "200470105"
            ]
          },
          "200470105": {
            "id": "200470105",
            "speakerId": 1591,
            "speakerName": "杜兰",
            "text": "现在千风神殿里魔物横行，还有那个恐怖的遗迹守卫…贸然闯进去，只会让自己的生命安全受到威胁。",
            "nextDialogs": [
              "200470106"
            ]
          },
          "200470106": {
            "id": "200470106",
            "speakerId": 1591,
            "speakerName": "杜兰",
            "text": "为了和帕琪…不是，为了保障我们的人身安全。",
            "nextDialogs": [
              "200470107"
            ]
          },
          "200470107": {
            "id": "200470107",
            "speakerId": 1591,
            "speakerName": "杜兰",
            "text": "我正在说服她，制订一份万无一失的冒险计划。",
            "nextDialogs": [
              "200470108"
            ]
          },
          "200470108": {
            "id": "200470108",
            "speakerId": 1591,
            "speakerName": "杜兰",
            "text": "但假如我去周围调查，说不定帕琪就会直接冲进神殿里去了。",
            "nextDialogs": [
              "200470109"
            ]
          },
          "200470109": {
            "id": "200470109",
            "speakerId": 1591,
            "speakerName": "杜兰",
            "text": "我得在这看着她，请你帮我去周围调查一下吧。",
            "nextDialogs": [
              "200470111",
              "200470114"
            ]
          },
          "200470111": {
            "id": "200470111",
            "speakerId": 1591,
            "speakerName": "杜兰",
            "text": "太好了，要看得仔细一些啊，任何细节都会影响冒险的成败。",
            "nextDialogs": [
              "200470112"
            ]
          },
          "200470112": {
            "id": "200470112",
            "speakerId": 1591,
            "speakerName": "杜兰",
            "text": "无论发现了什么，都带回来给我吧。"
          },
          "200470114": {
            "id": "200470114",
            "speakerId": 1591,
            "speakerName": "杜兰",
            "text": "不，不行！旧计划里有很多细节，我要和她重新讨论…",
            "nextDialogs": [
              "200470115"
            ]
          },
          "200470115": {
            "id": "200470115",
            "speakerId": 1591,
            "speakerName": "杜兰",
            "text": "你快点去调查新线索吧，拜托了！"
          }
        }
      }
    },
    {
      "subId": "2004702",
      "subQuestName": "前往调查遗迹",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "200470201"
        ],
        "dialogs": {
          "200470201": {
            "id": "200470201",
            "speakerId": 1591,
            "speakerName": "杜兰",
            "text": "你们调查到新线索了吗？",
            "nextDialogs": [
              "200470202"
            ]
          },
          "200470202": {
            "id": "200470202",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "还没有。",
            "nextDialogs": [
              "200470203"
            ]
          },
          "200470203": {
            "id": "200470203",
            "speakerId": 1591,
            "speakerName": "杜兰",
            "text": "这可是关乎到我们冒险的成败，一切就拜托你了！"
          }
        }
      }
    },
    {
      "subId": "2004703",
      "subQuestName": "前往调查遗迹",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "200470301"
        ],
        "dialogs": {
          "200470301": {
            "id": "200470301",
            "speakerId": 1591,
            "speakerName": "杜兰",
            "text": "调查到新线索了吗？",
            "nextDialogs": [
              "200470302"
            ]
          },
          "200470302": {
            "id": "200470302",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "有这些发现…",
            "nextDialogs": [
              "200470303"
            ]
          },
          "200470303": {
            "id": "200470303",
            "speakerId": 1591,
            "speakerName": "杜兰",
            "text": "…原来如此，原来如此。",
            "nextDialogs": [
              "200470304"
            ]
          },
          "200470304": {
            "id": "200470304",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "基本上就是这样。",
            "nextDialogs": [
              "200470305"
            ]
          },
          "200470305": {
            "id": "200470305",
            "speakerId": 1591,
            "speakerName": "杜兰",
            "text": "都是很有价值的线索，辛苦你了，这些就给你做谢礼吧。",
            "nextDialogs": [
              "200470306"
            ]
          },
          "200470306": {
            "id": "200470306",
            "speakerId": 1591,
            "speakerName": "杜兰",
            "text": "帕琪！冒险计划又可以更新了——"
          }
        }
      }
    },

            ]
          },
          "730640303": {
            "id": "730640303",
            "speakerId": 1000,
            "speakerName": "箱底的纸条",
            "text": "「正在看这个纸条的，随便谁都好，再告诉你一个好消息吧。」",
            "nextDialogs": [
              "730640304"
            ]
          },
          "730640304": {
            "id": "730640304",
            "speakerId": 1000,
            "speakerName": "箱底的纸条",
            "text": "「玻璃房子…就是禅什么园的地方附近，有月莲的水池，还有好东西。」",
            "nextDialogs": [
              "730640305"
            ]
          },
          "730640305": {
            "id": "730640305",
            "speakerId": 1000,
            "speakerName": "箱底的纸条",
            "text": "「离得这么近，满脑子研究和论文的呆瓜却一无所知，嘿嘿。」"
          }

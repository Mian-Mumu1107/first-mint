    {
      "subId": "7518503",
      "subQuestName": "(test)开启挑战$HIDDEN",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "751850301"
        ],
        "dialogs": {
          "751850301": {
            "id": "751850301",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "乌乌黑蛋是什么？",
            "nextDialogs": [
              "751850302"
            ]
          },
          "751850302": {
            "id": "751850302",
            "speakerId": 6345,
            "speakerName": "伦图",
            "text": "说到乌乌黑蛋，那可是只有我们火山地区才能创造的美食啊。",
            "nextDialogs": [
              "751850303"
            ]
          },
          "751850303": {
            "id": "751850303",
            "speakerId": 6345,
            "speakerName": "伦图",
            "text": "将鸟蛋放在地热喷口上，利用火山喷出的气态燃素进行烤制，等到火候正好的时刻取出，就能得到一枚完美的乌乌黑蛋。",
            "nextDialogs": [
              "751850304"
            ]
          },
          "751850304": {
            "id": "751850304",
            "speakerId": 6345,
            "speakerName": "伦图",
            "text": "不过，要是不小心烤焦了，味道就会变得相当……不同寻常。"
          }
        }
      }
    },
    {
      "subId": "7518502",
      "subQuestName": "(test)子任务描述Test$HIDDEN",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "751850401"
        ],
        "dialogs": {
          "751850401": {
            "id": "751850401",
            "speakerId": 6345,
            "speakerName": "伦图",
            "text": "两位真是好身手啊，咻咻咻地几下就完成了挑战。",
            "nextDialogs": [
              "751850402"
            ]
          },
          "751850402": {
            "id": "751850402",
            "speakerId": 6345,
            "speakerName": "伦图",
            "text": "让我看看——哦哦，这个黝黑的色泽和浓厚的气味，真是让人胃口大开啊。快趁热品尝吧！",
            "nextDialogs": [
              "751850403"
            ]
          },
          "751850403": {
            "id": "751850403",
            "speakerId": 6345,
            "speakerName": "伦图",
            "text": "这份食谱你们也拿着，以后如果还想品尝乌乌黑蛋，可以自己动手烹饪看看哦。"
          }
        }
      }
    },
    {
      "subId": "7518501",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "751850101"
        ],
        "dialogs": {
          "751850101": {
            "id": "751850101",
            "speakerId": 6345,
            "speakerName": "伦图",
            "text": "远道而来的异邦旅人，你们好啊！你们可曾听闻过我们沃陆之邦的特产美食——乌乌黑蛋？"
          }
        }
      }
    },
    {
      "subId": "7518502",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "751850201"
        ],
        "dialogs": {
          "751850201": {
            "id": "751850201",
            "speakerId": 6345,
            "speakerName": "伦图",
            "text": "现在只需要完成一个小小的「火山蛋挑战」——将那边的地热喷口打破，取出里面的乌乌黑蛋，就能品尝到新鲜出炉的美味了！"
          }
        }
      }
    },
    {
      "subId": "7518506",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "751850601"
        ],
        "dialogs": {
          "751850601": {
            "id": "751850601",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "还有别的事情要做。",
            "nextDialogs": [
              "751850602"
            ]
          },
          "751850602": {
            "id": "751850602",
            "speakerId": 6345,
            "speakerName": "伦图",
            "text": "好吧，等有时间了，别忘了来尝试啊！"
          }
        }
      }
    },
    {
      "subId": "7518507",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "751850701"
        ],
        "dialogs": {
          "751850701": {
            "id": "751850701",
            "speakerId": 6345,
            "speakerName": "伦图",
            "text": "是你们啊，身手矫健的异邦旅人。怎么样，有尝试自己动手制作乌乌黑蛋吗？",
            "nextDialogs": [
              "751850703",
              "751850706",
              "751850711"
            ]
          },
          "751850703": {
            "id": "751850703",
            "speakerId": 6345,
            "speakerName": "伦图",
            "text": "对吧，对吧，这可是蕴含了火山精华的美味啊。",
            "nextDialogs": [
              "751850704"
            ]
          },
          "751850704": {
            "id": "751850704",
            "speakerId": 6345,
            "speakerName": "伦图",
            "text": "据说每天都吃的话，能让身体变得越来越健壮呢！"
          },
          "751850706": {
            "id": "751850706",
            "speakerId": 6345,
            "speakerName": "伦图",
            "text": "哈哈哈，那个味道很让人印象深刻吧？",
            "nextDialogs": [
              "751850707"
            ]
          },
          "751850707": {
            "id": "751850707",
            "speakerId": 6345,
            "speakerName": "伦图",
            "text": "我倒是觉得吃习惯之后，也没那么难以下咽啦。"
          },
          "751850711": {
            "id": "751850711",
            "speakerId": 6345,
            "speakerName": "伦图",
            "text": "没问题，愿你旅途一切顺利！"
          }
        }
      }
    }
  ]

        "dialogs": {
          "741480101": {
            "id": "741480101",
            "speakerId": 13173,
            "speakerName": "留言",
            "text": "来到这个废弃了的湖中庇护所的朋友，请放心取走你需要的一切。",
            "nextDialogs": [
              "741480102"
            ]
          },
          "741480102": {
            "id": "741480102",
            "speakerId": 13173,
            "speakerName": "留言",
            "text": "对我们而言无用的财物，或许能救别人于水火之中。",
            "nextDialogs": [
              "741480103"
            ]
          },
          "741480103": {
            "id": "741480103",
            "speakerId": 13173,
            "speakerName": "留言",
            "text": "记住顺序：先是椅边的，然后是水中的，火旁的，最后是墙上的。"
          }
        }
      }
    },

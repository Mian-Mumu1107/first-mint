    "菲谢尔": 6,
    "阿贝多": 20
  },
  "subQuests": [
    {
      "subId": "4016501",
      "subQuestName": "等待至两天后",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "401650101"
        ],
        "dialogs": {
          "401650101": {
            "id": "401650101",
            "speakerId": 1000,
            "speakerName": "柑橘",
            "text": "二位的魔水来啦——！",
            "nextDialogs": [
              "401650102"
            ]
          },
          "401650102": {
            "id": "401650102",
            "speakerId": 1001,
            "speakerName": "凯亚",
            "text": "感谢你，美丽的女士。琴，不坐下来喝一杯吗？我帮你也点了一份。",
            "nextDialogs": [
              "401650103"
            ]
          },
          "401650103": {
            "id": "401650103",
            "speakerId": 1002,
            "speakerName": "琴",
            "text": "哎，是不是有些太松懈了呢。",
            "nextDialogs": [
              "401650104"
            ]
          },
          "401650104": {
            "id": "401650104",
            "speakerId": 1001,
            "speakerName": "凯亚",
            "text": "在担心小可莉吗？没关系，不是还有阿贝多陪着吗？",
            "nextDialogs": [
              "401650105"
            ]
          },
          "401650105": {
            "id": "401650105",
            "speakerId": 1003,
            "speakerName": "派蒙",
            "text": "琴团长和凯亚！你们怎么在这里？！",
            "nextDialogs": [
              "401650106"
            ]
          },
          "401650106": {
            "id": "401650106",
            "speakerId": 1001,
            "speakerName": "凯亚",
            "text": "#瞧瞧谁来了？这不是{NICKNAME}和派蒙吗？原来艾莉丝女士说的「惊喜」就是这个！",
            "nextDialogs": [
              "401650107"
            ]
          },
          "401650107": {
            "id": "401650107",
            "speakerId": 1002,
            "speakerName": "琴",
            "text": "二位好，没想到能在这里相遇。",
            "nextDialogs": [
              "401650108"
            ]
          },
          "401650108": {
            "id": "401650108",
            "speakerId": 1001,
            "speakerName": "凯亚",
            "text": "难道这里的人们交口称赞，拯救了世界的勇者就是你们二位？",
            "nextDialogs": [
              "401650109"
            ]
          },
          "401650109": {
            "id": "401650109",
            "speakerId": 1003,
            "speakerName": "派蒙",
            "text": "也不全是我们的功劳啦，要说的话，我们只是勇者小队的一员。",
            "nextDialogs": [
              "401650110"
            ]
          },
          "401650110": {
            "id": "401650110",
            "speakerId": 1001,
            "speakerName": "凯亚",
            "text": "那也很了不起嘛！果然真正优秀的骑士到哪里都不失「荣誉」之名。",
            "nextDialogs": [
              "401650111"
            ]
          },
          "401650111": {
            "id": "401650111",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "刚才说到艾莉丝女士和可莉…",
            "nextDialogs": [
              "401650112"
            ]
          },
          "401650112": {
            "id": "401650112",
            "speakerId": 1002,
            "speakerName": "琴",
            "text": "嗯，我们收到一封艾莉丝女士寄来的邀请函，她建议我们在空闲的时候，带可莉来童话世界度个假。",
            "nextDialogs": [
              "401650113"
            ]
          },
          "401650113": {
            "id": "401650113",
            "speakerId": 1001,
            "speakerName": "凯亚",
            "text": "原本还不知道她指的「童话世界」是什么意思呢，但现在看来，还真是个恰如其分的比喻。",
            "nextDialogs": [
              "401650114"
            ]
          },
          "401650114": {
            "id": "401650114",
            "speakerId": 1002,
            "speakerName": "琴",
            "text": "可莉刚进来就激动得到处跑，我有些担心，但阿贝多说他会照顾好可莉，让我们自由活动。",
            "nextDialogs": [
              "401650115"
            ]
          },
          "401650115": {
            "id": "401650115",
            "speakerId": 1001,
            "speakerName": "凯亚",
            "text": "此等美意，我们怎么好意思拒绝呢？于是我就拉上琴，到这个世界的酒馆来坐坐啦。",
            "nextDialogs": [
              "401650116"
            ]
          },
          "401650116": {
            "id": "401650116",
            "speakerId": 1003,
            "speakerName": "派蒙",
            "text": "我看你就是想趁机喝酒而已吧。",
            "nextDialogs": [
              "401650117"
            ]
          },
          "401650117": {
            "id": "401650117",
            "speakerId": 1001,
            "speakerName": "凯亚",
            "text": "哈哈，都出来休假了，就该好好享受一下嘛。",
            "nextDialogs": [
              "401650118"
            ]
          },
          "401650118": {
            "id": "401650118",
            "speakerId": 1002,
            "speakerName": "琴",
            "text": "…你说得对，我也该松松自己的弦。不然就辜负了艾莉丝女士的一番美意。",
            "nextDialogs": [
              "401650119"
            ]
          },
          "401650119": {
            "id": "401650119",
            "speakerId": 1003,
            "speakerName": "派蒙",
            "text": "哎！等等…你和酒保是怎么说的？",
            "nextDialogs": [
              "401650120"
            ]
          },
          "401650120": {
            "id": "401650120",
            "speakerId": 1001,
            "speakerName": "凯亚",
            "text": "当然是来一杯这个酒馆最纯正的饮品喽，这才能感受到不同世界的风土人情嘛。",
            "nextDialogs": [
              "401650121"
            ]
          },
          "401650121": {
            "id": "401650121",
            "speakerId": 1003,
            "speakerName": "派蒙",
            "text": "噗嗤…",
            "nextDialogs": [
              "401650122"
            ]
          },
          "401650122": {
            "id": "401650122",
            "speakerId": 1001,
            "speakerName": "凯亚",
            "text": "欸？派蒙你这是什么表情？",
            "nextDialogs": [
              "401650123"
            ]
          },
          "401650123": {
            "id": "401650123",
            "speakerId": 1003,
            "speakerName": "派蒙",
            "text": "没…没什么，我很欣赏你的生活方式，你喝，你快喝。",
            "nextDialogs": [
              "401650124"
            ]
          },
          "401650124": {
            "id": "401650124",
            "speakerId": 1001,
            "speakerName": "凯亚",
            "text": "嗯？那我是不是应该小心一下呢？这酒看起来色泽倒挺不错，味道…噗咳…咳咳…",
            "nextDialogs": [
              "401650125"
            ]
          },
          "401650125": {
            "id": "401650125",
            "speakerId": 1003,
            "speakerName": "派蒙",
            "text": "嘻嘻嘻嘻…",
            "nextDialogs": [
              "401650126"
            ]
          },
          "401650126": {
            "id": "401650126",
            "speakerId": 1002,
            "speakerName": "琴",
            "text": "…我那杯就不喝了吧。但不喝会不会有些浪费…",
            "nextDialogs": [
              "401650127"
            ]
          },
          "401650127": {
            "id": "401650127",
            "speakerId": 1001,
            "speakerName": "凯亚",
            "text": "好啊，派蒙，原来是这么回事。",
            "nextDialogs": [
              "401650128"
            ]
          },
          "401650128": {
            "id": "401650128",
            "speakerId": 1003,
            "speakerName": "派蒙",
            "text": "我…我也是上过一次当的！不是在针对你！",
            "nextDialogs": [
              "401650129"
            ]
          },
          "401650129": {
            "id": "401650129",
            "speakerId": 1001,
            "speakerName": "凯亚",
            "text": "对了，接到邀请的也不止我们，刚才我还见到了柯莱呢。她往那棵大树的方向去了，我没来得及叫她。",
            "nextDialogs": [
              "401650130"
            ]
          },
          "401650130": {
            "id": "401650130",
            "speakerId": 1003,
            "speakerName": "派蒙",
            "text": "是铃风王国那边吧？嘿嘿，这么多老朋友都来了，感觉就像聚会一样呢。我们去和她打个招呼吧？",
            "nextDialogs": [
              "401650131"
            ]
          },
          "401650131": {
            "id": "401650131",
            "speakerId": 1001,
            "speakerName": "凯亚",
            "text": "嗯，也代我向她问个好。",
            "nextDialogs": [
              "401650134"
            ]
          },
          "401650134": {
            "id": "401650134",
            "speakerId": 1002,
            "speakerName": "琴",
            "text": "也祝你旅途愉快。"
          }
        }
      }
    },
    {
      "subId": "4016502",
      "subQuestName": "返回赐福森林，寻找小杜林",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [],
        "dialogs": {}
      }
    },
    {
      "subId": "4016503",
      "subQuestName": "前往铃风王国，寻找柯莱",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "401650301"
        ],
        "dialogs": {
          "401650301": {
            "id": "401650301",
            "speakerId": 1004,
            "speakerName": "柯莱",
            "text": "这里的树屋构造…真奇妙。得赶紧记下来，回去告诉提纳里师父…",
            "nextDialogs": [
              "401650302"
            ]
          },
          "401650302": {
            "id": "401650302",
            "speakerId": 1003,
            "speakerName": "派蒙",
            "text": "柯莱！你好呀！",
            "nextDialogs": [
              "401650303"
            ]
          },
          "401650303": {
            "id": "401650303",
            "speakerId": 1004,
            "speakerName": "柯莱",
            "text": "#呃啊！吓我一跳…{NICKNAME}和派蒙？你们也是被邀请进来的吗？",
            "nextDialogs": [
              "401650304"
            ]
          },
          "401650304": {
            "id": "401650304",
            "speakerId": 1003,
            "speakerName": "派蒙",
            "text": "…我们倒希望下次能有邀请这一步。柯莱你在看什么呀？",
            "nextDialogs": [
              "401650305"
            ]
          },
          "401650305": {
            "id": "401650305",
            "speakerId": 1004,
            "speakerName": "柯莱",
            "text": "哦，我在观察总结这里的林木构造，还有居住在此的动物…或者说居民吧。他们竟然都是纸折出来的欸。",
            "nextDialogs": [
              "401650306"
            ]
          },
          "401650306": {
            "id": "401650306",
            "speakerId": 1003,
            "speakerName": "派蒙",
            "text": "不愧是巡林员呢。不过这里是魔法的世界，也不知道有没有参考价值…",
            "nextDialogs": [
              "401650307"
            ]
          },
          "401650307": {
            "id": "401650307",
            "speakerId": 1003,
            "speakerName": "派蒙",
            "text": "咦…？那个大脚印的旁边，原本有这些房屋吗？",
            "nextDialogs": [
              "401650308"
            ]
          },
          "401650308": {
            "id": "401650308",
            "speakerId": 1004,
            "speakerName": "柯莱",
            "text": "哦，我听生活在这里的飞鼠们说，这是一只小龙和一位戴帽子的人建的。",
            "nextDialogs": [
              "401650309"
            ]
          },
          "401650309": {
            "id": "401650309",
            "speakerId": 1003,
            "speakerName": "派蒙",
            "text": "是小杜林和阿帽！你知道他们去哪里了吗？",
            "nextDialogs": [
              "401650310"
            ]
          },
          "401650310": {
            "id": "401650310",
            "speakerId": 1004,
            "speakerName": "柯莱",
            "text": "听人说，他们造完房子之后，就往…星轨王城那边去了，我应该没念错名字吧？",
            "nextDialogs": [
              "401650311"
            ]
          },
          "401650311": {
            "id": "401650311",
            "speakerId": 1003,
            "speakerName": "派蒙",
            "text": "没念错，就是这个。还有，柯莱，从居民的语气中…呃，就是对那只小龙，他们是怎么评价的？",
            "nextDialogs": [
              "401650312"
            ]
          },
          "401650312": {
            "id": "401650312",
            "speakerId": 1004,
            "speakerName": "柯莱",
            "text": "唔…你这么一说的话，氛围好像的确有点不一般…",
            "nextDialogs": [
              "401650313"
            ]
          },
          "401650313": {
            "id": "401650313",
            "speakerId": 1003,
            "speakerName": "派蒙",
            "text": "啊…",
            "nextDialogs": [
              "401650314"
            ]
          },
          "401650314": {
            "id": "401650314",
            "speakerId": 1004,
            "speakerName": "柯莱",
            "text": "他们说了些关于「曾经的误会」和「接纳新成员」之类的话…",
            "nextDialogs": [
              "401650315"
            ]
          },
          "401650315": {
            "id": "401650315",
            "speakerId": 1004,
            "speakerName": "柯莱",
            "text": "我刚来没多久，还不知道这个世界发生过什么。但大家似乎挺感谢他们建的新房子，还说要办一场迎新会什么的。",
            "nextDialogs": [
              "401650316"
            ]
          },
          "401650316": {
            "id": "401650316",
            "speakerId": 1003,
            "speakerName": "派蒙",
            "text": "吓死我了。那听起来也算是在慢慢融入森林了呢，至少是迈出了不错的一步。",
            "nextDialogs": [
              "401650317"
            ]
          },
          "401650317": {
            "id": "401650317",
            "speakerId": 1004,
            "speakerName": "柯莱",
            "text": "你们有事要找那只小龙吗？",
            "nextDialogs": [
              "401650318"
            ]
          },
          "401650318": {
            "id": "401650318",
            "speakerId": 1003,
            "speakerName": "派蒙",
            "text": "嗯，他是我们在这个世界新交的朋友。",
            "nextDialogs": [
              "401650319"
            ]
          },
          "401650319": {
            "id": "401650319",
            "speakerId": 1004,
            "speakerName": "柯莱",
            "text": "欸？真的吗？越来越在意你们的故事了…",
            "nextDialogs": [
              "401650320"
            ]
          },
          "401650320": {
            "id": "401650320",
            "speakerId": 1004,
            "speakerName": "柯莱",
            "text": "唔…不行不行，果然还是留到下次吧，我先抓紧时间在这个奇妙的世界多逛逛！",
            "nextDialogs": [
              "401650321"
            ]
          },
          "401650321": {
            "id": "401650321",
            "speakerId": 1003,
            "speakerName": "派蒙",
            "text": "嘿嘿，不用着急啦，像凯亚那样慢慢享受也不错。哦对了，凯亚让我们代他向你问好。",
            "nextDialogs": [
              "401650322"
            ]
          },
          "401650322": {
            "id": "401650322",
            "speakerId": 1004,
            "speakerName": "柯莱",
            "text": "凯亚先生也在？嗯…那我也得去和他打个招呼。",
            "nextDialogs": [
              "401650323"
            ]
          },
          "401650323": {
            "id": "401650323",
            "speakerId": 1003,
            "speakerName": "派蒙",
            "text": "他恐怕在喝醉之前会一直待在酒馆的啦，而且他是那种怎么喝都喝不醉的人吧，所以什么时候去都行啦。",
            "nextDialogs": [
              "401650324"
            ]
          },
          "401650324": {
            "id": "401650324",
            "speakerId": 1004,
            "speakerName": "柯莱",
            "text": "哈哈…你说得对。那就把见他的事往后放一放吧。",
            "nextDialogs": [
              "401650325"
            ]
          },
          "401650325": {
            "id": "401650325",
            "speakerId": 1003,
            "speakerName": "派蒙",
            "text": "那我们差不多去王城一趟吧？希望小杜林他们还在。",
            "nextDialogs": [
              "401650326"
            ]
          },
          "401650326": {
            "id": "401650326",
            "speakerId": 1004,
            "speakerName": "柯莱",
            "text": "哦对了，最近须弥好像发生了有趣的事。提纳里师父也在忙着些什么，你们有时间的话可以去看看。",
            "nextDialogs": [
              "401650327"
            ]
          },
          "401650327": {
            "id": "401650327",
            "speakerId": 1003,
            "speakerName": "派蒙",
            "text": "好！那我们找机会回须弥一趟。",
            "nextDialogs": [
              "401650330"
            ]
          },
          "401650330": {
            "id": "401650330",
            "speakerId": 1004,
            "speakerName": "柯莱",
            "text": "好，回头见！"
          }
        }
      }
    },
    {
      "subId": "4016504",
      "subQuestName": "前往星轨王城顶端的星间庭园",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "401650501"
        ],
        "dialogs": {
          "401650501": {
            "id": "401650501",
            "speakerId": 1005,
            "speakerName": "莫娜",
            "text": "啊？我看错了吧？",
            "nextDialogs": [
              "401650502"
            ]
          },
          "401650502": {
            "id": "401650502",
            "speakerId": 1005,
            "speakerName": "莫娜",
            "text": "怎么可能…真是难以置信…",
            "nextDialogs": [
              "401650503"
            ]
          },
          "401650503": {
            "id": "401650503",
            "speakerId": 1003,
            "speakerName": "派蒙",
            "text": "莫娜，你好呀！好远就听到你一个人嘀嘀咕咕的声音。",
            "nextDialogs": [
              "401650504"
            ]
          },
          "401650504": {
            "id": "401650504",
            "speakerId": 1003,
            "speakerName": "派蒙",
            "text": "你的水占盘又出问题了吗？",
            "nextDialogs": [
              "401650505"
            ]
          },
          "401650505": {
            "id": "401650505",
            "speakerId": 1005,
            "speakerName": "莫娜",
            "text": "是你们啊，拯救了世界的英雄。我的水占盘好得很，出问题的可能是我的眼睛。",
            "nextDialogs": [
              "401650506"
            ]
          },
          "401650506": {
            "id": "401650506",
            "speakerId": 1005,
            "speakerName": "莫娜",
            "text": "你们看，看这个女神像。",
            "nextDialogs": [
              "401650507"
            ]
          },
          "401650507": {
            "id": "401650507",
            "speakerId": 1003,
            "speakerName": "派蒙",
            "text": "怎么了吗？没见到哪里缺了个角呀？不就是「预言女神」，你的师父嘛。",
            "nextDialogs": [
              "401650508"
            ]
          },
          "401650508": {
            "id": "401650508",
            "speakerId": 1005,
            "speakerName": "莫娜",
            "text": "我才不信呢！那个老太婆哪长这个样子。",
            "nextDialogs": [
              "401650509"
            ]
          },
          "401650509": {
            "id": "401650509",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "说不定是年轻的时候？",
            "nextDialogs": [
              "401650510"
            ]
          },
          "401650510": {
            "id": "401650510",
            "speakerId": 1005,
            "speakerName": "莫娜",
            "text": "年轻的时候…呃…这么说来，倒的确挺像她那本少女日记里写的爱赶时髦的样子…",
            "nextDialogs": [
              "401650511"
            ]
          },
          "401650511": {
            "id": "401650511",
            "speakerId": 1005,
            "speakerName": "莫娜",
            "text": "这话不会被老太婆听见吧？总觉得背后阴嗖嗖的。",
            "nextDialogs": [
              "401650512"
            ]
          },
          "401650512": {
            "id": "401650512",
            "speakerId": 1003,
            "speakerName": "派蒙",
            "text": "这么在人家雕像底下议论好像是不太好。",
            "nextDialogs": [
              "401650513"
            ]
          },
          "401650513": {
            "id": "401650513",
            "speakerId": 1003,
            "speakerName": "派蒙",
            "text": "不过，既然莫娜都没见过你师父年轻时的样子，你先前是怎么知道这雕像是她的？",
            "nextDialogs": [
              "401650514"
            ]
          },
          "401650514": {
            "id": "401650514",
            "speakerId": 1005,
            "speakerName": "莫娜",
            "text": "我进来时用水占盘算了算，结果星空的「倒影」却令我大为惊讶，像是将提瓦特作为了这个「希穆兰卡」世界命运的基底。",
            "nextDialogs": [
              "401650515"
            ]
          },
          "401650515": {
            "id": "401650515",
            "speakerId": 1005,
            "speakerName": "莫娜",
            "text": "现实命运的「映射」，真实世界的「虚像」…",
            "nextDialogs": [
              "401650516"
            ]
          },
          "401650516": {
            "id": "401650516",
            "speakerId": 1005,
            "speakerName": "莫娜",
            "text": "嗯…通俗点说，你就理解成「创造者」是在一面镜子，或者一汪湖水的倒影中创造了这个世界。",
            "nextDialogs": [
              "401650517"
            ]
          },
          "401650517": {
            "id": "401650517",
            "speakerId": 1003,
            "speakerName": "派蒙",
            "text": "听着还是很了不起的嘛。",
            "nextDialogs": [
              "401650518"
            ]
          },
          "401650518": {
            "id": "401650518",
            "speakerId": 1005,
            "speakerName": "莫娜",
            "text": "继续观测下去，那些占式就越来越熟悉，一看就是老太婆的手笔…但它们远比想象的复杂，现在的我光是解读就已经很费力了。",
            "nextDialogs": [
              "401650519"
            ]
          },
          "401650519": {
            "id": "401650519",
            "speakerId": 1005,
            "speakerName": "莫娜",
            "text": "后来我就去找人打听了一下。「司掌星辰与轨迹」，她还真是演都不演，彻底陶醉在她的创作里了…",
            "nextDialogs": [
              "401650520"
            ]
          },
          "401650520": {
            "id": "401650520",
            "speakerId": 1005,
            "speakerName": "莫娜",
            "text": "跟那本日记的风格倒也对得上…咳咳，不对！我们还是换个话题吧。",
            "nextDialogs": [
              "401650521"
            ]
          },
          "401650521": {
            "id": "401650521",
            "speakerId": 1003,
            "speakerName": "派蒙",
            "text": "啊，莫娜！你见到过一只小龙吗？差不多和我一样大，扇着小小的翅膀。",
            "nextDialogs": [
              "401650522"
            ]
          },
          "401650522": {
            "id": "401650522",
            "speakerId": 1005,
            "speakerName": "莫娜",
            "text": "曾经闯祸的那位是吧？我没亲眼见到，但听说他不久前来王城向人们道歉，还带了很多积木矿和植物油作为赔礼。",
            "nextDialogs": [
              "401650523"
            ]
          },
          "401650523": {
            "id": "401650523",
            "speakerId": 1005,
            "speakerName": "莫娜",
            "text": "大多数人接受了他的赔罪，但也有些人说，要看他未来的行为再做判断。",
            "nextDialogs": [
              "401650524"
            ]
          },
          "401650524": {
            "id": "401650524",
            "speakerId": 1003,
            "speakerName": "派蒙",
            "text": "这样啊。那你知道要去哪儿找他吗？",
            "nextDialogs": [
              "401650525"
            ]
          },
          "401650525": {
            "id": "401650525",
            "speakerId": 1005,
            "speakerName": "莫娜",
            "text": "稍等…",
            "nextDialogs": [
              "401650526"
            ]
          },
          "401650526": {
            "id": "401650526",
            "speakerId": 1005,
            "speakerName": "莫娜",
            "text": "哦，他现在在破碎之海那边，身边还有不少人在呢。",
            "nextDialogs": [
              "401650527"
            ]
          },
          "401650527": {
            "id": "401650527",
            "speakerId": 1003,
            "speakerName": "派蒙",
            "text": "那莫娜要一起来吗？",
            "nextDialogs": [
              "401650528"
            ]
          },
          "401650528": {
            "id": "401650528",
            "speakerId": 1005,
            "speakerName": "莫娜",
            "text": "我就不凑热闹了吧，难得可以跟年轻的老太婆待一会儿，琢磨琢磨她布下的星轨。你们好好玩。",
            "nextDialogs": [
              "401650530",
              "401650532"
            ]
          },
          "401650530": {
            "id": "401650530",
            "speakerId": 1005,
            "speakerName": "莫娜",
            "text": "为什么是小心啦？这么说才会让人紧张吧！",
            "nextDialogs": [
              "401650533"
            ]
          },
          "401650533": {
            "id": "401650533",
            "speakerId": 1003,
            "speakerName": "派蒙",
            "text": "我们走啦！拜拜哦莫娜！"
          },
          "401650532": {
            "id": "401650532",
            "speakerId": 1005,
            "speakerName": "莫娜",
            "text": "哪里的话。"
          }
        }
      }
    },
    {
      "subId": "4016505",
      "subQuestName": "前往破碎之海，寻找小杜林",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "401650701"
        ],
        "dialogs": {
          "401650701": {
            "id": "401650701",
            "speakerId": 1006,
            "speakerName": "菲谢尔",
            "text": "奥兹华尔多·赫芙那梵茵斯…告诉我，此刻映照于我览遍三千世界断罪之眼中的景象绝非虚妄！",
            "nextDialogs": [
              "401650702"
            ]
          },
          "401650702": {
            "id": "401650702",
            "speakerId": 1007,
            "speakerName": "奥兹",
            "text": "小姐，你没看错。",
            "nextDialogs": [
              "401650703"
            ]
          },
          "401650703": {
            "id": "401650703",
            "speakerId": 1006,
            "speakerName": "菲谢尔",
            "text": "那我将以幽夜净土的王室之礼向二位行以问候。千星之国的至高夜龙，以及他身侧冠帽的扈从。",
            "nextDialogs": [
              "401650704"
            ]
          },
          "401650704": {
            "id": "401650704",
            "speakerId": 1008,
            "speakerName": "Wanderer",
            "text": "你说谁是扈从？",
            "nextDialogs": [
              "401650705"
            ]
          },
          "401650705": {
            "id": "401650705",
            "speakerId": 1007,
            "speakerName": "奥兹",
            "text": "小姐的意思是，二位好，很高兴认识你们。",
            "nextDialogs": [
              "401650706"
            ]
          },
          "401650706": {
            "id": "401650706",
            "speakerId": 1009,
            "speakerName": "小杜林",
            "text": "你们好！我也很高兴认识你们，但阿帽是我的朋友，不是扈从。",
            "nextDialogs": [
              "401650707"
            ]
          },
          "401650707": {
            "id": "401650707",
            "speakerId": 1008,
            "speakerName": "Wanderer",
            "text": "…啧，没必要解释。",
            "nextDialogs": [
              "401650708"
            ]
          },
          "401650708": {
            "id": "401650708",
            "speakerId": 1003,
            "speakerName": "派蒙",
            "text": "阿帽！小杜林！终于找到你们了！哇，还有菲谢尔你们也在？",
            "nextDialogs": [
              "401650709"
            ]
          },
          "401650709": {
            "id": "401650709",
            "speakerId": 1006,
            "speakerName": "菲谢尔",
            "text": "哦呵呵！受幽夜净土祝圣的异世旅人！汝于此星空下与本皇女相遇一定也是命运的选择！",
            "nextDialogs": [
              "401650712"
            ]
          },
          "401650712": {
            "id": "401650712",
            "speakerId": 1010,
            "speakerName": "可莉",
            "text": "#荣誉骑士{M#哥哥}{F#姐姐}和小派蒙！",
            "nextDialogs": [
              "401650713"
            ]
          },
          "401650713": {
            "id": "401650713",
            "speakerId": 1011,
            "speakerName": "阿贝多",
            "text": "二位别来无恙。",
            "nextDialogs": [
              "401650714"
            ]
          },
          "401650714": {
            "id": "401650714",
            "speakerId": 1003,
            "speakerName": "派蒙",
            "text": "嘿嘿，小可莉在这里玩得还开心吗？",
            "nextDialogs": [
              "401650715"
            ]
          },
          "401650715": {
            "id": "401650715",
            "speakerId": 1010,
            "speakerName": "可莉",
            "text": "开心！有好多好多可爱的小动物！好长好长的魔法小火车！还有好高好高的国王大城堡！",
            "nextDialogs": [
              "401650716"
            ]
          },
          "401650716": {
            "id": "401650716",
            "speakerId": 1011,
            "speakerName": "阿贝多",
            "text": "我带可莉走过一圈，沿路收获不少，不愧是艾莉丝女士的魔法。",
            "nextDialogs": [
              "401650717"
            ]
          },
          "401650717": {
            "id": "401650717",
            "speakerId": 1010,
            "speakerName": "可莉",
            "text": "妈妈好厉害！可莉也想造大大的房子！",
            "nextDialogs": [
              "401650718"
            ]
          },
          "401650718": {
            "id": "401650718",
            "speakerId": 1009,
            "speakerName": "小杜林",
            "text": "可莉的妈妈，是我妈妈的朋友？",
            "nextDialogs": [
              "401650719"
            ]
          },
          "401650719": {
            "id": "401650719",
            "speakerId": 1010,
            "speakerName": "可莉",
            "text": "嗯！妈妈以前经常念故事给我听，小杜林哥哥的妈妈写故事真好看！",
            "nextDialogs": [
              "401650720"
            ]
          },
          "401650720": {
            "id": "401650720",
            "speakerId": 1009,
            "speakerName": "小杜林",
            "text": "小杜林…哥哥？",
            "nextDialogs": [
              "401650721"
            ]
          },
          "401650721": {
            "id": "401650721",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "当哥哥了呢。",
            "nextDialogs": [
              "401650722"
            ]
          },
          "401650722": {
            "id": "401650722",
            "speakerId": 1009,
            "speakerName": "小杜林",
            "text": "哇…谢谢可莉！阿帽，我能和可莉一起去玩吗？",
            "nextDialogs": [
              "401650723"
            ]
          },
          "401650723": {
            "id": "401650723",
            "speakerId": 1008,
            "speakerName": "Wanderer",
            "text": "随你便。",
            "nextDialogs": [
              "401650724"
            ]
          },
          "401650724": {
            "id": "401650724",
            "speakerId": 1010,
            "speakerName": "可莉",
            "text": "阿贝多哥哥，阿贝多哥哥…",
            "nextDialogs": [
              "401650725"
            ]
          },
          "401650725": {
            "id": "401650725",
            "speakerId": 1011,
            "speakerName": "阿贝多",
            "text": "去吧，别跑太远，我会来接你的。",
            "nextDialogs": [
              "401650726"
            ]
          },
          "401650726": {
            "id": "401650726",
            "speakerId": 1010,
            "speakerName": "可莉",
            "text": "嗯！我们走吧，小杜林！菲谢尔姐姐也来吗？",
            "nextDialogs": [
              "401650727"
            ]
          },
          "401650727": {
            "id": "401650727",
            "speakerId": 1006,
            "speakerName": "菲谢尔",
            "text": "哼哼！本皇女接受你们的邀请。庆贺吧！即使你们藏身于迷雾之中，也将有幸一睹此断罪之眼的威姿！",
            "nextDialogs": [
              "401650728"
            ]
          },
          "401650728": {
            "id": "401650728",
            "speakerId": 1007,
            "speakerName": "奥兹",
            "text": "小姐说，大家可以一起玩捉迷藏，她来当鬼。",
            "nextDialogs": [
              "401650729"
            ]
          },
          "401650729": {
            "id": "401650729",
            "speakerId": 1010,
            "speakerName": "可莉",
            "text": "好耶！捉迷藏！",
            "nextDialogs": [
              "401650730"
            ]
          },
          "401650730": {
            "id": "401650730",
            "speakerId": 1009,
            "speakerName": "小杜林",
            "text": "捉迷藏！",
            "nextDialogs": [
              "401650731"
            ]
          },
          "401650731": {
            "id": "401650731",
            "speakerId": 1011,
            "speakerName": "阿贝多",
            "text": "说回刚才的话题，阿帽先生，你所说的预言一事…",
            "nextDialogs": [
              "401650732"
            ]
          },
          "401650732": {
            "id": "401650732",
            "speakerId": 1008,
            "speakerName": "Wanderer",
            "text": "我当时听到「B」对「M」这么说——",
            "nextDialogs": [
              "401650733"
            ]
          },
          "401650733": {
            "id": "401650733",
            "speakerId": 1012,
            "speakerName": "「B」",
            "text": "看在你这么执着的份上，我就告诉你一个秘密吧…",
            "nextDialogs": [
              "401650734"
            ]
          },
          "401650734": {
            "id": "401650734",
            "speakerId": 1012,
            "speakerName": "「B」",
            "text": "「R」的孩子，有朝一日会复活哟。",
            "nextDialogs": [
              "401650735"
            ]
          },
          "401650735": {
            "id": "401650735",
            "speakerId": 1003,
            "speakerName": "派蒙",
            "text": "欸？那位观星的魔女说…龙脊雪山的杜林…会复活？",
            "nextDialogs": [
              "401650736"
            ]
          },
          "401650736": {
            "id": "401650736",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "我也很惊讶…",
            "nextDialogs": [
              "401650737"
            ]
          },
          "401650737": {
            "id": "401650737",
            "speakerId": 1008,
            "speakerName": "Wanderer",
            "text": "都是记忆中的景象，错了也别赖到我头上。",
            "nextDialogs": [
              "401650738"
            ]
          },
          "401650738": {
            "id": "401650738",
            "speakerId": 1011,
            "speakerName": "阿贝多",
            "text": "我明白了。我最近在龙脊雪山的观察结果也佐证了这个预言。",
            "nextDialogs": [
              "401650739"
            ]
          },
          "401650739": {
            "id": "401650739",
            "speakerId": 1011,
            "speakerName": "阿贝多",
            "text": "相较以往，杜林的心脏正在慢慢活跃起来。虽然过程十分缓慢，但已显出趋势…",
            "nextDialogs": [
              "401650740"
            ]
          },
          "401650740": {
            "id": "401650740",
            "speakerId": 1003,
            "speakerName": "派蒙",
            "text": "唔…那我们该怎么做？",
            "nextDialogs": [
              "401650741"
            ]
          },
          "401650741": {
            "id": "401650741",
            "speakerId": 1011,
            "speakerName": "阿贝多",
            "text": "先制定应对各种情况的策略，当然也包括最坏的情况…",
            "nextDialogs": [
              "401650742"
            ]
          },
          "401650742": {
            "id": "401650742",
            "speakerId": 1008,
            "speakerName": "Wanderer",
            "text": "……",
            "nextDialogs": [
              "401650743"
            ]
          },
          "401650743": {
            "id": "401650743",
            "speakerId": 1011,
            "speakerName": "阿贝多",
            "text": "我了解杜林的过去，并不希望事态发展到那一步。但凡事都需做好充足的准备。",
            "nextDialogs": [
              "401650744"
            ]
          },
          "401650744": {
            "id": "401650744",
            "speakerId": 1011,
            "speakerName": "阿贝多",
            "text": "如果正如预言所说，杜林的心脏终将跳动如常，我会希望复活的并非「邪龙」…",
            "nextDialogs": [
              "401650745"
            ]
          },
          "401650745": {
            "id": "401650745",
            "speakerId": 1011,
            "speakerName": "阿贝多",
            "text": "你们能明白我的意思吗？",
            "nextDialogs": [
              "401650746"
            ]
          },
          "401650746": {
            "id": "401650746",
            "speakerId": 1003,
            "speakerName": "派蒙",
            "text": "隐隐约约…马马虎虎？",
            "nextDialogs": [
              "401650747"
            ]
          },
          "401650747": {
            "id": "401650747",
            "speakerId": 1011,
            "speakerName": "阿贝多",
            "text": "为此…阿帽先生，届时能请你和希穆兰卡的杜林也助我们一臂之力吗？",
            "nextDialogs": [
              "401650748"
            ]
          },
          "401650748": {
            "id": "401650748",
            "speakerId": 1008,
            "speakerName": "Wanderer",
            "text": "啊？还有我的事？",
            "nextDialogs": [
              "401650749"
            ]
          },
          "401650749": {
            "id": "401650749",
            "speakerId": 1011,
            "speakerName": "阿贝多",
            "text": "你在希穆兰卡的世界拯救了杜林，我认为这不是偶然。",
            "nextDialogs": [
              "401650750"
            ]
          },
          "401650750": {
            "id": "401650750",
            "speakerId": 1011,
            "speakerName": "阿贝多",
            "text": "如果三位女神的此中作为存在意义，除去浪漫的解读之外，我可以做出大胆猜测…",
            "nextDialogs": [
              "401650751"
            ]
          },
          "401650751": {
            "id": "401650751",
            "speakerId": 1011,
            "speakerName": "阿贝多",
            "text": "此片映射之天的命运，或许也能对彼处产生影响。",
            "nextDialogs": [
              "401650752"
            ]
          },
          "401650752": {
            "id": "401650752",
            "speakerId": 1011,
            "speakerName": "阿贝多",
            "text": "如果龙脊雪山的杜林将要复活，我们会需要小杜林…以及与其命运交错的你的帮助。",
            "nextDialogs": [
              "401650753"
            ]
          },
          "401650753": {
            "id": "401650753",
            "speakerId": 1008,
            "speakerName": "Wanderer",
            "text": "啧…麻烦。",
            "nextDialogs": [
              "401650754"
            ]
          },
          "401650754": {
            "id": "401650754",
            "speakerId": 1011,
            "speakerName": "阿贝多",
            "text": "的确不会容易。",
            "nextDialogs": [
              "401650755"
            ]
          },
          "401650755": {
            "id": "401650755",
            "speakerId": 1010,
            "speakerName": "可莉",
            "text": "阿贝多哥哥！那边有一个小纸船欸！能飘在空中的那种！要和可莉一起去看吗！",
            "nextDialogs": [
              "401650756"
            ]
          },
          "401650756": {
            "id": "401650756",
            "speakerId": 1011,
            "speakerName": "阿贝多",
            "text": "好，我这就来。",
            "nextDialogs": [
              "401650757"
            ]
          },
          "401650757": {
            "id": "401650757",
            "speakerId": 1011,
            "speakerName": "阿贝多",
            "text": "请再考虑一下我的建议，阿帽先生。",
            "nextDialogs": [
              "401650758"
            ]
          },
          "401650758": {
            "id": "401650758",
            "speakerId": 1008,
            "speakerName": "Wanderer",
            "text": "……",
            "nextDialogs": [
              "401650759"
            ]
          },
          "401650759": {
            "id": "401650759",
            "speakerId": 1009,
            "speakerName": "小杜林",
            "text": "阿帽，我回来了。嗯？你们刚才聊什么了吗？",
            "nextDialogs": [
              "401650760"
            ]
          },
          "401650760": {
            "id": "401650760",
            "speakerId": 1008,
            "speakerName": "Wanderer",
            "text": "没什么。",
            "nextDialogs": [
              "401650761"
            ]
          },
          "401650761": {
            "id": "401650761",
            "speakerId": 1003,
            "speakerName": "派蒙",
            "text": "……",
            "nextDialogs": [
              "401650762"
            ]
          },
          "401650762": {
            "id": "401650762",
            "speakerId": 1009,
            "speakerName": "小杜林",
            "text": "嗯？那我们也一起过去吧，大家都在我们新做的小船那里呢！",
            "nextDialogs": [
              "401650763"
            ]
          },
          "401650763": {
            "id": "401650763",
            "speakerId": 1008,
            "speakerName": "Wanderer",
            "text": "…好，我这就来。"
          }
        }
      }
    },
    {
      "subId": "4016502",

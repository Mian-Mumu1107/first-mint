          "401650201": {
            "id": "401650201",
            "speakerId": 1001,
            "speakerName": "凯亚",
            "text": "原来魔水就是墨水…真是神奇。",
            "nextDialogs": [
              "401650202"
            ]
          },
          "401650202": {
            "id": "401650202",
            "speakerId": 1001,
            "speakerName": "凯亚",
            "text": "柑橘女士，请问有没有不加魔水的饮品？",
            "nextDialogs": [
              "401650203"
            ]
          },
          "401650203": {
            "id": "401650203",
            "speakerId": 1000,
            "speakerName": "柑橘",
            "text": "当然有，要什么口味？",
            "nextDialogs": [
              "401650204"
            ]
          },
          "401650204": {
            "id": "401650204",
            "speakerId": 1001,
            "speakerName": "凯亚",
            "text": "日落果？琴，你感兴趣吗？",
            "nextDialogs": [
              "401650205"
            ]
          },
          "401650205": {
            "id": "401650205",
            "speakerId": 1002,
            "speakerName": "琴",
            "text": "…好，那我也要一杯。",
            "nextDialogs": [
              "401650206"
            ]
          },
          "401650206": {
            "id": "401650206",
            "speakerId": 1000,
            "speakerName": "柑橘",
            "text": "好嘞，两杯日落果口味！马上就来！"
          }
        }
      }
    },
    {

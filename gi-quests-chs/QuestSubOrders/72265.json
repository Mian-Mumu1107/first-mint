    {
      "subId": "7226508",
      "subQuestName": "与柳达希卡谈谈",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "722650801"
        ],
        "dialogs": {
          "722650801": {
            "id": "722650801",
            "speakerId": 1003,
            "speakerName": "柳达希卡·雪奈茨芙娜",
            "text": "咳…咳咳咳！呼…呼…",
            "nextDialogs": [
              "722650802"
            ]
          },
          "722650802": {
            "id": "722650802",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "喂，你还好吗？",
            "nextDialogs": [
              "722650803"
            ]
          },
          "722650803": {
            "id": "722650803",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "抱歉，下手有点重。",
            "nextDialogs": [
              "722650804"
            ]
          },
          "722650804": {
            "id": "722650804",
            "speakerId": 1003,
            "speakerName": "柳达希卡·雪奈茨芙娜",
            "text": "呼…为什么，不干脆了结掉我？",
            "nextDialogs": [
              "722650805"
            ]
          },
          "722650805": {
            "id": "722650805",
            "speakerId": 1003,
            "speakerName": "柳达希卡·雪奈茨芙娜",
            "text": "你们应该是想知道我身上那张「最终指令」的内容吧。只要干掉我，一切不就很简单了吗？",
            "nextDialogs": [
              "722650806"
            ]
          },
          "722650806": {
            "id": "722650806",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "对，那样确实很简单。",
            "nextDialogs": [
              "722650807"
            ]
          },
          "722650807": {
            "id": "722650807",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "而且对你而言也是种「解脱」吧。",
            "nextDialogs": [
              "722650808"
            ]
          },
          "722650808": {
            "id": "722650808",
            "speakerId": 1003,
            "speakerName": "柳达希卡·雪奈茨芙娜",
            "text": "……",
            "nextDialogs": [
              "722650809"
            ]
          },
          "722650809": {
            "id": "722650809",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "#玄冬…不，柳达希卡小姐，我们其实已经发现了，你刚才虽然气势汹汹地冲了过来，但你和{NICKNAME}战斗的时候，根本就没有用全力吧？",
            "nextDialogs": [
              "722650812"
            ]
          },
          "722650812": {
            "id": "722650812",
            "speakerId": 1003,
            "speakerName": "柳达希卡·雪奈茨芙娜",
            "text": "欸！不…不至于吧，真的有那么假吗？！",
            "nextDialogs": [
              "722650813"
            ]
          },
          "722650813": {
            "id": "722650813",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "但你想要自我了断是真的。",
            "nextDialogs": [
              "722650814"
            ]
          },
          "722650814": {
            "id": "722650814",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "柳达希卡小姐，我们刚才听到了你和那个「老师」的谈话，你似乎有一些苦衷。能和我们讲讲吗？我们可以帮你的！",
            "nextDialogs": [
              "722650815"
            ]
          },
          "722650815": {
            "id": "722650815",
            "speakerId": 1003,
            "speakerName": "柳达希卡·雪奈茨芙娜",
            "text": "但是我…我是愚人众啊。"
          }
        }
      }
    },
    {
      "subId": "7226509",
      "subQuestName": "向百代报告跟踪结果",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "722650901"
        ],
        "dialogs": {
          "722650901": {
            "id": "722650901",
            "speakerId": 1004,
            "speakerName": "百代",
            "text": "怎么才回来？情报拿到了吗？"
          }
        }
      }
    },
    {
      "subId": "7226517",
      "subQuestName": "向百代报告信息-跟百代对话",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "722651701"
        ],
        "dialogs": {
          "722651701": {
            "id": "722651701",
            "speakerId": 1004,
            "speakerName": "百代",
            "text": "做的不错，有了这个东西，就能够挫败愚人众的阴谋了。我马上就去找人安排后续的行动，你们就不用担心了。",
            "nextDialogs": [
              "722651702"
            ]
          },
          "722651702": {
            "id": "722651702",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "那个，百代小姐，其实我们有一件事想求你…",
            "nextDialogs": [
              "722651703"
            ]
          },
          "722651703": {
            "id": "722651703",
            "speakerId": 1005,
            "speakerName": "Black Screen",
            "text": "把刚才发生的事详细告诉了百代。",
            "nextDialogs": [
              "722651704"
            ]
          },
          "722651704": {
            "id": "722651704",
            "speakerId": 1004,
            "speakerName": "百代",
            "text": "……",
            "nextDialogs": [
              "722651705"
            ]
          },
          "722651705": {
            "id": "722651705",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "呜，百代小姐，你不要这样盯着我嘛！你…你就说好不好嘛！",
            "nextDialogs": [
              "722651706"
            ]
          },
          "722651706": {
            "id": "722651706",
            "speakerId": 1004,
            "speakerName": "百代",
            "text": "你们想救愚人众？这关我什么事？！",
            "nextDialogs": [
              "722651707"
            ]
          },
          "722651707": {
            "id": "722651707",
            "speakerId": 1004,
            "speakerName": "百代",
            "text": "那个女人顶替了我的位置，如果不是因为你们之前误打误撞，终末番很可能就会遇到重大危机！",
            "nextDialogs": [
              "722651708"
            ]
          },
          "722651708": {
            "id": "722651708",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "#{NICKNAME}，你也想办法劝劝百代小姐吧，要不然柳达希卡小姐就性命难保了！",
            "nextDialogs": [
              "722651712"
            ]
          },
          "722651712": {
            "id": "722651712",
            "speakerId": 1004,
            "speakerName": "百代",
            "text": "哼，没用的。我已经说过了，愚人众和我没关系！",
            "nextDialogs": [
              "722651713"
            ]
          },
          "722651713": {
            "id": "722651713",
            "speakerId": 1004,
            "speakerName": "百代",
            "text": "而且你们以为，伪造人体是这么轻松的事吗？这几天你们去探听情报的时候，我没日没夜地工作，才把他们要的假人做完。",
            "nextDialogs": [
              "722651714"
            ]
          },
          "722651714": {
            "id": "722651714",
            "speakerId": 1004,
            "speakerName": "百代",
            "text": "需要那么多<color=#00E1FFFF>兽肉</color>才能凑够一个人的重量！还要把<color=#00E1FFFF>白铁块</color>和其他许多材料烧在一起伪造成骨头！",
            "nextDialogs": [
              "722651715"
            ]
          },
          "722651715": {
            "id": "722651715",
            "speakerId": 1004,
            "speakerName": "百代",
            "text": "如果不放<color=#00E1FFFF>海灵芝</color>，脂肪含量不足，效果就不够逼真。",
            "nextDialogs": [
              "722651716"
            ]
          },
          "722651716": {
            "id": "722651716",
            "speakerId": 1004,
            "speakerName": "百代",
            "text": "啊啊，最烦的就是把<color=#00E1FFFF>衣服</color>套在拼出来的假人上烧的过程了。毕竟要小心别把衣服烧得面目全非了呀！",
            "nextDialogs": [
              "722651717"
            ]
          },
          "722651717": {
            "id": "722651717",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "……",
            "nextDialogs": [
              "722651718"
            ]
          },
          "722651718": {
            "id": "722651718",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "……",
            "nextDialogs": [
              "722651719"
            ]
          },
          "722651719": {
            "id": "722651719",
            "speakerId": 1004,
            "speakerName": "百代",
            "text": "你们是听不懂人话吗？还愣着干嘛？！<color=#00E1FFFF>八块兽肉，四块白铁块，三颗海灵芝</color>，外加一件容易辨识身份的<color=#00E1FFFF>衣服</color>！",
            "nextDialogs": [
              "722651720"
            ]
          },
          "722651720": {
            "id": "722651720",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "呜呜呜！我就知道百代小姐你最好了！！",
            "nextDialogs": [
              "722651721"
            ]
          },
          "722651721": {
            "id": "722651721",
            "speakerId": 1004,
            "speakerName": "百代",
            "text": "别烦我，快走快走！"
          }
        }
      }
    },
    {
      "subId": "7226513",
      "subQuestName": "获取八块兽肉",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "722651301"
        ],
        "dialogs": {
          "722651301": {
            "id": "722651301",
            "speakerId": 1003,
            "speakerName": "柳达希卡·雪奈茨芙娜",
            "text": "我会在这里一边做校对工作，一边为二位祈祷。",
            "nextDialogs": [
              "722651302"
            ]
          },
          "722651302": {
            "id": "722651302",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "说起来，校对的工作怎么样了？",
            "nextDialogs": [
              "722651303"
            ]
          },
          "722651303": {
            "id": "722651303",
            "speakerId": 1003,
            "speakerName": "柳达希卡·雪奈茨芙娜",
            "text": "还算顺利，不过这次要校对的内容非常多，加上八重堂这两天人手不足，可能要通宵吧。",
            "nextDialogs": [
              "722651304"
            ]
          },
          "722651304": {
            "id": "722651304",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "好辛苦呀！",
            "nextDialogs": [
              "722651305"
            ]
          },
          "722651305": {
            "id": "722651305",
            "speakerId": 1003,
            "speakerName": "柳达希卡·雪奈茨芙娜",
            "text": "呵呵，虽然辛苦，但我觉得非常有趣！能够提前看到喜欢的小说，偶尔还能接触到作者们的手稿，简直太棒了！"
          }
        }
      }
    },
    {
      "subId": "7226514",
      "subQuestName": "获取四块白铁块",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "722651401"
        ],
        "dialogs": {
          "722651401": {
            "id": "722651401",
            "speakerId": 1004,
            "speakerName": "百代",
            "text": "快去吧。把竹签上的药粉粘在那个冒牌货身上，就能利用元素视野跟踪她了。",
            "nextDialogs": [
              "722651402"
            ]
          },
          "722651402": {
            "id": "722651402",
            "speakerId": 1004,
            "speakerName": "百代",
            "text": "愚人众去海祇岛肯定没安什么好心，不过现在已经没有天领奉行给他们撑腰了，他们别以为还能在稻妻掀起风浪来。"
          }
        }
      }
    },
    {
      "subId": "7226516",
      "subQuestName": "获取柳达希卡的衣服",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "722651601"
        ],
        "dialogs": {
          "722651601": {
            "id": "722651601",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "柳达希卡小姐，你在里面吗？",
            "nextDialogs": [
              "722651602"
            ]
          },
          "722651602": {
            "id": "722651602",
            "speakerId": 1003,
            "speakerName": "柳达希卡·雪奈茨芙娜",
            "text": "#是{NICKNAME}和派蒙，怎么了，是不是因为行动进行得不顺利？别担心，我马上就离开这里，不会给你们添麻烦…",
            "nextDialogs": [
              "722651603"
            ]
          },
          "722651603": {
            "id": "722651603",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "不是不是！我们来找你，只是因为目前计划里需要一套你的衣服，能一下子辨认出你身份的那种。",
            "nextDialogs": [
              "722651604"
            ]
          },
          "722651604": {
            "id": "722651604",
            "speakerId": 1003,
            "speakerName": "柳达希卡·雪奈茨芙娜",
            "text": "能辨认我身份的衣服？我明白了。",
            "nextDialogs": [
              "722651605"
            ]
          },
          "722651605": {
            "id": "722651605",
            "speakerId": 1003,
            "speakerName": "柳达希卡·雪奈茨芙娜",
            "text": "这是我在愚人众的服装。如果是认识我的人的话，应该能辨认出这套衣服。",
            "nextDialogs": [
              "722651606"
            ]
          },
          "722651606": {
            "id": "722651606",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "摸起来还有点温温的。",
            "nextDialogs": [
              "722651607"
            ]
          },
          "722651607": {
            "id": "722651607",
            "speakerId": 1003,
            "speakerName": "柳达希卡·雪奈茨芙娜",
            "text": "说来惭愧，因为我之前把它穿在其他衣服里面，以备不时之需。",
            "nextDialogs": [
              "722651608"
            ]
          },
          "722651608": {
            "id": "722651608",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "好，现在有了这套衣服，计划一定能顺利进行！",
            "nextDialogs": [
              "722651609"
            ]
          },
          "722651609": {
            "id": "722651609",
            "speakerId": 1003,
            "speakerName": "柳达希卡·雪奈茨芙娜",
            "text": "谢谢你们，祝你们好运。"
          }
        }
      }
    },
    {
      "subId": "7226515",
      "subQuestName": "获取三颗海灵芝",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "722651501"
        ],
        "dialogs": {
          "722651501": {
            "id": "722651501",
            "speakerId": 1006,
            "speakerName": "陆",
            "text": "呀，是外国人！你好！",
            "nextDialogs": [
              "722651502"
            ]
          },
          "722651502": {
            "id": "722651502",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "你刚才有没有看见什么？",
            "nextDialogs": [
              "722651503"
            ]
          },
          "722651503": {
            "id": "722651503",
            "speakerId": 1006,
            "speakerName": "陆",
            "text": "嗯，有的！",
            "nextDialogs": [
              "722651504"
            ]
          },
          "722651504": {
            "id": "722651504",
            "speakerId": 1006,
            "speakerName": "陆",
            "text": "我看见一个巫女大姐姐走了过去，在那边唰地变成了紫色，然后一下子就飞走了！好厉害哦！"
          }
        }
      }
    },
    {
      "subId": "7226510",
      "subQuestName": "将材料交给百代",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "722651001"
        ],
        "dialogs": {
          "722651001": {
            "id": "722651001",
            "speakerId": 1004,
            "speakerName": "百代",
            "text": "你们回来了。"
          }
        }
      }
    },
    {
      "subId": "7226520",
      "subQuestName": "将材料交给百代",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "722652101"
        ],
        "dialogs": {
          "722652101": {
            "id": "722652101",
            "speakerId": 1004,
            "speakerName": "百代",
            "text": "哼，我什么时候说要这些材料了？",
            "nextDialogs": [
              "722652102"
            ]
          },
          "722652102": {
            "id": "722652102",
            "speakerId": 1004,
            "speakerName": "百代",
            "text": "可既然你们都把材料摆到我面前了，也不是不能帮你们这个忙。毕竟你们之前拿到的情报，可以拯救许多人的生命。",
            "nextDialogs": [
              "722652103"
            ]
          },
          "722652103": {
            "id": "722652103",
            "speakerId": 1004,
            "speakerName": "百代",
            "text": "兽肉、白铁块、海灵芝…嗯，这些就够了。"
          }
        }
      }
    },
    {
      "subId": "7226519",
      "subQuestName": "交付柳达的衣服",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "722651901"
        ],
        "dialogs": {
          "722651901": {
            "id": "722651901",
            "speakerId": 1004,
            "speakerName": "百代",
            "text": "能辨认那个柳达希卡身份的衣服，你们也拿到了吧？"
          }
        }
      }
    },
    {
      "subId": "7226518",
      "subQuestName": "拜托百代进行制作",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "722651801"
        ],
        "dialogs": {
          "722651801": {
            "id": "722651801",
            "speakerId": 1004,
            "speakerName": "百代",
            "text": "好，东西都齐了，接下来就没你们的事了。",
            "nextDialogs": [
              "722651802"
            ]
          },
          "722651802": {
            "id": "722651802",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "海祇岛那边怎么样了？",
            "nextDialogs": [
              "722651803"
            ]
          },
          "722651803": {
            "id": "722651803",
            "speakerId": 1004,
            "speakerName": "百代",
            "text": "在你们出去找材料这段时间，我已经安排好了。",
            "nextDialogs": [
              "722651804"
            ]
          },
          "722651804": {
            "id": "722651804",
            "speakerId": 1004,
            "speakerName": "百代",
            "text": "你们要的东西，大概需要一整天的时间才能完工，你们明天再来吧。",
            "nextDialogs": [
              "722651805"
            ]
          },
          "722651805": {
            "id": "722651805",
            "speakerId": 1004,
            "speakerName": "百代",
            "text": "那个时候，我们再来商量一下怎么使用这具假人吧。"
          }
        }
      }
    },
    {
      "subId": "7226511",
      "subQuestName": "离开安全屋",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "722651101"
        ],
        "dialogs": {
          "722651101": {
            "id": "722651101",
            "speakerId": 1004,
            "speakerName": "百代",
            "text": "制作需要一天时间，你们明天再来吧。别在我面前晃，影响心情。"
          }
        }
      }
    },
    {
      "subId": "7226512",
      "subQuestName": "等待到第二天下午（14点-18点）",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [],
        "dialogs": {}
      }
    },
    {
      "subId": "7226520",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "722652001"
        ],
        "dialogs": {
          "722652001": {
            "id": "722652001",
            "speakerId": 1004,
            "speakerName": "百代",
            "text": "材料有<color=#00E1FFFF>八块兽肉</color>、<color=#00E1FFFF>四块白铁块</color>还有<color=#00E1FFFF>三颗海灵芝</color>。另外还得有一套足以辨认柳达希卡身份的<color=#00E1FFFF>衣服</color>。",
            "nextDialogs": [
              "722652002"
            ]
          },
          "722652002": {
            "id": "722652002",
            "speakerId": 1004,
            "speakerName": "百代",
            "text": "听懂了就快去！我还要安排海祇岛抓捕愚人众的行动呢。"
          }
        }
      }
    }
  ]
}
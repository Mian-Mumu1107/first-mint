  "subQuests": [
    {
      "subId": "7226501",
      "subQuestName": "将「竹签」交给玄冬",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "721033901"
        ],
        "dialogs": {
          "721033901": {
            "id": "721033901",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "交出「特制的竹签」。",
            "nextDialogs": [
              "721033902"
            ]
          },
          "721033902": {
            "id": "721033902",
            "speakerId": 1000,
            "speakerName": "「玄冬林檎」",
            "text": "好的，请将竹签交给我吧。奇怪，总觉得刚才好像没有看到您摇晃签筒…",
            "nextDialogs": [
              "721033903"
            ]
          },
          "721033903": {
            "id": "721033903",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "是你的错觉。",
            "nextDialogs": [
              "721033904"
            ]
          },
          "721033904": {
            "id": "721033904",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "对呀，因为玄冬小姐一副心不在焉的样子。",
            "nextDialogs": [
              "721033905"
            ]
          },
          "721033905": {
            "id": "721033905",
            "speakerId": 1000,
            "speakerName": "「玄冬林檎」",
            "text": "心、心不在焉？！啊…没有的事，大概只是因为昨天没有睡好的关系，让您担心了！",
            "nextDialogs": [
              "721033906"
            ]
          },
          "721033906": {
            "id": "721033906",
            "speakerId": 1000,
            "speakerName": "「玄冬林檎」",
            "text": "这是您的御神签，请您收好。",
            "nextDialogs": [
              "721033907"
            ]
          },
          "721033907": {
            "id": "721033907",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "（怎么样怎么样？刚才粉末应该已经粘在她身上了吧。）",
            "nextDialogs": [
              "721033908"
            ]
          },
          "721033908": {
            "id": "721033908",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "（嗯，没问题。）",
            "nextDialogs": [
              "721033909"
            ]
          },
          "721033909": {
            "id": "721033909",
            "speakerId": 1000,
            "speakerName": "「玄冬林檎」",
            "text": "咦，你们两位为什么一脸凝重地站在这里？难道是抽到凶签了吗？",
            "nextDialogs": [
              "721033910"
            ]
          },
          "721033910": {
            "id": "721033910",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "不，是「末吉」。",
            "nextDialogs": [
              "721033911"
            ]
          },
          "721033911": {
            "id": "721033911",
            "speakerId": 1000,
            "speakerName": "「玄冬林檎」",
            "text": "请不要灰心，「末吉」其实也是不错的运势哦。也许会经历一些坎坷，但最终一定会迎来美满的结局。",
            "nextDialogs": [
              "721033912"
            ]
          },
          "721033912": {
            "id": "721033912",
            "speakerId": 1000,
            "speakerName": "「玄冬林檎」",
            "text": "尤其是对于您这样善良的人，一定会灵验的。至少，我是这样相信的。"
          }
        }
      }
    },
    {
      "subId": "7226502",
      "subQuestName": "在晚上（21点~23点）等待假玄冬",
      "sceneId": null,
      "locations": [],

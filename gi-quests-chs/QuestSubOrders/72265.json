    {
      "subId": "7226503",
      "subQuestName": "等待假玄冬出现",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "722650301"
        ],
        "dialogs": {
          "722650301": {
            "id": "722650301",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "#{NICKNAME}你看，有个人影从神社里走出来了！",
            "nextDialogs": [
              "722650302"
            ]
          },
          "722650302": {
            "id": "722650302",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "没错，是假玄冬！她向着山下的方向走了，我们快追！"
          }
        }
      }
    },
    {
      "subId": "7226504",
      "subQuestName": "用元素视野追踪假玄冬",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [],
        "dialogs": {}
      }
    },
    {
      "subId": "7226505",
      "subQuestName": "偷听两人的对话",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "722650501"
        ],
        "dialogs": {
          "722650501": {
            "id": "722650501",
            "speakerId": 1000,
            "speakerName": "「玄冬林檎」",
            "text": "应该还不到和老师例行会面的日期才对，一定是因为那件事…",
            "nextDialogs": [
              "722650502"
            ]
          },
          "722650502": {
            "id": "722650502",
            "speakerId": 1002,
            "speakerName": "叶菲·雪奈茨维奇",
            "text": "柳达希卡。",
            "nextDialogs": [
              "722650503"
            ]
          },
          "722650503": {
            "id": "722650503",
            "speakerId": 1003,
            "speakerName": "柳达希卡·雪奈茨芙娜",
            "text": "啊，老师您来了！",
            "nextDialogs": [
              "722650504"
            ]
          },
          "722650504": {
            "id": "722650504",
            "speakerId": 1003,
            "speakerName": "柳达希卡·雪奈茨芙娜",
            "text": "您辛苦了，我马上向您汇报近日的进展。关于您吩咐的渗透终末番一事…",
            "nextDialogs": [
              "722650505"
            ]
          },
          "722650505": {
            "id": "722650505",
            "speakerId": 1002,
            "speakerName": "叶菲·雪奈茨维奇",
            "text": "够了，柳达希卡，你那些拖延时间的说辞，我已经听够了。",
            "nextDialogs": [
              "722650506"
            ]
          },
          "722650506": {
            "id": "722650506",
            "speakerId": 1002,
            "speakerName": "叶菲·雪奈茨维奇",
            "text": "什么「频繁发布假任务可能会引起对方怀疑」，「眼狩令废止后，终末番的行动方针可能会有变化，需要搜集情报」…",
            "nextDialogs": [
              "722650507"
            ]
          },
          "722650507": {
            "id": "722650507",
            "speakerId": 1002,
            "speakerName": "叶菲·雪奈茨维奇",
            "text": "每次都是这样！我猜你根本就没有获得那两个终末番成员的信任，所以才不得不编出这些谎话来搪塞我！",
            "nextDialogs": [
              "722650508"
            ]
          },
          "722650508": {
            "id": "722650508",
            "speakerId": 1003,
            "speakerName": "柳达希卡·雪奈茨芙娜",
            "text": "不是的老师！我确实已经获得了他们的信任，只是还需要一点时间…",
            "nextDialogs": [
              "722650509"
            ]
          },
          "722650509": {
            "id": "722650509",
            "speakerId": 1002,
            "speakerName": "叶菲·雪奈茨维奇",
            "text": "时间？我已经给了你很多时间了！",
            "nextDialogs": [
              "722650510"
            ]
          },
          "722650510": {
            "id": "722650510",
            "speakerId": 1002,
            "speakerName": "叶菲·雪奈茨维奇",
            "text": "你要知道，我的耐心是有限的，「仆人」大人的耐心也是有限的！",
            "nextDialogs": [
              "722650511"
            ]
          },
          "722650511": {
            "id": "722650511",
            "speakerId": 1003,
            "speakerName": "柳达希卡·雪奈茨芙娜",
            "text": "真是万分抱歉…",
            "nextDialogs": [
              "722650512"
            ]
          },
          "722650512": {
            "id": "722650512",
            "speakerId": 1002,
            "speakerName": "叶菲·雪奈茨维奇",
            "text": "我辛辛苦苦在你身上花了这么多年时间，要的不是你的道歉！我要的是「结果」，「结果」！",
            "nextDialogs": [
              "722650513"
            ]
          },
          "722650513": {
            "id": "722650513",
            "speakerId": 1002,
            "speakerName": "叶菲·雪奈茨维奇",
            "text": "…算了，我不想追究之前的事。不管是你没取得敌人的信任，还是现在的生活让你昏了头，都不重要了。",
            "nextDialogs": [
              "722650514"
            ]
          },
          "722650514": {
            "id": "722650514",
            "speakerId": 1002,
            "speakerName": "叶菲·雪奈茨维奇",
            "text": "这张纸上是你的「最终指令」，拿着它。你给我一个字一个字地，好好看清楚。",
            "nextDialogs": [
              "722650515"
            ]
          },
          "722650515": {
            "id": "722650515",
            "speakerId": 1003,
            "speakerName": "柳达希卡·雪奈茨芙娜",
            "text": "是，老师！我一定会完成任务，不负您的信任！",
            "nextDialogs": [
              "722650516"
            ]
          },
          "722650516": {
            "id": "722650516",
            "speakerId": 1003,
            "speakerName": "柳达希卡·雪奈茨芙娜",
            "text": "…这、这是？！",
            "nextDialogs": [
              "722650517"
            ]
          },
          "722650517": {
            "id": "722650517",
            "speakerId": 1002,
            "speakerName": "叶菲·雪奈茨维奇",
            "text": "怎么了？",
            "nextDialogs": [
              "722650518"
            ]
          },
          "722650518": {
            "id": "722650518",
            "speakerId": 1003,
            "speakerName": "柳达希卡·雪奈茨芙娜",
            "text": "啊，不，没什么…",
            "nextDialogs": [
              "722650519"
            ]
          },
          "722650519": {
            "id": "722650519",
            "speakerId": 1002,
            "speakerName": "叶菲·雪奈茨维奇",
            "text": "柳达希卡，你刚才那句「我一定会完成任务，不负您的信任」，我可以当作是你的承诺吧。",
            "nextDialogs": [
              "722650520"
            ]
          },
          "722650520": {
            "id": "722650520",
            "speakerId": 1003,
            "speakerName": "柳达希卡·雪奈茨芙娜",
            "text": "……",
            "nextDialogs": [
              "722650521"
            ]
          },
          "722650521": {
            "id": "722650521",
            "speakerId": 1002,
            "speakerName": "叶菲·雪奈茨维奇",
            "text": "回答我，「是」还是「不是」！",
            "nextDialogs": [
              "722650522"
            ]
          },
          "722650522": {
            "id": "722650522",
            "speakerId": 1003,
            "speakerName": "柳达希卡·雪奈茨芙娜",
            "text": "老师！我当然支持您的决断，只是…只是您说过，「仆人」大人随时都可能让我们从稻妻撤离。",
            "nextDialogs": [
              "722650523"
            ]
          },
          "722650523": {
            "id": "722650523",
            "speakerId": 1003,
            "speakerName": "柳达希卡·雪奈茨芙娜",
            "text": "而且现在幕府和海祇岛已经停战，我们这样做，真的有必要吗…",
            "nextDialogs": [
              "722650524"
            ]
          },
          "722650524": {
            "id": "722650524",
            "speakerId": 1002,
            "speakerName": "叶菲·雪奈茨维奇",
            "text": "呵呵，正因为如此，这个任务才有价值！",
            "nextDialogs": [
              "722650525"
            ]
          },
          "722650525": {
            "id": "722650525",
            "speakerId": 1002,
            "speakerName": "叶菲·雪奈茨维奇",
            "text": "虽然「女士」大人在稻妻遇害了，但现在，也正是我们回报「仆人」大人的恩情，为其建立威望的好时机。",
            "nextDialogs": [
              "722650526"
            ]
          },
          "722650526": {
            "id": "722650526",
            "speakerId": 1002,
            "speakerName": "叶菲·雪奈茨维奇",
            "text": "而且我也一直告诉你们，「混乱」才是最能让我们愚人众壮大的土壤！",
            "nextDialogs": [
              "722650527"
            ]
          },
          "722650527": {
            "id": "722650527",
            "speakerId": 1003,
            "speakerName": "柳达希卡·雪奈茨芙娜",
            "text": "……",
            "nextDialogs": [
              "722650528"
            ]
          },
          "722650528": {
            "id": "722650528",
            "speakerId": 1002,
            "speakerName": "叶菲·雪奈茨维奇",
            "text": "柳达希卡，你还在犹豫什么？！",
            "nextDialogs": [
              "722650529"
            ]
          },
          "722650529": {
            "id": "722650529",
            "speakerId": 1003,
            "speakerName": "柳达希卡·雪奈茨芙娜",
            "text": "只是这样一来，一定又会有很多孤儿…",
            "nextDialogs": [
              "722650530"
            ]
          },
          "722650530": {
            "id": "722650530",
            "speakerId": 1002,
            "speakerName": "叶菲·雪奈茨维奇",
            "text": "那不是更好吗？我们也可以收留他们，让他们成为新的战力。当然前提是，你能顺利完成这个任务！",
            "nextDialogs": [
              "722650531"
            ]
          },
          "722650531": {
            "id": "722650531",
            "speakerId": 1002,
            "speakerName": "叶菲·雪奈茨维奇",
            "text": "柳达希卡，别再让我失望。我们有这么多年的情分，我也不想把事情做得太绝。",
            "nextDialogs": [
              "722650532"
            ]
          },
          "722650532": {
            "id": "722650532",
            "speakerId": 1003,
            "speakerName": "柳达希卡·雪奈茨芙娜",
            "text": "呜…",
            "nextDialogs": [
              "722650533"
            ]
          },
          "722650533": {
            "id": "722650533",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "不好了，海祇岛要发生可怕的事了！",
            "nextDialogs": [
              "722650534"
            ]
          },
          "722650534": {
            "id": "722650534",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "#{NICKNAME}，现在只剩下柳达希卡一个人了，我们快去把她手里的最终指令抢过来！"
          }
        }
      }
    },
    {
      "subId": "7226506",
      "subQuestName": "与柳达希卡对峙",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "722650601"
        ],
        "dialogs": {
          "722650601": {
            "id": "722650601",
            "speakerId": 1003,
            "speakerName": "柳达希卡·雪奈茨芙娜",
            "text": "……",
            "nextDialogs": [
              "722650602"
            ]
          },
          "722650602": {
            "id": "722650602",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "柳达希卡。",
            "nextDialogs": [
              "722650603"
            ]
          },
          "722650603": {
            "id": "722650603",
            "speakerId": 1003,
            "speakerName": "柳达希卡·雪奈茨芙娜",
            "text": "谁？！",
            "nextDialogs": [
              "722650604"
            ]
          },
          "722650604": {
            "id": "722650604",
            "speakerId": 1003,
            "speakerName": "柳达希卡·雪奈茨芙娜",
            "text": "#{NICKNAME}，您…您怎么会在这里？！",
            "nextDialogs": [
              "722650605"
            ]
          },
          "722650605": {
            "id": "722650605",
            "speakerId": 1003,
            "speakerName": "柳达希卡·雪奈茨芙娜",
            "text": "那个…不，您误会了，我…我之所以在这里，其实…其实是…",
            "nextDialogs": [
              "722650606"
            ]
          },
          "722650606": {
            "id": "722650606",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "我觉得并没有什么误会。因为…",
            "nextDialogs": [
              "722650609"
            ]
          },
          "722650609": {
            "id": "722650609",
            "speakerId": 1003,
            "speakerName": "柳达希卡·雪奈茨芙娜",
            "text": "…哎呀哎呀，看来现在，再说什么都没有用了。",
            "nextDialogs": [
              "722650610"
            ]
          },
          "722650610": {
            "id": "722650610",
            "speakerId": 1003,
            "speakerName": "柳达希卡·雪奈茨芙娜",
            "text": "既然你已经发现了我的真实身份，就别想活着离开！"
          }
        }
      }
    },
    {
      "subId": "7226507",
      "subQuestName": "与柳达希卡战斗",
      "sceneId": null,

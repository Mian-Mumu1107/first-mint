    {
      "subId": "1502205",
      "subQuestName": "前往山顶",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "150220501"
        ],
        "dialogs": {
          "150220501": {
            "id": "150220501",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "#居然还真的成功了…话又说回来，我跟{NICKNAME}该怎么上去呢？",
            "nextDialogs": [
              "150220502"
            ]
          },
          "150220502": {
            "id": "150220502",
            "speakerId": 1001,
            "speakerName": "恰斯卡",
            "text": "可以让姐姐借助风力带你们上去——她其实一直跟着我们呢。",
            "nextDialogs": [
              "150220503"
            ]
          },
          "150220503": {
            "id": "150220503",
            "speakerId": 1010,
            "speakerName": "柯娅",
            "text": "……",
            "nextDialogs": [
              "150220504"
            ]
          },
          "150220504": {
            "id": "150220504",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "欸…完全没发现…",
            "nextDialogs": [
              "150220505"
            ]
          },
          "150220505": {
            "id": "150220505",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "为什么不直接飞过来…",
            "nextDialogs": [
              "150220506"
            ]
          },
          "150220506": {
            "id": "150220506",
            "speakerId": 1001,
            "speakerName": "恰斯卡",
            "text": "估计是不想接近人类的部族…或者不想接近我吧。但现在…需要她的力量了。",
            "nextDialogs": [
              "150220507"
            ]
          },
          "150220507": {
            "id": "150220507",
            "speakerId": 1010,
            "speakerName": "柯娅",
            "text": "啁——",
            "nextDialogs": [
              "150220508"
            ]
          },
          "150220508": {
            "id": "150220508",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "哇！没、没召唤就直接过来了…",
            "nextDialogs": [
              "150220509"
            ]
          },
          "150220509": {
            "id": "150220509",
            "speakerId": 1010,
            "speakerName": "柯娅",
            "text": "…啁。",
            "nextDialogs": [
              "150220510"
            ]
          },
          "150220510": {
            "id": "150220510",
            "speakerId": 1001,
            "speakerName": "恰斯卡",
            "text": "是…你的孩子多半就在上面。",
            "nextDialogs": [
              "150220511"
            ]
          },
          "150220511": {
            "id": "150220511",
            "speakerId": 1001,
            "speakerName": "恰斯卡",
            "text": "做好准备，去会一会那个特帕尔吧。"
          }
        }
      }
    },

    {
      "subId": "1502201",
      "subQuestName": "前往回声之子搜集情报",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "150220101"
        ],
        "dialogs": {
          "150220101": {
            "id": "150220101",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "按阿尔帕之前说的…特帕尔就是从回声之子来的吧？要怎么找到他呢？挨个找人问吗？",
            "nextDialogs": [
              "150220102"
            ]
          },
          "150220102": {
            "id": "150220102",
            "speakerId": 1001,
            "speakerName": "恰斯卡",
            "text": "直接找回声之子里的熟人帮忙会快些。在这个时间这个地点，最容易找到的人选是…",
            "nextDialogs": [
              "150220103"
            ]
          },
          "150220103": {
            "id": "150220103",
            "speakerId": 1001,
            "speakerName": "恰斯卡",
            "text": "——希诺宁，该起床了。",
            "nextDialogs": [
              "150220104"
            ]
          },
          "150220104": {
            "id": "150220104",
            "speakerId": 1002,
            "speakerName": "希诺宁",
            "text": "哈…是你们啊…唔…你们等等…我先从树上下去。",
            "nextDialogs": [
              "150220105"
            ]
          },
          "150220105": {
            "id": "150220105",
            "speakerId": 1002,
            "speakerName": "希诺宁",
            "text": "啊…呜…",
            "nextDialogs": [
              "150220106"
            ]
          },
          "150220106": {
            "id": "150220106",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "你俩都很喜欢待在树上呢…",
            "nextDialogs": [
              "150220107"
            ]
          },
          "150220107": {
            "id": "150220107",
            "speakerId": 1001,
            "speakerName": "恰斯卡",
            "text": "我上树是为了飞得更久看得更远，一般不会在树上休息。",
            "nextDialogs": [
              "150220108"
            ]
          },
          "150220108": {
            "id": "150220108",
            "speakerId": 1002,
            "speakerName": "希诺宁",
            "text": "不是每个人都跟你一样，到处折腾一整天都不嫌累的…所以，这次是为什么事，来打扰我宝贵的休息时间？",
            "nextDialogs": [
              "150220109"
            ]
          },
          "150220109": {
            "id": "150220109",
            "speakerId": 1001,
            "speakerName": "恰斯卡",
            "text": "抱歉了，希诺宁，但这件事很紧急——你认识一位名叫特帕尔的工匠吗？",
            "nextDialogs": [
              "150220110"
            ]
          },
          "150220110": {
            "id": "150220110",
            "speakerId": 1002,
            "speakerName": "希诺宁",
            "text": "特帕尔？好像有点印象…应该是普玛家的孩子吧？",
            "nextDialogs": [
              "150220111"
            ]
          },
          "150220111": {
            "id": "150220111",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "那他现在就在回声之子吗？",
            "nextDialogs": [
              "150220112"
            ]
          },
          "150220112": {
            "id": "150220112",
            "speakerId": 1002,
            "speakerName": "希诺宁",
            "text": "不，起码好几年前就不在了…说起来，你们又为什么要找他？",
            "nextDialogs": [
              "150220113"
            ]
          },
          "150220113": {
            "id": "150220113",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "说来话长…",
            "nextDialogs": [
              "150220114"
            ]
          },
          "150220114": {
            "id": "150220114",
            "speakerId": 1003,
            "speakerName": "Black Screen",
            "text": "你们尽量简明扼要地说明了事情的经过…",
            "nextDialogs": [
              "150220115"
            ]
          },
          "150220115": {
            "id": "150220115",
            "speakerId": 1002,
            "speakerName": "希诺宁",
            "text": "「燃素翼」？特帕尔这小子，居然真能鼓捣出这么不得了的东西…看来今天的休息时间是要没了。",
            "nextDialogs": [
              "150220116"
            ]
          },
          "150220116": {
            "id": "150220116",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "「真能」？难道他以前就研究过类似的东西？",
            "nextDialogs": [
              "150220117"
            ]
          },
          "150220117": {
            "id": "150220117",
            "speakerId": 1002,
            "speakerName": "希诺宁",
            "text": "是，差不多就是从花羽会回来之后，他开始研究用人造物飞向天空的方法…",
            "nextDialogs": [
              "150220118"
            ]
          },
          "150220118": {
            "id": "150220118",
            "speakerId": 1001,
            "speakerName": "恰斯卡",
            "text": "是在成为「失翼者」之后…人造物…就跟你帮我造的那把枪一样吗？",
            "nextDialogs": [
              "150220119"
            ]
          },
          "150220119": {
            "id": "150220119",
            "speakerId": 1002,
            "speakerName": "希诺宁",
            "text": "你的那把「枪」可比最高傲的绒翼龙还要难驯服——而他想要的，是让没有天赋的普通人也能自由飞行。",
            "nextDialogs": [
              "150220120"
            ]
          },
          "150220120": {
            "id": "150220120",
            "speakerId": 1002,
            "speakerName": "希诺宁",
            "text": "不过他那时候总是失败，炸过好几回工坊，连自己的小命都差点丢了。至于后面的事，我没太关注过。",
            "nextDialogs": [
              "150220121"
            ]
          },
          "150220121": {
            "id": "150220121",
            "speakerId": 1002,
            "speakerName": "希诺宁",
            "text": "特帕尔的父母早年曾在外游历，后来有了特帕尔才回到部族，但也选在了偏僻处定居，不怎么与人交流。",
            "nextDialogs": [
              "150220122"
            ]
          },
          "150220122": {
            "id": "150220122",
            "speakerId": 1002,
            "speakerName": "希诺宁",
            "text": "部族里的人跟他们都不算很熟…要了解特帕尔的详细情况，还是去找他的家里人比较好。",
            "nextDialogs": [
              "150220123"
            ]
          },
          "150220123": {
            "id": "150220123",
            "speakerId": 1002,
            "speakerName": "希诺宁",
            "text": "我现在去把普玛约出来，你们就先在我的工坊前面等一会吧。"
          }
        }
      }
    },
    {
      "subId": "1502202",
      "subQuestName": "前往希诺宁的工坊等待",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "150220201"
        ],
        "dialogs": {
          "150220201": {
            "id": "150220201",
            "speakerId": 1003,
            "speakerName": "Black Screen",
            "text": "在希诺宁的工坊前稍等了一会…",
            "nextDialogs": [
              "150220202"
            ]
          },
          "150220202": {
            "id": "150220202",
            "speakerId": 1002,
            "speakerName": "希诺宁",
            "text": "久等了，这位就是特帕尔的母亲，普玛。",
            "nextDialogs": [
              "150220203"
            ]
          },
          "150220203": {
            "id": "150220203",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "您好，我们是…",
            "nextDialogs": [
              "150220204"
            ]
          },
          "150220204": {
            "id": "150220204",
            "speakerId": 1004,
            "speakerName": "普玛",
            "text": "寒暄的话就免了吧，我不想多谈那个人的事。",
            "nextDialogs": [
              "150220205"
            ]
          },
          "150220205": {
            "id": "150220205",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "欸…？",
            "nextDialogs": [
              "150220206"
            ]
          },
          "150220206": {
            "id": "150220206",
            "speakerId": 1004,
            "speakerName": "普玛",
            "text": "他早就已经跟我们没关系了…我可没有那样的孩子！",
            "nextDialogs": [
              "150220207"
            ]
          },
          "150220207": {
            "id": "150220207",
            "speakerId": 1004,
            "speakerName": "普玛",
            "text": "他心里就只有飞上天去的白日梦…不管我们怎么劝都执迷不悟。",
            "nextDialogs": [
              "150220208"
            ]
          },
          "150220208": {
            "id": "150220208",
            "speakerId": 1004,
            "speakerName": "普玛",
            "text": "哼…最后一走了之的时候，还说什么要在天上造工坊，省得被地上的人指指点点…",
            "nextDialogs": [
              "150220209"
            ]
          },
          "150220209": {
            "id": "150220209",
            "speakerId": 1004,
            "speakerName": "普玛",
            "text": "这是他留下没带走的手记，你们有什么问题，就自己翻吧。我不想再多说了。",
            "nextDialogs": [
              "150220210"
            ]
          },
          "150220210": {
            "id": "150220210",
            "speakerId": 1004,
            "speakerName": "普玛",
            "text": "我从来就没有过这个儿子…反正他也从没认过我这个妈。",
            "nextDialogs": [
              "150220211"
            ]
          },
          "150220211": {
            "id": "150220211",
            "speakerId": 1001,
            "speakerName": "恰斯卡",
            "text": "……",
            "nextDialogs": [
              "150220212"
            ]
          },
          "150220212": {
            "id": "150220212",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "没…没想到他们的关系会这么差啊…",
            "nextDialogs": [
              "150220213"
            ]
          },
          "150220213": {
            "id": "150220213",
            "speakerId": 1002,
            "speakerName": "希诺宁",
            "text": "她的丈夫…特帕尔的父亲不久前刚刚去世。但就算是在父亲的葬礼上，特帕尔也没有回来露面。",
            "nextDialogs": [
              "150220214"
            ]
          },
          "150220214": {
            "id": "150220214",
            "speakerId": 1002,
            "speakerName": "希诺宁",
            "text": "或许就是因为这样，普玛才会对特帕尔彻底死心吧。",
            "nextDialogs": [
              "150220215"
            ]
          },
          "150220215": {
            "id": "150220215",
            "speakerId": 1002,
            "speakerName": "希诺宁",
            "text": "我先去安抚她了，有事回头再聊。",
            "nextDialogs": [
              "150220216"
            ]
          },
          "150220216": {
            "id": "150220216",
            "speakerId": 1001,
            "speakerName": "恰斯卡",
            "text": "麻烦你们了。",
            "nextDialogs": [
              "150220217"
            ]
          },
          "150220217": {
            "id": "150220217",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "那现在的线索…就只剩下这本手记了？上面都写了什么？",
            "nextDialogs": [
              "150220218"
            ]
          },
          "150220218": {
            "id": "150220218",
            "speakerId": 1001,
            "speakerName": "恰斯卡",
            "text": "嗯…「燃素翼」的早期构思…还有…「空中工坊」的设想。",
            "nextDialogs": [
              "150220219"
            ]
          },
          "150220219": {
            "id": "150220219",
            "speakerId": 1001,
            "speakerName": "恰斯卡",
            "text": "「烬城」奥奇卡纳塔…看来「燃素翼」的技术原型，就是从那来的了。",
            "nextDialogs": [
              "150220220"
            ]
          },
          "150220220": {
            "id": "150220220",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "他居然真想造出一个飞在天上的工坊？光凭他一个人…真的做得到吗？",
            "nextDialogs": [
              "150220223"
            ]
          },
          "150220223": {
            "id": "150220223",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "——啊！是试炼场地上面的那个！飞得特别高的气球！",
            "nextDialogs": [
              "150220224"
            ]
          },
          "150220224": {
            "id": "150220224",
            "speakerId": 1001,
            "speakerName": "恰斯卡",
            "text": "那个气球出现有一段时间了，谁都不知道是怎么飞上去的…但如果它不是被谁放「上去」…",
            "nextDialogs": [
              "150220225"
            ]
          },
          "150220225": {
            "id": "150220225",
            "speakerId": 1001,
            "speakerName": "恰斯卡",
            "text": "而是因为什么故障，从更高的云层之上…「降落」到现在的高度呢？",
            "nextDialogs": [
              "150220226"
            ]
          },
          "150220226": {
            "id": "150220226",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "难道说它是…",
            "nextDialogs": [
              "150220227"
            ]
          },
          "150220227": {
            "id": "150220227",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "——空中工坊的一部分？",
            "nextDialogs": [
              "150220228"
            ]
          },
          "150220228": {
            "id": "150220228",
            "speakerId": 1001,
            "speakerName": "恰斯卡",
            "text": "很有可能。难怪连伊西多尔都不知道特帕尔的据点在哪里…原来是藏在了云层之上。",
            "nextDialogs": [
              "150220229"
            ]
          },
          "150220229": {
            "id": "150220229",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "居然还真是藏在天上…那我们要怎么上去呢？恰斯卡你…能飞那么高吗？",
            "nextDialogs": [
              "150220230"
            ]
          },
          "150220230": {
            "id": "150220230",
            "speakerId": 1001,
            "speakerName": "恰斯卡",
            "text": "#很有难度，要是再带{NICKNAME}上去，就更不可能了。",
            "nextDialogs": [
              "150220231"
            ]
          },
          "150220231": {
            "id": "150220231",
            "speakerId": 1001,
            "speakerName": "恰斯卡",
            "text": "就算用了「燃素翼」应该也飞不了那么高…除非是用上手记里说的「遗物」。",
            "nextDialogs": [
              "150220232"
            ]
          },
          "150220232": {
            "id": "150220232",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "「遗物」应该还在特帕尔手里…估计是指望不上了吧。",
            "nextDialogs": [
              "150220233"
            ]
          },
          "150220233": {
            "id": "150220233",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "派蒙能飞那么高吗？",
            "nextDialogs": [
              "150220234"
            ]
          },
          "150220234": {
            "id": "150220234",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "飞不了！怎么想都飞不了吧！再说了你就忍心让我一个人上去打特帕尔吗！",
            "nextDialogs": [
              "150220235"
            ]
          },
          "150220235": {
            "id": "150220235",
            "speakerId": 1001,
            "speakerName": "恰斯卡",
            "text": "放心吧，我们没想出办法，不代表别人也想不出。花羽会里的「飞行高手」可不只有我。",
            "nextDialogs": [
              "150220236"
            ]
          },
          "150220236": {
            "id": "150220236",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "欸…对哦！还能去找阿尔帕长老呢！",
            "nextDialogs": [
              "150220237"
            ]
          },
          "150220237": {
            "id": "150220237",
            "speakerId": 1001,
            "speakerName": "恰斯卡",
            "text": "穆托塔当年也是飞行队的一把好手，回花羽会去咨询一下他们的建议吧。"
          }
        }
      }
    },
    {
      "subId": "1502203",
      "subQuestName": "返回花羽会商讨方案",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "150220301"
        ],
        "dialogs": {
          "150220301": {
            "id": "150220301",
            "speakerId": 1005,
            "speakerName": "穆托塔",
            "text": "恰斯卡，你们可算回来了，部族里的氛围越来越严峻了，调查有什么进展吗？",
            "nextDialogs": [
              "150220302"
            ]
          },
          "150220302": {
            "id": "150220302",
            "speakerId": 1006,
            "speakerName": "阿尔帕",
            "text": "还有人怀疑我们控制住商队的人，是不是偏袒飞行队，想要打压「燃素翼」。",
            "nextDialogs": [
              "150220305"
            ]
          },
          "150220305": {
            "id": "150220305",
            "speakerId": 1001,
            "speakerName": "恰斯卡",
            "text": "我们已经找到了一些线索。但要找到确凿的证据，还有一道难关…",
            "nextDialogs": [
              "150220306"
            ]
          },
          "150220306": {
            "id": "150220306",
            "speakerId": 1003,
            "speakerName": "Black Screen",
            "text": "恰斯卡说明了特帕尔的情况与空中工坊的猜想…",
            "nextDialogs": [
              "150220307"
            ]
          },
          "150220307": {
            "id": "150220307",
            "speakerId": 1005,
            "speakerName": "穆托塔",
            "text": "来自烬城的「遗物」？过去这么多年，奥奇坎的遗毒居然还在激起矛盾…",
            "nextDialogs": [
              "150220308"
            ]
          },
          "150220308": {
            "id": "150220308",
            "speakerId": 1006,
            "speakerName": "阿尔帕",
            "text": "空中工坊…试炼场地上空的热气球…这就是你们接下来的目的地吗？",
            "nextDialogs": [
              "150220309"
            ]
          },
          "150220309": {
            "id": "150220309",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "有办法上去吗？",
            "nextDialogs": [
              "150220310"
            ]
          },
          "150220310": {
            "id": "150220310",
            "speakerId": 1006,
            "speakerName": "阿尔帕",
            "text": "不管是靠绒翼龙还是用「燃素翼」都飞不了那么高…特帕尔真的会在那儿吗？",
            "nextDialogs": [
              "150220311"
            ]
          },
          "150220311": {
            "id": "150220311",
            "speakerId": 1005,
            "speakerName": "穆托塔",
            "text": "唔…方法…倒也不是没有。",
            "nextDialogs": [
              "150220312"
            ]
          },
          "150220312": {
            "id": "150220312",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "——还真有啊！",
            "nextDialogs": [
              "150220313"
            ]
          },
          "150220313": {
            "id": "150220313",
            "speakerId": 1005,
            "speakerName": "穆托塔",
            "text": "你们还记得试炼场地内的那些喷口吗？之前的地脉异常跟阻塞，导致了气态燃素匮乏。",
            "nextDialogs": [
              "150220314"
            ]
          },
          "150220314": {
            "id": "150220314",
            "speakerId": 1005,
            "speakerName": "穆托塔",
            "text": "但如果在气态燃素充盈的现在，反过来重新堵住它们的话…",
            "nextDialogs": [
              "150220315"
            ]
          },
          "150220315": {
            "id": "150220315",
            "speakerId": 1001,
            "speakerName": "恰斯卡",
            "text": "你的意思…是只留下最高处的喷口，把所有压力都集中到那里？",
            "nextDialogs": [
              "150220316"
            ]
          },
          "150220316": {
            "id": "150220316",
            "speakerId": 1005,
            "speakerName": "穆托塔",
            "text": "这么一来，聚集的气态燃素就会在最高处形成极强的风压…",
            "nextDialogs": [
              "150220317"
            ]
          },
          "150220317": {
            "id": "150220317",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "——然后我们就能乘着风飞上去了？",
            "nextDialogs": [
              "150220318"
            ]
          },
          "150220318": {
            "id": "150220318",
            "speakerId": 1005,
            "speakerName": "穆托塔",
            "text": "嗯，虽然会有些冒险，但以恰斯卡的技术，应该不成问题？",
            "nextDialogs": [
              "150220319"
            ]
          },
          "150220319": {
            "id": "150220319",
            "speakerId": 1006,
            "speakerName": "阿尔帕",
            "text": "真是有够冒险的…但确实有可行性。",
            "nextDialogs": [
              "150220320"
            ]
          },
          "150220320": {
            "id": "150220320",
            "speakerId": 1005,
            "speakerName": "穆托塔",
            "text": "封堵喷口的技术细节，可以去试炼场地找因卡纳克问问。",
            "nextDialogs": [
              "150220321"
            ]
          },
          "150220321": {
            "id": "150220321",
            "speakerId": 1005,
            "speakerName": "穆托塔",
            "text": "恰斯卡…能不能抓住飞在天上的证据，就看你们了。"
          }
        }
      }
    },
    {
      "subId": "1502204",
      "subQuestName": "前往试炼场地与因卡纳克对话",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "150221101"
        ],
        "dialogs": {
          "150221101": {
            "id": "150221101",
            "speakerId": 1003,
            "speakerName": "Black Screen",
            "text": "你们匆匆赶到试炼场地，向因卡纳克说明情况…",
            "nextDialogs": [
              "150221102"
            ]
          },
          "150221102": {
            "id": "150221102",
            "speakerId": 1007,
            "speakerName": "因卡纳克",
            "text": "原来如此…可真是大胆的构思…",
            "nextDialogs": [
              "150221103"
            ]
          },
          "150221103": {
            "id": "150221103",
            "speakerId": 1001,
            "speakerName": "恰斯卡",
            "text": "因卡纳克，时间紧迫，有什么能尽快封堵喷口的方法吗？",
            "nextDialogs": [
              "150221104"
            ]
          },
          "150221104": {
            "id": "150221104",
            "speakerId": 1007,
            "speakerName": "因卡纳克",
            "text": "从技术上来说，我建议还是好好测算和规划之后再出具体方案…不过我想你们肯定不乐意听这个。",
            "nextDialogs": [
              "150221105"
            ]
          },
          "150221105": {
            "id": "150221105",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "确实。",
            "nextDialogs": [
              "150221106"
            ]
          },
          "150221106": {
            "id": "150221106",
            "speakerId": 1007,
            "speakerName": "因卡纳克",
            "text": "…那就只剩下最简单粗暴的方案了——看到那些固态燃素了吗？",
            "nextDialogs": [
              "150221107"
            ]
          },
          "150221107": {
            "id": "150221107",
            "speakerId": 1007,
            "speakerName": "因卡纳克",
            "text": "之前调查的时候，我们发现它们内部形成了某种稳定结构，不会轻易损坏…",
            "nextDialogs": [
              "150221108"
            ]
          },
          "150221108": {
            "id": "150221108",
            "speakerId": 1007,
            "speakerName": "因卡纳克",
            "text": "但也形成了一些结构性弱点，虽然只要不同时受到打击，就不会有事…",
            "nextDialogs": [
              "150221109"
            ]
          },
          "150221109": {
            "id": "150221109",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "那要是一齐攻击的话，会发生什么吗？",
            "nextDialogs": [
              "150221110"
            ]
          },
          "150221110": {
            "id": "150221110",
            "speakerId": 1007,
            "speakerName": "因卡纳克",
            "text": "——会直接崩落哦。",
            "nextDialogs": [
              "150221111"
            ]
          },
          "150221111": {
            "id": "150221111",
            "speakerId": 1001,
            "speakerName": "恰斯卡",
            "text": "…好吧，我大概猜到你的计划了。",
            "nextDialogs": [
              "150221112"
            ]
          },
          "150221112": {
            "id": "150221112",
            "speakerId": 1007,
            "speakerName": "因卡纳克",
            "text": "不愧是你！只要对好角度、一齐攻击所有弱点，让它们往喷口的方向砸下来…就能封堵喷口啦。",
            "nextDialogs": [
              "150221113"
            ]
          },
          "150221113": {
            "id": "150221113",
            "speakerId": 1001,
            "speakerName": "恰斯卡",
            "text": "确实是最简单粗暴的方案，挺适合我的。"
          }
        }
      }
    },
    {
      "subId": "1502213",
      "subQuestName": "封堵喷口",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "150221301"
        ],
        "dialogs": {
          "150221301": {
            "id": "150221301",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "唔…呃…头一次飞得这么快…感觉要吐出来了…",
            "nextDialogs": [
              "150221302"
            ]
          },
          "150221302": {
            "id": "150221302",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "顺利上来了就好…",
            "nextDialogs": [
              "150221303"
            ]
          },
          "150221303": {
            "id": "150221303",
            "speakerId": 1001,
            "speakerName": "恰斯卡",
            "text": "嗯…果然，这个热气球看上去跟部族里的没区别，实际上已经被全面改造了。",
            "nextDialogs": [
              "150221304"
            ]
          },
          "150221304": {
            "id": "150221304",
            "speakerId": 1001,
            "speakerName": "恰斯卡",
            "text": "是因为改造部分的故障，才从更高处下降到可见高度。",
            "nextDialogs": [
              "150221305"
            ]
          },
          "150221305": {
            "id": "150221305",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "你能看出哪里有故障吗？",
            "nextDialogs": [
              "150221306"
            ]
          },
          "150221306": {
            "id": "150221306",
            "speakerId": 1001,
            "speakerName": "恰斯卡",
            "text": "有特帕尔的手记在，问题不大。平时我的枪械出了故障，也是自己保养的。",
            "nextDialogs": [
              "150221307"
            ]
          },
          "150221307": {
            "id": "150221307",
            "speakerId": 1001,
            "speakerName": "恰斯卡",
            "text": "嗯…感觉上差不多了——再往这里踢上一脚就行。",
            "nextDialogs": [
              "150221308"
            ]
          },
          "150221308": {
            "id": "150221308",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "你平时都是这么保养你的枪的吗…",
            "nextDialogs": [
              "150221309"
            ]
          },
          "150221309": {
            "id": "150221309",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "欸欸欸——还真动起来了！？"
          }
        }
      }
    },
    {
      "subId": "1502207",
      "subQuestName": "封堵喷口",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "150220701"
        ],
        "dialogs": {
          "150220701": {
            "id": "150220701",
            "speakerId": 1002,
            "speakerName": "希诺宁",
            "text": "嗯？你们还有什么要调查的吗？",
            "nextDialogs": [
              "150220702"
            ]
          },
          "150220702": {
            "id": "150220702",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "暂时没事了，普玛那边…",
            "nextDialogs": [
              "150220703"
            ]
          },
          "150220703": {
            "id": "150220703",
            "speakerId": 1002,
            "speakerName": "希诺宁",
            "text": "还好，她的情绪已经安定下来了。我回头会再去看望一下。",
            "nextDialogs": [
              "150220704"
            ]
          },
          "150220704": {
            "id": "150220704",
            "speakerId": 1002,
            "speakerName": "希诺宁",
            "text": "把那本手记交给你们后，她看起来就像是放下了什么…大概也不是坏事吧。"
          }
        }
      }
    },
    {
      "subId": "1502208",
      "subQuestName": "封堵喷口",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "150220801"
        ],
        "dialogs": {
          "150220801": {
            "id": "150220801",
            "speakerId": 1008,
            "speakerName": "瓦斯卡尔",
            "text": "——要「燃素翼」！不要绒翼龙！",
            "nextDialogs": [
              "150220802"
            ]
          },
          "150220802": {
            "id": "150220802",
            "speakerId": 1009,
            "speakerName": "穆基",
            "text": "开什么玩笑！绒翼龙是我们最好的伙伴！"
          }
        }
      }
    },

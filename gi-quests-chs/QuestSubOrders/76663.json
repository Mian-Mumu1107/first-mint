{
  "lineCounts": {
    "菈乌玛": 11,
    "韦克塞尔": 10
  },
  "subQuests": [
    {
      "subId": "7666301",
      "subQuestName": "",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "766505001"
        ],
        "dialogs": {
          "766505001": {
            "id": "766505001",
            "speakerId": 1000,
            "speakerName": "菈乌玛",
            "text": "韦克塞尔先生，辛苦您了。这是所有的修理费，请您收好。",
            "nextDialogs": [
              "766505002"
            ]
          },
          "766505002": {
            "id": "766505002",
            "speakerId": 1001,
            "speakerName": "韦克塞尔",
            "text": "哎哟！菈乌玛小姐，您是什么时候来的？我刚才都没看见您…",
            "nextDialogs": [
              "766505003"
            ]
          },
          "766505003": {
            "id": "766505003",
            "speakerId": 1000,
            "speakerName": "菈乌玛",
            "text": "您在帮莉伊妲修理书柜的时候，我就听团雀提起您了。",
            "nextDialogs": [
              "766505004"
            ]
          },
          "766505004": {
            "id": "766505004",
            "speakerId": 1000,
            "speakerName": "菈乌玛",
            "text": "它们说，您去周围找了很久的木头，最后还是由它们带您去找到了一棵倒下的树。",
            "nextDialogs": [
              "766505005"
            ]
          },
          "766505005": {
            "id": "766505005",
            "speakerId": 1001,
            "speakerName": "韦克塞尔",
            "text": "团雀？啊！怪不得，那几只团雀绕着我飞来飞去…我还以为它们是想找我帮忙呢。",
            "nextDialogs": [
              "766505006"
            ]
          },
          "766505006": {
            "id": "766505006",
            "speakerId": 1000,
            "speakerName": "菈乌玛",
            "text": "对了，它们还说，谢谢您的苹果，很好吃。",
            "nextDialogs": [
              "766505007"
            ]
          },
          "766505007": {
            "id": "766505007",
            "speakerId": 1001,
            "speakerName": "韦克塞尔",
            "text": "嘿嘿，没事没事，我还得谢谢它们带我去找木头呢。",
            "nextDialogs": [
              "766505008"
            ]
          },
          "766505008": {
            "id": "766505008",
            "speakerId": 1001,
            "speakerName": "韦克塞尔",
            "text": "要是找不到合适的，我就只能回镇上采购了。那样的话，莉伊妲的书架就不知道什么时候才能修好了。",
            "nextDialogs": [
              "766505009"
            ]
          },
          "766505009": {
            "id": "766505009",
            "speakerId": 1001,
            "speakerName": "韦克塞尔",
            "text": "…咦？菈乌玛小姐，您是不是把钱算多了？",
            "nextDialogs": [
              "766505010"
            ]
          },
          "766505010": {
            "id": "766505010",
            "speakerId": 1000,
            "speakerName": "菈乌玛",
            "text": "多出来的那些钱，付的是您自费购置的材料费用。",
            "nextDialogs": [
              "766505011"
            ]
          },
          "766505011": {
            "id": "766505011",
            "speakerId": 1001,
            "speakerName": "韦克塞尔",
            "text": "都是些边角料，不是大部件，用不着多付给我的。",
            "nextDialogs": [
              "766505012"
            ]
          },
          "766505012": {
            "id": "766505012",
            "speakerId": 1000,
            "speakerName": "菈乌玛",
            "text": "不，这是您应得的，请您收下，不要推辞。",
            "nextDialogs": [
              "766505013"
            ]
          },
          "766505013": {
            "id": "766505013",
            "speakerId": 1000,
            "speakerName": "菈乌玛",
            "text": "如果您执意不收，我就只能拜托我的朋友们，把钱袋直接塞进您枕头底下了。",
            "nextDialogs": [
              "766505014"
            ]
          },
          "766505014": {
            "id": "766505014",
            "speakerId": 1001,
            "speakerName": "韦克塞尔",
            "text": "那就多谢菈乌玛小姐了，您书库里不是需要打一个新书架吗？包在我身上，过几天就能好！",
            "nextDialogs": [
              "766505015"
            ]
          },
          "766505015": {
            "id": "766505015",
            "speakerId": 1000,
            "speakerName": "菈乌玛",
            "text": "谢谢您，但也请您不要太过辛苦。建立书库的本意，是为了让大家有一个放松身心的场合。",
            "nextDialogs": [
              "766505016"
            ]
          },
          "766505016": {
            "id": "766505016",
            "speakerId": 1000,
            "speakerName": "菈乌玛",
            "text": "如果帮忙建造书库的人都劳累不堪，那这间书库，从一开始就要失去它存在的意义了。",
            "nextDialogs": [
              "766505017"
            ]
          },
          "766505017": {
            "id": "766505017",
            "speakerId": 1001,
            "speakerName": "韦克塞尔",
            "text": "放心吧菈乌玛小姐，我心里有数的。",
            "nextDialogs": [
              "766505018"
            ]
          },
          "766505018": {
            "id": "766505018",
            "speakerId": 1000,
            "speakerName": "菈乌玛",
            "text": "另外，我听索妮齐娅提起过她对您的邀请。如果您有意愿加入「霜月之子」，信仰之事不用太过在意。",
            "nextDialogs": [
              "766505019"
            ]
          },
          "766505019": {
            "id": "766505019",
            "speakerId": 1000,
            "speakerName": "菈乌玛",
            "text": "您对我们的帮助，所有人都有目共睹。在大家眼里，您早已是我们的家人了。",
            "nextDialogs": [
              "766505020"
            ]
          },
          "766505020": {
            "id": "766505020",
            "speakerId": 1001,
            "speakerName": "韦克塞尔",
            "text": "好的，菈乌玛小姐。我…再回去想想。",
            "nextDialogs": [
              "766505021"
            ]
          },
          "766505021": {
            "id": "766505021",
            "speakerId": 1001,
            "speakerName": "韦克塞尔",
            "text": "谢谢您。"
          }
        }
      }
    }
  ]
}
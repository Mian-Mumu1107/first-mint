          "191430101": {
            "id": "191430101",
            "speakerId": 1005,
            "speakerName": "松本",
            "text": "有谁路过这里？不好意思，刚刚我一心在品鉴这儿的柠檬水…",
            "nextDialogs": [
              "191430102"
            ]
          },
          "191430102": {
            "id": "191430102",
            "speakerId": 1005,
            "speakerName": "松本",
            "text": "要打听消息的话，不如问问对面温泉馆的人吧。"
          }
        }
      }
    },
    {
      "subId": "1914311",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "191431101"
        ],
        "dialogs": {
          "191431101": {
            "id": "191431101",
            "speakerId": 1003,
            "speakerName": "久岐忍",
            "text": "你们先待在此地，不要走动，明白了吗？",
            "nextDialogs": [
              "191431102"
            ]
          },
          "191431102": {
            "id": "191431102",
            "speakerId": 1006,
            "speakerName": "阿守",
            "text": "明、明白了，我们是真的跑不动了…",
            "nextDialogs": [
              "191431103"
            ]
          },
          "191431103": {
            "id": "191431103",
            "speakerId": 1003,
            "speakerName": "久岐忍",
            "text": "现在是跑不动，等缓过劲，不会又想逃跑吧。",
            "nextDialogs": [
              "191431104"
            ]
          },
          "191431104": {
            "id": "191431104",
            "speakerId": 1007,
            "speakerName": "元太",
            "text": "不敢不敢！我们再也不敢了！"

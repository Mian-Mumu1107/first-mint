    {
      "subId": "1914304",
      "subQuestName": "寻找元太等人的踪迹",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "191431001"
        ],
        "dialogs": {
          "191431001": {
            "id": "191431001",
            "speakerId": 1000,
            "speakerName": "奏太",
            "text": "怎么办？难道今天就玩不了《七圣召唤》了吗？",
            "nextDialogs": [
              "191431002"
            ]
          },
          "191431002": {
            "id": "191431002",
            "speakerId": 1002,
            "speakerName": "瑛太",
            "text": "要不然换个地方？可是除了桥底下，还有什么地方不容易被大人发现啊…",
            "nextDialogs": [
              "191431003"
            ]
          },
          "191431003": {
            "id": "191431003",
            "speakerId": 1000,
            "speakerName": "奏太",
            "text": "啊啊…干脆去请宵宫姐姐放点烟花，把占地方的人给吓出来吧！",
            "nextDialogs": [
              "191431004"
            ]
          },
          "191431004": {
            "id": "191431004",
            "speakerId": 1002,
            "speakerName": "瑛太",
            "text": "这不太好吧？虽然确实是他先动手把我们赶出来的…",
            "nextDialogs": [
              "191431005"
            ]
          },
          "191431005": {
            "id": "191431005",
            "speakerId": 1000,
            "speakerName": "奏太",
            "text": "所以全都是他不好嘛！",
            "nextDialogs": [
              "191431006"
            ]
          },
          "191431006": {
            "id": "191431006",
            "speakerId": 1001,
            "speakerName": "由真",
            "text": "我觉得…我们是不是，该回家写作业了？",
            "nextDialogs": [
              "191431007"
            ]
          },
          "191431007": {
            "id": "191431007",
            "speakerId": 1001,
            "speakerName": "由真",
            "text": "老是打牌不学习的话，将来不会也变成<color=#00E1FFFF>桥底下那种大人</color>吧？"
          }
        }
      }
    },

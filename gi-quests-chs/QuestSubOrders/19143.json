        "dialogs": {
          "191430901": {
            "id": "191430901",
            "speakerId": 1004,
            "speakerName": "蓝川丞",
            "text": "刚才我在馆里打扫的时候，外面突然吵闹了起来。",
            "nextDialogs": [
              "191430902"
            ]
          },
          "191430902": {
            "id": "191430902",
            "speakerId": 1004,
            "speakerName": "蓝川丞",
            "text": "我刚一出门，就看到…<color=#00E1FFFF>有个黑影从树下一下子窜了上去！</color>",
            "nextDialogs": [
              "191430903"
            ]
          },
          "191430903": {
            "id": "191430903",
            "speakerId": 1004,
            "speakerName": "蓝川丞",
            "text": "这人来人往的，不会是什么小偷强盗吧…"
          }
        }
      }

    {
      "subId": "7605001",
      "subQuestName": "同「少女」见面",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "760500101"
        ],
        "dialogs": {
          "760500101": {
            "id": "760500101",
            "speakerId": 15703,
            "speakerName": "月灵",
            "text": "~！",
            "nextDialogs": [
              "760500102"
            ]
          },
          "760500102": {
            "id": "760500102",
            "speakerId": 15703,
            "speakerName": "月灵",
            "text": "！！",
            "nextDialogs": [
              "760500103"
            ]
          },
          "760500103": {
            "id": "760500103",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "哇，今天这里好热闹啊，有好多月灵都在哥伦比娅身边起舞呢。",
            "nextDialogs": [
              "760500104"
            ]
          },
          "760500104": {
            "id": "760500104",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "呃，等等…好像不是跳舞！月灵们是想朝她撒娇吗？哥伦比娅快要被淹没了！",
            "nextDialogs": [
              "760500105"
            ]
          },
          "760500105": {
            "id": "760500105",
            "speakerId": 1318,
            "speakerName": "「少女」",
            "text": "救…救救。",
            "nextDialogs": [
              "760500106"
            ]
          },
          "760500106": {
            "id": "760500106",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "把手给我。",
            "nextDialogs": [
              "760500107"
            ]
          },
          "760500107": {
            "id": "760500107",
            "speakerId": 1318,
            "speakerName": "「少女」",
            "text": "呼…谢谢你们…",
            "nextDialogs": [
              "760500108"
            ]
          },
          "760500108": {
            "id": "760500108",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "刚才那是发生什么了？月灵们平时不会那么激动吧…",
            "nextDialogs": [
              "760500109"
            ]
          },
          "760500109": {
            "id": "760500109",
            "speakerId": 15703,
            "speakerName": "月灵",
            "text": "~！",
            "nextDialogs": [
              "760500110"
            ]
          },
          "760500110": {
            "id": "760500110",
            "speakerId": 1318,
            "speakerName": "「少女」",
            "text": "嗯…",
            "nextDialogs": [
              "760500111"
            ]
          },
          "760500111": {
            "id": "760500111",
            "speakerId": 1318,
            "speakerName": "「少女」",
            "text": "我陪这些孩子玩了点游戏，它们似乎很享受。",
            "nextDialogs": [
              "760500112"
            ]
          },
          "760500112": {
            "id": "760500112",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "享受完游戏时间之后围到你身边转…怎么感觉像狗狗一样呢？",
            "nextDialogs": [
              "760500113"
            ]
          },
          "760500113": {
            "id": "760500113",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "这就是它们表达感谢的方式吧。",
            "nextDialogs": [
              "760500114"
            ]
          },
          "760500114": {
            "id": "760500114",
            "speakerId": 1318,
            "speakerName": "「少女」",
            "text": "只不过这次一不留神，谢意就像雪堆一样积起来了…",
            "nextDialogs": [
              "760500115"
            ]
          },
          "760500115": {
            "id": "760500115",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "说是这么说，你不还是很宠它们嘛！",
            "nextDialogs": [
              "760500116"
            ]
          },
          "760500116": {
            "id": "760500116",
            "speakerId": 1318,
            "speakerName": "「少女」",
            "text": "你们也想试试看吗？",
            "nextDialogs": [
              "760500118",
              "760500120"
            ]
          },
          "760500118": {
            "id": "760500118",
            "speakerId": 1318,
            "speakerName": "「少女」",
            "text": "嗯…这个也行。只要你答得上来。",
            "nextDialogs": [
              "760500121"
            ]
          },
          "760500121": {
            "id": "760500121",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "行啊，我倒要看看是什么游戏，那么受月灵欢迎。",
            "nextDialogs": [
              "760500122"
            ]
          },
          "760500122": {
            "id": "760500122",
            "speakerId": 1318,
            "speakerName": "「少女」",
            "text": "去吧。",
            "nextDialogs": [
              "760500123"
            ]
          },
          "760500123": {
            "id": "760500123",
            "speakerId": 15703,
            "speakerName": "月灵",
            "text": "~！",
            "nextDialogs": [
              "760500124"
            ]
          },
          "760500124": {
            "id": "760500124",
            "speakerId": 15703,
            "speakerName": "月灵",
            "text": "！！"
          },
          "760500120": {
            "id": "760500120",
            "speakerId": 1318,
            "speakerName": "「少女」",
            "text": "嗯。"
          }
        }
      }
    },
    {

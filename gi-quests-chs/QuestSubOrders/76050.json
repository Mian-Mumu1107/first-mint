          "760500903": {
            "id": "760500903",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "满意了吧？",
            "nextDialogs": [
              "760500904"
            ]
          },
          "760500904": {
            "id": "760500904",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "真的软乎乎的。",
            "nextDialogs": [
              "760500905"
            ]
          },
          "760500905": {
            "id": "760500905",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "怎么猜错了的人也有奖励啦，难道是参与奖？",
            "nextDialogs": [
              "760500906"
            ]
          },
          "760500906": {
            "id": "760500906",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "好乖好乖。",
            "nextDialogs": [
              "760500907"
            ]
          },
          "760500907": {
            "id": "760500907",
            "speakerId": 1318,
            "speakerName": "「少女」",
            "text": "它们喜欢你。",
            "nextDialogs": [
              "760500908"
            ]
          },
          "760500908": {
            "id": "760500908",
            "speakerId": 1318,
            "speakerName": "「少女」",
            "text": "我能感觉到，当这些孩子靠近你的时候，它们本身也放松了下来。",
            "nextDialogs": [
              "760500909"
            ]
          },
          "760500909": {
            "id": "760500909",
            "speakerId": 1318,
            "speakerName": "「少女」",
            "text": "就像凛角鹿喜欢沐浴着月光生长，月灵们也喜欢你心中散发出的什么。",
            "nextDialogs": [
              "760500910"
            ]
          },
          "760500910": {
            "id": "760500910",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "嗯？那是什么呢？",
            "nextDialogs": [
              "760500911"
            ]
          },
          "760500911": {
            "id": "760500911",
            "speakerId": 1318,
            "speakerName": "「少女」",
            "text": "温柔与善良吧。"
          }
        }
      }
    },
    {

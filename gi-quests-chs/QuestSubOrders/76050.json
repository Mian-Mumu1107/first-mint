        "dialogs": {
          "760500301": {
            "id": "760500301",
            "speakerId": 1318,
            "speakerName": "「少女」",
            "text": "猜猜看这是什么图案吧。",
            "nextDialogs": [
              "760500302"
            ]
          },
          "760500302": {
            "id": "760500302",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "欸？这…这也太抽象了。",
            "nextDialogs": [
              "760500303"
            ]
          },
          "760500303": {
            "id": "760500303",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "哥伦比娅，你刚刚真的答对了吗？",
            "nextDialogs": [
              "760500304"
            ]
          },
          "760500304": {
            "id": "760500304",
            "speakerId": 1318,
            "speakerName": "「少女」",
            "text": "好像错的时候更多一些。",
            "nextDialogs": [
              "760500305"
            ]
          },
          "760500305": {
            "id": "760500305",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "#我放弃了。{NICKNAME}，你猜吧。",
            "nextDialogs": [
              "760500307",
              "760500311",
              "760500316"
            ]
          },
          "760500307": {
            "id": "760500307",
            "speakerId": 15703,
            "speakerName": "月灵",
            "text": "！！",
            "nextDialogs": [
              "760500308"
            ]
          },
          "760500308": {
            "id": "760500308",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "噢！看这反应是！",
            "nextDialogs": [
              "760500309"
            ]
          },
          "760500309": {
            "id": "760500309",
            "speakerId": 1318,
            "speakerName": "「少女」",
            "text": "恭喜，猜对了呢。"
          },
          "760500311": {
            "id": "760500311",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "好担心啊！它的脖子是不是出了点问题啊！",
            "nextDialogs": [
              "760500312"
            ]
          },
          "760500312": {
            "id": "760500312",
            "speakerId": 1318,
            "speakerName": "「少女」",
            "text": "嗯…是没有见过的生物呢…",
            "nextDialogs": [
              "760500313"
            ]
          },
          "760500313": {
            "id": "760500313",
            "speakerId": 1318,
            "speakerName": "「少女」",
            "text": "正确答案是凛角鹿。",
            "nextDialogs": [
              "760500314"
            ]
          },
          "760500314": {
            "id": "760500314",
            "speakerId": 1318,
            "speakerName": "「少女」",
            "text": "月灵们，回来吧。"
          },
          "760500316": {
            "id": "760500316",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "好丰富的想象力…",
            "nextDialogs": [
              "760500317"
            ]
          },
          "760500317": {
            "id": "760500317",
            "speakerId": 1318,
            "speakerName": "「少女」",
            "text": "哈…很有趣的答案。",
            "nextDialogs": [
              "760500318"
            ]
          },
          "760500318": {
            "id": "760500318",
            "speakerId": 1318,

    {
      "subId": "4013402",
      "subQuestName": "进行映影的拍摄",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "401340101"
        ],
        "dialogs": {
          "401340101": {
            "id": "401340101",
            "speakerId": 1073,
            "speakerName": "芙宁娜",
            "text": "大家辛苦了！今天是两位主角的杀青戏，我们已经离成功不远了。",
            "nextDialogs": [
              "401340102"
            ]
          },
          "401340102": {
            "id": "401340102",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "「杀青」是什么意思？",
            "nextDialogs": [
              "401340105"
            ]
          },
          "401340105": {
            "id": "401340105",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "哦！你懂的真多！",
            "nextDialogs": [
              "401340106"
            ]
          },
          "401340106": {
            "id": "401340106",
            "speakerId": 1073,
            "speakerName": "芙宁娜",
            "text": "这场讲的是两位铳枪手与伯爵的最终对峙，动作戏会比较多，大家按照之前排练的来就行。",
            "nextDialogs": [
              "401340107"
            ]
          },
          "401340107": {
            "id": "401340107",
            "speakerId": 1073,
            "speakerName": "芙宁娜",
            "text": "准备好，三、二、一，开始！",
            "nextDialogs": [
              "401340108"
            ]
          },
          "401340108": {
            "id": "401340108",
            "speakerId": 1002,
            "speakerName": "「伯爵」",
            "text": "今天的夜色可真美，不是吗？让我想到了十年前的那个夜晚。",
            "nextDialogs": [
              "401340109"
            ]
          },
          "401340109": {
            "id": "401340109",
            "speakerId": 1002,
            "speakerName": "「伯爵」",
            "text": "嗯，这么一闻，我甚至都能嗅到花草茶的香气。",
            "nextDialogs": [
              "401340110"
            ]
          },
          "401340110": {
            "id": "401340110",
            "speakerId": 1003,
            "speakerName": "「爱芮丝」",
            "text": "闭嘴，你这个害死了母亲的恶棍。",
            "nextDialogs": [
              "401340111"
            ]
          },
          "401340111": {
            "id": "401340111",
            "speakerId": 1002,
            "speakerName": "「伯爵」",
            "text": "我亲爱的爱芮丝，你怎么能这么跟我说话呢？我可是你的父亲。",
            "nextDialogs": [
              "401340112"
            ]
          },
          "401340112": {
            "id": "401340112",
            "speakerId": 1004,
            "speakerName": "「图利佩」",
            "text": "就算是拔光我嘴里的最后一颗牙，也别指望我吐出这两个字。",
            "nextDialogs": [
              "401340113"
            ]
          },
          "401340113": {
            "id": "401340113",
            "speakerId": 1002,
            "speakerName": "「伯爵」",
            "text": "…我的女儿们，你们就和那位愚蠢的母亲一样执迷不悟。",
            "nextDialogs": [
              "401340114"
            ]
          },
          "401340114": {
            "id": "401340114",
            "speakerId": 1002,
            "speakerName": "「伯爵」",
            "text": "在这个社会，有了金钱和地位，就是有了绝对的力量。",
            "nextDialogs": [
              "401340115"
            ]
          },
          "401340115": {
            "id": "401340115",
            "speakerId": 1002,
            "speakerName": "「伯爵」",
            "text": "她以为用孩子就可以要挟我，向我提要求？不不不，她太天真了。",
            "nextDialogs": [
              "401340116"
            ]
          },
          "401340116": {
            "id": "401340116",
            "speakerId": 1003,
            "speakerName": "「爱芮丝」",
            "text": "母亲从未向你提过什么要求，她只希望我们像其他人一样过上安稳的一生。",
            "nextDialogs": [
              "401340117"
            ]
          },
          "401340117": {
            "id": "401340117",
            "speakerId": 1004,
            "speakerName": "「图利佩」",
            "text": "是你们亲手酿出了名为「偏见」的毒药，害死了母亲。",
            "nextDialogs": [
              "401340118"
            ]
          },
          "401340118": {
            "id": "401340118",
            "speakerId": 1004,
            "speakerName": "「图利佩」",
            "text": "和这毒药比起来，你即将吃到的两颗子弹，已经算甜的了。",
            "nextDialogs": [
              "401340119"
            ]
          },
          "401340119": {
            "id": "401340119",
            "speakerId": 1002,
            "speakerName": "「伯爵」",
            "text": "哈哈哈，所以说，你们和她一样天真。以为有两把枪就赢了？",
            "nextDialogs": [
              "401340120"
            ]
          },
          "401340120": {
            "id": "401340120",
            "speakerId": 1002,
            "speakerName": "「伯爵」",
            "text": "就让我看看，是金钱与地位更厉害，还是你们手上的枪更厉害。"
          }
        }
      }
    },
    {
      "subId": "4013406",
      "subQuestName": "拍摄复仇的场景，击败敌人",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [],
        "dialogs": {}
      }
    },
    {
      "subId": "4013403",
      "subQuestName": "进行映影的拍摄",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "401340201"
        ],
        "dialogs": {
          "401340201": {
            "id": "401340201",
            "speakerId": 1004,
            "speakerName": "「图利佩」",
            "text": "你输了。",
            "nextDialogs": [
              "401340202"
            ]
          },
          "401340202": {
            "id": "401340202",
            "speakerId": 1002,
            "speakerName": "「伯爵」",
            "text": "嘁…想不到，区区两个丫头…",
            "nextDialogs": [
              "401340203"
            ]
          },
          "401340203": {
            "id": "401340203",
            "speakerId": 1003,
            "speakerName": "「爱芮丝」",
            "text": "我们从不是你的丫头，那里也不是我们的家。",
            "nextDialogs": [
              "401340204"
            ]
          },
          "401340204": {
            "id": "401340204",
            "speakerId": 1002,
            "speakerName": "「伯爵」",
            "text": "哼…告诉我，这一切到底为了什么？",
            "nextDialogs": [
              "401340205"
            ]
          },
          "401340205": {
            "id": "401340205",
            "speakerId": 1002,
            "speakerName": "「伯爵」",
            "text": "你们失去了母亲、杀死了父亲…除了一身罪名，还能留下什么？",
            "nextDialogs": [
              "401340206"
            ]
          },
          "401340206": {
            "id": "401340206",
            "speakerId": 1004,
            "speakerName": "「图利佩」",
            "text": "留下了…「正义」。",
            "nextDialogs": [
              "401340207"
            ]
          },
          "401340207": {
            "id": "401340207",
            "speakerId": 1004,
            "speakerName": "「图利佩」",
            "text": "（枪响——）",
            "nextDialogs": [
              "401340208"
            ]
          },
          "401340208": {
            "id": "401340208",
            "speakerId": 1004,
            "speakerName": "「图利佩」",
            "text": "…结束了。",
            "nextDialogs": [
              "401340209"
            ]
          },
          "401340209": {
            "id": "401340209",
            "speakerId": 1003,
            "speakerName": "「爱芮丝」",
            "text": "…终于，结束了。",
            "nextDialogs": [
              "401340210"
            ]
          },
          "401340210": {
            "id": "401340210",
            "speakerId": 1003,
            "speakerName": "「爱芮丝」",
            "text": "姐姐，接下来你会去哪里？",
            "nextDialogs": [
              "401340211"
            ]
          },
          "401340211": {
            "id": "401340211",
            "speakerId": 1004,
            "speakerName": "「图利佩」",
            "text": "我不知道，爱芮丝，可能去一个开满鲜花的地方吧，母亲以前常这么说。你呢？",
            "nextDialogs": [
              "401340212"
            ]
          },
          "401340212": {
            "id": "401340212",
            "speakerId": 1003,
            "speakerName": "「爱芮丝」",
            "text": "我想先去给母亲扫一次墓。",
            "nextDialogs": [
              "401340213"
            ]
          },
          "401340213": {
            "id": "401340213",
            "speakerId": 1004,
            "speakerName": "「图利佩」",
            "text": "嗯，不错的主意…",
            "nextDialogs": [
              "401340214"
            ]
          },
          "401340214": {
            "id": "401340214",
            "speakerId": 1003,
            "speakerName": "「爱芮丝」",
            "text": "…！姐姐，你看！",
            "nextDialogs": [
              "401340215"
            ]
          },
          "401340215": {
            "id": "401340215",
            "speakerId": 1004,
            "speakerName": "「图利佩」",
            "text": "怎么了？",
            "nextDialogs": [
              "401340216"
            ]
          },
          "401340216": {
            "id": "401340216",
            "speakerId": 1003,
            "speakerName": "「爱芮丝」",
            "text": "母亲最喜欢的虹彩蔷薇，开了。",
            "nextDialogs": [
              "401340217"
            ]
          },
          "401340217": {
            "id": "401340217",
            "speakerId": 1073,
            "speakerName": "芙宁娜",
            "text": "（啪——啪——）",
            "nextDialogs": [
              "401340218"
            ]
          },
          "401340218": {
            "id": "401340218",
            "speakerId": 1073,
            "speakerName": "芙宁娜",
            "text": "精彩，真是太精彩了！我也没想到这条能拍得那么顺利，一气呵成。",
            "nextDialogs": [
              "401340219"
            ]
          },
          "401340219": {
            "id": "401340219",
            "speakerId": 1073,
            "speakerName": "芙宁娜",
            "text": "我宣布，两位主角的戏码杀青！",
            "nextDialogs": [
              "401340220"
            ]
          },
          "401340220": {
            "id": "401340220",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "绫华！夏沃蕾！恭喜你们！",
            "nextDialogs": [
              "401340223"
            ]
          },
          "401340223": {
            "id": "401340223",
            "speakerId": 1013,
            "speakerName": "神里绫华",
            "text": "谢谢各位。没想到夏沃蕾和我的戏份这么快就拍完了，还真有些舍不得。",
            "nextDialogs": [
              "401340224"
            ]
          },
          "401340224": {
            "id": "401340224",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "我能理解，想到再过几天就不能玩打板器了，好遗憾啊。拍映影还真是件开心的事情呢！",
            "nextDialogs": [
              "401340225"
            ]
          },
          "401340225": {
            "id": "401340225",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "夏沃蕾也很棒，那句「留下了正义」，简直太帅了！",
            "nextDialogs": [
              "401340226"
            ]
          },
          "401340226": {
            "id": "401340226",
            "speakerId": 1081,
            "speakerName": "夏沃蕾",
            "text": "这的确是书中我最喜欢的台词，以前读到的时候，还经常在自己房间里比划。",
            "nextDialogs": [
              "401340227"
            ]
          },
          "401340227": {
            "id": "401340227",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "真看不出夏沃蕾你还有这样的一面。",
            "nextDialogs": [
              "401340228"
            ]
          },
          "401340228": {
            "id": "401340228",
            "speakerId": 1081,
            "speakerName": "夏沃蕾",
            "text": "坏人被制裁，正义战胜邪恶，有谁不喜欢这样的结局？别忘了，我可是枫丹特巡队队长。",
            "nextDialogs": [
              "401340229"
            ]
          },
          "401340229": {
            "id": "401340229",
            "speakerId": 30443,
            "speakerName": "勒泰利埃",
            "text": "报告！队长。有紧急情况需要汇报。",
            "nextDialogs": [
              "401340230"
            ]
          },
          "401340230": {
            "id": "401340230",
            "speakerId": 1081,
            "speakerName": "夏沃蕾",
            "text": "…抱歉，各位，我先失陪一下。",
            "nextDialogs": [
              "401340231"
            ]
          },
          "401340231": {
            "id": "401340231",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "你放心去忙吧！",
            "nextDialogs": [
              "401340232"
            ]
          },
          "401340232": {
            "id": "401340232",
            "speakerId": 1073,
            "speakerName": "芙宁娜",
            "text": "怎么这就被喊走了？我还想来夸夸她呢。",
            "nextDialogs": [
              "401340233"
            ]
          },
          "401340233": {
            "id": "401340233",
            "speakerId": 1013,
            "speakerName": "神里绫华",
            "text": "似乎是有要紧的公事要办。",
            "nextDialogs": [
              "401340234"
            ]
          },
          "401340234": {
            "id": "401340234",
            "speakerId": 1073,
            "speakerName": "芙宁娜",
            "text": "哦，那还好今天你们的部分顺利，不然拍摄计划调整起来还挺麻烦。",
            "nextDialogs": [
              "401340235"
            ]
          },
          "401340235": {
            "id": "401340235",
            "speakerId": 1073,
            "speakerName": "芙宁娜",
            "text": "对了，我是来告诉大家今天可以提前解散了，早点回去休息吧。",
            "nextDialogs": [
              "401340236"
            ]
          },
          "401340236": {
            "id": "401340236",
            "speakerId": 1073,
            "speakerName": "芙宁娜",
            "text": "还有，绫华小姐，你的演技还是一如既往的出色，真的不考虑来当专业演员吗？我刚好知道有个优秀的剧团在招募女主角。",
            "nextDialogs": [
              "401340237"
            ]
          },
          "401340237": {
            "id": "401340237",
            "speakerId": 1013,
            "speakerName": "神里绫华",
            "text": "谢谢芙宁娜导演的肯定。但稻妻社奉行还有许多事情需要操办，我无法长期留在枫丹从事演艺事业。",
            "nextDialogs": [
              "401340238"
            ]
          },
          "401340238": {
            "id": "401340238",
            "speakerId": 1013,
            "speakerName": "神里绫华",
            "text": "我会将这次的合作经历，当作一份宝物，珍藏于心的。",
            "nextDialogs": [
              "401340239"
            ]
          },
          "401340239": {
            "id": "401340239",
            "speakerId": 1073,
            "speakerName": "芙宁娜",
            "text": "好吧，真是可惜。但如果你改主意了，随时来找我。",
            "nextDialogs": [
              "401340240"
            ]
          },
          "401340240": {
            "id": "401340240",
            "speakerId": 1013,
            "speakerName": "神里绫华",
            "text": "我也差不多告辞了。虽说我的戏份已经结束，但之后几天我还是想来现场帮帮忙。",
            "nextDialogs": [
              "401340241"
            ]
          },
          "401340241": {
            "id": "401340241",
            "speakerId": 1013,
            "speakerName": "神里绫华",
            "text": "#{NICKNAME}，派蒙，我们明天见。",
            "nextDialogs": [
              "401340242"
            ]
          },
          "401340242": {
            "id": "401340242",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "嗯！明天见！",
            "nextDialogs": [
              "401340243"
            ]
          },
          "401340243": {
            "id": "401340243",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "我们接下来去哪里呢？也不知道今天还要不要和夏沃蕾一起调查。",
            "nextDialogs": [
              "401340244"
            ]
          },
          "401340244": {
            "id": "401340244",
            "speakerId": 1081,
            "speakerName": "夏沃蕾",
            "text": "#{NICKNAME}，派蒙，跟我来。",
            "nextDialogs": [
              "401340245"
            ]
          },
          "401340245": {
            "id": "401340245",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "欸？去…去哪儿？",
            "nextDialogs": [
              "401340246"
            ]
          },
          "401340246": {
            "id": "401340246",
            "speakerId": 1081,
            "speakerName": "夏沃蕾",
            "text": "我们的船，终于撞上一座「孤岛」了。"
          }
        }
      }
    },
    {
      "subId": "4013410",
      "subQuestName": "与夏沃蕾一同追踪线索",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "401340401"
        ],
        "dialogs": {
          "401340401": {
            "id": "401340401",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "呃…累死我了，拍完戏还走这么远的路。",
            "nextDialogs": [
              "401340402"
            ]
          },
          "401340402": {
            "id": "401340402",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "所以，夏沃蕾你把我们带到这里做什么呀？",
            "nextDialogs": [
              "401340403"
            ]
          },
          "401340403": {
            "id": "401340403",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "有什么线索了？",
            "nextDialogs": [
              "401340404"
            ]
          },
          "401340404": {
            "id": "401340404",
            "speakerId": 1081,
            "speakerName": "夏沃蕾",
            "text": "没错。虽然不是决定性证据，但也是关键的一步。",
            "nextDialogs": [
              "401340405"
            ]
          },
          "401340405": {
            "id": "401340405",
            "speakerId": 1081,
            "speakerName": "夏沃蕾",
            "text": "你们听过艾梅莉埃这个名字吗？",
            "nextDialogs": [
              "401340406"
            ]
          },
          "401340406": {
            "id": "401340406",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "哦，是那位著名的调香师吧？",
            "nextDialogs": [
              "401340407"
            ]
          },
          "401340407": {
            "id": "401340407",
            "speakerId": 1081,
            "speakerName": "夏沃蕾",
            "text": "她和我关系不错，偶尔会帮我解决一些难题。",
            "nextDialogs": [
              "401340408"
            ]
          },
          "401340408": {
            "id": "401340408",
            "speakerId": 1081,
            "speakerName": "夏沃蕾",
            "text": "我不久前将案发现场留下的虹彩蔷薇寄给了她，毕竟，她每天都在和花卉打交道。",
            "nextDialogs": [
              "401340409"
            ]
          },
          "401340409": {
            "id": "401340409",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "结果呢？",
            "nextDialogs": [
              "401340410"
            ]
          },
          "401340410": {
            "id": "401340410",
            "speakerId": 1081,
            "speakerName": "夏沃蕾",
            "text": "花卉上没有留下什么其他的痕迹，土壤样本也没什么特别。",
            "nextDialogs": [
              "401340411"
            ]
          },
          "401340411": {
            "id": "401340411",
            "speakerId": 1081,
            "speakerName": "夏沃蕾",
            "text": "但艾梅莉埃发现，犯罪现场留下的虹彩蔷薇，是一种特别稀有的品种。",
            "nextDialogs": [
              "401340412"
            ]
          },
          "401340412": {
            "id": "401340412",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "虹彩蔷薇还分品种？这种花不是在枫丹野外遍地都是吗？",
            "nextDialogs": [
              "401340413"
            ]
          },
          "401340413": {
            "id": "401340413",
            "speakerId": 1081,
            "speakerName": "夏沃蕾",
            "text": "任何花卉人工繁育和自然条件下的生长结果都会有所不同。",
            "nextDialogs": [
              "401340414"
            ]
          },
          "401340414": {
            "id": "401340414",
            "speakerId": 1081,
            "speakerName": "夏沃蕾",
            "text": "我们之前知道案发现场的是人工繁育品种，但艾梅莉埃凭借她的专业本领，为我们进一步缩小了范围。",
            "nextDialogs": [
              "401340415"
            ]
          },
          "401340415": {
            "id": "401340415",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "哦！也就是说只要知道谁家种了这种品种，他就很有可能是犯人对吧！",
            "nextDialogs": [
              "401340416"
            ]
          },
          "401340416": {
            "id": "401340416",
            "speakerId": 1081,
            "speakerName": "夏沃蕾",
            "text": "没错，在进一步对购买记录进行交叉比对之后，我们发现枫丹只有一个人种这种品种的虹彩蔷薇。",
            "nextDialogs": [
              "401340417"
            ]
          },
          "401340417": {
            "id": "401340417",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "真的吗？是谁？",
            "nextDialogs": [
              "401340418"
            ]
          },
          "401340418": {
            "id": "401340418",
            "speakerId": 1081,
            "speakerName": "夏沃蕾",
            "text": "就是那位「作者」。",
            "nextDialogs": [
              "401340419"
            ]
          },
          "401340419": {
            "id": "401340419",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "欸？可你不是说…",
            "nextDialogs": [
              "401340420"
            ]
          },
          "401340420": {
            "id": "401340420",
            "speakerId": 1081,
            "speakerName": "夏沃蕾",
            "text": "我到现在也坚持自己的看法。我不认为他杀过人。",
            "nextDialogs": [
              "401340421"
            ]
          },
          "401340421": {
            "id": "401340421",
            "speakerId": 1081,
            "speakerName": "夏沃蕾",
            "text": "但，这不代表犯人没有到过他的家中，或是他没有向犯人出售过自己种的蔷薇。",
            "nextDialogs": [
              "401340422"
            ]
          },
          "401340422": {
            "id": "401340422",
            "speakerId": 1081,
            "speakerName": "夏沃蕾",
            "text": "不管怎样，一场问话是免不了的了。",
            "nextDialogs": [
              "401340423"
            ]
          },
          "401340423": {
            "id": "401340423",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "那我们现在要去的地方…",
            "nextDialogs": [
              "401340424"
            ]
          },
          "401340424": {
            "id": "401340424",
            "speakerId": 1081,
            "speakerName": "夏沃蕾",
            "text": "就是「作者」的家。"
          }
        }
      }
    },
    {
      "subId": "4013407",
      "subQuestName": "前往夏沃蕾所说的地点",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "401340701"
        ],
        "dialogs": {
          "401340701": {
            "id": "401340701",
            "speakerId": 1081,
            "speakerName": "夏沃蕾",
            "text": "那幢房子就是了。",
            "nextDialogs": [
              "401340702"
            ]
          },
          "401340702": {
            "id": "401340702",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "周围好多机械警卫，普通人的家不是这样的吧？",
            "nextDialogs": [
              "401340703"
            ]
          },
          "401340703": {
            "id": "401340703",
            "speakerId": 1081,
            "speakerName": "夏沃蕾",
            "text": "按上次和他见面的说法，这是希望不被人打扰。",
            "nextDialogs": [
              "401340704"
            ]
          },
          "401340704": {
            "id": "401340704",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "他院子里种着好多花。呃…但要避开这些警卫去摘也太困难了。",
            "nextDialogs": [
              "401340705"
            ]
          },
          "401340705": {
            "id": "401340705",
            "speakerId": 1081,
            "speakerName": "夏沃蕾",
            "text": "所以我觉得他和犯人的关系肯定不简单。",
            "nextDialogs": [
              "401340706"
            ]
          },
          "401340706": {
            "id": "401340706",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "我们要去敲门吗？",
            "nextDialogs": [
              "401340707"
            ]
          },
          "401340707": {
            "id": "401340707",
            "speakerId": 1081,
            "speakerName": "夏沃蕾",
            "text": "安全起见，还是让我解决一部分机械警卫再去吧。",
            "nextDialogs": [
              "401340708"
            ]
          },
          "401340708": {
            "id": "401340708",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "这么远的地方，你怎么解决？",
            "nextDialogs": [
              "401340709"
            ]
          },
          "401340709": {
            "id": "401340709",
            "speakerId": 1081,
            "speakerName": "夏沃蕾",
            "text": "派蒙你是不是忘了，我可是一位真正的「铳枪手」。"
          }
        }
      }
    },
    {
      "subId": "4013414",
      "subQuestName": "击败机械警卫",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [],
        "dialogs": {}
      }
    },
    {
      "subId": "4013408",
      "subQuestName": "击败机械警卫",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [],
        "dialogs": {}
      }
    },
    {
      "subId": "4013409",
      "subQuestName": "与夏沃蕾对话",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "401340901"
        ],
        "dialogs": {
          "401340901": {
            "id": "401340901",
            "speakerId": 1081,
            "speakerName": "夏沃蕾",
            "text": "搞定。我们走。",
            "nextDialogs": [
              "401340902"
            ]
          },
          "401340902": {
            "id": "401340902",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "等等等等，一想到那里可能有凶手我就有些紧张，再告诉我一遍该干什么。",
            "nextDialogs": [
              "401340903"
            ]
          },
          "401340903": {
            "id": "401340903",
            "speakerId": 1081,
            "speakerName": "夏沃蕾",
            "text": "我会先去敲门，确认屋内的安全。顺带问他愿不愿意去一趟警备队，我们有些问题要问他。",
            "nextDialogs": [
              "401340904"
            ]
          },
          "401340904": {
            "id": "401340904",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "不能直接逮捕他吗？",
            "nextDialogs": [
              "401340905"
            ]
          },
          "401340905": {
            "id": "401340905",
            "speakerId": 1081,
            "speakerName": "夏沃蕾",
            "text": "我们还没有充足的证据证明他就是凶手，或者协助过凶手。",
            "nextDialogs": [
              "401340906"
            ]
          },
          "401340906": {
            "id": "401340906",
            "speakerId": 1081,
            "speakerName": "夏沃蕾",
            "text": "不过，我希望在我敲门的时候，你们能帮我采一株他的虹彩蔷薇，方便之后带回去给逐影庭作比对。",
            "nextDialogs": [
              "401340907"
            ]
          },
          "401340907": {
            "id": "401340907",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "好，这没问题，夏沃蕾你也小心。"
          }
        }
      }
    },
    {
      "subId": "4013404",
      "subQuestName": "前往作者的家",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "401340301"
        ],
        "dialogs": {
          "401340301": {
            "id": "401340301",
            "speakerId": 1081,
            "speakerName": "夏沃蕾",
            "text": "巴蒂斯特先生，您在家吗？",
            "nextDialogs": [
              "401340302"
            ]
          },
          "401340302": {
            "id": "401340302",
            "speakerId": 30437,
            "speakerName": "巴蒂斯特",
            "text": "这么晚了…哟，是夏沃蕾警官。",
            "nextDialogs": [
              "401340303"
            ]
          },
          "401340303": {
            "id": "401340303",
            "speakerId": 1081,
            "speakerName": "夏沃蕾",
            "text": "巴蒂斯特先生，您介意和我一起去趟警备队吗？关于案件，还有些问题想问你。",
            "nextDialogs": [
              "401340304"
            ]
          },
          "401340304": {
            "id": "401340304",
            "speakerId": 30437,
            "speakerName": "巴蒂斯特",
            "text": "还是上次那个铳枪杀人案吗？",
            "nextDialogs": [
              "401340305"
            ]
          },
          "401340305": {
            "id": "401340305",
            "speakerId": 1081,
            "speakerName": "夏沃蕾",
            "text": "我暂时无可奉告。",
            "nextDialogs": [
              "401340306"
            ]
          },
          "401340306": {
            "id": "401340306",
            "speakerId": 30437,
            "speakerName": "巴蒂斯特",
            "text": "那就是没错了。",
            "nextDialogs": [
              "401340307"
            ]
          },
          "401340307": {
            "id": "401340307",
            "speakerId": 1081,
            "speakerName": "夏沃蕾",
            "text": "巴蒂斯特先生，您的回答是？",
            "nextDialogs": [
              "401340308"
            ]
          },
          "401340308": {
            "id": "401340308",
            "speakerId": 30437,
            "speakerName": "巴蒂斯特",
            "text": "哎…夏沃蕾小姐，我就为你省点功夫吧。还有那边的两位，也省下你们摘花的功夫吧，这些花苞还没到开放的那一天。",
            "nextDialogs": [
              "401340309"
            ]
          },
          "401340309": {
            "id": "401340309",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "呃…",
            "nextDialogs": [
              "401340310"
            ]
          },
          "401340310": {
            "id": "401340310",
            "speakerId": 1081,
            "speakerName": "夏沃蕾",
            "text": "您指的「省功夫」是…",
            "nextDialogs": [
              "401340311"
            ]
          },
          "401340311": {
            "id": "401340311",
            "speakerId": 30437,
            "speakerName": "巴蒂斯特",
            "text": "人是我杀的。",
            "nextDialogs": [
              "401340312"
            ]
          },
          "401340312": {
            "id": "401340312",
            "speakerId": 1081,
            "speakerName": "夏沃蕾",
            "text": "……！",
            "nextDialogs": [
              "401340313"
            ]
          },
          "401340313": {
            "id": "401340313",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "他…他承认了！",
            "nextDialogs": [
              "401340314"
            ]
          },
          "401340314": {
            "id": "401340314",
            "speakerId": 30437,
            "speakerName": "巴蒂斯特",
            "text": "几位放轻松，我身上没带武器。枪埋在后院里了。",
            "nextDialogs": [
              "401340315"
            ]
          },
          "401340315": {
            "id": "401340315",
            "speakerId": 1081,
            "speakerName": "夏沃蕾",
            "text": "…我有义务提醒你，巴蒂斯特先生，你现在说出的每一个字都会成为审判庭上的重要证据。",
            "nextDialogs": [
              "401340316"
            ]
          },
          "401340316": {
            "id": "401340316",
            "speakerId": 30437,
            "speakerName": "巴蒂斯特",
            "text": "我当然知道。",
            "nextDialogs": [
              "401340317"
            ]
          },
          "401340317": {
            "id": "401340317",
            "speakerId": 1081,
            "speakerName": "夏沃蕾",
            "text": "…我讨厌这种感觉。",
            "nextDialogs": [
              "401340318"
            ]
          },
          "401340318": {
            "id": "401340318",
            "speakerId": 30437,
            "speakerName": "巴蒂斯特",
            "text": "讨厌我认罪了，还是讨厌自己错了？",
            "nextDialogs": [
              "401340319"
            ]
          },
          "401340319": {
            "id": "401340319",
            "speakerId": 1081,
            "speakerName": "夏沃蕾",
            "text": "二者皆有。",
            "nextDialogs": [
              "401340322"
            ]
          },
          "401340322": {
            "id": "401340322",
            "speakerId": 30437,
            "speakerName": "巴蒂斯特",
            "text": "和我在小说中写的是一样的理由——为了复仇。",
            "nextDialogs": [
              "401340323"
            ]
          },
          "401340323": {
            "id": "401340323",
            "speakerId": 1081,
            "speakerName": "夏沃蕾",
            "text": "……",
            "nextDialogs": [
              "401340324"
            ]
          },
          "401340324": {
            "id": "401340324",
            "speakerId": 30437,
            "speakerName": "巴蒂斯特",
            "text": "我知道你们没有查到他和我的联系，不然我早就去警备队了。",
            "nextDialogs": [
              "401340325"
            ]
          },
          "401340325": {
            "id": "401340325",
            "speakerId": 30437,
            "speakerName": "巴蒂斯特",
            "text": "但我永远记得他的脸，就是他杀死了我的母亲。",
            "nextDialogs": [
              "401340326"
            ]
          },
          "401340326": {
            "id": "401340326",
            "speakerId": 1081,
            "speakerName": "夏沃蕾",
            "text": "…你母亲如今健在。",
            "nextDialogs": [
              "401340327"
            ]
          },
          "401340327": {
            "id": "401340327",
            "speakerId": 30437,
            "speakerName": "巴蒂斯特",
            "text": "你知道我是被领养的。我说的是亲生母亲。",
            "nextDialogs": [
              "401340328"
            ]
          },
          "401340328": {
            "id": "401340328",
            "speakerId": 1081,
            "speakerName": "夏沃蕾",
            "text": "这些可没写在孤儿院的记录里…",
            "nextDialogs": [
              "401340329"
            ]
          },
          "401340329": {
            "id": "401340329",
            "speakerId": 30437,
            "speakerName": "巴蒂斯特",
            "text": "母亲在眼前死去，足以让一位六岁的孩子学会用谎言保护自己。",
            "nextDialogs": [
              "401340330"
            ]
          },
          "401340330": {
            "id": "401340330",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "所以…小说中的那些都是…真的？",
            "nextDialogs": [
              "401340331"
            ]
          },
          "401340331": {
            "id": "401340331",
            "speakerId": 30437,
            "speakerName": "巴蒂斯特",
            "text": "不，当然不是。小说经过了艺术的加工。",
            "nextDialogs": [
              "401340332"
            ]
          },
          "401340332": {
            "id": "401340332",
            "speakerId": 30437,
            "speakerName": "巴蒂斯特",
            "text": "但…我是一位富人的私生子，而那位富人杀死了我的母亲，这是真的。",
            "nextDialogs": [
              "401340333"
            ]
          },
          "401340333": {
            "id": "401340333",
            "speakerId": 1081,
            "speakerName": "夏沃蕾",
            "text": "你杀死的人可没钱。",
            "nextDialogs": [
              "401340334"
            ]
          },
          "401340334": {
            "id": "401340334",
            "speakerId": 30437,
            "speakerName": "巴蒂斯特",
            "text": "他是被金钱雇佣的杀手，为了摩拉而对一位手无寸铁的母亲下手的禽兽。",
            "nextDialogs": [
              "401340335"
            ]
          },
          "401340335": {
            "id": "401340335",
            "speakerId": 1081,
            "speakerName": "夏沃蕾",
            "text": "如果真是这样，你就不该告诉我们这些。你还没有杀死真正的幕后黑手。",
            "nextDialogs": [
              "401340336"
            ]
          },
          "401340336": {
            "id": "401340336",
            "speakerId": 30437,
            "speakerName": "巴蒂斯特",
            "text": "…哈哈，真想不到这话会从一位特巡队队长嘴里说出来。",
            "nextDialogs": [
              "401340337"
            ]
          },
          "401340337": {
            "id": "401340337",
            "speakerId": 1081,
            "speakerName": "夏沃蕾",
            "text": "我在怀疑你做这一切的动机。",
            "nextDialogs": [
              "401340338"
            ]
          },
          "401340338": {
            "id": "401340338",
            "speakerId": 30437,
            "speakerName": "巴蒂斯特",
            "text": "很简单，我累了。不想再背负这一切了。",
            "nextDialogs": [
              "401340339"
            ]
          },
          "401340339": {
            "id": "401340339",
            "speakerId": 30437,
            "speakerName": "巴蒂斯特",
            "text": "你可能觉得我是不敢开枪的那种人。那么你对了，开枪后所带来的一切才是真正的磨难。",
            "nextDialogs": [
              "401340340"
            ]
          },
          "401340340": {
            "id": "401340340",
            "speakerId": 1081,
            "speakerName": "夏沃蕾",
            "text": "你就这么放弃你的复仇？",
            "nextDialogs": [
              "401340341"
            ]
          },
          "401340341": {
            "id": "401340341",
            "speakerId": 30437,
            "speakerName": "巴蒂斯特",
            "text": "那人有太多的权和钱了，我深知自己一个人已经无法完成复仇。",
            "nextDialogs": [
              "401340342"
            ]
          },
          "401340342": {
            "id": "401340342",
            "speakerId": 1081,
            "speakerName": "夏沃蕾",
            "text": "那又如何？你书里可不是这么写的。",
            "nextDialogs": [
              "401340343"
            ]
          },
          "401340343": {
            "id": "401340343",
            "speakerId": 30437,
            "speakerName": "巴蒂斯特",
            "text": "我以为我俩之间我才是罪犯。你是在教唆我去犯罪吗？警官大人。",
            "nextDialogs": [
              "401340344"
            ]
          },
          "401340344": {
            "id": "401340344",
            "speakerId": 1081,
            "speakerName": "夏沃蕾",
            "text": "那位富人叫什么名字？你怎么证明自己说的这一切是真的？",
            "nextDialogs": [
              "401340345"
            ]
          },
          "401340345": {
            "id": "401340345",
            "speakerId": 30437,
            "speakerName": "巴蒂斯特",
            "text": "…我想和你单独谈谈。",
            "nextDialogs": [
              "401340346"
            ]
          },
          "401340346": {
            "id": "401340346",
            "speakerId": 1081,
            "speakerName": "夏沃蕾",
            "text": "不如去警备队谈谈？",
            "nextDialogs": [
              "401340347"
            ]
          },
          "401340347": {
            "id": "401340347",
            "speakerId": 30437,
            "speakerName": "巴蒂斯特",
            "text": "不，只有这里才不会被其他人听见。",
            "nextDialogs": [
              "401340348"
            ]
          },
          "401340348": {
            "id": "401340348",
            "speakerId": 1081,
            "speakerName": "夏沃蕾",
            "text": "…行，你说吧。",
            "nextDialogs": [
              "401340349"
            ]
          },
          "401340349": {
            "id": "401340349",
            "speakerId": 30437,
            "speakerName": "巴蒂斯特",
            "text": "我指的「其他人」，是除你以外的所有人。",
            "nextDialogs": [
              "401340350"
            ]
          },
          "401340350": {
            "id": "401340350",
            "speakerId": 30437,
            "speakerName": "巴蒂斯特",
            "text": "…我只告诉你一个人。"
          }
        }
      }
    },

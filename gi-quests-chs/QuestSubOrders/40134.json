            ]
          },
          "401349905": {
            "id": "401349905",
            "speakerId": 1003,
            "speakerName": "「爱芮丝」",
            "text": "姐姐，他们人太多了！",
            "nextDialogs": [
              "401349906"
            ]
          },
          "401349906": {
            "id": "401349906",
            "speakerId": 1004,
            "speakerName": "「图利佩」",
            "text": "没事的！爱芮丝，我们掩护彼此。",
            "nextDialogs": [

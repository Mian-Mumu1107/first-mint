    "派蒙": 5,
    "萨维特": 6
  },
  "subQuests": [
    {
      "subId": "7604701",
      "subQuestName": "与秘谜书屋的常客对话",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "760470101"
        ],
        "dialogs": {
          "760470101": {
            "id": "760470101",
            "speakerId": 7042,
            "speakerName": "佩彻娜",
            "text": "呃…两位，我已经在这里观察两位很久了…",
            "nextDialogs": [
              "760470102"
            ]
          },
          "760470102": {
            "id": "760470102",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "你在监视我们？",
            "nextDialogs": [
              "760470103"
            ]
          },
          "760470103": {
            "id": "760470103",
            "speakerId": 7042,
            "speakerName": "佩彻娜",
            "text": "不，我只是经常来找书，偶然间发现两位对参与投资很上心，这不是好事，两位还是放弃吧。",
            "nextDialogs": [
              "760470104"
            ]
          },
          "760470104": {
            "id": "760470104",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "我们的确还没拿到过什么丰厚回报…不过为什么说不是好事呢？",
            "nextDialogs": [
              "760470105"
            ]
          },
          "760470105": {
            "id": "760470105",
            "speakerId": 7042,
            "speakerName": "佩彻娜",
            "text": "因为我猜根本没有丰厚回报。老板还有不少负债没有偿清，应该不会再做赔本买卖了。",
            "nextDialogs": [
              "760470106"
            ]
          },
          "760470106": {
            "id": "760470106",
            "speakerId": 7042,
            "speakerName": "佩彻娜",
            "text": "我的朋友曾经也中过这样的骗局，所以两位还是不要再继续为好。",
            "nextDialogs": [
              "760470107"
            ]
          },
          "760470107": {
            "id": "760470107",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "#难道真的是骗人的…{NICKNAME}，我们得去找他问个清楚才行！"
          }
        }
      }
    },
    {
      "subId": "7604702",
      "subQuestName": "与萨维特对话",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "760470201"
        ],
        "dialogs": {
          "760470201": {
            "id": "760470201",
            "speakerId": 7008,
            "speakerName": "萨维特",
            "text": "哟，这不是老主顾吗，今天也来买投资券吗？",
            "nextDialogs": [
              "760470202"
            ]
          },
          "760470202": {
            "id": "760470202",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "听说你这儿的投资券是骗人的？",
            "nextDialogs": [
              "760470203"
            ]
          },
          "760470203": {
            "id": "760470203",
            "speakerId": 7008,
            "speakerName": "萨维特",
            "text": "瞧你这话说的，该不会是因为这阵子都在亏损，所以才胡思乱想的吧？",
            "nextDialogs": [
              "760470204"
            ]
          },
          "760470204": {
            "id": "760470204",
            "speakerId": 7008,
            "speakerName": "萨维特",
            "text": "这世上哪能有稳赚不赔的买卖呢，有人输就有人赢，想当初我在须弥城…咳，不过是这阵子运气不好，运气这事儿可说不准。",
            "nextDialogs": [
              "760470205"
            ]
          },
          "760470205": {
            "id": "760470205",
            "speakerId": 7008,
            "speakerName": "萨维特",
            "text": "「希望」啊就是得坚持下去才能抓到的。只要继续投资，肯定有获得回报的那一天的！",
            "nextDialogs": [
              "760470207"
            ]
          },
          "760470207": {
            "id": "760470207",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "喂！你怎么这么轻易就被打发了！",
            "nextDialogs": [
              "760470209"
            ]
          },
          "760470209": {
            "id": "760470209",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "#骗我们是不会有好下场的！我们…对了，我们可是大名鼎鼎的{NICKNAME}和派蒙！在那夏镇也有不少朋友的！",
            "nextDialogs": [
              "760470210"
            ]
          },
          "760470210": {
            "id": "760470210",
            "speakerId": 7008,
            "speakerName": "萨维特",
            "text": "「朋友」？什么朋友…难、难道是那种「朋友」？！",
            "nextDialogs": [
              "760470211"
            ]
          },
          "760470211": {
            "id": "760470211",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "…嗯？呃，对！就是那种「朋友」，不仅有，而且还很多呢！",
            "nextDialogs": [
              "760470212"
            ]
          },
          "760470212": {
            "id": "760470212",
            "speakerId": 7008,
            "speakerName": "萨维特",
            "text": "哎呀！你们怎么不早说，惹不起，真的惹不起。这些全都给你们，我不会再卖投资券给你们了，你们快些走吧。"
          }
        }
      }
    },
    {

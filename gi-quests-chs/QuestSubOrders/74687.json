  "subQuests": [
    {
      "subId": "7468701",
      "subQuestName": "与警备队员们对话",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "746870301"
        ],
        "dialogs": {
          "746870301": {
            "id": "746870301",
            "speakerId": 30839,
            "speakerName": "玛因",
            "text": "好呀，顶班的来了…",
            "nextDialogs": [
              "746870302"
            ]
          },
          "746870302": {
            "id": "746870302",
            "speakerId": 30839,
            "speakerName": "玛因",
            "text": "咦？怎么是你们？",
            "nextDialogs": [
              "746870304",
              "746870308"
            ]
          },
          "746870304": {
            "id": "746870304",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "感觉你好像认识我们…",
            "nextDialogs": [
              "746870305"
            ]
          },
          "746870305": {
            "id": "746870305",
            "speakerId": 30839,
            "speakerName": "玛因",
            "text": "没有任何问题，很好很好，你们出了名的强！",
            "nextDialogs": [
              "746870306"
            ]
          },
          "746870306": {
            "id": "746870306",
            "speakerId": 30839,
            "speakerName": "玛因",
            "text": "在单位里的时候，回村里以后，大家都在说，什么事都能放心交给你们。",
            "nextDialogs": [
              "746870311"
            ]
          },
          "746870311": {
            "id": "746870311",
            "speakerId": 30839,
            "speakerName": "玛因",
            "text": "相比之下，那边的两位同事，虽然也都很可靠，但总感觉有点，说不上来的别扭？",
            "nextDialogs": [
              "746870312"
            ]
          },
          "746870312": {
            "id": "746870312",
            "speakerId": 30839,
            "speakerName": "玛因",
            "text": "人类的情感真复杂啊…要不要推他们一把呢？",
            "nextDialogs": [
              "746870313"
            ]
          },
          "746870313": {
            "id": "746870313",
            "speakerId": 1002,
            "speakerName": "主角",
            "text": "别扭？",
            "nextDialogs": [
              "746870314"
            ]
          },
          "746870314": {
            "id": "746870314",
            "speakerId": 30839,
            "speakerName": "玛因",
            "text": "算了，正事要紧。",
            "nextDialogs": [
              "746870315"
            ]
          },
          "746870315": {
            "id": "746870315",
            "speakerId": 30839,
            "speakerName": "玛因",
            "text": "总之加油吧，那部重炮的操纵并不难，期待你们三下五除二，把所有目标都轰得一个不留。"
          },
          "746870308": {
            "id": "746870308",
            "speakerId": 30839,
            "speakerName": "玛因",
            "text": "居然还记得我？之前「海薇玛映影欢乐城」招募员工的时候，我还给你投过简历呢。",
            "nextDialogs": [
              "746870309"
            ]
          },
          "746870309": {
            "id": "746870309",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "好像，确实有这么一回事来着？",
            "nextDialogs": [
              "746870310"
            ]
          },
          "746870310": {
            "id": "746870310",
            "speakerId": 30839,
            "speakerName": "玛因",
            "text": "我知道你们很强，什么事都能放心交给你们。"
          }
        }
      }
    },
    {
      "subId": "7468701",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "746870101"
        ],
        "dialogs": {
          "746870101": {
            "id": "746870101",
            "speakerId": 30534,
            "speakerName": "谢妮",
            "text": "前辈，事态已经持续半天了，魔物还是没有减少的迹象…",
            "nextDialogs": [
              "746870102"
            ]
          },
          "746870102": {
            "id": "746870102",
            "speakerId": 30534,
            "speakerName": "谢妮",
            "text": "要不然，我还是去呼叫增援吧？",
            "nextDialogs": [
              "746870103"
            ]
          },
          "746870103": {
            "id": "746870103",
            "speakerId": 30509,
            "speakerName": "弗雷瑞斯",
            "text": "不用慌张，相信我的重炮和那位便衣同事！",
            "nextDialogs": [
              "746870104"
            ]
          },
          "746870104": {
            "id": "746870104",
            "speakerId": 30509,
            "speakerName": "弗雷瑞斯",
            "text": "此外，对危机有着敏锐嗅觉的冒险家，甚至是某位长官…应该也会在第一时间赶来吧。",
            "nextDialogs": [
              "746870107"
            ]
          },
          "746870107": {
            "id": "746870107",
            "speakerId": 30534,
            "speakerName": "谢妮",
            "text": "出现了…准领队居然真的带着小助手来了！",
            "nextDialogs": [
              "746870108"
            ]
          },
          "746870108": {
            "id": "746870108",
            "speakerId": 30509,
            "speakerName": "弗雷瑞斯",
            "text": "两位好，请让我简单说明事态…",
            "nextDialogs": [
              "746870109"
            ]
          },
          "746870109": {
            "id": "746870109",
            "speakerId": 30534,
            "speakerName": "谢妮",
            "text": "嘿嘿，前辈先休息一会儿吧，说明工作交给我就好。",
            "nextDialogs": [
              "746870110"
            ]
          },
          "746870110": {
            "id": "746870110",
            "speakerId": 30534,
            "speakerName": "谢妮",
            "text": "咳！想操纵重炮狂轰一番吗？海军舰队全灭后，这种机会可不多了，说是梦回几百年前也不为过！",
            "nextDialogs": [
              "746870111"
            ]
          },
          "746870111": {
            "id": "746870111",
            "speakerId": 30534,
            "speakerName": "谢妮",
            "text": "用特制的弹头成片成片击倒魔物，怎么想都很解压吧，还能拿到警备队的奖金呢！",
            "nextDialogs": [
              "746870112"
            ]
          },
          "746870112": {
            "id": "746870112",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "用大炮轰魔物…这个我们的确在行！"
          }
        }
      }
    }
  ]
}
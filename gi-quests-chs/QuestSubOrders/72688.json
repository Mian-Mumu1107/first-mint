  },
  "subQuests": [
    {
      "subId": "7268801",
      "subQuestName": "等待至翌日上午（次日早8点-12点），与柴染对话",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "726880101"
        ],
        "dialogs": {
          "726880101": {
            "id": "726880101",
            "speakerId": 30171,
            "speakerName": "柴染",
            "text": "又见面了，两位。",
            "nextDialogs": [
              "726880102"
            ]
          },
          "726880102": {
            "id": "726880102",
            "speakerId": 30171,
            "speakerName": "柴染",
            "text": "上次的「花影瑶庭」令人欣喜，看来你们天赋异禀，很快就能领会花艺的精髓。",
            "nextDialogs": [
              "726880103"
            ]
          },
          "726880103": {
            "id": "726880103",
            "speakerId": 30171,
            "speakerName": "柴染",
            "text": "新的「花题」正等待两位作答。",
            "nextDialogs": [
              "726880105",
              "726880111"
            ]
          },
          "726880105": {
            "id": "726880105",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "嗯嗯！我们准备好了哦！",
            "nextDialogs": [
              "726880106"
            ]
          },
          "726880106": {
            "id": "726880106",
            "speakerId": 30171,
            "speakerName": "柴染",
            "text": "两位的眼中有着瑰丽的光彩，像是映照着绚烂的花海，令人惊叹…",
            "nextDialogs": [
              "726880107"
            ]
          },
          "726880107": {
            "id": "726880107",
            "speakerId": 30171,
            "speakerName": "柴染",
            "text": "那么，今日的「花题」稍稍提升了难度，有助于你们深究构图的技巧——",
            "nextDialogs": [
              "726880108"
            ]
          },
          "726880108": {
            "id": "726880108",
            "speakerId": 30171,
            "speakerName": "柴染",
            "text": "「锦绣槃固，池中溪客」。",
            "nextDialogs": [
              "726880109"
            ]
          },
          "726880109": {
            "id": "726880109",
            "speakerId": 30171,
            "speakerName": "柴染",
            "text": "请领会题中的含义，谨慎挑选花材，悉心构筑你们的「花庭」吧。"
          },
          "726880111": {
            "id": "726880111",
            "speakerId": 30171,
            "speakerName": "柴染",
            "text": "没关系。「插花」需要安神定气。",
            "nextDialogs": [
              "726880112"
            ]
          },
          "726880112": {
            "id": "726880112",
            "speakerId": 30171,
            "speakerName": "柴染",
            "text": "等到二位忙完手头的事，摆脱了喧扰。必定能将题中的「花庭」构筑得更加完满。"
          }
        }
      }
    },
    {
      "subId": "7268802",

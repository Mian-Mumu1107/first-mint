    {
      "subId": "7268804",
      "subQuestName": "与柴染对话",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [],
        "dialogs": {}
      }
    },
    {
      "subId": "7268702",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "726870201"
        ],
        "dialogs": {
          "726870201": {
            "id": "726870201",
            "speakerId": 30171,
            "speakerName": "柴染",
            "text": "接下来的几天，我会一直守候在这里，引导容彩祭的客人们，让他们感受「花影瑶庭」的精妙之处。",
            "nextDialogs": [
              "726870202"
            ]
          },
          "726870202": {
            "id": "726870202",
            "speakerId": 30171,
            "speakerName": "柴染",
            "text": "两位也别忘了每天揭晓一道的「花题」哦，一共有四道「花题」等着你们作答呢。",
            "nextDialogs": [
              "726870203"
            ]
          },
          "726870203": {
            "id": "726870203",
            "speakerId": 30171,
            "speakerName": "柴染",
            "text": "当然，要是两位还有其他问题，我也会尽力为你们解答的。",
            "nextDialogs": [
              "726870205",
              "726870211",
              "726870223"
            ]
          },
          "726870205": {
            "id": "726870205",
            "speakerId": 30171,
            "speakerName": "柴染",
            "text": "我所使用的花材，都是由「咲耶花屋」提供的。「咲耶花屋」栽培的花卉有着难以挑剔的品质和亲民的价格。",
            "nextDialogs": [
              "726870206"
            ]
          },
          "726870206": {
            "id": "726870206",
            "speakerId": 30171,
            "speakerName": "柴染",
            "text": "也许你们已经见过咲耶了，我们曾在同一位老师门下学习「插花」的技巧。",
            "nextDialogs": [
              "726870207"
            ]
          },
          "726870207": {
            "id": "726870207",
            "speakerId": 30171,
            "speakerName": "柴染",
            "text": "咲耶对于花艺的理解也可圈可点，但是听说容彩祭的客人络绎不绝时，她似乎有些怯场，认为在这种环境里难以静下心来插花。",
            "nextDialogs": [
              "726870208"
            ]
          },
          "726870208": {
            "id": "726870208",
            "speakerId": 30171,
            "speakerName": "柴染",
            "text": "所以，我也会向其他客人宣传她的「咲耶花屋」。",
            "nextDialogs": [
              "726870209"
            ]
          },
          "726870209": {
            "id": "726870209",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "有机会的话，我们也可以帮忙哦！",
            "nextDialogs": [
              "726870219"
            ]
          },
          "726870219": {
            "id": "726870219",
            "speakerId": 30171,
            "speakerName": "柴染",
            "text": "那么，还有什么问题吗，两位？",
            "nextDialogs": [
              "726870220"
            ]
          },
          "726870220": {
            "id": "726870220",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "谢谢你，柴染小姐。",
            "nextDialogs": [
              "726870221"
            ]
          },
          "726870221": {
            "id": "726870221",
            "speakerId": 30171,
            "speakerName": "柴染",
            "text": "不用客气。如果你们有空，随时都可以来找我哦。"
          },
          "726870211": {
            "id": "726870211",
            "speakerId": 30171,
            "speakerName": "柴染",
            "text": "社奉行一直支持着稻妻的花艺事业。准确来说，为这次活动出资的贵人，是那位白鹭公主。",
            "nextDialogs": [
              "726870212"
            ]
          },
          "726870212": {
            "id": "726870212",
            "speakerId": 30171,
            "speakerName": "柴染",
            "text": "白鹭公主自小就表现出惊人的花艺天赋。我曾看过她的「插花」表演，有幸与她交流过心得。",
            "nextDialogs": [
              "726870213"
            ]
          },
          "726870213": {
            "id": "726870213",
            "speakerId": 30171,
            "speakerName": "柴染",
            "text": "虽说我比她年长，但论插花的技巧和对花艺的理解，完全没法与她相提并论呢。",
            "nextDialogs": [
              "726870214"
            ]
          },
          "726870214": {
            "id": "726870214",
            "speakerId": 30171,
            "speakerName": "柴染",
            "text": "在条件允许的情况下，白鹭公主每年都会提供资金，推广「插花」这门艺术。听说有时她还会用掉自己的积蓄…",
            "nextDialogs": [
              "726870215"
            ]
          },
          "726870215": {
            "id": "726870215",
            "speakerId": 30171,
            "speakerName": "柴染",
            "text": "白鹭公主曾坦率表达过自己的愿望——她想让更多人了解「插花」，对花艺产生兴趣，进而沉下心来修习这门学问。",
            "nextDialogs": [
              "726870216"
            ]
          },
          "726870216": {
            "id": "726870216",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "原来绫华为稻妻的花艺付出过这么多啊…",
            "nextDialogs": [
              "726870217"
            ]
          },
          "726870217": {
            "id": "726870217",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "希望她的愿望能实现。",
            "nextDialogs": [
              "726870218"
            ]
          },
          "726870218": {
            "id": "726870218",
            "speakerId": 30171,
            "speakerName": "柴染",
            "text": "感谢两位，你们真是善解人意。"
          },
          "726870223": {
            "id": "726870223",
            "speakerId": 30171,
            "speakerName": "柴染",
            "text": "如果你们有空，随时都可以来找我哦。"
          }
        }
      }
    }
  ]
}
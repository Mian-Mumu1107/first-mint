  },
  "subQuests": [
    {
      "subId": "7608201",
      "subQuestName": "(test)隐藏$HIDDEN",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "760820101"
        ],
        "dialogs": {
          "760820101": {
            "id": "760820101",
            "speakerId": 21903,
            "speakerName": "梅蒂",
            "text": "#怎么了，{M#大哥}{F#大姐}？还有什么想问的事吗？"
          }
        }
      }
    },
    {
      "subId": "7608202",
      "subQuestName": "(test)隐藏$HIDDEN",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "760141701"
        ],
        "dialogs": {
          "760141701": {
            "id": "760141701",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "呜哇！这家伙是不是好像比之前更大了？",
            "nextDialogs": [
              "760141702"
            ]
          },
          "760141702": {
            "id": "760141702",
            "speakerId": 21903,
            "speakerName": "梅蒂",
            "text": "哼哼，那是当然的。吃了我辛辛苦苦找回来的这么多白灵果，现在的沙皇老爷已经是比派蒙还要圆润的沙皇老爷了。",
            "nextDialogs": [
              "760141703"
            ]
          },
          "760141703": {
            "id": "760141703",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "喂！不要拿我做这种奇怪的比较啦！",
            "nextDialogs": [
              "760141704"
            ]
          },
          "760141704": {
            "id": "760141704",
            "speakerId": 21903,
            "speakerName": "梅蒂",
            "text": "#呜哦！怎么了？看到{NICKNAME}{M#大哥}{F#大姐}，好像突然变得很有精神…或者说兴奋起来了？",
            "nextDialogs": [
              "760141705"
            ]
          },
          "760141705": {
            "id": "760141705",
            "speakerId": 21903,
            "speakerName": "梅蒂",
            "text": "#好像是打算和{NICKNAME}{M#大哥}{F#大姐}比试比试…哈，是因为之前被打得毫无还手之力，所以不服气吗？",
            "nextDialogs": [
              "760141707",
              "760141709"
            ]
          },
          "760141707": {
            "id": "760141707",
            "speakerId": 21903,
            "speakerName": "梅蒂",
            "text": "#小心点哪，{M#大哥}{F#大姐}。这家伙现在可比上次更强了喔。"
          },
          "760141709": {
            "id": "760141709",
            "speakerId": 21903,
            "speakerName": "梅蒂",
            "text": "#也没必要任着它的性子来啦，等{M#大哥}{F#大姐}有兴趣了再回应它的挑战也没关系。",
            "nextDialogs": [
              "760141710"
            ]
          },
          "760141710": {
            "id": "760141710",
            "speakerId": 21903,
            "speakerName": "梅蒂",
            "text": "这家伙现在也算是我罩着的了，我说话它还是会听的。",
            "nextDialogs": [
              "760141711"
            ]
          },
          "760141711": {
            "id": "760141711",
            "speakerId": 21903,
            "speakerName": "梅蒂",
            "text": "来，乖，坐下。",
            "nextDialogs": [
              "760141712"
            ]
          },
          "760141712": {
            "id": "760141712",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "它是你养的狗吗！不对，螃蟹不一直是坐着的吗！"
          }
        }
      }
    },
    {
      "subId": "7608203",
      "subQuestName": "(test)隐藏$HIDDEN",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "760820301"
        ],
        "dialogs": {
          "760820301": {
            "id": "760820301",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "关于海螺帮…",
            "nextDialogs": [
              "760820302"
            ]
          },
          "760820302": {
            "id": "760820302",
            "speakerId": 21903,
            "speakerName": "梅蒂",
            "text": "#嗯？{M#大哥}{F#大姐}想知道海螺帮的事呀。没问题，既然{M#大哥}{F#大姐}已经是海螺帮的朋友了，想问什么都行。",
            "nextDialogs": [
              "760820303"
            ]
          },
          "760820303": {
            "id": "760820303",
            "speakerId": 21903,
            "speakerName": "梅蒂",
            "text": "#我们算是…嗯，同路的同龄人之间的「互助协调组织」吧。虽说{M#大哥}{F#大姐}的年龄应该没办法加入我们了…",
            "nextDialogs": [
              "760820304"
            ]
          },
          "760820304": {
            "id": "760820304",
            "speakerId": 21903,
            "speakerName": "梅蒂",
            "text": "但要是在那夏镇有什么需要「互帮互助」的事，只要是我能帮上忙的，就告诉我好了！"
          }
        }
      }
    },
    {
      "subId": "7608204",
      "subQuestName": "(test)废弃",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [],
        "dialogs": {}
      }
    },
    {
      "subId": "7608205",
      "subQuestName": "(test)废弃$HIDDEN",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "760820501"
        ],
        "dialogs": {
          "760820501": {
            "id": "760820501",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "她大概要隐退一段时间了…",
            "nextDialogs": [
              "760820502"
            ]
          },
          "760820502": {
            "id": "760820502",
            "speakerId": 21903,
            "speakerName": "梅蒂",
            "text": "#嗯？原来{M#大哥}{F#大姐}已经见过希丁芭大姐了吗？隐退的事情我可没听她说过…算了，之后再打听吧。"
          }
        }
      }
    },
    {
      "subId": "7608206",
      "subQuestName": "(test)废弃$HIDDEN",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "760820601"
        ],
        "dialogs": {
          "760820601": {
            "id": "760820601",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "听着感觉心里没底…",
            "nextDialogs": [
              "760820602"
            ]
          },
          "760820602": {
            "id": "760820602",
            "speakerId": 21903,
            "speakerName": "梅蒂",
            "text": "别担心，她超靠谱的。我梅蒂都这么保证了，不用觉得没底啦。"
          }
        }
      }
    },
    {
      "subId": "7601401",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "760140103"
        ],
        "dialogs": {
          "760140103": {
            "id": "760140103",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "稍微有点担心那个叫梅蒂的小丫头，我们有时间的话回去看看吧？"
          }
        }
      }
    },
    {
      "subId": "7601414",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "760141401"
        ],
        "dialogs": {
          "760141401": {
            "id": "760141401",
            "speakerId": 21903,
            "speakerName": "梅蒂",
            "text": "#怎么了，{M#大哥}{F#大姐}？还有什么想问的事吗？",
            "nextDialogs": [
              "760141403",
              "760141407",
              "760141410",
              "760141414",
              "760141427"
            ]
          },
          "760141403": {
            "id": "760141403",
            "speakerId": 21903,
            "speakerName": "梅蒂",
            "text": "唉，那家伙虽然看上去很吓人，其实性子一直都挺温和的。没了那块奇怪的石头，之后应该也会恢复正常吧。",
            "nextDialogs": [
              "760141404"
            ]
          },
          "760141404": {
            "id": "760141404",
            "speakerId": 21903,
            "speakerName": "梅蒂",
            "text": "至于现在嘛，就让它躲起来老老实实反省吧。不管受到什么影响，做过的坏事依然是做过的坏事，被它伤到的小螃蟹依然受了伤。",
            "nextDialogs": [
              "760141405"
            ]
          },
          "760141405": {
            "id": "760141405",
            "speakerId": 21903,
            "speakerName": "梅蒂",
            "text": "就和大盗雷德·米勒当初对付的、被镜子迷惑的坏总督一样，找再多借口也没意义，悔罪总归是得有实际行动的呀。"
          },
          "760141407": {
            "id": "760141407",
            "speakerId": 21903,
            "speakerName": "梅蒂",
            "text": "哼哼，那就是能操纵人心的{RUBY#[D]图瓦道茨基之石}欲之石…嗯，我记得希丁芭大姐说的应该是这个名字吧？",
            "nextDialogs": [
              "760141408"
            ]
          },
          "760141408": {
            "id": "760141408",
            "speakerId": 21903,
            "speakerName": "梅蒂",
            "text": "咳，总、总之，看来和霜月那边的大石头一样，是从天上掉下来的玩意儿。既然飞走了，应该也不会对我们构成什么威胁了吧。"
          },
          "760141410": {
            "id": "760141410",
            "speakerId": 21903,
            "speakerName": "梅蒂",
            "text": "#嗯？{M#大哥}{F#大姐}想知道海螺帮的事呀。没问题，既然{M#大哥}{F#大姐}已经是海螺帮的朋友了，想问什么都行。",
            "nextDialogs": [
              "760141411"
            ]
          },
          "760141411": {
            "id": "760141411",
            "speakerId": 21903,
            "speakerName": "梅蒂",
            "text": "#我们算是…嗯，同路的同龄人之间的「互助协调组织」吧。虽说{M#大哥}{F#大姐}的年龄应该没办法加入我们了…",
            "nextDialogs": [
              "760141412"
            ]
          },
          "760141412": {
            "id": "760141412",
            "speakerId": 21903,
            "speakerName": "梅蒂",
            "text": "但要是在那夏镇有什么需要「互帮互助」的事，只要是我能帮上忙的，就告诉我好了！"
          },
          "760141414": {
            "id": "760141414",
            "speakerId": 21903,
            "speakerName": "梅蒂",
            "text": "哦，你说那个紫色祭司啊。既然那家伙暂时没对咱们出手，就说明至少她现在不是我们的敌人，她的事咱们尽量也少管。",
            "nextDialogs": [
              "760141415"
            ]
          },
          "760141415": {
            "id": "760141415",
            "speakerId": 21903,
            "speakerName": "梅蒂",
            "text": "好奇心是会要了命的。卡嘉大姐也说，尽量别和霜月那群怪人接触。就连我这种大盗，之前也差点被他们抓住、献祭给月神了。",
            "nextDialogs": [
              "760141416"
            ]
          },
          "760141416": {
            "id": "760141416",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "献祭？！",
            "nextDialogs": [
              "760141417"
            ]
          },
          "760141417": {
            "id": "760141417",
            "speakerId": 21903,
            "speakerName": "梅蒂",
            "text": "是啊，那群家伙邪乎得很，据说还会把不同人的血…唔，想想就觉得可怕，还是不说了吧。",
            "nextDialogs": [
              "760141418"
            ]
          },
          "760141418": {
            "id": "760141418",
            "speakerId": 21903,
            "speakerName": "梅蒂",
            "text": "幸亏当时抓住我的是个什么都不懂的小丫头，稍微给她讲几个故事，她就愿意放过我了。要不然啊…",
            "nextDialogs": [
              "760141419"
            ]
          },
          "760141419": {
            "id": "760141419",
            "speakerId": 21903,
            "speakerName": "梅蒂",
            "text": "#我、我倒是也没在怕啦，大盗当然是不会害怕的！只是劝{M#大哥}{F#大姐}一句，尽量少掺和他们的事。",
            "nextDialogs": [
              "760141420"
            ]
          },
          "760141420": {
            "id": "760141420",
            "speakerId": 21903,
            "speakerName": "梅蒂",
            "text": "啊，对了，差点忘了，之前说好的情报源。关于霜月之子的事，都是希丁芭大姐告诉我的。",
            "nextDialogs": [
              "760141421"
            ]
          },
          "760141421": {
            "id": "760141421",
            "speakerId": 21903,
            "speakerName": "梅蒂",
            "text": "要是想找她的话…嗯，她应该还在那夏镇附近吧？稍微打听一下，应该很快就能找到了。"
          },
          "760141427": {
            "id": "760141427",
            "speakerId": 21903,
            "speakerName": "梅蒂",
            "text": "好，一路顺风啊，伙计。"
          }
        }
      }
    },

  "subQuests": [
    {
      "subId": "2006501",
      "subQuestName": "与艾琳对话",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "200650101"
        ],
        "dialogs": {
          "200650101": {
            "id": "200650101",
            "speakerId": 1605,
            "speakerName": "艾琳",
            "text": "伤脑筋…这里要怎么解决啊…",
            "nextDialogs": [
              "200650102"
            ]
          },
          "200650102": {
            "id": "200650102",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "你在做什么呢？",
            "nextDialogs": [
              "200650103"
            ]
          },
          "200650103": {
            "id": "200650103",
            "speakerId": 1605,
            "speakerName": "艾琳",
            "text": "为了下一次的骑士选拔，我正在训练呢。",
            "nextDialogs": [
              "200650104"
            ]
          },
          "200650104": {
            "id": "200650104",
            "speakerId": 1605,
            "speakerName": "艾琳",
            "text": "唔…不过，我可没有琴大人那样的力量。",
            "nextDialogs": [
              "200650105"
            ]
          },
          "200650105": {
            "id": "200650105",
            "speakerId": 1605,
            "speakerName": "艾琳",
            "text": "比起锻炼「力量」，我觉得学习「技巧」更适合我。",
            "nextDialogs": [
              "200650106"
            ]
          },
          "200650106": {
            "id": "200650106",
            "speakerId": 1605,
            "speakerName": "艾琳",
            "text": "比如，一口气把这些木桩全部破坏掉的方法…",
            "nextDialogs": [
              "200650107"
            ]
          },
          "200650107": {
            "id": "200650107",
            "speakerId": 1605,
            "speakerName": "艾琳",
            "text": "这些木桩可是很结实的，可不能掉以轻心…真是辛苦老爸了，也不知道他是从哪找到的。"
          }
        }
      }
    },
    {
      "subId": "2006502",
      "subQuestName": "在2秒内摧毁所有木桩",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "200650201"
        ],
        "dialogs": {
          "200650201": {
            "id": "200650201",
            "speakerId": 1605,
            "speakerName": "艾琳",
            "text": "怎么样？想到好方法了吗？",
            "nextDialogs": [
              "200650202"
            ]
          },
          "200650202": {
            "id": "200650202",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "还没有想好…",
            "nextDialogs": [
              "200650203"
            ]
          },
          "200650203": {
            "id": "200650203",
            "speakerId": 1605,
            "speakerName": "艾琳",
            "text": "嗯…我之前遇见的冒险家，有些也偶尔会这样呢。",
            "nextDialogs": [
              "200650204"
            ]
          },
          "200650204": {
            "id": "200650204",
            "speakerId": 1605,
            "speakerName": "艾琳",
            "text": "面对怪物时能利落地战斗，打木桩的时候却手忙脚乱。",
            "nextDialogs": [
              "200650205"
            ]
          },
          "200650205": {
            "id": "200650205",
            "speakerId": 1605,
            "speakerName": "艾琳",
            "text": "而且还用各种手段加固木桩，就像生怕自己能轻松击碎一样…",
            "nextDialogs": [
              "200650206"
            ]
          },
          "200650206": {
            "id": "200650206",
            "speakerId": 1605,
            "speakerName": "艾琳",
            "text": "这么想寻求挑战的话，直接去野外找强大的魔物不就好了吗？"
          }
        }
      }
    },
    {
      "subId": "2006503",
      "subQuestName": "与艾琳对话",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "200650301"
        ],
        "dialogs": {
          "200650301": {
            "id": "200650301",
            "speakerId": 1605,
            "speakerName": "艾琳",
            "text": "做到了！",
            "nextDialogs": [
              "200650302"
            ]
          },
          "200650302": {
            "id": "200650302",
            "speakerId": 1605,
            "speakerName": "艾琳",
            "text": "原来还能这么解决…这种方法我想都没想过。",
            "nextDialogs": [
              "200650303"
            ]
          },
          "200650303": {
            "id": "200650303",
            "speakerId": 1605,
            "speakerName": "艾琳",
            "text": "谢谢你，我自己去再试试看！"
          }
        }
      }
    }
  ]
}
  "subQuests": [
    {
      "subId": "7116001",
      "subQuestName": "霄灯-莱依拉$HIDDEN",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "711600301"
        ],
        "dialogs": {
          "711600301": {
            "id": "711600301",
            "speakerId": 1063,
            "speakerName": "莱依拉",
            "text": "这样编霄灯，然后放飞出去，真的能愿望成真吗…",
            "nextDialogs": [
              "711600302"
            ]
          },
          "711600302": {
            "id": "711600302",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "莱依拉？",
            "nextDialogs": [
              "711600303"
            ]
          },
          "711600303": {
            "id": "711600303",
            "speakerId": 1063,
            "speakerName": "莱依拉",
            "text": "#欸？{NICKNAME}，你也在璃月啊，海灯节快乐…",
            "nextDialogs": [
              "711600317"
            ]
          },
          "711600317": {
            "id": "711600317",
            "speakerId": 1063,
            "speakerName": "莱依拉",
            "text": "呜哇…你放飞的霄灯飞得好高。但话说回来，霄灯究竟能飞多高呢…",
            "nextDialogs": [
              "711600318"
            ]
          },
          "711600318": {
            "id": "711600318",
            "speakerId": 1063,
            "speakerName": "莱依拉",
            "text": "对了，只要套用那道公式应该就能算出来，草稿纸…草稿纸…",
            "nextDialogs": [
              "711600304"
            ]
          },
          "711600304": {
            "id": "711600304",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "莱依拉是来璃月玩的？",
            "nextDialogs": [
              "711600306"
            ]
          },
          "711600306": {
            "id": "711600306",
            "speakerId": 1063,
            "speakerName": "莱依拉",
            "text": "嗯，是导师让我过来的，说多参与民俗活动，也许可以找到一些学术研究上的灵感。",
            "nextDialogs": [
              "711600307"
            ]
          },
          "711600307": {
            "id": "711600307",
            "speakerId": 1063,
            "speakerName": "莱依拉",
            "text": "不过，我做的不是星图么？和民俗活动应该没什么关系吧…",
            "nextDialogs": [
              "711600308"
            ]
          },
          "711600308": {
            "id": "711600308",
            "speakerId": 1063,
            "speakerName": "莱依拉",
            "text": "但我还没来得及说，导师就给我买好了票，还亲自把我送到了船上…",
            "nextDialogs": [
              "711600309"
            ]
          },
          "711600309": {
            "id": "711600309",
            "speakerId": 1063,
            "speakerName": "莱依拉",
            "text": "我刚下船，就被一个大姐姐叫住了，说可以免费送我一架霄灯骨架，还说放霄灯可以带来一整年的好运。",
            "nextDialogs": [
              "711600310"
            ]
          },
          "711600310": {
            "id": "711600310",
            "speakerId": 1063,
            "speakerName": "莱依拉",
            "text": "唉，我也不用一整年都交好运，只需要在提交论文的那段时间里有点好运气就行…",
            "nextDialogs": [
              "711600311"
            ]
          },
          "711600311": {
            "id": "711600311",
            "speakerId": 1063,
            "speakerName": "莱依拉",
            "text": "所以，我就按照那个姐姐教的方法，自己做了一盏霄灯…",
            "nextDialogs": [
              "711600313"
            ]
          },
          "711600313": {
            "id": "711600313",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "莱依拉一定会有好运气的！",
            "nextDialogs": [
              "711600314"
            ]
          },
          "711600314": {
            "id": "711600314",
            "speakerId": 1063,
            "speakerName": "莱依拉",
            "text": "谢谢你。接下来我是不是该去放飞霄灯了？对了，还要写上心愿…",
            "nextDialogs": [
              "711600315"
            ]
          },
          "711600315": {
            "id": "711600315",
            "speakerId": 1001,
            "speakerName": "Black Screen",
            "text": "与莱依拉一同放飞了霄灯…"
          }
        }
      }
    },

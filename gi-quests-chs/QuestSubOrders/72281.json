    {
      "subId": "7228115",
      "subQuestName": "去码头送别心海和五郎",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [],
        "dialogs": {}
      }
    },
    {
      "subId": "7228116",
      "subQuestName": "去码头送别心海和五郎",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "722811601"
        ],
        "dialogs": {
          "722811601": {
            "id": "722811601",
            "speakerId": 1000,
            "speakerName": "珊瑚宫心海",
            "text": "#{NICKNAME}，派蒙，谢谢你们过来送我们。",
            "nextDialogs": [
              "722811602"
            ]
          },
          "722811602": {
            "id": "722811602",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "这次离岛之旅感觉如何？",
            "nextDialogs": [
              "722811603"
            ]
          },
          "722811603": {
            "id": "722811603",
            "speakerId": 1000,
            "speakerName": "珊瑚宫心海",
            "text": "很有价值。「小说鉴赏会」很成功，也让我对未来的正式会谈充满了希望。",
            "nextDialogs": [
              "722811604"
            ]
          },
          "722811604": {
            "id": "722811604",
            "speakerId": 1000,
            "speakerName": "珊瑚宫心海",
            "text": "而且，五郎也立了大功，一下子就为海祇岛争取到了这么多有用的书籍。",
            "nextDialogs": [
              "722811605"
            ]
          },
          "722811605": {
            "id": "722811605",
            "speakerId": 1002,
            "speakerName": "五郎",
            "text": "虽说是我抽到了大奖，但这些书归根结底是八重神子送的。我觉得将来有机会的话，还是应该好好谢谢她才行。",
            "nextDialogs": [
              "722811606"
            ]
          },
          "722811606": {
            "id": "722811606",
            "speakerId": 1000,
            "speakerName": "珊瑚宫心海",
            "text": "对了，昨天八重神子好像给了你一封信？她说了什么吗？",
            "nextDialogs": [
              "722811607"
            ]
          },
          "722811607": {
            "id": "722811607",
            "speakerId": 1002,
            "speakerName": "五郎",
            "text": "啊，我差点忘了这件事！让我拿出来看看…",
            "nextDialogs": [
              "722811608"
            ]
          },
          "722811608": {
            "id": "722811608",
            "speakerId": 1003,
            "speakerName": "八重神子",
            "text": "五郎，我猜你刚刚听说有颁奖和合影的时候，心里一定非常不安吧。",
            "nextDialogs": [
              "722811609"
            ]
          },
          "722811609": {
            "id": "722811609",
            "speakerId": 1003,
            "speakerName": "八重神子",
            "text": "没想到你不仅接受了那些条件，并且还对我提出了要求，你的这份勇气赢得了我的尊重。",
            "nextDialogs": [
              "722811610"
            ]
          },
          "722811610": {
            "id": "722811610",
            "speakerId": 1003,
            "speakerName": "八重神子",
            "text": "那些书籍是我送给海祇岛的一点心意，也是给你的礼物，希望你能喜欢。",
            "nextDialogs": [
              "722811611"
            ]
          },
          "722811611": {
            "id": "722811611",
            "speakerId": 1003,
            "speakerName": "八重神子",
            "text": "对了，读到这里的你，一定非常感谢我的善解人意，想要找个机会报答我对吧，你的机会来了哦。",
            "nextDialogs": [
              "722811612"
            ]
          },
          "722811612": {
            "id": "722811612",
            "speakerId": 1003,
            "speakerName": "八重神子",
            "text": "下个月八重堂会举办一场活动，我们会找人装扮成轻小说中的角色，与书迷们亲切互动。",
            "nextDialogs": [
              "722811613"
            ]
          },
          "722811613": {
            "id": "722811613",
            "speakerId": 1003,
            "speakerName": "八重神子",
            "text": "五郎你不仅有耐心，长得也很清秀，不如就过来帮忙吧，我会专门为你量身打造一套造型。",
            "nextDialogs": [
              "722811614"
            ]
          },
          "722811614": {
            "id": "722811614",
            "speakerId": 1003,
            "speakerName": "八重神子",
            "text": "顺便说一句，是女装哦。",
            "nextDialogs": [
              "722811615"
            ]
          },
          "722811615": {
            "id": "722811615",
            "speakerId": 1002,
            "speakerName": "五郎",
            "text": "啊啊啊啊啊——那个可恶的女人！"
          }
        }
      }
    },
    {
      "subId": "7228199",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "722819904"
        ],
        "dialogs": {
          "722819904": {
            "id": "722819904",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "心海和五郎待会儿就要乘船离开了，我们去码头跟他们告个别吧。"
          }
        }
      }
    }
  ]
}
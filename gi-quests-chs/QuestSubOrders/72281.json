    {
      "subId": "7228102",
      "subQuestName": "前往码头",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "722810201"
        ],
        "dialogs": {
          "722810201": {
            "id": "722810201",
            "speakerId": 1000,
            "speakerName": "珊瑚宫心海",
            "text": "#{NICKNAME}，派蒙，好久不见了。",
            "nextDialogs": [
              "722810202"
            ]
          },
          "722810202": {
            "id": "722810202",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "哇，是心海和五郎，没想到海祇岛的现人神巫女和大将，也来参加容彩祭了。",
            "nextDialogs": [
              "722810203"
            ]
          },
          "722810203": {
            "id": "722810203",
            "speakerId": 1000,
            "speakerName": "珊瑚宫心海",
            "text": "对，不过我们并不是以海祇岛管理者的身份，而是以个人身份受到了邀请。",
            "nextDialogs": [
              "722810204"
            ]
          },
          "722810204": {
            "id": "722810204",
            "speakerId": 1000,
            "speakerName": "珊瑚宫心海",
            "text": "最近难得海祇岛事务不多，我又想买些书，于是就决定来一趟。",
            "nextDialogs": [
              "722810205"
            ]
          },
          "722810205": {
            "id": "722810205",
            "speakerId": 1000,
            "speakerName": "珊瑚宫心海",
            "text": "五郎其实对容彩祭兴趣不大，但听说我要来离岛，就也跟着一起来了。",
            "nextDialogs": [
              "722810206"
            ]
          },
          "722810206": {
            "id": "722810206",
            "speakerId": 1002,
            "speakerName": "五郎",
            "text": "毕竟珊瑚宫大人要离开海祇岛，而且今天还要去见「笔友」，我身为大将，当然要确保大人的安全。",
            "nextDialogs": [
              "722810207"
            ]
          },
          "722810207": {
            "id": "722810207",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "「笔友」？",
            "nextDialogs": [
              "722810208"
            ]
          },
          "722810208": {
            "id": "722810208",
            "speakerId": 1000,
            "speakerName": "珊瑚宫心海",
            "text": "对，我们是最近才认识，然后开始联络的。",
            "nextDialogs": [
              "722810209"
            ]
          },
          "722810209": {
            "id": "722810209",
            "speakerId": 1000,
            "speakerName": "珊瑚宫心海",
            "text": "我和笔友对轻小说的口味很接近，经常能聊到不少有趣的想法。当然了，我们也有针锋相对、互不相让的时候。",
            "nextDialogs": [
              "722810210"
            ]
          },
          "722810210": {
            "id": "722810210",
            "speakerId": 1000,
            "speakerName": "珊瑚宫心海",
            "text": "因为我们这次都会来容彩祭，所以决定趁机开一场「小说鉴赏会」，聊聊彼此对小说的看法。",
            "nextDialogs": [
              "722810211"
            ]
          },
          "722810211": {
            "id": "722810211",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "听起来好专业的样子！对了，你们两个既然都喜欢小说，要不要试着一起创作？说不定还能改变当今稻妻的文坛局势呢。",
            "nextDialogs": [
              "722810212"
            ]
          },
          "722810212": {
            "id": "722810212",
            "speakerId": 1000,
            "speakerName": "珊瑚宫心海",
            "text": "呵呵，这倒是个很有趣的想法。",
            "nextDialogs": [
              "722810213"
            ]
          },
          "722810213": {
            "id": "722810213",
            "speakerId": 1000,
            "speakerName": "珊瑚宫心海",
            "text": "#快到见面的时间了，{NICKNAME}，我和五郎要准备去约定地点和对方会合了。",
            "nextDialogs": [
              "722810214"
            ]
          },
          "722810214": {
            "id": "722810214",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "心海，其实我有点好奇你的笔友，我能不能也跟过去看看？你放心，我就远远看一下，不会打扰你们聚会的。",
            "nextDialogs": [
              "722810215"
            ]
          },
          "722810215": {
            "id": "722810215",
            "speakerId": 1000,
            "speakerName": "珊瑚宫心海",
            "text": "让我想想…你们二位应该没有问题，那就一起去吧。"
          }
        }
      }
    },
    {
      "subId": "7228103",
      "subQuestName": "陪心海去见笔友",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [],
        "dialogs": {}
      }
    },
    {
      "subId": "7228104",
      "subQuestName": "陪心海去见笔友",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "722810401"
        ],
        "dialogs": {
          "722810401": {
            "id": "722810401",
            "speakerId": 1000,
            "speakerName": "珊瑚宫心海",
            "text": "约定的地点就在这里了。",
            "nextDialogs": [
              "722810402"
            ]
          },
          "722810402": {
            "id": "722810402",
            "speakerId": 1002,
            "speakerName": "五郎",
            "text": "周围没有其他人，看样子是我们来得比较早…",
            "nextDialogs": [
              "722810403"
            ]
          },
          "722810403": {
            "id": "722810403",
            "speakerId": 1003,
            "speakerName": "八重神子",
            "text": "哎呀呀，让我看看是谁来了？",
            "nextDialogs": [
              "722810404"
            ]
          },
          "722810404": {
            "id": "722810404",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "神、神子！",
            "nextDialogs": [
              "722810405"
            ]
          },
          "722810405": {
            "id": "722810405",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "（糟糕了，没想到竟然碰到了神子！神子和心海不仅分属两个阵营，信仰的神明也不同。）",
            "nextDialogs": [
              "722810406"
            ]
          },
          "722810406": {
            "id": "722810406",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "（她们两个之间…不会发生什么冲突吧？）",
            "nextDialogs": [
              "722810407"
            ]
          },
          "722810407": {
            "id": "722810407",
            "speakerId": 1000,
            "speakerName": "珊瑚宫心海",
            "text": "不愧是鸣神大社的宫司大人，果然是一副高高在上的态度。",
            "nextDialogs": [
              "722810408"
            ]
          },
          "722810408": {
            "id": "722810408",
            "speakerId": 1003,
            "speakerName": "八重神子",
            "text": "呵呵，不愧是海祇岛的领袖，虽说看起来就像水母一样柔弱，但就连说出的话都是有毒的呢。",
            "nextDialogs": [
              "722810409"
            ]
          },
          "722810409": {
            "id": "722810409",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "啊…这、这可怎么办才好…",
            "nextDialogs": [
              "722810410"
            ]
          },
          "722810410": {
            "id": "722810410",
            "speakerId": 1000,
            "speakerName": "珊瑚宫心海",
            "text": "你好，初次见面，「玲珑油豆腐」小姐。",
            "nextDialogs": [
              "722810411"
            ]
          },
          "722810411": {
            "id": "722810411",
            "speakerId": 1003,
            "speakerName": "八重神子",
            "text": "请多关照咯，「深海舌鲆鱼」小姐。",
            "nextDialogs": [
              "722810412"
            ]
          },
          "722810412": {
            "id": "722810412",
            "speakerId": 1004,
            "speakerName": "两人",
            "text": "呵呵呵呵呵…",
            "nextDialogs": [
              "722810413"
            ]
          },
          "722810413": {
            "id": "722810413",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "欸…这到底是怎么回事？",
            "nextDialogs": [
              "722810414"
            ]
          },
          "722810414": {
            "id": "722810414",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "原来心海的笔友，竟然是神子吗？！",
            "nextDialogs": [
              "722810415"
            ]
          },
          "722810415": {
            "id": "722810415",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "不对不对，看她们两个的样子，根本就是早知道彼此的身份！这么说的话…",
            "nextDialogs": [
              "722810418"
            ]
          },
          "722810418": {
            "id": "722810418",
            "speakerId": 1003,
            "speakerName": "八重神子",
            "text": "嗯？你在说什么呀，我怎么听不懂？我明明只是来和「深海舌鲆鱼」小姐开「小说鉴赏会」的呀。",
            "nextDialogs": [
              "722810419"
            ]
          },
          "722810419": {
            "id": "722810419",
            "speakerId": 1003,
            "speakerName": "八重神子",
            "text": "我们走吧，鉴赏会的地点就在上面的勘定奉行府里，那儿风景很好，特别适合喝喝茶，聊聊创作。",
            "nextDialogs": [
              "722810420"
            ]
          },
          "722810420": {
            "id": "722810420",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "什么样的「小说鉴赏会」能开到勘定奉行府里去啊，会相信才怪呢！",
            "nextDialogs": [
              "722810421"
            ]
          },
          "722810421": {
            "id": "722810421",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "我看你们这次聊起来，就不是改变稻妻的文坛，而是要连整个稻妻的局势都改变了。",
            "nextDialogs": [
              "722810422"
            ]
          },
          "722810422": {
            "id": "722810422",
            "speakerId": 1000,
            "speakerName": "珊瑚宫心海",
            "text": "呵呵，海祇岛不久后会与幕府针对稻妻未来的发展进行正式会谈，在会谈前，这样的非正式会晤也是必要的。",
            "nextDialogs": [
              "722810423"
            ]
          },
          "722810423": {
            "id": "722810423",
            "speakerId": 1003,
            "speakerName": "八重神子",
            "text": "对，尤其是我这种幕府之外的人出面，会更方便帮大家摸清彼此的底线。",
            "nextDialogs": [
              "722810424"
            ]
          },
          "722810424": {
            "id": "722810424",
            "speakerId": 1003,
            "speakerName": "八重神子",
            "text": "只不过这才是我们第一次会面，对一般民众来说，公布消息还是略早了一点。",
            "nextDialogs": [
              "722810425"
            ]
          },
          "722810425": {
            "id": "722810425",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "原来是这样。",
            "nextDialogs": [
              "722810426"
            ]
          },
          "722810426": {
            "id": "722810426",
            "speakerId": 1003,
            "speakerName": "八重神子",
            "text": "说起来，怎么没看见你们的大将？你不是说他也会一起来的吗。",
            "nextDialogs": [
              "722810427"
            ]
          },
          "722810427": {
            "id": "722810427",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "咦，对哦，五郎他怎么突然不见了…",
            "nextDialogs": [
              "722810428"
            ]
          },
          "722810428": {
            "id": "722810428",
            "speakerId": 1000,
            "speakerName": "珊瑚宫心海",
            "text": "五郎他帮我去采购书籍了，所以这次鉴赏会就不来了。",
            "nextDialogs": [
              "722810429"
            ]
          },
          "722810429": {
            "id": "722810429",
            "speakerId": 1003,
            "speakerName": "八重神子",
            "text": "哎呀，真可惜，我还以为又能看到他那双毛茸茸的耳朵了呢。",
            "nextDialogs": [
              "722810430"
            ]
          },
          "722810430": {
            "id": "722810430",
            "speakerId": 1000,
            "speakerName": "珊瑚宫心海",
            "text": "#{NICKNAME}，借一步说话。",
            "nextDialogs": [
              "722810431"
            ]
          },
          "722810431": {
            "id": "722810431",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "怎么了？",
            "nextDialogs": [
              "722810432"
            ]
          },
          "722810432": {
            "id": "722810432",
            "speakerId": 1000,
            "speakerName": "珊瑚宫心海",
            "text": "我之前就隐约感觉到五郎不擅应对八重宫司，所以这次一开始，我才不想让他跟我来离岛。",
            "nextDialogs": [
              "722810433"
            ]
          },
          "722810433": {
            "id": "722810433",
            "speakerId": 1000,
            "speakerName": "珊瑚宫心海",
            "text": "刚才他一看见八重宫司就躲了起来，恐怕是本能反应，但五郎责任心又很强，今后见到我，肯定会羞愧得无地自容。",
            "nextDialogs": [
              "722810434"
            ]
          },
          "722810434": {
            "id": "722810434",
            "speakerId": 1000,
            "speakerName": "珊瑚宫心海",
            "text": "所以我想把采购书籍的任务交给他，也能让他心里好受些。",
            "nextDialogs": [
              "722810435"
            ]
          },
          "722810435": {
            "id": "722810435",
            "speakerId": 1000,
            "speakerName": "珊瑚宫心海",
            "text": "但五郎之前很少买东西，所以我想拜托你们跟他一起去。",
            "nextDialogs": [
              "722810436"
            ]
          },
          "722810436": {
            "id": "722810436",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "交给我吧。",
            "nextDialogs": [
              "722810437"
            ]
          },
          "722810437": {
            "id": "722810437",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "心海，你就放心和神子开会，买书的事就交给我们和五郎吧。",
            "nextDialogs": [
              "722810438"
            ]
          },
          "722810438": {
            "id": "722810438",
            "speakerId": 1000,
            "speakerName": "珊瑚宫心海",
            "text": "那就拜托你们了。这张纸上我列出了要买书籍的清单，你把它交给五郎吧。"
          }
        }
      }
    },
    {
      "subId": "7228105",
      "subQuestName": "寻找五郎",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "722810501"
        ],
        "dialogs": {
          "722810501": {
            "id": "722810501",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "五郎，你还好吧？",
            "nextDialogs": [
              "722810502"
            ]
          },
          "722810502": {
            "id": "722810502",
            "speakerId": 1002,
            "speakerName": "五郎",
            "text": "啊！是你们俩…唉，没想到那个女人竟然会突然出现，我实在是不知道该跟她说什么。等我回过神来，就已经躲在这附近了。",
            "nextDialogs": [
              "722810503"
            ]
          },
          "722810503": {
            "id": "722810503",
            "speakerId": 1002,
            "speakerName": "五郎",
            "text": "我明明是为了保护珊瑚宫大人的安全才跟来的，结果却什么都做不到，反而成了她的负担。",
            "nextDialogs": [
              "722810504"
            ]
          },
          "722810504": {
            "id": "722810504",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "五郎，你不要太自责了，其实心海她托我们来告诉你，有个重要的任务交给你呢。",
            "nextDialogs": [
              "722810505"
            ]
          },
          "722810505": {
            "id": "722810505",
            "speakerId": 1005,
            "speakerName": "Black Screen",
            "text": "把心海的书单交给五郎。",
            "nextDialogs": [
              "722810506"
            ]
          },
          "722810506": {
            "id": "722810506",
            "speakerId": 1002,
            "speakerName": "五郎",
            "text": "这是珊瑚宫大人的采购列表，我明白了，大人是希望我能将功补过！好，接下来就交给我吧。",
            "nextDialogs": [
              "722810507"
            ]
          },
          "722810507": {
            "id": "722810507",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "五郎，我们也陪你一起去吧，我们刚好可以作为向导，陪你在容彩祭上转转。",
            "nextDialogs": [
              "722810508"
            ]
          },
          "722810508": {
            "id": "722810508",
            "speakerId": 1002,
            "speakerName": "五郎",
            "text": "太感谢了！"
          }
        }
      }
    },
    {
      "subId": "7228106",
      "subQuestName": "在会场采购书籍",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [],
        "dialogs": {}
      }
    },
    {
      "subId": "7228107",
      "subQuestName": "在会场采购书籍",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "722810701"
        ],
        "dialogs": {
          "722810701": {
            "id": "722810701",
            "speakerId": 1002,
            "speakerName": "五郎",
            "text": "书单上有一本叫做《影向山之夜》的童话书，应该就是在这个摊位售卖的。",
            "nextDialogs": [
              "722810702"
            ]
          },
          "722810702": {
            "id": "722810702",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "童话书？",
            "nextDialogs": [
              "722810703"
            ]
          },
          "722810703": {
            "id": "722810703",
            "speakerId": 1002,
            "speakerName": "五郎",
            "text": "对，这是珊瑚宫大人买给海祇岛的孩子们的。珊瑚宫大人说这本书用词浅显易懂，很适合用来学习认字。",
            "nextDialogs": [
              "722810704"
            ]
          },
          "722810704": {
            "id": "722810704",
            "speakerId": 1002,
            "speakerName": "五郎",
            "text": "您好，请给我五本《影向山之夜》。",
            "nextDialogs": [
              "722810705"
            ]
          },
          "722810705": {
            "id": "722810705",
            "speakerId": 1006,
            "speakerName": "福本",
            "text": "多谢惠顾！",
            "nextDialogs": [
              "722810706"
            ]
          },
          "722810706": {
            "id": "722810706",
            "speakerId": 1006,
            "speakerName": "福本",
            "text": "哎呀，这位客人您真幸运，刚好买到了放有赠品券的书，可以额外获得一份奖品！",
            "nextDialogs": [
              "722810707"
            ]
          },
          "722810707": {
            "id": "722810707",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "哇，还有奖品可以拿，好棒呀五郎。",
            "nextDialogs": [
              "722810708"
            ]
          },
          "722810708": {
            "id": "722810708",
            "speakerId": 1006,
            "speakerName": "福本",
            "text": "这是赠送您的狐狸玩偶，请您收好！",
            "nextDialogs": [
              "722810709"
            ]
          },
          "722810709": {
            "id": "722810709",
            "speakerId": 1002,
            "speakerName": "五郎",
            "text": "什么，狐狸玩偶？",
            "nextDialogs": [
              "722810710"
            ]
          },
          "722810710": {
            "id": "722810710",
            "speakerId": 1006,
            "speakerName": "福本",
            "text": "这位客人，您怎么了？好像尾巴上的毛都竖起来了…",
            "nextDialogs": [
              "722810711"
            ]
          },
          "722810711": {
            "id": "722810711",
            "speakerId": 1002,
            "speakerName": "五郎",
            "text": "不，我没事，谢谢您的赠品。",
            "nextDialogs": [
              "722810712"
            ]
          },
          "722810712": {
            "id": "722810712",
            "speakerId": 1002,
            "speakerName": "五郎",
            "text": "#{NICKNAME}，这个狐…呃，玩偶，如果可以的话，还是请你收下吧。",
            "nextDialogs": [
              "722810713"
            ]
          },
          "722810713": {
            "id": "722810713",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "真的可以吗？",
            "nextDialogs": [
              "722810714"
            ]
          },
          "722810714": {
            "id": "722810714",
            "speakerId": 1002,
            "speakerName": "五郎",
            "text": "嗯，就当作你们陪我来买书的谢礼好了。",
            "nextDialogs": [
              "722810715"
            ]
          },
          "722810715": {
            "id": "722810715",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "哎，看来五郎现在都没从见到神子的心理阴影里走出来呢。",
            "nextDialogs": [
              "722810716"
            ]
          },
          "722810716": {
            "id": "722810716",
            "speakerId": 1002,
            "speakerName": "五郎",
            "text": "接下来的话…虽说不是这次行程的重点，但我们先去买轻小说吧。",
            "nextDialogs": [
              "722810717"
            ]
          },
          "722810717": {
            "id": "722810717",
            "speakerId": 1002,
            "speakerName": "五郎",
            "text": "书单上说《沉秋拾剑录》的新刊，是拜托一个叫小野寺的编辑事先买好的，还是不要让对方等我们太久。",
            "nextDialogs": [
              "722810718"
            ]
          },
          "722810718": {
            "id": "722810718",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "这个人我们认识，我们带你去找他。"
          }
        }
      }
    },
    {
      "subId": "7228108",
      "subQuestName": "领取预留的小说",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [],
        "dialogs": {}
      }
    },
    {
      "subId": "7228109",
      "subQuestName": "领取预留的小说",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "722810901"
        ],
        "dialogs": {
          "722810901": {
            "id": "722810901",
            "speakerId": 1002,
            "speakerName": "五郎",
            "text": "请问你就是小野寺先生吗？我是来拿「深海舌鲆鱼」的那本《沉秋拾剑录》新刊的。",
            "nextDialogs": [
              "722810902"
            ]
          },
          "722810902": {
            "id": "722810902",
            "speakerId": 1007,
            "speakerName": "小野寺",
            "text": "你好你好，书在我这里。听说「深海舌鲆鱼」小姐是容彩祭的贵客，但因为船只时间问题，所以没能赶上签售会。",
            "nextDialogs": [
              "722810903"
            ]
          },
          "722810903": {
            "id": "722810903",
            "speakerId": 1002,
            "speakerName": "五郎",
            "text": "此外还有这几本书，如果有存货的话，也请每种都拿给我一本吧。",
            "nextDialogs": [
              "722810904"
            ]
          },
          "722810904": {
            "id": "722810904",
            "speakerId": 1007,
            "speakerName": "小野寺",
            "text": "好的。让我看看…",
            "nextDialogs": [
              "722810905"
            ]
          },
          "722810905": {
            "id": "722810905",
            "speakerId": 1007,
            "speakerName": "小野寺",
            "text": "哎呀，这位客人您真是幸运！",
            "nextDialogs": [
              "722810906"
            ]
          },
          "722810906": {
            "id": "722810906",
            "speakerId": 1007,
            "speakerName": "小野寺",
            "text": "您刚好是购买《哈玛瓦兰战记》的第一百位读者，所以可以获得由八重大人亲笔题写书评的特别版！",
            "nextDialogs": [
              "722810907"
            ]
          },
          "722810907": {
            "id": "722810907",
            "speakerId": 1002,
            "speakerName": "五郎",
            "text": "呃…怎么会这样？！",
            "nextDialogs": [
              "722810908"
            ]
          },
          "722810908": {
            "id": "722810908",
            "speakerId": 1007,
            "speakerName": "小野寺",
            "text": "这位客人，您怎么了？脸色看起来不太好啊。",
            "nextDialogs": [
              "722810909"
            ]
          },
          "722810909": {
            "id": "722810909",
            "speakerId": 1002,
            "speakerName": "五郎",
            "text": "我…我没事。谢谢你，这本书我就收下了。",
            "nextDialogs": [
              "722810910"
            ]
          },
          "722810910": {
            "id": "722810910",
            "speakerId": 1002,
            "speakerName": "五郎",
            "text": "这本书毕竟是珊…「深海舌鲆鱼」小姐拜托我买的，而且得到了带书评的特别版，她应该会开心吧，哈，哈哈……",
            "nextDialogs": [
              "722810911"
            ]
          },
          "722810911": {
            "id": "722810911",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "五郎看起来好勉强啊，真不知道该说他是幸运还是不幸。",
            "nextDialogs": [
              "722810912"
            ]
          },
          "722810912": {
            "id": "722810912",
            "speakerId": 1007,
            "speakerName": "小野寺",
            "text": "对了，客人您刚才购书的金额，已经可以参加八重堂的幸运抽奖了，请跟我到抽奖台那边去吧。"
          }
        }
      }
    },
    {
      "subId": "7228110",
      "subQuestName": "前往抽奖台",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [],
        "dialogs": {}
      }
    },
    {
      "subId": "7228111",
      "subQuestName": "前往抽奖台",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "722811101"
        ],
        "dialogs": {
          "722811101": {
            "id": "722811101",
            "speakerId": 1007,
            "speakerName": "小野寺",
            "text": "客人，请您在这里进行抽奖。",
            "nextDialogs": [
              "722811102"
            ]
          },
          "722811102": {
            "id": "722811102",
            "speakerId": 1008,
            "speakerName": "村田",
            "text": "您只要转动这个把手就好，稍等片刻就会有奖球掉出来，说不定您就是今天的幸运儿哦！",
            "nextDialogs": [
              "722811103"
            ]
          },
          "722811103": {
            "id": "722811103",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "五郎，试试运气吧！",
            "nextDialogs": [
              "722811104"
            ]
          },
          "722811104": {
            "id": "722811104",
            "speakerId": 1008,
            "speakerName": "村田",
            "text": "让我看看…金色的奖球！好厉害，这位客人竟然抽中了特等奖！",
            "nextDialogs": [
              "722811105"
            ]
          },
          "722811105": {
            "id": "722811105",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "五郎，我发现你今天果然特别走运！说起来，特等奖能得到什么？",
            "nextDialogs": [
              "722811106"
            ]
          },
          "722811106": {
            "id": "722811106",
            "speakerId": 1008,
            "speakerName": "村田",
            "text": "特等奖将会获得八重堂出版的全部轻小说一套！",
            "nextDialogs": [
              "722811107"
            ]
          },
          "722811107": {
            "id": "722811107",
            "speakerId": 1008,
            "speakerName": "村田",
            "text": "不仅奖品会由八重神子大人亲自颁发，并且还能获得与八重大人握手留影的机会！",
            "nextDialogs": [
              "722811108"
            ]
          },
          "722811108": {
            "id": "722811108",
            "speakerId": 1002,
            "speakerName": "五郎",
            "text": "什么？不仅要见到那个女人，还…还要握手留影？",
            "nextDialogs": [
              "722811109"
            ]
          },
          "722811109": {
            "id": "722811109",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "五郎，振作一点！",
            "nextDialogs": [
              "722811110"
            ]
          },
          "722811110": {
            "id": "722811110",
            "speakerId": 1009,
            "speakerName": "阳太",
            "text": "什么，这个小哥抽中八重堂的大奖了？这也太幸运了吧。",
            "nextDialogs": [
              "722811111"
            ]
          },
          "722811111": {
            "id": "722811111",
            "speakerId": 1010,
            "speakerName": "秋人",
            "text": "全部轻小说一套，这可是值好多钱哪！",
            "nextDialogs": [
              "722811112"
            ]
          },
          "722811112": {
            "id": "722811112",
            "speakerId": 1002,
            "speakerName": "五郎",
            "text": "呃…那个，编辑小姐，我想和你商量一件事，其实我不想要轻小说。",
            "nextDialogs": [
              "722811113"
            ]
          },
          "722811113": {
            "id": "722811113",
            "speakerId": 1008,
            "speakerName": "村田",
            "text": "咦，客人的意思是要放弃奖品吗？",
            "nextDialogs": [
              "722811114"
            ]
          },
          "722811114": {
            "id": "722811114",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "五郎，不要放弃奖品啊，如果你不想见神子的话，我们可以帮你想想办法！",
            "nextDialogs": [
              "722811115"
            ]
          },
          "722811115": {
            "id": "722811115",
            "speakerId": 1002,
            "speakerName": "五郎",
            "text": "不，你们误会了，我并不是要放弃奖品，而且颁奖和留影什么的我也都可以接受。",
            "nextDialogs": [
              "722811116"
            ]
          },
          "722811116": {
            "id": "722811116",
            "speakerId": 1002,
            "speakerName": "五郎",
            "text": "不过我有一个请求，我想请八重堂，把奖品换成等额的农业科学书籍。",
            "nextDialogs": [
              "722811117"
            ]
          },
          "722811117": {
            "id": "722811117",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "农业科学书籍？",
            "nextDialogs": [
              "722811118"
            ]
          },
          "722811118": {
            "id": "722811118",
            "speakerId": 1002,
            "speakerName": "五郎",
            "text": "对。我们海祇岛的土地贫瘠，粮食收成不好，所以我们一直在寻找新途径，帮助居民们过上更好的生活。",
            "nextDialogs": [
              "722811119"
            ]
          },
          "722811119": {
            "id": "722811119",
            "speakerId": 1002,
            "speakerName": "五郎",
            "text": "珊…咳，「深海舌鲆鱼」小姐这次来容彩祭的重要采购任务，就是挑选一些作物种植、水产养殖类的书。",
            "nextDialogs": [
              "722811120"
            ]
          },
          "722811120": {
            "id": "722811120",
            "speakerId": 1002,
            "speakerName": "五郎",
            "text": "如果能换到这类书作为奖品，那我们就能省下不少钱，「深海舌鲆鱼」小姐就能再去挑选一些其他有用的东西。",
            "nextDialogs": [
              "722811121"
            ]
          },
          "722811121": {
            "id": "722811121",
            "speakerId": 1008,
            "speakerName": "村田",
            "text": "原来如此，客人的想法我已经清楚了。不过这件事我无法做决定，必须由八重大人定夺才行。",
            "nextDialogs": [
              "722811122"
            ]
          },
          "722811122": {
            "id": "722811122",
            "speakerId": 1008,
            "speakerName": "村田",
            "text": "我现在去联系八重大人，请客人到五歌仙广场那里等候回复。根据情况，也有可能会由八重大人亲自与您商量此事。",
            "nextDialogs": [
              "722811123"
            ]
          },
          "722811123": {
            "id": "722811123",
            "speakerId": 1002,
            "speakerName": "五郎",
            "text": "好的，我明白了。"
          }
        }
      }
    },
    {
      "subId": "7228112",
      "subQuestName": "前往五歌仙广场等候",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [],
        "dialogs": {}
      }
    },
    {
      "subId": "7228113",
      "subQuestName": "前往五歌仙广场等候",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "722811301"
        ],
        "dialogs": {
          "722811301": {
            "id": "722811301",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "五郎，你刚才好勇敢啊，明明不擅长对付神子，却不仅答应了参加颁奖，还提出了自己的要求。",
            "nextDialogs": [
              "722811302"
            ]
          },
          "722811302": {
            "id": "722811302",
            "speakerId": 1002,
            "speakerName": "五郎",
            "text": "真的吗？当时我只是一想到珊瑚宫大人的嘱托，还有海祇岛的居民，就一下子有了勇气。",
            "nextDialogs": [
              "722811303"
            ]
          },
          "722811303": {
            "id": "722811303",
            "speakerId": 1002,
            "speakerName": "五郎",
            "text": "我可是海祇岛的大将，怎么能输在这种地方？",
            "nextDialogs": [
              "722811304"
            ]
          },
          "722811304": {
            "id": "722811304",
            "speakerId": 1002,
            "speakerName": "五郎",
            "text": "现在，我已经找到领兵作战时候的感觉了，接下来，就算是八重神子亲自来谈判，我也不会被她的压迫力影响了。",
            "nextDialogs": [
              "722811305"
            ]
          },
          "722811305": {
            "id": "722811305",
            "speakerId": 1002,
            "speakerName": "五郎",
            "text": "……",
            "nextDialogs": [
              "722811306"
            ]
          },
          "722811306": {
            "id": "722811306",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "五郎，你看起来好像还是有点紧张。",
            "nextDialogs": [
              "722811307"
            ]
          },
          "722811307": {
            "id": "722811307",
            "speakerId": 1002,
            "speakerName": "五郎",
            "text": "哈哈，大概是因为想到，那个女人说不定会提出什么捉弄我的要求吧。",
            "nextDialogs": [
              "722811308"
            ]
          },
          "722811308": {
            "id": "722811308",
            "speakerId": 1008,
            "speakerName": "村田",
            "text": "几位，抱歉让你们久等了。",
            "nextDialogs": [
              "722811309"
            ]
          },
          "722811309": {
            "id": "722811309",
            "speakerId": 1002,
            "speakerName": "五郎",
            "text": "情况怎么样，八重宫司她说了什么？",
            "nextDialogs": [
              "722811310"
            ]
          },
          "722811310": {
            "id": "722811310",
            "speakerId": 1008,
            "speakerName": "村田",
            "text": "八重大人说，可以答应客人您的要求，把奖品的轻小说都换成农业科学类书籍。",
            "nextDialogs": [
              "722811311"
            ]
          },
          "722811311": {
            "id": "722811311",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "太好啦。",
            "nextDialogs": [
              "722811312"
            ]
          },
          "722811312": {
            "id": "722811312",
            "speakerId": 1008,
            "speakerName": "村田",
            "text": "而且八重大人说，考虑到客人您使用书籍的目的，还可以额外多赠送您一些。",
            "nextDialogs": [
              "722811313"
            ]
          },
          "722811313": {
            "id": "722811313",
            "speakerId": 1008,
            "speakerName": "村田",
            "text": "您现在就可以跟我去八重堂的仓库选书。客人乘坐的船是明天晚上，选好的书籍会由我们打包直接送上船。",
            "nextDialogs": [
              "722811314"
            ]
          },
          "722811314": {
            "id": "722811314",
            "speakerId": 1002,
            "speakerName": "五郎",
            "text": "直接打包？那颁奖仪式该怎么办呢？",
            "nextDialogs": [
              "722811315"
            ]
          },
          "722811315": {
            "id": "722811315",
            "speakerId": 1008,
            "speakerName": "村田",
            "text": "八重大人说，选书会耗费不少时间精力，为了让您能在容彩祭上有一段美好的回忆，颁奖仪式就取消了。",
            "nextDialogs": [
              "722811316"
            ]
          },
          "722811316": {
            "id": "722811316",
            "speakerId": 1008,
            "speakerName": "村田",
            "text": "不过，她给您留下了一封信，您可以在有时间的时候再读。",
            "nextDialogs": [
              "722811317"
            ]
          },
          "722811317": {
            "id": "722811317",
            "speakerId": 1002,
            "speakerName": "五郎",
            "text": "没想到八重神子竟然会取消颁奖仪式…唉，我之前一直认定了会被她狠狠作弄，现在看来，是我太狭隘了。",
            "nextDialogs": [
              "722811318"
            ]
          },
          "722811318": {
            "id": "722811318",
            "speakerId": 1002,
            "speakerName": "五郎",
            "text": "那先跟这位编辑小姐去选书了，就不麻烦你们了。",
            "nextDialogs": [
              "722811321"
            ]
          },
          "722811321": {
            "id": "722811321",
            "speakerId": 1002,
            "speakerName": "五郎",
            "text": "好，那就明天晚上再见。"
          }
        }
      }
    },

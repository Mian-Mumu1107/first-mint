  "subQuests": [
    {
      "subId": "7605601",
      "subQuestName": "第一次对战对话$HIDDEN",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "760560201"
        ],
        "dialogs": {
          "760560201": {
            "id": "760560201",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "不要说两招，三招也没问题。",
            "nextDialogs": [
              "760560202"
            ]
          },
          "760560202": {
            "id": "760560202",
            "speakerId": 1000,
            "speakerName": "特尔霍",
            "text": "哈哈，爽快！果然还是人与人的较量才有意思对吧！彼伊列，要不就你先来和这位朋友过三招？",
            "nextDialogs": [
              "760560205"
            ]
          },
          "760560205": {
            "id": "760560205",
            "speakerId": 1001,
            "speakerName": "彼伊列",
            "text": "好的老大！三招之内一定拿下！"
          }
        }
      }
    },
    {
      "subId": "7605604",
      "subQuestName": "第一场战斗$HIDDEN",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "760560401"
        ],
        "dialogs": {
          "760560401": {
            "id": "760560401",
            "speakerId": 1001,
            "speakerName": "彼伊列",
            "text": "对不起老大…我给大家丢脸了…",
            "nextDialogs": [
              "760560402"
            ]
          },
          "760560402": {
            "id": "760560402",
            "speakerId": 1000,
            "speakerName": "特尔霍",
            "text": "嗨，本来就是打发时间，输了也没关系。彼伊列，你先边上休息一下。",
            "nextDialogs": [
              "760560403"
            ]
          },
          "760560403": {
            "id": "760560403",
            "speakerId": 1000,
            "speakerName": "特尔霍",
            "text": "这位朋友，你的身手很矫健嘛！我的名字叫特尔霍，幸会！",
            "nextDialogs": [
              "760560404"
            ]
          },
          "760560404": {
            "id": "760560404",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "#我是{NICKNAME}，幸会！",
            "nextDialogs": [
              "760560405"
            ]
          },
          "760560405": {
            "id": "760560405",
            "speakerId": 1000,
            "speakerName": "特尔霍",
            "text": "你看上去是有不少实战经验的高手，那我们可得认真一些了。刚才那次不算，再比试一次！英凯莉，轮到你了！",
            "nextDialogs": [
              "760560406"
            ]
          },
          "760560406": {
            "id": "760560406",
            "speakerId": 1002,
            "speakerName": "英凯莉",
            "text": "老大每次都是遇到麻烦才想起我…真是没办法。那么，这位高手，我们开始吧！"
          }
        }
      }
    },
    {
      "subId": "7605602",
      "subQuestName": "第二次对战对话$HIDDEN",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [],

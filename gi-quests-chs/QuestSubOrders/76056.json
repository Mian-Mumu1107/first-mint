    {
      "subId": "7605606",
      "subQuestName": "第三场战斗$HIDDEN",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "760560601"
        ],
        "dialogs": {
          "760560601": {
            "id": "760560601",
            "speakerId": 1002,
            "speakerName": "英凯莉",
            "text": "竟然真的输给了一个过路人…三次！",
            "nextDialogs": [
              "760560602"
            ]
          },
          "760560602": {
            "id": "760560602",
            "speakerId": 1001,
            "speakerName": "彼伊列",
            "text": "不不，你我各输了两次，老大只输了一次而已，还好…",
            "nextDialogs": [
              "760560603"
            ]
          },
          "760560603": {
            "id": "760560603",
            "speakerId": 1000,
            "speakerName": "特尔霍",
            "text": "#嗨！输了就是输了，多想也没用！{NICKNAME}真的很强嘛！",
            "nextDialogs": [
              "760560604"
            ]
          },
          "760560604": {
            "id": "760560604",
            "speakerId": 1000,
            "speakerName": "特尔霍",
            "text": "你们两个平时连我也打不过，现在见识到真正的强者了吧？你们还要多训练才行。",
            "nextDialogs": [
              "760560605"
            ]
          },
          "760560605": {
            "id": "760560605",
            "speakerId": 1000,
            "speakerName": "特尔霍",
            "text": "至于我嘛！看来得考虑早点儿退休了，不知道瓦伊诺的训练场还招不招人…"
          }
        }
      }
    },
    {
      "subId": "7605607",
      "subQuestName": "战斗后闲置对话$HIDDEN",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "760560701"
        ],
        "dialogs": {
          "760560701": {
            "id": "760560701",
            "speakerId": 1000,
            "speakerName": "特尔霍",
            "text": "你果然回来了！彼伊列，这次就你先上吧！怎么样？这位朋友，准备好跟我们过招了吗？"
          }
        }
      }
    },
    {
      "subId": "7605601",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "760560101"
        ],
        "dialogs": {
          "760560101": {
            "id": "760560101",
            "speakerId": 1000,
            "speakerName": "特尔霍",
            "text": "哟，这位朋友！来训练场光是打靶子的话，会不会觉得不是很过瘾？你看起来身手不错，要不要来跟我们过两招？"
          }
        }
      }
    },
    {

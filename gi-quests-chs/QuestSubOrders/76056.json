      }
    },
    {
      "subId": "7605605",
      "subQuestName": "第二场战斗$HIDDEN",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "760560501"
        ],
        "dialogs": {
          "760560501": {
            "id": "760560501",
            "speakerId": 1002,
            "speakerName": "英凯莉",
            "text": "我、我竟然输了…被一个随随便便的路人打败了…这，怎么可能？！",
            "nextDialogs": [
              "760560502"
            ]
          },
          "760560502": {
            "id": "760560502",
            "speakerId": 1000,
            "speakerName": "特尔霍",
            "text": "唔，竟然赢过了英凯莉…是我太轻敌了。",
            "nextDialogs": [
              "760560503"
            ]
          },
          "760560503": {
            "id": "760560503",
            "speakerId": 1001,
            "speakerName": "彼伊列",
            "text": "不是老大的错，毕竟谁能想到会有这么强大的对手恰巧路过这里…",
            "nextDialogs": [
              "760560504"
            ]
          },
          "760560504": {
            "id": "760560504",
            "speakerId": 1002,
            "speakerName": "英凯莉",
            "text": "老大！不能放他们走…",
            "nextDialogs": [
              "760560505"
            ]
          },
          "760560505": {
            "id": "760560505",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "哦？难道不只是想切磋而已？",
            "nextDialogs": [
              "760560506"
            ]
          },
          "760560506": {
            "id": "760560506",
            "speakerId": 1000,
            "speakerName": "特尔霍",
            "text": "别误会，英凯莉的意思是不能就这样认输罢了。我们毕竟也算是有点儿脸面的宝藏猎人。",
            "nextDialogs": [
              "760560507"
            ]
          },
          "760560507": {
            "id": "760560507",
            "speakerId": 1000,
            "speakerName": "特尔霍",
            "text": "#{NICKNAME}，我郑重地向你发出正式挑战。这一次可就不是过招了，我们拿出真本事来打一场怎么样？",
            "nextDialogs": [
              "760560508"
            ]
          },
          "760560508": {
            "id": "760560508",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "那就请三位一起上吧。",
            "nextDialogs": [
              "760560509"
            ]
          },
          "760560509": {
            "id": "760560509",
            "speakerId": 1000,
            "speakerName": "特尔霍",
            "text": "好，那我们可就不客气了！"
          }
        }
      }
    },
    {

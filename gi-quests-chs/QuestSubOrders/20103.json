    {
      "subId": "2010309",
      "subQuestName": "【隐藏】让丘丘人高兴$HIDDEN",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "201030901"
        ],
        "dialogs": {
          "201030901": {
            "id": "201030901",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "咦？这是什么反应，难道是太高兴了…艾拉·马斯克的诗真有这么好吗？",
            "nextDialogs": [
              "201030902"
            ]
          },
          "201030902": {
            "id": "201030902",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "不，不对！看后面！小心后面！有丘丘人袭击过来了！"
          }
        }
      }
    },
    {
      "subId": "2010310",
      "subQuestName": "【隐藏】让丘丘人生气$HIDDEN",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "201031001"
        ],
        "dialogs": {
          "201031001": {
            "id": "201031001",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "呜哇，这些丘丘人全都开始跳舞了，看起来确实很高兴呢。",
            "nextDialogs": [
              "201031002"
            ]
          },
          "201031002": {
            "id": "201031002",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "这样子应该就可以了，我们回去和艾拉·马斯克说说具体情况吧。"
          }
        }
      }
    },

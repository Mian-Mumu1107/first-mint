  "subQuests": [
    {
      "subId": "7505301",
      "subQuestName": "(test)与老板对话$HIDDEN",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "750530101"
        ],
        "dialogs": {
          "750530101": {
            "id": "750530101",
            "speakerId": 21609,
            "speakerName": "穆蒲",
            "text": "嗬，异邦人，眼神不错…怎么样，来试试，「目随羽视」的挑战？",
            "nextDialogs": [
              "750530102"
            ]
          },
          "750530102": {
            "id": "750530102",
            "speakerId": 21609,
            "speakerName": "穆蒲",
            "text": "锻炼视力…也能，得到嘉奖。",
            "nextDialogs": [
              "750530103"
            ]
          },
          "750530103": {
            "id": "750530103",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "哦哦，真是简洁的说明…也像是什么都没说…",
            "nextDialogs": [
              "750530104"
            ]
          },
          "750530104": {
            "id": "750530104",
            "speakerId": 21609,
            "speakerName": "穆蒲",
            "text": "详细的规则，还在后头…如果你们，想要试试看？",
            "nextDialogs": [
              "750530105"
            ]
          },
          "750530105": {
            "id": "750530105",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "那就听听看吧…",
            "nextDialogs": [
              "750530106"
            ]
          },
          "750530106": {
            "id": "750530106",
            "speakerId": 21609,
            "speakerName": "穆蒲",
            "text": "三只绒翼龙，会往外飞，盯住中间那只…",
            "nextDialogs": [
              "750530107"
            ]
          },
          "750530107": {
            "id": "750530107",
            "speakerId": 21609,
            "speakerName": "穆蒲",
            "text": "等它们都飞回，<color=#00E1FFFF>认出…原本在中间的那只</color>，就是这样。",
            "nextDialogs": [
              "750530108"
            ]
          },
          "750530108": {
            "id": "750530108",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "唔，也就是说，这三只会在空中变换位置，我们得找到原本在中间的那只？",
            "nextDialogs": [
              "750530109"
            ]
          },
          "750530109": {
            "id": "750530109",
            "speakerId": 21609,
            "speakerName": "穆蒲",
            "text": "很对。",
            "nextDialogs": [
              "750530110"
            ]
          },
          "750530110": {
            "id": "750530110",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "怪不得说这个挑战能够锻炼视力呢。",
            "nextDialogs": [
              "750530111"
            ]
          },
          "750530111": {
            "id": "750530111",
            "speakerId": 21609,
            "speakerName": "穆蒲",
            "text": "先来点，简单的，试试水？",
            "nextDialogs": [
              "750530112"
            ]
          },
          "750530112": {
            "id": "750530112",
            "speakerId": 21609,
            "speakerName": "穆蒲",
            "text": "如果没问题，我们再，正式玩一把。",
            "nextDialogs": [
              "750530113"
            ]
          },
          "750530113": {
            "id": "750530113",
            "speakerId": 21609,
            "speakerName": "穆蒲",
            "text": "挑战成功，奖励归你。",
            "nextDialogs": [
              "750530115",
              "750530117"
            ]
          },
          "750530115": {
            "id": "750530115",
            "speakerId": 21609,
            "speakerName": "穆蒲",
            "text": "好，反正，我一直在这。"
          },
          "750530117": {
            "id": "750530117",
            "speakerId": 21609,
            "speakerName": "穆蒲",
            "text": "准备好，就击打，靶子，开始吧！"
          }
        }
      }
    },
    {
      "subId": "7505302",
      "subQuestName": "(test)完成玩法$HIDDEN",
      "sceneId": null,
      "locations": [],

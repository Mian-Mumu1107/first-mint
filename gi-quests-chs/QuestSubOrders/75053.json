        "dialogs": {
          "750530201": {
            "id": "750530201",
            "speakerId": 21609,
            "speakerName": "穆蒲",
            "text": "「目随羽视」挑战，要试试吗？",
            "nextDialogs": [
              "750530202"
            ]
          },
          "750530202": {
            "id": "750530202",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "我忘记规则了…",
            "nextDialogs": [
              "750530203"
            ]
          },
          "750530203": {
            "id": "750530203",
            "speakerId": 21609,
            "speakerName": "穆蒲",
            "text": "三只绒翼龙，会往外飞，盯住中间那只…",
            "nextDialogs": [
              "750530204"
            ]
          },
          "750530204": {
            "id": "750530204",
            "speakerId": 21609,
            "speakerName": "穆蒲",
            "text": "等它们都飞回，<color=#00E1FFFF>认出…原本在中间的那只</color>，就可以了。",
            "nextDialogs": [
              "750530208",
              "750530206"
            ]
          },
          "750530208": {
            "id": "750530208",
            "speakerId": 21609,
            "speakerName": "穆蒲",
            "text": "准备好，就击打，靶子，开始吧！"
          },
          "750530206": {
            "id": "750530206",
            "speakerId": 21609,
            "speakerName": "穆蒲",
            "text": "好，反正，我一直在这。"
          }
        }
      }
    },
    {
      "subId": "7505303",
      "subQuestName": "(test)最后与老板对话$HIDDEN",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "750530301"
        ],
        "dialogs": {
          "750530301": {
            "id": "750530301",
            "speakerId": 21609,
            "speakerName": "穆蒲",
            "text": "已经没有奖赏，自然没有，「目随羽视」挑战。",
            "nextDialogs": [
              "750530302"
            ]
          },
          "750530302": {
            "id": "750530302",
            "speakerId": 21609,
            "speakerName": "穆蒲",
            "text": "难道有，其他的，问题？",
            "nextDialogs": [
              "750530304",
              "750530308",
              "750530312"
            ]
          },
          "750530304": {
            "id": "750530304",
            "speakerId": 21609,
            "speakerName": "穆蒲",
            "text": "那是，很久以前，部族，流传下来…",
            "nextDialogs": [
              "750530305"
            ]
          },
          "750530305": {
            "id": "750530305",
            "speakerId": 21609,
            "speakerName": "穆蒲",
            "text": "因为「花羽会」，锐利的眼睛，很是重要。",
            "nextDialogs": [
              "750530306"
            ]
          },
          "750530306": {
            "id": "750530306",
            "speakerId": 21609,
            "speakerName": "穆蒲",
            "text": "这一代，就由，我来主持，负责。"
          },
          "750530308": {
            "id": "750530308",
            "speakerId": 21609,
            "speakerName": "穆蒲",
            "text": "以前，受过伤，从很高的地方…摔下…",
            "nextDialogs": [
              "750530309"
            ]
          },
          "750530309": {
            "id": "750530309",
            "speakerId": 21609,
            "speakerName": "穆蒲",
            "text": "喉咙，和胸口，让我不能…如以往一样，说话。",
            "nextDialogs": [
              "750530310"
            ]
          },
          "750530310": {
            "id": "750530310",
            "speakerId": 21609,
            "speakerName": "穆蒲",
            "text": "但我，不觉得…现在…很糟糕。"
          },
          "750530312": {
            "id": "750530312",
            "speakerId": 21609,
            "speakerName": "穆蒲",
            "text": "祝福你…再见。"
          }
        }
      }
    },

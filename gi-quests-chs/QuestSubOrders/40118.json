            "speakerId": 1006,
            "speakerName": "伊迪娅",
            "text": "#哎呀，{NICKNAME}，怎么样，在蜃境里有什么新发现吗？",
            "nextDialogs": [
              "401181202"
            ]
          },
          "401181202": {
            "id": "401181202",
            "speakerId": 1006,
            "speakerName": "伊迪娅",
            "text": "如果觉得有趣的话，跟我说说也行哦。"
          }
        }
      }
    }

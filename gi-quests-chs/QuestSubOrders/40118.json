    {
      "subId": "4011809",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "401180901"
        ],
        "dialogs": {
          "401180901": {
            "id": "401180901",
            "speakerId": 1000,
            "speakerName": "莱斯格",
            "text": "尊贵的劳伦斯家后裔，一路旅行也学了不少技巧…比如，做烤饼！",
            "nextDialogs": [
              "401180902"
            ]
          },
          "401180902": {
            "id": "401180902",
            "speakerId": 1000,
            "speakerName": "莱斯格",
            "text": "…嗯，这个火候应该没问题吧…",
            "nextDialogs": [
              "401180903"
            ]
          },
          "401180903": {
            "id": "401180903",
            "speakerId": 1001,
            "speakerName": "优菈",
            "text": "没想到你居然会做烤饼…你不是那种从来不洗碗的人吗…",
            "nextDialogs": [
              "401180904"
            ]
          },
          "401180904": {
            "id": "401180904",
            "speakerId": 1000,
            "speakerName": "莱斯格",
            "text": "来得正好，你之后有时间吗？能不能教教我做点心？",
            "nextDialogs": [
              "401180905"
            ]
          },
          "401180905": {
            "id": "401180905",
            "speakerId": 1001,
            "speakerName": "优菈",
            "text": "欸？那可得花上不少时间…我们不是来这里增进家族情谊的吧。",
            "nextDialogs": [
              "401180906"
            ]
          },
          "401180906": {
            "id": "401180906",
            "speakerId": 1000,
            "speakerName": "莱斯格",
            "text": "行啦，这时候又在意这些了？你也说了我们是普通人，像普通的表亲一样互相学习吧。"
          }
        }
      }
    },
    {
      "subId": "4011810",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "401181001"
        ],
        "dialogs": {
          "401181001": {
            "id": "401181001",
            "speakerId": 1002,
            "speakerName": "可莉",
            "text": "真想和「军师」姐姐一起呼呼——地坐飞车呀！可是，她好像会晕倒…",
            "nextDialogs": [
              "401181002"
            ]
          },
          "401181002": {
            "id": "401181002",
            "speakerId": 1003,
            "speakerName": "凯亚",
            "text": "可莉真敏锐啊，一定是从「军师」姐姐眼睛里看到了旋转的星星吧。",
            "nextDialogs": [
              "401181003"
            ]
          },
          "401181003": {
            "id": "401181003",
            "speakerId": 1002,
            "speakerName": "可莉",
            "text": "今天的少了一点哦！昨天有很多很多金色的星星。",
            "nextDialogs": [
              "401181004"
            ]
          },
          "401181004": {
            "id": "401181004",
            "speakerId": 1002,
            "speakerName": "可莉",
            "text": "妈妈要是在的话，可能会说这些星星全是掉进云朵的鱼吧！"
          }
        }
      }
    },
    {
      "subId": "4011811",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "401181101"
        ],
        "dialogs": {
          "401181101": {
            "id": "401181101",
            "speakerId": 1004,
            "speakerName": "柯莱",
            "text": "这种味道的茶我还是第一次喝到，果然稻妻的茶叶跟须弥饮料很不一样呢。",
            "nextDialogs": [
              "401181102"
            ]
          },
          "401181102": {
            "id": "401181102",
            "speakerId": 1005,
            "speakerName": "珊瑚宫心海",
            "text": "这样说来，须弥人会往茶里放香料吗？",
            "nextDialogs": [
              "401181103"
            ]
          },
          "401181103": {
            "id": "401181103",
            "speakerId": 1004,
            "speakerName": "柯莱",
            "text": "会的，不过我喝不惯，如果让我选的话，还是咖啡好一点，就是喝了容易失眠…"
          }
        }
      }
    },
    {
      "subId": "4011812",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [

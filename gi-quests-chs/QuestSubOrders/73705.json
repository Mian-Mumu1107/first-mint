  },
  "subQuests": [
    {
      "subId": "7370501",
      "subQuestName": "与柯莱对话",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "737050101"
        ],
        "dialogs": {
          "737050101": {
            "id": "737050101",
            "speakerId": 1051,
            "speakerName": "柯莱",
            "text": "#{NICKNAME}和派蒙！这边这边！",
            "nextDialogs": [
              "737050102"
            ]
          },
          "737050102": {
            "id": "737050102",
            "speakerId": 1051,
            "speakerName": "柯莱",
            "text": "欢迎来到「稳健知行」机构的主场！",
            "nextDialogs": [
              "737050103"
            ]
          },
          "737050103": {
            "id": "737050103",
            "speakerId": 1051,
            "speakerName": "柯莱",
            "text": "请看，几个核心项目的设施已经搭建好了，大家随时都可以投入工作——",
            "nextDialogs": [
              "737050104"
            ]
          },
          "737050104": {
            "id": "737050104",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "喔！这种氛围，好像轻小说里提过的…「年轻冒险家们的第一个据点」？",
            "nextDialogs": [
              "737050105"
            ]
          },
          "737050105": {
            "id": "737050105",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "唔…又有点学园庆典的感觉，大家聚在一起，仔细研究课题后，组队出发历练自己…让人跃跃欲试！",
            "nextDialogs": [
              "737050108"
            ]
          },
          "737050108": {
            "id": "737050108",
            "speakerId": 1051,
            "speakerName": "柯莱",
            "text": "虽然这个场地不像学园庆典那样豪华，但按提纳里师父的说法，教令院会给我们调配「最有效能」的资源。",
            "nextDialogs": [
              "737050109"
            ]
          },
          "737050109": {
            "id": "737050109",
            "speakerId": 1051,
            "speakerName": "柯莱",
            "text": "学生和学者们前往危险地带之前，会来我们这里仔细咨询，甚至接受一番紧急训练…",
            "nextDialogs": [
              "737050110"
            ]
          },
          "737050110": {
            "id": "737050110",
            "speakerId": 1051,
            "speakerName": "柯莱",
            "text": "如果有必要的话，我们会派遣专人加入他们的队伍，充当可靠的向导和安全员。",
            "nextDialogs": [
              "737050111"
            ]
          },
          "737050111": {
            "id": "737050111",
            "speakerId": 1002,
            "speakerName": "安柏",
            "text": "按照时下流行的叫法，这里是一半训练，一半实战的「前进基地」哦。",
            "nextDialogs": [
              "737050112"
            ]
          },
          "737050112": {
            "id": "737050112",
            "speakerId": 1002,
            "speakerName": "安柏",
            "text": "让新兵们意识到自己即将面对的挑战，好好锻炼一下拳脚，再踏入未知的领域，才不会手忙脚乱！",
            "nextDialogs": [
              "737050113"
            ]
          },
          "737050113": {
            "id": "737050113",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "安柏？居然是你！"
          }
        }
      }
    },
    {
      "subId": "7370502",
      "subQuestName": "与珐露珊对话",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "737050201"
        ],
        "dialogs": {
          "737050201": {
            "id": "737050201",
            "speakerId": 1067,
            "speakerName": "珐露珊",
            "text": "…人气真的有那么高吗？",
            "nextDialogs": [
              "737050202"
            ]
          },
          "737050202": {
            "id": "737050202",
            "speakerId": 1067,
            "speakerName": "珐露珊",
            "text": "内藏行走机构的方法还算巧妙，地形识别、远程控制和重量感应的模块也处理得不错。",
            "nextDialogs": [
              "737050203"
            ]
          },
          "737050203": {
            "id": "737050203",
            "speakerId": 1067,
            "speakerName": "珐露珊",
            "text": "但外观上，怎么看都只是普通的布偶，要不然，还是改改吧…",
            "nextDialogs": [
              "737050204"
            ]
          },
          "737050204": {
            "id": "737050204",
            "speakerId": 1051,
            "speakerName": "柯莱",
            "text": "珐露珊前辈，我来告诉您一条好消息——",
            "nextDialogs": [
              "737050205"
            ]
          },
          "737050205": {
            "id": "737050205",
            "speakerId": 1051,
            "speakerName": "柯莱",
            "text": "#{NICKNAME}和派蒙加入了我们，「稳健知行」机构的队伍变得更厉害了！",
            "nextDialogs": [
              "737050206"
            ]
          },
          "737050206": {
            "id": "737050206",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "嘿嘿，珐露珊前辈好！我们来帮忙啦！",
            "nextDialogs": [
              "737050207"
            ]
          },
          "737050207": {
            "id": "737050207",
            "speakerId": 1067,
            "speakerName": "珐露珊",
            "text": "啊呀呀，这可不得了啊…",
            "nextDialogs": [
              "737050208"
            ]
          },
          "737050208": {
            "id": "737050208",
            "speakerId": 1067,
            "speakerName": "珐露珊",
            "text": "真不错，柯莱！居然请来了两位业内公认的顶尖专家，那不管我给出什么评测，协会都要乖乖点头咯！",
            "nextDialogs": [
              "737050209"
            ]
          },
          "737050209": {
            "id": "737050209",
            "speakerId": 1067,
            "speakerName": "珐露珊",
            "text": "正好，你们看看这个「解谜伙伴」，感觉怎么样？",
            "nextDialogs": [
              "737050210"
            ]
          },
          "737050210": {
            "id": "737050210",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "喔…居然直接用了珐露珊的形象？",
            "nextDialogs": [
              "737050213"
            ]
          },
          "737050213": {
            "id": "737050213",
            "speakerId": 1067,
            "speakerName": "珐露珊",
            "text": "这就要问学院的后辈们，还有解谜协会和遗迹机关研讨会的成员了。",
            "nextDialogs": [
              "737050214"
            ]
          },
          "737050214": {
            "id": "737050214",
            "speakerId": 1067,
            "speakerName": "珐露珊",
            "text": "他们通力合作的产物，明明有着相当高的技术含量，却要用孩子气的外表来包装。",
            "nextDialogs": [
              "737050215"
            ]
          },
          "737050215": {
            "id": "737050215",
            "speakerId": 1067,
            "speakerName": "珐露珊",
            "text": "尤其是后辈里的阿尼斯，一个劲地解说采用这个外观的优势，比她给课题答辩时还拼命…",
            "nextDialogs": [
              "737050245"
            ]
          },
          "737050245": {
            "id": "737050245",
            "speakerId": 1067,
            "speakerName": "珐露珊",
            "text": "当下的年轻人啊，是不是太过沉迷于可爱的东西了？",
            "nextDialogs": [
              "737050216"
            ]
          },
          "737050216": {
            "id": "737050216",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "我可以说嘛？感觉这样还挺不错的！",
            "nextDialogs": [
              "737050217"
            ]
          },
          "737050217": {
            "id": "737050217",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "柯莱和安柏刚刚还解释过，可爱的伙伴能让冒险家避免过度紧张，安安心心。",
            "nextDialogs": [
              "737050218"
            ]
          },
          "737050218": {
            "id": "737050218",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "如果和珐露珊前辈的布偶一起冒险，哪怕是走进了到处黑咕隆咚的遗迹，应该也不会紧张吧…",
            "nextDialogs": [
              "737050219"
            ]
          },
          "737050219": {
            "id": "737050219",
            "speakerId": 1067,
            "speakerName": "珐露珊",
            "text": "这种考虑确实有道理，后辈们选定这个外形，也算是对我的某种尊重吧…咳。",
            "nextDialogs": [
              "737050220"
            ]
          },
          "737050220": {
            "id": "737050220",
            "speakerId": 1067,
            "speakerName": "珐露珊",
            "text": "不过，也有相当多的冒险者，更重视机关的可靠性和技术水平。",
            "nextDialogs": [
              "737050221"
            ]
          },
          "737050221": {
            "id": "737050221",
            "speakerId": 1067,
            "speakerName": "珐露珊",
            "text": "他们大概会认为，「机关就应该表现得坚硬，要能承受落石轰击，要表现出尖端的科技水平」。",
            "nextDialogs": [
              "737050222"
            ]
          },
          "737050222": {
            "id": "737050222",
            "speakerId": 1067,
            "speakerName": "珐露珊",
            "text": "这个「解谜伙伴」的外形太蓬松柔软，反而不会给人…厉害和可靠的印象，说不定还有可能让人分心。",
            "nextDialogs": [
              "737050223"
            ]
          },
          "737050223": {
            "id": "737050223",
            "speakerId": 1067,
            "speakerName": "珐露珊",
            "text": "如果换成磨砂金属的厚重外壳，方方正正，并且适当展现复杂的机件，视觉上的鼓舞作用会更强。",
            "nextDialogs": [
              "737050224"
            ]
          },
          "737050224": {
            "id": "737050224",
            "speakerId": 1067,
            "speakerName": "珐露珊",
            "text": "哪怕是我，也有过因为外貌年轻而被人质疑的时候。假如我一头白发，他们大概就不会说闲话了。",
            "nextDialogs": [
              "737050225"
            ]
          },
          "737050225": {
            "id": "737050225",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "真，真的吗，那我岂不是能让那些人信服？",
            "nextDialogs": [
              "737050226"
            ]
          },
          "737050226": {
            "id": "737050226",
            "speakerId": 1067,
            "speakerName": "珐露珊",
            "text": "啊？这…呃…这可不能混为一谈！",
            "nextDialogs": [
              "737050227"
            ]
          },
          "737050227": {
            "id": "737050227",
            "speakerId": 1051,
            "speakerName": "柯莱",
            "text": "没想到珐露珊前辈…在这方面意外地严格呢！"
          }
        }
      }
    },
    {
      "subId": "7370503",
      "subQuestName": "前往下个项目",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "737050301"
        ],
        "dialogs": {
          "737050301": {
            "id": "737050301",
            "speakerId": 1051,
            "speakerName": "柯莱",
            "text": "接下来就是最后的项目了——为了长久发展而建立的「安全分队」。",
            "nextDialogs": [
              "737050302"
            ]
          },
          "737050302": {
            "id": "737050302",
            "speakerId": 1051,
            "speakerName": "柯莱",
            "text": "多亏大风纪官赛诺先生从中沟通，「稳健知行」机构请到了迪希雅和坎蒂丝小姐，分别担任教官与协调员。",
            "nextDialogs": [
              "737050303"
            ]
          },
          "737050303": {
            "id": "737050303",
            "speakerId": 1051,
            "speakerName": "柯莱",
            "text": "她们两位正在筹备战斗考核的事宜，应该也快回来了…",
            "nextDialogs": [
              "737050304"
            ]
          },
          "737050304": {
            "id": "737050304",
            "speakerId": 1052,
            "speakerName": "迪希雅",
            "text": "哟，在找我们？看来我们出现得正是时候？",
            "nextDialogs": [
              "737050305"
            ]
          },
          "737050305": {
            "id": "737050305",
            "speakerId": 1052,
            "speakerName": "迪希雅",
            "text": "#{NICKNAME}和派蒙也要入伙吗？那事情就变得轻松愉快了！",
            "nextDialogs": [
              "737050306"
            ]
          },
          "737050306": {
            "id": "737050306",
            "speakerId": 1059,
            "speakerName": "坎蒂丝",
            "text": "久等了，几位，我们带回了合适的情报。",
            "nextDialogs": [
              "737050307"
            ]
          },
          "737050307": {
            "id": "737050307",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "收集情报？这么正经？",
            "nextDialogs": [
              "737050310"
            ]
          },
          "737050310": {
            "id": "737050310",
            "speakerId": 1052,
            "speakerName": "迪希雅",
            "text": "那可不，毕竟是关乎普通学生安全的大事，不把沙漠里的危险分子犁个干净，说不过去吧？",
            "nextDialogs": [
              "737050311"
            ]
          },
          "737050311": {
            "id": "737050311",
            "speakerId": 1059,
            "speakerName": "坎蒂丝",
            "text": "玩笑先放一边吧，迪希雅。",
            "nextDialogs": [
              "737050312"
            ]
          },
          "737050312": {
            "id": "737050312",
            "speakerId": 1059,
            "speakerName": "坎蒂丝",
            "text": "#说不定{NICKNAME}听了你的话，会认真地拔剑出击，从这里打到沙漠尽头…",
            "nextDialogs": [
              "737050313"
            ]
          },
          "737050313": {
            "id": "737050313",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "#把所有危险分子都干掉…以{NICKNAME}的效率，得在沙漠里住上好几年，每天从日出工作到日落才行吧？",
            "nextDialogs": [
              "737050314"
            ]
          },
          "737050314": {
            "id": "737050314",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "旅行也得停下来，完全不敢想…",
            "nextDialogs": [
              "737050315"
            ]
          },
          "737050315": {
            "id": "737050315",
            "speakerId": 1051,
            "speakerName": "柯莱",
            "text": "时间是最简单的问题，很多危险都没法直接用肉眼确认，比如隐藏在地下的毒蝎，睡在树上的恐怖大怪鸟。",
            "nextDialogs": [
              "737050316"
            ]
          },
          "737050316": {
            "id": "737050316",
            "speakerId": 1051,
            "speakerName": "柯莱",
            "text": "只有到了它们跳出来拦住去路的时候，才有可能和它们正面过招。",
            "nextDialogs": [
              "737050317"
            ]
          },
          "737050317": {
            "id": "737050317",
            "speakerId": 1051,
            "speakerName": "柯莱",
            "text": "这种时候，应该按照珐露珊前辈的叮嘱，结合安柏的侦察思路，好好算一算接敌概率，和行动时间的综合期望…",
            "nextDialogs": [
              "737050318"
            ]
          },
          "737050318": {
            "id": "737050318",
            "speakerId": 1052,
            "speakerName": "迪希雅",
            "text": "喂喂，你们两个还真开始盘算了啊！",
            "nextDialogs": [
              "737050319"
            ]
          },
          "737050319": {
            "id": "737050319",
            "speakerId": 1059,
            "speakerName": "坎蒂丝",
            "text": "其实远没有那么夸张，「安全分队」的职责，是确保外出考察的学生队伍中，有着可靠的随行护卫。",
            "nextDialogs": [
              "737050320"
            ]
          },
          "737050320": {
            "id": "737050320",
            "speakerId": 1059,
            "speakerName": "坎蒂丝",
            "text": "这份差事一部分包给了「炽光猎兽」与合作佣兵，一部分由考察队伍中经过战斗考核的强者自行承接。",
            "nextDialogs": [
              "737050321"
            ]
          },
          "737050321": {
            "id": "737050321",
            "speakerId": 1059,
            "speakerName": "坎蒂丝",
            "text": "考察队伍准备前往危险地带前，必须在队伍中编入至少两名通过了战斗考核的专业人员。",
            "nextDialogs": [
              "737050322"
            ]
          },
          "737050322": {
            "id": "737050322",
            "speakerId": 1059,
            "speakerName": "坎蒂丝",
            "text": "而我和迪希雅刚刚收集好的情报，就关乎战斗考核的场地。",
            "nextDialogs": [
              "737050323"
            ]
          },
          "737050323": {
            "id": "737050323",
            "speakerId": 1052,
            "speakerName": "迪希雅",
            "text": "嘿，找到了一座魔物和贼匪盘踞的秘境，各种水平的坏家伙管够，正好借他们脑袋一用，验证护卫们的本领。",
            "nextDialogs": [
              "737050324"
            ]
          },
          "737050324": {
            "id": "737050324",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "这么听起来，只要监督考核的过程就可以了？其实是考官！",
            "nextDialogs": [
              "737050325"
            ]
          },
          "737050325": {
            "id": "737050325",
            "speakerId": 1059,
            "speakerName": "坎蒂丝",
            "text": "请放心，我和迪希雅会安排可靠人士轮岗，保证参加者的人身安全。",
            "nextDialogs": [
              "737050326"
            ]
          },
          "737050326": {
            "id": "737050326",
            "speakerId": 1052,
            "speakerName": "迪希雅",
            "text": "目前还有个没解决的问题——考核的标准。毕竟，战斗不是做题，没有唯一的解法。",
            "nextDialogs": [
              "737050327"
            ]
          },
          "737050327": {
            "id": "737050327",
            "speakerId": 1052,
            "speakerName": "迪希雅",
            "text": "我们每个佣兵都有自己习惯的战斗风格，实战完全不成问题，可要当教官的话，路子略微有点一成不变…",
            "nextDialogs": [
              "737050328"
            ]
          },
          "737050328": {
            "id": "737050328",
            "speakerId": 1052,
            "speakerName": "迪希雅",
            "text": "所以需要一位见多识广、战斗思维灵活的专家，来给出一份可供参考的理想答卷。"
          }
        }
      }
    },
    {
      "subId": "7370507",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "737050701"
        ],
        "dialogs": {
          "737050701": {
            "id": "737050701",
            "speakerId": 1067,
            "speakerName": "珐露珊",
            "text": "要不然，还是不改了？"
          }
        }
      }
    },
    {
      "subId": "7370508",
      "subQuestName": "Additional",

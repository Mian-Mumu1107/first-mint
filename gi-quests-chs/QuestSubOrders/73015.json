    {
      "subId": "7301503",
      "subQuestName": "与兰那库拉对话",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "730150301"
        ],
        "dialogs": {
          "730150301": {
            "id": "730150301",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "你一定就是兰那库拉了吧！",
            "nextDialogs": [
              "730150302"
            ]
          },
          "730150302": {
            "id": "730150302",
            "speakerId": 4189,
            "speakerName": "兰那库拉",
            "text": "呜哇！被、被那菈发现了！该、该怎么办…",
            "nextDialogs": [
              "730150303"
            ]
          },
          "730150303": {
            "id": "730150303",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "你先别逃跑！是兰般度告诉我们你在这里的！",
            "nextDialogs": [
              "730150304"
            ]
          },
          "730150304": {
            "id": "730150304",
            "speakerId": 4189,
            "speakerName": "兰那库拉",
            "text": "既、既然是兰般度告诉你们的，那一定是好那菈了。",
            "nextDialogs": [
              "730150305"
            ]
          },
          "730150305": {
            "id": "730150305",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "#嗯？兰那库拉是不是太轻信了？万一{NICKNAME}是坏那菈，用兰般度的名字来骗你…",
            "nextDialogs": [
              "730150306"
            ]
          },
          "730150306": {
            "id": "730150306",
            "speakerId": 4189,
            "speakerName": "兰那库拉",
            "text": "呀！那、那金色的那菈，其实是在骗兰那库拉？金色的那菈，其实是坏那菈？",
            "nextDialogs": [
              "730150307"
            ]
          },
          "730150307": {
            "id": "730150307",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "感觉突然涌出了罪恶感…",
            "nextDialogs": [
              "730150308"
            ]
          },
          "730150308": {
            "id": "730150308",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "别听派蒙的，我是好那菈。",
            "nextDialogs": [
              "730150309"
            ]
          },
          "730150309": {
            "id": "730150309",
            "speakerId": 4189,
            "speakerName": "兰那库拉",
            "text": "#太好了，感谢兰穆护昆达，金色的那菈果然是好那菈。虽然那菈{NICKNAME}比兰那库拉高很多，但是不害怕。",
            "nextDialogs": [
              "730150310"
            ]
          },
          "730150310": {
            "id": "730150310",
            "speakerId": 4189,
            "speakerName": "兰那库拉",
            "text": "派蒙…派蒙小只，也不害怕。",
            "nextDialogs": [
              "730150311"
            ]
          },
          "730150311": {
            "id": "730150311",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "喂！",
            "nextDialogs": [
              "730150313",
              "730150315"
            ]
          },
          "730150313": {
            "id": "730150313",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "小瞧我可是要吃大亏的！哼！",
            "nextDialogs": [
              "730150316"
            ]
          },
          "730150316": {
            "id": "730150316",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "不过说回正事，我们是来治好法留纳神机的，这片「桓那」应该也有法留纳神机的「枝」和「叶」？",
            "nextDialogs": [
              "730150317"
            ]
          },
          "730150317": {
            "id": "730150317",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "兰般度让我们来看看情况，如果你遇到了困难，也好帮帮你。",
            "nextDialogs": [
              "730150318"
            ]
          },
          "730150318": {
            "id": "730150318",
            "speakerId": 4189,
            "speakerName": "兰那库拉",
            "text": "啊！很多坏家伙在桓那…有安全的路，但是要小心。而且到处都是坏种子，就连为了那菈法留纳而造的…呜呜…",
            "nextDialogs": [
              "730150319"
            ]
          },
          "730150319": {
            "id": "730150319",
            "speakerId": 4189,
            "speakerName": "兰那库拉",
            "text": "#那菈{NICKNAME}又高又大，说不定和兰百梨迦一样强…那菈{NICKNAME}，说不定有办法…",
            "nextDialogs": [
              "730150320"
            ]
          },
          "730150320": {
            "id": "730150320",
            "speakerId": 4189,
            "speakerName": "兰那库拉",
            "text": "#…那菈{NICKNAME}，说不定能够帮忙。",
            "nextDialogs": [
              "730150321"
            ]
          },
          "730150321": {
            "id": "730150321",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "#我们本来就是来帮忙的呀，对吧，{NICKNAME}。",
            "nextDialogs": [
              "730150322"
            ]
          },
          "730150322": {
            "id": "730150322",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "交给我们吧。",
            "nextDialogs": [
              "730150323"
            ]
          },
          "730150323": {
            "id": "730150323",
            "speakerId": 4189,
            "speakerName": "兰那库拉",
            "text": "兰那库拉有别的请求，在治好法留纳神机以前…想要先去找回石头的记忆。",
            "nextDialogs": [
              "730150324"
            ]
          },
          "730150324": {
            "id": "730150324",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "…「石头的记忆」？",
            "nextDialogs": [
              "730150325"
            ]
          },
          "730150325": {
            "id": "730150325",
            "speakerId": 4189,
            "speakerName": "兰那库拉",
            "text": "桓那不会忘记，兰那罗不会忘记，但是兰那罗留下看得到的记忆。坏家伙来了以后，四处都是坏种子…",
            "nextDialogs": [
              "730150326"
            ]
          },
          "730150326": {
            "id": "730150326",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "和兰那罗说话就像猜谜一样呢…不过，实际见到之后应该就明白了吧。",
            "nextDialogs": [
              "730150327"
            ]
          },
          "730150327": {
            "id": "730150327",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "总之，我们先和兰那库拉一起过去吧！",
            "nextDialogs": [
              "730150328"
            ]
          },
          "730150328": {
            "id": "730150328",
            "speakerId": 4189,
            "speakerName": "兰那库拉",
            "text": "好那菈，好派蒙！我们不要惊动坏家伙，有安全的路。",
            "nextDialogs": [
              "730150329"
            ]
          },
          "730150329": {
            "id": "730150329",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "欸？兰那库拉说的「坏家伙」应该就是蕈兽吧，那完全不用担心呀！",
            "nextDialogs": [
              "730150330"
            ]
          },
          "730150330": {
            "id": "730150330",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "#哼哼，兰那库拉，你听好了，那菈{NICKNAME}可是很强的！",
            "nextDialogs": [
              "730150331"
            ]
          },
          "730150331": {
            "id": "730150331",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "而且不是一般的强！是非——常——强！",
            "nextDialogs": [
              "730150332"
            ]
          },
          "730150332": {
            "id": "730150332",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "我们之前已经和兰般度一起打败了好多蕈兽呢！就连兰般度也认可了我们的实力！",
            "nextDialogs": [
              "730150333"
            ]
          },
          "730150333": {
            "id": "730150333",
            "speakerId": 4189,
            "speakerName": "兰那库拉",
            "text": "#知道了，那菈{NICKNAME}一定和兰百梨迦一样厉害。可是派蒙呢？",
            "nextDialogs": [
              "730150334"
            ]
          },
          "730150334": {
            "id": "730150334",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "我？我怎么了？",
            "nextDialogs": [
              "730150335"
            ]
          },
          "730150335": {
            "id": "730150335",
            "speakerId": 4189,
            "speakerName": "兰那库拉",
            "text": "发生过这样的事…兰那库拉被坏家伙追赶，钻进了土里，但是被刨出来…",
            "nextDialogs": [
              "730150336"
            ]
          },
          "730150336": {
            "id": "730150336",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "欸…",
            "nextDialogs": [
              "730150337"
            ]
          },
          "730150337": {
            "id": "730150337",
            "speakerId": 4189,
            "speakerName": "兰那库拉",
            "text": "坏家伙的大口里滴出来，湿的、热的，还有果实坏掉的味道…",
            "nextDialogs": [
              "730150338"
            ]
          },
          "730150338": {
            "id": "730150338",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "呜哇…",
            "nextDialogs": [
              "730150339"
            ]
          },
          "730150339": {
            "id": "730150339",
            "speakerId": 4189,
            "speakerName": "兰那库拉",
            "text": "要不是兰百梨迦及时赶到，兰那库拉就…",
            "nextDialogs": [
              "730150340"
            ]
          },
          "730150340": {
            "id": "730150340",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "呜呜…",
            "nextDialogs": [
              "730150341"
            ]
          },
          "730150341": {
            "id": "730150341",
            "speakerId": 4189,
            "speakerName": "兰那库拉",
            "text": "之后兰般度说教了很久，太阳下去又上来，就连苗圃里种下的种子都已经发芽。",
            "nextDialogs": [
              "730150342"
            ]
          },
          "730150342": {
            "id": "730150342",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "…这说教也太久了吧！",
            "nextDialogs": [
              "730150343"
            ]
          },
          "730150343": {
            "id": "730150343",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "可是这跟派蒙有什么关系？",
            "nextDialogs": [
              "730150344"
            ]
          },
          "730150344": {
            "id": "730150344",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "对呀对呀，这和派蒙有什么关系呢？",
            "nextDialogs": [
              "730150345"
            ]
          },
          "730150345": {
            "id": "730150345",
            "speakerId": 4189,
            "speakerName": "兰那库拉",
            "text": "兰那库拉比派蒙厉害，却差点被坏家伙吃掉。派…派蒙这么小只，太危险了！",
            "nextDialogs": [
              "730150346"
            ]
          },
          "730150346": {
            "id": "730150346",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "#好、好像有点道理？不对！{NICKNAME}厉害，一定会保护派蒙的啦，对吧？"
          },
          "730150315": {
            "id": "730150315",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "说得对！派蒙可是很厉害的！"
          }
        }
      }
    },

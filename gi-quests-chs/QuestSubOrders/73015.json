    {
      "subId": "7301509",
      "subQuestName": "与兰那库拉对话",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "730150901"
        ],
        "dialogs": {
          "730150901": {
            "id": "730150901",
            "speakerId": 4189,
            "speakerName": "兰那库拉",
            "text": "#那菈{NICKNAME}，这是兰那罗为那菈法留纳留下的石头的记忆。",
            "nextDialogs": [
              "730150902"
            ]
          },
          "730150902": {
            "id": "730150902",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "总算到了…为了不被蕈兽发现，一路上小心翼翼提心吊胆…",
            "nextDialogs": [
              "730150904",
              "730150906"
            ]
          },
          "730150904": {
            "id": "730150904",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "话是这么说…",
            "nextDialogs": [
              "730150907"
            ]
          },
          "730150907": {
            "id": "730150907",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "唔…不过，这就是「石头的记忆」吗？看起来像是兰那罗搭建的石碑…",
            "nextDialogs": [
              "730150908"
            ]
          },
          "730150908": {
            "id": "730150908",
            "speakerId": 4189,
            "speakerName": "兰那库拉",
            "text": "#那菈{NICKNAME}…",
            "nextDialogs": [
              "730150909"
            ]
          },
          "730150909": {
            "id": "730150909",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "我来清理坏种子。",
            "nextDialogs": [
              "730150910"
            ]
          },
          "730150910": {
            "id": "730150910",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "#兰那库拉不用太担心啦，这点小事交给那菈{NICKNAME}，一定是不费吹灰之力！"
          },
          "730150906": {
            "id": "730150906",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "？"
          }
        }
      }
    },
    {
      "subId": "7301510",
      "subQuestName": "清除覆盖石头的孢子",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "730151001"
        ],
        "dialogs": {
          "730151001": {
            "id": "730151001",
            "speakerId": 4189,
            "speakerName": "兰那库拉",
            "text": "#很坏的种子，必须全都清理掉…那菈{NICKNAME}…"
          }
        }
      }

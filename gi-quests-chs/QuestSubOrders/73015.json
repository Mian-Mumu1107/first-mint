    {
      "subId": "7301521",
      "subQuestName": "在不被发现的情况下前进",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "730152101"
        ],
        "dialogs": {
          "730152101": {
            "id": "730152101",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "兰那罗这么小，遇到体型比自己大好多倍的蕈兽，会害怕也不奇怪呢。",
            "nextDialogs": [
              "730152102"
            ]
          },
          "730152102": {
            "id": "730152102",
            "speakerId": 4189,
            "speakerName": "兰那库拉",
            "text": "派蒙不会害怕吗？",
            "nextDialogs": [
              "730152103"
            ]
          },
          "730152103": {
            "id": "730152103",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "我？我当然不怕啦！",
            "nextDialogs": [
              "730152104"
            ]
          },
          "730152104": {
            "id": "730152104",
            "speakerId": 4189,
            "speakerName": "兰那库拉",
            "text": "呜…兰那库拉明明比派蒙厉害，但是却没有派蒙那么勇敢，如果又遇到蕈兽袭击，肯定会躲到<color=#00E1FFFF>安全的地方</color>…"
          }
        }
      }
    },

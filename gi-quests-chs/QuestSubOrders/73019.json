        ],
        "dialogs": {
          "730190701": {
            "id": "730190701",
            "speakerId": 1002,
            "speakerName": "兰萨卡",
            "text": "只、只要回去把这道「至上珍馐」给他们品尝，他们就会明白什么是「开心的味道」了。",
            "nextDialogs": [
              "730190702"
            ]
          },
          "730190702": {
            "id": "730190702",
            "speakerId": 1002,
            "speakerName": "兰萨卡",
            "text": "兰帕卡提，一定也会喜欢的…"
          }
        }
      }
    },
    {
      "subId": "7301908",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "730190801"
        ],
        "dialogs": {
          "730190801": {
            "id": "730190801",
            "speakerId": 1002,
            "speakerName": "兰萨卡",
            "text": "那菈，坏！不许…不许摘我种的墩墩桃！"
          }
        }
      }
    },
    {
      "subId": "7301909",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "730190901"
        ],
        "dialogs": {
          "730190901": {
            "id": "730190901",
            "speakerId": 1002,
            "speakerName": "兰萨卡",
            "text": "都说了不许摘，那、那可是为了「开心的味道」准备的！"
          }
        }
      }
    },
    {
      "subId": "7301910",

  "subQuests": [
    {
      "subId": "7304929",
      "subQuestName": "",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "730492901"
        ],
        "dialogs": {
          "730492901": {
            "id": "730492901",
            "speakerId": 1000,
            "speakerName": "鲁克沙",
            "text": "这次真是多谢你们了…",
            "nextDialogs": [
              "730492902"
            ]
          },
          "730492902": {
            "id": "730492902",
            "speakerId": 1000,
            "speakerName": "鲁克沙",
            "text": "对了，如果有卡西姆的行踪，也欢迎你们告诉我。"
          }
        }
      }
    },
    {
      "subId": "7304903",
      "subQuestName": "",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "730490317"
        ],
        "dialogs": {
          "730490317": {
            "id": "730490317",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "#嘘，{NICKNAME}，你看那边！有一个镀金旅团的和…一个愚人众！",
            "nextDialogs": [
              "730490301"
            ]
          },
          "730490301": {
            "id": "730490301",
            "speakerId": 1002,
            "speakerName": "？？？",
            "text": "卡西姆…这些桑格吉拉光机运作情况怎么样？",
            "nextDialogs": [
              "730490302"
            ]
          },
          "730490302": {
            "id": "730490302",
            "speakerId": 1003,
            "speakerName": "卡西姆",
            "text": "情况良好，奥列格…",
            "nextDialogs": [
              "730490303"
            ]
          },
          "730490303": {
            "id": "730490303",
            "speakerId": 1003,
            "speakerName": "卡西姆",
            "text": "这就是这次的结果报告，按现在的情况进行下去…不用多长时间就能提取到你们愚人众想要的东西…",
            "nextDialogs": [
              "730490304"
            ]
          },
          "730490304": {
            "id": "730490304",
            "speakerId": 1004,
            "speakerName": "奥列格",
            "text": "好啊，哈哈哈，有你的帮助，一定能够在最短的时间内完成执行官大人的命令。",
            "nextDialogs": [
              "730490305"
            ]
          },
          "730490305": {
            "id": "730490305",
            "speakerId": 1004,
            "speakerName": "奥列格",
            "text": "不过，如果你胆敢骗我…你自己知道后果！",
            "nextDialogs": [
              "730490306"
            ]
          },
          "730490306": {
            "id": "730490306",
            "speakerId": 1003,
            "speakerName": "卡西姆",
            "text": "骗你对我有什么好处？",
            "nextDialogs": [
              "730490307"
            ]
          },
          "730490307": {
            "id": "730490307",
            "speakerId": 1004,
            "speakerName": "奥列格",
            "text": "你清楚就好。",
            "nextDialogs": [
              "730490308"
            ]
          },
          "730490308": {
            "id": "730490308",
            "speakerId": 1004,
            "speakerName": "奥列格",
            "text": "嘿，那个特洛芬·雪奈茨维奇…办事不力，在这里好几年都毫无建树，我这么快就拿出成果，到时候，看他还有什么狡辩的话说…",
            "nextDialogs": [
              "730490309"
            ]
          },
          "730490309": {
            "id": "730490309",
            "speakerId": 1003,
            "speakerName": "卡西姆",
            "text": "特洛芬·雪奈茨维奇…我在须弥可没听过这个名字…",
            "nextDialogs": [
              "730490310"
            ]
          },
          "730490310": {
            "id": "730490310",
            "speakerId": 1004,
            "speakerName": "奥列格",
            "text": "哈哈那是当然，他怎么可能用这个名字，岂不是一下就暴露了…执行官大人交给他的任务，几年了，一点进展也没有。",
            "nextDialogs": [
              "730490311"
            ]
          },
          "730490311": {
            "id": "730490311",
            "speakerId": 1004,
            "speakerName": "奥列格",
            "text": "…不对，谁，谁在那里？你是怎么到这儿来的？",
            "nextDialogs": [
              "730490312"
            ]
          },
          "730490312": {
            "id": "730490312",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "#呜哇，{NICKNAME}，被发现了！",
            "nextDialogs": [
              "730490313"
            ]
          },
          "730490313": {
            "id": "730490313",
            "speakerId": 1003,
            "speakerName": "卡西姆",
            "text": "…我也该走了。",
            "nextDialogs": [
              "730490314"
            ]
          },
          "730490314": {
            "id": "730490314",
            "speakerId": 1003,
            "speakerName": "卡西姆",
            "text": "呵，愚人众，不会被区区一个误入此地的冒险家击败吧。",
            "nextDialogs": [
              "730490315"
            ]
          },
          "730490315": {
            "id": "730490315",
            "speakerId": 1004,
            "speakerName": "奥列格",
            "text": "这还用不着镀金旅团的人操心…哼，等我先把这个偷跑进来的老鼠消灭了，再去说好的实验营地找你！",
            "nextDialogs": [
              "730490316"
            ]
          },
          "730490316": {
            "id": "730490316",
            "speakerId": 1005,
            "speakerName": "Black Screen",
            "text": "卡西姆离开了…"
          }
        }
      }
    },
    {
      "subId": "7304904",
      "subQuestName": "与奥列格战斗",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [],
        "dialogs": {}
      }
    },
    {
      "subId": "7304905",
      "subQuestName": "与奥列格对话",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "730490501"
        ],
        "dialogs": {
          "730490501": {
            "id": "730490501",
            "speakerId": 1004,
            "speakerName": "奥列格",
            "text": "要不是为了重新占领营地没有好好休息…哼，我之后再找你们算账！",
            "nextDialogs": [
              "730490502"
            ]
          },
          "730490502": {
            "id": "730490502",
            "speakerId": 1005,
            "speakerName": "Black Screen",
            "text": "奥列格趁乱逃跑了…",
            "nextDialogs": [
              "730490503"
            ]
          },
          "730490503": {
            "id": "730490503",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "哇，没想到跑得还是挺快的，一溜烟人就没影了…",
            "nextDialogs": [
              "730490504"
            ]
          },
          "730490504": {
            "id": "730490504",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "不过他刚才掉下来的这个是…「紧急调整计划书」？",
            "nextDialogs": [
              "730490505"
            ]
          },
          "730490505": {
            "id": "730490505",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "我看看上面写了什么…",
            "nextDialogs": [
              "730490506"
            ]
          },
          "730490506": {
            "id": "730490506",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "「关于桑格吉拉光机一事，乃至冬国在须弥研究极为重要的一环，绝不容许有失…近来实验营地连番遭人攻破，致使光机停运…」",
            "nextDialogs": [
              "730490507"
            ]
          },
          "730490507": {
            "id": "730490507",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "是嘛，居然有人连番攻破了他们的营地，真不知道是哪里来的好心人！",
            "nextDialogs": [
              "730490510"
            ]
          },
          "730490510": {
            "id": "730490510",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "嘿嘿，对哦…然后呢，「须重新夺回实验营地，今日将加强巡逻…<color=#00E1FFFF>按此图所标营地之顺序</color>，依次进行检查…」",
            "nextDialogs": [
              "730490511"
            ]
          },
          "730490511": {
            "id": "730490511",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "从这张图上看来，我们所在的营地就是巡逻的起点。",
            "nextDialogs": [
              "730490512"
            ]
          },
          "730490512": {
            "id": "730490512",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "也就是说，他们必须占回来的就是这四个营地吧！没想到镀金旅团居然会和愚人众搭上线呢…",
            "nextDialogs": [
              "730490513"
            ]
          },
          "730490513": {
            "id": "730490513",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "唔…最后是「立即自行动据点出发，执行上述计划。」他们居然还有一个行动据点…",
            "nextDialogs": [
              "730490514"
            ]
          },
          "730490514": {
            "id": "730490514",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "哼，要是让我们知道这个行动据点在哪里…",
            "nextDialogs": [
              "730490515"
            ]
          },
          "730490515": {
            "id": "730490515",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "就把他们一锅端了！",
            "nextDialogs": [
              "730490516"
            ]
          },
          "730490516": {
            "id": "730490516",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "嗯！现在就按照图上标注的营地顺序走一趟吧，一定能在那边抓住愚人众！"
          }
        }
      }
    },

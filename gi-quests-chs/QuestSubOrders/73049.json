    {
      "subId": "7304916",
      "subQuestName": "与卡西姆对话",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "730491601"
        ],
        "dialogs": {
          "730491601": {
            "id": "730491601",
            "speakerId": 1003,
            "speakerName": "卡西姆",
            "text": "痛痛痛痛痛，哎呦呦，别打了，别打了…住手住手！",
            "nextDialogs": [
              "730491602"
            ]
          },
          "730491602": {
            "id": "730491602",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "你真的是什么传说大盗吗…",
            "nextDialogs": [
              "730491603"
            ]
          },
          "730491603": {
            "id": "730491603",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "未免太弱了一些...",
            "nextDialogs": [
              "730491604"
            ]
          },
          "730491604": {
            "id": "730491604",
            "speakerId": 1003,
            "speakerName": "卡西姆",
            "text": "所谓的大盗，有的时候靠的并不是个人的武力...",
            "nextDialogs": [
              "730491605"
            ]
          },
          "730491605": {
            "id": "730491605",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "哼，油嘴滑舌的，看来我们得好好盘问他！"
          }
        }
      }
    },
    {
      "subId": "7304917",
      "subQuestName": "盘问卡西姆",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "730491701"
        ],
        "dialogs": {
          "730491701": {
            "id": "730491701",
            "speakerId": 1003,
            "speakerName": "卡西姆",
            "text": "你们问，你们问，我一定知无不言，言无不尽，嘿嘿…",
            "nextDialogs": [
              "730491702"
            ]
          },
          "730491702": {
            "id": "730491702",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "你真的是镀金旅团的大盗贼吗？",
            "nextDialogs": [
              "730491703"
            ]
          },
          "730491703": {
            "id": "730491703",
            "speakerId": 1003,
            "speakerName": "卡西姆",
            "text": "那当然了…",
            "nextDialogs": [
              "730491705",
              "730491707"
            ]
          },
          "730491705": {
            "id": "730491705",
            "speakerId": 1003,
            "speakerName": "卡西姆",
            "text": "毕竟是镀金旅团嘛，来自各处的，可是什么人都有啊，哈哈!",
            "nextDialogs": [
              "730491709"
            ]
          },
          "730491709": {
            "id": "730491709",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "说起来，到底愚人众是怎么找到你的呀！",
            "nextDialogs": [
              "730491710"
            ]
          },
          "730491710": {
            "id": "730491710",
            "speakerId": 1003,
            "speakerName": "卡西姆",
            "text": "当然是因为我在镀金旅团闯下的赫赫声名…"
          },
          "730491707": {
            "id": "730491707",
            "speakerId": 1003,
            "speakerName": "卡西姆",
            "text": "哎，别什么都扯上三十人团嘛，有话好说有话好说…唉，好吧，「大盗卡西姆」只是一个「艺名」，总要有幌子才能骗到人嘛…",
            "nextDialogs": [
              "730491708"
            ]
          },
          "730491708": {
            "id": "730491708",
            "speakerId": 1003,
            "speakerName": "卡西姆",
            "text": "像这次，愚人众就上了我的当…"
          }
        }
      }
    },
    {
      "subId": "7304927",
      "subQuestName": "",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "730492701"
        ],
        "dialogs": {
          "730492701": {
            "id": "730492701",
            "speakerId": 1003,
            "speakerName": "卡西姆",
            "text": "唉，事到如今也没什么好瞒着你们的啦…最近一直给他们编造出来的实验结果，他们好像也多少有点起疑心了…",
            "nextDialogs": [
              "730492702"
            ]
          },
          "730492702": {
            "id": "730492702",
            "speakerId": 1003,
            "speakerName": "卡西姆",
            "text": "我告诉你们据点在哪，你们把他们抓住吧，这样我编造假结果的事，愚人众就再也发现不了了…",
            "nextDialogs": [
              "730492703"
            ]
          },
          "730492703": {
            "id": "730492703",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "哇，这个人真是一肚子坏水，愚人众跟他合作，真是倒了大霉了！",
            "nextDialogs": [
              "730492704"
            ]
          },
          "730492704": {
            "id": "730492704",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "不过姑且还是听他说说…",
            "nextDialogs": [
              "730492705"
            ]
          },
          "730492705": {
            "id": "730492705",
            "speakerId": 1003,
            "speakerName": "卡西姆",
            "text": "在水天丛林山上的帐篷附近，有四个火把。在夜晚点亮火把…",
            "nextDialogs": [
              "730492706"
            ]
          },
          "730492706": {
            "id": "730492706",
            "speakerId": 1003,
            "speakerName": "卡西姆",
            "text": "这样，愚人众就会用信号灯映照山上营地，你要是看见附近山崖上的闪光点…",
            "nextDialogs": [
              "730492707"
            ]
          },
          "730492707": {
            "id": "730492707",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "就说明愚人众行动据点就在那里了吧！这办法听上去还挺神奇的…",
            "nextDialogs": [
              "730492708"
            ]
          },
          "730492708": {
            "id": "730492708",
            "speakerId": 1003,
            "speakerName": "卡西姆",
            "text": "对，到时候愚人众就会隔着门跟你对暗号，暗号说对了才会放你进去…",
            "nextDialogs": [
              "730492709"
            ]
          },
          "730492709": {
            "id": "730492709",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "还有暗号！",
            "nextDialogs": [
              "730492710"
            ]
          },
          "730492710": {
            "id": "730492710",
            "speakerId": 1003,
            "speakerName": "卡西姆",
            "text": "对，我想想，上半句是这样的，「不要带着自己的规则手册…」",
            "nextDialogs": [
              "730492711"
            ]
          },
          "730492711": {
            "id": "730492711",
            "speakerId": 1003,
            "speakerName": "卡西姆",
            "text": "下半句则是，「去别人的地盘。」",
            "nextDialogs": [
              "730492712"
            ]
          },
          "730492712": {
            "id": "730492712",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "哇，真希望愚人众能够做到自己暗号里说的事啊…",
            "nextDialogs": [
              "730492713"
            ]
          },
          "730492713": {
            "id": "730492713",
            "speakerId": 1003,
            "speakerName": "卡西姆",
            "text": "来，试一次，「不要带着自己的规则手册…」",
            "nextDialogs": [
              "730492714"
            ]
          },
          "730492714": {
            "id": "730492714",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "「去别人的地盘。」",
            "nextDialogs": [
              "730492715"
            ]
          },
          "730492715": {
            "id": "730492715",
            "speakerId": 1003,
            "speakerName": "卡西姆",
            "text": "好，去吧！就算是为了我不暴露，也得把他们全部抓起来啊！",
            "nextDialogs": [
              "730492716"
            ]
          },
          "730492716": {
            "id": "730492716",
            "speakerId": 1003,
            "speakerName": "卡西姆",
            "text": "嘿嘿，你看，这么紧要的情报我都告诉你们了，不知道你们愿不愿意，就是…高抬贵手…",
            "nextDialogs": [
              "730492717"
            ]
          },
          "730492717": {
            "id": "730492717",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "哼，以后可不许再做坏事了！要是下次遇见你又在搞什么阴谋诡计…我们就把你送到三十人团手上！",
            "nextDialogs": [
              "730492718"
            ]
          },
          "730492718": {
            "id": "730492718",
            "speakerId": 1003,
            "speakerName": "卡西姆",
            "text": "再也不敢了，有二位在须弥，我可是一千万个不敢，绝不做坏事了，所以就饶了我这一回吧！",
            "nextDialogs": [
              "730492719"
            ]
          },
          "730492719": {
            "id": "730492719",
            "speakerId": 1003,
            "speakerName": "卡西姆",
            "text": "嘿嘿，那我就先走了，祝两位旗开得胜啊！",
            "nextDialogs": [
              "730492720"
            ]
          },
          "730492720": {
            "id": "730492720",
            "speakerId": 1005,
            "speakerName": "Black Screen",
            "text": "卡西姆狼狈地离开了…",
            "nextDialogs": [
              "730492721"
            ]
          },
          "730492721": {
            "id": "730492721",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "嗯…虽然总觉得应该先把这个家伙交给治安官…",
            "nextDialogs": [
              "730492722"
            ]
          },
          "730492722": {
            "id": "730492722",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "不过还是先去解决愚人众吧。"
          }
        }
      }
    },
    {
      "subId": "7304928",
      "subQuestName": "",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "730492801"
        ],
        "dialogs": {
          "730492801": {
            "id": "730492801",
            "speakerId": 1003,
            "speakerName": "卡西姆",
            "text": "愚人众行动据点的位置…哎呀，据点的位置那当然是知道的…就在…",
            "nextDialogs": [
              "730492802"
            ]
          },
          "730492802": {
            "id": "730492802",
            "speakerId": 1003,
            "speakerName": "卡西姆",
            "text": "…对了，你们看到那边的山了吗？",
            "nextDialogs": [
              "730492803"
            ]
          },
          "730492803": {
            "id": "730492803",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "那边的山，难道愚人众的行动据点就在那里？",
            "nextDialogs": [
              "730492804"
            ]
          },
          "730492804": {
            "id": "730492804",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "那边看上去什么都没有啊…卡西姆，咦卡西姆人呢？",
            "nextDialogs": [
              "730492805"
            ]
          },
          "730492805": {
            "id": "730492805",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "看来是趁机开溜啦！",
            "nextDialogs": [
              "730492806"
            ]
          },
          "730492806": {
            "id": "730492806",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "呜哇，真是卑鄙！",
            "nextDialogs": [
              "730492808"
            ]
          },
          "730492808": {
            "id": "730492808",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "明明很快就能问到关键的情报了！",
            "nextDialogs": [
              "730492809"
            ]
          },
          "730492809": {
            "id": "730492809",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "不过卡西姆和愚人众原本是要在这里见面…说不定这周围会有什么线索…",
            "nextDialogs": [
              "730492810"
            ]
          },
          "730492810": {
            "id": "730492810",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "我们先在这个营地里找一找吧！"
          }
        }
      }
    },
    {
      "subId": "7304920",
      "subQuestName": "在营地里寻找愚人众据点的线索",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "687220101"
        ],
        "dialogs": {
          "687220101": {
            "id": "687220101",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "快看，这里有一本《与愚人众秘密联络指南》…不知道有没有和愚人众行动据点相关的线索…",
            "nextDialogs": [
              "687220102"
            ]
          },
          "687220102": {
            "id": "687220102",
            "speakerId": 1006,
            "speakerName": "《与愚人众秘密联络指南》",
            "text": "「夜晚，至水天丛林山上的帐篷附近，点亮四个火把…」",
            "nextDialogs": [
              "687220103"
            ]
          },
          "687220103": {
            "id": "687220103",
            "speakerId": 1006,
            "speakerName": "《与愚人众秘密联络指南》",
            "text": "「其后，前往信号灯打来之处，即为据点之所在…」哇，原来他们之间一直都是这样联系的…",
            "nextDialogs": [
              "687220104"
            ]
          },
          "687220104": {
            "id": "687220104",
            "speakerId": 1006,
            "speakerName": "《与愚人众秘密联络指南》",
            "text": "「记住，暗号是…『不要带着自己的规则手册，去别人的地盘。』…」",
            "nextDialogs": [
              "687220105"
            ]
          },
          "687220105": {
            "id": "687220105",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "#居然还有暗号！{NICKNAME}，我们来试试吧，「不要带着自己的规则手册…」",
            "nextDialogs": [
              "687220106"
            ]
          },
          "687220106": {
            "id": "687220106",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "「去别人的地盘。」",
            "nextDialogs": [
              "687220107"
            ]
          },
          "687220107": {
            "id": "687220107",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "说着不要带着自己的规则手册去别人的地盘，哼，但是这个联络愚人众的规则却被带到须弥来了呢…",
            "nextDialogs": [
              "687220108"
            ]
          },
          "687220108": {
            "id": "687220108",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "好，那我们这就出发去水天丛林那儿吧！一定要把那群愚人众一网打尽！"
          }
        }
      }
    },

    {
      "subId": "7304922",
      "subQuestName": "与接应的奥列格对话",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "730492201"
        ],
        "dialogs": {
          "730492201": {
            "id": "730492201",
            "speakerId": 1004,
            "speakerName": "奥列格",
            "text": "咦，怎么会…咳咳，暗号，「不要带着自己的规则手册…」",
            "nextDialogs": [
              "730492202"
            ]
          },
          "730492202": {
            "id": "730492202",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "「去别人的地盘。」",
            "nextDialogs": [
              "730492203"
            ]
          },
          "730492203": {
            "id": "730492203",
            "speakerId": 1004,
            "speakerName": "奥列格",
            "text": "哼，进来吧，你们…哼，你们一定是来支援的新人吧，来得还真慢啊。"
          }
        }
      }
    },
    {
      "subId": "7304923",
      "subQuestName": "跟随奥列格",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [],
        "dialogs": {}
      }
    },
    {
      "subId": "7304906",
      "subQuestName": "与奥列格对话",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "730490601"
        ],
        "dialogs": {
          "730490601": {
            "id": "730490601",
            "speakerId": 1004,
            "speakerName": "奥列格",
            "text": "你们根本不明白这次实验的重要性，你们不仅来晚了，你们还…",
            "nextDialogs": [
              "730490602"
            ]
          },
          "730490602": {
            "id": "730490602",
            "speakerId": 1004,
            "speakerName": "奥列格",
            "text": "哼，你们还抢夺营地！关闭桑格吉拉光机！让我们的实验停滞！",
            "nextDialogs": [
              "730490603"
            ]
          },
          "730490603": {
            "id": "730490603",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "居然暴露了！",
            "nextDialogs": [
              "730490604"
            ]
          },
          "730490604": {
            "id": "730490604",
            "speakerId": 1004,
            "speakerName": "奥列格",
            "text": "拜托，我可是三次被你们…和你们打了三场，为什么你们会以为戴个面罩就能够骗过我啊…",
            "nextDialogs": [
              "730490605"
            ]
          },
          "730490605": {
            "id": "730490605",
            "speakerId": 1004,
            "speakerName": "奥列格",
            "text": "你以为我为什么认出你了还要放你进来！当然是故意的！",
            "nextDialogs": [
              "730490606"
            ]
          },
          "730490606": {
            "id": "730490606",
            "speakerId": 1004,
            "speakerName": "奥列格",
            "text": "上啊，这人就是打断我们实验的元凶！"
          }
        }
      }
    },
    {
      "subId": "7304924",
      "subQuestName": "与奥列格战斗",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [],
        "dialogs": {}
      }
    },
    {
      "subId": "7304925",
      "subQuestName": "与奥列格对话",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "730492501"
        ],
        "dialogs": {
          "730492501": {
            "id": "730492501",
            "speakerId": 1004,
            "speakerName": "奥列格",
            "text": "居然这么多人都…没有办法打赢…",
            "nextDialogs": [
              "730492502"
            ]
          },
          "730492502": {
            "id": "730492502",
            "speakerId": 1004,
            "speakerName": "奥列格",
            "text": "明明只要顺利进行实验，我就能够…",
            "nextDialogs": [
              "730492503"
            ]
          },
          "730492503": {
            "id": "730492503",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "别想了，那是不可能的，卡西姆的那个什么桑什么机，根本就没办法提取死域的能量…",
            "nextDialogs": [
              "730492504"
            ]
          },
          "730492504": {
            "id": "730492504",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "也就是说，他从头到尾都是在骗你啦！",
            "nextDialogs": [
              "730492505"
            ]
          },
          "730492505": {
            "id": "730492505",
            "speakerId": 1004,
            "speakerName": "奥列格",
            "text": "怎么会这样！",
            "nextDialogs": [
              "730492506"
            ]
          },
          "730492506": {
            "id": "730492506",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "就在三十人团那好好悔过，这辈子都别来须弥啦！",
            "nextDialogs": [
              "730492507"
            ]
          },
          "730492507": {
            "id": "730492507",
            "speakerId": 1005,
            "speakerName": "Black Screen",
            "text": "通知了三十人团的掌旗官鲁克沙。\\n鲁克沙的手下将愚人众收押走了。"
          }
        }
      }
    },
    {
      "subId": "7304926",
      "subQuestName": "与鲁克沙对话",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "730492601"
        ],
        "dialogs": {
          "730492601": {
            "id": "730492601",
            "speakerId": 1000,
            "speakerName": "鲁克沙",
            "text": "这次真是多亏你们，没想到营地被用来干这种奇怪的事…这些心怀不轨的愚人众我们也都押走了。",
            "nextDialogs": [
              "730492602"
            ]
          },
          "730492602": {
            "id": "730492602",
            "speakerId": 1000,
            "speakerName": "鲁克沙",
            "text": "唉，找学者调查了一下那个机器，虽然无法影响死域，但是本身的运作就会造成一定程度的污染，要是无法及时叫停…",
            "nextDialogs": [
              "730492603"
            ]
          },
          "730492603": {
            "id": "730492603",
            "speakerId": 1000,
            "speakerName": "鲁克沙",
            "text": "森林会遭到破坏吧。",
            "nextDialogs": [
              "730492604"
            ]
          },
          "730492604": {
            "id": "730492604",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "这样啊…",
            "nextDialogs": [
              "730492605"
            ]
          },
          "730492605": {
            "id": "730492605",
            "speakerId": 1000,
            "speakerName": "鲁克沙",
            "text": "嗯，机器会由三十人团收押，以后应该不会再出现这样的事了…",
            "nextDialogs": [
              "730492606"
            ]
          },
          "730492606": {
            "id": "730492606",
            "speakerId": 1000,
            "speakerName": "鲁克沙",
            "text": "不过那些营地由于归属权的问题，可能很难统一管理…但也不是什么大碍。",
            "nextDialogs": [
              "730492607"
            ]
          },
          "730492607": {
            "id": "730492607",
            "speakerId": 1000,
            "speakerName": "鲁克沙",
            "text": "另外，根据你们所说，现在也增加了对卡西姆的悬赏…那家伙本来就是个大骗子，真让人头疼。",
            "nextDialogs": [
              "730492608"
            ]
          },
          "730492608": {
            "id": "730492608",
            "speakerId": 1000,
            "speakerName": "鲁克沙",
            "text": "这次被骗过来的镀金旅团也上了他的当，他绕过三十人团找上镀金旅团，说是要从地脉提取能量来赚上一笔…",
            "nextDialogs": [
              "730492609"
            ]
          },
          "730492609": {
            "id": "730492609",
            "speakerId": 1000,
            "speakerName": "鲁克沙",
            "text": "算了，等下次见到他再收拾他吧！",
            "nextDialogs": [
              "730492610"
            ]
          },
          "730492610": {
            "id": "730492610",
            "speakerId": 1000,
            "speakerName": "鲁克沙",
            "text": "来，这是你们揭发愚人众的酬劳！这次的事，真是多谢你们了。",
            "nextDialogs": [
              "730492611"
            ]
          },
          "730492611": {
            "id": "730492611",
            "speakerId": 1005,
            "speakerName": "Black Screen",
            "text": "鲁克沙离开了…"
          }
        }

    {
      "subId": "7304913",
      "subQuestName": "与奥列格对话",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "730491301"
        ],
        "dialogs": {
          "730491301": {
            "id": "730491301",
            "speakerId": 1004,
            "speakerName": "奥列格",
            "text": "天哪，你们到底想要什么啊？",
            "nextDialogs": [
              "730491302"
            ]
          },
          "730491302": {
            "id": "730491302",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "当然是希望你们不要再做坏事了！",
            "nextDialogs": [
              "730491303"
            ]
          },
          "730491303": {
            "id": "730491303",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "还有说出这些机器的作用！",
            "nextDialogs": [
              "730491304"
            ]
          },
          "730491304": {
            "id": "730491304",
            "speakerId": 1004,
            "speakerName": "奥列格",
            "text": "…哼，怎么可能，想太多了吧你们！",
            "nextDialogs": [
              "730491305"
            ]
          },
          "730491305": {
            "id": "730491305",
            "speakerId": 1004,
            "speakerName": "奥列格",
            "text": "不行，今天已经花费太多精力在战斗上了…得回据点休整一番…",
            "nextDialogs": [
              "730491306"
            ]
          },
          "730491306": {
            "id": "730491306",
            "speakerId": 1005,
            "speakerName": "Black Screen",
            "text": "奥列格趁乱逃跑了…",
            "nextDialogs": [
              "730491307"
            ]
          },
          "730491307": {
            "id": "730491307",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "可恶，到底为什么，每次都能被他逃掉呀…",
            "nextDialogs": [
              "730491308"
            ]
          },
          "730491308": {
            "id": "730491308",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "不过，他好像根本没发现自己的计划书被我们捡到了，看到我们时还挺惊讶的呢…",
            "nextDialogs": [
              "730491309"
            ]
          },
          "730491309": {
            "id": "730491309",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "他说要回据点休整，就不会去巡逻图上最后的试验营地了吧…",
            "nextDialogs": [
              "730491312"
            ]
          },
          "730491312": {
            "id": "730491312",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "嗯，说得对，也不能不管那些被打开的奇怪吸风机…"
          }
        }
      }
    },

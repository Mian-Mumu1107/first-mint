    {
      "subId": "7304910",
      "subQuestName": "与奥列格对话",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "730491001"
        ],
        "dialogs": {
          "730491001": {
            "id": "730491001",
            "speakerId": 1004,
            "speakerName": "奥列格",
            "text": "唔，没想到这次也…",
            "nextDialogs": [
              "730491002"
            ]
          },
          "730491002": {
            "id": "730491002",
            "speakerId": 1004,
            "speakerName": "奥列格",
            "text": "看你们的样子，应该也是「拿摩拉办事」的那种类型吧。",
            "nextDialogs": [
              "730491003"
            ]
          },
          "730491003": {
            "id": "730491003",
            "speakerId": 1004,
            "speakerName": "奥列格",
            "text": "不如这样，我给你们摩拉，你就别妨碍我们在这做事，行不行？",
            "nextDialogs": [
              "730491004"
            ]
          },
          "730491004": {
            "id": "730491004",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "#哇，{NICKNAME}，他虽然是个愚人众，但是看人的眼光还挺准的！",
            "nextDialogs": [
              "730491005"
            ]
          },
          "730491005": {
            "id": "730491005",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "不过你听好了，摩拉我们要…",
            "nextDialogs": [
              "730491006"
            ]
          },
          "730491006": {
            "id": "730491006",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "事我们也要管！",
            "nextDialogs": [
              "730491007"
            ]
          },
          "730491007": {
            "id": "730491007",
            "speakerId": 1004,
            "speakerName": "奥列格",
            "text": "怎么有你们这么麻烦的人，给我记住了，下次有你们好看的！",
            "nextDialogs": [
              "730491008"
            ]
          },
          "730491008": {
            "id": "730491008",
            "speakerId": 1005,
            "speakerName": "Black Screen",
            "text": "奥列格趁乱逃跑了…",
            "nextDialogs": [
              "730491009"
            ]
          },
          "730491009": {
            "id": "730491009",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "唔，根本看不清他逃跑的动作…感觉眼前一黑，他就不见踪影了。",
            "nextDialogs": [
              "730491010"
            ]
          },
          "730491010": {
            "id": "730491010",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "这个愚人众，论起逃跑来还真有两把刷子！",
            "nextDialogs": [
              "730491011"
            ]
          },
          "730491011": {
            "id": "730491011",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "一个…两个…那下一个就是巡逻路线上第三个营地了。我们不会在那还能碰见他吧…"
          }
        }
      }
    },

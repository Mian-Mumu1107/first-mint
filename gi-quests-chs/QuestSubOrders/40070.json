      }
    },
    {
      "subId": "4007016",
      "subQuestName": "回到愚人众堡垒附近",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "400701601"
        ],
        "dialogs": {
          "400701601": {
            "id": "400701601",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "奇怪，一路过来只有岛上的本土怪物，没有愚人众了。",
            "nextDialogs": [
              "400701602"
            ]
          },
          "400701602": {
            "id": "400701602",
            "speakerId": 10095,
            "speakerName": "莫娜",
            "text": "驻扎的痕迹和装置都还在，但人都不见了，好奇怪。",
            "nextDialogs": [
              "400701603"
            ]
          },
          "400701603": {
            "id": "400701603",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "（我一直认为，这些幻境的诞生与这台愚人众装置关系很大。它看起来已经坏了，也许这就是问题的根源。）",
            "nextDialogs": [
              "400701604"
            ]
          },
          "400701604": {
            "id": "400701604",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "（…假如装置能让人产生幻觉，那他们自己为什么消失了？还是说，另有隐情？）",
            "nextDialogs": [
              "400701605"
            ]
          },
          "400701605": {
            "id": "400701605",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "（找不到人，是因为他们消失了，还是他们在躲避我们？）",
            "nextDialogs": [
              "400701606"
            ]
          },
          "400701606": {
            "id": "400701606",
            "speakerId": 10095,
            "speakerName": "莫娜",
            "text": "算了，占卜一下看看。",
            "nextDialogs": [
              "400701607"
            ]
          },
          "400701607": {
            "id": "400701607",
            "speakerId": 10095,
            "speakerName": "莫娜",
            "text": "……",
            "nextDialogs": [
              "400701608"
            ]
          },
          "400701608": {
            "id": "400701608",
            "speakerId": 10095,
            "speakerName": "莫娜",
            "text": "嗯？这是…力量在流动？",
            "nextDialogs": [
              "400701609"
            ]
          },
          "400701609": {
            "id": "400701609",
            "speakerId": 10095,
            "speakerName": "莫娜",
            "text": "各位，似乎没能占出愚人众的踪迹，水占盘又变得浑浊了，但这次我能感知到某种力量正在汇聚成型。",
            "nextDialogs": [
              "400701610"
            ]
          },
          "400701610": {
            "id": "400701610",
            "speakerId": 10095,
            "speakerName": "莫娜",
            "text": "目的地是…那边的小岛。",
            "nextDialogs": [
              "400701611"
            ]
          },
          "400701611": {
            "id": "400701611",
            "speakerId": 1042,
            "speakerName": "辛焱",
            "text": "这次会是跟谁有关的幻境呢？",
            "nextDialogs": [
              "400701612"
            ]
          },
          "400701612": {
            "id": "400701612",
            "speakerId": 10095,
            "speakerName": "莫娜",
            "text": "唔…过去看看吧，说不定会有线索。"
          }
        }
      }
    },
    {
      "subId": "4007017",
      "subQuestName": "前往莫娜所说的岛屿",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "400701701"
        ],
        "dialogs": {
          "400701701": {
            "id": "400701701",
            "speakerId": 1032,
            "speakerName": "枫原万叶",
            "text": "到了各位。",
            "nextDialogs": [
              "400701702"
            ]
          },
          "400701702": {
            "id": "400701702",
            "speakerId": 10095,
            "speakerName": "莫娜",
            "text": "咦？菲谢尔？",
            "nextDialogs": [
              "400701703"
            ]
          },
          "400701703": {
            "id": "400701703",
            "speakerId": 10011,
            "speakerName": "菲谢尔",
            "text": "……",
            "nextDialogs": [
              "400701704"
            ]
          },
          "400701704": {
            "id": "400701704",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "真的是她！菲谢尔——！",
            "nextDialogs": [
              "400701705"
            ]
          },
          "400701705": {
            "id": "400701705",
            "speakerId": 10011,
            "speakerName": "菲谢尔",
            "text": "…哼，来了吗，诸位愚笨的家臣。",
            "nextDialogs": [
              "400701706"
            ]
          },
          "400701706": {
            "id": "400701706",
            "speakerId": 10012,
            "speakerName": "奥兹",
            "text": "哦、哦呀，好久不见了！",
            "nextDialogs": [
              "400701707"
            ]
          },
          "400701707": {
            "id": "400701707",
            "speakerId": 1042,
            "speakerName": "辛焱",
            "text": "也没那么久吧？",
            "nextDialogs": [
              "400701708"
            ]
          },
          "400701708": {
            "id": "400701708",
            "speakerId": 10012,
            "speakerName": "奥兹",
            "text": "啊…小姐和我察觉到某种气息，特意提前赶往此处，等待与诸位会合。没想到，诸位…诸位来得比想象中更快。",
            "nextDialogs": [
              "400701709"
            ]
          },
          "400701709": {
            "id": "400701709",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "奥兹看起来有点紧张？是我的错觉吗？",
            "nextDialogs": [
              "400701710"
            ]
          },
          "400701710": {
            "id": "400701710",
            "speakerId": 10011,
            "speakerName": "菲谢尔",
            "text": "幽夜净土降临在即，本皇女还需要筹备祝圣仪典。",
            "nextDialogs": [
              "400701711"
            ]
          },
          "400701711": {
            "id": "400701711",
            "speakerId": 10012,
            "speakerName": "奥兹",
            "text": "小姐，您又要…",
            "nextDialogs": [
              "400701712"
            ]
          },
          "400701712": {
            "id": "400701712",
            "speakerId": 10011,
            "speakerName": "菲谢尔",
            "text": "我一人也可行动，奥兹，你若是厌烦了夤夜的侵袭，就退回到白日炽光中去。",
            "nextDialogs": [
              "400701713"
            ]
          },
          "400701713": {
            "id": "400701713",
            "speakerId": 10012,
            "speakerName": "奥兹",
            "text": "小姐，如此话语可不像您该对我说的。我是您的扈从，您的眼睛，不可能丢下您。",
            "nextDialogs": [
              "400701714"
            ]
          },
          "400701714": {
            "id": "400701714",
            "speakerId": 10011,
            "speakerName": "菲谢尔",
            "text": "…少在那里用打量的眼神看着我了！总、总之，现在还没到解释的时候。",
            "nextDialogs": [
              "400701715"
            ]
          },
          "400701715": {
            "id": "400701715",
            "speakerId": 10012,
            "speakerName": "奥兹",
            "text": "哎呀，小姐！",
            "nextDialogs": [
              "400701716"
            ]
          },
          "400701716": {
            "id": "400701716",
            "speakerId": 10012,
            "speakerName": "奥兹",
            "text": "诸位，万分抱歉，小姐心情不好，还请不要放在心上。也恕我先失陪了。",
            "nextDialogs": [
              "400701717"
            ]
          },
          "400701717": {
            "id": "400701717",
            "speakerId": 10095,
            "speakerName": "莫娜",
            "text": "…哈，离队这么久，心情也没好起来嘛。",
            "nextDialogs": [
              "400701718"
            ]
          },
          "400701718": {
            "id": "400701718",
            "speakerId": 10095,
            "speakerName": "莫娜",
            "text": "看到菲谢尔，我就觉得这一带即将成型的幻境应该跟她有关。",
            "nextDialogs": [
              "400701719"
            ]
          },
          "400701719": {
            "id": "400701719",
            "speakerId": 1032,
            "speakerName": "枫原万叶",
            "text": "嗯。靠近与我有关的幻境时，我隐约能感觉到某种熟悉的气息。",
            "nextDialogs": [
              "400701720"
            ]
          },
          "400701720": {
            "id": "400701720",
            "speakerId": 1042,
            "speakerName": "辛焱",
            "text": "我也是。虽然并无道理，只是觉得有什么有意思的东西要出现了。",
            "nextDialogs": [
              "400701721"
            ]
          },
          "400701721": {
            "id": "400701721",
            "speakerId": 10095,
            "speakerName": "莫娜",
            "text": "嗯。菲谢尔和奥兹能有所感知，说明这份预感也会成真…菲谢尔应该就是不想面对她的幻境，才这么焦躁。",
            "nextDialogs": [
              "400701722"
            ]
          },
          "400701722": {
            "id": "400701722",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "怎么会这样…",
            "nextDialogs": [
              "400701723"
            ]
          },
          "400701723": {
            "id": "400701723",
            "speakerId": 10095,
            "speakerName": "莫娜",
            "text": "或许，她的幻境中隐藏着某些不希望被人知道的秘密吧。",
            "nextDialogs": [
              "400701724"
            ]
          },
          "400701724": {
            "id": "400701724",
            "speakerId": 10095,
            "speakerName": "莫娜",
            "text": "各位，我们先在这里休息吧。等幻境出现，谜底自然就会揭开。"
          }
        }
      }

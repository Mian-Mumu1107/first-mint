    {
      "subId": "4007018",
      "subQuestName": "与众人对话",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "400701801"
        ],
        "dialogs": {
          "400701801": {
            "id": "400701801",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "能做的都做了，剩下那两座山怎么也解决不了…",
            "nextDialogs": [
              "400701802"
            ]
          },
          "400701802": {
            "id": "400701802",
            "speakerId": 1042,
            "speakerName": "辛焱",
            "text": "再想想，会有办法的。",
            "nextDialogs": [
              "400701803"
            ]
          },
          "400701803": {
            "id": "400701803",
            "speakerId": 10095,
            "speakerName": "莫娜",
            "text": "刚才我仔细看过，岛上几座山内部多半都有水脉和植物，这种体系将它们串联在一起。",
            "nextDialogs": [
              "400701804"
            ]
          },
          "400701804": {
            "id": "400701804",
            "speakerId": 10095,
            "speakerName": "莫娜",
            "text": "但现在山体坍塌，植物和水脉无法连通。",
            "nextDialogs": [
              "400701805"
            ]
          },
          "400701805": {
            "id": "400701805",
            "speakerId": 1032,
            "speakerName": "枫原万叶",
            "text": "如果所有脉络都被打通，它们就会连接起来，形成阿贝多笔记中所说的「巨型乐器」，以岛屿为单位演奏了。",
            "nextDialogs": [
              "400701806"
            ]
          },
          "400701806": {
            "id": "400701806",
            "speakerId": 1042,
            "speakerName": "辛焱",
            "text": "嗯，为了我想做的事，必须做到这一点…我想去问问那朵花，它应该知道办法。"
          }
        }
      }
    },
    {
      "subId": "4007015",
      "subQuestName": "寻求「火炽之心」的帮助",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [],
        "dialogs": {}
      }
    },
    {
      "subId": "4007004",
      "subQuestName": "寻求「火炽之心」的帮助",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "400700401"
        ],
        "dialogs": {
          "400700401": {
            "id": "400700401",
            "speakerId": 1042,
            "speakerName": "辛焱",
            "text": "岛上有些山体失去了植物和水脉，请问你有办法疏通它们吗？",
            "nextDialogs": [
              "400700402"
            ]
          },
          "400700402": {
            "id": "400700402",
            "speakerId": 12616,
            "speakerName": "火炽之心",
            "text": "这件事，我知道一个人能帮忙。楼上住着我的同伴冰封之心，去问问它吧。"
          }
        }
      }
    },
    {
      "subId": "4007005",
      "subQuestName": "寻找「冰封之心」",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "400700501"
        ],
        "dialogs": {
          "400700501": {
            "id": "400700501",
            "speakerId": 12623,
            "speakerName": "冰封之心",
            "text": "你们是什么人？竟然会到我这里来。",
            "nextDialogs": [
              "400700502"
            ]
          },
          "400700502": {
            "id": "400700502",
            "speakerId": 1042,
            "speakerName": "辛焱",
            "text": "你好，我们想借助你的力量疏通岛上那几座山。",
            "nextDialogs": [
              "400700503"
            ]
          },
          "400700503": {
            "id": "400700503",
            "speakerId": 12623,
            "speakerName": "冰封之心",
            "text": "山？噢，我知道了…你们也想成为大音乐家，是吗？",
            "nextDialogs": [
              "400700504"
            ]
          },
          "400700504": {
            "id": "400700504",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "欸？是这样吗？",
            "nextDialogs": [
              "400700505"
            ]
          },
          "400700505": {
            "id": "400700505",
            "speakerId": 1042,
            "speakerName": "辛焱",
            "text": "没错。",
            "nextDialogs": [
              "400700506"
            ]
          },
          "400700506": {
            "id": "400700506",
            "speakerId": 12623,
            "speakerName": "冰封之心",
            "text": "既然如此，我们就是志同道合的伙伴了。即使我很柔弱，也要为你们献上一份力量。",
            "nextDialogs": [
              "400700507"
            ]
          },
          "400700507": {
            "id": "400700507",
            "speakerId": 12623,
            "speakerName": "冰封之心",
            "text": "拿着我的花瓣，把它种在音律交汇的终点，沉入地下的山脉将为这乐声升起。只要我们还有音乐，生命就会流淌在每一寸土地上。",
            "nextDialogs": [
              "400700508"
            ]
          },
          "400700508": {
            "id": "400700508",
            "speakerId": 1042,
            "speakerName": "辛焱",
            "text": "…谢谢你。"
          }
        }
      }
    },

    {
      "subId": "4007019",
      "subQuestName": "将成果告知「冰封之心」",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "400701901"
        ],
        "dialogs": {
          "400701901": {
            "id": "400701901",
            "speakerId": 1042,
            "speakerName": "辛焱",
            "text": "我们把花瓣种下去了，你能感觉到什么吗？",
            "nextDialogs": [
              "400701902"
            ]
          },
          "400701902": {
            "id": "400701902",
            "speakerId": 12623,
            "speakerName": "冰封之心",
            "text": "嗯…有了。阳光不错，海上有宝石般绚烂的光芒，浪拍打着乳白色的沙滩，那些沙粒流入海中，又被推回来…",
            "nextDialogs": [
              "400701903"
            ]
          },
          "400701903": {
            "id": "400701903",
            "speakerId": 12623,
            "speakerName": "冰封之心",
            "text": "…有海鸟落在岩石上，轻轻啄着，发出有节奏的乐曲。咚咚，咚咚…",
            "nextDialogs": [
              "400701904"
            ]
          },
          "400701904": {
            "id": "400701904",
            "speakerId": 1042,
            "speakerName": "辛焱",
            "text": "是音乐。",
            "nextDialogs": [
              "400701905"
            ]
          },
          "400701905": {
            "id": "400701905",
            "speakerId": 12623,
            "speakerName": "冰封之心",
            "text": "是音乐啊。说起来，这座岛本就是一件庞大的乐器。既然你是音乐人，应该能理解其中的深意。",
            "nextDialogs": [
              "400701906"
            ]
          },
          "400701906": {
            "id": "400701906",
            "speakerId": 1042,
            "speakerName": "辛焱",
            "text": "用海风、浪花与潮汐演奏音乐，是这个世界上最浪漫的事。",
            "nextDialogs": [
              "400701907"
            ]
          },
          "400701907": {
            "id": "400701907",
            "speakerId": 1042,
            "speakerName": "辛焱",
            "text": "走吧各位，是时候请你们听听我的演出了。"
          }
        }
      }
    },
    {
      "subId": "4007010",
      "subQuestName": "前往有风的山头",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "400701001"
        ],
        "dialogs": {
          "400701001": {
            "id": "400701001",
            "speakerId": 1042,
            "speakerName": "辛焱",
            "text": "……",
            "nextDialogs": [
              "400701002"
            ]
          },
          "400701002": {
            "id": "400701002",
            "speakerId": 1042,
            "speakerName": "辛焱",
            "text": "终于，到这个时候了。",
            "nextDialogs": [
              "400701003"
            ]
          },
          "400701003": {
            "id": "400701003",
            "speakerId": 1042,
            "speakerName": "辛焱",
            "text": "各位，我曾许下一个愿望，要跟谁都想不到的人一起办演唱会。而今天，我在海岛上找到了答案。",
            "nextDialogs": [
              "400701004"
            ]
          },
          "400701004": {
            "id": "400701004",
            "speakerId": 1042,
            "speakerName": "辛焱",
            "text": "许多年前将这座岛制成巨型乐器的人，没人知道他的名字和长相，但他绝对是提瓦特最伟大的音乐家之一。",
            "nextDialogs": [
              "400701005"
            ]
          },
          "400701005": {
            "id": "400701005",
            "speakerId": 1042,
            "speakerName": "辛焱",
            "text": "我从没想过能见到这样一件乐器。更想不到，我们能趁着潮汐奏响它。",
            "nextDialogs": [
              "400701006"
            ]
          },
          "400701006": {
            "id": "400701006",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "要演奏摇滚乐了吗？",
            "nextDialogs": [
              "400701007"
            ]
          },
          "400701007": {
            "id": "400701007",
            "speakerId": 1042,
            "speakerName": "辛焱",
            "text": "不。",
            "nextDialogs": [
              "400701008"
            ]
          },
          "400701008": {
            "id": "400701008",
            "speakerId": 1042,
            "speakerName": "辛焱",
            "text": "音乐是献给知己的礼物，所以…我会选择更适合这位原住民的方式与他合奏。",
            "nextDialogs": [
              "400701009"
            ]
          },
          "400701009": {
            "id": "400701009",
            "speakerId": 1042,
            "speakerName": "辛焱",
            "text": "今天就不玩摇滚乐了，给大家看点新花样！",
            "nextDialogs": [
              "400701010"
            ]
          },
          "400701010": {
            "id": "400701010",
            "speakerId": 1042,
            "speakerName": "辛焱",
            "text": "…呼。",
            "nextDialogs": [
              "400701011"
            ]
          },
          "400701011": {
            "id": "400701011",
            "speakerId": 1042,
            "speakerName": "辛焱",
            "text": "怎么样？我的演奏还不错吧？",
            "nextDialogs": [
              "400701012"
            ]
          },
          "400701012": {
            "id": "400701012",
            "speakerId": 10095,
            "speakerName": "莫娜",
            "text": "非常不错。",
            "nextDialogs": [
              "400701013"
            ]
          },
          "400701013": {
            "id": "400701013",
            "speakerId": 1032,
            "speakerName": "枫原万叶",
            "text": "从未听过这样的合奏，很有意思。",
            "nextDialogs": [
              "400701014"
            ]
          },
          "400701014": {
            "id": "400701014",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "而且很高雅！我不知道该怎么说…反正很不一样。",
            "nextDialogs": [
              "400701017"
            ]
          },
          "400701017": {
            "id": "400701017",
            "speakerId": 1042,
            "speakerName": "辛焱",
            "text": "嘿嘿，谢谢大家。",
            "nextDialogs": [
              "400701018"
            ]
          },
          "400701018": {
            "id": "400701018",
            "speakerId": 1042,
            "speakerName": "辛焱",
            "text": "这样一来，我的愿望也算是完成了。",
            "nextDialogs": [
              "400701019"
            ]
          },
          "400701019": {
            "id": "400701019",
            "speakerId": 10095,
            "speakerName": "莫娜",
            "text": "还有什么想做的吗？",
            "nextDialogs": [
              "400701020"
            ]
          },
          "400701020": {
            "id": "400701020",
            "speakerId": 1042,
            "speakerName": "辛焱",
            "text": "没有了。今晚应该能睡个好觉吧。",
            "nextDialogs": [
              "400701021"
            ]
          },
          "400701021": {
            "id": "400701021",
            "speakerId": 1032,
            "speakerName": "枫原万叶",
            "text": "接下来大家都闲着对吧？那我有个提议。",
            "nextDialogs": [
              "400701022"
            ]
          },
          "400701022": {
            "id": "400701022",
            "speakerId": 1032,
            "speakerName": "枫原万叶",
            "text": "我想再去一趟愚人众营地，确认那里的情况。",
            "nextDialogs": [
              "400701023"
            ]
          },
          "400701023": {
            "id": "400701023",
            "speakerId": 10095,
            "speakerName": "莫娜",
            "text": "嗯？原来你们也发现愚人众营地了。",
            "nextDialogs": [
              "400701024"
            ]
          },
          "400701024": {
            "id": "400701024",
            "speakerId": 1032,
            "speakerName": "枫原万叶",
            "text": "等等，你也知道？",
            "nextDialogs": [
              "400701025"
            ]
          },
          "400701025": {
            "id": "400701025",
            "speakerId": 10095,
            "speakerName": "莫娜",
            "text": "我可是天才占星术士，而且我不是说过？水占盘恢复一点了。我能通过占卜感觉到这里的情况。",
            "nextDialogs": [
              "400701026"
            ]
          },
          "400701026": {
            "id": "400701026",
            "speakerId": 1042,
            "speakerName": "辛焱",
            "text": "咦，这里都有愚人众？",
            "nextDialogs": [
              "400701027"
            ]
          },
          "400701027": {
            "id": "400701027",
            "speakerId": 10095,
            "speakerName": "莫娜",
            "text": "对。今天跟菲谢尔分开时，我也把这件事告诉她了。假如遇到愚人众，她会隐藏起来，不会有危险。",
            "nextDialogs": [
              "400701028"
            ]
          },
          "400701028": {
            "id": "400701028",
            "speakerId": 1032,
            "speakerName": "枫原万叶",
            "text": "原来如此，那我们也坦白吧。",
            "nextDialogs": [
              "400701029"
            ]
          },
          "400701029": {
            "id": "400701029",
            "speakerId": 1006,
            "speakerName": "Black Screen",
            "text": "将登岛那天遇到愚人众营地和奇怪装置的事仔细说给其他人听…",
            "nextDialogs": [
              "400701030"
            ]
          },
          "400701030": {
            "id": "400701030",
            "speakerId": 10095,
            "speakerName": "莫娜",
            "text": "奇怪的装置，神志不清的愚人众…你们的意思是，这些跟最近的幻境有关？",
            "nextDialogs": [
              "400701031"
            ]
          },
          "400701031": {
            "id": "400701031",
            "speakerId": 1032,
            "speakerName": "枫原万叶",
            "text": "不能保证。但我觉得，两者之间不应该完全没有关联。",
            "nextDialogs": [
              "400701032"
            ]
          },
          "400701032": {
            "id": "400701032",
            "speakerId": 1042,
            "speakerName": "辛焱",
            "text": "有道理，那赶快去营地看看吧。"
          }
        }
      }
    },
    {
      "subId": "4007011",
      "subQuestName": "确认愚人众装置的情况",
      "sceneId": null,
      "locations": [],
      "dialogue": {

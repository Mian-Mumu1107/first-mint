    {
      "subId": "4008203",
      "subQuestName": "击败对手",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "400820301"
        ],
        "dialogs": {
          "400820301": {
            "id": "400820301",
            "speakerId": 12858,
            "speakerName": "风速枣椰",
            "text": "啊哈！没想到预赛的对手看起来这么普通。",
            "nextDialogs": [
              "400820302"
            ]
          },
          "400820302": {
            "id": "400820302",
            "speakerId": 12858,
            "speakerName": "风速枣椰",
            "text": "来吧，就让本小姐用华丽的快攻打败你们！",
            "nextDialogs": [
              "400820303"
            ]
          },
          "400820303": {
            "id": "400820303",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "不用紧张哦，「咚咚小圆帽」，只是预赛的对手而已，把他们当成踏脚石就好了！"
          }
        }
      }
    },
    {
      "subId": "4008206",
      "subQuestName": "击败对手",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [],
        "dialogs": {}
      }
    },
    {
      "subId": "4008207",
      "subQuestName": "与对手对话",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "400820701"
        ],
        "dialogs": {
          "400820701": {
            "id": "400820701",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "「咚咚小圆帽」，干得漂亮！还有大家，打得真棒！",
            "nextDialogs": [
              "400820702"
            ]
          },
          "400820702": {
            "id": "400820702",
            "speakerId": 12858,
            "speakerName": "风速枣椰",
            "text": "怎么这样…我的风速攻势居然输掉了…大家快撤退！"
          }
        }
      }
    },
    {
      "subId": "4008213",
      "subQuestName": "离开赛场",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [],
        "dialogs": {}
      }
    },
    {
      "subId": "4008208",
      "subQuestName": "与八重神子对话",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "400820801"
        ],
        "dialogs": {
          "400820801": {
            "id": "400820801",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "我觉得，指挥蕈兽和别人比赛的感觉很特别，很有意思！",
            "nextDialogs": [
              "400820802"
            ]
          },
          "400820802": {
            "id": "400820802",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "不过，刚才的那个驯兽师和蕈兽们的配合也挺不错的，简直和我们俩不相上下…",
            "nextDialogs": [
              "400820805"
            ]
          },
          "400820805": {
            "id": "400820805",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "我不是那个意思啦！我是说，对方好像和蕈兽形成了一种「流派」！",
            "nextDialogs": [
              "400820806"
            ]
          },
          "400820806": {
            "id": "400820806",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "如果我们能和「咚咚小圆帽」配合得更自然就好了，我希望，我们一个眼神，「咚咚小圆帽」就知道该做什么！",
            "nextDialogs": [
              "400820807"
            ]
          },
          "400820807": {
            "id": "400820807",
            "speakerId": 1034,
            "speakerName": "八重神子",
            "text": "这就要仰仗「伙伴间的默契」了。",
            "nextDialogs": [
              "400820808"
            ]
          },
          "400820808": {
            "id": "400820808",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "神子！还有莱依拉！你们的比赛还顺利吗？",
            "nextDialogs": [
              "400820809"
            ]
          },
          "400820809": {
            "id": "400820809",
            "speakerId": 1063,
            "speakerName": "莱依拉",
            "text": "没想到「转转悠悠兽」和蘑菇伙伴们这么厉害，两三下就打垮了对手，我都没反应过来…",
            "nextDialogs": [
              "400820810"
            ]
          },
          "400820810": {
            "id": "400820810",
            "speakerId": 1063,
            "speakerName": "莱依拉",
            "text": "回到赛场时，我看见八重小姐的对手丢了魂似地逃走了…正好，八重小姐打算和你们商谈要事，我就跟着她一起过来了。",
            "nextDialogs": [
              "400820811"
            ]
          },
          "400820811": {
            "id": "400820811",
            "speakerId": 1034,
            "speakerName": "八重神子",
            "text": "小莱依拉顺利战胜了对手，左右加也首战告捷，略胜对手一线。我倒是有点遗憾…对手完全没让我尽兴呢。",
            "nextDialogs": [
              "400820812"
            ]
          },
          "400820812": {
            "id": "400820812",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "现在只是开始嘛，如果预赛的对手就超能打，这场比赛未免就太难了！",
            "nextDialogs": [
              "400820813"
            ]
          },
          "400820813": {
            "id": "400820813",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "不过说起来，神子打算和我们商量什么呢？",
            "nextDialogs": [
              "400820814"
            ]
          },
          "400820814": {
            "id": "400820814",
            "speakerId": 1034,
            "speakerName": "八重神子",
            "text": "啊呀，派蒙，你进步了呢，已经意识到了我要提醒你们的事。今后的对手会越来越强，我们可不能松懈啊。",
            "nextDialogs": [
              "400820815"
            ]
          },
          "400820815": {
            "id": "400820815",
            "speakerId": 1034,
            "speakerName": "八重神子",
            "text": "不如就借着赢下预赛的气势，和蕈兽开展「特别修行」，加强与伙伴们的配合吧。",
            "nextDialogs": [
              "400820816"
            ]
          },
          "400820816": {
            "id": "400820816",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "很有先见之明！那我们现在就出发吧，和蘑菇伙伴们开始特别修行！"
          }
        }
      }
    },
    {
      "subId": "4008212",
      "subQuestName": "与八重神子对话",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "400821201"
        ],
        "dialogs": {
          "400821201": {
            "id": "400821201",
            "speakerId": 1034,
            "speakerName": "八重神子",
            "text": "嗯，这里风景不错，空气里有一股雨林的香气，还足够僻静，没人会来打扰我们。",
            "nextDialogs": [
              "400821202"
            ]
          },
          "400821202": {
            "id": "400821202",
            "speakerId": 1034,
            "speakerName": "八重神子",
            "text": "我们可以陪着蕈兽尽情玩耍，休息的时候，就来享受须弥的特色美食吧。",
            "nextDialogs": [
              "400821203"
            ]
          },
          "400821203": {
            "id": "400821203",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "好耶！吃零食吃零食！",
            "nextDialogs": [
              "400821204"
            ]
          },
          "400821204": {
            "id": "400821204",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "等等…我们不是来修行的吗？难道神子在这些零食里加入了特别的配方…能让我们和蕈兽伙伴心意相通？",
            "nextDialogs": [
              "400821205"
            ]
          },
          "400821205": {
            "id": "400821205",
            "speakerId": 1034,
            "speakerName": "八重神子",
            "text": "就算我有那种神通，也不能滥用吧？我只带了一些普通的果干和点心。",
            "nextDialogs": [
              "400821206"
            ]
          },
          "400821206": {
            "id": "400821206",
            "speakerId": 1034,
            "speakerName": "八重神子",
            "text": "也许你们以为，我会给你们准备一场魔鬼训练？但那种事对你们完全没必要，相反，一直紧绷着弦，会错过很多重要的事物呢。",
            "nextDialogs": [
              "400821207"
            ]
          },
          "400821207": {
            "id": "400821207",
            "speakerId": 1034,
            "speakerName": "八重神子",
            "text": "既然要和蕈兽培养感情，就该把它们当成朋友来对待，留下快乐的回忆嘛，和朋友一起吃喝玩乐，是更重要的「默契修行」。",
            "nextDialogs": [
              "400821208"
            ]
          },
          "400821208": {
            "id": "400821208",
            "speakerId": 1034,
            "speakerName": "八重神子",
            "text": "假如小家伙只想着让你变强，逼着你练出石头般的肌肉来，想看你一拳打飞丘丘暴徒…你会开开心心地听话吗？",
            "nextDialogs": [
              "400821209"
            ]
          },
          "400821209": {
            "id": "400821209",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "肌肉派蒙…",
            "nextDialogs": [
              "400821210"
            ]
          },
          "400821210": {
            "id": "400821210",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "干嘛这样看着我！如果你敢做那种事…我，我就三天，不对，我就五天不理你！",
            "nextDialogs": [
              "400821211"
            ]
          },
          "400821211": {
            "id": "400821211",
            "speakerId": 1034,
            "speakerName": "八重神子",
            "text": "#你看，你和小家伙的交情这么深，都不想被{M#他}{F#她}强迫着锻炼，何况是刚刚认识不久的蕈兽伙伴呢？",
            "nextDialogs": [
              "400821212"
            ]
          },
          "400821212": {
            "id": "400821212",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "呃，完全被你的逻辑绕进去了…",
            "nextDialogs": [
              "400821213"
            ]
          },
          "400821213": {
            "id": "400821213",
            "speakerId": 1063,
            "speakerName": "莱依拉",
            "text": "八重小姐的想法属实在理。我也想看看，如果关闭了「意智宝珠」，或是宝珠出现故障，蘑菇伙伴还会听我们的话吗？",
            "nextDialogs": [
              "400821214"
            ]
          },
          "400821214": {
            "id": "400821214",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "关闭意智宝珠？",
            "nextDialogs": [
              "400821215"
            ]
          },
          "400821215": {
            "id": "400821215",
            "speakerId": 1063,
            "speakerName": "莱依拉",
            "text": "嗯，朋友之间都是慢慢熟悉彼此，才一步步达成互相信任的。",
            "nextDialogs": [
              "400821216"
            ]
          },
          "400821216": {
            "id": "400821216",
            "speakerId": 1063,
            "speakerName": "莱依拉",
            "text": "我不能总是依赖道具去和「转转悠悠兽」沟通，这样多少有点命令它的感觉…",
            "nextDialogs": [
              "400821217"
            ]
          },
          "400821217": {
            "id": "400821217",
            "speakerId": 1034,
            "speakerName": "八重神子",
            "text": "哎呀，「纯粹的情感，绝不能依靠身外之物来维系」…小莱依拉的想法还真是经典~",
            "nextDialogs": [
              "400821218"
            ]
          },
          "400821218": {
            "id": "400821218",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "可是，这就等于解除了对蕈兽的控制…真的没问题吗？",
            "nextDialogs": [
              "400821221"
            ]
          },
          "400821221": {
            "id": "400821221",
            "speakerId": 1034,
            "speakerName": "八重神子",
            "text": "尽管试试看吧，小莱依拉。不用担心，我和小家伙们会帮你的。",
            "nextDialogs": [
              "400821222"
            ]
          },
          "400821222": {
            "id": "400821222",
            "speakerId": 1063,
            "speakerName": "莱依拉",
            "text": "好，请大家做好准备，我要开始了。",
            "nextDialogs": [
              "400821223"
            ]
          },
          "400821223": {
            "id": "400821223",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "真的欸，关掉了「意智宝珠」以后，「转转悠悠兽」只是自顾自地活动了起来，并没有像以前那样攻击附近的人。",
            "nextDialogs": [
              "400821224"
            ]
          },
          "400821224": {
            "id": "400821224",
            "speakerId": 1034,
            "speakerName": "八重神子",
            "text": "或许「意智宝珠」能让蕈兽们的性格变得平和，以便搭起沟通的桥梁，而不是凭借某种技术强行控制它们。",
            "nextDialogs": [
              "400821225"
            ]
          },
          "400821225": {
            "id": "400821225",
            "speakerId": 1034,
            "speakerName": "八重神子",
            "text": "如果这个假设属实，小莱依拉的期待就有望成真了——你们和蕈兽熟悉彼此后，不使用「意智宝珠」也能毫无障碍地沟通。",
            "nextDialogs": [
              "400821226"
            ]
          },
          "400821226": {
            "id": "400821226",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "还是神子说得好！什么神秘技术都靠边站，这个假设我更喜欢！",
            "nextDialogs": [
              "400821227"
            ]
          },
          "400821227": {
            "id": "400821227",
            "speakerId": 1063,
            "speakerName": "莱依拉",
            "text": "我会努力的！我要了解「转转悠悠兽」的喜好，然后去找一位「全能商人」，买很多它喜欢的零食…",
            "nextDialogs": [
              "400821228"
            ]
          },
          "400821228": {
            "id": "400821228",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "那我也要和原本的「咚咚小圆帽」交流！我们也试着关掉「意智宝珠」吧？",
            "nextDialogs": [
              "400821229"
            ]
          },
          "400821229": {
            "id": "400821229",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "（为什么「意智宝珠」会有如此之强的效果？考特里亚掌握着其他学者都不了解的强大技术吗？）",
            "nextDialogs": [
              "400821230"
            ]
          },
          "400821230": {
            "id": "400821230",
            "speakerId": 1063,
            "speakerName": "莱依拉",
            "text": "#「转转悠悠兽」想去那边玩水？{NICKNAME}，派蒙和八重小姐，要带着蘑菇伙伴一起来吗？",
            "nextDialogs": [
              "400821231"
            ]
          },
          "400821231": {
            "id": "400821231",
            "speakerId": 1034,
            "speakerName": "八重神子",
            "text": "你可得留个心眼，站在水里时，别离「百雷遮罗」太近，否则可能享受到特别的腿部按摩服务哦。"
          }
        }
      }
    },
    {
      "subId": "4008209",
      "subQuestName": "寻找呼救声的来源",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [],
        "dialogs": {}
      }
    },
    {
      "subId": "4008210",
      "subQuestName": "与海妮耶对话",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "400821001"
        ],
        "dialogs": {
          "400821001": {
            "id": "400821001",
            "speakerId": 12855,
            "speakerName": "海妮耶",
            "text": "怎么是你们？",
            "nextDialogs": [
              "400821002"
            ]
          },
          "400821002": {
            "id": "400821002",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "海妮耶？你救下了那些孩子？",
            "nextDialogs": [
              "400821003"
            ]
          },
          "400821003": {
            "id": "400821003",
            "speakerId": 12855,
            "speakerName": "海妮耶",
            "text": "碰巧而已。那几个孩子想模仿参赛选手，结果被野生蕈兽围攻。还好我听见了动静，才保住了他们的性命。",
            "nextDialogs": [
              "400821004"
            ]
          },
          "400821004": {
            "id": "400821004",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "这也太危险了，他们怎么连「意智宝珠」都不拿，就冒冒失失靠近蕈兽啊！",
            "nextDialogs": [
              "400821005"
            ]
          },
          "400821005": {
            "id": "400821005",
            "speakerId": 12855,
            "speakerName": "海妮耶",
            "text": "不怪他们，以前我也被蕈兽可爱的外表迷惑过…好在我还牢记着家族的教诲和祖辈们吃过的苦头，没有贸然接近它们。",
            "nextDialogs": [
              "400821006"
            ]
          },
          "400821006": {
            "id": "400821006",
            "speakerId": 12855,
            "speakerName": "海妮耶",
            "text": "大家原本都明白，蕈兽是危险的魔物。但最近人们被「月莲杯」影响，慢慢对蕈兽放下了警惕心，这是埃尔欣根考虑欠妥的一点。",
            "nextDialogs": [
              "400821009"
            ]
          },
          "400821009": {
            "id": "400821009",
            "speakerId": 12855,
            "speakerName": "海妮耶",
            "text": "我会让这场闹剧尽快结束的。",
            "nextDialogs": [
              "400821010"
            ]
          },
          "400821010": {
            "id": "400821010",
            "speakerId": 12855,
            "speakerName": "海妮耶",
            "text": "「意智宝珠」非常适合大规模剿杀蕈兽。等到我夺得了冠军，就能随意支配这些道具。",
            "nextDialogs": [
              "400821011"
            ]
          },
          "400821011": {
            "id": "400821011",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "你在说什么啊，海妮耶？什么闹剧…什么剿杀蕈兽？你在「火一」面前说出这样的话，就不怕伤它的心吗？",
            "nextDialogs": [
              "400821012"
            ]
          },
          "400821012": {
            "id": "400821012",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "你不也参赛了吗？还主动给过我们指导，明明也乐在其中吧…",
            "nextDialogs": [
              "400821013"
            ]
          },
          "400821013": {
            "id": "400821013",
            "speakerId": 12855,
            "speakerName": "海妮耶",
            "text": "假如「火一」能意识到同类犯过的错，想必也会支持我的。可惜它无法理解人的情感，它只是被道具控制的「棋子」。",
            "nextDialogs": [
              "400821014"
            ]
          },
          "400821014": {
            "id": "400821014",
            "speakerId": 12855,
            "speakerName": "海妮耶",
            "text": "至于教导你们的理由…你们不也意识到了吗？我只是看中了你们的实力，想要让你们协助我实现自己的目标罢了。",
            "nextDialogs": [
              "400821015"
            ]
          },
          "400821015": {
            "id": "400821015",
            "speakerId": 12855,
            "speakerName": "海妮耶",
            "text": "现在你们居然在为蕈兽辩护，你们已经沉浸在这场荒谬的游戏里了，配不上「黄金流星」和「白银伴星」这两个响亮的称号…",
            "nextDialogs": [
              "400821016"
            ]
          },
          "400821016": {
            "id": "400821016",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "别走啊，海妮耶！我们刚刚还关闭了「意智宝珠」，在和蕈兽们一起玩呢！",
            "nextDialogs": [
              "400821017"
            ]
          },
          "400821017": {
            "id": "400821017",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "不打算听我们的话啊…",
            "nextDialogs": [
              "400821018"
            ]
          },
          "400821018": {
            "id": "400821018",
            "speakerId": 1034,
            "speakerName": "八重神子",
            "text": "啊呀呀，还真是一位性格鲜明的角色，言行中的执着也恰到好处，我嗅到了有趣展开的味道。",
            "nextDialogs": [
              "400821019"
            ]
          },
          "400821019": {
            "id": "400821019",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "神子？莱依拉？你们也被呼救声吸引过来了…",
            "nextDialogs": [
              "400821020"
            ]
          },
          "400821020": {
            "id": "400821020",
            "speakerId": 1034,
            "speakerName": "八重神子",
            "text": "刚刚我们还聊到了她，小莱依拉说，海妮耶是你们参赛之初的引路人，但在你们遇见小莱依拉后，她又突然离开了。",
            "nextDialogs": [
              "400821021"
            ]
          },
          "400821021": {
            "id": "400821021",
            "speakerId": 1034,
            "speakerName": "八重神子",
            "text": "现在看来，原来她是个经典的「迷途角色」。因为某些个体犯下了过错，就把矛头指向整个群体，要将对方彻底抹除…",
            "nextDialogs": [
              "400821022"
            ]
          },
          "400821022": {
            "id": "400821022",
            "speakerId": 1034,
            "speakerName": "八重神子",
            "text": "在「迷途角色」看来，这还是最有效、最稳妥的办法呢。"
          }
        }
      }
    },
    {
      "subId": "4008211",

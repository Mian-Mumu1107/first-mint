    {
      "subId": "4008202",
      "subQuestName": "前往「月莲杯」赛场",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "400821301"
        ],
        "dialogs": {
          "400821301": {
            "id": "400821301",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "预赛快要开始了，埃尔欣根好像在发表赛前的演讲呢。",
            "nextDialogs": [
              "400821302"
            ]
          },
          "400821302": {
            "id": "400821302",
            "speakerId": 12856,
            "speakerName": "埃尔欣根",
            "text": "各位选手与观众，「月莲杯驯兽师大赛」即将正式开幕。我由衷希望各位能在这场比赛中找到乐趣，有所收获。",
            "nextDialogs": [
              "400821303"
            ]
          },
          "400821303": {
            "id": "400821303",
            "speakerId": 12856,
            "speakerName": "埃尔欣根",
            "text": "同时，也请各位在比赛中保持一颗纯粹的竞技之心，友善地比拼。尽力而为就足够了，不必太动气，斗个你死我活。",
            "nextDialogs": [
              "400821304"
            ]
          },
          "400821304": {
            "id": "400821304",
            "speakerId": 12856,
            "speakerName": "埃尔欣根",
            "text": "我一直在寻找人与危险生物和谐共处的方法，而你们手中的「意智宝珠」让我看到了可能性。",
            "nextDialogs": [
              "400821305"
            ]
          },
          "400821305": {
            "id": "400821305",
            "speakerId": 12856,
            "speakerName": "埃尔欣根",
            "text": "希望这次大赛能向更多人展示「驯兽」的潜力，为将来的世界提供一种规避冲突的措施，使人们在野外活动时更加安全。",
            "nextDialogs": [
              "400821306"
            ]
          },
          "400821306": {
            "id": "400821306",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "原来如此！埃尔欣根是为了这个目标，才愿意出让自己的资产吗？感觉他很有理想呢！相比之下，那个考特里亚就有点…",
            "nextDialogs": [
              "400821307"
            ]
          },
          "400821307": {
            "id": "400821307",
            "speakerId": 12857,
            "speakerName": "考特里亚",
            "text": "由衷感谢埃尔欣根先生的发言！接下来我也简单说两句…",
            "nextDialogs": [
              "400821308"
            ]
          },
          "400821308": {
            "id": "400821308",
            "speakerId": 12857,
            "speakerName": "考特里亚",
            "text": "各位驯兽师！你们手中的「意智宝珠」是划时代的产物，凝聚着教令院几百年来的技术结晶，它的伟大之处有九点…",
            "nextDialogs": [
              "400821309"
            ]
          },
          "400821309": {
            "id": "400821309",
            "speakerId": 12856,
            "speakerName": "埃尔欣根",
            "text": "考特里亚，大家都跃跃欲试呢，眼下不必解释得这么细致。",
            "nextDialogs": [
              "400821310"
            ]
          },
          "400821310": {
            "id": "400821310",
            "speakerId": 12857,
            "speakerName": "考特里亚",
            "text": "咳咳！有机会的话，我再给各位说明吧！你们在比赛中肯定能感觉到它的先进。信任你们的「意智宝珠」，尽情去比拼吧！",
            "nextDialogs": [
              "400821311"
            ]
          },
          "400821311": {
            "id": "400821311",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "完全是个技术狂人呢，不管场合自顾自地发表观点…还好，埃尔欣根先生很会看气氛，没有让他耽误我们的时间！",
            "nextDialogs": [
              "400821312"
            ]
          },
          "400821312": {
            "id": "400821312",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "预赛总算要开始了，我们好好迎战第一位对手吧。",
            "nextDialogs": [
              "400821313"
            ]
          },
          "400821313": {
            "id": "400821313",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "（赛诺？他也注意到这场比赛了吗…）"
          }
        }
      }
    },
    {
      "subId": "4008205",
      "subQuestName": "参加比赛",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [],
        "dialogs": {}
      }
    },
    {
      "subId": "4008214",
      "subQuestName": "参加比赛$HIDDEN",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "400821401"
        ],
        "dialogs": {
          "400821401": {
            "id": "400821401",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "那边有好多人围在一起，好像在看什么东西？",
            "nextDialogs": [
              "400821402"
            ]
          },
          "400821402": {
            "id": "400821402",
            "speakerId": 1063,
            "speakerName": "莱依拉",
            "text": "听说主办方准备了好几块留言板，让观众们自由发表评论，互相交流，这种办法确实能提高大赛的讨论度。",
            "nextDialogs": [
              "400821403"
            ]
          },
          "400821403": {
            "id": "400821403",
            "speakerId": 1063,
            "speakerName": "莱依拉",
            "text": "那我和「转转悠悠兽」也会被大家讨论吗？要是这段经历也能被用在论文里就好了…",
            "nextDialogs": [
              "400821404"
            ]
          },
          "400821404": {
            "id": "400821404",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "我觉得很合适哦！听说写论文要引用很多资料，这件事很让人头疼。现在莱依拉自己就是提供资料的人，怎么高兴就怎么写！",
            "nextDialogs": [
              "400821405"
            ]
          },
          "400821405": {
            "id": "400821405",
            "speakerId": 1063,
            "speakerName": "莱依拉",
            "text": "派蒙的想法真好啊…可我是明论派的学员，只有生论派的论文会用到这种资料吧。",
            "nextDialogs": [
              "400821408"
            ]
          },
          "400821408": {
            "id": "400821408",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "嗯…莱依拉也可以向生论派学员提供资料嘛，说不定还可以赚一笔摩拉…啊呸，是资料费！",
            "nextDialogs": [
              "400821409"
            ]
          },
          "400821409": {
            "id": "400821409",
            "speakerId": 1063,
            "speakerName": "莱依拉",
            "text": "摩拉倒是次要的…不过，作为交换，可以请生论派的学员查阅高级文献，搞清楚「转转悠悠兽」的同类都喜欢什么。",
            "nextDialogs": [
              "400821410"
            ]
          },
          "400821410": {
            "id": "400821410",
            "speakerId": 1063,
            "speakerName": "莱依拉",
            "text": "缩小了调查范围后，我就轻松多了。不然，我可能要买几百种东西，每样都拿给「转转悠悠兽」尝尝看…",
            "nextDialogs": [
              "400821411"
            ]
          },
          "400821411": {
            "id": "400821411",
            "speakerId": 1063,
            "speakerName": "莱依拉",
            "text": "光是想想，我就要累昏了…",
            "nextDialogs": [
              "400821412"
            ]
          },
          "400821412": {
            "id": "400821412",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "还有这种思路？莱依拉真厉害啊！",
            "nextDialogs": [
              "400821413"
            ]
          },
          "400821413": {
            "id": "400821413",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "那「咚咚小圆帽」的喜好也麻烦你留意一下了！",
            "nextDialogs": [
              "400821414"
            ]
          },
          "400821414": {
            "id": "400821414",
            "speakerId": 1063,
            "speakerName": "莱依拉",
            "text": "我一定尽力…回去之后我就写信，托人送去阿弥利多学院。",
            "nextDialogs": [
              "400821415"
            ]
          },
          "400821415": {
            "id": "400821415",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "（赛诺的部下？他在监视赛场…）",
            "nextDialogs": [
              "400821416"
            ]
          },
          "400821416": {
            "id": "400821416",
            "speakerId": 1034,
            "speakerName": "八重神子",
            "text": "小家伙，三十二强赛的对阵列表公布了哦。",
            "nextDialogs": [
              "400821417"
            ]
          },
          "400821417": {
            "id": "400821417",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "欸？下场比赛居然就要和左右加小姐对决了！",
            "nextDialogs": [
              "400821418"
            ]
          },
          "400821418": {
            "id": "400821418",
            "speakerId": 1034,
            "speakerName": "八重神子",
            "text": "噗…我最期待的画面出现了啊…",
            "nextDialogs": [
              "400821419"
            ]
          },
          "400821419": {
            "id": "400821419",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "干嘛这么高兴？你就不怕你寄予厚望的作者被我们打败吗？那八重堂的须弥之旅就会草草收场的哦。",
            "nextDialogs": [
              "400821420"
            ]
          },
          "400821420": {
            "id": "400821420",
            "speakerId": 1034,
            "speakerName": "八重神子",
            "text": "千万别客气啊~我从没要求过左右加夺冠。没准被你们打败后，左右加还会因此顿悟呢。",
            "nextDialogs": [
              "400821421"
            ]
          },
          "400821421": {
            "id": "400821421",
            "speakerId": 1034,
            "speakerName": "八重神子",
            "text": "毕竟一帆风顺的经历可能让人们变得固执，认为只有自己才是正确的，有时挫折反而更宝贵哦。"
          }
        }
      }
    },
    {
      "subId": "4008215",

    {
      "subId": "7603303",
      "subQuestName": "用灯塔附近的奇特烹饪锅制作挪德卡莱热狗",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "760330301"
        ],
        "dialogs": {
          "760330301": {
            "id": "760330301",
            "speakerId": 15677,
            "speakerName": "执着于食物的幽影",
            "text": "肉切得足够厚，厚切的同时煎得又很熟，不错。",
            "nextDialogs": [
              "760330302"
            ]
          },
          "760330302": {
            "id": "760330302",
            "speakerId": 15677,
            "speakerName": "执着于食物的幽影",
            "text": "但是我要提醒你一点，做煎肉要注意配菜。",
            "nextDialogs": [
              "760330303"
            ]
          },
          "760330303": {
            "id": "760330303",
            "speakerId": 15677,
            "speakerName": "执着于食物的幽影",
            "text": "本来肉吃多了就容易腻，所以才会放浆果。",
            "nextDialogs": [
              "760330304"
            ]
          },
          "760330304": {
            "id": "760330304",
            "speakerId": 15677,
            "speakerName": "执着于食物的幽影",
            "text": "在岛上，我们负责管理所有人的饮食健康，一定要注意蔬菜和肉食的平衡搭配。",
            "nextDialogs": [
              "760330305"
            ]
          },
          "760330305": {
            "id": "760330305",
            "speakerId": 15677,
            "speakerName": "执着于食物的幽影",
            "text": "这盘煎肉里的配菜放得太少了，这点很不好，不够周全。",
            "nextDialogs": [
              "760330306"
            ]
          },
          "760330306": {
            "id": "760330306",
            "speakerId": 15677,
            "speakerName": "执着于食物的幽影",
            "text": "你还得练，下次再来做白灵果酿鸡试试吧。"
          }
        }
      }
    },
    {
      "subId": "7603304",
      "subQuestName": "与执着于食物的幽影对话",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "760330201"
        ],
        "dialogs": {
          "760330201": {
            "id": "760330201",
            "speakerId": 15677,
            "speakerName": "执着于食物的幽影",
            "text": "嗯，热狗里的香肠烤得不错。",
            "nextDialogs": [
              "760330202"
            ]
          },
          "760330202": {
            "id": "760330202",
            "speakerId": 15677,
            "speakerName": "执着于食物的幽影",
            "text": "如果你是在外面的餐厅工作，这个水平够你做帮厨了。",
            "nextDialogs": [
              "760330203"
            ]
          },
          "760330203": {
            "id": "760330203",
            "speakerId": 15677,
            "speakerName": "执着于食物的幽影",
            "text": "但是！我们是要为岛上的所有执灯士供餐，重要的不是菜有多精致，重要的是够吃。",
            "nextDialogs": [
              "760330204"
            ]
          },
          "760330204": {
            "id": "760330204",
            "speakerId": 15677,
            "speakerName": "执着于食物的幽影",
            "text": "面包做厚一点，现在的蔬菜种类太少，除了香肠之外，还可以放点别的肉类。",
            "nextDialogs": [
              "760330205"
            ]
          },
          "760330205": {
            "id": "760330205",
            "speakerId": 15677,
            "speakerName": "执着于食物的幽影",
            "text": "你还得练，下次再来做浆果煎肉试试吧。"
          }
        }
      }
    },

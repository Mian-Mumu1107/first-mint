    {
      "subId": "7603308",
      "subQuestName": "与执着于食物的幽影对话",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "760330401"
        ],
        "dialogs": {
          "760330401": {
            "id": "760330401",
            "speakerId": 15677,
            "speakerName": "执着于食物的幽影",
            "text": "鸡肉足够入味，配菜量也放得够多，你这样我很难挑毛病啊。",
            "nextDialogs": [
              "760330402"
            ]
          },
          "760330402": {
            "id": "760330402",
            "speakerId": 15677,
            "speakerName": "执着于食物的幽影",
            "text": "算了，本来就不是为了难为人才盯着你们这些新人的。",
            "nextDialogs": [
              "760330403"
            ]
          },
          "760330403": {
            "id": "760330403",
            "speakerId": 15677,
            "speakerName": "执着于食物的幽影",
            "text": "我只是个厨子，做好厨子该做的事就行。",
            "nextDialogs": [
              "760330404"
            ]
          },
          "760330404": {
            "id": "760330404",
            "speakerId": 15677,
            "speakerName": "执着于食物的幽影",
            "text": "就算狂猎真的来了，我也做好了准备。",
            "nextDialogs": [
              "760330405"
            ]
          },
          "760330405": {
            "id": "760330405",
            "speakerId": 15677,
            "speakerName": "执着于食物的幽影",
            "text": "只是可惜，来不及把做好的菜送给他们了…饭菜都洒了…洒了…"
          }
        }
      }
    },
    {

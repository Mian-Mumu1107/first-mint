  "subQuests": [
    {
      "subId": "7603301",
      "subQuestName": "(test)隐藏$HIDDEN",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "760330101"
        ],
        "dialogs": {
          "760330101": {
            "id": "760330101",
            "speakerId": 15677,
            "speakerName": "执着于食物的幽影",
            "text": "喂，新来的，菜不能这么做。",
            "nextDialogs": [
              "760330102"
            ]
          },
          "760330102": {
            "id": "760330102",
            "speakerId": 15677,
            "speakerName": "执着于食物的幽影",
            "text": "我们做出来的食物要供给岛上执灯士，得以他们的口味为准。",
            "nextDialogs": [
              "760330103"
            ]
          },
          "760330103": {
            "id": "760330103",
            "speakerId": 15677,
            "speakerName": "执着于食物的幽影",
            "text": "这些菜完全不行，一欠火候，二不符合我们的伙食标准，得改。",
            "nextDialogs": [
              "760330104"
            ]
          },
          "760330104": {
            "id": "760330104",
            "speakerId": 15677,
            "speakerName": "执着于食物的幽影",
            "text": "你还得练，从我们挪德卡莱的本土菜做起吧，比如挪德卡莱热狗，做好了再拿给我看。"
          }
        }
      }
    },

  "subQuests": [
    {
      "subId": "2204701",
      "subQuestName": "与正二对话",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "220470101"
        ],
        "dialogs": {
          "220470101": {
            "id": "220470101",
            "speakerId": 1000,
            "speakerName": "正二",
            "text": "又没射中…到底是哪里出了问题…",
            "nextDialogs": [
              "220470102"
            ]
          },
          "220470102": {
            "id": "220470102",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "你还在练习射箭吗？",
            "nextDialogs": [
              "220470103"
            ]
          },
          "220470103": {
            "id": "220470103",
            "speakerId": 1000,
            "speakerName": "正二",
            "text": "您是上次的…多谢您上次为我做射箭的示范！",
            "nextDialogs": [
              "220470104"
            ]
          },
          "220470104": {
            "id": "220470104",
            "speakerId": 1000,
            "speakerName": "正二",
            "text": "多亏了您，我已经…",
            "nextDialogs": [
              "220470107"
            ]
          },
          "220470107": {
            "id": "220470107",
            "speakerId": 1000,
            "speakerName": "正二",
            "text": "呃，倒也没有到这种地步…",
            "nextDialogs": [
              "220470108"
            ]
          },
          "220470108": {
            "id": "220470108",
            "speakerId": 1000,
            "speakerName": "正二",
            "text": "不过，现在我射出的十支箭里，已经有五支能上靶了…这都是多亏了您的示范。",
            "nextDialogs": [
              "220470109"
            ]
          },
          "220470109": {
            "id": "220470109",
            "speakerId": 1000,
            "speakerName": "正二",
            "text": "虽然离教官的要求还有一段距离，但我还是会继续努力的。",
            "nextDialogs": [
              "220470110"
            ]
          },
          "220470110": {
            "id": "220470110",
            "speakerId": 1000,
            "speakerName": "正二",
            "text": "对了，既然您在这里，能再为我做做示范吗？",
            "nextDialogs": [
              "220470111"
            ]
          },
          "220470111": {
            "id": "220470111",
            "speakerId": 1000,
            "speakerName": "正二",
            "text": "有了您的示范，我一定能进步得更快。"
          }
        }
      }
    },

    {
      "subId": "2204703",
      "subQuestName": "找正二重新布置标靶",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "220470301"
        ],
        "dialogs": {
          "220470301": {
            "id": "220470301",
            "speakerId": 1000,
            "speakerName": "正二",
            "text": "怎么了，您刚才射箭的时候，好像出了点失误…",
            "nextDialogs": [
              "220470302"
            ]
          },
          "220470302": {
            "id": "220470302",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "能重新布置一下标靶吗？",
            "nextDialogs": [
              "220470303"
            ]
          },
          "220470303": {
            "id": "220470303",
            "speakerId": 1000,
            "speakerName": "正二",
            "text": "没问题，我这就去布置标靶，等会您直接过去就好。"
          }
        }
      }
    },
    {
      "subId": "2204704",
      "subQuestName": "与正二对话",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "220470401"
        ],
        "dialogs": {
          "220470401": {
            "id": "220470401",
            "speakerId": 1000,
            "speakerName": "正二",
            "text": "您的射箭技艺，还是和之前一样精湛。",
            "nextDialogs": [
              "220470402"
            ]
          },
          "220470402": {
            "id": "220470402",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "看清楚了吗？",
            "nextDialogs": [
              "220470403"
            ]
          },
          "220470403": {
            "id": "220470403",
            "speakerId": 1000,
            "speakerName": "正二",
            "text": "是的，无论是您握弓的姿势，还是您拉弓的方法…我都认真看清楚了！",
            "nextDialogs": [
              "220470404"
            ]
          },
          "220470404": {
            "id": "220470404",
            "speakerId": 1000,
            "speakerName": "正二",
            "text": "但是，怎么说呢…越是看您的示范，越是能感觉到我和您之间的差距，唉…",
            "nextDialogs": [
              "220470405"
            ]
          },
          "220470405": {
            "id": "220470405",
            "speakerId": 1000,
            "speakerName": "正二",
            "text": "先、先不说这些了，这些东西请您收下，多谢您愿意为我做示范。",
            "nextDialogs": [
              "220470406"
            ]
          },
          "220470406": {
            "id": "220470406",
            "speakerId": 1000,
            "speakerName": "正二",
            "text": "我等会就回去自己接着训练了，下次的目标，就定在…十支箭里上靶七箭吧…"
          }
        }
      }
    }
  ]

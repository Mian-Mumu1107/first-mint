    {
      "subId": "1100403",
      "subQuestName": "与香菱交谈",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "110040301"
        ],
        "dialogs": {
          "110040301": {
            "id": "110040301",
            "speakerId": 1001,
            "speakerName": "香菱",
            "text": "急冻树，急冻树，好吃的~急冻树~",
            "nextDialogs": [
              "110040302"
            ]
          },
          "110040302": {
            "id": "110040302",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "急冻树~",
            "nextDialogs": [
              "110040304",
              "110040306"
            ]
          },
          "110040304": {
            "id": "110040304",
            "speakerId": 1001,
            "speakerName": "香菱",
            "text": "那是你太拘谨了！拿到珍稀的食材，这世界上还会有比这更开心的事吗？",
            "nextDialogs": [
              "110040307"
            ]
          },
          "110040307": {
            "id": "110040307",
            "speakerId": 1001,
            "speakerName": "香菱",
            "text": "啊，这边好像还有什么东西！",
            "nextDialogs": [
              "110040308"
            ]
          },
          "110040308": {
            "id": "110040308",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "这就是猎人先生说的他在追的野猪吧。",
            "nextDialogs": [
              "110040309"
            ]
          },
          "110040309": {
            "id": "110040309",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "但这种花纹从来没有见过…",
            "nextDialogs": [
              "110040310"
            ]
          },
          "110040310": {
            "id": "110040310",
            "speakerId": 1001,
            "speakerName": "香菱",
            "text": "我好像见过这个纹路！我想想，我想想…啊对了，是《璃月风物志》！",
            "nextDialogs": [
              "110040311"
            ]
          },
          "110040311": {
            "id": "110040311",
            "speakerId": 1001,
            "speakerName": "香菱",
            "text": "这种花纹…嗯，不会错的！这是已经灭绝了三百多年的野猪！",
            "nextDialogs": [
              "110040312"
            ]
          },
          "110040312": {
            "id": "110040312",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "欸？！这么长时间，但为什么会还活着？"
          },
          "110040306": {
            "id": "110040306",
            "speakerId": 1001,
            "speakerName": "香菱",
            "text": "哈哈哈，为什么你们唱出来就怪怪的。"
          }
        }
      }
    }
  ]

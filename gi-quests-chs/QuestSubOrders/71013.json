    {
      "subId": "7101303",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "710130301"
        ],
        "dialogs": {
          "710130301": {
            "id": "710130301",
            "speakerId": 20113,
            "speakerName": "遗迹宝藏",
            "text": "世间魔物，是否生而为恶？"
          }
        }
      }
    },
    {
      "subId": "7101305",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "710130501"
        ],
        "dialogs": {
          "710130501": {
            "id": "710130501",
            "speakerId": 20113,
            "speakerName": "遗迹宝藏",
            "text": "世间仙凡，是否生而为善？"
          }
        }
      }
    },
    {
      "subId": "7101314",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "710131401"
        ],
        "dialogs": {
          "710131401": {
            "id": "710131401",
            "speakerId": 20113,
            "speakerName": "遗迹宝藏",
            "text": "后世观此碑者，不知你是否得解那三问。",
            "nextDialogs": [
              "710131402"
            ]
          },
          "710131402": {
            "id": "710131402",
            "speakerId": 20113,
            "speakerName": "遗迹宝藏",
            "text": "你能观见此文，想必也是与我一样的心性…",
            "nextDialogs": [
              "710131403"
            ]
          },
          "710131403": {
            "id": "710131403",
            "speakerId": 20113,
            "speakerName": "遗迹宝藏",
            "text": "<color=#00E1FFFF>若有兴趣，可去池边一探，我在那埋下了些许财帛，你可自取。</color>",
            "nextDialogs": [
              "710131404"
            ]
          },
          "710131404": {
            "id": "710131404",
            "speakerId": 20113,
            "speakerName": "遗迹宝藏",
            "text": "但那三问，请你谨记于心，希望有一天，你能寻得解答…"
          }
        }
      }
    },
    {
      "subId": "7101315",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "710131501"
        ],
        "dialogs": {
          "710131501": {
            "id": "710131501",
            "speakerId": 20113,
            "speakerName": "遗迹宝藏",
            "text": "<color=#00E1FFFF>『神之眼』</color>…实是超凡之物，世人皆说此物是上天所赐。却无人能说出，究竟何人可得此神物，又是为何得此神物。",
            "nextDialogs": [
              "710131502"
            ]
          },
          "710131502": {
            "id": "710131502",
            "speakerId": 20113,
            "speakerName": "遗迹宝藏",
            "text": "我看典籍中，有人说天道悯人，<color=#00E1FFFF>『神之眼』</color>乃是上天赐予凡人中出类拔萃者，助其降妖除魔，卫道世间。但我…却已经对魔物生不出荡涤之意，只想与他们沟通交流，探其本质。",
            "nextDialogs": [
              "710131503"
            ]
          },
          "710131503": {
            "id": "710131503",
            "speakerId": 20113,
            "speakerName": "遗迹宝藏",
            "text": "这<color=#00E1FFFF>『神之眼』</color>…不要也罢了。"
          }
        }
      }
    },
    {
      "subId": "7101316",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "710131601"
        ],
        "dialogs": {
          "710131601": {
            "id": "710131601",
            "speakerId": 20113,
            "speakerName": "遗迹宝藏",
            "text": "后世观此碑者。山中有前碑未观，尚不是观此碑之时。",
            "nextDialogs": [
              "710131602"
            ]
          },
          "710131602": {
            "id": "710131602",
            "speakerId": 20113,
            "speakerName": "遗迹宝藏",
            "text": "若真想解我迷惑，可在山中寻碑，依次观看。"
          }
        }
      }
    },

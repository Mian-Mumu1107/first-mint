    {
      "subId": "7101316",
      "subQuestName": "寻找起始点任务2$HIDDEN",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "710130101"
        ],
        "dialogs": {
          "710130101": {
            "id": "710130101",
            "speakerId": 20113,
            "speakerName": "遗迹宝藏",
            "text": "我与师弟自幼习武，励志除魔卫道。但想要卫道世间，没有<color=#00E1FFFF>『神之眼』</color>相助，又谈何容易。",
            "nextDialogs": [
              "710130102"
            ]
          },
          "710130102": {
            "id": "710130102",
            "speakerId": 20113,
            "speakerName": "遗迹宝藏",
            "text": "我和师弟潜修于此，欲求<color=#00E1FFFF>『神之眼』</color>，立此碑为证。"
          }
        }
      }
    },

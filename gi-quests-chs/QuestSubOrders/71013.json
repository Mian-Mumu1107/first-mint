    {
      "subId": "7101302",
      "subQuestName": "问道本心$HIDDEN",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "710130201"
        ],
        "dialogs": {
          "710130201": {
            "id": "710130201",
            "speakerId": 20113,
            "speakerName": "遗迹宝藏",
            "text": "我虽幸获<color=#00E1FFFF>『神之眼』</color>，但心中亦有疑惑。世间魔物不绝，以凡人之力，何日能荡清世间？而且那些魔物既有言语，也擅工造，亦有喜怒哀乐，除样貌形状外，实与人无异…",
            "nextDialogs": [
              "710130202"
            ]
          },
          "710130202": {
            "id": "710130202",
            "speakerId": 20113,
            "speakerName": "遗迹宝藏",
            "text": "我将心中疑问刻于碑上，不知道后世观此碑者，能否为我解惑？"
          }
        }
      }
    },

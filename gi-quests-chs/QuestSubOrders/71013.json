    {
      "subId": "7101311",
      "subQuestName": "爱的感化$HIDDEN",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "710131001"
        ],
        "dialogs": {
          "710131001": {
            "id": "710131001",
            "speakerId": 20113,
            "speakerName": "遗迹宝藏",
            "text": "我以先前三问问师弟？他却斥我背离本责，又愤愤离去…如能解此三问，或能平定世间。我四处搜寻典籍，潜修于此，并修习魔物言语，希望能探其本质。立碑于此，望后世者能解此三问。",
            "nextDialogs": [
              "710131002"
            ]
          },
          "710131002": {
            "id": "710131002",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "触摸石碑"
          }
        }
      }

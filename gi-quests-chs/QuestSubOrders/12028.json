  },
  "subQuests": [
    {
      "subId": "1202801",
      "subQuestName": "到花见坂逛逛",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "120280101"
        ],
        "dialogs": {
          "120280101": {
            "id": "120280101",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "好久没去八重堂逛逛了，不知道最近有没有什么有意思的新书。上次和影一起读的那本书，感觉还挺有意思的…",
            "nextDialogs": [
              "120280102"
            ]
          },
          "120280102": {
            "id": "120280102",
            "speakerId": 1001,
            "speakerName": "孝利",
            "text": "哎呀，这有什么难决定的！说到愿望那当然就是：获得一大笔摩拉！",
            "nextDialogs": [
              "120280103"
            ]
          },
          "120280103": {
            "id": "120280103",
            "speakerId": 1002,
            "speakerName": "清人",
            "text": "可是下周就要考试了…这次再考不过，我就真玩完了。我还是求自己顺利过关吧。",
            "nextDialogs": [
              "120280104"
            ]
          },
          "120280104": {
            "id": "120280104",
            "speakerId": 1001,
            "speakerName": "孝利",
            "text": "考试算什么！你信我，没有什么是一大笔摩拉解决不了的。如果一笔解决不了，那就两笔！",
            "nextDialogs": [
              "120280105"
            ]
          },
          "120280105": {
            "id": "120280105",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "他们在说什么啊？气氛这么热烈。",
            "nextDialogs": [
              "120280106"
            ]
          },
          "120280106": {
            "id": "120280106",
            "speakerId": 1001,
            "speakerName": "孝利",
            "text": "咦，不会吧，你们还不知道吗？",
            "nextDialogs": [
              "120280107"
            ]
          },
          "120280107": {
            "id": "120280107",
            "speakerId": 1001,
            "speakerName": "孝利",
            "text": "「只要在午夜时分光脚站在土地上，低头念诵特殊的咒语，就能实现心中的愿望！」",
            "nextDialogs": [
              "120280110"
            ]
          },
          "120280110": {
            "id": "120280110",
            "speakerId": 1001,
            "speakerName": "孝利",
            "text": "看来你们是真的不知道啊。这可是最近最灵验的许愿办法，包你心想事成！",
            "nextDialogs": [
              "120280111"
            ]
          },
          "120280111": {
            "id": "120280111",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "许愿？心想事成？",
            "nextDialogs": [
              "120280112"
            ]
          },
          "120280112": {
            "id": "120280112",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "总觉得不太靠谱…",
            "nextDialogs": [
              "120280113"
            ]
          },
          "120280113": {
            "id": "120280113",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "就是就是。就算是派蒙，也很难相信世界上能有这种好事。",
            "nextDialogs": [
              "120280114"
            ]
          },
          "120280114": {
            "id": "120280114",
            "speakerId": 1001,
            "speakerName": "孝利",
            "text": "呵呵，过去我也不信。不过最近，「这种好事」就发生在我身边了！",
            "nextDialogs": [
              "120280115"
            ]
          },
          "120280115": {
            "id": "120280115",
            "speakerId": 1001,
            "speakerName": "孝利",
            "text": "我认识一个叫邦彦的小子，成天不务正业，欠了不少钱。结果呢？几天不见，就穿得人模人样，还在高级饭馆里吃香喝辣了！",
            "nextDialogs": [
              "120280116"
            ]
          },
          "120280116": {
            "id": "120280116",
            "speakerId": 1001,
            "speakerName": "孝利",
            "text": "这可是他亲口告诉我的，就是用了这种许愿的办法，第二天醒来就发现床上堆满了摩拉！",
            "nextDialogs": [
              "120280117"
            ]
          },
          "120280117": {
            "id": "120280117",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "堆、堆堆堆堆满了摩拉？！"
          }
        }
      }
    },
    {
      "subId": "1202802",
      "subQuestName": "调查最近流行的怪谈",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "120280201"
        ],
        "dialogs": {
          "120280201": {
            "id": "120280201",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "仔细一看，城里还真是有挺多人在讨论这个话题的。咦，你看那边的两个人，我记得他们是八重堂的编辑和作者来着。",
            "nextDialogs": [
              "120280202"
            ]
          },
          "120280202": {
            "id": "120280202",
            "speakerId": 1003,
            "speakerName": "顺吉",
            "text": "…念念不息，如…如月煌煌，睦亲于…尔？听我…什么来着，听我愿召？",
            "nextDialogs": [
              "120280203"
            ]
          },
          "120280203": {
            "id": "120280203",
            "speakerId": 1004,
            "speakerName": "阿茂",
            "text": "不对不对，不是「听我愿召」，是「聆我召愿」，唉，这得背到什么时候啊。",
            "nextDialogs": [
              "120280204"
            ]
          },
          "120280204": {
            "id": "120280204",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "喂，你们在做什么呀？",
            "nextDialogs": [
              "120280205"
            ]
          },
          "120280205": {
            "id": "120280205",
            "speakerId": 1003,
            "speakerName": "顺吉",
            "text": "哎呦我的妈呀，吓我一跳。刚才咒语背到哪了来着…",
            "nextDialogs": [
              "120280206"
            ]
          },
          "120280206": {
            "id": "120280206",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "咒语？难道说，你们是在试最近流行的那种许愿方法？",
            "nextDialogs": [
              "120280207"
            ]
          },
          "120280207": {
            "id": "120280207",
            "speakerId": 1004,
            "speakerName": "阿茂",
            "text": "准确地说，是顺吉在试。如你们所见，顺吉最近的创作遇到了瓶颈，我正在帮他通过许愿攻克难关。",
            "nextDialogs": [
              "120280208"
            ]
          },
          "120280208": {
            "id": "120280208",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "没想到你们也相信这个。",
            "nextDialogs": [
              "120280209"
            ]
          },
          "120280209": {
            "id": "120280209",
            "speakerId": 1004,
            "speakerName": "阿茂",
            "text": "我当然不信，不过顺吉向来不听人说话。可我能怎么办，也只能奉陪了。",
            "nextDialogs": [
              "120280210"
            ]
          },
          "120280210": {
            "id": "120280210",
            "speakerId": 1003,
            "speakerName": "顺吉",
            "text": "阿茂先生，拜托你能不能配合我一点，这对我来说真的很重要！",
            "nextDialogs": [
              "120280211"
            ]
          },
          "120280211": {
            "id": "120280211",
            "speakerId": 1003,
            "speakerName": "顺吉",
            "text": "想要变美的、暴富的、学业有成的…各种各样的人都实现了自己的愿望。我只是一个可怜的作家，只想突破瓶颈，我的愿望很过分吗？",
            "nextDialogs": [
              "120280212"
            ]
          },
          "120280212": {
            "id": "120280212",
            "speakerId": 1003,
            "speakerName": "顺吉",
            "text": "而且我的直觉告诉我，这次的办法肯定能成。",
            "nextDialogs": [
              "120280213"
            ]
          },
          "120280213": {
            "id": "120280213",
            "speakerId": 1004,
            "speakerName": "阿茂",
            "text": "可你之前不是才去鸣神大社求过签，说什么「直觉告诉我马上就会有灵感」吗？",
            "nextDialogs": [
              "120280214"
            ]
          },
          "120280214": {
            "id": "120280214",
            "speakerId": 1003,
            "speakerName": "顺吉",
            "text": "去神社求御守开运这种，见效太慢了呀。行了行了，你还是赶快帮我背咒语吧，这次的新作全靠它了！",
            "nextDialogs": [
              "120280215"
            ]
          },
          "120280215": {
            "id": "120280215",
            "speakerId": 1004,
            "speakerName": "阿茂",
            "text": "唉，要我说，你需要的只是坐下来，弄清楚自己到底想写个什么故事。你刚出道的时候，不是特别心高气傲吗？",
            "nextDialogs": [
              "120280216"
            ]
          },
          "120280216": {
            "id": "120280216",
            "speakerId": 1004,
            "speakerName": "阿茂",
            "text": "结果现在，连一本来路不明的轻小说上教的办法都信。",
            "nextDialogs": [
              "120280217"
            ]
          },
          "120280217": {
            "id": "120280217",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "什么？这个许愿办法是轻小说上写的？",
            "nextDialogs": [
              "120280218"
            ]
          },
          "120280218": {
            "id": "120280218",
            "speakerId": 1003,
            "speakerName": "顺吉",
            "text": "对，确实是来自一本叫做《真实探灵笔记》的轻小说。",
            "nextDialogs": [
              "120280219"
            ]
          },
          "120280219": {
            "id": "120280219",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "它是八重堂出版的？",
            "nextDialogs": [
              "120280220"
            ]
          },
          "120280220": {
            "id": "120280220",
            "speakerId": 1003,
            "speakerName": "顺吉",
            "text": "不，这本书应该是自费刊印的，可以说是突然出现并风靡稻妻。",
            "nextDialogs": [
              "120280221"
            ]
          },
          "120280221": {
            "id": "120280221",
            "speakerId": 1003,
            "speakerName": "顺吉",
            "text": "身为同行，我就不谈这本书故事怎么样了，但大家都说上面写的许愿咒语可是货真价实的。",
            "nextDialogs": [
              "120280222"
            ]
          },
          "120280222": {
            "id": "120280222",
            "speakerId": 1004,
            "speakerName": "阿茂",
            "text": "顺吉，虽然大家都说咒语灵验，可我也听说过不少别的传闻：用这种办法实现了愿望的人，行为举止都会变得怪异起来！",
            "nextDialogs": [
              "120280223"
            ]
          },
          "120280223": {
            "id": "120280223",
            "speakerId": 1003,
            "speakerName": "顺吉",
            "text": "这有什么值得大惊小怪的，肯定是被突如其来的喜悦冲昏了头脑啊！",
            "nextDialogs": [
              "120280224"
            ]
          },
          "120280224": {
            "id": "120280224",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "唔，听下来感觉事情有点可疑…",
            "nextDialogs": [
              "120280225"
            ]
          },
          "120280225": {
            "id": "120280225",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "#{NICKNAME}，要不我们去鸣神大社，问一问八重神子吧？",
            "nextDialogs": [
              "120280226"
            ]
          },
          "120280226": {
            "id": "120280226",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "无论是轻小说还是怪谈，她都比较了解！"
          }
        }
      }
    },
    {
      "subId": "1202803",
      "subQuestName": "前往鸣神大社寻找八重神子",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "120280301"
        ],
        "dialogs": {
          "120280301": {
            "id": "120280301",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "神子！太好了你在神社里。",
            "nextDialogs": [
              "120280302"
            ]
          },
          "120280302": {
            "id": "120280302",
            "speakerId": 1005,
            "speakerName": "八重神子",
            "text": "哎呀小家伙，你怎么来了。刚好我这里有本有趣的小说，可以推荐给你看看。",
            "nextDialogs": [
              "120280303"
            ]
          },
          "120280303": {
            "id": "120280303",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "有些事想请教。",
            "nextDialogs": [
              "120280304"
            ]
          },
          "120280304": {
            "id": "120280304",
            "speakerId": 1005,
            "speakerName": "八重神子",
            "text": "哦？你们想问我什么呢？",
            "nextDialogs": [
              "120280305"
            ]
          },
          "120280305": {
            "id": "120280305",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "其实我们刚才…呃，神子，你现在是不是正在忙？",
            "nextDialogs": [
              "120280306"
            ]
          },
          "120280306": {
            "id": "120280306",
            "speakerId": 1005,
            "speakerName": "八重神子",
            "text": "呵呵，不忙不忙，没什么大事。",
            "nextDialogs": [
              "120280307"
            ]
          },
          "120280307": {
            "id": "120280307",
            "speakerId": 1006,
            "speakerName": "加藤洋平",
            "text": "八重宫司大人，这…您怎么能说不是什么大事呢？！求求您了，请您务必救救我哥哥！",
            "nextDialogs": [
              "120280310"
            ]
          },
          "120280310": {
            "id": "120280310",
            "speakerId": 1005,
            "speakerName": "八重神子",
            "text": "其实真不算什么大事。但你们既然好奇，就让他再跟你们讲一遍好了。",
            "nextDialogs": [
              "120280311"
            ]
          },
          "120280311": {
            "id": "120280311",
            "speakerId": 1006,
            "speakerName": "加藤洋平",
            "text": "两位！看来你们与宫司大人交情不浅，请你们一定帮我在宫司大人面前美言几句，请她出面救救我哥哥！",
            "nextDialogs": [
              "120280312"
            ]
          },
          "120280312": {
            "id": "120280312",
            "speakerId": 1006,
            "speakerName": "加藤洋平",
            "text": "事情是这样的：我叫加藤洋平，我哥哥信悟一心想成为剑道家，曾拜明镜止水流的宗家土门为师。",
            "nextDialogs": [
              "120280313"
            ]
          },
          "120280313": {
            "id": "120280313",
            "speakerId": 1006,
            "speakerName": "加藤洋平",
            "text": "可土门却瞧不上我哥哥，说他不是练剑的料。我哥哥心中不平，每日勤学苦练，终于在不久前击败了土门的爱徒，证明了自己。",
            "nextDialogs": [
              "120280314"
            ]
          },
          "120280314": {
            "id": "120280314",
            "speakerId": 1006,
            "speakerName": "加藤洋平",
            "text": "可从那之后，他就突然变得举止怪异，像变了个人，医生也看不出有什么问题。我想，这一定是有了邪祟，就来找宫司大人帮忙…",
            "nextDialogs": [
              "120280315"
            ]
          },
          "120280315": {
            "id": "120280315",
            "speakerId": 1005,
            "speakerName": "八重神子",
            "text": "呼啊啊…哪有那么多邪祟。你哥哥失去了一直以来的目标，会有点失落也是人之常情啦。",
            "nextDialogs": [
              "120280316"
            ]
          },
          "120280316": {
            "id": "120280316",
            "speakerId": 1005,
            "speakerName": "八重神子",
            "text": "要我说，就算不管他，过上几天也自然就好啦。",
            "nextDialogs": [
              "120280317"
            ]
          },
          "120280317": {
            "id": "120280317",
            "speakerId": 1006,
            "speakerName": "加藤洋平",
            "text": "不，宫司大人！如果你见了他就会知道，那绝对不是失落的状态啊！",
            "nextDialogs": [
              "120280318"
            ]
          },
          "120280318": {
            "id": "120280318",
            "speakerId": 1005,
            "speakerName": "八重神子",
            "text": "哎，好吧好吧。那你说说，你哥哥是什么时候跟土门的弟子比试的？",
            "nextDialogs": [
              "120280319"
            ]
          },
          "120280319": {
            "id": "120280319",
            "speakerId": 1006,
            "speakerName": "加藤洋平",
            "text": "大概…五天前吧？",
            "nextDialogs": [
              "120280320"
            ]
          },
          "120280320": {
            "id": "120280320",
            "speakerId": 1005,
            "speakerName": "八重神子",
            "text": "嗯…嗯，五天前啊。",
            "nextDialogs": [
              "120280321"
            ]
          },
          "120280321": {
            "id": "120280321",
            "speakerId": 1006,
            "speakerName": "加藤洋平",
            "text": "宫司大人，所以他已经持续怪异的状态很久了，我真的很担心！",
            "nextDialogs": [
              "120280322"
            ]
          },
          "120280322": {
            "id": "120280322",
            "speakerId": 1006,
            "speakerName": "加藤洋平",
            "text": "我和哥哥最大的愿望，就是有朝一日能像土门那样开宗立派，我们的梦想可绝不能在这个时候出岔子啊！",
            "nextDialogs": [
              "120280323"
            ]
          },
          "120280323": {
            "id": "120280323",
            "speakerId": 1005,
            "speakerName": "八重神子",
            "text": "等等，我都有点糊涂了，你到底是要救哥哥，还是要实现梦想，开宗立派？",
            "nextDialogs": [
              "120280324"
            ]
          },
          "120280324": {
            "id": "120280324",
            "speakerId": 1006,
            "speakerName": "加藤洋平",
            "text": "这…这不是一回事吗？",
            "nextDialogs": [
              "120280325"
            ]
          },
          "120280325": {
            "id": "120280325",
            "speakerId": 1005,
            "speakerName": "八重神子",
            "text": "哦对了，最近你有没有听说过什么有趣的传闻，可以跟我说说啊？",
            "nextDialogs": [
              "120280326"
            ]
          },
          "120280326": {
            "id": "120280326",
            "speakerId": 1006,
            "speakerName": "加藤洋平",
            "text": "什…什么传闻？我…我没听说过！",
            "nextDialogs": [
              "120280327"
            ]
          },
          "120280327": {
            "id": "120280327",
            "speakerId": 1005,
            "speakerName": "八重神子",
            "text": "哎呀，那可真遗憾。",
            "nextDialogs": [
              "120280328"
            ]
          },
          "120280328": {
            "id": "120280328",
            "speakerId": 1006,
            "speakerName": "加藤洋平",
            "text": "宫司大人，您就别再岔开话题了。人命关天的事，还请您务必出手相助！",
            "nextDialogs": [
              "120280329"
            ]
          },
          "120280329": {
            "id": "120280329",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "神子，他的声音都在发抖了，他哥哥的情况好像很严重，你就帮帮他吧。"
          }
        }
      }
    },
    {
      "subId": "1202809",
      "subQuestName": "寻找洋平的兄长",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "120280701"
        ],
        "dialogs": {
          "120280701": {
            "id": "120280701",
            "speakerId": 1006,
            "speakerName": "加藤洋平",
            "text": "奇怪，哥哥前几天经常会坐在这附近冥想的，今天却不见了！",
            "nextDialogs": [
              "120280702"
            ]
          },
          "120280702": {
            "id": "120280702",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "「冥想」？",
            "nextDialogs": [
              "120280703"
            ]
          },
          "120280703": {
            "id": "120280703",
            "speakerId": 1006,
            "speakerName": "加藤洋平",
            "text": "是的，这也是他战胜土门的弟子后，突然有的习惯。经常一个人坐在那里自言自语，怪吓人的…",
            "nextDialogs": [
              "120280704"
            ]
          },
          "120280704": {
            "id": "120280704",
            "speakerId": 1006,
            "speakerName": "加藤洋平",
            "text": "不过现在不是说这个的时候！以哥哥那种状态，现在到底去了哪儿啊？",
            "nextDialogs": [
              "120280705"
            ]
          },
          "120280705": {
            "id": "120280705",
            "speakerId": 1005,
            "speakerName": "八重神子",
            "text": "嗯，这倒的确是个问题。如果找不到你哥哥，就算想驱邪也做不到嘛。",
            "nextDialogs": [
              "120280706"
            ]
          },
          "120280706": {
            "id": "120280706",
            "speakerId": 1005,
            "speakerName": "八重神子",
            "text": "加藤什么平，既然这样，你就先去把你哥哥找到，顺便再帮我们弄一把盐来好了，待会驱邪要用。",
            "nextDialogs": [
              "120280707"
            ]
          },
          "120280707": {
            "id": "120280707",
            "speakerId": 1006,
            "speakerName": "加藤洋平",
            "text": "好…好，我知道了，我现在就去！",
            "nextDialogs": [
              "120280708"
            ]
          },
          "120280708": {
            "id": "120280708",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "神子，那我们呢？我们不用帮忙找人吗？",
            "nextDialogs": [
              "120280709"
            ]
          },
          "120280709": {
            "id": "120280709",
            "speakerId": 1005,
            "speakerName": "八重神子",
            "text": "呵呵，不用不用。这段时间，我们就在附近转转，打听一下这对兄弟，说不定能知道一些有趣的事呢。"
          }
        }
      }
    },
    {
      "subId": "1202810",
      "subQuestName": "向村民打听洋平兄弟",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "120280801"
        ],
        "dialogs": {
          "120280801": {
            "id": "120280801",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "你好，大叔，我们想向你打听一下加藤兄弟！",
            "nextDialogs": [
              "120280802"
            ]
          },
          "120280802": {
            "id": "120280802",
            "speakerId": 1007,
            "speakerName": "伸夫",
            "text": "啊，几位是来催债的吗？洋平说请你们不用担心，等收了徒弟之后很快就能还上…",
            "nextDialogs": [
              "120280803"
            ]
          },
          "120280803": {
            "id": "120280803",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "咦，催债？不是不是，您误会了！",
            "nextDialogs": [
              "120280804"
            ]
          },
          "120280804": {
            "id": "120280804",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "不过听起来，好像洋平和信悟，他们生活很拮据的样子。",
            "nextDialogs": [
              "120280805"
            ]
          },
          "120280805": {
            "id": "120280805",
            "speakerId": 1007,
            "speakerName": "伸夫",
            "text": "拮据？唉，那还不是明摆着的嘛。这对兄弟干什么都没个长性，想一出是一出。",
            "nextDialogs": [
              "120280806"
            ]
          },
          "120280806": {
            "id": "120280806",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "咦？但洋平说他哥哥一心想成为剑道家，还拜土门为师来着。",
            "nextDialogs": [
              "120280807"
            ]
          },
          "120280807": {
            "id": "120280807",
            "speakerId": 1007,
            "speakerName": "伸夫",
            "text": "确实有这么回事儿。土门耐不住信悟央求，答应收他为徒。但信悟高攀上这么一位厉害的师父，依旧成天偷懒，不好好训练。",
            "nextDialogs": [
              "120280808"
            ]
          },
          "120280808": {
            "id": "120280808",
            "speakerId": 1007,
            "speakerName": "伸夫",
            "text": "土门最后忍无可忍，把他逐出门了。可信悟却怀恨在心，说土门有眼无珠，还扬言要和他的弟子一决胜负。",
            "nextDialogs": [
              "120280809"
            ]
          },
          "120280809": {
            "id": "120280809",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "咦，怎么会这样——",
            "nextDialogs": [
              "120280810"
            ]
          },
          "120280810": {
            "id": "120280810",
            "speakerId": 1005,
            "speakerName": "八重神子",
            "text": "呵呵，有意思。「我哥哥心中不平，每日勤学苦练，终于在不久前击败了土门的爱徒，证明了自己。」",
            "nextDialogs": [
              "120280811"
            ]
          },
          "120280811": {
            "id": "120280811",
            "speakerId": 1007,
            "speakerName": "伸夫",
            "text": "这是洋平说的？「勤学苦练」，笑话，整天躺在那骂骂咧咧，那叫勤学苦练吗？",
            "nextDialogs": [
              "120280812"
            ]
          },
          "120280812": {
            "id": "120280812",
            "speakerId": 1007,
            "speakerName": "伸夫",
            "text": "不过洋平那小子确实说过信悟打赢了，但我没把这话当回事。你可以问问村口的健司，他消息灵通。"
          }
        }
      }
    },
    {
      "subId": "1202804",
      "subQuestName": "继续向村民打听情报",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "120280401"
        ],
        "dialogs": {
          "120280401": {
            "id": "120280401",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "你好，我们想向你打听一下加藤兄弟！",
            "nextDialogs": [
              "120280402"
            ]
          },
          "120280402": {
            "id": "120280402",
            "speakerId": 1008,
            "speakerName": "健司",
            "text": "哦，你说信悟和洋平啊。",
            "nextDialogs": [
              "120280403"
            ]
          },
          "120280403": {
            "id": "120280403",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "对，我们听说信悟前一阵子击败了土门的爱徒，这是真的吗？",
            "nextDialogs": [
              "120280404"
            ]
          },
          "120280404": {
            "id": "120280404",
            "speakerId": 1008,
            "speakerName": "健司",
            "text": "哈哈，是真的。你们该不会是听说他们俩要自立门派，过来报名的吧。",
            "nextDialogs": [
              "120280405"
            ]
          },
          "120280405": {
            "id": "120280405",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "虽然不是来报名，不过我们想详细了解一下那场比试。",
            "nextDialogs": [
              "120280406"
            ]
          },
          "120280406": {
            "id": "120280406",
            "speakerId": 1008,
            "speakerName": "健司",
            "text": "那你可问对人了，那场比试我是亲眼看见的。",
            "nextDialogs": [
              "120280407"
            ]
          },
          "120280407": {
            "id": "120280407",
            "speakerId": 1008,
            "speakerName": "健司",
            "text": "一开始听说他要挑战明镜止水流，我还是当笑话的。可信悟把剑一拔出来，嚯，整个人的气势都不一样了。",
            "nextDialogs": [
              "120280408"
            ]
          },
          "120280408": {
            "id": "120280408",
            "speakerId": 1008,
            "speakerName": "健司",
            "text": "那剑术，真叫个行云流水，酣畅淋漓！土门的弟子其实实力不弱，但根本不是对手啊。",
            "nextDialogs": [
              "120280409"
            ]
          },
          "120280409": {
            "id": "120280409",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "信悟真的这么强啊！",
            "nextDialogs": [
              "120280410"
            ]
          },
          "120280410": {
            "id": "120280410",
            "speakerId": 1008,
            "speakerName": "健司",
            "text": "是啊，得胜之后，他还大呼过瘾，说什么「好剑法！俺很久没这么畅快过啦！」",
            "nextDialogs": [
              "120280411"
            ]
          },
          "120280411": {
            "id": "120280411",
            "speakerId": 1005,
            "speakerName": "八重神子",
            "text": "呵呵，还有没有什么别的？我们听说，信悟好像最近性情和之前有些差别？",
            "nextDialogs": [
              "120280412"
            ]
          },
          "120280412": {
            "id": "120280412",
            "speakerId": 1008,
            "speakerName": "健司",
            "text": "应该说是变勤快了？之前他经常一整天什么都不干，就躺在那晒太阳。",
            "nextDialogs": [
              "120280413"
            ]
          },
          "120280413": {
            "id": "120280413",
            "speakerId": 1008,
            "speakerName": "健司",
            "text": "可我昨天看见他帮村长砍树，一下午干完了其他人三天干不完的活，还一脚就把堇瓜树给踢倒了，啧啧。",
            "nextDialogs": [
              "120280414"
            ]
          },
          "120280414": {
            "id": "120280414",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "……",
            "nextDialogs": [
              "120280415"
            ]
          },
          "120280415": {
            "id": "120280415",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "……",
            "nextDialogs": [
              "120280416"
            ]
          },
          "120280416": {
            "id": "120280416",
            "speakerId": 1005,
            "speakerName": "八重神子",
            "text": "嗯，厉害哦。",
            "nextDialogs": [
              "120280417"
            ]
          },
          "120280417": {
            "id": "120280417",
            "speakerId": 1008,
            "speakerName": "健司",
            "text": "不过说来奇怪，村长端来豆腐给他吃，他却大叫着「什么东西，离俺远一点！」一下子跑得不见了。",
            "nextDialogs": [
              "120280418"
            ]
          },
          "120280418": {
            "id": "120280418",
            "speakerId": 1006,
            "speakerName": "加藤洋平",
            "text": "宫司大人，两位大师，可算找到你们了！呼，呼…",
            "nextDialogs": [
              "120280419"
            ]
          },
          "120280419": {
            "id": "120280419",
            "speakerId": 1006,
            "speakerName": "加藤洋平",
            "text": "我找到哥哥了，他就在瀑布那边，盐也拿到了，你们快跟我来！",
            "nextDialogs": [
              "120280420"
            ]
          },
          "120280420": {
            "id": "120280420",
            "speakerId": 1005,
            "speakerName": "八重神子",
            "text": "虽然还想再听点有趣的东西，但既然人找到了，我们就走吧。"
          }
        }
      }
    },
    {
      "subId": "1202805",
      "subQuestName": "(test)村子周围货堆寻找盐",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "120280501"
        ],
        "dialogs": {
          "120280501": {
            "id": "120280501",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "这就是洋平的哥哥吗？呜哇，坐在瀑布里冥想，也太狂野了吧。",
            "nextDialogs": [
              "120280502"
            ]
          },
          "120280502": {
            "id": "120280502",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "仔细听听，他好像在自言自语什么。",
            "nextDialogs": [
              "120280503"
            ]
          },
          "120280503": {
            "id": "120280503",
            "speakerId": 1009,
            "speakerName": "加藤信悟",
            "text": "……",
            "nextDialogs": [
              "120280504"
            ]
          },
          "120280504": {
            "id": "120280504",
            "speakerId": 1009,
            "speakerName": "加藤信悟",
            "text": "呼…呵呵呵…怎样！你…感觉到了吗！",
            "nextDialogs": [
              "120280505"
            ]
          },
          "120280505": {
            "id": "120280505",
            "speakerId": 1006,
            "speakerName": "加藤洋平",
            "text": "咿——",
            "nextDialogs": [
              "120280506"
            ]
          },
          "120280506": {
            "id": "120280506",
            "speakerId": 1009,
            "speakerName": "加藤信悟",
            "text": "有没有感觉到…男子汉的…气概！",
            "nextDialogs": [
              "120280507"
            ]
          },
          "120280507": {
            "id": "120280507",
            "speakerId": 1009,
            "speakerName": "加藤信悟",
            "text": "开宗立派…呵！肤浅…男子汉大丈夫…志向岂可…这等…可笑！",
            "nextDialogs": [
              "120280508"
            ]
          },
          "120280508": {
            "id": "120280508",
            "speakerId": 1009,
            "speakerName": "加藤信悟",
            "text": "…呜…您饶了我…饶了我吧…别、别说气概…温度…温度也感觉不到了…",
            "nextDialogs": [
              "120280509"
            ]
          },
          "120280509": {
            "id": "120280509",
            "speakerId": 1009,
            "speakerName": "加藤信悟",
            "text": "…我…我不行了…我要死了…",
            "nextDialogs": [
              "120280510"
            ]
          },
          "120280510": {
            "id": "120280510",
            "speakerId": 1009,
            "speakerName": "加藤信悟",
            "text": "洋平…洋平！救我…救救我！",
            "nextDialogs": [
              "120280511"
            ]
          },
          "120280511": {
            "id": "120280511",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "#你听到了吗，{NICKNAME}？他虽然讲话乱七八糟的，但确实是在求救！",
            "nextDialogs": [
              "120280512"
            ]
          },
          "120280512": {
            "id": "120280512",
            "speakerId": 1009,
            "speakerName": "加藤信悟",
            "text": "嗯？何人…在此？",
            "nextDialogs": [
              "120280513"
            ]
          },
          "120280513": {
            "id": "120280513",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "他从瀑布里站起来，朝这边过来了！",
            "nextDialogs": [
              "120280514"
            ]
          },
          "120280514": {
            "id": "120280514",
            "speakerId": 1006,
            "speakerName": "加藤洋平",
            "text": "别！别过来！",
            "nextDialogs": [
              "120280515"
            ]
          },
          "120280515": {
            "id": "120280515",
            "speakerId": 1006,
            "speakerName": "加藤洋平",
            "text": "救命啊！",
            "nextDialogs": [
              "120280516"
            ]
          },
          "120280516": {
            "id": "120280516",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "#现在应该怎么办？{NICKNAME}，神子！你们快想想办法！",
            "nextDialogs": [
              "120280517"
            ]
          },
          "120280517": {
            "id": "120280517",
            "speakerId": 1005,
            "speakerName": "八重神子",
            "text": "哎呀呀，真可怜啊。",
            "nextDialogs": [
              "120280518"
            ]
          },
          "120280518": {
            "id": "120280518",
            "speakerId": 1005,
            "speakerName": "八重神子",
            "text": "洋平，你兄长的气息已经很微弱了，他在用最后的力气拼命地向你呼救，应该怎么办哪？",
            "nextDialogs": [
              "120280519"
            ]
          },
          "120280519": {
            "id": "120280519",
            "speakerId": 1006,
            "speakerName": "加藤洋平",
            "text": "呜…我、我也不知道应该怎么办啊！",
            "nextDialogs": [
              "120280520"
            ]
          },
          "120280520": {
            "id": "120280520",
            "speakerId": 1005,
            "speakerName": "八重神子",
            "text": "依我看，信悟他好像对你有很大的怨恨，这到底是怎么回事呀？",
            "nextDialogs": [
              "120280521"
            ]
          },
          "120280521": {
            "id": "120280521",
            "speakerId": 1006,
            "speakerName": "加藤洋平",
            "text": "我不知道！我什么都不知道！",
            "nextDialogs": [
              "120280522"
            ]
          },
          "120280522": {
            "id": "120280522",
            "speakerId": 1005,
            "speakerName": "八重神子",
            "text": "你不知道？你哥哥为什么变成这副样子，你不是应该比谁都清楚吗？",
            "nextDialogs": [
              "120280523"
            ]
          },
          "120280523": {
            "id": "120280523",
            "speakerId": 1005,
            "speakerName": "八重神子",
            "text": "洋平，说话前可要好好考虑清楚，这可是事关生死哪。",
            "nextDialogs": [
              "120280524"
            ]
          },
          "120280524": {
            "id": "120280524",
            "speakerId": 1006,
            "speakerName": "加藤洋平",
            "text": "呜！这、这…",
            "nextDialogs": [
              "120280525"
            ]
          },
          "120280525": {
            "id": "120280525",
            "speakerId": 1005,
            "speakerName": "八重神子",
            "text": "至亲之人，举止怪异，你应该第一时间就能察觉。",
            "nextDialogs": [
              "120280526"
            ]
          },
          "120280526": {
            "id": "120280526",
            "speakerId": 1005,
            "speakerName": "八重神子",
            "text": "可事发五天，你才想起来找我，难道你还觉得可以自圆其说？",
            "nextDialogs": [
              "120280527"
            ]
          },
          "120280527": {
            "id": "120280527",
            "speakerId": 1006,
            "speakerName": "加藤洋平",
            "text": "我——",
            "nextDialogs": [
              "120280528"
            ]
          },
          "120280528": {
            "id": "120280528",
            "speakerId": 1005,
            "speakerName": "八重神子",
            "text": "好吧，不肯说实话也没关系。",
            "nextDialogs": [
              "120280529"
            ]
          },
          "120280529": {
            "id": "120280529",
            "speakerId": 1005,
            "speakerName": "八重神子",
            "text": "不过，信悟死后，下一个就轮到你了。",
            "nextDialogs": [
              "120280530"
            ]
          },
          "120280530": {
            "id": "120280530",
            "speakerId": 1005,
            "speakerName": "八重神子",
            "text": "就算你跑到天涯海角，它也会紧紧跟在你的背后。毕竟…是你们把它召出来的嘛。",
            "nextDialogs": [
              "120280531"
            ]
          },
          "120280531": {
            "id": "120280531",
            "speakerId": 1006,
            "speakerName": "加藤洋平",
            "text": "咿呀啊啊啊啊啊——",
            "nextDialogs": [
              "120280532"
            ]
          },
          "120280532": {
            "id": "120280532",
            "speakerId": 1006,
            "speakerName": "加藤洋平",
            "text": "我说，我说！我什么都说！我和哥哥用咒语许愿了！我们许愿了！",
            "nextDialogs": [
              "120280535"
            ]
          },
          "120280535": {
            "id": "120280535",
            "speakerId": 1006,
            "speakerName": "加藤洋平",
            "text": "对，对，就是最近特别流行的那个！在半夜默念咒语，就可以实现愿望！",
            "nextDialogs": [
              "120280536"
            ]
          },
          "120280536": {
            "id": "120280536",
            "speakerId": 1006,
            "speakerName": "加藤洋平",
            "text": "我和哥哥按照书上说的画好了阵法，半夜光脚站在里面，念了咒语之后，阵法周围真的出现了好几团光亮！",
            "nextDialogs": [
              "120280537"
            ]
          },
          "120280537": {
            "id": "120280537",
            "speakerId": 1006,
            "speakerName": "加藤洋平",
            "text": "我哥哥许愿成为剑道家之后，果然获得了以前没有的剑道天赋，可是性情也变了！"
          }
        }
      }
    },
    {
      "subId": "1202806",
      "subQuestName": "对加藤信悟进行「驱邪」",
      "sceneId": null,
      "locations": [],
      "dialogue": {

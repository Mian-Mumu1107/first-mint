        "dialogs": {}
      }
    },
    {
      "subId": "1202807",
      "subQuestName": "战胜附身在信悟身上的灵魂",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [],
        "dialogs": {}
      }
    },
    {
      "subId": "1202808",
      "subQuestName": "调查附灵背后的真相",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "120280601"
        ],
        "dialogs": {
          "120280601": {
            "id": "120280601",
            "speakerId": 1010,
            "speakerName": "荒川幸次",
            "text": "呵呵，哈哈哈哈…不错，真不错！好尽兴！",
            "nextDialogs": [
              "120280602"
            ]
          },
          "120280602": {
            "id": "120280602",
            "speakerId": 1010,
            "speakerName": "荒川幸次",
            "text": "俺已经很久…没这么痛快过啦！",
            "nextDialogs": [
              "120280603"
            ]
          },
          "120280603": {
            "id": "120280603",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "他消失了，而且还一副很满足的样子？",
            "nextDialogs": [
              "120280604"
            ]
          },
          "120280604": {
            "id": "120280604",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "#呃，我已经有点看不懂了，{NICKNAME}，你知道这究竟是怎么回事吗？",
            "nextDialogs": [
              "120280607"
            ]
          },
          "120280607": {
            "id": "120280607",
            "speakerId": 1005,
            "speakerName": "八重神子",
            "text": "嘘，这件事待会儿再说，他们俩要醒了。",
            "nextDialogs": [
              "120280608"
            ]
          },
          "120280608": {
            "id": "120280608",
            "speakerId": 1009,
            "speakerName": "加藤信悟",
            "text": "咳…咳咳，我怎么在这里…洋平？是你吗洋平？",
            "nextDialogs": [
              "120280609"
            ]
          },
          "120280609": {
            "id": "120280609",
            "speakerId": 1006,
            "speakerName": "加藤洋平",
            "text": "哥哥！你没事了吗？",
            "nextDialogs": [
              "120280610"
            ]
          },
          "120280610": {
            "id": "120280610",
            "speakerId": 1009,
            "speakerName": "加藤信悟",
            "text": "洋平？我好像做了一个梦…",
            "nextDialogs": [
              "120280611"
            ]
          },
          "120280611": {
            "id": "120280611",
            "speakerId": 1009,
            "speakerName": "加藤信悟",
            "text": "我梦见我终于不再是一个只会挥剑的废物，还打赢了土门的弟子。",
            "nextDialogs": [
              "120280612"
            ]
          },
          "120280612": {
            "id": "120280612",
            "speakerId": 1009,
            "speakerName": "加藤信悟",
            "text": "我心想这下我们也能开道场了，但我却发现我的身体不受我的控制，耳边还有个声音一直在和我说话。",
            "nextDialogs": [
              "120280613"
            ]
          },
          "120280613": {
            "id": "120280613",
            "speakerId": 1009,
            "speakerName": "加藤信悟",
            "text": "我害怕极了，想把自己的身体夺回来，可却怎么都办不到，那个声音还一直在说什么男子汉的气概…",
            "nextDialogs": [
              "120280614"
            ]
          },
          "120280614": {
            "id": "120280614",
            "speakerId": 1006,
            "speakerName": "加藤洋平",
            "text": "哥哥，我们之前不该许愿的，我们招出来了鬼怪，是它控制了你！",
            "nextDialogs": [
              "120280615"
            ]
          },
          "120280615": {
            "id": "120280615",
            "speakerId": 1005,
            "speakerName": "八重神子",
            "text": "是啊，如果不是我们出手，你的小命很快就没了。鬼魂接下来就会缠住你弟弟，最终他也会虚弱而死哦。",
            "nextDialogs": [
              "120280616"
            ]
          },
          "120280616": {
            "id": "120280616",
            "speakerId": 1006,
            "speakerName": "加藤洋平",
            "text": "多谢宫司大人！多谢两位大师相救！",
            "nextDialogs": [
              "120280617"
            ]
          },
          "120280617": {
            "id": "120280617",
            "speakerId": 1005,
            "speakerName": "八重神子",
            "text": "行了，带他去休息吧。被附身了这么多天，他的身体已经很虚弱了。",
            "nextDialogs": [
              "120280618"
            ]
          },
          "120280618": {
            "id": "120280618",
            "speakerId": 1005,
            "speakerName": "八重神子",
            "text": "之后他会发一次高烧，但不至于丢了性命。记住，这是代价。",
            "nextDialogs": [
              "120280619"
            ]
          },
          "120280619": {
            "id": "120280619",
            "speakerId": 1005,
            "speakerName": "八重神子",
            "text": "想靠歪门邪道获得不属于你们的力量，会有什么下场，不用我再说了吧？",
            "nextDialogs": [
              "120280620"
            ]
          },
          "120280620": {
            "id": "120280620",
            "speakerId": 1009,
            "speakerName": "加藤信悟",
            "text": "是…我们明白了！我们再也不敢了！",
            "nextDialogs": [
              "120280621"
            ]
          },
          "120280621": {
            "id": "120280621",
            "speakerId": 1006,
            "speakerName": "加藤洋平",
            "text": "多谢宫司大人，多谢两位大师！",
            "nextDialogs": [
              "120280622"
            ]
          },
          "120280622": {
            "id": "120280622",
            "speakerId": 1006,
            "speakerName": "加藤洋平",
            "text": "那我们先告辞了。哥哥，走吧。",
            "nextDialogs": [
              "120280623"
            ]
          },
          "120280623": {
            "id": "120280623",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "神子，如果我们放着他们不管的话，他们两个真的会送命吗？",
            "nextDialogs": [
              "120280624"
            ]
          },
          "120280624": {
            "id": "120280624",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "这么严重的事情，为什么你之前还不愿意帮忙啊！",
            "nextDialogs": [
              "120280625"
            ]
          },
          "120280625": {
            "id": "120280625",
            "speakerId": 1005,
            "speakerName": "八重神子",
            "text": "呵，当然送不了命啦。",
            "nextDialogs": [
              "120280626"
            ]
          },
          "120280626": {
            "id": "120280626",
            "speakerId": 1005,
            "speakerName": "八重神子",
            "text": "不这么吓唬吓唬他们，这两个好吃懒做的家伙怎么可能长记性嘛。",
            "nextDialogs": [
              "120280627"
            ]
          },
          "120280627": {
            "id": "120280627",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "那附在他身上的…",
            "nextDialogs": [
              "120280628"
            ]
          },
          "120280628": {
            "id": "120280628",
            "speakerId": 1005,
            "speakerName": "八重神子",
            "text": "刚才经历了这么多，你们大概也能感觉到，附在他身上的究竟是什么样的鬼魂吧？"
          }
        }
      }
    },
    {
      "subId": "1202809",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "120280901"
        ],
        "dialogs": {
          "120280901": {
            "id": "120280901",
            "speakerId": 1001,
            "speakerName": "孝利",
            "text": "拜托了，我的摩拉！摩拉摩拉摩拉…",
            "nextDialogs": [
              "120280902"
            ]
          },
          "120280902": {
            "id": "120280902",
            "speakerId": 1002,
            "speakerName": "清人",
            "text": "我没那么贪心，只要能顺利通过考试就好了…"
          }
        }
      }
    },
    {
      "subId": "1202810",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "120281001"
        ],
        "dialogs": {
          "120281001": {
            "id": "120281001",
            "speakerId": 1003,
            "speakerName": "顺吉",
            "text": "念念不息，如月煌煌…下一句是什么来着？",
            "nextDialogs": [
              "120281002"
            ]
          },
          "120281002": {
            "id": "120281002",
            "speakerId": 1004,
            "speakerName": "阿茂",
            "text": "顺吉，放弃吧，难道还能天降一位大佬帮你把小说写了不成？你以为这是轻小说剧情吗？",
            "nextDialogs": [
              "120281003"
            ]
          },
          "120281003": {
            "id": "120281003",
            "speakerId": 1003,
            "speakerName": "顺吉",
            "text": "阿茂先生，能不能别打击我的梦想，我现在真的很痛苦啊！"
          }
        }
      }
    },
    {
      "subId": "1202811",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "120281101"
        ],
        "dialogs": {
          "120281101": {
            "id": "120281101",
            "speakerId": 1007,
            "speakerName": "伸夫",
            "text": "我以前也经常劝信悟好好找点正经事做，不要空耗时光。",
            "nextDialogs": [
              "120281102"
            ]
          },
          "120281102": {
            "id": "120281102",
            "speakerId": 1007,
            "speakerName": "伸夫",
            "text": "他们父母过世得早，他又是哥哥，成天没个正形怎么行？不过我的话他听不进去呀。",
            "nextDialogs": [
              "120281103"
            ]
          },
          "120281103": {
            "id": "120281103",
            "speakerId": 1007,
            "speakerName": "伸夫",
            "text": "要我说，他还是没真正吃到苦头，不懂得做人要脚踏实地啊。"
          }
        }
      }
    },
    {
      "subId": "1202812",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "120281201"
        ],
        "dialogs": {
          "120281201": {
            "id": "120281201",
            "speakerId": 1008,
            "speakerName": "健司",
            "text": "信悟最近挺精神的，但不知为什么，洋平却看起来闷闷不乐。他们不是马上要收徒弟了吗？",
            "nextDialogs": [
              "120281202"
            ]
          },
          "120281202": {
            "id": "120281202",
            "speakerId": 1008,
            "speakerName": "健司",
            "text": "或许是因为突然有了责任感？洋平也成长了啊。"
          }
        }
      }
    }
  ]
}
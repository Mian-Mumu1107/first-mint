    {
      "subId": "7905501",
      "subQuestName": "(test)阅读广告牌$HIDDEN",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "790550101"
        ],
        "dialogs": {
          "790550101": {
            "id": "790550101",
            "speakerId": 1000,
            "speakerName": "片场备注",
            "text": "此处为短剧《断船遗梦》片场的弃用场景",
            "nextDialogs": [
              "790550102"
            ]
          },
          "790550102": {
            "id": "790550102",
            "speakerId": 1000,
            "speakerName": "片场备注",
            "text": "原本构想的，是在一艘漂浮的断船上，两只水形幻灵坠入爱河的故事。",
            "nextDialogs": [
              "790550103"
            ]
          },
          "790550103": {
            "id": "790550103",
            "speakerId": 1000,
            "speakerName": "片场备注",
            "text": "在它们互相表明心迹之后，于夕阳的余晖之中立于船头的场景想必相当浪漫。",
            "nextDialogs": [
              "790550104"
            ]
          },
          "790550104": {
            "id": "790550104",
            "speakerId": 1000,
            "speakerName": "片场备注",
            "text": "然而，之所以该片场被弃用，是因为…作为演员的两只水形幻灵性格过于活泼，根本无法停止行动。",
            "nextDialogs": [
              "790550105"
            ]
          },
          "790550105": {
            "id": "790550105",
            "speakerId": 1000,
            "speakerName": "片场备注",
            "text": "唔，如果能够捕捉到<color=#00E1FFFF>两只同时出现在船头</color>的场景就好了…",
            "nextDialogs": [
              "790550106"
            ]
          },
          "790550106": {
            "id": "790550106",
            "speakerId": 1000,
            "speakerName": "片场备注",
            "text": "——「导演」"
          }
        }
      }
    },

  },
  "subQuests": [
    {
      "subId": "2051401",
      "subQuestName": "与安东尼对话",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "205140101"
        ],
        "dialogs": {
          "205140101": {
            "id": "205140101",
            "speakerId": 1000,
            "speakerName": "安东尼",
            "text": "这叫什么事啊…",
            "nextDialogs": [
              "205140102"
            ]
          },
          "205140102": {
            "id": "205140102",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "怎么了？",
            "nextDialogs": [
              "205140103"
            ]
          },
          "205140103": {
            "id": "205140103",
            "speakerId": 1000,
            "speakerName": "安东尼",
            "text": "是你啊，来得正好…自从吃了那位神医的药，安娜的病逐渐好了。",
            "nextDialogs": [
              "205140104"
            ]
          },
          "205140104": {
            "id": "205140104",
            "speakerId": 1000,
            "speakerName": "安东尼",
            "text": "她之前身体不好，必须要静养，在家里憋了太久。",
            "nextDialogs": [
              "205140105"
            ]
          },
          "205140105": {
            "id": "205140105",
            "speakerId": 1000,
            "speakerName": "安东尼",
            "text": "现在她身体好起来了，每天都和我闹着要出去玩，我拗不过她，就答应了。",
            "nextDialogs": [
              "205140106"
            ]
          },
          "205140106": {
            "id": "205140106",
            "speakerId": 1000,
            "speakerName": "安东尼",
            "text": "但是…现在我压根就找不到她了。这丫头到底跑到哪去玩了，你快点帮我找找吧！",
            "nextDialogs": [
              "205140108",
              "205140111",
              "205140114"
            ]
          },
          "205140108": {
            "id": "205140108",
            "speakerId": 1000,
            "speakerName": "安东尼",
            "text": "我在这里等着，你快点去吧。",
            "nextDialogs": [
              "205140109"
            ]
          },
          "205140109": {
            "id": "205140109",
            "speakerId": 1000,
            "speakerName": "安东尼",
            "text": "这丫头，身体刚有点起色就瞎折腾，要是再出什么事怎么办…",
            "nextDialogs": [
              "205140116"
            ]
          },
          "205140116": {
            "id": "205140116",
            "speakerId": 1000,
            "speakerName": "安东尼",
            "text": "我已经在城里找了很久…就差冒险家协会那一片没找过，但是我实在是没力气了…",
            "nextDialogs": [
              "205140117"
            ]
          },
          "205140117": {
            "id": "205140117",
            "speakerId": 1000,
            "speakerName": "安东尼",
            "text": "你就先去冒险家协会那一片找找看吧。还有，说不定塞琉斯先生会注意到什么…",
            "nextDialogs": [
              "205140118"
            ]
          },
          "205140118": {
            "id": "205140118",
            "speakerId": 1000,
            "speakerName": "安东尼",
            "text": "希望能找到，不然我还得接着去找…"
          },
          "205140111": {
            "id": "205140111",
            "speakerId": 1000,
            "speakerName": "安东尼",
            "text": "高兴？别，别开玩笑了，这丫头身体刚好一点，就开始这么闹腾。",
            "nextDialogs": [
              "205140112"
            ]
          },
          "205140112": {
            "id": "205140112",
            "speakerId": 1000,
            "speakerName": "安东尼",
            "text": "等她回来了，有她好看的！"
          },
          "205140114": {
            "id": "205140114",
            "speakerId": 1000,
            "speakerName": "安东尼",
            "text": "你当我妹妹是猫吗…再说她病刚好，怎么能饿肚子。",
            "nextDialogs": [
              "205140115"
            ]
          },
          "205140115": {
            "id": "205140115",
            "speakerId": 1000,
            "speakerName": "安东尼",
            "text": "好了好了，你快帮我找找吧，我就在这等你。"
          }
        }
      }
    },
    {
      "subId": "2051402",
      "subQuestName": "寻找安娜",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "205140201"
        ],
        "dialogs": {
          "205140201": {
            "id": "205140201",
            "speakerId": 1001,
            "speakerName": "安娜",
            "text": "好高…这里哥哥应该找不到了。",
            "nextDialogs": [
              "205140202"
            ]
          },
          "205140202": {
            "id": "205140202",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "你在这做什么…",
            "nextDialogs": [
              "205140203"
            ]
          },
          "205140203": {
            "id": "205140203",
            "speakerId": 1001,
            "speakerName": "安娜",
            "text": "哇！你是怎么上来的，怎么一点动静都没有？",
            "nextDialogs": [
              "205140204"
            ]
          },
          "205140204": {
            "id": "205140204",
            "speakerId": 1001,
            "speakerName": "安娜",
            "text": "还有你是怎么找到我的？",
            "nextDialogs": [
              "205140205"
            ]
          },
          "205140205": {
            "id": "205140205",
            "speakerId": 1001,
            "speakerName": "安娜",
            "text": "我？我就是，爬着爬着就上来啦。",
            "nextDialogs": [
              "205140206"
            ]
          },
          "205140206": {
            "id": "205140206",
            "speakerId": 1001,
            "speakerName": "安娜",
            "text": "哥哥在找我？咦，怎么都这个时间了，完全没有注意。",
            "nextDialogs": [
              "205140207"
            ]
          },
          "205140207": {
            "id": "205140207",
            "speakerId": 1001,
            "speakerName": "安娜",
            "text": "我知道啦，我马上就回去啦，再在这里呆一会…"
          }
        }
      }
    },
    {
      "subId": "2051403",
      "subQuestName": "与安东尼对话",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "205140301"
        ],
        "dialogs": {
          "205140301": {
            "id": "205140301",
            "speakerId": 1000,
            "speakerName": "安东尼",
            "text": "你找到安娜了吗？",
            "nextDialogs": [
              "205140302"
            ]
          },
          "205140302": {
            "id": "205140302",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "安娜在一架风车上。",
            "nextDialogs": [
              "205140303"
            ]
          },
          "205140303": {
            "id": "205140303",
            "speakerId": 1000,
            "speakerName": "安东尼",
            "text": "风车？！这丫头是怎么上去的！我马上就去找西风骑士！",
            "nextDialogs": [
              "205140304"
            ]
          },
          "205140304": {
            "id": "205140304",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "她说她等会就回来…",
            "nextDialogs": [
              "205140305"
            ]
          },
          "205140305": {
            "id": "205140305",
            "speakerId": 1000,
            "speakerName": "安东尼",
            "text": "是，是这样吗，没事就好，吓死我了，我还以为她被困在风车上下不来了呢。",
            "nextDialogs": [
              "205140306"
            ]
          },
          "205140306": {
            "id": "205140306",
            "speakerId": 1000,
            "speakerName": "安东尼",
            "text": "谢谢你，我马上就去找她。",
            "nextDialogs": [
              "205140307"
            ]
          },
          "205140307": {
            "id": "205140307",
            "speakerId": 1000,
            "speakerName": "安东尼",
            "text": "病刚好就开始折腾，我非要好好训训她不可…"
          }
        }
      }
    },
    {
      "subId": "2051404",
      "subQuestName": "与塞琉斯对话$HIDDEN",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "205140401"
        ],
        "dialogs": {
          "205140401": {
            "id": "205140401",
            "speakerId": 1002,
            "speakerName": "塞琉斯",
            "text": "唔？真是稀奇，你怎么来了？",
            "nextDialogs": [
              "205140402"
            ]
          },
          "205140402": {
            "id": "205140402",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "你有没有见过一个女孩…",
            "nextDialogs": [
              "205140403"
            ]
          },
          "205140403": {
            "id": "205140403",
            "speakerId": 1002,
            "speakerName": "塞琉斯",
            "text": "女孩？哦，你是说安娜吗？我看见了，她刚才往那边的风车跑了。",
            "nextDialogs": [
              "205140404"
            ]
          },
          "205140404": {
            "id": "205140404",
            "speakerId": 1002,
            "speakerName": "塞琉斯",
            "text": "我还在奇怪呢，那孩子不是身体不好吗，怎么突然这么有活力了。",
            "nextDialogs": [
              "205140405"
            ]
          },
          "205140405": {
            "id": "205140405",
            "speakerId": 1002,
            "speakerName": "塞琉斯",
            "text": "给我打了声招呼之后，就跑过去了。",
            "nextDialogs": [
              "205140406"
            ]
          },
          "205140406": {
            "id": "205140406",
            "speakerId": 1002,
            "speakerName": "塞琉斯",
            "text": "这孩子，病是什么时候好的…你有头绪吗？"
          }
        }
      }
    },
    {
      "subId": "2051405",
      "subQuestName": "寻找安娜",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "205140501"
        ],
        "dialogs": {
          "205140501": {
            "id": "205140501",
            "speakerId": 1001,
            "speakerName": "安娜",
            "text": "好高…这里哥哥应该找不到了。",
            "nextDialogs": [
              "205140502"
            ]
          },
          "205140502": {
            "id": "205140502",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "你在这做什么…",
            "nextDialogs": [
              "205140503"
            ]
          },
          "205140503": {
            "id": "205140503",
            "speakerId": 1001,
            "speakerName": "安娜",
            "text": "呜哇！你是怎么上来的，怎么一点动静都没有？",
            "nextDialogs": [
              "205140504"
            ]
          },
          "205140504": {
            "id": "205140504",
            "speakerId": 1001,
            "speakerName": "安娜",
            "text": "还有，你是怎么找到我的？",
            "nextDialogs": [
              "205140505"
            ]
          },
          "205140505": {
            "id": "205140505",
            "speakerId": 1001,
            "speakerName": "安娜",
            "text": "喔，我知道了，一定是塞琉斯先生告诉你的吧。",
            "nextDialogs": [
              "205140506"
            ]
          },
          "205140506": {
            "id": "205140506",
            "speakerId": 1001,
            "speakerName": "安娜",
            "text": "他之前很照顾我和哥哥，我路过的时候就和他打了个招呼，他还一副很惊讶的样子呢。",
            "nextDialogs": [
              "205140507"
            ]
          },
          "205140507": {
            "id": "205140507",
            "speakerId": 1001,
            "speakerName": "安娜",
            "text": "嗯…我要不要去冒险家协会试试呢，成为一个冒险家，说不定也不错呢…",
            "nextDialogs": [
              "205140508"
            ]
          },
          "205140508": {
            "id": "205140508",
            "speakerId": 1001,
            "speakerName": "安娜",
            "text": "什么？哥哥在找我？咦，怎么都这个时间了，完全没有注意到！",
            "nextDialogs": [
              "205140509"
            ]
          },
          "205140509": {
            "id": "205140509",
            "speakerId": 1001,
            "speakerName": "安娜",
            "text": "我知道啦，再在这里呆一会，我就会自己回去啦。"
          }
        }
      }
    },
    {
      "subId": "2051406",
      "subQuestName": "与安东尼对话",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "205140601"
        ],
        "dialogs": {
          "205140601": {
            "id": "205140601",
            "speakerId": 1000,
            "speakerName": "安东尼",
            "text": "你找到安娜了吗？",
            "nextDialogs": [
              "205140602"
            ]
          },
          "205140602": {
            "id": "205140602",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "安娜在一架风车上。",
            "nextDialogs": [
              "205140603"
            ]
          },
          "205140603": {
            "id": "205140603",
            "speakerId": 1000,
            "speakerName": "安东尼",
            "text": "风车？！这丫头是怎么上去的！我马上就去…",
            "nextDialogs": [
              "205140604"
            ]
          },
          "205140604": {
            "id": "205140604",
            "speakerId": 1000,
            "speakerName": "安东尼",
            "text": "什么？她说想试试看成为一个冒险家？",
            "nextDialogs": [
              "205140605"
            ]
          },
          "205140605": {
            "id": "205140605",
            "speakerId": 1000,
            "speakerName": "安东尼",
            "text": "病还没完全痊愈，她也想得太远了！",
            "nextDialogs": [
              "205140606"
            ]
          },
          "205140606": {
            "id": "205140606",
            "speakerId": 1000,
            "speakerName": "安东尼",
            "text": "只要她病好了，她就是想全世界旅行一圈我都没有一点意见。",
            "nextDialogs": [
              "205140607"
            ]
          },
          "205140607": {
            "id": "205140607",
            "speakerId": 1000,
            "speakerName": "安东尼",
            "text": "谢谢你，我马上就去找她。病刚好就开始折腾，我非要好好训训她不可…"
          }
        }
      }
    },
    {
      "subId": "2051407",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "205140701"
        ],
        "dialogs": {
          "205140701": {
            "id": "205140701",
            "speakerId": 1000,
            "speakerName": "安东尼",
            "text": "等找到安娜了，我一定要好好教训一下她。"
          }
        }
      }
    },
    {
      "subId": "2051408",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "205140801"
        ],
        "dialogs": {
          "205140801": {
            "id": "205140801",
            "speakerId": 1001,
            "speakerName": "安娜",
            "text": "这里的风感觉真好，真想再去更远的地方看看哪。"
          }
        }
      }
    },
    {
      "subId": "2051409",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [

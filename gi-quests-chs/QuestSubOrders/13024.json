{
  "lineCounts": {
    "Black Screen": 1,
    "Player": 23,
    "哈伦": 24,
    "哈拉夫": 7,
    "希沙姆": 9,
    "派蒙": 38,
    "萨塔尔": 4,
    "观察": 3,
    "迪娜泽黛": 24,
    "迪希雅": 125,
    "？？？": 3
  },
  "subQuests": [
    {
      "subId": "1302401",
      "subQuestName": "前往大巴扎",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "130240101"
        ],
        "dialogs": {
          "130240101": {
            "id": "130240101",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "让我想想，按之前的计划，我们还需要买什么。",
            "nextDialogs": [
              "130240102"
            ]
          },
          "130240102": {
            "id": "130240102",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "哦，好香的味道，是「兽米香香」！我们买一点吧！",
            "nextDialogs": [
              "130240103"
            ]
          },
          "130240103": {
            "id": "130240103",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "应该不在计划内？",
            "nextDialogs": [
              "130240104"
            ]
          },
          "130240104": {
            "id": "130240104",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "那…那现在加上去。",
            "nextDialogs": [
              "130240105"
            ]
          },
          "130240105": {
            "id": "130240105",
            "speakerId": 1052,
            "speakerName": "迪希雅",
            "text": "#这不是{NICKNAME}和派蒙嘛，我们居然会在这里碰到。",
            "nextDialogs": [
              "130240106"
            ]
          },
          "130240106": {
            "id": "130240106",
            "speakerId": 13013,
            "speakerName": "迪娜泽黛",
            "text": "你们好啊，好久不见了。",
            "nextDialogs": [
              "130240107"
            ]
          },
          "130240107": {
            "id": "130240107",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "欸？居然又是你们两个人的组合，迪希雅你不是已经回沙漠了嘛。",
            "nextDialogs": [
              "130240108"
            ]
          },
          "130240108": {
            "id": "130240108",
            "speakerId": 1052,
            "speakerName": "迪希雅",
            "text": "哈哈，只是贴身保镖的工作不做了而已，又不是闹翻了。我和迪娜泽黛还是很好的朋友啊。",
            "nextDialogs": [
              "130240109"
            ]
          },
          "130240109": {
            "id": "130240109",
            "speakerId": 1052,
            "speakerName": "迪希雅",
            "text": "呼玛伊家也还会招工，报酬优厚，我和兄弟们自然没有拒绝的理由。",
            "nextDialogs": [
              "130240110"
            ]
          },
          "130240110": {
            "id": "130240110",
            "speakerId": 13013,
            "speakerName": "迪娜泽黛",
            "text": "这几天她接了我家的工作，我就让她直接在家里住下了。",
            "nextDialogs": [
              "130240111"
            ]
          },
          "130240111": {
            "id": "130240111",
            "speakerId": 13013,
            "speakerName": "迪娜泽黛",
            "text": "父亲和母亲都很开心，说之前迪希雅不在，就像家里少了个人似的。",
            "nextDialogs": [
              "130240112"
            ]
          },
          "130240112": {
            "id": "130240112",
            "speakerId": 1052,
            "speakerName": "迪希雅",
            "text": "他们太夸张了，总是那么热情…",
            "nextDialogs": [
              "130240113"
            ]
          },
          "130240113": {
            "id": "130240113",
            "speakerId": 1052,
            "speakerName": "迪希雅",
            "text": "我工作已经完成了，本来打算买点东西就回团里，老爷却硬要再留我一天。",
            "nextDialogs": [
              "130240114"
            ]
          },
          "130240114": {
            "id": "130240114",
            "speakerId": 13013,
            "speakerName": "迪娜泽黛",
            "text": "多待两三天也没什么关系呀，我父亲还没来得及给你做他的拿手菜呢。",
            "nextDialogs": [
              "130240115"
            ]
          },
          "130240115": {
            "id": "130240115",
            "speakerId": 1052,
            "speakerName": "迪希雅",
            "text": "你知道我安静不下来，小姐。没关系的，下次还有机会啊。",
            "nextDialogs": [
              "130240116"
            ]
          },
          "130240116": {
            "id": "130240116",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "真佩服你，听到「拿手菜」三个字也毫不动摇。",
            "nextDialogs": [
              "130240117"
            ]
          },
          "130240117": {
            "id": "130240117",
            "speakerId": 13013,
            "speakerName": "迪娜泽黛",
            "text": "啊，对了，之前你说下次再带我去沙漠，要不然就今天出发吧？",
            "nextDialogs": [
              "130240118"
            ]
          },
          "130240118": {
            "id": "130240118",
            "speakerId": 13013,
            "speakerName": "迪娜泽黛",
            "text": "还有好多地方我没看过呢。",
            "nextDialogs": [
              "130240119"
            ]
          },
          "130240119": {
            "id": "130240119",
            "speakerId": 1052,
            "speakerName": "迪希雅",
            "text": "不好意思，这次还不行，我们团还有些事要处理，最近沙漠那边也不太平。",
            "nextDialogs": [
              "130240120"
            ]
          },
          "130240120": {
            "id": "130240120",
            "speakerId": 13013,
            "speakerName": "迪娜泽黛",
            "text": "你都拖了多久了，上次也是，上上次也是。",
            "nextDialogs": [
              "130240121"
            ]
          },
          "130240121": {
            "id": "130240121",
            "speakerId": 1052,
            "speakerName": "迪希雅",
            "text": "抱歉，抱歉，再给我点时间，我好好地帮你安排一下。",
            "nextDialogs": [
              "130240122"
            ]
          },
          "130240122": {
            "id": "130240122",
            "speakerId": 13013,
            "speakerName": "迪娜泽黛",
            "text": "好吧，知道了。其实我不是在任性地提要求，而是…某种直觉之类的东西吧。",
            "nextDialogs": [
              "130240123"
            ]
          },
          "130240123": {
            "id": "130240123",
            "speakerId": 13013,
            "speakerName": "迪娜泽黛",
            "text": "这次从你到我们家开始，我就觉得你行色匆匆，心神不宁的。",
            "nextDialogs": [
              "130240124"
            ]
          },
          "130240124": {
            "id": "130240124",
            "speakerId": 13013,
            "speakerName": "迪娜泽黛",
            "text": "是不是你遇到了什么棘手的事，才把我们的约定一拖再拖？",
            "nextDialogs": [
              "130240125"
            ]
          },
          "130240125": {
            "id": "130240125",
            "speakerId": 1052,
            "speakerName": "迪希雅",
            "text": "没有啦，你想多了。",
            "nextDialogs": [
              "130240126"
            ]
          },
          "130240126": {
            "id": "130240126",
            "speakerId": 13013,
            "speakerName": "迪娜泽黛",
            "text": "那你能保证吗？朋友之间不应该互相欺骗，只要你点头，我就不再追问了。",
            "nextDialogs": [
              "130240127"
            ]
          },
          "130240127": {
            "id": "130240127",
            "speakerId": 13013,
            "speakerName": "迪娜泽黛",
            "text": "但如果真有什么事，你大可和我说实话，我会想办法帮你。",
            "nextDialogs": [
              "130240128"
            ]
          },
          "130240128": {
            "id": "130240128",
            "speakerId": 1052,
            "speakerName": "迪希雅",
            "text": "……",
            "nextDialogs": [
              "130240129"
            ]
          },
          "130240129": {
            "id": "130240129",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "是不是被迪娜泽黛说中了啊？",
            "nextDialogs": [
              "130240130"
            ]
          },
          "130240130": {
            "id": "130240130",
            "speakerId": 1052,
            "speakerName": "迪希雅",
            "text": "唉，小姐你真是太难缠了，什么事都瞒不过你。",
            "nextDialogs": [
              "130240131"
            ]
          },
          "130240131": {
            "id": "130240131",
            "speakerId": 1052,
            "speakerName": "迪希雅",
            "text": "我本来觉得佣兵圈子里的事，小姐你没必要知道，知道了也只有坏处。",
            "nextDialogs": [
              "130240132"
            ]
          },
          "130240132": {
            "id": "130240132",
            "speakerId": 1052,
            "speakerName": "迪希雅",
            "text": "那是个弱肉强食，趋利避害的世界，和这边太不一样了。",
            "nextDialogs": [
              "130240133"
            ]
          },
          "130240133": {
            "id": "130240133",
            "speakerId": 13013,
            "speakerName": "迪娜泽黛",
            "text": "可还是那句话，我们是好朋友，不了解你的顾虑，我又要怎么支持和帮助你呢？",
            "nextDialogs": [
              "130240134"
            ]
          },
          "130240134": {
            "id": "130240134",
            "speakerId": 1052,
            "speakerName": "迪希雅",
            "text": "小姐…你也没必要这么固执啊。",
            "nextDialogs": [
              "130240135"
            ]
          },
          "130240135": {
            "id": "130240135",
            "speakerId": 1052,
            "speakerName": "迪希雅",
            "text": "好吧，实在拗不过你。我们换个地方吧，这里不太合适。",
            "nextDialogs": [
              "130240136"
            ]
          },
          "130240136": {
            "id": "130240136",
            "speakerId": 1052,
            "speakerName": "迪希雅",
            "text": "就在这里吧，尽量不要引人注目。",
            "nextDialogs": [
              "130240137"
            ]
          },
          "130240137": {
            "id": "130240137",
            "speakerId": 1052,
            "speakerName": "迪希雅",
            "text": "镀金旅团人数众多，组成复杂，其中有很多像我一样的佣兵，四处寻找工作，赚取摩拉。",
            "nextDialogs": [
              "130240138"
            ]
          },
          "130240138": {
            "id": "130240138",
            "speakerId": 1052,
            "speakerName": "迪希雅",
            "text": "我的团名叫「炽光猎兽」，规模不大，但团里接纳的都是有血性，讲义气的好人。",
            "nextDialogs": [
              "130240139"
            ]
          },
          "130240139": {
            "id": "130240139",
            "speakerId": 1052,
            "speakerName": "迪希雅",
            "text": "但还有另一种旅团，为了摩拉可以放弃所有的道德底线。其中最臭名昭著的，名叫「神王之遗」。",
            "nextDialogs": [
              "130240140"
            ]
          },
          "130240140": {
            "id": "130240140",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "神…王？对镀金旅团的人来说，又是神，又是王的话…",
            "nextDialogs": [
              "130240143"
            ]
          },
          "130240143": {
            "id": "130240143",
            "speakerId": 1052,
            "speakerName": "迪希雅",
            "text": "没错，我听说你们曾经和「阿赫玛尔之眼」打过交道，他们就是「神王之遗」的附属团之一。",
            "nextDialogs": [
              "130240144"
            ]
          },
          "130240144": {
            "id": "130240144",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "哦，是那个卖神明罐装知识的团！确实感觉不像好人…",
            "nextDialogs": [
              "130240145"
            ]
          },
          "130240145": {
            "id": "130240145",
            "speakerId": 1052,
            "speakerName": "迪希雅",
            "text": "「神王之遗」由诸多类似的团组合而成，再由总部从上而下统一管理。",
            "nextDialogs": [
              "130240146"
            ]
          },
          "130240146": {
            "id": "130240146",
            "speakerId": 1052,
            "speakerName": "迪希雅",
            "text": "本来平时我对他们都避之不及，但这次兴风作浪的那个团，名叫「阿赫玛尔之须」。",
            "nextDialogs": [
              "130240147"
            ]
          },
          "130240147": {
            "id": "130240147",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "…须？",
            "nextDialogs": [
              "130240148"
            ]
          },
          "130240148": {
            "id": "130240148",
            "speakerId": 1052,
            "speakerName": "迪希雅",
            "text": "就是胡须啦，大概吧。名字很蠢我知道，以前我就很嫌弃。",
            "nextDialogs": [
              "130240149"
            ]
          },
          "130240149": {
            "id": "130240149",
            "speakerId": 1052,
            "speakerName": "迪希雅",
            "text": "但重点在于——这是库塞拉，我父亲的团。",
            "nextDialogs": [
              "130240150"
            ]
          },
          "130240150": {
            "id": "130240150",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "欸？！",
            "nextDialogs": [
              "130240151"
            ]
          },
          "130240151": {
            "id": "130240151",
            "speakerId": 13013,
            "speakerName": "迪娜泽黛",
            "text": "我有点理解你的难言之隐了…不过他们到底做了什么？",
            "nextDialogs": [
              "130240152"
            ]
          },
          "130240152": {
            "id": "130240152",
            "speakerId": 1052,
            "speakerName": "迪希雅",
            "text": "细节我还是不描述了，小姐。总之就是大量的暴力事件，应该有上百起吧。",
            "nextDialogs": [
              "130240153"
            ]
          },
          "130240153": {
            "id": "130240153",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "这么多？！",
            "nextDialogs": [
              "130240154"
            ]
          },
          "130240154": {
            "id": "130240154",
            "speakerId": 1052,
            "speakerName": "迪希雅",
            "text": "嗯，现场往往会非常惨烈，他们会把钱财洗劫一空，然后再灭口。",
            "nextDialogs": [
              "130240155"
            ]
          },
          "130240155": {
            "id": "130240155",
            "speakerId": 1052,
            "speakerName": "迪希雅",
            "text": "受害者不只是商队和普通人，还包括了其他的佣兵团。",
            "nextDialogs": [
              "130240156"
            ]
          },
          "130240156": {
            "id": "130240156",
            "speakerId": 13013,
            "speakerName": "迪娜泽黛",
            "text": "这已经敌我不分了，就算再没底线也…",
            "nextDialogs": [
              "130240157"
            ]
          },
          "130240157": {
            "id": "130240157",
            "speakerId": 1052,
            "speakerName": "迪希雅",
            "text": "我不知道「神王之遗」内部对这件事是什么态度，但近几年他们越来越猖獗。",
            "nextDialogs": [
              "130240158"
            ]
          },
          "130240158": {
            "id": "130240158",
            "speakerId": 1052,
            "speakerName": "迪希雅",
            "text": "如果我再坐视不管的话，我现在的团，还有阿如村的人，不知道什么时候也会被选为目标。",
            "nextDialogs": [
              "130240159"
            ]
          },
          "130240159": {
            "id": "130240159",
            "speakerId": 1052,
            "speakerName": "迪希雅",
            "text": "唉，那家伙这几年到底在想什么啊。",
            "nextDialogs": [
              "130240160"
            ]
          },
          "130240160": {
            "id": "130240160",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "你的父亲，原来是这么可怕的人吗？",
            "nextDialogs": [
              "130240161"
            ]
          },
          "130240161": {
            "id": "130240161",
            "speakerId": 1052,
            "speakerName": "迪希雅",
            "text": "人都是会变的，以前的他在我印象里，虽然没什么出息，但做事还有底线。",
            "nextDialogs": [
              "130240162"
            ]
          },
          "130240162": {
            "id": "130240162",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "这评价好像也不高啊…",
            "nextDialogs": [
              "130240163"
            ]
          },
          "130240163": {
            "id": "130240163",
            "speakerId": 1052,
            "speakerName": "迪希雅",
            "text": "唉，不然我怎么会离开「阿赫玛尔之须」，和他一刀两断呢？",
            "nextDialogs": [
              "130240164"
            ]
          },
          "130240164": {
            "id": "130240164",
            "speakerId": 1052,
            "speakerName": "迪希雅",
            "text": "他大大咧咧的，特别吵闹，性子也很随便。成天不干正事不说，总是酗酒，还很好色。",
            "nextDialogs": [
              "130240165"
            ]
          },
          "130240165": {
            "id": "130240165",
            "speakerId": 1052,
            "speakerName": "迪希雅",
            "text": "团员们也会跟他一起折腾，经常一闹就是一整晚…",
            "nextDialogs": [
              "130240166"
            ]
          },
          "130240166": {
            "id": "130240166",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "哇，就像噩梦一样。",
            "nextDialogs": [
              "130240167"
            ]
          },
          "130240167": {
            "id": "130240167",
            "speakerId": 13013,
            "speakerName": "迪娜泽黛",
            "text": "那你的母亲呢，没有阻止他们吗？",
            "nextDialogs": [
              "130240168"
            ]
          },
          "130240168": {
            "id": "130240168",
            "speakerId": 1052,
            "speakerName": "迪希雅",
            "text": "…很遗憾，我不知道我的母亲是谁。",
            "nextDialogs": [
              "130240169"
            ]
          },
          "130240169": {
            "id": "130240169",
            "speakerId": 13013,
            "speakerName": "迪娜泽黛",
            "text": "啊，对不起，迪希雅，我不是故意的。",
            "nextDialogs": [
              "130240170"
            ]
          },
          "130240170": {
            "id": "130240170",
            "speakerId": 1052,
            "speakerName": "迪希雅",
            "text": "没事啦，小姐，很多佣兵都这样。我不是说我父亲很好色吗？我就是这么生下来的。",
            "nextDialogs": [
              "130240171"
            ]
          },
          "130240171": {
            "id": "130240171",
            "speakerId": 1052,
            "speakerName": "迪希雅",
            "text": "他说他也搞不清楚我母亲是谁，母亲她也从来没有来看过我。",
            "nextDialogs": [
              "130240172"
            ]
          },
          "130240172": {
            "id": "130240172",
            "speakerId": 1052,
            "speakerName": "迪希雅",
            "text": "他虽然总说「只要有爸爸在就够了」，但基本上所有事他都丢给团员去做，只给我讲讲故事。",
            "nextDialogs": [
              "130240173"
            ]
          },
          "130240173": {
            "id": "130240173",
            "speakerId": 1052,
            "speakerName": "迪希雅",
            "text": "关键是他的品味又很差劲，会的故事没几个，还都是老掉牙过时的那种。",
            "nextDialogs": [
              "130240174"
            ]
          },
          "130240174": {
            "id": "130240174",
            "speakerId": 1052,
            "speakerName": "迪希雅",
            "text": "沙城的勇者战胜了林中的巨龙，佣兵克服万难终于救出了叛军手中的公主什么的。",
            "nextDialogs": [
              "130240175"
            ]
          },
          "130240175": {
            "id": "130240175",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "都是很标准的童话啊。",
            "nextDialogs": [
              "130240176"
            ]
          },
          "130240176": {
            "id": "130240176",
            "speakerId": 1052,
            "speakerName": "迪希雅",
            "text": "嗯，听一两次可能还比较新鲜，十几二十次之后怎么都腻了。",
            "nextDialogs": [
              "130240177"
            ]
          },
          "130240177": {
            "id": "130240177",
            "speakerId": 1052,
            "speakerName": "迪希雅",
            "text": "但他完全不觉得腻，反而越来越投入，还把团里的兄弟们叫来一起表演。",
            "nextDialogs": [
              "130240178"
            ]
          },
          "130240178": {
            "id": "130240178",
            "speakerId": 1052,
            "speakerName": "迪希雅",
            "text": "给我准备的玩具，也全都是故事里的道具，盔甲，盾牌，玩具剑什么的。",
            "nextDialogs": [
              "130240179"
            ]
          },
          "130240179": {
            "id": "130240179",
            "speakerId": 1052,
            "speakerName": "迪希雅",
            "text": "后来我才有点明白，根本不是讲给我听，是他自己喜欢这么玩…",
            "nextDialogs": [
              "130240180"
            ]
          },
          "130240180": {
            "id": "130240180",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "哇，这个人…好奇怪。",
            "nextDialogs": [
              "130240181"
            ]
          },
          "130240181": {
            "id": "130240181",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "但感觉本质并不坏？",
            "nextDialogs": [
              "130240182"
            ]
          },
          "130240182": {
            "id": "130240182",
            "speakerId": 1052,
            "speakerName": "迪希雅",
            "text": "嗯，小时候我觉得他很幼稚，但这最多只能让我无奈，还称不上是厌恶。",
            "nextDialogs": [
              "130240183"
            ]
          },
          "130240183": {
            "id": "130240183",
            "speakerId": 1052,
            "speakerName": "迪希雅",
            "text": "——长大了之后，我偶然得知了「神王之遗」的所作所为。",
            "nextDialogs": [
              "130240184"
            ]
          },
          "130240184": {
            "id": "130240184",
            "speakerId": 1052,
            "speakerName": "迪希雅",
            "text": "掳掠，威胁，暴力，欺诈，这些邪恶的行为在组织里竟然都是吹嘘的资本。",
            "nextDialogs": [
              "130240185"
            ]
          },
          "130240185": {
            "id": "130240185",
            "speakerId": 1052,
            "speakerName": "迪希雅",
            "text": "他，还有团里的人，根本就不是什么英雄，而是故事里应该被打倒的反派。",
            "nextDialogs": [
              "130240186"
            ]
          },
          "130240186": {
            "id": "130240186",
            "speakerId": 1052,
            "speakerName": "迪希雅",
            "text": "他们不会以为不让我看见，我就永远不知道吧？",
            "nextDialogs": [
              "130240187"
            ]
          },
          "130240187": {
            "id": "130240187",
            "speakerId": 13013,
            "speakerName": "迪娜泽黛",
            "text": "我好像能明白你的心情。现实让你感受到了落差…",
            "nextDialogs": [
              "130240188"
            ]
          },
          "130240188": {
            "id": "130240188",
            "speakerId": 1052,
            "speakerName": "迪希雅",
            "text": "嗯，不过没关系啦，小姐，都是过去的事了。我和他大吵一架之后就离开了，再也没回去过。",
            "nextDialogs": [
              "130240189"
            ]
          },
          "130240189": {
            "id": "130240189",
            "speakerId": 1052,
            "speakerName": "迪希雅",
            "text": "这次我要介入调查，也不是对他有什么多余的感情，只是想保护我身边的人。"
          }
        }
      }
    },
    {
      "subId": "1302402",
      "subQuestName": "前往喀万驿了解情况",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "130240201"
        ],
        "dialogs": {
          "130240201": {
            "id": "130240201",
            "speakerId": 13063,
            "speakerName": "哈伦",
            "text": "嘿，迪希雅，你回来了啊。这两位是你的朋友吗？",
            "nextDialogs": [
              "130240203",
              "130240205"
            ]
          },
          "130240203": {
            "id": "130240203",
            "speakerId": 13063,
            "speakerName": "哈伦",
            "text": "哈哈，你好你好，随意点就好，我们没什么讲究。",
            "nextDialogs": [
              "130240206"
            ]
          },
          "130240206": {
            "id": "130240206",
            "speakerId": 13063,
            "speakerName": "哈伦",
            "text": "既然有新人在，「阿赫玛尔之须」的事我简单讲讲吧。",
            "nextDialogs": [
              "130240207"
            ]
          },
          "130240207": {
            "id": "130240207",
            "speakerId": 13063,
            "speakerName": "哈伦",
            "text": "他们的路子很野，直接把搞钱的目标放在了自己人身上。",
            "nextDialogs": [
              "130240208"
            ]
          },
          "130240208": {
            "id": "130240208",
            "speakerId": 13063,
            "speakerName": "哈伦",
            "text": "不仅是一般的佣兵团，就连同属「神王之遗」的团都会被他们袭击。",
            "nextDialogs": [
              "130240209"
            ]
          },
          "130240209": {
            "id": "130240209",
            "speakerId": 1052,
            "speakerName": "迪希雅",
            "text": "就算是凶猛残暴的野兽，也会保护自己的骨肉和族群，但他们根本不管不顾。",
            "nextDialogs": [
              "130240210"
            ]
          },
          "130240210": {
            "id": "130240210",
            "speakerId": 13063,
            "speakerName": "哈伦",
            "text": "是的。从佣兵的手上抢了财物，他们会交给别的团或者黑市商人去转卖。",
            "nextDialogs": [
              "130240211"
            ]
          },
          "130240211": {
            "id": "130240211",
            "speakerId": 13063,
            "speakerName": "哈伦",
            "text": "一部分摩拉直接换成食物和武器，马上投入下一场暴力行动中。",
            "nextDialogs": [
              "130240212"
            ]
          },
          "130240212": {
            "id": "130240212",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "太过分了吧…",
            "nextDialogs": [
              "130240213"
            ]
          },
          "130240213": {
            "id": "130240213",
            "speakerId": 13063,
            "speakerName": "哈伦",
            "text": "是啊，这也让我们好奇，他们如此渴望摩拉的原因是什么。",
            "nextDialogs": [
              "130240214"
            ]
          },
          "130240214": {
            "id": "130240214",
            "speakerId": 13063,
            "speakerName": "哈伦",
            "text": "前两天我和希沙姆去跟踪，还伪装成商人和他们交易，果然有不得了的发现。",
            "nextDialogs": [
              "130240215"
            ]
          },
          "130240215": {
            "id": "130240215",
            "speakerId": 13063,
            "speakerName": "哈伦",
            "text": "——与其说是「夺财」，不如说是「内斗」。",
            "nextDialogs": [
              "130240216"
            ]
          },
          "130240216": {
            "id": "130240216",
            "speakerId": 1052,
            "speakerName": "迪希雅",
            "text": "等等，「内斗」？",
            "nextDialogs": [
              "130240217"
            ]
          },
          "130240217": {
            "id": "130240217",
            "speakerId": 13063,
            "speakerName": "哈伦",
            "text": "嗯，因为在受害者中，「神王之遗」附属团的占比特别高。",
            "nextDialogs": [
              "130240218"
            ]
          },
          "130240218": {
            "id": "130240218",
            "speakerId": 13063,
            "speakerName": "哈伦",
            "text": "如果只是为了摩拉，对方应该是谁都行，不会表现出像这样的目的性。但如果解读成内斗，就能说通了。",
            "nextDialogs": [
              "130240219"
            ]
          },
          "130240219": {
            "id": "130240219",
            "speakerId": 13063,
            "speakerName": "哈伦",
            "text": "不过可惜的是，对方的口风很紧，我们没能拿到更进一步的情报。",
            "nextDialogs": [
              "130240220"
            ]
          },
          "130240220": {
            "id": "130240220",
            "speakerId": 13063,
            "speakerName": "哈伦",
            "text": "只是听说「阿赫玛尔之须」活跃的这几年，「神王之遗」一直在被削弱。"
          },
          "130240205": {
            "id": "130240205",
            "speakerId": 13063,
            "speakerName": "哈伦",
            "text": "哦？那和我们一样了，哈哈。"
          }
        }
      }
    },
    {
      "subId": "1302403",
      "subQuestName": "前去蹲守商路，等待时机",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "130240301"
        ],
        "dialogs": {
          "130240301": {
            "id": "130240301",
            "speakerId": 1052,
            "speakerName": "迪希雅",
            "text": "看样子就在这里，我们先藏起来，等待时机。",
            "nextDialogs": [
              "130240302"
            ]
          },
          "130240302": {
            "id": "130240302",
            "speakerId": 1052,
            "speakerName": "迪希雅",
            "text": "估计届时难免会有冲突，我们都要小心一点。",
            "nextDialogs": [
              "130240303"
            ]
          },
          "130240303": {
            "id": "130240303",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "#放心啦，{M#他}{F#她}很能打的。",
            "nextDialogs": [
              "130240304"
            ]
          },
          "130240304": {
            "id": "130240304",
            "speakerId": 1052,
            "speakerName": "迪希雅",
            "text": "哈哈哈，我当然不担心这个。我说「小心」的意思，是下手轻一点，还得了解情报呢。",
            "nextDialogs": [
              "130240305"
            ]
          },
          "130240305": {
            "id": "130240305",
            "speakerId": 1052,
            "speakerName": "迪希雅",
            "text": "他们好像来了，准备好了吧。",
            "nextDialogs": [
              "130240306"
            ]
          },
          "130240306": {
            "id": "130240306",
            "speakerId": 1052,
            "speakerName": "迪希雅",
            "text": "速战速决，别给他们反应的时间。"
          }
        }
      }
    },
    {
      "subId": "1302404",
      "subQuestName": "拦截商队，寻找线索",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [],
        "dialogs": {}
      }
    },
    {
      "subId": "1302405",
      "subQuestName": "与萨塔尔交谈",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "130240501"
        ],
        "dialogs": {
          "130240501": {
            "id": "130240501",
            "speakerId": 13106,
            "speakerName": "萨塔尔",
            "text": "可…可恶。",
            "nextDialogs": [
              "130240502"
            ]
          },
          "130240502": {
            "id": "130240502",
            "speakerId": 13106,
            "speakerName": "萨塔尔",
            "text": "你、你是？「炽鬃之狮」？！",
            "nextDialogs": [
              "130240503"
            ]
          },
          "130240503": {
            "id": "130240503",
            "speakerId": 1052,
            "speakerName": "迪希雅",
            "text": "看来不用多费口舌了，快交代吧，你们和「阿赫玛尔之须」是什么关系，他们要干什么？",
            "nextDialogs": [
              "130240504"
            ]
          },
          "130240504": {
            "id": "130240504",
            "speakerId": 13106,
            "speakerName": "萨塔尔",
            "text": "哼，佣兵拿钱办事。保护雇佣者的情报是最基本的原则，你觉得我会说？",
            "nextDialogs": [
              "130240505"
            ]
          },
          "130240505": {
            "id": "130240505",
            "speakerId": 1052,
            "speakerName": "迪希雅",
            "text": "你这种话唬外行人或许还有用，说到底这不就是为了捍卫你赚摩拉的信誉。",
            "nextDialogs": [
              "130240506"
            ]
          },
          "130240506": {
            "id": "130240506",
            "speakerId": 1052,
            "speakerName": "迪希雅",
            "text": "但做生意还需要很多其他的东西，比如你的手，你的腿，你的眼睛。",
            "nextDialogs": [
              "130240507"
            ]
          },
          "130240507": {
            "id": "130240507",
            "speakerId": 1052,
            "speakerName": "迪希雅",
            "text": "我给你五秒，仔细考虑一下，雇佣者的情报是不是真的这么重要。",
            "nextDialogs": [
              "130240508"
            ]
          },
          "130240508": {
            "id": "130240508",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "喂、喂…",
            "nextDialogs": [
              "130240511"
            ]
          },
          "130240511": {
            "id": "130240511",
            "speakerId": 1052,
            "speakerName": "迪希雅",
            "text": "我没跟你开玩笑，我很明白轻重，怎么做才最能让人痛苦。",
            "nextDialogs": [
              "130240512"
            ]
          },
          "130240512": {
            "id": "130240512",
            "speakerId": 1052,
            "speakerName": "迪希雅",
            "text": "你还有最后两秒。",
            "nextDialogs": [
              "130240513"
            ]
          },
          "130240513": {
            "id": "130240513",
            "speakerId": 13106,
            "speakerName": "萨塔尔",
            "text": "哼，不劳你动手…！",
            "nextDialogs": [
              "130240514"
            ]
          },
          "130240514": {
            "id": "130240514",
            "speakerId": 1052,
            "speakerName": "迪希雅",
            "text": "喂？！你疯了吧！",
            "nextDialogs": [
              "130240515"
            ]
          },
          "130240515": {
            "id": "130240515",
            "speakerId": 1052,
            "speakerName": "迪希雅",
            "text": "他咬了自己的舌头！快，找找货物里面有没有药品！",
            "nextDialogs": [
              "130240516"
            ]
          },
          "130240516": {
            "id": "130240516",
            "speakerId": 1005,
            "speakerName": "Black Screen",
            "text": "迪希雅紧急处理之后，萨塔尔嘴里的鲜血止住了。",
            "nextDialogs": [
              "130240517"
            ]
          },
          "130240517": {
            "id": "130240517",
            "speakerId": 1052,
            "speakerName": "迪希雅",
            "text": "唉，真是没想到。幸好舌头受伤不重，他是痛晕过去的。",
            "nextDialogs": [
              "130240518"
            ]
          },
          "130240518": {
            "id": "130240518",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "他怎么会做这种事…",
            "nextDialogs": [
              "130240519"
            ]
          },
          "130240519": {
            "id": "130240519",
            "speakerId": 1052,
            "speakerName": "迪希雅",
            "text": "我本来只是想和他斗斗狠，还以为和某些佣兵一样，不花力气就能撬开他的嘴。",
            "nextDialogs": [
              "130240520"
            ]
          },
          "130240520": {
            "id": "130240520",
            "speakerId": 1052,
            "speakerName": "迪希雅",
            "text": "没想到即便选这么痛苦的方式，他也不愿意告诉我们情报。",
            "nextDialogs": [
              "130240521"
            ]
          },
          "130240521": {
            "id": "130240521",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "现在怎么办，他已经晕过去了…虽然能等他醒过来，但…还是不要继续了吧。",
            "nextDialogs": [
              "130240522"
            ]
          },
          "130240522": {
            "id": "130240522",
            "speakerId": 1052,
            "speakerName": "迪希雅",
            "text": "嗯，放心好了，像他这样再问一次也是浪费时间，还可能逼他继续伤害自己。",
            "nextDialogs": [
              "130240523"
            ]
          },
          "130240523": {
            "id": "130240523",
            "speakerId": 1052,
            "speakerName": "迪希雅",
            "text": "这里有这么多货物，我们从这里着手查查看吧。",
            "nextDialogs": [
              "130240524"
            ]
          },
          "130240524": {
            "id": "130240524",
            "speakerId": 1052,
            "speakerName": "迪希雅",
            "text": "——我很抱歉。"
          }
        }
      }
    },
    {
      "subId": "1302407",
      "subQuestName": "在货物里寻找线索",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "130240701"
        ],
        "dialogs": {
          "130240701": {
            "id": "130240701",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "我们找到一张纸，上面写了好多名字，这是不是用来记录的东西？",
            "nextDialogs": [
              "130240702"
            ]
          },
          "130240702": {
            "id": "130240702",
            "speakerId": 1052,
            "speakerName": "迪希雅",
            "text": "给我看看。既然是商队，记录账务必不可少。",
            "nextDialogs": [
              "130240703"
            ]
          },
          "130240703": {
            "id": "130240703",
            "speakerId": 1052,
            "speakerName": "迪希雅",
            "text": "嗯…果然没错，「阿赫玛尔之须」，库塞拉，伊德里西，巴沙尔，提克里蒂…",
            "nextDialogs": [
              "130240704"
            ]
          },
          "130240704": {
            "id": "130240704",
            "speakerId": 1052,
            "speakerName": "迪希雅",
            "text": "全都是熟悉的名字，他们在贸易中拿到了充足的食物，武器，还有药物，之前还有罐装知识。",
            "nextDialogs": [
              "130240705"
            ]
          },
          "130240705": {
            "id": "130240705",
            "speakerId": 1052,
            "speakerName": "迪希雅",
            "text": "这个商队只是物资转运的其中一环，他们把赃物带去雨林换成钱，再把钱交到指定的人那里。",
            "nextDialogs": [
              "130240706"
            ]
          },
          "130240706": {
            "id": "130240706",
            "speakerId": 1052,
            "speakerName": "迪希雅",
            "text": "指定人为他们送来物资，他们再带回来，给「阿赫玛尔之须」的人…",
            "nextDialogs": [
              "130240707"
            ]
          },
          "130240707": {
            "id": "130240707",
            "speakerId": 1052,
            "speakerName": "迪希雅",
            "text": "…奇怪了，为什么最后送物资这里，没有记录金额？",
            "nextDialogs": [
              "130240708"
            ]
          },
          "130240708": {
            "id": "130240708",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "没有金额？",
            "nextDialogs": [
              "130240709"
            ]
          },
          "130240709": {
            "id": "130240709",
            "speakerId": 1052,
            "speakerName": "迪希雅",
            "text": "是啊，之前的每一笔交易，金额都很清楚，但最后的物资，只有「送抵」这样的简单记号。",
            "nextDialogs": [
              "130240710"
            ]
          },
          "130240710": {
            "id": "130240710",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "可能和转交赃物的那笔钱抵销了？",
            "nextDialogs": [
              "130240711"
            ]
          },
          "130240711": {
            "id": "130240711",
            "speakerId": 1052,
            "speakerName": "迪希雅",
            "text": "有点道理，可能是吧，但赃物能卖多少钱也不知道，他们做生意这么不在意零头吗？",
            "nextDialogs": [
              "130240712"
            ]
          },
          "130240712": {
            "id": "130240712",
            "speakerId": 1052,
            "speakerName": "迪希雅",
            "text": "算了，接下来是物资的来源记录了，应该都是从雨林那边来的吧，有好多好多。",
            "nextDialogs": [
              "130240713"
            ]
          },
          "130240713": {
            "id": "130240713",
            "speakerId": 1052,
            "speakerName": "迪希雅",
            "text": "啊…",
            "nextDialogs": [
              "130240714"
            ]
          },
          "130240714": {
            "id": "130240714",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "怎么了？",
            "nextDialogs": [
              "130240715"
            ]
          },
          "130240715": {
            "id": "130240715",
            "speakerId": 1052,
            "speakerName": "迪希雅",
            "text": "沙扎曼·呼玛伊…",
            "nextDialogs": [
              "130240716"
            ]
          },
          "130240716": {
            "id": "130240716",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "呼玛伊？迪娜泽黛家的那个呼玛伊？！",
            "nextDialogs": [
              "130240717"
            ]
          },
          "130240717": {
            "id": "130240717",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "有、有没有可能是重名呢？",
            "nextDialogs": [
              "130240718"
            ]
          },
          "130240718": {
            "id": "130240718",
            "speakerId": 1052,
            "speakerName": "迪希雅",
            "text": "总不能姓和名都重合吧，沙扎曼，就是迪娜泽黛的父亲，呼玛伊家的老爷。",
            "nextDialogs": [
              "130240719"
            ]
          },
          "130240719": {
            "id": "130240719",
            "speakerId": 1052,
            "speakerName": "迪希雅",
            "text": "这到底是…怎么回事…",
            "nextDialogs": [
              "130240722"
            ]
          },
          "130240722": {
            "id": "130240722",
            "speakerId": 1052,
            "speakerName": "迪希雅",
            "text": "抱歉，你说得对，我先缓一缓，先把信息整理清楚。",
            "nextDialogs": [
              "130240723"
            ]
          },
          "130240723": {
            "id": "130240723",
            "speakerId": 1052,
            "speakerName": "迪希雅",
            "text": "根据纸条上的内容可以确定的是，呼玛伊家为「阿赫玛尔之须」提供了物资。",
            "nextDialogs": [
              "130240724"
            ]
          },
          "130240724": {
            "id": "130240724",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "说不定只是正常的交易，呼玛伊家不知情呢？",
            "nextDialogs": [
              "130240725"
            ]
          },
          "130240725": {
            "id": "130240725",
            "speakerId": 1052,
            "speakerName": "迪希雅",
            "text": "也有这种可能，但如果只是正常的交易，为什么这个商队要专门向指定的人购买呢？",
            "nextDialogs": [
              "130240726"
            ]
          },
          "130240726": {
            "id": "130240726",
            "speakerId": 1052,
            "speakerName": "迪希雅",
            "text": "直接在喀万驿或者奥摩斯港，就能够购入这些东西。"
          }
        }
      }
    },
    {
      "subId": "1302420",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [

        ],
        "dialogs": {
          "130242001": {
            "id": "130242001",
            "speakerId": 12555,
            "speakerName": "迪娜泽黛",
            "text": "你们一定要小心，我在城里等你们的消息。",
            "nextDialogs": [
              "130242002"
            ]
          },
          "130242002": {
            "id": "130242002",
            "speakerId": 12555,
            "speakerName": "迪娜泽黛",
            "text": "千万不要乱来哦？"
          }
        }
      }
    },
    {
      "subId": "1302421",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "130242101"
        ],
        "dialogs": {
          "130242101": {
            "id": "130242101",
            "speakerId": 13063,
            "speakerName": "哈伦",
            "text": "我都说了，迪希雅带来那两个人，都是和「炽鬃之狮」齐名的超级佣兵。",
            "nextDialogs": [
              "130242102"
            ]
          },
          "130242102": {
            "id": "130242102",
            "speakerId": 13063,
            "speakerName": "哈伦",
            "text": "那三个人站在一起，气势别提多强了，我那是被吓的！",
            "nextDialogs": [
              "130242103"
            ]
          },
          "130242103": {
            "id": "130242103",
            "speakerId": 13105,
            "speakerName": "哈拉夫",
            "text": "丢人。",
            "nextDialogs": [
              "130242104"
            ]
          },
          "130242104": {
            "id": "130242104",
            "speakerId": 13063,
            "speakerName": "哈伦",
            "text": "住…住嘴。"
          }
        }
      }
    },
    {
      "subId": "1302450",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [

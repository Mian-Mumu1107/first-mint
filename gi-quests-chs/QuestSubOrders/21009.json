            "speakerId": 1000,
            "speakerName": "朱老板",
            "text": "食材有：大量的禽肉，和甜甜花。名字好像是叫…什么花什么鸡来着。如果能做出来交给我的话，就太感谢了。",
            "nextDialogs": [
              "210090104"
            ]
          },
          "210090104": {
            "id": "210090104",
            "speakerId": 1000,
            "speakerName": "朱老板",
            "text": "旅行者，接下来就看你的了。"
          }
        }
      }

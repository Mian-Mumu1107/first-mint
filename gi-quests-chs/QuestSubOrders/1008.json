    {
      "subId": "100802",
      "subQuestName": "与李丁对话$HIDDEN",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "10080201"
        ],
        "dialogs": {
          "10080201": {
            "id": "10080201",
            "speakerId": 10259,
            "speakerName": "李丁",
            "text": "仙人饶命！仙人饶命…求仙人网开一面，放我们兄弟一条生路，仙人饶命，仙人饶命…",
            "nextDialogs": [
              "10080202"
            ]
          },
          "10080202": {
            "id": "10080202",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "你怎么了？",
            "nextDialogs": [
              "10080203"
            ]
          },
          "10080203": {
            "id": "10080203",
            "speakerId": 10259,
            "speakerName": "李丁",
            "text": "你，你…你是谁？怎么…",
            "nextDialogs": [
              "10080204"
            ]
          },
          "10080204": {
            "id": "10080204",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "明明是我们在提问…",
            "nextDialogs": [
              "10080205"
            ]
          },
          "10080205": {
            "id": "10080205",
            "speakerId": 10259,
            "speakerName": "李丁",
            "text": "啊！您能在这绝云间安全行走…我知道了！",
            "nextDialogs": [
              "10080206"
            ]
          },
          "10080206": {
            "id": "10080206",
            "speakerId": 10259,
            "speakerName": "李丁",
            "text": "您一定是…仙使吧！是仙人派您来解救我兄弟的！",
            "nextDialogs": [
              "10080207"
            ]
          },
          "10080207": {
            "id": "10080207",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "这个人到底在说什么呀…",
            "nextDialogs": [
              "10080208"
            ]
          },
          "10080208": {
            "id": "10080208",
            "speakerId": 10259,
            "speakerName": "李丁",
            "text": "仙使慈悲，求仙使搭救！我们两兄弟只因实在无钱供养家里，又听人说，琥牢山中的琥珀藏有宝物。",
            "nextDialogs": [
              "10080209"
            ]
          },
          "10080209": {
            "id": "10080209",
            "speakerId": 10259,
            "speakerName": "李丁",
            "text": "一时间犯了糊涂，只想从山中琥珀里寻得几件宝物，卖了钱，再回去接济家里…",
            "nextDialogs": [
              "10080210"
            ]
          },
          "10080210": {
            "id": "10080210",
            "speakerId": 10259,
            "speakerName": "李丁",
            "text": "我们<color=#00E1FFFF>顺着山路</color>一路往上，但不曾想，我兄弟李当就突然被琥珀给…给吃了！",
            "nextDialogs": [
              "10080211"
            ]
          },
          "10080211": {
            "id": "10080211",
            "speakerId": 10259,
            "speakerName": "李丁",
            "text": "我一路奔逃到了这里，细细想来，只怕是我们冲撞了仙家府邸，这是仙人下的惩诫…",
            "nextDialogs": [
              "10080212"
            ]
          },
          "10080212": {
            "id": "10080212",
            "speakerId": 10259,
            "speakerName": "李丁",
            "text": "我不知道如何搭救我兄弟，只能在此求仙人开恩…恳求许久，才等来了二位仙使…",
            "nextDialogs": [
              "10080213"
            ]
          },
          "10080213": {
            "id": "10080213",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "仙使？我们不是什么仙使，我们也是来找仙人的。",
            "nextDialogs": [
              "10080214"
            ]
          },
          "10080214": {
            "id": "10080214",
            "speakerId": 10259,
            "speakerName": "李丁",
            "text": "不，不不不，你们肯定是仙使，你们肯定是仙使！",
            "nextDialogs": [
              "10080215"
            ]
          },
          "10080215": {
            "id": "10080215",
            "speakerId": 10259,
            "speakerName": "李丁",
            "text": "李当被关在山里不知道哪个琥珀里面，求仙使慈悲，求仙使搭救…",
            "nextDialogs": [
              "10080217",
              "10080219"
            ]
          },
          "10080217": {
            "id": "10080217",
            "speakerId": 10259,
            "speakerName": "李丁",
            "text": "好，好！谢谢仙使慈悲，我等以后再也不敢了…"
          },
          "10080219": {
            "id": "10080219",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "呜哇…你还真的入戏了，而且还挺有「仙使」气势的。",
            "nextDialogs": [
              "10080220"
            ]
          },
          "10080220": {
            "id": "10080220",
            "speakerId": 10259,
            "speakerName": "李丁",
            "text": "谢谢仙使，谢谢仙使，我等以后再也不敢了…"
          }
        }
      }
    },

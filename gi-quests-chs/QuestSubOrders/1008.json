    {
      "subId": "100805",
      "subQuestName": "与李当对话",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "10080501"
        ],
        "dialogs": {
          "10080501": {
            "id": "10080501",
            "speakerId": 10260,
            "speakerName": "李当",
            "text": "咳！咳咳，咳…咳咳！",
            "nextDialogs": [
              "10080502"
            ]
          },
          "10080502": {
            "id": "10080502",
            "speakerId": 10260,
            "speakerName": "李当",
            "text": "我怎么…是你们救我出来的？谢谢你们…",
            "nextDialogs": [
              "10080503"
            ]
          },
          "10080503": {
            "id": "10080503",
            "speakerId": 10260,
            "speakerName": "李当",
            "text": "对了！你们看见过我兄弟吗？他叫李丁，我们俩是一同上山的。",
            "nextDialogs": [
              "10080504"
            ]
          },
          "10080504": {
            "id": "10080504",
            "speakerId": 10260,
            "speakerName": "李当",
            "text": "不知道…我兄弟是不是也一样被琥珀给吞了…",
            "nextDialogs": [
              "10080506",
              "10080508"
            ]
          },
          "10080506": {
            "id": "10080506",
            "speakerId": 10260,
            "speakerName": "李当",
            "text": "那他应该是安全了…",
            "nextDialogs": [
              "10080509"
            ]
          },
          "10080509": {
            "id": "10080509",
            "speakerId": 10260,
            "speakerName": "李当",
            "text": "谢谢您，我这就去找我兄弟。",
            "nextDialogs": [
              "10080510"
            ]
          },
          "10080510": {
            "id": "10080510",
            "speakerId": 10260,
            "speakerName": "李当",
            "text": "希望不会在路上再被琥珀给吞了…"
          },
          "10080508": {
            "id": "10080508",
            "speakerId": 10260,
            "speakerName": "李当",
            "text": "在山顶上？那他应该是安全的…"
          }
        }
      }
    },
    {
      "subId": "100806",
      "subQuestName": "与李丁、李当对话",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "10080601"
        ],
        "dialogs": {
          "10080601": {
            "id": "10080601",
            "speakerId": 10259,
            "speakerName": "李丁",
            "text": "谢谢仙使，谢谢仙使救我兄弟。",
            "nextDialogs": [
              "10080602"
            ]
          },
          "10080602": {
            "id": "10080602",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "你们见过仙人吗？",
            "nextDialogs": [
              "10080603"
            ]
          },
          "10080603": {
            "id": "10080603",
            "speakerId": 10259,
            "speakerName": "李丁",
            "text": "啊？我们…我们也只是听说，这琥牢山是仙人府邸。",
            "nextDialogs": [
              "10080604"
            ]
          },
          "10080604": {
            "id": "10080604",
            "speakerId": 10259,
            "speakerName": "李丁",
            "text": "但我们这种凡夫俗子，自然是无缘得见仙人的。",
            "nextDialogs": [
              "10080605"
            ]
          },
          "10080605": {
            "id": "10080605",
            "speakerId": 10259,
            "speakerName": "李丁",
            "text": "不过您贵为仙使，肯定与我们不同。",
            "nextDialogs": [
              "10080606"
            ]
          },
          "10080606": {
            "id": "10080606",
            "speakerId": 10259,
            "speakerName": "李丁",
            "text": "啊，对了，可不能再叨扰仙府，我们这就下山，谢谢仙使…",
            "nextDialogs": [
              "10080607"
            ]
          },
          "10080607": {
            "id": "10080607",
            "speakerId": 10260,
            "speakerName": "李当",
            "text": "谢谢仙使…",
            "nextDialogs": [
              "10080608"
            ]
          },
          "10080608": {
            "id": "10080608",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "…要是我们真是什么「仙使」就好了。",
            "nextDialogs": [
              "10080609"
            ]
          },
          "10080609": {
            "id": "10080609",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "总感觉，这位仙人的脾气不太好呢…",
            "nextDialogs": [
              "10080610"
            ]
          },
          "10080610": {
            "id": "10080610",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "不过我们也没有做什么坏事，应该也不会…",
            "nextDialogs": [
              "10089601"
            ]
          },
          "10089601": {
            "id": "10089601",
            "speakerId": 10257,
            "speakerName": "理水叠山真君",
            "text": "擅扰山门，又私放受诫贼人。",
            "nextDialogs": [
              "10089602"
            ]
          },
          "10089602": {
            "id": "10089602",
            "speakerId": 10257,
            "speakerName": "理水叠山真君",
            "text": "无知凡众，还不速速前来领诫！"
          }
        }
      }
    },
    {
      "subId": "100807",
      "subQuestName": "面见「理水叠山真君」",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "10080701"
        ],
        "dialogs": {
          "10080701": {
            "id": "10080701",
            "speakerId": 10257,
            "speakerName": "理水叠山真君",
            "text": "…不仅闯入「琥牢山」，毁坏山上琥珀，还擅放了正受诫的贼人。",
            "nextDialogs": [
              "10080702"
            ]
          },
          "10080702": {
            "id": "10080702",
            "speakerId": 10257,
            "speakerName": "理水叠山真君",
            "text": "这帮贼人确是不晓仙威，但你们，也同样无礼至极。",
            "nextDialogs": [
              "10080703"
            ]
          },
          "10080703": {
            "id": "10080703",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "呜啊！我们，我们是有理由的！",
            "nextDialogs": [
              "10080705",
              "10080707"
            ]
          },
          "10080705": {
            "id": "10080705",
            "speakerId": 10257,
            "speakerName": "理水叠山真君",
            "text": "…「百无禁忌箓」，没想到世间还有此物。",
            "nextDialogs": [
              "10080708"
            ]
          },
          "10080708": {
            "id": "10080708",
            "speakerId": 10257,
            "speakerName": "理水叠山真君",
            "text": "哦？这是「百无禁忌箓」？世间居然还有此物。",
            "nextDialogs": [
              "10080709"
            ]
          },
          "10080709": {
            "id": "10080709",
            "speakerId": 10257,
            "speakerName": "理水叠山真君",
            "text": "昔日帝君铸此神箓，赐予凡人，本就数量稀少，千百年来也散失得差不多了…",
            "nextDialogs": [
              "10080710"
            ]
          },
          "10080710": {
            "id": "10080710",
            "speakerId": 10257,
            "speakerName": "理水叠山真君",
            "text": "你们先陈明详情吧，我会听你们说的，稍后我会查证。",
            "nextDialogs": [
              "10080711"
            ]
          },
          "10080711": {
            "id": "10080711",
            "speakerId": 10257,
            "speakerName": "理水叠山真君",
            "text": "璃月港也并不远在天边，若有虚言，也骗不过我。",
            "nextDialogs": [
              "10080712"
            ]
          },
          "10080712": {
            "id": "10080712",
            "speakerId": 10257,
            "speakerName": "理水叠山真君",
            "text": "帝君…遇刺了？",
            "nextDialogs": [
              "10080713"
            ]
          },
          "10080713": {
            "id": "10080713",
            "speakerId": 10257,
            "speakerName": "理水叠山真君",
            "text": "还是在「请仙典仪」上？！",
            "nextDialogs": [
              "10080714"
            ]
          },
          "10080714": {
            "id": "10080714",
            "speakerId": 10257,
            "speakerName": "理水叠山真君",
            "text": "璃月…凡间…谁敢如此！不…这世上又有多少力量，能刺杀帝君？",
            "nextDialogs": [
              "10080715"
            ]
          },
          "10080715": {
            "id": "10080715",
            "speakerId": 10257,
            "speakerName": "理水叠山真君",
            "text": "我等众仙遵帝君律令，护佑璃月。因人间兴盛，逐步退于山野，这本是对凡人的好意。",
            "nextDialogs": [
              "10080716"
            ]
          },
          "10080716": {
            "id": "10080716",
            "speakerId": 10257,
            "speakerName": "理水叠山真君",
            "text": "但如今…帝君…帝君…唉…",
            "nextDialogs": [
              "10080717"
            ]
          },
          "10080717": {
            "id": "10080717",
            "speakerId": 10257,
            "speakerName": "理水叠山真君",
            "text": "旅者，你述之事我已知晓。削月筑阳真君延请我等的意思，也已经很明白了。",
            "nextDialogs": [
              "10080718"
            ]
          },
          "10080718": {
            "id": "10080718",
            "speakerId": 10257,
            "speakerName": "理水叠山真君",
            "text": "待我将此山之事稍作处理，就去会见众仙。",
            "nextDialogs": [
              "10080719"
            ]
          },
          "10080719": {
            "id": "10080719",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "话说，那些琥珀是…",
            "nextDialogs": [
              "10080720"
            ]
          },
          "10080720": {
            "id": "10080720",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "我知道！一定是这位仙人的仙力啦，就和小说里写的一样…",
            "nextDialogs": [
              "10080721"
            ]
          },
          "10080721": {
            "id": "10080721",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "羽毛就能化为草木，唾液也能化为瀑流。这些琥珀，一定也是类似的形成原理！"
          },
          "10080707": {
            "id": "10080707",
            "speakerId": 10257,
            "speakerName": "理水叠山真君",
            "text": "削月筑阳真君…他托凡人带口信？"
          }
        }
      }
    },
    {
      "subId": "100897",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "10089701"
        ],
        "dialogs": {
          "10089701": {
            "id": "10089701",
            "speakerId": 10259,
            "speakerName": "李丁",
            "text": "我都听我兄弟说了，谢谢你们，谢谢你们搭救我兄弟。",
            "nextDialogs": [
              "10089702"
            ]
          },
          "10089702": {
            "id": "10089702",
            "speakerId": 10259,
            "speakerName": "李丁",
            "text": "唉，我们也是迫不得已，实在是无钱供养家庭，又听人说，琥牢山上的琥珀中藏有宝物…",
            "nextDialogs": [
              "10089703"
            ]
          },
          "10089703": {
            "id": "10089703",
            "speakerId": 10260,
            "speakerName": "李当",
            "text": "我们就鬼迷心窍，偷偷上山，想从琥珀里寻得几件宝物，拿回去卖点钱。",
            "nextDialogs": [
              "10089704"
            ]
          },
          "10089704": {
            "id": "10089704",
            "speakerId": 10260,
            "speakerName": "李当",
            "text": "结果…您也看到了，仙人对我施以惩诫，我就被琥珀给吞了下去，如果没你们搭救，还不知道什么时候能出来。",
            "nextDialogs": [
              "10089705"
            ]
          },
          "10089705": {
            "id": "10089705",
            "speakerId": 10259,
            "speakerName": "李丁",
            "text": "还好仙人慈悲，派下你们这两位仙使搭救…",
            "nextDialogs": [
              "10089707",
              "10089710"
            ]
          },
          "10089707": {
            "id": "10089707",
            "speakerId": 10259,
            "speakerName": "李丁",
            "text": "是啊，我刚在山上祈祷，你们就搭救了我兄弟。",
            "nextDialogs": [
              "10089708"
            ]
          },
          "10089708": {
            "id": "10089708",
            "speakerId": 10260,
            "speakerName": "李当",
            "text": "你们一定是仙人派下来的仙使。",
            "nextDialogs": [
              "10089712"
            ]
          },
          "10089712": {
            "id": "10089712",
            "speakerId": 10259,
            "speakerName": "李丁",
            "text": "蒙仙使搭救，我们兄弟以后一定痛改前非，去寻个正路赚钱，哪怕是去码头卖点力气，也是个说法。",
            "nextDialogs": [
              "10089713"
            ]
          },
          "10089713": {
            "id": "10089713",
            "speakerId": 10259,
            "speakerName": "李丁",
            "text": "啊，对了，可不能再叨扰仙府，我们这就下山，谢谢仙使…",
            "nextDialogs": [
              "10089714"
            ]
          },
          "10089714": {
            "id": "10089714",
            "speakerId": 10260,
            "speakerName": "李当",
            "text": "谢谢仙使…",
            "nextDialogs": [
              "10089715"
            ]
          },
          "10089715": {
            "id": "10089715",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "…要是我们真是什么「仙使」就好了。",
            "nextDialogs": [
              "10089716"

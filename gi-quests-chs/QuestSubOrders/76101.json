    {
      "subId": "7610106",
      "subQuestName": "前往广场",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "761010601"
        ],
        "dialogs": {
          "761010601": {
            "id": "761010601",
            "speakerId": 1324,
            "speakerName": "叶洛亚",
            "text": "要是比约恩也在就好了…",
            "nextDialogs": [
              "761010602"
            ]
          },
          "761010602": {
            "id": "761010602",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "他一定会非常自豪的。",
            "nextDialogs": [
              "761010603"
            ]
          },
          "761010603": {
            "id": "761010603",
            "speakerId": 1324,
            "speakerName": "叶洛亚",
            "text": "是啊。过几天再去看看他好了，告诉他城里的近况，让他放心。"
          }
        }
      }
    },
    {
      "subId": "7610108",
      "subQuestName": "激活增幅器",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "761010801"
        ],
        "dialogs": {
          "761010801": {
            "id": "761010801",
            "speakerId": 7184,
            "speakerName": "罗洛",
            "text": "#{NICKNAME}，宴会的餐饮还合你的口味吗？",
            "nextDialogs": [
              "761010802"
            ]
          },
          "761010802": {
            "id": "761010802",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "要是每天都有宴会就好了…",
            "nextDialogs": [
              "761010803"
            ]
          },
          "761010803": {
            "id": "761010803",
            "speakerId": 7184,
            "speakerName": "罗洛",
            "text": "每天吗？那或许有些勉强…",
            "nextDialogs": [
              "761010804"
            ]
          },
          "761010804": {
            "id": "761010804",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "只是开个玩笑！",
            "nextDialogs": [
              "761010805"
            ]
          },
          "761010805": {
            "id": "761010805",
            "speakerId": 7184,
            "speakerName": "罗洛",
            "text": "哈哈，是吗？不过也不是不能理解。希望今后能多一些像今天这样值得庆祝的日子。"
          }
        }
      }
    },

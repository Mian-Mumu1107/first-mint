    {
      "subId": "7610109",
      "subQuestName": "前往操作间",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "761010901"
        ],
        "dialogs": {
          "761010901": {
            "id": "761010901",
            "speakerId": 7180,
            "speakerName": "尼基塔",
            "text": "辛苦你们了，今天就暂且放下责任，好好休息吧。"
          }
        }
      }
    },
    {
      "subId": "7610110",
      "subQuestName": "前往操作间",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "761011001"
        ],
        "dialogs": {
          "761011001": {
            "id": "761011001",
            "speakerId": 22320,
            "speakerName": "奥拉维",
            "text": "机会难得，自从老爷子让我当了分队长，就只有这种场合才有机会跟兄弟们叙叙旧了。"
          }
        }
      }
    },
    {
      "subId": "7610111",
      "subQuestName": "击溃「恶卵」",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "761011101"
        ],
        "dialogs": {
          "761011101": {
            "id": "761011101",
            "speakerId": 22320,
            "speakerName": "奥拉维",
            "text": "别耽搁了，执灯长在麦酒大厅等你们。"
          }
        }
      }
    },
    {
      "subId": "7610113",
      "subQuestName": "与叶洛亚对话",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "761011301"
        ],
        "dialogs": {
          "761011301": {
            "id": "761011301",
            "speakerId": 22321,
            "speakerName": "「教授」",
            "text": "通往魔天的门扉已经开启，此等微弱的月矩力能奈我何！",
            "nextDialogs": [
              "761011302"
            ]
          },
          "761011302": {
            "id": "761011302",
            "speakerId": 22321,
            "speakerName": "「教授」",
            "text": "但为何我会被困囿于此…我明白了，是三宝磨又一次拒绝了我。",
            "nextDialogs": [
              "761011303"
            ]
          },
          "761011303": {
            "id": "761011303",
            "speakerId": 22199,
            "speakerName": "爱莉厄",
            "text": "瞧瞧是谁来了，稀客呀。",
            "nextDialogs": [
              "761011304"
            ]
          },
          "761011304": {
            "id": "761011304",
            "speakerId": 22321,
            "speakerName": "「教授」",
            "text": "…谁在那里？",
            "nextDialogs": [
              "761011305"
            ]
          },
          "761011305": {
            "id": "761011305",
            "speakerId": 22321,
            "speakerName": "「教授」",
            "text": "这副模样…啊，是你，雷勒。太好了，我就知道你还活着。",
            "nextDialogs": [
              "761011306"
            ]
          },
          "761011306": {
            "id": "761011306",
            "speakerId": 22321,
            "speakerName": "「教授」",
            "text": "现在，命令三宝磨的力量臣服于我！拥有圣嗣之血的你一定能做到。毕竟和那三个废物不同，你是我最欣赏的弟子啊。",
            "nextDialogs": [
              "761011307"
            ]
          },
          "761011307": {
            "id": "761011307",
            "speakerId": 22199,
            "speakerName": "爱莉厄",
            "text": "哈，居然把我认作了雷勒…当年那个巧舌如簧的妖僧竟然昏聩至此，真是讽刺。",
            "nextDialogs": [
              "761011308"
            ]
          },
          "761011308": {
            "id": "761011308",
            "speakerId": 22321,
            "speakerName": "「教授」",
            "text": "不要犹豫，雷勒。你忘记我们共同的理想了吗？你不想取回那本应属于你的地位与身份了吗？",
            "nextDialogs": [
              "761011309"
            ]
          },
          "761011309": {
            "id": "761011309",
            "speakerId": 22321,
            "speakerName": "「教授」",
            "text": "为受欺凌和侮辱的人们创造「乐园」，让那些丑陋的妖精贵族都对你俯首，整个苍星王廷只有同为人类的我愿意帮你。",
            "nextDialogs": [
              "761011310"
            ]
          },
          "761011310": {
            "id": "761011310",
            "speakerId": 22321,
            "speakerName": "「教授」",
            "text": "如今，只差最后一步我就能登上群星的阶梯…当天穹之外的「乐园」降临时，唯有你我这样的受选之人才能够活下来。",
            "nextDialogs": [
              "761011311"
            ]
          },
          "761011311": {
            "id": "761011311",
            "speakerId": 22321,
            "speakerName": "「教授」",
            "text": "那时，所有的腐败与污秽都将被洗净，这不正是你所渴望的世界吗？",
            "nextDialogs": [
              "761011312"
            ]
          },
          "761011312": {
            "id": "761011312",
            "speakerId": 22199,
            "speakerName": "爱莉厄",
            "text": "不，那并非他想要的世界…都到这种时候了，还在试图施展你那拙劣的骗术吗？",
            "nextDialogs": [
              "761011313"
            ]
          },
          "761011313": {
            "id": "761011313",
            "speakerId": 22199,
            "speakerName": "爱莉厄",
            "text": "从一开始你就在利用他，所有的谎言都不过是为了让他替你取得三宝磨，你口中的那个「乐园」从来就只有你自己。",
            "nextDialogs": [
              "761011314"
            ]
          },
          "761011314": {
            "id": "761011314",
            "speakerId": 22199,
            "speakerName": "爱莉厄",
            "text": "就连他一开始会丢掉军官的身份成为大盗，也是因为你和阿尔维斯大公共同设下的圈套吧。",
            "nextDialogs": [
              "761011315"
            ]
          },
          "761011315": {
            "id": "761011315",
            "speakerId": 22321,
            "speakerName": "「教授」",
            "text": "……",
            "nextDialogs": [
              "761011316"
            ]
          },
          "761011316": {
            "id": "761011316",
            "speakerId": 22199,
            "speakerName": "爱莉厄",
            "text": "虽然你认错了人，不过继承了他身份与意志的我，当然也不会拒绝雷德·米勒之名。",
            "nextDialogs": [
              "761011317"
            ]
          },
          "761011317": {
            "id": "761011317",
            "speakerId": 22199,
            "speakerName": "爱莉厄",
            "text": "以雷德·米勒的名义，拉乌斯万格，妖僧，「教授」，不死的毒蛇…就由我为你的故事画上最后的句点吧。",
            "nextDialogs": [
              "761011318"
            ]
          },
          "761011318": {
            "id": "761011318",
            "speakerId": 1324,
            "speakerName": "叶洛亚",
            "text": "我们做到了…",
            "nextDialogs": [
              "761011319"
            ]
          },
          "761011319": {
            "id": "761011319",
            "speakerId": 1324,
            "speakerName": "叶洛亚",
            "text": "这次终于，将那不死的妖魔彻底葬送了…",
            "nextDialogs": [
              "761011320"
            ]
          },
          "761011320": {
            "id": "761011320",
            "speakerId": 1004,
            "speakerName": "Black Screen",
            "text": "「那不死的毒蛇必将两度复活，再被三次击倒…直到被月下世界的英雄们彻底埋葬…」\\n与英勇的执灯士们并肩作战，终于消灭了「教授」…",
            "nextDialogs": [
              "761011321"
            ]
          },
          "761011321": {
            "id": "761011321",
            "speakerId": 1004,
            "speakerName": "Black Screen",
            "text": "之后，在皮拉米达城盘桓了数日…"
          }
        }
      }
    },

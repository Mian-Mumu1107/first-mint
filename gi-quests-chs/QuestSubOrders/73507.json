  "subQuests": [
    {
      "subId": "7350701",
      "subQuestName": "与摊位旁的两人对话",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "735070101"
        ],
        "dialogs": {
          "735070101": {
            "id": "735070101",
            "speakerId": 1000,
            "speakerName": "海妮耶",
            "text": "#「黄金流星」{NICKNAME}和「白银伴星」派蒙，好久不见了。",
            "nextDialogs": [
              "735070102"
            ]
          },
          "735070102": {
            "id": "735070102",
            "speakerId": 1000,
            "speakerName": "海妮耶",
            "text": "你们还是这么有精神呢！",
            "nextDialogs": [
              "735070104",
              "735070107"
            ]
          },
          "735070104": {
            "id": "735070104",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "海海海，海妮耶！还有那个超负责的…贝尔福先生？",
            "nextDialogs": [
              "735070105"
            ]
          },
          "735070105": {
            "id": "735070105",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "真没想到，居然又在奥摩斯港遇见你们了！",
            "nextDialogs": [
              "735070114"
            ]
          },
          "735070114": {
            "id": "735070114",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "话说回来，海妮耶和贝尔福在这里干什么呢？我记得这里以前是「花花琼脂」的摊位…",
            "nextDialogs": [
              "735070115"
            ]
          },
          "735070115": {
            "id": "735070115",
            "speakerId": 1002,
            "speakerName": "贝尔福",
            "text": "两位大英雄，听着你们的声音，我的心里也更有底气了。",
            "nextDialogs": [
              "735070116"
            ]
          },
          "735070116": {
            "id": "735070116",
            "speakerId": 1002,
            "speakerName": "贝尔福",
            "text": "接下来，就是我向两位汇报工作成果的时候了。",
            "nextDialogs": [
              "735070117"
            ]
          },
          "735070117": {
            "id": "735070117",
            "speakerId": 1002,
            "speakerName": "贝尔福",
            "text": "之前两位作为「月莲杯驯兽师大赛」的冠军，决定让大赛暂时休赛，先让教令院改进「意智宝珠」。",
            "nextDialogs": [
              "735070118"
            ]
          },
          "735070118": {
            "id": "735070118",
            "speakerId": 1002,
            "speakerName": "贝尔福",
            "text": "两位应该还在等待通知？",
            "nextDialogs": [
              "735070119"
            ]
          },
          "735070119": {
            "id": "735070119",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "对哦！等到有进展了，莱依拉、赛诺或者负责的学者应该会想办法告诉我们的！"
          },
          "735070107": {
            "id": "735070107",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "#{NICKNAME}，你在说什么呀？",
            "nextDialogs": [
              "735070108"
            ]
          },
          "735070108": {
            "id": "735070108",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "之前我们参加了「月莲杯驯兽师大赛」，和蕈兽伙伴们玩得很开心啊！",
            "nextDialogs": [
              "735070109"
            ]
          },
          "735070109": {
            "id": "735070109",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "海妮耶就是我们在那时候认识的好朋友，贝尔福先生则是大赛最负责的工作人员。",
            "nextDialogs": [
              "735070110"
            ]
          },
          "735070110": {
            "id": "735070110",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "难道，就连「咚咚小圆帽」、「转转悠悠兽」，这些蕈兽伙伴，你都不记得了吗？"
          }
        }
      }
    },
    {
      "subId": "7350706",
      "subQuestName": "",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "735070501"
        ],
        "dialogs": {
          "735070501": {
            "id": "735070501",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "「咚咚小圆帽」，我们来击掌吧。",
            "nextDialogs": [
              "735070502"
            ]
          },
          "735070502": {
            "id": "735070502",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "「欢腾之火」，我们一起和「咚咚小圆帽」来跳舞！",
            "nextDialogs": [
              "735070503"
            ]
          },
          "735070503": {
            "id": "735070503",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "啊呀，虽然和「欢腾之火」也很熟悉了，但好像还是没法做到和「咚咚小圆帽」那样顺畅沟通呢…",
            "nextDialogs": [
              "735070506"
            ]
          },
          "735070506": {
            "id": "735070506",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "#你来了，{NICKNAME}！",
            "nextDialogs": [
              "735070507"
            ]
          },
          "735070507": {
            "id": "735070507",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "「灵蕈棋阵」的情况还好吗？"
          }
        }
      }
    },
    {

    {
      "subId": "7350704",
      "subQuestName": "试玩「灵蕈棋阵」",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "735070401"
        ],
        "dialogs": {
          "735070401": {
            "id": "735070401",
            "speakerId": 1002,
            "speakerName": "贝尔福",
            "text": "事不宜迟，就请「黄金流星」来体验一下内部测试版的「灵蕈棋阵」吧！"
          }
        }
      }
    },
    {
      "subId": "7350703",
      "subQuestName": "与海妮耶和贝尔福对话",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "735070301"
        ],
        "dialogs": {
          "735070301": {
            "id": "735070301",
            "speakerId": 1002,
            "speakerName": "贝尔福",
            "text": "怎么样，「黄金流星」？初次尝试「灵蕈棋阵」的感觉如何？",
            "nextDialogs": [
              "735070302"
            ]
          },
          "735070302": {
            "id": "735070302",
            "speakerId": 1000,
            "speakerName": "海妮耶",
            "text": "看你的神情，似乎还没法得出结论？",
            "nextDialogs": [
              "735070305"
            ]
          },
          "735070305": {
            "id": "735070305",
            "speakerId": 1002,
            "speakerName": "贝尔福",
            "text": "嗯，测试的内容太少，确实很难考察出「灵蕈棋阵」的优缺点。",
            "nextDialogs": [
              "735070306"
            ]
          },
          "735070306": {
            "id": "735070306",
            "speakerId": 1002,
            "speakerName": "贝尔福",
            "text": "请别担心，接下来一段时间里，我和海妮耶小姐会一直待在这里，每天都准备一个新的「灵蕈棋阵」关卡，共计七个。",
            "nextDialogs": [
              "735070307"
            ]
          },
          "735070307": {
            "id": "735070307",
            "speakerId": 1002,
            "speakerName": "贝尔福",
            "text": "等你有空的时候，就能来进行测试！",
            "nextDialogs": [
              "735070308"
            ]
          },
          "735070308": {
            "id": "735070308",
            "speakerId": 1002,
            "speakerName": "贝尔福",
            "text": "虽然你是主办方的最终决定人，但这个游戏毕竟是我拉着海妮耶小姐擅自筹备的，不在你的计划之内，会占用你的时间。",
            "nextDialogs": [
              "735070309"
            ]
          },
          "735070309": {
            "id": "735070309",
            "speakerId": 1002,
            "speakerName": "贝尔福",
            "text": "为此，我也会给你一笔辛苦费的！"
          }
        }
      }
    },

    {
      "subId": "1102403",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "110240301"
        ],
        "dialogs": {
          "110240301": {
            "id": "110240301",
            "speakerId": 10232,
            "speakerName": "钟离",
            "text": "我还想在这里多待一会儿，以后能像此番追忆的机会，只怕会越来越少了。",
            "nextDialogs": [
              "110240303",
              "110240306",
              "110240309"
            ]
          },
          "110240303": {
            "id": "110240303",
            "speakerId": 10232,
            "speakerName": "钟离",
            "text": "在魔神战争的年代，断定事物善恶是非的标准，都和现在不同。",
            "nextDialogs": [
              "110240304"
            ]
          },
          "110240304": {
            "id": "110240304",
            "speakerId": 10232,
            "speakerName": "钟离",
            "text": "当然…现在的我，也希望她能生在一个更加温柔的时代。"
          },
          "110240306": {
            "id": "110240306",
            "speakerId": 10232,
            "speakerName": "钟离",
            "text": "虽然「盐盏」与「盐尺」仍具权能，可对奥赛尔来说，不值一提。",
            "nextDialogs": [
              "110240307"
            ]
          },
          "110240307": {
            "id": "110240307",
            "speakerId": 10232,
            "speakerName": "钟离",
            "text": "若有朝一日他恢复元气，卷土重来…呵，一定会再次被击败吧。"
          },
          "110240309": {
            "id": "110240309",
            "speakerId": 10232,
            "speakerName": "钟离",
            "text": "好问题，如果是以前，可能会给你特别具体的答案。",
            "nextDialogs": [
              "110240310"
            ]
          },
          "110240310": {
            "id": "110240310",
            "speakerId": 10232,
            "speakerName": "钟离",
            "text": "但现在…嗯，大概是想要继续履行往生堂客卿的职责。",
            "nextDialogs": [
              "110240311"
            ]
          },
          "110240311": {
            "id": "110240311",
            "speakerId": 10232,
            "speakerName": "钟离",
            "text": "不过，如果这次的旅途你乐在其中的话，下次「记录」，不妨再结伴同行吧。"
          }
        }
      }
    }
  ]
}
    {
      "subId": "1203112",
      "subQuestName": "到乌有亭附近",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "120311901"
        ],
        "dialogs": {
          "120311901": {
            "id": "120311901",
            "speakerId": 1004,
            "speakerName": "响太",
            "text": "《旅行者的奇妙冒险》竟然还没出下一章，真是急死我了！",
            "nextDialogs": [
              "120311902"
            ]
          },
          "120311902": {
            "id": "120311902",
            "speakerId": 1005,
            "speakerName": "大助",
            "text": "没想到无月之夜还真的出现了。",
            "nextDialogs": [
              "120311903"
            ]
          },
          "120311903": {
            "id": "120311903",
            "speakerId": 1006,
            "speakerName": "哲夫",
            "text": "对啊，那天晚上汇聚在影向山顶上，好大一片黑压压的云彩！",
            "nextDialogs": [
              "120311904"
            ]
          },
          "120311904": {
            "id": "120311904",
            "speakerId": 1005,
            "speakerName": "大助",
            "text": "不过用书上的办法许愿了之后，却什么都没有发生。",
            "nextDialogs": [
              "120311905"
            ]
          },
          "120311905": {
            "id": "120311905",
            "speakerId": 1006,
            "speakerName": "哲夫",
            "text": "唉，看来轻小说毕竟只是轻小说啊。",
            "nextDialogs": [
              "120311906"
            ]
          },
          "120311906": {
            "id": "120311906",
            "speakerId": 1005,
            "speakerName": "大助",
            "text": "这件事之后，小说里的咒语什么的，就完全不流行了呢。不过《旅行者的奇妙冒险》应该还能搞出有趣的内容吧！",
            "nextDialogs": [
              "120311907"
            ]
          },
          "120311907": {
            "id": "120311907",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "咦，周围没看见神子呢。",
            "nextDialogs": [
              "120311908"
            ]
          },
          "120311908": {
            "id": "120311908",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "神子好像不在店外面，会不会已经进去了？我们去里面找找吧。"
          }
        }
      }
    },

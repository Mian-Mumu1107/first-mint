            ]
          },
          "740820905": {
            "id": "740820905",
            "speakerId": 1006,
            "speakerName": "珀西芙",
            "text": "#派蒙，珀西芙！{NICKNAME}，珀西芙！钥匙，钥匙，钥匙…",
            "nextDialogs": [
              "740820906"
            ]
          },
          "740820906": {
            "id": "740820906",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "广场，西！",
            "nextDialogs": [
              "740820907"
            ]
          },
          "740820907": {
            "id": "740820907",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "嘿嘿，你是不是想说这个啦？不要急，我们现在就过去。"
          }
        }
      }
    },
    {
      "subId": "7408299",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "740829901"
        ],
        "dialogs": {
          "740829901": {
            "id": "740829901",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "呜哇！这个奇形怪状的树是什么，感觉有点空荡荡的，下面还有一座祭坛。",
            "nextDialogs": [
              "740829905"
            ]
          },
          "740829905": {
            "id": "740829905",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "以我的经验看，这绝对就是在告诉我们「喂！我这里有宝贝哦，快来找找吧！」",
            "nextDialogs": [
              "740829904"
            ]
          },
          "740829904": {
            "id": "740829904",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "看！那边有好多雾哦，那个会不会是幽林雾道？我们快过去调查一下。"
          }
        }
      }
    },

    {
      "subId": "7408207",
      "subQuestName": "与美露莘对话",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "740820701"
        ],
        "dialogs": {
          "740820701": {
            "id": "740820701",
            "speakerId": 1003,
            "speakerName": "Black Screen",
            "text": "一滴晶莹的水珠出现在了祭坛上。",
            "nextDialogs": [
              "740820702"
            ]
          },
          "740820702": {
            "id": "740820702",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "咦，这滴水珠…这滴水珠不会就是宝藏吧？",
            "nextDialogs": [
              "740820703"
            ]
          },
          "740820703": {
            "id": "740820703",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "长得不太像宝藏。",
            "nextDialogs": [
              "740820704"
            ]
          },
          "740820704": {
            "id": "740820704",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "我也觉得…毕竟这么顺利就得到了…那它会是什么呢？",
            "nextDialogs": [
              "740820706",
              "740820711"
            ]
          },
          "740820706": {
            "id": "740820706",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "什么？那我们岂不是闯大祸了，快！快把它放回去！希望还来得及！",
            "nextDialogs": [
              "740820707"
            ]
          },
          "740820707": {
            "id": "740820707",
            "speakerId": 1004,
            "speakerName": "？？？",
            "text": "啊…",
            "nextDialogs": [
              "740820708"
            ]
          },
          "740820708": {
            "id": "740820708",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "完蛋了！魔王出来了！",
            "nextDialogs": [
              "740820709"
            ]
          },
          "740820709": {
            "id": "740820709",
            "speakerId": 1004,
            "speakerName": "？？？",
            "text": "魔王？美露莘。",
            "nextDialogs": [
              "740820715"
            ]
          },
          "740820715": {
            "id": "740820715",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "吓死我了…原来是一位美露莘…你怎么在这里呀？",
            "nextDialogs": [
              "740820716"
            ]
          },
          "740820716": {
            "id": "740820716",
            "speakerId": 1004,
            "speakerName": "？？？",
            "text": "钥匙。",
            "nextDialogs": [
              "740820717"
            ]
          },
          "740820717": {
            "id": "740820717",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "什么…什么钥匙？这滴水珠是钥匙？",
            "nextDialogs": [
              "740820718"
            ]
          },
          "740820718": {
            "id": "740820718",
            "speakerId": 1004,
            "speakerName": "？？？",
            "text": "珀西芙。",
            "nextDialogs": [
              "740820719"
            ]
          },
          "740820719": {
            "id": "740820719",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "呃…这滴水珠是珀西芙？",
            "nextDialogs": [
              "740820720"
            ]
          },
          "740820720": {
            "id": "740820720",
            "speakerId": 1004,
            "speakerName": "？？？",
            "text": "美露莘。",
            "nextDialogs": [
              "740820721"
            ]
          },
          "740820721": {
            "id": "740820721",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "哎呀！什么意思？这滴水珠是美露莘？我有点晕了，到底是什么啦，你不才是美露莘吗？",
            "nextDialogs": [
              "740820722"
            ]
          },
          "740820722": {
            "id": "740820722",
            "speakerId": 1004,
            "speakerName": "？？？",
            "text": "珀西芙…",
            "nextDialogs": [
              "740820723"
            ]
          },
          "740820723": {
            "id": "740820723",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "呃…你是珀西芙？还是你叫珀西芙？等等…我肯定会被你的答案弄得更晕…",
            "nextDialogs": [
              "740820724"
            ]
          },
          "740820724": {
            "id": "740820724",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "我决定就叫你珀西芙了，好不好？",
            "nextDialogs": [
              "740820725"
            ]
          },
          "740820725": {
            "id": "740820725",
            "speakerId": 1005,
            "speakerName": "珀西芙？",
            "text": "美露莘…",
            "nextDialogs": [
              "740820726"
            ]
          },
          "740820726": {
            "id": "740820726",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "#{NICKNAME}…怎么办？我完全搞不懂她的意思，她到底在说什么…",
            "nextDialogs": [
              "740820727"
            ]
          },
          "740820727": {
            "id": "740820727",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "你能听懂我们的话，对吗？",
            "nextDialogs": [
              "740820728"
            ]
          },
          "740820728": {
            "id": "740820728",
            "speakerId": 1005,
            "speakerName": "珀西芙？",
            "text": "珀西芙…",
            "nextDialogs": [
              "740820729"
            ]
          },
          "740820729": {
            "id": "740820729",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "这滴水珠是钥匙，对吗？",
            "nextDialogs": [
              "740820730"
            ]
          },
          "740820730": {
            "id": "740820730",
            "speakerId": 1005,
            "speakerName": "珀西芙？",
            "text": "珀西芙。",
            "nextDialogs": [
              "740820731"
            ]
          },
          "740820731": {
            "id": "740820731",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "你不是人，对吗？",
            "nextDialogs": [
              "740820732"
            ]
          },
          "740820732": {
            "id": "740820732",
            "speakerId": 1005,
            "speakerName": "珀西芙？",
            "text": "珀西芙！",
            "nextDialogs": [
              "740820733"
            ]
          },
          "740820733": {
            "id": "740820733",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "呃…突然骂人不太好吧…",
            "nextDialogs": [
              "740820734"
            ]
          },
          "740820734": {
            "id": "740820734",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "我不是人，对吗？",
            "nextDialogs": [
              "740820735"
            ]
          },
          "740820735": {
            "id": "740820735",
            "speakerId": 1005,
            "speakerName": "珀西芙？",
            "text": "美…美露莘？",
            "nextDialogs": [
              "740820736"
            ]
          },
          "740820736": {
            "id": "740820736",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "啊！等等，我好像有点听出来了…「珀西芙」的意思是肯定，「美露莘」的意思是否定，难道是这个意思？",
            "nextDialogs": [
              "740820737"
            ]
          },
          "740820737": {
            "id": "740820737",
            "speakerId": 1005,
            "speakerName": "珀西芙？",
            "text": "珀西芙！珀西芙！",
            "nextDialogs": [
              "740820738"
            ]
          },
          "740820738": {
            "id": "740820738",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "原来你不是叫珀西芙…对不起，我搞错了你的名字。",
            "nextDialogs": [
              "740820739"
            ]
          },
          "740820739": {
            "id": "740820739",
            "speakerId": 1005,
            "speakerName": "珀西芙？",
            "text": "珀西芙…喜欢…",
            "nextDialogs": [
              "740820740"
            ]
          },
          "740820740": {
            "id": "740820740",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "你喜欢这个名字？",
            "nextDialogs": [
              "740820741"
            ]
          },
          "740820741": {
            "id": "740820741",
            "speakerId": 1005,
            "speakerName": "珀西芙？",
            "text": "珀西芙！",
            "nextDialogs": [
              "740820742"
            ]
          },
          "740820742": {
            "id": "740820742",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "#太好了！那就这么叫你了，嘿嘿。我是派蒙，这是{NICKNAME}，很高兴认识你，珀西芙，我还没见过你这样的美露莘呢。",
            "nextDialogs": [
              "740820743"
            ]
          },
          "740820743": {
            "id": "740820743",
            "speakerId": 1006,
            "speakerName": "珀西芙",
            "text": "#派蒙，珀西芙！{NICKNAME}，珀西芙！",
            "nextDialogs": [
              "740820744"
            ]
          },
          "740820744": {
            "id": "740820744",
            "speakerId": 1006,
            "speakerName": "珀西芙",
            "text": "伊黎耶…美露莘…",
            "nextDialogs": [
              "740820745"
            ]
          },
          "740820745": {
            "id": "740820745",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "…伊黎耶否定？呃…",
            "nextDialogs": [
              "740820746"
            ]
          },
          "740820746": {
            "id": "740820746",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "伊黎耶岛不好了？",
            "nextDialogs": [
              "740820747"
            ]
          },
          "740820747": {
            "id": "740820747",
            "speakerId": 1006,
            "speakerName": "珀西芙",
            "text": "伊黎耶，美露莘，现在…",
            "nextDialogs": [
              "740820748"
            ]
          },
          "740820748": {
            "id": "740820748",
            "speakerId": 1006,
            "speakerName": "珀西芙",
            "text": "珀西芙，伊黎耶，保护…",
            "nextDialogs": [
              "740820749"
            ]
          },
          "740820749": {
            "id": "740820749",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "伊黎耶岛正在变得不好，然后，你要保护它？",
            "nextDialogs": [
              "740820750"
            ]
          },
          "740820750": {
            "id": "740820750",
            "speakerId": 1006,
            "speakerName": "珀西芙",
            "text": "#派蒙，{NICKNAME}，伊黎耶，邦邦，邦邦…",
            "nextDialogs": [
              "740820751"
            ]
          },
          "740820751": {
            "id": "740820751",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "#呃…这次有五个词，呃…你希望派蒙和{NICKNAME}给伊黎耶岛邦邦邦邦来两下子？",
            "nextDialogs": [
              "740820752"
            ]
          },
          "740820752": {
            "id": "740820752",
            "speakerId": 1006,
            "speakerName": "珀西芙",
            "text": "美露莘！",
            "nextDialogs": [
              "740820753"
            ]
          },
          "740820753": {
            "id": "740820753",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "你希望我们帮忙？",
            "nextDialogs": [
              "740820754"
            ]
          },
          "740820754": {
            "id": "740820754",
            "speakerId": 1006,
            "speakerName": "珀西芙",
            "text": "珀西芙！",
            "nextDialogs": [
              "740820755"
            ]
          },
          "740820755": {
            "id": "740820755",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "原来是帮忙呀，幸好幸好，如果要让我们给这座岛来两下子，那真的挺难办的…",
            "nextDialogs": [
              "740820756"
            ]
          },
          "740820756": {
            "id": "740820756",
            "speakerId": 1006,
            "speakerName": "珀西芙",
            "text": "邦邦，邦邦…"
          },
          "740820711": {
            "id": "740820711",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "什么？完蛋了，那我们不就成小偷了？对不起对不起…我们快把东西放回去吧…",
            "nextDialogs": [
              "740820712"
            ]
          },
          "740820712": {
            "id": "740820712",
            "speakerId": 1004,
            "speakerName": "？？？",
            "text": "啊…",
            "nextDialogs": [
              "740820713"
            ]
          },
          "740820713": {
            "id": "740820713",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "完蛋了！主人回来了！",
            "nextDialogs": [
              "740820714"
            ]
          },
          "740820714": {
            "id": "740820714",
            "speakerId": 1004,
            "speakerName": "？？？",
            "text": "主人？美露莘。"
          }
        }
      }
    },
    {
      "subId": "7408204",

    {
      "subId": "7408209",
      "subQuestName": "(test)（隐藏）交互祭坛$HIDDEN",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "740820401"
        ],
        "dialogs": {
          "740820401": {
            "id": "740820401",
            "speakerId": 1002,
            "speakerName": "神秘祭坛",
            "text": "（大部分字迹被磨毁，仅能依稀辨识出——「…清露…三…」）",
            "nextDialogs": [
              "740820402"
            ]
          },
          "740820402": {
            "id": "740820402",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "可恶，这上面的字也被毁掉了，一定有秘密！",
            "nextDialogs": [
              "740820404",
              "740820407"
            ]
          },
          "740820404": {
            "id": "740820404",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "「清露」是什么意思？清清的露水？可是这附近到处都是水啊？",
            "nextDialogs": [
              "740820405"
            ]
          },
          "740820405": {
            "id": "740820405",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "至于这个「三」字，该不会是指三滴水吧？真头痛…",
            "nextDialogs": [
              "740820409"
            ]
          },
          "740820409": {
            "id": "740820409",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "快问问你的绝对敏锐宝藏嗅觉啊！",
            "nextDialogs": [
              "740820410"
            ]
          },
          "740820410": {
            "id": "740820410",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "已经问过了！总之…总之…",
            "nextDialogs": [
              "740820411"
            ]
          },
          "740820411": {
            "id": "740820411",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "总之它说跟「三」和「水」有关嘛，我们应该在附近找一找！"
          },
          "740820407": {
            "id": "740820407",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "「三」是三个东西的意思吗？",
            "nextDialogs": [
              "740820408"
            ]
          },
          "740820408": {
            "id": "740820408",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "至于「清露」，难道是清清的露水？可是这附近到处都是水…真头痛…"
          }
        }
      }
    },

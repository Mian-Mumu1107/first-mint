  "subQuests": [
    {
      "subId": "7408201",
      "subQuestName": "(test)（隐藏）调查雕像$HIDDEN",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "740820101"
        ],
        "dialogs": {
          "740820101": {
            "id": "740820101",
            "speakerId": 1000,
            "speakerName": "刻字的石碑",
            "text": "（大部分字迹被磨毁，仅能依稀辨识出——「…清露…歌于幽林雾道…」）",
            "nextDialogs": [
              "740820102"
            ]
          },
          "740820102": {
            "id": "740820102",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "哎呀！好多字被磨掉了！这些应该是什么景点介绍吧？有些游客真是不太道德。",
            "nextDialogs": [
              "740820103"
            ]
          },
          "740820103": {
            "id": "740820103",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "游客应该只会写字的。",
            "nextDialogs": [
              "740820104"
            ]
          },
          "740820104": {
            "id": "740820104",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "#嗯…说的也对，比如写点{NICKNAME}和派蒙在此一游之类的…不不不，我们很有道德，我们不会乱写…",
            "nextDialogs": [
              "740820105"
            ]
          },
          "740820105": {
            "id": "740820105",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "那这样想就奇怪了，为什么字被磨掉了？只剩下这句…",
            "nextDialogs": [
              "740820106"
            ]
          },
          "740820106": {
            "id": "740820106",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "就连这句上面也有好多划痕，肯定是没磨干净，幸运的幽林雾道，你是漏网之鱼哦。",
            "nextDialogs": [
              "740820107"
            ]
          },
          "740820107": {
            "id": "740820107",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "幽林雾道是什么地方？",
            "nextDialogs": [
              "740820108"
            ]
          },
          "740820108": {
            "id": "740820108",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "嗯…林子里面有很多雾的道路？是这个意思吧…",
            "nextDialogs": [
              "740820109"
            ]
          },
          "740820109": {
            "id": "740820109",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "有点想去找找看呢，总感觉隐藏了什么秘密，最后指向一个珍贵的宝藏！书里都是这么写的，嘿嘿。",
            "nextDialogs": [
              "740820112"
            ]
          },
          "740820112": {
            "id": "740820112",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "我才不是只会吃东西的派蒙！我有预感，这个幽林雾道一定藏着宝藏，所以才会被人掩盖！",
            "nextDialogs": [
              "740820113"
            ]
          },
          "740820113": {
            "id": "740820113",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "#{NICKNAME}，是时候开始寻宝之旅了！带上你最好的伙伴，拥有绝对敏锐宝藏嗅觉的派蒙出发吧！"
          }
        }
      }
    },

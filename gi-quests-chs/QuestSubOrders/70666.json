        ],
        "dialogs": {
          "706660101": {
            "id": "706660101",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "进行突破挑战！",
            "nextDialogs": [
              "706660102"
            ]
          },
          "706660102": {
            "id": "706660102",
            "speakerId": 1000,
            "speakerName": "「小王子」",
            "text": "#喵…「哎呀，要来进行牌手等级突破的试炼吗…嗯，{NICKNAME}确实已经拥有了挑战的资格，那我这就…」",
            "nextDialogs": [
              "706660103"
            ]
          },
          "706660103": {
            "id": "706660103",
            "speakerId": 1000,
            "speakerName": "「小王子」",
            "text": "「这就让恕筠准备突破试炼所用的牌局吧，可要小心应对呀…」"
          }
        }
      }
    },
    {
      "subId": "7066602",
      "subQuestName": "与「小王子」进行突破对局",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "706660201"
        ],
        "dialogs": {
          "706660201": {
            "id": "706660201",
            "speakerId": 1000,
            "speakerName": "「小王子」",
            "text": "喵！「真是了不起，恭喜你突破了牌手等级的试炼，现在已经是高级牌手了！」",
            "nextDialogs": [
              "706660202"
            ]
          },
          "706660202": {
            "id": "706660202",
            "speakerId": 1000,
            "speakerName": "「小王子」",
            "text": "喵？「只是完成一次试炼就成为了高级牌手？哎呀，因为世上大部分人把打牌视为玩乐，所以不太认真对待…」",
            "nextDialogs": [
              "706660203"
            ]
          },
          "706660203": {
            "id": "706660203",
            "speakerId": 1000,
            "speakerName": "「小王子」",
            "text": "「也就是说，认真玩乐的人反倒才是少数，但是，就算是玩乐，也有认真投入的价值。」",
            "nextDialogs": [
              "706660204"
            ]
          },
          "706660204": {
            "id": "706660204",
            "speakerId": 1000,
            "speakerName": "「小王子」",
            "text": "喵！「啊，对了，现在你获得了我的认可，也可以挑战酒馆里其他的家伙设下的牌局，嗯…他们应该会喜欢你的。」",
            "nextDialogs": [
              "706660205"
            ]
          },
          "706660205": {
            "id": "706660205",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "其他的家伙？",
            "nextDialogs": [
              "706660206"
            ]
          },
          "706660206": {
            "id": "706660206",
            "speakerId": 1000,
            "speakerName": "「小王子」",
            "text": "喵。「嗯，当然和我一样，是酒馆里的猫…可别小看他们。」",
            "nextDialogs": [
              "706660207"
            ]
          },
          "706660207": {
            "id": "706660207",
            "speakerId": 1000,
            "speakerName": "「小王子」",
            "text": "喵~「到时候就让恕筠为他们执牌吧，好了，按照惯例，得说一句那个！」",
            "nextDialogs": [
              "706660208"
            ]
          },
          "706660208": {
            "id": "706660208",
            "speakerId": 1000,
            "speakerName": "「小王子」",
            "text": "#「{NICKNAME}，希望你能感受到『七圣召唤』的乐趣！」"
          }
        }
      }
    },
    {

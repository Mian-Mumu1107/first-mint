    {
      "subId": "101005",
      "subQuestName": "进入琉璃亭",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "10100501"
        ],
        "dialogs": {
          "10100501": {
            "id": "10100501",
            "speakerId": 10200,
            "speakerName": "「公子」",
            "text": "我来介绍一下，这位朋友是道上人士、「往生堂」的客卿，钟离先生。",
            "nextDialogs": [
              "10100504"
            ]
          },
          "10100504": {
            "id": "10100504",
            "speakerId": 10200,
            "speakerName": "「公子」",
            "text": "嗯，在璃月，像「往生堂」这样的产业，总是不得不接触一些「道上」的生意。",
            "nextDialogs": [
              "10100505"
            ]
          },
          "10100505": {
            "id": "10100505",
            "speakerId": 10200,
            "speakerName": "「公子」",
            "text": "而我们愚人众，一向都喜欢与这些…在阴影中行走的朋友们打交道。",
            "nextDialogs": [
              "10100506"
            ]
          },
          "10100506": {
            "id": "10100506",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "在，在阴影中行走…",
            "nextDialogs": [
              "10100507"
            ]
          },
          "10100507": {
            "id": "10100507",
            "speakerId": 10232,
            "speakerName": "钟离",
            "text": "二位，幸会。我听过你们在蒙德的传闻。",
            "nextDialogs": [
              "10100508"
            ]
          },
          "10100508": {
            "id": "10100508",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "道上人士…阴影…送人「往生」…哇！难道说，「往生堂」这个组织，是…",
            "nextDialogs": [
              "10100509"
            ]
          },
          "10100509": {
            "id": "10100509",
            "speakerId": 10232,
            "speakerName": "钟离",
            "text": "没错，正如你所猜测。",
            "nextDialogs": [
              "10100510"
            ]
          },
          "10100510": {
            "id": "10100510",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "呀——！",
            "nextDialogs": [
              "10100511"
            ]
          },
          "10100511": {
            "id": "10100511",
            "speakerId": 10232,
            "speakerName": "钟离",
            "text": "「往生堂」是执掌葬仪的组织，旨在送人安心往生。",
            "nextDialogs": [
              "10100512"
            ]
          },
          "10100512": {
            "id": "10100512",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "咦。",
            "nextDialogs": [
              "10100513"
            ]
          },
          "10100513": {
            "id": "10100513",
            "speakerId": 10200,
            "speakerName": "「公子」",
            "text": "哈哈，难道是把钟离先生误认成杀手了？",
            "nextDialogs": [
              "10100514"
            ]
          },
          "10100514": {
            "id": "10100514",
            "speakerId": 10200,
            "speakerName": "「公子」",
            "text": "愚人众的朋友里确实有很多杀手，但「往生堂」并不是做这一行的…起码明面上不是。",
            "nextDialogs": [
              "10100515"
            ]
          },
          "10100515": {
            "id": "10100515",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "明面上…",
            "nextDialogs": [
              "10100516"
            ]
          },
          "10100516": {
            "id": "10100516",
            "speakerId": 10200,
            "speakerName": "「公子」",
            "text": "毕竟还是「道上人士」嘛，这就不能细说了。总之，我带你们来认识钟离，是因为…",
            "nextDialogs": [
              "10100517"
            ]
          },
          "10100517": {
            "id": "10100517",
            "speakerId": 10232,
            "speakerName": "钟离",
            "text": "因为我有办法让你们见到岩王帝君的仙体。",
            "nextDialogs": [
              "10100518"
            ]
          },
          "10100518": {
            "id": "10100518",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "什么？！",
            "nextDialogs": [
              "10100519"
            ]
          },
          "10100519": {
            "id": "10100519",
            "speakerId": 10200,
            "speakerName": "「公子」",
            "text": "哈，不必惊讶，虽然在「天权星」凝光的操纵下，岩神的仙体早已被藏匿起来…但，还是先听听钟离的说法吧。",
            "nextDialogs": [
              "10100520"
            ]
          },
          "10100520": {
            "id": "10100520",
            "speakerId": 10232,
            "speakerName": "钟离",
            "text": "岩王帝君虽是众仙之祖，但说到底也算是仙人之一。纵观璃月数千年的历史，仙人纷纷离去，这是不可挽回的趋势。",
            "nextDialogs": [
              "10100521"
            ]
          },
          "10100521": {
            "id": "10100521",
            "speakerId": 10232,
            "speakerName": "钟离",
            "text": "因为时代变了——你在绝云间，应该也已体会到这种变迁。"
          }
        }
      }
    },
    {
      "subId": "101006",
      "subQuestName": "在门外与钟离对话",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "10100601"
        ],
        "dialogs": {
          "10100601": {
            "id": "10100601",
            "speakerId": 10232,
            "speakerName": "钟离",
            "text": "旅者，经历了「神离开的城邦」以后，你对璃月这「有神之地」，感受如何呢？",
            "nextDialogs": [
              "10100603",
              "10100606"
            ]
          },
          "10100603": {
            "id": "10100603",
            "speakerId": 10232,
            "speakerName": "钟离",
            "text": "原来如此…你是这种类型的游人。那也不错。",
            "nextDialogs": [
              "10100604"
            ]
          },
          "10100604": {
            "id": "10100604",
            "speakerId": 10232,
            "speakerName": "钟离",
            "text": "不过，「有神之地」三千七百年的历史厚度，或许你还没有完全体验到吧。",
            "nextDialogs": [
              "10100607"
            ]
          },
          "10100607": {
            "id": "10100607",
            "speakerId": 10232,
            "speakerName": "钟离",
            "text": "筹办「送仙典仪」的过程，也会成为你旅途的一部分，增广见闻。",
            "nextDialogs": [
              "10100608"
            ]
          },
          "10100608": {
            "id": "10100608",
            "speakerId": 10232,
            "speakerName": "钟离",
            "text": "璃月是尘世七国里最繁荣的一国，往年也有神灵镇守、七星统治。所以「愚人众」的许多外交手段，在璃月都施展不开。",
            "nextDialogs": [
              "10100609"
            ]
          },
          "10100609": {
            "id": "10100609",
            "speakerId": 10232,
            "speakerName": "钟离",
            "text": "七星之一的凝光，始终对愚人众重重防备，或许这就是「公子」想借「往生堂」关系办事的原因吧。",
            "nextDialogs": [
              "10100610"
            ]
          },
          "10100610": {
            "id": "10100610",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "唔…我们要办「送仙典仪」，对「公子」有什么好处呢？",
            "nextDialogs": [
              "10100611"
            ]
          },
          "10100611": {
            "id": "10100611",
            "speakerId": 10232,
            "speakerName": "钟离",
            "text": "我不知道，也不想知道。对我来说，「愚人众」只是提供资金支持，我只希望璃月的传统不要被人遗忘。",
            "nextDialogs": [
              "10100612"
            ]
          },
          "10100612": {
            "id": "10100612",
            "speakerId": 10232,
            "speakerName": "钟离",
            "text": "（钟离交给主角一个钱袋）",
            "nextDialogs": [
              "10100613"
            ]
          },
          "10100613": {
            "id": "10100613",
            "speakerId": 10232,
            "speakerName": "钟离",
            "text": "这是「公子」给的第一笔垫付资金。如果用完，也可以再去找他报销后续款项。",
            "nextDialogs": [
              "10100614"
            ]
          },
          "10100614": {
            "id": "10100614",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "哇哦…",
            "nextDialogs": [
              "10100615"
            ]
          },
          "10100615": {
            "id": "10100615",
            "speakerId": 10232,
            "speakerName": "钟离",
            "text": "好了，我们动身吧。筹备仪式的第一步…是要取得品质足以匹配神灵的，最上等的<color=#00E1FFFF>「夜泊石」</color>。"
          },
          "10100606": {
            "id": "10100606",
            "speakerId": 10232,
            "speakerName": "钟离",
            "text": "嗯，「有神之地」三千七百年的历史厚度，在七国中亦是最深。"
          }
        }
      }
    }
  ]
}
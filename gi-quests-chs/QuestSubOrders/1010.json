    {
      "subId": "101002",
      "subQuestName": "与银行人员对话",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "10100201"
        ],
        "dialogs": {
          "10100201": {
            "id": "10100201",
            "speakerId": 10235,
            "speakerName": "叶卡捷琳娜",
            "text": "#欢迎，「公子」大人的朋友，{NICKNAME}。祝你今后在「愚人众」平步青云。",
            "nextDialogs": [
              "10100204"
            ]
          },
          "10100204": {
            "id": "10100204",
            "speakerId": 10235,
            "speakerName": "叶卡捷琳娜",
            "text": "呵…我们都是凡人，不是「冰之女皇」。凡人的想法就像冰层下的水…是不会永远坚固锐利的。",
            "nextDialogs": [
              "10100205"
            ]
          },
          "10100205": {
            "id": "10100205",
            "speakerId": 10235,
            "speakerName": "叶卡捷琳娜",
            "text": "失礼了，请容我回到正题。「公子」大人说，他与你们的约定已经完成了。",
            "nextDialogs": [
              "10100206"
            ]
          },
          "10100206": {
            "id": "10100206",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "约定完成了？啊，是指他之前说的，要帮我们找人吗？",
            "nextDialogs": [
              "10100207"
            ]
          },
          "10100207": {
            "id": "10100207",
            "speakerId": 10235,
            "speakerName": "叶卡捷琳娜",
            "text": "是的，「公子」大人答应会为你们找到能够突破僵局的人。「愚人众」执行官的承诺从不落空。",
            "nextDialogs": [
              "10100208"
            ]
          },
          "10100208": {
            "id": "10100208",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "那么，他人在哪？",
            "nextDialogs": [
              "10100209"
            ]
          },
          "10100209": {
            "id": "10100209",
            "speakerId": 10235,
            "speakerName": "叶卡捷琳娜",
            "text": "大人在<color=#00E1FFFF>「琉璃亭」</color>。",
            "nextDialogs": [
              "10100210"
            ]
          },
          "10100210": {
            "id": "10100210",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "琉璃亭？",
            "nextDialogs": [
              "10100211"
            ]
          },
          "10100211": {
            "id": "10100211",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "呀，是琉璃亭！我听说过！",
            "nextDialogs": [
              "10100212"
            ]
          },
          "10100212": {
            "id": "10100212",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "璃月的两大菜系，「璃菜」和「月菜」，互相斗争了几百年，不分上下。",
            "nextDialogs": [
              "10100213"
            ]
          },
          "10100213": {
            "id": "10100213",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "「璃菜」的最高代表，就是「琉璃亭」酒家。老板特地把店开在了绯云坡，和代表「月菜」的「新月轩」当面竞争呢！"
          }
        }
      }
    },
    {
      "subId": "101003",
      "subQuestName": "寻找「公子」",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "10100301"
        ],
        "dialogs": {
          "10100301": {
            "id": "10100301",
            "speakerId": 10200,
            "speakerName": "「公子」",
            "text": "哟，你们来了。",
            "nextDialogs": [
              "10100302"
            ]
          },
          "10100302": {
            "id": "10100302",
            "speakerId": 10200,
            "speakerName": "「公子」",
            "text": "约定已经完成了，我找到了能帮助你们的人——能解决「岩神的仙体被七星藏匿」这个难题的人。",
            "nextDialogs": [
              "10100303"
            ]
          },
          "10100303": {
            "id": "10100303",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "那么，这个人又在哪？<color=#00E1FFFF>「琉璃亭」</color>里吗？",
            "nextDialogs": [
              "10100304"
            ]
          },
          "10100304": {
            "id": "10100304",
            "speakerId": 10200,
            "speakerName": "「公子」",
            "text": "没错。跟我来吧。",
            "nextDialogs": [
              "10100305"
            ]
          },
          "10100305": {
            "id": "10100305",
            "speakerId": 10200,
            "speakerName": "「公子」",
            "text": "我准备了一场——嗯，在这个国家，叫做「饭局」的见面仪式。"
          }
        }
      }
    },
    {
      "subId": "101004",
      "subQuestName": "（test）隐藏 钟离登场CS（室外）$HIDDEN",

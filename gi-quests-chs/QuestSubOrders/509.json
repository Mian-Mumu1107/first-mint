  "subQuests": [
    {
      "subId": "50901",
      "subQuestName": "",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "5090101"
        ],
        "dialogs": {
          "5090101": {
            "id": "5090101",
            "speakerId": 1000,
            "speakerName": "离岛港口告示板",
            "text": "此乃幕府所设离岛港口告示板，各种事务，尽皆公示。闲人请勿擅自张贴！"
          }
        }
      }
    },
    {
      "subId": "50902",
      "subQuestName": "",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "5090201"
        ],
        "dialogs": {
          "5090201": {
            "id": "5090201",
            "speakerId": 1001,
            "speakerName": "幕府公告",
            "text": "近日有行踪可疑之外国人士进入稻妻城区，游荡不定，可见动机险恶。",
            "nextDialogs": [
              "5090202"
            ]
          },
          "5090202": {
            "id": "5090202",
            "speakerId": 1001,
            "speakerName": "幕府公告",
            "text": "幕府特此通告：举报可疑人员可得重赏，包庇者必加严惩！",
            "nextDialogs": [
              "5090203"
            ]
          },
          "5090203": {
            "id": "5090203",
            "speakerId": 1001,
            "speakerName": "幕府公告",
            "text": "常道恢弘，鸣神永恒。"
          }
        }
      }
    },
    {
      "subId": "50903",
      "subQuestName": "",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "5090301"
        ],
        "dialogs": {
          "5090301": {
            "id": "5090301",
            "speakerId": 1002,
            "speakerName": "天领公告",
            "text": "「眼狩令」行动已近尾声，但仍有少数私藏「神之眼」者藏匿。",
            "nextDialogs": [
              "5090302"
            ]
          },
          "5090302": {
            "id": "5090302",
            "speakerId": 1002,
            "speakerName": "天领公告",
            "text": "谨遵九条天领奉行孝行大人命令，服从九条裟罗大人指挥，追捕行动将尽可能不使用暴力，不侵扰民众。",
            "nextDialogs": [
              "5090303"
            ]
          },
          "5090303": {
            "id": "5090303",
            "speakerId": 1002,
            "speakerName": "天领公告",
            "text": "请大家放下心来，天领奉行决不以执行公务为借口，侵扰各位正常生活。",
            "nextDialogs": [
              "5090304"
            ]
          },
          "5090304": {
            "id": "5090304",
            "speakerId": 1002,
            "speakerName": "天领公告",
            "text": "以个人与九条家之名誉，九条天领奉行孝行特此向市民保证。"
          }
        }
      }
    },
    {
      "subId": "50904",
      "subQuestName": "",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "5090401"
        ],
        "dialogs": {
          "5090401": {
            "id": "5090401",
            "speakerId": 1003,
            "speakerName": "荒泷相扑鬼王一斗！",
            "text": "「九条天狗！本大爷还在离岛呢！你又跑到哪里啦！！」",
            "nextDialogs": [
              "5090402"
            ]
          },
          "5090402": {
            "id": "5090402",
            "speakerId": 1003,
            "speakerName": "荒泷相扑鬼王一斗！",
            "text": "「一定是听到本大爷的威名，吓得连夜坐船逃跑了吧！」",
            "nextDialogs": [
              "5090403"
            ]
          },
          "5090403": {
            "id": "5090403",
            "speakerId": 1003,
            "speakerName": "荒泷相扑鬼王一斗！",
            "text": "「哈哈，本大爷的威名，比战场还要可怕吗！」",
            "nextDialogs": [
              "5090404"
            ]
          },
          "5090404": {
            "id": "5090404",
            "speakerId": 1003,
            "speakerName": "荒泷相扑鬼王一斗！",
            "text": "「好，那我就在这港口等着你回来！」",
            "nextDialogs": [
              "5090405"
            ]
          },
          "5090405": {
            "id": "5090405",
            "speakerId": 1003,
            "speakerName": "荒泷相扑鬼王一斗！",
            "text": "「天狗你也别轻易死在战场上！回来决斗呀！！」",
            "nextDialogs": [
              "5090406"
            ]
          },
          "5090406": {
            "id": "5090406",
            "speakerId": 1004,
            "speakerName": "回复",
            "text": "吵死了，你还有完没完。",
            "nextDialogs": [
              "5090407"
            ]
          },
          "5090407": {
            "id": "5090407",
            "speakerId": 1004,
            "speakerName": "回复",
            "text": "如果说这能算什么战前祝福的话，我便领了你的心意。",
            "nextDialogs": [
              "5090408"
            ]
          },
          "5090408": {
            "id": "5090408",
            "speakerId": 1004,
            "speakerName": "回复",
            "text": "顺便，你也别把自己搞死了，蠢货赤鬼。"
          }
        }
      }
    },
    {
      "subId": "50905",
      "subQuestName": "",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "5090501"
        ],
        "dialogs": {
          "5090501": {
            "id": "5090501",
            "speakerId": 1005,
            "speakerName": "八重堂的平冢",
            "text": "「虽然不是什么大事，但希望这件事能够周知。」",
            "nextDialogs": [
              "5090502"
            ]
          },
          "5090502": {
            "id": "5090502",
            "speakerId": 1005,
            "speakerName": "八重堂的平冢",
            "text": "「泷泽京传先生那本著名的《鹮巷物语》孤本最近被我不慎搞丢了。」",
            "nextDialogs": [
              "5090503"
            ]
          },
          "5090503": {
            "id": "5090503",
            "speakerId": 1005,
            "speakerName": "八重堂的平冢",
            "text": "「虽然不是什么大事，但八重大人非要让我到处刊出寻书启示，真是伤脑筋。」",
            "nextDialogs": [
              "5090504"
            ]
          },
          "5090504": {
            "id": "5090504",
            "speakerId": 1005,
            "speakerName": "八重堂的平冢",
            "text": "「想想那本书也真是可怜，也许飞散得到处都是了吧…想要找到不太可能了。」",
            "nextDialogs": [
              "5090505"
            ]
          },
          "5090505": {
            "id": "5090505",
            "speakerId": 1005,
            "speakerName": "八重堂的平冢",
            "text": "「虽然不是什么大事，但假如有人能够帮忙找全该书，八重堂将会十分感谢。」"
          }
        }
      }
    },
    {
      "subId": "50906",
      "subQuestName": "",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "5090601"
        ],
        "dialogs": {
          "5090601": {
            "id": "5090601",
            "speakerId": 1006,
            "speakerName": "勘定公告",
            "text": "「锁国令」期间进入离岛的外国人请出示随身勘合证件，无法出示有效证件者禁止登岸。",
            "nextDialogs": [
              "5090602"
            ]
          },
          "5090602": {
            "id": "5090602",
            "speakerId": 1006,
            "speakerName": "勘定公告",
            "text": "进入离岛请勿携带违禁物品，随身武器、露营工具、外国特产等请登记缴税。",
            "nextDialogs": [
              "5090603"
            ]
          },
          "5090603": {
            "id": "5090603",
            "speakerId": 1006,
            "speakerName": "勘定公告",
            "text": "勘合证件及个人证件请妥善保存，遗失不补！",
            "nextDialogs": [
              "5090604"
            ]
          },
          "5090604": {
            "id": "5090604",
            "speakerId": 1006,
            "speakerName": "勘定公告",
            "text": "一年内与珊瑚宫方面有交往者，须在离岛停留观察一年，不可擅自离开。"
          }
        }
      }
    },
    {
      "subId": "50907",
      "subQuestName": "",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "5090701"
        ],
        "dialogs": {
          "5090701": {
            "id": "5090701",
            "speakerId": 1007,
            "speakerName": "「万国商会」公告",
            "text": "「诸位外国行商游客人等，在离岛若是遭遇问题或困难」",
            "nextDialogs": [
              "5090702"
            ]
          },
          "5090702": {
            "id": "5090702",
            "speakerId": 1007,
            "speakerName": "「万国商会」公告",
            "text": "「还请来万国商会找久利须先生，必定尽力相助！」",
            "nextDialogs": [
              "5090703"
            ]
          },
          "5090703": {
            "id": "5090703",
            "speakerId": 1007,
            "speakerName": "「万国商会」公告",
            "text": "「若有什么不懂的事、烦恼的事，也可尽管来一叙。」",
            "nextDialogs": [
              "5090704"
            ]
          },
          "5090704": {
            "id": "5090704",
            "speakerId": 1007,
            "speakerName": "「万国商会」公告",
            "text": "「万国商会的大门永远为各国旅者敞开。」"
          }
        }
      }
    },
    {
      "subId": "50908",
      "subQuestName": "",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "5090801"
        ],
        "dialogs": {
          "5090801": {
            "id": "5090801",
            "speakerId": 1008,
            "speakerName": "留言",
            "text": "「近来海贼活动越来越猖獗了，听说战争中两方的一些逃兵也做了流寇…」",
            "nextDialogs": [
              "5090802"
            ]
          },
          "5090802": {
            "id": "5090802",
            "speakerId": 1008,
            "speakerName": "留言",
            "text": "「尤其因为外国商船不受幕府保护，更容易遭到他们的袭击，真可恶…」",
            "nextDialogs": [
              "5090803"
            ]
          },
          "5090803": {
            "id": "5090803",
            "speakerId": 1008,
            "speakerName": "留言",
            "text": "「看到这条留言的船师朋友，在从离岛出航时一定要多备齐物资。」",
            "nextDialogs": [
              "5090804"
            ]
          },
          "5090804": {
            "id": "5090804",
            "speakerId": 1008,
            "speakerName": "留言",
            "text": "「武器、淡水、维修工具、备用材料，这方面的采购请不要太过节省。」"
          }
        }
      }
    },
    {
      "subId": "50909",
      "subQuestName": "",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "5090901"
        ],
        "dialogs": {
          "5090901": {
            "id": "5090901",
            "speakerId": 1008,
            "speakerName": "留言",
            "text": "「听说最近从璃月方向来了一队大船，也不知道他们停泊何处。」",
            "nextDialogs": [
              "5090902"
            ]
          },
          "5090902": {
            "id": "5090902",
            "speakerId": 1008,
            "speakerName": "留言",
            "text": "「旗舰的尺寸格外宏大，外国船舰只要跟随它的桅杆与船队同航，就不必担心海贼侵扰…」",
            "nextDialogs": [
              "5090903"
            ]
          },
          "5090903": {
            "id": "5090903",
            "speakerId": 1008,
            "speakerName": "留言",
            "text": "「可惜我也只是听闻有这回事，从未目睹过那支船队。」",
            "nextDialogs": [
              "5090904"
            ]
          },
          "5090904": {
            "id": "5090904",
            "speakerId": 1008,
            "speakerName": "留言",
            "text": "「不过听他们说，那就是传闻中大名鼎鼎的『南十字船队』。」",
            "nextDialogs": [
              "5090905"
            ]
          },
          "5090905": {
            "id": "5090905",
            "speakerId": 1008,
            "speakerName": "留言",
            "text": "「想想还是有点难以置信，『锁国令』期间也没什么生意，他们来这里干什么？」"
          }
        }
      }
    },
    {
      "subId": "50910",
      "subQuestName": "",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "5091001"
        ],
        "dialogs": {
          "5091001": {
            "id": "5091001",
            "speakerId": 1006,
            "speakerName": "勘定公告",
            "text": "近期可能增加一班自至冬国往离岛的运货商船，请港口诸位早做准备！",
            "nextDialogs": [
              "5091002"
            ]
          },
          "5091002": {
            "id": "5091002",
            "speakerId": 1006,
            "speakerName": "勘定公告",
            "text": "作为配套措施，自至冬国来的商人可先行享受部分关税减免优惠。",
            "nextDialogs": [
              "5091003"
            ]
          },
          "5091003": {
            "id": "5091003",
            "speakerId": 1006,
            "speakerName": "勘定公告",
            "text": "已留居离岛的至冬国商人也请尽快前往勘定奉行府更新勘合证件，",
            "nextDialogs": [
              "5091004"
            ]
          },
          "5091004": {
            "id": "5091004",
            "speakerId": 1006,
            "speakerName": "勘定公告",
            "text": "以免造成居住生活、出行经商等方面的不便。"
          }
        }
      }
    },
    {
      "subId": "50911",
      "subQuestName": "",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "5091101"
        ],
        "dialogs": {
          "5091101": {
            "id": "5091101",
            "speakerId": 1008,
            "speakerName": "留言",
            "text": "「此身恰如秋叶，浮流远山海。」",
            "nextDialogs": [
              "5091102"
            ]
          },
          "5091102": {
            "id": "5091102",
            "speakerId": 1009,
            "speakerName": "另一条留言",
            "text": "「我们又回来了！小子，再来句诗！」",
            "nextDialogs": [
              "5091103"
            ]
          },
          "5091103": {
            "id": "5091103",
            "speakerId": 1004,
            "speakerName": "回复",
            "text": "这是公告板，不是和歌会！"
          }
        }
      }
    },
    {
      "subId": "50912",
      "subQuestName": "",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "5091201"
        ],
        "dialogs": {
          "5091201": {
            "id": "5091201",
            "speakerId": 1008,
            "speakerName": "留言",
            "text": "「离岛的港口过于防备外国人，对于稻妻本土却疏于防备。」",
            "nextDialogs": [
              "5091202"
            ]
          },
          "5091202": {
            "id": "5091202",
            "speakerId": 1008,
            "speakerName": "留言",
            "text": "「因此只要伪造一份稻妻本土的文件，便能够自由出入幕府治下领地…」",
            "nextDialogs": [
              "5091203"
            ]
          },
          "5091203": {
            "id": "5091203",
            "speakerId": 1008,
            "speakerName": "留言",
            "text": "「而这绝非难事。」",
            "nextDialogs": [
              "5091204"
            ]
          },
          "5091204": {
            "id": "5091204",
            "speakerId": 1004,
            "speakerName": "回复",
            "text": "到底是怎样糊涂的家伙才会把这种情报写在公告板上…"
          }
        }
      }
    },
    {
      "subId": "50913",
      "subQuestName": "",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "5091301"
        ],
        "dialogs": {
          "5091301": {
            "id": "5091301",
            "speakerId": 1010,
            "speakerName": "通缉令",
            "text": "悬赏：吉野小平次、吉野小平太。",
            "nextDialogs": [
              "5091302"
            ]
          },
          "5091302": {
            "id": "5091302",
            "speakerId": 1010,
            "speakerName": "通缉令",
            "text": "罪名：逐电；劫盗；夜讨；谋害长官；向无辜村民散发财物，企图谋反。",
            "nextDialogs": [
              "5091303"
            ]
          },
          "5091303": {
            "id": "5091303",
            "speakerId": 1010,
            "speakerName": "通缉令",
            "text": "此二人活捉或正法，皆有重赏！"
          }
        }
      }
    },
    {
      "subId": "50914",
      "subQuestName": "",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "5091401"
        ],
        "dialogs": {
          "5091401": {
            "id": "5091401",
            "speakerId": 1010,
            "speakerName": "通缉令",
            "text": "悬赏：绿川四郎",
            "nextDialogs": [
              "5091402"
            ]
          },
          "5091402": {
            "id": "5091402",
            "speakerId": 1010,
            "speakerName": "通缉令",
            "text": "罪名：逐电；啸聚；海贼；抢劫官员；伏狩武士；诱拐老母为质，妄图对抗官府。",
            "nextDialogs": [
              "5091403"
            ]
          },
          "5091403": {
            "id": "5091403",
            "speakerId": 1010,
            "speakerName": "通缉令",
            "text": "此人及其党羽，活捉或正法，皆有重赏！"
          }
        }
      }
    },
    {
      "subId": "50915",
      "subQuestName": "",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "5091501"
        ],
        "dialogs": {
          "5091501": {
            "id": "5091501",
            "speakerId": 1008,
            "speakerName": "留言",
            "text": "「清子，我喜欢你。」",
            "nextDialogs": [
              "5091502"
            ]
          },
          "5091502": {
            "id": "5091502",
            "speakerId": 1008,
            "speakerName": "留言",
            "text": "「虽然我是外国人，刚刚来到这片土地，什么也不懂。但是没关系的。」",
            "nextDialogs": [
              "5091503"
            ]
          },
          "5091503": {
            "id": "5091503",
            "speakerId": 1008,
            "speakerName": "留言",
            "text": "「这里的役人只要收了摩拉就什么也不会管，我们想在哪里约会都可以。」",
            "nextDialogs": [
              "5091504"
            ]
          },
          "5091504": {
            "id": "5091504",
            "speakerId": 1008,
            "speakerName": "留言",
            "text": "「而且我不缺摩拉…」",
            "nextDialogs": [
              "5091505"
            ]
          },
          "5091505": {
            "id": "5091505",
            "speakerId": 1008,
            "speakerName": "留言",
            "text": "「准确来说，是我爸爸啦，哈哈。」"
          }
        }
      }
    },
    {
      "subId": "50916",
      "subQuestName": "",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "5091601"
        ],
        "dialogs": {
          "5091601": {
            "id": "5091601",
            "speakerId": 1011,
            "speakerName": "鸣神大社公告",
            "text": "经宫司八重神子大人许可，鸣神大社将向受战争影响之贫困商户、困难家庭发放无息扶助贷款、慰问粮等补助福利。",
            "nextDialogs": [
              "5091602"
            ]
          },
          "5091602": {
            "id": "5091602",
            "speakerId": 1011,
            "speakerName": "鸣神大社公告",
            "text": "请有需要者携带齐全证件诣神里家府上办理相关手续，必将周到招待。",
            "nextDialogs": [
              "5091603"
            ]
          },
          "5091603": {
            "id": "5091603",
            "speakerId": 1011,
            "speakerName": "鸣神大社公告",
            "text": "（外国人如能出示合法勘合证件，亦可领取限额补助。）",
            "nextDialogs": [
              "5091604"
            ]
          },
          "5091604": {
            "id": "5091604",
            "speakerId": 1011,
            "speakerName": "鸣神大社公告",
            "text": "由于战事绵延，公帑稍紧，近日慰问粮补助限额降低至二分之一，敬请见谅。",
            "nextDialogs": [
              "5091605"
            ]
          },
          "5091605": {
            "id": "5091605",
            "speakerId": 1008,
            "speakerName": "留言",
            "text": "「我到了神里家的府邸，可是吃了个闭门羹，哪有什么救济？」",
            "nextDialogs": [
              "5091606"
            ]
          },
          "5091606": {
            "id": "5091606",
            "speakerId": 1008,
            "speakerName": "留言",
            "text": "「身边的客商也很少有领到福利的…真是奇怪。」",
            "nextDialogs": [
              "5091607"
            ]
          },
          "5091607": {
            "id": "5091607",
            "speakerId": 1011,
            "speakerName": "鸣神大社公告",
            "text": "十分遗憾，可能是您稍迟了片刻，当日的补助发放完毕便不会再登记接待新来者了。",
            "nextDialogs": [
              "5091608"
            ]
          },
          "5091608": {
            "id": "5091608",
            "speakerId": 1008,
            "speakerName": "留言",
            "text": "「难怪大家早上起得都那么早…」"
          }
        }
      }
    },
    {
      "subId": "50917",
      "subQuestName": "",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "5091701"
        ],
        "dialogs": {
          "5091701": {
            "id": "5091701",
            "speakerId": 1006,
            "speakerName": "勘定公告",
            "text": "近来由于战争影响，为了避免挤占军用临时港口，外国商船停泊费暂时上调至四倍。",
            "nextDialogs": [
              "5091702"
            ]
          },
          "5091702": {
            "id": "5091702",
            "speakerId": 1006,
            "speakerName": "勘定公告",
            "text": "诸位若有意见请至勘定奉行府上报告。",
            "nextDialogs": [
              "5091703"
            ]
          },
          "5091703": {
            "id": "5091703",
            "speakerId": 1006,
            "speakerName": "勘定公告",
            "text": "商船停泊费照常由「万国商会」统一登记收集上交，不得遗漏。",
            "nextDialogs": [
              "5091704"
            ]
          },
          "5091704": {
            "id": "5091704",
            "speakerId": 1008,
            "speakerName": "留言",
            "text": "「什么『挤占军用港口』，明明是当兵的在挤占商港吧！结果还要我们来负担费用…」",
            "nextDialogs": [
              "5091705"
            ]
          },
          "5091705": {
            "id": "5091705",
            "speakerId": 1004,
            "speakerName": "回复",
            "text": "实在不好意思，但出港是免费的。"
          }
        }
      }
    }
  ]
}
    {
      "subId": "2002104",
      "subQuestName": "与安娜对话",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "200211401"
        ],
        "dialogs": {
          "200211401": {
            "id": "200211401",
            "speakerId": 1405,
            "speakerName": "安娜",
            "text": "你操纵风之翼的手法可真是太厉害了，怪不得安柏小姐要我来请教你呢。",
            "nextDialogs": [
              "200211402"
            ]
          },
          "200211402": {
            "id": "200211402",
            "speakerId": 1405,
            "speakerName": "安娜",
            "text": "嘿嘿，有你给我辅导，我肯定能通过飞行执照的考试。",
            "nextDialogs": [
              "200211403"
            ]
          },
          "200211403": {
            "id": "200211403",
            "speakerId": 1405,
            "speakerName": "安娜",
            "text": "谢谢你啦，这些东西请你收下，我先回去复习了。",
            "nextDialogs": [
              "200211404"
            ]
          },
          "200211404": {
            "id": "200211404",
            "speakerId": 1405,
            "speakerName": "安娜",
            "text": "唔…我的风之翼用什么颜色比较好呢…",
            "nextDialogs": [
              "200211405"
            ]
          },
          "200211405": {
            "id": "200211405",
            "speakerId": 1405,
            "speakerName": "安娜",
            "text": "蓝色？绿色？不然都要一点好了…"
          }
        }
      }
    },
    {
      "subId": "2002105",
      "subQuestName": "",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "200210501"
        ],
        "dialogs": {

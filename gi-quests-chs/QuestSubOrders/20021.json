            ]
          },
          "200211302": {
            "id": "200211302",
            "speakerId": 1405,
            "speakerName": "安娜",
            "text": "旅行者，能请你为我演示一下风之翼的操纵方式吗？",
            "nextDialogs": [
              "200211305"
            ]
          },
          "200211305": {
            "id": "200211305",
            "speakerId": 1405,
            "speakerName": "安娜",
            "text": "那就拜托你啦，我们赶紧出发吧！"
          }
        }
      }
    },
    {

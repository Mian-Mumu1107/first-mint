  "subQuests": [
    {
      "subId": "35601",
      "subQuestName": "与安柏对话",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "3560101"
        ],
        "dialogs": {
          "3560101": {
            "id": "3560101",
            "speakerId": 1000,
            "speakerName": "安柏",
            "text": "容我正式介绍，风与蒲公英的牧歌之城，自由之都——",
            "nextDialogs": [
              "3560102"
            ]
          },
          "3560102": {
            "id": "3560102",
            "speakerId": 1000,
            "speakerName": "安柏",
            "text": "受西风骑士团庇护的旅人们，欢迎来到蒙德城！",
            "nextDialogs": [
              "3560103"
            ]
          },
          "3560103": {
            "id": "3560103",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "终于不用在荒野露宿啦。",
            "nextDialogs": [
              "3560104"
            ]
          },
          "3560104": {
            "id": "3560104",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "不过城里的大家…精神都不太好的样子。",
            "nextDialogs": [
              "3560105"
            ]
          },
          "3560105": {
            "id": "3560105",
            "speakerId": 1000,
            "speakerName": "安柏",
            "text": "因为最近全城都在烦恼风魔龙的事吧。",
            "nextDialogs": [
              "3560106"
            ]
          },
          "3560106": {
            "id": "3560106",
            "speakerId": 1000,
            "speakerName": "安柏",
            "text": "但有琴在的话，一切都不会有问题的！",
            "nextDialogs": [
              "3560107"
            ]
          },
          "3560107": {
            "id": "3560107",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "琴？",
            "nextDialogs": [
              "3560108"
            ]
          },
          "3560108": {
            "id": "3560108",
            "speakerId": 1000,
            "speakerName": "安柏",
            "text": "西风骑士团代理团长——琴。蒙德的守护者。",
            "nextDialogs": [
              "3560109"
            ]
          },
          "3560109": {
            "id": "3560109",
            "speakerId": 1000,
            "speakerName": "安柏",
            "text": "与琴同在的我们，即使是风魔龙这种级别的灾害，也一定能够战胜的。",
            "nextDialogs": [
              "3560112"
            ]
          },
          "3560112": {
            "id": "3560112",
            "speakerId": 1000,
            "speakerName": "安柏",
            "text": "#对了，在一起去骑士团总部之前，我有礼物要送给{NICKNAME}。",
            "nextDialogs": [
              "3560113"
            ]
          },
          "3560113": {
            "id": "3560113",
            "speakerId": 1000,
            "speakerName": "安柏",
            "text": "是刚才帮我清理丘丘人营地的酬谢喔。",
            "nextDialogs": [
              "3560114"
            ]
          },
          "3560114": {
            "id": "3560114",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "见，见者有份！为什么我没有礼物？",
            "nextDialogs": [
              "3560115"
            ]
          },
          "3560115": {
            "id": "3560115",
            "speakerId": 1000,
            "speakerName": "安柏",
            "text": "嗯…因为那是小派蒙没法用的东西吧。",
            "nextDialogs": [
              "3560116"
            ]
          },
          "3560116": {
            "id": "3560116",
            "speakerId": 1000,
            "speakerName": "安柏",
            "text": "但我今晚会请你吃蒙德特色的蜜酱胡萝卜煎肉。",
            "nextDialogs": [
              "3560117"
            ]
          },
          "3560117": {
            "id": "3560117",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "蜜酱胡萝卜煎肉！",
            "nextDialogs": [
              "3560118"
            ]
          },
          "3560118": {
            "id": "3560118",
            "speakerId": 1000,
            "speakerName": "安柏",
            "text": "现在就先跟我来吧，我们要去城区的…<color=#00E1FFFF>高处</color>。"
          }
        }
      }
    },
    {

      }
    },
    {
      "subId": "35604",
      "subQuestName": "与安柏对话",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "3560401"
        ],
        "dialogs": {
          "3560401": {
            "id": "3560401",
            "speakerId": 1000,
            "speakerName": "安柏",
            "text": "那么，说好的礼物就是——",
            "nextDialogs": [
              "3560402"
            ]
          },
          "3560402": {
            "id": "3560402",
            "speakerId": 1000,
            "speakerName": "安柏",
            "text": "<color=#00E1FFFF>风之翼</color>！",
            "nextDialogs": [
              "3560403"
            ]
          },
          "3560403": {
            "id": "3560403",
            "speakerId": 1000,
            "speakerName": "安柏",
            "text": "侦察骑士靠它在天空中行动，蒙德的市民们也很喜欢用。",
            "nextDialogs": [
              "3560404"
            ]
          },
          "3560404": {
            "id": "3560404",
            "speakerId": 1000,
            "speakerName": "安柏",
            "text": "我特地把你叫到这里来，就是为了让你第一时间感受到它的好处！",
            "nextDialogs": [
              "3560405"
            ]
          },
          "3560405": {
            "id": "3560405",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "是正在热心推荐的语气呢。",
            "nextDialogs": [
              "3560406"
            ]
          },
          "3560406": {
            "id": "3560406",
            "speakerId": 1000,
            "speakerName": "安柏",
            "text": "因为「风」是蒙德的灵魂嘛。",
            "nextDialogs": [
              "3560407"
            ]
          },
          "3560407": {
            "id": "3560407",
            "speakerId": 1000,
            "speakerName": "安柏",
            "text": "好了，赶快来试试风之翼的性能吧。",
            "nextDialogs": [
              "3560408"
            ]
          },
          "3560408": {
            "id": "3560408",
            "speakerId": 1000,
            "speakerName": "安柏",
            "text": "虽然操作起来很简单，但你一定要听我指示。"
          }
        }
      }
    },

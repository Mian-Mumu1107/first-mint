            "speakerName": "「御签挂」",
            "text": "（如果抽到了「凶」和「大凶」，结在这里就可以逢凶化吉。）",
            "nextDialogs": [
              "721031002"
            ]
          },
          "721031002": {
            "id": "721031002",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "挂起来吧。"
          }
        }
      }
    },

    {
      "subId": "7210337",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "721033701"
        ],
        "dialogs": {
          "721033701": {
            "id": "721033701",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "「胧夜正中」。",
            "nextDialogs": [
              "721033702"
            ]
          },
          "721033702": {
            "id": "721033702",
            "speakerId": 20223,
            "speakerName": "「玄冬林檎」",
            "text": "啊…不好意思，目前暂时没有「这种东西」。",
            "nextDialogs": [
              "721033703"
            ]
          },
          "721033703": {
            "id": "721033703",
            "speakerId": 20223,
            "speakerName": "「玄冬林檎」",
            "text": "您真是相当可靠呢。如果愚…",
            "nextDialogs": [
              "721033704"
            ]
          },
          "721033704": {
            "id": "721033704",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "愚人众？",
            "nextDialogs": [
              "721033705"
            ]
          },
          "721033705": {
            "id": "721033705",
            "speakerId": 20223,
            "speakerName": "「玄冬林檎」",
            "text": "愚…我、我是说，「愚拙如我玄冬林檎，也有幸能亲眼目睹您战斗的英姿，那就再好不过了」！",
            "nextDialogs": [
              "721033706"
            ]
          },
          "721033706": {
            "id": "721033706",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "…会有机会的。"
          }
        }
      }
    },
    {
      "subId": "7210338",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "721033801"
        ],
        "dialogs": {
          "721033801": {
            "id": "721033801",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "关于这种纸片儿…",
            "nextDialogs": [
              "721033802"
            ]
          },
          "721033802": {
            "id": "721033802",
            "speakerId": 20223,
            "speakerName": "「玄冬林檎」",
            "text": "啊，您是说「御神签」吧？求签的流程是这样的。",
            "nextDialogs": [
              "721033803"
            ]
          },
          "721033803": {
            "id": "721033803",
            "speakerId": 20223,
            "speakerName": "「玄冬林檎」",
            "text": "首先需要由您用力摇晃「御神签箱」，取出一根竹签。然后，需要麻烦您将竹签交给我，我会将其换成对应的「御神签」。",
            "nextDialogs": [
              "721033804"
            ]
          },
          "721033804": {
            "id": "721033804",
            "speakerId": 20223,
            "speakerName": "「玄冬林檎」",
            "text": "如果是「凶签」的话，可以将其结在「御签挂」上逢凶化吉喔。大致就是这样一回事。",
            "nextDialogs": [
              "721033805"
            ]
          },
          "721033805": {
            "id": "721033805",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "玄冬小姐懂得真多。",
            "nextDialogs": [
              "721033806"
            ]
          },
          "721033806": {
            "id": "721033806",
            "speakerId": 20223,
            "speakerName": "「玄冬林檎」",
            "text": "哪、哪有，这毕竟是…是巫女的基本素养嘛！"
          }
        }
      }
    },
    {
      "subId": "7210339",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "721033901"
        ],
        "dialogs": {
          "721033901": {
            "id": "721033901",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "交出「特制的竹签」。",
            "nextDialogs": [
              "721033902"
            ]
          },
          "721033902": {
            "id": "721033902",
            "speakerId": 20223,
            "speakerName": "「玄冬林檎」",
            "text": "好的，请将竹签交给我吧。奇怪，总觉得刚才好像没有看到您摇晃签筒…",
            "nextDialogs": [
              "721033903"
            ]
          },
          "721033903": {
            "id": "721033903",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "是你的错觉。",
            "nextDialogs": [
              "721033904"
            ]
          },
          "721033904": {
            "id": "721033904",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "对呀，因为玄冬小姐一副心不在焉的样子。",
            "nextDialogs": [
              "721033905"
            ]
          },
          "721033905": {
            "id": "721033905",
            "speakerId": 20223,
            "speakerName": "「玄冬林檎」",
            "text": "心、心不在焉？！啊…没有的事，大概只是因为昨天没有睡好的关系，让您担心了！",
            "nextDialogs": [
              "721033906"
            ]
          },
          "721033906": {
            "id": "721033906",
            "speakerId": 20223,
            "speakerName": "「玄冬林檎」",
            "text": "这是您的御神签，请您收好。",
            "nextDialogs": [
              "721033907"
            ]
          },
          "721033907": {
            "id": "721033907",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "（怎么样怎么样？刚才粉末应该已经粘在她身上了吧。）",
            "nextDialogs": [
              "721033908"
            ]
          },
          "721033908": {
            "id": "721033908",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "（嗯，没问题。）",
            "nextDialogs": [
              "721033909"
            ]
          },
          "721033909": {
            "id": "721033909",
            "speakerId": 20223,
            "speakerName": "「玄冬林檎」",
            "text": "咦，你们两位为什么一脸凝重地站在这里？难道是抽到凶签了吗？",
            "nextDialogs": [
              "721033910"
            ]
          },
          "721033910": {
            "id": "721033910",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "不，是「末吉」。",
            "nextDialogs": [
              "721033911"
            ]
          },
          "721033911": {
            "id": "721033911",
            "speakerId": 20223,
            "speakerName": "「玄冬林檎」",
            "text": "请不要灰心，「末吉」其实也是不错的运势哦。也许会经历一些坎坷，但最终一定会迎来美满的结局。",
            "nextDialogs": [
              "721033912"
            ]
          },
          "721033912": {
            "id": "721033912",
            "speakerId": 20223,
            "speakerName": "「玄冬林檎」",
            "text": "尤其是对于您这样善良的人，一定会灵验的。至少，我是这样相信的。"
          }
        }
      }
    },
    {
      "subId": "7210340",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "721034001"
        ],
        "dialogs": {
          "721034001": {
            "id": "721034001",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "最近怎么样？",
            "nextDialogs": [
              "721034002"
            ]
          },
          "721034002": {
            "id": "721034002",
            "speakerId": 20223,
            "speakerName": "「玄冬林檎」",
            "text": "谢谢您的关心，我最近感觉很不错！我能够成为真正的巫女，离不开您和其他许多人的帮助。",
            "nextDialogs": [
              "721034003"
            ]
          },
          "721034003": {
            "id": "721034003",
            "speakerId": 20223,
            "speakerName": "「玄冬林檎」",
            "text": "我会在这里虔诚地为诸位祈祷。如果您有什么烦恼的话，我也很乐意倾听哦。",
            "nextDialogs": [
              "721034004"
            ]
          },
          "721034004": {
            "id": "721034004",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "有百代小姐的消息吗？",
            "nextDialogs": [
              "721034005"
            ]
          },
          "721034005": {
            "id": "721034005",
            "speakerId": 20223,
            "speakerName": "「玄冬林檎」",
            "text": "很遗憾，我回到这里的时候，百代小姐已经走了，我至今没能当面向她道谢。",
            "nextDialogs": [
              "721034006"
            ]
          },
          "721034006": {
            "id": "721034006",
            "speakerId": 20223,
            "speakerName": "「玄冬林檎」",
            "text": "但我想，未来我一定能和她再见的。"
          }
        }
      }
    },

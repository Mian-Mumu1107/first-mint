    {
      "subId": "7210335",
      "subQuestName": "（test）判定小黑屋完成$HIDDEN",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "721033501"
        ],
        "dialogs": {
          "721033501": {
            "id": "721033501",
            "speakerId": 15465,
            "speakerName": "玄冬林檎",
            "text": "你要求签？",
            "nextDialogs": [
              "721033502"
            ]
          },
          "721033502": {
            "id": "721033502",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "呜哇，好冷淡。",
            "nextDialogs": [
              "721033503"
            ]
          },
          "721033503": {
            "id": "721033503",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "我想求签…",
            "nextDialogs": [
              "721033504"
            ]
          },
          "721033504": {
            "id": "721033504",
            "speakerId": 15465,
            "speakerName": "玄冬林檎",
            "text": "明白了。流程是这样的。首先请你用力摇晃这个什么东西。",
            "nextDialogs": [
              "721033505"
            ]
          },
          "721033505": {
            "id": "721033505",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "记得是叫「御神签箱」…",
            "nextDialogs": [
              "721033506"
            ]
          },
          "721033506": {
            "id": "721033506",
            "speakerId": 15465,
            "speakerName": "玄冬林檎",
            "text": "没错。从里面会掉出一根竹签。把这根竹签给我，我会给你对应的纸片儿。",
            "nextDialogs": [
              "721033507"
            ]
          },
          "721033507": {
            "id": "721033507",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "好像叫「御神签」来着…",
            "nextDialogs": [
              "721033508"
            ]
          },
          "721033508": {
            "id": "721033508",
            "speakerId": 15465,
            "speakerName": "玄冬林檎",
            "text": "这种事情怎样都好吧。",
            "nextDialogs": [
              "721033509"
            ]
          },
          "721033509": {
            "id": "721033509",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "我有问题！如果说，如果说我们抽到了凶签，要怎么办呢？",
            "nextDialogs": [
              "721033510"
            ]
          },
          "721033510": {
            "id": "721033510",
            "speakerId": 15465,
            "speakerName": "玄冬林檎",
            "text": "是命运让你抽到凶签，你还想怎样？啊？",
            "nextDialogs": [
              "721033511"
            ]
          },
          "721033511": {
            "id": "721033511",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "欸！",
            "nextDialogs": [
              "721033512"
            ]
          },
          "721033512": {
            "id": "721033512",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "外头那个像架子的东西…",
            "nextDialogs": [
              "721033513"
            ]
          },
          "721033513": {
            "id": "721033513",
            "speakerId": 15465,
            "speakerName": "玄冬林檎",
            "text": "啧。",
            "nextDialogs": [
              "721033514"
            ]
          },
          "721033514": {
            "id": "721033514",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "她很露骨地「啧」了耶！",
            "nextDialogs": [
              "721033515"
            ]
          },
          "721033515": {
            "id": "721033515",
            "speakerId": 15465,
            "speakerName": "玄冬林檎",
            "text": "我看看…是这样的。「把凶签捆到『御签挂』上，就可以逢凶化吉」。",
            "nextDialogs": [
              "721033516"
            ]
          },
          "721033516": {
            "id": "721033516",
            "speakerId": 15465,
            "speakerName": "玄冬林檎",
            "text": "啊，对哦！如果你抽到凶签，把它捆到那个架子上就行了嘛。",
            "nextDialogs": [
              "721033517"
            ]
          },
          "721033517": {
            "id": "721033517",
            "speakerId": 15465,
            "speakerName": "玄冬林檎",
            "text": "他们还真是…不对，我们「鸣神大社」很温柔的。所以就算抽到了凶签，也会给你们转运的机会。",
            "nextDialogs": [
              "721033518"
            ]
          },
          "721033518": {
            "id": "721033518",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "虽然感觉哪里好像怪怪的…",
            "nextDialogs": [
              "721033519"
            ]
          },
          "721033519": {
            "id": "721033519",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "#{NICKNAME}，我们求签吧！"
          }
        }
      }
    },
    {
      "subId": "7210336",
      "subQuestName": "(test)首次遇到假扮巫女$HIDDEN",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "721033601"
        ],
        "dialogs": {
          "721033601": {
            "id": "721033601",
            "speakerId": 15465,
            "speakerName": "玄冬林檎",
            "text": "把竹签交出来。",
            "nextDialogs": [
              "721033602"
            ]
          },
          "721033602": {
            "id": "721033602",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "好、好的。",
            "nextDialogs": [
              "721033603"
            ]
          },
          "721033603": {
            "id": "721033603",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "神社真是个不讲情面的地方…",
            "nextDialogs": [
              "721033604"
            ]
          },
          "721033604": {
            "id": "721033604",
            "speakerId": 15465,
            "speakerName": "玄冬林檎",
            "text": "给你。",
            "nextDialogs": [
              "721033605"
            ]
          },
          "721033605": {
            "id": "721033605",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "唔呣，看看运势吧。",
            "nextDialogs": [
              "721033606"
            ]
          },
          "721033606": {
            "id": "721033606",
            "speakerId": 15465,
            "speakerName": "玄冬林檎",
            "text": "对了。每天只能求一次签，这点请你记住。",
            "nextDialogs": [
              "721033607"
            ]
          },
          "721033607": {
            "id": "721033607",
            "speakerId": 15465,
            "speakerName": "玄冬林檎",
            "text": "不然我会很累…不对，不然御签挂会挂不下…也不是，应该怎么说来着？",
            "nextDialogs": [
              "721033608"
            ]
          },
          "721033608": {
            "id": "721033608",
            "speakerId": 15465,
            "speakerName": "玄冬林檎",
            "text": "「御神签是神明意志的体现。所以要尊重神明的意志，并且尽人所能及之力。」",
            "nextDialogs": [
              "721033609"
            ]
          },
          "721033609": {
            "id": "721033609",
            "speakerId": 15465,
            "speakerName": "玄冬林檎",
            "text": "你看，写得真好。所以每天只能求一次签，记好了。"
          }
        }
      }
    },
    {
      "subId": "7210315",
      "subQuestName": "(test)假扮巫女首次对话$HIDDEN",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "721031901"
        ],
        "dialogs": {
          "721031901": {
            "id": "721031901",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "#（喂，{NICKNAME}！）",
            "nextDialogs": [
              "721031902"
            ]
          },
          "721031902": {
            "id": "721031902",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "（这个玄冬小姐，按照那个玄冬小姐说的…）",
            "nextDialogs": [
              "721031903"
            ]
          },
          "721031903": {
            "id": "721031903",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "（嗯，愚人众的冒牌货。）",
            "nextDialogs": [
              "721031904"
            ]
          },
          "721031904": {
            "id": "721031904",
            "speakerId": 20223,
            "speakerName": "「玄冬林檎」",
            "text": "啊呀，又见面了。今天也要来看看运势吗？还是说…",
            "nextDialogs": [
              "721031905"
            ]
          },
          "721031905": {
            "id": "721031905",
            "speakerId": 20223,
            "speakerName": "「玄冬林檎」",
            "text": "如果有什么想倾诉、想找人商量的事，我也能听您讲喔。",
            "nextDialogs": [
              "721031908"
            ]
          },
          "721031908": {
            "id": "721031908",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "玄冬小姐好亲切喔！",
            "nextDialogs": [
              "721031909"
            ]
          },
          "721031909": {
            "id": "721031909",
            "speakerId": 20223,
            "speakerName": "「玄冬林檎」",
            "text": "是这样吗？呵呵，最近经常有人这么夸我呢。感觉好开心。",
            "nextDialogs": [
              "721031910"
            ]
          },
          "721031910": {
            "id": "721031910",
            "speakerId": 20223,
            "speakerName": "「玄冬林檎」",
            "text": "在这样漂亮的神社工作，一直是我的梦想。",
            "nextDialogs": [
              "721031911"
            ]
          },
          "721031911": {
            "id": "721031911",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "（她就是愚人众派来的冒牌货。）",
            "nextDialogs": [
              "721031912"
            ]
          },
          "721031912": {
            "id": "721031912",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "（唔…不过这个玄冬小姐，好像真的很喜欢这里的工作。）"
          }
        }
      }
    },

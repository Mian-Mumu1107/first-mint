    {
      "subId": "7226801",
      "subQuestName": "和封印前的残魂对话",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "722680101"
        ],
        "dialogs": {
          "722680101": {
            "id": "722680101",
            "speakerId": 1000,
            "speakerName": "宇陀",
            "text": "我乃末代地走官·宇陀。珊瑚宫之勇者，我认可你挑战的荣誉。",
            "nextDialogs": [
              "722680102"
            ]
          },
          "722680102": {
            "id": "722680102",
            "speakerId": 1000,
            "speakerName": "宇陀",
            "text": "我将主持「智慧」之试炼。请你动身去解开所有的谜题，让「高门之火」归位。",
            "nextDialogs": [
              "722680103"
            ]
          },
          "722680103": {
            "id": "722680103",
            "speakerId": 1000,
            "speakerName": "宇陀",
            "text": "如果没有足够的智慧，勇往直前并不能称为勇敢，只是鲁莽罢了！",
            "nextDialogs": [
              "722680104"
            ]
          },
          "722680104": {
            "id": "722680104",
            "speakerId": 1000,
            "speakerName": "宇陀",
            "text": "我将在上方三界塔处等候你完成挑战。"
          }
        }
      }
    },
    {
      "subId": "7226802",
      "subQuestName": "解放所有「高门之火」",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "722680201"
        ],
        "dialogs": {
          "722680201": {
            "id": "722680201",
            "speakerId": 1000,
            "speakerName": "宇陀",
            "text": "珊瑚宫之勇者, 前去挑战吧。",
            "nextDialogs": [
              "722680202"
            ]
          },
          "722680202": {
            "id": "722680202",
            "speakerId": 1000,
            "speakerName": "宇陀",
            "text": "让所有的「高门之火」归位吧。"
          }
        }
      }
    },
    {
      "subId": "7226803",
      "subQuestName": "解放所有「高门之火」",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "722680301"
        ],
        "dialogs": {
          "722680301": {
            "id": "722680301",
            "speakerId": 1000,
            "speakerName": "宇陀",
            "text": "我乃末代地走官·宇陀，于此认可你的勇武。",
            "nextDialogs": [
              "722680302"
            ]
          },
          "722680302": {
            "id": "722680302",
            "speakerId": 1000,
            "speakerName": "宇陀",
            "text": "你的智慧，可称得上「智圆行方」了。",
            "nextDialogs": [
              "722680303"
            ]
          },
          "722680303": {
            "id": "722680303",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "怎么从这种的试炼看出来人品德的？",
            "nextDialogs": [
              "722680304"
            ]
          },
          "722680304": {
            "id": "722680304",
            "speakerId": 1000,
            "speakerName": "宇陀",
            "text": "这其实是以前历史里现人神巫女夸青年才俊的话，后来变成了地走官部门里每年流动的小锦旗。"
          }
        }
      }
    },
    {

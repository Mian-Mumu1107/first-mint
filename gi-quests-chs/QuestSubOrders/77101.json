      }
    },
    {
      "subId": "7710116",
      "subQuestName": "取得「灰眸」身躯的一部分",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [],
        "dialogs": {}
      }
    },
    {
      "subId": "7710117",
      "subQuestName": "与「灰眸」对话",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "771011701"
        ],
        "dialogs": {
          "771011701": {
            "id": "771011701",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "唔…这就是「眼镜」的一块，边上还留着一张纸条。",
            "nextDialogs": [
              "771011702"
            ]
          },
          "771011702": {
            "id": "771011702",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "「阿尔维斯已为其玷污圣体之举付出代价，贪婪矮灵占据的血肉已自新基捷城取回…」",
            "nextDialogs": [
              "771011703"
            ]
          },
          "771011703": {
            "id": "771011703",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "等等，所以「眼镜」身躯的这个部分，并不是一开始就在这里的？",
            "nextDialogs": [
              "771011704"
            ]
          },
          "771011704": {
            "id": "771011704",
            "speakerId": 1000,
            "speakerName": "「灰眸」",
            "text": "经过辨认与识别，这是阿克西妮娅的笔迹。",
            "nextDialogs": [
              "771011705"
            ]
          },
          "771011705": {
            "id": "771011705",
            "speakerId": 1000,
            "speakerName": "「灰眸」",
            "text": "或许这能解释，为何我在一开始无法感知到身躯这一块的原因…相对来说，新基捷城的位置远了许多。",
            "nextDialogs": [
              "771011706"
            ]
          },
          "771011706": {
            "id": "771011706",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "原来是她把这块从…唔，新基捷城带回来的，那好像是至冬堡东南方的一座城市…",
            "nextDialogs": [
              "771011707"
            ]
          },
          "771011707": {
            "id": "771011707",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "对了，涅朵奇卡不是说过，她以前就住在新基捷城呢…",
            "nextDialogs": [
              "771011708"
            ]
          },
          "771011708": {
            "id": "771011708",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "不知道这个「阿尔维斯」是谁…",
            "nextDialogs": [
              "771011711"
            ]
          },
          "771011711": {
            "id": "771011711",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "哦，就是你在进入白冕宫之前，看到的以前的「谧源所」…",
            "nextDialogs": [
              "771011712"
            ]
          },
          "771011712": {
            "id": "771011712",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "阿尔维斯也是里面出现的人吗？",
            "nextDialogs": [
              "771011713"
            ]
          },
          "771011713": {
            "id": "771011713",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "没有直接看到…",
            "nextDialogs": [
              "771011714"
            ]
          },
          "771011714": {
            "id": "771011714",
            "speakerId": 1000,
            "speakerName": "「灰眸」",
            "text": "阿尔维斯…矮灵们的大公，他确实也曾是「谧源所」的一员，但很可惜，能想起的也就这个名字了。",
            "nextDialogs": [
              "771011715"
            ]
          },
          "771011715": {
            "id": "771011715",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "不管是谁，从纸条的内容上来看，他估计没落得什么好下场。",
            "nextDialogs": [
              "771011716"
            ]
          },
          "771011716": {
            "id": "771011716",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "咦，反面还有一行字，「归还王之血肉吧，以『钥匙』开启新的时代——此为最终的使命。」",
            "nextDialogs": [
              "771011717"
            ]
          },
          "771011717": {
            "id": "771011717",
            "speakerId": 1000,
            "speakerName": "「灰眸」",
            "text": "……",
            "nextDialogs": [
              "771011718"
            ]
          },
          "771011718": {
            "id": "771011718",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "这是什么意思…",
            "nextDialogs": [
              "771011719"
            ]
          },
          "771011719": {
            "id": "771011719",
            "speakerId": 1000,
            "speakerName": "「灰眸」",
            "text": "已经破碎的身躯，即使已经收回了力量也没有办法自己重新塑造，得…放到某个地方才行。",
            "nextDialogs": [
              "771011720"
            ]
          },
          "771011720": {
            "id": "771011720",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "原来不是捡到就好，还得交还到什么地方呀…"
          }
        }
      }
    }
  ]
}
    {
      "subId": "7710138",
      "subQuestName": "穿越王厅",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "771010501"
        ],
        "dialogs": {
          "771010501": {
            "id": "771010501",
            "speakerId": 1000,
            "speakerName": "「灰眸」",
            "text": "王厅之后的门似乎关闭着…",
            "nextDialogs": [
              "771010502"
            ]
          },
          "771010502": {
            "id": "771010502",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "那怎么办？",
            "nextDialogs": [
              "771010503"
            ]
          },
          "771010503": {
            "id": "771010503",
            "speakerId": 1000,
            "speakerName": "「灰眸」",
            "text": "稍等，感应到王座之前有可接入的端口…",
            "nextDialogs": [
              "771010504"
            ]
          },
          "771010504": {
            "id": "771010504",
            "speakerId": 1000,
            "speakerName": "「灰眸」",
            "text": "就是这里。",
            "nextDialogs": [
              "771010505"
            ]
          },
          "771010505": {
            "id": "771010505",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "怎么样，眼镜。",
            "nextDialogs": [
              "771010506"
            ]
          },
          "771010506": {
            "id": "771010506",
            "speakerId": 1000,
            "speakerName": "「灰眸」",
            "text": "机关的权限已获取。",
            "nextDialogs": [
              "771010507"
            ]
          },
          "771010507": {
            "id": "771010507",
            "speakerId": 1000,
            "speakerName": "「灰眸」",
            "text": "…嗯，解开王厅门封锁的方式与打开大门一致。",
            "nextDialogs": [
              "771010508"
            ]
          },
          "771010508": {
            "id": "771010508",
            "speakerId": 1000,
            "speakerName": "「灰眸」",
            "text": "「令那守护至伟尸骸的双头兽，回归其自有之位吧。」",
            "nextDialogs": [
              "771010509"
            ]
          },
          "771010509": {
            "id": "771010509",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "双头兽，难道就是之前在门口也看到过的雕像…",
            "nextDialogs": [
              "771010510"
            ]
          },
          "771010510": {
            "id": "771010510",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "那里好像有门打开的声音…",
            "nextDialogs": [
              "771010511"
            ]
          },
          "771010511": {
            "id": "771010511",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "哦，房间里也有和门口一样的雕像呢…",
            "nextDialogs": [
              "771010512"
            ]
          },
          "771010512": {
            "id": "771010512",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "回归自有之位，啊，我懂了…是得让这两个雕像全都到这个大王座前的机关上？",
            "nextDialogs": [
              "771010513"
            ]
          },
          "771010513": {
            "id": "771010513",
            "speakerId": 1000,
            "speakerName": "「灰眸」",
            "text": "看来正是如此，派蒙。"
          }
        }
      }
    },
    {
      "subId": "7710102",
      "subQuestName": "找到打开王厅门扉的办法",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [],
        "dialogs": {}
      }
    },
    {
      "subId": "7710103",
      "subQuestName": "与「灰眸」对话",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "771010701"
        ],
        "dialogs": {
          "771010701": {
            "id": "771010701",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "（…嗯，奇怪？这里是…我现在在…）",
            "nextDialogs": [
              "771010702"
            ]
          },
          "771010702": {
            "id": "771010702",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "（啊，跟之前进入的「谧源所」一样…这里也是过去的…）",
            "nextDialogs": [
              "771010703"
            ]
          },
          "771010703": {
            "id": "771010703",
            "speakerId": 1002,
            "speakerName": "阿克西妮娅",
            "text": "陛下…第一次的实验，已经完成了。",
            "nextDialogs": [
              "771010704"
            ]
          },
          "771010704": {
            "id": "771010704",
            "speakerId": 1002,
            "speakerName": "阿克西妮娅",
            "text": "伟大的猜想即将成立，继续培养下去，完整的「原初之人」的雏形马上就会诞生。",
            "nextDialogs": [
              "771010705"
            ]
          },
          "771010705": {
            "id": "771010705",
            "speakerId": 1003,
            "speakerName": "？？？",
            "text": "初步的实验完成了？",
            "nextDialogs": [
              "771010706"
            ]
          },
          "771010706": {
            "id": "771010706",
            "speakerId": 1002,
            "speakerName": "阿克西妮娅",
            "text": "是的，受试者进入了无穷的喜悦之境…再也不会忧愁，再也不会感到烦恼…",
            "nextDialogs": [
              "771010707"
            ]
          },
          "771010707": {
            "id": "771010707",
            "speakerId": 1003,
            "speakerName": "？？？",
            "text": "也再也不会从中醒来。",
            "nextDialogs": [
              "771010708"
            ]
          },
          "771010708": {
            "id": "771010708",
            "speakerId": 1002,
            "speakerName": "阿克西妮娅",
            "text": "那并非梦境，当然也没有什么「从中醒来」的说法，沙皇陛下…那是破蛹而成的蝶，或破壳而出的飞鸟。",
            "nextDialogs": [
              "771010709"
            ]
          },
          "771010709": {
            "id": "771010709",
            "speakerId": 1002,
            "speakerName": "阿克西妮娅",
            "text": "一切执着与因执着产生的愁绪，旧日的所有，都将成为被抛去的茧壳…不过是残梦，是如影子那般模糊的苦痛。",
            "nextDialogs": [
              "771010710"
            ]
          },
          "771010710": {
            "id": "771010710",
            "speakerId": 1003,
            "speakerName": "？？？",
            "text": "那新的庭院，是你的梦想中，你愿前往的世界吗，阿克西妮娅？",
            "nextDialogs": [
              "771010711"
            ]
          },
          "771010711": {
            "id": "771010711",
            "speakerId": 1002,
            "speakerName": "阿克西妮娅",
            "text": "……",
            "nextDialogs": [
              "771010712"
            ]
          },
          "771010712": {
            "id": "771010712",
            "speakerId": 1002,
            "speakerName": "阿克西妮娅",
            "text": "您的意愿就是我的意愿，陛下。",
            "nextDialogs": [
              "771010713"
            ]
          },
          "771010713": {
            "id": "771010713",
            "speakerId": 1003,
            "speakerName": "？？？",
            "text": "…是嘛，那最后的计划将在什么时候启动。",
            "nextDialogs": [
              "771010714"
            ]
          },
          "771010714": {
            "id": "771010714",
            "speakerId": 1002,
            "speakerName": "阿克西妮娅",
            "text": "还需要一段时间，等您从前线凯旋…一切都将准备完全。",
            "nextDialogs": [
              "771010715"
            ]
          },
          "771010715": {
            "id": "771010715",
            "speakerId": 1002,
            "speakerName": "阿克西妮娅",
            "text": "我想，您一定会得胜归来的。",
            "nextDialogs": [
              "771010716"
            ]
          },
          "771010716": {
            "id": "771010716",
            "speakerId": 1003,
            "speakerName": "？？？",
            "text": "…会的，阿克西妮娅。放心吧，「兽」会随我一同，无论发生什么，它都不会离我而去的。",
            "nextDialogs": [
              "771010717"
            ]
          },
          "771010717": {
            "id": "771010717",
            "speakerId": 1002,
            "speakerName": "阿克西妮娅",
            "text": "这倒确实。",
            "nextDialogs": [
              "771010718"
            ]
          },
          "771010718": {
            "id": "771010718",
            "speakerId": 1004,
            "speakerName": "「兽」",
            "text": "哼…",
            "nextDialogs": [
              "771010719"
            ]
          },
          "771010719": {
            "id": "771010719",
            "speakerId": 1002,
            "speakerName": "阿克西妮娅",
            "text": "那我将在这里等候您…陛下。",
            "nextDialogs": [
              "771010720"
            ]
          },
          "771010720": {
            "id": "771010720",
            "speakerId": 1002,
            "speakerName": "阿克西妮娅",
            "text": "直到您的愿望被达成，直到您的意志得到彻行…",
            "nextDialogs": [
              "771010721"
            ]
          },
          "771010721": {
            "id": "771010721",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "#{NICKNAME}…怎么了，你刚才突然又站着不动了…",
            "nextDialogs": [
              "771010722"
            ]
          },
          "771010722": {
            "id": "771010722",
            "speakerId": 1000,
            "speakerName": "「灰眸」",
            "text": "您又看到了什么吗…",
            "nextDialogs": [
              "771010723"
            ]
          },
          "771010723": {
            "id": "771010723",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "是些过去的景象…",
            "nextDialogs": [
              "771010724"
            ]
          },
          "771010724": {
            "id": "771010724",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "唔…那你有没有看到什么让你不舒服的…",
            "nextDialogs": [
              "771010725"
            ]
          },
          "771010725": {
            "id": "771010725",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "不…没什么…",
            "nextDialogs": [
              "771010726"
            ]
          },
          "771010726": {
            "id": "771010726",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "好哦，那…刚才白冕宫王厅的门已经打开了，我们继续往前吧！"
          }
        }
      }
    },
    {
      "subId": "7710104",

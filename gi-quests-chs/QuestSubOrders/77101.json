    {
      "subId": "7710106",
      "subQuestName": "与「灰眸」对话",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "771010601"
        ],
        "dialogs": {
          "771010601": {
            "id": "771010601",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "门终于打开了…唔，说起来，刚才有好多长得好奇怪的魔兽哦…",
            "nextDialogs": [
              "771010602"
            ]
          },
          "771010602": {
            "id": "771010602",
            "speakerId": 1000,
            "speakerName": "「灰眸」",
            "text": "是当年卡谢伊在谧源所制造的…合成魔物。",
            "nextDialogs": [
              "771010603"
            ]
          },
          "771010603": {
            "id": "771010603",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "那，刚才说话的那个家伙呢，它自己没有出现吧，我还以为它会登场…",
            "nextDialogs": [
              "771010604"
            ]
          },
          "771010604": {
            "id": "771010604",
            "speakerId": 1000,
            "speakerName": "「灰眸」",
            "text": "那个是…「兽」，是合成魔兽的领袖。也是卡谢伊利用生物炼金制造的诸多造物之一。",
            "nextDialogs": [
              "771010605"
            ]
          },
          "771010605": {
            "id": "771010605",
            "speakerId": 1000,
            "speakerName": "「灰眸」",
            "text": "当时，卡谢伊利用同样的材料，制作了许多「雏形」…那其中，有智慧的仅有它和…奇怪，有点想不起来了。",
            "nextDialogs": [
              "771010606"
            ]
          },
          "771010606": {
            "id": "771010606",
            "speakerId": 1000,
            "speakerName": "「灰眸」",
            "text": "卡谢伊认为，「兽」是半成品，于是舍弃了它。",
            "nextDialogs": [
              "771010607"
            ]
          },
          "771010607": {
            "id": "771010607",
            "speakerId": 1000,
            "speakerName": "「灰眸」",
            "text": "最后，作为半成品的「兽」被融入了其他魔兽的种子，塑造成了现在的形体，「兽」本应该被销毁…",
            "nextDialogs": [
              "771010608"
            ]
          },
          "771010608": {
            "id": "771010608",
            "speakerId": 1000,
            "speakerName": "「灰眸」",
            "text": "不过在被销毁前，白沙皇认为有真正神智之物不该如此死去，于是将它收入了麾下。",
            "nextDialogs": [
              "771010609"
            ]
          },
          "771010609": {
            "id": "771010609",
            "speakerId": 1000,
            "speakerName": "「灰眸」",
            "text": "…听说白沙皇的尸身是由它带着重伤从战场上带回。",
            "nextDialogs": [
              "771010610"
            ]
          },
          "771010610": {
            "id": "771010610",
            "speakerId": 1000,
            "speakerName": "「灰眸」",
            "text": "正因如此，它极度讨厌卡谢伊…",
            "nextDialogs": [
              "771010611"
            ]
          },
          "771010611": {
            "id": "771010611",
            "speakerId": 1000,
            "speakerName": "「灰眸」",
            "text": "我以为它早已在无人得知之处默默死去，但是，太好了，它还活着。",
            "nextDialogs": [
              "771010612"
            ]
          },
          "771010612": {
            "id": "771010612",
            "speakerId": 1000,
            "speakerName": "「灰眸」",
            "text": "没想到它…一直在看守沙皇陛下已然作为陵墓的行宫。",
            "nextDialogs": [
              "771010613"
            ]
          },
          "771010613": {
            "id": "771010613",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "唔，终于知道为什么不推荐私自来这里了，说不定没得到允许来这里的家伙全都被那个什么「兽」赶跑了。",
            "nextDialogs": [
              "771010614"
            ]
          },
          "771010614": {
            "id": "771010614",
            "speakerId": 1000,
            "speakerName": "「灰眸」",
            "text": "白冕宫还是太过危险了。「兽」…",
            "nextDialogs": [
              "771010615"
            ]
          },
          "771010615": {
            "id": "771010615",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "没关系，都已经到这里来了，我们一定会帮你找到你的身体的。",
            "nextDialogs": [
              "771010616"
            ]
          },
          "771010616": {
            "id": "771010616",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "它再来，把它赶跑就行了。",
            "nextDialogs": [
              "771010617"
            ]
          },
          "771010617": {
            "id": "771010617",
            "speakerId": 1000,
            "speakerName": "「灰眸」",
            "text": "#嗯，我相信你…{NICKNAME}，还有派蒙…",
            "nextDialogs": [
              "771010618"
            ]
          },
          "771010618": {
            "id": "771010618",
            "speakerId": 1000,
            "speakerName": "「灰眸」",
            "text": "不过，它之后应该还是会出现，得时刻注意周围才行…",
            "nextDialogs": [
              "771010619"
            ]
          },
          "771010619": {
            "id": "771010619",
            "speakerId": 1000,
            "speakerName": "「灰眸」",
            "text": "这件事，还请交给我吧。"
          }
        }
      }
    },
    {
      "subId": "7710126",
      "subQuestName": "寻找向上的道路",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [],
        "dialogs": {}
      }
    },
    {
      "subId": "7710108",
      "subQuestName": "查看吊悬之塔",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "771010801"
        ],
        "dialogs": {
          "771010801": {
            "id": "771010801",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "嗯…越来越高了，不知道为什么有点紧张。",
            "nextDialogs": [
              "771010802"
            ]
          },
          "771010802": {
            "id": "771010802",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "因为「兽」吗…",
            "nextDialogs": [
              "771010803"
            ]
          },
          "771010803": {
            "id": "771010803",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "是啊，那个家伙不是也能说话嘛，说不定我们和它好好聊聊天…它不会把我们看成进来的贼了…",
            "nextDialogs": [
              "771010804"
            ]
          },
          "771010804": {
            "id": "771010804",
            "speakerId": 1000,
            "speakerName": "「灰眸」",
            "text": "「只要沟通，就能够理解…」或许真如派蒙小姐所说…",
            "nextDialogs": [
              "771010805"
            ]
          },
          "771010805": {
            "id": "771010805",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "嘿嘿…",
            "nextDialogs": [
              "771010806"
            ]
          },
          "771010806": {
            "id": "771010806",
            "speakerId": 1000,
            "speakerName": "「灰眸」",
            "text": "#…不对，{NICKNAME}，检测到高能量体…在靠近…小心！",
            "nextDialogs": [
              "771010807"
            ]
          },
          "771010807": {
            "id": "771010807",
            "speakerId": 1003,
            "speakerName": "？？？",
            "text": "我已警告过你们许多次，但你们仍要自寻死路…"
          }
        }
      }
    },

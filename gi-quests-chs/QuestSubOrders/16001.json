  "subQuests": [
    {
      "subId": "1600102",
      "subQuestName": "与杜林会合",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "160010201"
        ],
        "dialogs": {
          "160010201": {
            "id": "160010201",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "你好啊，杜林，后续的提示有了吗？我们准备好进入下一个篇章了！",
            "nextDialogs": [
              "160010202"
            ]
          },
          "160010202": {
            "id": "160010202",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "准备好了！",
            "nextDialogs": [
              "160010203"
            ]
          },
          "160010203": {
            "id": "160010203",
            "speakerId": 1320,
            "speakerName": "杜林",
            "text": "后续的提示已经有了，我正要去找你们，先一起看看吧。",
            "nextDialogs": [
              "160010204"
            ]
          },
          "160010204": {
            "id": "160010204",
            "speakerId": 13724,
            "speakerName": "某人的声音",
            "text": "风儿携着乐声飞来，让故事的种子得以发芽。",
            "nextDialogs": [
              "160010205"
            ]
          },
          "160010205": {
            "id": "160010205",
            "speakerId": 13724,
            "speakerName": "某人的声音",
            "text": "乐声也随着风儿远去，消失在遥远的过去。",
            "nextDialogs": [
              "160010206"
            ]
          },
          "160010206": {
            "id": "160010206",
            "speakerId": 13724,
            "speakerName": "某人的声音",
            "text": "去风与故事相遇的地方吧，将三个谜题写成诗，将三段曲谱连成歌。",
            "nextDialogs": [
              "160010207"
            ]
          },
          "160010207": {
            "id": "160010207",
            "speakerId": 13724,
            "speakerName": "某人的声音",
            "text": "乐声中的诗与歌，就是这个故事最初的绿芽。",
            "nextDialogs": [
              "160010208"
            ]
          },
          "160010208": {
            "id": "160010208",
            "speakerId": 1320,
            "speakerName": "杜林",
            "text": "这是…",
            "nextDialogs": [
              "160010209"
            ]
          },
          "160010209": {
            "id": "160010209",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "又是一个谜语吗？书里的声音还提到了风和乐章什么的，那谜底会是什么啊？",
            "nextDialogs": [
              "160010210"
            ]
          },
          "160010210": {
            "id": "160010210",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "派蒙，该想起那个老熟人了。",
            "nextDialogs": [
              "160010211"
            ]
          },
          "160010211": {
            "id": "160010211",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "唔…哦！",
            "nextDialogs": [
              "160010212"
            ]
          },
          "160010212": {
            "id": "160010212",
            "speakerId": 1320,
            "speakerName": "杜林",
            "text": "所以是怎么回事？",
            "nextDialogs": [
              "160010213"
            ]
          },
          "160010213": {
            "id": "160010213",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "说到风啊，音乐啊，诗歌啊之类的，找那个卖唱的肯定能问出东西来。",
            "nextDialogs": [
              "160010214"
            ]
          },
          "160010214": {
            "id": "160010214",
            "speakerId": 1320,
            "speakerName": "杜林",
            "text": "派蒙是指巴巴托斯大人？",
            "nextDialogs": [
              "160010215"
            ]
          },
          "160010215": {
            "id": "160010215",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "你知道？",
            "nextDialogs": [
              "160010216"
            ]
          },
          "160010216": {
            "id": "160010216",
            "speakerId": 1320,
            "speakerName": "杜林",
            "text": "我刚来到蒙德时，阿贝多就把我引见给巴巴托斯大人了。我这样的存在，肯定会吸引到他的关注。",
            "nextDialogs": [
              "160010217"
            ]
          },
          "160010217": {
            "id": "160010217",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "其实这样也好…话说回来，我们现在该去哪里找他？",
            "nextDialogs": [
              "160010218"
            ]
          },
          "160010218": {
            "id": "160010218",
            "speakerId": 1320,
            "speakerName": "杜林",
            "text": "巴巴托斯大人应该听到了，我们跟着风走吧。",
            "nextDialogs": [
              "160010219"
            ]
          },
          "160010219": {
            "id": "160010219",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "有时候我真的忘了他还是个神明…"
          }
        }
      }
    },
    {
      "subId": "1600103",
      "subQuestName": "跟随指引寻找温迪",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "160010301"
        ],
        "dialogs": {
          "160010301": {
            "id": "160010301",
            "speakerId": 1001,
            "speakerName": "温迪",
            "text": "#好久不见啊，{NICKNAME}和派蒙，还有童话世界来的小龙。",
            "nextDialogs": [
              "160010302"
            ]
          },
          "160010302": {
            "id": "160010302",
            "speakerId": 1001,
            "speakerName": "温迪",
            "text": "我从风中听到了你们呼唤我的声音，你们似乎被一道谜语难住了？",
            "nextDialogs": [
              "160010303"
            ]
          },
          "160010303": {
            "id": "160010303",
            "speakerId": 1320,
            "speakerName": "杜林",
            "text": "抱歉打扰到您了，巴巴托斯大人…",
            "nextDialogs": [
              "160010304"
            ]
          },
          "160010304": {
            "id": "160010304",
            "speakerId": 1001,
            "speakerName": "温迪",
            "text": "不要这么说，我本身对这个谜语也很感兴趣，给我看下吧。",
            "nextDialogs": [
              "160010305"
            ]
          },
          "160010305": {
            "id": "160010305",
            "speakerId": 1001,
            "speakerName": "温迪",
            "text": "嗯…哈哈…",
            "nextDialogs": [
              "160010306"
            ]
          },
          "160010306": {
            "id": "160010306",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "看出什么来了吗？",
            "nextDialogs": [
              "160010307"
            ]
          },
          "160010307": {
            "id": "160010307",
            "speakerId": 1001,
            "speakerName": "温迪",
            "text": "三个谜题与三段曲谱…这种说法让我想起了一些往事，你们想要的谜底应该就藏在这些往事里。",
            "nextDialogs": [
              "160010308"
            ]
          },
          "160010308": {
            "id": "160010308",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "来找卖唱的果然没错！",
            "nextDialogs": [
              "160010309"
            ]
          },
          "160010309": {
            "id": "160010309",
            "speakerId": 1001,
            "speakerName": "温迪",
            "text": "很多年前，那几位魔女来到蒙德，想要和我一较高下。",
            "nextDialogs": [
              "160010310"
            ]
          },
          "160010310": {
            "id": "160010310",
            "speakerId": 1001,
            "speakerName": "温迪",
            "text": "而我说，不要比武，让我们唱歌弹琴，用诗来结束纷争。",
            "nextDialogs": [
              "160010311"
            ]
          },
          "160010311": {
            "id": "160010311",
            "speakerId": 1001,
            "speakerName": "温迪",
            "text": "我拨动竖琴，向她们吟唱了这首诗——",
            "nextDialogs": [
              "160010312"
            ]
          },
          "160010312": {
            "id": "160010312",
            "speakerId": 1001,
            "speakerName": "温迪",
            "text": "「风儿，风儿，请代我迎客。」",
            "nextDialogs": [
              "160010313"
            ]
          },
          "160010313": {
            "id": "160010313",
            "speakerId": 1001,
            "speakerName": "温迪",
            "text": "「于青葱之间穿行吧，在那里，来去无踪的你也可以拥有形状，正好为我的客人演舞一场。」",
            "nextDialogs": [
              "160010314"
            ]
          },
          "160010314": {
            "id": "160010314",
            "speakerId": 1001,
            "speakerName": "温迪",
            "text": "「于云海之畔跃动吧，在那里，好事之徒都会被你的歌声吓阻，正好替我的客人隔绝扰攘。」",
            "nextDialogs": [
              "160010315"
            ]
          },
          "160010315": {
            "id": "160010315",
            "speakerId": 1001,
            "speakerName": "温迪",
            "text": "「于星辰之下飞翔吧，在那里，尘世的喧嚣都能被你涤荡一空，正好让我的客人倾诉畅想。」",
            "nextDialogs": [
              "160010316"
            ]
          },
          "160010316": {
            "id": "160010316",
            "speakerId": 1001,
            "speakerName": "温迪",
            "text": "「去那里吧，那是我许诺给客人的地方。」",
            "nextDialogs": [
              "160010317"
            ]
          },
          "160010317": {
            "id": "160010317",
            "speakerId": 1001,
            "speakerName": "温迪",
            "text": "「那里没有争斗和较量，只有茶杯和惬意的时光。」",
            "nextDialogs": [
              "160010318"
            ]
          },
          "160010318": {
            "id": "160010318",
            "speakerId": 1001,
            "speakerName": "温迪",
            "text": "三段曲谱我已经为你们演奏了一遍，至于那三个谜题的答案，想必你们已经能猜出来了吧？",
            "nextDialogs": [
              "160010319"
            ]
          },
          "160010319": {
            "id": "160010319",
            "speakerId": 1320,
            "speakerName": "杜林",
            "text": "…树林里，悬崖边，天上？",
            "nextDialogs": [
              "160010320"
            ]
          },
          "160010320": {
            "id": "160010320",
            "speakerId": 1001,
            "speakerName": "温迪",
            "text": "回答正确！说起来，当年面对这个谜语，你的母亲也是最先猜出答案的人呢。",
            "nextDialogs": [
              "160010321"
            ]
          },
          "160010321": {
            "id": "160010321",
            "speakerId": 1001,
            "speakerName": "温迪",
            "text": "书写故事的人和吟唱故事的人之间，似乎存在某种默契。",
            "nextDialogs": [
              "160010322"
            ]
          },
          "160010322": {
            "id": "160010322",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "树林里，悬崖边，天上…哦，是那里！",
            "nextDialogs": [
              "160010323"
            ]
          },
          "160010323": {
            "id": "160010323",
            "speakerId": 1001,
            "speakerName": "温迪",
            "text": "这个答案指向的地点，应该就是你们接下来要去的地方了。",
            "nextDialogs": [
              "160010324"
            ]
          },
          "160010324": {
            "id": "160010324",
            "speakerId": 1001,
            "speakerName": "温迪",
            "text": "魔女们猜对了我的谜语，也接受了我的提议。之后，她们就选择那里作为聚会地点了。",
            "nextDialogs": [
              "160010325"
            ]
          },
          "160010325": {
            "id": "160010325",
            "speakerId": 1001,
            "speakerName": "温迪",
            "text": "根据这本书给出的提示，或许你们可以试试去那里演奏我给的曲谱？",
            "nextDialogs": [
              "160010326"
            ]
          },
          "160010326": {
            "id": "160010326",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "你正经的时候果然很靠谱啊，风神巴巴托斯大人。",
            "nextDialogs": [
              "160010327"
            ]
          },
          "160010327": {
            "id": "160010327",
            "speakerId": 1320,
            "speakerName": "杜林",
            "text": "谢谢您，巴巴托斯大人，我…",
            "nextDialogs": [
              "160010328"
            ]
          },
          "160010328": {
            "id": "160010328",
            "speakerId": 1001,
            "speakerName": "温迪",
            "text": "看上去，你还有想让我解答的问题？",
            "nextDialogs": [
              "160010329"
            ]
          },
          "160010329": {
            "id": "160010329",
            "speakerId": 1320,
            "speakerName": "杜林",
            "text": "嗯…您作为吟游诗人，肯定阅读过不计其数的故事。您觉得，一个什么样的故事会被它的作者认为是未完成的呢？",
            "nextDialogs": [
              "160010330"
            ]
          },
          "160010330": {
            "id": "160010330",
            "speakerId": 1001,
            "speakerName": "温迪",
            "text": "这个啊，故事里还有尚未达成的心愿，抑或是…未完待续！",
            "nextDialogs": [
              "160010331"
            ]
          },
          "160010331": {
            "id": "160010331",
            "speakerId": 1320,
            "speakerName": "杜林",
            "text": "啊？",
            "nextDialogs": [
              "160010332"
            ]
          },
          "160010332": {
            "id": "160010332",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "我刚刚才说过你很靠谱…",
            "nextDialogs": [
              "160010333"
            ]
          },
          "160010333": {
            "id": "160010333",
            "speakerId": 1001,
            "speakerName": "温迪",
            "text": "你想要的答案应该就在这个故事里面，那是你母亲留给你的故事，我不应该过问太多。",
            "nextDialogs": [
              "160010334"
            ]
          },
          "160010334": {
            "id": "160010334",
            "speakerId": 1320,
            "speakerName": "杜林",
            "text": "嗯…我们出发吧。"
          }
        }
      }
    },
    {
      "subId": "1600104",
      "subQuestName": "前往魔女们的聚会地点",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "160010401"
        ],
        "dialogs": {
          "160010401": {
            "id": "160010401",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "就是这里了。我们在这里演奏那三段曲谱，应该就能收集到下个篇章需要的「回忆」了吧？",
            "nextDialogs": [
              "160010402"
            ]
          },
          "160010402": {
            "id": "160010402",
            "speakerId": 1320,
            "speakerName": "杜林",
            "text": "演奏音乐吗？丽莎老师教的东西里面，这个是我最不擅长的…",
            "nextDialogs": [
              "160010403"
            ]
          },
          "160010403": {
            "id": "160010403",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "交给我吧。"
          }
        }
      }
    },
    {
      "subId": "1600110",
      "subQuestName": "进入魔法书里的世界",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "160011001"
        ],
        "dialogs": {
          "160011001": {
            "id": "160011001",
            "speakerId": 1001,
            "speakerName": "温迪",
            "text": "她们的下一次聚会，又会是什么时候呢？"
          }
        }
      }
    },
    {
      "subId": "1600105",
      "subQuestName": "从旁白口中了解故事",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "160010507"
        ],
        "dialogs": {
          "160010507": {
            "id": "160010507",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "所以，这也是故事里的世界吧？",
            "nextDialogs": [
              "160010508"
            ]
          },
          "160010508": {
            "id": "160010508",
            "speakerId": 12674,
            "speakerName": "旁白",
            "text": "女巫的长桌忽然迎来了新的客人，莫非他们也想参加龙孩子的庆生会？",
            "nextDialogs": [
              "160010509"
            ]
          },
          "160010509": {
            "id": "160010509",
            "speakerId": 12674,
            "speakerName": "旁白",
            "text": "可是，大家都在思考该为龙孩子准备什么样的礼物，这三位却都两手空空。",
            "nextDialogs": [
              "160010510"
            ]
          },
          "160010510": {
            "id": "160010510",
            "speakerId": 12674,
            "speakerName": "旁白",
            "text": "这样的话，作为客人可不会受到长桌的欢迎哦。",
            "nextDialogs": [
              "160010511"
            ]
          },
          "160010511": {
            "id": "160010511",
            "speakerId": 1320,
            "speakerName": "杜林",
            "text": "礼物？",
            "nextDialogs": [
              "160010512"
            ]
          },
          "160010512": {
            "id": "160010512",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "这是怎么回事？我们刚刚才知道啊。",
            "nextDialogs": [
              "160010513"
            ]
          },
          "160010513": {
            "id": "160010513",
            "speakerId": 12674,
            "speakerName": "旁白",
            "text": "客人们如此抱怨，或许他们更应该思考一下要准备什么样的礼物。",
            "nextDialogs": [
              "160010514"
            ]
          },
          "160010514": {
            "id": "160010514",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "…看来要推进故事的话，就得准备一个礼物。不过现在准备的话，礼物从哪来？",
            "nextDialogs": [
              "160010515"
            ]
          },
          "160010515": {
            "id": "160010515",
            "speakerId": 12674,
            "speakerName": "旁白",
            "text": "或许，他们可以在周围找一找。",
            "nextDialogs": [
              "160010516"
            ]
          },
          "160010516": {
            "id": "160010516",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "早说嘛！"
          }
        }
      }
    },
    {
      "subId": "1600111",
      "subQuestName": "",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "160011101"
        ],
        "dialogs": {
          "160011101": {
            "id": "160011101",
            "speakerId": 12179,
            "speakerName": "观察",
            "text": "（一柄玩具剑，看起来很适合用来扮演战士。）"
          }
        }
      }
    },
    {
      "subId": "1600106",
      "subQuestName": "寻找礼物",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "160010601"
        ],
        "dialogs": {
          "160010601": {
            "id": "160010601",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "这些东西能不能拿来当作礼物啊？",
            "nextDialogs": [
              "160010602"
            ]
          },
          "160010602": {
            "id": "160010602",
            "speakerId": 12674,
            "speakerName": "旁白",
            "text": "客人们终于发现了可以当作礼物的物品。",
            "nextDialogs": [
              "160010603"
            ]
          },
          "160010603": {
            "id": "160010603",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "看来是了…让我看看，选哪个好呢？",
            "nextDialogs": [
              "160010604"
            ]
          },
          "160010604": {
            "id": "160010604",
            "speakerId": 12674,
            "speakerName": "旁白",
            "text": "客人们如此思索，那条小龙到底喜欢什么样的礼物呢？",
            "nextDialogs": [
              "160010605"
            ]
          },
          "160010605": {
            "id": "160010605",
            "speakerId": 12674,
            "speakerName": "旁白",
            "text": "是让他挥起战士的长剑，踏上一条拯救世界的道路，一往无前？",
            "nextDialogs": [
              "160010606"
            ]
          },
          "160010606": {
            "id": "160010606",
            "speakerId": 12674,
            "speakerName": "旁白",
            "text": "还是让他拿起游侠的弹弓，追寻一场又一场充满未知的冒险？",
            "nextDialogs": [
              "160010607"
            ]
          },
          "160010607": {
            "id": "160010607",
            "speakerId": 12674,
            "speakerName": "旁白",
            "text": "又或者让他打开学者的典籍，挑战这世界上所有的未解之谜？",
            "nextDialogs": [
              "160010608"
            ]
          },
          "160010608": {
            "id": "160010608",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "被她这么一说，我反倒更犹豫了…",
            "nextDialogs": [
              "160010609"
            ]
          },
          "160010609": {
            "id": "160010609",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "杜林怎么看？",
            "nextDialogs": [
              "160010610"
            ]
          },
          "160010610": {
            "id": "160010610",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "对哦，严格来说，这是在给「你」选礼物啊，你更喜欢哪个？",
            "nextDialogs": [
              "160010611"
            ]
          },
          "160010611": {
            "id": "160010611",
            "speakerId": 1320,
            "speakerName": "杜林",
            "text": "让我选的话…这种感觉好特别。",
            "nextDialogs": [
              "160010612"
            ]
          },
          "160010612": {
            "id": "160010612",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "为什么这么说？",
            "nextDialogs": [
              "160010613"
            ]
          },
          "160010613": {
            "id": "160010613",
            "speakerId": 1320,
            "speakerName": "杜林",
            "text": "自从记事以来，我大部分时间都生活在母亲写的故事里。",
            "nextDialogs": [
              "160010614"
            ]
          },
          "160010614": {
            "id": "160010614",
            "speakerId": 1320,
            "speakerName": "杜林",
            "text": "就像星轨王城的那些积木小人一样，我一直觉得母亲的故事已经写好了一切，很少思考自己将来想做什么。",
            "nextDialogs": [
              "160010615"
            ]
          },
          "160010615": {
            "id": "160010615",
            "speakerId": 1320,
            "speakerName": "杜林",
            "text": "那时的我想要什么…我还是第一次思考这个问题。",
            "nextDialogs": [
              "160010616"
            ]
          },
          "160010616": {
            "id": "160010616",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "那这次不正好是个机会？",
            "nextDialogs": [
              "160010617"
            ]
          },
          "160010617": {
            "id": "160010617",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "杜林从希穆兰卡来到这个世界已经有一段时间了，也和朋友们经历了很多事情，正好思考一下自己的未来。",
            "nextDialogs": [
              "160010618"
            ]
          },
          "160010618": {
            "id": "160010618",
            "speakerId": 1320,
            "speakerName": "杜林",
            "text": "嗯…请让我考虑一下。"
          }
        }
      }
    },
    {
      "subId": "1600107",
      "subQuestName": "挑选礼物",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "160011401"
        ],
        "dialogs": {
          "160011401": {
            "id": "160011401",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "就选它吧。",
            "nextDialogs": [
              "160011402"
            ]
          },
          "160011402": {
            "id": "160011402",
            "speakerId": 12674,
            "speakerName": "旁白",
            "text": "客人选择了战士的长剑作为礼物。",
            "nextDialogs": [
              "160011403"
            ]
          },
          "160011403": {
            "id": "160011403",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "所以杜林想成为战士！",
            "nextDialogs": [
              "160011404"
            ]
          },
          "160011404": {
            "id": "160011404",
            "speakerId": 1320,
            "speakerName": "杜林",
            "text": "成为战士…其实我是想成为一个能保护大家的人。",
            "nextDialogs": [
              "160011405"
            ]
          },
          "160011405": {
            "id": "160011405",
            "speakerId": 1320,
            "speakerName": "杜林",
            "text": "和阿贝多一起前往挪德卡莱之后，我发现这个世界上的很多问题必须通过战斗来解决。",
            "nextDialogs": [
              "160011406"
            ]
          },
          "160011406": {
            "id": "160011406",
            "speakerId": 1320,
            "speakerName": "杜林",
            "text": "如果我能帮到大家就好了。",
            "nextDialogs": [
              "160011407"
            ]
          },
          "160011407": {
            "id": "160011407",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "你已经很厉害了。",
            "nextDialogs": [
              "160011408"
            ]
          },
          "160011408": {
            "id": "160011408",
            "speakerId": 1320,
            "speakerName": "杜林",
            "text": "是吗？但是，我觉得还不够…"
          }
        }
      }
    },
    {
      "subId": "1600108",
      "subQuestName": "带着礼物参加庆生会",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "160010801"
        ],
        "dialogs": {
          "160010801": {
            "id": "160010801",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "这次我们带着礼物，应该不会被拦住了吧？",
            "nextDialogs": [
              "160010802"
            ]
          },
          "160010802": {
            "id": "160010802",
            "speakerId": 1320,
            "speakerName": "杜林",
            "text": "你好，这是我带来的礼物。",
            "nextDialogs": [
              "160010803"
            ]
          },
          "160010803": {
            "id": "160010803",
            "speakerId": 12674,
            "speakerName": "旁白",
            "text": "新来的客人送上了礼物，祝福小龙成为披荆斩棘的战士。",
            "nextDialogs": [
              "160010804"
            ]
          },
          "160010804": {
            "id": "160010804",
            "speakerId": 12674,
            "speakerName": "旁白",
            "text": "新来的客人送上了礼物，祝福小龙成为逍遥自在的游侠。",
            "nextDialogs": [
              "160010805"
            ]
          },
          "160010805": {
            "id": "160010805",
            "speakerId": 12674,
            "speakerName": "旁白",
            "text": "新来的客人送上了礼物，祝福小龙成为博学多才的学者。",
            "nextDialogs": [
              "160010806"
            ]
          },
          "160010806": {
            "id": "160010806",
            "speakerId": 12674,
            "speakerName": "旁白",
            "text": "故事女巫接受了客人的祝福，邀请他们加入长桌上的聚会。",
            "nextDialogs": [
              "160010807"
            ]
          },
          "160010807": {
            "id": "160010807",
            "speakerId": 12674,
            "speakerName": "旁白",
            "text": "于是故事女巫正式向朋友们介绍自己的龙孩子，讲到他的破壳，讲到他的名字…",
            "nextDialogs": [
              "160010808"
            ]
          },
          "160010808": {
            "id": "160010808",
            "speakerId": 12674,
            "speakerName": "旁白",
            "text": "就在这时，擅长占卜的预言女巫从星星那里收回了视线，向小龙投去怜悯的目光。",
            "nextDialogs": [
              "160010809"
            ]
          },
          "160010809": {
            "id": "160010809",
            "speakerId": 15877,
            "speakerName": "预言女巫",
            "text": "你为他取了与邪龙相同的名字？",
            "nextDialogs": [
              "160010810"
            ]
          },
          "160010810": {
            "id": "160010810",
            "speakerId": 15876,
            "speakerName": "故事女巫",
            "text": "是的，但我要送给他一个与邪龙不同的人生。",
            "nextDialogs": [
              "160010811"
            ]
          },
          "160010811": {
            "id": "160010811",
            "speakerId": 15877,
            "speakerName": "预言女巫",
            "text": "真是愚妄的爱，「名字」是命运的映射。正因为拥有邪龙的名字，所以他必然也将面对邪龙的命运。",
            "nextDialogs": [
              "160010812"
            ]
          },
          "160010812": {
            "id": "160010812",
            "speakerId": 15877,
            "speakerName": "预言女巫",
            "text": "这是一个「预言」。",
            "nextDialogs": [
              "160010813"
            ]
          },
          "160010813": {
            "id": "160010813",
            "speakerId": 15876,
            "speakerName": "故事女巫",
            "text": "…那我就改写他的命运。",
            "nextDialogs": [
              "160010814"
            ]
          },
          "160010814": {
            "id": "160010814",
            "speakerId": 12674,
            "speakerName": "旁白",
            "text": "席间的女巫们都陷入沉默，因为她们知道预言女巫的预言从来不会出错。",
            "nextDialogs": [
              "160010815"
            ]
          },
          "160010815": {
            "id": "160010815",
            "speakerId": 12674,
            "speakerName": "旁白",
            "text": "但是大家也明白故事女巫的决心，一位母亲对孩子的爱容不下多少质疑。",
            "nextDialogs": [
              "160010816"
            ]
          },
          "160010816": {
            "id": "160010816",
            "speakerId": 12674,
            "speakerName": "旁白",
            "text": "直到那位快乐女巫挺身而出，这令人烦扰的沉默才得以消解。",
            "nextDialogs": [
              "160010817"
            ]
          },
          "160010817": {
            "id": "160010817",
            "speakerId": 15878,
            "speakerName": "快乐女巫",
            "text": "那就让大家都来帮忙，我们一起改写这个孩子的命运！",
            "nextDialogs": [
              "160010818"
            ]
          },
          "160010818": {
            "id": "160010818",
            "speakerId": 15877,
            "speakerName": "预言女巫",
            "text": "你想挑战这个世界最本质的规则之一？",
            "nextDialogs": [
              "160010819"
            ]
          },
          "160010819": {
            "id": "160010819",
            "speakerId": 15878,
            "speakerName": "快乐女巫",
            "text": "我才不想受限于这个世界的规则，反倒是挑战规则这种事，更适合作为女巫聚会的议题呢。",
            "nextDialogs": [
              "160010820"
            ]
          },
          "160010820": {
            "id": "160010820",
            "speakerId": 15879,
            "speakerName": "智慧女巫",
            "text": "哦？听上去会是个很有趣的实验。",
            "nextDialogs": [
              "160010821"
            ]
          },
          "160010821": {
            "id": "160010821",
            "speakerId": 15877,
            "speakerName": "预言女巫",
            "text": "…如果我们真的能成功，倒也可以为这片无聊的星空增添几分趣味。",
            "nextDialogs": [
              "160010822"
            ]
          },
          "160010822": {
            "id": "160010822",
            "speakerId": 12674,
            "speakerName": "旁白",
            "text": "快乐女巫最终说服了大家，就像曾经的许多次那样。",
            "nextDialogs": [
              "160010823"
            ]
          },
          "160010823": {
            "id": "160010823",
            "speakerId": 12674,
            "speakerName": "旁白",
            "text": "她就像太阳，强大而又温暖，等她的光洒向你时，已容不得你拒绝。",
            "nextDialogs": [
              "160010824"
            ]
          },
          "160010824": {
            "id": "160010824",
            "speakerId": 12674,
            "speakerName": "旁白",
            "text": "于是女巫们准备好了各自的礼物，那是这宇宙间的三重奇迹。",
            "nextDialogs": [
              "160010825"
            ]
          },
          "160010825": {
            "id": "160010825",
            "speakerId": 15877,
            "speakerName": "预言女巫",
            "text": "那就让我破解高天的呓语，向他明示「命运」的诡计。",
            "nextDialogs": [
              "160010826"
            ]
          },
          "160010826": {
            "id": "160010826",
            "speakerId": 15879,
            "speakerName": "智慧女巫",
            "text": "那就让我留下足以解析世界本源的算式，为他的「生命」求得另一个解。",
            "nextDialogs": [
              "160010827"
            ]
          },
          "160010827": {
            "id": "160010827",
            "speakerId": 15878,
            "speakerName": "快乐女巫",
            "text": "那就让我拿出神奇的魔法，帮他将不可能的「愿望」变化为可能。",
            "nextDialogs": [
              "160010828"
            ]
          },
          "160010828": {
            "id": "160010828",
            "speakerId": 12674,
            "speakerName": "旁白",
            "text": "而故事女巫只有手中的笔，但她准备用倾注于笔尖的爱创造另一个奇迹。",
            "nextDialogs": [
              "160010829"
            ]
          },
          "160010829": {
            "id": "160010829",
            "speakerId": 15876,
            "speakerName": "故事女巫",
            "text": "那就让我把笔下的最后一个「故事」留给他，嫁接在那尚未美满的结局之上。",
            "nextDialogs": [
              "160010830"
            ]
          },
          "160010830": {
            "id": "160010830",
            "speakerId": 12674,
            "speakerName": "旁白",
            "text": "接受了女巫们的祝福后，小龙的命运终于开始转动了。"
          }
        }
      }
    },
    {
      "subId": "1600112",
      "subQuestName": "",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "160010901"
        ],
        "dialogs": {
          "160010901": {
            "id": "160010901",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "嗯…看来这个篇章也补全了。",
            "nextDialogs": [
              "160010902"
            ]
          },
          "160010902": {
            "id": "160010902",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "那些女巫应该都是魔女会的成员吧？看上去大家都很关心杜林的事！",
            "nextDialogs": [
              "160010903"
            ]
          },
          "160010903": {
            "id": "160010903",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "只是她们说的我都不太懂，魔女们都好神秘啊…",
            "nextDialogs": [
              "160010904"
            ]
          },
          "160010904": {
            "id": "160010904",
            "speakerId": 1320,
            "speakerName": "杜林",
            "text": "邪龙的命运…",
            "nextDialogs": [
              "160010905"
            ]
          },
          "160010905": {
            "id": "160010905",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "杜林在意的是这个啊…这个问题已经在希穆兰卡被解决了，不是吗？",
            "nextDialogs": [
              "160010908"
            ]
          },
          "160010908": {
            "id": "160010908",
            "speakerId": 1320,
            "speakerName": "杜林",
            "text": "嗯…这里面应该也有魔女阿姨们的帮助吧。",
            "nextDialogs": [
              "160010909"
            ]
          },
          "160010909": {
            "id": "160010909",
            "speakerId": 1320,
            "speakerName": "杜林",
            "text": "另外，其实我忽然有个问题，我们补全的是哪一部分？",
            "nextDialogs": [
              "160010910"
            ]
          },
          "160010910": {
            "id": "160010910",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "这个嘛…",
            "nextDialogs": [
              "160010911"
            ]
          },
          "160010911": {
            "id": "160010911",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "这确实是个问题…",
            "nextDialogs": [
              "160010912"
            ]
          },
          "160010912": {
            "id": "160010912",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "与其说是补全了，更像是新写进去一些内容，真是搞不懂…",
            "nextDialogs": [
              "160010913"
            ]
          },
          "160010913": {
            "id": "160010913",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "不过，我记得墨水确实被消耗了，魔法书也没有其他提示，算是完成任务了吧？",
            "nextDialogs": [
              "160010914"
            ]
          },
          "160010914": {
            "id": "160010914",
            "speakerId": 1320,
            "speakerName": "杜林",
            "text": "目前看来一切顺利…"
          }
        }
      }
    },
    {
      "subId": "1600109",
      "subQuestName": "与杜林讨论故事里的见闻",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [],
        "dialogs": {}
      }
    },
    {
      "subId": "1600107",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "160010701"
        ],
        "dialogs": {
          "160010701": {
            "id": "160010701",
            "speakerId": 1320,
            "speakerName": "杜林",
            "text": "这支笔…",
            "nextDialogs": [
              "160010702"
            ]
          },
          "160010702": {
            "id": "160010702",
            "speakerId": 12674,
            "speakerName": "旁白",
            "text": "客人看到的正是故事女巫的笔，曾有无数动人的故事诞生于这支笔下。",
            "nextDialogs": [
              "160010703"
            ]
          },
          "160010703": {
            "id": "160010703",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "换句话说，这就是那位魔女M的笔咯？希穆兰卡的故事就是用这支笔写出来的吧？杜林肯定很熟悉。",
            "nextDialogs": [
              "160010704"
            ]
          },
          "160010704": {
            "id": "160010704",
            "speakerId": 1320,
            "speakerName": "杜林",
            "text": "我对这支笔最大的印象，就是经常被它的书写声吵醒。",
            "nextDialogs": [
              "160010705"
            ]
          },
          "160010705": {
            "id": "160010705",
            "speakerId": 1320,
            "speakerName": "杜林",
            "text": "母亲去世前的那几年，常常伏案到深夜。仿佛不这么做的话，某件事就来不及完成了。",
            "nextDialogs": [
              "160010706"
            ]
          },
          "160010706": {
            "id": "160010706",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "作家都这么辛苦吗？",
            "nextDialogs": [
              "160010707"
            ]
          },
          "160010707": {
            "id": "160010707",
            "speakerId": 1320,
            "speakerName": "杜林",
            "text": "这毕竟是母亲的遗物，还是不要乱动了，我们去看看其他物品吧。"
          }
        }
      }
    },
    {
      "subId": "1600112",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "160011201"
        ],
        "dialogs": {
          "160011201": {
            "id": "160011201",
            "speakerId": 12179,
            "speakerName": "观察",
            "text": "（一副小弹弓，看起来很适合用来扮演游侠。）"
          }
        }
      }
    },
    {
      "subId": "1600113",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "160011301"
        ],
        "dialogs": {
          "160011301": {
            "id": "160011301",
            "speakerId": 12179,
            "speakerName": "观察",
            "text": "（一本书籍，看起来很适合用来扮演学者。）"
          }
        }
      }
    },
    {
      "subId": "1600115",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "160011501"
        ],
        "dialogs": {
          "160011501": {
            "id": "160011501",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "就选它吧。",
            "nextDialogs": [
              "160011502"
            ]
          },
          "160011502": {
            "id": "160011502",
            "speakerId": 12674,
            "speakerName": "旁白",
            "text": "客人选择了游侠的弹弓作为礼物。",
            "nextDialogs": [
              "160011503"
            ]
          },
          "160011503": {
            "id": "160011503",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "游侠…杜林也喜欢探索这个世界？",
            "nextDialogs": [
              "160011504"
            ]
          },
          "160011504": {
            "id": "160011504",
            "speakerId": 1320,
            "speakerName": "杜林",
            "text": "#算是受到了{NICKNAME}和派蒙的启发吧。",
            "nextDialogs": [
              "160011505"
            ]
          },
          "160011505": {
            "id": "160011505",
            "speakerId": 1320,
            "speakerName": "杜林",
            "text": "从蒙德前往挪德卡莱的路上，我路过了很多地方，也遇到了很多人。",
            "nextDialogs": [
              "160011506"
            ]
          },
          "160011506": {
            "id": "160011506",
            "speakerId": 1320,
            "speakerName": "杜林",
            "text": "虽然他们生活的地方隔着很远的距离，但我与他们交谈时总能找到一个共同的话题，那就是你们的事迹。",
            "nextDialogs": [
              "160011507"
            ]
          },
          "160011507": {
            "id": "160011507",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "哦…嘿嘿，毕竟我们是大名鼎鼎的冒险家嘛！",
            "nextDialogs": [
              "160011508"
            ]
          },
          "160011508": {
            "id": "160011508",
            "speakerId": 1320,
            "speakerName": "杜林",
            "text": "嗯，探索世界的游侠，不就是冒险家吗？",
            "nextDialogs": [
              "160011509"
            ]
          },
          "160011509": {
            "id": "160011509",
            "speakerId": 1320,
            "speakerName": "杜林",
            "text": "我一直觉得，冒险家就是追着故事跑的人，同时他们也会留下很多自己的故事。",
            "nextDialogs": [
              "160011510"
            ]
          },
          "160011510": {
            "id": "160011510",
            "speakerId": 1320,
            "speakerName": "杜林",
            "text": "我也想成为这样的人。"
          }
        }
      }
    },
    {
      "subId": "1600116",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "160011601"
        ],
        "dialogs": {
          "160011601": {
            "id": "160011601",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "就选它吧。",
            "nextDialogs": [
              "160011602"
            ]
          },
          "160011602": {
            "id": "160011602",
            "speakerId": 12674,
            "speakerName": "旁白",
            "text": "客人选择了学者的典籍作为礼物。",
            "nextDialogs": [
              "160011603"
            ]
          },
          "160011603": {
            "id": "160011603",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "原来杜林这么好学吗？",
            "nextDialogs": [
              "160011604"
            ]
          },
          "160011604": {
            "id": "160011604",
            "speakerId": 1320,
            "speakerName": "杜林",
            "text": "我只是觉得我应该多学习一下这个世界的常识…",
            "nextDialogs": [
              "160011605"
            ]
          },
          "160011605": {
            "id": "160011605",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "为什么杜林会这么觉得？",
            "nextDialogs": [
              "160011606"
            ]
          },
          "160011606": {
            "id": "160011606",
            "speakerId": 1320,
            "speakerName": "杜林",
            "text": "嗯…派蒙知道吗？在蒙德，使用火焰捕猎鱼类是要接受惩罚的。",
            "nextDialogs": [
              "160011607"
            ]
          },
          "160011607": {
            "id": "160011607",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "…你跟可莉一起去炸鱼了？",
            "nextDialogs": [
              "160011608"
            ]
          },
          "160011608": {
            "id": "160011608",
            "speakerId": 1320,
            "speakerName": "杜林",
            "text": "我本来以为是在向可莉学习捕猎技巧，直到后来被琴团长抓到禁闭室，我才发觉事情不是我理解的那样…",
            "nextDialogs": [
              "160011609"
            ]
          },
          "160011609": {
            "id": "160011609",
            "speakerId": 1320,
            "speakerName": "杜林",
            "text": "这个世界的很多常识都和希穆兰卡不一样，我必须抓紧学习，以免再给大家制造麻烦。",
            "nextDialogs": [
              "160011610"
            ]
          },
          "160011610": {
            "id": "160011610",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "该说是常识的问题吗？"
          }
        }
      }
    },
    {
      "subId": "1600117",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "160011701"
        ],
        "dialogs": {
          "160011701": {
            "id": "160011701",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "嗯？另一个杜林？",
            "nextDialogs": [
              "160011702"
            ]
          },
          "160011702": {
            "id": "160011702",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "是故事中的杜林吧。",
            "nextDialogs": [
              "160011703"
            ]
          },
          "160011703": {
            "id": "160011703",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "你好啊，小杜林！",
            "nextDialogs": [
              "160011704"
            ]
          },
          "160011704": {
            "id": "160011704",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "…没有反应，是睡得太熟了吗？这可是他的庆生会啊…",
            "nextDialogs": [
              "160011705"
            ]
          },
          "160011705": {
            "id": "160011705",
            "speakerId": 12674,
            "speakerName": "旁白",
            "text": "龙孩子诞生自故事女巫笔下的魔法，每当笔尖在书页上划动，龙孩子就会快乐地玩耍。",
            "nextDialogs": [
              "160011706"
            ]
          },
          "160011706": {
            "id": "160011706",
            "speakerId": 12674,
            "speakerName": "旁白",
            "text": "但是故事女巫并非时时都有执笔书写的闲暇，这次参加女巫之间的聚会，她不得不暂时放下手中的笔。",
            "nextDialogs": [
              "160011707"
            ]
          },
          "160011707": {
            "id": "160011707",
            "speakerId": 12674,
            "speakerName": "旁白",
            "text": "「龙孩子甜甜地睡去了」，这是她停笔前在书页上留下的话。",
            "nextDialogs": [
              "160011710"
            ]
          },
          "160011710": {
            "id": "160011710",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "这种解释有些敷衍哦。",
            "nextDialogs": [
              "160011711"
            ]
          },
          "160011711": {
            "id": "160011711",
            "speakerId": 1320,
            "speakerName": "杜林",
            "text": "说起来有些奇怪，我印象中并没有参加过魔女阿姨们的聚会，这个庆生会是什么时候…",
            "nextDialogs": [
              "160011712"
            ]
          },
          "160011712": {
            "id": "160011712",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "恐怕你当时也在呼呼大睡，所以不记得。"
          }
        }
      }
    },
    {
      "subId": "1600119",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "160011901"
        ],
        "dialogs": {
          "160011901": {
            "id": "160011901",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "再看看别的吧。"
          }
        }
      }
    },
    {
      "subId": "1600199",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "160019903"
        ],
        "dialogs": {
          "160019903": {
            "id": "160019903",
            "speakerId": 12674,
            "speakerName": "旁白",
            "text": "女巫们继续畅谈，似乎不想理会这几位没有准备礼物的客人。",
            "nextDialogs": [
              "160019904"
            ]
          },
          "160019904": {
            "id": "160019904",
            "speakerId": 12674,
            "speakerName": "旁白",
            "text": "客人似乎十分犹豫，这个礼物对于小龙来说十分重要，慎重考虑或许也不是坏事。",
            "nextDialogs": [
              "160019905"
            ]
          },
          "160019905": {
            "id": "160019905",
            "speakerId": 12674,
            "speakerName": "旁白",
            "text": "书写故事的笔没有在前方留下痕迹，你们发现自己无法前进。",
            "nextDialogs": [
              "160019906"
            ]
          },
          "160019906": {
            "id": "160019906",
            "speakerId": 1010,
            "speakerName": "<UNKNOWN>",
            "text": "乐声中的诗与歌，就是这个故事最初的绿芽。",
            "nextDialogs": [
              "160019907"
            ]
          },
          "160019907": {
            "id": "160019907",
            "speakerId": 1010,
            "speakerName": "<UNKNOWN>",
            "text": "女巫们准备好了各自的礼物，那是这宇宙间的三重奇迹。"
          }
        }
      }
    }
  ]
}
    {
      "subId": "7413609",
      "subQuestName": "与纳克对话",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "741360901"
        ],
        "dialogs": {
          "741360901": {
            "id": "741360901",
            "speakerId": 1004,
            "speakerName": "纳克",
            "text": "科学院的走狗！舒瓦瑟尔和雷蒙多给了你们多少钱！",
            "nextDialogs": [
              "741360904"
            ]
          },
          "741360904": {
            "id": "741360904",
            "speakerId": 1004,
            "speakerName": "纳克",
            "text": "你…你…听我的，放开我，我的这台「场力发生装置」已经快完成了。",
            "nextDialogs": [
              "741360905"
            ]
          },
          "741360905": {
            "id": "741360905",
            "speakerId": 1004,
            "speakerName": "纳克",
            "text": "只要我能把始基动能核心和它联调成功，那…那我就是最伟大的动能工程师！",
            "nextDialogs": [
              "741360906"
            ]
          },
          "741360906": {
            "id": "741360906",
            "speakerId": 1002,
            "speakerName": "菲希里耶",
            "text": "…拿着别人的成果，还要成为最伟大的工程师。真是够无耻的。",
            "nextDialogs": [
              "741360907"
            ]
          },
          "741360907": {
            "id": "741360907",
            "speakerId": 1002,
            "speakerName": "菲希里耶",
            "text": "我总算知道，为什么当初艾德温前…先生，一直不愿意让你参与核心研究了。",
            "nextDialogs": [
              "741360908"
            ]
          },
          "741360908": {
            "id": "741360908",
            "speakerId": 1004,
            "speakerName": "纳克",
            "text": "艾德温根本不明白这东西的用处！你也是科学院的人…你知道这东西的价值。",
            "nextDialogs": [
              "741360909"
            ]
          },
          "741360909": {
            "id": "741360909",
            "speakerId": 1004,
            "speakerName": "纳克",
            "text": "帮帮我，我可以…可以和你一起开发，到时候，没有人能比我们的名气更高！",
            "nextDialogs": [
              "741360910"
            ]
          },
          "741360910": {
            "id": "741360910",
            "speakerId": 1004,
            "speakerName": "纳克",
            "text": "什么艾德温、雷蒙多、舒瓦瑟尔…没人能再压我们一头！"
          }
        }
      }
    },
    {
      "subId": "7413610",
      "subQuestName": "回去与勒马克汇合",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "741361001"
        ],
        "dialogs": {
          "741361001": {
            "id": "741361001",
            "speakerId": 1004,
            "speakerName": "纳克",
            "text": "艾德温…我就知道！是你把他们引过去…你嫉妒我！担心我的研究成果超越你！",
            "nextDialogs": [
              "741361002"
            ]
          },
          "741361002": {
            "id": "741361002",
            "speakerId": 1005,
            "speakerName": "艾德温·伊斯丁豪斯",
            "text": "是啊，我真嫉妒你这副无知又不自知的样子，怪不得你之前在科学院里活得那么好。",
            "nextDialogs": [
              "741361003"
            ]
          },
          "741361003": {
            "id": "741361003",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "要是舒瓦瑟尔看见这个场景，一定会昏过去吧…",
            "nextDialogs": [
              "741361006"
            ]
          },
          "741361006": {
            "id": "741361006",
            "speakerId": 1005,
            "speakerName": "艾德温·伊斯丁豪斯",
            "text": "你就跟着他们回科学院认错吧，我要继续去研究了…你没弄坏我的研究设备吧？"
          }
        }
      }
    },
    {
      "subId": "7413611",
      "subQuestName": "向枫丹科学院回报",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "741361101"
        ],
        "dialogs": {
          "741361101": {
            "id": "741361101",
            "speakerId": 1006,
            "speakerName": "舒瓦瑟尔",
            "text": "#菲希里耶小姐！{NICKNAME}，你们回来了！事情一定都办妥…",
            "nextDialogs": [
              "741361102"
            ]
          },
          "741361102": {
            "id": "741361102",
            "speakerId": 1006,
            "speakerName": "舒瓦瑟尔",
            "text": "喔，不…",
            "nextDialogs": [
              "741361103"
            ]
          },
          "741361103": {
            "id": "741361103",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "呜哇！舒瓦瑟尔先生真的要昏过去啦！",
            "nextDialogs": [
              "741361104"
            ]
          },
          "741361104": {
            "id": "741361104",
            "speakerId": 1005,
            "speakerName": "艾德温·伊斯丁豪斯",
            "text": "没想到你又回科学院了，舒瓦瑟尔。我还以为你这辈子就只能和公章打交道了。",
            "nextDialogs": [
              "741361105"
            ]
          },
          "741361105": {
            "id": "741361105",
            "speakerId": 1006,
            "speakerName": "舒瓦瑟尔",
            "text": "这…这不可能！天哪！",
            "nextDialogs": [
              "741361106"
            ]
          },
          "741361106": {
            "id": "741361106",
            "speakerId": 1005,
            "speakerName": "艾德温·伊斯丁豪斯",
            "text": "雷蒙多，接任我工作的感觉如何，有什么值得向我汇报的工作吗？",
            "nextDialogs": [
              "741361107"
            ]
          },
          "741361107": {
            "id": "741361107",
            "speakerId": 1007,
            "speakerName": "雷蒙多",
            "text": "…真是一场美妙的再会啊，艾德温先生。",
            "nextDialogs": [
              "741361108"
            ]
          },
          "741361108": {
            "id": "741361108",
            "speakerId": 1005,
            "speakerName": "艾德温·伊斯丁豪斯",
            "text": "哈！瞧瞧这周围，你确实很适合做打扫工作。",
            "nextDialogs": [
              "741361109"
            ]
          },
          "741361109": {
            "id": "741361109",
            "speakerId": 1004,
            "speakerName": "纳克",
            "text": "…哼。他打扫得也不干净。",
            "nextDialogs": [
              "741361110"
            ]
          },
          "741361110": {
            "id": "741361110",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "主要是没把你打扫出去。",
            "nextDialogs": [
              "741361111"
            ]
          },
          "741361111": {
            "id": "741361111",
            "speakerId": 1007,
            "speakerName": "雷蒙多",
            "text": "#非常感谢你们将这两个人带回来，荣誉高级研究员{NICKNAME}，还有菲希里耶小姐。",
            "nextDialogs": [
              "741361112"
            ]
          },
          "741361112": {
            "id": "741361112",
            "speakerId": 1007,
            "speakerName": "雷蒙多",
            "text": "枫丹科学院的霉运和动乱，将在今天彻底画上休止符。",
            "nextDialogs": [
              "741361113"
            ]
          },
          "741361113": {
            "id": "741361113",
            "speakerId": 1005,
            "speakerName": "艾德温·伊斯丁豪斯",
            "text": "哈哈哈，好啊，枫丹科学院将陷入一片死气沉沉的寂静，从此再无灵感跃动。",
            "nextDialogs": [
              "741361114"
            ]
          },
          "741361114": {
            "id": "741361114",
            "speakerId": 1007,
            "speakerName": "雷蒙多",
            "text": "你已经带着枫丹科学院内所有的灵感跃动得够精彩了，也该让一切平静下来了。",
            "nextDialogs": [
              "741361115"
            ]
          },
          "741361115": {
            "id": "741361115",
            "speakerId": 1005,
            "speakerName": "艾德温·伊斯丁豪斯",
            "text": "雷蒙多·哈文博特，你根本就不懂研究，领导不了枫丹动能工程科学院。",
            "nextDialogs": [
              "741361116"
            ]
          },
          "741361116": {
            "id": "741361116",
            "speakerId": 1007,
            "speakerName": "雷蒙多",
            "text": "但我懂如何在枫丹动能工程科学院里正确且正常地工作，艾德温·伊斯丁豪斯。",
            "nextDialogs": [
              "741361117"
            ]
          },
          "741361117": {
            "id": "741361117",
            "speakerId": 1007,
            "speakerName": "雷蒙多",
            "text": "你现在要做的，就是离研究和始基矿远一些，这样对所有人都好。",
            "nextDialogs": [
              "741361118"
            ]
          },
          "741361118": {
            "id": "741361118",
            "speakerId": 1008,
            "speakerName": "Black Screen",
            "text": "在一段时间后，执律庭的人赶到并带走了纳克与艾德温。谢天谢地，他们总算彻底离开枫丹科学院了…",
            "nextDialogs": [
              "741361119"
            ]
          },
          "741361119": {
            "id": "741361119",
            "speakerId": 1006,
            "speakerName": "舒瓦瑟尔",
            "text": "谢天谢地，我的噩梦总算彻彻底底地醒了…",
            "nextDialogs": [
              "741361120"
            ]
          },
          "741361120": {
            "id": "741361120",
            "speakerId": 1006,
            "speakerName": "舒瓦瑟尔",
            "text": "肖西韦尔先生和勒马克先生，对吧？我已经听人提起过你们对我院工作的协助。相应的谢礼正在安排，请你们在这里稍作休憩。",
            "nextDialogs": [
              "741361121"
            ]
          },
          "741361121": {
            "id": "741361121",
            "speakerId": 1001,
            "speakerName": "肖西韦尔",
            "text": "哈哈哈，我还真没想到，我这种人也能和科学院搭上关系。",
            "nextDialogs": [
              "741361122"
            ]
          },
          "741361122": {
            "id": "741361122",
            "speakerId": 1006,
            "speakerName": "舒瓦瑟尔",
            "text": "别这么说自己！亲爱的先生，您既真诚，又有热心肠，绝对是个好人！说不定以后我们还会请您来帮忙啊。",
            "nextDialogs": [
              "741361123"
            ]
          },
          "741361123": {
            "id": "741361123",
            "speakerId": 1006,
            "speakerName": "舒瓦瑟尔",
            "text": "而您…荣誉高级研究员，您又帮了科学院一个大忙，到底该如何感谢您呢？",
            "nextDialogs": [
              "741361128",
              "741361126"
            ]
          },
          "741361128": {
            "id": "741361128",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "欸，说起来…菲希里耶小姐呢？",
            "nextDialogs": [
              "741361129"
            ]
          },
          "741361129": {
            "id": "741361129",
            "speakerId": 1007,
            "speakerName": "雷蒙多",
            "text": "…先让这位小姐自己冷静一下吧。看来，她幻想中的艾德温·伊斯丁豪斯，总算破灭了。",
            "nextDialogs": [
              "741361130"
            ]
          },
          "741361130": {
            "id": "741361130",
            "speakerId": 1007,
            "speakerName": "雷蒙多",
            "text": "艾德温和纳克也需要冷静一下…希望他们早日认清自己。",
            "nextDialogs": [
              "741361131"
            ]
          },
          "741361131": {
            "id": "741361131",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "他们会在梅洛彼得堡待一辈子吗？",
            "nextDialogs": [
              "741361132"
            ]
          },
          "741361132": {
            "id": "741361132",
            "speakerId": 1007,
            "speakerName": "雷蒙多",
            "text": "就他们的危险性来说，我希望他们永远也不要离开那里。",
            "nextDialogs": [
              "741361133"
            ]
          },
          "741361133": {
            "id": "741361133",
            "speakerId": 1007,
            "speakerName": "雷蒙多",
            "text": "但就枫丹科学院如今的情况来说…唉，希望我不要遇见那种非启用他们不可的事务…",
            "nextDialogs": [
              "741361134"
            ]
          },
          "741361134": {
            "id": "741361134",
            "speakerId": 1007,
            "speakerName": "雷蒙多",
            "text": "再次代表枫丹科学院感谢您，荣誉高级研究员。如果你还有什么想问的…我愿意再和您聊聊。"
          },
          "741361126": {
            "id": "741361126",
            "speakerId": 1006,
            "speakerName": "舒瓦瑟尔",
            "text": "唔，理论上您的这个头衔就已经是顶级了…但我可以尝试为您申请一下特别头衔。",
            "nextDialogs": [
              "741361127"
            ]
          },
          "741361127": {
            "id": "741361127",
            "speakerId": 1006,
            "speakerName": "舒瓦瑟尔",
            "text": "比如，首席荣誉高级研究员？哈哈哈哈！"
          }
        }
      }

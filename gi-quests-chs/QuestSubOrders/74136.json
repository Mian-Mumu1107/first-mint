    {
      "subId": "7413604",
      "subQuestName": "与肖西韦尔对话",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "741360401"
        ],
        "dialogs": {
          "741360401": {
            "id": "741360401",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "原来他之前一直重复着「五」，是为了告诉我们解谜的方式啊…",
            "nextDialogs": [
              "741360402"
            ]
          },
          "741360402": {
            "id": "741360402",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "明明直接告诉我们就好了，为什么要这么别扭呢？",
            "nextDialogs": [
              "741360403"
            ]
          },
          "741360403": {
            "id": "741360403",
            "speakerId": 1001,
            "speakerName": "肖西韦尔",
            "text": "哼，谁知道这家伙在打什么鬼主意…不过，他好像一直在引着我们去找纳克。",
            "nextDialogs": [
              "741360404"
            ]
          },
          "741360404": {
            "id": "741360404",
            "speakerId": 1001,
            "speakerName": "肖西韦尔",
            "text": "这些潜水服，就放在那间屋子旁边，简直就像是专门为我们准备的。",
            "nextDialogs": [
              "741360407"
            ]
          },
          "741360407": {
            "id": "741360407",
            "speakerId": 1002,
            "speakerName": "菲希里耶",
            "text": "没有研究价值…我…我花了那么多心思…",
            "nextDialogs": [
              "741360408"
            ]
          },
          "741360408": {
            "id": "741360408",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "菲希里耶小姐…碎碎念了一路呢…",
            "nextDialogs": [
              "741360409"
            ]
          },
          "741360409": {
            "id": "741360409",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "#不过…{NICKNAME}，你有没有一种被人盯着的感觉？我、我总觉得背后毛毛的…",
            "nextDialogs": [
              "741360410"
            ]
          },
          "741360410": {
            "id": "741360410",
            "speakerId": 1001,
            "speakerName": "肖西韦尔",
            "text": "…我走第一个，继续往里面探一探吧。"
          }
        }
      }
    },
    {
      "subId": "7413605",
      "subQuestName": "继续寻找纳克",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [],
        "dialogs": {}
      }
    },
    {
      "subId": "7413606",
      "subQuestName": "与肖西韦尔对话",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "741360601"
        ],
        "dialogs": {
          "741360601": {
            "id": "741360601",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "好大一片空地，里面…什么也没有。我们不会扑了个空吧？",
            "nextDialogs": [
              "741360602"
            ]
          },
          "741360602": {
            "id": "741360602",
            "speakerId": 1001,
            "speakerName": "肖西韦尔",
            "text": "这周围的植物被特意清理过，修剪的痕迹还很新。",
            "nextDialogs": [
              "741360603"
            ]
          },
          "741360603": {
            "id": "741360603",
            "speakerId": 1002,
            "speakerName": "菲希里耶",
            "text": "…亏我还专门为他趟这摊浑水…",
            "nextDialogs": [
              "741360604"
            ]
          },
          "741360604": {
            "id": "741360604",
            "speakerId": 1001,
            "speakerName": "肖西韦尔",
            "text": "总之，我先一个人下去看看，你们陪着科学院小姐，如果情势太坏…就赶紧带她走。",
            "nextDialogs": [
              "741360605"
            ]
          },
          "741360605": {
            "id": "741360605",
            "speakerId": 1001,
            "speakerName": "肖西韦尔",
            "text": "但这里什么东西也没有，情势再坏应该也坏不到哪里…",
            "nextDialogs": [
              "741360606"
            ]
          },
          "741360606": {
            "id": "741360606",
            "speakerId": 1003,
            "speakerName": "？？？",
            "text": "吱——嘎嘎——",
            "nextDialogs": [
              "741360607"
            ]
          },
          "741360607": {
            "id": "741360607",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "呜哇！小心那边！有东西冲过来了！"
          }
        }
      }
    },
    {

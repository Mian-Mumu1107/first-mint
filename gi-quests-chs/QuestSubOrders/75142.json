  },
  "subQuests": [
    {
      "subId": "7514205",
      "subQuestName": "(test)初见对话环$HIDDEN",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "751420501"
        ],
        "dialogs": {
          "751420501": {
            "id": "751420501",
            "speakerId": 1000,
            "speakerName": "度尼娅",
            "text": "圣山大人因为肚子不舒服，每天都在往外吐那么多东西，你又不是没见过！现在出去玩太危险了！",
            "nextDialogs": [
              "751420502"
            ]
          },
          "751420502": {
            "id": "751420502",
            "speakerId": 1001,
            "speakerName": "杜兹厄",
            "text": "以前叔叔给我讲的故事里都说了，每次遇到火山不舒服的时候，只要大伙用力拍两下就好了…只可惜我的手太小了…",
            "nextDialogs": [
              "751420503"
            ]
          },
          "751420503": {
            "id": "751420503",
            "speakerId": 1001,
            "speakerName": "杜兹厄",
            "text": "但是那些大人们肯定能拍得动，就是不想我们到部族外去玩，所以才拖着不去拍。",
            "nextDialogs": [
              "751420504"
            ]
          },
          "751420504": {
            "id": "751420504",
            "speakerId": 1000,
            "speakerName": "度尼娅",
            "text": "哈哈，杜兹厄原来是这样想的呀！哼哼，可是要让圣山大人恢复正常，就得…至少得部族里所有的大人一起拍才行。",
            "nextDialogs": [
              "751420505"
            ]
          },
          "751420505": {
            "id": "751420505",
            "speakerId": 1000,
            "speakerName": "度尼娅",
            "text": "可大人们都是很忙的，就比如瓦雷莎姐姐，还得照顾果园呢。得等到大家都有空的时候，一起拍拍圣山大人呀。",
            "nextDialogs": [
              "751420506"
            ]
          },
          "751420506": {
            "id": "751420506",
            "speakerId": 1001,
            "speakerName": "杜兹厄",
            "text": "你说的也不是没有道理…唉，得等大人们都有空呀…",
            "nextDialogs": [
              "751420507"
            ]
          },
          "751420507": {
            "id": "751420507",
            "speakerId": 1000,
            "speakerName": "度尼娅",
            "text": "嗯嗯，所以在那之前，我们就遵守大人们的禁足令，在圣山大人活动这么激烈的时期好好待在部族里吧…",
            "nextDialogs": [
              "751420508"
            ]
          },
          "751420508": {
            "id": "751420508",
            "speakerId": 1001,
            "speakerName": "杜兹厄",
            "text": "…好吧。",
            "nextDialogs": [
              "751420509"
            ]
          },
          "751420509": {
            "id": "751420509",
            "speakerId": 1002,
            "speakerName": "派蒙",
            "text": "你们在这说什么呀，什么拍不拍的？",
            "nextDialogs": [
              "751420510"
            ]
          },
          "751420510": {
            "id": "751420510",
            "speakerId": 1001,
            "speakerName": "杜兹厄",
            "text": "我们在说…啊…",
            "nextDialogs": [
              "751420511"
            ]
          },
          "751420511": {
            "id": "751420511",
            "speakerId": 1001,
            "speakerName": "杜兹厄",
            "text": "我们在说不能被奇怪的异邦人听进耳朵里的部族秘密。",
            "nextDialogs": [
              "751420512"
            ]
          },
          "751420512": {
            "id": "751420512",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "原来手拍火山是部族秘密啊…",
            "nextDialogs": [
              "751420513"
            ]
          },
          "751420513": {
            "id": "751420513",
            "speakerId": 1001,
            "speakerName": "杜兹厄",
            "text": "什、什么呀，你们不是全听进去了吗。",
            "nextDialogs": [
              "751420514"
            ]
          },
          "751420514": {
            "id": "751420514",
            "speakerId": 1000,
            "speakerName": "度尼娅",
            "text": "是杜兹厄你讲得太大声了啦，下次要说秘密，就得把嘴巴贴到我耳朵边上说哦。",
            "nextDialogs": [
              "751420515"
            ]
          },
          "751420515": {
            "id": "751420515",
            "speakerId": 1001,
            "speakerName": "杜兹厄",
            "text": "好哦…咦，可是那样不会靠、靠得太近了吗？！",
            "nextDialogs": [
              "751420516"
            ]
          },
          "751420516": {
            "id": "751420516",
            "speakerId": 1000,
            "speakerName": "度尼娅",
            "text": "哈哈，好啦。嗯…异邦来的客人，我是度尼娅，这个家伙是笨蛋杜兹厄…",
            "nextDialogs": [
              "751420517"
            ]
          },
          "751420517": {
            "id": "751420517",
            "speakerId": 1001,
            "speakerName": "杜兹厄",
            "text": "又叫我笨蛋…",
            "nextDialogs": [
              "751420518"
            ]
          },
          "751420518": {
            "id": "751420518",
            "speakerId": 1000,
            "speakerName": "度尼娅",
            "text": "欢迎你们来到沃陆之邦，还有这边的小嵴锋龙…奇怪，难道是因为圣山大人的状态不对吗…部族里应该有禁外龙的符石…",
            "nextDialogs": [
              "751420519"
            ]
          },
          "751420519": {
            "id": "751420519",
            "speakerId": 1001,
            "speakerName": "杜兹厄",
            "text": "哼哼，这就说明符石也该被拍一拍啦！",
            "nextDialogs": [
              "751420520"
            ]
          },
          "751420520": {
            "id": "751420520",
            "speakerId": 1000,
            "speakerName": "度尼娅",
            "text": "现在比较需要被拍拍的是杜兹厄的脑袋瓜…唉，幸好你们看上去不是什么坏人呢…",
            "nextDialogs": [
              "751420521"
            ]
          },
          "751420521": {
            "id": "751420521",
            "speakerId": 1000,
            "speakerName": "度尼娅",
            "text": "所以异邦来的客人是为了什么来的呀…",
            "nextDialogs": [
              "751420522"
            ]
          },
          "751420522": {
            "id": "751420522",
            "speakerId": 1003,
            "speakerName": "Black Screen",
            "text": "向度尼娅和杜兹厄做了自我介绍…\\n并且说明了想要进入圣山的目的…",
            "nextDialogs": [
              "751420523"
            ]
          },
          "751420523": {
            "id": "751420523",
            "speakerId": 1000,
            "speakerName": "度尼娅",
            "text": "想要「进入圣山」啊，那可不是容易的事呢…大人们还告诫我们，圣山是危险的地方，所以不能轻易进入…",
            "nextDialogs": [
              "751420524"
            ]
          },
          "751420524": {
            "id": "751420524",
            "speakerId": 1000,
            "speakerName": "度尼娅",
            "text": "不过，异邦来的客人想要进入圣山内，想必也有自己的理由吧…",
            "nextDialogs": [
              "751420525"
            ]
          },
          "751420525": {
            "id": "751420525",
            "speakerId": 1000,
            "speakerName": "度尼娅",
            "text": "嗯…我倒是知道有人曾经进过圣山…",
            "nextDialogs": [
              "751420526"
            ]
          },
          "751420526": {
            "id": "751420526",
            "speakerId": 1001,
            "speakerName": "杜兹厄",
            "text": "我、我也知道呢！",
            "nextDialogs": [
              "751420527"
            ]
          },
          "751420527": {
            "id": "751420527",
            "speakerId": 1002,
            "speakerName": "派蒙",
            "text": "咦，那个「圣山」不是对于部族人来说很重要的地方吗？这样随便告诉我们真的好吗？",
            "nextDialogs": [
              "751420528"
            ]
          },
          "751420528": {
            "id": "751420528",
            "speakerId": 1000,
            "speakerName": "度尼娅",
            "text": "「圣山」的称呼是很久很久以前的织卷留下来的…对我们来说，还是「圣火竞技场」要更「圣」一筹呢。",
            "nextDialogs": [
              "751420529"
            ]
          },
          "751420529": {
            "id": "751420529",
            "speakerId": 1000,
            "speakerName": "度尼娅",
            "text": "我们被禁止进入只是因为里面比较危险啦。",
            "nextDialogs": [
              "751420530"
            ]
          },
          "751420530": {
            "id": "751420530",
            "speakerId": 1001,
            "speakerName": "杜兹厄",
            "text": "而且，以前「话事处」也组建过探险队进火山里…嘿嘿，等我长大了，我也要进去玩！",
            "nextDialogs": [
              "751420531"
            ]
          },
          "751420531": {
            "id": "751420531",
            "speakerId": 1000,
            "speakerName": "度尼娅",
            "text": "说了多少次，那是很危险的事啦…",
            "nextDialogs": [
              "751420532"
            ]
          },
          "751420532": {
            "id": "751420532",
            "speakerId": 1000,
            "speakerName": "度尼娅",
            "text": "嗯…具体的事我也不太清楚，不过，如果你愿意的话可以找<color=#00E1FFFF>恩波索爷爷</color>，他要是能帮上你的忙，应该也会很高兴的。",
            "nextDialogs": [
              "751420533"
            ]
          },
          "751420533": {
            "id": "751420533",
            "speakerId": 1001,
            "speakerName": "杜兹厄",
            "text": "「无所事事的恩波索爷爷」吗…找他还不如去找<color=#00E1FFFF>基莫西</color>呢，嘿嘿，基莫西是我叔叔，以前也曾经参加过冒险队…",
            "nextDialogs": [
              "751420534"
            ]
          },
          "751420534": {
            "id": "751420534",
            "speakerId": 1000,
            "speakerName": "度尼娅",
            "text": "不许说恩波索爷爷无所事事…唔，但是，他们现在一个在<color=#00E1FFFF>山南的挖掘地</color>，一个在<color=#00E1FFFF>村子西边的喷发遗迹</color>那边…",
            "nextDialogs": [
              "751420535"
            ]
          },
          "751420535": {
            "id": "751420535",
            "speakerId": 1000,
            "speakerName": "度尼娅",
            "text": "要是能够帮你们带路就好了，只不过现在圣山大人还在「喷吐」的时期…我们不能带你们去…",
            "nextDialogs": [
              "751420536"
            ]
          },
          "751420536": {
            "id": "751420536",
            "speakerId": 1002,
            "speakerName": "派蒙",
            "text": "没关系，告诉我们这些就已经足够啦！",
            "nextDialogs": [
              "751420537"
            ]
          },
          "751420537": {
            "id": "751420537",
            "speakerId": 1002,
            "speakerName": "派蒙",
            "text": "#{REALNAME[ID(2)|SHOWHOST(true)]}！回来啦，我们要出发了！",
            "nextDialogs": [
              "751420538"
            ]
          },
          "751420538": {
            "id": "751420538",
            "speakerId": 1004,
            "speakerName": "#{REALNAME[ID(2)|SHOWHOST(true)]}",
            "text": "呀！",
            "nextDialogs": [
              "751420539"
            ]
          },
          "751420539": {
            "id": "751420539",
            "speakerId": 1000,
            "speakerName": "度尼娅",
            "text": "嘿嘿，真是可爱的家伙，尾巴上绑的丝巾也很漂亮。等圣山大人睡着了，到时候一起去部族外面玩吧！",
            "nextDialogs": [
              "751420540"
            ]
          },
          "751420540": {
            "id": "751420540",
            "speakerId": 1002,
            "speakerName": "派蒙",
            "text": "好哦，下次我们再一起玩！"
          }
        }
      }
    },
    {
      "subId": "7514201",
      "subQuestName": "(test)任务npc对话block$HIDDEN",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "751420101"
        ],
        "dialogs": {
          "751420101": {
            "id": "751420101",
            "speakerId": 1000,
            "speakerName": "度尼娅",
            "text": "哎呀，异邦的英雄，还有什么事吗？",
            "nextDialogs": [
              "751420102"
            ]
          },
          "751420102": {
            "id": "751420102",
            "speakerId": 1001,
            "speakerName": "杜兹厄",
            "text": "一定是找不到「挖掘地」和「喷发遗迹」，既然如此，我们也只能稍稍违背大人们的禁令…",
            "nextDialogs": [
              "751420103"
            ]
          },
          "751420103": {
            "id": "751420103",
            "speakerId": 1000,
            "speakerName": "度尼娅",
            "text": "……",
            "nextDialogs": [
              "751420104"
            ]
          },
          "751420104": {
            "id": "751420104",
            "speakerId": 1001,
            "speakerName": "杜兹厄",
            "text": "呜，好吧…我不会出部族的…",
            "nextDialogs": [
              "751420105"
            ]
          },
          "751420105": {
            "id": "751420105",
            "speakerId": 1000,
            "speakerName": "度尼娅",
            "text": "#那么，{NICKNAME}…有什么想问的吗？"
          }
        }
      }
    },
    {
      "subId": "7514202",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "751420201"
        ],
        "dialogs": {
          "751420201": {
            "id": "751420201",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "关于「挖掘地」…",
            "nextDialogs": [
              "751420202"
            ]
          },
          "751420202": {
            "id": "751420202",
            "speakerId": 1000,
            "speakerName": "度尼娅",
            "text": "嗯，其实挖掘地应该被称为「秘源遗迹的挖掘地」，就在圣山的南侧，有一大片遗迹…",
            "nextDialogs": [
              "751420203"
            ]
          },
          "751420203": {
            "id": "751420203",
            "speakerId": 1000,
            "speakerName": "度尼娅",
            "text": "据说也是很久很久以前的巨龙留下来的呢，为了防止有不怀好意的盗宝团偷偷发掘遗迹，恩波索爷爷每天会在那边巡逻…",
            "nextDialogs": [
              "751420204"
            ]
          },
          "751420204": {
            "id": "751420204",
            "speakerId": 1000,
            "speakerName": "度尼娅",
            "text": "从前恩波索爷爷就对这些遗迹啊，遗物什么的特别上心，还加入过龙遗物研究协会，每次都会和我们说过去的故事。",
            "nextDialogs": [
              "751420205"
            ]
          },
          "751420205": {
            "id": "751420205",
            "speakerId": 1001,
            "speakerName": "杜兹厄",
            "text": "不过，恩波索爷爷讲故事的水平好差，而且都很枯燥无聊，什么从遗迹的什么纹路上就能看出什么图腾「葱白」…",
            "nextDialogs": [
              "751420206"
            ]
          },
          "751420206": {
            "id": "751420206",
            "speakerId": 1000,
            "speakerName": "度尼娅",
            "text": "是图腾「崇拜」啦…因为恩波索爷爷比起叙事人更像是个考古家嘛…",
            "nextDialogs": [
              "751420207"
            ]
          },
          "751420207": {
            "id": "751420207",
            "speakerId": 1000,
            "speakerName": "度尼娅",
            "text": "据说，恩波索爷爷以前也曾经探索过火山内，说不定能帮上你们的忙呢！"
          }
        }
      }
    },
    {
      "subId": "7514203",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "751420301"
        ],
        "dialogs": {
          "751420301": {
            "id": "751420301",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "关于「喷发遗迹」…",
            "nextDialogs": [
              "751420302"
            ]
          },
          "751420302": {
            "id": "751420302",
            "speakerId": 1001,
            "speakerName": "杜兹厄",
            "text": "哦哦，你想问「喷发遗迹」的事啊！这个我知道！",
            "nextDialogs": [
              "751420303"
            ]
          },
          "751420303": {
            "id": "751420303",
            "speakerId": 1001,
            "speakerName": "杜兹厄",
            "text": "很久很久以前…那个时候，纳塔还是一片安静祥和的乐土…",
            "nextDialogs": [
              "751420304"
            ]
          },
          "751420304": {
            "id": "751420304",
            "speakerId": 1000,
            "speakerName": "度尼娅",
            "text": "啊，其实就是五百年前，纳塔受到深渊侵蚀最严重的时候，从火山里整个喷发出来的遗迹，很完整呢！",
            "nextDialogs": [
              "751420305"
            ]
          },
          "751420305": {
            "id": "751420305",
            "speakerId": 1001,
            "speakerName": "杜兹厄",
            "text": "啊…什么嘛，度尼娅，为什么要抢我的话！",
            "nextDialogs": [
              "751420306"
            ]
          },
          "751420306": {
            "id": "751420306",
            "speakerId": 1000,
            "speakerName": "度尼娅",
            "text": "因为每次杜兹厄说起喷发遗迹就得从很久很久之前开始说起，太啰嗦了。",
            "nextDialogs": [
              "751420307"
            ]
          },
          "751420307": {
            "id": "751420307",
            "speakerId": 1001,
            "speakerName": "杜兹厄",
            "text": "呜…这些都是基莫西叔叔和我说的啦，基莫西叔叔也是之前「话事处」组建探索团的成员之一呢！",
            "nextDialogs": [
              "751420308"
            ]
          },
          "751420308": {
            "id": "751420308",
            "speakerId": 1001,
            "speakerName": "杜兹厄",
            "text": "不过听说最近「喷发遗迹」附近又有些深渊的痕迹，不知道基莫西叔叔还好不好…",
            "nextDialogs": [
              "751420309"
            ]
          },
          "751420309": {
            "id": "751420309",
            "speakerId": 1001,
            "speakerName": "杜兹厄",
            "text": "如果你去「喷发遗迹」的话，能不能帮我和基莫西叔叔问好呢…"
          }
        }
      }
    },
    {
      "subId": "7514204",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "751420401"
        ],
        "dialogs": {
          "751420401": {
            "id": "751420401",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "不，没什么事了。",
            "nextDialogs": [
              "751420402"
            ]
          },
          "751420402": {
            "id": "751420402",
            "speakerId": 1000,
            "speakerName": "度尼娅",
            "text": "是嘛，那就祝你的旅途顺利啦！",
            "nextDialogs": [
              "751420403"
            ]
          },
          "751420403": {
            "id": "751420403",
            "speakerId": 1001,
            "speakerName": "杜兹厄",
            "text": "嘿嘿，要常来玩哦！"
          }
        }
      }
    },
    {
      "subId": "7514206",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "751420601"
        ],
        "dialogs": {
          "751420601": {
            "id": "751420601",
            "speakerId": 1000,
            "speakerName": "度尼娅",
            "text": "#那么，{NICKNAME}…有什么想问的吗？"
          }
        }
      }
    },
    {
      "subId": "7514207",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "751420701"
        ],
        "dialogs": {
          "751420701": {
            "id": "751420701",
            "speakerId": 1000,
            "speakerName": "度尼娅",
            "text": "圣山大人因为肚子不舒服，每天都在往外吐那么多东西，你又不是没见过！现在出去玩太危险了！",
            "nextDialogs": [
              "751420702"
            ]
          },
          "751420702": {
            "id": "751420702",
            "speakerId": 1001,
            "speakerName": "杜兹厄",
            "text": "以前叔叔给我讲的故事里都说了，每次遇到火山不舒服的时候，只要大伙用力拍两下就好了…只可惜我的手太小了…",
            "nextDialogs": [
              "751420703"
            ]
          },
          "751420703": {
            "id": "751420703",
            "speakerId": 1001,
            "speakerName": "杜兹厄",
            "text": "但是那些大人们肯定能拍得动，就是不想我们到部族外去玩，所以才拖着不去拍。",
            "nextDialogs": [
              "751420704"
            ]
          },
          "751420704": {
            "id": "751420704",
            "speakerId": 1000,
            "speakerName": "度尼娅",
            "text": "哈哈，杜兹厄原来是这样想的呀！哼哼，可是要让圣山大人恢复正常，就得…至少得部族里所有的大人一起拍才行。",
            "nextDialogs": [
              "751420705"
            ]
          },
          "751420705": {
            "id": "751420705",
            "speakerId": 1000,
            "speakerName": "度尼娅",
            "text": "可大人们都是很忙的，就比如瓦雷莎姐姐，还得照顾果园呢。得等到大家都有空的时候，一起拍拍圣山大人呀…",
            "nextDialogs": [
              "751420706"
            ]
          },
          "751420706": {
            "id": "751420706",
            "speakerId": 1001,
            "speakerName": "杜兹厄",
            "text": "你说的也不是没有道理…唉，得等大人们都有空呀…",
            "nextDialogs": [
              "751420707"
            ]
          },
          "751420707": {
            "id": "751420707",
            "speakerId": 1000,
            "speakerName": "度尼娅",
            "text": "嗯嗯，所以在那之前，我们就遵守大人们的禁足令，在圣山大人活动这么激烈的时期好好待在部族里吧…",
            "nextDialogs": [
              "751420708"
            ]
          },
          "751420708": {
            "id": "751420708",
            "speakerId": 1001,
            "speakerName": "杜兹厄",
            "text": "…好吧。",
            "nextDialogs": [
              "751420709"
            ]
          },
          "751420709": {
            "id": "751420709",
            "speakerId": 1002,
            "speakerName": "派蒙",
            "text": "你们在这说什么呀，什么拍不拍的？",
            "nextDialogs": [
              "751420710"
            ]
          },
          "751420710": {
            "id": "751420710",
            "speakerId": 1001,
            "speakerName": "杜兹厄",
            "text": "#我们在说…啊…金发的，还有银色的小精灵…是大英雄{NICKNAME}和派蒙。",
            "nextDialogs": [
              "751420711"
            ]
          },
          "751420711": {
            "id": "751420711",
            "speakerId": 1001,
            "speakerName": "杜兹厄",
            "text": "我、我们在聊一些很重要很重要的部族秘密呢！",
            "nextDialogs": [
              "751420712"
            ]
          },
          "751420712": {
            "id": "751420712",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "原来手拍火山是部族秘密啊…",
            "nextDialogs": [
              "751420713"
            ]
          },
          "751420713": {
            "id": "751420713",
            "speakerId": 1001,
            "speakerName": "杜兹厄",
            "text": "什、什么呀，你们不是全听进去了吗。",
            "nextDialogs": [
              "751420714"
            ]
          },
          "751420714": {
            "id": "751420714",
            "speakerId": 1000,
            "speakerName": "度尼娅",
            "text": "是杜兹厄你讲得太大声了啦，下次要说秘密，就得把嘴巴贴到我耳朵边上说哦。",
            "nextDialogs": [
              "751420715"
            ]
          },
          "751420715": {
            "id": "751420715",
            "speakerId": 1001,
            "speakerName": "杜兹厄",
            "text": "好哦…咦，可是那样不会靠、靠得太近了吗？！",
            "nextDialogs": [
              "751420716"
            ]
          },
          "751420716": {
            "id": "751420716",
            "speakerId": 1000,
            "speakerName": "度尼娅",
            "text": "哈哈，好啦。嗯…异邦来的大英雄，我是度尼娅，这个家伙是笨蛋杜兹厄…",
            "nextDialogs": [
              "751420717"
            ]
          },
          "751420717": {
            "id": "751420717",
            "speakerId": 1001,
            "speakerName": "杜兹厄",
            "text": "又叫我笨蛋…",
            "nextDialogs": [
              "751420718"
            ]
          },
          "751420718": {
            "id": "751420718",
            "speakerId": 1000,
            "speakerName": "度尼娅",
            "text": "欢迎你们来到沃陆之邦，还有这边的小嵴锋龙…奇怪，难道是因为圣山大人的状态不对吗…部族里应该有禁外龙的符石…",
            "nextDialogs": [
              "751420719"
            ]
          },
          "751420719": {
            "id": "751420719",
            "speakerId": 1001,
            "speakerName": "杜兹厄",
            "text": "哼哼，这就说明符石也该被拍一拍啦！",
            "nextDialogs": [
              "751420720"
            ]
          },
          "751420720": {
            "id": "751420720",
            "speakerId": 1000,
            "speakerName": "度尼娅",
            "text": "现在比较需要被拍拍的是杜兹厄的脑袋瓜…不过没想到，大英雄会到「沃陆之邦」来呢…",
            "nextDialogs": [
              "751420721"
            ]
          },
          "751420721": {
            "id": "751420721",
            "speakerId": 1000,
            "speakerName": "度尼娅",
            "text": "是有什么需要帮助的事吗？",
            "nextDialogs": [
              "751420722"
            ]
          },
          "751420722": {
            "id": "751420722",
            "speakerId": 1003,
            "speakerName": "Black Screen",
            "text": "向度尼娅和杜兹厄说明了想要进入圣山的目的…",
            "nextDialogs": [
              "751420723"
            ]
          },
          "751420723": {
            "id": "751420723",
            "speakerId": 1000,
            "speakerName": "度尼娅",
            "text": "想要「进入圣山」啊，那可不是容易的事呢…大人们还告诫我们，圣山是危险的地方，所以不能轻易进入…",
            "nextDialogs": [
              "751420724"
            ]
          },
          "751420724": {
            "id": "751420724",
            "speakerId": 1000,
            "speakerName": "度尼娅",
            "text": "#不过，如果是{NICKNAME}想要进入圣山内，想必也有自己的理由吧…",
            "nextDialogs": [
              "751420725"
            ]
          },
          "751420725": {
            "id": "751420725",
            "speakerId": 1000,
            "speakerName": "度尼娅",
            "text": "嗯…我倒是知道有人曾经进过圣山…",
            "nextDialogs": [
              "751420726"
            ]
          },
          "751420726": {
            "id": "751420726",
            "speakerId": 1001,
            "speakerName": "杜兹厄",
            "text": "我、我也知道呢！",
            "nextDialogs": [
              "751420727"
            ]
          },
          "751420727": {
            "id": "751420727",
            "speakerId": 1002,
            "speakerName": "派蒙",
            "text": "咦，那个「圣山」不是对于部族人来说很重要的地方吗？这样随便告诉我们真的好吗？",
            "nextDialogs": [
              "751420728"
            ]
          },
          "751420728": {
            "id": "751420728",
            "speakerId": 1000,
            "speakerName": "度尼娅",
            "text": "「圣山」的称呼是很久很久以前的织卷留下来的…对我们来说，还是「圣火竞技场」要更「圣」一筹呢。",
            "nextDialogs": [
              "751420729"
            ]
          },
          "751420729": {
            "id": "751420729",
            "speakerId": 1000,
            "speakerName": "度尼娅",
            "text": "我们被禁止进入只是因为里面比较危险啦。",
            "nextDialogs": [
              "751420730"
            ]
          },
          "751420730": {
            "id": "751420730",
            "speakerId": 1001,
            "speakerName": "杜兹厄",
            "text": "而且，以前「话事处」也组建过探险队进火山里…嘿嘿，等我长大了，我也要进去玩！",
            "nextDialogs": [
              "751420731"
            ]
          },
          "751420731": {
            "id": "751420731",
            "speakerId": 1000,
            "speakerName": "度尼娅",
            "text": "说了多少次，那是很危险的事啦…",
            "nextDialogs": [
              "751420732"
            ]
          },
          "751420732": {
            "id": "751420732",
            "speakerId": 1000,
            "speakerName": "度尼娅",
            "text": "嗯…具体的事我也不太清楚，不过，如果你愿意的话可以找<color=#00E1FFFF>恩波索爷爷</color>，他要是能帮上你的忙，应该也会很高兴的。",
            "nextDialogs": [
              "751420733"
            ]
          },
          "751420733": {
            "id": "751420733",
            "speakerId": 1001,
            "speakerName": "杜兹厄",
            "text": "「无所事事的恩波索爷爷」吗…找他还不如去找<color=#00E1FFFF>基莫西</color>呢，嘿嘿，基莫西是我叔叔，以前也曾经参加过冒险队…",
            "nextDialogs": [
              "751420734"
            ]
          },
          "751420734": {
            "id": "751420734",
            "speakerId": 1000,
            "speakerName": "度尼娅",
            "text": "不许说恩波索爷爷无所事事…唔，但是，他们现在一个在<color=#00E1FFFF>山南的挖掘地</color>，一个在<color=#00E1FFFF>村子西边的喷发遗迹</color>那边…",
            "nextDialogs": [
              "751420735"
            ]
          },
          "751420735": {
            "id": "751420735",
            "speakerId": 1000,
            "speakerName": "度尼娅",
            "text": "要是能够帮你们带路就好了，只不过现在圣山大人还在「喷吐」的时期…我们不能带你们去…",
            "nextDialogs": [
              "751420736"
            ]
          },
          "751420736": {
            "id": "751420736",
            "speakerId": 1002,
            "speakerName": "派蒙",
            "text": "没关系，告诉我们这些就已经足够啦！",
            "nextDialogs": [
              "751420737"
            ]
          },
          "751420737": {
            "id": "751420737",
            "speakerId": 1002,
            "speakerName": "派蒙",
            "text": "#{REALNAME[ID(2)|SHOWHOST(true)]}！回来啦，我们要出发了！",
            "nextDialogs": [
              "751420738"
            ]
          },
          "751420738": {
            "id": "751420738",
            "speakerId": 1004,
            "speakerName": "#{REALNAME[ID(2)|SHOWHOST(true)]}",
            "text": "呀！",
            "nextDialogs": [
              "751420739"
            ]
          },
          "751420739": {
            "id": "751420739",
            "speakerId": 1000,
            "speakerName": "度尼娅",
            "text": "嘿嘿，真是可爱的家伙，尾巴上绑的丝巾也很漂亮。等圣山大人睡着了，到时候一起去部族外面玩吧！",
            "nextDialogs": [
              "751420740"
            ]
          },
          "751420740": {
            "id": "751420740",
            "speakerId": 1002,
            "speakerName": "派蒙",
            "text": "好哦，下次我们再一起玩！"
          }
        }
      }
    },
    {
      "subId": "7514299",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "751429901"
        ],
        "dialogs": {
          "751429901": {
            "id": "751429901",
            "speakerId": 1002,
            "speakerName": "派蒙",
            "text": "挖掘地和喷发遗迹…要先去哪边呢…",
            "nextDialogs": [
              "751429902"
            ]
          },
          "751429902": {
            "id": "751429902",
            "speakerId": 1004,
            "speakerName": "#{REALNAME[ID(2)|SHOWHOST(true)]}",
            "text": "呀！",
            "nextDialogs": [
              "751429903"
            ]
          },
          "751429903": {
            "id": "751429903",
            "speakerId": 1002,
            "speakerName": "派蒙",
            "text": "你这家伙倒是一副「先到哪边都行！」的样子。"
          }
        }
      }
    }
  ]
}
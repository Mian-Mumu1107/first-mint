        ],
        "dialogs": {
          "20139901": {
            "id": "20139901",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "你真的要考虑完成这种委托吗？条件也太奇怪了…",
            "nextDialogs": [
              "20139902"
            ]
          },
          "20139902": {
            "id": "20139902",
            "speakerId": 1006,
            "speakerName": "健三郎",
            "text": "喂！是魔物，准备攻击！",
            "nextDialogs": [
              "20139903"
            ]
          },
          "20139903": {
            "id": "20139903",
            "speakerId": 1004,
            "speakerName": "新之丞",
            "text": "不，优先保护小姐！",
            "nextDialogs": [
              "20139904"
            ]
          },
          "20139904": {
            "id": "20139904",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "瞧我们的吧！你们好好待在千里身边！",
            "nextDialogs": [
              "20139907"
            ]
          },
          "20139907": {
            "id": "20139907",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "这下终于自由了！",
            "nextDialogs": [
              "20139908"
            ]
          },
          "20139908": {
            "id": "20139908",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "是时候去找托马那个家伙了吧？记得是在…嗯！「木漏茶室」！"
          }
        }

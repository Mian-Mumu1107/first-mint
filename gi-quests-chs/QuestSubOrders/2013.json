            "speakerName": "柊慎介",
            "text": "之前说的事情，两位已经办完了吗？",
            "nextDialogs": [
              "20139102"
            ]
          },
          "20139102": {
            "id": "20139102",
            "speakerId": 1003,
            "speakerName": "柊慎介",
            "text": "办完之后，再来向我汇报吧。"
          }
        }
      }

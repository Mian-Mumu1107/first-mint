  "subQuests": [
    {
      "subId": "201301",
      "subQuestName": "尝试离开离岛",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "20130101"
        ],
        "dialogs": {
          "20130101": {
            "id": "20130101",
            "speakerId": 1000,
            "speakerName": "小林",
            "text": "等一下！请出示「通行凭证」！",
            "nextDialogs": [
              "20130102"
            ]
          },
          "20130102": {
            "id": "20130102",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "抱歉，我们有急事要去鸣神岛…",
            "nextDialogs": [
              "20130103"
            ]
          },
          "20130103": {
            "id": "20130103",
            "speakerId": 1000,
            "speakerName": "小林",
            "text": "未持有「通行凭证」的话就请回吧，这是规矩。",
            "nextDialogs": [
              "20130104"
            ]
          },
          "20130104": {
            "id": "20130104",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "唉…果然嘛。",
            "nextDialogs": [
              "20130105"
            ]
          },
          "20130105": {
            "id": "20130105",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "旅行者，快想想办法，现在要怎么办才能出去呀？",
            "nextDialogs": [
              "20130108"
            ]
          },
          "20130108": {
            "id": "20130108",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "你是说，直接去见勘定奉行本人吗？",
            "nextDialogs": [
              "20130109"
            ]
          },
          "20130109": {
            "id": "20130109",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "…尽管对他手下的人很有意见，但好像也只能试试看了。",
            "nextDialogs": [
              "20130110"
            ]
          },
          "20130110": {
            "id": "20130110",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "万一他很崇拜我们呢？嘿嘿。"
          }
        }
      }
    },
    {
      "subId": "201311",
      "subQuestName": "前往勘定奉行所，询问离开离岛的方法",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "20131101"
        ],
        "dialogs": {
          "20131101": {
            "id": "20131101",
            "speakerId": 1002,
            "speakerName": "横山",
            "text": "站住，这里是勘定奉行所，闲杂人等不得入内！",
            "nextDialogs": [
              "20131102"
            ]
          },
          "20131102": {
            "id": "20131102",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "我们要见…要见那个…勘定奉行！",
            "nextDialogs": [
              "20131103"
            ]
          },
          "20131103": {
            "id": "20131103",
            "speakerId": 1002,
            "speakerName": "横山",
            "text": "勘定奉行大人平时不接见外国人，快回去！不然我们就…",
            "nextDialogs": [
              "20131104"
            ]
          },
          "20131104": {
            "id": "20131104",
            "speakerId": 1003,
            "speakerName": "柊慎介",
            "text": "欸，等等，等一下…",
            "nextDialogs": [
              "20131105"
            ]
          },
          "20131105": {
            "id": "20131105",
            "speakerId": 1002,
            "speakerName": "横山",
            "text": "啊，奉行大人！",
            "nextDialogs": [
              "20131106"
            ]
          },
          "20131106": {
            "id": "20131106",
            "speakerId": 1003,
            "speakerName": "柊慎介",
            "text": "这两位是远道而来的贵客，别再用那老一套了。",
            "nextDialogs": [
              "20131107"
            ]
          },
          "20131107": {
            "id": "20131107",
            "speakerId": 1003,
            "speakerName": "柊慎介",
            "text": "来来，有事就请进来说。",
            "nextDialogs": [
              "20131108"
            ]
          },
          "20131108": {
            "id": "20131108",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "哼，听到了吗！",
            "nextDialogs": [
              "20131109"
            ]
          },
          "20131109": {
            "id": "20131109",
            "speakerId": 1002,
            "speakerName": "横山",
            "text": "非、非常抱歉。"
          }
        }
      }
    },
    {
      "subId": "201302",
      "subQuestName": "与勘定奉行慎介对话",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "20130201"
        ],
        "dialogs": {
          "20130201": {
            "id": "20130201",
            "speakerId": 1003,
            "speakerName": "柊慎介",
            "text": "我是柊慎介，勘定奉行柊家的家主，很荣幸见到二位。",
            "nextDialogs": [
              "20130204"
            ]
          },
          "20130204": {
            "id": "20130204",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "很高兴见到你！",
            "nextDialogs": [
              "20130205"
            ]
          },
          "20130205": {
            "id": "20130205",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "我们这次来找你，是想…",
            "nextDialogs": [
              "20130206"
            ]
          },
          "20130206": {
            "id": "20130206",
            "speakerId": 1003,
            "speakerName": "柊慎介",
            "text": "欸，不急不急。好不容易见到闻名遐迩的两位旅者，何必这么匆忙谈正事。",
            "nextDialogs": [
              "20130207"
            ]
          },
          "20130207": {
            "id": "20130207",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "嘿嘿，我们果然很有名气吗？",
            "nextDialogs": [
              "20130208"
            ]
          },
          "20130208": {
            "id": "20130208",
            "speakerId": 1003,
            "speakerName": "柊慎介",
            "text": "当然。能挫败风魔龙，镇压漩涡之魔神的凡人，普天之下又有几人？",
            "nextDialogs": [
              "20130209"
            ]
          },
          "20130209": {
            "id": "20130209",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "确实！这点说的对，嗯嗯！",
            "nextDialogs": [
              "20130210"
            ]
          },
          "20130210": {
            "id": "20130210",
            "speakerId": 1003,
            "speakerName": "柊慎介",
            "text": "还有…在璃月港破坏愚人众的计划，在决斗中战胜他们的执行官的事，也是真的？",
            "nextDialogs": [
              "20130211"
            ]
          },
          "20130211": {
            "id": "20130211",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "哇，连这你都知道，当然是真的啦！",
            "nextDialogs": [
              "20130212"
            ]
          },
          "20130212": {
            "id": "20130212",
            "speakerId": 1003,
            "speakerName": "柊慎介",
            "text": "嗯…果然吗。",
            "nextDialogs": [
              "20130213"
            ]
          },
          "20130213": {
            "id": "20130213",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "怎么了嘛？",
            "nextDialogs": [
              "20130214"
            ]
          },
          "20130214": {
            "id": "20130214",
            "speakerId": 1003,
            "speakerName": "柊慎介",
            "text": "呵呵，没什么没什么，老朽由衷敬佩二位。"
          }
        }
      }
    },
    {
      "subId": "201303",
      "subQuestName": "离开勘定奉行所",
      "sceneId": null,
      "locations": [],

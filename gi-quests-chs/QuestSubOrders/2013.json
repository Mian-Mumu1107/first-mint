    {
      "subId": "201306",
      "subQuestName": "在约定时间（18~24时）与柊家小姐见面",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [],
        "dialogs": {}
      }
    },
    {
      "subId": "201307",
      "subQuestName": "与柊千里会面",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "20130701"
        ],
        "dialogs": {
          "20130701": {
            "id": "20130701",
            "speakerId": 1005,
            "speakerName": "柊千里",
            "text": "啊，你们终于来了吗…我…我叫柊千里。",
            "nextDialogs": [
              "20130702"
            ]
          },
          "20130702": {
            "id": "20130702",
            "speakerId": 1005,
            "speakerName": "柊千里",
            "text": "算是…第二次见面了吧，请多关照。",
            "nextDialogs": [
              "20130703"
            ]
          },
          "20130703": {
            "id": "20130703",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "哇，真的是柊家的大小姐。",
            "nextDialogs": [
              "20130706"
            ]
          },
          "20130706": {
            "id": "20130706",
            "speakerId": 1005,
            "speakerName": "柊千里",
            "text": "不用…不用这么客气，我早就很仰慕您的事迹，终于找到这样的机会了。",
            "nextDialogs": [
              "20130707"
            ]
          },
          "20130707": {
            "id": "20130707",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "嗯？怎么感觉气氛有点奇怪。",
            "nextDialogs": [
              "20130708"
            ]
          },
          "20130708": {
            "id": "20130708",
            "speakerId": 1005,
            "speakerName": "柊千里",
            "text": "这次偷偷见面，主要是在想…如果错过了机会，是不是就再也没办法和你讲…",
            "nextDialogs": [
              "20130709"
            ]
          },
          "20130709": {
            "id": "20130709",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "讲…讲什么？",
            "nextDialogs": [
              "20130710"
            ]
          },
          "20130710": {
            "id": "20130710",
            "speakerId": 1005,
            "speakerName": "柊千里",
            "text": "讲…想让你帮忙送信的事。"
          }
        }
      }
    },
    {
      "subId": "201308",
      "subQuestName": "前往离岛边境，实施千里的计划",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "20130801"
        ],
        "dialogs": {
          "20130801": {
            "id": "20130801",
            "speakerId": 1005,
            "speakerName": "柊千里",
            "text": "等一下，这批货…可是要送往海祇岛？",
            "nextDialogs": [
              "20130802"
            ]
          },
          "20130802": {
            "id": "20130802",
            "speakerId": 1004,
            "speakerName": "新之丞",
            "text": "大小姐！您怎么过来了。您说的没错，这批货是勘定奉行大人特意叮嘱过，务必完好地送到海祇岛的。",
            "nextDialogs": [
              "20130803"
            ]
          },
          "20130803": {
            "id": "20130803",
            "speakerId": 1006,
            "speakerName": "健三郎",
            "text": "不知小姐的意思是…？",
            "nextDialogs": [
              "20130804"
            ]
          },
          "20130804": {
            "id": "20130804",
            "speakerId": 1005,
            "speakerName": "柊千里",
            "text": "那就没错了，家父不放心，刻意要我带上一位「高手」一同押运。",
            "nextDialogs": [
              "20130805"
            ]
          },
          "20130805": {
            "id": "20130805",
            "speakerId": 1006,
            "speakerName": "健三郎",
            "text": "大小姐亲自押送吗？这、这…还是不需要劳烦您同行了吧，而且这位…这位「高手」的身份也…",
            "nextDialogs": [
              "20130808"
            ]
          },
          "20130808": {
            "id": "20130808",
            "speakerId": 1005,
            "speakerName": "柊千里",
            "text": "请不要耽误时间了，我记得家父有催促过你们，迟到也同样会受罚吧?",
            "nextDialogs": [
              "20130809"
            ]
          },
          "20130809": {
            "id": "20130809",
            "speakerId": 1006,
            "speakerName": "健三郎",
            "text": "小姐，您的意思我们明白，可唯独这位…",
            "nextDialogs": [
              "20130810"
            ]
          },
          "20130810": {
            "id": "20130810",
            "speakerId": 1005,
            "speakerName": "柊千里",
            "text": "怎么，你们知道家父的脾气，如果我的安全出了闪失，你们要受的责罚恐怕不需要我讲了吧。",
            "nextDialogs": [
              "20130811"
            ]
          },
          "20130811": {
            "id": "20130811",
            "speakerId": 1005,
            "speakerName": "柊千里",
            "text": "你们真的有百分百的把握…保护好我么？",
            "nextDialogs": [
              "20130812"
            ]
          },
          "20130812": {
            "id": "20130812",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "千里小姐好拼，气场就像变了个人一样呢…",
            "nextDialogs": [
              "20130813"
            ]
          },
          "20130813": {
            "id": "20130813",
            "speakerId": 1004,
            "speakerName": "新之丞",
            "text": "好吧，小姐，非、非常荣幸可以与您随行…在下一定拼死护您周全。",
            "nextDialogs": [
              "20130814"
            ]
          },
          "20130814": {
            "id": "20130814",
            "speakerId": 1006,
            "speakerName": "健三郎",
            "text": "新之丞！你就真的答应了吗！",
            "nextDialogs": [
              "20130815"
            ]
          },
          "20130815": {
            "id": "20130815",
            "speakerId": 1004,
            "speakerName": "新之丞",
            "text": "嗯…既然是小姐的意思，做属下的就该竭尽所能才是。",
            "nextDialogs": [
              "20130816"
            ]
          },
          "20130816": {
            "id": "20130816",
            "speakerId": 1006,
            "speakerName": "健三郎",
            "text": "可是，问题不在这里…",
            "nextDialogs": [
              "20130817"
            ]
          },
          "20130817": {
            "id": "20130817",
            "speakerId": 1005,
            "speakerName": "柊千里",
            "text": "好了好了，那就赶快出发吧，这样磨磨蹭蹭的，是要给贼人准备动手的机会么？",
            "nextDialogs": [
              "20130818"
            ]
          },
          "20130818": {
            "id": "20130818",
            "speakerId": 1006,
            "speakerName": "健三郎",
            "text": "唉…好吧，出发！"
          }
        }
      }
    },

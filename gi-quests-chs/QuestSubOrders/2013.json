    {
      "subId": "201304",
      "subQuestName": "与新之丞对话",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "20130401"
        ],
        "dialogs": {
          "20130401": {
            "id": "20130401",
            "speakerId": 1004,
            "speakerName": "新之丞",
            "text": "二位请留步。",
            "nextDialogs": [
              "20130404"
            ]
          },
          "20130404": {
            "id": "20130404",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "欸？我们怎么了吗？",
            "nextDialogs": [
              "20130405"
            ]
          },
          "20130405": {
            "id": "20130405",
            "speakerId": 1004,
            "speakerName": "新之丞",
            "text": "我们家小姐有封信要交给您，请一定要看一下。",
            "nextDialogs": [
              "20130406"
            ]
          },
          "20130406": {
            "id": "20130406",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "信？让我看看！",
            "nextDialogs": [
              "20130407"
            ]
          },
          "20130407": {
            "id": "20130407",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "见信如晤：如此唐突地递上信笺，实在抱歉。希望没有让您为此感到困扰。写信邀约来自异乡的陌生人，这种事情对我来说也是第一次呢。但我相信与您的相遇绝非偶然。所以，恰好今夜月色尚佳，望您不吝相会。请不用担心家臣与侍卫盘查，我自有办法引离。企盼着您务必前来。",
            "nextDialogs": [
              "20130408"
            ]
          },
          "20130408": {
            "id": "20130408",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "是说…要你晚上偷偷去找她？",
            "nextDialogs": [
              "20130409"
            ]
          },
          "20130409": {
            "id": "20130409",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "刚才你好像早就知道会发生这样的事…是为什么呢？"
          }
        }
      }
    },
    {
      "subId": "201305",
      "subQuestName": "在第二天的约定时间（18~24时）与柊家小姐见面$HIDDEN",

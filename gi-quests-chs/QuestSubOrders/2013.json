    {
      "subId": "201310",
      "subQuestName": "向柊千里道别",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "20131001"
        ],
        "dialogs": {
          "20131001": {
            "id": "20131001",
            "speakerId": 1004,
            "speakerName": "新之丞",
            "text": "呼…前面的村庄可以暂且歇息下，小姐你的状态还好吧？",
            "nextDialogs": [
              "20131002"
            ]
          },
          "20131002": {
            "id": "20131002",
            "speakerId": 1005,
            "speakerName": "柊千里",
            "text": "嗯，到这里就可以了，那边是往鸣神岛的路…",
            "nextDialogs": [
              "20131003"
            ]
          },
          "20131003": {
            "id": "20131003",
            "speakerId": 1005,
            "speakerName": "柊千里",
            "text": "我在信里有写，让镰治给你天领奉行特批的全稻妻的「通行凭证」，就当是谢礼。",
            "nextDialogs": [
              "20131006"
            ]
          },
          "20131006": {
            "id": "20131006",
            "speakerId": 1004,
            "speakerName": "新之丞",
            "text": "小…姐…？",
            "nextDialogs": [
              "20131007"
            ]
          },
          "20131007": {
            "id": "20131007",
            "speakerId": 1006,
            "speakerName": "健三郎",
            "text": "唉，没想到真会如此，我就猜是会这样，新之丞你却…",
            "nextDialogs": [
              "20131008"
            ]
          },
          "20131008": {
            "id": "20131008",
            "speakerId": 1004,
            "speakerName": "新之丞",
            "text": "不会的，小姐一定别有用意，对吧？还有小姐你说的那个镰治是…？",
            "nextDialogs": [
              "20131009"
            ]
          },
          "20131009": {
            "id": "20131009",
            "speakerId": 1005,
            "speakerName": "柊千里",
            "text": "不避讳地说…是我的心上人。",
            "nextDialogs": [
              "20131010"
            ]
          },
          "20131010": {
            "id": "20131010",
            "speakerId": 1004,
            "speakerName": "新之丞",
            "text": "心上人…？",
            "nextDialogs": [
              "20131011"
            ]
          },
          "20131011": {
            "id": "20131011",
            "speakerId": 1006,
            "speakerName": "健三郎",
            "text": "喂，不是吧，新之丞你难道？",
            "nextDialogs": [
              "20131012"
            ]
          },
          "20131012": {
            "id": "20131012",
            "speakerId": 1004,
            "speakerName": "新之丞",
            "text": "没、没什么…咳咳…我只是随便问问，我怎么可能、怎么可能做那种梦呢…咳咳…",
            "nextDialogs": [
              "20131013"
            ]
          },
          "20131013": {
            "id": "20131013",
            "speakerId": 1005,
            "speakerName": "柊千里",
            "text": "二位不必担心，这件事还请二位先当做不知道，如果家父怪罪下来，我会一人承担。",
            "nextDialogs": [
              "20131014"
            ]
          },
          "20131014": {
            "id": "20131014",
            "speakerId": 1006,
            "speakerName": "健三郎",
            "text": "也只能如此了，唉…都听您的，小姐。",
            "nextDialogs": [
              "20131015"
            ]
          },
          "20131015": {
            "id": "20131015",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "可是千里小姐，如果真的被发现了可怎么办…？",
            "nextDialogs": [
              "20131016"
            ]
          },
          "20131016": {
            "id": "20131016",
            "speakerId": 1005,
            "speakerName": "柊千里",
            "text": "没关系的，家父自我小时候便非常宠我，最多会罚我半日禁食之类的而已，不必担心。",
            "nextDialogs": [
              "20131017"
            ]
          },
          "20131017": {
            "id": "20131017",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "原来那个老头子还有这样的一面…那好吧。",
            "nextDialogs": [
              "20131018"
            ]
          },
          "20131018": {
            "id": "20131018",
            "speakerId": 1005,
            "speakerName": "柊千里",
            "text": "请二位路上小心，我们有缘再见吧。",
            "nextDialogs": [
              "20131019"
            ]
          },
          "20131019": {
            "id": "20131019",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "嗯，再见，千里小姐！",
            "nextDialogs": [
              "20131020"
            ]
          },
          "20131020": {
            "id": "20131020",
            "speakerId": 1006,
            "speakerName": "健三郎",
            "text": "走啊，继续运货啊，愣着干什么呢！",
            "nextDialogs": [
              "20131021"
            ]
          },
          "20131021": {
            "id": "20131021",
            "speakerId": 1004,
            "speakerName": "新之丞",
            "text": "呜…咳咳…呜呜…"
          }
        }
      }
    },

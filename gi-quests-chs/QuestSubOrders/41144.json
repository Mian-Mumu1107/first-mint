        ],
        "dialogs": {
          "411440401": {
            "id": "411440401",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "还有别的事。",
            "nextDialogs": [
              "411440402"
            ]
          },
          "411440402": {
            "id": "411440402",
            "speakerId": 1000,
            "speakerName": "言笑",
            "text": "你还真是个大忙人…那我去找别人帮忙，你忙你的去吧。"
          }
        }
      }
    },
    {
      "subId": "4114401",
      "subQuestName": "与言笑对话",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "411440101"
        ],
        "dialogs": {
          "411440101": {
            "id": "411440101",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "我这就送过去。",
            "nextDialogs": [
              "411440102"
            ]
          },
          "411440102": {
            "id": "411440102",
            "speakerId": 1000,
            "speakerName": "言笑",
            "text": "行，还挺爽快的…那你赶紧去吧。路上<color=#00E1FFFF>别沾了奇怪的东西</color>。",
            "nextDialogs": [
              "411440103"
            ]
          },
          "411440103": {
            "id": "411440103",
            "speakerId": 1000,
            "speakerName": "言笑",
            "text": "对了，记得<color=#00E1FFFF>别用风之翼赶路啊</color>，落地的时候要是把肉卷给震散了，那客人肯定不会收的。"
          }
        }
      }
    },
    {
      "subId": "4114402",
      "subQuestName": "将餐品送给随缘的铃官",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "411440201"
        ],
        "dialogs": {
          "411440201": {
            "id": "411440201",
            "speakerId": 1001,
            "speakerName": "随缘的铃官",
            "text": "肚子饿了…唉，我订的餐怎么还没送来啊…"
          }
        }
      }
    },
    {
      "subId": "4114403",
      "subQuestName": "与随缘的铃官对话",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "411440601"
        ],
        "dialogs": {
          "411440601": {
            "id": "411440601",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "这是您订的餐。",
            "nextDialogs": [
              "411440602"
            ]
          },
          "411440602": {
            "id": "411440602",
            "speakerId": 1001,
            "speakerName": "随缘的铃官",
            "text": "总算送来啦！谢谢你。",
            "nextDialogs": [
              "411440603"
            ]
          },
          "411440603": {
            "id": "411440603",
            "speakerId": 1001,
            "speakerName": "随缘的铃官",
            "text": "要是再不送来，我都想回望舒客栈看看了…"
          }
        }
      }
    },
    {
      "subId": "4114403",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "411440301"
        ],
        "dialogs": {
          "411440301": {
            "id": "411440301",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "听说有特别订单…",
            "nextDialogs": [
              "411440302"
            ]
          },
          "411440302": {
            "id": "411440302",
            "speakerId": 1000,
            "speakerName": "言笑",
            "text": "怎么，你是来帮忙送餐的吗？",
            "nextDialogs": [
              "411440303"
            ]
          },
          "411440303": {
            "id": "411440303",
            "speakerId": 1000,
            "speakerName": "言笑",
            "text": "哼，来得正好，有个叫铃官的客人在我这点了一份松茸酿酒卷。",
            "nextDialogs": [
              "411440304"
            ]
          },
          "411440304": {
            "id": "411440304",
            "speakerId": 1000,
            "speakerName": "言笑",
            "text": "她让我晚些时候送到荻花洲西北面的一个地方，钱已经付好了。",
            "nextDialogs": [
              "411440305"
            ]
          },
          "411440305": {
            "id": "411440305",
            "speakerId": 1000,
            "speakerName": "言笑",
            "text": "怎么样，如果你有空的话，就帮忙送过去吧，报酬少不了你的。"
          }
        }
      }
    },

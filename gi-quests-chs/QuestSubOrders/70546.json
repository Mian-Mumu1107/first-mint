{
  "lineCounts": {
    "Player": 8,
    "方妮雅": 14,
    "派蒙": 7,
    "艾玛托": 21
  },
  "subQuests": [
    {
      "subId": "7054601",
      "subQuestName": "与两位骑士对话",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "705460101"
        ],
        "dialogs": {
          "705460101": {
            "id": "705460101",
            "speakerId": 1000,
            "speakerName": "艾玛托",
            "text": "方妮雅，我的好姐姐！你难道不想成为「嘟嘟可砰砰历险记」的第一位玩家吗？试试这款新作吧！",
            "nextDialogs": [
              "705460102"
            ]
          },
          "705460102": {
            "id": "705460102",
            "speakerId": 1000,
            "speakerName": "艾玛托",
            "text": "灵活机动的作战方式，点对点的精准爆破，和狡猾游走的敌人斗智斗勇，怎么看都特别好玩吧！",
            "nextDialogs": [
              "705460103"
            ]
          },
          "705460103": {
            "id": "705460103",
            "speakerId": 1001,
            "speakerName": "方妮雅",
            "text": "不要。我又不像你，整天只想着和炸弹过日子。",
            "nextDialogs": [
              "705460104"
            ]
          },
          "705460104": {
            "id": "705460104",
            "speakerId": 1001,
            "speakerName": "方妮雅",
            "text": "帮你折腾测试样机和桌上游戏，已经属于高强度加班了。",
            "nextDialogs": [
              "705460105"
            ]
          },
          "705460105": {
            "id": "705460105",
            "speakerId": 1001,
            "speakerName": "方妮雅",
            "text": "我现在只想叫一份「猎鹿人」的外送订单，然后回家。等到门被敲响时，我刚好洗完最后一件衣服，心情愉快地接过我的餐品…",
            "nextDialogs": [
              "705460106"
            ]
          },
          "705460106": {
            "id": "705460106",
            "speakerId": 1001,
            "speakerName": "方妮雅",
            "text": "至于这个噼噼砰砰的新游戏，就等到下次和你一起值班，闲得无聊时再玩吧。",
            "nextDialogs": [
              "705460107"
            ]
          },
          "705460107": {
            "id": "705460107",
            "speakerId": 1002,
            "speakerName": "派蒙",
            "text": "什么新游戏，听得我都好奇了…可以让我们也看看吗？",
            "nextDialogs": [
              "705460108"
            ]
          },
          "705460108": {
            "id": "705460108",
            "speakerId": 1000,
            "speakerName": "艾玛托",
            "text": "等等，是荣誉骑士和白色小帮手？居然真的能遇见你们！",
            "nextDialogs": [
              "705460110",
              "705460115"
            ]
          },
          "705460110": {
            "id": "705460110",
            "speakerId": 1000,
            "speakerName": "艾玛托",
            "text": "荣誉骑士认识我？看来上次我在「入侵角鲀歼灭战」的表现很出色…连您都听说了我的名字？",
            "nextDialogs": [
              "705460111"
            ]
          },
          "705460111": {
            "id": "705460111",
            "speakerId": 1000,
            "speakerName": "艾玛托",
            "text": "我我我…我一定继续加油！",
            "nextDialogs": [
              "705460112"
            ]
          },
          "705460112": {
            "id": "705460112",
            "speakerId": 1000,
            "speakerName": "艾玛托",
            "text": "最近我正在持续改良炸弹配方和设计，努力让我和火花骑士大人的差距再缩小一点点，一点点…",
            "nextDialogs": [
              "705460113"
            ]
          },
          "705460113": {
            "id": "705460113",
            "speakerId": 1001,
            "speakerName": "方妮雅",
            "text": "总之，上次行动过后，艾玛托认为，只靠远距离投放炸弹，还是存在不小的作战死角，而且面对一些屏蔽物和掩体时不够有效…",
            "nextDialogs": [
              "705460119"
            ]
          },
          "705460119": {
            "id": "705460119",
            "speakerId": 1001,
            "speakerName": "方妮雅",
            "text": "所以她开始折腾新的装备，为了验证这种装备，还特地改进了火花骑士爱玩的桌上游戏。",
            "nextDialogs": [
              "705460120"
            ]
          },
          "705460120": {
            "id": "705460120",
            "speakerId": 1000,
            "speakerName": "艾玛托",
            "text": "没错！这些天来我一直在分析火花骑士的战斗思路，想出了炸弹的另一种使用方式！",
            "nextDialogs": [
              "705460121"
            ]
          },
          "705460121": {
            "id": "705460121",
            "speakerId": 1000,
            "speakerName": "艾玛托",
            "text": "火花骑士的习惯大概是「一份装药的威力不够，就用三份；一枚蹦蹦炸弹解决不了，就丢三枚」，增大威力肯定能解决问题。",
            "nextDialogs": [
              "705460122"
            ]
          },
          "705460122": {
            "id": "705460122",
            "speakerId": 1000,
            "speakerName": "艾玛托",
            "text": "但这对我们普通骑士来说太困难了，不能在威力上和火花骑士大人的蹦蹦炸弹匹敌，就只能用灵活性和准确度弥补缺点。",
            "nextDialogs": [
              "705460123"
            ]
          },
          "705460123": {
            "id": "705460123",
            "speakerId": 1000,
            "speakerName": "艾玛托",
            "text": "如果开发出一种能够追踪目标，接近布置炸弹的装备，既可以实现对危险目标的精准打击，又可以最大程度利用负重！",
            "nextDialogs": [
              "705460124"
            ]
          },
          "705460124": {
            "id": "705460124",
            "speakerId": 1002,
            "speakerName": "派蒙",
            "text": "追…追着敌人放炸弹的装备？听起来很厉害，又有点吓人…",
            "nextDialogs": [
              "705460125"
            ]
          },
          "705460125": {
            "id": "705460125",
            "speakerId": 1002,
            "speakerName": "派蒙",
            "text": "假如我是个丘丘人，正和朋友追着野林猪呢，突然蹦出来个小东西，二话不说就把炸弹扔在我们脸上…我应该会吓得昏过去！"
          },
          "705460115": {
            "id": "705460115",
            "speakerId": 1001,
            "speakerName": "方妮雅",
            "text": "嗯…作为西风骑士团里不起眼的部件，荣誉骑士没听说过，或是不记得我们，都没关系。",
            "nextDialogs": [
              "705460116"
            ]
          },
          "705460116": {
            "id": "705460116",
            "speakerId": 1001,
            "speakerName": "方妮雅",
            "text": "我是调查小队的信号官方妮雅，负责试验炼金探测设备。她是我的同僚，武器官艾玛托，对爆炸物有着…独特的嗜好。",
            "nextDialogs": [
              "705460117"
            ]
          },
          "705460117": {
            "id": "705460117",
            "speakerId": 1001,
            "speakerName": "方妮雅",
            "text": "上次我们负责应对须弥「角鲀」入侵果酒湖事件，行动还算顺利，距今有些年月了。",
            "nextDialogs": [
              "705460118"
            ]
          },
          "705460118": {
            "id": "705460118",
            "speakerId": 1001,
            "speakerName": "方妮雅",
            "text": "在那之后，艾玛托认为，只靠远距离投放炸弹，还是存在不小的作战死角，而且面对一些屏蔽物和掩体时不够有效…"
          }
        }
      }
    }
  ]
}
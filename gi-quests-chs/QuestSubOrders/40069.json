    {
      "subId": "4006903",
      "subQuestName": "进入「音乐的殿堂」",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "400690301"
        ],
        "dialogs": {
          "400690301": {
            "id": "400690301",
            "speakerId": 10095,
            "speakerName": "莫娜",
            "text": "哇啊我的帽子要掉了…",
            "nextDialogs": [
              "400690302"
            ]
          },
          "400690302": {
            "id": "400690302",
            "speakerId": 1032,
            "speakerName": "枫原万叶",
            "text": "嗯？这种气味…我们是在璃月附近的山上。",
            "nextDialogs": [
              "400690303"
            ]
          },
          "400690303": {
            "id": "400690303",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "可是这里好阴暗…",
            "nextDialogs": [
              "400690304"
            ]
          },
          "400690304": {
            "id": "400690304",
            "speakerId": 1042,
            "speakerName": "辛焱",
            "text": "等等。你们听…有声音。"
          }
        }
      }
    },
    {
      "subId": "4006911",
      "subQuestName": "(test)(hide)和投影门1对话$HIDDEN",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "400691101"
        ],
        "dialogs": {
          "400691101": {
            "id": "400691101",
            "speakerId": 1006,
            "speakerName": "母亲",
            "text": "那些鸟雀是喝过山顶的泉水，才能唱出悠扬的歌。你看咱家，从来就没人喜欢唱歌，你又怎么能唱得好呢？",
            "nextDialogs": [
              "400691102"
            ]
          },
          "400691102": {
            "id": "400691102",
            "speakerId": 1007,
            "speakerName": "小辛焱",
            "text": "那我也去喝这种泉水就行了吧？妈妈，我出门一趟！"
          }
        }
      }
    },
    {
      "subId": "4006920",
      "subQuestName": "(test)(hide)和投影门2对话$HIDDEN",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "400692001"
        ],
        "dialogs": {
          "400692001": {
            "id": "400692001",
            "speakerId": 1008,
            "speakerName": "父亲",
            "text": "大晚上还待在山里不回来，你这孩子想吓死我呀！…喏，你要的山泉。",
            "nextDialogs": [
              "400692002"
            ]
          },
          "400692002": {
            "id": "400692002",
            "speakerId": 1007,
            "speakerName": "小辛焱",
            "text": "真的？爸爸你真好！"
          }
        }
      }
    },
    {
      "subId": "4006921",
      "subQuestName": "(test)(hide)和投影门3对话$HIDDEN",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "400692101"
        ],
        "dialogs": {
          "400692101": {
            "id": "400692101",
            "speakerId": 1006,
            "speakerName": "母亲",
            "text": "辛焱那孩子，又跑哪儿去了？",
            "nextDialogs": [
              "400692102"
            ]
          },
          "400692102": {
            "id": "400692102",
            "speakerId": 1008,
            "speakerName": "父亲",
            "text": "找地方唱歌去了吧。唉，说也说不听，拦也拦不住。你说你当初骗她干嘛！",
            "nextDialogs": [
              "400692103"
            ]
          },
          "400692103": {
            "id": "400692103",
            "speakerId": 1006,
            "speakerName": "母亲",
            "text": "我哪知道她真会去找什么山泉呀！唉，怎么才能让人省点心哟…"
          }
        }
      }
    },
    {
      "subId": "4006922",
      "subQuestName": "(test)(hide)和投影门4对话$HIDDEN",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "400692201"
        ],
        "dialogs": {
          "400692201": {
            "id": "400692201",
            "speakerId": 1009,
            "speakerName": "男声",
            "text": "给老子下来！这儿不能搭台子！不会唱曲儿就不要唱，还学人家办什么演出，真是的。",
            "nextDialogs": [
              "400692202"
            ]
          },
          "400692202": {
            "id": "400692202",
            "speakerId": 1010,
            "speakerName": "少女辛焱",
            "text": "呜哇，别拆啊！"
          }
        }
      }
    },
    {
      "subId": "4006916",
      "subQuestName": "追上发出声音的门扉",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [],
        "dialogs": {}
      }
    },
    {
      "subId": "4006904",
      "subQuestName": "靠近发出声音的门扉",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "400690401"
        ],
        "dialogs": {
          "400690401": {
            "id": "400690401",
            "speakerId": 12617,
            "speakerName": "竹叔",
            "text": "我说辛焱啊，小姑娘家家，怎么又在玩那种粗鲁的乐器。",
            "nextDialogs": [
              "400690402"
            ]
          },
          "400690402": {
            "id": "400690402",
            "speakerId": 12618,
            "speakerName": "吉祥",
            "text": "辛焱呀，你妈妈说了，让我有空多教教你绣工。呵呵，这叫雅趣。什么时候到阿姨家里来？",
            "nextDialogs": [
              "400690403"
            ]
          },
          "400690403": {
            "id": "400690403",
            "speakerId": 12619,
            "speakerName": "海伯",
            "text": "吵死了，别在路边弹琴啦！要是非弹不可，也弹点上得了台面的曲子行不行？",
            "nextDialogs": [
              "400690404"
            ]
          },
          "400690404": {
            "id": "400690404",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "这、这说的都是什么话呀，根本不是人话吧！",
            "nextDialogs": [
              "400690405"
            ]
          },
          "400690405": {
            "id": "400690405",
            "speakerId": 10095,
            "speakerName": "莫娜",
            "text": "唉，这些人…",
            "nextDialogs": [
              "400690406"
            ]
          },
          "400690406": {
            "id": "400690406",
            "speakerId": 1032,
            "speakerName": "枫原万叶",
            "text": "……",
            "nextDialogs": [
              "400690407"
            ]
          },
          "400690407": {
            "id": "400690407",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "啊——气死我了！你干嘛不骂回去呀，你的摇滚精神呢！",
            "nextDialogs": [
              "400690408"
            ]
          },
          "400690408": {
            "id": "400690408",
            "speakerId": 1042,
            "speakerName": "辛焱",
            "text": "噗…",
            "nextDialogs": [
              "400690409"
            ]
          },
          "400690409": {
            "id": "400690409",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "都这样了，你还笑！不生气吗？",
            "nextDialogs": [
              "400690410"
            ]
          },
          "400690410": {
            "id": "400690410",
            "speakerId": 1042,
            "speakerName": "辛焱",
            "text": "有些话听一次冒火气，听一百次可就气不起来了。不过还是谢谢你，派蒙。",
            "nextDialogs": [
              "400690411"
            ]
          },
          "400690411": {
            "id": "400690411",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "欸…？",
            "nextDialogs": [
              "400690412"
            ]
          },
          "400690412": {
            "id": "400690412",
            "speakerId": 1042,
            "speakerName": "辛焱",
            "text": "吉祥阿姨。",
            "nextDialogs": [
              "400690413"
            ]
          },
          "400690413": {
            "id": "400690413",
            "speakerId": 12618,
            "speakerName": "吉祥",
            "text": "欸，阿姨等你回音呢。这个周末我刚好有空…",
            "nextDialogs": [
              "400690414"
            ]
          },
          "400690414": {
            "id": "400690414",
            "speakerId": 1042,
            "speakerName": "辛焱",
            "text": "阿姨，别光顾着我啦，你家炉子火没关，上头还炖着汤吧？唔…你看，都焦了。",
            "nextDialogs": [
              "400690415"
            ]
          },
          "400690415": {
            "id": "400690415",
            "speakerId": 12618,
            "speakerName": "吉祥",
            "text": "哎呀呀这怎么得了！",
            "nextDialogs": [
              "400690416"
            ]
          },
          "400690416": {
            "id": "400690416",
            "speakerId": 1042,
            "speakerName": "辛焱",
            "text": "竹叔，小竹又在外头玩泥巴了，哎呀！你不是说了让他别这样吗！",
            "nextDialogs": [
              "400690417"
            ]
          },
          "400690417": {
            "id": "400690417",
            "speakerId": 12617,
            "speakerName": "竹叔",
            "text": "啊？！这混小子，又背着我出去干这事！看我不给他一顿好打！",
            "nextDialogs": [
              "400690418"
            ]
          },
          "400690418": {
            "id": "400690418",
            "speakerId": 1042,
            "speakerName": "辛焱",
            "text": "嘻嘻…",
            "nextDialogs": [
              "400690419"
            ]
          },
          "400690419": {
            "id": "400690419",
            "speakerId": 1042,
            "speakerName": "辛焱",
            "text": "海伯，对不住，我换个地方就是。不过您这听曲儿的品位，可得赶赶时髦喽。",
            "nextDialogs": [
              "400690420"
            ]
          },
          "400690420": {
            "id": "400690420",
            "speakerId": 1042,
            "speakerName": "辛焱",
            "text": "要知道，就连璃月港最有名的角儿，都喜欢听我这不上台面的曲子呢。",
            "nextDialogs": [
              "400690421"
            ]
          },
          "400690421": {
            "id": "400690421",
            "speakerId": 12619,
            "speakerName": "海伯",
            "text": "你说什么？还有这事？你…你可别骗我啊！…当真有这事？不成，我得出去问问。",
            "nextDialogs": [
              "400690422"
            ]
          },
          "400690422": {
            "id": "400690422",
            "speakerId": 10095,
            "speakerName": "莫娜",
            "text": "消失了…",
            "nextDialogs": [
              "400690423"
            ]
          },
          "400690423": {
            "id": "400690423",
            "speakerId": 1042,
            "speakerName": "辛焱",
            "text": "你看，适当的话术，自然的笑容，就能解决大部分问题。",
            "nextDialogs": [
              "400690424"
            ]
          },
          "400690424": {
            "id": "400690424",
            "speakerId": 1032,
            "speakerName": "枫原万叶",
            "text": "既然如此，摇滚精神又该用在什么地方？",
            "nextDialogs": [
              "400690425"
            ]
          },
          "400690425": {
            "id": "400690425",
            "speakerId": 1042,
            "speakerName": "辛焱",
            "text": "我的摇滚精神可不是那么表面的东西，用来跟人吵架未免太浪费了。",
            "nextDialogs": [
              "400690426"
            ]
          },
          "400690426": {
            "id": "400690426",
            "speakerId": 1042,
            "speakerName": "辛焱",
            "text": "摇滚是革命！改革自我，改革命运，告别懦弱和退让。而且，不是在言语上，是在艺术里！",
            "nextDialogs": [
              "400690427"
            ]
          },
          "400690427": {
            "id": "400690427",
            "speakerId": 1042,
            "speakerName": "辛焱",
            "text": "风雨中绝不熄灭的烛火，岩洞下永远沸腾的岩浆…无人可挡、无法停止的气魄，这才是我的摇滚。",
            "nextDialogs": [
              "400690428"
            ]
          },
          "400690428": {
            "id": "400690428",
            "speakerId": 1042,
            "speakerName": "辛焱",
            "text": "好了，走啦。",
            "nextDialogs": [
              "400690429"
            ]
          },
          "400690429": {
            "id": "400690429",
            "speakerId": 1042,
            "speakerName": "辛焱",
            "text": "我看旁边有条小路，走那边吧！"
          }
        }
      }
    },
    {
      "subId": "4006918",

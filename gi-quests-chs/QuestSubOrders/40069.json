    {
      "subId": "4006905",
      "subQuestName": "消除小路上的荆棘",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "400690501"
        ],
        "dialogs": {
          "400690501": {
            "id": "400690501",
            "speakerId": 12620,
            "speakerName": "阿飞",
            "text": "呜呜…小蒙，璐璐…为什么不跟我玩？"
          }
        }
      }
    },
    {
      "subId": "4006917",
      "subQuestName": "沿小路前进",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [],
        "dialogs": {}
      }
    },
    {
      "subId": "4006906",
      "subQuestName": "靠近栈桥上的门",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "400690601"
        ],
        "dialogs": {
          "400690601": {
            "id": "400690601",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "咦，那是…",
            "nextDialogs": [
              "400690602"
            ]
          },
          "400690602": {
            "id": "400690602",
            "speakerId": 10095,
            "speakerName": "莫娜",
            "text": "又是「门」，该不会又有那样的人了吧。",
            "nextDialogs": [
              "400690603"
            ]
          },
          "400690603": {
            "id": "400690603",
            "speakerId": 1042,
            "speakerName": "辛焱",
            "text": "小意思，放着我来。",
            "nextDialogs": [
              "400690604"
            ]
          },
          "400690604": {
            "id": "400690604",
            "speakerId": 12620,
            "speakerName": "阿飞",
            "text": "大姐姐，你的发型好奇怪哟。",
            "nextDialogs": [
              "400690605"
            ]
          },
          "400690605": {
            "id": "400690605",
            "speakerId": 1042,
            "speakerName": "辛焱",
            "text": "是吗？我觉得很酷啊，你再好好看看。",
            "nextDialogs": [
              "400690606"
            ]
          },
          "400690606": {
            "id": "400690606",
            "speakerId": 12620,
            "speakerName": "阿飞",
            "text": "竖起来的辫子，尖尖的发饰，别人都不这样。",
            "nextDialogs": [
              "400690607"
            ]
          },
          "400690607": {
            "id": "400690607",
            "speakerId": 1042,
            "speakerName": "辛焱",
            "text": "这话说得不对。我跟别人不一样，那你见了我就会印象深刻，怎么也忘不掉。以后见到我，还能认得我。",
            "nextDialogs": [
              "400690608"
            ]
          },
          "400690608": {
            "id": "400690608",
            "speakerId": 12620,
            "speakerName": "阿飞",
            "text": "嗯…对。",
            "nextDialogs": [
              "400690609"
            ]
          },
          "400690609": {
            "id": "400690609",
            "speakerId": 1042,
            "speakerName": "辛焱",
            "text": "头发衣服，甚至脸皮身段，可不是只给别人看的。自己喜欢什么样，就打扮成什么样。",
            "nextDialogs": [
              "400690610"
            ]
          },
          "400690610": {
            "id": "400690610",
            "speakerId": 12620,
            "speakerName": "阿飞",
            "text": "真的吗？可我要是穿画着小狗的袍子，别人就会说：「阿飞像小狗」。",
            "nextDialogs": [
              "400690611"
            ]
          },
          "400690611": {
            "id": "400690611",
            "speakerId": 1042,
            "speakerName": "辛焱",
            "text": "那你就不听他们的。你喜欢小狗对不对？",
            "nextDialogs": [
              "400690612"
            ]
          },
          "400690612": {
            "id": "400690612",
            "speakerId": 12620,
            "speakerName": "阿飞",
            "text": "喜欢。",
            "nextDialogs": [
              "400690613"
            ]
          },
          "400690613": {
            "id": "400690613",
            "speakerId": 1042,
            "speakerName": "辛焱",
            "text": "你朋友喜不喜欢小狗？",
            "nextDialogs": [
              "400690614"
            ]
          },
          "400690614": {
            "id": "400690614",
            "speakerId": 12620,
            "speakerName": "阿飞",
            "text": "也喜欢。",
            "nextDialogs": [
              "400690615"
            ]
          },
          "400690615": {
            "id": "400690615",
            "speakerId": 1042,
            "speakerName": "辛焱",
            "text": "所以你的朋友肯定喜欢你那件袍子。",
            "nextDialogs": [
              "400690616"
            ]
          },
          "400690616": {
            "id": "400690616",
            "speakerId": 12620,
            "speakerName": "阿飞",
            "text": "…嗯。大姐姐，怎么不扎个讨人喜欢的辫子呢？",
            "nextDialogs": [
              "400690617"
            ]
          },
          "400690617": {
            "id": "400690617",
            "speakerId": 1042,
            "speakerName": "辛焱",
            "text": "没办法，我就喜欢这种有性格的。唉，扎这个之前，我也料不到大家这么不喜欢我的辫子啊。",
            "nextDialogs": [
              "400690618"
            ]
          },
          "400690618": {
            "id": "400690618",
            "speakerId": 12620,
            "speakerName": "阿飞",
            "text": "那不改改吗？",
            "nextDialogs": [
              "400690619"
            ]
          },
          "400690619": {
            "id": "400690619",
            "speakerId": 1042,
            "speakerName": "辛焱",
            "text": "这种发型才符合我的音乐和生活。平日常见的那些都太普通了，不够精神，还妨碍我演出时摇头晃脑。",
            "nextDialogs": [
              "400690620"
            ]
          },
          "400690620": {
            "id": "400690620",
            "speakerId": 1042,
            "speakerName": "辛焱",
            "text": "不喜欢就不喜欢呗，不改了。",
            "nextDialogs": [
              "400690621"
            ]
          },
          "400690621": {
            "id": "400690621",
            "speakerId": 12620,
            "speakerName": "阿飞",
            "text": "那你的朋友也不喜欢吗？",
            "nextDialogs": [
              "400690622"
            ]
          },
          "400690622": {
            "id": "400690622",
            "speakerId": 1042,
            "speakerName": "辛焱",
            "text": "才不会。她们都说，我这辫子好看得很呢。",
            "nextDialogs": [
              "400690623"
            ]
          },
          "400690623": {
            "id": "400690623",
            "speakerId": 12620,
            "speakerName": "阿飞",
            "text": "…朋友会帮你。真好。不像我的朋友…把我丢在这里。呜呜…",
            "nextDialogs": [
              "400690624"
            ]
          },
          "400690624": {
            "id": "400690624",
            "speakerId": 1042,
            "speakerName": "辛焱",
            "text": "哎呀怎么哭了！出什么事了？跟姐姐说说。",
            "nextDialogs": [
              "400690625"
            ]
          },
          "400690625": {
            "id": "400690625",
            "speakerId": 12620,
            "speakerName": "阿飞",
            "text": "璐璐和小蒙…不理我了，呜呜…说好今天约在码头，他们却一直不来…",
            "nextDialogs": [
              "400690626"
            ]
          },
          "400690626": {
            "id": "400690626",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "小小年纪就学会放鸽子了！",
            "nextDialogs": [
              "400690627"
            ]
          },
          "400690627": {
            "id": "400690627",
            "speakerId": 1042,
            "speakerName": "辛焱",
            "text": "你待在这儿别乱跑，我去附近找找。找到了，就带他们来找你。",
            "nextDialogs": [
              "400690628"
            ]
          },
          "400690628": {
            "id": "400690628",
            "speakerId": 12620,
            "speakerName": "阿飞",
            "text": "…嗯！谢谢你，大姐姐。我再也不说你的辫子奇怪了。",
            "nextDialogs": [
              "400690629"
            ]
          },
          "400690629": {
            "id": "400690629",
            "speakerId": 1042,
            "speakerName": "辛焱",
            "text": "哈，算你识相。那一会儿见。"
          }
        }
      }
    },
    {
      "subId": "4006919",
      "subQuestName": "(test)(hide)进对话删除投影门$HIDDEN",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [],
        "dialogs": {}
      }
    },
    {
      "subId": "4006907",
      "subQuestName": "帮阿飞找朋友",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "400690701"
        ],
        "dialogs": {
          "400690701": {
            "id": "400690701",
            "speakerId": 1042,
            "speakerName": "辛焱",
            "text": "你好，你是小蒙吧？有个叫阿飞的孩子在码头上等你，等得太久，都哭了。",
            "nextDialogs": [
              "400690702"
            ]
          },
          "400690702": {
            "id": "400690702",
            "speakerId": 12621,
            "speakerName": "小蒙",
            "text": "啊！他、他怎么这么笨呀，都不知道来找我们…算了，我找他去。",
            "nextDialogs": [
              "400690703"
            ]
          },
          "400690703": {
            "id": "400690703",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "跑掉了，我们快跟上。"
          }
        }
      }
    },
    {
      "subId": "4006914",
      "subQuestName": "帮阿飞找朋友",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "400691401"
        ],
        "dialogs": {
          "400691401": {
            "id": "400691401",
            "speakerId": 1042,
            "speakerName": "辛焱",
            "text": "你好，你是璐璐吗？",
            "nextDialogs": [
              "400691402"
            ]
          },
          "400691402": {
            "id": "400691402",
            "speakerId": 12622,
            "speakerName": "璐璐",
            "text": "大姐姐，你找我吗？",
            "nextDialogs": [
              "400691403"
            ]
          },
          "400691403": {
            "id": "400691403",
            "speakerId": 1042,
            "speakerName": "辛焱",
            "text": "你不是跟阿飞约了要在码头见吗？怎么不去找他？他都急哭了。",
            "nextDialogs": [
              "400691404"
            ]
          },
          "400691404": {
            "id": "400691404",
            "speakerId": 12622,
            "speakerName": "璐璐",
            "text": "咦？这个笨瓜，就不能来找我们吗！亏我们特地准备了惊喜给他。",
            "nextDialogs": [
              "400691405"
            ]
          },
          "400691405": {
            "id": "400691405",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "惊喜？怪事…"
          }
        }
      }
    },
    {
      "subId": "4006915",
      "subQuestName": "(test)(hide)回滚隔离环$HIDDEN",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [],
        "dialogs": {}
      }
    },
    {
      "subId": "4006908",
      "subQuestName": "与阿飞、小蒙和璐璐对话",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "400690801"
        ],
        "dialogs": {
          "400690801": {
            "id": "400690801",
            "speakerId": 12622,
            "speakerName": "璐璐",
            "text": "笨瓜笨瓜，我们给你准备惊喜呢，谁知道你都不来找我们，还、还哭了…",
            "nextDialogs": [
              "400690802"
            ]
          },
          "400690802": {
            "id": "400690802",
            "speakerId": 12620,
            "speakerName": "阿飞",
            "text": "对不起，我是笨瓜。",
            "nextDialogs": [
              "400690803"
            ]
          },
          "400690803": {
            "id": "400690803",
            "speakerId": 12622,
            "speakerName": "璐璐",
            "text": "不是啦！你不是笨瓜，是我们不好…不该吓唬你。",
            "nextDialogs": [
              "400690804"
            ]
          },
          "400690804": {
            "id": "400690804",
            "speakerId": 12621,
            "speakerName": "小蒙",
            "text": "阿飞，今天是你生日，我们本来想给你个惊喜，让你吓一大跳，才故意躲着你。",
            "nextDialogs": [
              "400690805"
            ]
          },
          "400690805": {
            "id": "400690805",
            "speakerId": 12620,
            "speakerName": "阿飞",
            "text": "咦？这是…",
            "nextDialogs": [
              "400690806"
            ]
          },
          "400690806": {
            "id": "400690806",
            "speakerId": 12621,
            "speakerName": "小蒙",
            "text": "给你准备了很多莲蓬，好吃的。还有我和璐璐亲手写的祝福信…不能说我们字丑。",
            "nextDialogs": [
              "400690807"
            ]
          },
          "400690807": {
            "id": "400690807",
            "speakerId": 12622,
            "speakerName": "璐璐",
            "text": "哼哼。",
            "nextDialogs": [
              "400690808"
            ]
          },
          "400690808": {
            "id": "400690808",
            "speakerId": 12620,
            "speakerName": "阿飞",
            "text": "你们…嘿嘿，谢谢你们…",
            "nextDialogs": [
              "400690809"
            ]
          },
          "400690809": {
            "id": "400690809",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "搞了半天是这么一回事呀。",
            "nextDialogs": [
              "400690810"
            ]
          },
          "400690810": {
            "id": "400690810",
            "speakerId": 1032,
            "speakerName": "枫原万叶",
            "text": "虚惊一场。",
            "nextDialogs": [
              "400690811"
            ]
          },
          "400690811": {
            "id": "400690811",
            "speakerId": 1042,
            "speakerName": "辛焱",
            "text": "朋友嘛，干出这种事也不奇怪。要是我朋友给我准备惊喜，我也会被吓一跳。",
            "nextDialogs": [
              "400690812"
            ]
          },
          "400690812": {
            "id": "400690812",
            "speakerId": 10095,
            "speakerName": "莫娜",
            "text": "是在暗示我们给你惊喜吗？好高明的话术…",
            "nextDialogs": [
              "400690813"
            ]
          },
          "400690813": {
            "id": "400690813",
            "speakerId": 1042,
            "speakerName": "辛焱",
            "text": "欸？啊不是不是啦！我就是随口一说…",
            "nextDialogs": [
              "400690814"
            ]
          },
          "400690814": {
            "id": "400690814",
            "speakerId": 10095,
            "speakerName": "莫娜",
            "text": "我知道啦。我也是开玩笑，就想吓你一跳。",
            "nextDialogs": [
              "400690815"
            ]
          },
          "400690815": {
            "id": "400690815",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "啊…是我肚子饿了…",
            "nextDialogs": [
              "400690816"
            ]
          },
          "400690816": {
            "id": "400690816",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "声音未免太响了！",
            "nextDialogs": [
              "400690817"
            ]
          },
          "400690817": {
            "id": "400690817",
            "speakerId": 1042,
            "speakerName": "辛焱",
            "text": "确实快到饭点了，我想想…要不然，去我家吃饭吧？离这儿不远，一直走就到了。",
            "nextDialogs": [
              "400690818"
            ]
          },
          "400690818": {
            "id": "400690818",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "幻境里也有家吗？",
            "nextDialogs": [
              "400690819"
            ]
          },
          "400690819": {
            "id": "400690819",
            "speakerId": 1042,
            "speakerName": "辛焱",
            "text": "有啊。我刚看了，这条路和现实中一样，就通往我家。",
            "nextDialogs": [
              "400690820"
            ]
          },
          "400690820": {
            "id": "400690820",
            "speakerId": 1042,
            "speakerName": "辛焱",
            "text": "虽然是在幻境里，但不论是跟邻里意见不合，还是表演失败失望而归…",
            "nextDialogs": [
              "400690821"
            ]
          },
          "400690821": {
            "id": "400690821",
            "speakerId": 1042,
            "speakerName": "辛焱",
            "text": "假如有什么非去不可的地方，我猜也就是那里了。因为…人嘛，总要回家的。"
          }
        }
      }
    },
    {
      "subId": "4006912",
      "subQuestName": "进入辛焱家",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "400691201"
        ],
        "dialogs": {
          "400691201": {
            "id": "400691201",
            "speakerId": 1042,
            "speakerName": "辛焱",
            "text": "到了到了，大家随意，进门不用换鞋！",
            "nextDialogs": [
              "400691202"
            ]
          },
          "400691202": {
            "id": "400691202",
            "speakerId": 1032,
            "speakerName": "枫原万叶",
            "text": "抱歉打扰了。",
            "nextDialogs": [
              "400691203"
            ]
          },
          "400691203": {
            "id": "400691203",
            "speakerId": 10095,
            "speakerName": "莫娜",
            "text": "有椅子呢，正好可以坐一会儿。",
            "nextDialogs": [
              "400691204"
            ]
          },
          "400691204": {
            "id": "400691204",
            "speakerId": 1042,
            "speakerName": "辛焱",
            "text": "嗯？里面的屋子好像有声音…你们休息，我去看一眼。",
            "nextDialogs": [
              "400691205"
            ]
          },
          "400691205": {
            "id": "400691205",
            "speakerId": 1042,
            "speakerName": "辛焱",
            "text": "灯都没亮，没人在…哇啊？！",
            "nextDialogs": [
              "400691206"
            ]
          },
          "400691206": {
            "id": "400691206",
            "speakerId": 1017,
            "speakerName": "香菱&云堇",
            "text": "噔噔噔！生日快乐！",
            "nextDialogs": [
              "400691207"
            ]
          },
          "400691207": {
            "id": "400691207",
            "speakerId": 1042,
            "speakerName": "辛焱",
            "text": "你们干嘛啊！那么大两个人坐在屋里还不开灯，想吓死我呀！",
            "nextDialogs": [
              "400691208"
            ]
          },
          "400691208": {
            "id": "400691208",
            "speakerId": 1012,
            "speakerName": "香菱",
            "text": "云堇你说对了，她真的会被吓到！",
            "nextDialogs": [
              "400691209"
            ]
          },
          "400691209": {
            "id": "400691209",
            "speakerId": 1046,
            "speakerName": "云堇",
            "text": "难得的生日，来点惊喜才好呀。",
            "nextDialogs": [
              "400691210"
            ]
          },
          "400691210": {
            "id": "400691210",
            "speakerId": 1042,
            "speakerName": "辛焱",
            "text": "你们两个不要顶着可爱的脸做这种事行不行。",
            "nextDialogs": [
              "400691211"
            ]
          },
          "400691211": {
            "id": "400691211",
            "speakerId": 1046,
            "speakerName": "云堇",
            "text": "哎？这话呀，我可是不爱听的。谁规定长得乖巧可爱就不能开恶作剧玩笑啦？是不是呀香菱。",
            "nextDialogs": [
              "400691212"
            ]
          },
          "400691212": {
            "id": "400691212",
            "speakerId": 1012,
            "speakerName": "香菱",
            "text": "就是就是！锅巴长那样，不也很灵活嘛。",
            "nextDialogs": [
              "400691213"
            ]
          },
          "400691213": {
            "id": "400691213",
            "speakerId": 1042,
            "speakerName": "辛焱",
            "text": "行行行，说不过你们。",
            "nextDialogs": [
              "400691214"
            ]
          },
          "400691214": {
            "id": "400691214",
            "speakerId": 1012,
            "speakerName": "香菱",
            "text": "北斗姐今天有事，托我们带话给你，她就不亲自过来啦，给你的礼物由我转交。",
            "nextDialogs": [
              "400691215"
            ]
          },
          "400691215": {
            "id": "400691215",
            "speakerId": 1012,
            "speakerName": "香菱",
            "text": "来，这是北斗姐送你的外国乐谱和特制匕首！",
            "nextDialogs": [
              "400691216"
            ]
          },
          "400691216": {
            "id": "400691216",
            "speakerId": 1046,
            "speakerName": "云堇",
            "text": "辛焱，我专程差家里人给你打了金发簪和铁发圈哦。",
            "nextDialogs": [
              "400691217"
            ]
          },
          "400691217": {
            "id": "400691217",
            "speakerId": 1042,
            "speakerName": "辛焱",
            "text": "铁发圈？！你千年的打铁世家，就打这个？",
            "nextDialogs": [
              "400691218"
            ]
          },
          "400691218": {
            "id": "400691218",
            "speakerId": 1046,
            "speakerName": "云堇",
            "text": "怎么了？发圈这是麻雀虽小五脏俱全呀。",
            "nextDialogs": [
              "400691219"
            ]
          },
          "400691219": {
            "id": "400691219",
            "speakerId": 1012,
            "speakerName": "香菱",
            "text": "嘻嘻，我就不一样喽。不久前，我在路边看到个戴眼镜的铁匠，瞧他那样子，好像能看懂石头一样。",
            "nextDialogs": [
              "400691220"
            ]
          },
          "400691220": {
            "id": "400691220",
            "speakerId": 1012,
            "speakerName": "香菱",
            "text": "我不信邪，请他帮我选石头，没想到真能开出翡翠来！嘿嘿，我当场拿去磨成吊坠大小，拿绳子串起来，给你当挂件用。",
            "nextDialogs": [
              "400691221"
            ]
          },
          "400691221": {
            "id": "400691221",
            "speakerId": 1042,
            "speakerName": "辛焱",
            "text": "哇，你做了个翡翠吊坠给我？",
            "nextDialogs": [
              "400691222"
            ]
          },
          "400691222": {
            "id": "400691222",
            "speakerId": 1012,
            "speakerName": "香菱",
            "text": "对呀，啊啊不是挂在脖子上的哦，挂琴上！天天看你宝贝你那把琴，我就想着，早晚也给它打扮起来。",
            "nextDialogs": [
              "400691223"
            ]
          },
          "400691223": {
            "id": "400691223",
            "speakerId": 1042,
            "speakerName": "辛焱",
            "text": "这么宝贵的礼物我可不舍得用，得供起来！谢谢你香菱，你好细心。",
            "nextDialogs": [
              "400691224"
            ]
          },
          "400691224": {
            "id": "400691224",
            "speakerId": 1046,
            "speakerName": "云堇",
            "text": "嘻嘻，香菱心细也不是一两天的事了。不过那人居然能看懂石头…你再说说这事。要是好玩，我得写进戏里。",
            "nextDialogs": [
              "400691225"
            ]
          },
          "400691225": {
            "id": "400691225",
            "speakerId": 1012,
            "speakerName": "香菱",
            "text": "我也不晓得，听说他是病了一阵子，那期间浑浑噩噩的，什么都不记得，身体像是不属于自己一样…",
            "nextDialogs": [
              "400691226"
            ]
          },
          "400691226": {
            "id": "400691226",
            "speakerId": 1012,
            "speakerName": "香菱",
            "text": "再后来，砰地一下就好了！只是不知为什么，从那天起，看一眼就能分辨石头好坏了。",
            "nextDialogs": [
              "400691227"
            ]
          },
          "400691227": {
            "id": "400691227",
            "speakerId": 1046,
            "speakerName": "云堇",
            "text": "嗯…可真是怪事。",
            "nextDialogs": [
              "400691228"
            ]
          },
          "400691228": {
            "id": "400691228",
            "speakerId": 1012,
            "speakerName": "香菱",
            "text": "噢噢，不说这些了，菜都要凉啦，开吃开吃。",
            "nextDialogs": [
              "400691229"
            ]
          },
          "400691229": {
            "id": "400691229",
            "speakerId": 1046,
            "speakerName": "云堇",
            "text": "且慢，辛焱，你不是从外国商人那里学了一招嘛？上回我生日时候，你教我的那个。",
            "nextDialogs": [
              "400691230"
            ]
          },
          "400691230": {
            "id": "400691230",
            "speakerId": 1042,
            "speakerName": "辛焱",
            "text": "嗯？噢，你是说许生日愿望对吧？",
            "nextDialogs": [
              "400691231"
            ]
          },
          "400691231": {
            "id": "400691231",
            "speakerId": 1046,
            "speakerName": "云堇",
            "text": "对对，就是那个。在外国还要点蜡烛切蛋糕，我们可没顾上这些，光忙着帮香菱把饭菜提过来了。",
            "nextDialogs": [
              "400691232"
            ]
          },
          "400691232": {
            "id": "400691232",
            "speakerId": 1042,
            "speakerName": "辛焱",
            "text": "没事，我自己想像一下就有了。",
            "nextDialogs": [
              "400691233"
            ]
          },
          "400691233": {
            "id": "400691233",
            "speakerId": 1046,
            "speakerName": "云堇",
            "text": "那我们数一二三，你来许愿。",
            "nextDialogs": [
              "400691234"
            ]
          },
          "400691234": {
            "id": "400691234",
            "speakerId": 1046,
            "speakerName": "云堇",
            "text": "一——",
            "nextDialogs": [
              "400691235"
            ]
          },
          "400691235": {
            "id": "400691235",
            "speakerId": 1012,
            "speakerName": "香菱",
            "text": "二——",
            "nextDialogs": [
              "400691236"
            ]
          },
          "400691236": {
            "id": "400691236",
            "speakerId": 1046,
            "speakerName": "云堇",
            "text": "三——",
            "nextDialogs": [
              "400691237"
            ]
          },
          "400691237": {
            "id": "400691237",
            "speakerId": 1042,
            "speakerName": "辛焱",
            "text": "嗯~今年许个什么愿望好呢？",
            "nextDialogs": [
              "400691238"
            ]
          },
          "400691238": {
            "id": "400691238",
            "speakerId": 1042,
            "speakerName": "辛焱",
            "text": "我的愿望是…"
          }
        }
      }
    },
    {
      "subId": "4006924",
      "subQuestName": "(test)(hide)隐藏开灯$HIDDEN",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [],
        "dialogs": {}
      }
    },
    {
      "subId": "4006913",
      "subQuestName": "与众人对话",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "400691301"
        ],
        "dialogs": {
          "400691301": {
            "id": "400691301",
            "speakerId": 1042,
            "speakerName": "辛焱",
            "text": "咦，回来了？",
            "nextDialogs": [
              "400691302"
            ]
          },
          "400691302": {
            "id": "400691302",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "怎么回事？我才刚凑到门缝里看了没多久啊。",
            "nextDialogs": [
              "400691303"
            ]
          },
          "400691303": {
            "id": "400691303",
            "speakerId": 10095,
            "speakerName": "莫娜",
            "text": "既然是幻境，辛焱，你刚才在屋里遇到什么事了吗？",
            "nextDialogs": [
              "400691304"
            ]
          },
          "400691304": {
            "id": "400691304",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "我知道我知道，她见到了给她过生日的朋友！",
            "nextDialogs": [
              "400691305"
            ]
          },
          "400691305": {
            "id": "400691305",
            "speakerId": 10095,
            "speakerName": "莫娜",
            "text": "那些我也听到了啦！我是说她自己。",
            "nextDialogs": [
              "400691306"
            ]
          },
          "400691306": {
            "id": "400691306",
            "speakerId": 1042,
            "speakerName": "辛焱",
            "text": "我自己…啊！我许了个愿。",
            "nextDialogs": [
              "400691307"
            ]
          },
          "400691307": {
            "id": "400691307",
            "speakerId": 1042,
            "speakerName": "辛焱",
            "text": "说起来，这事也有点意思。我不是推门进去吗？屋里居然是香菱和云堇，我的两个好朋友！",
            "nextDialogs": [
              "400691310"
            ]
          },
          "400691310": {
            "id": "400691310",
            "speakerId": 1042,
            "speakerName": "辛焱",
            "text": "这可是现实中发生过的事，上回生日，她俩跑我家给了我一个大惊喜，做了一桌好吃的，让我许生日愿望。",
            "nextDialogs": [
              "400691311"
            ]
          },
          "400691311": {
            "id": "400691311",
            "speakerId": 10095,
            "speakerName": "莫娜",
            "text": "辛焱，你的生日愿望是什么？",
            "nextDialogs": [
              "400691312"
            ]
          },
          "400691312": {
            "id": "400691312",
            "speakerId": 1042,
            "speakerName": "辛焱",
            "text": "我的愿望是——「跟大家意想不到的人一起办演唱会」。",
            "nextDialogs": [
              "400691313"
            ]
          },
          "400691313": {
            "id": "400691313",
            "speakerId": 1032,
            "speakerName": "枫原万叶",
            "text": "意想不到的人，会是谁呢？",
            "nextDialogs": [
              "400691314"
            ]
          },
          "400691314": {
            "id": "400691314",
            "speakerId": 1042,
            "speakerName": "辛焱",
            "text": "关于这件事，我在刚才一瞬间想通了。",
            "nextDialogs": [
              "400691315"
            ]
          },
          "400691315": {
            "id": "400691315",
            "speakerId": 1032,
            "speakerName": "枫原万叶",
            "text": "有答案了？",
            "nextDialogs": [
              "400691316"
            ]
          },
          "400691316": {
            "id": "400691316",
            "speakerId": 1042,
            "speakerName": "辛焱",
            "text": "嗯。不过，公布答案之前，我想先疏通那些贯穿山石的水脉。"
          }
        }
      }
    },
    {
      "subId": "4006910",
      "subQuestName": "进入辛焱家$HIDDEN",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [],
        "dialogs": {}
      }
    },
    {
      "subId": "4006999",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "400699901"
        ],
        "dialogs": {
          "400699901": {
            "id": "400699901",
            "speakerId": 10095,
            "speakerName": "莫娜",
            "text": "你心态真好，假如有人说我不是天才，我一定会生气。",
            "nextDialogs": [
              "400699902"
            ]
          },
          "400699902": {
            "id": "400699902",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "真的？我有点想试试…咿你们看！莫娜瞪我！",
            "nextDialogs": [
              "400699903"
            ]
          },
          "400699903": {
            "id": "400699903",
            "speakerId": 1042,
            "speakerName": "辛焱",
            "text": "派蒙，你是在用摇滚精神触碰禁忌吗…",
            "nextDialogs": [
              "400699904"
            ]
          },
          "400699904": {
            "id": "400699904",
            "speakerId": 1032,
            "speakerName": "枫原万叶",
            "text": "实不相瞒，我都开始对摇滚有点兴趣了。",
            "nextDialogs": [
              "400699905"
            ]
          },
          "400699905": {
            "id": "400699905",
            "speakerId": 1042,
            "speakerName": "辛焱",
            "text": "是不是真心的啊？别糊弄人啊。",
            "nextDialogs": [
              "400699906"
            ]
          },
          "400699906": {
            "id": "400699906",
            "speakerId": 1032,
            "speakerName": "枫原万叶",
            "text": "当然不是玩笑了。摇滚能给人带去那么坚强的意志，单凭这点足矣。"
          }
        }
      }
    }
  ]
}
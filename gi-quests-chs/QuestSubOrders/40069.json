    {
      "subId": "4006902",
      "subQuestName": "与火炽之心对话",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "400690201"
        ],
        "dialogs": {
          "400690201": {
            "id": "400690201",
            "speakerId": 1001,
            "speakerName": "Black Screen",
            "text": "辛焱将泉水倒入花中…",
            "nextDialogs": [
              "400690202"
            ]
          },
          "400690202": {
            "id": "400690202",
            "speakerId": 12616,
            "speakerName": "火炽之心",
            "text": "感觉好多了。很有效，谢谢你们。",
            "nextDialogs": [
              "400690203"
            ]
          },
          "400690203": {
            "id": "400690203",
            "speakerId": 12616,
            "speakerName": "火炽之心",
            "text": "接下来，我会送各位去你们想去的地方。",
            "nextDialogs": [
              "400690204"
            ]
          },
          "400690204": {
            "id": "400690204",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "呜啊！"
          }
        }
      }
    },

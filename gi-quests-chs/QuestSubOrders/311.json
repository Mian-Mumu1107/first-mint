  "subQuests": [
    {
      "subId": "31101",
      "subQuestName": "(test)与派蒙对话$HIDDEN",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "3090201"
        ],
        "dialogs": {
          "3090201": {
            "id": "3090201",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "呼，可算是全部处理完了。",
            "nextDialogs": [
              "3090202"
            ]
          },
          "3090202": {
            "id": "3090202",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "这样蒙德的元素流动、地脉循环就会恢复正常了吧。",
            "nextDialogs": [
              "3090203"
            ]
          },
          "3090203": {
            "id": "3090203",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "要回去看看<color=#00E1FFFF>骑士团</color>的情况吗？",
            "nextDialogs": [
              "3090204"
            ]
          },
          "3090204": {
            "id": "3090204",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "当然，如果有什么别的有趣的事要做，我也可以陪你先去喔。",
            "nextDialogs": [
              "3090205"
            ]
          },
          "3090205": {
            "id": "3090205",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "比如去蒙德购物…或者一起再去看看<color=#00E1FFFF>七天神像</color>？",
            "nextDialogs": [
              "3090206"
            ]
          },
          "3090206": {
            "id": "3090206",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "之前我们在四风守护的庙宇里，得到了一种好像凝固的风一样的东西吧。",
            "nextDialogs": [
              "3090207"
            ]
          },
          "3090207": {
            "id": "3090207",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "在蒙德，人们把它叫做「散失的风神瞳」。",
            "nextDialogs": [
              "3090208"
            ]
          },
          "3090208": {
            "id": "3090208",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "这个名字代表的是：它有资格被镶嵌在神像的眼眶里。",
            "nextDialogs": [
              "3090209"
            ]
          },
          "3090209": {
            "id": "3090209",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "有童话说，是燕子衔走了作为眼睛的宝石…",
            "nextDialogs": [
              "3090210"
            ]
          },
          "3090210": {
            "id": "3090210",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "但其实「散失的风神瞳」本来就没有实体。",
            "nextDialogs": [
              "3090212"
            ]
          },
          "3090212": {
            "id": "3090212",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "拥有「神之眼」的人会注意收集它们，送去<color=#00E1FFFF>七天神像</color>，获取赐福。",
            "nextDialogs": [
              "3090213"
            ]
          },
          "3090213": {
            "id": "3090213",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "虽然你没有「神之眼」，但你超脱这个世界的常理…",
            "nextDialogs": [
              "3090214"
            ]
          },
          "3090214": {
            "id": "3090214",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "想试试的话，就出发吧！",
            "nextDialogs": [
              "3090215"
            ]
          },
          "3090215": {
            "id": "3090215",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "风起地的那座七天神像，应该就是离我们最近的一座。",
            "nextDialogs": [
              "3090216"
            ]
          },
          "3090216": {
            "id": "3090216",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "我很期待…这一次，神明又会怎样回应你！"
          }
        }
      }
    },
    {
      "subId": "30904",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "3090402"
        ],
        "dialogs": {
          "3090402": {
            "id": "3090402",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "这样蒙德的元素流动、地脉循环就会恢复正常了吧。",
            "nextDialogs": [
              "3090403"
            ]
          },
          "3090403": {
            "id": "3090403",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "要回去看看<color=#00E1FFFF>骑士团</color>的情况吗？",
            "nextDialogs": [
              "3090404"
            ]
          },
          "3090404": {
            "id": "3090404",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "当然，如果有什么别的有趣的事要做，我也可以陪你先去喔。",
            "nextDialogs": [
              "3090405"
            ]
          },
          "3090405": {
            "id": "3090405",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "对了，我们在四风守护的庙宇里，又得到了「散失的风神瞳」吧。",
            "nextDialogs": [
              "3090406"
            ]
          },
          "3090406": {
            "id": "3090406",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "以后也许会收集得越来越多，不要忘了它们的用处啊。"
          }
        }
      }
    }
  ]
}
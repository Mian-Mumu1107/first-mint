    {
      "subId": "7600021",
      "subQuestName": "与派蒙对话",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "760000801"
        ],
        "dialogs": {
          "760000801": {
            "id": "760000801",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "看来他们的确在进行实验，不过实验的场地好像不止这里一处，在地面上也有三处。",
            "nextDialogs": [
              "760000802"
            ]
          },
          "760000802": {
            "id": "760000802",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "#说是要收集三处的数据汇总到这儿进行分析呢。{NICKNAME}，你说要是我们先把数据都拿走…",
            "nextDialogs": [
              "760000803"
            ]
          },
          "760000803": {
            "id": "760000803",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "唔，也有点好奇实验的结果到底是什么，不如…不如我们把三处的数据带回来，看过结论之后再把它们都拿走！",
            "nextDialogs": [
              "760000805",
              "760000807"
            ]
          },
          "760000805": {
            "id": "760000805",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "哎呀，重点不是我们有，而是让愚人众没有！",
            "nextDialogs": [
              "760000808"
            ]
          },
          "760000808": {
            "id": "760000808",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "#而且{NICKNAME}就不想知道结论吗，总会有那么一点点好奇的吧？我们就试试看嘛。"
          },
          "760000807": {
            "id": "760000807",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "那、那样的话不会闹得太大吗？还是不要因为这种小事闹出那么大的动静吧…"
          }
        }
      }
    },

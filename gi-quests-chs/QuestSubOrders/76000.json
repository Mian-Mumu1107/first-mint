    {
      "subId": "7600006",
      "subQuestName": "与派蒙对话",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "760000601"
        ],
        "dialogs": {
          "760000601": {
            "id": "760000601",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "好多罐子！而且里面装的…该不会是月矩力吧？",
            "nextDialogs": [
              "760000602"
            ]
          },
          "760000602": {
            "id": "760000602",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "愚人众在这么深的地下放这些东西，到底是要做什么…",
            "nextDialogs": [
              "760000604",
              "760000606"
            ]
          },
          "760000604": {
            "id": "760000604",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "这我当然知道啦！可到底是拿来做什么用呢？总不会是用来泡澡吧？",
            "nextDialogs": [
              "760000607"
            ]
          },
          "760000607": {
            "id": "760000607",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "#{NICKNAME}，总之我们先在这里调查看看好了，说不定能发现什么线索。"
          },
          "760000606": {
            "id": "760000606",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "真是太邪恶了愚人众！可是到底是什么邪恶实验啊？"
          }
        }
      }
    },
    {
      "subId": "7600007",
      "subQuestName": "在附近寻找线索",
      "sceneId": null,
      "locations": [],
      "dialogue": {

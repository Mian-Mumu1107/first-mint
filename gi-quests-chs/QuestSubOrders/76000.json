    {
      "subId": "7600002",
      "subQuestName": "调查入口",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "760000201"
        ],
        "dialogs": {
          "760000201": {
            "id": "760000201",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "唔…这扇门好像没办法打开。不过真的好好奇里面到底有什么…",
            "nextDialogs": [
              "760000203",
              "760000205"
            ]
          },
          "760000203": {
            "id": "760000203",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "从地理位置上看，的确这边不太可能放太重要的东西…",
            "nextDialogs": [
              "760000206"
            ]
          },
          "760000206": {
            "id": "760000206",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "不管怎么说，我们还是想办法进去看看吧！不然感觉谜团一直留在心里，就像吃了太多挪德卡莱热狗消化不了一样难受。",
            "nextDialogs": [
              "760000207"
            ]
          },
          "760000207": {
            "id": "760000207",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "门虽然打不开，说不定有别的路可以进去呢。"
          },
          "760000205": {
            "id": "760000205",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "邪、邪恶的实验…如果是这样的话，这里的戒备也太宽松了吧！"
          }
        }
      }
    },

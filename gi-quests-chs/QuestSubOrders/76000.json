        "dialogs": {}
      }
    },
    {
      "subId": "7600016",
      "subQuestName": "与派蒙对话",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "760001601"
        ],
        "dialogs": {
          "760001601": {
            "id": "760001601",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "总算是赶走他们了，欸？这机器不显示了…难道是刚才被打坏了？还是被愚人众关掉了？",
            "nextDialogs": [
              "760001602"
            ]
          },
          "760001602": {
            "id": "760001602",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "可恶，到最后还是没看到结论是什么…",
            "nextDialogs": [
              "760001603"
            ]
          },
          "760001603": {
            "id": "760001603",
            "speakerId": 10205,
            "speakerName": "？？？",
            "text": "……",
            "nextDialogs": [
              "760001604"
            ]
          },
          "760001604": {
            "id": "760001604",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "#…{NICKNAME}，你有没有听到什么奇怪的声音？好、好像是从那边传过来的…"
          }
        }
      }
    },
    {
      "subId": "7600017",
      "subQuestName": "调查奇怪声音的源头",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "760001701"
        ],
        "dialogs": {
          "760001701": {
            "id": "760001701",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "…哇！是白色的盗宝鼬？我还从来没见过这么白的盗宝鼬呢。",
            "nextDialogs": [
              "760001702"
            ]
          },
          "760001702": {
            "id": "760001702",
            "speakerId": 22101,
            "speakerName": "白色的盗宝鼬",
            "text": "……",
            "nextDialogs": [
              "760001703"
            ]
          },
          "760001703": {
            "id": "760001703",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "我、我的摩拉！小偷！别跑！",
            "nextDialogs": [
              "760001704"
            ]
          },
          "760001704": {
            "id": "760001704",
            "speakerId": 1008,
            "speakerName": "Black Screen",
            "text": "追赶不及，还是让白色盗宝鼬逃脱了…",
            "nextDialogs": [
              "760001705"
            ]
          },
          "760001705": {
            "id": "760001705",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "可恶，一溜烟就跑掉了…",
            "nextDialogs": [
              "760001706"
            ]
          },
          "760001706": {
            "id": "760001706",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "幸好我没损失。",
            "nextDialogs": [
              "760001707"
            ]
          },
          "760001707": {
            "id": "760001707",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "可是我有呀！我的小金库，呜呜…如果再让我遇到它，一定要让它加倍奉还！"
          }
        }
      }
    },
    {
      "subId": "7600099",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "760009901"
        ],
        "dialogs": {
          "760009901": {
            "id": "760009901",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "咦？这里可以进去？我还以为这种充满秘密的地方会更加戒备森严呢。",
            "nextDialogs": [
              "760009902"
            ]
          },
          "760009902": {
            "id": "760009902",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "哇——居然在地下这么深的地方！",
            "nextDialogs": [
              "760009903"
            ]
          },
          "760009903": {
            "id": "760009903",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "什么嘛…果然还是封上的！",
            "nextDialogs": [
              "760009904"
            ]
          },
          "760009904": {
            "id": "760009904",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "不过越来越让人好奇了，这里到底是做什么的设施呢？如果能进去看看的话…",
            "nextDialogs": [
              "760009905"
            ]
          },
          "760009905": {
            "id": "760009905",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "居然有陷阱！但是没听到警报的声音欸。",
            "nextDialogs": [
              "760009906"
            ]
          },
          "760009906": {
            "id": "760009906",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "该不会工作人员也得自己想办法通过吧？好歹毒的设计…",
            "nextDialogs": [
              "760009907"
            ]
          },
          "760009907": {
            "id": "760009907",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "还要向下？这些人每天在不见天日的地方工作，不会觉得难受吗？",
            "nextDialogs": [
              "760009908"
            ]
          },
          "760009908": {
            "id": "760009908",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "啊，说不定就是因为看不到太阳，所以也不知道什么时候该下班了，真是可怕！",
            "nextDialogs": [
              "760009909"
            ]
          },
          "760009909": {
            "id": "760009909",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "这样三处的数据都拿到了，我们回地下的实验室吧！",
            "nextDialogs": [
              "760009910"
            ]
          },
          "760009910": {
            "id": "760009910",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "#{NICKNAME}，快把收集到的数据放进去吧！",
            "nextDialogs": [
              "760009911"
            ]
          },
          "760009911": {
            "id": "760009911",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "这是什么…好像是记录数据的东西？"
          }
        }
      }
    }
  ]

    {
      "subId": "7600014",
      "subQuestName": "与派蒙对话",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "760001401"
        ],
        "dialogs": {
          "760001401": {
            "id": "760001401",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "我们被关起来了！果然这也是陷阱吧，该怎么出去…",
            "nextDialogs": [
              "760001402"
            ]
          },
          "760001402": {
            "id": "760001402",
            "speakerId": 21819,
            "speakerName": "霍洛多夫",
            "text": "装置被启动了？难道说…",
            "nextDialogs": [
              "760001403"
            ]
          },
          "760001403": {
            "id": "760001403",
            "speakerId": 21819,
            "speakerName": "霍洛多夫",
            "text": "让我看看这又是哪里来的鼠辈…是你们？你们就是破坏了试验场地的犯人吧！居然跑到这里自投罗网！",
            "nextDialogs": [
              "760001404"
            ]
          },
          "760001404": {
            "id": "760001404",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "#{NICKNAME}，我们可不能在这儿挨打啊，得想办法解除屏障才行！"
          }
        }
      }
    },
    {
      "subId": "7600015",
      "subQuestName": "设法脱困",
      "sceneId": null,
      "locations": [],
      "dialogue": {

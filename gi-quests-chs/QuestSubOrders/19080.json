        ],
        "dialogs": {
          "190730902": {
            "id": "190730902",
            "speakerId": 13304,
            "speakerName": "「卡布斯」",
            "text": "你怎么擅自回来了？",
            "nextDialogs": [
              "190730901"
            ]
          },
          "190730901": {
            "id": "190730901",
            "speakerId": 13305,
            "speakerName": "「贡达法」",
            "text": "带着王子的书信，我离开了前线回到王庭。我的王，贡达法求见。"
          }
        }
      }
    },
    {
      "subId": "1908021",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "190802157"
        ],
        "dialogs": {
          "190802157": {
            "id": "190802157",
            "speakerId": 13308,
            "speakerName": "「白老先生」",
            "text": "反面。"
          }
        }
      }
    },
    {
      "subId": "1908025",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "190802501"
        ],
        "dialogs": {
          "190802501": {
            "id": "190802501",
            "speakerId": 1004,
            "speakerName": "凯亚",
            "text": "喂喂，你不会信了吧，我像是会把人情记在本上的人吗？"
          }
        }
      }
    },
    {
      "subId": "1908027",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "190802701"
        ],
        "dialogs": {
          "190802701": {
            "id": "190802701",
            "speakerId": 2010,
            "speakerName": "茶博士刘苏",
            "text": "可怜英雄寿短，可叹儿女情长。欲知这虬髯公的妹妹命运究竟如何…咱们啊，下回再表。"
          }
        }
      }
    },
    {
      "subId": "1908035",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "190803501"
        ],
        "dialogs": {
          "190803501": {
            "id": "190803501",
            "speakerId": 13340,
            "speakerName": "张大姐",
            "text": "这骗子真不是东西！",
            "nextDialogs": [
              "190803502"
            ]
          },
          "190803502": {
            "id": "190803502",
            "speakerId": 13319,
            "speakerName": "光之",
            "text": "老吴别慌，你要报案我们陪你一块儿去。",
            "nextDialogs": [
              "190803503"
            ]
          },
          "190803503": {
            "id": "190803503",
            "speakerId": 2041,
            "speakerName": "吴船长",
            "text": "这钱应该能拿回来吧…应该…"
          }
        }
      }
    },
    {
      "subId": "1908036",
      "subQuestName": "Additional",

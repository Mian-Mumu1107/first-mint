      "locations": [],
      "dialogue": {
        "startDialogs": [
          "190803601"
        ],
        "dialogs": {
          "190803601": {
            "id": "190803601",
            "speakerId": 13319,
            "speakerName": "光之",
            "text": "放心，我有数。",
            "nextDialogs": [
              "190803602"
            ]
          },
          "190803602": {
            "id": "190803602",
            "speakerId": 13340,
            "speakerName": "张大姐",
            "text": "是啊，都是街坊邻居，老吴的忙我们肯定帮。"
          }
        }
      }
    },
    {
      "subId": "1908037",
      "subQuestName": "Additional",

      }
    },
    {
      "subId": "2401405",
      "subQuestName": "前往浅水区投放鱼苗",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "240140501"
        ],
        "dialogs": {
          "240140501": {
            "id": "240140501",
            "speakerId": 13409,
            "speakerName": "莉诺蕾娅",
            "text": "你帮我把鱼苗投入水里了吗？看这潜水服的状态，我暂时没法帮忙…只能看你的了。"
          }
        }
      }
    },
    {
      "subId": "2401406",
      "subQuestName": "前往浅水区投放鱼苗",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "240140601"
        ],
        "dialogs": {
          "240140601": {
            "id": "240140601",
            "speakerId": 13409,
            "speakerName": "莉诺蕾娅",
            "text": "你帮我把鱼苗投入水里了吗？",
            "nextDialogs": [
              "240140602"
            ]
          },
          "240140602": {
            "id": "240140602",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "投放好了。",
            "nextDialogs": [
              "240140603"
            ]
          },
          "240140603": {
            "id": "240140603",
            "speakerId": 13409,
            "speakerName": "莉诺蕾娅",
            "text": "太感谢您了。等我修好潜水服之后，就会回去继续工作。",
            "nextDialogs": [
              "240140604"
            ]
          },
          "240140604": {
            "id": "240140604",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "希望那些鱼能好好长大。",
            "nextDialogs": [
              "240140605"
            ]
          },
          "240140605": {
            "id": "240140605",
            "speakerId": 13409,
            "speakerName": "莉诺蕾娅",
            "text": "放心吧。针对每一片水域不同的生态环境，我们准备了许多不同种类的鱼苗。",
            "nextDialogs": [
              "240140606"
            ]
          },
          "240140606": {
            "id": "240140606",
            "speakerId": 13409,
            "speakerName": "莉诺蕾娅",
            "text": "刚才你投下去的那一批鱼苗，就是专门针对这片水域的情况专门选出来的。",
            "nextDialogs": [
              "240140607"
            ]
          },
          "240140607": {
            "id": "240140607",
            "speakerId": 13409,
            "speakerName": "莉诺蕾娅",
            "text": "我等一下会再投放几个批次的鱼苗，然后，我们雇佣的冒险家就会过来，扫除这片区域里的「机关鱼」。",
            "nextDialogs": [
              "240140608"
            ]
          },
          "240140608": {
            "id": "240140608",
            "speakerId": 13409,
            "speakerName": "莉诺蕾娅",
            "text": "我相信这批鱼苗，一定能好好长大，让这片水域的生态环境重新恢复。",
            "nextDialogs": [
              "240140609"
            ]
          },
          "240140609": {
            "id": "240140609",
            "speakerId": 13409,
            "speakerName": "莉诺蕾娅",
            "text": "等到有足够多的水域生态得到恢复。我就会写一份长篇报道。让大众知道「枫丹科学院」究竟对自然环境做了什么。",
            "nextDialogs": [
              "240140610"
            ]
          },
          "240140610": {
            "id": "240140610",
            "speakerId": 13409,
            "speakerName": "莉诺蕾娅",
            "text": "等着吧，达梅婕。这次你一定不会再有机会搪塞我了！"
          }
        }
      }
    },
    {
      "subId": "2401404",

  "subQuests": [
    {
      "subId": "2401401",
      "subQuestName": "与莉诺蕾娅对话",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "240140301"
        ],
        "dialogs": {
          "240140301": {
            "id": "240140301",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "我去深水区。",
            "nextDialogs": [
              "240140302"
            ]
          },
          "240140302": {
            "id": "240140302",
            "speakerId": 13409,
            "speakerName": "莉诺蕾娅",
            "text": "那就拜托你了。看这潜水服的状态，我暂时没法帮忙…只能看你的了。"
          }
        }
      }
    },
    {
      "subId": "2401402",
      "subQuestName": "前往深水区投放鱼苗",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "240140201"
        ],
        "dialogs": {
          "240140201": {
            "id": "240140201",
            "speakerId": 13409,
            "speakerName": "莉诺蕾娅",
            "text": "…这里的鱼群又减少了，难道机关鱼又开始活跃了吗？",
            "nextDialogs": [
              "240140202"
            ]
          },
          "240140202": {
            "id": "240140202",
            "speakerId": 13409,
            "speakerName": "莉诺蕾娅",
            "text": "必须把鱼苗投入更深的水域才行，但潜水服怎么这个时候坏掉了…",
            "nextDialogs": [
              "240140203"
            ]
          },
          "240140203": {
            "id": "240140203",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "你在做什么呢？",
            "nextDialogs": [
              "240140204"
            ]
          },
          "240140204": {
            "id": "240140204",
            "speakerId": 13409,
            "speakerName": "莉诺蕾娅",
            "text": "你好，初次见面，我叫莉诺蕾娅，是一名专职于报道环境问题的记者，正在这里…投放鱼苗。",
            "nextDialogs": [
              "240140205"
            ]
          },
          "240140205": {
            "id": "240140205",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "欸？我们上次见到瑟米安的时候，莉诺蕾娅小姐是不是就在旁边呀？",
            "nextDialogs": [
              "240140206"
            ]
          },
          "240140206": {
            "id": "240140206",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "你应该是瑟米安的…",
            "nextDialogs": [
              "240140207"
            ]
          },
          "240140207": {
            "id": "240140207",
            "speakerId": 13409,
            "speakerName": "莉诺蕾娅",
            "text": "你们认识瑟米安？难道…上次就是你们帮瑟米安拿来了那些礼物？真是太感谢你们了。",
            "nextDialogs": [
              "240140208"
            ]
          },
          "240140208": {
            "id": "240140208",
            "speakerId": 13409,
            "speakerName": "莉诺蕾娅",
            "text": "上次看完歌剧回家之后，瑟米安才告诉我这件事，我还一直想请你们来家里吃饭呢。",
            "nextDialogs": [
              "240140209"
            ]
          },
          "240140209": {
            "id": "240140209",
            "speakerId": 13409,
            "speakerName": "莉诺蕾娅",
            "text": "没想到会在这里遇见你们，但…现在的时机可真不巧…",
            "nextDialogs": [
              "240140210"
            ]
          },
          "240140210": {
            "id": "240140210",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "你刚才说，正在这里投放鱼苗？",
            "nextDialogs": [
              "240140211"
            ]
          },
          "240140211": {
            "id": "240140211",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "为什么要投放鱼苗？",
            "nextDialogs": [
              "240140212"
            ]
          },
          "240140212": {
            "id": "240140212",
            "speakerId": 13409,
            "speakerName": "莉诺蕾娅",
            "text": "…您知道有关「机关鱼」的事吗？"
          }
        }
      }
    },
    {
      "subId": "2401403",
      "subQuestName": "前往浅水区投放鱼苗",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [],

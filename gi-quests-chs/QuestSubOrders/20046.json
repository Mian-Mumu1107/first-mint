  "subQuests": [
    {
      "subId": "2004601",
      "subQuestName": "与安娜对话",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "200460101"
        ],
        "dialogs": {
          "200460101": {
            "id": "200460101",
            "speakerId": 1000,
            "speakerName": "安娜",
            "text": "好…今天也要努力完成委托！",
            "nextDialogs": [
              "200460103",
              "200460107"
            ]
          },
          "200460103": {
            "id": "200460103",
            "speakerId": 1000,
            "speakerName": "安娜",
            "text": "那是当然了，做冒险家可是很有趣的。",
            "nextDialogs": [
              "200460104"
            ]
          },
          "200460104": {
            "id": "200460104",
            "speakerId": 1000,
            "speakerName": "安娜",
            "text": "不过…嘿嘿，我执行委托的时候，还是有很多事不熟悉。",
            "nextDialogs": [
              "200460105"
            ]
          },
          "200460105": {
            "id": "200460105",
            "speakerId": 1000,
            "speakerName": "安娜",
            "text": "旅行者，能请你再陪我去执行一下委托吗？我还有事想要请教你。",
            "nextDialogs": [
              "200460108"
            ]
          },
          "200460108": {
            "id": "200460108",
            "speakerId": 1000,
            "speakerName": "安娜",
            "text": "那我们就快出发吧，今天的委托是…",
            "nextDialogs": [
              "200460109"
            ]
          },
          "200460109": {
            "id": "200460109",
            "speakerId": 1000,
            "speakerName": "安娜",
            "text": "嗯…又是护送货运热气球…"
          },
          "200460107": {
            "id": "200460107",
            "speakerId": 1000,
            "speakerName": "安娜",
            "text": "可以吗？嘿嘿，我正好有很多事想要请教你呢。"
          }
        }
      }
    },
    {
      "subId": "2004602",
      "subQuestName": "与安娜一同完成冒险家协会的委托",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "200460201"
        ],
        "dialogs": {
          "200460201": {
            "id": "200460201",
            "speakerId": 1000,
            "speakerName": "安娜",
            "text": "完成啦！谢谢你旅行者，这次的护送任务很顺利呢。",
            "nextDialogs": [
              "200460202"
            ]
          },
          "200460202": {
            "id": "200460202",
            "speakerId": 1000,
            "speakerName": "安娜",
            "text": "不过，冒险家平时去执行的委托，都是这种事情吗？",
            "nextDialogs": [
              "200460204",
              "200460206"
            ]
          },
          "200460204": {
            "id": "200460204",
            "speakerId": 1000,
            "speakerName": "安娜",
            "text": "你的语气也太无奈了…",
            "nextDialogs": [
              "200460207"
            ]
          },
          "200460207": {
            "id": "200460207",
            "speakerId": 1000,
            "speakerName": "安娜",
            "text": "是这样吗…好嘞！那我要继续努力了！",
            "nextDialogs": [
              "200460208"
            ]
          },
          "200460208": {
            "id": "200460208",
            "speakerId": 1000,
            "speakerName": "安娜",
            "text": "等我攒够了钱，就带着哥哥和爸爸妈妈一起出去旅行！",
            "nextDialogs": [
              "200460209"
            ]
          },
          "200460209": {
            "id": "200460209",
            "speakerId": 1000,
            "speakerName": "安娜",
            "text": "哥哥他之前一直想出去旅行的，可是…因为我生病了，他必须留下来照顾我。",
            "nextDialogs": [
              "200460210"
            ]
          },
          "200460210": {
            "id": "200460210",
            "speakerId": 1000,
            "speakerName": "安娜",
            "text": "现在我的病已经好了，也成为了冒险家。",
            "nextDialogs": [
              "200460211"
            ]
          },
          "200460211": {
            "id": "200460211",
            "speakerId": 1000,
            "speakerName": "安娜",
            "text": "嘿嘿，是时候帮我哥哥完成一些梦想啦。"
          },
          "200460206": {
            "id": "200460206",
            "speakerId": 1000,
            "speakerName": "安娜",
            "text": "喂，你的表情不要这么疲惫啊…"
          }
        }
      }
    },
    {
      "subId": "2004603",
      "subQuestName": "与安娜一同完成冒险家协会的委托",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "200460301"
        ],
        "dialogs": {
          "200460301": {
            "id": "200460301",
            "speakerId": 1001,
            "speakerName": "安东尼",
            "text": "旅行者，还请你多照顾一下安娜，这孩子最近好像兴奋过头了…",
            "nextDialogs": [
              "200460302"
            ]
          },
          "200460302": {
            "id": "200460302",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "你不希望她做冒险家吗？",
            "nextDialogs": [
              "200460303"
            ]
          },
          "200460303": {
            "id": "200460303",
            "speakerId": 1001,
            "speakerName": "安东尼",
            "text": "……",
            "nextDialogs": [
              "200460304"
            ]
          },
          "200460304": {
            "id": "200460304",
            "speakerId": 1001,
            "speakerName": "安东尼",
            "text": "我尊重我妹妹的梦想。",
            "nextDialogs": [
              "200460305"
            ]
          },
          "200460305": {
            "id": "200460305",
            "speakerId": 1001,
            "speakerName": "安东尼",
            "text": "她的病好不容易痊愈了，也得到了追逐自己梦想的机会。",
            "nextDialogs": [
              "200460306"
            ]
          },
          "200460306": {
            "id": "200460306",
            "speakerId": 1001,
            "speakerName": "安东尼",
            "text": "作为她的哥哥，我…会全力支持她。",
            "nextDialogs": [
              "200460307"
            ]
          },
          "200460307": {
            "id": "200460307",
            "speakerId": 1001,
            "speakerName": "安东尼",
            "text": "就这样。"
          }
        }
      }
    },

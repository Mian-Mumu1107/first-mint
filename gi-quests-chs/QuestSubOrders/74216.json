    {
      "subId": "7421604",
      "subQuestName": "与朱斯蒂诺对话",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "742162003"
        ],
        "dialogs": {
          "742162003": {
            "id": "742162003",
            "speakerId": 5338,
            "speakerName": "朱斯蒂诺",
            "text": "……",
            "nextDialogs": [
              "742162004"
            ]
          },
          "742162004": {
            "id": "742162004",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "喂，你的脸色好像不是很好看…你没事吧？",
            "nextDialogs": [
              "742162005"
            ]
          },
          "742162005": {
            "id": "742162005",
            "speakerId": 5338,
            "speakerName": "朱斯蒂诺",
            "text": "我…我好像有点晕船，唔…抱歉！我、我去那边吐一会儿，马上就回来！",
            "nextDialogs": [
              "742162006"
            ]
          },
          "742162006": {
            "id": "742162006",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "欸？那…好吧，那你去吧，不过记得要快点回来喔！",
            "nextDialogs": [
              "742162007"
            ]
          },
          "742162007": {
            "id": "742162007",
            "speakerId": 1003,
            "speakerName": "Black Screen",
            "text": "过了好一阵子…",
            "nextDialogs": [
              "742162008"
            ]
          },
          "742162008": {
            "id": "742162008",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "感觉不对劲…朱斯蒂诺先生怎么还没回来？",
            "nextDialogs": [
              "742162010",
              "742162012"
            ]
          },
          "742162010": {
            "id": "742162010",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "#欸？！这么严重吗？我觉得{NICKNAME}开船明明就很稳啊？哦，因为我都是飘着的…",
            "nextDialogs": [
              "742162013"
            ]
          },
          "742162013": {
            "id": "742162013",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "不管怎么说，我们得快点找到他才行！"
          },
          "742162012": {
            "id": "742162012",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "啊？！可他不是说自己生意做得很大吗？难道那也是骗人的？"
          }
        }
      }
    },
    {
      "subId": "7421605",
      "subQuestName": "打探朱斯蒂诺的去向",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "742161603"
        ],
        "dialogs": {
          "742161603": {
            "id": "742161603",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "你好，请问你有见到一个须弥装束的枫丹商人吗？",
            "nextDialogs": [
              "742161604"
            ]
          },
          "742161604": {
            "id": "742161604",
            "speakerId": 1003,
            "speakerName": "Black Screen",
            "text": "向对方简单说明了情况…",
            "nextDialogs": [
              "742161605"
            ]
          },
          "742161605": {
            "id": "742161605",
            "speakerId": 5337,
            "speakerName": "乔瓦尼",
            "text": "所以你们要找的这个自称佩特莉可镇出身的家伙叫「朱斯蒂诺」？",
            "nextDialogs": [
              "742161606"
            ]
          },
          "742161606": {
            "id": "742161606",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "对呀对呀，你有看到他吗？欸？该不会你和他以前就认识吧？",
            "nextDialogs": [
              "742161607"
            ]
          },
          "742161607": {
            "id": "742161607",
            "speakerId": 5337,
            "speakerName": "乔瓦尼",
            "text": "以前就认识？哈！岂止是认识！",
            "nextDialogs": [
              "742161608"
            ]
          },
          "742161608": {
            "id": "742161608",
            "speakerId": 5337,
            "speakerName": "乔瓦尼",
            "text": "不过就算我认得他，他还认得我这个弟弟吗？要知道他离开家这么多年却全无音信，我连墓碑都在镇子后面给他立好了！",
            "nextDialogs": [
              "742161609"
            ]
          },
          "742161609": {
            "id": "742161609",
            "speakerId": 5337,
            "speakerName": "乔瓦尼",
            "text": "现在突然回来…还欠了人家船费？这像话吗？",
            "nextDialogs": [
              "742161612"
            ]
          },
          "742161612": {
            "id": "742161612",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "不、不管怎么说，我们也算是…算是受害者？而且万一朱斯蒂诺先生是真的身体不舒服晕倒在什么地方了…",
            "nextDialogs": [
              "742161613"
            ]
          },
          "742161613": {
            "id": "742161613",
            "speakerId": 5337,
            "speakerName": "乔瓦尼",
            "text": "唉…我和你们一起去找他吧，我是本地人，对附近的地形也更熟悉。他可能会去的地方…我有些头绪。"
          }
        }
      }
    },
    {
      "subId": "7421606",
      "subQuestName": "跟随乔瓦尼",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "742160601"
        ],
        "dialogs": {
          "742160601": {
            "id": "742160601",
            "speakerId": 21484,
            "speakerName": "茱莉耶妲",
            "text": "啊，您回来了！我们现在可以出发了吗？"
          }
        }
      }
    },
    {
      "subId": "7421607",
      "subQuestName": "跟随乔瓦尼",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "742161703"
        ],
        "dialogs": {
          "742161703": {
            "id": "742161703",
            "speakerId": 21408,
            "speakerName": "债务处理人",
            "text": "啊？你说什么？「对不起，但是我真的完全没有印象」？",
            "nextDialogs": [
              "742161704"
            ]
          },
          "742161704": {
            "id": "742161704",
            "speakerId": 21408,
            "speakerName": "债务处理人",
            "text": "你该不会不认识我这身制服吧？看到这身制服还什么都想不起来吗？",
            "nextDialogs": [
              "742161705"
            ]
          },
          "742161705": {
            "id": "742161705",
            "speakerId": 5338,
            "speakerName": "朱斯蒂诺",
            "text": "我、我当然知道你是干什么的，但是我应该不欠任何人任何债款了，除非…除非是我的朋友以我的名义…",
            "nextDialogs": [
              "742161706"
            ]
          },
          "742161706": {
            "id": "742161706",
            "speakerId": 21408,
            "speakerName": "债务处理人",
            "text": "你的朋友？谁管你有什么理由或者借口？我只认白纸黑字的契约，让违约者付出代价就是我的职责！",
            "nextDialogs": [
              "742161707"
            ]
          },
          "742161707": {
            "id": "742161707",
            "speakerId": 21408,
            "speakerName": "债务处理人",
            "text": "这可是我值得纪念的第一次工作！为了配得上这套制服，我甚至提前三天就到文件上指定的地点等待了！",
            "nextDialogs": [
              "742161708"
            ]
          },
          "742161708": {
            "id": "742161708",
            "speakerId": 21408,
            "speakerName": "债务处理人",
            "text": "在这三天的时间里，我一直在思考，要是你违约了，会用什么借口，而我又应该怎样回答应对…",
            "nextDialogs": [
              "742161709"
            ]
          },
          "742161709": {
            "id": "742161709",
            "speakerId": 21408,
            "speakerName": "债务处理人",
            "text": "可没想到你居然选择了直接逃跑！那我想好的应对方案不就全都白费了吗？事到如今，我也只好按手册上写的…",
            "nextDialogs": [
              "742161710"
            ]
          },
          "742161710": {
            "id": "742161710",
            "speakerId": 21408,
            "speakerName": "债务处理人",
            "text": "先让你吃点苦头，再把你带回去复命了！",
            "nextDialogs": [
              "742161711"
            ]
          },
          "742161711": {
            "id": "742161711",
            "speakerId": 5338,
            "speakerName": "朱斯蒂诺",
            "text": "不！我不想再离开佩特莉可了！救、救命啊——",
            "nextDialogs": [
              "742161712"
            ]
          },
          "742161712": {
            "id": "742161712",
            "speakerId": 5337,
            "speakerName": "乔瓦尼",
            "text": "住手！不管他欠了多少债款，有必要下这么狠的手吗？",
            "nextDialogs": [
              "742161713"
            ]
          },
          "742161713": {
            "id": "742161713",
            "speakerId": 5337,
            "speakerName": "乔瓦尼",
            "text": "#{NICKNAME}，拜托了！不要让他伤害朱斯蒂诺！只有你能阻止他了！"
          }
        }
      }
    },
    {
      "subId": "7421608",
      "subQuestName": "击败债务处理人",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [],
        "dialogs": {}
      }
    },
    {
      "subId": "7421609",
      "subQuestName": "与债务处理人对话",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "742161802"
        ],
        "dialogs": {
          "742161802": {
            "id": "742161802",
            "speakerId": 21408,
            "speakerName": "债务处理人",
            "text": "你、你也是他雇来的帮手？好家伙，宁可用摩拉雇佣这么强悍的保镖也不愿意遵守契约吗？真搞不懂你们这些商人…",
            "nextDialogs": [
              "742161804",
              "742161806"
            ]
          },
          "742161804": {
            "id": "742161804",
            "speakerId": 21408,
            "speakerName": "债务处理人",
            "text": "啊？",
            "nextDialogs": [
              "742161807"
            ]
          },
          "742161807": {
            "id": "742161807",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "哇，如果朱斯蒂诺先生其实还欠了一大笔债没还，那我们的船费岂不是…",
            "nextDialogs": [
              "742161808"
            ]
          },
          "742161808": {
            "id": "742161808",
            "speakerId": 5338,
            "speakerName": "朱斯蒂诺",
            "text": "船费…船费还是有的，我算过了，应该正好够才对。",
            "nextDialogs": [
              "742161809"
            ]
          },
          "742161809": {
            "id": "742161809",
            "speakerId": 5337,
            "speakerName": "乔瓦尼",
            "text": "那他说的什么契约和债款呢？难道是你时隔十数年才回家，特意给我们准备的「伴手礼」吗？",
            "nextDialogs": [
              "742161810"
            ]
          },
          "742161810": {
            "id": "742161810",
            "speakerId": 5338,
            "speakerName": "朱斯蒂诺",
            "text": "乔瓦尼！怎么会，怎么会呢！我真的对他所说的契约全无印象，唉！真不知道该怎么说你们才肯相信我了。",
            "nextDialogs": [
              "742161811"
            ]
          },
          "742161811": {
            "id": "742161811",
            "speakerId": 21408,
            "speakerName": "债务处理人",
            "text": "呵，手册上说了，人会说谎，会想尽一切办法逃避债务，但契约白纸黑字写得清清楚楚，你可别想抵赖。",
            "nextDialogs": [
              "742161812"
            ]
          },
          "742161812": {
            "id": "742161812",
            "speakerId": 21408,
            "speakerName": "债务处理人",
            "text": "你还欠着我们十箱材料的款项，做你那倒霉的笛子…",
            "nextDialogs": [
              "742161813"
            ]
          },
          "742161813": {
            "id": "742161813",
            "speakerId": 5338,
            "speakerName": "朱斯蒂诺",
            "text": "…等等，你说什么？笛子？",
            "nextDialogs": [
              "742161814"
            ]
          },
          "742161814": {
            "id": "742161814",
            "speakerId": 21408,
            "speakerName": "债务处理人",
            "text": "…都到这种时候了，你还有什么好装的，帕迪西帕齐亚？…该死，你们枫丹人的名字真是比账目还难记…",
            "nextDialogs": [
              "742161815"
            ]
          },
          "742161815": {
            "id": "742161815",
            "speakerId": 5338,
            "speakerName": "朱斯蒂诺",
            "text": "帕迪西帕齐亚…是谁？我是朱斯蒂诺，朱斯蒂诺·帕斯夸莱…",
            "nextDialogs": [
              "742161816"
            ]
          },
          "742161816": {
            "id": "742161816",
            "speakerId": 21408,
            "speakerName": "债务处理人",
            "text": "…？",
            "nextDialogs": [
              "742161817"
            ]
          },
          "742161817": {
            "id": "742161817",
            "speakerId": 21408,
            "speakerName": "债务处理人",
            "text": "等、等一下，让我看看…朱·帕…茱莉耶妲·帕迪西帕齐亚，佩特莉可镇…",
            "nextDialogs": [
              "742161818"
            ]
          },
          "742161818": {
            "id": "742161818",
            "speakerId": 21408,
            "speakerName": "债务处理人",
            "text": "好像…是个女人？",
            "nextDialogs": [
              "742161819"
            ]
          },
          "742161819": {
            "id": "742161819",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "啊…",
            "nextDialogs": [
              "742161820"
            ]
          },
          "742161820": {
            "id": "742161820",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "啊…",
            "nextDialogs": [
              "742161821"
            ]
          },
          "742161821": {
            "id": "742161821",
            "speakerId": 21408,
            "speakerName": "债务处理人",
            "text": "不对，不对！你给我等等！你既然不是那个女人，那你刚才在拜达港念叨什么「笛子」？！",
            "nextDialogs": [
              "742161822"
            ]
          },
          "742161822": {
            "id": "742161822",
            "speakerId": 5338,
            "speakerName": "朱斯蒂诺",
            "text": "…我说的是…这柄笛子。",
            "nextDialogs": [
              "742161823"
            ]
          },
          "742161823": {
            "id": "742161823",
            "speakerId": 5337,
            "speakerName": "乔瓦尼",
            "text": "……",
            "nextDialogs": [
              "742161824"
            ]
          },
          "742161824": {
            "id": "742161824",
            "speakerId": 5338,
            "speakerName": "朱斯蒂诺",
            "text": "临行的前一天，父亲送给我的笛子…送给我的生日礼物。他希望我能够传承家族的乐器制造产业，但我…",
            "nextDialogs": [
              "742161825"
            ]
          },
          "742161825": {
            "id": "742161825",
            "speakerId": 5338,
            "speakerName": "朱斯蒂诺",
            "text": "唉，过去的事就不提了。",
            "nextDialogs": [
              "742161826"
            ]
          },
          "742161826": {
            "id": "742161826",
            "speakerId": 21408,
            "speakerName": "债务处理人",
            "text": "等一下，既然这事跟你没关系，你刚才跑什么？",
            "nextDialogs": [
              "742161827"
            ]
          },
          "742161827": {
            "id": "742161827",
            "speakerId": 5338,
            "speakerName": "朱斯蒂诺",
            "text": "「对不起，但是我真的完全没有印象」，我不是这么说了吗？但你语气咄咄逼人，态度凶神恶煞，谁见了不得跑啊…",
            "nextDialogs": [
              "742161828"
            ]
          },
          "742161828": {
            "id": "742161828",
            "speakerId": 21408,
            "speakerName": "债务处理人",
            "text": "这可是我值得纪念的第一次工作，当然得拿出一倍的干劲来！"
          },
          "742161806": {
            "id": "742161806",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "对哦！说好的三倍船费他都还没付给我们呢！"
          }
        }
      }
    },
    {
      "subId": "7421610",
      "subQuestName": "前往指定地点",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "742161901"
        ],
        "dialogs": {
          "742161901": {
            "id": "742161901",
            "speakerId": 5337,
            "speakerName": "乔瓦尼",
            "text": "佩特莉可镇是个小地方，点心茶饮也都很普通，几位见多识广，或许看不上眼…",
            "nextDialogs": [
              "742161902"
            ]
          },
          "742161902": {
            "id": "742161902",
            "speakerId": 5338,
            "speakerName": "朱斯蒂诺",
            "text": "乔瓦尼，为什么要说这样带刺的话呢？我的心和你的一样，也是血肉做的，也会受伤，也会痛。",
            "nextDialogs": [
              "742161903"
            ]
          },
          "742161903": {
            "id": "742161903",
            "speakerId": 5337,
            "speakerName": "乔瓦尼",
            "text": "是吗？我还以为完全不在乎家人的人，他的心肠理应跟石头一样硬，不管怎么敲打也无动于衷呢。",
            "nextDialogs": [
              "742161904"
            ]
          },
          "742161904": {
            "id": "742161904",
            "speakerId": 5338,
            "speakerName": "朱斯蒂诺",
            "text": "我…",
            "nextDialogs": [
              "742161905"
            ]
          },
          "742161905": {
            "id": "742161905",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "（唔…没想到会变成这样，气氛好尴尬！）",
            "nextDialogs": [
              "742161908"
            ]
          },
          "742161908": {
            "id": "742161908",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "总、总之，既然是时隔多年的兄弟重逢，不管以前发生了什么，现在应该高兴一点，对吧？",
            "nextDialogs": [
              "742161909"
            ]
          },
          "742161909": {
            "id": "742161909",
            "speakerId": 5337,
            "speakerName": "乔瓦尼",
            "text": "……",
            "nextDialogs": [
              "742161910"
            ]
          },
          "742161910": {
            "id": "742161910",
            "speakerId": 5338,
            "speakerName": "朱斯蒂诺",
            "text": "……",
            "nextDialogs": [
              "742161911"
            ]
          },
          "742161911": {
            "id": "742161911",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "#呜啊，{NICKNAME}，你也来劝劝他们吧！"
          }
        }
      }
    },
    {
      "subId": "7421601",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "742160101"
        ],
        "dialogs": {
          "742160101": {
            "id": "742160101",
            "speakerId": 10205,
            "speakerName": "？？？",
            "text": "难道两位恰好准备出海？如果是这样的话，能拜托两位送我一程，带我去拜达港吗？",
            "nextDialogs": [
              "742160112"
            ]
          },
          "742160112": {
            "id": "742160112",
            "speakerId": 10205,
            "speakerName": "？？？",
            "text": "这样啊…哎呀，这下可难办了…",
            "nextDialogs": [
              "742160113"
            ]
          },
          "742160113": {
            "id": "742160113",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "欸？如果是什么紧急的事，我们也不是不能帮忙…",
            "nextDialogs": [
              "742160114"
            ]
          },
          "742160114": {
            "id": "742160114",
            "speakerId": 21484,
            "speakerName": "茱莉耶妲",
            "text": "哦！您真好心，事情是这样，我叫茱莉耶妲，是从事乐器贸易的商人。",
            "nextDialogs": [
              "742160115"
            ]
          },
          "742160115": {
            "id": "742160115",
            "speakerId": 21484,
            "speakerName": "茱莉耶妲",
            "text": "前不久，我与几位外国的先生签了一笔订单，向他们订购了一批材料——毕竟，就算是再优秀的工匠，也没法凭空变出乐器嘛！",
            "nextDialogs": [
              "742160116"
            ]
          },
          "742160116": {
            "id": "742160116",
            "speakerId": 21484,
            "speakerName": "茱莉耶妲",
            "text": "按照合约，这两天就是要去拜达港交款的日子了。谁能想到，因为我早上睡过了头，没赶上最后一班航船…",
            "nextDialogs": [
              "742160117"
            ]
          },
          "742160117": {
            "id": "742160117",
            "speakerId": 21484,
            "speakerName": "茱莉耶妲",
            "text": "哈啊…说不定是因为前几天做了太多噩梦，一直都没休息好…虽说是我自己的过失，但现在当务之急是尽快赶到拜达港。",
            "nextDialogs": [
              "742160118"
            ]
          },
          "742160118": {
            "id": "742160118",
            "speakerId": 21484,
            "speakerName": "茱莉耶妲",
            "text": "若两位愿意抽出时间帮我这么一个忙，我愿意出三倍的价钱。",
            "nextDialogs": [
              "742160119"
            ]
          },
          "742160119": {
            "id": "742160119",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "三、三倍？！",
            "nextDialogs": [
              "742160120"
            ]
          },
          "742160120": {
            "id": "742160120",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "出手这么阔绰吗？",
            "nextDialogs": [
              "742160121"
            ]
          },
          "742160121": {
            "id": "742160121",
            "speakerId": 21484,
            "speakerName": "茱莉耶妲",
            "text": "毕竟事关信誉，对经商的人来说，这可是死生问题。",
            "nextDialogs": [
              "742160122"
            ]
          },
          "742160122": {
            "id": "742160122",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "好、好像确实是这样…"
          },
          "742160199": {
            "id": "742160199",
            "speakerId": 1007,
            "speakerName": "<UNKNOWN>",
            "text": "漂洋过海，一路来到了拜达港…"
          }
        }
      }
    },
    {
      "subId": "7421603",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "742160301"
        ],
        "dialogs": {
          "742160301": {
            "id": "742160301",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "稍等，我还有些事情要处理…",
            "nextDialogs": [
              "742160302"
            ]
          },
          "742160302": {
            "id": "742160302",
            "speakerId": 21484,
            "speakerName": "茱莉耶妲",
            "text": "您可要快些回来，毕竟时间不等人…"
          }
        }
      }
    },
    {
      "subId": "7421604",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "742160401"
        ],
        "dialogs": {
          "742160401": {
            "id": "742160401",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "嗯，上船吧。",
            "nextDialogs": [
              "742160412"
            ]
          },
          "742160412": {
            "id": "742160412",
            "speakerId": 21484,
            "speakerName": "茱莉耶妲",
            "text": "那么，事不宜迟，我们快点去拜达港吧！"
          }
        }
      }
    },
    {
      "subId": "7421605",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "742160501"
        ],
        "dialogs": {
          "742160501": {
            "id": "742160501",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "再等等吧，我还有别的事要做。",
            "nextDialogs": [
              "742160502"
            ]
          },
          "742160502": {
            "id": "742160502",
            "speakerId": 21484,
            "speakerName": "茱莉耶妲",
            "text": "唉，既然已经约好了，那还请您快些回来。"
          }
        }
      }
    },
    {
      "subId": "7421607",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "742160701"
        ],
        "dialogs": {
          "742160701": {
            "id": "742160701",
            "speakerId": 21484,
            "speakerName": "茱莉耶妲",
            "text": "哇！我们已经到啦！",
            "nextDialogs": [
              "742160712"
            ]
          },
          "742160712": {
            "id": "742160712",
            "speakerId": 21484,
            "speakerName": "茱莉耶妲",
            "text": "非常感谢两位！这样一来，我也能按时把约好的款项交给那些先生了——可不能让大家觉得我们枫丹人不守约定呀。",
            "nextDialogs": [
              "742160713"
            ]
          },
          "742160713": {
            "id": "742160713",
            "speakerId": 21484,
            "speakerName": "茱莉耶妲",
            "text": "来，这些是说好的报酬，还请两位收下！",
            "nextDialogs": [
              "742160714"
            ]
          },
          "742160714": {
            "id": "742160714",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "嘿嘿，是亮闪闪的摩拉！只要有报酬，什么都好说嘛！",
            "nextDialogs": [
              "742160715"
            ]
          },
          "742160715": {
            "id": "742160715",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "#不过，话说回来，{NICKNAME}，既然咱们都已经到拜达港了，不如在这里逛逛？反正就算现在回到佩特莉可镇…",
            "nextDialogs": [
              "742160716"
            ]
          },
          "742160716": {
            "id": "742160716",
            "speakerId": 10205,
            "speakerName": "？？？",
            "text": "嗯？两位…是从佩特莉可镇来的？",
            "nextDialogs": [
              "742160717"
            ]
          },
          "742160717": {
            "id": "742160717",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "呜哇！你这家伙，不要突然从背后跟人搭话呀！吓了我一跳！",
            "nextDialogs": [
              "742160718"
            ]
          },
          "742160718": {
            "id": "742160718",
            "speakerId": 10205,
            "speakerName": "？？？",
            "text": "吓到你了？抱歉！唉，是我有些激动了，听到家乡的名字，情不自禁就…",
            "nextDialogs": [
              "742160719"
            ]
          },
          "742160719": {
            "id": "742160719",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "只是听人提到家乡的名字，也不用这么激动吧？",
            "nextDialogs": [
              "742160720"
            ]
          },
          "742160720": {
            "id": "742160720",
            "speakerId": 10205,
            "speakerName": "？？？",
            "text": "这个嘛…毕竟我少年时代离开家乡之后就再没回去过，在须弥经商，辗转十来年，一直没有听说多少有关家乡的消息…",
            "nextDialogs": [
              "742160721"
            ]
          },
          "742160721": {
            "id": "742160721",
            "speakerId": 5338,
            "speakerName": "朱斯蒂诺",
            "text": "你们既然从佩特莉可镇来，能不能给我讲讲佩特莉可镇的近况呢？对了，还没有自我介绍，就叫我朱斯蒂诺吧。",
            "nextDialogs": [
              "742160722"
            ]
          },
          "742160722": {
            "id": "742160722",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "#你好，朱斯蒂诺先生。我是派蒙，{M#他}{F#她}是{NICKNAME}。说来也巧，我们对佩特莉可镇可是有很「深入」的了解呢！",
            "nextDialogs": [
              "742160723"
            ]
          },
          "742160723": {
            "id": "742160723",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "（不过…要是告诉他，我们跟着一只猫，破坏了一个古老的阴谋，解决了镇子的危机，只会被当作是在胡言乱语吧…）",
            "nextDialogs": [
              "742160726"
            ]
          },
          "742160726": {
            "id": "742160726",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "呃…佩特莉可镇挺好的！好在哪里呢…好在就和以前一样！和以前一样好！",
            "nextDialogs": [
              "742160727"
            ]
          },
          "742160727": {
            "id": "742160727",
            "speakerId": 5338,
            "speakerName": "朱斯蒂诺",
            "text": "是这样吗？和以前一样…和以前一样啊，那我就放心了…",
            "nextDialogs": [
              "742160728"
            ]
          },
          "742160728": {
            "id": "742160728",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "说起来，既然是朱斯蒂诺先生的家乡，与其问我们这些外人，自己回去看看不是更好吗？",
            "nextDialogs": [
              "742160729"
            ]
          },
          "742160729": {
            "id": "742160729",
            "speakerId": 5338,
            "speakerName": "朱斯蒂诺",
            "text": "唉，说得也是，是该回去了。当初将家乡抛在身后的时候，我没有一点犹豫，现在要回去了，反而畏畏缩缩。",
            "nextDialogs": [
              "742160730"
            ]
          },
          "742160730": {
            "id": "742160730",
            "speakerId": 5338,
            "speakerName": "朱斯蒂诺",
            "text": "真奇怪啊，年纪大了，勇气却越来越少。",
            "nextDialogs": [
              "742160731"
            ]
          },
          "742160731": {
            "id": "742160731",
            "speakerId": 5338,
            "speakerName": "朱斯蒂诺",
            "text": "要不是收拾行李时找到了这支笛子…",
            "nextDialogs": [
              "742160732"
            ]
          },
          "742160732": {
            "id": "742160732",
            "speakerId": 10205,
            "speakerName": "？？？",
            "text": "……",
            "nextDialogs": [
              "742160733"
            ]
          },
          "742160733": {
            "id": "742160733",
            "speakerId": 5338,
            "speakerName": "朱斯蒂诺",
            "text": "离开家乡的时候我两手空空，只有这支笛子傍身。其实当时家里人都反对我离家远行，这支笛子也是父亲最后偷偷塞给我的。",
            "nextDialogs": [
              "742160734"
            ]
          },
          "742160734": {
            "id": "742160734",
            "speakerId": 5338,
            "speakerName": "朱斯蒂诺",
            "text": "哈，那可真是一段好时光，口袋里一个子儿也没有，但是有自由的笛声，有满腔的热情和梦想，好像全世界都是我的。",
            "nextDialogs": [
              "742160735"
            ]
          },
          "742160735": {
            "id": "742160735",
            "speakerId": 5338,
            "speakerName": "朱斯蒂诺",
            "text": "后来，我在须弥结识了很多朋友，生意做得越来越大。唉，要是当时能写封信告诉他们就好了，可那时我把家人故乡全忘光了…",
            "nextDialogs": [
              "742160736"
            ]
          },
          "742160736": {
            "id": "742160736",
            "speakerId": 5338,
            "speakerName": "朱斯蒂诺",
            "text": "咳，话说回来，我有个不情之请，你们返回佩特莉可镇的时候能捎我一程吗？",
            "nextDialogs": [
              "742160737"
            ]
          },
          "742160737": {
            "id": "742160737",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "你也要出三倍船费？",
            "nextDialogs": [
              "742160738"
            ]
          },
          "742160738": {
            "id": "742160738",
            "speakerId": 5338,
            "speakerName": "朱斯蒂诺",
            "text": "三倍船费？！",
            "nextDialogs": [
              "742160739"
            ]
          },
          "742160739": {
            "id": "742160739",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "是呀，刚才我们载的那位女士，因为有生意上的要紧事，所以出了三倍的船费来雇我们呢。",
            "nextDialogs": [
              "742160740"
            ]
          },
          "742160740": {
            "id": "742160740",
            "speakerId": 5338,
            "speakerName": "朱斯蒂诺",
            "text": "三倍…差不多应该够了。好，那我也出三倍船费。俗话说，打铁要趁热，既然决定了要回家，就不应该再迟疑了。",
            "nextDialogs": [
              "742160741"
            ]
          },
          "742160741": {
            "id": "742160741",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "虽然想说我们也不是什么专门载客的船夫…可是居然接连接到报酬这么丰厚的委托，实在很难拒绝！"
          },
          "742160799": {
            "id": "742160799",
            "speakerId": 1007,
            "speakerName": "<UNKNOWN>",
            "text": "从拜达港回到了佩特莉可镇…"
          }
        }
      }
    },
    {
      "subId": "7421609",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "742160901"
        ],
        "dialogs": {
          "742160901": {
            "id": "742160901",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "能不能等我一会儿？",
            "nextDialogs": [
              "742160911"
            ]
          },
          "742160911": {
            "id": "742160911",
            "speakerId": 5338,
            "speakerName": "朱斯蒂诺",
            "text": "当然，当然。"
          }
        }
      }
    },
    {
      "subId": "7421610",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "742161001"
        ],
        "dialogs": {
          "742161001": {
            "id": "742161001",
            "speakerId": 5338,
            "speakerName": "朱斯蒂诺",
            "text": "我们现在出发吗？"
          }
        }
      }
    },
    {
      "subId": "7421611",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "742161110"
        ],
        "dialogs": {
          "742161110": {
            "id": "742161110",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "走吧。"

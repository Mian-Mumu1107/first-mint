{
  "lineCounts": {
    "Player": 31,
    "乃亚卜": 6,
    "伊泽姆": 6,
    "玛达赫": 87
  },
  "subQuests": [
    {
      "subId": "2300001",
      "subQuestName": "与玛达赫对话",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "230000400"
        ],
        "dialogs": {
          "230000400": {
            "id": "230000400",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "以前在蒙德…",
            "nextDialogs": [
              "230000401"
            ]
          },
          "230000401": {
            "id": "230000401",
            "speakerId": 4003,
            "speakerName": "玛达赫",
            "text": "嗯？风神眷顾的蒙德吗…我听商队的人说，那里出现了一头掀起狂风的巨龙，应该会是个不错的题材。",
            "nextDialogs": [
              "230000402"
            ]
          },
          "230000402": {
            "id": "230000402",
            "speakerId": 4003,
            "speakerName": "玛达赫",
            "text": "但从商队那边能打听到的，也只是一些断断续续，听起来还不太靠谱的传言。",
            "nextDialogs": [
              "230000403"
            ]
          },
          "230000403": {
            "id": "230000403",
            "speakerId": 4003,
            "speakerName": "玛达赫",
            "text": "比如说…「一名背生双翼的旅行者破空而来，在万米高空之上与巨龙展开追逐！」什么的。",
            "nextDialogs": [
              "230000406"
            ]
          },
          "230000406": {
            "id": "230000406",
            "speakerId": 4003,
            "speakerName": "玛达赫",
            "text": "#唔，再比如说…「{M#他}{F#她}只身潜入教会，盗取了寄宿着风神伟力的强大武器！」"
          }
        }
      }
    },
    {
      "subId": "2300002",
      "subQuestName": "等候至次日晚间（19-21点）",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "230000201"
        ],
        "dialogs": {
          "230000201": {
            "id": "230000201",
            "speakerId": 4003,
            "speakerName": "玛达赫",
            "text": "（test）来来来！全体目光向我看齐！",
            "nextDialogs": [
              "230000202"
            ]
          },
          "230000202": {
            "id": "230000202",
            "speakerId": 4003,
            "speakerName": "玛达赫",
            "text": "（test）今天！我宣布个事情！",
            "nextDialogs": [
              "230000203"
            ]
          },
          "230000203": {
            "id": "230000203",
            "speakerId": 4003,
            "speakerName": "玛达赫",
            "text": "（test）我是傻逼！"
          }
        }
      }
    },
    {
      "subId": "2300003",
      "subQuestName": "前往咖啡馆与玛达赫对话",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "230000301"
        ],
        "dialogs": {
          "230000301": {
            "id": "230000301",
            "speakerId": 4003,
            "speakerName": "玛达赫",
            "text": "欸，这故事都还没开始说，客人怎么就全走光了…",
            "nextDialogs": [
              "230000302"
            ]
          },
          "230000302": {
            "id": "230000302",
            "speakerId": 4003,
            "speakerName": "玛达赫",
            "text": "完了，这回是真的连咖啡也要喝不起了…",
            "nextDialogs": [
              "230000303"
            ]
          },
          "230000303": {
            "id": "230000303",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "你遇到什么麻烦了吗？",
            "nextDialogs": [
              "230000304"
            ]
          },
          "230000304": {
            "id": "230000304",
            "speakerId": 4003,
            "speakerName": "玛达赫",
            "text": "呃，您是…旅行者？唉…就跟您见着的一样，我平时会在这咖啡馆里讲讲故事，换点咖啡钱。",
            "nextDialogs": [
              "230000305"
            ]
          },
          "230000305": {
            "id": "230000305",
            "speakerId": 4003,
            "speakerName": "玛达赫",
            "text": "不过最近愿意捧场的听众越来越少，再这么下去，我怕是连咖啡沫都喝不起了。",
            "nextDialogs": [
              "230000308"
            ]
          },
          "230000308": {
            "id": "230000308",
            "speakerId": 4003,
            "speakerName": "玛达赫",
            "text": "呃…虽然我没亲眼见过，不过听起来，应该差不太多？",
            "nextDialogs": [
              "230000309"
            ]
          },
          "230000309": {
            "id": "230000309",
            "speakerId": 4003,
            "speakerName": "玛达赫",
            "text": "不过，这古代英雄的传说再怎么精彩，也架不住每天都讲…果然还是得找点新的故事。",
            "nextDialogs": [
              "230000310"
            ]
          },
          "230000310": {
            "id": "230000310",
            "speakerId": 4003,
            "speakerName": "玛达赫",
            "text": "唉，最好还得是发生在须弥之外的事情，一来足够新鲜好玩，二来嘛…",
            "nextDialogs": [
              "230000311"
            ]
          },
          "230000311": {
            "id": "230000311",
            "speakerId": 4003,
            "speakerName": "玛达赫",
            "text": "我也好再加工处理，也不担心被人说不对…反正大家都没听过…咳！",
            "nextDialogs": [
              "230000312"
            ]
          },
          "230000312": {
            "id": "230000312",
            "speakerId": 4003,
            "speakerName": "玛达赫",
            "text": "不过在那之前，我自己还是得先明白要讲的那些故事…",
            "nextDialogs": [
              "230000313"
            ]
          },
          "230000313": {
            "id": "230000313",
            "speakerId": 4003,
            "speakerName": "玛达赫",
            "text": "您看，我其实也搜集了不少世界各地的故事，比如风龙啦，送仙典仪啦…",
            "nextDialogs": [
              "230000314"
            ]
          },
          "230000314": {
            "id": "230000314",
            "speakerId": 4003,
            "speakerName": "玛达赫",
            "text": "但这些故事都是我从人家那边打听来的，故事内容肯定被添油加醋过，不太可靠。",
            "nextDialogs": [
              "230000315"
            ]
          },
          "230000315": {
            "id": "230000315",
            "speakerId": 4003,
            "speakerName": "玛达赫",
            "text": "旅行者，我从冒险家协会那边听说过，您是在到处旅行，对吧？",
            "nextDialogs": [
              "230000316"
            ]
          },
          "230000316": {
            "id": "230000316",
            "speakerId": 4003,
            "speakerName": "玛达赫",
            "text": "能不能请您和我说说，您在世界各地的见闻？",
            "nextDialogs": [
              "230000317"
            ]
          },
          "230000317": {
            "id": "230000317",
            "speakerId": 4003,
            "speakerName": "玛达赫",
            "text": "这样的话，我也能修正一下我搜集来的这些故事，不至于讲得太离谱…",
            "nextDialogs": [
              "230000318"
            ]
          },
          "230000318": {
            "id": "230000318",
            "speakerId": 4003,
            "speakerName": "玛达赫",
            "text": "当然！我讲故事拿到的报酬，也会分给您一份！"
          }
        }
      }
    },
    {
      "subId": "2300004",
      "subQuestName": "前往咖啡馆与玛达赫对话",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "230001301"
        ],
        "dialogs": {
          "230001301": {
            "id": "230001301",
            "speakerId": 4003,
            "speakerName": "玛达赫",
            "text": "唉…您也来了啊，旅行者。今天的故事感觉怎么样？",
            "nextDialogs": [
              "230001302"
            ]
          },
          "230001302": {
            "id": "230001302",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "故事挺离谱的…",
            "nextDialogs": [
              "230001303"
            ]
          },
          "230001303": {
            "id": "230001303",
            "speakerId": 4003,
            "speakerName": "玛达赫",
            "text": "嗯…和其他客人的评价一样呢。看来是我修饰过度，反而忘了「真实感」。",
            "nextDialogs": [
              "230001304"
            ]
          },
          "230001304": {
            "id": "230001304",
            "speakerId": 4003,
            "speakerName": "玛达赫",
            "text": "唉…看来我还得再改改这故事…",
            "nextDialogs": [
              "230001305"
            ]
          },
          "230001305": {
            "id": "230001305",
            "speakerId": 4003,
            "speakerName": "玛达赫",
            "text": "多谢您提供的素材，这些报酬还请收下。",
            "nextDialogs": [
              "230001306"
            ]
          },
          "230001306": {
            "id": "230001306",
            "speakerId": 4003,
            "speakerName": "玛达赫",
            "text": "以后还有什么故事，记着分享给我啊！"
          }
        }
      }
    },
    {
      "subId": "2300005",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "230000500"
        ],
        "dialogs": {
          "230000500": {
            "id": "230000500",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "以前在璃月…",
            "nextDialogs": [
              "230000501"
            ]
          },
          "230000501": {
            "id": "230000501",
            "speakerId": 4003,
            "speakerName": "玛达赫",
            "text": "嗯？璃月吗…我听商队的人说，那里的诸方势力在神明陨落之际明争暗斗，应该会是个不错的题材。",
            "nextDialogs": [
              "230000502"
            ]
          },
          "230000502": {
            "id": "230000502",
            "speakerId": 4003,
            "speakerName": "玛达赫",
            "text": "但从商队那边能打听到的，也只是一些断断续续，听起来还不太靠谱的传言。",
            "nextDialogs": [
              "230000503"
            ]
          },
          "230000503": {
            "id": "230000503",
            "speakerId": 4003,
            "speakerName": "玛达赫",
            "text": "比如说…「一名旅行者着手操办了送仙典仪，成为各方势力争相拉拢的对象」什么的。",
            "nextDialogs": [
              "230000506"
            ]
          },
          "230000506": {
            "id": "230000506",
            "speakerId": 4003,
            "speakerName": "玛达赫",
            "text": "#唔，再比如说…「{M#他}{F#她}与漩涡之魔神在海上鏖战，就连那座群玉阁都被凌厉的剑气波及，生生坠入海中！」"
          }
        }
      }
    },
    {
      "subId": "2300006",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "230000600"
        ],
        "dialogs": {
          "230000600": {
            "id": "230000600",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "以前在稻妻…",
            "nextDialogs": [
              "230000601"
            ]
          },
          "230000601": {
            "id": "230000601",
            "speakerId": 4003,
            "speakerName": "玛达赫",
            "text": "嗯？雷神庇佑的稻妻吗…我听商队的人说，那里有人忤逆了神明颁布的「眼狩令」，应该会是个不错的题材。",
            "nextDialogs": [
              "230000602"
            ]
          },
          "230000602": {
            "id": "230000602",
            "speakerId": 4003,
            "speakerName": "玛达赫",
            "text": "但从商队那边能打听到的，都是一些断断续续，听起来还不太靠谱的传言…",
            "nextDialogs": [
              "230000603"
            ]
          },
          "230000603": {
            "id": "230000603",
            "speakerId": 4003,
            "speakerName": "玛达赫",
            "text": "比如说，「一位异乡人向愚人众执行官发起决斗，一刀就将对手化为灰烬！」什么的。",
            "nextDialogs": [
              "230000606"
            ]
          },
          "230000606": {
            "id": "230000606",
            "speakerId": 4003,
            "speakerName": "玛达赫",
            "text": "#唔，再比如说，「{M#他}{F#她}直面将军的威压，毫发无伤地从『无想的一刀』下逃出生天！」"
          }
        }
      }
    },
    {
      "subId": "2300007",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "230000701"
        ],
        "dialogs": {
          "230000701": {
            "id": "230000701",
            "speakerId": 4003,
            "speakerName": "玛达赫",
            "text": "原来如此…虽然没有传言说得那么厉害，但是「真实感」却明显提高了一个层次啊。",
            "nextDialogs": [
              "230000702"
            ]
          },
          "230000702": {
            "id": "230000702",
            "speakerId": 4003,
            "speakerName": "玛达赫",
            "text": "简直就像是在向事件的亲历者取材一样，这下传闻里逻辑不通的地方也都能理顺了…",
            "nextDialogs": [
              "230000703"
            ]
          },
          "230000703": {
            "id": "230000703",
            "speakerId": 4003,
            "speakerName": "玛达赫",
            "text": "多谢您了，旅行者。这故事我已经想好要怎么讲了，明晚一定要来捧个场啊！"
          }
        }
      }
    },
    {
      "subId": "2300008",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "230000801"
        ],
        "dialogs": {
          "230000801": {
            "id": "230000801",
            "speakerId": 4003,
            "speakerName": "玛达赫",
            "text": "原来如此…这些传言，居然大多都是真的吗？现实果然比故事还要不可思议啊。",
            "nextDialogs": [
              "230000802"
            ]
          },
          "230000802": {
            "id": "230000802",
            "speakerId": 4003,
            "speakerName": "玛达赫",
            "text": "不过就是因为不可思议，这些传闻才会广为流传吧？看来我还能再加工一下…",
            "nextDialogs": [
              "230000803"
            ]
          },
          "230000803": {
            "id": "230000803",
            "speakerId": 4003,
            "speakerName": "玛达赫",
            "text": "多谢你了，旅行者。这故事我已经想好要怎么讲了，明晚一定要来捧个场啊！"
          }
        }
      }
    },
    {
      "subId": "2300009",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "230000901"
        ],
        "dialogs": {
          "230000901": {
            "id": "230000901",
            "speakerId": 4003,
            "speakerName": "玛达赫",
            "text": "嗯…这里还要再稍作润色…"
          }
        }
      }
    },
    {
      "subId": "2300010",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "230001001"
        ],
        "dialogs": {
          "230001001": {
            "id": "230001001",
            "speakerId": 4003,
            "speakerName": "玛达赫",
            "text": "咳咳，今天要讲的故事发生在遥远的异国。各位请听：「风与巨龙之诗」！",
            "nextDialogs": [
              "230001002"
            ]
          },
          "230001002": {
            "id": "230001002",
            "speakerId": 4003,
            "speakerName": "玛达赫",
            "text": "…彼时那巨龙已降临，无人知晓其真名。谁人能解蒙德危急，谁人能救此地生灵？",
            "nextDialogs": [
              "230001003"
            ]
          },
          "230001003": {
            "id": "230001003",
            "speakerId": 4003,
            "speakerName": "玛达赫",
            "text": "…命定的勇士展开双翼，手持风神的天空琴。琴弦拨动千风骤起，于此重现移山之伟力！",
            "nextDialogs": [
              "230001004"
            ]
          },
          "230001004": {
            "id": "230001004",
            "speakerId": 4003,
            "speakerName": "玛达赫",
            "text": "…勇士怒吼！剑光一闪如陨星！巨龙陨于墟，降龙勇士更无敌！",
            "nextDialogs": [
              "230001005"
            ]
          },
          "230001005": {
            "id": "230001005",
            "speakerId": 4001,
            "speakerName": "乃亚卜",
            "text": "这故事…新是新了，怎么感觉处处都讲不通。",
            "nextDialogs": [
              "230001006"
            ]
          },
          "230001006": {
            "id": "230001006",
            "speakerId": 4005,
            "speakerName": "伊泽姆",
            "text": "主角一上来就动手，不由分说就把巨龙打倒…总感觉这个故事哪里怪怪的…",
            "nextDialogs": [
              "230001007"
            ]
          },
          "230001007": {
            "id": "230001007",
            "speakerId": 4003,
            "speakerName": "玛达赫",
            "text": "呃…那个…今天的故事就到这里，欢迎各位下次再来！哈哈…"
          }
        }
      }
    },
    {
      "subId": "2300011",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "230001101"
        ],
        "dialogs": {
          "230001101": {
            "id": "230001101",
            "speakerId": 4003,
            "speakerName": "玛达赫",
            "text": "咳咳，今天要讲的故事发生在遥远的异国。各位请听：「金发剑侠英雄传」！",
            "nextDialogs": [
              "230001102"
            ]
          },
          "230001102": {
            "id": "230001102",
            "speakerId": 4003,
            "speakerName": "玛达赫",
            "text": "…仙祖法蜕自天降，千年岩港生乱象。幸有旅人长袖舞，合纵连横安四方。",
            "nextDialogs": [
              "230001103"
            ]
          },
          "230001103": {
            "id": "230001103",
            "speakerId": 4003,
            "speakerName": "玛达赫",
            "text": "…奈何海中大魔陡现，胜负终须战场相见。这二位战至天地色变，周遭万物竟无一幸免。尽皆化作齑粉碎片，群玉阁也生生磨灭！",
            "nextDialogs": [
              "230001104"
            ]
          },
          "230001104": {
            "id": "230001104",
            "speakerId": 4003,
            "speakerName": "玛达赫",
            "text": "…沧海既定，争端未平。但见仙凡起龃龉，旅人一龙分二虎。陈词慷慨万众拜服，璃月从此踏上新途！",
            "nextDialogs": [
              "230001105"
            ]
          },
          "230001105": {
            "id": "230001105",
            "speakerId": 4001,
            "speakerName": "乃亚卜",
            "text": "这故事…新是新了，怎么感觉处处都讲不通。",
            "nextDialogs": [
              "230001106"
            ]
          },
          "230001106": {
            "id": "230001106",
            "speakerId": 4005,
            "speakerName": "伊泽姆",
            "text": "就是啊，主角怎么随随便便就说服了两派人，明明前面连话都不怎么说…",
            "nextDialogs": [
              "230001107"
            ]
          },
          "230001107": {
            "id": "230001107",
            "speakerId": 4003,
            "speakerName": "玛达赫",
            "text": "呃…那个…今天的故事就到这里，欢迎各位下次再来！哈哈…"
          }
        }
      }
    },
    {
      "subId": "2300012",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "230001201"
        ],
        "dialogs": {
          "230001201": {
            "id": "230001201",
            "speakerId": 4003,
            "speakerName": "玛达赫",
            "text": "咳咳，今天要讲的故事发生在遥远的异国。各位请听：「异邦人稻妻剑刃谭」！",
            "nextDialogs": [
              "230001202"
            ]
          },
          "230001202": {
            "id": "230001202",
            "speakerId": 4003,
            "speakerName": "玛达赫",
            "text": "#…雷鸣响彻远海之外，宿命的旅人将到来。{M#他}{F#她}于诸岛如电光穿梭，{M#他}{F#她}的义举被天下人诉说。",
            "nextDialogs": [
              "230001203"
            ]
          },
          "230001203": {
            "id": "230001203",
            "speakerId": 4003,
            "speakerName": "玛达赫",
            "text": "…那魔女恣意跋扈，逃不过败北之命数。那一刀劈山开海，也拦不住旅人的去路！",
            "nextDialogs": [
              "230001204"
            ]
          },
          "230001204": {
            "id": "230001204",
            "speakerId": 4003,
            "speakerName": "玛达赫",
            "text": "…还有那千手百眼的石人巨像，驱之以万千愿望的力量。发出雷鸣般轰隆巨响，将阻于道前的诸敌一拍四散！",
            "nextDialogs": [
              "230001205"
            ]
          },
          "230001205": {
            "id": "230001205",
            "speakerId": 4001,
            "speakerName": "乃亚卜",
            "text": "这故事…新是新了，怎么感觉处处都讲不通。",
            "nextDialogs": [
              "230001206"
            ]
          },
          "230001206": {
            "id": "230001206",
            "speakerId": 4005,
            "speakerName": "伊泽姆",
            "text": "最后突然冒出个巨大石像来解围，感觉像是编不下去了…",
            "nextDialogs": [
              "230001207"
            ]
          },
          "230001207": {
            "id": "230001207",
            "speakerId": 4003,
            "speakerName": "玛达赫",
            "text": "呃…那个…今天的故事就到这里，欢迎各位下次再来！哈哈…"
          }
        }
      }
    },
    {
      "subId": "2300014",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "230001401"
        ],
        "dialogs": {
          "230001401": {
            "id": "230001401",
            "speakerId": 4003,
            "speakerName": "玛达赫",
            "text": "咳咳，今天要讲的故事发生在遥远的异国。各位请听：「风与巨龙之诗」！",
            "nextDialogs": [
              "230001402"
            ]
          },
          "230001402": {
            "id": "230001402",
            "speakerId": 4003,
            "speakerName": "玛达赫",
            "text": "…彼时那巨龙已降临，无人知晓其真名。谁人能解蒙德危急，谁人能救此地生灵？",
            "nextDialogs": [
              "230001403"
            ]
          },
          "230001403": {
            "id": "230001403",
            "speakerId": 4003,
            "speakerName": "玛达赫",
            "text": "…勇士伴风而行，诗人抚琴低吟：何故千年守护一朝弃，只因深渊毒血乱龙心。",
            "nextDialogs": [
              "230001404"
            ]
          },
          "230001404": {
            "id": "230001404",
            "speakerId": 4003,
            "speakerName": "玛达赫",
            "text": "…魔风息，毒血净。后世之子孙，勿忘其名姓，此诗献予东风之龙特瓦林！",
            "nextDialogs": [
              "230001405"
            ]
          },
          "230001405": {
            "id": "230001405",
            "speakerId": 4001,
            "speakerName": "乃亚卜",
            "text": "嘿！这回的故事可算有点意思了。",
            "nextDialogs": [
              "230001406"
            ]
          },
          "230001406": {
            "id": "230001406",
            "speakerId": 4005,
            "speakerName": "伊泽姆",
            "text": "被视作反派的角色其实有着无可奈何的背景…不管在什么故事里都让人动容啊。",
            "nextDialogs": [
              "230001407"
            ]
          },
          "230001407": {
            "id": "230001407",
            "speakerId": 4003,
            "speakerName": "玛达赫",
            "text": "今天的故事就到这里，欢迎各位下次再来！"
          }
        }
      }
    },
    {
      "subId": "2300015",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "230001501"
        ],
        "dialogs": {
          "230001501": {
            "id": "230001501",
            "speakerId": 4003,
            "speakerName": "玛达赫",
            "text": "咳咳，今天要讲的故事发生在遥远的异国。各位请听：「金发剑侠英雄传」！",
            "nextDialogs": [
              "230001502"
            ]
          },
          "230001502": {
            "id": "230001502",
            "speakerId": 4003,
            "speakerName": "玛达赫",
            "text": "…仙祖法蜕自天降，千年岩港生乱象。云来海下暗潮动，无心旅人入局中。",
            "nextDialogs": [
              "230001503"
            ]
          },
          "230001503": {
            "id": "230001503",
            "speakerId": 4003,
            "speakerName": "玛达赫",
            "text": "…纵各方有百千般算计，合力御敌成当务之急。海生漩涡奥赛尔，天悬掩月群玉阁。雕梁画栋付之一陨，散尽千金降下一击！",
            "nextDialogs": [
              "230001504"
            ]
          },
          "230001504": {
            "id": "230001504",
            "speakerId": 4003,
            "speakerName": "玛达赫",
            "text": "…岩神治下璃月古来包容万象，而今迎接无神之世又有何妨。离巢雏鸟任翱翔，千年岩港焕新光！",
            "nextDialogs": [
              "230001505"
            ]
          },
          "230001505": {
            "id": "230001505",
            "speakerId": 4001,
            "speakerName": "乃亚卜",
            "text": "嘿！这回的故事可算有点意思了。",
            "nextDialogs": [
              "230001506"
            ]
          },
          "230001506": {
            "id": "230001506",
            "speakerId": 4005,
            "speakerName": "伊泽姆",
            "text": "起初互有矛盾的双方，在并肩作战的过程中建立了信赖…这种展开真是百听不厌啊。",
            "nextDialogs": [
              "230001507"
            ]
          },
          "230001507": {
            "id": "230001507",
            "speakerId": 4003,
            "speakerName": "玛达赫",
            "text": "今天的故事就到这里，欢迎各位下次再来！"
          }
        }
      }
    },
    {
      "subId": "2300016",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "230001601"
        ],
        "dialogs": {
          "230001601": {
            "id": "230001601",
            "speakerId": 4003,
            "speakerName": "玛达赫",
            "text": "咳咳，今天要讲的故事发生在遥远的异国。各位请听：「异邦人稻妻剑刃谭」！",
            "nextDialogs": [
              "230001602"
            ]
          },
          "230001602": {
            "id": "230001602",
            "speakerId": 4003,
            "speakerName": "玛达赫",
            "text": "#…雷鸣响彻远海之外，宿命的旅人将到来。{M#他}{F#她}于诸岛如电光穿梭，{M#他}{F#她}的义举被天下人诉说。",
            "nextDialogs": [
              "230001603"
            ]
          },
          "230001603": {
            "id": "230001603",
            "speakerId": 4003,
            "speakerName": "玛达赫",
            "text": "…那执行官折戟御前，自食傲慢苦果。旅人的同伴们挺身相救，挡下雷霆之祸！",
            "nextDialogs": [
              "230001604"
            ]
          },
          "230001604": {
            "id": "230001604",
            "speakerId": 4003,
            "speakerName": "玛达赫",
            "text": "…净土高悬万千星光，正是凡人心中梦想。终有地上生灵，能撼天上威光！",
            "nextDialogs": [
              "230001605"
            ]
          },
          "230001605": {
            "id": "230001605",
            "speakerId": 4001,
            "speakerName": "乃亚卜",
            "text": "嘿！这回的故事可算有点意思了。",
            "nextDialogs": [
              "230001606"
            ]
          },
          "230001606": {
            "id": "230001606",
            "speakerId": 4005,
            "speakerName": "伊泽姆",
            "text": "嗯…和伙伴一起渡过难关吗，这才是英雄故事该有的样子嘛。",
            "nextDialogs": [
              "230001607"
            ]
          },
          "230001607": {
            "id": "230001607",
            "speakerId": 4003,
            "speakerName": "玛达赫",
            "text": "今天的故事就到这里，欢迎各位下次再来！"
          }
        }
      }
    },
    {
      "subId": "2300017",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "230001701"
        ],
        "dialogs": {
          "230001701": {
            "id": "230001701",
            "speakerId": 4003,
            "speakerName": "玛达赫",
            "text": "嘿！您也来了啊，旅行者。今天的故事感觉怎么样？",
            "nextDialogs": [
              "230001704"
            ]
          },
          "230001704": {
            "id": "230001704",
            "speakerId": 4003,
            "speakerName": "玛达赫",
            "text": "哈哈，和其他客人的评价一样呢。一个新的时代里，会出现新的英雄、新的故事。",
            "nextDialogs": [
              "230001705"
            ]
          },
          "230001705": {
            "id": "230001705",
            "speakerId": 4003,
            "speakerName": "玛达赫",
            "text": "多亏了他们，我们这行才能干得长远…哦，当然也得谢谢您，这下我应该能喝杯好点的咖啡了。",
            "nextDialogs": [
              "230001706"
            ]
          },
          "230001706": {
            "id": "230001706",
            "speakerId": 4003,
            "speakerName": "玛达赫",
            "text": "多谢您提供的素材，这些报酬还请收下。",
            "nextDialogs": [
              "230001707"
            ]
          },
          "230001707": {
            "id": "230001707",
            "speakerId": 4003,
            "speakerName": "玛达赫",
            "text": "以后还有什么故事，记着分享给我啊！"
          }
        }
      }
    }
  ]
}
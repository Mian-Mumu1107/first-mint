    {
      "subId": "800709",
      "subQuestName": "前往哈夫丹附近",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "80070901"
        ],
        "dialogs": {
          "80070901": {
            "id": "80070901",
            "speakerId": 1002,
            "speakerName": "派蒙",
            "text": "这下总算是把装置彻底关掉了吧？",
            "nextDialogs": [
              "80070902"
            ]
          },
          "80070902": {
            "id": "80070902",
            "speakerId": 1000,
            "speakerName": "戴因斯雷布",
            "text": "烧灼感消失了…",
            "nextDialogs": [
              "80070903"
            ]
          },
          "80070903": {
            "id": "80070903",
            "speakerId": 1002,
            "speakerName": "派蒙",
            "text": "我们成功阻止了深渊的计划吗？",
            "nextDialogs": [
              "80070906"
            ]
          },
          "80070906": {
            "id": "80070906",
            "speakerId": 1000,
            "speakerName": "戴因斯雷布",
            "text": "……",
            "nextDialogs": [
              "80070907"
            ]
          },
          "80070907": {
            "id": "80070907",
            "speakerId": 1000,
            "speakerName": "戴因斯雷布",
            "text": "我再确认一下。",
            "nextDialogs": [
              "80070908"
            ]
          },
          "80070908": {
            "id": "80070908",
            "speakerId": 1002,
            "speakerName": "派蒙",
            "text": "戴因他…其实很难过吧？",
            "nextDialogs": [
              "80070909"
            ]
          },
          "80070909": {
            "id": "80070909",
            "speakerId": 1002,
            "speakerName": "派蒙",
            "text": "昔日的战友，以这样的形式再会…",
            "nextDialogs": [
              "80070910"
            ]
          },
          "80070910": {
            "id": "80070910",
            "speakerId": 1000,
            "speakerName": "戴因斯雷布",
            "text": "……",
            "nextDialogs": [
              "80070911"
            ]
          },
          "80070911": {
            "id": "80070911",
            "speakerId": 1000,
            "speakerName": "戴因斯雷布",
            "text": "…走吧。"
          }
        }
      }
    },
    {
      "subId": "800710",
      "subQuestName": "与戴因斯雷布对话",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "80071001"
        ],
        "dialogs": {
          "80071001": {
            "id": "80071001",
            "speakerId": 1002,
            "speakerName": "派蒙",
            "text": "刚才那是…哈夫丹的灵魂…",
            "nextDialogs": [
              "80071002"
            ]
          },
          "80071002": {
            "id": "80071002",
            "speakerId": 1000,
            "speakerName": "戴因斯雷布",
            "text": "这里汇聚着不止一种诡异力量。就算见到魂魄也不奇怪。",
            "nextDialogs": [
              "80071003"
            ]
          },
          "80071003": {
            "id": "80071003",
            "speakerId": 1000,
            "speakerName": "戴因斯雷布",
            "text": "不过，如果你们想继续前往深处探索，就要小心了。",
            "nextDialogs": [
              "80071004"
            ]
          },
          "80071004": {
            "id": "80071004",
            "speakerId": 1000,
            "speakerName": "戴因斯雷布",
            "text": "咳咳…",
            "nextDialogs": [
              "80071005"
            ]
          },
          "80071005": {
            "id": "80071005",
            "speakerId": 1002,
            "speakerName": "派蒙",
            "text": "嗯，我们会小心的。欸对了，戴因难道不跟我们一起走吗？",
            "nextDialogs": [
              "80071006"
            ]
          },
          "80071006": {
            "id": "80071006",
            "speakerId": 1000,
            "speakerName": "戴因斯雷布",
            "text": "刚才那台装置同样给我造成了不小的创伤，我需要一点时间来恢复。",
            "nextDialogs": [
              "80071007"
            ]
          },
          "80071007": {
            "id": "80071007",
            "speakerId": 1002,
            "speakerName": "派蒙",
            "text": "原来如此…不对，我其实早就看出来了，你一直是在硬撑而已！",
            "nextDialogs": [
              "80071008"
            ]
          },
          "80071008": {
            "id": "80071008",
            "speakerId": 1002,
            "speakerName": "派蒙",
            "text": "也该休息了，戴因…比如说，给自己放个假什么的！",
            "nextDialogs": [
              "80071009"
            ]
          },
          "80071009": {
            "id": "80071009",
            "speakerId": 1000,
            "speakerName": "戴因斯雷布",
            "text": "放假？这不是该出现在我身上的词语。",
            "nextDialogs": [
              "80071010"
            ]
          },
          "80071010": {
            "id": "80071010",
            "speakerId": 1000,
            "speakerName": "戴因斯雷布",
            "text": "我还有重要的事。「命运的织机」计划还在进行。",
            "nextDialogs": [
              "80071011"
            ]
          },
          "80071011": {
            "id": "80071011",
            "speakerId": 1000,
            "speakerName": "戴因斯雷布",
            "text": "我甚至怀疑，这里的增幅装置也跟那个计划有关。",
            "nextDialogs": [
              "80071014"
            ]
          },
          "80071014": {
            "id": "80071014",
            "speakerId": 1000,
            "speakerName": "戴因斯雷布",
            "text": "感谢你的体谅，「雇主」。",
            "nextDialogs": [
              "80071015"
            ]
          },
          "80071015": {
            "id": "80071015",
            "speakerId": 1000,
            "speakerName": "戴因斯雷布",
            "text": "只希望下次见面时，你不会站在「那边」。",
            "nextDialogs": [
              "80071016"
            ]
          },
          "80071016": {
            "id": "80071016",
            "speakerId": 1002,
            "speakerName": "派蒙",
            "text": "喂，戴因他是不是有点记仇呀，最后才那么说…",
            "nextDialogs": [
              "80071017"
            ]
          },
          "80071017": {
            "id": "80071017",
            "speakerId": 1002,
            "speakerName": "派蒙",
            "text": "#虽然还是没能再一次见到你的{PLAYERAVATAR#SEXPRO[INFO_FEMALE_PRONOUN_SISTER|INFO_MALE_PRONOUN_BROTHER]}，但也算是了解了很多有用的信息吧？",
            "nextDialogs": [
              "80071018"
            ]
          },
          "80071018": {
            "id": "80071018",
            "speakerId": 1002,
            "speakerName": "派蒙",
            "text": "只要继续旅行，你们总会相遇，然后和好如初的，对吧？",
            "nextDialogs": [
              "80071019"
            ]
          },
          "80071019": {
            "id": "80071019",
            "speakerId": 1002,
            "speakerName": "派蒙",
            "text": "哦对了，还记得我们一开始是为了调查丘丘人们的诡异行踪才过来的吗？",
            "nextDialogs": [
              "80071020"
            ]
          },
          "80071020": {
            "id": "80071020",
            "speakerId": 1002,
            "speakerName": "派蒙",
            "text": "这下应该可以找那位矿工大哥报告了吧，只是…好像有点不知道怎么说，这里发生的事对普通人来说有些太过复杂了吧！",
            "nextDialogs": [
              "80071021"
            ]
          },
          "80071021": {
            "id": "80071021",
            "speakerId": 1002,
            "speakerName": "派蒙",
            "text": "总之，别把那份委托给忘了就行。"
          }
        }
      }
    },
    {
      "subId": "800799",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "80079901"
        ],
        "dialogs": {
          "80079901": {
            "id": "80079901",
            "speakerId": 1002,
            "speakerName": "派蒙",
            "text": "那些丘丘人看起来真的很痛苦…啊！难道说，现在的戴因也在忍受这样的痛苦吗？",
            "nextDialogs": [
              "80079902"
            ]
          },
          "80079902": {
            "id": "80079902",
            "speakerId": 1000,
            "speakerName": "戴因斯雷布",
            "text": "不必介意。哈夫丹他们所承受的苦痛远胜于我。抓紧时间！",
            "nextDialogs": [
              "80079904"
            ]
          },
          "80079904": {
            "id": "80079904",
            "speakerId": 1002,
            "speakerName": "派蒙",
            "text": "四周都暗下来了，我们回去中央的房间看看吧？"
          }
        }
      }
    }
  ]
}
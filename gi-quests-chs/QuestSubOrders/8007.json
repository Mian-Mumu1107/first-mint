  "subQuests": [
    {
      "subId": "800701",
      "subQuestName": "前往遗迹顶层中心的房间查看情况",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "80070101"
        ],
        "dialogs": {
          "80070101": {
            "id": "80070101",
            "speakerId": 1000,
            "speakerName": "戴因斯雷布",
            "text": "本以为会在一瞬间灰飞烟灭…哈夫丹的灵魂竟然如此强韧。",
            "nextDialogs": [
              "80070102"
            ]
          },
          "80070102": {
            "id": "80070102",
            "speakerId": 1001,
            "speakerName": "深渊司铎",
            "text": "碍事的东西！给我闪开…",
            "nextDialogs": [
              "80070103"
            ]
          },
          "80070103": {
            "id": "80070103",
            "speakerId": 1000,
            "speakerName": "戴因斯雷布",
            "text": "你在看哪里？机会难得，你总算能除掉我了，不是吗？",
            "nextDialogs": [
              "80070104"
            ]
          },
          "80070104": {
            "id": "80070104",
            "speakerId": 1001,
            "speakerName": "深渊司铎",
            "text": "…戴因斯雷布！",
            "nextDialogs": [
              "80070105"
            ]
          },
          "80070105": {
            "id": "80070105",
            "speakerId": 1000,
            "speakerName": "戴因斯雷布",
            "text": "干掉他，关闭那个装置！"
          }
        }
      }
    },

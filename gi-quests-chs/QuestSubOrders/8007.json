    {
      "subId": "800703",
      "subQuestName": "与戴因斯雷布对话",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "80070301"
        ],
        "dialogs": {
          "80070301": {
            "id": "80070301",
            "speakerId": 1002,
            "speakerName": "派蒙",
            "text": "怎么办，把那个深渊司铎解决了，装置却还是没有停下来…",
            "nextDialogs": [
              "80070302"
            ]
          },
          "80070302": {
            "id": "80070302",
            "speakerId": 1002,
            "speakerName": "派蒙",
            "text": "哈夫丹他…",
            "nextDialogs": [
              "80070305"
            ]
          },
          "80070305": {
            "id": "80070305",
            "speakerId": 1000,
            "speakerName": "戴因斯雷布",
            "text": "不行！只要装置还保持启动状态，我们这些受过诅咒的人就无法发挥出原本实力，只有你才是深渊的对手。",
            "nextDialogs": [
              "80070306"
            ]
          },
          "80070306": {
            "id": "80070306",
            "speakerId": 1000,
            "speakerName": "戴因斯雷布",
            "text": "如果你珍惜他的献身，就别在这里浪费时间。",
            "nextDialogs": [
              "80070307"
            ]
          },
          "80070307": {
            "id": "80070307",
            "speakerId": 1000,
            "speakerName": "戴因斯雷布",
            "text": "看到周围那些光线和传送门了吗？他们一定把能源装置分散安置在别处了，过去确认情况，要快！",
            "nextDialogs": [
              "80070308"
            ]
          },
          "80070308": {
            "id": "80070308",
            "speakerId": 1002,
            "speakerName": "派蒙",
            "text": "是要穿过那些深渊的传送门吗…喂等等我！"
          }
        }
      }
    },

    {
      "subId": "4011111",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "401111101"
        ],
        "dialogs": {
          "401111101": {
            "id": "401111101",
            "speakerId": 1000,
            "speakerName": "提米",
            "text": "赢喽赢喽！",
            "nextDialogs": [
              "401111103",
              "401111107"
            ]
          },
          "401111103": {
            "id": "401111103",
            "speakerId": 1000,
            "speakerName": "提米",
            "text": "谢谢你们。这样一来，妈妈一定也会开心的吧？",
            "nextDialogs": [
              "401111104"
            ]
          },
          "401111104": {
            "id": "401111104",
            "speakerId": 1000,
            "speakerName": "提米",
            "text": "葛瑞丝妈妈一直鼓励我来参加比赛，我要把得到的奖品都送给妈妈！",
            "nextDialogs": [
              "401111105"
            ]
          },
          "401111105": {
            "id": "401111105",
            "speakerId": 1000,
            "speakerName": "提米",
            "text": "真希望爸爸也能看到我现在的样子…"
          },
          "401111107": {
            "id": "401111107",
            "speakerId": 1000,
            "speakerName": "提米",
            "text": "再见，「七圣召唤」真好玩。"
          }
        }
      }
    },
    {
      "subId": "4011112",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "401111201"
        ],
        "dialogs": {
          "401111201": {
            "id": "401111201",
            "speakerId": 1001,
            "speakerName": "米卡",
            "text": "已经散场了吗？我、我来晚了…",
            "nextDialogs": [
              "401111202"
            ]
          },
          "401111202": {
            "id": "401111202",
            "speakerId": 1002,
            "speakerName": "霍夫曼",
            "text": "米卡，真遗憾你没看到。凯亚队长…居然输了。",
            "nextDialogs": [
              "401111203"
            ]
          },
          "401111203": {
            "id": "401111203",
            "speakerId": 1001,
            "speakerName": "米卡",
            "text": "啊？！",
            "nextDialogs": [
              "401111204"
            ]
          },
          "401111204": {
            "id": "401111204",
            "speakerId": 1001,
            "speakerName": "米卡",
            "text": "哥哥，具体是怎么回事？",
            "nextDialogs": [
              "401111205"
            ]
          },
          "401111205": {
            "id": "401111205",
            "speakerId": 1002,
            "speakerName": "霍夫曼",
            "text": "我对「七圣召唤」没什么研究，全靠大家的谈论来理解局势。",
            "nextDialogs": [
              "401111206"
            ]
          },
          "401111206": {
            "id": "401111206",
            "speakerId": 1002,
            "speakerName": "霍夫曼",
            "text": "一开始，凯亚队长很快拿下了对面的第一张牌，形势大优。",
            "nextDialogs": [
              "401111207"
            ]
          },
          "401111207": {
            "id": "401111207",
            "speakerId": 1002,
            "speakerName": "霍夫曼",
            "text": "但这似乎正是对方的策略？那位叫提米的孩子，靠着前几个回合囤积起手上的卡牌…最后爆发出了惊人的威力。",
            "nextDialogs": [
              "401111208"
            ]
          },
          "401111208": {
            "id": "401111208",
            "speakerId": 1002,
            "speakerName": "霍夫曼",
            "text": "不…或许这场比赛的胜负，早在凯亚队长抽到「后手」的那一刻，就被决定了…",
            "nextDialogs": [
              "401111209"
            ]
          },
          "401111209": {
            "id": "401111209",
            "speakerId": 1002,
            "speakerName": "霍夫曼",
            "text": "唉，我想去喝一杯…",
            "nextDialogs": [
              "401111210"
            ]
          },
          "401111210": {
            "id": "401111210",
            "speakerId": 1001,
            "speakerName": "米卡",
            "text": "哥哥，你冷静一点，现在不是借酒消愁的时候。",
            "nextDialogs": [
              "401111211"
            ]
          },
          "401111211": {
            "id": "401111211",
            "speakerId": 1001,
            "speakerName": "米卡",
            "text": "据我了解的凯亚队长，他应该也不想看到你为他难过才对。",
            "nextDialogs": [
              "401111212"
            ]
          },
          "401111212": {
            "id": "401111212",
            "speakerId": 1001,
            "speakerName": "米卡",
            "text": "倒不如我们也学学打牌吧？说不好下次还能跟凯亚队长亲自过招！哈哈…恐怕会输得很惨吧。",
            "nextDialogs": [
              "401111213"
            ]
          },
          "401111213": {
            "id": "401111213",
            "speakerId": 1002,
            "speakerName": "霍夫曼",
            "text": "哈，你说得对，米卡。"
          }
        }
      }
    },
    {
      "subId": "4011113",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "401111301"
        ],
        "dialogs": {
          "401111301": {
            "id": "401111301",
            "speakerId": 1003,
            "speakerName": "凯亚",
            "text": "哟，还有什么想聊的吗？",
            "nextDialogs": [
              "401111303"
            ]
          },
          "401111303": {
            "id": "401111303",
            "speakerId": 1003,
            "speakerName": "凯亚",
            "text": "最近这卡牌可真是火爆，简直像成了大家生活的一部分。到处都能看到有人玩。",
            "nextDialogs": [
              "401111304"
            ]
          },
          "401111304": {
            "id": "401111304",
            "speakerId": 1003,
            "speakerName": "凯亚",
            "text": "而且，还真有人为了保持清醒的头脑打牌，把酒都给戒了。",
            "nextDialogs": [
              "401111305"
            ]
          },
          "401111305": {
            "id": "401111305",
            "speakerId": 1003,
            "speakerName": "凯亚",
            "text": "啧啧，迪奥娜听到后应该会很高兴吧？"
          }
        }
      }
    },
    {
      "subId": "4011114",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "401111401"
        ],
        "dialogs": {
          "401111401": {
            "id": "401111401",
            "speakerId": 1004,
            "speakerName": "艾辛多弗",
            "text": "真是场精彩的比赛，那位提米小弟…潜力无限啊。",
            "nextDialogs": [
              "401111402"
            ]
          },
          "401111402": {
            "id": "401111402",
            "speakerId": 1005,
            "speakerName": "伦纳德",
            "text": "没想到提米还真的赢了…我也算是…虽败犹荣，虽败犹荣。"
          }
        }
      }
    },
    {
      "subId": "4011115",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "401111501"
        ],
        "dialogs": {
          "401111501": {
            "id": "401111501",
            "speakerId": 1006,
            "speakerName": "夏洛蒂",
            "text": "「西风骑兵队长对阵天才不败少年，湖中之城人才辈出」…",
            "nextDialogs": [
              "401111502"
            ]
          },
          "401111502": {
            "id": "401111502",
            "speakerId": 1006,
            "speakerName": "夏洛蒂",
            "text": "唔，用这个标题的话，面子倒是给足了，但少了些「爆点」。",
            "nextDialogs": [
              "401111503"
            ]
          },
          "401111503": {
            "id": "401111503",
            "speakerId": 1006,
            "speakerName": "夏洛蒂",
            "text": "「西风骑士团的顶尖头脑派，竟在五回合内输给桥头少年」…",
            "nextDialogs": [
              "401111504"
            ]
          },
          "401111504": {
            "id": "401111504",
            "speakerId": 1006,
            "speakerName": "夏洛蒂",
            "text": "「如麦穗般辉煌的逆转胜」…",
            "nextDialogs": [
              "401111505"
            ]
          },
          "401111505": {
            "id": "401111505",
            "speakerId": 1006,
            "speakerName": "夏洛蒂",
            "text": "嗯，要不，还是用回第一版？…"
          }
        }
      }
    },
    {
      "subId": "4011131",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "401113101"
        ],
        "dialogs": {
          "401113101": {
            "id": "401113101",
            "speakerId": 1007,
            "speakerName": "胡桃",
            "text": "这么说来，北斗姐也会打「七圣召唤」？",
            "nextDialogs": [
              "401113102"
            ]
          },
          "401113102": {
            "id": "401113102",
            "speakerId": 1008,
            "speakerName": "枫原万叶",
            "text": "嗯，大姐头的牌技在南十字船队称得上数一数二了。",
            "nextDialogs": [
              "401113103"
            ]
          },
          "401113103": {
            "id": "401113103",
            "speakerId": 1007,
            "speakerName": "胡桃",
            "text": "要不万叶小哥帮我引荐引荐？我对北斗姐崇拜已久，早就想跟她交朋友啦，可一直没遇到机会。",
            "nextDialogs": [
              "401113104"
            ]
          },
          "401113104": {
            "id": "401113104",
            "speakerId": 1008,
            "speakerName": "枫原万叶",
            "text": "好。到时候还请堂主手下留情。"
          }
        }
      }
    },
    {
      "subId": "4011132",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "401113201"
        ],
        "dialogs": {
          "401113201": {
            "id": "401113201",
            "speakerId": 1009,
            "speakerName": "凝光",
            "text": "听闻「七圣召唤」的坊间比赛办得很是热闹，不少热爱牌戏的选手甚至在两边同时报了名。",
            "nextDialogs": [
              "401113202"
            ]
          },
          "401113202": {
            "id": "401113202",
            "speakerId": 1009,
            "speakerName": "凝光",
            "text": "我的话…偶尔迎迎潮流无妨，但还是对棋戏更感兴趣。",
            "nextDialogs": [
              "401113203"
            ]
          },
          "401113203": {
            "id": "401113203",
            "speakerId": 1009,
            "speakerName": "凝光",
            "text": "说到底，这些游艺只是形式不同。更珍贵的，还是朋友相聚这一事实。"
          }
        }
      }
    },
    {
      "subId": "4011133",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "401113301"
        ],
        "dialogs": {
          "401113301": {
            "id": "401113301",
            "speakerId": 1006,
            "speakerName": "夏洛蒂",
            "text": "您好您好，我是来自枫丹「蒸汽鸟报社」的记者夏洛蒂。",
            "nextDialogs": [
              "401113302"
            ]
          },
          "401113302": {
            "id": "401113302",
            "speakerId": 1006,
            "speakerName": "夏洛蒂",
            "text": "请问方便抽点时间吗？我想对您做个简单采访。",
            "nextDialogs": [
              "401113303"
            ]
          },
          "401113303": {
            "id": "401113303",
            "speakerId": 1010,
            "speakerName": "小千",
            "text": "唉，你问吧。",
            "nextDialogs": [
              "401113304"
            ]
          },
          "401113304": {
            "id": "401113304",
            "speakerId": 1006,
            "speakerName": "夏洛蒂",
            "text": "您一路过关斩将，最后关头不敌往生堂的胡桃胡堂主，与冠军失之交臂，看起来相当遗憾。",
            "nextDialogs": [
              "401113305"
            ]
          },
          "401113305": {
            "id": "401113305",
            "speakerId": 1006,
            "speakerName": "夏洛蒂",
            "text": "请问您会如何评价这场比赛呢？",
            "nextDialogs": [
              "401113306"
            ]
          },
          "401113306": {
            "id": "401113306",
            "speakerId": 1010,
            "speakerName": "小千",
            "text": "…这。",
            "nextDialogs": [
              "401113307"
            ]
          },
          "401113307": {
            "id": "401113307",
            "speakerId": 1010,
            "speakerName": "小千",
            "text": "记者小姐，你要的是能写上报纸的回答，还是我的真实想法？",
            "nextDialogs": [
              "401113308"
            ]
          },
          "401113308": {
            "id": "401113308",
            "speakerId": 1006,
            "speakerName": "夏洛蒂",
            "text": "当然是真实想法。",
            "nextDialogs": [
              "401113309"
            ]
          },
          "401113309": {
            "id": "401113309",
            "speakerId": 1010,
            "speakerName": "小千",
            "text": "唉…",
            "nextDialogs": [
              "401113310"
            ]
          },
          "401113310": {
            "id": "401113310",
            "speakerId": 1010,
            "speakerName": "小千",
            "text": "虽然打牌七分靠技术，三分靠运气…但这一次投出六个同色骰，别说我只是个冒险家，就算我是仙人也打不过啊！"
          }
        }
      }
    },
    {
      "subId": "4011151",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "401115101"
        ],
        "dialogs": {
          "401115101": {
            "id": "401115101",
            "speakerId": 1011,
            "speakerName": "荒泷一斗",
            "text": "狐狸女人和什么宫的什么海的比赛，看得我热血沸腾，脑门的汗就像烧开的水一样！",
            "nextDialogs": [
              "401115102"
            ]
          },
          "401115102": {
            "id": "401115102",
            "speakerId": 1012,
            "speakerName": "久岐忍",
            "text": "是是是。老大，整个离岛都知道你的激动之情了。但荒泷派大家还在等着，差不多该回去了。",
            "nextDialogs": [
              "401115103"
            ]
          },
          "401115103": {
            "id": "401115103",
            "speakerId": 1011,
            "speakerName": "荒泷一斗",
            "text": "再等等，不差这一会儿。至少也让我和挚友最后来上一局…这愿望不过分吧？",
            "nextDialogs": [
              "401115105",
              "401115108"
            ]
          },
          "401115105": {
            "id": "401115105",
            "speakerId": 1011,
            "speakerName": "荒泷一斗",
            "text": "挚友啊！你真的是我的挚友！我这熊熊燃烧的卡牌之魂，只有你才能懂！",
            "nextDialogs": [
              "401115106"
            ]
          },
          "401115106": {
            "id": "401115106",
            "speakerId": 1012,
            "speakerName": "久岐忍",
            "text": "…真拿你们没办法。"
          },
          "401115108": {
            "id": "401115108",
            "speakerId": 1011,
            "speakerName": "荒泷一斗",
            "text": "…好吧。",
            "nextDialogs": [
              "401115109"
            ]
          },
          "401115109": {
            "id": "401115109",
            "speakerId": 1011,
            "speakerName": "荒泷一斗",
            "text": "男子汉有泪不轻弹。我是不会责怪你的，挚友！"
          }
        }
      }
    },
    {
      "subId": "4011152",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "401115201"
        ],
        "dialogs": {
          "401115201": {
            "id": "401115201",
            "speakerId": 1013,
            "speakerName": "珊瑚宫心海",
            "text": "九条小姐，有空聊上几句吗？",
            "nextDialogs": [
              "401115202"
            ]
          },
          "401115202": {
            "id": "401115202",
            "speakerId": 1014,
            "speakerName": "九条裟罗",
            "text": "祝贺你获胜，珊瑚宫心海。",
            "nextDialogs": [
              "401115203"
            ]
          },
          "401115203": {
            "id": "401115203",
            "speakerId": 1013,
            "speakerName": "珊瑚宫心海",
            "text": "正是多亏了九条小姐此前的提醒，非常感谢。",
            "nextDialogs": [
              "401115204"
            ]
          },
          "401115204": {
            "id": "401115204",
            "speakerId": 1014,
            "speakerName": "九条裟罗",
            "text": "你说笑了。明眼人都明白，左右胜负的是彼此的技艺与策略。无论如何，它都是一场精彩的较量。",
            "nextDialogs": [
              "401115205"
            ]
          },
          "401115205": {
            "id": "401115205",
            "speakerId": 1013,
            "speakerName": "珊瑚宫心海",
            "text": "这次九条小姐没有报名实在可惜。",
            "nextDialogs": [
              "401115206"
            ]
          },
          "401115206": {
            "id": "401115206",
            "speakerId": 1014,
            "speakerName": "九条裟罗",
            "text": "我恐怕赢不了你。",
            "nextDialogs": [
              "401115207"
            ]
          },
          "401115207": {
            "id": "401115207",
            "speakerId": 1013,
            "speakerName": "珊瑚宫心海",
            "text": "哪里的话。我猜九条小姐也像我一样，期待着在牌局中磨炼技艺，思考对策，和他人如朋友般切磋吧。",
            "nextDialogs": [
              "401115208"
            ]
          },
          "401115208": {
            "id": "401115208",
            "speakerId": 1014,
            "speakerName": "九条裟罗",
            "text": "…或许吧。",
            "nextDialogs": [
              "401115209"
            ]
          },
          "401115209": {
            "id": "401115209",
            "speakerId": 1014,
            "speakerName": "九条裟罗",
            "text": "我明白了。既然如此，在你离开鸣神岛之前，我们就来上一局「七圣召唤」吧。",
            "nextDialogs": [
              "401115210"
            ]
          },
          "401115210": {
            "id": "401115210",
            "speakerId": 1013,
            "speakerName": "珊瑚宫心海",
            "text": "乐意之至。"
          }
        }
      }
    },
    {
      "subId": "4011153",

        "dialogs": {
          "401115301": {
            "id": "401115301",
            "speakerId": 1006,
            "speakerName": "夏洛蒂",
            "text": "我听你叫她「狐妖大人」，这里面有什么来由吗？",
            "nextDialogs": [
              "401115302"
            ]
          },
          "401115302": {
            "id": "401115302",
            "speakerId": 1006,
            "speakerName": "夏洛蒂",
            "text": "和我具体讲讲吧，说不定写稿用得上呢！",
            "nextDialogs": [
              "401115303"
            ]
          },
          "401115303": {
            "id": "401115303",
            "speakerId": 1015,
            "speakerName": "绮良良",
            "text": "欸？真要我讲，我反倒怕说错话了，毕竟我作为妖怪的资历还很浅嘛。",
            "nextDialogs": [
              "401115304"
            ]
          },
          "401115304": {
            "id": "401115304",
            "speakerId": 1006,
            "speakerName": "夏洛蒂",
            "text": "好吧，那油豆腐和狐狸有什么关系？",
            "nextDialogs": [
              "401115305"
            ]
          },
          "401115305": {
            "id": "401115305",
            "speakerId": 1015,
            "speakerName": "绮良良",
            "text": "哎呀，被你问得肚子都饿了。",
            "nextDialogs": [
              "401115306"
            ]
          },
          "401115306": {
            "id": "401115306",
            "speakerId": 1015,
            "speakerName": "绮良良",
            "text": "不如我带你吃稻妻的油豆腐拉面吧，边吃边跟你解释。"
          }
        }
      }
    },

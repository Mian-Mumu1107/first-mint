    "芬德": 25
  },
  "subQuests": [
    {
      "subId": "2004001",
      "subQuestName": "与芬德修女对话",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "200400101"
        ],
        "dialogs": {
          "200400101": {
            "id": "200400101",
            "speakerId": 1581,
            "speakerName": "芬德",
            "text": "唉，到底怎么过去呢…",
            "nextDialogs": [
              "200400102"
            ]
          },
          "200400102": {
            "id": "200400102",
            "speakerId": 1581,
            "speakerName": "芬德",
            "text": "哦…您找我有什么事吗？",
            "nextDialogs": [
              "200400103"
            ]
          },
          "200400103": {
            "id": "200400103",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "您在这做什么？",
            "nextDialogs": [
              "200400104"
            ]
          },
          "200400104": {
            "id": "200400104",
            "speakerId": 1581,
            "speakerName": "芬德",
            "text": "我正准备去望风角的瞭望塔，去看看海上是不是有风暴在聚集。",
            "nextDialogs": [
              "200400105"
            ]
          },
          "200400105": {
            "id": "200400105",
            "speakerId": 1581,
            "speakerName": "芬德",
            "text": "可是前面有一群怪物挡住了路…我在思考怎么过去。",
            "nextDialogs": [
              "200400106"
            ]
          },
          "200400106": {
            "id": "200400106",
            "speakerId": 1581,
            "speakerName": "芬德",
            "text": "哦，不用担心，我没有让您代我去瞭望的意思。",
            "nextDialogs": [
              "200400107"
            ]
          },
          "200400107": {
            "id": "200400107",
            "speakerId": 1581,
            "speakerName": "芬德",
            "text": "这是我的职责，也是我个人的坚持而已。",
            "nextDialogs": [
              "200400108"
            ]
          },
          "200400108": {
            "id": "200400108",
            "speakerId": 1581,
            "speakerName": "芬德",
            "text": "您忙您的去吧，我自己再好好想想办法…"
          }
        }
      }
    },
    {
      "subId": "2004002",
      "subQuestName": "清剿烽火台上的魔物",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "200400201"
        ],
        "dialogs": {
          "200400201": {
            "id": "200400201",
            "speakerId": 1581,
            "speakerName": "芬德",
            "text": "您还有什么事吗？",
            "nextDialogs": [
              "200400202"
            ]
          },
          "200400202": {
            "id": "200400202",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "前面已经安全了。",
            "nextDialogs": [
              "200400203"
            ]
          },
          "200400203": {
            "id": "200400203",
            "speakerId": 1581,
            "speakerName": "芬德",
            "text": "咦？感谢风神…",
            "nextDialogs": [
              "200400204"
            ]
          },
          "200400204": {
            "id": "200400204",
            "speakerId": 1581,
            "speakerName": "芬德",
            "text": "不，不对，抱歉，我应该感谢的是您才对。",
            "nextDialogs": [
              "200400205"
            ]
          },
          "200400205": {
            "id": "200400205",
            "speakerId": 1581,
            "speakerName": "芬德",
            "text": "我该怎么回报您呢…哦，对了。",
            "nextDialogs": [
              "200400206"
            ]
          },
          "200400206": {
            "id": "200400206",
            "speakerId": 1581,
            "speakerName": "芬德",
            "text": "请您来瞭望塔顶吧，我在那等着您。"
          }
        }
      }
    },
    {
      "subId": "2004003",
      "subQuestName": "与芬德修女对话",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [],
        "dialogs": {}
      }
    },
    {
      "subId": "2004004",
      "subQuestName": "登上瞭望塔",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "200400401"
        ],
        "dialogs": {
          "200400401": {
            "id": "200400401",
            "speakerId": 1581,
            "speakerName": "芬德",
            "text": "嗯…今天也是风平浪静的一天。",
            "nextDialogs": [
              "200400402"
            ]
          },
          "200400402": {
            "id": "200400402",
            "speakerId": 1581,
            "speakerName": "芬德",
            "text": "我的家族受到温妮莎大人命令，世代在此为蒙德守望风暴，",
            "nextDialogs": [
              "200400403"
            ]
          },
          "200400403": {
            "id": "200400403",
            "speakerId": 1581,
            "speakerName": "芬德",
            "text": "虽然自从有了巴巴托斯大人的庇护，蒙德再也没有受到风暴的侵扰，瞭望台也逐渐废置了。",
            "nextDialogs": [
              "200400404"
            ]
          },
          "200400404": {
            "id": "200400404",
            "speakerId": 1581,
            "speakerName": "芬德",
            "text": "但即使是这样，我还是会不由自主地想去瞭望塔上看看。",
            "nextDialogs": [
              "200400406",
              "200400409"
            ]
          },
          "200400406": {
            "id": "200400406",
            "speakerId": 1581,
            "speakerName": "芬德",
            "text": "谢谢你，但是说到我的「职责」…",
            "nextDialogs": [
              "200400407"
            ]
          },
          "200400407": {
            "id": "200400407",
            "speakerId": 1581,
            "speakerName": "芬德",
            "text": "我倒宁愿永远不去真正履行它。",
            "nextDialogs": [
              "200400410"
            ]
          },
          "200400410": {
            "id": "200400410",
            "speakerId": 1581,
            "speakerName": "芬德",
            "text": "好了，谢谢您帮我，这些风车菊是给您的。",
            "nextDialogs": [
              "200400411"
            ]
          },
          "200400411": {
            "id": "200400411",
            "speakerId": 1581,
            "speakerName": "芬德",
            "text": "在之前，我的家族常以风车菊的生长程度，来判断一个地区的风力大小。",
            "nextDialogs": [
              "200400412"
            ]
          },
          "200400412": {
            "id": "200400412",
            "speakerId": 1581,
            "speakerName": "芬德",
            "text": "丝毫无风的地方，或者暴风侵袭的地方，都不会有风车菊存在。",
            "nextDialogs": [
              "200400413"
            ]
          },
          "200400413": {
            "id": "200400413",
            "speakerId": 1581,
            "speakerName": "芬德",
            "text": "只有在蒙德这样温柔的风中，它才会顺利地生长。",
            "nextDialogs": [
              "200400414"
            ]
          },
          "200400414": {
            "id": "200400414",
            "speakerId": 1581,
            "speakerName": "芬德",
            "text": "真希望，它们能一直这么顺利地生长下去啊…"
          },
          "200400409": {
            "id": "200400409",
            "speakerId": 1581,
            "speakerName": "芬德",
            "text": "是的，希望那段历史永远不再重演。"
          }
        }
      }
    },
    {
      "subId": "2004007",
      "subQuestName": "与芬德修女对话",
      "sceneId": null,
      "locations": [],

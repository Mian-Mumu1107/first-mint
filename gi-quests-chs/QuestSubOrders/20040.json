    },
    {
      "subId": "2004003",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "200400301"
        ],
        "dialogs": {
          "200400301": {
            "id": "200400301",
            "speakerId": 1581,
            "speakerName": "芬德",
            "text": "唔…如果跑得够快，能不能直接爬上去呢…"
          }
        }
      }
    },
    {
      "subId": "2004005",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "200400501"
        ],
        "dialogs": {
          "200400501": {
            "id": "200400501",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "虽然她话是这么说，但是前面的怪物很多呢。",
            "nextDialogs": [
              "200400502"
            ]
          },
          "200400502": {
            "id": "200400502",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "我们去帮芬德小姐扫除一下周围吧。",
            "nextDialogs": [
              "200400503"
            ]
          },
          "200400503": {
            "id": "200400503",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "看她认真的样子，搞不好会想着直接冲过去…",
            "nextDialogs": [
              "200400506",
              "200400507"
            ]
          },
          "200400506": {
            "id": "200400506",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "嗯，认真的人就应该得到帮助呢。"
          },
          "200400507": {
            "id": "200400507",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "那种是最糟糕的情况啦。",
            "nextDialogs": [
              "200400508"
            ]
          },
          "200400508": {
            "id": "200400508",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "为了不让这种情况发生，我们快点去扫除魔物吧。"
          }
        }
      }
    }
  ]
}
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "721590301"
        ],
        "dialogs": {
          "721590301": {
            "id": "721590301",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "想和你说说话。",
            "nextDialogs": [
              "721590302"
            ]
          },
          "721590302": {
            "id": "721590302",
            "speakerId": 3174,
            "speakerName": "「公义」",
            "text": "我放弃了自己的过去，今后也不想再对这个世界诉说些什么了。",
            "nextDialogs": [
              "721590303"
            ]
          },
          "721590303": {
            "id": "721590303",
            "speakerId": 3174,
            "speakerName": "「公义」",
            "text": "只想找人聊天的话，你不该找我。",
            "nextDialogs": [
              "721590304"
            ]
          },
          "721590304": {
            "id": "721590304",
            "speakerId": 3174,
            "speakerName": "「公义」",
            "text": "你走吧。"
          }
        }
      }
    },
    {
      "subId": "7215904",
      "subQuestName": "",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "721590501"
        ],
        "dialogs": {
          "721590501": {
            "id": "721590501",
            "speakerId": 3174,
            "speakerName": "「公义」",
            "text": "看来你近日来疏于练习。",
            "nextDialogs": [
              "721590502"
            ]
          },
          "721590502": {
            "id": "721590502",
            "speakerId": 3174,
            "speakerName": "「公义」",
            "text": "武者稍有一日怠惰便浪费了十日的勤勉，这个道理，你应该知道。",
            "nextDialogs": [
              "721590503"
            ]
          },
          "721590503": {
            "id": "721590503",
            "speakerId": 3174,
            "speakerName": "「公义」",
            "text": "回去磨炼自己吧，你不该只有这点本事。"
          }
        }
      }
    },
    {
      "subId": "7215905",
      "subQuestName": "",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "721590401"
        ],
        "dialogs": {
          "721590401": {
            "id": "721590401",
            "speakerId": 3174,
            "speakerName": "「公义」",
            "text": "呵呵，竟然还是赢不过你。",
            "nextDialogs": [
              "721590402"
            ]
          },
          "721590402": {
            "id": "721590402",
            "speakerId": 3174,
            "speakerName": "「公义」",
            "text": "也罢，你的武技仍在精进，我却因为心性所限再也悟不出更高深的奥义了。",
            "nextDialogs": [
              "721590403"
            ]
          },
          "721590403": {
            "id": "721590403",
            "speakerId": 3174,
            "speakerName": "「公义」",
            "text": "不过，若你习得了新的技艺，我依然乐于见识。",
            "nextDialogs": [
              "721590404"
            ]
          },
          "721590404": {
            "id": "721590404",
            "speakerId": 3174,
            "speakerName": "「公义」",
            "text": "那么，下次再会吧。"
          }
        }
      }
    }
  ]

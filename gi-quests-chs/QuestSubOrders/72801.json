    {
      "subId": "7280108",
      "subQuestName": "在海滩上四处走走",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "728010801"
        ],
        "dialogs": {
          "728010801": {
            "id": "728010801",
            "speakerId": 3013,
            "speakerName": "平八",
            "text": "杵在我面前干什么？找茬啊？",
            "nextDialogs": [
              "728010802"
            ]
          },
          "728010802": {
            "id": "728010802",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "你跟着做什么？",
            "nextDialogs": [
              "728010803"
            ]
          },
          "728010803": {
            "id": "728010803",
            "speakerId": 3013,
            "speakerName": "平八",
            "text": "跟着？什么跟着，我在这遛弯！怎么，这片沙滩你家开的？你谁啊，管天管地…"
          }
        }
      }
    },
    {
      "subId": "7280109",
      "subQuestName": "与拉姆齐对话",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "728010901"
        ],
        "dialogs": {
          "728010901": {
            "id": "728010901",
            "speakerId": 3012,
            "speakerName": "拉姆齐",
            "text": "不错！这里的景致果然不错…",
            "nextDialogs": [
              "728010902"
            ]
          },
          "728010902": {
            "id": "728010902",
            "speakerId": 3012,
            "speakerName": "拉姆齐",
            "text": "然后是…我看看啊，城北的郊外有一个河湾，那里的小瀑布很有特色，我们就去那里好了。"
          }
        }
      }
    },
    {
      "subId": "7280110",
      "subQuestName": "前往城北的瀑布",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "728011001"
        ],
        "dialogs": {
          "728011001": {
            "id": "728011001",
            "speakerId": 3012,
            "speakerName": "拉姆齐",
            "text": "这里怎么会有这么多丘丘人",
            "nextDialogs": [
              "728011002"
            ]
          },
          "728011002": {
            "id": "728011002",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "远处还有新的敌人",
            "nextDialogs": [
              "728011003"
            ]
          },
          "728011003": {
            "id": "728011003",
            "speakerId": 3012,
            "speakerName": "拉姆齐",
            "text": "我们快点离开吧",
            "nextDialogs": [
              "728011004"
            ]
          },
          "728011004": {
            "id": "728011004",
            "speakerId": 3012,
            "speakerName": "拉姆齐",
            "text": "这次我想去高一点的地方看看",
            "nextDialogs": [
              "728011005"
            ]
          },
          "728011005": {
            "id": "728011005",
            "speakerId": 3012,
            "speakerName": "拉姆齐",
            "text": "嗯……就那边的小山上吧",
            "nextDialogs": [
              "728011006"
            ]
          },
          "728011006": {
            "id": "728011006",
            "speakerId": 3012,
            "speakerName": "拉姆齐",
            "text": "这次我想去高一点的地方看看"
          }
        }
      }
    },
    {
      "subId": "7280116",
      "subQuestName": "击败魔物",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "728011601"
        ],
        "dialogs": {
          "728011601": {
            "id": "728011601",
            "speakerId": 3012,
            "speakerName": "拉姆齐",
            "text": "请你们先把这几段「游记」带给小绿吧，等我全部写好了之后，我会托人把完整的「游记」带给她的。",
            "nextDialogs": [
              "728011602"
            ]
          },
          "728011602": {
            "id": "728011602",
            "speakerId": 3013,
            "speakerName": "平八",
            "text": "哼，这家伙准是有什么目的…只不过，现在还没露出马脚而已。"
          }
        }
      }
    },
    {
      "subId": "7280111",
      "subQuestName": "与拉姆齐对话",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "728011103"
        ],
        "dialogs": {
          "728011103": {
            "id": "728011103",
            "speakerId": 3012,
            "speakerName": "拉姆齐",
            "text": "没想到这里居然有魔物活动…虽然这地方景致也还算可以，但实在有些危险…",
            "nextDialogs": [
              "728011104"
            ]
          },
          "728011104": {
            "id": "728011104",
            "speakerId": 3012,
            "speakerName": "拉姆齐",
            "text": "但这段遭遇也可以写进「游记」里去，作为一点小小的桥段…",
            "nextDialogs": [
              "728011105"
            ]
          },
          "728011105": {
            "id": "728011105",
            "speakerId": 3012,
            "speakerName": "拉姆齐",
            "text": "不过，我们还是先离开这里，去找个安全的地方再说吧。",
            "nextDialogs": [
              "728011106"
            ]
          },
          "728011106": {
            "id": "728011106",
            "speakerId": 3012,
            "speakerName": "拉姆齐",
            "text": "那家伙居然还跟着，真是…哼…锲而不舍…"
          }
        }
      }
    },
    {
      "subId": "7280112",
      "subQuestName": "前往安全的地点",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [],
        "dialogs": {}
      }
    },
    {
      "subId": "7280113",
      "subQuestName": "前往附近的山顶",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "728011301"
        ],
        "dialogs": {
          "728011301": {
            "id": "728011301",
            "speakerId": 3012,
            "speakerName": "拉姆齐",
            "text": "果然，站在山顶，就能俯瞰大半个鸣神岛了。",
            "nextDialogs": [
              "728011302"
            ]
          },
          "728011302": {
            "id": "728011302",
            "speakerId": 3012,
            "speakerName": "拉姆齐",
            "text": "山顶的风力相当强，高度适合起飞，还没有障碍物干扰。",
            "nextDialogs": [
              "728011303"
            ]
          },
          "728011303": {
            "id": "728011303",
            "speakerId": 3012,
            "speakerName": "拉姆齐",
            "text": "而且距离稻妻城比较远，不会被同心…被闲人打扰。",
            "nextDialogs": [
              "728011304"
            ]
          },
          "728011304": {
            "id": "728011304",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "的确是个很棒的地方。",
            "nextDialogs": [
              "728011305"
            ]
          },
          "728011305": {
            "id": "728011305",
            "speakerId": 3012,
            "speakerName": "拉姆齐",
            "text": "总之，在这里起飞应该很不错…写进「游记」里肯定也非常不错。",
            "nextDialogs": [
              "728011306"
            ]
          },
          "728011306": {
            "id": "728011306",
            "speakerId": 3012,
            "speakerName": "拉姆齐",
            "text": "这家伙…果然还在跟着，真是没完没了",
            "nextDialogs": [
              "728011307"
            ]
          },
          "728011307": {
            "id": "728011307",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "我去把他赶走吧。",
            "nextDialogs": [
              "728011308"
            ]
          },
          "728011308": {
            "id": "728011308",
            "speakerId": 3012,
            "speakerName": "拉姆齐",
            "text": "算了，不必和他计较，有你在，他不敢轻举妄动。",
            "nextDialogs": [
              "728011309"
            ]
          },
          "728011309": {
            "id": "728011309",
            "speakerId": 3012,
            "speakerName": "拉姆齐",
            "text": "而且对付这种人…假如你真的主动搭理他，他反而会更加纠缠不休。",
            "nextDialogs": [
              "728011310"
            ]
          },
          "728011310": {
            "id": "728011310",
            "speakerId": 3012,
            "speakerName": "拉姆齐",
            "text": "总之，这次采风之行就到此为止吧，我们先回木漏茶室去。"
          }
        }
      }
    },
    {
      "subId": "7280114",
      "subQuestName": "返回木漏茶室",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "728011401"
        ],
        "dialogs": {
          "728011401": {
            "id": "728011401",
            "speakerId": 3012,
            "speakerName": "拉姆齐",
            "text": "游记的主要内容，我已经有思路了，不过写成完整的篇章，还需要一两天时间。",
            "nextDialogs": [
              "728011402"
            ]
          },
          "728011402": {
            "id": "728011402",
            "speakerId": 3012,
            "speakerName": "拉姆齐",
            "text": "我之前写好了几小段，请你们先把这几段带给小绿吧，",
            "nextDialogs": [
              "728011403"
            ]
          },
          "728011403": {
            "id": "728011403",
            "speakerId": 3012,
            "speakerName": "拉姆齐",
            "text": "等我全部写好了之后，我会托人把完整的「游记」带给她的。",
            "nextDialogs": [
              "728011404"
            ]
          },
          "728011404": {
            "id": "728011404",
            "speakerId": 3013,
            "speakerName": "平八",
            "text": "「游记」…哼，嘴上这么说，指不定有什么目的…",
            "nextDialogs": [
              "728011405"
            ]
          },
          "728011405": {
            "id": "728011405",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "你在说什么？",
            "nextDialogs": [
              "728011406"
            ]
          },
          "728011406": {
            "id": "728011406",
            "speakerId": 3013,
            "speakerName": "平八",
            "text": "我说，这个家伙写这些「游记」，是另有目的。",
            "nextDialogs": [
              "728011407"
            ]
          },
          "728011407": {
            "id": "728011407",
            "speakerId": 3013,
            "speakerName": "平八",
            "text": "谁没事会想那些乱七八糟的东西，还用热气球环游提瓦特，而且还不用「神之眼」…",
            "nextDialogs": [
              "728011408"
            ]
          },
          "728011408": {
            "id": "728011408",
            "speakerId": 3013,
            "speakerName": "平八",
            "text": "哼，这家伙准是有什么目的…只不过，现在还没露出马脚而已。"
          }
        }
      }
    },
    {
      "subId": "7280115",
      "subQuestName": "与小绿对话",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "728011501"
        ],
        "dialogs": {
          "728011501": {
            "id": "728011501",
            "speakerId": 3052,
            "speakerName": "小绿",
            "text": "#旅行者{PLAYERAVATAR#SEXPRO[INFO_MALE_PRONOUN_BROTHER|INFO_FEMALE_PRONOUN_SISTERA]}，你们拿到「游记」了吗？",
            "nextDialogs": [
              "728011502"
            ]
          },
          "728011502": {
            "id": "728011502",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "这是拉姆齐先生给你的…",
            "nextDialogs": [
              "728011503"
            ]
          },
          "728011503": {
            "id": "728011503",
            "speakerId": 3052,
            "speakerName": "小绿",
            "text": "《八十天环游提瓦特》…哇啊！谢谢你！我看看…",
            "nextDialogs": [
              "728011504"
            ]
          },
          "728011504": {
            "id": "728011504",
            "speakerId": 3052,
            "speakerName": "小绿",
            "text": "咦，怎么这么薄，之前的几本「游记」都很厚很厚的…",
            "nextDialogs": [
              "728011505"
            ]
          },
          "728011505": {
            "id": "728011505",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "他还没有写完。",
            "nextDialogs": [
              "728011506"
            ]
          },
          "728011506": {
            "id": "728011506",
            "speakerId": 3052,
            "speakerName": "小绿",
            "text": "是这样吗…我会等着拉姆齐叔叔写完的，等他写完，我再看完…我就又有故事给宏一讲了。",
            "nextDialogs": [
              "728011507"
            ]
          },
          "728011507": {
            "id": "728011507",
            "speakerId": 3052,
            "speakerName": "小绿",
            "text": "#谢谢你，{PLAYERAVATAR#SEXPRO[INFO_MALE_PRONOUN_BIGBROTHER|INFO_FEMALE_PRONOUN_BIGSISTER]}，这些东西给你，请你收下吧。"
          }
        }
      }
    },
    {
      "subId": "7280104",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "728010401"
        ],
        "dialogs": {
          "728010401": {
            "id": "728010401",
            "speakerId": 3013,
            "speakerName": "平八",
            "text": "瞅我干啥？",
            "nextDialogs": [
              "728010402"
            ]
          },
          "728010402": {
            "id": "728010402",
            "speakerId": 3013,
            "speakerName": "平八",
            "text": "一边去，别来耽误我的事！"
          }
        }
      }
    },
    {
      "subId": "7280112",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "728011203"
        ],
        "dialogs": {
          "728011203": {
            "id": "728011203",
            "speakerId": 3013,
            "speakerName": "平八",
            "text": "这是什么鬼地方，还有魔物，真是…",
            "nextDialogs": [
              "728011204"
            ]
          },
          "728011204": {
            "id": "728011204",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "你跟着做什么？",
            "nextDialogs": [
              "728011205"
            ]
          },
          "728011205": {
            "id": "728011205",
            "speakerId": 3013,
            "speakerName": "平八",
            "text": "我…跟着？我来这里摘果子散步，不可以吗？疑神疑鬼的…"
          }
        }
      }
    },
    {
      "subId": "7280199",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "728019903"
        ],
        "dialogs": {
          "728019903": {
            "id": "728019903",
            "speakerId": 3012,
            "speakerName": "拉姆齐",
            "text": "最后一个采风地点是那边的山顶。",
            "nextDialogs": [
              "728019904"
            ]
          },
          "728019904": {
            "id": "728019904",
            "speakerId": 3012,
            "speakerName": "拉姆齐",
            "text": "那里的视野很好，应该能将周围的风景尽收眼底。"
          }
        }
      }
    }
  ]
}
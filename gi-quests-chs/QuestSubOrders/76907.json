        "dialogs": {
          "769070101": {
            "id": "769070101",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "「远征」的体验如何？",
            "nextDialogs": [
              "769070102"
            ]
          },
          "769070102": {
            "id": "769070102",
            "speakerId": 1553,
            "speakerName": "古德温",
            "text": "只有在真正来到挪德卡莱之后，我才深刻地意识到自己都错过了什么。",
            "nextDialogs": [
              "769070103"
            ]
          },
          "769070103": {
            "id": "769070103",
            "speakerId": 1553,
            "speakerName": "古德温",
            "text": "虽然这些年里我也算不上懈怠，但跟那些经过了无数风霜考验的远征队骑士们相比，还是太弱小了。",
            "nextDialogs": [
              "769070104"
            ]
          },
          "769070104": {
            "id": "769070104",
            "speakerId": 1553,
            "speakerName": "古德温",
            "text": "不管是战斗的技巧，还是骑士的精神…我都不能继续掉队了啊！",
            "nextDialogs": [
              "769070105"
            ]
          },
          "769070105": {
            "id": "769070105",
            "speakerId": 1553,
            "speakerName": "古德温",
            "text": "这是我向他们请教来的经验，虽然对荣誉骑士来说或许不算什么…但也跟你一起分享吧！"
          }
        }
      }
    }
  ]

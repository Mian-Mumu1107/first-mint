    },
    {
      "subId": "7415611",
      "subQuestName": "",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "741561101"
        ],
        "dialogs": {
          "741561101": {
            "id": "741561101",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "他们能自己解决，我不会再插手。",
            "nextDialogs": [
              "741561102"
            ]
          },
          "741561102": {
            "id": "741561102",
            "speakerId": 21249,
            "speakerName": "伯努瓦·勒鲁瓦",
            "text": "小秋，你真的要这样对我吗？",
            "nextDialogs": [
              "741561103"
            ]
          },
          "741561103": {
            "id": "741561103",
            "speakerId": 21249,
            "speakerName": "伯努瓦·勒鲁瓦",
            "text": "灰河的女孩子哪个有你过得幸福？你吃的点心，你的绸缎裙子，你看的书都是要花钱的。",
            "nextDialogs": [
              "741561104"
            ]
          },
          "741561104": {
            "id": "741561104",
            "speakerId": 21249,
            "speakerName": "伯努瓦·勒鲁瓦",
            "text": "别人挨冻挨饿的时候，你在给家里的狗戴项链，穿裙子。",
            "nextDialogs": [
              "741561105"
            ]
          },
          "741561105": {
            "id": "741561105",
            "speakerId": 21249,
            "speakerName": "伯努瓦·勒鲁瓦",
            "text": "这种生活是我挣来的，你不应该有所回报吗？不付出就获得回报这种事怎么可能？",
            "nextDialogs": [
              "741561106"
            ]
          },
          "741561106": {
            "id": "741561106",
            "speakerId": 21249,
            "speakerName": "伯努瓦·勒鲁瓦",
            "text": "我对你残酷吗？我已经够慷慨了。",
            "nextDialogs": [
              "741561107"
            ]
          },
          "741561107": {
            "id": "741561107",
            "speakerId": 21249,
            "speakerName": "伯努瓦·勒鲁瓦",
            "text": "小秋，你仔细想一想。你生活中的哪一步我没有为你安排，你走歪的路都是你自己选的。",
            "nextDialogs": [
              "741561108"
            ]
          },
          "741561108": {
            "id": "741561108",
            "speakerId": 21250,
            "speakerName": "阿托斯",
            "text": "伯努瓦先生未免太会强词夺理了，用慷慨的言行实现自私的目的，说穿了还是为自己。",
            "nextDialogs": [
              "741561109"
            ]
          },
          "741561109": {
            "id": "741561109",
            "speakerId": 1006,
            "speakerName": "秋",
            "text": "你对我好不过是为了日后收割，不必花言巧语。",
            "nextDialogs": [
              "741561110"
            ]
          },
          "741561110": {
            "id": "741561110",
            "speakerId": 1006,
            "speakerName": "秋",
            "text": "我对你最大的怜悯就是给你一个痛快，但在那之前，告诉我，我的孩子在哪儿？",
            "nextDialogs": [
              "741561111"
            ]
          },
          "741561111": {
            "id": "741561111",
            "speakerId": 1006,
            "speakerName": "秋",
            "text": "不管是以前的老房子，还是现在你住的房子里，一点关于她去向的痕迹都没有。你把她弄到哪里去了？",
            "nextDialogs": [
              "741561112"
            ]
          },
          "741561112": {
            "id": "741561112",
            "speakerId": 21249,
            "speakerName": "伯努瓦·勒鲁瓦",
            "text": "我说了你就会放过我吗？",
            "nextDialogs": [
              "741561113"
            ]
          },
          "741561113": {
            "id": "741561113",
            "speakerId": 1006,
            "speakerName": "秋",
            "text": "不会，但我会让你没有痛苦地离开。",
            "nextDialogs": [
              "741561114"
            ]
          },
          "741561114": {
            "id": "741561114",
            "speakerId": 21249,
            "speakerName": "伯努瓦·勒鲁瓦",
            "text": "…说也是死，不说也是死…呵呵，那我为什么要便宜你？",
            "nextDialogs": [
              "741561115"
            ]
          },
          "741561115": {
            "id": "741561115",
            "speakerId": 21250,
            "speakerName": "阿托斯",
            "text": "唉…秋你真是一点都不会撒谎，这下我们永远不会知道她在哪儿了。",
            "nextDialogs": [
              "741561116"
            ]
          },
          "741561116": {
            "id": "741561116",
            "speakerId": 21249,
            "speakerName": "伯努瓦·勒鲁瓦",
            "text": "我知道她在哪儿，嘿嘿，但我不会告诉你们，绝对不会。",
            "nextDialogs": [
              "741561117"
            ]
          },
          "741561117": {
            "id": "741561117",
            "speakerId": 21249,
            "speakerName": "伯努瓦·勒鲁瓦",
            "text": "你再也不会找到她了，绝对找不到…",
            "nextDialogs": [
              "741561118"
            ]
          },
          "741561118": {
            "id": "741561118",
            "speakerId": 1006,
            "speakerName": "秋",
            "text": "我要把他带走，带回他自己家去，你们有什么意见吗？",
            "nextDialogs": [
              "741561119"
            ]
          },
          "741561119": {
            "id": "741561119",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "请便，我们不会干涉。",
            "nextDialogs": [
              "741561120"
            ]
          },
          "741561120": {
            "id": "741561120",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "你、你们自己解决就好，我们不管了，不管了。",
            "nextDialogs": [
              "741561121"
            ]
          },
          "741561121": {
            "id": "741561121",
            "speakerId": 1002,
            "speakerName": "Black Screen",
            "text": "伯努瓦念叨着「绝对找不到」，被一言不发的秋带走了。",
            "nextDialogs": [
              "741561122"
            ]
          },
          "741561122": {
            "id": "741561122",
            "speakerId": 21250,
            "speakerName": "阿托斯",
            "text": "本来没打算让别人知道这种事的，毕竟她还有通缉令在身，值得一提的是，我也是。",
            "nextDialogs": [
              "741561123"
            ]
          },
          "741561123": {
            "id": "741561123",
            "speakerId": 21250,
            "speakerName": "阿托斯",
            "text": "如果你们现在去执律庭告发我们，大概能拿不少钱。",
            "nextDialogs": [
              "741561124"
            ]
          },
          "741561124": {
            "id": "741561124",
            "speakerId": 21250,
            "speakerName": "阿托斯",
            "text": "不过我不建议你这么做，因为你这么做了的话，我的朋友们是不会忘记你的。你可以试试。",
            "nextDialogs": [
              "741561127"
            ]
          },
          "741561127": {
            "id": "741561127",
            "speakerId": 21250,
            "speakerName": "阿托斯",
            "text": "哈哈，我也觉得你会是这个态度。",
            "nextDialogs": [
              "741561128"
            ]
          },
          "741561128": {
            "id": "741561128",
            "speakerId": 21250,
            "speakerName": "阿托斯",
            "text": "那么，这朵虹彩蔷薇送给你。我们很喜欢这种花，它的含义很丰富。",
            "nextDialogs": [
              "741561129"
            ]
          },
          "741561129": {
            "id": "741561129",
            "speakerId": 21250,
            "speakerName": "阿托斯",
            "text": "现在，它的意义是警告，希望你保持你的态度。",
            "nextDialogs": [
              "741561130"
            ]
          },
          "741561130": {
            "id": "741561130",
            "speakerId": 21250,
            "speakerName": "阿托斯",
            "text": "再会了。",
            "nextDialogs": [
              "741561131"
            ]
          },
          "741561131": {
            "id": "741561131",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "所以…一切原来是这么回事，真是复杂的一家子。",
            "nextDialogs": [
              "741561132"
            ]
          },
          "741561132": {
            "id": "741561132",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "该怎么说呢？我也不知道能评价些什么了，幸好之前没有报告执律庭。",
            "nextDialogs": [
              "741561133"
            ]
          },
          "741561133": {
            "id": "741561133",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "我有点可怜秋，她的孩子到最后也没有找到。",
            "nextDialogs": [
              "741561134"
            ]
          },
          "741561134": {
            "id": "741561134",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "一开始，我还觉得伯努瓦是好人呢。唔…你说，我该不会很容易被骗吧？"
          }
        }
      }
    },
    {

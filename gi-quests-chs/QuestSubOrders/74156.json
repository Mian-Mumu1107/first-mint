        "dialogs": {
          "741561201": {
            "id": "741561201",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "我不会看着他们伤害伯努瓦。",
            "nextDialogs": [
              "741561202"
            ]
          },
          "741561202": {
            "id": "741561202",
            "speakerId": 21250,
            "speakerName": "阿托斯",
            "text": "哼，麻烦起来了。",
            "nextDialogs": [
              "741561203"
            ]
          },

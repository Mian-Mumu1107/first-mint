    {
      "subId": "7415604",
      "subQuestName": "前往后窗",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "741560401"
        ],
        "dialogs": {
          "741560401": {
            "id": "741560401",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "#我好紧张，{NICKNAME}，按照纸条上说的，我们只要在这里等他就好了吧。",
            "nextDialogs": [
              "741560404"
            ]
          },
          "741560404": {
            "id": "741560404",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "好，我听你的。",
            "nextDialogs": [
              "741560405"
            ]
          },
          "741560405": {
            "id": "741560405",
            "speakerId": 1002,
            "speakerName": "Black Screen",
            "text": "安静地等待了一会儿，随着一声「吱呀」，窗户被一张你们熟悉的面孔打开了。伯努瓦向外探了探头，看见你们后，他小心地从窗户口爬了出来。",
            "nextDialogs": [
              "741560406"
            ]
          },
          "741560406": {
            "id": "741560406",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "伯努瓦，这到底是怎么…",
            "nextDialogs": [
              "741560407"
            ]
          },
          "741560407": {
            "id": "741560407",
            "speakerId": 21249,
            "speakerName": "伯努瓦·勒鲁瓦",
            "text": "快走快走，被他们发现就糟了。"
          }
        }
      }
    },

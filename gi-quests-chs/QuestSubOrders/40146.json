    {
      "subId": "4014601",
      "subQuestName": "返回店铺",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "401460801"
        ],
        "dialogs": {
          "401460801": {
            "id": "401460801",
            "speakerId": 1000,
            "speakerName": "Black Screen",
            "text": "又过了一段时间，炼金店铺的经营规模越来越大，你也即将迎来全新的商机…",
            "nextDialogs": [
              "401460802"
            ]
          },
          "401460802": {
            "id": "401460802",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "似乎有其他国家的商人过来了，我们去看看吧。"
          }
        }
      }
    },
    {
      "subId": "4014602",
      "subQuestName": "与商人对话",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "401460101"
        ],
        "dialogs": {
          "401460101": {
            "id": "401460101",
            "speakerId": 30501,
            "speakerName": "阿泰菲",
            "text": "你们好呀，我是来自须弥的旅行商人阿泰菲，很高兴认识你们！",
            "nextDialogs": [
              "401460102"
            ]
          },
          "401460102": {
            "id": "401460102",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "哇，居然从这么远的地方过来吗，不知不觉，我们的店铺名气已经这么大了？",
            "nextDialogs": [
              "401460104"
            ]
          },
          "401460104": {
            "id": "401460104",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "哼哼，现在在你面前的，正是冉冉升起的销售之星，派蒙！",
            "nextDialogs": [
              "401460106"
            ]
          },
          "401460106": {
            "id": "401460106",
            "speakerId": 30501,
            "speakerName": "阿泰菲",
            "text": "啊哈哈，最近确实有不少消息灵通的商人听说了你们在售卖的炼金药剂呢。",
            "nextDialogs": [
              "401460107"
            ]
          },
          "401460107": {
            "id": "401460107",
            "speakerId": 30501,
            "speakerName": "阿泰菲",
            "text": "这种不太常见的商品，大部分人还是不太敢冒险。",
            "nextDialogs": [
              "401460108"
            ]
          },
          "401460108": {
            "id": "401460108",
            "speakerId": 30501,
            "speakerName": "阿泰菲",
            "text": "但在我看来，要想赚大钱，就得抢占商机！",
            "nextDialogs": [
              "401460109"
            ]
          },
          "401460109": {
            "id": "401460109",
            "speakerId": 30501,
            "speakerName": "阿泰菲",
            "text": "虽然现在普通人对炼金药剂的了解程度还不是很高，但只要配合销售手段，一旦打开了市场，那可就是赚不完的摩拉了！",
            "nextDialogs": [
              "401460110"
            ]
          },
          "401460110": {
            "id": "401460110",
            "speakerId": 30501,
            "speakerName": "阿泰菲",
            "text": "如果能打响名号，说不定售价能翻十倍…嘿嘿，干完这一票，就能休息到年底了。",
            "nextDialogs": [
              "401460111"
            ]
          },
          "401460111": {
            "id": "401460111",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "十倍！你是认真的吗？",
            "nextDialogs": [
              "401460112"
            ]
          },
          "401460112": {
            "id": "401460112",
            "speakerId": 30501,
            "speakerName": "阿泰菲",
            "text": "哼哼，只要有人愿意买，不管价格卖多高都是合理的。所谓你情我愿嘛。",
            "nextDialogs": [
              "401460113"
            ]
          },
          "401460113": {
            "id": "401460113",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "这个说辞，让我想起了某个满脑子都是摩拉的家伙…",
            "nextDialogs": [
              "401460114"
            ]
          },
          "401460114": {
            "id": "401460114",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "我说，既然你来自须弥，该不会凑巧认识多莉吧？",
            "nextDialogs": [
              "401460115"
            ]
          },
          "401460115": {
            "id": "401460115",
            "speakerId": 30501,
            "speakerName": "阿泰菲",
            "text": "多莉？难道你说的是多莉·桑歌马哈巴依老爷？你们居然认识这位大人物吗？"
          }
        }
      }
    }
  ]
}
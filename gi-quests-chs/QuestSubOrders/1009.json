    {
      "subId": "100914",
      "subQuestName": "面见「留云借风真君」",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "10091401"
        ],
        "dialogs": {
          "10091401": {
            "id": "10091401",
            "speakerId": 1001,
            "speakerName": "留云借风真君",
            "text": "居然能闯过洞府，你们倒是有几分本事。",
            "nextDialogs": [
              "10091402"
            ]
          },
          "10091402": {
            "id": "10091402",
            "speakerId": 1001,
            "speakerName": "留云借风真君",
            "text": "本仙乃是留云借风真君，你们所为何事，速速报来。",
            "nextDialogs": [
              "10091404",
              "10091406"
            ]
          },
          "10091404": {
            "id": "10091404",
            "speakerId": 1001,
            "speakerName": "留云借风真君",
            "text": "那是自然，除了洞府之外，那些机关也是本仙自己所建。",
            "nextDialogs": [
              "10091407"
            ]
          },
          "10091407": {
            "id": "10091407",
            "speakerId": 1001,
            "speakerName": "留云借风真君",
            "text": "本仙的「机关术」，就是连「归终」和岩王帝君见了，也是要称赞的。",
            "nextDialogs": [
              "10091408"
            ]
          },
          "10091408": {
            "id": "10091408",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "这么大的洞府，您就一个人住吗？而且还有这么多机关…",
            "nextDialogs": [
              "10091409"
            ]
          },
          "10091409": {
            "id": "10091409",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "您是不是为了研究「机关术」，才独自住在这的呀？",
            "nextDialogs": [
              "10091410"
            ]
          },
          "10091410": {
            "id": "10091410",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "就和传说里的一样，仙人们离开凡世，在什么地方隐居，自己研究着很多厉害的东西…",
            "nextDialogs": [
              "10091411"
            ]
          },
          "10091411": {
            "id": "10091411",
            "speakerId": 1001,
            "speakerName": "留云借风真君",
            "text": "本仙…只是觉着交际太过烦琐，想寻个清静。",
            "nextDialogs": [
              "10091412"
            ]
          },
          "10091412": {
            "id": "10091412",
            "speakerId": 1001,
            "speakerName": "留云借风真君",
            "text": "但清净了没多久，你们就拿着这「百无禁忌箓」来了…",
            "nextDialogs": [
              "10091413"
            ]
          },
          "10091413": {
            "id": "10091413",
            "speakerId": 1001,
            "speakerName": "留云借风真君",
            "text": "算了，算了！你们所为何事，速速报来，莫要打扰了本仙休憩。",
            "nextDialogs": [
              "10091414"
            ]
          },
          "10091414": {
            "id": "10091414",
            "speakerId": 1001,
            "speakerName": "留云借风真君",
            "text": "帝君…帝君遇刺了！？",
            "nextDialogs": [
              "10091415"
            ]
          },
          "10091415": {
            "id": "10091415",
            "speakerId": 1001,
            "speakerName": "留云借风真君",
            "text": "怎…怎会如此！居然有人敢犯下如此滔天大罪！",
            "nextDialogs": [
              "10091416"
            ]
          },
          "10091416": {
            "id": "10091416",
            "speakerId": 1001,
            "speakerName": "留云借风真君",
            "text": "如此荒诞，难以相信，本仙要去查证…",
            "nextDialogs": [
              "10091417"
            ]
          },
          "10091417": {
            "id": "10091417",
            "speakerId": 1001,
            "speakerName": "留云借风真君",
            "text": "不…不如本仙这就去先镇压了璃月港，再等群仙并至——",
            "nextDialogs": [
              "10091418"
            ]
          },
          "10091418": {
            "id": "10091418",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "…咦？",
            "nextDialogs": [
              "10091419"
            ]
          },
          "10091419": {
            "id": "10091419",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "咦？！等，等一下！什么叫「镇压」璃月港？您是要把整座璃月港给毁掉吗？",
            "nextDialogs": [
              "10091420"
            ]
          },
          "10091420": {
            "id": "10091420",
            "speakerId": 1001,
            "speakerName": "留云借风真君",
            "text": "只是要使些雷霆手段，免得再多生事端。"
          },
          "10091406": {
            "id": "10091406",
            "speakerId": 1001,
            "speakerName": "留云借风真君",
            "text": "那是自然。"
          }
        }
      }
    },
